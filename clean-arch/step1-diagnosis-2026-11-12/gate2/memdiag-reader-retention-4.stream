wer_usable\": true,\n  \"kept_evidence\": [\n   {\n    \"id\": \"e-1\",\n    \"summary\": \"Morgan Stanley Research estimates that NVIDIA's Vera Rubin VR200 NVL72 rack will cost hyperscale cloud providers about $7.8 million per unit, up from roughly $4 million for the current GB300 NVL72 generation, with NVIDIA charging about $55,000 per Rubin GPU and $5,000 per Vera CPU when sold in volume; the bank adds that a hyperscaler self-sourcing certain memory modules could bring the rack price down to around $6.7 million, so procurement structure can move final pricing by $1 million or more per rack.\",\n    \"links\": [\n     \"clean-4\"\n    ]\n   },\n   {\n    \"id\": \"e-2\",\n    \"summary\": \"Morgan Stanley Research puts memory content per NVIDIA Vera Rubin VR200 NVL72 rack at about $2 million, a 435% jump from the prior generation, driven by a threefold increase in LPDDR5X capacity to 54 terabytes per rack plus roughly $1 million or more of 3D NAND storage that was virtually absent from earlier systems; memory's share of the bill of materials rose from 5–10% on GB200 to 25–30% on VR200 while the GPU's share fell from roughly 63% to 51%.\",\n    \"links\": [\n     \"mt-1\",\n     \"clean-4\"\n    ]\n   },\n   {\n    \"id\": \"e-3\",\n    \"summary\": \"Morgan Stanley Research reports that first shipments of NVIDIA's Vera Rubin VR200 NVL72 rack are scheduled for the third quarter of 2026, with volume ramping in the fourth quarter.\",\n    \"links\": [\n     \"clean-2\"\n    ]\n   },\n   {\n    \"id\": \"e-4\",\n    \"summary\": \"MarketScale reports that constrained supply of DRAM, NAND and high-bandwidth memory against AI-driven demand is the force raising component costs across the market, that contract DDR5 pricing has climbed sharply, and that device makers including Samsung and Apple are expected to pass higher memory costs into upcoming products.\",\n    \"links\": [\n     \"mt-1\"\n    ]\n   }\n  ]\n },\n {\n  \"n\": 62,\n  \"claims\": [\n   {\n","exit_code":0