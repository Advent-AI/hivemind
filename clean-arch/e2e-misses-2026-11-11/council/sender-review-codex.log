   110	def run_replay(output, step2_folder, *, on_round=None, keep_links=None, uncarried=None):
   111	    """Replay the draw into `output` with every request answered from the saved archive. `on_round(day, entries, error)` is called after
   112	    each judging round (error is the ReferenceMissError that ended it, or None). `uncarried` is {record id: [question ids]}: links the
   113	    record would take from a record it revises and is not given here (the relation itself is still written)."""
   114	    refuse_live_calls()
   115	    reference = control_v108.ReferenceArchiveTransport(SAVED / 'archive.sqlite')
   116	    recorder = RecordingTransport(reference)
   117	    production_judge = e2e_adapter.Adapter.judge
   118	    production_article = e2e_adapter.Adapter.article
   119	    production_revise, production_linked = store.revise, store.views_linked_to
   120	    writing = {}                      # the adapter and the record whose relation is being written
   121	
   122	    def revise(conn, old_id, new_id, said_day, seq):
   123	        writing['new'] = new_id
   124	        return production_revise(conn, old_id, new_id, said_day, seq)
   125	
   126	    def views_linked_to(conn, evidence_id):
   127	        """The adapter's one call that reads the older record's links, made right after `revise` names the pair."""
   128	        linked = production_linked(conn, evidence_id)
   129	        record_id = next((r for r, e in writing['adapter'].evidence_of.items() if e == writing.get('new')), None)
   130	        return [view_id for view_id in linked if view_id not in (uncarried or {}).get(record_id, ())]
   131	
   132	    def judge(self, day, seq, changed):
   133	        recorder.round = (day, seq)
   134	        error = None
   135	        try:
   136	            return production_judge(self, day, seq, changed)
   137	        except control_v108.ReferenceMissError as miss:
   138	            error = miss
   139	            raise
   140	        finally:
   141	            if on_round:
   142	                on_round(day, recorder.of_round(day), error)
   143	
   144	    def article(self, k, records, library, revisions_by_record, later_entries, changed):
   145	        writing['adapter'] = self
   146	        production_article(self, k, records, library, revisions_by_record, later_entries, changed)
