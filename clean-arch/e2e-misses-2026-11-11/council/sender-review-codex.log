   211	              'saved archive rows': reference.reference_rows, 'ledger rows compared, by table': compared,
   212	              'ledger columns not compared': {table: sorted(columns) for table, columns in ARCHIVE_ROW_COLUMNS.items()},
   213	              'judging rounds': len(rounds), 'adapter counts': replay_counts}
   214	    (output / 'control-report.json').write_text(json.dumps(report, indent=1))
   215	    print(json.dumps(report, indent=1))
