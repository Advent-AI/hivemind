   266	            if not error:
   267	                raise Divergence(day)
   268	
   269	    diverged = True
   270	    try:
   271	        adapter, recorder, reference = run_replay(output, step2_folder, on_round=on_round, keep_links=kept, uncarried=uncarried)
   272	        adapter.conn.close()
   273	        never_judged = [day for day in control_rounds if day not in rounds_seen]
   274	        if never_judged:
   275	            found.update(day=None, entries=[], rounds_without_judging=never_judged, error=None)
   276	        else:
   277	            diverged = False
   278	    except (Divergence, control_v108.ReferenceMissError):
   279	        pass
   280	    report = {'relation removed': removed, 'links kept without the relation': kept, 'diverged': diverged,
   281	              'rounds identical to the control before the first difference': [day for day in rounds_seen if day != found.get('day')]}
   282	    if diverged:
   283	        day = found['day']
   284	        control_by_view = collections.defaultdict(list)
   285	        for entry in control_rounds.get(day, []):
   286	            control_by_view[entry['view']].append(entry['sha256'])
   287	        replay_by_view = collections.defaultdict(list)
   288	        for entry in found['entries']:
   289	            replay_by_view[entry['view']].append(entry)
   290	        changed = []
   291	        for view_id in sorted(set(control_by_view) | set(replay_by_view)):
   292	            control_shas = control_by_view.get(view_id, [])
   293	            replay_entries = replay_by_view.get(view_id, [])
   294	            if sorted(control_shas) == sorted(entry['sha256'] for entry in replay_entries):
   295	                continue
   296	            first_control = control_requests[control_shas[0]] if control_shas else None
   297	            first_replay = next((entry['request'] for entry in replay_entries if entry['sha256'] not in control_shas), None)
   298	            detail = {'view': view_id, 'control requests': len(control_shas), 'counterfactual requests': len(replay_entries)}
   299	            if first_control and first_replay:
   300	                control_shown = e2e_adapter.SHOWN_EVIDENCE.findall(user_text(first_control))
   301	                replay_shown = e2e_adapter.SHOWN_EVIDENCE.findall(user_text(first_replay))
   302	                detail['evidence only in the control request'] = [e for e in control_shown if e not in replay_shown]
   303	                detail['evidence only in the counterfactual request'] = [e for e in replay_shown if e not in control_shown]
   304	                detail['system text identical'] = first_control['messages'][0] == first_replay['messages'][0]
   305	                detail['diff of the user text'] = list(difflib.unified_diff(user_text(first_control).splitlines(), user_text(first_replay).splitlines(),
   306	                                                                            'control', 'counterfactual', lineterm='', n=0))
   307	                (output / f'request-{view_id}-control.json').write_text(json.dumps(first_control, ensure_ascii=False, indent=1))
   308	                (output / f'request-{view_id}-counterfactual.json').write_text(json.dumps(first_replay, ensure_ascii=False, indent=1))
   309	            changed.append(detail)
   310	        report.update({'first differing round': day, 'control days with no judging round in the counterfactual': found['rounds_without_judging'],
   311	                       'reference miss': found['error'], 'views whose requests differ in that round': changed,
   312	                       'views with identical requests in that round': sorted(v for v in control_by_view if sorted(control_by_view[v]) ==
   313	                                                                              sorted(e['sha256'] for e in replay_by_view.get(v, [])))})
   314	    output.mkdir(parents=True, exist_ok=True)
   315	    (output / 'counterfactual-report.json').write_text(json.dumps(report, ensure_ascii=False, indent=1))
   316	    print(json.dumps({name: value for name, value in report.items() if name != 'views whose requests differ in that round'}, ensure_ascii=False, indent=1))
   317	    for detail in report.get('views whose requests differ in that round', []):
   318	        print(json.dumps({name: value for name, value in detail.items() if name != 'diff of the user text'}, ensure_ascii=False))
