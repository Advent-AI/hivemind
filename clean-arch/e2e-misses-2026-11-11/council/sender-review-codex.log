   163	def ledger_rows(path, table):
   164	    with contextlib.closing(sqlite3.connect(f'file:{path}?mode=ro', uri=True)) as conn:
   165	        columns = [row[1] for row in conn.execute(f'pragma table_info({table})')]
   166	        kept = [column for column in columns if column not in ARCHIVE_ROW_COLUMNS.get(table, ())]
   167	        return kept, conn.execute(f"select {', '.join(kept)} from {table} order by rowid").fetchall()
   168	
