    65	class RecordingTransport:
    66	    """Passes each request to the reference archive transport and records it with the judging round it belongs to."""
    67	
    68	    def __init__(self, reference):
    69	        self.reference = reference
    70	        self.round = None                 # (day, seq) of the judging round in progress
    71	        self.requests = []                # one entry per request, answered or not
    72	
    73	    def __call__(self, provider, request):
    74	        canonical = control_v108.canonical_text(request)
    75	        text = request['messages'][-1]['content']
    76	        named = e2e_adapter.JUDGED_VIEW.search(text)
    77	        entry = {'day': self.round[0], 'seq': self.round[1], 'view': named.group(1) if named else None,
    78	                 'sha256': control_v108.text_sha256(canonical), 'answered': False, 'request': request}
    79	        self.requests.append(entry)       # list.append is atomic; the round's requests are sent from a thread pool
    80	        response = self.reference(provider, request)
    81	        entry['answered'] = True
    82	        return response
    83	
    84	    def of_round(self, day):
    85	        return [entry for entry in self.requests if entry['day'] == day]
