     1	"""A hard spending limit for the D392 measurement harnesses, independent of production's own cap (replay.run checks its cap only after
     2	an item or a day finishes, with calls already in flight).
     3	
     4	Every model attempt is sent alone (`model.openai_transport(..., max_attempts=1)`) and the limit applies production's retry rule around
     5	it: up to three attempts, no retry after HTTP 400/401/403/404 or an undecodable answer, waits of 5 s and then 10 s. Before an attempt is
     6	sent it reserves its worst case under a lock (every request character priced as an uncached input token at the request model's
     7	published rate, plus the request's output cap) and is refused if spent plus in flight plus the reserve would pass the cap. Afterwards,
     8	in the same locked step, the reserve is released and the attempt is charged: its cost from tokens when it answered with usable token
     9	counts, its full reserve otherwise (a lost answer, or one without usage, may still be billed).
    10	
    11	A Jev call (one argument, as replay.run passes one transport to both) goes through `jev.transport`, which retries inside itself out of
    12	sight, so it reserves and is always charged three attempts of its input at Jev's input rate (its output is free).
    13	
    14	Called as a transport: (provider, request) for a model call, (request,) for a Jev call."""
    15	import json, sys, threading, time
    16	from pathlib import Path
    17	
    18	sys.path[:0] = [str(Path(__file__).resolve().parents[2] / 'src')]
    19	from hivemind import jev, model  # noqa: E402
    20	
    21	ATTEMPTS = 3                                # model.openai_transport's default max_attempts
    22	NOT_RETRIED = (400, 401, 403, 404)          # model.openai_transport raises these at once
    23	UNDECODABLE = ('invalid UTF-8 HTTP response', 'malformed HTTP response')   # raised at once by production too
    24	
    25	
    26	class OverBudget(Exception):
    27	    pass
    28	
    29	
    30	def worst_cost(request):
    31	    """The body as sent (json.dumps, non-ASCII escaped) is at least as long in bytes as the UTF-8 text it carries, and a byte-level
    32	    tokenizer emits at most one token per byte; the JSON keys and syntax in the body more than cover the chat template's few tokens.
    33	    Rates are model.PRICES, the published rates (AGENTS §7.2)."""
    34	    input_rate, output_rate = model.PRICES[request['model']]
    35	    output_cap = request.get('max_completion_tokens') or request.get('max_tokens')
    36	    if not output_cap:
    37	        raise OverBudget(f"a request to {request['model']} has no output cap, so its worst cost is unbounded")
    38	    return (len(json.dumps(request).encode('utf-8')) * input_rate + output_cap * output_rate) / 1e6
    39	
    40	
    41	def cost(request, response):
    42	    """The answer's cost from its reported tokens; None when the answer reports no usable token counts."""
    43	    usage = response.get('usage') if isinstance(response, dict) else None
    44	    counts = [usage.get(name) for name in ('prompt_tokens', 'completion_tokens')] if isinstance(usage, dict) else [None, None]
    45	    if not all(isinstance(count, int) and not isinstance(count, bool) and count >= 0 for count in counts):
    46	        return None
    47	    cached = (usage.get('prompt_tokens_details') or {}).get('cached_tokens') or usage.get('prompt_cache_hit_tokens') or 0
    48	    input_rate, output_rate = model.PRICES[request['model']]
    49	    fresh = counts[0] - min(cached, counts[0])
    50	    return (fresh * input_rate + min(cached, counts[0]) * input_rate * model.CACHED_INPUT_SHARE + counts[1] * output_rate) / 1e6
    51	
    52	
    53	class Budget:
    54	    def __init__(self, cap_usd, attempt=None, sleep=time.sleep, jev_transport=None):
    55	        """attempt(provider, request) sends one attempt; the default is the production transport with a single attempt.
    56	        jev_transport(request) sends a Jev call; the default is production's."""
    57	        self.cap_usd, self.spent_usd, self.reserved_usd = cap_usd, 0.0, 0.0
    58	        self.attempt = attempt or (lambda provider, request: model.openai_transport(provider, request, max_attempts=1))
    59	        self.jev_transport = jev_transport or jev.transport
    60	        self.sleep = sleep
    61	        self.lock = threading.Lock()
    62	
    63	    def send(self, provider, request):
    64	        reserve = worst_cost(request)
    65	        for attempt_number in range(ATTEMPTS):
    66	            with self.lock:
    67	                if self.spent_usd + self.reserved_usd + reserve > self.cap_usd:
    68	                    raise OverBudget(f'spent ${self.spent_usd:.4f}, ${self.reserved_usd:.4f} in flight; '
    69	                                     f'${reserve:.4f} more would pass the ${self.cap_usd:.2f} cap')
    70	                self.reserved_usd += reserve
    71	            response, failure = None, None
    72	            try:
    73	                response = self.attempt(provider, request)
    74	            except model.TransportError as error:
    75	                failure = error
    76	            finally:
    77	                with self.lock:   # one step: the reserve is released only as the attempt is charged
    78	                    self.reserved_usd -= reserve
    79	                    charged = cost(request, response) if response is not None else None
    80	                    self.spent_usd += reserve if charged is None else charged   # no answer, or no usable usage: the full reserve
    81	            if response is not None:
    82	                return response
    83	            retried = getattr(failure, 'http_status', None) not in NOT_RETRIED and str(failure) not in UNDECODABLE
    84	            if not retried or attempt_number + 1 == ATTEMPTS:
    85	                raise failure
    86	            self.sleep(5 * (attempt_number + 1))
    87	
    88	    def send_jev(self, request):
    89	        input_rate, _ = model.PRICES[request['model']]
    90	        charge = ATTEMPTS * len(json.dumps(request, sort_keys=True, ensure_ascii=False).encode('utf-8')) * input_rate / 1e6   # jev.transport's body bytes
    91	        with self.lock:
    92	            if self.spent_usd + self.reserved_usd + charge > self.cap_usd:
    93	                raise OverBudget(f'spent ${self.spent_usd:.4f}, ${self.reserved_usd:.4f} in flight; a Jev call of ${charge:.4f} would pass '
    94	                                 f'the ${self.cap_usd:.2f} cap')
    95	            self.spent_usd += charge
    96	        return self.jev_transport(request)
    97	
    98	    def __call__(self, *arguments):
    99	        return self.send(*arguments) if len(arguments) == 2 else self.send_jev(*arguments)

