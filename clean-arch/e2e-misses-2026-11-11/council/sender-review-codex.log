   242	def counterfactual(output, control_folder, by, revised_group, keep_links, uncarried=None):
   243	    output, control_folder = Path(output).resolve(), Path(control_folder).resolve()
   244	    control_report = json.loads((control_folder / 'control-report.json').read_text())
