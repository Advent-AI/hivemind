   170	def archive_answers(path):
   171	    """Every archived call as (request sha256 without its refusal mark, refused or not, answer): the multiset a replay must reproduce."""
   172	    with contextlib.closing(sqlite3.connect(f'file:{path}?mode=ro', uri=True)) as conn:
   173	        rows = conn.execute('select request_sha256, answer_json from model_calls').fetchall()
   174	    return collections.Counter((REFUSED.sub('', sha), bool(REFUSED.search(sha)), answer) for sha, answer in rows)
