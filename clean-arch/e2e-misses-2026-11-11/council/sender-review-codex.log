   220	def library_without_relation(folder, by, revised_group):
   221	    """A copy of the draw's library with exactly one revision relation removed, stamped as its own (a labelled departure from the draw)."""
   222	    library = json.loads((STEP2 / 'library.json').read_text())
   223	    found = [(group_id, n) for group_id, group in library['groups'].items() for n, revision in enumerate(group['revises'])
   224	             if revision['by'] == by and revision['group'] == revised_group]
   225	    if len(found) != 1:
   226	        raise SystemExit(f'{len(found)} relations from {by} to group {revised_group}; exactly one is removed')
   227	    group_id, position = found[0]
   228	    removed = library['groups'][group_id]['revises'].pop(position)
   229	    folder.mkdir(parents=True)
   230	    (folder / 'library.json').write_text(json.dumps(library, ensure_ascii=False))
   231	    digests = [hashlib.sha256(Path(part).read_bytes()).hexdigest() + '  ' + part for part in TRACE.split('+')]
   232	    digests.append(hashlib.sha256((folder / 'library.json').read_bytes()).hexdigest() + '  ' + str(folder / 'library.json'))
   233	    (folder / 'inputs.sha256').write_text('\n'.join(digests) + '\n')
   234	    return {'held by group': group_id, 'removed': removed, 'revised original': library['groups'][revised_group]['original']['id'],
   235	            'revised original thesis ids': library['groups'][revised_group]['original']['thesis_ids']}
