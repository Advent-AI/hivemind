   192	            differing = next((n for n, pair in enumerate(zip(saved_rows, replay_rows)) if pair[0] != pair[1]), min(len(saved_rows), len(replay_rows)))
   193	            failures.append(f'ledger table {table}: {len(saved_rows)} saved rows, {len(replay_rows)} replayed, first difference at row {differing}')
   194	    saved_sent = json.loads((SAVED / 'judge-requests.json').read_text())
   195	    key = lambda entry: (entry['day'], entry['seq'], entry['view'], tuple(entry['shown']))
