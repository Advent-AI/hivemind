   184	def library_without_relation(folder, by, revised_group):
   185	    """A copy of the draw's library with exactly one revision relation removed, stamped as its own (a labelled departure from the draw)."""
   186	    library = json.loads((STEP2 / 'library.json').read_text())
   187	    found = [(group_id, n) for group_id, group in library['groups'].items() for n, revision in enumerate(group['revises'])
   188	             if revision['by'] == by and revision['group'] == revised_group]
   189	    if len(found) != 1:
   190	        raise SystemExit(f'{len(found)} relations from {by} to group {revised_group}; exactly one is removed')
   191	    group_id, position = found[0]
   192	    removed = library['groups'][group_id]['revises'].pop(position)
   193	    folder.mkdir(parents=True)
   194	    (folder / 'library.json').write_text(json.dumps(library, ensure_ascii=False))
   195	    digests = [hashlib.sha256(Path(part).read_bytes()).hexdigest() + '  ' + part for part in TRACE.split('+')]
   196	    digests.append(hashlib.sha256((folder / 'library.json').read_bytes()).hexdigest() + '  ' + str(folder / 'library.json'))
   197	    (folder / 'inputs.sha256').write_text('\n'.join(digests) + '\n')
   198	    return {'held by group': group_id, 'removed': removed, 'revised original': library['groups'][revised_group]['original']['id'],
   199	            'revised original thesis ids': library['groups'][revised_group]['original']['thesis_ids']}
