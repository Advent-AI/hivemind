: ["v18"], "unresolved_thesis_ids": []}, {"id": "75:e6", "article": 75, "input_id": "gnews:c75f16a6d64cc27fc28fb571", "title": "Nvidia's Kyber rack for Rubin Ultra reportedly delayed to 2028, stopgap solution also axed due to customer pushback — Analyst firm SemiAnalysis says PCB midplane problems led to the delay [Updated]", "publisher": "tomshardware.com", "publication_date": "2026-07-06", "summary": "An Nvidia representative responded to Tom's Hardware's questions about the reported Kyber delay with the statement \"Our roadmap is intact,\" providing no further details; the article noted it is unclear whether this refers to the original roadmap and delivery schedules or to a revised roadmap.", "passages": ["An Nvidia representative responded with a short statement to Tom's Hardware : \"Our roadmap is intact.\" Nvidia provided no further details in response to our follow-up questions. As such, it is unclear if Nvidia's statement refers to its original roadmap, planned delivery schedules, and hardware, or if those particulars had already been changed and the statement refers to a newly updated roadmap."], "verified_passages": ["An Nvidia representative responded with a short statement to Tom's Hardware : \"Our roadmap is intact.\" Nvidia provided no further details in response to our follow-up questions. As such, it is unclear if Nvidia's statement refers to its original roadmap, planned delivery schedules, and hardware, or if those particulars had already been changed and the statement refers to a newly updated roadmap."], "original_party": "NVIDIA", "reporting_speaker": "Nvidia representative, via Tom's Hardware", "tier": "party_statement", "statement_date": "2026-07-06", "statement_date_text": "7/6/2026", "evidence_period": null, "figures": [], "thesis_ids": ["v18", "v7"], "unresolved_thesis_ids": []}, {"id": "84:e2", "article": 84, "input_id": "gnews:b48593184704bbbe6eddbc03", "title": "As chip sector takes it on the chin, traders bet on a big Nvidia rally", "pu