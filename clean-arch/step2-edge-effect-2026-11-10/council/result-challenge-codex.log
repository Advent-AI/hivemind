ges": ["The report also cited Reuters reporting that Huawei had built a stockpile of between 2 and 3 million of its own AI chips made by Taiwanese chipmaker TSMC, which it had obtained via illegal diversion by the Chinese company Sophgo."], "original_party": "Reuters (as cited by NVIDIA)", "reporting_speaker": "The Wire China", "tier": "fact", "statement_date": null, "statement_date_text": null, "evidence_period": null, "figures": [], "thesis_ids": ["v6"], "unresolved_thesis_ids": []}, "members": [], "links": {"v6": "24:e9"}, "revises": []}, "24:e10": {"original": {"id": "24:e10", "article": 24, "input_id": "gnews:f8d63eab0337895e8e95cf02", "title": "Nvidia Uses The Specter of Huawei to Make Its Chip Exports Case", "publisher": "thewirechina.com", "publication_date": "2026-07-02", "summary": "The Chinese government has to date locked Nvidia out of the China market, despite the Trump administration having cleared the path for H200 exports.", "passages": ["The Chinese government has to date locked Nvidia out of the China market, despite the Trump administration having cleared its path for H200 exports."], "verified_passages": ["The Chinese government has to date locked Nvidia out of the China market, despite the Trump administration having cleared its path for H200 exports."], "original_party": "Chinese government", "reporting_speaker": "The Wire China", "tier": "fact", "statement_date": null, "statement_date_text": null, "evidence_period": "as of mid-2026", "figures": [], "thesis_ids": ["v17", "v8"], "unresolved_thesis_ids": []}, "members": [{"id": "100:e2", "article": 100, "input_id": "gnews:c8c39f971721fd820aab5c1c", "title": "China to let AI firms buy Nvidia H200s, says report", "publisher": "straitstimes.com", "publication_date": "2026-07-08", "summary": "US President Donald Trump granted Nvidia permission to sell H200 processors to China in December, but Chinese authorities have been slow to let the technology into the country, according to The Straits Times.", "passages": ["Though US President Donald Trump granted Nvidia permission to sell the processors to China in December, the Chinese authorities have been slow to allow the technology into the country."], "verified_passages": ["Though US President Donald Trump granted Nvidia permission to sell the processors to China in December, the Chinese authorities have been slow to allow the technology into the country."], "original_party": "US President Donald Trump", "reporting_speaker": "The Straits Times", "tier": "fact", "statement_date": null, "statement_date_text": "December", "evidence_period": "December", "figures": [], "thesis_ids": ["v8"], "unresolved_thesis_ids": []}, {"id": "137:e2", "article": 137, "input_id": "gnews:50a84fa6b2f3eb33f29948a4", "title": "The Download: a nuclear landmark, and China eyes Nvidia chips", "publisher": "technologyreview.com", "publication_date": "2026-07-09", "summary": "MIT Technology Review's Download newsletter, citing Reuters, noted that China had previously withheld approval for imports of Nvidia H200 chips despite the chips being authorized for export by the United States, describing the regulatory position that the reported new permission would change.", "passages": ["+ China had previously withheld approval despite US authorization. ( Reuters $)"], "verified_passages": ["+ China had previously withheld approval despite US authorization. ( Reuters $)"], "original_party": "Reuters", "reporting_speaker": "MIT Technology Review (The Download)", "tier": "fact", "statement_date": null, "statement_date_text": null, "evidence_period": null, "figures": [], "thesis_ids": ["v8"], "unresolved_thesis_ids": []}, {"id": "138:e2", "article": 138, "input_id": "gnews:91684b863d274b10246d0c13", "title": "Game-changer? Why China is finally letting its AI firms buy the Nvidia H200", "publisher": "scmp.com", "publication_date": "2026-07-09", "summary": "Beijing has deliberately restricted Chinese firms from purchasing Nvidia's H200 GPUs as part of its technology self-sufficiency drive, the South China Morning Post reported.", "passages": ["In early 2026, Washington took the rare step of approving Nvidia’s H200 graphics processing unit for export to China, but Beijing has deliberately restricted Chinese firms from purchasing them as it pursues a tech self-sufficiency drive."], "verified_passages": ["In early 2026, Washington took the rare step of approving Nvidia’s H200 graphics processing unit for export to China, but Beijing has deliberately restricted Chinese firms from purchasing them as it pursues a tech self-sufficiency drive."], "original_party": "Chinese government (Beijing)", "reporting_speaker": "South China Morning Post", "tier": "fact", "statement_date": null, "statement_date_text": null, "evidence_period": null, "figures": [], "thesis_ids": ["v8"], "unresolved_thesis_ids": []}, {"id": "227:e3", "article": 227, "input_id": "gnews:2a41a34c16f5280b624481fb", "title": "Nvidia slashes list of authorized customers in Asia in a bid to reduce AI chip smuggling, report claims — company sent field inspectors, called customers to check if business is genuine after pressure from Washington", "publisher": "tomshardware.com", "publication_date": "2026-07-14", "summary": "Beijing refused to allow Chinese companies to buy Nvidia's H200 AI processors, choosing instead to rely on domestic semiconductor manufacturers to make up the shortfall.", "passages": ["However, Beijing refused to allow Chinese companies to buy these AI processors — instead, it’s banking on domestic semiconductor manufacturers to make up the shortfall, but it’s apparently still not enough."], "verified_passages": [null], "original_party": "Beijing (Chinese government)", "reporting_speaker": "Tom's Hardware (Jowi Morales)", "tier": "fact", "statement_date": null, "statement_date_text": null, "evidence_period": "Current (reported 2026)", "figures": [], "thesis_ids": ["v17", "v8"], "unresolved_thesis_ids": []}], "links": {"v17": "24:e10", "v8": "24:e10"}, "revises": []}, "24:e11": {"original": {"id": "24:e11", "article": 24, "input_id": "gnews:f8d63eab0337895e8e95cf02", "title": "Nvidia Uses The Specter of Huawei to Make Its Chip Exports Case", "publisher": "thewirechina.com", "publication_date": "2026-07-02", "summary": "Lennart Heim said figures such as 2 to 3 million AI chips are tiny relative to the more than 60 million 910C-equivalent chips the U.S. will have produced between January 2025 and the end of 2026.", "passages": ["Even though figures such as 2 to 3 million AI chips sound significant, “this number is tiny” relative to the more than 60 million 910C-equivalent chips that the U.S. will have produced between January 2025 and the end of this year, Heim adds."], "verified_passages": ["Even though figures such as 2 to 3 million AI chips sound significant, “this number is tiny” relative to the more than 60 million 910C-equivalent chips that the U.S. will have produced between January 2025 and the end of this year, Heim adds."], "original_party": "Lennart Heim", "reporting_speaker": "The Wire China", "tier": "third_party_view", "statement_date": null, "statement_date_text": null, "evidence_period": "January 2025 to end-2026", "figures": [], "thesis_ids": ["v6"], "unresolved_thesis_ids": []}, "members": [], "links": {"v6": "24:e11"}, "revises": []}, "26:e2": {"original": {"id": "26:e2", "article": 26, "input_id": "gnews:b680fbe2c3e9228eba33a0b4", "title": "Startup activates nuclear microreactor live on stage to power an Nvidia RTX Spark desktop PC — firm working with Nvidia to build a 30MW closed loop AI factory that doesn’t use local water", "publisher": "tomshardware.com", "publication_date": "2026-07-02", "summary": "Tom's Hardware reports that public opposition to data centers in the US — with 7 out of 10 Americans saying they do not want a data center in their backyard — led to the delay or cancellation of at least 75 data center projects in the first quarter of 2026, citing power and utility cost increases, water consumption and quality-of-life concerns as the drivers. The report does not identify which developers or projects were affected.", "passages": ["These problems have caused Americans to push back against these projects, with 7 out of 10 saying that they do not want a data center in their backyard . This resistance has led to the delay or cancellation of at least 75 projects in just the first quarter of 2026."], "verified_passages": ["These problems have caused Americans to push back against these projects, with 7 out of 10 saying that they do not want a data center in their backyard . This resistance has led to the delay or cancellation of at least 75 projects in just the first quarter of 2026."], "original_party": "Tom's Hardware", "reporting_speaker": "Jowi Morales (Tom's Hardware)", "tier": "third_party_view", "statement_date": null, "statement_date_text": null, "evidence_period": "Q1 2026", "figures": [], "thesis_ids": ["v2", "v4"], "unresolved_thesis_ids": []}, "members": [], "links": {"v2": "26:e2", "v4": "26:e2"}, "revises": []}, "27:e1": {"original": {"id": "27:e1", "article": 27, "input_id": "gnews:82efe7d37ce9286b38e5aac5", "title": "Nvidia’s Silent AI Colonialism Is Trapping East Asia in a Fossil-Fueled Hell - The Diplomat – Asia-Pacific Current Affairs Magazine", "publisher": "thediplomat.com", "publication_date": "2026-07-02", "summary": "Nvidia CEO Jensen Huang estimated that for every $100 spent by U.S. AI companies, $60 is spent on Nvidia's GPUs, implying Nvidia captures a roughly 60% share of U.S. AI company spending. The estimate is undated and refers to U.S. AI companies' spending rather than total global data-center accelerator spending.", "passages": ["For every $100 spent by U.S. AI companies, $60 is spent on Nvidia’s GPUs, Huang estimated ."], "verified_passages": ["For every $100 spent by U.S. AI companies, $60 is spent on Nvidia’s GPUs, Huang estimated ."], "original_party": "Jensen Huang / NVIDIA", "reporting_speaker": "The Diplomat (Greenpeace East Asia and Alistair Alexander)", "tier": "party_statement", "statement_date": null, "statement_date_text": null, "evidence_period": null, "figures": [{"measure": "Nvidia GPU spending per $100 of U.S. AI company spending", "period": null, "value": "$60", "kind": "estimate", "basis": "Jensen Huang estimate; U.S. AI companies' spending"}], "thesis_ids": ["v6"], "unresolved_thesis_ids": []}, "members": [], "links": {"v6": "27:e1"}, "revises": []}, "27:e2": {"original": {"id": "27:e2", "article": 27, "input_id": "gnews:82efe7d37ce9286b38e5aac5", "title": "Nvidia’s Silent AI Colonialism Is Trapping East Asia in a Fossil-Fueled Hell - The Diplomat – Asia-Pacific Current Affairs Magazine", "publisher": "thediplomat.com", "publication_date": "2026-07-02", "summary": "The article states that Nvidia's GPU shipments are forecast to grow at 26 percent per year — an unattributed forecast — and ties the continuation of its rising supply-chain emissions (which it says more than doubled over the past three years) to that shipment growth.", "passages": ["Over the past three years, Nvidia’s supply chain emissions have more than doubled , and the trend is likely to continue as the company’s GPU shipments are forecast to grow at 26 percent per year."], "verified_passages": ["Over the past three years, Nvidia’s supply chain emissions have more than doubled , and the trend is likely to continue as the company’s GPU shipments are forecast to grow at 26 percent per year."], "original_party": null, "reporting_speaker": "The Diplomat (Greenpeace East Asia and Alistair Alexander)", "tier": "rumour", "statement_date": null, "statement_date_text": null, "evidence_period": null, "figures": [], "thesis_ids": ["v1"], "unresolved_thesis_ids": []}, "members": [], "links": {"v1": "27:e2"}, "revises": []}, "27:e3": {"original": {"id": "27:e3", "article": 27, "input_id": "gnews:82efe7d37ce9286b38e5aac5", "title": "Nvidia’s Silent AI Colonialism Is Trapping East Asia in a Fossil-Fueled Hell - The Diplomat – Asia-Pacific Current Affairs Magazine", "publisher": "thediplomat.com", "publication_date": "2026-07-02", "summary": "TSMC's planned Fab 25 near Taichung will require at least 1 GW of power and about 100,000 tonnes of water per day; across Taiwan TSMC operates more than two dozen fabs and is planning 10 more advanced fabs like Fab 25, and TSMC alone could consume 24 percent of Taiwan's electricity by 2030, up from over 12 percent last year. The expansion adds leading-edge wafer capacity relevant to Nvidia's foundry supply but is not CoWoS advanced-packaging capacity.", "passages": ["Take Fab 25 as an example. This TSMC manufacturing center, to be built near Taichung city, will require at least 1 GW of power – roughly the same as the entire city of Taichung – and about 100,000 tonnes of water per day, roughly a fifth of the city’s daily water use. Across Taiwan, TSMC operates more than two dozen fabs, and is planning 10 more advanced fabs like Fab 25. As a result, TSMC alone could consume 24 percent of Taiwan’s electricity by 2030, up from over 12 percent last year."], "verified_passages": ["Take Fab 25 as an example. This TSMC manufacturing center, to be built near Taichung city, will require at least 1 GW of power – roughly the same as the entire city of Taichung – and about 100,000 tonnes of water per day, roughly a fifth of the city’s daily water use. Across Taiwan, TSMC operates more than two dozen fabs, and is planning 10 more advanced fabs like Fab 25. As a result, TSMC alone could consume 24 percent of Taiwan’s electricity by 2030, up from over 12 percent last year."], "original_party": "TSMC (as reported)", "reporting_speaker": "The Diplomat (Greenpeace East Asia and Alistair Alexander)", "tier": "fact", "statement_date": null, "statement_date_text": null, "evidence_period": null, "figures": [], "thesis_ids": [], "unresolved_thesis_ids": []}, "members": [], "links": {}, "revises": []}, "27:e4": {"original": {"id": "27:e4", "article": 27, "input_id": "gnews:82efe7d37ce9286b38e5aac5", "title": "Nvidia’s Silent AI Colonialism Is Trapping East Asia in a Fossil-Fueled Hell - The Diplomat – Asia-Pacific Current Affairs Magazine", "publisher": "thediplomat.com", "publication_date": "2026-07-02", "summary": "Taiwan's utility Taipower plans to build 18 gas plants totaling about 18.2 GW, roughly 40 percent of Taiwan's current generating capacity, largely to meet demand from the semiconductor industry led by TSMC.", "passages": ["To meet this surge, Taipower, Taiwan’s utility, plans to build 18 gas plants totaling about 18.2 GW, roughly 40 percent of Taiwan’s current generating capacity, largely to meet the demand of the semiconductor industry, led by TSMC."], "verified_passages": ["To meet this surge, Taipower, Taiwan’s utility, plans to build 18 gas plants totaling about 18.2 GW, roughly 40 percent of Taiwan’s current generating capacity, largely to meet the demand of the semiconductor industry, led by TSMC."], "original_party": "Taipower (as reported)", "reporting_speaker": "The Diplomat (Greenpeace East Asia and Alistair Alexander)", "tier": "fact", "statement_date": null, "statement_date_text": null, "evidence_period": null, "figures": [], "thesis_ids": [], "unresolved_thesis_ids": []}, "members": [], "links": {}, "revises": []}, "27:e5": {"original": {"id": "27:e5", "article": 27, "input_id": "gnews:82efe7d37ce9286b38e5aac5", "title": "Nvidia’s Silent AI Colonialism Is Trapping East Asia in a Fossil-Fueled Hell - The Diplomat – Asia-Pacific Current Affairs Magazine", "publisher": "thediplomat.com", "publication_date": "2026-07-02", "summary": "Samsung and SK Hynix, which the article says produce most of Nvidia's memory chips, are pursuing massive expansions to meet surging chip demand, and both are key partners in South Korea's 'Yongin Mega-cluster' semiconductor fab and AI-factory complex. The item gives no size or date for the memory capacity additions.", "passages": ["Near Taiwan, South Korea – another major Nvidia manufacturing hub – faces a similar challenge. Samsung and SK Hynix, the two local giants that produce most of Nvidia’s memory chips, are pursuing massive expansions to meet surging chip demand, with little attention to the resulting strain on electricity and emissions. Both companies are key partners in the government’s “Yongin Mega-cluster” plan , a vast complex of semiconductor fabs and AI factories that will become the world’s largest industrial complex."], "verified_passages": ["Near Taiwan, South Korea – another major Nvidia manufacturing hub – faces a similar challenge. Samsung and SK Hynix, the two local giants that produce most of Nvidia’s memory chips, are pursuing massive expansions to meet surging chip demand, with little attention to the resulting strain on electricity and emissions. Both companies are key partners in the government’s “Yongin Mega-cluster” plan , a vast complex of semiconductor fabs and AI factories that will become the world’s largest industrial complex."], "original_party": "Samsung and SK Hynix (as reported)", "reporting_speaker": "The Diplomat (Greenpeace East Asia and Alistair Alexander)", "tier": "fact", "statement_date": null, "statement_date_text": null, "evidence_period": null, "figures": [], "thesis_ids": ["v5"], "unresolved_thesis_ids": []}, "members": [], "links": {"v5": "27:e5"}, "revises": []}, "28:e4": {"original": {"id": "28:e4", "article": 28, "input_id": "gnews:bf158d067256a39f02f7c7ce", "title": "NVIDIA Unveils New AI Compute Model, But Michael Burry is Shorting Its Stock", "publisher": "mitrade.com", "publication_date": "2026-07-02", "summary": "In its market-wrap section, the item reports that Meta's US$145 billion AI spending plan put chip stocks in focus this week; no period for the spending plan is stated.", "passages": ["Weekly Market Wrap: Meta’s $145 billion AI bill hit chips — as Brent surged past $116", "Meta’s US$145 billion AI spending plan puts chip stocks in focus as Brent crude surges past US$116."], "verified_passages": ["Weekly Market Wrap: Meta’s $145 billion AI bill hit chips — as Brent surged past $116", "Meta’s US$145 billion AI spending plan puts chip stocks in focus as Brent crude surges past US$116."], "original_party": "Meta", "reporting_speaker": "mitrade.com", "tier": "party_statement", "statement_date": null, "statement_date_text": null, "evidence_period": null, "figures": [], "thesis_ids": ["v13", "v4"], "unresolved_thesis_ids": []}, "members": [], "links": {"v13": "28:e4", "v4": "28:e4"}, "revises": []}, "29:e2": {"original": {"id": "29:e2", "article": 29, "input_id": "gnews:1eeceeb212a2c82c2e75e806", "title": "Singaporean Police Seize $42M Bungalow in Nvidia Chip Smuggling Probe - The Diplomat – Asia-Pacific Current Affairs Magazine", "publisher": "thediplomat.com", "publication_date": "2026-07-02", "summary": "Singapore police charged Aperia Group officers with conspiring to commit fraud in the purchase of servers from U.S. companies Dell, Super Micro Computer and Asus, alleging that between November 2023 and February 2025 they falsely represented to the suppliers that an Aperia Group company would be the end-user of the servers (which may have contained advanced Nvidia AI chips).", "passages": ["The fraud charges allege that the three “engaged in a conspiracy to commit fraud in respect of the purchase of servers” from the U.S. companies Dell, Super Micro Computer, and Asus. The charges assert that between November 2023 and February 2025, the trio “falsely represented, in communications to these suppliers, that one of the Aperia Group companies would be the end-user of the servers.”"], "verified_passages": ["The fraud charges allege that the three “engaged in a conspiracy to commit fraud in respect of the purchase of servers” from the U.S. companies Dell, Super Micro Computer, and Asus. The charges assert that between November 2023 and February 2025, the trio “falsely represented, in communications to these suppliers, that one of the Aperia Group companies would be the end-user of the servers.”"], "original_party": "Singapore Police Force", "reporting_speaker": "The Diplomat (Sebastian Strangio)", "tier": "fact", "statement_date": "2026-07-01", "statement_date_text": "yesterday", "evidence_period": "November 2023 - February 2025", "figures": [], "thesis_ids": ["v17"], "unresolved_thesis_ids": []}, "members": [{"id": "51:e2", "article": 51, "input_id": "gnews:d1a7a7f18dce5c8ae5e4d0ae", "title": "Singapore files new charges in Nvidia chip fraud case", "publisher": "sg.finance.yahoo.com", "publication_date": "2026-07-05", "summary": "According to a Singapore police statement published on July 1, three Aperia Group executives - Wei, Aaron Woon Guo Jie and Jenny Lim - falsely told server suppliers between November 2023 and February 2025 that one of Aperia Group's companies would be the end-user of the servers. Prosecutors allege executives including Wei misled Dell Technologies, Super Micro Computer and Asustek Computer about the actual end-users of hardware that may have contained Nvidia AI processors subject to US export controls.", "passages": ["The high-profile case centres on whether executives including Wei at Aperia Group misled Dell Technologies Inc, Super Micro Computer Inc and Asustek Computer Inc by misrepresenting the actual end-users of the hardware they acquired from these server suppliers.", "Between November 2023 and February 2025, three Aperia executives - Wei, Aaron Woon Guo Jie and Jenny Lim - falsely told the suppliers that one of the Aperia Group's companies would be the end-user of the servers, according to a police statement published on July 1."], "verified_passages": ["The high-profile case centres on whether executives including Wei at Aperia Group misled Dell Technologies Inc, Super Micro Computer Inc and Asustek Computer Inc by misrepresenting the actual end-users of the hardware they acquired from these server suppliers.", "Between November 2023 and February 2025, three Aperia executives - Wei, Aaron Woon Guo Jie and Jenny Lim - falsely told the suppliers that one of the Aperia Group's companies would be the end-user of the servers, according to a police statement published on July 1."], "original_party": "Singapore police / prosecutors", "reporting_speaker": "sg.finance.yahoo.com", "tier": "fact", "statement_date": "2026-07-01", "statement_date_text": "July 1", "evidence_period": "November 2023 – February 2025", "figures": [], "thesis_ids": [], "unresolved_thesis_ids": []}, {"id": "94:e2", "article": 94, "input_id": "gnews:c6445931955f107b551cce85", "title": "$42M Singapore mansion seized in Nvidia AI chip smuggling case", "publisher": "e.vnexpress.net", "publication_date": "2026-07-07", "summary": "Prosecutors allege that Aperia Group chief executive Wei Zhaolun (Alan Wei) and two other Aperia executives deceived Dell, Super Micro Computer and Asus between November 2023 and February 2025 by certifying on end-user forms that companies within the group would receive servers, in a case involving servers believed to contain Nvidia chips barred from export to China; Wei pleaded not guilty on July 6 and his lawyer called the charges \"misconceived.\"", "passages": ["Prosecutors say Wei and two other Aperia executives deceived Dell, Super Micro Computer and Asus between November 2023 and February 2025 by certifying on end-user forms that companies within the group would receive the servers.", "Aperia Group chief executive Wei Zhaolun, 50, known as Alan Wei, pleaded not guilty on July 6 to all 11 charges against him regarding the case and had his bail raised to S$1.25 million, Bloomberg reported. His lawyer called the charges \"misconceived.\""], "verified_passages": ["Prosecutors say Wei and two other Aperia executives deceived Dell, Super Micro Computer and Asus between November 2023 and February 2025 by certifying on end-user forms that companies within the group would receive the servers.", "Aperia Group chief executive Wei Zhaolun, 50, known as Alan Wei, pleaded not guilty on July 6 to all 11 charges against him regarding the case and had his bail raised to S$1.25 million, Bloomberg reported. His lawyer called the charges \"misconceived.\""], "original_party": "Singapore prosecutors (charge sheets)", "reporting_speaker": "e.vnexpress.net (citing Bloomberg, Mothership, charge sheets)", "tier": "fact", "statement_date": null, "statement_date_text": null, "evidence_period": "November 2023 - February 2025 (alleged end-user certification period)", "figures": [], "thesis_ids": ["v17"], "unresolved_thesis_ids": []}], "links": {"v17": "29:e2"}, "revises": []}, "29:e3": {"original": {"id": "29:e3", "article": 29, "input_id": "gnews:1eeceeb212a2c82c2e75e806", "title": "Singaporean Police Seize $42M Bungalow in Nvidia Chip Smuggling Probe - The Diplomat – Asia-Pacific Current Affairs Magazine", "publisher": "thediplomat.com", "publication_date": "2026-07-02", "summary": "As reported on 2026-07-02, Malaysian authorities said last week that they had foiled an attempt to smuggle advanced AI chips through the country's main airport, seizing 72 servers worth nearly $13 million.", "passages": ["Last week, Malaysian authorities said they had foiled an attempt to smuggle advanced AI chips through the country's main airport, seizing 72 servers worth nearly $13 million."], "verified_passages": ["Last week, Malaysian authorities said they had foiled an attempt to smuggle advanced AI chips through the country’s main airport, seizing 72 servers worth nearly $13 million."], "original_party": "Malaysian authorities", "reporting_speaker": "The Diplomat (Sebastian Strangio)", "tier": "fact", "statement_date": null, "statement_date_text": "last week", "evidence_period": null, "figures": [], "thesis_ids": ["v17"], "unresolved_thesis_ids": []}, "members": [], "links": {"v17": "29:e3"}, "revises": []}, "30:e2": {"original": {"id": "30:e2", "article": 30, "input_id": "gnews:3345f0d91321165a099860c9", "title": "Singapore Seizes $42M Mansion in Nvidia Chip Smuggling Probe｜Daily News Digest｜2026-07-02｜web only", "publisher": "english.cw.com.tw", "publication_date": "2026-07-02", "summary": "Four companies — Aperia International, A-Speed Infotech and Aperia Cloud Services (II), collectively the Aperia group, plus Luxuriate Your Life — are facing charges in Singapore for false representation over the alleged export of computer servers that might contain Nvidia chips to Malaysia. Luxuriate Your Life was charged on July 1, while the other three firms will be charged on July 6.", "passages": ["Four firms allegedly linked to the export of computer servers that might contain Nvidia chips to Malaysia are facing charges for false representation.", "The companies are Aperia International, A-Speed Infotech, and Aperia Cloud Services (II) — collectively known as the Aperia group — and Luxuriate Your Life.", "Luxuriate Your Life was charged on July 1, while the other three firms will be charged on July 6."], "verified_passages": ["Four firms allegedly linked to the export of computer servers that might contain Nvidia chips to Malaysia are facing charges for false representation.", "The companies are Aperia International, A-Speed Infotech, and Aperia Cloud Services (II) — collectively known as the Aperia group — and Luxuriate Your Life.", "Luxuriate Your Life was charged on July 1, while the other three firms will be charged on July 6."], "original_party": "Singapore authorities", "reporting_speaker": "CommonWealth Magazine", "tier": "fact", "statement_date": null, "statement_date_text": "July 1 and July 6", "evidence_period": null, "figures": [], "thesis_ids": ["v17"], "unresolved_thesis_ids": []}, "members": [], "links": {"v17": "30:e2"}, "revises": []}, "31:e1": {"original": {"id": "31:e1", "article": 31, "input_id": "gnews:8c9d215416b714064de3b095", "title": "NVIDIA Quietly Makes Omniverse Free for Production Use", "publisher": "storagereview.com", "publication_date": "2026-07-03", "summary": "NVIDIA dropped the subscription requirement for its Omniverse platform: per licensing documentation updated to state that “As of May 2026, Omniverse is freely available for both development and production use,” the platform is now free for development, production and redistribution with no NVIDIA AI Enterprise subscription required, and a short announcement was posted to the NVIDIA Developer Forums on July 1, 2026. Under the prior model, production deployments required an NVIDIA AI Enterprise subscription listed at $4,500 per GPU per year, $22,500 per GPU perpetual, or $1 per GPU-hour on CSP marketplaces; the new terms remove that requirement entirely and allow anything built with Omniverse to be redistributed under the same free terms, including by ISVs and integrators embedding Omniverse applications in their own products. Support without a subscription is limited to community channels (Developer Forums and Discord); organizations wanting enterprise support SLAs still buy NVIDIA AI Enterprise through a reseller or CSP marketplace, and partners redistributing Omniverse in commercial products can use an embedded licensing model with partner front-line and NVIDIA back-line support.", "passages": ["NVIDIA has dropped the subscription requirement for Omniverse . The platform is now free for development, production, and redistribution, with no NVIDIA AI Enterprise subscription required.", "Licensing documentation was updated to read “As of May 2026, Omniverse is freely available for both development and production use,” and a short announcement was posted to the NVIDIA Developer Forums on July 1.", "Under the old model, Omniverse development was free, but production deployments required an NVIDIA AI Enterprise subscription, which lists at $4,500 per GPU per year, $22,500 per GPU perpetual , or $1 per GPU-hour on CSP marketplaces. The new terms remove that requirement entirely; anything built with Omniverse can also be redistributed under the same free terms, which is a substantive impact for ISVs and integrators who embed Omniverse applications inside their own products.", "The catch, such as it is, sits in support. Without a subscription, support is limited to community channels, meaning the Developer Forums and Discord. Organizations that want enterprise support SLAs still buy NVIDIA AI Enterprise through a reseller or CSP marketplace. Partners who redistribute Omniverse within commercial products can use an embedded licensing model in which the partner handles front-line support, and NVIDIA provides back-line support."], "verified_passages": ["NVIDIA has dropped the subscription requirement for Omniverse . The platform is now free for development, production, and redistribution, with no NVIDIA AI Enterprise subscription required.", "Licensing documentation was updated to read “As of May 2026, Omniverse is freely available for both development and production use,” and a short announcement was posted to the NVIDIA Developer Forums on July 1.", "Under the old model, Omniverse development was free, but production deployments required an NVIDIA AI Enterprise subscription, which lists at $4,500 per GPU per year, $22,500 per GPU perpetual , or $1 per GPU-hour on CSP marketplaces. The new terms remove that requirement entirely; anything built with Omniverse can also be redistributed under the same free terms, which is a substantive impact for ISVs and integrators who embed Omniverse applications inside their own products.", "The catch, such as it is, sits in support. Without a subscription, support is limited to community channels, meaning the Developer Forums and Discord. Organizations that want enterprise support SLAs still buy NVIDIA AI Enterprise through a reseller or CSP marketplace. Partners who redistribute Omniverse within commercial products can use an embedded licensing model in which the partner handles front-line support, and NVIDIA provides back-line support."], "original_party": "NVIDIA", "reporting_speaker": "StorageReview (storagereview.com)", "tier": "fact", "statement_date": "2026-07-01", "statement_date_text": "July 1", "evidence_period": "As of May 2026, ongoing", "figures": [], "thesis_ids": ["v1"], "unresolved_thesis_ids": []}, "members": [], "links": {"v1": "31:e1"}, "revises": []}, "32:e1": {"original": {"id": "32:e1", "article": 32, "input_id": "gnews:1740f3733eedc34d8bac9b65", "title": "MicroLED manufacturer nabs Nvidia director to drive AI data center push", "publisher": "sdxcentral.com", "publication_date": "2026-07-03", "summary": "Microsoft and Taiwanese fabless chipmaker MediaTek, having matured Microsoft's Mosaic prototype microLED interconnect work through a collaboration, plan to launch microLED-based data center networking interconnects for partners by late 2027. Microsoft's Mosaic prototype is described as maintaining high network speeds with greater reach at far lower power than copper or conventional fiber links; the work was first detailed in a paper published last September. No volumes, spending or committed customers are given.", "passages": ["Microsoft is among those exploring potential microLED links, with its Mosaic prototype interconnect system capable of maintaining high network speeds with further reach while using far less power.", "Those efforts were initially detailed in a paper published last September, but have since matured via a collaboration with Taiwanese fabless semiconductor company MediaTek. The pair plans to launch microLED-based data center networking interconnects for partners by late 2027 ."], "verified_passages": ["Microsoft is among those exploring potential microLED links, with its Mosaic prototype interconnect system capable of maintaining high network speeds with further reach while using far less power.", "Those efforts were initially detailed in a paper published last September, but have since matured via a collaboration with Taiwanese fabless semiconductor company MediaTek. The pair plans to launch microLED-based data center networking interconnects for partners by late 2027 ."], "original_party": "Microsoft and MediaTek", "reporting_speaker": "sdxcentral.com (Ben Wodecki)", "tier": "party_statement", "statement_date": null, "statement_date_text": null, "evidence_period": "launch targeted by late 2027", "figures": [], "thesis_ids": [], "unresolved_thesis_ids": []}, "members": [], "links": {}, "revises": []}, "33:e1": {"original": {"id": "33:e1", "article": 33, "input_id": "gnews:e4e5f1b5c0c68381e4c486e1", "title": "Here's What a $25,000 Investment in Nvidia Could Be Worth if History Repeats Itself", "publisher": "fool.com", "publication_date": "2026-07-03", "summary": "Nvidia reported that in the first quarter of its fiscal year 2027, the quarter ended April 26, 2026, revenue grew 85% year over year and diluted earnings per share rose 140% year over year, as reported by fool.com's Bram Berkowitz.", "passages": ["In the first quarter of Nvidia's fiscal year 2027, ending April 26, the company grew revenue 85% year over year, while diluted earnings per share soared by 140%."], "verified_passages": ["In the first quarter of Nvidia's fiscal year 2027, ending April 26, the company grew revenue 85% year over year, while diluted earnings per share soared by 140%."], "original_party": "NVIDIA", "reporting_speaker": "Bram Berkowitz, fool.com", "tier": "fact", "statement_date": null, "statement_date_text": null, "evidence_period": "Q1 FY2027 (quarter ended April 26, 2026)", "figures": [{"measure": "Revenue growth", "period": "Q1 FY2027 (quarter ended April 26, 2026)", "value": "85%", "kind": "actual", "basis": "year over year"}, {"measure": "Diluted earnings per share growth", "period": "Q1 FY2027 (quarter ended April 26, 2026)", "value": "140%", "kind": "actual", "basis": "year over year; diluted"}], "thesis_ids": ["v1", "v11"], "unresolved_thesis_ids": []}, "members": [{"id": "62:e1", "article": 62, "input_id": "gnews:25d0b1d2a9dfe0bb99432e1a", "title": "NVIDIA Falls 7% in a Month: Should You Sti