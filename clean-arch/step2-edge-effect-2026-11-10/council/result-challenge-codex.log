 year"}], "thesis_ids": ["v1", "v2"], "unresolved_thesis_ids": []}, {"id": "65:e1", "article": 65, "input_id": "gnews:4d1b1ca014068fb532f116b3", "title": "Nvidia’s Biggest Threat Is This: Everyone Is Desperate to Stop Paying Nvidia Prices.", "publisher": "247wallst.com", "publication_date": "2026-07-06", "summary": "NVIDIA reported Q1 FY2027 revenue of $81.61 billion, up 85.2% year over year, including data center revenue of $75.25 billion, according to 24/7 Wall St.'s recap of the results.", "passages": ["Q1 FY27 revenue came in at $81.61 billion, up 85.2% year over year, with data center revenue of $75.25 billion."], "verified_passages": ["Q1 FY27 revenue came in at $81.61 billion, up 85.2% year over year, with data center revenue of $75.25 billion."], "original_party": "NVIDIA", "reporting_speaker": "Omor Ibne Ehsan, 24/7 Wall St.", "tier": "fact", "statement_date": null, "statement_date_text": null, "evidence_period": "Q1 FY2027", "figures": [{"measure": "Revenue", "period": "Q1 FY2027", "value": "$81.61 billion", "kind": "actual", "basis": "Company total, GAAP-basis headline revenue as reported in the item"}, {"measure": "Revenue growth", "period": "Q1 FY2027", "value": "85.2% year over year", "kind": "actual", "basis": "Company total, year-over-year"}, {"measure": "Data center revenue", "period": "Q1 FY2027", "value": "$75.25 billion", "kind": "actual", "basis": "Data Center segment"}], "thesis_ids": ["v1", "v2"], "unresolved_thesis_ids": []}, {"id": "72:e6", "article": 72, "input_id": "gnews:d4c5dc540392f8df39aee250", "title": "Nvidia Delays Next-Generation Kyber Server Architecture as Manufacturing Hurdles Give Rivals a Rare Opening", "publisher": "tikr.com", "publication_date": "2026-07-06", "summary": "Nvidia reported $82 billion in total revenue in its most recent quarter, up 85% year-over-year, with data-center revenue of $75 billion, and free cash flow of a record $49 billion, according to the article.", "passages": ["In the most recent quarter, the com