": "2026-07-07", "statement_date_text": null, "evidence_period": null, "figures": [], "thesis_ids": ["v19"], "unresolved_thesis_ids": []}, "members": [{"id": "161:e1", "article": 161, "input_id": "gnews:b666d35e5247a8ddcc2d7c72", "title": "Single-Threaded CPU Performance Gains With NVIDIA Vera", "publisher": "quantumzeitgeist.com", "publication_date": "2026-07-10", "summary": "AI company Perplexity is reported to be among the first customers to adopt NVIDIA's newly unveiled Vera CPU and is now planning to integrate Vera into its upcoming production systems. Perplexity tested Vera on real coding workflows, where Vera completed the job (cloning a repository and running its test suite in sandboxes) about 1.5x faster than x86 and started concurrent sandboxes up to 1.9x faster.", "passages": ["AI innovator Perplexity is among the first to adopt it.", "Perplexity tested Vera on real-world coding workflows, achieving a 1.5 times speed increase in cloning repositories and running test suites, and Perplexity started concurrent sandboxes up to 1.9 times faster.", "Perplexity is now planning to integrate Vera into its upcoming production systems, demonstrating confidence in its ability to enhance agent performance and overall system efficiency."], "verified_passages": ["AI innovator Perplexity is among the first to adopt it.", "Perplexity tested Vera on real-world coding workflows, achieving a 1.5 times speed increase in cloning repositories and running test suites, and Perplexity started concurrent sandboxes up to 1.9 times faster.", "Perplexity is now planning to integrate Vera into its upcoming production systems, demonstrating confidence in its ability to enhance agent performance and overall system efficiency."], "original_party": "Perplexity", "reporting_speaker": "quantumzeitgeist.com", "tier": "fact", "statement_date": null, "statement_date_text": null, "evidence_period": null, "figures": [], "thesis_ids": ["v19"], "unresolved_thesis_ids": []}, {"id": "167:e6", "articl