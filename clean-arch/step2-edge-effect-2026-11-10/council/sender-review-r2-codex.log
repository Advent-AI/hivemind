   142	                        raise
   143	                    failure = TransportError('invalid UTF-8 HTTP response')
   144	                    failure.response_body = raw_bytes.decode('utf-8', 'replace')
   145	                    failure.response_body_base64 = base64.b64encode(raw_bytes).decode('ascii')
   146	                    failure.http_status = response.status
   147	                    raise failure
   148	                try:
   149	                    return json.loads(raw)
   150	                except json.JSONDecodeError:
   151	                    if max_attempts != 1:
   152	                        raise
   153	                    failure = TransportError('malformed HTTP response')
   154	                    failure.response_body = raw
   155	                    failure.http_status = response.status
   156	                    raise failure
   157	        except urllib.error.HTTPError as error:
   158	            body_bytes = error.read()
   159	            body_text = body_bytes.decode('utf-8', 'replace' if max_attempts == 1 else 'ignore')
   160	            last_http = (error.code, body_text, base64.b64encode(body_bytes).decode('ascii'))
   161	            last = f'HTTP {error.code}: {body_text[:600]}'
   162	            if error.code in (400, 401, 403, 404):
   163	                failure = TransportError(last)
   164	                failure.response_body = body_text
   165	                failure.response_body_base64 = last_http[2]
