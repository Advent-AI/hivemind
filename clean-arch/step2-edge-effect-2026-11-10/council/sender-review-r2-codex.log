   206	def counterfactual(output, control_folder, by, revised_group, keep_links):
   207	    output, control_folder = Path(output).resolve(), Path(control_folder).resolve()
   208	    if not json.loads((control_folder / 'control-report.json').read_text())['passed']:
   209	        raise SystemExit('the control did not pass; no counterfactual is replayed against it')
   210	    control_rounds = json.loads((control_folder / 'control-rounds.json').read_text(), object_pairs_hook=collections.OrderedDict)
   211	    control_requests = json.loads((control_folder / 'control-requests.json').read_text())
   212	    scratch = output.parent / (output.name + '-inputs')
   213	    removed = library_without_relation(scratch / 'step2', by, revised_group)
   214	    kept = {by: removed['revised original thesis ids']} if keep_links else None
   215	    rounds_seen = []
   216	    found = {}
   217	
   218	    def on_round(day, entries, error):
   219	        earlier_missing = [control_day for control_day in control_rounds if control_day < day and control_day not in rounds_seen]
   220	        rounds_seen.append(day)
   221	        expected = sorted((entry['view'], entry['sha256']) for entry in control_rounds.get(day, []))
   222	        if earlier_missing or error or round_signature(entries) != expected:
   223	            found.update(day=day, entries=entries, rounds_without_judging=earlier_missing, error=str(error) if error else None)
   224	            if not error:
   225	                raise Divergence(day)
   226	
   227	    diverged = True
   228	    try:
   229	        adapter, recorder, reference = run_replay(output, scratch / 'step2', on_round=on_round, keep_links=kept)
   230	        adapter.conn.close()
   231	        never_judged = [day for day in control_rounds if day not in rounds_seen]
   232	        if never_judged:
   233	            found.update(day=None, entries=[], rounds_without_judging=never_judged, error=None)
   234	        else:
   235	            diverged = False
   236	    except (Divergence, control_v108.ReferenceMissError):
   237	        pass
   238	    report = {'relation removed': removed, 'links kept without the relation': kept, 'diverged': diverged,
   239	              'rounds identical to the control before the first difference': [day for day in rounds_seen if day != found.get('day')]}
   240	    if diverged:
   241	        day = found['day']
   242	        control_by_view = collections.defaultdict(list)
   243	        for entry in control_rounds.get(day, []):
   244	            control_by_view[entry['view']].append(entry['sha256'])
   245	        replay_by_view = collections.defaultdict(list)
   246	        for entry in found['entries']:
   247	            replay_by_view[entry['view']].append(entry)
   248	        changed = []
   249	        for view_id in sorted(set(control_by_view) | set(replay_by_view)):
   250	            control_shas = control_by_view.get(view_id, [])
   251	            replay_entries = replay_by_view.get(view_id, [])
   252	            if sorted(control_shas) == sorted(entry['sha256'] for entry in replay_entries):
   253	                continue
   254	            first_control = control_requests[control_shas[0]] if control_shas else None
   255	            first_replay = next((entry['request'] for entry in replay_entries if entry['sha256'] not in control_shas), None)
   256	            detail = {'view': view_id, 'control requests': len(control_shas), 'counterfactual requests': len(replay_entries)}
   257	            if first_control and first_replay:
   258	                control_shown = e2e_adapter.SHOWN_EVIDENCE.findall(user_text(first_control))
   259	                replay_shown = e2e_adapter.SHOWN_EVIDENCE.findall(user_text(first_replay))
   260	                detail['evidence only in the control request'] = [e for e in control_shown if e not in replay_shown]
   261	                detail['evidence only in the counterfactual request'] = [e for e in replay_shown if e not in control_shown]
   262	                detail['system text identical'] = first_control['messages'][0] == first_replay['messages'][0]
   263	                detail['diff of the user text'] = list(difflib.unified_diff(user_text(first_control).splitlines(), user_text(first_replay).splitlines(),
   264	                                                                            'control', 'counterfactual', lineterm='', n=0))
   265	                (output / f'request-{view_id}-control.json').write_text(json.dumps(first_control, ensure_ascii=False, indent=1))
   266	                (output / f'request-{view_id}-counterfactual.json').write_text(json.dumps(first_replay, ensure_ascii=False, indent=1))
   267	            changed.append(detail)
   268	        report.update({'first differing round': day, 'control days with no judging round in the counterfactual': found['rounds_without_judging'],
   269	                       'reference miss': found['error'], 'views whose requests differ in that round': changed,
   270	                       'views with identical requests in that round': sorted(v for v in control_by_view if sorted(control_by_view[v]) ==
   271	                                                                              sorted(e['sha256'] for e in replay_by_view.get(v, [])))})
   272	    output.mkdir(parents=True, exist_ok=True)
   273	    (output / 'counterfactual-report.json').write_text(json.dumps(report, ensure_ascii=False, indent=1))
   274	    print(json.dumps({name: value for name, value in report.items() if name != 'views whose requests differ in that round'}, ensure_ascii=False, indent=1))
   275	    for detail in report.get('views whose requests differ in that round', []):
   276	        print(json.dumps({name: value for name, value in detail.items() if name != 'diff of the user text'}, ensure_ascii=False))
   277	        print('\n'.join(detail.get('diff of the user text', [])))
