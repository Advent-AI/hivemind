   179	def check_schema(value, schema, path='$', root=None):
   180	    """A small validator for the subset of JSON Schema the prompts use: object/required/additionalProperties,
   181	    array/items/minItems, string/enum/pattern, integer, number, boolean, null in anyOf, and $ref into the root's $defs."""
   182	    root = root if root is not None else schema
   183	    if '$ref' in schema:
   184	        name = schema['$ref'].rsplit('/', 1)[1]
   185	        schema = root['$defs'][name]
   186	    kind = schema.get('type')
   187	    if 'anyOf' in schema:
   188	        # a value matching no option reports the closest options' errors (fewest), not merely the last option's
   189	        failures = []
   190	        for option in schema['anyOf']:
   191	            errors = check_schema(value, option, path, root)
   192	            if not errors:
   193	                return []
   194	            failures.append(errors)
   195	        fewest = min((len(errors) for errors in failures), default=0)
   196	        closest = list(dict.fromkeys(error for errors in failures if len(errors) == fewest for error in errors))
   197	        return closest or [f'{path}: matches no option']
   198	    if kind == 'object':
   199	        if not isinstance(value, dict):
   200	            return [f'{path}: expected object']
   201	        errors = []
   202	        for name in schema.get('required', []):
   203	            if name not in value:
   204	                errors.append(f'{path}.{name}: required')
   205	        properties = schema.get('properties', {})
   206	        for name, item in value.items():
   207	            if name in properties:
   208	                errors.extend(check_schema(item, properties[name], f'{path}.{name}', root))
   209	            elif schema.get('additionalProperties') is False:
   210	                errors.append(f'{path}.{name}: not allowed')
   211	        return errors
   212	    if kind == 'array':
   213	        if not isinstance(value, list):
   214	            return [f'{path}: expected array']
   215	        errors = []
   216	        if len(value) < schema.get('minItems', 0):
   217	            errors.append(f'{path}: fewer than {schema["minItems"]} items')
   218	        for index, item in enumerate(value):
   219	            errors.extend(check_schema(item, schema.get('items', {}), f'{path}[{index}]', root))
   220	        return errors

