    53	class Budget:
    54	    def __init__(self, cap_usd, attempt=None, sleep=time.sleep, jev_transport=None):
    55	        """attempt(provider, request) sends one attempt; the default is the production transport with a single attempt.
    56	        jev_transport(request) sends a Jev call; the default is production's."""
    57	        self.cap_usd, self.spent_usd, self.reserved_usd = cap_usd, 0.0, 0.0
    58	        self.attempt = attempt or (lambda provider, request: model.openai_transport(provider, request, max_attempts=1))
    59	        self.jev_transport = jev_transport or jev.transport
    60	        self.sleep = sleep
    61	        self.lock = threading.Lock()
    62	
    63	    def send(self, provider, request):
    64	        reserve = worst_cost(request)
    65	        for attempt_number in range(ATTEMPTS):
    66	            with self.lock:
    67	                if self.spent_usd + self.reserved_usd + reserve > self.cap_usd:
    68	                    raise OverBudget(f'spent ${self.spent_usd:.4f}, ${self.reserved_usd:.4f} in flight; '
    69	                                     f'${reserve:.4f} more would pass the ${self.cap_usd:.2f} cap')
    70	                self.reserved_usd += reserve
    71	            response, failure = None, None
    72	            try:
    73	                response = self.attempt(provider, request)
    74	            except model.TransportError as error:
    75	                failure = error
    76	            finally:
    77	                with self.lock:   # one step: the reserve is released only as the attempt is charged
    78	                    self.reserved_usd -= reserve
    79	                    charged = cost(request, response) if response is not None else None
    80	                    self.spent_usd += reserve if charged is None else charged   # no answer, or no usable usage: the full reserve
    81	            if response is not None:
    82	                return response
    83	            retried = getattr(failure, 'http_status', None) not in NOT_RETRIED and str(failure) not in UNDECODABLE
    84	            if not retried or attempt_number + 1 == ATTEMPTS:
    85	                raise failure
    86	            self.sleep(5 * (attempt_number + 1))
    87	
    88	    def send_jev(self, request):
    89	        input_rate, _ = model.PRICES[request['model']]
    90	        charge = ATTEMPTS * len(json.dumps(request, sort_keys=True, ensure_ascii=False).encode('utf-8')) * input_rate / 1e6   # jev.transport's body bytes
    91	        with self.lock:
    92	            if self.spent_usd + self.reserved_usd + charge > self.cap_usd:
    93	                raise OverBudget(f'spent ${self.spent_usd:.4f}, ${self.reserved_usd:.4f} in flight; a Jev call of ${charge:.4f} would pass '
    94	                                 f'the ${self.cap_usd:.2f} cap')
    95	            self.spent_usd += charge
    96	        return self.jev_transport(request)
    97	
    98	    def __call__(self, *arguments):
    99	        return self.send(*arguments) if len(arguments) == 2 else self.send_jev(*arguments)

