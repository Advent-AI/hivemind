    30	def worst_cost(request):
    31	    """The body as sent (json.dumps, non-ASCII escaped) is at least as long in bytes as the UTF-8 text it carries, and a byte-level
    32	    tokenizer emits at most one token per byte; the JSON keys and syntax in the body more than cover the chat template's few tokens.
    33	    Rates are model.PRICES, the published rates (AGENTS §7.2)."""
    34	    input_rate, output_rate = model.PRICES[request['model']]
    35	    output_cap = request.get('max_completion_tokens') or request.get('max_tokens')
    36	    if not output_cap:
    37	        raise OverBudget(f"a request to {request['model']} has no output cap, so its worst cost is unbounded")
    38	    return (len(json.dumps(request).encode('utf-8')) * input_rate + output_cap * output_rate) / 1e6
