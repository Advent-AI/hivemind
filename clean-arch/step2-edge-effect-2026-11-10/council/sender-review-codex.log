   253	class ReferenceArchiveTransport:
   254	    """Answers each request with the stored response of the byte-identical request in the reference archive.
   255	
   256	    Called as the model transport, (provider, request), or as the Jev transport, (request,): the same object serves both, as
   257	    replay.run passes one transport to both. Each stored row answers one send, in call_id order for rows of the same request."""
   258	
   259	    MODEL_SEND = 'model'
   260	    JEV_SEND = 'jev'
   261	
   262	    def __init__(self, reference_archive_path):
   263	        uri = Path(reference_archive_path).resolve().as_uri() + '?mode=ro'
   264	        with contextlib.closing(sqlite3.connect(uri, uri=True)) as reference:
   265	            rows = reference.execute('select call_id, request_sha256, request_json, response_json from model_calls order by call_id').fetchall()
   266	        self.unanswered = collections.defaultdict(collections.deque)
   267	        for call_id, stored_sha, request_json, response_json in rows:
   268	            base_sha = stored_sha.split(':', 1)[0]
   269	            if text_sha256(request_json) != base_sha:
   270	                raise ProofError(f'reference row {call_id}: request_json does not hash to its request_sha256')
   271	            self.unanswered[base_sha].append((call_id, request_json, response_json))
   272	        self.reference_rows = len(rows)
   273	        self.lock = threading.Lock()
   274	        self.matched = collections.Counter()
   275	        self.misses = []                                        # (sha256, label, canonical text)
   276	        self.sent_digests = collections.defaultdict(set)        # canonical sha256 -> sha256 of the bytes as sent
   277	
   278	    def __call__(self, *arguments):
   279	        if len(arguments) == 2:
   280	            provider, request = arguments
   281	            send_kind = self.MODEL_SEND
   282	            sent_bytes = json.dumps(request).encode('utf-8')                                     # model.openai_transport's body
   283	            label = f'{request.get("response_format", {}).get("json_schema", {}).get("name", "?")} ({provider}, {request.get("model")})'
   284	        elif len(arguments) == 1:
   285	            (request,) = arguments
   286	            send_kind = self.JEV_SEND
   287	            sent_bytes = json.dumps(request, sort_keys=True, ensure_ascii=False).encode('utf-8')  # jev.transport's body
   288	            label = f'jev ({request.get("model")})'
   289	        else:
   290	            raise TypeError(f'a transport takes (provider, request) or (request,), not {len(arguments)} arguments')
   291	        canonical = canonical_text(request)
   292	        sha = text_sha256(canonical)
   293	        with self.lock:
   294	            queue = self.unanswered.get(sha)
   295	            if not queue:
   296	                self.misses.append((sha, label, canonical))
   297	                raise ReferenceMissError(f'{label} request {sha} has no unused byte-identical row in the reference archive')
   298	            call_id, stored_request, stored_response = queue.popleft()
   299	            if stored_request != canonical:
   300	                raise ReferenceMissError(f'{label} request {sha} hashes like row {call_id} but its text differs')
   301	            self.matched[label] += 1
   302	            self.sent_digests[sha].add(hashlib.sha256(sent_bytes).hexdigest())
   303	        return json.loads(stored_response)
   304	
   305	    def unused_rows(self):
   306	        with self.lock:
   307	            return sorted(call_id for queue in self.unanswered.values() for call_id, _, _ in queue)
