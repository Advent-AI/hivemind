    34	DRAW = ROOT / 'poc/data/clean-e2e-2026-11-09'
    35	TRACE = f"{DRAW / 'stage2-clean-d1/trace.sqlite'}+{DRAW / 'stage2-clean-d1-segment-2/trace.sqlite'}"
    36	STEP2 = DRAW / 'stage2-clean-d1-segment-2/step2'
