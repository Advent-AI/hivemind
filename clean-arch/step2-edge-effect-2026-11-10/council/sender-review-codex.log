   235	    def leakage_check(self, day, seq):
   236	        for table, column in (('views', 'created_seq'), ('evidence', 'created_seq'), ('evidence_sources', 'seq'), ('evidence_links', 'seq'),
   237	                              ('same_claims', 'seq'), ('revisions', 'seq')):
   238	            top = self.conn.execute(f'select max({column}) from {table}').fetchone()[0]
   239	            if top is not None and top > seq:
   240	                raise Leak(f'{table}.{column} {top} is after day {day} (seq {seq})')
   241	        late = self.conn.execute('select count(*) from evidence_sources where publication_day > ?', (day,)).fetchone()[0]
   242	        if late:
   243	            raise Leak(f'{late} sources published after {day}')
