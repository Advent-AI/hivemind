   245	    def judge(self, day, seq, changed):
   246	        """Judge the day's changed views with the frozen judge. The selection is recorded in this thread when each prompt is built; the
   247	        comparison with the request is made in the sending thread without touching the database."""
   248	        self.leakage_check(day, seq)
   249	        selected_by_view = {}
   250	        production_selection = judging.evidence_in_view
   251	        def recording_selection(conn, view_id):
   252	            result = production_selection(conn, view_id)
   253	            selected_by_view[view_id] = [piece['evidence_id'] for piece in result[0]]
   254	            return result
   255	        def watching(provider, request):
   256	            text = request['messages'][-1]['content']
   257	            shown = SHOWN_EVIDENCE.findall(text)
   258	            named = JUDGED_VIEW.search(text)
   259	            view_id = named.group(1) if named else None
   260	            if view_id not in self.views or view_id not in selected_by_view:
   261	                raise Leak(f'a request on {day} judges {view_id}, not a view this replay built a prompt for')
   262	            if shown != selected_by_view[view_id]:
   263	                raise Leak(f'{view_id} on {day}: the request shows {shown}, the selection was {selected_by_view[view_id]}')
   264	            response = self.budget.send(provider, request)
   265	            with self.budget.lock:
   266	                self.sent.append({'day': day, 'seq': seq, 'view': view_id, 'shown': shown})
   267	            return response
   268	        item = {'input_id': f'day:{day}', 'publication_day': day}
   269	        judging.evidence_in_view = recording_selection
   270	        try:
   271	            judged = judging.round_of_judgements(self.archive, self.cfg, self.conn, sorted(changed), seq, item, transport=watching)
   272	        finally:
   273	            judging.evidence_in_view = production_selection
   274	        self.conn.commit()
   275	        self.counts['judgements'] += len(judged)
   276	        return judged
