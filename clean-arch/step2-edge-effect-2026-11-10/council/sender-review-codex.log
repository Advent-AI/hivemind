   412	def evidence_in_force(conn, view_id):
   413	    """Evidence linked to the view and not replaced (history), each with its replaced predecessor when there is one and, since D202,
   414	    the piece it revises (both in force)."""
   415	    out = []
   416	    for row in conn.execute('select evidence_id from evidence_links where view_id=? order by id', (view_id,)):
   417	        evidence_id = row['evidence_id']
   418	        if is_replaced(conn, evidence_id):
   419	            continue
   420	        record = evidence(conn, evidence_id)
   421	        previous = predecessor_of(conn, evidence_id)
   422	        record['replaced'] = evidence(conn, previous) if previous else None
   423	        revised = revision_of(conn, evidence_id)
   424	        record['revises'] = evidence(conn, revised) if revised else None
   425	        record['same_as'] = [x for x in same_claim_group(conn, evidence_id) if not is_replaced(conn, x)]
   426	        out.append(record)
   427	    return out
