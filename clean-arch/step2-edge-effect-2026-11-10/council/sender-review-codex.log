   184	def library_without_relation(folder, by, revised_group):
   185	    """A copy of the draw's library with exactly one revision relation removed, stamped as its own (a labelled departure from the draw)."""
   186	    library = json.loads((STEP2 / 'library.json').read_text())
   187	    found = [(group_id, n) for group_id, group in library['groups'].items() for n, revision in enumerate(group['revises'])
   188	             if revision['by'] == by and revision['group'] == revised_group]
   189	    if len(found) != 1:
   190	        raise SystemExit(f'{len(found)} relations from {by} to group {revised_group}; exactly one is removed')
   191	    group_id, position = found[0]
   192	    removed = library['groups'][group_id]['revises'].pop(position)
   193	    folder.mkdir(parents=True)
   194	    (folder / 'library.json').write_text(json.dumps(library, ensure_ascii=False))
   195	    digests = [hashlib.sha256(Path(part).read_bytes()).hexdigest() + '  ' + part for part in TRACE.split('+')]
   196	    digests.append(hashlib.sha256((folder / 'library.json').read_bytes()).hexdigest() + '  ' + str(folder / 'library.json'))
   197	    (folder / 'inputs.sha256').write_text('\n'.join(digests) + '\n')
   198	    return {'held by group': group_id, 'removed': removed, 'revised original': library['groups'][revised_group]['original']['id'],
   199	            'revised original thesis ids': library['groups'][revised_group]['original']['thesis_ids']}
   200	
   201	
   202	def user_text(request):
   203	    return request['messages'][-1]['content']
   204	
   205	
   206	def counterfactual(output, control_folder, by, revised_group, keep_links):
   207	    output, control_folder = Path(output).resolve(), Path(control_folder).resolve()
   208	    if not json.loads((control_folder / 'control-report.json').read_text())['passed']:
   209	        raise SystemExit('the control did not pass; no counterfactual is replayed against it')
   210	    control_rounds = json.loads((control_folder / 'control-rounds.json').read_text(), object_pairs_hook=collections.OrderedDict)
   211	    control_requests = json.loads((control_folder / 'control-requests.json').read_text())
   212	    scratch = output.parent / (output.name + '-inputs')
   213	    removed = library_without_relation(scratch / 'step2', by, revised_group)
   214	    kept = {by: removed['revised original thesis ids']} if keep_links else None
   215	    rounds_seen = []
   216	    found = {}
   217	
   218	    def on_round(day, entries, error):
   219	        earlier_missing = [control_day for control_day in control_rounds if control_day < day and control_day not in rounds_seen]
   220	        rounds_seen.append(day)
   221	        expected = sorted((entry['view'], entry['sha256']) for entry in control_rounds.get(day, []))
   222	        if earlier_missing or error or round_signature(entries) != expected:
   223	            found.update(day=day, entries=entries, rounds_without_judging=earlier_missing, error=str(error) if error else None)
   224	            if not error:
   225	                raise Divergence(day)
   226	
   227	    diverged = True
   228	    try:
   229	        adapter, recorder, reference = run_replay(output, scratch / 'step2', on_round=on_round, keep_links=kept)
   230	        adapter.conn.close()
   231	        never_judged = [day for day in control_rounds if day not in rounds_seen]
   232	        if never_judged:
   233	            found.update(day=None, entries=[], rounds_without_judging=never_judged, error=None)
   234	        else:
   235	            diverged = False
   236	    except (Divergence, control_v108.ReferenceMissError):
   237	        pass
   238	    report = {'relation removed': removed, 'links kept without the relation': kept, 'diverged': diverged,
   239	              'rounds identical to the control before the first difference': [day for day in rounds_seen if day != found.get('day')]}
   240	    if diverged:
   241	        day = found['day']
   242	        control_by_view = collections.defaultdict(list)
   243	        for entry in control_rounds.get(day, []):
   244	            control_by_view[entry['view']].append(entry['sha256'])
   245	        replay_by_view = collections.defaultdict(list)
   246	        for entry in found['entries']:
   247	            replay_by_view[entry['view']].append(entry)
   248	        changed = []
   249	        for view_id in sorted(set(control_by_view) | set(replay_by_view)):
   250	            control_shas = control_by_view.get(view_id, [])
   251	            replay_entries = replay_by_view.get(view_id, [])
   252	            if sorted(control_shas) == sorted(entry['sha256'] for entry in replay_entries):
   253	                continue
   254	            first_control = control_requests[control_shas[0]] if control_shas else None
   255	            first_replay = next((entry['request'] for entry in replay_entries if entry['sha256'] not in control_shas), None)
   256	            detail = {'view': view_id, 'control requests': len(control_shas), 'counterfactual requests': len(replay_entries)}
   257	            if first_control and first_replay:
   258	                control_shown = e2e_adapter.SHOWN_EVIDENCE.findall(user_text(first_control))
   259	                replay_shown = e2e_adapter.SHOWN_EVIDENCE.findall(user_text(first_replay))
   260	                detail['evidence only in the control request'] = [e for e in control_shown if e not in replay_shown]
   261	                detail['evidence only in the counterfactual request'] = [e for e in replay_shown if e not in control_shown]
   262	                detail['system text identical'] = first_control['messages'][0] == first_replay['messages'][0]
   263	                detail['diff of the user text'] = list(difflib.unified_diff(user_text(first_control).splitlines(), user_text(first_replay).splitlines(),
   264	                                                                            'control', 'counterfactual', lineterm='', n=0))
   265	                (output / f'request-{view_id}-control.json').write_text(json.dumps(first_control, ensure_ascii=False, indent=1))
   266	                (output / f'request-{view_id}-counterfactual.json').write_text(json.dumps(first_replay, ensure_ascii=False, indent=1))
   267	            changed.append(detail)
   268	        report.update({'first differing round': day, 'control days with no judging round in the counterfactual': found['rounds_without_judging'],
   269	                       'reference miss': found['error'], 'views whose requests differ in that round': changed,
   270	                       'views with identical requests in that round': sorted(v for v in control_by_view if sorted(control_by_view[v]) ==
   271	                                                                              sorted(e['sha256'] for e in replay_by_view.get(v, [])))})
   272	    output.mkdir(parents=True, exist_ok=True)
   273	    (output / 'counterfactual-report.json').write_text(json.dumps(report, ensure_ascii=False, indent=1))
   274	    print(json.dumps({name: value for name, value in report.items() if name != 'views whose requests differ in that round'}, ensure_ascii=False, indent=1))
   275	    for detail in report.get('views whose requests differ in that round', []):
   276	        print(json.dumps({name: value for name, value in detail.items() if name != 'diff of the user text'}, ensure_ascii=False))
   277	        print('\n'.join(detail.get('diff of the user text', [])))
   278	
   279	
   280	if __name__ == '__main__':
   281	    parser = argparse.ArgumentParser()
   282	    parser.add_argument('mode', choices=['control', 'counterfactual'])
   283	    parser.add_argument('output')
   284	    parser.add_argument('control_folder', nargs='?')
   285	    parser.add_argument('--by'); parser.add_argument('--revised-group'); parser.add_argument('--keep-links', action='store_true')
   286	    args = parser.parse_args()
   287	    if args.mode == 'control':
   288	        control(args.output)
   289	    else:
   290	        if not (args.control_folder and args.by and args.revised_group):
   291	            parser.error('counterfactual needs the control folder, --by and --revised-group')
   292	        counterfactual(args.output, args.control_folder, args.by, args.revised_group, args.keep_links)
     1	#!/usr/bin/env python3
     2	"""How much of what the frozen judge read in the saved D392 clean draw 1 reached a question only because a Step 2 revision relation
     3	carried it there? A count over the saved ledger, at no cost.
     4	
     5	The adapter gives a record that revises an older one every question link the older one holds. A link is counted here as carried by a
     6	relation when the record's own Step 1 links and Step 3's later links do not include that question. For each such link the count gives
     7	the relations that carried it (one, or several), the two source readers' label for each relation (reports/step2-revision-census-2026-11-09,
     8	a diagnostic reading, not a signed reference), the judge requests that showed the record under that question, and the judgements that
     9	cited it there.
    10	
    11	Usage: inheritance_census.py <new scratch folder> <output json>"""
    12	import collections, contextlib, json, sqlite3, sys
    13	from pathlib import Path
    14	
    15	HERE = Path(__file__).resolve().parent
    16	sys.dont_write_bytecode = True
    17	sys.path[:0] = [str(HERE)]
    18	import edge_replay  # noqa: E402
    19	
    20	LABELS = edge_replay.ROOT / 'reports/step2-revision-census-2026-11-09/comparison-after-challenge.json'
    21	
    22	
    23	def main(scratch, output_path):
    24	    adapter, _, _ = edge_replay.run_replay(Path(scratch).resolve(), edge_replay.STEP2)
    25	    evidence_of = dict(adapter.evidence_of)
    26	    adapter.conn.close()
    27	    record_of = {evidence_id: record_id for record_id, evidence_id in evidence_of.items()}
    28	    by_article, library = edge_replay.e2e_adapter.load_draw(edge_replay.TRACE, edge_replay.STEP2)
    29	    records = {record['id']: record for article in by_article.values() for record in article}
    30	    later_views = collections.defaultdict(set)
    31	    for entry in library['later_log']:
    32	        for record_id in entry['linked']:
    33	            later_views[record_id].add(entry['thesis'])
    34	    relations = [(revision['by'], revision['group']) for group in library['groups'].values() for revision in group['revises']]
    35	    label_of = {(edge['incoming'], edge['group']): edge['after_challenge'] for edge in json.loads(LABELS.read_text())['saved_edges']}
    36	    unlabelled = [relation for relation in relations if relation not in label_of]
    37	    if unlabelled:
    38	        raise SystemExit(f'relations with no reader label: {unlabelled}')
    39	
    40	    saved = edge_replay.SAVED
    41	    with contextlib.closing(sqlite3.connect(f"file:{saved / 'views.sqlite'}?mode=ro", uri=True)) as conn:
    42	        links = conn.execute('select id, evidence_id, view_id, seq from evidence_links order by id').fetchall()
    43	        judgements = conn.execute('select view_id, publication_day, cited_evidence_json, pushes_json from judgements').fetchall()
    44	    link_id = {(evidence_id, view_id): row_id for row_id, evidence_id, view_id, _ in links}
    45	    shown_under = collections.Counter()
    46	    requests = json.loads((saved / 'judge-requests.json').read_text())
    47	    for request in requests:
    48	        for evidence_id in request['shown']:
    49	            shown_under[evidence_id, request['view']] += 1
    50	    cited_under, pushed_under = collections.Counter(), collections.defaultdict(collections.Counter)
    51	    for view_id, _, cited_json, pushes_json in judgements:
    52	        for evidence_id in json.loads(cited_json or '[]'):
    53	            cited_under[evidence_id, view_id] += 1
    54	        for push in json.loads(pushes_json or '[]'):
    55	            pushed_under[push['evidence_id'], view_id][push['push']] += 1
    56	
    57	    carried = []
    58	    for row_id, evidence_id, view_id, seq in links:
    59	        record_id = record_of[evidence_id]
    60	        if view_id in records[record_id]['thesis_ids'] or view_id in later_views[record_id]:
    61	            continue
    62	        carriers = []
    63	        for by, group in relations:
    64	            old = evidence_of.get(library['groups'][group]['original']['id'])
    65	            if by == record_id and old and link_id.get((old, view_id), row_id) < row_id:
    66	                carriers.append({'revised group': group, 'old evidence': old, 'readers': label_of[by, group]})
    67	        if not carriers:
    68	            raise SystemExit(f'link {evidence_id} -> {view_id} has no Step 1 link, no later link and no carrying relation')
    69	        carried.append({'record': record_id, 'evidence': evidence_id, 'question': view_id, 'seq': seq, 'carried by': carriers,
    70	                        'summary': records[record_id]['summary'], 'requests that showed it': shown_under[evidence_id, view_id],
    71	                        'judgements that cited it': cited_under[evidence_id, view_id], 'pushes given': dict(pushed_under[evidence_id, view_id])})
    72	
    73	    def kind(link):
    74	        readers = {carrier['readers'] for carrier in link['carried by']}
    75	        if readers == {'different'}:
    76	            return 'only by relations the readers call different statements'
    77	        if 'different' in readers:
    78	            return 'by a relation called different and by another relation'
    79	        return 'only by relations the readers call ' + ' or '.join(sorted(readers))
    80	
    81	    by_kind = collections.defaultdict(lambda: collections.Counter())
    82	    for link in carried:
    83	        counts = by_kind[kind(link)]
    84	        counts['links'] += 1
    85	        counts['requests that showed it'] += link['requests that showed it']
    86	        counts['judgements that cited it'] += link['judgements that cited it']
    87	    requests_touched = sum(1 for request in requests if any((evidence_id, request['view']) in {(l['evidence'], l['question']) for l in carried}
    88	                                                            for evidence_id in request['shown']))
    89	    # The second way a relation reaches the judge: under the new record the request prints one line naming the piece it is read as a
    90	    # later version of. Only the relation written last is printed (store.revision_of).
    91	    group_of_original = {evidence_of[group['original']['id']]: group_id for group_id, group in library['groups'].items()
    92	                         if group['original']['id'] in evidence_of}
    93	    with contextlib.closing(sqlite3.connect(f"file:{saved / 'views.sqlite'}?mode=ro", uri=True)) as conn:
    94	        revision_rows = conn.execute('select id, old_evidence_id, new_evidence_id from revisions order by id').fetchall()
    95	    printed = {new: old for _, old, new in revision_rows}                      # the last row per new record wins
    96	    shown_anywhere = collections.Counter(evidence_id for request in requests for evidence_id in request['shown'])
    97	    notes = collections.defaultdict(collections.Counter)
    98	    for new, old in printed.items():
    99	        readers = label_of[record_of[new], group_of_original[old]]
   100	        notes[readers]['records carrying the note'] += 1
   101	        notes[readers]['requests that printed the note'] += shown_anywhere[new]
   102	    summary = {'links in the ledger': len(links), 'links carried only by a revision relation': len(carried),
   103	               'records with such a link': len({link['record'] for link in carried}),
   104	               'questions with such a link': sorted({link['question'] for link in carried}),
   105	               'judge requests in the run': len(requests), 'judge requests showing at least one such link': requests_touched,
