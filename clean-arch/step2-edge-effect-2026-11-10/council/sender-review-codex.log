    61	
    62	class RecordingTransport:
    63	    """Passes each request to the reference archive transport and records it with the judging round it belongs to."""
    64	
    65	    def __init__(self, reference):
    66	        self.reference = reference
    67	        self.round = None                 # (day, seq) of the judging round in progress
    68	        self.requests = []                # one entry per request, answered or not
    69	
    70	    def __call__(self, provider, request):
    71	        canonical = control_v108.canonical_text(request)
    72	        text = request['messages'][-1]['content']
    73	        named = e2e_adapter.JUDGED_VIEW.search(text)
    74	        entry = {'day': self.round[0], 'seq': self.round[1], 'view': named.group(1) if named else None,
    75	                 'sha256': control_v108.text_sha256(canonical), 'answered': False, 'request': request}
    76	        self.requests.append(entry)       # list.append is atomic; the round's requests are sent from a thread pool
    77	        response = self.reference(provider, request)
    78	        entry['answered'] = True
    79	        return response
    80	
    81	    def of_round(self, day):
    82	        return [entry for entry in self.requests if entry['day'] == day]
    83	
    84	
    85	def round_signature(entries):
    86	    """The requests of one round as a sorted list of (view, request sha256): the retry after a refused answer is its own request."""
    87	    return sorted((entry['view'], entry['sha256']) for entry in entries)
    88	
    89	
    90	def run_replay(output, step2_folder, *, on_round=None, keep_links=None):
    91	    """Replay the draw into `output` with every request answered from the saved archive. `on_round(day, entries, error)` is called after
    92	    each judging round (error is the ReferenceMissError that ended it, or None)."""
    93	    refuse_live_calls()
    94	    reference = control_v108.ReferenceArchiveTransport(SAVED / 'archive.sqlite')
    95	    recorder = RecordingTransport(reference)
    96	    production_judge = e2e_adapter.Adapter.judge
    97	    production_article = e2e_adapter.Adapter.article
    98	
    99	    def judge(self, day, seq, changed):
   100	        recorder.round = (day, seq)
   101	        error = None
   102	        try:
   103	            return production_judge(self, day, seq, changed)
   104	        except control_v108.ReferenceMissError as miss:
   105	            error = miss
   106	            raise
   107	        finally:
   108	            if on_round:
   109	                on_round(day, recorder.of_round(day), error)
   110	
   111	    def article(self, k, records, library, revisions_by_record, later_entries, changed):
   112	        production_article(self, k, records, library, revisions_by_record, later_entries, changed)
   113	        for record_id, view_ids in (keep_links or {}).items():
   114	            if any(record['id'] == record_id for record in records):
   115	                for view_id in view_ids:
   116	                    self._link(self.evidence_of.get(record_id), view_id, k, changed)
   117	                    self.counts['links kept without their relation'] += 1
   118	
   119	    e2e_adapter.Adapter.judge, e2e_adapter.Adapter.article = judge, article
   120	    try:
   121	        finished = e2e_adapter.replay(TRACE, step2_folder, output, transport=recorder, cap_usd=3.0)
   122	    finally:
   123	        e2e_adapter.Adapter.judge, e2e_adapter.Adapter.article = production_judge, production_article
   124	    return finished, recorder, reference
   125	
   126	
   127	def ledger_rows(path, table):
   128	    with contextlib.closing(sqlite3.connect(f'file:{path}?mode=ro', uri=True)) as conn:
   129	        columns = [row[1] for row in conn.execute(f'pragma table_info({table})')]
   130	        kept = [column for column in columns if column not in ARCHIVE_ROW_COLUMNS.get(table, ())]
   131	        return kept, conn.execute(f"select {', '.join(kept)} from {table} order by rowid").fetchall()
   132	
   133	
   134	def archive_answers(path):
   135	    """Every archived call as (request sha256 without its refusal mark, refused or not, answer): the multiset a replay must reproduce."""
   136	    with contextlib.closing(sqlite3.connect(f'file:{path}?mode=ro', uri=True)) as conn:
   137	        rows = conn.execute('select request_sha256, answer_json from model_calls').fetchall()
   138	    return collections.Counter((REFUSED.sub('', sha), bool(REFUSED.search(sha)), answer) for sha, answer in rows)
   139	
   140	
   141	def control(output):
   142	    output = Path(output).resolve()
   143	    adapter, recorder, reference = run_replay(output, STEP2)
   144	    adapter.conn.close()
   145	    failures = []
   146	    if reference.misses:
   147	        failures.append(f'{len(reference.misses)} requests had no saved answer')
   148	    if reference.unused_rows():
   149	        failures.append(f'saved archive rows never asked for: {reference.unused_rows()}')
   150	    compared = {}
   151	    for table in LEDGER_TABLES:
   152	        saved_columns, saved_rows = ledger_rows(SAVED / 'views.sqlite', table)
   153	        replay_columns, replay_rows = ledger_rows(output / 'views.sqlite', table)
   154	        compared[table] = len(saved_rows)
   155	        if saved_columns != replay_columns or saved_rows != replay_rows:
   156	            differing = next((n for n, pair in enumerate(zip(saved_rows, replay_rows)) if pair[0] != pair[1]), min(len(saved_rows), len(replay_rows)))
   157	            failures.append(f'ledger table {table}: {len(saved_rows)} saved rows, {len(replay_rows)} replayed, first difference at row {differing}')
   158	    saved_sent = json.loads((SAVED / 'judge-requests.json').read_text())
   159	    key = lambda entry: (entry['day'], entry['seq'], entry['view'], tuple(entry['shown']))
   160	    if collections.Counter(map(key, saved_sent)) != collections.Counter(map(key, adapter.sent)):
   161	        failures.append('the judge requests (day, seq, view, evidence shown) differ from the saved judge-requests.json')
   162	    if archive_answers(SAVED / 'archive.sqlite') != archive_answers(output / 'archive.sqlite'):
   163	        failures.append('the replayed archive does not hold the saved requests and answers')
   164	    saved_counts = json.loads((SAVED / 'adapter-counts.json').read_text())
   165	    replay_counts = json.loads((output / 'adapter-counts.json').read_text())
   166	    if saved_counts != replay_counts:
   167	        failures.append(f'adapter counts differ: saved {saved_counts}, replayed {replay_counts}')
   168	    rounds = collections.OrderedDict()
   169	    for entry in recorder.requests:
   170	        rounds.setdefault(entry['day'], []).append({name: entry[name] for name in ('day', 'seq', 'view', 'sha256')})
   171	    (output / 'control-rounds.json').write_text(json.dumps(rounds, indent=1))
   172	    requests_by_sha = {entry['sha256']: entry['request'] for entry in recorder.requests}
   173	    (output / 'control-requests.json').write_text(json.dumps(requests_by_sha, ensure_ascii=False))
   174	    report = {'passed': not failures, 'failures': failures, 'requests answered from the saved archive': sum(reference.matched.values()),
   175	              'saved archive rows': reference.reference_rows, 'ledger rows compared, by table': compared,
   176	              'ledger columns not compared': {table: sorted(columns) for table, columns in ARCHIVE_ROW_COLUMNS.items()},
   177	              'judging rounds': len(rounds), 'adapter counts': replay_counts}
   178	    (output / 'control-report.json').write_text(json.dumps(report, indent=1))
   179	    print(json.dumps(report, indent=1))
   180	    if failures:
   181	        raise SystemExit(1)
   182	
