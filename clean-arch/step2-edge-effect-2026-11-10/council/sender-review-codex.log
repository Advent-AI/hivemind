    38	REFUSED = re.compile(r':refused:[0-9a-f]+$')
    39	# Columns the replay cannot reproduce by construction: an archive row number is given in the order answers return from 32 threads.
    40	ARCHIVE_ROW_COLUMNS = {'judgements': {'call_id'}}
    41	LEDGER_TABLES = ('views', 'rungs', 'view_keys', 'view_switches', 'judgements', 'evidence', 'evidence_sources', 'evidence_links',
    42	                 'replacements', 'revisions', 'same_claims', 'dependencies', 'dependency_resolutions', 'successions', 'handovers',
