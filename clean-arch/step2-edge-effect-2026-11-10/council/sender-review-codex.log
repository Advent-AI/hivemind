   126	def openai_transport(provider, request, timeout=180, max_attempts=3):   # the default preserves the production retry behavior
   127	    url, _ = ENDPOINTS[provider]
   128	    body = json.dumps(request).encode('utf-8')
   129	    headers = {'Authorization': f'Bearer {_key(provider)}', 'Content-Type': 'application/json'}
   130	    last = None
   131	    last_http = None
   132	    if isinstance(max_attempts, bool) or not isinstance(max_attempts, int) or max_attempts < 1:
   133	        raise ValueError('max_attempts must be a positive integer')
   134	    for attempt in range(max_attempts):
   135	        try:
   136	            with urllib.request.urlopen(urllib.request.Request(url, data=body, headers=headers, method='POST'), timeout=timeout) as response:
   137	                raw_bytes = response.read()
   138	                try:
   139	                    raw = raw_bytes.decode('utf-8')
   140	                except UnicodeDecodeError:
   141	                    if max_attempts != 1:
   142	                        raise
   143	                    failure = TransportError('invalid UTF-8 HTTP response')
   144	                    failure.response_body = raw_bytes.decode('utf-8', 'replace')
   145	                    failure.response_body_base64 = base64.b64encode(raw_bytes).decode('ascii')
   146	                    failure.http_status = response.status
   147	                    raise failure
   148	                try:
   149	                    return json.loads(raw)
   150	                except json.JSONDecodeError:
   151	                    if max_attempts != 1:
   152	                        raise
   153	                    failure = TransportError('malformed HTTP response')
   154	                    failure.response_body = raw
   155	                    failure.http_status = response.status
   156	                    raise failure
   157	        except urllib.error.HTTPError as error:
   158	            body_bytes = error.read()
   159	            body_text = body_bytes.decode('utf-8', 'replace' if max_attempts == 1 else 'ignore')
   160	            last_http = (error.code, body_text, base64.b64encode(body_bytes).decode('ascii'))
   161	            last = f'HTTP {error.code}: {body_text[:600]}'
   162	            if error.code in (400, 401, 403, 404):
   163	                failure = TransportError(last)
   164	                failure.response_body = body_text
   165	                failure.response_body_base64 = last_http[2]
   166	                failure.http_status = error.code
   167	                raise failure
   168	        except (urllib.error.URLError, TimeoutError, ConnectionError, OSError, http.client.HTTPException) as error:   # a dropped or truncated response is retried like a network error
   169	            last = repr(error)[:200]
   170	            last_http = None   # the final failure describes the last attempt only
   171	        if max_attempts == 3 or attempt + 1 < max_attempts:
   172	            time.sleep(5 * (attempt + 1))
   173	    failure = TransportError(last or 'no answer')
   174	    if last_http:
   175	        failure.http_status, failure.response_body, failure.response_body_base64 = last_http
