   279	def replay(trace_path, step2_folder, output_folder, *, transport=None, cap_usd=3.0, q23=None, mapping=None):
   280	    output = Path(output_folder).resolve()
   281	    if transport is None and not any(root.resolve() in output.parents for root in OUTPUT_ROOTS):
   282	        raise SystemExit(f'a live replay writes only under {OUTPUT_ROOTS}')
   283	    output.mkdir(parents=True, exist_ok=False)
   284	    by_article, library = load_draw(trace_path, step2_folder)
   285	    days_of, opened, failed = trace_articles(trace_path)
   286	    if q23 is not None and q23 not in {t['id'] for t in q23_candidates(opened)}:
   287	        raise SystemExit(f'{q23} is not a clean-opened thesis matching the scorer rule')
   288	    opened_ids = {thesis_id for theses in opened.values() for thesis_id in theses}
   289	    for clean_id, views in (mapping or {}).items():
   290	        if clean_id not in opened_ids:
   291	            raise SystemExit(f'{clean_id} is not a thesis this run opened')
   292	        for view_id in ([views] if isinstance(views, str) else views):
   293	            if view_id not in SEED_IDS | {Q23_VIEW}:
   294	                raise SystemExit(f'{view_id} is not a ruler question view')
   295	    revisions_by_record = collections.defaultdict(list)
   296	    for group in library['groups'].values():
   297	        for revision in group['revises']:
   298	            revisions_by_record[revision['by']].append(revision['group'])
   299	    later_by_article = collections.defaultdict(list)
   300	    for entry in library['later_log']:
   301	        later_by_article[entry['article']].append(entry)
   302	    days = collections.OrderedDict()
   303	    for k in sorted(days_of):
   304	        days.setdefault(days_of[k], []).append(k)
   305	    if list(days) != sorted(days):
   306	        raise SystemExit('the Step 1 articles are not in day order')
   307	    adapter = Adapter(output / 'views.sqlite', output / 'archive.sqlite', transport=transport, cap_usd=cap_usd, q23=q23, mapping=mapping)
   308	    adapter.counts['articles not completed by Step 1'] = len(failed)
   309	    for day, articles in days.items():
   310	        changed = set()
   311	        for k in articles:
   312	            for thesis_id, thesis in opened.get(k, {}).items():
   313	                if thesis_id == q23:
   314	                    adapter.open_q23(thesis, k, by_article[k][0]['input_id'] if k in by_article else f'article:{k}', day)
   315	            adapter.article(k, by_article.get(k, []), library, revisions_by_record, later_by_article.get(k, []), changed)
   316	        adapter.conn.commit()
   317	        if changed:
   318	            adapter.judge(day, max(articles), changed)
   319	    adapter.counts['judging usd (from tokens)'] = round(adapter.budget.spent_usd, 4)
   320	    (output / 'adapter-counts.json').write_text(json.dumps(adapter.counts, indent=1))
   321	    (output / 'judge-requests.json').write_text(json.dumps(adapter.sent, indent=1))
   322	    return adapter
