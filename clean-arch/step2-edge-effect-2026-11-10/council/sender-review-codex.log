    47	class Divergence(Exception):
    48	    """The first judging round whose requests differ from the control's."""
    49	
    50	
    51	class LiveCallRefused(BaseException):
    52	    """A credential or the production transport was reached during an offline replay."""
    53	
    54	
    55	def refuse_live_calls():
    56	    def refusal(*arguments, **keywords):
    57	        raise LiveCallRefused('an offline replay reached the credential reader or the production transport')
    58	    model._key = refusal
    59	    model.openai_transport = refusal
