__pycache__/
*.pyc
.DS_Store

# POC corpus: fetched material and logs stay out of Git
poc/corpus/raw/
poc/corpus/logs/
poc/corpus/*.sqlite
poc/data/

# Docker build inputs (wheels downloaded on the host for Dockerfile.mcp)
build/
node_modules/

# Generated UI builds and schema validators
poc/ui/dist/
poc/ui/src/model/validate.generated.js

# Generated per-item trace pages (scripts/trace_items.py rebuilds them from the sealed data and the archive)
poc/reports/*/trace/
poc/reports/*/trace-*/

# Call archives of the recall oracles (6-10 MB each): kept on disk, listed in docs/research/2026-10-25-english/data-manifest.md
poc/reports/2026-10-25-recall-oracle*/archive.sqlite

# Call archive of the evidence-in-view A/B (832 KB): kept on disk, listed in docs/research/2026-10-25-english/data-manifest.md
docs/research/2026-10-27-evidence-in-view/ab-archive.sqlite

# Step 3/4 gold measurements (main checkout, 135 MB): call archives and prepared contexts stay on disk, listed in the data manifest
poc/reports/2026-10-27-stage34-gold/*/archive.sqlite
poc/reports/2026-10-27-stage34-gold/*/prepared.json

# 2026-10-28 extraction-quality research: scratch model archives of the arms (results stay as JSON/log/markdown)
docs/research/2026-10-28-extraction-quality/results/*.sqlite
docs/research/2026-10-28-extraction-quality/results/aborted-first-attempt/
docs/research/2026-10-28-extraction-quality/__pycache__/

# Extraction research from 2026-10-28 on (retention audit, analyst standard, ledger standard, noise, reference context): model
# answer stores and other SQLite files, run locks and pid files, the large derived sifts and the blind readers' transcripts stay
# on disk, listed in docs/research/2026-10-25-english/data-manifest.md; scripts, gold, verdicts, packets, results and logs are
# in Git (2026-11-01: 85 pid files and three 3–5 MB Jev-pass databases had slipped into Git from the 10-30 and 10-31 folders)
docs/research/**/*.sqlite
docs/research/**/*.pid
docs/research/**/*.lock
docs/research/2026-10-29-analyst-standard/**/sifted.json
docs/research/2026-10-29-analyst-standard/structure*.json
docs/research/2026-10-28-retention-audit/ledger.json
docs/research/2026-10-29-ledger-standard/final-2026-10-30/verdicts/*.log
docs/research/**/__pycache__/
