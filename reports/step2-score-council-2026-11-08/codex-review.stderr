    64	class Archive:
    65	    """Shared by the extraction worker threads: one connection, every access under a lock."""
    66	
    67	    def __init__(self, path):
    68	        os.makedirs(os.path.dirname(os.path.abspath(path)), exist_ok=True)
    69	        self.conn = sqlite3.connect(path, check_same_thread=False)
    70	        self.conn.executescript(SCHEMA_SQL)
    71	        import threading
    72	        self.lock = threading.Lock()
    73	
    74	    def lookup(self, sha):
    75	        with self.lock:
    76	            return self.conn.execute('select call_id, answer_json, prompt_chars, input_tokens, output_tokens from model_calls where request_sha256=?', (sha,)).fetchone()
    77	
    78	    def record(self, **fields):
    79	        """One row per distinct request; a second identical request recorded at the same moment (two threads, or a
    80	        failed answer repeated within the same second) keeps the first row's id instead of failing."""
    81	        columns = list(fields)
    82	        with self.lock:
    83	            cursor = self.conn.execute(f'insert or ignore into model_calls ({",".join(columns)}) values ({",".join("?" * len(columns))})',
    84	                                       [fields[c] for c in columns])
    85	            self.conn.commit()
    86	            if cursor.rowcount == 0:
    87	                return self.conn.execute('select call_id from model_calls where request_sha256=?', (fields['request_sha256'],)).fetchone()[0]
    88	            return cursor.lastrowid
    89	
    90	    def retire(self, call_id):
   235	    if kind == 'null':
