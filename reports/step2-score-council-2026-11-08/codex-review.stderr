   240	def request_identity(request):
   241	    """The exact serialized request and its archive key, shared by callers and validation."""
   242	    encoded = json.dumps(request, sort_keys=True, ensure_ascii=False)
   243	    return encoded, hashlib.sha256(encoded.encode('utf-8')).hexdigest()
