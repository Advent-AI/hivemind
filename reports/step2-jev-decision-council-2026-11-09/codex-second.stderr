\n   \"gnews:49351bd6de4706de524baf5f\"\n  ]\n },\n {\n  \"id\": \"B06\",\n  \"scope\": \"fresh\",\n  \"incoming\": \"30:e1\",\n  \"candidate\": \"20:ev-1\",\n  \"q\": \"q0\",\n  \"request_sha256\": \"6074e6937466b43bb2e3416a456cfb48218991939ed1acd0972af98af7daa86f\",\n  \"source_ids\": [\n   \"gnews:a68f4be941102b46a8fbce0f\",\n   \"gnews:243636e860a787a59c4d0c7a\"\n  ]\n },\n {\n  \"id\": \"B07\",\n  \"scope\": \"d2\",\n  \"incoming\": \"62:e8\",\n  \"candidate\": \"59:e2\",\n  \"q\": \"q0\",\n  \"request_sha256\": \"31df69288a34890a4fa65f7a9c5e93a5109c3ae040401cf57bd24312cec976f4\",\n  \"source_ids\": [\n   \"gnews:4d1b1ca014068fb532f116b3\",\n   \"gnews:3df0bbc8aff2c1d008bc0a32\"\n  ]\n },\n {\n  \"id\": \"B08\",\n  \"scope\": \"fresh\",\n  \"incoming\": \"40:e1\",\n  \"candidate\": \"31:e1\",\n  \"q\": \"q1\",\n  \"request_sha256\": \"9d1615a63d6b053f931206b270c79024018a8b6937a6f9b77388817d819bdaf6\",\n  \"source_ids\": [\n   \"gnews:fd9c8f0b41cb038669ea3481\",\n   \"gnews:a6d67d7d256959be5aa43b63\"\n  ]\n },\n {\n  \"id\": \"B09\",\n  \"scope\": \"d1\",\n  \"incoming\": \"105:e3\",\n  \"candidate\": \"49:ev-kyber-delay\",\n  \"q\": \"q0\",\n  \"request_sha256\": \"1a38067701d606f7f24a4dbc24a56eacf37d0697b1958ba86bf1d24b09831a58\",\n  \"source_ids\": [\n   \"gnews:57de52b4f33b0c903d256f9e\",\n   \"gnews:552f8c2bdfd080555d592587\"\n  ]\n },\n {\n  \"id\": \"B10\",\n  \"scope\": \"fresh\",\n  \"incoming\": \"22:ev-11\",\n  \"candidate\": \"13:e4\",\n  \"q\": \"q0\",\n  \"request_sha256\": \"70056b2c2a30df1f6fffa57a429331a6bd4b8525c8e86dbe05a7a7363a5e7531\",\n  \"source_ids\": [\n   \"gnews:478c25b436f87e8f421d54ed\",\n   \"gnews:8653711909bcf63268b8735b\"\n  ]\n },\n {\n  \"id\": \"B11\",\n  \"scope\": \"d2\",\n  \"incoming\": \"12:ev1\",\n  \"candidate\": \"1:E1\",\n  \"q\": \"q0\",\n  \"request_sha256\": \"5c097bb8796153baf29de9c6df3ba984a5d9d5b4e5125aca58ba9e107e98d45e\",\n  \"source_ids\": [\n   \"gnews:cdd5ccd6fd57b79e703bfb7d\",\n   \"nvblog:nvidia-unlocks-ai-compute-at-scale-capital-partners-to-power-ai-infrastructure-buildout\"\n  ]\n },\n {\n  \"id\": \"B12\",\n  \"scope\": \"fresh\",\n  \"incoming\": \"13:e11\",\n  \"candidate\": \"6:e1\",\n  \"q\": \"q1\",\n  \"request_sha256\": \"5b198e62f41bc414cee2c1e259abfd77dc3a8ef32e5590ac182c8447755d3f65\",\n  \"source_ids\": [\n   \"gnews:8653711909bcf63268b8735b\",\n   \"gnews:161105ba661985cafcb1bea9\"\n  ]\n }\n]\n{\"sequence\": 0, \"case\": \"R05\", \"arm\": \"deepseek_single\", \"draw\": 1, \"status\": \"may_have_been_sent\", \"request_sha256\": \"2a5a1a10b585e68c1824b7da2eead46b45efc1747102143a44578eba84c7ee62\", \"reserved_usd\": 0.0087564}\n{\"sequence\": 1, \"case\": \"B05\", \"arm\": \"jev_full\", \"draw\": 1, \"status\": \"may_have_been_sent\", \"request_sha256\": \"8a47253e45e41121223f7d5ffe9da68e56adb5d273c8c10fd23b50d48b448a47\", \"reserved_usd\": 0.001576512}\n{\"sequence\": 2, \"case\": \"P01\", \"arm\": \"jev_full\", \"draw\": 1, \"status\": \"may_have_been_sent\", \"request_sha256\": \"a343a727e25151d0618a9daaa55ad2821bc576feb5c7497ccb45e1f59ae4fff0\", \"reserved_usd\": 0.001546608}\n{\"sequence\": 3, \"case\": \"H01\", \"arm\": \"jev_full\", \"draw\": 1, \"status\": \"may_have_been_sent\", \"request_sha256\": \"b400808153d6f93ac510efb2a676114016ecb1f1bd1b82c3e0571de3cd171841\", \"reserved_usd\": 0.00157374}\n{\"sequence\": 4, \"case\": \"P01\", \"arm\": \"deepseek_single\", \"draw\": 2, \"status\": \"may_have_been_sent\", \"request_sha256\": \"a151de8ec280b806c998f3e069622629a144719280f297e920e1c44c36421330\", \"reserved_usd\": 0.0081084}\n{\"sequence\": 5, \"case\": \"B10\", \"arm\": \"jev_single\", \"draw\": 2, \"status\": \"may_have_been_sent\", \"request_sha256\": \"325519a98e94881330df59235e1336c3db3d30fac5148760b133f6056c51d0da\", \"reserved_usd\": 0.0003381}\n{\"sequence\": 6, \"case\": \"B01\", \"arm\": \"jev_full\", \"draw\": 1, \"status\": \"may_have_been_sent\", \"request_sha256\": \"61792668d55e2ae2315fa5a3ed1f77056423fe72dd7d8040d5afa7c3c510eb2c\", \"reserved_usd\": 0.001572648}\n{\"sequence\": 7, \"case\": \"P01\", \"arm\": \"deepseek_single\", \"draw\": 0, \"status\": \"may_have_been_sent\", \"request_sha256\": \"a151de8ec280b806c998f3e069622629a144719280f297e920e1c44c36421330\", \"reserved_usd\": 0.0081084}\n{\"case\": \"B01\", \"arm\": \"jev_full\", \"draw\": 1, \"status\": \"complete\", \"result\": {\"answers\": {\"q0\": {\"choice\": \"same_statement\", \"confidence\": 0.31, \"probabilities\": {\"different\": 0.23, \"same_statement\": 0.54, \"supersedes\": 0.23}}, \"q1\": {\"choice\": \"different\", \"confidence\": 1.0, \"probabilities\": {\"different\": 1.0, \"same_statement\": 0.0, \"supersedes\": 0.0}}, \"q2\": {\"choice\": \"different\", \"confidence\": 1.0, \"probabilities\": {\"different\": 1.0, \"same_statement\": 0.0, \"supersedes\": 0.0}}, \"q3\": {\"choice\": \"different\", \"confidence\": 1.0, \"probabilities\": {\"different\": 1.0, \"same_statement\": 0.0, \"supersedes\": 0.0}}, \"q4\": {\"choice\": \"different\", \"confidence\": 1.0, \"probabilities\": {\"different\": 1.0, \"same_statement\": 0.0, \"supersedes\": 0.0}}, \"q5\": {\"choice\": \"different\", \"confidence\": 1.0, \"probabilities\": {\"different[\n {\n  \"id\": \"B01\",\n  \"incoming_record\": {\n   \"summary\": \"Broadcom's custom chips are increasingly being used by companies such as Meta, Google and OpenAI, and Broadcom recently raised its forecast for AI chip revenue to about $115 billion in the fiscal year ending October 2027, up from a prior forecast of over $100 billion, and expects that to roughly double to $230 billion in fiscal 2028.\",\n   \"passages\": [\n    \"Broadcom's custom chips are increasingly being used by companies such as Meta, Google, and OpenAI. The company recently announced raising the forecast for its AI chip revenue to about $115 billion in the fiscal year ending October 2027, up from a prior forecast of over $100 billion. It also expects this to double to roughly $230 billion in fiscal 2028.\"\n   ],\n   \"original_party\": \"Broadcom\",\n   \"statement_date\": \"recently\"\n  },\n  \"incoming_source\": {\n   \"id\": \"gnews:c698c3cd5183f58ca14f2125\",\n   \"title\": \"Nvidia’s Hugging Face Deal Is a Hedge against Broadcom’s Custom Silicon Threat\",\n   \"publisher\": \"finance.yahoo.com\",\n   \"publication_date\": \"2026-09-06\",\n   \"source_uri\": \"https://finance.yahoo.com/technology/ai/articles/nvidia-hugging-face-deal-hedge-105111039.html","exit_code":0,"status":"completed"}}
