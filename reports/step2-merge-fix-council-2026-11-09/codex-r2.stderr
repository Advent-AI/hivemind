    33	            packet.append({'id': mid, 'earlier': full(items[original]), 'later': full(items[incoming])})
    34	        (run / f'merge-packet-{start // 26 + 1}.json').write_text(json.dumps(packet, ensure_ascii=False, indent=1))
    35	    (run / 'merge-key.json').write_text(json.dumps(key, indent=1))
    36	    store = library.Library()
