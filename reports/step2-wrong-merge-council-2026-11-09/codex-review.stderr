actual","links":[]},{"item":"14:e2","matter":"gnews:954c0e42ee45f4cc13e3132e#1","verdict":null,"row":null,"links":[]},{"item":"14:e3","matter":"gnews:954c0e42ee45f4cc13e3132e#2","verdict":null,"row":null,"links":[{"thesis":"clean-1","judgement":"right","why":"A sustained memory shortage can affect the cost and terms of Nvidia's memory procurement commitments."}]},{"item":"14:e4","matter":null,"verdict":"noise","row":"§5.3 other companies' actions and figures without a demonstrated path to a Nvidia question","links":[{"thesis":"clean-1","judgement":"wrong","why":"Micron's overall revenue growth estimates do not establish Nvidia's supplier commitments."}]},{"item":"14:e5","matter":null,"verdict":"noise","row":"§5.3 journalist's background and framing","links":[{"thesis":"clean-1","judgement":"wrong","why":"The generic description of tight memory supply does not establish the amount of Nvidia's commitments."}]},{"item":"14:e6","matter":"gnews:954c0e42ee45f4cc13e3132e#3","verdict":null,"row":null,"links":[]},{"item":"14:e7","matter":"gnews:954c0e42ee45f4cc13e3132e#3","verdict":null,"row":null,"links":[]}],"matters":[{"matter":"gnews:954c0e42ee45f4cc13e3132e#1","status":"kept","item":"14:e2","note":""},{"matter":"gnews:954c0e42ee45f4cc13e3132e#2","status":"kept","item":"14:e3","note":""},{"matter":"gnews:954c0e42ee45f4cc13e3132e#3","status":"kept","item":"14:e6","note":"The contracted-power increase is separately recorded in 14:e7."}],"theses":[]},{"article":15,"items":[{"item":"15:e1","matter":"gnews:a88be8fcf16633fb32dd5c3b#1","verdict":null,"row":null,"links":[]}],"matters":[{"matter":"gnews:a88be8fcf16633fb32dd5c3b#1","status":"kept","item":"15:e1","note":""}],"theses":[]},{"article":16,"items":[],"matters":[],"theses":[]},{"article":17,"items":[],"matters":[],"theses":[]},{"article":18,"items":[{"item":"18:e1","matter":"gnews:6d2b29d8e482817e9d9b617b#1","verdict":null,"row":null,"links":[]},{"item":"18:e2","matter":null,"verdict":"optional","row":"§5.3 known facts r