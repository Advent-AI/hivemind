 Nov 22 00:40 codex-r40c.stream\n-rw-r--r--@ 1 lchingen  staff     1530 Nov 22 00:42 codex-r40d.md\n-rw-r--r--@ 1 lchingen  staff    45134 Nov 22 00:42 codex-r40d.stream\n-rw-r--r--@ 1 lchingen  staff      683 Nov 22 00:43 codex-r40e.md\n-rw-r--r--@ 1 lchingen  staff    21477 Nov 22 00:43 codex-r40e.stream\n-rw-r--r--@ 1 lchingen  staff       26 Nov 22 00:43 codex-r40f.md\n-rw-r--r--@ 1 lchingen  staff     8796 Nov 22 00:43 codex-r40f.stream\n-rw-r--r--@ 1 lchingen  staff        0 Nov 22 00:49 codex-r41.md\n-rw-r--r--@ 1 lchingen  staff     1232 Nov 22 00:49 codex-r41.stream\n-rw-r--r--@ 1 lchingen  staff     2249 Nov 21 17:35 mutants.log\n-rw-r--r--@ 1 lchingen  staff     5917 Nov 21 17:35 mutants.py\n-rw-r--r--@ 1 lchingen  staff     1828 Nov 21 17:29 preflight-old2.log\n-rw-r--r--@ 1 lchingen  staff  1906932 Nov 22 00:36 probe-plan.json\n-rw-r--r--@ 1 lchingen  staff    11455 Nov 22 00:41 probe-targets.json\n-rw-r--r--@ 1 lchingen  staff    10951 Nov 22 00:45 probe.py\n-rw-r--r--@ 1 lchingen  staff     7284 Nov 22 00:36 probe_plan.py\n-rw-r--r--@ 1 lchingen  staff     9354 Nov 22 00:46 probe_read.py\n-rw-r--r--@ 1 lchingen  staff    18871 Nov 22 00:48 probe_rehearsal.py\n-rw-r--r--@ 1 lchingen  staff     2267 Nov 22 00:48 rehearsal.log\n-rw-r--r--@ 1 lchingen  staff     2428 Nov 21 16:55 round38-brief.md\n-rw-r--r--@ 1 lchingen  staff     1531 Nov 21 17:01 round38b-brief.md\n-rw-r--r--@ 1 lchingen  staff      927 Nov 21 17:05 round38c-brief.md\n-rw-r--r--@ 1 lchingen  staff      620 Nov 21 17:06 round38d-brief.md\n-rw-r--r--@ 1 lchingen  staff     1582 Nov 21 17:30 round39-brief.md\n-rw-r--r--@ 1 lchingen  staff     1050 Nov 21 17:40 round39b-brief.md\n-rw-r--r--@ 1 lchingen  staff      169 Nov 21 17:40 round39c-brief.md\n-rw-r--r--@ 1 lchingen  staff     1524 Nov 22 00:27 round40-brief.md\n-rw-r--r--@ 1 lchingen  staff     1202 Nov 22 00:36 round40b-brief.md\n-rw-r--r--@ 1 lchingen  staff     1181 Nov 22 00:39 round40c-brief.md\n-rw-r--r--@ 1 lchingen  staff      821 Nov 22 00:41 round40d-brief.md\n-rw-r--r--@ 1 lchingen  staff      591 Nov 22 00:42 round40e-brief.md\n-rw-r--r--@ 1 lchingen  staff      363 Nov 22 00:43 round40f-brief.md\n-rw-r--r--@ 1 lchingen  staff     1650 Nov 22 00:49 round41-brief.md\n-rw-r--r--@ 1 lchingen  staff      900 Nov 22 00:45 stored-v7-support.json\n-rw-r--r--@ 1 lchingen  staff     2379 Nov 21 17:29 t1-replay.log\n-rw-r--r--@ 1 lchingen  staff    15564 Nov 21 17:39 t1_replay.py\n-rw-r--r--@ 1 lchingen  staff     7032 Nov 21 17:16 t2-offline.log\n-rw-r--r--@ 1 lchingen  staff    12801 Nov 21 17:16 t2-result.json\n-rw-r--r--@ 1 lchingen  staff     6653 Nov 21 17:16 t2_offline.py\n     205 probe.py\n     154 probe_read.py\n     285 probe_rehearsal.py\n      54 rehearsal.log\n     224 PROBE-DESIGN.md\n     922 total\n{\n \"frozen\": \"2026-11-22, before any probe send: whether the stored accepted v7 answer to each refused request stated the material target's required claim with a listed source (PROBE-DESIGN.md v5, material-loss rule); read by Claude\",\n \"targets\": {\n  \"old-2:591\": {\n   \"stored accepted v7 answer\": 596,\n   \"sources used\": [\n    \"e120\",\n    \"e250\",\n    \"e41\",\n    \"e42\"\n   ],\n   \"claim stated\": true,\n   \"supported\": true\n  },\n  \"old-2:6955\": {\n   \"stored accepted v7 answer\": 6979,\n   \"sources used\": [\n    \"e3768\"\n   ],\n   \"claim stated\": true,\n   \"supported\": true\n  },\n  \"control-1:8807\": {\n   \"stored accepted v7 answer\": 8809,\n   \"sources used\": [\n    \"e195\",\n    \"e669\"\n   ],\n   \"claim stated\": true,\n   \"supported\": true\n  },\n  \"control-1:8938\": {\n   \"stored accepted v7 answer\": null,\n   \"note\": \"both stored attempts (8938, 8941) were refused; none accepted\",\n   \"supported\": false\n  }\n }\n}\n","exit_code":0,"status":"completed"}}
