{"type":"item.started","item":{"id":"item_8","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"python3 -B -c 'import json,sys,re,sqlite3\nfrom pathlib import Path\nfrom types import SimpleNamespace\nh=Path('\\\\''docs/research/2026-11-21-citation-lists'\\\\'').resolve();sys.path[:0]=[str(h),str(Path('\\\\''src'\\\\'').resolve()),str(Path('\\\\''clean-arch/e2e-comparison-2026-11-13'\\\\'').resolve())]\nfrom hivemind import model\nfrom hivemind.views import judging\nfrom budget_replay import llm_estimate\nimport t2_offline as t\np=json.loads((h/'\\\\''probe-plan.json'\\\\'').read_text())\nr=next(k for k in p['\\\\''matched'\\\\''] if k['\\\\''source'\\\\'']=='\\\\''control-1'\\\\'' and k['\\\\''call_id'\\\\'']==8790)\nprint('\\\\''8790 quotes'\\\\'')\nfor i in ('\\\\''e195'\\\\'','\\\\''e669'\\\\''):\n    print(i, re.search(r'\\\\''(?m)\"'^- '\"'\\\\''+i+r'\\\\'' \\\\[.*\\\\n    Quote: .*'\\\\'',r['\\\\''user'\\\\'']).group(0))\ns=SimpleNamespace(model='\\\\''gpt-6-luna'\\\\'',reasoning_effort='\\\\''medium'\\\\'',max_output_tokens=16000)\ndef reservation(r,v):\n    return llm_estimate(model.build_request(s,r['\\\\''system'\\\\''],r['\\\\''user'\\\\''],judging.schema_for(v,r['\\\\''lists'\\\\'']),'\\\\''judgement'\\\\'','\\\\''openai'\\\\''))\nfor mult in (1,1.3):\n    spent=mult*(sum(r['\\\\''estimated cost'\\\\''] for r in p['\\\\''acceptance'\\\\''][:2])+3*sum(r['\\\\''estimated cost'\\\\''] for r in p['\\\\''refused'\\\\'']))\n    margins=[]\n    for r in p['\\\\''matched'\\\\'']:\n        held=3*sum(reservation(r,v) for v in ('\\\\''judging-v7'\\\\'','\\\\''judging-v12'\\\\''))\n        margins.append(.50-spent-held)\n        if margins[-1]<0:\n            print('\\\\''first blocked'\\\\'',r['\\\\''source'\\\\''],r['\\\\''call_id'\\\\''],len(margins)-1,held,.5-spent)\n            break\n        spent+=6*mult*r['\\\\''estimated cost'\\\\'']\n    else: print('\\\\''all start'\\\\'',spent,min(margins))\n'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
