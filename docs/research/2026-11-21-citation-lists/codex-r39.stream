{"type":"item.completed","item":{"id":"item_22","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc 'nl -ba tests/test_citation_lists.py'","aggregated_output":"     1\t\"\"\"judging-v12 (D712, D713; docs/research/2026-11-21-citation-lists/DESIGN.md): the judge's four id fields take only the ids its request\n     2\tlists, from the rows that render the request, and the check reads the same lists. Real ledger on a temporary path; the model is a\n     3\tscripted transport; every answer goes through the real `model.call` and `model.check_schema`.\"\"\"\n     4\timport json\n     5\timport os\n     6\timport sys\n     7\t\n     8\timport pytest\n     9\t\n    10\tROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))\n    11\tsys.path.insert(0, os.path.join(ROOT, 'src'))\n    12\tsys.path.insert(0, os.path.join(ROOT, 'scripts'))\n    13\tfrom hivemind import config, model  # noqa: E402\n    14\tfrom hivemind.views import judging, store  # noqa: E402\n    15\timport test_theme_block as fixtures  # noqa: E402\n    16\t\n    17\tV121 = config.load(os.path.join(ROOT, 'poc', 'config', 'poc-v121.json'))\n    18\tDAY = {'input_id': 'day:2026-07-29', 'publication_day': '2026-07-29'}\n    19\t\n    20\t\n    21\tdef answer(view_id, **fields):\n    22\t    data = {'rung': 2, 'reference': 'consensus expects about 78', 'implied_outcome': 'about 78 on the evidence', 'reasons': f'scripted for {view_id}',\n    23\t            'cites': [], 'cites_views': [], 'pushes': [], 'changed': True, 'why_changed': 'scripted', 'theme_pushes': []}\n    24\t    data.update(fields)\n    25\t    return {'choices': [{'message': {'content': json.dumps(data)}}], 'usage': {'prompt_tokens': 100, 'completion_tokens': 10}}\n    26\t\n    27\t\n    28\tdef judged_theme(conn):\n    29\t    \"\"\"v2 (the theme) holds a conclusion, so it is in force for v1.\"\"\"\n    30\t    fixtures.judged(conn, 'v2', 1, 'theme judged', 2)\n    31\t    conn.commit()\n    32\t\n    33\t\n    34\tdef add_evidence(conn, evidence_id, view_id, quote, seq=1):\n    35\t    store.add_evidence(conn, evidence_id=evidence_id, quote=quote, one_line=quote[:40], speaker='CFO', original_who='NVIDIA', original_day='2026-02-25',\n    36\t                       tier='party_statement', event_time='', seq=seq, input_id='truenorth:transcript:NVDA:2026-02-25')\n    37\t    store.add_source(conn, evidence_id, 'truenorth:transcript:NVDA:2026-02-25', 'T4', '2026-02-25', 'p1', seq)\n    38\t    store.link(conn, evidence_id, view_id, seq)\n    39\t\n    40\t\n    41\tdef test_the_lists_are_the_rendered_rows_and_a_waiting_dependency_gives_no_id(tmp_path):\n    42\t    \"\"\"DESIGN §3: evidence printed, resolved dependencies with an entry, themes printed; a dependency still waiting has no citable id.\"\"\"\n    43\t    conn = fixtures.ledger(tmp_path)\n    44\t    judged_theme(conn)\n    45\t    store.create_view(conn, view_id='v3', object_id='NVDA', object_kind='company', kind='asset', looks_at='FY2027 total revenue',\n    46\t                      question='How much total revenue will NVIDIA report for FY2027?', due_day='2027-02-24', year='FY2027', rungs=fixtures.ASSET_RUNGS,\n    47\t                      seq=1, input_id='truenorth:transcript:NVDA:2026-02-25', created_at='2026-02-25T22:00:00Z')\n    48\t    store.insert(conn, 'dependencies', view_id='v1', depends_on='v3', wait_chain_view_id='', wait_year='', direction='first_is_bullish', seq=1)\n    49\t    store.insert(conn, 'dependencies', view_id='v1', depends_on='', wait_chain_view_id='v3', wait_year='FY2029', direction='same', seq=1)\n    50\t    conn.commit()\n    51\t    system, user, lists = judging.request_parts(conn, 'v1', 'judging-v12')\n    52\t    assert lists == {'evidence': ['e1'], 'dependencies': ['v3'], 'themes': ['v2']}\n    53\t    assert (system, user) == judging.build_prompt(conn, 'v1', 'judging-v12') == judging.build_prompt(conn, 'v1', 'judging-v7')\n    54\t    assert '- e1 [' in user and '- v3 (' in user and '- v2 (' in user and 'not yet created' in user\n    55\t\n    56\t\n    57\tdef test_every_id_field_takes_only_its_listed_ids_through_the_real_validator():\n    58\t    \"\"\"T3: an allowed id passes and an unlisted id fails in each of the four fields; an empty list allows only [], and a correctly typed\n    59\t    item fails on the array's length, not on its type.\"\"\"\n    60\t    schema = judging.schema_for('judging-v12', {'evidence': ['e1', 'e3'], 'dependencies': ['v3'], 'themes': ['v2']})\n    61\t    valid = json.loads(answer('v1')['choices'][0]['message']['content'])\n    62\t    check = lambda **fields: model.check_schema(dict(valid, **fields), schema)\n    63\t    assert check(cites=['e3'], pushes=[{'evidence_id': 'e1', 'push': 'none'}], cites_views=['v3'], theme_pushes=[{'view_id': 'v2', 'push': 'none'}]) == []\n    64\t    assert check(cites=['e362'])\n    65\t    assert check(pushes=[{'evidence_id': 'e3111', 'push': 'none'}])\n    66\t    assert check(cites_views=['v5'])\n    67\t    assert check(theme_pushes=[{'view_id': 'v14', 'push': 'none'}])\n    68\t    empty = judging.schema_for('judging-v12', {'evidence': [], 'dependencies': [], 'themes': []})\n    69\t    filled = {'cites': ['e1'], 'cites_views': ['v3'], 'pushes': [{'evidence_id': 'e1', 'push': 'none'}], 'theme_pushes': [{'view_id': 'v2', 'push': 'none'}]}\n    70\t    assert model.check_schema(dict(valid, cites=[], cites_views=[], pushes=[], theme_pushes=[]), empty) == []\n    71\t    for field, items in filled.items():\n    72\t        assert model.check_schema(dict(valid, **{field: items}), empty) == [f'$.{field}: more than 0 items'], field\n    73\t\n    74\t\n    75\tdef test_one_owner_of_membership_a_footnote_in_a_quote_does_not_hide_a_later_id(tmp_path):\n    76\t    \"\"\"T3b: a quote holding a blank line and \"[1]\" ends the evidence block for the text parser, so a real later entry looks unlisted;\n    77\t    under judging-v12 the format and the check both read the rendered rows.\"\"\"\n    78\t    conn = fixtures.ledger(tmp_path)\n    79\t    store.create_view(conn, view_id='v6', object_id='NVDA', object_kind='company', kind='asset', looks_at='FY2027 total revenue',\n    80\t                      question='How much total revenue will NVIDIA report for FY2027?', due_day='2027-02-24', year='FY2027', rungs=fixtures.ASSET_RUNGS,\n    81\t                      seq=1, input_id='truenorth:transcript:NVDA:2026-02-25', created_at='2026-02-25T22:00:00Z')\n    82\t    add_evidence(conn, 'e4', 'v6', 'Data center revenue rose sharply.\\n\\n[1] Excludes networking.', seq=1)\n    83\t    add_evidence(conn, 'e5', 'v6', 'Guidance for the next quarter is $91 billion.', seq=2)\n    84\t    conn.commit()\n    85\t    _, user, lists = judging.request_parts(conn, 'v6', 'judging-v12')\n    86\t    assert lists['evidence'] == ['e4', 'e5'] and '- e5 [' in user\n    87\t    data = json.loads(answer('v6', cites=['e5'], pushes=[{'evidence_id': 'e5', 'push': 'toward_first'}])['choices'][0]['message']['content'])\n    88\t    assert judging.check_answer(conn, 'v6', data, user, lists) == []\n    89\t    assert model.check_schema(data, judging.schema_for('judging-v12', lists)) == []\n    90\t    assert 'e5 is not among the evidence shown to v6' in judging.check_answer(conn, 'v6', data, user)       # the frozen text parser narrows\n    91\t\n    92\t\n    93\tdef test_a_judging_v12_round_sends_the_closed_format_and_its_retry_carries_the_same_format(tmp_path):\n    94\t    \"\"\"T1c: the first answer names a theme twice (a refusal that is not about membership); the retry carries exactly the first\n    95\t    request's format and lists, plus the code's note; the accepted answer is recorded.\"\"\"\n    96\t    conn = fixtures.ledger(tmp_path)\n    97\t    judged_theme(conn)\n    98\t    archive = model.Archive(str(tmp_path / 'archive.sqlite'))\n    99\t    sent = []\n   100\t\n   101\t    def transport(provider, request):\n   102\t        sent.append(request)\n   103\t        if len(sent) == 1:\n   104\t            return answer('v1', cites=['e1'], theme_pushes=[{'view_id': 'v2', 'push': 'none'}, {'view_id': 'v2', 'push': 'none'}])\n   105\t        return answer('v1', cites=['e1'], pushes=[{'evidence_id': 'e1', 'push': 'toward_first'}], theme_pushes=[{'view_id': 'v2', 'push': 'none'}])\n   106\t    results = judging.round_of_judgements(archive, V121, conn, ['v1'], 3, DAY, transport=transport)\n   107\t    assert [r['view_id'] for r in results] == ['v1'] and len(sent) == 2\n   108\t    first, retry = sent\n   109\t    expected = judging.schema_for('judging-v12', {'evidence': ['e1'], 'dependencies': [], 'themes': ['v2']})\n   110\t    assert first['response_format'] == {'type': 'json_schema', 'json_schema': {'name': 'judgement', 'strict': True, 'schema': expected}}\n   111\t    assert retry['response_format'] == first['response_format']\n   112\t    assert retry['messages'][1]['content'].startswith(first['messages'][1]['content'])\n   113\t    assert 'v2 is named twice in theme_pushes' in retry['messages'][1]['content'][len(first['messages'][1]['content']):]\n   114\t    assert store.current_state(conn, 'v1')['rung'] == 2\n   115\t\n   116\t\n   117\tdef test_an_answer_outside_the_lists_is_refused_by_the_format_before_the_check(tmp_path):\n   118\t    \"\"\"DESIGN §4.1: a membership error the provider should never return under strict mode is refused by `model.check_schema`\n   119\t    (a `:schema:` row and SchemaError), not by the check's retry.\"\"\"\n   120\t    conn = fixtures.ledger(tmp_path)\n   121\t    archive = model.Archive(str(tmp_path / 'archive.sqlite'))\n   122\t    with pytest.raises(model.SchemaError, match='e362'):\n   123\t        judging.round_of_judgements(archive, V121, conn, ['v1'], 3, DAY, transport=lambda provider, request: answer('v1', cites=['e362']))\n   124\t    assert archive.conn.execute(\"select count(*) from model_calls where request_sha256 like '%:schema:%'\").fetchone()[0] == 1\n   125\t    assert store.current_state(conn, 'v1') is None\n   126\t\n   127\t\n   128\tdef test_preflight_fails_on_a_refused_judge_row_without_its_saved_format(tmp_path, capsys):\n   129\t    \"\"\"T5: judge rows are checked against the format saved with their request; one without a format is named and fails preflight.\"\"\"\n   130\t    import preflight\n   131\t    archive = model.Archive(str(tmp_path / 'archive.sqlite'))\n   132\t    closed = judging.schema_for('judging-v12', {'evidence': ['e1'], 'dependencies': [], 'themes': []})\n   133\t    rows = [('judge', 'a' * 64 + ':refused:1', {'response_format': {'json_schema': {'name': 'judgement', 'strict': True, 'schema': closed}}},\n   134\t             json.loads(answer('v1', cites=['e9'])['choices'][0]['message']['content'])),\n   135\t            ('judge', 'b' * 64 + ':refused:2', {'messages': []}, json.loads(answer('v1')['choices'][0]['message']['content']))]\n   136\t    for purpose, sha, request, data in rows:\n   137\t        archive.record(purpose=purpose, config_version='poc-v121', config_checksum='x', model='gpt-6-luna', request_sha256=sha,\n   138\t                       request_json=json.dumps(request), response_json='{}', answer_json=json.dumps(data), prompt_chars=1, input_tokens=1,\n   139\t                       output_tokens=1, cost_usd=0.0, seconds=0.1, created_at='2026-11-21T20:00:00')\n   140\t    archive.conn.row_factory = None\n   141\t    judged, missing = preflight.part_a(archive.conn)\n   142\t    out = capsys.readouterr().out\n   143\t    assert judged == 2 and missing == ['b' * 64 + ':refused:2']\n   144\t    assert \"'e9' not in\" in out and 'judge: no saved answer format' in out\n   145\t\n   146\t\n   147\tdef test_preflights_entry_point_exits_non_zero_on_a_judge_row_without_its_saved_format(tmp_path, monkeypatch, capsys):\n   148\t    \"\"\"T5, as the user runs it: `main` finishes the other parts, then exits 1 naming the judge row part A could not check.\"\"\"\n   149\t    import preflight\n   150\t    archive = model.Archive(str(tmp_path / 'archive.sqlite'))\n   151\t    archive.record(purpose='judge', config_version='poc-v121', config_checksum='x', model='gpt-6-luna', request_sha256='c' * 64 + ':refused:3',\n   152\t                   request_json=json.dumps({'messages': []}), response_json='{}',\n   153\t                   answer_json=answer('v1')['choices'][0]['message']['content'], prompt_chars=1, input_tokens=1, output_tokens=1,\n   154\t                   cost_usd=0.0, seconds=0.1, created_at='2026-11-21T20:00:00')\n   155\t    for name in ('part_b', 'part_d'):\n   156\t        monkeypatch.setattr(preflight, name, lambda *arguments: 1)\n   157\t    monkeypatch.setattr(preflight, 'part_c', lambda *arguments: 1)\n   158\t    monkeypatch.setattr(preflight, 'part_e', lambda *arguments: None)\n   159\t    monkeypatch.setattr(preflight, 'store_copies', lambda paths: [])\n   160\t    monkeypatch.setattr(sys, 'argv', ['preflight.py', '--archive', str(tmp_path / 'archive.sqlite'), '--items', str(tmp_path / 'items.sqlite'),\n   161\t                                      '--views', str(tmp_path / 'views.sqlite')])\n   162\t    with pytest.raises(SystemExit) as stopped:\n   163\t        preflight.main()\n   164\t    assert stopped.value.code == 1 and 'FAILED: 1 refused judge rows carry no saved answer format' in capsys.readouterr().out\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_23","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc 'nl -ba docs/research/2026-11-21-citation-lists/t1_replay.py'","aggregated_output":"     1\t\"\"\"T1 and T1b of the citation-only judge's $0 test (DESIGN.md §5, registered before it runs; D713).\n     2\t\n     3\tT1: old-2's whole window replayed under poc-v121 (judging-v12) through `replay.run`. The scratch archive holds old-2's non-judge calls\n     4\tonly, so every judge request reaches this transport and the real `model.call` / `model.check_schema`. The transport finds old-2's call by\n     5\tthe request's system and user bytes, asserts that the request equals the stored one in every key but the answer format, that the format\n     6\tis strict, named `judgement`, and differs from judging-v7's only in the four citation constraints, and that each closed list equals the\n     7\tids the request text shows. The four first answers old-2's check refused get old-2's accepted retry answer, labelled. Then the store is\n     8\tcompared with old-2's on every table, the expected differences named.\n     9\t\n    10\tT1b: each of those four refused originals through the real `model.call` under its v12 request must raise SchemaError on its bad id.\n    11\t\n    12\t  python3 t1_replay.py <new output folder>\n    13\t\"\"\"\n    14\timport copy\n    15\timport json\n    16\timport re\n    17\timport sqlite3\n    18\timport sys\n    19\timport tempfile\n    20\timport threading\n    21\timport time\n    22\tfrom pathlib import Path\n    23\t\n    24\tHERE = Path(__file__).resolve().parent\n    25\tREPO = HERE.parents[2]\n    26\tsys.path.insert(0, str(REPO / 'src'))\n    27\tfrom hivemind import config, live_lock, model, replay, universe        # noqa: E402\n    28\tfrom hivemind.views import judging                                     # noqa: E402\n    29\t\n    30\tOLD2 = REPO / 'poc/data/comparison-2026-11-17/run/old-2/prod'\n    31\tITEMS = REPO / 'poc/data/comparison-2026-11-17/items-comparison.sqlite'\n    32\tUNIVERSE = REPO / 'poc/universe.json'\n    33\tV121 = REPO / 'poc/config/poc-v121.json'\n    34\tWINDOW = ('2026-07-01', '2026-09-20')\n    35\tRETRY_MARK = '\\n\\nThe code returned the previous answer because: '\n    36\tEXPECTED_JUDGE_RESPONSES, EXPECTED_SUBSTITUTIONS = 1616, 4\n    37\t# columns that differ by construction: timestamps, the new judge calls' archive ids and request hashes, the configuration's checksum\n    38\tEXPECTED_DIFFERENT = {'days_completed': {'at'}, 'processing_steps': {'at'}, 'views': {'created_at'},\n    39\t                      'judgements': {'call_id', 'request_sha256', 'config_checksum'}}\n    40\t# the current store schema's additions since old-2 ran (D694's linking build, uncommitted): a table and a column, both empty here\n    41\tNEW_TABLES = {'harness_only', 'link_selections'}\n    42\tNEW_COLUMNS = {'dependencies': {'kind'}}\n    43\t\n    44\t\n    45\tclass Stop(Exception):\n    46\t    pass\n    47\t\n    48\t\n    49\tdef opened(schema):\n    50\t    \"\"\"The format with its four citation constraints removed: judging-v7's format if nothing else differs.\"\"\"\n    51\t    schema = copy.deepcopy(schema)\n    52\t    schema.pop('$defs', None)\n    53\t    properties = schema['properties']\n    54\t    for field in ('cites', 'cites_views', 'pushes', 'theme_pushes'):\n    55\t        properties[field].pop('maxItems', None)\n    56\t    properties['cites']['items'] = {'type': 'string'}\n    57\t    properties['cites_views']['items'] = {'type': 'string'}\n    58\t    properties['pushes']['items']['properties']['evidence_id'] = {'type': 'string'}\n    59\t    properties['theme_pushes']['items']['properties']['view_id'] = {'type': 'string'}\n    60\t    return schema\n    61\t\n    62\t\n    63\tdef closed_lists(schema):\n    64\t    \"\"\"The ids each field allows (an array with maxItems 0 allows none).\"\"\"\n    65\t    properties, defs = schema['properties'], schema.get('$defs', {})\n    66\t\n    67\t    def ids(array, item_path):\n    68\t        if array.get('maxItems') == 0:\n    69\t            return []\n    70\t        node = array['items']\n    71\t        for key in item_path:\n    72\t            node = node['properties'][key]\n    73\t        node = defs[node['$ref'].rsplit('/', 1)[1]] if '$ref' in node else node\n    74\t        return sorted(node['enum'])\n    75\t    evidence = ids(properties['cites'], ())\n    76\t    if evidence != ids(properties['pushes'], ('evidence_id',)):\n    77\t        raise Stop('cites and push ids allow different evidence ids')\n    78\t    return {'evidence': evidence, 'dependencies': ids(properties['cites_views'], ()), 'themes': ids(properties['theme_pushes'], ('view_id',))}\n    79\t\n    80\t\n    81\tdef dependencies_shown_in(user):\n    82\t    block = user.split('\\n[Current conclusions of the theses it depends on]', 1)\n    83\t    return set(re.findall(r'^- (v\\d+) \\(', block[1].split('\\n\\n[', 1)[0], re.M)) if len(block) == 2 else set()\n    84\t\n    85\t\n    86\tdef stored_judge_calls():\n    87\t    \"\"\"old-2's judge calls by (system, user): each a list of rows, the refused first answers included.\"\"\"\n    88\t    archive = sqlite3.connect(f'file:{OLD2 / \"archive.sqlite\"}?mode=ro', uri=True)\n    89\t    calls = {}\n    90\t    for call_id, sha, request_json, answer_json, tokens_in, tokens_out in archive.execute(\n    91\t            \"select call_id, request_sha256, request_json, answer_json, input_tokens, output_tokens from model_calls where purpose='judge' order by call_id\"):\n    92\t        request = json.loads(request_json)\n    93\t        key = (request['messages'][0]['content'], request['messages'][1]['content'])\n    94\t        calls.setdefault(key, []).append({'call_id': call_id, 'refused': ':refused:' in sha, 'request': request, 'answer': answer_json,\n    95\t                                          'usage': {'prompt_tokens': tokens_in or 0, 'completion_tokens': tokens_out or 0}})\n    96\t    return calls\n    97\t\n    98\t\n    99\tdef compare_stores(built_path):\n   100\t    built = sqlite3.connect(f'file:{built_path}?mode=ro', uri=True)\n   101\t    stored = sqlite3.connect(f'file:{OLD2 / \"views.sqlite\"}?mode=ro', uri=True)\n   102\t    tables = lambda conn: {r[0] for r in conn.execute(\"select name from sqlite_master where type='table'\")}\n   103\t    report, ok = {}, True\n   104\t    extra = tables(built) - tables(stored)\n   105\t    if extra - NEW_TABLES or tables(stored) - tables(built):\n   106\t        ok = False\n   107\t    report['tables only in the replay'] = sorted(extra)\n   108\t    report['tables only in old-2'] = sorted(tables(stored) - tables(built))\n   109\t    for name in sorted(extra & NEW_TABLES - {'harness_only'}):\n   110\t        rows = built.execute(f'select count(*) from \"{name}\"').fetchone()[0]\n   111\t        report[f'{name} (new table) rows'] = rows\n   112\t        ok = ok and rows == 0\n   113\t    for name in sorted(tables(stored) & tables(built)):\n   114\t        columns = [r[1] for r in stored.execute(f'pragma table_info(\"{name}\")')]\n   115\t        built_columns = [r[1] for r in built.execute(f'pragma table_info(\"{name}\")')]\n   116\t        if columns != built_columns:\n   117\t            added = [c for c in built_columns if c not in columns]\n   118\t            expected = built_columns[:len(columns)] == columns and set(added) == NEW_COLUMNS.get(name, set())\n   119\t            empty = built.execute(f'select count(*) from \"{name}\"').fetchone()[0] == 0\n   120\t            if not (expected and empty):\n   121\t                report[name] = f'columns differ: {added}'\n   122\t                ok = False\n   123\t                continue\n   124\t        kept = [c for c in columns if c not in EXPECTED_DIFFERENT.get(name, set())]\n   125\t        select = f'select {\", \".join(chr(34) + c + chr(34) for c in kept)} from \"{name}\"'      # some FTS tables have no rowid: compare as sorted rows\n   126\t        rows_built, rows_stored = sorted(built.execute(select), key=repr), sorted(stored.execute(select), key=repr)\n   127\t        equal = rows_built == rows_stored\n   128\t        report[name] = {'rows': len(rows_stored), 'equal': equal, 'columns not compared': sorted(EXPECTED_DIFFERENT.get(name, set()))}\n   129\t        if not equal:\n   130\t            ok = False\n   131\t            report[name]['first difference'] = next((str((b, s))[:400] for b, s in zip(rows_built, rows_stored) if b != s), f'{len(rows_built)} rows against {len(rows_stored)}')\n   132\t    return ok, report\n   133\t\n   134\t\n   135\tdef t1(folder):\n   136\t    if folder.exists():\n   137\t        raise SystemExit(f'{folder} exists: T1 starts from an empty folder')\n   138\t    folder.mkdir(parents=True)\n   139\t    archive_path, views = folder / 'archive.sqlite', folder / 'views.sqlite'\n   140\t    seed = sqlite3.connect(f'file:{OLD2 / \"archive.sqlite\"}?mode=ro', uri=True)\n   141\t    target = sqlite3.connect(str(archive_path))\n   142\t    seed.backup(target)\n   143\t    seed.close()\n   144\t    removed = target.execute(\"delete from model_calls where purpose='judge'\").rowcount\n   145\t    target.commit()\n   146\t    target.close()\n   147\t    marker = sqlite3.connect(views)\n   148\t    marker.execute('create table harness_only (name text, day text)')\n   149\t    marker.execute(\"insert into harness_only values ('t1_replay.py', '2026-11-21')\")\n   150\t    marker.commit()\n   151\t    marker.close()\n   152\t    v7_format = judging.schema_for('judging-v7')\n   153\t    stored = stored_judge_calls()\n   154\t    lock = threading.Lock()\n   155\t    log = {'responses': 0, 'substitutions': [], 'problems': [], 'list mismatches': [], 'sizes': [], 'outgoing for refused originals': {}}\n   156\t\n   157\t    def transport(*args):\n   158\t        if len(args) == 1:\n   159\t            raise Stop('a Jev request missed the seeded archive')\n   160\t        provider, request = args\n   161\t        if (request.get('response_format') or {}).get('json_schema', {}).get('name') != 'judgement':\n   162\t            (folder / 'missed-request.json').write_text(json.dumps(request, ensure_ascii=False, indent=1))\n   163\t            raise Stop('a non-judge request missed the seeded archive')\n   164\t        system, user = request['messages'][0]['content'], request['messages'][1]['content']\n   165\t        rows = stored.get((system, user))\n   166\t        if not rows:\n   167\t            raise Stop(f'no stored old-2 judge call for this text ({user[:80]!r})')\n   168\t        problems = []\n   169\t        first = rows[0]\n   170\t        outgoing_rest = {k: v for k, v in request.items() if k != 'response_format'}\n   171\t        stored_rest = {k: v for k, v in first['request'].items() if k != 'response_format'}\n   172\t        if outgoing_rest != stored_rest:\n   173\t            problems.append('the request differs from old-2 outside the format')\n   174\t        json_schema = request['response_format']['json_schema']\n   175\t        if request['response_format'].get('type') != 'json_schema' or json_schema.get('strict') is not True or json_schema.get('name') != 'judgement':\n   176\t            problems.append('the format is not strict json_schema named judgement')\n   177\t        schema = json_schema['schema']\n   178\t        if opened(schema) != v7_format:\n   179\t            problems.append('the format differs from judging-v7 outside the four citation constraints')\n   180\t        lists = closed_lists(schema)\n   181\t        shown = {'evidence': sorted(judging.evidence_shown_in(user)), 'dependencies': sorted(dependencies_shown_in(user)), 'themes': sorted(judging.themes_shown_in(user))}\n   182\t        mismatch = {k: {'only in format': sorted(set(lists[k]) - set(shown[k])), 'only in text': sorted(set(shown[k]) - set(lists[k]))}\n   183\t                    for k in lists if lists[k] != shown[k]}\n   184\t        accepted = [r for r in rows if not r['refused']]\n   185\t        with lock:\n   186\t            log['responses'] += 1\n   187\t            log['sizes'].append({'evidence': len(lists['evidence']), 'themes': len(lists['themes']), 'dependencies': len(lists['dependencies']),\n   188\t                                 'format chars': len(json.dumps(schema)), 'v7 format chars': len(json.dumps(v7_format))})\n   189\t            if mismatch:\n   190\t                log['list mismatches'].append({'call': first['call_id'], 'mismatch': mismatch})\n   191\t            if problems:\n   192\t                log['problems'].append({'call': first['call_id'], 'problems': problems})\n   193\t            if not accepted:                       # old-2's check refused this first answer: its accepted retry answer, labelled\n   194\t                retries = [r for (s, u), group in stored.items() if s == system and u.startswith(user + RETRY_MARK) for r in group if not r['refused']]\n   195\t                if len(retries) != 1:\n   196\t                    raise Stop(f'call {first[\"call_id\"]}: {len(retries)} accepted retries found')\n   197\t                log['substitutions'].append({'refused call': first['call_id'], 'retry call': retries[0]['call_id']})\n   198\t                log['outgoing for refused originals'][first['call_id']] = {'request': request, 'answer': first['answer']}\n   199\t                chosen = retries[0]\n   200\t            else:\n   201\t                chosen = accepted[0]\n   202\t        return {'choices': [{'message': {'content': chosen['answer']}}], 'usage': chosen['usage']}\n   203\t\n   204\t    held = live_lock.acquire(str(views))\n   205\t    started = time.time()\n   206\t    stopped = ''\n   207\t    try:\n   208\t        replay.run(testdb_path=str(ITEMS), views_path=str(views), archive=model.Archive(str(archive_path)), cfg=config.load(str(V121)),\n   209\t                   universe=universe.load(str(UNIVERSE)), from_day=WINDOW[0], until_day=WINDOW[1], transport=transport, log=lambda *a: None,\n   210\t                   only_objects={'NVDA'})\n   211\t    except Exception as error:\n   212\t        stopped = f'{type(error).__name__}: {error}'[:500]\n   213\t    finally:\n   214\t        live_lock.release(held)\n   215\t    (folder / 'transport-log.json').write_text(json.dumps({k: v for k, v in log.items() if k != 'outgoing for refused originals'}, ensure_ascii=False))\n   216\t    (folder / 'outgoing-refused-originals.json').write_text(json.dumps(log['outgoing for refused originals'], ensure_ascii=False))\n   217\t    equal, comparison = compare_stores(views) if not stopped else (False, {})\n   218\t    sizes = log['sizes']\n   219\t    result = {\n   220\t        'stopped': stopped, 'seconds': round(time.time() - started), 'judge rows removed from the seed': removed,\n   221\t        'judge responses through the transport': log['responses'], 'substitutions': log['substitutions'],\n   222\t        'problems': log['problems'], 'list mismatches': log['list mismatches'], 'store equal to old-2 (named columns apart)': equal,\n   223\t        'store comparison': comparison,\n   224\t        'sizes': {'requests': len(sizes), 'max evidence': max((s['evidence'] for s in sizes), default=0),\n   225\t                  'format chars median': sorted(s['format chars'] for s in sizes)[len(sizes) // 2] if sizes else 0,\n   226\t                  'format chars max': max((s['format chars'] for s in sizes), default=0), 'v7 format chars': sizes[0]['v7 format chars'] if sizes else 0},\n   227\t    }\n   228\t    result['T1 pass'] = (not stopped and log['responses'] == EXPECTED_JUDGE_RESPONSES and len(log['substitutions']) == EXPECTED_SUBSTITUTIONS\n   229\t                         and not log['problems'] and not log['list mismatches'] and equal)\n   230\t    return result, log['outgoing for refused originals']\n   231\t\n   232\t\n   233\tdef t1b(originals):\n   234\t    \"\"\"Each refused original answer through the real model.call under its v12 request: SchemaError on the bad id.\"\"\"\n   235\t    cfg = config.load(str(V121))\n   236\t    out = {}\n   237\t    with tempfile.TemporaryDirectory() as scratch:\n   238\t        archive = model.Archive(str(Path(scratch) / 'archive.sqlite'))\n   239\t        for call_id, item in originals.items():\n   240\t            request = item['request']\n   241\t            system, user = request['messages'][0]['content'], request['messages'][1]['content']\n   242\t            schema = request['response_format']['json_schema']['schema']\n   243\t            try:\n   244\t                model.call(archive, cfg, cfg.rejudging, system, user, schema, 'judgement', 'judge',\n   245\t                           transport=lambda provider, sent, answer=item['answer']: {'choices': [{'message': {'content': answer}}], 'usage': {}})\n   246\t                out[call_id] = 'NOT REFUSED'\n   247\t            except model.SchemaError as error:\n   248\t                out[call_id] = f'SchemaError: {str(error)[:200]}'\n   249\t    return out, all(v.startswith('SchemaError') for v in out.values()) and len(out) == EXPECTED_SUBSTITUTIONS\n   250\t\n   251\t\n   252\tdef main():\n   253\t    folder = Path(sys.argv[1])\n   254\t    result, originals = t1(folder)\n   255\t    result['T1b'], result['T1b pass'] = t1b(originals) if originals else ({}, False)\n   256\t    (folder / 't1-result.json').write_text(json.dumps(result, indent=1, ensure_ascii=False))\n   257\t    summary = {k: v for k, v in result.items() if k not in ('store comparison',)}\n   258\t    print(json.dumps(summary, indent=1, ensure_ascii=False)[:6000])\n   259\t    print(json.dumps({k: ({kk: vv for kk, vv in v.items() if kk != 'columns not compared'} if isinstance(v, dict) else v)\n   260\t                      for k, v in result['store comparison'].items()}, indent=0)[:4000])\n   261\t    sys.exit(0 if result['T1 pass'] and result['T1b pass'] else 1)\n   262\t\n   263\t\n   264\tif __name__ == '__main__':\n   265\t    main()\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_24","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc 'nl -ba docs/research/2026-11-21-citation-lists/t2_offline.py'","aggregated_output":"     1\t\"\"\"T2 and T4 of the citation-only judge's $0 test (DESIGN.md §5; D713).\n     2\t\n     3\tT2 (evidence from the archived text): for every stored judge request of old-1, old-2, old-3 and the two pilot arms' fresh rows, the\n     4\tclosed lists are taken from the request's text (evidence entries, dependency entries, theme entries), judging-v12's format is built\n     5\tfrom them, and the stored answer goes through the real `model.check_schema`. Pass: every committed answer and every valid uncommitted\n     6\tone validates; every refused answer fails on an id. The population is printed.\n     7\t\n     8\tT4: the largest format over those archives and over the sealed D358 archive: evidence ids, enum values with the shared evidence enum\n     9\tcounted once and counted per reference, and characters, against the provider's documented limits.\n    10\t\n    11\t  python3 t2_offline.py\n    12\t\"\"\"\n    13\timport json\n    14\timport re\n    15\timport sqlite3\n    16\timport sys\n    17\tfrom pathlib import Path\n    18\t\n    19\tHERE = Path(__file__).resolve().parent\n    20\tREPO = HERE.parents[2]\n    21\tsys.path.insert(0, str(REPO / 'src'))\n    22\tfrom hivemind import model                                              # noqa: E402\n    23\tfrom hivemind.views import judging                                     # noqa: E402\n    24\t\n    25\tRUN = REPO / 'poc/data/comparison-2026-11-17/run'\n    26\tPILOT_COPIES = Path('/private/tmp/claude-501/-Users-lchingen-hivemind/f1ea972d-85a1-4f27-8010-cf0b60054109/scratchpad')\n    27\tPILOT_TOP = 8737                                                        # the pilots' archives copy old-2's rows up to this call\n    28\tSOURCES = [('old-1', RUN / 'old-1/prod', 0), ('old-2', RUN / 'old-2/prod', 0), ('old-3', RUN / 'old-3/prod', 0),\n    29\t           ('control-1', PILOT_COPIES / 'control-1-copy', PILOT_TOP), ('linked-1', PILOT_COPIES / 'linked-1-copy', PILOT_TOP)]\n    30\tSEALED = REPO / 'poc/data/sealed-2026-10-28-v34-nvda-3m-through-0828/archive.sqlite'\n    31\tPUSH_ENUM_VALUES = 6                                                    # the two existing 3-value push enums\n    32\tPROVIDER_ENUM_LIMIT = 1000\n    33\tRETRY_MARK = '\\n\\nThe code returned the previous answer because: '\n    34\t\n    35\t\n    36\tdef dependencies_shown_in(user):\n    37\t    block = user.split('\\n[Current conclusions of the theses it depends on]', 1)\n    38\t    return set(re.findall(r'^- (v\\d+) \\(', block[1].split('\\n\\n[', 1)[0], re.M)) if len(block) == 2 else set()\n    39\t\n    40\t\n    41\tdef lists_from_text(user):\n    42\t    return {'evidence': sorted(judging.evidence_shown_in(user)), 'dependencies': sorted(dependencies_shown_in(user)),\n    43\t            'themes': sorted(judging.themes_shown_in(user))}\n    44\t\n    45\t\n    46\tdef size(lists, schema):\n    47\t    e, d, t = len(lists['evidence']), len(lists['dependencies']), len(lists['themes'])\n    48\t    return {'evidence': e, 'enum values, shared enum counted once': e + d + t + PUSH_ENUM_VALUES,\n    49\t            'enum values, counted per reference': 2 * e + d + t + PUSH_ENUM_VALUES, 'format chars': len(json.dumps(schema))}\n    50\t\n    51\t\n    52\tdef t2():\n    53\t    population = {'archive rows': 0, 'distinct request-answer pairs': 0, 'committed': 0, 'refused': 0, 'valid uncommitted': 0}\n    54\t    failures, refused_detail, seen, sizes, open_chars = [], [], set(), [], []\n    55\t    open_format_chars = len(json.dumps(judging.schema_for('judging-v7')))\n    56\t    for label, folder, top in SOURCES:\n    57\t        archive = sqlite3.connect(f'file:{folder / \"archive.sqlite\"}?mode=ro', uri=True)\n    58\t        views = sqlite3.connect(f'file:{folder / \"views.sqlite\"}?mode=ro', uri=True)\n    59\t        committed_calls = {r[0] for r in views.execute('select call_id from judgements')}\n    60\t        for call_id, sha, request_json, answer_json in archive.execute(\n    61\t                \"select call_id, request_sha256, request_json, answer_json from model_calls where purpose='judge' and call_id>? order by call_id\", (top,)):\n    62\t            population['archive rows'] += 1\n    63\t            request = json.loads(request_json)\n    64\t            user = request['messages'][1]['content']\n    65\t            pair = (sha.split(':')[0], answer_json)\n    66\t            if pair in seen:\n    67\t                continue\n    68\t            seen.add(pair)\n    69\t            population['distinct request-answer pairs'] += 1\n    70\t            lists = lists_from_text(user.split(RETRY_MARK, 1)[0])        # a retry carries the first request's text, then the note\n    71\t            schema = judging.schema_for('judging-v12', lists)\n    72\t            sizes.append(size(lists, schema))\n    73\t            errors = model.check_schema(json.loads(answer_json), schema)\n    74\t            refused = ':refused:' in sha or ':schema:' in sha\n    75\t            if refused:\n    76\t                population['refused'] += 1\n    77\t                refused_detail.append({'source': label, 'call': call_id, 'format errors': errors[:3]})\n    78\t                if not errors:\n    79\t                    failures.append({'source': label, 'call': call_id, 'why': 'a refused answer passes the closed format'})\n    80\t            else:\n    81\t                population['committed' if call_id in committed_calls else 'valid uncommitted'] += 1\n    82\t                if errors:\n    83\t                    failures.append({'source': label, 'call': call_id, 'why': errors[:3]})\n    84\t    chars = sorted(s['format chars'] for s in sizes)\n    85\t    return {'population': population, 'T2 failures': failures, 'refused answers and their format errors': refused_detail,\n    86\t            'T2 pass': not failures and population['refused'] > 0,\n    87\t            'format chars': {'judging-v7': open_format_chars, 'v12 median': chars[len(chars) // 2], 'v12 max': chars[-1]},\n    88\t            'largest (T4)': max(sizes, key=lambda s: s['evidence'])}\n    89\t\n    90\t\n    91\tdef t4_sealed():\n    92\t    archive = sqlite3.connect(f'file:{SEALED}?mode=ro', uri=True)\n    93\t    sizes = []\n    94\t    for (request_json,) in archive.execute(\"select request_json from model_calls where purpose='judge'\"):\n    95\t        user = json.loads(request_json)['messages'][1]['content']\n    96\t        lists = lists_from_text(user)\n    97\t        sizes.append(size(lists, judging.schema_for('judging-v12', lists)))\n    98\t    over_once = sum(s['enum values, shared enum counted once'] > PROVIDER_ENUM_LIMIT for s in sizes)\n    99\t    over_twice = sum(s['enum values, counted per reference'] > PROVIDER_ENUM_LIMIT for s in sizes)\n   100\t    return {'requests': len(sizes), 'largest': max(sizes, key=lambda s: s['evidence']),\n   101\t            f'over {PROVIDER_ENUM_LIMIT} with the shared enum counted once': over_once,\n   102\t            f'over {PROVIDER_ENUM_LIMIT} counted per reference': over_twice}\n   103\t\n   104\t\n   105\tdef main():\n   106\t    result = t2()\n   107\t    result['T4 sealed D358 archive'] = t4_sealed()\n   108\t    (HERE / 't2-result.json').write_text(json.dumps(result, indent=1, ensure_ascii=False))\n   109\t    print(json.dumps({k: v for k, v in result.items() if k != 'refused answers and their format errors'}, indent=1, ensure_ascii=False))\n   110\t    for row in result['refused answers and their format errors']:\n   111\t        print(row['source'], row['call'], row['format errors'][:1])\n   112\t    sys.exit(0 if result['T2 pass'] else 1)\n   113\t\n   114\t\n   115\tif __name__ == '__main__':\n   116\t    main()\n","exit_code":0,"status":"completed"}}
