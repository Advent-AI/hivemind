{"type":"item.completed","item":{"id":"item_46","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"PYTHONPATH=src:scripts:tests python3 -B -c '\nimport importlib.util, json, pathlib, sqlite3, unittest.mock as mock\nfrom hivemind import config, model\np=pathlib.Path('\\\\''docs/research/2026-11-21-citation-lists/t1_replay.py'\\\\'')\ns=importlib.util.spec_from_file_location('\\\\''t1'\\\\'',p); t=importlib.util.module_from_spec(s); s.loader.exec_module(t)\ndef ro(path): return sqlite3.connect(f'\\\\''file:{path.resolve()}?mode=ro&immutable=1'\\\\'',uri=True)\nrun2=pathlib.Path('\\\\''poc/data/citation-t1-2026-11-21-run2/views.sqlite'\\\\'')\nbase=ro(t.OLD2/'\\\\''views.sqlite'\\\\'')\nsaved=ro(run2)\nscratch=sqlite3.connect('\\\\'':memory:'\\\\'')\nsaved.backup(scratch)\nwith mock.patch.object(t.sqlite3,'\\\\''connect'\\\\'',side_effect=[scratch,base]):\n    control=t.compare_stores(run2)\nfor name, in list(scratch.execute(\\\"select name from sqlite_master where type='\\\\''trigger'\\\\'' and tbl_name='\\\\''judgements'\\\\'' and upper(sql) like '\\\\''%BEFORE UPDATE%'\\\\''\\\")):\n    scratch.execute('\\\\''drop trigger \\\"'\\\\''+name.replace('\\\\''\\\"'\\\\'','\\\\''\\\"\\\"'\\\\'')+'\\\\''\\\"'\\\\'')\nscratch.execute(\\\"update judgements set why_changed=why_changed || '\\\\'' mutation'\\\\'' where judgement_id=(select min(judgement_id) from judgements)\\\")\nwith mock.patch.object(t.sqlite3,'\\\\''connect'\\\\'',side_effect=[scratch,base]):\n    mutated=t.compare_stores(run2)\nprint('\\\\''T1 comparison positive control'\\\\'',control[0],mutated[0],mutated[1]['\\\\''judgements'\\\\'']['\\\\''equal'\\\\''])\nprint('\\\\''WITHOUT ROWID'\\\\'', [name for name, in base.execute(\\\"select name from sqlite_master where upper(sql) like '\\\\''%WITHOUT ROWID%'\\\\''\\\")])\ncfg=config.load('\\\\''poc/config/poc-v121.json'\\\\'')\narchive=model.Archive('\\\\'':memory:'\\\\'')\nfor call_id,it in json.loads((run2.parent/'\\\\''outgoing-refused-originals.json'\\\\'').read_text()).items():\n    req=it['\\\\''request'\\\\'']\n    system,user=(m['\\\\''content'\\\\''] for m in req['\\\\''messages'\\\\''])\n    schema=req['\\\\''response_format'\\\\'']['\\\\''json_schema'\\\\'']['\\\\''schema'\\\\'']\n    try:\n        model.call(archive,cfg,cfg.rejudging,system,user,schema,'\\\\''judgement'\\\\'','\\\\''judge'\\\\'',transport=lambda provider,sent:{'\\\\''choices'\\\\'':[{'\\\\''message'\\\\'':{'\\\\''content'\\\\'':it['\\\\''answer'\\\\'']}}]})\n        raise AssertionError(call_id)\n    except model.SchemaError as err:\n        print(call_id,str(err).split('\\\\'' not in '\\\\'')[0])\n'\"","aggregated_output":"T1 comparison positive control True False False\nWITHOUT ROWID ['groups_fts_idx', 'groups_fts_config', 'views_fts_idx', 'views_fts_config']\n591 $.cites[8]: 'e88'\n6955 $.pushes[18].evidence_id: 'e3955'\n7068 $.cites[9]: 'v10'\n7774 $.cites[2]: 'e3998'\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_47","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"PYTHONPATH=src:scripts:tests python3 -B -c '\nimport importlib.util,pathlib,sqlite3,sys,unittest.mock as mock\nimport preflight\nfrom hivemind import model\nimport test_citation_lists as tc\nimport test_frozen_questions_and_judgement as f\ntests=[f.test_the_frozen_question_and_judgement_prompt_files_are_unchanged,\n       f.test_the_code_written_parts_of_the_question_and_judgement_requests_are_unchanged,\n       f.test_the_linking_version_pins_its_questions_and_keeps_the_judge_schema,\n       f.test_the_citation_version_pins_its_closed_format_and_leaves_the_frozen_formats_alone,\n       tc.test_every_id_field_takes_only_its_listed_ids_through_the_real_validator]\nfor test in tests: test()\nprint(len(tests),'\\\\''standalone assertions passed'\\\\'')\noriginal_connect=sqlite3.connect\nfor status,answer in [('\\\\''refused'\\\\'','\\\\''{}'\\\\''),('\\\\''malformed'\\\\'',None)]:\n    db=original_connect('\\\\'':memory:'\\\\'')\n    db.executescript(model.SCHEMA_SQL)\n    db.execute('\\\\''insert into model_calls (purpose,request_sha256,request_json,answer_json,config_version,config_checksum,model,prompt_chars,input_tokens,output_tokens,cost_usd,seconds,created_at) values(?,?,?,?,?,?,?,?,?,?,?,?,?)'\\\\'',\n               ('\\\\''judge'\\\\'','\\\\''a'\\\\''*64+'\\\\'':'\\\\''+status+'\\\\'':1'\\\\'','\\\\''{}'\\\\'',answer,'\\\\''poc-v121'\\\\'','\\\\''x'\\\\'','\\\\''gpt-6-luna'\\\\'',0,0,0,0,0,'\\\\''2026-11-21T20:00:00'\\\\''))\n    with mock.patch.object(preflight.sqlite3,'\\\\''connect'\\\\'',return_value=db), mock.patch.object(preflight.testdb,'\\\\''open_db'\\\\''), mock.patch.object(preflight,'\\\\''store_copies'\\\\'',return_value=[]), mock.patch.object(preflight,'\\\\''part_b'\\\\'',return_value=1), mock.patch.object(preflight,'\\\\''part_c'\\\\'',return_value=1), mock.patch.object(preflight,'\\\\''part_d'\\\\'',return_value=1), mock.patch.object(preflight,'\\\\''part_e'\\\\''), mock.patch.object(sys,'\\\\''argv'\\\\'',['\\\\''preflight.py'\\\\'']):\n        try:\n            preflight.main()\n        except SystemExit as exc:\n            print(status, '\\\\''exit'\\\\'',exc.code)\n        else:\n            print(status,'\\\\''exit 0'\\\\'')\np=pathlib.Path('\\\\''docs/research/2026-11-21-citation-lists/t2_offline.py'\\\\'')\ns=importlib.util.spec_from_file_location('\\\\''t2'\\\\'',p); t=importlib.util.module_from_spec(s);s.loader.exec_module(t)\nrun2=pathlib.Path('\\\\''poc/data/citation-t1-2026-11-21-run2'\\\\'')\nfor label,folder,top in t.SOURCES+[('\\\\''run2'\\\\'',run2,0)]:\n    d=original_connect(f'\\\\''file:{(folder/\\\"archive.sqlite\\\").resolve()}?mode=ro&immutable=1'\\\\'',uri=True)\n    rows=list(d.execute(\\\"select request_sha256,answer_json,request_json from model_calls where purpose='\\\\''judge'\\\\'' and call_id>? and (request_sha256 like '\\\\''%:schema:%'\\\\'' or request_sha256 like '\\\\''%:malformed:%'\\\\'' or request_sha256 like '\\\\''%:refused:%'\\\\'')\\\",(top,)))\n    malformed=[sha for sha,answer,req in rows if '\\\\'':malformed:'\\\\'' in sha or not answer]\n    missing=[sha for sha,answer,req in rows if preflight.saved_judge_format(req) is None]\n    print(label,len(rows),'\\\\''flagged'\\\\'',len(malformed),'\\\\''no usable answer'\\\\'',len(missing),'\\\\''missing format'\\\\'')\n'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
