'e2989', 'e3108', 'e3110', 'e3112', 'e3593', 'e3620', 'e3683', 'e3883', 'e3942', 'e3943', 'e4049', 'e4164', 'e4165', 'e4197', 'e4224', 'e4226', 'e4227', 'e966']\"]\nlinked-1 8777 [\"$.cites[5]: 'e693' not in ['e442', 'e443', 'e475', 'e489', 'e584', 'e596', 'e597', 'e612', 'e664', 'e665', 'e666', 'e667', 'e668', 'e676', 'e679', 'e681', 'e689', 'e694', 'e715', 'e723', 'e724', 'e725', 'e793', 'e794', 'e795']\"]\nlinked-1 8822 [\"$.cites[15]: 'v14' not in ['e1018', 'e1338', 'e443', 'e489', 'e612', 'e664', 'e666', 'e667', 'e668', 'e694', 'e715', 'e723', 'e724', 'e793', 'e794', 'e813', 'e814', 'e884', 'e885', 'e886', 'e887', 'e896', 'e897']\"]\nlinked-1 8848 [\"$.cites_views[1]: 'v5' not in ['v8']\"]\nlinked-1 8855 [\"$.cites[16]: 'v14' not in ['e1018', 'e1338', 'e1473', 'e443', 'e489', 'e612', 'e664', 'e666', 'e667', 'e668', 'e694', 'e715', 'e723', 'e724', 'e793', 'e794', 'e813', 'e814', 'e884', 'e885', 'e886', 'e887', 'e896', 'e897']\"]\nlinked-1 8888 [\"$.cites_views[1]: 'v5' not in ['v14']\"]\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_30","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba scripts/preflight.py | sed -n '28,100p;320,390p'; sed -n '10685,10730p' docs/DECISIONS-log.md\"","aggregated_output":"    28\tfrom pathlib import Path\n    29\t\n    30\tROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))\n    31\tsys.path.insert(0, os.path.join(ROOT, 'src'))\n    32\tfrom hivemind import config, extraction, live_lock, model, testdb, universe, vocabulary  # noqa: E402\n    33\tfrom hivemind.views import judging, matching  # noqa: E402\n    34\t\n    35\tSCHEMAS = {'extract': extraction.schema_for(extraction.SUPPORTED_VERSIONS[0]), 'match': matching.SCHEMA, 'judge': judging.schema_for(judging.SUPPORTED_VERSIONS[0])}\n    36\t# the stored requests of both prompt languages (D163): Chinese headers up to extraction v5 / matching-v1, English from v6 / matching-v2\n    37\tITEM_ID = re.compile(r'【信息】编号 (\\S+?)，类别 |\\[Item\\] id (\\S+?), category ')\n    38\tMATCH_SHOWN = re.compile(r'^· (v\\d+)\\s?[（(]', re.M)\n    39\tJEV_ASKED = re.compile(r'\\b(v\\d+): ')          # a Jev candidate reason names every thesis it was asked about: 'jev: v1: different 0.55; …'\n    40\t\n    41\t\n    42\tdef normalise_reason(text):\n    43\t    text = re.sub(r\"'[^']*'\", \"'…'\", text)\n    44\t    text = re.sub(r'\\[\\d+\\]', '[]', text)\n    45\t    text = re.sub(r'\\b[ev]\\d+\\b|\\bc\\d+\\b', '#', text)\n    46\t    text = re.sub(r'\\d{4}-\\d{2}-\\d{2}', 'DATE', text)\n    47\t    return text[:90]\n    48\t\n    49\t\n    50\tdef tally(title, judged, refused, reasons, examples):\n    51\t    share = f'{refused / judged:.0%}' if judged else 'n/a'\n    52\t    print(f'\\n== {title}: judged {judged}, refused/dropped {refused} ({share})')\n    53\t    for reason, count in reasons.most_common(20):\n    54\t        print(f'   {count:5d}  {reason}')\n    55\t        for example in examples.get(reason, [])[:2]:\n    56\t            print(f'          e.g. {example}')\n    57\t\n    58\t\n    59\tdef saved_judge_format(request_json):\n    60\t    \"\"\"The answer format a judge request was sent with (judging-v12's differs per request, D713), or None when the row has none.\"\"\"\n    61\t    try:\n    62\t        return ((json.loads(request_json or '{}').get('response_format') or {}).get('json_schema') or {}).get('schema')\n    63\t    except (json.JSONDecodeError, AttributeError):\n    64\t        return None\n    65\t\n    66\t\n    67\tdef part_a(archive_conn):\n    68\t    \"\"\"(answers judged, judge rows without a saved format). Judge rows are checked against the format saved with their own request;\n    69\t    extraction and matching rows against their fixed schema.\"\"\"\n    70\t    reasons, examples, judged, missing = collections.Counter(), collections.defaultdict(list), 0, []\n    71\t    rows = archive_conn.execute(\"select purpose, request_sha256, answer_json, request_json from model_calls where request_sha256 like '%:schema:%' or request_sha256 like '%:malformed:%' or request_sha256 like '%:refused:%'\")\n    72\t    for purpose, sha, answer_json, request_json in (tuple(r) for r in rows):\n    73\t        judged += 1\n    74\t        if ':malformed:' in sha or not answer_json:\n    75\t            reasons[f'{purpose}: not JSON'] += 1\n    76\t            continue\n    77\t        schema = SCHEMAS.get(purpose, {})\n    78\t        if purpose == 'judge':\n    79\t            schema = saved_judge_format(request_json)\n    80\t            if schema is None:\n    81\t                missing.append(sha)\n    82\t                reasons['judge: no saved answer format'] += 1\n    83\t                continue\n    84\t        for error in model.check_schema(json.loads(answer_json), schema):\n    85\t            key = f'{purpose}: {normalise_reason(error)}'\n    86\t            reasons[key] += 1\n    87\t            examples[key].append(error[:140])\n    88\t    tally('A. answers the schema refused (prompt/schema disagreements; empty when the provider enforces the schema server-side)', judged, judged, reasons, examples)\n    89\t    return judged, missing\n    90\t\n    91\t\n    92\tclass Unverifiable(Exception):\n    93\t    \"\"\"A stored request of a retired version, or whose configuration file is gone: counted and named in the output, not replayed,\n    94\t    and not a failure of the archive.\"\"\"\n    95\t\n    96\t\n    97\tdef _preflight_extract_inputs(request, item, cfg):\n    98\t    \"\"\"Validate the stored source and recover exactly the question ids production showed (its [Open questions] block).\"\"\"\n    99\t    setting = cfg.extraction_setting(item['category'])\n   100\t    version = setting.prompt_version.rpartition('-')[2]\n   320\t    judged = 0\n   321\t    for path in views_paths:\n   322\t        conn = sqlite3.connect(f'file:{path}?mode=ro', uri=True)\n   323\t        conn.row_factory = sqlite3.Row\n   324\t        tables = {r[0] for r in conn.execute(\"select name from sqlite_master where type='table'\")}\n   325\t        if 'view_keys' not in tables:\n   326\t            print(f'\\n== E. keyed views in {os.path.basename(path)}: unkeyed ledger (written before keys)')\n   327\t            continue\n   328\t        open_ids = {r[0] for r in conn.execute('select view_id from view_switches where id in (select max(id) from view_switches group by view_id) and open=1')}\n   329\t        keys = collections.defaultdict(list)\n   330\t        for r in conn.execute('select k.*, v.object_id from view_keys k join views v on v.view_id=k.view_id'):\n   331\t            if r['view_id'] in open_ids:\n   332\t                keys[(r['object_id'], r['measure'], r['scope_key'], r['period_start'], r['period_end'], r['basis'], r['unit'], r['event_type'])].append(r['view_id'])\n   333\t        keyed = sum(len(v) for v in keys.values())\n   334\t        collisions = {k: v for k, v in keys.items() if len(v) > 1}\n   335\t        pool = conn.execute(\"select count(*) from review_pool_entries where kind='candidate_outside_watch'\").fetchone()[0]\n   336\t        judged += keyed\n   337\t        print(f'\\n== E. keyed views in {os.path.basename(path)}: open views {len(open_ids)}, keyed {keyed}, duplicate keys {len(collisions)} groups, review pool {pool} candidates outside the watch list')\n   338\t        for k, v in list(collisions.items())[:10]:\n   339\t            print(f'      {k[:3]} {k[3]}..{k[4]} → {v}')\n   340\t    return judged\n   341\t\n   342\t\n   343\tdef main():\n   344\t    parser = argparse.ArgumentParser()\n   345\t    frozen_draw = os.path.join(ROOT, 'poc', 'data', 'e2e-r9-frozen-v108-2026-11-03', 'd1')\n   346\t    parser.add_argument('--archive', default=os.path.join(frozen_draw, 'archive.sqlite'))\n   347\t    parser.add_argument('--items', default=os.path.join(ROOT, 'poc', 'data', 'items-nvda-2026-07-01-10-27.sqlite'))\n   348\t    parser.add_argument('--views', nargs='*', default=None)\n   349\t    parser.add_argument('--universe', default=os.path.join(ROOT, 'poc', 'universe.json'))\n   350\t    args = parser.parse_args()\n   351\t    views_paths = args.views or [os.path.join(frozen_draw, 'views.sqlite')]\n   352\t    archive_conn = sqlite3.connect(f'file:{args.archive}?mode=ro', uri=True)\n   353\t    archive_conn.row_factory = sqlite3.Row\n   354\t    items_conn = testdb.open_db(args.items)\n   355\t    uni = universe.load(args.universe)\n   356\t    print('preflight over', args.archive, 'and', len(views_paths), 'views databases:', ', '.join(os.path.basename(os.path.dirname(p)) for p in views_paths))\n   357\t    _, missing_formats = part_a(archive_conn)\n   358\t    copies = store_copies(views_paths)\n   359\t    counts = [part_b(archive_conn, items_conn, uni), part_c(archive_conn, copies, uni), part_d()]\n   360\t    part_e(copies)          # informational for unkeyed ledgers; judged counts are reported per ledger\n   361\t    if missing_formats:\n   362\t        print(f'\\nFAILED: {len(missing_formats)} refused judge rows carry no saved answer format, so part A could not check them: '\n   363\t              + ', '.join(sha[:24] for sha in missing_formats[:10]))\n   364\t        sys.exit(1)\n   365\t    if min(counts) == 0:\n   366\t        print('\\nUNEXERCISED: a check judged no case')\n   367\t        sys.exit(1)\n   368\t    print('\\npreflight done')\n   369\t\n   370\t\n   371\tif __name__ == '__main__':\n   372\t    main()\n  - A separate design, not part of this version: the link direction (a whole reading its own part). The keys label stand-alone CPU\n    `other`, and the direction is a judgement, which D704 left open on purpose.\n- **Not done:** no paid call after the pilot, no product file changed.\n\n## D712 · 2026-11-21 · Alex opens a citation-only judge version (closed per-request id lists), tested at $0 first\n\n- **The question:** \"试点到此收尾（结论\"说不准\"，花了 1.70 美元）。发现了两个问题：一是模型常写出不在名单上的编号，回答因此被退回，这次对照组就是因为这个停下；二是新版本让\"总收入\"把 CPU 收入又加了一遍。下一步做哪个？\"\n  Options: 开引用格式新版本 (recommended: every id field of the judge's answer takes a closed list built from the request; $0 check on\n  stored data that accepted answers still pass and the bad ids are excluded; asking again before any paid test); 先设计重复计算的修法;\n  先停在这里.\n- **Alex's answer** (2026-11-21): \"开引用格式新版本 (推荐)\".\n- **Scope:** a new judge version whose only change is the answer format's id fields (D711's recommendation). The link direction stays\n  a separate design. Design, then council review, then build with tests and mutants, then the $0 test; any paid test asks Alex again.\n\n## D713 · 2026-11-21 · Council R passes the citation-only judge design (round 38, four passes); build judging-v12 and poc-v121 with the $0 test\n\n- **Design:** `docs/research/2026-11-21-citation-lists/DESIGN.md` v3.\n  - `judging-v12` keeps judging-v7's text and request; its four id fields take closed lists built from the rows that render the\n    request (one shared `$defs` evidence enum, plain dependency and theme enums, `maxItems: 0` for an empty list).\n  - Under v12, `check_answer` uses the same lists.\n  - `model.check_schema` gains `maxItems`.\n  - Preflight checks judge rows against their saved format and fails on a judge row without one.\n  - `poc-v121` = poc-v118 with judging-v12. No v8-based version.\n  - No pre-send size rule: an HTTP 400 is the visible stop.\n- **Council** (`codex-r38.md` … `codex-r38d.md`, `claude-r38.md`), one round each:\n  - 38, NOT READY: the format-error path; preflight; the D358 sizes (the sealed run's 647-id request needs 1,323 plain enum values);\n    lists from the rows, not parsed text; the name `judging-v9` already used; T1's mechanics.\n  - 38b, NOT READY: two owners of membership (a footnote in a quote makes the text parser narrow the list); preflight for judge rows\n    only; the v7/v8 prompt hook; T1's assertions.\n  - 38c, NOT READY: T1 must compare the lists' ids; a real v12 retry test; preflight must fail on a missing format.\n  - 38d: READY TO BUILD.\n- **Also recorded:** the same id-membership class halted the sealed three-month run (D358, 2026-10-28). The v7/v8 text parser can\n  narrow its allowed set (a finding; frozen versions unchanged).\n- **Next:** the build, its tests and mutants, and the $0 test T1–T5 as registered in DESIGN.md §5. Any paid step (provider acceptance;\n  whether the judge picks the intended source) asks Alex again (D712).\n","exit_code":0,"status":"completed"}}
