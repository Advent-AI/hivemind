{"type":"item.started","item":{"id":"item_51","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"PYTHONPATH=src python3 -B -c '\nimport contextlib, importlib.util, io, json, pathlib, sys, unittest.mock as mock\np=pathlib.Path('\\\\''docs/research/2026-11-21-citation-lists/t1_replay.py'\\\\'')\ns=importlib.util.spec_from_file_location('\\\\''t1'\\\\'',p); t=importlib.util.module_from_spec(s); s.loader.exec_module(t)\nrun=pathlib.Path('\\\\''poc/data/citation-t1-2026-11-21-run2'\\\\'')\nresult=json.loads((run/'\\\\''t1-result.json'\\\\'').read_text())\nprinted=io.StringIO()\nwith mock.patch.object(sys,'\\\\''argv'\\\\'',[str(p),str(run)]), mock.patch.object(t,'\\\\''t1'\\\\'',return_value=(result,{'\\\\''stored originals'\\\\'':True})), mock.patch.object(t,'\\\\''t1b'\\\\'',return_value=(result['\\\\''T1b'\\\\''],result['\\\\''T1b pass'\\\\''])), mock.patch.object(pathlib.Path,'\\\\''write_text'\\\\'') as write, contextlib.redirect_stdout(printed):\n    try: t.main()\n    except SystemExit as e: status=e.code\n    assert json.loads(write.call_args.args[0])==result\nprint('\\\\''current T1 reporter on saved results: exit'\\\\'',status,'\\\\''comparison summary printed'\\\\'', '\\\\''\\\"tables only in the replay\\\"'\\\\'' in printed.getvalue())\n'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
