{"type":"item.completed","item":{"id":"item_39","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba src/hivemind/model.py | sed -n '45,160p'; ls -lT docs/research/2026-11-21-citation-lists/{t1_replay.py,t1-replay.log,RESULT.md}; ls -lah poc/data/citation-t1-2026-11-21\"","aggregated_output":"    45\tcreate index if not exists model_calls_sha on model_calls(request_sha256);\n    46\t\"\"\"\n    47\t\n    48\t\n    49\tclass SchemaError(ValueError):\n    50\t    pass\n    51\t\n    52\t\n    53\tclass TransportError(RuntimeError):\n    54\t    pass\n    55\t\n    56\t\n    57\t@dataclasses.dataclass\n    58\tclass Answer:\n    59\t    data: dict\n    60\t    call_id: int\n    61\t    request_sha256: str\n    62\t    cached: bool\n    63\t    prompt_chars: int\n    64\t    input_tokens: int\n    65\t    output_tokens: int\n    66\t    cost_usd: float\n    67\t\n    68\t\n    69\tclass Archive:\n    70\t    \"\"\"Shared by the extraction worker threads: one connection, every access under a lock.\"\"\"\n    71\t\n    72\t    def __init__(self, path):\n    73\t        os.makedirs(os.path.dirname(os.path.abspath(path)), exist_ok=True)\n    74\t        self.conn = sqlite3.connect(path, check_same_thread=False)\n    75\t        self.conn.executescript(SCHEMA_SQL)\n    76\t        import threading\n    77\t        self.lock = threading.Lock()\n    78\t\n    79\t    def lookup(self, sha):\n    80\t        with self.lock:\n    81\t            return self.conn.execute('select call_id, answer_json, prompt_chars, input_tokens, output_tokens from model_calls where request_sha256=?', (sha,)).fetchone()\n    82\t\n    83\t    def record(self, **fields):\n    84\t        \"\"\"One row per distinct request; a second identical request recorded at the same moment (two threads, or a\n    85\t        failed answer repeated within the same second) keeps the first row's id instead of failing.\"\"\"\n    86\t        columns = list(fields)\n    87\t        with self.lock:\n    88\t            cursor = self.conn.execute(f'insert or ignore into model_calls ({\",\".join(columns)}) values ({\",\".join(\"?\" * len(columns))})',\n    89\t                                       [fields[c] for c in columns])\n    90\t            self.conn.commit()\n    91\t            if cursor.rowcount == 0:\n    92\t                return self.conn.execute('select call_id from model_calls where request_sha256=?', (fields['request_sha256'],)).fetchone()[0]\n    93\t            return cursor.lastrowid\n    94\t\n    95\t    def retire(self, call_id):\n    96\t        \"\"\"A code check refused this answer: the row stays for the record, but no later identical request is answered with it\n    97\t        (the same shape as a schema-refused or malformed row, whose hash carries a suffix).\"\"\"\n    98\t        with self.lock:\n    99\t            self.conn.execute(\"update model_calls set request_sha256 = request_sha256 || ':refused:' || ? where call_id=? and request_sha256 not like '%:refused:%'\",\n   100\t                              (uuid.uuid4().hex[:8], call_id))\n   101\t            self.conn.commit()\n   102\t\n   103\t    def totals(self):\n   104\t        with self.lock:\n   105\t            return self.conn.execute('select count(*), coalesce(sum(cost_usd),0), coalesce(sum(input_tokens),0), coalesce(sum(output_tokens),0) from model_calls').fetchone()\n   106\t\n   107\t\n   108\tdef _key(provider):\n   109\t    name = ENDPOINTS[provider][1]\n   110\t    if os.environ.get(name):\n   111\t        return os.environ[name]\n   112\t    with open(CREDENTIALS, encoding='utf-8') as handle:\n   113\t        return json.load(handle)[name]\n   114\t\n   115\t\n   116\tdef build_request(setting, system, user, schema, schema_name, provider):\n   117\t    request = {\n   118\t        'model': setting.model,\n   119\t        'messages': [{'role': 'system', 'content': system}, {'role': 'user', 'content': user}],\n   120\t        'response_format': {'type': 'json_schema', 'json_schema': {'name': schema_name, 'strict': True, 'schema': schema}},\n   121\t    }\n   122\t    if provider == 'openai':\n   123\t        request['max_completion_tokens'] = setting.max_output_tokens\n   124\t        if setting.reasoning_effort:\n   125\t            request['reasoning_effort'] = setting.reasoning_effort\n   126\t    else:\n   127\t        request['max_tokens'] = setting.max_output_tokens\n   128\t    return request\n   129\t\n   130\t\n   131\tdef openai_transport(provider, request, timeout=180, max_attempts=3):   # the default preserves the production retry behavior\n   132\t    url, _ = ENDPOINTS[provider]\n   133\t    body = json.dumps(request).encode('utf-8')\n   134\t    headers = {'Authorization': f'Bearer {_key(provider)}', 'Content-Type': 'application/json'}\n   135\t    last = None\n   136\t    last_http = None\n   137\t    if isinstance(max_attempts, bool) or not isinstance(max_attempts, int) or max_attempts < 1:\n   138\t        raise ValueError('max_attempts must be a positive integer')\n   139\t    for attempt in range(max_attempts):\n   140\t        try:\n   141\t            with urllib.request.urlopen(urllib.request.Request(url, data=body, headers=headers, method='POST'), timeout=timeout) as response:\n   142\t                raw_bytes = response.read()\n   143\t                try:\n   144\t                    raw = raw_bytes.decode('utf-8')\n   145\t                except UnicodeDecodeError:\n   146\t                    if max_attempts != 1:\n   147\t                        raise\n   148\t                    failure = TransportError('invalid UTF-8 HTTP response')\n   149\t                    failure.response_body = raw_bytes.decode('utf-8', 'replace')\n   150\t                    failure.response_body_base64 = base64.b64encode(raw_bytes).decode('ascii')\n   151\t                    failure.http_status = response.status\n   152\t                    raise failure\n   153\t                try:\n   154\t                    return json.loads(raw)\n   155\t                except json.JSONDecodeError:\n   156\t                    if max_attempts != 1:\n   157\t                        raise\n   158\t                    failure = TransportError('malformed HTTP response')\n   159\t                    failure.response_body = raw\n   160\t                    failure.http_status = response.status\n-rw-r--r--@ 1 lchingen  staff   6566 Nov 21 17:30:29 2026 docs/research/2026-11-21-citation-lists/RESULT.md\n-rw-r--r--@ 1 lchingen  staff   2379 Nov 21 17:29:09 2026 docs/research/2026-11-21-citation-lists/t1-replay.log\n-rw-r--r--@ 1 lchingen  staff  15396 Nov 21 17:29:30 2026 docs/research/2026-11-21-citation-lists/t1_replay.py\ntotal 588152\ndrwxr-xr-x@   4 lchingen  staff   128B Nov 21 17:21 .\ndrwxr-xr-x@ 235 lchingen  staff   7.3K Nov 21 17:23 ..\n-rw-r--r--@   1 lchingen  staff   269M Nov 21 17:21 archive.sqlite\n-rw-r--r--@   1 lchingen  staff    18M Nov 21 17:21 views.sqlite\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_40","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"sed -n '1,90p' tests/test_theme_block.py; rg -n 'def open_db|def open_store|def open\\\\(' src/hivemind/views/store.py; sed -n '282,319p' scripts/preflight.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_40","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"sed -n '1,90p' tests/test_theme_block.py; rg -n 'def open_db|def open_store|def open\\\\(' src/hivemind/views/store.py; sed -n '282,319p' scripts/preflight.py\"","aggregated_output":"\"\"\"D195 (the theme block, design.md §8): an asset thesis is judged with every open, judged theme thesis in\nview and answers which way each one it weighed pushes it; theme theses are judged before asset theses in a round; a changed\ntheme conclusion queues every open asset thesis once; the round's queue is derived from the ledger, so a resumed round recovers\nwhat an earlier commit had queued. Real ledger on a temporary path; the model is a scripted transport.\"\"\"\nimport dataclasses\nimport json\nimport os\nimport sys\nimport types\n\nROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))\nsys.path.insert(0, os.path.join(ROOT, 'src'))\nfrom hivemind import config, model, service  # noqa: E402\nfrom hivemind.views import judging, store  # noqa: E402\n\nDAY = {'input_id': 'day:2026-07-29', 'publication_day': '2026-07-29'}\nASSET_RUNGS = [{'label': 'Strongly bullish', 'condition': '>=80'}, {'label': 'Bullish', 'condition': '77-80'}, {'label': 'Neutral', 'condition': '73-77'},\n               {'label': 'Bearish', 'condition': '70-73'}, {'label': 'Strongly bearish', 'condition': '<70'}]\nTHEME_RUNGS = [{'label': 'Imports allowed', 'condition': 'China permits H200 imports by the due day'}, {'label': 'Not allowed', 'condition': 'no permission by the due day'}]\nV7 = config.load(os.path.join(ROOT, 'poc', 'config', 'poc-v108.json'))\n\n\ndef ledger(tmp_path):\n    \"\"\"One asset thesis (v1, NVDA data-center revenue) and one theme thesis (v2, China H200 permission), both with evidence in force.\"\"\"\n    conn = store.open_db(str(tmp_path / 'views.sqlite'))\n    store.create_view(conn, view_id='v1', object_id='NVDA', object_kind='company', kind='asset', looks_at='FY2027 data center revenue',\n                      question='Where will NVIDIA FY2027 data center revenue land?', due_day='2027-02-24', year='FY2027', rungs=ASSET_RUNGS, seq=1,\n                      input_id='truenorth:transcript:NVDA:2026-02-25', created_at='2026-02-25T22:00:00Z')\n    store.create_view(conn, view_id='v2', object_id='chip-export-controls', object_kind='theme', kind='theme', looks_at='H200 imports into China',\n                      question='Will the Chinese authorities allow any H200 imports into China by January 31, 2027?', due_day='2027-01-31', year='2026',\n                      rungs=THEME_RUNGS, seq=1, input_id='truenorth:transcript:NVDA:2026-02-25', created_at='2026-02-25T22:00:00Z')\n    for evidence_id, view_id, quote in (('e1', 'v1', 'On a full year basis, data center generated revenue of $194 billion.'),\n                                        ('e2', 'v2', 'We do not know whether any imports will be allowed into China.')):\n        store.add_evidence(conn, evidence_id=evidence_id, quote=quote, one_line=quote[:40], speaker='CFO', original_who='NVIDIA', original_day='2026-02-25',\n                           tier='party_statement', event_time='', seq=1, input_id='truenorth:transcript:NVDA:2026-02-25')\n        store.add_source(conn, evidence_id, 'truenorth:transcript:NVDA:2026-02-25', 'T4', '2026-02-25', 'p1', 1)\n        store.link(conn, evidence_id, view_id, 1)\n    conn.commit()\n    return conn\n\n\ndef judged(conn, view_id, rung, reasons, seq, *, changed=True, theme_pushes=None):\n    answer = types.SimpleNamespace(data={'rung': rung, 'reasons': reasons, 'cites': [], 'cites_views': [], 'pushes': [], 'changed': changed,\n                                         'why_changed': 'test', **({'theme_pushes': theme_pushes} if theme_pushes is not None else {})},\n                                   call_id=0, request_sha256='x', cached=False, cost_usd=0.0)\n    judging._record(conn, V7, view_id, seq, DAY, answer)\n\n\ndef scripted(order, answers=None):\n    \"\"\"A transport that records which thesis each judgement request is for and answers 'changed' with the scripted pushes.\"\"\"\n    def send(provider, request):\n        assert request['response_format']['json_schema']['name'] == 'judgement'\n        user = request['messages'][1]['content']\n        view_id = user.split('Thesis ', 1)[1].split(' ', 1)[0]\n        order.append(view_id)\n        data = {'rung': 1, 'reference': 'consensus expects growth', 'implied_outcome': 'revenue above the consensus band', 'reasons': f'scripted for {view_id}', 'cites': [], 'cites_views': [], 'pushes': [], 'changed': True, 'why_changed': 'scripted',\n                'theme_pushes': (answers or {}).get(view_id, [])}\n        return {'choices': [{'message': {'content': json.dumps(data)}}]}\n    return send\n\n\ndef test_an_asset_request_lists_open_judged_theme_theses_and_marks_what_changed_since_its_last_judgement(tmp_path):\n    conn = ledger(tmp_path)\n    _, before = judging.build_prompt(conn, 'v1', 'judging-v7')\n    assert '[Themes in force' not in before                                  # v2 has no judgement yet: nothing to read\n    judged(conn, 'v2', 2, 'No permission has been reported; small U.S. approvals only.', 2)\n    _, user = judging.build_prompt(conn, 'v1', 'judging-v7')\n    assert '[Themes in force, 1]' in user\n    assert '- v2 (chip-export-controls, due 2027-01-31) Will the Chinese authorities allow any H200 imports' in user\n    assert 'now rung 2 Not allowed' in user and 'reasons: No permission has been reported' in user and 'judged 2026-07-29' in user\n    assert 'updated since this thesis was last judged' not in user       # v1 has no judgement yet: there is no \"since\"\n    judged(conn, 'v1', 3, 'first', 2, theme_pushes=[{'view_id': 'v2', 'push': 'toward_last'}])\n    judged(conn, 'v2', 1, 'Permission granted.', 3)\n    _, user = judging.build_prompt(conn, 'v1', 'judging-v7')\n    assert 'now rung 1 Imports allowed' in user and 'updated since this thesis was last judged' in user\n    _, theme_user = judging.build_prompt(conn, 'v2', 'judging-v7')\n    assert '[Themes in force' not in theme_user                           # a theme thesis's own judgement carries no block\n    store.close_view(conn, 'v2', 'due', 'pull', 4)\n    _, user = judging.build_prompt(conn, 'v1', 'judging-v7')\n    assert '[Themes in force' not in user                                 # a closed theme leaves the block\n\n\ndef test_theme_pushes_are_checked_against_the_block_stored_and_served(tmp_path):\n    conn = ledger(tmp_path)\n    judged(conn, 'v2', 2, 'not allowed', 2)\n    schema = judging.schema_for('judging-v7')\n    assert 'theme_pushes' in schema['required'] and schema['properties']['theme_pushes']['items']['properties']['push']['enum'] == ['toward_first', 'toward_last', 'none']\n    base = {'rung': 3, 'reference': 'consensus expects growth', 'implied_outcome': 'revenue above the consensus band', 'reasons': 'r', 'cites': [], 'cites_views': [], 'pushes': [], 'changed': True, 'why_changed': 'first'}\n    assert judging.check_answer(conn, 'v1', dict(base, theme_pushes=[{'view_id': 'v2', 'push': 'toward_last'}])) == []\n    assert judging.check_answer(conn, 'v1', dict(base, theme_pushes=[{'view_id': 'v9', 'push': 'none'}])) == ['v9 is not a theme in force shown to v1']\n57:def open_db(path):\n    unjudged = []\n    for name, ledger_judged, skipped in per_ledger:\n        print(f'       ledger {name}: judged {ledger_judged}, skipped {sum(skipped.values())} {dict(skipped) if skipped else \"\"}')\n        if skipped and not ledger_judged:\n            unjudged.append(name)\n    if unjudged:\n        print(f'NOT JUDGED: every matching record of {unjudged} was skipped; pass the archive these records were written with')\n        return 0\n    return judged\n\n\ndef part_d():\n    \"\"\"Every schema enum value appears in the prompt that asks for it: the extraction role and the judging prompt of the versions the\n    code builds, and every matching prompt against its own version's set (Chinese up to matching-v1, English after).\"\"\"\n    missing = []\n    checks = [(f'role-{v}.txt', extraction.TIERS + vocabulary.KINDS + vocabulary.ASSET_LABELS) for v in extraction.SUPPORTED_VERSIONS]\n    checks += [(f'{v}.txt', judging.PUSHES) for v in judging.SUPPORTED_VERSIONS]\n    for path in sorted(glob.glob(os.path.join(config.PROMPTS, 'matching-v*.txt'))):\n        version = os.path.basename(path).removesuffix('.txt')\n        checks.append((os.path.basename(path), (matching.OUTCOMES + matching.EVIDENCE_OUTCOMES + vocabulary.DIRECTIONS) if matching.is_english(version)\n                       else (matching.LEGACY_OUTCOMES + matching.LEGACY_EVIDENCE_OUTCOMES)))\n    judged = 0\n    for name, values in checks:\n        text = open(os.path.join(config.PROMPTS, name), encoding='utf-8').read()\n        for value in values:\n            judged += 1\n            if value not in text:\n                missing.append(f'{name} lacks the enum value {value!r}')\n    print(f'\\n== D. schema enum values named in the prompts: judged {judged}, missing {len(missing)}')\n    for line in missing:\n        print('   ', line)\n    return judged\n\n\ndef part_e(views_paths):\n    \"\"\"Keyed ledgers (keyed-views-plan.md 5): how many open views carry a key, how many keys collide among open views (the\n    pipeline's identity rule says none should), and what the watch list sent to the review pool. A ledger written before\n    keys is reported as unkeyed, not failed.\"\"\"\n","exit_code":0,"status":"completed"}}
