{"type":"item.started","item":{"id":"item_35","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"PYTHONPATH=src:scripts python3 -B -c '\nimport collections, importlib.util, json, pathlib, sqlite3\nfrom hivemind import config, model\nfrom hivemind.views import judging\nimport preflight\ndef ro(path): return sqlite3.connect(f'\\\\''file:{path.resolve()}?mode=ro&immutable=1'\\\\'',uri=True)\nd=pathlib.Path('\\\\''docs/research/2026-11-21-citation-lists'\\\\'')\nold=pathlib.Path('\\\\''poc/data/comparison-2026-11-17/run/old-2/prod'\\\\'')\nroot=pathlib.Path('\\\\''poc/data/citation-t1-2026-11-21-run2'\\\\'')\nr=json.loads((root/'\\\\''t1-result.json'\\\\'').read_text())\nlog=json.loads((root/'\\\\''transport-log.json'\\\\'').read_text())\nprint('\\\\''T1 log'\\\\'', {k:len(v) if isinstance(v,list) else v for k,v in log.items()})\nviews=ro(root/'\\\\''views.sqlite'\\\\''); oldviews=ro(old/'\\\\''views.sqlite'\\\\'')\narchive=ro(root/'\\\\''archive.sqlite'\\\\''); oldarchive=ro(old/'\\\\''archive.sqlite'\\\\'')\nfor db in [views,oldviews,archive,oldarchive]: print('\\\\''store'\\\\'',db.execute('\\\\''pragma quick_check'\\\\'').fetchone())\ndef tables(db): return {t for t, in db.execute(\\\"select name from sqlite_master where type='\\\\''table'\\\\''\\\")}\ndef columns(db,t): return [row[1] for row in db.execute(f'\\\\''pragma table_info(\\\"{t}\\\")'\\\\'')]\ndef compare(v,w):\n    same=diff=0\n    for t in sorted(tables(v)&tables(w)):\n        vc,wc=columns(v,t),columns(w,t)\n        if vc\"'!=wc: print('\"'\\\\''column difference'\\\\'',t,set(vc)\"'^set(wc),[db.execute(f'\"'\\\\''select count(*) from \\\"{t}\\\"'\\\\'').fetchone()[0] for db in [v,w]])\n        if set(wc)-set(vc): continue\n        names=r['\\\\''store comparison'\\\\''][t]['\\\\''columns not compared'\\\\''] if isinstance(r['\\\\''store comparison'\\\\''][t],dict) else []\n        for ignored in [[],names] if names else [[]]:\n            sel='\\\\'', '\\\\''.join(f'\\\\''\\\"{c}\\\"'\\\\'' for c in wc if c not in ignored)\n            a=collections.Counter(v.execute(f'\\\\''select {sel} from \\\"{t}\\\"'\\\\''))\n            b=collections.Counter(w.execute(f'\\\\''select {sel} from \\\"{t}\\\"'\\\\''))\n            if ignored or not names:\n                same+=a==b\n                diff+=a\"'!=b\n            if a!=b: print('\"'\\\\''data difference'\\\\'',t,'\\\\''ignored'\\\\'',ignored,len(a-b),len(b-a))\n    print('\\\\''compare'\\\\'',same,diff,'\\\\''new tables'\\\\'',[(t,v.execute(f'\\\\''select count(*) from \\\"{t}\\\"'\\\\'').fetchone()[0]) for t in sorted(tables(v)-tables(w))])\ncompare(views,oldviews)\ncfg = config.load('\\\\''poc/config/poc-v121.json'\\\\'')\ndef judge_rows(db):\n    return {callid:(sha,ver,chk,json.loads(req),json.loads(ans)) for callid,sha,ver,chk,req,ans in db.execute(\\\"select call_id,request_sha256,config_version,config_checksum,request_json,answer_json from model_calls where purpose='\\\\''judge'\\\\''\\\")}\na,b=judge_rows(archive),judge_rows(oldarchive)\nbytext={tuple(m['\\\\''content'\\\\''] for m in row[3]['\\\\''messages'\\\\'']):i for i,row in b.items()}\nsubs={p['\\\\''refused call'\\\\'']:p['\\\\''retry call'\\\\''] for p in r['\\\\''substitutions'\\\\'']}\npinned=judging.schema_for('\\\\''judging-v7'\\\\'')\nspec=importlib.util.spec_from_file_location('\\\\''t1'\\\\'',d/'\\\\''t1_replay.py'\\\\'')\nt1=importlib.util.module_from_spec(spec); spec.loader.exec_module(t1)\nproblems=collections.Counter(); seen=set(); nested=collections.Counter()\narchive_ids=set()\nold_link={j: (i,s,h) for j,i,s,h in oldviews.execute('\\\\''select judgement_id,call_id,request_sha256,config_checksum from judgements'\\\\'')}\nfor j,i,s,h in views.execute('\\\\''select judgement_id,call_id,request_sha256,config_checksum from judgements'\\\\''):\n    archive_ids.add(i)\n    sha,ver,chk,req,ans=a[i]\n    key=tuple(m['\\\\''content'\\\\''] for m in req['\\\\''messages'\\\\''])\n    oldid=bytext[key]\n    chosen=subs.get(oldid,oldid)\n    oh,ov,oc,oreq,oans=b[chosen]\n    old_first = b[oldid][3]\n    seen.add(oldid)\n    f=req['\\\\''response_format'\\\\'']\n    schema=f['\\\\''json_schema'\\\\'']['\\\\''schema'\\\\'']\n    lists=t1.closed_lists(schema)\n    nested.update({name: bool(ids) for name,ids in lists.items()})\n    checks = {\n      '\\\\''record metadata'\\\\'': sha == s == model.request_identity(req)[1] and chk==h==cfg.checksum and ver==cfg.version,\n      '\\\\''old lineage / new hashes'\\\\'': old_link[j][0]==chosen and old_link[j][1]\"'!=s and old_link[j][2]!=h,\n      '\"'\\\\''answers'\\\\'': ans==oans,\n      '\\\\''req outside format'\\\\'': {k:v for k,v in req.items() if k\"'!='\"'\\\\''response_format'\\\\''}=={k:v for k,v in old_first.items() if k\"'!='\"'\\\\''response_format'\\\\''},\n      '\\\\''strict and shape'\\\\'': f == {'\\\\''type'\\\\'':'\\\\''json_schema'\\\\'','\\\\''json_schema'\\\\'':{'\\\\''name'\\\\'':'\\\\''judgement'\\\\'','\\\\''strict'\\\\'':True,'\\\\''schema'\\\\'':schema}} and t1.opened(schema)==pinned,\n      '\\\\''schema vs lists'\\\\'': schema == judging.schema_for('\\\\''judging-v12'\\\\'',lists),\n      '\\\\''lists vs text'\\\\'': lists=={'\\\\''evidence'\\\\'':sorted(judging.evidence_shown_in(key[1])),'\\\\''themes'\\\\'':sorted(judging.themes_shown_in(key[1])),'\\\\''dependencies'\\\\'':sorted(t1.dependencies_shown_in(key[1]))},\n      '\\\\''answers pass new format'\\\\'': not model.check_schema(ans,schema),\n    }\n    problems.update(k for k,v in checks.items() if not v)\nprint('\\\\''T1 archive'\\\\'',len(a),len(b),'\\\\''judgement calls'\\\\'',len(archive_ids),'\\\\''unique old initial calls'\\\\'',len(seen),'\\\\''nonempty'\\\\'',nested,'\\\\''problems'\\\\'',problems)\nprint('\\\\''T1 originals'\\\\'')\nfor i,v in json.loads((root/'\\\\''outgoing-refused-originals.json'\\\\'').read_text()).items():\n    key=tuple(m['\\\\''content'\\\\''] for m in v['\\\\''request'\\\\'']['\\\\''messages'\\\\''])\n    _,_,_,req,ans=b[int(i)]\n    assert key==tuple(m['\\\\''content'\\\\''] for m in req['\\\\''messages'\\\\'']) and json.loads(v['\\\\''answer'\\\\''])==ans\n    print(i, [e.split('\\\\'' not in '\\\\'')[0] for e in model.check_schema(ans,v['\\\\''request'\\\\'']['\\\\''response_format'\\\\'']['\\\\''json_schema'\\\\'']['\\\\''schema'\\\\''])])\nprint('\\\\''Preflight controls'\\\\'')\nfor sha, body, req in [('\\\\''a:refused:1'\\\\'','\\\\''{}'\\\\'','\\\\''{}'\\\\''),('\\\\''b:malformed:2'\\\\'',None,'\\\\''{}'\\\\''),('\\\\''c:refused:3'\\\\'','\\\\''{}'\\\\'','\\\\''{\\\"response_format\\\":{\\\"json_schema\\\":{\\\"schema\\\":{}}}}'\\\\'')]:\n    conn=sqlite3.connect('\\\\'':memory:'\\\\'')\n    conn.execute('\\\\''create table model_calls(purpose,request_sha256,answer_json,request_json)'\\\\'')\n    conn.execute('\\\\''insert into model_calls values(?,?,?,?)'\\\\'',('\\\\''judge'\\\\'',sha,body,req))\n    print(sha,preflight.part_a(conn))\n'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
