{"type":"item.completed","item":{"id":"item_25","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc 'nl -ba docs/research/2026-11-21-citation-lists/mutants.py; cat docs/research/2026-11-21-citation-lists/{mutants.log,preflight-old2.log,t1-replay.log}'","aggregated_output":"     1\t\"\"\"$0 mutation check of judging-v12 (D713, DESIGN.md §5 \"Mutants\"; AGENTS §4). Each mutant is applied to a scratch copy of the tree, run\n     2\twithout bytecode caches, and must make its named tests fail; the unmutated copy must pass them.\n     3\t\n     4\t  python3 mutants.py <scratch folder>\n     5\t\"\"\"\n     6\timport os\n     7\timport shutil\n     8\timport subprocess\n     9\timport sys\n    10\tfrom pathlib import Path\n    11\t\n    12\tREPO = Path(__file__).resolve().parents[3]\n    13\tCOPY = ['src', 'scripts', 'tests', 'pytest.ini', 'poc/config', 'poc/universe.json', 'poc/seeds']\n    14\tCITATIONS, FROZEN = 'tests/test_citation_lists.py', 'tests/test_frozen_questions_and_judgement.py'\n    15\tJUDGING, MODEL, PREFLIGHT = 'src/hivemind/views/judging.py', 'src/hivemind/model.py', 'scripts/preflight.py'\n    16\tMUTANTS = [\n    17\t    ('push ids left open', JUDGING,\n    18\t     \"        properties['pushes'] = {'type': 'array', 'items': dict(push_item, properties=dict(push_item['properties'], evidence_id={'$ref': '#/$defs/evidence_id'}))}\",\n    19\t     \"        properties['pushes'] = properties['pushes']\", CITATIONS, 'test_every_id_field'),\n    20\t    ('lists parsed from the text, not the rows', JUDGING,\n    21\t     \"    lists = {'evidence': sorted({p['evidence_id'] for p in pieces}),\",\n    22\t     \"    lists = {'evidence': sorted(evidence_shown_in('\\\\n'.join(lines))),\", CITATIONS, 'test_one_owner'),\n    23\t    ('the v12 check reads the text, not the lists', JUDGING,\n    24\t     \"    if lists is not None:\\n        allowed, deps = set(lists['evidence']), set(lists['dependencies'])\",\n    25\t     \"    if False:\\n        allowed, deps = set(lists['evidence']), set(lists['dependencies'])\", CITATIONS, 'test_one_owner'),\n    26\t    ('maxItems dropped for an empty list', JUDGING,\n    27\t     \"        properties['cites'] = dict(properties['cites'], maxItems=0)\", \"        properties['cites'] = dict(properties['cites'])\",\n    28\t     CITATIONS, 'test_every_id_field'),\n    29\t    ('the validator ignores maxItems', MODEL,\n    30\t     \"        if 'maxItems' in schema and len(value) > schema['maxItems']:\", \"        if False:\", CITATIONS, 'test_every_id_field'),\n    31\t    ('strict dropped from the outgoing format', MODEL,\n    32\t     \"{'name': schema_name, 'strict': True, 'schema': schema}\", \"{'name': schema_name, 'strict': False, 'schema': schema}\",\n    33\t     CITATIONS, 'test_a_judging_v12_round'),\n    34\t    ('the round sends the open format', JUDGING,\n    35\t     \"            schemas = {v: schema_for(version, lists[v]) for v in level}\", \"            schemas = {v: _open_format(version) for v in level}\",\n    36\t     CITATIONS, 'test_a_judging_v12_round or test_an_answer_outside_the_lists'),\n    37\t    ('the retry sends the open format', JUDGING,\n    38\t     \"user + note, schemas[view_id], 'judgement', 'judge', transport=transport)\",\n    39\t     \"user + note, schemas[view_id] if not note else _open_format(version), 'judgement', 'judge', transport=transport)\",\n    40\t     CITATIONS, 'test_a_judging_v12_round'),\n    41\t    ('preflight checks judge rows against the fixed schema', PREFLIGHT,\n    42\t     \"        if purpose == 'judge':\\n            schema = saved_judge_format(request_json)\",\n    43\t     \"        if False:\\n            schema = saved_judge_format(request_json)\", CITATIONS, 'test_preflight_fails'),\n    44\t    ('preflight does not fail on a missing judge format', PREFLIGHT,\n    45\t     \"    if missing_formats:\", \"    if False:\", CITATIONS, 'test_preflights_entry_point'),\n    46\t    ('the closed format drifts', JUDGING,\n    47\t     \"        schema['$defs'] = {'evidence_id': {'type': 'string', 'enum': evidence}}\",\n    48\t     \"        schema['$defs'] = {'evidence_id': {'type': 'string', 'enum': list(reversed(evidence))}}\", FROZEN, 'test_the_citation_version'),\n    49\t]\n    50\t\n    51\t\n    52\tdef tree(scratch, name):\n    53\t    root = scratch / name\n    54\t    if root.exists():\n    55\t        shutil.rmtree(root)\n    56\t    for part in COPY:\n    57\t        source, target = REPO / part, root / part\n    58\t        target.parent.mkdir(parents=True, exist_ok=True)\n    59\t        (shutil.copytree if source.is_dir() else shutil.copyfile)(source, target, **({'ignore': shutil.ignore_patterns('__pycache__')} if source.is_dir() else {}))\n    60\t    return root\n    61\t\n    62\t\n    63\tdef run(root, test_file, selection):\n    64\t    environment = dict(os.environ, PYTHONDONTWRITEBYTECODE='1')\n    65\t    result = subprocess.run([sys.executable, '-m', 'pytest', '-q', '-p', 'no:cacheprovider', test_file, '-k', selection],\n    66\t                            cwd=root, capture_output=True, text=True, env=environment)\n    67\t    return result.returncode, result.stdout.strip().splitlines()[-1] if result.stdout.strip() else result.stderr[-200:]\n    68\t\n    69\t\n    70\tdef main():\n    71\t    scratch = Path(sys.argv[1])\n    72\t    scratch.mkdir(parents=True, exist_ok=True)\n    73\t    control = tree(scratch, 'control')\n    74\t    ok = True\n    75\t    for name, path, old, new, test_file, selection in MUTANTS:\n    76\t        code, summary = run(control, test_file, selection)\n    77\t        print(f'control  [{name}]: exit {code} {summary}')\n    78\t        ok = ok and code == 0\n    79\t        root = tree(scratch, 'mutant')\n    80\t        text = (root / path).read_text()\n    81\t        if text.count(old) != 1:\n    82\t            print(f'mutant   [{name}]: the mutated line is not found once: not applied')\n    83\t            ok = False\n    84\t            continue\n    85\t        (root / path).write_text(text.replace(old, new))\n    86\t        code, summary = run(root, test_file, selection)\n    87\t        caught = code != 0\n    88\t        ok = ok and caught\n    89\t        print(f'mutant   [{name}]: exit {code} {\"CAUGHT\" if caught else \"NOT CAUGHT\"} {summary}')\n    90\t    sys.exit(0 if ok else 1)\n    91\t\n    92\t\n    93\tif __name__ == '__main__':\n    94\t    main()\ncontrol  [push ids left open]: exit 0 1 passed, 6 deselected in 0.04s\nmutant   [push ids left open]: exit 1 CAUGHT 1 failed, 6 deselected in 0.06s\ncontrol  [lists parsed from the text, not the rows]: exit 0 1 passed, 6 deselected in 0.06s\nmutant   [lists parsed from the text, not the rows]: exit 1 CAUGHT 1 failed, 6 deselected in 0.09s\ncontrol  [the v12 check reads the text, not the lists]: exit 0 1 passed, 6 deselected in 0.06s\nmutant   [the v12 check reads the text, not the lists]: exit 1 CAUGHT 1 failed, 6 deselected in 0.09s\ncontrol  [maxItems dropped for an empty list]: exit 0 1 passed, 6 deselected in 0.03s\nmutant   [maxItems dropped for an empty list]: exit 1 CAUGHT 1 failed, 6 deselected in 0.07s\ncontrol  [the validator ignores maxItems]: exit 0 1 passed, 6 deselected in 0.04s\nmutant   [the validator ignores maxItems]: exit 1 CAUGHT 1 failed, 6 deselected in 0.07s\ncontrol  [strict dropped from the outgoing format]: exit 0 1 passed, 6 deselected in 0.08s\nmutant   [strict dropped from the outgoing format]: exit 1 CAUGHT 1 failed, 6 deselected in 0.26s\ncontrol  [the round sends the open format]: exit 0 2 passed, 5 deselected in 0.08s\nmutant   [the round sends the open format]: exit 1 CAUGHT 2 failed, 5 deselected in 0.16s\ncontrol  [the retry sends the open format]: exit 0 1 passed, 6 deselected in 0.06s\nmutant   [the retry sends the open format]: exit 1 CAUGHT 1 failed, 6 deselected in 0.09s\ncontrol  [preflight checks judge rows against the fixed schema]: exit 0 1 passed, 6 deselected in 0.05s\nmutant   [preflight checks judge rows against the fixed schema]: exit 1 CAUGHT 1 failed, 6 deselected in 0.08s\ncontrol  [preflight does not fail on a missing judge format]: exit 0 1 passed, 6 deselected in 0.05s\nmutant   [preflight does not fail on a missing judge format]: exit 1 CAUGHT 1 failed, 6 deselected in 0.08s\ncontrol  [the closed format drifts]: exit 0 1 passed, 3 deselected in 0.02s\nmutant   [the closed format drifts]: exit 1 CAUGHT 1 failed, 3 deselected in 0.05s\nexit 0\npreflight over /Users/lchingen/hivemind/poc/data/comparison-2026-11-17/run/old-2/prod/archive.sqlite and 1 views databases: prod\n\n== A. answers the schema refused (prompt/schema disagreements; empty when the provider enforces the schema server-side): judged 4, refused/dropped 4 (100%)\n\n   extraction archive rows 1884: replayed 1884, earlier refused 0, retired 0, unidentifiable 0\n   extraction answers 1884: evidence produced 6714 kept 6645; candidates produced 103 kept 103\n\n== B. current extraction checks before the handover, using the supplied universe: judged 6817, refused/dropped 69 (1%)\n      48  quote not in item\n          e.g. gnews:9f430c6ce2e8d551fe1f063a e6: quote not in item\n          e.g. nvblog:nemotron-langchain-agents-open-stack e1: quote not in item\n      21  same quote as #; merged\n          e.g. gnews:040c256543fc8106ffecabae e3: same quote as e2; merged\n          e.g. gnews:5d4b94245e962f4185fcd9f3 e5: same quote as e4; merged\n\n== C. matching code checks over stored records (database state is the final one, not the state at the time): judged 1277, refused/dropped 3 (0%)\n       2  candidate #: # already has a successor\n          e.g. tmpx0fyidjb gnews:81226ce463750079ebf335c5: candidate c1: v28 already has a successor\n          e.g. tmpx0fyidjb gnews:687ffd9da27cd6ba26f690f1: candidate c1: v14 already has a successor\n       1  candidate #: cannot attach to closed view #\n          e.g. tmpx0fyidjb gnews:df74df86a5a6cfd06fe7cbb3: candidate c1: cannot attach to closed view v40\n       ledger tmpx0fyidjb: judged 1277, skipped 10 {'request not in this archive': 10}\n\n== D. schema enum values named in the prompts: judged 49, missing 0\n\n== E. keyed views in views.sqlite: open views 42, keyed 42, duplicate keys 0 groups, review pool 0 candidates outside the watch list\n\npreflight done\nexit 0\n{\n \"stopped\": \"\",\n \"seconds\": 366,\n \"judge rows removed from the seed\": 1620,\n \"judge responses through the transport\": 1616,\n \"substitutions\": [\n  {\n   \"refused call\": 591,\n   \"retry call\": 596\n  },\n  {\n   \"refused call\": 6955,\n   \"retry call\": 6979\n  },\n  {\n   \"refused call\": 7068,\n   \"retry call\": 7073\n  },\n  {\n   \"refused call\": 7774,\n   \"retry call\": 7780\n  }\n ],\n \"problems\": [],\n \"list mismatches\": [],\n \"store equal to old-2 (named columns apart)\": true,\n \"sizes\": {\n  \"requests\": 1616,\n  \"max evidence\": 316,\n  \"format chars median\": 1396,\n  \"format chars max\": 4013,\n  \"v7 format chars\": 1031\n },\n \"T1 pass\": true,\n \"T1b\": {\n  \"591\": \"SchemaError: $.cites[8]: 'e88' not in ['e103', 'e110', 'e111', 'e120', 'e121', 'e147', 'e148', 'e167', 'e168', 'e174', 'e214', 'e215', 'e250', 'e251', 'e263', 'e40', 'e41', 'e42', 'e43', 'e44', 'e45', 'e55', 'e71'\",\n  \"6955\": \"SchemaError: $.pushes[18].evidence_id: 'e3955' not in ['e2763', 'e2764', 'e2996', 'e2997', 'e3135', 'e3198', 'e3199', 'e3358', 'e3394', 'e3425', 'e3554', 'e3749', 'e3764', 'e3768', 'e3769', 'e3777', 'e3778', 'e377\",\n  \"7068\": \"SchemaError: $.cites[9]: 'v10' not in ['e3396', 'e3397', 'e3471', 'e3475', 'e3541', 'e3631', 'e3632', 'e3658', 'e3659', 'e3660', 'e3841', 'e3872', 'e3873', 'e3874', 'e3939', 'e3980', 'e3993', 'e3994', 'e3995', 'e3\",\n  \"7774\": \"SchemaError: $.cites[2]: 'e3998' not in ['e3396', 'e3397', 'e3471', 'e3475', 'e3541', 'e3631', 'e3632', 'e3658', 'e3659', 'e3660', 'e3841', 'e3872', 'e3873', 'e3874', 'e3939', 'e3980', 'e3993', 'e3994', 'e3995', '\"\n },\n \"T1b pass\": true\n}\nTraceback (most recent call last):\n  File \"/Users/lchingen/hivemind/docs/research/2026-11-21-citation-lists/t1_replay.py\", line 264, in <module>\n    main()\n  File \"/Users/lchingen/hivemind/docs/research/2026-11-21-citation-lists/t1_replay.py\", line 259, in main\n    print(json.dumps({k: (v if isinstance(v, str) else {kk: vv for kk, vv in v.items() if kk != 'columns not compared'}) for k, v in result['store comparison'].items()}, indent=0)[:4000])\n  File \"/Users/lchingen/hivemind/docs/research/2026-11-21-citation-lists/t1_replay.py\", line 259, in <dictcomp>\n    print(json.dumps({k: (v if isinstance(v, str) else {kk: vv for kk, vv in v.items() if kk != 'columns not compared'}) for k, v in result['store comparison'].items()}, indent=0)[:4000])\nAttributeError: 'list' object has no attribute 'items'\nexit 1\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_26","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba src/hivemind/model.py | sed -n '180,370p'\"","aggregated_output":"   180\t        failure.http_status, failure.response_body, failure.response_body_base64 = last_http\n   181\t    raise failure\n   182\t\n   183\t\n   184\tdef check_schema(value, schema, path='$', root=None):\n   185\t    \"\"\"A small validator for the subset of JSON Schema the prompts use: object/required/additionalProperties,\n   186\t    array/items/minItems/maxItems, string/enum/pattern, integer, number, boolean, null in anyOf, and $ref into the root's $defs.\"\"\"\n   187\t    root = root if root is not None else schema\n   188\t    if '$ref' in schema:\n   189\t        name = schema['$ref'].rsplit('/', 1)[1]\n   190\t        schema = root['$defs'][name]\n   191\t    kind = schema.get('type')\n   192\t    if 'anyOf' in schema:\n   193\t        # a value matching no option reports the closest options' errors (fewest), not merely the last option's\n   194\t        failures = []\n   195\t        for option in schema['anyOf']:\n   196\t            errors = check_schema(value, option, path, root)\n   197\t            if not errors:\n   198\t                return []\n   199\t            failures.append(errors)\n   200\t        fewest = min((len(errors) for errors in failures), default=0)\n   201\t        closest = list(dict.fromkeys(error for errors in failures if len(errors) == fewest for error in errors))\n   202\t        return closest or [f'{path}: matches no option']\n   203\t    if kind == 'object':\n   204\t        if not isinstance(value, dict):\n   205\t            return [f'{path}: expected object']\n   206\t        errors = []\n   207\t        for name in schema.get('required', []):\n   208\t            if name not in value:\n   209\t                errors.append(f'{path}.{name}: required')\n   210\t        properties = schema.get('properties', {})\n   211\t        for name, item in value.items():\n   212\t            if name in properties:\n   213\t                errors.extend(check_schema(item, properties[name], f'{path}.{name}', root))\n   214\t            elif schema.get('additionalProperties') is False:\n   215\t                errors.append(f'{path}.{name}: not allowed')\n   216\t        return errors\n   217\t    if kind == 'array':\n   218\t        if not isinstance(value, list):\n   219\t            return [f'{path}: expected array']\n   220\t        errors = []\n   221\t        if len(value) < schema.get('minItems', 0):\n   222\t            errors.append(f'{path}: fewer than {schema[\"minItems\"]} items')\n   223\t        if 'maxItems' in schema and len(value) > schema['maxItems']:\n   224\t            errors.append(f'{path}: more than {schema[\"maxItems\"]} items')\n   225\t        for index, item in enumerate(value):\n   226\t            errors.extend(check_schema(item, schema.get('items', {}), f'{path}[{index}]', root))\n   227\t        return errors\n   228\t    if kind == 'string':\n   229\t        if not isinstance(value, str):\n   230\t            return [f'{path}: expected string']\n   231\t        if 'enum' in schema and value not in schema['enum']:\n   232\t            return [f'{path}: {value!r} not in {schema[\"enum\"]}']\n   233\t        if 'pattern' in schema and not re.search(schema['pattern'], value):\n   234\t            return [f'{path}: {value!r} does not match {schema[\"pattern\"]}']\n   235\t        return []\n   236\t    if kind == 'integer':\n   237\t        return [] if isinstance(value, int) and not isinstance(value, bool) else [f'{path}: expected integer']\n   238\t    if kind == 'number':\n   239\t        return [] if isinstance(value, (int, float)) and not isinstance(value, bool) else [f'{path}: expected number']\n   240\t    if kind == 'boolean':\n   241\t        return [] if isinstance(value, bool) else [f'{path}: expected boolean']\n   242\t    if kind == 'null':\n   243\t        return [] if value is None else [f'{path}: expected null']\n   244\t    return []\n   245\t\n   246\t\n   247\tdef request_identity(request):\n   248\t    \"\"\"The exact serialized request and its archive key, shared by callers and validation.\"\"\"\n   249\t    encoded = json.dumps(request, sort_keys=True, ensure_ascii=False)\n   250\t    return encoded, hashlib.sha256(encoded.encode('utf-8')).hexdigest()\n   251\t\n   252\t\n   253\tdef call(archive, cfg, setting, system, user, schema, schema_name, purpose, *, transport=None):\n   254\t    provider = cfg.provider\n   255\t    request = build_request(setting, system, user, schema, schema_name, provider)\n   256\t    request_json, sha = request_identity(request)\n   257\t    hit = archive.lookup(sha)\n   258\t    prompt_chars = len(system) + len(user)\n   259\t    if hit:\n   260\t        call_id, answer_json, _, input_tokens, output_tokens = hit\n   261\t        return Answer(json.loads(answer_json), call_id, sha, True, prompt_chars, input_tokens or 0, output_tokens or 0, 0.0)\n   262\t    started = time.time()\n   263\t    response = (transport or openai_transport)(provider, request)\n   264\t    seconds = round(time.time() - started, 1)\n   265\t    try:\n   266\t        content = response['choices'][0]['message']['content']\n   267\t        data = json.loads(content)\n   268\t    except (KeyError, IndexError, TypeError, json.JSONDecodeError) as error:\n   269\t        archive.record(purpose=purpose, config_version=cfg.version, config_checksum=cfg.checksum, model=setting.model,\n   270\t                       request_sha256=sha + ':malformed:' + uuid.uuid4().hex[:8], request_json=request_json,\n   271\t                       response_json=json.dumps(response)[:200000], answer_json=None, prompt_chars=prompt_chars,\n   272\t                       input_tokens=0, output_tokens=0, cost_usd=0.0, seconds=seconds, created_at=time.strftime('%Y-%m-%dT%H:%M:%S'))\n   273\t        raise SchemaError(f'malformed answer: {error}')\n   274\t    errors = check_schema(data, schema)\n   275\t    usage = response.get('usage') or {}\n   276\t    input_tokens = int(usage.get('prompt_tokens') or 0)\n   277\t    output_tokens = int(usage.get('completion_tokens') or 0)\n   278\t    cached_tokens = min(input_tokens, int((usage.get('prompt_tokens_details') or {}).get('cached_tokens') or 0))\n   279\t    price_in, price_out = PRICES.get(setting.model, (0.0, 0.0))\n   280\t    cost = round((input_tokens - cached_tokens) / 1e6 * price_in + cached_tokens / 1e6 * price_in * CACHED_INPUT_SHARE + output_tokens / 1e6 * price_out, 6)\n   281\t    call_id = archive.record(purpose=purpose, config_version=cfg.version, config_checksum=cfg.checksum, model=setting.model,\n   282\t                             request_sha256=sha if not errors else sha + ':schema:' + uuid.uuid4().hex[:8], request_json=request_json,\n   283\t                             response_json=json.dumps(response)[:200000], answer_json=json.dumps(data, ensure_ascii=False),\n   284\t                             prompt_chars=prompt_chars, input_tokens=input_tokens, output_tokens=output_tokens, cost_usd=cost,\n   285\t                             seconds=seconds, created_at=time.strftime('%Y-%m-%dT%H:%M:%S'))\n   286\t    if errors:\n   287\t        raise SchemaError('; '.join(errors[:5]))\n   288\t    return Answer(data, call_id, sha, False, prompt_chars, input_tokens, output_tokens, cost)\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_27","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba src/hivemind/views/judging.py | sed -n '1,245p'\"","aggregated_output":"     1\t\"\"\"06-views.md step 7: one re-judging round. Open views whose reading changed are judged in dependency order, each\n     2\tonce; a view whose conclusion changed adds its open dependants. The model reads the evidence in force (with each\n     3\treplaced predecessor), the dependencies' current conclusions and its own last conclusion (for comparison only).\n     4\tCode checks every citation and that a rung move or a first judgement says changed; one retry, then the item fails.\n     5\t\n     6\tThe request is judging-v7 (D354, frozen with steps 3 and 4), judging-v8 (D694: v7's text with the fuller dependency block) or\n     7\tjudging-v12 (D713: v7's text and request; the answer's id fields take only the ids the request lists, and the check reads the same\n     8\tlists): no other version is built, and a configuration that names another is refused before any call. Every answer is stored in the\n     9\tcanonical vocabulary.\n    10\t\n    11\tThe theme block (D191, D195): an asset thesis is judged with every open, judged theme thesis in view and answers, in theme_pushes,\n    12\twhich way each theme it weighed pushes it; theme theses are judged before asset theses in a round, and a theme judgement that says\n    13\tchanged queues every open asset thesis with evidence in force, once. The round's queue is derived from the ledger (the day's changed\n    14\tviews, the dependants of views judged at this sequence number with a changed conclusion, and the asset theses a changed theme queues),\n    15\tso a resumed round recovers what an earlier commit had queued.\n    16\t\n    17\tThe evidence in view (D198): a judgement reads the arrivals and the basis among the evidence in force, not everything in force.\n    18\t\n    19\tThe reference (D260): the rung is the forecast the evidence in force makes most likely, judged against what the market expects\n    20\t(consensus, guidance, the stated plan); the answer states the reference and the outcome the evidence implies, both stored beside the\n    21\trung, and an empty one is refused.\"\"\"\n    22\timport dataclasses\n    23\timport json\n    24\timport re\n    25\t\n    26\tfrom .. import config, model, vocabulary\n    27\tfrom . import store\n    28\t\n    29\tPUSHES = vocabulary.PUSHES\n    30\tSUPPORTED_VERSIONS = ('judging-v7', 'judging-v8', 'judging-v12')   # D354: the frozen judging prompt; D694: v8 = v7's text with the fuller dependency block; D712/D713: v12 = v7's text and request with closed id lists\n    31\tFULL_DEPENDENCY_BLOCK = ('judging-v8',)\n    32\tCLOSED_LISTS = ('judging-v12',)   # the answer's id fields take the ids the request lists (D713)\n    33\tREADINGS = 5                      # a piece is shown in the thesis's first five judgements after it arrives\n    34\tBASIS = 10                        # and while one of the last ten judgements cited it\n    35\tTHEME_REASONS_CHARS = 300\n    36\tUPDATED_MARK = 'updated since this thesis was last judged'\n    37\t\n    38\t\n    39\tdef require_supported(prompt_version):\n    40\t    \"\"\"Refuses a judging prompt version this code does not build, before any request is made.\"\"\"\n    41\t    if prompt_version not in SUPPORTED_VERSIONS:\n    42\t        raise ValueError(f'judging {prompt_version!r} is not built; this code builds only {\", \".join(SUPPORTED_VERSIONS)} (D354)')\n    43\t\n    44\t\n    45\tdef evidence_in_view(conn, view_id):\n    46\t    \"\"\"(the pieces a judgement of this thesis reads, how many pieces in force are not shown): the arrivals (linked after the\n    47\t    READINGS-th most recent judgement, or all when there are fewer) and the basis (cited by one of the last BASIS judgements),\n    48\t    both among the evidence in force.\"\"\"\n    49\t    in_force = store.evidence_in_force(conn, view_id)\n    50\t    recent = store.recent_judgements(conn, view_id, BASIS)\n    51\t    arrivals_after = recent[READINGS - 1]['seq'] if len(recent) >= READINGS else -1\n    52\t    basis = {evidence_id for j in recent for evidence_id in j['cites']}\n    53\t    linked_at = {r['evidence_id']: r['seq'] for r in conn.execute('select evidence_id, seq from evidence_links where view_id=?', (view_id,))}\n    54\t    shown = [p for p in in_force if linked_at.get(p['evidence_id'], -1) > arrivals_after or p['evidence_id'] in basis]\n    55\t    return shown, len(in_force) - len(shown)\n    56\t\n    57\t\n    58\tdef schema_for(prompt_version, lists=None):\n    59\t    \"\"\"The answer's format. Under judging-v12 (D713) its four id fields take the ids the request lists (`lists`, from\n    60\t    `request_parts`): one shared enum of the evidence ids for cites and push ids, the dependency ids for cites_views, the theme ids\n    61\t    for theme pushes; a field with no id allowed is an array with maxItems 0. Other versions ignore `lists`.\"\"\"\n    62\t    schema = _open_format(prompt_version)\n    63\t    if prompt_version not in CLOSED_LISTS:\n    64\t        return schema\n    65\t    if lists is None:\n    66\t        raise ValueError(f'{prompt_version} builds its answer format from the ids its request lists')\n    67\t    properties = schema['properties']\n    68\t    evidence, dependencies, themes = (sorted(set(lists[key])) for key in ('evidence', 'dependencies', 'themes'))\n    69\t    if evidence:\n    70\t        schema['$defs'] = {'evidence_id': {'type': 'string', 'enum': evidence}}\n    71\t        properties['cites'] = {'type': 'array', 'items': {'$ref': '#/$defs/evidence_id'}}\n    72\t        push_item = properties['pushes']['items']\n    73\t        properties['pushes'] = {'type': 'array', 'items': dict(push_item, properties=dict(push_item['properties'], evidence_id={'$ref': '#/$defs/evidence_id'}))}\n    74\t    else:\n    75\t        properties['cites'] = dict(properties['cites'], maxItems=0)\n    76\t        properties['pushes'] = dict(properties['pushes'], maxItems=0)\n    77\t    if dependencies:\n    78\t        properties['cites_views'] = {'type': 'array', 'items': {'type': 'string', 'enum': dependencies}}\n    79\t    else:\n    80\t        properties['cites_views'] = dict(properties['cites_views'], maxItems=0)\n    81\t    theme_item = properties['theme_pushes']['items']\n    82\t    if themes:\n    83\t        properties['theme_pushes'] = {'type': 'array', 'items': dict(theme_item, properties=dict(theme_item['properties'], view_id={'type': 'string', 'enum': themes}))}\n    84\t    else:\n    85\t        properties['theme_pushes'] = dict(properties['theme_pushes'], maxItems=0)\n    86\t    return schema\n    87\t\n    88\t\n    89\tdef _open_format(prompt_version):\n    90\t    require_supported(prompt_version)\n    91\t    pushes = PUSHES\n    92\t    schema = {\n    93\t        'type': 'object', 'additionalProperties': False,\n    94\t        'required': ['rung', 'reasons', 'cites', 'cites_views', 'pushes', 'changed', 'why_changed'],\n    95\t        'properties': {\n    96\t            'rung': {'type': 'integer'}, 'reasons': {'type': 'string'},\n    97\t            'cites': {'type': 'array', 'items': {'type': 'string'}}, 'cites_views': {'type': 'array', 'items': {'type': 'string'}},\n    98\t            'pushes': {'type': 'array', 'items': {'type': 'object', 'additionalProperties': False, 'required': ['evidence_id', 'push'],\n    99\t                                                  'properties': {'evidence_id': {'type': 'string'}, 'push': {'type': 'string', 'enum': pushes}}}},\n   100\t            'changed': {'type': 'boolean'}, 'why_changed': {'type': 'string'},\n   101\t        },\n   102\t    }\n   103\t    schema['required'].append('theme_pushes')\n   104\t    schema['properties']['theme_pushes'] = {'type': 'array', 'items': {'type': 'object', 'additionalProperties': False, 'required': ['view_id', 'push'],\n   105\t                                                                       'properties': {'view_id': {'type': 'string'}, 'push': {'type': 'string', 'enum': pushes}}}}\n   106\t    schema['required'][1:1] = STANCE_FIELDS           # after rung: the reference and the implied outcome are written before the reasons\n   107\t    schema['properties'].update({field: {'type': 'string'} for field in STANCE_FIELDS})\n   108\t    return schema\n   109\t\n   110\t\n   111\tdef themes_in_force(conn, view_id):\n   112\t    \"\"\"The theme block of an asset thesis: every open theme thesis with a current state, with its rung label and whether a\n   113\t    changed conclusion was recorded after this thesis's last judgement. Empty for a theme thesis.\"\"\"\n   114\t    if store.view(conn, view_id)['object_kind'] == 'theme':\n   115\t        return []\n   116\t    last = store.current_state(conn, view_id)\n   117\t    out = []\n   118\t    for row in conn.execute(\"select view_id from views where object_kind='theme' order by view_id\"):\n   119\t        theme_id = row['view_id']\n   120\t        state = store.current_state(conn, theme_id)\n   121\t        if not state or not store.is_open(conn, theme_id):\n   122\t            continue\n   123\t        updated = bool(last) and bool(conn.execute('select 1 from judgements where view_id=? and changed=1 and judgement_id>? limit 1',\n   124\t                                                   (theme_id, last['judgement_id'])).fetchone())\n   125\t        rung = store.rungs_of(conn, theme_id)[state['rung'] - 1]\n   126\t        out.append({'view_id': theme_id, 'view': store.view(conn, theme_id), 'state': state, 'rung_label': rung['label'], 'updated': updated})\n   127\t    return out\n   128\t\n   129\t\n   130\tSTANCE_FIELDS = ['reference', 'implied_outcome']   # D260: what the market expects, and the figure or date the evidence implies\n   131\t\n   132\t\n   133\tclass JudgementRefused(Exception):\n   134\t    pass\n   135\t\n   136\t\n   137\tdef topological(conn, view_ids):\n   138\t    \"\"\"Dependencies first: a view comes after every view it depends on that is also in the set.\"\"\"\n   139\t    remaining = list(dict.fromkeys(view_ids))\n   140\t    ordered, placed = [], set()\n   141\t    while remaining:\n   142\t        progressed = False\n   143\t        for view_id in list(remaining):\n   144\t            deps = {d['resolved_to'] for d in store.dependencies_of(conn, view_id) if d['resolved_to']}\n   145\t            if deps.isdisjoint(set(remaining) - {view_id}) or deps <= placed:\n   146\t                ordered.append(view_id)\n   147\t                placed.add(view_id)\n   148\t                remaining.remove(view_id)\n   149\t                progressed = True\n   150\t        if not progressed:                 # a cycle slipped through: keep going in the given order\n   151\t            ordered.extend(remaining)\n   152\t            break\n   153\t    return ordered\n   154\t\n   155\t\n   156\tdef _indented(text, indent='        '):\n   157\t    \"\"\"A stored value inside a block: every continuation line indented, so no physical line can read as a header or a listed id.\"\"\"\n   158\t    return str(text).replace('\\r\\n', '\\n').replace('\\n', '\\n' + indent)\n   159\t\n   160\t\n   161\tdef _dependency_lines_full(conn, target, d, state, rung_label, tv, flag):\n   162\t    \"\"\"judging-v8 (D694, design §3): the read judgement's comparison point and the system's forecast in full, labelled as ours, beside\n   163\t    the reasons excerpt; the read question not judged yet shows only that.\"\"\"\n   164\t    if not state:\n   165\t        return [f'- {target} ({flag}; {d[\"direction\"]}) {tv[\"question\"]}: now not judged yet']\n   166\t    return [f'- {target} ({flag}; {d[\"direction\"]}) {tv[\"question\"]}: now rung {state[\"rung\"]} {rung_label}, judged {state[\"publication_day\"]}',\n   167\t            f'    Comparison point stated by that judgement: {_indented(state.get(\"reference\") or \"not stated\")}',\n   168\t            f'    The system\\'s forecast for it (our own judgement, not evidence): {_indented(state.get(\"implied_outcome\") or \"not stated\")}',\n   169\t            f'    Reasons (excerpt): {_indented((state.get(\"reasons\") or \"\")[:600])}']\n   170\t\n   171\t\n   172\tdef _lines_english(conn, view_id, v, rungs, pieces, deps, last, themes=(), hidden=0, full_dependencies=False):\n   173\t    \"\"\"hidden: how many pieces in force are not shown. full_dependencies: the judging-v8 dependency block.\"\"\"\n   174\t    lines = [f'Thesis {view_id} ({v[\"object_id\"]}, {v[\"kind\"]}, focus \"{v[\"looks_at\"]}\", {v[\"year\"] or \"\"}, due {v[\"due_day\"]}): {v[\"question\"]}',\n   175\t             'Ladder: ' + ' / '.join(f'rung {r[\"position\"]} {r[\"label\"]}: {r[\"condition\"]}' for r in rungs), '',\n   176\t             f'[Evidence in view under this thesis, {len(pieces)} items]']\n   177\t    if hidden:\n   178\t        lines.append(f'[Not shown: {hidden} more pieces in force, read in earlier judgements; the previous conclusion carries them]')\n   179\t    for p in pieces:\n   180\t        src = p['sources'][0] if p['sources'] else {}\n   181\t        lines.append(f'- {p[\"evidence_id\"]} [{p[\"tier\"]}; {p[\"speaker\"]}; original source {p[\"original_who\"]} {p[\"original_day\"]}; from {src.get(\"input_id\")} {src.get(\"publication_day\")}] {p[\"one_line\"]}\\n    Quote: {p[\"quote\"][:400]}')\n   182\t        if p.get('replaced'):\n   183\t            lines.append(f'    It replaces {p[\"replaced\"][\"evidence_id\"]} ({p[\"replaced\"][\"original_day\"]}): {p[\"replaced\"][\"one_line\"]}')\n   184\t        if p.get('same_as'):\n   185\t            lines.append(f'    Opinion, not verified: the matcher read this as the same claim as {\", \".join(p[\"same_as\"])}; the argument counts one claim, one more outlet.')\n   186\t        if p.get('revises'):\n   187\t            lines.append(f'    Opinion, not verified: the matcher read it as a later version of {p[\"revises\"][\"evidence_id\"]} ({p[\"revises\"][\"original_day\"]}); both are in force: {p[\"revises\"][\"one_line\"]}')\n   188\t    if deps:\n   189\t        lines.append('\\n[Current conclusions of the theses it depends on]')\n   190\t        for d in deps:\n   191\t            target = d['resolved_to']\n   192\t            if not target:\n   193\t                lines.append(f'- the {d[\"wait_year\"]} thesis on chain {d[\"wait_chain_view_id\"]}: not yet created ({d[\"direction\"]})')\n   194\t                continue\n   195\t            tv = store.view(conn, target)\n   196\t            state = store.current_state(conn, target)\n   197\t            flag = 'historical only' if d['resolution'] == 'history_only' else ('closed' if not store.is_open(conn, target) else 'open')\n   198\t            rung_label = store.rungs_of(conn, target)[state['rung'] - 1]['label'] if state else 'not judged yet'\n   199\t            if full_dependencies:\n   200\t                lines.extend(_dependency_lines_full(conn, target, d, state, rung_label, tv, flag))\n   201\t                continue\n   202\t            lines.append(f'- {target} ({flag}; {d[\"direction\"]}) {tv[\"question\"]}: now rung {state[\"rung\"] if state else \"-\"} {rung_label}; reasons: {(state or {}).get(\"reasons\", \"\")[:600]}')\n   203\t    if themes:\n   204\t        lines.append(f'\\n[Themes in force, {len(themes)}]')\n   205\t        for theme in themes:\n   206\t            tv, state = theme['view'], theme['state']\n   207\t            mark = f'; {UPDATED_MARK}' if theme['updated'] else ''\n   208\t            lines.append(f'- {theme[\"view_id\"]} ({tv[\"object_id\"]}, due {tv[\"due_day\"]}) {tv[\"question\"]}: now rung {state[\"rung\"]} {theme[\"rung_label\"]}; '\n   209\t                         f'judged {state[\"publication_day\"]}{mark}; reasons: {(state[\"reasons\"] or \"\")[:THEME_REASONS_CHARS]}')\n   210\t    if last:\n   211\t        lines.append(f'\\n[Previous conclusion, for comparison only] rung {last[\"rung\"]}; reasons: {last[\"reasons\"][:800]}')\n   212\t    else:\n   213\t        lines.append('\\n[Previous conclusion] none: this is the first judgement, so changed must be true.')\n   214\t    lines.append('\\nAnswer per the JSON schema. cites may name only the evidence ids listed above; '\n   215\t                 + ('cites_views only the dependency thesis ids listed above' if deps else 'cites_views must be empty: this thesis depends on no other thesis')\n   216\t                 + ('; theme_pushes only the theme ids listed above; a theme id goes only in theme_pushes, never in cites or cites_views' if themes else '') + '.')\n   217\t    return lines\n   218\t\n   219\t\n   220\tdef build_prompt(conn, view_id, prompt_version):\n   221\t    system, user, _ = request_parts(conn, view_id, prompt_version)\n   222\t    return system, user\n   223\t\n   224\t\n   225\tdef request_parts(conn, view_id, prompt_version):\n   226\t    \"\"\"(system text, user text, the ids the request lists), all from the same rows at the same ledger state: the evidence pieces it\n   227\t    prints, the dependencies it gives an entry (resolved ones; a dependency still waiting has no id to cite) and the themes it prints.\"\"\"\n   228\t    require_supported(prompt_version)\n   229\t    v = store.view(conn, view_id)\n   230\t    rungs = store.rungs_of(conn, view_id)\n   231\t    pieces, hidden = evidence_in_view(conn, view_id)\n   232\t    deps = store.dependencies_of(conn, view_id)\n   233\t    last = store.current_state(conn, view_id)\n   234\t    themes = themes_in_force(conn, view_id)\n   235\t    lines = _lines_english(conn, view_id, v, rungs, pieces, deps, last, themes, hidden=hidden,\n   236\t                           full_dependencies=prompt_version in FULL_DEPENDENCY_BLOCK)\n   237\t    lists = {'evidence': sorted({p['evidence_id'] for p in pieces}), 'dependencies': sorted({d['resolved_to'] for d in deps if d['resolved_to']}),\n   238\t             'themes': sorted({theme['view_id'] for theme in themes})}\n   239\t    with open(config.prompt_path(prompt_version + '.txt'), encoding='utf-8') as handle:\n   240\t        return handle.read(), '\\n'.join(lines), lists\n   241\t\n   242\t\n   243\tdef retry_note(errors):\n   244\t    return '\\n\\nThe code returned the previous answer because: ' + '; '.join(errors) + '\\nCorrect it and answer again, citing only the listed ids.'\n   245\t\n","exit_code":0,"status":"completed"}}
