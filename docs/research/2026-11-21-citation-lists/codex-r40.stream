\''openai'\\\\'')\n            totals[arm].extend([(budget_replay.llm_estimate(rq),r['\\\\''estimated cost'\\\\''])]*(1 if arm=='\\\\''acceptance'\\\\'' else 3))\n    data=totals[arm]\n    print('\\\\''reservations min max sum; archived cost sum'\\\\'',min(x[0] for x in data),max(x[0] for x in data),sum(x[0] for x in data),sum(x[1] for x in data))\nprint('\\\\''sum'\\\\'',sum(x[1] for arr in totals.values() for x in arr),'\\\\''sum reservations'\\\\'',sum(x[0] for arr in totals.values() for x in arr))'\"","aggregated_output":"keys ['acceptance', 'refused', 'matched', 'sends', 'estimate'] estimate 0.427\nacceptance 2 2\nold-1 5652 v4 [451, 0, 7] None None None 0.007428 []\nsealed-D358 6918 v2 [647, 0, 23] None None None 0.011941 []\nreservations min max sum; archived cost sum 0.057309 0.08241180000000001 0.1397208 0.019369\nrefused 16 16\nold-1 8326 v5 [92, 0, 8] [8326] ['v6', 'v7', 'v9'] None 0.003683 []\nold-2 591 v7 [27, 0, 3] [591] ['e88'] None 0.001786 []\nold-2 6955 v34 [118, 0, 7] [6955] ['e3955'] None 0.002724 []\nold-2 7068 v35 [28, 0, 7] [7068] ['v10', 'v5', 'v6'] None 0.002806 []\nold-2 7774 v35 [38, 0, 7] [7774] ['e3998'] None 0.002907 []\nold-3 6236 v23 [24, 0, 9] [6236] ['e1382'] None 0.002241 []\nold-3 6458 v14 [45, 0, 9] [6458] ['e2769'] None 0.003275 []\ncontrol-1 8807 v14 [124, 0, 7] [8807] ['e393'] None 0.003089 []\ncontrol-1 8938 v21 [29, 0, 7] [8938, 8941] ['e3111', 'e362'] None 0.003381 []\nlinked-1 8777 v16 [25, 1, 3] [8777] ['e693'] None 0.002097 []\nlinked-1 8822 v16 [23, 1, 7] [8822] ['v14'] None 0.002249 []\nlinked-1 8848 v14 [73, 1, 7] [8848] ['v5', 'v6'] None 0.00307 []\nlinked-1 8855 v16 [24, 1, 7] [8855] ['v14'] None 0.002124 []\nlinked-1 8888 v9 [124, 1, 7] [8888] ['v5', 'v6'] None 0.003352 []\nlinked-1 8909 v14 [139, 1, 7] [8909] ['v5', 'v6'] None 0.004214 []\nlinked-1 9021 v21 [31, 1, 8] [9021] ['v5', 'v6'] None 0.003265 []\nreservations min max sum; archived cost sum 0.0131408 0.0249008 0.8246627999999999 0.13878899999999994\nmatche