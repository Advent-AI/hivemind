ef _indented(text, indent='        '):\n161:def _dependency_lines_full(conn, target, d, state, rung_label, tv, flag):\n162:    \"\"\"judging-v8 (D694, design §3): the read judgement's comparison point and the system's forecast in full, labelled as ours, beside\n172:def _lines_english(conn, view_id, v, rungs, pieces, deps, last, themes=(), hidden=0, full_dependencies=False):\n173:    \"\"\"hidden: how many pieces in force are not shown. full_dependencies: the judging-v8 dependency block.\"\"\"\n220:def build_prompt(conn, view_id, prompt_version):\n225:def request_parts(conn, view_id, prompt_version):\n243:def retry_note(errors):\n247:def themes_shown_in(request_text):\n253:def evidence_shown_in(request_text):\n259:def check_answer(conn, view_id, data, request_text=None, lists=None):\n261:    closed or opened since); without it, against what the ledger would show now. lists (judging-v12, D713): the ids the request\n306:def _record(conn, cfg, view_id, seq, item, answer):\n322:def upstream(conn, view_id):\n334:def open_asset_views(conn):\n338:def queued_by_change(conn, view_id):\n347:def queued_by_ledger(conn, seq):\n356:def round_of_judgements(archive, cfg, conn, changed_views, seq, item, *, transport=None):\n373:    def eligible(view_id):\n376:    def is_theme(view_id):\n394:        def ask(view_id, note=''):\n{\n  \"version\": \"poc-v121\",\n  \"_note\": \"poc-v118 with rejudging judging-v12 (D712, D713): judging-v7's text and request; the answer's id fields take only the ids the request lists. Every other setting unchanged.\",\n  \"provider\": \"openai\",\n  \"search_top_n\": 10,\n  \"extraction\": {\n    \"T1\": {\n      \"model\": \"gpt-6-luna\",\n      \"prompt_version\": \"T1-v74i\",\n      \"reasoning_effort\": \"low\",\n      \"max_output_tokens\": 16000\n    },\n    \"T2\": {\n      \"model\": \"gpt-6-luna\",\n      \"prompt_version\": \"T2-v74i\",\n      \"reasoning_effort\": \"low\",\n      \"max_output_tokens\": 16000\n    },\n    \"T3\": {\n      \"model\