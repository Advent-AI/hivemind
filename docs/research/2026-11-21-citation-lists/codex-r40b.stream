{"type":"item.started","item":{"id":"item_14","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"python3 -B -c 'import sys,json\nfrom pathlib import Path\nfrom types import SimpleNamespace\nh=Path('\\\\''docs/research/2026-11-21-citation-lists'\\\\'').resolve()\nsys.path[:0]=[str(Path('\\\\''src'\\\\'').resolve()),str(Path('\\\\''clean-arch/e2e-comparison-2026-11-13'\\\\'').resolve())]\nfrom hivemind import model\nfrom hivemind.views import judging\nfrom budget_replay import llm_estimate\np=json.loads((h/'\\\\''probe-plan.json'\\\\'').read_text())\nsettings=SimpleNamespace(model='\\\\''gpt-6-luna'\\\\'',reasoning_effort='\\\\''medium'\\\\'',max_output_tokens=16000)\ndef reserve(r,v):\n    return llm_estimate(model.build_request(settings,r['\\\\''system'\\\\''],r['\\\\''user'\\\\''],judging.schema_for('\\\\''judging-v'\\\\''+str(v),r['\\\\''lists'\\\\'']),'\\\\''judgement'\\\\'','\\\\''openai'\\\\''))\nfor factor in (1.,1.3):\n    print('\\\\''Factor'\\\\'',factor)\n    spend=factor*(sum(r['\\\\''estimated cost'\\\\''] for r in p['\\\\''acceptance'\\\\''][:2])+3*sum(r['\\\\''estimated cost'\\\\''] for r in p['\\\\''refused'\\\\'']))\n    for r in p['\\\\''matched'\\\\'']:\n        total_reserve=3*(reserve(r,7)+reserve(r,12))\n        headroom=.50-spend-total_reserve\n        print(r['\\\\''source'\\\\''],r['\\\\''call_id'\\\\''],'\\\\''spent'\\\\'',round(spend,6),'\\\\''batch'\\\\'',round(total_reserve,6),'\\\\''margin'\\\\'',round(headroom,6))\n        spend += 6*r['\\\\''estimated cost'\\\\'']*factor\n    print('\\\\''projected core cost'\\\\'',round(spend,6),'\\\\''optional eligible after full core'\\\\'',.5-spend>=reserve(p['\\\\''acceptance'\\\\''][2],12))\n'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
