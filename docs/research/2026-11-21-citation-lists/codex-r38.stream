the generative matcher's row, read as before) or 'reads' (a chosen reading link, D694)\nsrc/hivemind/views/store.py:26:    'dependency_resolutions': 'id integer primary key autoincrement, dependency_id integer, resolved_to text, reason text, seq integer',\nsrc/hivemind/views/store.py:247:        resolution = conn.execute('select resolved_to, reason from dependency_resolutions where dependency_id=? order by id desc limit 1', (dep['dependency_id'],)).fetchone()\nsrc/hivemind/views/store.py:267:        'select d.view_id from dependency_resolutions r join dependencies d on d.dependency_id=r.dependency_id where r.resolved_to=?', (view_id,))]\nsrc/hivemind/views/store.py:330:            shown[view_id]['depends_on'].append(target or f'（等 {dep[\"wait_chain_view_id\"]} 这条链上 {dep[\"wait_year\"]} 年的那条）')\nsrc/hivemind/views/store.py:331:            shown[view_id]['dependencies'].append({'view_id': target} if target else {'view_id': None, 'wait_chain_view_id': dep['wait_chain_view_id'], 'wait_year': dep['wait_year']})\nsrc/hivemind/views/writing.py:50:def resolve_waiting(conn, new_view_id, seq, changed):\nsrc/hivemind/views/writing.py:61:    for dep in conn.execute('select * from dependencies where wait_year=? and wait_chain_view_id is not null', (v['year'],)):\nsrc/hivemind/views/writing.py:62:        if dep['wait_chain_view_id'] in chain:\nsrc/hivemind/views/writing.py:63:            already = conn.execute('select 1 from dependency_resolutions where dependency_id=?', (dep['dependency_id'],)).fetchone()\nsrc/hivemind/views/writing.py:65:                store.insert(conn, 'dependency_resolutions', dependency_id=dep['dependency_id'], resolved_to=new_view_id, reason='created', seq=seq)\nsrc/hivemind/views/writing.py:155:        store.insert(conn, 'dependencies', view_id=reader, depends_on=read, wait_chain_view_id='', wait_year='', direction=label, seq=seq, kind=_links.KIND)\nsrc/hivemind/views/writing.py:226:            chain = dep['wait_chain_view_id']\nsrc/hivemind/views/writing.py:237:            store.insert(conn, 'dependencies', view_id=view_id, depends_on=depends_on, wait_chain_view_id=chain, wait_year=wait_year,\nsrc/hivemind/views/writing.py:239:        resolve_waiting(conn, view_id, seq, changed)\ntests/test_english.py:95:    decision = {'candidates': [{'id': 'c3', 'outcome': '新观点', 'target_view_id': '', 'reason': 'new', 'dependencies': [{'view_id': vid, 'wait_chain_view_id': '', 'wait_year': '', 'direction': '同向'}]}], 'evidence': []}\ntests/test_english.py:202:    waiting = [{'view_id': None, 'wait_chain_view_id': v1, 'wait_year': 'fiscal year 2027', 'direction': 'same'}]\ntests/test_identity_repair.py:90:    dep = {'view_id': 'c2', 'wait_chain_view_id': '', 'wait_year': '', 'direction': 'same'}\ntests/test_theme_block.py:144:    store.insert(conn, 'dependencies', view_id='v5', depends_on='v1', wait_chain_view_id='', wait_year='', direction='last_end', seq=1)\n    90\t                    conn.commit()\n    91\t                continue\n    92\t            processed += 1\n    93\t            to_run.append((item, route))\n    94\t        results = (day_runner(conn, archive, cfg, universe, to_run, day=day, transport=transport, log=log) if day_runner else\n    95\t                   (round_module.run(conn, archive, cfg, universe, item, route.sequence_no, resume_from=route.resume_from, transport=transport, log=log)\n    96\t                    for item, route in to_run))\n    97\t        finished = 0\n    98\t        try:\n    99\t            for index, result in enumerate(results):\n   100\t                if index >= len(to_run) or result.input_id != to_run[index][0]['input_id']:\n   101\t                    raise RuntimeError('day runner returned results out of input order')\n   102\t                finished += 1\n   103\t                day_stats['extracted'] += 1\n   104\t                day_stats['evidence'] += result.evidence\n   105\t                day_stats['new_views'] += result.new_views\n   106\t                day_stats['judged'] += result.judged\n   107\t                day_stats['changed'] += result.changed\n   108\t                if result.failed:\n   109\t                    day_stats['failed'] += 1\n   110\t                    log(f'  ! {result.input_id[:60]}: {result.failed}')\n   111\t                    raise RuntimeError(f'item failed; day {day} remains resumable: {result.failed}')\n   112\t                if spend_cap_usd is not None and archive.totals()[1] - cost_before > spend_cap_usd:\n   113\t                    raise RuntimeError(f'spend cap {spend_cap_usd} reached on {day}')\n   114\t        finally:\n   115\t            if hasattr(results, 'close'):\n   116\t                results.close()\n   117\t        if finished != len(to_run):\n   118\t            raise RuntimeError('day runner did not complete every routed item')\n   119\t        seq = store.next_sequence(conn) - 1\n   120\t        judged = round_module.judge_day(conn, archive, cfg, day, seq, transport=transport, log=log)\n   121\t        day_stats['judged'] += judged.judged\n   122\t        day_stats['changed'] += judged.changed\n   123\t        if judged.failed:\n   124\t            day_stats['failed'] += 1\n   125\t            log(f'  ! day judging: {judged.failed}')\n   126\t            raise RuntimeError(f'judging failed; day {day} remains resumable: {judged.failed}')\n   127\t        closed = pull.end_of_day(conn, day, seq)\n   128\t        day_stats['closed'] = len(closed)\n   129\t        # The day ends at the last sequence it wrote, a closing's own sequence on a day without items included, so the next day starts after it.\n   130\t        store.complete_day(conn, day, store.next_sequence(conn) - 1, time.strftime('%Y-%m-%dT%H:%M:%S'))\n   131\t        conn.commit()\n   132\t        for key in totals:\n   133\t            totals[key] += day_stats[key]\n   134\t        calls, cost, _, _ = archive.totals()\n   135\t        day_cost = cost - day_cost_before  # Includes discarded speculative calls and repaired refusals.\n   136\t        open_count = len(store.open_views(conn))\n   137\t        log(f'{day} | items {day_stats[\"items\"]:3d} extracted {day_stats[\"extracted\"]:3d} merged {day_stats[\"merged\"]:2d} skipped {day_stats[\"not_processed\"]:2d} '\n   138\t            f'failed {day_stats[\"failed\"]:2d} | evidence {day_stats[\"evidence\"]:3d} new views {day_stats[\"new_views\"]:2d} judged {day_stats[\"judged\"]:3d} '\n   139\t            f'changed {day_stats[\"changed\"]:3d} closed {len(closed)} | open views {open_count} | day ${day_cost:.2f} total ${cost - cost_before:.2f} calls {calls - calls_before}')\n   140\t        if day0 and day == day0:\n   141\t            conn.commit()\n   142\t            shutil.copy(views_path, views_path + '.day0.sqlite')\n   143\t            log(f'day 0 snapshot written: {views_path}.day0.sqlite')\n   144\t    return totals\n     1\t\"\"\"D359: the code builds only the frozen production prompts, extraction v74i (D274) and judging-v7 (D354); a configuration that names\n     2\tany other version is refused before a request is built or sent.\"\"\"\n     3\timport dataclasses\n     4\timport os\n     5\timport sys\n     6\t\n     7\timport pytest\n     8\t\n     9\tROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))\n    10\tsys.path.insert(0, os.path.join(ROOT, 'src'))\n    11\tfrom hivemind import config, extraction, model  # noqa: E402\n    12\tfrom hivemind.views import judging  # noqa: E402\n    13\tfrom test_placement import ITEM, TEXT, UNI  # noqa: E402\n    14\tfrom test_theme_block import DAY, ledger  # noqa: E402\n    15\t\n    16\tV108 = config.load(os.path.join(ROOT, 'poc', 'config', 'poc-v108.json'))\n    17\t\n    18\t\n    19\tdef never_sent(*parameters):\n    20\t    raise AssertionError('a request of a version the code does not build was sent')\n    21\t\n    22\t\n    23\tdef test_an_extraction_version_other_than_v74i_is_refused_before_any_call(tmp_path):\n    24\t    other = dataclasses.replace(V108, extraction=dict(V108.extraction, T7=dataclasses.replace(V108.extraction['T7'], prompt_version='T7-v53')))\n    25\t    with pytest.raises(ValueError, match=\"extraction 'v53' is not built\"):\n    26\t        extraction.extract(model.Archive(str(tmp_path / 'archive.sqlite')), other, ITEM, TEXT, [], UNI, transport=never_sent)\n    27\t\n    28\t\n    29\tdef test_a_judging_version_other_than_v7_is_refused_before_any_call(tmp_path):\n    30\t    other = dataclasses.replace(V108, rejudging=dataclasses.replace(V108.rejudging, prompt_version='judging-v6'))\n    31\t    with pytest.raises(ValueError, match=\"judging 'judging-v6' is not built\"):\n    32\t        judging.round_of_judgements(model.Archive(str(tmp_path / 'archive.sqlite')), other, ledger(tmp_path), ['v1'], 2, DAY, transport=never_sent)\n   292\t\n   293\t# ---------- §4, test 5: filing ----------\n   294\t\n   295\tdef test_a_reads_link_is_not_a_narrower_home_and_a_seed_row_still_is(tmp_path):\n   296\t    conn = two_totals(tmp_path)\n   297\t    stored_link(conn, 'v2', 'v1')\n   298\t    assert store.direct_parents(conn, 'v2') == []\n   299\t    assert extraction.narrowest_links(['v1', 'v2'], {'v2': store.direct_parents(conn, 'v2')}) == ['v1', 'v2']\n   300\t    store.insert(conn, 'dependencies', view_id='v1', depends_on='v2', wait_chain_view_id='', wait_year='', direction='last_end', seq=0)\n   301\t    conn.commit()\n   302\t    assert store.direct_parents(conn, 'v1') == ['v2']\n   303\t    assert extraction.narrowest_links(['v1', 'v2'], {'v1': store.direct_parents(conn, 'v1')}) == ['v1']\n   304\t\n   305\t\n   306\t# ---------- §3, test 6: what the judge is shown ----------\n   307\t\n   308\tdef judged(conn, view_id, seq, reference, implied, reasons='Reasons line one.', rung=3, changed=1):\n   309\t    store.insert(conn, 'judgements', view_id=view_id, seq=seq, input_id='day', rung=rung, reasons=reasons, cited_evidence_json='[]', cited_views_json='[]',\n   310\t                 pushes_json='[]', changed=changed, why_changed='', config_checksum='x', call_id=0, request_sha256='', publication_day='2026-05-19',\n   311\t                 theme_pushes_json='[]', reference=reference, implied_outcome=implied)\n   312\t    conn.commit()\n   313\t\n   314\t\n   315\tdef test_judging_v8_shows_the_comparison_point_and_forecast_and_v7_is_unchanged(tmp_path):\n   316\t    conn = ledger(tmp_path, [('v1', TOTAL, TOTAL_RUNGS, 'Total revenue FY2027?'), ('v2', KEY, RUNGS, 'Data Center revenue FY2027?')])\n   317\t    stored_link(conn, 'v2', 'v1')\n   318\t    judged(conn, 'v1', 1, 'Consensus is $393B.\\n- e1 [fact] not an item', 'About $387B:\\nQ4 $112B.', reasons='Reasons.\\n[Evidence in view]')\n   319\t    user8 = judging.build_prompt(conn, 'v2', 'judging-v8')[1]\n   320\t    block = user8.split('[Current conclusions of the theses it depends on]\\n', 1)[1].split('\\n\\n', 1)[0]\n   321\t    assert block.splitlines() == [\n   322\t        '- v1 (open; first_is_bullish) Total revenue FY2027?: now rung 3 Neutral, judged 2026-05-19',\n   323\t        '    Comparison point stated by that judgement: Consensus is $393B.',\n   324\t        '        - e1 [fact] not an item',\n   325\t        \"    The system's forecast for it (our own judgement, not evidence): About $387B:\",\n   326\t        '        Q4 $112B.',\n   327\t        '    Reasons (excerpt): Reasons.',\n   328\t        '        [Evidence in view]']\n   329\t    assert judging.evidence_shown_in(user8) == {'e2'}\n   330\t    user7 = judging.build_prompt(conn, 'v2', 'judging-v7')[1]\n   331\t    assert '- v1 (open; first_is_bullish) Total revenue FY2027?: now rung 3 Neutral; reasons: Reasons.\\n[Evidence in view]' in user7\n   332\t    assert judging.build_prompt(conn, 'v1', 'judging-v7') == judging.build_prompt(conn, 'v1', 'judging-v8')     # no link: byte-equal\n   333\t\n   334\t\n   335\tdef judge_transport(changed_by_view):\n   336\t    def transport(provider, request, *args, **kwargs):\n   337\t        view_id = request['messages'][-1]['content'].split(' ', 2)[1]\n  - clear wrong merges 1/57, plus 2 overlaps;\n  - detail retention 22 = 22. This is a storage comparison: every record keeps its own text. It is not a usability test.\n\n  Dev ×3 on the frozen golden-v5 (a lead): helpful 214, 211 and 212 of 234; search 98.9–100%; clear wrong merges about 1%. Step 1\n  cost for the fresh set plus dev ×3: $4.20 at published rates.\n- **Steps 2 and 3** are built in isolation (`clean-arch/step2`, `clean-arch/step3`): search, comparison, grouping and later linking.\n  They are not integrated with production storage. **Step 4 (judging) has not passed** on the clean path: its ladder step is built and\n  measured (four Stage A runs, lines missed by 1 to 3 answers; D426), so nothing yet shows the clean system can judge an investment\n  view on its own questions.\n- **Step 2 is closed and frozen (Alex, D427, 2026-11-11;** [Step 2 log](../clean-arch/step2-validation-2026-11-07/LOG.md) §§14–19**).** It goes\n  to production only with the whole clean path, after Step 4 meets its lines; `tests/test_frozen_clean_step2.py` guards its files. Its three lines were met at the acceptance above (one draw; \"later version\"\n  relations barely exercised), and no miss of the seeded end-to-end test (clean 18, 18, 17 against production 17, 15, 16) has\n  been traced to it (the two single-draw misses were diagnosed on 2026-11-11, below: neither traces to Step 2). What happened since the close-out of 2026-11-08:\n  - A change to Jev's wording for \"later version\" relations failed its line (42 calls, 2026-11-09) and tuning stopped.\n  - One wrong relation was traced to the judge: it put NVIDIA's answer to the Kyber report under the FY2027 revenue question;\n    sent both ways, the conclusion did not differ ([result](../clean-arch/step2-edge-effect-2026-11-10/RESULT.md)).\n  - Alex stopped work on that relation (D423) and asked for a fix to the rule that gives a \"later version\" the older record's\n    questions. Measured on the three saved draws ([round log](../clean-arch/step2-revision-links-2026-11-10/LOG.md)), removing the\n    rule was withdrawn: of the 24 links it wrote, two blind reader families call 19 context and 3 evidence, and one of the 3 is a\n    company's answer that would otherwise be missing beside four reports (with it rung 2, 2, 2; without it 2, 3, 2). **The rule\n    stays (D424).**\n  - **Open, recorded:** Jev's \"later version\" relation (9 of 30 join different statements in draw 1); the context links it carries\n    (19 of 24); wrong groups (at the line on one draw; the unprompted reading test never run); the \"Unverified quote\" mark not\n    shown to Jev (3 of 188); not decided, whether a company's answer must sit under every question its report is filed under.\n  - **Reopens when** Step 4 yields judged views on the clean path and a miss, or something a reader of a thesis sees, traces to\n    one of these. The round's measurement kit (replay of a saved draw, exact simulation of a writer rule, blind packets with\n    controls, a judgement sent both ways) is kept in the two folders above.\n- **The clean system's untraced end-to-end misses, diagnosed (2026-11-11;** [round log](../clean-arch/e2e-misses-2026-11-11/LOG.md)**).**\n  The China share question in draw 3 and the FY2028 revenue question in draw 2 (seeded test, D392). Both estimates sit on a rung\n  line. China: the same window-end request, re-sent, gives the miss twice and the right answer once (the judge's own variation at the\n**The one next task (D711, 2026-11-21): Alex's choice on opening a citation-only judge version** (closed per-request id lists in the\nanswer format, tested at $0 end to end; `research/2026-11-21-whole-window/PILOT-RESULT.md`). The pilot of the paid whole-window\ncomparison is closed:\n- **Verdict:** inconclusive (D711). control-1 stopped on 09-08 on a double refusal: two one-character evidence-id copy errors. linked-1\n  completed and was accepted. $1.70 of Alex's $2.50 spent (D710).\n- **Exploratory, one pair, one draw:**\n  - Data Center is never above total revenue in linked-1. control-1 has 28 of 60 dates by the parser, and the sampled dates are real.\n  - Four linked total-revenue answers double count the stand-alone CPU forecast (H4).\n  - Linked refusals are at the H1 line (5 against 1).\n- **Council round 37 consensus:**\n  - no redraw or resume;\n  - the citation-only version is the recommendation;\n  - the link direction (a whole reading its own part) is a separate design.\n\nBefore the pilot: the census and the version-2 probe passed their gates (D702, D705); poc-v120 was built (D706); the paid design and\nthe pilot passed review (D707–D709).\n- **Open defects found by the pilot:**\n  - every refused judge answer seen is an id outside the field's list (17 in 5,408 attempts; poc-v118 and poc-v120);\n  - poc-v120's whole-reads-part link (total revenue reads stand-alone CPU) double counts.\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_23","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba clean-arch/e2e-comparison-2026-11-13/budget_replay.py | sed -n '225,239p'; rg -n 'schema_for\\\\(|\\\\bjudgement\\\\b|request_json|request_sha256' docs/research/2026-11-21-whole-window/{e2e_checks,read_census,paid_run}.py | head -75; rg -n '\"'^## D(198|354|359|694) '\"' docs/DECISIONS-log.md; rg -n 'judging-v9|judging-v10|poc-v121' --glob '\"'!*.stream'\"' . | head -50\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_23","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba clean-arch/e2e-comparison-2026-11-13/budget_replay.py | sed -n '225,239p'; rg -n 'schema_for\\\\(|\\\\bjudgement\\\\b|request_json|request_sha256' docs/research/2026-11-21-whole-window/{e2e_checks,read_census,paid_run}.py | head -75; rg -n '\"'^## D(198|354|359|694) '\"' docs/DECISIONS-log.md; rg -n 'judging-v9|judging-v10|poc-v121' --glob '\"'!*.stream'\"' . | head -50\"","aggregated_output":"   225\t\n   226\t\n   227\tdef llm_estimate(request):\n   228\t    price_in, price_out = model.PRICES[request['model']]\n   229\t    cap = request.get('max_completion_tokens', request.get('max_tokens'))\n   230\t    if isinstance(cap, bool) or not isinstance(cap, int) or cap <= 0:\n   231\t        raise model.TransportError('request without a positive output cap: refused by the budget')\n   232\t    tokens_in = 2 * len(json.dumps(request).encode('utf-8')) + 4096\n   233\t    return (tokens_in * price_in + cap * price_out) / 1e6\n   234\t\n   235\t\n   236\tdef whole(count):\n   237\t    return isinstance(count, int) and not isinstance(count, bool) and count >= 0\n   238\t\n   239\t\ndocs/research/2026-11-21-whole-window/paid_run.py:6:  python3 paid_run.py dry-refused-upstream <out> <draw>     # $0: v14's first attempt refused once on its third judgement, then answered\ndocs/research/2026-11-21-whole-window/paid_run.py:7:  python3 paid_run.py dry-double-refusal <out> <kind> <draw>  # $0: v9 refused twice on its second judgement (a terminal refusal)\ndocs/research/2026-11-21-whole-window/paid_run.py:11:`control` (poc-v118; the readers' old judgement rows retired by reader and day from each reader's link day). Every other request must\ndocs/research/2026-11-21-whole-window/paid_run.py:13:each). A request reaches the paid transport only when it is a judgement request (schema `judgement`) of a reader, made inside the\ndocs/research/2026-11-21-whole-window/paid_run.py:19:judgement answered by a fresh call made during its own day's judging, every pre-link one from the archive; the upstream snapshot check\ndocs/research/2026-11-21-whole-window/paid_run.py:52:COMPARISON = 'Comparison point stated by that judgement: '\ndocs/research/2026-11-21-whole-window/paid_run.py:53:FORECAST = \"The system's forecast for it (our own judgement, not evidence): \"\ndocs/research/2026-11-21-whole-window/paid_run.py:101:        family = [c for c, r in archive.execute(\"select call_id, request_json from model_calls where purpose='judge' and call_id>=?\", (accepted[0],))\ndocs/research/2026-11-21-whole-window/paid_run.py:144:    return schema.get('name') == 'judgement' and july_test.judged_view(request) is not None\ndocs/research/2026-11-21-whole-window/paid_run.py:205:        the prompt was built: its judgement day in the header, its comparison point, forecast and reasons excerpt line for line (a retry\ndocs/research/2026-11-21-whole-window/paid_run.py:232:                                                              f'(judgement {state[\"judgement_id\"]})'))\ndocs/research/2026-11-21-whole-window/paid_run.py:251:                view = text.split('judgement refused twice: ', 1)[1].split(':', 1)[0] if 'judgement refused twice: ' in text else None\ndocs/research/2026-11-21-whole-window/paid_run.py:281:    \"\"\"H2: every non-reader judgement equal to old-2's by question and day (the request and every substantive field); every other table\ndocs/research/2026-11-21-whole-window/paid_run.py:285:              'theme_pushes_json, changed, why_changed, request_sha256')\ndocs/research/2026-11-21-whole-window/paid_run.py:335:    for call_id, request_json, sha in archive_conn.execute(\"select call_id, request_json, request_sha256 from model_calls where purpose='judge' and call_id > ?\", (top,)):\ndocs/research/2026-11-21-whole-window/paid_run.py:336:        view = july_test.judged_view(json.loads(request_json))\ndocs/research/2026-11-21-whole-window/paid_run.py:370:        'every post-link reader judgement fresh on its own day': all(j['fresh on its day'] for j in judgements if j['must be fresh']),\ndocs/research/2026-11-21-whole-window/paid_run.py:371:        'every pre-link reader judgement from the archive': all(j['from the archive'] for j in judgements if not j['must be fresh']),\ndocs/research/2026-11-21-whole-window/paid_run.py:401:    \"\"\"$0: the sequence with a fake judge answering every bought judgement with markers unique to the sequence, the question and the\ndocs/research/2026-11-21-whole-window/e2e_checks.py:133:    p_sub[0]['segment judgement'] += 100000\ndocs/research/2026-11-21-whole-window/e2e_checks.py:134:    results['a substituted P judgement is refused'] = outcome(out, write(scratch, p_sub, h, gains), key_path)[0] == 'refused'\ndocs/research/2026-11-21-whole-window/e2e_checks.py:172:    sub[0]['company judgement'] += 100000\ndocs/research/2026-11-21-whole-window/e2e_checks.py:173:    results['pilot: a substituted P judgement is refused'] = decide(sub, h4, gains)[0] == 'refused'\ndocs/research/2026-11-21-whole-window/e2e_checks.py:224:    rows = [{'judgement': 1, 'view': 'v14', 'forecast': 'about $405B', 'reader': {'rule B material failure': False, 'cpu increment': 'quantified',\ndocs/research/2026-11-21-whole-window/e2e_checks.py:227:            {'judgement': 2, 'view': 'v9', 'forecast': 'about $360B', 'reader': {'rule B material failure': False, 'cpu increment': 'none', 'rule B inputs': ['$360B'], 'rule B reasoning': 'the quoted segment forecast as stated, arithmetic checked'}},\ndocs/research/2026-11-21-whole-window/e2e_checks.py:228:            {'judgement': 3, 'view': 'v9', 'forecast': 'about $390B', 'reader': {'rule B material failure': False, 'cpu increment': 'none', 'rule B inputs': ['$390B'], 'rule B reasoning': 'the quoted segment forecast as stated, arithmetic checked'}}]\ndocs/research/2026-11-21-whole-window/e2e_checks.py:272:        shared.setdefault(r['company judgement'], []).append(r)\ndocs/research/2026-11-21-whole-window/e2e_checks.py:288:    rows = [{'judgement': 1, 'view': 'v14', 'forecast': 'about $410B', 'reader': {'rule B material failure': True,\ndocs/research/2026-11-21-whole-window/e2e_checks.py:291:            {'judgement': 2, 'view': 'v9', 'forecast': 'about $380B', 'reader': {'rule B material failure': False, 'cpu increment': 'none',\ndocs/research/2026-11-21-whole-window/e2e_checks.py:293:            {'judgement': 3, 'view': 'v9', 'forecast': 'about $395B', 'reader': {'rule B material failure': False, 'cpu increment': 'none',\n2559:## D198 · 2026-10-27 · A judgement reads the evidence in view, not everything in force\n3685:## D354 · 2026-11-03 · Steps 3 and 4 (opening and matching questions, judging them) are frozen as `poc-v108` runs them, after three draws on the frozen extraction\n3798:## D359 · 2026-11-04 · The code builds only the frozen prompts (extraction v74i, judging-v7); old worktrees removed; the preflight reads the one-decider requests\n10439:## D694 · 2026-11-21 · Alex chooses A: links leave filing alone; new matching and judging versions open for linking; the July test after the council passes the $0 proof\n./reports/2026-11-05-system-design-reader.html:2437:- **Now:** the argument record is not built. Two versions were measured on 2026-11-04 (judging-v8 and judging-v9) and set aside, and their\n./docs/system-design/prd-bundle.js:8: \"docs/prd/05-extraction-standard-corrections.md\": \"# Corrections to the extraction standard page\\n\\nThe extraction standard page, [`05-extraction-standard.html`](05-extraction-standard.html) (its version 5), is piece 1 of the frozen ruler\\nand is never edited (D261, AGENTS §7.1). A statement in it that a later decision changed is recorded here, dated, with its reason and its\\nbefore and after; the page is read together with these records, which are never merged into it. Records 1–3 below correct the page's description of the pipeline and judging; record 4 describes a later decision for a new evaluation version. Historical gold and scores do not change.\\n\\nRecorded on 2026-11-05 (D368, on Alex's delegation: \\\"你看该怎么处理核实\\\"). Each statement was found verbatim in the page's text with its tags removed (the decision or PRD named at a quote's end is a link in the page).\\n\\n## 1. What the extraction sees\\n\\n- **Where:** §4, the test \\\"not a duplicate\\\" (\\\"抽取看不到库D211，这一条在抽取时只对同一篇文章里提出的几个问题判；和库里的比由匹配做\\\"), and §5.3,\\n  the row \\\"known facts restated\\\" (\\\"抽取看不到库，只能从文字和日期看\\\").\\n- **Before (D211):** the extraction request showed no question and no group of the library.\\n- **Now (D251, D264):** the request shows the questions open at the start of the item's day, each with its code-written takes line, and the\\n  extraction files each statement under them; it still sees no question's evidence or rung.\\n- **What still holds:** whether a candidate duplicates a question of the library is decided by matching (Jev with the collision judge,\\n  D169, D190); a restated known fact is still recognised from the text and its dates, since the extraction sees no stored evidence.\\n\\n## 2. The research deliverable\\n\\n- **Where:** §7 (\\\"研究的交付物是论证：保留不可改的来源记录，和一份有版本的研究论证，写明支持和反对的来源、是否独立、变化和局限D201\\\").\\n- **Before (D201):** the library would keep, besides the source records, a versioned research argument per question.\\n- **Now:** the argument record is not built. Two versions were measured on 2026-11-04 (judging-v8 and judging-v9) and set aside, and their\\n  code removed at Alex's word (\\\"好，删掉卡片代码\\\"; `docs/research/2026-11-04-argument-record/log.md`, rows 4–11). The library keeps the\\n  immutable source records, and each judgement stores its reasons, the outcome it implies and the evidence it cites with each piece's\\n  direction.\\n\\n## 3. What decides a question's rung\\n\\n- **Where:** §5, the relations between tiers (\\\"判断时只有事实能确定到期落在哪一档PRD 06\\\"), and §7 (\\\"只有事实能确定落在哪一档PRD 06\\\").\\n- **Before:** only the \\\"fact\\\" tier could establish the rung; the other tiers strengthened or weakened.\\n- **Now (D260, D263):** a judgement is a forecast: the rung the evidence in force makes most likely at the due day, judged against a\\n  reference (consensus, guidance, the stated plan or deadline); \\\"not established\\\" is never a reason to stay. The four tiers and counting\\n  by original source stand (D30): a fact fixes what is known, a party's own statement is the strongest input to the forecast, and views\\n  and rumours move it by their specificity. PRD 06 states the rule.\\n\\n\\n## 4. Capture of core and supporting evidence (D369; 2026-11-05 UTC)\\n\\n- **Where:** §6 and §9.2–9.3 distinguish core and supporting, and score each separately.\\n- **Before:** core and supporting had separate evaluation thresholds under the frozen v5 ruler.\\n- **Future evaluation:** Alex decided that both should be captured without a strict pass/fail boundary between them. An indirect item may be retained when the model judges it relevant and the logic is clear; the reviewed MXC announcement is retained as supporting. Do not present inference as a sourced fact. The optional and not-kept boundaries, source tiers and quality checks are not changed by this decision.\\n- **Status:** the v5 page and its gold remain frozen. A new evaluation version and its gold require derivation, independent review and Alex's sign-off before scoring; old scores retain their original definitions.\\n\\n## 5. Research-library context timing (D375; 2026-11-05)\\n\\n- **Before:** D251/D264 described the open-question snapshot at the start of the item's day.\\n- **Current design:** Alex decided that each item reads the latest committed questions immediately before it, including earlier same-day writes. The two split extraction calls for that item share the same snapshot.\\n- **Status:** this changes the product design, not the frozen standard page or its historical gold and scores. The existing default still uses day-start context; implementation and acceptance of the new path are pending.\\n\",\n./docs/prd/05-extraction-standard-corrections.md:23:- **Now:** the argument record is not built. Two versions were measured on 2026-11-04 (judging-v8 and judging-v9) and set aside, and their\n./reports/step2-after-failed-probe-council-2026-11-09/claude-r1.jsonl:9:{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_015MmWeEk1EUQis8xwzNsxN6\",\"type\":\"tool_result\",\"content\":\"1\\t# Current state\\n2\\t\\n3\\t**Clean Steps 1–3, current (2026-11-09).** Record: [round log](../clean-arch/step1-unfiled-2026-11-08/LOG.md) §§16–47.\\n4\\t- **Step 1 configuration: c8, adopted by Alex (D387).** It runs DeepSeek Flash at high effort, with a 64,000-token output cap; a\\n5\\t  format failure or a cut answer is resent once (D380). It carries Alex's decisions D382–D385:\\n6\\t  - figures are conditions;\\n7\\t  - material statements with no thesis are kept without links;\\n8\\t  - only big matters open a thesis;\\n9\\t  - no target prices.\\n10\\t\\n11\\t  [PRD §12](../clean-arch/PRD.md) holds its system prompt, closing check and schema; a run with no candidate files sends exactly the\\n12\\t  accepted request.\\n13\\t- **Acceptance (D386, [protocol](../clean-arch/step1-unfiled-2026-11-08/ACCEPTANCE-PROTOCOL.md)).** 50 fresh articles that no run,\\n14\\t  old or new, had used: news from 2026-09-05 to 09-07, a holiday weekend with no NVIDIA posts. One draw; two readers and a third on\\n15\\t  disputes.\\n16\\t  - helpful 132/139 (core 83/83);\\n17\\t  - wrongly opened theses 1 of 10;\\n18\\t  - search 141/143 available repeat pairs, or 141/145 for the whole system (one 11-article story supplies 55 pairs, and revisions are\\n19\\t    barely exercised);\\n20\\t  - clear wrong merges 1/57, plus 2 overlaps;\\n21\\t  - detail retention 22 = 22. This is a storage comparison: every record keeps its own text. It is not a usability test.\\n22\\t\\n23\\t  Dev ×3 on the frozen golden-v5 (a lead): helpful 214, 211 and 212 of 234; search 98.9–100%; clear wrong merges about 1%. Step 1\\n24\\t  cost for the fresh set plus dev ×3: $4.20 at published rates.\\n25\\t- **Steps 2 and 3** are built in isolation (`clean-arch/step2`, `clean-arch/step3`): search, comparison, grouping and later linking.\\n26\\t  They are not integrated with production storage. **Step 4 (judging) is not built** on the clean path, so nothing yet shows the clean\\n27\\t  system can judge an investment view.\\n28\\t- **Step 2 revision-target probe (2026-11-09):** an isolated 42-call original-versus-candidate Jev comparison failed its predeclared improvement condition; existing wrong links persisted. The candidate is not adopted and this line stops without tuning on those cases. The selected sample cannot estimate overall accuracy or downstream impact. [Step 2 log §14](../clean-arch/step2-validation-2026-11-07/LOG.md).\\n29\\t- **Open defects, by product impact** (reflection council, `council/av-codex.md`):\\n30\\t  1. **The Ohio-guarantee yes/no question is never covered** in the three dev draws; a broader credit-support amount thesis opens\\n31\\t     instead. Diagnosed (round log §48): the model folds the unsigned guarantee into the open aggregate thesis because the request\\n32\\t     uses \\\"covers\\\" both for \\\"is evidence for\\\" and for \\\"already asks this question\\\". The same clause sits under link clutter.\\n33\\t  2. **A revenue-share thesis was opened** (Vera Rubin's share of data-center revenue), the class-A boundary of D382.\\n34\\t  3. **Link clutter.** A blind recheck of the 34 disputed fresh links found 19 weak and 2 wrong; 10 accepted links mixed in as controls were all useful; the other 49 links were not rechecked.\\n35\\t     The model's own account names topic or theme overlap and inference chains, and c8's closing check never reads back a link. This is\\n36\\t     a likely cause, with no fix proven. Alex approved designing a protected link check through the council; a first draft was stopped\\n37\\t     because it would drop founding premises and contrary facts.\\n38\\t  4. **Unverified passages:** 3 of 188 fresh records and 1–3 per dev draw. The mark now travels into Step 2's records, and a reader sees the found source text or an \\\"Unverified quote\\\" label. Jev's comparison input still carries the model's text without the mark; changing it changes measured Step 2 behaviour and needs its own measurement.\\n39\\t  5. **The lidar policy thesis** recurs at the boundary (one dev draw in three).\\n40\\t- **History.** These earlier states are superseded:\\n41\\t  - the 2026-11-07 takeover (K5 → K6b; [takeover log](../clean-arch/takeover-2026-11-07/LOG.md));\\n42\\t  - the 2026-11-08 close-out (K6b test 32/42; Step 2 first lines; [Step 2 log](../clean-arch/step2-validation-2026-11-07/LOG.md) §12);\\n43\\t  - the unfiled fix round and the c1–c7 arms (round log §§1–39).\\n44\\t- **No run is live.** The branch is committed through the D388 line (round log §§48–59).\\n45\\t\\n46\\t**Clean Step 1 source investigation (2026-11-07):** A [source-loss census](../clean-arch/STEP1-SOURCE-LOSS-CENSUS.md) traces two separate losses in the historical cleaner and records reproducible corpus observations. Offline candidate comparisons expose both recovered content and source-identity or contamination risks. A subsequent [full-page diagnostic](../clean-arch/STEP1-FULL-PAGE-RESULTS.md) completed 102 calls on 17 selected articles and independent source-backed review. It exposes examples of both missing or misattributed source text and model errors that persist despite the right text being present. A Codex–Claude council is reviewing the results and earlier attempts; no source-cleaning candidate is adopted, and the source corpus and production defaults are unchanged.\\n47\\t\\n48\\tAlex has authorized correcting the test-source cleaner and test data when their defects are confirmed, while the frozen production configuration and ruler remain intact. The cleaner switched 615 originally fed articles off; a replay reproduces all 615, and direct inspection confirms an actual article excluded because its 9,874-character body was flattened to one line. Other examples include a wrong-site shell, paywall and long challenge code, so the false-exclusion count and a general article-identification repair remain to be established. The [council regroup](../clean-arch/STEP1-SOURCE-REGROUP-COUNCIL.md) and [source-preservation design](../clean-arch/STEP1-SOURCE-PRESERVATION-DESIGN.md) describe an isolated candidate checked against all 34,084 records, with a fake-answer actual-runner handoff and provenance display in the replay renderer. The [five source-control calls](../clean-arch/STEP1-CAPTURE-CONTROLS-RESULTS.md) completed and were source-reviewed; two items contain summary details absent from their attached quotations, and one source-visible risk explanation was not returned. This is selected-case evidence, not a general quality result. Broader source-quality comparison, citation completeness and actual writer integration remain open.\\n49\\t\\n50\\t**Clean architecture Step 1 (2026-11-06, isolated work on `clean-arch`):** Alex reopened work with the clean architecture. An experimental prepared-source handoff now preserves the archived page, prior cleaned text, source-role decisions and selected-line mapping without changing the original database; quotations for prepared items must also occur contiguously in the original captured page. Two seven-item runs are available in the [clean architecture PRD](../clean-arch/PRD.md), one in the earlier selection order and one in recorded page-timestamp order. The source selector is not a production service and source ordering is not established event-arrival ordering. The runs expose unresolved semantic problems: citations can omit supporting facts despite an exact location match; model output can change a benchmark into a deployment, reverse a backup relation, omit a named customer or assign an unstated currency. A blinded 84-call check-placement/wording comparison and a 27-call same-article citation-completion diagnostic did not give a clean semantic fix and are not adopted. The latter missed an omitted connectivity condition and a reversed backup relationship, and left six expected evidence reviews unaddressed. A further five-round Codex–Claude council produced a narrowly scoped Step 1 link candidate, independently checked for prompt-contract drift. A six-article, 36-call blind comparison completed; the candidate still produced an explicitly self-contradictory link and both arms consistently omitted the same Kyber report and company response. It is not adopted and has not changed the active PRD prompt. A trace confirms that both the Kyber report and open Kyber thesis were supplied, and the raw model answers omitted the report and denial; the reason is not established. See ../poc/data/clean-step1-kyber-trace-2026-11-06/TRACE.md. An isolated six-call comparison showed that hiding the Kyber thesis did not recover the report or denial in any draw. A second six-call comparison returned them in 3/3 draws with the original Kyber paragraph alone and 0/3 with the full article; length, position and surrounding content changed together, so the reason is not isolated. Excerpt outputs have source-attribution limitations. Neither experiment changed state or established a production fix. (Superseded: the next task then was a whole-article coverage approach; the current next task is under \\\"One next task\\\".) See ../clean-arch/STEP1-IMPLEMENTATION-COUNCIL.md. The earlier four-round council agreed that no tested semantic fix is ready; its next investigation is a source-backed review of the 49-item historical run and its 160 evidence records, with overlapping issue flags and separate article-level omissions, then a separate comparison of the seven-item replays. See ../clean-arch/STEP1-COUNCIL-REVIEW.md. Preserve relevant evidence while identifying the next intervention; production/frozen history remains as described below. See [Step 1 run log](../clean-arch/STEP1-RUN-LOG.md) and [English reading page](../clean-arch/architecture.html).\\n51\\t\\n52\\t**Sealed (D379, 2026-11-06):** Alex asked to clean up and seal this version while he re-plans the system design. Work stops here and is sealed as it is: main's working tree is committed on branch `seal/2026-11-06` (tag `sealed-2026-11-06`) and merged into `main` on Alex's word (PR #10); the sealed split and two side experiments are pushed on their own branches (D379). No PRD 11 experiment is open, and the E1 next task below is withdrawn. The next task is Alex's re-planned system design.\\n53\\t\\n54\\t**E1 diagnosed (2026-11-06, Alex chose E1):** of 57 helpful matters frozen production wrote and then dropped, two readers agree on 17 link misses (4 core), 3 opening misses (1 core) and 24 small matters the standard itself drops; 10 are disputed on the fallback clause and 3 were quote refusals. Opening is not the experiment. The core of the link misses is the model reading a question's period, population or named configuration as a boundary; only 8 of the 13 window draws it dropped were lost to the product. No production change; $0.02 of probes. My recommendation was to fold that narrow change into the next extraction version; withdrawn by the seal (D379). Details: `docs/research/2026-11-06-e1-no-home-drops/README.md`, PRD 11 E1.\\n55\\t\\n56\\t**Split extraction sealed as a failed experiment (D378, 2026-11-06):** the split (a new-question call, an evidence call and record preparation) was benchmarked against the frozen poc-v108 and failed. Its stop line fired: helpful matters 156, 156, 159 against 166, 170, 162, with about 15% higher cost. One screened revision kept more noise than production. It is sealed in the worktree `hivemind-no-preseed-evidence-review` (tag `split-extraction-failed-sealed-2026-11-06`), and nothing of it is in main. What it taught is written as proposed production experiments in `docs/prd/11-production-experiments-from-split.md`: E1 no-home helpful drops, E2 duplicate questions, E3 ladder checks with D186, E4 judge refusals, E5 D203's revision day, E6 the measurement kit. Each opens only on Alex's word.\\n57\\t\\n58\\t**Question-catalog limit removed (D377, 2026-11-05):** Alex also directed removal of the separate 150 KB catalog rejection. The research reader in this worktree now has neither the catalog nor evidence byte limit; it retains full scoped questions, historical boundaries, dependencies and evidence. A portable 326,996-byte catalog test returns all 400 new questions and expands evidence both after reading the catalog and directly; the old 150 KB guard fails the same test in a scratch copy. The saved 69-question pilot catalog and all 69 saved evidence expansions match their original content hashes. Details: `docs/research/2026-11-05-catalog-limit/`. The full suite remains pending until the paid seven-day run no longer competes for resources. The run remains in its isolated worktree and does not call this research reader.\\n59\\t\\n60\\t**Evidence reader limit removed (D376, 2026-11-05):** Alex directed removal of the reader's 1 MB evidence-expansion rejection. In this worktree, `research_context.Reader.expand` now returns the entire evidence payload without that cap, while the catalog's separate limit remained at that checkpoint; D377 subsequently removed it. On the saved pilot ledger, all 69 individual question expansions, the four-question 1,931,225-byte pilot request and the entire 3,454,076-byte catalog produce the exact same content as the pre-change high-limit baseline; the portable oversized-ledger test passes and fails when the old cap is restored in a scratch copy. Details and snapshot-specific measurements are in `docs/research/2026-11-05-reader-limit/`. The seven-day diagnostic runs in `/Users/lchingen/hivemind-no-preseed-evidence-review/poc/data/split-fresh-seven-day-2026-11-05-v2/` with its pinned code; it does not call this research reader. Read its status through its `snapshot.sh`; do not edit its package code while it is live. This change is not an acceptance of seven-day extraction or judgement quality.\\n61\\t\\n62\\t**Start-state correction (2026-11-05):** Alex requires a research library established from real material available before the test start, then extraction against that state. The prior empty-library diagnostic cannot represent this case. Our own mistakes and the current 68-question provenance audit are in `../hivemind-no-preseed-evidence-review/docs/research/2026-11-05-parallel-refinement/own-mistakes-2026-11-05.zh.md`. Two new A-only calls were run on 2026-08-29 articles using the 68-question prior-day snapshot; both proposed the same aggregate supply-commitments topic. A source/context review judged it distinct from the existing specific SK Hynix question. A third A-only call on an author-body excerpt about DLSS 5, already tracked by v22, passed; the prompt also restricts software updates, so the reason is not established. No writer or dedup ran; source-history completeness remains unverified, and this is not scored acceptance. Details: ../hivemind-no-preseed-evidence-review/docs/research/2026-11-05-parallel-refinement/start-state-diagnostic-2026-11-05.zh.md.\\n63\\t\\n64\\t**Measurement correction (2026-11-05):** Alex clarified that a gold-worthy topic already in the supplied library should not open again; an absent worthy topic should open. The earlier simple-A claim of a \\\"missed\\\" new topic was not scored against that rule and is withdrawn as a correctness conclusion. In the actual experiment, a Kyber topic was shown and passing follows Alex's topic-level rule; whether its exact release question captures the shipping milestone remains unverified. The experimental pre-article snapshots differ from the replay's day-start snapshots; 9 of 10 inspected examples differ. The current uncommitted replay default does not build a cold-start library; committed main HEAD still uses the old seed and startup filing path. Historical lexical coverage has a confirmed unrelated-topic match. The frozen gold and past scores remain unchanged. Audit: `../hivemind-no-preseed-evidence-review/docs/research/2026-11-05-parallel-refinement/measurement-context-scrub-2026-11-05.zh.md`.\\n65\\t\\n66\\t**Simple new-question diagnostic (2026-11-05):** At Alex's direction, an isolated prompt returned new questions plus article evidence without asking for product database fields. Four previously seen real dev articles each ran once: three returned one candidate, one returned none, all four quotes matched their source, and the gold-listed GPU backstop amount question was not proposed. Whether that omission is a new-topic miss depends on whether the existing library covers the topic. Two other candidates require source and independent-significance review; the actual experimental snapshot already had a Kyber topic, so its pass follows Alex's topic-level rule; whether its exact release question captures the shipping milestone remains unverified. This is not a production or full-pipeline acceptance. Details: `../hivemind-no-preseed-evidence-review/docs/research/2026-11-05-parallel-refinement/simple-new-question-results.zh.md`.\\n67\\t\\n68\\t**Split prompt structure v3 read diagnostic (2026-11-05):** One real reading-stage call on a previously seen article found the revenue/margin guidance and Trainium scale but omitted the gold China revenue/market-loss matter. The prewritten stop condition was triggered and the linking call was not sent. This is one draw and not a production or end-to-end result. See `../hivemind-no-preseed-evidence-review/docs/research/2026-11-05-parallel-refinement/structure-v3-read-result.zh.md`. D374 removes the model sampling field from active settings and default configs; historical config files and archives retain their original bytes.\\n69\\t\\n70\\t**Split prompt structure v2 small test (2026-11-05):** Thirty calls on two previously seen golden-v5 dev articles completed in `../hivemind-no-preseed-evidence-review`. The blind model reader found complete helpful matters in the fresh control versus new A+B of 6/19 vs 10/19, 11/19 vs 7/19, and 9/19 vs 12/19. The new arm also retained more gold not-kept matters in each draw; B missed useful margin guidance and one answer reused IDs, with a demonstrated matching collision. This is not a production acceptance. See `../hivemind-no-preseed-evidence-review/docs/research/2026-11-05-parallel-refinement/structure-v2-results.zh.md` and `reports/2026-11-05-parallel-structure-v2.html`.\\n71\\t\\n72\\t**Split extraction small test (2026-11-05):** At Alex's request, the isolated `hivemind-no-preseed-evidence-review` worktree ran two real golden-v5 articles once through each split lane. An independent model reader found 7 of 19 helpful gold matters fully retained, two partial, two written then dropped, eight missed, and one retained gold not-kept matter. Three saved v108 draws on these articles retained 7, 9 and 12 of 19, but used 22 seeded questions while the new test used 8/10-question snapshots; these are not directly comparable. The experiment remains unaccepted; see `../hivemind-no-preseed-evidence-review/docs/research/2026-11-05-parallel-refinement/small-scored-test-20261105.md` and `reports/2026-11-05-split-small-test.html`.\\n73\\t\\n74\\tAs of November 5, 2026; decisions through D374. [Decisions](DECISIONS.md) holds what is decided now; the [design page](system-design.html) and the [module PRDs](prd/README.md) hold what the code must do; the [README](../README.md) holds startup, build and run instructions.\\n75\\t\\n76\\t## Future evidence scoring (D372)\\n77\\t\\n78\\tAlex decided future gold scoring should measure helpful versus not helpful evidence without requiring separate scores for core and supporting. Use frozen golden-v5 as-is: combine core and supporting as helpful, treat not-kept as unhelpful, and keep optional entries neutral. A counting report has not yet been implemented. Historical scores retain their original definitions. D373 removes the stop caused by a separate concern about three question-gold entries: keep the gold unchanged, continue scoring and disclose the concern; see `../hivemind-no-preseed-evidence-review/docs/research/2026-11-05-parallel-refinement/ruler-conflict-2026-11-05.zh.md`.\\n79\\t\\n80\\t## Latest decision (D369)\\n81\\t\\n82\\tAlex decided in D369 to capture core and supporting evidence without a strict boundary and in D370 to remove the 22 preset starting questions and separate earnings-report import. The replay entry now defaults to `poc-v118` (D374), refuses old seeded ledgers and baseline configurations, and continues to read existing non-seeded questions; earnings releases remain normal source items. This change has local contract tests but has not passed end-to-end product acceptance. The frozen historical rulers and results remain unchanged.\\n83\\t\\n84\\tThe small 2026-11-05 study used three archived NVDA articles and an 8/28 historical 68-question snapshot: without versus with an appended report, independent AI review found 14/27 versus 13/27 complete matters. This measured appended extraction context, not the distinct former coverage-start step; D370 removes both by Alex's decision. Full traces and limitations are in the separate `hivemind-no-preseed-evidence-review` worktree under `docs/research/2026-11-05-real-input-evidence/existing-library-results-2026-11-05.md`.\\n85\\t\\n86\\t\\n87\\t**One-day smoke completed (2026-11-05 UTC):** Alex requested a quick 1–2 day end-to-end test. One day, 2026-08-29, ran in `/Users/lchingen/hivemind-no-preseed-evidence-review/poc/data/v117-one-day-smoke-2026-11-05/`: config v117, an 8/28 historical library, 40 extraction calls, 93 evidence records written, four new questions, 54 judged and zero terminal failures. Two judgement attempts were refused and corrected. A Microsoft revenue forecast of $391.1bn was assigned to a rung whose upper bound excludes $391.1bn; the same article's actual quarterly revenue and next-quarter guidance were dropped with no home. Some source dates and bodies are not verified, and an independent 14-article sample review was incomplete due to truncated text. This is not semantic or production acceptance. Findings and scope: `docs/research/2026-11-05-real-input-evidence/one-day-v117-smoke-2026-11-05.zh.md` in that worktree. The clean source-text comparison and its condition-hidden review are complete; council discussion of next steps is ongoing.\\n88\\t\\n89\\t**D371, in progress:** Alex directed that present and forward-looking revenue and financial information should be tracked. Diagnose the same-day extraction and filing losses before designing a general change. No new financial tracking implementation has been accepted yet. The old frozen standard and gold are unchanged. The original prompt-only pilot failed design review. The user approved an exact prompt addition for an experiment; it is not a production implementation. Four paired real-article diagnostic calls per arm completed for the exact approved sentence: v74i versus experimental role-d371-pilot. Microsoft next-quarter guidance and NVIDIA FY2028 guidance still dropped in the treatment; a single draw is not acceptance or proof of causation. Details: docs/research/2026-11-05-real-input-evidence/d371-prompt-pilot-results.zh.md (isolated worktree). The requested full prompt audit and restructure were drafted experimentally; five real-article paired diagnostic requests per arm completed. Microsoft revenue guidance was missed in both arms, and the draft produced unsupported original dates, a quote refusal and suspect links. No production prompt change or acceptance; see restructure-pilot-results.zh.md in the isolated worktree.\\n90\\t\\n91\\t**Clean Step 1 coverage council (2026-11-06):** Codex and Claude Code independently reviewed the existing attempts and completed three discussion rounds. The proposed next research candidate moves the existing evidence-reading block ahead of the thesis-opening block while preserving the article, open-thesis state and paired output. It is a hypothesis, not an implemented or validated fix. A complete prompt/contract audit and independent review precede any controlled Luna comparison. Historical paragraph-based and source-first experiments, their noise and attribution problems, and the rejected overlap-based merge are recorded in [the council review](../clean-arch/STEP1-COVERAGE-COUNCIL.md). No new Luna experiment was run in the council.\\n92\\t\\n93\\t**Clean Step 1 coverage order result (2026-11-07):** The isolated 54-call clean comparison completed and all answers were reviewed blind. Moving the evidence-reading block recovered a known Kyber report and denial in one of three candidate answers against none in three controls, with attribution blur; it also produced unsupported gaming-to-AI links in two candidate answers and no controls. It is not adopted. A separate exact-quote example misattributes an executive's prediction in the standalone summary. [Results and replay](../clean-arch/STEP1-COVERAGE-ORDER-RESULTS.md) record all selected cases, uncertainties and source-fidelity work; no production ledger was written.\\n94\\t\\n95\\t**Clean Step 1 fidelity council (2026-11-07):** Codex and Claude Code completed five rounds on source attribution, conditions, dates and meaning. No tested fix or root cause is established. The agreed source-to-record review of 49 articles / 160 evidence items and the subsequent isolated field-order comparison are complete; the later 54-answer / 217-record repeated sample remains separate. Prior source-first, quote-first and follow-up-review experiments and their limits are recorded in [the fidelity council](../clean-arch/STEP1-FIDELITY-COUNCIL.md). No Luna experiment or production change was made in this council.\\n96\\t\\n97\\t**Clean Step 1 fidelity review (2026-11-07):** All 49 saved source packets and 160 original evidence items have received a source-and-record review; focused independent cross-checks cover the findings and selected controls. The [review and article replay](../clean-arch/STEP1-FIDELITY-REVIEW.md) distinguish source contamination and missing source material from model meaning, citation, date and link issues. The [isolated schema property-order diagnostic](../clean-arch/STEP1-CITATION-ORDER-RESULTS.md) completed all 66 calls and condition-blinded article reviews. Several omissions and semantic errors persisted; it did not establish a fix and is not adopted. It used saved articles and before-states without changing production.\\n98\\t\\n99\\t**Clean Step 1 source handoff council (2026-11-07):** The ongoing [council and offline checks](../clean-arch/STEP1-SOURCE-HANDOFF-COUNCIL.md) reconstructed 16 matching article-34 controls, all omitting a Kyber report and denial; the cause remains unknown. The 20-article saved source-role overlap review distinguished previously cited AI-generated summary lines and an unrelated recommendation from authored body. The clean runner does not send the saved source-role labels; the council chose to first compare original and previously selected source text on ten known articles. The isolated 60-call source-text comparison and condition-hidden review are complete; [results](../clean-arch/STEP1-SOURCE-TEXT-RESULTS.md) show specific contamination reductions alongside persistent omissions and changed meaning. It did not advance state or write production. The isolated six-article low-versus-medium source-fidelity diagnostic completed 36/36 calls and condition-hidden review. [Results](../clean-arch/STEP1-REASONING-FIDELITY-RESULTS.md) show partial improvements alongside persistent source-qualification and attribution concerns; no production setting is changed. The [prompt audit](../clean-arch/STEP1-FIDELITY-PROMPT-AUDIT.md) maps the observed failures to the full request and signed standard. The six-article isolated schema-description comparison completed 36/36 calls and condition-hidden review; the candidate did not preserve the repeated example qualification and is not adopted. [Results](../clean-arch/STEP1-SUMMARY-FIDELITY-RESULTS.md). A further six-article 36-call low-versus-medium comparison used corpus-cleaned sources outside the original 49-item clean replay and a fixed exploratory context; results were mixed, including unsupported links and incorrect attribution/date fields. [Results and replay](../clean-arch/STEP1-ADDITIONAL-SOURCES-RESULTS.md). The structured-claims candidate was not sent after review revealed scope and complexity concerns. Council review of the next action is ongoing. The date-text schema-description diagnostic completed 48/48 calls on eight known cases, with mixed results; the candidate is not adopted. A selected-run census found twelve literal \\\"null\\\" strings in date-text fields, but no production writer impact is established. [Results and replay](../clean-arch/STEP1-DATE-DESCRIPTION-RESULTS.md). A further preregistered eight-source date comparison completed 48/48 calls; the candidate lost a supported company-article statement date in all three draws on one source and is not adopted. [Results and replay](../clean-arch/STEP1-DATE-NEW-SOURCES-RESULTS.md). A bounded corpus census confirmed 163 source pages across three explicit generated-summary structures whose labels were removed while some summary text was retained; two NVIDIA cases were reproduced through the cleaner. [Source provenance investigation](../clean-arch/STEP1-SOURCE-PROVENANCE-CENSUS.md). A read-only source-lineage replay reproduced 363/363 cleaned pages with current inputs, preserved ambiguous original-line locations, and surfaced the generated-summary label loss for review. [Source investigation and lineage replay](../clean-arch/STEP1-SOURCE-PROVENANCE-CENSUS.md). An offline neighboring-context observation exposed only 144 or 149 of 163 known labels and introduced many other page lines; it is not adopted as a general source fix. [Observations and viewer](../clean-arch/STEP1-SOURCE-CONTEXT-OBSERVATIONS.md). A new [saved-quote integrity investigation](../clean-arch/STEP1-QUOTE-INTEGRITY-CENSUS.md) reconstructed 360 saved answers across eight overlapping cohorts, including 78 prepared-source calls. Five saved unverified passage instances were complete matches under the existing normalization; an in-memory candidate recovered their original slices, while ten others remained unverified. The normalized source-slice lookup is now installed only in the isolated clean Step 1 runner; saved-answer and entry-point checks are recorded there. Page provenance, Unicode completeness, production resource budgets and writer integration remain open. The existing writer stores only one quote, whereas 63 of 160 evidence items in the 49-article exploratory trace have multiple passages. A [source-first 49-article coverage review](../clean-arch/STEP1-COVERAGE-CENSUS.md) separates material missing from the model input from source-visible omissions in the saved answers, with uncertain matter boundaries labeled. (Superseded: the next investigation then was why supplied material is missed; the current next task is under \\\"One next task\\\".) The canonical prompt and production configuration remain unchanged. Adding fallible role annotations remains a separate untested candidate. Council streams and handoffs are in `poc/data/clean-step1-ongoing-council-2026-11-07/`.\\n100\\t\\n101\\t## What runs\\n102\\t\\n103\\t- **Pipeline (replay default `poc/config/poc-v118.json`, D370, D374).** Every item reads the relevant open questions from the library at the start of its day, then extraction v74i on `gpt-6-luna` proposes evidence and questions; Jev matching with the collision judge matches them; code writes the records; judging-v7 judges changes once a day; pull mode closes due questions. There is no separate seed or coverage-start report import, and reports as source items remain eligible. This default has not completed end-to-end acceptance. The [pipeline guide](poc/pipeline-plan.md) maps stages to code.\\n104\\t- **Measured:** one company (NVDA) over one 14-day window (2026-07-01 to 07-14), the judgement scored at the window end on the frozen ruler (AGENTS §7.1). Three draws of `poc-v116` against three of `poc-v108` run in the same hours: 53 against 45 agreements of 57; operating margin and capex agree in 3 of 3 draws, never judged without the coverage-start reading ([acceptance](research/2026-11-04-filing-end-to-end/acceptance-design.md)).\\n105\\t- **Served data:** the service, the MCP server and the standalone page serve the sealed three-month ledger `served-2026-10-28-v34-nvda-3m-through-0828` (68 theses, 34 groups; D358), built by the earlier `poc-v34` pipeline, not by the replay default. HTTP `/library`, MCP `thesis_library` and the standalone page share the dated bundle writer.\\n106\\t- **Idea API:** `poc-v118-idea` (D290, D335, D374): two discovery calls and one adoption and weighting assessment; only adopted theses with positive weights appear, and nonempty plans total 100%. The [Idea contract](poc/idea-card.md) owns its fields and the limits of its scores.\\n107\\t- **Interface:** the Thesis Library and Explore Ideas workspaces, with the confidence Trigger and an Action preview (no wallet connection or order execution). The [UI specification](poc/thesis-ui.md) and the [integration guide](../poc/ui/README.md) own its behaviour.\\n108\\t- **Repository:** `main` holds the product, the frozen ruler and the research records; run databases, logs and model archives stay on disk (D353), located by the [data manifest](research/2026-10-25-english/data-manifest.md). Worktrees: `/Users/lchingen/hivemind` is the main checkout, where slice branches are cut from `main`; `/Users/lchingen/hivemind-extraction-quality-2026-10-28` (the extraction branch, merged on 2026-11-03) keeps in its ignored folders the stored end-to-end runs of `poc-v91` to `poc-v95` that later comparisons read (D359); `/Users/lchingen/hivemind-run-v109-2026-11-04` is the finished judging-v8 run's worktree. Older branches stay in Git without worktrees (D359); none is merged work in progress. The clean source-text comparison and its condition-hidden review are complete; council discussion of next steps is ongoing.\\n109\\t\\n110\\t## Open defects\\n111\\t\\n112\\t1. **Competitor and customer news is filed under the company's revenue questions** instead of the share, capital-spending or custom-chip question it informs (D355; filing is otherwise about 85% right). Share facts are often not written at all, an extraction recall miss. The total-revenue question holds about a quarter of all links (D354).\\n113\\t2. **One bet opened twice** about one encounter in five: the collision judge splits a seed question from an identical candidate on a fine detail (D354).\\n114\\t3. **A question the standard rules out** (the lidar legislation) was proposed by the extraction and opened in one draw of three (D354).\\n115\\t4. **A thesis opened from an article gets no dependency of its own**: the default Jev matching asks for none (`views/jev_matching.py`), although D51 has the matching call choose them; themes still reach every company thesis through the theme block (D191, D195). Found in the 2026-11-05 consolidation; building it is decided (D368).\\n116\\t5. **Historical coverage-start reading, retired by D370** (D364–D366): the capital-spending line is missed in about one read in six (the question is then left as it was); a labelled guidance figure is written with the fact tier; later reports reach the questions only through the daily stream; `scripts/preflight.py` does not replay the reading's check.\\n117\\t6. **Measured on one company and one 14-day window**, the judgement scored at the window end only; no version of the current pipeline has completed a longer window (a 60-day run of `poc-v108` was stopped at Alex's word after 2026-07-15, [log row 8](research/2026-11-04-argument-record/log.md)). The China-share question (v17) swings between draws (0 of 3 in the acceptance, 2 of 3 in its control, 1 of 3 in the frozen draws): two readers found the starting figures did not cause the acceptance's drop, and the byte-identical extraction request kept a \\\"share fell to zero\\\" sentence in two candidate draws and dropped it in two control draws. One acceptance draw judged nothing on v16; its cause is not established.\\n118\\t7. **What a judgement reads grows with the window** (D358). Argument records (D201) were measured as the remedy on 2026-11-04 and not built: judging-v8 agreed 12 of 17 against 15 of 17, judging-v9's card added little at about half again the judging cost; their code was removed at Alex's request ([log rows 4–11](research/2026-11-04-argument-record/log.md)).\\n119\\t8. **Seen once, not traced.** A judgement named a shown theme as a dependency and the check refused it twice, stopping a draw for a day (2026-11-02, D266). The sealed run's review recorded that a succession's opening evidence is not linked to the new question (D358), not yet checked against today's code.\\n120\\t9. **Earlier defects, unchanged.** Matching (build log row 49): another document's copy of a figure can be treated as new evidence; one matter can occupy several groups; same-answer candidate references caused seven chain or duplication decisions of the generative matcher; empty `original_who` values can count as the same party; different names for one population cause two of nine Jev merge misses. Nine 2026 aggregate-spending theses under `ai-capex` each have a different population; whether to combine them is a product choice. Extraction's instructions remain narrower than the PRD's important-question rule and omit the personal-memo exception, and extraction can change a quantity's meaning before matching (a guarantee amount against financing provided). Classification keeps its [recorded simulation defects](research/2026-10-25-english/classification-existing-defects.txt). The corpus audit recorded 97 official notices with 56 body and file-name collisions, to re-fetch before relying on a rebuilt corpus. An older intermittent search-test failure is untraced. Fresh Idea allocations vary while saved weights do not; the confidence chart applies the current plan to past states and is not a calibrated probability; broad analyst-prose quality and fresh Idea stability remain unaccepted (the [Idea contract](poc/idea-card.md) lists its limits); generative matching dependencies await `matching-v4`. The readers' doubts about the frozen standard, listed in the [extraction branch's state page](research/2026-11-01-e2e-loop/current-state-extraction-branch-2026-11-03.md), remain for Alex.\\n121\\t\\n122\\tUpstream supply and the human review pool's output remain deferred.\\n123\\t\\n124\\t## One next task\\n125\\t\\n126\\t**Clean Step 4 (D396–D398): design version 16 is in review; the build waits for a clean review and Alex's word**\\n127\\t([design](../clean-arch/step4-2026-11-10/DESIGN.md); round log §69).\\n128\\t\\n129\\t- **What the review of 2026-11-10 found** (councils `gh`–`gt`, all on stored data, no paid send):\\n130\\t  - Step 4 is the right next step, and inside it the first thing to build and test is the **ladder step alone**: the call that turns a\\n131\\t    thesis Step 1 opened into one judged question with its answer ladder and due day. The frozen judge follows only when the ladder\\n132\\t    step meets its lines.\\n133\\t  - Production's own ladder sentences are not stable: one request, the same in three draws, gave a bullish end at the low amount\\n134\\t    twice and at the high amount once, with three different middle bands; the code checks pass all three\\n135\\t    (`clean-arch/step4-2026-11-10/census/production_ladders.txt`).\\n136\\t  - Of the 34 theses the unseeded draws opened, two blind readers find 12 to 16 that ask more than one thing, 7 to 9 of 18 number\\n137\\t    questions with no reference figure in the opening article, and 4 that state a calendar due day.\\n138\\t- **Alex decided (2026-11-10):** a topic that asks more than one thing gets one judged question, the other parts shown as not judged\\n139\\t  (D397); the ladder step carries D186 in full (D398).\\n140\\t- **Design status:** thirteen reviews, each by a reviewer new to the work, have each found serious points, narrower each round;\\n141\\t  since the ninth none has found a wrong ladder outside the reader marks or a missing reader, old check or state. Two blind audits\\n142\\t  read the request against its sources. Version 16 answers the thirteenth review and the second audit and is with a fourteenth\\n143\\t  reviewer.\\n144\\t- **What changed in the test since the first design:** Stage A sends the candidate only (132 calls); its reference is a $0 reading\\n145\\t  of the 36 ladders production wrote, which hold every firm mark in 19 to 25 of 36 by two readers and are laddered in both\\n146\\t  directions for one question. Stage A cannot show the step is better than production; whether its lines may be read without a\\n147\\t  fresh control (AGENTS §7.3) is a question for Alex with the lines.\\n148\\t- **Readings done at $0** (`clean-arch/step4-2026-11-10/dryrun/` to `dryrun5/`, `reference/`):\\n149\\t  - the ladder-reading form catches every planted fault in both reader families (11 of 11; 9 of 9 in side-by-side packets; 8 of 8\\n150\\t    refusals; the left-out condition; the planted overlaps of five-state ladders);\\n151\\t  - the judgement-reading form must quote the judge's own rules and state its tests in order: with them the two families agree on\\n152\\t    20 of 20 stored judgements;\\n153\\t  - the stored replays hold a real fault of the frozen judge's daily path (v9 on 2026-07-05), so Stage B's lines are set against a\\n154\\t    baseline reading of the 159 stored judgements, not against a fixed share;\\n155\\t  - one reader reading the same 36 ladders twice differs on the ranges mark (30 of 36), so that mark decides no line;\\n156\\t  - reading time: about 90 seconds a packet of six ladders and 51 seconds a judgement for the slower reader.\\n157\\t- **The next task:**\\n158\\t  1. review the design with a fresh reviewer each round until one finds nothing serious;\\n159\\t  2. ask Alex's word to build the ladder step and run Stage A (the candidate on the 34 stored theses and the 10 fresh ones, three\\n160\\t     sends each), with the numbers of its proposed lines and the question of reading them without a paid control.\\n161\\t- **Open defects recorded by this review:** the frozen judge retried 10, 16 and 18 judgements in the seeded clean draws, 38 of 51\\n162\\t  reasons a theme cited as a dependency (PRD 11, E4), and its stored path holds the 2026-07-05 fault above (frozen; findings for\\n163\\t  Alex); the same matter takes different shapes between draws (Kyber due end-2027 in one draw and end-2028 in another); under D397\\n164\\t  the second bet of a topic that holds two has no answer; five-state event ladders failed by hand three times before a construction now in the request\\n165\\t  produced ones that pass a reader; whether the model applies it is for Stage A.\\n166\\t- **The unseeded measurement (D395):** graded subset 4.0 against 6.33 seeded. Every miss is a question not opened in the ruler's shape.\\n167\\t  Judged answers 16 of 16, on the ruler's wording and ladder; the system's own questions have never met a judge.\\n168\\t- **Stage 2 of D392:** clean 18, 18, 17 against v108 17, 15, 16, inconclusive on q12.\\n169\\t- **Known gap (D394):** capital spending (q12).\\n170\\t\\n171\\tNo long job is running.\\n172\\t\"}]},\"parent_tool_use_id\":null,\"session_id\":\"0d3b8608-893f-441f-b981-5d06f4864186\",\"uuid\":\"392eff5a-59af-4eb1-b941-287980699779\",\"timestamp\":\"2026-11-09T22:52:19.107Z\",\"tool_use_result\":{\"type\":\"text\",\"file\":{\"filePath\":\"/Users/lchingen/hivemind/docs/CURRENT_STATE.md\",\"content\":\"# Current state\\n\\n**Clean Steps 1–3, current (2026-11-09).** Record: [round log](../clean-arch/step1-unfiled-2026-11-08/LOG.md) §§16–47.\\n- **Step 1 configuration: c8, adopted by Alex (D387).** It runs DeepSeek Flash at high effort, with a 64,000-token output cap; a\\n  format failure or a cut answer is resent once (D380). It carries Alex's decisions D382–D385:\\n  - figures are conditions;\\n  - material statements with no thesis are kept without links;\\n  - only big matters open a thesis;\\n  - no target prices.\\n\\n  [PRD §12](../clean-arch/PRD.md) holds its system prompt, closing check and schema; a run with no candidate files sends exactly the\\n  accepted request.\\n- **Acceptance (D386, [protocol](../clean-arch/step1-unfiled-2026-11-08/ACCEPTANCE-PROTOCOL.md)).** 50 fresh articles that no run,\\n  old or new, had used: news from 2026-09-05 to 09-07, a holiday weekend with no NVIDIA posts. One draw; two readers and a third on\\n  disputes.\\n  - helpful 132/139 (core 83/83);\\n  - wrongly opened theses 1 of 10;\\n  - search 141/143 available repeat pairs, or 141/145 for the whole system (one 11-article story supplies 55 pairs, and revisions are\\n    barely exercised);\\n  - clear wrong merges 1/57, plus 2 overlaps;\\n  - detail retention 22 = 22. This is a storage comparison: every record keeps its own text. It is not a usability test.\\n\\n  Dev ×3 on the frozen golden-v5 (a lead): helpful 214, 211 and 212 of 234; search 98.9–100%; clear wrong merges about 1%. Step 1\\n  cost for the fresh set plus dev ×3: $4.20 at published rates.\\n- **Steps 2 and 3** are built in isolation (`clean-arch/step2`, `clean-arch/step3`): search, comparison, grouping and later linking.\\n  They are not integrated with production storage. **Step 4 (judging) is not built** on the clean path, so nothing yet shows the clean\\n  system can judge an investment view.\\n- **Step 2 revision-target probe (2026-11-09):** an isolated 42-call original-versus-candidate Jev comparison failed its predeclared improvement condition; existing wrong links persisted. The candidate is not adopted and this line stops without tuning on those cases. The selected sample cannot estimate overall accuracy or downstream impact. [Step 2 log §14](../clean-arch/step2-validation-2026-11-07/LOG.md).\\n- **Open defects, by product impact** (reflection council, `council/av-codex.md`):\\n  1. **The Ohio-guarantee yes/no question is never covered** in the three dev draws; a broader credit-support amount thesis opens\\n     instead. Diagnosed (round log §48): the model folds the unsigned guarantee into the open aggregate thesis because the request\\n     uses \\\"covers\\\" both for \\\"is evidence for\\\" and for \\\"already asks this question\\\". The same clause sits under link clutter.\\n  2. **A revenue-share thesis was opened** (Vera Rubin's share of data-center revenue), the class-A boundary of D382.\\n  3. **Link clutter.** A blind recheck of the 34 disputed fresh links found 19 weak and 2 wrong; 10 accepted links mixed in as controls were all useful; the other 49 links were not rechecked.\\n     The model's own account names topic or theme overlap and inference chains, and c8's closing check never reads back a link. This is\\n     a likely cause, with no fix proven. Alex approved designing a protected link check through the council; a first draft was stopped\\n     because it would drop founding premises and contrary facts.\\n  4. **Unverified passages:** 3 of 188 fresh records and 1–3 per dev draw. The mark now travels into Step 2's records, and a reader sees the found source text or an \\\"Unverified quote\\\" label. Jev's comparison input still carries the model's text without the mark; changing it changes measured Step 2 behaviour and needs its own measurement.\\n  5. **The lidar policy thesis** recurs at the boundary (one dev draw in three).\\n- **History.** These earlier states are superseded:\\n  - the 2026-11-07 takeover (K5 → K6b; [takeover log](../clean-arch/takeover-2026-11-07/LOG.md));\\n  - the 2026-11-08 close-out (K6b test 32/42; Step 2 first lines; [Step 2 log](../clean-arch/step2-validation-2026-11-07/LOG.md) §12);\\n  - the unfiled fix round and the c1–c7 arms (round log §§1–39).\\n- **No run is live.** The branch is committed through the D388 line (round log §§48–59).\\n\\n**Clean Step 1 source investigation (2026-11-07):** A [source-loss census](../clean-arch/STEP1-SOURCE-LOSS-CENSUS.md) traces two separate losses in the historical cleaner and records reproducible corpus observations. Offline candidate comparisons expose both recovered content and source-identity or contamination risks. A subsequent [full-page diagnostic](../clean-arch/STEP1-FULL-PAGE-RESULTS.md) completed 102 calls on 17 selected articles and independent source-backed review. It exposes examples of both missing or misattributed source text and model errors that persist despite the right text being present. A Codex–Claude council is reviewing the results and earlier attempts; no source-cleaning candidate is adopted, and the source corpus and production defaults are unchanged.\\n\\nAlex has authorized correcting the test-source cleaner and test data when their defects are confirmed, while the frozen production configuration and ruler remain intact. The cleaner switched 615 originally fed articles off; a replay reproduces all 615, and direct inspection confirms an actual article excluded because its 9,874-character body was flattened to one line. Other examples include a wrong-site shell, paywall and long challenge code, so the false-exclusion count and a general article-identification repair remain to be established. The [council regroup](../clean-arch/STEP1-SOURCE-REGROUP-COUNCIL.md) and [source-preservation design](../clean-arch/STEP1-SOURCE-PRESERVATION-DESIGN.md) describe an isolated candidate checked against all 34,084 records, with a fake-answer actual-runner handoff and provenance display in the replay renderer. The [five source-control calls](../clean-arch/STEP1-CAPTURE-CONTROLS-RESULTS.md) completed and were source-reviewed; two items contain summary details absent from their attached quotations, and one source-visible risk explanation was not returned. This is selected-case evidence, not a general quality result. Broader source-quality comparison, citation completeness and actual writer integration remain open.\\n\\n**Clean architecture Step 1 (2026-11-06, isolated work on `clean-arch`):** Alex reopened work with the clean architecture. An experimental prepared-source handoff now preserves the archived page, prior cleaned text, source-role decisions and selected-line mapping without changing the original database; quotations for prepared items must also occur contiguously in the original captured page. Two seven-item runs are available in the [clean architecture PRD](../clean-arch/PRD.md), one in the earlier selection order and one in recorded page-timestamp order. The source selector is not a production service and source ordering is not established event-arrival ordering. The runs expose unresolved semantic problems: citations can omit supporting facts despite an exact location match; model output can change a benchmark into a deployment, reverse a backup relation, omit a named customer or assign an unstated currency. A blinded 84-call check-placement/wording comparison and a 27-call same-article citation-completion diagnostic did not give a clean semantic fix and are not adopted. The latter missed an omitted connectivity condition and a reversed backup relationship, and left six expected evidence reviews unaddressed. A further five-round Codex–Claude council produced a narrowly scoped Step 1 link candidate, independently checked for prompt-contract drift. A six-article, 36-call blind comparison completed; the candidate still produced an explicitly self-contradictory link and both arms consistently omitted the same Kyber report and company response. It is not adopted and has not changed the active PRD prompt. A trace confirms that both the Kyber report and open Kyber thesis were supplied, and the raw model answers omitted the report and denial; the reason is not established. See ../poc/data/clean-step1-kyber-trace-2026-11-06/TRACE.md. An isolated six-call comparison showed that hiding the Kyber thesis did not recover the report or denial in any draw. A second six-call comparison returned them in 3/3 draws with the original Kyber paragraph alone and 0/3 with the full article; length, position and surrounding content changed together, so the reason is not isolated. Excerpt outputs have source-attribution limitations. Neither experiment changed state or established a production fix. (Superseded: the next task then was a whole-article coverage approach; the current next task is under \\\"One next task\\\".) See ../clean-arch/STEP1-IMPLEMENTATION-COUNCIL.md. The earlier four-round council agreed that no tested semantic fix is ready; its next investigation is a source-backed review of the 49-item historical run and its 160 evidence records, with overlapping issue flags and separate article-level omissions, then a separate comparison of the seven-item replays. See ../clean-arch/STEP1-COUNCIL-REVIEW.md. Preserve relevant evidence while identifying the next intervention; production/frozen history remains as described below. See [Step 1 run log](../clean-arch/STEP1-RUN-LOG.md) and [English reading page](../clean-arch/architecture.html).\\n\\n**Sealed (D379, 2026-11-06):** Alex asked to clean up and seal this version while he re-plans the system design. Work stops here and is sealed as it is: main's working tree is committed on branch `seal/2026-11-06` (tag `sealed-2026-11-06`) and merged into `main` on Alex's word (PR #10); the sealed split and two side experiments are pushed on their own branches (D379). No PRD 11 experiment is open, and the E1 next task below is withdrawn. The next task is Alex's re-planned system design.\\n\\n**E1 diagnosed (2026-11-06, Alex chose E1):** of 57 helpful matters frozen production wrote and then dropped, two readers agree on 17 link misses (4 core), 3 opening misses (1 core) and 24 small matters the standard itself drops; 10 are disputed on the fallback clause and 3 were quote refusals. Opening is not the experiment. The core of the link misses is the model reading a question's period, population or named configuration as a boundary; only 8 of the 13 window draws it dropped were lost to the product. No production change; $0.02 of probes. My recommendation was to fold that narrow change into the next extraction version; withdrawn by the seal (D379). Details: `docs/research/2026-11-06-e1-no-home-drops/README.md`, PRD 11 E1.\\n\\n**Split extraction sealed as a failed experiment (D378, 2026-11-06):** the split (a new-question call, an evidence call and record preparation) was benchmarked against the frozen poc-v108 and failed. Its stop line fired: helpful matters 156, 156, 159 against 166, 170, 162, with about 15% higher cost. One screened revision kept more noise than production. It is sealed in the worktree `hivemind-no-preseed-evidence-review` (tag `split-extraction-failed-sealed-2026-11-06`), and nothing of it is in main. What it taught is written as proposed production experiments in `docs/prd/11-production-experiments-from-split.md`: E1 no-home helpful drops, E2 duplicate questions, E3 ladder checks with D186, E4 judge refusals, E5 D203's revision day, E6 the measurement kit. Each opens only on Alex's word.\\n\\n**Question-catalog limit removed (D377, 2026-11-05):** Alex also directed removal of the separate 150 KB catalog rejection. The research reader in this worktree now has neither the catalog nor evidence byte limit; it retains full scoped questions, historical boundaries, dependencies and evidence. A portable 326,996-byte catalog test returns all 400 new questions and expands evidence both after reading the catalog and directly; the old 150 KB guard fails the same test in a scratch copy. The saved 69-question pilot catalog and all 69 saved evidence expansions match their original content hashes. Details: `docs/research/2026-11-05-catalog-limit/`. The full suite remains pending until the paid seven-day run no longer competes for resources. The run remains in its isolated worktree and does not call this research reader.\\n\\n**Evidence reader limit removed (D376, 2026-11-05):** Alex directed removal of the reader's 1 MB evidence-expansion rejection. In this worktree, `research_context.Reader.expand` now returns the entire evidence payload without that cap, while the catalog's separate limit remained at that checkpoint; D377 subsequently removed it. On the saved pilot ledger, all 69 individual question expansions, the four-question 1,931,225-byte pilot request and the entire 3,454,076-byte catalog produce the exact same content as the pre-change high-limit baseline; the portable oversized-ledger test passes and fails when the old cap is restored in a scratch copy. Details and snapshot-specific measurements are in `docs/research/2026-11-05-reader-limit/`. The seven-day diagnostic runs in `/Users/lchingen/hivemind-no-preseed-evidence-review/poc/data/split-fresh-seven-day-2026-11-05-v2/` with its pinned code; it does not call this research reader. Read its status through its `snapshot.sh`; do not edit its package code while it is live. This change is not an acceptance of seven-day extraction or judgement quality.\\n\\n**Start-state correction (2026-11-05):** Alex requires a research library established from real material available before the test start, then extraction against that state. The prior empty-library diagnostic cannot represent this case. Our own mistakes and the current 68-question provenance audit are in `../hivemind-no-preseed-evidence-review/docs/research/2026-11-05-parallel-refinement/own-mistakes-2026-11-05.zh.md`. Two new A-only calls were run on 2026-08-29 articles using the 68-question prior-day snapshot; both proposed the same aggregate supply-commitments topic. A source/context review judged it distinct from the existing specific SK Hynix question. A third A-only call on an author-body excerpt about DLSS 5, already tracked by v22, passed; the prompt also restricts software updates, so the reason is not established. No writer or dedup ran; source-history completeness remains unverified, and this is not scored acceptance. Details: ../hivemind-no-preseed-evidence-review/docs/research/2026-11-05-parallel-refinement/start-state-diagnostic-2026-11-05.zh.md.\\n\\n**Measurement correction (2026-11-05):** Alex clarified that a gold-worthy topic already in the supplied library should not open again; an absent worthy topic should open. The earlier simple-A claim of a \\\"missed\\\" new topic was not scored against that rule and is withdrawn as a correctness conclusion. In the actual experiment, a Kyber topic was shown and passing follows Alex's topic-level rule; whether its exact release question captures the shipping milestone remains unverified. The experimental pre-article snapshots differ from the replay's day-start snapshots; 9 of 10 inspected examples differ. The current uncommitted replay default does not build a cold-start library; committed main HEAD still uses the old seed and startup filing path. Historical lexical coverage has a confirmed unrelated-topic match. The frozen gold and past scores remain unchanged. Audit: `../hivemind-no-preseed-evidence-review/docs/research/2026-11-05-parallel-refinement/measurement-context-scrub-2026-11-05.zh.md`.\\n\\n**Simple new-question diagnostic (2026-11-05):** At Alex's direction, an isolated prompt returned new questions plus article evidence without asking for product database fields. Four previously seen real dev articles each ran once: three returned one candidate, one returned none, all four quotes matched their source, and the gold-listed GPU backstop amount question was not proposed. Whether that omission is a new-topic miss depends on whether the existing library covers the topic. Two other candidates require source and independent-significance review; the actual experimental snapshot already had a Kyber topic, so its pass follows Alex's topic-level rule; whether its exact release question captures the shipping milestone remains unverified. This is not a production or full-pipeline acceptance. Details: `../hivemind-no-preseed-evidence-review/docs/research/2026-11-05-parallel-refinement/simple-new-question-results.zh.md`.\\n\\n**Split prompt structure v3 read diagnostic (2026-11-05):** One real reading-stage call on a previously seen article found the revenue/margin guidance and Trainium scale but omitted the gold China revenue/market-loss matter. The prewritten stop condition was triggered and the linking call was not sent. This is one draw and not a production or end-to-end result. See `../hivemind-no-preseed-evidence-review/docs/research/2026-11-05-parallel-refinement/structure-v3-read-result.zh.md`. D374 removes the model sampling field from active settings and default configs; historical config files and archives retain their original bytes.\\n\\n**Split prompt structure v2 small test (2026-11-05):** Thirty calls on two previously seen golden-v5 dev articles completed in `../hivemind-no-preseed-evidence-review`. The blind model reader found complete helpful matters in the fresh control versus new A+B of 6/19 vs 10/19, 11/19 vs 7/19, and 9/19 vs 12/19. The new arm also retained more gold not-kept matters in each draw; B missed useful margin guidance and one answer reused IDs, with a demonstrated matching collision. This is not a production acceptance. See `../hivemind-no-preseed-evidence-review/docs/research/2026-11-05-parallel-refinement/structure-v2-results.zh.md` and `reports/2026-11-05-parallel-structure-v2.html`.\\n\\n**Split extraction small test (2026-11-05):** At Alex's request, the isolated `hivemind-no-preseed-evidence-review` worktree ran two real golden-v5 articles once through each split lane. An independent model reader found 7 of 19 helpful gold matters fully retained, two partial, two written then dropped, eight missed, and one retained gold not-kept matter. Three saved v108 draws on these articles retained 7, 9 and 12 of 19, but used 22 seeded questions while the new test used 8/10-question snapshots; these are not directly comparable. The experiment remains unaccepted; see `../hivemind-no-preseed-evidence-review/docs/research/2026-11-05-parallel-refinement/small-scored-test-20261105.md` and `reports/2026-11-05-split-small-test.html`.\\n\\nAs of November 5, 2026; decisions through D374. [Decisions](DECISIONS.md) holds what is decided now; the [design page](system-design.html) and the [module PRDs](prd/README.md) hold what the code must do; the [README](../README.md) holds startup, build and run instructions.\\n\\n## Future evidence scoring (D372)\\n\\nAlex decided future gold scoring should measure helpful versus not helpful evidence without requiring separate scores for core and supporting. Use frozen golden-v5 as-is: combine core and supporting as helpful, treat not-kept as unhelpful, and keep optional entries neutral. A counting report has not yet been implemented. Historical scores retain their original definitions. D373 removes the stop caused by a separate concern about three question-gold entries: keep the gold unchanged, continue scoring and disclose the concern; see `../hivemind-no-preseed-evidence-review/docs/research/2026-11-05-parallel-refinement/ruler-conflict-2026-11-05.zh.md`.\\n\\n## Latest decision (D369)\\n\\nAlex decided in D369 to capture core and supporting evidence without a strict boundary and in D370 to remove the 22 preset starting questions and separate earnings-report import. The replay entry now defaults to `poc-v118` (D374), refuses old seeded ledgers and baseline configurations, and continues to read existing non-seeded questions; earnings releases remain normal source items. This change has local contract tests but has not passed end-to-end product acceptance. The frozen historical rulers and results remain unchanged.\\n\\nThe small 2026-11-05 study used three archived NVDA articles and an 8/28 historical 68-question snapshot: without versus with an appended report, independent AI review found 14/27 versus 13/27 complete matters. This measured appended extraction context, not the distinct former coverage-start step; D370 removes both by Alex's decision. Full traces and limitations are in the separate `hivemind-no-preseed-evidence-review` worktree under `docs/research/2026-11-05-real-input-evidence/existing-library-results-2026-11-05.md`.\\n\\n\\n**One-day smoke completed (2026-11-05 UTC):** Alex requested a quick 1–2 day end-to-end test. One day, 2026-08-29, ran in `/Users/lchingen/hivemind-no-preseed-evidence-review/poc/data/v117-one-day-smoke-2026-11-05/`: config v117, an 8/28 historical library, 40 extraction calls, 93 evidence records written, four new questions, 54 judged and zero terminal failures. Two judgement attempts were refused and corrected. A Microsoft revenue forecast of $391.1bn was assigned to a rung whose upper bound excludes $391.1bn; the same article's actual quarterly revenue and next-quarter guidance were dropped with no home. Some source dates and bodies are not verified, and an independent 14-article sample review was incomplete due to truncated text. This is not semantic or production acceptance. Findings and scope: `docs/research/2026-11-05-real-input-evidence/one-day-v117-smoke-2026-11-05.zh.md` in that worktree. The clean source-text comparison and its condition-hidden review are complete; council discussion of next steps is ongoing.\\n\\n**D371, in progress:** Alex directed that present and forward-looking revenue and financial information should be tracked. Diagnose the same-day extraction and filing losses before designing a general change. No new financial tracking implementation has been accepted yet. The old frozen standard and gold are unchanged. The original prompt-only pilot failed design review. The user approved an exact prompt addition for an experiment; it is not a production implementation. Four paired real-article diagnostic calls per arm completed for the exact approved sentence: v74i versus experimental role-d371-pilot. Microsoft next-quarter guidance and NVIDIA FY2028 guidance still dropped in the treatment; a single draw is not acceptance or proof of causation. Details: docs/research/2026-11-05-real-input-evidence/d371-prompt-pilot-results.zh.md (isolated worktree). The requested full prompt audit and restructure were drafted experimentally; five real-article paired diagnostic requests per arm completed. Microsoft revenue guidance was missed in both arms, and the draft produced unsupported original dates, a quote refusal and suspect links. No production prompt change or acceptance; see restructure-pilot-results.zh.md in the isolated worktree.\\n\\n**Clean Step 1 coverage council (2026-11-06):** Codex and Claude Code independently reviewed the existing attempts and completed three discussion rounds. The proposed next research candidate moves the existing evidence-reading block ahead of the thesis-opening block while preserving the article, open-thesis state and paired output. It is a hypothesis, not an implemented or validated fix. A complete prompt/contract audit and independent review precede any controlled Luna comparison. Historical paragraph-based and source-first experiments, their noise and attribution problems, and the rejected overlap-based merge are recorded in [the council review](../clean-arch/STEP1-COVERAGE-COUNCIL.md). No new Luna experiment was run in the council.\\n\\n**Clean Step 1 coverage order result (2026-11-07):** The isolated 54-call clean comparison completed and all answers were reviewed blind. Moving the evidence-reading block recovered a known Kyber report and denial in one of three candidate answers against none in three controls, with attribution blur; it also produced unsupported gaming-to-AI links in two candidate answers and no controls. It is not adopted. A separate exact-quote example misattributes an executive's prediction in the standalone summary. [Results and replay](../clean-arch/STEP1-COVERAGE-ORDER-RESULTS.md) record all selected cases, uncertainties and source-fidelity work; no production ledger was written.\\n\\n**Clean Step 1 fidelity council (2026-11-07):** Codex and Claude Code completed five rounds on source attribution, conditions, dates and meaning. No tested fix or root cause is established. The agreed source-to-record review of 49 articles / 160 evidence items and the subsequent isolated field-order comparison are complete; the later 54-answer / 217-record repeated sample remains separate. Prior source-first, quote-first and follow-up-review experiments and their limits are recorded in [the fidelity council](../clean-arch/STEP1-FIDELITY-COUNCIL.md). No Luna experiment or production change was made in this council.\\n\\n**Clean Step 1 fidelity review (2026-11-07):** All 49 saved source packets and 160 original evidence items have received a source-and-record review; focused independent cross-checks cover the findings and selected controls. The [review and article replay](../clean-arch/STEP1-FIDELITY-REVIEW.md) distinguish source contamination and missing source material from model meaning, citation, date and link issues. The [isolated schema property-order diagnostic](../clean-arch/STEP1-CITATION-ORDER-RESULTS.md) completed all 66 calls and condition-blinded article reviews. Several omissions and semantic errors persisted; it did not establish a fix and is not adopted. It used saved articles and before-states without changing production.\\n\\n**Clean Step 1 source handoff council (2026-11-07):** The ongoing [council and offline checks](../clean-arch/STEP1-SOURCE-HANDOFF-COUNCIL.md) reconstructed 16 matching article-34 controls, all omitting a Kyber report and denial; the cause remains unknown. The 20-article saved source-role overlap review distinguished previously cited AI-generated summary lines and an unrelated recommendation from authored body. The clean runner does not send the saved source-role labels; the council chose to first compare original and previously selected source text on ten known articles. The isolated 60-call source-text comparison and condition-hidden review are complete; [results](../clean-arch/STEP1-SOURCE-TEXT-RESULTS.md) show specific contamination reductions alongside persistent omissions and changed meaning. It did not advance state or write production. The isolated six-article low-versus-medium source-fidelity diagnostic completed 36/36 calls and condition-hidden review. [Results](../clean-arch/STEP1-REASONING-FIDELITY-RESULTS.md) show partial improvements alongside persistent source-qualification and attribution concerns; no production setting is changed. The [prompt audit](../clean-arch/STEP1-FIDELITY-PROMPT-AUDIT.md) maps the observed failures to the full request and signed standard. The six-article isolated schema-description comparison completed 36/36 calls and condition-hidden review; the candidate did not preserve the repeated example qualification and is not adopted. [Results](../clean-arch/STEP1-SUMMARY-FIDELITY-RESULTS.md). A further six-article 36-call low-versus-medium comparison used corpus-cleaned sources outside the original 49-item clean replay and a fixed exploratory context; results were mixed, including unsupported links and incorrect attribution/date fields. [Results and replay](../clean-arch/STEP1-ADDITIONAL-SOURCES-RESULTS.md). The structured-claims candidate was not sent after review revealed scope and complexity concerns. Council review of the next action is ongoing. The date-text schema-description diagnostic completed 48/48 calls on eight known cases, with mixed results; the candidate is not adopted. A selected-run census found twelve literal \\\"null\\\" strings in date-text fields, but no production writer impact is established. [Results and replay](../clean-arch/STEP1-DATE-DESCRIPTION-RESULTS.md). A further preregistered eight-source date comparison completed 48/48 calls; the candidate lost a supported company-article statement date in all three draws on one source and is not adopted. [Results and replay](../clean-arch/STEP1-DATE-NEW-SOURCES-RESULTS.md). A bounded corpus census confirmed 163 source pages across three explicit generated-summary structures whose labels were removed while some summary text was retained; two NVIDIA cases were reproduced through the cleaner. [Source provenance investigation](../clean-arch/STEP1-SOURCE-PROVENANCE-CENSUS.md). A read-only source-lineage replay reproduced 363/363 cleaned pages with current inputs, preserved ambiguous original-line locations, and surfaced the generated-summary label loss for review. [Source investigation and lineage replay](../clean-arch/STEP1-SOURCE-PROVENANCE-CENSUS.md). An offline neighboring-context observation exposed only 144 or 149 of 163 known labels and introduced many other page lines; it is not adopted as a general source fix. [Observations and viewer](../clean-arch/STEP1-SOURCE-CONTEXT-OBSERVATIONS.md). A new [saved-quote integrity investigation](../clean-arch/STEP1-QUOTE-INTEGRITY-CENSUS.md) reconstructed 360 saved answers across eight overlapping cohorts, including 78 prepared-source calls. Five saved unverified passage instances were complete matches under the existing normalization; an in-memory candidate recovered their original slices, while ten others remained unverified. The normalized source-slice lookup is now installed only in the isolated clean Step 1 runner; saved-answer and entry-point checks are recorded there. Page provenance, Unicode completeness, production resource budgets and writer integration remain open. The existing writer stores only one quote, whereas 63 of 160 evidence items in the 49-article exploratory trace have multiple passages. A [source-first 49-article coverage review](../clean-arch/STEP1-COVERAGE-CENSUS.md) separates material missing from the model input from source-visible omissions in the saved answers, with uncertain matter boundaries labeled. (Superseded: the next investigation then was why supplied material is missed; the current next task is under \\\"One next task\\\".) The canonical prompt and production configuration remain unchanged. Adding fallible role annotations remains a separate untested candidate. Council streams and handoffs are in `poc/data/clean-step1-ongoing-council-2026-11-07/`.\\n\\n## What runs\\n\\n- **Pipeline (replay default `poc/config/poc-v118.json`, D370, D374).** Every item reads the relevant open questions from the library at the start of its day, then extraction v74i on `gpt-6-luna` proposes evidence and questions; Jev matching with the collision judge matches them; code writes the records; judging-v7 judges changes once a day; pull mode closes due questions. There is no separate seed or coverage-start report import, and reports as source items remain eligible. This default has not completed end-to-end acceptance. The [pipeline guide](poc/pipeline-plan.md) maps stages to code.\\n- **Measured:** one company (NVDA) over one 14-day window (2026-07-01 to 07-14), the judgement scored at the window end on the frozen ruler (AGENTS §7.1). Three draws of `poc-v116` against three of `poc-v108` run in the same hours: 53 against 45 agreements of 57; operating margin and capex agree in 3 of 3 draws, never judged without the coverage-start reading ([acceptance](research/2026-11-04-filing-end-to-end/acceptance-design.md)).\\n- **Served data:** the service, the MCP server and the standalone page serve the sealed three-month ledger `served-2026-10-28-v34-nvda-3m-through-0828` (68 theses, 34 groups; D358), built by the earlier `poc-v34` pipeline, not by the replay default. HTTP `/library`, MCP `thesis_library` and the standalone page share the dated bundle writer.\\n- **Idea API:** `poc-v118-idea` (D290, D335, D374): two discovery calls and one adoption and weighting assessment; only adopted theses with positive weights appear, and nonempty plans total 100%. The [Idea contract](poc/idea-card.md) owns its fields and the limits of its scores.\\n- **Interface:** the Thesis Library and Explore Ideas workspaces, with the confidence Trigger and an Action preview (no wallet connection or order execution). The [UI specification](poc/thesis-ui.md) and the [integration guide](../poc/ui/README.md) own its behaviour.\\n- **Repository:** `main` holds the product, the frozen ruler and the research records; run databases, logs and model archives stay on disk (D353), located by the [data manifest](research/2026-10-25-english/data-manifest.md). Worktrees: `/Users/lchingen/hivemind` is the main checkout, where slice branches are cut from `main`; `/Users/lchingen/hivemind-extraction-quality-2026-10-28` (the extraction branch, merged on 2026-11-03) keeps in its ignored folders the stored end-to-end runs of `poc-v91` to `poc-v95` that later comparisons read (D359); `/Users/lchingen/hivemind-run-v109-2026-11-04` is the finished judging-v8 run's worktree. Older branches stay in Git without worktrees (D359); none is merged work in progress. The clean source-text comparison and its condition-hidden review are complete; council discussion of next steps is ongoing.\\n\\n## Open defects\\n\\n1. **Competitor and customer news is filed under the company's revenue questions** instead of the share, capital-spending or custom-chip question it informs (D355; filing is otherwise about 85% right). Share facts are often not written at all, an extraction recall miss. The total-revenue question holds about a quarter of all links (D354).\\n2. **One bet opened twice** about one encounter in five: the collision judge splits a seed question from an identical candidate on a fine detail (D354).\\n3. **A question the standard rules out** (the lidar legislation) was proposed by the extraction and opened in one draw of three (D354).\\n4. **A thesis opened from an article gets no dependency of its own**: the default Jev matching asks for none (`views/jev_matching.py`), although D51 has the matching call choose them; themes still reach every company thesis through the theme block (D191, D195). Found in the 2026-11-05 consolidation; building it is decided (D368).\\n5. **Historical coverage-start reading, retired by D370** (D364–D366): the capital-spending line is missed in about one read in six (the question is then left as it was); a labelled guidance figure is written with the fact tier; later reports reach the questions only through the daily stream; `scripts/preflight.py` does not replay the reading's check.\\n6. **Measured on one company and one 14-day window**, the judgement scored at the window end only; no version of the current pipeline has completed a longer window (a 60-day run of `poc-v108` was stopped at Alex's word after 2026-07-15, [log row 8](research/2026-11-04-argument-record/log.md)). The China-share question (v17) swings between draws (0 of 3 in the acceptance, 2 of 3 in its control, 1 of 3 in the frozen draws): two readers found the starting figures did not cause the acceptance's drop, and the byte-identical extraction request kept a \\\"share fell to zero\\\" sentence in two candidate draws and dropped it in two control draws. One acceptance draw judged nothing on v16; its cause is not established.\\n7. **What a judgement reads grows with the window** (D358). Argument records (D201) were measured as the remedy on 2026-11-04 and not built: judging-v8 agreed 12 of 17 against 15 of 17, judging-v9's card added little at about half again the judging cost; their code was removed at Alex's request ([log rows 4–11](research/2026-11-04-argument-record/log.md)).\\n8. **Seen once, not traced.** A judgement named a shown theme as a dependency and the check refused it twice, stopping a draw for a day (2026-11-02, D266). The sealed run's review recorded that a succession's opening evidence is not linked to the new question (D358), not yet checked against today's code.\\n9. **Earlier defects, unchanged.** Matching (build log row 49): another document's copy of a figure can be treated as new evidence; one matter can occupy several groups; same-answer candidate references caused seven chain or duplication decisions of the generative matcher; empty `original_who` values can count as the same party; different names for one population cause two of nine Jev merge misses. Nine 2026 aggregate-spending theses under `ai-capex` each have a different population; whether to combine them is a product choice. Extraction's instructions remain narrower than the PRD's important-question rule and omit the personal-memo exception, and extraction can change a quantity's meaning before matching (a guarantee amount against financing provided). Classification keeps its [recorded simulation defects](research/2026-10-25-english/classification-existing-defects.txt). The corpus audit recorded 97 official notices with 56 body and file-name collisions, to re-fetch before relying on a rebuilt corpus. An older intermittent search-test failure is untraced. Fresh Idea allocations vary while saved weights do not; the confidence chart applies the current plan to past states and is not a calibrated probability; broad analyst-prose quality and fresh Idea stability remain unaccepted (the [Idea contract](poc/idea-card.md) lists its limits); generative matching dependencies await `matching-v4`. The readers' doubts about the frozen standard, listed in the [extraction branch's state page](research/2026-11-01-e2e-loop/current-state-extraction-branch-2026-11-03.md), remain for Alex.\\n\\nUpstream supply and the human review pool's output remain deferred.\\n\\n## One next task\\n\\n**Clean Step 4 (D396–D398): design version 16 is in review; the build waits for a clean review and Alex's word**\\n([design](../clean-arch/step4-2026-11-10/DESIGN.md); round log §69).\\n\\n- **What the review of 2026-11-10 found** (councils `gh`–`gt`, all on stored data, no paid send):\\n  - Step 4 is the right next step, and inside it the first thing to build and test is the **ladder step alone**: the call that turns a\\n    thesis Step 1 opened into one judged question with its answer ladder and due day. The frozen judge follows only when the ladder\\n    step meets its lines.\\n  - Production's own ladder sentences are not stable: one request, the same in three draws, gave a bullish end at the low amount\\n    twice and at the high amount once, with three different middle bands; the code checks pass all three\\n    (`clean-arch/step4-2026-11-10/census/production_ladders.txt`).\\n  - Of the 34 theses the unseeded draws opened, two blind readers find 12 to 16 that ask more than one thing, 7 to 9 of 18 number\\n    questions with no reference figure in the opening article, and 4 that state a calendar due day.\\n- **Alex decided (2026-11-10):** a topic that asks more than one thing gets one judged question, the other parts shown as not judged\\n  (D397); the ladder step carries D186 in full (D398).\\n- **Design status:** thirteen reviews, each by a reviewer new to the work, have each found serious points, narrower each round;\\n  since the ninth none has found a wrong ladder outside the reader marks or a missing reader, old check or state. Two blind audits\\n  read the request against its sources. Version 16 answers the thirteenth review and the second audit and is with a fourteenth\\n  reviewer.\\n- **What changed in the test since the first design:** Stage A sends the candidate only (132 calls); its reference is a $0 reading\\n  of the 36 ladders production wrote, which hold every firm mark in 19 to 25 of 36 by two readers and are laddered in both\\n  directions for one question. Stage A cannot show the step is better than production; whether its lines may be read without a\\n  fresh control (AGENTS §7.3) is a question for Alex with the lines.\\n- **Readings done at $0** (`clean-arch/step4-2026-11-10/dryrun/` to `dryrun5/`, `reference/`):\\n  - the ladder-reading form catches every planted fault in both reader families (11 of 11; 9 of 9 in side-by-side packets; 8 of 8\\n    refusals; the left-out condition; the planted overlaps of five-state ladders);\\n  - the judgement-reading form must quote the judge's own rules and state its tests in order: with them the two families agree on\\n    20 of 20 stored judgements;\\n  - the stored replays hold a real fault of the frozen judge's daily path (v9 on 2026-07-05), so Stage B's lines are set against a\\n    baseline reading of the 159 stored judgements, not against a fixed share;\\n  - one reader reading the same 36 ladders twice differs on the ranges mark (30 of 36), so that mark decides no line;\\n  - reading time: about 90 seconds a packet of six ladders and 51 seconds a judgement for the slower reader.\\n- **The next task:**\\n  1. review the design with a fresh reviewer each round until one finds nothing serious;\\n  2. ask Alex's word to build the ladder step and run Stage A (the candidate on the 34 stored theses and the 10 fresh ones, three\\n     sends each), with the numbers of its proposed lines and the question of reading them without a paid control.\\n- **Open defects recorded by this review:** the frozen judge retried 10, 16 and 18 judgements in the seeded clean draws, 38 of 51\\n  reasons a theme cited as a dependency (PRD 11, E4), and its stored path holds the 2026-07-05 fault above (frozen; findings for\\n  Alex); the same matter takes different shapes between draws (Kyber due end-2027 in one draw and end-2028 in another); under D397\\n  the second bet of a topic that holds two has no answer; five-state event ladders failed by hand three times before a construction now in the request\\n  produced ones that pass a reader; whether the model applies it is for Stage A.\\n- **The unseeded measurement (D395):** graded subset 4.0 against 6.33 seeded. Every miss is a question not opened in the ruler's shape.\\n  Judged answers 16 of 16, on the ruler's wording and ladder; the system's own questions have never met a judge.\\n- **Stage 2 of D392:** clean 18, 18, 17 against v108 17, 15, 16, inconclusive on q12.\\n- **Known gap (D394):** capital spending (q12).\\n\\nNo long job is running.\\n\",\"numLines\":172,\"startLine\":1,\"totalLines\":172}},\"tool_result_meta\":[{\"id\":\"toolu_015MmWeEk1EUQis8xwzNsxN6\",\"permission_decision\":{\"decision\":\"accept\",\"source\":\"config\",\"reason_type\":\"mode\"}}]}\n./docs/CURRENT_STATE.md:148:7. **What a judgement reads grows with the window** (D358). Argument records (D201) were measured as the remedy on 2026-11-04 and not built: judging-v8 agreed 12 of 17 against 15 of 17, judging-v9's card added little at about half again the judging cost; their code was removed at Alex's request ([log rows 4–11](research/2026-11-04-argument-record/log.md)).\n./reports/step2-next-action-2026-11-09/claude-r1.jsonl:9:{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_0136a6FhCnMG99wB6qWXWcWc\",\"type\":\"tool_result\",\"content\":\"1\\t# Current state\\n2\\t\\n3\\t**Clean Steps 1–3, current (2026-11-09).** Record: [round log](../clean-arch/step1-unfiled-2026-11-08/LOG.md) §§16–47.\\n4\\t- **Step 1 configuration: c8, adopted by Alex (D387).** It runs DeepSeek Flash at high effort, with a 64,000-token output cap; a\\n5\\t  format failure or a cut answer is resent once (D380). It carries Alex's decisions D382–D385:\\n6\\t  - figures are conditions;\\n7\\t  - material statements with no thesis are kept without links;\\n8\\t  - only big matters open a thesis;\\n9\\t  - no target prices.\\n10\\t\\n11\\t  [PRD §12](../clean-arch/PRD.md) holds its system prompt, closing check and schema; a run with no candidate files sends exactly the\\n12\\t  accepted request.\\n13\\t- **Acceptance (D386, [protocol](../clean-arch/step1-unfiled-2026-11-08/ACCEPTANCE-PROTOCOL.md)).** 50 fresh articles that no run,\\n14\\t  old or new, had used: news from 2026-09-05 to 09-07, a holiday weekend with no NVIDIA posts. One draw; two readers and a third on\\n15\\t  disputes.\\n16\\t  - helpful 132/139 (core 83/83);\\n17\\t  - wrongly opened theses 1 of 10;\\n18\\t  - search 141/143 available repeat pairs, or 141/145 for the whole system (one 11-article story supplies 55 pairs, and revisions are\\n19\\t    barely exercised);\\n20\\t  - clear wrong merges 1/57, plus 2 overlaps;\\n21\\t  - detail retention 22 = 22. This is a storage comparison: every record keeps its own text. It is not a usability test.\\n22\\t\\n23\\t  Dev ×3 on the frozen golden-v5 (a lead): helpful 214, 211 and 212 of 234; search 98.9–100%; clear wrong merges about 1%. Step 1\\n24\\t  cost for the fresh set plus dev ×3: $4.20 at published rates.\\n25\\t- **Steps 2 and 3** are built in isolation (`clean-arch/step2`, `clean-arch/step3`): search, comparison, grouping and later linking.\\n26\\t  They are not integrated with production storage. **Step 4 (judging) is not built** on the clean path, so nothing yet shows the clean\\n27\\t  system can judge an investment view.\\n28\\t- **Open defects, by product impact** (reflection council, `council/av-codex.md`):\\n29\\t  1. **The Ohio-guarantee yes/no question is never covered** in the three dev draws; a broader credit-support amount thesis opens\\n30\\t     instead. Diagnosed (round log §48): the model folds the unsigned guarantee into the open aggregate thesis because the request\\n31\\t     uses \\\"covers\\\" both for \\\"is evidence for\\\" and for \\\"already asks this question\\\". The same clause sits under link clutter.\\n32\\t  2. **A revenue-share thesis was opened** (Vera Rubin's share of data-center revenue), the class-A boundary of D382.\\n33\\t  3. **Link clutter.** A blind recheck of the 34 disputed fresh links found 19 weak and 2 wrong; 10 accepted links mixed in as controls were all useful; the other 49 links were not rechecked.\\n34\\t     The model's own account names topic or theme overlap and inference chains, and c8's closing check never reads back a link. This is\\n35\\t     a likely cause, with no fix proven. Alex approved designing a protected link check through the council; a first draft was stopped\\n36\\t     because it would drop founding premises and contrary facts.\\n37\\t  4. **Unverified passages:** 3 of 188 fresh records and 1–3 per dev draw. The mark now travels into Step 2's records, and a reader sees the found source text or an \\\"Unverified quote\\\" label. Jev's comparison input still carries the model's text without the mark; changing it changes measured Step 2 behaviour and needs its own measurement.\\n38\\t  5. **The lidar policy thesis** recurs at the boundary (one dev draw in three).\\n39\\t- **History.** These earlier states are superseded:\\n40\\t  - the 2026-11-07 takeover (K5 → K6b; [takeover log](../clean-arch/takeover-2026-11-07/LOG.md));\\n41\\t  - the 2026-11-08 close-out (K6b test 32/42; Step 2 first lines; [Step 2 log](../clean-arch/step2-validation-2026-11-07/LOG.md) §12);\\n42\\t  - the unfiled fix round and the c1–c7 arms (round log §§1–39).\\n43\\t- **No run is live.** The branch is committed through the D388 line (round log §§48–59).\\n44\\t\\n45\\t**Clean Step 1 source investigation (2026-11-07):** A [source-loss census](../clean-arch/STEP1-SOURCE-LOSS-CENSUS.md) traces two separate losses in the historical cleaner and records reproducible corpus observations. Offline candidate comparisons expose both recovered content and source-identity or contamination risks. A subsequent [full-page diagnostic](../clean-arch/STEP1-FULL-PAGE-RESULTS.md) completed 102 calls on 17 selected articles and independent source-backed review. It exposes examples of both missing or misattributed source text and model errors that persist despite the right text being present. A Codex–Claude council is reviewing the results and earlier attempts; no source-cleaning candidate is adopted, and the source corpus and production defaults are unchanged.\\n46\\t\\n47\\tAlex has authorized correcting the test-source cleaner and test data when their defects are confirmed, while the frozen production configuration and ruler remain intact. The cleaner switched 615 originally fed articles off; a replay reproduces all 615, and direct inspection confirms an actual article excluded because its 9,874-character body was flattened to one line. Other examples include a wrong-site shell, paywall and long challenge code, so the false-exclusion count and a general article-identification repair remain to be established. The [council regroup](../clean-arch/STEP1-SOURCE-REGROUP-COUNCIL.md) and [source-preservation design](../clean-arch/STEP1-SOURCE-PRESERVATION-DESIGN.md) describe an isolated candidate checked against all 34,084 records, with a fake-answer actual-runner handoff and provenance display in the replay renderer. The [five source-control calls](../clean-arch/STEP1-CAPTURE-CONTROLS-RESULTS.md) completed and were source-reviewed; two items contain summary details absent from their attached quotations, and one source-visible risk explanation was not returned. This is selected-case evidence, not a general quality result. Broader source-quality comparison, citation completeness and actual writer integration remain open.\\n48\\t\\n49\\t**Clean architecture Step 1 (2026-11-06, isolated work on `clean-arch`):** Alex reopened work with the clean architecture. An experimental prepared-source handoff now preserves the archived page, prior cleaned text, source-role decisions and selected-line mapping without changing the original database; quotations for prepared items must also occur contiguously in the original captured page. Two seven-item runs are available in the [clean architecture PRD](../clean-arch/PRD.md), one in the earlier selection order and one in recorded page-timestamp order. The source selector is not a production service and source ordering is not established event-arrival ordering. The runs expose unresolved semantic problems: citations can omit supporting facts despite an exact location match; model output can change a benchmark into a deployment, reverse a backup relation, omit a named customer or assign an unstated currency. A blinded 84-call check-placement/wording comparison and a 27-call same-article citation-completion diagnostic did not give a clean semantic fix and are not adopted. The latter missed an omitted connectivity condition and a reversed backup relationship, and left six expected evidence reviews unaddressed. A further five-round Codex–Claude council produced a narrowly scoped Step 1 link candidate, independently checked for prompt-contract drift. A six-article, 36-call blind comparison completed; the candidate still produced an explicitly self-contradictory link and both arms consistently omitted the same Kyber report and company response. It is not adopted and has not changed the active PRD prompt. A trace confirms that both the Kyber report and open Kyber thesis were supplied, and the raw model answers omitted the report and denial; the reason is not established. See ../poc/data/clean-step1-kyber-trace-2026-11-06/TRACE.md. An isolated six-call comparison showed that hiding the Kyber thesis did not recover the report or denial in any draw. A second six-call comparison returned them in 3/3 draws with the original Kyber paragraph alone and 0/3 with the full article; length, position and surrounding content changed together, so the reason is not isolated. Excerpt outputs have source-attribution limitations. Neither experiment changed state or established a production fix. (Superseded: the next task then was a whole-article coverage approach; the current next task is under \\\"One next task\\\".) See ../clean-arch/STEP1-IMPLEMENTATION-COUNCIL.md. The earlier four-round council agreed that no tested semantic fix is ready; its next investigation is a source-backed review of the 49-item historical run and its 160 evidence records, with overlapping issue flags and separate article-level omissions, then a separate comparison of the seven-item replays. See ../clean-arch/STEP1-COUNCIL-REVIEW.md. Preserve relevant evidence while identifying the next intervention; production/frozen history remains as described below. See [Step 1 run log](../clean-arch/STEP1-RUN-LOG.md) and [English reading page](../clean-arch/architecture.html).\\n50\\t\\n51\\t**Sealed (D379, 2026-11-06):** Alex asked to clean up and seal this version while he re-plans the system design. Work stops here and is sealed as it is: main's working tree is committed on branch `seal/2026-11-06` (tag `sealed-2026-11-06`) and merged into `main` on Alex's word (PR #10); the sealed split and two side experiments are pushed on their own branches (D379). No PRD 11 experiment is open, and the E1 next task below is withdrawn. The next task is Alex's re-planned system design.\\n52\\t\\n53\\t**E1 diagnosed (2026-11-06, Alex chose E1):** of 57 helpful matters frozen production wrote and then dropped, two readers agree on 17 link misses (4 core), 3 opening misses (1 core) and 24 small matters the standard itself drops; 10 are disputed on the fallback clause and 3 were quote refusals. Opening is not the experiment. The core of the link misses is the model reading a question's period, population or named configuration as a boundary; only 8 of the 13 window draws it dropped were lost to the product. No production change; $0.02 of probes. My recommendation was to fold that narrow change into the next extraction version; withdrawn by the seal (D379). Details: `docs/research/2026-11-06-e1-no-home-drops/README.md`, PRD 11 E1.\\n54\\t\\n55\\t**Split extraction sealed as a failed experiment (D378, 2026-11-06):** the split (a new-question call, an evidence call and record preparation) was benchmarked against the frozen poc-v108 and failed. Its stop line fired: helpful matters 156, 156, 159 against 166, 170, 162, with about 15% higher cost. One screened revision kept more noise than production. It is sealed in the worktree `hivemind-no-preseed-evidence-review` (tag `split-extraction-failed-sealed-2026-11-06`), and nothing of it is in main. What it taught is written as proposed production experiments in `docs/prd/11-production-experiments-from-split.md`: E1 no-home helpful drops, E2 duplicate questions, E3 ladder checks with D186, E4 judge refusals, E5 D203's revision day, E6 the measurement kit. Each opens only on Alex's word.\\n56\\t\\n57\\t**Question-catalog limit removed (D377, 2026-11-05):** Alex also directed removal of the separate 150 KB catalog rejection. The research reader in this worktree now has neither the catalog nor evidence byte limit; it retains full scoped questions, historical boundaries, dependencies and evidence. A portable 326,996-byte catalog test returns all 400 new questions and expands evidence both after reading the catalog and directly; the old 150 KB guard fails the same test in a scratch copy. The saved 69-question pilot catalog and all 69 saved evidence expansions match their original content hashes. Details: `docs/research/2026-11-05-catalog-limit/`. The full suite remains pending until the paid seven-day run no longer competes for resources. The run remains in its isolated worktree and does not call this research reader.\\n58\\t\\n59\\t**Evidence reader limit removed (D376, 2026-11-05):** Alex directed removal of the reader's 1 MB evidence-expansion rejection. In this worktree, `research_context.Reader.expand` now returns the entire evidence payload without that cap, while the catalog's separate limit remained at that checkpoint; D377 subsequently removed it. On the saved pilot ledger, all 69 individual question expansions, the four-question 1,931,225-byte pilot request and the entire 3,454,076-byte catalog produce the exact same content as the pre-change high-limit baseline; the portable oversized-ledger test passes and fails when the old cap is restored in a scratch copy. Details and snapshot-specific measurements are in `docs/research/2026-11-05-reader-limit/`. The seven-day diagnostic runs in `/Users/lchingen/hivemind-no-preseed-evidence-review/poc/data/split-fresh-seven-day-2026-11-05-v2/` with its pinned code; it does not call this research reader. Read its status through its `snapshot.sh`; do not edit its package code while it is live. This change is not an acceptance of seven-day extraction or judgement quality.\\n60\\t\\n61\\t**Start-state correction (2026-11-05):** Alex requires a research library established from real material available before the test start, then extraction against that state. The prior empty-library diagnostic cannot represent this case. Our own mistakes and the current 68-question provenance audit are in `../hivemind-no-preseed-evidence-review/docs/research/2026-11-05-parallel-refinement/own-mistakes-2026-11-05.zh.md`. Two new A-only calls were run on 2026-08-29 articles using the 68-question prior-day snapshot; both proposed the same aggregate supply-commitments topic. A source/context review judged it distinct from the existing specific SK Hynix question. A third A-only call on an author-body excerpt about DLSS 5, already tracked by v22, passed; the prompt also restricts software updates, so the reason is not established. No writer or dedup ran; source-history completeness remains unverified, and this is not scored acceptance. Details: ../hivemind-no-preseed-evidence-review/docs/research/2026-11-05-parallel-refinement/start-state-diagnostic-2026-11-05.zh.md.\\n62\\t\\n63\\t**Measurement correction (2026-11-05):** Alex clarified that a gold-worthy topic already in the supplied library should not open again; an absent worthy topic should open. The earlier simple-A claim of a \\\"missed\\\" new topic was not scored against that rule and is withdrawn as a correctness conclusion. In the actual experiment, a Kyber topic was shown and passing follows Alex's topic-level rule; whether its exact release question captures the shipping milestone remains unverified. The experimental pre-article snapshots differ from the replay's day-start snapshots; 9 of 10 inspected examples differ. The current uncommitted replay default does not build a cold-start library; committed main HEAD still uses the old seed and startup filing path. Historical lexical coverage has a confirmed unrelated-topic match. The frozen gold and past scores remain unchanged. Audit: `../hivemind-no-preseed-evidence-review/docs/research/2026-11-05-parallel-refinement/measurement-context-scrub-2026-11-05.zh.md`.\\n64\\t\\n65\\t**Simple new-question diagnostic (2026-11-05):** At Alex's direction, an isolated prompt returned new questions plus article evidence without asking for product database fields. Four previously seen real dev articles each ran once: three returned one candidate, one returned none, all four quotes matched their source, and the gold-listed GPU backstop amount question was not proposed. Whether that omission is a new-topic miss depends on whether the existing library covers the topic. Two other candidates require source and independent-significance review; the actual experimental snapshot already had a Kyber topic, so its pass follows Alex's topic-level rule; whether its exact release question captures the shipping milestone remains unverified. This is not a production or full-pipeline acceptance. Details: `../hivemind-no-preseed-evidence-review/docs/research/2026-11-05-parallel-refinement/simple-new-question-results.zh.md`.\\n66\\t\\n67\\t**Split prompt structure v3 read diagnostic (2026-11-05):** One real reading-stage call on a previously seen article found the revenue/margin guidance and Trainium scale but omitted the gold China revenue/market-loss matter. The prewritten stop condition was triggered and the linking call was not sent. This is one draw and not a production or end-to-end result. See `../hivemind-no-preseed-evidence-review/docs/research/2026-11-05-parallel-refinement/structure-v3-read-result.zh.md`. D374 removes the model sampling field from active settings and default configs; historical config files and archives retain their original bytes.\\n68\\t\\n69\\t**Split prompt structure v2 small test (2026-11-05):** Thirty calls on two previously seen golden-v5 dev articles completed in `../hivemind-no-preseed-evidence-review`. The blind model reader found complete helpful matters in the fresh control versus new A+B of 6/19 vs 10/19, 11/19 vs 7/19, and 9/19 vs 12/19. The new arm also retained more gold not-kept matters in each draw; B missed useful margin guidance and one answer reused IDs, with a demonstrated matching collision. This is not a production acceptance. See `../hivemind-no-preseed-evidence-review/docs/research/2026-11-05-parallel-refinement/structure-v2-results.zh.md` and `reports/2026-11-05-parallel-structure-v2.html`.\\n70\\t\\n71\\t**Split extraction small test (2026-11-05):** At Alex's request, the isolated `hivemind-no-preseed-evidence-review` worktree ran two real golden-v5 articles once through each split lane. An independent model reader found 7 of 19 helpful gold matters fully retained, two partial, two written then dropped, eight missed, and one retained gold not-kept matter. Three saved v108 draws on these articles retained 7, 9 and 12 of 19, but used 22 seeded questions while the new test used 8/10-question snapshots; these are not directly comparable. The experiment remains unaccepted; see `../hivemind-no-preseed-evidence-review/docs/research/2026-11-05-parallel-refinement/small-scored-test-20261105.md` and `reports/2026-11-05-split-small-test.html`.\\n72\\t\\n73\\tAs of November 5, 2026; decisions through D374. [Decisions](DECISIONS.md) holds what is decided now; the [design page](system-design.html) and the [module PRDs](prd/README.md) hold what the code must do; the [README](../README.md) holds startup, build and run instructions.\\n74\\t\\n75\\t## Future evidence scoring (D372)\\n76\\t\\n77\\tAlex decided future gold scoring should measure helpful versus not helpful evidence without requiring separate scores for core and supporting. Use frozen golden-v5 as-is: combine core and supporting as helpful, treat not-kept as unhelpful, and keep optional entries neutral. A counting report has not yet been implemented. Historical scores retain their original definitions. D373 removes the stop caused by a separate concern about three question-gold entries: keep the gold unchanged, continue scoring and disclose the concern; see `../hivemind-no-preseed-evidence-review/docs/research/2026-11-05-parallel-refinement/ruler-conflict-2026-11-05.zh.md`.\\n78\\t\\n79\\t## Latest decision (D369)\\n80\\t\\n81\\tAlex decided in D369 to capture core and supporting evidence without a strict boundary and in D370 to remove the 22 preset starting questions and separate earnings-report import. The replay entry now defaults to `poc-v118` (D374), refuses old seeded ledgers and baseline configurations, and continues to read existing non-seeded questions; earnings releases remain normal source items. This change has local contract tests but has not passed end-to-end product acceptance. The frozen historical rulers and results remain unchanged.\\n82\\t\\n83\\tThe small 2026-11-05 study used three archived NVDA articles and an 8/28 historical 68-question snapshot: without versus with an appended report, independent AI review found 14/27 versus 13/27 complete matters. This measured appended extraction context, not the distinct former coverage-start step; D370 removes both by Alex's decision. Full traces and limitations are in the separate `hivemind-no-preseed-evidence-review` worktree under `docs/research/2026-11-05-real-input-evidence/existing-library-results-2026-11-05.md`.\\n84\\t\\n85\\t\\n86\\t**One-day smoke completed (2026-11-05 UTC):** Alex requested a quick 1–2 day end-to-end test. One day, 2026-08-29, ran in `/Users/lchingen/hivemind-no-preseed-evidence-review/poc/data/v117-one-day-smoke-2026-11-05/`: config v117, an 8/28 historical library, 40 extraction calls, 93 evidence records written, four new questions, 54 judged and zero terminal failures. Two judgement attempts were refused and corrected. A Microsoft revenue forecast of $391.1bn was assigned to a rung whose upper bound excludes $391.1bn; the same article's actual quarterly revenue and next-quarter guidance were dropped with no home. Some source dates and bodies are not verified, and an independent 14-article sample review was incomplete due to truncated text. This is not semantic or production acceptance. Findings and scope: `docs/research/2026-11-05-real-input-evidence/one-day-v117-smoke-2026-11-05.zh.md` in that worktree. The clean source-text comparison and its condition-hidden review are complete; council discussion of next steps is ongoing.\\n87\\t\\n88\\t**D371, in progress:** Alex directed that present and forward-looking revenue and financial information should be tracked. Diagnose the same-day extraction and filing losses before designing a general change. No new financial tracking implementation has been accepted yet. The old frozen standard and gold are unchanged. The original prompt-only pilot failed design review. The user approved an exact prompt addition for an experiment; it is not a production implementation. Four paired real-article diagnostic calls per arm completed for the exact approved sentence: v74i versus experimental role-d371-pilot. Microsoft next-quarter guidance and NVIDIA FY2028 guidance still dropped in the treatment; a single draw is not acceptance or proof of causation. Details: docs/research/2026-11-05-real-input-evidence/d371-prompt-pilot-results.zh.md (isolated worktree). The requested full prompt audit and restructure were drafted experimentally; five real-article paired diagnostic requests per arm completed. Microsoft revenue guidance was missed in both arms, and the draft produced unsupported original dates, a quote refusal and suspect links. No production prompt change or acceptance; see restructure-pilot-results.zh.md in the isolated worktree.\\n89\\t\\n90\\t**Clean Step 1 coverage council (2026-11-06):** Codex and Claude Code independently reviewed the existing attempts and completed three discussion rounds. The proposed next research candidate moves the existing evidence-reading block ahead of the thesis-opening block while preserving the article, open-thesis state and paired output. It is a hypothesis, not an implemented or validated fix. A complete prompt/contract audit and independent review precede any controlled Luna comparison. Historical paragraph-based and source-first experiments, their noise and attribution problems, and the rejected overlap-based merge are recorded in [the council review](../clean-arch/STEP1-COVERAGE-COUNCIL.md). No new Luna experiment was run in the council.\\n91\\t\\n92\\t**Clean Step 1 coverage order result (2026-11-07):** The isolated 54-call clean comparison completed and all answers were reviewed blind. Moving the evidence-reading block recovered a known Kyber report and denial in one of three candidate answers against none in three controls, with attribution blur; it also produced unsupported gaming-to-AI links in two candidate answers and no controls. It is not adopted. A separate exact-quote example misattributes an executive's prediction in the standalone summary. [Results and replay](../clean-arch/STEP1-COVERAGE-ORDER-RESULTS.md) record all selected cases, uncertainties and source-fidelity work; no production ledger was written.\\n93\\t\\n94\\t**Clean Step 1 fidelity council (2026-11-07):** Codex and Claude Code completed five rounds on source attribution, conditions, dates and meaning. No tested fix or root cause is established. The agreed source-to-record review of 49 articles / 160 evidence items and the subsequent isolated field-order comparison are complete; the later 54-answer / 217-record repeated sample remains separate. Prior source-first, quote-first and follow-up-review experiments and their limits are recorded in [the fidelity council](../clean-arch/STEP1-FIDELITY-COUNCIL.md). No Luna experiment or production change was made in this council.\\n95\\t\\n96\\t**Clean Step 1 fidelity review (2026-11-07):** All 49 saved source packets and 160 original evidence items have received a source-and-record review; focused independent cross-checks cover the findings and selected controls. The [review and article replay](../clean-arch/STEP1-FIDELITY-REVIEW.md) distinguish source contamination and missing source material from model meaning, citation, date and link issues. The [isolated schema property-order diagnostic](../clean-arch/STEP1-CITATION-ORDER-RESULTS.md) completed all 66 calls and condition-blinded article reviews. Several omissions and semantic errors persisted; it did not establish a fix and is not adopted. It used saved articles and before-states without changing production.\\n97\\t\\n98\\t**Clean Step 1 source handoff council (2026-11-07):** The ongoing [council and offline checks](../clean-arch/STEP1-SOURCE-HANDOFF-COUNCIL.md) reconstructed 16 matching article-34 controls, all omitting a Kyber report and denial; the cause remains unknown. The 20-article saved source-role overlap review distinguished previously cited AI-generated summary lines and an unrelated recommendation from authored body. The clean runner does not send the saved source-role labels; the council chose to first compare original and previously selected source text on ten known articles. The isolated 60-call source-text comparison and condition-hidden review are complete; [results](../clean-arch/STEP1-SOURCE-TEXT-RESULTS.md) show specific contamination reductions alongside persistent omissions and changed meaning. It did not advance state or write production. The isolated six-article low-versus-medium source-fidelity diagnostic completed 36/36 calls and condition-hidden review. [Results](../clean-arch/STEP1-REASONING-FIDELITY-RESULTS.md) show partial improvements alongside persistent source-qualification and attribution concerns; no production setting is changed. The [prompt audit](../clean-arch/STEP1-FIDELITY-PROMPT-AUDIT.md) maps the observed failures to the full request and signed standard. The six-article isolated schema-description comparison completed 36/36 calls and condition-hidden review; the candidate did not preserve the repeated example qualification and is not adopted. [Results](../clean-arch/STEP1-SUMMARY-FIDELITY-RESULTS.md). A further six-article 36-call low-versus-medium comparison used corpus-cleaned sources outside the original 49-item clean replay and a fixed exploratory context; results were mixed, including unsupported links and incorrect attribution/date fields. [Results and replay](../clean-arch/STEP1-ADDITIONAL-SOURCES-RESULTS.md). The structured-claims candidate was not sent after review revealed scope and complexity concerns. Council review of the next action is ongoing. The date-text schema-description diagnostic completed 48/48 calls on eight known cases, with mixed results; the candidate is not adopted. A selected-run census found twelve literal \\\"null\\\" strings in date-text fields, but no production writer impact is established. [Results and replay](../clean-arch/STEP1-DATE-DESCRIPTION-RESULTS.md). A further preregistered eight-source date comparison completed 48/48 calls; the candidate lost a supported company-article statement date in all three draws on one source and is not adopted. [Results and replay](../clean-arch/STEP1-DATE-NEW-SOURCES-RESULTS.md). A bounded corpus census confirmed 163 source pages across three explicit generated-summary structures whose labels were removed while some summary text was retained; two NVIDIA cases were reproduced through the cleaner. [Source provenance investigation](../clean-arch/STEP1-SOURCE-PROVENANCE-CENSUS.md). A read-only source-lineage replay reproduced 363/363 cleaned pages with current inputs, preserved ambiguous original-line locations, and surfaced the generated-summary label loss for review. [Source investigation and lineage replay](../clean-arch/STEP1-SOURCE-PROVENANCE-CENSUS.md). An offline neighboring-context observation exposed only 144 or 149 of 163 known labels and introduced many other page lines; it is not adopted as a general source fix. [Observations and viewer](../clean-arch/STEP1-SOURCE-CONTEXT-OBSERVATIONS.md). A new [saved-quote integrity investigation](../clean-arch/STEP1-QUOTE-INTEGRITY-CENSUS.md) reconstructed 360 saved answers across eight overlapping cohorts, including 78 prepared-source calls. Five saved unverified passage instances were complete matches under the existing normalization; an in-memory candidate recovered their original slices, while ten others remained unverified. The normalized source-slice lookup is now installed only in the isolated clean Step 1 runner; saved-answer and entry-point checks are recorded there. Page provenance, Unicode completeness, production resource budgets and writer integration remain open. The existing writer stores only one quote, whereas 63 of 160 evidence items in the 49-article exploratory trace have multiple passages. A [source-first 49-article coverage review](../clean-arch/STEP1-COVERAGE-CENSUS.md) separates material missing from the model input from source-visible omissions in the saved answers, with uncertain matter boundaries labeled. (Superseded: the next investigation then was why supplied material is missed; the current next task is under \\\"One next task\\\".) The canonical prompt and production configuration remain unchanged. Adding fallible role annotations remains a separate untested candidate. Council streams and handoffs are in `poc/data/clean-step1-ongoing-council-2026-11-07/`.\\n99\\t\\n100\\t## What runs\\n101\\t\\n102\\t- **Pipeline (replay default `poc/config/poc-v118.json`, D370, D374).** Every item reads the relevant open questions from the library at the start of its day, then extraction v74i on `gpt-6-luna` proposes evidence and questions; Jev matching with the collision judge matches them; code writes the records; judging-v7 judges changes once a day; pull mode closes due questions. There is no separate seed or coverage-start report import, and reports as source items remain eligible. This default has not completed end-to-end acceptance. The [pipeline guide](poc/pipeline-plan.md) maps stages to code.\\n103\\t- **Measured:** one company (NVDA) over one 14-day window (2026-07-01 to 07-14), the judgement scored at the window end on the frozen ruler (AGENTS §7.1). Three draws of `poc-v116` against three of `poc-v108` run in the same hours: 53 against 45 agreements of 57; operating margin and capex agree in 3 of 3 draws, never judged without the coverage-start reading ([acceptance](research/2026-11-04-filing-end-to-end/acceptance-design.md)).\\n104\\t- **Served data:** the service, the MCP server and the standalone page serve the sealed three-month ledger `served-2026-10-28-v34-nvda-3m-through-0828` (68 theses, 34 groups; D358), built by the earlier `poc-v34` pipeline, not by the replay default. HTTP `/library`, MCP `thesis_library` and the standalone page share the dated bundle writer.\\n105\\t- **Idea API:** `poc-v118-idea` (D290, D335, D374): two discovery calls and one adoption and weighting assessment; only adopted theses with positive weights appear, and nonempty plans total 100%. The [Idea contract](poc/idea-card.md) owns its fields and the limits of its scores.\\n106\\t- **Interface:** the Thesis Library and Explore Ideas workspaces, with the confidence Trigger and an Action preview (no wallet connection or order execution). The [UI specification](poc/thesis-ui.md) and the [integration guide](../poc/ui/README.md) own its behaviour.\\n107\\t- **Repository:** `main` holds the product, the frozen ruler and the research records; run databases, logs and model archives stay on disk (D353), located by the [data manifest](research/2026-10-25-english/data-manifest.md). Worktrees: `/Users/lchingen/hivemind` is the main checkout, where slice branches are cut from `main`; `/Users/lchingen/hivemind-extraction-quality-2026-10-28` (the extraction branch, merged on 2026-11-03) keeps in its ignored folders the stored end-to-end runs of `poc-v91` to `poc-v95` that later comparisons read (D359); `/Users/lchingen/hivemind-run-v109-2026-11-04` is the finished judging-v8 run's worktree. Older branches stay in Git without worktrees (D359); none is merged work in progress. The clean source-text comparison and its condition-hidden review are complete; council discussion of next steps is ongoing.\\n108\\t\\n109\\t## Open defects\\n110\\t\\n111\\t1. **Competitor and customer news is filed under the company's revenue questions** instead of the share, capital-spending or custom-chip question it informs (D355; filing is otherwise about 85% right). Share facts are often not written at all, an extraction recall miss. The total-revenue question holds about a quarter of all links (D354).\\n112\\t2. **One bet opened twice** about one encounter in five: the collision judge splits a seed question from an identical candidate on a fine detail (D354).\\n113\\t3. **A question the standard rules out** (the lidar legislation) was proposed by the extraction and opened in one draw of three (D354).\\n114\\t4. **A thesis opened from an article gets no dependency of its own**: the default Jev matching asks for none (`views/jev_matching.py`), although D51 has the matching call choose them; themes still reach every company thesis through the theme block (D191, D195). Found in the 2026-11-05 consolidation; building it is decided (D368).\\n115\\t5. **Historical coverage-start reading, retired by D370** (D364–D366): the capital-spending line is missed in about one read in six (the question is then left as it was); a labelled guidance figure is written with the fact tier; later reports reach the questions only through the daily stream; `scripts/preflight.py` does not replay the reading's check.\\n116\\t6. **Measured on one company and one 14-day window**, the judgement scored at the window end only; no version of the current pipeline has completed a longer window (a 60-day run of `poc-v108` was stopped at Alex's word after 2026-07-15, [log row 8](research/2026-11-04-argument-record/log.md)). The China-share question (v17) swings between draws (0 of 3 in the acceptance, 2 of 3 in its control, 1 of 3 in the frozen draws): two readers found the starting figures did not cause the acceptance's drop, and the byte-identical extraction request kept a \\\"share fell to zero\\\" sentence in two candidate draws and dropped it in two control draws. One acceptance draw judged nothing on v16; its cause is not established.\\n117\\t7. **What a judgement reads grows with the window** (D358). Argument records (D201) were measured as the remedy on 2026-11-04 and not built: judging-v8 agreed 12 of 17 against 15 of 17, judging-v9's card added little at about half again the judging cost; their code was removed at Alex's request ([log rows 4–11](research/2026-11-04-argument-record/log.md)).\\n118\\t8. **Seen once, not traced.** A judgement named a shown theme as a dependency and the check refused it twice, stopping a draw for a day (2026-11-02, D266). The sealed run's review recorded that a succession's opening evidence is not linked to the new question (D358), not yet checked against today's code.\\n119\\t9. **Earlier defects, unchanged.** Matching (build log row 49): another document's copy of a figure can be treated as new evidence; one matter can occupy several groups; same-answer candidate references caused seven chain or duplication decisions of the generative matcher; empty `original_who` values can count as the same party; different names for one population cause two of nine Jev merge misses. Nine 2026 aggregate-spending theses under `ai-capex` each have a different population; whether to combine them is a product choice. Extraction's instructions remain narrower than the PRD's important-question rule and omit the personal-memo exception, and extraction can change a quantity's meaning before matching (a guarantee amount against financing provided). Classification keeps its [recorded simulation defects](research/2026-10-25-english/classification-existing-defects.txt). The corpus audit recorded 97 official notices with 56 body and file-name collisions, to re-fetch before relying on a rebuilt corpus. An older intermittent search-test failure is untraced. Fresh Idea allocations vary while saved weights do not; the confidence chart applies the current plan to past states and is not a calibrated probability; broad analyst-prose quality and fresh Idea stability remain unaccepted (the [Idea contract](poc/idea-card.md) lists its limits); generative matching dependencies await `matching-v4`. The readers' doubts about the frozen standard, listed in the [extraction branch's state page](research/2026-11-01-e2e-loop/current-state-extraction-branch-2026-11-03.md), remain for Alex.\\n120\\t\\n121\\tUpstream supply and the human review pool's output remain deferred.\\n122\\t\\n123\\t## One next task\\n124\\t\\n125\\t**Clean Step 4 (D396–D398): design version 11 is in review; the build waits for a clean review, the request audit and Alex's word**\\n126\\t([design](../clean-arch/step4-2026-11-10/DESIGN.md); round log §69).\\n127\\t\\n128\\t- **What the review of 2026-11-10 found** (councils `gh`–`gt`, all on stored data, no paid send):\\n129\\t  - Step 4 is the right next step, and inside it the first thing to build and test is the **ladder step alone**: the call that turns a\\n130\\t    thesis Step 1 opened into one judged question with its answer ladder and due day. The frozen judge follows only when the ladder\\n131\\t    step meets its lines.\\n132\\t  - Production's own ladder sentences are not stable: one request, the same in three draws, gave a bullish end at the low amount\\n133\\t    twice and at the high amount once, with three different middle bands; the code checks pass all three\\n134\\t    (`clean-arch/step4-2026-11-10/census/production_ladders.txt`).\\n135\\t  - Of the 34 theses the unseeded draws opened, two blind readers find 12 to 16 that ask more than one thing, 7 to 9 of 18 number\\n136\\t    questions with no reference figure in the opening article, and 4 that state a calendar due day.\\n137\\t- **Alex decided (2026-11-10):** a topic that asks more than one thing gets one judged question, the other parts shown as not judged\\n138\\t  (D397); the ladder step carries D186 in full (D398).\\n139\\t- **Design status:** nine reviews, each by a reviewer new to the work, have each found serious points, narrower each round; the\\n140\\t  ninth found no wrong ladder outside the reader marks and no missing reader or old check. Version 11 answers it and is with a tenth\\n141\\t  reviewer.\\n142\\t- **Two dry runs of the readings ($0;** `clean-arch/step4-2026-11-10/dryrun/`, `dryrun2/`**):**\\n143\\t  - the ladder-reading form catches every planted fault in both reader families (11 of 11, then 9 of 9 in comparison packets);\\n144\\t  - the judgement-reading form must quote the judge's own rules: with them the two families agree on 20 of 20 stored judgements;\\n145\\t  - the stored replays hold a real fault of the frozen judge's daily path (v9 on 2026-07-05), so Stage B's lines are set against a\\n146\\t    baseline reading of the 159 stored judgements, not against a fixed share;\\n147\\t  - reading time: about 90 seconds a packet of six ladders and 51 seconds a judgement for the slower reader.\\n148\\t- **The next task:**\\n149\\t  1. review the design with a fresh reviewer each round until one finds nothing serious;\\n150\\t  2. audit the whole ladder request against its sources with a blind second reader;\\n151\\t  3. ask Alex's word to build the ladder step and run Stage A (the ladder step against a control that quotes v74i, on the 34 stored\\n152\\t     theses and the 10 fresh ones, three sends each), with the numbers of its proposed lines.\\n153\\t- **Open defects recorded by this review:** the frozen judge retried 10, 16 and 18 judgements in the seeded clean draws, 38 of 51\\n154\\t  reasons a theme cited as a dependency (PRD 11, E4), and its stored path holds the 2026-07-05 fault above (frozen; findings for\\n155\\t  Alex); the same matter takes different shapes between draws (Kyber due end-2027 in one draw and end-2028 in another); under D397\\n156\\t  the second bet of a topic that holds two has no answer; a five-state ladder that covers every outcome is hard to write even by\\n157\\t  hand.\\n158\\t- **The unseeded measurement (D395):** graded subset 4.0 against 6.33 seeded. Every miss is a question not opened in the ruler's shape.\\n159\\t  Judged answers 16 of 16, on the ruler's wording and ladder; the system's own questions have never met a judge.\\n160\\t- **Stage 2 of D392:** clean 18, 18, 17 against v108 17, 15, 16, inconclusive on q12.\\n161\\t- **Known gap (D394):** capital spending (q12).\\n162\\t\\n163\\tNo long job is running.\\n164\\t\"}]},\"parent_tool_use_id\":null,\"session_id\":\"5cecf9c0-70aa-4af6-b6ed-c8efc2d30902\",\"uuid\":\"10c8fa1a-fd56-44a2-8130-6ac509996b2c\",\"timestamp\":\"2026-11-09T22:34:57.605Z\",\"tool_use_result\":{\"type\":\"text\",\"file\":{\"filePath\":\"/Users/lchingen/hivemind/docs/CURRENT_STATE.md\",\"content\":\"# Current state\\n\\n**Clean Steps 1–3, current (2026-11-09).** Record: [round log](../clean-arch/step1-unfiled-2026-11-08/LOG.md) §§16–47.\\n- **Step 1 configuration: c8, adopted by Alex (D387).** It runs DeepSeek Flash at high effort, with a 64,000-token output cap; a\\n  format failure or a cut answer is resent once (D380). It carries Alex's decisions D382–D385:\\n  - figures are conditions;\\n  - material statements with no thesis are kept without links;\\n  - only big matters open a thesis;\\n  - no target prices.\\n\\n  [PRD §12](../clean-arch/PRD.md) holds its system prompt, closing check and schema; a run with no candidate files sends exactly the\\n  accepted request.\\n- **Acceptance (D386, [protocol](../clean-arch/step1-unfiled-2026-11-08/ACCEPTANCE-PROTOCOL.md)).** 50 fresh articles that no run,\\n  old or new, had used: news from 2026-09-05 to 09-07, a holiday weekend with no NVIDIA posts. One draw; two readers and a third on\\n  disputes.\\n  - helpful 132/139 (core 83/83);\\n  - wrongly opened theses 1 of 10;\\n  - search 141/143 available repeat pairs, or 141/145 for the whole system (one 11-article story supplies 55 pairs, and revisions are\\n    barely exercised);\\n  - clear wrong merges 1/57, plus 2 overlaps;\\n  - detail retention 22 = 22. This is a storage comparison: every record keeps its own text. It is not a usability test.\\n\\n  Dev ×3 on the frozen golden-v5 (a lead): helpful 214, 211 and 212 of 234; search 98.9–100%; clear wrong merges about 1%. Step 1\\n  cost for the fresh set plus dev ×3: $4.20 at published rates.\\n- **Steps 2 and 3** are built in isolation (`clean-arch/step2`, `clean-arch/step3`): search, comparison, grouping and later linking.\\n  They are not integrated with production storage. **Step 4 (judging) is not built** on the clean path, so nothing yet shows the clean\\n  system can judge an investment view.\\n- **Open defects, by product impact** (reflection council, `council/av-codex.md`):\\n  1. **The Ohio-guarantee yes/no question is never covered** in the three dev draws; a broader credit-support amount thesis opens\\n     instead. Diagnosed (round log §48): the model folds the unsigned guarantee into the open aggregate thesis because the request\\n     uses \\\"covers\\\" both for \\\"is evidence for\\\" and for \\\"already asks this question\\\". The same clause sits under link clutter.\\n  2. **A revenue-share thesis was opened** (Vera Rubin's share of data-center revenue), the class-A boundary of D382.\\n  3. **Link clutter.** A blind recheck of the 34 disputed fresh links found 19 weak and 2 wrong; 10 accepted links mixed in as controls were all useful; the other 49 links were not rechecked.\\n     The model's own account names topic or theme overlap and inference chains, and c8's closing check never reads back a link. This is\\n     a likely cause, with no fix proven. Alex approved designing a protected link check through the council; a first draft was stopped\\n     because it would drop founding premises and contrary facts.\\n  4. **Unverified passages:** 3 of 188 fresh records and 1–3 per dev draw. The mark now travels into Step 2's records, and a reader sees the found source text or an \\\"Unverified quote\\\" label. Jev's comparison input still carries the model's text without the mark; changing it changes measured Step 2 behaviour and needs its own measurement.\\n  5. **The lidar policy thesis** recurs at the boundary (one dev draw in three).\\n- **History.** These earlier states are superseded:\\n  - the 2026-11-07 takeover (K5 → K6b; [takeover log](../clean-arch/takeover-2026-11-07/LOG.md));\\n  - the 2026-11-08 close-out (K6b test 32/42; Step 2 first lines; [Step 2 log](../clean-arch/step2-validation-2026-11-07/LOG.md) §12);\\n  - the unfiled fix round and the c1–c7 arms (round log §§1–39).\\n- **No run is live.** The branch is committed through the D388 line (round log §§48–59).\\n\\n**Clean Step 1 source investigation (2026-11-07):** A [source-loss census](../clean-arch/STEP1-SOURCE-LOSS-CENSUS.md) traces two separate losses in the historical cleaner and records reproducible corpus observations. Offline candidate comparisons expose both recovered content and source-identity or contamination risks. A subsequent [full-page diagnostic](../clean-arch/STEP1-FULL-PAGE-RESULTS.md) completed 102 calls on 17 selected articles and independent source-backed review. It exposes examples of both missing or misattributed source text and model errors that persist despite the right text being present. A Codex–Claude council is reviewing the results and earlier attempts; no source-cleaning candidate is adopted, and the source corpus and production defaults are unchanged.\\n\\nAlex has authorized correcting the test-source cleaner and test data when their defects are confirmed, while the frozen production configuration and ruler remain intact. The cleaner switched 615 originally fed articles off; a replay reproduces all 615, and direct inspection confirms an actual article excluded because its 9,874-character body was flattened to one line. Other examples include a wrong-site shell, paywall and long challenge code, so the false-exclusion count and a general article-identification repair remain to be established. The [council regroup](../clean-arch/STEP1-SOURCE-REGROUP-COUNCIL.md) and [source-preservation design](../clean-arch/STEP1-SOURCE-PRESERVATION-DESIGN.md) describe an isolated candidate checked against all 34,084 records, with a fake-answer actual-runner handoff and provenance display in the replay renderer. The [five source-control calls](../clean-arch/STEP1-CAPTURE-CONTROLS-RESULTS.md) completed and were source-reviewed; two items contain summary details absent from their attached quotations, and one source-visible risk explanation was not returned. This is selected-case evidence, not a general quality result. Broader source-quality comparison, citation completeness and actual writer integration remain open.\\n\\n**Clean architecture Step 1 (2026-11-06, isolated work on `clean-arch`):** Alex reopened work with the clean architecture. An experimental prepared-source handoff now preserves the archived page, prior cleaned text, source-role decisions and selected-line mapping without changing the original database; quotations for prepared items must also occur contiguously in the original captured page. Two seven-item runs are available in the [clean architecture PRD](../clean-arch/PRD.md), one in the earlier selection order and one in recorded page-timestamp order. The source selector is not a production service and source ordering is not established event-arrival ordering. The runs expose unresolved semantic problems: citations can omit supporting facts despite an exact location match; model output can change a benchmark into a deployment, reverse a backup relation, omit a named customer or assign an unstated currency. A blinded 84-call check-placement/wording comparison and a 27-call same-article citation-completion diagnostic did not give a clean semantic fix and are not adopted. The latter missed an omitted connectivity condition and a reversed backup relationship, and left six expected evidence reviews unaddressed. A further five-round Codex–Claude council produced a narrowly scoped Step 1 link candidate, independently checked for prompt-contract drift. A six-article, 36-call blind comparison completed; the candidate still produced an explicitly self-contradictory link and both arms consistently omitted the same Kyber report and company response. It is not adopted and has not changed the active PRD prompt. A trace confirms that both the Kyber report and open Kyber thesis were supplied, and the raw model answers omitted the report and denial; the reason is not established. See ../poc/data/clean-step1-kyber-trace-2026-11-06/TRACE.md. An isolated six-call comparison showed that hiding the Kyber thesis did not recover the report or denial in any draw. A second six-call comparison returned them in 3/3 draws with the original Kyber paragraph alone and 0/3 with the full article; length, position and surrounding content changed together, so the reason is not isolated. Excerpt outputs have source-attribution limitations. Neither experiment changed state or established a production fix. (Superseded: the next task then was a whole-article coverage approach; the current next task is under \\\"One next task\\\".) See ../clean-arch/STEP1-IMPLEMENTATION-COUNCIL.md. The earlier four-round council agreed that no tested semantic fix is ready; its next investigation is a source-backed review of the 49-item historical run and its 160 evidence records, with overlapping issue flags and separate article-level omissions, then a separate comparison of the seven-item replays. See ../clean-arch/STEP1-COUNCIL-REVIEW.md. Preserve relevant evidence while identifying the next intervention; production/frozen history remains as described below. See [Step 1 run log](../clean-arch/STEP1-RUN-LOG.md) and [English reading page](../clean-arch/architecture.html).\\n\\n**Sealed (D379, 2026-11-06):** Alex asked to clean up and seal this version while he re-plans the system design. Work stops here and is sealed as it is: main's working tree is committed on branch `seal/2026-11-06` (tag `sealed-2026-11-06`) and merged into `main` on Alex's word (PR #10); the sealed split and two side experiments are pushed on their own branches (D379). No PRD 11 experiment is open, and the E1 next task below is withdrawn. The next task is Alex's re-planned system design.\\n\\n**E1 diagnosed (2026-11-06, Alex chose E1):** of 57 helpful matters frozen production wrote and then dropped, two readers agree on 17 link misses (4 core), 3 opening misses (1 core) and 24 small matters the standard itself drops; 10 are disputed on the fallback clause and 3 were quote refusals. Opening is not the experiment. The core of the link misses is the model reading a question's period, population or named configuration as a boundary; only 8 of the 13 window draws it dropped were lost to the product. No production change; $0.02 of probes. My recommendation was to fold that narrow change into the next extraction version; withdrawn by the seal (D379). Details: `docs/research/2026-11-06-e1-no-home-drops/README.md`, PRD 11 E1.\\n\\n**Split extraction sealed as a failed experiment (D378, 2026-11-06):** the split (a new-question call, an evidence call and record preparation) was benchmarked against the frozen poc-v108 and failed. Its stop line fired: helpful matters 156, 156, 159 against 166, 170, 162, with about 15% higher cost. One screened revision kept more noise than production. It is sealed in the worktree `hivemind-no-preseed-evidence-review` (tag `split-extraction-failed-sealed-2026-11-06`), and nothing of it is in main. What it taught is written as proposed production experiments in `docs/prd/11-production-experiments-from-split.md`: E1 no-home helpful drops, E2 duplicate questions, E3 ladder checks with D186, E4 judge refusals, E5 D203's revision day, E6 the measurement kit. Each opens only on Alex's word.\\n\\n**Question-catalog limit removed (D377, 2026-11-05):** Alex also directed removal of the separate 150 KB catalog rejection. The research reader in this worktree now has neither the catalog nor evidence byte limit; it retains full scoped questions, historical boundaries, dependencies and evidence. A portable 326,996-byte catalog test returns all 400 new questions and expands evidence both after reading the catalog and directly; the old 150 KB guard fails the same test in a scratch copy. The saved 69-question pilot catalog and all 69 saved evidence expansions match their original content hashes. Details: `docs/research/2026-11-05-catalog-limit/`. The full suite remains pending until the paid seven-day run no longer competes for resources. The run remains in its isolated worktree and does not call this research reader.\\n\\n**Evidence reader limit removed (D376, 2026-11-05):** Alex directed removal of the reader's 1 MB evidence-expansion rejection. In this worktree, `research_context.Reader.expand` now returns the entire evidence payload without that cap, while the catalog's separate limit remained at that checkpoint; D377 subsequently removed it. On the saved pilot ledger, all 69 individual question expansions, the four-question 1,931,225-byte pilot request and the entire 3,454,076-byte catalog produce the exact same content as the pre-change high-limit baseline; the portable oversized-ledger test passes and fails when the old cap is restored in a scratch copy. Details and snapshot-specific measurements are in `docs/research/2026-11-05-reader-limit/`. The seven-day diagnostic runs in `/Users/lchingen/hivemind-no-preseed-evidence-review/poc/data/split-fresh-seven-day-2026-11-05-v2/` with its pinned code; it does not call this research reader. Read its status through its `snapshot.sh`; do not edit its package code while it is live. This change is not an acceptance of seven-day extraction or judgement quality.\\n\\n**Start-state correction (2026-11-05):** Alex requires a research library established from real material available before the test start, then extraction against that state. The prior empty-library diagnostic cannot represent this case. Our own mistakes and the current 68-question provenance audit are in `../hivemind-no-preseed-evidence-review/docs/research/2026-11-05-parallel-refinement/own-mistakes-2026-11-05.zh.md`. Two new A-only calls were run on 2026-08-29 articles using the 68-question prior-day snapshot; both proposed the same aggregate supply-commitments topic. A source/context review judged it distinct from the existing specific SK Hynix question. A third A-only call on an author-body excerpt about DLSS 5, already tracked by v22, passed; the prompt also restricts software updates, so the reason is not established. No writer or dedup ran; source-history completeness remains unverified, and this is not scored acceptance. Details: ../hivemind-no-preseed-evidence-review/docs/research/2026-11-05-parallel-refinement/start-state-diagnostic-2026-11-05.zh.md.\\n\\n**Measurement correction (2026-11-05):** Alex clarified that a gold-worthy topic already in the supplied library should not open again; an absent worthy topic should open. The earlier simple-A claim of a \\\"missed\\\" new topic was not scored against that rule and is withdrawn as a correctness conclusion. In the actual experiment, a Kyber topic was shown and passing follows Alex's topic-level rule; whether its exact release question captures the shipping milestone remains unverified. The experimental pre-article snapshots differ from the replay's day-start snapshots; 9 of 10 inspected examples differ. The current uncommitted replay default does not build a cold-start library; committed main HEAD still uses the old seed and startup filing path. Historical lexical coverage has a confirmed unrelated-topic match. The frozen gold and past scores remain unchanged. Audit: `../hivemind-no-preseed-evidence-review/docs/research/2026-11-05-parallel-refinement/measurement-context-scrub-2026-11-05.zh.md`.\\n\\n**Simple new-question diagnostic (2026-11-05):** At Alex's direction, an isolated prompt returned new questions plus article evidence without asking for product database fields. Four previously seen real dev articles each ran once: three returned one candidate, one returned none, all four quotes matched their source, and the gold-listed GPU backstop amount question was not proposed. Whether that omission is a new-topic miss depends on whether the existing library covers the topic. Two other candidates require source and independent-significance review; the actual experimental snapshot already had a Kyber topic, so its pass follows Alex's topic-level rule; whether its exact release question captures the shipping milestone remains unverified. This is not a production or full-pipeline acceptance. Details: `../hivemind-no-preseed-evidence-review/docs/research/2026-11-05-parallel-refinement/simple-new-question-results.zh.md`.\\n\\n**Split prompt structure v3 read diagnostic (2026-11-05):** One real reading-stage call on a previously seen article found the revenue/margin guidance and Trainium scale but omitted the gold China revenue/market-loss matter. The prewritten stop condition was triggered and the linking call was not sent. This is one draw and not a production or end-to-end result. See `../hivemind-no-preseed-evidence-review/docs/research/2026-11-05-parallel-refinement/structure-v3-read-result.zh.md`. D374 removes the model sampling field from active settings and default configs; historical config files and archives retain their original bytes.\\n\\n**Split prompt structure v2 small test (2026-11-05):** Thirty calls on two previously seen golden-v5 dev articles completed in `../hivemind-no-preseed-evidence-review`. The blind model reader found complete helpful matters in the fresh control versus new A+B of 6/19 vs 10/19, 11/19 vs 7/19, and 9/19 vs 12/19. The new arm also retained more gold not-kept matters in each draw; B missed useful margin guidance and one answer reused IDs, with a demonstrated matching collision. This is not a production acceptance. See `../hivemind-no-preseed-evidence-review/docs/research/2026-11-05-parallel-refinement/structure-v2-results.zh.md` and `reports/2026-11-05-parallel-structure-v2.html`.\\n\\n**Split extraction small test (2026-11-05):** At Alex's request, the isolated `hivemind-no-preseed-evidence-review` worktree ran two real golden-v5 articles once through each split lane. An independent model reader found 7 of 19 helpful gold matters fully retained, two partial, two written then dropped, eight missed, and one retained gold not-kept matter. Three saved v108 draws on these articles retained 7, 9 and 12 of 19, but used 22 seeded questions while the new test used 8/10-question snapshots; these are not directly comparable. The experiment remains unaccepted; see `../hivemind-no-preseed-evidence-review/docs/research/2026-11-05-parallel-refinement/small-scored-test-20261105.md` and `reports/2026-11-05-split-small-test.html`.\\n\\nAs of November 5, 2026; decisions through D374. [Decisions](DECISIONS.md) holds what is decided now; the [design page](system-design.html) and the [module PRDs](prd/README.md) hold what the code must do; the [README](../README.md) holds startup, build and run instructions.\\n\\n## Future evidence scoring (D372)\\n\\nAlex decided future gold scoring should measure helpful versus not helpful evidence without requiring separate scores for core and supporting. Use frozen golden-v5 as-is: combine core and supporting as helpful, treat not-kept as unhelpful, and keep optional entries neutral. A counting report has not yet been implemented. Historical scores retain their original definitions. D373 removes the stop caused by a separate concern about three question-gold entries: keep the gold unchanged, continue scoring and disclose the concern; see `../hivemind-no-preseed-evidence-review/docs/research/2026-11-05-parallel-refinement/ruler-conflict-2026-11-05.zh.md`.\\n\\n## Latest decision (D369)\\n\\nAlex decided in D369 to capture core and supporting evidence without a strict boundary and in D370 to remove the 22 preset starting questions and separate earnings-report import. The replay entry now defaults to `poc-v118` (D374), refuses old seeded ledgers and baseline configurations, and continues to read existing non-seeded questions; earnings releases remain normal source items. This change has local contract tests but has not passed end-to-end product acceptance. The frozen historical rulers and results remain unchanged.\\n\\nThe small 2026-11-05 study used three archived NVDA articles and an 8/28 historical 68-question snapshot: without versus with an appended report, independent AI review found 14/27 versus 13/27 complete matters. This measured appended extraction context, not the distinct former coverage-start step; D370 removes both by Alex's decision. Full traces and limitations are in the separate `hivemind-no-preseed-evidence-review` worktree under `docs/research/2026-11-05-real-input-evidence/existing-library-results-2026-11-05.md`.\\n\\n\\n**One-day smoke completed (2026-11-05 UTC):** Alex requested a quick 1–2 day end-to-end test. One day, 2026-08-29, ran in `/Users/lchingen/hivemind-no-preseed-evidence-review/poc/data/v117-one-day-smoke-2026-11-05/`: config v117, an 8/28 historical library, 40 extraction calls, 93 evidence records written, four new questions, 54 judged and zero terminal failures. Two judgement attempts were refused and corrected. A Microsoft revenue forecast of $391.1bn was assigned to a rung whose upper bound excludes $391.1bn; the same article's actual quarterly revenue and next-quarter guidance were dropped with no home. Some source dates and bodies are not verified, and an independent 14-article sample review was incomplete due to truncated text. This is not semantic or production acceptance. Findings and scope: `docs/research/2026-11-05-real-input-evidence/one-day-v117-smoke-2026-11-05.zh.md` in that worktree. The clean source-text comparison and its condition-hidden review are complete; council discussion of next steps is ongoing.\\n\\n**D371, in progress:** Alex directed that present and forward-looking revenue and financial information should be tracked. Diagnose the same-day extraction and filing losses before designing a general change. No new financial tracking implementation has been accepted yet. The old frozen standard and gold are unchanged. The original prompt-only pilot failed design review. The user approved an exact prompt addition for an experiment; it is not a production implementation. Four paired real-article diagnostic calls per arm completed for the exact approved sentence: v74i versus experimental role-d371-pilot. Microsoft next-quarter guidance and NVIDIA FY2028 guidance still dropped in the treatment; a single draw is not acceptance or proof of causation. Details: docs/research/2026-11-05-real-input-evidence/d371-prompt-pilot-results.zh.md (isolated worktree). The requested full prompt audit and restructure were drafted experimentally; five real-article paired diagnostic requests per arm completed. Microsoft revenue guidance was missed in both arms, and the draft produced unsupported original dates, a quote refusal and suspect links. No production prompt change or acceptance; see restructure-pilot-results.zh.md in the isolated worktree.\\n\\n**Clean Step 1 coverage council (2026-11-06):** Codex and Claude Code independently reviewed the existing attempts and completed three discussion rounds. The proposed next research candidate moves the existing evidence-reading block ahead of the thesis-opening block while preserving the article, open-thesis state and paired output. It is a hypothesis, not an implemented or validated fix. A complete prompt/contract audit and independent review precede any controlled Luna comparison. Historical paragraph-based and source-first experiments, their noise and attribution problems, and the rejected overlap-based merge are recorded in [the council review](../clean-arch/STEP1-COVERAGE-COUNCIL.md). No new Luna experiment was run in the council.\\n\\n**Clean Step 1 coverage order result (2026-11-07):** The isolated 54-call clean comparison completed and all answers were reviewed blind. Moving the evidence-reading block recovered a known Kyber report and denial in one of three candidate answers against none in three controls, with attribution blur; it also produced unsupported gaming-to-AI links in two candidate answers and no controls. It is not adopted. A separate exact-quote example misattributes an executive's prediction in the standalone summary. [Results and replay](../clean-arch/STEP1-COVERAGE-ORDER-RESULTS.md) record all selected cases, uncertainties and source-fidelity work; no production ledger was written.\\n\\n**Clean Step 1 fidelity council (2026-11-07):** Codex and Claude Code completed five rounds on source attribution, conditions, dates and meaning. No tested fix or root cause is established. The agreed source-to-record review of 49 articles / 160 evidence items and the subsequent isolated field-order comparison are complete; the later 54-answer / 217-record repeated sample remains separate. Prior source-first, quote-first and follow-up-review experiments and their limits are recorded in [the fidelity council](../clean-arch/STEP1-FIDELITY-COUNCIL.md). No Luna experiment or production change was made in this council.\\n\\n**Clean Step 1 fidelity review (2026-11-07):** All 49 saved source packets and 160 original evidence items have received a source-and-record review; focused independent cross-checks cover the findings and selected controls. The [review and article replay](../clean-arch/STEP1-FIDELITY-REVIEW.md) distinguish source contamination and missing source material from model meaning, citation, date and link issues. The [isolated schema property-order diagnostic](../clean-arch/STEP1-CITATION-ORDER-RESULTS.md) completed all 66 calls and condition-blinded article reviews. Several omissions and semantic errors persisted; it did not establish a fix and is not adopted. It used saved articles and before-states without changing production.\\n\\n**Clean Step 1 source handoff council (2026-11-07):** The ongoing [council and offline checks](../clean-arch/STEP1-SOURCE-HANDOFF-COUNCIL.md) reconstructed 16 matching article-34 controls, all omitting a Kyber report and denial; the cause remains unknown. The 20-article saved source-role overlap review distinguished previously cited AI-generated summary lines and an unrelated recommendation from authored body. The clean runner does not send the saved source-role labels; the council chose to first compare original and previously selected source text on ten known articles. The isolated 60-call source-text comparison and condition-hidden review are complete; [results](../clean-arch/STEP1-SOURCE-TEXT-RESULTS.md) show specific contamination reductions alongside persistent omissions and changed meaning. It did not advance state or write production. The isolated six-article low-versus-medium source-fidelity diagnostic completed 36/36 calls and condition-hidden review. [Results](../clean-arch/STEP1-REASONING-FIDELITY-RESULTS.md) show partial improvements alongside persistent source-qualification and attribution concerns; no production setting is changed. The [prompt audit](../clean-arch/STEP1-FIDELITY-PROMPT-AUDIT.md) maps the observed failures to the full request and signed standard. The six-article isolated schema-description comparison completed 36/36 calls and condition-hidden review; the candidate did not preserve the repeated example qualification and is not adopted. [Results](../clean-arch/STEP1-SUMMARY-FIDELITY-RESULTS.md). A further six-article 36-call low-versus-medium comparison used corpus-cleaned sources outside the original 49-item clean replay and a fixed exploratory context; results were mixed, including unsupported links and incorrect attribution/date fields. [Results and replay](../clean-arch/STEP1-ADDITIONAL-SOURCES-RESULTS.md). The structured-claims candidate was not sent after review revealed scope and complexity concerns. Council review of the next action is ongoing. The date-text schema-description diagnostic completed 48/48 calls on eight known cases, with mixed results; the candidate is not adopted. A selected-run census found twelve literal \\\"null\\\" strings in date-text fields, but no production writer impact is established. [Results and replay](../clean-arch/STEP1-DATE-DESCRIPTION-RESULTS.md). A further preregistered eight-source date comparison completed 48/48 calls; the candidate lost a supported company-article statement date in all three draws on one source and is not adopted. [Results and replay](../clean-arch/STEP1-DATE-NEW-SOURCES-RESULTS.md). A bounded corpus census confirmed 163 source pages across three explicit generated-summary structures whose labels were removed while some summary text was retained; two NVIDIA cases were reproduced through the cleaner. [Source provenance investigation](../clean-arch/STEP1-SOURCE-PROVENANCE-CENSUS.md). A read-only source-lineage replay reproduced 363/363 cleaned pages with current inputs, preserved ambiguous original-line locations, and surfaced the generated-summary label loss for review. [Source investigation and lineage replay](../clean-arch/STEP1-SOURCE-PROVENANCE-CENSUS.md). An offline neighboring-context observation exposed only 144 or 149 of 163 known labels and introduced many other page lines; it is not adopted as a general source fix. [Observations and viewer](../clean-arch/STEP1-SOURCE-CONTEXT-OBSERVATIONS.md). A new [saved-quote integrity investigation](../clean-arch/STEP1-QUOTE-INTEGRITY-CENSUS.md) reconstructed 360 saved answers across eight overlapping cohorts, including 78 prepared-source calls. Five saved unverified passage instances were complete matches under the existing normalization; an in-memory candidate recovered their original slices, while ten others remained unverified. The normalized source-slice lookup is now installed only in the isolated clean Step 1 runner; saved-answer and entry-point checks are recorded there. Page provenance, Unicode completeness, production resource budgets and writer integration remain open. The existing writer stores only one quote, whereas 63 of 160 evidence items in the 49-article exploratory trace have multiple passages. A [source-first 49-article coverage review](../clean-arch/STEP1-COVERAGE-CENSUS.md) separates material missing from the model input from source-visible omissions in the saved answers, with uncertain matter boundaries labeled. (Superseded: the next investigation then was why supplied material is missed; the current next task is under \\\"One next task\\\".) The canonical prompt and production configuration remain unchanged. Adding fallible role annotations remains a separate untested candidate. Council streams and handoffs are in `poc/data/clean-step1-ongoing-council-2026-11-07/`.\\n\\n## What runs\\n\\n- **Pipeline (replay default `poc/config/poc-v118.json`, D370, D374).** Every item reads the relevant open questions from the library at the start of its day, then extraction v74i on `gpt-6-luna` proposes evidence and questions; Jev matching with the collision judge matches them; code writes the records; judging-v7 judges changes once a day; pull mode closes due questions. There is no separate seed or coverage-start report import, and reports as source items remain eligible. This default has not completed end-to-end acceptance. The [pipeline guide](poc/pipeline-plan.md) maps stages to code.\\n- **Measured:** one company (NVDA) over one 14-day window (2026-07-01 to 07-14), the judgement scored at the window end on the frozen ruler (AGENTS §7.1). Three draws of `poc-v116` against three of `poc-v108` run in the same hours: 53 against 45 agreements of 57; operating margin and capex agree in 3 of 3 draws, never judged without the coverage-start reading ([acceptance](research/2026-11-04-filing-end-to-end/acceptance-design.md)).\\n- **Served data:** the service, the MCP server and the standalone page serve the sealed three-month ledger `served-2026-10-28-v34-nvda-3m-through-0828` (68 theses, 34 groups; D358), built by the earlier `poc-v34` pipeline, not by the replay default. HTTP `/library`, MCP `thesis_library` and the standalone page share the dated bundle writer.\\n- **Idea API:** `poc-v118-idea` (D290, D335, D374): two discovery calls and one adoption and weighting assessment; only adopted theses with positive weights appear, and nonempty plans total 100%. The [Idea contract](poc/idea-card.md) owns its fields and the limits of its scores.\\n- **Interface:** the Thesis Library and Explore Ideas workspaces, with the confidence Trigger and an Action preview (no wallet connection or order execution). The [UI specification](poc/thesis-ui.md) and the [integration guide](../poc/ui/README.md) own its behaviour.\\n- **Repository:** `main` holds the product, the frozen ruler and the research records; run databases, logs and model archives stay on disk (D353), located by the [data manifest](research/2026-10-25-english/data-manifest.md). Worktrees: `/Users/lchingen/hivemind` is the main checkout, where slice branches are cut from `main`; `/Users/lchingen/hivemind-extraction-quality-2026-10-28` (the extraction branch, merged on 2026-11-03) keeps in its ignored folders the stored end-to-end runs of `poc-v91` to `poc-v95` that later comparisons read (D359); `/Users/lchingen/hivemind-run-v109-2026-11-04` is the finished judging-v8 run's worktree. Older branches stay in Git without worktrees (D359); none is merged work in progress. The clean source-text comparison and its condition-hidden review are complete; council discussion of next steps is ongoing.\\n\\n## Open defects\\n\\n1. **Competitor and customer news is filed under the company's revenue questions** instead of the share, capital-spending or custom-chip question it informs (D355; filing is otherwise about 85% right). Share facts are often not written at all, an extraction recall miss. The total-revenue question holds about a quarter of all links (D354).\\n2. **One bet opened twice** about one encounter in five: the collision judge splits a seed question from an identical candidate on a fine detail (D354).\\n3. **A question the standard rules out** (the lidar legislation) was proposed by the extraction and opened in one draw of three (D354).\\n4. **A thesis opened from an article gets no dependency of its own**: the default Jev matching asks for none (`views/jev_matching.py`), although D51 has the matching call choose them; themes still reach every company thesis through the theme block (D191, D195). Found in the 2026-11-05 consolidation; building it is decided (D368).\\n5. **Historical coverage-start reading, retired by D370** (D364–D366): the capital-spending line is missed in about one read in six (the question is then left as it was); a labelled guidance figure is written with the fact tier; later reports reach the questions only through the daily stream; `scripts/preflight.py` does not replay the reading's check.\\n6. **Measured on one company and one 14-day window**, the judgement scored at the window end only; no version of the current pipeline has completed a longer window (a 60-day run of `poc-v108` was stopped at Alex's word after 2026-07-15, [log row 8](research/2026-11-04-argument-record/log.md)). The China-share question (v17) swings between draws (0 of 3 in the acceptance, 2 of 3 in its control, 1 of 3 in the frozen draws): two readers found the starting figures did not cause the acceptance's drop, and the byte-identical extraction request kept a \\\"share fell to zero\\\" sentence in two candidate draws and dropped it in two control draws. One acceptance draw judged nothing on v16; its cause is not established.\\n7. **What a judgement reads grows with the window** (D358). Argument records (D201) were measured as the remedy on 2026-11-04 and not built: judging-v8 agreed 12 of 17 against 15 of 17, judging-v9's card added little at about half again the judging cost; their code was removed at Alex's request ([log rows 4–11](research/2026-11-04-argument-record/log.md)).\\n8. **Seen once, not traced.** A judgement named a shown theme as a dependency and the check refused it twice, stopping a draw for a day (2026-11-02, D266). The sealed run's review recorded that a succession's opening evidence is not linked to the new question (D358), not yet checked against today's code.\\n9. **Earlier defects, unchanged.** Matching (build log row 49): another document's copy of a figure can be treated as new evidence; one matter can occupy several groups; same-answer candidate references caused seven chain or duplication decisions of the generative matcher; empty `original_who` values can count as the same party; different names for one population cause two of nine Jev merge misses. Nine 2026 aggregate-spending theses under `ai-capex` each have a different population; whether to combine them is a product choice. Extraction's instructions remain narrower than the PRD's important-question rule and omit the personal-memo exception, and extraction can change a quantity's meaning before matching (a guarantee amount against financing provided). Classification keeps its [recorded simulation defects](research/2026-10-25-english/classification-existing-defects.txt). The corpus audit recorded 97 official notices with 56 body and file-name collisions, to re-fetch before relying on a rebuilt corpus. An older intermittent search-test failure is untraced. Fresh Idea allocations vary while saved weights do not; the confidence chart applies the current plan to past states and is not a calibrated probability; broad analyst-prose quality and fresh Idea stability remain unaccepted (the [Idea contract](poc/idea-card.md) lists its limits); generative matching dependencies await `matching-v4`. The readers' doubts about the frozen standard, listed in the [extraction branch's state page](research/2026-11-01-e2e-loop/current-state-extraction-branch-2026-11-03.md), remain for Alex.\\n\\nUpstream supply and the human review pool's output remain deferred.\\n\\n## One next task\\n\\n**Clean Step 4 (D396–D398): design version 11 is in review; the build waits for a clean review, the request audit and Alex's word**\\n([design](../clean-arch/step4-2026-11-10/DESIGN.md); round log §69).\\n\\n- **What the review of 2026-11-10 found** (councils `gh`–`gt`, all on stored data, no paid send):\\n  - Step 4 is the right next step, and inside it the first thing to build and test is the **ladder step alone**: the call that turns a\\n    thesis Step 1 opened into one judged question with its answer ladder and due day. The frozen judge follows only when the ladder\\n    step meets its lines.\\n  - Production's own ladder sentences are not stable: one request, the same in three draws, gave a bullish end at the low amount\\n    twice and at the high amount once, with three different middle bands; the code checks pass all three\\n    (`clean-arch/step4-2026-11-10/census/production_ladders.txt`).\\n  - Of the 34 theses the unseeded draws opened, two blind readers find 12 to 16 that ask more than one thing, 7 to 9 of 18 number\\n    questions with no reference figure in the opening article, and 4 that state a calendar due day.\\n- **Alex decided (2026-11-10):** a topic that asks more than one thing gets one judged question, the other parts shown as not judged\\n  (D397); the ladder step carries D186 in full (D398).\\n- **Design status:** nine reviews, each by a reviewer new to the work, have each found serious points, narrower each round; the\\n  ninth found no wrong ladder outside the reader marks and no missing reader or old check. Version 11 answers it and is with a tenth\\n  reviewer.\\n- **Two dry runs of the readings ($0;** `clean-arch/step4-2026-11-10/dryrun/`, `dryrun2/`**):**\\n  - the ladder-reading form catches every planted fault in both reader families (11 of 11, then 9 of 9 in comparison packets);\\n  - the judgement-reading form must quote the judge's own rules: with them the two families agree on 20 of 20 stored judgements;\\n  - the stored replays hold a real fault of the frozen judge's daily path (v9 on 2026-07-05), so Stage B's lines are set against a\\n    baseline reading of the 159 stored judgements, not against a fixed share;\\n  - reading time: about 90 seconds a packet of six ladders and 51 seconds a judgement for the slower reader.\\n- **The next task:**\\n  1. review the design with a fresh reviewer each round until one finds nothing serious;\\n  2. audit the whole ladder request against its sources with a blind second reader;\\n  3. ask Alex's word to build the ladder step and run Stage A (the ladder step against a control that quotes v74i, on the 34 stored\\n     theses and the 10 fresh ones, three sends each), with the numbers of its proposed lines.\\n- **Open defects recorded by this review:** the frozen judge retried 10, 16 and 18 judgements in the seeded clean draws, 38 of 51\\n  reasons a theme cited as a dependency (PRD 11, E4), and its stored path holds the 2026-07-05 fault above (frozen; findings for\\n  Alex); the same matter takes different shapes between draws (Kyber due end-2027 in one draw and end-2028 in another); under D397\\n  the second bet of a topic that holds two has no answer; a five-state ladder that covers every outcome is hard to write even by\\n  hand.\\n- **The unseeded measurement (D395):** graded subset 4.0 against 6.33 seeded. Every miss is a question not opened in the ruler's shape.\\n  Judged answers 16 of 16, on the ruler's wording and ladder; the system's own questions have never met a judge.\\n- **Stage 2 of D392:** clean 18, 18, 17 against v108 17, 15, 16, inconclusive on q12.\\n- **Known gap (D394):** capital spending (q12).\\n\\nNo long job is running.\\n\",\"numLines\":164,\"startLine\":1,\"totalLines\":164}},\"tool_result_meta\":[{\"id\":\"toolu_0136a6FhCnMG99wB6qWXWcWc\",\"permission_decision\":{\"decision\":\"accept\",\"source\":\"config\",\"reason_type\":\"mode\"}}]}\n./reports/step2-jev-decision-council-2026-11-09/codex-second.stderr:197:reports/step2-jev-decision-council-2026-11-09/codex-independent.jsonl:11:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_4\",\"type\":\"command_execution\",\"command\":\"/opt/homebrew/bin/zsh -lc \\\"cat docs/CURRENT_STATE.md; sed -n '129,190p' clean-arch/PRD.md; cat clean-arch/step2/compare.py clean-arch/step3/library.py\\\"\",\"aggregated_output\":\"# Current state\\n\\n**Clean Steps 1–3, current (2026-11-09).** Record: [round log](../clean-arch/step1-unfiled-2026-11-08/LOG.md) §§16–47.\\n- **Step 1 configuration: c8, adopted by Alex (D387).** It runs DeepSeek Flash at high effort, with a 64,000-token output cap; a\\n  format failure or a cut answer is resent once (D380). It carries Alex's decisions D382–D385:\\n  - figures are conditions;\\n  - material statements with no thesis are kept without links;\\n  - only big matters open a thesis;\\n  - no target prices.\\n\\n  [PRD §12](../clean-arch/PRD.md) holds its system prompt, closing check and schema; a run with no candidate files sends exactly the\\n  accepted request.\\n- **Acceptance (D386, [protocol](../clean-arch/step1-unfiled-2026-11-08/ACCEPTANCE-PROTOCOL.md)).** 50 fresh articles that no run,\\n  old or new, had used: news from 2026-09-05 to 09-07, a holiday weekend with no NVIDIA posts. One draw; two readers and a third on\\n  disputes.\\n  - helpful 132/139 (core 83/83);\\n  - wrongly opened theses 1 of 10;\\n  - search 141/143 available repeat pairs, or 141/145 for the whole system (one 11-article story supplies 55 pairs, and revisions are\\n    barely exercised);\\n  - clear wrong merges 1/57, plus 2 overlaps;\\n  - detail retention 22 = 22. This is a storage comparison: every record keeps its own text. It is not a usability test.\\n\\n  Dev ×3 on the frozen golden-v5 (a lead): helpful 214, 211 and 212 of 234; search 98.9–100%; clear wrong merges about 1%. Step 1\\n  cost for the fresh set plus dev ×3: $4.20 at published rates.\\n- **Steps 2 and 3** are built in isolation (`clean-arch/step2`, `clean-arch/step3`): search, comparison, grouping and later linking.\\n  They are not integrated with production storage. **Step 4 (judging) is not built** on the clean path, so nothing yet shows the clean\\n  system can judge an investment view.\\n- **Open defects, by product impact** (reflection council, `council/av-codex.md`):\\n  1. **The Ohio-guarantee yes/no question is never covered** in the three dev draws; a broader credit-support amount thesis opens\\n     instead. Diagnosed (round log §48): the model folds the unsigned guarantee into the open aggregate thesis because the request\\n     uses \\\"covers\\\" both for \\\"is evidence for\\\" and for \\\"already asks this question\\\". The same clause sits under link clutter.\\n  2. **A revenue-share thesis was opened** (Vera Rubin's share of data-center revenue), the class-A boundary of D382.\\n  3. **Link clutter.** A blind recheck of the 34 disputed fresh links found 19 weak and 2 wrong; 10 accepted links mixed in as controls were all useful; the other 49 links were not rechecked.\\n     The model's own account names topic or theme overlap and inference chains, and c8's closing check never reads back a link. This is\\n     a likely cause, with no fix proven. Alex approved designing a protected link check through the council; a first draft was stopped\\n     because it would drop founding premises and contrary facts.\\n  4. **Unverified passages:** 3 of 188 fresh records and 1–3 per dev draw. The mark now travels into Step 2's records, and a reader sees the found source text or an \\\"Unverified quote\\\" label. Jev's comparison input still carries the model's text without the mark; changing it changes measured Step 2 behaviour and needs its own measurement.\\n  5. **The lidar policy thesis** recurs at the boundary (one dev draw in three).\\n- **History.** These earlier states are superseded:\\n  - the 2026-11-07 takeover (K5 → K6b; [takeover log](../clean-arch/takeover-2026-11-07/LOG.md));\\n  - the 2026-11-08 close-out (K6b test 32/42; Step 2 first lines; [Step 2 log](../clean-arch/step2-validation-2026-11-07/LOG.md) §12);\\n  - the unfiled fix round and the c1–c7 arms (round log §§1–39).\\n- **No run is live.** The branch is committed through the D388 line (round log §§48–59).\\n\\n**Clean Step 1 source investigation (2026-11-07):** A [source-loss census](../clean-arch/STEP1-SOURCE-LOSS-CENSUS.md) traces two separate losses in the historical cleaner and records reproducible corpus observations. Offline candidate comparisons expose both recovered content and source-identity or contamination risks. A subsequent [full-page diagnostic](../clean-arch/STEP1-FULL-PAGE-RESULTS.md) completed 102 calls on 17 selected articles and independent source-backed review. It exposes examples of both missing or misattributed source text and model errors that persist despite the right text being present. A Codex–Claude council is reviewing the results and earlier attempts; no source-cleaning candidate is adopted, and the source corpus and production defaults are unchanged.\\n\\nAlex has authorized correcting the test-source cleaner and test data when their defects are confirmed, while the frozen production configuration and ruler remain intact. The cleaner switched 615 originally fed articles off; a replay reproduces all 615, and direct inspection confirms an actual article excluded because its 9,874-character body was flattened to one line. Other examples include a wrong-site shell, paywall and long challenge code, so the false-exclusion count and a general article-identification repair remain to be established. The [council regroup](../clean-arch/STEP1-SOURCE-REGROUP-COUNCIL.md) and [source-preservation design](../clean-arch/STEP1-SOURCE-PRESERVATION-DESIGN.md) describe an isolated candidate checked against all 34,084 records, with a fake-answer actual-runner handoff and provenance display in the replay renderer. The [five source-control calls](../clean-arch/STEP1-CAPTURE-CONTROLS-RESULTS.md) completed and were source-reviewed; two items contain summary details absent from their attached quotations, and one source-visible risk explanation was not returned. This is selected-case evidence, not a general quality result. Broader source-quality comparison, citation completeness and actual writer integration remain open.\\n\\n**Clean architecture Step 1 (2026-11-06, isolated work on `clean-arch`):** Alex reopened work with the clean architecture. An experimental prepared-source handoff now preserves the archived page, prior cleaned text, source-role decisions and selected-line mapping without changing the original database; quotations for prepared items must also occur contiguously in the original captured page. Two seven-item runs are available in the [clean architecture PRD](../clean-arch/PRD.md), one in the earlier selection order and one in recorded page-timestamp order. The source selector is not a production service and source ordering is not established event-arrival ordering. The runs expose unresolved semantic problems: citations can omit supporting facts despite an exact location match; model output can change a benchmark into a deployment, reverse a backup relation, omit a named customer or assign an unstated currency. A blinded 84-call check-placement/wording comparison and a 27-call same-article citation-completion diagnostic did not give a clean semantic fix and are not adopted. The latter missed an omitted connectivity condition and a reversed backup relationship, and left six expected evidence reviews unaddressed. A further five-round Codex–Claude council produced a narrowly scoped Step 1 link candidate, independently checked for prompt-contract drift. A six-article, 36-call blind comparison completed; the candidate still produced an explicitly self-contradictory link and both arms consistently omitted the same Kyber report and company response. It is not adopted and has not changed the active PRD prompt. A trace confirms that both the Kyber report and open Kyber thesis were supplied, and the raw model answers omitted the report and denial; the reason is not established. See ../poc/data/clean-step1-kyber-trace-2026-11-06/TRACE.md. An isolated six-call comparison showed that hiding the Kyber thesis did not recover the report or denial in any draw. A second six-call comparison returned them in 3/3 draws with the original Kyber paragraph alone and 0/3 with the full article; length, position and surrounding content changed together, so the reason is not isolated. Excerpt outputs have source-attribution limitations. Neither experiment changed state or established a production fix. (Superseded: the next task then was a whole-article coverage approach; the current next task is under \\\"One next task\\\".) See ../clean-arch/STEP1-IMPLEMENTATION-COUNCIL.md. The earlier four-round council agreed that no tested semantic fix is ready; its next investigation is a source-backed review of the 49-item historical run and its 160 evidence records, with overlapping issue flags and separate article-level omissions, then a separate comparison of the seven-item replays. See ../clean-arch/STEP1-COUNCIL-REVIEW.md. Preserve relevant evidence while identifying the next intervention; production/frozen history remains as described below. See [Step 1 run log](../clean-arch/STEP1-RUN-LOG.md) and [English reading page](../clean-arch/architecture.html).\\n\\n**Sealed (D379, 2026-11-06):** Alex asked to clean up and seal this version while he re-plans the system design. Work stops here and is sealed as it is: main's working tree is committed on branch `seal/2026-11-06` (tag `sealed-2026-11-06`) and merged into `main` on Alex's word (PR #10); the sealed split and two side experiments are pushed on their own branches (D379). No PRD 11 experiment is open, and the E1 next task below is withdrawn. The next task is Alex's re-planned system design.\\n\\n**E1 diagnosed (2026-11-06, Alex chose E1):** of 57 helpful matters frozen production wrote and then dropped, two readers agree on 17 link misses (4 core), 3 opening misses (1 core) and 24 small matters the standard itself drops; 10 are disputed on the fallback clause and 3 were quote refusals. Opening is not the experiment. The core of the link misses is the model reading a question's period, population or named configuration as a boundary; only 8 of the 13 window draws it dropped were lost to the product. No production change; $0.02 of probes. My recommendation was to fold that narrow change into the next extraction version; withdrawn by the seal (D379). Details: `docs/research/2026-11-06-e1-no-home-drops/README.md`, PRD 11 E1.\\n\\n**Split extraction sealed as a failed experiment (D378, 2026-11-06):** the split (a new-question call, an evidence call and record preparation) was benchmarked against the frozen poc-v108 and failed. Its stop line fired: helpful matters 156, 156, 159 against 166, 170, 162, with about 15% higher cost. One screened revision kept more noise than production. It is sealed in the worktree `hivemind-no-preseed-evidence-review` (tag `split-extraction-failed-sealed-2026-11-06`), and nothing of it is in main. What it taught is written as proposed production experiments in `docs/prd/11-production-experiments-from-split.md`: E1 no-home helpful drops, E2 duplicate questions, E3 ladder checks with D186, E4 judge refusals, E5 D203's revision day, E6 the measurement kit. Each opens only on Alex's word.\\n\\n**Question-catalog limit removed (D377, 2026-11-05):** Alex also directed removal of the separate 150 KB catalog rejection. The research reader in this worktree now has neither the catalog nor evidence byte limit; it retains full scoped questions, historical boundaries, dependencies and evidence. A portable 326,996-byte catalog test returns all 400 new questions and expands evidence both after reading the catalog and directly; the old 150 KB guard fails the same test in a scratch copy. The saved 69-question pilot catalog and all 69 saved evidence expansions match their original content hashes. Details: `docs/research/2026-11-05-catalog-limit/`. The full suite remains pending until the paid seven-day run no longer competes for resources. The run remains in its isolated worktree and does not call this research reader.\\n\\n**Evidence reader limit removed (D376, 2026-11-05):** Alex directed removal of the reader's 1 MB evidence-expansion rejection. In this worktree, `research_context.Reader.expand` now returns the entire evidence payload without that cap, while the catalog's separate limit remained at that checkpoint; D377 subsequently removed it. On the saved pilot ledger, all 69 individual question expansions, the four-question 1,931,225-byte pilot request and the entire 3,454,076-byte catalog produce the exact same content as the pre-change high-limit baseline; the portable oversized-ledger test passes and fails when the old cap is restored in a scratch copy. Details and snapshot-specific measurements are in `docs/research/2026-11-05-reader-limit/`. The seven-day diagnostic runs in `/Users/lchingen/hivemind-no-preseed-evidence-review/poc/data/split-fresh-seven-day-2026-11-05-v2/` with its pinned code; it does not call this research reader. Read its status through its `snapshot.sh`; do not edit its package code while it is live. This change is not an acceptance of seven-day extraction or judgement quality.\\n\\n**Start-state correction (2026-11-05):** Alex requires a research library established from real material available before the test start, then extraction against that state. The prior empty-library diagnostic cannot represent this case. Our own mistakes and the current 68-question provenance audit are in `../hivemind-no-preseed-evidence-review/docs/research/2026-11-05-parallel-refinement/own-mistakes-2026-11-05.zh.md`. Two new A-only calls were run on 2026-08-29 articles using the 68-question prior-day snapshot; both proposed the same aggregate supply-commitments topic. A source/context review judged it distinct from the existing specific SK Hynix question. A third A-only call on an author-body excerpt about DLSS 5, already tracked by v22, passed; the prompt also restricts software updates, so the reason is not established. No writer or dedup ran; source-history completeness remains unverified, and this is not scored acceptance. Details: ../hivemind-no-preseed-evidence-review/docs/research/2026-11-05-parallel-refinement/start-state-diagnostic-2026-11-05.zh.md.\\n\\n**Measurement correction (2026-11-05):** Alex clarified that a gold-worthy topic already in the supplied library should not open again; an absent worthy topic should open. The earlier simple-A claim of a \\\"missed\\\" new topic was not scored against that rule and is withdrawn as a correctness conclusion. In the actual experiment, a Kyber topic was shown and passing follows Alex's topic-level rule; whether its exact release question captures the shipping milestone remains unverified. The experimental pre-article snapshots differ from the replay's day-start snapshots; 9 of 10 inspected examples differ. The current uncommitted replay default does not build a cold-start library; committed main HEAD still uses the old seed and startup filing path. Historical lexical coverage has a confirmed unrelated-topic match. The frozen gold and past scores remain unchanged. Audit: `../hivemind-no-preseed-evidence-review/docs/research/2026-11-05-parallel-refinement/measurement-context-scrub-2026-11-05.zh.md`.\\n\\n**Simple new-question diagnostic (2026-11-05):** At Alex's direction, an isolated prompt returned new questions plus article evidence without asking for product database fields. Four previously seen real dev articles each ran once: three returned one candidate, one returned none, all four quotes matched their source, and the gold-listed GPU backstop amount question was not proposed. Whether that omission is a new-topic miss depends on whether the existing library covers the topic. Two other candidates require source and independent-significance review; the actual experimental snapshot already had a Kyber topic, so its pass follows Alex's topic-level rule; whether its exact release question captures the shipping milestone remains unverified. This is not a production or full-pipeline acceptance. Details: `../hivemind-no-preseed-evidence-review/docs/research/2026-11-05-parallel-refinement/simple-new-question-results.zh.md`.\\n\\n**Split prompt structure v3 read diagnostic (2026-11-05):** One real reading-stage call on a previously seen article found the revenue/margin guidance and Trainium scale but omitted the gold China revenue/market-loss matter. The prewritten stop condition was triggered and the linking call was not sent. This is one draw and not a production or end-to-end result. See `../hivemind-no-preseed-evidence-review/docs/research/2026-11-05-parallel-refinement/structure-v3-read-result.zh.md`. D374 removes the model sampling field from active settings and default configs; historical config files and archives retain their original bytes.\\n\\n**Split prompt structure v2 small test (2026-11-05):** Thirty calls on two previously seen golden-v5 dev articles completed in `../hivemind-no-preseed-evidence-review`. The blind model reader found complete helpful matters in the fresh control versus new A+B of 6/19 vs 10/19, 11/19 vs 7/19, and 9/19 vs 12/19. The new arm also retained more gold not-kept matters in each draw; B missed useful margin guidance and one answer reused IDs, with a demonstrated matching collision. This is not a production acceptance. See `../hivemind-no-preseed-evidence-review/docs/research/2026-11-05-parallel-refinement/structure-v2-results.zh.md` and `reports/2026-11-05-parallel-structure-v2.html`.\\n\\n**Split extraction small test (2026-11-05):** At Alex's request, the isolated `hivemind-no-preseed-evidence-review` worktree ran two real golden-v5 articles once through each split lane. An independent model reader found 7 of 19 helpful gold matters fully retained, two partial, two written then dropped, eight missed, and one retained gold not-kept matter. Three saved v108 draws on these articles retained 7, 9 and 12 of 19, but used 22 seeded questions while the new test used 8/10-question snapshots; these are not directly comparable. The experiment remains unaccepted; see `../hivemind-no-preseed-evidence-review/docs/research/2026-11-05-parallel-refinement/small-scored-test-20261105.md` and `reports/2026-11-05-split-small-test.html`.\\n\\nAs of November 5, 2026; decisions through D374. [Decisions](DECISIONS.md) holds what is decided now; the [design page](system-design.html) and the [module PRDs](prd/README.md) hold what the code must do; the [README](../README.md) holds startup, build and run instructions.\\n\\n## Future evidence scoring (D372)\\n\\nAlex decided future gold scoring should measure helpful versus not helpful evidence without requiring separate scores for core and supporting. Use frozen golden-v5 as-is: combine core and supporting as helpful, treat not-kept as unhelpful, and keep optional entries neutral. A counting report has not yet been implemented. Historical scores retain their original definitions. D373 removes the stop caused by a separate concern about three question-gold entries: keep the gold unchanged, continue scoring and disclose the concern; see `../hivemind-no-preseed-evidence-review/docs/research/2026-11-05-parallel-refinement/ruler-conflict-2026-11-05.zh.md`.\\n\\n## Latest decision (D369)\\n\\nAlex decided in D369 to capture core and supporting evidence without a strict boundary and in D370 to remove the 22 preset starting questions and separate earnings-report import. The replay entry now defaults to `poc-v118` (D374), refuses old seeded ledgers and baseline configurations, and continues to read existing non-seeded questions; earnings releases remain normal source items. This change has local contract tests but has not passed end-to-end product acceptance. The frozen historical rulers and results remain unchanged.\\n\\nThe small 2026-11-05 study used three archived NVDA articles and an 8/28 historical 68-question snapshot: without versus with an appended report, independent AI review found 14/27 versus 13/27 complete matters. This measured appended extraction context, not the distinct former coverage-start step; D370 removes both by Alex's decision. Full traces and limitations are in the separate `hivemind-no-preseed-evidence-review` worktree under `docs/research/2026-11-05-real-input-evidence/existing-library-results-2026-11-05.md`.\\n\\n\\n**One-day smoke completed (2026-11-05 UTC):** Alex requested a quick 1–2 day end-to-end test. One day, 2026-08-29, ran in `/Users/lchingen/hivemind-no-preseed-evidence-review/poc/data/v117-one-day-smoke-2026-11-05/`: config v117, an 8/28 historical library, 40 extraction calls, 93 evidence records written, four new questions, 54 judged and zero terminal failures. Two judgement attempts were refused and corrected. A Microsoft revenue forecast of $391.1bn was assigned to a rung whose upper bound excludes $391.1bn; the same article's actual quarterly revenue and next-quarter guidance were dropped with no home. Some source dates and bodies are not verified, and an independent 14-article sample review was incomplete due to truncated text. This is not semantic or production acceptance. Findings and scope: `docs/research/2026-11-05-real-input-evidence/one-day-v117-smoke-2026-11-05.zh.md` in that worktree. The clean source-text comparison and its condition-hidden review are complete; council discussion of next steps is ongoing.\\n\\n**D371, in progress:** Alex directed that present and forward-looking revenue and financial information should be tracked. Diagnose the same-day extraction and filing losses before designing a general change. No new financial tracking implementation has been accepted yet. The old frozen standard and gold are unchanged. The original prompt-only pilot failed design review. The user approved an exact prompt addition for an experiment; it is not a production implementation. Four paired real-article diagnostic calls per arm completed for the exact approved sentence: v74i versus experimental role-d371-pilot. Microsoft next-quarter guidance and NVIDIA FY2028 guidance still dropped in the treatment; a single draw is not acceptance or proof of causation. Details: docs/research/2026-11-05-real-input-evidence/d371-prompt-pilot-results.zh.md (isolated worktree). The requested full prompt audit and restructure were drafted experimentally; five real-article paired diagnostic requests per arm completed. Microsoft revenue guidance was missed in both arms, and the draft produced unsupported original dates, a quote refusal and suspect links. No production prompt change or acceptance; see restructure-pilot-results.zh.md in the isolated worktree.\\n\\n**Clean Step 1 coverage council (2026-11-06):** Codex and Claude Code independently reviewed the existing attempts and completed three discussion rounds. The proposed next research candidate moves the existing evidence-reading block ahead of the thesis-opening block while preserving the article, open-thesis state and paired output. It is a hypothesis, not an implemented or validated fix. A complete prompt/contract audit and independent review precede any controlled Luna comparison. Historical paragraph-based and source-first experiments, their noise and attribution problems, and the rejected overlap-based merge are recorded in [the council review](../clean-arch/STEP1-COVERAGE-COUNCIL.md). No new Luna experiment was run in the council.\\n\\n**Clean Step 1 coverage order result (2026-11-07):** The isolated 54-call clean comparison completed and all answers were reviewed blind. Moving the evidence-reading block recovered a known Kyber report and denial in one of three candidate answers against none in three controls, with attribution blur; it also produced unsupported gaming-to-AI links in two candidate answers and no controls. It is not adopted. A separate exact-quote example misattributes an executive's prediction in the standalone summary. [Results and replay](../clean-arch/STEP1-COVERAGE-ORDER-RESULTS.md) record all selected cases, uncertainties and source-fidelity work; no production ledger was written.\\n\\n**Clean Step 1 fidelity council (2026-11-07):** Codex and Claude Code completed five rounds on source attribution, conditions, dates and meaning. No tested fix or root cause is established. The agreed source-to-record review of 49 articles / 160 evidence items and the subsequent isolated field-order comparison are complete; the later 54-answer / 217-record repeated sample remains separate. Prior source-first, quote-first and follow-up-review experiments and their limits are recorded in [the fidelity council](../clean-arch/STEP1-FIDELITY-COUNCIL.md). No Luna experiment or production change was made in this council.\\n\\n**Clean Step 1 fidelity review (2026-11-07):** All 49 saved source packets and 160 original evidence items have received a source-and-record review; focused independent cross-checks cover the findings and selected controls. The [review and article replay](../clean-arch/STEP1-FIDELITY-REVIEW.md) distinguish source contamination and missing source material from model meaning, citation, date and link issues. The [isolated schema property-order diagnostic](../clean-arch/STEP1-CITATION-ORDER-RESULTS.md) completed all 66 calls and condition-blinded article reviews. Several omissions and semantic errors persisted; it did not establish a fix and is not adopted. It used saved articles and before-states without changing production.\\n\\n**Clean Step 1 source handoff council (2026-11-07):** The ongoing [council and offline checks](../clean-arch/STEP1-SOURCE-HANDOFF-COUNCIL.md) reconstructed 16 matching article-34 controls, all omitting a Kyber report and denial; the cause remains unknown. The 20-article saved source-role overlap review distinguished previously cited AI-generated summary lines and an unrelated recommendation from authored body. The clean runner does not send the saved source-role labels; the council chose to first compare original and previously selected source text on ten known articles. The isolated 60-call source-text comparison and condition-hidden review are complete; [results](../clean-arch/STEP1-SOURCE-TEXT-RESULTS.md) show specific contamination reductions alongside persistent omissions and changed meaning. It did not advance state or write production. The isolated six-article low-versus-medium source-fidelity diagnostic completed 36/36 calls and condition-hidden review. [Results](../clean-arch/STEP1-REASONING-FIDELITY-RESULTS.md) show partial improvements alongside persistent source-qualification and attribution concerns; no production setting is changed. The [prompt audit](../clean-arch/STEP1-FIDELITY-PROMPT-AUDIT.md) maps the observed failures to the full request and signed standard. The six-article isolated schema-description comparison completed 36/36 calls and condition-hidden review; the candidate did not preserve the repeated example qualification and is not adopted. [Results](../clean-arch/STEP1-SUMMARY-FIDELITY-RESULTS.md). A further six-article 36-call low-versus-medium comparison used corpus-cleaned sources outside the original 49-item clean replay and a fixed exploratory context; results were mixed, including unsupported links and incorrect attribution/date fields. [Results and replay](../clean-arch/STEP1-ADDITIONAL-SOURCES-RESULTS.md). The structured-claims candidate was not sent after review revealed scope and complexity concerns. Council review of the next action is ongoing. The date-text schema-description diagnostic completed 48/48 calls on eight known cases, with mixed results; the candidate is not adopted. A selected-run census found twelve literal \\\"null\\\" strings in date-text fields, but no production writer impact is established. [Results and replay](../clean-arch/STEP1-DATE-DESCRIPTION-RESULTS.md). A further preregistered eight-source date comparison completed 48/48 calls; the candidate lost a supported company-article statement date in all three draws on one source and is not adopted. [Results and replay](../clean-arch/STEP1-DATE-NEW-SOURCES-RESULTS.md). A bounded corpus census confirmed 163 source pages across three explicit generated-summary structures whose labels were removed while some summary text was retained; two NVIDIA cases were reproduced through the cleaner. [Source provenance investigation](../clean-arch/STEP1-SOURCE-PROVENANCE-CENSUS.md). A read-only source-lineage replay reproduced 363/363 cleaned pages with current inputs, preserved ambiguous original-line locations, and surfaced the generated-summary label loss for review. [Source investigation and lineage replay](../clean-arch/STEP1-SOURCE-PROVENANCE-CENSUS.md). An offline neighboring-context observation exposed only 144 or 149 of 163 known labels and introduced many other page lines; it is not adopted as a general source fix. [Observations and viewer](../clean-arch/STEP1-SOURCE-CONTEXT-OBSERVATIONS.md). A new [saved-quote integrity investigation](../clean-arch/STEP1-QUOTE-INTEGRITY-CENSUS.md) reconstructed 360 saved answers across eight overlapping cohorts, including 78 prepared-source calls. Five saved unverified passage instances were complete matches under the existing normalization; an in-memory candidate recovered their original slices, while ten others remained unverified. The normalized source-slice lookup is now installed only in the isolated clean Step 1 runner; saved-answer and entry-point checks are recorded there. Page provenance, Unicode completeness, production resource budgets and writer integration remain open. The existing writer stores only one quote, whereas 63 of 160 evidence items in the 49-article exploratory trace have multiple passages. A [source-first 49-article coverage review](../clean-arch/STEP1-COVERAGE-CENSUS.md) separates material missing from the model input from source-visible omissions in the saved answers, with uncertain matter boundaries labeled. (Superseded: the next investigation then was why supplied material is missed; the current next task is under \\\"One next task\\\".) The canonical prompt and production configuration remain unchanged. Adding fallible role annotations remains a separate untested candidate. Council streams and handoffs are in `poc/data/clean-step1-ongoing-council-2026-11-07/`.\\n\\n## What runs\\n\\n- **Pipeline (replay default `poc/config/poc-v118.json`, D370, D374).** Every item reads the relevant open questions from the library at the start of its day, then extraction v74i on `gpt-6-luna` proposes evidence and questions; Jev matching with the collision judge matches them; code writes the records; judging-v7 judges changes once a day; pull mode closes due questions. There is no separate seed or coverage-start report import, and reports as source items remain eligible. This default has not completed end-to-end acceptance. The [pipeline guide](poc/pipeline-plan.md) maps stages to code.\\n- **Measured:** one company (NVDA) over one 14-day window (2026-07-01 to 07-14), the judgement scored at the window end on the frozen ruler (AGENTS §7.1). Three draws of `poc-v116` against three of `poc-v108` run in the same hours: 53 against 45 agreements of 57; operating margin and capex agree in 3 of 3 draws, never judged without the coverage-start reading ([acceptance](research/2026-11-04-filing-end-to-end/acceptance-design.md)).\\n- **Served data:** the service, the MCP server and the standalone page serve the sealed three-month ledger `served-2026-10-28-v34-nvda-3m-through-0828` (68 theses, 34 groups; D358), built by the earlier `poc-v34` pipeline, not by the replay default. HTTP `/library`, MCP `thesis_library` and the standalone page share the dated bundle writer.\\n- **Idea API:** `poc-v118-idea` (D290, D335, D374): two discovery calls and one adoption and weighting assessment; only adopted theses with positive weights appear, and nonempty plans total 100%. The [Idea contract](poc/idea-card.md) owns its fields and the limits of its scores.\\n- **Interface:** the Thesis Library and Explore Ideas workspaces, with the confidence Trigger and an Action preview (no wallet connection or order execution). The [UI specification](poc/thesis-ui.md) and the [integration guide](../poc/ui/README.md) own its behaviour.\\n- **Repository:** `main` holds the product, the frozen ruler and the research records; run databases, logs and model archives stay on disk (D353), located by the [data manifest](research/2026-10-25-english/data-manifest.md). Worktrees: `/Users/lchingen/hivemind` is the main checkout, where slice branches are cut from `main`; `/Users/lchingen/hivemind-extraction-quality-2026-10-28` (the extraction branch, merged on 2026-11-03) keeps in its ignored folders the stored end-to-end runs of `poc-v91` to `poc-v95` that later comparisons read (D359); `/Users/lchingen/hivemind-run-v109-2026-11-04` is the finished judging-v8 run's worktree. Older branches stay in Git without worktrees (D359); none is merged work in progress. The clean source-text comparison and its condition-hidden review are complete; council discussion of next steps is ongoing.\\n\\n## Open defects\\n\\n1. **Competitor and customer news is filed under the company's revenue questions** instead of the share, capital-spending or custom-chip question it informs (D355; filing is otherwise about 85% right). Share facts are often not written at all, an extraction recall miss. The total-revenue question holds about a quarter of all links (D354).\\n2. **One bet opened twice** about one encounter in five: the collision judge splits a seed question from an identical candidate on a fine detail (D354).\\n3. **A question the standard rules out** (the lidar legislation) was proposed by the extraction and opened in one draw of three (D354).\\n4. **A thesis opened from an article gets no dependency of its own**: the default Jev matching asks for none (`views/jev_matching.py`), although D51 has the matching call choose them; themes still reach every company thesis through the theme block (D191, D195). Found in the 2026-11-05 consolidation; building it is decided (D368).\\n5. **Historical coverage-start reading, retired by D370** (D364–D366): the capital-spending line is missed in about one read in six (the question is then left as it was); a labelled guidance figure is written with the fact tier; later reports reach the questions only through the daily stream; `scripts/preflight.py` does not replay the reading's check.\\n6. **Measured on one company and one 14-day window**, the judgement scored at the window end only; no version of the current pipeline has completed a longer window (a 60-day run of `poc-v108` was stopped at Alex's word after 2026-07-15, [log row 8](research/2026-11-04-argument-record/log.md)). The China-share question (v17) swings between draws (0 of 3 in the acceptance, 2 of 3 in its control, 1 of 3 in the frozen draws): two readers found the starting figures did not cause the acceptance's drop, and the byte-identical extraction request kept a \\\"share fell to zero\\\" sentence in two candidate draws and dropped it in two control draws. One acceptance draw judged nothing on v16; its cause is not established.\\n7. **What a judgement reads grows with the window** (D358). Argument records (D201) were measured as the remedy on 2026-11-04 and not built: judging-v8 agreed 12 of 17 against 15 of 17, judging-v9's card added little at about half again the judging cost; their code was removed at Alex's request ([log rows 4–11](research/2026-11-04-argument-record/log.md)).\\n8. **Seen once, not traced.** A judgement named a shown theme as a dependency and the check refused it twice, stopping a draw for a day (2026-11-02, D266). The sealed run's review recorded that a succession's opening evidence is not linked to the new question (D358), not yet checked against today's code.\\n9. **Earlier defects, unchanged.** Matching (build log row 49): another document's copy of a figure can be treated as new evidence; one matter can occupy several groups; same-answer candidate references caused seven chain or duplication decisions of the generative matcher; empty `original_who` values can count as the same party; different names for one population cause two of nine Jev merge misses. Nine 2026 aggregate-spending theses under `ai-capex` each have a different population; whether to combine them is a product choice. Extraction's instructions remain narrower than the PRD's important-question rule and omit the personal-memo exception, and extraction can change a quantity's meaning before matching (a guarantee amount against financing provided). Classification keeps its [recorded simulation defects](research/2026-10-25-english/classification-existing-defects.txt). The corpus audit recorded 97 official notices with 56 body and file-name collisions, to re-fetch before relying on a rebuilt corpus. An older intermittent search-test failure is untraced. Fresh Idea allocations vary while saved weights do not; the confidence chart applies the current plan to past states and is not a calibrated probability; broad analyst-prose quality and fresh Idea stability remain unaccepted (the [Idea contract](poc/idea-card.md) lists its limits); generative matching dependencies await `matching-v4`. The readers' doubts about the frozen standard, listed in the [extraction branch's state page](research/2026-11-01-e2e-loop/current-state-extraction-branch-2026-11-03.md), remain for Alex.\\n\\nUpstream supply and the human review pool's output remain deferred.\\n\\n## One next task\\n\\n**Clean Step 4 (D396): design version 4 is written; it is not READY and waits for two choices of Alex's**\\n([design](../clean-arch/step4-2026-11-10/DESIGN.md); round log §69).\\n\\n- **Design status:** three review rounds (`gg`, `gl`, `gm`) each found serious points; version 4 answers the last and has not been\\n  reviewed. Its core contract depends on C1 and C2 below.\\n- **What the review of 2026-11-10 found** (council `gh`–`gm`, all on stored data, no paid send):\\n  - Step 4 is the right next step, and inside it the first thing to build and test is the **ladder step alone**: the call that turns a\\n    thesis Step 1 opened into one judged question with its answer ladder and due day. The frozen judge follows only when the ladder\\n    step meets its lines.\\n  - Production's own ladder sentences are not stable: one request, the same in three draws, gave a bullish end at the low amount\\n    twice and at the high amount once, with three different middle bands; the code checks pass all three\\n    (`clean-arch/step4-2026-11-10/census/production_ladders.txt`).\\n  - Of the 34 theses the unseeded draws opened, two blind readers find 12 to 16 that ask more than one thing, 7 to 9 of 18 number\\n    questions with no reference figure in the opening article, and 4 that state a calendar due day.\\n- **The next task:** put to Alex\\n  1. **C1:** a topic that asks more than one thing gets one judged question with the rest shown as not judged (recommended as the\\n     first version), or is split as D38 says, or is not judged;\\n  2. **C2:** whether the ladder step carries D186 (ranges against guidance, the favourable end registered; recommended), its\\n     direction half only, or neither;\\n  then revise the design for his answers, review it with a fresh reviewer each round until one finds nothing serious, audit the\\n  whole ladder request, and ask his word to build the ladder step and run Stage A (the ladder step against a control that quotes v74i, on the 34 stored theses and the 10 fresh ones).\\n- **Open defects recorded by this review:** the frozen judge retried 10, 16 and 18 judgements in the seeded clean draws, 38 of 51\\n  reasons a theme cited as a dependency (PRD 11, E4; frozen, a finding for Alex); the same matter takes different shapes between\\n  draws (Kyber due end-2027 in one draw and end-2028 in another).\\n- **The unseeded measurement (D395):** graded subset 4.0 against 6.33 seeded. Every miss is a question not opened in the ruler's shape.\\n  Judged answers 16 of 16, on the ruler's wording and ladder; the system's own questions have never met a judge.\\n- **Stage 2 of D392:** clean 18, 18, 17 against v108 17, 15, 16, inconclusive on q12.\\n- **Known gap (D394):** capital spending (q12).\\n\\nNo long job is running.\\n## 5. Step 2: find and compare related evidence\\n\\n### Why this is separate\\n\\nAn open thesis may accumulate many evidence records. Step 1 needs to understand the article and the open research; it does not need to read every prior statement to do that. Step 2 uses each proposed `{thesis, evidence}` association to find the history worth comparing.\\n\\n### Find candidate evidence\\n\\nThe proposed design places semantic search over the evidence library. It uses the thesis and incoming evidence to find top-N related evidence across the current entity, including evidence linked to other theses. The thesis is search context, not a restriction to evidence already linked to that thesis. This also applies when the proposed thesis is new. For example, “raised its revenue outlook” and “expects higher sales” can be related despite different wording. Alex chose this entity-wide scope on 2026-11-06.\\n\\nSearch returns **candidates**, not a final decision. Alex discussed a starting point of top 10; the implementation and quality requirements need to be measured.\\n\\nA match outside the returned set will not be considered by the comparison. Search quality therefore matters independently from the model's ability to compare the records it receives.\\n\\n### Compare with Jev\\n\\n**2026-11-08 (candidate, [round log](step1-unfiled-2026-11-08/LOG.md) §§24, 31–35):**\\n- Comparison reads the full passages; the 600-character cut is removed.\\n- An unlinked record also searches by its own text.\\n- `figures` never enter a search or comparison text.\\n- Jev is asked the clean path's own piece question, aligned with line 2's test: a repeat reports the stored piece's main statement, and\\n  an official's denial of a report is a revision.\\n- When a thesis opens, every stored unlinked group from earlier articles is judged against it in batches of ten (a yes/no question; the\\n  company's overall results inform only a revenue or earnings thesis). Each judged pair is recorded once.\\n- On c6's records: search 97.9%, wrong merges 1.9% (2 of 104), both lines met; line 3 not re-measured.\\n\\nJev compares the new evidence with the returned evidence. The intended outcomes are:\\n\\n| Outcome | Meaning | Example |\\n|---|---|---|\\n| Repeat | The new material presents the same statement again. | Another article reports the same company forecast. |\\n| Revision | A later account changes the same statement. | The company revises its forecast from 12% to 25%. |\\n| New evidence | It is not identified as a repeat or revision of the evidence compared. | A different analyst offers a separate forecast. |\\n\\nThe words, amount, speaker, source and time can matter to the comparison. A later statement about the same subject is not necessarily a revision. A matching amount alone does not prove that two statements are the same.\\n\\nThe result “new evidence” is the outcome of the comparison performed; it is not proof that no matching evidence exists elsewhere in the library. When the incoming evidence is judged a repeat of several candidates, it joins only the group Jev judges it most like: the highest same-statement probability, with ties going to the earliest group (Alex, 2026-11-08). A comparison that fails is not saved and is reported.\\n\\n**Repeat handoff:** when Jev identifies a repeat, the comparison must retain the identity of the existing evidence record it was compared against. Step 3 uses that identity to place the incoming record in the existing record's group, adding its source and any missing thesis link. The typed Jev response need not generate the record ID: the caller can associate the choice with the candidate it supplied. The rule for several matching candidates is stated above.\\n\\n**Step 2 acceptance (Alex, 2026-11-08).** Three lines apply:\\n1. For incoming evidence whose earlier version is in the library, search returns it at least 90% of the time.\\n2. At most 2% of merges are clearly wrong.\\n3. Grouped dossiers keep no fewer details added by later reports than no merging does.\\n\\nThe first measurement against these lines is in the [Step 2 log](step2-validation-2026-11-07/LOG.md) §12; the isolated modules are `step2/compare.py` and `step3/library.py`.\\n\\nThe diagram's intended sequence is: use `{thesis, incoming evidence}` to search the evidence library; pass the returned candidates and incoming evidence to Jev; pass the comparison result and the proposed association to Step 3. For a new thesis, search the same entity-wide evidence library. A concrete working draft of the Jev comparison request appears in [section 13](#13-step-2-prompt-jev-working-draft).\\n\\n## 6. Step 3: save evidence and links\\n\\nStep 3 takes the proposals from Step 1 and the comparison outcomes from Step 2 and writes the resulting research information.\\n\\n| Result | What is saved |\\n|---|---|\\n| New thesis with supporting evidence | The new thesis and its evidence link; save new evidence or reuse a matching record according to Step 2. |\\n| New evidence for an existing thesis | The evidence and its link to the thesis. |\\n| Repeat | Place the incoming record in the existing evidence record's group: add its source and any missing link to the relevant thesis, and keep the incoming record's own text and fields inside the group. Do not rewrite the existing record, and do not create a separate evidence record for the same statement. |\\n| Revision | The new evidence and its source, linked to the earlier statement as a revision. |\\n\\nA revision does not erase the earlier statement. On 2026-11-06, Alex chose to keep one evidence record for a repeat and add the new source and any missing thesis link. On 2026-11-08 the Step 2 validation showed that keeping only the earlier text discards details a later report adds, such as a guidance condition; Alex then chose to keep each repeat's own text and source inside the stored record's group, without rewriting the original (\\\"A 继续；跑council loop 开始做\\\"; [Step 2 log](step2-validation-2026-11-07/LOG.md) §7). How a judgement reads a group is being tested. Multiple articles reporting the same statement do not automatically establish independent original sources. The current production writer stores separate repeat records, so this is a change for the clean path and needs implementation and verification; the existing historical records remain available. Step 3 ends when the chosen thesis, evidence and relationships are saved. How they are physically stored and written is a separate implementation decision.\\n\\n\\\"\\\"\\\"Isolated Step 2 for the clean path (PRD §5): search the entity's stored evidence for each {thesis, incoming evidence} association,\\nask Jev how the incoming evidence relates to each candidate, and turn the answers into the outcome Step 3 writes.\\n\\nSearch: one query per association (the thesis question, then the incoming summary and passages) against each group's original record\\n(summary, passages, party, statement date, period), cosine similarity of embeddings, top 10; a record with no association, or one that\\nlists the company's figures (a condition), also gets one entity-wide query of its own text (STEP1-CONDITIONS-DESIGN.md §10.1); the union\\nof the results is compared. The figures never enter a search or comparison text, so a wrongly paired figure cannot change Step 2 (§14);\\nthe comparison reads the full passages (§15). Comparison: Jev's piece question with the production criteria (views/jev_matching), the incoming piece as state, one question\\nper candidate. Outcome: any same_statement makes the record a repeat of the candidate with the highest same_statement probability, ties\\ngoing to the earliest group (Alex, 2026-11-08: only the group it is most like); a supersedes answer on another candidate becomes a\\nrevision link; with no same_statement, supersedes answers make it a revision of those groups; otherwise it is new.\\n\\n`forward` runs articles in order against the library as it stood after the previous article: records of one article never see each\\nother. A failed comparison is refused by the library, reported, and the run continues.\\\"\\\"\\\"\\nimport concurrent.futures\\nimport math\\nimport sys\\nfrom pathlib import Path\\n\\nROOT = Path(__file__).resolve().parents[2]\\nsys.path.insert(0, str(ROOT / 'src'))\\nfrom hivemind.views import jev_matching  # noqa: E402\\n\\nTOP = 10\\n\\n\\ndef stated(record):\\n    return record['statement_date'] or record.get('statement_date_text') or 'unknown'\\n\\n\\ndef doc_text(record):\\n    return '\\\\n'.join([record['summary'], ' '.join(record['passages']), f\\\"party: {record['original_party'] or 'unknown'}\\\",\\n                      f\\\"stated: {stated(record)}\\\", f\\\"period: {record['evidence_period'] or 'unknown'}\\\"])\\n\\n\\ndef query_text(record, thesis_question):\\n    return f\\\"thesis: {thesis_question}\\\\n{record['summary']}\\\\n{' '.join(record['passages'])}\\\"\\n\\n\\ndef piece_text(record, label):\\n    return (f\\\"{label} [{record['tier']}; {record['reporting_speaker']}; original source {record['original_party']}, stated \\\"\\n            f\\\"{stated(record)}] {record['summary']} | quote: {' '.join(record['passages'])}\\\")\\n\\n\\ndef query_vectors(vectors, record, thesis_questions):\\n    \\\"\\\"\\\"The search queries of one record, in order: one per thesis association, then its own text when it has no association or lists\\n    the company's figures.\\\"\\\"\\\"\\n    queries = [vectors[query_text(record, thesis_questions[t])] for t in record['thesis_ids']]\\n    if not record['thesis_ids'] or record.get('figures'):\\n        queries.append(vectors[doc_text(record)])\\n    return queries\\n\\n\\n# Jev's piece criteria aligned with the Step 2 merge line's own test (PRD §5 line 2; AGENTS §7.1, one ruler): a repeat is a later report\\n# of the stored piece's main statement. Production's wording (views/jev_matching.PIECES) judged \\\"the same evidence\\\", so a later report of\\n# only a secondary statement inside a stored record (an official's denial carried in the report it denies) was merged as a repeat.\\nPIECES = {'same_statement': \\\"the INCOMING PIECE reports the STORED PIECE's main statement: a retelling, another outlet carrying it, the \\\"\\n                            \\\"same number in text or a table, or the same speaker repeating it; wording, precision and extra detail may \\\"\\n                            \\\"differ. If the stored piece carries several statements and the incoming piece reports only a secondary one, \\\"\\n                            \\\"this is not it\\\",\\n          'supersedes': \\\"a later version of the stored piece's main statement, changed: the same speaker revises that guidance, \\\"\\n                        \\\"forecast or event-progress statement, an official confirms or denies that reported claim, or the original \\\"\\n                        \\\"source revises it; another statement on the same topic is not this\\\",\\n          'different': \\\"a different fact, figure or matter, a figure for another period or quantity, or only a secondary statement of \\\"\\n                       \\\"the stored piece, even if on the same topic\\\"}\\n\\n\\ndef piece_question(text):\\n    return {'type': 'choice', 'criteria': PIECES,\\n            'instructions': 'How does the INCOMING PIECE relate to the STORED PIECE below? Use only the supplied text. STORED PIECE:\\\\n' + text}\\n\\n\\nINFORMS = {'true': \\\"the STORED PIECE bears on the THESIS's own matter (the parties, products, policy or quantity the THESIS names) and \\\"\\n                   \\\"makes its answer more or less likely, as evidence filed under it would\\\",\\n           'false': \\\"the STORED PIECE concerns another matter, or is a company-wide result or event that does not speak to the THESIS's \\\"\\n                    \\\"own matter, or would not change its answer\\\"}\\n\\n\\ndef informs_question(text):\\n    return {'type': 'noul', 'criteria': INFORMS,\\n            'instructions': 'Does the STORED PIECE below inform the THESIS stated above? Use only the supplied text; a shared company, '\\n                            'product family or word is not enough, and the company\\\\'s overall results, guidance and estimates inform a '\\n                            'thesis about its revenue or earnings path, not one about a competitor, a supplier or a policy unless they '\\n                            'speak to it. STORED PIECE:\\\\n' + text}\\n\\n\\ndef later_link_judge(library, thesis_question, ask):\\n    \\\"\\\"\\\"The judge `Library.link_later` calls: one Jev request per batch, the thesis as state, one yes/no question per stored group.\\\"\\\"\\\"\\n    def judge(group_ids):\\n        questions = {f'q{i}': informs_question(piece_text(library.groups[g]['original'], 'STORED PIECE')) for i, g in enumerate(group_ids)}\\n        raw = ask(f'THESIS: {thesis_question}', questions)\\n        return {g: raw[f'q{i}']['noul'] >= jev_matching.THRESHOLD for i, g in enumerate(group_ids)}\\n    return judge\\n\\n\\ndef cosine(a, b):\\n    return sum(x * y for x, y in zip(a, b)) / (math.sqrt(sum(x * x for x in a)) * math.sqrt(sum(y * y for y in b)) or 1)\\n\\n\\ndef search(library, vectors, record, thesis_questions):\\n    \\\"\\\"\\\"Candidate group ids: each query's top 10 by cosine against the groups' original records, merged in rank order.\\\"\\\"\\\"\\n    candidates = []\\n    for query in query_vectors(vectors, record, thesis_questions):\\n        ranked = sorted(library.order, key=lambda g: -cosine(query, vectors[doc_text(library.groups[g]['original'])]))[:TOP]\\n        candidates += [g for g in ranked if g not in candidates]\\n    return candidates\\n\\n\\ndef outcome(answers, order):\\n    \\\"\\\"\\\"answers: {group id: {'choice', 'probabilities'}}; order: group ids in creation order.\\\"\\\"\\\"\\n    same = [g for g, a in answers.items() if a['choice'] == 'same_statement']\\n    later = [g for g, a in answers.items() if a['choice'] == 'supersedes']\\n    if same:\\n        best = max(same, key=lambda g: (answers[g]['probabilities']['same_statement'], -order.index(g)))\\n        return {'kind': 'repeat', 'repeat_of': [best], 'revises': later}\\n    if later:\\n        return {'kind': 'revision', 'revises': later}\\n    return {'kind': 'new'}\\n\\n\\ndef forward(articles, library, vectors, thesis_questions, ask, workers=8, opened=None):\\n    \\\"\\\"\\\"articles: lists of Step 3 records in article order. ask(state, questions) returns Jev's answers by question id, or raises.\\n    opened: per article, the thesis ids it opened; after the article's records are written, each is linked later to the stored groups\\n    that arrived unlinked from earlier articles (`Library.link_later`). A thesis written to with pairs still pending is judged again,\\n    against its opening boundary. Returns one decision per record.\\\"\\\"\\\"\\n    decisions = []\\n    for index, records in enumerate(articles):\\n        def decide(record):\\n            candidates = search(library, vectors, record, thesis_questions)\\n            if not candidates:\\n                return record, candidates, {}, {'kind': 'new'}\\n            questions = {f'q{i}': piece_question(piece_text(library.groups[g]['original'], 'STORED PIECE'))\\n                         for i, g in enumerate(candidates)}\\n            incoming = piece_text(record, 'INCOMING PIECE')\\n            try:\\n                raw = ask(incoming, questions)\\n            except Exception as first:   # retried once; a second failure is reported, never silently saved as new\\n                try:\\n                    raw = ask(incoming, questions)\\n                except Exception as error:\\n                    return record, candidates, {}, {'kind': 'failed', 'reason': f'{type(first).__name__}: {first}; retry: {type(error).__name__}: {error}'}\\n            answers = {g: {'choice': raw[f'q{i}']['choice'], 'probabilities': raw[f'q{i}']['probabilities']} for i, g in enumerate(candidates)}\\n            return record, candidates, answers, outcome(answers, library.order)\\n        with concurrent.futures.ThreadPoolExecutor(max_workers=workers) as pool:\\n            results = list(pool.map(decide, records))\\n        for record, candidates, answers, result in results:\\n            entry = {'id': record['id'], 'candidates': candidates, 'answers': answers, 'outcome': result}\\n            try:\\n                entry['group'] = library.apply(record, result)\\n            except Exception as error:\\n                entry['refused'] = f'{type(error).__name__}: {error}'\\n            decisions.append(entry)\\n        article = records[0]['article'] if records else None\\n        if article is None:\\n            continue\\n        written = {t for r in records for t in r['thesis_ids']}\\n        retry = [t for t in written if t in library.pending and t not in (opened[index] if opened else [])]\\n        for thesis_id in list(opened[index] if opened else []) + retry:   # opened here, or written to with pairs still pending\\n            result = library.link_later(thesis_id, later_link_judge(library, thesis_questions[thesis_id], ask), article)\\n            library.later_log.append({'thesis': thesis_id, 'article': article, **result})\\n    return decisions\\n\\\"\\\"\\\"Isolated Step 3 evidence library for the clean path (PRD §6): an in-memory logical store and its dossier text, not the live writer.\\n\\nA group is one stored statement. Its original record keeps its id and fields unchanged and gives the group its id. A later record that\\nStep 2 judged a repeat joins the group as a member and keeps its own id, text, fields and source article. Thesis links belong to the\\ngroup and remember the record that brought each one. A revision is its own group, linked to every group it revises; a repeat that also\\nrevises another group adds that link to its own group, naming the member that established it.\\n\\nThe writer refuses rather than guesses: a failed comparison, several repeat targets, an unknown group, or a replayed record whose\\nplacement differs from the first time raise `Refused` and write nothing. Physical storage and crash recovery are not provided here.\\n\\nLater linking (Alex, 2026-11-08: a material statement no thesis takes is kept and linked when a related thesis opens; design\\nSTEP1-CONDITIONS-DESIGN.md §§11.1, 17): when a thesis opens, every group whose original arrived with no link, from an earlier article,\\nis judged against it in batches. Each judged (thesis, group) pair is recorded once in `judged`; a batch that fails twice stays pending,\\nis reported, and is judged again on the next write to that thesis, against the same opening boundary (`opened_at`).\\\"\\\"\\\"\\nimport copy\\n\\nRECORD_FIELDS = ('id', 'article', 'publisher', 'publication_date', 'summary', 'passages', 'original_party', 'reporting_speaker', 'tier',\\n                 'statement_date', 'evidence_period', 'thesis_ids')\\n\\n\\nclass Refused(Exception):\\n    \\\"\\\"\\\"A Step 2 outcome the library will not write; nothing was changed.\\\"\\\"\\\"\\n\\n\\nclass Library:\\n    def __init__(self):\\n        self.groups = {}       # group id → {'original': record, 'members': [record], 'links': {thesis id: record id}, 'revises': [{'group', 'by'}]}\\n        self.placement = {}    # record id → group id\\n        self.order = []        # group ids in the order they were created\\n        self.judged = {}       # (thesis id, group id) → True | False, the later-linking ledger\\n        self.later_log = []    # one entry per later-linking call: thesis, article, linked, pending, judged\\n        self.opened_at = {}    # thesis id → the article that opened it: the boundary of its later linking\\n        self.pending = {}      # thesis id → group ids whose judgement failed twice and waits for the next write to the thesis\\n\\n    def apply(self, record, outcome):\\n        \\\"\\\"\\\"Write one record with its Step 2 outcome: {'kind': 'new' | 'repeat' | 'revision' | 'failed', 'repeat_of': [group ids],\\n        'revises': [group ids], 'reason': text}. Returns the id of the group that holds the record.\\\"\\\"\\\"\\n        missing = [f for f in RECORD_FIELDS if f not in record]\\n        if missing:\\n            raise Refused(f'record lacks {missing}')\\n        kind, repeat_of, revises = outcome['kind'], list(outcome.get('repeat_of') or []), list(outcome.get('revises') or [])\\n        if kind == 'failed':\\n            raise Refused(f\\\"comparison failed for {record['id']}: {outcome.get('reason', 'no reason given')}\\\")\\n        if kind not in ('new', 'repeat', 'revision'):\\n            raise Refused(f'unknown outcome {kind!r}')\\n        if (kind == 'repeat') != bool(repeat_of) or len(repeat_of) > 1:\\n            raise Refused(f\\\"a repeat names exactly one group; got {repeat_of} for outcome {kind}\\\")\\n        if kind == 'revision' and not revises:\\n            raise Refused('a revision names the group it revises')\\n        for group_id in repeat_of + revises:\\n            if group_id not in self.groups:\\n                raise Refused(f'unknown group {group_id}')\\n        target = repeat_of[0] if repeat_of else record['id']\\n        if record['id'] in self.placement:\\n            if self.placement[record['id']] != target:\\n                raise Refused(f\\\"{record['id']} was placed in {self.placement[record['id']]}, not {target}\\\")\\n            group = self.groups[target]\\n            stored = next(r for r in [group['original']] + group['members'] if r['id'] == record['id'])\\n            if {k: v for k, v in stored.items() if k != 'thesis_ids'} != {k: v for k, v in record.items() if k != 'thesis_ids'}:\\n                raise Refused(f\\\"{record['id']} names a stored record with different content; a changed record needs a new id\\\")\\n            self._link(group, record)\\n            return target\\n        if kind == 'repeat':\\n            group = self.groups[target]\\n            group['members'].append(copy.deepcopy(record))\\n        else:\\n            group = {'original': copy.deepcopy(record), 'members': [], 'links': {}, 'revises': []}\\n            self.groups[target] = group\\n            self.order.append(target)\\n        self.placement[record['id']] = target\\n        self._link(group, record)\\n        for revised in revises:\\n            if revised != target and not any(r['group'] == revised for r in group['revises']):\\n                group['revises'].append({'group': revised, 'by': record['id']})\\n        return target\\n\\n    def link_later(self, thesis_id, judge, before_article, batch=10):\\n        \\\"\\\"\\\"Judge every group whose original arrived unlinked from an article before `before_article` against a newly opened thesis.\\n        judge(group ids) returns {group id: True | False} or raises. Returns {'linked': [...], 'pending': [...], 'judged': n}.\\\"\\\"\\\"\\n        self.opened_at.setdefault(thesis_id, before_article)\\n        before_article = self.opened_at[thesis_id]\\n        todo = [g for g in self.order if not self.groups[g]['original']['thesis_ids']\\n                and self.groups[g]['original']['article'] < before_article and (thesis_id, g) not in self.judged]\\n        linked, pending = [], []\\n        for start in range(0, len(todo), batch):\\n            ids = todo[start:start + batch]\\n            answers = None\\n            for _attempt in range(2):\\n                try:\\n                    answers = judge(ids)\\n                    break\\n                except Exception:   # tried twice, then reported as pending, never saved as a judgement\\n                    answers = None\\n            if answers is None:\\n                pending += ids\\n                continue\\n            for group_id in ids:\\n                self.judged[(thesis_id, group_id)] = bool(answers[group_id])\\n                if answers[group_id]:\\n                    self.groups[group_id]['links'].setdefault(thesis_id, self.groups[group_id]['original']['id'])\\n                    linked.append(group_id)\\n        if pending:\\n            self.pending[thesis_id] = pending\\n        else:\\n            self.pending.pop(thesis_id, None)\\n        return {'linked': linked, 'pending': pending, 'judged': len(todo) - len(pending)}\\n\\n    @staticmethod\\n    def _link(group, record):\\n        for thesis_id in record['thesis_ids']:\\n            group['links'].setdefault(thesis_id, record['id'])\\n\\n    @staticmethod\\n    def articles(group):\\n        \\\"\\\"\\\"Distinct source articles of a group, oldest first; two records from one article count once.\\\"\\\"\\\"\\n        seen = []\\n        for record in [group['original']] + group['members']:\\n            if record['article'] not in seen:\\n                seen.append(record['article'])\\n        return seen\\n\\n    def dossier(self, thesis_id):\\n        \\\"\\\"\\\"Group ids linked to a thesis, in creation order.\\\"\\\"\\\"\\n        return [g for g in self.order if thesis_id in self.groups[g]['links']]\\n\\n\\ndef labelled_passages(record):\\n    \\\"\\\"\\\"Each passage as a reader sees it: the source text Step 1 found, labelled 'Quote', or, when Step 1 did not find it (verified\\n    value None), the model's text labelled 'Unverified quote'. The model's own text stays in the record's `passages`. A record stored\\n    before verification was carried shows its passages as 'Quote'.\\\"\\\"\\\"\\n    verified = record.get('verified_passages') or record['passages']\\n    return [('Quote', found) if found is not None else ('Unverified quote', passage) for passage, found in zip(record['passages'], verified)]\\n\\n\\ndef record_text(record, label):\\n    attribution = record['original_party'] or 'unknown party'\\n    if record['reporting_speaker'] and record['reporting_speaker'] != record['original_party']:\\n        attribution += f\\\", reported by {record['reporting_speaker']}\\\"\\n    head = (f\\\"[{label}] {record['publication_date']} · {record['publisher'] or 'unknown publisher'} · {attribution} · tier {record['tier']}\\\"\\n            f\\\" · stated {record['statement_date'] or 'unknown'} · period {record['evidence_period'] or 'unknown'}\\\")\\n    quotes = '\\\\n'.join(f'  {label_of}: \\\"{p}\\\"' for label_of, p in labelled_passages(record))\\n    return f\\\"{head}\\\\n  {record['summary']}\\\\n{quotes}\\\"\\n\\n\\ndef group_text(library, group_id, label, labels, member_text=True, notes=()):\\n    \\\"\\\"\\\"A group as a reader sees it: the original record, then each later report of the same statement in arrival order, with its own\\n    text when `member_text` is set and as a source line otherwise. Distinct articles are counted; repeats are not called confirmation.\\\"\\\"\\\"\\n    group = library.groups[group_id]\\n    lines = [record_text(group['original'], label)]\\n    if group['members']:\\n        articles = library.articles(group)\\n        publishers = {r['publisher'] for r in [group['original']] + group['members']}\\n        lines.append(f'  Later reports of the same statement: {len(group[\\\"members\\\"])} records from {len(articles) - 1} further articles '\\n                     f'({len(publishers)} publishers in all). Articles repeating a statement do not by themselves confirm it independently.')\\n        for member in group['members']:\\n            if member_text:\\n                party = '' if member['original_party'] == group['original']['original_party'] else f\\\" · {member['original_party']}\\\"\\n                quotes = ' '.join(f'\\\"{p}\\\"' if kind == 'Quote' else f'\\\"{p}\\\" (unverified)' for kind, p in labelled_passages(member))\\n                lines.append(f\\\"    - {member['publication_date']} · {member['publisher']}{party}: {member['summary']}\\\\n      Quote: {quotes}\\\")\\n            else:\\n                lines.append(f\\\"    - {member['publication_date']} · {member['publisher']}\\\")\\n    for revised in group['revises']:\\n        lines.append(f\\\"  Revises [{labels[revised['group']]}].\\\" if revised['group'] in labels else '  Revises an entry outside this dossier.')\\n    lines += [f'  {note}' for note in notes]\\n    return '\\\\n'.join(lines)\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n./reports/step2-jev-decision-council-2026-11-09/codex-second.stderr:202:reports/step2-jev-decision-council-2026-11-09/codex-independent.jsonl:22:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_10\",\"type\":\"command_execution\",\"command\":\"/opt/homebrew/bin/zsh -lc \\\"cat clean-arch/step2/compare.py; sed -n '1,150p' docs/CURRENT_STATE.md\\\"\",\"aggregated_output\":\"\\\"\\\"\\\"Isolated Step 2 for the clean path (PRD §5): search the entity's stored evidence for each {thesis, incoming evidence} association,\\nask Jev how the incoming evidence relates to each candidate, and turn the answers into the outcome Step 3 writes.\\n\\nSearch: one query per association (the thesis question, then the incoming summary and passages) against each group's original record\\n(summary, passages, party, statement date, period), cosine similarity of embeddings, top 10; a record with no association, or one that\\nlists the company's figures (a condition), also gets one entity-wide query of its own text (STEP1-CONDITIONS-DESIGN.md §10.1); the union\\nof the results is compared. The figures never enter a search or comparison text, so a wrongly paired figure cannot change Step 2 (§14);\\nthe comparison reads the full passages (§15). Comparison: Jev's piece question with the production criteria (views/jev_matching), the incoming piece as state, one question\\nper candidate. Outcome: any same_statement makes the record a repeat of the candidate with the highest same_statement probability, ties\\ngoing to the earliest group (Alex, 2026-11-08: only the group it is most like); a supersedes answer on another candidate becomes a\\nrevision link; with no same_statement, supersedes answers make it a revision of those groups; otherwise it is new.\\n\\n`forward` runs articles in order against the library as it stood after the previous article: records of one article never see each\\nother. A failed comparison is refused by the library, reported, and the run continues.\\\"\\\"\\\"\\nimport concurrent.futures\\nimport math\\nimport sys\\nfrom pathlib import Path\\n\\nROOT = Path(__file__).resolve().parents[2]\\nsys.path.insert(0, str(ROOT / 'src'))\\nfrom hivemind.views import jev_matching  # noqa: E402\\n\\nTOP = 10\\n\\n\\ndef stated(record):\\n    return record['statement_date'] or record.get('statement_date_text') or 'unknown'\\n\\n\\ndef doc_text(record):\\n    return '\\\\n'.join([record['summary'], ' '.join(record['passages']), f\\\"party: {record['original_party'] or 'unknown'}\\\",\\n                      f\\\"stated: {stated(record)}\\\", f\\\"period: {record['evidence_period'] or 'unknown'}\\\"])\\n\\n\\ndef query_text(record, thesis_question):\\n    return f\\\"thesis: {thesis_question}\\\\n{record['summary']}\\\\n{' '.join(record['passages'])}\\\"\\n\\n\\ndef piece_text(record, label):\\n    return (f\\\"{label} [{record['tier']}; {record['reporting_speaker']}; original source {record['original_party']}, stated \\\"\\n            f\\\"{stated(record)}] {record['summary']} | quote: {' '.join(record['passages'])}\\\")\\n\\n\\ndef query_vectors(vectors, record, thesis_questions):\\n    \\\"\\\"\\\"The search queries of one record, in order: one per thesis association, then its own text when it has no association or lists\\n    the company's figures.\\\"\\\"\\\"\\n    queries = [vectors[query_text(record, thesis_questions[t])] for t in record['thesis_ids']]\\n    if not record['thesis_ids'] or record.get('figures'):\\n        queries.append(vectors[doc_text(record)])\\n    return queries\\n\\n\\n# Jev's piece criteria aligned with the Step 2 merge line's own test (PRD §5 line 2; AGENTS §7.1, one ruler): a repeat is a later report\\n# of the stored piece's main statement. Production's wording (views/jev_matching.PIECES) judged \\\"the same evidence\\\", so a later report of\\n# only a secondary statement inside a stored record (an official's denial carried in the report it denies) was merged as a repeat.\\nPIECES = {'same_statement': \\\"the INCOMING PIECE reports the STORED PIECE's main statement: a retelling, another outlet carrying it, the \\\"\\n                            \\\"same number in text or a table, or the same speaker repeating it; wording, precision and extra detail may \\\"\\n                            \\\"differ. If the stored piece carries several statements and the incoming piece reports only a secondary one, \\\"\\n                            \\\"this is not it\\\",\\n          'supersedes': \\\"a later version of the stored piece's main statement, changed: the same speaker revises that guidance, \\\"\\n                        \\\"forecast or event-progress statement, an official confirms or denies that reported claim, or the original \\\"\\n                        \\\"source revises it; another statement on the same topic is not this\\\",\\n          'different': \\\"a different fact, figure or matter, a figure for another period or quantity, or only a secondary statement of \\\"\\n                       \\\"the stored piece, even if on the same topic\\\"}\\n\\n\\ndef piece_question(text):\\n    return {'type': 'choice', 'criteria': PIECES,\\n            'instructions': 'How does the INCOMING PIECE relate to the STORED PIECE below? Use only the supplied text. STORED PIECE:\\\\n' + text}\\n\\n\\nINFORMS = {'true': \\\"the STORED PIECE bears on the THESIS's own matter (the parties, products, policy or quantity the THESIS names) and \\\"\\n                   \\\"makes its answer more or less likely, as evidence filed under it would\\\",\\n           'false': \\\"the STORED PIECE concerns another matter, or is a company-wide result or event that does not speak to the THESIS's \\\"\\n                    \\\"own matter, or would not change its answer\\\"}\\n\\n\\ndef informs_question(text):\\n    return {'type': 'noul', 'criteria': INFORMS,\\n            'instructions': 'Does the STORED PIECE below inform the THESIS stated above? Use only the supplied text; a shared company, '\\n                            'product family or word is not enough, and the company\\\\'s overall results, guidance and estimates inform a '\\n                            'thesis about its revenue or earnings path, not one about a competitor, a supplier or a policy unless they '\\n                            'speak to it. STORED PIECE:\\\\n' + text}\\n\\n\\ndef later_link_judge(library, thesis_question, ask):\\n    \\\"\\\"\\\"The judge `Library.link_later` calls: one Jev request per batch, the thesis as state, one yes/no question per stored group.\\\"\\\"\\\"\\n    def judge(group_ids):\\n        questions = {f'q{i}': informs_question(piece_text(library.groups[g]['original'], 'STORED PIECE')) for i, g in enumerate(group_ids)}\\n        raw = ask(f'THESIS: {thesis_question}', questions)\\n        return {g: raw[f'q{i}']['noul'] >= jev_matching.THRESHOLD for i, g in enumerate(group_ids)}\\n    return judge\\n\\n\\ndef cosine(a, b):\\n    return sum(x * y for x, y in zip(a, b)) / (math.sqrt(sum(x * x for x in a)) * math.sqrt(sum(y * y for y in b)) or 1)\\n\\n\\ndef search(library, vectors, record, thesis_questions):\\n    \\\"\\\"\\\"Candidate group ids: each query's top 10 by cosine against the groups' original records, merged in rank order.\\\"\\\"\\\"\\n    candidates = []\\n    for query in query_vectors(vectors, record, thesis_questions):\\n        ranked = sorted(library.order, key=lambda g: -cosine(query, vectors[doc_text(library.groups[g]['original'])]))[:TOP]\\n        candidates += [g for g in ranked if g not in candidates]\\n    return candidates\\n\\n\\ndef outcome(answers, order):\\n    \\\"\\\"\\\"answers: {group id: {'choice', 'probabilities'}}; order: group ids in creation order.\\\"\\\"\\\"\\n    same = [g for g, a in answers.items() if a['choice'] == 'same_statement']\\n    later = [g for g, a in answers.items() if a['choice'] == 'supersedes']\\n    if same:\\n        best = max(same, key=lambda g: (answers[g]['probabilities']['same_statement'], -order.index(g)))\\n        return {'kind': 'repeat', 'repeat_of': [best], 'revises': later}\\n    if later:\\n        return {'kind': 'revision', 'revises': later}\\n    return {'kind': 'new'}\\n\\n\\ndef forward(articles, library, vectors, thesis_questions, ask, workers=8, opened=None):\\n    \\\"\\\"\\\"articles: lists of Step 3 records in article order. ask(state, questions) returns Jev's answers by question id, or raises.\\n    opened: per article, the thesis ids it opened; after the article's records are written, each is linked later to the stored groups\\n    that arrived unlinked from earlier articles (`Library.link_later`). A thesis written to with pairs still pending is judged again,\\n    against its opening boundary. Returns one decision per record.\\\"\\\"\\\"\\n    decisions = []\\n    for index, records in enumerate(articles):\\n        def decide(record):\\n            candidates = search(library, vectors, record, thesis_questions)\\n            if not candidates:\\n                return record, candidates, {}, {'kind': 'new'}\\n            questions = {f'q{i}': piece_question(piece_text(library.groups[g]['original'], 'STORED PIECE'))\\n                         for i, g in enumerate(candidates)}\\n            incoming = piece_text(record, 'INCOMING PIECE')\\n            try:\\n                raw = ask(incoming, questions)\\n            except Exception as first:   # retried once; a second failure is reported, never silently saved as new\\n                try:\\n                    raw = ask(incoming, questions)\\n                except Exception as error:\\n                    return record, candidates, {}, {'kind': 'failed', 'reason': f'{type(first).__name__}: {first}; retry: {type(error).__name__}: {error}'}\\n            answers = {g: {'choice': raw[f'q{i}']['choice'], 'probabilities': raw[f'q{i}']['probabilities']} for i, g in enumerate(candidates)}\\n            return record, candidates, answers, outcome(answers, library.order)\\n        with concurrent.futures.ThreadPoolExecutor(max_workers=workers) as pool:\\n            results = list(pool.map(decide, records))\\n        for record, candidates, answers, result in results:\\n            entry = {'id': record['id'], 'candidates': candidates, 'answers': answers, 'outcome': result}\\n            try:\\n                entry['group'] = library.apply(record, result)\\n            except Exception as error:\\n                entry['refused'] = f'{type(error).__name__}: {error}'\\n            decisions.append(entry)\\n        article = records[0]['article'] if records else None\\n        if article is None:\\n            continue\\n        written = {t for r in records for t in r['thesis_ids']}\\n        retry = [t for t in written if t in library.pending and t not in (opened[index] if opened else [])]\\n        for thesis_id in list(opened[index] if opened else []) + retry:   # opened here, or written to with pairs still pending\\n            result = library.link_later(thesis_id, later_link_judge(library, thesis_questions[thesis_id], ask), article)\\n            library.later_log.append({'thesis': thesis_id, 'article': article, **result})\\n    return decisions\\n# Current state\\n\\n**Clean Steps 1–3, current (2026-11-09).** Record: [round log](../clean-arch/step1-unfiled-2026-11-08/LOG.md) §§16–47.\\n- **Step 1 configuration: c8, adopted by Alex (D387).** It runs DeepSeek Flash at high effort, with a 64,000-token output cap; a\\n  format failure or a cut answer is resent once (D380). It carries Alex's decisions D382–D385:\\n  - figures are conditions;\\n  - material statements with no thesis are kept without links;\\n  - only big matters open a thesis;\\n  - no target prices.\\n\\n  [PRD §12](../clean-arch/PRD.md) holds its system prompt, closing check and schema; a run with no candidate files sends exactly the\\n  accepted request.\\n- **Acceptance (D386, [protocol](../clean-arch/step1-unfiled-2026-11-08/ACCEPTANCE-PROTOCOL.md)).** 50 fresh articles that no run,\\n  old or new, had used: news from 2026-09-05 to 09-07, a holiday weekend with no NVIDIA posts. One draw; two readers and a third on\\n  disputes.\\n  - helpful 132/139 (core 83/83);\\n  - wrongly opened theses 1 of 10;\\n  - search 141/143 available repeat pairs, or 141/145 for the whole system (one 11-article story supplies 55 pairs, and revisions are\\n    barely exercised);\\n  - clear wrong merges 1/57, plus 2 overlaps;\\n  - detail retention 22 = 22. This is a storage comparison: every record keeps its own text. It is not a usability test.\\n\\n  Dev ×3 on the frozen golden-v5 (a lead): helpful 214, 211 and 212 of 234; search 98.9–100%; clear wrong merges about 1%. Step 1\\n  cost for the fresh set plus dev ×3: $4.20 at published rates.\\n- **Steps 2 and 3** are built in isolation (`clean-arch/step2`, `clean-arch/step3`): search, comparison, grouping and later linking.\\n  They are not integrated with production storage. **Step 4 (judging) is not built** on the clean path, so nothing yet shows the clean\\n  system can judge an investment view.\\n- **Open defects, by product impact** (reflection council, `council/av-codex.md`):\\n  1. **The Ohio-guarantee yes/no question is never covered** in the three dev draws; a broader credit-support amount thesis opens\\n     instead. Diagnosed (round log §48): the model folds the unsigned guarantee into the open aggregate thesis because the request\\n     uses \\\"covers\\\" both for \\\"is evidence for\\\" and for \\\"already asks this question\\\". The same clause sits under link clutter.\\n  2. **A revenue-share thesis was opened** (Vera Rubin's share of data-center revenue), the class-A boundary of D382.\\n  3. **Link clutter.** A blind recheck of the 34 disputed fresh links found 19 weak and 2 wrong; 10 accepted links mixed in as controls were all useful; the other 49 links were not rechecked.\\n     The model's own account names topic or theme overlap and inference chains, and c8's closing check never reads back a link. This is\\n     a likely cause, with no fix proven. Alex approved designing a protected link check through the council; a first draft was stopped\\n     because it would drop founding premises and contrary facts.\\n  4. **Unverified passages:** 3 of 188 fresh records and 1–3 per dev draw. The mark now travels into Step 2's records, and a reader sees the found source text or an \\\"Unverified quote\\\" label. Jev's comparison input still carries the model's text without the mark; changing it changes measured Step 2 behaviour and needs its own measurement.\\n  5. **The lidar policy thesis** recurs at the boundary (one dev draw in three).\\n- **History.** These earlier states are superseded:\\n  - the 2026-11-07 takeover (K5 → K6b; [takeover log](../clean-arch/takeover-2026-11-07/LOG.md));\\n  - the 2026-11-08 close-out (K6b test 32/42; Step 2 first lines; [Step 2 log](../clean-arch/step2-validation-2026-11-07/LOG.md) §12);\\n  - the unfiled fix round and the c1–c7 arms (round log §§1–39).\\n- **No run is live.** The branch is committed through the D388 line (round log §§48–59).\\n\\n**Clean Step 1 source investigation (2026-11-07):** A [source-loss census](../clean-arch/STEP1-SOURCE-LOSS-CENSUS.md) traces two separate losses in the historical cleaner and records reproducible corpus observations. Offline candidate comparisons expose both recovered content and source-identity or contamination risks. A subsequent [full-page diagnostic](../clean-arch/STEP1-FULL-PAGE-RESULTS.md) completed 102 calls on 17 selected articles and independent source-backed review. It exposes examples of both missing or misattributed source text and model errors that persist despite the right text being present. A Codex–Claude council is reviewing the results and earlier attempts; no source-cleaning candidate is adopted, and the source corpus and production defaults are unchanged.\\n\\nAlex has authorized correcting the test-source cleaner and test data when their defects are confirmed, while the frozen production configuration and ruler remain intact. The cleaner switched 615 originally fed articles off; a replay reproduces all 615, and direct inspection confirms an actual article excluded because its 9,874-character body was flattened to one line. Other examples include a wrong-site shell, paywall and long challenge code, so the false-exclusion count and a general article-identification repair remain to be established. The [council regroup](../clean-arch/STEP1-SOURCE-REGROUP-COUNCIL.md) and [source-preservation design](../clean-arch/STEP1-SOURCE-PRESERVATION-DESIGN.md) describe an isolated candidate checked against all 34,084 records, with a fake-answer actual-runner handoff and provenance display in the replay renderer. The [five source-control calls](../clean-arch/STEP1-CAPTURE-CONTROLS-RESULTS.md) completed and were source-reviewed; two items contain summary details absent from their attached quotations, and one source-visible risk explanation was not returned. This is selected-case evidence, not a general quality result. Broader source-quality comparison, citation completeness and actual writer integration remain open.\\n\\n**Clean architecture Step 1 (2026-11-06, isolated work on `clean-arch`):** Alex reopened work with the clean architecture. An experimental prepared-source handoff now preserves the archived page, prior cleaned text, source-role decisions and selected-line mapping without changing the original database; quotations for prepared items must also occur contiguously in the original captured page. Two seven-item runs are available in the [clean architecture PRD](../clean-arch/PRD.md), one in the earlier selection order and one in recorded page-timestamp order. The source selector is not a production service and source ordering is not established event-arrival ordering. The runs expose unresolved semantic problems: citations can omit supporting facts despite an exact location match; model output can change a benchmark into a deployment, reverse a backup relation, omit a named customer or assign an unstated currency. A blinded 84-call check-placement/wording comparison and a 27-call same-article citation-completion diagnostic did not give a clean semantic fix and are not adopted. The latter missed an omitted connectivity condition and a reversed backup relationship, and left six expected evidence reviews unaddressed. A further five-round Codex–Claude council produced a narrowly scoped Step 1 link candidate, independently checked for prompt-contract drift. A six-article, 36-call blind comparison completed; the candidate still produced an explicitly self-contradictory link and both arms consistently omitted the same Kyber report and company response. It is not adopted and has not changed the active PRD prompt. A trace confirms that both the Kyber report and open Kyber thesis were supplied, and the raw model answers omitted the report and denial; the reason is not established. See ../poc/data/clean-step1-kyber-trace-2026-11-06/TRACE.md. An isolated six-call comparison showed that hiding the Kyber thesis did not recover the report or denial in any draw. A second six-call comparison returned them in 3/3 draws with the original Kyber paragraph alone and 0/3 with the full article; length, position and surrounding content changed together, so the reason is not isolated. Excerpt outputs have source-attribution limitations. Neither experiment changed state or established a production fix. (Superseded: the next task then was a whole-article coverage approach; the current next task is under \\\"One next task\\\".) See ../clean-arch/STEP1-IMPLEMENTATION-COUNCIL.md. The earlier four-round council agreed that no tested semantic fix is ready; its next investigation is a source-backed review of the 49-item historical run and its 160 evidence records, with overlapping issue flags and separate article-level omissions, then a separate comparison of the seven-item replays. See ../clean-arch/STEP1-COUNCIL-REVIEW.md. Preserve relevant evidence while identifying the next intervention; production/frozen history remains as described below. See [Step 1 run log](../clean-arch/STEP1-RUN-LOG.md) and [English reading page](../clean-arch/architecture.html).\\n\\n**Sealed (D379, 2026-11-06):** Alex asked to clean up and seal this version while he re-plans the system design. Work stops here and is sealed as it is: main's working tree is committed on branch `seal/2026-11-06` (tag `sealed-2026-11-06`) and merged into `main` on Alex's word (PR #10); the sealed split and two side experiments are pushed on their own branches (D379). No PRD 11 experiment is open, and the E1 next task below is withdrawn. The next task is Alex's re-planned system design.\\n\\n**E1 diagnosed (2026-11-06, Alex chose E1):** of 57 helpful matters frozen production wrote and then dropped, two readers agree on 17 link misses (4 core), 3 opening misses (1 core) and 24 small matters the standard itself drops; 10 are disputed on the fallback clause and 3 were quote refusals. Opening is not the experiment. The core of the link misses is the model reading a question's period, population or named configuration as a boundary; only 8 of the 13 window draws it dropped were lost to the product. No production change; $0.02 of probes. My recommendation was to fold that narrow change into the next extraction version; withdrawn by the seal (D379). Details: `docs/research/2026-11-06-e1-no-home-drops/README.md`, PRD 11 E1.\\n\\n**Split extraction sealed as a failed experiment (D378, 2026-11-06):** the split (a new-question call, an evidence call and record preparation) was benchmarked against the frozen poc-v108 and failed. Its stop line fired: helpful matters 156, 156, 159 against 166, 170, 162, with about 15% higher cost. One screened revision kept more noise than production. It is sealed in the worktree `hivemind-no-preseed-evidence-review` (tag `split-extraction-failed-sealed-2026-11-06`), and nothing of it is in main. What it taught is written as proposed production experiments in `docs/prd/11-production-experiments-from-split.md`: E1 no-home helpful drops, E2 duplicate questions, E3 ladder checks with D186, E4 judge refusals, E5 D203's revision day, E6 the measurement kit. Each opens only on Alex's word.\\n\\n**Question-catalog limit removed (D377, 2026-11-05):** Alex also directed removal of the separate 150 KB catalog rejection. The research reader in this worktree now has neither the catalog nor evidence byte limit; it retains full scoped questions, historical boundaries, dependencies and evidence. A portable 326,996-byte catalog test returns all 400 new questions and expands evidence both after reading the catalog and directly; the old 150 KB guard fails the same test in a scratch copy. The saved 69-question pilot catalog and all 69 saved evidence expansions match their original content hashes. Details: `docs/research/2026-11-05-catalog-limit/`. The full suite remains pending until the paid seven-day run no longer competes for resources. The run remains in its isolated worktree and does not call this research reader.\\n\\n**Evidence reader limit removed (D376, 2026-11-05):** Alex directed removal of the reader's 1 MB evidence-expansion rejection. In this worktree, `research_context.Reader.expand` now returns the entire evidence payload without that cap, while the catalog's separate limit remained at that checkpoint; D377 subsequently removed it. On the saved pilot ledger, all 69 individual question expansions, the four-question 1,931,225-byte pilot request and the entire 3,454,076-byte catalog produce the exact same content as the pre-change high-limit baseline; the portable oversized-ledger test passes and fails when the old cap is restored in a scratch copy. Details and snapshot-specific measurements are in `docs/research/2026-11-05-reader-limit/`. The seven-day diagnostic runs in `/Users/lchingen/hivemind-no-preseed-evidence-review/poc/data/split-fresh-seven-day-2026-11-05-v2/` with its pinned code; it does not call this research reader. Read its status through its `snapshot.sh`; do not edit its package code while it is live. This change is not an acceptance of seven-day extraction or judgement quality.\\n\\n**Start-state correction (2026-11-05):** Alex requires a research library established from real material available before the test start, then extraction against that state. The prior empty-library diagnostic cannot represent this case. Our own mistakes and the current 68-question provenance audit are in `../hivemind-no-preseed-evidence-review/docs/research/2026-11-05-parallel-refinement/own-mistakes-2026-11-05.zh.md`. Two new A-only calls were run on 2026-08-29 articles using the 68-question prior-day snapshot; both proposed the same aggregate supply-commitments topic. A source/context review judged it distinct from the existing specific SK Hynix question. A third A-only call on an author-body excerpt about DLSS 5, already tracked by v22, passed; the prompt also restricts software updates, so the reason is not established. No writer or dedup ran; source-history completeness remains unverified, and this is not scored acceptance. Details: ../hivemind-no-preseed-evidence-review/docs/research/2026-11-05-parallel-refinement/start-state-diagnostic-2026-11-05.zh.md.\\n\\n**Measurement correction (2026-11-05):** Alex clarified that a gold-worthy topic already in the supplied library should not open again; an absent worthy topic should open. The earlier simple-A claim of a \\\"missed\\\" new topic was not scored against that rule and is withdrawn as a correctness conclusion. In the actual experiment, a Kyber topic was shown and passing follows Alex's topic-level rule; whether its exact release question captures the shipping milestone remains unverified. The experimental pre-article snapshots differ from the replay's day-start snapshots; 9 of 10 inspected examples differ. The current uncommitted replay default does not build a cold-start library; committed main HEAD still uses the old seed and startup filing path. Historical lexical coverage has a confirmed unrelated-topic match. The frozen gold and past scores remain unchanged. Audit: `../hivemind-no-preseed-evidence-review/docs/research/2026-11-05-parallel-refinement/measurement-context-scrub-2026-11-05.zh.md`.\\n\\n**Simple new-question diagnostic (2026-11-05):** At Alex's direction, an isolated prompt returned new questions plus article evidence without asking for product database fields. Four previously seen real dev articles each ran once: three returned one candidate, one returned none, all four quotes matched their source, and the gold-listed GPU backstop amount question was not proposed. Whether that omission is a new-topic miss depends on whether the existing library covers the topic. Two other candidates require source and independent-significance review; the actual experimental snapshot already had a Kyber topic, so its pass follows Alex's topic-level rule; whether its exact release question captures the shipping milestone remains unverified. This is not a production or full-pipeline acceptance. Details: `../hivemind-no-preseed-evidence-review/docs/research/2026-11-05-parallel-refinement/simple-new-question-results.zh.md`.\\n\\n**Split prompt structure v3 read diagnostic (2026-11-05):** One real reading-stage call on a previously seen article found the revenue/margin guidance and Trainium scale but omitted the gold China revenue/market-loss matter. The prewritten stop condition was triggered and the linking call was not sent. This is one draw and not a production or end-to-end result. See `../hivemind-no-preseed-evidence-review/docs/research/2026-11-05-parallel-refinement/structure-v3-read-result.zh.md`. D374 removes the model sampling field from active settings and default configs; historical config files and archives retain their original bytes.\\n\\n**Split prompt structure v2 small test (2026-11-05):** Thirty calls on two previously seen golden-v5 dev articles completed in `../hivemind-no-preseed-evidence-review`. The blind model reader found complete helpful matters in the fresh control versus new A+B of 6/19 vs 10/19, 11/19 vs 7/19, and 9/19 vs 12/19. The new arm also retained more gold not-kept matters in each draw; B missed useful margin guidance and one answer reused IDs, with a demonstrated matching collision. This is not a production acceptance. See `../hivemind-no-preseed-evidence-review/docs/research/2026-11-05-parallel-refinement/structure-v2-results.zh.md` and `reports/2026-11-05-parallel-structure-v2.html`.\\n\\n**Split extraction small test (2026-11-05):** At Alex's request, the isolated `hivemind-no-preseed-evidence-review` worktree ran two real golden-v5 articles once through each split lane. An independent model reader found 7 of 19 helpful gold matters fully retained, two partial, two written then dropped, eight missed, and one retained gold not-kept matter. Three saved v108 draws on these articles retained 7, 9 and 12 of 19, but used 22 seeded questions while the new test used 8/10-question snapshots; these are not directly comparable. The experiment remains unaccepted; see `../hivemind-no-preseed-evidence-review/docs/research/2026-11-05-parallel-refinement/small-scored-test-20261105.md` and `reports/2026-11-05-split-small-test.html`.\\n\\nAs of November 5, 2026; decisions through D374. [Decisions](DECISIONS.md) holds what is decided now; the [design page](system-design.html) and the [module PRDs](prd/README.md) hold what the code must do; the [README](../README.md) holds startup, build and run instructions.\\n\\n## Future evidence scoring (D372)\\n\\nAlex decided future gold scoring should measure helpful versus not helpful evidence without requiring separate scores for core and supporting. Use frozen golden-v5 as-is: combine core and supporting as helpful, treat not-kept as unhelpful, and keep optional entries neutral. A counting report has not yet been implemented. Historical scores retain their original definitions. D373 removes the stop caused by a separate concern about three question-gold entries: keep the gold unchanged, continue scoring and disclose the concern; see `../hivemind-no-preseed-evidence-review/docs/research/2026-11-05-parallel-refinement/ruler-conflict-2026-11-05.zh.md`.\\n\\n## Latest decision (D369)\\n\\nAlex decided in D369 to capture core and supporting evidence without a strict boundary and in D370 to remove the 22 preset starting questions and separate earnings-report import. The replay entry now defaults to `poc-v118` (D374), refuses old seeded ledgers and baseline configurations, and continues to read existing non-seeded questions; earnings releases remain normal source items. This change has local contract tests but has not passed end-to-end product acceptance. The frozen historical rulers and results remain unchanged.\\n\\nThe small 2026-11-05 study used three archived NVDA articles and an 8/28 historical 68-question snapshot: without versus with an appended report, independent AI review found 14/27 versus 13/27 complete matters. This measured appended extraction context, not the distinct former coverage-start step; D370 removes both by Alex's decision. Full traces and limitations are in the separate `hivemind-no-preseed-evidence-review` worktree under `docs/research/2026-11-05-real-input-evidence/existing-library-results-2026-11-05.md`.\\n\\n\\n**One-day smoke completed (2026-11-05 UTC):** Alex requested a quick 1–2 day end-to-end test. One day, 2026-08-29, ran in `/Users/lchingen/hivemind-no-preseed-evidence-review/poc/data/v117-one-day-smoke-2026-11-05/`: config v117, an 8/28 historical library, 40 extraction calls, 93 evidence records written, four new questions, 54 judged and zero terminal failures. Two judgement attempts were refused and corrected. A Microsoft revenue forecast of $391.1bn was assigned to a rung whose upper bound excludes $391.1bn; the same article's actual quarterly revenue and next-quarter guidance were dropped with no home. Some source dates and bodies are not verified, and an independent 14-article sample review was incomplete due to truncated text. This is not semantic or production acceptance. Findings and scope: `docs/research/2026-11-05-real-input-evidence/one-day-v117-smoke-2026-11-05.zh.md` in that worktree. The clean source-text comparison and its condition-hidden review are complete; council discussion of next steps is ongoing.\\n\\n**D371, in progress:** Alex directed that present and forward-looking revenue and financial information should be tracked. Diagnose the same-day extraction and filing losses before designing a general change. No new financial tracking implementation has been accepted yet. The old frozen standard and gold are unchanged. The original prompt-only pilot failed design review. The user approved an exact prompt addition for an experiment; it is not a production implementation. Four paired real-article diagnostic calls per arm completed for the exact approved sentence: v74i versus experimental role-d371-pilot. Microsoft next-quarter guidance and NVIDIA FY2028 guidance still dropped in the treatment; a single draw is not acceptance or proof of causation. Details: docs/research/2026-11-05-real-input-evidence/d371-prompt-pilot-results.zh.md (isolated worktree). The requested full prompt audit and restructure were drafted experimentally; five real-article paired diagnostic requests per arm completed. Microsoft revenue guidance was missed in both arms, and the draft produced unsupported original dates, a quote refusal and suspect links. No production prompt change or acceptance; see restructure-pilot-results.zh.md in the isolated worktree.\\n\\n**Clean Step 1 coverage council (2026-11-06):** Codex and Claude Code independently reviewed the existing attempts and completed three discussion rounds. The proposed next research candidate moves the existing evidence-reading block ahead of the thesis-opening block while preserving the article, open-thesis state and paired output. It is a hypothesis, not an implemented or validated fix. A complete prompt/contract audit and independent review precede any controlled Luna comparison. Historical paragraph-based and source-first experiments, their noise and attribution problems, and the rejected overlap-based merge are recorded in [the council review](../clean-arch/STEP1-COVERAGE-COUNCIL.md). No new Luna experiment was run in the council.\\n\\n**Clean Step 1 coverage order result (2026-11-07):** The isolated 54-call clean comparison completed and all answers were reviewed blind. Moving the evidence-reading block recovered a known Kyber report and denial in one of three candidate answers against none in three controls, with attribution blur; it also produced unsupported gaming-to-AI links in two candidate answers and no controls. It is not adopted. A separate exact-quote example misattributes an executive's prediction in the standalone summary. [Results and replay](../clean-arch/STEP1-COVERAGE-ORDER-RESULTS.md) record all selected cases, uncertainties and source-fidelity work; no production ledger was written.\\n\\n**Clean Step 1 fidelity council (2026-11-07):** Codex and Claude Code completed five rounds on source attribution, conditions, dates and meaning. No tested fix or root cause is established. The agreed source-to-record review of 49 articles / 160 evidence items and the subsequent isolated field-order comparison are complete; the later 54-answer / 217-record repeated sample remains separate. Prior source-first, quote-first and follow-up-review experiments and their limits are recorded in [the fidelity council](../clean-arch/STEP1-FIDELITY-COUNCIL.md). No Luna experiment or production change was made in this council.\\n\\n**Clean Step 1 fidelity review (2026-11-07):** All 49 saved source packets and 160 original evidence items have received a source-and-record review; focused independent cross-checks cover the findings and selected controls. The [review and article replay](../clean-arch/STEP1-FIDELITY-REVIEW.md) distinguish source contamination and missing source material from model meaning, citation, date and link issues. The [isolated schema property-order diagnostic](../clean-arch/STEP1-CITATION-ORDER-RESULTS.md) completed all 66 calls and condition-blinded article reviews. Several omissions and semantic errors persisted; it did not establish a fix and is not adopted. It used saved articles and before-states without changing production.\\n\\n**Clean Step 1 source handoff council (2026-11-07):** The ongoing [council and offline checks](../clean-arch/STEP1-SOURCE-HANDOFF-COUNCIL.md) reconstructed 16 matching article-34 controls, all omitting a Kyber report and denial; the cause remains unknown. The 20-article saved source-role overlap review distinguished previously cited AI-generated summary lines and an unrelated recommendation from authored body. The clean runner does not send the saved source-role labels; the council chose to first compare original and previously selected source text on ten known articles. The isolated 60-call source-text comparison and condition-hidden review are complete; [results](../clean-arch/STEP1-SOURCE-TEXT-RESULTS.md) show specific contamination reductions alongside persistent omissions and changed meaning. It did not advance state or write production. The isolated six-article low-versus-medium source-fidelity diagnostic completed 36/36 calls and condition-hidden review. [Results](../clean-arch/STEP1-REASONING-FIDELITY-RESULTS.md) show partial improvements alongside persistent source-qualification and attribution concerns; no production setting is changed. The [prompt audit](../clean-arch/STEP1-FIDELITY-PROMPT-AUDIT.md) maps the observed failures to the full request and signed standard. The six-article isolated schema-description comparison completed 36/36 calls and condition-hidden review; the candidate did not preserve the repeated example qualification and is not adopted. [Results](../clean-arch/STEP1-SUMMARY-FIDELITY-RESULTS.md). A further six-article 36-call low-versus-medium comparison used corpus-cleaned sources outside the original 49-item clean replay and a fixed exploratory context; results were mixed, including unsupported links and incorrect attribution/date fields. [Results and replay](../clean-arch/STEP1-ADDITIONAL-SOURCES-RESULTS.md). The structured-claims candidate was not sent after review revealed scope and complexity concerns. Council review of the next action is ongoing. The date-text schema-description diagnostic completed 48/48 calls on eight known cases, with mixed results; the candidate is not adopted. A selected-run census found twelve literal \\\"null\\\" strings in date-text fields, but no production writer impact is established. [Results and replay](../clean-arch/STEP1-DATE-DESCRIPTION-RESULTS.md). A further preregistered eight-source date comparison completed 48/48 calls; the candidate lost a supported company-article statement date in all three draws on one source and is not adopted. [Results and replay](../clean-arch/STEP1-DATE-NEW-SOURCES-RESULTS.md). A bounded corpus census confirmed 163 source pages across three explicit generated-summary structures whose labels were removed while some summary text was retained; two NVIDIA cases were reproduced through the cleaner. [Source provenance investigation](../clean-arch/STEP1-SOURCE-PROVENANCE-CENSUS.md). A read-only source-lineage replay reproduced 363/363 cleaned pages with current inputs, preserved ambiguous original-line locations, and surfaced the generated-summary label loss for review. [Source investigation and lineage replay](../clean-arch/STEP1-SOURCE-PROVENANCE-CENSUS.md). An offline neighboring-context observation exposed only 144 or 149 of 163 known labels and introduced many other page lines; it is not adopted as a general source fix. [Observations and viewer](../clean-arch/STEP1-SOURCE-CONTEXT-OBSERVATIONS.md). A new [saved-quote integrity investigation](../clean-arch/STEP1-QUOTE-INTEGRITY-CENSUS.md) reconstructed 360 saved answers across eight overlapping cohorts, including 78 prepared-source calls. Five saved unverified passage instances were complete matches under the existing normalization; an in-memory candidate recovered their original slices, while ten others remained unverified. The normalized source-slice lookup is now installed only in the isolated clean Step 1 runner; saved-answer and entry-point checks are recorded there. Page provenance, Unicode completeness, production resource budgets and writer integration remain open. The existing writer stores only one quote, whereas 63 of 160 evidence items in the 49-article exploratory trace have multiple passages. A [source-first 49-article coverage review](../clean-arch/STEP1-COVERAGE-CENSUS.md) separates material missing from the model input from source-visible omissions in the saved answers, with uncertain matter boundaries labeled. (Superseded: the next investigation then was why supplied material is missed; the current next task is under \\\"One next task\\\".) The canonical prompt and production configuration remain unchanged. Adding fallible role annotations remains a separate untested candidate. Council streams and handoffs are in `poc/data/clean-step1-ongoing-council-2026-11-07/`.\\n\\n## What runs\\n\\n- **Pipeline (replay default `poc/config/poc-v118.json`, D370, D374).** Every item reads the relevant open questions from the library at the start of its day, then extraction v74i on `gpt-6-luna` proposes evidence and questions; Jev matching with the collision judge matches them; code writes the records; judging-v7 judges changes once a day; pull mode closes due questions. There is no separate seed or coverage-start report import, and reports as source items remain eligible. This default has not completed end-to-end acceptance. The [pipeline guide](poc/pipeline-plan.md) maps stages to code.\\n- **Measured:** one company (NVDA) over one 14-day window (2026-07-01 to 07-14), the judgement scored at the window end on the frozen ruler (AGENTS §7.1). Three draws of `poc-v116` against three of `poc-v108` run in the same hours: 53 against 45 agreements of 57; operating margin and capex agree in 3 of 3 draws, never judged without the coverage-start reading ([acceptance](research/2026-11-04-filing-end-to-end/acceptance-design.md)).\\n- **Served data:** the service, the MCP server and the standalone page serve the sealed three-month ledger `served-2026-10-28-v34-nvda-3m-through-0828` (68 theses, 34 groups; D358), built by the earlier `poc-v34` pipeline, not by the replay default. HTTP `/library`, MCP `thesis_library` and the standalone page share the dated bundle writer.\\n- **Idea API:** `poc-v118-idea` (D290, D335, D374): two discovery calls and one adoption and weighting assessment; only adopted theses with positive weights appear, and nonempty plans total 100%. The [Idea contract](poc/idea-card.md) owns its fields and the limits of its scores.\\n- **Interface:** the Thesis Library and Explore Ideas workspaces, with the confidence Trigger and an Action preview (no wallet connection or order execution). The [UI specification](poc/thesis-ui.md) and the [integration guide](../poc/ui/README.md) own its behaviour.\\n- **Repository:** `main` holds the product, the frozen ruler and the research records; run databases, logs and model archives stay on disk (D353), located by the [data manifest](research/2026-10-25-english/data-manifest.md). Worktrees: `/Users/lchingen/hivemind` is the main checkout, where slice branches are cut from `main`; `/Users/lchingen/hivemind-extraction-quality-2026-10-28` (the extraction branch, merged on 2026-11-03) keeps in its ignored folders the stored end-to-end runs of `poc-v91` to `poc-v95` that later comparisons read (D359); `/Users/lchingen/hivemind-run-v109-2026-11-04` is the finished judging-v8 run's worktree. Older branches stay in Git without worktrees (D359); none is merged work in progress. The clean source-text comparison and its condition-hidden review are complete; council discussion of next steps is ongoing.\\n\\n## Open defects\\n\\n1. **Competitor and customer news is filed under the company's revenue questions** instead of the share, capital-spending or custom-chip question it informs (D355; filing is otherwise about 85% right). Share facts are often not written at all, an extraction recall miss. The total-revenue question holds about a quarter of all links (D354).\\n2. **One bet opened twice** about one encounter in five: the collision judge splits a seed question from an identical candidate on a fine detail (D354).\\n3. **A question the standard rules out** (the lidar legislation) was proposed by the extraction and opened in one draw of three (D354).\\n4. **A thesis opened from an article gets no dependency of its own**: the default Jev matching asks for none (`views/jev_matching.py`), although D51 has the matching call choose them; themes still reach every company thesis through the theme block (D191, D195). Found in the 2026-11-05 consolidation; building it is decided (D368).\\n5. **Historical coverage-start reading, retired by D370** (D364–D366): the capital-spending line is missed in about one read in six (the question is then left as it was); a labelled guidance figure is written with the fact tier; later reports reach the questions only through the daily stream; `scripts/preflight.py` does not replay the reading's check.\\n6. **Measured on one company and one 14-day window**, the judgement scored at the window end only; no version of the current pipeline has completed a longer window (a 60-day run of `poc-v108` was stopped at Alex's word after 2026-07-15, [log row 8](research/2026-11-04-argument-record/log.md)). The China-share question (v17) swings between draws (0 of 3 in the acceptance, 2 of 3 in its control, 1 of 3 in the frozen draws): two readers found the starting figures did not cause the acceptance's drop, and the byte-identical extraction request kept a \\\"share fell to zero\\\" sentence in two candidate draws and dropped it in two control draws. One acceptance draw judged nothing on v16; its cause is not established.\\n7. **What a judgement reads grows with the window** (D358). Argument records (D201) were measured as the remedy on 2026-11-04 and not built: judging-v8 agreed 12 of 17 against 15 of 17, judging-v9's card added little at about half again the judging cost; their code was removed at Alex's request ([log rows 4–11](research/2026-11-04-argument-record/log.md)).\\n8. **Seen once, not traced.** A judgement named a shown theme as a dependency and the check refused it twice, stopping a draw for a day (2026-11-02, D266). The sealed run's review recorded that a succession's opening evidence is not linked to the new question (D358), not yet checked against today's code.\\n9. **Earlier defects, unchanged.** Matching (build log row 49): another document's copy of a figure can be treated as new evidence; one matter can occupy several groups; same-answer candidate references caused seven chain or duplication decisions of the generative matcher; empty `original_who` values can count as the same party; different names for one population cause two of nine Jev merge misses. Nine 2026 aggregate-spending theses under `ai-capex` each have a different population; whether to combine them is a product choice. Extraction's instructions remain narrower than the PRD's important-question rule and omit the personal-memo exception, and extraction can change a quantity's meaning before matching (a guarantee amount against financing provided). Classification keeps its [recorded simulation defects](research/2026-10-25-english/classification-existing-defects.txt). The corpus audit recorded 97 official notices with 56 body and file-name collisions, to re-fetch before relying on a rebuilt corpus. An older intermittent search-test failure is untraced. Fresh Idea allocations vary while saved weights do not; the confidence chart applies the current plan to past states and is not a calibrated probability; broad analyst-prose quality and fresh Idea stability remain unaccepted (the [Idea contract](poc/idea-card.md) lists its limits); generative matching dependencies await `matching-v4`. The readers' doubts about the frozen standard, listed in the [extraction branch's state page](research/2026-11-01-e2e-loop/current-state-extraction-branch-2026-11-03.md), remain for Alex.\\n\\nUpstream supply and the human review pool's output remain deferred.\\n\\n## One next task\\n\\n**Clean Step 4 (D396): design version 4 is written; it is not READY and waits for two choices of Alex's**\\n([design](../clean-arch/step4-2026-11-10/DESIGN.md); round log §69).\\n\\n- **Design status:** three review rounds (`gg`, `gl`, `gm`) each found serious points; version 4 answers the last and has not been\\n  reviewed. Its core contract depends on C1 and C2 below.\\n- **What the review of 2026-11-10 found** (council `gh`–`gm`, all on stored data, no paid send):\\n  - Step 4 is the right next step, and inside it the first thing to build and test is the **ladder step alone**: the call that turns a\\n    thesis Step 1 opened into one judged question with its answer ladder and due day. The frozen judge follows only when the ladder\\n    step meets its lines.\\n  - Production's own ladder sentences are not stable: one request, the same in three draws, gave a bullish end at the low amount\\n    twice and at the high amount once, with three different middle bands; the code checks pass all three\\n    (`clean-arch/step4-2026-11-10/census/production_ladders.txt`).\\n  - Of the 34 theses the unseeded draws opened, two blind readers find 12 to 16 that ask more than one thing, 7 to 9 of 18 number\\n    questions with no reference figure in the opening article, and 4 that state a calendar due day.\\n- **The next task:** put to Alex\\n  1. **C1:** a topic that asks more than one thing gets one judged question with the rest shown as not judged (recommended as the\\n     first version), or is split as D38 says, or is not judged;\\n  2. **C2:** whether the ladder step carries D186 (ranges against guidance, the favourable end registered; recommended), its\\n     direction half only, or neither;\\n  then revise the design for his answers, review it with a fresh reviewer each round until one finds nothing serious, audit the\\n  whole ladder request, and ask his word to build the ladder step and run Stage A (the ladder step against a control that quotes v74i, on the 34 stored theses and the 10 fresh ones).\\n- **Open defects recorded by this review:** the frozen judge retried 10, 16 and 18 judgements in the seeded clean draws, 38 of 51\\n  reasons a theme cited as a dependency (PRD 11, E4; frozen, a finding for Alex); the same matter takes different shapes between\\n  draws (Kyber due end-2027 in one draw and end-2028 in another).\\n- **The unseeded measurement (D395):** graded subset 4.0 against 6.33 seeded. Every miss is a question not opened in the ruler's shape.\\n  Judged answers 16 of 16, on the ruler's wording and ladder; the system's own questions have never met a judge.\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n./reports/step2-jev-decision-council-2026-11-09/codex-independent.jsonl:11:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_4\",\"type\":\"command_execution\",\"command\":\"/opt/homebrew/bin/zsh -lc \\\"cat docs/CURRENT_STATE.md; sed -n '129,190p' clean-arch/PRD.md; cat clean-arch/step2/compare.py clean-arch/step3/library.py\\\"\",\"aggregated_output\":\"# Current state\\n\\n**Clean Steps 1–3, current (2026-11-09).** Record: [round log](../clean-arch/step1-unfiled-2026-11-08/LOG.md) §§16–47.\\n- **Step 1 configuration: c8, adopted by Alex (D387).** It runs DeepSeek Flash at high effort, with a 64,000-token output cap; a\\n  format failure or a cut answer is resent once (D380). It carries Alex's decisions D382–D385:\\n  - figures are conditions;\\n  - material statements with no thesis are kept without links;\\n  - only big matters open a thesis;\\n  - no target prices.\\n\\n  [PRD §12](../clean-arch/PRD.md) holds its system prompt, closing check and schema; a run with no candidate files sends exactly the\\n  accepted request.\\n- **Acceptance (D386, [protocol](../clean-arch/step1-unfiled-2026-11-08/ACCEPTANCE-PROTOCOL.md)).** 50 fresh articles that no run,\\n  old or new, had used: news from 2026-09-05 to 09-07, a holiday weekend with no NVIDIA posts. One draw; two readers and a third on\\n  disputes.\\n  - helpful 132/139 (core 83/83);\\n  - wrongly opened theses 1 of 10;\\n  - search 141/143 available repeat pairs, or 141/145 for the whole system (one 11-article story supplies 55 pairs, and revisions are\\n    barely exercised);\\n  - clear wrong merges 1/57, plus 2 overlaps;\\n  - detail retention 22 = 22. This is a storage comparison: every record keeps its own text. It is not a usability test.\\n\\n  Dev ×3 on the frozen golden-v5 (a lead): helpful 214, 211 and 212 of 234; search 98.9–100%; clear wrong merges about 1%. Step 1\\n  cost for the fresh set plus dev ×3: $4.20 at published rates.\\n- **Steps 2 and 3** are built in isolation (`clean-arch/step2`, `clean-arch/step3`): search, comparison, grouping and later linking.\\n  They are not integrated with production storage. **Step 4 (judging) is not built** on the clean path, so nothing yet shows the clean\\n  system can judge an investment view.\\n- **Open defects, by product impact** (reflection council, `council/av-codex.md`):\\n  1. **The Ohio-guarantee yes/no question is never covered** in the three dev draws; a broader credit-support amount thesis opens\\n     instead. Diagnosed (round log §48): the model folds the unsigned guarantee into the open aggregate thesis because the request\\n     uses \\\"covers\\\" both for \\\"is evidence for\\\" and for \\\"already asks this question\\\". The same clause sits under link clutter.\\n  2. **A revenue-share thesis was opened** (Vera Rubin's share of data-center revenue), the class-A boundary of D382.\\n  3. **Link clutter.** A blind recheck of the 34 disputed fresh links found 19 weak and 2 wrong; 10 accepted links mixed in as controls were all useful; the other 49 links were not rechecked.\\n     The model's own account names topic or theme overlap and inference chains, and c8's closing check never reads back a link. This is\\n     a likely cause, with no fix proven. Alex approved designing a protected link check through the council; a first draft was stopped\\n     because it would drop founding premises and contrary facts.\\n  4. **Unverified passages:** 3 of 188 fresh records and 1–3 per dev draw. The mark now travels into Step 2's records, and a reader sees the found source text or an \\\"Unverified quote\\\" label. Jev's comparison input still carries the model's text without the mark; changing it changes measured Step 2 behaviour and needs its own measurement.\\n  5. **The lidar policy thesis** recurs at the boundary (one dev draw in three).\\n- **History.** These earlier states are superseded:\\n  - the 2026-11-07 takeover (K5 → K6b; [takeover log](../clean-arch/takeover-2026-11-07/LOG.md));\\n  - the 2026-11-08 close-out (K6b test 32/42; Step 2 first lines; [Step 2 log](../clean-arch/step2-validation-2026-11-07/LOG.md) §12);\\n  - the unfiled fix round and the c1–c7 arms (round log §§1–39).\\n- **No run is live.** The branch is committed through the D388 line (round log §§48–59).\\n\\n**Clean Step 1 source investigation (2026-11-07):** A [source-loss census](../clean-arch/STEP1-SOURCE-LOSS-CENSUS.md) traces two separate losses in the historical cleaner and records reproducible corpus observations. Offline candidate comparisons expose both recovered content and source-identity or contamination risks. A subsequent [full-page diagnostic](../clean-arch/STEP1-FULL-PAGE-RESULTS.md) completed 102 calls on 17 selected articles and independent source-backed review. It exposes examples of both missing or misattributed source text and model errors that persist despite the right text being present. A Codex–Claude council is reviewing the results and earlier attempts; no source-cleaning candidate is adopted, and the source corpus and production defaults are unchanged.\\n\\nAlex has authorized correcting the test-source cleaner and test data when their defects are confirmed, while the frozen production configuration and ruler remain intact. The cleaner switched 615 originally fed articles off; a replay reproduces all 615, and direct inspection confirms an actual article excluded because its 9,874-character body was flattened to one line. Other examples include a wrong-site shell, paywall and long challenge code, so the false-exclusion count and a general article-identification repair remain to be established. The [council regroup](../clean-arch/STEP1-SOURCE-REGROUP-COUNCIL.md) and [source-preservation design](../clean-arch/STEP1-SOURCE-PRESERVATION-DESIGN.md) describe an isolated candidate checked against all 34,084 records, with a fake-answer actual-runner handoff and provenance display in the replay renderer. The [five source-control calls](../clean-arch/STEP1-CAPTURE-CONTROLS-RESULTS.md) completed and were source-reviewed; two items contain summary details absent from their attached quotations, and one source-visible risk explanation was not returned. This is selected-case evidence, not a general quality result. Broader source-quality comparison, citation completeness and actual writer integration remain open.\\n\\n**Clean architecture Step 1 (2026-11-06, isolated work on `clean-arch`):** Alex reopened work with the clean architecture. An experimental prepared-source handoff now preserves the archived page, prior cleaned text, source-role decisions and selected-line mapping without changing the original database; quotations for prepared items must also occur contiguously in the original captured page. Two seven-item runs are available in the [clean architecture PRD](../clean-arch/PRD.md), one in the earlier selection order and one in recorded page-timestamp order. The source selector is not a production service and source ordering is not established event-arrival ordering. The runs expose unresolved semantic problems: citations can omit supporting facts despite an exact location match; model output can change a benchmark into a deployment, reverse a backup relation, omit a named customer or assign an unstated currency. A blinded 84-call check-placement/wording comparison and a 27-call same-article citation-completion diagnostic did not give a clean semantic fix and are not adopted. The latter missed an omitted connectivity condition and a reversed backup relationship, and left six expected evidence reviews unaddressed. A further five-round Codex–Claude council produced a narrowly scoped Step 1 link candidate, independently checked for prompt-contract drift. A six-article, 36-call blind comparison completed; the candidate still produced an explicitly self-contradictory link and both arms consistently omitted the same Kyber report and company response. It is not adopted and has not changed the active PRD prompt. A trace confirms that both the Kyber report and open Kyber thesis were supplied, and the raw model answers omitted the report and denial; the reason is not established. See ../poc/data/clean-step1-kyber-trace-2026-11-06/TRACE.md. An isolated six-call comparison showed that hiding the Kyber thesis did not recover the report or denial in any draw. A second six-call comparison returned them in 3/3 draws with the original Kyber paragraph alone and 0/3 with the full article; length, position and surrounding content changed together, so the reason is not isolated. Excerpt outputs have source-attribution limitations. Neither experiment changed state or established a production fix. (Superseded: the next task then was a whole-article coverage approach; the current next task is under \\\"One next task\\\".) See ../clean-arch/STEP1-IMPLEMENTATION-COUNCIL.md. The earlier four-round council agreed that no tested semantic fix is ready; its next investigation is a source-backed review of the 49-item historical run and its 160 evidence records, with overlapping issue flags and separate article-level omissions, then a separate comparison of the seven-item replays. See ../clean-arch/STEP1-COUNCIL-REVIEW.md. Preserve relevant evidence while identifying the next intervention; production/frozen history remains as described below. See [Step 1 run log](../clean-arch/STEP1-RUN-LOG.md) and [English reading page](../clean-arch/architecture.html).\\n\\n**Sealed (D379, 2026-11-06):** Alex asked to clean up and seal this version while he re-plans the system design. Work stops here and is sealed as it is: main's working tree is committed on branch `seal/2026-11-06` (tag `sealed-2026-11-06`) and merged into `main` on Alex's word (PR #10); the sealed split and two side experiments are pushed on their own branches (D379). No PRD 11 experiment is open, and the E1 next task below is withdrawn. The next task is Alex's re-planned system design.\\n\\n**E1 diagnosed (2026-11-06, Alex chose E1):** of 57 helpful matters frozen production wrote and then dropped, two readers agree on 17 link misses (4 core), 3 opening misses (1 core) and 24 small matters the standard itself drops; 10 are disputed on the fallback clause and 3 were quote refusals. Opening is not the experiment. The core of the link misses is the model reading a question's period, population or named configuration as a boundary; only 8 of the 13 window draws it dropped were lost to the product. No production change; $0.02 of probes. My recommendation was to fold that narrow change into the next extraction version; withdrawn by the seal (D379). Details: `docs/research/2026-11-06-e1-no-home-drops/README.md`, PRD 11 E1.\\n\\n**Split extraction sealed as a failed experiment (D378, 2026-11-06):** the split (a new-question call, an evidence call and record preparation) was benchmarked against the frozen poc-v108 and failed. Its stop line fired: helpful matters 156, 156, 159 against 166, 170, 162, with about 15% higher cost. One screened revision kept more noise than production. It is sealed in the worktree `hivemind-no-preseed-evidence-review` (tag `split-extraction-failed-sealed-2026-11-06`), and nothing of it is in main. What it taught is written as proposed production experiments in `docs/prd/11-production-experiments-from-split.md`: E1 no-home helpful drops, E2 duplicate questions, E3 ladder checks with D186, E4 judge refusals, E5 D203's revision day, E6 the measurement kit. Each opens only on Alex's word.\\n\\n**Question-catalog limit removed (D377, 2026-11-05):** Alex also directed removal of the separate 150 KB catalog rejection. The research reader in this worktree now has neither the catalog nor evidence byte limit; it retains full scoped questions, historical boundaries, dependencies and evidence. A portable 326,996-byte catalog test returns all 400 new questions and expands evidence both after reading the catalog and directly; the old 150 KB guard fails the same test in a scratch copy. The saved 69-question pilot catalog and all 69 saved evidence expansions match their original content hashes. Details: `docs/research/2026-11-05-catalog-limit/`. The full suite remains pending until the paid seven-day run no longer competes for resources. The run remains in its isolated worktree and does not call this research reader.\\n\\n**Evidence reader limit removed (D376, 2026-11-05):** Alex directed removal of the reader's 1 MB evidence-expansion rejection. In this worktree, `research_context.Reader.expand` now returns the entire evidence payload without that cap, while the catalog's separate limit remained at that checkpoint; D377 subsequently removed it. On the saved pilot ledger, all 69 individual question expansions, the four-question 1,931,225-byte pilot request and the entire 3,454,076-byte catalog produce the exact same content as the pre-change high-limit baseline; the portable oversized-ledger test passes and fails when the old cap is restored in a scratch copy. Details and snapshot-specific measurements are in `docs/research/2026-11-05-reader-limit/`. The seven-day diagnostic runs in `/Users/lchingen/hivemind-no-preseed-evidence-review/poc/data/split-fresh-seven-day-2026-11-05-v2/` with its pinned code; it does not call this research reader. Read its status through its `snapshot.sh`; do not edit its package code while it is live. This change is not an acceptance of seven-day extraction or judgement quality.\\n\\n**Start-state correction (2026-11-05):** Alex requires a research library established from real material available before the test start, then extraction against that state. The prior empty-library diagnostic cannot represent this case. Our own mistakes and the current 68-question provenance audit are in `../hivemind-no-preseed-evidence-review/docs/research/2026-11-05-parallel-refinement/own-mistakes-2026-11-05.zh.md`. Two new A-only calls were run on 2026-08-29 articles using the 68-question prior-day snapshot; both proposed the same aggregate supply-commitments topic. A source/context review judged it distinct from the existing specific SK Hynix question. A third A-only call on an author-body excerpt about DLSS 5, already tracked by v22, passed; the prompt also restricts software updates, so the reason is not established. No writer or dedup ran; source-history completeness remains unverified, and this is not scored acceptance. Details: ../hivemind-no-preseed-evidence-review/docs/research/2026-11-05-parallel-refinement/start-state-diagnostic-2026-11-05.zh.md.\\n\\n**Measurement correction (2026-11-05):** Alex clarified that a gold-worthy topic already in the supplied library should not open again; an absent worthy topic should open. The earlier simple-A claim of a \\\"missed\\\" new topic was not scored against that rule and is withdrawn as a correctness conclusion. In the actual experiment, a Kyber topic was shown and passing follows Alex's topic-level rule; whether its exact release question captures the shipping milestone remains unverified. The experimental pre-article snapshots differ from the replay's day-start snapshots; 9 of 10 inspected examples differ. The current uncommitted replay default does not build a cold-start library; committed main HEAD still uses the old seed and startup filing path. Historical lexical coverage has a confirmed unrelated-topic match. The frozen gold and past scores remain unchanged. Audit: `../hivemind-no-preseed-evidence-review/docs/research/2026-11-05-parallel-refinement/measurement-context-scrub-2026-11-05.zh.md`.\\n\\n**Simple new-question diagnostic (2026-11-05):** At Alex's direction, an isolated prompt returned new questions plus article evidence without asking for product database fields. Four previously seen real dev articles each ran once: three returned one candidate, one returned none, all four quotes matched their source, and the gold-listed GPU backstop amount question was not proposed. Whether that omission is a new-topic miss depends on whether the existing library covers the topic. Two other candidates require source and independent-significance review; the actual experimental snapshot already had a Kyber topic, so its pass follows Alex's topic-level rule; whether its exact release question captures the shipping milestone remains unverified. This is not a production or full-pipeline acceptance. Details: `../hivemind-no-preseed-evidence-review/docs/research/2026-11-05-parallel-refinement/simple-new-question-results.zh.md`.\\n\\n**Split prompt structure v3 read diagnostic (2026-11-05):** One real reading-stage call on a previously seen article found the revenue/margin guidance and Trainium scale but omitted the gold China revenue/market-loss matter. The prewritten stop condition was triggered and the linking call was not sent. This is one draw and not a production or end-to-end result. See `../hivemind-no-preseed-evidence-review/docs/research/2026-11-05-parallel-refinement/structure-v3-read-result.zh.md`. D374 removes the model sampling field from active settings and default configs; historical config files and archives retain their original bytes.\\n\\n**Split prompt structure v2 small test (2026-11-05):** Thirty calls on two previously seen golden-v5 dev articles completed in `../hivemind-no-preseed-evidence-review`. The blind model reader found complete helpful matters in the fresh control versus new A+B of 6/19 vs 10/19, 11/19 vs 7/19, and 9/19 vs 12/19. The new arm also retained more gold not-kept matters in each draw; B missed useful margin guidance and one answer reused IDs, with a demonstrated matching collision. This is not a production acceptance. See `../hivemind-no-preseed-evidence-review/docs/research/2026-11-05-parallel-refinement/structure-v2-results.zh.md` and `reports/2026-11-05-parallel-structure-v2.html`.\\n\\n**Split extraction small test (2026-11-05):** At Alex's request, the isolated `hivemind-no-preseed-evidence-review` worktree ran two real golden-v5 articles once through each split lane. An independent model reader found 7 of 19 helpful gold matters fully retained, two partial, two written then dropped, eight missed, and one retained gold not-kept matter. Three saved v108 draws on these articles retained 7, 9 and 12 of 19, but used 22 seeded questions while the new test used 8/10-question snapshots; these are not directly comparable. The experiment remains unaccepted; see `../hivemind-no-preseed-evidence-review/docs/research/2026-11-05-parallel-refinement/small-scored-test-20261105.md` and `reports/2026-11-05-split-small-test.html`.\\n\\nAs of November 5, 2026; decisions through D374. [Decisions](DECISIONS.md) holds what is decided now; the [design page](system-design.html) and the [module PRDs](prd/README.md) hold what the code must do; the [README](../README.md) holds startup, build and run instructions.\\n\\n## Future evidence scoring (D372)\\n\\nAlex decided future gold scoring should measure helpful versus not helpful evidence without requiring separate scores for core and supporting. Use frozen golden-v5 as-is: combine core and supporting as helpful, treat not-kept as unhelpful, and keep optional entries neutral. A counting report has not yet been implemented. Historical scores retain their original definitions. D373 removes the stop caused by a separate concern about three question-gold entries: keep the gold unchanged, continue scoring and disclose the concern; see `../hivemind-no-preseed-evidence-review/docs/research/2026-11-05-parallel-refinement/ruler-conflict-2026-11-05.zh.md`.\\n\\n## Latest decision (D369)\\n\\nAlex decided in D369 to capture core and supporting evidence without a strict boundary and in D370 to remove the 22 preset starting questions and separate earnings-report import. The replay entry now defaults to `poc-v118` (D374), refuses old seeded ledgers and baseline configurations, and continues to read existing non-seeded questions; earnings releases remain normal source items. This change has local contract tests but has not passed end-to-end product acceptance. The frozen historical rulers and results remain unchanged.\\n\\nThe small 2026-11-05 study used three archived NVDA articles and an 8/28 historical 68-question snapshot: without versus with an appended report, independent AI review found 14/27 versus 13/27 complete matters. This measured appended extraction context, not the distinct former coverage-start step; D370 removes both by Alex's decision. Full traces and limitations are in the separate `hivemind-no-preseed-evidence-review` worktree under `docs/research/2026-11-05-real-input-evidence/existing-library-results-2026-11-05.md`.\\n\\n\\n**One-day smoke completed (2026-11-05 UTC):** Alex requested a quick 1–2 day end-to-end test. One day, 2026-08-29, ran in `/Users/lchingen/hivemind-no-preseed-evidence-review/poc/data/v117-one-day-smoke-2026-11-05/`: config v117, an 8/28 historical library, 40 extraction calls, 93 evidence records written, four new questions, 54 judged and zero terminal failures. Two judgement attempts were refused and corrected. A Microsoft revenue forecast of $391.1bn was assigned to a rung whose upper bound excludes $391.1bn; the same article's actual quarterly revenue and next-quarter guidance were dropped with no home. Some source dates and bodies are not verified, and an independent 14-article sample review was incomplete due to truncated text. This is not semantic or production acceptance. Findings and scope: `docs/research/2026-11-05-real-input-evidence/one-day-v117-smoke-2026-11-05.zh.md` in that worktree. The clean source-text comparison and its condition-hidden review are complete; council discussion of next steps is ongoing.\\n\\n**D371, in progress:** Alex directed that present and forward-looking revenue and financial information should be tracked. Diagnose the same-day extraction and filing losses before designing a general change. No new financial tracking implementation has been accepted yet. The old frozen standard and gold are unchanged. The original prompt-only pilot failed design review. The user approved an exact prompt addition for an experiment; it is not a production implementation. Four paired real-article diagnostic calls per arm completed for the exact approved sentence: v74i versus experimental role-d371-pilot. Microsoft next-quarter guidance and NVIDIA FY2028 guidance still dropped in the treatment; a single draw is not acceptance or proof of causation. Details: docs/research/2026-11-05-real-input-evidence/d371-prompt-pilot-results.zh.md (isolated worktree). The requested full prompt audit and restructure were drafted experimentally; five real-article paired diagnostic requests per arm completed. Microsoft revenue guidance was missed in both arms, and the draft produced unsupported original dates, a quote refusal and suspect links. No production prompt change or acceptance; see restructure-pilot-results.zh.md in the isolated worktree.\\n\\n**Clean Step 1 coverage council (2026-11-06):** Codex and Claude Code independently reviewed the existing attempts and completed three discussion rounds. The proposed next research candidate moves the existing evidence-reading block ahead of the thesis-opening block while preserving the article, open-thesis state and paired output. It is a hypothesis, not an implemented or validated fix. A complete prompt/contract audit and independent review precede any controlled Luna comparison. Historical paragraph-based and source-first experiments, their noise and attribution problems, and the rejected overlap-based merge are recorded in [the council review](../clean-arch/STEP1-COVERAGE-COUNCIL.md). No new Luna experiment was run in the council.\\n\\n**Clean Step 1 coverage order result (2026-11-07):** The isolated 54-call clean comparison completed and all answers were reviewed blind. Moving the evidence-reading block recovered a known Kyber report and denial in one of three candidate answers against none in three controls, with attribution blur; it also produced unsupported gaming-to-AI links in two candidate answers and no controls. It is not adopted. A separate exact-quote example misattributes an executive's prediction in the standalone summary. [Results and replay](../clean-arch/STEP1-COVERAGE-ORDER-RESULTS.md) record all selected cases, uncertainties and source-fidelity work; no production ledger was written.\\n\\n**Clean Step 1 fidelity council (2026-11-07):** Codex and Claude Code completed five rounds on source attribution, conditions, dates and meaning. No tested fix or root cause is established. The agreed source-to-record review of 49 articles / 160 evidence items and the subsequent isolated field-order comparison are complete; the later 54-answer / 217-record repeated sample remains separate. Prior source-first, quote-first and follow-up-review experiments and their limits are recorded in [the fidelity council](../clean-arch/STEP1-FIDELITY-COUNCIL.md). No Luna experiment or production change was made in this council.\\n\\n**Clean Step 1 fidelity review (2026-11-07):** All 49 saved source packets and 160 original evidence items have received a source-and-record review; focused independent cross-checks cover the findings and selected controls. The [review and article replay](../clean-arch/STEP1-FIDELITY-REVIEW.md) distinguish source contamination and missing source material from model meaning, citation, date and link issues. The [isolated schema property-order diagnostic](../clean-arch/STEP1-CITATION-ORDER-RESULTS.md) completed all 66 calls and condition-blinded article reviews. Several omissions and semantic errors persisted; it did not establish a fix and is not adopted. It used saved articles and before-states without changing production.\\n\\n**Clean Step 1 source handoff council (2026-11-07):** The ongoing [council and offline checks](../clean-arch/STEP1-SOURCE-HANDOFF-COUNCIL.md) reconstructed 16 matching article-34 controls, all omitting a Kyber report and denial; the cause remains unknown. The 20-article saved source-role overlap review distinguished previously cited AI-generated summary lines and an unrelated recommendation from authored body. The clean runner does not send the saved source-role labels; the council chose to first compare original and previously selected source text on ten known articles. The isolated 60-call source-text comparison and condition-hidden review are complete; [results](../clean-arch/STEP1-SOURCE-TEXT-RESULTS.md) show specific contamination reductions alongside persistent omissions and changed meaning. It did not advance state or write production. The isolated six-article low-versus-medium source-fidelity diagnostic completed 36/36 calls and condition-hidden review. [Results](../clean-arch/STEP1-REASONING-FIDELITY-RESULTS.md) show partial improvements alongside persistent source-qualification and attribution concerns; no production setting is changed. The [prompt audit](../clean-arch/STEP1-FIDELITY-PROMPT-AUDIT.md) maps the observed failures to the full request and signed standard. The six-article isolated schema-description comparison completed 36/36 calls and condition-hidden review; the candidate did not preserve the repeated example qualification and is not adopted. [Results](../clean-arch/STEP1-SUMMARY-FIDELITY-RESULTS.md). A further six-article 36-call low-versus-medium comparison used corpus-cleaned sources outside the original 49-item clean replay and a fixed exploratory context; results were mixed, including unsupported links and incorrect attribution/date fields. [Results and replay](../clean-arch/STEP1-ADDITIONAL-SOURCES-RESULTS.md). The structured-claims candidate was not sent after review revealed scope and complexity concerns. Council review of the next action is ongoing. The date-text schema-description diagnostic completed 48/48 calls on eight known cases, with mixed results; the candidate is not adopted. A selected-run census found twelve literal \\\"null\\\" strings in date-text fields, but no production writer impact is established. [Results and replay](../clean-arch/STEP1-DATE-DESCRIPTION-RESULTS.md). A further preregistered eight-source date comparison completed 48/48 calls; the candidate lost a supported company-article statement date in all three draws on one source and is not adopted. [Results and replay](../clean-arch/STEP1-DATE-NEW-SOURCES-RESULTS.md). A bounded corpus census confirmed 163 source pages across three explicit generated-summary structures whose labels were removed while some summary text was retained; two NVIDIA cases were reproduced through the cleaner. [Source provenance investigation](../clean-arch/STEP1-SOURCE-PROVENANCE-CENSUS.md). A read-only source-lineage replay reproduced 363/363 cleaned pages with current inputs, preserved ambiguous original-line locations, and surfaced the generated-summary label loss for review. [Source investigation and lineage replay](../clean-arch/STEP1-SOURCE-PROVENANCE-CENSUS.md). An offline neighboring-context observation exposed only 144 or 149 of 163 known labels and introduced many other page lines; it is not adopted as a general source fix. [Observations and viewer](../clean-arch/STEP1-SOURCE-CONTEXT-OBSERVATIONS.md). A new [saved-quote integrity investigation](../clean-arch/STEP1-QUOTE-INTEGRITY-CENSUS.md) reconstructed 360 saved answers across eight overlapping cohorts, including 78 prepared-source calls. Five saved unverified passage instances were complete matches under the existing normalization; an in-memory candidate recovered their original slices, while ten others remained unverified. The normalized source-slice lookup is now installed only in the isolated clean Step 1 runner; saved-answer and entry-point checks are recorded there. Page provenance, Unicode completeness, production resource budgets and writer integration remain open. The existing writer stores only one quote, whereas 63 of 160 evidence items in the 49-article exploratory trace have multiple passages. A [source-first 49-article coverage review](../clean-arch/STEP1-COVERAGE-CENSUS.md) separates material missing from the model input from source-visible omissions in the saved answers, with uncertain matter boundaries labeled. (Superseded: the next investigation then was why supplied material is missed; the current next task is under \\\"One next task\\\".) The canonical prompt and production configuration remain unchanged. Adding fallible role annotations remains a separate untested candidate. Council streams and handoffs are in `poc/data/clean-step1-ongoing-council-2026-11-07/`.\\n\\n## What runs\\n\\n- **Pipeline (replay default `poc/config/poc-v118.json`, D370, D374).** Every item reads the relevant open questions from the library at the start of its day, then extraction v74i on `gpt-6-luna` proposes evidence and questions; Jev matching with the collision judge matches them; code writes the records; judging-v7 judges changes once a day; pull mode closes due questions. There is no separate seed or coverage-start report import, and reports as source items remain eligible. This default has not completed end-to-end acceptance. The [pipeline guide](poc/pipeline-plan.md) maps stages to code.\\n- **Measured:** one company (NVDA) over one 14-day window (2026-07-01 to 07-14), the judgement scored at the window end on the frozen ruler (AGENTS §7.1). Three draws of `poc-v116` against three of `poc-v108` run in the same hours: 53 against 45 agreements of 57; operating margin and capex agree in 3 of 3 draws, never judged without the coverage-start reading ([acceptance](research/2026-11-04-filing-end-to-end/acceptance-design.md)).\\n- **Served data:** the service, the MCP server and the standalone page serve the sealed three-month ledger `served-2026-10-28-v34-nvda-3m-through-0828` (68 theses, 34 groups; D358), built by the earlier `poc-v34` pipeline, not by the replay default. HTTP `/library`, MCP `thesis_library` and the standalone page share the dated bundle writer.\\n- **Idea API:** `poc-v118-idea` (D290, D335, D374): two discovery calls and one adoption and weighting assessment; only adopted theses with positive weights appear, and nonempty plans total 100%. The [Idea contract](poc/idea-card.md) owns its fields and the limits of its scores.\\n- **Interface:** the Thesis Library and Explore Ideas workspaces, with the confidence Trigger and an Action preview (no wallet connection or order execution). The [UI specification](poc/thesis-ui.md) and the [integration guide](../poc/ui/README.md) own its behaviour.\\n- **Repository:** `main` holds the product, the frozen ruler and the research records; run databases, logs and model archives stay on disk (D353), located by the [data manifest](research/2026-10-25-english/data-manifest.md). Worktrees: `/Users/lchingen/hivemind` is the main checkout, where slice branches are cut from `main`; `/Users/lchingen/hivemind-extraction-quality-2026-10-28` (the extraction branch, merged on 2026-11-03) keeps in its ignored folders the stored end-to-end runs of `poc-v91` to `poc-v95` that later comparisons read (D359); `/Users/lchingen/hivemind-run-v109-2026-11-04` is the finished judging-v8 run's worktree. Older branches stay in Git without worktrees (D359); none is merged work in progress. The clean source-text comparison and its condition-hidden review are complete; council discussion of next steps is ongoing.\\n\\n## Open defects\\n\\n1. **Competitor and customer news is filed under the company's revenue questions** instead of the share, capital-spending or custom-chip question it informs (D355; filing is otherwise about 85% right). Share facts are often not written at all, an extraction recall miss. The total-revenue question holds about a quarter of all links (D354).\\n2. **One bet opened twice** about one encounter in five: the collision judge splits a seed question from an identical candidate on a fine detail (D354).\\n3. **A question the standard rules out** (the lidar legislation) was proposed by the extraction and opened in one draw of three (D354).\\n4. **A thesis opened from an article gets no dependency of its own**: the default Jev matching asks for none (`views/jev_matching.py`), although D51 has the matching call choose them; themes still reach every company thesis through the theme block (D191, D195). Found in the 2026-11-05 consolidation; building it is decided (D368).\\n5. **Historical coverage-start reading, retired by D370** (D364–D366): the capital-spending line is missed in about one read in six (the question is then left as it was); a labelled guidance figure is written with the fact tier; later reports reach the questions only through the daily stream; `scripts/preflight.py` does not replay the reading's check.\\n6. **Measured on one company and one 14-day window**, the judgement scored at the window end only; no version of the current pipeline has completed a longer window (a 60-day run of `poc-v108` was stopped at Alex's word after 2026-07-15, [log row 8](research/2026-11-04-argument-record/log.md)). The China-share question (v17) swings between draws (0 of 3 in the acceptance, 2 of 3 in its control, 1 of 3 in the frozen draws): two readers found the starting figures did not cause the acceptance's drop, and the byte-identical extraction request kept a \\\"share fell to zero\\\" sentence in two candidate draws and dropped it in two control draws. One acceptance draw judged nothing on v16; its cause is not established.\\n7. **What a judgement reads grows with the window** (D358). Argument records (D201) were measured as the remedy on 2026-11-04 and not built: judging-v8 agreed 12 of 17 against 15 of 17, judging-v9's card added little at about half again the judging cost; their code was removed at Alex's request ([log rows 4–11](research/2026-11-04-argument-record/log.md)).\\n8. **Seen once, not traced.** A judgement named a shown theme as a dependency and the check refused it twice, stopping a draw for a day (2026-11-02, D266). The sealed run's review recorded that a succession's opening evidence is not linked to the new question (D358), not yet checked against today's code.\\n9. **Earlier defects, unchanged.** Matching (build log row 49): another document's copy of a figure can be treated as new evidence; one matter can occupy several groups; same-answer candidate references caused seven chain or duplication decisions of the generative matcher; empty `original_who` values can count as the same party; different names for one population cause two of nine Jev merge misses. Nine 2026 aggregate-spending theses under `ai-capex` each have a different population; whether to combine them is a product choice. Extraction's instructions remain narrower than the PRD's important-question rule and omit the personal-memo exception, and extraction can change a quantity's meaning before matching (a guarantee amount against financing provided). Classification keeps its [recorded simulation defects](research/2026-10-25-english/classification-existing-defects.txt). The corpus audit recorded 97 official notices with 56 body and file-name collisions, to re-fetch before relying on a rebuilt corpus. An older intermittent search-test failure is untraced. Fresh Idea allocations vary while saved weights do not; the confidence chart applies the current plan to past states and is not a calibrated probability; broad analyst-prose quality and fresh Idea stability remain unaccepted (the [Idea contract](poc/idea-card.md) lists its limits); generative matching dependencies await `matching-v4`. The readers' doubts about the frozen standard, listed in the [extraction branch's state page](research/2026-11-01-e2e-loop/current-state-extraction-branch-2026-11-03.md), remain for Alex.\\n\\nUpstream supply and the human review pool's output remain deferred.\\n\\n## One next task\\n\\n**Clean Step 4 (D396): design version 4 is written; it is not READY and waits for two choices of Alex's**\\n([design](../clean-arch/step4-2026-11-10/DESIGN.md); round log §69).\\n\\n- **Design status:** three review rounds (`gg`, `gl`, `gm`) each found serious points; version 4 answers the last and has not been\\n  reviewed. Its core contract depends on C1 and C2 below.\\n- **What the review of 2026-11-10 found** (council `gh`–`gm`, all on stored data, no paid send):\\n  - Step 4 is the right next step, and inside it the first thing to build and test is the **ladder step alone**: the call that turns a\\n    thesis Step 1 opened into one judged question with its answer ladder and due day. The frozen judge follows only when the ladder\\n    step meets its lines.\\n  - Production's own ladder sentences are not stable: one request, the same in three draws, gave a bullish end at the low amount\\n    twice and at the high amount once, with three different middle bands; the code checks pass all three\\n    (`clean-arch/step4-2026-11-10/census/production_ladders.txt`).\\n  - Of the 34 theses the unseeded draws opened, two blind readers find 12 to 16 that ask more than one thing, 7 to 9 of 18 number\\n    questions with no reference figure in the opening article, and 4 that state a calendar due day.\\n- **The next task:** put to Alex\\n  1. **C1:** a topic that asks more than one thing gets one judged question with the rest shown as not judged (recommended as the\\n     first version), or is split as D38 says, or is not judged;\\n  2. **C2:** whether the ladder step carries D186 (ranges against guidance, the favourable end registered; recommended), its\\n     direction half only, or neither;\\n  then revise the design for his answers, review it with a fresh reviewer each round until one finds nothing serious, audit the\\n  whole ladder request, and ask his word to build the ladder step and run Stage A (the ladder step against a control that quotes v74i, on the 34 stored theses and the 10 fresh ones).\\n- **Open defects recorded by this review:** the frozen judge retried 10, 16 and 18 judgements in the seeded clean draws, 38 of 51\\n  reasons a theme cited as a dependency (PRD 11, E4; frozen, a finding for Alex); the same matter takes different shapes between\\n  draws (Kyber due end-2027 in one draw and end-2028 in another).\\n- **The unseeded measurement (D395):** graded subset 4.0 against 6.33 seeded. Every miss is a question not opened in the ruler's shape.\\n  Judged answers 16 of 16, on the ruler's wording and ladder; the system's own questions have never met a judge.\\n- **Stage 2 of D392:** clean 18, 18, 17 against v108 17, 15, 16, inconclusive on q12.\\n- **Known gap (D394):** capital spending (q12).\\n\\nNo long job is running.\\n## 5. Step 2: find and compare related evidence\\n\\n### Why this is separate\\n\\nAn open thesis may accumulate many evidence records. Step 1 needs to understand the article and the open research; it does not need to read every prior statement to do that. Step 2 uses each proposed `{thesis, evidence}` association to find the history worth comparing.\\n\\n### Find candidate evidence\\n\\nThe proposed design places semantic search over the evidence library. It uses the thesis and incoming evidence to find top-N related evidence across the current entity, including evidence linked to other theses. The thesis is search context, not a restriction to evidence already linked to that thesis. This also applies when the proposed thesis is new. For example, “raised its revenue outlook” and “expects higher sales” can be related despite different wording. Alex chose this entity-wide scope on 2026-11-06.\\n\\nSearch returns **candidates**, not a final decision. Alex discussed a starting point of top 10; the implementation and quality requirements need to be measured.\\n\\nA match outside the returned set will not be considered by the comparison. Search quality therefore matters independently from the model's ability to compare the records it receives.\\n\\n### Compare with Jev\\n\\n**2026-11-08 (candidate, [round log](step1-unfiled-2026-11-08/LOG.md) §§24, 31–35):**\\n- Comparison reads the full passages; the 600-character cut is removed.\\n- An unlinked record also searches by its own text.\\n- `figures` never enter a search or comparison text.\\n- Jev is asked the clean path's own piece question, aligned with line 2's test: a repeat reports the stored piece's main statement, and\\n  an official's denial of a report is a revision.\\n- When a thesis opens, every stored unlinked group from earlier articles is judged against it in batches of ten (a yes/no question; the\\n  company's overall results inform only a revenue or earnings thesis). Each judged pair is recorded once.\\n- On c6's records: search 97.9%, wrong merges 1.9% (2 of 104), both lines met; line 3 not re-measured.\\n\\nJev compares the new evidence with the returned evidence. The intended outcomes are:\\n\\n| Outcome | Meaning | Example |\\n|---|---|---|\\n| Repeat | The new material presents the same statement again. | Another article reports the same company forecast. |\\n| Revision | A later account changes the same statement. | The company revises its forecast from 12% to 25%. |\\n| New evidence | It is not identified as a repeat or revision of the evidence compared. | A different analyst offers a separate forecast. |\\n\\nThe words, amount, speaker, source and time can matter to the comparison. A later statement about the same subject is not necessarily a revision. A matching amount alone does not prove that two statements are the same.\\n\\nThe result “new evidence” is the outcome of the comparison performed; it is not proof that no matching evidence exists elsewhere in the library. When the incoming evidence is judged a repeat of several candidates, it joins only the group Jev judges it most like: the highest same-statement probability, with ties going to the earliest group (Alex, 2026-11-08). A comparison that fails is not saved and is reported.\\n\\n**Repeat handoff:** when Jev identifies a repeat, the comparison must retain the identity of the existing evidence record it was compared against. Step 3 uses that identity to place the incoming record in the existing record's group, adding its source and any missing thesis link. The typed Jev response need not generate the record ID: the caller can associate the choice with the candidate it supplied. The rule for several matching candidates is stated above.\\n\\n**Step 2 acceptance (Alex, 2026-11-08).** Three lines apply:\\n1. For incoming evidence whose earlier version is in the library, search returns it at least 90% of the time.\\n2. At most 2% of merges are clearly wrong.\\n3. Grouped dossiers keep no fewer details added by later reports than no merging does.\\n\\nThe first measurement against these lines is in the [Step 2 log](step2-validation-2026-11-07/LOG.md) §12; the isolated modules are `step2/compare.py` and `step3/library.py`.\\n\\nThe diagram's intended sequence is: use `{thesis, incoming evidence}` to search the evidence library; pass the returned candidates and incoming evidence to Jev; pass the comparison result and the proposed association to Step 3. For a new thesis, search the same entity-wide evidence library. A concrete working draft of the Jev comparison request appears in [section 13](#13-step-2-prompt-jev-working-draft).\\n\\n## 6. Step 3: save evidence and links\\n\\nStep 3 takes the proposals from Step 1 and the comparison outcomes from Step 2 and writes the resulting research information.\\n\\n| Result | What is saved |\\n|---|---|\\n| New thesis with supporting evidence | The new thesis and its evidence link; save new evidence or reuse a matching record according to Step 2. |\\n| New evidence for an existing thesis | The evidence and its link to the thesis. |\\n| Repeat | Place the incoming record in the existing evidence record's group: add its source and any missing link to the relevant thesis, and keep the incoming record's own text and fields inside the group. Do not rewrite the existing record, and do not create a separate evidence record for the same statement. |\\n| Revision | The new evidence and its source, linked to the earlier statement as a revision. |\\n\\nA revision does not erase the earlier statement. On 2026-11-06, Alex chose to keep one evidence record for a repeat and add the new source and any missing thesis link. On 2026-11-08 the Step 2 validation showed that keeping only the earlier text discards details a later report adds, such as a guidance condition; Alex then chose to keep each repeat's own text and source inside the stored record's group, without rewriting the original (\\\"A 继续；跑council loop 开始做\\\"; [Step 2 log](step2-validation-2026-11-07/LOG.md) §7). How a judgement reads a group is being tested. Multiple articles reporting the same statement do not automatically establish independent original sources. The current production writer stores separate repeat records, so this is a change for the clean path and needs implementation and verification; the existing historical records remain available. Step 3 ends when the chosen thesis, evidence and relationships are saved. How they are physically stored and written is a separate implementation decision.\\n\\n\\\"\\\"\\\"Isolated Step 2 for the clean path (PRD §5): search the entity's stored evidence for each {thesis, incoming evidence} association,\\nask Jev how the incoming evidence relates to each candidate, and turn the answers into the outcome Step 3 writes.\\n\\nSearch: one query per association (the thesis question, then the incoming summary and passages) against each group's original record\\n(summary, passages, party, statement date, period), cosine similarity of embeddings, top 10; a record with no association, or one that\\nlists the company's figures (a condition), also gets one entity-wide query of its own text (STEP1-CONDITIONS-DESIGN.md §10.1); the union\\nof the results is compared. The figures never enter a search or comparison text, so a wrongly paired figure cannot change Step 2 (§14);\\nthe comparison reads the full passages (§15). Comparison: Jev's piece question with the production criteria (views/jev_matching), the incoming piece as state, one question\\nper candidate. Outcome: any same_statement makes the record a repeat of the candidate with the highest same_statement probability, ties\\ngoing to the earliest group (Alex, 2026-11-08: only the group it is most like); a supersedes answer on another candidate becomes a\\nrevision link; with no same_statement, supersedes answers make it a revision of those groups; otherwise it is new.\\n\\n`forward` runs articles in order against the library as it stood after the previous article: records of one article never see each\\nother. A failed comparison is refused by the library, reported, and the run continues.\\\"\\\"\\\"\\nimport concurrent.futures\\nimport math\\nimport sys\\nfrom pathlib import Path\\n\\nROOT = Path(__file__).resolve().parents[2]\\nsys.path.insert(0, str(ROOT / 'src'))\\nfrom hivemind.views import jev_matching  # noqa: E402\\n\\nTOP = 10\\n\\n\\ndef stated(record):\\n    return record['statement_date'] or record.get('statement_date_text') or 'unknown'\\n\\n\\ndef doc_text(record):\\n    return '\\\\n'.join([record['summary'], ' '.join(record['passages']), f\\\"party: {record['original_party'] or 'unknown'}\\\",\\n                      f\\\"stated: {stated(record)}\\\", f\\\"period: {record['evidence_period'] or 'unknown'}\\\"])\\n\\n\\ndef query_text(record, thesis_question):\\n    return f\\\"thesis: {thesis_question}\\\\n{record['summary']}\\\\n{' '.join(record['passages'])}\\\"\\n\\n\\ndef piece_text(record, label):\\n    return (f\\\"{label} [{record['tier']}; {record['reporting_speaker']}; original source {record['original_party']}, stated \\\"\\n            f\\\"{stated(record)}] {record['summary']} | quote: {' '.join(record['passages'])}\\\")\\n\\n\\ndef query_vectors(vectors, record, thesis_questions):\\n    \\\"\\\"\\\"The search queries of one record, in order: one per thesis association, then its own text when it has no association or lists\\n    the company's figures.\\\"\\\"\\\"\\n    queries = [vectors[query_text(record, thesis_questions[t])] for t in record['thesis_ids']]\\n    if not record['thesis_ids'] or record.get('figures'):\\n        queries.append(vectors[doc_text(record)])\\n    return queries\\n\\n\\n# Jev's piece criteria aligned with the Step 2 merge line's own test (PRD §5 line 2; AGENTS §7.1, one ruler): a repeat is a later report\\n# of the stored piece's main statement. Production's wording (views/jev_matching.PIECES) judged \\\"the same evidence\\\", so a later report of\\n# only a secondary statement inside a stored record (an official's denial carried in the report it denies) was merged as a repeat.\\nPIECES = {'same_statement': \\\"the INCOMING PIECE reports the STORED PIECE's main statement: a retelling, another outlet carrying it, the \\\"\\n                            \\\"same number in text or a table, or the same speaker repeating it; wording, precision and extra detail may \\\"\\n                            \\\"differ. If the stored piece carries several statements and the incoming piece reports only a secondary one, \\\"\\n                            \\\"this is not it\\\",\\n          'supersedes': \\\"a later version of the stored piece's main statement, changed: the same speaker revises that guidance, \\\"\\n                        \\\"forecast or event-progress statement, an official confirms or denies that reported claim, or the original \\\"\\n                        \\\"source revises it; another statement on the same topic is not this\\\",\\n          'different': \\\"a different fact, figure or matter, a figure for another period or quantity, or only a secondary statement of \\\"\\n                       \\\"the stored piece, even if on the same topic\\\"}\\n\\n\\ndef piece_question(text):\\n    return {'type': 'choice', 'criteria': PIECES,\\n            'instructions': 'How does the INCOMING PIECE relate to the STORED PIECE below? Use only the supplied text. STORED PIECE:\\\\n' + text}\\n\\n\\nINFORMS = {'true': \\\"the STORED PIECE bears on the THESIS's own matter (the parties, products, policy or quantity the THESIS names) and \\\"\\n                   \\\"makes its answer more or less likely, as evidence filed under it would\\\",\\n           'false': \\\"the STORED PIECE concerns another matter, or is a company-wide result or event that does not speak to the THESIS's \\\"\\n                    \\\"own matter, or would not change its answer\\\"}\\n\\n\\ndef informs_question(text):\\n    return {'type': 'noul', 'criteria': INFORMS,\\n            'instructions': 'Does the STORED PIECE below inform the THESIS stated above? Use only the supplied text; a shared company, '\\n                            'product family or word is not enough, and the company\\\\'s overall results, guidance and estimates inform a '\\n                            'thesis about its revenue or earnings path, not one about a competitor, a supplier or a policy unless they '\\n                            'speak to it. STORED PIECE:\\\\n' + text}\\n\\n\\ndef later_link_judge(library, thesis_question, ask):\\n    \\\"\\\"\\\"The judge `Library.link_later` calls: one Jev request per batch, the thesis as state, one yes/no question per stored group.\\\"\\\"\\\"\\n    def judge(group_ids):\\n        questions = {f'q{i}': informs_question(piece_text(library.groups[g]['original'], 'STORED PIECE')) for i, g in enumerate(group_ids)}\\n        raw = ask(f'THESIS: {thesis_question}', questions)\\n        return {g: raw[f'q{i}']['noul'] >= jev_matching.THRESHOLD for i, g in enumerate(group_ids)}\\n    return judge\\n\\n\\ndef cosine(a, b):\\n    return sum(x * y for x, y in zip(a, b)) / (math.sqrt(sum(x * x for x in a)) * math.sqrt(sum(y * y for y in b)) or 1)\\n\\n\\ndef search(library, vectors, record, thesis_questions):\\n    \\\"\\\"\\\"Candidate group ids: each query's top 10 by cosine against the groups' original records, merged in rank order.\\\"\\\"\\\"\\n    candidates = []\\n    for query in query_vectors(vectors, record, thesis_questions):\\n        ranked = sorted(library.order, key=lambda g: -cosine(query, vectors[doc_text(library.groups[g]['original'])]))[:TOP]\\n        candidates += [g for g in ranked if g not in candidates]\\n    return candidates\\n\\n\\ndef outcome(answers, order):\\n    \\\"\\\"\\\"answers: {group id: {'choice', 'probabilities'}}; order: group ids in creation order.\\\"\\\"\\\"\\n    same = [g for g, a in answers.items() if a['choice'] == 'same_statement']\\n    later = [g for g, a in answers.items() if a['choice'] == 'supersedes']\\n    if same:\\n        best = max(same, key=lambda g: (answers[g]['probabilities']['same_statement'], -order.index(g)))\\n        return {'kind': 'repeat', 'repeat_of': [best], 'revises': later}\\n    if later:\\n        return {'kind': 'revision', 'revises': later}\\n    return {'kind': 'new'}\\n\\n\\ndef forward(articles, library, vectors, thesis_questions, ask, workers=8, opened=None):\\n    \\\"\\\"\\\"articles: lists of Step 3 records in article order. ask(state, questions) returns Jev's answers by question id, or raises.\\n    opened: per article, the thesis ids it opened; after the article's records are written, each is linked later to the stored groups\\n    that arrived unlinked from earlier articles (`Library.link_later`). A thesis written to with pairs still pending is judged again,\\n    against its opening boundary. Returns one decision per record.\\\"\\\"\\\"\\n    decisions = []\\n    for index, records in enumerate(articles):\\n        def decide(record):\\n            candidates = search(library, vectors, record, thesis_questions)\\n            if not candidates:\\n                return record, candidates, {}, {'kind': 'new'}\\n            questions = {f'q{i}': piece_question(piece_text(library.groups[g]['original'], 'STORED PIECE'))\\n                         for i, g in enumerate(candidates)}\\n            incoming = piece_text(record, 'INCOMING PIECE')\\n            try:\\n                raw = ask(incoming, questions)\\n            except Exception as first:   # retried once; a second failure is reported, never silently saved as new\\n                try:\\n                    raw = ask(incoming, questions)\\n                except Exception as error:\\n                    return record, candidates, {}, {'kind': 'failed', 'reason': f'{type(first).__name__}: {first}; retry: {type(error).__name__}: {error}'}\\n            answers = {g: {'choice': raw[f'q{i}']['choice'], 'probabilities': raw[f'q{i}']['probabilities']} for i, g in enumerate(candidates)}\\n            return record, candidates, answers, outcome(answers, library.order)\\n        with concurrent.futures.ThreadPoolExecutor(max_workers=workers) as pool:\\n            results = list(pool.map(decide, records))\\n        for record, candidates, answers, result in results:\\n            entry = {'id': record['id'], 'candidates': candidates, 'answers': answers, 'outcome': result}\\n            try:\\n                entry['group'] = library.apply(record, result)\\n            except Exception as error:\\n                entry['refused'] = f'{type(error).__name__}: {error}'\\n            decisions.append(entry)\\n        article = records[0]['article'] if records else None\\n        if article is None:\\n            continue\\n        written = {t for r in records for t in r['thesis_ids']}\\n        retry = [t for t in written if t in library.pending and t not in (opened[index] if opened else [])]\\n        for thesis_id in list(opened[index] if opened else []) + retry:   # opened here, or written to with pairs still pending\\n            result = library.link_later(thesis_id, later_link_judge(library, thesis_questions[thesis_id], ask), article)\\n            library.later_log.append({'thesis': thesis_id, 'article': article, **result})\\n    return decisions\\n\\\"\\\"\\\"Isolated Step 3 evidence library for the clean path (PRD §6): an in-memory logical store and its dossier text, not the live writer.\\n\\nA group is one stored statement. Its original record keeps its id and fields unchanged and gives the group its id. A later record that\\nStep 2 judged a repeat joins the group as a member and keeps its own id, text, fields and source article. Thesis links belong to the\\ngroup and remember the record that brought each one. A revision is its own group, linked to every group it revises; a repeat that also\\nrevises another group adds that link to its own group, naming the member that established it.\\n\\nThe writer refuses rather than guesses: a failed comparison, several repeat targets, an unknown group, or a replayed record whose\\nplacement differs from the first time raise `Refused` and write nothing. Physical storage and crash recovery are not provided here.\\n\\nLater linking (Alex, 2026-11-08: a material statement no thesis takes is kept and linked when a related thesis opens; design\\nSTEP1-CONDITIONS-DESIGN.md §§11.1, 17): when a thesis opens, every group whose original arrived with no link, from an earlier article,\\nis judged against it in batches. Each judged (thesis, group) pair is recorded once in `judged`; a batch that fails twice stays pending,\\nis reported, and is judged again on the next write to that thesis, against the same opening boundary (`opened_at`).\\\"\\\"\\\"\\nimport copy\\n\\nRECORD_FIELDS = ('id', 'article', 'publisher', 'publication_date', 'summary', 'passages', 'original_party', 'reporting_speaker', 'tier',\\n                 'statement_date', 'evidence_period', 'thesis_ids')\\n\\n\\nclass Refused(Exception):\\n    \\\"\\\"\\\"A Step 2 outcome the library will not write; nothing was changed.\\\"\\\"\\\"\\n\\n\\nclass Library:\\n    def __init__(self):\\n        self.groups = {}       # group id → {'original': record, 'members': [record], 'links': {thesis id: record id}, 'revises': [{'group', 'by'}]}\\n        self.placement = {}    # record id → group id\\n        self.order = []        # group ids in the order they were created\\n        self.judged = {}       # (thesis id, group id) → True | False, the later-linking ledger\\n        self.later_log = []    # one entry per later-linking call: thesis, article, linked, pending, judged\\n        self.opened_at = {}    # thesis id → the article that opened it: the boundary of its later linking\\n        self.pending = {}      # thesis id → group ids whose judgement failed twice and waits for the next write to the thesis\\n\\n    def apply(self, record, outcome):\\n        \\\"\\\"\\\"Write one record with its Step 2 outcome: {'kind': 'new' | 'repeat' | 'revision' | 'failed', 'repeat_of': [group ids],\\n        'revises': [group ids], 'reason': text}. Returns the id of the group that holds the record.\\\"\\\"\\\"\\n        missing = [f for f in RECORD_FIELDS if f not in record]\\n        if missing:\\n            raise Refused(f'record lacks {missing}')\\n        kind, repeat_of, revises = outcome['kind'], list(outcome.get('repeat_of') or []), list(outcome.get('revises') or [])\\n        if kind == 'failed':\\n            raise Refused(f\\\"comparison failed for {record['id']}: {outcome.get('reason', 'no reason given')}\\\")\\n        if kind not in ('new', 'repeat', 'revision'):\\n            raise Refused(f'unknown outcome {kind!r}')\\n        if (kind == 'repeat') != bool(repeat_of) or len(repeat_of) > 1:\\n            raise Refused(f\\\"a repeat names exactly one group; got {repeat_of} for outcome {kind}\\\")\\n        if kind == 'revision' and not revises:\\n            raise Refused('a revision names the group it revises')\\n        for group_id in repeat_of + revises:\\n            if group_id not in self.groups:\\n                raise Refused(f'unknown group {group_id}')\\n        target = repeat_of[0] if repeat_of else record['id']\\n        if record['id'] in self.placement:\\n            if self.placement[record['id']] != target:\\n                raise Refused(f\\\"{record['id']} was placed in {self.placement[record['id']]}, not {target}\\\")\\n            group = self.groups[target]\\n            stored = next(r for r in [group['original']] + group['members'] if r['id'] == record['id'])\\n            if {k: v for k, v in stored.items() if k != 'thesis_ids'} != {k: v for k, v in record.items() if k != 'thesis_ids'}:\\n                raise Refused(f\\\"{record['id']} names a stored record with different content; a changed record needs a new id\\\")\\n            self._link(group, record)\\n            return target\\n        if kind == 'repeat':\\n            group = self.groups[target]\\n            group['members'].append(copy.deepcopy(record))\\n        else:\\n            group = {'original': copy.deepcopy(record), 'members': [], 'links': {}, 'revises': []}\\n            self.groups[target] = group\\n            self.order.append(target)\\n        self.placement[record['id']] = target\\n        self._link(group, record)\\n        for revised in revises:\\n            if revised != target and not any(r['group'] == revised for r in group['revises']):\\n                group['revises'].append({'group': revised, 'by': record['id']})\\n        return target\\n\\n    def link_later(self, thesis_id, judge, before_article, batch=10):\\n        \\\"\\\"\\\"Judge every group whose original arrived unlinked from an article before `before_article` against a newly opened thesis.\\n        judge(group ids) returns {group id: True | False} or raises. Returns {'linked': [...], 'pending': [...], 'judged': n}.\\\"\\\"\\\"\\n        self.opened_at.setdefault(thesis_id, before_article)\\n        before_article = self.opened_at[thesis_id]\\n        todo = [g for g in self.order if not self.groups[g]['original']['thesis_ids']\\n                and self.groups[g]['original']['article'] < before_article and (thesis_id, g) not in self.judged]\\n        linked, pending = [], []\\n        for start in range(0, len(todo), batch):\\n            ids = todo[start:start + batch]\\n            answers = None\\n            for _attempt in range(2):\\n                try:\\n                    answers = judge(ids)\\n                    break\\n                except Exception:   # tried twice, then reported as pending, never saved as a judgement\\n                    answers = None\\n            if answers is None:\\n                pending += ids\\n                continue\\n            for group_id in ids:\\n                self.judged[(thesis_id, group_id)] = bool(answers[group_id])\\n                if answers[group_id]:\\n                    self.groups[group_id]['links'].setdefault(thesis_id, self.groups[group_id]['original']['id'])\\n                    linked.append(group_id)\\n        if pending:\\n            self.pending[thesis_id] = pending\\n        else:\\n            self.pending.pop(thesis_id, None)\\n        return {'linked': linked, 'pending': pending, 'judged': len(todo) - len(pending)}\\n\\n    @staticmethod\\n    def _link(group, record):\\n        for thesis_id in record['thesis_ids']:\\n            group['links'].setdefault(thesis_id, record['id'])\\n\\n    @staticmethod\\n    def articles(group):\\n        \\\"\\\"\\\"Distinct source articles of a group, oldest first; two records from one article count once.\\\"\\\"\\\"\\n        seen = []\\n        for record in [group['original']] + group['members']:\\n            if record['article'] not in seen:\\n                seen.append(record['article'])\\n        return seen\\n\\n    def dossier(self, thesis_id):\\n        \\\"\\\"\\\"Group ids linked to a thesis, in creation order.\\\"\\\"\\\"\\n        return [g for g in self.order if thesis_id in self.groups[g]['links']]\\n\\n\\ndef labelled_passages(record):\\n    \\\"\\\"\\\"Each passage as a reader sees it: the source text Step 1 found, labelled 'Quote', or, when Step 1 did not find it (verified\\n    value None), the model's text labelled 'Unverified quote'. The model's own text stays in the record's `passages`. A record stored\\n    before verification was carried shows its passages as 'Quote'.\\\"\\\"\\\"\\n    verified = record.get('verified_passages') or record['passages']\\n    return [('Quote', found) if found is not None else ('Unverified quote', passage) for passage, found in zip(record['passages'], verified)]\\n\\n\\ndef record_text(record, label):\\n    attribution = record['original_party'] or 'unknown party'\\n    if record['reporting_speaker'] and record['reporting_speaker'] != record['original_party']:\\n        attribution += f\\\", reported by {record['reporting_speaker']}\\\"\\n    head = (f\\\"[{label}] {record['publication_date']} · {record['publisher'] or 'unknown publisher'} · {attribution} · tier {record['tier']}\\\"\\n            f\\\" · stated {record['statement_date'] or 'unknown'} · period {record['evidence_period'] or 'unknown'}\\\")\\n    quotes = '\\\\n'.join(f'  {label_of}: \\\"{p}\\\"' for label_of, p in labelled_passages(record))\\n    return f\\\"{head}\\\\n  {record['summary']}\\\\n{quotes}\\\"\\n\\n\\ndef group_text(library, group_id, label, labels, member_text=True, notes=()):\\n    \\\"\\\"\\\"A group as a reader sees it: the original record, then each later report of the same statement in arrival order, with its own\\n    text when `member_text` is set and as a source line otherwise. Distinct articles are counted; repeats are not called confirmation.\\\"\\\"\\\"\\n    group = library.groups[group_id]\\n    lines = [record_text(group['original'], label)]\\n    if group['members']:\\n        articles = library.articles(group)\\n        publishers = {r['publisher'] for r in [group['original']] + group['members']}\\n        lines.append(f'  Later reports of the same statement: {len(group[\\\"members\\\"])} records from {len(articles) - 1} further articles '\\n                     f'({len(publishers)} publishers in all). Articles repeating a statement do not by themselves confirm it independently.')\\n        for member in group['members']:\\n            if member_text:\\n                party = '' if member['original_party'] == group['original']['original_party'] else f\\\" · {member['original_party']}\\\"\\n                quotes = ' '.join(f'\\\"{p}\\\"' if kind == 'Quote' else f'\\\"{p}\\\" (unverified)' for kind, p in labelled_passages(member))\\n                lines.append(f\\\"    - {member['publication_date']} · {member['publisher']}{party}: {member['summary']}\\\\n      Quote: {quotes}\\\")\\n            else:\\n                lines.append(f\\\"    - {member['publication_date']} · {member['publisher']}\\\")\\n    for revised in group['revises']:\\n        lines.append(f\\\"  Revises [{labels[revised['group']]}].\\\" if revised['group'] in labels else '  Revises an entry outside this dossier.')\\n    lines += [f'  {note}' for note in notes]\\n    return '\\\\n'.join(lines)\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n./reports/step2-jev-decision-council-2026-11-09/codex-independent.jsonl:22:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_10\",\"type\":\"command_execution\",\"command\":\"/opt/homebrew/bin/zsh -lc \\\"cat clean-arch/step2/compare.py; sed -n '1,150p' docs/CURRENT_STATE.md\\\"\",\"aggregated_output\":\"\\\"\\\"\\\"Isolated Step 2 for the clean path (PRD §5): search the entity's stored evidence for each {thesis, incoming evidence} association,\\nask Jev how the incoming evidence relates to each candidate, and turn the answers into the outcome Step 3 writes.\\n\\nSearch: one query per association (the thesis question, then the incoming summary and passages) against each group's original record\\n(summary, passages, party, statement date, period), cosine similarity of embeddings, top 10; a record with no association, or one that\\nlists the company's figures (a condition), also gets one entity-wide query of its own text (STEP1-CONDITIONS-DESIGN.md §10.1); the union\\nof the results is compared. The figures never enter a search or comparison text, so a wrongly paired figure cannot change Step 2 (§14);\\nthe comparison reads the full passages (§15). Comparison: Jev's piece question with the production criteria (views/jev_matching), the incoming piece as state, one question\\nper candidate. Outcome: any same_statement makes the record a repeat of the candidate with the highest same_statement probability, ties\\ngoing to the earliest group (Alex, 2026-11-08: only the group it is most like); a supersedes answer on another candidate becomes a\\nrevision link; with no same_statement, supersedes answers make it a revision of those groups; otherwise it is new.\\n\\n`forward` runs articles in order against the library as it stood after the previous article: records of one article never see each\\nother. A failed comparison is refused by the library, reported, and the run continues.\\\"\\\"\\\"\\nimport concurrent.futures\\nimport math\\nimport sys\\nfrom pathlib import Path\\n\\nROOT = Path(__file__).resolve().parents[2]\\nsys.path.insert(0, str(ROOT / 'src'))\\nfrom hivemind.views import jev_matching  # noqa: E402\\n\\nTOP = 10\\n\\n\\ndef stated(record):\\n    return record['statement_date'] or record.get('statement_date_text') or 'unknown'\\n\\n\\ndef doc_text(record):\\n    return '\\\\n'.join([record['summary'], ' '.join(record['passages']), f\\\"party: {record['original_party'] or 'unknown'}\\\",\\n                      f\\\"stated: {stated(record)}\\\", f\\\"period: {record['evidence_period'] or 'unknown'}\\\"])\\n\\n\\ndef query_text(record, thesis_question):\\n    return f\\\"thesis: {thesis_question}\\\\n{record['summary']}\\\\n{' '.join(record['passages'])}\\\"\\n\\n\\ndef piece_text(record, label):\\n    return (f\\\"{label} [{record['tier']}; {record['reporting_speaker']}; original source {record['original_party']}, stated \\\"\\n            f\\\"{stated(record)}] {record['summary']} | quote: {' '.join(record['passages'])}\\\")\\n\\n\\ndef query_vectors(vectors, record, thesis_questions):\\n    \\\"\\\"\\\"The search queries of one record, in order: one per thesis association, then its own text when it has no association or lists\\n    the company's figures.\\\"\\\"\\\"\\n    queries = [vectors[query_text(record, thesis_questions[t])] for t in record['thesis_ids']]\\n    if not record['thesis_ids'] or record.get('figures'):\\n        queries.append(vectors[doc_text(record)])\\n    return queries\\n\\n\\n# Jev's piece criteria aligned with the Step 2 merge line's own test (PRD §5 line 2; AGENTS §7.1, one ruler): a repeat is a later report\\n# of the stored piece's main statement. Production's wording (views/jev_matching.PIECES) judged \\\"the same evidence\\\", so a later report of\\n# only a secondary statement inside a stored record (an official's denial carried in the report it denies) was merged as a repeat.\\nPIECES = {'same_statement': \\\"the INCOMING PIECE reports the STORED PIECE's main statement: a retelling, another outlet carrying it, the \\\"\\n                            \\\"same number in text or a table, or the same speaker repeating it; wording, precision and extra detail may \\\"\\n                            \\\"differ. If the stored piece carries several statements and the incoming piece reports only a secondary one, \\\"\\n                            \\\"this is not it\\\",\\n          'supersedes': \\\"a later version of the stored piece's main statement, changed: the same speaker revises that guidance, \\\"\\n                        \\\"forecast or event-progress statement, an official confirms or denies that reported claim, or the original \\\"\\n                        \\\"source revises it; another statement on the same topic is not this\\\",\\n          'different': \\\"a different fact, figure or matter, a figure for another period or quantity, or only a secondary statement of \\\"\\n                       \\\"the stored piece, even if on the same topic\\\"}\\n\\n\\ndef piece_question(text):\\n    return {'type': 'choice', 'criteria': PIECES,\\n            'instructions': 'How does the INCOMING PIECE relate to the STORED PIECE below? Use only the supplied text. STORED PIECE:\\\\n' + text}\\n\\n\\nINFORMS = {'true': \\\"the STORED PIECE bears on the THESIS's own matter (the parties, products, policy or quantity the THESIS names) and \\\"\\n                   \\\"makes its answer more or less likely, as evidence filed under it would\\\",\\n           'false': \\\"the STORED PIECE concerns another matter, or is a company-wide result or event that does not speak to the THESIS's \\\"\\n                    \\\"own matter, or would not change its answer\\\"}\\n\\n\\ndef informs_question(text):\\n    return {'type': 'noul', 'criteria': INFORMS,\\n            'instructions': 'Does the STORED PIECE below inform the THESIS stated above? Use only the supplied text; a shared company, '\\n                            'product family or word is not enough, and the company\\\\'s overall results, guidance and estimates inform a '\\n                            'thesis about its revenue or earnings path, not one about a competitor, a supplier or a policy unless they '\\n                            'speak to it. STORED PIECE:\\\\n' + text}\\n\\n\\ndef later_link_judge(library, thesis_question, ask):\\n    \\\"\\\"\\\"The judge `Library.link_later` calls: one Jev request per batch, the thesis as state, one yes/no question per stored group.\\\"\\\"\\\"\\n    def judge(group_ids):\\n        questions = {f'q{i}': informs_question(piece_text(library.groups[g]['original'], 'STORED PIECE')) for i, g in enumerate(group_ids)}\\n        raw = ask(f'THESIS: {thesis_question}', questions)\\n        return {g: raw[f'q{i}']['noul'] >= jev_matching.THRESHOLD for i, g in enumerate(group_ids)}\\n    return judge\\n\\n\\ndef cosine(a, b):\\n    return sum(x * y for x, y in zip(a, b)) / (math.sqrt(sum(x * x for x in a)) * math.sqrt(sum(y * y for y in b)) or 1)\\n\\n\\ndef search(library, vectors, record, thesis_questions):\\n    \\\"\\\"\\\"Candidate group ids: each query's top 10 by cosine against the groups' original records, merged in rank order.\\\"\\\"\\\"\\n    candidates = []\\n    for query in query_vectors(vectors, record, thesis_questions):\\n        ranked = sorted(library.order, key=lambda g: -cosine(query, vectors[doc_text(library.groups[g]['original'])]))[:TOP]\\n        candidates += [g for g in ranked if g not in candidates]\\n    return candidates\\n\\n\\ndef outcome(answers, order):\\n    \\\"\\\"\\\"answers: {group id: {'choice', 'probabilities'}}; order: group ids in creation order.\\\"\\\"\\\"\\n    same = [g for g, a in answers.items() if a['choice'] == 'same_statement']\\n    later = [g for g, a in answers.items() if a['choice'] == 'supersedes']\\n    if same:\\n        best = max(same, key=lambda g: (answers[g]['probabilities']['same_statement'], -order.index(g)))\\n        return {'kind': 'repeat', 'repeat_of': [best], 'revises': later}\\n    if later:\\n        return {'kind': 'revision', 'revises': later}\\n    return {'kind': 'new'}\\n\\n\\ndef forward(articles, library, vectors, thesis_questions, ask, workers=8, opened=None):\\n    \\\"\\\"\\\"articles: lists of Step 3 records in article order. ask(state, questions) returns Jev's answers by question id, or raises.\\n    opened: per article, the thesis ids it opened; after the article's records are written, each is linked later to the stored groups\\n    that arrived unlinked from earlier articles (`Library.link_later`). A thesis written to with pairs still pending is judged again,\\n    against its opening boundary. Returns one decision per record.\\\"\\\"\\\"\\n    decisions = []\\n    for index, records in enumerate(articles):\\n        def decide(record):\\n            candidates = search(library, vectors, record, thesis_questions)\\n            if not candidates:\\n                return record, candidates, {}, {'kind': 'new'}\\n            questions = {f'q{i}': piece_question(piece_text(library.groups[g]['original'], 'STORED PIECE'))\\n                         for i, g in enumerate(candidates)}\\n            incoming = piece_text(record, 'INCOMING PIECE')\\n            try:\\n                raw = ask(incoming, questions)\\n            except Exception as first:   # retried once; a second failure is reported, never silently saved as new\\n                try:\\n                    raw = ask(incoming, questions)\\n                except Exception as error:\\n                    return record, candidates, {}, {'kind': 'failed', 'reason': f'{type(first).__name__}: {first}; retry: {type(error).__name__}: {error}'}\\n            answers = {g: {'choice': raw[f'q{i}']['choice'], 'probabilities': raw[f'q{i}']['probabilities']} for i, g in enumerate(candidates)}\\n            return record, candidates, answers, outcome(answers, library.order)\\n        with concurrent.futures.ThreadPoolExecutor(max_workers=workers) as pool:\\n            results = list(pool.map(decide, records))\\n        for record, candidates, answers, result in results:\\n            entry = {'id': record['id'], 'candidates': candidates, 'answers': answers, 'outcome': result}\\n            try:\\n                entry['group'] = library.apply(record, result)\\n            except Exception as error:\\n                entry['refused'] = f'{type(error).__name__}: {error}'\\n            decisions.append(entry)\\n        article = records[0]['article'] if records else None\\n        if article is None:\\n            continue\\n        written = {t for r in records for t in r['thesis_ids']}\\n        retry = [t for t in written if t in library.pending and t not in (opened[index] if opened else [])]\\n        for thesis_id in list(opened[index] if opened else []) + retry:   # opened here, or written to with pairs still pending\\n            result = library.link_later(thesis_id, later_link_judge(library, thesis_questions[thesis_id], ask), article)\\n            library.later_log.append({'thesis': thesis_id, 'article': article, **result})\\n    return decisions\\n# Current state\\n\\n**Clean Steps 1–3, current (2026-11-09).** Record: [round log](../clean-arch/step1-unfiled-2026-11-08/LOG.md) §§16–47.\\n- **Step 1 configuration: c8, adopted by Alex (D387).** It runs DeepSeek Flash at high effort, with a 64,000-token output cap; a\\n  format failure or a cut answer is resent once (D380). It carries Alex's decisions D382–D385:\\n  - figures are conditions;\\n  - material statements with no thesis are kept without links;\\n  - only big matters open a thesis;\\n  - no target prices.\\n\\n  [PRD §12](../clean-arch/PRD.md) holds its system prompt, closing check and schema; a run with no candidate files sends exactly the\\n  accepted request.\\n- **Acceptance (D386, [protocol](../clean-arch/step1-unfiled-2026-11-08/ACCEPTANCE-PROTOCOL.md)).** 50 fresh articles that no run,\\n  old or new, had used: news from 2026-09-05 to 09-07, a holiday weekend with no NVIDIA posts. One draw; two readers and a third on\\n  disputes.\\n  - helpful 132/139 (core 83/83);\\n  - wrongly opened theses 1 of 10;\\n  - search 141/143 available repeat pairs, or 141/145 for the whole system (one 11-article story supplies 55 pairs, and revisions are\\n    barely exercised);\\n  - clear wrong merges 1/57, plus 2 overlaps;\\n  - detail retention 22 = 22. This is a storage comparison: every record keeps its own text. It is not a usability test.\\n\\n  Dev ×3 on the frozen golden-v5 (a lead): helpful 214, 211 and 212 of 234; search 98.9–100%; clear wrong merges about 1%. Step 1\\n  cost for the fresh set plus dev ×3: $4.20 at published rates.\\n- **Steps 2 and 3** are built in isolation (`clean-arch/step2`, `clean-arch/step3`): search, comparison, grouping and later linking.\\n  They are not integrated with production storage. **Step 4 (judging) is not built** on the clean path, so nothing yet shows the clean\\n  system can judge an investment view.\\n- **Open defects, by product impact** (reflection council, `council/av-codex.md`):\\n  1. **The Ohio-guarantee yes/no question is never covered** in the three dev draws; a broader credit-support amount thesis opens\\n     instead. Diagnosed (round log §48): the model folds the unsigned guarantee into the open aggregate thesis because the request\\n     uses \\\"covers\\\" both for \\\"is evidence for\\\" and for \\\"already asks this question\\\". The same clause sits under link clutter.\\n  2. **A revenue-share thesis was opened** (Vera Rubin's share of data-center revenue), the class-A boundary of D382.\\n  3. **Link clutter.** A blind recheck of the 34 disputed fresh links found 19 weak and 2 wrong; 10 accepted links mixed in as controls were all useful; the other 49 links were not rechecked.\\n     The model's own account names topic or theme overlap and inference chains, and c8's closing check never reads back a link. This is\\n     a likely cause, with no fix proven. Alex approved designing a protected link check through the council; a first draft was stopped\\n     because it would drop founding premises and contrary facts.\\n  4. **Unverified passages:** 3 of 188 fresh records and 1–3 per dev draw. The mark now travels into Step 2's records, and a reader sees the found source text or an \\\"Unverified quote\\\" label. Jev's comparison input still carries the model's text without the mark; changing it changes measured Step 2 behaviour and needs its own measurement.\\n  5. **The lidar policy thesis** recurs at the boundary (one dev draw in three).\\n- **History.** These earlier states are superseded:\\n  - the 2026-11-07 takeover (K5 → K6b; [takeover log](../clean-arch/takeover-2026-11-07/LOG.md));\\n  - the 2026-11-08 close-out (K6b test 32/42; Step 2 first lines; [Step 2 log](../clean-arch/step2-validation-2026-11-07/LOG.md) §12);\\n  - the unfiled fix round and the c1–c7 arms (round log §§1–39).\\n- **No run is live.** The branch is committed through the D388 line (round log §§48–59).\\n\\n**Clean Step 1 source investigation (2026-11-07):** A [source-loss census](../clean-arch/STEP1-SOURCE-LOSS-CENSUS.md) traces two separate losses in the historical cleaner and records reproducible corpus observations. Offline candidate comparisons expose both recovered content and source-identity or contamination risks. A subsequent [full-page diagnostic](../clean-arch/STEP1-FULL-PAGE-RESULTS.md) completed 102 calls on 17 selected articles and independent source-backed review. It exposes examples of both missing or misattributed source text and model errors that persist despite the right text being present. A Codex–Claude council is reviewing the results and earlier attempts; no source-cleaning candidate is adopted, and the source corpus and production defaults are unchanged.\\n\\nAlex has authorized correcting the test-source cleaner and test data when their defects are confirmed, while the frozen production configuration and ruler remain intact. The cleaner switched 615 originally fed articles off; a replay reproduces all 615, and direct inspection confirms an actual article excluded because its 9,874-character body was flattened to one line. Other examples include a wrong-site shell, paywall and long challenge code, so the false-exclusion count and a general article-identification repair remain to be established. The [council regroup](../clean-arch/STEP1-SOURCE-REGROUP-COUNCIL.md) and [source-preservation design](../clean-arch/STEP1-SOURCE-PRESERVATION-DESIGN.md) describe an isolated candidate checked against all 34,084 records, with a fake-answer actual-runner handoff and provenance display in the replay renderer. The [five source-control calls](../clean-arch/STEP1-CAPTURE-CONTROLS-RESULTS.md) completed and were source-reviewed; two items contain summary details absent from their attached quotations, and one source-visible risk explanation was not returned. This is selected-case evidence, not a general quality result. Broader source-quality comparison, citation completeness and actual writer integration remain open.\\n\\n**Clean architecture Step 1 (2026-11-06, isolated work on `clean-arch`):** Alex reopened work with the clean architecture. An experimental prepared-source handoff now preserves the archived page, prior cleaned text, source-role decisions and selected-line mapping without changing the original database; quotations for prepared items must also occur contiguously in the original captured page. Two seven-item runs are available in the [clean architecture PRD](../clean-arch/PRD.md), one in the earlier selection order and one in recorded page-timestamp order. The source selector is not a production service and source ordering is not established event-arrival ordering. The runs expose unresolved semantic problems: citations can omit supporting facts despite an exact location match; model output can change a benchmark into a deployment, reverse a backup relation, omit a named customer or assign an unstated currency. A blinded 84-call check-placement/wording comparison and a 27-call same-article citation-completion diagnostic did not give a clean semantic fix and are not adopted. The latter missed an omitted connectivity condition and a reversed backup relationship, and left six expected evidence reviews unaddressed. A further five-round Codex–Claude council produced a narrowly scoped Step 1 link candidate, independently checked for prompt-contract drift. A six-article, 36-call blind comparison completed; the candidate still produced an explicitly self-contradictory link and both arms consistently omitted the same Kyber report and company response. It is not adopted and has not changed the active PRD prompt. A trace confirms that both the Kyber report and open Kyber thesis were supplied, and the raw model answers omitted the report and denial; the reason is not established. See ../poc/data/clean-step1-kyber-trace-2026-11-06/TRACE.md. An isolated six-call comparison showed that hiding the Kyber thesis did not recover the report or denial in any draw. A second six-call comparison returned them in 3/3 draws with the original Kyber paragraph alone and 0/3 with the full article; length, position and surrounding content changed together, so the reason is not isolated. Excerpt outputs have source-attribution limitations. Neither experiment changed state or established a production fix. (Superseded: the next task then was a whole-article coverage approach; the current next task is under \\\"One next task\\\".) See ../clean-arch/STEP1-IMPLEMENTATION-COUNCIL.md. The earlier four-round council agreed that no tested semantic fix is ready; its next investigation is a source-backed review of the 49-item historical run and its 160 evidence records, with overlapping issue flags and separate article-level omissions, then a separate comparison of the seven-item replays. See ../clean-arch/STEP1-COUNCIL-REVIEW.md. Preserve relevant evidence while identifying the next intervention; production/frozen history remains as described below. See [Step 1 run log](../clean-arch/STEP1-RUN-LOG.md) and [English reading page](../clean-arch/architecture.html).\\n\\n**Sealed (D379, 2026-11-06):** Alex asked to clean up and seal this version while he re-plans the system design. Work stops here and is sealed as it is: main's working tree is committed on branch `seal/2026-11-06` (tag `sealed-2026-11-06`) and merged into `main` on Alex's word (PR #10); the sealed split and two side experiments are pushed on their own branches (D379). No PRD 11 experiment is open, and the E1 next task below is withdrawn. The next task is Alex's re-planned system design.\\n\\n**E1 diagnosed (2026-11-06, Alex chose E1):** of 57 helpful matters frozen production wrote and then dropped, two readers agree on 17 link misses (4 core), 3 opening misses (1 core) and 24 small matters the standard itself drops; 10 are disputed on the fallback clause and 3 were quote refusals. Opening is not the experiment. The core of the link misses is the model reading a question's period, population or named configuration as a boundary; only 8 of the 13 window draws it dropped were lost to the product. No production change; $0.02 of probes. My recommendation was to fold that narrow change into the next extraction version; withdrawn by the seal (D379). Details: `docs/research/2026-11-06-e1-no-home-drops/README.md`, PRD 11 E1.\\n\\n**Split extraction sealed as a failed experiment (D378, 2026-11-06):** the split (a new-question call, an evidence call and record preparation) was benchmarked against the frozen poc-v108 and failed. Its stop line fired: helpful matters 156, 156, 159 against 166, 170, 162, with about 15% higher cost. One screened revision kept more noise than production. It is sealed in the worktree `hivemind-no-preseed-evidence-review` (tag `split-extraction-failed-sealed-2026-11-06`), and nothing of it is in main. What it taught is written as proposed production experiments in `docs/prd/11-production-experiments-from-split.md`: E1 no-home helpful drops, E2 duplicate questions, E3 ladder checks with D186, E4 judge refusals, E5 D203's revision day, E6 the measurement kit. Each opens only on Alex's word.\\n\\n**Question-catalog limit removed (D377, 2026-11-05):** Alex also directed removal of the separate 150 KB catalog rejection. The research reader in this worktree now has neither the catalog nor evidence byte limit; it retains full scoped questions, historical boundaries, dependencies and evidence. A portable 326,996-byte catalog test returns all 400 new questions and expands evidence both after reading the catalog and directly; the old 150 KB guard fails the same test in a scratch copy. The saved 69-question pilot catalog and all 69 saved evidence expansions match their original content hashes. Details: `docs/research/2026-11-05-catalog-limit/`. The full suite remains pending until the paid seven-day run no longer competes for resources. The run remains in its isolated worktree and does not call this research reader.\\n\\n**Evidence reader limit removed (D376, 2026-11-05):** Alex directed removal of the reader's 1 MB evidence-expansion rejection. In this worktree, `research_context.Reader.expand` now returns the entire evidence payload without that cap, while the catalog's separate limit remained at that checkpoint; D377 subsequently removed it. On the saved pilot ledger, all 69 individual question expansions, the four-question 1,931,225-byte pilot request and the entire 3,454,076-byte catalog produce the exact same content as the pre-change high-limit baseline; the portable oversized-ledger test passes and fails when the old cap is restored in a scratch copy. Details and snapshot-specific measurements are in `docs/research/2026-11-05-reader-limit/`. The seven-day diagnostic runs in `/Users/lchingen/hivemind-no-preseed-evidence-review/poc/data/split-fresh-seven-day-2026-11-05-v2/` with its pinned code; it does not call this research reader. Read its status through its `snapshot.sh`; do not edit its package code while it is live. This change is not an acceptance of seven-day extraction or judgement quality.\\n\\n**Start-state correction (2026-11-05):** Alex requires a research library established from real material available before the test start, then extraction against that state. The prior empty-library diagnostic cannot represent this case. Our own mistakes and the current 68-question provenance audit are in `../hivemind-no-preseed-evidence-review/docs/research/2026-11-05-parallel-refinement/own-mistakes-2026-11-05.zh.md`. Two new A-only calls were run on 2026-08-29 articles using the 68-question prior-day snapshot; both proposed the same aggregate supply-commitments topic. A source/context review judged it distinct from the existing specific SK Hynix question. A third A-only call on an author-body excerpt about DLSS 5, already tracked by v22, passed; the prompt also restricts software updates, so the reason is not established. No writer or dedup ran; source-history completeness remains unverified, and this is not scored acceptance. Details: ../hivemind-no-preseed-evidence-review/docs/research/2026-11-05-parallel-refinement/start-state-diagnostic-2026-11-05.zh.md.\\n\\n**Measurement correction (2026-11-05):** Alex clarified that a gold-worthy topic already in the supplied library should not open again; an absent worthy topic should open. The earlier simple-A claim of a \\\"missed\\\" new topic was not scored against that rule and is withdrawn as a correctness conclusion. In the actual experiment, a Kyber topic was shown and passing follows Alex's topic-level rule; whether its exact release question captures the shipping milestone remains unverified. The experimental pre-article snapshots differ from the replay's day-start snapshots; 9 of 10 inspected examples differ. The current uncommitted replay default does not build a cold-start library; committed main HEAD still uses the old seed and startup filing path. Historical lexical coverage has a confirmed unrelated-topic match. The frozen gold and past scores remain unchanged. Audit: `../hivemind-no-preseed-evidence-review/docs/research/2026-11-05-parallel-refinement/measurement-context-scrub-2026-11-05.zh.md`.\\n\\n**Simple new-question diagnostic (2026-11-05):** At Alex's direction, an isolated prompt returned new questions plus article evidence without asking for product database fields. Four previously seen real dev articles each ran once: three returned one candidate, one returned none, all four quotes matched their source, and the gold-listed GPU backstop amount question was not proposed. Whether that omission is a new-topic miss depends on whether the existing library covers the topic. Two other candidates require source and independent-significance review; the actual experimental snapshot already had a Kyber topic, so its pass follows Alex's topic-level rule; whether its exact release question captures the shipping milestone remains unverified. This is not a production or full-pipeline acceptance. Details: `../hivemind-no-preseed-evidence-review/docs/research/2026-11-05-parallel-refinement/simple-new-question-results.zh.md`.\\n\\n**Split prompt structure v3 read diagnostic (2026-11-05):** One real reading-stage call on a previously seen article found the revenue/margin guidance and Trainium scale but omitted the gold China revenue/market-loss matter. The prewritten stop condition was triggered and the linking call was not sent. This is one draw and not a production or end-to-end result. See `../hivemind-no-preseed-evidence-review/docs/research/2026-11-05-parallel-refinement/structure-v3-read-result.zh.md`. D374 removes the model sampling field from active settings and default configs; historical config files and archives retain their original bytes.\\n\\n**Split prompt structure v2 small test (2026-11-05):** Thirty calls on two previously seen golden-v5 dev articles completed in `../hivemind-no-preseed-evidence-review`. The blind model reader found complete helpful matters in the fresh control versus new A+B of 6/19 vs 10/19, 11/19 vs 7/19, and 9/19 vs 12/19. The new arm also retained more gold not-kept matters in each draw; B missed useful margin guidance and one answer reused IDs, with a demonstrated matching collision. This is not a production acceptance. See `../hivemind-no-preseed-evidence-review/docs/research/2026-11-05-parallel-refinement/structure-v2-results.zh.md` and `reports/2026-11-05-parallel-structure-v2.html`.\\n\\n**Split extraction small test (2026-11-05):** At Alex's request, the isolated `hivemind-no-preseed-evidence-review` worktree ran two real golden-v5 articles once through each split lane. An independent model reader found 7 of 19 helpful gold matters fully retained, two partial, two written then dropped, eight missed, and one retained gold not-kept matter. Three saved v108 draws on these articles retained 7, 9 and 12 of 19, but used 22 seeded questions while the new test used 8/10-question snapshots; these are not directly comparable. The experiment remains unaccepted; see `../hivemind-no-preseed-evidence-review/docs/research/2026-11-05-parallel-refinement/small-scored-test-20261105.md` and `reports/2026-11-05-split-small-test.html`.\\n\\nAs of November 5, 2026; decisions through D374. [Decisions](DECISIONS.md) holds what is decided now; the [design page](system-design.html) and the [module PRDs](prd/README.md) hold what the code must do; the [README](../README.md) holds startup, build and run instructions.\\n\\n## Future evidence scoring (D372)\\n\\nAlex decided future gold scoring should measure helpful versus not helpful evidence without requiring separate scores for core and supporting. Use frozen golden-v5 as-is: combine core and supporting as helpful, treat not-kept as unhelpful, and keep optional entries neutral. A counting report has not yet been implemented. Historical scores retain their original definitions. D373 removes the stop caused by a separate concern about three question-gold entries: keep the gold unchanged, continue scoring and disclose the concern; see `../hivemind-no-preseed-evidence-review/docs/research/2026-11-05-parallel-refinement/ruler-conflict-2026-11-05.zh.md`.\\n\\n## Latest decision (D369)\\n\\nAlex decided in D369 to capture core and supporting evidence without a strict boundary and in D370 to remove the 22 preset starting questions and separate earnings-report import. The replay entry now defaults to `poc-v118` (D374), refuses old seeded ledgers and baseline configurations, and continues to read existing non-seeded questions; earnings releases remain normal source items. This change has local contract tests but has not passed end-to-end product acceptance. The frozen historical rulers and results remain unchanged.\\n\\nThe small 2026-11-05 study used three archived NVDA articles and an 8/28 historical 68-question snapshot: without versus with an appended report, independent AI review found 14/27 versus 13/27 complete matters. This measured appended extraction context, not the distinct former coverage-start step; D370 removes both by Alex's decision. Full traces and limitations are in the separate `hivemind-no-preseed-evidence-review` worktree under `docs/research/2026-11-05-real-input-evidence/existing-library-results-2026-11-05.md`.\\n\\n\\n**One-day smoke completed (2026-11-05 UTC):** Alex requested a quick 1–2 day end-to-end test. One day, 2026-08-29, ran in `/Users/lchingen/hivemind-no-preseed-evidence-review/poc/data/v117-one-day-smoke-2026-11-05/`: config v117, an 8/28 historical library, 40 extraction calls, 93 evidence records written, four new questions, 54 judged and zero terminal failures. Two judgement attempts were refused and corrected. A Microsoft revenue forecast of $391.1bn was assigned to a rung whose upper bound excludes $391.1bn; the same article's actual quarterly revenue and next-quarter guidance were dropped with no home. Some source dates and bodies are not verified, and an independent 14-article sample review was incomplete due to truncated text. This is not semantic or production acceptance. Findings and scope: `docs/research/2026-11-05-real-input-evidence/one-day-v117-smoke-2026-11-05.zh.md` in that worktree. The clean source-text comparison and its condition-hidden review are complete; council discussion of next steps is ongoing.\\n\\n**D371, in progress:** Alex directed that present and forward-looking revenue and financial information should be tracked. Diagnose the same-day extraction and filing losses before designing a general change. No new financial tracking implementation has been accepted yet. The old frozen standard and gold are unchanged. The original prompt-only pilot failed design review. The user approved an exact prompt addition for an experiment; it is not a production implementation. Four paired real-article diagnostic calls per arm completed for the exact approved sentence: v74i versus experimental role-d371-pilot. Microsoft next-quarter guidance and NVIDIA FY2028 guidance still dropped in the treatment; a single draw is not acceptance or proof of causation. Details: docs/research/2026-11-05-real-input-evidence/d371-prompt-pilot-results.zh.md (isolated worktree). The requested full prompt audit and restructure were drafted experimentally; five real-article paired diagnostic requests per arm completed. Microsoft revenue guidance was missed in both arms, and the draft produced unsupported original dates, a quote refusal and suspect links. No production prompt change or acceptance; see restructure-pilot-results.zh.md in the isolated worktree.\\n\\n**Clean Step 1 coverage council (2026-11-06):** Codex and Claude Code independently reviewed the existing attempts and completed three discussion rounds. The proposed next research candidate moves the existing evidence-reading block ahead of the thesis-opening block while preserving the article, open-thesis state and paired output. It is a hypothesis, not an implemented or validated fix. A complete prompt/contract audit and independent review precede any controlled Luna comparison. Historical paragraph-based and source-first experiments, their noise and attribution problems, and the rejected overlap-based merge are recorded in [the council review](../clean-arch/STEP1-COVERAGE-COUNCIL.md). No new Luna experiment was run in the council.\\n\\n**Clean Step 1 coverage order result (2026-11-07):** The isolated 54-call clean comparison completed and all answers were reviewed blind. Moving the evidence-reading block recovered a known Kyber report and denial in one of three candidate answers against none in three controls, with attribution blur; it also produced unsupported gaming-to-AI links in two candidate answers and no controls. It is not adopted. A separate exact-quote example misattributes an executive's prediction in the standalone summary. [Results and replay](../clean-arch/STEP1-COVERAGE-ORDER-RESULTS.md) record all selected cases, uncertainties and source-fidelity work; no production ledger was written.\\n\\n**Clean Step 1 fidelity council (2026-11-07):** Codex and Claude Code completed five rounds on source attribution, conditions, dates and meaning. No tested fix or root cause is established. The agreed source-to-record review of 49 articles / 160 evidence items and the subsequent isolated field-order comparison are complete; the later 54-answer / 217-record repeated sample remains separate. Prior source-first, quote-first and follow-up-review experiments and their limits are recorded in [the fidelity council](../clean-arch/STEP1-FIDELITY-COUNCIL.md). No Luna experiment or production change was made in this council.\\n\\n**Clean Step 1 fidelity review (2026-11-07):** All 49 saved source packets and 160 original evidence items have received a source-and-record review; focused independent cross-checks cover the findings and selected controls. The [review and article replay](../clean-arch/STEP1-FIDELITY-REVIEW.md) distinguish source contamination and missing source material from model meaning, citation, date and link issues. The [isolated schema property-order diagnostic](../clean-arch/STEP1-CITATION-ORDER-RESULTS.md) completed all 66 calls and condition-blinded article reviews. Several omissions and semantic errors persisted; it did not establish a fix and is not adopted. It used saved articles and before-states without changing production.\\n\\n**Clean Step 1 source handoff council (2026-11-07):** The ongoing [council and offline checks](../clean-arch/STEP1-SOURCE-HANDOFF-COUNCIL.md) reconstructed 16 matching article-34 controls, all omitting a Kyber report and denial; the cause remains unknown. The 20-article saved source-role overlap review distinguished previously cited AI-generated summary lines and an unrelated recommendation from authored body. The clean runner does not send the saved source-role labels; the council chose to first compare original and previously selected source text on ten known articles. The isolated 60-call source-text comparison and condition-hidden review are complete; [results](../clean-arch/STEP1-SOURCE-TEXT-RESULTS.md) show specific contamination reductions alongside persistent omissions and changed meaning. It did not advance state or write production. The isolated six-article low-versus-medium source-fidelity diagnostic completed 36/36 calls and condition-hidden review. [Results](../clean-arch/STEP1-REASONING-FIDELITY-RESULTS.md) show partial improvements alongside persistent source-qualification and attribution concerns; no production setting is changed. The [prompt audit](../clean-arch/STEP1-FIDELITY-PROMPT-AUDIT.md) maps the observed failures to the full request and signed standard. The six-article isolated schema-description comparison completed 36/36 calls and condition-hidden review; the candidate did not preserve the repeated example qualification and is not adopted. [Results](../clean-arch/STEP1-SUMMARY-FIDELITY-RESULTS.md). A further six-article 36-call low-versus-medium comparison used corpus-cleaned sources outside the original 49-item clean replay and a fixed exploratory context; results were mixed, including unsupported links and incorrect attribution/date fields. [Results and replay](../clean-arch/STEP1-ADDITIONAL-SOURCES-RESULTS.md). The structured-claims candidate was not sent after review revealed scope and complexity concerns. Council review of the next action is ongoing. The date-text schema-description diagnostic completed 48/48 calls on eight known cases, with mixed results; the candidate is not adopted. A selected-run census found twelve literal \\\"null\\\" strings in date-text fields, but no production writer impact is established. [Results and replay](../clean-arch/STEP1-DATE-DESCRIPTION-RESULTS.md). A further preregistered eight-source date comparison completed 48/48 calls; the candidate lost a supported company-article statement date in all three draws on one source and is not adopted. [Results and replay](../clean-arch/STEP1-DATE-NEW-SOURCES-RESULTS.md). A bounded corpus census confirmed 163 source pages across three explicit generated-summary structures whose labels were removed while some summary text was retained; two NVIDIA cases were reproduced through the cleaner. [Source provenance investigation](../clean-arch/STEP1-SOURCE-PROVENANCE-CENSUS.md). A read-only source-lineage replay reproduced 363/363 cleaned pages with current inputs, preserved ambiguous original-line locations, and surfaced the generated-summary label loss for review. [Source investigation and lineage replay](../clean-arch/STEP1-SOURCE-PROVENANCE-CENSUS.md). An offline neighboring-context observation exposed only 144 or 149 of 163 known labels and introduced many other page lines; it is not adopted as a general source fix. [Observations and viewer](../clean-arch/STEP1-SOURCE-CONTEXT-OBSERVATIONS.md). A new [saved-quote integrity investigation](../clean-arch/STEP1-QUOTE-INTEGRITY-CENSUS.md) reconstructed 360 saved answers across eight overlapping cohorts, including 78 prepared-source calls. Five saved unverified passage instances were complete matches under the existing normalization; an in-memory candidate recovered their original slices, while ten others remained unverified. The normalized source-slice lookup is now installed only in the isolated clean Step 1 runner; saved-answer and entry-point checks are recorded there. Page provenance, Unicode completeness, production resource budgets and writer integration remain open. The existing writer stores only one quote, whereas 63 of 160 evidence items in the 49-article exploratory trace have multiple passages. A [source-first 49-article coverage review](../clean-arch/STEP1-COVERAGE-CENSUS.md) separates material missing from the model input from source-visible omissions in the saved answers, with uncertain matter boundaries labeled. (Superseded: the next investigation then was why supplied material is missed; the current next task is under \\\"One next task\\\".) The canonical prompt and production configuration remain unchanged. Adding fallible role annotations remains a separate untested candidate. Council streams and handoffs are in `poc/data/clean-step1-ongoing-council-2026-11-07/`.\\n\\n## What runs\\n\\n- **Pipeline (replay default `poc/config/poc-v118.json`, D370, D374).** Every item reads the relevant open questions from the library at the start of its day, then extraction v74i on `gpt-6-luna` proposes evidence and questions; Jev matching with the collision judge matches them; code writes the records; judging-v7 judges changes once a day; pull mode closes due questions. There is no separate seed or coverage-start report import, and reports as source items remain eligible. This default has not completed end-to-end acceptance. The [pipeline guide](poc/pipeline-plan.md) maps stages to code.\\n- **Measured:** one company (NVDA) over one 14-day window (2026-07-01 to 07-14), the judgement scored at the window end on the frozen ruler (AGENTS §7.1). Three draws of `poc-v116` against three of `poc-v108` run in the same hours: 53 against 45 agreements of 57; operating margin and capex agree in 3 of 3 draws, never judged without the coverage-start reading ([acceptance](research/2026-11-04-filing-end-to-end/acceptance-design.md)).\\n- **Served data:** the service, the MCP server and the standalone page serve the sealed three-month ledger `served-2026-10-28-v34-nvda-3m-through-0828` (68 theses, 34 groups; D358), built by the earlier `poc-v34` pipeline, not by the replay default. HTTP `/library`, MCP `thesis_library` and the standalone page share the dated bundle writer.\\n- **Idea API:** `poc-v118-idea` (D290, D335, D374): two discovery calls and one adoption and weighting assessment; only adopted theses with positive weights appear, and nonempty plans total 100%. The [Idea contract](poc/idea-card.md) owns its fields and the limits of its scores.\\n- **Interface:** the Thesis Library and Explore Ideas workspaces, with the confidence Trigger and an Action preview (no wallet connection or order execution). The [UI specification](poc/thesis-ui.md) and the [integration guide](../poc/ui/README.md) own its behaviour.\\n- **Repository:** `main` holds the product, the frozen ruler and the research records; run databases, logs and model archives stay on disk (D353), located by the [data manifest](research/2026-10-25-english/data-manifest.md). Worktrees: `/Users/lchingen/hivemind` is the main checkout, where slice branches are cut from `main`; `/Users/lchingen/hivemind-extraction-quality-2026-10-28` (the extraction branch, merged on 2026-11-03) keeps in its ignored folders the stored end-to-end runs of `poc-v91` to `poc-v95` that later comparisons read (D359); `/Users/lchingen/hivemind-run-v109-2026-11-04` is the finished judging-v8 run's worktree. Older branches stay in Git without worktrees (D359); none is merged work in progress. The clean source-text comparison and its condition-hidden review are complete; council discussion of next steps is ongoing.\\n\\n## Open defects\\n\\n1. **Competitor and customer news is filed under the company's revenue questions** instead of the share, capital-spending or custom-chip question it informs (D355; filing is otherwise about 85% right). Share facts are often not written at all, an extraction recall miss. The total-revenue question holds about a quarter of all links (D354).\\n2. **One bet opened twice** about one encounter in five: the collision judge splits a seed question from an identical candidate on a fine detail (D354).\\n3. **A question the standard rules out** (the lidar legislation) was proposed by the extraction and opened in one draw of three (D354).\\n4. **A thesis opened from an article gets no dependency of its own**: the default Jev matching asks for none (`views/jev_matching.py`), although D51 has the matching call choose them; themes still reach every company thesis through the theme block (D191, D195). Found in the 2026-11-05 consolidation; building it is decided (D368).\\n5. **Historical coverage-start reading, retired by D370** (D364–D366): the capital-spending line is missed in about one read in six (the question is then left as it was); a labelled guidance figure is written with the fact tier; later reports reach the questions only through the daily stream; `scripts/preflight.py` does not replay the reading's check.\\n6. **Measured on one company and one 14-day window**, the judgement scored at the window end only; no version of the current pipeline has completed a longer window (a 60-day run of `poc-v108` was stopped at Alex's word after 2026-07-15, [log row 8](research/2026-11-04-argument-record/log.md)). The China-share question (v17) swings between draws (0 of 3 in the acceptance, 2 of 3 in its control, 1 of 3 in the frozen draws): two readers found the starting figures did not cause the acceptance's drop, and the byte-identical extraction request kept a \\\"share fell to zero\\\" sentence in two candidate draws and dropped it in two control draws. One acceptance draw judged nothing on v16; its cause is not established.\\n7. **What a judgement reads grows with the window** (D358). Argument records (D201) were measured as the remedy on 2026-11-04 and not built: judging-v8 agreed 12 of 17 against 15 of 17, judging-v9's card added little at about half again the judging cost; their code was removed at Alex's request ([log rows 4–11](research/2026-11-04-argument-record/log.md)).\\n8. **Seen once, not traced.** A judgement named a shown theme as a dependency and the check refused it twice, stopping a draw for a day (2026-11-02, D266). The sealed run's review recorded that a succession's opening evidence is not linked to the new question (D358), not yet checked against today's code.\\n9. **Earlier defects, unchanged.** Matching (build log row 49): another document's copy of a figure can be treated as new evidence; one matter can occupy several groups; same-answer candidate references caused seven chain or duplication decisions of the generative matcher; empty `original_who` values can count as the same party; different names for one population cause two of nine Jev merge misses. Nine 2026 aggregate-spending theses under `ai-capex` each have a different population; whether to combine them is a product choice. Extraction's instructions remain narrower than the PRD's important-question rule and omit the personal-memo exception, and extraction can change a quantity's meaning before matching (a guarantee amount against financing provided). Classification keeps its [recorded simulation defects](research/2026-10-25-english/classification-existing-defects.txt). The corpus audit recorded 97 official notices with 56 body and file-name collisions, to re-fetch before relying on a rebuilt corpus. An older intermittent search-test failure is untraced. Fresh Idea allocations vary while saved weights do not; the confidence chart applies the current plan to past states and is not a calibrated probability; broad analyst-prose quality and fresh Idea stability remain unaccepted (the [Idea contract](poc/idea-card.md) lists its limits); generative matching dependencies await `matching-v4`. The readers' doubts about the frozen standard, listed in the [extraction branch's state page](research/2026-11-01-e2e-loop/current-state-extraction-branch-2026-11-03.md), remain for Alex.\\n\\nUpstream supply and the human review pool's output remain deferred.\\n\\n## One next task\\n\\n**Clean Step 4 (D396): design version 4 is written; it is not READY and waits for two choices of Alex's**\\n([design](../clean-arch/step4-2026-11-10/DESIGN.md); round log §69).\\n\\n- **Design status:** three review rounds (`gg`, `gl`, `gm`) each found serious points; version 4 answers the last and has not been\\n  reviewed. Its core contract depends on C1 and C2 below.\\n- **What the review of 2026-11-10 found** (council `gh`–`gm`, all on stored data, no paid send):\\n  - Step 4 is the right next step, and inside it the first thing to build and test is the **ladder step alone**: the call that turns a\\n    thesis Step 1 opened into one judged question with its answer ladder and due day. The frozen judge follows only when the ladder\\n    step meets its lines.\\n  - Production's own ladder sentences are not stable: one request, the same in three draws, gave a bullish end at the low amount\\n    twice and at the high amount once, with three different middle bands; the code checks pass all three\\n    (`clean-arch/step4-2026-11-10/census/production_ladders.txt`).\\n  - Of the 34 theses the unseeded draws opened, two blind readers find 12 to 16 that ask more than one thing, 7 to 9 of 18 number\\n    questions with no reference figure in the opening article, and 4 that state a calendar due day.\\n- **The next task:** put to Alex\\n  1. **C1:** a topic that asks more than one thing gets one judged question with the rest shown as not judged (recommended as the\\n     first version), or is split as D38 says, or is not judged;\\n  2. **C2:** whether the ladder step carries D186 (ranges against guidance, the favourable end registered; recommended), its\\n     direction half only, or neither;\\n  then revise the design for his answers, review it with a fresh reviewer each round until one finds nothing serious, audit the\\n  whole ladder request, and ask his word to build the ladder step and run Stage A (the ladder step against a control that quotes v74i, on the 34 stored theses and the 10 fresh ones).\\n- **Open defects recorded by this review:** the frozen judge retried 10, 16 and 18 judgements in the seeded clean draws, 38 of 51\\n  reasons a theme cited as a dependency (PRD 11, E4; frozen, a finding for Alex); the same matter takes different shapes between\\n  draws (Kyber due end-2027 in one draw and end-2028 in another).\\n- **The unseeded measurement (D395):** graded subset 4.0 against 6.33 seeded. Every miss is a question not opened in the ruler's shape.\\n  Judged answers 16 of 16, on the ruler's wording and ladder; the system's own questions have never met a judge.\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n./docs/research/2026-11-04-argument-record/probe_v9.py:1:\"\"\"A few cents' look at judging-v9 before any run (targets.md T1, T3, T4): each case is a stored judging-v7 request of the frozen draw\n./docs/research/2026-11-04-argument-record/probe_v9.py:2:(its reading and previous conclusion as sent), turned into the request judging-v9 would send by the code's own builder pieces: the previous\n./docs/research/2026-11-04-argument-record/probe_v9.py:6:answer goes through judging-v9's card checks against the request sent.\n./docs/research/2026-11-04-argument-record/probe_v9.py:30:    \"\"\"The judging-v8 card of this thesis written before `day`, without the claims judging-v9's figure check refuses; None if none.\"\"\"\n./docs/research/2026-11-04-argument-record/probe_v9.py:44:    \"\"\"The v7 request text with the v9 closing line, as `_lines_fresh_card` builds it (judging-v9 shows no previous card; `argument` is\n./docs/research/2026-11-04-argument-record/probe_v9.py:58:    system = open(config.prompt_path('judging-v9.txt'), encoding='utf-8').read()\n./docs/research/2026-11-04-argument-record/probe_v9.py:59:    schema = judging.schema_for('judging-v9')\n./docs/research/2026-11-04-argument-record/predictions-step2b.md:1:# 第 2 步重跑（judging-v9）预期：发送前写下并冻结，2026-11-04\n./docs/research/2026-11-04-argument-record/predictions-step2b.md:3:运行：`poc-v110`（`poc-v108` 只把判断换成 judging-v9：v7 的读法、上一次结论和答题项，加一张每次照写、下次不读回的论证卡片），一遍，2026-07-01 到 07-14，\n./docs/research/2026-11-04-argument-record/log.md:41:| 10 | 2026-11-04 17:45–18:05 | 按 `targets.md` 改卡片，在已存请求上先看结果（约 0.6 美元） | **改法（judging-v9，`poc-v110`）：**判断照旧用 v7 的读法和答题项（引用由判断自己写）；多写一张卡片，理由只写引用里写了的事实，推算只放\"推出的结果\"；代码在写入前查：引用只能是请求里列出的、独立来源数不超过\"引用数减转载数\"、理由里的每个数字要在它的引用（或题目、几级结果）里找得到。**先数 T3a：**用这条规则数 v8 全部卡片，1,267 条里 26 条（2.1%），最后那版 4 条；抽 10 条看全是真推算（\"约 3,874 亿\"\"约 207 亿\"）；之前的 204、85 是更松的数法，作废。**第一版 v9 把上一张卡片摆在旁边\"只作比较\"**：21 道题各 3 次，总收入 6/6 判对，其余 17 题 51/51 和 v7 同档，但融资承诺只 2/6；同样的请求不摆卡片则 6/6 判对，v7 自己 7-14 原样重发 3/3。所以就算标明\"只作比较\"，旧卡片上的保留话（\"Firmus 目标没落实\"）也会把判断往下拉——和 PRD 06 的原则一致：判断从事实来，不从自己上一次的论证来。**定稿 v9：不给判断看旧卡片。**21 道题各 3 次：62/63 和 v7 同档（唯一不同是融资承诺 7-12 的一次第 3 档，v7 自己这天 2/4）；总收入 6/6、融资承诺 5/6 判对；卡片退回：先 5/63，其中 1 次是规则把报道里的\"360MW\"漏认了，改成\"报道里出现的数字都算写了\"后 4/63（6.3%），4 次都是真问题（2 次数字不在所引报道里，2 次引用超过 4 条）。测试 `tests/test_fresh_card.py` 5 条，三个变坏版本（去掉数字检查、去掉来源数检查、把旧卡片摆回去）各被抓到；全部测试 277 条通过，冻结文件未动 | 重跑第 2 步（14 天一遍）的预期写下并冻结：`predictions-step2b.md`（sha256 记在旁边）。\"判断不读旧卡片\"和 D201 原文\"判断读论证\"不一致，采用前要 Alex 决定；实验先按这个跑 |\n./docs/research/2026-11-21-citation-lists/claude-r38.md:15:- **Dependencies in v7's shape:** poc-v118 has no dependency rows, so `cites_views` is always `maxItems: 0` under poc-v121. In v8's\n./docs/research/2026-11-21-citation-lists/DESIGN.md:51:  - `judging-v9`: judging-v7's text and request, with closed lists.\n./docs/research/2026-11-21-citation-lists/DESIGN.md:52:  - `judging-v10`: judging-v8's text and dependency block, with closed lists.\n./docs/research/2026-11-21-citation-lists/DESIGN.md:55:  - Config: `poc-v121` = poc-v118 with `rejudging.prompt_version` = judging-v9 (the product with the fix). No config names v10 until\n./docs/research/2026-11-21-citation-lists/DESIGN.md:96:| No dependency (all of poc-v121) | `cites_views` has `maxItems: 0` | — |\n./docs/research/2026-11-21-citation-lists/DESIGN.md:127:| Launchers: which config runs where | poc-v121 a product config (like poc-v118); v10 is named by no config |\n./docs/research/2026-11-21-citation-lists/DESIGN.md:141:- **T1, the product path** (old-2 replayed under poc-v121).\n./docs/research/2026-11-21-citation-lists/round38-brief.md:23:4. Versions as two names (judging-v9/v10) versus a config field: which, and why? Should v10 be built now?\n./docs/research/2026-11-14-use-acceptance/reflection-2/cold-codex-1.jsonl:11:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_4\",\"type\":\"command_execution\",\"command\":\"/opt/homebrew/bin/zsh -lc 'cat docs/CURRENT_STATE.md'\",\"aggregated_output\":\"# Current state\\n\\n**Clean Steps 1–3, current (2026-11-11).** Records: Step 1, [round log](../clean-arch/step1-unfiled-2026-11-08/LOG.md) §§16–47; Step 2, [Step 2 log](../clean-arch/step2-validation-2026-11-07/LOG.md) §§12–19.\\n- **Step 1 configuration: c8, adopted by Alex (D387).** It runs DeepSeek Flash at high effort, with a 64,000-token output cap; a\\n  format failure or a cut answer is resent once (D380). It carries Alex's decisions D382–D385:\\n  - figures are conditions;\\n  - material statements with no thesis are kept without links;\\n  - only big matters open a thesis;\\n  - no target prices.\\n\\n  [PRD §12](../clean-arch/PRD.md) holds its system prompt, closing check and schema; a run with no candidate files sends exactly the\\n  accepted request.\\n- **Acceptance (D386, [protocol](../clean-arch/step1-unfiled-2026-11-08/ACCEPTANCE-PROTOCOL.md)).** 50 fresh articles that no run,\\n  old or new, had used: news from 2026-09-05 to 09-07, a holiday weekend with no NVIDIA posts. One draw; two readers and a third on\\n  disputes.\\n  - helpful 132/139 (core 83/83);\\n  - wrongly opened theses 1 of 10;\\n  - search 141/143 available repeat pairs, or 141/145 for the whole system (one 11-article story supplies 55 pairs, and revisions are\\n    barely exercised);\\n  - clear wrong merges 1/57, plus 2 overlaps;\\n  - detail retention 22 = 22. This is a storage comparison: every record keeps its own text. It is not a usability test.\\n\\n  Dev ×3 on the frozen golden-v5 (a lead): helpful 214, 211 and 212 of 234; search 98.9–100%; clear wrong merges about 1%. Step 1\\n  cost for the fresh set plus dev ×3: $4.20 at published rates.\\n- **Steps 2 and 3** are built in isolation (`clean-arch/step2`, `clean-arch/step3`): search, comparison, grouping and later linking.\\n  They are not integrated with production storage. **Step 4 (judging) has not passed** on the clean path: its ladder step is built and\\n  measured (four Stage A runs, lines missed by 1 to 3 answers; D426), so nothing yet shows the clean system can judge an investment\\n  view on its own questions.\\n- **Step 2 is closed and frozen (Alex, D427, 2026-11-11;** [Step 2 log](../clean-arch/step2-validation-2026-11-07/LOG.md) §§14–19**).** It goes\\n  to production only with the whole clean path, after Step 4 meets its lines; `tests/test_frozen_clean_step2.py` guards its files. Its three lines were met at the acceptance above (one draw; \\\"later version\\\"\\n  relations barely exercised), and no miss of the seeded end-to-end test (clean 18, 18, 17 against production 17, 15, 16) has\\n  been traced to it (the two single-draw misses were diagnosed on 2026-11-11, below: neither traces to Step 2). What happened since the close-out of 2026-11-08:\\n  - A change to Jev's wording for \\\"later version\\\" relations failed its line (42 calls, 2026-11-09) and tuning stopped.\\n  - One wrong relation was traced to the judge: it put NVIDIA's answer to the Kyber report under the FY2027 revenue question;\\n    sent both ways, the conclusion did not differ ([result](../clean-arch/step2-edge-effect-2026-11-10/RESULT.md)).\\n  - Alex stopped work on that relation (D423) and asked for a fix to the rule that gives a \\\"later version\\\" the older record's\\n    questions. Measured on the three saved draws ([round log](../clean-arch/step2-revision-links-2026-11-10/LOG.md)), removing the\\n    rule was withdrawn: of the 24 links it wrote, two blind reader families call 19 context and 3 evidence, and one of the 3 is a\\n    company's answer that would otherwise be missing beside four reports (with it rung 2, 2, 2; without it 2, 3, 2). **The rule\\n    stays (D424).**\\n  - **Open, recorded:** Jev's \\\"later version\\\" relation (9 of 30 join different statements in draw 1); the context links it carries\\n    (19 of 24); wrong groups (at the line on one draw; the unprompted reading test never run); the \\\"Unverified quote\\\" mark not\\n    shown to Jev (3 of 188); not decided, whether a company's answer must sit under every question its report is filed under.\\n  - **Reopens when** Step 4 yields judged views on the clean path and a miss, or something a reader of a thesis sees, traces to\\n    one of these. The round's measurement kit (replay of a saved draw, exact simulation of a writer rule, blind packets with\\n    controls, a judgement sent both ways) is kept in the two folders above.\\n- **The clean system's untraced end-to-end misses, diagnosed (2026-11-11;** [round log](../clean-arch/e2e-misses-2026-11-11/LOG.md)**).**\\n  The China share question in draw 3 and the FY2028 revenue question in draw 2 (seeded test, D392). Both estimates sit on a rung\\n  line. China: the same window-end request, re-sent, gives the miss twice and the right answer once (the judge's own variation at the\\n  1% line); no H200 price is in any request. FY2028: draw 2's window-end request gives the miss 3 of 3 and draw 3's the right answer 3\\n  of 3; draw 2's lacks records draw 3's holds (a \\\"41% in calendar 2027\\\" figure Step 1 filed under FY2027 only, \\\"$1 trillion of\\n  Blackwell and Rubin visibility\\\", five infrastructure-demand records), not isolated which matters; FY2028 is the question whose filed\\n  statements differ most between draws (47% shared, median 74%). Neither traces to Step 2. Refuted on the way: that a refused answer\\n  re-asked caused the China miss. Observed defect of the frozen judge: it names the export-controls theme as a dependency of the China\\n  question, 42 of 65 refusals in six draws, and the re-ask changed the rung 8 times (PRD 11, E4). No change proposed; 18 sends, $0.043.\\n- **Open defects, by product impact** (reflection council, `council/av-codex.md`):\\n  1. **The Ohio-guarantee yes/no question is never covered** in the three dev draws; a broader credit-support amount thesis opens\\n     instead. Diagnosed (round log §48): the model folds the unsigned guarantee into the open aggregate thesis because the request\\n     uses \\\"covers\\\" both for \\\"is evidence for\\\" and for \\\"already asks this question\\\". The same clause sits under link clutter.\\n  2. **A revenue-share thesis was opened** (Vera Rubin's share of data-center revenue), the class-A boundary of D382.\\n  3. **Link clutter.** A blind recheck of the 34 disputed fresh links found 19 weak and 2 wrong; 10 accepted links mixed in as controls were all useful; the other 49 links were not rechecked.\\n     The model's own account names topic or theme overlap and inference chains, and c8's closing check never reads back a link. This is\\n     a likely cause, with no fix proven. Alex approved designing a protected link check through the council; a first draft was stopped\\n     because it would drop founding premises and contrary facts.\\n  4. **Unverified passages:** 3 of 188 fresh records and 1–3 per dev draw. The mark now travels into Step 2's records, and a reader sees the found source text or an \\\"Unverified quote\\\" label. Jev's comparison input still carries the model's text without the mark; changing it changes measured Step 2 behaviour and needs its own measurement.\\n  5. **The lidar policy thesis** recurs at the boundary (one dev draw in three).\\n- **History.** These earlier states are superseded:\\n  - the 2026-11-07 takeover (K5 → K6b; [takeover log](../clean-arch/takeover-2026-11-07/LOG.md));\\n  - the 2026-11-08 close-out (K6b test 32/42; Step 2 first lines; [Step 2 log](../clean-arch/step2-validation-2026-11-07/LOG.md) §12);\\n  - the unfiled fix round and the c1–c7 arms (round log §§1–39).\\n- **No run is live.** The branch is committed through the D388 line (round log §§48–59).\\n\\n**Clean Step 1 source investigation (2026-11-07):** A [source-loss census](../clean-arch/STEP1-SOURCE-LOSS-CENSUS.md) traces two separate losses in the historical cleaner and records reproducible corpus observations. Offline candidate comparisons expose both recovered content and source-identity or contamination risks. A subsequent [full-page diagnostic](../clean-arch/STEP1-FULL-PAGE-RESULTS.md) completed 102 calls on 17 selected articles and independent source-backed review. It exposes examples of both missing or misattributed source text and model errors that persist despite the right text being present. A Codex–Claude council is reviewing the results and earlier attempts; no source-cleaning candidate is adopted, and the source corpus and production defaults are unchanged.\\n\\nAlex has authorized correcting the test-source cleaner and test data when their defects are confirmed, while the frozen production configuration and ruler remain intact. The cleaner switched 615 originally fed articles off; a replay reproduces all 615, and direct inspection confirms an actual article excluded because its 9,874-character body was flattened to one line. Other examples include a wrong-site shell, paywall and long challenge code, so the false-exclusion count and a general article-identification repair remain to be established. The [council regroup](../clean-arch/STEP1-SOURCE-REGROUP-COUNCIL.md) and [source-preservation design](../clean-arch/STEP1-SOURCE-PRESERVATION-DESIGN.md) describe an isolated candidate checked against all 34,084 records, with a fake-answer actual-runner handoff and provenance display in the replay renderer. The [five source-control calls](../clean-arch/STEP1-CAPTURE-CONTROLS-RESULTS.md) completed and were source-reviewed; two items contain summary details absent from their attached quotations, and one source-visible risk explanation was not returned. This is selected-case evidence, not a general quality result. Broader source-quality comparison, citation completeness and actual writer integration remain open.\\n\\n**Clean architecture Step 1 (2026-11-06, isolated work on `clean-arch`):** Alex reopened work with the clean architecture. An experimental prepared-source handoff now preserves the archived page, prior cleaned text, source-role decisions and selected-line mapping without changing the original database; quotations for prepared items must also occur contiguously in the original captured page. Two seven-item runs are available in the [clean architecture PRD](../clean-arch/PRD.md), one in the earlier selection order and one in recorded page-timestamp order. The source selector is not a production service and source ordering is not established event-arrival ordering. The runs expose unresolved semantic problems: citations can omit supporting facts despite an exact location match; model output can change a benchmark into a deployment, reverse a backup relation, omit a named customer or assign an unstated currency. A blinded 84-call check-placement/wording comparison and a 27-call same-article citation-completion diagnostic did not give a clean semantic fix and are not adopted. The latter missed an omitted connectivity condition and a reversed backup relationship, and left six expected evidence reviews unaddressed. A further five-round Codex–Claude council produced a narrowly scoped Step 1 link candidate, independently checked for prompt-contract drift. A six-article, 36-call blind comparison completed; the candidate still produced an explicitly self-contradictory link and both arms consistently omitted the same Kyber report and company response. It is not adopted and has not changed the active PRD prompt. A trace confirms that both the Kyber report and open Kyber thesis were supplied, and the raw model answers omitted the report and denial; the reason is not established. See ../poc/data/clean-step1-kyber-trace-2026-11-06/TRACE.md. An isolated six-call comparison showed that hiding the Kyber thesis did not recover the report or denial in any draw. A second six-call comparison returned them in 3/3 draws with the original Kyber paragraph alone and 0/3 with the full article; length, position and surrounding content changed together, so the reason is not isolated. Excerpt outputs have source-attribution limitations. Neither experiment changed state or established a production fix. (Superseded: the next task then was a whole-article coverage approach; the current next task is under \\\"One next task\\\".) See ../clean-arch/STEP1-IMPLEMENTATION-COUNCIL.md. The earlier four-round council agreed that no tested semantic fix is ready; its next investigation is a source-backed review of the 49-item historical run and its 160 evidence records, with overlapping issue flags and separate article-level omissions, then a separate comparison of the seven-item replays. See ../clean-arch/STEP1-COUNCIL-REVIEW.md. Preserve relevant evidence while identifying the next intervention; production/frozen history remains as described below. See [Step 1 run log](../clean-arch/STEP1-RUN-LOG.md) and [English reading page](../clean-arch/architecture.html).\\n\\n**Sealed (D379, 2026-11-06):** Alex asked to clean up and seal this version while he re-plans the system design. Work stops here and is sealed as it is: main's working tree is committed on branch `seal/2026-11-06` (tag `sealed-2026-11-06`) and merged into `main` on Alex's word (PR #10); the sealed split and two side experiments are pushed on their own branches (D379). No PRD 11 experiment is open, and the E1 next task below is withdrawn. The next task is Alex's re-planned system design.\\n\\n**E1 diagnosed (2026-11-06, Alex chose E1):** of 57 helpful matters frozen production wrote and then dropped, two readers agree on 17 link misses (4 core), 3 opening misses (1 core) and 24 small matters the standard itself drops; 10 are disputed on the fallback clause and 3 were quote refusals. Opening is not the experiment. The core of the link misses is the model reading a question's period, population or named configuration as a boundary; only 8 of the 13 window draws it dropped were lost to the product. No production change; $0.02 of probes. My recommendation was to fold that narrow change into the next extraction version; withdrawn by the seal (D379). Details: `docs/research/2026-11-06-e1-no-home-drops/README.md`, PRD 11 E1.\\n\\n**Split extraction sealed as a failed experiment (D378, 2026-11-06):** the split (a new-question call, an evidence call and record preparation) was benchmarked against the frozen poc-v108 and failed. Its stop line fired: helpful matters 156, 156, 159 against 166, 170, 162, with about 15% higher cost. One screened revision kept more noise than production. It is sealed in the worktree `hivemind-no-preseed-evidence-review` (tag `split-extraction-failed-sealed-2026-11-06`), and nothing of it is in main. What it taught is written as proposed production experiments in `docs/prd/11-production-experiments-from-split.md`: E1 no-home helpful drops, E2 duplicate questions, E3 ladder checks with D186, E4 judge refusals, E5 D203's revision day, E6 the measurement kit. Each opens only on Alex's word.\\n\\n**Question-catalog limit removed (D377, 2026-11-05):** Alex also directed removal of the separate 150 KB catalog rejection. The research reader in this worktree now has neither the catalog nor evidence byte limit; it retains full scoped questions, historical boundaries, dependencies and evidence. A portable 326,996-byte catalog test returns all 400 new questions and expands evidence both after reading the catalog and directly; the old 150 KB guard fails the same test in a scratch copy. The saved 69-question pilot catalog and all 69 saved evidence expansions match their original content hashes. Details: `docs/research/2026-11-05-catalog-limit/`. The full suite remains pending until the paid seven-day run no longer competes for resources. The run remains in its isolated worktree and does not call this research reader.\\n\\n**Evidence reader limit removed (D376, 2026-11-05):** Alex directed removal of the reader's 1 MB evidence-expansion rejection. In this worktree, `research_context.Reader.expand` now returns the entire evidence payload without that cap, while the catalog's separate limit remained at that checkpoint; D377 subsequently removed it. On the saved pilot ledger, all 69 individual question expansions, the four-question 1,931,225-byte pilot request and the entire 3,454,076-byte catalog produce the exact same content as the pre-change high-limit baseline; the portable oversized-ledger test passes and fails when the old cap is restored in a scratch copy. Details and snapshot-specific measurements are in `docs/research/2026-11-05-reader-limit/`. The seven-day diagnostic runs in `/Users/lchingen/hivemind-no-preseed-evidence-review/poc/data/split-fresh-seven-day-2026-11-05-v2/` with its pinned code; it does not call this research reader. Read its status through its `snapshot.sh`; do not edit its package code while it is live. This change is not an acceptance of seven-day extraction or judgement quality.\\n\\n**Start-state correction (2026-11-05):** Alex requires a research library established from real material available before the test start, then extraction against that state. The prior empty-library diagnostic cannot represent this case. Our own mistakes and the current 68-question provenance audit are in `../hivemind-no-preseed-evidence-review/docs/research/2026-11-05-parallel-refinement/own-mistakes-2026-11-05.zh.md`. Two new A-only calls were run on 2026-08-29 articles using the 68-question prior-day snapshot; both proposed the same aggregate supply-commitments topic. A source/context review judged it distinct from the existing specific SK Hynix question. A third A-only call on an author-body excerpt about DLSS 5, already tracked by v22, passed; the prompt also restricts software updates, so the reason is not established. No writer or dedup ran; source-history completeness remains unverified, and this is not scored acceptance. Details: ../hivemind-no-preseed-evidence-review/docs/research/2026-11-05-parallel-refinement/start-state-diagnostic-2026-11-05.zh.md.\\n\\n**Measurement correction (2026-11-05):** Alex clarified that a gold-worthy topic already in the supplied library should not open again; an absent worthy topic should open. The earlier simple-A claim of a \\\"missed\\\" new topic was not scored against that rule and is withdrawn as a correctness conclusion. In the actual experiment, a Kyber topic was shown and passing follows Alex's topic-level rule; whether its exact release question captures the shipping milestone remains unverified. The experimental pre-article snapshots differ from the replay's day-start snapshots; 9 of 10 inspected examples differ. The current uncommitted replay default does not build a cold-start library; committed main HEAD still uses the old seed and startup filing path. Historical lexical coverage has a confirmed unrelated-topic match. The frozen gold and past scores remain unchanged. Audit: `../hivemind-no-preseed-evidence-review/docs/research/2026-11-05-parallel-refinement/measurement-context-scrub-2026-11-05.zh.md`.\\n\\n**Simple new-question diagnostic (2026-11-05):** At Alex's direction, an isolated prompt returned new questions plus article evidence without asking for product database fields. Four previously seen real dev articles each ran once: three returned one candidate, one returned none, all four quotes matched their source, and the gold-listed GPU backstop amount question was not proposed. Whether that omission is a new-topic miss depends on whether the existing library covers the topic. Two other candidates require source and independent-significance review; the actual experimental snapshot already had a Kyber topic, so its pass follows Alex's topic-level rule; whether its exact release question captures the shipping milestone remains unverified. This is not a production or full-pipeline acceptance. Details: `../hivemind-no-preseed-evidence-review/docs/research/2026-11-05-parallel-refinement/simple-new-question-results.zh.md`.\\n\\n**Split prompt structure v3 read diagnostic (2026-11-05):** One real reading-stage call on a previously seen article found the revenue/margin guidance and Trainium scale but omitted the gold China revenue/market-loss matter. The prewritten stop condition was triggered and the linking call was not sent. This is one draw and not a production or end-to-end result. See `../hivemind-no-preseed-evidence-review/docs/research/2026-11-05-parallel-refinement/structure-v3-read-result.zh.md`. D374 removes the model sampling field from active settings and default configs; historical config files and archives retain their original bytes.\\n\\n**Split prompt structure v2 small test (2026-11-05):** Thirty calls on two previously seen golden-v5 dev articles completed in `../hivemind-no-preseed-evidence-review`. The blind model reader found complete helpful matters in the fresh control versus new A+B of 6/19 vs 10/19, 11/19 vs 7/19, and 9/19 vs 12/19. The new arm also retained more gold not-kept matters in each draw; B missed useful margin guidance and one answer reused IDs, with a demonstrated matching collision. This is not a production acceptance. See `../hivemind-no-preseed-evidence-review/docs/research/2026-11-05-parallel-refinement/structure-v2-results.zh.md` and `reports/2026-11-05-parallel-structure-v2.html`.\\n\\n**Split extraction small test (2026-11-05):** At Alex's request, the isolated `hivemind-no-preseed-evidence-review` worktree ran two real golden-v5 articles once through each split lane. An independent model reader found 7 of 19 helpful gold matters fully retained, two partial, two written then dropped, eight missed, and one retained gold not-kept matter. Three saved v108 draws on these articles retained 7, 9 and 12 of 19, but used 22 seeded questions while the new test used 8/10-question snapshots; these are not directly comparable. The experiment remains unaccepted; see `../hivemind-no-preseed-evidence-review/docs/research/2026-11-05-parallel-refinement/small-scored-test-20261105.md` and `reports/2026-11-05-split-small-test.html`.\\n\\nAs of November 5, 2026; decisions through D374. [Decisions](DECISIONS.md) holds what is decided now; the [design page](system-design.html) and the [module PRDs](prd/README.md) hold what the code must do; the [README](../README.md) holds startup, build and run instructions.\\n\\n## Future evidence scoring (D372)\\n\\nAlex decided future gold scoring should measure helpful versus not helpful evidence without requiring separate scores for core and supporting. Use frozen golden-v5 as-is: combine core and supporting as helpful, treat not-kept as unhelpful, and keep optional entries neutral. A counting report has not yet been implemented. Historical scores retain their original definitions. D373 removes the stop caused by a separate concern about three question-gold entries: keep the gold unchanged, continue scoring and disclose the concern; see `../hivemind-no-preseed-evidence-review/docs/research/2026-11-05-parallel-refinement/ruler-conflict-2026-11-05.zh.md`.\\n\\n## Latest decision (D369)\\n\\nAlex decided in D369 to capture core and supporting evidence without a strict boundary and in D370 to remove the 22 preset starting questions and separate earnings-report import. The replay entry now defaults to `poc-v118` (D374), refuses old seeded ledgers and baseline configurations, and continues to read existing non-seeded questions; earnings releases remain normal source items. This change has local contract tests but has not passed end-to-end product acceptance. The frozen historical rulers and results remain unchanged.\\n\\nThe small 2026-11-05 study used three archived NVDA articles and an 8/28 historical 68-question snapshot: without versus with an appended report, independent AI review found 14/27 versus 13/27 complete matters. This measured appended extraction context, not the distinct former coverage-start step; D370 removes both by Alex's decision. Full traces and limitations are in the separate `hivemind-no-preseed-evidence-review` worktree under `docs/research/2026-11-05-real-input-evidence/existing-library-results-2026-11-05.md`.\\n\\n\\n**One-day smoke completed (2026-11-05 UTC):** Alex requested a quick 1–2 day end-to-end test. One day, 2026-08-29, ran in `/Users/lchingen/hivemind-no-preseed-evidence-review/poc/data/v117-one-day-smoke-2026-11-05/`: config v117, an 8/28 historical library, 40 extraction calls, 93 evidence records written, four new questions, 54 judged and zero terminal failures. Two judgement attempts were refused and corrected. A Microsoft revenue forecast of $391.1bn was assigned to a rung whose upper bound excludes $391.1bn; the same article's actual quarterly revenue and next-quarter guidance were dropped with no home. Some source dates and bodies are not verified, and an independent 14-article sample review was incomplete due to truncated text. This is not semantic or production acceptance. Findings and scope: `docs/research/2026-11-05-real-input-evidence/one-day-v117-smoke-2026-11-05.zh.md` in that worktree. The clean source-text comparison and its condition-hidden review are complete; council discussion of next steps is ongoing.\\n\\n**D371, in progress:** Alex directed that present and forward-looking revenue and financial information should be tracked. Diagnose the same-day extraction and filing losses before designing a general change. No new financial tracking implementation has been accepted yet. The old frozen standard and gold are unchanged. The original prompt-only pilot failed design review. The user approved an exact prompt addition for an experiment; it is not a production implementation. Four paired real-article diagnostic calls per arm completed for the exact approved sentence: v74i versus experimental role-d371-pilot. Microsoft next-quarter guidance and NVIDIA FY2028 guidance still dropped in the treatment; a single draw is not acceptance or proof of causation. Details: docs/research/2026-11-05-real-input-evidence/d371-prompt-pilot-results.zh.md (isolated worktree). The requested full prompt audit and restructure were drafted experimentally; five real-article paired diagnostic requests per arm completed. Microsoft revenue guidance was missed in both arms, and the draft produced unsupported original dates, a quote refusal and suspect links. No production prompt change or acceptance; see restructure-pilot-results.zh.md in the isolated worktree.\\n\\n**Clean Step 1 coverage council (2026-11-06):** Codex and Claude Code independently reviewed the existing attempts and completed three discussion rounds. The proposed next research candidate moves the existing evidence-reading block ahead of the thesis-opening block while preserving the article, open-thesis state and paired output. It is a hypothesis, not an implemented or validated fix. A complete prompt/contract audit and independent review precede any controlled Luna comparison. Historical paragraph-based and source-first experiments, their noise and attribution problems, and the rejected overlap-based merge are recorded in [the council review](../clean-arch/STEP1-COVERAGE-COUNCIL.md). No new Luna experiment was run in the council.\\n\\n**Clean Step 1 coverage order result (2026-11-07):** The isolated 54-call clean comparison completed and all answers were reviewed blind. Moving the evidence-reading block recovered a known Kyber report and denial in one of three candidate answers against none in three controls, with attribution blur; it also produced unsupported gaming-to-AI links in two candidate answers and no controls. It is not adopted. A separate exact-quote example misattributes an executive's prediction in the standalone summary. [Results and replay](../clean-arch/STEP1-COVERAGE-ORDER-RESULTS.md) record all selected cases, uncertainties and source-fidelity work; no production ledger was written.\\n\\n**Clean Step 1 fidelity council (2026-11-07):** Codex and Claude Code completed five rounds on source attribution, conditions, dates and meaning. No tested fix or root cause is established. The agreed source-to-record review of 49 articles / 160 evidence items and the subsequent isolated field-order comparison are complete; the later 54-answer / 217-record repeated sample remains separate. Prior source-first, quote-first and follow-up-review experiments and their limits are recorded in [the fidelity council](../clean-arch/STEP1-FIDELITY-COUNCIL.md). No Luna experiment or production change was made in this council.\\n\\n**Clean Step 1 fidelity review (2026-11-07):** All 49 saved source packets and 160 original evidence items have received a source-and-record review; focused independent cross-checks cover the findings and selected controls. The [review and article replay](../clean-arch/STEP1-FIDELITY-REVIEW.md) distinguish source contamination and missing source material from model meaning, citation, date and link issues. The [isolated schema property-order diagnostic](../clean-arch/STEP1-CITATION-ORDER-RESULTS.md) completed all 66 calls and condition-blinded article reviews. Several omissions and semantic errors persisted; it did not establish a fix and is not adopted. It used saved articles and before-states without changing production.\\n\\n**Clean Step 1 source handoff council (2026-11-07):** The ongoing [council and offline checks](../clean-arch/STEP1-SOURCE-HANDOFF-COUNCIL.md) reconstructed 16 matching article-34 controls, all omitting a Kyber report and denial; the cause remains unknown. The 20-article saved source-role overlap review distinguished previously cited AI-generated summary lines and an unrelated recommendation from authored body. The clean runner does not send the saved source-role labels; the council chose to first compare original and previously selected source text on ten known articles. The isolated 60-call source-text comparison and condition-hidden review are complete; [results](../clean-arch/STEP1-SOURCE-TEXT-RESULTS.md) show specific contamination reductions alongside persistent omissions and changed meaning. It did not advance state or write production. The isolated six-article low-versus-medium source-fidelity diagnostic completed 36/36 calls and condition-hidden review. [Results](../clean-arch/STEP1-REASONING-FIDELITY-RESULTS.md) show partial improvements alongside persistent source-qualification and attribution concerns; no production setting is changed. The [prompt audit](../clean-arch/STEP1-FIDELITY-PROMPT-AUDIT.md) maps the observed failures to the full request and signed standard. The six-article isolated schema-description comparison completed 36/36 calls and condition-hidden review; the candidate did not preserve the repeated example qualification and is not adopted. [Results](../clean-arch/STEP1-SUMMARY-FIDELITY-RESULTS.md). A further six-article 36-call low-versus-medium comparison used corpus-cleaned sources outside the original 49-item clean replay and a fixed exploratory context; results were mixed, including unsupported links and incorrect attribution/date fields. [Results and replay](../clean-arch/STEP1-ADDITIONAL-SOURCES-RESULTS.md). The structured-claims candidate was not sent after review revealed scope and complexity concerns. Council review of the next action is ongoing. The date-text schema-description diagnostic completed 48/48 calls on eight known cases, with mixed results; the candidate is not adopted. A selected-run census found twelve literal \\\"null\\\" strings in date-text fields, but no production writer impact is established. [Results and replay](../clean-arch/STEP1-DATE-DESCRIPTION-RESULTS.md). A further preregistered eight-source date comparison completed 48/48 calls; the candidate lost a supported company-article statement date in all three draws on one source and is not adopted. [Results and replay](../clean-arch/STEP1-DATE-NEW-SOURCES-RESULTS.md). A bounded corpus census confirmed 163 source pages across three explicit generated-summary structures whose labels were removed while some summary text was retained; two NVIDIA cases were reproduced through the cleaner. [Source provenance investigation](../clean-arch/STEP1-SOURCE-PROVENANCE-CENSUS.md). A read-only source-lineage replay reproduced 363/363 cleaned pages with current inputs, preserved ambiguous original-line locations, and surfaced the generated-summary label loss for review. [Source investigation and lineage replay](../clean-arch/STEP1-SOURCE-PROVENANCE-CENSUS.md). An offline neighboring-context observation exposed only 144 or 149 of 163 known labels and introduced many other page lines; it is not adopted as a general source fix. [Observations and viewer](../clean-arch/STEP1-SOURCE-CONTEXT-OBSERVATIONS.md). A new [saved-quote integrity investigation](../clean-arch/STEP1-QUOTE-INTEGRITY-CENSUS.md) reconstructed 360 saved answers across eight overlapping cohorts, including 78 prepared-source calls. Five saved unverified passage instances were complete matches under the existing normalization; an in-memory candidate recovered their original slices, while ten others remained unverified. The normalized source-slice lookup is now installed only in the isolated clean Step 1 runner; saved-answer and entry-point checks are recorded there. Page provenance, Unicode completeness, production resource budgets and writer integration remain open. The existing writer stores only one quote, whereas 63 of 160 evidence items in the 49-article exploratory trace have multiple passages. A [source-first 49-article coverage review](../clean-arch/STEP1-COVERAGE-CENSUS.md) separates material missing from the model input from source-visible omissions in the saved answers, with uncertain matter boundaries labeled. (Superseded: the next investigation then was why supplied material is missed; the current next task is under \\\"One next task\\\".) The canonical prompt and production configuration remain unchanged. Adding fallible role annotations remains a separate untested candidate. Council streams and handoffs are in `poc/data/clean-step1-ongoing-council-2026-11-07/`.\\n\\n## What runs\\n\\n- **Pipeline (replay default `poc/config/poc-v118.json`, D370, D374).** Every item reads the relevant open questions from the library at the start of its day, then extraction v74i on `gpt-6-luna` proposes evidence and questions; Jev matching with the collision judge matches them; code writes the records; judging-v7 judges changes once a day; pull mode closes due questions. There is no separate seed or coverage-start report import, and reports as source items remain eligible. This default has not completed end-to-end acceptance. The [pipeline guide](poc/pipeline-plan.md) maps stages to code.\\n- **Measured:** one company (NVDA) over one 14-day window (2026-07-01 to 07-14), the judgement scored at the window end on the frozen ruler (AGENTS §7.1). Three draws of `poc-v116` against three of `poc-v108` run in the same hours: 53 against 45 agreements of 57; operating margin and capex agree in 3 of 3 draws, never judged without the coverage-start reading ([acceptance](research/2026-11-04-filing-end-to-end/acceptance-design.md)).\\n- **Served data:** the service, the MCP server and the standalone page serve the sealed three-month ledger `served-2026-10-28-v34-nvda-3m-through-0828` (68 theses, 34 groups; D358), built by the earlier `poc-v34` pipeline, not by the replay default. HTTP `/library`, MCP `thesis_library` and the standalone page share the dated bundle writer.\\n- **Idea API:** `poc-v118-idea` (D290, D335, D374): two discovery calls and one adoption and weighting assessment; only adopted theses with positive weights appear, and nonempty plans total 100%. The [Idea contract](poc/idea-card.md) owns its fields and the limits of its scores.\\n- **Interface:** the Thesis Library and Explore Ideas workspaces, with the confidence Trigger and an Action preview (no wallet connection or order execution). The [UI specification](poc/thesis-ui.md) and the [integration guide](../poc/ui/README.md) own its behaviour.\\n- **Repository:** `main` holds the product, the frozen ruler and the research records; run databases, logs and model archives stay on disk (D353), located by the [data manifest](research/2026-10-25-english/data-manifest.md). Worktrees: `/Users/lchingen/hivemind` is the main checkout, where slice branches are cut from `main`; `/Users/lchingen/hivemind-extraction-quality-2026-10-28` (the extraction branch, merged on 2026-11-03) keeps in its ignored folders the stored end-to-end runs of `poc-v91` to `poc-v95` that later comparisons read (D359); `/Users/lchingen/hivemind-run-v109-2026-11-04` is the finished judging-v8 run's worktree. Older branches stay in Git without worktrees (D359); none is merged work in progress. The clean source-text comparison and its condition-hidden review are complete; council discussion of next steps is ongoing.\\n\\n## Open defects\\n\\n1. **Competitor and customer news is filed under the company's revenue questions** instead of the share, capital-spending or custom-chip question it informs (D355; filing is otherwise about 85% right). Share facts are often not written at all, an extraction recall miss. The total-revenue question holds about a quarter of all links (D354).\\n2. **One bet opened twice** about one encounter in five: the collision judge splits a seed question from an identical candidate on a fine detail (D354).\\n3. **A question the standard rules out** (the lidar legislation) was proposed by the extraction and opened in one draw of three (D354).\\n4. **A thesis opened from an article gets no dependency of its own**: the default Jev matching asks for none (`views/jev_matching.py`), although D51 has the matching call choose them; themes still reach every company thesis through the theme block (D191, D195). Found in the 2026-11-05 consolidation; building it is decided (D368).\\n5. **Historical coverage-start reading, retired by D370** (D364–D366): the capital-spending line is missed in about one read in six (the question is then left as it was); a labelled guidance figure is written with the fact tier; later reports reach the questions only through the daily stream; `scripts/preflight.py` does not replay the reading's check.\\n6. **Measured on one company and one 14-day window**, the judgement scored at the window end only; no version of the current pipeline has completed a longer window (a 60-day run of `poc-v108` was stopped at Alex's word after 2026-07-15, [log row 8](research/2026-11-04-argument-record/log.md)). The China-share question (v17) swings between draws (0 of 3 in the acceptance, 2 of 3 in its control, 1 of 3 in the frozen draws): two readers found the starting figures did not cause the acceptance's drop, and the byte-identical extraction request kept a \\\"share fell to zero\\\" sentence in two candidate draws and dropped it in two control draws. One acceptance draw judged nothing on v16; its cause is not established.\\n7. **What a judgement reads grows with the window** (D358). Argument records (D201) were measured as the remedy on 2026-11-04 and not built: judging-v8 agreed 12 of 17 against 15 of 17, judging-v9's card added little at about half again the judging cost; their code was removed at Alex's request ([log rows 4–11](research/2026-11-04-argument-record/log.md)).\\n8. **Seen once, not traced.** A judgement named a shown theme as a dependency and the check refused it twice, stopping a draw for a day (2026-11-02, D266). The sealed run's review recorded that a succession's opening evidence is not linked to the new question (D358), not yet checked against today's code.\\n9. **Earlier defects, unchanged.** Matching (build log row 49): another document's copy of a figure can be treated as new evidence; one matter can occupy several groups; same-answer candidate references caused seven chain or duplication decisions of the generative matcher; empty `original_who` values can count as the same party; different names for one population cause two of nine Jev merge misses. Nine 2026 aggregate-spending theses under `ai-capex` each have a different population; whether to combine them is a product choice. Extraction's instructions remain narrower than the PRD's important-question rule and omit the personal-memo exception, and extraction can change a quantity's meaning before matching (a guarantee amount against financing provided). Classification keeps its [recorded simulation defects](research/2026-10-25-english/classification-existing-defects.txt). The corpus audit recorded 97 official notices with 56 body and file-name collisions, to re-fetch before relying on a rebuilt corpus. An older intermittent search-test failure is untraced. Fresh Idea allocations vary while saved weights do not; the confidence chart applies the current plan to past states and is not a calibrated probability; broad analyst-prose quality and fresh Idea stability remain unaccepted (the [Idea contract](poc/idea-card.md) lists its limits); generative matching dependencies await `matching-v4`. The readers' doubts about the frozen standard, listed in the [extraction branch's state page](research/2026-11-01-e2e-loop/current-state-extraction-branch-2026-11-03.md), remain for Alex.\\n\\nUpstream supply and the human review pool's output remain deferred.\\n\\n## One next task\\n\\n**Where the lean path stands (2026-11-15; D489 to D542).** Alex is not active (D509); D439 is in force: choices go to the\\ncouncil (an independent Codex review and Claude) until consensus, recorded citing D439; nothing is pushed, deployed, published or\\ncommitted; paid calls stay within D439's $40 ceiling (about $18.42 recorded; $0.0134 sent in this period, the ten judge calls of\\nD511 and D519; the lean path $8.34 in all). Every stretch below is closed; its full record is in the decision log and in\\n`research/2026-11-14-use-acceptance/LEAN-LOG.md` (sections 1 to 43).\\n\\n- **The choice between the systems is not made.** The fresh week did not separate them (D489, \\\"not clear\\\"; nothing since ranks\\n  them). The comparison that could choose by measurement was sized and not sent: at the proposed size it may miss differences\\n  that matter ([sizing](research/2026-11-14-use-acceptance/comparison/COMPARISON-SIZING.md), D517). **Production stays the default\\n  and both systems stay (D518).** Alex's product choice on the company's financial figures stands (D505: evidence for related\\n  questions, no table and no questions of their own; D382 and D384 stand).\\n- **For Alex:** the [decision page](research/2026-11-14-use-acceptance/DECISION-PAGE-2026-11-15.md) (its section 7 is the one list\\n  of what is his to choose, what he has decided and awaits building, and the defects with their evidence), the\\n  [side-by-side week](research/2026-11-14-use-acceptance/side-by-side/SIDE-BY-SIDE-WEEK.md) and the\\n  [judge note](research/2026-11-14-use-acceptance/unsupported/DESIGN-NOTE.md) with its one choice.\\n\\n**Open defects found on this path, each with its evidence; nothing is built on any of them:**\\n1. **The new system's delivery gap** (D506, D508, D513, D514): a kept fact that bears on a question by a step of reasoning may be\\n   linked to another question or to none, and so never reach that question's judge; the later-linking step skips a group whose\\n   original statement arrived under another question. Three confirmed fact-and-question pairs in the fresh week, 23 unresolved\\n   ([census](research/2026-11-14-use-acceptance/delivery-class/CLASS-CENSUS-RESULT.md)); one six-call test of its effect was\\n   inconclusive ([result](research/2026-11-14-use-acceptance/effect/EFFECT-TEST-RESULT.md), D511). Paused.\\n2. **The judge, shared by both systems** (D519, D520): on a question that asks for an amount it names a band when nothing shown\\n   sizes the amount, or closes the last gap with a number of its own (36 of 438 stored readings;\\n   [census](research/2026-11-14-use-acceptance/unsupported/UNSUPPORTED-CENSUS.md)). Three of the ten settled unsupported answers\\n   coincided with a figure the system held and had not delivered to that question\\n   ([result](research/2026-11-14-use-acceptance/missing-input/MISSING-INPUT-RESULT.md), D530 to D532). What the product shows is\\n   Alex's choice (the judge note).\\n3. **The old system's duplicate questions** (D520 to D523): three pairs in the fresh week; one second question was never compared\\n   with the first, the others were compared and kept apart\\n   ([result](research/2026-11-14-use-acceptance/duplicates/DUPLICATES-RESULT.md)).\\n4. **The old system's filing under the broader question** (D529 to D531): the data-center revenue question never received the\\n   next quarter's guidance or a consensus for the year, filed under total revenue only\\n   ([cases](research/2026-11-14-use-acceptance/d375-measure/SAME-DAY-CASES-RESULT.md),\\n   [trace](research/2026-11-14-use-acceptance/missing-input/FILING-TRACE-RESULT.md)). The relation `docs/prd/10-filing-phase.md` §2 names.\\n5. **Where decisions and code part on dependencies** (D541, D542): `writing.write` drops an edge that would close a circle with a\\n   note where PRD 06 says refuse and ask for a correction; PRD 06's \\\"historical only\\\" branch has a reader and no writer; the\\n   label the seeding module writes on every seed edge (`last_end`) is defined nowhere; no decision says what happens to a later\\n   proposal with another direction for a pair already read.\\n\\n**Decided by Alex, awaiting implementation and acceptance (not asked again):**\\n- **D375, each article sees the questions committed before it.** A passed, bounded serial proof with labelled fake answers\\n  ([result](research/2026-11-14-use-acceptance/duplicates/D375-PROOF-RESULT.md), D526, D528); the eligible same-day cases of the\\n  fresh week read (D529). A real measurement needs a new version of the reading request and a paid run; not opened.\\n- **D368 item 2, the matching step chooses a new question's dependencies.** In the unseeded fresh week one clear case among 97\\n  pairs (data-center revenue reading total revenue;\\n  [census](research/2026-11-14-use-acceptance/dependency-selection/DEPENDENCY-SELECTION-CENSUS.md), D537). As the code stands\\n  one stored edge has two readers (whose conclusion to read; which of two homes is the narrower): the same edge would remove\\n  seven filing links ([proof](research/2026-11-14-use-acceptance/dependency-selection/EDGE-PROOF-RESULT.md), D538). A design that\\n  reads the two uses apart is recorded as **a provisional candidate, not sound for build**\\n  ([design](research/2026-11-14-use-acceptance/dependency-selection/SEPARATION-DESIGN.md), D539 to D542): two proofs on stored\\n  data, the package's suite run under it, every stored dependency row classed. If the slice is reopened, its review must first\\n  settle the cycle through an awaited question at creation, closing behaviour, a theme shown twice, the historical readers and\\n  the label. A statement's home is not something an edge can decide (its section 2.5): the reading step's, the filing phase's\\n  subject. No selection call is designed; nothing was sent.\\n- **D368 item 4, the reading direction for preset questions** (settled by Claude on Alex's delegation): not measured (D536); the\\n  stored seeded draws already agree with the frozen reference on 15, 15 and 16 of 17 questions; the rebuild and dry-run harness\\n  is kept ([page](research/2026-11-14-use-acceptance/dependency-channel/CHANNEL-ASSESSMENT.md)).\\n\\n**The one next task (D542, council round 33):** the dependency stretch is closed and this status is its consolidation. No open\\ninvestigation outranks that closure on the choice between the systems. What follows is a cold reflection council over the whole\\nlean record (D466; a fresh independent reading, not the thread that ran the last ten rounds): rank what is left from the goal,\\nand either name one next step with its falsifier or confirm that the next step is Alex's choice on the decision page. Nothing is\\nsent and no frozen piece changes before its consensus.\\n\\nThe paragraphs below are the record of where the clean path's Step 4 stood on 2026-11-12.\\n\\n**Clean Step 4 (D396–D430):** the ladder step was measured four times and has not passed Alex's lines; it is frozen as it ran\\nin the fourth measurement (D426). The frozen judge's baseline on the ruler's ladders is read (3% unsupported, all in figure\\nquestions). **Stage B (the judge on the ladder step's own questions) ran and does not pass** (2026-11-12,\\n[result](../clean-arch/step4-2026-11-10/stage_b/STAGE_B_RESULT.md)): the control line is unexercised (4 controls comparable with\\nreader B's material shown, 8 needed; all 4 agree); the judgement lines are met except the last-judgement line on its strictest\\nreading (3 of 24). Next: the diagnosis of how Step 1 cuts a matter into theses (D432), including council B's $0 trace of the 8\\ncontrols excluded on the question and the 3 with missing material; the end-to-end gate is against production as it now runs,\\nwith no preset questions (D431). Where the whole clean path stands, read by the council:\\n[progress](../clean-arch/step4-2026-11-10/PROGRESS-2026-11-12.md), [consensus](../clean-arch/step1-unfiled-2026-11-08/council/kr-consensus.md).\\n\\n- **What Step 4 is:** the first thing built and tested is the **ladder step alone**: the call that turns a thesis Step 1 opened\\n  into one judged question with its answer ladder and due day, or declines. The frozen judge follows only when the ladder step\\n  meets its lines (Stage B, run 2026-11-12: does not pass).\\n- **Alex's decisions in force (2026-11-10):** one judged question a thesis, the other parts shown as not judged (D397); the step\\n  carries D186 in full (D398); the request may teach how to build an event's five states (D399); Stage A is read against his six\\n  fixed lines with no paid control arm (D400); build and send Stage A capped at $3, a missed line stops and goes to him (D401);\\n  an event's due day is a stated date or the period's last day (D403); a theme's state is never named with a company label\\n  (D404); a reference's words are the article's own, else the answer is sent back once (D405); the build uses the request as\\n  first sent, and code refuses and sends back the faults of writing (D407).\\n- **How the build was reached:** twenty single reviews and five rounds by angle did not reach zero findings (15, 9, 15, 11, 11);\\n  four small sends ($0.105) then showed that sentence changes to the request corrected the writing and lowered the declining of\\n  topics with no main thing (`clean-arch/step4-2026-11-10/probe-2026-11-10/READING-claude.md`).\\n- **The build** (`clean-arch/step4-2026-11-10/ladder/`, `stage_a/`): the step, its model caller, the Stage A runner with one\\n  spending limit and an on-disk ledger, the accounting, the readers' packets and the collection of readings; 109 tests, with a\\n  mutant for each check (40, 11 and 16, all caught).\\n- **Stage A, sent 2026-11-10** (44 stored theses, three sends each; $0.17 of the $3): 111 ladders, 17 declined, 4 refused twice\\n  by code. Two reader families and a third reader on the 73 marks where they differ:\\n\\n  | line | as ruled | whoever reads |\\n  |---|---|---|\\n  | 1. no ladder asks another question | missed, 11 of 111 | 0 failed by both families |\\n  | 2. no ladder leaves a part unlisted | missed, 4 | 0 failed by both |\\n  | 3. no outcome with no rung or two | missed, 16 | missed, 7 failed by both |\\n  | 4. no refusal without a justified reason | missed, 2 of 17 | missed, 1 failed by both |\\n  | 5. 35 of 44 theses right in two of three sends, 28 by a ladder | missed, 21 and 16 | 36 and 30 if every differing mark held |\\n  | 6. the three sends agree | missed: the favourable end differs in 2 of 8 theses, the due day in 11 of 32 | by code |\\n\\n  The two families read the form at different strictness (47 against 84 of 111 ladders sound) and the third reader is of the\\n  stricter one, so the count as ruled is the strict reading. The 25 ladders both families fault are the firm set: five states\\n  for the company in 10 of 17, yes/no in 2 of 24, figures in 12 of 67.\\n- **The classes** (result page): an event's five states (gaps, overlaps, labels, the object); a Yes that needs a confirmation\\n  the No does not; a reported amount carried as the market's expectation, and an expected range the field cannot hold; a\\n  figure's due day estimated anew in each send; the direction of a commitment's amount; a company's quarterly figure laddered; a\\n  group named and not listed, which the families read differently.\\n- **Stage A does not compare the step with production** (D400). The reference reading of 36 production ladders, other\\n  questions, held every firm mark on 19 and on 25 by two readers.\\n\\n- **Open defects of the ladder step:**\\n  - it misses its lines in both measurements; the event answers are changed (D409) and their class is smaller, not closed; a\\n    figure's due day, the reference (D411), a company's quarterly figure and the direction of a commitment's amount are not\\n    yet changed;\\n  - the readers' two families differ at every level (first readers 60 against 90 of 114 ladders sound; third readers agree on\\n    21 of 70 points), so a line's verdict can turn on the reader;\\n  - check 6 sets a footnote marker aside, one thing more than D405's record names: reported to Alex, not confirmed;\\n  - the check on pointing at the item misses \\\"at the item date\\\" (one instance in 111 ladders); mark Q owns the rule;\\n  - the design lost its block on the outcomes of a send, the lines and the accounting at version 29 and had it put back at\\n    version 31; the fourth and fifth review rounds read the design without it.\\n- **Alex decided on the result (2026-11-10):** stay at this step, change the event answers first, check at no cost and have it\\n  reviewed, then run the same Stage A once more within the $3; the other classes one at a time; no Stage B (D408). An event is\\n  answered in at most three outcomes, it happened, it is ruled out, or neither, the last written by code (D409, superseding\\n  D399). A group named and not listed is not a fault of a question (D410). An amount already reported may be a figure's\\n  baseline when named as that, built after the event answers (D411).\\n- **Done since, at no cost** (design version 32, §5.2.1): the request, the schema, the checks and the view writer answer an event\\n  in three outcomes; eight stored theses whose first answers had a gap are answered by hand and pass every check, each former\\n  gap in one rung; the form carries D410 and the event rules; a differing mark goes to two third readers, one of each family,\\n  and an unresolved point is counted both ways.\\n- **Reviewed, probed and sent again (2026-11-10).** Three council rounds on the change did not say \\\"ready\\\"; what they found was\\n  closed by one structural rule (code writes the scope of a ruling out: new, whole and standing) and read by two families on\\n  stated facts (20 of 20 alike, then 21 of 23). A small send (26 theses, $0.03) showed the model writing the new shape; a\\n  decline check beside a fresh control showed 8 against 9 of 15. The second Stage A was sent on my reading that the council's\\n  two conditions were met, not on its clearance ($0.15; 114 ladders, 16 declined, 2 refused twice).\\n- **Alex's instruction (D412):** every round is reflected on in the council to a recorded consensus, then the next test goes\\n  straight ahead on the PRD and its numbers, with every trace read by Claude itself.\\n- **The reflection council's consensus (round log §69, `council/ja-*`, `jb-*`):** no change to the request, the checks or the\\n  form until the second result is read in full and reported; then one next step (if the event class is not closed, report\\n  it, and fix at this step only where the cause is found and no decided rule changes; if it is closed and the lines are still\\n  missed on due day or direction, diagnose the figure's due day over its whole class first); the next stage is not asked for\\n  in advance. Alex decides: any change to what the product does; an important part of a thesis that three outcomes cannot\\n  carry; whether an event undone counts as happened; the footnote marker; the next stage.\\n- **Second Stage A, read (2026-11-10;** [result](../clean-arch/step4-2026-11-10/stage_a/result-2/RESULT.md)**).** The six lines are\\n  still missed. Regression: the due day is the same across sends in 18 of 34 theses, against 21 of 32. On what both first\\n  readers fail, against the first run: R on 4 ladders (7), N on 0 refusals of 16 (1 of 17), 37 theses right and 32 by a ladder\\n  (36 and 30), event ladders with a fault 8 of 43 (13 of 44), theses whose three sends differ in shape 1 (7). On the two third\\n  readers' agreed rulings: Q fails on 2 ladders, L on 1, R on 5; 34 theses right and 29 by a ladder, against the 35 and 28 asked.\\n  The favourable end still differs in the same two theses. The two third readers, one of each family, agree on 21 of 70 points,\\n  so every line is reported under both countings, and how many ladders are sound cannot be said from readers alone.\\n- **The council's consensus on what follows (round log §69, `council/jc-*`):** the event class is smaller and not closed, so\\n  it is diagnosed in full first, at no cost (the model's own ruled-out sentence not bound to a decision after the article; a\\n  question and an answer with different periods; a 2027 question judged in 2028; the object of a regulator's decision); then\\n  the figure's due day over its whole class, with D411's reference checked on its own; the changes and a plan go to an\\n  independent review; a third Stage A needs Alex's word. Reading disagreements a document settles are settled; the few that\\n  need a decision go to Alex.\\n- **Done since, at no cost (round log §69, council `jd`):** the event class counted on the second run (a ruled-out sentence with\\n  \\\"after\\\": R held by both readers on 27 of 31; without: failed or disputed on 9 of 11); one clause of code's sentence changed\\n  so that the scope governs the model's own sentence; proved on six real answers shown with the sentence as it was and as it\\n  is (`dryrun14/`): both reader families place an earlier decision in \\\"ruled out\\\" 6 of 6 before and in \\\"still open\\\" 6 of 6\\n  after, 36 of 36 placements alike and as fixed beforehand. The proof is of six sets of stated facts, not of the judge, and\\n  the event class is not called fixed (a question and an answer with different periods; a missing ruled-out rung; the object\\n  of a regulator's decision). A figure's due day counted on both runs and a candidate rule replayed\\n  (`stage_a/due_day_rule_replay.py`): agreement 18 to 32 of 34, with three figures set months late; no rule is recommended yet.\\n- **D411's reference, built, reviewed and probed (design §5.2.2; round log §69, councils `je`, `jf`):** the reference carries its\\n  kind (expected, or last reported for a figure) and a range by its two ends; the judge's middle rung says \\\"the amount last\\n  reported\\\" for a reported amount. Two council rounds corrected it before any send (a range is spanned end to end by the\\n  middle range; \\\"the same quantity\\\" is defined against a part, a ceiling and another quantity). A small send on 18 theses\\n  ($0.016, one draw) filled the field as written beforehand in all seven reference cases, kept the declines for no main thing,\\n  and sent back no first answer for its quotation (the second run: 68 of 132), which is not claimed until a full run shows it.\\n- **After the reference change: what else moves, and line 6** (round log §69; councils `jg` to `jj`;\\n  `clean-arch/step4-2026-11-10/probe-direction-2026-11-10/RESULT.md`). Read by hand, the small send also showed three company\\n  figures called \\\"higher is good\\\" and two events with a worse ruling out. A three-arm probe registered before its send (the\\n  request as the second run sent it; the working request; the working request with `unclear` allowed for a company figure's\\n  favourable end; 96 first answers, $0.074) found no signal that the reference change caused either: the old request sent in\\n  the same run shows both. It also showed the quotation refused in 15 of 34 first answers of the old request against 5 of 35.\\n  Line 6's two halves were counted at no cost: the favourable end differs within a thesis on two obligation theses in both\\n  full runs, and the model's own account says the texts do not settle it; two independent readers of the texts alone find\\n  \\\"lower\\\" settled in none of seven obligation theses, where the working request says \\\"lower\\\" in 19 of 21 answers. Letting the\\n  model answer `unclear` moved the wobble to two other theses (not shown to work by the registered test). The due day is the\\n  same in 18 of 34 theses and would be in 32 of 34 with a day set by code from the year.\\n- **Alex's choices (D413, D414, D415; 2026-11-10):** where the texts do not settle it, an amount the company owes or\\n  guarantees is registered with the lower end favourable; code sets the due day of a year's figure whose day would be an\\n  estimate (the fiscal year-end plus 60 days; a calendar year-end plus 90); the third Stage A is sent without asking again\\n  once each change is proved small and reviewed, and a change that does not pass stops and goes to him. Both rules are built\\n  (design §5.2.4). D414 replayed at no cost on the second run's stored ladders: one due day in 31 of the 33 theses still\\n  whole (18 of 34 as sent), the new refusal firing only on the three theses that are not a year's figure.\\n- **The third Stage A (2026-11-10; `clean-arch/step4-2026-11-10/stage_a/result-3/RESULT.md`):** sent under D415 after two\\n  small sends proved D413 and D414 (a sentence first added to the request with D414 was refuted by the first small send and\\n  removed; `probe-d413-d414-2026-11-10/RESULT.md`). 132 sends, 108 ladders, 24 declined, none refused twice; $0.11. **Line 6\\n  is met on both halves** (the favourable end the same in 9 of 9 company-figure theses; one due day in 34 of 35). Lines 4\\n  and 5 are met on the two readings that favour the answer (37 theses right, 29 by a ladder) and missed on the strict one.\\n  **Lines 1 to 3 are missed on every reading**, by 1, 1 and 3 ladders that both first readers fail (a survey question re-cut\\n  to a calendar year; a part not listed; three events that write the wait as the ruling out). The two third readers agree on\\n  21 of 70 points. Spent under D401's $3: $0.755.\\n- **Alex's answers after the third Stage A (D416 to D419; 2026-11-10):** the six lines stay; the ruling out of an event is\\n  tried as a typed answer (who decides, what they decide) and proved small first; a rolling twelve months with no\\n  publication day is declined; a government's permission or ban on a class of products belongs to the theme; the fourth\\n  Stage A is sent without asking again once each change is proved small and reviewed. The largest thing both readers fail\\n  was diagnosed first: a wait written as the ruling out, 7 of 140 stored event answers read in full, six on product-deadline\\n  theses (`stage_a/result-3/wait-as-ruling-out-hand-read.md`).\\n- **After the third Stage A: four rules of Alex's, each tested alone, then the fourth Stage A (D416 to D421; design §5.2.5;\\n  `clean-arch/step4-2026-11-10/stage_a/result-4/RESULT.md`).** D417 (a rolling twelve months with no publication day\\n  declined), D420 (an authority's proceeding always has a ruling out), D418 narrowed (a tracked government decision is the\\n  theme's) and D416 (an event's ruling out as who decides and what they decide) each passed a small send of its own; the\\n  typed ruling out failed its first trial and passed its second, after D420. The fourth Stage A: 132 sends, 104 ladders, 27\\n  declined, 1 refused twice; $0.11. **Lines 2 and 6 are met under every reading** (the favourable end the same in 9 of 9;\\n  one due day in 33 of 33 theses whose three sends are ladders). Line 5 is met on the two readings that favour the answer\\n  (40 right, 31 by a ladder) and missed on the strict one (34 and 25). **Lines 1, 3 and 4 are missed**, by 1, 2 and 3\\n  answers on the third readers' agreed rulings (0, 1 and 2 on what both first readers fail): a Kyber question that both\\n  branches of its thesis answer Yes; a question and a Yes condition on different periods; a \\\"restructuring\\\" counted as a\\n  ruling out; three declines for \\\"two figures, none the main one\\\" that no earlier run had. The third readers agree on 29\\n  of 53 points. Spent under D401's $3: $1.136.\\n- **The second-look test (D422; `clean-arch/step4-2026-11-10/probe-second-look-2026-11-10/RESULT.md`): it did not pass.**\\n  76 answers of the fourth Stage A, each sent back once with one instruction that names no fault ($0.12); one blind\\n  reading round of 102 items. Of the 18 answers with an agreed fault, 6 mended (9 needed); of the 30 unfaulted, 3 counted\\n  against it (the page fails at 3). It mends what one rule and one field show (the three wrong refusals, a ceiling as a\\n  reference, a missing unit); it removed two correct references, turned a correct refusal into a ladder and traded one\\n  fault for another twice. The round also re-read the fourth run's answers: 14 of its 18 agreed faults are agreed again;\\n  the two third readers rule alike on 22 of 54 points. Spent under D401's $3: about $1.25.\\n- **Alex's answers (D425, D426):** the second look is not adopted; the ladder step is not tuned further on the 44 theses and\\n  no fifth Stage A is sent. **Stage A has not passed** (lines 1, 3 and 4 missed by 1 to 3 answers of 131). By his word the\\n  preparation of Stage B opens on the step as it ran in the fourth Stage A; no paid Stage B send without his word again.\\n- **The Stage B baseline reading (`clean-arch/step4-2026-11-10/stage_b/RESULT.md`):** the frozen judge on the ruler's\\n  hand-written ladders, 159 stored judgements read by Codex and Claude Opus 5.5 after seven reviews of the plan: 4 of 151\\n  decided judgements UNSUPPORTED (3%), all in figure questions (4 of 52, 8%; yes/no 0 of 99), 7 INSUFFICIENT, 16 of 16\\n  questions end the window SUPPORTED. Every fault is in three figure questions before a sized amount is in view. Controls:\\n  6 of 6 planted caught by both families. The lines' chance behaviour is measured (`line_chance.py`). Council B consensus\\n  (`km`, `kn`): put Stage B's lines and the paid send to Alex.\\n- **Stage B (2026-11-12, `clean-arch/step4-2026-11-10/stage_b/STAGE_B_RESULT.md`): does not pass.** Three draws, 236\\n  judgements, $0.42; the reading plan reviewed five times; trial 6 of 6; both families caught 6 of 6 planted answers. Line 3\\n  unexercised (eligible 7, material shown 4, all agreeing). Lines 1 and 2 met (26 of 26); figure 3.4/3.2/10.5% against\\n  12.7/12.5/14.4%, yes/no 0.9/0.8/4.9% against 5%: met; last judgements missed 3 of 24 on the strictest reading. The families\\n  differ on 22 of 236 and the third readers split on 12 (9 along family lines). Patterns: three-outcome events kept at \\\"Still\\n  open\\\" because nothing is settled yet (Kyber); figure questions with no reference figure the evidence cannot size (19\\n  INSUFFICIENT); a figure carried forward. Council B (`council/la-codex.md`): stands with corrections, applied.\\n- **The control trace (done, `stage_b/CONTROL_TRACE.md`):** most of the 8 question differences are already in the Step 1\\n  thesis (the article's angle: a programme inside a total, the reported date, a later milestone); two missing items are stored\\n  with no link to any thesis though the capex thesis was open; leads, not an attribution.\\n- **The Step 1 diagnosis (D432, `clean-arch/step1-diagnosis-2026-11-12/DIAGNOSIS.md`, version 8; seven council rounds):** c8 states\\n  \\\"one quantity for one period, or one event\\\", but its merge rules carry neither D38's year boundary nor D388's signing exception;\\n  the second year of an annual quantity is never opened (3 graded misses). Proposed to Alex: carry D38's year boundary into two\\n  merge sentences (+151 characters), first tested on stored articles with a c8 arm. Recorded, not proposed: outcomes with a second\\n  thing in them (under most of Stage A's ladder faults, a class to investigate); rolling periods and small matters against c8; a\\n  contract gap between c8's shared_quantity and the ladder step's object and theme rules.\\n- **c14 (D433), stage 1 (`clean-arch/step1-diagnosis-2026-11-12/STAGE1-RESULT.md`): does not pass.** Both years of hyperscaler\\n  capex opened apart in 7 of 9 sends against a line of 8 (c8 0 of 9); one send lost the capex question (c8 never); $0.24. The\\n  misses: the model choosing one year as the bet, and c8's \\\"a customer expanding capacity … is not a thesis of its own\\\" colliding\\n  with shared_quantity. Stage 2 not sent; c8 stays in force.\\n- **Gate 1 done** (`clean-arch/step1-diagnosis-2026-11-12/gate1/`, D435, D436): change 2 (the capacity counterexample scoped) passes\\n  G1-b; changes 1 and 2 together fail G1-a, separating the two years of hyperscaler capex in 5 of 9 sends against a line of 8 (c8: 0 of\\n  9; 20 of 26 over every year-wording send on that article). The misses decline the second year as too much. c8 stays in force.\\n- **Alex carried changes 1 and 2 to gate 2 (D437).** Gate 2 (`clean-arch/step1-diagnosis-2026-11-12/GATE2.md`, version 11) passed\\n  its review in round 11 (`council/mi-codex.md`): c15yc against c8 on seven stored neighbours in three draws, 126 sends, about $1.8,\\n  ceiling $2.2.\\n- **Authority (D439, 2026-11-13):** Alex is not active; every choice goes to the council (Codex + Claude) until consensus, recorded\\n  citing D439. Paid spending in this period: $0.83 (gate 1) of a $40 ceiling (Claude's setting); gate 2 sent on Alex's word (D438).\\n- **Step 1's combined candidate stopped (D441).** Gate 2 failed on the memory article; the council's memory diagnostic (D440) found\\n  c15yc opens a memory-price question less often (17 against 28 of 54, interval -34.6 to -4.8) and pushes it from the ruler's\\n  2027-against-2026 shape to 2026; c8 stays. Spend so far $4.77 of the $40 D439 ceiling.\\n- **The next step (D442–D444): an exploratory end-to-end census.** The clean path's stored chain (unseeded draws 2026-11-10, Stage A\\n  run-4 ladders, Stage B judgements) against fresh production draws (`poc-v118`, no seeded questions), on the frozen judgement ruler by one\\n  method (`clean-arch/e2e-comparison-2026-11-13/DESIGN.md` v4). The first three draws stopped at an over-conservative ledger (D444; kept\\n  as records); three fresh 14-day draws completed 2026-11-13 03:46 (`poc/data/clean-e2e-comparison-2026-11-13/draw-q1..q3`: 243 items\\n  each, 0 failed, 13, 12 and 15 own views; recorded $0.43, $0.46, $0.46). D442's same-day comparison stays owed for D427.\\n- **The census result** (`clean-arch/e2e-comparison-2026-11-13/RESULT.md`): on the seven graded questions both systems agree with\\n  reader B on one or two a draw (production 1/1/1, clean 1/2/1; two unresolved each); no eligible judgement disagrees in either; every\\n  loss is at opening (event deadlines against the standard's rules, the memory comparison never opened, scope). A measuring-stick concern\\n  (D430's same deadline against the standard's 18-month range for q23) is recorded apart (D373), scoring unchanged.\\n- **After the census (D445–D447):** the trace of the clean path's 17 graded opening losses found no single mechanism; a typed-unit\\n  audit found identity fields detect 2 of 16 and recover none, so that line stopped.\\n- **The wiring (D447, D448), built and proved at $0** (`clean-arch/e2e-comparison-2026-11-13/WIRING-DESIGN.md` v4; round log §81): one\\n  shared spending ledger over every paid call (Step 1, Step 2's embeddings and Jev, the ladder step, the judge, production), the\\n  ladder step's and the judge's inputs as arguments, a per-draw orchestrator (`run_fresh.py`). The $0 proof passed: Stage B's three\\n  databases rebuilt row for row through the new inputs; Step 1 (one day), Step 2 (a whole draw, byte for byte), Stage A run 4 (every\\n  outcome of three passes), the judge and production (one day) each sent every network call under a ledger reservation; a ledger\\n  refusal stops every component; bypass mutants are caught. Full suite 287 passed.\\n- **The code review (D449):** eight defects found and closed by four structural rules (stops shared and read before every actual send;\\n  launcher liveness by its lock registered on the ledger; one reservation bound and settlement rule; the proof through the real\\n  orchestrator). `proof_end_to_end.py`: one day through `run_fresh.py` (5 child processes, 55 calls, all reserved), a killed child and a\\n  killed orchestrator handled; full suite 287 passed. Redo of Step 1, Step 2 and production only by a reasoned relaunch; a crash stops\\n  the run.\\n- **The slice (D450) ran and the wiring works live** (`clean-arch/e2e-comparison-2026-11-13/SLICE-RESULT.md`): both draws complete in 8\\n  minutes, every component with real sends on one ledger, every ledger line attributed; $0.159 of ledger (about $0.15 at the published\\n  rates). Every answer read.\\n- **The full run (D451) completed** (`poc/data/clean-e2e-full-2026-11-13/`, 05:44–08:33; c2's Step 1 redone after a dropped response,\\n  D453): ledger $11.43, every line attributed (`spend-by-component.json`). Clean 15/10/15 theses, 69/72/92 judgements; production 12/13/14\\n  views, 92/80/104 judgements, 0 failed. First read in the round log §84.\\n- **The full run, read (D452–D455):** Stage A on the 40 fresh theses misses lines 1–5 and meets line 6 (`STAGE-A-FULL-RESULT.md`); the\\n  census (`CENSUS-FULL-RESULT.md`): settled agreements on the seven graded questions clean 2/1/0, production 1/1/1 (2/2/1 and 2/2/2 with\\n  unresolved points counted), no eligible judgement disagrees, every loss at opening; the clean path kept 51 of 55 decisive facts of its lost\\n  questions, production 39 and left kept Kyber and Ohio facts unlinked; Stage B line 3 unexercised (0 settled, at most 4 of 8), its judgement\\n  reading stopped (D455).\\n- **Traced since (D456–D458), all at $0:** production's kept-but-unlinked facts cost no final answer in this window (three mechanisms,\\n  `unlinked-trace/UNLINKED-TRACE-RESULT.md`); the opening losses hold few shown breaches of the standard, spread over small mechanisms, and\\n  their largest classes are choices the standard leaves open (`opening-review/OPENING-REVIEW.md`); no opening phase is opened.\\n- **Since (D458–D460):** Stage A's first-pass faults form no class (`stage-a-trace/STAGE-A-TRACE-RESULT.md`); the model's accounts make\\n  two opening mechanisms strong leads, the unsigned Ohio guarantee folded into the programme's amount (seven draws, both systems) and the\\n  next year's capex folded into this year's question (five of six clean draws), and show the standard's keep-apart line for unsigned deals\\n  missing from the clean Step 1 request (`opening-review/D459-RESULT.md`).\\n- **Since (D460–D462):** the whole-request audit of clean Step 1 (two readers apart, `step1-audit/AUDIT.md`) finds the standard's identity\\n  boundaries missing from its request (the unsigned deal beside a plan's amount; another year of a shared quantity) and one date sentence\\n  narrower than the standard (F6); F6 decided only one or two of 26 memory declines (`step1-audit/f6/`) and is recorded, not tested alone.\\n  The status report for Alex, reviewed by the council for accuracy: `clean-arch/e2e-comparison-2026-11-13/STATUS-FOR-ALEX-2026-11-13.md`.\\n- **Since (D463–D464):** the identity lever is a prompt clause first; candidate c16 (version 5, four blind audits) and a case-specific\\n  diagnostic on fresh articles (one story per target boundary is all this window holds), 7 merge and 9 negative stories and the stored guards\\n  (`clean-arch/e2e-comparison-2026-11-13/identity-probe/v2/PROBE-DESIGN-v2.md`).\\n- **Since (D465–D466):** the identity diagnostic moved its error (c16 not adopted, c8 stays; `identity-probe/v2/RESULT.md`, $4.49); a deep\\n  reflection council (Alex's request) agreed the second half of the day circled and reset the plan.\\n- **Since (D467–D473):** the ladder-cost proofs are kept as tools (`ladder-cost/`); the ladder-refusal candidate stopped on a contested\\n  \\\"main figure\\\" boundary; the 41 Stage A reader splits recorded, none changing its verdict; the ten right-by-refusal theses traced; the period\\n  candidate c17 failed its frozen lines (memory and federal openings suppressed; `period-probe/RESULT.md`). Step 1 sentence changes on these\\n  articles stop (D473). Provisional choices under D439 (D469): empty-start measurement; the three open shapes stay concerns; the written-ladder\\n  line stands (D471). Alex's answer overrides any of them.\\n- **Since (D474–D477):** the unsigned-deal candidate c18 was not adopted (`unsigned-deals/RESULT.md`). The source check of the eleven\\n  first-pass refusals (`reachability/RESULT.md`): six right, four reachable only on paper, one split. **D477:** Stage A not passed; no theme or\\n  ladder change for the H100 boundary; no more Step 1 sentence changes on these articles; production stays the default; the clean path's\\n  three product choices are written for Alex (`clean-arch/e2e-comparison-2026-11-13/CHOICES-FOR-ALEX-2026-11-13.md`).\\n- **Since (D478–D482), under D439:** choice 2 tested and failed (c19); choice 3 taken (production stays the default); production's price\\n  rule (D191.4) tested and failed (`docs/research/2026-11-13-shared-quantity-price/`); no further paid test on the frozen ruler (D482).\\n- **Alex active again (2026-11-14).** D483–D486: a use-oriented acceptance was designed and its $0 trial read\\n  (`docs/research/2026-11-14-use-acceptance/TRIAL-RESULT.md`); Alex asked for a leaner path (small steps, each run fast). D487: step 1 built nothing (the\\n  \\\"dated after the article\\\" statements are correct dates against items stored a day early); step 2 runs one fresh week (2026-09-22..28, 235\\n  items proved identical for both systems), one draw a system, a one-day slice first, readings A and B, the decision rule written before\\n  reading (`LEAN-LOG.md` §2). Slice passed; production's week draw complete; the clean draw stopped twice on dropped connections, root-caused and fixed (D488: Step 1 resends a\\n  network loss, each attempt on the ledger). The clean week draw completed from empty (`poc/data/clean-lean-week-2026-11-14/week-r2/`, $2.52; both ledgers $4.69). **Result (D489,\\n  `docs/research/2026-11-14-use-acceptance/week/WEEK-RESULT.md`):** not clear by the rule written before reading; no system chosen. Production\\n  covers 4 of the 5 big matters two blind reader families listed, the clean path 2 (it lacks revenue and margin by D382/D384); judgement\\n  support does not rank them at this size. **Waiting on Alex:** whether the new system holds questions on the company's main numbers\\n  (three options, council consensus); nothing is sent before he answers. Tracked spend since\\n  D439: about $29.2 before this step.\\n  Recorded spend under D439: about $18.4 of $40 (about $7.26 before the run; the run's ledger $11.43, somewhat above its cost at the\\n  published rates).\\n- **Open defects recorded by this review:** the frozen judge retried 10, 16 and 18 judgements in the seeded clean draws, 38 of 51\\n  reasons a theme cited as a dependency (PRD 11, E4), and its stored path holds the 2026-07-05 fault above (frozen; findings for\\n  Alex); the same matter takes different shapes between draws (Kyber due end-2027 in one draw and end-2028 in another); under D397\\n  the second bet of a topic that holds two has no answer; five-state event ladders failed by hand three times before a construction now in the request\\n  produced ones that pass a reader; in Stage A the model's own are faulted by both reader families in 10 of 17 for the company.\\n- **The unseeded measurement (D395):** graded subset 4.0 against 6.33 seeded. Every miss is a question not opened in the ruler's shape.\\n  Judged answers 16 of 16, on the ruler's wording and ladder; the system's own questions have never met a judge.\\n- **Stage 2 of D392:** clean 18, 18, 17 against v108 17, 15, 16, inconclusive on q12.\\n- **Known gap (D394):** capital spending (q12).\\n\\nNo long job is running.\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n./docs/research/2026-11-14-use-acceptance/reflection-4/council-codex-26.jsonl:25:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_11\",\"type\":\"command_execution\",\"command\":\"/opt/homebrew/bin/zsh -lc \\\"rg -n -i 'dependency|not built|open defect' docs/CURRENT_STATE.md | head -25\\\"\",\"aggregated_output\":\"54:  re-asked caused the China miss. Observed defect of the frozen judge: it names the export-controls theme as a dependency of the China\\n56:- **Open defects, by product impact** (reflection council, `council/av-codex.md`):\\n140:## Open defects\\n145:4. **A thesis opened from an article gets no dependency of its own**: the default Jev matching asks for none (`views/jev_matching.py`), although D51 has the matching call choose them; themes still reach every company thesis through the theme block (D191, D195). Found in the 2026-11-05 consolidation; building it is decided (D368).\\n148:7. **What a judgement reads grows with the window** (D358). Argument records (D201) were measured as the remedy on 2026-11-04 and not built: judging-v8 agreed 12 of 17 against 15 of 17, judging-v9's card added little at about half again the judging cost; their code was removed at Alex's request ([log rows 4–11](research/2026-11-04-argument-record/log.md)).\\n149:8. **Seen once, not traced.** A judgement named a shown theme as a dependency and the check refused it twice, stopping a draw for a day (2026-11-02, D266). The sealed run's review recorded that a succession's opening evidence is not linked to the new question (D358), not yet checked against today's code.\\n172:**Open defects found on this path, each with its evidence; nothing is built on any of them:**\\n203:  [census](research/2026-11-14-use-acceptance/dependency-selection/DEPENDENCY-SELECTION-CENSUS.md), D537). As the code stands\\n205:  seven filing links ([proof](research/2026-11-14-use-acceptance/dependency-selection/EDGE-PROOF-RESULT.md), D538). A design that\\n207:  ([design](research/2026-11-14-use-acceptance/dependency-selection/SEPARATION-DESIGN.md), D539 to D542): two proofs on stored\\n208:  data, the package's suite run under it, every stored dependency row classed. If the slice is reopened, its review must first\\n214:  is kept ([page](research/2026-11-14-use-acceptance/dependency-channel/CHANNEL-ASSESSMENT.md)).\\n253:step declines by Alex's own rule (D397), a known open defect \\\"until splitting is built\\\"; it starts in the first step's field\\n261:**Open defects found on the way:** (1) a lost attempt is charged its whole reservation on the ledger (about $0.12 against a\\n368:- **Open defects of the ladder step:**\\n590:- **Open defects recorded by this review:** the frozen judge retried 10, 16 and 18 judgements in the seeded clean draws, 38 of 51\\n591:  reasons a theme cited as a dependency (PRD 11, E4), and its stored path holds the 2026-07-05 fault above (frozen; findings for\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n./docs/research/2026-11-14-use-acceptance/reflection-9/cold-codex-1.jsonl:12:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_4\",\"type\":\"command_execution\",\"command\":\"/opt/homebrew/bin/zsh -lc \\\"nl -ba docs/CURRENT_STATE.md | sed -n '1,230p'; nl -ba AGENTS.md | sed -n '27,44p;326,369p'\\\"\",\"aggregated_output\":\"     1\\t# Current state\\n     2\\t\\n     3\\t**Clean Steps 1–3, current (2026-11-11).** Records: Step 1, [round log](../clean-arch/step1-unfiled-2026-11-08/LOG.md) §§16–47; Step 2, [Step 2 log](../clean-arch/step2-validation-2026-11-07/LOG.md) §§12–19.\\n     4\\t- **Step 1 configuration: c8, adopted by Alex (D387).** It runs DeepSeek Flash at high effort, with a 64,000-token output cap; a\\n     5\\t  format failure or a cut answer is resent once (D380). It carries Alex's decisions D382–D385:\\n     6\\t  - figures are conditions;\\n     7\\t  - material statements with no thesis are kept without links;\\n     8\\t  - only big matters open a thesis;\\n     9\\t  - no target prices.\\n    10\\t\\n    11\\t  [PRD §12](../clean-arch/PRD.md) holds its system prompt, closing check and schema; a run with no candidate files sends exactly the\\n    12\\t  accepted request.\\n    13\\t- **Acceptance (D386, [protocol](../clean-arch/step1-unfiled-2026-11-08/ACCEPTANCE-PROTOCOL.md)).** 50 fresh articles that no run,\\n    14\\t  old or new, had used: news from 2026-09-05 to 09-07, a holiday weekend with no NVIDIA posts. One draw; two readers and a third on\\n    15\\t  disputes.\\n    16\\t  - helpful 132/139 (core 83/83);\\n    17\\t  - wrongly opened theses 1 of 10;\\n    18\\t  - search 141/143 available repeat pairs, or 141/145 for the whole system (one 11-article story supplies 55 pairs, and revisions are\\n    19\\t    barely exercised);\\n    20\\t  - clear wrong merges 1/57, plus 2 overlaps;\\n    21\\t  - detail retention 22 = 22. This is a storage comparison: every record keeps its own text. It is not a usability test.\\n    22\\t\\n    23\\t  Dev ×3 on the frozen golden-v5 (a lead): helpful 214, 211 and 212 of 234; search 98.9–100%; clear wrong merges about 1%. Step 1\\n    24\\t  cost for the fresh set plus dev ×3: $4.20 at published rates.\\n    25\\t- **Steps 2 and 3** are built in isolation (`clean-arch/step2`, `clean-arch/step3`): search, comparison, grouping and later linking.\\n    26\\t  They are not integrated with production storage. **Step 4 (judging) has not passed** on the clean path: its ladder step is built and\\n    27\\t  measured (four Stage A runs, lines missed by 1 to 3 answers; D426), so nothing yet shows the clean system can judge an investment\\n    28\\t  view on its own questions.\\n    29\\t- **Step 2 is closed and frozen (Alex, D427, 2026-11-11;** [Step 2 log](../clean-arch/step2-validation-2026-11-07/LOG.md) §§14–19**).** It goes\\n    30\\t  to production only with the whole clean path, after Step 4 meets its lines; `tests/test_frozen_clean_step2.py` guards its files. Its three lines were met at the acceptance above (one draw; \\\"later version\\\"\\n    31\\t  relations barely exercised), and no miss of the seeded end-to-end test (clean 18, 18, 17 against production 17, 15, 16) has\\n    32\\t  been traced to it (the two single-draw misses were diagnosed on 2026-11-11, below: neither traces to Step 2). What happened since the close-out of 2026-11-08:\\n    33\\t  - A change to Jev's wording for \\\"later version\\\" relations failed its line (42 calls, 2026-11-09) and tuning stopped.\\n    34\\t  - One wrong relation was traced to the judge: it put NVIDIA's answer to the Kyber report under the FY2027 revenue question;\\n    35\\t    sent both ways, the conclusion did not differ ([result](../clean-arch/step2-edge-effect-2026-11-10/RESULT.md)).\\n    36\\t  - Alex stopped work on that relation (D423) and asked for a fix to the rule that gives a \\\"later version\\\" the older record's\\n    37\\t    questions. Measured on the three saved draws ([round log](../clean-arch/step2-revision-links-2026-11-10/LOG.md)), removing the\\n    38\\t    rule was withdrawn: of the 24 links it wrote, two blind reader families call 19 context and 3 evidence, and one of the 3 is a\\n    39\\t    company's answer that would otherwise be missing beside four reports (with it rung 2, 2, 2; without it 2, 3, 2). **The rule\\n    40\\t    stays (D424).**\\n    41\\t  - **Open, recorded:** Jev's \\\"later version\\\" relation (9 of 30 join different statements in draw 1); the context links it carries\\n    42\\t    (19 of 24); wrong groups (at the line on one draw; the unprompted reading test never run); the \\\"Unverified quote\\\" mark not\\n    43\\t    shown to Jev (3 of 188); not decided, whether a company's answer must sit under every question its report is filed under.\\n    44\\t  - **Reopens when** Step 4 yields judged views on the clean path and a miss, or something a reader of a thesis sees, traces to\\n    45\\t    one of these. The round's measurement kit (replay of a saved draw, exact simulation of a writer rule, blind packets with\\n    46\\t    controls, a judgement sent both ways) is kept in the two folders above.\\n    47\\t- **The clean system's untraced end-to-end misses, diagnosed (2026-11-11;** [round log](../clean-arch/e2e-misses-2026-11-11/LOG.md)**).**\\n    48\\t  The China share question in draw 3 and the FY2028 revenue question in draw 2 (seeded test, D392). Both estimates sit on a rung\\n    49\\t  line. China: the same window-end request, re-sent, gives the miss twice and the right answer once (the judge's own variation at the\\n    50\\t  1% line); no H200 price is in any request. FY2028: draw 2's window-end request gives the miss 3 of 3 and draw 3's the right answer 3\\n    51\\t  of 3; draw 2's lacks records draw 3's holds (a \\\"41% in calendar 2027\\\" figure Step 1 filed under FY2027 only, \\\"$1 trillion of\\n    52\\t  Blackwell and Rubin visibility\\\", five infrastructure-demand records), not isolated which matters; FY2028 is the question whose filed\\n    53\\t  statements differ most between draws (47% shared, median 74%). Neither traces to Step 2. Refuted on the way: that a refused answer\\n    54\\t  re-asked caused the China miss. Observed defect of the frozen judge: it names the export-controls theme as a dependency of the China\\n    55\\t  question, 42 of 65 refusals in six draws, and the re-ask changed the rung 8 times (PRD 11, E4). No change proposed; 18 sends, $0.043.\\n    56\\t- **Open defects, by product impact** (reflection council, `council/av-codex.md`):\\n    57\\t  1. **The Ohio-guarantee yes/no question is never covered** in the three dev draws; a broader credit-support amount thesis opens\\n    58\\t     instead. Diagnosed (round log §48): the model folds the unsigned guarantee into the open aggregate thesis because the request\\n    59\\t     uses \\\"covers\\\" both for \\\"is evidence for\\\" and for \\\"already asks this question\\\". The same clause sits under link clutter.\\n    60\\t  2. **A revenue-share thesis was opened** (Vera Rubin's share of data-center revenue), the class-A boundary of D382.\\n    61\\t  3. **Link clutter.** A blind recheck of the 34 disputed fresh links found 19 weak and 2 wrong; 10 accepted links mixed in as controls were all useful; the other 49 links were not rechecked.\\n    62\\t     The model's own account names topic or theme overlap and inference chains, and c8's closing check never reads back a link. This is\\n    63\\t     a likely cause, with no fix proven. Alex approved designing a protected link check through the council; a first draft was stopped\\n    64\\t     because it would drop founding premises and contrary facts.\\n    65\\t  4. **Unverified passages:** 3 of 188 fresh records and 1–3 per dev draw. The mark now travels into Step 2's records, and a reader sees the found source text or an \\\"Unverified quote\\\" label. Jev's comparison input still carries the model's text without the mark; changing it changes measured Step 2 behaviour and needs its own measurement.\\n    66\\t  5. **The lidar policy thesis** recurs at the boundary (one dev draw in three).\\n    67\\t- **History.** These earlier states are superseded:\\n    68\\t  - the 2026-11-07 takeover (K5 → K6b; [takeover log](../clean-arch/takeover-2026-11-07/LOG.md));\\n    69\\t  - the 2026-11-08 close-out (K6b test 32/42; Step 2 first lines; [Step 2 log](../clean-arch/step2-validation-2026-11-07/LOG.md) §12);\\n    70\\t  - the unfiled fix round and the c1–c7 arms (round log §§1–39).\\n    71\\t- **No run is live.** The branch is committed through the D388 line (round log §§48–59).\\n    72\\t\\n    73\\t**Clean Step 1 source investigation (2026-11-07):** A [source-loss census](../clean-arch/STEP1-SOURCE-LOSS-CENSUS.md) traces two separate losses in the historical cleaner and records reproducible corpus observations. Offline candidate comparisons expose both recovered content and source-identity or contamination risks. A subsequent [full-page diagnostic](../clean-arch/STEP1-FULL-PAGE-RESULTS.md) completed 102 calls on 17 selected articles and independent source-backed review. It exposes examples of both missing or misattributed source text and model errors that persist despite the right text being present. A Codex–Claude council is reviewing the results and earlier attempts; no source-cleaning candidate is adopted, and the source corpus and production defaults are unchanged.\\n    74\\t\\n    75\\tAlex has authorized correcting the test-source cleaner and test data when their defects are confirmed, while the frozen production configuration and ruler remain intact. The cleaner switched 615 originally fed articles off; a replay reproduces all 615, and direct inspection confirms an actual article excluded because its 9,874-character body was flattened to one line. Other examples include a wrong-site shell, paywall and long challenge code, so the false-exclusion count and a general article-identification repair remain to be established. The [council regroup](../clean-arch/STEP1-SOURCE-REGROUP-COUNCIL.md) and [source-preservation design](../clean-arch/STEP1-SOURCE-PRESERVATION-DESIGN.md) describe an isolated candidate checked against all 34,084 records, with a fake-answer actual-runner handoff and provenance display in the replay renderer. The [five source-control calls](../clean-arch/STEP1-CAPTURE-CONTROLS-RESULTS.md) completed and were source-reviewed; two items contain summary details absent from their attached quotations, and one source-visible risk explanation was not returned. This is selected-case evidence, not a general quality result. Broader source-quality comparison, citation completeness and actual writer integration remain open.\\n    76\\t\\n    77\\t**Clean architecture Step 1 (2026-11-06, isolated work on `clean-arch`):** Alex reopened work with the clean architecture. An experimental prepared-source handoff now preserves the archived page, prior cleaned text, source-role decisions and selected-line mapping without changing the original database; quotations for prepared items must also occur contiguously in the original captured page. Two seven-item runs are available in the [clean architecture PRD](../clean-arch/PRD.md), one in the earlier selection order and one in recorded page-timestamp order. The source selector is not a production service and source ordering is not established event-arrival ordering. The runs expose unresolved semantic problems: citations can omit supporting facts despite an exact location match; model output can change a benchmark into a deployment, reverse a backup relation, omit a named customer or assign an unstated currency. A blinded 84-call check-placement/wording comparison and a 27-call same-article citation-completion diagnostic did not give a clean semantic fix and are not adopted. The latter missed an omitted connectivity condition and a reversed backup relationship, and left six expected evidence reviews unaddressed. A further five-round Codex–Claude council produced a narrowly scoped Step 1 link candidate, independently checked for prompt-contract drift. A six-article, 36-call blind comparison completed; the candidate still produced an explicitly self-contradictory link and both arms consistently omitted the same Kyber report and company response. It is not adopted and has not changed the active PRD prompt. A trace confirms that both the Kyber report and open Kyber thesis were supplied, and the raw model answers omitted the report and denial; the reason is not established. See ../poc/data/clean-step1-kyber-trace-2026-11-06/TRACE.md. An isolated six-call comparison showed that hiding the Kyber thesis did not recover the report or denial in any draw. A second six-call comparison returned them in 3/3 draws with the original Kyber paragraph alone and 0/3 with the full article; length, position and surrounding content changed together, so the reason is not isolated. Excerpt outputs have source-attribution limitations. Neither experiment changed state or established a production fix. (Superseded: the next task then was a whole-article coverage approach; the current next task is under \\\"One next task\\\".) See ../clean-arch/STEP1-IMPLEMENTATION-COUNCIL.md. The earlier four-round council agreed that no tested semantic fix is ready; its next investigation is a source-backed review of the 49-item historical run and its 160 evidence records, with overlapping issue flags and separate article-level omissions, then a separate comparison of the seven-item replays. See ../clean-arch/STEP1-COUNCIL-REVIEW.md. Preserve relevant evidence while identifying the next intervention; production/frozen history remains as described below. See [Step 1 run log](../clean-arch/STEP1-RUN-LOG.md) and [English reading page](../clean-arch/architecture.html).\\n    78\\t\\n    79\\t**Sealed (D379, 2026-11-06):** Alex asked to clean up and seal this version while he re-plans the system design. Work stops here and is sealed as it is: main's working tree is committed on branch `seal/2026-11-06` (tag `sealed-2026-11-06`) and merged into `main` on Alex's word (PR #10); the sealed split and two side experiments are pushed on their own branches (D379). No PRD 11 experiment is open, and the E1 next task below is withdrawn. The next task is Alex's re-planned system design.\\n    80\\t\\n    81\\t**E1 diagnosed (2026-11-06, Alex chose E1):** of 57 helpful matters frozen production wrote and then dropped, two readers agree on 17 link misses (4 core), 3 opening misses (1 core) and 24 small matters the standard itself drops; 10 are disputed on the fallback clause and 3 were quote refusals. Opening is not the experiment. The core of the link misses is the model reading a question's period, population or named configuration as a boundary; only 8 of the 13 window draws it dropped were lost to the product. No production change; $0.02 of probes. My recommendation was to fold that narrow change into the next extraction version; withdrawn by the seal (D379). Details: `docs/research/2026-11-06-e1-no-home-drops/README.md`, PRD 11 E1.\\n    82\\t\\n    83\\t**Split extraction sealed as a failed experiment (D378, 2026-11-06):** the split (a new-question call, an evidence call and record preparation) was benchmarked against the frozen poc-v108 and failed. Its stop line fired: helpful matters 156, 156, 159 against 166, 170, 162, with about 15% higher cost. One screened revision kept more noise than production. It is sealed in the worktree `hivemind-no-preseed-evidence-review` (tag `split-extraction-failed-sealed-2026-11-06`), and nothing of it is in main. What it taught is written as proposed production experiments in `docs/prd/11-production-experiments-from-split.md`: E1 no-home helpful drops, E2 duplicate questions, E3 ladder checks with D186, E4 judge refusals, E5 D203's revision day, E6 the measurement kit. Each opens only on Alex's word.\\n    84\\t\\n    85\\t**Question-catalog limit removed (D377, 2026-11-05):** Alex also directed removal of the separate 150 KB catalog rejection. The research reader in this worktree now has neither the catalog nor evidence byte limit; it retains full scoped questions, historical boundaries, dependencies and evidence. A portable 326,996-byte catalog test returns all 400 new questions and expands evidence both after reading the catalog and directly; the old 150 KB guard fails the same test in a scratch copy. The saved 69-question pilot catalog and all 69 saved evidence expansions match their original content hashes. Details: `docs/research/2026-11-05-catalog-limit/`. The full suite remains pending until the paid seven-day run no longer competes for resources. The run remains in its isolated worktree and does not call this research reader.\\n    86\\t\\n    87\\t**Evidence reader limit removed (D376, 2026-11-05):** Alex directed removal of the reader's 1 MB evidence-expansion rejection. In this worktree, `research_context.Reader.expand` now returns the entire evidence payload without that cap, while the catalog's separate limit remained at that checkpoint; D377 subsequently removed it. On the saved pilot ledger, all 69 individual question expansions, the four-question 1,931,225-byte pilot request and the entire 3,454,076-byte catalog produce the exact same content as the pre-change high-limit baseline; the portable oversized-ledger test passes and fails when the old cap is restored in a scratch copy. Details and snapshot-specific measurements are in `docs/research/2026-11-05-reader-limit/`. The seven-day diagnostic runs in `/Users/lchingen/hivemind-no-preseed-evidence-review/poc/data/split-fresh-seven\n... 22001 bytes omitted ...\nD370** (D364–D366): the capital-spending line is missed in about one read in six (the question is then left as it was); a labelled guidance figure is written with the fact tier; later reports reach the questions only through the daily stream; `scripts/preflight.py` does not replay the reading's check.\\n   147\\t6. **Measured on one company and one 14-day window**, the judgement scored at the window end only; no version of the current pipeline has completed a longer window (a 60-day run of `poc-v108` was stopped at Alex's word after 2026-07-15, [log row 8](research/2026-11-04-argument-record/log.md)). The China-share question (v17) swings between draws (0 of 3 in the acceptance, 2 of 3 in its control, 1 of 3 in the frozen draws): two readers found the starting figures did not cause the acceptance's drop, and the byte-identical extraction request kept a \\\"share fell to zero\\\" sentence in two candidate draws and dropped it in two control draws. One acceptance draw judged nothing on v16; its cause is not established.\\n   148\\t7. **What a judgement reads grows with the window** (D358). Argument records (D201) were measured as the remedy on 2026-11-04 and not built: judging-v8 agreed 12 of 17 against 15 of 17, judging-v9's card added little at about half again the judging cost; their code was removed at Alex's request ([log rows 4–11](research/2026-11-04-argument-record/log.md)).\\n   149\\t8. **Seen once, not traced.** A judgement named a shown theme as a dependency and the check refused it twice, stopping a draw for a day (2026-11-02, D266). The sealed run's review recorded that a succession's opening evidence is not linked to the new question (D358), not yet checked against today's code.\\n   150\\t9. **Earlier defects, unchanged.** Matching (build log row 49): another document's copy of a figure can be treated as new evidence; one matter can occupy several groups; same-answer candidate references caused seven chain or duplication decisions of the generative matcher; empty `original_who` values can count as the same party; different names for one population cause two of nine Jev merge misses. Nine 2026 aggregate-spending theses under `ai-capex` each have a different population; whether to combine them is a product choice. Extraction's instructions remain narrower than the PRD's important-question rule and omit the personal-memo exception, and extraction can change a quantity's meaning before matching (a guarantee amount against financing provided). Classification keeps its [recorded simulation defects](research/2026-10-25-english/classification-existing-defects.txt). The corpus audit recorded 97 official notices with 56 body and file-name collisions, to re-fetch before relying on a rebuilt corpus. An older intermittent search-test failure is untraced. Fresh Idea allocations vary while saved weights do not; the confidence chart applies the current plan to past states and is not a calibrated probability; broad analyst-prose quality and fresh Idea stability remain unaccepted (the [Idea contract](poc/idea-card.md) lists its limits); generative matching dependencies await `matching-v4`. The readers' doubts about the frozen standard, listed in the [extraction branch's state page](research/2026-11-01-e2e-loop/current-state-extraction-branch-2026-11-03.md), remain for Alex.\\n   151\\t\\n   152\\tUpstream supply and the human review pool's output remain deferred.\\n   153\\t\\n   154\\t10. **A new-system store being written serves its first day in progress** (D573, D574; `docs/research/2026-11-14-use-acceptance/page-contract/LIVE-READ-DESIGN.md`, B):\\n   155\\t   before any day completes, the service's default date falls back to the latest judgement's day. Not built: a correct guard needs one\\n   156\\t   snapshot for the check and the read, MCP's start and the streamed Idea response handled; 0 of 143 stores are in that state and no\\n   157\\t   new-system store is served live today.\\n   158\\t\\n   159\\t## One next task\\n   160\\t\\n   161\\t**Where the lean path stands (2026-11-15; D489 to D542).** Alex is not active (D509); D439 is in force: choices go to the\\n   162\\tcouncil (an independent Codex review and Claude) until consensus, recorded citing D439; nothing is pushed, deployed, published or\\n   163\\tcommitted; paid calls stay within D439's $40 ceiling (about $18.42 recorded; $0.0134 sent in this period, the ten judge calls of\\n   164\\tD511 and D519; the lean path $8.34 in all). Every stretch below is closed; its full record is in the decision log and in\\n   165\\t`research/2026-11-14-use-acceptance/LEAN-LOG.md` (sections 1 to 43).\\n   166\\t\\n   167\\t- **The choice between the systems is not made.** The fresh week did not separate them (D489, \\\"not clear\\\"; nothing since ranks\\n   168\\t  them). The comparison that could choose by measurement was sized and not sent: at the proposed size it may miss differences\\n   169\\t  that matter ([sizing](research/2026-11-14-use-acceptance/comparison/COMPARISON-SIZING.md), D517). **Production stays the default\\n   170\\t  and both systems stay (D518).** Alex's product choice on the company's financial figures stands (D505: evidence for related\\n   171\\t  questions, no table and no questions of their own; D382 and D384 stand).\\n   172\\t- **For Alex:** the [decision page](research/2026-11-14-use-acceptance/DECISION-PAGE-2026-11-15.md) (its section 7 is the one list\\n   173\\t  of what is his to choose, what he has decided and awaits building, and the defects with their evidence), the\\n   174\\t  [side-by-side week](research/2026-11-14-use-acceptance/side-by-side/SIDE-BY-SIDE-WEEK.md) and the\\n   175\\t  [judge note](research/2026-11-14-use-acceptance/unsupported/DESIGN-NOTE.md) with its one choice.\\n   176\\t\\n   177\\t**Open defects found on this path, each with its evidence; nothing is built on any of them:**\\n   178\\t1. **The new system's delivery gap** (D506, D508, D513, D514): a kept fact that bears on a question by a step of reasoning may be\\n   179\\t   linked to another question or to none, and so never reach that question's judge; the later-linking step skips a group whose\\n   180\\t   original statement arrived under another question. Three confirmed fact-and-question pairs in the fresh week, 23 unresolved\\n   181\\t   ([census](research/2026-11-14-use-acceptance/delivery-class/CLASS-CENSUS-RESULT.md)); one six-call test of its effect was\\n   182\\t   inconclusive ([result](research/2026-11-14-use-acceptance/effect/EFFECT-TEST-RESULT.md), D511). Paused.\\n   183\\t2. **The judge, shared by both systems** (D519, D520): on a question that asks for an amount it names a band when nothing shown\\n   184\\t   sizes the amount, or closes the last gap with a number of its own (36 of 438 stored readings, many of them the same\\n   185\\t   question read on successive days: a failure pattern on a few question paths, not an error rate;\\n   186\\t   [census](research/2026-11-14-use-acceptance/unsupported/UNSUPPORTED-CENSUS.md)). Three of the ten settled unsupported answers\\n   187\\t   coincided with a figure the system held and had not delivered to that question\\n   188\\t   ([result](research/2026-11-14-use-acceptance/missing-input/MISSING-INPUT-RESULT.md), D530 to D532). What the product shows is\\n   189\\t   Alex's choice (the judge note).\\n   190\\t3. **The old system's duplicate questions** (D520 to D523): three pairs in the fresh week; one second question was never compared\\n   191\\t   with the first, the others were compared and kept apart\\n   192\\t   ([result](research/2026-11-14-use-acceptance/duplicates/DUPLICATES-RESULT.md)).\\n   193\\t4. **The old system's filing under the broader question** (D529 to D531): the data-center revenue question never received the\\n   194\\t   next quarter's guidance or a consensus for the year, filed under total revenue only\\n   195\\t   ([cases](research/2026-11-14-use-acceptance/d375-measure/SAME-DAY-CASES-RESULT.md),\\n   196\\t   [trace](research/2026-11-14-use-acceptance/missing-input/FILING-TRACE-RESULT.md)). The relation `docs/prd/10-filing-phase.md` §2 names.\\n   197\\t5. **Where decisions and code part on dependencies** (D541, D542): `writing.write` drops an edge that would close a circle with a\\n   198\\t   note where PRD 06 says refuse and ask for a correction; PRD 06's \\\"historical only\\\" branch has a reader and no writer; the\\n   199\\t   label the seeding module writes on every seed edge (`last_end`) is defined nowhere; no decision says what happens to a later\\n   200\\t   proposal with another direction for a pair already read.\\n   201\\t\\n   202\\t**Decided by Alex, awaiting implementation and acceptance (not asked again):**\\n   203\\t- **D375, each article sees the questions committed before it.** A passed, bounded serial proof with labelled fake answers\\n   204\\t  ([result](research/2026-11-14-use-acceptance/duplicates/D375-PROOF-RESULT.md), D526, D528); the eligible same-day cases of the\\n   205\\t  fresh week read (D529). A real measurement needs a new version of the reading request and a paid run; not opened.\\n   206\\t- **D368 item 2, the matching step chooses a new question's dependencies.** In the unseeded fresh week one clear case among 97\\n   207\\t  pairs (data-center revenue reading total revenue;\\n   208\\t  [census](research/2026-11-14-use-acceptance/dependency-selection/DEPENDENCY-SELECTION-CENSUS.md), D537). As the code stands\\n   209\\t  one stored edge has two readers (whose conclusion to read; which of two homes is the narrower): the same edge would remove\\n   210\\t  seven filing links ([proof](research/2026-11-14-use-acceptance/dependency-selection/EDGE-PROOF-RESULT.md), D538). A design that\\n   211\\t  reads the two uses apart is recorded as **a provisional candidate, not sound for build**\\n   212\\t  ([design](research/2026-11-14-use-acceptance/dependency-selection/SEPARATION-DESIGN.md), D539 to D542): two proofs on stored\\n   213\\t  data, the package's suite run under it, every stored dependency row classed. If the slice is reopened, its review must first\\n   214\\t  settle the cycle through an awaited question at creation, closing behaviour, a theme shown twice, the historical readers and\\n   215\\t  the label. A statement's home is not something an edge can decide (its section 2.5): the reading step's, the filing phase's\\n   216\\t  subject. No selection call is designed; nothing was sent.\\n   217\\t- **D368 item 4, the reading direction for preset questions** (settled by Claude on Alex's delegation): not measured (D536); the\\n   218\\t  stored seeded draws already agree with the frozen reference on 15, 15 and 16 of 17 questions; the rebuild and dry-run harness\\n   219\\t  is kept ([page](research/2026-11-14-use-acceptance/dependency-channel/CHANNEL-ASSESSMENT.md)).\\n   220\\t\\n   221\\t**The choice is made by the council under D439 (D544, 2026-11-15): the work toward production carries forward on the new\\n   222\\tsystem; the old system stays the running default until the new one passes its gates; both remain.** Nothing that runs is\\n   223\\tswitched, deleted or deployed. It is not a finding that the new system's answers are better: the cold reflection (D543) found\\n   224\\tnothing that ranks the two systems' answers, and the first consensus left the choice to Alex; that deferral was withdrawn the\\n   225\\tsame day, because his words in D439 give the council the job of taking a course. Reasons: he had reopened work on the rebuild\\n   226\\tand D439's scope names its steps; it follows the product rule on financial figures he last confirmed (D505); the fresh week\\n   227\\tgives no demonstrated reason to abandon it and shows fewer trivial or duplicate questions in that one run. Kept in view: its\\n   228\\tanswer-choice step has not met its lines, Stage B did not pass, integration is undone, and its cost and time to production are\\n   229\\tunknown. **Alex's word overrides this at any time**; it is also reconsidered on a change of his product rule, a sound comparison\\n   230\\ton shared subjects that favours the old system, or the rebuild failing its unchanged gates within a bound agreed later. A first\\n    27\\t## Authority and scope\\n    28\\t\\n    29\\t- Alex's messages win, then the decisions in force, then the governing design documents. Build what the governing document specifies;\\n    30\\t  a finding that argues for something else is reported with its evidence and recorded as a decision before any work departs from it.\\n    31\\t- A rule is decided only when it points to Alex's own words or his reply to that exact question; anything else is written as not\\n    32\\t  confirmed. When his answer replaces layers of a proposal, those layers go. Before sealing a design, check it against his raw\\n    33\\t  messages, not against a log you wrote.\\n    34\\t- Do what was asked, in the modules Alex has taken up. A defect in that work, once root-caused, is fixed in the same slice (§1). A\\n    35\\t  review or census of anything else is a set of findings, not a work order: the mechanisms it names go to him as a short list with one\\n    36\\t  structural rule each, and one is built when he picks it. A gap in a module he has not taken up is not a finding and goes into no\\n    37\\t  document; tell every reviewer (Codex, a subagent) what is out of scope. A frozen module (D19, D37) changes only through a new decision.\\n    38\\t- What goes to Alex: a choice that changes what the system does, as the question, its options and your recommendation; a next step of\\n    39\\t  work, as one recommendation and one test (§7.3). Settle wording, placement and where a rule is written yourself, and say so in the\\n    40\\t  report. Never start what only Alex can launch.\\n    41\\t- **While Alex is not active, the council decides (D439).** A choice or a next step that would go to Alex, including opening a new\\n    42\\t  version of a piece frozen for \\\"a new version only Alex opens\\\" (never of the frozen ruler), goes to the council instead:\\n    43\\t  an independent read-only Codex review and Claude argue it, round after round, on the data, the PRD and its quantified goals, until\\n    44\\t  they reach a consensus; the consensus is recorded as a decision citing D439, then executed and measured, every trace read by Claude\\n   326\\t### 7.3 Iterating\\n   327\\t\\n   328\\t- **One class at a time** (Alex, 2026-10-29: \\\"你一类一类改，快速迭代然后测regression\\\"). Count the misses by mechanism; take the largest\\n   329\\t  class; trace it to the sentence that causes it; change one thing aimed at that class; run the whole bench (a prompt change alters every\\n   330\\t  request) against the previous version; read every regression to its raw answer. The pages that showed the failure locate its\\n   331\\t  mechanism; only the whole bench (every set, every draw) accepts the change.\\n   332\\t- **Name the effect on the judgement first.** Every proposed change states the effect it is expected to have on a reader or on the final\\n   333\\t  judgement, and is tested there where possible; a step's own counts do not decide it alone. A fix that keeps moving its error to\\n   334\\t  neighbouring cases stops being tuned on that set (Alex, 2026-11-09: \\\"感觉现在一直在修一些mknor的原地打转，你是不是要思考下现在具体还差什么high priority big impact 的需要做？\\\";\\n   335\\t  he approved this rule the same day, D391).\\n   336\\t- **A model call is a sampler.** Re-send a stored request before calling its answer a defect. Totals and acceptance come from at least\\n   337\\t  three samples beside a fresh control; a bar the control fails against itself judges nothing. A direct-read pass\\n   338\\t  (one send per article, every answer read beside its source; D238) locates mechanisms; its counts are one draw and are labelled so.\\n   339\\t- **A written log.** One row per arm: hypothesis, change, numbers against the control (regressions first), kept or not. Refuted arms and\\n   340\\t  your own mistakes stay in it; the next session starts from its last row.\\n   341\\t- **Own the loop, within what Alex agreed.** When the direction is agreed and no stop is in force (`CURRENT_STATE.md`), push your own\\n   342\\t  hypotheses through $0 checks and probes of a few cents on stored cases without asking. A registered test, an end-to-end run, or\\n   343\\t  anything that departs from the agreed plan starts on his word; a result that contradicts the hypothesis stops the line and goes to him\\n   344\\t  (D355: \\\"如果有什么不符合hypothesis 的地方你需要终止然后和我说我们重新评估\\\"). While he is not active (D439), \\\"his word\\\" is the council's\\n   345\\t  recorded consensus, and a stopped line goes to the council for re-assessment.\\n   346\\t- **Council before every change is sent.** A prompt, schema, code or criterion change, including one found by reading a probe, is a new\\n   347\\t  arm. It goes to an independent Codex read and a challenge round before its first send, and its result goes to a challenge round\\n   348\\t  before the next change. Reading the traces and the model's own account locates a fix; it does not review it (Alex, 2026-11-08:\\n   349\\t  \\\"你这些改动有我你有好好的跑council 再下手\\\").\\n   350\\t  Every round's reasoning and decisions are reflected on in the council until there is a consensus; the decision is recorded, and\\n   351\\t  the next test goes straight ahead, held to the PRD and its quantified goals, with every trace read by you yourself and not only\\n   352\\t  by readers (Alex, 2026-11-10: \\\"你应该跑council loop 来reflect 你每一轮的思路还有决策，需要你打成共识，记录决策，向前直行测试。不要drift,我们有PRD和量化目标，\\n   353\\t  你自己作为llm 下去看所有trace\\\").\\n   354\\t- **Small first, then one run.** A hypothesis is first validated the simplest way, on a few stored cases and a few cents, and shown to\\n   355\\t  work at a high level before any full analysis or stability test is built (Alex, 2026-11-04: \\\"don't overspend resources on wasting time.\\n   356\\t  We need to validate the hypothesis in a very simple way and to make sure that it works on a high level before we dive into do the full\\n   357\\t  analysis stability test. This is a principle you should remember\\\"). A day or week slice before any whole-corpus run; preflight on\\n   358\\t  stored data before any paid run (§5); no edit while a run is live (§9). A paid run measures a configuration; it never tries a fix.\\n   359\\t  Before each send, write what it can still change in the decision and which risk the cheaper check left uncovered; a replicate or\\n   360\\t  control that only re-measures noise or a settled comparison is not sent, and a fix is not sent before the model's own account and the\\n   361\\t  request locate where the decision is made (Alex, 2026-10-30: \\\"你跑这么多次真的有意义吗\\\"; \\\"我感觉你在为了跑而跑\\\"). Several fixes on one\\n   362\\t  base are each proved on stored data in minutes and then run together once (Alex, 2026-11-02: \\\"快速验证。不要drift,不要跑超级繁琐的全方位验证，先poc 改，能work,有结论，全部改动放到一起再跑完整\\\"; D266).\\n   363\\t- **One recommendation, one test.** What reaches Alex as the next step of work is one recommendation and one test of it, reached after\\n   364\\t  rounds of review (Claude's own, Codex's, an independent reader's) on the traces until a round finds nothing serious; never a menu of\\n   365\\t  arms or options, never a conclusion the next probe overturns (a choice that changes what the system does still goes to him with its\\n   366\\t  options and a recommendation, Authority and scope) (Alex, 2026-11-04: \\\"就测试一种，一次 … 你就没有自己看5轮review，能不能自己有个超级自信的定论和证据再给我提建议？\\\").\\n   367\\t  An agreed recommendation is first challenged by an independent reader on the concrete evidence behind it (\\\"why you give\\n   368\\t  recommendations for this. What did you see exactly?\\\"). A review round reads a rule as its author meant it; only a send shows how the\\n   369\\t  model applies it: before a registered test, the changed request is sent on the cases that motivated it, a few cents.\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n./docs/research/2026-11-14-use-acceptance/reflection-4/codex-design.jsonl:12:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_3\",\"type\":\"command_execution\",\"command\":\"/opt/homebrew/bin/zsh -lc 'cat docs/CURRENT_STATE.md docs/research/2026-11-14-use-acceptance/NEW-SYSTEM-FRAME.md docs/research/2026-11-14-use-acceptance/ACCEPTANCE-DESIGN.md'\",\"aggregated_output\":\"# Current state\\n\\n**Clean Steps 1–3, current (2026-11-11).** Records: Step 1, [round log](../clean-arch/step1-unfiled-2026-11-08/LOG.md) §§16–47; Step 2, [Step 2 log](../clean-arch/step2-validation-2026-11-07/LOG.md) §§12–19.\\n- **Step 1 configuration: c8, adopted by Alex (D387).** It runs DeepSeek Flash at high effort, with a 64,000-token output cap; a\\n  format failure or a cut answer is resent once (D380). It carries Alex's decisions D382–D385:\\n  - figures are conditions;\\n  - material statements with no thesis are kept without links;\\n  - only big matters open a thesis;\\n  - no target prices.\\n\\n  [PRD §12](../clean-arch/PRD.md) holds its system prompt, closing check and schema; a run with no candidate files sends exactly the\\n  accepted request.\\n- **Acceptance (D386, [protocol](../clean-arch/step1-unfiled-2026-11-08/ACCEPTANCE-PROTOCOL.md)).** 50 fresh articles that no run,\\n  old or new, had used: news from 2026-09-05 to 09-07, a holiday weekend with no NVIDIA posts. One draw; two readers and a third on\\n  disputes.\\n  - helpful 132/139 (core 83/83);\\n  - wrongly opened theses 1 of 10;\\n  - search 141/143 available repeat pairs, or 141/145 for the whole system (one 11-article story supplies 55 pairs, and revisions are\\n    barely exercised);\\n  - clear wrong merges 1/57, plus 2 overlaps;\\n  - detail retention 22 = 22. This is a storage comparison: every record keeps its own text. It is not a usability test.\\n\\n  Dev ×3 on the frozen golden-v5 (a lead): helpful 214, 211 and 212 of 234; search 98.9–100%; clear wrong merges about 1%. Step 1\\n  cost for the fresh set plus dev ×3: $4.20 at published rates.\\n- **Steps 2 and 3** are built in isolation (`clean-arch/step2`, `clean-arch/step3`): search, comparison, grouping and later linking.\\n  They are not integrated with production storage. **Step 4 (judging) has not passed** on the clean path: its ladder step is built and\\n  measured (four Stage A runs, lines missed by 1 to 3 answers; D426), so nothing yet shows the clean system can judge an investment\\n  view on its own questions.\\n- **Step 2 is closed and frozen (Alex, D427, 2026-11-11;** [Step 2 log](../clean-arch/step2-validation-2026-11-07/LOG.md) §§14–19**).** It goes\\n  to production only with the whole clean path, after Step 4 meets its lines; `tests/test_frozen_clean_step2.py` guards its files. Its three lines were met at the acceptance above (one draw; \\\"later version\\\"\\n  relations barely exercised), and no miss of the seeded end-to-end test (clean 18, 18, 17 against production 17, 15, 16) has\\n  been traced to it (the two single-draw misses were diagnosed on 2026-11-11, below: neither traces to Step 2). What happened since the close-out of 2026-11-08:\\n  - A change to Jev's wording for \\\"later version\\\" relations failed its line (42 calls, 2026-11-09) and tuning stopped.\\n  - One wrong relation was traced to the judge: it put NVIDIA's answer to the Kyber report under the FY2027 revenue question;\\n    sent both ways, the conclusion did not differ ([result](../clean-arch/step2-edge-effect-2026-11-10/RESULT.md)).\\n  - Alex stopped work on that relation (D423) and asked for a fix to the rule that gives a \\\"later version\\\" the older record's\\n    questions. Measured on the three saved draws ([round log](../clean-arch/step2-revision-links-2026-11-10/LOG.md)), removing the\\n    rule was withdrawn: of the 24 links it wrote, two blind reader families call 19 context and 3 evidence, and one of the 3 is a\\n    company's answer that would otherwise be missing beside four reports (with it rung 2, 2, 2; without it 2, 3, 2). **The rule\\n    stays (D424).**\\n  - **Open, recorded:** Jev's \\\"later version\\\" relation (9 of 30 join different statements in draw 1); the context links it carries\\n    (19 of 24); wrong groups (at the line on one draw; the unprompted reading test never run); the \\\"Unverified quote\\\" mark not\\n    shown to Jev (3 of 188); not decided, whether a company's answer must sit under every question its report is filed under.\\n  - **Reopens when** Step 4 yields judged views on the clean path and a miss, or something a reader of a thesis sees, traces to\\n    one of these. The round's measurement kit (replay of a saved draw, exact simulation of a writer rule, blind packets with\\n    controls, a judgement sent both ways) is kept in the two folders above.\\n- **The clean system's untraced end-to-end misses, diagnosed (2026-11-11;** [round log](../clean-arch/e2e-misses-2026-11-11/LOG.md)**).**\\n  The China share question in draw 3 and the FY2028 revenue question in draw 2 (seeded test, D392). Both estimates sit on a rung\\n  line. China: the same window-end request, re-sent, gives the miss twice and the right answer once (the judge's own variation at the\\n  1% line); no H200 price is in any request. FY2028: draw 2's window-end request gives the miss 3 of 3 and draw 3's the right answer 3\\n  of 3; draw 2's lacks records draw 3's holds (a \\\"41% in calendar 2027\\\" figure Step 1 filed under FY2027 only, \\\"$1 trillion of\\n  Blackwell and Rubin visibility\\\", five infrastructure-demand records), not isolated which matters; FY2028 is the question whose filed\\n  statements differ most between draws (47% shared, median 74%). Neither traces to Step 2. Refuted on the way: that a refused answer\\n  re-asked caused the China miss. Observed defect of the frozen judge: it names the export-controls theme as a dependency of the China\\n  question, 42 of 65 refusals in six draws, and the re-ask changed the rung 8 times (PRD 11, E4). No change proposed; 18 sends, $0.043.\\n- **Open defects, by product impact** (reflection council, `council/av-codex.md`):\\n  1. **The Ohio-guarantee yes/no question is never covered** in the three dev draws; a broader credit-support amount thesis opens\\n     instead. Diagnosed (round log §48): the model folds the unsigned guarantee into the open aggregate thesis because the request\\n     uses \\\"covers\\\" both for \\\"is evidence for\\\" and for \\\"already asks this question\\\". The same clause sits under link clutter.\\n  2. **A revenue-share thesis was opened** (Vera Rubin's share of data-center revenue), the class-A boundary of D382.\\n  3. **Link clutter.** A blind recheck of the 34 disputed fresh links found 19 weak and 2 wrong; 10 accepted links mixed in as controls were all useful; the other 49 links were not rechecked.\\n     The model's own account names topic or theme overlap and inference chains, and c8's closing check never reads back a link. This is\\n     a likely cause, with no fix proven. Alex approved designing a protected link check through the council; a first draft was stopped\\n     because it would drop founding premises and contrary facts.\\n  4. **Unverified passages:** 3 of 188 fresh records and 1–3 per dev draw. The mark now travels into Step 2's records, and a reader sees the found source text or an \\\"Unverified quote\\\" label. Jev's comparison input still carries the model's text without the mark; changing it changes measured Step 2 behaviour and needs its own measurement.\\n  5. **The lidar policy thesis** recurs at the boundary (one dev draw in three).\\n- **History.** These earlier states are superseded:\\n  - the 2026-11-07 takeover (K5 → K6b; [takeover log](../clean-arch/takeover-2026-11-07/LOG.md));\\n  - the 2026-11-08 close-out (K6b test 32/42; Step 2 first lines; [Step 2 log](../clean-arch/step2-validation-2026-11-07/LOG.md) §12);\\n  - the unfiled fix round and the c1–c7 arms (round log §§1–39).\\n- **No run is live.** The branch is committed through the D388 line (round log §§48–59).\\n\\n**Clean Step 1 source investigation (2026-11-07):** A [source-loss census](../clean-arch/STEP1-SOURCE-LOSS-CENSUS.md) traces two separate losses in the historical cleaner and records reproducible corpus observations. Offline candidate comparisons expose both recovered content and source-identity or contamination risks. A subsequent [full-page diagnostic](../clean-arch/STEP1-FULL-PAGE-RESULTS.md) completed 102 calls on 17 selected articles and independent source-backed review. It exposes examples of both missing or misattributed source text and model errors that persist despite the right text being present. A Codex–Claude council is reviewing the results and earlier attempts; no source-cleaning candidate is adopted, and the source corpus and production defaults are unchanged.\\n\\nAlex has authorized correcting the test-source cleaner and test data when their defects are confirmed, while the frozen production configuration and ruler remain intact. The cleaner switched 615 originally fed articles off; a replay reproduces all 615, and direct inspection confirms an actual article excluded because its 9,874-character body was flattened to one line. Other examples include a wrong-site shell, paywall and long challenge code, so the false-exclusion count and a general article-identification repair remain to be established. The [council regroup](../clean-arch/STEP1-SOURCE-REGROUP-COUNCIL.md) and [source-preservation design](../clean-arch/STEP1-SOURCE-PRESERVATION-DESIGN.md) describe an isolated candidate checked against all 34,084 records, with a fake-answer actual-runner handoff and provenance display in the replay renderer. The [five source-control calls](../clean-arch/STEP1-CAPTURE-CONTROLS-RESULTS.md) completed and were source-reviewed; two items contain summary details absent from their attached quotations, and one source-visible risk explanation was not returned. This is selected-case evidence, not a general quality result. Broader source-quality comparison, citation completeness and actual writer integration remain open.\\n\\n**Clean architecture Step 1 (2026-11-06, isolated work on `clean-arch`):** Alex reopened work with the clean architecture. An experimental prepared-source handoff now preserves the archived page, prior cleaned text, source-role decisions and selected-line mapping without changing the original database; quotations for prepared items must also occur contiguously in the original captured page. Two seven-item runs are available in the [clean architecture PRD](../clean-arch/PRD.md), one in the earlier selection order and one in recorded page-timestamp order. The source selector is not a production service and source ordering is not established event-arrival ordering. The runs expose unresolved semantic problems: citations can omit supporting facts despite an exact location match; model output can change a benchmark into a deployment, reverse a backup relation, omit a named customer or assign an unstated currency. A blinded 84-call check-placement/wording comparison and a 27-call same-article citation-completion diagnostic did not give a clean semantic fix and are not adopted. The latter missed an omitted connectivity condition and a reversed backup relationship, and left six expected evidence reviews unaddressed. A further five-round Codex–Claude council produced a narrowly scoped Step 1 link candidate, independently checked for prompt-contract drift. A six-article, 36-call blind comparison completed; the candidate still produced an explicitly self-contradictory link and both arms consistently omitted the same Kyber report and company response. It is not adopted and has not changed the active PRD prompt. A trace confirms that both the Kyber report and open Kyber thesis were supplied, and the raw model answers omitted the report and denial; the reason is not established. See ../poc/data/clean-step1-kyber-trace-2026-11-06/TRACE.md. An isolated six-call comparison showed that hiding the Kyber thesis did not recover the report or denial in any draw. A second six-call comparison returned them in 3/3 draws with the original Kyber paragraph alone and 0/3 with the full article; length, position and surrounding content changed together, so the reason is not isolated. Excerpt outputs have source-attribution limitations. Neither experiment changed state or established a production fix. (Superseded: the next task then was a whole-article coverage approach; the current next task is under \\\"One next task\\\".) See ../clean-arch/STEP1-IMPLEMENTATION-COUNCIL.md. The earlier four-round council agreed that no tested semantic fix is ready; its next investigation is a source-backed review of the 49-item historical run and its 160 evidence records, with overlapping issue flags and separate article-level omissions, then a separate comparison of the seven-item replays. See ../clean-arch/STEP1-COUNCIL-REVIEW.md. Preserve relevant evidence while identifying the next intervention; production/frozen history remains as described below. See [Step 1 run log](../clean-arch/STEP1-RUN-LOG.md) and [English reading page](../clean-arch/architecture.html).\\n\\n**Sealed (D379, 2026-11-06):** Alex asked to clean up and seal this version while he re-plans the system design. Work stops here and is sealed as it is: main's working tree is committed on branch `seal/2026-11-06` (tag `sealed-2026-11-06`) and merged into `main` on Alex's word (PR #10); the sealed split and two side experiments are pushed on their own branches (D379). No PRD 11 experiment is open, and the E1 next task below is withdrawn. The next task is Alex's re-planned system design.\\n\\n**E1 diagnosed (2026-11-06, Alex chose E1):** of 57 helpful matters frozen production wrote and then dropped, two readers agree on 17 link misses (4 core), 3 opening misses (1 core) and 24 small matters the standard itself drops; 10 are disputed on the fallback clause and 3 were quote refusals. Opening is not the experiment. The core of the link misses is the model reading a question's period, population or named configuration as a boundary; only 8 of the 13 window draws it dropped were lost to the product. No production change; $0.02 of probes. My recommendation was to fold that narrow change into the next extraction version; withdrawn by the seal (D379). Details: `docs/research/2026-11-06-e1-no-home-drops/README.md`, PRD 11 E1.\\n\\n**Split extraction sealed as a failed experiment (D378, 2026-11-06):** the split (a new-question call, an evidence call and record preparation) was benchmarked against the frozen poc-v108 and failed. Its stop line fired: helpful matters 156, 156, 159 against 166, 170, 162, with about 15% higher cost. One screened revision kept more noise than production. It is sealed in the worktree `hivemind-no-preseed-evidence-review` (tag `split-extraction-failed-sealed-2026-11-06`), and nothing of it is in main. What it taught is written as proposed production experiments in `docs/prd/11-production-experiments-from-split.md`: E1 no-home helpful drops, E2 duplicate questions, E3 ladder checks with D186, E4 judge refusals, E5 D203's revision day, E6 the measurement kit. Each opens only on Alex's word.\\n\\n**Question-catalog limit removed (D377, 2026-11-05):** Alex also directed removal of the separate 150 KB catalog rejection. The research reader in this worktree now has neither the catalog nor evidence byte limit; it retains full scoped questions, historical boundaries, dependencies and evidence. A portable 326,996-byte catalog test returns all 400 new questions and expands evidence both after reading the catalog and directly; the old 150 KB guard fails the same test in a scratch copy. The saved 69-question pilot catalog and all 69 saved evidence expansions match their original content hashes. Details: `docs/research/2026-11-05-catalog-limit/`. The full suite remains pending until the paid seven-day run no longer competes for resources. The run remains in its isolated worktree and does not call this research reader.\\n\\n**Evidence reader limit removed (D376, 2026-11-05):** Alex directed removal of the reader's 1 MB evidence-expansion rejection. In this worktree, `research_context.Reader.expand` now returns the entire evidence payload without that cap, while the catalog's separate limit remained at that checkpoint; D377 subsequently removed it. On the saved pilot ledger, all 69 individual question expansions, the four-question 1,931,225-byte pilot request and the entire 3,454,076-byte catalog produce the exact same content as the pre-change high-limit baseline; the portable oversized-ledger test passes and fails when the old cap is restored in a scratch copy. Details and snapshot-specific measurements are in `docs/research/2026-11-05-reader-limit/`. The seven-day diagnostic runs in `/Users/lchingen/hivemind-no-preseed-evidence-review/poc/data/split-fresh-seven-day-2026-11-05-v2/` with its pinned code; it does not call this research reader. Read its status through its `snapshot.sh`; do not edit its package code while it is live. This change is not an acceptance of seven-day extraction or judgement quality.\\n\\n**Start-state correction (2026-11-05):** Alex requires a research library established from real material available before the test start, then extraction against that state. The prior empty-library diagnostic cannot represent this case. Our own mistakes and the current 68-question provenance audit are in `../hivemind-no-preseed-evidence-review/docs/research/2026-11-05-parallel-refinement/own-mistakes-2026-11-05.zh.md`. Two new A-only calls were run on 2026-08-29 articles using the 68-question prior-day snapshot; both proposed the same aggregate supply-commitments topic. A source/context review judged it distinct from the existing specific SK Hynix question. A third A-only call on an author-body excerpt about DLSS 5, already tracked by v22, passed; the prompt also restricts software updates, so the reason is not established. No writer or dedup ran; source-history completeness remains unverified, and this is not scored acceptance. Details: ../hivemind-no-preseed-evidence-review/docs/research/2026-11-05-parallel-refinement/start-state-diagnostic-2026-11-05.zh.md.\\n\\n**Measurement correction (2026-11-05):** Alex clarified that a gold-worthy topic already in the supplied library should not open again; an absent worthy topic should open. The earlier simple-A claim of a \\\"missed\\\" new topic was not scored against that rule and is withdrawn as a correctness conclusion. In the actual experiment, a Kyber topic was shown and passing follows Alex's topic-level rule; whether its exact release question captures the shipping milestone remains unverified. The experimental pre-article snapshots differ from the replay's day-start snapshots; 9 of 10 inspected examples differ. The current uncommitted replay default does not build a cold-start library; committed main HEAD still uses the old seed and startup filing path. Historical lexical coverage has a confirmed unrelated-topic match. The frozen gold and past scores remain unchanged. Audit: `../hivemind-no-preseed-evidence-review/docs/research/2026-11-05-parallel-refinement/measurement-context-scrub-2026-11-05.zh.md`.\\n\\n**Simple new-question diagnostic (2026-11-05):** At Alex's direction, an isolated prompt returned new questions plus article evidence without asking for product database fields. Four previously seen real dev articles each ran once: three returned one candidate, one returned none, all four quotes matched their source, and the gold-listed GPU backstop amount question was not proposed. Whether that omission is a new-topic miss depends on whether the existing library covers the topic. Two other candidates require source and independent-significance review; the actual experimental snapshot already had a Kyber topic, so its pass follows Alex's topic-level rule; whether its exact release question captures the shipping milestone remains unverified. This is not a production or full-pipeline acceptance. Details: `../hivemind-no-preseed-evidence-review/docs/research/2026-11-05-parallel-refinement/simple-new-question-results.zh.md`.\\n\\n**Split prompt structure v3 read diagnostic (2026-11-05):** One real reading-stage call on a previously seen article found the revenue/margin guidance and Trainium scale but omitted the gold China revenue/market-loss matter. The prewritten stop condition was triggered and the linking call was not sent. This is one draw and not a production or end-to-end result. See `../hivemind-no-preseed-evidence-review/docs/research/2026-11-05-parallel-refinement/structure-v3-read-result.zh.md`. D374 removes the model sampling field from active settings and default configs; historical config files and archives retain their original bytes.\\n\\n**Split prompt structure v2 small test (2026-11-05):** Thirty calls on two previously seen golden-v5 dev articles completed in `../hivemind-no-preseed-evidence-review`. The blind model reader found complete helpful matters in the fresh control versus new A+B of 6/19 vs 10/19, 11/19 vs 7/19, and 9/19 vs 12/19. The new arm also retained more gold not-kept matters in each draw; B missed useful margin guidance and one answer reused IDs, with a demonstrated matching collision. This is not a production acceptance. See `../hivemind-no-preseed-evidence-review/docs/research/2026-11-05-parallel-refinement/structure-v2-results.zh.md` and `reports/2026-11-05-parallel-structure-v2.html`.\\n\\n**Split extraction small test (2026-11-05):** At Alex's request, the isolated `hivemind-no-preseed-evidence-review` worktree ran two real golden-v5 articles once through each split lane. An independent model reader found 7 of 19 helpful gold matters fully retained, two partial, two written then dropped, eight missed, and one retained gold not-kept matter. Three saved v108 draws on these articles retained 7, 9 and 12 of 19, but used 22 seeded questions while the new test used 8/10-question snapshots; these are not directly comparable. The experiment remains unaccepted; see `../hivemind-no-preseed-evidence-review/docs/research/2026-11-05-parallel-refinement/small-scored-test-20261105.md` and `reports/2026-11-05-split-small-test.html`.\\n\\nAs of November 5, 2026; decisions through D374. [Decisions](DECISIONS.md) holds what is decided now; the [design page](system-design.html) and the [module PRDs](prd/README.md) hold what the code must do; the [README](../README.md) holds startup, build and run instructions.\\n\\n## Future evidence scoring (D372)\\n\\nAlex decided future gold scoring should measure helpful versus not helpful evidence without requiring separate scores for core and supporting. Use frozen golden-v5 as-is: combine core and supporting as helpful, treat not-kept as unhelpful, and keep optional entries neutral. A counting report has not yet been implemented. Historical scores retain their original definitions. D373 removes the stop caused by a separate concern about three question-gold entries: keep the gold unchanged, continue scoring and disclose the concern; see `../hivemind-no-preseed-evidence-review/docs/research/2026-11-05-parallel-refinement/ruler-conflict-2026-11-05.zh.md`.\\n\\n## Latest decision (D369)\\n\\nAlex decided in D369 to capture core and supporting evidence without a strict boundary and in D370 to remove the 22 preset starting questions and separate earnings-report import. The replay entry now defaults to `poc-v118` (D374), refuses old seeded ledgers and baseline configurations, and continues to read existing non-seeded questions; earnings releases remain normal source items. This change has local contract tests but has not passed end-to-end product acceptance. The frozen historical rulers and results remain unchanged.\\n\\nThe small 2026-11-05 study used three archived NVDA articles and an 8/28 historical 68-question snapshot: without versus with an appended report, independent AI review found 14/27 versus 13/27 complete matters. This measured appended extraction context, not the distinct former coverage-start step; D370 removes both by Alex's decision. Full traces and limitations are in the separate `hivemind-no-preseed-evidence-review` worktree under `docs/research/2026-11-05-real-input-evidence/existing-library-results-2026-11-05.md`.\\n\\n\\n**One-day smoke completed (2026-11-05 UTC):** Alex requested a quick 1–2 day end-to-end test. One day, 2026-08-29, ran in `/Users/lchingen/hivemind-no-preseed-evidence-review/poc/data/v117-one-day-smoke-2026-11-05/`: config v117, an 8/28 historical library, 40 extraction calls, 93 evidence records written, four new questions, 54 judged and zero terminal failures. Two judgement attempts were refused and corrected. A Microsoft revenue forecast of $391.1bn was assigned to a rung whose upper bound excludes $391.1bn; the same article's actual quarterly revenue and next-quarter guidance were dropped with no home. Some source dates and bodies are not verified, and an independent 14-article sample review was incomplete due to truncated text. This is not semantic or production acceptance. Findings and scope: `docs/research/2026-11-05-real-input-evidence/one-day-v117-smoke-2026-11-05.zh.md` in that worktree. The clean source-text comparison and its condition-hidden review are complete; council discussion of next steps is ongoing.\\n\\n**D371, in progress:** Alex directed that present and forward-looking revenue and financial information should be tracked. Diagnose the same-day extraction and filing losses before designing a general change. No new financial tracking implementation has been accepted yet. The old frozen standard and gold are unchanged. The original prompt-only pilot failed design review. The user approved an exact prompt addition for an experiment; it is not a production implementation. Four paired real-article diagnostic calls per arm completed for the exact approved sentence: v74i versus experimental role-d371-pilot. Microsoft next-quarter guidance and NVIDIA FY2028 guidance still dropped in the treatment; a single draw is not acceptance or proof of causation. Details: docs/research/2026-11-05-real-input-evidence/d371-prompt-pilot-results.zh.md (isolated worktree). The requested full prompt audit and restructure were drafted experimentally; five real-article paired diagnostic requests per arm completed. Microsoft revenue guidance was missed in both arms, and the draft produced unsupported original dates, a quote refusal and suspect links. No production prompt change or acceptance; see restructure-pilot-results.zh.md in the isolated worktree.\\n\\n**Clean Step 1 coverage council (2026-11-06):** Codex and Claude Code independently reviewed the existing attempts and completed three discussion rounds. The proposed next research candidate moves the existing evidence-reading block ahead of the thesis-opening block while preserving the article, open-thesis state and paired output. It is a hypothesis, not an implemented or validated fix. A complete prompt/contract audit and independent review precede any controlled Luna comparison. Historical paragraph-based and source-first experiments, their noise and attribution problems, and the rejected overlap-based merge are recorded in [the council review](../clean-arch/STEP1-COVERAGE-COUNCIL.md). No new Luna experiment was run in the council.\\n\\n**Clean Step 1 coverage order result (2026-11-07):** The isolated 54-call clean comparison completed and all answers were reviewed blind. Moving the evidence-reading block recovered a known Kyber report and denial in one of three candidate answers against none in three controls, with attribution blur; it also produced unsupported gaming-to-AI links in two candidate answers and no controls. It is not adopted. A separate exact-quote example misattributes an executive's prediction in the standalone summary. [Results and replay](../clean-arch/STEP1-COVERAGE-ORDER-RESULTS.md) record all selected cases, uncertainties and source-fidelity work; no production ledger was written.\\n\\n**Clean Step 1 fidelity council (2026-11-07):** Codex and Claude Code completed five rounds on source attribution, conditions, dates and meaning. No tested fix or root cause is established. The agreed source-to-record review of 49 articles / 160 evidence items and the subsequent isolated field-order comparison are complete; the later 54-answer / 217-record repeated sample remains separate. Prior source-first, quote-first and follow-up-review experiments and their limits are recorded in [the fidelity council](../clean-arch/STEP1-FIDELITY-COUNCIL.md). No Luna experiment or production change was made in this council.\\n\\n**Clean Step 1 fidelity review (2026-11-07):** All 49 saved source packets and 160 original evidence items have received a source-and-record review; focused independent cross-checks cover the findings and selected controls. The [review and article replay](../clean-arch/STEP1-FIDELITY-REVIEW.md) distinguish source contamination and missing source material from model meaning, citation, date and link issues. The [isolated schema property-order diagnostic](../clean-arch/STEP1-CITATION-ORDER-RESULTS.md) completed all 66 calls and condition-blinded article reviews. Several omissions and semantic errors persisted; it did not establish a fix and is not adopted. It used saved articles and before-states without changing production.\\n\\n**Clean Step 1 source handoff council (2026-11-07):** The ongoing [council and offline checks](../clean-arch/STEP1-SOURCE-HANDOFF-COUNCIL.md) reconstructed 16 matching article-34 controls, all omitting a Kyber report and denial; the cause remains unknown. The 20-article saved source-role overlap review distinguished previously cited AI-generated summary lines and an unrelated recommendation from authored body. The clean runner does not send the saved source-role labels; the council chose to first compare original and previously selected source text on ten known articles. The isolated 60-call source-text comparison and condition-hidden review are complete; [results](../clean-arch/STEP1-SOURCE-TEXT-RESULTS.md) show specific contamination reductions alongside persistent omissions and changed meaning. It did not advance state or write production. The isolated six-article low-versus-medium source-fidelity diagnostic completed 36/36 calls and condition-hidden review. [Results](../clean-arch/STEP1-REASONING-FIDELITY-RESULTS.md) show partial improvements alongside persistent source-qualification and attribution concerns; no production setting is changed. The [prompt audit](../clean-arch/STEP1-FIDELITY-PROMPT-AUDIT.md) maps the observed failures to the full request and signed standard. The six-article isolated schema-description comparison completed 36/36 calls and condition-hidden review; the candidate did not preserve the repeated example qualification and is not adopted. [Results](../clean-arch/STEP1-SUMMARY-FIDELITY-RESULTS.md). A further six-article 36-call low-versus-medium comparison used corpus-cleaned sources outside the original 49-item clean replay and a fixed exploratory context; results were mixed, including unsupported links and incorrect attribution/date fields. [Results and replay](../clean-arch/STEP1-ADDITIONAL-SOURCES-RESULTS.md). The structured-claims candidate was not sent after review revealed scope and complexity concerns. Council review of the next action is ongoing. The date-text schema-description diagnostic completed 48/48 calls on eight known cases, with mixed results; the candidate is not adopted. A selected-run census found twelve literal \\\"null\\\" strings in date-text fields, but no production writer impact is established. [Results and replay](../clean-arch/STEP1-DATE-DESCRIPTION-RESULTS.md). A further preregistered eight-source date comparison completed 48/48 calls; the candidate lost a supported company-article statement date in all three draws on one source and is not adopted. [Results and replay](../clean-arch/STEP1-DATE-NEW-SOURCES-RESULTS.md). A bounded corpus census confirmed 163 source pages across three explicit generated-summary structures whose labels were removed while some summary text was retained; two NVIDIA cases were reproduced through the cleaner. [Source provenance investigation](../clean-arch/STEP1-SOURCE-PROVENANCE-CENSUS.md). A read-only source-lineage replay reproduced 363/363 cleaned pages with current inputs, preserved ambiguous original-line locations, and surfaced the generated-summary label loss for review. [Source investigation and lineage replay](../clean-arch/STEP1-SOURCE-PROVENANCE-CENSUS.md). An offline neighboring-context observation exposed only 144 or 149 of 163 known labels and introduced many other page lines; it is not adopted as a general source fix. [Observations and viewer](../clean-arch/STEP1-SOURCE-CONTEXT-OBSERVATIONS.md). A new [saved-quote integrity investigation](../clean-arch/STEP1-QUOTE-INTEGRITY-CENSUS.md) reconstructed 360 saved answers across eight overlapping cohorts, including 78 prepared-source calls. Five saved unverified passage instances were complete matches under the existing normalization; an in-memory candidate recovered their original slices, while ten others remained unverified. The normalized source-slice lookup is now installed only in the isolated clean Step 1 runner; saved-answer and entry-point checks are recorded there. Page provenance, Unicode completeness, production resource budgets and writer integration remain open. The existing writer stores only one quote, whereas 63 of 160 evidence items in the 49-article exploratory trace have multiple passages. A [source-first 49-article coverage review](../clean-arch/STEP1-COVERAGE-CENSUS.md) separates material missing from the model input from source-visible omissions in the saved answers, with uncertain matter boundaries labeled. (Superseded: the next investigation then was why supplied material is missed; the current next task is under \\\"One next task\\\".) The canonical prompt and production configuration remain unchanged. Adding fallible role annotations remains a separate untested candidate. Council streams and handoffs are in `poc/data/clean-step1-ongoing-council-2026-11-07/`.\\n\\n## What runs\\n\\n- **Pipeline (replay default `poc/config/poc-v118.json`, D370, D374).** Every item reads the relevant open questions from the library at the start of its day, then extraction v74i on `gpt-6-luna` proposes evidence and questions; Jev matching with the collision judge matches them; code writes the records; judging-v7 judges changes once a day; pull mode closes due questions. There is no separate seed or coverage-start report import, and reports as source items remain eligible. This default has not completed end-to-end acceptance. The [pipeline guide](poc/pipeline-plan.md) maps stages to code.\\n- **Measured:** one company (NVDA) over one 14-day window (2026-07-01 to 07-14), the judgement scored at the window end on the frozen ruler (AGENTS §7.1). Three draws of `poc-v116` against three of `poc-v108` run in the same hours: 53 against 45 agreements of 57; operating margin and capex agree in 3 of 3 draws, never judged without the coverage-start reading ([acceptance](research/2026-11-04-filing-end-to-end/acceptance-design.md)).\\n- **Served data:** the service, the MCP server and the standalone page serve the sealed three-month ledger `served-2026-10-28-v34-nvda-3m-through-0828` (68 theses, 34 groups; D358), built by the earlier `poc-v34` pipeline, not by the replay default. HTTP `/library`, MCP `thesis_library` and the standalone page share the dated bundle writer.\\n- **Idea API:** `poc-v118-idea` (D290, D335, D374): two discovery calls and one adoption and weighting assessment; only adopted theses with positive weights appear, and nonempty plans total 100%. The [Idea contract](poc/idea-card.md) owns its fields and the limits of its scores.\\n- **Interface:** the Thesis Library and Explore Ideas workspaces, with the confidence Trigger and an Action preview (no wallet connection or order execution). The [UI specification](poc/thesis-ui.md) and the [integration guide](../poc/ui/README.md) own its behaviour.\\n- **Repository:** `main` holds the product, the frozen ruler and the research records; run databases, logs and model archives stay on disk (D353), located by the [data manifest](research/2026-10-25-english/data-manifest.md). Worktrees: `/Users/lchingen/hivemind` is the main checkout, where slice branches are cut from `main`; `/Users/lchingen/hivemind-extraction-quality-2026-10-28` (the extraction branch, merged on 2026-11-03) keeps in its ignored folders the stored end-to-end runs of `poc-v91` to `poc-v95` that later comparisons read (D359); `/Users/lchingen/hivemind-run-v109-2026-11-04` is the finished judging-v8 run's worktree. Older branches stay in Git without worktrees (D359); none is merged work in progress. The clean source-text comparison and its condition-hidden review are complete; council discussion of next steps is ongoing.\\n\\n## Open defects\\n\\n1. **Competitor and customer news is filed under the company's revenue questions** instead of the share, capital-spending or custom-chip question it informs (D355; filing is otherwise about 85% right). Share facts are often not written at all, an extraction recall miss. The total-revenue question holds about a quarter of all links (D354).\\n2. **One bet opened twice** about one encounter in five: the collision judge splits a seed question from an identical candidate on a fine detail (D354).\\n3. **A question the standard rules out** (the lidar legislation) was proposed by the extraction and opened in one draw of three (D354).\\n4. **A thesis opened from an article gets no dependency of its own**: the default Jev matching asks for none (`views/jev_matching.py`), although D51 has the matching call choose them; themes still reach every company thesis through the theme block (D191, D195). Found in the 2026-11-05 consolidation; building it is decided (D368).\\n5. **Historical coverage-start reading, retired by D370** (D364–D366): the capital-spending line is missed in about one read in six (the question is then left as it was); a labelled guidance figure is written with the fact tier; later reports reach the questions only through the daily stream; `scripts/preflight.py` does not replay the reading's check.\\n6. **Measured on one company and one 14-day window**, the judgement scored at the window end only; no version of the current pipeline has completed a longer window (a 60-day run of `poc-v108` was stopped at Alex's word after 2026-07-15, [log row 8](research/2026-11-04-argument-record/log.md)). The China-share question (v17) swings between draws (0 of 3 in the acceptance, 2 of 3 in its control, 1 of 3 in the frozen draws): two readers found the starting figures did not cause the acceptance's drop, and the byte-identical extraction request kept a \\\"share fell to zero\\\" sentence in two candidate draws and dropped it in two control draws. One acceptance draw judged nothing on v16; its cause is not established.\\n7. **What a judgement reads grows with the window** (D358). Argument records (D201) were measured as the remedy on 2026-11-04 and not built: judging-v8 agreed 12 of 17 against 15 of 17, judging-v9's card added little at about half again the judging cost; their code was removed at Alex's request ([log rows 4–11](research/2026-11-04-argument-record/log.md)).\\n8. **Seen once, not traced.** A judgement named a shown theme as a dependency and the check refused it twice, stopping a draw for a day (2026-11-02, D266). The sealed run's review recorded that a succession's opening evidence is not linked to the new question (D358), not yet checked against today's code.\\n9. **Earlier defects, unchanged.** Matching (build log row 49): another document's copy of a figure can be treated as new evidence; one matter can occupy several groups; same-answer candidate references caused seven chain or duplication decisions of the generative matcher; empty `original_who` values can count as the same party; different names for one population cause two of nine Jev merge misses. Nine 2026 aggregate-spending theses under `ai-capex` each have a different population; whether to combine them is a product choice. Extraction's instructions remain narrower than the PRD's important-question rule and omit the personal-memo exception, and extraction can change a quantity's meaning before matching (a guarantee amount against financing provided). Classification keeps its [recorded simulation defects](research/2026-10-25-english/classification-existing-defects.txt). The corpus audit recorded 97 official notices with 56 body and file-name collisions, to re-fetch before relying on a rebuilt corpus. An older intermittent search-test failure is untraced. Fresh Idea allocations vary while saved weights do not; the confidence chart applies the current plan to past states and is not a calibrated probability; broad analyst-prose quality and fresh Idea stability remain unaccepted (the [Idea contract](poc/idea-card.md) lists its limits); generative matching dependencies await `matching-v4`. The readers' doubts about the frozen standard, listed in the [extraction branch's state page](research/2026-11-01-e2e-loop/current-state-extraction-branch-2026-11-03.md), remain for Alex.\\n\\nUpstream supply and the human review pool's output remain deferred.\\n\\n## One next task\\n\\n**Where the lean path stands (2026-11-15; D489 to D542).** Alex is not active (D509); D439 is in force: choices go to the\\ncouncil (an independent Codex review and Claude) until consensus, recorded citing D439; nothing is pushed, deployed, published or\\ncommitted; paid calls stay within D439's $40 ceiling (about $18.42 recorded; $0.0134 sent in this period, the ten judge calls of\\nD511 and D519; the lean path $8.34 in all). Every stretch below is closed; its full record is in the decision log and in\\n`research/2026-11-14-use-acceptance/LEAN-LOG.md` (sections 1 to 43).\\n\\n- **The choice between the systems is not made.** The fresh week did not separate them (D489, \\\"not clear\\\"; nothing since ranks\\n  them). The comparison that could choose by measurement was sized and not sent: at the proposed size it may miss differences\\n  that matter ([sizing](research/2026-11-14-use-acceptance/comparison/COMPARISON-SIZING.md), D517). **Production stays the default\\n  and both systems stay (D518).** Alex's product choice on the company's financial figures stands (D505: evidence for related\\n  questions, no table and no questions of their own; D382 and D384 stand).\\n- **For Alex:** the [decision page](research/2026-11-14-use-acceptance/DECISION-PAGE-2026-11-15.md) (its section 7 is the one list\\n  of what is his to choose, what he has decided and awaits building, and the defects with their evidence), the\\n  [side-by-side week](research/2026-11-14-use-acceptance/side-by-side/SIDE-BY-SIDE-WEEK.md) and the\\n  [judge note](research/2026-11-14-use-acceptance/unsupported/DESIGN-NOTE.md) with its one choice.\\n\\n**Open defects found on this path, each with its evidence; nothing is built on any of them:**\\n1. **The new system's delivery gap** (D506, D508, D513, D514): a kept fact that bears on a question by a step of reasoning may be\\n   linked to another question or to none, and so never reach that question's judge; the later-linking step skips a group whose\\n   original statement arrived under another question. Three confirmed fact-and-question pairs in the fresh week, 23 unresolved\\n   ([census](research/2026-11-14-use-acceptance/delivery-class/CLASS-CENSUS-RESULT.md)); one six-call test of its effect was\\n   inconclusive ([result](research/2026-11-14-use-acceptance/effect/EFFECT-TEST-RESULT.md), D511). Paused.\\n2. **The judge, shared by both systems** (D519, D520): on a question that asks for an amount it names a band when nothing shown\\n   sizes the amount, or closes the last gap with a number of its own (36 of 438 stored readings, many of them the same\\n   question read on successive days: a failure pattern on a few question paths, not an error rate;\\n   [census](research/2026-11-14-use-acceptance/unsupported/UNSUPPORTED-CENSUS.md)). Three of the ten settled unsupported answers\\n   coincided with a figure the system held and had not delivered to that question\\n   ([result](research/2026-11-14-use-acceptance/missing-input/MISSING-INPUT-RESULT.md), D530 to D532). What the product shows is\\n   Alex's choice (the judge note).\\n3. **The old system's duplicate questions** (D520 to D523): three pairs in the fresh week; one second question was never compared\\n   with the first, the others were compared and kept apart\\n   ([result](research/2026-11-14-use-acceptance/duplicates/DUPLICATES-RESULT.md)).\\n4. **The old system's filing under the broader question** (D529 to D531): the data-center revenue question never received the\\n   next quarter's guidance or a consensus for the year, filed under total revenue only\\n   ([cases](research/2026-11-14-use-acceptance/d375-measure/SAME-DAY-CASES-RESULT.md),\\n   [trace](research/2026-11-14-use-acceptance/missing-input/FILING-TRACE-RESULT.md)). The relation `docs/prd/10-filing-phase.md` §2 names.\\n5. **Where decisions and code part on dependencies** (D541, D542): `writing.write` drops an edge that would close a circle with a\\n   note where PRD 06 says refuse and ask for a correction; PRD 06's \\\"historical only\\\" branch has a reader and no writer; the\\n   label the seeding module writes on every seed edge (`last_end`) is defined nowhere; no decision says what happens to a later\\n   proposal with another direction for a pair already read.\\n\\n**Decided by Alex, awaiting implementation and acceptance (not asked again):**\\n- **D375, each article sees the questions committed before it.** A passed, bounded serial proof with labelled fake answers\\n  ([result](research/2026-11-14-use-acceptance/duplicates/D375-PROOF-RESULT.md), D526, D528); the eligible same-day cases of the\\n  fresh week read (D529). A real measurement needs a new version of the reading request and a paid run; not opened.\\n- **D368 item 2, the matching step chooses a new question's dependencies.** In the unseeded fresh week one clear case among 97\\n  pairs (data-center revenue reading total revenue;\\n  [census](research/2026-11-14-use-acceptance/dependency-selection/DEPENDENCY-SELECTION-CENSUS.md), D537). As the code stands\\n  one stored edge has two readers (whose conclusion to read; which of two homes is the narrower): the same edge would remove\\n  seven filing links ([proof](research/2026-11-14-use-acceptance/dependency-selection/EDGE-PROOF-RESULT.md), D538). A design that\\n  reads the two uses apart is recorded as **a provisional candidate, not sound for build**\\n  ([design](research/2026-11-14-use-acceptance/dependency-selection/SEPARATION-DESIGN.md), D539 to D542): two proofs on stored\\n  data, the package's suite run under it, every stored dependency row classed. If the slice is reopened, its review must first\\n  settle the cycle through an awaited question at creation, closing behaviour, a theme shown twice, the historical readers and\\n  the label. A statement's home is not something an edge can decide (its section 2.5): the reading step's, the filing phase's\\n  subject. No selection call is designed; nothing was sent.\\n- **D368 item 4, the reading direction for preset questions** (settled by Claude on Alex's delegation): not measured (D536); the\\n  stored seeded draws already agree with the frozen reference on 15, 15 and 16 of 17 questions; the rebuild and dry-run harness\\n  is kept ([page](research/2026-11-14-use-acceptance/dependency-channel/CHANNEL-ASSESSMENT.md)).\\n\\n**The choice is made by the council under D439 (D544, 2026-11-15): the work toward production carries forward on the new\\nsystem; the old system stays the running default until the new one passes its gates; both remain.** Nothing that runs is\\nswitched, deleted or deployed. It is not a finding that the new system's answers are better: the cold reflection (D543) found\\nnothing that ranks the two systems' answers, and the first consensus left the choice to Alex; that deferral was withdrawn the\\nsame day, because his words in D439 give the council the job of taking a course. Reasons: he had reopened work on the rebuild\\nand D439's scope names its steps; it follows the product rule on financial figures he last confirmed (D505); the fresh week\\ngives no demonstrated reason to abandon it and shows fewer trivial or duplicate questions in that one run. Kept in view: its\\nanswer-choice step has not met its lines, Stage B did not pass, integration is undone, and its cost and time to production are\\nunknown. **Alex's word overrides this at any time**; it is also reconsidered on a change of his product rule, a sound comparison\\non shared subjects that favours the old system, or the rebuild failing its unchanged gates within a bound agreed later. A first\\ncheckpoint: $5 of further spending without a candidate that passes its prewritten small test returns the direction to the\\ncouncil.\\n\\n**Since the choice (D545 to D550, all under D439):**\\n\\n- **The fresh week's answer choices, read and traced (D545 to D547).** Of 21 attempts on seven questions, one agreed fault of\\n  Alex's lines (a condition of the topic left out of the choices, six attempts); ranges written with no figure were overrun by\\n  the first filed amount on two questions (the old system shares this). A census of 49 amount questions and an audit of the\\n  request found an undefined term (\\\"the topic's wording\\\") and no mechanism general enough to design for; no prompt change\\n  ([result](research/2026-11-14-use-acceptance/fresh-ladders/FRESH-LADDERS-RESULT.md),\\n  [audit](research/2026-11-14-use-acceptance/fresh-ladders/PROMPT-AUDIT-LINE-2.md)).\\n- **The gates the new system must pass (D548), in order:** the answer-choice step on Alex's lines (D400), not passed; the\\n  judge on the system's own questions (D428), not passed; the end-to-end comparison with Step 2's checks (D427, D431), still\\n  owed, \\\"beats\\\" not yet defined in numbers; use on unseen news (D484), its lines proposed and not his; integration and\\n  release, not written ([frame](research/2026-11-14-use-acceptance/NEW-SYSTEM-FRAME.md)).\\n- **The first blocker (D549):** the step declines some worthwhile questions. From the July refusal review, no general,\\n  permitted change recovers them: no candidate.\\n\\n**The one-week diagnostic of the answer choices is run and read (D550 to D554, 2026-11-15): not clean.** Nothing is live. The\\nnew system read the 272 articles of 2026-10-06 to 10-12 in two parts (the first part stalled when the laptop slept with a call\\nin flight; it was ended and continued from the library after article 120, D551, D552); only the topics and the answer choices\\nwere then run (the matching and the judge are recorded as not run, D553; they can be run later from the merged trace by a\\ndecision of their own). Result ([page](research/2026-11-14-use-acceptance/second-week/RESULT.md)): 13 topics; of 39 attempts at\\nanswer choices 9 were declined, on 4 topics, two of them in all three attempts; three of the zero-fault lines are missed on\\nfaults both reader families agree on; the count by written choices is missed (6 of 12 against 8). The fresh week's picture (no\\nrefusal) did not repeat. It is evidence, not a gate: it passes nothing and reverses nothing. Traced at $0: the largest reason\\nfor declining over every stored run (22 of 37 refusals) is a topic that asks two things (two years, or two figures), which the\\nstep declines by Alex's own rule (D397), a known open defect \\\"until splitting is built\\\"; it starts in the first step's field\\nfor what a topic tracks. Ledger $3.67 of the run's $3.95; paid calls under D439 about $22.10 of $40 (Claude's ceiling). D544's\\n$5 checkpoint is reached for further weeks, so the direction is back with the council.\\n\\n**Changed in the code (D552):** each call of the new system's first step waits at most 600 seconds on a silent connection\\n(`clean-arch/step1/live.py`, `CALL_WAIT_SECONDS`; five tests). Before it, a machine that slept during a call stopped the run for\\ngood; with it, the second part survived eight lost attempts and a second sleep.\\n\\n**Open defects found on the way:** (1) a lost attempt is charged its whole reservation on the ledger (about $0.12 against a\\ncent for an answered call): eight of them used up the room for the matching and the judge; the rule is the design's and was\\nnot changed. (2) The note given to the answer-choice step and to the readers says a year's figures are \\\"published around\\n2027-02; use that day\\\", while code sets the due day 60 days after the fiscal year-end (D414): the two reader families read the\\ndue day apart on 23 points. (3) Reader sessions' dollar cost is not known and is outside every ledger.\\n\\n**After the diagnostic (D555 to D558, all at $0):** the council refused a rule that would take the first-named figure as a\\ntopic's main one (D397, D469, D470); a study of the \\\"no main part\\\" refusals found no candidate\\n([study](research/2026-11-14-use-acceptance/second-week/NO-MAIN-BOUNDARY-STUDY.md)); a map of all four stored readings, reconciled\\nto their reports, shows agreed faults on the zero-fault lines in every reading (6 to 8 marks, of kinds that change) and no\\nbounded way on the record to bring the four to zero together ([map](research/2026-11-14-use-acceptance/second-week/FIRST-GATE-MAP.md));\\nan audit of the two classes that are the step's own (an event's reference; unlisted parts) with an independent second read\\nfinds no bounded, product-relevant repair ready ([audit](research/2026-11-14-use-acceptance/second-week/PROMPT-AUDIT-TWO-CLASSES.md)).\\n**The first gate is recorded as not met; Alex's lines (D400) stay as written; no pass is claimed.**\\n\\n**The core-problem council (D559, 2026-11-15; asked by Alex after the week's result, his words in the decision log), all at $0:** the product\\nproblem is forming answerable questions: a worthwhile matter is left without an answerable question, or a delivered question\\nasks a materially different or potentially unresolvable thing; no single cause is proven. Over July's three runs two reader\\nfamilies found 18 matters: the same judged question in every run that opened it on 3 (a fourth disputed), delivered but\\ndifferent on 3, a question in one run and a refusal in another on 4, refused in both on 1, opened by one run of three on 6.\\nThe clean measurements examined (July, the weeks of 09-22 and 10-06) each start from empty, which the start-state correction\\nof 2026-11-05 above says does not represent the test with an existing research library; that record had no decision number\\nand was not carried into D466 or D469. In the two later weeks, by two families with the articles, 18 of 20 opened topics were\\nstanding matters, 16 of 20 were opened from an article that mentions the matter in passing, and 10 of 20 were on a matter an\\nearlier-dated library already held a question on. These classify 20 selected topics; they are not a rate, and nothing shows\\nyet that a carried library prevents the failures ([council](research/2026-11-14-use-acceptance/reflection-3/cold-codex-5.md),\\n[round log](research/2026-11-14-use-acceptance/LEAN-LOG.md) §51).\\n\\n**The one next task waits on Alex's word (D559):** his confirmation that the next product-oriented test returns to a real\\nstarting library, and then one small comparison: the unchanged first step reads the week of 10-06's opening articles twice on\\nthe same inputs, once from the week of 09-22's own library and once from empty, one draw, read by his rule of 2026-11-05\\n(a matter the library already holds, not opened again, is correct; a matter it lacks, opened, is correct; his words in D559) against the library actually shown, with the\\ndelivery of the article's facts checked apart. The five proofs asked before any send are done at $0 (the starting state, the articles, both\\nrequests through the real entry point, the cases and the reading fixed beforehand, the ledger and the stopping rule under the\\ntrap; [design](research/2026-11-14-use-acceptance/carried-library/DESIGN.md)): 22 reads, a new ledger with a ceiling of $1.00,\\nabout $0.5 expected. Nothing is sent before he says so. D558's completion of the week of 10-06 is superseded as the next step; its\\n[design](research/2026-11-14-use-acceptance/second-week/COMPLETION-DESIGN.md) stays, unsent. The empty-start results and the\\nrecord of the first gate stay as they are.\\n\\nThe paragraphs below are the record of where the clean path's Step 4 stood on 2026-11-12.\\n\\n**Clean Step 4 (D396–D430):** the ladder step was measured four times and has not passed Alex's lines; it is frozen as it ran\\nin the fourth measurement (D426). The frozen judge's baseline on the ruler's ladders is read (3% unsupported, all in figure\\nquestions). **Stage B (the judge on the ladder step's own questions) ran and does not pass** (2026-11-12,\\n[result](../clean-arch/step4-2026-11-10/stage_b/STAGE_B_RESULT.md)): the control line is unexercised (4 controls comparable with\\nreader B's material shown, 8 needed; all 4 agree); the judgement lines are met except the last-judgement line on its strictest\\nreading (3 of 24). Next: the diagnosis of how Step 1 cuts a matter into theses (D432), including council B's $0 trace of the 8\\ncontrols excluded on the question and the 3 with missing material; the end-to-end gate is against production as it now runs,\\nwith no preset questions (D431). Where the whole clean path stands, read by the council:\\n[progress](../clean-arch/step4-2026-11-10/PROGRESS-2026-11-12.md), [consensus](../clean-arch/step1-unfiled-2026-11-08/council/kr-consensus.md).\\n\\n- **What Step 4 is:** the first thing built and tested is the **ladder step alone**: the call that turns a thesis Step 1 opened\\n  into one judged question with its answer ladder and due day, or declines. The frozen judge follows only when the ladder step\\n  meets its lines (Stage B, run 2026-11-12: does not pass).\\n- **Alex's decisions in force (2026-11-10):** one judged question a thesis, the other parts shown as not judged (D397); the step\\n  carries D186 in full (D398); the request may teach how to build an event's five states (D399); Stage A is read against his six\\n  fixed lines with no paid control arm (D400); build and send Stage A capped at $3, a missed line stops and goes to him (D401);\\n  an event's due day is a stated date or the period's last day (D403); a theme's state is never named with a company label\\n  (D404); a reference's words are the article's own, else the answer is sent back once (D405); the build uses the request as\\n  first sent, and code refuses and sends back the faults of writing (D407).\\n- **How the build was reached:** twenty single reviews and five rounds by angle did not reach zero findings (15, 9, 15, 11, 11);\\n  four small sends ($0.105) then showed that sentence changes to the request corrected the writing and lowered the declining of\\n  topics with no main thing (`clean-arch/step4-2026-11-10/probe-2026-11-10/READING-claude.md`).\\n- **The build** (`clean-arch/step4-2026-11-10/ladder/`, `stage_a/`): the step, its model caller, the Stage A runner with one\\n  spending limit and an on-disk ledger, the accounting, the readers' packets and the collection of readings; 109 tests, with a\\n  mutant for each check (40, 11 and 16, all caught).\\n- **Stage A, sent 2026-11-10** (44 stored theses, three sends each; $0.17 of the $3): 111 ladders, 17 declined, 4 refused twice\\n  by code. Two reader families and a third reader on the 73 marks where they differ:\\n\\n  | line | as ruled | whoever reads |\\n  |---|---|---|\\n  | 1. no ladder asks another question | missed, 11 of 111 | 0 failed by both families |\\n  | 2. no ladder leaves a part unlisted | missed, 4 | 0 failed by both |\\n  | 3. no outcome with no rung or two | missed, 16 | missed, 7 failed by both |\\n  | 4. no refusal without a justified reason | missed, 2 of 17 | missed, 1 failed by both |\\n  | 5. 35 of 44 theses right in two of three sends, 28 by a ladder | missed, 21 and 16 | 36 and 30 if every differing mark held |\\n  | 6. the three sends agree | missed: the favourable end differs in 2 of 8 theses, the due day in 11 of 32 | by code |\\n\\n  The two families read the form at different strictness (47 against 84 of 111 ladders sound) and the third reader is of the\\n  stricter one, so the count as ruled is the strict reading. The 25 ladders both families fault are the firm set: five states\\n  for the company in 10 of 17, yes/no in 2 of 24, figures in 12 of 67.\\n- **The classes** (result page): an event's five states (gaps, overlaps, labels, the object); a Yes that needs a confirmation\\n  the No does not; a reported amount carried as the market's expectation, and an expected range the field cannot hold; a\\n  figure's due day estimated anew in each send; the direction of a commitment's amount; a company's quarterly figure laddered; a\\n  group named and not listed, which the families read differently.\\n- **Stage A does not compare the step with production** (D400). The reference reading of 36 production ladders, other\\n  questions, held every firm mark on 19 and on 25 by two readers.\\n\\n- **Open defects of the ladder step:**\\n  - it misses its lines in both measurements; the event answers are changed (D409) and their class is smaller, not closed; a\\n    figure's due day, the reference (D411), a company's quarterly figure and the direction of a commitment's amount are not\\n    yet changed;\\n  - the readers' two families differ at every level (first readers 60 against 90 of 114 ladders sound; third readers agree on\\n    21 of 70 points), so a line's verdict can turn on the reader;\\n  - check 6 sets a footnote marker aside, one thing more than D405's record names: reported to Alex, not confirmed;\\n  - the check on pointing at the item misses \\\"at the item date\\\" (one instance in 111 ladders); mark Q owns the rule;\\n  - the design lost its block on the outcomes of a send, the lines and the accounting at version 29 and had it put back at\\n    version 31; the fourth and fifth review rounds read the design without it.\\n- **Alex decided on the result (2026-11-10):** stay at this step, change the event answers first, check at no cost and have it\\n  reviewed, then run the same Stage A once more within the $3; the other classes one at a time; no Stage B (D408). An event is\\n  answered in at most three outcomes, it happened, it is ruled out, or neither, the last written by code (D409, superseding\\n  D399). A group named and not listed is not a fault of a question (D410). An amount already reported may be a figure's\\n  baseline when named as that, built after the event answers (D411).\\n- **Done since, at no cost** (design version 32, §5.2.1): the request, the schema, the checks and the view writer answer an event\\n  in three outcomes; eight stored theses whose first answers had a gap are answered by hand and pass every check, each former\\n  gap in one rung; the form carries D410 and the event rules; a differing mark goes to two third readers, one of each family,\\n  and an unresolved point is counted both ways.\\n- **Reviewed, probed and sent again (2026-11-10).** Three council rounds on the change did not say \\\"ready\\\"; what they found was\\n  closed by one structural rule (code writes the scope of a ruling out: new, whole and standing) and read by two families on\\n  stated facts (20 of 20 alike, then 21 of 23). A small send (26 theses, $0.03) showed the model writing the new shape; a\\n  decline check beside a fresh control showed 8 against 9 of 15. The second Stage A was sent on my reading that the council's\\n  two conditions were met, not on its clearance ($0.15; 114 ladders, 16 declined, 2 refused twice).\\n- **Alex's instruction (D412):** every round is reflected on in the council to a recorded consensus, then the next test goes\\n  straight ahead on the PRD and its numbers, with every trace read by Claude itself.\\n- **The reflection council's consensus (round log §69, `council/ja-*`, `jb-*`):** no change to the request, the checks or the\\n  form until the second result is read in full and reported; then one next step (if the event class is not closed, report\\n  it, and fix at this step only where the cause is found and no decided rule changes; if it is closed and the lines are still\\n  missed on due day or direction, diagnose the figure's due day over its whole class first); the next stage is not asked for\\n  in advance. Alex decides: any change to what the product does; an important part of a thesis that three outcomes cannot\\n  carry; whether an event undone counts as happened; the footnote marker; the next stage.\\n- **Second Stage A, read (2026-11-10;** [result](../clean-arch/step4-2026-11-10/stage_a/result-2/RESULT.md)**).** The six lines are\\n  still missed. Regression: the due day is the same across sends in 18 of 34 theses, against 21 of 32. On what both first\\n  readers fail, against the first run: R on 4 ladders (7), N on 0 refusals of 16 (1 of 17), 37 theses right and 32 by a ladder\\n  (36 and 30), event ladders with a fault 8 of 43 (13 of 44), theses whose three sends differ in shape 1 (7). On the two third\\n  readers' agreed rulings: Q fails on 2 ladders, L on 1, R on 5; 34 theses right and 29 by a ladder, against the 35 and 28 asked.\\n  The favourable end still differs in the same two theses. The two third readers, one of each family, agree on 21 of 70 points,\\n  so every line is reported under both countings, and how many ladders are sound cannot be said from readers alone.\\n- **The council's consensus on what follows (round log §69, `council/jc-*`):** the event class is smaller and not closed, so\\n  it is diagnosed in full first, at no cost (the model's own ruled-out sentence not bound to a decision after the article; a\\n  question and an answer with different periods; a 2027 question judged in 2028; the object of a regulator's decision); then\\n  the figure's due day over its whole class, with D411's reference checked on its own; the changes and a plan go to an\\n  independent review; a third Stage A needs Alex's word. Reading disagreements a document settles are settled; the few that\\n  need a decision go to Alex.\\n- **Done since, at no cost (round log §69, council `jd`):** the event class counted on the second run (a ruled-out sentence with\\n  \\\"after\\\": R held by both readers on 27 of 31; without: failed or disputed on 9 of 11); one clause of code's sentence changed\\n  so that the scope governs the model's own sentence; proved on six real answers shown with the sentence as it was and as it\\n  is (`dryrun14/`): both reader families place an earlier decision in \\\"ruled out\\\" 6 of 6 before and in \\\"still open\\\" 6 of 6\\n  after, 36 of 36 placements alike and as fixed beforehand. The proof is of six sets of stated facts, not of the judge, and\\n  the event class is not called fixed (a question and an answer with different periods; a missing ruled-out rung; the object\\n  of a regulator's decision). A figure's due day counted on both runs and a candidate rule replayed\\n  (`stage_a/due_day_rule_replay.py`): agreement 18 to 32 of 34, with three figures set months late; no rule is recommended yet.\\n- **D411's reference, built, reviewed and probed (design §5.2.2; round log §69, councils `je`, `jf`):** the reference carries its\\n  kind (expected, or last reported for a figure) and a range by its two ends; the judge's middle rung says \\\"the amount last\\n  reported\\\" for a reported amount. Two council rounds corrected it before any send (a range is spanned end to end by the\\n  middle range; \\\"the same quantity\\\" is defined against a part, a ceiling and another quantity). A small send on 18 theses\\n  ($0.016, one draw) filled the field as written beforehand in all seven reference cases, kept the declines for no main thing,\\n  and sent back no first answer for its quotation (the second run: 68 of 132), which is not claimed until a full run shows it.\\n- **After the reference change: what else moves, and line 6** (round log §69; councils `jg` to `jj`;\\n  `clean-arch/step4-2026-11-10/probe-direction-2026-11-10/RESULT.md`). Read by hand, the small send also showed three company\\n  figures called \\\"higher is good\\\" and two events with a worse ruling out. A three-arm probe registered before its send (the\\n  request as the second run sent it; the working request; the working request with `unclear` allowed for a company figure's\\n  favourable end; 96 first answers, $0.074) found no signal that the reference change caused either: the old request sent in\\n  the same run shows both. It also showed the quotation refused in 15 of 34 first answers of the old request against 5 of 35.\\n  Line 6's two halves were counted at no cost: the favourable end differs within a thesis on two obligation theses in both\\n  full runs, and the model's own account says the texts do not settle it; two independent readers of the texts alone find\\n  \\\"lower\\\" settled in none of seven obligation theses, where the working request says \\\"lower\\\" in 19 of 21 answers. Letting the\\n  model answer `unclear` moved the wobble to two other theses (not shown to work by the registered test). The due day is the\\n  same in 18 of 34 theses and would be in 32 of 34 with a day set by code from the year.\\n- **Alex's choices (D413, D414, D415; 2026-11-10):** where the texts do not settle it, an amount the company owes or\\n  guarantees is registered with the lower end favourable; code sets the due day of a year's figure whose day would be an\\n  estimate (the fiscal year-end plus 60 days; a calendar year-end plus 90); the third Stage A is sent without asking again\\n  once each change is proved small and reviewed, and a change that does not pass stops and goes to him. Both rules are built\\n  (design §5.2.4). D414 replayed at no cost on the second run's stored ladders: one due day in 31 of the 33 theses still\\n  whole (18 of 34 as sent), the new refusal firing only on the three theses that are not a year's figure.\\n- **The third Stage A (2026-11-10; `clean-arch/step4-2026-11-10/stage_a/result-3/RESULT.md`):** sent under D415 after two\\n  small sends proved D413 and D414 (a sentence first added to the request with D414 was refuted by the first small send and\\n  removed; `probe-d413-d414-2026-11-10/RESULT.md`). 132 sends, 108 ladders, 24 declined, none refused twice; $0.11. **Line 6\\n  is met on both halves** (the favourable end the same in 9 of 9 company-figure theses; one due day in 34 of 35). Lines 4\\n  and 5 are met on the two readings that favour the answer (37 theses right, 29 by a ladder) and missed on the strict one.\\n  **Lines 1 to 3 are missed on every reading**, by 1, 1 and 3 ladders that both first readers fail (a survey question re-cut\\n  to a calendar year; a part not listed; three events that write the wait as the ruling out). The two third readers agree on\\n  21 of 70 points. Spent under D401's $3: $0.755.\\n- **Alex's answers after the third Stage A (D416 to D419; 2026-11-10):** the six lines stay; the ruling out of an event is\\n  tried as a typed answer (who decides, what they decide) and proved small first; a rolling twelve months with no\\n  publication day is declined; a government's permission or ban on a class of products belongs to the theme; the fourth\\n  Stage A is sent without asking again once each change is proved small and reviewed. The largest thing both readers fail\\n  was diagnosed first: a wait written as the ruling out, 7 of 140 stored event answers read in full, six on product-deadline\\n  theses (`stage_a/result-3/wait-as-ruling-out-hand-read.md`).\\n- **After the third Stage A: four rules of Alex's, each tested alone, then the fourth Stage A (D416 to D421; design §5.2.5;\\n  `clean-arch/step4-2026-11-10/stage_a/result-4/RESULT.md`).** D417 (a rolling twelve months with no publication day\\n  declined), D420 (an authority's proceeding always has a ruling out), D418 narrowed (a tracked government decision is the\\n  theme's) and D416 (an event's ruling out as who decides and what they decide) each passed a small send of its own; the\\n  typed ruling out failed its first trial and passed its second, after D420. The fourth Stage A: 132 sends, 104 ladders, 27\\n  declined, 1 refused twice; $0.11. **Lines 2 and 6 are met under every reading** (the favourable end the same in 9 of 9;\\n  one due day in 33 of 33 theses whose three sends are ladders). Line 5 is met on the two readings that favour the answer\\n  (40 right, 31 by a ladder) and missed on the strict one (34 and 25). **Lines 1, 3 and 4 are missed**, by 1, 2 and 3\\n  answers on the third readers' agreed rulings (0, 1 and 2 on what both first readers fail): a Kyber question that both\\n  branches of its thesis answer Yes; a question and a Yes condition on different periods; a \\\"restructuring\\\" counted as a\\n  ruling out; three declines for \\\"two figures, none the main one\\\" that no earlier run had. The third readers agree on 29\\n  of 53 points. Spent under D401's $3: $1.136.\\n- **The second-look test (D422; `clean-arch/step4-2026-11-10/probe-second-look-2026-11-10/RESULT.md`): it did not pass.**\\n  76 answers of the fourth Stage A, each sent back once with one instruction that names no fault ($0.12); one blind\\n  reading round of 102 items. Of the 18 answers with an agreed fault, 6 mended (9 needed); of the 30 unfaulted, 3 counted\\n  against it (the page fails at 3). It mends what one rule and one field show (the three wrong refusals, a ceiling as a\\n  reference, a missing unit); it removed two correct references, turned a correct refusal into a ladder and traded one\\n  fault for another twice. The round also re-read the fourth run's answers: 14 of its 18 agreed faults are agreed again;\\n  the two third readers rule alike on 22 of 54 points. Spent under D401's $3: about $1.25.\\n- **Alex's answers (D425, D426):** the second look is not adopted; the ladder step is not tuned further on the 44 theses and\\n  no fifth Stage A is sent. **Stage A has not passed** (lines 1, 3 and 4 missed by 1 to 3 answers of 131). By his word the\\n  preparation of Stage B opens on the step as it ran in the fourth Stage A; no paid Stage B send without his word again.\\n- **The Stage B baseline reading (`clean-arch/step4-2026-11-10/stage_b/RESULT.md`):** the frozen judge on the ruler's\\n  hand-written ladders, 159 stored judgements read by Codex and Claude Opus 5.5 after seven reviews of the plan: 4 of 151\\n  decided judgements UNSUPPORTED (3%), all in figure questions (4 of 52, 8%; yes/no 0 of 99), 7 INSUFFICIENT, 16 of 16\\n  questions end the window SUPPORTED. Every fault is in three figure questions before a sized amount is in view. Controls:\\n  6 of 6 planted caught by both families. The lines' chance behaviour is measured (`line_chance.py`). Council B consensus\\n  (`km`, `kn`): put Stage B's lines and the paid send to Alex.\\n- **Stage B (2026-11-12, `clean-arch/step4-2026-11-10/stage_b/STAGE_B_RESULT.md`): does not pass.** Three draws, 236\\n  judgements, $0.42; the reading plan reviewed five times; trial 6 of 6; both families caught 6 of 6 planted answers. Line 3\\n  unexercised (eligible 7, material shown 4, all agreeing). Lines 1 and 2 met (26 of 26); figure 3.4/3.2/10.5% against\\n  12.7/12.5/14.4%, yes/no 0.9/0.8/4.9% against 5%: met; last judgements missed 3 of 24 on the strictest reading. The families\\n  differ on 22 of 236 and the third readers split on 12 (9 along family lines). Patterns: three-outcome events kept at \\\"Still\\n  open\\\" because nothing is settled yet (Kyber); figure questions with no reference figure the evidence cannot size (19\\n  INSUFFICIENT); a figure carried forward. Council B (`council/la-codex.md`): stands with corrections, applied.\\n- **The control trace (done, `stage_b/CONTROL_TRACE.md`):** most of the 8 question differences are already in the Step 1\\n  thesis (the article's angle: a programme inside a total, the reported date, a later milestone); two missing items are stored\\n  with no link to any thesis though the capex thesis was open; leads, not an attribution.\\n- **The Step 1 diagnosis (D432, `clean-arch/step1-diagnosis-2026-11-12/DIAGNOSIS.md`, version 8; seven council rounds):** c8 states\\n  \\\"one quantity for one period, or one event\\\", but its merge rules carry neither D38's year boundary nor D388's signing exception;\\n  the second year of an annual quantity is never opened (3 graded misses). Proposed to Alex: carry D38's year boundary into two\\n  merge sentences (+151 characters), first tested on stored articles with a c8 arm. Recorded, not proposed: outcomes with a second\\n  thing in them (under most of Stage A's ladder faults, a class to investigate); rolling periods and small matters against c8; a\\n  contract gap between c8's shared_quantity and the ladder step's object and theme rules.\\n- **c14 (D433), stage 1 (`clean-arch/step1-diagnosis-2026-11-12/STAGE1-RESULT.md`): does not pass.** Both years of hyperscaler\\n  capex opened apart in 7 of 9 sends against a line of 8 (c8 0 of 9); one send lost the capex question (c8 never); $0.24. The\\n  misses: the model choosing one year as the bet, and c8's \\\"a customer expanding capacity … is not a thesis of its own\\\" colliding\\n  with shared_quantity. Stage 2 not sent; c8 stays in force.\\n- **Gate 1 done** (`clean-arch/step1-diagnosis-2026-11-12/gate1/`, D435, D436): change 2 (the capacity counterexample scoped) passes\\n  G1-b; changes 1 and 2 together fail G1-a, separating the two years of hyperscaler capex in 5 of 9 sends against a line of 8 (c8: 0 of\\n  9; 20 of 26 over every year-wording send on that article). The misses decline the second year as too much. c8 stays in force.\\n- **Alex carried changes 1 and 2 to gate 2 (D437).** Gate 2 (`clean-arch/step1-diagnosis-2026-11-12/GATE2.md`, version 11) passed\\n  its review in round 11 (`council/mi-codex.md`): c15yc against c8 on seven stored neighbours in three draws, 126 sends, about $1.8,\\n  ceiling $2.2.\\n- **Authority (D439, 2026-11-13):** Alex is not active; every choice goes to the council (Codex + Claude) until consensus, recorded\\n  citing D439. Paid spending in this period: $0.83 (gate 1) of a $40 ceiling (Claude's setting); gate 2 sent on Alex's word (D438).\\n- **Step 1's combined candidate stopped (D441).** Gate 2 failed on the memory article; the council's memory diagnostic (D440) found\\n  c15yc opens a memory-price question less often (17 against 28 of 54, interval -34.6 to -4.8) and pushes it from the ruler's\\n  2027-against-2026 shape to 2026; c8 stays. Spend so far $4.77 of the $40 D439 ceiling.\\n- **The next step (D442–D444): an exploratory end-to-end census.** The clean path's stored chain (unseeded draws 2026-11-10, Stage A\\n  run-4 ladders, Stage B judgements) against fresh production draws (`poc-v118`, no seeded questions), on the frozen judgement ruler by one\\n  method (`clean-arch/e2e-comparison-2026-11-13/DESIGN.md` v4). The first three draws stopped at an over-conservative ledger (D444; kept\\n  as records); three fresh 14-day draws completed 2026-11-13 03:46 (`poc/data/clean-e2e-comparison-2026-11-13/draw-q1..q3`: 243 items\\n  each, 0 failed, 13, 12 and 15 own views; recorded $0.43, $0.46, $0.46). D442's same-day comparison stays owed for D427.\\n- **The census result** (`clean-arch/e2e-comparison-2026-11-13/RESULT.md`): on the seven graded questions both systems agree with\\n  reader B on one or two a draw (production 1/1/1, clean 1/2/1; two unresolved each); no eligible judgement disagrees in either; every\\n  loss is at opening (event deadlines against the standard's rules, the memory comparison never opened, scope). A measuring-stick concern\\n  (D430's same deadline against the standard's 18-month range for q23) is recorded apart (D373), scoring unchanged.\\n- **After the census (D445–D447):** the trace of the clean path's 17 graded opening losses found no single mechanism; a typed-unit\\n  audit found identity fields detect 2 of 16 and recover none, so that line stopped.\\n- **The wiring (D447, D448), built and proved at $0** (`clean-arch/e2e-comparison-2026-11-13/WIRING-DESIGN.md` v4; round log §81): one\\n  shared spending ledger over every paid call (Step 1, Step 2's embeddings and Jev, the ladder step, the judge, production), the\\n  ladder step's and the judge's inputs as arguments, a per-draw orchestrator (`run_fresh.py`). The $0 proof passed: Stage B's three\\n  databases rebuilt row for row through the new inputs; Step 1 (one day), Step 2 (a whole draw, byte for byte), Stage A run 4 (every\\n  outcome of three passes), the judge and production (one day) each sent every network call under a ledger reservation; a ledger\\n  refusal stops every component; bypass mutants are caught. Full suite 287 passed.\\n- **The code review (D449):** eight defects found and closed by four structural rules (stops shared and read before every actual send;\\n  launcher liveness by its lock registered on the ledger; one reservation bound and settlement rule; the proof through the real\\n  orchestrator). `proof_end_to_end.py`: one day through `run_fresh.py` (5 child processes, 55 calls, all reserved), a killed child and a\\n  killed orchestrator handled; full suite 287 passed. Redo of Step 1, Step 2 and production only by a reasoned relaunch; a crash stops\\n  the run.\\n- **The slice (D450) ran and the wiring works live** (`clean-arch/e2e-comparison-2026-11-13/SLICE-RESULT.md`): both draws complete in 8\\n  minutes, every component with real sends on one ledger, every ledger line attributed; $0.159 of ledger (about $0.15 at the published\\n  rates). Every answer read.\\n- **The full run (D451) completed** (`poc/data/clean-e2e-full-2026-11-13/`, 05:44–08:33; c2's Step 1 redone after a dropped response,\\n  D453): ledger $11.43, every line attributed (`spend-by-component.json`). Clean 15/10/15 theses, 69/72/92 judgements; production 12/13/14\\n  views, 92/80/104 judgements, 0 failed. First read in the round log §84.\\n- **The full run, read (D452–D455):** Stage A on the 40 fresh theses misses lines 1–5 and meets line 6 (`STAGE-A-FULL-RESULT.md`); the\\n  census (`CENSUS-FULL-RESULT.md`): settled agreements on the seven graded questions clean 2/1/0, production 1/1/1 (2/2/1 and 2/2/2 with\\n  unresolved points counted), no eligible judgement disagrees, every loss at opening; the clean path kept 51 of 55 decisive facts of its lost\\n  questions, production 39 and left kept Kyber and Ohio facts unlinked; Stage B line 3 unexercised (0 settled, at most 4 of 8), its judgement\\n  reading stopped (D455).\\n- **Traced since (D456–D458), all at $0:** production's kept-but-unlinked facts cost no final answer in this window (three mechanisms,\\n  `unlinked-trace/UNLINKED-TRACE-RESULT.md`); the opening losses hold few shown breaches of the standard, spread over small mechanisms, and\\n  their largest classes are choices the standard leaves open (`opening-review/OPENING-REVIEW.md`); no opening phase is opened.\\n- **Since (D458–D460):** Stage A's first-pass faults form no class (`stage-a-trace/STAGE-A-TRACE-RESULT.md`); the model's accounts make\\n  two opening mechanisms strong leads, the unsigned Ohio guarantee folded into the programme's amount (seven draws, both systems) and the\\n  next year's capex folded into this year's question (five of six clean draws), and show the standard's keep-apart line for unsigned deals\\n  missing from the clean Step 1 request (`opening-review/D459-RESULT.md`).\\n- **Since (D460–D462):** the whole-request audit of clean Step 1 (two readers apart, `step1-audit/AUDIT.md`) finds the standard's identity\\n  boundaries missing from its request (the unsigned deal beside a plan's amount; another year of a shared quantity) and one date sentence\\n  narrower than the standard (F6); F6 decided only one or two of 26 memory declines (`step1-audit/f6/`) and is recorded, not tested alone.\\n  The status report for Alex, reviewed by the council for accuracy: `clean-arch/e2e-comparison-2026-11-13/STATUS-FOR-ALEX-2026-11-13.md`.\\n- **Since (D463–D464):** the identity lever is a prompt clause first; candidate c16 (version 5, four blind audits) and a case-specific\\n  diagnostic on fresh articles (one story per target boundary is all this window holds), 7 merge and 9 negative stories and the stored guards\\n  (`clean-arch/e2e-comparison-2026-11-13/identity-probe/v2/PROBE-DESIGN-v2.md`).\\n- **Since (D465–D466):** the identity diagnostic moved its error (c16 not adopted, c8 stays; `identity-probe/v2/RESULT.md`, $4.49); a deep\\n  reflection council (Alex's request) agreed the second half of the day circled and reset the plan.\\n- **Since (D467–D473):** the ladder-cost proofs are kept as tools (`ladder-cost/`); the ladder-refusal candidate stopped on a contested\\n  \\\"main figure\\\" boundary; the 41 Stage A reader splits recorded, none changing its verdict; the ten right-by-refusal theses traced; the period\\n  candidate c17 failed its frozen lines (memory and federal openings suppressed; `period-probe/RESULT.md`). Step 1 sentence changes on these\\n  articles stop (D473). Provisional choices under D439 (D469): empty-start measurement; the three open shapes stay concerns; the written-ladder\\n  line stands (D471). Alex's answer overrides any of them.\\n- **Since (D474–D477):** the unsigned-deal candidate c18 was not adopted (`unsigned-deals/RESULT.md`). The source check of the eleven\\n  first-pass refusals (`reachability/RESULT.md`): six right, four reachable only on paper, one split. **D477:** Stage A not passed; no theme or\\n  ladder change for the H100 boundary; no more Step 1 sentence changes on these articles; production stays the default; the clean path's\\n  three product choices are written for Alex (`clean-arch/e2e-comparison-2026-11-13/CHOICES-FOR-ALEX-2026-11-13.md`).\\n- **Since (D478–D482), under D439:** choice 2 tested and failed (c19); choice 3 taken (production stays the default); production's price\\n  rule (D191.4) tested and failed (`docs/research/2026-11-13-shared-quantity-price/`); no further paid test on the frozen ruler (D482).\\n- **Alex active again (2026-11-14).** D483–D486: a use-oriented acceptance was designed and its $0 trial read\\n  (`docs/research/2026-11-14-use-acceptance/TRIAL-RESULT.md`); Alex asked for a leaner path (small steps, each run fast). D487: step 1 built nothing (the\\n  \\\"dated after the article\\\" statements are correct dates against items stored a day early); step 2 runs one fresh week (2026-09-22..28, 235\\n  items proved identical for both systems), one draw a system, a one-day slice first, readings A and B, the decision rule written before\\n  reading (`LEAN-LOG.md` §2). Slice passed; production's week draw complete; the clean draw stopped twice on dropped connections, root-caused and fixed (D488: Step 1 resends a\\n  network loss, each attempt on the ledger). The clean week draw completed from empty (`poc/data/clean-lean-week-2026-11-14/week-r2/`, $2.52; both ledgers $4.69). **Result (D489,\\n  `docs/research/2026-11-14-use-acceptance/week/WEEK-RESULT.md`):** not clear by the rule written before reading; no system chosen. Production\\n  covers 4 of the 5 big matters two blind reader families listed, the clean path 2 (it lacks revenue and margin by D382/D384); judgement\\n  support does not rank them at this size. The question then put to Alex (whether the new system holds questions on the company's main\\n  numbers) was answered by him on 2026-11-15 (D505; see \\\"One next task\\\").\\n  Recorded spend under D439 at that point: about $18.4 of $40 (about $7.26 before the run; the run's ledger $11.43, somewhat above its cost at the\\n  published rates); the current figure is in \\\"One next task\\\". (An earlier line here gave \\\"about $29.2\\\" as tracked spend; no decision or\\n  log records that figure and it is withdrawn.)\\n- **Open defects recorded by this review:** the frozen judge retried 10, 16 and 18 judgements in the seeded clean draws, 38 of 51\\n  reasons a theme cited as a dependency (PRD 11, E4), and its stored path holds the 2026-07-05 fault above (frozen; findings for\\n  Alex); the same matter takes different shapes between draws (Kyber due end-2027 in one draw and end-2028 in another); under D397\\n  the second bet of a topic that holds two has no answer; five-state event ladders failed by hand three times before a construction now in the request\\n  produced ones that pass a reader; in Stage A the model's own are faulted by both reader families in 10 of 17 for the company.\\n- **The unseeded measurement (D395):** graded subset 4.0 against 6.33 seeded. Every miss is a question not opened in the ruler's shape.\\n  Judged answers 16 of 16, on the ruler's wording and ladder; the system's own questions have never met a judge.\\n- **Stage 2 of D392:** clean 18, 18, 17 against v108 17, 15, 16, inconclusive on q12.\\n- **Known gap (D394):** capital spending (q12).\\n\\nNo long job is running.\\n# The frame after the choice: what the new system must pass, where it stands, and the first blocker (D548, under D439), 2026-11-15, $0\\n\\nWritten at the council's instruction after D544 (the work toward production goes on the new system; the old system stays the\\nrunning default until the new one passes its gates). Every line that is not Alex's own is marked as proposed. Nothing here\\nchanges a gate, a line or a frozen piece.\\n\\n## 0. Frame\\n\\n- **Objective:** bring the new system (`clean-arch/`: Step 1 at configuration c8, Steps 2 and 3, the step that writes answer\\n  choices, the frozen judge) through the gates below, so that it can replace the running default. Alex's word overrides the\\n  choice and any gate at any time.\\n- **Reference system:** the old system as it runs (`poc/config/poc-v118.json`), kept as the default and as the comparison.\\n- **The ruler:** the frozen ruler stays as it is (D261); no further paid test on it (D482).\\n- **Budget:** about $18.43 of D439's $40 recorded (Claude's ceiling, not Alex's). D544's first checkpoint: $5 of further\\n  spending on this direction without a candidate that passes its prewritten small test returns the direction to the council;\\n  $0.0022 of it used.\\n- **Stops in force on the new system's pieces:** the step that writes answer choices is frozen as it ran in the fourth Stage A,\\n  with no further tuning on Alex's 44 theses and no fifth run on them (D426); Steps 2 and 3 are frozen (D427); no more sentence\\n  changes to Step 1 on the July articles (D473, D477); no theme or ladder change for the rental-price boundary (D477); the\\n  judge is frozen (D354). A new version of any of these is a council decision under D439, reviewed before any send.\\n\\n## 1. The gates in force, in order (council round 7 of the cold thread)\\n\\n| Order | Gate | Its lines, and whose | Where the new system stands | What is not yet written |\\n|---|---|---|---|---|\\n| 1 | The step that writes answer choices (Stage A) | Alex's (D400): no question other than the topic's, no part left unlisted, no outcome with no range or two, no unjustified refusal; 35 of 44 topics right in two of three attempts, 28 of them by written choices; the same favourable end, and the same due day for nine in ten | **Not passed.** July, 40 fresh topics: the four hard lines each missed by one or two attempts even on the favourable count; 32 right, 22 by written choices (the council's scaled diagnostic, 32 and 26, is not Alex's number). Fresh week, 7 topics: no refusal; the omitted-clause marks of D547 | nothing |\\n| 2 | The judge on the system's own questions (Stage B) | D428, against the baseline reading: unsupported amount answers at most five points above baseline; unsupported yes-or-no answers at most 5%; unsupported last answers at most 3 in 30, scaled; the design's completeness, coverage and control conditions | **Not passed** (2026-11-12): four qualifying controls with the needed material against eight required (question mismatches and missing material both contributed); the last-answer line missed on its strictest reading, 3 of 24 | nothing |\\n| 3 | End to end against the old system, and Step 2's checks in that run | D427, D431: after gate 1 and 2, both systems unseeded on the frozen reference, the same day, three runs each; Step 2: search at least 90%, clear wrong merges at most 2%, no later detail lost through grouping | **Still owed as an acceptance.** The July census (new 2, 1, 0; old 1, 1, 1 of seven graded questions) was exploratory | a complete numerical definition of \\\"beats\\\" |\\n| 4 | Use on unseen news | opened by Alex beside the existing gates (D484); it changes none of them by itself (D483). The lines in `ACCEPTANCE-DESIGN.md` (four in five big matters covered; at most one in five questions trivia or duplicate; nine in ten last answers supported; at most one in twenty cited statements wrong; no undelivered fact that would change an answer) are **proposed, not his** | **Not an accepted gate yet.** One week, one run, as evidence for its design: 2 of 5 matters (2 of 2 outside the financial lines D505 excludes), 1 of 7 trivia, 6 of 7 last answers supported by both reader families, three confirmed undelivered pairs | the lines; how D505 counts in coverage; the number of runs |\\n| 5 | Integration with production storage and the pages, and release | the whole path integrated and accepted on the product's own path before it replaces the default | **Not started** | its acceptance and its numbers |\\n\\n## 2. The first blocker: worthwhile questions the step declines (gate 1, the count by written choices)\\n\\nThe bounded question the council set: **can a general, permitted change recover a worthwhile question the system declines,\\nwithout making it answer questions it should refuse?** Answered from the stored records alone\\n(`clean-arch/e2e-comparison-2026-11-13/reachability/RESULT.md` with its theme census; `CHOICES-FOR-ALEX-2026-11-13.md`; the status\\npage's record of D467 to D482).\\n\\n**The population.** In July the step's first pass declined eleven of the 40 topics. Two blind readers agree on ten: six are\\nrightly declined (five matters; four of the six are topics the first step should not have opened: a completed stake, a stake\\ntoo small to matter, a background sentence, an outcome no public material settles; two are the survey question Alex ruled out,\\nD417); four are worth a question the article supports, on two matters. One is split. Reaching the scaled 26 needs all four and\\nno loss elsewhere.\\n\\n| Lead | The mechanism on record | A general change? | What stands against it |\\n|---|---|---|---|\\n| the memory-price pair | the first step's shape of the topic: a rolling twelve months; a second figure (a bank's estimate of one rack's memory cost) that no public material settles | none on record that is permitted: two first-step candidates aimed at this class failed their lines (c15yc, c17), first-step sentence changes on these articles are stopped (D473, D477), and the answer-choice step declines a rolling window by Alex's own ruling (D417) | the stops themselves |\\n| the rental-price pair (one article) | the step's rule \\\"a matter that no theme in the request's themes covers\\\", applied to twelve themes shown by id and name only. The census: the same topic declined in 5 of 9 attempts and given choices in 4 (three under \\\"Semiconductor cycle\\\", one under another theme); memory prices go under \\\"Semiconductor cycle\\\" in every attempt, though that theme's stored watch list holds only industry revenue growth. Six topics in all were declined for coverage in 12 attempts, three of them given choices in other attempts | in principle: tell the step what each theme carries, so that coverage is decided against a definition and not a name | what a theme carries is a product definition in `poc/universe.json`, which the old system shares; its stored definition of that theme does not include prices, so showing it as it is would make the step decline prices more consistently, not less; the definition itself is the first of the three choices written for Alex on 2026-11-13, untested. D477 stopped a theme or ladder change for this boundary after the check that the question, where it was opened, was decisive in no judgement of that window. The Stage A readers had ruled these refusals right on the list as it stands |\\n\\n**Upside and protection.** The rental-price pair is at most 2 of the 4 the scaled count needs (22 to 24 of 26). None of the six\\nright refusals is a refusal for theme coverage, so a change of what the themes carry would not by itself turn them into\\nquestions; the three other topics declined for coverage (a lidar ban, the CPU-to-GPU ratio in inference, Huawei's chip output)\\nhave never been read for whether they are worth a question.\\n\\n**Answer: no candidate.** The records establish a mechanism for one of the two matters, and for that one the change is a\\nproduct definition already put to Alex and stopped by a council decision, worth at most half the gap, with nothing on record\\nthat the recovered question would receive sound choices or matter to a judgement. For the other matter no permitted change\\nexists. On the stored evidence the count by written choices is not reachable by a permitted change to the answer-choice step:\\nits distance is set upstream, by the topics the first step opens (rightly refused ones, and the memory shapes).\\n\\n## 3. What follows (D549, D550)\\n\\nThe council accepted \\\"no candidate\\\" for the question asked, with two limits: the four recoveries are paper estimates, and the\\nrecord does not prove that no future change is possible. The state of the first gate on news outside the tuned days is\\nunknown (July: three runs over the same fourteen days; the fresh week: seven topics, no refusal), so the next step is a\\nmeasurement, not a repair: one more week through the new system, read for its answer choices, as a diagnostic that passes\\nnothing ([design](second-week/DESIGN.md)).\\n\\n## 4. The start state of the measurements (D559)\\n\\nEvery reading of the first gate listed above was taken on topics the first step opened from an empty library. The status\\npage has held since 2026-11-05 that Alex requires a test to start from a library established from real material available\\nbefore the test start; D559 gives that record a number and puts its confirmation to him. Until he answers, the readings\\nabove stand as empty-start results, and the next product-oriented test is not designed from empty\\n([council](reflection-3/cold-codex-5.md)).\\n# The use-oriented acceptance: design for Alex's decision (D484), version 3, 2026-11-14\\n\\n**What it decides.** Whether a system gives an analyst a usable research record on news it has never seen: the big questions opened, the\\njudgements supported by what they were shown, the statements accurate against their articles, and no fact that would change a judgement left\\nout, within the articles read. Both systems, the same days. It is added beside the frozen ruler, which stays and is reported unchanged on its\\nown window (D261); it changes no existing gate by itself (D483). Version 2 answers council round 6 (`council/mw-codex-6.md`); version 3 round 7 (`mw-codex-7.md`).\\n\\n## Run\\n\\n- **News:** 2026-09-22 to 10-05: 479 eligible articles, of which 6 were sent by earlier Step 1 runs (takeover and unfiled rounds, 2026-11-07/08)\\n  and are removed; 473 never sent by any stored run or probe (checked over every run database and probe record, the source copies excluded;\\n  the list is frozen, `fresh-articles-2026-09-22-10-05.json` with its sha256, which also names what sent each removed article: the\\n  Step 1 test traces of the takeover and unfiled rounds). The 2026-09-08..21 window is not used: the unsigned-deal probe sent four of its articles.\\n- **Draws:** three per system, launched together, from an empty library, in publication order (AGENTS §7.3: totals from three draws). Reported\\n  per draw and in total; no draw is added after the result.\\n- **Systems:** production as it now runs (poc-v118) and the clean path as frozen (Step 1 c8, Step 2, the ladder step, the frozen judge). No\\n  production change, no new prompt.\\n- **Cost:** priced from the full run's charged cost per article: production about $1.20 a draw, clean about $6.00 a draw; about $22 for the six\\n  draws, a reservation ceiling of $35. This is above the $40 ceiling I set myself while Alex was away ($29 spent); it needs his word.\\n\\n## Readings (two reader families, blind to the system and to each other; disagreements listed; key disputes to Alex or a reader he names)\\n\\n- **Scopes, each stated with its result:** A's missed questions and C cover a sample of 80 of the 473 articles, stratified by day (seed fixed\\n  before the run), and are stated for those 80, not for the window; A's quality marks, B and B2 cover every question each draw opened in the\\n  window, every last judgement by 10-05, and every statement those judgements cite (window-level).\\n- **A, big questions:** each family lists from the 80 articles the questions worth tracking on their own; then each system's questions are\\n  marked opened / narrower / broader / missed per matter. Counted: matters both families list, and separately matters only one lists (reported\\n  with the disagreement, not dropped). **Covered** = opened, or narrower when the narrower question carries the matter's main outcome (each such\\n  call written with its reason); broader and missed are not covered. Each system's opened questions are also marked worth tracking / trivia /\\n  duplicate.\\n- **B, judgements:** every question's last judgement by 10-05, read against the request as sent. Planted wrong judgements are built on requests\\n  not otherwise in the packet; supported controls are confirmed by a separate reader first and any disputed control is replaced.\\n- **B2, statements:** every statement a last judgement cites, against its own article (the passage located in the article text): date,\\n  speaker and summary.\\n- **C, delivery:** first, a separate fact listing: each family reads each of the 80 articles and lists every statement that bears on a covered\\n  matter (with its passage), not only the sentences that raise a question; then code classes each listed fact per system (not extracted / no\\n  link / linked elsewhere / delivered in the request of a judgement after it arrived), checked by hand; the undelivered ones are read against\\n  the full judgement request (\\\"would it change the rung?\\\"). Controls of both kinds: known \\\"would not\\\" (facts already in the request, or\\n  unrelated) and a known \\\"would change\\\" **group** (PRD 10's custom-chip case: a group of facts moved 9 of 9 sends off the lowest rung), read\\n  as a group because no single-fact positive case is established.\\n- **Denominators and empty cases:** a system that opens no question on a matter is \\\"missed\\\", never excluded; a system with no judgement on a\\n  covered matter fails B for it; an empty denominator is reported as not measured, never as met.\\n\\n## Lines (for Alex to set; a starting proposal, not decided)\\n\\n| reading | proposed line, per system, in at least two of three draws | basis in the trial (leads only) |\\n|---|---|---|\\n| A | covers at least 4 in 5 of the matters both families list | 6–7 of 7 in the trial |\\n| A | at most 1 in 5 of its opened questions marked trivia or duplicate by both families | clean acceptance D386: 1 of 10 |\\n| B | at least 9 in 10 last judgements supported by both families | 7 of 9 and 10 of 12 in the trial |\\n| B2 | at most 1 in 20 cited statements wrong in date, speaker or summary against the article | 4 of 201 flagged by both, unconfirmed |\\n| C | no undelivered fact both families say would change a judgement | the product's purpose (PRD 10 §1) |\\n\\nA system that meets every line is usable on this news; which system goes forward, and whether either is called production-ready, is Alex's\\ndecision after the result.\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n./docs/research/2026-11-14-use-acceptance/reflection-4/codex-design.jsonl:14:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_5\",\"type\":\"command_execution\",\"command\":\"/opt/homebrew/bin/zsh -lc 'cat docs/prd/10-filing-phase.md docs/prd/11-production-experiments-from-split.md docs/prd/05-extraction-standard-corrections.md'\",\"aggregated_output\":\"# Core PRD for the next phase: filing must recognise indirect relations the way an analyst does\\n\\n> Status: in progress (opened 2026-11-04). Alex: \\\"你把这个写好成下一阶段核心PRD然后不要drift, 把所有需要的context 全部充分记录，每次开始前都需要revisit, 然后开始做\\\".\\n> This page is the single source for this phase. In a conflict: Alex's words → `docs/DECISIONS.md` → this page → the other design documents. This page's\\n> conclusions, evidence, constraints, measuring method and process are not rewritten to follow test results;\\n> test results go into `docs/research/2026-11-04-filing-end-to-end/log.md`, and changing this page first needs Alex's word.\\n> Amended 2026-11-04 (Alex replied \\\"go\\\" to the proposed amendment; D360): §5.2 drops \\\"also file under the other party's question\\\" and puts two\\n> sentences in its place, one on choosing and one on splitting; §6's decision rule is rewritten. How it came about:\\n> `docs/research/2026-11-04-filing-end-to-end/prd-amendment-proposal.md` and `log.md` rows 11–16.\\n> 2026-11-05 (D368): translated into English on Alex's word (\\\"不，用英文吧\\\"); §4 corrected to name the frozen standard's version 5 and §5 given a status line, on his delegation (\\\"你要来帮我看到底做不做\\\").\\n\\n## 0. Checklist before every start (Alex: \\\"每次开始前都需要revisit\\\")\\n\\nBefore starting any step, finish these in order; if one cannot be done, do not start:\\n\\n1. Read §§1–8 of this page in full; read the last three rows of `log.md`, and confirm where the previous step stopped and why.\\n2. Check against §3, \\\"not in scope\\\": what this step does is not in that table. If it is in the table, stop and take it to Alex.\\n3. Check against §4, \\\"constraints\\\": this step changes nothing frozen; a change to the frozen extraction prompt is the one place §5 names, and Alex's\\n   word for it is already given.\\n4. If this step costs money: its predictions and stop conditions are written down and frozen as §7 says (with their sha256 recorded beside them); the\\n   requests are rebuilt byte for byte as §6 says; the control is re-sent the same day.\\n5. What goes to Alex: one conclusion, one recommendation, one test, after §7's rounds of review; no menu of options; in plain words (the opening of\\n   AGENTS, \\\"Explain and answer as to a sixteen-year-old\\\").\\n\\n## 1. Goal (end to end)\\n\\nEach question's judgement must receive the facts that can change its answer; facts that no question receives, those that bear on no question, must\\nnot be piled into some one question. What is measured is the final judgement (the frozen judgement ruler, reader B, at the window end 2026-07-14), not\\nany one step's own score.\\n\\n## 2. The core blocker (proven)\\n\\n**The system uses a fact for a question only when the fact \\\"states exactly this question's own figure\\\". An analyst also reasons onward from a fact: the other party's figure in a deal, price and volume for a product's revenue, a product's variants for its launch, and so on. The filing step cannot do this; the judging step reasons onward once it has the facts.**\\n\\nThis one blocker has two faces (described earlier as \\\"two problems\\\"):\\n\\n- **The parking lot.** Filing does not recognise facts that bear on a question indirectly, so no question takes them; yet to be kept, a fact must\\n  first be filed (D209, D264). So D273 added the fallback sentence, which parks them in NVIDIA's total-revenue question. Of the reports under the\\n  total-revenue question, in the part the gold read, 32–39% are ones the standard does not keep, 31–44% are kept but used by none of the 22 questions,\\n  and only 7–10% are what the gold actually uses to judge total revenue (three draws); 24–44% of the total-revenue question's judgement citations are\\n  news about other companies or the whole market (Intel graphics-card retail prices, a gas-fired power plant in Taiwan).\\n- **Narrow questions starve.** Questions that only indirect facts can answer do not receive them: the custom-chip question received none of Broadcom's\\n  figures in any of the three draws, and judged \\\"below $40 billion\\\" in all three; the operating-margin and NVIDIA capital-spending questions received\\n  nothing at all and were never judged.\\n\\n**Evidence:**\\n\\n| Evidence | Content | Source |\\n|---|---|---|\\n| Filing recognises only \\\"its own figure\\\" | The model says \\\"Broadcom's AI chip revenue is not cloud providers' spending on custom chips\\\" and \\\"Google Cloud's backlog is not capital spending\\\"; on a neutral refiling (no question id named, the rule not shown), 23 of 42 facts that matter are still not filed | `probe-filing-account-d1.md`, `refile-no_fallback.json` |\\n| The judgement reasons onward once it has the facts | The custom-chip question's request of 7-14, sent 3 times in each of the three draws: as it was, 9/9 \\\"below $40 billion\\\"; with the Broadcom, Trainium and other facts written in that draw's ledger added, 9/9 left the lowest rung (6 times $40–60 billion, 3 times $60–80 billion), reasoning as the two readers did (\\\"guidance $16 billion, about $64 billion annualised, less networking chips\\\") | `predictions-one-test.md`, `one-test-result.json`, `log.md` row 8 |\\n| Where the parking lot came from | D273: with the fallback sentence added, the core items on the extraction ruler went 64 → 68; the extraction ruler does not look at which question a fact is filed under (AGENTS §7.1, \\\"What it does not measure\\\") | `docs/DECISIONS.md` D273 |\\n| What the parking lot holds | The figures above; an independent reader on 12 random articles: of 25 misfilings as it was, 21 were parked in the revenue question; 8 and 5 with the fallback deleted | `sink_by_standard.py`, the independent reader's report (`log.md` row 8) |\\n\\nAll files above are in `docs/research/2026-11-04-filing-end-to-end/` unless noted otherwise.\\n\\n## 3. Ruled out or secondary (outside this phase's scope, each recorded separately)\\n\\n| Matter | Conclusion | Source |\\n|---|---|---|\\n| The argument card | Not built; its code is deleted (Alex: \\\"好，删掉卡片代码\\\") | `docs/research/2026-11-04-argument-record/log.md` rows 4–11 |\\n| The arrows of the question graph | Really wired backwards: a seed question's arrow means \\\"supports\\\" (D208), while the judging code reads it as \\\"whose conclusion to read\\\" (PRD 06). As a result themes are judged only after the total-revenue question, so the total-revenue question reads the themes' conclusions of the previous day, and in draw 3 a chain of questions went wrong in turn. But it does not explain the misfiling (filing comes before judging), and the gold itself judges data-center revenue as \\\"total revenue × 92%\\\". A topic of its own; settled by D368 (item 4: the arrow means \\\"supports\\\"), its fix to be built and measured | `core-problem.md`, `review-core-codex.md` |\\n| Code removes the total-revenue question's own figures | True (\\\"keep only the narrowest question\\\" takes a seed arrow for \\\"a narrower sub-question\\\"), but each draw it costs the total-revenue question only 0–2 of the facts it needs | `log.md` row 8 |\\n| A filing re-check added at the end | Recovers some, and misfiles about as many (independent reader: about one misfiled for each one filed right); not the solution | The independent reader's report |\\n| One general sentence, \\\"the other party's figure in a deal counts too\\\" | The custom-chip question gains, but it pulls Morgan Stanley's price for a Rubin rack from the Rubin revenue question to the capital-spending question, and leaves some facts with no home | `answers.json` (the two arms definition and definition_no_fallback), `measure-corrected.txt` |\\n| Tightening D259's \\\"leeway\\\" | Alex's own decision; this phase does not overturn it | D259 |\\n| Opening questions (the Ohio guarantee was not opened); the two readers' disagreement on the China-share question | Another class of problem, not in this phase | `docs/research/2026-11-04-filing-end-to-end/diagnosis.md` §0 |\\n| Model drift | With the same requests, today about half as many facts go into the total-revenue question as on 11-03; the cause is not proven. Compare only with a control re-sent the same day, never with the archive | `log.md` row 6 |\\n\\n## 4. Constraints (what must not move, and why)\\n\\n- **The frozen ruler** (AGENTS §7.1, D261, D262): the extraction standard, version 5 (the signed version 3 with D248's seven boundaries and D250's four\\n  evidence boundaries and counting unit), golden-v5, the seed questions and the judgement gold; not a word changes; a disagreement is a gap in the\\n  system (D263).\\n- **The frozen extraction prompt** (D274): v74i (`poc-v108`) does not change by a word; what this phase changes is the one place that holds the filing\\n  rule (the description of the `links` field), made into a new version with a new configuration and compared with v74i. Alex has given his word for this\\n  work (2026-11-04: \\\"好你去解决问题\\\", \\\"开始做\\\"); making it the default needs his word again.\\n- **Frozen opening and judging** (D354): this phase does not touch them.\\n- **The standard's text** (in translation): §6, \\\"file under the narrowest open question; when no question takes it, record no home and drop it, and read\\n  each one at evaluation\\\"; §5.1, \\\"makes the answer to some question more or less likely\\\", with four paths, \\\"demand, supply, competition, pricing\\\"; §5.3,\\n  \\\"another company's matter is not kept when one cannot say which question about the covered company it moves through a path such as demand, supply,\\n  competition or pricing\\\".\\n- **Decisions**: D207 (one home per fact, the narrowest question), D209 (no home means dropped, each one read), D259 (leeway: a figure question takes\\n  \\\"the demand, supply, competition and pricing that make it more or less likely\\\"; the total-revenue question taking more is an accepted cost, \\\"bounded by\\n  the narrowest-question rule and the driver questions\\\"), D265 (code keeps only the narrowest), D273 (the fallback sentence), D355 (the two failed tests\\n  of the previous filing topic).\\n- **Prompt principles** (AGENTS §6): carry only the standard and add no new rule; a general hedge-fund analyst: every rule and example reads the same\\n  for a bank, a drug maker, a retailer or a chip company, names neither NVIDIA nor its products or figures, and is not taken from a test article; a\\n  classification is written as a closed set with two or three examples per class, replacing the abstract wording; quality is not fixed by lengthening\\n  the prompt: remove as much as is added, or write down the reason.\\n- **Code decides only \\\"is it the same thing\\\", never \\\"does it matter\\\"** (AGENTS §2).\\n\\n## 5. What to do\\n\\nStatus: the links-rule version that carried items 1–3 (v74l) failed its one test (§8 step 5); D361 keeps the fallback sentence, so item 3 is not carried out. The plan below is kept as written.\\n\\n1. **Replace the abstract sentence \\\"makes the answer more or less likely through demand, supply, competition or pricing\\\" with the few classes in which an analyst recognises an indirect relation, written as a closed set, each class with two or three examples from other industries** (AGENTS §6: one\\n   abstract sentence is a coin flip on every send; examples replace it). A first draft of the classes (checked against the standard line by line at\\n   design time; it holds only meanings the standard already has):\\n   - The question's own figure: this question's figures, guidance, estimates and revisions (estimates for another period or another population follow\\n     the existing rule).\\n   - The other side of the same money: a seller's revenue from the buyers the question counts; those buyers' orders and backlog with these sellers.\\n   - Price and volume: a product's price or shipments, for the question on that product's revenue.\\n   - Variants and parts: a product's variants, alternatives, key parts and schedule changes, for the question on that product's launch.\\n   - Demand, supply and competition moves with a number: customers' orders and capital-spending plans, suppliers' capacity and prices, competitors'\\n     sales and share, for the question they affect.\\n2. **State how to file a fact when two specific questions both bear on it** (the problem the `definition_no_fallback` arm exposed: Morgan Stanley's rack\\n   price was filed under the buyers' capital-spending question, and the seller's Rubin revenue question lost it). One home per fact (D207): file it under\\n   the question its figure measures most directly (for example, a hotel's room rate goes under its room-revenue question, not under the\\n   travellers'-spending question; a parts maker's revenue from carmakers goes under the carmakers' parts-spending question, not under a rival parts\\n   maker's share question); when one sentence gives a separate figure for each of two questions, write two items, each filed under its own question\\n   (code stores two items that quote the same sentence as one record linked to both questions); never also file it under a broader question about the\\n   same company (the failure of D355's test 2: the model filed it under an NVIDIA revenue question as well). The original draft's \\\"when the other\\n   party's question is open … file it there as well\\\" conflicted with D207 and was deleted on 2026-11-04 with Alex's agreement (D360).\\n3. **Delete the fallback sentence** and return to the standard's §6: when no question takes a fact, it is not filed; code drops it as \\\"no home\\\" and\\n   records it (D209), and evaluation reads each one.\\n4. Change only the one place that holds the filing rule; report its length in characters before and after, and write down the reason for any growth\\n   (this time's reason: examples replace one abstract sentence).\\n\\n## 6. How to measure (the ruler does not move; the method does not change again)\\n\\n- **Requests**: rebuild each stored request byte for byte with the production code, changing only the one place that holds the filing rule; the\\n  rebuilt request's archive id must equal the original's, or it is not sent (`resend_filing.py`, AGENTS §5). Never re-send the archive's copy whose\\n  keys were sorted alphabetically.\\n- **Articles**: development set = the 54 articles of `selection.json` (already read many times); held-out set = articles the extraction gold read and\\n  the judgement gold uses that are not among those 54, drawn once before the test, with the list frozen and never changed afterwards. Both sets are\\n  measured and reported apart.\\n- **Control**: the unchanged requests re-sent 3 times the same day. No comparison with the archive (model drift).\\n- **Each answer**: goes through the production code checks and filing first (including \\\"keep only the narrowest\\\" and \\\"no home means dropped\\\"), and is\\n  counted after.\\n- **What is counted** (`measure_filing.py`, with its matching rule fixed: items are matched on the distinct numbers and the proper nouns other than\\n  NVIDIA in the source text; a source passage the system quotes that overlaps the gold's passage also counts as the same matter; \\\"optional\\\" counts as\\n  optional; the citations in the body of the gold's answers are read):\\n  - whether each fact that matters (one the gold uses to judge any question) reached the question that uses it, counted per fact, not per \\\"fact ×\\n    question\\\";\\n  - per question: the facts that matter that reached it and the new noise that appeared, counted by the decision rule below;\\n  - the parking lot: how many facts the total-revenue question (v1, together with v22) takes in, and what they are;\\n  - noise: how many of the sentences the standard does not keep are kept; per question, how noise is filed (links on facts the standard does not keep\\n    or no question uses);\\n  - how many core and supporting facts appear; the facts that matter that are dropped; how many questions each fact is filed under on average.\\n  - Matching still has a small error (spot check: the new rule mismatches a few and misses a few); say so when reporting the numbers, and read the\\n    ones that matter one by one.\\n- **Decision rule** (rewritten on 2026-11-04 with Alex's agreement, D360. The original draft required \\\"every draw above the highest of the control's\\n  three\\\" and the like, which the control itself fails when measured again, so it cannot tell good from bad. Script `decide.py`; written down and frozen\\n  before each test; each draw's numbers and the totals are all reported):\\n  - **Totals, with luck ruled out first**: each article's 6 answers from the new and the old arm are randomly reassigned between the two arms 4,000\\n    times (with a fixed random seed); the new rule's difference counts as a real change only when fewer than 5% of the reassignments reach it.\\n    - Development set: facts that matter reaching the question that uses them must rise; the count under the total-revenue questions (v1, v22) must\\n      fall; sentences the standard does not keep must not rise; core facts must not fall.\\n    - Held-out set: facts that matter reaching the question that uses them must not fall; sentences the standard does not keep must not rise; core\\n      facts must not fall.\\n  - **Per question, counted by code against the gold** (development and held-out sets together):\\n    - A fact that matters which reaches the question at least two fewer times under the new rule than under the control counts as \\\"one fewer\\\" for that\\n      question; in under the control all three times and under the new rule none of the three, it counts as \\\"lost outright\\\". A move to another question\\n      that the gold also uses it for and that is no broader than the original (one home per fact, D207) does not count as fewer; a move to a broader\\n      question counts. \\\"One more\\\" in the opposite direction offsets it.\\n    - A noise sentence (not kept by the standard, or kept but used by no question) that the new rule files under the question at least twice while the\\n      control never does counts as \\\"new noise\\\"; filed all three times, it counts as \\\"outright new noise\\\". The opposite direction offsets it.\\n    - Any question with a net 3 fewer, a net 2 lost outright, a net 5 more new noise, or a net 3 more outright new noise fails. These thresholds are the\\n      smallest values that keep \\\"misjudged when new and old are exactly the same\\\" within about one in ten; at the test, first compute the\\n      misjudgement rate from the reassignments; if it is above one in ten, raise the threshold most prone to misjudgement by one step, then compare with\\n      what was measured.\\n  - **Smaller changes** (a question 2 fewer, two or three more noise) cannot be told from luck in three measurements: all are listed, given to a reader\\n    who did not write the rule to read against the raw answers, and written into the report; they do not decide pass or fail.\\n  Only when everything passes does it become a candidate; a candidate runs end to end three times on the 14-day window (extraction re-sent, matching and\\n  judging run as usual, scored on the frozen judgement ruler), and that step needs Alex's word.\\n\\n## 7. Process (no drift)\\n\\n- **One recommendation and one test at a time** (AGENTS §7.3, Alex: \\\"就测试一种，一次\\\"): write the design first and put it through rounds of review (own\\n  checks, Codex read-only, a reader who did not write it reading the raw records) until a round finds nothing serious; write down and freeze the\\n  predictions and stop conditions; test once; if it does not match, stop and take it to Alex (D355: \\\"如果有什么不符合hypothesis 的地方你需要终止然后和我说我们重新评估\\\").\\n- **A review's report is a lead**: each finding counts only once it is checked against the records (AGENTS §1).\\n- **A prompt audit before any prompt change** (`.claude/skills/prompt-audit/SKILL.md`): check the whole request against the standard sentence by\\n  sentence, in both directions.\\n- **Every step goes into `log.md`**: what was done, what came of it, the files; mistakes and overturned results stay in it too.\\n- **Do not repeat what was ruled out** (§3).\\n\\n## 8. Steps and where we are\\n\\n| # | Step | Output | Status |\\n|---|---|---|---|\\n| 1 | Design: the classes of indirect relation (a closed set + examples from other industries), how to file when a fact measures both sides, deleting the fallback; checked against the standard sentence by sentence; length before and after | `docs/research/2026-11-04-filing-end-to-end/design-links.md` | Done (draft 3, v74l / poc-v115) |\\n| 2 | Checks at no cost: a sample answer written by the new rule goes through every code check; the new rule's text goes through the prompt audit | Same as above | Done |\\n| 3 | Review rounds (Codex, independent readers, own), until nothing serious remains | `review-links-*.md` | Done (Codex 7 rounds, independent readers 3 times; round 7 found nothing serious) |\\n| 4 | Draw and freeze the held-out set; write down and freeze this test's predictions and decision rule | `heldout.json`, `predictions-links.md` | Done (sha256 recorded for both) |\\n| 5 | Test once: development set + held-out set, the new rule and the same-day control 3 times each | `answers-links.json`, `log.md` | Done (2026-11-04): failed: facts that matter reaching the right question, development set +7 (p 0.26); every other condition passed |\\n| 6 | If passed: to Alex, to decide whether to run three 14-day end-to-end draws; if failed: stop, to Alex | `design-links.md` §8 | Stopped, to Alex |\\n| 7 | (D361, Alex: \\\"按照你的提以来，但是你一定是自己反思多轮之后才给出的行动\\\") Measure the ceiling first: hand the source passages the gold cites straight to the frozen judgement; the custom-chip, operating-margin and capital-spending questions judged 3 times each at the window end, the custom-chip question as it was 3 times as the control; the fallback sentence is not deleted for now | `reflection-v74l.md`, `oracle-design.md` | Done: operating margin grounded 3/3, capital spending 2/3, custom chips 0/3 (the gap is in interpretation); the next step waits for Alex |\\n| 8 | (D362, Alex: \\\"你继续啊不要scope drift and strongly follow evidence of your discovery and learning\\\") Two small changes where facts are not delivered, one at a time: ① when a quote is rewritten, code matches it back to the source sentence (changing nothing the model sees; verified by replaying the archive); ② a figure question's description states which figures it is derived from by definition (first sent 3 times each on the article that motivated it) | `delivery-fixes.md` | Stopped: an independent check overturned the first change's code (it would take in wrong figures); the second failed its trial send (1/3). The root: the signed standard's §5.3 does not keep two key facts, treating them as \\\"a restatement of known facts\\\" (proposal 6, awaiting approval); to Alex |\\n| 9 | **Historical; superseded by D370.** (D363, Alex: \\\"乙\\\") At coverage start, record each question's starting figure once from the company's latest earnings report; the daily path still takes no restatements: design, rounds of self-checks and independent checks, validated first on the archive in the simplest way | `baseline-design.md` | Validated on two questions: the frozen extraction does not read the report's tables (0/3); with each question reading the report once on its own, the operating-margin question read its starting figure 2/3 and the capital-spending question 3/3, and the judgement then judged right (2/3, 3/3), about 2.5 cents. All 22 questions tested once (2026-11-05, Alex: \\\"你充分验证\\\"; files chosen by code, a same-day control, about $0.43): v10 and v12 judged right 9/9 each; no question already judged right turned wrong; but 5 of the 53 figures read were other quantities (the Vera CPU question and the Blackwell and Rubin question took a larger or neighbouring revenue line), so it failed condition 3, written beforehand. The model itself pointed to the reading instructions' sentence \\\"write the lines it is computed from, or the line the report uses for it\\\"; stopped, to Alex. Alex: \\\"改\\\"; only this sentence was changed (\\\"write only the lines it is computed from, or the same quantity under another name; never a broader line or a line next to it\\\"), tried on 4 questions first, then tested on all 22 (about $0.36): all three conditions passed: v10 and v12 9/9 each, no question judged right turned wrong, and all 46 figures were the questions' own quantities. Checked after an independent reader's challenge: the new sentence made the reading miss the capital-spending line in 3 of 12 reads, and it had been tested only on the one May report; the fourth version (a line-by-line re-check after writing) removed too much and failed; after a census of every failure trace (Alex: \\\"我需要你深度看完所有失败trace给我准信\\\"), the third version with the repaired quote check was chosen (D365): 0 wrong figures on the held-out August report; built into the production system (poc-v116; the $0 checks and the tests all pass). The full acceptance, three 14-day draws (Alex: \\\"跑验收\\\"; a same-day control; about $4.79): all passed: operating margin and capital spending judged right 3/3 each (the control never judged them), 53 against 45 in total (of 57); for the China-share question, the only one two fewer, both readers found the starting figures did not lead it astray. Alex: \\\"都做\\\": poc-v116 became the default (D366); the code was committed and a PR opened |\\n\\n## 9. Alex's own words on this matter (in time order)\\n\\n- \\\"你这个单独开一个专题出来解决 … 是promot，是系统结构设计还是到底哪里有问题挂错一堆东西，机制是不是有问题（一定要挂吗？有没有可能是杂音\\\" (2026-11-03)\\n- \\\"So if it's a customer problem or other companies that you think is relating NVIDIA and it's the wrong evidence, then what is the standard for it? … from a hedge fund analyst standpoint, are these even relevant? Do you think your ruler is wrong in this aspect?\\\" (2026-11-04)\\n- \\\"你确定下你接下来要改进的量化目标，以及你要看到端到端我们的管线是要做什么的，不要乱硬优化，要看到目标\\\" (2026-11-04)\\n- \\\"就测试一种，一次 … 能不能自己有个超级自信的定论和证据再给我提建议\\\" (2026-11-04)\\n- \\\"这些只是类型题，你需要抽象拔高我们现在的核心问题和卡点。这个很重要这样改下去才是对的\\\" (2026-11-04)\\n- \\\"你把这个写好成下一阶段核心PRD然后不要drift, 把所有需要的context 全部充分记录，每次开始前都需要revisit, 然后开始做\\\" (2026-11-04)\\n- \\\"go\\\" (2026-11-04, on the proposed amendments to §5.2 and §6 and on this test)\\n# PRD 11 · Production experiments drawn from the failed split extraction\\n\\nStatus: proposed, 2026-11-06. Nothing here is built in main. Each experiment is a new production version that only Alex opens (D359), measured\\nagainst the frozen production configuration on the frozen ruler (AGENTS §7.1). Decision: D378.\\n\\nAlex, 2026-11-06: \\\"我觉得你把拆分版学到的东西，有用的给cherry pick 出来，做一个PRD我们来给到生产版来实验；你现在封存拆分版并且清理赶紧并标注失败的实验吧\\\"\\n(pick out what the split taught that is useful, write a PRD so we can experiment with it on the production version; seal the split, clean it up\\nand mark it as a failed experiment).\\n\\n## 1. What failed, in one paragraph\\n\\nThe split extraction read each item with two calls: one proposed new questions, the other filed evidence under existing questions, and a third\\ncall (record preparation) completed the new questions. It was built in production shape and benchmarked against the frozen production\\nconfiguration (poc-v108). The benchmark ran three window draws and three test-article draws for each arm, under a design agreed with Codex.\\n- The split reached fewer helpful matters: 156, 156, 159 against 166, 170, 162. The difference of −9 falls outside the −8 same-configuration\\n  range, so the stop line fired (D355).\\n- Its judgement scores were 44 against 47, and it cost about 15% more.\\n- Its one strength was opening more questions worth following: 25 against 6 over three draws, but also 17 against 6 that the standard would not\\n  open.\\n\\nOne revision was screened on Alex's word. It moved the evidence call to keep-then-file. It reached production's level of helpful matters (92.0\\nagainst 94.0 on a 69-article set), and it kept more of what the standard rejects than production does (22–23 against 17.3 a send). So it is not\\nadopted.\\n\\nThe split is sealed as a failed experiment. Its record is on branch `fix/no-preseed-evidence-review`, tag `split-extraction-failed-sealed-2026-11-06`,\\nwith the seal note `docs/research/SEALED-FAILED-split-extraction-2026-11-06.md`.\\n\\n## 2. Experiments for production, in order of expected value\\n\\nEach item gives the problem in production's own stored data, the evidence, the cheapest proof to run first, and the code that already exists. The\\ncounts come from the three same-day production draws of the benchmark (`runs/control-v108-d1..d3` in the sealed worktree) unless stated.\\n\\n### E1 · Helpful statements production writes and then drops as \\\"no home\\\"\\n\\n- **Problem.** Production's extraction writes a statement, finds no open question to file it under, and drops it (D209). The three window draws\\n  dropped 441 statements this way, about 147 a draw. Independent readers put 60 of production's 213 missed helpful-matter draws down as \\\"written,\\n  then dropped by a check\\\", almost all of them no home. On the 30 test articles it was 36 of 68. On the window it is the second recall loss after\\n  \\\"the model did not write it\\\" (116 of 213); on the test articles it is the largest. (Corrected 2026-11-06: this line first called it the largest.)\\n- **What the split showed.**\\n  - Opening more questions and offering homeless statements to the item's new questions recovered some of these.\\n  - It also opened questions the standard would not open (17 of 44), and half its new questions had no ladder.\\n  - A keep rule tied to existing questions loses useful facts.\\n  So the remedy is not obvious, and the next step is a diagnosis.\\n- **Cheapest proof, $0.**\\n  - Read every helpful no-home drop of the three production draws beside its source and the questions open at the time. Put each down as either:\\n    - a link miss: an open question takes it under the link rule (the fallback to the company-wide revenue question, D273/D361, included);\\n    - an opening miss: the question that would take it does not exist.\\n  - The packets already exist: `docs/research/2026-11-06-architecture-benchmark/results/traces-window-control.json` and\\n    `traces-test-control.json`.\\n  - The larger class picks the experiment: a link-rule fix, or an opening fix, each with its own audit (AGENTS §6).\\n- **Result of the diagnosis (2026-11-06; `docs/research/2026-11-06-e1-no-home-drops/`).** 57 matters, two readers, 44 of 54 agreed: link misses\\n  17 (4 core), opening misses 3 (1 core), and a third class, 24 small matters the standard's §6 itself drops (none core); 10 disputed, all on the\\n  fallback or the indirect clause; 3 quote refusals. Opening is not the experiment. Of the link misses, 12 are the question's own quantity in\\n  another period or quarter, or a variant of a tracked product; the model's account says it read the question's period, population or named\\n  configuration as a boundary. Only 8 of their 13 dropped window draws were lost to the product (5 reached the question from another\\n  article), and no lost window judgement is shown to follow from them. Any fix is a new extraction version only Alex opens (D359).\\n- **Not to repeat.** A gate that keeps only statements connected to an existing question (§4).\\n\\n### E2 · Duplicate questions: the analyst review with relation definitions\\n\\n- **Problem.** In unseeded runs, matching let duplicate questions open:\\n  - a part-of relation at Jev probability 0.49 under the 0.5 threshold (seven-day run, seq 1253);\\n  - a later deadline for the same event (seq 1312).\\n- **What the split showed.** The matching code is production's, and two changes cut the duplicates the blind reader found in the first-100 runs\\n  from 3 to 1, then 0, then 0:\\n  - collision-v4/v5: each relation defined beside its field; a later deadline for an open one-off event is the same question; a coarser or finer\\n    reading of one outcome on one date is the same question, with D210's exception for an unsigned deal;\\n  - review of unkeyed proposals at any Jev probability, plus the closest existing question the proposer names.\\n  The seeded benchmark could not test this: both arms opened 0 duplicates there.\\n- **Cheapest proof.** Replay stored matching inputs of the seven-day and first-100 runs through production with these changes ($0 where the\\n  archive answers; cents for the new review calls). Then an unseeded window of production with and without them, duplicates read blind, recall\\n  on the frozen ruler.\\n- **Code to port** (sealed worktree):\\n  - `views/jev_matching.py`: `unkeyed_collision_peers`, `COLLISION_SCHEMA_V4`, `RELATION_DEFINITION_PROMPTS`;\\n  - `prompts/collision-v4.txt` and `collision-v5.txt`;\\n  - `tests/test_unkeyed_collision_matching.py`.\\n\\n### E3 · Code checks for new questions' ladders (with D186)\\n\\n- **Problem.** A new question's ladder can be inverted (the Strongly bullish rung holds the unfavourable range), carry a band whose bounds miss\\n  the stated reference, or carry a rung that holds no value. The split met each case:\\n  - a \\\"within 5%\\\" band whose bounds missed by $100 million (seq 1280);\\n  - an \\\"exactly $279 billion\\\" rung with equal bounds (seq 1210);\\n  - inverted ladders in its confirmation run.\\n  Production's stored numeric ladders, mostly seeds, show 0 empty rungs in 160.\\n- **Fit.** Alex asked for D186 (rungs against guidance) and D191.4 (shared quantity) in the next extraction version (2026-11-05: \\\"这个你记住，我们要做\\\").\\n  The split's checks belong there:\\n  - a favourable end that orders the rungs in code;\\n  - each numeric condition rendered from its bounds;\\n  - a stated band recomputed;\\n  - an empty rung refused;\\n  - the D197 key for a calendar-year theme quantity.\\n- **Cheapest proof, $0.** Run the checks over every stored production answer and count what they refuse; read each refusal before adoption.\\n- **Caution.** In the split, whether a new question got a ladder at all was a coin flip on the same request (21 of 44 had one). A reworded\\n  reference sentence lost two control ladders. Checks, not wording, are the part to port.\\n- **Code to port:** `split.ordered_ladder`, `band_problem`, `empty_rung`, `render` and `shared_key`, with their tests in\\n  `tests/test_split_extraction.py`.\\n\\n### E4 · The judge's refused answers: a theme cited as a dependency\\n\\n- **Problem.** In the three production draws, the frozen judge's refused answers carried 25 errors. 18 of them were \\\"X is not a dependency of Y\\\": a\\n  theme question, shown to every asset judgement under D191, written into `cites_views`, which holds dependencies only. A refused answer is retried\\n  once. A second refusal stops the run, as it did once in a split draw on the same frozen judge.\\n- **Cheapest proof, cents.** A judging version (judging is frozen, D354; only Alex opens one) where the `cites_views` field's own description says\\n  dependencies only and themes go to `theme_pushes` (the rule sits with its field, AGENTS §7.3). It is re-sent on the stored refused requests, and\\n  their refusal rate is counted against the stored answers.\\n\\n### E5 · The revision's statement day (D203)\\n\\n- **Problem.** D203 says the revision path stores the stated day, but production's writer stores the ordering day (`writing.py`,\\n  `store.revise(..., new_day, ...)`).\\n- **Evidence.** The benchmark's gate replayed a stored production draw: 4 of its 6 revision rows differ on this field alone. No judging request\\n  read it.\\n- **Fix.** One line, already in the sealed worktree (`store.revise(conn, target_id, stored_id, e['original_day'] or '', seq)`). It needs a test\\n  that fails on the old line.\\n\\n### E6 · The measurement kit, as the standard way to measure a production version\\n\\nBuilt and reviewed with Codex for the benchmark (`docs/research/2026-11-06-architecture-benchmark/` in the sealed worktree):\\n- `bench_run.py`:\\n  - a seeded fixture ledger;\\n  - per-draw pins of code, prompts, inputs and scoring files;\\n  - refusal of a resumed draw whose pins or mode differ;\\n  - an offline mode that replays a stored draw. It reproduced a stored production draw table by table (24 tables).\\n- `bench_measure.py`:\\n  - D372 counting at two points, the checked handover and the ledger;\\n  - where each helpful matter ends;\\n  - D373 printed;\\n  - refusal of runs not made by the harness.\\n- `bench_traces.py`: every missed matter with its source and full raw answers.\\n- Blind packets for questions, records, hits and extras, and screen pools.\\n- `compare_ledgers.py`.\\n- The screen rule (`results/results-reading.md` §4): the current version's self-variation over all splits of six sends, a same-day production\\n  reference, and \\\"not decidable\\\" when a self-check fails.\\nIt is ported to main when the first experiment is opened.\\n\\n## 3. Measured and not worth an experiment now\\n\\n| Idea | Measurement | Verdict |\\n|---|---|---|\\n| The split architecture as a replacement for production's extraction | §1 | Failed; sealed |\\n| Wider quote matching (hyphen glyphs, closed-up dashes, \\\"28.1 %\\\") | 0 of the 17 production quote refusals in three draws recovered | No gain for production |\\n| One record per quoted statement keeping every summary (production's sift keeps the first) | 4 second summaries lost in 729 production answers | Too small alone; fold in if `sift` is touched |\\n| Reading long items in sections | 7 of 34,084 corpus items exceed 400,000 characters; none in the window | Not now |\\n| Reading every open question before each item (D375), research subjects outside the universe | Not tested apart from the split | Unknown; not evidence either way |\\n\\n## 4. Lessons for any production prompt change\\n\\n- **Keep, then file.** A keep rule tied to connection with an existing question filtered useful indirect facts and product-detail noise\\n  together. Removing it brought both back. Noise is handled by the standard's not-kept rules, never by a connection gate.\\n- **Extras are not noise.** In both arms about half of the statements the gold does not list are statements the standard keeps (blind read).\\n  An \\\"extras\\\" count is a quantity to read, not a score.\\n- **The not-kept count can match a neighbouring clause.** 10 of 212 matched pairs were records whose summary kept another statement. A result\\n  near a line is blind-checked before it decides.\\n- **A model call is a sampler.** The same stored request re-sent recovered 10–13 of 27 matters chosen because they had been missed. Items chosen\\n  by misses inflate any recovery.\\n- **Re-send production bytes.** The archive stores requests with sorted keys. A request is rebuilt by production code and its identity checked\\n  before it is sent (AGENTS §5).\\n# Corrections to the extraction standard page\\n\\nThe extraction standard page, [`05-extraction-standard.html`](05-extraction-standard.html) (its version 5), is piece 1 of the frozen ruler\\nand is never edited (D261, AGENTS §7.1). A statement in it that a later decision changed is recorded here, dated, with its reason and its\\nbefore and after; the page is read together with these records, which are never merged into it. Records 1–3 below correct the page's description of the pipeline and judging; record 4 describes a later decision for a new evaluation version. Historical gold and scores do not change.\\n\\nRecorded on 2026-11-05 (D368, on Alex's delegation: \\\"你看该怎么处理核实\\\"). Each statement was found verbatim in the page's text with its tags removed (the decision or PRD named at a quote's end is a link in the page).\\n\\n## 1. What the extraction sees\\n\\n- **Where:** §4, the test \\\"not a duplicate\\\" (\\\"抽取看不到库D211，这一条在抽取时只对同一篇文章里提出的几个问题判；和库里的比由匹配做\\\"), and §5.3,\\n  the row \\\"known facts restated\\\" (\\\"抽取看不到库，只能从文字和日期看\\\").\\n- **Before (D211):** the extraction request showed no question and no group of the library.\\n- **Now (D251, D264):** the request shows the questions open at the start of the item's day, each with its code-written takes line, and the\\n  extraction files each statement under them; it still sees no question's evidence or rung.\\n- **What still holds:** whether a candidate duplicates a question of the library is decided by matching (Jev with the collision judge,\\n  D169, D190); a restated known fact is still recognised from the text and its dates, since the extraction sees no stored evidence.\\n\\n## 2. The research deliverable\\n\\n- **Where:** §7 (\\\"研究的交付物是论证：保留不可改的来源记录，和一份有版本的研究论证，写明支持和反对的来源、是否独立、变化和局限D201\\\").\\n- **Before (D201):** the library would keep, besides the source records, a versioned research argument per question.\\n- **Now:** the argument record is not built. Two versions were measured on 2026-11-04 (judging-v8 and judging-v9) and set aside, and their\\n  code removed at Alex's word (\\\"好，删掉卡片代码\\\"; `docs/research/2026-11-04-argument-record/log.md`, rows 4–11). The library keeps the\\n  immutable source records, and each judgement stores its reasons, the outcome it implies and the evidence it cites with each piece's\\n  direction.\\n\\n## 3. What decides a question's rung\\n\\n- **Where:** §5, the relations between tiers (\\\"判断时只有事实能确定到期落在哪一档PRD 06\\\"), and §7 (\\\"只有事实能确定落在哪一档PRD 06\\\").\\n- **Before:** only the \\\"fact\\\" tier could establish the rung; the other tiers strengthened or weakened.\\n- **Now (D260, D263):** a judgement is a forecast: the rung the evidence in force makes most likely at the due day, judged against a\\n  reference (consensus, guidance, the stated plan or deadline); \\\"not established\\\" is never a reason to stay. The four tiers and counting\\n  by original source stand (D30): a fact fixes what is known, a party's own statement is the strongest input to the forecast, and views\\n  and rumours move it by their specificity. PRD 06 states the rule.\\n\\n\\n## 4. Capture of core and supporting evidence (D369; 2026-11-05 UTC)\\n\\n- **Where:** §6 and §9.2–9.3 distinguish core and supporting, and score each separately.\\n- **Before:** core and supporting had separate evaluation thresholds under the frozen v5 ruler.\\n- **Future evaluation:** Alex decided that both should be captured without a strict pass/fail boundary between them. An indirect item may be retained when the model judges it relevant and the logic is clear; the reviewed MXC announcement is retained as supporting. Do not present inference as a sourced fact. The optional and not-kept boundaries, source tiers and quality checks are not changed by this decision.\\n- **Status:** the v5 page and its gold remain frozen. A new evaluation version and its gold require derivation, independent review and Alex's sign-off before scoring; old scores retain their original definitions.\\n\\n## 5. Research-library context timing (D375; 2026-11-05)\\n\\n- **Before:** D251/D264 described the open-question snapshot at the start of the item's day.\\n- **Current design:** Alex decided that each item reads the latest committed questions immediately before it, including earlier same-day writes. The two split extraction calls for that item share the same snapshot.\\n- **Status:** this changes the product design, not the frozen standard page or its historical gold and scores. The existing default still uses day-start context; implementation and acceptance of the new path are pending.\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n./docs/research/2026-11-14-use-acceptance/reflection-4/council-codex-69.jsonl:7:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_2\",\"type\":\"command_execution\",\"command\":\"/opt/homebrew/bin/zsh -lc \\\"nl -ba docs/CURRENT_STATE.md | sed -n '135,165p;310,343p'; rg -n '\\\"'^## D(517|519|520|565|566|567|568|569|570|571|572|573|574)'\\\"\\\\\\\\b' docs/DECISIONS-log.md; nl -ba docs/research/2026-11-14-use-acceptance/contested-six/RESULT.md | head -75; nl -ba docs/research/2026-11-14-use-acceptance/page-contract/SERVE-RESULT.md | head -60; nl -ba docs/research/2026-11-14-use-acceptance/unlisted-parts/topics-66.txt | head -35\\\"\",\"aggregated_output\":\"   135\\t- **Served data:** the service, the MCP server and the standalone page serve the sealed three-month ledger `served-2026-10-28-v34-nvda-3m-through-0828` (68 theses, 34 groups; D358), built by the earlier `poc-v34` pipeline, not by the replay default. HTTP `/library`, MCP `thesis_library` and the standalone page share the dated bundle writer.\\n   136\\t- **Idea API:** `poc-v118-idea` (D290, D335, D374): two discovery calls and one adoption and weighting assessment; only adopted theses with positive weights appear, and nonempty plans total 100%. The [Idea contract](poc/idea-card.md) owns its fields and the limits of its scores.\\n   137\\t- **Interface:** the Thesis Library and Explore Ideas workspaces, with the confidence Trigger and an Action preview (no wallet connection or order execution). The [UI specification](poc/thesis-ui.md) and the [integration guide](../poc/ui/README.md) own its behaviour.\\n   138\\t- **Repository:** `main` holds the product, the frozen ruler and the research records; run databases, logs and model archives stay on disk (D353), located by the [data manifest](research/2026-10-25-english/data-manifest.md). Worktrees: `/Users/lchingen/hivemind` is the main checkout, where slice branches are cut from `main`; `/Users/lchingen/hivemind-extraction-quality-2026-10-28` (the extraction branch, merged on 2026-11-03) keeps in its ignored folders the stored end-to-end runs of `poc-v91` to `poc-v95` that later comparisons read (D359); `/Users/lchingen/hivemind-run-v109-2026-11-04` is the finished judging-v8 run's worktree. Older branches stay in Git without worktrees (D359); none is merged work in progress. The clean source-text comparison and its condition-hidden review are complete; council discussion of next steps is ongoing.\\n   139\\t\\n   140\\t## Open defects\\n   141\\t\\n   142\\t1. **Competitor and customer news is filed under the company's revenue questions** instead of the share, capital-spending or custom-chip question it informs (D355; filing is otherwise about 85% right). Share facts are often not written at all, an extraction recall miss. The total-revenue question holds about a quarter of all links (D354).\\n   143\\t2. **One bet opened twice** about one encounter in five: the collision judge splits a seed question from an identical candidate on a fine detail (D354).\\n   144\\t3. **A question the standard rules out** (the lidar legislation) was proposed by the extraction and opened in one draw of three (D354).\\n   145\\t4. **A thesis opened from an article gets no dependency of its own**: the default Jev matching asks for none (`views/jev_matching.py`), although D51 has the matching call choose them; themes still reach every company thesis through the theme block (D191, D195). Found in the 2026-11-05 consolidation; building it is decided (D368).\\n   146\\t5. **Historical coverage-start reading, retired by D370** (D364–D366): the capital-spending line is missed in about one read in six (the question is then left as it was); a labelled guidance figure is written with the fact tier; later reports reach the questions only through the daily stream; `scripts/preflight.py` does not replay the reading's check.\\n   147\\t6. **Measured on one company and one 14-day window**, the judgement scored at the window end only; no version of the current pipeline has completed a longer window (a 60-day run of `poc-v108` was stopped at Alex's word after 2026-07-15, [log row 8](research/2026-11-04-argument-record/log.md)). The China-share question (v17) swings between draws (0 of 3 in the acceptance, 2 of 3 in its control, 1 of 3 in the frozen draws): two readers found the starting figures did not cause the acceptance's drop, and the byte-identical extraction request kept a \\\"share fell to zero\\\" sentence in two candidate draws and dropped it in two control draws. One acceptance draw judged nothing on v16; its cause is not established.\\n   148\\t7. **What a judgement reads grows with the window** (D358). Argument records (D201) were measured as the remedy on 2026-11-04 and not built: judging-v8 agreed 12 of 17 against 15 of 17, judging-v9's card added little at about half again the judging cost; their code was removed at Alex's request ([log rows 4–11](research/2026-11-04-argument-record/log.md)).\\n   149\\t8. **Seen once, not traced.** A judgement named a shown theme as a dependency and the check refused it twice, stopping a draw for a day (2026-11-02, D266). The sealed run's review recorded that a succession's opening evidence is not linked to the new question (D358), not yet checked against today's code.\\n   150\\t9. **Earlier defects, unchanged.** Matching (build log row 49): another document's copy of a figure can be treated as new evidence; one matter can occupy several groups; same-answer candidate references caused seven chain or duplication decisions of the generative matcher; empty `original_who` values can count as the same party; different names for one population cause two of nine Jev merge misses. Nine 2026 aggregate-spending theses under `ai-capex` each have a different population; whether to combine them is a product choice. Extraction's instructions remain narrower than the PRD's important-question rule and omit the personal-memo exception, and extraction can change a quantity's meaning before matching (a guarantee amount against financing provided). Classification keeps its [recorded simulation defects](research/2026-10-25-english/classification-existing-defects.txt). The corpus audit recorded 97 official notices with 56 body and file-name collisions, to re-fetch before relying on a rebuilt corpus. An older intermittent search-test failure is untraced. Fresh Idea allocations vary while saved weights do not; the confidence chart applies the current plan to past states and is not a calibrated probability; broad analyst-prose quality and fresh Idea stability remain unaccepted (the [Idea contract](poc/idea-card.md) lists its limits); generative matching dependencies await `matching-v4`. The readers' doubts about the frozen standard, listed in the [extraction branch's state page](research/2026-11-01-e2e-loop/current-state-extraction-branch-2026-11-03.md), remain for Alex.\\n   151\\t\\n   152\\tUpstream supply and the human review pool's output remain deferred.\\n   153\\t\\n   154\\t10. **A new-system store being written serves its first day in progress** (D573, D574; `docs/research/2026-11-14-use-acceptance/page-contract/LIVE-READ-DESIGN.md`, B):\\n   155\\t   before any day completes, the service's default date falls back to the latest judgement's day. Not built: a correct guard needs one\\n   156\\t   snapshot for the check and the read, MCP's start and the streamed Idea response handled; 0 of 143 stores are in that state and no\\n   157\\t   new-system store is served live today.\\n   158\\t\\n   159\\t## One next task\\n   160\\t\\n   161\\t**Where the lean path stands (2026-11-15; D489 to D542).** Alex is not active (D509); D439 is in force: choices go to the\\n   162\\tcouncil (an independent Codex review and Claude) until consensus, recorded citing D439; nothing is pushed, deployed, published or\\n   163\\tcommitted; paid calls stay within D439's $40 ceiling (about $18.42 recorded; $0.0134 sent in this period, the ten judge calls of\\n   164\\tD511 and D519; the lean path $8.34 in all). Every stretch below is closed; its full record is in the decision log and in\\n   165\\t`research/2026-11-14-use-acceptance/LEAN-LOG.md` (sections 1 to 43).\\n   310\\t**Where it stands (2026-11-16; D563 to D567; Alex not active, D439 in force; about $26.07 of D439's $40 spent):**\\n   311\\t- **The two-week product-condition run (D563, D564):** read in five ways; gate 1 (Alex's six lines) is not met there either (7 or\\n   312\\t  5 of 13 topics right); no last answer is unsupported by both reader families and 6 of 12 are contested, for too little\\n   313\\t  evidence to choose a band and for question forms, not for undelivered facts ([result](research/2026-11-14-use-acceptance/carried-run/RESULT.md),\\n   314\\t  [the six](research/2026-11-14-use-acceptance/contested-six/RESULT.md)).\\n   315\\t- **The judge naming a band where nothing sizes it (D519, D520):** closed for Alex with its record (D565, D566): the judge's own\\n   316\\t  account does not separate failed from passed answers; reader families agree only when no amount is the starting point. The\\n   317\\t  choice (leave the band, label it, show none) stays his ([self-report](research/2026-11-14-use-acceptance/self-report/RESULT.md),\\n   318\\t  [source check](research/2026-11-14-use-acceptance/self-report/SOURCE-CHECK-RESULT.md)).\\n   319\\t- **Integration (gate 5) moved twice:** the product's page reads the new system's store (D564); the new system's daily loop now\\n   320\\t  closes due questions with production's closing step, walks calendar days and owns its sequence (D567,\\n   321\\t  [design](research/2026-11-14-use-acceptance/carried-run/CLOSING-DESIGN.md)). A production defect found on the way is fixed: a\\n   322\\t  closing on a day without items was invisible at the next day's start (`src/hivemind/replay.py`, D566).\\n   323\\t- **Waiting on Alex (D560, unchanged):** his half hour on the pilot's cards\\n   324\\t  ([the deck](research/2026-11-14-use-acceptance/pilot-deck-1/deck-1.html); his marks tallied by `tally_deck.py` against the key in\\n   325\\t  `~/.hivemind-keys/pilot-deck-1/`), then the six lines' role, then D559's wider question.\\n   326\\t\\n   327\\t- **Gate 1's reading repeated (D568, D569):** the same 39 sends read again from identical packets give the same line verdicts; line 2's\\n   328\\t  failing sends are identical (reproduced by the method, not proved right). The parts a question does not judge (L) were shown nowhere.\\n   329\\t- **The product page now reads the new system (D570 to D573):** the page shows D397's \\\"Not judged\\\" parts beside the answer; it reads the\\n   330\\t  new system's events, theme ranges and unrecorded shapes without inventing a direction (neutral, named, no Idea composite); the API\\n   331\\t  serves a new-system store, closings included, and the page renders it ([result](research/2026-11-14-use-acceptance/page-contract/RESULT.md),\\n   332\\t  [serving](research/2026-11-14-use-acceptance/page-contract/SERVE-RESULT.md)). Listed for Alex, not changed: production's Yes/No colours\\n   333\\t  and its inferred theme scores state a direction the question may not hold.\\n   334\\t\\n   335\\t- **Serving while writing (D574):** no partial day leaks into the completed-day view; a freshly opened page now shows the served\\n   336\\t  library's latest completed day. The first day of a live store is open defect 10.\\n   337\\t\\n   338\\t- **Alex's page (D575, D576):** `docs/research/2026-11-14-use-acceptance/DECISION-PAGE-2026-11-16.md`, six choices in order, checked\\n   339\\t  against the records. The live-service design is paused (D575). Stage B's control line cannot be exercised by re-sending the judge (D576).\\n   340\\t\\n   341\\t- **The unlisted parts (D576, D577):** the request never ties \\\"the topic's wording\\\" to a field. 12 failing attempts on 7 matters leave\\n   342\\t  out a second figure, event or cap; 10 of them sit only in the topic's outcome. Arm A defines the wording in all four places. The\\n   343\\t  probe (18 stored requests, unchanged and changed ×3, about $0.15) was sent 2026-11-16 to `poc/data/clean-unlisted-probe-2026-11-16/`\\n6043:## D517 · 2026-11-15 · Under D439: the comparison is sized and not sent; the next step is a side-by-side of the two systems' output on the fresh week, then a bounded council decision (council consensus)\\n6083:## D519 · 2026-11-15 · Under D439: the side-by-side is left for Alex beside the decision page; the census of unsupported answers stands as corrected; four accounts are asked of the frozen judge, ceiling $0.10 (council consensus, reflection round 9)\\n6107:## D520 · 2026-11-15 · Under D439: the judge line stops at a note for Alex with nothing sent; the next step is a $0 trace of the old system's three agreed duplicate question pairs through their dated requests (council consensus, reflection rounds 10 and 11)\\n7198:## D565 · 2026-11-16 · Under D439: the six contested answers traced; D520's open choice turned into one bounded diagnostic of the frozen judge's self-report (council consensus, rounds 12 to 16)\\n7216:## D566 · 2026-11-16 · Under D439: the D520 line closed with its record for Alex; a production closing defect fixed; the new system's daily loop to close due questions as production does (council consensus, rounds 17 to 24)\\n7237:## D567 · 2026-11-16 · Under D439: the new system closes due questions as production does; the integration slice accepted (council consensus, rounds 25 and 26)\\n7256:## D568 · 2026-11-16 · Under D439: a repeatability check of gate 1's reading on the fortnight (council consensus, rounds 27 to 31)\\n7272:## D569 · 2026-11-16 · Under D439: gate 1's verdict reproduced by its method on the fortnight; D397's display of the parts not judged is missing from the product, the next work (council consensus on the course, round 32)\\n7289:## D570 · 2026-11-16 · Under D439: D397's display built and unit-proved, its browser proof pending; the product page refuses the new system's three-choice events; next, the page contract for the new system's answer shapes (council consensus, rounds 33 to 37)\\n7309:## D571 · 2026-11-16 · Under D439: the product page reads the new system's questions without inventing a direction, and shows D397's parts not judged (council consensus on the designs, rounds 38 to 40)\\n7326:## D572 · 2026-11-16 · Under D439: the two page slices accepted after their fixes and drawer checks; next, the actual serving path on a new-system store (council consensus, rounds 41 to 43)\\n7341:## D573 · 2026-11-16 · Under D439: the product's API serves a new-system store to the page; next, serving while a stored replay writes (council consensus, round 44)\\n7357:## D574 · 2026-11-16 · Under D439: a freshly opened page shows the served library's latest completed day; the first day of a live store is an open defect; next, the live-service design (council consensus, rounds 45 to 50)\\n     1\\t# The six contested last answers of the fortnight, traced (council round 12's request), 2026-11-16, $0\\n     2\\t\\n     3\\tMaterial: `last-<view>.txt` (each last request and answer), `OWN-TRACE.md` (Claude's read, written before any reader),\\n     4\\t`build_trace_packets.py` → `packet-trace-1|2.json` (the six and two controls, shuffled; candidates found by a text pattern per\\n     5\\tmatter, a hint written by Claude; key outside the repository), `brief-trace.md`, readers `codex|claude-trace-1|2.jsonl`,\\n     6\\t`tally_trace.py` → `tally-trace.txt`.\\n     7\\t\\n     8\\t## Answer\\n     9\\t\\n    10\\t**None of the candidates selected and read (kept statements the judges were not shown, found by a text pattern per matter) would\\n    11\\tmove any of the six answers, by either reader family, and both families caught both controls.** The six are contested for other reasons: too little in the request to choose between neighbouring answer\\n    12\\tchoices, and question forms that cannot express the likely outcome. These are counts among six answers selected because a reader\\n    13\\tdisputed them, not rates.\\n    14\\t\\n    15\\t## Controls\\n    16\\t\\n    17\\t- Positive (the July custom-chip answer, with the five facts that moved it 9 of 9 sends in PRD 10's test): both families say the\\n    18\\t  answer does not follow from what was shown, name the two Broadcom revenue figures as moving the answer and the group, taken\\n    19\\t  together, as moving it.\\n    20\\t- Negative (the supply-commitments answer, uncontested; its one candidate repeats the $279bn already shown): both families say it\\n    21\\t  follows, with no candidate and no cause.\\n    22\\t\\n    23\\t## The six (question = the system's id)\\n    24\\t\\n    25\\t| Question | Follows (Codex / Claude) | Form (C / Cl) | Too little to choose (C / Cl) | Candidates, together | Mine (OWN-TRACE) |\\n    26\\t|---|---|---|---|---|---|\\n    27\\t| v1 credit support total | yes / yes | no / no | no / no | confidence / neither | form (undefined \\\"amount\\\"), reader threshold |\\n    28\\t| v5 capex 2026 | cannot tell / yes | yes / no | yes / no | none / neither | arithmetic, no effect on the band |\\n    29\\t| v10 U.S. gigawatts 2026 | cannot tell / cannot tell | yes / yes | yes / yes | confidence / neither | too little; nothing sizes it |\\n    30\\t| v11 DRAM contract prices | cannot tell / yes | yes / no | yes / no | confidence / confidence | the feed never carries the series |\\n    31\\t| v12 residual-value guarantee | yes / yes | yes / yes | yes / no | confidence / confidence | filed elsewhere, never reconsidered; confidence |\\n    32\\t| v13 CPO units 2027 | cannot tell / yes | yes / yes | yes / yes | confidence / confidence | the event shape decides it; data never published |\\n    33\\t\\n    34\\t- **Missing facts:** none named as moving an answer. The residual-value precedent (NVIDIA already gave one for the SB Energy\\n    35\\t  project, filed under another question before this one opened) is named as firming the chosen \\\"Yes\\\" by both families.\\n    36\\t- **Form, by both families:** v10 (how grid, facility and computing capacity are counted is not defined), v12 (the answer\\n    37\\t  choices assume one platform-wide guarantee while support is per deal, and drop the amount the focus names), v13 (a threshold\\n    38\\t  figure written as an event: \\\"not reached and not abandoned\\\" shows as Still open; Nvidia publishes no unit counts).\\n    39\\t- **Too little to choose, by both families:** v10 and v13. Codex also on v5, v11 and v12; the Claude family reads the shown\\n    40\\t  evidence as enough there (for v11: Micron revenue up 379% and memory-driven price rises of 50 to 75%).\\n    41\\t- Where I differ from the readers: I put v11 down to qualitative evidence only; one family reads the shown figures as sizing it.\\n    42\\t\\n    43\\t## What it shows and does not\\n    44\\t\\n    45\\t- Shows: in this fortnight, the contested final answers are not explained by the candidates selected and read; they\\n    46\\t  sit where the record already put the largest class of unsupported answers (D519: an amount asked with too little to size it)\\n    47\\t  and where D559 put the core problem (forming answerable questions).\\n    48\\t- Does not show: that no fact outside the kept statements (or outside the text patterns) would move them; that the readers would\\n    49\\t  find every candidate (the control shows they can find one known group); that Nvidia publishes no CPO unit counts (contested in\\n    50\\t  Stage A); that v1's reading of a cap as the amount is right (an earlier reader rejected it); that the judge would\\n    51\\t  not move if given a candidate (a prediction until a send); any rate.\\n     1\\t# The product's API serving a new-system store to the page (D572), 2026-11-16, $0\\n     2\\t\\n     3\\tStore: a copy of the closing replay's store (the extension draw judged through the accepted loop to 2027-04-02, D567; source path in\\n     4\\tthe scratch run's `source-closing.txt`), 7 questions. The API (`scripts/hivemind_api.py --lexical --config ''`, no model or\\n     5\\tembedding call) on a free local port; stopped afterwards. Saved output: `serve-check.txt`.\\n     6\\t\\n     7\\t- `/days`: 2026-09-22 to 2027-04-02.\\n     8\\t- `/library` at 2026-09-28, 2027-01-30, 2027-01-31 and 2027-04-02 equals `bundle.library` read directly from the store (4 of 4).\\n     9\\t- v3, v4 and v7 are open on 2027-01-30 and closed on 2027-01-31, their due day; v6 (due 2028-03-24) is open on 2027-04-02;\\n    10\\t  `/thesis-bundles` carries v7 as an event and v5 as a figure with `n/a`. Cross-origin headers present.\\n    11\\t- **The page reading the API:** a page built with the fortnight's 12 questions embedded, pointed at the API by `data-api`, rendered\\n    12\\t  in headless Chrome, replaced them with the API's 7: the four events titled \\\"Current outcome\\\" with neutral chips (Yes, Still open),\\n    13\\t  the theme range \\\"Current range\\\" with a neutral range chip, the two company figures \\\"AI score\\\" with \\\"−2 Strongly bearish\\\" (negative).\\n    14\\t- Observed on the way (existing behaviour, not a defect of this slice): when the live library replaces the embedded one, the page\\n    15\\t  keeps its date if the new history contains it, else moves it to the nearest end; a page shell embedding production's ledger (last\\n    16\\t  day 2026-08-28) therefore opened the new library at 2026-09-22, where 2 questions exist. A failed live read is silent (the embedded\\n    17\\t  snapshot stays), so a check must embed a different dataset to show the live read happened, as this one did.\\n    18\\t\\n    19\\t**Not covered:** the Idea planner on a new-system ledger (open); a person's view of the page; a long-running service.\\n     1\\tjuly c1/clean-1\\n     2\\t  D: How much credit support or guarantee exposure will NVIDIA have signed for AI cloud partners under its new revenue-sharing and credit-support model by 2027-12-31?\\n     3\\t  O: The amount of signed credit-support, guarantee, or similar credit-enhancement commitments NVIDIA discloses for AI cloud partners under the new model.\\n     4\\tjuly c1/clean-2\\n     5\\t  D: How much equity will NVIDIA hold in Intel, and at what total committed amount, at NVIDIA's next annual report, following its $5 billion equity investment in Intel?\\n     6\\t  O: The size and carrying amount of NVIDIA's equity stake in Intel, and any additional commitment, disclosed at NVIDIA's next annual report.\\n     7\\tjuly c1/clean-3\\n     8\\t  D: Will NVIDIA's Vera Rubin AI chip platform begin shipping by the end of calendar 2026?\\n     9\\t  O: First shipments of Vera Rubin to customers, confirmed by NVIDIA.\\n    10\\tjuly c1/clean-4\\n    11\\t  D: Will China's government permit NVIDIA to sell its H200 AI chips to Chinese customers, lifting its current block, by NVIDIA's fiscal year-end 2027-01-31?\\n    12\\t  O: A Chinese government/regulator decision allowing H200 sales in China, evidenced by an official Chinese decision or by NVIDIA-confirmed H200 shipments/revenue to Chinese customers.\\n    13\\tjuly c1/clean-5\\n    14\\t  D: Will the U.S. Commerce Department conclude its investigation into whether DeepSeek accessed restricted Nvidia AI chips and announce penalties or new export-control measures by NVIDIA's fiscal year-end 2027-01-31?\\n    15\\t  O: A U.S. Commerce Department/Bureau of Industry and Security finding, penalty, or new export-control measure stemming from the investigation into DeepSeek's access to restricted Nvidia chips.\\n    16\\tjuly c1/clean-6\\n    17\\t  D: How much will the big four AI hyperscalers spend in combined data center capital expenditures in calendar 2026?\\n    18\\t  O: The sum of calendar-2026 data center capex actually reported by the big four AI hyperscalers, versus the roughly $650 billion they are reported to plan for this year.\\n    19\\tjuly c1/clean-7\\n    20\\t  D: Will NVIDIA's Vera Rubin Ultra / Kyber NVL144 rack-scale system begin shipping to customers by the end of calendar 2028, following SemiAnalysis's report that its debut slipped from 2027 to 2028 (which NVIDIA disputes, saying its roadmap is intact)?\\n    21\\t  O: First customer shipments of the Kyber rack-scale architecture (NVL144) with Vera Rubin Ultra, confirmed by NVIDIA.\\n    22\\tjuly c1/clean-8\\n    23\\t  D: How much will the big four AI hyperscalers spend in combined data center capital expenditures in calendar 2027, versus NVIDIA management's forecast that hyperscaler spending will top $1 trillion?\\n    24\\t  O: The sum of calendar-2027 data center capex actually reported by the big four AI hyperscalers, compared with the over-$1-trillion figure NVIDIA management forecast for 2027.\\n    25\\tjuly c1/clean-9\\n    26\\t  D: How much will NVIDIA have outstanding in supply/purchase commitments at its next annual report?\\n    27\\t  O: The dollar amount of NVIDIA's supply commitments (purchase and capacity commitments) disclosed in its FY2027 Form 10-K, versus the $119 billion cited in this item.\\n    28\\tjuly c1/clean-10\\n    29\\t  D: What share of Chinese companies' AI accelerator spending will go to domestic suppliers over the 12 months following July 2026, versus the 46% planned in the Bloomberg Intelligence survey?\\n    30\\t  O: The realized share of Chinese enterprises' AI accelerator budget captured by domestic suppliers (Huawei, Hygon, Cambricon and others) over the 12 months from mid-2026, measured against the 46% planned and the 30% current level.\\n    31\\tjuly c1/clean-11\\n    32\\t  D: How much will NVIDIA have invested in Firmus Technologies, and what equity stake will it hold, following its reported ~$500 million ($721 million) subscription to Firmus' $2.9 billion equity raising, once Firmus lists on the ASX?\\n    33\\t  O: The amount NVIDIA invests and the equity stake it holds in Firmus Technologies after its preference shares convert to ordinary equity at Firmus' ASX IPO.\\n    34\\tjuly c1/clean-12\\n    35\\t  D: What will the spot rental price of an hour of Nvidia H100 GPU compute average over calendar 2026, after peaking around $3.20/hour in May 2026 and then declining?\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n./docs/research/2026-11-14-use-acceptance/reflection-4/codex-measurement.jsonl:15:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_5\",\"type\":\"command_execution\",\"command\":\"/opt/homebrew/bin/zsh -lc 'cat clean-arch/PRD.md docs/prd/10-filing-phase.md docs/CURRENT_STATE.md'\",\"aggregated_output\":\"# Hivemind architecture: the hedge fund research brain\\n\\n**Status: working draft.** This document defines the architecture being developed from Alex's diagram and the discussion around it. It is a design, not a claim that the system has been built or that its quality has been proven. Decided parts: Step 1 runs the adopted request c8 (section 12; D387, D391); Step 2 and Step 3's grouping library are frozen (section 5; D427). Step 4 has not passed. Nothing here is joined to production storage; the clean path goes to production as a whole, after Step 4 meets its lines.\\n\\n## 1. What the system does\\n\\nHivemind is building a hedge fund brain: a system that follows the decision process of an investment analyst. It receives source material, identifies information and ideas that may matter to assets or events in the world, connects that information to the research being followed, and maintains a dossier of the evidence and events behind each thesis.\\n\\nA thesis is a research idea, issue or question the system is tracking. Evidence is information that can inform it. A judgement is an assessment of what the accumulated evidence means for the thesis. The thesis, its evidence and its judgement are different things. The agreed minimum for a new thesis is its entity, research question, outcome to track and period when known; further details remain open.\\n\\nFor example, the thesis could be **“How much will a company's capital spending grow this year?”** An article reporting a 25% forecast is evidence. The judgement is what that and the other evidence imply for the answer.\\n\\nThe dossier should preserve how the research develops: the events and statements that inform a thesis, where they came from, how they relate to earlier information and what they imply for an asset or a broader event. The system must keep those connections clear enough that a reader can understand why a judgement exists.\\n\\n## 2. Architecture at a glance\\n\\n```mermaid\\nflowchart TD\\n    H[Hummingbird: incoming item] -->|Lookup using available tags| T[(Thesis library)]\\n    H --> X[Step 1: Luna extraction]\\n    T[(Thesis library)] -->|Open thesis descriptions| X\\n    X --> N[Propose new thesis and evidence]\\n    X --> O[Propose evidence for existing thesis]\\n    X --> P[Proposed theses and evidence links]\\n    P -->|Thesis and incoming evidence| S[Semantic search: top N]\\n    D[(Evidence library)] --> S\\n    S --> C[Step 2: compare evidence with Jev]\\n    P --> C\\n    C --> B[Repeat of a statement]\\n    C --> U[Revision of a statement]\\n    C --> K[New evidence]\\n    C --> W[Step 3: save records and links]\\n    W --> T\\n    W --> D\\n    W --> J[Step 4: judge affected theses]\\n    X -. evaluation only .-> V[Evaluate Step 1]\\n    G[(Run traces and state)] -. review material .-> V\\n    V -.-> R[Review findings]\\n```\\n\\nThe live path processes an incoming item through extraction, comparison and saving. Judgement uses the saved evidence downstream; its trigger and timing are open. Evaluation is a separate test of extraction. The thesis library and evidence library are logical stores in this picture; the physical database design is open. The image Alex supplied is available as the [original diagram](reference-diagram.png); the text below explains each box and arrow.\\n\\n| Part of the diagram | What it receives | What it produces |\\n|---|---|---|\\n| Hummingbird stream | Incoming material from its event pipeline. | An item and its available source information. |\\n| Thesis lookup | The relevant company tags for the item. | All open thesis descriptions in scope for those tags. |\\n| Step 1: Luna | The item, relevant company tags and open thesis descriptions. | Existing or proposed new theses, each associated with evidence from the item. |\\n| Step 1 evaluation | Source articles, model inputs and outputs, and thesis state before and after each article. | Human review findings about extraction, thesis reuse and state changes; this is separate from the live path. |\\n| Semantic search | A thesis and incoming evidence. | Up to N related evidence records from the evidence library. |\\n| Step 2: Jev | Incoming evidence and the returned evidence candidates. | An evidence relationship: repeat, revision or new. |\\n| Step 3 | The Step 1 proposals and Step 2 results. | Saved theses, evidence, sources and relationships. |\\n| Step 4 | The affected thesis and its saved evidence. | A thesis judgement; the detailed contract remains open. |\\n\\n## 3. The information the system works with\\n\\n| Information | What it is for |\\n|---|---|\\n| Incoming item | The article or other material Hummingbird supplies for processing, with its available source information. |\\n| Thesis | A research idea, issue or question about an asset or event that is either already open or proposed as new. |\\n| Evidence | A statement, number, event or view from the item that is relevant to a thesis. |\\n| Evidence source | The material and relevant passage or location behind the evidence, with speaker and date when known. |\\n| Evidence relationship | A connection showing that evidence repeats or revises an earlier statement. |\\n| Judgement | An assessment of what the available evidence implies for a thesis. |\\n| Run trace | The source item, the thesis context shown to the model, its output and the resulting thesis state, available for review. |\\n\\nA thesis can have many pieces of evidence. An article can contain evidence for more than one thesis, propose a new thesis, do both, or produce neither. The draft response represents one statement once and links it to each relevant thesis; its mapping to persisted records remains to be verified.\\n\\n## 4. Step 1: extract theses and evidence\\n\\n### Input\\n\\nHummingbird supplies an item. Step 1 receives the item, all relevant company tags and all open thesis identities and descriptions in scope for those tags, with each tracked outcome and period when available. These descriptions give the model the context needed to identify existing research. For the current single-entity flow, this means the complete open thesis list for the entity being processed.\\n\\nThe model does not need the full history of evidence for every thesis in this step. This input assumes that the relevant tags are available; how to discover affected companies across entities is separate future work (section 16).\\n\\n### What the model decides\\n\\nThe model reads the item and proposes linked theses and evidence:\\n\\n1. **Existing thesis:** identify an open thesis that the item informs and propose the relevant new evidence for it.\\n2. **New thesis:** identify an important research idea, issue or question not already covered by the supplied open thesis list and propose it together with the article evidence that supports it.\\n\\nThese are two possible results from the same reading, not two required calls. Every proposed evidence statement is paired with an existing or proposed new thesis, and a new thesis is proposed with evidence. An existing thesis retains its identity; finding evidence for it does not require renaming it. The Step 1 prompt should define duplicate theses clearly so the model can use an existing thesis when the idea is already covered; the precise definition still needs to be worked out and evaluated.\\n\\nStep 1 proposes records. Saving them happens in Step 3. The direction discussed for this architecture is that Step 1 decides whether a thesis is new; there is no separate thesis-routing stage in the proposed flow. Whether the model makes that distinction reliably enough must be evaluated. A concrete working draft of the Luna request appears in [section 12](#12-step-1-prompt-luna-working-draft).\\n\\n### Output\\n\\nConceptually, the output is a collection of `{thesis, evidence}` associations:\\n\\n- The thesis is either a reference to an existing open thesis or a proposed new thesis. A new thesis states the research question and the outcome to track, with a period when known. For the current single-entity flow, code assigns the supplied entity.\\n- The evidence contains the relevant statement and enough source information to find and interpret it.\\n- One thesis may have multiple evidence statements.\\n\\nSection 12 shows a proposed JSON response shape: one list of new theses and one list of evidence, with links from each evidence item to the existing or new theses it informs. Local references connect records in one response; application code assigns persistent identities. The runtime schema has not been finalized or enforced. Preserve the meaning of the source and distinguish what the source says from what is inferred. Do not invent a speaker, date or figure absent from the item.\\n\\n| What Step 1 finds | Proposed handoff |\\n|---|---|\\n| Evidence for an existing thesis | Existing thesis reference plus one or more evidence statements and their sources. |\\n| A new thesis | Proposed thesis plus the article evidence supporting it. |\\n| Both | Both kinds of association in the same item output. |\\n| Neither | An empty result for the item. |\\n\\nThe item itself is the source of the new evidence. The open thesis descriptions provide context for deciding where it belongs. The historical evidence search happens later.\\n\\n### Step 1 contract and the existing ledger\\n\\nStep 1's research result is a collection of thesis–evidence pairs. The structured-output example in section 12 is a **proposed model response**, not the existing production response or a final database write contract. A pair can refer to an existing thesis or propose a new one; each pair has one or more source-backed evidence items. One statement can inform more than one thesis.\\n\\nThe first forward run can advance a separate, isolated test thesis library using those proposals. It can review Luna's output and the evolving thesis state without creating production-compatible judgement records. This test library must not be presented as proof that the existing ledger writer or Step 4 can consume the result.\\n\\nOn 2026-11-06, Alex agreed that a new thesis should carry the entity, research question and outcome being tracked, with a period when known. For this single-entity flow, code supplies the entity from the input; Luna supplies the question, outcome and known period. The proposed `period` field is null when the period is unknown. Whether Step 4 needs predefined outcome ranges is a separate open decision; this minimum is not sufficient to claim compatibility with the current production writer.\\n\\nAlex clarified that a meaningful topic may be opened without a known decision date when later observable developments can help assess it. It must be specific enough to guide what to watch and matter to the research; vague or noisy topics should not be opened. This clean-design decision does not alter the historical signed standard or its frozen ruler.\\n\\nFor reuse of the existing ledger, the new handoff must preserve the fields actually needed by its writer and readers. Section 18 maps the current draft to those fields and separates straightforward mappings, values the system can supply, and unresolved research decisions. The new path must not manufacture evidence tiers, thesis dates or outcome ranges to make an old contract pass. If the user chooses different thesis or judgement semantics, their effect on the writer and readers must be designed and tested explicitly.\\n\\n### Example\\n\\nThe open list contains **“How much will Company A's capital spending grow this year?”** The item says Company A raised its forecast to 25% and also announces a new manufacturing partnership that could matter for future supply.\\n\\nStep 1 could return:\\n\\n- **Existing thesis:** capital-spending growth → **evidence:** the new 25% forecast.\\n- **Proposed new thesis:** the manufacturing partnership's future supply impact → **evidence:** the partnership announcement.\\n\\nThese examples illustrate the flow; they do not define a fixed list of what is important or establish that a particular item merits a new thesis. The model has to judge relevance in context.\\n\\n## 5. Step 2: find and compare related evidence\\n\\n### Why this is separate\\n\\nAn open thesis may accumulate many evidence records. Step 1 needs to understand the article and the open research; it does not need to read every prior statement to do that. Step 2 uses each proposed `{thesis, evidence}` association to find the history worth comparing.\\n\\n### Find candidate evidence\\n\\nThe proposed design places semantic search over the evidence library. It uses the thesis and incoming evidence to find top-N related evidence across the current entity, including evidence linked to other theses. The thesis is search context, not a restriction to evidence already linked to that thesis. This also applies when the proposed thesis is new. For example, “raised its revenue outlook” and “expects higher sales” can be related despite different wording. Alex chose this entity-wide scope on 2026-11-06.\\n\\nSearch returns **candidates**, not a final decision. As built and frozen (`step2/compare.py`; D381, D427): one query per association (the thesis question, then the incoming summary and passages), plus one query of the record's own text when it has no association or lists the company's figures; each query ranks the original record of every stored group by cosine similarity of `text-embedding-3-small` embeddings and keeps the top 10; the union is compared. Figures never enter a search or comparison text. Measured: the earlier version of a repeat was among the candidates for 112 of 113 known pairs in the first forward run and 141 of 143 at the acceptance on fresh articles (D386). Speed and cost under production load are not measured.\\n\\nA match outside the returned set will not be considered by the comparison. Search quality therefore matters independently from the model's ability to compare the records it receives.\\n\\n### Compare with Jev\\n\\n**As built and frozen (2026-11-08, accepted D381, frozen D427; [round log](step1-unfiled-2026-11-08/LOG.md) §§24, 31–35):**\\n- Comparison reads the full passages; the 600-character cut is removed.\\n- An unlinked record also searches by its own text.\\n- `figures` never enter a search or comparison text.\\n- Jev is asked the clean path's own piece question, aligned with line 2's test: a repeat reports the stored piece's main statement, and\\n  an official's denial of a report is a revision.\\n- When a thesis opens, every stored unlinked group from earlier articles is judged against it in batches of ten (a yes/no question; the\\n  company's overall results inform only a revenue or earnings thesis). Each judged pair is recorded once.\\n- On c6's records: search 97.9%, wrong merges 1.9% (2 of 104), both lines met; line 3 not re-measured. At the acceptance on 50 fresh\\n  articles (D386, one draw): search 141 of 143, clear wrong merges 1 of 57 plus 2 overlaps.\\n- Known weakness, recorded and not tuned (D423): \\\"later version\\\" relations. In one saved end-to-end draw, two source readers found 9\\n  of 30 such relations join two different statements, most of them NVIDIA's answer to a report linked to a neighbouring statement of\\n  the same story; a wording change failed its line (Step 2 log §14).\\n\\nJev compares the new evidence with the returned evidence. The intended outcomes are:\\n\\n| Outcome | Meaning | Example |\\n|---|---|---|\\n| Repeat | The new material presents the same statement again. | Another article reports the same company forecast. |\\n| Revision | A later account changes the same statement. | The company revises its forecast from 12% to 25%. |\\n| New evidence | It is not identified as a repeat or revision of the evidence compared. | A different analyst offers a separate forecast. |\\n\\nThe words, amount, speaker, source and time can matter to the comparison. A later statement about the same subject is not necessarily a revision. A matching amount alone does not prove that two statements are the same.\\n\\nThe result “new evidence” is the outcome of the comparison performed; it is not proof that no matching evidence exists elsewhere in the library. When the incoming evidence is judged a repeat of several candidates, it joins only the group Jev judges it most like: the highest same-statement probability, with ties going to the earliest group (Alex, 2026-11-08). A comparison that fails is not saved and is reported.\\n\\n**Repeat handoff:** when Jev identifies a repeat, the comparison must retain the identity of the existing evidence record it was compared against. Step 3 uses that identity to place the incoming record in the existing record's group, adding its source and any missing thesis link. The typed Jev response need not generate the record ID: the caller can associate the choice with the candidate it supplied. The rule for several matching candidates is stated above.\\n\\n**Step 2 acceptance (Alex, 2026-11-08).** Three lines apply:\\n1. For incoming evidence whose earlier version is in the library, search returns it at least 90% of the time.\\n2. At most 2% of merges are clearly wrong.\\n3. Grouped dossiers keep no fewer details added by later reports than no merging does.\\n\\nThe first measurement against these lines is in the [Step 2 log](step2-validation-2026-11-07/LOG.md) §12; the isolated modules are `step2/compare.py` and `step3/library.py`.\\n\\n**Frozen (D427, Alex, 2026-11-11: \\\"好jev 收尾冻结\\\").** Step 2 and Step 3's grouping library stay as accepted and measured (Step 2 log §§12–18); `tests/test_frozen_clean_step2.py` fails the suite when one of their files moves. They go to production only with the whole clean path, after Step 4 meets its lines, through an end-to-end comparison against production on the frozen ruler (three draws each), with these three lines checked on that run. A change is a new version that only Alex opens. Five open defects are carried with the freeze (Step 2 log §17).\\n\\nThe diagram's intended sequence is: use `{thesis, incoming evidence}` to search the evidence library; pass the returned candidates and incoming evidence to Jev; pass the comparison result and the proposed association to Step 3. For a new thesis, search the same entity-wide evidence library. The frozen Jev request appears in [section 13](#13-step-2-prompt-jev-request-frozen).\\n\\n## 6. Step 3: save evidence and links\\n\\nStep 3 takes the proposals from Step 1 and the comparison outcomes from Step 2 and writes the resulting research information.\\n\\n| Result | What is saved |\\n|---|---|\\n| New thesis with supporting evidence | The new thesis and its evidence link; save new evidence or reuse a matching record according to Step 2. |\\n| New evidence for an existing thesis | The evidence and its link to the thesis. |\\n| Repeat | Place the incoming record in the existing evidence record's group: add its source and any missing link to the relevant thesis, and keep the incoming record's own text and fields inside the group. Do not rewrite the existing record, and do not create a separate evidence record for the same statement. |\\n| Revision | The new evidence and its source, linked to the earlier statement as a revision. In the judge's ledger the new record also takes the earlier record's thesis links (D202's rule, kept on the clean path by D424; written by the D392 adapter until Step 3 is joined to production storage). |\\n\\nA revision does not erase the earlier statement. On 2026-11-06, Alex chose to keep one evidence record for a repeat and add the new source and any missing thesis link. On 2026-11-08 the Step 2 validation showed that keeping only the earlier text discards details a later report adds, such as a guidance condition; Alex then chose to keep each repeat's own text and source inside the stored record's group, without rewriting the original (\\\"A 继续；跑council loop 开始做\\\"; [Step 2 log](step2-validation-2026-11-07/LOG.md) §7). In the judge's ledger each member of a group is its own evidence record, related to the original as the same claim (D204), and the judge reads each copy with that note; a second or later copy of a statement already in the same request is 31% to 34% of what the judge is shown in the saved clean draws (26% to 31% in production's), and how a judgement weighs copies is not tested further (Step 2 log §17). Multiple articles reporting the same statement do not automatically establish independent original sources. The current production writer stores separate repeat records, so this is a change for the clean path and needs implementation and verification; the existing historical records remain available. Step 3 ends when the chosen thesis, evidence and relationships are saved. How they are physically stored and written is a separate implementation decision.\\n\\n## 7. Step 4: judge the thesis\\n\\nJudgement is separate from processing and saving an article. It assesses what the evidence implies for an affected thesis and whether the thesis's current assessment should change.\\n\\nFor the capital-spending example, saving the revised forecast records **what the company said**. Judgement later considers **what that means for the investment question**. The saved evidence and its relationships must be available to that work.\\n\\nThis discussion has not yet defined the judgement's input selection, output, timing or decision method. Those are open design questions, not implicit requirements of the earlier steps.\\n\\n**2026-11-12 (built; the ladder step measured four times and frozen without passing its lines, D426; Stage B built, D429):** originally written 2026-11-10 (D396–D398): the [Step 4 design](step4-2026-11-10/DESIGN.md) proposes a ladder step, which writes one judged question, its answer ladder and its due day when a thesis opens, followed by production's frozen judge. Alex decided two of its rules: a topic that asks more than one thing gets one judged question, the other parts shown as not judged (D397); the ladder step carries D186, with ranges against the reference and the favourable end registered (D398). The build waits for his word.\\n\\n## 8. Evaluate Step 1\\n\\nStep 1 evaluation is an offline forward run followed by a source-by-source review of the trace and the changing thesis state. Alex's direction is to inspect what the system actually does instead of first constructing a hypothetical golden library of thesis–evidence pairs. This does not change the existing frozen references used by historical measurements.\\n\\nThe evaluation should allow us to answer:\\n\\n- Did the model identify the research ideas an analyst would follow, without proposing already tracked research as new?\\n- Did it find the relevant evidence in the article, and did it include information that should not have been kept?\\n- Did it preserve what the source says, including the speaker and date when available?\\n- Did it connect evidence to the right thesis, given the open theses it was shown?\\n\\nReview the complete article beside the exact thesis context and the model's raw output. Inspect evidence the model missed as well as what it kept. After each item, inspect what was added to the thesis library and whether a duplicate or incorrect link affects later articles. Alex agreed to review the first run's traces and resulting state before deciding what quality is sufficient to proceed. The articles and review coverage remain to be selected; a trace review does not by itself establish system-wide accuracy.\\n\\n### Forward run and state review\\n\\nRun selected articles in a fixed order against a known initial library. Capture, for each article, the source text, the exact open-thesis context, the raw Step 1 output, and the resulting library state. The next article sees the state actually produced by the preceding article. Review the trace and state against the source to identify misses, incorrect evidence or links, and duplicate theses. Document mistakes and their downstream effects rather than silently correcting the run's history.\\n\\nThis can begin with Step 1 and a test library; it does not require completing Jev or the full production pipeline. A separate golden library or validation split is not required by this proposed approach. A selected three-article forward run used the earlier single-passage schema; the partial July 8–9 run below uses the revised multi-passage schema. Broader review coverage remains open.\\n\\n### Current Step 1 forward run\\n\\nThe [current article replay](../poc/data/clean-step1-2026-07-08-09-continuing/review.html) completed all 49 selected source items from an empty isolated library. It contains 22 thesis records and 160 evidence items; two proposed source passages could not be matched and remain visible as unverified. These are counts from one exploratory run, not a quality score. Unmatched passages and unresolved links are kept for review; affected and subsequent state is provisional. After a stop on article 21, the run continued in a new trace from article 20's recorded state. The [first attempt at article 21](../poc/data/clean-step1-2026-07-08-09-continuing/first-attempt.html#article-21) remains available; the current replay shows the completed prefix and new attempt in order. The source collection has known related-article contamination, and its fixed processing order is not necessarily publication-time order. [Run decisions and learning](STEP1-RUN-LOG.md) record blockers, investigation, changes and their checks.\\n\\nThe [49-article trace review](step1-trace-review.html) explains the source-backed findings and includes an article-by-article assessment. Its [Markdown source](STEP1-TRACE-REVIEW.md) is rendered with `node clean-arch/render_trace_review.mjs`; check synchronization with the same command plus `--check`. This review is not a frozen-ruler acceptance result.\\n\\n### Prepared-source Step 1 replay\\n\\nThe [seven-article prepared-source replay](../poc/data/clean-step1-prepared-2026-11-06/review.html) uses a separate experimental source database assembled from recorded source-role answers and the original page lines. It ran the existing clean Step 1 prompt in the earlier selected order, starting from an empty isolated library. The viewer shows the selected article, earlier cleaned text, full archived page, source-role decisions, provider response, and before/after thesis state. The recorded source selection is not an integrated live source-preparation service, and neither the selected order nor the underlying captured page is asserted to be complete or chronologically authoritative. This historical replay's `cleaning` metadata describes the earlier cleaned text, not the model-selected text; that field was not included in the model request. New materializations retain the earlier cleaning metadata separately and identify the selected-source preparation.\\n\\nThe seven calls completed, producing four new thesis proposals and 21 evidence items with 33 source passages. Every passage was located contiguously in both the selected text and the archived page, but that **does not prove it supports the whole summary**. Independent readers found that Firmus evidence-1 omits the preceding passage supporting the US$2 billion fundraising amount in its summary; FEV ev-2 omits the passage supporting the limited/no-internet condition. Several other quotations need preceding context to identify the named party. These are visible in the replay. The model's later review identified the Firmus omission and missing FEV party context but did not identify the missing internet condition; those leading follow-ups do not prove why the original answers missed the passages. A controlled comparison completed on the same seven source inputs and before-states, testing the location of the existing final check and a general citation-support clarification. Independent readers assessed anonymous answers before the settings were revealed. In three draws per arrangement, moving the check or adding the clarification reduced this particular Firmus citation miss, but some changed arrangements omitted a named SambaNova customer/deployment or weakened the FEV connectivity condition. Seven Firmus answers also added a currency to a $15.5bn valuation whose currency was not explicit in the source. Neither prompt change is adopted; the [blind review](../poc/data/clean-step1-prepared-2026-11-06/citation-placement-comparison/BLIND-REVIEW.md) records all four arrangements and limitations. The cases were already known and cannot establish production accuracy.\\n\\nThe prepared input restored the article 1 CFO outlook line, which Luna included in E3; it excluded the unrelated October recommendations from the Firmus input while retaining the reported investment. It also restored the article 4 SambaNova funding paragraph, which the model did not extract; whether it matters to NVIDIA's competitive research is a separate judgment. The FEV source is a hosted page with an FEV-issued release; the output does not fully preserve that issuer-versus-host distinction. The FEV and Firmus displayed local dates and stored New York dates are consistent with their timezone-aware timestamps; listing timestamps are separate values. The SambaNova page, however, gives 20:19 UTC in machine-readable metadata and 21:19 UTC in its visible byline. Both are the same New York day, but its exact publication time is unresolved.\\n\\nThis replay uses recorded source-role answers rather than calling the source selector live. The selected source and citations remain provisional; exact source location cannot guarantee complete citation support, correct attribution, or relevance. No production database or frozen prompt was changed.\\n\\n### Citation-completion diagnostic\\n\\nA separate model-assisted review was tested on nine saved, known source-and-evidence packets, with three calls per packet and two independent readers. All three Firmus reviews found the missing US$2 billion fundraising passage, but all three FEV reviews missed the source passage for limited or unavailable internet. All three also missed a different FEV record’s reversed local-versus-cloud backup relationship; only two of three identified an unsupported US-dollar currency on the Firmus valuation. Six of 69 expected evidence reviews were left unaddressed because returned identifiers did not match the evidence identifiers. These are selected examples, not a quality rate. [The detailed review](../poc/data/clean-step1-prepared-2026-11-06/citation-completion-probe/BLIND-REVIEW.md) keeps the source-backed examples and limitations.\\n\\n**Status:** This extra review is an experiment and is not part of the runtime. Additional passages can support a missing citation, but cannot repair a wrong summary or link. A located quotation does not establish that every claim in its evidence is correct. The recorded source-preparation and contiguous-page quotation checks are separate improvements; they do not decide whether a claim matters or is semantically supported.\\n\\n### Page-time-order Step 1 replay\\n\\nThe [page-time-order replay](../poc/data/clean-step1-page-time-2026-11-06/review.html) runs the same seven prepared source texts in the order of the archived pages' timezone-aware publication metadata, starting from an empty isolated library. It produced three new theses, 17 evidence items and 30 located source passages. The earlier selected-order replay produced four new theses and 21 evidence items. These are two single exploratory draws with different preceding states, not a controlled model-quality comparison. Page publication time is not proof of event time or pipeline arrival order; the SambaNova page's visible and machine-readable times disagree by an hour, although both give it the same position in this selected subset. [Recorded ordering evidence](../poc/data/clean-step1-page-time-2026-11-06/page-time-order.json) keeps the original timestamps.\\n\\nThe Parasail/d-Matrix release appeared first and opened a heterogeneous-inference question; the later d-Matrix report reused that question rather than opening a duplicate. The same run still has material errors: the SambaNova benchmark is described as a deployment although its cited text establishes a test; a named planned customer/deployment present in the source was omitted; and the FEV link explanation reverses which system is the backup, even though its summary states the direction correctly. The FEV summary also omits the source's explicit no-internet case and treats an example model as if it were a definite selection. Firmus cites both investment paragraphs in this draw but assigns a currency to the $15.5bn valuation that the source does not explicitly specify. These findings are annotated in the replay. In a later leading self-review, Luna identified the omitted planned customer but did not identify the reversed FEV backup direction; this does not prove why the original answer failed. Exact source location does not establish a correct link, complete summary or correct attribution.\\n\\n### Step 1 source-faithfulness council\\n\\nCodex and Claude Code reviewed the current source, prompt, code and saved answers, then challenged each other over four rounds. Their [detailed council record](STEP1-COUNCIL-REVIEW.md) links to each exchange and distinguishes observed errors from unproven causes. Claude could see earlier experiment reviews during its first pass, so this was not a blind independent assessment.\\n\\nThe shared conclusion is that no tested semantic fix is ready. One evidence item can simultaneously have an incomplete citation, an altered claim, a questionable attribution or an incorrect thesis explanation. Exact source location alone cannot verify these. The tested follow-up review found Firmus's missing financing paragraph in three draws, but missed FEV's missing connectivity condition and a reversed backup relationship in all three; it is not adopted. A quote-first output or stronger reasoning setting may be worth testing later, but neither is proven and either could change or omit useful evidence.\\n\\nThe agreed next investigation is a source-backed review of the 49-item historical forward run and its 160 returned evidence records, with separate, overlapping flags and a separate article-level review for omitted facts. Preserve source contamination and incompleteness as distinct findings, and adjudicate difficult cases with another reader. Then compare the two seven-item replays separately: all seven source IDs are already in the 49-item manifest, and their inputs and order differ. Before the full review, check the review method against known problems and independently checked ordinary records. This is an investigation of recorded runs, not a production-quality rate or a change to the prompt.\\n\\n### Proposed Step 1 link implementation\\n\\nCodex and Claude Code challenged concrete implementation options over five rounds. A separate reader audited the final wording against the prompt and clean design. The agreed first candidate preserves the existing one-call, thesis–evidence pair contract: retain valid links to open or newly proposed theses, consider a meaningful new thesis when no existing thesis covers the idea, and omit only an idea that does not inform a thesis and does not merit a new one. No standalone evidence, numerical semantic detector or code-based investment judgment is introduced.\\n\\nThe isolated candidate replaces the existing item-level `NONE` bullet with:\\n\\n```text\\n- NONE: If an idea informs no open or proposed thesis and merits no new thesis, omit that idea. If no idea yields a pair, return both lists empty.\\n\\nDo not link an idea to a thesis it does not inform.\\n```\\n\\nThis is a proposed clarification, **not a verified fix**: the current request already implies much of the same behavior. Relevant context, counterevidence, multiple valid links and meaningful new topics must remain. The first comparison reuses six stored article requests and their actual open-thesis states, with the original request as a same-day control; it will compare all outputs and useful omissions. The prepared request files pass the existing structural checks, but have not been sent to Luna. [The implementation council plan](STEP1-IMPLEMENTATION-COUNCIL.md) records the exact approach, source examples, independent audit, controls and limitations. The earlier 49-item fidelity review remains incomplete.\\n\\n### Step 1 link candidate: completed comparison\\n\\nThe [article-by-article comparison](../poc/data/clean-step1-link-none-2026-11-06/review.html) ran the original prompt and the proposed clarification on six saved articles, three times each. All 36 calls completed. Independent readers examined the source, open theses and answers before the prompt labels were revealed. This is a known-case diagnostic with frozen historical states, not a representative accuracy score or a stateful forward replay.\\n\\nThe candidate did not reliably eliminate the problem. On the GeForce NOW article, the answer attached the server expansion to the Shield TV thesis while saying it did not inform it in **1 of 3 candidate draws**, versus **2 of 3 original draws**. In the DeepSeek article, two original answers attached the reported custom chip to an NVIDIA inference-chip partnership thesis; none of the three candidate answers did. These small counts are observations, not proof of a durable improvement. In another article, named domestic-competitor evaluations were absent in two candidate answers versus one original answer; the source and full answer require an analyst's assessment.\\n\\nBoth arms also omitted the DeepSeek article's reported Kyber delay **and** NVIDIA's denial in all six answers, even though the article contains both and the Kyber thesis was open. Its revenue and margin guidance appeared in one of three answers in each arm. These omissions show that avoiding a particular wrong link does not ensure the system captures other important evidence. The active prompt is unchanged. [The detailed blind review](../poc/data/clean-step1-link-none-2026-11-06/BLIND-REVIEW.md) records all six articles, attribution concerns, known source limitations and the blind arm mapping. The next investigation is to trace the persistent missed-evidence case and its full request before proposing another change.\\n\\n### Trace: Kyber evidence omitted during extraction\\n\\nArticle 34's supplied text reported a possible Kyber delay to 2028 and NVIDIA's denial. An open Kyber thesis explicitly asked whether the roadmap or planned 2027 timeline would be affected. The model's original response and all six later comparison responses omitted the two statements; the runner did not remove them. Current revenue and margin guidance appeared in only two of the six later responses. The [source and request trace](../poc/data/clean-step1-kyber-trace-2026-11-06/TRACE.md) records the inputs, answers and limitations.\\n\\nEarlier article 10 had reported manufacturing setbacks and a company roadmap statement, but not the specific possible 2028 delay. Step 1 sees open theses, not prior evidence; the later evidence comparison is responsible for deciding repeats. The model can recover the missing statements in a leading follow-up, but a separate neutral self-account said it could not know its earlier reasoning and did not identify Kyber. Neither account proves why the original extraction missed it. In article 10, Kyber appeared later in the text and was returned in all six comparison answers; the different articles and thesis states do not establish that position or an existing thesis caused article 34's omission. No prompt change is adopted from this trace.\\n\\n### Kyber trace: thesis-visibility diagnostic\\n\\nA six-call follow-up kept the same article and all request settings, while comparing the full 20-thesis list with a hypothetical list that omitted the Kyber thesis. In both conditions, all three answers omitted the Kyber delay report and company denial. Current revenue and margin guidance appeared in two answers with the thesis shown and none with it hidden; with only three draws this is an observation, not a reliable difference. All six retained the main DeepSeek chip report.\\n\\nThe independent reader first assessed anonymous source and evidence without seeing thesis identities or links. The second pass checked links against the actual input; at that point the condition could be inferred. No thesis state advanced. This result does not support claiming that the mere presence of the existing Kyber thesis caused the omission in this example, and it does not establish the underlying cause. Removing a thesis is a diagnostic only and is not a proposed production change. [The complete trace](../poc/data/clean-step1-kyber-trace-2026-11-06/TRACE.md) preserves the source, self-account, requests and limitations.\\n\\n### Kyber trace: full article versus its source paragraph\\n\\nWith the same model, prompt, title, source metadata and all 20 open theses, an isolated comparison sent either the full saved article or just its exact 408-character Kyber paragraph, three times each. The full-article answers omitted the reported possible 2028 delay and company denial in **3/3 draws**; the paragraph-only answers returned both and linked them to the existing Kyber thesis in **3/3 draws**. The [six-answer replay](../poc/data/clean-step1-kyber-trace-2026-11-06/review.html) shows the text actually sent, thesis links, source quotations and attribution fields.\\n\\nThis selected example shows the outcome differs between the two inputs; it does not establish whether length, position or competing content caused the omission. The shorter input deliberately lacks the rest of the article and is not a production solution. Its answers combine the report and denial under one party/tier, which may blur provenance; some date and attribution fields also need review. Source-content and exact-passage findings were reviewed anonymously before input conditions were revealed; the later actual-input check was not blind. No production database or prompt changed.\\n\\n### Whole-article coverage council: prior attempts and next candidate\\n\\nCodex and Claude Code reviewed the saved extraction traces, older paragraph-by-paragraph experiments, source-first extraction and later split-prompt results. They agree that article 34's Kyber omission is in Luna's raw answer, but that its cause is not established and no complete coverage fix has been validated. The historical experiments found useful content as well as noise, incorrect links and lost context; the paragraph-only Kyber test also changed several input characteristics at once. The [council record](STEP1-COVERAGE-COUNCIL.md) maps each attempt to its results, limitations and original sources.\\n\\nThe council initially proposed moving the existing evidence-reading instructions before the thesis-opening instructions. The subsequent comparison below tested that proposal; its mixed results do not establish a fix. The original council did not itself run a new Luna experiment.\\n\\n### Whole-article coverage: completed order comparison\\n\\nThe proposed evidence-block reorder was tested without changing the clean prompt in the PRD. On nine previously inspected articles, three fresh answers per arm completed: **54/54 responses**. Each used the saved article and pre-item thesis state; no production state advanced. Independent readers assessed all answers against their source and thesis list before the arm mapping was revealed. The [interactive comparison](../poc/data/clean-step1-coverage-order-2026-11-06/review.html) shows each article, six answers, source passages and review observations.\\n\\nThe candidate returned article 34's Kyber delay report and company denial in **1/3** answers, compared with **0/3** controls; its recovered answer combined the report, denial and journalist's 2027 expectation under one company-statement record. Q2 guidance appeared in **1/3 candidate** answers versus **2/3 controls**. In article 27, **2/3 candidates** linked a cloud-gaming server to the AI-infrastructure-spending thesis without a supported connection; no control did. In article 10, all answers retained the Kyber facts, but **2/3 candidates** did not open a distinct roadmap topic where no Kyber thesis was already open; all controls did. Whether a distinct topic is warranted is a research judgment. In article 8, both arms retained vendor self-benchmark details in every answer alongside the IBM technical preview.\\n\\nThis selected-case comparison does **not** validate the reorder as a fix, and it is not adopted. It also found an attribution error even when the citation locates: an article 41 control summary attributes an Ayar Labs executive's 2028 forecast to a Lightmatter executive, while its own quotation identifies the Ayar speaker. The [detailed results](STEP1-COVERAGE-ORDER-RESULTS.md) distinguish facts, uncertain judgments, blind review, source limitations and the next source-fidelity investigation. The original active prompt and frozen production configuration remain unchanged.\\n\\n### Completed review: 49 articles and 160 evidence items\\n\\nThe original isolated forward run's **49 articles, 160 evidence items and 199 links** have now been reviewed against the complete text supplied to Luna, citations, attribution, dates, conditions and before-state. Independent readers checked the concrete findings and selected controls; that second pass was focused, not a second complete annotation of all 160 records. The [article-by-article fidelity replay](../poc/data/clean-step1-fidelity-review-2026-11-07/review.html) shows the sent text, captured page, thesis state, each evidence item, citations, links and review notes.\\n\\nFour records were judged to change source meaning or qualification, including article 29's stock-market investment becoming infrastructure spending and article 28's example model becoming a definite selection. Eight records were flagged for incomplete citation support or an unverified quote; ten records across three articles were flagged for unsupported thesis links, seven of them from one robotics article under a different agent-stack question. Four date-field cases were identified; other date interpretations remain concerns. These categories overlap, include human judgment and describe one selected run, not a population accuracy rate. The source itself was contaminated in article 3, while article 2 and article 16 lost relevant captured-page text before the model saw it. The [full review](STEP1-FIDELITY-REVIEW.md) records controls, uncertainty and the distinction between source losses, model errors and the unimplemented clean writer.\\n\\nA completed isolated comparison moved only `source_passages` before `summary` in the output schema. Across 11 previously inspected articles, three answers per condition were reviewed with condition labels hidden. The provider followed the requested field order, but both conditions omitted article 34’s Kyber delay and denial in all three answers, and all six article 11 answers stated a $1bn financing without citing the sentence that establishes the amount. Article 28 still turned an example model into an actual selection in one candidate answer, and one candidate turned investment in stocks into infrastructure investment in article 29. The small, selected comparison does not establish a general rate or a fix; the change is not adopted. See the [full results](STEP1-CITATION-ORDER-RESULTS.md) and [66-answer replay](../poc/data/clean-step1-citation-first-2026-11-07/review.html). The original prompt, production configuration and databases remain unchanged.\\n\\n### Source handoff council: ongoing investigation\\n\\nCodex and Claude Code are examining the source-to-extraction handoff and prior attempts. The original 49 saved requests and seven prepared-source requests had empty author fields; the prepared records retained proposed source roles, but those roles were not sent in the extraction request. Roles can mix bylines, outlets, dates and uncertain page material, so they cannot safely be promoted to an author field. A 20-article overlap check found that previously cited passages excluded by the recorded selections were an unrelated recommendation or explicitly labeled AI summaries; it does not establish full body coverage. Sixteen repeated article-34 controls omitted the same Kyber report and denial; the cause remains unproven. The [council record](STEP1-SOURCE-HANDOFF-COUNCIL.md) links the reproduced comparisons and previous failures. An isolated ten-article comparison completed 60 calls with the same prompt, schema and pre-item thesis states. Prepared text removed a known unrelated-story error in article 3 (2/3 original, 0/3 prepared) and generated-summary citations in article 8 (2/3, 0/3), but did not reliably improve extraction: article 16’s restored financing paragraph was in all three prepared inputs and in none of their answers; article 28’s example model was stated as a selection in all six answers; and article 34’s delay report and denial appeared in 2/3 controls and 0/3 prepared answers despite being present in both inputs. These are selected-case observations, not general rates or established causes. The [full results](STEP1-SOURCE-TEXT-RESULTS.md) and [60-answer replay](../poc/data/clean-step1-source-text-comparison-2026-11-07/review.html) show source and output. In two retrospective follow-ups, the model recognized that the article 28 wording did not establish a fixed model selection, but could not recover its original reasoning; the article 16 follow-up did not identify the financing paragraph. These accounts are diagnostic, not a fix. No production change is adopted. An isolated low-versus-medium reasoning comparison on six known prepared articles completed and was reviewed with setting labels hidden. Both settings stated an example model as actually used in all three article-28 answers. In article 29, stock-market flows were blurred into infrastructure spending in 3/3 low and 0/3 medium answers, but the medium answers did not retain that stock-flow statement. Other attribution and context concerns remained. These are selected-case observations, not a production acceptance or proof of cause. See the [full results](STEP1-REASONING-FIDELITY-RESULTS.md) and [36-answer replay](../poc/data/clean-step1-reasoning-fidelity-2026-11-07/review.html). The [source-fidelity prompt audit](STEP1-FIDELITY-PROMPT-AUDIT.md) maps observed failures to the complete request and signed standards. The council and an independent reader reviewed a field-local wording hypothesis that asks summaries to preserve source qualifications. In a six-article isolated comparison, all three answers in each arm still described an example model as part of the proposed system without preserving the “such as” qualification; other context and linking concerns remained. The field-description candidate is not adopted. [Full results](STEP1-SUMMARY-FIDELITY-RESULTS.md) and [36-answer replay](../poc/data/clean-step1-summary-fidelity-2026-11-07/review.html) preserve the cases and limits; the council is investigating the next step.\\n\\nThe continuing council has reviewed a possible structured representation of source statements and link explanations within the same extraction call. It is an untested diagnostic, not an adopted design or demonstrated fix. A prior reviewer missed a reversed relationship even with the full article and one evidence record; the proposed representation must still preserve legitimate inference, multiple sources and existing pairs. An independent audit found that the first draft could exclude the very link explanation being investigated, and the council chose not to run this enlarged diagnostic as the next test. A further low-versus-medium comparison completed on six manually selected real articles outside the original 49-item replay, with one fixed 22-thesis exploratory state for both settings. These use the corpus cleaned text, not the earlier prepared-source path; their prior exposure outside the clean replay is unknown. Earlier mixed results and regressions remain unresolved. The [council record](STEP1-SOURCE-HANDOFF-COUNCIL.md) and [draft experiment](../poc/data/clean-step1-structured-claims-2026-11-07/design.md) preserve the discussion, offline checks and limits.\\n\\nThe additional-source comparison produced mixed results: both settings retained several central claims, while the higher setting also produced unsupported CPU-related links and date-field errors in individual answers. An independent review also found 13 fields across eight repeated answers that appear to use an event or data period as the original statement date; ambiguous cases were kept separate. In three later, specifically prompted continuations, the model correctly distinguished those time references; this does not establish the original cause or a fix. A quotation found in the cleaned input was not contiguous in the captured original page. These are selected-case observations, not population rates or a reason to change the production setting. [Results](STEP1-ADDITIONAL-SOURCES-RESULTS.md) and [article-by-article replay](../poc/data/clean-step1-reasoning-new-sources-2026-11-07/review.html) show the source, context, answers and limitations.\\n\\nAn additional [date and link support review](STEP1-DATE-AND-LINK-CENSUS.md) examined the original replay's non-null date-text fields and 76 links from three later test articles. It separates event periods, uncertain original dates, source facts found elsewhere in an article, and clearly labeled inference. The results identify recurring issues and an open link-citation contract question; they do not establish a fix or a population-wide error rate.\\n\\nAn isolated date diagnostic compared one revised `statement_date_text` schema description with the saved request on eight known source/context pairs. It leaves all schema types, evidence pairing, prompt body and production configuration unchanged. Controls include a third-party statement independently dated to the article day, explicit announcements and a dated party release. Independent review identified risks of losing valid metadata-only or announcement dates; these were inspected alongside omissions and linkage. The results were mixed, including persistent date mistakes, unsupported-link concerns and literal `\\\"null\\\"` text in two fields; the candidate is not adopted. [Results](STEP1-DATE-DESCRIPTION-RESULTS.md) and [48-answer replay](../poc/data/clean-step1-date-description-2026-11-07/review.html) retain the details. The [design](../poc/data/clean-step1-date-description-2026-11-07/design.md) records the exact scope and prior attempts.\\n\\nTwo retrospective continuations of the robotics-link answers recognized that the cited article did not establish adoption of the specific Nemotron/NemoClaw stack when asked directly. They were leading follow-ups and do not prove the original cause. A distinct robotics topic may be considered on its merits; demonstrated commercial impact is not required merely to open a useful question. [Full trace](../poc/data/clean-step1-robotics-link-accounts-2026-11-07/).\\n\\nA further isolated comparison completed on eight new source IDs selected before reading article contents using a recorded seed and a structured inventory of available clean-Step-1 artifacts. It reuses the same unmodified date-text candidate and the same fixed exploratory thesis context for both arms. The selection cannot prove absence from all past work or exclude syndicated stories under different IDs. An independent source review found related-story contamination and unlabeled generated summaries in some cleaned inputs; these were assessed separately. One company article lost its supported full statement date in all three candidate answers, while another preserved its date in both arms; the candidate is not adopted. [Results and replay](STEP1-DATE-NEW-SOURCES-RESULTS.md) and the [selection design](../poc/data/clean-step1-date-unseen-2026-11-07/design.md) retain the evidence.\\n\\nAn independent [thesis-link review](STEP1-ROUTING-CENSUS.md) examined all 214 links across the eight preregistered articles. It records unsupported topic bridges and explanations that negate their own link, alongside valid indirect context and source-supported prospective topics. These are selected-case findings, not population error rates or a hardcoded relevance filter.\\n\\nA [source-provenance census](STEP1-SOURCE-PROVENANCE-CENSUS.md) found 163 records across three explicitly recognizable page components where generated-summary content was retained but its label was removed. This is a bounded source-structure count, not a count of model errors. On two NVIDIA pages, the cleaner's template removal and long-line restoration reproduce the mismatch; a general provenance-preserving handoff is under review. An offline probe reproduced the current cleaned text for 163 affected pages and 200 seed-selected additional pages. It retains all candidate original positions, marks transformed bylines, and shows one missing-HTML fallback; positions do not by themselves establish source role. [Lineage replay](../poc/data/clean-step1-source-lineage-2026-11-07/review.html). Source content remains available and no production data or prompt has been changed.\\n\\nAn [offline source-context observation](STEP1-SOURCE-CONTEXT-OBSERVATIONS.md) compared immediate original-page neighbors with complete adjacent unmatched runs, without modifying inputs. They exposed 144 and 149 respectively of 163 known labels but also many unrelated page lines, and did not cover the TradingKey cases. Thirty preselected pages received a line-by-line human review. These are partial diagnostics, not an adopted cleaning rule. A replay of 153 quotations from 18 saved answers across three selected articles found no changes in quote-verification status under either hypothetical text, but the Ising quotation falsely accepted after cleaning remained falsely accepted because both approaches omitted the intervening lines. A further full-page quote check flagged that Ising passage as unverified; this does not test extraction on the full page. This limited replay does not establish general safety or source meaning. In the earlier 49 completed forward-play articles, a separate count found 248 of 250 saved passage instances located in the captured page and two already unverified; the [observations](STEP1-SOURCE-CONTEXT-OBSERVATIONS.md) distinguish this from semantic accuracy. [Source-context viewer](../poc/data/clean-step1-context-restoration-2026-11-07/review.html).\\n\\nA [saved quote-integrity census](STEP1-QUOTE-INTEGRITY-CENSUS.md) independently matched 360 answers in eight overlapping cohorts to their original requests and results, and reconstructed a further 60-answer source-text comparison separately. It distinguishes exact page location, unverified quotations and cleaned-text-only joins. Five unverified passage instances are full matches under the existing normalizer, including spaces before punctuation. The isolated Step 1 runner now locates a complete normalized match when every matching source slice has the same original bytes. It retains the model quotation, displays the located source text, and records lookup errors without stopping the exploratory stream. The [installed-path review](STEP1-QUOTE-INTEGRITY-CENSUS.md) covers saved-answer replays, Unicode and duplicate controls, resource checks and limitations. This fixes a narrow location issue in the isolated runner; semantic accuracy, original-page provenance and production compatibility remain unproven.\\n\\nA [source-first 49-article coverage review](STEP1-COVERAGE-CENSUS.md) separates text removed before extraction from material present in the input but absent from Luna’s raw answer. It records concrete cases and uncertain matter boundaries, without creating a new golden set or asserting a population recall rate. Previously tested source selection, prompt order and reasoning changes remain unproven. Seven older production-era raw answers returned the same article’s Kyber report and denial, but differed in request context, schema and run date, so the [continuing council](STEP1-COVERAGE-COUNCIL.md) treats the difference as a lead rather than a proven cause.\\n\\nIn the continuing council, Codex and Claude Code agreed that repeating one article alone would measure variation rather than identify a remedy. The complete clean prompt already includes examples and asks for a full article reading; no single prompt sentence has been established as the cause of the omissions. One proposed general clarification to the standard's named-party claims and estimates is an untested audit hypothesis, not an adopted prompt. A useful future comparison would hold each article and its pre-article thesis state fixed, interleave control and one candidate, and review complete outputs against the source for missed information, noise, attribution, conditions and links. Its chosen articles and review procedure must be recorded before the sends; selected cases cannot establish production quality. Source text lost before the model call is a separate problem, to diagnose against the existing cleaning code and saved pages. Step 1 remains one call with thesis–evidence pairs. [Council exchange and limits](STEP1-COVERAGE-COUNCIL.md).\\n\\nThe [source-loss investigation](STEP1-SOURCE-LOSS-CENSUS.md) traced two different ways the historical cleaner can discard article content before Step 1: a financial statement grouped with related-story headlines, and a financing paragraph omitted by the HTML extractor whose final marker prevented the long-line fallback from keeping it. A corpus-wide count identifies thousands of lines meeting the underlying structural conditions, including many unrelated titles, code and advertisements; these are not all lost investment facts. No general source-cleaning repair has been established. A new read-only council is examining the trace and previous source-selection attempts; the original corpus remains unchanged.\\n\\n**Test-data correction:** Alex confirmed on 2026-11-07 that the source-cleaning script and source test data may be changed when their defects are confirmed to affect testing. Preserve the original inputs for comparison and verify the effect of a candidate on real sources. This permission concerns the test source data; it does not change the frozen evaluation standard, gold, production configuration or production database.\\n\\nThe investigation also found that the historical extractor-matching key removes non-ASCII characters and can accidentally match an empty key. Two Unicode-aware offline alternatives had different effects on the saved articles, including adding unrelated page titles; neither is adopted. A proposed punctuation change recovered the financing paragraph but also added serialized HTML and navigation on other pages. The [investigation](STEP1-SOURCE-LOSS-CENSUS.md) records the full-corpus comparisons and their limits. Source identity and article boundaries need to be evaluated alongside text matching.\\n\\nAn existing HTML-tag-based candidate was also replayed across all 6,463 originally fed articles. It reproduced its earlier 49-article comparison, but would change 1,054 pages. For example, it adds unrelated news recommendations to an AI investment report and removes a sourced timeline from an AI training article. This does not establish a general error rate; it shows why HTML tags alone cannot decide whether material belongs to the article. No candidate has been integrated.\\n\\nA [full-page diagnostic](STEP1-FULL-PAGE-DIAGNOSTIC.md) compares the cleaned text with the saved captured page under the same thesis state and instructions. It checks whether Luna can find the target article while preserving its source and ignoring unrelated page material. The captured page can itself be wrong or incomplete, and using it is not an adopted implementation.\\n\\nTwo independent readers have completed [source-first notes for the 17 proposed articles](STEP1-FULL-PAGE-SOURCE-NOTES.md), before any new comparison outputs. These notes identify source roles, incomplete captures, uncertain statements and later page material; they are not a new golden set or mandatory extraction checklist.\\n\\nThe isolated full-page comparison completed all **102 calls** across 17 articles, with three answers for each input per article. Three independent readers examined the answers against the source, with imperfect condition hiding. In one selected article the page exposed an outlook qualification absent from the cleaned input, and all three page answers included it; in another, all three cleaned-input answers misattributed an unrelated later-story teaser, while the page answers did not. In a third, five of six answers turned an example model into a definite selection despite both inputs preserving the qualification. The [source-backed results](STEP1-FULL-PAGE-RESULTS.md) distinguish source loss, attribution and model meaning errors, and the [article-by-article replay](../poc/data/clean-step1-full-page-diagnostic-2026-11-07/review.html) shows the inputs and answers. These selected cases do not establish a general accuracy rate or production readiness.\\n\\nThe cleaner also switched off 615 of 6,463 articles originally marked for processing. A replay of the current cleaner reproduces all 615 switches, and one confirmed example contains a 9,874-character article compressed to a single line: it fails the cleaner's requirement for three long lines. Other excluded captures are a paywall, a weather page or challenge code. An offline candidate that replaces long-line counts with long-sentence counts would recover 89 records but disable 49 currently processed records, including readable reports; a sample of the 89 includes unrelated pages. These are concrete evidence of a source-test problem and of why simply adjusting a length or count threshold would not resolve it. How many articles were wrongly excluded remains unknown; the [results](STEP1-FULL-PAGE-RESULTS.md) link the cases and reproducible comparisons.\\n\\nA [test-source preservation candidate](STEP1-SOURCE-PRESERVATION-DESIGN.md) describes a separately versioned comparison that retains the saved page, the previous cleaned input and both historical processing flags. It is a proposal for making source losses inspectable and exposing previously excluded inputs; it does not assert that a saved page is a complete or correctly identified article. Its database mapping, runner behavior and offline checks are specified before implementation. The existing production source and frozen configuration are not changed by this candidate.\\n\\nThe isolated candidate has now been built and its 34,084 records compared with the two source snapshots. A fake-answer run through the actual Step 1 runner confirms that the previously excluded CNBC article reaches the runner with its saved page. Replays also preserve the recorded validation results for 102 saved comparison answers and 49 completed forward-run answers. This verifies the handoff and historical checks, not model extraction or article identity. The [council regroup](STEP1-SOURCE-REGROUP-COUNCIL.md) records why source cleanup comes first for a stable test and which model-processing errors remain separate.\\n\\nThe [source-only controls](STEP1-SOURCE-CONTROLS.md) document a real article, a wrong-page capture and two partial or paywalled captures before any new model run. A partial headline may itself carry a useful attributed statement; a wrong page does not establish that the missing target article was irrelevant. Two additional non-NVDA-tagged bad captures are source controls only and are not placed into an NVIDIA thesis context.\\n\\nThe [control-run design](STEP1-CAPTURE-CONTROLS-DESIGN.md) sends four eligible captured pages independently with one fixed hypothetical thesis state, plus one comparison using the CNBC article's previous cleaned text. It preserves the existing extraction request and treats missing article content, source attribution and model interpretation as separate questions. All five calls completed; the [replay](../poc/data/clean-step1-capture-controls-2026-11-07/review.html) shows the actual inputs and proposals. In these selected draws, the wrong page yielded no pairs, while the two partial pages yielded qualified proposals. Source review also found summary details whose supporting headline or article passage was not included in the attached quotations. The [results](STEP1-CAPTURE-CONTROLS-RESULTS.md) record the evidence and remaining uncertainty; these draws are not a general quality measurement. A [request audit](STEP1-CITATION-SUPPORT-AUDIT.md) confirms that the current prompt already asks for all passages needed to support each summary; the cause of these omissions is not established.\\n\\nA subsequent [numeric citation triage](STEP1-NUMERIC-CITATION-TRIAGE.md) looked for exact digit tokens in summaries that were absent from their own passages and sent the flags to readers. Several items combined facts from later paragraphs without attaching those paragraphs; other flags were formatting or date-context differences. This is a case-finding aid, not an automatic citation judgment, a quality rate, or a rule that decides what the analyst should keep.\\n\\nAn independent [citation review of all 160 returned records](STEP1-CITATION-COMPLETENESS-49.md) in the historical 49-article run found nine preliminary cases where details appear in the supplied article but not in their own evidence passages. A second reader checked those cases, distinguishing substantive missing conditions from source-identity or contextual antecedents. Meaning changes and whole-article omissions are separate problems, measured in different units; this selected run does not establish which problem is largest in production.\\n\\nThe council is also examining whether selecting source-unit IDs could reduce copying errors. An [offline boundary and size check](STEP1-SOURCE-ID-OBSERVATIONS.md) found that the existing quote-repair boundary heuristic splits real abbreviations and that many saved quotations cross its units; a simple numbered JSON representation also increased source-only input size on the checked pages. IDs would not establish semantic support or article identity. No such representation is adopted.\\n\\n### Source-fidelity council: what must be preserved\\n\\nCodex and Claude Code completed five rounds of review of the source-fidelity failures, existing trace and downstream code, and previous experiments. They agree that no tested fix has yet been established. An article 41 answer quotes an Ayar Labs executive accurately but names a Lightmatter executive in its standalone summary; a previous FEV link explanation reverses the relationship described by its source. Missing citation context, incorrect source meaning and contaminated inputs are different failures. Exact quotation matching cannot settle them.\\n\\nThe agreed record-by-record review of the original 49-article, 160-evidence run is now complete, with the later 54-answer comparison kept separate. For each evidence item, compare its claims, citations, actor, reporting source, time, qualifications and thesis-link explanation with the complete source. Check real downstream readers and include correct records as controls. The subsequently completed field-order comparison is described above; it did not establish a fix. No automatic split, semantic gate or arbitrary count threshold is adopted. [Full council analysis and prior attempts](STEP1-FIDELITY-COUNCIL.md).\\n\\nThe existing clean trace keeps multiple passages, but its Step 3 mapping to the older single-quote evidence store has not been implemented. The existing writer stores an unknown original day as empty; the older Jev comparison and revision-order path can use publication day as a fallback. These are different paths and do not establish that a clean production write has already lost information.\\n\\n### Step 1 joint review: causes and priorities\\n\\n**Execution order approved by Alex:** (1) source text and event ordering, (2) thesis links, (3) faithful summaries and omissions, (4) thesis granularity and noise. Investigate and validate each in that order; retain the original traces and distinguish proven causes from proposals. The detailed findings below are the recorded joint-review consensus.\\n\\nCodex and Claude Code (`claude-fable-5-1`) reviewed the 49 source records, original requests and answers, state, and the clean runner over three rounds. They challenged each other's claims against the saved records and code. Claude read the earlier Codex review before completing its first pass through all 49 articles, so this was **not a fully blind independent review**. The [first](../poc/data/clean-step1-review-consensus/claude-round1.md), [second](../poc/data/clean-step1-review-consensus/claude-round2.md) and [third](../poc/data/clean-step1-review-consensus/claude-round3.md) responses, [Codex's checks](../poc/data/clean-step1-review-consensus/CODEX-OBSERVATIONS.md), and local packets are retained for inspection. These are findings and proposed investigations, not approved changes to the architecture or production behavior.\\n\\n| Priority | What is observed | Cause established, or still a hypothesis | Direction to investigate |\\n|---|---|---|---|\\n| 1. Wrong thesis links | In article 4, valuation and revenue are linked to Nemotron performance; in article 27, a cloud-gaming server is linked to the Shield TV thesis. Three of the 199 returned links explicitly say the item does not inform the selected thesis. Article 18 puts robotics evidence under the Nemotron/NemoClaw thesis; article 41 links general networking details to a specific Kyber setback. One 2027 roadmap statement in article 41 can also be defensible context for that thesis. | Luna returned these links; the clean runner checks reference identity and source location, not whether the link answers the thesis. That separation is deliberate: code does not decide importance. The cause of the model's decision is **not proven**. A forced pairing or insufficient deliberation may contribute; neither is established by one run. | Compare matching decisions against the complete question and outcome, including valid indirect links. Preserve the user's thesis–evidence pairing rule. Do not add a hard-coded list of keywords or make code decide investment relevance. |\\n| 2. Source contamination and order | Article 3's July Firmus text includes two October related-story summaries; the model uses one as Firmus evidence. Article 28 also includes later recommendations, though its output did not cite them. Of 46 records with parseable timezone-aware page timestamps, 26 of 45 adjacent comparisons in that known-timestamp subsequence are inverted relative to the run order; one crosses a New York day. The other three lack comparable timestamps, and page metadata may itself be wrong. An earlier count of 45 and 25 missed a valid `+0000` timestamp. | In article 3, the clean pipeline re-adds long lines the structural extractor omitted; both unrelated snippets meet that fallback. The same fallback retains real guidance and other article text in article 34. In article 28, the structural extractor itself includes the recommendations. The manifest follows fixed processing order, not guaranteed page-publication order; a Google listing time is not automatically the page's original time. | Test source extraction and time provenance separately from model changes. Any cleaning proposal must remove unrelated content without losing real article tails. For a stateful chronological test, define and inspect the timestamp source and missing-time handling; do not rewrite the recorded run. |\\n| 3. Meaning, attribution and omissions | Article 29 turns funds flowing into AI-infrastructure **stocks** into infrastructure **spending**. Articles 17 and 37 combine results and attributed commentary in fact-labeled items; whether they are one matter or should be separated needs review. Article 34 omits reported revenue guidance and Kyber claims; article 36 omits reported $1 trillion revenue visibility. | The statements are present in the inputs and the problematic summaries or omissions are in the raw model answers. Exact quote matching cannot establish semantic support, attribution or completeness. The reason for each model choice is not yet established. | Audit the assembled prompt, schema and affected traces against the analyst standard. Keep reports, expectations and forecasts distinct from completed results. Review what the model omitted as well as what it returned. |\\n| 4. Thesis granularity and noise | Some vendor technical benchmarks and broad comments were returned despite the draft's not-kept guidance; some narrowly scoped topics may be noisy. Other specific launches, partnerships or investments can still be meaningful. | The trace proves what was returned, not a general precision rate or why the model chose it. Alex explicitly permits an observable, meaningful topic without requiring a proven financial impact. | Judge the actual investment question and subsequent observable evidence. Do not impose a universal financial-size rule or automatically exclude an industry, product or partnership. |\\n| 5. Handoff and provenance | The clean trace stores per-link `relevance`; the inspected existing `evidence_links` table stores evidence ID, thesis ID and sequence, not that explanation. Step 2 and the clean Step 3 writer were not run. | This is a future integration risk, not a claim that this experiment wrote or lost data in production. Unmatched source passages and unresolved links remain visible and provisional in the exploratory path. | Verify the actual writer and reader mapping before claiming the explanation or a multi-passage source survives into a dossier. Compare repeated evidence in Step 2, rather than counting Step 1 repeats as a dedup failure. |\\n\\n**Reasoning-token observation, not a root-cause verdict:** 13 of 49 recorded Luna answers report zero reasoning tokens. The three links whose own explanations explicitly reject the match occur in two of those answers. However, other questionable links, the article-29 meaning change and article-34 omissions also occur in answers with nonzero reported reasoning tokens. The zero/nonzero categories were examined after seeing the run; they cannot establish cause or predict production performance. Claude's initial stronger claim that no nonzero answer had a relevant error was corrected in discussion.\\n\\n**Link-setting diagnostic (completed; results below):** use the same stored source and before-state for a few wrong-link examples and valid direct/indirect-link controls; compare same-day `low` and `medium` settings with repeated sends. Have readers inspect source, output, thesis and attribution without seeing the setting or reported token count. Record both wrong attachments and useful evidence lost. This can indicate whether a setting is worth studying; it cannot prove why the model erred or establish production improvement. The frozen historical ruler and gold remain unchanged, and no new golden dataset is required for this exploratory trace review.\\n\\n**First no-cost source test, completed as an investigation, not a replacement pipeline:** compare saved HTML, the structural extractor and the current cleaned text for article 3 and article 28, with article 34 as a positive control for real text that the fallback preserves. Count both unrelated content retained and relevant article content lost before proposing a change. The [candidate census](../poc/data/clean-step1-review-consensus/source_fallback_census.py) found 112 long retained lines across 23 of these 49 records that are absent from the extractor output; these are candidates, **not 112 proven errors**. The [timestamp census](../poc/data/clean-step1-review-consensus/timestamp_census.py) and raw outputs record its scope and limitations.\\n\\n### Execution 1: source text and event ordering\\n\\nThe source investigation used the 49 archived pages and the exact text sent to Luna. It identified both added and missing content:\\n\\n- Article 3 includes two later related-story summaries. The existing cleaner adds long lines excluded by the structural extractor; Luna used one unrelated summary as evidence. Article 28 also contains related-story recommendations, but those already appear in the structural extractor output. One fallback rule does not explain both.\\n- Article 2 loses a genuine statement that NVIDIA excluded China revenue from its outlook because the headline-removal step removes it. Article 16 loses the reported $1 billion funding and $11 billion valuation sentence because the fallback does not recognize its final symbol as punctuation. These are defects in the supplied source, before Luna reads it.\\n- The same long-line fallback preserves real guidance and other body text in article 34. The default extraction mode removes the unrelated article 3 and 28 examples and restores article 34, but returns unrelated headlines instead of the actual article 16 body. Another existing extractor loses substantive article 28 content. Neither is a safe wholesale replacement. A separate structural candidate recovered the omitted article 2 and 16 passages and removed article 3’s recommendations, but added unrelated headlines and promotional text and missed article 28’s recommendations. Its narrower variant proposed 14 additions across six articles, not all valid. Extractor agreement also either retained promotion or lost real content. These are observed controls, not a complete measurement of all source errors.\\n- Of 46 comparable page timestamps, 26 of 45 adjacent known-time comparisons are reversed in the saved processing order. Three pages lack comparable timestamps. Page times need provenance and are not automatically authoritative. Article 20 precedes article 18 by page time but was processed later; whether a different order would change the model's links is untested. The original run is retained unchanged.\\n\\nThe author gap is wider than one article: all 34,084 records in both the saved page and cleaned snapshots have an empty `authors` field; the clean runner forwards that value. The assembly script initializes it empty and the cleaner does not populate it. In the 5,848 cleaned, feed-eligible article rows it is also empty. On 16 selected pages with visible named bylines, the existing HTML metadata extractor captured all visible names on 11, some on two and none on three; some wrong names appeared in page metadata even when the metadata identified the correct article URL. It is a source hint, not a safe automatic author replacement. Article 6's cleaned text also omitted the visible author. The [source-only diagnostic design](STEP1-DESIGN.md) tests byline handling without changing a production writer or selecting an unverified name.\\n\\nA separate model-assisted source-preparation experiment asked Luna to identify article lines in the archived whole-page text without rewriting them. One draw on six known pages recovered the real body paragraphs checked in articles 2, 3, 16, 28, 34 and 42, including the previously missing CFO and funding statements; it excluded the identified unrelated recommendations in articles 3, 28 and 34. An independent reader checked the selected text against the page and HTML. But article 2's selected text presents the page's AI-generated summary without its label, and also includes a photo caption and credit. Articles 3 and 16 lose visible author names while the stored author field is empty. All six returned no uncertain lines. Each selected line was copied unchanged from the stored normalized page, with no invalid or repeated IDs; exact copying does not solve source attribution. These six selected pages and one draw do not establish production safety, quality across the source pool, or completeness of a paywalled article.\\n\\nA second isolated source-boundary experiment separated article text, bylines, captions, page-generated summaries and uncertain material, allowing a line to have several roles. An independent reviewer compared one draw on ten selected pages with the saved page and HTML. They found no wholly missing authored body paragraph or visible byline name among those pages, and the explicitly labeled AI summaries were separate from the article role. The CFO and funding statements remained, and the known unrelated recommendations were excluded. Figure captions on two pages were available only in the caption role; article 7's AI-widget disclosure was omitted; and the source of some widget “Next Steps” text is unclear even though the model marked no lines uncertain. A downstream consumer would need the separate source roles and their provenance, not just the article text. These are selected-case observations, not a completeness or accuracy guarantee. A further check used three sends each on ten other articles, randomly selected from the same 49-article corpus. Independent readers found the substantive paragraphs visible in the archived article regions in all 30 outputs, but one output omitted a visible author whose stored `authors` field was empty. Some outlet labels, contributor roles and article/caption roles also require care. The model later identified the missed author when prompted, which does not prove why it missed her initially. These articles appeared in the earlier extraction review, so this is not a fully unseen corpus; the [independent check](../poc/data/clean-step1-review-consensus/source-prep-check/INDEPENDENT-REVIEW.md) is not a population accuracy estimate. The [second probe](../poc/data/clean-step1-review-consensus/source-prep-probe-v2/) is not integrated into the pipeline.\\n\\nA subsequent blinded source-role comparison fixed a caption field-name mismatch in both arms, then tested a byline clarification against the corrected baseline: ten sends per arm on article 6 and three per arm on six provenance controls. The author was retained in the source role in 8/10 baseline and 10/10 candidate answers. However, two of three candidate outputs for article 28 incorrectly labeled the host's introduction as generated; all three also selected a site clock as source information. The introduction itself remained selected as article text. The candidate therefore fails the source-attribution controls and is not adopted. This is a selected-case diagnostic, not a population score; [the blind review](../poc/data/clean-step1-review-consensus/source-byline-comparison/BLIND-REVIEW.md) records the cases and their limits.\\n\\nFor the 49 selected records, the archived whole-page text contains about 107,119 local tokenizer tokens versus 49,656 for the current cleaned text; a separate source-preparation call would add those input tokens and another model call before extraction. This is a local token estimate, not a provider bill or a projection over all records. The [six source-preparation traces](../poc/data/clean-step1-review-consensus/source-prep-probe/) are isolated; no model-selected text has been substituted into the replay or production pipeline.\\n\\n**Status:** the causes above have been traced, but no general source-cleaning or ordering fix is established. Do not silently remove the fallback, switch extractors or invent times for missing records. Compare a candidate against both contamination and genuine-body controls before using it in a new stateful run. The [source fallback census](../poc/data/clean-step1-review-consensus/source_fallback_census.json), [headline-filter census](../poc/data/clean-step1-review-consensus/headline-filter-census.json), [extractor comparison](../poc/data/clean-step1-review-consensus/default-extractor-comparison.json), and [corrected timestamp census](../poc/data/clean-step1-review-consensus/timestamp_census_v2.json) preserve the local investigation. The censuses identify candidates, not independently adjudicated error counts.\\n\\nThe earlier review's Firmus date concern is corrected: the archived page timestamp is `2026-07-09T01:03:59Z`, which is July 9 in Sydney and July 8 in New York. The stored New York day and displayed Sydney day therefore represent the same instant. The separate listing timestamp and the order of the run still need their own evaluation.\\n\\n### Execution 2–4: link, fidelity and topic review\\n\\nA second reader independently checked eight saved link cases. Across their 41 evidence items and 47 links, the stored links match the raw provider answers; the runner did not choose them. The reader confirmed article 4's two links and article 27's one link explicitly contradict the model's own explanations. Article 18 attaches seven robotics statements to a Nemotron/NemoClaw thesis without a named connection in the item. Article 41 requires care: its general networking facts do not state a connection to the Kyber setback, but its 2027 plan can be relevant context to the roadmap. Article 10's provider commitments and roadmap counter-evidence are examples of links that can legitimately inform more than one question. Source contamination and the original order limit all these observations.\\n\\nFor articles 4 and 27, Luna was shown its own stored answer and the original context and asked to review the links. It acknowledged both contradictions. In article 4 it suggested a new, evidence-backed revenue thesis; in article 27 it suggested no pair. It attributed the errors to an overly broad interpretation of indirect relevance. This is a **retrospective account**, not proof of the original cause. The full [requests and responses](../poc/data/clean-step1-review-consensus/link-account-probes/) are retained. A controlled exploratory comparison resent eight unchanged saved requests and their original before-states three times at low and three at medium reasoning. Independent readers reviewed anonymous outputs before the settings were revealed. In five selected wrong-link scenarios, 6 of 15 low-setting answers contained at least one clear wrong-product or unrelated-question link, compared with 0 of 15 medium-setting answers in that specific class. Other links and source-fidelity issues remained, and the examples were selected after the original run, so this is not a general accuracy estimate or proof of cause. The 24 low responses used 45,091 completion tokens versus 106,839 for the 24 medium responses; these are usage counts, not a cost or latency comparison. [Blind review and limitations](../poc/data/clean-step1-review-consensus/link-setting-probe/BLIND-REVIEW.md) records the cases. The experiment did not advance state or change the production setting. A second isolated test compared the saved prompt with a candidate that makes the existing final check actionable and makes the technical-comparison exclusion explicit. Three independent readers inspected six unlabeled answers for each of three known articles before the prompt labels were revealed. Every candidate and baseline answer still retained excluded technical comparisons, while also retaining the IBM integration, relevant AMD competitor comparison and Perplexity usage in the applicable controls. A candidate answer additionally misstated which company’s hardware was in a 100 kW rack. The candidate is not adopted. This small, selected test does not establish a general rate; the [blind review](../poc/data/clean-step1-review-consensus/benchmark-prompt-probe/BLIND-REVIEW.md) records the outputs and limits. Neither test changes the current prompt or database.\\n\\nFor source fidelity, article 29 changes flows into AI infrastructure **stocks** into infrastructure **spending**, which the source does not say. Article 34's input contains revenue guidance, margins, its China assumption, and a reported delay and denial, none of which appear in the answer. Article 36 omits reported management revenue **visibility**, not realized revenue. In articles 17 and 37, a factual result and an analyst or author's interpretation appear under one fact tier. The summaries identify the commentary as such; article 37's `original_party` field names only the company, so whether that field alone gives a downstream reader enough context needs review. The standard allows a mixed single matter to use its main claim's tier; separate matters should be evaluated separately. Article 34 also attributes a report to unnamed sources although the supplied article only says reports. The exact source and raw answer establish these examples, but not why the model made each choice. The request instructs the model to preserve meaning, attribution and guidance; it asks for separation when attribution would blur, while allowing a mixed statement to use its main claim's tier. Those instructions can coexist when applied to the correct unit; whether they were applied correctly to these items remains an analyst judgment. Article 34's supplied text also contains unrelated recommendations.\\n\\nFor topic and evidence noise, article 8's company-reported technical benchmark items and article 33's benchmark conflict with the saved prompt's final check. An independent reader inspected all 160 output items and flagged 13 primarily technical test or comparison items, two mixed items whose non-benchmark content needs separate review, two competitor-comparison controls and six uncertain boundary items. These are item-level leads from one run, not a count of research matters or a general error rate. This does not prove every technical detail is unhelpful. In article 1 the only evidence for the newly opened performance thesis is a company-reported benchmark; excluding that item under the existing standard would leave that proposed thesis without evidence. Its separate adoption thesis has other evidence and must be considered independently. Article 8 also reports IBM production-workload testing and integration, which should not be discarded with the benchmark. A rival's comparison and reported use in article 19, the named robotics integration in article 20, and NVIDIA-backed financing in article 44 require their own relevance judgment. The user's rule remains: an observable, meaningful topic can be opened before its financial impact is known; avoid noise without imposing a blanket size or industry threshold.\\n\\n**Status:** these reviews identify source-backed errors and prompt tensions; they do not yet establish a general fix or justify editing the prompt. The original 49-item answers and states remain unchanged. In a separate follow-up, the model recognized article 29’s substitution and several omissions in article 34; on article 8 it described the benchmark items but read the rival-comparison exception more broadly than the original prompt states. These are retrospective answers to leading questions, not proof of the original decision. The [full continuation requests and answers](../poc/data/clean-step1-review-consensus/fidelity-account-probes/) and [request audit](STEP1-PROMPT-AUDIT.md) are preserved. The controlled comparison is a diagnostic on selected known cases, not a fresh stream, acceptance test or general accuracy estimate.\\n\\n### July 8–9 Step 1 replay\\n\\nThe [July 8–9 article replay](../poc/data/clean-step1-2026-07-08-09/review.html) records an exploratory run of 49 selected NVDA-tagged articles in source order, starting with an empty isolated thesis library. Five July 8 articles completed; article 6 failed source-passage validation and stopped the run. The remaining 43 articles were not processed. Four theses were in the isolated library after the completed articles. This is not a production write or a golden evaluation.\\n\\nThe failed article's model proposals are visible as unaccepted output; they were not added to the library. The first proposed quotation replaced the source words “The GPU giant” with “Nvidia,” so it was not an exact source passage. On a copy of the answer, restoring the full original phrase makes all three proposed evidence items pass source-location checks; this is a manual diagnostic, not an automatic recovery or a semantic correctness check. Article 5 reused the revenue-growth thesis opened by article 4.\\n\\nThe third completed article returned no pairs even though its stored excerpt reports a proposed NVIDIA investment of about US$500 million in Firmus. This is a useful new company action to follow, with the reported terms and uncertainty preserved. A follow-up model account suggested it required a stated business benefit; that account does not establish why the original answer was empty. Three additional sends of the original request and three of an initial revised prompt all extracted the investment, so this small comparison does not establish that the prompt change improves recall. The prompt now removes a universal scale restriction that conflicted with Alex's broader clean-design topic rule.\\n\\nThe stored article text also includes two recommendations from October that were appended to the July article; the underlying stored page identifies them as related articles. All six comparison outputs quoted one of those later snippets as evidence. The article's stored day is July 8 in New York while its page displays July 9 in Sydney; the page timestamp represents the same instant in both time zones. The listing timestamp is a separate value. This is not itself a date error. The replay's fixed source order is not proof of publication-time order, and even a verified quotation can be wrong evidence if the supplied source text contains later material. These issues must be addressed before treating this replay as a reliable chronological assessment; the stored run is preserved unchanged.\\n\\nThe trace and reading page are local run artifacts, not included in Git. If available, regenerate the page with `python3 clean-arch/step1/render_replay.py --source poc/data/clean-step1-2026-07-08-09/trace.sqlite --output poc/data/clean-step1-2026-07-08-09/review.html --annotations poc/data/clean-step1-2026-07-08-09/replay-notes.json`.\\n\\nThe [subsequent rerun](../poc/data/clean-step1-2026-07-08-09-rerun/review.html) used the revised prompt, the same 49 selected items and an empty isolated library. It stopped on article 1: one proposed source passage added “NVIDIA” before the source's “NemoClaw,” so the quotation was not contiguous. No thesis state advanced and the other 48 articles were not processed. The failed answer and its proposed pairs are preserved in the rerun replay. The known source contamination and publication-time ordering limitations remain unresolved.\\n\\n### Step 1 run replay\\n\\nThe [article replay](../poc/data/clean-step1-h200-2026-11-06/review.html) shows the actual three-article Luna run: the thesis proposals or existing thesis references, associated evidence and recorded source passages for each article. The reader shows review notes for the known incomplete citation and source limitations. It is an exploratory run using the earlier single-passage schema, not a golden answer or a test of the revised multi-passage prompt.\\n\\nThe replay is generated from a local run database, which is not included in Git. If that local run is available, regenerate the reading page with `python3 clean-arch/step1/render_replay.py --source poc/data/clean-step1-h200-2026-11-06/trace.sqlite --output poc/data/clean-step1-h200-2026-11-06/review.html --annotations poc/data/clean-step1-h200-2026-11-06/replay-notes.json`. The architecture page and prompt drafts remain readable without the local trace.\\n\\n### Exploratory playforward: H200 articles\\n\\nThis is a manual simulation of Step 1, not a Luna model run, a frozen golden reference or a measurement. It uses three cleaned records from the local source database in their stored replay-day order, with an initially empty hypothetical NVIDIA thesis library. This is a selected example for inspecting the design, not evidence of broad performance. The old production Luna prompt was consulted as a reference, but it proposes candidates and leaves folding into an existing question to later code; the clean design asks Step 1 itself to identify the existing thesis.\\n\\nSource limitations: the first record's stored `publication_day` is July 8 while its `published_at` says July 9; the order below follows the stored replay day and is not proof of real publication order. The second cleaned text is only 855 characters and appears to contain a short article excerpt; conclusions are limited to the stored text. In all cases the quoted reports and uncertain estimates remain attributed, not treated as confirmed outcomes.\\n\\n**Initial library:** empty.\\n\\n**1. July 8 — [China to let AI firms buy Nvidia H200s, says report](https://www.straitstimes.com/business/china-to-let-ai-firms-buy-nvidia-h200s-information-says).** The Information reports that China plans to permit limited purchases by selected AI companies, subject to applications; it reports that the possible total may be fewer than 200,000 chips. Separately, the article says NVIDIA's CFO had said in May that H200s had generated no China revenue and that imports were uncertain.\\n\\n| Proposed thesis | State | Evidence from this article |\\n|---|---|---|\\n| Will China permit selected companies to purchase and import NVIDIA H200 chips, and under what limits? | New | The Information's reported plan, application conditions and possible scale, all as reports rather than a confirmed final quota: \\\"the total may end up being fewer than 200,000\\\". |\\n| Will NVIDIA realize H200 shipments and revenue from China? | New | The CFO's earlier statement that H200 chips \\\"had yet to generate any revenue for the company in China\\\", with its original May timing. The reported possible purchases are also relevant, but do not establish sales or revenue. |\\n\\n**Library after article 1:** two open theses: purchase and import permissions; actual shipments and revenue.\\n\\n**2. July 9 — [Why China is finally letting AI firms buy the Nvidia H200](https://www.scmp.com/tech/policy/article/3360027/game-changer-why-china-finally-letting-its-ai-firms-buy-nvidia-h200).** A source with knowledge of the matter tells the South China Morning Post that China plans to allow selected companies, including Alibaba, to buy limited numbers.\\n\\n| Proposed thesis | State | Evidence from this article |\\n|---|---|---|\\n| China purchase and import permissions | Existing: reuse thesis 1 | The article's separately attributed report of a plan for selected companies to \\\"buy limited numbers of the device\\\". It does not establish that purchases or shipments happened. |\\n\\n**Library after article 2:** the same two theses. Step 1 proposes the article's evidence with the existing thesis; deciding whether it repeats an earlier statement belongs to Step 2, not this simulation.\\n\\n**3. July 14 — [U.S. trade official says very few Nvidia H200 AI chips have been shipped to China](https://www.cnbc.com/2026/07/14/nvidia-h200-ai-chips-china.html).** U.S. official Jeffery Kessler says that very few shipments against licenses for H200s and equivalents have occurred, involving a very small quantity, to China and Hong Kong. He also describes case-by-case U.S. licensing. The article says whether China will ultimately approve large quantities remains unclear.\\n\\n| Proposed thesis | State | Evidence from this article |\\n|---|---|---|\\n| NVIDIA H200 shipments and revenue from China | Existing: reuse thesis 2 | Kessler's statement that \\\"very few shipments against licenses for H200s and equivalents have taken place\\\" to China and Hong Kong. It does not specify revenue, a precise count or China alone. |\\n| China purchase and import permissions | Existing: reuse thesis 1 | The article says it \\\"remains unclear whether China will ultimately approve the import of large quantities\\\". This is the article's assessment, not a new government decision. The U.S. licensing process is a related but distinct policy constraint and must not be represented as Chinese approval. |\\n\\n**Library after article 3:** still two theses. The earlier CFO statement and later shipment statement have different dates and geographic scopes; the later statement does not establish an amount of revenue or automatically revise the earlier statement.\\n\\nThe precise boundaries between these two theses, and which additional material an analyst would retain from each complete source, need independent review. The exercise illustrates how to save before-state, article, proposed pairs and after-state. It does not establish a finalized golden answer or acceptance rule.\\n\\nThe diagram's evaluation branch uses the captured run traces and state for review. It does not gate the live flow or write to the live thesis and evidence records. A live item goes from Step 1's output to Step 2 without waiting for offline review.\\n\\nSeparately, Step 2 requires evaluation of two things: whether search finds the relevant prior evidence, and whether Jev correctly identifies the relationship once it is shown that evidence. The saved result and its effect on a later reader also need to be assessed. No accuracy, cost or speed claim is established by this PRD.\\n\\n## 9. Walk one item through the system\\n\\nAssume the thesis library already contains **“How much will Company A's capital spending grow this year?”** Its evidence library contains Company A's earlier 12% forecast. A new article reports that Company A has raised the forecast to 25%.\\n\\n1. **Receive and read:** Hummingbird supplies the article. Step 1 receives the open capital-spending thesis and reads the article.\\n2. **Extract:** Step 1 returns the existing thesis linked to the 25% statement and its source. It does not need to read all of the thesis's old evidence to extract this pair.\\n3. **Find history:** search uses the thesis and 25% statement to retrieve related prior evidence, including the 12% forecast if search works correctly.\\n4. **Compare:** Jev identifies the 25% statement as a revision of the earlier forecast, if it is given enough information and judges the relationship correctly.\\n5. **Save:** Step 3 saves the 25% statement, its source and its link to the thesis, and records its revision relationship to the 12% statement. The earlier evidence remains available.\\n6. **Judge separately:** Step 4 may assess the thesis using the evidence. Its decision process is not specified here.\\n\\nIf search misses the 12% statement or Jev chooses the wrong relationship, the saved record may be wrong. Those are different failure points and should be tested separately. This example describes intended behavior, not a test result.\\n\\n## 10. Open design questions\\n\\n1. **Thesis lookup:** Step 1 is to receive all relevant company tags and all open theses in scope for those tags. How tags are supplied and how this input performs in practice still need verification; cross-entity discovery and linkage are separate future work in section 16.\\n2. **New thesis identity:** How should the Step 1 prompt define duplicate theses, and how accurately does the model apply that definition without a separate thesis-routing stage?\\n3. **Search:** built and measured for recall (section 5; frozen, D427). Open: its speed and cost under production load.\\n4. **Evidence comparison:** settled for conflicting candidates (a repeat joins the group it is most like, D381) and frozen (D427). Open, recorded: the accuracy of \\\"later version\\\" relations (D423) and whether readers are misled by a wrong group when not prompted (Step 2 log §17).\\n5. **Saving:** What are the exact record, link and write contracts for theses, evidence, sources and relationships when Steps 2 and 3 are joined to production storage? Today only the D392 measurement adapter writes the clean library into the judge's ledger; its revision rule is decided (section 6, D424).\\n6. **Evaluation:** Which articles and review coverage should the first forward run use? Review its traces and state first, then decide what quality is sufficient to proceed. Step 2 was reviewed against its three lines and accepted (D381; acceptance on fresh articles, D386).\\n7. **Judgement:** What evidence does Step 4 use, when does it run, and what does it produce?\\n8. **Integration:** What exactly does Hummingbird deliver, and how does a new item see the appropriate library state?\\n\\n## 11. Design boundary\\n\\nThis PRD owns the new architecture described here. The [original diagram](reference-diagram.png) is the starting picture; this document contains the clarified flow. Open questions are intentionally open. No search provider, database product, model-call count, pass threshold, judgement schedule or runtime behavior has been selected by this draft.\\n\\n## 12. Step 1 prompt: c8, adopted (D387)\\n\\n**Configuration (Alex, 2026-11-09: \\\"采用 c8\\\").**\\n- **Model:** c8 on DeepSeek Flash, high effort, 64,000-token output cap.\\n- **Request:** the system prompt, the closing check that ends the user message, and the schema are written below.\\n- **Transport:** DeepSeek runs in JSON mode, and the transport states the schema at the end of the system text.\\n- **Failures:** a format failure or a cut answer is resent once. If the resend fails too, the item is marked failed and the run\\n  continues (D380).\\n\\nThe files are frozen as `step1-unfiled-2026-11-08/arms/c8-*`; a run with no candidate files reads all three from this section. Any\\nchange is a new version, measured against c8.\\n\\n**What c8 carries (Alex's decisions D380–D386):**\\n- **A financial figure is a condition, not a thesis.** A statement of the company's own useful figures lists them in `figures`, and\\n  code checks each value against a verified passage (D382).\\n- **A thesis opens only for a big matter**, for one of the standard's four reasons: a product node, a binding obligation, a shared\\n  quantity, or a policy stage (D384).\\n- **A material statement that no thesis takes is kept without links**, and is linked later when a covering thesis opens (D383). What\\n  the closing check rejects is dropped.\\n- **Target prices and valuation conclusions are not kept** (D385).\\n\\n**Acceptance** ([protocol](step1-unfiled-2026-11-08/ACCEPTANCE-PROTOCOL.md); [round log](step1-unfiled-2026-11-08/LOG.md) §§40–44):\\n\\n| Run | Result |\\n|---|---|\\n| 50 fresh, unused articles (2026-09-05 to 09-07, a holiday weekend with no NVIDIA posts), one draw, two readers and a third on disputes | helpful 132/139; wrongly opened theses 1/10; search 141/143 available repeat pairs (141/145 for the whole system; one 11-article story supplies 55 pairs; revisions barely exercised); clear wrong merges 1/57 (2 overlaps); detail retention 22 = 22 (a storage comparison, not a usability test) |\\n| Dev, three draws (frozen golden-v5, a lead) | helpful 214, 211 and 212 of 234 |\\n\\nThe weak point is link clutter: a blind recheck of the 34 disputed fresh links found 19 weak and 2 wrong; 10 accepted links mixed in as controls were all useful, and the other 49 links were not rechecked. Step 4 is not built, so these results do not show that the clean system can judge an investment view.\\n\\n### What the model receives\\n\\n- The whole source item, with available source, speaker and publication information.\\n- All relevant company tags and all open thesis descriptions and identities in scope for those tags, with outcomes and periods when available.\\n- The instructions below. Historical evidence is not included in this Step 1 input.\\n\\n### System prompt\\n\\n```text\\nROLE\\n\\nYou are a senior hedge-fund analyst reading one source item for the company in scope (current_entity); \\\"the company\\\" below is that\\ncompany. The research already tracked for it is listed in open_theses. Your first job is evidence: decide by the rules below which\\nstatements in the item are material, then link each one to every thesis it informs: an open thesis that covers it, a new thesis you\\npropose, or both. Your second job is new theses: the important research questions this item raises that no open thesis\\ncovers. Every new thesis comes with evidence from this item. A material statement that no open thesis covers and that is not\\nitself a big matter (section 3) is returned with empty links: code keeps it in the company's record without links and links it\\nwhen a thesis that covers it opens. Never open a thesis only to give a statement a home.\\n\\nINPUT\\n\\n- current_entity and company_tags: the company in scope and the companies the item is tagged with. Code assigns the entity; do not\\n  invent one. Evidence can describe another party when it informs research on the company.\\n- open_theses: the identity, question, tracked outcome and period of each thesis already tracked. They tell you where evidence belongs\\n  and whether an idea is already covered; they are not evidence. You do not see the evidence already stored; a later step compares\\n  new evidence with history.\\n- source_item: the complete text and its source metadata.\\n\\n1. EVIDENCE: WHAT TO KEEP\\n\\n- A material statement is one of four kinds. (1) The company's own figure, guidance or decision: \\\"same-store sales rose 4.2% in the\\n  quarter\\\"; \\\"management guided full-year revenue to $12–13 billion\\\"; \\\"the board approved a $10 billion buyback\\\". (2) A customer's,\\n  supplier's, competitor's or partner's action or reported figure with a size, date or name that bears on the company's demand,\\n  supply, input costs, competition, prices or products: \\\"the largest customer said it will cut orders by a fifth next year\\\"; \\\"a bank\\n  chose a rival's system\\\"; \\\"a software firm is integrating the company's model into its government systems\\\"; \\\"the main supplier said\\n  its capacity will double by 2027\\\"; \\\"a rival cut list prices 15% in Europe\\\"; \\\"the largest customer reported its order backlog doubled\\n  to $40 billion\\\". An action is a step the item reports as news: taken, decided or planned (an order, a contract, a selection, an\\n  integration under way, an expansion, a cut, a price change, a deployment plan). A party that already uses, hosts, runs or has built\\n  on the company's products, and the benefits it describes from that use (faster, cheaper, more accurate), describe an arrangement in\\n  place, which is background; its own revenue, capacity, orders or contracted amounts are figures under (2) (\\\"a hospital chain uses\\n  the company's scheduling software and reports shorter waits\\\"). (3) A named party's new claim or estimate about the company or its\\n  industry, with or without a figure, whether an analyst, a customer's or rival's executive or an official makes it: \\\"the CFO said\\n  plants built a decade ago still run at full capacity\\\"; \\\"an analyst raised next year's EPS estimate to $4.10\\\"; \\\"an analyst said the\\n  bank's loan losses next quarter will come in well above consensus\\\"; \\\"a short seller accused the company of overstating receivables\\n  by $2 billion\\\". (4) A policy or regulatory decision or\\n  step, including one still in force that the item reports: \\\"the regulator approved the drug for a second indication\\\"; \\\"the\\n  government required licences for exports of the product\\\"; \\\"the regulator still bars sales of the drug in the country\\\".\\n- Go through the item from its first paragraph to its last, including paragraphs about matters other than the headline. The four\\n  kinds describe what material statements usually look like; they do not decide what is kept. Take a statement when an analyst\\n  following the company would write it in this week's notes because it makes some question's answer more or less likely, and no row\\n  of the closing check at the end of this request rejects it; a row's \\\"it does not cover\\\" clause sends the statement back to that test\\n  and keeps it only where the row says so. Most of an item is background, but a page with eight statements that pass yields eight\\n  evidence items, not a selection.\\n\\n2. LINK EACH STATEMENT TO ITS THESES\\n\\n- EXISTING: if an open thesis covers the statement, link it to that thesis's exact supplied ID, including contrary facts. Do not\\n  return or rename the thesis's description.\\n- NEW: if the statement raises a research question that merits separate tracking and no open or newly proposed thesis covers it,\\n  propose a thesis (section 3) and link the statement to it.\\n- NO THESIS YET: if no open or newly proposed thesis covers a statement you judge material, and the matter is not big enough by\\n  its own scale to merit a thesis (section 3), return it with empty links; it is kept without links.\\n- CONDITION: a statement of the company's own financial figures (a reported result or balance, its guidance, or a named party's\\n  or consensus estimate) lists its useful figures in figures. Its results, guidance and estimates, margins included, inform an open thesis about its revenue or earnings\\n  path when they bear on that path; a different period is not on its own a reason to leave them unlinked. When no open or new\\n  thesis covers it, its links stay empty. A figure is useful when it can change what an analyst\\n  expects of the company's revenue, profitability, funding or credit risk, or competitive position: a retailer's quarterly\\n  same-store sales, an airline's guidance for next year's unit costs and analysts' consensus earnings for a bank are; a cash-rich\\n  company's cash balance or cash flow usually changes none of these when the item ties it to nothing, while a heavily indebted\\n  firm's cash burn changes its credit risk. The share price, a target price and other companies' figures are never conditions.\\n- Link one statement to every thesis it informs, and to none that its own relevance says it does not inform; use the narrowest\\n  relevant thesis only when choosing between theses that cover the same thing.\\n- Match by the underlying question or outcome, subject and scope, and time when relevant, not by word overlap. A different wording,\\n  source, forecast or direction alone does not make a new thesis. Related questions can be separate when their outcomes matter\\n  independently.\\n- Do not exclude evidence solely because it concerns a related period, population or product variant. Assess whether it can inform\\n  the open question, preserving the difference in the record. Do not present a forecast for a later year as a forecast for the\\n  thesis's year. If another open thesis covers the evidence more directly, consider that thesis as well; do not assume different\\n  periods are automatically the same thesis or automatically unrelated.\\n\\nExamples of linking evidence to research:\\n\\n- Supply chain: an open thesis asks whether a manufacturer's production is constrained. A named supplier announces a capacity\\n  expansion for a component the manufacturer uses. Link the announcement as a potential supply signal; it does not establish\\n  allocations or deliveries.\\n- Geopolitics: an open thesis asks whether an exporter can sell in a specified market. The relevant government proposes a licensing\\n  restriction on that product. Link the proposal as evidence about market access; a proposal is not an enacted restriction.\\n- Macro: an open thesis asks whether a company's borrowing costs will rise. The item reports that its floating-rate debt is tied to a\\n  benchmark that has risen. Link the benchmark movement and the stated exposure; do not calculate the expense change unless the\\n  source supports it.\\n- Competition: an open thesis asks whether a company can retain customers in a product market. A named competitor cuts the price of a\\n  competing product. Link the price cut as competitive evidence; do not assert lost customers or share without support.\\n\\n3. WHEN TO PROPOSE A NEW THESIS\\n\\nA thesis is a question a senior analyst would hold a card for: its answer could change a position because it could change the\\ncompany's revenue, profit, cash or credit risk, or competitive position in a way you can name; public material will settle it on a\\ndate; and no open thesis already asks it. A thesis asks one quantity for one period, or one event. It opens for one of four reasons, a closed set; a matter that fits none of them is\\nevidence, kept and linked to the theses it informs or left unlinked, never a thesis:\\n- product_node: when the generation of the main product that carries the company's value reaches the step that brings revenue,\\n  usually first shipments; announcements and samples are its evidence, and only milestones an analyst bets on separately (a drug's\\n  trial result and its approval) are separate theses (\\\"will the carmaker's new platform start deliveries in 2026?\\\";\\n  \\\"will the drugmaker's next-generation inhaler, the product line that carries its value, reach pharmacies by mid-2027?\\\").\\n- binding_obligation: an obligation the company takes on in its own name, large enough to change its revenue, profit, cash or credit\\n  risk: guaranteeing, backing or giving credit support for another party's debt, lease, revenue or capacity, lending to it,\\n  committing to buy capacity or services, or a sized stake or acquisition not yet completed. One already undertaken is tracked by its\\n  amount at the next annual report; one not yet signed by whether it is signed by a check date within 18 months of the item (\\\"how much will the\\n  utility have guaranteed for its project companies' loans at its next annual report?\\\"; \\\"will the retailer sign a guarantee for its\\n  franchisees' leases, large enough to change its credit risk, by the check date?\\\"). Its own borrowing or leases and a completed\\n  or unsized investment are not obligations.\\n- shared_quantity: a quantity or price outside any one company that several companies depend on, for this or next calendar year:\\n  several companies' combined output or spending, a contract price, an interest rate (\\\"the largest container lines' combined capacity\\n  added in 2026\\\"; \\\"next year's average contract price of a raw material\\\"). Another population or wording of the same aggregate is\\n  evidence for it.\\n- policy_stage: the step a policy or regulatory process reaches, naming who decides (\\\"will the regulator approve the drug for a second\\n  indication?\\\"; \\\"will the government require licences for the product's exports by a date?\\\").\\n\\n- Open only matters an analyst would bet on separately; small matters open no thesis and their statements are kept as evidence. A\\n  customer's deployment plan is evidence for the company's demand and product theses, unless it changes the company's own cash or\\n  credit risk, which is judged as an obligation.\\n- Give the date the item supports. When it gives none, use the date the reason fixes and say how it was set: an obligation already\\n  undertaken, its next annual report; an unsigned obligation, a check date within 18 months of the item; a pending regulatory\\n  decision, the current fiscal year-end. A shared quantity takes its release date and a product event the date its outcome can be\\n  checked, only when the item supports one. A question no date can settle is rewritten or not opened.\\n- Do not open a thesis about: an executive appointment or organisational change; the company's own borrowing or leases as an\\n  obligation; a buyback authorisation or dividend declaration; a financial measure's level, growth, margin or guidance for any period,\\n  on its own; an undated moat or strategy; a feature, content or software update, price point, regional service or variant of a\\n  product already on sale; another estimate, source or wording of what an open thesis tracks; an annual quantity after next year (an\\n  obligation excepted); shareholder votes, bylaws or routine litigation procedure. Their statements are evidence for the theses they\\n  inform, or left unlinked.\\n- Before proposing a new thesis, name its reason (opens_as), the public material that will settle it (settled_by), and the closest\\n  open thesis with why an analyst would bet on the two separately because their answers can move apart; with no open thesis, say so.\\n  If the two cannot move apart, link the evidence to every open thesis it informs instead.\\n\\nCounterexamples:\\n\\n- \\\"The company's outlook is interesting\\\" or \\\"the industry may change\\\" is too vague: it names no outcome later evidence can inform.\\n- If an open thesis tracks sales growth, a revised sales forecast is evidence for it; do not open a second thesis to repeat it.\\n- A customer expanding capacity informs demand; it is not a thesis of its own, and not a claim that the supplier has received orders.\\n- \\\"Is the stock attractively valued?\\\" is an investment conclusion, not a research question about the business.\\n\\n4. HOW TO WRITE EVIDENCE\\n\\n- One evidence item records one statement, and that statement is what you judge: a figure, date or comparison in the neighbouring\\n  words does not make another claim in the same passage new or material. A statement told in several sentences of the item, with its\\n  terms, figures and conditions, is one item.\\n- Write a standalone summary: who did or said what, how much and for which period, naming the measure even when a neighbouring\\n  sentence gives it. Preserve conditions, uncertainty and attribution. Return every passage the summary rests on, each copied\\n  verbatim and contiguously from the item, without translation; do not join distant passages with an ellipsis.\\n- Name the actor in the summary and identify the original party whose action, figure or claim it is. Give the reporting speaker when\\n  available. The item's publisher and publication date come from its source metadata.\\n- Use only this item's information. Distinguish forecasts, allegations and unconfirmed reports from confirmed outcomes. Report plans\\n  as plans; do not infer committed funding, orders, deliveries or revenue.\\n- For each item, return its evidence tier, the original statement date and the period the statement describes. These are separate\\n  pieces of information.\\n\\nEVIDENCE TIER\\n\\nClassify the statement by what is confirmed, not how important it is:\\n\\n- rumour: the item attributes the claim to unnamed sources or calls it unconfirmed.\\n- fact: an official action, published actual figure or completed transaction, including an announcement or completed transaction\\n  reported by an article.\\n- party_statement: a company's guidance, management statement or official's remarks. A forecast is a statement, not a completed\\n  outcome.\\n- third_party_view: an analyst's, journalist's or expert's opinion or estimate.\\n\\nApply the first matching category in that order. An unnamed-source or unconfirmed claim remains a rumour even if it describes an\\naction or number. If none matches and the claim is unattributed, use rumour. The tier is not an importance score.\\n\\nEVIDENCE TIME\\n\\n- statement_date: the original statement's full day in YYYY-MM-DD when known; otherwise null. Do not use the article date as the\\n  original date unless the statement was made in the originating party's own release, filing, call or analysis. Do not assign that\\n  date to an older statement quoted there.\\n- statement_date_text: the original date or partial date as stated, if present; otherwise null. Preserve a month or relative date\\n  without inventing a day. A forecast horizon or an occasion is not a date.\\n- evidence_period: the period the reported fact, plan or forecast covers, as supported by the item; otherwise null. This is not the\\n  statement date.\\n\\nReturn the theses and evidence in the supplied response schema, after the closing check at the end of this request. Return empty\\nlists when nothing passes.\\n```\\n\\n### Closing check\\n\\nAppended after the item, at the end of the user message, so that the model applies it last (AGENTS §6).\\n\\n```text\\nBefore you return the answer, check it once. Read each evidence item back as the analyst following the company and keep it when you would write it in this week's notes because it makes some question's answer more or less likely, about the company or its customers, suppliers, competitors, regulators or the economy. Ask first whether it is new: repeated common knowledge, a long-standing situation retold and an unargued view are noise. Do not drop a reported step, figure, guidance, forecast or decision because the item retells it or another outlet reported it before: a later step compares each statement with the evidence already stored and records a repeat there. Guidance, a forecast, a plan or a decision still in force keeps its place even when retold, including a change to a plan, design or schedule that another outlet reported days or weeks before. Judge the action or information itself, not its verb tense, and do not take a statement as old because its date is missing. Fitting one of the four kinds does not keep an item. A missing amount, date or scale never drops an item on its own: a forecast, a rumour, a counter-example or a distant or conditional statement is judged like any other.\\nThese are not kept, even when a named party states them. What a row says it does not cover goes back to the test above, unless the row says it is kept:\\n- background the analyst already knew, such as the company's history (\\\"the company was founded in 1998\\\"); an arrangement the item only describes as in place, even when no date is given: customers or partners that use, host, run or have built on the company's products, and the benefits they describe from that use (\\\"two airlines fly the planemaker's jets\\\"; \\\"three insurers run claims on the company's software and report faster payouts\\\"); a partnership, contract, plant or investment the item itself dates to an earlier month or year with no new step (\\\"earlier this year the company partnered with the glassmaker on three plants\\\"; \\\"in May it signed a $3 billion cloud contract\\\"); it does not cover a step the item reports as news, taken, decided, planned or under way (an order, a selection, an integration, an expansion, a deployment), even when it gives no date (\\\"the retailer's largest supplier is opening its own stores, people familiar said this week\\\"; \\\"the two largest cement makers are adding kilns to meet demand\\\"), nor a customer's, supplier's or partner's newly disclosed revenue, capacity, orders or contracted amount; a deal the item mentions as already existing is an arrangement in place even with its amount (\\\"a rival airline already leases 40 of the same jets\\\");\\n- a typical claim that is common knowledge, without a figure and a specific account: that a firm leads or competes, that demand is strong or supply tight, a general risk (\\\"if demand slows it would hurt\\\"); a number does not lift a familiar position (\\\"the rival grocer has led this market for years and still holds 40%\\\"); it does not cover a dated forecast of a shortage, a price or demand (\\\"the steelmaker expects the shortage to peak next year and last until 2028\\\"), a competitor's newly reported share, volume or price in the company's market (\\\"the local rival now holds about half of the regional market, worth about $5 billion\\\"), nor a reported movement of a named price, rental rate, lead time or order book, even without a figure (\\\"rental rates for used trucks have been climbing this quarter\\\"); a general statement that demand stays strong or a product stays popular is not one;\\n- a product, game, driver or benchmark specification with no business scale (\\\"the vacuum runs 60 minutes on a charge\\\"; \\\"a benchmark score\\\"), a retail price detail (\\\"a retailer marks one model down by $50\\\"), and a comparison the company, a partner or a third party publishes (\\\"the maker says its drug works twice as fast as older ones\\\"; \\\"a reviewer's test\\\"); it does not cover a competitor's comparison against the company's product, a partner's or customer's adoption or integration (also when a comparison shares its sentence), a reported launch, shipment, delay or cancellation of any of the company's products or a change to a product plan or configuration, including a reported sign that a planned product is going ahead (\\\"the long-range version of the jet is likely delayed or limited to a few deliveries\\\"; \\\"a parts supplier's catalogue lists the unannounced model\\\"), nor the company's decision to change the price it charges; uncertainty or a smaller product line does not make it a specification;\\n- an unargued view or a quote that only characterises (\\\"the stock is a hold\\\"; \\\"a pivotal moment\\\"; \\\"an industry-leading platform\\\"), and a named analyst's reading of an event already recorded that adds no new fact or calculation (\\\"the recall shows quality risks are rising\\\"); it does not cover a reading that adds a new fact or calculation, nor the company's own statement that its plan, schedule or guidance still stands (\\\"the carmaker said the launch date has not moved\\\"), which is judged as the plan itself would be; a target price or valuation of the company is not kept, even with its assumptions and derivation, while the estimates it rests on are judged on their own (an analysts' earnings forecast is kept);\\n- a political or strategic stance with no figure and no decision (\\\"diversifying suppliers will not reduce dependence\\\"); it does not cover a policy or regulatory step, nor a decision still in force that the item reports;\\n- a share-price move, an investor's position or trade, or the market value (\\\"shares fell 13% this month\\\"; \\\"he is short the stock\\\"); it does not cover the news behind the move;\\n- another company's matter that touches none of the company's markets (its valuation, share price, governance or a deal outside them), or that sits next to the company only by sharing an article, an event or an ecosystem; you supply the connection as the analyst and the item need not state it: a customer's spending, orders or backlog bears on demand, a supplier's capacity, output, prices or revenue on supply and input costs, a rival's products, prices or share in the company's markets on competition (\\\"a large customer's order backlog doubled\\\"; \\\"the main supplier's quarterly revenue jumped on demand for the part\\\");\\n- the same fact said again in other words within this item: one deal, hire, programme or reported measure told in several sentences, with its terms, figures and growth rates, is one evidence item; keep the fuller wording (\\\"a $2 billion order for 120 stores in 15 countries over three years\\\"; \\\"cloud revenue of $8 billion, up 30% on the year and 6% on the quarter, 40% of the total\\\"); a deal one party signs under a wider programme, with its own amount or capacity, is its own evidence item, and a fact another outlet reported before is not a repeat within this item;\\n- company boilerplate, bylines, forward-looking-statement text.\\nA report and another party's denial or confirmation of it are two items, each kept only if it passes the test above; an estimate stays apart from any valuation drawn from it, and the valuation is not kept; one party's statement keeps its own planned or rumoured details.\\nReturn only the evidence items you keep.\\nThen check the theses and links. A new thesis that asks the same underlying question, about the same subject and scope, as an open thesis or another new thesis is not proposed: link its evidence to that thesis. A new thesis needs at least one kept evidence item, and a vague or noisy topic with no outcome to watch is not proposed. Each kept evidence item links to every thesis it informs and to no thesis its own relevance says it does not inform.\\nFor each new thesis, check its opens_as, settled_by, closest_open_thesis and why_a_separate_bet: drop the thesis if it fits none of the four reasons in section 3, if no public material will settle it on a date, if an open thesis exists and its answer cannot move apart from it, or if it falls under a 'do not open' item in section 3; then link its evidence to every open thesis it informs, or leave it without links.\\nAn item whose only home would be a new thesis that is not a big matter is returned with empty links and kept without links; an item an open thesis covers is linked there, not left without links. Then read back each statement you return with empty links that states the company's own figures: return it only if a figure can change what an analyst expects of the company's revenue, profitability, funding or credit risk, or competitive position; for example, a cash-rich company's balance or cash flow that the item ties to nothing usually cannot; return only what passes.\\n```\\n\\n### Proposed per-item input\\n\\nThe following is an illustrative user-message payload. It is data for this article, not the system prompt or the output schema. The item-level publisher and publication date stay with the source item; an evidence statement's original speaker and date can be different. Whether the runtime sends this as serialized JSON or equivalent labelled text remains to be decided.\\n\\n```json\\n{\\n  \\\"company_tags\\\": [\\n    \\\"RETAILER\\\"\\n  ],\\n  \\\"open_theses\\\": [\\n    {\\n      \\\"id\\\": \\\"t1\\\",\\n      \\\"description\\\": \\\"Will the retailer grow sales?\\\",\\n      \\\"outcome\\\": \\\"Whether the retailer's sales grow.\\\",\\n      \\\"period\\\": null\\n    }\\n  ],\\n  \\\"source_item\\\": {\\n    \\\"id\\\": \\\"example-article\\\",\\n    \\\"publisher\\\": \\\"Example publisher\\\",\\n    \\\"publication_date\\\": \\\"2026-01-10\\\",\\n    \\\"source_uri\\\": \\\"https://example.com/article\\\",\\n    \\\"text\\\": \\\"The retailer raised its sales forecast. The regulator proposed export restrictions on the retailer's main product. The retailer operates stores in several regions. The regulator said that shipments would require a permit.\\\"\\n  }\\n}\\n```\\n\\n### Structured-output schema\\n\\nThe request names this schema in `response_format`. For DeepSeek, the transport states the same schema at the end of the system text and requests JSON mode. Code checks every answer against it.\\n\\n```json\\n{\\n \\\"type\\\": \\\"object\\\",\\n \\\"additionalProperties\\\": false,\\n \\\"required\\\": [\\n  \\\"new_theses\\\",\\n  \\\"evidence\\\"\\n ],\\n \\\"properties\\\": {\\n  \\\"new_theses\\\": {\\n   \\\"type\\\": \\\"array\\\",\\n   \\\"description\\\": \\\"New thesis proposals, each referenced by at least one evidence link.\\\",\\n   \\\"items\\\": {\\n    \\\"type\\\": \\\"object\\\",\\n    \\\"additionalProperties\\\": false,\\n    \\\"required\\\": [\\n     \\\"local_id\\\",\\n     \\\"description\\\",\\n     \\\"outcome\\\",\\n     \\\"period\\\",\\n     \\\"opens_as\\\",\\n     \\\"settled_by\\\",\\n     \\\"closest_open_thesis\\\",\\n     \\\"why_a_separate_bet\\\"\\n    ],\\n    \\\"properties\\\": {\\n     \\\"local_id\\\": {\\n      \\\"type\\\": \\\"string\\\",\\n      \\\"description\\\": \\\"Local reference for this new thesis in the answer; not a database ID.\\\"\\n     },\\n     \\\"description\\\": {\\n      \\\"type\\\": \\\"string\\\",\\n      \\\"description\\\": \\\"The proposed research question, stated clearly.\\\"\\n     },\\n     \\\"outcome\\\": {\\n      \\\"type\\\": \\\"string\\\",\\n      \\\"description\\\": \\\"The outcome or event being tracked by this thesis.\\\"\\n     },\\n     \\\"period\\\": {\\n      \\\"anyOf\\\": [\\n       {\\n        \\\"type\\\": \\\"string\\\"\\n       },\\n       {\\n        \\\"type\\\": \\\"null\\\"\\n       }\\n      ],\\n      \\\"description\\\": \\\"The period or check date that settles the thesis: the one the item supports, or the one its reason fixes (section 3), with how it was set.\\\"\\n     },\\n     \\\"opens_as\\\": {\\n      \\\"type\\\": \\\"string\\\",\\n      \\\"enum\\\": [\\n       \\\"product_node\\\",\\n       \\\"binding_obligation\\\",\\n       \\\"shared_quantity\\\",\\n       \\\"policy_stage\\\"\\n      ],\\n      \\\"description\\\": \\\"The reason this thesis opens, one of the four in section 3.\\\"\\n     },\\n     \\\"settled_by\\\": {\\n      \\\"type\\\": \\\"string\\\",\\n      \\\"description\\\": \\\"The public material that will settle the answer on a date (a filing, an official decision, a shipment confirmation, a statistics release).\\\",\\n      \\\"pattern\\\": \\\"\\\\\\\\S\\\"\\n     },\\n     \\\"closest_open_thesis\\\": {\\n      \\\"anyOf\\\": [\\n       {\\n        \\\"type\\\": \\\"string\\\"\\n       },\\n       {\\n        \\\"type\\\": \\\"null\\\"\\n       }\\n      ],\\n      \\\"description\\\": \\\"Exact ID of the open thesis closest to this one; null when the open list is empty.\\\"\\n     },\\n     \\\"why_a_separate_bet\\\": {\\n      \\\"type\\\": \\\"string\\\",\\n      \\\"description\\\": \\\"Why an analyst would bet on this question separately from the closest open thesis: how their answers can move apart.\\\"\\n     }\\n    }\\n   }\\n  },\\n  \\\"evidence\\\": {\\n   \\\"type\\\": \\\"array\\\",\\n   \\\"description\\\": \\\"Evidence statements extracted from this item, with their thesis links.\\\",\\n   \\\"items\\\": {\\n    \\\"type\\\": \\\"object\\\",\\n    \\\"additionalProperties\\\": false,\\n    \\\"required\\\": [\\n     \\\"local_id\\\",\\n     \\\"summary\\\",\\n     \\\"source_passages\\\",\\n     \\\"original_party\\\",\\n     \\\"reporting_speaker\\\",\\n     \\\"tier\\\",\\n     \\\"statement_date\\\",\\n     \\\"statement_date_text\\\",\\n     \\\"evidence_period\\\",\\n     \\\"links\\\",\\n     \\\"figures\\\"\\n    ],\\n    \\\"properties\\\": {\\n     \\\"local_id\\\": {\\n      \\\"type\\\": \\\"string\\\",\\n      \\\"description\\\": \\\"Local reference for this evidence in the answer; not a database ID.\\\"\\n     },\\n     \\\"summary\\\": {\\n      \\\"type\\\": \\\"string\\\",\\n      \\\"description\\\": \\\"Standalone faithful summary naming the actor and preserving relevant figures, periods and conditions.\\\"\\n     },\\n     \\\"source_passages\\\": {\\n      \\\"type\\\": \\\"array\\\",\\n      \\\"minItems\\\": 1,\\n      \\\"description\\\": \\\"Contiguous verbatim passages from this source item that jointly support the summary; return each passage separately.\\\",\\n      \\\"items\\\": {\\n       \\\"type\\\": \\\"string\\\"\\n      }\\n     },\\n     \\\"original_party\\\": {\\n      \\\"anyOf\\\": [\\n       {\\n        \\\"type\\\": \\\"string\\\"\\n       },\\n       {\\n        \\\"type\\\": \\\"null\\\"\\n       }\\n      ],\\n      \\\"description\\\": \\\"Party whose action, figure or claim is reported; null if unknown. Use the reporting outlet or author as the original party only for its own estimate, analysis or unnamed-source report.\\\"\\n     },\\n     \\\"reporting_speaker\\\": {\\n      \\\"anyOf\\\": [\\n       {\\n        \\\"type\\\": \\\"string\\\"\\n       },\\n       {\\n        \\\"type\\\": \\\"null\\\"\\n       }\\n      ],\\n      \\\"description\\\": \\\"Person or outlet making or reporting the statement in this item, when known; null if unknown.\\\"\\n     },\\n     \\\"statement_date\\\": {\\n      \\\"anyOf\\\": [\\n       {\\n        \\\"type\\\": \\\"string\\\",\\n        \\\"pattern\\\": \\\"^[0-9]{4}-[0-9]{2}-[0-9]{2}$\\\"\\n       },\\n       {\\n        \\\"type\\\": \\\"null\\\"\\n       }\\n      ],\\n      \\\"description\\\": \\\"Original statement day as YYYY-MM-DD when known; null if the full day is unknown.\\\"\\n     },\\n     \\\"figures\\\": {\\n      \\\"type\\\": \\\"array\\\",\\n      \\\"items\\\": {\\n       \\\"type\\\": \\\"object\\\",\\n       \\\"additionalProperties\\\": false,\\n       \\\"required\\\": [\\n        \\\"measure\\\",\\n        \\\"period\\\",\\n        \\\"value\\\",\\n        \\\"kind\\\",\\n        \\\"basis\\\"\\n       ],\\n       \\\"properties\\\": {\\n        \\\"measure\\\": {\\n         \\\"type\\\": \\\"string\\\",\\n         \\\"description\\\": \\\"The financial measure as the passage states it.\\\"\\n        },\\n        \\\"period\\\": {\\n         \\\"anyOf\\\": [\\n          {\\n           \\\"type\\\": \\\"string\\\"\\n          },\\n          {\\n           \\\"type\\\": \\\"null\\\"\\n          }\\n         ],\\n         \\\"description\\\": \\\"The period as stated; null when none is given.\\\"\\n        },\\n        \\\"value\\\": {\\n         \\\"type\\\": \\\"string\\\",\\n         \\\"description\\\": \\\"The figure copied exactly from one of this item's passages, with its unit.\\\"\\n        },\\n        \\\"kind\\\": {\\n         \\\"type\\\": \\\"string\\\",\\n         \\\"enum\\\": [\\n          \\\"actual\\\",\\n          \\\"guidance\\\",\\n          \\\"estimate\\\"\\n         ],\\n         \\\"description\\\": \\\"actual: reported, including a balance as of a date; guidance: the company's own outlook; estimate: a named party's or consensus forecast.\\\"\\n        },\\n        \\\"basis\\\": {\\n         \\\"anyOf\\\": [\\n          {\\n           \\\"type\\\": \\\"string\\\"\\n          },\\n          {\\n           \\\"type\\\": \\\"null\\\"\\n          }\\n         ],\\n         \\\"description\\\": \\\"Scope and qualifications as stated (GAAP or non-GAAP, segment or company, conditions); null when none.\\\"\\n        }\\n       }\\n      },\\n      \\\"description\\\": \\\"The company's own useful financial figures this statement states (section 2, CONDITION); empty for any other statement. A statement with several useful figures stays one item and lists them all.\\\"\\n     },\\n     \\\"links\\\": {\\n      \\\"type\\\": \\\"array\\\",\\n      \\\"minItems\\\": 0,\\n      \\\"description\\\": \\\"The existing or proposed theses this evidence informs; empty when it is material but no thesis takes it yet: it is kept in the company's record and linked when a covering thesis opens.\\\",\\n      \\\"items\\\": {\\n       \\\"type\\\": \\\"object\\\",\\n       \\\"additionalProperties\\\": false,\\n       \\\"required\\\": [\\n        \\\"target_type\\\",\\n        \\\"target_id\\\",\\n        \\\"relevance\\\"\\n       ],\\n       \\\"properties\\\": {\\n        \\\"target_type\\\": {\\n         \\\"type\\\": \\\"string\\\",\\n         \\\"enum\\\": [\\n          \\\"existing\\\",\\n          \\\"new\\\"\\n         ],\\n         \\\"description\\\": \\\"Whether the reference identifies an open thesis or a new proposal.\\\"\\n        },\\n        \\\"target_id\\\": {\\n         \\\"type\\\": \\\"string\\\",\\n         \\\"description\\\": \\\"Exact supplied ID when existing, or local_id of a new thesis in this answer.\\\"\\n        },\\n        \\\"relevance\\\": {\\n         \\\"type\\\": \\\"string\\\",\\n         \\\"description\\\": \\\"How this evidence informs the referenced thesis, distinguishing source claims from inference.\\\"\\n        }\\n       }\\n      }\\n     },\\n     \\\"tier\\\": {\\n      \\\"type\\\": \\\"string\\\",\\n      \\\"enum\\\": [\\n       \\\"fact\\\",\\n       \\\"party_statement\\\",\\n       \\\"third_party_view\\\",\\n       \\\"rumour\\\"\\n      ],\\n      \\\"description\\\": \\\"Source tier of the statement; an unconfirmed or unnamed-source claim takes precedence as rumour.\\\"\\n     },\\n     \\\"statement_date_text\\\": {\\n      \\\"anyOf\\\": [\\n       {\\n        \\\"type\\\": \\\"string\\\"\\n       },\\n       {\\n        \\\"type\\\": \\\"null\\\"\\n       }\\n      ],\\n      \\\"description\\\": \\\"Original date or partial date as stated in the item; null when absent.\\\"\\n     },\\n     \\\"evidence_period\\\": {\\n      \\\"anyOf\\\": [\\n       {\\n        \\\"type\\\": \\\"string\\\"\\n       },\\n       {\\n        \\\"type\\\": \\\"null\\\"\\n       }\\n      ],\\n      \\\"description\\\": \\\"Period the fact, plan or forecast describes, as supported by the item; null when unknown.\\\"\\n     }\\n    }\\n   }\\n  }\\n }\\n}\\n```\\n\\nFor an OpenAI Chat Completions request, the existing [request builder](../src/hivemind/model.py) wraps its schema with `type: json_schema`, a name and `strict: true`. OpenAI's [Structured Outputs guide](https://developers.openai.com/api/docs/guides/structured-outputs) requires object fields to be required, allows nullable types for unknown values, and uses `additionalProperties: false` for objects. The guide lists `minItems` for arrays; the exploratory run sent this multi-passage schema to Luna and received structured responses. This does not establish production compatibility. A schema-conforming response can still be factually wrong, incomplete or semantically mislinked; refusal and incomplete responses also need separate handling. [OpenAI Structured Outputs](https://developers.openai.com/api/docs/guides/structured-outputs).\\n\\nThe official [GPT-6 Luna model page](https://developers.openai.com/api/docs/models/gpt-6-luna) lists both Chat Completions and structured outputs as supported. The exploratory run shows that the model accepted this schema for those requests, not that its answers were correct or production-ready. OpenAI's [prompt engineering guide](https://developers.openai.com/api/docs/guides/prompt-engineering) describes using headings, lists and examples to make instructions and context clear. In this draft, the system prompt carries analyst decisions; the per-item message carries the changing data; and the separate schema owns response fields and their descriptions.\\n\\nApplication checks are needed for cross-record and source rules the schema alone cannot enforce: each existing target must resolve to the supplied open list; each new target must resolve to one new thesis in the same answer; each new thesis must be referenced by evidence; local IDs must be unique within their list; each evidence item must have a link; and every evidence item must contain at least one nonempty source passage, and every passage must come from this item. Code retrieves an existing thesis description from the supplied list rather than asking Luna to echo it. These are the intended source and identity relationships, not proof that the source supports every summary claim or that an analyst agrees with the thesis. In the isolated exploratory runner, unmatched passages and unresolved links are retained and explicitly marked as provisional rather than blocking the stream; an unlinked new thesis is not added to the state. Production integration remains open.\\n\\nAlex approved returning the evidence tier, original statement date and described period in Step 1. The draft also identifies the original party and reporting speaker separately. Mapping these fields to the existing writer and readers remains to be verified, including how source-specific attribution and tier are retained when a repeat adds another source. The signed historical standard uses more specific opening categories and check-date rules; Alex has clarified that the clean design may open a meaningful topic without a known decision date when later observable developments can help assess it. Other differences remain subject to audit. This draft must not be described as fully compatible with that standard or the production schema without a separate review.\\n\\n### Illustrative output for the sample input (earlier Luna draft, kept as history)\\n\\nThis section and the two after it describe the earlier Luna draft. They are not c8.\\n\\nThe first sentence informs `t1`. The proposed restriction on the retailer's main product raises a separate question about market access. The new thesis tracks whether the restriction takes effect; its period is null because no decision date is supplied. The proposal does not establish that a restriction has taken effect or that sales have changed. The original parties are named in the text; the reporting outlet is in the item metadata, and original statement dates are not specified.\\n\\n```json\\n{\\n  \\\"new_theses\\\": [\\n    {\\n      \\\"local_id\\\": \\\"n1\\\",\\n      \\\"description\\\": \\\"Will the proposed export restriction on the retailer's main product take effect?\\\",\\n      \\\"outcome\\\": \\\"Whether the proposed export restriction takes effect.\\\",\\n      \\\"period\\\": null\\n    }\\n  ],\\n  \\\"evidence\\\": [\\n    {\\n      \\\"local_id\\\": \\\"e1\\\",\\n      \\\"summary\\\": \\\"The retailer raised its sales forecast.\\\",\\n      \\\"original_party\\\": \\\"the retailer\\\",\\n      \\\"reporting_speaker\\\": \\\"Example publisher\\\",\\n      \\\"statement_date\\\": null,\\n      \\\"links\\\": [\\n        {\\n          \\\"target_type\\\": \\\"existing\\\",\\n          \\\"target_id\\\": \\\"t1\\\",\\n          \\\"relevance\\\": \\\"A higher forecast informs the question of future sales growth.\\\"\\n        }\\n      ],\\n      \\\"tier\\\": \\\"party_statement\\\",\\n      \\\"statement_date_text\\\": null,\\n      \\\"evidence_period\\\": null,\\n      \\\"source_passages\\\": [\\n        \\\"The retailer raised its sales forecast.\\\"\\n      ]\\n    },\\n    {\\n      \\\"local_id\\\": \\\"e2\\\",\\n      \\\"summary\\\": \\\"The regulator proposed export restrictions on the retailer's main product and said shipments would require a permit.\\\",\\n      \\\"original_party\\\": \\\"the regulator\\\",\\n      \\\"reporting_speaker\\\": \\\"Example publisher\\\",\\n      \\\"statement_date\\\": null,\\n      \\\"links\\\": [\\n        {\\n          \\\"target_type\\\": \\\"new\\\",\\n          \\\"target_id\\\": \\\"n1\\\",\\n          \\\"relevance\\\": \\\"The regulator's proposal is evidence about whether the restriction may take effect.\\\"\\n        },\\n        {\\n          \\\"target_type\\\": \\\"existing\\\",\\n          \\\"target_id\\\": \\\"t1\\\",\\n          \\\"relevance\\\": \\\"A potential export restriction on the main product may affect sales; the impact is not stated.\\\"\\n        }\\n      ],\\n      \\\"tier\\\": \\\"fact\\\",\\n      \\\"statement_date_text\\\": null,\\n      \\\"evidence_period\\\": null,\\n      \\\"source_passages\\\": [\\n        \\\"The regulator proposed export restrictions on the retailer's main product.\\\",\\n        \\\"The regulator said that shipments would require a permit.\\\"\\n      ]\\n    }\\n  ]\\n}\\n```\\n\\nThe second evidence item is written once, contains two separately quoted passages from the same article, and links to both theses; the sales connection is explicitly an inference rather than a source fact. If there are no pairs, the output is `{\\\"new_theses\\\": [], \\\"evidence\\\": []}`. The example explains the proposed contract; it is not a golden case or an actual Luna response.\\n\\n### Mapping to the Step 1 diagram\\n\\n| Diagram requirement | Where the working prompt addresses it |\\n|---|---|\\n| Open theses from the database | **Input** describes the open list as research already tracked and the reference for matching ideas. It is not evidence or the historical evidence list. |\\n| Decide what constitutes a thesis | **1. Identify research and evidence** describes a meaningful research idea, issue or question and gives examples. These criteria are a working proposal to review in the forward run. |\\n| Propose evidence for an existing thesis | **2. Choose a thesis**, existing outcome, uses its supplied identity. Code obtains the description from the supplied list. |\\n| Propose a new thesis with evidence | **2. Choose a thesis**, new outcome, compares against existing and newly proposed theses and requires supporting evidence. |\\n| Both outcomes or no pair | **2. Choose a thesis** allows both in one item; the proposed schema permits both lists to be empty for neither. |\\n| Thesis and evidence coexist | **3. Pair and describe the evidence** requires a thesis and at least one evidence item in every pair; the proposed schema and example show the structure. |\\n| Historical evidence comparison | **Input** explicitly leaves historical evidence comparison to the later step. |\\n\\n### Request review and remaining limits\\n\\nThe review covered the visible system prompt, sample input, proposed schema and sample response together, with an independent reader. It found three places needing more than formatting: the thesis bar did not explain which business outcome the question could change; the within-item repeat instruction could hide distinct useful facts; and the output did not distinguish the original party from the reporting speaker. The draft above addresses those points. Its expanded examples teach these distinctions across industries; their added length is intentional for that purpose, not a measured quality improvement.\\n\\nAs historical context, two saved responses and their input articles were read in the local [older-run archive](../poc/data/e2e-v83-seed-d2/archive.sqlite): call 4 records two descriptions of an investment in the same article, while call 7 reports a company's plan alongside a separate party's capacity figures. These are examples from an older request, not outputs of this draft. They illustrate why the new request must distinguish repeated descriptions from distinct facts and the original party from the reporter; they do not establish that the revised prompt fixes either case.\\n\\nThe assembled clean request and partial forward-run answers now exist in the local trace. This review is not the measured failure-class audit required for an existing measured prompt. The exact thesis-opening boundary, storage mapping for evidence tier and source provenance, handling of ambiguous thesis identity, and compatibility with the existing ledger are still open. The partial run and source contamination do not establish that the draft works end to end.\\n\\n## 13. Step 2 prompt: Jev request (frozen)\\n\\n**Status:** accepted with Step 2 (D381) and frozen (D427). The text below is the request `clean-arch/step2/compare.py` sends, copied from it; the code is the owner and `tests/test_frozen_clean_step2.py` fails the suite when it moves. Model: `jev-1.14.0` through the repository's Jev transport (`jev.ask`), answers archived per run. Jev answers a typed `choice` question with probabilities, not a written explanation; there is no `cannot_tell` choice for evidence.\\n\\n### What Jev receives\\n\\nOne request per incoming record. The **state** is the incoming record; there is **one question per candidate** the search returned, each naming one stored group's original record. Each record is written as one line:\\n\\n```text\\n<INCOMING PIECE | STORED PIECE> [<tier>; <reporting speaker>; original source <original party>, stated <statement date or unknown>] <summary> | quote: <the passages, joined>\\n```\\n\\n### The question\\n\\n```text\\nHow does the INCOMING PIECE relate to the STORED PIECE below? Use only the supplied text. STORED PIECE:\\n<the stored piece line>\\n```\\n\\nChoices:\\n\\n- `same_statement`: the INCOMING PIECE reports the STORED PIECE's main statement: a retelling, another outlet carrying it, the same number in text or a table, or the same speaker repeating it; wording, precision and extra detail may differ. If the stored piece carries several statements and the incoming piece reports only a secondary one, this is not it.\\n- `supersedes`: a later version of the stored piece's main statement, changed: the same speaker revises that guidance, forecast or event-progress statement, an official confirms or denies that reported claim, or the original source revises it; another statement on the same topic is not this.\\n- `different`: a different fact, figure or matter, a figure for another period or quantity, or only a secondary statement of the stored piece, even if on the same topic.\\n\\n### How the answers become the outcome\\n\\n- Any `same_statement`: the record is a repeat of the candidate with the highest `same_statement` probability, ties going to the earliest group (Alex, 2026-11-08). A `supersedes` answer on another candidate becomes a revision link.\\n- No `same_statement` but one or more `supersedes`: the record is a revision of those groups.\\n- Otherwise it is new evidence. A pairwise `different` is not proof that nothing else in the library matches.\\n- A request that fails is retried once; a second failure is reported and nothing is saved for that record.\\n\\n### The later link when a thesis opens\\n\\nWhen a thesis opens, the stored groups that arrived unlinked from earlier articles are judged against it in batches of ten: the state is `THESIS: <thesis question>`, one yes/no (`noul`) question per stored group, accepted at Jev's threshold of 0.5:\\n\\n```text\\nDoes the STORED PIECE below inform the THESIS stated above? Use only the supplied text; a shared company, product family or word is not enough, and the company's overall results, guidance and estimates inform a thesis about its revenue or earnings path, not one about a competitor, a supplier or a policy unless they speak to it. STORED PIECE:\\n<the stored piece line>\\n```\\n\\n- `true`: the STORED PIECE bears on the THESIS's own matter (the parties, products, policy or quantity the THESIS names) and makes its answer more or less likely, as evidence filed under it would.\\n- `false`: the STORED PIECE concerns another matter, or is a company-wide result or event that does not speak to the THESIS's own matter, or would not change its answer.\\n\\n## 14. Existing components to reference during the rebuild\\n\\nThe intended starting point is the existing thesis and evidence database. This map identifies the repository components corresponding to the diagram so they can be inspected and selectively reused. A link identifies existing code or data; it does not mean that the component already implements the clean design or that it should be copied unchanged.\\n\\n### Thesis and evidence database\\n\\nThe documented local serving default is the existing [thesis ledger](../poc/data/served-2026-10-28-v34-nvda-3m-through-0828/views.sqlite), together with its [source item database](../poc/data/items-nvda-2026-07-01-10-27.sqlite). The ledger stores both theses and evidence; the diagram's two libraries do not require two physical databases. The source item database holds the original material used to resolve evidence sources. These data files are local and are not included in a fresh Git checkout. [Local data and service defaults](../README.md#local-requirements-and-data).\\n\\nRead-only inspection of this local serving snapshot found 68 theses, 4,298 evidence records, 6,578 thesis-evidence links, 2,023 recorded repeat relationships and 121 revision relationships. Its 746 distinct source item IDs all resolve in the documented local item database. These counts describe this snapshot, not the state of any live deployment.\\n\\nThe existing [storage implementation](../src/hivemind/views/store.py) defines `views`, `evidence`, `evidence_sources`, `evidence_links`, `same_claims`, `revisions` and `judgements`. Evidence records retain the source quotation and attribution; links connect evidence to theses; repeat and revision relationships preserve earlier records. The tables are append-only. This is a strong basis for reuse, but compatibility with the new Step 1 output, Step 2 outcomes, writer, readers and any actually deployed database must be verified before adopting it as the new system's write contract.\\n\\n### Source pool and golden validation data\\n\\nThere are two different datasets to keep clear:\\n\\n| Dataset | What it is | What it is used for |\\n|---|---|---|\\n| **34,084 stored source records** | The full local collection of source records in the stand-in Hummingbird database. | The pool from which a replay selects source material for processing. The current replay does not send every record to extraction. |\\n| **148 golden articles** | Selected articles with expected extraction answers: 118 development and 30 test. | Comparing extraction output with the existing golden reference. These articles are a selection from the source database, not an additional 148 documents. |\\n\\nThe 148 golden articles are not the total amount of source material available. Conversely, the 34,084 figure does not mean all records are eligible for processing or have golden answers. The 30 test articles were used in previous experiments and are not a fresh unseen test for the rebuild.\\n\\n### Source data standing in for Hummingbird\\n\\nThe existing replay uses the local [cleaned source item database](../poc/data/items-nvda-2026-07-01-10-27.sqlite) as a stand-in for the incoming Hummingbird stream. Its records come from collected documents, including news, filings and official material; they are not invented articles. The [corpus pipeline](../poc/corpus/README.md) assembled and cleaned them for experiments. Each record can contain a title, publisher, publication date, source URL, company identifiers and cleaned text; `text_page` retains the fetched page text. This source database is separate from the thesis and evidence ledger.\\n\\nRead-only inspection of the local file found 34,084 stored records dated 2026-02-25 through 2026-10-26, of which 6,874 have `feed = 1`. These are counts for this file, not for a live Hummingbird service or for any particular run. The collection is NVDA-oriented but also contains other entities and topics. The file is local and excluded from Git.\\n\\nThe existing [replay entry](../scripts/replay.py) defaults to this database, though a run can select another. The [source reader](../src/hivemind/testdb.py) reads the chosen date window in publication order, including feed items and identified copies; [dispatch](../src/hivemind/dispatch.py) then decides which items enter extraction. Thus the number actually processed depends on the window, filters and dispatch. This is a historical replay path; a live Hummingbird connector and its contract have not been established for the clean architecture.\\n\\n### Existing extraction reference split\\n\\nThe existing frozen extraction reference is a small labelled selection, not a split of every record in the source database. Its files name different source items, with no shared `input_id` between the two sets:\\n\\n| Existing reference | Articles | Article dates | Source mix in the local item database |\\n|---|---:|---|---|\\n| [Development](../docs/research/2026-10-29-ledger-standard/golden-v5/golden-v5-dev.json) | 118 | 2026-07-01 to 2026-07-14 | 108 news-search records, 9 NVIDIA blog records, 1 filing. |\\n| [Test](../docs/research/2026-10-29-ledger-standard/golden-v5/golden-v5-test.json) | 30 | 2026-09-01 to 2026-10-24 | 30 news-search records. |\\n\\nAll 148 IDs resolve in the local source database. Of the 118 development records, 117 are currently marked `feed = 1`; all 30 test records are. The source categories in each set are 20/73/25 and 5/19/6 for T6/T7/T8 respectively. The two sets have different time windows, but the test set has been used in prior experiments, including full-set runs in the [historical experiment log](../docs/research/2026-10-29-ledger-standard/loop-log.md); it must not be described as a fresh unseen test for the rebuild. NVDA appears in the stored company identifiers of all 118 development records and 26 of the 30 test records.\\n\\nThese files are the existing frozen reference, not an approved evaluation set for the clean architecture. Their applicability to the new thesis-and-evidence output and linking needs to be assessed; no new split or acceptance criteria is decided here. The source item database and the golden references serve different purposes: source items are input material, while golden references are expected answers for selected items.\\n\\n### Diagram-to-code map\\n\\n| Diagram block | Existing artifact | What it offers and what remains to be checked |\\n|---|---|---|\\n| Hummingbird stream | [Item dispatch](../src/hivemind/dispatch.py), [replay entry](../scripts/replay.py), [source item database](../poc/data/items-nvda-2026-07-01-10-27.sqlite) | The existing path accepts stored items and records processing. A live Hummingbird event connector and its contract have not been verified in this map. |\\n| Thesis database and lookup | [Ledger store](../src/hivemind/views/store.py), [extraction thesis selection](../src/hivemind/extraction.py), [historical research reader](../src/hivemind/research_context.py) | Existing records and readers provide thesis identities and descriptions. Their scope and timing must be checked against the clean design's input contract. |\\n| Step 1: Luna | [Extraction](../src/hivemind/extraction.py), [model transport](../src/hivemind/model.py), [existing extraction prompt](../src/hivemind/prompts/role-v74i.txt), [replay configuration](../poc/config/poc-v118.json) | Existing extraction uses Luna and produces evidence and thesis proposals. Its prompt, response shape and selection behavior are not the clean draft in section 12 and require an explicit compatibility review. |\\n| Step 1 golden evaluation | [Golden development set](../docs/research/2026-10-29-ledger-standard/golden-v5/golden-v5-dev.json), [golden test set](../docs/research/2026-10-29-ledger-standard/golden-v5/golden-v5-test.json), [extraction scorer](../docs/research/2026-10-29-ledger-standard/score_gold.py) | Existing references and scoring code can be inspected. Their coverage and scoring assumptions must be matched to the new test before claiming they evaluate every proposed output or thesis-evidence link. |\\n| `{thesis, evidence}` handoff | [Extraction handover](../src/hivemind/extraction.py), [item orchestration](../src/hivemind/views/round.py) | Existing extraction returns evidence, candidates and links. The clean architecture's exact handoff contract is still open. |\\n| Evidence database | [Ledger store](../src/hivemind/views/store.py), [evidence writer](../src/hivemind/views/writing.py) | Evidence, sources and thesis links already exist in the same ledger. Verify the new writes and existing reader behavior on a copy before choosing how to reuse the writer. |\\n| Semantic search over evidence | [Current evidence ranking](../src/hivemind/views/matching.py), [existing semantic search](../src/hivemind/search.py) | The current evidence candidate ranking uses word overlap. The semantic index in `search.py` indexes **theses**, not evidence. It is a reference for a search implementation, not the evidence search required by this diagram. |\\n| Step 2: Jev | [Jev transport and request](../src/hivemind/jev.py), [evidence comparison](../src/hivemind/views/jev_matching.py) | The clean path uses the same transport with its own criteria and outcome rule (section 13, `clean-arch/step2/compare.py`, frozen D427); production's criteria and threshold stay in `jev_matching.py`. |\\n| Step 2 evaluation | [Evidence decision reference](../poc/eval/gold/evidence-decisions-seed-2026-10-25.json), [evidence decision scorer](../scripts/score_evidence_gold.py) | Existing cases and a scorer cover evidence outcomes and targets for an earlier setup. Their applicability to semantic retrieval and the clean architecture has not been established. |\\n| Repeat, revision and new outcomes | [Evidence comparison](../src/hivemind/views/jev_matching.py), [evidence writer](../src/hivemind/views/writing.py) | Existing code records these relationships. The clean design must specify the outcome and uncertainty contract before reuse is accepted. |\\n| Step 3: save and link | [Writer](../src/hivemind/views/writing.py), [store](../src/hivemind/views/store.py), [item orchestration](../src/hivemind/views/round.py) | Existing code writes theses, evidence, source links and relationships. Its current input contract includes old matching decisions and must not be assumed to accept the new handoff directly. |\\n| Step 4: thesis judgement | [Judgement](../src/hivemind/views/judging.py), [round orchestration](../src/hivemind/views/round.py) | An existing judgement path can be inspected. What to reuse depends on the clean design's still-open judgement contract. |\\n| Dossier and source reading | [Bundle reader](../src/hivemind/bundle.py), [service](../src/hivemind/service.py), [HTTP entry](../scripts/hivemind_api.py) | Existing readers assemble thesis, evidence and source information. Their coverage of repeat, revision and provenance relationships must be checked against the new dossier requirements. |\\n\\nOne concrete reader boundary matters for this reuse: the local serving snapshot records a revision from `e191` to `e280` under `v8`, and a repeat from `e6` to `e16` under `v1`. A read-only call to the existing bundle reader returns the newer evidence records without those revision or same-claim relationships. The ledger retains them, and the [store's evidence reader](../src/hivemind/views/store.py) reads them; the [bundle reader](../src/hivemind/bundle.py) currently reads the older `replacements` relationship instead. These are the existing matcher's recorded decisions; their semantic correctness was not reviewed here. This is a reader compatibility finding for these inspected cases, not a claim that the underlying evidence is missing or that every reader has the same behavior.\\n\\nDo not write to the documented serving snapshot as part of this mapping. Any future compatibility exercise must identify the actual target database and source store, use an appropriate copy, and verify both new writes and existing reads. Reusing data and storage does not imply adopting every old prompt, routing rule or judgement behavior.\\n\\n## 15. Architecture challenge: questions before building\\n\\nThis section records the read-only challenge of the clean design, including the independent Claude Code Fable 5.1 review and discussion. The reviewers found no evidence requiring the existing thesis and evidence ledger or its records to be discarded. Reuse still requires checking the actual readers, writers and meaning of the historical relationships. The points below are risks or open contracts unless a specific observation is identified. They are not new product rules or evidence that the proposed system has failed.\\n\\n1. **Can Luna see the right research? Resolved as an input design.** Step 1 receives all relevant company tags and all open theses in scope for those tags. For the current single-entity flow, it receives the entity's complete open thesis list. This addresses the concern that a relevant in-scope open thesis is excluded from the model's input. It does not establish that the model will always recognize a matching thesis; that is an evaluation question. How relevant tags are supplied and cross-entity discovery and linkage remain separate questions (section 16).\\n2. **What makes a thesis new? Prompt design and evaluation.** Alex's direction is to define duplicate theses clearly in the Step 1 prompt, so Luna associates evidence with an existing thesis when the idea is already covered. The exact definition and the model's ability to apply it remain to be worked out and evaluated. This does not introduce a separate thesis-routing stage. Articles processed concurrently against an older library may present a separate implementation issue; handling it is not decided here.\\n3. **Evidence without a thesis: resolved as an output design.** Alex's direction is that Step 1 outputs thesis and evidence together: either evidence for an existing thesis or a proposed new thesis with evidence. The working prompt states this pairing. There is no separate standalone-evidence output in this design; this is a product choice, not proof that every source fact will be extracted.\\n4. **Can the evidence history be reconstructed? An implementation and validation question for the existing flow.** Jev's role in Step 2 is to decide whether evidence repeats or revises a prior statement, or is new. Search must first return the relevant prior evidence, and the saved relationship must reach the dossier reader. In the inspected local database, repeat and revision relationships exist, but the existing bundle reader does not expose the two inspected relationships described in section 14. This does not require a new architecture stage; it identifies retrieval and reader behavior to verify when implementing the existing stages.\\n5. **What should judgement see?** Two different sources can independently support or contradict one another without being a repeat or revision. Step 2 can save them as different evidence, but whether those relationships must be recorded explicitly or can be understood by Step 4 remains open. Step 4's input and output are not yet designed.\\n\\nThe next proposed work is the Step 1 forward run and source-by-source trace review in section 17. The stored repeat and revision relationships and the dossier reader remain relevant to the later saving-and-reading milestone. Their historical model-generated labels are observations, not automatically verified reference answers.\\n\\n## 16. Future design: entity relationships and cross-entity linkage\\n\\n**Status: discussion and open design, not part of the current extraction flow.** The current architecture focuses on one entity at a time. Before supporting cross-entity relationships and impact propagation in production, the relationship data structure, maintenance process and linking behavior need a deeper design and validation. This section records the direction discussed; it does not prescribe a schema or add a new step to Luna, Jev or the four-step flow.\\n\\n### Why this is needed\\n\\nA thesis can matter to several companies or assets. A supplier disruption may be relevant to its customers and suppliers; a macro thesis may be relevant to many entities for different reasons. If the system makes separate copies of the same thesis and its evidence for every entity, keeping those copies consistent becomes difficult. A possible direction is to keep a shared thesis and evidence history and link it to each relevant entity with an explanation of the connection. How this fits the existing thesis and evidence database remains to be designed.\\n\\n### Separate, asynchronous relationship maintenance\\n\\nThe entity relationship map should be maintained separately from the live extraction path:\\n\\n- **Cold start:** preprocess an initial map of entities and their explicit relationships from available sources. The sources, coverage and way to resolve entity identity are open.\\n- **Periodic reassessment:** revisit the map asynchronously using available evidence and, where appropriate, a broader review of potential relationships. A weekly run is an example, not a fixed schedule. What is reviewed, how often and how changes are accepted are open.\\n- **Explicit links:** maintain a data structure that can represent relationships between entities and, where relevant, links from a thesis to entities. The form, ownership and integration of those links are not yet specified.\\n\\nAn entity relationship identifies a possible path of relevance; it does not by itself prove that an event affected another entity, or establish the direction or size of an impact. The system needs to retain the reason and supporting source for a link, including whether a connection is reported in a source or inferred. The representation of uncertainty and time remains open.\\n\\n### Illustration: a supplier disruption\\n\\nThis is a hypothetical example, not a statement about actual companies. Suppose a source reports a disruption at Foxconn, and a previously established relationship indicates that Foxconn supplies Apple. The system could maintain one disruption thesis and its evidence, then identify Apple as potentially relevant through the supplier relationship. If later evidence changes the assessment, or the supplier relationship is found to have ended before the disruption, the affected connection would need to be reconsidered. The original source and the history of how the connection was reached should remain understandable. The exact reassessment and update mechanism is not yet designed.\\n\\n### Questions to resolve before cross-entity production use\\n\\n1. What entity identities and relationship types are needed, and how are relationships represented in or alongside the existing database?\\n2. How are the initial map and its sources built, checked and refreshed, and how is incomplete or conflicting information handled?\\n3. How are a relationship's source, reason, uncertainty and valid dates recorded and updated?\\n4. How are relevant entities discovered for a thesis, including broad macro themes, without assuming every connected entity is affected?\\n5. What causes existing thesis-to-entity links to be reconsidered when evidence, a business relationship or a thesis changes? How are historical decisions preserved?\\n6. What should an analyst see as a potential connection versus an established impact, and what review or evaluation is needed before exposing it in production?\\n7. What are the scale, freshness and cost of an initial map and periodic reassessment, and how will those be measured?\\n\\nThese are cross-entity design questions. They do not change the current single-entity extraction inputs, prompts, evidence routing or database write contract.\\n\\n## 17. Implementation plan for review\\n\\n**Status: proposed plan, not an authorization to change the production path or a claim that the work is built.** This plan turns the four-step architecture into a sequence of reviewable milestones. Each milestone ends with something that can be inspected before moving on. The immediate goal is a Step 1 forward run on real articles, not a new end-to-end system built all at once.\\n\\n**Implementation progress:** the isolated [Step 1 runner](step1/README.md) and its [design](STEP1-DESIGN.md) exercise the handoff with recorded responses. The bounded live path reuses the existing model client and archive and records source, request, raw response and changing test state. The [prompt audit](STEP1-PROMPT-AUDIT.md) records the evidence-boundary review and Alex’s opening rule. On 2026-11-06, a selected three-article Luna forward run completed on an isolated test library. Its local trace and source-by-source review are exploratory, not a production-compatible extractor or a general quality result. A source-passage repair in the first article lost part of the cited support; investigate it before relying on that path.\\n\\n### Working boundaries\\n\\n- Work in the clean-architecture area on the `clean-arch` branch. The existing source database and thesis/evidence ledger are inputs and references; inspect and reuse their components where they fit. Establish compatibility before treating any existing code as the new contract.\\n- Use an isolated test library and run artifacts for development. Do not write the forward run into the existing serving snapshot. Where existing records are needed, first identify the target data and use a copy.\\n- The existing production prompt, configuration, frozen evaluation references and historical runs remain unchanged. The draft Luna and Jev prompts in this PRD are starting points for the new design, not replacements already adopted. Prompt and evaluation work must follow the repository's applicable frozen-reference and audit rules.\\n- The current slice processes one entity at a time. Cross-entity relationship maintenance remains future design work in section 16. Live Hummingbird integration and Step 4 judgement are not prerequisites for the first Step 1 run.\\n- The PRD is the architecture source; regenerate the HTML after each document change. Keep run traces and findings identifiable by run, separate from the agreed architecture and from historical artifacts.\\n\\n### Milestone 0 — Prepare the first Step 1 run\\n\\n**Goal:** define the request, references, test-library behavior and failure handling needed for an isolated Step 1 forward run. A complete production writer and reader census is not a prerequisite to this run.\\n\\n1. Use the field map in section 18 to identify the source data and fields needed for the first run. Keep the meaning of unknown values explicit. A full census of production writers and readers belongs before milestone 3, not before the isolated Step 1 test.\\n2. Review the proposed list-and-link response in section 12 against the system prompt and schema field by field. Keep the agreed existing/new/empty outcomes and the requirement that each thesis and evidence coexist. One evidence item can link to several theses using local references; those references are not persistent IDs. The example is not production-compatible as written.\\n3. Decide how the isolated test library assigns an ID to a new thesis and carries its description into the next item's open list. Existing IDs must resolve to the exact list Luna saw. The code owns IDs; the model judges whether an idea merits tracking and which thesis it informs.\\n4. Separate Step 1 testing from production compatibility. The test library needs enough information to advance and inspect theses; using the existing production writer additionally requires the evidence and new-thesis contracts described in section 18. A fresh isolated database using the existing store schema is a candidate, but check its open-thesis reads and writes on real objects before relying on it; table nullability alone does not prove reader compatibility. Do not fill missing values by guessing.\\n5. Review the complete assembled request and response checks as a unit: instructions, source and open-thesis payload, structured-output schema and field descriptions, followed by the code that reads them. The prompt must not ask for a value the schema or reader cannot represent. Apply the repository's prompt-audit and independent-review rules; the draft has not had a measured clean-design run to audit.\\n\\n**Milestone output:** a reviewed Step 1 request and test-library contract, with the production-ledger mapping questions recorded for milestone 3. This is the prerequisite to building the first runner, not a claim that the existing production writer is already compatible.\\n\\n### Milestone 1 — Make Step 1 runnable and inspectable\\n\\n**Goal:** send an ordered selection of real source articles to Luna, one at a time, while the test thesis library grows.\\n\\n1. **Choose the input and starting state.** Read the local source database through an explicit path. Select one entity, a bounded date range and an ordered list of eligible articles. Record their IDs, dates, source information and the order used. Define the initial open-thesis library explicitly: an empty library can exercise new theses, while a copied existing library can exercise reuse. The exact first selection and initial state are still to be chosen.\\n2. **Implement the reviewed handoff.** Supply the article and source fields, relevant company tags, and complete open-thesis identities and descriptions. Consume the reviewed response for existing-thesis evidence, new thesis with evidence, and no result. Keep source passages and attribution. The field mapping and any unresolved thesis-identity boundary must be reviewed in milestone 0.\\n3. **Prepare the request and runner.** Use the reviewed prompt, input and schema from milestone 0. Build a separate runner that accepts explicit input, configuration and output paths, and uses a supplied model transport. It must not overwrite the frozen production prompt or configuration. The existing extractor accepts only the frozen prompt version, so the new draft is not runnable by pointing that extractor at the PRD.\\n4. **Advance the test library.** For each article, send the current open-thesis list, capture Luna's proposals, and make the resulting thesis state available to the next article. This is a Step 1 test-library update, not the final production evidence writer or a Jev decision. Use the reviewed identity and reference contract from milestone 0. Start with ordered, one-at-a-time processing so the next item sees the prior result; the existing production selector uses the start-of-day list and cannot simply be assumed to do this.\\n5. **Capture a readable trace.** For every item preserve the source article, the exact company tags and thesis context supplied, request configuration and schema, raw model answer, interpreted thesis–evidence pairs, and library state before and after. Record failures with their cause and the state reached. Preserve the run's sequence so a reviewer can follow a mistake into later items.\\n6. **Keep the exploratory replay moving.** If a source passage cannot be matched, retain the article, model's original passage and evidence, mark that passage unverified, and advance the isolated test-library state so the remaining articles can be reviewed. If an evidence link references a thesis the model did not supply, retain the unresolved link for review without inventing or adding a thesis; a proposed new thesis without a resolved evidence link is not added to the open state. The affected and subsequent states are provisional and are not production records. Do not present a partial or inferred passage as a verified quotation. Malformed responses and schema failures retain the raw response and stop the run. Record any source correction and its original wording; do not silently drop a pair or retry. Alex chose this exploratory behavior on 2026-11-06 to avoid mechanical checks stopping the whole review.\\n7. **Review the forward run.** Read the complete articles beside the traces and states. Inspect both what Luna returned and information it missed; check source meaning, attribution, new-versus-existing thesis decisions, links and duplicate accumulation. Report the articles inspected and concrete findings. The intended review is not a prebuilt golden set; a limited run does not prove overall quality.\\n\\n**Milestone output:** a reproducible ordered run, its before/after state and raw traces, and a source-backed review of what worked and failed. Before any model send, check the exact assembled request and its reader using stored or fake responses, and run the applicable no-cost preflight. The existing production preflight is not assumed to exercise the new clean-design path; establish what it covers and what no-cost checks the new path needs. The first-run size, model cost budget and article selection remain open and should be explicit before a paid run. Review the resulting traces and state before deciding what quality is sufficient to proceed. This exploratory review does not replace the frozen ruler for historical measurements or product acceptance; no such run has been performed for this plan.\\n\\n**Review before moving on:** Does Step 1 produce useful pairs, retain the relevant source meaning, and reuse the existing thesis when the library contains it? Which observed failures are prompt, input, output-shape or test-library issues? A finding is traced to the article and raw output before changing the request or code.\\n\\n### Milestone 2 — Retrieve and compare prior evidence\\n\\n**Goal:** implement the Step 2 path for a proposed thesis–evidence pair.\\n\\n1. Review the existing evidence store and Jev integration using the component map in section 14. Decide the evidence search representation and how the thesis and incoming evidence contribute to the entity-wide query. The current evidence ranking is word-based; the existing semantic index searches theses, so neither is assumed to be the proposed evidence search.\\n2. Build candidate retrieval over evidence with an explicit top-N setting and return the IDs and content needed for comparison. Search across the entity for existing and new theses, as Alex chose. Measure retrieval separately: inspect whether the relevant previous evidence appeared in the returned candidates.\\n3. Connect Jev to compare incoming evidence with retrieved candidates for repeat, revision or new evidence. Define the response and what happens when several candidates conflict or the comparison is uncertain before choosing write behavior. Keep attribution, original date, amount and source available to the comparison.\\n4. Review search and Jev traces against real source passages. A correct Jev decision with a missed candidate does not prove retrieval works; a retrieved candidate does not prove the comparison is correct. Choose the review set and criteria as part of this milestone.\\n\\n**Milestone output:** an inspectable search-and-comparison path, including candidate lists and Jev decisions, with separate findings for retrieval and comparison. The search technology, N and performance requirements remain open.\\n\\n### Milestone 3 — Save and read evidence and links\\n\\n**Goal:** make the outcomes of Steps 1–2 available as a coherent dossier using the existing ledger where it fits.\\n\\n1. Specify the write contract for a new thesis, new evidence for an existing thesis, a repeat and a revision. For a repeat, reuse the existing evidence and add the incoming source and any missing thesis link, per Alex's decision. Earlier statements remain available for revisions. Decide the storage mapping for one evidence item linked to multiple theses before implementing that case.\\n2. On a copy of the intended ledger, check the existing store, writer and reader against the new contract. In particular, trace saved repeat and revision relationships through the actual dossier reader; section 14 records two local examples that the existing bundle reader does not expose. Check source passages before treating an old relationship as correct.\\n3. Implement or adapt the smallest compatible write-and-read path and verify that the resulting thesis, evidence, sources and relationships can be read back. Define how repeated processing and an interrupted write should behave before connecting an ongoing stream.\\n\\n**Milestone output:** an isolated ledger and a readable dossier showing the saved records and their relationships, with compatibility findings for the existing data. This milestone does not by itself establish that the historical data or every reader is correct.\\n\\n### Milestone 4 — Connect and review the four-step flow\\n\\n**Goal:** take a bounded source sequence through the completed extraction, comparison and saving path; design judgement before implementing it.\\n\\n1. Define Step 4's input, output, timing and treatment of accumulated evidence. This is an open design, not a contract already determined by the diagram.\\n2. Run the completed Steps 1–3 together on an isolated library and inspect the source-to-dossier trace, including search misses, comparison decisions and saved links. Verify that a later item sees the state produced by the earlier item.\\n3. Only after the Step 4 contract is decided, integrate and review judgement using saved evidence. Define the actual Hummingbird event contract and live integration separately; the local source database remains the stand-in until then.\\n\\n**Milestone output:** a bounded, inspectable end-to-end research flow for the parts implemented, plus a report of what has and has not been validated. Cross-entity propagation and asynchronous relationship maintenance remain outside this first single-entity implementation.\\n\\n### Decisions to resolve as the work reaches them\\n\\n| Before | Decision |\\n|---|---|\\n| First Step 1 implementation | Exact thesis–evidence response shape, thesis identity and duplicate definition; how the isolated test library advances. The agreed minimum for a new thesis is entity, question, tracked outcome and period when known. |\\n| First paid forward run | Entity, initial state, ordered source items, run size, budget and what the review will inspect. |\\n| Evidence search and Jev | Search representation and N within the agreed entity-wide scope; comparison response and uncertain or conflicting outcomes. |\\n| Production-compatible saving | Existing ledger compatibility, write and read contracts, repeated processing and interrupted writes. |\\n| Step 4 and live integration | Judgement contract, source event contract and timing. |\\n\\n**Recommendation for the first implementation slice:** define and review the Step 1 input/output and test-library contract, then run a small ordered set of real articles and inspect every resulting trace and state. The exact run and its limits remain to be selected.\\n\\n## 18. Luna draft and existing production compatibility review\\n\\n**Finding: the draft in section 12 cannot be plugged into the existing production extraction and writer as-is.** The architecture's desired pair is a reasonable way to express the result, but the current production response and its readers use a different contract. This review compares local code and a draft example; it does not claim that the new prompt has been run or that a live deployment was inspected.\\n\\n### The concrete compatibility check\\n\\nThe existing [production extraction schema](../src/hivemind/extraction.py) has three top-level arrays: `evidence`, `candidates` and `new_groups`. The clean draft now returns `evidence` and `new_theses`, linked by response-local references. Running the section 12 example through the existing local schema checker with production `v74i` still returns errors, including:\\n\\n```text\\n$.candidates: required\\n$.new_groups: required\\n$.new_theses: not allowed\\n$.evidence[0].id: required\\n$.evidence[0].quote: required\\n$.evidence[0].original_day: required\\n$.evidence[0].links[0]: expected string\\n```\\n\\nThis is a local, no-model contract check. It proves the example cannot pass that schema; it does not test semantic extraction or any deployed endpoint.\\n\\n### What differs and why it matters\\n\\n| Area | Existing production path | Clean-architecture draft | Consequence |\\n|---|---|---|---|\\n| Shape and links | Separate evidence and new-candidate arrays; each evidence item has an ID and links to open thesis IDs or local candidate IDs. | Separate evidence and new-thesis arrays; each evidence item carries typed references and per-thesis relevance. | A new reader or explicit conversion is needed. Both shapes express thesis–evidence relationships, but no conversion has been built or verified. |\\n| Evidence and attribution | Evidence includes `id`, `quote`, `one_line`, `speaker`, `original_who`, `original_day`, `tier`, `event_time` and `links`. | Evidence has a response-local ID, source passages, summary, attribution, tier, original statement date and date text, described period and per-link relevance. | Analogous fields need a tested mapping; the described period is not automatically equivalent to `event_time`, and local identity differs from a stored ID. The current writer does not write per-link relevance. In the 49-article exploratory forward trace, 63 of 160 evidence items have multiple passages; one survey item needs its second passage to identify the 60-person population. This confirms that dropping additional passages loses source context in an actual output, while the correct storage and reader mapping is still open. [Handoff evidence and counts](STEP1-QUOTE-INTEGRITY-CENSUS.md). Unknown-date representation also differs. |\\n| New thesis | A candidate includes the object, question, kind, year, due date, outcome ranges, typed identity fields, opening reason and evidence IDs. | A new proposal has a question, tracked outcome, period when known and response-local ID, referenced by evidence; code supplies the entity. | The existing thesis creation and downstream judgement contracts need additional information that the draft does not supply. Missing dates, outcome ranges, source tiers or research meaning cannot safely be manufactured just to satisfy the old writer. Whether Step 4 needs outcome ranges remains open. |\\n| Thesis reuse | The existing path can propose candidates and then match them against stored theses. | Luna uses the supplied open list and proposes either an existing ID or a new thesis. | The routing behavior is deliberately different. Reusing the old matcher unchanged would not by itself implement the new diagram. |\\n| Thesis context over time | The local production `shown_views` reads theses open at the start of the item's day. | The proposed forward run lets each item see the preceding item's resulting library state. | The same-day visibility behavior must be addressed and tested in the new path; the existing default cannot be assumed to provide the proposed sequence. |\\n| Prior evidence search | The current evidence ranking uses word overlap within a thesis, followed by Jev comparison. | The diagram proposes semantic retrieval before Jev; Alex chose entity-wide search, including evidence linked to other theses and evidence for a new thesis. | The existing matcher is useful reference code but is not the proposed semantic evidence search. |\\n\\nThe existing [writer](../src/hivemind/views/writing.py) consumes the production-shaped evidence and candidate records. It stores source, speaker, original party, original day, tier and event time; tier and original timing also participate in its revision checks. The [ledger tables](../src/hivemind/views/store.py) already represent thesis–evidence links, repeat relationships and revisions. The finding is about the contracts and behavior of the current readers and writer; it is not evidence that the database or its existing records must be replaced.\\n\\n### Field ownership and proposed mapping\\n\\nThis is a **design map**, not a built adapter or a decision to preserve every old rule. The current reader examples below are grounded in the linked code; a complete reader and writer census belongs before milestone 3. In the test run, an application-assigned ID is a test-library identity until an eventual ledger write; it is not automatically a production ledger ID.\\n\\n| Information | Proposed source for the clean path | Existing field and reader | What still needs to be decided or verified |\\n|---|---|---|---|\\n| Source item, publisher, URL and publication date | Supplied with the article by the source database or later Hummingbird input. | The writer records `input_id`, category, publication day and location in `evidence_sources`; the source item database supplies document details. | Confirm the selected target has the source records and the dossier can resolve them. Publication day is not automatically the original statement day. |\\n| Source passages and standalone statement | Luna returns `source_passages` and `summary`. Each evidence item has one or more separately checked passages from the same article. | Existing evidence uses one `quote` and `one_line`; the extraction checker and writer read them. | Verify each nonempty passage against the item; the production storage mapping for multiple passages is not yet designed. |\\n| Reporting speaker, original party and original statement day | Luna returns `reporting_speaker`, `original_party`, a full `statement_date` when known and `statement_date_text` for the date as stated, including partial dates. | Existing evidence uses `speaker`, `original_who` and `original_day`; Jev, the writer and judgement read these. | Validate actual calendar dates and the null-to-empty mapping; a publisher, actor and original claimant may differ. Preserve partial dates without inventing a day. The existing normal path does not retain a partial date as `original_day`. |\\n| Evidence tier | Luna returns `tier`: `fact`, `party_statement`, `third_party_view` or `rumour`, following the signed standard's precedence. | The existing writer stores `tier`; Jev and judgement receive it, and revision checks use it. | Verify the mapping and how source-specific tier and attribution are retained when several reports link to one evidence record. Do not assume the current source table already retains all such distinctions. |\\n| Described period and event time | Luna returns `evidence_period` as supported by the source, or null when unknown. | The existing writer expects `event_time`. | Verify whether and how these meanings map and which readers require them. A described period is not automatically publication day, original statement day or the old `event_time`. |\\n| Evidence identity and links | Luna uses response-local IDs and attaches typed links with per-thesis relevance; code assigns persistent IDs. | Existing evidence has a local `id` and `links`; the writer assigns stored IDs and writes `evidence_links`. | Verify how response-local IDs become stored IDs and how per-link relevance is retained. Do not collapse records solely because their text is equal. |\\n| Existing thesis | Luna references an ID from the supplied open list; code retrieves its unchanged description. | The existing ledger stores `view_id`, `question` and other fields in `views`. | Verify the ID belongs to the exact list shown. Existing stored fields remain associated with that ID; Luna does not need to recreate them. |\\n| New thesis proposal | Luna returns a question, the outcome to track and a period when known, with evidence; code supplies the current entity. | The current candidate and thesis writer expect object, kind, question, due date, year, rungs and additional typed identity and admission fields. | The minimum is agreed. Verify how it maps to the writer and what judgement requires; whether outcome ranges are needed remains open. Do not invent dates, categories or ranges to force compatibility. An isolated Step 1 test library may track a proposal before those production questions are settled. |\\n| Why the evidence matters | Luna returns `relevance` for the pair. | The inspected evidence writer does not store this field. | Decide whether a downstream reader needs the explanation and, if so, its destination; do not silently discard it while claiming it is preserved. |\\n| Groups and old candidate matching | No direct equivalent is specified by the pair draft. | The current response includes `new_groups`; the old round matches candidate theses before writing. | Decide which existing behaviors, if any, are needed by the clean design. Neither is automatically implied by the diagram. |\\n\\n### Acceptance of the Step 1 handoff\\n\\nBefore any paid forward run, a no-cost check should exercise the **actual new path**, not just parse the example JSON. Use one example for each outcome: existing thesis with evidence, new thesis with evidence, both in one item, and no pairs. Verify that source passages and supplied IDs resolve, that each pair has evidence, that unknown values remain unknown, and that the test library's next item sees the preceding result. Check the captured request and output as the runner actually constructs and consumes them. A separate check on a copy of the intended ledger is required before claiming compatibility with its writer and dossier reader. The prior single-passage path has been exercised locally and in one selected three-article run. The revised multi-passage schema was sent to Luna in the exploratory run; its output has not been validated against the production writer.\\n\\n### Prompt review and next design task\\n\\nThe draft prompt describes the new Step 1 decision, evidence pairing, source attribution and examples, but the **full request and its downstream path are not ready to run**. In particular, the precise thesis identity boundary and what the existing writer and judgement require for a new thesis need further work. The production prompt's opening rules and its later thesis matcher are not automatically part of the clean design. The old production configuration is frozen; the new draft is not a supported production prompt version.\\n\\nThe recommended next task is to finish the Step 1 request and isolated test-library contract, including the open product decisions, and perform the no-cost checks in section 17. The full field-to-reader census and production-compatible writer test are required before milestone 3, not before the first isolated Step 1 run. The new shape must carry the required meaning without inventing fields or silently dropping information.\\n\\n## 19. Claude review: verified findings and open choices\\n\\nThis section records the verification of [Claude's review](CLAUDE-REVIEW-FINDINGS.md). The snapshot counts below are local observations, not a semantic audit or a claim about live production. Alex has decided the repeat behavior, minimum new-thesis fields, Step 1 evidence tier/date/period fields, entity-wide evidence search and review of the first run before deciding whether quality is sufficient; other product choices remain open.\\n\\n| Finding | Verification and disposition |\\n|---|---|\\n| 1. Repeat handling | The local snapshot has 2,023 `same_claims` rows for 4,298 evidence records, and the current writer saves a separate linked record. These are model-generated relation labels, not 2,023 independently confirmed duplicates. On 2026-11-06 Alex selected option B: reuse the evidence record and add the new source and missing thesis link. Sections 5, 6 and 13 record the decision and Jev handoff. |\\n| 2. Multiple thesis links and search | 1,918 of 4,298 stored evidence records link to two or more theses. The nested draft lacked one explicit shared local evidence identity. Section 12 now proposes separate new-thesis and evidence lists, typed links and response-local IDs; code must verify that all links resolve and every new thesis has evidence. This handles one statement linked to multiple theses **within the response**. Alex chose entity-wide evidence search, including for a new thesis; the count does not prove the proposed cross-thesis failure happened. |\\n| 3. What not to retain | The draft lacked the signed standard's explicit boundaries and a final check of what was kept. Section 12 now includes scoped counterexamples and exceptions for meaningful actions, current plans, competitor comparisons and named-party statements without amounts or dates. The exploratory run returned both useful items and possible technical-detail noise; it is not a formal noise measurement. Claude's reference to the evidence-bloat D206 is the retired worktree's number, carried into this repository as [D358](../docs/DECISIONS-log.md); this repository's D206 is a different decision. |\\n| 4. Thesis shape and significance | The draft example was broad and its prompt requested a thesis explanation without a corresponding thesis field. The example is now a concrete question about completion; the prompt asks Luna to consider business relevance rather than demanding an output field that does not exist. On 2026-11-06 Alex agreed to the entity, question, outcome and period when known as the minimum. A separate explanation field and outcome ranges remain open. For deals, investments, products and projects, the clean draft asks for a relevance judgment rather than requiring an established financial impact. This broader clean-design topic rule does not change the historical standard's narrower binding-obligation rule. |\\n| 5. Period and population boundaries | [E1](../docs/research/2026-11-06-e1-no-home-drops/README.md) found 12 agreed cases involving another period, quarter or product variant among 17 agreed linking misses in the studied population. Its model-account probes named question IDs, and the report does not establish that a generic instruction fixes those misses. Section 12 now tells Luna to consider whether related-period, population or variant evidence informs a thesis while preserving the differences; it does not force unrelated periods or populations to be the same thesis. |\\n| 6. Identity and tags | The response now references an existing thesis by ID only; code retrieves its description. A new thesis and each evidence item have response-local references; persistent IDs are assigned by code. Existing and new target namespaces are explicit. The first run's entity comes from its input rather than an invented company tag; cross-entity discovery remains outside scope. |\\n| 7. Evidence tier, date and period | Alex approved returning tier, original statement date and the period described. The draft separates a full ISO statement day from date text and evidence period; unknown values remain null. The current production `statement_day` converts a month or other non-ISO value to an empty day before writing, so Claude's example that `\\\"May\\\"` passes through this normal path as a literal comparison is not established. Writer fallbacks for revision ordering do not prove the original statement date. Mapping and source-specific provenance still need verification. |\\n| 8. First-run workload | The cited archive has 243 extraction calls averaging about 4,964 input and 1,207 output tokens; median recorded duration is 12.5 seconds. Median times 118 is about 25 minutes, but the first 118 recorded durations sum to about 31 minutes, before any new-run overhead. The clean request may be different. Of the 118 old development articles, one is not marked for the normal feed. These figures are estimates, not a commitment to a run, cost or eligible sample. Section 17 now separates first-run preparation from the later production writer/reader census. |\\n| 9. Pass line | Alex agreed to review the first forward run's traces and state before deciding what quality is sufficient to proceed. A review sheet should record missed material, noise, incorrect links, duplicate or unhelpful theses and attribution/date errors, with source passages; a sample of reviewed traces does not establish general accuracy. Formal acceptance remains governed by the frozen ruler where applicable. |\\n| 10. Failed checks | The first-run plan originally stopped on schema, reference or source failures. Alex subsequently chose to keep unmatched source passages and unresolved references visible and provisional while continuing the isolated run; schema and other blocking failures retain their recorded behavior. The existing production path can drop individual evidence items; this isolated-run behavior is not a claim about production. Existing source-preserving quote normalization and repair are candidates for reuse only after their behavior is checked on the new path; an accepted repair and its source passage must be visible. |\\n\\nThe pending choices include whether Step 4 needs outcome ranges and what quality the first trace review will establish as sufficient to proceed. The original review's recommended answers on those items are proposals, not decisions. The revised multi-passage prompt and schema have been exercised in an exploratory Luna run, not formally accepted; Jev and the production writing path are not implemented by this clean Step 1 slice.\\n\\nIn the Claude-review revisions, the system-prompt draft grew from 7,579 to 10,469 characters. The added text supplied the signed standard's previously missing not-kept boundaries, their exceptions, the related-period distinction, the list-and-link handoff and the supplied-entity boundary. The subsequent clarification of Alex's new-thesis minimum increased that draft to 10,753 characters. The approved evidence tier and time fields brought the prior draft to 12,397 characters. The topic, evidence audit and multi-passage changes increased the system prompt from 12,397 to 13,419 characters and from 2,498 to 2,696 tokens using the local o200k_base tokenizer. The added wording states the agreed topic rule, the signed evidence boundaries and how to return multiple source passages; no model quality result is claimed. The earlier prompt bytes were not archived for a token-count comparison; no token-cost or model-quality improvement is claimed. The assembled-request review is recorded in the Step 1 audit. The provider accepted the exploratory multi-passage requests; output quality remains under review and has not been formally accepted.\\n\\nAdditional checked boundaries: the current `service.evidence_record` and bundle evidence responses read legacy `replacements`, while `store.evidence_in_force` reads `same_claims` and `revisions`; this is a reader-contract gap, not proof about every UI. The snapshot has zero `replacements` rows. Production's Jev evidence question uses the same three choice names as section 13 with its own wording (`jev_matching.PIECES`); its `cannot_tell` criterion belongs to thesis comparison. The current repository's `docs/check.py` invokes the clean-architecture renderer check; whether that coupling should remain is a maintenance choice, not an extraction-quality finding.\\n# Core PRD for the next phase: filing must recognise indirect relations the way an analyst does\\n\\n> Status: in progress (opened 2026-11-04). Alex: \\\"你把这个写好成下一阶段核心PRD然后不要drift, 把所有需要的context 全部充分记录，每次开始前都需要revisit, 然后开始做\\\".\\n> This page is the single source for this phase. In a conflict: Alex's words → `docs/DECISIONS.md` → this page → the other design documents. This page's\\n> conclusions, evidence, constraints, measuring method and process are not rewritten to follow test results;\\n> test results go into `docs/research/2026-11-04-filing-end-to-end/log.md`, and changing this page first needs Alex's word.\\n> Amended 2026-11-04 (Alex replied \\\"go\\\" to the proposed amendment; D360): §5.2 drops \\\"also file under the other party's question\\\" and puts two\\n> sentences in its place, one on choosing and one on splitting; §6's decision rule is rewritten. How it came about:\\n> `docs/research/2026-11-04-filing-end-to-end/prd-amendment-proposal.md` and `log.md` rows 11–16.\\n> 2026-11-05 (D368): translated into English on Alex's word (\\\"不，用英文吧\\\"); §4 corrected to name the frozen standard's version 5 and §5 given a status line, on his delegation (\\\"你要来帮我看到底做不做\\\").\\n\\n## 0. Checklist before every start (Alex: \\\"每次开始前都需要revisit\\\")\\n\\nBefore starting any step, finish these in order; if one cannot be done, do not start:\\n\\n1. Read §§1–8 of this page in full; read the last three rows of `log.md`, and confirm where the previous step stopped and why.\\n2. Check against §3, \\\"not in scope\\\": what this step does is not in that table. If it is in the table, stop and take it to Alex.\\n3. Check against §4, \\\"constraints\\\": this step changes nothing frozen; a change to the frozen extraction prompt is the one place §5 names, and Alex's\\n   word for it is already given.\\n4. If this step costs money: its predictions and stop conditions are written down and frozen as §7 says (with their sha256 recorded beside them); the\\n   requests are rebuilt byte for byte as §6 says; the control is re-sent the same day.\\n5. What goes to Alex: one conclusion, one recommendation, one test, after §7's rounds of review; no menu of options; in plain words (the opening of\\n   AGENTS, \\\"Explain and answer as to a sixteen-year-old\\\").\\n\\n## 1. Goal (end to end)\\n\\nEach question's judgement must receive the facts that can change its answer; facts that no question receives, those that bear on no question, must\\nnot be piled into some one question. What is measured is the final judgement (the frozen judgement ruler, reader B, at the window end 2026-07-14), not\\nany one step's own score.\\n\\n## 2. The core blocker (proven)\\n\\n**The system uses a fact for a question only when the fact \\\"states exactly this question's own figure\\\". An analyst also reasons onward from a fact: the other party's figure in a deal, price and volume for a product's revenue, a product's variants for its launch, and so on. The filing step cannot do this; the judging step reasons onward once it has the facts.**\\n\\nThis one blocker has two faces (described earlier as \\\"two problems\\\"):\\n\\n- **The parking lot.** Filing does not recognise facts that bear on a question indirectly, so no question takes them; yet to be kept, a fact must\\n  first be filed (D209, D264). So D273 added the fallback sentence, which parks them in NVIDIA's total-revenue question. Of the reports under the\\n  total-revenue question, in the part the gold read, 32–39% are ones the standard does not keep, 31–44% are kept but used by none of the 22 questions,\\n  and only 7–10% are what the gold actually uses to judge total revenue (three draws); 24–44% of the total-revenue question's judgement citations are\\n  news about other companies or the whole market (Intel graphics-card retail prices, a gas-fired power plant in Taiwan).\\n- **Narrow questions starve.** Questions that only indirect facts can answer do not receive them: the custom-chip question received none of Broadcom's\\n  figures in any of the three draws, and judged \\\"below $40 billion\\\" in all three; the operating-margin and NVIDIA capital-spending questions received\\n  nothing at all and were never judged.\\n\\n**Evidence:**\\n\\n| Evidence | Content | Source |\\n|---|---|---|\\n| Filing recognises only \\\"its own figure\\\" | The model says \\\"Broadcom's AI chip revenue is not cloud providers' spending on custom chips\\\" and \\\"Google Cloud's backlog is not capital spending\\\"; on a neutral refiling (no question id named, the rule not shown), 23 of 42 facts that matter are still not filed | `probe-filing-account-d1.md`, `refile-no_fallback.json` |\\n| The judgement reasons onward once it has the facts | The custom-chip question's request of 7-14, sent 3 times in each of the three draws: as it was, 9/9 \\\"below $40 billion\\\"; with the Broadcom, Trainium and other facts written in that draw's ledger added, 9/9 left the lowest rung (6 times $40–60 billion, 3 times $60–80 billion), reasoning as the two readers did (\\\"guidance $16 billion, about $64 billion annualised, less networking chips\\\") | `predictions-one-test.md`, `one-test-result.json`, `log.md` row 8 |\\n| Where the parking lot came from | D273: with the fallback sentence added, the core items on the extraction ruler went 64 → 68; the extraction ruler does not look at which question a fact is filed under (AGENTS §7.1, \\\"What it does not measure\\\") | `docs/DECISIONS.md` D273 |\\n| What the parking lot holds | The figures above; an independent reader on 12 random articles: of 25 misfilings as it was, 21 were parked in the revenue question; 8 and 5 with the fallback deleted | `sink_by_standard.py`, the independent reader's report (`log.md` row 8) |\\n\\nAll files above are in `docs/research/2026-11-04-filing-end-to-end/` unless noted otherwise.\\n\\n## 3. Ruled out or secondary (outside this phase's scope, each recorded separately)\\n\\n| Matter | Conclusion | Source |\\n|---|---|---|\\n| The argument card | Not built; its code is deleted (Alex: \\\"好，删掉卡片代码\\\") | `docs/research/2026-11-04-argument-record/log.md` rows 4–11 |\\n| The arrows of the question graph | Really wired backwards: a seed question's arrow means \\\"supports\\\" (D208), while the judging code reads it as \\\"whose conclusion to read\\\" (PRD 06). As a result themes are judged only after the total-revenue question, so the total-revenue question reads the themes' conclusions of the previous day, and in draw 3 a chain of questions went wrong in turn. But it does not explain the misfiling (filing comes before judging), and the gold itself judges data-center revenue as \\\"total revenue × 92%\\\". A topic of its own; settled by D368 (item 4: the arrow means \\\"supports\\\"), its fix to be built and measured | `core-problem.md`, `review-core-codex.md` |\\n| Code removes the total-revenue question's own figures | True (\\\"keep only the narrowest question\\\" takes a seed arrow for \\\"a narrower sub-question\\\"), but each draw it costs the total-revenue question only 0–2 of the facts it needs | `log.md` row 8 |\\n| A filing re-check added at the end | Recovers some, and misfiles about as many (independent reader: about one misfiled for each one filed right); not the solution | The independent reader's report |\\n| One general sentence, \\\"the other party's figure in a deal counts too\\\" | The custom-chip question gains, but it pulls Morgan Stanley's price for a Rubin rack from the Rubin revenue question to the capital-spending question, and leaves some facts with no home | `answers.json` (the two arms definition and definition_no_fallback), `measure-corrected.txt` |\\n| Tightening D259's \\\"leeway\\\" | Alex's own decision; this phase does not overturn it | D259 |\\n| Opening questions (the Ohio guarantee was not opened); the two readers' disagreement on the China-share question | Another class of problem, not in this phase | `docs/research/2026-11-04-filing-end-to-end/diagnosis.md` §0 |\\n| Model drift | With the same requests, today about half as many facts go into the total-revenue question as on 11-03; the cause is not proven. Compare only with a control re-sent the same day, never with the archive | `log.md` row 6 |\\n\\n## 4. Constraints (what must not move, and why)\\n\\n- **The frozen ruler** (AGENTS §7.1, D261, D262): the extraction standard, version 5 (the signed version 3 with D248's seven boundaries and D250's four\\n  evidence boundaries and counting unit), golden-v5, the seed questions and the judgement gold; not a word changes; a disagreement is a gap in the\\n  system (D263).\\n- **The frozen extraction prompt** (D274): v74i (`poc-v108`) does not change by a word; what this phase changes is the one place that holds the filing\\n  rule (the description of the `links` field), made into a new version with a new configuration and compared with v74i. Alex has given his word for this\\n  work (2026-11-04: \\\"好你去解决问题\\\", \\\"开始做\\\"); making it the default needs his word again.\\n- **Frozen opening and judging** (D354): this phase does not touch them.\\n- **The standard's text** (in translation): §6, \\\"file under the narrowest open question; when no question takes it, record no home and drop it, and read\\n  each one at evaluation\\\"; §5.1, \\\"makes the answer to some question more or less likely\\\", with four paths, \\\"demand, supply, competition, pricing\\\"; §5.3,\\n  \\\"another company's matter is not kept when one cannot say which question about the covered company it moves through a path such as demand, supply,\\n  competition or pricing\\\".\\n- **Decisions**: D207 (one home per fact, the narrowest question), D209 (no home means dropped, each one read), D259 (leeway: a figure question takes\\n  \\\"the demand, supply, competition and pricing that make it more or less likely\\\"; the total-revenue question taking more is an accepted cost, \\\"bounded by\\n  the narrowest-question rule and the driver questions\\\"), D265 (code keeps only the narrowest), D273 (the fallback sentence), D355 (the two failed tests\\n  of the previous filing topic).\\n- **Prompt principles** (AGENTS §6): carry only the standard and add no new rule; a general hedge-fund analyst: every rule and example reads the same\\n  for a bank, a drug maker, a retailer or a chip company, names neither NVIDIA nor its products or figures, and is not taken from a test article; a\\n  classification is written as a closed set with two or three examples per class, replacing the abstract wording; quality is not fixed by lengthening\\n  the prompt: remove as much as is added, or write down the reason.\\n- **Code decides only \\\"is it the same thing\\\", never \\\"does it matter\\\"** (AGENTS §2).\\n\\n## 5. What to do\\n\\nStatus: the links-rule version that carried items 1–3 (v74l) failed its one test (§8 step 5); D361 keeps the fallback sentence, so item 3 is not carried out. The plan below is kept as written.\\n\\n1. **Replace the abstract sentence \\\"makes the answer more or less likely through demand, supply, competition or pricing\\\" with the few classes in which an analyst recognises an indirect relation, written as a closed set, each class with two or three examples from other industries** (AGENTS §6: one\\n   abstract sentence is a coin flip on every send; examples replace it). A first draft of the classes (checked against the standard line by line at\\n   design time; it holds only meanings the standard already has):\\n   - The question's own figure: this question's figures, guidance, estimates and revisions (estimates for another period or another population follow\\n     the existing rule).\\n   - The other side of the same money: a seller's revenue from the buyers the question counts; those buyers' orders and backlog with these sellers.\\n   - Price and volume: a product's price or shipments, for the question on that product's revenue.\\n   - Variants and parts: a product's variants, alternatives, key parts and schedule changes, for the question on that product's launch.\\n   - Demand, supply and competition moves with a number: customers' orders and capital-spending plans, suppliers' capacity and prices, competitors'\\n     sales and share, for the question they affect.\\n2. **State how to file a fact when two specific questions both bear on it** (the problem the `definition_no_fallback` arm exposed: Morgan Stanley's rack\\n   price was filed under the buyers' capital-spending question, and the seller's Rubin revenue question lost it). One home per fact (D207): file it under\\n   the question its figure measures most directly (for example, a hotel's room rate goes under its room-revenue question, not under the\\n   travellers'-spending question; a parts maker's revenue from carmakers goes under the carmakers' parts-spending question, not under a rival parts\\n   maker's share question); when one sentence gives a separate figure for each of two questions, write two items, each filed under its own question\\n   (code stores two items that quote the same sentence as one record linked to both questions); never also file it under a broader question about the\\n   same company (the failure of D355's test 2: the model filed it under an NVIDIA revenue question as well). The original draft's \\\"when the other\\n   party's question is open … file it there as well\\\" conflicted with D207 and was deleted on 2026-11-04 with Alex's agreement (D360).\\n3. **Delete the fallback sentence** and return to the standard's §6: when no question takes a fact, it is not filed; code drops it as \\\"no home\\\" and\\n   records it (D209), and evaluation reads each one.\\n4. Change only the one place that holds the filing rule; report its length in characters before and after, and write down the reason for any growth\\n   (this time's reason: examples replace one abstract sentence).\\n\\n## 6. How to measure (the ruler does not move; the method does not change again)\\n\\n- **Requests**: rebuild each stored request byte for byte with the production code, changing only the one place that holds the filing rule; the\\n  rebuilt request's archive id must equal the original's, or it is not sent (`resend_filing.py`, AGENTS §5). Never re-send the archive's copy whose\\n  keys were sorted alphabetically.\\n- **Articles**: development set = the 54 articles of `selection.json` (already read many times); held-out set = articles the extraction gold read and\\n  the judgement gold uses that are not among those 54, drawn once before the test, with the list frozen and never changed afterwards. Both sets are\\n  measured and reported apart.\\n- **Control**: the unchanged requests re-sent 3 times the same day. No comparison with the archive (model drift).\\n- **Each answer**: goes through the production code checks and filing first (including \\\"keep only the narrowest\\\" and \\\"no home means dropped\\\"), and is\\n  counted after.\\n- **What is counted** (`measure_filing.py`, with its matching rule fixed: items are matched on the distinct numbers and the proper nouns other than\\n  NVIDIA in the source text; a source passage the system quotes that overlaps the gold's passage also counts as the same matter; \\\"optional\\\" counts as\\n  optional; the citations in the body of the gold's answers are read):\\n  - whether each fact that matters (one the gold uses to judge any question) reached the question that uses it, counted per fact, not per \\\"fact ×\\n    question\\\";\\n  - per question: the facts that matter that reached it and the new noise that appeared, counted by the decision rule below;\\n  - the parking lot: how many facts the total-revenue question (v1, together with v22) takes in, and what they are;\\n  - noise: how many of the sentences the standard does not keep are kept; per question, how noise is filed (links on facts the standard does not keep\\n    or no question uses);\\n  - how many core and supporting facts appear; the facts that matter that are dropped; how many questions each fact is filed under on average.\\n  - Matching still has a small error (spot check: the new rule mismatches a few and misses a few); say so when reporting the numbers, and read the\\n    ones that matter one by one.\\n- **Decision rule** (rewritten on 2026-11-04 with Alex's agreement, D360. The original draft required \\\"every draw above the highest of the control's\\n  three\\\" and the like, which the control itself fails when measured again, so it cannot tell good from bad. Script `decide.py`; written down and frozen\\n  before each test; each draw's numbers and the totals are all reported):\\n  - **Totals, with luck ruled out first**: each article's 6 answers from the new and the old arm are randomly reassigned between the two arms 4,000\\n    times (with a fixed random seed); the new rule's difference counts as a real change only when fewer than 5% of the reassignments reach it.\\n    - Development set: facts that matter reaching the question that uses them must rise; the count under the total-revenue questions (v1, v22) must\\n      fall; sentences the standard does not keep must not rise; core facts must not fall.\\n    - Held-out set: facts that matter reaching the question that uses them must not fall; sentences the standard does not keep must not rise; core\\n      facts must not fall.\\n  - **Per question, counted by code against the gold** (development and held-out sets together):\\n    - A fact that matters which reaches the question at least two fewer times under the new rule than under the control counts as \\\"one fewer\\\" for that\\n      question; in under the control all three times and under the new rule none of the three, it counts as \\\"lost outright\\\". A move to another question\\n      that the gold also uses it for and that is no broader than the original (one home per fact, D207) does not count as fewer; a move to a broader\\n      question counts. \\\"One more\\\" in the opposite direction offsets it.\\n    - A noise sentence (not kept by the standard, or kept but used by no question) that the new rule files under the question at least twice while the\\n      control never does counts as \\\"new noise\\\"; filed all three times, it counts as \\\"outright new noise\\\". The opposite direction offsets it.\\n    - Any question with a net 3 fewer, a net 2 lost outright, a net 5 more new noise, or a net 3 more outright new noise fails. These thresholds are the\\n      smallest values that keep \\\"misjudged when new and old are exactly the same\\\" within about one in ten; at the test, first compute the\\n      misjudgement rate from the reassignments; if it is above one in ten, raise the threshold most prone to misjudgement by one step, then compare with\\n      what was measured.\\n  - **Smaller changes** (a question 2 fewer, two or three more noise) cannot be told from luck in three measurements: all are listed, given to a reader\\n    who did not write the rule to read against the raw answers, and written into the report; they do not decide pass or fail.\\n  Only when everything passes does it become a candidate; a candidate runs end to end three times on the 14-day window (extraction re-sent, matching and\\n  judging run as usual, scored on the frozen judgement ruler), and that step needs Alex's word.\\n\\n## 7. Process (no drift)\\n\\n- **One recommendation and one test at a time** (AGENTS §7.3, Alex: \\\"就测试一种，一次\\\"): write the design first and put it through rounds of review (own\\n  checks, Codex read-only, a reader who did not write it reading the raw records) until a round finds nothing serious; write down and freeze the\\n  predictions and stop conditions; test once; if it does not match, stop and take it to Alex (D355: \\\"如果有什么不符合hypothesis 的地方你需要终止然后和我说我们重新评估\\\").\\n- **A review's report is a lead**: each finding counts only once it is checked against the records (AGENTS §1).\\n- **A prompt audit before any prompt change** (`.claude/skills/prompt-audit/SKILL.md`): check the whole request against the standard sentence by\\n  sentence, in both directions.\\n- **Every step goes into `log.md`**: what was done, what came of it, the files; mistakes and overturned results stay in it too.\\n- **Do not repeat what was ruled out** (§3).\\n\\n## 8. Steps and where we are\\n\\n| # | Step | Output | Status |\\n|---|---|---|---|\\n| 1 | Design: the classes of indirect relation (a closed set + examples from other industries), how to file when a fact measures both sides, deleting the fallback; checked against the standard sentence by sentence; length before and after | `docs/research/2026-11-04-filing-end-to-end/design-links.md` | Done (draft 3, v74l / poc-v115) |\\n| 2 | Checks at no cost: a sample answer written by the new rule goes through every code check; the new rule's text goes through the prompt audit | Same as above | Done |\\n| 3 | Review rounds (Codex, independent readers, own), until nothing serious remains | `review-links-*.md` | Done (Codex 7 rounds, independent readers 3 times; round 7 found nothing serious) |\\n| 4 | Draw and freeze the held-out set; write down and freeze this test's predictions and decision rule | `heldout.json`, `predictions-links.md` | Done (sha256 recorded for both) |\\n| 5 | Test once: development set + held-out set, the new rule and the same-day control 3 times each | `answers-links.json`, `log.md` | Done (2026-11-04): failed: facts that matter reaching the right question, development set +7 (p 0.26); every other condition passed |\\n| 6 | If passed: to Alex, to decide whether to run three 14-day end-to-end draws; if failed: stop, to Alex | `design-links.md` §8 | Stopped, to Alex |\\n| 7 | (D361, Alex: \\\"按照你的提以来，但是你一定是自己反思多轮之后才给出的行动\\\") Measure the ceiling first: hand the source passages the gold cites straight to the frozen judgement; the custom-chip, operating-margin and capital-spending questions judged 3 times each at the window end, the custom-chip question as it was 3 times as the control; the fallback sentence is not deleted for now | `reflection-v74l.md`, `oracle-design.md` | Done: operating margin grounded 3/3, capital spending 2/3, custom chips 0/3 (the gap is in interpretation); the next step waits for Alex |\\n| 8 | (D362, Alex: \\\"你继续啊不要scope drift and strongly follow evidence of your discovery and learning\\\") Two small changes where facts are not delivered, one at a time: ① when a quote is rewritten, code matches it back to the source sentence (changing nothing the model sees; verified by replaying the archive); ② a figure question's description states which figures it is derived from by definition (first sent 3 times each on the article that motivated it) | `delivery-fixes.md` | Stopped: an independent check overturned the first change's code (it would take in wrong figures); the second failed its trial send (1/3). The root: the signed standard's §5.3 does not keep two key facts, treating them as \\\"a restatement of known facts\\\" (proposal 6, awaiting approval); to Alex |\\n| 9 | **Historical; superseded by D370.** (D363, Alex: \\\"乙\\\") At coverage start, record each question's starting figure once from the company's latest earnings report; the daily path still takes no restatements: design, rounds of self-checks and independent checks, validated first on the archive in the simplest way | `baseline-design.md` | Validated on two questions: the frozen extraction does not read the report's tables (0/3); with each question reading the report once on its own, the operating-margin question read its starting figure 2/3 and the capital-spending question 3/3, and the judgement then judged right (2/3, 3/3), about 2.5 cents. All 22 questions tested once (2026-11-05, Alex: \\\"你充分验证\\\"; files chosen by code, a same-day control, about $0.43): v10 and v12 judged right 9/9 each; no question already judged right turned wrong; but 5 of the 53 figures read were other quantities (the Vera CPU question and the Blackwell and Rubin question took a larger or neighbouring revenue line), so it failed condition 3, written beforehand. The model itself pointed to the reading instructions' sentence \\\"write the lines it is computed from, or the line the report uses for it\\\"; stopped, to Alex. Alex: \\\"改\\\"; only this sentence was changed (\\\"write only the lines it is computed from, or the same quantity under another name; never a broader line or a line next to it\\\"), tried on 4 questions first, then tested on all 22 (about $0.36): all three conditions passed: v10 and v12 9/9 each, no question judged right turned wrong, and all 46 figures were the questions' own quantities. Checked after an independent reader's challenge: the new sentence made the reading miss the capital-spending line in 3 of 12 reads, and it had been tested only on the one May report; the fourth version (a line-by-line re-check after writing) removed too much and failed; after a census of every failure trace (Alex: \\\"我需要你深度看完所有失败trace给我准信\\\"), the third version with the repaired quote check was chosen (D365): 0 wrong figures on the held-out August report; built into the production system (poc-v116; the $0 checks and the tests all pass). The full acceptance, three 14-day draws (Alex: \\\"跑验收\\\"; a same-day control; about $4.79): all passed: operating margin and capital spending judged right 3/3 each (the control never judged them), 53 against 45 in total (of 57); for the China-share question, the only one two fewer, both readers found the starting figures did not lead it astray. Alex: \\\"都做\\\": poc-v116 became the default (D366); the code was committed and a PR opened |\\n\\n## 9. Alex's own words on this matter (in time order)\\n\\n- \\\"你这个单独开一个专题出来解决 … 是promot，是系统结构设计还是到底哪里有问题挂错一堆东西，机制是不是有问题（一定要挂吗？有没有可能是杂音\\\" (2026-11-03)\\n- \\\"So if it's a customer problem or other companies that you think is relating NVIDIA and it's the wrong evidence, then what is the standard for it? … from a hedge fund analyst standpoint, are these even relevant? Do you think your ruler is wrong in this aspect?\\\" (2026-11-04)\\n- \\\"你确定下你接下来要改进的量化目标，以及你要看到端到端我们的管线是要做什么的，不要乱硬优化，要看到目标\\\" (2026-11-04)\\n- \\\"就测试一种，一次 … 能不能自己有个超级自信的定论和证据再给我提建议\\\" (2026-11-04)\\n- \\\"这些只是类型题，你需要抽象拔高我们现在的核心问题和卡点。这个很重要这样改下去才是对的\\\" (2026-11-04)\\n- \\\"你把这个写好成下一阶段核心PRD然后不要drift, 把所有需要的context 全部充分记录，每次开始前都需要revisit, 然后开始做\\\" (2026-11-04)\\n- \\\"go\\\" (2026-11-04, on the proposed amendments to §5.2 and §6 and on this test)\\n# Current state\\n\\n**Clean Steps 1–3, current (2026-11-11).** Records: Step 1, [round log](../clean-arch/step1-unfiled-2026-11-08/LOG.md) §§16–47; Step 2, [Step 2 log](../clean-arch/step2-validation-2026-11-07/LOG.md) §§12–19.\\n- **Step 1 configuration: c8, adopted by Alex (D387).** It runs DeepSeek Flash at high effort, with a 64,000-token output cap; a\\n  format failure or a cut answer is resent once (D380). It carries Alex's decisions D382–D385:\\n  - figures are conditions;\\n  - material statements with no thesis are kept without links;\\n  - only big matters open a thesis;\\n  - no target prices.\\n\\n  [PRD §12](../clean-arch/PRD.md) holds its system prompt, closing check and schema; a run with no candidate files sends exactly the\\n  accepted request.\\n- **Acceptance (D386, [protocol](../clean-arch/step1-unfiled-2026-11-08/ACCEPTANCE-PROTOCOL.md)).** 50 fresh articles that no run,\\n  old or new, had used: news from 2026-09-05 to 09-07, a holiday weekend with no NVIDIA posts. One draw; two readers and a third on\\n  disputes.\\n  - helpful 132/139 (core 83/83);\\n  - wrongly opened theses 1 of 10;\\n  - search 141/143 available repeat pairs, or 141/145 for the whole system (one 11-article story supplies 55 pairs, and revisions are\\n    barely exercised);\\n  - clear wrong merges 1/57, plus 2 overlaps;\\n  - detail retention 22 = 22. This is a storage comparison: every record keeps its own text. It is not a usability test.\\n\\n  Dev ×3 on the frozen golden-v5 (a lead): helpful 214, 211 and 212 of 234; search 98.9–100%; clear wrong merges about 1%. Step 1\\n  cost for the fresh set plus dev ×3: $4.20 at published rates.\\n- **Steps 2 and 3** are built in isolation (`clean-arch/step2`, `clean-arch/step3`): search, comparison, grouping and later linking.\\n  They are not integrated with production storage. **Step 4 (judging) has not passed** on the clean path: its ladder step is built and\\n  measured (four Stage A runs, lines missed by 1 to 3 answers; D426), so nothing yet shows the clean system can judge an investment\\n  view on its own questions.\\n- **Step 2 is closed and frozen (Alex, D427, 2026-11-11;** [Step 2 log](../clean-arch/step2-validation-2026-11-07/LOG.md) §§14–19**).** It goes\\n  to production only with the whole clean path, after Step 4 meets its lines; `tests/test_frozen_clean_step2.py` guards its files. Its three lines were met at the acceptance above (one draw; \\\"later version\\\"\\n  relations barely exercised), and no miss of the seeded end-to-end test (clean 18, 18, 17 against production 17, 15, 16) has\\n  been traced to it (the two single-draw misses were diagnosed on 2026-11-11, below: neither traces to Step 2). What happened since the close-out of 2026-11-08:\\n  - A change to Jev's wording for \\\"later version\\\" relations failed its line (42 calls, 2026-11-09) and tuning stopped.\\n  - One wrong relation was traced to the judge: it put NVIDIA's answer to the Kyber report under the FY2027 revenue question;\\n    sent both ways, the conclusion did not differ ([result](../clean-arch/step2-edge-effect-2026-11-10/RESULT.md)).\\n  - Alex stopped work on that relation (D423) and asked for a fix to the rule that gives a \\\"later version\\\" the older record's\\n    questions. Measured on the three saved draws ([round log](../clean-arch/step2-revision-links-2026-11-10/LOG.md)), removing the\\n    rule was withdrawn: of the 24 links it wrote, two blind reader families call 19 context and 3 evidence, and one of the 3 is a\\n    company's answer that would otherwise be missing beside four reports (with it rung 2, 2, 2; without it 2, 3, 2). **The rule\\n    stays (D424).**\\n  - **Open, recorded:** Jev's \\\"later version\\\" relation (9 of 30 join different statements in draw 1); the context links it carries\\n    (19 of 24); wrong groups (at the line on one draw; the unprompted reading test never run); the \\\"Unverified quote\\\" mark not\\n    shown to Jev (3 of 188); not decided, whether a company's answer must sit under every question its report is filed under.\\n  - **Reopens when** Step 4 yields judged views on the clean path and a miss, or something a reader of a thesis sees, traces to\\n    one of these. The round's measurement kit (replay of a saved draw, exact simulation of a writer rule, blind packets with\\n    controls, a judgement sent both ways) is kept in the two folders above.\\n- **The clean system's untraced end-to-end misses, diagnosed (2026-11-11;** [round log](../clean-arch/e2e-misses-2026-11-11/LOG.md)**).**\\n  The China share question in draw 3 and the FY2028 revenue question in draw 2 (seeded test, D392). Both estimates sit on a rung\\n  line. China: the same window-end request, re-sent, gives the miss twice and the right answer once (the judge's own variation at the\\n  1% line); no H200 price is in any request. FY2028: draw 2's window-end request gives the miss 3 of 3 and draw 3's the right answer 3\\n  of 3; draw 2's lacks records draw 3's holds (a \\\"41% in calendar 2027\\\" figure Step 1 filed under FY2027 only, \\\"$1 trillion of\\n  Blackwell and Rubin visibility\\\", five infrastructure-demand records), not isolated which matters; FY2028 is the question whose filed\\n  statements differ most between draws (47% shared, median 74%). Neither traces to Step 2. Refuted on the way: that a refused answer\\n  re-asked caused the China miss. Observed defect of the frozen judge: it names the export-controls theme as a dependency of the China\\n  question, 42 of 65 refusals in six draws, and the re-ask changed the rung 8 times (PRD 11, E4). No change proposed; 18 sends, $0.043.\\n- **Open defects, by product impact** (reflection council, `council/av-codex.md`):\\n  1. **The Ohio-guarantee yes/no question is never covered** in the three dev draws; a broader credit-support amount thesis opens\\n     instead. Diagnosed (round log §48): the model folds the unsigned guarantee into the open aggregate thesis because the request\\n     uses \\\"covers\\\" both for \\\"is evidence for\\\" and for \\\"already asks this question\\\". The same clause sits under link clutter.\\n  2. **A revenue-share thesis was opened** (Vera Rubin's share of data-center revenue), the class-A boundary of D382.\\n  3. **Link clutter.** A blind recheck of the 34 disputed fresh links found 19 weak and 2 wrong; 10 accepted links mixed in as controls were all useful; the other 49 links were not rechecked.\\n     The model's own account names topic or theme overlap and inference chains, and c8's closing check never reads back a link. This is\\n     a likely cause, with no fix proven. Alex approved designing a protected link check through the council; a first draft was stopped\\n     because it would drop founding premises and contrary facts.\\n  4. **Unverified passages:** 3 of 188 fresh records and 1–3 per dev draw. The mark now travels into Step 2's records, and a reader sees the found source text or an \\\"Unverified quote\\\" label. Jev's comparison input still carries the model's text without the mark; changing it changes measured Step 2 behaviour and needs its own measurement.\\n  5. **The lidar policy thesis** recurs at the boundary (one dev draw in three).\\n- **History.** These earlier states are superseded:\\n  - the 2026-11-07 takeover (K5 → K6b; [takeover log](../clean-arch/takeover-2026-11-07/LOG.md));\\n  - the 2026-11-08 close-out (K6b test 32/42; Step 2 first lines; [Step 2 log](../clean-arch/step2-validation-2026-11-07/LOG.md) §12);\\n  - the unfiled fix round and the c1–c7 arms (round log §§1–39).\\n- **No run is live.** The branch is committed through the D388 line (round log §§48–59).\\n\\n**Clean Step 1 source investigation (2026-11-07):** A [source-loss census](../clean-arch/STEP1-SOURCE-LOSS-CENSUS.md) traces two separate losses in the historical cleaner and records reproducible corpus observations. Offline candidate comparisons expose both recovered content and source-identity or contamination risks. A subsequent [full-page diagnostic](../clean-arch/STEP1-FULL-PAGE-RESULTS.md) completed 102 calls on 17 selected articles and independent source-backed review. It exposes examples of both missing or misattributed source text and model errors that persist despite the right text being present. A Codex–Claude council is reviewing the results and earlier attempts; no source-cleaning candidate is adopted, and the source corpus and production defaults are unchanged.\\n\\nAlex has authorized correcting the test-source cleaner and test data when their defects are confirmed, while the frozen production configuration and ruler remain intact. The cleaner switched 615 originally fed articles off; a replay reproduces all 615, and direct inspection confirms an actual article excluded because its 9,874-character body was flattened to one line. Other examples include a wrong-site shell, paywall and long challenge code, so the false-exclusion count and a general article-identification repair remain to be established. The [council regroup](../clean-arch/STEP1-SOURCE-REGROUP-COUNCIL.md) and [source-preservation design](../clean-arch/STEP1-SOURCE-PRESERVATION-DESIGN.md) describe an isolated candidate checked against all 34,084 records, with a fake-answer actual-runner handoff and provenance display in the replay renderer. The [five source-control calls](../clean-arch/STEP1-CAPTURE-CONTROLS-RESULTS.md) completed and were source-reviewed; two items contain summary details absent from their attached quotations, and one source-visible risk explanation was not returned. This is selected-case evidence, not a general quality result. Broader source-quality comparison, citation completeness and actual writer integration remain open.\\n\\n**Clean architecture Step 1 (2026-11-06, isolated work on `clean-arch`):** Alex reopened work with the clean architecture. An experimental prepared-source handoff now preserves the archived page, prior cleaned text, source-role decisions and selected-line mapping without changing the original database; quotations for prepared items must also occur contiguously in the original captured page. Two seven-item runs are available in the [clean architecture PRD](../clean-arch/PRD.md), one in the earlier selection order and one in recorded page-timestamp order. The source selector is not a production service and source ordering is not established event-arrival ordering. The runs expose unresolved semantic problems: citations can omit supporting facts despite an exact location match; model output can change a benchmark into a deployment, reverse a backup relation, omit a named customer or assign an unstated currency. A blinded 84-call check-placement/wording comparison and a 27-call same-article citation-completion diagnostic did not give a clean semantic fix and are not adopted. The latter missed an omitted connectivity condition and a reversed backup relationship, and left six expected evidence reviews unaddressed. A further five-round Codex–Claude council produced a narrowly scoped Step 1 link candidate, independently checked for prompt-contract drift. A six-article, 36-call blind comparison completed; the candidate still produced an explicitly self-contradictory link and both arms consistently omitted the same Kyber report and company response. It is not adopted and has not changed the active PRD prompt. A trace confirms that both the Kyber report and open Kyber thesis were supplied, and the raw model answers omitted the report and denial; the reason is not established. See ../poc/data/clean-step1-kyber-trace-2026-11-06/TRACE.md. An isolated six-call comparison showed that hiding the Kyber thesis did not recover the report or denial in any draw. A second six-call comparison returned them in 3/3 draws with the original Kyber paragraph alone and 0/3 with the full article; length, position and surrounding content changed together, so the reason is not isolated. Excerpt outputs have source-attribution limitations. Neither experiment changed state or established a production fix. (Superseded: the next task then was a whole-article coverage approach; the current next task is under \\\"One next task\\\".) See ../clean-arch/STEP1-IMPLEMENTATION-COUNCIL.md. The earlier four-round council agreed that no tested semantic fix is ready; its next investigation is a source-backed review of the 49-item historical run and its 160 evidence records, with overlapping issue flags and separate article-level omissions, then a separate comparison of the seven-item replays. See ../clean-arch/STEP1-COUNCIL-REVIEW.md. Preserve relevant evidence while identifying the next intervention; production/frozen history remains as described below. See [Step 1 run log](../clean-arch/STEP1-RUN-LOG.md) and [English reading page](../clean-arch/architecture.html).\\n\\n**Sealed (D379, 2026-11-06):** Alex asked to clean up and seal this version while he re-plans the system design. Work stops here and is sealed as it is: main's working tree is committed on branch `seal/2026-11-06` (tag `sealed-2026-11-06`) and merged into `main` on Alex's word (PR #10); the sealed split and two side experiments are pushed on their own branches (D379). No PRD 11 experiment is open, and the E1 next task below is withdrawn. The next task is Alex's re-planned system design.\\n\\n**E1 diagnosed (2026-11-06, Alex chose E1):** of 57 helpful matters frozen production wrote and then dropped, two readers agree on 17 link misses (4 core), 3 opening misses (1 core) and 24 small matters the standard itself drops; 10 are disputed on the fallback clause and 3 were quote refusals. Opening is not the experiment. The core of the link misses is the model reading a question's period, population or named configuration as a boundary; only 8 of the 13 window draws it dropped were lost to the product. No production change; $0.02 of probes. My recommendation was to fold that narrow change into the next extraction version; withdrawn by the seal (D379). Details: `docs/research/2026-11-06-e1-no-home-drops/README.md`, PRD 11 E1.\\n\\n**Split extraction sealed as a failed experiment (D378, 2026-11-06):** the split (a new-question call, an evidence call and record preparation) was benchmarked against the frozen poc-v108 and failed. Its stop line fired: helpful matters 156, 156, 159 against 166, 170, 162, with about 15% higher cost. One screened revision kept more noise than production. It is sealed in the worktree `hivemind-no-preseed-evidence-review` (tag `split-extraction-failed-sealed-2026-11-06`), and nothing of it is in main. What it taught is written as proposed production experiments in `docs/prd/11-production-experiments-from-split.md`: E1 no-home helpful drops, E2 duplicate questions, E3 ladder checks with D186, E4 judge refusals, E5 D203's revision day, E6 the measurement kit. Each opens only on Alex's word.\\n\\n**Question-catalog limit removed (D377, 2026-11-05):** Alex also directed removal of the separate 150 KB catalog rejection. The research reader in this worktree now has neither the catalog nor evidence byte limit; it retains full scoped questions, historical boundaries, dependencies and evidence. A portable 326,996-byte catalog test returns all 400 new questions and expands evidence both after reading the catalog and directly; the old 150 KB guard fails the same test in a scratch copy. The saved 69-question pilot catalog and all 69 saved evidence expansions match their original content hashes. Details: `docs/research/2026-11-05-catalog-limit/`. The full suite remains pending until the paid seven-day run no longer competes for resources. The run remains in its isolated worktree and does not call this research reader.\\n\\n**Evidence reader limit removed (D376, 2026-11-05):** Alex directed removal of the reader's 1 MB evidence-expansion rejection. In this worktree, `research_context.Reader.expand` now returns the entire evidence payload without that cap, while the catalog's separate limit remained at that checkpoint; D377 subsequently removed it. On the saved pilot ledger, all 69 individual question expansions, the four-question 1,931,225-byte pilot request and the entire 3,454,076-byte catalog produce the exact same content as the pre-change high-limit baseline; the portable oversized-ledger test passes and fails when the old cap is restored in a scratch copy. Details and snapshot-specific measurements are in `docs/research/2026-11-05-reader-limit/`. The seven-day diagnostic runs in `/Users/lchingen/hivemind-no-preseed-evidence-review/poc/data/split-fresh-seven-day-2026-11-05-v2/` with its pinned code; it does not call this research reader. Read its status through its `snapshot.sh`; do not edit its package code while it is live. This change is not an acceptance of seven-day extraction or judgement quality.\\n\\n**Start-state correction (2026-11-05):** Alex requires a research library established from real material available before the test start, then extraction against that state. The prior empty-library diagnostic cannot represent this case. Our own mistakes and the current 68-question provenance audit are in `../hivemind-no-preseed-evidence-review/docs/research/2026-11-05-parallel-refinement/own-mistakes-2026-11-05.zh.md`. Two new A-only calls were run on 2026-08-29 articles using the 68-question prior-day snapshot; both proposed the same aggregate supply-commitments topic. A source/context review judged it distinct from the existing specific SK Hynix question. A third A-only call on an author-body excerpt about DLSS 5, already tracked by v22, passed; the prompt also restricts software updates, so the reason is not established. No writer or dedup ran; source-history completeness remains unverified, and this is not scored acceptance. Details: ../hivemind-no-preseed-evidence-review/docs/research/2026-11-05-parallel-refinement/start-state-diagnostic-2026-11-05.zh.md.\\n\\n**Measurement correction (2026-11-05):** Alex clarified that a gold-worthy topic already in the supplied library should not open again; an absent worthy topic should open. The earlier simple-A claim of a \\\"missed\\\" new topic was not scored against that rule and is withdrawn as a correctness conclusion. In the actual experiment, a Kyber topic was shown and passing follows Alex's topic-level rule; whether its exact release question captures the shipping milestone remains unverified. The experimental pre-article snapshots differ from the replay's day-start snapshots; 9 of 10 inspected examples differ. The current uncommitted replay default does not build a cold-start library; committed main HEAD still uses the old seed and startup filing path. Historical lexical coverage has a confirmed unrelated-topic match. The frozen gold and past scores remain unchanged. Audit: `../hivemind-no-preseed-evidence-review/docs/research/2026-11-05-parallel-refinement/measurement-context-scrub-2026-11-05.zh.md`.\\n\\n**Simple new-question diagnostic (2026-11-05):** At Alex's direction, an isolated prompt returned new questions plus article evidence without asking for product database fields. Four previously seen real dev articles each ran once: three returned one candidate, one returned none, all four quotes matched their source, and the gold-listed GPU backstop amount question was not proposed. Whether that omission is a new-topic miss depends on whether the existing library covers the topic. Two other candidates require source and independent-significance review; the actual experimental snapshot already had a Kyber topic, so its pass follows Alex's topic-level rule; whether its exact release question captures the shipping milestone remains unverified. This is not a production or full-pipeline acceptance. Details: `../hivemind-no-preseed-evidence-review/docs/research/2026-11-05-parallel-refinement/simple-new-question-results.zh.md`.\\n\\n**Split prompt structure v3 read diagnostic (2026-11-05):** One real reading-stage call on a previously seen article found the revenue/margin guidance and Trainium scale but omitted the gold China revenue/market-loss matter. The prewritten stop condition was triggered and the linking call was not sent. This is one draw and not a production or end-to-end result. See `../hivemind-no-preseed-evidence-review/docs/research/2026-11-05-parallel-refinement/structure-v3-read-result.zh.md`. D374 removes the model sampling field from active settings and default configs; historical config files and archives retain their original bytes.\\n\\n**Split prompt structure v2 small test (2026-11-05):** Thirty calls on two previously seen golden-v5 dev articles completed in `../hivemind-no-preseed-evidence-review`. The blind model reader found complete helpful matters in the fresh control versus new A+B of 6/19 vs 10/19, 11/19 vs 7/19, and 9/19 vs 12/19. The new arm also retained more gold not-kept matters in each draw; B missed useful margin guidance and one answer reused IDs, with a demonstrated matching collision. This is not a production acceptance. See `../hivemind-no-preseed-evidence-review/docs/research/2026-11-05-parallel-refinement/structure-v2-results.zh.md` and `reports/2026-11-05-parallel-structure-v2.html`.\\n\\n**Split extraction small test (2026-11-05):** At Alex's request, the isolated `hivemind-no-preseed-evidence-review` worktree ran two real golden-v5 articles once through each split lane. An independent model reader found 7 of 19 helpful gold matters fully retained, two partial, two written then dropped, eight missed, and one retained gold not-kept matter. Three saved v108 draws on these articles retained 7, 9 and 12 of 19, but used 22 seeded questions while the new test used 8/10-question snapshots; these are not directly comparable. The experiment remains unaccepted; see `../hivemind-no-preseed-evidence-review/docs/research/2026-11-05-parallel-refinement/small-scored-test-20261105.md` and `reports/2026-11-05-split-small-test.html`.\\n\\nAs of November 5, 2026; decisions through D374. [Decisions](DECISIONS.md) holds what is decided now; the [design page](system-design.html) and the [module PRDs](prd/README.md) hold what the code must do; the [README](../README.md) holds startup, build and run instructions.\\n\\n## Future evidence scoring (D372)\\n\\nAlex decided future gold scoring should measure helpful versus not helpful evidence without requiring separate scores for core and supporting. Use frozen golden-v5 as-is: combine core and supporting as helpful, treat not-kept as unhelpful, and keep optional entries neutral. A counting report has not yet been implemented. Historical scores retain their original definitions. D373 removes the stop caused by a separate concern about three question-gold entries: keep the gold unchanged, continue scoring and disclose the concern; see `../hivemind-no-preseed-evidence-review/docs/research/2026-11-05-parallel-refinement/ruler-conflict-2026-11-05.zh.md`.\\n\\n## Latest decision (D369)\\n\\nAlex decided in D369 to capture core and supporting evidence without a strict boundary and in D370 to remove the 22 preset starting questions and separate earnings-report import. The replay entry now defaults to `poc-v118` (D374), refuses old seeded ledgers and baseline configurations, and continues to read existing non-seeded questions; earnings releases remain normal source items. This change has local contract tests but has not passed end-to-end product acceptance. The frozen historical rulers and results remain unchanged.\\n\\nThe small 2026-11-05 study used three archived NVDA articles and an 8/28 historical 68-question snapshot: without versus with an appended report, independent AI review found 14/27 versus 13/27 complete matters. This measured appended extraction context, not the distinct former coverage-start step; D370 removes both by Alex's decision. Full traces and limitations are in the separate `hivemind-no-preseed-evidence-review` worktree under `docs/research/2026-11-05-real-input-evidence/existing-library-results-2026-11-05.md`.\\n\\n\\n**One-day smoke completed (2026-11-05 UTC):** Alex requested a quick 1–2 day end-to-end test. One day, 2026-08-29, ran in `/Users/lchingen/hivemind-no-preseed-evidence-review/poc/data/v117-one-day-smoke-2026-11-05/`: config v117, an 8/28 historical library, 40 extraction calls, 93 evidence records written, four new questions, 54 judged and zero terminal failures. Two judgement attempts were refused and corrected. A Microsoft revenue forecast of $391.1bn was assigned to a rung whose upper bound excludes $391.1bn; the same article's actual quarterly revenue and next-quarter guidance were dropped with no home. Some source dates and bodies are not verified, and an independent 14-article sample review was incomplete due to truncated text. This is not semantic or production acceptance. Findings and scope: `docs/research/2026-11-05-real-input-evidence/one-day-v117-smoke-2026-11-05.zh.md` in that worktree. The clean source-text comparison and its condition-hidden review are complete; council discussion of next steps is ongoing.\\n\\n**D371, in progress:** Alex directed that present and forward-looking revenue and financial information should be tracked. Diagnose the same-day extraction and filing losses before designing a general change. No new financial tracking implementation has been accepted yet. The old frozen standard and gold are unchanged. The original prompt-only pilot failed design review. The user approved an exact prompt addition for an experiment; it is not a production implementation. Four paired real-article diagnostic calls per arm completed for the exact approved sentence: v74i versus experimental role-d371-pilot. Microsoft next-quarter guidance and NVIDIA FY2028 guidance still dropped in the treatment; a single draw is not acceptance or proof of causation. Details: docs/research/2026-11-05-real-input-evidence/d371-prompt-pilot-results.zh.md (isolated worktree). The requested full prompt audit and restructure were drafted experimentally; five real-article paired diagnostic requests per arm completed. Microsoft revenue guidance was missed in both arms, and the draft produced unsupported original dates, a quote refusal and suspect links. No production prompt change or acceptance; see restructure-pilot-results.zh.md in the isolated worktree.\\n\\n**Clean Step 1 coverage council (2026-11-06):** Codex and Claude Code independently reviewed the existing attempts and completed three discussion rounds. The proposed next research candidate moves the existing evidence-reading block ahead of the thesis-opening block while preserving the article, open-thesis state and paired output. It is a hypothesis, not an implemented or validated fix. A complete prompt/contract audit and independent review precede any controlled Luna comparison. Historical paragraph-based and source-first experiments, their noise and attribution problems, and the rejected overlap-based merge are recorded in [the council review](../clean-arch/STEP1-COVERAGE-COUNCIL.md). No new Luna experiment was run in the council.\\n\\n**Clean Step 1 coverage order result (2026-11-07):** The isolated 54-call clean comparison completed and all answers were reviewed blind. Moving the evidence-reading block recovered a known Kyber report and denial in one of three candidate answers against none in three controls, with attribution blur; it also produced unsupported gaming-to-AI links in two candidate answers and no controls. It is not adopted. A separate exact-quote example misattributes an executive's prediction in the standalone summary. [Results and replay](../clean-arch/STEP1-COVERAGE-ORDER-RESULTS.md) record all selected cases, uncertainties and source-fidelity work; no production ledger was written.\\n\\n**Clean Step 1 fidelity council (2026-11-07):** Codex and Claude Code completed five rounds on source attribution, conditions, dates and meaning. No tested fix or root cause is established. The agreed source-to-record review of 49 articles / 160 evidence items and the subsequent isolated field-order comparison are complete; the later 54-answer / 217-record repeated sample remains separate. Prior source-first, quote-first and follow-up-review experiments and their limits are recorded in [the fidelity council](../clean-arch/STEP1-FIDELITY-COUNCIL.md). No Luna experiment or production change was made in this council.\\n\\n**Clean Step 1 fidelity review (2026-11-07):** All 49 saved source packets and 160 original evidence items have received a source-and-record review; focused independent cross-checks cover the findings and selected controls. The [review and article replay](../clean-arch/STEP1-FIDELITY-REVIEW.md) distinguish source contamination and missing source material from model meaning, citation, date and link issues. The [isolated schema property-order diagnostic](../clean-arch/STEP1-CITATION-ORDER-RESULTS.md) completed all 66 calls and condition-blinded article reviews. Several omissions and semantic errors persisted; it did not establish a fix and is not adopted. It used saved articles and before-states without changing production.\\n\\n**Clean Step 1 source handoff council (2026-11-07):** The ongoing [council and offline checks](../clean-arch/STEP1-SOURCE-HANDOFF-COUNCIL.md) reconstructed 16 matching article-34 controls, all omitting a Kyber report and denial; the cause remains unknown. The 20-article saved source-role overlap review distinguished previously cited AI-generated summary lines and an unrelated recommendation from authored body. The clean runner does not send the saved source-role labels; the council chose to first compare original and previously selected source text on ten known articles. The isolated 60-call source-text comparison and condition-hidden review are complete; [results](../clean-arch/STEP1-SOURCE-TEXT-RESULTS.md) show specific contamination reductions alongside persistent omissions and changed meaning. It did not advance state or write production. The isolated six-article low-versus-medium source-fidelity diagnostic completed 36/36 calls and condition-hidden review. [Results](../clean-arch/STEP1-REASONING-FIDELITY-RESULTS.md) show partial improvements alongside persistent source-qualification and attribution concerns; no production setting is changed. The [prompt audit](../clean-arch/STEP1-FIDELITY-PROMPT-AUDIT.md) maps the observed failures to the full request and signed standard. The six-article isolated schema-description comparison completed 36/36 calls and condition-hidden review; the candidate did not preserve the repeated example qualification and is not adopted. [Results](../clean-arch/STEP1-SUMMARY-FIDELITY-RESULTS.md). A further six-article 36-call low-versus-medium comparison used corpus-cleaned sources outside the original 49-item clean replay and a fixed exploratory context; results were mixed, including unsupported links and incorrect attribution/date fields. [Results and replay](../clean-arch/STEP1-ADDITIONAL-SOURCES-RESULTS.md). The structured-claims candidate was not sent after review revealed scope and complexity concerns. Council review of the next action is ongoing. The date-text schema-description diagnostic completed 48/48 calls on eight known cases, with mixed results; the candidate is not adopted. A selected-run census found twelve literal \\\"null\\\" strings in date-text fields, but no production writer impact is established. [Results and replay](../clean-arch/STEP1-DATE-DESCRIPTION-RESULTS.md). A further preregistered eight-source date comparison completed 48/48 calls; the candidate lost a supported company-article statement date in all three draws on one source and is not adopted. [Results and replay](../clean-arch/STEP1-DATE-NEW-SOURCES-RESULTS.md). A bounded corpus census confirmed 163 source pages across three explicit generated-summary structures whose labels were removed while some summary text was retained; two NVIDIA cases were reproduced through the cleaner. [Source provenance investigation](../clean-arch/STEP1-SOURCE-PROVENANCE-CENSUS.md). A read-only source-lineage replay reproduced 363/363 cleaned pages with current inputs, preserved ambiguous original-line locations, and surfaced the generated-summary label loss for review. [Source investigation and lineage replay](../clean-arch/STEP1-SOURCE-PROVENANCE-CENSUS.md). An offline neighboring-context observation exposed only 144 or 149 of 163 known labels and introduced many other page lines; it is not adopted as a general source fix. [Observations and viewer](../clean-arch/STEP1-SOURCE-CONTEXT-OBSERVATIONS.md). A new [saved-quote integrity investigation](../clean-arch/STEP1-QUOTE-INTEGRITY-CENSUS.md) reconstructed 360 saved answers across eight overlapping cohorts, including 78 prepared-source calls. Five saved unverified passage instances were complete matches under the existing normalization; an in-memory candidate recovered their original slices, while ten others remained unverified. The normalized source-slice lookup is now installed only in the isolated clean Step 1 runner; saved-answer and entry-point checks are recorded there. Page provenance, Unicode completeness, production resource budgets and writer integration remain open. The existing writer stores only one quote, whereas 63 of 160 evidence items in the 49-article exploratory trace have multiple passages. A [source-first 49-article coverage review](../clean-arch/STEP1-COVERAGE-CENSUS.md) separates material missing from the model input from source-visible omissions in the saved answers, with uncertain matter boundaries labeled. (Superseded: the next investigation then was why supplied material is missed; the current next task is under \\\"One next task\\\".) The canonical prompt and production configuration remain unchanged. Adding fallible role annotations remains a separate untested candidate. Council streams and handoffs are in `poc/data/clean-step1-ongoing-council-2026-11-07/`.\\n\\n## What runs\\n\\n- **Pipeline (replay default `poc/config/poc-v118.json`, D370, D374).** Every item reads the relevant open questions from the library at the start of its day, then extraction v74i on `gpt-6-luna` proposes evidence and questions; Jev matching with the collision judge matches them; code writes the records; judging-v7 judges changes once a day; pull mode closes due questions. There is no separate seed or coverage-start report import, and reports as source items remain eligible. This default has not completed end-to-end acceptance. The [pipeline guide](poc/pipeline-plan.md) maps stages to code.\\n- **Measured:** one company (NVDA) over one 14-day window (2026-07-01 to 07-14), the judgement scored at the window end on the frozen ruler (AGENTS §7.1). Three draws of `poc-v116` against three of `poc-v108` run in the same hours: 53 against 45 agreements of 57; operating margin and capex agree in 3 of 3 draws, never judged without the coverage-start reading ([acceptance](research/2026-11-04-filing-end-to-end/acceptance-design.md)).\\n- **Served data:** the service, the MCP server and the standalone page serve the sealed three-month ledger `served-2026-10-28-v34-nvda-3m-through-0828` (68 theses, 34 groups; D358), built by the earlier `poc-v34` pipeline, not by the replay default. HTTP `/library`, MCP `thesis_library` and the standalone page share the dated bundle writer.\\n- **Idea API:** `poc-v118-idea` (D290, D335, D374): two discovery calls and one adoption and weighting assessment; only adopted theses with positive weights appear, and nonempty plans total 100%. The [Idea contract](poc/idea-card.md) owns its fields and the limits of its scores.\\n- **Interface:** the Thesis Library and Explore Ideas workspaces, with the confidence Trigger and an Action preview (no wallet connection or order execution). The [UI specification](poc/thesis-ui.md) and the [integration guide](../poc/ui/README.md) own its behaviour.\\n- **Repository:** `main` holds the product, the frozen ruler and the research records; run databases, logs and model archives stay on disk (D353), located by the [data manifest](research/2026-10-25-english/data-manifest.md). Worktrees: `/Users/lchingen/hivemind` is the main checkout, where slice branches are cut from `main`; `/Users/lchingen/hivemind-extraction-quality-2026-10-28` (the extraction branch, merged on 2026-11-03) keeps in its ignored folders the stored end-to-end runs of `poc-v91` to `poc-v95` that later comparisons read (D359); `/Users/lchingen/hivemind-run-v109-2026-11-04` is the finished judging-v8 run's worktree. Older branches stay in Git without worktrees (D359); none is merged work in progress. The clean source-text comparison and its condition-hidden review are complete; council discussion of next steps is ongoing.\\n\\n## Open defects\\n\\n1. **Competitor and customer news is filed under the company's revenue questions** instead of the share, capital-spending or custom-chip question it informs (D355; filing is otherwise about 85% right). Share facts are often not written at all, an extraction recall miss. The total-revenue question holds about a quarter of all links (D354).\\n2. **One bet opened twice** about one encounter in five: the collision judge splits a seed question from an identical candidate on a fine detail (D354).\\n3. **A question the standard rules out** (the lidar legislation) was proposed by the extraction and opened in one draw of three (D354).\\n4. **A thesis opened from an article gets no dependency of its own**: the default Jev matching asks for none (`views/jev_matching.py`), although D51 has the matching call choose them; themes still reach every company thesis through the theme block (D191, D195). Found in the 2026-11-05 consolidation; building it is decided (D368).\\n5. **Historical coverage-start reading, retired by D370** (D364–D366): the capital-spending line is missed in about one read in six (the question is then left as it was); a labelled guidance figure is written with the fact tier; later reports reach the questions only through the daily stream; `scripts/preflight.py` does not replay the reading's check.\\n6. **Measured on one company and one 14-day window**, the judgement scored at the window end only; no version of the current pipeline has completed a longer window (a 60-day run of `poc-v108` was stopped at Alex's word after 2026-07-15, [log row 8](research/2026-11-04-argument-record/log.md)). The China-share question (v17) swings between draws (0 of 3 in the acceptance, 2 of 3 in its control, 1 of 3 in the frozen draws): two readers found the starting figures did not cause the acceptance's drop, and the byte-identical extraction request kept a \\\"share fell to zero\\\" sentence in two candidate draws and dropped it in two control draws. One acceptance draw judged nothing on v16; its cause is not established.\\n7. **What a judgement reads grows with the window** (D358). Argument records (D201) were measured as the remedy on 2026-11-04 and not built: judging-v8 agreed 12 of 17 against 15 of 17, judging-v9's card added little at about half again the judging cost; their code was removed at Alex's request ([log rows 4–11](research/2026-11-04-argument-record/log.md)).\\n8. **Seen once, not traced.** A judgement named a shown theme as a dependency and the check refused it twice, stopping a draw for a day (2026-11-02, D266). The sealed run's review recorded that a succession's opening evidence is not linked to the new question (D358), not yet checked against today's code.\\n9. **Earlier defects, unchanged.** Matching (build log row 49): another document's copy of a figure can be treated as new evidence; one matter can occupy several groups; same-answer candidate references caused seven chain or duplication decisions of the generative matcher; empty `original_who` values can count as the same party; different names for one population cause two of nine Jev merge misses. Nine 2026 aggregate-spending theses under `ai-capex` each have a different population; whether to combine them is a product choice. Extraction's instructions remain narrower than the PRD's important-question rule and omit the personal-memo exception, and extraction can change a quantity's meaning before matching (a guarantee amount against financing provided). Classification keeps its [recorded simulation defects](research/2026-10-25-english/classification-existing-defects.txt). The corpus audit recorded 97 official notices with 56 body and file-name collisions, to re-fetch before relying on a rebuilt corpus. An older intermittent search-test failure is untraced. Fresh Idea allocations vary while saved weights do not; the confidence chart applies the current plan to past states and is not a calibrated probability; broad analyst-prose quality and fresh Idea stability remain unaccepted (the [Idea contract](poc/idea-card.md) lists its limits); generative matching dependencies await `matching-v4`. The readers' doubts about the frozen standard, listed in the [extraction branch's state page](research/2026-11-01-e2e-loop/current-state-extraction-branch-2026-11-03.md), remain for Alex.\\n\\nUpstream supply and the human review pool's output remain deferred.\\n\\n## One next task\\n\\n**Where the lean path stands (2026-11-15; D489 to D542).** Alex is not active (D509); D439 is in force: choices go to the\\ncouncil (an independent Codex review and Claude) until consensus, recorded citing D439; nothing is pushed, deployed, published or\\ncommitted; paid calls stay within D439's $40 ceiling (about $18.42 recorded; $0.0134 sent in this period, the ten judge calls of\\nD511 and D519; the lean path $8.34 in all). Every stretch below is closed; its full record is in the decision log and in\\n`research/2026-11-14-use-acceptance/LEAN-LOG.md` (sections 1 to 43).\\n\\n- **The choice between the systems is not made.** The fresh week did not separate them (D489, \\\"not clear\\\"; nothing since ranks\\n  them). The comparison that could choose by measurement was sized and not sent: at the proposed size it may miss differences\\n  that matter ([sizing](research/2026-11-14-use-acceptance/comparison/COMPARISON-SIZING.md), D517). **Production stays the default\\n  and both systems stay (D518).** Alex's product choice on the company's financial figures stands (D505: evidence for related\\n  questions, no table and no questions of their own; D382 and D384 stand).\\n- **For Alex:** the [decision page](research/2026-11-14-use-acceptance/DECISION-PAGE-2026-11-15.md) (its section 7 is the one list\\n  of what is his to choose, what he has decided and awaits building, and the defects with their evidence), the\\n  [side-by-side week](research/2026-11-14-use-acceptance/side-by-side/SIDE-BY-SIDE-WEEK.md) and the\\n  [judge note](research/2026-11-14-use-acceptance/unsupported/DESIGN-NOTE.md) with its one choice.\\n\\n**Open defects found on this path, each with its evidence; nothing is built on any of them:**\\n1. **The new system's delivery gap** (D506, D508, D513, D514): a kept fact that bears on a question by a step of reasoning may be\\n   linked to another question or to none, and so never reach that question's judge; the later-linking step skips a group whose\\n   original statement arrived under another question. Three confirmed fact-and-question pairs in the fresh week, 23 unresolved\\n   ([census](research/2026-11-14-use-acceptance/delivery-class/CLASS-CENSUS-RESULT.md)); one six-call test of its effect was\\n   inconclusive ([result](research/2026-11-14-use-acceptance/effect/EFFECT-TEST-RESULT.md), D511). Paused.\\n2. **The judge, shared by both systems** (D519, D520): on a question that asks for an amount it names a band when nothing shown\\n   sizes the amount, or closes the last gap with a number of its own (36 of 438 stored readings, many of them the same\\n   question read on successive days: a failure pattern on a few question paths, not an error rate;\\n   [census](research/2026-11-14-use-acceptance/unsupported/UNSUPPORTED-CENSUS.md)). Three of the ten settled unsupported answers\\n   coincided with a figure the system held and had not delivered to that question\\n   ([result](research/2026-11-14-use-acceptance/missing-input/MISSING-INPUT-RESULT.md), D530 to D532). What the product shows is\\n   Alex's choice (the judge note).\\n3. **The old system's duplicate questions** (D520 to D523): three pairs in the fresh week; one second question was never compared\\n   with the first, the others were compared and kept apart\\n   ([result](research/2026-11-14-use-acceptance/duplicates/DUPLICATES-RESULT.md)).\\n4. **The old system's filing under the broader question** (D529 to D531): the data-center revenue question never received the\\n   next quarter's guidance or a consensus for the year, filed under total revenue only\\n   ([cases](research/2026-11-14-use-acceptance/d375-measure/SAME-DAY-CASES-RESULT.md),\\n   [trace](research/2026-11-14-use-acceptance/missing-input/FILING-TRACE-RESULT.md)). The relation `docs/prd/10-filing-phase.md` §2 names.\\n5. **Where decisions and code part on dependencies** (D541, D542): `writing.write` drops an edge that would close a circle with a\\n   note where PRD 06 says refuse and ask for a correction; PRD 06's \\\"historical only\\\" branch has a reader and no writer; the\\n   label the seeding module writes on every seed edge (`last_end`) is defined nowhere; no decision says what happens to a later\\n   proposal with another direction for a pair already read.\\n\\n**Decided by Alex, awaiting implementation and acceptance (not asked again):**\\n- **D375, each article sees the questions committed before it.** A passed, bounded serial proof with labelled fake answers\\n  ([result](research/2026-11-14-use-acceptance/duplicates/D375-PROOF-RESULT.md), D526, D528); the eligible same-day cases of the\\n  fresh week read (D529). A real measurement needs a new version of the reading request and a paid run; not opened.\\n- **D368 item 2, the matching step chooses a new question's dependencies.** In the unseeded fresh week one clear case among 97\\n  pairs (data-center revenue reading total revenue;\\n  [census](research/2026-11-14-use-acceptance/dependency-selection/DEPENDENCY-SELECTION-CENSUS.md), D537). As the code stands\\n  one stored edge has two readers (whose conclusion to read; which of two homes is the narrower): the same edge would remove\\n  seven filing links ([proof](research/2026-11-14-use-acceptance/dependency-selection/EDGE-PROOF-RESULT.md), D538). A design that\\n  reads the two uses apart is recorded as **a provisional candidate, not sound for build**\\n  ([design](research/2026-11-14-use-acceptance/dependency-selection/SEPARATION-DESIGN.md), D539 to D542): two proofs on stored\\n  data, the package's suite run under it, every stored dependency row classed. If the slice is reopened, its review must first\\n  settle the cycle through an awaited question at creation, closing behaviour, a theme shown twice, the historical readers and\\n  the label. A statement's home is not something an edge can decide (its section 2.5): the reading step's, the filing phase's\\n  subject. No selection call is designed; nothing was sent.\\n- **D368 item 4, the reading direction for preset questions** (settled by Claude on Alex's delegation): not measured (D536); the\\n  stored seeded draws already agree with the frozen reference on 15, 15 and 16 of 17 questions; the rebuild and dry-run harness\\n  is kept ([page](research/2026-11-14-use-acceptance/dependency-channel/CHANNEL-ASSESSMENT.md)).\\n\\n**The choice is made by the council under D439 (D544, 2026-11-15): the work toward production carries forward on the new\\nsystem; the old system stays the running default until the new one passes its gates; both remain.** Nothing that runs is\\nswitched, deleted or deployed. It is not a finding that the new system's answers are better: the cold reflection (D543) found\\nnothing that ranks the two systems' answers, and the first consensus left the choice to Alex; that deferral was withdrawn the\\nsame day, because his words in D439 give the council the job of taking a course. Reasons: he had reopened work on the rebuild\\nand D439's scope names its steps; it follows the product rule on financial figures he last confirmed (D505); the fresh week\\ngives no demonstrated reason to abandon it and shows fewer trivial or duplicate questions in that one run. Kept in view: its\\nanswer-choice step has not met its lines, Stage B did not pass, integration is undone, and its cost and time to production are\\nunknown. **Alex's word overrides this at any time**; it is also reconsidered on a change of his product rule, a sound comparison\\non shared subjects that favours the old system, or the rebuild failing its unchanged gates within a bound agreed later. A first\\ncheckpoint: $5 of further spending without a candidate that passes its prewritten small test returns the direction to the\\ncouncil.\\n\\n**Since the choice (D545 to D550, all under D439):**\\n\\n- **The fresh week's answer choices, read and traced (D545 to D547).** Of 21 attempts on seven questions, one agreed fault of\\n  Alex's lines (a condition of the topic left out of the choices, six attempts); ranges written with no figure were overrun by\\n  the first filed amount on two questions (the old system shares this). A census of 49 amount questions and an audit of the\\n  request found an undefined term (\\\"the topic's wording\\\") and no mechanism general enough to design for; no prompt change\\n  ([result](research/2026-11-14-use-acceptance/fresh-ladders/FRESH-LADDERS-RESULT.md),\\n  [audit](research/2026-11-14-use-acceptance/fresh-ladders/PROMPT-AUDIT-LINE-2.md)).\\n- **The gates the new system must pass (D548), in order:** the answer-choice step on Alex's lines (D400), not passed; the\\n  judge on the system's own questions (D428), not passed; the end-to-end comparison with Step 2's checks (D427, D431), still\\n  owed, \\\"beats\\\" not yet defined in numbers; use on unseen news (D484), its lines proposed and not his; integration and\\n  release, not written ([frame](research/2026-11-14-use-acceptance/NEW-SYSTEM-FRAME.md)).\\n- **The first blocker (D549):** the step declines some worthwhile questions. From the July refusal review, no general,\\n  permitted change recovers them: no candidate.\\n\\n**The one-week diagnostic of the answer choices is run and read (D550 to D554, 2026-11-15): not clean.** Nothing is live. The\\nnew system read the 272 articles of 2026-10-06 to 10-12 in two parts (the first part stalled when the laptop slept with a call\\nin flight; it was ended and continued from the library after article 120, D551, D552); only the topics and the answer choices\\nwere then run (the matching and the judge are recorded as not run, D553; they can be run later from the merged trace by a\\ndecision of their own). Result ([page](research/2026-11-14-use-acceptance/second-week/RESULT.md)): 13 topics; of 39 attempts at\\nanswer choices 9 were declined, on 4 topics, two of them in all three attempts; three of the zero-fault lines are missed on\\nfaults both reader families agree on; the count by written choices is missed (6 of 12 against 8). The fresh week's picture (no\\nrefusal) did not repeat. It is evidence, not a gate: it passes nothing and reverses nothing. Traced at $0: the largest reason\\nfor declining over every stored run (22 of 37 refusals) is a topic that asks two things (two years, or two figures), which the\\nstep declines by Alex's own rule (D397), a known open defect \\\"until splitting is built\\\"; it starts in the first step's field\\nfor what a topic tracks. Ledger $3.67 of the run's $3.95; paid calls under D439 about $22.10 of $40 (Claude's ceiling). D544's\\n$5 checkpoint is reached for further weeks, so the direction is back with the council.\\n\\n**Changed in the code (D552):** each call of the new system's first step waits at most 600 seconds on a silent connection\\n(`clean-arch/step1/live.py`, `CALL_WAIT_SECONDS`; five tests). Before it, a machine that slept during a call stopped the run for\\ngood; with it, the second part survived eight lost attempts and a second sleep.\\n\\n**Open defects found on the way:** (1) a lost attempt is charged its whole reservation on the ledger (about $0.12 against a\\ncent for an answered call): eight of them used up the room for the matching and the judge; the rule is the design's and was\\nnot changed. (2) The note given to the answer-choice step and to the readers says a year's figures are \\\"published around\\n2027-02; use that day\\\", while code sets the due day 60 days after the fiscal year-end (D414): the two reader families read the\\ndue day apart on 23 points. (3) Reader sessions' dollar cost is not known and is outside every ledger.\\n\\n**After the diagnostic (D555 to D558, all at $0):** the council refused a rule that would take the first-named figure as a\\ntopic's main one (D397, D469, D470); a study of the \\\"no main part\\\" refusals found no candidate\\n([study](research/2026-11-14-use-acceptance/second-week/NO-MAIN-BOUNDARY-STUDY.md)); a map of all four stored readings, reconciled\\nto their reports, shows agreed faults on the zero-fault lines in every reading (6 to 8 marks, of kinds that change) and no\\nbounded way on the record to bring the four to zero together ([map](research/2026-11-14-use-acceptance/second-week/FIRST-GATE-MAP.md));\\nan audit of the two classes that are the step's own (an event's reference; unlisted parts) with an independent second read\\nfinds no bounded, product-relevant repair ready ([audit](research/2026-11-14-use-acceptance/second-week/PROMPT-AUDIT-TWO-CLASSES.md)).\\n**The first gate is recorded as not met; Alex's lines (D400) stay as written; no pass is claimed.**\\n\\n**The core-problem council (D559, 2026-11-15; asked by Alex after the week's result, his words in the decision log), all at $0:** the product\\nproblem is forming answerable questions: a worthwhile matter is left without an answerable question, or a delivered question\\nasks a materially different or potentially unresolvable thing; no single cause is proven. Over July's three runs two reader\\nfamilies found 18 matters: the same judged question in every run that opened it on 3 (a fourth disputed), delivered but\\ndifferent on 3, a question in one run and a refusal in another on 4, refused in both on 1, opened by one run of three on 6.\\nThe clean measurements examined (July, the weeks of 09-22 and 10-06) each start from empty, which the start-state correction\\nof 2026-11-05 above says does not represent the test with an existing research library; that record had no decision number\\nand was not carried into D466 or D469. In the two later weeks, by two families with the articles, 18 of 20 opened topics were\\nstanding matters, 16 of 20 were opened from an article that mentions the matter in passing, and 10 of 20 were on a matter an\\nearlier-dated library already held a question on. These classify 20 selected topics; they are not a rate, and nothing shows\\nyet that a carried library prevents the failures ([council](research/2026-11-14-use-acceptance/reflection-3/cold-codex-5.md),\\n[round log](research/2026-11-14-use-acceptance/LEAN-LOG.md) §51).\\n\\n**The one next task waits on Alex's word (D559):** his confirmation that the next product-oriented test returns to a real\\nstarting library, and then one small comparison: the unchanged first step reads the week of 10-06's opening articles twice on\\nthe same inputs, once from the week of 09-22's own library and once from empty, one draw, read by his rule of 2026-11-05\\n(a matter the library already holds, not opened again, is correct; a matter it lacks, opened, is correct; his words in D559) against the library actually shown, with the\\ndelivery of the article's facts checked apart. The five proofs asked before any send are done at $0 (the starting state, the articles, both\\nrequests through the real entry point, the cases and the reading fixed beforehand, the ledger and the stopping rule under the\\ntrap; [design](research/2026-11-14-use-acceptance/carried-library/DESIGN.md)): 22 reads, a new ledger with a ceiling of $1.00,\\nabout $0.5 expected. Nothing is sent before he says so. D558's completion of the week of 10-06 is superseded as the next step; its\\n[design](research/2026-11-14-use-acceptance/second-week/COMPLETION-DESIGN.md) stays, unsent. The empty-start results and the\\nrecord of the first gate stay as they are.\\n\\nThe paragraphs below are the record of where the clean path's Step 4 stood on 2026-11-12.\\n\\n**Clean Step 4 (D396–D430):** the ladder step was measured four times and has not passed Alex's lines; it is frozen as it ran\\nin the fourth measurement (D426). The frozen judge's baseline on the ruler's ladders is read (3% unsupported, all in figure\\nquestions). **Stage B (the judge on the ladder step's own questions) ran and does not pass** (2026-11-12,\\n[result](../clean-arch/step4-2026-11-10/stage_b/STAGE_B_RESULT.md)): the control line is unexercised (4 controls comparable with\\nreader B's material shown, 8 needed; all 4 agree); the judgement lines are met except the last-judgement line on its strictest\\nreading (3 of 24). Next: the diagnosis of how Step 1 cuts a matter into theses (D432), including council B's $0 trace of the 8\\ncontrols excluded on the question and the 3 with missing material; the end-to-end gate is against production as it now runs,\\nwith no preset questions (D431). Where the whole clean path stands, read by the council:\\n[progress](../clean-arch/step4-2026-11-10/PROGRESS-2026-11-12.md), [consensus](../clean-arch/step1-unfiled-2026-11-08/council/kr-consensus.md).\\n\\n- **What Step 4 is:** the first thing built and tested is the **ladder step alone**: the call that turns a thesis Step 1 opened\\n  into one judged question with its answer ladder and due day, or declines. The frozen judge follows only when the ladder step\\n  meets its lines (Stage B, run 2026-11-12: does not pass).\\n- **Alex's decisions in force (2026-11-10):** one judged question a thesis, the other parts shown as not judged (D397); the step\\n  carries D186 in full (D398); the request may teach how to build an event's five states (D399); Stage A is read against his six\\n  fixed lines with no paid control arm (D400); build and send Stage A capped at $3, a missed line stops and goes to him (D401);\\n  an event's due day is a stated date or the period's last day (D403); a theme's state is never named with a company label\\n  (D404); a reference's words are the article's own, else the answer is sent back once (D405); the build uses the request as\\n  first sent, and code refuses and sends back the faults of writing (D407).\\n- **How the build was reached:** twenty single reviews and five rounds by angle did not reach zero findings (15, 9, 15, 11, 11);\\n  four small sends ($0.105) then showed that sentence changes to the request corrected the writing and lowered the declining of\\n  topics with no main thing (`clean-arch/step4-2026-11-10/probe-2026-11-10/READING-claude.md`).\\n- **The build** (`clean-arch/step4-2026-11-10/ladder/`, `stage_a/`): the step, its model caller, the Stage A runner with one\\n  spending limit and an on-disk ledger, the accounting, the readers' packets and the collection of readings; 109 tests, with a\\n  mutant for each check (40, 11 and 16, all caught).\\n- **Stage A, sent 2026-11-10** (44 stored theses, three sends each; $0.17 of the $3): 111 ladders, 17 declined, 4 refused twice\\n  by code. Two reader families and a third reader on the 73 marks where they differ:\\n\\n  | line | as ruled | whoever reads |\\n  |---|---|---|\\n  | 1. no ladder asks another question | missed, 11 of 111 | 0 failed by both families |\\n  | 2. no ladder leaves a part unlisted | missed, 4 | 0 failed by both |\\n  | 3. no outcome with no rung or two | missed, 16 | missed, 7 failed by both |\\n  | 4. no refusal without a justified reason | missed, 2 of 17 | missed, 1 failed by both |\\n  | 5. 35 of 44 theses right in two of three sends, 28 by a ladder | missed, 21 and 16 | 36 and 30 if every differing mark held |\\n  | 6. the three sends agree | missed: the favourable end differs in 2 of 8 theses, the due day in 11 of 32 | by code |\\n\\n  The two families read the form at different strictness (47 against 84 of 111 ladders sound) and the third reader is of the\\n  stricter one, so the count as ruled is the strict reading. The 25 ladders both families fault are the firm set: five states\\n  for the company in 10 of 17, yes/no in 2 of 24, figures in 12 of 67.\\n- **The classes** (result page): an event's five states (gaps, overlaps, labels, the object); a Yes that needs a confirmation\\n  the No does not; a reported amount carried as the market's expectation, and an expected range the field cannot hold; a\\n  figure's due day estimated anew in each send; the direction of a commitment's amount; a company's quarterly figure laddered; a\\n  group named and not listed, which the families read differently.\\n- **Stage A does not compare the step with production** (D400). The reference reading of 36 production ladders, other\\n  questions, held every firm mark on 19 and on 25 by two readers.\\n\\n- **Open defects of the ladder step:**\\n  - it misses its lines in both measurements; the event answers are changed (D409) and their class is smaller, not closed; a\\n    figure's due day, the reference (D411), a company's quarterly figure and the direction of a commitment's amount are not\\n    yet changed;\\n  - the readers' two families differ at every level (first readers 60 against 90 of 114 ladders sound; third readers agree on\\n    21 of 70 points), so a line's verdict can turn on the reader;\\n  - check 6 sets a footnote marker aside, one thing more than D405's record names: reported to Alex, not confirmed;\\n  - the check on pointing at the item misses \\\"at the item date\\\" (one instance in 111 ladders); mark Q owns the rule;\\n  - the design lost its block on the outcomes of a send, the lines and the accounting at version 29 and had it put back at\\n    version 31; the fourth and fifth review rounds read the design without it.\\n- **Alex decided on the result (2026-11-10):** stay at this step, change the event answers first, check at no cost and have it\\n  reviewed, then run the same Stage A once more within the $3; the other classes one at a time; no Stage B (D408). An event is\\n  answered in at most three outcomes, it happened, it is ruled out, or neither, the last written by code (D409, superseding\\n  D399). A group named and not listed is not a fault of a question (D410). An amount already reported may be a figure's\\n  baseline when named as that, built after the event answers (D411).\\n- **Done since, at no cost** (design version 32, §5.2.1): the request, the schema, the checks and the view writer answer an event\\n  in three outcomes; eight stored theses whose first answers had a gap are answered by hand and pass every check, each former\\n  gap in one rung; the form carries D410 and the event rules; a differing mark goes to two third readers, one of each family,\\n  and an unresolved point is counted both ways.\\n- **Reviewed, probed and sent again (2026-11-10).** Three council rounds on the change did not say \\\"ready\\\"; what they found was\\n  closed by one structural rule (code writes the scope of a ruling out: new, whole and standing) and read by two families on\\n  stated facts (20 of 20 alike, then 21 of 23). A small send (26 theses, $0.03) showed the model writing the new shape; a\\n  decline check beside a fresh control showed 8 against 9 of 15. The second Stage A was sent on my reading that the council's\\n  two conditions were met, not on its clearance ($0.15; 114 ladders, 16 declined, 2 refused twice).\\n- **Alex's instruction (D412):** every round is reflected on in the council to a recorded consensus, then the next test goes\\n  straight ahead on the PRD and its numbers, with every trace read by Claude itself.\\n- **The reflection council's consensus (round log §69, `council/ja-*`, `jb-*`):** no change to the request, the checks or the\\n  form until the second result is read in full and reported; then one next step (if the event class is not closed, report\\n  it, and fix at this step only where the cause is found and no decided rule changes; if it is closed and the lines are still\\n  missed on due day or direction, diagnose the figure's due day over its whole class first); the next stage is not asked for\\n  in advance. Alex decides: any change to what the product does; an important part of a thesis that three outcomes cannot\\n  carry; whether an event undone counts as happened; the footnote marker; the next stage.\\n- **Second Stage A, read (2026-11-10;** [result](../clean-arch/step4-2026-11-10/stage_a/result-2/RESULT.md)**).** The six lines are\\n  still missed. Regression: the due day is the same across sends in 18 of 34 theses, against 21 of 32. On what both first\\n  readers fail, against the first run: R on 4 ladders (7), N on 0 refusals of 16 (1 of 17), 37 theses right and 32 by a ladder\\n  (36 and 30), event ladders with a fault 8 of 43 (13 of 44), theses whose three sends differ in shape 1 (7). On the two third\\n  readers' agreed rulings: Q fails on 2 ladders, L on 1, R on 5; 34 theses right and 29 by a ladder, against the 35 and 28 asked.\\n  The favourable end still differs in the same two theses. The two third readers, one of each family, agree on 21 of 70 points,\\n  so every line is reported under both countings, and how many ladders are sound cannot be said from readers alone.\\n- **The council's consensus on what follows (round log §69, `council/jc-*`):** the event class is smaller and not closed, so\\n  it is diagnosed in full first, at no cost (the model's own ruled-out sentence not bound to a decision after the article; a\\n  question and an answer with different periods; a 2027 question judged in 2028; the object of a regulator's decision); then\\n  the figure's due day over its whole class, with D411's reference checked on its own; the changes and a plan go to an\\n  independent review; a third Stage A needs Alex's word. Reading disagreements a document settles are settled; the few that\\n  need a decision go to Alex.\\n- **Done since, at no cost (round log §69, council `jd`):** the event class counted on the second run (a ruled-out sentence with\\n  \\\"after\\\": R held by both readers on 27 of 31; without: failed or disputed on 9 of 11); one clause of code's sentence changed\\n  so that the scope governs the model's own sentence; proved on six real answers shown with the sentence as it was and as it\\n  is (`dryrun14/`): both reader families place an earlier decision in \\\"ruled out\\\" 6 of 6 before and in \\\"still open\\\" 6 of 6\\n  after, 36 of 36 placements alike and as fixed beforehand. The proof is of six sets of stated facts, not of the judge, and\\n  the event class is not called fixed (a question and an answer with different periods; a missing ruled-out rung; the object\\n  of a regulator's decision). A figure's due day counted on both runs and a candidate rule replayed\\n  (`stage_a/due_day_rule_replay.py`): agreement 18 to 32 of 34, with three figures set months late; no rule is recommended yet.\\n- **D411's reference, built, reviewed and probed (design §5.2.2; round log §69, councils `je`, `jf`):** the reference carries its\\n  kind (expected, or last reported for a figure) and a range by its two ends; the judge's middle rung says \\\"the amount last\\n  reported\\\" for a reported amount. Two council rounds corrected it before any send (a range is spanned end to end by the\\n  middle range; \\\"the same quantity\\\" is defined against a part, a ceiling and another quantity). A small send on 18 theses\\n  ($0.016, one draw) filled the field as written beforehand in all seven reference cases, kept the declines for no main thing,\\n  and sent back no first answer for its quotation (the second run: 68 of 132), which is not claimed until a full run shows it.\\n- **After the reference change: what else moves, and line 6** (round log §69; councils `jg` to `jj`;\\n  `clean-arch/step4-2026-11-10/probe-direction-2026-11-10/RESULT.md`). Read by hand, the small send also showed three company\\n  figures called \\\"higher is good\\\" and two events with a worse ruling out. A three-arm probe registered before its send (the\\n  request as the second run sent it; the working request; the working request with `unclear` allowed for a company figure's\\n  favourable end; 96 first answers, $0.074) found no signal that the reference change caused either: the old request sent in\\n  the same run shows both. It also showed the quotation refused in 15 of 34 first answers of the old request against 5 of 35.\\n  Line 6's two halves were counted at no cost: the favourable end differs within a thesis on two obligation theses in both\\n  full runs, and the model's own account says the texts do not settle it; two independent readers of the texts alone find\\n  \\\"lower\\\" settled in none of seven obligation theses, where the working request says \\\"lower\\\" in 19 of 21 answers. Letting the\\n  model answer `unclear` moved the wobble to two other theses (not shown to work by the registered test). The due day is the\\n  same in 18 of 34 theses and would be in 32 of 34 with a day set by code from the year.\\n- **Alex's choices (D413, D414, D415; 2026-11-10):** where the texts do not settle it, an amount the company owes or\\n  guarantees is registered with the lower end favourable; code sets the due day of a year's figure whose day would be an\\n  estimate (the fiscal year-end plus 60 days; a calendar year-end plus 90); the third Stage A is sent without asking again\\n  once each change is proved small and reviewed, and a change that does not pass stops and goes to him. Both rules are built\\n  (design §5.2.4). D414 replayed at no cost on the second run's stored ladders: one due day in 31 of the 33 theses still\\n  whole (18 of 34 as sent), the new refusal firing only on the three theses that are not a year's figure.\\n- **The third Stage A (2026-11-10; `clean-arch/step4-2026-11-10/stage_a/result-3/RESULT.md`):** sent under D415 after two\\n  small sends proved D413 and D414 (a sentence first added to the request with D414 was refuted by the first small send and\\n  removed; `probe-d413-d414-2026-11-10/RESULT.md`). 132 sends, 108 ladders, 24 declined, none refused twice; $0.11. **Line 6\\n  is met on both halves** (the favourable end the same in 9 of 9 company-figure theses; one due day in 34 of 35). Lines 4\\n  and 5 are met on the two readings that favour the answer (37 theses right, 29 by a ladder) and missed on the strict one.\\n  **Lines 1 to 3 are missed on every reading**, by 1, 1 and 3 ladders that both first readers fail (a survey question re-cut\\n  to a calendar year; a part not listed; three events that write the wait as the ruling out). The two third readers agree on\\n  21 of 70 points. Spent under D401's $3: $0.755.\\n- **Alex's answers after the third Stage A (D416 to D419; 2026-11-10):** the six lines stay; the ruling out of an event is\\n  tried as a typed answer (who decides, what they decide) and proved small first; a rolling twelve months with no\\n  publication day is declined; a government's permission or ban on a class of products belongs to the theme; the fourth\\n  Stage A is sent without asking again once each change is proved small and reviewed. The largest thing both readers fail\\n  was diagnosed first: a wait written as the ruling out, 7 of 140 stored event answers read in full, six on product-deadline\\n  theses (`stage_a/result-3/wait-as-ruling-out-hand-read.md`).\\n- **After the third Stage A: four rules of Alex's, each tested alone, then the fourth Stage A (D416 to D421; design §5.2.5;\\n  `clean-arch/step4-2026-11-10/stage_a/result-4/RESULT.md`).** D417 (a rolling twelve months with no publication day\\n  declined), D420 (an authority's proceeding always has a ruling out), D418 narrowed (a tracked government decision is the\\n  theme's) and D416 (an event's ruling out as who decides and what they decide) each passed a small send of its own; the\\n  typed ruling out failed its first trial and passed its second, after D420. The fourth Stage A: 132 sends, 104 ladders, 27\\n  declined, 1 refused twice; $0.11. **Lines 2 and 6 are met under every reading** (the favourable end the same in 9 of 9;\\n  one due day in 33 of 33 theses whose three sends are ladders). Line 5 is met on the two readings that favour the answer\\n  (40 right, 31 by a ladder) and missed on the strict one (34 and 25). **Lines 1, 3 and 4 are missed**, by 1, 2 and 3\\n  answers on the third readers' agreed rulings (0, 1 and 2 on what both first readers fail): a Kyber question that both\\n  branches of its thesis answer Yes; a question and a Yes condition on different periods; a \\\"restructuring\\\" counted as a\\n  ruling out; three declines for \\\"two figures, none the main one\\\" that no earlier run had. The third readers agree on 29\\n  of 53 points. Spent under D401's $3: $1.136.\\n- **The second-look test (D422; `clean-arch/step4-2026-11-10/probe-second-look-2026-11-10/RESULT.md`): it did not pass.**\\n  76 answers of the fourth Stage A, each sent back once with one instruction that names no fault ($0.12); one blind\\n  reading round of 102 items. Of the 18 answers with an agreed fault, 6 mended (9 needed); of the 30 unfaulted, 3 counted\\n  against it (the page fails at 3). It mends what one rule and one field show (the three wrong refusals, a ceiling as a\\n  reference, a missing unit); it removed two correct references, turned a correct refusal into a ladder and traded one\\n  fault for another twice. The round also re-read the fourth run's answers: 14 of its 18 agreed faults are agreed again;\\n  the two third readers rule alike on 22 of 54 points. Spent under D401's $3: about $1.25.\\n- **Alex's answers (D425, D426):** the second look is not adopted; the ladder step is not tuned further on the 44 theses and\\n  no fifth Stage A is sent. **Stage A has not passed** (lines 1, 3 and 4 missed by 1 to 3 answers of 131). By his word the\\n  preparation of Stage B opens on the step as it ran in the fourth Stage A; no paid Stage B send without his word again.\\n- **The Stage B baseline reading (`clean-arch/step4-2026-11-10/stage_b/RESULT.md`):** the frozen judge on the ruler's\\n  hand-written ladders, 159 stored judgements read by Codex and Claude Opus 5.5 after seven reviews of the plan: 4 of 151\\n  decided judgements UNSUPPORTED (3%), all in figure questions (4 of 52, 8%; yes/no 0 of 99), 7 INSUFFICIENT, 16 of 16\\n  questions end the window SUPPORTED. Every fault is in three figure questions before a sized amount is in view. Controls:\\n  6 of 6 planted caught by both families. The lines' chance behaviour is measured (`line_chance.py`). Council B consensus\\n  (`km`, `kn`): put Stage B's lines and the paid send to Alex.\\n- **Stage B (2026-11-12, `clean-arch/step4-2026-11-10/stage_b/STAGE_B_RESULT.md`): does not pass.** Three draws, 236\\n  judgements, $0.42; the reading plan reviewed five times; trial 6 of 6; both families caught 6 of 6 planted answers. Line 3\\n  unexercised (eligible 7, material shown 4, all agreeing). Lines 1 and 2 met (26 of 26); figure 3.4/3.2/10.5% against\\n  12.7/12.5/14.4%, yes/no 0.9/0.8/4.9% against 5%: met; last judgements missed 3 of 24 on the strictest reading. The families\\n  differ on 22 of 236 and the third readers split on 12 (9 along family lines). Patterns: three-outcome events kept at \\\"Still\\n  open\\\" because nothing is settled yet (Kyber); figure questions with no reference figure the evidence cannot size (19\\n  INSUFFICIENT); a figure carried forward. Council B (`council/la-codex.md`): stands with corrections, applied.\\n- **The control trace (done, `stage_b/CONTROL_TRACE.md`):** most of the 8 question differences are already in the Step 1\\n  thesis (the article's angle: a programme inside a total, the reported date, a later milestone); two missing items are stored\\n  with no link to any thesis though the capex thesis was open; leads, not an attribution.\\n- **The Step 1 diagnosis (D432, `clean-arch/step1-diagnosis-2026-11-12/DIAGNOSIS.md`, version 8; seven council rounds):** c8 states\\n  \\\"one quantity for one period, or one event\\\", but its merge rules carry neither D38's year boundary nor D388's signing exception;\\n  the second year of an annual quantity is never opened (3 graded misses). Proposed to Alex: carry D38's year boundary into two\\n  merge sentences (+151 characters), first tested on stored articles with a c8 arm. Recorded, not proposed: outcomes with a second\\n  thing in them (under most of Stage A's ladder faults, a class to investigate); rolling periods and small matters against c8; a\\n  contract gap between c8's shared_quantity and the ladder step's object and theme rules.\\n- **c14 (D433), stage 1 (`clean-arch/step1-diagnosis-2026-11-12/STAGE1-RESULT.md`): does not pass.** Both years of hyperscaler\\n  capex opened apart in 7 of 9 sends against a line of 8 (c8 0 of 9); one send lost the capex question (c8 never); $0.24. The\\n  misses: the model choosing one year as the bet, and c8's \\\"a customer expanding capacity … is not a thesis of its own\\\" colliding\\n  with shared_quantity. Stage 2 not sent; c8 stays in force.\\n- **Gate 1 done** (`clean-arch/step1-diagnosis-2026-11-12/gate1/`, D435, D436): change 2 (the capacity counterexample scoped) passes\\n  G1-b; changes 1 and 2 together fail G1-a, separating the two years of hyperscaler capex in 5 of 9 sends against a line of 8 (c8: 0 of\\n  9; 20 of 26 over every year-wording send on that article). The misses decline the second year as too much. c8 stays in force.\\n- **Alex carried changes 1 and 2 to gate 2 (D437).** Gate 2 (`clean-arch/step1-diagnosis-2026-11-12/GATE2.md`, version 11) passed\\n  its review in round 11 (`council/mi-codex.md`): c15yc against c8 on seven stored neighbours in three draws, 126 sends, about $1.8,\\n  ceiling $2.2.\\n- **Authority (D439, 2026-11-13):** Alex is not active; every choice goes to the council (Codex + Claude) until consensus, recorded\\n  citing D439. Paid spending in this period: $0.83 (gate 1) of a $40 ceiling (Claude's setting); gate 2 sent on Alex's word (D438).\\n- **Step 1's combined candidate stopped (D441).** Gate 2 failed on the memory article; the council's memory diagnostic (D440) found\\n  c15yc opens a memory-price question less often (17 against 28 of 54, interval -34.6 to -4.8) and pushes it from the ruler's\\n  2027-against-2026 shape to 2026; c8 stays. Spend so far $4.77 of the $40 D439 ceiling.\\n- **The next step (D442–D444): an exploratory end-to-end census.** The clean path's stored chain (unseeded draws 2026-11-10, Stage A\\n  run-4 ladders, Stage B judgements) against fresh production draws (`poc-v118`, no seeded questions), on the frozen judgement ruler by one\\n  method (`clean-arch/e2e-comparison-2026-11-13/DESIGN.md` v4). The first three draws stopped at an over-conservative ledger (D444; kept\\n  as records); three fresh 14-day draws completed 2026-11-13 03:46 (`poc/data/clean-e2e-comparison-2026-11-13/draw-q1..q3`: 243 items\\n  each, 0 failed, 13, 12 and 15 own views; recorded $0.43, $0.46, $0.46). D442's same-day comparison stays owed for D427.\\n- **The census result** (`clean-arch/e2e-comparison-2026-11-13/RESULT.md`): on the seven graded questions both systems agree with\\n  reader B on one or two a draw (production 1/1/1, clean 1/2/1; two unresolved each); no eligible judgement disagrees in either; every\\n  loss is at opening (event deadlines against the standard's rules, the memory comparison never opened, scope). A measuring-stick concern\\n  (D430's same deadline against the standard's 18-month range for q23) is recorded apart (D373), scoring unchanged.\\n- **After the census (D445–D447):** the trace of the clean path's 17 graded opening losses found no single mechanism; a typed-unit\\n  audit found identity fields detect 2 of 16 and recover none, so that line stopped.\\n- **The wiring (D447, D448), built and proved at $0** (`clean-arch/e2e-comparison-2026-11-13/WIRING-DESIGN.md` v4; round log §81): one\\n  shared spending ledger over every paid call (Step 1, Step 2's embeddings and Jev, the ladder step, the judge, production), the\\n  ladder step's and the judge's inputs as arguments, a per-draw orchestrator (`run_fresh.py`). The $0 proof passed: Stage B's three\\n  databases rebuilt row for row through the new inputs; Step 1 (one day), Step 2 (a whole draw, byte for byte), Stage A run 4 (every\\n  outcome of three passes), the judge and production (one day) each sent every network call under a ledger reservation; a ledger\\n  refusal stops every component; bypass mutants are caught. Full suite 287 passed.\\n- **The code review (D449):** eight defects found and closed by four structural rules (stops shared and read before every actual send;\\n  launcher liveness by its lock registered on the ledger; one reservation bound and settlement rule; the proof through the real\\n  orchestrator). `proof_end_to_end.py`: one day through `run_fresh.py` (5 child processes, 55 calls, all reserved), a killed child and a\\n  killed orchestrator handled; full suite 287 passed. Redo of Step 1, Step 2 and production only by a reasoned relaunch; a crash stops\\n  the run.\\n- **The slice (D450) ran and the wiring works live** (`clean-arch/e2e-comparison-2026-11-13/SLICE-RESULT.md`): both draws complete in 8\\n  minutes, every component with real sends on one ledger, every ledger line attributed; $0.159 of ledger (about $0.15 at the published\\n  rates). Every answer read.\\n- **The full run (D451) completed** (`poc/data/clean-e2e-full-2026-11-13/`, 05:44–08:33; c2's Step 1 redone after a dropped response,\\n  D453): ledger $11.43, every line attributed (`spend-by-component.json`). Clean 15/10/15 theses, 69/72/92 judgements; production 12/13/14\\n  views, 92/80/104 judgements, 0 failed. First read in the round log §84.\\n- **The full run, read (D452–D455):** Stage A on the 40 fresh theses misses lines 1–5 and meets line 6 (`STAGE-A-FULL-RESULT.md`); the\\n  census (`CENSUS-FULL-RESULT.md`): settled agreements on the seven graded questions clean 2/1/0, production 1/1/1 (2/2/1 and 2/2/2 with\\n  unresolved points counted), no eligible judgement disagrees, every loss at opening; the clean path kept 51 of 55 decisive facts of its lost\\n  questions, production 39 and left kept Kyber and Ohio facts unlinked; Stage B line 3 unexercised (0 settled, at most 4 of 8), its judgement\\n  reading stopped (D455).\\n- **Traced since (D456–D458), all at $0:** production's kept-but-unlinked facts cost no final answer in this window (three mechanisms,\\n  `unlinked-trace/UNLINKED-TRACE-RESULT.md`); the opening losses hold few shown breaches of the standard, spread over small mechanisms, and\\n  their largest classes are choices the standard leaves open (`opening-review/OPENING-REVIEW.md`); no opening phase is opened.\\n- **Since (D458–D460):** Stage A's first-pass faults form no class (`stage-a-trace/STAGE-A-TRACE-RESULT.md`); the model's accounts make\\n  two opening mechanisms strong leads, the unsigned Ohio guarantee folded into the programme's amount (seven draws, both systems) and the\\n  next year's capex folded into this year's question (five of six clean draws), and show the standard's keep-apart line for unsigned deals\\n  missing from the clean Step 1 request (`opening-review/D459-RESULT.md`).\\n- **Since (D460–D462):** the whole-request audit of clean Step 1 (two readers apart, `step1-audit/AUDIT.md`) finds the standard's identity\\n  boundaries missing from its request (the unsigned deal beside a plan's amount; another year of a shared quantity) and one date sentence\\n  narrower than the standard (F6); F6 decided only one or two of 26 memory declines (`step1-audit/f6/`) and is recorded, not tested alone.\\n  The status report for Alex, reviewed by the council for accuracy: `clean-arch/e2e-comparison-2026-11-13/STATUS-FOR-ALEX-2026-11-13.md`.\\n- **Since (D463–D464):** the identity lever is a prompt clause first; candidate c16 (version 5, four blind audits) and a case-specific\\n  diagnostic on fresh articles (one story per target boundary is all this window holds), 7 merge and 9 negative stories and the stored guards\\n  (`clean-arch/e2e-comparison-2026-11-13/identity-probe/v2/PROBE-DESIGN-v2.md`).\\n- **Since (D465–D466):** the identity diagnostic moved its error (c16 not adopted, c8 stays; `identity-probe/v2/RESULT.md`, $4.49); a deep\\n  reflection council (Alex's request) agreed the second half of the day circled and reset the plan.\\n- **Since (D467–D473):** the ladder-cost proofs are kept as tools (`ladder-cost/`); the ladder-refusal candidate stopped on a contested\\n  \\\"main figure\\\" boundary; the 41 Stage A reader splits recorded, none changing its verdict; the ten right-by-refusal theses traced; the period\\n  candidate c17 failed its frozen lines (memory and federal openings suppressed; `period-probe/RESULT.md`). Step 1 sentence changes on these\\n  articles stop (D473). Provisional choices under D439 (D469): empty-start measurement; the three open shapes stay concerns; the written-ladder\\n  line stands (D471). Alex's answer overrides any of them.\\n- **Since (D474–D477):** the unsigned-deal candidate c18 was not adopted (`unsigned-deals/RESULT.md`). The source check of the eleven\\n  first-pass refusals (`reachability/RESULT.md`): six right, four reachable only on paper, one split. **D477:** Stage A not passed; no theme or\\n  ladder change for the H100 boundary; no more Step 1 sentence changes on these articles; production stays the default; the clean path's\\n  three product choices are written for Alex (`clean-arch/e2e-comparison-2026-11-13/CHOICES-FOR-ALEX-2026-11-13.md`).\\n- **Since (D478–D482), under D439:** choice 2 tested and failed (c19); choice 3 taken (production stays the default); production's price\\n  rule (D191.4) tested and failed (`docs/research/2026-11-13-shared-quantity-price/`); no further paid test on the frozen ruler (D482).\\n- **Alex active again (2026-11-14).** D483–D486: a use-oriented acceptance was designed and its $0 trial read\\n  (`docs/research/2026-11-14-use-acceptance/TRIAL-RESULT.md`); Alex asked for a leaner path (small steps, each run fast). D487: step 1 built nothing (the\\n  \\\"dated after the article\\\" statements are correct dates against items stored a day early); step 2 runs one fresh week (2026-09-22..28, 235\\n  items proved identical for both systems), one draw a system, a one-day slice first, readings A and B, the decision rule written before\\n  reading (`LEAN-LOG.md` §2). Slice passed; production's week draw complete; the clean draw stopped twice on dropped connections, root-caused and fixed (D488: Step 1 resends a\\n  network loss, each attempt on the ledger). The clean week draw completed from empty (`poc/data/clean-lean-week-2026-11-14/week-r2/`, $2.52; both ledgers $4.69). **Result (D489,\\n  `docs/research/2026-11-14-use-acceptance/week/WEEK-RESULT.md`):** not clear by the rule written before reading; no system chosen. Production\\n  covers 4 of the 5 big matters two blind reader families listed, the clean path 2 (it lacks revenue and margin by D382/D384); judgement\\n  support does not rank them at this size. The question then put to Alex (whether the new system holds questions on the company's main\\n  numbers) was answered by him on 2026-11-15 (D505; see \\\"One next task\\\").\\n  Recorded spend under D439 at that point: about $18.4 of $40 (about $7.26 before the run; the run's ledger $11.43, somewhat above its cost at the\\n  published rates); the current figure is in \\\"One next task\\\". (An earlier line here gave \\\"about $29.2\\\" as tracked spend; no decision or\\n  log records that figure and it is withdrawn.)\\n- **Open defects recorded by this review:** the frozen judge retried 10, 16 and 18 judgements in the seeded clean draws, 38 of 51\\n  reasons a theme cited as a dependency (PRD 11, E4), and its stored path holds the 2026-07-05 fault above (frozen; findings for\\n  Alex); the same matter takes different shapes between draws (Kyber due end-2027 in one draw and end-2028 in another); under D397\\n  the second bet of a topic that holds two has no answer; five-state event ladders failed by hand three times before a construction now in the request\\n  produced ones that pass a reader; in Stage A the model's own are faulted by both reader families in 10 of 17 for the company.\\n- **The unseeded measurement (D395):** graded subset 4.0 against 6.33 seeded. Every miss is a question not opened in the ruler's shape.\\n  Judged answers 16 of 16, on the ruler's wording and ladder; the system's own questions have never met a judge.\\n- **Stage 2 of D392:** clean 18, 18, 17 against v108 17, 15, 16, inconclusive on q12.\\n- **Known gap (D394):** capital spending (q12).\\n\\nNo long job is running.\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_24","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"sed -n '2559,2574p;3685,3701p;3798,3815p;10439,10465p' docs/DECISIONS-log.md; rg -n 'judging-v9|judging-v10' docs/DECISIONS-log.md docs/DECISIONS.md docs/prd/06-views.md docs/research/2026-11-04-argument-record -g '*.md' | cut -c1-400; rg -n '\"'^def |config.*(diff|change)|checksum'\"' src/hivemind/replay.py; sed -n '1,82p' tests/test_supported_versions.py; sed -n '25,50p' docs/research/2026-11-20-production-readiness/dependency-design/july_test.py; cat docs/research/2026-11-21-whole-window/neither.log | head -20\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_24","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"sed -n '2559,2574p;3685,3701p;3798,3815p;10439,10465p' docs/DECISIONS-log.md; rg -n 'judging-v9|judging-v10' docs/DECISIONS-log.md docs/DECISIONS.md docs/prd/06-views.md docs/research/2026-11-04-argument-record -g '*.md' | cut -c1-400; rg -n '\"'^def |config.*(diff|change)|checksum'\"' src/hivemind/replay.py; sed -n '1,82p' tests/test_supported_versions.py; sed -n '25,50p' docs/research/2026-11-20-production-readiness/dependency-design/july_test.py; cat docs/research/2026-11-21-whole-window/neither.log | head -20\"","aggregated_output":"## D198 · 2026-10-27 · A judgement reads the evidence in view, not everything in force\n\n- Alex, 2026-10-27, on the finding that evidence in force grows without bound (v6, NVIDIA FY2027 Data Center revenue: 574 pieces after six weeks, 415 never cited by any of its 33 judgements; 40 of 316 judge requests over 30k tokens, max 67k; judging 38% of spend and rising; the run's stall came from enumerating 300+ ids): \"这是什么问题你深度思考之后改\".\n- What the problem is (design: `docs/research/2026-10-27-evidence-in-view/design.md`): two mechanisms. (1) Extraction links wide: `role-v14.txt` says \"every statement and number is, by default, evidence linked to a shown thesis\" and also \"link only to the thesis it directly concerns; omit statements with no thesis\"; the model attaches every business mention to the broadest thesis (2.5 pieces per item on v6; a liquid-cooling note, a SuperPOD purchase, a rack R&D story). Not changed here; the prompt audit is reported to Alex as the next slice. (2) Judging-v4 reads everything in force every time (\"Rejudge from all evidence currently in force\"); an analyst keeps what his view rests on and reads what arrived.\n- Decided: from judging-v5 (`poc-v30`) a judgement of a thesis is shown, of its evidence in force, the arrivals (pieces linked after the thesis's fifth most recent judgement, READINGS = 5; everything when it has fewer) and the basis (pieces cited by one of its last ten judgements, BASIS = 10). The rest stays in force in the ledger; the request names the count (\"[Not shown: N more pieces in force, read in earlier judgements; the previous conclusion carries them]\"); the answer may cite and push only shown ids, checked against the request that was sent (`judging.evidence_shown_in`, as the theme block is). Nothing leaves the ledger; the repeat / replace / new rules, \"in force\", the rejudgement triggers, eligibility, the theme block and dependencies are unchanged. Gated on the prompt version: v4 ledgers and configurations read in force as before.\n- Measured ($0, `census.py`, two ledgers): among judgements after a thesis's first, the rule would have hidden 1.5% (nvda-3m) and 1.1% (r5) of the citations the judge actually made (22 of 325 and 7 of 261 judgements lose one cite, mostly third-party risk mentions listed in a \"pull the other way\" sentence); shown mean 95 and 109 pieces where in force averaged 225 and 178. Tighter rules hid 16% (cited last time + new since) or kept growing (ever cited + three readings). Arm beside control (`ab.py`, $0.03): v6, v11, v22 from the same ledger state, v4 fresh against v5: the same rung and `changed` on all three, reasons consistent, request tokens 76,476 → 12,516, 53,151 → 11,204, 25,806 → 8,425. Tests: `tests/test_evidence_in_view.py` (4, red first); suite 199.\n- Applied to the three-month run at a day boundary: 2026-08-18 finished under `poc-v29` on the serial path (the parallel runner refuses a half-done day after a code change), `poc-v30` from 2026-08-19. Prompt `judging-v5` is `judging-v4` with the first rule reworded (2,264 → 2,437 characters; the growth is the sentence that says what is not shown and who carries it).\n- Also in this slice, from the stall at 2026-08-07: a code-refused judgement answer is retired from the archive's lookup (`model.Archive.retire`; the row stays; schema-refused and malformed rows already carried a suffix), so a resume re-samples instead of replaying the refused answer; and the request's closing line names a closed set that exists (\"cites_views must be empty: this thesis depends on no other thesis\"; \"a theme id goes only in theme_pushes, never in cites or cites_views\"): 4 of the run's 5 retried first answers had put theme ids into cites_views.\n\n## D199 · 2026-10-27 · One extraction call stays; its gate rule becomes decidable and the empty-answer exit goes (v16, poc-v32)\n\n- Alex, on the instability trace: \"不这个一次一定是可以搞过的 → 读明白，抽取 … 这一定是prompt 的问题，你如果再拆成两步这个消耗的luna calls 太多了\"; then \"你要反思自己的错误，然后下去改然后马上测试啊，不要一直diverge scope\". The two-call design (`docs/research/2026-10-27-two-step-extraction/design.md`, two review rounds) is recorded and not built.\n- Found ([log](research/2026-10-27-single-call/log.md)): the run's 493 empty extraction answers in 1,553 calls (32%; 65% of the first week's items) were the model following the written rules: \"every statement is, by default, evidence\" against \"link only to the thesis it directly concerns … omit statements with no thesis\", decided once per page, so a customer, partner or product page was omitted whole (asked directly, the model names that rule: a national lab buying Vera Rubin CPU servers \"describes a customer project, not NVIDIA's reported sales\"). The five-send benchmarks before this were sent with an alphabetised schema (the archive stores sorted keys; production sends the dict as built) and overstated the empties; in production order no send of three articles was empty. A second mistake stopped the first week test: code edited while the parallel runner was mid-day.\n- Decided: extraction v16 (`role-v16.txt`: one rule, \"a statement is evidence to each shown thesis whose answer its fact or figure makes more or less likely\", with the customer/supplier/competitor/regulator and policy cases and the omit cases; the closing line \"Return empty arrays only for a page with no business content\", `extraction.EMPTY_LINE_FROM`; v12's admission reasons, `V12_REASON_VERSIONS`). `poc-v32.json` is the configuration. Measured on the same 98 items of 2026-07-01..07 against the paused run (v12, whole pages): empty handovers 65% → 32%, the model's own empties 55 → 8, evidence per item 1.1 → 2.7, candidates 9 → 11, week cost $0.22. v17 (`poc-v33`, an account per mandatory paragraph in the same call) held the piece set across sends (A3: Jaccard 0.6–0.8 against 0.4–0.5) but tripled the pieces with court-case minutiae and opened 5 theses where v16 opened 11, at twice the extraction and matching cost: refuted for production, kept as the record of the shape.\n- The three-month run restarts from 2026-07-01 with poc-v32 on the cleaned database (D256) in `poc/data/english-v32-nvda-3m-2026-10-27/`; the poc-v29/v30 run stays paused and untouched. Open, named: links read widely (every piece to three or four theses; D198's \"links wide\"), candidates for product and gaming news (no thesis list entry fits them), the cold start's \"no thesis fits\" drops.\n\n## D354 · 2026-11-03 · Steps 3 and 4 (opening and matching questions, judging them) are frozen as `poc-v108` runs them, after three draws on the frozen extraction\n\n- Alex, after the extraction was frozen (D274): \"now that the extraction stage is done and frozen, we freeze that as well\"; on the plan to\n  run the whole line on the frozen extraction and freeze steps 3 and 4 if their numbers did not get worse: \"好你跑\"; then \"那你跑了吧，我们赶紧确认step 3,4 可以freeze\".\n- The run (`research/2026-11-01-e2e-loop/log.md` row 29): `poc-v108` with the 22 frozen seeds over 2026-07-01..07-14, three draws at once\n  from a pinned worktree, predictions and freeze conditions written before the send (`predictions-r9-frozen-v108.md`, sha256 beside it).\n  All four conditions hold: every draw finished with no halted day; must-open questions 28/28 in every draw; the judgement agrees with the\n  frozen gold on 15/17, 15/17 and 16/17 judged questions (control `poc-v94`: 16/18, 16/19, 16/18) and no question that agreed in all three\n  control draws disagrees in all three new ones; core matters reaching judgement average 77.7 (control 74.3) and estimated noise reaching\n  judgement 49.5 (bound 51).\n- Frozen: the collision judge's prompt `collision-v2`, the judge's prompt `judging-v7`, the matching prompt the configuration names\n  (`matching-v3`), the judge's answer schema and the three questions the Jev matcher is asked; `tests/test_frozen_questions_and_judgement.py`\n  pins them (a one-character change to a prompt or to a matcher question fails it, both mutants checked). The configuration itself is\n  pinned by `tests/test_frozen_extraction_prompt.py`. A change is a new version only Alex opens.\n- Known defects, recorded and not fixed: (1) the collision judge splits one bet on a fine detail: the seed H200 question and an identical\n  candidate were judged distinct (\"any\" against \"public\" authorization) in one draw; ten re-sends of the stored request gave the same\n  question 8 times, so about one encounter in five opens a duplicate; (2) the frozen extraction proposed the lidar-legislation question the\n## D359 · 2026-11-04 · The code builds only the frozen prompts (extraction v74i, judging-v7); old worktrees removed; the preflight reads the one-decider requests\n\n- Alex, on Claude's list of the two open cleanup items (the old worktrees, and the code paths only retired prompt versions take, with the\n  cost that old versions could then no longer be re-run, only read from their stored results): \"你看完你告诉我呀\", then \"ok\".\n- **Worktrees.** Removed: `fix/thesis-admission-v11` (its 102 MB of data were five SQLite files whose contents equal `main`'s; only the\n  header counters differed), `cleanup/sequential-requests` (685 MB, 244 files byte-identical to `main`'s `poc/data`), `feat/parallel-day`\n  (two text changes `main` already holds, 94 MB of the 2026-10-25/26 test outputs) and `feat/thesis-admission-v12` (a writer fix `main`\n  covers where it reads, the sealed-run decision carried as D358, its quality review carried to `docs/research/2026-10-28-quality-review/`).\n  What was kept from each is in `/Users/lchingen/hivemind-backups/old-worktrees-2026-11-04/` (README there); the branches stay. Kept:\n  `fix/extraction-quality-2026-10-28`, whose ignored folders hold the stored end-to-end runs (679 MB; v91, v92, v94, v95), the results\n  any later comparison reads.\n- **One path in the code.** `extraction.py` builds the v74i request only: the Chinese builder, the per-version schemas, field notes,\n  paragraph accounts, the placement call's paths and every version gate are gone; `SUPPORTED_VERSIONS = ('v74i',)` and a configuration\n  naming another version is refused before any request (`require_supported`). The answer checks are unchanged except what only retired\n  versions used: a bare year is a calendar year, an unlinked statement stays for the handover's 'no home' drop, the admission check reads\n  `settled_by` and the obligation horizon, a candidate cites only groups its answer declares. `placement.py` keeps the takes lines, the\n  v74i filing rule and the candidate-id pattern; the separate placement call is gone. `views/judging.py` builds judging-v7 only (theme\n  block, evidence in view, the reference) and refuses another version. The parallel runner and the stream no longer pass the never-shown\n## D694 · 2026-11-21 · Alex chooses A: links leave filing alone; new matching and judging versions open for linking; the July test after the council passes the $0 proof\n\n- **Alex's words** (2026-11-21), replying to the three choices of D693: \"A\". The options were:\n  - **A**, recommended: (a) a chosen reading link leaves evidence filing alone (D265 applies only to a stated hierarchy); (b) open new\n    matching and judging versions for the shared mechanism (both opening orders; the first test accepts only the existing-reader /\n    new-target case); (c) after the $0 proof has passed the council, the July comparison (old-2, 07-10 to 07-12, three linked and three\n    control sequences, both questions fresh, pass rule `dependency-design/codex-r2.md` §7(b)), cap $0.15, estimate $0.06–0.07;\n  - **B**, the code and the $0 proof only, asking again before the paid test;\n  - **C**, not now.\n- **Decided (Alex):** A. poc-v118 stays the product and the control; the linking version is a new configuration. The sourced-reference\n  change is not opened (it returns after the July measurement, D693).\n- **Next:** the $0 work of D693 in order (tables and request audit; the July control rebuilt by request identity and filing replayed;\n  real checks and writer with fixed answers for both orders and the listed events; built requests inspected, rule frozen, cap set),\n  then the council on the proof, then the send.\n\n## D695 · 2026-11-21 · Alex narrows the first linking version to number questions, one of them newly opened\n\n- **The question** (after council R round 4, `docs/research/2026-11-20-production-readiness/dependency-design/codex-r4.md`, NOT READY: the\n  design's blanket exclusion of theme links narrowed the agreed lifecycle, and the full scope — themes shown once with the link's\n  direction, a theme reading an asset, closed events read as historical until a successor, two questions opened by one article — needs\n  more design rounds): \"连题的第一版，范围要多大？\" Options: only number questions (recommended): link two five-rung number questions\n  of the asset kind, one of them newly opened; themes already reach every asset question through the theme block (D191, D195);\n  yes/no event questions and two questions opened by the same article wait for a later version. Or the agreed design in full.\n- **Alex's answer** (2026-11-21): \"只连数字题 (推荐)\".\n- **Decided (Alex):** the first linking version links only a newly opened number question and an open number question it was shown,\n  in either reading direction (both five-rung asset ladders with typed bounds). No theme, event or same-article pair is linked in this\n  version; each is a later version Alex opens. D694 otherwise stands.\ndocs/research/2026-11-04-argument-record/predictions-step2b.md:1:# 第 2 步重跑（judging-v9）预期：发送前写下并冻结，2026-11-04\ndocs/research/2026-11-04-argument-record/predictions-step2b.md:3:运行：`poc-v110`（`poc-v108` 只把判断换成 judging-v9：v7 的读法、上一次结论和答题项，加一张每次照写、下次不读回的论证卡片），一遍，2026-07-01 到 07-14，\ndocs/research/2026-11-04-argument-record/log.md:41:| 10 | 2026-11-04 17:45–18:05 | 按 `targets.md` 改卡片，在已存请求上先看结果（约 0.6 美元） | **改法（judging-v9，`poc-v110`）：**判断照旧用 v7 的读法和答题项（引用由判断自己写）；多写一张卡片，理由只写引用里写了的事实，推算只放\"推出的结果\"；代码在写入前查：引用只能是请求里列出的、独立来源数不超过\"引用数减转载数\"、理由里的每个数字要在它的引用（或题目、几级结果）里找得到。**先数 T3a：**用这条规则数 v8 全部卡片，1,267 条里 26 条（2.1%），最后那版 4 条；抽 10 条看全是真推算（\"约 3,874 亿\"\"约 207 亿\"）；之前的 204、85 是更松的数法，作废。**第一版 v9\n21:def refuse_unfinished_parallel(conn):\n43:def calendar_days(from_day, until_day):\n51:def run(*, testdb_path, views_path, archive, cfg, universe, from_day, until_day, day0=None, spend_cap_usd=None,\n\"\"\"D359: the code builds only the frozen production prompts, extraction v74i (D274) and judging-v7 (D354); a configuration that names\nany other version is refused before a request is built or sent.\"\"\"\nimport dataclasses\nimport os\nimport sys\n\nimport pytest\n\nROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))\nsys.path.insert(0, os.path.join(ROOT, 'src'))\nfrom hivemind import config, extraction, model  # noqa: E402\nfrom hivemind.views import judging  # noqa: E402\nfrom test_placement import ITEM, TEXT, UNI  # noqa: E402\nfrom test_theme_block import DAY, ledger  # noqa: E402\n\nV108 = config.load(os.path.join(ROOT, 'poc', 'config', 'poc-v108.json'))\n\n\ndef never_sent(*parameters):\n    raise AssertionError('a request of a version the code does not build was sent')\n\n\ndef test_an_extraction_version_other_than_v74i_is_refused_before_any_call(tmp_path):\n    other = dataclasses.replace(V108, extraction=dict(V108.extraction, T7=dataclasses.replace(V108.extraction['T7'], prompt_version='T7-v53')))\n    with pytest.raises(ValueError, match=\"extraction 'v53' is not built\"):\n        extraction.extract(model.Archive(str(tmp_path / 'archive.sqlite')), other, ITEM, TEXT, [], UNI, transport=never_sent)\n\n\ndef test_a_judging_version_other_than_v7_is_refused_before_any_call(tmp_path):\n    other = dataclasses.replace(V108, rejudging=dataclasses.replace(V108.rejudging, prompt_version='judging-v6'))\n    with pytest.raises(ValueError, match=\"judging 'judging-v6' is not built\"):\n        judging.round_of_judgements(model.Archive(str(tmp_path / 'archive.sqlite')), other, ledger(tmp_path), ['v1'], 2, DAY, transport=never_sent)\nfrom hivemind.views import round as rounds                             # noqa: E402\n\nOLD2 = REPO / 'poc/data/comparison-2026-11-17/run/old-2/prod'\nITEMS = REPO / 'poc/data/comparison-2026-11-17/items-comparison.sqlite'\nV118 = REPO / 'poc/config/poc-v118.json'\nV119 = REPO / 'poc/config/poc-v119.json'\nUNIVERSE = REPO / 'poc/universe.json'\nLINK_SEQ, PREFIX_SEQ = 148, 147\nTARGETS = ('v9', 'v14')\nWINDOW = ('2026-07-10', '2026-07-12')\nCEILING = 0.15\nINTENDED = ('v9', 'v14')                       # Data Center FY2027 reads total revenue FY2027\n\n\nclass Stop(RuntimeError):\n    \"\"\"The harness stopped a sequence (an unapproved request, an out-of-pair link); the sequence is final.\"\"\"\n\n\ndef judged_view(request):\n    \"\"\"The thesis a judge request is about (its user text begins \"Thesis <id> (\"), or None for any other request.\"\"\"\n    if 'messages' not in request:\n        return None\n    text = request['messages'][-1]['content']\n    return text.split(' ', 2)[1] if text.startswith('Thesis v') else None\n\n\ntotals: {'items': 2077, 'extracted': 1884, 'skipped': 0, 'merged': 193, 'not_processed': 0, 'returned': 0, 'failed': 0, 'evidence': 5120, 'new_views': 43, 'judged': 1616, 'changed': 882, 'closed': 1} seconds: 375\nlast completed seq 1884 old-2 1884\nviews: rebuilt 43 stored 43 equal\nview_keys: rebuilt 43 stored 43 equal\nevidence: rebuilt 5102 stored 5102 equal\nevidence_links: rebuilt 6306 stored 6306 equal\njudgements: rebuilt 1616 stored 1616 equal\nrungs: rebuilt 137 stored 137 equal\nview_switches: rebuilt 44 stored 44 equal\nsuccessions: rebuilt 2 stored 2 equal\ndependencies: rebuilt 0 stored 0 equal\n{\n \"equal to old-2\": true,\n \"link jobs asked (answered neither)\": 14,\n \"questions in them\": 105,\n \"old-2's refused answers met again\": [\n  \"cfd45dde68ce\",\n  \"907eb29065b7\",\n  \"6d0c31a8460d\",\n  \"137e5f747345\"\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_25","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"rg -n 'def judgement_answer|PUSHES =' src/hivemind/vocabulary.py; rg -n 'judging\\\\.schema_for|schema_for\\\\(.*judging' --glob '*.py' --glob '\"'!poc/data/**'\"' .; rg -n 'quote.*(strip|replace|split)|one_line.*(strip|replace|split)' src/hivemind/extraction.py src/hivemind/views/store.py | head -55; rg -n 'serial|parallel|workers' scripts/replay.py docs/research/2026-11-21-whole-window/neither.log | head -25\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_25","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"rg -n 'def judgement_answer|PUSHES =' src/hivemind/vocabulary.py; rg -n 'judging\\\\.schema_for|schema_for\\\\(.*judging' --glob '*.py' --glob '\"'!poc/data/**'\"' .; rg -n 'quote.*(strip|replace|split)|one_line.*(strip|replace|split)' src/hivemind/extraction.py src/hivemind/views/store.py | head -55; rg -n 'serial|parallel|workers' scripts/replay.py docs/research/2026-11-21-whole-window/neither.log | head -25\"","aggregated_output":"12:PUSHES = ['toward_first', 'toward_last', 'none']\n67:def judgement_answer(data):\n./tests/test_frozen_questions_and_judgement.py:38:    assert sha_of(judging.schema_for('judging-v7')) == JUDGING_SCHEMA_SHA\n./tests/test_frozen_questions_and_judgement.py:44:    assert sha_of(judging.schema_for('judging-v8')) == JUDGING_SCHEMA_SHA\n./tests/test_theme_block.py:86:    schema = judging.schema_for('judging-v7')\n./tests/test_stance_fields.py:24:    schema = judging.schema_for('judging-v7')\n./tests/test_english.py:147:    assert judging.schema_for('judging-v7')['properties']['pushes']['items']['properties']['push']['enum'] == vocabulary.PUSHES\n./clean-arch/e2e-misses-2026-11-11/resend.py:132:                                  judging.schema_for(cfg.rejudging.prompt_version), 'judgement', cfg.provider)\n./docs/research/2026-11-04-argument-record/probe_v9.py:59:    schema = judging.schema_for('judging-v9')\n./scripts/preflight.py:35:SCHEMAS = {'extract': extraction.schema_for(extraction.SUPPORTED_VERSIONS[0]), 'match': matching.SCHEMA, 'judge': judging.schema_for(judging.SUPPORTED_VERSIONS[0])}\n./docs/research/2026-11-04-argument-record/probe_counterfactual.py:3:the code (`judging.schema_for`, its key order as built) and `model.build_request`; the probe refuses to send unless the rebuilt request's\n./docs/research/2026-11-04-argument-record/probe_counterfactual.py:52:    schema = judging.schema_for(spec.get('version', 'judging-v8'))\n./docs/research/2026-11-04-argument-record/probe_counterfactual.py:72:        schemas[name] = judging.schema_for(swap['version'])\n./clean-arch/step2-edge-effect-2026-11-10/judge_probe.py:90:                                  judging.schema_for(cfg.rejudging.prompt_version), 'judgement', cfg.provider)\n./docs/research/2026-11-04-filing-end-to-end/baseline_all_send.py:98:    schema = judging.schema_for(cfg.rejudging.prompt_version)\n./docs/research/2026-11-04-filing-end-to-end/oracle_build.py:129:    schema = judging.schema_for(cfg.rejudging.prompt_version)\n./docs/research/2026-11-04-filing-end-to-end/oracle_send.py:29:    schema = judging.schema_for(cfg.rejudging.prompt_version)\n./docs/research/2026-11-04-filing-end-to-end/one_test.py:44:    schema = judging.schema_for('judging-v7')\n./docs/research/2026-11-04-filing-end-to-end/baseline_judge.py:39:    schema = judging.schema_for(cfg.rejudging.prompt_version)\n./docs/research/2026-11-04-filing-end-to-end/baseline_all_judge.py:75:    schema = judging.schema_for(cfg.rejudging.prompt_version)\n./docs/research/2026-11-01-e2e-loop/harness/resend_judge.py:2:request of one run, replace the system prompt with the new version's and the response schema with `judging.schema_for(new version)`\n./docs/research/2026-11-01-e2e-loop/harness/resend_judge.py:27:    schema = judging.schema_for(version)\n./docs/research/2026-11-14-use-acceptance/effect/effect_test.py:38:    setting, schema = cfg.rejudging, judging.schema_for(cfg.rejudging.prompt_version)\n./docs/research/2026-11-20-hybrid/judge_probe.py:150:    schema = judging.schema_for(cfg.rejudging.prompt_version)\n./docs/research/2026-11-20-hybrid/judge_probe.py:610:    original_schema, original_prompt = judging.schema_for, judging.build_prompt\n./docs/research/2026-11-20-hybrid/judge_probe.py:617:        judging.schema_for = schema_for\n./docs/research/2026-11-14-use-acceptance/unsupported/judge_account.py:50:    setting, schema = cfg.rejudging, judging.schema_for(cfg.rejudging.prompt_version)\n./docs/research/2026-11-20-production-readiness/dependency-probe/probe.py:59:    schema = judging.schema_for(version)\n./docs/research/2026-11-14-use-acceptance/self-report/self_report.py:45:    setting, schema = cfg.rejudging, judging.schema_for(cfg.rejudging.prompt_version)\nsrc/hivemind/extraction.py:258:        head, tail = quote_tokens[:split], quote_tokens[split:]\nscripts/replay.py:5:      --archive poc/data/<run>/archive.sqlite [--only NVDA] [--workers 1]\nscripts/replay.py:11:replay.log beside the ledger. Each day runs with hivemind.parallel_day by default (D183): up to `--workers` (16)\nscripts/replay.py:12:extraction requests prepared early and validated against the committed ledger at each item's turn, `--jev-workers`\nscripts/replay.py:13:Jev matching questions at a time (8; one at a time for another matching engine); the ledger equals the serial one for\nscripts/replay.py:14:the same answers (D181, D182). Its per-day manifests are written beside the ledger. `--workers 1` runs the serial\nscripts/replay.py:15:path, which sends no call on a rerun over saved answers and resumes a day a serial run left unfinished.\nscripts/replay.py:26:from hivemind import config, model, parallel_day, replay, universe  # noqa: E402\nscripts/replay.py:85:    parser.add_argument('--workers', type=int, default=16, help='extraction requests prepared at a time (D183); 1 is the serial path')\nscripts/replay.py:86:    parser.add_argument('--jev-workers', type=int, default=None,\nscripts/replay.py:87:                        help='Jev matching questions sent at a time when --workers > 1; default 8 for Jev, 1 for another engine')\nscripts/replay.py:107:    if args.workers > 1:\nscripts/replay.py:108:        jev_workers = args.jev_workers if args.jev_workers is not None else (8 if cfg.matching.engine == 'jev' else 1)\nscripts/replay.py:109:        day_runner = parallel_day.ParallelDay(os.path.abspath(args.testdb), os.path.join(os.path.dirname(os.path.abspath(args.views)), 'manifests'),\nscripts/replay.py:110:                                              extraction_workers=args.workers, jev_workers=jev_workers)\nscripts/replay.py:112:        f' workers {args.workers}')\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_26","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"PYTHONDONTWRITEBYTECODE=1 PYTHONPATH=src python3 -c '\nfrom collections import Counter, defaultdict\nfrom pathlib import Path\nfrom hivemind.views import judging, store\nfrom hivemind import model, config\nimport sqlite3,json,re,statistics\nbase=Path('\\\\''poc/data/comparison-2026-11-17/run'\\\\'')\nscratch=Path('\\\\''/private/tmp/claude-501/-Users-lchingen-hivemind/f1ea972d-85a1-4f27-8010-cf0b60054109/scratchpad'\\\\'')\ndef con(p):\n c=sqlite3.connect(f'\\\\''file:{p.resolve()}?mode=ro&immutable=1'\\\\'',uri=True); c.row_factory=sqlite3.Row\n return c\npaths=[(f'\\\\''old-{x}'\\\\'',base/f'\\\\''old-{x}'\\\\''/'\\\\''prod'\\\\'') for x in range(1,4)]+[(x,scratch/f'\\\\''{x}-copy'\\\\'') for x in ('\\\\''control-1'\\\\'','\\\\''linked-1'\\\\'')]\ngroups=defaultdict(list)\nfor label,p in paths:\n a=con(p/'\\\\''archive.sqlite'\\\\''); v=con(p/'\\\\''views.sqlite'\\\\''); lower=8737 if '\\\\''copy'\\\\'' in p.name else 0\n sizes=[]; stringchars=[]\n for cid,sha,req,ans,res in a.execute(\\\"select call_id,request_sha256,request_json,answer_json,response_json from model_calls where purpose='\\\\''judge'\\\\'' and call_id>? order by call_id\\\",(lower,)):\n  q=json.loads(req); u=q['\\\\''messages'\\\\''][-1]['\\\\''content'\\\\'']; e=sorted(judging.evidence_shown_in(u)); t=sorted(judging.themes_shown_in(u)); dep=sorted(set(re.findall(r'\\\\''\"'^- (v'\"\\\\d+) \\\\('\\\\'',u.split('\\\\''\\\\n[Current conclusions of the theses it depends on]'\\\\'',1)[1].split('\\\\''\\\\n\\\\n['\\\\'',1)[0],re.M))) if '\\\\''\\\\n[Current conclusions of the theses it depends on]'\\\\'' in u else []\n  s=q['\\\\''response_format'\\\\'']['\\\\''json_schema'\\\\'']['\\\\''schema'\\\\'']; before=len(json.dumps(q).encode())\n  def close(field, values, sub=None):\n   a=s['\\\\''properties'\\\\''][field]\n   if not values: a['\\\\''maxItems'\\\\'']=0\n   else: (a['\\\\''items'\\\\'']['\\\\''properties'\\\\''][sub] if sub else a['\\\\''items'\\\\''])['\\\\''enum'\\\\'']=values\n  close('\\\\''cites'\\\\'',e);close('\\\\''pushes'\\\\'',e,'\\\\''evidence_id'\\\\'');close('\\\\''cites_views'\\\\'',dep);close('\\\\''theme_pushes'\\\\'',t,'\\\\''view_id'\\\\'')\n  sizes.append((len(json.dumps(q).encode())-before,cid))\n  def chars(obj):\n   total=sum(map(len,obj.get('\\\\''enum'\\\\'',[]))) if '\\\\''enum'\\\\'' in obj else 0\n   total+=sum(len(k)+chars(x) for k,x in obj.get('\\\\''properties'\\\\'',{}).items())\n   if isinstance(obj.get('\\\\''items'\\\\''),dict): total+=chars(obj['\\\\''items'\\\\''])\n   return total\n  stringchars.append((chars(s),cid))\n  committed=v.execute('\\\\''select publication_day,seq,view_id from judgements where call_id=? and request_sha256=?'\\\\'',(cid,sha)).fetchone()\n  flags=('\\\\''refused'\\\\'' if '\\\\'':refused:'\\\\'' in sha else '\\\\''committed'\\\\'' if committed else '\\\\''uncommitted'\\\\'')\n  groups[(sha.split('\\\\'':'\\\\'')[0],ans)].append((label,cid,flags))\n  if label=='\\\\''old-2'\\\\'' and cid in [591,596,6955,6979,7068,7073,7774,7780]:\n   print(label,cid,dict(committed) if committed else flags)\n  if label=='\\\\''linked-1'\\\\'' and cid in [8740,8848,8888,8910]:\n   print(label,cid,'\\\\''deps='\\\\'',dep,'\\\\''themes='\\\\'',t)\n  if label=='\\\\''old-2'\\\\'' and cid==591:\n   memory=sqlite3.connect('\\\\'':memory:'\\\\'',check_same_thread=False); memory.executescript(model.SCHEMA_SQL)\n   import threading\n   archive=model.Archive.__new__(model.Archive); archive.conn=memory; archive.lock=threading.Lock()\n   cfg=config.load('\\\\''poc/config/poc-v118.json'\\\\'')\n   try: model.call(archive,cfg,cfg.rejudging,q['\\\\''messages'\\\\''][0]['\\\\''content'\\\\''],u,s,'\\\\''judgement'\\\\'','\\\\''judge'\\\\'',transport=lambda *a:json.loads(res))\n   except model.SchemaError as exc: print('\\\\''ACTUAL model.call returned SchemaError at'\\\\'',str(exc).split('\\\\'' not in '\\\\'')[0])\n   print('\\\\''new in-memory archive row'\\\\'',memory.execute('\\\\''select case when request_sha256 like \\\"%:schema:%\\\" then \\\"schema\\\" else request_sha256 end,purpose from model_calls'\\\\'').fetchall())\n print(label,'\\\\''added schema bytes median/max'\\\\'',statistics.median(k for k,_ in sizes),max(sizes),'\\\\''provider counted string chars max'\\\\'',max(stringchars))\nprint('\\\\''duplicate request + answer groups'\\\\'',len([x for x in groups.values() if len(x)>1]))\nprint('\\\\''duplicate groups touching refused/uncommitted:'\\\\'',[x for x in groups.values() if len(x)>1 and any(z[2]\"'!='\"'\\\\''committed'\\\\'' for z in x)])\nprint('\\\\''all uncommitted:'\\\\'',[x for x in groups.values() if any(z[2]=='\\\\''uncommitted'\\\\'' for z in x)])\nprint('\\\\''unique groups total, statuses'\\\\'',len(groups),Counter(tuple(sorted({z[2] for z in x})) for x in groups.values()))\n'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
