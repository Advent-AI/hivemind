{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba src/hivemind/model.py | sed -n '69,295p'; nl -ba src/hivemind/config.py; nl -ba tests/test_frozen_questions_and_judgement.py\"","aggregated_output":"    69\tclass Archive:\n    70\t    \"\"\"Shared by the extraction worker threads: one connection, every access under a lock.\"\"\"\n    71\t\n    72\t    def __init__(self, path):\n    73\t        os.makedirs(os.path.dirname(os.path.abspath(path)), exist_ok=True)\n    74\t        self.conn = sqlite3.connect(path, check_same_thread=False)\n    75\t        self.conn.executescript(SCHEMA_SQL)\n    76\t        import threading\n    77\t        self.lock = threading.Lock()\n    78\t\n    79\t    def lookup(self, sha):\n    80\t        with self.lock:\n    81\t            return self.conn.execute('select call_id, answer_json, prompt_chars, input_tokens, output_tokens from model_calls where request_sha256=?', (sha,)).fetchone()\n    82\t\n    83\t    def record(self, **fields):\n    84\t        \"\"\"One row per distinct request; a second identical request recorded at the same moment (two threads, or a\n    85\t        failed answer repeated within the same second) keeps the first row's id instead of failing.\"\"\"\n    86\t        columns = list(fields)\n    87\t        with self.lock:\n    88\t            cursor = self.conn.execute(f'insert or ignore into model_calls ({\",\".join(columns)}) values ({\",\".join(\"?\" * len(columns))})',\n    89\t                                       [fields[c] for c in columns])\n    90\t            self.conn.commit()\n    91\t            if cursor.rowcount == 0:\n    92\t                return self.conn.execute('select call_id from model_calls where request_sha256=?', (fields['request_sha256'],)).fetchone()[0]\n    93\t            return cursor.lastrowid\n    94\t\n    95\t    def retire(self, call_id):\n    96\t        \"\"\"A code check refused this answer: the row stays for the record, but no later identical request is answered with it\n    97\t        (the same shape as a schema-refused or malformed row, whose hash carries a suffix).\"\"\"\n    98\t        with self.lock:\n    99\t            self.conn.execute(\"update model_calls set request_sha256 = request_sha256 || ':refused:' || ? where call_id=? and request_sha256 not like '%:refused:%'\",\n   100\t                              (uuid.uuid4().hex[:8], call_id))\n   101\t            self.conn.commit()\n   102\t\n   103\t    def totals(self):\n   104\t        with self.lock:\n   105\t            return self.conn.execute('select count(*), coalesce(sum(cost_usd),0), coalesce(sum(input_tokens),0), coalesce(sum(output_tokens),0) from model_calls').fetchone()\n   106\t\n   107\t\n   108\tdef _key(provider):\n   109\t    name = ENDPOINTS[provider][1]\n   110\t    if os.environ.get(name):\n   111\t        return os.environ[name]\n   112\t    with open(CREDENTIALS, encoding='utf-8') as handle:\n   113\t        return json.load(handle)[name]\n   114\t\n   115\t\n   116\tdef build_request(setting, system, user, schema, schema_name, provider):\n   117\t    request = {\n   118\t        'model': setting.model,\n   119\t        'messages': [{'role': 'system', 'content': system}, {'role': 'user', 'content': user}],\n   120\t        'response_format': {'type': 'json_schema', 'json_schema': {'name': schema_name, 'strict': True, 'schema': schema}},\n   121\t    }\n   122\t    if provider == 'openai':\n   123\t        request['max_completion_tokens'] = setting.max_output_tokens\n   124\t        if setting.reasoning_effort:\n   125\t            request['reasoning_effort'] = setting.reasoning_effort\n   126\t    else:\n   127\t        request['max_tokens'] = setting.max_output_tokens\n   128\t    return request\n   129\t\n   130\t\n   131\tdef openai_transport(provider, request, timeout=180, max_attempts=3):   # the default preserves the production retry behavior\n   132\t    url, _ = ENDPOINTS[provider]\n   133\t    body = json.dumps(request).encode('utf-8')\n   134\t    headers = {'Authorization': f'Bearer {_key(provider)}', 'Content-Type': 'application/json'}\n   135\t    last = None\n   136\t    last_http = None\n   137\t    if isinstance(max_attempts, bool) or not isinstance(max_attempts, int) or max_attempts < 1:\n   138\t        raise ValueError('max_attempts must be a positive integer')\n   139\t    for attempt in range(max_attempts):\n   140\t        try:\n   141\t            with urllib.request.urlopen(urllib.request.Request(url, data=body, headers=headers, method='POST'), timeout=timeout) as response:\n   142\t                raw_bytes = response.read()\n   143\t                try:\n   144\t                    raw = raw_bytes.decode('utf-8')\n   145\t                except UnicodeDecodeError:\n   146\t                    if max_attempts != 1:\n   147\t                        raise\n   148\t                    failure = TransportError('invalid UTF-8 HTTP response')\n   149\t                    failure.response_body = raw_bytes.decode('utf-8', 'replace')\n   150\t                    failure.response_body_base64 = base64.b64encode(raw_bytes).decode('ascii')\n   151\t                    failure.http_status = response.status\n   152\t                    raise failure\n   153\t                try:\n   154\t                    return json.loads(raw)\n   155\t                except json.JSONDecodeError:\n   156\t                    if max_attempts != 1:\n   157\t                        raise\n   158\t                    failure = TransportError('malformed HTTP response')\n   159\t                    failure.response_body = raw\n   160\t                    failure.http_status = response.status\n   161\t                    raise failure\n   162\t        except urllib.error.HTTPError as error:\n   163\t            body_bytes = error.read()\n   164\t            body_text = body_bytes.decode('utf-8', 'replace' if max_attempts == 1 else 'ignore')\n   165\t            last_http = (error.code, body_text, base64.b64encode(body_bytes).decode('ascii'))\n   166\t            last = f'HTTP {error.code}: {body_text[:600]}'\n   167\t            if error.code in (400, 401, 403, 404):\n   168\t                failure = TransportError(last)\n   169\t                failure.response_body = body_text\n   170\t                failure.response_body_base64 = last_http[2]\n   171\t                failure.http_status = error.code\n   172\t                raise failure\n   173\t        except (urllib.error.URLError, TimeoutError, ConnectionError, OSError, http.client.HTTPException) as error:   # a dropped or truncated response is retried like a network error\n   174\t            last = repr(error)[:200]\n   175\t            last_http = None   # the final failure describes the last attempt only\n   176\t        if max_attempts == 3 or attempt + 1 < max_attempts:\n   177\t            time.sleep(5 * (attempt + 1))\n   178\t    failure = TransportError(last or 'no answer')\n   179\t    if last_http:\n   180\t        failure.http_status, failure.response_body, failure.response_body_base64 = last_http\n   181\t    raise failure\n   182\t\n   183\t\n   184\tdef check_schema(value, schema, path='$', root=None):\n   185\t    \"\"\"A small validator for the subset of JSON Schema the prompts use: object/required/additionalProperties,\n   186\t    array/items/minItems, string/enum/pattern, integer, number, boolean, null in anyOf, and $ref into the root's $defs.\"\"\"\n   187\t    root = root if root is not None else schema\n   188\t    if '$ref' in schema:\n   189\t        name = schema['$ref'].rsplit('/', 1)[1]\n   190\t        schema = root['$defs'][name]\n   191\t    kind = schema.get('type')\n   192\t    if 'anyOf' in schema:\n   193\t        # a value matching no option reports the closest options' errors (fewest), not merely the last option's\n   194\t        failures = []\n   195\t        for option in schema['anyOf']:\n   196\t            errors = check_schema(value, option, path, root)\n   197\t            if not errors:\n   198\t                return []\n   199\t            failures.append(errors)\n   200\t        fewest = min((len(errors) for errors in failures), default=0)\n   201\t        closest = list(dict.fromkeys(error for errors in failures if len(errors) == fewest for error in errors))\n   202\t        return closest or [f'{path}: matches no option']\n   203\t    if kind == 'object':\n   204\t        if not isinstance(value, dict):\n   205\t            return [f'{path}: expected object']\n   206\t        errors = []\n   207\t        for name in schema.get('required', []):\n   208\t            if name not in value:\n   209\t                errors.append(f'{path}.{name}: required')\n   210\t        properties = schema.get('properties', {})\n   211\t        for name, item in value.items():\n   212\t            if name in properties:\n   213\t                errors.extend(check_schema(item, properties[name], f'{path}.{name}', root))\n   214\t            elif schema.get('additionalProperties') is False:\n   215\t                errors.append(f'{path}.{name}: not allowed')\n   216\t        return errors\n   217\t    if kind == 'array':\n   218\t        if not isinstance(value, list):\n   219\t            return [f'{path}: expected array']\n   220\t        errors = []\n   221\t        if len(value) < schema.get('minItems', 0):\n   222\t            errors.append(f'{path}: fewer than {schema[\"minItems\"]} items')\n   223\t        for index, item in enumerate(value):\n   224\t            errors.extend(check_schema(item, schema.get('items', {}), f'{path}[{index}]', root))\n   225\t        return errors\n   226\t    if kind == 'string':\n   227\t        if not isinstance(value, str):\n   228\t            return [f'{path}: expected string']\n   229\t        if 'enum' in schema and value not in schema['enum']:\n   230\t            return [f'{path}: {value!r} not in {schema[\"enum\"]}']\n   231\t        if 'pattern' in schema and not re.search(schema['pattern'], value):\n   232\t            return [f'{path}: {value!r} does not match {schema[\"pattern\"]}']\n   233\t        return []\n   234\t    if kind == 'integer':\n   235\t        return [] if isinstance(value, int) and not isinstance(value, bool) else [f'{path}: expected integer']\n   236\t    if kind == 'number':\n   237\t        return [] if isinstance(value, (int, float)) and not isinstance(value, bool) else [f'{path}: expected number']\n   238\t    if kind == 'boolean':\n   239\t        return [] if isinstance(value, bool) else [f'{path}: expected boolean']\n   240\t    if kind == 'null':\n   241\t        return [] if value is None else [f'{path}: expected null']\n   242\t    return []\n   243\t\n   244\t\n   245\tdef request_identity(request):\n   246\t    \"\"\"The exact serialized request and its archive key, shared by callers and validation.\"\"\"\n   247\t    encoded = json.dumps(request, sort_keys=True, ensure_ascii=False)\n   248\t    return encoded, hashlib.sha256(encoded.encode('utf-8')).hexdigest()\n   249\t\n   250\t\n   251\tdef call(archive, cfg, setting, system, user, schema, schema_name, purpose, *, transport=None):\n   252\t    provider = cfg.provider\n   253\t    request = build_request(setting, system, user, schema, schema_name, provider)\n   254\t    request_json, sha = request_identity(request)\n   255\t    hit = archive.lookup(sha)\n   256\t    prompt_chars = len(system) + len(user)\n   257\t    if hit:\n   258\t        call_id, answer_json, _, input_tokens, output_tokens = hit\n   259\t        return Answer(json.loads(answer_json), call_id, sha, True, prompt_chars, input_tokens or 0, output_tokens or 0, 0.0)\n   260\t    started = time.time()\n   261\t    response = (transport or openai_transport)(provider, request)\n   262\t    seconds = round(time.time() - started, 1)\n   263\t    try:\n   264\t        content = response['choices'][0]['message']['content']\n   265\t        data = json.loads(content)\n   266\t    except (KeyError, IndexError, TypeError, json.JSONDecodeError) as error:\n   267\t        archive.record(purpose=purpose, config_version=cfg.version, config_checksum=cfg.checksum, model=setting.model,\n   268\t                       request_sha256=sha + ':malformed:' + uuid.uuid4().hex[:8], request_json=request_json,\n   269\t                       response_json=json.dumps(response)[:200000], answer_json=None, prompt_chars=prompt_chars,\n   270\t                       input_tokens=0, output_tokens=0, cost_usd=0.0, seconds=seconds, created_at=time.strftime('%Y-%m-%dT%H:%M:%S'))\n   271\t        raise SchemaError(f'malformed answer: {error}')\n   272\t    errors = check_schema(data, schema)\n   273\t    usage = response.get('usage') or {}\n   274\t    input_tokens = int(usage.get('prompt_tokens') or 0)\n   275\t    output_tokens = int(usage.get('completion_tokens') or 0)\n   276\t    cached_tokens = min(input_tokens, int((usage.get('prompt_tokens_details') or {}).get('cached_tokens') or 0))\n   277\t    price_in, price_out = PRICES.get(setting.model, (0.0, 0.0))\n   278\t    cost = round((input_tokens - cached_tokens) / 1e6 * price_in + cached_tokens / 1e6 * price_in * CACHED_INPUT_SHARE + output_tokens / 1e6 * price_out, 6)\n   279\t    call_id = archive.record(purpose=purpose, config_version=cfg.version, config_checksum=cfg.checksum, model=setting.model,\n   280\t                             request_sha256=sha if not errors else sha + ':schema:' + uuid.uuid4().hex[:8], request_json=request_json,\n   281\t                             response_json=json.dumps(response)[:200000], answer_json=json.dumps(data, ensure_ascii=False),\n   282\t                             prompt_chars=prompt_chars, input_tokens=input_tokens, output_tokens=output_tokens, cost_usd=cost,\n   283\t                             seconds=seconds, created_at=time.strftime('%Y-%m-%dT%H:%M:%S'))\n   284\t    if errors:\n   285\t        raise SchemaError('; '.join(errors[:5]))\n   286\t    return Answer(data, call_id, sha, False, prompt_chars, input_tokens, output_tokens, cost)\n     1\t\"\"\"Config (docs/prd/03-config.md): a versioned file of the settings a person chooses, with a checksum written into\n     2\tevery model call's record. A version that references a missing setting is refused whole.\"\"\"\n     3\timport dataclasses\n     4\timport hashlib\n     5\timport json\n     6\timport os\n     7\t\n     8\tPROMPTS = os.path.join(os.path.dirname(__file__), 'prompts')\n     9\t\n    10\t\n    11\tclass ConfigError(ValueError):\n    12\t    pass\n    13\t\n    14\t\n    15\tdef prompt_path(name):\n    16\t    \"\"\"The file of a prompt the config names, for example role-v1.txt or matching-v1.txt.\"\"\"\n    17\t    return os.path.join(PROMPTS, name)\n    18\t\n    19\t\n    20\tdef _prompt_files(extraction, matching, rejudging, idea=None, idea_summary=None, collision=None, placement=None):\n    21\t    \"\"\"03-config: a version that names a prompt that does not exist is refused whole. An extraction setting's\n    22\t    prompt_version is '<category>-<v>': block 2 and 4 come from categories-<v>.json (the category's entry) and the\n    23\t    role from role-<v>.txt; matching, re-judging and the idea reading name their file without the extension.\"\"\"\n    24\t    for category, setting in extraction.items():\n    25\t        prefix, _, version = setting.prompt_version.rpartition('-')\n    26\t        if prefix != category or not version:\n    27\t            raise ConfigError(f'extraction.{category}: prompt_version {setting.prompt_version!r} must be {category}-<version>')\n    28\t        categories_file = prompt_path(f'categories-{version}.json')\n    29\t        if not os.path.exists(categories_file) or not os.path.exists(prompt_path(f'role-{version}.txt')):\n    30\t            raise ConfigError(f'extraction.{category}: prompts for version {version!r} do not exist')\n    31\t        with open(categories_file, encoding='utf-8') as handle:\n    32\t            if category not in json.load(handle):\n    33\t                raise ConfigError(f'extraction.{category}: categories-{version}.json has no entry for {category}')\n    34\t    for setting in (matching, rejudging, idea, idea_summary, collision, placement):\n    35\t        if setting is not None and not os.path.exists(prompt_path(setting.prompt_version + '.txt')):\n    36\t            raise ConfigError(f'{setting.name}: prompt {setting.prompt_version}.txt does not exist')\n    37\t\n    38\t\n    39\t@dataclasses.dataclass(frozen=True)\n    40\tclass Setting:\n    41\t    name: str\n    42\t    model: str\n    43\t    prompt_version: str\n    44\t    reasoning_effort: str\n    45\t    max_output_tokens: int\n    46\t    engine: str = 'llm'       # matching only: 'llm' (the generative call), 'jev' (TypeSafe Jev, views/jev_matching.py) or 'jev-links' (Jev, and the reading links of views/links.py, D694)\n    47\t    link_questions: str = ''  # matching under 'jev-links' only: the version of the link questions (views/links.py), 'links-v1' when unnamed (D705)\n    48\t\n    49\t\n    50\tENGINES = ('llm', 'jev', 'jev-links')\n    51\tLINK_QUESTIONS = ('links-v1', 'links-v2')     # the link question versions views/links.py builds (D694, D705)\n    52\t\n    53\t\n    54\t@dataclasses.dataclass(frozen=True)\n    55\tclass Config:\n    56\t    version: str\n    57\t    checksum: str\n    58\t    provider: str\n    59\t    search_top_n: int\n    60\t    extraction: dict          # category -> Setting\n    61\t    matching: Setting\n    62\t    rejudging: Setting\n    63\t    final_verdict: Setting\n    64\t    idea: Setting = None      # the service's reading of a user's idea (docs/poc/idea-card.md); absent in pipeline-only configs\n    65\t    idea_summary: Setting = None  # optional analyst TLDR after the mapping is fixed\n    66\t    collision: Setting = None # D190: the analyst question asked of the generative model when a candidate lists a thesis of its own object and measure; absent: Jev alone\n    67\t    placement: Setting = None # 2026-10-28: the call that files an item's statements under existing theses (extraction v20); absent before v20\n    68\t    baseline: Setting = None  # D364: the coverage-start reading of the company's latest report (hivemind.baseline); absent: no such step\n    69\t\n    70\t    def extraction_setting(self, category):\n    71\t        setting = self.extraction.get(category)\n    72\t        if setting is None:\n    73\t            raise ConfigError(f'no extraction setting for category {category} in config {self.version}')\n    74\t        return setting\n    75\t\n    76\t\n    77\tREQUIRED = ('model', 'prompt_version', 'reasoning_effort', 'max_output_tokens')\n    78\t\n    79\t\n    80\tdef _setting(name, raw):\n    81\t    if not isinstance(raw, dict):\n    82\t        raise ConfigError(f'setting {name} is missing')\n    83\t    missing = [key for key in REQUIRED if key not in raw]\n    84\t    if missing:\n    85\t        raise ConfigError(f'setting {name} lacks {missing}')\n    86\t    engine = str(raw.get('engine', 'llm'))\n    87\t    if engine not in ENGINES:\n    88\t        raise ConfigError(f'setting {name}: engine {engine!r} is not one of {ENGINES}')\n    89\t    link_questions = ''\n    90\t    if 'link_questions' in raw:              # named: only in matching, only under jev-links, only one of the exact version strings\n    91\t        if name != 'matching' or engine != 'jev-links':\n    92\t            raise ConfigError(f'setting {name}: link_questions is read only by matching under the engine jev-links')\n    93\t        link_questions = raw['link_questions']\n    94\t        if not isinstance(link_questions, str) or link_questions not in LINK_QUESTIONS:\n    95\t            raise ConfigError(f'setting {name}: link_questions {link_questions!r} is not one of {LINK_QUESTIONS}')\n    96\t    elif name == 'matching' and engine == 'jev-links':\n    97\t        link_questions = 'links-v1'          # unnamed: the first version (poc-v119)\n    98\t    return Setting(name=name, model=str(raw['model']), prompt_version=str(raw['prompt_version']),\n    99\t                   reasoning_effort=str(raw['reasoning_effort']),\n   100\t                   max_output_tokens=int(raw['max_output_tokens']), engine=engine, link_questions=link_questions)\n   101\t\n   102\t\n   103\tdef load(path):\n   104\t    with open(path, encoding='utf-8') as handle:\n   105\t        text = handle.read()\n   106\t    raw = json.loads(text)\n   107\t    for key in ('version', 'provider', 'search_top_n', 'extraction', 'matching', 'rejudging', 'final_verdict'):\n   108\t        if key not in raw:\n   109\t            raise ConfigError(f'config lacks {key}')\n   110\t    canonical = json.dumps({k: v for k, v in raw.items() if not k.startswith('_')}, sort_keys=True, ensure_ascii=False)\n   111\t    checksum = hashlib.sha256(canonical.encode('utf-8')).hexdigest()[:16]\n   112\t    extraction = {category: _setting(f'extraction.{category}', setting) for category, setting in raw['extraction'].items()}\n   113\t    matching, rejudging = _setting('matching', raw['matching']), _setting('rejudging', raw['rejudging'])\n   114\t    idea = _setting('idea', raw['idea']) if 'idea' in raw else None\n   115\t    idea_summary = _setting('idea_summary', raw['idea_summary']) if 'idea_summary' in raw else None\n   116\t    if idea_summary is not None and idea is None:\n   117\t        raise ConfigError('idea_summary requires an idea setting')\n   118\t    collision = _setting('collision', raw['collision']) if 'collision' in raw else None\n   119\t    placement = _setting('placement', raw['placement']) if 'placement' in raw else None\n   120\t    baseline = _setting('baseline', raw['baseline']) if 'baseline' in raw else None\n   121\t    _prompt_files(extraction, matching, rejudging, idea, idea_summary, collision, placement)       # final_verdict is kept in the file but no POC step calls it\n   122\t    if baseline is not None and not os.path.exists(prompt_path(baseline.prompt_version + '.json')):\n   123\t        raise ConfigError(f'baseline: prompt {baseline.prompt_version}.json does not exist')\n   124\t    return Config(version=str(raw['version']), checksum=checksum, provider=str(raw['provider']),\n   125\t                  search_top_n=int(raw['search_top_n']), extraction=extraction,\n   126\t                  matching=matching, rejudging=rejudging, final_verdict=_setting('final_verdict', raw['final_verdict']), idea=idea, idea_summary=idea_summary, collision=collision, placement=placement,\n   127\t                  baseline=baseline)\n     1\t\"\"\"Steps 3 and 4 are frozen (D354, Alex 2026-11-03: \"那你跑了吧，我们赶紧确认step 3,4 可以freeze\"): opening and matching questions, and\n     2\tjudging them, as `poc/config/poc-v108.json` runs them (its sha256 is pinned in test_frozen_extraction_prompt.py). Every piece that shapes\n     3\tthose requests is pinned here: the collision judge's and the judge's prompt files, the matching prompt the configuration names, the\n     4\tjudge's answer schema, and the three questions the Jev matcher is asked. A change is a new version opened only by Alex's decision.\"\"\"\n     5\timport hashlib\n     6\timport json\n     7\timport os\n     8\timport sys\n     9\t\n    10\tROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))\n    11\tsys.path.insert(0, os.path.join(ROOT, 'src'))\n    12\tfrom hivemind.views import jev_matching, judging, links  # noqa: E402\n    13\t\n    14\tFROZEN_FILES = {\n    15\t    'src/hivemind/prompts/collision-v2.txt': 'a5f0f58d53c4f4215b14e534935b1f95a79b35ba097d68c0ab598af7b88a3bd0',\n    16\t    'src/hivemind/prompts/judging-v7.txt': 'd499c4b89ad038ade9bd41e037d766d5e54defecef273541f46dc01509db5a2c',\n    17\t    'src/hivemind/prompts/matching-v3.txt': '04e23ee314e71cb094273b23e75f816c467176969b8c17dfec5a6e5d17a45a49',\n    18\t    # D694: poc-v119's judge prompt is judging-v7's text byte for byte; only the code-built dependency block differs (tests/test_links.py)\n    19\t    'src/hivemind/prompts/judging-v8.txt': 'd499c4b89ad038ade9bd41e037d766d5e54defecef273541f46dc01509db5a2c',\n    20\t}\n    21\tJUDGING_SCHEMA_SHA = '4d1469ae9c14256c24e2c39e1b6cc772cb25e160c937f32091fc4f35bf539ca9'\n    22\tMATCHER_QUESTIONS_SHA = '86cb70600ce456be3cd5197ef173c38023513157fa3c92e341036651f95a5218'\n    23\tLINK_QUESTIONS_SHA = '4144f359701e0677159afb058701b721698ba3ae7bded61988de2f98f3c340b5'      # D694, D695: poc-v119's READS and SIGN questions\n    24\tLINK_QUESTIONS_V2_SHA = '3fc3ffff5dc8437db05fcd8f6b0ef1043bf53c43f66734f4782c1517b666d47e'   # D705: poc-v120's links-v2 questions (WORDING-V2.md)\n    25\t\n    26\t\n    27\tdef sha_of(value):\n    28\t    return hashlib.sha256(json.dumps(value, ensure_ascii=False, sort_keys=True).encode('utf-8')).hexdigest()\n    29\t\n    30\t\n    31\tdef test_the_frozen_question_and_judgement_prompt_files_are_unchanged():\n    32\t    for path, expected in FROZEN_FILES.items():\n    33\t        with open(os.path.join(ROOT, path), 'rb') as handle:\n    34\t            assert hashlib.sha256(handle.read()).hexdigest() == expected, f'{path} changed; steps 3 and 4 are frozen (D354)'\n    35\t\n    36\t\n    37\tdef test_the_code_written_parts_of_the_question_and_judgement_requests_are_unchanged():\n    38\t    assert sha_of(judging.schema_for('judging-v7')) == JUDGING_SCHEMA_SHA\n    39\t    questions = [jev_matching.relation_question('X'), jev_matching.member_question('X'), jev_matching.piece_question('X')]\n    40\t    assert sha_of(questions) == MATCHER_QUESTIONS_SHA\n    41\t\n    42\t\n    43\tdef test_the_linking_version_pins_its_questions_and_keeps_the_judge_schema():\n    44\t    assert sha_of(judging.schema_for('judging-v8')) == JUDGING_SCHEMA_SHA\n    45\t    questions = [links.reads_question('X'), links.sign_question('X', links.CANDIDATE_READS), links.sign_question('X', links.THESIS_READS)]\n    46\t    assert sha_of(questions) == LINK_QUESTIONS_SHA\n    47\t    version_two = [links.reads_question('X', version='links-v2'), links.sign_question('X', links.CANDIDATE_READS, version='links-v2'),\n    48\t                   links.sign_question('X', links.THESIS_READS, version='links-v2')]\n    49\t    assert sha_of(version_two) == LINK_QUESTIONS_V2_SHA\n","exit_code":0,"status":"completed"}}
