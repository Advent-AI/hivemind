{"type":"item.completed","item":{"id":"item_18","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba src/hivemind/views/round.py | sed -n '1,125p'; rg -n 'def dependencies_of|def resolve|def (open|close)_' src/hivemind/views/store.py; nl -ba docs/research/2026-11-21-whole-window/window_test.py | sed -n '30,111p'; nl -ba docs/research/2026-11-21-whole-window/paid_run.py | sed -n '140,190p;258,280p'; rg -n 'judging\\\\.schema_for|judging\\\\.build_prompt|judging\\\\.check_answer|judging-v[78]|prompt_chars' src scripts tests --glob '*.py'\"","aggregated_output":"     1\t\"\"\"One item = one round (06-views.md 进库): source check → store → lists → the matching calls → checks → write.\n     2\tRe-judging is the day's step (D63, 2026-10-24: once a day, over every view whose reading changed that day), run by\n     3\tthe replay after the day's items and before pull mode; see judge_day. Each step appends its processing row in the\n     4\tsame commit as its writes; a resume continues at the step the processing record names (after an ok step, or the\n     5\tfailed step itself) and never repeats a completed step.\"\"\"\n     6\timport dataclasses\n     7\timport json\n     8\t\n     9\tfrom .. import dispatch, extraction, vocabulary\n    10\tfrom . import jev_matching, judging, links, matching, store, writing\n    11\t\n    12\t\n    13\t@dataclasses.dataclass\n    14\tclass RoundResult:\n    15\t    input_id: str\n    16\t    evidence: int = 0\n    17\t    candidates: int = 0\n    18\t    new_views: int = 0\n    19\t    judged: int = 0\n    20\t    changed: int = 0\n    21\t    cost: float = 0.0\n    22\t    cached_calls: int = 0\n    23\t    failed: str = ''\n    24\t    dropped: int = 0\n    25\t\n    26\t\n    27\tdef _fail(conn, item, seq, result, step, kind, detail, pool_key):\n    28\t    dispatch.mark(conn, item, seq, step, 'failed', detail[:300])\n    29\t    store.pool(conn, kind, pool_key, {'input_id': item['input_id'], 'error': detail[:300]}, seq)\n    30\t    result.failed = detail[:200]\n    31\t    conn.commit()\n    32\t    return result\n    33\t\n    34\t\n    35\tdef _match(conn, archive, cfg, universe, item, seq, result, candidates, evidence, lists, shown, *, extra_views=(), call_offset=0, transport=None, workers=1):\n    36\t    \"\"\"One matching call with one retry on a refused check. Returns Checked, or None after marking the failure.\"\"\"\n    37\t    note = ''\n    38\t    checked = None\n    39\t    engine = jev_matching if cfg.matching.engine in ('jev', links.ENGINE) else matching      # Jev answers once; a retry would be the same answer\n    40\t    for attempt in range(1 if engine is jev_matching else 2):\n    41\t        try:\n    42\t            options = {'workers': workers, 'llm_transport': transport} if engine is jev_matching else {}     # the collision judge sends with the caller's transport too\n    43\t            answer = engine.decide(archive, cfg, conn, item, candidates, evidence, lists, shown, extra_views=extra_views, retry_note=note, transport=transport, **options)\n    44\t        except Exception as error:\n    45\t            _fail(conn, item, seq, result, 'matched', 'matching_failed', 'matching: ' + repr(error), type(error).__name__)\n    46\t            return None\n    47\t        result.cost += answer.cost_usd\n    48\t        result.cached_calls += int(answer.cached)\n    49\t        checked = matching.check(conn, universe, answer.data, candidates, evidence, lists, shown)\n    50\t        shown_record = {'candidates': lists.candidate_lists, 'evidence': {f'{k[0]}|{k[1]}': v for k, v in lists.evidence_lists.items()}}\n    51\t        if getattr(answer, 'request_records', None):\n    52\t            shown_record['requests'] = answer.request_records\n    53\t        store.insert(conn, 'match_records', seq=seq, input_id=item['input_id'], call_no=call_offset + attempt + 1,\n    54\t                     shown_json=json.dumps(shown_record),\n    55\t                     request_sha256=answer.request_sha256, call_id=answer.call_id, decisions_json=json.dumps(answer.data, ensure_ascii=False),\n    56\t                     checks_json=json.dumps({'refusals': checked.refusals, 'not_opened': checked.not_opened, 'notes': checked.notes}, ensure_ascii=False), written_json=None)\n    57\t        if not checked.refusals:\n    58\t            return checked\n    59\t        note = '；'.join(checked.refusals)\n    60\t    _fail(conn, item, seq, result, 'matched', 'matching_refused_twice', 'matching refused twice: ' + note, item['category'])\n    61\t    return None\n    62\t\n    63\t\n    64\tdef changed_views_of_day(conn, day):\n    65\t    \"\"\"The views whose reading changed on a replay day: the union of the 'written' records of that day's items and of the coverage-start reading's\n    66\t    record dated that day (D364: the questions it linked starting figures to are judged in the first day's round).\"\"\"\n    67\t    changed = set()\n    68\t    for row in conn.execute(\"select reason from processing_steps where step in ('written', 'baseline') and result='ok' and publication_day=?\", (day,)):\n    69\t        changed.update(json.loads(row['reason']).get('changed', []))\n    70\t    return changed\n    71\t\n    72\t\n    73\tdef judge_day(conn, archive, cfg, day, seq, *, transport=None, log=print):\n    74\t    \"\"\"D63: one re-judging round per day over every open view whose reading changed that day, dependencies first,\n    75\t    recorded under the day's own processing record (input 'day:<date>'); a view already judged at this sequence\n    76\t    number (a resumed day) is not judged twice.\"\"\"\n    77\t    marker = {'input_id': f'day:{day}', 'publication_day': day}\n    78\t    changed = changed_views_of_day(conn, day)\n    79\t    result = RoundResult(marker['input_id'])\n    80\t    if not changed:\n    81\t        return result\n    82\t    try:\n    83\t        judged = judging.round_of_judgements(archive, cfg, conn, sorted(changed), seq, marker, transport=transport)\n    84\t        result.judged = len(judged)\n    85\t        result.changed = sum(1 for j in judged if j['changed'])\n    86\t        result.cost += sum(j['cost'] for j in judged)\n    87\t        result.cached_calls += sum(1 for j in judged if j['cached'])\n    88\t        dispatch.mark(conn, marker, seq, 'judged', 'ok', f'{len(changed)} views changed, {len(judged)} judged, {result.changed} changed conclusions')\n    89\t        conn.commit()\n    90\t    except judging.JudgementRefused as error:\n    91\t        return _fail(conn, marker, seq, result, 'judged', 'judgement_refused_twice', 'judgement refused twice: ' + str(error), 'day')\n    92\t    except Exception as error:\n    93\t        return _fail(conn, marker, seq, result, 'judged', 'judging_failed', 'judging: ' + repr(error), type(error).__name__)\n    94\t    return result\n    95\t\n    96\t\n    97\tdef run(conn, archive, cfg, universe, item, seq, *, resume_from=None, transport=None, log=print, extractor=None, matching_workers=1):\n    98\t    result = RoundResult(item['input_id'])\n    99\t    if resume_from in ('judged', 'handed_over'):       # written already; judging is the day's step\n   100\t        dispatch.mark(conn, item, seq, 'handed_over', 'ok', 'resumed')\n   101\t        conn.commit()\n   102\t        return result\n   103\t    objects = [o['value'] for o in item.get('object_identifiers') or [] if universe.has(o['value'])]\n   104\t    shown = extraction.shown_views(conn, cfg, item, objects)\n   105\t    # extraction (or its stored handover on resume)\n   106\t    handover = None\n   107\t    if resume_from and resume_from != 'extracted':\n   108\t        row = conn.execute('select handover_json from handovers where input_id=? order by id desc limit 1', (item['input_id'],)).fetchone()\n   109\t        if row:\n   110\t            saved = vocabulary.extraction_answer(json.loads(row['handover_json']))          # a handover saved by a Chinese version reads in the canonical vocabulary\n   111\t            handover = extraction.Handover(saved['evidence'], saved['candidates'], saved['dropped'], 0, '', True, 0.0, saved.get('new_groups') or [])\n   112\t    if handover is None:\n   113\t        try:\n   114\t            handover = (extractor or extraction.extract)(archive, cfg, item, item['text'], shown, universe, transport=transport)\n   115\t        except Exception as error:\n   116\t            return _fail(conn, item, seq, result, 'extracted', 'extraction_failed', 'extraction: ' + repr(error), type(error).__name__)\n   117\t        result.cost += handover.cost_usd\n   118\t        result.cached_calls += int(handover.cached)\n   119\t        store.insert(conn, 'handovers', input_id=item['input_id'], seq=seq,\n   120\t                     handover_json=json.dumps({'evidence': handover.evidence, 'candidates': handover.candidates, 'dropped': handover.dropped, 'new_groups': handover.new_groups}, ensure_ascii=False))\n   121\t        dispatch.mark(conn, item, seq, 'extracted', 'ok', f'{len(handover.evidence)} evidence, {len(handover.candidates)} candidates, {len(handover.dropped)} dropped')\n   122\t        conn.commit()\n   123\t    result.evidence, result.candidates, result.dropped = len(handover.evidence), len(handover.candidates), len(handover.dropped)\n   124\t    if not handover.evidence and not handover.candidates:\n   125\t        dispatch.mark(conn, item, seq, 'handed_over', 'ok', 'nothing to match')\n57:def open_db(path):\n171:def open_views_with_key(conn, object_id, measure, scope_key, period_start, period_end, basis='n/a', unit='n/a', event_type=None):\n201:def close_view(conn, view_id, reason, by_whom, seq):\n205:def open_views(conn):\n223:def open_read_only(path):\n242:def dependencies_of(conn, view_id):\n    30\timport july_test                                            # noqa: E402\n    31\timport rebuild_control                                      # noqa: E402\n    32\t\n    33\tHERE = Path(__file__).resolve().parent\n    34\t\n    35\tOLD2 = july_test.OLD2\n    36\tITEMS = july_test.ITEMS\n    37\tV119 = july_test.V119\n    38\tUNIVERSE = july_test.UNIVERSE\n    39\tWINDOW = ('2026-07-01', '2026-09-20')\n    40\t\n    41\t\n    42\tdef refused_rows():\n    43\t    \"\"\"old-2's answers its own run refused (the archive keeps them under the request's hash with a ':refused:' suffix, so no later\n    44\t    identical request is answered with them): {request hash: stored provider response}. A replay must meet each refusal again to\n    45\t    reach the stored retry.\"\"\"\n    46\t    stored = sqlite3.connect(f'file:{OLD2 / \"archive.sqlite\"}?mode=ro', uri=True)\n    47\t    return {sha.split(':refused:')[0]: json.loads(response) for sha, response in\n    48\t            stored.execute(\"select request_sha256, response_json from model_calls where request_sha256 like '%:refused:%' order by call_id\")}\n    49\t\n    50\t\n    51\tdef replay_window(folder, link_answer, cfg_path=V119):\n    52\t    \"\"\"poc-v119 from an empty ledger over the whole window: link questions go to `link_answer`; every other request must be answered\n    53\t    from the copy of old-2's archive (an answer old-2's own run refused is given back once, so the check refuses it again); anything\n    54\t    else stops the pass. Returns the census: equality with old-2, every link job, every opening with its pairs.\"\"\"\n    55\t    if folder.exists():\n    56\t        raise SystemExit(f'{folder} exists: a pass starts from an empty folder')\n    57\t    folder.mkdir(parents=True)\n    58\t    shutil.copyfile(OLD2 / 'archive.sqlite', folder / 'archive.sqlite')\n    59\t    views = folder / 'views.sqlite'\n    60\t    marker = sqlite3.connect(views)                 # marked harness-only before the first item: ordinary writers refuse it (D694 §0)\n    61\t    marker.execute('create table harness_only (name text, day text)')\n    62\t    marker.execute(\"insert into harness_only values ('window_test.py', '2026-11-21')\")\n    63\t    marker.commit()\n    64\t    marker.close()\n    65\t    held = live_lock.acquire(str(views))            # the store lock for the whole pass: no second writer\n    66\t    asked, refused_again = [], []\n    67\t    stored_refusals = refused_rows()\n    68\t\n    69\t    def transport(*args):\n    70\t        if len(args) == 1 and july_test.is_link_request(args[0]):\n    71\t            asked.append(sorted(args[0]['questions']))\n    72\t            return link_answer(args[0])\n    73\t        response = stored_refusals.pop(model.request_identity(args[-1])[1], None)\n    74\t        if response is not None:                   # old-2's own run refused this answer: give it back, so the check refuses it again\n    75\t            refused_again.append(model.request_identity(args[-1])[1][:12])\n    76\t            return response\n    77\t        (folder / 'missed-request.json').write_text(json.dumps(args[-1], ensure_ascii=False, indent=1))\n    78\t        raise july_test.Stop('a request other than a link question missed the archive')\n    79\t    started = time.time()\n    80\t    try:\n    81\t        totals = replay.run(testdb_path=str(ITEMS), views_path=str(views), archive=model.Archive(str(folder / 'archive.sqlite')),\n    82\t                            cfg=config.load(str(cfg_path)), universe=universe.load(str(UNIVERSE)), from_day=WINDOW[0], until_day=WINDOW[1],\n    83\t                            transport=transport, log=lambda *a: None, only_objects={'NVDA'})\n    84\t    finally:\n    85\t        live_lock.release(held)\n    86\t    print('totals:', totals, 'seconds:', round(time.time() - started))\n    87\t    conn = sqlite3.connect(f'file:{folder / \"views.sqlite\"}?mode=ro', uri=True)\n    88\t    last_seq = conn.execute('select max(seq) from days_completed').fetchone()[0]\n    89\t    stored_last = sqlite3.connect(f'file:{OLD2 / \"views.sqlite\"}?mode=ro', uri=True).execute('select max(seq) from days_completed').fetchone()[0]\n    90\t    print('last completed seq', last_seq, 'old-2', stored_last)\n    91\t    equal = last_seq == stored_last and rebuild_control.compare(folder / 'views.sqlite', last_seq)\n    92\t    openings = []\n    93\t    for attempt, seq, status, record_json in conn.execute('select attempt_id, seq, status, record_json from link_selections order by id'):\n    94\t        record = json.loads(record_json)\n    95\t        if status == 'proposed' and record.get('pairs'):\n    96\t            openings.append({'attempt': attempt, 'seq': seq, 'pairs': record['pairs'], 'calls': record.get('calls', []),\n    97\t                             'proposed': record.get('proposed', []), 'corrections': record.get('corrections', [])})\n    98\t    census = {'equal to old-2': equal, 'link jobs asked': len(asked), 'questions in them': sum(len(a) for a in asked),\n    99\t              \"old-2's refused answers met again\": refused_again, 'left unmet': sorted(sha[:12] for sha in stored_refusals),\n   100\t              'link rows written': conn.execute(\"select count(*) from dependencies where kind='reads'\").fetchone()[0],\n   101\t              'openings with a pair shown': openings}\n   102\t    (folder / 'census.json').write_text(json.dumps(census, indent=1))\n   103\t    print(json.dumps({k: v for k, v in census.items() if k != 'openings with a pair shown'}, indent=1))\n   104\t    for opening in openings:\n   105\t        eligible = [p['thesis'] for p in opening['pairs'] if p.get('eligible')]\n   106\t        print(opening['seq'], 'eligible', eligible, 'not eligible', len(opening['pairs']) - len(eligible))\n   107\t    return census\n   108\t\n   109\t\n   110\tdef neither(scratch):\n   111\t    return replay_window(scratch / 'neither-v119', july_test.fake_jev(set()))['equal to old-2']\n   140\t\n   141\t\n   142\tdef is_judgement_request(request):\n   143\t    schema = (request.get('response_format') or {}).get('json_schema') or {}\n   144\t    return schema.get('name') == 'judgement' and july_test.judged_view(request) is not None\n   145\t\n   146\t\n   147\tclass SequenceRun:\n   148\t    \"\"\"One sequence: its transport, its latch, the judging day, the upstream snapshots and the record of every judge attempt.\"\"\"\n   149\t\n   150\t    def __init__(self, kind, draw, inner, folder):\n   151\t        self.kind, self.draw, self.inner, self.folder = kind, draw, inner, folder\n   152\t        self.reader_days = readers(draw)\n   153\t        self.probe = window_test.probe_answers(draw) if kind == 'linked' else {}\n   154\t        self.stored_refusals = window_test.refused_rows()\n   155\t        self.latch = july_test.Latch()\n   156\t        self.day = None\n   157\t        self.attempts, self.refusals_given, self.link_jobs = [], [], []\n   158\t        self.snapshots, self.snapshot_problems, self.snapshot_checks = [], [], 0\n   159\t        self.day_windows, self.terminal = {}, None\n   160\t        self.lock = threading.Lock()\n   161\t\n   162\t    def transport(self, *args):\n   163\t        request = args[-1]\n   164\t        if len(args) == 1:\n   165\t            if july_test.is_link_request(request) and self.kind == 'linked':\n   166\t                sha = model.request_identity(request)[1]\n   167\t                if sha not in self.probe:\n   168\t                    raise july_test.Stop(f'a link job outside probe draw {self.draw} ({sha[:12]}): not sent')\n   169\t                self.link_jobs.append(sha)\n   170\t                return self.probe[sha]\n   171\t            raise july_test.Stop('a Jev request missed the archive: not sent')\n   172\t        sha = model.request_identity(request)[1]\n   173\t        view_id = july_test.judged_view(request) if is_judgement_request(request) else None\n   174\t        if view_id is not None and view_id not in self.reader_days:\n   175\t            response = self.stored_refusals.pop(sha, None)\n   176\t            if response is not None:\n   177\t                self.refusals_given.append(sha[:12])\n   178\t                return response\n   179\t        day = self.day\n   180\t        allowed = view_id in self.reader_days and day is not None and day >= self.reader_days[view_id]\n   181\t        text = request['messages'][-1]['content']\n   182\t        with self.lock:\n   183\t            self.attempts.append({'view': view_id, 'day': day, 'sha': sha, 'retry': 'Correct it and answer again' in text, 'admitted': allowed})\n   184\t        if allowed:\n   185\t            self.check_snapshot(view_id, day, text)\n   186\t        return self.latch.run(allowed, f'unapproved request on {day} (thesis {view_id}): not sent', (view_id, day),\n   187\t                              lambda: self.inner(*args))\n   188\t\n   189\t    def build_prompt(self, original):\n   190\t        def wrapped(conn, view_id, prompt_version):\n   258\tdef prepare(folder, kind, draw):\n   259\t    if folder.exists():\n   260\t        raise SystemExit(f'{folder} exists: a sequence starts from an empty folder and is never resumed')\n   261\t    folder.mkdir(parents=True)\n   262\t    shutil.copyfile(OLD2 / 'archive.sqlite', folder / 'archive.sqlite')\n   263\t    archive = model.Archive(str(folder / 'archive.sqlite'))\n   264\t    top = archive.conn.execute('select coalesce(max(call_id), 0) from model_calls').fetchone()[0]\n   265\t    retired = []\n   266\t    if kind == 'control':\n   267\t        for reader, calls in retired_rows(readers(draw)).items():\n   268\t            for call_id in calls:\n   269\t                archive.retire(call_id)\n   270\t                retired.append((reader, call_id))\n   271\t    views = folder / 'views.sqlite'\n   272\t    marker = sqlite3.connect(views)\n   273\t    marker.execute('create table harness_only (name text, day text)')\n   274\t    marker.execute(\"insert into harness_only values ('paid_run.py', '2026-11-21')\")\n   275\t    marker.commit()\n   276\t    marker.close()\n   277\t    return archive, top, retired\n   278\t\n   279\t\n   280\tdef trajectory_check(views, reader_set):\nscripts/preflight.py:13:It replays the answers of the versions the code builds (extraction v74i, judging-v7); a row of a retired version, or one whose\nscripts/preflight.py:35:SCHEMAS = {'extract': extraction.schema_for(extraction.SUPPORTED_VERSIONS[0]), 'match': matching.SCHEMA, 'judge': judging.schema_for(judging.SUPPORTED_VERSIONS[0])}\ntests/test_links.py:319:    user8 = judging.build_prompt(conn, 'v2', 'judging-v8')[1]\ntests/test_links.py:330:    user7 = judging.build_prompt(conn, 'v2', 'judging-v7')[1]\ntests/test_links.py:332:    assert judging.build_prompt(conn, 'v1', 'judging-v7') == judging.build_prompt(conn, 'v1', 'judging-v8')     # no link: byte-equal\ntests/test_links.py:365:    assert V119.matching.engine == links.ENGINE and V119.rejudging.prompt_version == 'judging-v8'\nsrc/hivemind/views/jev_matching.py:48:    prompt_chars: int\nsrc/hivemind/views/jev_matching.py:254:        total.prompt_chars += answer.prompt_chars\ntests/test_supported_versions.py:1:\"\"\"D359: the code builds only the frozen production prompts, extraction v74i (D274) and judging-v7 (D354); a configuration that names\nsrc/hivemind/views/judging.py:6:The request is judging-v7 (D354, frozen with steps 3 and 4): no other version is built, and a configuration that names another is\nsrc/hivemind/views/judging.py:28:SUPPORTED_VERSIONS = ('judging-v7', 'judging-v8')   # D354: the frozen judging prompt; D694: v8 = v7's text with the fuller dependency block\nsrc/hivemind/views/judging.py:29:FULL_DEPENDENCY_BLOCK = ('judging-v8',)\nsrc/hivemind/views/judging.py:128:    \"\"\"judging-v8 (D694, design §3): the read judgement's comparison point and the system's forecast in full, labelled as ours, beside\nsrc/hivemind/views/judging.py:139:    \"\"\"hidden: how many pieces in force are not shown. full_dependencies: the judging-v8 dependency block.\"\"\"\nscripts/replay.py:10:collision judge collision-v2; judging-v7; a statement unde