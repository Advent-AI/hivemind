ompt_chars=prompt_chars, input_tokens=input_tokens, output_tokens=output_tokens, cost_usd=cost,\nsrc/hivemind/jev.py:112:    return model.Answer(answers, call_id, sha, False, prompt_chars, input_tokens, output_tokens, cost)\ntests/test_theme_block.py:64:    _, before = judging.build_prompt(conn, 'v1', 'judging-v7')\ntests/test_theme_block.py:67:    _, user = judging.build_prompt(conn, 'v1', 'judging-v7')\ntests/test_theme_block.py:74:    _, user = judging.build_prompt(conn, 'v1', 'judging-v7')\ntests/test_theme_block.py:76:    _, theme_user = judging.build_prompt(conn, 'v2', 'judging-v7')\ntests/test_theme_block.py:79:    _, user = judging.build_prompt(conn, 'v1', 'judging-v7')\ntests/test_theme_block.py:86:    schema = judging.schema_for('judging-v7')\ntests/test_theme_block.py:89:    assert judging.check_answer(conn, 'v1', dict(base, theme_pushes=[{'view_id': 'v2', 'push': 'toward_last'}])) == []\ntests/test_theme_block.py:90:    assert judging.check_answer(conn, 'v1', dict(base, theme_pushes=[{'view_id': 'v9', 'push': 'none'}])) == ['v9 is not a theme in force shown to v1']\ntests/test_theme_block.py:91:    assert judging.check_answer(conn, 'v1', dict(base, theme_pushes=[{'view_id': 'v2', 'push': 'none'}, {'view_id': 'v2', 'push': 'toward_last'}])) == ['v2 is named twice in theme_pushes']\ntests/test_theme_block.py:92:    assert judging.check_answer(conn, 'v2', dict(base, rung=1, theme_pushes=[{'view_id': 'v2', 'push': 'none'}])) == ['v2 is not a theme in force shown to v2']\ntests/test_theme_block.py:155:    _, request_text = judging.build_prompt(conn, 'v1', 'judging-v7')\ntests/test_theme_block.py:159:    assert judging.check_answer(conn, 'v1', dict(base, theme_pushes=[{'view_id': 'v2', 'push': 'none'}]), request_text) == []\ntests/test_theme_block.py:160:    assert judging.check_answer(conn, 'v1', dict(base, theme_pushes=[{'view_id': 'v2', 'push': 'none'}])) == ['v2 is not a theme in force shown to v1']\ntests/test_theme_block.py:164:    assert judging.check_answer(conn, 'v1', dict(base, theme_pushes=[{'view_id': 'v9', 'push': 'none'}]), request_text) == ['v9 is not a theme in force shown to v1']\ntests/test_theme_block.py:209:    _, request_text = judging.build_prompt(conn, 'v1', 'judging-v7')\ntests/test_evidence_in_view.py:72:    _, request_text = judging.build_prompt(conn, 'v1', 'judging-v7')\ntests/test_evidence_in_view.py:76:    assert judging.check_answer(conn, 'v1', dict(ANSWER, cites=['e1'], pushes=[{'evidence_id': 'e1', 'push': 'none'}]), request_text) == []\ntests/test_evidence_in_view.py:77:    assert judging.check_answer(conn, 'v1', dict(ANSWER, cites=['e3']), request_text) == ['e3 is not among the evidence shown to v1']\ntests/test_evidence_in_view.py:78:    assert judging.check_answer(conn, 'v1', dict(ANSWER, pushes=[{'evidence_id': 'e3', 'push': 'none'}]), request_text) == ['push on e3 which was not shown to v1']\ntests/test_evidence_in_view.py:79:    assert judging.check_answer(conn, 'v1', dict(ANSWER, cites=['e3'])) == ['e3 is not among the evidence shown to v1']   # computed from the ledger when the text is not given\n","exit_code":0,"status":"completed"}}
