r--r--@   1 lchingen  staff     552 Nov 21 13:14 round34-brief.md\n-rw-r--r--@   1 lchingen  staff     608 Nov 21 13:17 round35-brief.md\n-rw-r--r--@   1 lchingen  staff     499 Nov 21 13:20 round36-brief.md\n-rw-r--r--@   1 lchingen  staff    5799 Nov 21 16:00 round37-brief.md\n-rw-r--r--@   1 lchingen  staff    5145 Nov 21 16:44 round37b-brief.md\n-rw-r--r--@   1 lchingen  staff    1469 Nov 21 09:47 scorer-checks.log\n-rw-r--r--@   1 lchingen  staff    2897 Nov 21 11:10 v120-replay-1.log\n-rw-r--r--@   1 lchingen  staff    2897 Nov 21 11:17 v120-replay-2.log\n-rw-r--r--@   1 lchingen  staff    2897 Nov 21 11:23 v120-replay-3.log\n-rw-r--r--@   1 lchingen  staff     897 Nov 21 12:32 verdict-checks.log\n-rw-r--r--@   1 lchingen  staff   30907 Nov 21 13:20 verdict.py\n-rw-r--r--@   1 lchingen  staff   26965 Nov 21 11:26 window_test.py\n-rw-r--r--@   1 lchingen  staff     254 Nov 21 12:09 worksheet-dry.log\n-rw-r--r--@   1 lchingen  staff    1545 Nov 21 12:32 worksheet-verdict-dry.log\n-rw-r--r--@   1 lchingen  staff   15512 Nov 21 13:20 worksheet.py\n","exit_code":0,"status":"completed"}}
