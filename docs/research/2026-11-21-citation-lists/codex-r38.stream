ch/2026-11-21-whole-window/codex-r37.stream\ndocs/research/2026-11-21-whole-window/codex-r29.stream\ndocs/research/2026-11-21-whole-window/expected-links.md\ndocs/research/2026-11-21-whole-window/WORDING-V2.md\ndocs/research/2026-11-21-whole-window/preflight-window.log\ndocs/research/2026-11-21-whole-window/contradictions.py\ndocs/research/2026-11-21-whole-window/claude-r20.md\ndocs/research/2026-11-21-whole-window/codex-r21.md\ndocs/research/2026-11-21-whole-window/neither-census.json\ndocs/research/2026-11-21-whole-window/PILOT-RESULT.md\ndocs/research/2026-11-21-whole-window/codex-r13.stream\ndocs/research/2026-11-21-whole-window/price.log\ndocs/research/2026-11-21-whole-window/codex-r35.md\ndocs/research/2026-11-21-whole-window/pinned-plan.json\ndocs/research/2026-11-21-whole-window/PAID-DESIGN.md\ndocs/research/2026-11-21-whole-window/codex-r31.md\ndocs/research/2026-11-21-whole-window/codex-r15.md\ndocs/research/2026-11-21-whole-window/round20-brief.md\ndocs/research/2026-11-21-whole-window/round21-brief.md\ndocs/research/2026-11-21-whole-window/codex-r37b.md\ndocs/research/2026-11-21-whole-window/paid-dry-refused-upstream.log\ndocs/research/2026-11-21-whole-window/mutants.log\ndocs/research/2026-11-21-whole-window/verdict.py\ndocs/research/2026-11-21-whole-window/paid_run.py\ndocs/research/2026-11-21-whole-window/round34-brief.md\ndocs/research/2026-11-21-whole-window/round35-brief.md\ndocs/research/2026-11-21-whole-window/window_test.py\ndocs/research/2026-11-21-whole-window/codex-r28.md\ndocs/research/2026-11-21-whole-window/codex-r34.stream\ndocs/research/2026-11-21-whole-window/codex-r26.stream\ndocs/research/2026-11-21-whole-window/verdict-checks.log\ndocs/research/2026-11-21-whole-window/paid-refused-reservation.log\ndocs/research/2026-11-21-whole-window/codex-r18.md\ndocs/research/2026-11-21-whole-window/paid-double-refusal-control.log\ndocs/research/2026-11-21-whole-window/codex-r24.stream\ndocs/research/2026-11-21-whole-window/codex-r28.stream\ndocs/research/2026-11-21-whole-window/codex-r36.stream\ndocs/research/2026-11-21-whole-window/paid-dry-linked-2.log\ndocs/research/2026-11-21-whole-window/paid-dry-linked-3.log\ndocs/research/2026-11-21-whole-window/round23-brief.md\ndocs/research/2026-11-21-whole-window/read_census.py\ndocs/research/2026-11-21-whole-window/round22-brief.md\ndocs/research/2026-11-21-whole-window/codex-r19.md\ndocs/research/2026-11-21-whole-window/round17-brief.md\ndocs/research/2026-11-21-whole-window/round16-brief.md\ndocs/research/2026-11-21-whole-window/round37b-brief.md\ndocs/research/2026-11-21-whole-window/paid-dry-linked-1.log\ndocs/research/2026-11-21-whole-window/DESIGN.md\ndocs/research/2026-11-21-whole-window/round29-brief.md\ndocs/research/2026-11-21-whole-window/round28-brief.md\ndocs/research/2026-11-21-whole-window/neither.log\ndocs/research/2026-11-21-whole-window/codex-r29.md\ndocs/research/2026-11-21-whole-window/PAID-BUILD.md\ndocs/research/2026-11-21-whole-window/paid-mutant-2.log\ndocs/research/2026-11-21-whole-window/codex-r16.stream\ndocs/research/2026-11-21-whole-window/codex-r32.md\ndocs/research/2026-11-21-whole-window/codex-r16.md\ndocs/research/2026-11-21-whole-window/claude-r17.md\ndocs/research/2026-11-21-whole-window/codex-r22.md\ndocs/research/2026-11-21-whole-window/codex-r32.stream\ndocs/research/2026-11-21-whole-window/round24-brief.md\ndocs/research/2026-11-21-whole-window/round25-brief.md\ndocs/research/2026-11-21-whole-window/paid-mutant-3.log\ndocs/research/2026-11-21-whole-window/codex-r20.stream\ndocs/research/2026-11-21-whole-window/paid-mutant-1.log\ndocs/research/2026-11-21-whole-window/parser-validation.txt\ndocs/research/2026-11-21-whole-window/claude-r37.md\ndocs/research/2026-11-21-whole-window/codex-r36.md\ndocs/research/2026-11-21-whole-window/codex-r26.md\ndocs/research/2026-11-21-whole-window/CENSUS-RESULT.md\ndocs/research/2026-11-21-whole-window/claude-r13.md\ndocs/research/2026-11-21-whole-window/probe-v2-pairs.md\ndocs/research/2026-11-21-whole-window/census-dry.log\ndocs/research/2026-11-21-whole-window/paid-mutant-4.log\ndocs/research/2026-11-21-whole-window/expected-links.json\ndocs/research/2026-11-21-whole-window/v120-replay-3.log\ndocs/research/2026-11-21-whole-window/census-reuse-dry.log\ndocs/research/2026-11-21-whole-window/codex-r37.md\ndocs/research/2026-11-21-whole-window/codex-r27.md\ndocs/research/2026-11-21-whole-window/codex-r37b.stream\ndocs/research/2026-11-21-whole-window/round33-brief.md\ndocs/research/2026-11-21-whole-window/round32-brief.md\ndocs/research/2026-11-21-whole-window/codex-r13.md\ndocs/research/2026-11-21-whole-window/v120-replay-2.log\ndocs/research/2026-11-21-whole-window/worksheet.py\ndocs/research/2026-11-21-whole-window/paid-mutant-5.log\ndocs/research/2026-11-21-whole-window/paid-dry-control-1.log\ndocs/research/2026-11-21-whole-window/paid-dry-control-3.log\ndocs/research/2026-11-21-whole-window/paid-mutant-7.log\ndocs/research/2026-11-21-whole-window/expected-links-v2.json\ndocs/research/2026-11-21-whole-window/codex-r18.stream\ndocs/research/2026-11-21-whole-window/paid-units.log\ndocs/research/2026-11-21-whole-window/codex-r33.md\ndocs/research/2026-11-21-whole-window/codex-r14.stream\ndocs/research/2026-11-21-whole-window/codex-r17.md\ndocs/research/2026-11-21-whole-window/codex-r22.stream\ndocs/research/2026-11-21-whole-window/codex-r23.md\ndocs/research/2026-11-21-whole-window/v120-replay-1.log\ndocs/research/2026-11-21-whole-window/codex-r30.stream\ndocs/research/2026-11-21-whole-window/h3-load.log\ndocs/research/2026-11-21-whole-window/paid-mutant-6.log\ndocs/research/2026-11-21-whole-window/paid-dry-control-2.log\ndocs/research/2026-11-21-whole-window/round14-brief.md\ndocs/research/2026-11-21-whole-window/round15-brief.md\ndocs/research/2026-11-21-whole-window/scorer-checks.log\ndocs/research/2026-11-21-whole-window/codex-r34.md\ndocs/research/2026-11-21-whole-window/codex-r24.md\ndocs/research/2026-11-21-whole-window/codex-r35.stream\ndocs/re