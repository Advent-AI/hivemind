{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba scripts/preflight.py | sed -n '29,74p;166,300p'; rg -n 'def |neither|replay' docs/research/2026-11-21-whole-window/{window_test,paid_run}.py docs/research/2026-11-20-production-readiness/dependency-design/{july_test,rebuild_control}.py scripts/replay.py clean-arch/e2e-comparison-2026-11-13/budget_replay.py\"","aggregated_output":"    29\t\n    30\tROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))\n    31\tsys.path.insert(0, os.path.join(ROOT, 'src'))\n    32\tfrom hivemind import config, extraction, live_lock, model, testdb, universe, vocabulary  # noqa: E402\n    33\tfrom hivemind.views import judging, matching  # noqa: E402\n    34\t\n    35\tSCHEMAS = {'extract': extraction.schema_for(extraction.SUPPORTED_VERSIONS[0]), 'match': matching.SCHEMA, 'judge': judging.schema_for(judging.SUPPORTED_VERSIONS[0])}\n    36\t# the stored requests of both prompt languages (D163): Chinese headers up to extraction v5 / matching-v1, English from v6 / matching-v2\n    37\tITEM_ID = re.compile(r'【信息】编号 (\\S+?)，类别 |\\[Item\\] id (\\S+?), category ')\n    38\tMATCH_SHOWN = re.compile(r'^· (v\\d+)\\s?[（(]', re.M)\n    39\tJEV_ASKED = re.compile(r'\\b(v\\d+): ')          # a Jev candidate reason names every thesis it was asked about: 'jev: v1: different 0.55; …'\n    40\t\n    41\t\n    42\tdef normalise_reason(text):\n    43\t    text = re.sub(r\"'[^']*'\", \"'…'\", text)\n    44\t    text = re.sub(r'\\[\\d+\\]', '[]', text)\n    45\t    text = re.sub(r'\\b[ev]\\d+\\b|\\bc\\d+\\b', '#', text)\n    46\t    text = re.sub(r'\\d{4}-\\d{2}-\\d{2}', 'DATE', text)\n    47\t    return text[:90]\n    48\t\n    49\t\n    50\tdef tally(title, judged, refused, reasons, examples):\n    51\t    share = f'{refused / judged:.0%}' if judged else 'n/a'\n    52\t    print(f'\\n== {title}: judged {judged}, refused/dropped {refused} ({share})')\n    53\t    for reason, count in reasons.most_common(20):\n    54\t        print(f'   {count:5d}  {reason}')\n    55\t        for example in examples.get(reason, [])[:2]:\n    56\t            print(f'          e.g. {example}')\n    57\t\n    58\t\n    59\tdef part_a(archive_conn):\n    60\t    reasons, examples, judged = collections.Counter(), collections.defaultdict(list), 0\n    61\t    rows = archive_conn.execute(\"select purpose, request_sha256, answer_json from model_calls where request_sha256 like '%:schema:%' or request_sha256 like '%:malformed:%' or request_sha256 like '%:refused:%'\")\n    62\t    for purpose, sha, answer_json in (tuple(r) for r in rows):\n    63\t        judged += 1\n    64\t        if ':malformed:' in sha or not answer_json:\n    65\t            reasons[f'{purpose}: not JSON'] += 1\n    66\t            continue\n    67\t        for error in model.check_schema(json.loads(answer_json), SCHEMAS.get(purpose, {})):\n    68\t            key = f'{purpose}: {normalise_reason(error)}'\n    69\t            reasons[key] += 1\n    70\t            examples[key].append(error[:140])\n    71\t    tally('A. answers the schema refused (prompt/schema disagreements; empty when the provider enforces the schema server-side)', judged, judged, reasons, examples)\n    72\t    return judged\n    73\t\n    74\t\n   166\t        raise ValueError('source or archived configuration cannot be verified for all extraction calls')\n   167\t    return judged\n   168\t\n   169\t\n   170\tdef shown_for_record(archive_conn, rec, decisions):\n   171\t    \"\"\"The theses a stored matching record was shown, or None when the record cannot be identified: a generative record by its\n   172\t    archived request; a Jev record (its request hash combines several calls) by the theses its candidate reasons name.\"\"\"\n   173\t    request_row = archive_conn.execute('select request_json from model_calls where request_sha256=?', (rec['request_sha256'],)).fetchone()\n   174\t    if request_row:\n   175\t        user = json.loads(request_row['request_json'])['messages'][1]['content']\n   176\t        return [{'view_id': v} for v in dict.fromkeys(MATCH_SHOWN.findall(user))]\n   177\t    reasons = [x.get('reason', '') for x in decisions.get('candidates', []) + decisions.get('evidence', [])]\n   178\t    if reasons and all(r.startswith('jev:') for r in reasons):\n   179\t        return [{'view_id': v} for v in dict.fromkeys(JEV_ASKED.findall(' '.join(x.get('reason', '') for x in decisions.get('candidates', []))))]\n   180\t    return None\n   181\t\n   182\t\n   183\tdef locked_copy(path, scratch):\n   184\t    \"\"\"A store copied for preflight (live-service/OPERATING-CONTRACT.md, row 7): its writer lock taken without waiting, so a store being\n   185\t    written is refused with the snapshot route named; the path checked on both sides of the open and after the copy; the copy made by\n   186\t    SQLite's backup API from a read-only source and taken out of WAL mode; the lock released.\"\"\"\n   187\t    held = live_lock.acquire(path)\n   188\t    try:\n   189\t        source = sqlite3.connect(f'file:{held.real_path}?mode=ro', uri=True)\n   190\t        try:\n   191\t            live_lock.verify(held)\n   192\t            target = sqlite3.connect(scratch)\n   193\t            try:\n   194\t                source.backup(target)\n   195\t                live_lock.leave_wal_mode(target)\n   196\t            finally:\n   197\t                target.close()\n   198\t        finally:\n   199\t            source.close()\n   200\t        live_lock.verify(held)\n   201\t    except BaseException:\n   202\t        for leftover in (scratch, scratch + '-journal', scratch + '-wal', scratch + '-shm'):\n   203\t            if os.path.exists(leftover):\n   204\t                os.remove(leftover)                  # what was copied from a path that changed is discarded\n   205\t        raise\n   206\t    finally:\n   207\t        live_lock.release(held)\n   208\t\n   209\t\n   210\tdef store_copies(views_paths):\n   211\t    \"\"\"One locked copy of each store (`locked_copy`), made before any part reads it; parts C and E read these, never the stores.\"\"\"\n   212\t    copies = []\n   213\t    for path in views_paths:\n   214\t        copy = os.path.join(tempfile.mkdtemp(), 'views.sqlite')\n   215\t        locked_copy(path, copy)\n   216\t        copies.append(copy)\n   217\t    return copies\n   218\t\n   219\t\n   220\tdef part_c(archive_conn, views_paths, uni):\n   221\t    reasons, examples = collections.Counter(), collections.defaultdict(list)\n   222\t    judged = refused_records = 0\n   223\t    per_ledger = []\n   224\t    for path in views_paths:\n   225\t        ledger_judged, skipped = 0, collections.Counter()\n   226\t        # matching.check writes suggested themes to the review pool, so it runs on a scratch copy, never on the real file\n   227\t        scratch = os.path.join(tempfile.mkdtemp(), 'views.sqlite')\n   228\t        shutil.copy(path, scratch)                  # `path` is already preflight's own locked copy (`store_copies`), never a live store\n   229\t        conn = sqlite3.connect(scratch)\n   230\t        conn.row_factory = sqlite3.Row\n   231\t        for rec in conn.execute('select input_id, call_no, shown_json, decisions_json, request_sha256 from match_records order by id'):\n   232\t            handover_row = conn.execute('select handover_json from handovers where input_id=? order by id desc limit 1', (rec['input_id'],)).fetchone()\n   233\t            if not handover_row or not rec['decisions_json']:\n   234\t                skipped['no handover or no decision'] += 1\n   235\t                continue\n   236\t            shown_views = shown_for_record(archive_conn, rec, json.loads(rec['decisions_json']))\n   237\t            if shown_views is None:\n   238\t                skipped['request not in this archive'] += 1\n   239\t                continue\n   240\t            handover = json.loads(handover_row['handover_json'])\n   241\t            shown = json.loads(rec['shown_json'])\n   242\t            lists = matching.Lists(shown.get('candidates', {}), {tuple(k.split('|', 1)): v for k, v in shown.get('evidence', {}).items()})\n   243\t            if rec['call_no'] <= 2:\n   244\t                candidates, evidence = handover['candidates'], handover['evidence']\n   245\t            else:                                   # the second call: candidate-linked evidence under its destination\n   246\t                wanted = {k[0] for k in lists.evidence_lists}\n   247\t                candidates, evidence = [], [dict(e, links=[k[1] for k in lists.evidence_lists if k[0] == e['id']]) for e in handover['evidence'] if e['id'] in wanted]\n   248\t            try:\n   249\t                checked = matching.check(conn, uni, json.loads(rec['decisions_json']), candidates, evidence, lists, shown_views)\n   250\t            except Exception as error:\n   251\t                key = 'check raised ' + type(error).__name__\n   252\t                reasons[key] += 1; examples[key].append(f'{os.path.basename(os.path.dirname(path))} {rec[\"input_id\"][:40]}: {error!r}'[:140])\n   253\t                judged += 1; refused_records += 1; ledger_judged += 1\n   254\t                continue\n   255\t            judged += 1\n   256\t            ledger_judged += 1\n   257\t            if checked.refusals:\n   258\t                refused_records += 1\n   259\t            for refusal in checked.refusals:\n   260\t                key = normalise_reason(refusal)\n   261\t                reasons[key] += 1\n   262\t                examples[key].append(f'{os.path.basename(os.path.dirname(path))} {rec[\"input_id\"][:40]}: {refusal[:90]}')\n   263\t        per_ledger.append((os.path.basename(os.path.dirname(path)) or path, ledger_judged, skipped))\n   264\t    tally('C. matching code checks over stored records (database state is the final one, not the state at the time)', judged, refused_records, reasons, examples)\n   265\t    unjudged = []\n   266\t    for name, ledger_judged, skipped in per_ledger:\n   267\t        print(f'       ledger {name}: judged {ledger_judged}, skipped {sum(skipped.values())} {dict(skipped) if skipped else \"\"}')\n   268\t        if skipped and not ledger_judged:\n   269\t            unjudged.append(name)\n   270\t    if unjudged:\n   271\t        print(f'NOT JUDGED: every matching record of {unjudged} was skipped; pass the archive these records were written with')\n   272\t        return 0\n   273\t    return judged\n   274\t\n   275\t\n   276\tdef part_d():\n   277\t    \"\"\"Every schema enum value appears in the prompt that asks for it: the extraction role and the judging prompt of the versions the\n   278\t    code builds, and every matching prompt against its own version's set (Chinese up to matching-v1, English after).\"\"\"\n   279\t    missing = []\n   280\t    checks = [(f'role-{v}.txt', extraction.TIERS + vocabulary.KINDS + vocabulary.ASSET_LABELS) for v in extraction.SUPPORTED_VERSIONS]\n   281\t    checks += [(f'{v}.txt', judging.PUSHES) for v in judging.SUPPORTED_VERSIONS]\n   282\t    for path in sorted(glob.glob(os.path.join(config.PROMPTS, 'matching-v*.txt'))):\n   283\t        version = os.path.basename(path).removesuffix('.txt')\n   284\t        checks.append((os.path.basename(path), (matching.OUTCOMES + matching.EVIDENCE_OUTCOMES + vocabulary.DIRECTIONS) if matching.is_english(version)\n   285\t                       else (matching.LEGACY_OUTCOMES + matching.LEGACY_EVIDENCE_OUTCOMES)))\n   286\t    judged = 0\n   287\t    for name, values in checks:\n   288\t        text = open(os.path.join(config.PROMPTS, name), encoding='utf-8').read()\n   289\t        for value in values:\n   290\t            judged += 1\n   291\t            if value not in text:\n   292\t                missing.append(f'{name} lacks the enum value {value!r}')\n   293\t    print(f'\\n== D. schema enum values named in the prompts: judged {judged}, missing {len(missi