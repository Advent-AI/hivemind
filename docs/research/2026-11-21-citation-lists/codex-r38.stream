te(\\\"select call_id,request_sha256,request_json,answer_json,response_json from model_calls where purpose='\\\\''judge'\\\\'' and call_id>? order by call_id\\\",(lower,)):\n  q=json.loads(req); u=q['\\\\''messages'\\\\''][-1]['\\\\''content'\\\\'']\n  textkeys[tuple(m['\\\\''content'\\\\''] for m in q['\\\\''messages'\\\\''])].append((cid,sha))\n  counts['\\\\''total'\\\\'']+=1\n  if label=='\\\\''old-2'\\\\'': counts['\\\\''complete baseline keys'\\\\'']+=int(model.request_identity(q)[1] == sha.split('\\\\'':'\\\\'')[0])\n  vid=u.split()[1]\n  e=judging.evidence_shown_in(u); t=judging.themes_shown_in(u)\n  dep=set(re.findall(r'\\\\''\"'^- (v'\"\\\\d+) \\\\('\\\\'',u.split(dhead,1)[1].split('\\\\''\\\\n\\\\n['\\\\'',1)[0],re.M)) if dhead in u else set()\n  for name,pat,ids in [('\\\\''e'\\\\'',ehead,e),('\\\\''t'\\\\'',thead,t)]:\n   match=pat.search(u)\n   if match and len(ids)\"'!=int(match[1]):\n    counts['\"'\\\\''header count mismatch '\\\\''+name]+=1\n    examples.setdefault('\\\\''header '\\\\''+name,(cid,match[1],len(ids)))\n  if dhead in u: counts['\\\\''dependency block'\\\\'']+=1\n  if deps.get(vid,set())\"'!=dep:\n   counts['\"'\\\\''diff vs final store'\\\\'']+=1\n   examples.setdefault('\\\\''final'\\\\'',(cid,vid,sorted(deps.get(vid,set())),sorted(dep)))\n  if not e: counts['\\\\''empty e'\\\\'']+=1\n  if not t: counts['\\\\''empty t'\\\\'']+=1\n  candidate=(2*len(e)+len(t)+len(dep)+6,cid)\n  if '\\\\''value count'\\\\'' not in maxima or candidate>maxima['\\\\''value count'\\\\'']: maxima['\\\\''value count'\\\\'']=candidate\n  candidate=(max(sum(map(len,e)),sum(map(len,t)),sum(map(len,dep))),cid)\n  if '\\\\''enum chars'\\\\'' not in maxima or candidate>maxima['\\\\''enum chars'\\\\'']: maxima['\\\\''enum chars'\\\\'']=candidate\n  status=sha.split('\\\\'':'\\\\'')[1] if '\\\\'':'\\\\'' in sha else '\\\\''plain'\\\\''\n  counts[status]+=1\n  data=json.loads(ans) if ans else {}\n  allowed={'\\\\''cites'\\\\'':e,'\\\\''pushes'\\\\'':e,'\\\\''cites_views'\\\\'':dep,'\\\\''theme_pushes'\\\\'':t}\n  bad=[]\n  for field, ids in allowed.items():\n   for i,x in enumerate(data.get(field,[])):\n    x=x if isinstance(x,str) else x.get('\\\\''view_id'\\\\'', x.get('\\\\''evidence_id'\\\\''))\n    if x not in ids: bad.append((field,i,x))\n  if bad or status\"'!='\"'\\\\''plain'\\\\'': print(label,cid, status,vid,'\\\\''retry'\\\\'' if '\\\\''\\\\n\\\\nThe code returned'\\\\'' in u else '\\\\''first'\\\\'',bad)\n  raw_committed=v.execute('\\\\''select count(*) from judgements where call_id=? and request_sha256=?'\\\\'',(cid,sha)).fetchone()[0]\n  if raw_committed: counts['\\\\''committed archive rows'\\\\'']+=1\n  if label=='\\\\''old-2'\\\\'' and status=='\\\\''plain'\\\\'' and not raw_committed: print('\\\\''old-2 extra'\\\\'',cid,vid)\n  if '\\\\''\\\\n\\\\nThe code returned'\\\\'' in u and label=='\\\\''old-2'\\\\'': print('\\\\''old-2 retry'\\\\'',cid,vid,u.rsplit('\\\\''\\\\n\\\\nThe code returned'\\\\'',1)[-1].splitlines()[0])\n print(label,'\\\\''ledger judgements'\\\\'',v.execute('\\\\''select count(*) from judgements'\\\\'').fetchone()[0], dict(counts),maxima,examples,'\\\\''text collisions'\\\\'',[lst for lst in textkeys.values() if len(lst)>1][:12])\n'\"","aggregated_output":"old-2 archive top 8737\nmaxItems production probe: []\nold-1 8326 refused v5 first [('cites', 16, 'v6'), ('cites', 17, 'v7'), ('cites', 18, 'v9')]\nold-1 ledger judgements 1609 {'total': 1610, 'empty t': 138, 'plain': 1609, 'committed archive rows': 1609, 'refused': 1} {'value count': (915, 5652), 'enum chars': (2237, 5652)} {} text collisions []\nold-2 591 refused v7 first [('cites', 8, 'e88')]\nold-2 retry 596 v7  the previous answer because: e88 is not among the evidence shown to v7\nold-2 6955 refused v34 first [('pushes', 18, 'e3955')]\nold-2 retry 6979 v34  the previous answer because: push on e3955 which was not shown to v34\nold-2 7068 refused v35 first [('cites', 9, 'v10'), ('cites', 10, 'v5'), ('cites', 11, 'v6')]\nold-2 retry 7073 v35  the previous answer because: v10 is not among the evidence shown to v35; v5 is not among the evidence shown to v35; v6 is not among the evidence shown to v35\nold-2 7774 refused v35 first [('cites', 2, 'e3998'), ('pushes', 2, 'e3998')]\nold-2 retry 7780 v35  the previous answer because: e3998 is not among the evidence shown to v35; push on e3998 which was not shown to v35\nold-2 ledger judgements 1616 {'total': 1620, 'complete baseline keys': 1620, 'empty t': 149, 'plain': 1616, 'committed archive rows': 1616, 'refused': 4} {'value count': (645, 5471), 'enum chars': (1564, 5471)} {} text collisions []\nold-3 6236 refused v23 first [('cites', 5, 'e1382')]\nold-3 6458 refused v14 first [('cites', 15, 'e2769')]\nold-3 ledger judgements 1707 {'total': 1709, 'empty t': 148, 'plain': 1707, 'committed archive rows': 1707, 'refused': 2} {'value count': (874, 5724), 'enum chars': (2136, 5724)} {} text collisions []\ncontrol-1 8743 refused v7 first [('cites', 8, 'e88')]\ncontrol-1 8807 refused v14 first [('cites', 5, 'e393'), ('pushes', 5, 'e393')]\ncontrol-1 8931 refused v34 first [('pushes', 18, 'e3955')]\ncontrol-1 8936 plain v35 first [('cites', 9, 'v10'), ('cites', 10, 'v5'), ('cites', 11, 'v6')]\ncontrol-1 8938 refused v21 first [('cites', 17, 'e362'), ('pushes', 17, 'e362')]\ncontrol-1 8941 refused v21 retry [('cites', 11, 'e3111'), ('pushes', 11, 'e3111')]\ncontrol-1 ledger judgements 1187 {'total': 204, 'plain': 199, 'committed archive rows': 196, 'refused': 5} {'value count': (637, 8897), 'enum chars': (1540, 8897)} {} text collisions []\nlinked-1 8749 refused v7 first [('cites', 8, 'e88')]\nlinked-1 8777 refused v16 first [('cites', 5, 'e693')]\nlinked-1 8822 refused v16 first [('cites', 15, 'v14')]\nlinked-1 8848 refused v14 first [('cites_views', 1, 'v5'), ('cites_views', 2, 'v6')]\nlinked-1 8855 refused v16 first [('cites', 16, 'v14')]\nlinked-1 8888 refused v9 first [('cites_views', 1, 'v5'), ('cites_views', 2, 'v6')]\nlinked-1 8909 refused v14 first [('cites_views', 1, 'v5'), ('cites_views', 2, 'v6')]\nlinked-1 8967 refused v34 first [('pushes', 18, 'e3955')]\nlinked-1 8972 refused v35 first [('cites', 9, 'v10'), ('cites', 10, 'v5'), ('cites', 11, 'v6')]\nlinked-1 8993 refused v35 first [('cites', 2, 'e3998'), ('pushes', 2, 'e3998')]\nlinked-1 9021 refused v21 first [('cites_views', 1, 'v5'), ('cites_views', 2, 'v6')]\nlinked-1 ledger judgements 1630 {'total': 272, 'dependency block': 268, 'plain': 261, 'committed archive rows': 261, 'refused': 11} {'value count': (628, 8927), 'enum chars': (1522, 8927)} {} text collisions []\n","exit_code":0,"status":"completed"}}
