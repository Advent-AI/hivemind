{"type":"item.completed","item":{"id":"item_19","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba src/hivemind/views/store.py | sed -n '190,295p'; nl -ba src/hivemind/views/round.py | sed -n '57,99p'; nl -ba docs/research/2026-11-20-production-readiness/dependency-design/rebuild_control.py | sed -n '25,85p'; rg -n 'dependencies_of|resolve_wait|rejudging|cfg.checksum' src/hivemind/replay.py src/hivemind/views/writing.py src/hivemind/parallel_day.py src/hivemind/views/round.py; rg -n 'def llm_estimate|prompt_tokens|PRICES' src/hivemind/model.py clean-arch/e2e-comparison-2026-11-13/budget_replay.py\"","aggregated_output":"   190\t        return []\n   191\t    rows = conn.execute('''select k.*, v.object_id from view_keys k join views v on v.view_id=k.view_id\n   192\t                           where v.object_id=? and k.measure=?''', (candidate['object'], candidate['measure']))\n   193\t    return [r['view_id'] for r in rows if automatic_key(dict(r), r['object_id']) == target and is_open(conn, r['view_id'])]\n   194\t\n   195\t\n   196\tdef is_open(conn, view_id):\n   197\t    row = conn.execute('select open from view_switches where view_id=? order by id desc limit 1', (view_id,)).fetchone()\n   198\t    return bool(row and row['open'])\n   199\t\n   200\t\n   201\tdef close_view(conn, view_id, reason, by_whom, seq):\n   202\t    insert(conn, 'view_switches', view_id=view_id, open=0, reason=reason, by_whom=by_whom, after_seq=seq)\n   203\t\n   204\t\n   205\tdef open_views(conn):\n   206\t    rows = conn.execute('select view_id from views').fetchall()\n   207\t    return [r['view_id'] for r in rows if is_open(conn, r['view_id'])]\n   208\t\n   209\t\n   210\tdef views_of_object(conn, object_id, only_open=True):\n   211\t    rows = conn.execute('select view_id from views where object_id=? order by created_seq', (object_id,)).fetchall()\n   212\t    ids = [r['view_id'] for r in rows]\n   213\t    return [v for v in ids if is_open(conn, v)] if only_open else ids\n   214\t\n   215\t\n   216\tdef has_judgement(conn, view_id, seq):\n   217\t    return conn.execute('select 1 from judgements where view_id=? and seq=?', (view_id, seq)).fetchone() is not None\n   218\t\n   219\t\n   220\tREAD_BUSY_TIMEOUT_SECONDS = 5.0     # a reader's busy timeout: SQLite's busy handler retries SQLITE_BUSY within it (live-service row 1)\n   221\t\n   222\t\n   223\tdef open_read_only(path):\n   224\t    \"\"\"The views database for a reader (the agent layer, reports): no schema creation, no writes. Opened by its own path: a symlink\n   225\t    resolved, a store with another hard link refused (`live_lock.LockRefused`; live-service/OPERATING-CONTRACT.md, row 7), since\n   226\t    SQLite finds a WAL store's side files by the opened path.\"\"\"\n   227\t    from hivemind import live_lock\n   228\t    real, _ = live_lock.own_path(path)\n   229\t    conn = sqlite3.connect(f'file:{real}?mode=ro', uri=True, timeout=READ_BUSY_TIMEOUT_SECONDS)\n   230\t    conn.row_factory = sqlite3.Row\n   231\t    return conn\n   232\t\n   233\t\n   234\tdef current_state(conn, view_id):\n   235\t    \"\"\"The latest judgement: rung, reasons, changed, seq and day, and its reference and implied outcome (D260) where the ledger has them.\"\"\"\n   236\t    columns = {r[1] for r in conn.execute('pragma table_info(judgements)')}\n   237\t    stance = ''.join(f', {field}' for field in ('reference', 'implied_outcome') if field in columns)\n   238\t    row = conn.execute(f'select judgement_id, rung, reasons, changed, seq, publication_day{stance} from judgements where view_id=? order by judgement_id desc limit 1', (view_id,)).fetchone()\n   239\t    return dict(row) if row else None\n   240\t\n   241\t\n   242\tdef dependencies_of(conn, view_id):\n   243\t    \"\"\"Each dependency with its current target: the resolved view, or the waiting chain and year.\"\"\"\n   244\t    out = []\n   245\t    for dep in conn.execute('select * from dependencies where view_id=? order by dependency_id', (view_id,)):\n   246\t        dep = dict(dep)\n   247\t        resolution = conn.execute('select resolved_to, reason from dependency_resolutions where dependency_id=? order by id desc limit 1', (dep['dependency_id'],)).fetchone()\n   248\t        if resolution:\n   249\t            dep['resolved_to'], dep['resolution'] = resolution['resolved_to'], resolution['reason']\n   250\t        else:\n   251\t            dep['resolved_to'], dep['resolution'] = dep['depends_on'], ('direct' if dep['depends_on'] else 'waiting')\n   252\t        out.append(dep)\n   253\t    return out\n   254\t\n   255\t\n   256\tdef direct_parents(conn, view_id, seq=None):\n   257\t    \"\"\"The views this view depends on directly (a driver's root, D208; the seeds' depends_on), written at or before `seq` when given.\n   258\t    The filing reads it to keep a statement under the narrower of two linked questions (D207's narrowest rule, extraction.file_reading).\"\"\"\n   259\t    reads = \" and coalesce(kind, '') != 'reads'\" if 'kind' in {r[1] for r in conn.execute('pragma table_info(dependencies)')} else ''\n   260\t    rows = conn.execute(f\"select depends_on from dependencies where view_id=? and depends_on != '' and (? is null or seq <= ?){reads} order by dependency_id\", (view_id, seq, seq))\n   261\t    return list(dict.fromkeys(r[0] for r in rows))\n   262\t\n   263\t\n   264\tdef dependants_of(conn, view_id):\n   265\t    direct = [r['view_id'] for r in conn.execute('select view_id from dependencies where depends_on=?', (view_id,))]\n   266\t    resolved = [r['view_id'] for r in conn.execute(\n   267\t        'select d.view_id from dependency_resolutions r join dependencies d on d.dependency_id=r.dependency_id where r.resolved_to=?', (view_id,))]\n   268\t    return sorted(set(direct + resolved))\n   269\t\n   270\t\n   271\tdef would_cycle(conn, view_id, depends_on):\n   272\t    \"\"\"True when depends_on already depends, directly or through its dependencies, on view_id.\"\"\"\n   273\t    seen, stack = set(), [depends_on]\n   274\t    while stack:\n   275\t        current = stack.pop()\n   276\t        if current == view_id:\n   277\t            return True\n   278\t        if current in seen or not current:\n   279\t            continue\n   280\t        seen.add(current)\n   281\t        for dep in dependencies_of(conn, current):\n   282\t            if dep['resolved_to']:\n   283\t                stack.append(dep['resolved_to'])\n   284\t    return False\n   285\t\n   286\t\n   287\tdef day_start_seq(conn, day):\n   288\t    \"\"\"D251: the sequence number the start of `day` stands at: the seq of the last completed day before it, or 0 before the first\n   289\t    completed day, where the seed questions live (D253: seeds are created at seq 0, before any item).\"\"\"\n   290\t    row = conn.execute('select max(seq) from days_completed where day < ?', (day,)).fetchone()\n   291\t    return row[0] if row is not None and row[0] is not None else 0\n   292\t\n   293\t\n   294\tdef views_open_at_day_start(conn, object_ids, day):\n   295\t    \"\"\"D251: the questions open at the start of `day`, as every item of that day sees them: views created at or before the day's start\n    57\t        if not checked.refusals:\n    58\t            return checked\n    59\t        note = '；'.join(checked.refusals)\n    60\t    _fail(conn, item, seq, result, 'matched', 'matching_refused_twice', 'matching refused twice: ' + note, item['category'])\n    61\t    return None\n    62\t\n    63\t\n    64\tdef changed_views_of_day(conn, day):\n    65\t    \"\"\"The views whose reading changed on a replay day: the union of the 'written' records of that day's items and of the coverage-start reading's\n    66\t    record dated that day (D364: the questions it linked starting figures to are judged in the first day's round).\"\"\"\n    67\t    changed = set()\n    68\t    for row in conn.execute(\"select reason from processing_steps where step in ('written', 'baseline') and result='ok' and publication_day=?\", (day,)):\n    69\t        changed.update(json.loads(row['reason']).get('changed', []))\n    70\t    return changed\n    71\t\n    72\t\n    73\tdef judge_day(conn, archive, cfg, day, seq, *, transport=None, log=print):\n    74\t    \"\"\"D63: one re-judging round per day over every open view whose reading changed that day, dependencies first,\n    75\t    recorded under the day's own processing record (input 'day:<date>'); a view already judged at this sequence\n    76\t    number (a resumed day) is not judged twice.\"\"\"\n    77\t    marker = {'input_id': f'day:{day}', 'publication_day': day}\n    78\t    changed = changed_views_of_day(conn, day)\n    79\t    result = RoundResult(marker['input_id'])\n    80\t    if not changed:\n    81\t        return result\n    82\t    try:\n    83\t        judged = judging.round_of_judgements(archive, cfg, conn, sorted(changed), seq, marker, transport=transport)\n    84\t        result.judged = len(judged)\n    85\t        result.changed = sum(1 for j in judged if j['changed'])\n    86\t        result.cost += sum(j['cost'] for j in judged)\n    87\t        result.cached_calls += sum(1 for j in judged if j['cached'])\n    88\t        dispatch.mark(conn, marker, seq, 'judged', 'ok', f'{len(changed)} views changed, {len(judged)} judged, {result.changed} changed conclusions')\n    89\t        conn.commit()\n    90\t    except judging.JudgementRefused as error:\n    91\t        return _fail(conn, marker, seq, result, 'judged', 'judgement_refused_twice', 'judgement refused twice: ' + str(error), 'day')\n    92\t    except Exception as error:\n    93\t        return _fail(conn, marker, seq, result, 'judged', 'judging_failed', 'judging: ' + repr(error), type(error).__name__)\n    94\t    return result\n    95\t\n    96\t\n    97\tdef run(conn, archive, cfg, universe, item, seq, *, resume_from=None, transport=None, log=print, extractor=None, matching_workers=1):\n    98\t    result = RoundResult(item['input_id'])\n    99\t    if resume_from in ('judged', 'handed_over'):       # written already; judging is the day's step\n    25\tclass SendRefused(RuntimeError):\n    26\t    pass\n    27\t\n    28\t\n    29\tdef refuse(*args, **kwargs):\n    30\t    raise SendRefused('a request was not in the archive: the rebuilt request differs from the stored one')\n    31\t\n    32\t\n    33\tdef rows(conn, sql, args=()):\n    34\t    return [tuple(r) for r in conn.execute(sql, args)]\n    35\t\n    36\t\n    37\tdef compare(rebuilt_path, last_seq):\n    38\t    rebuilt = sqlite3.connect(f'file:{rebuilt_path}?mode=ro', uri=True)\n    39\t    stored = sqlite3.connect(f'file:{OLD2}/views.sqlite?mode=ro', uri=True)\n    40\t    checks = {\n    41\t        'views': ('select view_id, question, created_seq from views where created_seq <= ? order by view_id', (last_seq,)),\n    42\t        'view_keys': ('select view_id, measure, scope, period_start, period_end, unit from view_keys where seq <= ? order by view_id', (last_seq,)),\n    43\t        'evidence': ('select evidence_id, quote, created_seq from evidence where created_seq <= ? order by evidence_id', (last_seq,)),\n    44\t        'evidence_links': ('select evidence_id, view_id, seq from evidence_links where seq <= ? order by evidence_id, view_id', (last_seq,)),\n    45\t        'judgements': ('select view_id, seq, rung, reasons, cited_evidence_json, cited_views_json, changed, reference, implied_outcome, request_sha256 from judgements where seq <= ? order by judgement_id', (last_seq,)),\n    46\t        'rungs': ('select r.view_id, r.position, r.label, r.condition, r.lo, r.hi from rungs r join views v using(view_id) where v.created_seq <= ? order by r.view_id, r.position', (last_seq,)),\n    47\t        'view_switches': ('select view_id, open, reason, after_seq from view_switches where after_seq <= ? order by id', (last_seq,)),\n    48\t        'successions': ('select view_id, succeeds, seq from successions where seq <= ? order by id', (last_seq,)),\n    49\t        'dependencies': ('select view_id, depends_on, seq from dependencies where seq <= ? order by dependency_id', (last_seq,)),\n    50\t    }\n    51\t    ok = True\n    52\t    for name, (sql, args) in checks.items():\n    53\t        a, b = rows(rebuilt, sql, args), rows(stored, sql, args)\n    54\t        same = a == b\n    55\t        ok = ok and same\n    56\t        print(f'{name}: rebuilt {len(a)} stored {len(b)} {\"equal\" if same else \"DIFFER\"}')\n    57\t        if not same:\n    58\t            for x, y in zip(a, b):\n    59\t                if x != y:\n    60\t                    print('  first difference:', str(x)[:200], '|', str(y)[:200])\n    61\t                    break\n    62\t    return ok\n    63\t\n    64\t\n    65\tdef main():\n    66\t    scratch = Path(sys.argv[1])\n    67\t    scratch.mkdir(parents=True, exist_ok=True)\n    68\t    views_path, archive_path = scratch / 'views.sqlite', scratch / 'archive.sqlite'\n    69\t    for path in (views_path, archive_path):\n    70\t        if path.exists():\n    71\t            raise SystemExit(f'{path} exists: a rebuild starts from an empty folder')\n    72\t    shutil.copyfile(OLD2 / 'archive.sqlite', archive_path)\n    73\t    cfg = config.load(str(REPO / 'poc/config/poc-v118.json'))\n    74\t    uni = universe.load(str(REPO / 'poc/universe.json'))\n    75\t    totals = replay.run(testdb_path=str(ITEMS), views_path=str(views_path), archive=model.Archive(str(archive_path)), cfg=cfg,\n    76\t                        universe=uni, from_day='2026-07-01', until_day=UNTIL, transport=refuse, log=print,\n    77\t                        only_objects={'NVDA'})          # the comparison launcher's default (`budget_replay.py --only NVDA`)\n    78\t    print('totals:', totals)\n    79\t    conn = sqlite3.connect(f'file:{views_path}?mode=ro', uri=True)\n    80\t    last_seq = conn.execute('select max(seq) from days_completed where day=?', (UNTIL,)).fetchone()[0]\n    81\t    print('last completed seq at', UNTIL, last_seq)\n    82\t    sys.exit(0 if compare(views_path, last_seq) else 1)\n    83\t\n    84\t\n    85\tif __name__ == '__main__':\nsrc/hivemind/views/writing.py:50:def resolve_waiting(conn, new_view_id, seq, changed):\nsrc/hivemind/views/writing.py:239:        resolve_waiting(conn, view_id, seq, changed)\nsrc/hivemind/model.py:35:PRICES = {'gpt-6-luna': (0.10, 0.50), 'gpt-6.1-sol': (2.00, 10.00), 'gpt-6-astra': (10.00, 50.00), 'claude-opus-5-5': (4.00, 20.00), 'deepseek-flash': (0.30, 1.20), 'deepseek-v4-pro': (1.32, 3.96),\nsrc/hivemind/model.py:274:    input_tokens = int(usage.get('prompt_tokens') or 0)\nsrc/hivemind/model.py:276:    cached_tokens = min(input_tokens, int((usage.get('prompt_tokens_details') or {}).get('cached_tokens') or 0))\nsrc/hivemind/model.py:277:    price_in, price_out = PRICES.get(setting.model, (0.0, 0.0))\nclean-arch/e2e-comparison-2026-11-13/budget_replay.py:8:(`max_completion_tokens`) at `model.PRICES`; a Jev request reserves (2 × its bytes + 4,096) input tokens at Jev's input rate, times\nclean-arch/e2e-comparison-2026-11-13/budget_replay.py:227:def llm_estimate(request):\nclean-arch/e2e-comparison-2026-11-13/budget_replay.py:228:    price_in, price_out = model.PRICES[request['model']]\nclean-arch/e2e-comparison-2026-11-13/budget_replay.py:246:    tokens_in, tokens_out = usage.get('prompt_tokens'), usage.get('completion_tokens')\nclean-arch/e2e-comparison-2026-11-13/budget_replay.py:247:    details = usage.get('prompt_tokens_details') or {}\nclean-arch/e2e-comparison-2026-11-13/budget_replay.py:251:    price_in, price_out = model.PRICES[request['model']]\nclean-arch/e2e-comparison-2026-11-13/budget_replay.py:257:    price_in, _ = model.PRICES[request['model']]\nclean-arch/e2e-comparison-2026-11-13/budget_replay.py:307:            actual = jev.ATTEMPTS * tokens * model.PRICES[request['model']][0] / 1e6\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_20","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"PYTHONDONTWRITEBYTECODE=1 PYTHONPATH=src python3 -c '\nfrom pathlib import Path\nfrom collections import Counter, defaultdict\nfrom hivemind.views import judging\nfrom hivemind import model\nimport sqlite3,json,re\nbase=Path('\\\\''poc/data/comparison-2026-11-17/run'\\\\'')\nscratch=Path('\\\\''/private/tmp/claude-501/-Users-lchingen-hivemind/f1ea972d-85a1-4f27-8010-cf0b60054109/scratchpad'\\\\'')\ndef con(p):\n c=sqlite3.connect(f'\\\\''file:{p.resolve()}?mode=ro&immutable=1'\\\\'',uri=True)\n c.row_factory=sqlite3.Row\n return c\npaths=[(f'\\\\''old-{x}'\\\\'',base/f'\\\\''old-{x}'\\\\''/'\\\\''prod'\\\\'') for x in range(1,4)]+[(x,scratch/f'\\\\''{x}-copy'\\\\'') for x in ('\\\\''control-1'\\\\'','\\\\''linked-1'\\\\'')]\ntop=con(paths[1][1]/'\\\\''archive.sqlite'\\\\'').execute('\\\\''select max(call_id) from model_calls'\\\\'').fetchone()[0]\nprint('\\\\''old-2 archive top'\\\\'',top)\ndhead='\\\\''\\\\n[Current conclusions of the theses it depends on]'\\\\''\nehead=re.compile(r'\\\\''\"'^'\"\\\\[Evidence in view under this thesis, (\\\\d+) items\\\\]\"'$'\"'\\\\'',re.M)\nthead=re.compile(r'\\\\''\"'^'\"\\\\[Themes in force, (\\\\d+)\\\\]\"'$'\"'\\\\'',re.M)\nprint('\\\\''maxItems production probe:'\\\\'',model.check_schema(['\\\\''v1'\\\\''],{'\\\\''type'\\\\'':'\\\\''array'\\\\'','\\\\''items'\\\\'':{'\\\\''type'\\\\'':'\\\\''string'\\\\''},'\\\\''maxItems'\\\\'':0}))\nfor label,p in paths:\n c=con(p/'\\\\''archive.sqlite'\\\\''); v=con(p/'\\\\''views.sqlite'\\\\''); lower=top if label.endswith('\\\\''-1'\\\\'') and label\"'!='\"'\\\\''old-1'\\\\'' else 0\n counts=Counter(); textkeys=defaultdict(list); maxima={}; examples={}\n deps={vid:{d['\\\\''resolved_to'\\\\''] for d in judging.store.dependencies_of(v,vid) if d['\\\\''resolved_to'\\\\'']} for vid, in v.execute('\\\\''select view_id from views'\\\\'')}\n for cid,sha,req,ans,response in c.execute(\\\"select call_id,request_sha256,request_json,answer_json,response_json from model_calls where purpose='\\\\''judge'\\\\'' and call_id>? order by call_id\\\",(lower,)):\n  q=json.loads(req); u=q['\\\\''messages'\\\\''][-1]['\\\\''content'\\\\'']\n  textkeys[tuple(m['\\\\''content'\\\\''] for m in q['\\\\''messages'\\\\''])].append((cid,sha))\n  counts['\\\\''total'\\\\'']+=1\n  if label=='\\\\''old-2'\\\\'': counts['\\\\''complete baseline keys'\\\\'']+=int(model.request_identity(q)[1] == sha.split('\\\\'':'\\\\'')[0])\n  vid=u.split()[1]\n  e=judging.evidence_shown_in(u); t=judging.themes_shown_in(u)\n  dep=set(re.findall(r'\\\\''\"'^- (v'\"\\\\d+) \\\\('\\\\'',u.split(dhead,1)[1].split('\\\\''\\\\n\\\\n['\\\\'',1)[0],re.M)) if dhead in u else set()\n  for name,pat,ids in [('\\\\''e'\\\\'',ehead,e),('\\\\''t'\\\\'',thead,t)]:\n   match=pat.search(u)\n   if match and len(ids)\"'!=int(match[1]):\n    counts['\"'\\\\''header count mismatch '\\\\''+name]+=1\n    examples.setdefault('\\\\''header '\\\\''+name,(cid,match[1],len(ids)))\n  if dhead in u: counts['\\\\''dependency block'\\\\'']+=1\n  if deps.get(vid,set())\"'!=dep:\n   counts['\"'\\\\''diff vs final store'\\\\'']+=1\n   examples.setdefault('\\\\''final'\\\\'',(cid,vid,sorted(deps.get(vid,set())),sorted(dep)))\n  if not e: counts['\\\\''empty e'\\\\'']+=1\n  if not t: counts['\\\\''empty t'\\\\'']+=1\n  candidate=(2*len(e)+len(t)+len(dep)+6,cid)\n  if '\\\\''value count'\\\\'' not in maxima or candidate>maxima['\\\\''value count'\\\\'']: maxima['\\\\''value count'\\\\'']=candidate\n  candidate=(max(sum(map(len,e)),sum(map(len,t)),sum(map(len,dep))),cid)\n  if '\\\\''enum chars'\\\\'' not in maxima or candidate>maxima['\\\\''enum chars'\\\\'']: maxima['\\\\''enum chars'\\\\'']=candidate\n  status=sha.split('\\\\'':'\\\\'')[1] if '\\\\'':'\\\\'' in sha else '\\\\''plain'\\\\''\n  counts[status]+=1\n  data=json.loads(ans) if ans else {}\n  allowed={'\\\\''cites'\\\\'':e,'\\\\''pushes'\\\\'':e,'\\\\''cites_views'\\\\'':dep,'\\\\''theme_pushes'\\\\'':t}\n  bad=[]\n  for field, ids in allowed.items():\n   for i,x in enumerate(data.get(field,[])):\n    x=x if isinstance(x,str) else x.get('\\\\''view_id'\\\\'', x.get('\\\\''evidence_id'\\\\''))\n    if x not in ids: bad.append((field,i,x))\n  if bad or status\"'!='\"'\\\\''plain'\\\\'': print(label,cid, status,vid,'\\\\''retry'\\\\'' if '\\\\''\\\\n\\\\nThe code returned'\\\\'' in u else '\\\\''first'\\\\'',bad)\n  raw_committed=v.execute('\\\\''select count(*) from judgements where call_id=? and request_sha256=?'\\\\'',(cid,sha)).fetchone()[0]\n  if raw_committed: counts['\\\\''committed archive rows'\\\\'']+=1\n  if label=='\\\\''old-2'\\\\'' and status=='\\\\''plain'\\\\'' and not raw_committed: print('\\\\''old-2 extra'\\\\'',cid,vid)\n  if '\\\\''\\\\n\\\\nThe code returned'\\\\'' in u and label=='\\\\''old-2'\\\\'': print('\\\\''old-2 retry'\\\\'',cid,vid,u.rsplit('\\\\''\\\\n\\\\nThe code returned'\\\\'',1)[-1].splitlines()[0])\n print(label,'\\\\''ledger judgements'\\\\'',v.execute('\\\\''select count(*) from judgements'\\\\'').fetchone()[0], dict(counts),maxima,examples,'\\\\''text collisions'\\\\'',[lst for lst in textkeys.values() if len(lst)>1][:12])\n'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
