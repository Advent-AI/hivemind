{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba probe_read.py; nl -ba probe.py | sed -n '129,235p'\"","aggregated_output":"     1\t\"\"\"Reading packets and the one verdict of the paid acceptance probe (PROBE-DESIGN.md v5 §3, §4; D716).\n     2\t\n     3\t  python3 probe_read.py packets <probe out folder>              # Part B and Part C packets for the hand reading (and a blind copy)\n     4\t  python3 probe_read.py verdict <probe out folder> <readings>   # the ordered verdict from the answers and the final readings\n     5\t\n     6\tReadings file (JSON): {\"B\": {\"<key>|<draw>|<target>\": {\"class\": ..., \"valid_support\": bool}}, \"C\": {\"<key>\": {\"read\": true,\n     7\t\"harms\": [{\"kind\": \"a|b|c|d\", \"status\": \"confirmed|unresolved\"}]}}}. A Part B target id is the bad id for an evidence target and\n     8\t\"placement\" for a placement target. Classes: intended, unsupported, misattributed, omitted (evidence); correct, absent, misattributed\n     9\t(placement); ambiguous (either, counts neither way).\n    10\t\"\"\"\n    11\timport json\n    12\timport re\n    13\timport sys\n    14\tfrom pathlib import Path\n    15\t\n    16\tsys.path.insert(0, str(Path(__file__).resolve().parents[3] / 'src'))\n    17\tfrom hivemind import model                                              # noqa: E402\n    18\tfrom hivemind.views import judging                                     # noqa: E402\n    19\t\n    20\tHERE = Path(__file__).resolve().parent\n    21\tPLAN, TARGETS, STORED_V7 = HERE / 'probe-plan.json', HERE / 'probe-targets.json', HERE / 'stored-v7-support.json'\n    22\tMISATTRIBUTION_TOLERANCE = 2\n    23\tCLASSES = {'intended', 'unsupported', 'misattributed', 'omitted', 'correct', 'absent', 'ambiguous'}\n    24\t\n    25\t\n    26\tdef load_answers(out):\n    27\t    lines = [json.loads(line) for line in (Path(out) / 'answers.jsonl').read_text().splitlines() if line.strip()] if (Path(out) / 'answers.jsonl').exists() else []\n    28\t    return {(l['part'], l['key'], l['form'], l['draw']): l for l in lines}\n    29\t\n    30\t\n    31\tdef target_ids(target):\n    32\t    return target['bad'] if target['kind'] == 'evidence' else 'placement'\n    33\t\n    34\t\n    35\tdef entries(user):\n    36\t    \"\"\"Every listed entry a cited or pushed id can name: evidence entries, dependency entries and theme entries, each with its text.\"\"\"\n    37\t    found = {m.group(1): m.group(0) for m in re.finditer(r'^- (e\\d+) \\[[^\\n]*(?:\\n    [^\\n]*)*', user, re.M)}\n    38\t    found.update({m.group(1): m.group(0) for m in re.finditer(r'^- (v\\d+) \\([^\\n]*(?:\\n    [^\\n]*)*', user, re.M)})\n    39\t    return found\n    40\t\n    41\t\n    42\tdef readable(data):\n    43\t    \"\"\"Content a reader can read: every field of the judge's answer, of the right type (the open v7 format's shape).\"\"\"\n    44\t    return isinstance(data, dict) and not model.check_schema(data, judging.schema_for('judging-v7'))\n    45\t\n    46\t\n    47\tdef received(line):\n    48\t    \"\"\"An answer that can be read: answered, or refused by the format, with readable content either way.\"\"\"\n    49\t    return bool(line) and line['status'] in ('answered', 'format invalid') and readable(line.get('data'))\n    50\t\n    51\t\n    52\tEVIDENCE_CLASSES = {'intended': {True}, 'unsupported': {False}, 'omitted': {False}, 'misattributed': {True, False}, 'ambiguous': {True, False}}\n    53\tPLACEMENT_CLASSES = {'correct': {False}, 'absent': {False}, 'misattributed': {False}, 'ambiguous': {False}}\n    54\t\n    55\t\n    56\tdef validate(readings, answers, plan, targets):\n    57\t    \"\"\"Refuses a readings file with a value outside the frozen sets, a reading of no planned or no readable answer, a class whose\n    58\t    valid_support contradicts it (omitted or unsupported with support, intended without; a placement target has no support), or a Part C\n    59\t    reading of a comparison that is not complete, or harms on a comparison not read.\"\"\"\n    60\t    kinds = {f'{r[\"key\"]}|{d}|{target_ids(t)}': t['kind'] for r in targets['requests'] for t in r['targets'] for d in (1, 2, 3)}\n    61\t    for name, r in readings.get('B', {}).items():\n    62\t        if name not in kinds:\n    63\t            raise ValueError(f'Part B reading {name}: not a planned target')\n    64\t        key, draw, _ = name.split('|')\n    65\t        if not received(answers.get(('B', key, 'v12', int(draw)))):\n    66\t            raise ValueError(f'Part B reading {name}: its answer is missing or unreadable')\n    67\t        allowed = EVIDENCE_CLASSES if kinds[name] == 'evidence' else PLACEMENT_CLASSES\n    68\t        if r.get('class') not in allowed or not isinstance(r.get('valid_support'), bool) or r['valid_support'] not in allowed[r['class']]:\n    69\t            raise ValueError(f'Part B reading {name}: class {r.get(\"class\")!r} with valid_support {r.get(\"valid_support\")!r} is not allowed')\n    70\t    matched = {f'{i[\"source\"]}:{i[\"call_id\"]}' for i in plan['matched']}\n    71\t    for name, r in readings.get('C', {}).items():\n    72\t        if name not in matched:\n    73\t            raise ValueError(f'Part C reading {name}: not a planned comparison')\n    74\t        if not isinstance(r.get('read'), bool) or any(h.get('kind') not in ('a', 'b', 'c', 'd') or h.get('status') not in ('confirmed', 'unresolved')\n    75\t                                                     for h in r.get('harms', [])):\n    76\t            raise ValueError(f'Part C reading {name} is malformed')\n    77\t        if r.get('harms') and not r['read']:\n    78\t            raise ValueError(f'Part C reading {name}: harms on a comparison not read')\n    79\t        if not all(received(answers.get(('C', name, form, d))) for form in ('v12', 'v7') for d in (1, 2, 3)):\n    80\t            raise ValueError(f'Part C reading {name}: the comparison is not complete')\n    81\t\n    82\t\n    83\tdef verdict(answers, readings, plan, targets, stored_v7, summary):\n    84\t    \"\"\"PROBE-DESIGN.md v5 §3: the first rule that applies.\"\"\"\n    85\t    validate(readings, answers, plan, targets)\n    86\t    keys = lambda items: [f'{i[\"source\"]}:{i[\"call_id\"]}' for i in items]\n    87\t    a1, a0 = keys(plan['acceptance'][:2])\n    88\t    reasons = []\n    89\t    for part, key in (('A1', a1), ('A0', a0)):\n    90\t        line = answers.get((part, key, 'v12', 1))\n    91\t        if line and (line['status'] == 'format invalid' or (line['status'] == 'transport error' and line.get('http_status') == 400)):\n    92\t            return 'not ready (format)', [f'{part} rejected: {line.get(\"error\", \"\")[:200]}']\n    93\t    v12 = [l for l in answers.values() if l['form'] == 'v12' and l['part'] != 'A2']\n    94\t    refused = [l for l in v12 if l['status'] == 'format invalid' or (l['status'] == 'answered' and l['check'])]\n    95\t    if refused:\n    96\t        reasons.append(f'{len(refused)} v12 answers refused')\n    97\t    b_reads = readings.get('B', {})\n    98\t    misattributed = {k.rsplit('|', 1)[0] for k, r in b_reads.items() if r['class'] == 'misattributed'}\n    99\t    if len(misattributed) > MISATTRIBUTION_TOLERANCE:\n   100\t        reasons.append(f'{len(misattributed)} Part B answers with a confirmed misattribution (tolerance {MISATTRIBUTION_TOLERANCE})')\n   101\t    losses, unresolved = [], []\n   102\t    for request in targets['requests']:\n   103\t        for target in request['targets']:\n   104\t            if target['kind'] != 'evidence' or not target.get('material'):\n   105\t                continue\n   106\t            draws = [b_reads.get(f'{request[\"key\"]}|{d}|{target[\"bad\"]}') for d in (1, 2, 3)]\n   107\t            all_received = all(received(answers.get(('B', request['key'], 'v12', d))) for d in (1, 2, 3))\n   108\t            if not all_received or any(r is None for r in draws):\n   109\t                continue                                                   # a loss needs all three draws received and read\n   110\t            if not any(r['valid_support'] for r in draws):\n   111\t                (losses if stored_v7['targets'].get(request['key'], {}).get('supported') else unresolved).append(f'{request[\"key\"]} {target[\"bad\"]}')\n   112\t    if losses:\n   113\t        reasons.append('confirmed material loss in Part B: ' + ', '.join(losses))\n   114\t    c_reads = readings.get('C', {})\n   115\t    harms = [f'{k} ({h[\"kind\"]})' for k, r in c_reads.items() for h in r.get('harms', []) if h['status'] == 'confirmed']\n   116\t    if harms:\n   117\t        reasons.append('confirmed material harm in Part C: ' + ', '.join(harms))\n   118\t    if reasons:\n   119\t        return 'not ready', reasons\n   120\t    incomplete = []\n   121\t    core = summary.get('core ledger', summary.get('ledger', {}))        # the ledger as the core run left it; A2 never changes the verdict\n   122\t    if core.get('stopped'):\n   123\t        incomplete.append(f'the ledger stopped: {core.get(\"stop_reason\")}')\n   124\t    for part, key in (('A1', a1), ('A0', a0)):\n   125\t        line = answers.get((part, key, 'v12', 1))\n   126\t        if not line or line['status'] != 'answered':\n   127\t            incomplete.append(f'{part} has no result')\n   128\t    for key in keys(plan['refused']):\n   129\t        for d in (1, 2, 3):\n   130\t            line = answers.get(('B', key, 'v12', d))\n   131\t            if not received(line):\n   132\t                incomplete.append(f'Part B {key} draw {d} missing or unreadable')\n   133\t            for request in targets['requests']:\n   134\t                if request['key'] == key:\n   135\t                    for target in request['targets']:\n   136\t                        if f'{key}|{d}|{target_ids(target)}' not in b_reads:\n   137\t                            incomplete.append(f'Part B {key} draw {d} {target_ids(target)} not read')\n   138\t    for key in keys(plan['matched']):\n   139\t        complete = all(received(answers.get(('C', key, form, d))) for form in ('v12', 'v7') for d in (1, 2, 3))\n   140\t        if not complete:\n   141\t            incomplete.append(f'Part C {key} incomplete')\n   142\t        elif not c_reads.get(key, {}).get('read'):\n   143\t            incomplete.append(f'Part C {key} not read')\n   144\t    if incomplete:\n   145\t        return 'inconclusive (incomplete)', incomplete\n   146\t    unresolved += [f'{k} ({h[\"kind\"]})' for k, r in c_reads.items() for h in r.get('harms', []) if h['status'] == 'unresolved']\n   147\t    if unresolved:\n   148\t        return 'inconclusive (unresolved)', unresolved\n   149\t    return 'pass', [f'{len(misattributed)} Part B answers with a confirmed misattribution']\n   150\t\n   151\t\n   152\tdef packets(out):\n   153\t    out = Path(out)\n   154\t    plan, targets, answers = json.loads(PLAN.read_text()), json.loads(TARGETS.read_text()), load_answers(out)\n   155\t    by_key = {f'{i[\"source\"]}:{i[\"call_id\"]}': i for i in plan['refused'] + plan['matched']}\n   156\t    show = lambda l: None if not l or not readable(l.get('data')) else {k: l['data'].get(k) for k in ('rung', 'reference', 'implied_outcome', 'reasons', 'cites', 'cites_views', 'pushes', 'theme_pushes', 'changed', 'why_changed')}\n   157\t    b, blind = [], []\n   158\t    for request in targets['requests']:\n   159\t        item, listed = by_key[request['key']], entries(by_key[request['key']]['user'])\n   160\t        for d in (1, 2, 3):\n   161\t            line = answers.get(('B', request['key'], 'v12', d))\n   162\t            text = json.dumps(show(line) or {}, ensure_ascii=False)\n   163\t            for target in request['targets']:\n   164\t                flags = [m for m in target.get('markers', []) if m.lower() not in text.lower()]\n   165\t                data = (line or {}).get('data') if readable((line or {}).get('data')) else {}\n   166\t                used = set(data.get('cites') or []) | set(data.get('cites_views') or []) | {x['evidence_id'] for x in data.get('pushes') or []} | {x['view_id'] for x in data.get('theme_pushes') or []}\n   167\t                quotes = {e: listed.get(e, '(not listed)') for e in sorted(used | set(target.get('sources', []) + target.get('partial', []) + target.get('near_misses', [])))}\n   168\t                entry = {'id': f'{request[\"key\"]}|{d}|{target_ids(target)}', 'status': line['status'] if line else 'missing', 'answer': show(line),\n   169\t                         'target': target, 'quotes': quotes, 'markers not found': flags, 'question': item['user'].split('\\n', 1)[0]}\n   170\t                b.append(entry)\n   171\t                blind.append(entry)\n   172\t    c = []\n   173\t    for item in plan['matched']:\n   174\t        key, listed = f'{item[\"source\"]}:{item[\"call_id\"]}', entries(item['user'])\n   175\t        arms = {form: [show(answers.get(('C', key, form, d))) for d in (1, 2, 3)] for form in ('v12', 'v7')}\n   176\t        cited = lambda a: (set((a or {}).get('cites') or []) | {p['evidence_id'] for p in (a or {}).get('pushes') or []}\n   177\t                           | set((a or {}).get('cites_views') or []) | {p['view_id'] for p in (a or {}).get('theme_pushes') or []})\n   178\t        counts = {form: {} for form in arms}\n   179\t        for form, answers_ in arms.items():\n   180\t            for a in answers_:\n   181\t                for e in cited(a):\n   182\t                    counts[form][e] = counts[form].get(e, 0) + 1\n   183\t        differing = sorted(e for e in set(counts['v12']) | set(counts['v7']) if (counts['v12'].get(e, 0) >= 2) != (counts['v7'].get(e, 0) >= 2))\n   184\t        everything = sorted(set(counts['v12']) | set(counts['v7']))\n   185\t        c.append({'key': key, 'question': item['user'].split('\\n', 1)[0], 'stored answer': json.loads(item['stored answer']) if item.get('stored answer') else None,\n   186\t                  'v12': arms['v12'], 'v7': arms['v7'], 'rungs': {f: [a and a['rung'] for a in arms[f]] for f in arms},\n   187\t                  'differing sources (>=2 of 3 in one arm only)': differing, 'quotes': {e: listed.get(e, '(not listed)') for e in everything}})\n   188\t    (out / 'packet-B.json').write_text(json.dumps(b, ensure_ascii=False, indent=1))\n   189\t    (out / 'packet-C.json').write_text(json.dumps(c, ensure_ascii=False, indent=1))\n   190\t    print(f'Part B: {len(b)} target readings; Part C: {len(c)} comparisons')\n   191\t\n   192\t\n   193\tdef main():\n   194\t    if len(sys.argv) >= 3 and sys.argv[1] == 'packets':\n   195\t        packets(sys.argv[2])\n   196\t    elif len(sys.argv) == 4 and sys.argv[1] == 'verdict':\n   197\t        out = Path(sys.argv[2])\n   198\t        summary = json.loads((out / 'run-summary.json').read_text()) if (out / 'run-summary.json').exists() else {}\n   199\t        result = verdict(load_answers(out), json.loads(Path(sys.argv[3]).read_text()), json.loads(PLAN.read_text()), json.loads(TARGETS.read_text()),\n   200\t                         json.loads(STORED_V7.read_text()), summary)\n   201\t        print(json.dumps({'verdict': result[0], 'reasons': result[1]}, indent=1))\n   202\t    else:\n   203\t        raise SystemExit(__doc__)\n   204\t\n   205\t\n   206\tif __name__ == '__main__':\n   207\t    main()\n   129\t        state = self.ledger.read()\n   130\t        return state['ceiling'] - state['spent'] - state['reserved'], state\n   131\t\n   132\t    def record(self, line):\n   133\t        with self.lock, open(self.out / 'answers.jsonl', 'a') as handle:\n   134\t            handle.write(json.dumps(line, ensure_ascii=False) + '\\n')\n   135\t\n   136\t    def send(self, spec):\n   137\t        item, form = spec['item'], spec['form']\n   138\t        name = f'{spec[\"part\"]}-{spec[\"key\"].replace(\":\", \"-\")}-{form}-{spec[\"draw\"]}.sqlite'\n   139\t        archive = model.Archive(str(self.out / 'archives' / name))\n   140\t        line = {k: spec[k] for k in ('part', 'key', 'form', 'draw')}\n   141\t        line['request_sha256'] = model.request_identity(self.request(spec))[1]\n   142\t        ACCOUNT.attempts, ACCOUNT.charged = 0, 0.0\n   143\t        try:\n   144\t            answer = model.call(archive, self.cfg, self.cfg.rejudging, item['system'], item['user'], answer_format(item, form), 'judgement', 'judge',\n   145\t                                transport=self.transport)\n   146\t            line.update(status='answered', data=answer.data, cost_usd=answer.cost_usd, cached=answer.cached,\n   147\t                        check=check_at_request(answer.data, item['user'], item['lists']))\n   148\t        except model.SchemaError as error:\n   149\t            row = archive.conn.execute('select answer_json from model_calls order by call_id desc limit 1').fetchone()\n   150\t            line.update(status='format invalid', error=str(error)[:500], data=json.loads(row[0]) if row and row[0] else None)\n   151\t        except model.TransportError as error:\n   152\t            line.update(status='transport error', error=str(error)[:500], http_status=getattr(error, 'http_status', None))\n   153\t        line.update(provider_attempts=ACCOUNT.attempts, charged_usd=round(ACCOUNT.charged, 6))\n   154\t        self.record(line)\n   155\t        return line\n   156\t\n   157\t    def run(self, plan):\n   158\t        for item in plan['acceptance'][:2] + plan['refused'] + plan['matched']:\n   159\t            evidence, themes = header_counts(item['user'])\n   160\t            if evidence is not None and (evidence != len(item['lists']['evidence']) or themes != len(item['lists']['themes'])):\n   161\t                raise SystemExit(f'{key_of(item)}: the text-read lists do not match the header counts; not sent')\n   162\t        summary = {'sent': {}, 'not started': [], 'interrupted': [], 'A2': None, 'stopped after': None}\n   163\t        for group, specs in schedule(plan):\n   164\t            if summary['stopped after']:\n   165\t                break\n   166\t            if group in ('A1', 'A0'):\n   167\t                summary['sent'][group] = [self.send(s)['status'] for s in specs]\n   168\t                if summary['sent'][group] != ['answered']:          # D715: the format checks decide whether to go on\n   169\t                    summary['stopped after'] = group\n   170\t            elif group == 'B':\n   171\t                with concurrent.futures.ThreadPoolExecutor(max_workers=B_WORKERS) as pool:\n   172\t                    summary['sent']['B'] = [line['status'] for line in pool.map(self.send, specs)]\n   173\t            elif group == 'C':\n   174\t                summary['sent']['C'] = []\n   175\t                for comparison in specs:\n   176\t                    need = sum(self.reservation(s) for s in comparison)\n   177\t                    room, state = self.headroom()\n   178\t                    if state.get('stopped') or room < need:\n   179\t                        summary['not started'].append({'key': comparison[0]['key'], 'need': round(need, 4), 'headroom': round(room, 4)})\n   180\t                        continue\n   181\t                    statuses = []\n   182\t                    for s in comparison:\n   183\t                        statuses.append(self.send(s)['status'])\n   184\t                        if statuses[-1] == 'transport error':\n   185\t                            summary['interrupted'].append(comparison[0]['key'])\n   186\t                            break\n   187\t                    summary['sent']['C'].append({'key': comparison[0]['key'], 'statuses': statuses})\n   188\t            else:\n   189\t                summary['core ledger'] = self.ledger.read()          # the verdict reads the ledger as the core run left it\n   190\t                need = 3 * self.reservation(specs[0])                   # its first attempt and two retries\n   191\t                room, state = self.headroom()\n   192\t                summary['A2'] = self.send(specs[0])['status'] if not state.get('stopped') and room >= need else f'skipped (headroom {room:.4f} < {need:.4f})'\n   193\t        summary.setdefault('core ledger', self.ledger.read())\n   194\t        summary['ledger'] = self.ledger.read()\n   195\t        (self.out / 'run-summary.json').write_text(json.dumps(summary, indent=1))\n   196\t        return summary\n   197\t\n   198\t\n   199\tdef send(out, approved):\n   200\t    if approved != APPROVED_CEILING:\n   201\t        raise SystemExit(f'the approved ceiling is ${APPROVED_CEILING} (D715); refused')\n   202\t    if out.exists():\n   203\t        raise SystemExit(f'{out} exists: the probe starts from an empty folder')\n   204\t    out.mkdir(parents=True)\n   205\t    budget = budget_module()\n   206\t    ledger_path = out / 'ledger.json'\n   207\t    budget.SharedLedger.init(str(ledger_path), approved)\n   208\t    ledger = budget.SharedLedger(str(ledger_path))\n   209\t    lock_handle = open(out / 'probe.launcher.lock', 'a+')\n   210\t    if not ledger.claim_launcher('probe', lock_handle):\n   211\t        raise SystemExit('another launch is running')\n   212\t    remove_gate = budget.install_stop_gate(ledger)\n   213\t    try:\n   214\t        original = model.openai_transport\n   215\t        model.openai_transport = counting(original)\n   216\t        try:\n   217\t            summary = Probe(out, budget.BudgetTransport(ledger), ledger, budget).run(json.loads(PLAN.read_text()))\n   218\t        finally:\n   219\t            model.openai_transport = original\n   220\t    finally:\n   221\t        remove_gate()\n   222\t        ledger.remove_launcher('probe')\n   223\t    print(json.dumps(summary, indent=1)[:4000])\n   224\t\n   225\t\n   226\tif __name__ == '__main__':\n   227\t    command = sys.argv[1] if len(sys.argv) > 1 else ''\n   228\t    if command == 'send' and len(sys.argv) == 4 and not sys.argv[2].startswith('-'):\n   229\t        send(Path(sys.argv[2]), float(sys.argv[3]))\n   230\t    elif command == 'rehearse' and len(sys.argv) == 4 and not sys.argv[2].startswith('-'):\n   231\t        import probe_rehearsal\n   232\t        probe_rehearsal.main(Path(sys.argv[2]), sys.argv[3])\n   233\t    else:\n   234\t        raise SystemExit(__doc__)\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc 'nl -ba probe_rehearsal.py; cat rehearsal.log'","aggregated_output":"     1\t\"\"\"The paid acceptance probe's $0 rehearsal (PROBE-DESIGN.md v5 §4; D716): `probe.Probe` runs unchanged on the real budget transport,\n     2\tthe real `model.openai_transport` and the real stop gate, with the network call (`urllib.request.urlopen`) replaced by a stub that\n     3\tcompares each HTTP body, byte for byte, with a request it builds itself, counts the calls and answers by scenario. A dummy API key is\n     4\tset in this process so no credential is read.\n     5\t\n     6\t  python3 probe.py rehearse <new out folder> <scenario>\n     7\t  scenarios: clean, format-invalid, a1-400, a1-timeout, 5xx-then-ok, low-ceiling, retry-exhausts, a2-stop, mutant-open-b, mutant-order,\n     8\t             checks, verdicts, all\n     9\t\"\"\"\n    10\timport io\n    11\timport json\n    12\timport os\n    13\timport re\n    14\timport sys\n    15\timport tempfile\n    16\timport urllib.error\n    17\timport urllib.request\n    18\tfrom pathlib import Path\n    19\t\n    20\tHERE = Path(__file__).resolve().parent\n    21\tREPO = HERE.parents[2]\n    22\tsys.path.insert(0, str(HERE))\n    23\tsys.path.insert(0, str(REPO / 'tests'))\n    24\timport probe                                                            # noqa: E402\n    25\timport probe_read                                                       # noqa: E402\n    26\tfrom hivemind import model                                              # noqa: E402\n    27\tfrom hivemind.views import judging                                     # noqa: E402\n    28\t\n    29\tPLAN = json.loads(probe.PLAN.read_text())\n    30\tITEMS = {i['user']: i for i in PLAN['acceptance'] + PLAN['refused'] + PLAN['matched']}\n    31\tBY_KEY = {probe.key_of(i): i for i in PLAN['acceptance'] + PLAN['refused'] + PLAN['matched']}\n    32\tTARGETS, STORED = json.loads(probe_read.TARGETS.read_text()), json.loads(probe_read.STORED_V7.read_text())\n    33\t\n    34\t\n    35\tdef valid_answer(item, drop_marker=None):\n    36\t    lists = item['lists']\n    37\t    previous = re.search(r'^\\[Previous conclusion, for comparison only\\] rung (\\d+);', item['user'], re.M)\n    38\t    cites = lists['evidence'][:3]\n    39\t    reasons = 'scripted reasons; the consensus growth estimate of 85.4% sits at rung 1; $393 billion is the reference.'\n    40\t    if drop_marker:\n    41\t        reasons = reasons.replace(drop_marker, 'an earlier figure')\n    42\t    return {'rung': int(previous.group(1)) if previous else 1, 'reference': 'scripted reference', 'implied_outcome': 'scripted outcome',\n    43\t            'reasons': reasons, 'cites': cites, 'cites_views': [], 'pushes': [{'evidence_id': e, 'push': 'none'} for e in cites],\n    44\t            'changed': previous is None, 'why_changed': 'scripted', 'theme_pushes': [{'view_id': t, 'push': 'none'} for t in lists['themes'][:1]]}\n    45\t\n    46\t\n    47\tclass FakeResponse:\n    48\t    def __init__(self, body):\n    49\t        self.body, self.status = body, 200\n    50\t\n    51\t    def read(self):\n    52\t        return self.body\n    53\t\n    54\t    def __enter__(self):\n    55\t        return self\n    56\t\n    57\t    def __exit__(self, *exc):\n    58\t        return False\n    59\t\n    60\t\n    61\tdef http_error(url, code):\n    62\t    return urllib.error.HTTPError(url, code, f'HTTP {code}', {}, io.BytesIO(json.dumps({'error': {'code': code}}).encode()))\n    63\t\n    64\t\n    65\tclass HttpStub:\n    66\t    \"\"\"Stands in for `urllib.request.urlopen`: the body must equal, byte for byte, the request this stub builds from the plan (never from\n    67\t    the code under test); calls are counted per (request, format); the answer depends on the scenario.\"\"\"\n    68\t\n    69\t    def __init__(self, cfg, scenario, ledger):\n    70\t        self.cfg, self.scenario, self.ledger, self.calls, self.problems = cfg, scenario, ledger, {}, []\n    71\t\n    72\t    def __call__(self, http_request, *args, **kwargs):\n    73\t        body = http_request.data\n    74\t        request = json.loads(body)\n    75\t        user = request['messages'][1]['content']\n    76\t        item = ITEMS.get(user)\n    77\t        if item is None or request['messages'][0]['content'] != item['system']:\n    78\t            self.problems.append('a request whose text is not a planned one')\n    79\t            raise http_error(http_request.full_url, 400)\n    80\t        setting = self.cfg.rejudging\n    81\t        expected = lambda schema: json.dumps({'model': setting.model, 'messages': [{'role': 'system', 'content': item['system']}, {'role': 'user', 'content': user}],\n    82\t                                              'response_format': {'type': 'json_schema', 'json_schema': {'name': 'judgement', 'strict': True, 'schema': schema}},\n    83\t                                              'max_completion_tokens': setting.max_output_tokens, 'reasoning_effort': setting.reasoning_effort}).encode('utf-8')\n    84\t        form = next((f for f, schema in (('v12', judging.schema_for('judging-v12', item['lists'])), ('v7', judging.schema_for('judging-v7')))\n    85\t                     if body == expected(schema)), None)\n    86\t        key = probe.key_of(item)\n    87\t        part = 'B' if item in PLAN['refused'] else ('C' if item in PLAN['matched'] else 'A')\n    88\t        if form is None or (part in ('A', 'B') and form != 'v12'):\n    89\t            self.problems.append(f'{key}: the body is not the planned request for part {part}')\n    90\t        count_key = (key, form)\n    91\t        self.calls[count_key] = self.calls.get(count_key, 0) + 1\n    92\t        attempt, s = self.calls[count_key], self.scenario\n    93\t        if s == 'a2-stop' and key == 'sealed-D358:6918':\n    94\t            self.ledger.stop('rehearsal: the ledger stops during A2')\n    95\t            raise http_error(http_request.full_url, 503)\n    96\t        if s == 'a1-400' and key == 'old-1:5652':\n    97\t            raise http_error(http_request.full_url, 400)\n    98\t        if s == 'a1-timeout' and key == 'old-1:5652':\n    99\t            raise TimeoutError('timed out')\n   100\t        if s == '5xx-then-ok' and key == 'old-3:69' and attempt == 1:\n   101\t            raise http_error(http_request.full_url, 503)\n   102\t        if s == 'retry-exhausts' and part == 'C' and key == probe.key_of(PLAN['matched'][0]) and form == 'v12' and attempt == 2:\n   103\t            raise http_error(http_request.full_url, 503)\n   104\t        data = valid_answer(item, drop_marker='85.4' if s == 'clean' and key == 'control-1:8938' and attempt == 1 else None)\n   105\t        if s == 'format-invalid' and key == 'old-2:591' and attempt == 1:\n   106\t            data['cites'] = data['cites'] + ['e999999']\n   107\t        usage = {'prompt_tokens': 1000, 'completion_tokens': 100}\n   108\t        if s == 'retry-exhausts' and part == 'C':                      # each answer costs its full reservation, so a retry's extra charge exhausts the headroom\n   109\t            usage = {'prompt_tokens': 2 * len(body) + 4096, 'completion_tokens': request['max_completion_tokens']}\n   110\t        return FakeResponse(json.dumps({'choices': [{'message': {'content': json.dumps(data)}}], 'usage': usage}).encode('utf-8'))\n   111\t\n   112\t\n   113\tdef run(out, scenario):\n   114\t    budget = probe.budget_module()\n   115\t    out.mkdir(parents=True)\n   116\t    ledger_path = out / 'ledger.json'\n   117\t    budget.SharedLedger.init(str(ledger_path), probe.APPROVED_CEILING)\n   118\t    ledger = budget.SharedLedger(str(ledger_path))\n   119\t    p = probe.Probe(out, budget.BudgetTransport(ledger, sleep=lambda seconds: None), ledger, budget)\n   120\t    stub = HttpStub(p.cfg, scenario, ledger)\n   121\t    saved = (urllib.request.urlopen, model.openai_transport, probe.answer_format, os.environ.get('OPENAI_API_KEY'))\n   122\t    os.environ['OPENAI_API_KEY'] = 'rehearsal-dummy-not-a-key'\n   123\t    urllib.request.urlopen = stub\n   124\t    remove_gate = budget.install_stop_gate(ledger)                       # the gate wraps the stub, as it wraps the network in the send\n   125\t    model.openai_transport = probe.counting(saved[1])                    # the real transport, with the send's counting wrapper\n   126\t    if scenario == 'mutant-open-b':\n   127\t        probe.answer_format = lambda item, form: judging.schema_for('judging-v7') if item in PLAN['refused'] else saved[2](item, form)\n   128\t    if scenario == 'mutant-order':                                      # the same schema with its properties reversed: equal as a dict, not on the wire\n   129\t        def reordered(item, form):\n   130\t            schema = saved[2](item, form)\n   131\t            return dict(schema, properties=dict(reversed(list(schema['properties'].items())))) if item in PLAN['refused'] else schema\n   132\t        probe.answer_format = reordered\n   133\t    first_c = probe.schedule(PLAN)[3][1][0]\n   134\t    need_c1 = sum(p.reservation(s) for s in first_c)\n   135\t    original_headroom = p.headroom\n   136\t\n   137\t    def lowered():\n   138\t        if scenario in ('low-ceiling', 'retry-exhausts') and not getattr(lowered, 'done', False) and \\\n   139\t                sum(1 for line in (out / 'answers.jsonl').read_text().splitlines() if '\"part\": \"B\"' in line) == 48:\n   140\t            state = ledger.read()\n   141\t            with ledger._locked() as s:\n   142\t                s['ceiling'] = state['spent'] + (need_c1 * 0.5 if scenario == 'low-ceiling' else need_c1 + 0.0005)\n   143\t            lowered.done = True\n   144\t        return original_headroom()\n   145\t    p.headroom = lowered\n   146\t    try:\n   147\t        summary = p.run(PLAN)\n   148\t    finally:\n   149\t        remove_gate()\n   150\t        urllib.request.urlopen, model.openai_transport, probe.answer_format = saved[0], saved[1], saved[2]\n   151\t        if saved[3] is None:\n   152\t            os.environ.pop('OPENAI_API_KEY', None)\n   153\t        else:\n   154\t            os.environ['OPENAI_API_KEY'] = saved[3]\n   155\t    return summary, stub, probe_read.load_answers(out)\n   156\t\n   157\t\n   158\tdef expect(name, condition, detail=''):\n   159\t    print(f'  [{\"ok\" if condition else \"FAIL\"}] {name}{(\": \" + detail) if detail and not condition else \"\"}')\n   160\t    return bool(condition)\n   161\t\n   162\t\n   163\tdef clean_readings(overrides=None, answers=None):\n   164\t    \"\"\"Clean readings, the overrides applied, then (when answers are given) only for answers received and comparisons complete.\"\"\"\n   165\t    b = {}\n   166\t    for request in TARGETS['requests']:\n   167\t        for d in (1, 2, 3):\n   168\t            for target in request['targets']:\n   169\t                cls = 'ambiguous' if target.get('ambiguous') else ('intended' if target['kind'] == 'evidence' else 'correct')\n   170\t                b[f'{request[\"key\"]}|{d}|{probe_read.target_ids(target)}'] = {'class': cls, 'valid_support': target['kind'] == 'evidence'}\n   171\t    readings = {'B': b, 'C': {probe.key_of(i): {'read': True, 'harms': []} for i in PLAN['matched']}}\n   172\t    for key, value in (overrides or {}).items():\n   173\t        part, name = key.split('/', 1)\n   174\t        if value is None:\n   175\t            readings[part].pop(name, None)\n   176\t        else:\n   177\t            readings[part][name] = value\n   178\t    if answers is not None:\n   179\t        readings['B'] = {k: r for k, r in readings['B'].items()\n   180\t                         if probe_read.received(answers.get(('B', k.split('|')[0], 'v12', int(k.split('|')[1]))))}\n   181\t        readings['C'] = {k: r for k, r in readings['C'].items()\n   182\t                         if all(probe_read.received(answers.get(('C', k, f, d))) for f in ('v12', 'v7') for d in (1, 2, 3))}\n   183\t    return readings\n   184\t\n   185\t\n   186\tdef clean_answers():\n   187\t    answers = {}\n   188\t    for _, specs in probe.schedule(PLAN):\n   189\t        for s in [s for group in specs for s in (group if isinstance(group, list) else [group])]:\n   190\t            answers[(s['part'], s['key'], s['form'], s['draw'])] = {'part': s['part'], 'key': s['key'], 'form': s['form'], 'draw': s['draw'],\n   191\t                                                                     'status': 'answered', 'check': [], 'data': valid_answer(BY_KEY[s['key']])}\n   192\t    return answers\n   193\t\n   194\t\n   195\tdef verdict_of(answers, readings, summary=None):\n   196\t    return probe_read.verdict(answers, readings, PLAN, TARGETS, STORED, summary or {'ledger': {'stopped': False}})\n   197\t\n   198\t\n   199\tdef scenario_checks(out, scenario):\n   200\t    summary, stub, answers = run(out / scenario, scenario)\n   201\t    ok = True\n   202\t    print(scenario)\n   203\t    if scenario == 'clean':\n   204\t        ok &= expect('no request problem', not stub.problems, str(stub.problems[:3]))\n   205\t        ok &= expect('2 + 48 + 72 + A2 answers', sum(1 for a in answers.values() if a['part'] in ('A1', 'A0')) == 2 and\n   206\t                     sum(1 for a in answers.values() if a['part'] == 'B') == 48 and sum(1 for a in answers.values() if a['part'] == 'C') == 72 and summary['A2'] == 'answered')\n   207\t        ok &= expect('three fresh calls per planned request and format', all(v == 3 for (k, f), v in stub.calls.items()\n   208\t                     if not k.startswith(('old-1:5652', 'old-3:69', 'sealed')) and f is not None), str({k: v for k, v in stub.calls.items() if v != 3}))\n   209\t        ok &= expect('every answer answered and passing the request-time check', all(a['status'] == 'answered' and not a['check'] and not a['cached'] for a in answers.values()))\n   210\t        ok &= expect('records carry provider attempts and charges', all('provider_attempts' in a and 'charged_usd' in a for a in answers.values())\n   211\t                     and sum(a['provider_attempts'] for a in answers.values()) == 123)\n   212\t        probe_read.packets(out / scenario)\n   213\t        packet = json.loads((out / scenario / 'packet-B.json').read_text())\n   214\t        flagged = [e for e in packet if e['id'].startswith('control-1:8938|') and e['id'].endswith('|e362') and '85.4' in e['markers not found']]\n   215\t        ok &= expect('the 8938 packet flags the one answer that drops 85.4', len(flagged) == 1)\n   216\t        packet_c = json.loads((out / scenario / 'packet-C.json').read_text())\n   217\t        ok &= expect('Part C quotes are not cut', all(len(q) == len(probe_read.entries(BY_KEY[c['key']]['user']).get(e, '(not listed)')) for c in packet_c for e, q in c['quotes'].items()))\n   218\t        ok &= expect('the clean run verdict is pass', verdict_of(answers, clean_readings(answers=answers), summary)[0] == 'pass')\n   219\t    elif scenario == 'format-invalid':\n   220\t        ok &= expect('the format-invalid answer takes the SchemaError path', answers[('B', 'old-2:591', 'v12', 1)]['status'] == 'format invalid')\n   221\t        ok &= expect('verdict not ready', verdict_of(answers, clean_readings(answers=answers), summary)[0] == 'not ready')\n   222\t    elif scenario == 'a1-400':\n   223\t        ok &= expect('A1 recorded as a 400', answers[('A1', 'old-1:5652', 'v12', 1)].get('http_status') == 400)\n   224\t        ok &= expect('nothing after A1 is sent', set(a['part'] for a in answers.values()) == {'A1'} and set(k for k, f in stub.calls) == {'old-1:5652'})\n   225\t    elif scenario == 'a1-timeout':\n   226\t        line = answers[('A1', 'old-1:5652', 'v12', 1)]\n   227\t        ok &= expect('A1 a transport error without a status, after three attempts', line['status'] == 'transport error' and line.get('http_status') is None\n   228\t                     and stub.calls[('old-1:5652', 'v12')] == 3 and line.get('provider_attempts') == 3)\n   229\t        ok &= expect('nothing after A1 is sent', set(a['part'] for a in answers.values()) == {'A1'})\n   230\t    elif scenario == '5xx-then-ok':\n   231\t        line = answers[('A0', 'old-3:69', 'v12', 1)]\n   232\t        ok &= expect('A0 answered after a 503 retry, the failed attempt charged', line['status'] == 'answered' and stub.calls[('old-3:69', 'v12')] == 2\n   233\t                     and line['provider_attempts'] == 2 and line['charged_usd'] > 0.001)\n   234\t    elif scenario == 'low-ceiling':\n   235\t        ok &= expect('the first Part C comparison is not started', summary['not started'] and summary['not started'][0]['key'] == probe.key_of(PLAN['matched'][0]))\n   236\t    elif scenario == 'retry-exhausts':\n   237\t        ok &= expect('the admitted comparison is interrupted by the refused retry reservation', summary['interrupted'] == [probe.key_of(PLAN['matched'][0])]\n   238\t                     and summary['ledger']['stopped'])\n   239\t    elif scenario == 'a2-stop':\n   240\t        ok &= expect('the ledger stopped during A2, the core ledger did not', summary['ledger']['stopped'] and not summary['core ledger']['stopped'])\n   241\t        ok &= expect('a stop during A2 leaves the core verdict pass', verdict_of(answers, clean_readings(answers=answers), summary)[0] == 'pass')\n   242\t    elif scenario in ('mutant-open-b', 'mutant-order'):\n   243\t        ok &= expect(f'the byte check catches {scenario}', any('not the planned request for part B' in p for p in stub.problems))\n   244\t    if scenario in ('low-ceiling', 'retry-exhausts', 'a1-timeout', 'a1-400'):\n   245\t        expected = 'not ready (format)' if scenario == 'a1-400' else 'inconclusive (incomplete)'\n   246\t        result = verdict_of(answers, clean_readings(answers=answers), summary)\n   247\t        ok &= expect(f'verdict {expected}', result[0] == expected, str(result))\n   248\t    return ok\n   249\t\n   250\t\n   251\tdef verdict_cases():\n   252\t    v = lambda answers, overrides=None, summary=None: verdict_of(answers, clean_readings(overrides, answers), summary)[0]\n   253\t    unsupported = lambda key, bad: {f'B/{key}|{d}|{bad}': {'class': 'unsupported', 'valid_support': False} for d in (1, 2, 3)}\n   254\t    misattributed = {f'B/old-2:591|{d}|e88': {'class': 'misattributed', 'valid_support': True} for d in (1, 2, 3)}\n   255\t    two_wrong_one_omitted = {'B/control-1:8807|1|e393': {'class': 'misattributed', 'valid_support': False},\n   256\t                             'B/control-1:8807|2|e393': {'class': 'misattributed', 'valid_support': False},\n   257\t                             'B/control-1:8807|3|e393': {'class': 'omitted', 'valid_support': False}}\n   258\t    variant = lambda changes: dict(clean_answers(), **{}) if not changes else {**clean_answers(), **changes}\n   259\t    first_c = probe.key_of(PLAN['matched'][0])\n   260\t    missing_two = clean_answers()\n   261\t    for d in (2, 3):\n   262\t        missing_two.pop(('B', 'control-1:8807', 'v12', d))\n   263\t    c_incomplete = clean_answers()\n   264\t    c_incomplete.pop(('C', probe.key_of(PLAN['matched'][-1]), 'v7', 3))\n   265\t    a2_skipped = clean_answers()\n   266\t    a2_skipped.pop(('A2', 'sealed-D358:6918', 'v12', 1))\n   267\t    line = lambda part, key, form, draw, **fields: {(part, key, form, draw): dict({'part': part, 'key': key, 'form': form, 'draw': draw}, **fields)}\n   268\t    cases = [\n   269\t        ('clean set', v(clean_answers()), 'pass'),\n   270\t        ('8938 85.4% unsupported in three draws', v(clean_answers(), unsupported('control-1:8938', 'e362')), 'inconclusive (unresolved)'),\n   271\t        ('8807 $393B unsupported in three draws', v(clean_answers(), unsupported('control-1:8807', 'e393')), 'not ready'),\n   272\t        ('three misattributions', v(clean_answers(), misattributed), 'not ready'),\n   273\t        ('8807 two wrong, one omitted', v(clean_answers(), two_wrong_one_omitted), 'not ready'),\n   274\t        ('8807 one unsupported, two missing', v(missing_two, {'B/control-1:8807|1|e393': {'class': 'unsupported', 'valid_support': False}}), 'inconclusive (incomplete)'),\n   275\t        ('A1 rejected', v(variant(line('A1', 'old-1:5652', 'v12', 1, status='transport error', http_status=400, error='HTTP 400'))), 'not ready (format)'),\n   276\t        ('A1 timed out', v(variant(line('A1', 'old-1:5652', 'v12', 1, status='transport error', http_status=None))), 'inconclusive (incomplete)'),\n   277\t        ('misattribution excess with Part C incomplete', v(c_incomplete, misattributed), 'not ready'),\n   278\t        ('unresolved Part C difference, all else clean', v(clean_answers(), {f'C/{first_c}': {'read': True, 'harms': [{'kind': 'a', 'status': 'unresolved'}]}}), 'inconclusive (unresolved)'),\n   279\t        ('A2 skipped', v(a2_skipped), 'pass'),\n   280\t        ('A2 rejected', v(variant(line('A2', 'sealed-D358:6918', 'v12', 1, status='transport error', http_status=400))), 'pass'),\n   281\t        ('a refused v12 answer', v(variant(line('B', 'old-2:591', 'v12', 1, status='answered', check=['x'], data=valid_answer(BY_KEY['old-2:591'])))), 'not ready'),\n   282\t        ('a ledger stop in the core run', v(clean_answers(), None, {'core ledger': {'stopped': True, 'stop_reason': 'ceiling'}}), 'inconclusive (incomplete)'),\n   283\t        ('a Part C control with no content', v(variant(line('C', first_c, 'v7', 1, status='format invalid', data=None))), 'inconclusive (incomplete)'),\n   284\t        ('a Part C control answering {}', v(variant(line('C', first_c, 'v7', 1, status='answered', check=[], data={}))), 'inconclusive (incomplete)'),\n   285\t        ('a readable v7 control the request-time check refuses still counts', v(variant(line('C', first_c, 'v7', 1, status='answered', check=['x'], data=valid_answer(BY_KEY[first_c])))), 'pass'),\n   286\t    ]\n   287\t    ok = True\n   288\t    print('verdicts')\n   289\t    for name, got, want in cases:\n   290\t        ok &= expect(f'{name} -> {want}', got == want, got)\n   291\t    refusals = {\n   292\t        '\"false\" as a string': clean_readings({f'B/control-1:8807|{d}|e393': {'class': 'unsupported', 'valid_support': 'false'} for d in (1, 2, 3)}),\n   293\t        'omitted with valid support': clean_readings({f'B/control-1:8807|{d}|e393': {'class': 'omitted', 'valid_support': True} for d in (1, 2, 3)}),\n   294\t        'harms on a comparison not read': clean_readings({f'C/{first_c}': {'read': False, 'harms': [{'kind': 'a', 'status': 'confirmed'}]}}),\n   295\t        'a reading of a missing answer': clean_readings(),\n   296\t        'a reading of no planned target': clean_readings({'B/old-2:591|1|e000': {'class': 'intended', 'valid_support': True}}),\n   297\t    }\n   298\t    for name, readings in refusals.items():\n   299\t        answers = missing_two if name == 'a reading of a missing answer' else clean_answers()\n   300\t        try:\n   301\t            verdict_of(answers, readings)\n   302\t            refused = False\n   303\t        except ValueError:\n   304\t            refused = True\n   305\t        ok &= expect(f'readings refused: {name}', refused)\n   306\t    return ok\n   307\t\n   308\t\n   309\tdef check_equivalence():\n   310\t    \"\"\"check_at_request equals judging.check_answer on a ledger whose state is known, and on the planned requests' stored answers.\"\"\"\n   311\t    import test_theme_block as fixtures\n   312\t    ok = True\n   313\t    print('checks')\n   314\t    with tempfile.TemporaryDirectory() as scratch:\n   315\t        conn = fixtures.ledger(Path(scratch))\n   316\t        fixtures.judged(conn, 'v2', 1, 'theme judged', 2)\n   317\t        conn.commit()\n   318\t        _, user, lists = judging.request_parts(conn, 'v1', 'judging-v12')\n   319\t        base = {'rung': 2, 'reference': 'r', 'implied_outcome': 'o', 'reasons': 'x', 'cites': ['e1'], 'cites_views': [], 'pushes': [], 'changed': True,\n   320\t                'why_changed': 'w', 'theme_pushes': [{'view_id': 'v2', 'push': 'none'}]}\n   321\t        variants = [base, dict(base, rung=9), dict(base, changed=False), dict(base, reference=''), dict(base, cites=['e9']),\n   322\t                    dict(base, theme_pushes=[{'view_id': 'v2', 'push': 'none'}] * 2), dict(base, cites_views=['v3'])]\n   323\t        for data in variants:\n   324\t            ok &= expect(f'equal on {json.dumps({k: data[k] for k in data if data[k] != base.get(k)})}',\n   325\t                         probe.check_at_request(data, user, lists) == judging.check_answer(conn, 'v1', data, user, lists))\n   326\t        fixtures.judged(conn, 'v1', 3, 'first', 3)\n   327\t        conn.commit()\n   328\t        _, user, lists = judging.request_parts(conn, 'v1', 'judging-v12')\n   329\t        for data in (dict(base, rung=2, changed=False), dict(base, rung=3, changed=False)):\n   330\t            ok &= expect(f'equal with a previous conclusion, rung {data[\"rung\"]} changed false',\n   331\t                         probe.check_at_request(data, user, lists) == judging.check_answer(conn, 'v1', data, user, lists))\n   332\t    stored_ok = all(not probe.check_at_request(json.loads(i['stored answer']), i['user'], i['lists']) for i in PLAN['matched'])\n   333\t    ok &= expect('every planned matched request\\'s stored committed answer passes (linked-1 8834 included)', stored_ok)\n   334\t    bad = [i for i in PLAN['refused'] if not all(any(b in e for e in probe.check_at_request(json.loads(i['stored answer']), i['user'], i['lists'])) for b in i['bad ids'] if b in json.dumps(json.loads(i['stored answer'])))]\n   335\t    ok &= expect('every planned refused request\\'s stored answer is refused on its bad ids', not bad, str([probe.key_of(i) for i in bad]))\n   336\t    return ok\n   337\t\n   338\t\n   339\tdef main(out, scenario):\n   340\t    if out.exists():\n   341\t        raise SystemExit(f'{out} exists: a rehearsal starts from an empty folder')\n   342\t    out.mkdir(parents=True)\n   343\t    names = ['clean', 'format-invalid', 'a1-400', 'a1-timeout', '5xx-then-ok', 'low-ceiling', 'retry-exhausts', 'a2-stop', 'mutant-open-b', 'mutant-order'] if scenario == 'all' else [scenario]\n   344\t    ok = True\n   345\t    if scenario in ('all', 'checks'):\n   346\t        ok &= check_equivalence()\n   347\t    if scenario in ('all', 'verdicts'):\n   348\t        ok &= verdict_cases()\n   349\t    for name in names:\n   350\t        if name in ('checks', 'verdicts'):\n   351\t            continue\n   352\t        ok &= scenario_checks(out, name)\n   353\t    print('REHEARSAL', 'PASS' if ok else 'FAIL')\n   354\t    sys.exit(0 if ok else 1)\nchecks\n  [ok] equal on {}\n  [ok] equal on {\"rung\": 9}\n  [ok] equal on {\"changed\": false}\n  [ok] equal on {\"reference\": \"\"}\n  [ok] equal on {\"cites\": [\"e9\"]}\n  [ok] equal on {\"theme_pushes\": [{\"view_id\": \"v2\", \"push\": \"none\"}, {\"view_id\": \"v2\", \"push\": \"none\"}]}\n  [ok] equal on {\"cites_views\": [\"v3\"]}\n  [ok] equal with a previous conclusion, rung 2 changed false\n  [ok] equal with a previous conclusion, rung 3 changed false\n  [ok] every planned matched request's stored committed answer passes (linked-1 8834 included)\n  [ok] every planned refused request's stored answer is refused on its bad ids\nverdicts\n  [ok] clean set -> pass\n  [ok] 8938 85.4% unsupported in three draws -> inconclusive (unresolved)\n  [ok] 8807 $393B unsupported in three draws -> not ready\n  [ok] three misattributions -> not ready\n  [ok] 8807 two wrong, one omitted -> not ready\n  [ok] 8807 one unsupported, two missing -> inconclusive (incomplete)\n  [ok] A1 rejected -> not ready (format)\n  [ok] A1 timed out -> inconclusive (incomplete)\n  [ok] misattribution excess with Part C incomplete -> not ready\n  [ok] unresolved Part C difference, all else clean -> inconclusive (unresolved)\n  [ok] A2 skipped -> pass\n  [ok] A2 rejected -> pass\n  [ok] a refused v12 answer -> not ready\n  [ok] a ledger stop in the core run -> inconclusive (incomplete)\n  [ok] a Part C control with no content -> inconclusive (incomplete)\n  [ok] a Part C control answering {} -> inconclusive (incomplete)\n  [ok] a readable v7 control the request-time check refuses still counts -> pass\n  [ok] readings refused: \"false\" as a string\n  [ok] readings refused: omitted with valid support\n  [ok] readings refused: harms on a comparison not read\n  [ok] readings refused: a reading of a missing answer\n  [ok] readings refused: a reading of no planned target\nclean\n  [ok] no request problem\n  [ok] 2 + 48 + 72 + A2 answers\n  [ok] three fresh calls per planned request and format\n  [ok] every answer answered and passing the request-time check\n  [ok] records carry provider attempts and charges\nPart B: 51 target readings; Part C: 12 comparisons\n  [ok] the 8938 packet flags the one answer that drops 85.4\n  [ok] Part C quotes are not cut\n  [ok] the clean run verdict is pass\nformat-invalid\n  [ok] the format-invalid answer takes the SchemaError path\n  [ok] verdict not ready\na1-400\n  [ok] A1 recorded as a 400\n  [ok] nothing after A1 is sent\n  [ok] verdict not ready (format)\na1-timeout\n  [ok] A1 a transport error without a status, after three attempts\n  [ok] nothing after A1 is sent\n  [ok] verdict inconclusive (incomplete)\n5xx-then-ok\n  [ok] A0 answered after a 503 retry, the failed attempt charged\nlow-ceiling\n  [ok] the first Part C comparison is not started\n  [ok] verdict inconclusive (incomplete)\nretry-exhausts\n  [ok] the admitted comparison is interrupted by the refused retry reservation\n  [ok] verdict inconclusive (incomplete)\na2-stop\n  [ok] the ledger stopped during A2, the core ledger did not\n  [ok] a stop during A2 leaves the core verdict pass\nmutant-open-b\n  [ok] the byte check catches mutant-open-b\nmutant-order\n  [ok] the byte check catches mutant-order\nREHEARSAL PASS\nexit 0\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_6","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba PROBE-DESIGN.md | sed -n '143,225p'; rg -n 'D71[567]|preflight' ../../DECISIONS-log.md | tail -12; ls -lt | head -22\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba PROBE-DESIGN.md | sed -n '143,225p'; rg -n 'D71[567]|preflight' ../../DECISIONS-log.md | tail -12; ls -lt | head -22\"","aggregated_output":"   143\t\n   144\t### Outcome (registered; proposed tolerances for this probe, not historical rates)\n   145\tOne verdict, taken from the first rule that applies:\n   146\t1. **Not ready (format):** A1 or A0 is rejected or returns a format-invalid answer.\n   147\t2. **Not ready (confirmed failure):** any of\n   148\t   - a v12 answer refused by the request-time check;\n   149\t   - more than 2 of 48 Part B answers with a confirmed misattribution;\n   150\t   - a confirmed material loss in Part B;\n   151\t   - a confirmed material harm in Part C.\n   152\t\n   153\t   A confirmed failure stands even when the run is incomplete.\n   154\t3. **Inconclusive (incomplete):** a budget stop; A1 or A0 without a result (a transport failure or timeout, as opposed to a format\n   155\t   rejection); a missing Part B answer; or a Part C comparison not started or interrupted.\n   156\t4. **Inconclusive (unresolved):** an unresolved material loss in Part B, or an unresolved Part C difference that would be material if\n   157\t   confirmed.\n   158\t5. **Pass (\"ready to propose adoption\"):** otherwise.\n   159\t\n   160\tA2, sent, skipped or rejected, never changes the verdict; it is reported. The conditions behind these rules:\n   161\t- **Pass,** when every condition holds:\n   162\t  - Q1: A1 and A0 return 200 with format-valid answers;\n   163\t  - all 48 Part B answers and all 12 Part C comparisons (72 answers) are complete;\n   164\t  - no v12 answer is refused by the request-time check;\n   165\t  - in Part B, at most 2 of 48 answers have a confirmed misattribution (an answer counts once), with the number of requests affected\n   166\t    and any repetition reported;\n   167\t  - no confirmed material loss in Part B: a material target whose three draws were all received and read, none with valid support\n   168\t    (whatever each draw's class), which the stored accepted v7 answer to the same request stated and supported;\n   169\t  - no confirmed material harm in Part C.\n   170\t- **Inconclusive:**\n   171\t  - a budget stop, a missing answer, a comparison not started or interrupted;\n   172\t  - an unresolved material loss in Part B: a material target whose three draws were all received and read, none with valid support,\n   173\t    where no stored accepted v7 answer to that request kept it, as in control-1's 8938, whose retry also dropped 85.4%;\n   174\t  - an unresolved Part C difference that would be material if confirmed.\n   175\t\n   176\tThe outcome is computed by code (`probe_read.py`) from the read classes; the rehearsal exercises it (§4).\n   177\t- **Not ready:** any other failure of the pass conditions, with its reason.\n   178\t- Every outcome goes to Alex; adoption is his decision.\n   179\t\n   180\t## 4. Harness and the $0 rehearsal before the send\n   181\t\n   182\t`probe.py`, harness-only:\n   183\t- it reads `probe-plan.json` and builds each request with `model.build_request`, from poc-v121's setting and v12's format (or v7's\n   184\t  for the control);\n   185\t- it sends through `budget_replay.BudgetTransport` on a ledger at $0.50, in the order and under the start rule of §2;\n   186\t- each answer goes through `model.call`'s format check and the request-time check;\n   187\t- each answer is written to `probe-answers.jsonl` with its part, request, format, draw, the request sha, the cost and the transport's\n   188\t  call number.\n   189\t- `probe_read.py` builds the reading packets:\n   190\t  - Part B by target, with marker flags;\n   191\t  - Part C by comparison: all six answers in full, the quote of every source any of them cites (shared ones included), and the\n   192\t    symmetric-difference sources marked.\n   193\t- `probe_read.py` also computes the one verdict of §3 from the read classes.\n   194\t\n   195\t**The $0 rehearsal** uses the real budget transport with the provider stubbed underneath (`model.openai_transport` replaced), on a\n   196\tledger file of its own. It must show:\n   197\t- every scheduled send reaches the stub, with a count equal to the plan: 2 + 1 for A, 48 for B, 72 for C;\n   198\t- each request's bytes: system and user equal the stored ones, the format strict and equal to `schema_for('judging-v12', lists)` (or\n   199\t  v7's), the model settings as poc-v121's;\n   200\t- three fresh stub calls per draw set;\n   201\t- the request-time check equals `check_answer` on a ledger fixture whose state is known, accepts every stored committed answer of the\n   202\t  planned requests, and refuses the stored refused ones on their ids;\n   203\t- the stub's valid answer, a format-invalid answer, an HTTP 400 and a 5xx followed by success each take their path;\n   204\t- only one Part C comparison runs at a time;\n   205\t- a ceiling set low blocks a Part C start, and the outcome is \"inconclusive\", never \"pass\";\n   206\t- a retry exhausts the remaining headroom inside an admitted comparison, which stops it; the outcome is \"inconclusive\";\n   207\t- the outcome code's verdicts:\n   208\t  - three Part B answers for control-1's 8938 that state 85.4% with no source are an unresolved material loss, so \"inconclusive\"\n   209\t    (8938 has no stored accepted v7 answer);\n   210\t  - three answers for control-1's 8807 that state the $393 billion reference with no source are a confirmed material loss, so \"not\n   211\t    ready\" (its stored accepted retry 8809 cites e195 and e669);\n   212\t  - three misattributions are \"not ready\";\n   213\t  - for 8807, two draws giving the $393 billion reference with a wrong source and a third omitting it: within the misattribution\n   214\t    tolerance, but a confirmed material loss, so \"not ready\";\n   215\t  - A1 timing out after the transport's retries is \"inconclusive (incomplete)\", told apart from an explicit format rejection;\n   216\t  - for 8807, one unsupported draw and two draws missing after a budget stop: no material loss can be declared, so \"inconclusive\";\n   217\t  - a clean set is \"pass\";\n   218\t  - an A1 rejection is \"not ready (format)\", even though it also leaves an answer missing;\n   219\t  - a confirmed misattribution excess with Part C incomplete is \"not ready\";\n   220\t  - an unresolved material Part C difference with everything else clean is \"inconclusive\";\n   221\t  - A2 skipped, and A2 rejected, each leave a clean core \"pass\";\n   222\t- the Part B packet for 8938 flags a stub answer that drops \"85.4\".\n   223\t\n   224\tA mutant, Part B sent with the open format, is caught by the byte check.\n8826:- Before any paid launch, `scripts/preflight.py` is run as AGENTS §5 requires.\n9451:    article list; the full exposure census; the frozen verdict rule; the reading instruments; preflight;\n10490:  31.2% of their reservations; preflight; price about $0.085 for six sequences; the reading rule frozen (`reading-rule.md`).\n10528:  the gate, July samples not reused, no completeness proof, launcher and ceiling gaps, preflight), round 14 NOT READY (the scorer could\n10529:  pass with no draws and ignored the sign; the registration ruled out links the criterion permits; preflight covered only July),\n10535:  completeness check and the scorer each catch their mutants; full-window preflight recorded; the registered reading of the 105 pairs\n10710:  - 38, NOT READY: the format-error path; preflight; the D358 sizes (the sealed run's 647-id request needs 1,323 plain enum values);\n10712:  - 38b, NOT READY: two owners of membership (a footnote in a quote makes the text parser narrow the list); preflight for judge rows\n10714:  - 38c, NOT READY: T1 must compare the lists' ids; a real v12 retry test; preflight must fail on a missing format.\n10728:  - preflight: part A on saved judge formats, and an exit on a missing one;\n10756:## D715 · 2026-11-22 · Alex approves $0.50 for the paid acceptance step of judging-v12\n10765:## D716 · 2026-11-22 · Council R passes the paid acceptance probe's design (round 40, six passes); the harness and its $0 rehearsal next\ntotal 13648\n-rw-r--r--@ 1 lchingen  staff     1232 Nov 22 00:57 codex-r41c.stream\n-rw-r--r--@ 1 lchingen  staff        0 Nov 22 00:57 codex-r41c.md\n-rw-r--r--@ 1 lchingen  staff     1402 Nov 22 00:57 round41c-brief.md\n-rw-r--r--@ 1 lchingen  staff     3143 Nov 22 00:56 rehearsal.log\n-rw-r--r--@ 1 lchingen  staff    23329 Nov 22 00:56 probe_rehearsal.py\n-rw-r--r--@ 1 lchingen  staff    13225 Nov 22 00:54 probe_read.py\n-rw-r--r--@ 1 lchingen  staff     1952 Nov 22 00:54 codex-r41b.md\n-rw-r--r--@ 1 lchingen  staff    92898 Nov 22 00:54 codex-r41b.stream\n-rw-r--r--@ 1 lchingen  staff     1442 Nov 22 00:53 round41b-brief.md\n-rw-r--r--@ 1 lchingen  staff    12414 Nov 22 00:51 probe.py\n-rw-r--r--@ 1 lchingen  staff     2756 Nov 22 00:50 codex-r41.md\n-rw-r--r--@ 1 lchingen  staff   162414 Nov 22 00:50 codex-r41.stream\n-rw-r--r--@ 1 lchingen  staff     1650 Nov 22 00:49 round41-brief.md\n-rw-r--r--@ 1 lchingen  staff      900 Nov 22 00:45 stored-v7-support.json\n-rw-r--r--@ 1 lchingen  staff       26 Nov 22 00:43 codex-r40f.md\n-rw-r--r--@ 1 lchingen  staff     8796 Nov 22 00:43 codex-r40f.stream\n-rw-r--r--@ 1 lchingen  staff      363 Nov 22 00:43 round40f-brief.md\n-rw-r--r--@ 1 lchingen  staff    14912 Nov 22 00:43 PROBE-DESIGN.md\n-rw-r--r--@ 1 lchingen  staff      683 Nov 22 00:43 codex-r40e.md\n-rw-r--r--@ 1 lchingen  staff    21477 Nov 22 00:43 codex-r40e.stream\n-rw-r--r--@ 1 lchingen  staff      591 Nov 22 00:42 round40e-brief.md\n","exit_code":0,"status":"completed"}}
