{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"rg -n 'Quote:|Evidence in view|Themes in force' ../../../src/hivemind/views/judging.py; sed -n '182,226p' ../../../src/hivemind/model.py; nl -ba probe_rehearsal.py | sed -n '194,354p'; sed -n '10775,10818p' ../../DECISIONS-log.md\"","aggregated_output":"176:             f'[Evidence in view under this thesis, {len(pieces)} items]']\n181:        lines.append(f'- {p[\"evidence_id\"]} [{p[\"tier\"]}; {p[\"speaker\"]}; original source {p[\"original_who\"]} {p[\"original_day\"]}; from {src.get(\"input_id\")} {src.get(\"publication_day\")}] {p[\"one_line\"]}\\n    Quote: {p[\"quote\"][:400]}')\n204:        lines.append(f'\\n[Themes in force, {len(themes)}]')\n249:    block = request_text.split('\\n[Themes in force, ', 1)\n\n\ndef check_schema(value, schema, path='$', root=None):\n    \"\"\"A small validator for the subset of JSON Schema the prompts use: object/required/additionalProperties,\n    array/items/minItems/maxItems, string/enum/pattern, integer, number, boolean, null in anyOf, and $ref into the root's $defs.\"\"\"\n    root = root if root is not None else schema\n    if '$ref' in schema:\n        name = schema['$ref'].rsplit('/', 1)[1]\n        schema = root['$defs'][name]\n    kind = schema.get('type')\n    if 'anyOf' in schema:\n        # a value matching no option reports the closest options' errors (fewest), not merely the last option's\n        failures = []\n        for option in schema['anyOf']:\n            errors = check_schema(value, option, path, root)\n            if not errors:\n                return []\n            failures.append(errors)\n        fewest = min((len(errors) for errors in failures), default=0)\n        closest = list(dict.fromkeys(error for errors in failures if len(errors) == fewest for error in errors))\n        return closest or [f'{path}: matches no option']\n    if kind == 'object':\n        if not isinstance(value, dict):\n            return [f'{path}: expected object']\n        errors = []\n        for name in schema.get('required', []):\n            if name not in value:\n                errors.append(f'{path}.{name}: required')\n        properties = schema.get('properties', {})\n        for name, item in value.items():\n            if name in properties:\n                errors.extend(check_schema(item, properties[name], f'{path}.{name}', root))\n            elif schema.get('additionalProperties') is False:\n                errors.append(f'{path}.{name}: not allowed')\n        return errors\n    if kind == 'array':\n        if not isinstance(value, list):\n            return [f'{path}: expected array']\n        errors = []\n        if len(value) < schema.get('minItems', 0):\n            errors.append(f'{path}: fewer than {schema[\"minItems\"]} items')\n        if 'maxItems' in schema and len(value) > schema['maxItems']:\n            errors.append(f'{path}: more than {schema[\"maxItems\"]} items')\n        for index, item in enumerate(value):\n            errors.extend(check_schema(item, schema.get('items', {}), f'{path}[{index}]', root))\n   194\t\n   195\tdef verdict_of(answers, readings, summary=None):\n   196\t    return probe_read.verdict(answers, readings, PLAN, TARGETS, STORED, summary or {'ledger': {'stopped': False}})\n   197\t\n   198\t\n   199\tdef scenario_checks(out, scenario):\n   200\t    summary, stub, answers = run(out / scenario, scenario)\n   201\t    ok = True\n   202\t    print(scenario)\n   203\t    if scenario == 'clean':\n   204\t        ok &= expect('no request problem', not stub.problems, str(stub.problems[:3]))\n   205\t        ok &= expect('2 + 48 + 72 + A2 answers', sum(1 for a in answers.values() if a['part'] in ('A1', 'A0')) == 2 and\n   206\t                     sum(1 for a in answers.values() if a['part'] == 'B') == 48 and sum(1 for a in answers.values() if a['part'] == 'C') == 72 and summary['A2'] == 'answered')\n   207\t        ok &= expect('three fresh calls per planned request and format', all(v == 3 for (k, f), v in stub.calls.items()\n   208\t                     if not k.startswith(('old-1:5652', 'old-3:69', 'sealed')) and f is not None), str({k: v for k, v in stub.calls.items() if v != 3}))\n   209\t        ok &= expect('every answer answered and passing the request-time check', all(a['status'] == 'answered' and not a['check'] and not a['cached'] for a in answers.values()))\n   210\t        ok &= expect('records carry provider attempts and charges', all('provider_attempts' in a and 'charged_usd' in a for a in answers.values())\n   211\t                     and sum(a['provider_attempts'] for a in answers.values()) == 123)\n   212\t        probe_read.packets(out / scenario)\n   213\t        packet = json.loads((out / scenario / 'packet-B.json').read_text())\n   214\t        flagged = [e for e in packet if e['id'].startswith('control-1:8938|') and e['id'].endswith('|e362') and '85.4' in e['markers not found']]\n   215\t        ok &= expect('the 8938 packet flags the one answer that drops 85.4', len(flagged) == 1)\n   216\t        packet_c = json.loads((out / scenario / 'packet-C.json').read_text())\n   217\t        ok &= expect('Part C quotes are not cut', all(len(q) == len(probe_read.entries(BY_KEY[c['key']]['user']).get(e, '(not listed)')) for c in packet_c for e, q in c['quotes'].items()))\n   218\t        ok &= expect('the clean run verdict is pass', verdict_of(answers, clean_readings(answers=answers), summary)[0] == 'pass')\n   219\t    elif scenario == 'format-invalid':\n   220\t        ok &= expect('the format-invalid answer takes the SchemaError path', answers[('B', 'old-2:591', 'v12', 1)]['status'] == 'format invalid')\n   221\t        ok &= expect('verdict not ready', verdict_of(answers, clean_readings(answers=answers), summary)[0] == 'not ready')\n   222\t    elif scenario == 'a1-400':\n   223\t        ok &= expect('A1 recorded as a 400', answers[('A1', 'old-1:5652', 'v12', 1)].get('http_status') == 400)\n   224\t        ok &= expect('nothing after A1 is sent', set(a['part'] for a in answers.values()) == {'A1'} and set(k for k, f in stub.calls) == {'old-1:5652'})\n   225\t    elif scenario == 'a1-timeout':\n   226\t        line = answers[('A1', 'old-1:5652', 'v12', 1)]\n   227\t        ok &= expect('A1 a transport error without a status, after three attempts', line['status'] == 'transport error' and line.get('http_status') is None\n   228\t                     and stub.calls[('old-1:5652', 'v12')] == 3 and line.get('provider_attempts') == 3)\n   229\t        ok &= expect('nothing after A1 is sent', set(a['part'] for a in answers.values()) == {'A1'})\n   230\t    elif scenario == '5xx-then-ok':\n   231\t        line = answers[('A0', 'old-3:69', 'v12', 1)]\n   232\t        ok &= expect('A0 answered after a 503 retry, the failed attempt charged', line['status'] == 'answered' and stub.calls[('old-3:69', 'v12')] == 2\n   233\t                     and line['provider_attempts'] == 2 and line['charged_usd'] > 0.001)\n   234\t    elif scenario == 'low-ceiling':\n   235\t        ok &= expect('the first Part C comparison is not started', summary['not started'] and summary['not started'][0]['key'] == probe.key_of(PLAN['matched'][0]))\n   236\t    elif scenario == 'retry-exhausts':\n   237\t        ok &= expect('the admitted comparison is interrupted by the refused retry reservation', summary['interrupted'] == [probe.key_of(PLAN['matched'][0])]\n   238\t                     and summary['ledger']['stopped'])\n   239\t    elif scenario == 'a2-stop':\n   240\t        ok &= expect('the ledger stopped during A2, the core ledger did not', summary['ledger']['stopped'] and not summary['core ledger']['stopped'])\n   241\t        ok &= expect('a stop during A2 leaves the core verdict pass', verdict_of(answers, clean_readings(answers=answers), summary)[0] == 'pass')\n   242\t    elif scenario in ('mutant-open-b', 'mutant-order'):\n   243\t        ok &= expect(f'the byte check catches {scenario}', any('not the planned request for part B' in p for p in stub.problems))\n   244\t    if scenario in ('low-ceiling', 'retry-exhausts', 'a1-timeout', 'a1-400'):\n   245\t        expected = 'not ready (format)' if scenario == 'a1-400' else 'inconclusive (incomplete)'\n   246\t        result = verdict_of(answers, clean_readings(answers=answers), summary)\n   247\t        ok &= expect(f'verdict {expected}', result[0] == expected, str(result))\n   248\t    return ok\n   249\t\n   250\t\n   251\tdef verdict_cases():\n   252\t    v = lambda answers, overrides=None, summary=None: verdict_of(answers, clean_readings(overrides, answers), summary)[0]\n   253\t    unsupported = lambda key, bad: {f'B/{key}|{d}|{bad}': {'class': 'unsupported', 'valid_support': False} for d in (1, 2, 3)}\n   254\t    misattributed = {f'B/old-2:591|{d}|e88': {'class': 'misattributed', 'valid_support': True} for d in (1, 2, 3)}\n   255\t    two_wrong_one_omitted = {'B/control-1:8807|1|e393': {'class': 'misattributed', 'valid_support': False},\n   256\t                             'B/control-1:8807|2|e393': {'class': 'misattributed', 'valid_support': False},\n   257\t                             'B/control-1:8807|3|e393': {'class': 'omitted', 'valid_support': False}}\n   258\t    variant = lambda changes: dict(clean_answers(), **{}) if not changes else {**clean_answers(), **changes}\n   259\t    first_c = probe.key_of(PLAN['matched'][0])\n   260\t    missing_two = clean_answers()\n   261\t    for d in (2, 3):\n   262\t        missing_two.pop(('B', 'control-1:8807', 'v12', d))\n   263\t    c_incomplete = clean_answers()\n   264\t    c_incomplete.pop(('C', probe.key_of(PLAN['matched'][-1]), 'v7', 3))\n   265\t    a2_skipped = clean_answers()\n   266\t    a2_skipped.pop(('A2', 'sealed-D358:6918', 'v12', 1))\n   267\t    line = lambda part, key, form, draw, **fields: {(part, key, form, draw): dict({'part': part, 'key': key, 'form': form, 'draw': draw}, **fields)}\n   268\t    cases = [\n   269\t        ('clean set', v(clean_answers()), 'pass'),\n   270\t        ('8938 85.4% unsupported in three draws', v(clean_answers(), unsupported('control-1:8938', 'e362')), 'inconclusive (unresolved)'),\n   271\t        ('8807 $393B unsupported in three draws', v(clean_answers(), unsupported('control-1:8807', 'e393')), 'not ready'),\n   272\t        ('three misattributions', v(clean_answers(), misattributed), 'not ready'),\n   273\t        ('8807 two wrong, one omitted', v(clean_answers(), two_wrong_one_omitted), 'not ready'),\n   274\t        ('8807 one unsupported, two missing', v(missing_two, {'B/control-1:8807|1|e393': {'class': 'unsupported', 'valid_support': False}}), 'inconclusive (incomplete)'),\n   275\t        ('A1 rejected', v(variant(line('A1', 'old-1:5652', 'v12', 1, status='transport error', http_status=400, error='HTTP 400'))), 'not ready (format)'),\n   276\t        ('A1 timed out', v(variant(line('A1', 'old-1:5652', 'v12', 1, status='transport error', http_status=None))), 'inconclusive (incomplete)'),\n   277\t        ('misattribution excess with Part C incomplete', v(c_incomplete, misattributed), 'not ready'),\n   278\t        ('unresolved Part C difference, all else clean', v(clean_answers(), {f'C/{first_c}': {'read': True, 'harms': [{'kind': 'a', 'status': 'unresolved'}]}}), 'inconclusive (unresolved)'),\n   279\t        ('A2 skipped', v(a2_skipped), 'pass'),\n   280\t        ('A2 rejected', v(variant(line('A2', 'sealed-D358:6918', 'v12', 1, status='transport error', http_status=400))), 'pass'),\n   281\t        ('a refused v12 answer', v(variant(line('B', 'old-2:591', 'v12', 1, status='answered', check=['x'], data=valid_answer(BY_KEY['old-2:591'])))), 'not ready'),\n   282\t        ('a ledger stop in the core run', v(clean_answers(), None, {'core ledger': {'stopped': True, 'stop_reason': 'ceiling'}}), 'inconclusive (incomplete)'),\n   283\t        ('a Part C control with no content', v(variant(line('C', first_c, 'v7', 1, status='format invalid', data=None))), 'inconclusive (incomplete)'),\n   284\t        ('a Part C control answering {}', v(variant(line('C', first_c, 'v7', 1, status='answered', check=[], data={}))), 'inconclusive (incomplete)'),\n   285\t        ('a readable v7 control the request-time check refuses still counts', v(variant(line('C', first_c, 'v7', 1, status='answered', check=['x'], data=valid_answer(BY_KEY[first_c])))), 'pass'),\n   286\t    ]\n   287\t    ok = True\n   288\t    print('verdicts')\n   289\t    for name, got, want in cases:\n   290\t        ok &= expect(f'{name} -> {want}', got == want, got)\n   291\t    refusals = {\n   292\t        '\"false\" as a string': clean_readings({f'B/control-1:8807|{d}|e393': {'class': 'unsupported', 'valid_support': 'false'} for d in (1, 2, 3)}),\n   293\t        'omitted with valid support': clean_readings({f'B/control-1:8807|{d}|e393': {'class': 'omitted', 'valid_support': True} for d in (1, 2, 3)}),\n   294\t        'harms on a comparison not read': clean_readings({f'C/{first_c}': {'read': False, 'harms': [{'kind': 'a', 'status': 'confirmed'}]}}),\n   295\t        'a reading of a missing answer': clean_readings(),\n   296\t        'a reading of no planned target': clean_readings({'B/old-2:591|1|e000': {'class': 'intended', 'valid_support': True}}),\n   297\t    }\n   298\t    for name, readings in refusals.items():\n   299\t        answers = missing_two if name == 'a reading of a missing answer' else clean_answers()\n   300\t        try:\n   301\t            verdict_of(answers, readings)\n   302\t            refused = False\n   303\t        except ValueError:\n   304\t            refused = True\n   305\t        ok &= expect(f'readings refused: {name}', refused)\n   306\t    return ok\n   307\t\n   308\t\n   309\tdef check_equivalence():\n   310\t    \"\"\"check_at_request equals judging.check_answer on a ledger whose state is known, and on the planned requests' stored answers.\"\"\"\n   311\t    import test_theme_block as fixtures\n   312\t    ok = True\n   313\t    print('checks')\n   314\t    with tempfile.TemporaryDirectory() as scratch:\n   315\t        conn = fixtures.ledger(Path(scratch))\n   316\t        fixtures.judged(conn, 'v2', 1, 'theme judged', 2)\n   317\t        conn.commit()\n   318\t        _, user, lists = judging.request_parts(conn, 'v1', 'judging-v12')\n   319\t        base = {'rung': 2, 'reference': 'r', 'implied_outcome': 'o', 'reasons': 'x', 'cites': ['e1'], 'cites_views': [], 'pushes': [], 'changed': True,\n   320\t                'why_changed': 'w', 'theme_pushes': [{'view_id': 'v2', 'push': 'none'}]}\n   321\t        variants = [base, dict(base, rung=9), dict(base, changed=False), dict(base, reference=''), dict(base, cites=['e9']),\n   322\t                    dict(base, theme_pushes=[{'view_id': 'v2', 'push': 'none'}] * 2), dict(base, cites_views=['v3'])]\n   323\t        for data in variants:\n   324\t            ok &= expect(f'equal on {json.dumps({k: data[k] for k in data if data[k] != base.get(k)})}',\n   325\t                         probe.check_at_request(data, user, lists) == judging.check_answer(conn, 'v1', data, user, lists))\n   326\t        fixtures.judged(conn, 'v1', 3, 'first', 3)\n   327\t        conn.commit()\n   328\t        _, user, lists = judging.request_parts(conn, 'v1', 'judging-v12')\n   329\t        for data in (dict(base, rung=2, changed=False), dict(base, rung=3, changed=False)):\n   330\t            ok &= expect(f'equal with a previous conclusion, rung {data[\"rung\"]} changed false',\n   331\t                         probe.check_at_request(data, user, lists) == judging.check_answer(conn, 'v1', data, user, lists))\n   332\t    stored_ok = all(not probe.check_at_request(json.loads(i['stored answer']), i['user'], i['lists']) for i in PLAN['matched'])\n   333\t    ok &= expect('every planned matched request\\'s stored committed answer passes (linked-1 8834 included)', stored_ok)\n   334\t    bad = [i for i in PLAN['refused'] if not all(any(b in e for e in probe.check_at_request(json.loads(i['stored answer']), i['user'], i['lists'])) for b in i['bad ids'] if b in json.dumps(json.loads(i['stored answer'])))]\n   335\t    ok &= expect('every planned refused request\\'s stored answer is refused on its bad ids', not bad, str([probe.key_of(i) for i in bad]))\n   336\t    return ok\n   337\t\n   338\t\n   339\tdef main(out, scenario):\n   340\t    if out.exists():\n   341\t        raise SystemExit(f'{out} exists: a rehearsal starts from an empty folder')\n   342\t    out.mkdir(parents=True)\n   343\t    names = ['clean', 'format-invalid', 'a1-400', 'a1-timeout', '5xx-then-ok', 'low-ceiling', 'retry-exhausts', 'a2-stop', 'mutant-open-b', 'mutant-order'] if scenario == 'all' else [scenario]\n   344\t    ok = True\n   345\t    if scenario in ('all', 'checks'):\n   346\t        ok &= check_equivalence()\n   347\t    if scenario in ('all', 'verdicts'):\n   348\t        ok &= verdict_cases()\n   349\t    for name in names:\n   350\t        if name in ('checks', 'verdicts'):\n   351\t            continue\n   352\t        ok &= scenario_checks(out, name)\n   353\t    print('REHEARSAL', 'PASS' if ok else 'FAIL')\n   354\t    sys.exit(0 if ok else 1)\n    most 2 of 48 confirmed misattributions, no confirmed material loss (three draws received and read, none with valid support, where\n    the stored accepted v7 answer had it), and no confirmed material harm in Part C.\n  - **Expected spend:** $0.35. At 130% of stored costs, 10 of 12 comparisons start, giving inconclusive.\n- **Council** (`codex-r40.md` … `codex-r40f.md`): 40 to 40e NOT READY, each finding taken; 40f READY TO BUILD THE HARNESS.\n- **Found while freezing the targets:** most refused ids are real evidence ids. Two (e88, e2769) are unlisted ids that the frozen\n  request itself names in \"same claim as …\" notes, which is a latent invitation. e393 is the $393 billion reference written as an id.\n  Recorded as a finding; the frozen request is not changed.\n","exit_code":0,"status":"completed"}}
