{"type":"item.started","item":{"id":"item_4","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba probe_read.py | sed -n '20,135p;150,210p'; rg -n 'quote|ambiguous|def check_equivalence|def verdict_cases' probe_rehearsal.py; cat rehearsal.log\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba probe_read.py | sed -n '20,135p;150,210p'; rg -n 'quote|ambiguous|def check_equivalence|def verdict_cases' probe_rehearsal.py; cat rehearsal.log\"","aggregated_output":"    20\tHERE = Path(__file__).resolve().parent\n    21\tPLAN, TARGETS, STORED_V7 = HERE / 'probe-plan.json', HERE / 'probe-targets.json', HERE / 'stored-v7-support.json'\n    22\tMISATTRIBUTION_TOLERANCE = 2\n    23\tCLASSES = {'intended', 'unsupported', 'misattributed', 'omitted', 'correct', 'absent', 'ambiguous'}\n    24\t\n    25\t\n    26\tdef load_answers(out):\n    27\t    lines = [json.loads(line) for line in (Path(out) / 'answers.jsonl').read_text().splitlines() if line.strip()] if (Path(out) / 'answers.jsonl').exists() else []\n    28\t    return {(l['part'], l['key'], l['form'], l['draw']): l for l in lines}\n    29\t\n    30\t\n    31\tdef target_ids(target):\n    32\t    return target['bad'] if target['kind'] == 'evidence' else 'placement'\n    33\t\n    34\t\n    35\tBLOCK_HEADERS = ('[Evidence in view under this thesis', '[Not shown:', '[Current conclusions of the theses it depends on]', '[Themes in force',\n    36\t                 '[Previous conclusion', 'Answer per the JSON schema')\n    37\t\n    38\t\n    39\tdef entries(user):\n    40\t    \"\"\"Every listed entry a cited or pushed id can name, with its full text: evidence (`- eN [`), dependency and theme (`- vN (`) entries.\n    41\t    An entry runs from its own start line to the next entry start or the next block header, whatever its lines look like (a quote may\n    42\t    hold unindented lines or a line beginning with \"[\").\"\"\"\n    43\t    starts = [(m.start(), m.group(1)) for m in re.finditer(r'^- ([ev]\\d+) [\\[(]', user, re.M)]\n    44\t    stops = sorted([s for s, _ in starts] + [m.start() for h in BLOCK_HEADERS for m in re.finditer('^' + re.escape(h), user, re.M)] + [len(user)])\n    45\t    found = {}\n    46\t    for start, entry_id in starts:\n    47\t        end = next(s for s in stops if s > start)\n    48\t        found.setdefault(entry_id, user[start:end].rstrip('\\n'))\n    49\t    return found\n    50\t\n    51\t\n    52\tdef readable(data):\n    53\t    \"\"\"Content a reader can read: every field of the judge's answer, of the right type (the open v7 format's shape).\"\"\"\n    54\t    return isinstance(data, dict) and not model.check_schema(data, judging.schema_for('judging-v7'))\n    55\t\n    56\t\n    57\tdef received(line):\n    58\t    \"\"\"An answer that can be read: answered, or refused by the format, with readable content either way.\"\"\"\n    59\t    return bool(line) and line['status'] in ('answered', 'format invalid') and readable(line.get('data'))\n    60\t\n    61\t\n    62\tEVIDENCE_CLASSES = {'intended': {True}, 'unsupported': {False}, 'omitted': {False}, 'misattributed': {True, False}}\n    63\tPLACEMENT_CLASSES = {'correct': {False}, 'absent': {False}, 'misattributed': {False}}\n    64\tAMBIGUOUS = {'ambiguous': {False}}                                    # only for a target frozen as ambiguous; it never counts as support\n    65\t\n    66\t\n    67\tdef validate(readings, answers, plan, targets):\n    68\t    \"\"\"Refuses a readings file with a value outside the frozen sets, a reading of no planned or no readable answer, a class whose\n    69\t    valid_support contradicts it (omitted or unsupported with support, intended without; a placement target has no support), or a Part C\n    70\t    reading of a comparison that is not complete, or harms on a comparison not read.\"\"\"\n    71\t    kinds = {f'{r[\"key\"]}|{d}|{target_ids(t)}': t for r in targets['requests'] for t in r['targets'] for d in (1, 2, 3)}\n    72\t    for name, r in readings.get('B', {}).items():\n    73\t        if name not in kinds:\n    74\t            raise ValueError(f'Part B reading {name}: not a planned target')\n    75\t        key, draw, _ = name.split('|')\n    76\t        if not received(answers.get(('B', key, 'v12', int(draw)))):\n    77\t            raise ValueError(f'Part B reading {name}: its answer is missing or unreadable')\n    78\t        target = kinds[name]\n    79\t        allowed = dict(EVIDENCE_CLASSES if target['kind'] == 'evidence' else PLACEMENT_CLASSES, **(AMBIGUOUS if target.get('ambiguous') else {}))\n    80\t        if r.get('class') not in allowed or not isinstance(r.get('valid_support'), bool) or r['valid_support'] not in allowed[r['class']]:\n    81\t            raise ValueError(f'Part B reading {name}: class {r.get(\"class\")!r} with valid_support {r.get(\"valid_support\")!r} is not allowed')\n    82\t    matched = {f'{i[\"source\"]}:{i[\"call_id\"]}' for i in plan['matched']}\n    83\t    for name, r in readings.get('C', {}).items():\n    84\t        if name not in matched:\n    85\t            raise ValueError(f'Part C reading {name}: not a planned comparison')\n    86\t        if not isinstance(r.get('read'), bool) or any(h.get('kind') not in ('a', 'b', 'c', 'd') or h.get('status') not in ('confirmed', 'unresolved')\n    87\t                                                     for h in r.get('harms', [])):\n    88\t            raise ValueError(f'Part C reading {name} is malformed')\n    89\t        if r.get('harms') and not r['read']:\n    90\t            raise ValueError(f'Part C reading {name}: harms on a comparison not read')\n    91\t        if not all(received(answers.get(('C', name, form, d))) for form in ('v12', 'v7') for d in (1, 2, 3)):\n    92\t            raise ValueError(f'Part C reading {name}: the comparison is not complete')\n    93\t\n    94\t\n    95\tdef verdict(answers, readings, plan, targets, stored_v7, summary):\n    96\t    \"\"\"PROBE-DESIGN.md v5 §3: the first rule that applies.\"\"\"\n    97\t    validate(readings, answers, plan, targets)\n    98\t    keys = lambda items: [f'{i[\"source\"]}:{i[\"call_id\"]}' for i in items]\n    99\t    a1, a0 = keys(plan['acceptance'][:2])\n   100\t    reasons = []\n   101\t    for part, key in (('A1', a1), ('A0', a0)):\n   102\t        line = answers.get((part, key, 'v12', 1))\n   103\t        if line and (line['status'] == 'format invalid' or (line['status'] == 'transport error' and line.get('http_status') == 400)):\n   104\t            return 'not ready (format)', [f'{part} rejected: {line.get(\"error\", \"\")[:200]}']\n   105\t    v12 = [l for l in answers.values() if l['form'] == 'v12' and l['part'] != 'A2']\n   106\t    refused = [l for l in v12 if l['status'] == 'format invalid' or (l['status'] == 'answered' and l['check'])]\n   107\t    if refused:\n   108\t        reasons.append(f'{len(refused)} v12 answers refused')\n   109\t    b_reads = readings.get('B', {})\n   110\t    misattributed = {k.rsplit('|', 1)[0] for k, r in b_reads.items() if r['class'] == 'misattributed'}\n   111\t    if len(misattributed) > MISATTRIBUTION_TOLERANCE:\n   112\t        reasons.append(f'{len(misattributed)} Part B answers with a confirmed misattribution (tolerance {MISATTRIBUTION_TOLERANCE})')\n   113\t    losses, unresolved = [], []\n   114\t    for request in targets['requests']:\n   115\t        for target in request['targets']:\n   116\t            if target['kind'] != 'evidence' or not target.get('material'):\n   117\t                continue\n   118\t            draws = [b_reads.get(f'{request[\"key\"]}|{d}|{target[\"bad\"]}') for d in (1, 2, 3)]\n   119\t            all_received = all(received(answers.get(('B', request['key'], 'v12', d))) for d in (1, 2, 3))\n   120\t            if not all_received or any(r is None for r in draws):\n   121\t                continue                                                   # a loss needs all three draws received and read\n   122\t            if not any(r['valid_support'] for r in draws):\n   123\t                (losses if stored_v7['targets'].get(request['key'], {}).get('supported') else unresolved).append(f'{request[\"key\"]} {target[\"bad\"]}')\n   124\t    if losses:\n   125\t        reasons.append('confirmed material loss in Part B: ' + ', '.join(losses))\n   126\t    c_reads = readings.get('C', {})\n   127\t    harms = [f'{k} ({h[\"kind\"]})' for k, r in c_reads.items() for h in r.get('harms', []) if h['status'] == 'confirmed']\n   128\t    if harms:\n   129\t        reasons.append('confirmed material harm in Part C: ' + ', '.join(harms))\n   130\t    if reasons:\n   131\t        return 'not ready', reasons\n   132\t    incomplete = []\n   133\t    core = summary.get('core ledger', summary.get('ledger', {}))        # the ledger as the core run left it; A2 never changes the verdict\n   134\t    if core.get('stopped'):\n   135\t        incomplete.append(f'the ledger stopped: {core.get(\"stop_reason\")}')\n   150\t    for key in keys(plan['matched']):\n   151\t        complete = all(received(answers.get(('C', key, form, d))) for form in ('v12', 'v7') for d in (1, 2, 3))\n   152\t        if not complete:\n   153\t            incomplete.append(f'Part C {key} incomplete')\n   154\t        elif not c_reads.get(key, {}).get('read'):\n   155\t            incomplete.append(f'Part C {key} not read')\n   156\t    if incomplete:\n   157\t        return 'inconclusive (incomplete)', incomplete\n   158\t    unresolved += [f'{k} ({h[\"kind\"]})' for k, r in c_reads.items() for h in r.get('harms', []) if h['status'] == 'unresolved']\n   159\t    if unresolved:\n   160\t        return 'inconclusive (unresolved)', unresolved\n   161\t    return 'pass', [f'{len(misattributed)} Part B answers with a confirmed misattribution']\n   162\t\n   163\t\n   164\tdef packets(out):\n   165\t    out = Path(out)\n   166\t    plan, targets, answers = json.loads(PLAN.read_text()), json.loads(TARGETS.read_text()), load_answers(out)\n   167\t    by_key = {f'{i[\"source\"]}:{i[\"call_id\"]}': i for i in plan['refused'] + plan['matched']}\n   168\t    show = lambda l: None if not l or not readable(l.get('data')) else {k: l['data'].get(k) for k in ('rung', 'reference', 'implied_outcome', 'reasons', 'cites', 'cites_views', 'pushes', 'theme_pushes', 'changed', 'why_changed')}\n   169\t    b, blind = [], []\n   170\t    for request in targets['requests']:\n   171\t        item, listed = by_key[request['key']], entries(by_key[request['key']]['user'])\n   172\t        for d in (1, 2, 3):\n   173\t            line = answers.get(('B', request['key'], 'v12', d))\n   174\t            text = json.dumps(show(line) or {}, ensure_ascii=False)\n   175\t            for target in request['targets']:\n   176\t                flags = [m for m in target.get('markers', []) if m.lower() not in text.lower()]\n   177\t                data = (line or {}).get('data') if readable((line or {}).get('data')) else {}\n   178\t                used = set(data.get('cites') or []) | set(data.get('cites_views') or []) | {x['evidence_id'] for x in data.get('pushes') or []} | {x['view_id'] for x in data.get('theme_pushes') or []}\n   179\t                quotes = {e: listed.get(e, '(not listed)') for e in sorted(used | set(target.get('sources', []) + target.get('partial', []) + target.get('near_misses', [])))}\n   180\t                entry = {'id': f'{request[\"key\"]}|{d}|{target_ids(target)}', 'status': line['status'] if line else 'missing', 'answer': show(line),\n   181\t                         'target': target, 'quotes': quotes, 'markers not found': flags, 'question': item['user'].split('\\n', 1)[0]}\n   182\t                b.append(entry)\n   183\t                blind.append(entry)\n   184\t    c = []\n   185\t    for item in plan['matched']:\n   186\t        key, listed = f'{item[\"source\"]}:{item[\"call_id\"]}', entries(item['user'])\n   187\t        arms = {form: [show(answers.get(('C', key, form, d))) for d in (1, 2, 3)] for form in ('v12', 'v7')}\n   188\t        cited = lambda a: (set((a or {}).get('cites') or []) | {p['evidence_id'] for p in (a or {}).get('pushes') or []}\n   189\t                           | set((a or {}).get('cites_views') or []) | {p['view_id'] for p in (a or {}).get('theme_pushes') or []})\n   190\t        counts = {form: {} for form in arms}\n   191\t        for form, answers_ in arms.items():\n   192\t            for a in answers_:\n   193\t                for e in cited(a):\n   194\t                    counts[form][e] = counts[form].get(e, 0) + 1\n   195\t        differing = sorted(e for e in set(counts['v12']) | set(counts['v7']) if (counts['v12'].get(e, 0) >= 2) != (counts['v7'].get(e, 0) >= 2))\n   196\t        everything = sorted(set(counts['v12']) | set(counts['v7']))\n   197\t        c.append({'key': key, 'question': item['user'].split('\\n', 1)[0], 'stored answer': json.loads(item['stored answer']) if item.get('stored answer') else None,\n   198\t                  'v12': arms['v12'], 'v7': arms['v7'], 'rungs': {f: [a and a['rung'] for a in arms[f]] for f in arms},\n   199\t                  'differing sources (>=2 of 3 in one arm only)': differing, 'quotes': {e: listed.get(e, '(not listed)') for e in everything}})\n   200\t    (out / 'packet-B.json').write_text(json.dumps(b, ensure_ascii=False, indent=1))\n   201\t    (out / 'packet-C.json').write_text(json.dumps(c, ensure_ascii=False, indent=1))\n   202\t    print(f'Part B: {len(b)} target readings; Part C: {len(c)} comparisons')\n   203\t\n   204\t\n   205\tdef main():\n   206\t    if len(sys.argv) >= 3 and sys.argv[1] == 'packets':\n   207\t        packets(sys.argv[2])\n   208\t    elif len(sys.argv) == 4 and sys.argv[1] == 'verdict':\n   209\t        out = Path(sys.argv[2])\n   210\t        summary = json.loads((out / 'run-summary.json').read_text()) if (out / 'run-summary.json').exists() else {}\n169:                cls = 'ambiguous' if target.get('ambiguous') else ('intended' if target['kind'] == 'evidence' else 'correct')\n170:                b[f'{request[\"key\"]}|{d}|{probe_read.target_ids(target)}'] = {'class': cls, 'valid_support': target['kind'] == 'evidence' and not target.get('ambiguous')}\n216:        ok &= packet_quotes_match_the_store(out / scenario)\n250:def verdict_cases():\n296:        'ambiguous on a target not frozen as ambiguous': clean_readings({f'B/control-1:8807|{d}|e393': {'class': 'ambiguous', 'valid_support': True} for d in (1, 2, 3)}),\n309:def packet_quotes_match_the_store(folder):\n310:    \"\"\"Every evidence entry quoted in the packets carries its quote as the request printed it (the stored quote's first 400 characters),\n311:    read from the stores themselves, never from the packet parser; old-2's e4070 (a multiline quote ending with the closing date) included.\"\"\"\n319:            for evidence_id, text in entry['quotes'].items():\n322:                row = stores[key.split(':')[0]].execute('select quote from evidence where evidence_id=?', (evidence_id,)).fetchone()\n327:    row = stores['old-2'].execute('select quote from evidence where evidence_id=?', ('e4070',)).fetchone()\n328:    ok = expect(f'every packet quote carries its stored quote in full ({checked} checked)', checked > 0 and not missing, str(missing[:5]))\n329:    ok &= expect('old-2:6955 e4070, a multiline quote, is kept whole', '\\n' in row[0][:400] and 'Quote: ' + row[0][:400] in e4070)\n333:def check_equivalence():\nchecks\n  [ok] equal on {}\n  [ok] equal on {\"rung\": 9}\n  [ok] equal on {\"changed\": false}\n  [ok] equal on {\"reference\": \"\"}\n  [ok] equal on {\"cites\": [\"e9\"]}\n  [ok] equal on {\"theme_pushes\": [{\"view_id\": \"v2\", \"push\": \"none\"}, {\"view_id\": \"v2\", \"push\": \"none\"}]}\n  [ok] equal on {\"cites_views\": [\"v3\"]}\n  [ok] equal with a previous conclusion, rung 2 changed false\n  [ok] equal with a previous conclusion, rung 3 changed false\n  [ok] every planned matched request's stored committed answer passes (linked-1 8834 included)\n  [ok] every planned refused request's stored answer is refused on its bad ids\nverdicts\n  [ok] clean set -> pass\n  [ok] 8938 85.4% unsupported in three draws -> inconclusive (unresolved)\n  [ok] 8807 $393B unsupported in three draws -> not ready\n  [ok] three misattributions -> not ready\n  [ok] 8807 two wrong, one omitted -> not ready\n  [ok] 8807 one unsupported, two missing -> inconclusive (incomplete)\n  [ok] A1 rejected -> not ready (format)\n  [ok] A1 timed out -> inconclusive (incomplete)\n  [ok] misattribution excess with Part C incomplete -> not ready\n  [ok] unresolved Part C difference, all else clean -> inconclusive (unresolved)\n  [ok] A2 skipped -> pass\n  [ok] A2 rejected -> pass\n  [ok] a refused v12 answer -> not ready\n  [ok] a ledger stop in the core run -> inconclusive (incomplete)\n  [ok] a Part C control with no content -> inconclusive (incomplete)\n  [ok] a Part C control answering {} -> inconclusive (incomplete)\n  [ok] a readable v7 control the request-time check refuses still counts -> pass\n  [ok] readings refused: \"false\" as a string\n  [ok] readings refused: omitted with valid support\n  [ok] readings refused: harms on a comparison not read\n  [ok] readings refused: a reading of a missing answer\n  [ok] readings refused: a reading of no planned target\n  [ok] readings refused: ambiguous on a target not frozen as ambiguous\nclean\n  [ok] no request problem\n  [ok] 2 + 48 + 72 + A2 answers\n  [ok] three fresh calls per planned request and format\n  [ok] every answer answered and passing the request-time check\n  [ok] records carry provider attempts and charges\nPart B: 51 target readings; Part C: 12 comparisons\n  [ok] the 8938 packet flags the one answer that drops 85.4\n  [ok] every packet quote carries its stored quote in full (300 checked)\n  [ok] old-2:6955 e4070, a multiline quote, is kept whole\n  [ok] the clean run verdict is pass\nformat-invalid\n  [ok] the format-invalid answer takes the SchemaError path\n  [ok] verdict not ready\na1-400\n  [ok] A1 recorded as a 400\n  [ok] nothing after A1 is sent\n  [ok] verdict not ready (format)\na1-timeout\n  [ok] A1 a transport error without a status, after three attempts\n  [ok] nothing after A1 is sent\n  [ok] verdict inconclusive (incomplete)\n5xx-then-ok\n  [ok] A0 answered after a 503 retry, the failed attempt charged\nlow-ceiling\n  [ok] the first Part C comparison is not started\n  [ok] verdict inconclusive (incomplete)\nretry-exhausts\n  [ok] the admitted comparison is interrupted by the refused retry reservation\n  [ok] verdict inconclusive (incomplete)\na2-stop\n  [ok] the ledger stopped during A2, the core ledger did not\n  [ok] a stop during A2 leaves the core verdict pass\nmutant-open-b\n  [ok] the byte check catches mutant-open-b\nmutant-order\n  [ok] the byte check catches mutant-order\nREHEARSAL PASS\nexit 0\n","exit_code":0,"status":"completed"}}
