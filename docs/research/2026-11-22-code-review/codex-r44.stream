{"type":"item.completed","item":{"id":"item_25","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba src/hivemind/parallel_day.py | sed -n '15,155p'\nnl -ba src/hivemind/replay.py | sed -n '45,138p'\nrg -n 'checksum|asdict|runtime_identity' src/hivemind/config.py scripts/replay.py\"","aggregated_output":"    15\timport hashlib\n    16\timport json\n    17\tfrom pathlib import Path\n    18\timport time\n    19\t\n    20\tfrom . import extraction, model\n    21\tfrom .views import round as rounds, store\n    22\t\n    23\tPACKAGE = Path(__file__).resolve().parent\n    24\t\n    25\t\n    26\tdef digest(path):\n    27\t    value = hashlib.sha256()\n    28\t    with path.open('rb') as handle:\n    29\t        for chunk in iter(lambda: handle.read(1024 * 1024), b''):\n    30\t            value.update(chunk)\n    31\t    return value.hexdigest()\n    32\t\n    33\t\n    34\tdef environment_key(cfg, universe):\n    35\t    return model.request_identity({'config': dataclasses.asdict(cfg), 'universe': vars(universe)})[1]\n    36\t\n    37\t\n    38\tdef runtime_key():\n    39\t    files = sorted(PACKAGE.rglob('*.py')) + sorted((PACKAGE / 'prompts').glob('*'))\n    40\t    return model.request_identity({str(path.relative_to(PACKAGE.parent)): digest(path) for path in files if path.is_file()})[1]\n    41\t\n    42\t\n    43\tdef item_key(item):\n    44\t    return model.request_identity(item)[1]\n    45\t\n    46\t\n    47\tdef extraction_key(cfg, item, text, shown, universe):\n    48\t    setting, system, user, schema = extraction.request_for(cfg, item, text, shown, universe)\n    49\t    return model.request_identity(model.build_request(setting, system, user, schema, 'extraction', cfg.provider))[1]\n    50\t\n    51\t\n    52\tclass ParallelDay:\n    53\t    \"\"\"A `day_runner` for replay.run: per-day manifest, bounded early extraction, validated ordered commits.\"\"\"\n    54\t\n    55\t    def __init__(self, source_path, manifest_dir, *, extraction_workers=2, jev_workers=2):\n    56\t        for workers in (extraction_workers, jev_workers):\n    57\t            if not isinstance(workers, int) or isinstance(workers, bool) or workers < 1:\n    58\t                raise ValueError('worker counts must be positive integers')\n    59\t        self.source_path, self.manifest_dir = Path(source_path), Path(manifest_dir)\n    60\t        if not self.source_path.is_absolute() or not self.source_path.is_file() or not self.manifest_dir.is_absolute():\n    61\t            raise ValueError('use an existing absolute source path and an absolute manifest directory')\n    62\t        self.extraction_workers, self.jev_workers = extraction_workers, jev_workers\n    63\t        self.events = []\n    64\t\n    65\t    def _event(self, input_id, event, **fields):\n    66\t        self.events.append(dict(fields, input_id=input_id, event=event, t=time.perf_counter()))\n    67\t\n    68\t    def _manifest(self, conn, cfg, universe, items, day):\n    69\t        self.manifest_dir.mkdir(parents=True, exist_ok=True)\n    70\t        path = self.manifest_dir / f'day-{day}.json'\n    71\t        metadata = {'day': day, 'environment': environment_key(cfg, universe), 'runtime': runtime_key(),\n    72\t                    'source': digest(self.source_path), 'extraction_workers': self.extraction_workers,\n    73\t                    'jev_workers': self.jev_workers}\n    74\t        entries = [{'input_id': item['input_id'], 'seq': route.sequence_no, 'hash': item_key(item)} for item, route in items]\n    75\t        started = conn.execute(\"select 1 from processing_steps where publication_day=? and step in ('extracted','written','handed_over') limit 1\", (day,)).fetchone()\n    76\t        if not started:\n    77\t            # Nothing of this day is written in this ledger: a manifest left by another run or ledger guards nothing here.\n    78\t            path.write_text(json.dumps(dict(metadata, inputs=entries), sort_keys=True), encoding='utf-8')\n    79\t        elif not path.exists():\n    80\t            raise ValueError('cannot adopt a partially processed day without its parallel-day manifest; finish it with --workers 1')\n    81\t        try:\n    82\t            saved = json.loads(path.read_text())\n    83\t        except (OSError, ValueError) as error:\n    84\t            raise ValueError('unreadable parallel-day manifest; refusing to guess its inputs') from error\n    85\t        if {k: saved.get(k) for k in metadata} != metadata:\n    86\t            raise ValueError('parallel-day manifest source, configuration or runtime changed')\n    87\t        remaining = [entry for entry in saved['inputs'] if not store.is_processed(conn, entry['input_id'])]\n    88\t        if remaining != entries:\n    89\t            raise ValueError('parallel-day manifest input order or content changed')\n    90\t        return metadata\n    91\t\n    92\t    def __call__(self, conn, archive, cfg, universe, items, *, day, transport=None, log=print):\n    93\t        if cfg.matching.engine not in ('jev', 'jev-links') and self.jev_workers != 1:\n    94\t            raise ValueError('parallel matching is only implemented for Jev')\n    95\t        metadata = self._manifest(conn, cfg, universe, items, day)\n    96\t        frozen_cfg, frozen_universe = copy.deepcopy(cfg), copy.deepcopy(universe)\n    97\t        pending, prepared_futures, next_index = {}, [], 0\n    98\t        pool = concurrent.futures.ThreadPoolExecutor(max_workers=self.extraction_workers)\n    99\t\n   100\t        def current_request(item):\n   101\t            objects = [o['value'] for o in item.get('object_identifiers') or [] if frozen_universe.has(o['value'])]\n   102\t            shown = copy.deepcopy(extraction.shown_views(conn, frozen_cfg, item, objects))\n   103\t            owned_item = copy.deepcopy(item)\n   104\t            return owned_item, shown, extraction_key(frozen_cfg, owned_item, owned_item['text'], shown, frozen_universe)\n   105\t\n   106\t        def submit(item, owned_item, shown, key):\n   107\t            future = pool.submit(extraction.read_item, archive, frozen_cfg, owned_item, owned_item['text'], shown,\n   108\t                                 frozen_universe, transport=transport)      # the read; filing waits for the turn\n   109\t            pending[item['input_id']] = (key, item_key(owned_item), future, item)\n   110\t            prepared_futures.append((item['input_id'], future))\n   111\t            self._event(item['input_id'], 'prepared', request=key)\n   112\t\n   113\t        def fill():\n   114\t            nonlocal next_index\n   115\t            while next_index < len(items) and len(pending) < self.extraction_workers:\n   116\t                item, route = items[next_index]\n   117\t                next_index += 1\n   118\t                if route.resume_from and route.resume_from != 'extracted':\n   119\t                    continue  # The authoritative saved handover is owned by normal recovery.\n   120\t                submit(item, *current_request(item))\n   121\t\n   122\t        def refresh():\n   123\t            \"\"\"Re-prepare, right after a commit, every waiting request that commit changed; the turn still validates.\"\"\"\n   124\t            for input_id, (key, _, future, item) in list(pending.items()):\n   125\t                owned_item, shown, current = current_request(item)\n   126\t                if current != key:\n   127\t                    future.cancel()\n   128\t                    self._event(input_id, 'stale', before=key, request=current)\n   129\t                    submit(item, owned_item, shown, current)\n   130\t\n   131\t        def accepted_extraction(current_archive, current_cfg, item, text, shown, current_universe, *, transport=None):\n   132\t            prior_key, source_key, future, _ = pending[item['input_id']]\n   133\t            def validate_inputs():\n   134\t                if (environment_key(current_cfg, current_universe) != metadata['environment']\n   135\t                        or environment_key(cfg, universe) != metadata['environment'] or runtime_key() != metadata['runtime']):\n   136\t                    raise ValueError('configuration, universe or runtime changed during the day')\n   137\t                if item_key(item) != source_key or text != item['text']:\n   138\t                    raise ValueError('source changed after preparation')\n   139\t            validate_inputs()\n   140\t            current_key = extraction_key(current_cfg, item, text, shown, current_universe)\n   141\t            if current_key == prior_key:\n   142\t                reading = future.result()\n   143\t                validate_inputs()\n   144\t                if reading.answer.request_sha256 != current_key:\n   145\t                    raise ValueError('prepared extraction does not match its validated request')\n   146\t                self._event(item['input_id'], 'reused', request=current_key)\n   147\t                return extraction.file_reading(reading, item, shown)   # filed under the questions open now\n   148\t            future.cancel()\n   149\t            self._event(item['input_id'], 'stale', before=prior_key, request=current_key)\n   150\t            reading = extraction.read_item(current_archive, current_cfg, item, text, shown, current_universe, transport=transport)\n   151\t            validate_inputs()\n   152\t            self._event(item['input_id'], 'reextracted', request=current_key)\n   153\t            return extraction.file_reading(reading, item, shown)\n   154\t\n   155\t        try:\n    45\t    last = datetime.date.fromisoformat(until_day)\n    46\t    while day <= last:\n    47\t        yield day.isoformat()\n    48\t        day += datetime.timedelta(days=1)\n    49\t\n    50\t\n    51\tdef run(*, testdb_path, views_path, archive, cfg, universe, from_day, until_day, day0=None, spend_cap_usd=None,\n    52\t        transport=None, log=print, only_objects=None, max_items_per_day=None, day_runner=None):\n    53\t    items_db = testdb.open_db(testdb_path)\n    54\t    conn = store.open_db(views_path)\n    55\t    refuse_unfinished_parallel(conn)\n    56\t    last_done = store.last_completed_day(conn)\n    57\t    start = from_day\n    58\t    if last_done and from_day <= last_done:\n    59\t        next_day = (datetime.date.fromisoformat(last_done) + datetime.timedelta(days=1)).isoformat()\n    60\t        if next_day > until_day:\n    61\t            raise BackdatingError(f'views database already completed {last_done}; nothing to run before it')\n    62\t        log(f'resuming after the last completed day {last_done}')\n    63\t        start = next_day\n    64\t    last_written = conn.execute('select max(publication_day) from processing_steps where sequence_no > 0').fetchone()[0]\n    65\t    if last_written and start < last_written:\n    66\t        raise BackdatingError(f'views database already holds rounds of {last_written}; a replay cannot start before it (D31)')\n    67\t    totals = {'items': 0, 'extracted': 0, 'skipped': 0, 'merged': 0, 'not_processed': 0, 'returned': 0, 'failed': 0,\n    68\t              'evidence': 0, 'new_views': 0, 'judged': 0, 'changed': 0, 'closed': 0}\n    69\t    calls_before, cost_before, *_ = archive.totals()\n    70\t    for day in calendar_days(start, until_day):\n    71\t        day_stats = {k: 0 for k in totals}\n    72\t        day_cost_before = archive.totals()[1]\n    73\t        processed = 0\n    74\t        to_run = []\n    75\t        for item in testdb.feed(items_db, day, day):\n    76\t            if item['publication_day'] > day:\n    77\t                raise LookAheadError(f'{item[\"input_id\"]} is dated {item[\"publication_day\"]}, after replay day {day}')\n    78\t            if only_objects and not any(o['value'] in only_objects for o in item['object_identifiers']):\n    79\t                continue\n    80\t            if max_items_per_day and processed >= max_items_per_day:\n    81\t                break\n    82\t            day_stats['items'] += 1\n    83\t            route = dispatch.route(conn, item, universe)\n    84\t            if route.kind != 'extract':\n    85\t                day_stats[route.kind] += 1\n    86\t                if route.kind == 'skipped':\n    87\t                    processed += 1      # written by an earlier run of this day: a restart keeps the day's item limit\n    88\t                if route.kind == 'merged':\n    89\t                    dispatch.mark(conn, item, 0, 'merged', 'ok', route.reason)\n    90\t                    conn.commit()\n    91\t                continue\n    92\t            processed += 1\n    93\t            to_run.append((item, route))\n    94\t        results = (day_runner(conn, archive, cfg, universe, to_run, day=day, transport=transport, log=log) if day_runner else\n    95\t                   (round_module.run(conn, archive, cfg, universe, item, route.sequence_no, resume_from=route.resume_from, transport=transport, log=log)\n    96\t                    for item, route in to_run))\n    97\t        finished = 0\n    98\t        try:\n    99\t            for index, result in enumerate(results):\n   100\t                if index >= len(to_run) or result.input_id != to_run[index][0]['input_id']:\n   101\t                    raise RuntimeError('day runner returned results out of input order')\n   102\t                finished += 1\n   103\t                day_stats['extracted'] += 1\n   104\t                day_stats['evidence'] += result.evidence\n   105\t                day_stats['new_views'] += result.new_views\n   106\t                day_stats['judged'] += result.judged\n   107\t                day_stats['changed'] += result.changed\n   108\t                if result.failed:\n   109\t                    day_stats['failed'] += 1\n   110\t                    log(f'  ! {result.input_id[:60]}: {result.failed}')\n   111\t                    raise RuntimeError(f'item failed; day {day} remains resumable: {result.failed}')\n   112\t                if spend_cap_usd is not None and archive.totals()[1] - cost_before > spend_cap_usd:\n   113\t                    raise RuntimeError(f'spend cap {spend_cap_usd} reached on {day}')\n   114\t        finally:\n   115\t            if hasattr(results, 'close'):\n   116\t                results.close()\n   117\t        if finished != len(to_run):\n   118\t            raise RuntimeError('day runner did not complete every routed item')\n   119\t        seq = store.next_sequence(conn) - 1\n   120\t        judged = round_module.judge_day(conn, archive, cfg, day, seq, transport=transport, log=log)\n   121\t        day_stats['judged'] += judged.judged\n   122\t        day_stats['changed'] += judged.changed\n   123\t        if judged.failed:\n   124\t            day_stats['failed'] += 1\n   125\t            log(f'  ! day judging: {judged.failed}')\n   126\t            raise RuntimeError(f'judging failed; day {day} remains resumable: {judged.failed}')\n   127\t        closed = pull.end_of_day(conn, day, seq)\n   128\t        day_stats['closed'] = len(closed)\n   129\t        # The day ends at the last sequence it wrote, a closing's own sequence on a day without items included, so the next day starts after it.\n   130\t        store.complete_day(conn, day, store.next_sequence(conn) - 1, time.strftime('%Y-%m-%dT%H:%M:%S'))\n   131\t        conn.commit()\n   132\t        for key in totals:\n   133\t            totals[key] += day_stats[key]\n   134\t        calls, cost, _, _ = archive.totals()\n   135\t        day_cost = cost - day_cost_before  # Includes discarded speculative calls and repaired refusals.\n   136\t        open_count = len(store.open_views(conn))\n   137\t        log(f'{day} | items {day_stats[\"items\"]:3d} extracted {day_stats[\"extracted\"]:3d} merged {day_stats[\"merged\"]:2d} skipped {day_stats[\"not_processed\"]:2d} '\n   138\t            f'failed {day_stats[\"failed\"]:2d} | evidence {day_stats[\"evidence\"]:3d} new views {day_stats[\"new_views\"]:2d} judged {day_stats[\"judged\"]:3d} '\nscripts/replay.py:122:    log(f'--- replay {args.from_day}..{args.until_day} config {cfg.version}/{cfg.checksum} provider {cfg.provider} universe {uni.version}'\nsrc/hivemind/config.py:1:\"\"\"Config (docs/prd/03-config.md): a versioned file of the settings a person chooses, with a checksum written into\nsrc/hivemind/config.py:57:    checksum: str\nsrc/hivemind/config.py:111:    checksum = hashlib.sha256(canonical.encode('utf-8')).hexdigest()[:16]\nsrc/hivemind/config.py:124:    return Config(version=str(raw['version']), checksum=checksum, provider=str(raw['provider']),\n","exit_code":0,"status":"completed"}}
