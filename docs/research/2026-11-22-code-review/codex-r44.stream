{"type":"item.completed","item":{"id":"item_29","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba scripts/replay.py | sed -n '47,149p'\nnl -ba src/hivemind/replay.py | sed -n '15,43p'\nrg -n 'def open_db|def ensure_writable' src/hivemind/views/store.py\nrg -n 'parallel.*(manifest|finish)|runtime changed|mid.day' tests docs/live-service | head -55\"","aggregated_output":"    47\t    except sqlite3.Error as error:\n    48\t        raise SystemExit(f'cannot inspect existing ledger: {error}') from error\n    49\t\n    50\t\n    51\tdef refuse_harness_ledger(path):\n    52\t    \"\"\"A ledger marked harness-only (a `harness_only` table, D694's July test) is written by its harness alone; read-only inspection stays\n    53\t    open. Refused under any configuration, before any item is routed.\"\"\"\n    54\t    ledger = Path(path)\n    55\t    if not ledger.exists():\n    56\t        return\n    57\t    try:\n    58\t        with sqlite3.connect(ledger.resolve().as_uri() + '?mode=ro', uri=True) as conn:\n    59\t            marked = conn.execute(\"select count(*) from sqlite_master where type='table' and name='harness_only'\").fetchone()[0]\n    60\t    except sqlite3.Error as error:\n    61\t        raise SystemExit(f'cannot inspect existing ledger: {error}') from error\n    62\t    if marked:\n    63\t        raise SystemExit('this ledger is marked harness-only; an ordinary replay does not write it')\n    64\t\n    65\t\n    66\tdef refuse_links_engine(cfg):\n    67\t    \"\"\"D694: poc-v119's matching engine runs only in its July test harness in this version, not from an ordinary launcher.\"\"\"\n    68\t    if cfg.matching.engine == 'jev-links':\n    69\t        raise SystemExit(f'config {cfg.version}: matching engine jev-links is not a product entry point in this version (D694)')\n    70\t\n    71\t\n    72\tNOT_ADOPTED_JUDGING = ('judging-v12',)     # D719: built and kept, not adopted; no product launcher runs it\n    73\t\n    74\t\n    75\tdef refuse_unadopted_judging(cfg):\n    76\t    \"\"\"D719: a configuration whose re-judging names a version that is built but not adopted (judging-v12, poc-v121) is refused by an\n    77\t    ordinary launcher; its harnesses call the library directly.\"\"\"\n    78\t    if cfg.rejudging.prompt_version in NOT_ADOPTED_JUDGING:\n    79\t        raise SystemExit(f'config {cfg.version}: {cfg.rejudging.prompt_version} is not adopted; an ordinary launcher does not run it (D719)')\n    80\t\n    81\t\n    82\tdef main():\n    83\t    parser = argparse.ArgumentParser()\n    84\t    parser.add_argument('--from', dest='from_day', required=True)\n    85\t    parser.add_argument('--until', dest='until_day', required=True)\n    86\t    parser.add_argument('--day0', default=None)\n    87\t    parser.add_argument('--testdb', default=os.path.join(ROOT, 'poc', 'data', 'items-nvda-2026-07-01-10-27.sqlite'))\n    88\t    parser.add_argument('--views', required=True, help='the ledger this run writes (a new run: a new dated folder)')\n    89\t    parser.add_argument('--archive', required=True, help='the model-call archive of this run')\n    90\t    parser.add_argument('--config', default=os.path.join(ROOT, 'poc', 'config', 'poc-v118.json'))\n    91\t    parser.add_argument('--universe', default=os.path.join(ROOT, 'poc', 'universe.json'))\n    92\t    parser.add_argument('--only', default=None, help='comma-separated object ids to restrict the stream to')\n    93\t    parser.add_argument('--cap', type=float, default=None, help='USD spend cap for this run')\n    94\t    parser.add_argument('--max-items-per-day', type=int, default=None)\n    95\t    parser.add_argument('--workers', type=int, default=16, help='extraction requests prepared at a time (D183); 1 is the serial path')\n    96\t    parser.add_argument('--jev-workers', type=int, default=None,\n    97\t                        help='Jev matching questions sent at a time when --workers > 1; default 8 for Jev, 1 for another engine')\n    98\t    args = parser.parse_args()\n    99\t    os.makedirs(os.path.dirname(args.views), exist_ok=True)\n   100\t    log_path = os.path.join(os.path.dirname(args.views), 'replay.log')\n   101\t\n   102\t    def log(*parts):\n   103\t        line = ' '.join(str(p) for p in parts)\n   104\t        print(line, flush=True)\n   105\t        with open(log_path, 'a', encoding='utf-8') as handle:\n   106\t            handle.write(line + '\\n')\n   107\t\n   108\t    cfg = config.load(args.config)\n   109\t    if cfg.baseline is not None:\n   110\t        raise SystemExit(f'config {cfg.version} uses retired seeded-question baseline; select a configuration without it')\n   111\t    refuse_links_engine(cfg)\n   112\t    refuse_unadopted_judging(cfg)\n   113\t    refuse_seeded_ledger(args.views)\n   114\t    refuse_harness_ledger(args.views)\n   115\t    uni = universe.load(args.universe)\n   116\t    archive = model.Archive(args.archive)\n   117\t    day_runner = None\n   118\t    if args.workers > 1:\n   119\t        jev_workers = args.jev_workers if args.jev_workers is not None else (8 if cfg.matching.engine == 'jev' else 1)\n   120\t        day_runner = parallel_day.ParallelDay(os.path.abspath(args.testdb), os.path.join(os.path.dirname(os.path.abspath(args.views)), 'manifests'),\n   121\t                                              extraction_workers=args.workers, jev_workers=jev_workers)\n   122\t    log(f'--- replay {args.from_day}..{args.until_day} config {cfg.version}/{cfg.checksum} provider {cfg.provider} universe {uni.version}'\n   123\t        f' workers {args.workers}')\n   124\t    totals = replay.run(testdb_path=args.testdb, views_path=args.views, archive=archive, cfg=cfg, universe=uni,\n   125\t                        from_day=args.from_day, until_day=args.until_day, day0=args.day0, spend_cap_usd=args.cap, log=log,\n   126\t                        only_objects=set(args.only.split(',')) if args.only else None, max_items_per_day=args.max_items_per_day,\n   127\t                        day_runner=day_runner)\n   128\t    log('totals:', totals)\n   129\t\n   130\t\n   131\tif __name__ == '__main__':\n   132\t    main()\n    15\t\n    16\t\n    17\tclass StaleHandoverError(RuntimeError):\n    18\t    \"\"\"A saved parallel extraction cannot establish that it read its predecessors.\"\"\"\n    19\t\n    20\t\n    21\tdef refuse_unfinished_parallel(conn):\n    22\t    \"\"\"D159: preserve old handovers, but never resume a day-start read as a sequential read.\"\"\"\n    23\t    pending = conn.execute(\"\"\"select p.input_id, p.reason from processing_steps p\n    24\t        where p.step='extracted' and p.result='ok'\n    25\t        and p.id=(select max(q.id) from processing_steps q\n    26\t                  where q.input_id=p.input_id and q.step='extracted' and q.result='ok')\n    27\t        and not exists (select 1 from processing_steps q\n    28\t                        where q.input_id=p.input_id and q.step='handed_over' and q.result='ok')\n    29\t        order by p.sequence_no\"\"\")\n    30\t    ids = [row['input_id'] for row in pending if row['reason'].endswith(' (parallel)')]\n    31\t    if ids:\n    32\t        raise StaleHandoverError('unfinished day-start extractions; keep this ledger and replay into a new one: ' + ', '.join(ids))\n    33\t\n    34\t\n    35\tclass LookAheadError(RuntimeError):\n    36\t    pass\n    37\t\n    38\t\n    39\tclass BackdatingError(RuntimeError):\n    40\t    pass\n    41\t\n    42\t\n    43\tdef calendar_days(from_day, until_day):\n57:def open_db(path):\n141:def ensure_writable_columns(conn):\nrg: docs/live-service: No such file or directory (os error 2)\ntests/test_sequential_replay.py:2:item stops the day and a resume keeps the sequence (D159), and a ledger an older parallel run left unfinished is refused.\"\"\"\ntests/test_concurrency.py:213:    the same items (the parallel day's manifest accepts it) and never dispatches an item beyond the limit.\"\"\"\n","exit_code":0,"status":"completed"}}
