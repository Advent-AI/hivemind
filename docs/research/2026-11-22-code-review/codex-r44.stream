d = collections.Counter(), collections.defaultdict(list), 0\n-    rows = archive_conn.execute(\"select purpose, request_sha256, answer_json from model_calls where request_sha256 like '%:schema:%' or request_sha256 like '%:malformed:%' or request_sha256 like '%:refused:%'\")\n-    for purpose, sha, answer_json in (tuple(r) for r in rows):\n+    \"\"\"(answers judged, judge rows without a saved format). Judge rows are checked against the format saved with their own request;\n+    extraction and matching rows against their fixed schema.\"\"\"\n+    reasons, examples, judged, missing = collections.Counter(), collections.defaultdict(list), 0, []\n+    rows = archive_conn.execute(\"select purpose, request_sha256, answer_json, request_json from model_calls where request_sha256 like '%:schema:%' or request_sha256 like '%:malformed:%' or request_sha256 like '%:refused:%'\")\n+    for purpose, sha, answer_json, request_json in (tuple(r) for r in rows):\n         judged += 1\n+        schema = SCHEMAS.get(purpose, {})\n+        if purpose == 'judge':                     # a missing format is reported whatever the answer holds, a malformed one included\n+            schema = saved_judge_format(request_json)\n+            if schema is None:\n+                missing.append(sha)\n+                reasons['judge: no saved answer format'] += 1\n+                continue\n         if ':malformed:' in sha or not answer_json:\n             reasons[f'{purpose}: not JSON'] += 1\n             continue\n-        for error in model.check_schema(json.loads(answer_json), SCHEMAS.get(purpose, {})):\n+        for error in model.check_schema(json.loads(answer_json), schema):\n             key = f'{purpose}: {normalise_reason(error)}'\n             reasons[key] += 1\n             examples[key].append(error[:140])\n     tally('A. answers the schema refused (prompt/schema disagreements; empty when the provider enforces the schema server-side)', judged, judged, reasons, examples)\n-    return judged\n+    return judged, missing\n \n \n class Unverifiable(Exception):\n@@ -337,10 +354,14 @@ def main():\n     items_conn = testdb.open_db(args.items)\n     uni = universe.load(args.universe)\n     print('preflight over', args.archive, 'and', len(views_paths), 'views databases:', ', '.join(os.path.basename(os.path.dirname(p)) for p in views_paths))\n-    part_a(archive_conn)\n+    _, missing_formats = part_a(archive_conn)\n     copies = store_copies(views_paths)\n     counts = [part_b(archive_conn, items_conn, uni), part_c(archive_conn, copies, uni), part_d()]\n     part_e(copies)          # informational for unkeyed ledgers; judged counts are reported per ledger\n+    if missing_formats:\n+        print(f'\\nFAILED: {len(missing_formats)} refused judge rows carry no saved answer format, so part A could not check them: '\n+              + ', '.join(sha[:24] for sha in missing_formats[:10]))\n+        sys.exit(1)\n     if min(counts) == 0:\n         print('\\nUNEXERCISED: a check judged no case')\n         sys.exit(1)\ndiff --git a/scripts/replay.py b/scripts/replay.py\nindex f4a6342f..d742766f 100644\n--- a/scripts/replay.py\n+++ b/scripts/replay.py\n@@ -48,6 +48,27 @@ def refuse_seeded_ledger(path):\n         raise SystemExit(f'cannot inspect existing ledger: {error}') from error\n \n \n+def refuse_harness_ledger(path):\n+    \"\"\"A ledger marked harness-only (a `harness_only` table, D694's July test) is written by its harness alone; read-only inspection stays\n+    open. Refused under any configuration, before any item is routed.\"\"\"\n+    ledger = Path(path)\n+    if not ledger.exists():\n+        return\n+    try:\n+        with sqlite3.connect(ledger.resolve().as_uri() + '?mode=ro', uri=True) as conn:\n+            marked = conn.execute(\"select count(*) from sqlite_master where type='table' and name='harness_only'\").fetchone()[0]\n+    except sqlite3.Error as error:\n+        raise SystemExit(f'cannot inspect existing ledger: {error}') from error\n+    if marked:\n+        raise SystemExit('this ledger is marked harness-only; an ordinary replay does not write it')\n+\n+\n+def refuse_links_engine(cfg):\n+    \"\"\"D694: poc-v119's matching engine runs only in its July test harness in this version, not from an ordinary launcher.\"\"\"\n+    if cfg.matching.engine == 'jev-links':\n+        raise SystemExit(f'config {cfg.version}: matching engine jev-links is not a product entry point in this version (D694)')\n+\n+\n def main():\n     parser = argparse.ArgumentParser()\n     parser.add_argument('--from', dest='from_day', required=True)\n@@ -77,7 +98,9 @@ def main():\n     cfg = config.load(args.config)\n     if cfg.baseline is not None:\n         raise SystemExit(f'config {cfg.version} uses retired seeded-question baseline; select a configuration without it')\n+    refuse_links_engine(cfg)\n     refuse_seeded_ledger(args.views)\n+    refuse_harness_ledger(args.views)\n     uni = universe.load(args.universe)\n     archive = model.Archive(args.archive)\n     day_runner = None\ndiff --git a/src/hivemind/config.py b/src/hivemind/config.py\nindex fc8a0301..2303bfd9 100644\n--- a/src/hivemind/config.py\n+++ b/src/hivemind/config.py\n@@ -43,10 +43,12 @@ class Setting:\n     prompt_version: str\n     reasoning_effort: str\n     max_output_tokens: int\n-    engine: str = 'llm'       # matching only: 'llm' (the generative call) or 'jev' (TypeSafe Jev, views/jev_matching.py)\n+    engine: str = 'llm'       # matching only: 'llm' (the generative call), 'jev' (TypeSafe Jev, views/jev_matching.py) or 'jev-links' (Jev, and the reading links of views/links.py, D694)\n+    link_questions: str = ''  # matching under 'jev-links' only: the version of the link questions (views/links.py), 'links-v1' when unnamed (D705)\n \n \n-ENGINES = ('llm', 'jev')\n+ENGINES = ('llm', 'jev', 'jev-links')\n+LINK_QUESTIONS = ('links-v1', 'links-v2')     # the link question versions views/links.py builds (D694, D705)\n \n \n @dataclasses.dataclass(frozen=True)\n@@ -84,9 +86,18 @@ def _setting(name, raw):\n     engine = str(raw.get('engine', 'llm'))\n     if engine not in ENGINES:\n         raise ConfigError(f'setting {name}: engine {engine!r} is not one of {ENGINES}')\n+    link_questions = ''\n+    if 'link_questions' in raw:              # named: only in matching, only under jev-links, only one of the exact version strings\n+        if name != 'matching' or engine != 'jev-links':\n+            raise ConfigError(f'setting {name}: link_questions is read only by matching under the engine jev-links')\n+        link_questions = raw['link_questions']\n+        if not isinstance(link_questions, str) or link_questions not in LINK_QUESTIONS:\n+            raise ConfigError(f'setting {name}: link_questions {link_questions!r} is not one of {LINK_QUESTIONS}')\n+    elif name == 'matching' and engine == 'jev-links':\n+        link_questions = 'links-v1'          # unnamed: the first version (poc-v119)\n     return Setting(name=name, model=str(raw['model']), prompt_version=str(raw['prompt_version']),\n                    reasoning_effort=str(raw['reasoning_effort']),\n-                   max_output_tokens=int(raw['max_output_tokens']), engine=engine)\n+                   max_output_tokens=int(raw['max_output_tokens']), engine=engine, link_questions=link_questions)\n \n \n def load(path):\ndiff --git a/src/hivemind/model.py b/src/hivemind/model.py\nindex 0415d765..1b326130 100644\n--- a/src/hivemind/model.py\n+++ b/src/hivemind/model.py\n@@ -183,7 +183,7 @@ def openai_transport(provider, request, timeout=180, max_attempts=3):   # the de\n \n def check_schema(value, schema, path='$', root=None):\n     \"\"\"A small validator for the subset of JSON Schema the prompts use: object/required/additionalProperties,\n-    array/items/minItems, string/enum/pattern, integer, number, boolean, null in anyOf, and $ref into the root's $defs.\"\"\"\n+    array/items/minItems/maxItems, string/enum/pattern, integer, number, boolean, null in anyOf, and $ref into the root's $defs.\"\"\"\n     root = root if root is not None else schema\n     if '$ref' in schema:\n         name = schema['$ref'].rsplit('/', 1)[1]\n@@ -220,6 +220,8 @@ def check_schema(value, schema, path='$', root=None):\n         errors = []\n         if len(value) < schema.get('minItems', 0):\n             errors.append(f'{path}: fewer than {schema[\"minItems\"]} items')\n+        if 'maxItems' in schema and len(value) > schema['maxItems']:\n+            errors.append(f'{path}: more than {schema[\"maxItems\"]} items')\n         for index, item in enumerate(value):\n             errors.extend(check_schema(item, schema.get('items', {}), f'{path}[{index}]', root))\n         return errors\ndiff --git a/src/hivemind/parallel_day.py b/src/hivemind/parallel_day.py\nindex 9044fdbd..ea66e215 100644\n--- a/src/hivemind/parallel_day.py\n+++ b/src/hivemind/parallel_day.py\n@@ -90,7 +90,7 @@ class ParallelDay:\n         return metadata\n \n     def __call__(self, conn, archive, cfg, universe, items, *, day, transport=None, log=print):\n-        if cfg.matching.engine != 'jev' and self.jev_workers != 1:\n+        if cfg.matching.engine not in ('jev', 'jev-links') and self.jev_workers != 1:\n             raise ValueError('parallel matching is only implemented for Jev')\n         metadata = self._manifest(conn, cfg, universe, items, day)\n         frozen_cfg, frozen_universe = copy.deepcopy(cfg), copy.deepcopy(universe)\ndiff --git a/src/hivemind/prompts/judging-v12.txt b/src/hivemind/prompts/judging-v12.txt\nnew file mode 100644\nindex 00000000..15103160\n--- /dev/null\n+++ b/src/hivemind/prompts/judging-v12.txt\n@@ -0,0 +1,11 @@\n+You are a senior hedge-fund analyst judging a thesis's current rung. Use only the supplied evidence, dependency conclusions and themes in force. The rung is your forecast: the outcome the evidence in force makes most likely at the due date, not the one it has proved.\n+\n+- Rejudge from the evidence shown (what recent judgements relied on and what arrived recently), the current conclusions of dependencies and the themes in force. Pieces in force that no recent judgement relied on are not shown; the previous conclusion carries them. Do not add to or subtract from the previous score. The previous conclusion is supplied only for comparison.\n+- Judge against a reference: what the market expects for this question (consensus, the company's guidance, the stated plan or deadline). Say where the reference sits on the ladder. A consensus or guidance figure by itself keeps the judgement at the reference's rung; once other evidence has arrived it is never the reason to stay. Then derive the outcome the evidence implies: reported figures and guidance give a run-rate that carries the guided growth forward, never the last quarter annualised flat; a quantified revision, a customer's demand number, a supplier's constraint, a confirmed delay or cancellation shift it. A target for a product with no shipments yet is discounted by default; it is taken in full only when the evidence shows the volume in hand. State the implied figure or date, check it against the dependencies' conclusions shown (a part cannot exceed its whole, and a figure that spans several periods or products gives this question only its share), compare it with the rung boundaries, and move when it crosses one.\n+- Weigh by tier and by novelty. Only fact can establish that a rung's outcome already holds; \"not established\" is a statement of confidence, never a reason to stay. Guidance for the current or next quarter is the strongest forecast input. A management target for a product not yet shipping, or an ambition spanning years, is an input to be discounted for time and execution (how many selling quarters remain, what volume and price the figure implies, what the company's own choices say), not an answer; consensus is where the market stands, not the answer either. third_party_view and rumour move the forecast in proportion to their specificity (a number, a date, a named party): a research firm's shipment or revenue tracking with a number counts. A commitment or deal that is announced but not sized is sized from its disclosed comparable (the same programme's other deal, scaled by capacity or units); a figure no one states is derived from the accounting identities in the evidence when they allow it. A repeat, another outlet for the same claim, or an opinion that adds no new fact or calculation moves nothing. Missing confirmation alone is not grounds for the lowest or highest rung: an event not being confirmed is not confirmation that it did not happen.\n+- An evidence item that replaces another includes its predecessor for context, such as guidance revised from 12% to 25% growth. The predecessor is no longer evidence in force.\n+- “Themes in force” lists the library's open theme theses (policy stages, shared quantities) with their current conclusions. They are our own judgements, never evidence: do not cite them in cites. Weigh each one that bears on this thesis and report it in theme_pushes with the direction it pushes this thesis (toward_first, toward_last or none); leave out a theme that does not bear on it. A theme marked “updated since this thesis was last judged” may change the conclusion; one that is not marked already stood at the previous judgement. When no themes are listed, theme_pushes is empty.\n+- A dependency marked “not yet created” supplies no input. A dependency marked “historical only” is closed without a successor; its closing conclusion is background only.\n+- Your conclusion must be consistent with the conclusions of the theses it depends on and the themes in force as shown: a share cannot be judged at zero while the policy that gates it is judged likely to open; a component cannot exceed its whole.\n+- Return the rung's one-based position; reference (what the market expects and which rung that is); implied_outcome (the figure or date the evidence implies and how you derived it, in one or two sentences); reasons (the gap between the two and why it does or does not cross a rung boundary); citations to supplied evidence and dependency IDs; each evidence item's push (toward_first, toward_last or none); theme_pushes; changed; and why_changed. Write explanations in English; preserve IDs and any quoted source text.\n+- changed is true for a different rung or a change to the key facts or figures supporting the same rung, including a changed implied outcome. Repetition or another source for the same statement does not alone change the conclusion. The first judgement always has changed true.\ndiff --git a/src/hivemind/prompts/judging-v8.txt b/src/hivemind/prompts/judging-v8.txt\nnew file mode 100644\nindex 00000000..15103160\n--- /dev/null\n+++ b/src/hivemind/prompts/judging-v8.txt\n@@ -0,0 +1,11 @@\n+You are a senior hedge-fund analyst judging a thesis's current rung. Use only the supplied evidence, dependency conclusions and themes in force. The rung is your forecast: the outcome the evidence in force makes most likely at the due date, not the one it has proved.\n+\n+- Rejudge from the evidence shown (what recent judgements relied on and what arrived recently), the current conclusions of dependencies and the themes in force. Pieces in force that no recent judgement relied on are not shown; the previous conclusion carries them. Do not add to or subtract from the previous score. The previous conclusion is supplied only for comparison.\n+- Judge against a reference: what the market expects for this question (consensus, the company's guidance, the stated plan or deadline). Say where the reference sits on the ladder. A consensus or guidance figure by itself keeps the judgement at the reference's rung; once other evidence has arrived it is never the reason to stay. Then derive the outcome the evidence implies: reported figures and guidance give a run-rate that carries the guided growth forward, never the last quarter annualised flat; a quantified revision, a customer's demand number, a supplier's constraint, a confirmed delay or cancellation shift it. A target for a product with no shipments yet is discounted by default; it is taken in full only when the evidence shows the volume in hand. State the implied figure or date, check it against the dependencies' conclusions shown (a part cannot exceed its whole, and a figure that spans several periods or products gives this question only its share), compare it with the rung boundaries, and move when it crosses one.\n+- Weigh by tier and by novelty. Only fact can establish that a rung's outcome already holds; \"not established\" is a statement of confidence, never a reason to stay. Guidance for the current or next quarter is the strongest forecast input. A management target for a product not yet shipping, or an ambition spanning years, is an input to be discounted for time and execution (how many selling quarters remain, what volume and price the figure implies, what the company's own choices say), not an answer; consensus is where the market stands, not the answer either. third_party_view and rumour move the forecast in proportion to their specificity (a number, a date, a named party): a research firm's shipment or revenue tracking with a number counts. A commitment or deal that is announced but not sized is sized from its disclosed comparable (the same programme's other deal, scaled by capacity or units); a figure no one states is derived from the accounting identities in the evidence when they allow it. A repeat, another outlet for the same claim, or an opinion that adds no new fact or calculation moves nothing. Missing confirmation alone is not grounds for the lowest or highest rung: an event not being confirmed is not confirmation that it did not happen.\n+- An evidence item that replaces another includes its predecessor for context, such as guidance revised from 12% to 25% growth. The predecessor is no longer evidence in force.\n+- “Themes in force” lists the library's open theme theses (policy stages, shared quantities) with their current conclusions. They are our own judgements, never evidence: do not cite them in cites. Weigh each one that bears on this thesis and report it in theme_pushes with the direction it pushes this thesis (toward_first, toward_last or none); leave out a theme that does not bear on it. A theme marked “updated since this thesis was last judged” may change the conclusion; one that is not marked already stood at the previous judgement. When no themes are listed, theme_pushes is empty.\n+- A dependency marked “not yet created” supplies no input. A dependency marked “historical only” is closed without a successor; its closing conclusion is background only.\n+- Your conclusion must be consistent with the conclusions of the theses it depends on and the themes in force as shown: a share cannot be judged at zero while the policy that gates it is judged likely to open; a component cannot exceed its whole.\n+- Return the rung's one-based position; reference (what the market expects and which rung that is); implied_outcome (the figure or date the evidence implies and how you derived it, in one or two sentences); reasons (the gap between the two and why it does or does not cross a rung boundary); citations to supplied evidence and dependency IDs; each evidence item's push (toward_first, toward_last or none); theme_pushes; changed; and why_changed. Write explanations in English; preserve IDs and any quoted source text.\n+- changed is true for a different rung or a change to the key facts or figures supporting the same rung, including a changed implied outcome. Repetition or another source for the same statement does not alone change the conclusion. The first judgement always has changed true.\ndiff --git a/src/hivemind/research_context.py b/src/hivemind/research_context.py\nindex bf4abdfd..a831730c 100644\n--- a/src/hivemind/research_context.py\n+++ b/src/hivemind/research_context.py\n@@ -32,7 +32,8 @@ class Reader:\n         return [dict(r) for r in self.db.execute(sql, args)]\n \n     def dependencies(self, vid):\n-        result = self.rows('select * from dependencies where view_id=? and seq<? order by seq,dependency_id', (vid,self.seq))\n+        result = self.rows('select dependency_id, view_id, depends_on, wait_chain_view_id, wait_year, direction, seq from dependencies '\n+                           'where view_id=? and seq<? order by seq,dependency_id', (vid,self.seq))     # the response shape kept as before D694's kind column\n         for dep in result:\n             res = self.rows('select * from dependency_resolutions where dependency_id=? and seq<? order by seq desc,id desc limit 1', (dep['dependency_id'],self.seq))\n             dep['resolved_to'] = res[0]['resolved_to'] if res else dep['depends_on']\ndiff --git a/src/hivemind/views/judging.py b/src/hivemind/views/judging.py\nindex ea94d844..380be694 100644\n--- a/src/hivemind/views/judging.py\n+++ b/src/hivemind/views/judging.py\n@@ -3,8 +3,10 @@ once; a view whose conclusion changed adds its open dependants. The model reads\n replaced predecessor), the dependencies' current conclusions and its own last conclusion (for comparison only).\n Code checks every citation and that a rung move or a first judgement says changed; one retry, then the item fails.\n \n-The request is judging-v7 (D354, frozen with steps 3 and 4): no other version is built, and a configuration that names another is\n-refused before any call. Every answer is stored in the canonical vocabulary.\n+The request is judging-v7 (D354, frozen with steps 3 and 4), judging-v8 (D694: v7's text with the fuller dependency block) or\n+judging-v12 (D713: v7's text and request; the answer's id fields take only the ids the request lists, and the check reads the same\n+lists): no other version is built, and a configuration that names another is refused before any call. Every answer is stored in the\n+canonical vocabulary.\n \n The theme block (D191, D195): an asset thesis is judged with every open, judged theme thesis in view and answers, in theme_pushes,\n which way each theme it weighed pushes it; theme theses are judged before asset theses in a round, and a theme judgement that says\n@@ -25,7 +27,9 @@ from .. import config, model, vocabulary\n from . import store\n \n PUSHES = vocabulary.PUSHES\n-SUPPORTED_VERSIONS = ('judging-v7',)   # D354: the frozen judging prompt\n+SUPPORTED_VERSIONS = ('judging-v7', 'judging-v8', 'judging-v12')   # D354: the frozen judging prompt; D694: v8 = v7's text with the fuller dependency block; D712/D713: v12 = v7's text and request with closed id lists\n+FULL_DEPENDENCY_BLOCK = ('judging-v8',)\n+CLOSED_LISTS = ('judging-v12',)   # the answer's id fields take the ids the request lists (D713)\n READINGS = 5                      # a piece is shown in the thesis's first five judgements after it arrives\n BASIS = 10                        # and while one of the last ten judgements cited it\n THEME_REASONS_CHARS = 300\n@@ -51,7 +55,38 @@ def evidence_in_view(conn, view_id):\n     return shown, len(in_force) - len(shown)\n \n \n-def schema_for(prompt_version):\n+def schema_for(prompt_version, lists=None):\n+    \"\"\"The answer's format. Under judging-v12 (D713) its four id fields take the ids the request lists (`lists`, from\n+    `request_parts`): one shared enum of the evidence ids for cites and push ids, the dependency ids for cites_views, the theme ids\n+    for theme pushes; a field with no id allowed is an array with maxItems 0. Other versions ignore `lists`.\"\"\"\n+    schema = _open_format(prompt_version)\n+    if prompt_version not in CLOSED_LISTS:\n+        return schema\n+    if lists is None:\n+        raise ValueError(f'{prompt_version} builds its answer format from the ids its request lists')\n+    properties = schema['properties']\n+    evidence, dependencies, themes = (sorted(set(lists[key])) for key in ('evidence', 'dependencies', 'themes'))\n+    if evidence:\n+        schema['$defs'] = {'evidence_id': {'type': 'string', 'enum': evidence}}\n+        properties['cites'] = {'type': 'array', 'items': {'$ref': '#/$defs/evidence_id'}}\n+        push_item = properties['pushes']['items']\n+        properties['pushes'] = {'type': 'array', 'items': dict(push_item, properties=dict(push_item['properties'], evidence_id={'$ref': '#/$defs/evidence_id'}))}\n+    else:\n+        properties['cites'] = dict(properties['cites'], maxItems=0)\n+        properties['pushes'] = dict(properties['pushes'], maxItems=0)\n+    if dependencies:\n+        properties['cites_views'] = {'type': 'array', 'items': {'type': 'string', 'enum': dependencies}}\n+    else:\n+        properties['cites_views'] = dict(properties['cites_views'], maxItems=0)\n+    theme_item = properties['theme_pushes']['items']\n+    if themes:\n+        properties['theme_pushes'] = {'type': 'array', 'items': dict(theme_item, properties=dict(theme_item['properties'], view_id={'type': 'string', 'enum': themes}))}\n+    else:\n+        properties['theme_pushes'] = dict(properties['theme_pushes'], maxItems=0)\n+    return schema\n+\n+\n+def _open_format(prompt_version):\n     require_supported(prompt_version)\n     pushes = PUSHES\n     schema = {\n@@ -118,8 +153,24 @@ def topological(conn, view_ids):\n     return ordered\n \n \n-def _lines_english(conn, view_id, v, rungs, pieces, deps, last, themes=(), hidden=0):\n-    \"\"\"hidden: how many pieces in force are not shown.\"\"\"\n+def _indented(text, indent='        '):\n+    \"\"\"A stored value inside a block: every continuation line indented, so no physical line can read as a header or a listed id.\"\"\"\n+    return str(text).replace('\\r\\n', '\\n').replace('\\n', '\\n' + indent)\n+\n+\n+def _dependency_lines_full(conn, target, d, state, rung_label, tv, flag):\n+    \"\"\"judging-v8 (D694, design §3): the read judgement's comparison point and the system's forecast in full, labelled as ours, beside\n+    the reasons excerpt; the read question not judged yet shows only that.\"\"\"\n+    if not state:\n+        return [f'- {target} ({flag}; {d[\"direction\"]}) {tv[\"question\"]}: now not judged yet']\n+    return [f'- {target} ({flag}; {d[\"direction\"]}) {tv[\"question\"]}: now rung {state[\"rung\"]} {rung_label}, judged {state[\"publication_day\"]}',\n+            f'    Comparison point stated by that judgement: {_indented(state.get(\"reference\") or \"not stated\")}',\n+            f'    The system\\'s forecast for it (our own judgement, not evidence): {_indented(state.get(\"implied_outcome\") or \"not stated\")}',\n+            f'    Reasons (excerpt): {_indented((state.get(\"reasons\") or \"\")[:600])}']\n+\n+\n+def _lines_english(conn, view_id, v, rungs, pieces, deps, last, themes=(), hidden=0, full_dependencies=False):\n+    \"\"\"hidden: how many pieces in force are not shown. full_dependencies: the judging-v8 dependency block.\"\"\"\n     lines = [f'Thesis {view_id} ({v[\"object_id\"]}, {v[\"kind\"]}, focus \"{v[\"looks_at\"]}\", {v[\"year\"] or \"\"}, due {v[\"due_day\"]}): {v[\"question\"]}',\n              'Ladder: ' + ' / '.join(f'rung {r[\"position\"]} {r[\"label\"]}: {r[\"condition\"]}' for r in rungs), '',\n              f'[Evidence in view under this thesis, {len(pieces)} items]']\n@@ -145,6 +196,9 @@ def _lines_english(conn, view_id, v, rungs, pieces, deps, last, themes=(), hidde\n             state = store.current_state(conn, target)\n             flag = 'historical only' if d['resolution'] == 'history_only' else ('closed' if not store.is_open(conn, target) else 'open')\n             rung_label = store.rungs_of(conn, target)[state['rung'] - 1]['label'] if state else 'not judged yet'\n+            if full_dependencies:\n+                lines.extend(_dependency_lines_full(conn, target, d, state, rung_label, tv, flag))\n+                continue\n             lines.append(f'- {target} ({flag}; {d[\"direction\"]}) {tv[\"question\"]}: now rung {state[\"rung\"] if state else \"-\"} {rung_label}; reasons: {(state or {}).get(\"reasons\", \"\")[:600]}')\n     if themes:\n         lines.append(f'\\n[Themes in force, {len(themes)}]')\n@@ -164,15 +218,26 @@ def _lines_english(conn, view_id, v, rungs, pieces, deps, last, themes=(), hidde\n \n \n def build_prompt(conn, view_id, prompt_version):\n+    system, user, _ = request_parts(conn, view_id, prompt_version)\n+    return system, user\n+\n+\n+def request_parts(conn, view_id, prompt_version):\n+    \"\"\"(system text, user text, the ids the request lists), all from the same rows at the same ledger state: the evidence pieces it\n+    prints, the dependencies it gives an entry (resolved ones; a dependency still waiting has no id to cite) and the themes it prints.\"\"\"\n     require_supported(prompt_version)\n     v = store.view(conn, view_id)\n     rungs = store.rungs_of(conn, view_id)\n     pieces, hidden = evidence_in_view(conn, view_id)\n     deps = store.dependencies_of(conn, view_id)\n     last = store.current_state(conn, view_id)\n-    lines = _lines_english(conn, view_id, v, rungs, pieces, deps, last, themes_in_force(conn, view_id), hidden=hidden)\n+    themes = themes_in_force(conn, view_id)\n+    lines = _lines_english(conn, view_id, v, rungs, pieces, deps, last, themes, hidden=hidden,\n+                           full_dependencies=prompt_version in FULL_DEPENDENCY_BLOCK)\n+    lists = {'evidence': sorted({p['evidence_id'] for p in pieces}), 'dependencies': sorted({d['resolved_to'] for d in deps if d['resolved_to']}),\n+             'themes': sorted({theme['view_id'] for theme in themes})}\n     with open(config.prompt_path(prompt_version + '.txt'), encoding='utf-8') as handle:\n-        return handle.read(), '\\n'.join(lines)\n+        return handle.read(), '\\n'.join(lines), lists\n \n \n def retry_note(errors):\n@@ -191,11 +256,15 @@ def evidence_shown_in(request_text):\n     return set(re.findall(r'^- (e\\d+) \\[', block[1].split('\\n\\n[', 1)[0], re.M)) if len(block) == 2 else set()\n \n \n-def check_answer(conn, view_id, data, request_text=None):\n+def check_answer(conn, view_id, data, request_text=None, lists=None):\n     \"\"\"request_text: the user message that was sent, so theme and evidence ids are checked against what it carried (a theme may have\n-    closed or opened since); without it, against what the ledger would show now.\"\"\"\n+    closed or opened since); without it, against what the ledger would show now. lists (judging-v12, D713): the ids the request\n+    listed, from the rows that rendered it, the same lists its answer format closed; membership is checked against them.\"\"\"\n     errors = []\n-    shown = themes_shown_in(request_text) if request_text is not None else {theme['view_id'] for theme in themes_in_force(conn, view_id)}\n+    if lists is not None:\n+        shown = set(lists['themes'])\n+    else:\n+        shown = themes_shown_in(request_text) if request_text is not None else {theme['view_id'] for theme in themes_in_force(conn, view_id)}\n     named = []\n     for entry in data.get('theme_pushes', []):\n         if entry['view_id'] in named:\n@@ -204,10 +273,13 @@ def check_answer(conn, view_id, data, request_text=None):\n             errors.append(f'{entry[\"view_id\"]} is not a theme in force shown to {view_id}')\n         named.append(entry['view_id'])\n     # the closed set is what the request showed (D198), read from the text that was sent, else computed from the ledger\n-    allowed = evidence_shown_in(request_text) if request_text is not None else {p['evidence_id'] for p in evidence_in_view(conn, view_id)[0]}\n+    if lists is not None:\n+        allowed, deps = set(lists['evidence']), set(lists['dependencies'])\n+    else:\n+        allowed = evidence_shown_in(request_text) if request_text is not None else {p['evidence_id'] for p in evidence_in_view(conn, view_id)[0]}\n+        deps = {d['resolved_to'] for d in store.dependencies_of(conn, view_id) if d['resolved_to']}\n     not_allowed = lambda e: f'{e} is not among the evidence shown to {view_id}'\n     bad_push = lambda e: f'push on {e} which was not shown to {view_id}'\n-    deps = {d['resolved_to'] for d in store.dependencies_of(conn, view_id) if d['resolved_to']}\n     rungs = store.rungs_of(conn, view_id)\n     if not 1 <= data['rung'] <= len(rungs):\n         errors.append(f'rung {data[\"rung\"]} outside 1..{len(rungs)}')\n@@ -295,7 +367,8 @@ def round_of_judgements(archive, cfg, conn, changed_views, seq, item, *, transpo\n     import concurrent.futures\n \n     version = cfg.rejudging.prompt_version\n-    schema = schema_for(version)\n+    closed = version in CLOSED_LISTS\n+    open_schema = None if closed else schema_for(version)\n \n     def eligible(view_id):\n         return store.is_open(conn, view_id) and not store.has_judgement(conn, view_id, seq) and bool(store.evidence_in_force(conn, view_id))\n@@ -308,21 +381,29 @@ def round_of_judgements(archive, cfg, conn, changed_views, seq, item, *, transpo\n     while pending:\n         ready = [v for v in pending if upstream(conn, v).isdisjoint(set(pending) - {v})] or pending[:1]\n         level = [v for v in ready if is_theme(v)] or ready\n-        prompts = {v: build_prompt(conn, v, version) for v in level}\n+        if closed:                                         # D713: the format's lists and the check's lists come from the rows that render the text\n+            parts = {v: request_parts(conn, v, version) for v in level}\n+            prompts = {v: parts[v][:2] for v in level}\n+            lists = {v: parts[v][2] for v in level}\n+            schemas = {v: schema_for(version, lists[v]) for v in level}\n+        else:                                              # judging-v7/v8: through build_prompt, which harnesses wrap\n+            prompts = {v: build_prompt(conn, v, version) for v in level}\n+            lists = {v: None for v in level}\n+            schemas = {v: open_schema for v in level}\n \n         def ask(view_id, note=''):\n             system, user = prompts[view_id]\n-            return model.call(archive, cfg, cfg.rejudging, system, user + note, schema, 'judgement', 'judge', transport=transport)\n+            return model.call(archive, cfg, cfg.rejudging, system, user + note, schemas[view_id], 'judgement', 'judge', transport=transport)\n \n         with concurrent.futures.ThreadPoolExecutor(max_workers=JUDGE_WORKERS) as pool_:\n             answers = dict(zip(level, pool_.map(ask, level)))\n         for view_id in level:\n             answer = answers[view_id]\n-            errors = check_answer(conn, view_id, answer.data, prompts[view_id][1])\n+            errors = check_answer(conn, view_id, answer.data, prompts[view_id][1], lists[view_id])\n             if errors:\n                 archive.retire(answer.call_id)                 # a refused answer never answers the same request again (a resume re-samples)\n                 answer = ask(view_id, retry_note(errors))\n-                errors = check_answer(conn, view_id, answer.data, prompts[view_id][1])\n+                errors = check_answer(conn, view_id, answer.data, prompts[view_id][1], lists[view_id])\n                 if errors:\n                     archive.retire(answer.call_id)\n                     raise JudgementRefused(f'{view_id}: ' + '; '.join(errors))\ndiff --git a/src/hivemind/views/links.py b/src/hivemind/views/links.py\nnew file mode 100644\nindex 00000000..e2b0b9c1\n--- /dev/null\n+++ b/src/hivemind/views/links.py\n@@ -0,0 +1,356 @@\n+\"\"\"Links between number questions, chosen in the matching step (D51, D368 item 2, D694, D695; the design and its four tables:\n+docs/research/2026-11-20-production-readiness/dependency-design/DESIGN.md).\n+\n+Under the matching engine `jev-links` only, after matching has settled which candidates open: for each newly opened number question\n+C and each open number question T on C's list, Jev is asked whether one should be judged with the other's conclusion in view (READS)\n+and, for a pair that should, which way the read question moves the reading one (SIGN). Code decides only identity: which pairs are\n+number questions, the canonical candidate, circles, and the label the judge is shown (from the sign and the typed rung bounds). A\n+link is written with kind `reads`: judging reads it as a dependency; filing does not treat it as a narrower home (D694 (a)).\n+\"\"\"\n+import json\n+\n+from .. import jev, model, vocabulary\n+from . import identity, jev_matching, store\n+\n+ENGINE = 'jev-links'\n+KIND = 'reads'\n+THRESHOLD = jev_matching.THRESHOLD\n+LABELS = vocabulary.ASSET_LABELS                 # five-rung asset ladders run Strongly bullish .. Strongly bearish, or the reverse\n+CANDIDATE_READS, THESIS_READS, NEITHER = 'candidate_reads_thesis', 'thesis_reads_candidate', 'neither'\n+TOGETHER, OPPOSITE, NO_SIGN = 'together', 'opposite', 'no_clear_sign'\n+\n+READS = {\n+    CANDIDATE_READS: \"the CANDIDATE should be judged with the THESIS's current conclusion in view, because the THESIS's answer bounds \"\n+                     \"or drives the CANDIDATE's: a part read against its whole (one product line's sales against the company's total \"\n+                     \"sales; one region's loan book against the bank's total loans), or a quantity read against another it depends on \"\n+                     \"(a component supplier's revenue against its largest customer's capital spending; an airline's fuel bill against \"\n+                     \"its fuel volume)\",\n+    THESIS_READS: \"the THESIS should be judged with the CANDIDATE's current conclusion in view, for the same reasons with the roles swapped\",\n+    NEITHER: \"neither answer bounds or drives the other: unrelated quantities (a retailer's gross margin and its store openings in \"\n+             \"another country), or the same quantity for the same period and scope; sharing a company, industry or topic is not enough\",\n+}\n+SIGN = {\n+    TOGETHER: \"a higher answer to the question read makes a higher answer to the question reading it more likely (a company's total \"\n+              \"sales and one product line's sales, when that line's share of the total holds steady; a customer's capital spending \"\n+              \"and its component supplier's revenue)\",\n+    OPPOSITE: \"a higher answer to the question read makes a lower answer to the question reading it more likely (an airline's fuel \"\n+              \"bill and its operating margin; a retailer's markdowns and its gross margin)\",\n+    NO_SIGN: \"the question read only caps the other without moving its most likely answer (a regulator's cap on a bank's fees set far \"\n+             \"above what it charges), or the supplied text does not show which way it moves it\",\n+}\n+# links-v2 (D703, D705; docs/research/2026-11-21-whole-window/WORDING-V2.md): links-v1 with a tie-break by the stronger full-period\n+# anchor, links across periods only when the supplied text states how, and a base-effect example of the opposite sign\n+READS_V2 = {\n+    CANDIDATE_READS: \"the CANDIDATE should be judged with the THESIS's current conclusion in view, because the THESIS's answer bounds \"\n+                     \"or drives the CANDIDATE's: a part read against its whole (one product line's sales against the company's total \"\n+                     \"sales; one region's loan book against the bank's total loans), or a quantity read against another it depends on \"\n+                     \"(a component supplier's revenue against its largest customer's capital spending; an airline's fuel bill against \"\n+                     \"its fuel volume) When either question could be judged with the other in view, the one whose answer the supplied \"\n+                     \"text anchors less (no guidance, consensus or reported figure for the quantity and full period the question asks \"\n+                     \"about) is the one judged with the other's conclusion in view.\",\n+    THESIS_READS: READS[THESIS_READS],\n+    NEITHER: \"neither answer bounds or drives the other: unrelated quantities (a retailer's gross margin and its store openings in \"\n+             \"another country), or the same quantity for the same period and scope, or quantities of different periods when the \"\n+             \"supplied text does not state how one period's answer moves the other's (a retailer's sales this year and its sales \"\n+             \"growth next year, when the text only names both); sharing a company, industry or topic is not enough\",\n+}\n+SIGN_V2 = {\n+    TOGETHER: SIGN[TOGETHER],\n+    OPPOSITE: \"a higher answer to the question read makes a lower answer to the question reading it more likely (an airline's fuel \"\n+              \"bill and its operating margin; a retailer's markdowns and its gross margin; one year's sales and the next year's sales \"\n+              \"growth at a given next-year level, since a higher base lowers the growth)\",\n+    NO_SIGN: SIGN[NO_SIGN],\n+}\n+QUESTION_SETS = {'links-v1': (READS, SIGN), 'links-v2': (READS_V2, SIGN_V2)}     # config.LINK_QUESTIONS names the same versions\n+READS_INSTRUCTIONS = (\"Should one of these two questions be judged with the other's current conclusion in view? Use only the supplied \"\n+                      \"text. THESIS:\\n\")\n+SIGN_INSTRUCTIONS = {\n+    CANDIDATE_READS: \"If the THESIS's answer turned out higher, which way would that move the CANDIDATE's most likely answer? Use only the supplied text. THESIS:\\n\",\n+    THESIS_READS: \"If the CANDIDATE's answer turned out higher, which way would that move the THESIS's most likely answer? Use only the supplied text. THESIS:\\n\",\n+}\n+\n+\n+class Refused(RuntimeError):\n+    \"\"\"The link step cannot finish for this article (a persistent circle, an unbound waiting row, a Jev failure); `record` says why.\"\"\"\n+\n+    def __init__(self, message, record):\n+        super().__init__(message)\n+        self.record = record\n+\n+\n+def reads_question(text, excluded=None, note='', version='links-v1'):\n+    criteria = {k: v for k, v in QUESTION_SETS[version][0].items() if k != excluded}\n+    return {'type': 'choice', 'criteria': criteria, 'instructions': READS_INSTRUCTIONS.replace('THESIS:\\n', (note + ' ' if note else '') + 'THESIS:\\n') + text}\n+\n+\n+def sign_question(text, direction, version='links-v1'):\n+    return {'type': 'choice', 'criteria': dict(QUESTION_SETS[version][1]), 'instructions': SIGN_INSTRUCTIONS[direction] + text}\n+\n+\n+# ---------- identity: which ladders are number ladders, and the label ----------\n+\n+def typed_direction(rungs):\n+    \"\"\"-1 when the values fall from the first rung to the last, +1 when they rise, None otherwise. Each rung is [lo, hi) of its typed\n+    bounds; only the first and last rung may leave one outer end open; an interval with lo >= hi is invalid; adjacent rungs may\n+    touch. Prose is never read.\"\"\"\n+    if len(rungs) < 2:\n+        return None\n+    intervals = []\n+    for index, rung in enumerate(rungs):\n+        lo, hi = rung.get('lo'), rung.get('hi')\n+        outer = index in (0, len(rungs) - 1)\n+        if (lo is None and hi is None) or ((lo is None or hi is None) and not outer):\n+            return None\n+        if lo is not None and hi is not None and float(lo) >= float(hi):\n+            return None\n+        intervals.append((None if lo is None else float(lo), None if hi is None else float(hi)))\n+\n+    def at_or_below(lower, upper):\n+        return lower[1] is not None and upper[0] is not None and lower[1] <= upper[0]\n+\n+    pairs = list(zip(intervals, intervals[1:]))\n+    if all(at_or_below(after, before) for before, after in pairs):\n+        return -1\n+    if all(at_or_below(before, after) for before, after in pairs):\n+        return 1\n+    return None\n+\n+\n+def favourable_end(rungs):\n+    \"\"\"'first' or 'last': the end whose stored label is Strongly bullish, on a five-rung ladder carrying the canonical labels in order\n+    or reversed; None otherwise.\"\"\"\n+    labels = [vocabulary.canonical('label', r['label']) for r in rungs]\n+    if labels == LABELS:\n+        return 'first'\n+    if labels == LABELS[::-1]:\n+        return 'last'\n+    return None\n+\n+\n+def label_for(reader_rungs, read_rungs, sign):\n+    \"\"\"The existing direction label (`first_is_bullish` / `last_is_bullish`): which end of the read question's ladder is favourable for\n+    the reading asset question, given the sign; None when undecidable.\"\"\"\n+    reader_direction, read_direction, favourable = typed_direction(reader_rungs), typed_direction(read_rungs), favourable_end(reader_rungs)\n+    if None in (reader_direction, read_direction, favourable) or sign not in (TOGETHER, OPPOSITE):\n+        return None\n+    reader_high = 'first' if reader_direction == -1 else 'last'\n+    favourable_is_high = favourable == reader_high\n+    want_read_high = favourable_is_high if sign == TOGETHER else not favourable_is_high\n+    read_high = 'first' if read_direction == -1 else 'last'\n+    end = read_high if want_read_high else ('last' if read_high == 'first' else 'first')\n+    return 'first_is_bullish' if end == 'first' else 'last_is_bullish'\n+\n+\n+def is_number_question(kind, rungs, measure):\n+    \"\"\"D695: an asset question with a five-rung number ladder (canonical labels, typed direction) and a measure that is not an event.\"\"\"\n+    return (kind == 'asset' and len(rungs) == 5 and bool(measure) and measure not in identity.EVENT_MEASURES\n+            and typed_direction(rungs) is not None and favourable_end(rungs) is not None)\n+\n+\n+def stored_is_number_question(conn, view_id):\n+    v, key = store.view(conn, view_id), store.view_key(conn, view_id)\n+    return bool(v) and is_number_question(v['kind'], store.rungs_of(conn, view_id), (key or {}).get('measure'))\n+\n+\n+def candidate_rungs(conn, c, outcome, target):\n+    \"\"\"The candidate's rungs as the writer will store them (a successor is oriented like its predecessor).\"\"\"\n+    if outcome == 'succession' and target:\n+        from .writing import oriented_like\n+        return oriented_like(c, store.rungs_of(conn, target), [])['rungs']\n+    return c['rungs']\n+\n+\n+# ---------- the reading graph ----------\n+\n+def stored_edges(conn):\n+    \"\"\"Every stored dependency at its effective target (a bound wait counts through the question it is bound to).\"\"\"\n+    edges = {}\n+    for (view_id,) in conn.execute('select distinct view_id from dependencies'):\n+        for dep in store.dependencies_of(conn, view_id):\n+            if dep['resolved_to']:\n+                edges.setdefault(view_id, set()).add(dep['resolved_to'])\n+    return edges\n+\n+\n+def unbound_waits(conn):\n+    return conn.execute(\"select count(*) from dependencies where coalesce(depends_on, '')='' and coalesce(wait_year, '')!='' \"\n+                        \"and dependency_id not in (select dependency_id from dependency_resolutions)\").fetchone()[0]\n+\n+\n+def circles(conn, proposed):\n+    \"\"\"The proposed links (reader, read) that lie on a circle of the stored relation plus every proposed link, each with one path.\"\"\"\n+    graph = {k: set(v) for k, v in stored_edges(conn).items()}\n+    for link in proposed:\n+        graph.setdefault(link['reader'], set()).add(link['read'])\n+    found = []\n+    for link in proposed:\n+        stack, seen = [(link['read'], [link['reader'], link['read']])], set()\n+        while stack:\n+            node, path = stack.pop()\n+            if node == link['reader']:\n+                found.append((link, path))\n+                break\n+            if node in seen:\n+                continue\n+            seen.add(node)\n+            stack.extend((nxt, path + [nxt]) for nxt in sorted(graph.get(node, ())))\n+    return found\n+\n+\n+# ---------- selection ----------\n+\n+def _ask(archive, cfg, jobs, transport, record, stage):\n+    \"\"\"One Jev request per job, asked in order; each job is written into the record before it is sent (its request sha, whether the\n+    archive held it) and completed as it is answered (its call id). A failure names the failing job's sha and leaves the later jobs\n+    marked not asked.\"\"\"\n+    entries = []\n+    for state, questions in jobs:\n+        _, sha = model.request_identity(jev.request_for(cfg.matching, state, questions))\n+        entries.append({'stage': stage, 'request_sha256': sha, 'questions': sorted(questions), 'archived_before': bool(archive.lookup(sha)),\n+                        'status': 'not asked'})\n+    record['calls'].extend(entries)\n+    replies = []\n+    for entry, (state, questions) in zip(entries, jobs):\n+        try:\n+            reply = jev.ask(archive, cfg, cfg.matching, state, questions, 'match', transport=transport)\n+        except Exception as error:\n+            entry['status'] = 'failed'\n+            record['error'] = f'{type(error).__name__}: {error}'[:300]\n+            record['failed_request_sha256'] = entry['request_sha256']\n+            raise Refused(f'link question failed: {record[\"error\"]}', record) from error\n+        entry['status'], entry['call_id'] = 'answered', reply.call_id\n+        replies.append(reply.data)\n+    return replies\n+\n+\n+def _passes(answer, accepted):\n+    choice = answer['choice']\n+    return choice if choice in accepted and answer['probabilities'][choice] >= THRESHOLD else None\n+\n+\n+def choose(archive, cfg, conn, handover, checked, lists, shown_views, *, transport=None):\n+    \"\"\"The links this article proposes: [{'reader', 'read', 'candidate', 'direction', 'sign'}], reader and read being a candidate id\n+    (canonical) or a stored view id; and the record of how they were chosen. Raises Refused for an unbound waiting row, a Jev\n+    failure or a circle that remains after one correction (PRD 06).\"\"\"\n+    record = {'pairs': [], 'calls': [], 'corrections': [], 'proposed': []}\n+    if unbound_waits(conn):\n+        record['error'] = 'the store holds an unbound waiting dependency row'\n+        raise Refused(record['error'], record)\n+    aliases, problems = identity.batch_plan(handover.candidates, checked.outcomes)\n+    if problems:                                   # the writer refuses the same plan (WriteConflict); nothing to ask\n+        record['skipped'] = problems\n+        return [], record\n+    evidence = handover.evidence\n+    stage1, asked = [], []\n+    for c in handover.candidates:\n+        outcome, target, _ = checked.outcomes.get(c['id'], ('skip', None, []))\n+        if outcome not in ('new', 'succession') or aliases.get(c['id']) != c['id']:\n+            continue\n+        rungs = candidate_rungs(conn, c, outcome, target)\n+        if not is_number_question(c['kind'], rungs, c.get('measure')):\n+            record['pairs'].append({'candidate': c['id'], 'eligible': False, 'why': 'not a number question'})\n+            continue\n+        listed = list(dict.fromkeys(list(lists.candidate_lists.get(c['id'], [])) + [v['view_id'] for v in shown_views]))\n+        theses = []\n+        for view_id in listed:\n+            ok = store.is_open(conn, view_id) and stored_is_number_question(conn, view_id)\n+            record['pairs'].append({'candidate': c['id'], 'thesis': view_id, 'eligible': ok})\n+            if ok:\n+                theses.append(view_id)\n+        if theses:\n+            state = jev_matching.candidate_state(c, evidence)\n+            stage1.append((state, {f'reads__{v}': reads_question(jev_matching.thesis_text(conn, v), version=cfg.matching.link_questions) for v in theses}))\n+            asked.append((c, state, theses))\n+    if not stage1:\n+        return [], record\n+    answers = _ask(archive, cfg, stage1, transport, record, 'reads')\n+    directions = {}\n+    for (c, state, theses), reply in zip(asked, answers):\n+        for view_id in theses:\n+            answer = reply[f'reads__{view_id}']\n+            direction = _passes(answer, (CANDIDATE_READS, THESIS_READS))\n+            record['pairs'].append({'candidate': c['id'], 'thesis': view_id, 'reads': answer['choice'], 'probabilities': answer['probabilities']})\n+            if direction:\n+                directions[(c['id'], view_id)] = direction\n+    links = _signed(archive, cfg, conn, asked, directions, transport, record)\n+    on_circle = circles(conn, links)\n+    if on_circle:\n+        links = _corrected(archive, cfg, conn, asked, directions, links, on_circle, transport, record)\n+        remaining = circles(conn, links)\n+        if remaining:\n+            record['error'] = 'persistent cycle: ' + '; '.join(' -> '.join(path) for _, path in remaining)\n+            raise Refused(record['error'], record)\n+    record['proposed'] = links\n+    return links, record\n+\n+\n+def _signed(archive, cfg, conn, asked, directions, transport, record, stage='sign'):\n+    jobs, owners = [], []\n+    for c, state, theses in asked:\n+        questions = {f'sign__{v}': sign_question(jev_matching.thesis_text(conn, v), directions[(c['id'], v)], version=cfg.matching.link_questions)\n+                     for v in theses if (c['id'], v) in directions}\n+        if questions:\n+            jobs.append((state, questions))\n+            owners.append(c)\n+    links = []\n+    if not jobs:\n+        return links\n+    for c, reply in zip(owners, _ask(archive, cfg, jobs, transport, record, stage)):\n+        for qid, answer in sorted(reply.items()):\n+            view_id = qid[len('sign__'):]\n+            sign = _passes(answer, (TOGETHER, OPPOSITE))\n+            record['pairs'].append({'candidate': c['id'], 'thesis': view_id, 'sign': answer['choice'], 'probabilities': answer['probabilities']})\n+            if sign:\n+                direction = directions[(c['id'], view_id)]\n+                reader, read = (c['id'], view_id) if direction == CANDIDATE_READS else (view_id, c['id'])\n+                links.append({'reader': reader, 'read': read, 'candidate': c['id'], 'thesis': view_id, 'direction': direction, 'sign': sign})\n+    return links\n+\n+\n+def _corrected(archive, cfg, conn, asked, directions, links, on_circle, transport, record):\n+    \"\"\"PRD 06: refuse a circle and ask the model to correct it, once: the pair's READS question again, the offending direction removed\n+    and the circle named; the answer replaces the original.\"\"\"\n+    offending = {(link['candidate'], link['thesis']): path for link, path in on_circle}\n+    jobs, owners = [], []\n+    for c, state, theses in asked:\n+        questions = {}\n+        for view_id in theses:\n+            path = offending.get((c['id'], view_id))\n+            if path is None:\n+                continue\n+            excluded = directions[(c['id'], view_id)]\n+            named = [('the CANDIDATE' if node == c['id'] else 'the THESIS' if node == view_id else node) for node in path]\n+            note = f'Reading this way would make {named[0]} read itself through {\" -> \".join(named)}; a question cannot read its own conclusion.'\n+            questions[f'reads__{view_id}'] = reads_question(jev_matching.thesis_text(conn, view_id), excluded=excluded, note=note,\n+                                                            version=cfg.matching.link_questions)\n+            record['corrections'].append({'candidate': c['id'], 'thesis': view_id, 'rejected': excluded, 'path': path})\n+        if questions:\n+            jobs.append((state, questions))\n+            owners.append(c)\n+    kept = [link for link in links if (link['candidate'], link['thesis']) not in offending]\n+    corrected = {}\n+    for c, reply in zip(owners, _ask(archive, cfg, jobs, transport, record, 'correction')):\n+        for qid, answer in reply.items():\n+            view_id = qid[len('reads__'):]\n+            directions.pop((c['id'], view_id), None)\n+            direction = _passes(answer, (CANDIDATE_READS, THESIS_READS))\n+            record['corrections'].append({'candidate': c['id'], 'thesis': view_id, 'answer': answer['choice'], 'probabilities': answer['probabilities']})\n+            if direction:\n+                corrected[(c['id'], view_id)] = direction\n+    if corrected:\n+        directions.update(corrected)\n+        regrouped = [(c, state, [v for v in theses if (c['id'], v) in corrected]) for c, state, theses in asked]\n+        kept += _signed(archive, cfg, conn, [g for g in regrouped if g[2]], corrected, transport, record, stage='correction sign')\n+    return kept\n+\n+\n+# ---------- the record ----------\n+\n+def attempt_id(conn, item):\n+    count = conn.execute('select count(distinct attempt_id) from link_selections where input_id=?', (item['input_id'],)).fetchone()[0]\n+    return f'{item[\"input_id\"]}#{count + 1}'\n+\n+\n+def record(conn, attempt, seq, item, cfg, status, content):\n+    store.insert(conn, 'link_selections', attempt_id=attempt, seq=seq, input_id=item['input_id'], config_checksum=cfg.checksum,\n+                 status=status, record_json=json.dumps(content, ensure_ascii=False, sort_keys=True))\ndiff --git a/src/hivemind/views/round.py b/src/hivemind/views/round.py\nindex 744260cb..0bf70e72 100644\n--- a/src/hivemind/views/round.py\n+++ b/src/hivemind/views/round.py\n@@ -7,7 +7,7 @@ import dataclasses\n import json\n \n from .. import dispatch, extraction, vocabulary\n-from . import jev_matching, judging, matching, store, writing\n+from . import jev_matching, judging, links, matching, store, writing\n \n \n @dataclasses.dataclass\n@@ -36,7 +36,7 @@ def _match(conn, archive, cfg, universe, item, seq, result, candidates, evidence\n     \"\"\"One matching call with one retry on a refused check. Returns Checked, or None after marking the failure.\"\"\"\n     note = ''\n     checked = None\n-    engine = jev_matching if cfg.matching.engine == 'jev' else matching      # Jev answers once; a retry would be the same answer\n+    engine = jev_matching if cfg.matching.engine in ('jev', links.ENGINE) else matching      # Jev answers once; a retry would be the same answer\n     for attempt in range(1 if engine is jev_matching else 2):\n         try:\n             options = {'workers': workers, 'llm_transport': transport} if engine is jev_matching else {}     # the collision judge sends with the caller's transport too\n@@ -150,12 +150,27 @@ def run(conn, archive, cfg, universe, item, seq, *, resume_from=None, transport=\n         if checked2 is None:\n             return result\n         second_pass = checked2.evidence\n+    # D694, D695: under the engine jev-links, the reading links between a newly opened number question and the number questions it was\n+    # shown, chosen once matching has settled what opens (views/links.py); recorded per attempt whatever happens next\n+    proposed, attempt = None, None\n+    if cfg.matching.engine == links.ENGINE:\n+        attempt = links.attempt_id(conn, item)\n+        try:\n+            proposed, chosen = links.choose(archive, cfg, conn, handover, checked, lists, shown, transport=transport)\n+        except links.Refused as error:\n+            links.record(conn, attempt, seq, item, cfg, 'failed', error.record)\n+            return _fail(conn, item, seq, result, 'matched', 'linking_refused', 'linking: ' + str(error), 'linking')\n+        links.record(conn, attempt, seq, item, cfg, 'proposed', chosen)\n     dispatch.mark(conn, item, seq, 'matched', 'ok', f'{len(checked.outcomes)} candidates placed')\n     # write, and record what changed in the same commit (a resume at 'judged' reads it)\n     try:\n-        written = writing.write(conn, universe, seq, item, handover, checked, second_pass)\n+        written = writing.write(conn, universe, seq, item, handover, checked, second_pass, proposed_links=proposed)\n     except Exception as error:\n+        if attempt:\n+            links.record(conn, attempt, seq, item, cfg, 'failed', {'error': repr(error)[:300]})\n         return _fail(conn, item, seq, result, 'written', 'writing_failed', 'writing: ' + repr(error), type(error).__name__)\n+    if attempt:\n+        links.record(conn, attempt, seq, item, cfg, 'committed', {'links': written.links})\n     result.new_views = len(set(written.new_views.values()))\n     dispatch.mark(conn, item, seq, 'written', 'ok', json.dumps({'changed': sorted(written.changed_views), 'new': written.new_views, 'notes': written.notes[:20]}, ensure_ascii=False))\n     dispatch.mark(conn, item, seq, 'handed_over', 'ok', '')\ndiff --git a/src/hivemind/views/store.py b/src/hivemind/views/store.py\nindex 10319880..0bd39026 100644\n--- a/src/hivemind/views/store.py\n+++ b/src/hivemind/views/store.py\n@@ -22,7 +22,7 @@ TABLES = {\n     'replacements': 'id integer primary key autoincrement, old_evidence_id text, new_evidence_id text, said_day text, seq integer',   # history: written before D202, read as before\n     'revisions': 'id integer primary key autoincrement, old_evidence_id text, new_evidence_id text, said_day text, seq integer',      # D202: the new piece revises the old; both stay in force\n     'same_claims': 'id integer primary key autoincrement, old_evidence_id text, new_evidence_id text, seq integer',                    # D204: the matcher read the new piece as the same claim as the old; both stored, both in force\n-    'dependencies': 'dependency_id integer primary key autoincrement, view_id text, depends_on text, wait_chain_view_id text, wait_year text, direction text, seq integer',\n+    'dependencies': 'dependency_id integer primary key autoincrement, view_id text, depends_on text, wait_chain_view_id text, wait_year text, direction text, seq integer, kind text default \\'\\'',   # kind: '' (a seed's or the generative matcher's row, read as before) or 'reads' (a chosen reading link, D694)\n     'dependency_resolutions': 'id integer primary key autoincrement, dependency_id integer, resolved_to text, reason text, seq integer',\n     'successions': 'id integer primary key autoincrement, view_id text, succeeds text, seq integer',\n     'handovers': 'id integer primary key autoincrement, input_id text, seq integer, handover_json text',\n@@ -31,6 +31,8 @@ TABLES = {\n     'review_pool_entries': 'id integer primary key autoincrement, kind text, key text, example_json text, seq integer',\n     'late_statements': 'id integer primary key autoincrement, input_id text, evidence_quote text, reason text, seq integer',\n     'days_completed': 'id integer primary key autoincrement, day text, seq integer, at text',\n+    # D694: how the links of an article were chosen (views/links.py), append-only per attempt: proposed, then committed or failed\n+    'link_selections': 'id integer primary key autoincrement, attempt_id text, seq integer, input_id text, config_checksum text, status text, record_json text',\n     # D149 research groups: an ongoing business subject several distinct theses belong to; membership is decided by extraction and written with the thesis\n     'thesis_groups': 'group_id text primary key, name text, scope text, aliases text, created_seq integer, created_from_input text',\n     'thesis_group_members': 'id integer primary key autoincrement, group_id text, view_id text, seq integer, input_id text, basis text',\n@@ -150,6 +152,8 @@ def ensure_writable_columns(conn):\n     for field in ('reference', 'implied_outcome'):\n         if field not in judgement_columns:\n             conn.execute(f'alter table judgements add column {field} text')        # D260: judgements written before the stance fields read as null\n+    if 'kind' not in {r[1] for r in conn.execute('pragma table_info(dependencies)')}:\n+        conn.execute(\"alter table dependencies add column kind text default ''\")   # D694: every row written before reads ''\n \n \n def view_key(conn, view_id):\n@@ -228,7 +232,10 @@ def open_read_only(path):\n \n \n def current_state(conn, view_id):\n-    row = conn.execute('select judgement_id, rung, reasons, changed, seq, publication_day from judgements where view_id=? order by judgement_id desc limit 1', (view_id,)).fetchone()\n+    \"\"\"The latest judgement: rung, reasons, changed, seq and day, and its reference and implied outcome (D260) where the ledger has them.\"\"\"\n+    columns = {r[1] for r in conn.execute('pragma table_info(judgements)')}\n+    stance = ''.join(f', {field}' for field in ('reference', 'implied_outcome') if field in columns)\n+    row = conn.execute(f'select judgement_id, rung, reasons, changed, seq, publication_day{stance} from judgements where view_id=? order by judgement_id desc limit 1', (view_id,)).fetchone()\n     return dict(row) if row else None\n \n \n@@ -249,7 +256,8 @@ def dependencies_of(conn, view_id):\n def direct_parents(conn, view_id, seq=None):\n     \"\"\"The views this view depends on directly (a driver's root, D208; the seeds' depends_on), written at or before `seq` when given.\n     The filing reads it to keep a statement under the narrower of two linked questions (D207's narrowest rule, extraction.file_reading).\"\"\"\n-    rows = conn.execute(\"select depends_on from dependencies where view_id=? and depends_on != '' and (? is null or seq <= ?) order by dependency_id\", (view_id, seq, seq))\n+    reads = \" and coalesce(kind, '') != 'reads'\" if 'kind' in {r[1] for r in conn.execute('pragma table_info(dependencies)')} else ''\n+    rows = conn.execute(f\"select depends_on from dependencies where view_id=? and depends_on != '' and (? is null or seq <= ?){reads} order by dependency_id\", (view_id, seq, seq))\n     return list(dict.fromkeys(r[0] for r in rows))\n \n \ndiff --git a/src/hivemind/views/writing.py b/src/hivemind/views/writing.py\nindex a183fc09..0024a2ca 100644\n--- a/src/hivemind/views/writing.py\n+++ b/src/hivemind/views/writing.py\n@@ -17,6 +17,7 @@ class Written:\n     new_views: dict            # candidate id -> view_id\n     evidence_ids: dict         # handover evidence id -> evidence_id\n     notes: list\n+    links: list = dataclasses.field(default_factory=list)      # D694: the reading links committed, with their final labels\n \n \n def _next_id(conn, table, column, prefix):\n@@ -109,14 +110,17 @@ class WriteConflict(ValueError):\n     \"\"\"The checked plan no longer fits the writable ledger; no partial write is retained.\"\"\"\n \n \n-def write(conn, universe, seq, item, handover, checked, second_pass):\n-    \"\"\"Write atomically within the caller's transaction; the caller commits the completion marker with it.\"\"\"\n+def write(conn, universe, seq, item, handover, checked, second_pass, *, proposed_links=None):\n+    \"\"\"Write atomically within the caller's transaction; the caller commits the completion marker with it. proposed_links: the reading\n+    links the link step chose (views/links.py, D694), written after the new views exist; None writes none.\"\"\"\n     if not conn.in_transaction:\n         conn.execute('begin immediate')\n     conn.execute('savepoint view_write')\n     try:\n         store.ensure_writable_columns(conn)\n         result = _write(conn, universe, seq, item, handover, checked, second_pass)\n+        if proposed_links:\n+            result.links = _write_links(conn, seq, proposed_links, result)\n     except Exception:\n         conn.execute('rollback to view_write')\n         conn.execute('release view_write')\n@@ -125,6 +129,36 @@ def write(conn, universe, seq, item, handover, checked, second_pass):\n     return result\n \n \n+def _write_links(conn, seq, proposed_links, written):\n+    \"\"\"D694, D695 (design §4): each proposed link resolved to stored ids, re-checked against the ledger as it stands inside this write\n+    (both ends open, no circle, no other label on the same pair), labelled from the stored rungs, written with kind 'reads'. An existing\n+    question that gains a link is judged in the day's round. Any mismatch refuses the whole write.\"\"\"\n+    from . import links as _links\n+    committed = []\n+    for link in proposed_links:\n+        reader, read = (written.new_views.get(link[end], link[end]) for end in ('reader', 'read'))\n+        for end in (reader, read):\n+            if not store.view(conn, end):\n+                raise WriteConflict(f'link {link[\"reader\"]} -> {link[\"read\"]}: {end} was not opened')\n+            if not store.is_open(conn, end):\n+                raise WriteConflict(f'link {reader} -> {read}: {end} is closed')\n+        label = _links.label_for(store.rungs_of(conn, reader), store.rungs_of(conn, read), link['sign'])\n+        if label is None:\n+            raise WriteConflict(f'link {reader} -> {read}: no label can be computed from the stored rungs')\n+        existing = {r['direction'] for r in conn.execute('select direction from dependencies where view_id=? and depends_on=?', (reader, read))}\n+        if existing and existing != {label}:\n+            raise WriteConflict(f'link {reader} -> {read}: the pair already carries another label {sorted(existing)}')\n+        if existing:\n+            continue\n+        if store.would_cycle(conn, reader, read):\n+            raise WriteConflict(f'link {reader} -> {read}: would close a circle')\n+        store.insert(conn, 'dependencies', view_id=reader, depends_on=read, wait_chain_view_id='', wait_year='', direction=label, seq=seq, kind=_links.KIND)\n+        if reader not in written.new_views.values():\n+            written.changed_views.add(reader)\n+        committed.append({'reader': reader, 'read': read, 'label': label, 'sign': link['sign'], 'direction': link['direction']})\n+    return committed\n+\n+\n def _write(conn, universe, seq, item, handover, checked, second_pass):\n     \"\"\"second_pass: {(handover evidence id, view_id): (outcome, target_evidence_id, said_day)} for candidate-linked\n     evidence compared after the candidates' destinations were known (new views' evidence is simply new).\"\"\"\n","exit_code":0,"status":"completed"}}
