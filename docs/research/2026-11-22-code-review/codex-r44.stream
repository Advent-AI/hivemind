anifests/day-2026-07-02.json\npoc/data/e2e-v69-dev14-d3/manifests/day-2026-07-05.json\npoc/data/e2e-v69-dev14-d3/manifests/day-2026-07-13.json\npoc/data/e2e-v69-dev14-d3/manifests/day-2026-07-09.json\npoc/data/e2e-v69-dev14-d3/manifests/day-2026-07-08.json\npoc/data/e2e-v69-dev14-d3/manifests/day-2026-07-12.json\npoc/data/e2e-v69-dev14-d3/manifests/day-2026-07-04.json\npoc/data/e2e-v69-dev14-d3/manifests/day-2026-07-11.json\npoc/data/e2e-v69-dev14-d3/manifests/day-2026-07-07.json\n40:create table if not exists model_calls (\n42:  request_sha256 text unique, request_json text, response_json text, answer_json text, prompt_chars integer,\n45:create index if not exists model_calls_sha on model_calls(request_sha256);\n81:            return self.conn.execute('select call_id, answer_json, prompt_chars, input_tokens, output_tokens from model_calls where request_sha256=?', (sha,)).fetchone()\n88:            cursor = self.conn.execute(f'insert or ignore into model_calls ({\",\".join(columns)}) values ({\",\".join(\"?\" * len(columns))})',\n92:                return self.conn.execute('select call_id from model_calls where request_sha256=?', (fields['request_sha256'],)).fetchone()[0]\n99:            self.conn.execute(\"update model_calls set request_sha256 = request_sha256 || ':refused:' || ? where call_id=? and request_sha256 not like '%:refused:%'\",\n105:            return self.conn.execute('select count(*), coalesce(sum(cost_usd),0), coalesce(sum(input_tokens),0), coalesce(sum(output_tokens),0) from model_calls').fetchone()\n256:    request_json, sha = request_identity(request)\n270:                       request_sha256=sha + ':malformed:' + uuid.uuid4().hex[:8], request_json=request_json,\n282:                             request_sha256=sha if not errors else sha + ':schema:' + uuid.uuid4().hex[:8], request_json=request_json,\n19:def open_ledger(path):\n24:def default_as_of(conn):\n33:    def __init__(self):\n40:    def __init__(self, requested, last_completed_day):\n48:    def __init__(self, start, end):\n53:def first_day_unfinished(conn):\n57:def resolve_bound(conn, bound, *, unfiltered=False):\n74:def resolve_range(conn, start, end):\n88:def seq_day_map(conn):\n107:def day_of_seq(conn, seq):\n111:def visible(conn, seq, as_of):\n118:def view_exists(conn, record, as_of):\n122:def is_open_as_of(conn, view_id, as_of):\n129:def state_as_of(conn, view_id, as_of):\n145:def summaries(conn, as_of=None, include_closed=False):\n147:    dependency and dependant ids): what a search ranks. The full record with its evidence counts is `view`; listing\n160:                    'dependencies': [d['view_id'] for d in dependencies(conn, record['view_id'], as_of)], 'dependants': dependants(conn, record['view_id'], as_of)})\n164:def views(conn, object_id=None, as_of=None, include_closed=False):\n178:def dependencies(conn, view_id, as_of):\n179:    \"\"\"The view's dependencies recorded on or before the day, each pointing at the target resolved on or before it.\"\"\"\n181:    for dep in conn.execute('select * from dependencies where view_id=? order by dependency_id', (view_id,)):\n185:        for res in conn.execute('select resolved_to, seq from dependency_resolutions where dependency_id=? order by id desc', (dep['dependency_id'],)):\n193:def dependants(conn, view_id, as_of):\n195:    direct = [r['view_id'] for r in conn.execute('select view_id, seq from dependencies where depends_on=?', (view_id,)) if visible(conn, r['seq'], as_of)]\n196:    resolved = [r['view_id'] for r in conn.execute('select d.view_id, r.seq from dependency_resolutions r join dependencies d on d.dependency_id=r.dependency_id where r.resolved_to=?', (view_id,)) if visible(conn, r['seq'], as_of)]\n200:def view(conn, view_id, as_of=None, record=None):\n217:        'dependencies': dependencies(conn, view_id, as_of), 'dependants': dependants(conn, view_id, as_of),\n224:def evidence_record(conn, evidence_id, as_of, arrived_seq=None):\n238:def evidence(conn, view_id, as_of=None, tier=None):\n257:def history(conn, view_id, from_day=None, to_day=None):\n296:def open_pinned(path):\n312:def _unique(ids):\n323:def _json(text):\n334:def record(conn, view_id, as_of=None):\n348:def changes(conn, since_day, to_day=None):\n385:def _comparators(clause):\n404:def operative_clause(condition):\n422:def _amounts(text):\n436:def band(condition):\n446:    def next_amount(after):\n487:def numeric_bands(rungs):\n499:def ladder_bands(rungs):\n523:def _contains(b, yi):\n528:def verdict_for(comparator, judged, yi):\n542:def evaluate(conn, view_id, comparator, value_usd, as_of=None):\n    13\t@dataclasses.dataclass\n    14\tclass RoundResult:\n    15\t    input_id: str\n    16\t    evidence: int = 0\n    17\t    candidates: int = 0\n    18\t    new_views: int = 0\n    19\t    judged: int = 0\n    20\t    changed: int = 0\n    21\t    cost: float = 0.0\n    22\t    cached_calls: int = 0\n    23\t    failed: str = ''\n    24\t    dropped: int = 0\n    25\t\n    26\t\n    27\tdef _fail(conn, item, seq, result, step, kind, detail, pool_key):\n    28\t    dispatch.mark(conn, item, seq, step, 'failed', detail[:300])\n    29\t    store.pool(conn, kind, pool_key, {'input_id': item['input_id'], 'error': detail[:300]}, seq)\n    30\t    result.failed = detail[:200]\n    31\t    conn.commit()\n    32\t    return result\n    33\t\n    34\t\n    35\tdef _match(conn, archive, cfg, universe, item, seq, result, candidates, evidence, lists, shown, *, extra_views=(), call_offset=0, transport=None, workers=1):\n    36\t    \"\"\"One matching call with one retry on a refused check. Returns Checked, or None after marking the failure.\"\"\"\n    37\t    note = ''\n    38\t    checked = None\n    39\t    engine = jev_matching if cfg.matching.engine in ('jev', links.ENGINE) else matching      # Jev answers once; a retry would be the same answer\n    40\t    for attempt in range(1 if engine is jev_matching else 2):\n    41\t        try:\n    42\t            options = {'workers': workers, 'llm_transport': transport} if engine is jev_matching else {}     # the collision judge sends with the caller's transport too\n    43\t            answer = engine.decide(archive, cfg, conn, item, candidates, evidence, lists, shown, extra_views=extra_views, retry_note=note, transport=transport, **options)\n    44\t        except Exception as error:\n    45\t            _fail(conn, item, seq, result, 'matched', 'matching_failed', 'matching: ' + repr(error), type(error).__name__)\n    46\t            return None\n    47\t        result.cost += answer.cost_usd\n    48\t        result.cached_calls += int(answer.cached)\n    49\t        checked = matching.check(conn, universe, answer.data, candidates, evidence, lists, shown)\n    50\t        shown_record = {'candidates': lists.candidate_lists, 'evidence': {f'{k[0]}|{k[1]}': v for k, v in lists.evidence_lists.items()}}\n    51\t        if getattr(answer, 'request_records', None):\n    52\t            shown_record['requests'] = answer.request_records\n    53\t        store.insert(conn, 'match_records', seq=seq, input_id=item['input_id'], call_no=call_offset + attempt + 1,\n    97\tdef run(conn, archive, cfg, universe, item, seq, *, resume_from=None, transport=None, log=print, extractor=None, matching_workers=1):\n    98\t    result = RoundResult(item['input_id'])\n    99\t    if resume_from in ('judged', 'handed_over'):       # written already; judging is the day's step\n   100\t        dispatch.mark(conn, item, seq, 'handed_over', 'ok', 'resumed')\n   101\t        conn.commit()\n   102\t        return result\n   103\t    objects = [o['value'] for o in item.get('object_identifiers') or [] if universe.has(o['value'])]\n   104\t    shown = extraction.shown_views(conn, cfg, item, objects)\n   105\t    # extraction (or its stored handover on resume)\n   106\t    handover = None\n   107\t    if resume_from and resume_from != 'extracted':\n   108\t        row = conn.execute('select handover_json from handovers where input_id=? order by id desc limit 1', (item['input_id'],)).fetchone()\n   109\t        if row:\n   110\t            saved = vocabulary.extraction_answer(json.loads(row['handover_json']))          # a handover saved by a Chinese version reads in the canonical vocabulary\n   111\t            handover = extraction.Handover(saved['evidence'], saved['candidates'], saved['dropped'], 0, '', True, 0.0, saved.get('new_groups') or [])\n   112\t    if handover is None:\n   113\t        try:\n   114\t            handover = (extractor or extraction.extract)(archive, cfg, item, item['text'], shown, universe, transport=transport)\n   115\t        except Exception as error:\n   116\t            return _fail(conn, item, seq, result, 'extracted', 'extraction_failed', 'extraction: ' + repr(error), type(error).__name__)\n   117\t        result.cost += handover.cost_usd\n   118\t        result.cached_calls += int(handover.cached)\n   119\t        store.insert(conn, 'handovers', input_id=item['input_id'], seq=seq,\n   120\t                     handover_json=json.dumps({'evidence': handover.evidence, 'candidates': handover.candidates, 'dropped': handover.dropped, 'new_groups': handover.new_groups}, ensure_ascii=False))\n   121\t        dispatch.mark(conn, item, seq, 'extracted', 'ok', f'{len(handover.evidence)} evidence, {len(handover.candidates)} candidates, {len(handover.dropped)} dropped')\n   150\t        if checked2 is None:\n   151\t            return result\n   152\t        second_pass = checked2.evidence\n   153\t    # D694, D695: under the engine jev-links, the reading links between a newly opened number question and the number questions it was\n   154\t    # shown, chosen once matching has settled what opens (views/links.py); recorded per attempt whatever happens next\n   155\t    proposed, attempt = None, None\n   156\t    if cfg.matching.engine == links.ENGINE:\n   157\t        attempt = links.attempt_id(conn, item)\n   158\t        try:\n   159\t            proposed, chosen = links.choose(archive, cfg, conn, handover, checked, lists, shown, transport=transport)\n   160\t        except links.Refused as error:\n   161\t            links.record(conn, attempt, seq, item, cfg, 'failed', error.record)\n   162\t            return _fail(conn, item, seq, result, 'matched', 'linking_refused', 'linking: ' + str(error), 'linking')\n   163\t        except Exception as error:                     # any other failure of the link step is recorded like a matching failure\n   164\t            links.record(conn, attempt, seq, item, cfg, 'failed', {'error': repr(error)[:300]})\n   165\t            return _fail(conn, item, seq, result, 'matched', 'linking_failed', 'linking: ' + repr(error), type(error).__name__)\n   166\t        links.record(conn, attempt, seq, item, cfg, 'proposed', chosen)\n   167\t    dispatch.mark(conn, item, seq, 'matched', 'ok', f'{len(checked.outcomes)} candidates placed')\n   168\t    # write, and record what changed in the same commit (a resume at 'judged' reads it)\n   169\t    try:\n   170\t        written = writing.write(conn, universe, seq, item, handover, checked, second_pass, proposed_links=proposed)\n   171\t    except Exception as error:\n   172\t        if attempt:\n   173\t            links.record(conn, attempt, seq, item, cfg, 'failed', {'error': repr(error)[:300]})\n   174\t        return _fail(conn, item, seq, result, 'written', 'writing_failed', 'writing: ' + repr(error), type(error).__name__)\n   175\t    if attempt:\n   176\t        links.record(conn, attempt, seq, item, cfg, 'committed', {'links': written.links})\n   177\t    result.new_views = len(set(written.new_views.values()))\n   178\t    dispatch.mark(conn, item, seq, 'written', 'ok', json.dumps({'changed': sorted(written.changed_views), 'new': written.new_views, 'notes': written.notes[:20]}, ensure_ascii=False))\n   179\t    dispatch.mark(conn, item, seq, 'handed_over', 'ok', '')\n   180\t    conn.commit()\n   181\t    return result\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_31","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba docs/DECISIONS-log.md | sed -n '10720,10756p;10800,10826p'\nnl -ba docs/research/2026-11-20-production-readiness/dependency-design/DESIGN.md | sed -n '9,27p;149,180p'\nrg -n 'poc-v121|judging-v12' scripts src/hivemind clean-arch --glob '*.py' | head -70\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_31","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba docs/DECISIONS-log.md | sed -n '10720,10756p;10800,10826p'\nnl -ba docs/research/2026-11-20-production-readiness/dependency-design/DESIGN.md | sed -n '9,27p;149,180p'\nrg -n 'poc-v121|judging-v12' scripts src/hivemind clean-arch --glob '*.py' | head -70\"","aggregated_output":" 10720\t\n 10721\t## D714 · 2026-11-21 · judging-v12 and poc-v121 built; every registered $0 check passes; the paid acceptance step is Alex's\n 10722\t\n 10723\t- **Built (uncommitted):**\n 10724\t  - `judging.py`: v12, its closed format, `request_parts`, `check_answer`'s lists, and the round's per-view format;\n 10725\t  - `model.check_schema`: `maxItems`;\n 10726\t  - `prompts/judging-v12.txt`: a v7 copy;\n 10727\t  - `poc/config/poc-v121.json`;\n 10728\t  - preflight: part A on saved judge formats, and an exit on a missing one;\n 10729\t  - tests: `tests/test_citation_lists.py` (7) and the frozen pins.\n 10730\t- **Checks:** suite 388 passed (the frozen tests included); mutants 12 of 12 caught; `docs/check.py` OK.\n 10731\t- **The $0 test** (`docs/research/2026-11-21-citation-lists/RESULT.md`):\n 10732\t  - **T1:** old-2 replayed under poc-v121. 1,616 judge responses, 4 labelled substitutions, 0 request or list problems; the store\n 10733\t    equals old-2's on all 36 shared tables, apart from the named columns.\n 10734\t  - **T1b:** the four refused originals raise `SchemaError` on their bad ids.\n 10735\t  - **T1c, T3, T3b, T5:** pass.\n 10736\t  - **T2:** 5,408 distinct pairs; all 5,391 valid answers pass; all 17 refused fail on their bad id (e362, e3111 among them).\n 10737\t  - **T4:** the largest request in the five archives is 464 enum values counted once (915 per reference); in the sealed D358 run, 676\n 10738\t    (1,323 per reference).\n 10739\t  - **Format tokens** (an o200k_base estimate): v7 315; v12 median 502, max 2,621.\n 10740\t- **Deviations, disclosed in RESULT.md:**\n 10741\t  - T1's first comparison crashed (FTS tables have no rowid). Three differences were named only after they were seen: a timestamp, an\n 10742\t    empty new table, a new column on an empty table. T1 was rerun in full.\n 10743\t  - Run 2's summary print failed after its passing results were saved; the print is fixed.\n 10744\t  - Preflight's malformed-row ordering was found by council round 39 and fixed, with a mutant.\n 10745\t  - A mistaken `t1_replay.py --help` started a stray replay into `./--help`. It was stopped, the folder was moved to the session\n 10746\t    scratchpad, and the script now refuses an option as its folder.\n 10747\t- **Council round 39** (`codex-r39.md`): the build matches DESIGN v3, no v7/v8 regression; its findings taken.\n 10748\t- **Not shown** (DESIGN §6):\n 10749\t  - provider acceptance of the format and its counting of a referenced enum;\n 10750\t  - whether the judge, constrained, cites the intended source;\n 10751\t  - whether forecasts move.\n 10752\t\n 10753\t  A paid step answers these, and it is Alex's (D712): acceptance on the largest and an empty-list request, then the 17 refused\n 10754\t  requests and a matched set of accepted ones under v12, read beside their sources.\n 10755\t\n 10756\t## D715 · 2026-11-22 · Alex approves $0.50 for the paid acceptance step of judging-v12\n 10800\t\n 10801\t- **Run:** `poc/data/citation-probe-2026-11-22/`, $0.274 of $0.50, 122 sends, all answered. A2 skipped by its headroom rule; the\n 10802\t  647-id request size stays unverified.\n 10803\t- **Verdict** (PROBE-DESIGN.md v5 §3, `probe_read.py`): NOT READY, from a confirmed material harm in Part C, linked-1:8776 (b). v12\n 10804\t  answers #2 and #3 name Bloomberg for the $393 billion reference while citing only e669 (Wall Street's average via Yahoo Finance);\n 10805\t  every v7 answer cites e195 (Bloomberg). The number and rung held.\n 10806\t- **Reading:**\n 10807\t  - Claude's first reading (\"not a harm\") was superseded.\n 10808\t  - The blind Codex reader found harm (b).\n 10809\t  - The registered two-family adjudication panel agreed: a fresh Codex session, and a fresh Claude subagent whose report (2026-11-22)\n 10810\t    decided \"confirmed (b)\", omitted for the four Part B items, with the caveat that e577 might carry the figure. It does not: e577 is\n 10811\t    FY2026 revenue.\n 10812\t- **Beside the verdict:**\n 10813\t  - Part B: 48 of 48 v12 answers valid on the 16 requests that had produced 17 refusals; 0 misattributions; every material target\n 10814\t    supported in all draws; 24 of 24 placements correct.\n 10815\t  - Part C: 0 refusals; 72 rungs identical across arms; v12 cites 12.7 entries per answer against 14.0.\n 10816\t  - A screen for unsupported source names, hand-checked: Part C v12 2 of 36 against v7 1 of 36, all from one request; Part B v12 1 of\n 10817\t    48. The slip exists in both formats, and the counts cannot tell whether v12 raises it. A first screen mis-flagged linked-1:8768\n 10818\t    (the dependency v14 carries the figure) and was corrected.\n 10819\t- **Council B** (`codex-r42.md`): verdict reproduced; recommendation A, keep poc-v118 and do not adopt judging-v12. A follow-up would\n 10820\t  need fresh requests with one figure attributed to different sources, paired sends, blind source checks, a pre-agreed acceptable\n 10821\t  increase, a size set by distinct requests, and dropped claims counted.\n 10822\t- **Lesson:** a reading that relaxes a registered rule to the author's favour (an \"uncited provenance label\" distinction the rule does\n 10823\t  not contain) is caught only by the blind reader and the adjudication; the first reader's class is never final.\n 10824\t\n 10825\t## D719 · 2026-11-22 · Alex stops the citation line: judging-v12 is not adopted; poc-v118 stays the product\n 10826\t\n     9\t## 0. Versions and entry points\n    10\t\n    11\t- `poc/config/poc-v119.json`: poc-v118 with `matching.engine` `jev-links` and `rejudging.prompt_version` `judging-v8`; nothing else.\n    12\t- `poc/config/poc-v120.json` (D705): poc-v119 with `matching.link_questions` `links-v2`, version 2 of the READS and SIGN texts\n    13\t  (`docs/research/2026-11-21-whole-window/WORDING-V2.md` §5); poc-v119 reads `links-v1` by default and is unchanged.\n    14\t- `judging-v8.txt` is a byte copy of `judging-v7.txt`; only the code-built dependency block differs (§3). A request with no dependency is\n    15\t  byte-equal under v7 and v8.\n    16\t- `config.ENGINES` gains `jev-links`. Every place that tests `engine == 'jev'` (`round._match`, `scripts/replay.py`,\n    17\t  `parallel_day.ParallelDay`, `budget_replay.py` defaults) treats `jev-links` as Jev; only `round.run` asks the link questions, and only\n    18\t  under `jev-links`. Existing Jev requests are unchanged (`jev.request_for` holds model, state and questions only).\n    19\t- **Who may run poc-v119 (an enforced boundary):** only the July harness (`TEST-PLAN.md`). `scripts/replay.py` and\n    20\t  `budget_replay.py` refuse a configuration whose matching engine is `jev-links` (\"not a product entry point in this version\"). The\n    21\t  harness holds `live_lock.acquire` on each sequence's store for the whole run, refuses a store whose last day is unfinished, and never\n    22\t  resumes a sequence that stopped: a stopped sequence is final and reported as stopped. Each harness ledger is **marked harness-only**\n    23\t  before the run (a table `harness_only` holding the harness's name and the date), and both ordinary writers refuse it under any\n    24\t  configuration before routing an item (`scripts/replay.py`'s `refuse_harness_ledger`, called beside `refuse_seeded_ledger`, which\n    25\t  `budget_replay.py` already calls); read-only inspection stays open. So the serial path's unchecked restarts (a\n    26\t  sequence reused under another configuration or input, a second writer) cannot reach a v119 store. Making poc-v119 runnable from the\n    27\t  product entry point is a later decision, with its own restart rules.\n   149\t- Worked case (old-2 07-10): R = v9 (direction −1, Strongly bullish first: favourable end high), T = v14 (−1), `together` → T's high\n   150\t  end = its first rung → `first_is_bullish`. Changing only the sign, only R's direction (its favourable end kept first), or only T's\n   151\t  direction each gives `last_is_bullish`; R stored reversed with its labels (favourable end last, direction +1) keeps the favourable\n   152\t  end high and gives `first_is_bullish`.\n   153\t- Eligibility (§1) already requires both directions decided, so a label is always defined for an asked pair.\n   154\t\n   155\t## 6. Table 1: state × event (C new in this article, T open and shown)\n   156\t\n   157\t\"Resumable\" below is the product path's behaviour; for poc-v119, whose only entry point is the July harness, a stopped sequence is final\n   158\t(§0).\n   159\t\n   160\t| Event | Outcome |\n   161\t|---|---|\n   162\t| matching settles C as `new`/`succession`; the pair is eligible; READS and SIGN pass | link proposed; graph check; written in C's commit; reader judged in that day's round after the read question, if eligible (D59) |\n   163\t| READS `neither` / below 0.5; SIGN `no_clear_sign` / below 0.5 | no link; recorded |\n   164\t| C merges into an existing question, is skipped or not opened, or coalesces with another candidate | not asked, or asked once for the canonical candidate |\n   165\t| a pair not eligible (theme, event, two-rung, untyped or shuffled bounds, same article) | not asked (D695) |\n   166\t| a proposed link closes a circle (with stored links, or among the article's own proposals) | one correction request per link on it; a remaining circle fails the article at `matched`, resumable |\n   167\t| the store holds an unbound waiting row | the link step refuses: the article fails at `matched` with that reason |\n   168\t| `jev.ask` fails (transport, answer shape) | the article fails at `matched`, resumable; a resume re-asks what the archive lacks |\n   169\t| the plan no longer fits at write time (T closed in between, a circle) | `WriteConflict`; the article fails, resumable |\n   170\t| a crash after selection and before the write | resume re-runs matching and selection from the archive (no new send) and writes once |\n   171\t| a crash after the write | the link is in the article's commit; a resumed day's round rebuilds its queue (`queued_by_ledger`) |\n   172\t| T's conclusion changes in a round | its reader queued once, after it (`queued_by_change`) |\n   173\t| T's comparison point changes with `changed=true` | the reader is queued in the same round and sees it |\n   174\t| T's comparison point changes with `changed=false` | the reader sees it at its next judgement (§3) |\n   175\t| T closes | the reader keeps reading T's closing conclusion marked \"closed\" (PRD 06's numeric branch) |\n   176\t| the reader closes | not judged; the row stays as history |\n   177\t| a later article shows C and T again | not asked: neither is new (two open questions are a later version) |\n   178\t| an awaited (waiting) row in the store | this version writes none; the admission rule above refuses a store holding one |\n   179\t| a second process writing the same store | refused: the harness holds `live_lock.acquire` on each sequence's store for the run, and v119 has no other entry point (§0) |\n   180\t| a process dies after a provider attempt and before its answer reaches the archive | a death before settlement leaves the reservation counted against the ceiling (`SharedLedger.reserve`); a death after settlement leaves the settled charge counted; the sequence is stopped and final (§0), so no retry is free |\nscripts/preflight.py:61:    \"\"\"The answer format a judge request was sent with (judging-v12's differs per request, D713), or None when the row has none.\"\"\"\nsrc/hivemind/views/judging.py:7:judging-v12 (D713: v7's text and request; the answer's id fields take only the ids the request lists, and the check reads the same\nsrc/hivemind/views/judging.py:30:SUPPORTED_VERSIONS = ('judging-v7', 'judging-v8', 'judging-v12')   # D354: the frozen judging prompt; D694: v8 = v7's text with the fuller dependency block; D712/D713: v12 = v7's text and request with closed id lists\nsrc/hivemind/views/judging.py:32:CLOSED_LISTS = ('judging-v12',)   # the answer's id fields take the ids the request lists (D713)\nsrc/hivemind/views/judging.py:59:    \"\"\"The answer's format. Under judging-v12 (D713) its four id fields take the ids the request lists (`lists`, from\nsrc/hivemind/views/judging.py:261:    closed or opened since); without it, against what the ledger would show now. lists (judging-v12, D713): the ids the request\nscripts/replay.py:72:NOT_ADOPTED_JUDGING = ('judging-v12',)     # D719: built and kept, not adopted; no product launcher runs it\nscripts/replay.py:76:    \"\"\"D719: a configuration whose re-judging names a version that is built but not adopted (judging-v12, poc-v121) is refused by an\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_32","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"rg --files --hidden --no-ignore poc/data -g 'archive.sqlite' | rg 'frozen-v108|v118|old-2' | head -28\nnl -ba src/hivemind/views/store.py | sed -n '54,81p'\nnl -ba src/hivemind/config.py | sed -n '101,128p'\nnl -ba src/hivemind/parallel_day.py | sed -n '151,190p'\nrg -n 'No |nothing|citation line|3ba40d8f' docs/CURRENT_STATE.md | tail -12\nnl -ba src/hivemind/research_context.py | sed -n '30,46p'\nrg -n 'poc-v118' docs/research/2026-11-20-production-readiness/RESULT.md\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_32","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"rg --files --hidden --no-ignore poc/data -g 'archive.sqlite' | rg 'frozen-v108|v118|old-2' | head -28\nnl -ba src/hivemind/views/store.py | sed -n '54,81p'\nnl -ba src/hivemind/config.py | sed -n '101,128p'\nnl -ba src/hivemind/parallel_day.py | sed -n '151,190p'\nrg -n 'No |nothing|citation line|3ba40d8f' docs/CURRENT_STATE.md | tail -12\nnl -ba src/hivemind/research_context.py | sed -n '30,46p'\nrg -n 'poc-v118' docs/research/2026-11-20-production-readiness/RESULT.md\"","aggregated_output":"poc/data/e2e-r9-frozen-v108-2026-11-03/d2/archive.sqlite\npoc/data/e2e-r9-frozen-v108-2026-11-03/d3/archive.sqlite\npoc/data/e2e-r9-frozen-v108-2026-11-03/d1/archive.sqlite\npoc/data/comparison-2026-11-17/run/old-2/prod/archive.sqlite\npoc/data/clean-ladder-stage-a-2026-11-10/probe-direction/old-2/archive.sqlite\npoc/data/merge-test-2026-11-19/judge-hybrid/old-2/archive.sqlite\npoc/data/merge-test-2026-11-19/judge-control/old-2/archive.sqlite\npoc/data/merge-test-2026-11-19/judge-replaycheck/old-2/archive.sqlite\npoc/data/hybrid-2026-11-20/window/old-2/replay/archive.sqlite\n    54\t]\n    55\t\n    56\t\n    57\tdef open_db(path):\n    58\t    os.makedirs(os.path.dirname(os.path.abspath(path)), exist_ok=True)\n    59\t    conn = sqlite3.connect(path)\n    60\t    conn.row_factory = sqlite3.Row\n    61\t    for name, columns in TABLES.items():\n    62\t        conn.execute(f'create table if not exists {name} ({columns})')\n    63\t        conn.execute(f\"create trigger if not exists {name}_no_update before update on {name} begin select raise(abort, 'append-only'); end\")\n    64\t        conn.execute(f\"create trigger if not exists {name}_no_delete before delete on {name} begin select raise(abort, 'append-only'); end\")\n    65\t    for statement in INDEXES:\n    66\t        conn.execute(statement)\n    67\t    ensure_writable_columns(conn)\n    68\t    conn.execute(\"create virtual table if not exists views_fts using fts5(view_id unindexed, text, tokenize='trigram')\")\n    69\t    conn.execute(\"create virtual table if not exists groups_fts using fts5(group_id unindexed, text, tokenize='trigram')\")\n    70\t    conn.execute('create index if not exists members_view on thesis_group_members(view_id)')\n    71\t    conn.commit()\n    72\t    return conn\n    73\t\n    74\t\n    75\tdef insert(conn, table, **fields):\n    76\t    columns = list(fields)\n    77\t    cursor = conn.execute(f'insert into {table} ({\",\".join(columns)}) values ({\",\".join(\"?\" * len(columns))})', [fields[c] for c in columns])\n    78\t    return cursor.lastrowid\n    79\t\n    80\t\n    81\t# ---------- views ----------\n   101\t\n   102\t\n   103\tdef load(path):\n   104\t    with open(path, encoding='utf-8') as handle:\n   105\t        text = handle.read()\n   106\t    raw = json.loads(text)\n   107\t    for key in ('version', 'provider', 'search_top_n', 'extraction', 'matching', 'rejudging', 'final_verdict'):\n   108\t        if key not in raw:\n   109\t            raise ConfigError(f'config lacks {key}')\n   110\t    canonical = json.dumps({k: v for k, v in raw.items() if not k.startswith('_')}, sort_keys=True, ensure_ascii=False)\n   111\t    checksum = hashlib.sha256(canonical.encode('utf-8')).hexdigest()[:16]\n   112\t    extraction = {category: _setting(f'extraction.{category}', setting) for category, setting in raw['extraction'].items()}\n   113\t    matching, rejudging = _setting('matching', raw['matching']), _setting('rejudging', raw['rejudging'])\n   114\t    idea = _setting('idea', raw['idea']) if 'idea' in raw else None\n   115\t    idea_summary = _setting('idea_summary', raw['idea_summary']) if 'idea_summary' in raw else None\n   116\t    if idea_summary is not None and idea is None:\n   117\t        raise ConfigError('idea_summary requires an idea setting')\n   118\t    collision = _setting('collision', raw['collision']) if 'collision' in raw else None\n   119\t    placement = _setting('placement', raw['placement']) if 'placement' in raw else None\n   120\t    baseline = _setting('baseline', raw['baseline']) if 'baseline' in raw else None\n   121\t    _prompt_files(extraction, matching, rejudging, idea, idea_summary, collision, placement)       # final_verdict is kept in the file but no POC step calls it\n   122\t    if baseline is not None and not os.path.exists(prompt_path(baseline.prompt_version + '.json')):\n   123\t        raise ConfigError(f'baseline: prompt {baseline.prompt_version}.json does not exist')\n   124\t    return Config(version=str(raw['version']), checksum=checksum, provider=str(raw['provider']),\n   125\t                  search_top_n=int(raw['search_top_n']), extraction=extraction,\n   126\t                  matching=matching, rejudging=rejudging, final_verdict=_setting('final_verdict', raw['final_verdict']), idea=idea, idea_summary=idea_summary, collision=collision, placement=placement,\n   127\t                  baseline=baseline)\n   151\t            validate_inputs()\n   152\t            self._event(item['input_id'], 'reextracted', request=current_key)\n   153\t            return extraction.file_reading(reading, item, shown)\n   154\t\n   155\t        try:\n   156\t            fill()\n   157\t            for item, route in items:\n   158\t                self._event(item['input_id'], 'turn')\n   159\t                result = rounds.run(conn, archive, frozen_cfg, frozen_universe, item, route.sequence_no, resume_from=route.resume_from,\n   160\t                                    transport=transport, log=log, extractor=accepted_extraction, matching_workers=self.jev_workers)\n   161\t                self._event(item['input_id'], 'failed' if result.failed else 'accepted')\n   162\t                yield result\n   163\t                if result.failed:\n   164\t                    return\n   165\t                pending.pop(item['input_id'], None)\n   166\t                refresh()\n   167\t                fill()\n   168\t        finally:\n   169\t            # Running calls may still archive a response; none can become a handover here.\n   170\t            for _, _, future, _ in pending.values():\n   171\t                future.cancel()\n   172\t            pool.shutdown(wait=True, cancel_futures=True)\n   173\t            for input_id, future in prepared_futures:\n   174\t                if not future.cancelled() and future.exception() is not None:\n   175\t                    self._event(input_id, 'speculative_error', error=type(future.exception()).__name__)\n348:  apply line 6's decline rules to the outcome's words. No sourced rule for the main part of a multi-part topic survived review\n386:  questions and 1 authority case (Taiwan p3). No decision settles whether \"not by the due day\" rules an event out. The step and the\n396:- **The live store's proof build (D594 to D597; nothing deployed, no service restarted):**\n449:- Alex closed the double-count design with nothing changed (D722, 2026-11-22; his words are in the decision log). poc-v118 stays\n453:- The citation line stays stopped (D719).\n454:- judging-v12 and poc-v121 are committed locally (3ba40d8f) and unused: the ordinary launchers refuse judging-v12 (D723).\n546:  - **No fresh test exists on this corpus.** The judge's errors sit in about ten numeric bets the design has read; 27 fresh bets gave\n559:  - No opening test is sent.\n688:  the No does not; a reported amount carried as the market's expectation, and an expected range the field cannot hold; a\n817:  open\" because nothing is settled yet (Kyber); figure questions with no reference figure the evidence cannot size (19\n904:  (`docs/research/2026-11-14-use-acceptance/TRIAL-RESULT.md`); Alex asked for a leaner path (small steps, each run fast). D487: step 1 built nothing (the\n926:No long job is running.\n    30\t\n    31\t    def rows(self, sql, args=()):\n    32\t        return [dict(r) for r in self.db.execute(sql, args)]\n    33\t\n    34\t    def dependencies(self, vid):\n    35\t        result = self.rows('select dependency_id, view_id, depends_on, wait_chain_view_id, wait_year, direction, seq from dependencies '\n    36\t                           'where view_id=? and seq<? order by seq,dependency_id', (vid,self.seq))     # these columns only: the response carries no kind\n    37\t        for dep in result:\n    38\t            res = self.rows('select * from dependency_resolutions where dependency_id=? and seq<? order by seq desc,id desc limit 1', (dep['dependency_id'],self.seq))\n    39\t            dep['resolved_to'] = res[0]['resolved_to'] if res else dep['depends_on']\n    40\t            dep['resolution'] = res[0] if res else None\n    41\t        return result\n    42\t\n    43\t    def question(self, row):\n    44\t        vid = row['view_id']\n    45\t        switches = self.rows('select * from view_switches where view_id=? and after_seq<? order by after_seq desc,id desc limit 1', (vid,self.seq))\n    46\t        if not switches:\n1:# Is poc-v118 ready for a production test? (council P, 2026-11-20, consensus; $0)\n11:without a stop. Three pieces of operation are missing, and no person has read poc-v118's own output on the product page.\n23:| Serving | HTTP API, MCP, the page, the Idea call (`poc-v118-idea`) | `scripts/hivemind_api.py`, `scripts/hivemind_mcp.py`, `poc/ui/` | Built; serves the v34 ledger through 08-28, not poc-v118's output |\n37:- **Never measured:** a person reading poc-v118's output (the pilot deck has waited since D560); a second company; live arrival and\n38:  late articles; a window past 09-20 for poc-v118; the Idea call on a poc-v118 store.\n","exit_code":0,"status":"completed"}}
