{"type":"item.completed","item":{"id":"item_26","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba src/hivemind/views/store.py | sed -n '147,160p;195,262p'\nnl -ba scripts/preflight.py | sed -n '55,91p;293,322p;337,373p'\nrg -n 'store\\\\.TABLES|dependencies.*select \\\\*|select \\\\* from dependencies|link_selections|asdict\\\\(written' src scripts live-service --glob '*.py'\"","aggregated_output":"   147\t        if field not in columns:\n   148\t            conn.execute(f'alter table rungs add column {field} real')\n   149\t    judgement_columns = {r[1] for r in conn.execute('pragma table_info(judgements)')}\n   150\t    if 'theme_pushes_json' not in judgement_columns:\n   151\t        conn.execute('alter table judgements add column theme_pushes_json text')     # D195: judgements written before the theme block read as []\n   152\t    for field in ('reference', 'implied_outcome'):\n   153\t        if field not in judgement_columns:\n   154\t            conn.execute(f'alter table judgements add column {field} text')        # D260: judgements written before the stance fields read as null\n   155\t    if 'kind' not in {r[1] for r in conn.execute('pragma table_info(dependencies)')}:\n   156\t        conn.execute(\"alter table dependencies add column kind text default ''\")   # D694: every row written before reads ''\n   157\t\n   158\t\n   159\tdef view_key(conn, view_id):\n   160\t    if not conn.execute('pragma table_info(view_keys)').fetchone():\n   195\t\n   196\tdef is_open(conn, view_id):\n   197\t    row = conn.execute('select open from view_switches where view_id=? order by id desc limit 1', (view_id,)).fetchone()\n   198\t    return bool(row and row['open'])\n   199\t\n   200\t\n   201\tdef close_view(conn, view_id, reason, by_whom, seq):\n   202\t    insert(conn, 'view_switches', view_id=view_id, open=0, reason=reason, by_whom=by_whom, after_seq=seq)\n   203\t\n   204\t\n   205\tdef open_views(conn):\n   206\t    rows = conn.execute('select view_id from views').fetchall()\n   207\t    return [r['view_id'] for r in rows if is_open(conn, r['view_id'])]\n   208\t\n   209\t\n   210\tdef views_of_object(conn, object_id, only_open=True):\n   211\t    rows = conn.execute('select view_id from views where object_id=? order by created_seq', (object_id,)).fetchall()\n   212\t    ids = [r['view_id'] for r in rows]\n   213\t    return [v for v in ids if is_open(conn, v)] if only_open else ids\n   214\t\n   215\t\n   216\tdef has_judgement(conn, view_id, seq):\n   217\t    return conn.execute('select 1 from judgements where view_id=? and seq=?', (view_id, seq)).fetchone() is not None\n   218\t\n   219\t\n   220\tREAD_BUSY_TIMEOUT_SECONDS = 5.0     # a reader's busy timeout: SQLite's busy handler retries SQLITE_BUSY within it (live-service row 1)\n   221\t\n   222\t\n   223\tdef open_read_only(path):\n   224\t    \"\"\"The views database for a reader (the agent layer, reports): no schema creation, no writes. Opened by its own path: a symlink\n   225\t    resolved, a store with another hard link refused (`live_lock.LockRefused`; live-service/OPERATING-CONTRACT.md, row 7), since\n   226\t    SQLite finds a WAL store's side files by the opened path.\"\"\"\n   227\t    from hivemind import live_lock\n   228\t    real, _ = live_lock.own_path(path)\n   229\t    conn = sqlite3.connect(f'file:{real}?mode=ro', uri=True, timeout=READ_BUSY_TIMEOUT_SECONDS)\n   230\t    conn.row_factory = sqlite3.Row\n   231\t    return conn\n   232\t\n   233\t\n   234\tdef current_state(conn, view_id):\n   235\t    \"\"\"The latest judgement: rung, reasons, changed, seq and day, and its reference and implied outcome (D260) where the ledger has them.\"\"\"\n   236\t    columns = {r[1] for r in conn.execute('pragma table_info(judgements)')}\n   237\t    stance = ''.join(f', {field}' for field in ('reference', 'implied_outcome') if field in columns)\n   238\t    row = conn.execute(f'select judgement_id, rung, reasons, changed, seq, publication_day{stance} from judgements where view_id=? order by judgement_id desc limit 1', (view_id,)).fetchone()\n   239\t    return dict(row) if row else None\n   240\t\n   241\t\n   242\tdef dependencies_of(conn, view_id):\n   243\t    \"\"\"Each dependency with its current target: the resolved view, or the waiting chain and year.\"\"\"\n   244\t    out = []\n   245\t    for dep in conn.execute('select * from dependencies where view_id=? order by dependency_id', (view_id,)):\n   246\t        dep = dict(dep)\n   247\t        resolution = conn.execute('select resolved_to, reason from dependency_resolutions where dependency_id=? order by id desc limit 1', (dep['dependency_id'],)).fetchone()\n   248\t        if resolution:\n   249\t            dep['resolved_to'], dep['resolution'] = resolution['resolved_to'], resolution['reason']\n   250\t        else:\n   251\t            dep['resolved_to'], dep['resolution'] = dep['depends_on'], ('direct' if dep['depends_on'] else 'waiting')\n   252\t        out.append(dep)\n   253\t    return out\n   254\t\n   255\t\n   256\tdef direct_parents(conn, view_id, seq=None):\n   257\t    \"\"\"The views this view depends on directly (a driver's root, D208; the seeds' depends_on), written at or before `seq` when given.\n   258\t    The filing reads it to keep a statement under the narrower of two linked questions (D207's narrowest rule, extraction.file_reading).\"\"\"\n   259\t    reads = \" and coalesce(kind, '') != 'reads'\" if 'kind' in {r[1] for r in conn.execute('pragma table_info(dependencies)')} else ''\n   260\t    rows = conn.execute(f\"select depends_on from dependencies where view_id=? and depends_on != '' and (? is null or seq <= ?){reads} order by dependency_id\", (view_id, seq, seq))\n   261\t    return list(dict.fromkeys(r[0] for r in rows))\n   262\t\n    55\t        print(f'   {count:5d}  {reason}')\n    56\t        for example in examples.get(reason, [])[:2]:\n    57\t            print(f'          e.g. {example}')\n    58\t\n    59\t\n    60\tdef saved_judge_format(request_json):\n    61\t    \"\"\"The answer format a judge request was sent with (judging-v12's differs per request, D713), or None when the row has none.\"\"\"\n    62\t    try:\n    63\t        return ((json.loads(request_json or '{}').get('response_format') or {}).get('json_schema') or {}).get('schema')\n    64\t    except (json.JSONDecodeError, AttributeError):\n    65\t        return None\n    66\t\n    67\t\n    68\tdef part_a(archive_conn):\n    69\t    \"\"\"(answers judged, judge rows without a saved format). Judge rows are checked against the format saved with their own request;\n    70\t    extraction and matching rows against their fixed schema.\"\"\"\n    71\t    reasons, examples, judged, missing = collections.Counter(), collections.defaultdict(list), 0, []\n    72\t    rows = archive_conn.execute(\"select purpose, request_sha256, answer_json, request_json from model_calls where request_sha256 like '%:schema:%' or request_sha256 like '%:malformed:%' or request_sha256 like '%:refused:%'\")\n    73\t    for purpose, sha, answer_json, request_json in (tuple(r) for r in rows):\n    74\t        judged += 1\n    75\t        schema = SCHEMAS.get(purpose, {})\n    76\t        if purpose == 'judge':                     # a missing format is reported whatever the answer holds, a malformed one included\n    77\t            schema = saved_judge_format(request_json)\n    78\t            if schema is None:\n    79\t                missing.append(sha)\n    80\t                reasons['judge: no saved answer format'] += 1\n    81\t                continue\n    82\t        if ':malformed:' in sha or not answer_json:\n    83\t            reasons[f'{purpose}: not JSON'] += 1\n    84\t            continue\n    85\t        for error in model.check_schema(json.loads(answer_json), schema):\n    86\t            key = f'{purpose}: {normalise_reason(error)}'\n    87\t            reasons[key] += 1\n    88\t            examples[key].append(error[:140])\n    89\t    tally('A. answers the schema refused (prompt/schema disagreements; empty when the provider enforces the schema server-side)', judged, judged, reasons, examples)\n    90\t    return judged, missing\n    91\t\n   293\t\n   294\tdef part_d():\n   295\t    \"\"\"Every schema enum value appears in the prompt that asks for it: the extraction role and the judging prompt of the versions the\n   296\t    code builds, and every matching prompt against its own version's set (Chinese up to matching-v1, English after).\"\"\"\n   297\t    missing = []\n   298\t    checks = [(f'role-{v}.txt', extraction.TIERS + vocabulary.KINDS + vocabulary.ASSET_LABELS) for v in extraction.SUPPORTED_VERSIONS]\n   299\t    checks += [(f'{v}.txt', judging.PUSHES) for v in judging.SUPPORTED_VERSIONS]\n   300\t    for path in sorted(glob.glob(os.path.join(config.PROMPTS, 'matching-v*.txt'))):\n   301\t        version = os.path.basename(path).removesuffix('.txt')\n   302\t        checks.append((os.path.basename(path), (matching.OUTCOMES + matching.EVIDENCE_OUTCOMES + vocabulary.DIRECTIONS) if matching.is_english(version)\n   303\t                       else (matching.LEGACY_OUTCOMES + matching.LEGACY_EVIDENCE_OUTCOMES)))\n   304\t    judged = 0\n   305\t    for name, values in checks:\n   306\t        text = open(os.path.join(config.PROMPTS, name), encoding='utf-8').read()\n   307\t        for value in values:\n   308\t            judged += 1\n   309\t            if value not in text:\n   310\t                missing.append(f'{name} lacks the enum value {value!r}')\n   311\t    print(f'\\n== D. schema enum values named in the prompts: judged {judged}, missing {len(missing)}')\n   312\t    for line in missing:\n   313\t        print('   ', line)\n   314\t    return judged\n   315\t\n   316\t\n   317\tdef part_e(views_paths):\n   318\t    \"\"\"Keyed ledgers (keyed-views-plan.md 5): how many open views carry a key, how many keys collide among open views (the\n   319\t    pipeline's identity rule says none should), and what the watch list sent to the review pool. A ledger written before\n   320\t    keys is reported as unkeyed, not failed.\"\"\"\n   321\t    judged = 0\n   322\t    for path in views_paths:\n   337\t        judged += keyed\n   338\t        print(f'\\n== E. keyed views in {os.path.basename(path)}: open views {len(open_ids)}, keyed {keyed}, duplicate keys {len(collisions)} groups, review pool {pool} candidates outside the watch list')\n   339\t        for k, v in list(collisions.items())[:10]:\n   340\t            print(f'      {k[:3]} {k[3]}..{k[4]} → {v}')\n   341\t    return judged\n   342\t\n   343\t\n   344\tdef main():\n   345\t    parser = argparse.ArgumentParser()\n   346\t    frozen_draw = os.path.join(ROOT, 'poc', 'data', 'e2e-r9-frozen-v108-2026-11-03', 'd1')\n   347\t    parser.add_argument('--archive', default=os.path.join(frozen_draw, 'archive.sqlite'))\n   348\t    parser.add_argument('--items', default=os.path.join(ROOT, 'poc', 'data', 'items-nvda-2026-07-01-10-27.sqlite'))\n   349\t    parser.add_argument('--views', nargs='*', default=None)\n   350\t    parser.add_argument('--universe', default=os.path.join(ROOT, 'poc', 'universe.json'))\n   351\t    args = parser.parse_args()\n   352\t    views_paths = args.views or [os.path.join(frozen_draw, 'views.sqlite')]\n   353\t    archive_conn = sqlite3.connect(f'file:{args.archive}?mode=ro', uri=True)\n   354\t    archive_conn.row_factory = sqlite3.Row\n   355\t    items_conn = testdb.open_db(args.items)\n   356\t    uni = universe.load(args.universe)\n   357\t    print('preflight over', args.archive, 'and', len(views_paths), 'views databases:', ', '.join(os.path.basename(os.path.dirname(p)) for p in views_paths))\n   358\t    _, missing_formats = part_a(archive_conn)\n   359\t    copies = store_copies(views_paths)\n   360\t    counts = [part_b(archive_conn, items_conn, uni), part_c(archive_conn, copies, uni), part_d()]\n   361\t    part_e(copies)          # informational for unkeyed ledgers; judged counts are reported per ledger\n   362\t    if missing_formats:\n   363\t        print(f'\\nFAILED: {len(missing_formats)} refused judge rows carry no saved answer format, so part A could not check them: '\n   364\t              + ', '.join(sha[:24] for sha in missing_formats[:10]))\n   365\t        sys.exit(1)\n   366\t    if min(counts) == 0:\n   367\t        print('\\nUNEXERCISED: a check judged no case')\n   368\t        sys.exit(1)\n   369\t    print('\\npreflight done')\n   370\t\n   371\t\n   372\tif __name__ == '__main__':\n   373\t    main()\nrg: live-service: No such file or directory (os error 2)\nscripts/review_english_run.py:76:    for d in conn.execute('select * from dependencies'):\nsrc/hivemind/views/store.py:35:    'link_selections': 'id integer primary key autoincrement, attempt_id text, seq integer, input_id text, config_checksum text, status text, record_json text',\nsrc/hivemind/views/store.py:245:    for dep in conn.execute('select * from dependencies where view_id=? order by dependency_id', (view_id,)):\nsrc/hivemind/views/links.py:350:    count = conn.execute('select count(distinct attempt_id) from link_selections where input_id=?', (item['input_id'],)).fetchone()[0]\nsrc/hivemind/views/links.py:355:    store.insert(conn, 'link_selections', attempt_id=attempt, seq=seq, input_id=item['input_id'], config_checksum=cfg.checksum,\nsrc/hivemind/views/writing.py:61:    for dep in conn.execute('select * from dependencies where wait_year=? and wait_chain_view_id is not null', (v['year'],)):\nsrc/hivemind/service.py:181:    for dep in conn.execute('select * from dependencies where view_id=? order by dependency_id', (view_id,)):\n","exit_code":2,"status":"failed"}}
