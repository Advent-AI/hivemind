   234	    input_tokens = int(usage.get('prompt_tokens') or 0)
   235	    output_tokens = int(usage.get('completion_tokens') or 0)
   236	    cached_tokens = min(input_tokens, int((usage.get('prompt_tokens_details') or {}).get('cached_tokens') or 0))
   237	    price_in, price_out = PRICES.get(setting.model, (0.0, 0.0))
   238	    cost = round((input_tokens - cached_tokens) / 1e6 * price_in + cached_tokens / 1e6 * price_in * CACHED_INPUT_SHARE + output_tokens / 1e6 * price_out, 6)
   239	    call_id = archive.record(purpose=purpose, config_version=cfg.version, config_checksum=cfg.checksum, model=setting.model,
   240	                             request_sha256=sha if not errors else sha + ':schema:' + uuid.uuid4().hex[:8], request_json=request_json,
   241	                             response_json=json.dumps(response)[:200000], answer_json=json.dumps(data, ensure_ascii=False),
   242	                             prompt_chars=prompt_chars, input_tokens=input_tokens, output_tokens=output_tokens, cost_usd=cost,
   243	                             seconds=seconds, created_at=time.strftime('%Y-%m-%dT%H:%M:%S'))
   244	    if errors:
   245	        raise SchemaError('; '.join(errors[:5]))
   246	    return Answer(data, call_id, sha, False, prompt_chars, input_tokens, output_tokens, cost)
