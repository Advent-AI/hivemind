   110	def build_request(setting, system, user, schema, schema_name, provider):
   111	    request = {
   112	        'model': setting.model,
   113	        'messages': [{'role': 'system', 'content': system}, {'role': 'user', 'content': user}],
   114	        'response_format': {'type': 'json_schema', 'json_schema': {'name': schema_name, 'strict': True, 'schema': schema}},
   115	    }
   116	    if provider == 'openai':
   117	        # gpt-6-luna is a reasoning model: it refuses any temperature but the default, so the setting's temperature
   118	        # is recorded in Config but not sent; reasoning_effort is what steers it.
   119	        request['max_completion_tokens'] = setting.max_output_tokens
   120	        if setting.reasoning_effort:
   121	            request['reasoning_effort'] = setting.reasoning_effort
   122	    else:
   123	        request['temperature'] = setting.temperature
   124	        request['max_tokens'] = setting.max_output_tokens
   125	    return request
