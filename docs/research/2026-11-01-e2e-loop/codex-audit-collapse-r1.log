   211	def call(archive, cfg, setting, system, user, schema, schema_name, purpose, *, transport=None):
   212	    provider = cfg.provider
   213	    request = build_request(setting, system, user, schema, schema_name, provider)
   214	    request_json, sha = request_identity(request)
   215	    hit = archive.lookup(sha)
   216	    prompt_chars = len(system) + len(user)
   217	    if hit:
   218	        call_id, answer_json, _, input_tokens, output_tokens = hit
   219	        return Answer(json.loads(answer_json), call_id, sha, True, prompt_chars, input_tokens or 0, output_tokens or 0, 0.0)
   220	    started = time.time()
   221	    response = (transport or openai_transport)(provider, request)
   222	    seconds = round(time.time() - started, 1)
   223	    try:
   224	        content = response['choices'][0]['message']['content']
   225	        data = json.loads(content)
   226	    except (KeyError, IndexError, TypeError, json.JSONDecodeError) as error:
   227	        archive.record(purpose=purpose, config_version=cfg.version, config_checksum=cfg.checksum, model=setting.model,
   228	                       request_sha256=sha + ':malformed:' + uuid.uuid4().hex[:8], request_json=request_json,
   229	                       response_json=json.dumps(response)[:200000], answer_json=None, prompt_chars=prompt_chars,
