   128	def openai_transport(provider, request, timeout=180):   # the slowest honest answers take about 40 s (judge) to 60 s; a call past 180 s is a stalled server and is retried (2026-11-02)
   129	    url, _ = ENDPOINTS[provider]
   130	    body = json.dumps(request).encode('utf-8')
   131	    headers = {'Authorization': f'Bearer {_key(provider)}', 'Content-Type': 'application/json'}
   132	    last = None
   133	    for attempt in range(3):
   134	        try:
   135	            with urllib.request.urlopen(urllib.request.Request(url, data=body, headers=headers, method='POST'), timeout=timeout) as response:
   136	                return json.loads(response.read().decode('utf-8'))
   137	        except urllib.error.HTTPError as error:
   138	            text = error.read().decode('utf-8', 'ignore')[:600]
   139	            last = f'HTTP {error.code}: {text}'
   140	            if error.code in (400, 401, 403, 404):
   141	                raise TransportError(last)
   142	        except (urllib.error.URLError, TimeoutError, ConnectionError, OSError, http.client.HTTPException) as error:   # a dropped or truncated response is retried like a network error
   143	            last = repr(error)[:200]
   144	        time.sleep(5 * (attempt + 1))
   145	    raise TransportError(last or 'no answer')
