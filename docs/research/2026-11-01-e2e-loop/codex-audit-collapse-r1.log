   482	def with_extra_fields(schema, fields):
   483	    """The schema with the named string fields added first to each evidence item and required."""
   484	    item = schema['properties']['evidence']['items']
   485	    item['properties'] = {**{k: {'type': 'string', 'description': v} for k, v in fields.items()}, **item['properties']}
   486	    item['required'] = list(fields) + [r for r in item['required'] if r not in fields]
   487	    return schema
