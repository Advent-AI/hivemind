   548	GLYPHS = str.maketrans({'’': "'", '‘': "'", '“': '"', '”': '"', '—': '-', '–': '-'})
   549	
   550	
   551	def normalise(text):
   552	    """The form in which a quote is compared with the item's text: one space between words, no space before closing
   553	    punctuation or after an opening bracket, plain quote and dash glyphs, lower case. The cleaned page text keeps a space
   554	    where an inline tag stood (" , "); the model writes the sentence with ordinary punctuation, and both are the same text."""
   555	    text = re.sub(r'\s+', ' ', text.translate(GLYPHS))
   556	    text = re.sub(r"\s+([,.;:!?')\]])", r'\1', text)
   557	    text = re.sub(r'([(\[])\s+', r'\1', text)
   558	    return text.strip().lower()
   559	
   560	
   561	# D236: a quote the plain check misses is still the item's text when it differs only by punctuation, quotation marks, footnote
   562	# markers or case, or leaves out one run of words inside one sentence; the stored quote is then the exact source passage, so a
   563	# stored quote is always verbatim. Any added, changed or reordered word or number, a dropped +/− on a number or a changed currency
   564	# is refused; a comparison sign (>, ~, ≥) is not a token, so a quote that drops one is repaired to the source text that carries it.
   565	QUOTE_TOKEN = re.compile(r"\[\d{1,3}\]|[-+−]?[$€£¥]?\d+(?:[.,:/]\d+)*%?|[^\W_]+(?:['./&-][^\W_]+)*|[$€£¥%]")
   566	_FOOTNOTE = re.compile(r'\[\d{1,3}\]$')
   567	_SENTENCE_END = re.compile(r"[.!?…][\"')\]”’]*\s|\n")
   568	_OPENING = re.compile(r"[\"'(\[“‘]+$")
   569	_CLOSING = re.compile(r"[.!?]?[\"')\]”’]*")
   570	
   571	
   572	def _quote_tokens(text):
   573	    """The words and numbers a quote is compared by, with their character spans in text (GLYPHS maps one character to one)."""
   574	    plain = text.translate(GLYPHS)
   575	    return [(m.group(0).lower(), m.start(), m.end()) for m in QUOTE_TOKEN.finditer(plain) if not _FOOTNOTE.match(m.group(0))]
   576	
   577	
   578	def _source_passage(text, start, end):
   579	    before = _OPENING.search(text[max(0, start - 3):start])
   580	    if before:
   581	        start -= len(before.group(0))
   582	    return text[start:end + len(_CLOSING.match(text, end).group(0))]
   583	
   584	
   585	def _runs(needle, tokens):
   586	    return [i for i in range(len(tokens) - len(needle) + 1) if tokens[i] == needle[0] and tokens[i:i + len(needle)] == needle]
   587	
   588	
   589	def repair_quote(quote, text, subject_names=()):
   590	    """The source passage a refused quote stands for (D236, D266), or None. Accepted: the quote's words equal one passage's words
   591	    (punctuation, quotation marks, footnote markers and case aside), or equal them with one run left out that lies inside one
   592	    sentence and is shorter than the quote; or (D266) differ from them by a word or two that is a function word, a pronoun, a generic
   593	    word for the company or one of `subject_names` (the subject company's own name), never a number or any other word; or copy one
   594	    passage exactly and run on past its sentence end."""
   595	    if len(normalise(quote)) < 8:
   596	        return None
   597	    spans = _quote_tokens(text)
   598	    source_tokens = [token for token, _, _ in spans]
   599	    quote_tokens = [token for token, _, _ in _quote_tokens(quote)]
   600	    if not quote_tokens:
   601	        return None
   602	    found = _runs(quote_tokens, source_tokens)
   603	    if found:
   604	        return _source_passage(text, spans[found[0]][1], spans[found[0] + len(quote_tokens) - 1][2])
   605	    best = None                                              # (left-out length, first token, last token) of the shortest gap
   606	    for split in range(1, len(quote_tokens)):
   607	        head, tail = quote_tokens[:split], quote_tokens[split:]
   608	        for tail_start in _runs(tail, source_tokens):
   609	            for gap_start in range(tail_start - 1, split - 1, -1):          # tokens gap_start..tail_start-1 are the left-out run
   610	                if tail_start - gap_start >= len(quote_tokens) or _SENTENCE_END.search(text[spans[gap_start - 1][2]:spans[tail_start][1]]):
