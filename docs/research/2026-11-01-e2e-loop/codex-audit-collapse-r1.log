     1	"""The test database: the corpus items.sqlite built by poc/corpus/scripts/assemble.py, read as a stream in
     2	publication order. This is "the team's own database" of D7: the system keeps no copy of the material, only the
     3	processing record; an item's text is read from here when it is processed.
     4	
     5	Order inside a day (the arrival order upstream would give): company documents (filings, transcripts, releases),
     6	official material, then news by published_at. Only items with feed = 1 (an original, whole) or a copy of one are
     7	streamed; the rest stay in the database for the review.
     8	"""
     9	import json
    10	import sqlite3
    11	
    12	def open_db(path):
    13	    conn = sqlite3.connect(path)
    14	    conn.row_factory = sqlite3.Row
    15	    return conn
    16	
    17	
    18	def feed(conn, from_day, until_day):
    19	    """Yield items with from_day <= publication_day <= until_day in processing order."""
    20	    rows = conn.execute(
    21	        "select * from items where publication_day >= ? and publication_day <= ? and (feed = 1 or copy_of is not null) "
    22	        "order by publication_day, case klass when '公司材料' then 0 when '官方材料' then 1 else 2 end, "
    23	        "coalesce(published_at, ''), rowid", (from_day, until_day))
    24	    for row in rows:
    25	        item = dict(row)
    26	        item['object_identifiers'] = json.loads(item.get('object_identifiers') or '[]')
    27	        yield item
    28	
    29	
    30	def count(conn, from_day, until_day):
    31	    return conn.execute("select count(*) from items where publication_day >= ? and publication_day <= ? and feed = 1", (from_day, until_day)).fetchone()[0]

