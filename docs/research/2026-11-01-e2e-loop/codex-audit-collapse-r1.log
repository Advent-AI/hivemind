   193	def evidence_rule(e):
   194	    """None when a classified statement (v78, v79) is evidence by the standard's rule, else the reason it is not. v79: a known statement (5.1's
   195	    first question, D243 item 5, D250 item 1), a product comparison or detail or a market move (5.3), an unrelated party's matter (D250 item 2),
   196	    a customer's, supplier's, competitor's or partner's matter with no size, date or name (5.1 kind 2). v78: the same with its one "news" field.
   197	    An answer without the fields (an earlier version) is not judged."""
   198	    if 'party' not in e:
   199	        return None
   200	    if 'new' in e:
   201	        if e['new'] == 'known':
   202	            return 'not evidence: known'
   203	        if e.get('kind') in NOT_EVIDENCE_KINDS:
   204	            return f'not evidence: {e["kind"]}'
   205	    elif 'news' in e:
   206	        if e['news'] in NOT_EVIDENCE_NEWS:
   207	            return f'not evidence: {e["news"]}'
   208	    else:
   209	        return None
   210	    if e['party'] == 'unrelated':
   460	    flat['evidence'] = pieces + list(data.get('extra') or [])
   461	    return flat
