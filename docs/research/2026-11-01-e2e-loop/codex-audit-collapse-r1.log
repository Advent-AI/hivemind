   148	def check_schema(value, schema, path='$', root=None):
   149	    """A small validator for the subset of JSON Schema the prompts use: object/required/additionalProperties,
   150	    array/items/minItems, string/enum/pattern, integer, number, boolean, null in anyOf, and $ref into the root's $defs."""
   151	    root = root if root is not None else schema
   152	    if '$ref' in schema:
   153	        name = schema['$ref'].rsplit('/', 1)[1]
   154	        schema = root['$defs'][name]
   155	    kind = schema.get('type')
   156	    if 'anyOf' in schema:
   157	        errors = []
   158	        for option in schema['anyOf']:
   159	            errors = check_schema(value, option, path, root)
   160	            if not errors:
   161	                return []
   162	        return errors or [f'{path}: matches no option']
   163	    if kind == 'object':
   164	        if not isinstance(value, dict):
   165	            return [f'{path}: expected object']
   166	        errors = []
   167	        for name in schema.get('required', []):
   168	            if name not in value:
   169	                errors.append(f'{path}.{name}: required')
   170	        properties = schema.get('properties', {})
   171	        for name, item in value.items():
   172	            if name in properties:
   173	                errors.extend(check_schema(item, properties[name], f'{path}.{name}', root))
   174	            elif schema.get('additionalProperties') is False:
   175	                errors.append(f'{path}.{name}: not allowed')
   176	        return errors
   177	    if kind == 'array':
   178	        if not isinstance(value, list):
   179	            return [f'{path}: expected array']
   180	        errors = []
   181	        if len(value) < schema.get('minItems', 0):
   182	            errors.append(f'{path}: fewer than {schema["minItems"]} items')
   183	        for index, item in enumerate(value):
   184	            errors.extend(check_schema(item, schema.get('items', {}), f'{path}[{index}]', root))
   185	        return errors
   186	    if kind == 'string':
   187	        if not isinstance(value, str):
   188	            return [f'{path}: expected string']
   189	        if 'enum' in schema and value not in schema['enum']:
   190	            return [f'{path}: {value!r} not in {schema["enum"]}']
   191	        if 'pattern' in schema and not re.search(schema['pattern'], value):
   192	            return [f'{path}: {value!r} does not match {schema["pattern"]}']
   193	        return []
   194	    if kind == 'integer':
   195	        return [] if isinstance(value, int) and not isinstance(value, bool) else [f'{path}: expected integer']
   196	    if kind == 'number':
   197	        return [] if isinstance(value, (int, float)) and not isinstance(value, bool) else [f'{path}: expected number']
   198	    if kind == 'boolean':
   199	        return [] if isinstance(value, bool) else [f'{path}: expected boolean']
   200	    if kind == 'null':
