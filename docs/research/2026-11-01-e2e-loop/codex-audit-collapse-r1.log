   490	def with_field_notes(schema, notes):
   491	    """The schema with the notes as the descriptions of the evidence fields they name."""
   492	    fields = schema['properties']['evidence']['items']['properties']
   493	    for name, note in notes.items():
   494	        fields[name] = dict(fields[name], description=note)
   495	    return schema
