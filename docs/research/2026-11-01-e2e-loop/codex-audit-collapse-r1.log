   205	def request_identity(request):
   206	    """The exact serialized request and its archive key, shared by callers and validation."""
   207	    encoded = json.dumps(request, sort_keys=True, ensure_ascii=False)
   208	    return encoded, hashlib.sha256(encoded.encode('utf-8')).hexdigest()
