   498	def schema_for(version, shown_group_ids=(), shown_view_ids=(), mandatory=()):
   499	    number = version_number(version)
   500	    measures = MEASURES_V10 if number >= MEASURES_V10_FROM else MEASURES
   501	    if number >= ADMISSION_FROM:
   502	        base = admission_schema(shown_view_ids, shown_group_ids, measures=measures, reasons=ADMISSION_REASONS_V13 if number in SHARED_QUANTITY_VERSIONS else ADMISSION_REASONS,
   503	                                blind=number >= LEDGER_BLIND_FROM)
   504	        if number >= FIELD_NOTES_FROM:
   505	            base = with_field_notes(base, field_notes(number))
   506	        if number in MOVES_FIELDS_VERSIONS:
   507	            base = with_extra_fields(base, FIELD_NOTES_V71)
   508	        if number >= ONE_DECIDER_FROM:           # D256: the links field carries the filing rule, the takes lines' one rule, beside the field
   509	            base = with_field_notes(base, {'links': getattr(placement, FILING_RULE_VARIANTS.get(version, 'FILING_RULE'))})
   510	        if number >= VIEW_FROM:                  # v80: the newness question sharpened, and "view" as a kind of its own
   511	            base = with_enum_fields(base, EVIDENCE_CLASSES_V80)
   512	        elif number >= FIELDS_APART_FROM:        # v79: the newness question first, then the shape, the party and the scale
   513	            base = with_enum_fields(base, EVIDENCE_CLASSES_V79)
   514	        elif number >= FIELD_SETS_FROM:          # v78: the three closed-set fields first, the standard's classes with their examples
   515	            base = with_enum_fields(base, EVIDENCE_CLASSES)
   516	        return accounted_schema(base, mandatory) if accounts(version) else base
   517	    if number >= GROUPS_FROM:
   518	        return grouped_schema(shown_group_ids, aliases=number >= ALIASES_FROM, measures=measures)
   519	    if number >= ENGLISH_FROM:
   520	        return keyed_schema(english=True)
   521	    return keyed_schema() if number >= 4 else SCHEMA
