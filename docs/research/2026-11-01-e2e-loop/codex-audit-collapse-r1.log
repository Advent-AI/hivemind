    33	SCHEMA_SQL = """
    34	create table if not exists model_calls (
    35	  call_id integer primary key autoincrement, purpose text, config_version text, config_checksum text, model text,
    36	  request_sha256 text unique, request_json text, response_json text, answer_json text, prompt_chars integer,
    37	  input_tokens integer, output_tokens integer, cost_usd real, seconds real, created_at text
    38	);
    39	create index if not exists model_calls_sha on model_calls(request_sha256);
    40	"""
