    63	class Archive:
    64	    """Shared by the extraction worker threads: one connection, every access under a lock."""
    65	
    66	    def __init__(self, path):
    67	        os.makedirs(os.path.dirname(os.path.abspath(path)), exist_ok=True)
    68	        self.conn = sqlite3.connect(path, check_same_thread=False)
    69	        self.conn.executescript(SCHEMA_SQL)
    70	        import threading
    71	        self.lock = threading.Lock()
    72	
    73	    def lookup(self, sha):
    74	        with self.lock:
    75	            return self.conn.execute('select call_id, answer_json, prompt_chars, input_tokens, output_tokens from model_calls where request_sha256=?', (sha,)).fetchone()
    76	
    77	    def record(self, **fields):
    78	        """One row per distinct request; a second identical request recorded at the same moment (two threads, or a
    79	        failed answer repeated within the same second) keeps the first row's id instead of failing."""
    80	        columns = list(fields)
    81	        with self.lock:
    82	            cursor = self.conn.execute(f'insert or ignore into model_calls ({",".join(columns)}) values ({",".join("?" * len(columns))})',
    83	                                       [fields[c] for c in columns])
    84	            self.conn.commit()
    85	            if cursor.rowcount == 0:
    86	                return self.conn.execute('select call_id from model_calls where request_sha256=?', (fields['request_sha256'],)).fetchone()[0]
    87	            return cursor.lastrowid
    88	
    89	    def retire(self, call_id):
    90	        """A code check refused this answer: the row stays for the record, but no later identical request is answered with it
    91	        (the same shape as a schema-refused or malformed row, whose hash carries a suffix)."""
    92	        with self.lock:
    93	            self.conn.execute("update model_calls set request_sha256 = request_sha256 || ':refused:' || ? where call_id=? and request_sha256 not like '%:refused:%'",
    94	                              (uuid.uuid4().hex[:8], call_id))
    95	            self.conn.commit()
    96	
    97	    def totals(self):
    98	        with self.lock:
    99	            return self.conn.execute('select count(*), coalesce(sum(cost_usd),0), coalesce(sum(input_tokens),0), coalesce(sum(output_tokens),0) from model_calls').fetchone()
