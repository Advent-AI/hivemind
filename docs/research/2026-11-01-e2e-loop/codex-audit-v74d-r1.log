def file_reading(reading, archive, cfg, item, shown_views, *, transport=None):
    """The handover: from v20 the placement call files the read statements under the open theses shown now (D207); from v72 the
    extraction's own links are the filing and no placement call is made (D256); earlier versions hand the read over as it is. A
    statement no open question takes is dropped as 'no home' (D209), like every other drop: a candidate left with none of its evidence
    is dropped too, and a statement whose only link was such a candidate has no home."""
    evidence, candidates, dropped, answer = reading.evidence, reading.candidates, list(reading.dropped), reading.answer
    cost, cached = answer.cost_usd, answer.cached
    if places(reading.version) or one_decider(reading.version):
        shown_ids = {v['view_id'] for v in shown_views} if open_questions(reading.version) else set()
        linked = [e for e in evidence if any(l in shown_ids for l in e['links'])]        # D251: a statement the extraction linked to an open question is filed there
        to_place = [e for e in evidence if e not in linked]
        if places(reading.version):
            placed, unfiled, placed_answer = placement.place(archive, cfg, to_place, shown_views, transport=transport, item=item)
        else:                       # v72: the extraction's links are the filing; the loop below drops a statement linked to nothing as 'no home'
            placed, unfiled, placed_answer = to_place, [], None
        evidence = [e for e in evidence if e in linked or any(p['id'] == e['id'] for p in placed)]
        evidence = [next((p for p in placed if p['id'] == e['id']), e) for e in evidence]
        parents = {v['view_id']: v.get('parents') or [] for v in shown_views}
        evidence = [dict(e, links=narrowest_links(e['links'], parents)) for e in evidence]     # D207 in code: the narrower of a driver and its root
        dropped.extend((e['id'], 'no home') for e in unfiled)
        if placed_answer is not None:
            cost += placed_answer.cost_usd
            cached = cached and placed_answer.cached
        while True:
            candidates = candidates_with_evidence(candidates, {e['id'] for e in evidence}, item, dropped)
            candidate_ids = {c['id'] for c in candidates}
            evidence = [dict(e, links=[l for l in e['links'] if not placement.CANDIDATE_ID.match(l) or l in candidate_ids]) for e in evidence]
            homeless = [e for e in evidence if not e['links']]
            if not homeless:
                break
            dropped.extend((e['id'], 'no home') for e in homeless)
            evidence = [e for e in evidence if e['links']]
    return Handover(evidence, candidates, dropped, answer.call_id, answer.request_sha256, cached, cost, reading.new_groups)


def extract(archive, cfg, item, text, shown_views, universe, *, shown_groups=(), transport=None):
    """One item through extraction: read, then file under the theses shown."""
    reading = read_item(archive, cfg, item, text, shown_views, universe, shown_groups=shown_groups, transport=transport)
    return file_reading(reading, archive, cfg, item, shown_views, transport=transport)


def check_bounds(rungs):
    """None when the rungs' numeric bounds form one unbroken partition (or none carries bounds), else the problem."""
    bounded = [r for r in rungs if r.get('lo') is not None or r.get('hi') is not None]
    if not bounded:
        return None
    if len(bounded) != len(rungs):
        return 'some rungs carry bounds and some do not'
    ordered = sorted(rungs, key=lambda r: -1e300 if r.get('lo') is None else float(r['lo']))
    for a, b in zip(ordered, ordered[1:]):
        if a.get('hi') is None or b.get('lo') is None or float(a['hi']) != float(b['lo']):
            return 'rung bounds overlap or leave a gap'
    if ordered[-1].get('hi') is not None:
        return 'the top rung must be open above'
    return None


def check_group_refs(c, shown_group_ids, declared):
    """None when a candidate's research-group references are well formed: no repeats, each a shown group id or a declared
    local id; empty is allowed (a company's own financial line belongs to the company, not to a group); else the problem."""
    refs = c.get('group_refs')
    if refs is None:
        return None                     # a version before groups
    if len(refs) != len(set(refs)):
        return 'group_refs repeats a group'
    unknown = [r for r in refs if r not in shown_group_ids and r not in declared]
    if unknown:
        return f'group_refs cites a group neither shown nor declared: {unknown}'
    return None


def check_admission(c, shown_ids, publication_day):
    """None when a version-12 candidate's admission fields are well formed (D184/D185), else the problem:
    settled_by is not blank, folds_into is empty or a shown thesis, lost_if_folded is not blank when folds_into names one, and a binding
    obligation is due within 18 months."""
    if not str(c.get('settled_by', '')).strip():
        return 'settled_by is empty'
    if c.get('folds_into') and c['folds_into'] not in shown_ids:
        return f'folds_into names a thesis not shown: {c["folds_into"]!r}'
"""Code counts for design.md's predictions P1–P6 on run REF (control REF-v53, arm REF-v53R), and the two blind packets a reader judges
(P3 links, P4 duplicate candidates). Code counts structure only; meaning is the blind reader's.

    python3 score_ref.py counts            # P1, P2 (via final_scores rows), P4 code count, P5, P6, sink share
    python3 score_ref.py packets [seed]    # blind/links.json (40 links, arm only), blind/candidates.json (both arms, label key apart)
"""
import collections
import json
import random
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent
ROOT = HERE.parents[2]
LEDGER = ROOT / 'docs/research/2026-10-29-ledger-standard'
sys.path[:0] = [str(LEDGER), str(LEDGER / 'final-2026-10-30'), str(HERE)]
import final_scores as fs  # noqa: E402
import score_gold as sg  # noqa: E402
import reference_arm as ra  # noqa: E402

CONTROL, ARM = 'REF-v53', 'REF-v53R'
SINKS = {'v2', 'v6'}          # FY2027 total revenue and gross margin: the company-wide quantities D207 found absorbing links
articles = json.loads(Path(fs.GOLDS['dev']).read_text())['articles']
sizes = json.loads((HERE / 'list-sizes.json').read_text())


def raw(tag, iid):
    row = sg.answers(tag).get(iid)
    if not row or not row[0]:
        return None
    try:
        return json.loads(row[0])
    except json.JSONDecodeError:
        return None


def shown(iid):
    a = next(x for x in articles if x['input_id'] == iid)
    return ra.open_questions_before(a['publication_day'])


def same_question(text_a, text_b):
    """fs.matches without the opens_as condition: at least QUESTION_SHARE of the shorter question's words shared."""
    g, q = sg.words(text_a) - sg.STOP, sg.words(text_b) - sg.STOP
    return bool(g and q) and len(g & q) >= fs.QUESTION_SHARE * min(len(g), len(q))


def counts():
    fs.PREFIX = 'REF'
    rows = {v: fs.per_article(v, articles) for v in ('v53', 'v53R')}
    with_list = [a['input_id'] for a in articles if sizes[a['input_id']] > 0]
    empty = [a['input_id'] for a in articles if sizes[a['input_id']] == 0]
    print('== P1 gold-rejected kept per draw (D250 unit), articles with a list:', len(with_list))
    for v in ('v53', 'v53R'):
        print(f'   {v}:', [sum(rows[v][i]['nk_hits'][d] for i in with_list) for d in range(3)], '| extra (gold lists nothing):', [sum(rows[v][i]['extra'][d] for i in with_list) for d in range(3)])
    print('   paired bootstrap, arm minus control over these articles:', fs.paired({i: rows['v53R'][i] for i in with_list}, {i: rows['v53'][i] for i in with_list}, 'not-kept kept (mean of draws)'))
    print('== P2 core every draw / supporting >=2 draws (counting aid, all 118)')
    for v in ('v53', 'v53R'):
        t = fs.totals(rows[v])
        print(f'   {v}: core every {t["core every draw"]}/{t["core total"]} per-draw {t["core per draw"]} | supp>=2 {t["supporting >=2 draws"]}/{t["supporting total"]} per-draw {t["supporting per draw"]}')
    print('== P6 statements per draw on the', len(empty), 'articles with an empty list')
    for v in ('v53', 'v53R'):
        print(f'   {v}:', [sum(rows[v][i]['stmts'][d] for i in empty) for d in range(3)], '| gold-rejected kept', [sum(rows[v][i]['nk_hits'][d] for i in empty) for d in range(3)])
    # P3 code part: links to shown questions, sink share
    print('== P3 links (arm): kept statements linked to a shown question, and the share on the two company-wide quantities')
    for d in (1, 2, 3):
        linked = to_sink = total = 0
        for iid in with_list:
            data = raw(f'{ARM}-d{d}', iid)
            ids = {q['view_id'] for q in shown(iid)}
            for e in (data or {}).get('evidence', []):
                total += 1
                hits = [l for l in e.get('links', []) if l in ids]
                linked += bool(hits)
                to_sink += any(l in SINKS for l in hits)
        print(f'   d{d}: statements {total}, linked to a shown question {linked}, of which to v2/v6 {to_sink} ({to_sink / max(linked, 1):.0%})')
    # P4: candidates that duplicate a shown question (code), per draw, both arms
    print('== P4 candidates duplicating a shown open question (code: word share), articles with a list')
    for tag in (CONTROL, ARM):
        per = []
        for d in (1, 2, 3):
            dup = cands = 0
            for iid in with_list:
                data = raw(f'{tag}-d{d}', iid)
                qs = shown(iid)
3040:## D259 · 2026-11-02 · The takes line takes the evidence that bears on a question's answer, not only its own figures: D254's "direct drivers stated with a size" gate goes; supporting evidence gets its leeway
3046:- What the leeway costs, written down: the noise the placement step used to remove is the extraction's noise and now reaches the judge (41 gold not-kept statements over the gold articles of one draw: ecosystem adoption lists, a CEO's generic claim, restated known deals, one game expansion under total revenue). The share of noise among pieces reaching judgement, 15% in arm 4, is estimated at about 22% after this change (from the gold-article counts, not measured end to end); filed statements double, so the judgement count and cost a draw are estimated to grow by 60–90% (arm 4: 310 judgements, $0.92 a draw; judging-v6's longer answers add to it). The owner of that noise is the extraction standard's 5.1 item 5 and 5.3 (common knowledge, current arrangements, product details), not the placement step; it is the next class to count, at the extraction. Tests: `tests/test_placement.py` (the D259 case). Measured by re-sent stored requests, not by an arm (Alex: "不要再跑这些有的没的臂了"); the default configuration stays `poc-v69`, and since the change is code every configuration run from now on carries it.
