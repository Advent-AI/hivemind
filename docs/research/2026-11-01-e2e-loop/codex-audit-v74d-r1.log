   878	def request_for(cfg, item, text, shown_views, universe, shown_groups=()):
   879	    """Build the setting, complete prompt and schema without making a call."""
   880	    setting = cfg.extraction_setting(item['category'])
   881	    version = setting.prompt_version.rpartition('-')[2]
   882	    if ledger_blind(version) and not open_questions(version):     # D211: the request's bytes depend on the item alone
   883	        shown_views, shown_groups = [], []
   884	    elif open_questions(version):              # D251: the item and the day's snapshot; no groups block beyond the standing instruction
   885	        shown_groups = []
   886	    system, user = build_prompt(item, text, shown_views, universe, version, shown_groups)
   887	    group_ids = [g['group_id'] for g in shown_groups]
   888	    shown_ids = [v['view_id'] for v in shown_views]
   889	    if accounts(version):
   890	        return setting, system, user, schema_for(version, group_ids, shown_ids, mandatory_ids(text))
   891	    return setting, system, user, schema_for(version, group_ids, shown_ids)
