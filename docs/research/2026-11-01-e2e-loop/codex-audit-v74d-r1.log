     1	"""Placement (D207, 2026-10-28; docs/research/2026-10-28-extraction-quality/routing-analysis.md): from extraction v20 the statements an
     2	item yields are filed by a separate call that reads only the item's title line, the statements and the open questions, each question
     3	with a 'takes' line written by code from its key and its research group. The rule is the placement prompt the configuration names:
     4	`placement-narrow-v1` (one home, the narrowest question that names the matter; a company-wide figure question takes only its own
     5	figures and guidance) or `placement-v1` (the old link rule, kept for comparison). A statement the placer files nowhere is dropped with the reason 'no home'
     6	(D209: evidence is what bears on an open question; the handover's dropped record is where evaluation reads what was thrown away);
     7	a link the extraction gave to one of its own candidates (c1 …) is kept as it is, the placer decides only the links to existing theses. Measured on the frozen gold over three draws: core statements filed right
     8	55% → 82%, wrong links 9 → 3, links to the two revenue sinks 63/60/44 → 6/1/5."""
     9	import re
    10	
    11	from . import config, model
    12	
    13	SCHEMA = {'type': 'object', 'additionalProperties': False, 'required': ['placements'],
    14	          'properties': {'placements': {'type': 'array', 'items': {'type': 'object', 'additionalProperties': False, 'required': ['id', 'links'],
    15	                                                                     'properties': {'id': {'type': 'string'}, 'links': {'type': 'array', 'items': {'type': 'string'}}}}}}}
    16	CANDIDATE_ID = re.compile(r'^c\d+$')
    17	
    18	
    19	def matter(view):
    20	    """The research group(s) the thesis belongs to: the matter's other names in the press and what is happening (D149 aliases)."""
    21	    parts = []
    22	    for g in view.get('groups') or []:
    23	        names = [a for a in (g.get('aliases') or []) if a and a != g.get('name')]
    24	        parts.append(f"the matter '{g['name']}'" + (f" (also called {', '.join(names)})" if names else '') + f": {g['scope']}")
    25	    return '; '.join(parts)
    26	
    27	
    28	def takes(view):
    29	    """What a question collects, from its key and its research group: the one sentence the placer reads beside the question.
    30	    A file holds the question's own figures or steps and the evidence that bears on its answer (D259; the standard's 5.1 test: what
    31	    makes the answer more or less likely, through demand, supply, competition or pricing, D250 item 2's four paths); the
    32	    system prompt says how to apply it (whoever says it, with or without a size, the narrowest covering question only)."""
    33	    key = view.get('key') or {}
    34	    measure, scope = key.get('measure') or '', key.get('scope') or view.get('looks_at') or view.get('object_id')
    35	    tail = f"; statements about {matter(view)} belong here under any of those names" if matter(view) else ''
    36	    if measure == 'policy_event':
    37	        return (f"takes: the decisions, drafts, approvals, denials and deadlines of this process, its enforcement and evasion, any statement of "
    38	                f"whether and how much the permitted or restricted activity is actually happening, and the affected parties' own plans and "
    39	                f"statements about it: {scope}{tail}")
    40	    if measure == 'event':
    41	        if key.get('event_type') in ('launch', 'shipment', 'deployment'):
    42	            return (f"takes: steps, dates, delays, cancellations, design or configuration changes, variants and stopgaps of this event, "
    43	                    f"confirmations and denials, and named customers' statements about receiving it: {scope}{tail}")
    44	        return (f"takes: the terms, amounts, counterparties, agreements and approvals of this obligation or deal, its steps, confirmations and "
    45	                f"denials, and the counterparties' own plans, financing and demand that bear on it: {scope}{tail}")
    46	    measure_name = f"{measure} " if measure and measure != 'other' else ''   # 'other' is the key's catch-all, not a word for the reader
    47	    # D268 (2026-11-02, the first prompt audit, design-v72.md §12 row D): the period is named as the question's own, not as a bound on what
    48	    # the file takes; an estimate for another period or population of the same quantity is filed here when no open question covers it
    49	    # (D248 allows calendar-year estimates under fiscal-year questions; D240: a missing period is no reason to drop)
    50	    return (f"takes: {measure_name}figures, guidance, estimates and revisions for {scope} (this question's period is {key.get('period_start')}..{key.get('period_end')}; "
    51	            f"an estimate for another period or population of the same quantity is filed here when no open question covers it), "
    52	            f"and what makes that figure more or less likely: the demand, supply, competition and pricing behind it{tail}")
    53	
    54	
    55	# Extraction v72 (D256; Alex, 2026-11-02: the open questions and their takes lines decide the extraction): the one decider is the
    56	# extraction, which reads the day's open questions with the same takes lines the placer read and files each statement through its
    57	# links. The rule the placer's system prompt (placement-narrow-v4) states for the separate call is written here as the schema
    58	# description of the evidence field `links`, so the field has its definition beside it (AGENTS §6: a field without a definition is a
    59	# coin flip per send; D256). This constant is the rule's owner for the extraction; v4's file stays the separate call's wording.
    60	FILING_RULE = ('The questions this statement is filed under: the id of the narrowest open question in [Open questions] whose takes line covers it '
    61	               '(that one only, never a broader question beside it; whoever says it, and even when it gives no period, basis or exact amount, '
    62	               'because the weight is judged later, not here; a period in a takes line tells apart questions about the same quantity for different '
    63	               'periods and bars no figure or driver from another period when no open question covers that period), plus the ids of this answer\'s '
    64	               'candidates the statement supports; empty when no takes line and no candidate covers it, however important it sounds.')
    65	
    66	
    67	def question_lines(shown):
    68	    """One line per open question with its takes line below it: what the placer reads, and from extraction v72 what the extraction
    69	    reads under [Open questions]. One writer for both requests."""
    70	    return [f"  - {v['view_id']} ({v['object_id']}, due {v['due_day']}): {v['question']}\n      {takes(v)}" for v in shown]
    71	
    72	
    73	def build_request(statements, shown, item=None):
    74	    head = f"[Item] {item.get('publisher') or ''}, {item.get('publication_day') or ''}: {item.get('title') or ''}\n\n" if item else ''
    75	    lines = question_lines(shown)
    76	    return (head + '[Open questions]\n' + '\n'.join(lines) + '\n\n[Statements]\n'
    77	            + '\n'.join(f"  - {e['id']} [{e.get('tier')}] who: {e.get('original_who') or e.get('speaker') or ''} | {e.get('one_line')} | quote: {(e.get('quote') or '')[:240]}" for e in statements)
    78	            + '\n\nReturn one placement per statement id, in order.')
    79	
    80	
    81	def place(archive, cfg, statements, shown, *, item=None, transport=None, prompt=None):
    82	    """Returns (placed, unfiled, answer): every statement with its links decided; the extraction's candidate links kept; the
    83	    caller drops the unfiled.
    84	    prompt names the placement prompt file; the configuration's is the default."""
    85	    if not statements:
    86	        return [], [], None
    87	    with open(config.prompt_path((prompt or cfg.placement.prompt_version) + '.txt'), encoding='utf-8') as handle:
    88	        system = handle.read()
    89	    user = build_request(statements, shown, item=item)
    90	    answer = model.call(archive, cfg, cfg.placement, system, user, SCHEMA, 'placement', 'place', transport=transport)
    91	    allowed = {v['view_id'] for v in shown}
    92	    decided = {}
    93	    for p in answer.data['placements']:
    94	        decided.setdefault(p['id'], [l for l in p['links'] if l in allowed])
    95	    placed, unfiled = [], []
    96	    for e in statements:
    97	        links = list(dict.fromkeys([l for l in e.get('links', []) if CANDIDATE_ID.match(l)] + decided.get(e['id'], [])))
    98	        (placed if links else unfiled).append(dict(e, links=links))
    99	    return placed, unfiled, answer
"""The test database: the corpus items.sqlite built by poc/corpus/scripts/assemble.py, read as a stream in
publication order. This is "the team's own database" of D7: the system keeps no copy of the material, only the
processing record; an item's text is read from here when it is processed.

Order inside a day (the arrival order upstream would give): company documents (filings, transcripts, releases),
official material, then news by published_at. Only items with feed = 1 (an original, whole) or a copy of one are
streamed; the rest stay in the database for the review.
"""
import json
import sqlite3

def open_db(path):
    conn = sqlite3.connect(path)
    conn.row_factory = sqlite3.Row
    return conn


def feed(conn, from_day, until_day):
    """Yield items with from_day <= publication_day <= until_day in processing order."""
    rows = conn.execute(
        "select * from items where publication_day >= ? and publication_day <= ? and (feed = 1 or copy_of is not null) "
        "order by publication_day, case klass when '公司材料' then 0 when '官方材料' then 1 else 2 end, "
        "coalesce(published_at, ''), rowid", (from_day, until_day))
    for row in rows:
        item = dict(row)
        item['object_identifiers'] = json.loads(item.get('object_identifiers') or '[]')
        yield item


def count(conn, from_day, until_day):
    return conn.execute("select count(*) from items where publication_day >= ? and publication_day <= ? and feed = 1", (from_day, until_day)).fetchone()[0]
"""The views database (docs/prd/06-views.md): append-only tables for views, rungs, judgements, evidence, links,
replacements, dependencies, successions, match records, processing steps and the review pool; a trigram
full-text index over the views for the matching lists; the queries the other modules read.

Every table refuses UPDATE and DELETE (triggers). Progress and counts are rows, never updates. There is no item
text here: evidence holds the quoted sentence and the one-line restatement only.
"""
import json
import os
import re
import sqlite3

TABLES = {
    'views': 'view_id text primary key, object_id text, object_kind text, kind text, looks_at text, question text, due_day text, year text, created_seq integer, created_from_input text, created_at text',
    'rungs': 'view_id text, position integer, label text, condition text, lo real, hi real',
    'view_keys': 'view_id text primary key, measure text, scope text, scope_key text, period_start text, period_end text, basis text, unit text, event_type text, seq integer, scope_source text, key_version integer',
    'view_switches': 'id integer primary key autoincrement, view_id text, open integer, reason text, by_whom text, after_seq integer',
    'judgements': 'judgement_id integer primary key autoincrement, view_id text, seq integer, input_id text, rung integer, reasons text, cited_evidence_json text, cited_views_json text, pushes_json text, changed integer, why_changed text, config_checksum text, call_id integer, request_sha256 text, publication_day text, theme_pushes_json text, reference text, implied_outcome text',
    'evidence': 'evidence_id text primary key, quote text, one_line text, speaker text, original_who text, original_day text, tier text, event_time text, created_seq integer, created_from_input text',
    'evidence_sources': 'id integer primary key autoincrement, evidence_id text, input_id text, category text, publication_day text, location text, seq integer',
    'evidence_links': 'id integer primary key autoincrement, evidence_id text, view_id text, seq integer',
    'replacements': 'id integer primary key autoincrement, old_evidence_id text, new_evidence_id text, said_day text, seq integer',   # history: written before D202, read as before
    'revisions': 'id integer primary key autoincrement, old_evidence_id text, new_evidence_id text, said_day text, seq integer',      # D202: the new piece revises the old; both stay in force
    'same_claims': 'id integer primary key autoincrement, old_evidence_id text, new_evidence_id text, seq integer',                    # D204: the matcher read the new piece as the same claim as the old; both stored, both in force
    'dependencies': 'dependency_id integer primary key autoincrement, view_id text, depends_on text, wait_chain_view_id text, wait_year text, direction text, seq integer',
    'dependency_resolutions': 'id integer primary key autoincrement, dependency_id integer, resolved_to text, reason text, seq integer',
    'successions': 'id integer primary key autoincrement, view_id text, succeeds text, seq integer',
    'handovers': 'id integer primary key autoincrement, input_id text, seq integer, handover_json text',
    'match_records': 'id integer primary key autoincrement, seq integer, input_id text, call_no integer, shown_json text, request_sha256 text, call_id integer, decisions_json text, checks_json text, written_json text',
    'processing_steps': 'id integer primary key autoincrement, input_id text, sequence_no integer, step text, result text, reason text, publication_day text, at text',
    'review_pool_entries': 'id integer primary key autoincrement, kind text, key text, example_json text, seq integer',
    'late_statements': 'id integer primary key autoincrement, input_id text, evidence_quote text, reason text, seq integer',
    'days_completed': 'id integer primary key autoincrement, day text, seq integer, at text',
    # D149 research groups: an ongoing business subject several distinct theses belong to; membership is decided by extraction and written with the thesis
    'thesis_groups': 'group_id text primary key, name text, scope text, aliases text, created_seq integer, created_from_input text',
    'thesis_group_members': 'id integer primary key autoincrement, group_id text, view_id text, seq integer, input_id text, basis text',
    # D166 (2026-11-01): the names a later declaration gives a stored group, appended once each; a group's aliases are its creation's plus these
    'thesis_group_aliases': 'id integer primary key autoincrement, group_id text, alias text, seq integer, input_id text',
}

INDEXES = [
    'create index if not exists views_object on views(object_id)',
    'create index if not exists judgements_view on judgements(view_id, judgement_id)',
    # 06-views step 7: a view is judged once per round (one item = one sequence number)
    'create unique index if not exists judgements_once_per_round on judgements(view_id, seq)',
    'create index if not exists links_view on evidence_links(view_id)',
    'create index if not exists links_evidence on evidence_links(evidence_id)',
    'create index if not exists sources_evidence on evidence_sources(evidence_id)',
    'create index if not exists steps_input on processing_steps(input_id, id)',
    'create index if not exists switches_view on view_switches(view_id, id)',
    'create index if not exists deps_view on dependencies(view_id)',
]


def open_db(path):
    os.makedirs(os.path.dirname(os.path.abspath(path)), exist_ok=True)
    conn = sqlite3.connect(path)
    conn.row_factory = sqlite3.Row
    for name, columns in TABLES.items():
        conn.execute(f'create table if not exists {name} ({columns})')
        conn.execute(f"create trigger if not exists {name}_no_update before update on {name} begin select raise(abort, 'append-only'); end")
        conn.execute(f"create trigger if not exists {name}_no_delete before delete on {name} begin select raise(abort, 'append-only'); end")
    for statement in INDEXES:
        conn.execute(statement)
    ensure_writable_columns(conn)
    conn.execute("create virtual table if not exists views_fts using fts5(view_id unindexed, text, tokenize='trigram')")
    conn.execute("create virtual table if not exists groups_fts using fts5(group_id unindexed, text, tokenize='trigram')")
    conn.execute('create index if not exists members_view on thesis_group_members(view_id)')
    conn.commit()
    return conn


def insert(conn, table, **fields):
    columns = list(fields)
    cursor = conn.execute(f'insert into {table} ({",".join(columns)}) values ({",".join("?" * len(columns))})', [fields[c] for c in columns])
    return cursor.lastrowid


# ---------- views ----------

def create_view(conn, *, view_id, object_id, object_kind, kind, looks_at, question, due_day, year, rungs, seq, input_id, created_at):
    insert(conn, 'views', view_id=view_id, object_id=object_id, object_kind=object_kind, kind=kind, looks_at=looks_at,
           question=question, due_day=due_day, year=year, created_seq=seq, created_from_input=input_id, created_at=created_at)
    for position, rung in enumerate(rungs, start=1):
        insert(conn, 'rungs', view_id=view_id, position=position, label=rung['label'], condition=rung['condition'], lo=rung.get('lo'), hi=rung.get('hi'))
    insert(conn, 'view_switches', view_id=view_id, open=1, reason='created', by_whom='matching', after_seq=seq)
    conn.execute('insert into views_fts (view_id, text) values (?, ?)', (view_id, f'{object_id} {looks_at} {question}'))


def view(conn, view_id):
    row = conn.execute('select * from views where view_id=?', (view_id,)).fetchone()
    return dict(row) if row else None


def rungs_of(conn, view_id):
    """The rungs with their bounds when the ledger has them (keyed views); a ledger written before keys has no lo/hi columns."""
    rows = [dict(r) for r in conn.execute('select * from rungs where view_id=? order by position', (view_id,))]
    has_bounds = any(r.get('lo') is not None or r.get('hi') is not None for r in rows) or view_key(conn, view_id) is not None
    return [dict(position=r['position'], label=r['label'], condition=r['condition'],
                 **({'lo': r.get('lo'), 'hi': r.get('hi')} if has_bounds else {})) for r in rows]

