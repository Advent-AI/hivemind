    58	# description of the evidence field `links`, so the field has its definition beside it (AGENTS §6: a field without a definition is a
    59	# coin flip per send; D256). This constant is the rule's owner for the extraction; v4's file stays the separate call's wording.
    60	FILING_RULE = ('The questions this statement is filed under: the id of the narrowest open question in [Open questions] whose takes line covers it '
    61	               '(that one only, never a broader question beside it; whoever says it, and even when it gives no period, basis or exact amount, '
    62	               'because the weight is judged later, not here; a period in a takes line tells apart questions about the same quantity for different '
    63	               'periods and bars no figure or driver from another period when no open question covers that period), plus the ids of this answer\'s '
    64	               'candidates the statement supports; empty when no takes line and no candidate covers it, however important it sounds.')
    65	
    66	
    67	def question_lines(shown):
    68	    """One line per open question with its takes line below it: what the placer reads, and from extraction v72 what the extraction
    69	    reads under [Open questions]. One writer for both requests."""
    70	    return [f"  - {v['view_id']} ({v['object_id']}, due {v['due_day']}): {v['question']}\n      {takes(v)}" for v in shown]
    71	
    72	
    73	def build_request(statements, shown, item=None):
    74	    head = f"[Item] {item.get('publisher') or ''}, {item.get('publication_day') or ''}: {item.get('title') or ''}\n\n" if item else ''
    75	    lines = question_lines(shown)
    76	    return (head + '[Open questions]\n' + '\n'.join(lines) + '\n\n[Statements]\n'
    77	            + '\n'.join(f"  - {e['id']} [{e.get('tier')}] who: {e.get('original_who') or e.get('speaker') or ''} | {e.get('one_line')} | quote: {(e.get('quote') or '')[:240]}" for e in statements)
    78	            + '\n\nReturn one placement per statement id, in order.')
    79	
    80	
    81	def place(archive, cfg, statements, shown, *, item=None, transport=None, prompt=None):
    82	    """Returns (placed, unfiled, answer): every statement with its links decided; the extraction's candidate links kept; the
    83	    caller drops the unfiled.
    84	    prompt names the placement prompt file; the configuration's is the default."""
    85	    if not statements:
    86	        return [], [], None
    87	    with open(config.prompt_path((prompt or cfg.placement.prompt_version) + '.txt'), encoding='utf-8') as handle:
    88	        system = handle.read()
    89	    user = build_request(statements, shown, item=item)
    90	    answer = model.call(archive, cfg, cfg.placement, system, user, SCHEMA, 'placement', 'place', transport=transport)
    91	    allowed = {v['view_id'] for v in shown}
    92	    decided = {}
    93	    for p in answer.data['placements']:
    94	        decided.setdefault(p['id'], [l for l in p['links'] if l in allowed])
    95	    placed, unfiled = [], []
    96	    for e in statements:
    97	        links = list(dict.fromkeys([l for l in e.get('links', []) if CANDIDATE_ID.match(l)] + decided.get(e['id'], [])))
    98	        (placed if links else unfiled).append(dict(e, links=links))
    99	    return placed, unfiled, answer

