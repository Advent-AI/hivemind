     "figures": [
      {
       "quote": "Announced the NVIDIA Vera Rubin platform is ramping into full production with racks running at partners including CoreWeave, Google Cloud, Microsoft Azure, Oracle Cloud Infrastructure and Nebius.",
       "value": "ramping into full production",
       "unit": "as stated",
       "period": "Second quarter of fiscal 2027",
