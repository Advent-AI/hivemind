{"type":"item.completed","item":{"id":"item_0","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc 'cat docs/research/2026-11-14-use-acceptance/reflection-3/coverage-packet.json'","aggregated_output":"{\n \"library_1\": {\n  \"built_from_news\": \"2026-07-01 to 2026-08-28\",\n  \"questions\": [\n   {\n    \"id\": \"v1\",\n    \"opened_on\": \"2026-07-01\",\n    \"whose\": \"NVDA\",\n    \"question\": \"Will NVIDIA enter at least one publicly verifiable binding financial guarantee or unsold-capacity purchase commitment under the AI Compute Partnership by 2027-01-31?\",\n    \"due_day\": \"2027-01-31\"\n   },\n   {\n    \"id\": \"v2\",\n    \"opened_on\": \"2026-07-02\",\n    \"whose\": \"NVDA\",\n    \"question\": \"What will NVIDIA report as total revenue for FY2027?\",\n    \"due_day\": \"2027-02-24\"\n   },\n   {\n    \"id\": \"v3\",\n    \"opened_on\": \"2026-07-02\",\n    \"whose\": \"chip-export-controls\",\n    \"question\": \"Will the Chinese government permit NVIDIA H200 sales in China by 2026-12-31?\",\n    \"due_day\": \"2026-12-31\"\n   },\n   {\n    \"id\": \"v4\",\n    \"opened_on\": \"2026-07-04\",\n    \"whose\": \"ai-capex\",\n    \"question\": \"How much will the four largest AI hyperscalers spend on data-center capital expenditures in calendar 2026?\",\n    \"due_day\": \"2027-03-31\"\n   },\n   {\n    \"id\": \"v5\",\n    \"opened_on\": \"2026-07-04\",\n    \"whose\": \"ai-capex\",\n    \"question\": \"How much will the four largest AI hyperscalers spend on data-center capital expenditures in calendar 2027?\",\n    \"due_day\": \"2028-03-31\"\n   },\n   {\n    \"id\": \"v6\",\n    \"opened_on\": \"2026-07-04\",\n    \"whose\": \"NVDA\",\n    \"question\": \"What gross margin will NVIDIA report for FY2027?\",\n    \"due_day\": \"2027-02-24\"\n   },\n   {\n    \"id\": \"v7\",\n    \"opened_on\": \"2026-07-05\",\n    \"whose\": \"NVDA\",\n    \"question\": \"What revenue will NVIDIA report from stand-alone CPUs for FY2027?\",\n    \"due_day\": \"2027-02-24\"\n   },\n   {\n    \"id\": \"v8\",\n    \"opened_on\": \"2026-07-06\",\n    \"whose\": \"NVDA\",\n    \"question\": \"Will NVIDIA launch its Rubin Ultra high-density rack design by 2027-12-31?\",\n    \"due_day\": \"2027-12-31\"\n   },\n   {\n    \"id\": \"v9\",\n    \"opened_on\": \"2026-07-06\",\n    \"whose\": \"NVDA\",\n    \"question\": \"Will NVIDIA release the Kyber rack-scale architecture by 2028-12-31?\",\n    \"due_day\": \"2028-12-31\"\n   },\n   {\n    \"id\": \"v10\",\n    \"opened_on\": \"2026-07-06\",\n    \"whose\": \"NVDA\",\n    \"question\": \"What Data Center segment revenue will NVIDIA report for FY2027?\",\n    \"due_day\": \"2027-02-24\"\n   },\n   {\n    \"id\": \"v11\",\n    \"opened_on\": \"2026-07-08\",\n    \"whose\": \"chip-export-controls\",\n    \"question\": \"Will China formally authorize H200 imports for the named AI companies by 2027-01-31?\",\n    \"due_day\": \"2027-01-31\"\n   },\n   {\n    \"id\": \"v12\",\n    \"opened_on\": \"2026-07-08\",\n    \"whose\": \"NVDA\",\n    \"question\": \"Will NVIDIA complete the reported purchase of about US$500 million of Firmus preference shares by 2026-12-31?\",\n    \"due_day\": \"2026-12-31\"\n   },\n   {\n    \"id\": \"v13\",\n    \"opened_on\": \"2026-07-08\",\n    \"whose\": \"NVDA\",\n    \"question\": \"What profit will NVIDIA report for FY2027?\",\n    \"due_day\": \"2027-02-24\"\n   },\n   {\n    \"id\": \"v14\",\n    \"opened_on\": \"2026-07-09\",\n    \"whose\": \"chip-export-controls\",\n    \"question\": \"Will China formally permit selected companies, including Alibaba Group Holding, to purchase Nvidia H200 chips by 2027-01-31?\",\n    \"due_day\": \"2027-01-31\"\n   },\n   {\n    \"id\": \"v15\",\n    \"opened_on\": \"2026-07-09\",\n    \"whose\": \"NVDA\",\n    \"question\": \"Will the French competition authority conclude its antitrust investigation into NVIDIA by 2027-01-31?\",\n    \"due_day\": \"2027-01-31\"\n   },\n   {\n    \"id\": \"v16\",\n    \"opened_on\": \"2026-07-13\",\n    \"whose\": \"ai-capex\",\n    \"question\": \"How much incremental compute capacity will Google, Amazon, Microsoft, and Meta add in calendar 2027?\",\n    \"due_day\": \"2028-02-01\"\n   },\n   {\n    \"id\": \"v17\",\n    \"opened_on\": \"2026-07-14\",\n    \"whose\": \"chip-export-controls\",\n    \"question\": \"Will the US Commerce Department issue a binding rule or other binding restriction implementing its May 2026 guidance on advanced AI-chip transfers to overseas subsidiaries of Chinese companies by 2027-01-31?\",\n    \"due_day\": \"2027-01-31\"\n   },\n   {\n    \"id\": \"v18\",\n    \"opened_on\": \"2026-07-16\",\n    \"whose\": \"NVDA\",\n    \"question\": \"By 2027-01-31, will NVIDIA ship Rubin GPUs for Noetra’s planned Japan AI factory deployment?\",\n    \"due_day\": \"2027-01-31\"\n   },\n   {\n    \"id\": \"v19\",\n    \"opened_on\": \"2026-07-17\",\n    \"whose\": \"NVDA\",\n    \"question\": \"Will NVIDIA launch any of the GeForce RTX 50 SUPER models by 2027-01-31?\",\n    \"due_day\": \"2027-01-31\"\n   },\n   {\n    \"id\": \"v20\",\n    \"opened_on\": \"2026-07-20\",\n    \"whose\": \"NVDA\",\n    \"question\": \"Will NVIDIA begin sampling its Vera Rubin platform by 2026-12-31?\",\n    \"due_day\": \"2026-12-31\"\n   },\n   {\n    \"id\": \"v21\",\n    \"opened_on\": \"2026-07-21\",\n    \"whose\": \"NVDA\",\n    \"question\": \"Will NVIDIA begin shipping Vera Rubin systems to customers by 2026-12-31?\",\n    \"due_day\": \"2026-12-31\"\n   },\n   {\n    \"id\": \"v22\",\n    \"opened_on\": \"2026-07-21\",\n    \"whose\": \"NVDA\",\n    \"question\": \"Will NVIDIA launch DLSS 5 by 2026-12-31?\",\n    \"due_day\": \"2026-12-31\"\n   },\n   {\n    \"id\": \"v23\",\n    \"opened_on\": \"2026-07-23\",\n    \"whose\": \"chip-export-controls\",\n    \"question\": \"Will the U.S. Senate approve the Remote Access Security Act by 2027-01-31?\",\n    \"due_day\": \"2027-01-31\"\n   },\n   {\n    \"id\": \"v24\",\n    \"opened_on\": \"2026-07-23\",\n    \"whose\": \"NVDA\",\n    \"question\": \"What revenue will NVIDIA report from stand-alone server CPUs for calendar 2026?\",\n    \"due_day\": \"2027-05-26\"\n   },\n   {\n    \"id\": \"v25\",\n    \"opened_on\": \"2026-07-23\",\n    \"whose\": \"NVDA\",\n    \"question\": \"What operating margin will NVIDIA report for FY2027?\",\n    \"due_day\": \"2027-02-24\"\n   },\n   {\n    \"id\": \"v26\",\n    \"opened_on\": \"2026-07-24\",\n    \"whose\": \"NVDA\",\n    \"question\": \"Will NVIDIA complete its planned $1 billion investment in NAVER by 2027-01-31?\",\n    \"due_day\": \"2027-01-31\"\n   },\n   {\n    \"id\": \"v27\",\n    \"opened_on\": \"2026-07-24\",\n    \"whose\": \"chip-export-controls\",\n    \"question\": \"Will the U.S. government formally adopt a ban on Chinese AI models by 2027-01-31?\",\n    \"due_day\": \"2027-01-31\"\n   },\n   {\n    \"id\": \"v28\",\n    \"opened_on\": \"2026-07-25\",\n    \"whose\": \"NVDA\",\n    \"question\": \"Will SK Telecom's first AI data center in South Korea enter service by 2027-12-31?\",\n    \"due_day\": \"2027-12-31\"\n   },\n   {\n    \"id\": \"v29\",\n    \"opened_on\": \"2026-07-26\",\n    \"whose\": \"NVDA\",\n    \"question\": \"Will NVIDIA enter a publicly verifiable binding purchase commitment for memory supply with SK Hynix by 2027-01-26?\",\n    \"due_day\": \"2027-01-26\"\n   },\n   {\n    \"id\": \"v30\",\n    \"opened_on\": \"2026-07-26\",\n    \"whose\": \"NVDA\",\n    \"question\": \"How much capital expenditure will NVIDIA report for FY2027?\",\n    \"due_day\": \"2027-02-24\"\n   },\n   {\n    \"id\": \"v31\",\n    \"opened_on\": \"2026-07-27\",\n    \"whose\": \"NVDA\",\n    \"question\": \"Will Nvidia enter a publicly verifiable binding guarantee or backstop for OpenAI's Ohio data center lease or construction debt by 2027-01-27?\",\n    \"due_day\": \"2027-01-27\"\n   },\n   {\n    \"id\": \"v32\",\n    \"opened_on\": \"2026-07-27\",\n    \"whose\": \"NVDA\",\n    \"question\": \"Will NVIDIA enter a publicly verifiable binding financing arrangement for OpenAI's purchase of NVIDIA AI chips by 2027-01-27?\",\n    \"due_day\": \"2027-01-27\"\n   },\n   {\n    \"id\": \"v33\",\n    \"opened_on\": \"2026-07-27\",\n    \"whose\": \"NVDA\",\n    \"question\": \"Will NVIDIA enter a publicly verifiable binding financing obligation for OpenAI data centers by 2027-07-27?\",\n    \"due_day\": \"2027-07-27\"\n   },\n   {\n    \"id\": \"v34\",\n    \"opened_on\": \"2026-07-27\",\n    \"whose\": \"NVDA\",\n    \"question\": \"Will NVIDIA enter a publicly verifiable binding equity investment in Safe Superintelligence by 2027-01-27?\",\n    \"due_day\": \"2027-01-27\"\n   },\n   {\n    \"id\": \"v35\",\n    \"opened_on\": \"2026-07-27\",\n    \"whose\": \"chip-export-controls\",\n    \"question\": \"Will the U.S. government formally adopt a restriction on access to Chinese open-source AI models by 2027-01-31?\",\n    \"due_day\": \"2027-01-31\"\n   },\n   {\n    \"id\": \"v36\",\n    \"opened_on\": \"2026-07-27\",\n    \"whose\": \"NVDA\",\n    \"question\": \"Will NVIDIA launch its Rosa CPU as part of the Feynman data center platform by 2028-12-31?\",\n    \"due_day\": \"2028-12-31\"\n   },\n   {\n    \"id\": \"v37\",\n    \"opened_on\": \"2026-07-28\",\n    \"whose\": \"NVDA\",\n    \"question\": \"Will NVIDIA enter a publicly verifiable binding lease commitment for the Hut 8 Texas data center by 2027-01-28?\",\n    \"due_day\": \"2027-01-28\"\n   },\n   {\n    \"id\": \"v38\",\n    \"opened_on\": \"2026-07-28\",\n    \"whose\": \"chip-export-controls\",\n    \"question\": \"Will Taiwan’s government adopt its own restrictions on AI-chip sales to China by 2027-01-31?\",\n    \"due_day\": \"2027-01-31\"\n   },\n   {\n    \"id\": \"v39\",\n    \"opened_on\": \"2026-07-28\",\n    \"whose\": \"chip-export-controls\",\n    \"question\": \"Will the U.S. administration formally adopt a ban on open-weight AI models from China by 2027-01-31?\",\n    \