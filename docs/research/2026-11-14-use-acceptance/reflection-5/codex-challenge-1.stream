CREATE TABLE evidence (evidence_id text primary key, quote text, one_line text, speaker text, original_who text, original_day text, tier text, event_time text, created_seq integer, created_from_input text);
CREATE TRIGGER evidence_no_update before update on evidence begin select raise(abort, 'append-only'); end;
CREATE TRIGGER evidence_no_delete before delete on evidence begin select raise(abort, 'append-only'); end;
CREATE TABLE evidence_sources (id integer primary key autoincrement, evidence_id text, input_id text, category text, publication_day text, location text, seq integer);
CREATE TRIGGER evidence_sources_no_update before update on evidence_sources begin select raise(abort, 'append-only'); end;
CREATE TRIGGER evidence_sources_no_delete before delete on evidence_sources begin select raise(abort, 'append-only'); end;
CREATE INDEX sources_evidence on evidence_sources(evidence_id);
CREATE TABLE same_claims (id integer primary key autoincrement, old_evidence_id text, new_evidence_id text, seq integer);
CREATE TRIGGER same_claims_no_update before update on same_claims begin select raise(abort, 'append-only'); end;
CREATE TRIGGER same_claims_no_delete before delete on same_claims begin select raise(abort, 'append-only'); end;
CREATE TABLE judgements (judgement_id integer primary key autoincrement, view_id text, seq integer, input_id text, rung integer, reasons text, cited_evidence_json text, cited_views_json text, pushes_json text, changed integer, why_changed text, config_checksum text, call_id integer, request_sha256 text, publication_day text, theme_pushes_json text, reference text, implied_outcome text);
CREATE TRIGGER judgements_no_update before update on judgements begin select raise(abort, 'append-only'); end;
CREATE TRIGGER judgements_no_delete before delete on judgements begin select raise(abort, 'append-only'); end;
CREATE INDEX judgements_view on judgements(view_id, judgement_id);
CREATE UNIQUE INDEX judgements_once_per_round on judgements(view_id, seq);

