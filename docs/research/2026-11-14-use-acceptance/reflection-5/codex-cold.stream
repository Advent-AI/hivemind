omparison-2026-11-13/identity-probe/v2/audit-c16v4-blind.stderr\nclean-arch/e2e-comparison-2026-11-13/identity-probe/v2/cases-identity-v2.json\nclean-arch/e2e-comparison-2026-11-13/identity-probe/v2/reader-brief-v2.md\nclean-arch/e2e-comparison-2026-11-13/identity-probe/v2/reader-selection-v2next-T3.stderr\nclean-arch/e2e-comparison-2026-11-13/identity-probe/v2/reader-selection-v2next-T1.jsonl\nclean-arch/e2e-comparison-2026-11-13/identity-probe/v2/reader-selection-v2-T3.stderr\nclean-arch/e2e-comparison-2026-11-13/identity-probe/v2/reader-selection-v2next-T3.jsonl\nclean-arch/e2e-comparison-2026-11-13/eligibility/answers/third-claude.jsonl\nclean-arch/e2e-comparison-2026-11-13/eligibility/answers/control-packet-4-codex.jsonl\nclean-arch/e2e-comparison-2026-11-13/eligibility/answers/control-packet-8-codex.stream\nclean-arch/e2e-comparison-2026-11-13/eligibility/answers/control-packet-8-claude.jsonl\nclean-arch/e2e-comparison-2026-11-13/eligibility/answers/control-packet-3-codex.jsonl\nclean-arch/e2e-comparison-2026-11-13/eligibility/answers/control-packet-6-codex.jsonl\nclean-arch/e2e-comparison-2026-11-13/eligibility/answers/control-packet-10-claude.jsonl\nclean-arch/e2e-comparison-2026-11-13/eligibility/answers/control-packet-10-codex.stream\nclean-arch/e2e-comparison-2026-11-13/eligibility/answers/control-packet-1-codex.stream\nclean-arch/e2e-comparison-2026-11-13/eligibility/answers/control-packet-6-codex.stream\nclean-arch/e2e-comparison-2026-11-13/eligibility/answers/control-packet-6-claude.jsonl\nclean-arch/e2e-comparison-2026-11-13/eligibility/answers/control-packet-1-claude.jsonl\nclean-arch/e2e-comparison-2026-11-13/eligibility/answers/control-packet-10-codex.jsonl\nclean-arch/e2e-comparison-2026-11-13/full-matching-answers/match-r3-codex.txt\nclean-arch/e2e-comparison-2026-11-13/full-trace-answers/trace-r4-codex.jsonl\nclean-arch/e2e-comparison-2026-11-13/identity-probe/v2/reader-selection-v2next-T3.stream\nclean-arch/e2e-comparison-2026-11-13/eligibility/answers/control-packet-4-claude.jsonl\nclean-arch/e2e-comparison-2026-11-13/eligibility/answers/third-codex.jsonl\nclean-arch/e2e-comparison-2026-11-13/eligibility/answers/control-packet-8-codex.jsonl\nclean-arch/e2e-comparison-2026-11-13/eligibility/answers/control-packet-1-codex.jsonl\nclean-arch/e2e-comparison-2026-11-13/eligibility/answers/third-codex.stream\nclean-arch/e2e-comparison-2026-11-13/eligibility/answers/control-packet-9-claude.jsonl\nclean-arch/e2e-comparison-2026-11-13/eligibility/answers/control-packet-9-codex.stream\nclean-arch/e2e-comparison-2026-11-13/eligibility/answers/control-packet-4-codex.stream\nclean-arch/e2e-comparison-2026-11-13/eligibility/answers/control-packet-3-codex.stream\nclean-arch/e2e-comparison-2026-11-13/eligibility/answers/control-packet-3-claude.jsonl\nclean-arch/e2e-comparison-2026-11-13/eligibility/answers/control-packet-2-codex.jsonl\nclean-arch/e2e-comparison-2026-11-13/eligibility/answers/control-packet-5-codex.stream\nclean-arch/e2e-comparison-2026-11-13/eligibility/answers/control-packet-7-codex.jsonl\nclean-arch/e2e-comparison-2026-11-13/eligibility/answers/control-packet-2-codex.stream\nclean-arch/e2e-comparison-2026-11-13/eligibility/answers/control-packet-5-claude.jsonl\nclean-arch/e2e-comparison-2026-11-13/eligibility/answers/control-packet-2-claude.jsonl\nclean-arch/e2e-comparison-2026-11-13/identity-probe/v2/reader-selection-v2.jsonl\nclean-arch/e2e-comparison-2026-11-13/identity-probe/v2/select_candidates_v2.py\nclean-arch/e2e-comparison-2026-11-13/full-matching-answers/match-r5-codex.txt.stream\nclean-arch/e2e-comparison-2026-11-13/full-trace-answers/trace-r3-codex.txt.stderr\nclean-arch/e2e-comparison-2026-11-13/identity-probe/v2/reader-selection-v2-T3.jsonl\nclean-arch/e2e-comparison-2026-11-13/full-trace-answers/trace-r2-codex.txt\nclean-arch/e2e-comparison-2026-11-13/full-matching-answers/match-r4-codex.txt\nclean-arch/e2e-comparison-2026-11-13/identity-probe/v2/preflight-identity-v4.output.txt\nclean-arch/e2e-comparison-2026-11-13/identity-probe/v2/reader-brief-v2next-T1.md\nclean-arch/e2e-comparison-2026-11-13/identity-probe/v2/reader-selection-v2-T2.jsonl\nclean-arch/e2e-comparison-2026-11-13/identity-probe/v2/PROBE-DESIGN-v2.md\nclean-arch/e2e-comparison-2026-11-13/identity-probe/v2/reader-selection-v2-T4.jsonl\ndocs/research/2026-11-14-use-acceptance/unlisted-parts/fresh-a2/fiscal-note/RESULT.md\nclean-arch/e2e-comparison-2026-11-13/full-matching-answers/match-r5-claude.jsonl\nclean-arch/e2e-comparison-2026-11-13/full-matching-answers/match-r2-claude.jsonl\nclean-arch/e2e-comparison-2026-11-13/full-matching-answers/handoff-r6.md\nclean-arch/e2e-comparison-2026-11-13/full-trace-answers/handoff-r6.md\nclean-arch/e2e-comparison-2026-11-13/full-trace-answers/trace-r6-codex.txt.stderr\nclean-arch/e2e-comparison-2026-11-13/full-trace-answers/trace-r5-codex.txt\nclean-arch/e2e-comparison-2026-11-13/full-trace-answers/handoff-r2.md\nclean-arch/e2e-comparison-2026-11-13/full-matching-answers/match-r5-codex.txt.stderr\nclean-arch/e2e-comparison-2026-11-13/full-trace-answers/trace-r6-codex.txt.stream\ndocs/research/2026-11-14-use-acceptance/unlisted-parts/fresh-a2/line5/RESULT.md\ndocs/research/2026-11-14-use-acceptance/unlisted-parts/fresh-a2/postponement/RESULT.md\ndocs/research/2026-11-14-use-acceptance/unlisted-parts/fresh-a2/d-diagnostic/RESULT.md\nclean-arch/e2e-comparison-2026-11-13/full-matching-answers/third-codex.txt\nclean-arch/e2e-comparison-2026-11-13/full-trace-answers/trace-r2-codex.txt.stream\nclean-arch/e2e-comparison-2026-11-13/full-trace-answers/trace-r2-codex.jsonl\nclean-arch/e2e-comparison-2026-11-13/full-trace-answers/trace-r3-codex.txt\nclean-arch/e2e-comparison-2026-11-13/full-trace-answers/trace-r2-codex.txt.stderr\nclean-arch/e2e-comparison-2026-11-13/full-trace-answers/handoff-r3.md\ndocs/research/2026-11-14-use-acceptance/unlisted-parts/fresh-a2/postponement/AUDIT-RESULT.md\nclean-arch/e2e-comparison-2026-11-13/full-matching-answers/match-r4-claude.jsonl\nclean-arch/e2e-comparison-2026-11-13/full-matching-answers/mapping-full-views.json\nclean-arch/e2e-comparison-2026-11-13/full-matching-answers/handoff-r2.md\nclean-arch/e2e-comparison-2026-11-13/full-matching-answers/match-r1-codex.txt.stderr\nclean-arch/e2e-comparison-2026-11-13/full-matching-answers/match-r3-claude.jsonl\nclean-arch/e2e-comparison-2026-11-13/full-matching-answers/match-r2-codex.txt\nclean-arch/e2e-comparison-2026-11-13/full-matching-answers/handoff-r3.md\nclean-arch/e2e-comparison-2026-11-13/full-matching-answers/match-r1-codex.txt.stream\ndocs/research/2026-11-14-use-acceptance/d375-measure/SAME-DAY-CASES-RESULT.md\n","exit_code":0,"status":"completed"}}
