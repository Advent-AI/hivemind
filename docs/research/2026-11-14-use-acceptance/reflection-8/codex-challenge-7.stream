   275	    edited_controls_ok = {t: [table[t][f'edited-d{d}'][0] == 'no ladder' and not table[t][f'edited-d{d}'][1]['strict'] for d in (1, 2)] for t in CONTROLS}
   276	    edited_share_ok = {t: [not table[t][f'edited-d{d}'][1]['strict']                      # a lost answer is strict too
