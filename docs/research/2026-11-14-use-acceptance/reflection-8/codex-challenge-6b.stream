    27	def build(tmp_path, monkeypatch, statuses, fail=None, review=None):
    28	    """statuses: {(arm, draw, topic): 'ladder' | 'no ladder'}; fail: {(arm, draw, topic): mark failed by the claude family};
    29	    review: {(arm, draw, topic): {'codex': [...], 'claude': [...]}}."""
    30	    run = tmp_path / 'run'
    31	    outcomes, readers = {}, {family: {} for family in probe.collector.FAMILIES}
    32	    for arm, draw in probe.ORDER:
    33	        rows = []
    34	        for topic in probe.topics_of(draw):
    35	            status = statuses.get((arm, draw, topic), 'no ladder')
    36	            outcome = dict(FIGURE if status == 'ladder' else DECLINE, case=f'{arm}-d{draw}|{topic}')
    37	            if status == 'no ladder: refused':
    38	                outcome = dict(outcome, status=status, answer=None)
    39	            rows.append(outcome)
    40	            send = (outcome['case'], 1)
    41	            outcomes[send] = outcome
    42	            if status == 'no ladder: refused':
    43	                continue                                          # a lost answer goes to no reader
    44	            for family in readers:
    45	                row = holds_row(outcome)
    46	                if fail and family == list(probe.collector.FAMILIES)[1] and (arm, draw, topic) in fail:
    47	                    row[fail[(arm, draw, topic)]] = 'fails'
    48	                    row['why'] = 'a planted fault for the test'
    49	                readers[family][send] = row
    50	        (run / f'{arm}-d{draw}').mkdir(parents=True)
    51	        (run / f'{arm}-d{draw}' / 'outcomes.jsonl').write_text(''.join(json.dumps(row) + '\n' for row in rows))
    52	    keys = tmp_path / 'keys'
    53	    keys.mkdir()
    54	    (keys / 'controls-expected.json').write_text('{}')
    55	    reviewed = [name for name, outcome in ((o['case'], o) for o in outcomes.values())
    56	                if outcome['status'] == 'ladder' and name.split('|', 1)[1] in probe.TARGETS + probe.SHARE + ('u3/clean-10',)]
    57	    (keys / 'review-key.json').write_text(json.dumps({str(n): name for n, name in enumerate(reviewed, start=1)}))
    58	    for family in ('codex', 'claude'):
    59	        lines = []
    60	        for n, name in enumerate(reviewed, start=1):
