   231	def score(run_folder, key_folder, review_codex, review_claude):
   232	    folder = Path(run_folder) / 'reading'
   233	    key, item_of, outcomes, readers, problems = collector.read_rows(folder, Path(key_folder) / 'key.json')
   234	    if any(found['rows'] or found['unreadable lines'] for found in problems.values()):
   235	        raise SystemExit(f'NOT MEASURED: rows missing or not valid: {problems}')
   236	    for control, marks in json.loads((Path(key_folder) / 'controls-expected.json').read_text()).items():
   237	        for mark, value in marks.items():
   238	            if mark != 'all' and any(readers[reader][(control, 1)][mark] != value for reader in collector.FAMILIES):
   239	                raise SystemExit(f'NOT MEASURED: a family missed the planted {control} ({mark})')
   240	    review_key = json.loads((Path(key_folder) / 'review-key.json').read_text())
   241	    reviews = {}
   242	    for family, path in (('codex', review_codex), ('claude', review_claude)):
   243	        rows = [json.loads(line) for line in Path(path).read_text().splitlines() if line.strip()]
   244	        if sorted(row['item'] for row in rows) != list(range(1, len(review_key) + 1)):
   245	            raise SystemExit(f'NOT MEASURED: the {family} review does not hold each of the {len(review_key)} answers once')
   246	        for row in rows:
   247	            defects = row.get('defects')
   248	            if not isinstance(defects, list) or any(kind not in ('i', 'ii', 'iii', 'iv') for kind in defects):
   249	                raise SystemExit(f'NOT MEASURED: the {family} review row {row.get("item")} has no valid defects list')
   250	            reviews.setdefault(review_key[str(row['item'])], {})[family] = set(defects)
   251	    sends = {}
   252	    for arm, draw in ORDER:
   253	        for row in map(json.loads, (Path(run_folder) / f'{arm}-d{draw}' / 'outcomes.jsonl').read_text().splitlines()):
   254	            sends[row['case']] = row
   255	
   256	    def faults(send_name, row):
   257	        if row['status'] == 'no ladder: refused':
   258	            return {'agreed': True, 'strict': True, 'marks': ['refused twice']}
   259	        marks = [readers[reader][(send_name, 1)] for reader in collector.FAMILIES]
   260	        applying = [mark for mark in accounting.marks_that_apply(accounting.kind_of(outcomes[(send_name, 1)])) if mark in HARD]
   261	        failing = sorted({mark for mark in applying for m in marks if m.get(mark) == 'fails'})
   262	        return {'agreed': any(all(m.get(mark) == 'fails' for m in marks) for mark in applying), 'strict': bool(failing), 'marks': failing}
   263	    table = collections.defaultdict(dict)
   264	    for send_name, row in sends.items():
   265	        arm_draw, topic = send_name.split('|', 1)
   266	        table[topic][arm_draw] = (row['status'], faults(send_name, row))
   267	    declines = {t: sum(table[t][f'frozen-d{d}'][0] == 'no ladder' for d in (1, 2, 3)) for t in TARGETS}
