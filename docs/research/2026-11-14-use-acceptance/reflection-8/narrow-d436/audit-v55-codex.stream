/opt/homebrew/bin/zsh -lc "sed -n '520,553p;690,740p' /Users/lchingen/hivemind/clean-arch/step4-2026-11-10/stage_a/cases.json; rg -n -C 7 'pool-17' /Users/lchingen/hivemind/docs/research/2026-11-14-use-acceptance/reflection-8/narrow-d436 /Users/lchingen/hivemind/clean-arch/step4-2026-11-10 -g '*.json' -m 2" in /Users/lchingen/hivemind/docs/research/2026-11-14-use-acceptance/reflection-8/narrow-d436/audit-v55-inputs
