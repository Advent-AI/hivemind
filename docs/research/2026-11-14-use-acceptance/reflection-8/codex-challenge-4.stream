   137	                                          workers=WORKERS, first_alone=(arm, draw) == ('edited', 1), room=room)
   138	            known, in_full, _ = stage_a.ledger_total(folder / f'{arm}-d{draw}' / 'spend.jsonl')
   139	            spent[arm] += known + in_full
