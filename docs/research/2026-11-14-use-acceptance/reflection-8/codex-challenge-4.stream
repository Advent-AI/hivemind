   229	    elif command == 'send':
   230	        send(sys.argv[2])
   231	    elif command == 'reading':
   232	        reading(*sys.argv[2:4])
   233	    elif command == 'score':
   234	        score(*sys.argv[2:4])
   235	    else:
   236	        sys.exit(__doc__)

