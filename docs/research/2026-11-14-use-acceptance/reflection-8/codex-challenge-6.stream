    15	USAGE = {'prompt_tokens': 5200, 'completion_tokens': 200, 'prompt_tokens_details': {'cached_tokens': 2300}}   # the stored astra means on these topics (38 requests: input 5,187, output 196); the system text cached, as the diagnostic's $0.034 a send shows
    16	STORED = ['poc/data/clean-ladder-stage-a-astra-2026-11-17/run-1/send-*/outcomes.jsonl',
    17	          'poc/data/clean-second-side-probe-2026-11-17/run-1/*/outcomes.jsonl']
