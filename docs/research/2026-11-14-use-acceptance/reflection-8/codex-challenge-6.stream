    66	def passing_statuses():
    67	    out = {}
    68	    for draw in (1, 2, 3):
    69	        for topic in probe.TARGETS:
    70	            out[('frozen', draw, topic)] = 'no ladder'
    71	            out[('edited', draw, topic)] = 'ladder'
    72	    for draw in (1, 2):
    73	        out[('edited', draw, 'u3/clean-11')] = 'ladder'
    74	        out[('frozen', draw, 'u3/clean-11')] = 'ladder'
    75	    return out
