    18	def holds_row(outcome):
    19	    kind = probe.accounting.kind_of(outcome)
    20	    applicable = probe.accounting.marks_that_apply(kind)
    21	    row = {mark: ('holds' if mark in applicable else 'n/a') for mark in probe.accounting.ALL_MARKS}
    22	    row['G'] = 'not_assessable' if kind in ('company figure', 'theme figure') else 'n/a'
    23	    row.update(B=['not_a_bet'] * (0 if kind == 'refusal' else len(outcome['answer']['ladder']['not_judged'])), W='', why='')
    24	    return row
    25	
    26	
    27	def build(tmp_path, monkeypatch, statuses, fail=None, review=None):
    28	    """statuses: {(arm, draw, topic): 'ladder' | 'no ladder'}; fail: {(arm, draw, topic): mark failed by the claude family};
    29	    review: {(arm, draw, topic): {'codex': [...], 'claude': [...]}}."""
    30	    run = tmp_path / 'run'
    31	    outcomes, readers = {}, {family: {} for family in probe.collector.FAMILIES}
    32	    for arm, draw in probe.ORDER:
    33	        rows = []
    34	        for topic in probe.topics_of(draw):
    35	            status = statuses.get((arm, draw, topic), 'no ladder')
    36	            outcome = dict(FIGURE if status == 'ladder' else DECLINE, case=f'{arm}-d{draw}|{topic}')
    37	            rows.append(outcome)
    38	            send = (outcome['case'], 1)
    39	            outcomes[send] = outcome
    40	            for family in readers:
    41	                row = holds_row(outcome)
    42	                if fail and family == list(probe.collector.FAMILIES)[1] and (arm, draw, topic) in fail:
    43	                    row[fail[(arm, draw, topic)]] = 'fails'
    44	                    row['why'] = 'a planted fault for the test'
    45	                readers[family][send] = row
    46	        (run / f'{arm}-d{draw}').mkdir(parents=True)
    47	        (run / f'{arm}-d{draw}' / 'outcomes.jsonl').write_text(''.join(json.dumps(row) + '\n' for row in rows))
    48	    keys = tmp_path / 'keys'
    49	    keys.mkdir()
    50	    (keys / 'controls-expected.json').write_text('{}')
    51	    reviewed = [name for name, outcome in ((o['case'], o) for o in outcomes.values())
    52	                if outcome['status'] == 'ladder' and name.split('|', 1)[1] in probe.TARGETS + probe.SHARE + ('u3/clean-10',)]
    53	    (keys / 'review-key.json').write_text(json.dumps({str(n): name for n, name in enumerate(reviewed, start=1)}))
    54	    for family in ('codex', 'claude'):
    55	        lines = []
    56	        for n, name in enumerate(reviewed, start=1):
    57	            arm_draw, topic = name.split('|', 1)
    58	            arm, draw = arm_draw.split('-d')
    59	            defects = ((review or {}).get((arm, int(draw), topic)) or {}).get(family, [])
    60	            lines.append(json.dumps({'item': n, 'defects': defects, 'why': ''}))
    61	        (tmp_path / f'review-{family}.jsonl').write_text('\n'.join(lines) + '\n')
    62	    monkeypatch.setattr(probe.collector, 'read_rows', lambda folder, key_path: ({}, {}, outcomes, readers, {family: {'rows': [], 'unreadable lines': []} for family in probe.collector.FAMILIES}))
    63	    return run, keys, tmp_path / 'review-codex.jsonl', tmp_path / 'review-claude.jsonl'
