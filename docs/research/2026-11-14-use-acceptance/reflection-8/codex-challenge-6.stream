   158	            raise SystemExit('REFUSED: the requests differ from the checked record')
   159	    folder = Path(folder)
   160	    guard = probe_split.BreachGuard(transport or (lambda provider, request: model.openai_transport(provider, request, max_attempts=1)))
   161	    room = WORKERS * max(budget.worst_cost(built(case, 'edited', rl)) for case in topics.values())
   162	    spent = collections.Counter()
   163	    original = stage_a.request_texts
   164	    try:
   165	        for arm, draw in ORDER:
