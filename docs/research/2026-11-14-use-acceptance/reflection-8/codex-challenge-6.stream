   102	    statuses = {**passing_statuses(), ('edited', 1, 'u2/clean-10'): 'ladder'}
   103	    assert probe.score(*build(tmp_path, monkeypatch, statuses)) == 'PASS'
   104	
   105	
   106	def test_the_share_control_asking_the_total_fails(tmp_path, monkeypatch):
   107	    review = {('edited', 1, 'u3/clean-11'): {'codex': ['i']}}
   108	    assert probe.score(*build(tmp_path, monkeypatch, passing_statuses(), review=review)) == 'FAIL'
   109	
   110	
   111	def test_too_few_frozen_declines_is_inconclusive(tmp_path, monkeypatch):
   112	    statuses = passing_statuses()
   113	    for draw in (1, 2, 3):
   114	        for topic in probe.TARGETS[1:]:
   115	            statuses[('frozen', draw, topic)] = 'ladder'          # only acc/clean-8 declined: 3 sends on 1 target
   116	    assert probe.score(*build(tmp_path, monkeypatch, statuses)).startswith('INCONCLUSIVE')
   117	
   118	
   119	def test_the_capacity_topic_is_reported_not_deciding(tmp_path, monkeypatch):
   120	    statuses = {**passing_statuses(), **{('edited', draw, 'u3/clean-10'): 'no ladder' for draw in (1, 2, 3)}}
   121	    assert probe.score(*build(tmp_path, monkeypatch, statuses)) == 'PASS'
   122	
   123	
   124	def test_a_review_row_without_a_defects_list_is_not_measured(tmp_path, monkeypatch):
   125	    run, keys, codex, claude = build(tmp_path, monkeypatch, passing_statuses())
   126	    lines = codex.read_text().splitlines()
   127	    lines[0] = json.dumps({'item': 1, 'why': ''})
   128	    codex.write_text('\n'.join(lines) + '\n')
   129	    with pytest.raises(SystemExit, match='NOT MEASURED'):
   130	        probe.score(run, keys, codex, claude)
   131	
   132	
   133	def test_check_refuses_a_shared_cap_below_the_room_and_expected_spend(monkeypatch, tmp_path):
   134	    monkeypatch.setattr(probe, 'TOTAL_CAP', 2.0)
   135	    monkeypatch.setattr(probe, 'RECORD', tmp_path / 'check-passed.json')
   136	    with pytest.raises(SystemExit, match='CHECK FAILED'):
   137	        probe.check()

