    20	def transport():
    21	    """Answers each request with a stored astra answer for its topic: a written ladder in the edited arm and a decline in the frozen arm
    22	    when both are stored, else whichever is stored."""
    23	    by_name = {}
    24	    for pattern in STORED:
    25	        for path in glob.glob(str(probe.ROOT / pattern)):
    26	            for row in map(json.loads, Path(path).read_text().splitlines()):
    27	                if row['status'] in ('ladder', 'no ladder'):
    28	                    by_name.setdefault(row['case'].split('|')[-1], {}).setdefault(row['status'], row['requests'][-1]['answer_text'])
    29	    descriptions = {case['thesis']['description']: name for name, case in probe.population().items()}
    30	    edited_system = probe.edited_texts()['system']
    31	    sent = []
    32	
    33	    def send(provider, request):
    34	        system, user = request['messages'][0]['content'], request['messages'][1]['content']
    35	        name = next(name for description, name in descriptions.items() if json.dumps(description, ensure_ascii=False)[1:-1] in user)
    36	        arm = 'edited' if system == edited_system else 'frozen'
    37	        stored = by_name[name]
    38	        text = stored.get('ladder' if arm == 'edited' else 'no ladder') or next(iter(stored.values()))
    39	        sent.append((arm, name, request))
    40	        return {'choices': [{'message': {'content': text}}], 'usage': USAGE}
    41	    send.sent = sent
    42	    return send
    43	
    44	
    45	@pytest.fixture(scope='module')
    46	def run(tmp_path_factory):
    47	    folder = tmp_path_factory.mktemp('paired')
    48	    original, probe.RECORD = probe.RECORD, folder / 'check-passed.json'
    49	    try:
    50	        probe.check()
    51	        fake = transport()
    52	        probe.send(folder / 'run', transport=fake)
    53	        probe.reading(folder / 'run', folder / 'keys')
    54	        yield folder, fake
    55	    finally:
    56	        probe.RECORD = original
