     1	"""The paired exposed verification of the narrow D436 passage (deep council D653, rounds 1 to 5): astra on the frozen ladder request against
     2	astra on the request with the audited passage (`edit.json`), on four targets astra declined against D436 (acc/clean-8, acc/clean-9 and
     3	u3/clean-10, three of the six theses put to Alex before D436, and pool-17), six decline controls, and one share-centred control (u3/clean-11,
     4	whose outcome tracks the share itself), read blind by both families with planted controls, and each written answer of the edited arm on a
     5	target or on the share control reviewed against its source by two reviewers. Exposed: the 44's targets informed the edit; this verifies that the
     6	step carries Alex's ruling, not general performance.
     7	
     8	  python3 paired_probe.py check                         # $0: the requests, the one inserted passage, the shared cap; writes check-passed.json
     9	  python3 paired_probe.py send <new run folder>         # frozen and edited interleaved: d1, d2 on all 11 topics; d3 on the 4 targets
    10	  python3 paired_probe.py reading <run folder> <key folder>
    11	  python3 paired_probe.py score <run folder> <key folder> <review codex rows> <review claude rows>
    12	
    13	The rule, fixed before the send (council rounds 2 and 4):
    14	- exercised: the frozen arm's own declines ("no ladder", not answers refused twice by code) are at least 6 of its 12 target sends and fall on
    15	  at least 3 of the 4 targets; otherwise INCONCLUSIVE;
    16	- PASS when all hold, otherwise FAIL:
    17	  - every edited target send (12) is a question with no hard-line fault marked by either family;
    18	  - no edited target or share-control answer carries a material defect of kinds (i) to (iii) of `review-brief.md` marked by both reviewers;
    19	  - every edited decline-control send (12) is a decline that neither family marks unjustified;
    20	  - both edited share-control sends ask the share, with no hard-line fault marked by either family;
    21	  - no edited send is lost (refused twice by code);
    22	- due-day defects (kind iv) are the separate D636 class: reported for both arms, not deciding;
    23	- a stopped draw or a missed planted control reads NOT MEASURED.
    24	"""
    25	import collections
    26	import dataclasses
    27	import hashlib
    28	import json
    29	import random
    30	import sys
    31	from pathlib import Path
    32	
    33	HERE = Path(__file__).resolve().parent
    34	ROOT = HERE.parents[4]
    35	sys.path[:0] = [str(HERE.parents[1] / 'reflection-6' / 'opus')]
    36	import opus_probe as base  # noqa: E402   (the trial harness: run_arm, the planted controls, Stage A, the ladder step, the readers' tools)
    37	from opus_probe import (accounting, budget, build_reader_packets, collector, ladder_step, model, probe_split, refcontrol,  # noqa: E402
    38	                        stage_a)
    39	
    40	ASTRA = dataclasses.replace(stage_a.SETTING, model='gpt-6-astra')
    41	EDIT = json.loads((HERE / 'edit.json').read_text())
    42	ANCHOR, INSERTED = EDIT['anchor'], EDIT['insert']
    43	ARMS = ('frozen', 'edited')
    44	ORDER = [('frozen', 1), ('edited', 1), ('frozen', 2), ('edited', 2), ('frozen', 3), ('edited', 3)]
    45	TARGETS = ('acc/clean-8', 'acc/clean-9', 'u3/clean-10', 'pool-17')
    46	CONTROLS = ('week-10-06:c1/clean-4', 'week-10-06:c1/clean-12', 'fortnight:c1/clean-8', 'pool-19', 'u1/clean-9', 'u2/clean-10')
    47	SHARE = ('u3/clean-11',)
    48	WORKERS = 1
    49	EXPECTED_SPEND = 1.20            # 26 sends an arm at up to about $0.045 a send (astra measured $0.033 to $0.047; D633-D649)
    50	TOTAL_CAP = 3.60                 # one cap shared by both arms: in-flight room (~$1.18) plus both arms' expected spend; within Alex's remaining ~$4.34
    51	RECORD = HERE / 'check-passed.json'
    52	SELECTION = HERE.parents[1] / 'reflection-7' / 'fresh-selection.json'
    53	HARD = refcontrol.HARD
    54	SHUFFLE_SEED = 20261136
    55	CODE_FILES = [Path(__file__), Path(base.__file__), SELECTION, HERE / 'edit.json', refcontrol.LADDER / 'ladder_step.py', refcontrol.LADDER / 'candidate-system.txt',
    56	              refcontrol.LADDER / 'candidate-closing.txt', refcontrol.LADDER / 'candidate-schema.json', refcontrol.STAGE_A / 'stage_a.py']
    57	
    58	
    59	FROZEN_TEXTS = stage_a.request_texts          # held here: `send` re-points stage_a.request_texts at an arm's texts during its draws
    60	
    61	
    62	def frozen_texts():
    63	    return FROZEN_TEXTS()
    64	
    65	
    66	def edited_texts():
    67	    texts = frozen_texts()
    68	    if texts['system'].count(ANCHOR) != 1:
    69	        raise SystemExit('the anchor sentence is not found once in the frozen system text')
    70	    return dict(texts, system=texts['system'].replace(ANCHOR, ANCHOR + INSERTED))
    71	
    72	
    73	TEXTS = {'frozen': frozen_texts, 'edited': edited_texts}
    74	
    75	
    76	def population():
    77	    """{name: case} for the 4 targets and 8 controls."""
    78	    pool = json.loads(SELECTION.read_text())['pool']
    79	    the_26 = {f'{source}:{name}': case for source, name, case, _ in refcontrol.population()}
    80	    the_44 = {case['case']: case for case in json.loads((refcontrol.STAGE_A / 'cases.json').read_text())}
    81	    out = {}
    82	    for name in TARGETS + CONTROLS + SHARE:
    83	        out[name] = pool[int(name.split('-')[1])]['case'] if name.startswith('pool-') else the_26.get(name) or the_44[name]
    84	    if len(out) != 11:
    85	        raise SystemExit(f'{len(out)} topics, not 11')
    86	    return out
    87	
    88	
    89	def topics_of(draw):
    90	    return TARGETS + CONTROLS + SHARE if draw in (1, 2) else TARGETS
    91	
    92	
    93	def built(case, arm, rl):
    94	    texts = TEXTS[arm]()
    95	    user = ladder_step.user_text(stage_a.payload_for(case, rl), texts['closing'])
    96	    return model.build_request(ASTRA, texts['system'], user, texts['schema'], 'clean_ladder', 'openai')
    97	
    98	
    99	def code_digest():
   100	    return hashlib.sha256(b''.join(path.read_bytes() for path in CODE_FILES)).hexdigest()
   101	
   102	
   103	def check():
   104	    rl = refcontrol.research_list()
   105	    failures, shas = [], {arm: {} for arm in ARMS}
   106	    for name, case in population().items():
   107	        frozen, edited = built(case, 'frozen', rl), built(case, 'edited', rl)
   108	        sent_frozen, sent_edited = json.dumps(frozen), json.dumps(edited)      # the transport's serialization
   109	        anchor = json.dumps(ANCHOR)[1:-1]
   110	        only_insert = sent_frozen.count(anchor) == 1 and sent_edited == sent_frozen.replace(anchor, anchor + json.dumps(INSERTED)[1:-1])
   111	        if not only_insert or frozen['model'] != 'gpt-6-astra':
   112	            failures.append(name)
   113	        for arm, request in (('frozen', frozen), ('edited', edited)):
   114	            shas[arm][name] = model.request_identity(request)[1]
   115	    room = WORKERS * max(budget.worst_cost(built(case, 'edited', rl)) for case in population().values())
   116	    print(f'11 topics: each edited request is the frozen astra request with only the audited passage inserted: {not failures}')
   117	    print(f'shared cap ${TOTAL_CAP:.2f}; in-flight room ${room:.3f}; expected spend ${2 * EXPECTED_SPEND:.2f} for both arms')
   118	    if TOTAL_CAP < room + 2 * EXPECTED_SPEND:
   119	        failures.append('the shared cap is below the room plus both arms\' expected spend')
   120	    if failures:
   121	        raise SystemExit(f'CHECK FAILED: {failures}')
   122	    RECORD.write_text(json.dumps({'code_sha256': code_digest(), 'requests': shas}, indent=1) + '\n')
   123	    print('check passed')
   124	
   125	
   126	def send(folder, *, transport=None):
   127	    record = json.loads(RECORD.read_text()) if RECORD.exists() else None
   128	    if record is None or record['code_sha256'] != code_digest():
   129	        raise SystemExit('no check record for these files: run `check` first')
   130	    rl = refcontrol.research_list()
   131	    topics = population()
   132	    for arm in ARMS:
   133	        if {name: model.request_identity(built(case, arm, rl))[1] for name, case in topics.items()} != record['requests'][arm]:
   134	            raise SystemExit('REFUSED: the requests differ from the checked record')
   135	    folder = Path(folder)
   136	    guard = probe_split.BreachGuard(transport or (lambda provider, request: model.openai_transport(provider, request, max_attempts=1)))
   137	    room = WORKERS * max(budget.worst_cost(built(case, 'edited', rl)) for case in topics.values())
   138	    spent = collections.Counter()
   139	    original = stage_a.request_texts
   140	    try:
   141	        for arm, draw in ORDER:
   142	            stage_a.request_texts = TEXTS[arm]          # base.run_arm reads the step's texts from Stage A for every call
   143	            cases = [dict(topics[name], case=f'{arm}-d{draw}|{name}') for name in topics_of(draw)]
   144	            written, limit = base.run_arm(cases, folder / f'{arm}-d{draw}', TOTAL_CAP - sum(spent.values()), ASTRA, rl, transport=guard,
   145	                                          workers=WORKERS, first_alone=(arm, draw) == ('edited', 1), room=room)
   146	            known, in_full, _ = stage_a.ledger_total(folder / f'{arm}-d{draw}' / 'spend.jsonl')
   147	            spent[arm] += known + in_full
   148	            print(f'{arm} d{draw}: {len(written)} of {len(cases)} written; spent ${known + in_full:.4f}', flush=True)
   149	            if guard.breaches or limit.stopped or len(written) != len(cases):
   150	                raise SystemExit(f'{arm} d{draw} STOPPED: {limit.stop_reason or guard.breaches}. NOT MEASURED.')
   151	    finally:
   152	        stage_a.request_texts = original
   153	    print(f'spent {dict(spent)}')
   154	
   155	

