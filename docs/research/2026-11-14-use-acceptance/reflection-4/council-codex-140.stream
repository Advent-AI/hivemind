   118	def render(port, shell, scratch, name):
   119	    """A fresh page pointed at the API; returns what it shows: its question count and the dates in its library text."""
   120	    page = shell.read_text()
   121	    m = re.search(r'<body([^>]*)>', page)
   122	    page = page.replace(m.group(0), f'<body{m.group(1)} data-api="http://127.0.0.1:{port}">', 1)
   123	    probe = ('<pre id="probe-result"></pre><script>setTimeout(()=>{const lib=document.getElementById("library");'
   124	             'const out={cards:lib.querySelectorAll(".card").length,questions:[...lib.querySelectorAll(".card__q")].map(q=>q.textContent.trim()).sort(),'
   125	             'status:Object.fromEntries([...lib.querySelectorAll(".library-card")].map(c=>[c.querySelector(".card__q").textContent.trim(),c.querySelector(".library-card-meta .chip--line").textContent.trim()]))};'
   126	             'document.querySelector("#probe-result").textContent=JSON.stringify(out);},6000);</script></body>')
   127	    (scratch / f'{name}.html').write_text(page.replace('</body>', probe))
   128	    web_port = free_port()
   129	    web = subprocess.Popen([sys.executable, '-m', 'http.server', str(web_port), '--bind', '127.0.0.1'], cwd=scratch,
   130	                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
   131	    time.sleep(1)
   132	    try:
   133	        dom = subprocess.run([CHROME, '--headless=new', '--disable-gpu', '--no-first-run', f'--user-data-dir={scratch / "chrome"}',
   134	                              '--virtual-time-budget=20000', '--dump-dom', f'http://127.0.0.1:{web_port}/{name}.html'],
   135	                             capture_output=True, text=True, timeout=180).stdout
   136	    finally:
   137	        web.terminate()
   138	    m = re.search(r'<pre id="probe-result">(.*?)</pre>', dom, re.S)
   139	    return json.loads(html.unescape(m.group(1))) if m and m.group(1) else None
