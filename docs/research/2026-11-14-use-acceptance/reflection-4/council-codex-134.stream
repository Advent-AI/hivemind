   176	def open_wal_store(path):
   177	    """The new store, created empty and exclusively, put in WAL mode (checked) before `store.open_db` writes its schema, with the -wal
   178	    size limit set on the writer's own connection."""
   179	    path = Path(path)
   180	    os.close(os.open(path, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o644))
   181	    first = sqlite3.connect(str(path))
   182	    try:
   183	        mode = first.execute('pragma journal_mode=wal').fetchone()[0]
   184	    finally:
   185	        first.close()
   186	    if mode != 'wal':
   187	        raise SystemExit(f'{path}: the journal mode is {mode!r}, not wal: refused')
   188	    conn = store.open_db(str(path))
   189	    conn.execute(f'pragma journal_size_limit={STORE_SIZE_LIMIT}')
   190	    return conn
