   202	def truncate_checkpoint(conn):
   203	    """A truncating checkpoint with a short wait; True when it completed (no reader held it back)."""
   204	    conn.execute('pragma busy_timeout=1000')
   205	    try:
   206	        return conn.execute('pragma wal_checkpoint(TRUNCATE)').fetchone()[0] == 0
   207	    except sqlite3.OperationalError:
   208	        return False
