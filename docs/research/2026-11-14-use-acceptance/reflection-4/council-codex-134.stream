   211	def leave_wal(conn):
   212	    """The writer's orderly end: rollback-journal mode when no reader holds the store; otherwise WAL is kept. Returns the mode."""
   213	    conn.execute('pragma busy_timeout=1000')
   214	    try:
   215	        return conn.execute('pragma journal_mode=delete').fetchone()[0]
