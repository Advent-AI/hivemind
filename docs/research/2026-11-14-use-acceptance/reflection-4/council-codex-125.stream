    61	class Connections:
    62	    """The databases one request reads: opened on entry, closed on exit, never shared between threads."""
    63	
    64	    def __init__(self, read_only=False):
    65	        self.read_only = read_only
    66	
    67	    def __enter__(self):
    68	        self.ledger = service.open_ledger(PATHS['views'])
    69	        self.index = None if self.read_only else search.open_index(PATHS['index'])
    70	        self.items = store.open_read_only(PATHS['items']) if PATHS.get('items') and os.path.exists(PATHS['items']) else None
    71	        self.archive = None if self.read_only else model.Archive(PATHS['archive'])
    72	        return self
    73	
    74	    def __exit__(self, *exc):
    75	        for conn in (self.ledger, self.index, self.items):
    76	            if conn is not None:
    77	                conn.close()
