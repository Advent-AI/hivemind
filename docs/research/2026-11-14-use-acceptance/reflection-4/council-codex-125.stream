    60	    if state == 'partial' and kind == 'omitted' and name in UNFILTERED:
    61	        return explicit_last[name]
    62	    if state == 'empty' and name == 'bundle.not_judged' and kind in ('past', 'future'):
    63	        # the direct-call rule (round 122): a view not visible at an explicit bound is refused, here one the empty store does not hold
    64	        return ['error', f"KeyError: 'v1 is not available as of {bound_cases.STATES[state][kind]}'"]
    65	    return before
