    50	    if isinstance(error, service.RangeNotOrdered):
    51	        return 409, {'error': 'range start after its end', 'start': error.start, 'end': error.end}
    52	    if isinstance(error, KeyError):
    53	        return 404, {'error': f'not found: {error}'}
    54	    if isinstance(error, service.LedgerError):
    55	        return 500, {'error': str(error)}
    56	    if isinstance(error, (model.TransportError, model.SchemaError, config.ConfigError)):
    57	        return 502, {'error': f'{type(error).__name__}: {str(error)[:200]}'}
