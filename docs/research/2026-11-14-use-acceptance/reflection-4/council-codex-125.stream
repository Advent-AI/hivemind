   106	def object_list(ledger, as_of, aliases=None):
   107	    """What the library covers, in one line: each object with open views as of the day and its count, then the
   108	    universe's objects with no view yet. About 250 characters on the sealed ledger against 5,095 for a full catalog."""
   109	    as_of = service.resolve_bound(ledger, as_of)
   110	    counts, kinds = {}, {}
   111	    for record in service.views(ledger, None, as_of):
   112	        counts[record['object']] = counts.get(record['object'], 0) + 1
   113	        kinds[record['object']] = record['object_kind']
   114	    covered = '; '.join(f'{obj} ({kinds[obj]}) {n}' for obj, n in sorted(counts.items(), key=lambda kv: -kv[1]))
   115	    missing = sorted(o for o in (aliases or {}) if o not in counts)
   116	    return (f'Objects with open views as of {as_of} (object, kind, number of views): {covered}.'
   117	            + (f' Objects in the universe with no view yet: {", ".join(missing)}.' if missing else ''))
