    80	class Handler(http.server.BaseHTTPRequestHandler):
    81	    def log_message(self, fmt, *args):   # one line per request, no query text or body (an idea can carry anything)
    82	        sys.stderr.write(f'{self.address_string()} {self.command} {self.path.split("?")[0]}\n')
    83	
    84	    def _send(self, status, payload):
    85	        body = json.dumps(payload, ensure_ascii=False).encode('utf-8')
    86	        self.send_response(status)
    87	        self.send_header('Content-Type', 'application/json; charset=utf-8')
    88	        self._cors()
    89	        self.send_header('Content-Length', str(len(body)))
    90	        self.end_headers()
    91	        self.wfile.write(body)
    92	
    93	    def _cors(self):
    94	        self.send_header('Access-Control-Allow-Origin', '*')
    95	        self.send_header('Access-Control-Allow-Methods', 'GET, POST, OPTIONS')
    96	        self.send_header('Access-Control-Allow-Headers', 'Content-Type')
    97	
    98	    def do_OPTIONS(self):          # a browser's preflight before a JSON POST
    99	        self.send_response(204)
   100	        self._cors()
   101	        self.end_headers()
   102	
   103	    def _answer(self, work, read_only=False):
   104	        try:
   105	            with Connections(read_only) as db:
   106	                self._send(200, work(db))
   107	        except REQUEST_ERRORS as error:
   108	            status, body = error_response(error)
   109	            self._send(status, body)
   110	
   111	    def _stream_answer(self, work):
   112	        self.send_response(200)
   113	        self.send_header('Content-Type', 'application/x-ndjson; charset=utf-8')
   114	        self.send_header('Cache-Control', 'no-store')
   115	        self._cors()
   116	        self.end_headers()
   117	
   118	        def emit(event):
   119	            self.wfile.write((json.dumps(event, ensure_ascii=False) + '\n').encode('utf-8'))
   120	            self.wfile.flush()
   121	
   122	        try:
   123	            with Connections() as db:
   124	                card = work(db, lambda stage: emit({'type': 'progress', 'stage': stage}))
   125	                emit({'type': 'result', 'data': card})
   126	        except (BrokenPipeError, ConnectionResetError):
   127	            return
   128	        except REQUEST_ERRORS as error:
   129	            status, body = error_response(error)
   130	            try:
   131	                emit({'type': 'error', 'status': status, 'message': body['error'], **{k: v for k, v in body.items() if k != 'error'}})
   132	            except (BrokenPipeError, ConnectionResetError):
   133	                pass
