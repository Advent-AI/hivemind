   126	        """The streamed Idea answer, in one read transaction: `prepare` checks the request (its date resolved, the first day refused)
   127	        before any header, so a refusal is a normal status and body; then the 200 headers and the work, in the same transaction."""
   128	        headers_sent = False
   129	
   130	        def emit(event):
   131	            self.wfile.write((json.dumps(event, ensure_ascii=False) + '\n').encode('utf-8'))
   132	            self.wfile.flush()
   133	
   134	        try:
   135	            with Connections() as db:
   136	                prepare(db)
   137	                self.send_response(200)
   138	                self.send_header('Content-Type', 'application/x-ndjson; charset=utf-8')
   139	                self.send_header('Cache-Control', 'no-store')
   140	                self._cors()
   141	                self.end_headers()
   142	                headers_sent = True
   143	                card = work(db, lambda stage: emit({'type': 'progress', 'stage': stage}))
   144	                emit({'type': 'result', 'data': card})
   145	        except (BrokenPipeError, ConnectionResetError):
   146	            return
   147	        except REQUEST_ERRORS as error:
   148	            status, body = error_response(error)
   149	            if not headers_sent:
   150	                self._send(status, body)
   151	                return
   152	            try:
   153	                emit({'type': 'error', 'status': status, 'message': body['error'], **{k: v for k, v in body.items() if k != 'error'}})
   154	            except (BrokenPipeError, ConnectionResetError):
   155	                pass
