    44	def error_response(error):
    45	    """(status, body) for a request's error. The store's date refusals carry their days (OPERATING-CONTRACT.md, row 3)."""
    46	    if isinstance(error, service.FirstDayNotCompleted):
    47	        return 503, {'error': str(error)}
    48	    if isinstance(error, service.BoundNotCompleted):
    49	        return 409, {'error': 'day not completed', 'requested': error.requested, 'last_completed_day': error.last_completed_day}
    50	    if isinstance(error, service.RangeNotOrdered):
    51	        return 409, {'error': 'range start after its end', 'start': error.start, 'end': error.end}
    52	    if isinstance(error, KeyError):
