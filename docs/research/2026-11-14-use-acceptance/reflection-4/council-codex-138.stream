   216	def open_read_only(path):
   217	    """The views database for a reader (the agent layer, reports): no schema creation, no writes. Opened by its own path: a symlink
   218	    resolved, a store with another hard link refused (`live_lock.LockRefused`; live-service/OPERATING-CONTRACT.md, row 7), since
   219	    SQLite finds a WAL store's side files by the opened path."""
   220	    from hivemind import live_lock
   221	    real, _ = live_lock.own_path(path)
   222	    conn = sqlite3.connect(f'file:{real}?mode=ro', uri=True)
   223	    conn.row_factory = sqlite3.Row
   224	    return conn
