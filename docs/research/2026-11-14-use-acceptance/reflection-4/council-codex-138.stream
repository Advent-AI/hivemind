   248	    def close(self):
   249	        """The writer's end on every path: the store taken out of WAL mode when no reader holds it (so no WAL-mode store is left
   250	        without its side files, which a read-only reader could not open), its connection closed, then its lock released (no
   251	        writable connection outlives it). Returns the store's journal mode at the end."""
   252	        mode = None
   253	        try:
   254	            if self.conn is not None:
   255	                try:
   256	                    mode = leave_wal(self.conn)
   257	                finally:
   258	                    self.conn.close()
   259	                    self.conn = None
   260	        finally:
   261	            if self.conn is None and self.lock is not None:      # a connection that failed to close keeps the lock (until the process ends)
   262	                live_lock.release(self.lock)
   263	                self.lock = None
   264	        return mode
