   226	def leave_wal(conn):
   227	    """The writer's orderly end: rollback-journal mode when no reader holds the store; otherwise WAL is kept. Returns the mode."""
   228	    try:
   229	        conn.execute('pragma busy_timeout=1000')
   230	        return conn.execute('pragma journal_mode=delete').fetchone()[0]
   231	    except sqlite3.OperationalError:
   232	        return 'wal'
