   217	def truncate_checkpoint(conn):
   218	    """A truncating checkpoint with a short wait; True when it completed (no reader held it back)."""
   219	    try:
   220	        conn.execute('pragma busy_timeout=1000')
   221	        return conn.execute('pragma wal_checkpoint(TRUNCATE)').fetchone()[0] == 0
   222	    except sqlite3.OperationalError:
   223	        return False
