   136	def query_vector(index, query, embed=openai_embeddings, embedding_model=EMBEDDING_MODEL):
   137	    digest = sha(query)
   138	    row = index.execute('select vector_json from query_vectors where text_sha256=? and model=?', (digest, embedding_model)).fetchone()
   139	    if row:
   140	        return json.loads(row['vector_json']), True
   141	    vectors, tokens = embed([query], embedding_model)
   142	    index.execute('insert or replace into query_vectors (text_sha256, model, vector_json, tokens, built_at) values (?,?,?,?,?)',
   143	                  (digest, embedding_model, json.dumps(vectors[0]), tokens, time.strftime('%Y-%m-%dT%H:%M:%S')))
   144	    index.commit()
   145	    return vectors[0], False
