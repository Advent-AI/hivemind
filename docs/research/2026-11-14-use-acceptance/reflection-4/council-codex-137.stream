   183	def locked_copy(path, scratch):
   184	    """A store copied for preflight (live-service/OPERATING-CONTRACT.md, row 7): its writer lock taken without waiting, so a store being
   185	    written is refused with the snapshot route named; the path checked on both sides of the open and after the copy; the copy made by
   186	    SQLite's backup API from a read-only source and taken out of WAL mode; the lock released."""
   187	    held = live_lock.acquire(path)
   188	    try:
   189	        source = sqlite3.connect(f'file:{held.real_path}?mode=ro', uri=True)
   190	        try:
   191	            live_lock.verify(held)
   192	            target = sqlite3.connect(scratch)
   193	            try:
   194	                source.backup(target)
   195	                live_lock.leave_wal_mode(target)
   196	            finally:
   197	                target.close()
   198	        finally:
   199	            source.close()
   200	        live_lock.verify(held)
   201	    except BaseException:
   202	        for leftover in (scratch, scratch + '-journal', scratch + '-wal', scratch + '-shm'):
   203	            if os.path.exists(leftover):
   204	                os.remove(leftover)                  # what was copied from a path that changed is discarded
   205	        raise
   206	    finally:
   207	        live_lock.release(held)
   208	
   209	
   210	def store_copies(views_paths):
   211	    """One locked copy of each store (`locked_copy`), made before any part reads it; parts C and E read these, never the stores."""
   212	    copies = []
   213	    for path in views_paths:
   214	        copy = os.path.join(tempfile.mkdtemp(), 'views.sqlite')
   215	        locked_copy(path, copy)
   216	        copies.append(copy)
   217	    return copies
   218	
