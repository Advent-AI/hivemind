    71	def test_the_store_and_a_symlink_to_it_meet_one_lock_and_a_hard_linked_store_is_refused_by_the_lock_preflight_and_the_snapshot(tmp_path):
    72	    path = wal_store(tmp_path)
    73	    os.symlink(path, tmp_path / 'alias.sqlite')
    74	    held = live_lock.acquire(path)
    75	    with pytest.raises(live_lock.LockRefused, match='being written'):
    76	        live_lock.acquire(tmp_path / 'alias.sqlite')
    77	    live_lock.release(held)
    78	    os.link(path, tmp_path / 'second-name.sqlite')
    79	    with pytest.raises(live_lock.LockRefused, match='2 hard links'):
    80	        live_lock.acquire(path)
    81	    with pytest.raises(live_lock.LockRefused, match='2 hard links'):
    82	        preflight.store_copies([path])
    83	    assert snapshot_store.main([path, str(tmp_path / 'snap.sqlite')]) == 1 and not (tmp_path / 'snap.sqlite').exists()
    84	
