    21	def load(name, path):
    22	    spec = importlib.util.spec_from_file_location(name, path)
    23	    module = importlib.util.module_from_spec(spec)
    24	    spec.loader.exec_module(module)
    25	    return module
    26	
    27	
    28	preflight = load('preflight', os.path.join(ROOT, 'scripts', 'preflight.py'))
    29	snapshot_store = load('snapshot_store', SNAPSHOT)
