   134	@pytest.mark.parametrize('unusable', ['cannot be created', 'cannot be written'])
   135	def test_an_unusable_lock_folder_refuses_the_lock_and_preflight(tmp_path, monkeypatch, unusable):
   136	    path = wal_store(tmp_path)
   137	    parent = tmp_path / 'locked-parent'
   138	    parent.mkdir()
   139	    folder = parent / 'locks'
   140	    if unusable == 'cannot be written':
   141	        folder.mkdir()
   142	        folder.chmod(0o500)
   143	    else:
   144	        parent.chmod(0o500)
   145	    monkeypatch.setattr(live_lock, 'LOCK_FOLDER', str(folder))
   146	    try:
   147	        with pytest.raises(live_lock.LockRefused, match=unusable):
   148	            live_lock.acquire(path)
   149	        with pytest.raises(live_lock.LockRefused, match=unusable):
   150	            preflight.store_copies([path])
   151	    finally:
   152	        parent.chmod(0o700)
   153	        if folder.exists():
   154	            folder.chmod(0o700)
