    55	def last_day(path):
    56	    with sqlite3.connect(f'file:{path}?mode=ro', uri=True) as conn:
    57	        return conn.execute('select max(day) from days_completed').fetchone()[0]
    58	
    59	
    60	def lock_is_free(lock_path):
    61	    descriptor = os.open(lock_path, os.O_RDWR)
    62	    try:
    63	        fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
    64	        return True
    65	    except BlockingIOError:
    66	        return False
    67	    finally:
    68	        os.close(descriptor)
