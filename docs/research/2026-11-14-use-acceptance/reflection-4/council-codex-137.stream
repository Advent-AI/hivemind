   103	def test_a_store_path_replaced_after_its_stat_is_refused_and_the_lock_released(tmp_path, monkeypatch):
   104	    path, other = wal_store(tmp_path), wal_store(tmp_path, 'other.sqlite')
   105	    real_folder = live_lock.lock_folder
   106	    seen = {}
   107	
   108	    def replace_then_folder():
   109	        seen['identity'] = live_lock.own_path(path)[1]
   110	        os.replace(other, path)                                               # after acquire's stat, before its lock
   111	        return real_folder()
   112	    monkeypatch.setattr(live_lock, 'lock_folder', replace_then_folder)
   113	    with pytest.raises(live_lock.PathChanged, match='no longer names the locked store'):
   114	        live_lock.acquire(path)
   115	    device, inode = seen['identity']
   116	    assert lock_is_free(os.path.join(real_folder(), f'{device}-{inode}.writer.lock'))
   117	
