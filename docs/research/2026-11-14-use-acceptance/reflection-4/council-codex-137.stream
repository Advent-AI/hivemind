   119	def test_a_store_path_replaced_during_preflights_copy_discards_the_copy_and_releases_the_lock(tmp_path, monkeypatch):
   120	    path, other = wal_store(tmp_path), wal_store(tmp_path, 'other.sqlite')
   121	    real = live_lock.leave_wal_mode
   122	
   123	    def replace_during_the_copy(connection):
   124	        os.replace(other, path)
   125	        return real(connection)
   126	    monkeypatch.setattr(live_lock, 'leave_wal_mode', replace_during_the_copy)
   127	    scratch = tmp_path / 'scratch.sqlite'
   128	    with pytest.raises(live_lock.PathChanged):
   129	        preflight.locked_copy(path, str(scratch))
   130	    assert not scratch.exists()
   131	    live_lock.release(live_lock.acquire(path))                               # the new file's lock is free too
