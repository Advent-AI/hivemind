    42	def wal_store(folder, name='views.sqlite'):
    43	    """The sealed run's store, copied by the backup API and put in WAL mode, with a connection left open on it as a running writer
    44	    keeps one (its side files exist, as they do while a writer runs or after it crashed)."""
    45	    path = os.path.join(folder, name)
    46	    source, target = service.open_ledger(FINISHED), sqlite3.connect(path)
    47	    source.backup(target)
    48	    assert target.execute('pragma journal_mode=wal').fetchone()[0] == 'wal'
    49	    target.execute('select count(*) from views').fetchone()                  # the side files exist once the connection reads
    50	    source.close()
    51	    WRITERS.append(target)
    52	    return path
    53	
