    94	def test_preflight_copies_a_wal_store_under_the_lock_into_a_copy_a_read_only_reader_opens_and_releases_the_lock(tmp_path):
    95	    path = wal_store(tmp_path)
    96	    [copy] = preflight.store_copies([path])
