   157	def test_the_snapshot_entry_point_writes_a_new_read_only_readable_copy_out_of_wal_mode(tmp_path):
   158	    path = wal_store(tmp_path)
   159	    finished = subprocess.run([sys.executable, SNAPSHOT, path, str(tmp_path / 'snap.sqlite')], capture_output=True, text=True)
   160	    assert finished.returncode == 0, finished.stderr
   161	    with sqlite3.connect(f'file:{tmp_path / "snap.sqlite"}?mode=ro', uri=True) as conn:
   162	        assert conn.execute('pragma journal_mode').fetchone()[0] == 'delete'
   163	        assert conn.execute('pragma integrity_check').fetchone()[0] == 'ok'
   164	    assert last_day(tmp_path / 'snap.sqlite') == '2026-08-15'
