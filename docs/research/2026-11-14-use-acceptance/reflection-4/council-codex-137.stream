   471	            articles = days.get(day, [])
   472	            runner.overdue_invariant(day)
   473	            changed = set()
   474	            for k in articles:
   475	                seq = sequences[k] = max(k, store.next_sequence(runner.conn))
   476	                input_id = by_article[k][0]['input_id'] if k in by_article else f'article:{k}'
   477	                opened_here = sorted(opened.get(k, {}), key=lambda name: int(name.split('-', 1)[1]))
   478	                for thesis_id in opened_here:
   479	                    runner.open_thesis(thesis_id, ladders[thesis_id], k, seq, day, input_id, source)
   480	                runner.article(seq, by_article.get(k, []), library, revisions_by_record, later_by_article.get(k, []), changed)
   481	                runner.record_article(seq, inputs_of[k], day)       # after its records are written, as production marks a handover
   482	                for thesis_id in opened_here:
   483	                    for view_id in runner.mapping.get(thesis_id, []):
   484	                        if runner.conn.execute('select count(*) from evidence_links where view_id=?', (view_id,)).fetchone()[0] == 0:
   485	                            runner.counts['views with no opening evidence'] += 1
   486	            runner.conn.commit()
   487	            if changed:
   488	                runner.judge(day, sequences[max(articles)], changed)
   489	            runner.close_and_complete(day)
   490	            failed_checkpoints = 0 if truncate_checkpoint(runner.conn) else failed_checkpoints + 1
   491	        mode = leave_wal(runner.conn)
   492	        runner.counts['store journal mode at the end'] = mode
   493	        if mode != 'delete':
   494	            runner.counts['stopped in order'] = 'WAL kept: a reader held the store at the end'
   495	        (output / 'sequences.json').write_text(json.dumps({str(k): seq for k, seq in sequences.items()}, indent=1) + '\n')
   496	        runner.counts['judging usd this draw (charged: from tokens, or the reserve when no usage came back)'] = round(runner.budget.spent_usd - spent_before, 4)
   497	        runner.counts['judging usd of the whole limit so far (from its ledger)'] = round(ledger_total(runner.budget.ledger_path), 4)
   498	        (output / 'adapter-counts.json').write_text(json.dumps(runner.counts, indent=1))
   499	        (output / 'judge-requests.json').write_text(json.dumps(runner.sent, indent=1))
   500	    finally:
   501	        runner.close()                                   # every exit: the connection closed, then the lock released
   502	    return runner
   503	
