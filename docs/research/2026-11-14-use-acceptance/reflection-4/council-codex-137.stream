    86	def test_preflight_refuses_a_store_being_written_and_names_the_snapshot_route(tmp_path):
    87	    path = wal_store(tmp_path)
    88	    writer = live_lock.acquire(path)
    89	    with pytest.raises(live_lock.LockRefused, match='snapshot_store.py'):
    90	        preflight.store_copies([path])
    91	    live_lock.release(writer)
