   217	def held_by_another(error):
   218	    """SQLite's own messages for SQLITE_BUSY and SQLITE_LOCKED: another connection held the store; any other error is not that."""
   219	    return str(error).startswith(('database is locked', 'database table is locked', 'database schema is locked'))
   220	
   221	
   222	def truncate_checkpoint(conn):
   223	    """A truncating checkpoint with a short wait: 'done', 'busy' when a reader held it back, or else the error's own text."""
   224	    try:
   225	        conn.execute('pragma busy_timeout=1000')
   226	        busy = conn.execute('pragma wal_checkpoint(TRUNCATE)').fetchone()[0]
   227	    except sqlite3.OperationalError as error:
   228	        return 'busy' if held_by_another(error) else str(error)
   229	    return 'busy' if busy else 'done'
   230	
   231	
   232	def leave_wal(conn):
   233	    """The change to rollback-journal mode at the writer's end: (the mode it ends in, why WAL was kept or None). A reader holding
   234	    the store and any other failure are reported apart."""
   235	    try:
   236	        conn.execute('pragma busy_timeout=1000')
   237	        mode = conn.execute('pragma journal_mode=delete').fetchone()[0]
   238	    except sqlite3.OperationalError as error:
   239	        return 'wal', ('a reader held the store at the end' if held_by_another(error) else f'leaving WAL failed: {error}')
   240	    return mode, (None if mode == 'delete' else f'the mode stayed {mode}')
