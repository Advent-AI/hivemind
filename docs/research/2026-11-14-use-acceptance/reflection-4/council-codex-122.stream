   186	            raise KeyError(f'{view_id} is not available as of {as_of}')
   187	        records.append(view_bundle(views_db, lookup, view_id, as_of))
   188	    return {'as_of': as_of, 'days': days(views_db, as_of), 'views': records,
   189	            'coverage': coverage, 'groups': research_groups(views_db, view_ids, as_of)}
   190	
   210	
   211	def thesis_bundles(views_db, items_db, view_ids, as_of=None):
   212	    """Selected complete thesis records, pinned to one read transaction."""
   213	    with read_snapshot(views_db, items_db):
   214	        return _bundles(views_db, items_db, view_ids, as_of)
   215	
   216	
   217	def library(views_db, items_db, as_of=None):
   218	    """All theses, including closed ones, and stored groups; no search or model call."""
   219	    with read_snapshot(views_db, items_db):
   220	        as_of = as_of or service.default_as_of(views_db)
   221	        if not as_of:
   222	            raise ValueError('The library has no completed day; supply as_of')
   223	        date.fromisoformat(as_of)
   224	        view_ids = [r['view_id'] for r in views_db.execute('select * from views order by created_seq, rowid')
   225	                    if service.view_exists(views_db, r, as_of)]
   226	        if not view_ids:
   227	            return {'as_of': as_of, 'days': days(views_db, as_of), 'views': [], 'coverage': 'library', 'groups': []}
   228	        return _bundles(views_db, items_db, view_ids, as_of, coverage='library')
