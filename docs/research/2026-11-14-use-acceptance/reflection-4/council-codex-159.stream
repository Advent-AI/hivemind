def test_the_library_shows_the_two_years_as_two_ordinary_questions(writer):
    runner, path = writer
    from hivemind import dispatch
    dispatch.mark(runner.conn, {'input_id': 'gnews:capex', 'publication_day': split_case.DAY}, 1, 'handed_over')   # as the loop records its article
    write(runner, split_outcome(BOTH))
    store.complete_day(runner.conn, split_case.DAY, 1, split_case.DAY)
    runner.conn.commit()
    with service.open_ledger(str(path)) as conn:
        library = bundle.library(conn, None, None)
    assert sorted((v['view_id'], v['year']) for v in library['views']) == [('v42026', '2026'), ('v42027', '2027')]


def test_an_unsplit_thesis_keeps_its_single_row_with_an_empty_period(tmp_path):
    runner = ladder_adapter.replay('u1', tmp_path / 'out', transport=fake_judge, cap_usd=5.0)
    with sqlite3.connect(f'file:{tmp_path / "out" / "views.sqlite"}?mode=ro', uri=True) as conn:
        assert {r[0] for r in conn.execute('select period from clean_ladders')} == {''}
        assert not stored_judgements.split_rows_present(conn)
    assert runner.counts['views written from a ladder'] > 0


def test_the_frozen_stage_b_readers_refuse_a_split_store_and_accept_a_historical_one(writer):
    runner, path = writer
    write(runner, split_outcome(BOTH))
    with sqlite3.connect(f'file:{path}?mode=ro', uri=True) as conn:
        with pytest.raises(SystemExit, match='control_theses: this store holds period-split rows'):
            stored_judgements.refuse_split_store(conn, 'control_theses')
    historical = next(stored_judgements.stage_b_folders().values().__iter__()) / 'views.sqlite'
    with sqlite3.connect(f'file:{historical}?mode=ro', uri=True) as conn:
        assert 'period' not in {r[1] for r in conn.execute('pragma table_info(clean_ladders)')}
        stored_judgements.refuse_split_store(conn, 'control_theses')                             # no refusal


@pytest.mark.parametrize('reader', [HERE / 'control_theses.py', HERE / 'stage_b_count.py',
                                    ROOT / 'docs/research/2026-11-14-use-acceptance/stage-b-controls/control_census.py',
                                    ROOT / 'docs/research/2026-11-14-use-acceptance/not-judged-display/page_store.py'])
def test_each_frozen_reader_refuses_before_its_first_read_of_the_ladder_table(reader):
    """Structural: in each reader, the refusal is called on the connection before any statement that reads `clean_ladders`."""
    lines = reader.read_text().splitlines()
    refusal = next(i for i, line in enumerate(lines) if 'refuse_split_store(' in line)
    first_read = next(i for i, line in enumerate(lines) if 'clean_ladders' in line and ('select' in line or 'execute' in line))
    assert refusal < first_read
    ast.parse(reader.read_text())

