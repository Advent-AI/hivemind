    87	    todo, unchanged = [], 0
    88	    for record in rows:
    89	        text = view_text(record, store.rungs_of(ledger, record['view_id']))
    90	        digest = sha(text)
    91	        have = index.execute('select text_sha256, model, vector_json from view_vectors where view_id=?', (record['view_id'],)).fetchone()
    92	        if have and have['text_sha256'] == digest and have['model'] == embedding_model and usable(json.loads(have['vector_json'])):
    93	            unchanged += 1
    94	        else:
    95	            todo.append((record['view_id'], digest, text))
    96	    embedded = tokens = 0
    97	    for start in range(0, len(todo), batch):
    98	        chunk = todo[start:start + batch]
    99	        try:
   100	            vectors, used = embed([t for _, _, t in chunk], embedding_model)
   101	        except (model.TransportError, OSError) as error:
   102	            return embedded, unchanged, tokens, str(error)[:120]
   103	        if len(vectors) != len(chunk) or not all(usable(v) for v in vectors):
   104	            return embedded, unchanged, tokens, 'the embedding answer did not hold one usable vector per text'
   105	        tokens += used
   106	        now = time.strftime('%Y-%m-%dT%H:%M:%S')
