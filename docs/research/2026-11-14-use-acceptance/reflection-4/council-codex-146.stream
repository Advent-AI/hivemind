   121	def _lines_english(conn, view_id, v, rungs, pieces, deps, last, themes=(), hidden=0):
   122	    """hidden: how many pieces in force are not shown."""
   123	    lines = [f'Thesis {view_id} ({v["object_id"]}, {v["kind"]}, focus "{v["looks_at"]}", {v["year"] or ""}, due {v["due_day"]}): {v["question"]}',
   124	             'Ladder: ' + ' / '.join(f'rung {r["position"]} {r["label"]}: {r["condition"]}' for r in rungs), '',
   125	             f'[Evidence in view under this thesis, {len(pieces)} items]']
   126	    if hidden:
   127	        lines.append(f'[Not shown: {hidden} more pieces in force, read in earlier judgements; the previous conclusion carries them]')
   128	    for p in pieces:
   107	    if as_of is not None and not service.view_exists(views_db, v, as_of):
   108	        raise KeyError(f'{view_id} is not available as of {as_of}')
   109	    columns = {r[1] for r in views_db.execute('pragma table_info(rungs)')}
   110	    bounds = ', lo, hi' if {'lo', 'hi'} <= columns else ''          # a ledger written before keys has no bounds; the adapter then reads the prose
   111	    rungs = [dict(r) for r in views_db.execute(f'select position, label, condition{bounds} from rungs where view_id=? order by position', (view_id,))]
   112	    switches = [dict(r) for r in views_db.execute('select open, reason, after_seq from view_switches where view_id=? order by id', (view_id,))
   113	                if _visible(views_db, r['after_seq'], as_of)]
   165	                   for r in views_db.execute('select * from successions where view_id=? or succeeds=? order by id', (view_id, view_id))
   166	                   if _visible(views_db, r['seq'], as_of)]
   167	    return {'view_id': view_id, 'object': v['object_id'], 'kind': v['kind'], 'looks_at': v['looks_at'], 'question': v['question'],
   168	            'due_day': v['due_day'], 'year': v['year'], 'identity': identity, 'successions': successions,
   169	            'created_seq': v['created_seq'], 'created_day': service.day_of_seq(views_db, v['created_seq']),
   170	            'created_from': {'title': created['title'], 'publisher': created['publisher'], 'category': created['category']},
   171	            'rungs': rungs, 'open': not any(not s['open'] for s in switches), 'switches': switches,
   172	            'judgements': judgements, 'evidence': evidence, 'dependencies': dependencies, 'dependants': dependants,
