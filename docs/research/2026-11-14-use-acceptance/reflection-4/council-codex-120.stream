   199	def history(conn, view_id, from_day=None, to_day=None):
   200	    to_day = to_day or default_as_of(conn)
   201	    from_day = from_day or '0000-00-00'
   202	    judgements = []
   203	    previous = None
   204	    for row in conn.execute('select * from judgements where view_id=? order by judgement_id', (view_id,)):
   205	        entry = {'day': row['publication_day'], 'seq': row['seq'], 'position': row['rung'], 'changed': bool(row['changed']), 'moved_from': previous if previous is not None and previous != row['rung'] else None,
   206	                 'why_changed': row['why_changed'], 'reasons': row['reasons'], 'cited': _unique(_json(row['cited_evidence_json'])), 'pushes': _json(row['pushes_json']),
   207	                 'theme_pushes': _json(row['theme_pushes_json'] if 'theme_pushes_json' in row.keys() else None), 'round': row['input_id']}
   208	        previous = row['rung']
   209	        if from_day <= row['publication_day'] <= to_day:
   210	            judgements.append(entry)
   211	    arrivals = {}
   212	    for link in conn.execute('select evidence_id, seq from evidence_links where view_id=?', (view_id,)):
   213	        day = day_of_seq(conn, link['seq'])
   214	        if day and from_day <= day <= to_day:
   215	            piece = store.evidence(conn, link['evidence_id'])
   216	            bucket = arrivals.setdefault(day, {'evidence': 0, 'facts': 0})
   217	            bucket['evidence'] += 1
   218	            bucket['facts'] += int(vocabulary.canonical('tier', piece['tier']) == TIER_FACT)
   219	    replacements = [{'day': day_of_seq(conn, r['seq']), 'old': r['old_evidence_id'], 'new': r['new_evidence_id'], 'said_day': r['said_day']}
   220	                    for r in conn.execute('select r.* from replacements r join evidence_links l on l.evidence_id=r.new_evidence_id where l.view_id=?', (view_id,))
   221	                    if day_of_seq(conn, r['seq']) and from_day <= day_of_seq(conn, r['seq']) <= to_day]
   222	    switches = [{'day': day_of_seq(conn, s['after_seq']), 'open': bool(s['open']), 'reason': s['reason']}
   223	                for s in conn.execute('select * from view_switches where view_id=? order by id', (view_id,)) if day_of_seq(conn, s['after_seq']) and from_day <= day_of_seq(conn, s['after_seq']) <= to_day]
   224	    return {'view_id': view_id, 'from_day': from_day, 'to_day': to_day, 'judgements': judgements,
   225	            'changes': [j for j in judgements if j['moved_from'] is not None], 'arrivals': dict(sorted(arrivals.items())),
   226	            'replacements': replacements, 'switches': switches}
