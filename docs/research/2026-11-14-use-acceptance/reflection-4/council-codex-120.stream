   255	def record(conn, view_id, as_of=None):
   256	    """The last check of the view on or before the day: when, by which round, how much came in that day."""
   257	    as_of = as_of or default_as_of(conn)
   258	    row = conn.execute('select input_id, publication_day, seq from judgements where view_id=? and publication_day<=? order by judgement_id desc limit 1', (view_id, as_of)).fetchone()
   259	    if not row:
   260	        return {'view_id': view_id, 'as_of': as_of, 'last_check': None}
   261	    day = row['publication_day']
   262	    items = [r['input_id'] for r in conn.execute("select distinct input_id from processing_steps where publication_day=? and step='handed_over' and result='ok' and input_id not like 'day:%'", (day,))]
   263	    arrived = sum(1 for link in conn.execute('select seq from evidence_links where view_id=?', (view_id,)) if day_of_seq(conn, link['seq']) == day)
   264	    return {'view_id': view_id, 'as_of': as_of, 'last_check': {'day': day, 'round': row['input_id'], 'items_processed_that_day': len(items), 'evidence_arrived_that_day': arrived}}
   265	
