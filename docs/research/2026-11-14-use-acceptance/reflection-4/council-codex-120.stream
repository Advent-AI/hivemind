   267	# ---------- changes since a day
   268	
   269	def changes(conn, since_day, to_day=None):
   270	    """Judgements that said 'changed' after since_day (exclusive) up to to_day, with their cited evidence."""
   271	    to_day = to_day or default_as_of(conn)
   272	    out = []
   273	    previous = {}
   274	    for row in conn.execute('select * from judgements order by judgement_id'):
   275	        before = previous.get(row['view_id'])
   276	        previous[row['view_id']] = row['rung']
   277	        if not row['changed'] or not (since_day < row['publication_day'] <= to_day):
   278	            continue
   279	        cited = [piece for piece in (evidence_record(conn, e, row['publication_day']) for e in _unique(_json(row['cited_evidence_json']))) if piece]
   280	        out.append({'view_id': row['view_id'], 'day': row['publication_day'], 'from_position': before, 'to_position': row['rung'],
   281	                    'position_moved': before is not None and before != row['rung'], 'why_changed': row['why_changed'], 'cited': cited})
   282	    return out
