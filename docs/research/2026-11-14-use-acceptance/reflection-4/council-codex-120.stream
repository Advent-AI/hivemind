   175	def _bundles(views_db, items_db, view_ids, as_of=None, coverage='selection'):
   176	    """Complete, dated UI inputs for caller-selected theses; no search, model call or ledger write."""
   177	    as_of = as_of or service.default_as_of(views_db)
   178	    date.fromisoformat(as_of)
   179	    if not isinstance(view_ids, list) or not view_ids or any(not isinstance(id, str) or not id for id in view_ids):
   180	        raise ValueError('thesis_bundles needs a non-empty list of view ids')
   181	    lookup = item_lookup(items_db)
   182	    records = []
   183	    for view_id in dict.fromkeys(view_ids):
   184	        row = views_db.execute('select * from views where view_id=?', (view_id,)).fetchone()
   185	        if row is None or not service.view_exists(views_db, row, as_of):
   186	            raise KeyError(f'{view_id} is not available as of {as_of}')
   187	        records.append(view_bundle(views_db, lookup, view_id, as_of))
   188	    return {'as_of': as_of, 'days': days(views_db, as_of), 'views': records,
   189	            'coverage': coverage, 'groups': research_groups(views_db, view_ids, as_of)}
   190	
