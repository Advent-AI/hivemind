   192	def research_groups(conn, view_ids, as_of):
   193	    """Stored groups, with dated memberships limited to the envelope's loaded theses."""
   194	    if not conn.execute('pragma table_info(thesis_groups)').fetchone():
   195	        return []
   196	    loaded = set(view_ids)
   197	    result = []
   198	    for row in conn.execute('select * from thesis_groups order by created_seq, rowid'):
   199	        if not service.visible(conn, row['created_seq'], as_of):
   200	            continue
   201	        members = [{'thesis_id': m['view_id'], 'day': service.day_of_seq(conn, m['seq']), 'basis': m['basis'] or ''}
   202	                   for m in conn.execute('select * from thesis_group_members where group_id=? order by id', (row['group_id'],))
   203	                   if m['view_id'] in loaded and service.visible(conn, m['seq'], as_of)]
   204	        if members:
   205	            result.append({'id': row['group_id'], 'name': row['name'], 'scope': row['scope'],
   206	                           'aliases': json.loads(row['aliases'] or '[]') if 'aliases' in row.keys() else [],
   207	                           'created_day': service.day_of_seq(conn, row['created_seq']), 'members': members})
   208	    return result
   209	
