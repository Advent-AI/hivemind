   122	def fresh_vectors(ledger, index, embedding_model=EMBEDDING_MODEL):
   123	    """view id → vector for every view whose stored vector was made from the view's current text and is usable; a
   124	    view whose text changed since, was never embedded, or holds an empty vector is absent."""
   125	    stored = {r['view_id']: (r['text_sha256'], json.loads(r['vector_json'])) for r in index.execute('select view_id, text_sha256, vector_json from view_vectors where model=?', (embedding_model,))}
   126	    out = {}
   127	    dims = None
   128	    for record in ledger.execute('select * from views'):
   129	        have = stored.get(record['view_id'])
   130	        if have and have[0] == sha(view_text(record, store.rungs_of(ledger, record['view_id']))) and usable(have[1]) and (dims is None or len(have[1]) == dims):
   131	            out[record['view_id']] = have[1]
   132	            dims = len(have[1])
   133	    return out
