    82	def build_index(ledger, index, embed=openai_embeddings, embedding_model=EMBEDDING_MODEL, batch=64):
    83	    """Embed every view whose text is new or changed, batch by batch, each batch committed as it lands. Returns
    84	    (embedded, unchanged, tokens, error): on a failure the counts are what was done before it, never zero, and the
    85	    error is the message without the provider's body. Never raises."""
    86	    rows = [dict(r) for r in ledger.execute('select * from views order by created_seq')]
    87	    todo, unchanged = [], 0
    88	    for record in rows:
    89	        text = view_text(record, store.rungs_of(ledger, record['view_id']))
    90	        digest = sha(text)
    91	        have = index.execute('select text_sha256, model, vector_json from view_vectors where view_id=?', (record['view_id'],)).fetchone()
    92	        if have and have['text_sha256'] == digest and have['model'] == embedding_model and usable(json.loads(have['vector_json'])):
    93	            unchanged += 1
    94	        else:
    95	            todo.append((record['view_id'], digest, text))
    96	    embedded = tokens = 0
    97	    for start in range(0, len(todo), batch):
    98	        chunk = todo[start:start + batch]
    99	        try:
   100	            vectors, used = embed([t for _, _, t in chunk], embedding_model)
   101	        except (model.TransportError, OSError) as error:
   102	            return embedded, unchanged, tokens, str(error)[:120]
   103	        if len(vectors) != len(chunk) or not all(usable(v) for v in vectors):
   104	            return embedded, unchanged, tokens, 'the embedding answer did not hold one usable vector per text'
   105	        tokens += used
   106	        now = time.strftime('%Y-%m-%dT%H:%M:%S')
   107	        index.executemany('insert or replace into view_vectors (view_id, text_sha256, model, vector_json, tokens, built_at) values (?,?,?,?,?,?)',
   108	                          [(view_id, digest, embedding_model, json.dumps(vector), used // max(1, len(chunk)), now) for (view_id, digest, _), vector in zip(chunk, vectors)])
   109	        index.commit()
   110	        embedded += len(chunk)
   111	    return embedded, unchanged, tokens, None
