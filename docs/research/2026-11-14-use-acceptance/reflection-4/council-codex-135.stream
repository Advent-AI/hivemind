   156	def test_a_question_due_inside_the_window_closes_at_the_end_of_its_due_day_and_is_never_judged_after(tmp_path, monkeypatch):
   157	    """D566, CLOSING-DESIGN.md §2: production's closing step runs at each day's end; a question due on a day with articles is
   158	    frozen at its last answer on that day, is not judged later, and later links to it are written, not judged, and counted."""
   159	    from hivemind import service
   160	    view_id = with_due_day(tmp_path, monkeypatch, '2026-07-03')
   161	    runner = ladder_adapter.replay('u1', tmp_path / 'out', transport=fake_judge, cap_usd=5.0)
   162	    page = page_of(tmp_path / 'out')
   163	    closing = page.execute("select reason, after_seq from view_switches where view_id=? and open=0", (view_id,)).fetchall()
   164	    assert len(closing) == 1 and closing[0]['reason'].startswith('due 2026-07-03, frozen on 2026-07-03 at rung 1')
   165	    assert service.seq_day_map(page)[closing[0]['after_seq']] == '2026-07-03'
   166	    assert service.is_open_as_of(page, view_id, '2026-07-02') and not service.is_open_as_of(page, view_id, '2026-07-03')
   167	    assert page.execute("select count(*) from judgements where view_id=? and publication_day > '2026-07-03'", (view_id,)).fetchone()[0] == 0
   168	    later = page.execute('select count(*) from evidence_links where view_id=? and seq > ?', (view_id, closing[0]['after_seq'])).fetchone()[0]
   169	    assert later > 0 and runner.counts['links to a closed question written (not judged)'] == later
