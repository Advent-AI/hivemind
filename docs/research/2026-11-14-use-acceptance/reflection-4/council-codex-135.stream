   193	def test_a_revision_of_a_statement_linked_to_a_closed_question_is_linked_to_it_not_judged_and_counted(tmp_path, monkeypatch):
   194	    """D566, CLOSING-DESIGN.md §2: as production's writer does, a later account of a statement linked to a closed question is linked
   195	    to it too; the closed question is not judged again; each new link is counted once."""
   196	    view_id = with_due_day(tmp_path, monkeypatch, '2026-07-05', thesis='clean-3')   # e92, linked on 07-05, is revised on 07-06
   197	    runner = ladder_adapter.replay('u1', tmp_path / 'out', transport=fake_judge, cap_usd=5.0)
   198	    page = page_of(tmp_path / 'out')
   199	    after = page.execute("select after_seq from view_switches where view_id=? and open=0", (view_id,)).fetchone()[0]
   200	    revised = page.execute('select count(*) from evidence_links l join revisions r on r.new_evidence_id = l.evidence_id '
   201	                           'join evidence_links o on o.evidence_id = r.old_evidence_id and o.view_id = l.view_id '
   202	                           'where l.view_id = ? and l.seq > ?', (view_id, after)).fetchone()[0]
   203	    later = page.execute('select count(*) from evidence_links where view_id=? and seq > ?', (view_id, after)).fetchone()[0]
   204	    assert revised > 0 and runner.counts['links to a closed question written (not judged)'] == later
   205	    assert page.execute("select count(*) from judgements where view_id=? and publication_day > '2026-07-05'", (view_id,)).fetchone()[0] == 0
