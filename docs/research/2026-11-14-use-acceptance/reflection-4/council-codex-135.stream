   408	def test_a_later_launch_after_the_cap_stop_sends_nothing(tmp_path, monkeypatch):
   409	    """STAGE_B_RUN.md: the cap ends the whole send; a later launch that finds the stop recorded sends nothing."""
   410	    monkeypatch.setattr(run_stage_b, 'CAP_USD', 0.0001)
   411	    run_stage_b.send(tmp_path, transport=fake_judge, sleep=lambda seconds: None)
   412	    monkeypatch.setattr(run_stage_b, 'CAP_USD', 2.0)
   413	    sent = []
   414	    with pytest.raises(run_stage_b.Stopped):
   415	        run_stage_b.send(tmp_path, transport=lambda provider, request: sent.append(1) or fake_judge(provider, request), sleep=lambda seconds: None)
