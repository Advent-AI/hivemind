   398	def test_each_draw_reports_its_own_spend_and_the_limit_so_far(tmp_path):
   399	    """Readability: under one shared limit, a draw's spend is its own; the cumulative figure is labelled as such."""
   400	    limit = ladder_adapter.LedgerBudget(5.0, tmp_path / 'spend.jsonl', attempt=fake_judge)
   401	    first = ladder_adapter.replay('u1', tmp_path / 'a', transport=fake_judge, limit=limit)
   402	    second = ladder_adapter.replay('u2', tmp_path / 'b', transport=fake_judge, limit=limit)
   403	    total = second.counts['judging usd of the whole limit so far (from its ledger)']
   404	    assert total == pytest.approx(first.counts[DRAW_SPEND] + second.counts[DRAW_SPEND], abs=2e-4)
   405	    assert second.counts[DRAW_SPEND] < total
