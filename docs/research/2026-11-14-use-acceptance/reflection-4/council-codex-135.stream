   109	def test_a_writer_killed_after_committed_partial_day_writes_leaves_every_answer_equal_to_its_last_completed_day(tmp_path, monkeypatch):
   110	    out = tmp_path / 'out'
   111	    taken = {}
   112	    real = ladder_adapter.LadderAdapter.close_and_complete
   113	
   114	    def complete_two_days_then_die_in_the_third(self, day):
   115	        done = len(taken.get('days', []))
   116	        if done == 2:
   117	            raise KeyboardInterrupt('killed mid-day, after the day\'s articles were committed')
   118	        closed = real(self, day)
   119	        taken.setdefault('days', []).append(day)
   120	        if len(taken['days']) == 2:
   121	            target = sqlite3.connect(str(tmp_path / 'backup.sqlite'))
   122	            self.conn.backup(target)
   123	            target.execute('pragma journal_mode=delete')
   124	            target.close()
   125	        return closed
   126	    monkeypatch.setattr(ladder_adapter.LadderAdapter, 'close_and_complete', complete_two_days_then_die_in_the_third)
   127	    with pytest.raises(KeyboardInterrupt):
   128	        ladder_adapter.replay('u1', out, transport=fake_judge, cap_usd=5.0)
   129	    live, kept = service.open_ledger(str(out / 'views.sqlite')), service.open_ledger(str(tmp_path / 'backup.sqlite'))
   130	    partial = live.execute('select count(*) from processing_steps where publication_day > ?', (taken['days'][-1],)).fetchone()[0]
   131	    assert partial > 0                                                        # the third day's articles are in the file
