   385	def test_an_attempt_whose_reserve_cannot_be_written_is_not_sent(tmp_path, monkeypatch):
   386	    """D429: the reserve line is written before the call; if it cannot be written, nothing is sent."""
   387	    sent = []
   388	    limit = ladder_adapter.LedgerBudget(2.0, tmp_path / 'spend.jsonl', attempt=lambda provider, request: sent.append(1) or fake_judge(provider, request))
   389	    def broken(line):
   390	        raise OSError('disk full')
   391	    monkeypatch.setattr(limit, '_write', broken)
   392	    request = {'model': next(iter(budget.model.PRICES)), 'messages': [{'role': 'user', 'content': 'x'}], 'max_completion_tokens': 10}
   393	    with pytest.raises(OSError):
   394	        limit.send('openai', request)
   395	    assert sent == []
