    70	    index.execute('insert or replace into view_vectors (view_id, text_sha256, model, vector_json, tokens, built_at) values (?,?,?,?,?,?)',
    71	                  (view_id, search.sha(text_of(ledger, view_id)), model, json.dumps(vector), 1, '2026-10-01T00:00:00'))
    72	    index.commit()
