    26	def add_view(writer, day, seq, view_id, question, *, complete=True):
    27	    dispatch.mark(writer, {'input_id': f'gnews:{view_id}', 'publication_day': day}, seq, 'handed_over')
    28	    store.create_view(writer, view_id=view_id, object_id='NVDA', object_kind='asset', kind='asset', looks_at=question, question=question,
    29	                      due_day='2027-01-31', year='2027', rungs=RUNGS, seq=seq, input_id=f'gnews:{view_id}', created_at=f'{day}T00:00:00Z')
    30	    if complete:
    31	        store.complete_day(writer, day, seq, day)
    32	    writer.commit()
