    48	def backup(writer, path):
    49	    """A copy by SQLite's backup API, taken out of WAL mode: a backup of a WAL store keeps WAL mode, and a read-only reader of it then
    50	    fails ("unable to open database file") because it cannot create the shared-memory file (a finding of this slice, for row 7)."""
    51	    target = sqlite3.connect(str(path))
    52	    writer.backup(target)
    53	    target.execute('pragma journal_mode=delete')
    54	    target.close()
    55	    return service.open_ledger(str(path))
    56	
    57	
    58	def unfinished_views(writer, count):
    59	    """`count` views of 2026-10-02 written and committed, the day not completed: what an unfinished day leaves."""
    60	    for n in range(count):
    61	        add_view(writer, '2026-10-02', 100 + n, f'u{n}', f'Will accelerator shipments of model {n} accelerate accelerator shipments?', complete=False)
