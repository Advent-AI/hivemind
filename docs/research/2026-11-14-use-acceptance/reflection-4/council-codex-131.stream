    35	def a_store(path, *, first_day=False):
    36	    writer = store.open_db(str(path))
    37	    writer.execute('pragma journal_mode=wal')
    38	    if first_day:
    39	        dispatch.mark(writer, {'input_id': 'gnews:first', 'publication_day': '2026-10-01'}, 1, 'handed_over')
    40	        writer.commit()
    41	        return writer
    42	    for n, question in enumerate(('Will accelerator shipments reach 5 million units?', 'Will data center revenue grow 50%?',
    43	                                  'Will memory prices rise in 2027?'), start=1):
    44	        add_view(writer, '2026-10-01', n, f'v{n}', question)
    45	    return writer
    46	
