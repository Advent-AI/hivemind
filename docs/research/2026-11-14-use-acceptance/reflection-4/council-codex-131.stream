    82	        save()
    83	        return record
    84	
    85	    for run in runs:
    86	        entry = record.setdefault(run, {'attempts': []})
    87	        if entry.get('state') == 'complete':
    88	            continue
    89	        for folder_name in (f'draw-{run}', f'draw-{run}-redo'):
    90	            if (root / folder_name).exists():
    91	                if not any(attempt['folder'] == folder_name for attempt in entry['attempts']):
    92	                    # a folder with no recorded outcome: the process that wrote it ended mid-replay (a crash); it is never resumed
    93	                    entry['attempts'].append({'folder': folder_name, 'stopped': 'the process ended without recording an outcome (a crash)'})
    94	                    save()
    95	                if folder_name.endswith('-redo'):
    96	                    return end(run, f'{run} incomplete: its redo did not finish')
    97	                continue
    98	            try:
    99	                runner = ladder_adapter.replay(run, root / folder_name, transport=transport, limit=limit, inputs=inputs_of.get(run))
   100	            except BaseException as error:              # a second send only where it can differ
   101	                attempt = {'folder': folder_name, 'stopped': f'{type(error).__name__}: {error}', 'traceback': traceback.format_exc()[-2000:]}
   102	                if not isinstance(error, (Exception, SystemExit)):
   103	                    entry['attempts'].append(attempt)
   104	                    save()
   105	                    raise
   106	                if isinstance(error, ladder_adapter.budget.OverBudget):
   107	                    reason = limit.stopped or f'the spending cap: {error}'
   108	                elif folder_name.endswith('-redo') or not resendable(error):
   109	                    reason = f'{run} incomplete: {type(error).__name__}'
   110	                else:
   111	                    reason = None
   112	                if reason is not None:
   113	                    limit.stop(reason)                  # the stop is on disk before the attempt is: a crash between them cannot lead to a redo
   114	                    entry['attempts'].append(attempt)
   115	                    return end(run, reason)
   116	                entry['attempts'].append(attempt)
   117	                save()
   118	                continue
   119	            entry['attempts'].append({'folder': folder_name, 'judgements': runner.counts['judgements'],
   120	                                      'views': runner.counts['views written from a ladder']})
   121	            if runner.counts['judgements'] == 0:      # design §8: a draw with no judgement is incomplete
   122	                return end(run, f'{run} incomplete: no judgement')
   123	            entry['state'] = 'complete'
   124	            save()
   125	            break
