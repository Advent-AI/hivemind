    55	def open_db(path):
    56	    os.makedirs(os.path.dirname(os.path.abspath(path)), exist_ok=True)
    57	    conn = sqlite3.connect(path)
    58	    conn.row_factory = sqlite3.Row
    59	    for name, columns in TABLES.items():
    60	        conn.execute(f'create table if not exists {name} ({columns})')
    61	        conn.execute(f"create trigger if not exists {name}_no_update before update on {name} begin select raise(abort, 'append-only'); end")
    62	        conn.execute(f"create trigger if not exists {name}_no_delete before delete on {name} begin select raise(abort, 'append-only'); end")
    63	    for statement in INDEXES:
    64	        conn.execute(statement)
    65	    ensure_writable_columns(conn)
    66	    conn.execute("create virtual table if not exists views_fts using fts5(view_id unindexed, text, tokenize='trigram')")
    67	    conn.execute("create virtual table if not exists groups_fts using fts5(group_id unindexed, text, tokenize='trigram')")
    68	    conn.execute('create index if not exists members_view on thesis_group_members(view_id)')
    69	    conn.commit()
    70	    return conn

