   151	def article_inputs(trace_path):
   152	    """Per article, by manifest position (as `adapter.trace_articles` numbers them): its input id, from the first segment's manifest."""
   153	    first = str(trace_path).split('+')[0]
   154	    conn = sqlite3.connect(f'file:{first}?mode=ro', uri=True)
   155	    try:
   156	        return {n: iid for n, iid in enumerate(json.loads(conn.execute('select manifest from run').fetchone()[0])['item_ids'], 1)}
   157	    finally:
   158	        conn.close()
