"""Read-only answers over the views ledger, as of a calendar day (docs/poc/service.md).

Nothing here reads the clock (D12, D13): every function takes `as_of`, a day, and the default is the ledger's last
completed day. A row is visible as of a day when the sequence number it was written under belongs to an item or a
daily round dated on or before that day. Nothing here writes.
"""
import json
import re
from decimal import Decimal

from . import vocabulary
from .views import store

TIER_FACT = vocabulary.TIERS[0]          # 'fact'; a legacy ledger's '发生的事' compares equal through vocabulary.canonical
COMPARATORS = ('>=', '<', '=')


def open_ledger(path):
    """A read-only connection to a views database."""
    return store.open_read_only(path)


def default_as_of(conn):
    return store.last_completed_day(conn) or conn.execute('select max(publication_day) from judgements').fetchone()[0]


_SEQ_DAYS = {}      # id(connection) → (connection, (max sequence, rows), map); a sqlite3 connection cannot carry attributes


def seq_day_map(conn):
    """sequence number → the publication day of the item or daily round written under it. Cached per connection and
    rebuilt when processing_steps has grown (an open ledger gains steps while the pipeline runs); without the cache
    one view with 367 pieces of evidence cost 1,224 full scans (0.46 s, measured 2026-10-24)."""
    stamp = tuple(conn.execute('select max(sequence_no), count(*) from processing_steps').fetchone())
    entry = _SEQ_DAYS.get(id(conn))
    if entry is not None and entry[0] is conn and entry[1] == stamp:
        return entry[2]
    cache = {}
    for seq, day in conn.execute('select sequence_no, min(publication_day) from processing_steps where sequence_no > 0 group by sequence_no'):
        cache[seq] = day
    if cache:                 # sequence 0 is the seed questions written before the first item (D253): visible from the ledger's first day
        cache[0] = min(cache.values())
    if len(_SEQ_DAYS) >= 64:
        _SEQ_DAYS.clear()
    _SEQ_DAYS[id(conn)] = (conn, stamp, cache)
    return cache


def day_of_seq(conn, seq):
    return seq_day_map(conn).get(seq)


def visible(conn, seq, as_of):
    day = day_of_seq(conn, seq)
    return day is not None and day <= as_of


# ---------- views

def view_exists(conn, record, as_of):
    return visible(conn, record['created_seq'], as_of)


def is_open_as_of(conn, view_id, as_of):
    for row in conn.execute('select open, after_seq from view_switches where view_id=? order by id desc', (view_id,)):
        if visible(conn, row['after_seq'], as_of):
            return bool(row['open'])
    return True


def state_as_of(conn, view_id, as_of):
    """The last judgement on or before the day, with the day the current position was first taken."""
    rows = [dict(r) for r in conn.execute('select * from judgements where view_id=? and publication_day<=? order by judgement_id', (view_id, as_of))]
    if not rows:
        return None
    last = rows[-1]
    since, previous = last['publication_day'], None
    for row in reversed(rows[:-1]):
        if row['rung'] != last['rung']:
            previous = row['rung']
            break
        since = row['publication_day']
    return {'position': last['rung'], 'judgement_day': last['publication_day'], 'since_day': since, 'previous_position': previous,
            'rounds': len(rows), 'why_changed': last['why_changed'], 'reasons': last['reasons'], 'theme_pushes': _json(last.get('theme_pushes_json'))}


def summaries(conn, as_of=None, include_closed=False):
    """Every view as of the day as a light record (id, object, kind, what it looks at, the question, due day, open,
    dependency and dependant ids): what a search ranks. The full record with its evidence counts is `view`; listing
    92 of those cost 0.29 s per search (1,205 evidence reads), measured 2026-10-24."""
    as_of = as_of or default_as_of(conn)
    out = []
    for record in conn.execute('select * from views order by created_seq'):
        record = dict(record)
        if not view_exists(conn, record, as_of):
            continue
        is_open = is_open_as_of(conn, record['view_id'], as_of)
        if not include_closed and not is_open:
            continue
        out.append({'view_id': record['view_id'], 'object': record['object_id'], 'object_kind': record['object_kind'], 'kind': record['kind'],
                    'looks_at': record['looks_at'], 'question': record['question'], 'due_day': record['due_day'], 'open': is_open,
                    'dependencies': [d['view_id'] for d in dependencies(conn, record['view_id'], as_of)], 'dependants': dependants(conn, record['view_id'], as_of)})
    return out


def views(conn, object_id=None, as_of=None, include_closed=False):
    as_of = as_of or default_as_of(conn)
    rows = conn.execute('select * from views' + (' where object_id=?' if object_id else '') + ' order by created_seq', (object_id,) if object_id else ()).fetchall()
    out = []
    for record in rows:
        record = dict(record)
        if not view_exists(conn, record, as_of):
            continue
        if not include_closed and not is_open_as_of(conn, record['view_id'], as_of):
            continue
        out.append(view(conn, record['view_id'], as_of, record=record))
    return out


def dependencies(conn, view_id, as_of):
    """The view's dependencies recorded on or before the day, each pointing at the target resolved on or before it."""
    out = []
    for dep in conn.execute('select * from dependencies where view_id=? order by dependency_id', (view_id,)):
        if not visible(conn, dep['seq'], as_of):
            continue
        target = dep['depends_on']
        for res in conn.execute('select resolved_to, seq from dependency_resolutions where dependency_id=? order by id desc', (dep['dependency_id'],)):
            if visible(conn, res['seq'], as_of):
                target = res['resolved_to']
                break
                kind = (json.loads(body).get('error') or {}).get('type') or ''
            except (ValueError, AttributeError):
                kind = ''
            last = f'embeddings HTTP {error.code}' + (f' ({kind})' if kind else '')
            if error.code in (400, 401, 403, 404):
                raise model.TransportError(last)
        except (urllib.error.URLError, TimeoutError, ConnectionError, OSError) as error:
            last = repr(error)[:200]
        time.sleep(3 * (attempt + 1))
    raise model.TransportError(last or 'no answer')


def build_index(ledger, index, embed=openai_embeddings, embedding_model=EMBEDDING_MODEL, batch=64):
    """Embed every view whose text is new or changed, batch by batch, each batch committed as it lands. Returns
    (embedded, unchanged, tokens, error): on a failure the counts are what was done before it, never zero, and the
    error is the message without the provider's body. Never raises."""
    rows = [dict(r) for r in ledger.execute('select * from views order by created_seq')]
    todo, unchanged = [], 0
    for record in rows:
        text = view_text(record, store.rungs_of(ledger, record['view_id']))
        digest = sha(text)
        have = index.execute('select text_sha256, model, vector_json from view_vectors where view_id=?', (record['view_id'],)).fetchone()
        if have and have['text_sha256'] == digest and have['model'] == embedding_model and usable(json.loads(have['vector_json'])):
            unchanged += 1
        else:
            todo.append((record['view_id'], digest, text))
    embedded = tokens = 0
    for start in range(0, len(todo), batch):
        chunk = todo[start:start + batch]
        try:
            vectors, used = embed([t for _, _, t in chunk], embedding_model)
        except (model.TransportError, OSError) as error:
            return embedded, unchanged, tokens, str(error)[:120]
        if len(vectors) != len(chunk) or not all(usable(v) for v in vectors):
            return embedded, unchanged, tokens, 'the embedding answer did not hold one usable vector per text'
        tokens += used
        now = time.strftime('%Y-%m-%dT%H:%M:%S')
        index.executemany('insert or replace into view_vectors (view_id, text_sha256, model, vector_json, tokens, built_at) values (?,?,?,?,?,?)',
                          [(view_id, digest, embedding_model, json.dumps(vector), used // max(1, len(chunk)), now) for (view_id, digest, _), vector in zip(chunk, vectors)])
        index.commit()
        embedded += len(chunk)
    return embedded, unchanged, tokens, None


ensure_index = build_index


def usable(vector):
    """A vector the ranking can use: a non-empty list of numbers."""
    return isinstance(vector, list) and len(vector) > 0 and all(isinstance(x, (int, float)) for x in vector)


def fresh_vectors(ledger, index, embedding_model=EMBEDDING_MODEL):
    """view id → vector for every view whose stored vector was made from the view's current text and is usable; a
    view whose text changed since, was never embedded, or holds an empty vector is absent."""
    stored = {r['view_id']: (r['text_sha256'], json.loads(r['vector_json'])) for r in index.execute('select view_id, text_sha256, vector_json from view_vectors where model=?', (embedding_model,))}
    out = {}
    dims = None
    for record in ledger.execute('select * from views'):
        have = stored.get(record['view_id'])
        if have and have[0] == sha(view_text(record, store.rungs_of(ledger, record['view_id']))) and usable(have[1]) and (dims is None or len(have[1]) == dims):
            out[record['view_id']] = have[1]
            dims = len(have[1])
    return out


def query_vector(index, query, embed=openai_embeddings, embedding_model=EMBEDDING_MODEL):
    digest = sha(query)
    row = index.execute('select vector_json from query_vectors where text_sha256=? and model=?', (digest, embedding_model)).fetchone()
    if row:
        return json.loads(row['vector_json']), True
    vectors, tokens = embed([query], embedding_model)
    index.execute('insert or replace into query_vectors (text_sha256, model, vector_json, tokens, built_at) values (?,?,?,?,?)',
                  (digest, embedding_model, json.dumps(vectors[0]), tokens, time.strftime('%Y-%m-%dT%H:%M:%S')))
    index.commit()
    return vectors[0], False
"""The MCP front of the Hivemind service (docs/poc/service.md): one tool per call, stdio transport, every answer from
src/hivemind/service.py and search.py. Hivemind is a database with a search engine on top: the caller searches,
chooses which views to keep and how to arrange them, and reads each view's state, history and evidence. Nothing
here writes to the ledger or knows who is asking.

Usage: python3 scripts/hivemind_mcp.py [--views DB] [--index DB]
Claude Code: claude mcp add hivemind -- python3 /path/to/scripts/hivemind_mcp.py
"""
import argparse
import os
import sys

from mcp.server.fastmcp import FastMCP

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, os.path.join(ROOT, 'src'))
from hivemind import bundle, search as search_module, service  # noqa: E402
from hivemind.views import store  # noqa: E402

parser = argparse.ArgumentParser()
parser.add_argument('--views', default=os.path.join(ROOT, 'poc', 'data', 'served-2026-10-28-v34-nvda-3m-through-0828', 'views.sqlite'))
parser.add_argument('--index', default=os.path.join(ROOT, 'poc', 'data', 'service-english', 'search-index.sqlite'))
parser.add_argument('--universe', default=os.path.join(ROOT, 'poc', 'universe.json'))
parser.add_argument('--items', default=os.path.join(ROOT, 'poc', 'data', 'items-nvda-2026-07-01-10-27.sqlite'))
parser.add_argument('--lexical', action='store_true', help='no embedding at all (no network): search ranks by the trigram index and says mode lexical')
parser.add_argument('--transport', choices=['stdio', 'streamable-http'], default='stdio', help='stdio for a local agent; streamable-http to serve /mcp over HTTP (Docker)')
parser.add_argument('--host', default='127.0.0.1')
parser.add_argument('--port', type=int, default=8789)
ARGS = parser.parse_args()
LEDGER = service.open_ledger(ARGS.views)
INDEX = search_module.open_index(ARGS.index)
ITEMS = store.open_read_only(ARGS.items) if os.path.exists(ARGS.items) else None
ALIASES = search_module.object_aliases(ARGS.universe)
if not ARGS.lexical:
    _embedded, _unchanged, _tokens, INDEX_ERROR = search_module.ensure_index(LEDGER, INDEX)
    if INDEX_ERROR:
        sys.stderr.write(f'hivemind: embedding stopped ({INDEX_ERROR}) after {_embedded} views; search runs lexical until the rest is built\n')

from hivemind import idea as idea_module  # noqa: E402

OBJECTS = idea_module.object_list(LEDGER, service.default_as_of(LEDGER), ALIASES)
mcp = FastMCP('hivemind', host=ARGS.host, port=ARGS.port, instructions=(
    'Hivemind is a ledger of research views (a dated question with a five-step ladder, judged every day on evidence) '
    'with a search engine on top. To read an idea against it: first break the idea into its parts, the one to four '
    'questions whose answers decide it (each about one concrete quantity, date or event); search with the idea and with '
    'each part (k=20); map each part to every view whose question answers it or whose outcome would move it, leaving out '
    'views that only share a company or a word; then read each mapped view (state as of a day, history, evidence) and '
    'say what the judged positions tell about each part and which parts no view covers. Say judged, never true. Every '
    'tool takes as_of, a calendar day; the default is the ledger\'s last completed day. Nothing here changes the ledger. '
    'search matches each view\'s own text (question, what it looks at, ladder conditions; Chinese, English queries work): '
    'ask for one object and one quantity or event per query; views(object) lists everything under one object. '
    + OBJECTS))


@mcp.tool()
def thesis_library(as_of: str = '') -> dict:
    """All collected theses and their stored research groups, including ungrouped and closed theses.
    Membership is not a dependency or a parent-child relationship. No model call or ledger write."""
    return bundle.library(LEDGER, ITEMS, as_of or None)


@mcp.tool()
def thesis_bundles(view_ids: list[str], as_of: str = '') -> dict:
    """Complete UI inputs for selected thesis ids: dated states, assessments, sources, evidence and relationships.
    Pass this envelope to the frontend's fromBundles adapter. Read-only; does not call a model."""
    return bundle.thesis_bundles(LEDGER, ITEMS, view_ids, as_of or None)


@mcp.tool()
def search(query: str, k: int = 10, as_of: str = '', include_closed: bool = False) -> dict:
    """Top-k views for an idea or sentence: id, object, kind, what it looks at, the question, due day, dependencies
    (the views it is judged after) and dependants, with the score and its parts. Views, never evidence: evidence is
    anchored under its view."""
    return search_module.search(LEDGER, INDEX, query, k, as_of or None, include_closed, aliases=ALIASES, semantic=not ARGS.lexical)


@mcp.tool()
def views(object: str = '', as_of: str = '', include_closed: bool = False) -> list:
    """The views of one object (a ticker like NVDA or a theme id like ai-capex), or all views, as of a day."""
    return service.views(LEDGER, object or None, as_of or None, include_closed)


@mcp.tool()
def view(view_id: str, as_of: str = '') -> dict:
    """One view as of a day: the question, the ladder (positions 1..5, position 1 the most bullish outcome; or 2 for
    yes/no), the judged position with its label and condition and since when, whether open, dependencies and
    dependants, counts of rounds, evidence and facts."""
    record = service.view(LEDGER, view_id, as_of or None)
    if record is None:
        raise ValueError(f'no view {view_id} as of {as_of or "the last completed day"}')
    return record


@mcp.tool()
def history(view_id: str, from_day: str = '', to_day: str = '') -> dict:
    """Every judgement round in the span (day, position, whether it changed, why, the cited evidence ids and the push
    each gave), evidence arrivals per day, position changes, replacements of guidance, open/close switches."""
    return service.history(LEDGER, view_id, from_day or None, to_day or None)


@mcp.tool()
def evidence(view_id: str, as_of: str = '', tier: str = '') -> list:
    """Evidence in force under the view as of a day: one line, the source's own words, tier (发生的事 fact, 当事人说的
    party statement, 第三方看法 third-party view, 传闻 rumour), speaker, when it arrived, its sources."""
    return service.evidence(LEDGER, view_id, as_of or None, tier or None)


@mcp.tool()
def record(view_id: str, as_of: str = '') -> dict:
    """The last check of the view on or before the day: when, by which round, how many items were processed that
    day and how much evidence arrived under the view."""
    return service.record(LEDGER, view_id, as_of or None)


@mcp.tool()
def changes(since_day: str, to_day: str = '') -> list:
    """Judgements that said 'changed' after since_day, each with the view, from/to position and the evidence cited."""
    return service.changes(LEDGER, since_day, to_day or None)


@mcp.tool()
def evaluate(view_id: str, comparator: str, value_usd: float, as_of: str = '') -> dict:
    """A claim against a view's ladder: 'the quantity >= / < / = value_usd'. Returns the ladder position the
    threshold sits in, the judged position, and the verdict: holds (the judged band is wholly on the claim's side),
    not_yet (wholly on the other side) or borderline (the threshold cuts through the judged band)."""
     1	# A live new-system store: the operating contract, version 3 for the council (D592; $0 design, nothing built)
     2	
     3	**Status:** D575 paused the earlier design (`DESIGN.md`) as recorded input; it was not accepted. Round 110 resumed the work as this
     4	$0 contract. Version 2 answered round 111's six findings; version 3 answers round 112's four. It returns to the council before any build or live run. The new system has
     5	not passed its quality gates, and adopting it is Alex's choice. This contract only states what a live store would have to guarantee.
     6	
     7	**Falsifier (round 110):** a required operating case that cannot be served consistently under this contract without blocking the
     8	writer's commits or exposing partial work. The proof plan names one test per case, and one failing test sends the contract back.
     9	
    10	## What touches a live store (searched in the code)
    11	
    12	- **The writer:** the new system's daily loop through `clean-arch/step4-2026-11-10/stage_b/ladder_adapter.py`.
    13	  - It opens the store with `store.open_db`, today in SQLite's default rollback-journal mode.
    14	  - It commits several times within a day; `close_and_complete` closes due questions, records the day in `days_completed` and
    15	    commits.
    16	  - **A stopped run is never resumed** (the module's docstring; `run_stage_b.py` records a crash as the folder's outcome).
    17	
    18	| Toucher | How | When |
    19	|---|---|---|
    20	| API (`scripts/hivemind_api.py`) | `Connections`: one read-only connection per request; `search.ensure_index(ledger, index)` at start, which embeds view text through an outside service (row 4a) | every request; once at start |
    21	| MCP server (`scripts/hivemind_mcp.py`) | one read-only connection at start (`LEDGER`); `ensure_index` and the object list computed at start | the whole process |
    22	| The page | only through the API | — |
    23	| The page's embedded snapshot (`scripts/mock_build.py` → `bundle.library`) | `service.open_ledger` | one build |
    24	| Idea and evaluation scripts (`idea_probe`, `idea_gold`, `idea_stability`, `agent_day0`, `search_eval`) | `open_read_only` / `open_ledger` | one run |
    25	| Research and census scripts (`docs/research/**`) | `open_read_only` | one run |
    26	| Preflight (`scripts/preflight.py`) | **`shutil.copy` of `views.sqlite`** to a scratch file (row 7 replaces it with the backup API) | before a paid run |
    27	| A run's `snapshot.sh` (a per-run file, not a repository script) | SQLite's backup API | on demand |
    28	
    29	## The contract
    30	
    31	1. **Journal mode, side files, opening.**
    32	   - The live store is in WAL mode, set by the writer when it creates the store. Production's stores stay as they are.
    33	   - The `-wal` and `-shm` files sit beside the store on a local disk. **No reader reaches a live store through a container bind mount
    34	     or a network share.**
    35	   - **Opening precondition:** every reader runs as the writer's user, and the store's directory is writable by it. SQLite needs the
    36	     `-wal` and `-shm` files readable, or permission to create them, to open a WAL store with `mode=ro`.
    37	   - Readers open with `mode=ro`, never `immutable=1`.
    38	   - A reader that cannot open the store, or cannot begin a read transaction, fails loudly with the store's path. It never serves an
    39	     empty or stale answer in its place.
    40	   - Readers set a busy timeout and retry `SQLITE_BUSY` within it. SQLite documents rare WAL cases where a read returns busy, for
    41	     example while the WAL index is being rebuilt.
    42	   - The guarantee is that readers do not block the writer's commits, not that the writer never waits.
    43	2. **One committed state per request.**
    44	   - Each API request and each MCP tool call runs every read inside one explicit read transaction: `BEGIN`, the reads, the end.
    45	   - The service's start-up reads (the API's and MCP's `ensure_index`, MCP's object list) run the same way. MCP's object list is
    46	     recomputed per call.
    47	3. **Every date bound, resolved in one function.**
    48	   - Today 13 places resolve a bound as `x or default_as_of(conn)`: `service.py` ×9 (`summaries`, `views`, `view`, `evidence`,
    49	     `history`'s `to_day`, `record`, `changes`' `to_day`, `evaluate`, …), `bundle.py` ×2, `idea.py` ×1 and `search.py` ×1. An
    50	     explicit date bypasses any check placed in `default_as_of`.
    51	   - **The owner:** one function, `service.resolve_bound(conn, bound)`, receives every upper bound, explicit or omitted, in its
    52	     caller's read transaction.
    53	     - An omitted bound gives the last completed day.
    54	     - An explicit bound later than the last completed day is refused, naming that day.
    55	     - An explicit bound on or before it passes.
    56	   - Every one of the 13 sites calls it, and lower bounds (`from_day`, `since_day`) are unaffected.
    57	   - **A structural check** fails the suite when any module calls `default_as_of` outside `resolve_bound`, or resolves a bound by
    58	     `or`. A behaviour test per caller gives each an explicit future bound and an omitted one.
    59	4. **The first day** (open defect 10).
    60	   - Before any day completes, every request and tool call is refused, including the streamed Idea route before any header.
    61	   - An empty store (no step) and a legacy ledger read as today.
    62	4a. **The search index** (`search.ensure_index` → `build_index` reads `select * from views` with no date).
    63	   - It may include a view only when that view is visible as of the last completed day: created under a sequence dated on or
    64	     before it. A view written during an unfinished day is never embedded and never sent to the embedding service.
    65	   - The index records the day it was built to. At start, and after each later completed day, it is extended to the new last
    66	     completed day in one read transaction.
    67	   - Until then, search answers from the index's day and says so. A view visible at the request's bound but not yet indexed is
    68	     found by the lexical index, as in today's `--lexical` mode.
    69	   - On a first-day store the index is not built and search is refused, as in row 4.
    70	5. **Checkpoints and disk, with a bounded failure.**
    71	   - The writer sets `journal_size_limit` (proposed 64 MB) and keeps SQLite's automatic passive checkpoint.
    72	   - After each completed day it asks for a truncating checkpoint with a short busy timeout. A request or tool call is the longest a
    73	     reader holds a transaction (row 2).
    74	   - **If the truncating checkpoint fails on 3 consecutive completed days, the writer stops before the next day,** with a recorded
    75	     reason. Readers keep serving the last completed day, and the stop is visible in the run's log and outcome.
    76	   - So the `-wal` file grows for at most 3 days of writes beyond the limit, and that bound is stated in the run's limits file
    77	     beside its cost limits.
    78	   - The writer does not stop on a single failure, because readers end within one request.
    79	   - The proof covers a reader that ends (the checkpoint completes after it) and a sustained one (the writer stops on the third
    80	     failure).
    81	6. **A crash.**
    82	   - WAL drops the unfinished transaction. The day's **already committed writes stay** in the store.
    83	   - Readers stay bounded to the last completed day. Every row written during the unfinished day is dated by that day's processing
    84	     steps, after the last completed day, so it is outside every allowed bound.
    85	   - **The writer does not resume** (today's loop). The store is served as of its last completed day until it is replaced.
    86	   - Resuming a stopped live store is a separate design, not covered here.
    87	7. **Copies.**
    88	   - A live store is copied only with SQLite's backup API, which is consistent in WAL mode and while the writer commits.
    89	   - **Preflight's own copy changes to the backup API** (Python's `Connection.backup`, from a `mode=ro` source) in place of
    90	     `shutil.copy`. Its scratch copy is then consistent whatever state the source is in, with no check-then-copy race and no need to
    91	     tell a finished store from a live one.
    92	   - It still runs only before a paid run, on the stores it is given.
    93	8. **AGENTS §9 ("Never open a live run's databases") stays in force.**
    94	   - **Proposed decision P1, to be resolved before any live-service operation and not assumed by any proof:** the product's API and
    95	     MCP server may read a live WAL store under rows 1 to 7. Every other toucher above uses a backup-API snapshot.
    96	   - The proofs run on test stores made for them, never on a live run.
    97	
    98	## State × event (the store's state at the request's transaction × the request)
    99	
   100	| State | Bounds omitted | Upper bound ≤ last completed day | Upper bound > last completed day | Start-up reads | Copy |
   101	|---|---|---|---|---|---|
   102	| Empty store | as today | as today | as today | as today | consistent |
   103	| First day in progress | refused (4) | — | refused (4) | wait; requests refused | consistent (an in-progress copy, read under the same rules) |
   104	| A later day in progress | the last completed day | that bound | refused (3) | the last completed day | consistent |
   105	| A day completing during a request | the request's own transaction | same | same | same | consistent |
   106	| Crashed mid-day, not resumed | the last completed day | that bound | refused (3) | the last completed day | consistent |
   107	| `-wal`/`-shm` absent and directory not writable | fails loudly (1) | same | same | fails loudly | — |
   108	
   109	## Proof plan ($0, on test stores made for it; nothing built until the council accepts the contract)
   110	
   111	1. **WAL mode:** the writer's store is in WAL mode with the size limit set; production's stores are unchanged.
   112	2. **Every upper bound:**
   113	   - the structural check that no bound is resolved outside `resolve_bound`;
   114	   - for each of the 13 callers, an explicit future bound is refused naming the last completed day, an explicit past bound passes,
   115	     and an omitted bound gives the last completed day;
   116	   - lower bounds are unaffected.
   117	3. **One state per request:** an API request held between its first and last read while the writer commits a judgement and
   118	   completes a day returns the state at its start, and the writer's commits succeed. Run on a first-day store and a store with one
   119	   completed day.
   120	4. **Start-up:**
   121	   - a service started on a first-day store refuses requests and builds its index after the first day completes;
   122	   - MCP's object list after a later day includes that day's objects;
   123	   - no transaction is open between MCP calls.
   124	5. **Checkpoint and disk:**
   125	   - with a long read held, the writer commits;
   126	   - after the read ends, a checkpoint completes, and a reset brings the `-wal` within the limit;
   127	   - with a reader held across three completed days, the writer stops before the fourth with its reason recorded, and readers serve
   128	     the last completed day.
   129	6. **Opening precondition:** with `-wal`/`-shm` absent and the directory read-only, a reader fails loudly. A busy read is retried
   130	   within the timeout.
   131	7. **A crash:** the writer is killed after committed writes mid-day.
   132	   - Every route's answer, at every allowed bound, equals the answer from a backup taken at the last completed day.
   133	   - The search index and the text sent to the embedding service (recorded by a fake transport) equal the backup's.
   134	   - The partial day's rows are present in the file and invisible to every route and to the index.
   135	8. **Copies:**
   136	   - a backup taken while the writer commits passes an integrity check;
   137	   - preflight's scratch copy, made by the backup API from a store being written, equals a backup taken at the same commit.
   138	8a. **The index:** on a store with an unfinished day, the views sent to the (fake) embedding service are exactly those visible as of
   139	   the last completed day. After the day completes, the index is extended to it, and search names the index's day until then.
   140	9. **The paused-writer harness** (`page-contract/serving_while_writing.py`) re-run: every check holds and the first-day case passes.
   141	
   142	## Not covered
   143	
   144	- Resuming a stopped live store.
   145	- The Idea planner on a new-system ledger.
   146	- A long-running service's restart and monitoring.
   147	- The page's note when its live read fails, which is Alex's presentation choice.
