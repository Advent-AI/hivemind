   161	class LadderAdapter(adapter.Adapter):
   162	    """The Stage 2 adapter in its ladder mode: no seed, no ruler view; views come only from the ladder step's answers."""
   163	
   164	    def __init__(self, views_path, archive_path, ledger_path, *, transport=None, cap_usd=0.66, sleep=None, limit=None, shared=None):
   165	        self.conn = store.open_db(views_path)
   166	        self.conn.execute(f"create table if not exists clean_ladders ({', '.join(LADDER_COLUMNS)}, primary key (thesis_id))")
   167	        self.conn.commit()
   168	        self.archive = model.Archive(archive_path)
   169	        self.cfg = config.load(adapter.CONFIG)
   170	        self.transport = transport
   171	        self.budget = limit if limit is not None else LedgerBudget(cap_usd, ledger_path, attempt=transport, sleep=sleep, shared=shared)
   172	        self.q23 = None
   173	        self.views = set()
   174	        self.mapping = {}
   175	        self.unjudged = set()            # theses with a ladder row and no view
   176	        self.evidence_of = {}
   177	        self.counts = collections.Counter()
   178	        self.next_number = 1
   179	        self.sent = []
