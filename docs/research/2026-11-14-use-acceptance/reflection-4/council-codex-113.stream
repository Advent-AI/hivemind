   180	def evidence(conn, view_id, as_of=None, tier=None):
   181	    """Evidence linked to the view on or before the day and not replaced on or before it, with its sources."""
   182	    as_of = as_of or default_as_of(conn)
   183	    out = []
   184	    for link in conn.execute('select evidence_id, seq from evidence_links where view_id=? order by id', (view_id,)):
   185	        if not visible(conn, link['seq'], as_of):
   186	            continue
   187	        replacement = conn.execute('select new_evidence_id, said_day, seq from replacements where old_evidence_id=? order by id desc limit 1', (link['evidence_id'],)).fetchone()
   188	        if replacement and visible(conn, replacement['seq'], as_of):
   189	            continue
   190	        piece = evidence_record(conn, link['evidence_id'], as_of, link['seq'])
   191	        if tier and piece['tier'] != tier:
   192	            continue
   193	        out.append(piece)
   194	    return out
