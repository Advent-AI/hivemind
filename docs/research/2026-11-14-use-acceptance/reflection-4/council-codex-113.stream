   181	    def open_thesis(self, thesis_id, outcome, k, seq, day, input_id, source):
   182	        """Write the thesis's ladder row and, for a written ladder, its view; not committed here. `k` is the trace's article number
   183	        (kept in the row as the source article), `seq` the store's sequence the loop gave the article (CLOSING-DESIGN.md §1)."""
   184	        status = STATUS[outcome['status']]
   185	        number = thesis_id.split('-', 1)[1]
   186	        view_id = f'v{number}' if status == 'ladder' else None
   187	        answer = outcome['answer']
   188	        reference_status = None
   189	        if status == 'ladder':
   190	            ladder = answer['ladder']
   191	            if ladder.get('figure') is not None:
   192	                reference_status = outcome['view'].get('reference_status')
   193	            checked = json.loads(json.dumps(answer))
   194	            if checked['ladder'].get('reference') is not None and outcome['passage'] is not None:
   195	                checked['ladder']['reference']['words'] = outcome['passage']
   196	        elif status == 'no ladder':                 # §5.4: the answer as given, the reason and a null ladder
   197	            checked = answer if answer is not None else {'ladder': None, 'no_ladder': outcome['reason']}
   198	        else:
   199	            checked = None
   200	        store.insert(self.conn, 'clean_ladders', thesis_id=thesis_id, view_id=view_id, status=status,
   201	                     reason=outcome['reason'] if status == 'no ladder' else None, reference_status=reference_status,
   202	                     checked_answer=None if checked is None else json.dumps(checked, ensure_ascii=False),
   203	                     outcome_record=json.dumps(outcome['requests'], ensure_ascii=False), config_checksum=source, article_seq=k, article_day=day)
