   205	
   206	def lexical_terms(query, limit=12):
   207	    """What the ledger's trigram index is asked for: the Latin words of three characters or more, and every
   208	    three-character window of each Chinese run (Chinese has no spaces to split on; the index matches on
   209	    trigrams). 2026-10-24: a Chinese idea written without spaces matched nothing as one phrase."""
   210	    terms = [m.group(0) for m in LATIN_WORD.finditer(query)]
   211	    for run in CJK.findall(query):
   212	        terms += [run[i:i + 3] for i in range(len(run) - 2)] or [run]
   213	    seen, out = set(), []
   214	    for term in terms:
   215	        if term.lower() not in seen:
   216	            seen.add(term.lower())
   217	            out.append(term)
   218	    return out[:limit]
   219	
   220	
   221	def search(ledger, index, query, k=10, as_of=None, include_closed=False, embed=openai_embeddings, embedding_model=EMBEDDING_MODEL, aliases=None, semantic=True):
   222	    """Top-k views for a query as of a day: cosine similarity on the view text, plus a small boost when the query
   223	    names the view's object and when the ledger's trigram index also matches. The ranking is 'semantic' only when
   224	    semantic ranking is allowed, every candidate has a usable vector made from its current text and the query could
   225	    be embedded; otherwise it is 'lexical' (the trigram index's own order), and the answer says so and names the
   226	    views without a fresh vector. `semantic=False` (a front started with --lexical) never calls the embedder.
   227	    `results` is null when the library holds no view on anything the idea names as of that day (D91): no company
   228	    or theme of the universe is named in it and the ledger's own text index matches no view; otherwise the ranked
   229	    list comes back whole and the caller judges which views correspond (D76)."""
   230	    as_of = as_of or service.default_as_of(ledger)
   231	    candidates = service.summaries(ledger, as_of, include_closed)
   232	    if not candidates:
   233	        return {'query': query, 'as_of': as_of, 'mode': 'semantic' if semantic else 'lexical', 'missing_vectors': [], 'results': None}
   234	    mentioned = objects_in(query, aliases or {})
   235	    lexical_order = store.search_views(ledger, ' '.join(lexical_terms(query)), 50)          # the ledger's trigram index, best first
   236	    lexical_rank = {view_id: i for i, view_id in enumerate(lexical_order)}
   237	    vectors = fresh_vectors(ledger, index, embedding_model) if semantic else {}
   238	    missing = [record['view_id'] for record in candidates if record['view_id'] not in vectors]
   239	    mode, q = 'semantic', None
   240	    if not semantic or missing:
   241	        mode = 'lexical'
   242	    else:
   243	        try:
   244	            q, _ = query_vector(index, query, embed, embedding_model)
   245	        except (model.TransportError, OSError):
   246	            mode = 'lexical'
   247	    results = []
   248	    for record in candidates:
   249	        semantic = cosine(q, vectors[record['view_id']]) if q is not None else 0.0
   250	        object_hit = record['object'] in mentioned
   251	        text_hit = record['view_id'] in lexical_rank
   252	        # with embeddings a text hit is a small nudge; without them the trigram index's own order is the ranking
   253	        text_score = (TEXT_BOOST if mode == 'semantic' else 1.0 - lexical_rank[record['view_id']] / max(1, len(lexical_order))) if text_hit else 0.0
   254	        score = semantic + (OBJECT_BOOST if object_hit else 0.0) + text_score
   255	        results.append({'view_id': record['view_id'], 'object': record['object'], 'kind': record['kind'], 'looks_at': record['looks_at'], 'question': record['question'],
   256	                        'due_day': record['due_day'], 'open': record['open'], 'dependencies': record['dependencies'], 'dependants': record['dependants'],
   257	                        'score': round(score, 4), 'parts': {'semantic': round(semantic, 4), 'object_hit': object_hit, 'text_hit': text_hit}})
   258	    results.sort(key=lambda r: -r['score'])
   259	    named_or_matched = any(r['parts']['object_hit'] or r['parts']['text_hit'] for r in results)
   260	    best = max((r['parts']['semantic'] for r in results), default=0.0)
   261	    if not named_or_matched and (q is None or best < NULL_FLOOR):
   262	        return {'query': query, 'as_of': as_of, 'mode': mode, 'missing_vectors': missing, 'results': None}     # no recorded view on anything the idea names
   263	    return {'query': query, 'as_of': as_of, 'mode': mode, 'missing_vectors': missing, 'results': results[:k]}
   264	
   265	
   266	def fake_embed(texts, embedding_model=EMBEDDING_MODEL, dims=256):
   267	    """A deterministic stand-in for tests: a bag of character bigrams hashed into a fixed number of dimensions, so
   268	    texts sharing words share directions. Never used for the real index."""
   269	    out = []
   270	    for text in texts:
   271	        vector = [0.0] * dims
   272	        lowered = re.sub(r'\s+', ' ', text.lower())
   273	        for i in range(len(lowered) - 1):
   274	            vector[int(hashlib.md5(lowered[i:i + 2].encode('utf-8')).hexdigest(), 16) % dims] += 1.0
   275	        out.append(vector)
   420	
   421	- Inspect a path before writing to it; new stored data gets a new, dated name; chain guarded steps with `&&`. Deleting stored data needs
   422	  Alex's request, a backup, exactly identified items and a log entry.
   423	- Absolute paths. Commands run under zsh: pass a list as an array. No foreground `sleep`.
   424	- Preserve existing and concurrent changes: never reset, clean or stash work that is not yours. Never run parallel agents that edit
   425	  shared modules.
   426	- When Alex names a step, the test is that step alone through its own harness (extraction: stored requests re-sent, answers sifted,
   427	  scored against the gold). A full-pipeline run, a registered test, or a paid send beyond the probes of a few cents an agreed direction
   428	  allows (§7.3) starts only on his explicit word (Alex, 2026-10-27: "我不是要你看下step 1抽取到底行不行？").
   429	- A long paid run is launched detached in a new session with a log and pid file, after checking machine and network health; nothing heavy
   430	  runs beside paid calls. A gate runs on a snapshot no one is editing.
   431	- Never open a live run's databases: run `sh <run folder>/snapshot.sh` and query the snapshot.
   432	- No edit to package code or prompt files while any run is live: the parallel day's manifest hashes every `.py` and prompt file and
   433	  fails the day. Edit in another worktree or wait.
   434	- Experiment harnesses send concurrently (a thread pool of 8; the archive is thread-safe); serial sends waste the wall clock Alex is
   435	  waiting on.
   436	- **Run settings** (`scripts/replay.py`): extraction requests prepared 16 at a time (`--workers`; the measurement launcher passes its
   437	  `HIVEMIND_WORKERS` there), Jev matching 8 at a time (`--jev-workers`), judgements 32 at a time (`judging.JUDGE_WORKERS`); a model call
   438	  times out after 180 s and is tried up to three times.

