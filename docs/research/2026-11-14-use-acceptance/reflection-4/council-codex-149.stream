   386	    themes = '\n'.join(f'  - {theme_id}: {name}' for theme_id, name in universe.theme_list())
   387	    fiscal = '\n'.join(note for note in (universe.fiscal_note(o, item['publication_day'], english=True) for o in objects) if note)
