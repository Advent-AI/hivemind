   325	def search_views(conn, text, top_n):
   326	    """Trigram full-text search over question + looks_at + object; the top N by rank."""
   327	    words = [w for w in text.replace('？', ' ').replace('，', ' ').split() if len(w) >= 2]
   328	    if not words:
   329	        return []
   330	    query = ' OR '.join('"' + w.replace('"', '') + '"' for w in words[:12])
   331	    try:
   332	        rows = conn.execute('select view_id from views_fts where views_fts match ? order by rank limit ?', (query, top_n)).fetchall()
   333	    except sqlite3.OperationalError:
   334	        return []
   335	    return [r['view_id'] for r in rows]
