                raise model.TransportError(last)
        except (urllib.error.URLError, TimeoutError, ConnectionError, OSError) as error:
            last = repr(error)[:200]
        time.sleep(3 * (attempt + 1))
    raise model.TransportError(last or 'no answer')


def build_index(ledger, index, embed=openai_embeddings, embedding_model=EMBEDDING_MODEL, batch=64):
    """Embed every view whose text is new or changed, batch by batch, each batch committed as it lands. Returns
    (embedded, unchanged, tokens, error): on a failure the counts are what was done before it, never zero, and the
    error is the message without the provider's body. Never raises."""
    rows = [dict(r) for r in ledger.execute('select * from views order by created_seq')]
    todo, unchanged = [], 0
    for record in rows:
        text = view_text(record, store.rungs_of(ledger, record['view_id']))
        digest = sha(text)
        have = index.execute('select text_sha256, model, vector_json from view_vectors where view_id=?', (record['view_id'],)).fetchone()
        if have and have['text_sha256'] == digest and have['model'] == embedding_model and usable(json.loads(have['vector_json'])):
            unchanged += 1
        else:
            todo.append((record['view_id'], digest, text))
    embedded = tokens = 0
    for start in range(0, len(todo), batch):
        chunk = todo[start:start + batch]
        try:
            vectors, used = embed([t for _, _, t in chunk], embedding_model)
        except (model.TransportError, OSError) as error:
            return embedded, unchanged, tokens, str(error)[:120]
        if len(vectors) != len(chunk) or not all(usable(v) for v in vectors):
            return embedded, unchanged, tokens, 'the embedding answer did not hold one usable vector per text'
        tokens += used
        now = time.strftime('%Y-%m-%dT%H:%M:%S')
        index.executemany('insert or replace into view_vectors (view_id, text_sha256, model, vector_json, tokens, built_at) values (?,?,?,?,?,?)',
                          [(view_id, digest, embedding_model, json.dumps(vector), used // max(1, len(chunk)), now) for (view_id, digest, _), vector in zip(chunk, vectors)])
        index.commit()
        embedded += len(chunk)
    return embedded, unchanged, tokens, None



def fresh_vectors(ledger, index, embedding_model=EMBEDDING_MODEL):
    """view id → vector for every view whose stored vector was made from the view's current text and is usable; a
    view whose text changed since, was never embedded, or holds an empty vector is absent."""
    stored = {r['view_id']: (r['text_sha256'], json.loads(r['vector_json'])) for r in index.execute('select view_id, text_sha256, vector_json from view_vectors where model=?', (embedding_model,))}
    out = {}
    dims = None
    for record in ledger.execute('select * from views'):
        have = stored.get(record['view_id'])
        if have and have[0] == sha(view_text(record, store.rungs_of(ledger, record['view_id']))) and usable(have[1]) and (dims is None or len(have[1]) == dims):
            out[record['view_id']] = have[1]
            dims = len(have[1])
    return out


def query_vector(index, query, embed=openai_embeddings, embedding_model=EMBEDDING_MODEL):
    digest = sha(query)
    row = index.execute('select vector_json from query_vectors where text_sha256=? and model=?', (digest, embedding_model)).fetchone()
    if row:
        return json.loads(row['vector_json']), True
def shown_for_record(archive_conn, rec, decisions):
    """The theses a stored matching record was shown, or None when the record cannot be identified: a generative record by its
    archived request; a Jev record (its request hash combines several calls) by the theses its candidate reasons name."""
    request_row = archive_conn.execute('select request_json from model_calls where request_sha256=?', (rec['request_sha256'],)).fetchone()
    if request_row:
        user = json.loads(request_row['request_json'])['messages'][1]['content']
        return [{'view_id': v} for v in dict.fromkeys(MATCH_SHOWN.findall(user))]
    reasons = [x.get('reason', '') for x in decisions.get('candidates', []) + decisions.get('evidence', [])]
    if reasons and all(r.startswith('jev:') for r in reasons):
        return [{'view_id': v} for v in dict.fromkeys(JEV_ASKED.findall(' '.join(x.get('reason', '') for x in decisions.get('candidates', []))))]
    return None


def part_c(archive_conn, views_paths, uni):
    reasons, examples = collections.Counter(), collections.defaultdict(list)
    judged = refused_records = 0
    per_ledger = []
    for path in views_paths:
        ledger_judged, skipped = 0, collections.Counter()
        # matching.check writes suggested themes to the review pool, so it runs on a scratch copy, never on the real file
        scratch = os.path.join(tempfile.mkdtemp(), 'views.sqlite')
        shutil.copy(path, scratch)
        conn = sqlite3.connect(scratch)
        conn.row_factory = sqlite3.Row
        for rec in conn.execute('select input_id, call_no, shown_json, decisions_json, request_sha256 from match_records order by id'):
            handover_row = conn.execute('select handover_json from handovers where input_id=? order by id desc limit 1', (rec['input_id'],)).fetchone()
            if not handover_row or not rec['decisions_json']:
                skipped['no handover or no decision'] += 1
                continue
            shown_views = shown_for_record(archive_conn, rec, json.loads(rec['decisions_json']))
            if shown_views is None:
                skipped['request not in this archive'] += 1
                continue
            handover = json.loads(handover_row['handover_json'])
            shown = json.loads(rec['shown_json'])
            lists = matching.Lists(shown.get('candidates', {}), {tuple(k.split('|', 1)): v for k, v in shown.get('evidence', {}).items()})
            if rec['call_no'] <= 2:
                candidates, evidence = handover['candidates'], handover['evidence']
    runner.counts['ladder answers file sha256'] = hashlib.sha256(ladders_path.read_bytes()).hexdigest()
    inputs_of = article_inputs(trace_path)
    last_article_day = list(days)[-1]
    end_day = end_day or last_article_day
    if end_day < last_article_day:
        raise SystemExit(f'the end day {end_day} is before the last article day {last_article_day}: refused')
    sequences = {}                                   # the trace's article number k -> the store's sequence (CLOSING-DESIGN.md §1)
    for day in calendar_days(list(days)[0], end_day):
        articles = days.get(day, [])
        runner.overdue_invariant(day)
        changed = set()
        for k in articles:
            seq = sequences[k] = max(k, store.next_sequence(runner.conn))
            input_id = by_article[k][0]['input_id'] if k in by_article else f'article:{k}'
            opened_here = sorted(opened.get(k, {}), key=lambda name: int(name.split('-', 1)[1]))
            for thesis_id in opened_here:
                runner.open_thesis(thesis_id, ladders[thesis_id], k, seq, day, input_id, source)
            runner.article(seq, by_article.get(k, []), library, revisions_by_record, later_by_article.get(k, []), changed)
            runner.record_article(seq, inputs_of[k], day)       # after its records are written, as production marks a handover
            for thesis_id in opened_here:
                for view_id in runner.mapping.get(thesis_id, []):
                    if runner.conn.execute('select count(*) from evidence_links where view_id=?', (view_id,)).fetchone()[0] == 0:
                        runner.counts['views with no opening evidence'] += 1
        runner.conn.commit()
        if changed:
            runner.judge(day, sequences[max(articles)], changed)
        runner.close_and_complete(day)
    (output / 'sequences.json').write_text(json.dumps({str(k): seq for k, seq in sequences.items()}, indent=1) + '\n')
    runner.counts['judging usd this draw (charged: from tokens, or the reserve when no usage came back)'] = round(runner.budget.spent_usd - spent_before, 4)
    runner.counts['judging usd of the whole limit so far (from its ledger)'] = round(ledger_total(runner.budget.ledger_path), 4)
    (output / 'adapter-counts.json').write_text(json.dumps(runner.counts, indent=1))
    (output / 'judge-requests.json').write_text(json.dumps(runner.sent, indent=1))
    return runner


if __name__ == '__main__':
    raise SystemExit('Stage B is sent through run_stage_b.py, which runs the three draws under one spending limit')

codex
**No-go on version 2 yet.** It answers several round-111 points, but the contract still assumes that limiting dates makes every reader’s output equivalent to the last completed day.

- **Startup indexing can read partial-day views.** `search.ensure_index` selects every view without an `as_of` filter. A transaction gives it a consistent database state, but that state can include views committed during the unfinished day; it can then send their text to the embedding service and store them in the index. Define indexing from the completed-day view, its update after later days, and how search behaves while the index is behind. [Search indexing](</Users/lchingen/hivemind/src/hivemind/search.py:80>)

- **The proposed preflight guard is not a reliable live-store test yet.** A WAL file can exist for a finished store, and checking for a writer or side file before a later `shutil.copy` leaves a race. Define the authority that distinguishes a finished store from a live one and how the check and copy remain safe together; alternatively make preflight require an explicitly supplied, validated backup. [Preflight copy](</Users/lchingen/hivemind/scripts/preflight.py:185>)

- **The checkpoint policy needs a bounded failure state.** A truncating checkpoint can wait for readers up to its timeout and can remain unable to reset if readers continue. `journal_size_limit` is not a bound on a growing WAL during that period. Specify what happens when the file keeps growing, who observes it, and whether the writer may continue; the current proof covers a reader that eventually ends, not the sustained case. [Contract, row 5](</Users/lchingen/hivemind/docs/research/2026-11-14-use-acceptance/live-service/OPERATING-CONTRACT.md>)

- **One date resolver requires changes at all callers.** Several functions use `as_of or default_as_of(...)`, so an explicitly supplied date bypasses `default_as_of` today. The design should identify the shared resolver that receives *both* explicit and omitted bounds, including `to_day`, and test each caller—not just a list of route names. [Service](</Users/lchingen/hivemind/src/hivemind/service.py:199>), [bundle](</Users/lchingen/hivemind/src/hivemind/bundle.py:210>)

The proposed P1 decision correctly keeps AGENTS §9 in force during the test-store proofs. Keep the crash comparison against a completed-day backup, but include indexing and its externally sent text in that comparison.

CONSENSUS: no, because startup indexing can consume partial-day views and the copy, checkpoint and explicit-date contracts are not yet sufficient to prevent the failure cases.
