    91	def post_idea(server, body):
    92	    request = urllib.request.Request(f'http://127.0.0.1:{server.server_address[1]}/ideas', data=json.dumps(body).encode(),
    93	                                     headers={'Content-Type': 'application/json', 'Accept': 'application/x-ndjson'}, method='POST')
    94	    try:
    95	        with urllib.request.urlopen(request, timeout=10) as response:
    96	            return response.status, response.headers.get('Content-Type'), response.read().decode()
    97	    except urllib.error.HTTPError as error:
    98	        return error.code, error.headers.get('Content-Type'), error.read().decode()
