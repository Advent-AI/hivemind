    36	@contextlib.contextmanager
    37	def connections():
    38	    """One tool call's databases (live-service/OPERATING-CONTRACT.md, row 2): the ledger, items and index opened per call, never shared
    39	    between calls (a search writes the index's query cache); the ledger's committed state pinned by BEGIN and a first read; every
    40	    connection closed on every path, a failure while opening included."""
    41	    opened = []
    42	    try:
    43	        ledger = service.open_ledger(ARGS.views)
    44	        opened.append(ledger)
    45	        ledger.execute('begin')
    46	        ledger.execute('select 1 from sqlite_master limit 1').fetchone()
    47	        index = search_module.open_index(ARGS.index)
    48	        opened.append(index)
    49	        items = store.open_read_only(ARGS.items) if os.path.exists(ARGS.items) else None
    50	        if items is not None:
    51	            opened.append(items)
    52	        yield ledger, items, index
    53	    finally:
    54	        if opened and opened[0].in_transaction:
    55	            opened[0].rollback()
    56	        for conn in reversed(opened):
    57	            conn.close()
