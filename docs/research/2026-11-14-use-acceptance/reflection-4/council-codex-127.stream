    81	        return self
    82	
    83	    def _close(self):
    84	        if self.ledger is not None and self.ledger.in_transaction:
    85	            self.ledger.rollback()
    86	        for conn in (self.ledger, self.index, self.items):
    87	            if conn is not None:
    88	                conn.close()
    89	
    90	    def __exit__(self, *exc):
