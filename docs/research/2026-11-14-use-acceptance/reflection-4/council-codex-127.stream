    27	def add_day(writer, day, seq, view_id):
    28	    """One article's processing, one view opened under it, and the day completed, committed: what the loop writes for a day."""
    29	    dispatch.mark(writer, {'input_id': f'gnews:{view_id}', 'publication_day': day}, seq, 'handed_over')
    30	    store.create_view(writer, view_id=view_id, object_id='NVDA', object_kind='asset', kind='asset', looks_at=f'shipments {view_id}',
    31	                      question=f'Will product {view_id} ship by 2027-01-31?', due_day='2027-01-31', year='2027', rungs=RUNGS, seq=seq,
    32	                      input_id=f'gnews:{view_id}', created_at=f'{day}T00:00:00Z')
    33	    store.complete_day(writer, day, seq, day)
    34	    writer.commit()
