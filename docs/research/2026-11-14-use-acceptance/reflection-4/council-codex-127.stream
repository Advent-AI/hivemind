    37	def a_wal_store(path, *, first_day=False):
    38	    writer = store.open_db(str(path))
    39	    writer.execute('pragma journal_mode=wal')
    40	    if first_day:
    41	        dispatch.mark(writer, {'input_id': 'gnews:first', 'publication_day': '2026-10-01'}, 1, 'handed_over')
    42	        writer.commit()
    43	    else:
    44	        add_day(writer, '2026-10-01', 1, 'v1')
    45	    return writer
