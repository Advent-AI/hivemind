    60	def start_objects():
    61	    """The object list for the server's instructions, computed once at start and labelled with its day; every tool reads the current
    62	    last completed day. Start-up indexing is unchanged until row 4a's slice: it can still read an unfinished day's views."""
    63	    with connections() as (ledger, _items, index):
    64	        if not ARGS.lexical:
    65	            embedded, _unchanged, _tokens, error = search_module.ensure_index(ledger, index)
    66	            if error:
    67	                sys.stderr.write(f'hivemind: embedding stopped ({error}) after {embedded} views; search runs lexical until the rest is built\n')
    68	        try:
    69	            day = service.resolve_bound(ledger, None)
    70	        except service.FirstDayNotCompleted:
    71	            return "No day of this ledger has completed yet; every tool refuses until one has."
    72	        return (f'Objects as of {day}, when this server started; every tool reads the current last completed day. '
    73	                + idea_module.object_list(ledger, day, ALIASES))
