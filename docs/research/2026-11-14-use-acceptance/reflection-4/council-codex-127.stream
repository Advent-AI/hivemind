    46	def view_text(record, rungs):
    47	    """What a view is searched by: its object, kind, what it looks at, the question and the rung conditions."""
    48	    return ' '.join([record['object_id'], record['kind'], record['looks_at'] or '', record['question'] or '', *(r['condition'] for r in rungs)])
    82	def build_index(ledger, index, embed=openai_embeddings, embedding_model=EMBEDDING_MODEL, batch=64):
    83	    """Embed every view whose text is new or changed, batch by batch, each batch committed as it lands. Returns
    84	    (embedded, unchanged, tokens, error): on a failure the counts are what was done before it, never zero, and the
    85	    error is the message without the provider's body. Never raises."""
    86	    rows = [dict(r) for r in ledger.execute('select * from views order by created_seq')]
    87	    todo, unchanged = [], 0
    88	    for record in rows:
    89	        text = view_text(record, store.rungs_of(ledger, record['view_id']))
    90	        digest = sha(text)
    91	        have = index.execute('select text_sha256, model, vector_json from view_vectors where view_id=?', (record['view_id'],)).fetchone()
    92	        if have and have['text_sha256'] == digest and have['model'] == embedding_model and usable(json.loads(have['vector_json'])):
    93	            unchanged += 1
    94	        else:
    95	            todo.append((record['view_id'], digest, text))
    96	    embedded = tokens = 0
    97	    for start in range(0, len(todo), batch):
    98	        chunk = todo[start:start + batch]
    99	        try:
   100	            vectors, used = embed([t for _, _, t in chunk], embedding_model)
   101	        except (model.TransportError, OSError) as error:
   102	            return embedded, unchanged, tokens, str(error)[:120]
   103	        if len(vectors) != len(chunk) or not all(usable(v) for v in vectors):
   104	            return embedded, unchanged, tokens, 'the embedding answer did not hold one usable vector per text'
   105	        tokens += used
   106	        now = time.strftime('%Y-%m-%dT%H:%M:%S')
   107	        index.executemany('insert or replace into view_vectors (view_id, text_sha256, model, vector_json, tokens, built_at) values (?,?,?,?,?,?)',
   108	                          [(view_id, digest, embedding_model, json.dumps(vector), used // max(1, len(chunk)), now) for (view_id, digest, _), vector in zip(chunk, vectors)])
   109	        index.commit()
   110	        embedded += len(chunk)
   220	
   221	def search(ledger, index, query, k=10, as_of=None, include_closed=False, embed=openai_embeddings, embedding_model=EMBEDDING_MODEL, aliases=None, semantic=True):
   222	    """Top-k views for a query as of a day: cosine similarity on the view text, plus a small boost when the query
   223	    names the view's object and when the ledger's trigram index also matches. The ranking is 'semantic' only when
   224	    semantic ranking is allowed, every candidate has a usable vector made from its current text and the query could
   225	    be embedded; otherwise it is 'lexical' (the trigram index's own order), and the answer says so and names the
   226	    views without a fresh vector. `semantic=False` (a front started with --lexical) never calls the embedder.
   227	    `results` is null when the library holds no view on anything the idea names as of that day (D91): no company
   228	    or theme of the universe is named in it and the ledger's own text index matches no view; otherwise the ranked
   229	    list comes back whole and the caller judges which views correspond (D76)."""
   230	    as_of = service.resolve_bound(ledger, as_of)
   231	    candidates = service.summaries(ledger, as_of, include_closed)
   232	    if not candidates:
   233	        return {'query': query, 'as_of': as_of, 'mode': 'semantic' if semantic else 'lexical', 'missing_vectors': [], 'results': None}
   234	    mentioned = objects_in(query, aliases or {})
   235	    lexical_order = store.search_views(ledger, ' '.join(lexical_terms(query)), 50)          # the ledger's trigram index, best first
   236	    lexical_rank = {view_id: i for i, view_id in enumerate(lexical_order)}
   237	    vectors = fresh_vectors(ledger, index, embedding_model) if semantic else {}
   238	    missing = [record['view_id'] for record in candidates if record['view_id'] not in vectors]
   239	    mode, q = 'semantic', None
   240	    if not semantic or missing:
   241	        mode = 'lexical'
   242	    else:
   243	        try:
   244	            q, _ = query_vector(index, query, embed, embedding_model)
   245	        except (model.TransportError, OSError):
docs/research/2026-11-14-use-acceptance/live-service/resolver-mutants.txt:9:M7 is an equivalent mutant: view_bundle ends by calling not_judged, which raises the same refusal, so removing view_bundle's early check

codex
**Not yet.** The search plan departs from row 4a in how it identifies existing stores, and it does not yet say who refreshes the index after startup.

1. **The fallback identity is not a replacement check.** A path and first step can be the same for two different stores. Calling an existing store “never replaced” would bypass row 4a’s requirement to reject both staged and published vectors from a different store. Define a safe identity or a conservative fallback for stores without the new identifier, and test replacement at the same path with the same first step. [Row 4a](/Users/lchingen/hivemind/docs/research/2026-11-14-use-acceptance/live-service/OPERATING-CONTRACT.md:85).

2. **Name the refresh owner after the first day.** The proposal refreshes at API and MCP startup, but row 4a also requires publication after later completed days. Specify what triggers that refresh, how the first-day-started service begins indexing after its first completion, and what search reports while publication is pending or fails. Test those transitions through the entry points. [Index contract](/Users/lchingen/hivemind/docs/research/2026-11-14-use-acceptance/live-service/OPERATING-CONTRACT.md:87).

3. **Keep the other search caller in scope for compatibility.** `store.search_views` is also used by production matching. Leaving it in place avoids changing that caller, but the census and tests should establish that its behavior and the frozen matching path remain unchanged. The standalone `search_eval` script also calls `build_index` directly and needs the new arguments or an explicitly compatible interface. [Matching caller](/Users/lchingen/hivemind/src/hivemind/views/matching.py:134), [search evaluator](/Users/lchingen/hivemind/scripts/search_eval.py:43).

Slice 2’s code and tests show the pinned ledger connections and pre-header refusals. One evidence qualification: the overlapping-search test exercises the MCP connection context and search function in threads; it is not itself two calls through the MCP transport. I did not rerun the suites. [Live-read tests](/Users/lchingen/hivemind/tests/test_live_reads.py:135).

CONSENSUS: no, because existing-store identity and the post-startup index refresh need a reviewed contract before slice 3 is built.
