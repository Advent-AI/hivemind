    66	    def __init__(self, read_only=False):
    67	        self.read_only = read_only
    68	
    69	    def __enter__(self):
    70	        self.ledger = self.index = self.items = self.archive = None
    71	        try:
    72	            self.ledger = service.open_ledger(PATHS['views'])
    73	            self.ledger.execute('begin')
    74	            self.ledger.execute('select 1 from sqlite_master limit 1').fetchone()
    75	            self.index = None if self.read_only else search.open_index(PATHS['index'])
    76	            self.items = store.open_read_only(PATHS['items']) if PATHS.get('items') and os.path.exists(PATHS['items']) else None
    77	            self.archive = None if self.read_only else model.Archive(PATHS['archive'])
    78	        except BaseException:
    79	            self._close()
