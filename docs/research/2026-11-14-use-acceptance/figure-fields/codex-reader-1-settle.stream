, (2, 'consensus EPS estimate (current)', '$15.68 per share', 'estimate', 'consensus')] | none\nANSWER B19 6\nev-1 | NVIDIA | None | [(1, 'revenue', '$96.22 billion', 'actual', 'NVIDIA'), (2, 'revenue growth year over year', '105.85%', 'actual', 'NVIDIA'), (3, 'non-GAAP EPS', '$2.22', 'actual', 'NVIDIA'), (4, 'Data Center revenue', '$89.023 billion', 'actual', 'NVIDIA')] | none\nev-2 | NVIDIA | None | [(1, 'revenue guidance', '$108 billion', 'guidance', 'NVIDIA')] | [{'question': 'clean-3', 'new_question': False, 'reason': \"NVIDIA's Q3 fiscal 2027 guidance excludes China Data Center compute revenue on geopolitical uncertainty, i.e. China data-center compute revenue was not assumed to resume in the guided quarter; this bears on whether NVIDIA's current-generation chips can be sold into China by the end of fiscal 2027.\"}]\nev-3 | NVIDIA | None | [(1, 'gross margin', '71% to 72%', 'guidance', 'NVIDIA'), (2, 'gross margin', '72% to 73%', 'guidance', 'NVIDIA')] | none\nev-4 | 24/7 Wall St. | 2026-09-23 | [(1, 'supply commitments', '$279 billion', 'actual', '24/7 Wall St.'), (2, 'guarantee obligations (capped)', '$108.5 billion', 'actual', '24/7 Wall St.'), (3, 'days sales outstanding (DSO)', '60 days', 'actual', '24/7 Wall St.')] | [{'question': 'clean-2', 'new_question': False, 'reason': \"States supply commitments of $279 billion, a reported baseline for the purchase/supply commitment amount the thesis tracks at NVIDIA's next annual report; the figure is the article's, not a citation to a filing.\"}, {'question': 'clean-1', 'new_question': False, 'reason': \"States guarantee obligations capped at $108.5 billion, addressing the amount of guarantees/credit support the thesis tracks at NVIDIA's next annual report; the figure is the article's characterisation and not a filing citation.\"}]\nev-5 | Jensen Huang (NVIDIA) | None | [(1, 'share of demand NVIDIA can supply', '70%', 'actual', 'Jensen Huang'), (2, 'growth', 'approximately 70%', 'estimate', 'Jensen Huang')] | non