,\"value\":\"right\",\"original_party\":\"right\",\"date\":\"unknown_ok\",\"own\":true,\"revenue_or_margin\":false,\"note\":\"\"}\n{\"entry\":25,\"measure\":\"right\",\"basis\":\"right\",\"period\":\"right\",\"kind\":\"right\",\"value\":\"right\",\"original_party\":\"right\",\"date\":\"unknown_ok\",\"own\":true,\"revenue_or_margin\":true,\"note\":\"\"}\n{\"entry\":26,\"measure\":\"right\",\"basis\":\"wrong\",\"period\":\"right\",\"kind\":\"right\",\"value\":\"right\",\"original_party\":\"wrong\",\"date\":\"right\",\"own\":true,\"revenue_or_margin\":false,\"note\":\"The article reports the projection but does not identify it as a consensus estimate.\"}\n{\"entry\":27,\"measure\":\"right\",\"basis\":\"right\",\"period\":\"right\",\"kind\":\"right\",\"value\":\"right\",\"original_party\":\"right\",\"date\":\"unknown_ok\",\"own\":true,\"revenue_or_margin\":false,\"note\":\"\"}\n{\"entry\":28,\"measure\":\"right\",\"basis\":\"right\",\"period\":\"right\",\"kind\":\"right\",\"value\":\"right\",\"original_party\":\"right\",\"date\":\"unknown_ok\",\"own\":true,\"revenue_or_margin\":true,\"note\":\"\"}\n{\"entry\":29,\"measure\":\"right\",\"basis\":\"right\",\"period\":\"right\",\"kind\":\"right\",\"value\":\"right\",\"original_party\":\"unknown_ok\",\"date\":\"unknown_ok\",\"own\":true,\"revenue_or_margin\":false,\"note\":\"\"}\n{\"entry\":30,\"measure\":\"right\",\"basis\":\"right\",\"period\":\"right\",\"kind\":\"right\",\"value\":\"right\",\"original_party\":\"right\",\"date\":\"missing\",\"own\":true,\"revenue_or_margin\":true,\"note\":\"The article places the related second-quarter earnings release in late August.\"}\n{\"entry\":31,\"measure\":\"right\",\"basis\":\"right\",\"period\":\"right\",\"kind\":\"right\",\"value\":\"right\",\"original_party\":\"right\",\"date\":\"right\",\"own\":true,\"revenue_or_margin\":true,\"note\":\"\"}\n{\"entry\":32,\"measure\":\"right\",\"basis\":\"right\",\"period\":\"right\",\"kind\":\"right\",\"value\":\"right\",\"original_party\":\"