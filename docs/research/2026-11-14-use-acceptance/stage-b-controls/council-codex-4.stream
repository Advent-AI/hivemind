   114	def split_rows_present(conn):
   115	    """Whether a store holds the period split's yearly rows (splitting/DESIGN.md v4 §0c): the frozen Stage B accounting and research
   116	    readers refuse such a store by name. A historical store without the `period` column holds none."""
   117	    columns = {row[1] for row in conn.execute('pragma table_info(clean_ladders)')}
   118	    return 'period' in columns and conn.execute("select 1 from clean_ladders where period != '' limit 1").fetchone() is not None
