   322	def write_view(ladder, passage, *, thesis, article_day, company, research_list):
   323	    """The view an accepted ladder is written as: its object, kind, focus, question, year, due day and its rungs in position
   324	    order, each with the label and condition the judge is shown and, for a figure, its bounds as floats."""
   325	    object_id = research_list.resolve(ladder['object'])
   326	    object_kind = research_list.kind(object_id)
   327	    reference = ladder.get('reference')
   328	    reference_status = None
   329	    if ladder.get('event') is not None:
   330	        rungs = event_rungs(ladder['event'], ladder['due_day'], article_day)
   331	        year = ladder['due_day'][:4]
   332	    else:
   333	        figure = ladder['figure']
   334	        ascending = sorted_ranges(figure['ranges'])
   335	        middle_text_suffix = ' (no reference figure when the question opened)'
   336	        reference_status = 'no reference figure'
   337	        if reference is not None and reference['value'] is not None:
   338	            if reference['kind'] == 'last_reported':             # D411: named as that, never as what the market expects
   339	                middle_text_suffix = f' (the amount last reported when the question opened: "{passage}")'
   340	                reference_status = 'last reported figure'
   341	            else:
   342	                middle_text_suffix = f' (the reference when the question opened: "{passage}")'
   343	                reference_status = 'reference figure'
   344	        in_position_order = list(reversed(ascending)) if (object_kind == 'company' and figure['favourable_end'] == 'higher') else ascending
   345	        rungs = []
   346	        for position, bounds in enumerate(in_position_order, start=1):
   347	            condition = interval_text(bounds['lo'], bounds['hi'], figure['unit'])
   348	            label = COMPANY_LABELS[position - 1] if object_kind == 'company' else condition
   349	            if bounds is ascending[2]:
   350	                condition += middle_text_suffix
   351	            rungs.append({'label': label, 'condition': condition,
   352	                          'lo': None if bounds['lo'] is None else float(bounds['lo']), 'hi': None if bounds['hi'] is None else float(bounds['hi'])})
   353	        year = figure['year']
   354	    return {'object_id': object_id, 'object_kind': object_kind, 'kind': 'asset' if object_kind == 'company' else 'theme',
   355	            'looks_at': thesis['outcome'], 'question': ladder['question'], 'due_day': due_day_of(ladder, object_kind, object_id, research_list),
   356	            'year': year, 'rungs': rungs,

