    89	                               'answer': {'rung': row['rung'], 'rung_label': labels[row['rung']], 'reference': row['reference'], 'implied_outcome': row['implied_outcome'],
    90	                                          'reasons': row['reasons'], 'changed': bool(row['changed']), 'why_changed': row['why_changed']},
    91	                               'not_shown': not_shown_of(library, view_id, row['seq'], judging.evidence_shown_in(request_text))})
