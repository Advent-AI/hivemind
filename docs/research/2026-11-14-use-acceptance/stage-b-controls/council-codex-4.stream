   101	def agrees(record):
   102	    """The frozen scorer's comparison by outcome; None when it cannot be made (no judgement, no gold, a figure with no bounds)."""
   103	    if record['last_judgement'] is None or record['gold_open']:
   104	        return None
   105	    chosen = record['rungs'][record['last_judgement']['rung'] - 1]
   106	    implied = record['gold_answer']
   107	    if record['ruler']['unit'] == 'yes/no':
   108	        return (chosen['label'].lower() == 'yes') == bool(implied['yes_no'])
   109	    if chosen['lo'] is None and chosen['hi'] is None:
   110	        return None
   111	    return (chosen['lo'] is None or implied['high'] >= chosen['lo']) and (chosen['hi'] is None or implied['low'] < chosen['hi'])
   112	
   137	def row_problem(row, item_ids):
   138	    if set(row) != {'control', 'same_question', 'same_due', 'items', 'why'}:
   139	        return f'fields {sorted(row)}'
   140	    if row['same_question'] not in YES_NO or row['same_due'] not in YES_NO:
   141	        return 'same_question and same_due are "yes" or "no"'
   142	    if not isinstance(row['items'], dict) or set(row['items']) != set(item_ids) or any(mark not in ITEM_MARKS for mark in row['items'].values()):
   143	        return f'items must mark exactly {sorted(item_ids)}, each "shown" or "not_shown"'
   144	    if not isinstance(row['why'], str) or not row['why'].strip():
   145	        return 'no why'
   146	    return None

