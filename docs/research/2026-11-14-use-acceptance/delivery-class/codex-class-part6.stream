":null,\"v3\":null,\"v4\":null,\"v5\":null,\"v6\":null,\"v7\":null}\n{\"statement\":\"e560\",\"v1\":null,\"v2\":null,\"v3\":null,\"v4\":null,\"v5\":null,\"v6\":null,\"v7\":null}\n{\"statement\":\"e561\",\"v1\":null,\"v2\":null,\"v3\":null,\"v4\":null,\"v5\":null,\"v6\":null,\"v7\":null}\n{\"statement\":\"e562\",\"v1\":null,\"v2\":null,\"v3\":null,\"v4\":null,\"v5\":null,\"v6\":null,\"v7\":null}\n{\"statement\":\"e563\",\"v1\":null,\"v2\":null,\"v3\":null,\"v4\":null,\"v5\":null,\"v6\":null,\"v7\":null}\n{\"statement\":\"e564\",\"v1\":null,\"v2\":null,\"v3\":null,\"v4\":null,\"v5\":null,\"v6\":null,\"v7\":null}\n{\"statement\":\"e565\",\"v1\":null,\"v2\":null,\"v3\":\"The United States permitted H200 exports for a fee, supporting yes modestly by showing willingness to authorize some NVIDIA AI chips for China.\",\"v4\":null,\"v5\":null,\"v6\":null,\"v7\":null}\n{\"statement\":\"e566\",\"v1\":null,\"v2\":null,\"v3\":\"Chinese regulators mostly blocked H200 imports despite U.S. approval, weakening yes because Chinese permission is also required for Blackwell shipments.\",\"v4\":null,\"v5\":null,\"v6\":null,\"v7\":\"Chinese regulators mostly blocked NVIDIA H200 imports, modestly weakening yes by showing resistance to some NVIDIA chip purchases despite U.S. permission.\"}\n{\"statement\":\"e567\",\"v1\":null,\"v2\":null,\"v3\":null,\"v4\":null,\"v5\":null,\"v6\":null,\"v7\":null}"}}
