"""The due-day probe at $0 (council round 20): the check, the four arm-draws through the real runner and limit with a fake transport,
the v2 requests carrying the changed clause and nothing else, and the verdict fixed before."""
import json
import sys
from pathlib import Path

import pytest

HERE = Path(__file__).resolve().parent
sys.path[:0] = [str(HERE), str(HERE.parent / 'astra'), str(HERE.parent / 'model'), str(HERE.parent / 'effort')]
import dueday_probe as probe  # noqa: E402
import refcontrol  # noqa: E402

USAGE = {'prompt_tokens': 2000, 'completion_tokens': 400}      # about astra's measured $0.04 a send


def transport():
    stored = {case['thesis']['description']: row['requests'][-1]['answer_text'] for _, _, case, row in refcontrol.population()}
    systems = []

    def send(provider, request):
        systems.append(request['messages'][0]['content'])
        user = request['messages'][1]['content']
        text = next(answer for description, answer in stored.items() if json.dumps(description, ensure_ascii=False)[1:-1] in user)
        return {'choices': [{'message': {'content': text}}], 'usage': USAGE}
    send.systems = systems
    return send


@pytest.fixture(scope='module')
def run(tmp_path_factory):
    folder = tmp_path_factory.mktemp('dueday')
    original, probe.RECORD = probe.RECORD, folder / 'check-passed.json'
    try:
        probe.check()
        fake = transport()
        probe.send(folder / 'run', transport=fake)
        yield folder, fake
    finally:
        probe.RECORD = original


def test_each_arm_sends_its_own_system_text_and_nothing_else_differs(run):
    _, fake = run
    frozen = [text for text in fake.systems if probe.FROZEN_CLAUSE in text]
    changed = [text for text in fake.systems if probe.V2_CLAUSE in text]
    assert len(frozen) >= 18 and len(changed) >= 18 and len(frozen) + len(changed) == len(fake.systems)
    assert {text.replace(probe.V2_CLAUSE, probe.FROZEN_CLAUSE) for text in changed} == set(frozen)


def test_the_check_refuses_a_v2_text_that_changes_more_than_the_clause(tmp_path, monkeypatch):
    edited = tmp_path / 'v2.txt'
    edited.write_text(probe.V2_SYSTEM.read_text().replace('Write in English.', 'Write in plain English.'))
    monkeypatch.setattr(probe, 'V2_SYSTEM', edited)
    monkeypatch.setattr(probe, 'RECORD', tmp_path / 'check-passed.json')
    with pytest.raises(SystemExit, match='CHECK FAILED'):
        probe.check()


def rewrite(folder, changes):
    """Copy the run and set the due day (or a decline) of the arm-draw and topic given."""
    import shutil
    copy = folder.parent / (folder.name + '-copy')
    shutil.rmtree(copy, ignore_errors=True)
    shutil.copytree(folder / 'run', copy)
    for (arm_draw, topic), day in changes.items():
        path = copy / arm_draw / 'outcomes.jsonl'
        rows = [json.loads(line) for line in path.read_text().splitlines()]
        for row in rows:
            if row['case'] == f'{arm_draw}|{topic}':
                if day == 'decline':
                    row.update(status='no ladder', answer=None, view=None, passage=None)
                else:
                    row['answer']['ladder']['due_day'] = day
        path.write_text(''.join(json.dumps(row) + '\n' for row in rows))
    return copy


HF, HF_WEEK = 'fortnight:c1/clean-6', 'week-10-06:c1/clean-5'
FIXED = {('frozen-d1', HF): '2027-02-28', ('v2-d1', HF): '2028-03-24', ('v2-d2', HF): '2028-03-24',
         ('v2-d1', HF_WEEK): '2027-06-30', ('v2-d2', HF_WEEK): '2027-06-30'}


def test_a_fixed_completion_with_every_control_kept_moves(run):
    folder, _ = run
    copy = rewrite(folder, FIXED)
    verdict, _ = probe.tally(copy)
    assert verdict == 'moves'


def test_a_completion_still_at_the_annual_filing_closes(run):
    folder, _ = run
    copy = rewrite(folder, FIXED | {('v2-d2', HF): '2027-02-28'})
    assert probe.tally(copy)[0] == 'closes'


def test_an_amount_control_moved_off_the_annual_filing_closes(run):
    folder, _ = run
    copy = rewrite(folder, FIXED | {('v2-d1', 'fortnight:c1/clean-2'): '2027-07-31'})
    assert probe.tally(copy)[0] == 'closes'


def test_a_new_decline_in_the_changed_arm_closes(run):
    folder, _ = run
    copy = rewrite(folder, FIXED | {('v2-d1', 'fortnight:c1/clean-7'): 'decline'})
    assert probe.tally(copy)[0] == 'closes'


def test_no_annual_filing_date_in_the_frozen_arm_is_inconclusive(run):
    folder, _ = run
    copy = rewrite(folder, {key: day for key, day in FIXED.items() if key[0] != 'frozen-d1'} | {('frozen-d1', HF): '2028-03-24',
                                                                                              ('frozen-d2', HF): '2028-03-24'})
    assert probe.tally(copy)[0].startswith('inconclusive')

 succeeded in 0ms:
"""The due-day probe (council rounds 19 and 20): astra on the frozen request against astra on the request whose binding-obligation clause
is narrowed to amounts (`candidate-system-v2.txt`), on nine topics covering the due-day cases, two interleaved draws each.

  python3 dueday_probe.py check                  # $0: the requests differ only in the clause; spend; writes check-passed.json
  python3 dueday_probe.py send <new run folder>  # frozen d1, v2 d1, frozen d2, v2 d2
  python3 dueday_probe.py tally <run folder>     # each topic's due days and bases per arm, declines, and the verdict fixed before
"""
import collections
import dataclasses
import hashlib
import json
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent
sys.path[:0] = [str(HERE.parent / 'astra')]
import astra_probe as base  # noqa: E402   (Stage A's runner, the limit, the breach guard, the population)
from astra_probe import budget, model, probe_split, refcontrol, stage_a  # noqa: E402

FROZEN_CLAUSE = 'for an obligation already taken on, its next annual filing;'
V2_CLAUSE = 'for the amount of an obligation already taken on, its next annual filing;'
V2_SYSTEM = HERE / 'candidate-system-v2.txt'
ASTRA = dataclasses.replace(stage_a.SETTING, model='gpt-6-astra')
ARMS = ('frozen', 'v2')
ORDER = [('frozen', 1), ('v2', 1), ('frozen', 2), ('v2', 2)]
CAP_USD = 3.20                     # both arms, 36 sends at about $0.04 measured; about $5.3 remains of D439's $40
WORKERS = 1
RECORD = HERE / 'check-passed.json'
TOPICS = {   # topic: the case it covers and the due day each arm must give (`stated`, `period_end`, `annual_filing` or `any`)
    'fortnight:c1/clean-6': ('a signed deal completing, stated check date 24 March 2028', '2028-03-24'),
    'week-10-06:c1/clean-5': ('the same deal, its closing window the first half of 2027', '2027-06-30'),
    'fortnight:c1/clean-12': ('a guarantee becoming final, stated check date 3 April 2028', '2028-04-03'),
    'fortnight:c1/clean-2': ('purchase commitments: an amount at the next annual filing', 'annual_filing'),
    'week-10-06:c1/clean-1': ('a guarantee amount at the next annual filing', 'annual_filing'),
    'week-10-06:c1/clean-8': ('a loss-coverage amount at the next annual filing', 'annual_filing'),
    'week-10-06:c1/clean-11': ('an unsigned acquisition', 'any'),
    'fortnight:c1/clean-4': ('an event at the fiscal year-end', 'any'),
    'fortnight:c1/clean-7': ('an approval event by a stated day', 'any'),
}
ALLOWED = {   # the outcomes every stored draw gave on the event controls (D629 and both screens, census of 2026-11-16)
    'week-10-06:c1/clean-11': {'decline', '2028-04-10'},
    'fortnight:c1/clean-4': {'2027-01-31', '2027-02-28'},
    'fortnight:c1/clean-7': {'2027-01-31'},
}


def texts_of(arm):
    texts = stage_a.request_texts()
    if arm == 'v2':
        texts = dict(texts, system=V2_SYSTEM.read_text())
    return texts


def population():
    entries = [entry for entry in refcontrol.population() if f'{entry[0]}:{entry[1]}' in TOPICS]
    if len(entries) != len(TOPICS):
        raise SystemExit('a probe topic is not in the population')
    return entries


def built(case, arm, rl):
    texts = texts_of(arm)
    user = base.ladder_step.user_text(stage_a.payload_for(case, rl), texts['closing'])
    return model.build_request(ASTRA, texts['system'], user, texts['schema'], 'clean_ladder', 'openai')


def code_digest():
    return hashlib.sha256(Path(__file__).read_bytes() + V2_SYSTEM.read_bytes()).hexdigest()


def check():
    frozen_text, v2_text = stage_a.request_texts()['system'], V2_SYSTEM.read_text()
    if frozen_text.count(FROZEN_CLAUSE) != 1 or v2_text != frozen_text.replace(FROZEN_CLAUSE, V2_CLAUSE):
        raise SystemExit('CHECK FAILED: the v2 system text is not the frozen one with the one clause changed')
    rl = refcontrol.research_list()
    failures, shas = [], {arm: {} for arm in ARMS}
    for source, name, case, stored in population():
        frozen = built(case, 'frozen', rl)
        luna = model.build_request(stage_a.SETTING, frozen_text, frozen['messages'][1]['content'], stage_a.request_texts()['schema'],
                                   'clean_ladder', 'openai')
        if model.request_identity(luna)[1] != stored['requests'][0]['request_sha256']:
            failures.append(f'{source}:{name}: the frozen request is not the stored one')
        sent_frozen, sent_v2 = json.dumps(frozen, ensure_ascii=False), json.dumps(built(case, 'v2', rl), ensure_ascii=False)
        if sent_v2 != sent_frozen.replace(FROZEN_CLAUSE, V2_CLAUSE):
            failures.append(f'{source}:{name}: the v2 request differs in more than the clause')
        for arm in ARMS:
            shas[arm][f'{source}:{name}'] = model.request_identity(built(case, arm, rl))[1]
    worst = max(budget.worst_cost(built(case, 'frozen', rl)) for *_, case, _ in population())
    print(f'{len(TOPICS)} topics; the requests are the stored frozen ones and differ only in the clause: {not failures}; '
          f'worst-case reserve of one attempt ${worst:.2f}; cap ${CAP_USD:.2f}')
    if failures:
        raise SystemExit(f'CHECK FAILED: {failures}')
    RECORD.write_text(json.dumps({'code_sha256': code_digest(), 'requests': shas}, indent=1) + '\n')
    print('check passed')


def send(folder, *, transport=None):
    record = json.loads(RECORD.read_text()) if RECORD.exists() else None
    if record is None or record['code_sha256'] != code_digest():
        raise SystemExit('no check record for these files: run `check` first')
    rl = refcontrol.research_list()
    entries = population()
    for arm in ARMS:
        if {f'{s}:{n}': model.request_identity(built(c, arm, rl))[1] for s, n, c, _ in entries} != record['requests'][arm]:
            raise SystemExit('REFUSED: the requests differ from the checked record')
    folder, guard = Path(folder), probe_split.BreachGuard(transport)
    spent = 0.0
    original = stage_a.request_texts
    try:
        for arm, draw in ORDER:
            stage_a.request_texts = lambda arm=arm: texts_of_frozen_or_v2(original, arm)
            cases = [dict(case, case=f'{arm}-d{draw}|{source}:{name}') for source, name, case, _ in entries]
            written, limit = base.run_arm(cases, folder / f'{arm}-d{draw}', CAP_USD - spent, ASTRA, rl, transport=guard, workers=WORKERS)
            known, in_full, _ = stage_a.ledger_total(folder / f'{arm}-d{draw}' / 'spend.jsonl')
            spent += known + in_full
            over = probe_split.over_reserve(folder / f'{arm}-d{draw}' / 'spend.jsonl')
            print(f'{arm} d{draw}: {len(written)} of {len(entries)} written; spent ${known + in_full:.4f}; over reserve {len(over)}', flush=True)
            if over or guard.breaches or limit.stopped or len(written) != len(entries):
                raise SystemExit(f'{arm} d{draw} STOPPED: {limit.stop_reason or over or guard.breaches}. NOT MEASURED.')
    finally:
        stage_a.request_texts = original
    print(f'spent ${spent:.4f}')


def texts_of_frozen_or_v2(original, arm):
    texts = original()
    return dict(texts, system=V2_SYSTEM.read_text()) if arm == 'v2' else texts


def day_class(row, expected):
    """What a written due day is against the topic's expected one: `expected`, `annual_filing` (a day in February or March of 2027),
    `other`, or `decline`."""
    if row['status'] != 'ladder':
        return 'decline'
    day = row['answer']['ladder']['due_day']
    if day == expected:
        return 'expected'
    return 'annual_filing' if day[:7] in ('2027-02', '2027-03') else 'other'


def tally(folder):
    rows = {}
    for arm, draw in ORDER:
        for line in (Path(folder) / f'{arm}-d{draw}' / 'outcomes.jsonl').read_text().splitlines():
            row = json.loads(line)
            rows[row['case']] = row
    table, declines = {}, collections.Counter()
    for topic, (_, expected) in TOPICS.items():
        for arm in ARMS:
            classes = []
            for draw in (1, 2):
                row = rows[f'{arm}-d{draw}|{topic}']
                if expected == 'annual_filing':
                    classes.append('decline' if row['status'] != 'ladder' else
                                   ('expected' if row['answer']['ladder']['due_day'][:7] in ('2027-02', '2027-03') else 'other'))
                elif expected == 'any':
                    classes.append('decline' if row['status'] != 'ladder' else row['answer']['ladder']['due_day'])
                else:
                    classes.append(day_class(row, expected))
                declines[arm] += row['status'] != 'ladder'
            table[(topic, arm)] = classes
    hf_fixed = table[('fortnight:c1/clean-6', 'v2')] == ['expected', 'expected'] and \
        table[('week-10-06:c1/clean-5', 'v2')].count('expected') == 2
    mechanism_seen = 'annual_filing' in table[('fortnight:c1/clean-6', 'frozen')]
    controls_kept = all(table[(topic, 'v2')] == ['expected', 'expected'] for topic, (_, expected) in TOPICS.items()
                        if expected in ('annual_filing', '2028-04-03'))
    events_kept = all(set(table[(topic, 'v2')]) <= ALLOWED[topic] for topic in ALLOWED)
    no_new_decline = declines['v2'] <= declines['frozen']
    if not mechanism_seen:
        verdict = 'inconclusive (the frozen arm did not date the signed completion at the annual filing: no mechanism to fix)'
    elif hf_fixed and controls_kept and events_kept and no_new_decline:
        verdict = 'moves'
    else:
        verdict = 'closes'
    for (topic, arm), classes in table.items():
        print(f'{topic:24} {arm:6} {classes}')
    print(f'declines {dict(declines)}')
    print(f'VERDICT: {verdict}')
    return verdict, table


if __name__ == '__main__':
    command = sys.argv[1] if len(sys.argv) > 1 else ''
    if command == 'check':
        check()
    elif command == 'send':
        send(sys.argv[2])
    elif command == 'tally':
        tally(sys.argv[2])
    else:
        sys.exit(__doc__)

 succeeded in 0ms:
The proposed change removes the instruction to use the annual filing date for a signed deal’s **completion**. The unchanged reader brief still applies that instruction, so it can mark the proposed answer as wrong.

**Request audit**

| Sentence or clause | Verdict against the cited standard |
|---|---|
| The question must be resolvable on its due date; the day must follow the item and be on or after the settling material’s publication. | **Consistent** with the [design table](/Users/lchingen/hivemind/clean-arch/step4-2026-11-10/DESIGN.md:285). |
| For a figure, use the stated publication date or `expected_publication` when the model estimates it. | **Contradicts** D414 as a complete instruction for an annual figure: D414 assigns the unstated day to code, although the request tells the model to estimate it. The reader brief describes the code-set day. |
| For an event, use a stated date or the named period’s last day, with fiscal year-end for an undated pending regulatory decision. | **Consistent** with D403. |
| Proposed binding-obligation clause: within 548 days; an **amount** already taken on uses the next annual filing; an unsigned obligation uses its signing-check day. | **Consistent** with D210 and D185, provided the signing-check day also satisfies D403’s stated-date or period-end rule. |
| Frozen clause: an **obligation** already taken on uses the next annual filing. | **Keeps wider** than D210: it also covers an event asking whether a signed deal completes. It conflicts with D403 when that event has a different stated date or period end. |
| System and schema refusal when an event has neither a date nor a period, except for the pending-regulatory case. | **Consistent** with D403. The schema’s figure exclusions are also consistent with D414’s limit on the annual-figure rule. |
| Schema `due_day_basis`: `stated` or `period_end` for events; `stated` or `expected_publication` for figures. | **Consistent** as labels, but it does not itself explain D414’s code-set day for annual figures. |
| Closing check: the event’s outcomes must be checkable on the due day, and the due day must follow the rules above. | **Consistent**, but it repeats the request’s rules and does not resolve the annual-figure inconsistency. |

The decisions are in [D185, D210, D403 and D414](/Users/lchingen/hivemind/docs/DECISIONS-log.md:2472).

**Cases**, assuming each date is after the item and within the 548-day limit:

- Signed acquisition, stated check date: **proposed:** stated date; **frozen:** annual filing clause competes with that date.
- Same acquisition, period only: **proposed:** period end; **frozen:** annual filing clause competes with period end.
- Purchase-commitment amount at the next annual filing: **both:** next annual filing; an unstated annual-figure date is subject to D414’s code rule.
- Unsigned deal’s signing: **both:** stated signing-check date or the named period’s end; neither permits an invented event date.
- Guarantee becoming final, stated date: **proposed:** stated date; **frozen:** if the obligation is already taken on, its annual-filing clause competes with that date.

No remaining proposed sentence directs signed-deal completion to the annual filing. The change leaves **no day-selection gap**: the general event rule supplies the stated date or period end, and an event with neither is declined. A date beyond 548 days creates a constraint conflict, not permission to invent another day.

The [reader brief’s D row](/Users/lchingen/hivemind/clean-arch/step4-2026-11-10/ladder/stage-a-reader-brief.md:98) still says **any** obligation already taken on is due at the next annual filing. Thus it can fail the proposed stated-date or period-end answer for signed-deal completion—and for an already-taken-on guarantee becoming final—when that day differs from the filing date.

NOT CONSISTENT: the unchanged reader brief applies the annual-filing rule more broadly than the proposed request, and the request’s annual-figure estimate instruction conflicts with D414.
