{"item": 19, "topic": {"description": "What total of credit support and minimum-revenue guarantees to AI labs and cloud partners will NVIDIA disclose at its next annual report?", "outcome": "The disclosed amount of guarantees, credit-support commitments and revenue backstops NVIDIA has extended to AI labs and cloud partners (including the credit support for nearly 2 gigawatts of computing capacity for one additional AI lab), versus the equity investments it has made, at NVIDIA's next annual report.", "period": "Fiscal 2027 annual report (fiscal year ending late January 2027; Form 10-K expected around February 2027) — set as the next annual report following this 22 September 2026 item, per section 3 (obligation already undertaken tracked by its amount at the next annual report; the additional AI lab's credit support is not yet signed and is checked within 18 months).", "settled_by": "NVIDIA's Form 10-K for fiscal 2027 (guarantees, commitments and contingencies note) and any 8-K or earnings disclosure quantifying the credit support for the additional AI lab's ~2 GW of computing capacity and the minimum-revenue guarantees to cloud partners."}, "answer": {"question": "What total amount in USD of guarantees, credit-support commitments and minimum-revenue backstops extended to AI labs and cloud partners will NVIDIA disclose as outstanding at FY2027 year-end, as established by its FY2027 Form 10-K commitments and contingencies disclosures and any accompanying quantifying earnings or 8-K disclosures?", "object": "NVDA", "not_judged": [{"part": "The equity investments NVIDIA has made and the comparison with those investments.", "why": "The tracked figure is NVIDIA's guarantee and credit-support exposure, not its equity investments or a ratio comparing the two."}, {"part": "The nearly 2 gigawatts of computing capacity associated with credit support for the additional AI lab.", "why": "Computing capacity is not the tracked dollar amount, although any disclosed outstanding credit-support commitment for that lab is included in the total."}, {"part": "Whether and when the additional AI lab's unsigned credit-support arrangement is signed within 18 months.", "why": "Signing is not judged as a separate event because the topic tracks the amount outstanding at the next annual report's fiscal year-end."}], "event": null, "figure": {"unit": "USD", "year": "FY2027", "ranges": [{"lo": null, "hi": "5000000000"}, {"lo": "5000000000", "hi": "10000000000"}, {"lo": "10000000000", "hi": "20000000000"}, {"lo": "20000000000", "hi": "40000000000"}, {"lo": "40000000000", "hi": null}], "favourable_end": "lower", "favourable_why": "Lower commitments reduce NVIDIA's contingent payment exposure, while the item describes both commercial benefits and financing risks rather than establishing that larger obligations are better."}, "reference": null, "due_day": "2027-02-28", "due_day_basis": "expected_publication"}, "passage": null}
{"item": 20, "topic": {"description": "Will NVIDIA's next-generation Vera Rubin AI platform, which the company says has entered full production, reach volume customer shipments (first revenue recognition) by the end of fiscal 2027?", "outcome": "Whether Vera Rubin moves from full production to volume customer shipments and first revenue recognition within NVIDIA's fiscal 2027, as shown in the company's quarterly results and Form 10-K.", "period": "NVIDIA fiscal year ending late January 2027 (FY2027), checked at NVIDIA's quarterly results and FY2027 Form 10-K. The item gives no shipment date; the current fiscal year-end following the September 2026 report that Vera Rubin entered full production is used as the check date.", "settled_by": "NVIDIA quarterly earnings releases and Form 10-K/10-Q disclosures showing Vera Rubin shipments and revenue timing."}, "answer": {"question": "Will NVIDIA reach its first revenue recognition from Vera Rubin customer shipments by January 31, 2027, the end of FY2027, as confirmed by NVIDIA earnings releases or Form 10-Q/10-K disclosures available by that date?", "object": "NVDA", "not_judged": [{"part": "Vera Rubin has entered full production.", "why": "The reported production status is the starting point, not the tracked milestone of revenue-generating customer shipments."}, {"part": "The scale of 'volume' customer shipments.", "why": "The topic identifies first revenue recognition as the shipment milestone and supplies no separate shipment-volume threshold."}], "event": {"happened": "By January 31, 2027, NVIDIA's published earnings releases or Form 10-Q/10-K disclosures confirm that it has first recognized revenue from Vera Rubin customer shipments during FY2027.", "ruled_out": {"by_whom": "NVIDIA", "decision": "After September 23, 2026, and by January 31, 2027, NVIDIA formally abandons the Vera Rubin commercial rollout or decides to defer all revenue-generating Vera Rubin customer shipments until after FY2027."}}, "figure": null, "reference": null, "due_day": "2027-01-31", "due_day_basis": "period_end"}, "passage": null}
