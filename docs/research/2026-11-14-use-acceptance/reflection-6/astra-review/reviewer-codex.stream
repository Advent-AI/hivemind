{"i": 28, "t": {"description": "Will Nvidia's Groq 3 LPX rack-scale LPU system — the first product built on the Groq technology it paid about $20 billion to license and staff — reach volume shipments and commercial scale in the quarter Nvidia describes (its fiscal Q3 FY2027), or slip?", "outcome": "Whether Groq 3 LPX volume shipments occur 'later this quarter' as Nvidia stated, and whether the system begins contributing to reported data center revenue or slips into fiscal Q4 FY2027/calendar 2027.", "period": "Check date: Nvidia's fiscal Q3 FY2027 report (~November 2026) confirming shipments in the quarter Nvidia described in the Oct. 8, 2026 item; if unconfirmed there, the fiscal Q4 FY2027 report (~February 2027) fixes the slip.", "settled_by": "Nvidia's fiscal Q3 FY2027 quarterly report and earnings call (product shipment and revenue disclosure for Groq 3 LPX), plus any shipment/availability confirmation from Nvidia or its system partners."}, "q": "Did Nvidia begin volume shipments of Groq 3 LPX during fiscal Q3 FY2027, as established by its quarterly report, earnings call or shipment confirmations from Nvidia or its system partners available by November 30, 2026?", "n": ["Whether Groq 3 LPX reaches commercial scale.", "Whether Groq 3 LPX begins contributing to reported Data Center revenue.", "Whether delayed shipments begin in fiscal Q4 FY2027 or calendar 2027, including confirmation in the fiscal Q4 report."], "e": {"happened": "Nvidia's fiscal Q3 FY2027 report or earnings call, or a shipment confirmation from Nvidia or its system partners available by November 30, 2026, establishes that Groq 3 LPX volume shipments began during fiscal Q3 FY2027; full production or sample shipments alone do not qualify.", "ruled_out": {"by_whom": "Nvidia", "decision": "After October 8, 2026, Nvidia formally cancels the Groq 3 LPX volume-shipment launch for fiscal Q3 FY2027 or decides to defer all volume shipments until after that quarter."}}, "f": null, "d": "2026-11-30", "p": "volume shipments expected later this quarter"}
{"i": 29, "t": {"description": "What will the hourly spot rental price for Nvidia B200 GPUs be at the end of calendar 2026, after more than doubling from March 2026 to October 2026?", "outcome": "The hourly spot rental price for Nvidia B200 GPUs at year-end 2026 and whether it remains above its March 2026 level.", "period": "Calendar 2026, settled by Ornn's published GPU rental index releases through year-end 2026 (the Oct. 10, 2026 article gives the March-to-October 2026 move).", "settled_by": "Ornn's published hourly GPU rental index for Nvidia B200 chips, including its releases through year-end 2026."}, "q": "What will the hourly spot rental price of one Nvidia B200 GPU be, in USD per GPU-hour, at December 31, 2026, as measured by the latest observation dated on or before that day in Ornn's published GPU rental index?", "n": ["The price more than doubled from March 2026 to October 2026.", "Whether the year-end price remains above its March 2026 level."], "e": null, "f": {"unit": "other", "year": "2026", "ranges": [{"lo": null, "hi": "2"}, {"lo": "2", "hi": "4"}, {"lo": "4", "hi": "6"}, {"lo": "6", "hi": "8"}, {"lo": "8", "hi": null}], "favourable_end": "n/a", "favourable_why": ""}, "d": "2027-01-15", "p": null}
