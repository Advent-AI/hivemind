{"item": 1, "topic": {"description": "How much will NVIDIA disclose in purchase and supply commitments (obligations to buy capacity, components or services) at its next annual report?", "outcome": "The amount of purchase obligations/supply commitments NVIDIA reports in its contractual obligations and purchase commitment disclosures in the Form 10-K, versus the prior year, given the analyst report that NVIDIA is taking on larger supply commitments.", "period": "Fiscal 2027 annual report (fiscal year ending late January 2027; Form 10-K expected around February 2027) — the next annual report after this 22 September 2026 item, per section 3 (an obligation already undertaken is tracked by its amount at the next annual report).", "settled_by": "NVIDIA's next Form 10-K (fiscal 2027), specifically its purchase obligations / contractual commitments disclosure and related notes."}, "answer": {"question": "What total amount in USD of outstanding purchase obligations and supply commitments will NVIDIA report at FY2027 year-end in its FY2027 Form 10-K purchase obligations, contractual commitments disclosures and related notes?", "object": "NVDA", "not_judged": [{"part": "Comparison with the prior year, including whether supply commitments have increased as the analyst report suggests.", "why": "The tracked outcome is the amount outstanding at FY2027 year-end, not its year-over-year change or separate confirmation of the analyst's directional claim."}], "event": null, "figure": {"unit": "USD", "year": "FY2027", "ranges": [{"lo": null, "hi": "30000000000"}, {"lo": "30000000000", "hi": "50000000000"}, {"lo": "50000000000", "hi": "75000000000"}, {"lo": "75000000000", "hi": "100000000000"}, {"lo": "100000000000", "hi": null}], "favourable_end": "lower", "favourable_why": "Lower purchase and supply commitments reduce NVIDIA's binding payment exposure, and neither the topic nor the item establishes that larger commitments are favourable."}, "reference": null, "due_day": "2027-02-28", "due_day_basis": "expected_publication"}, "passage": null}
