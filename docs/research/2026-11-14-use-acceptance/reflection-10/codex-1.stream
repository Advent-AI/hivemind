     1	"""The comparison's sizing, step 2 ($0; D516): how large a difference between the two systems could a comparison of a given shape detect?
     2	
     3	For each line read as a share (answers supported; questions that are trivia or duplicates) it takes the counts seen so far, the number of
     4	questions each system holds at the end of a week, and a set of comparison shapes (weeks of unread news x draws of each system), and
     5	computes the smallest true difference that a two-sided test at 5% would detect four times in five, under two assumptions about repeated
     6	draws of the same week: that they add nothing (the same questions come back; the independent unit is the week), and that they are as
     7	good as new weeks (an upper bound on what repeats can give). The closed form is checked by simulation for one shape. Costs use the
     8	fresh week's charged prices. Every input is printed with its source; nothing here is a measurement of a system.
     9	
    10	  python3 sizing.py
    11	"""
    12	import math
    13	import random
    14	
    15	# what one week holds, from the fresh week of 2026-09-22..28 (week/WEEK-RESULT.md): questions with a latest answer
    16	PER_WEEK = {'new': 7, 'old': 15}
    17	# charged per week and draw: the new system's ledger $2.52; the old system at listed rates $0.47, rounded up
    18	COST = {'new': 2.52, 'old': 0.50}
    19	# shares seen so far, as (new: hits, of), (old: hits, of), with where they come from
    20	SEEN = {
    21	    'answers supported by both teams': [('July window, trial, one draw each (TRIAL-RESULT.md)', (7, 9), (10, 12)),
    22	                                        ('fresh week, one draw each (WEEK-RESULT.md)', (6, 7), (10, 15))],
    23	    'questions that are trivia or duplicates, both teams': [('fresh week, one draw each (WEEK-RESULT.md)', (1, 7), (6, 15))],
    24	}
    25	SHAPES = [(1, 3), (2, 3), (3, 1), (3, 2), (4, 1), (4, 3)]   # (weeks of unread news, draws of each system)
    26	UNREAD_WEEKS = 3   # 2026-10-06..12, 10-13..19, 10-20..26 are in the article database; the week of 09-29 has 40 articles already read
    27	
    28	
    29	def smallest_detectable(p, n_new, n_old):
    30	    """Two shares near p, two-sided 5%, detected four times in five: 2.8 standard errors."""
    31	    return 2.8 * math.sqrt(p * (1 - p) * (1 / n_new + 1 / n_old))
    32	
    33	
    34	def simulated_power(p_new, p_old, n_new, n_old, runs=20000, seed=20261201):
    35	    rng, hits = random.Random(seed), 0
    36	    for _ in range(runs):
    37	        a = sum(rng.random() < p_new for _ in range(n_new)) / n_new
    38	        b = sum(rng.random() < p_old for _ in range(n_old)) / n_old
    39	        pooled = (a * n_new + b * n_old) / (n_new + n_old)
    40	        se = math.sqrt(max(pooled * (1 - pooled), 1e-9) * (1 / n_new + 1 / n_old))
    41	        hits += abs(a - b) / se > 1.96
    42	    return hits / runs
    43	
    44	
    45	def main():
    46	    print('SEEN SO FAR (one draw each; the two windows are different news)')
    47	    baseline = {}
    48	    for line, rows in SEEN.items():
    49	        hits = sum(new[0] + old[0] for _, new, old in rows)
    50	        of = sum(new[1] + old[1] for _, new, old in rows)
    51	        baseline[line] = hits / of
    52	        for source, new, old in rows:
    53	            print(f'  {line}: new {new[0]} of {new[1]} ({new[0] / new[1]:.0%}), old {old[0]} of {old[1]} ({old[0] / old[1]:.0%}), '
    54	                  f'difference {new[0] / new[1] - old[0] / old[1]:+.0%}  [{source}]')
    55	        print(f'    pooled share {baseline[line]:.0%}')
    56	    print(f"\nPER WEEK (fresh week): questions with a latest answer: new {PER_WEEK['new']}, old {PER_WEEK['old']}; "
    57	          f"charged per week and draw: new ${COST['new']}, old ${COST['old']}; unread weeks in the article database: {UNREAD_WEEKS}")
    58	    print('\nSMALLEST DIFFERENCE A COMPARISON WOULD DETECT (two-sided 5%, four times in five)')
    59	    for weeks, draws in SHAPES:
    60	        cost = weeks * draws * (COST['new'] + COST['old'])
    61	        note = '' if weeks <= UNREAD_WEEKS else '  (needs more unread weeks than the database holds)'
    62	        print(f'  {weeks} week(s) x {draws} draw(s) each, about ${cost:.2f}{note}')
    63	        for line, p in baseline.items():
    64	            floor = smallest_detectable(p, weeks * PER_WEEK['new'], weeks * PER_WEEK['old'])                        # repeats add nothing
    65	            best = smallest_detectable(p, weeks * draws * PER_WEEK['new'], weeks * draws * PER_WEEK['old'])        # repeats as good as new weeks
    66	            print(f'      {line}: {best:.0%} if repeated draws were as good as new weeks; {floor:.0%} if they add nothing')
    67	    p = baseline['answers supported by both teams']
    68	    n_new, n_old = 3 * PER_WEEK['new'], 3 * PER_WEEK['old']
    69	    gap = smallest_detectable(p, n_new, n_old)
    70	    print(f"\nCHECK BY SIMULATION (3 weeks x 1 draw: {n_new} and {n_old} answers; shares {min(p + gap / 2, 0.99):.2f} against {p - gap / 2:.2f}): "
    71	          f"detected in {simulated_power(min(p + gap / 2, 0.99), p - gap / 2, n_new, n_old):.0%} of 20,000 simulated comparisons (the closed form says 80%)")
    72	    print(f"   and a true difference of 10 points on the same shape: detected in {simulated_power(p + 0.05, p - 0.05, n_new, n_old):.0%}; of 20 points: "
    73	          f"{simulated_power(min(p + 0.10, 0.99), p - 0.10, n_new, n_old):.0%}")
    74	
    75	
    76	if __name__ == '__main__':
    77	    main()

