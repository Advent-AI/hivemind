   289	def due_day_of(ladder, object_kind, object_id, research_list):
   290	    """The day the question is due, as an ISO string (D414). A figure whose day the model would estimate (due_day_basis
   291	    expected_publication) is due a fixed number of days after the end of the year it covers; every other day is the answer's."""
   292	    figure = ladder.get('figure')
   293	    if figure is not None and ladder['due_day_basis'] == 'expected_publication':
   294	        year_end = year_end_of(figure['year'], object_kind, object_id, research_list)
   295	        if year_end is not None:
   296	            return (year_end + datetime.timedelta(days=FIGURE_DUE_LAG_DAYS[object_kind])).isoformat()
   297	    return ladder['due_day']
