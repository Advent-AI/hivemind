    21	    'answers supported by both teams': [('July window, trial, one draw each (TRIAL-RESULT.md)', (7, 9), (10, 12)),
    22	                                        ('fresh week, one draw each (WEEK-RESULT.md)', (6, 7), (10, 15))],
    23	    'questions that are trivia or duplicates, both teams': [('fresh week, one draw each (WEEK-RESULT.md)', (1, 7), (6, 15))],
    24	}
    25	SHAPES = [(1, 3), (2, 3), (3, 1), (3, 2), (4, 1), (4, 3)]   # (weeks of unread news, draws of each system)
    26	UNREAD_WEEKS = 3   # 2026-10-06..12, 10-13..19, 10-20..26 are in the article database; the week of 09-29 has 40 articles already read
    27	
    28	
    29	def smallest_detectable(p, n_new, n_old):
    30	    """Two shares near p, two-sided 5%, detected four times in five: 2.8 standard errors."""
    31	    return 2.8 * math.sqrt(p * (1 - p) * (1 / n_new + 1 / n_old))
    32	
    33	
    34	def simulated_power(p_new, p_old, n_new, n_old, runs=20000, seed=20261201):
    35	    rng, hits = random.Random(seed), 0
    36	    for _ in range(runs):
    37	        a = sum(rng.random() < p_new for _ in range(n_new)) / n_new
    38	        b = sum(rng.random() < p_old for _ in range(n_old)) / n_old
    39	        pooled = (a * n_new + b * n_old) / (n_new + n_old)
    40	        se = math.sqrt(max(pooled * (1 - pooled), 1e-9) * (1 / n_new + 1 / n_old))
    41	        hits += abs(a - b) / se > 1.96
    42	    return hits / runs

