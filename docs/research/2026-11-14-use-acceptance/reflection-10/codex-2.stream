    15	# what one week holds, from the fresh week of 2026-09-22..28 (week/WEEK-RESULT.md): questions with a latest answer
    16	PER_WEEK = {'new': 7, 'old': 15}
    17	# charged per week and draw: the new system's ledger $2.52; the old system at listed rates $0.47, rounded up
    18	COST = {'new': 2.52, 'old': 0.50}
    19	# shares seen so far, as (new: hits, of), (old: hits, of), with where they come from
