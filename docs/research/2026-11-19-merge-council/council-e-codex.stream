from pathlib import Path
import sqlite3,json,re
p=Path(\"../../../poc/data/merge-test-2026-11-19\")
o=Path(\"../../../poc/data/comparison-2026-11-17/run\")
def db(path):
 c=sqlite3.connect(f\"file:{path}?mode=ro&immutable=1\",uri=True);c.row_factory=sqlite3.Row;return c
def run(arm,d):
 return o/d/\"prod\" if arm==\"old\" else p/f\"judge-{arm}\"/d
def req(b, j):
 return json.loads(db(b/\"archive.sqlite\").execute(\"select request_json from model_calls where call_id=?\",(j[\"call_id\"],)).fetchone()[0])
def sections(data):
 out={};active=\"\"
 for line in data.splitlines():
  if line.startswith(\"[\") or line.startswith(\"Answer per the\"): active=line.split(\",\")[0].split(\"]\")[0];out[active]=[]
  out.setdefault(active,[]).append(line)
 return out
for d,vs in [(\"old-2\",(\"v5\",\"v40\")),(\"old-3\",(\"v6\",\"v47\"))]:
 b=run(\"hybrid\",d);c=db(b/\"views.sqlite\")
 for v in vs:
  j=c.execute(\"select * from judgements where view_id=? order by seq desc limit 1\",(v,)).fetchone()
  t=req(b,j)[\"messages\"][-1][\"content\"]
  rows=[(int(num),line) for line in t.splitlines() if (m:=re.match(r\"- e(\\d+) \\[\",line)) for num in [m[1]]]
  cites=[int(x[1:]) for x in json.loads(j[\"cited_evidence_json\"])]
  print(d,v,j[\"publication_day\"],\"shown\",len(rows),\"c8\",sum(n>=900001 for n,_ in rows),\"history\",sum(n<900001 for n,_ in rows),\"cited c8/history\",sum(n>=900001 for n in cites),sum(n<900001 for n in cites))
  print(\"c8 anchor(s)\",[(n,l[:300]) for n,l in rows if n>=900001 and (\"Zacks\" in l and \"745\" in l or \"Reuters\" in l and \"anchor\" in l)])
  print(\"ref\",j[\"reference\"],\"implied\",j[\"implied_outcome\"],\"REASONS\",j[\"reasons\"])
  print(\"previous\",next((l for l in t.splitlines() if l.startswith(\"[Previous\")), \"missing\"))
  for n,l in rows:
   if n<900001 and n in cites: print(\"old cited\",l[:390])
res={}
for arm in (\"old\",\"control\",\"hybrid\"):
 b=run(arm,\"old-3\");c=db(b/\"views.sqlite\")
 for date in (\"2026-09-16\",\"2026-09-20\"):
  j=c.execute(\"select * from judgements where view_id=\\\"v47\\\" and publication_day=? order by seq desc limit 1\",(date,)).fetchone()
  if j is None: continue
  r=req(b,j); t=r[\"messages\"][-1][\"content\"];res[arm,date]=(r,sections(t))
  print(arm,date,j[\"call_id\"],j[\"rung\"],j[\"reasons\"])
r1,s1=res[\"old\",\"2026-09-16\"];r2,s2=res[\"control\",\"2026-09-16\"]
print(\"same other req fields\",{k:v for k,v in r1.items() if k"'!="messages"}=={k:v for k,v in r2.items() if k!="messages"},"same system",r1["messages"][0]==r2["messages"][0])
for k in s1.keys()|s2.keys():
 if s1.get(k)!=s2.get(k): 
  print("changed section",k,len(s1.get(k,[])),len(s2.get(k,[])))
  if "Previous" in k:
   print(s1.get(k),s2.get(k))
