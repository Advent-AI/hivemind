    79	def thesis_of(conn, view_id):
    80	    """An old view as a Step 1 open thesis (code-owned conversion): its id, its question, its observable focus as the outcome, and
    81	    the reporting period and the deadline as two labelled parts. The answer choices stay with the judge."""
    82	    view = conn.execute('select * from views where view_id=?', (view_id,)).fetchone()
    83	    key = conn.execute('select * from view_keys where view_id=?', (view_id,)).fetchone()
    84	    reporting = f"reporting period {key['period_start']} to {key['period_end']}; " if key and key['period_start'] else ''
    85	    return {'id': view_id, 'entity': 'NVDA', 'description': view['question'], 'outcome': view['looks_at'],
    86	            'period': f"{reporting}resolved by {view['due_day']}"}
