   276	    """What the judgements already committed at this sequence number queued; a fresh round finds nothing here, a resumed round
   277	    finds what the interrupted one had queued in memory."""
   278	    queued = []
   279	    for row in conn.execute('select view_id from judgements where seq=? and changed=1 order by judgement_id', (seq,)):
   280	        queued.extend(queued_by_change(conn, row['view_id']))
