   256	def dependants_of(conn, view_id):
   257	    direct = [r['view_id'] for r in conn.execute('select view_id from dependencies where depends_on=?', (view_id,))]
   258	    resolved = [r['view_id'] for r in conn.execute(
   259	        'select d.view_id from dependency_resolutions r join dependencies d on d.dependency_id=r.dependency_id where r.resolved_to=?', (view_id,))]
   260	    return sorted(set(direct + resolved))
