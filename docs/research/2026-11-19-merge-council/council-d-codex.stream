   318	def cards():
   319	    """$0. Writes OUT/cards/<draw>-<view>-{old,hybrid}.json: the question, the choices, the last answer at the cutoff, its reasons, and
   320	    every piece of evidence the request of that answer listed, read back from the archived request."""
   321	    from hivemind.views import judging
   322	    out = OUT / 'cards'
   323	    out.mkdir(parents=True, exist_ok=True)
   324	    for draw, targets in TARGETS.items():
   325	        for arm, views_path, archive_path in (('old', RUN / draw / 'prod/views.sqlite', RUN / draw / 'prod/archive.sqlite'),
   326	                                              ('hybrid', OUT / 'judge' / draw / 'views.sqlite', OUT / 'judge' / draw / 'archive.sqlite')):
   327	            conn = sqlite3.connect(f'file:{views_path}?mode=ro', uri=True)
   328	            conn.row_factory = sqlite3.Row
   329	            archive = sqlite3.connect(f'file:{archive_path}?mode=ro', uri=True)
   330	            cutoff = conn.execute('select max(seq) from judgements').fetchone()[0]
   331	            for view_id in targets:
   332	                view, rungs, last = card(conn, view_id, cutoff)
   333	                if last is None:
   334	                    (out / f'{draw}-{view_id}-{arm}.json').write_text(json.dumps({'draw': draw, 'view': view_id, 'arm': arm, 'answer': None}))
   335	                    continue
   336	                request = archive.execute('select request_json from model_calls where call_id=?', (last['call_id'],)).fetchone()
   337	                text = json.loads(request[0])['messages'][-1]['content'] if request else ''
   338	                shown = judging.evidence_shown_in(text) if text else set()
   339	                pieces = []
   340	                for evidence_id in sorted(shown, key=lambda e: int(e[1:])):
   341	                    row = conn.execute('select * from evidence where evidence_id=?', (evidence_id,)).fetchone()
   342	                    source = conn.execute('select * from evidence_sources where evidence_id=? order by seq limit 1', (evidence_id,)).fetchone()
   343	                    pieces.append({'evidence_id': evidence_id, 'tier': row['tier'], 'speaker': row['speaker'], 'original_who': row['original_who'],
   344	                                   'original_day': row['original_day'], 'published': source['publication_day'] if source else None,
   345	                                   'input_id': source['input_id'] if source else None, 'one_line': row['one_line'], 'quote': row['quote']})
   346	                (out / f'{draw}-{view_id}-{arm}.json').write_text(json.dumps(
   347	                    {'draw': draw, 'view': view_id, 'arm': arm, 'question': view['question'], 'opened': view['created_at'][:10],
   348	                     'due': view['due_day'], 'choices': [r['condition'] for r in rungs], 'answer_rung': last['rung'],
   349	                     'answer': rungs[last['rung'] - 1]['condition'], 'reasons': last['reasons'], 'judged_day': last['publication_day'],
   350	                     'judgements': conn.execute('select count(*) from judgements where view_id=?', (view_id,)).fetchone()[0],
   351	                     'material': pieces}, indent=1, ensure_ascii=False))
   352	                print(draw, view_id, arm, 'rung', last['rung'], 'material', len(pieces))
