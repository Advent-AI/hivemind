   249	def direct_parents(conn, view_id, seq=None):
   250	    """The views this view depends on directly (a driver's root, D208; the seeds' depends_on), written at or before `seq` when given.
   251	    The filing reads it to keep a statement under the narrower of two linked questions (D207's narrowest rule, extraction.file_reading)."""
   252	    rows = conn.execute("select depends_on from dependencies where view_id=? and depends_on != '' and (? is null or seq <= ?) order by dependency_id", (view_id, seq, seq))
   253	    return list(dict.fromkeys(r[0] for r in rows))
