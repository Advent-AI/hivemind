   279	def day_start_seq(conn, day):
   280	    """D251: the sequence number the start of `day` stands at: the seq of the last completed day before it, or 0 before the first
   281	    completed day, where the seed questions live (D253: seeds are created at seq 0, before any item)."""
   282	    row = conn.execute('select max(seq) from days_completed where day < ?', (day,)).fetchone()
   283	    return row[0] if row is not None and row[0] is not None else 0
