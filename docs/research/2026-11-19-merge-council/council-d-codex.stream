   286	def views_open_at_day_start(conn, object_ids, day):
   287	    """D251: the questions open at the start of `day`, as every item of that day sees them: views created at or before the day's start
   288	    seq (day_start_seq) whose last switch at that seq is open, the objects' own and every theme, in creation order; before the first
   289	    completed day that is the seeds. Each row carries `snapshot_seq`, the seq its groups and aliases are read at (groups_of_view_at),
   290	    so the list is the same for every item of the day whatever the day's items write. Question, looks_at, kind, object and due day only."""
   291	    seq = day_start_seq(conn, day)
   292	    out = []
   293	    for v in conn.execute('select view_id, object_id, object_kind, kind, looks_at, question, due_day, year, created_seq from views where created_seq <= ? order by created_seq', (seq,)):
   294	        if v['kind'] != 'theme' and v['object_id'] not in object_ids:
   295	            continue
   296	        switch = conn.execute('select open from view_switches where view_id=? and after_seq <= ? order by id desc limit 1', (v['view_id'], seq)).fetchone()
   297	        if switch and switch['open']:
   298	            out.append(dict(v, snapshot_seq=seq))
   299	    return out
