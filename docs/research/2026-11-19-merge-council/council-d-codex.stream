   308	def card(conn, view_id, cutoff_seq):
   309	    """The deck's card text for a view: question, choices, the last answer at or before the cutoff, its reasons and the material that
   310	    judgement was shown (the frozen selection rebuilt at that judgement)."""
   311	    view = conn.execute('select * from views where view_id=?', (view_id,)).fetchone()
   312	    rungs = conn.execute('select label, condition from rungs where view_id=? order by position', (view_id,)).fetchall()
   313	    last = conn.execute('select * from judgements where view_id=? and seq<=? order by seq desc, judgement_id desc limit 1',
   314	                        (view_id, cutoff_seq)).fetchone()
   315	    return view, rungs, last
