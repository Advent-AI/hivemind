   206	def judging_copy(draw, path):
   207	    """A copy of the old store holding only what existed at the end of BOUNDARY_DAY: every row written after it is removed, so no later
   208	    state leaks into a judgement. The target questions created later are put back on the day they were created (`restore_view`)."""
   209	    source = sqlite3.connect(f'file:{RUN / draw / "prod/views.sqlite"}?mode=ro', uri=True)
   210	    target = sqlite3.connect(path)
   211	    source.backup(target)
   212	    source.close()
   213	    boundary = target.execute('select seq from days_completed where day=?', (BOUNDARY_DAY,)).fetchone()[0]
   214	    later_views = [r[0] for r in target.execute('select view_id from views where created_seq>?', (boundary,))]
   215	    for table, column in (('judgements', 'seq'), ('evidence_links', 'seq'), ('evidence_sources', 'seq'), ('same_claims', 'seq'),
