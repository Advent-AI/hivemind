   235	def dependencies_of(conn, view_id):
   236	    """Each dependency with its current target: the resolved view, or the waiting chain and year."""
   237	    out = []
   238	    for dep in conn.execute('select * from dependencies where view_id=? order by dependency_id', (view_id,)):
   239	        dep = dict(dep)
   240	        resolution = conn.execute('select resolved_to, reason from dependency_resolutions where dependency_id=? order by id desc limit 1', (dep['dependency_id'],)).fetchone()
   241	        if resolution:
   242	            dep['resolved_to'], dep['resolution'] = resolution['resolved_to'], resolution['reason']
   243	        else:
   244	            dep['resolved_to'], dep['resolution'] = dep['depends_on'], ('direct' if dep['depends_on'] else 'waiting')
   245	        out.append(dep)
   246	    return out
