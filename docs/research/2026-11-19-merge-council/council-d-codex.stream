   374	def relate_same(conn, old_id, new_id, seq):
   375	    """D204: the matcher's opinion that new_id restates old_id; a labelled relation, never a merge."""
   376	    insert(conn, 'same_claims', old_evidence_id=old_id, new_evidence_id=new_id, seq=seq)
   377	
   378	
   379	def same_claim_group(conn, evidence_id):
   380	    """The other pieces related to this one as the same claim, in either direction (empty on a ledger without the table)."""
   381	    if not conn.execute("select 1 from sqlite_master where type='table' and name='same_claims'").fetchone():
   382	        return []
   383	    rows = conn.execute('select old_evidence_id, new_evidence_id from same_claims where old_evidence_id=? or new_evidence_id=?', (evidence_id, evidence_id)).fetchall()
   384	    return sorted(({r['old_evidence_id'] for r in rows} | {r['new_evidence_id'] for r in rows}) - {evidence_id}, key=lambda x: int(x[1:]) if x[1:].isdigit() else x)
   385	
   386	
   387	def revision_of(conn, evidence_id):
   388	    """None on a ledger written before D202 (no revisions table), which read-only openers cannot extend."""
   389	    if not conn.execute("select 1 from sqlite_master where type='table' and name='revisions'").fetchone():
   390	        return None
   391	    row = conn.execute('select old_evidence_id from revisions where new_evidence_id=? order by id desc limit 1', (evidence_id,)).fetchone()
   392	    return row['old_evidence_id'] if row else None
   393	
   394	
   395	def recent_judgements(conn, view_id, n):
   396	    """The thesis's last n judgements, newest first: (seq, cited evidence ids)."""
   397	    rows = conn.execute('select seq, cited_evidence_json from judgements where view_id=? order by judgement_id desc limit ?', (view_id, n)).fetchall()
   398	    return [{'seq': r['seq'], 'cites': json.loads(r['cited_evidence_json'] or '[]')} for r in rows]
   399	
   400	
   401	def is_replaced(conn, evidence_id):
   402	    return bool(conn.execute('select 1 from replacements where old_evidence_id=?', (evidence_id,)).fetchone())
   403	
   404	
   405	def predecessor_of(conn, evidence_id):
   406	    row = conn.execute('select old_evidence_id from replacements where new_evidence_id=? order by id desc limit 1', (evidence_id,)).fetchone()
   407	    return row['old_evidence_id'] if row else None
   408	
   409	
   410	def evidence(conn, evidence_id):
   411	    row = conn.execute('select * from evidence where evidence_id=?', (evidence_id,)).fetchone()
   412	    if not row:
   413	        return None
   414	    record = dict(row)
   415	    record['sources'] = [dict(s) for s in conn.execute('select input_id, category, publication_day, location from evidence_sources where evidence_id=? order by id', (evidence_id,))]
   416	    return record
   417	
   418	
   419	def evidence_in_force(conn, view_id):
   420	    """Evidence linked to the view and not replaced (history), each with its replaced predecessor when there is one and, since D202,
   421	    the piece it revises (both in force)."""
   422	    out = []
   423	    for row in conn.execute('select evidence_id from evidence_links where view_id=? order by id', (view_id,)):
   424	        evidence_id = row['evidence_id']
   425	        if is_replaced(conn, evidence_id):
   426	            continue
   427	        record = evidence(conn, evidence_id)
   428	        previous = predecessor_of(conn, evidence_id)
   429	        record['replaced'] = evidence(conn, previous) if previous else None
   430	        revised = revision_of(conn, evidence_id)
   431	        record['revises'] = evidence(conn, revised) if revised else None
   432	        record['same_as'] = [x for x in same_claim_group(conn, evidence_id) if not is_replaced(conn, x)]
   433	        out.append(record)
   434	    return out
   435	
   436	
   437	def views_linked_to(conn, evidence_id):
   438	    return [r['view_id'] for r in conn.execute('select view_id from evidence_links where evidence_id=? order by id', (evidence_id,))]
   439	
   440	
   441	def evidence_ids_under(conn, view_id):
   442	    return [r['evidence_id'] for r in conn.execute('select evidence_id from evidence_links where view_id=?', (view_id,))]
   443	
   444	
   445	# ---------- processing record and pool ----------
   446	

