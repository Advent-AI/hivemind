   134	def send(ledger_path):
   135	    """Paid. One single-item c8 run per draw and article, 8 at a time, each in its own folder; the ledger caps the total."""
   136	    import runner
   137	    from live import LiveTransport
   138	    budget_replay = load('budget_replay', ROOT / 'clean-arch/e2e-comparison-2026-11-13/budget_replay.py')
   139	    ledger = budget_replay.SharedLedger(ledger_path)
   140	    budget_replay.install_stop_gate(ledger)
   141	    settings, limits, manifest = c8_configuration()
   142	    settings = dict(settings, live_limits=limits)
   143	    plan = json.loads((OUT / 'lists.json').read_text())
   144	    jobs = [(draw, entry) for draw in plan for entry in plan[draw]]
   145	
   146	    def one(job):
   147	        draw, entry = job
   148	        folder = OUT / 'c8' / draw / f"{entry['seq']:05d}"
   149	        if (folder / 'outcome.json').exists():
   150	            return draw, entry['seq'], json.loads((folder / 'outcome.json').read_text())
   151	        folder.mkdir(parents=True, exist_ok=False)
   152	        try:
   153	            outcome = runner.run(str(ITEMS), folder / 'trace.sqlite', dict(manifest, item_ids=[entry['input_id']], item_limit=1),
   154	                                 copy.deepcopy(entry['open']), settings, LiveTransport(limits, ledger=ledger), PRD)
   155	        except Exception as error:
   156	            outcome = {'status': 'crashed', 'error': f'{type(error).__name__}: {error}', 'trace': traceback.format_exc()[-1500:]}
   157	        (folder / 'outcome.json').write_text(json.dumps(outcome, indent=1))
   158	        return draw, entry['seq'], outcome
   159	
   160	    with concurrent.futures.ThreadPoolExecutor(max_workers=8) as pool:
   161	        for draw, seq, outcome in pool.map(one, jobs):
   162	            print(json.dumps({'draw': draw, 'seq': seq, 'status': outcome.get('status'), 'error': (outcome.get('error') or '')[:200]}),
   163	                  flush=True)
   164	    print('ledger', json.dumps(json.loads(Path(ledger_path).read_text())))
