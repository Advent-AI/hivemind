   167	def records(draw):
   168	    """c8's kept records of every completed article of a draw, with the old sequence number of their article."""
   169	    run_forward = load('run_forward', ROOT / 'clean-arch/step2/run_forward.py')
   170	    out = []
   171	    for folder in sorted((OUT / 'c8' / draw).iterdir()):
   172	        trace = folder / 'trace.sqlite'
   173	        if not trace.exists():
   174	            continue
   175	        found, _, _ = run_forward.step1_records(str(trace))
   176	        conn = sqlite3.connect(f'file:{trace}?mode=ro', uri=True)
   177	        status, result = conn.execute('select status, result from trace').fetchone()
   178	        proposed = (json.loads(result) or {}).get('new_theses', []) if result else []
   179	        out.append({'seq': int(folder.name), 'status': status, 'records': [r for article in found for r in article],
   180	                    'proposed': proposed})
