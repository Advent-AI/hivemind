   190	        for row in rows:
   191	            for record in row['records']:
   192	                for view_id in set(record['thesis_ids']) & set(targets):
   193	                    filed[view_id].append({'seq': row['seq'], 'day': record['publication_date'], 'summary': record['summary'],
   194	                                           'verified': [p for p in (record['verified_passages'] or []) if p]})
   195	        summary[draw] = {'articles read': len(rows), 'not complete': [r['seq'] for r in rows if r['status'] != 'complete'],
   196	                         'records': sum(len(r['records']) for r in rows),
   197	                         'filed under target': {v: len(x) for v, x in filed.items()},
   198	                         'filed': filed,
   199	                         'proposed theses': [{'seq': r['seq'], 'description': t['description'], 'outcome': t['outcome']}
   200	                                             for r in rows for t in r['proposed']]}
   201	    (OUT / 'census.json').write_text(json.dumps(summary, indent=1, ensure_ascii=False))
   202	    print(json.dumps({d: {k: v for k, v in s.items() if k not in ('filed', 'proposed theses')} | {'proposed': len(s['proposed theses'])}
   203	                      for d, s in summary.items()}, indent=1))
