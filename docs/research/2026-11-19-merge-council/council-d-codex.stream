    50	def articles():
    51	    """Every test article once, in the old draws' processing order: (old seq, input id, publication day). Both old draws processed the
    52	    same items in the same order (checked)."""
    53	    chosen = json.loads((HERE / 'articles.json').read_text())
    54	    wanted = set(chosen['capex']) | set(chosen['anthropic'])
    55	    found = {}
    56	    for draw in TARGETS:
    57	        conn = old_store(draw)
    58	        for input_id in wanted:
    59	            row = conn.execute('select min(sequence_no), publication_day from processing_steps where input_id=?', (input_id,)).fetchone()
    60	            if row[0] is None:
    61	                raise SystemExit(f'{input_id} was not processed by {draw}')
    62	            if found.setdefault(input_id, tuple(row)) != tuple(row):
    63	                raise SystemExit(f'{input_id} has a different sequence in {draw}')
    64	    return sorted((seq, input_id, day) for input_id, (seq, day) in found.items())
