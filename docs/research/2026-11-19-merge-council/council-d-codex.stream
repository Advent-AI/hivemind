    67	def open_views_at(conn, seq):
    68	    """The old views open when the article with this sequence number was read: created at or before it, and not switched off at or
    69	    before it. The views an article opened are included, since opening runs before filing in the merge."""
    70	    out = []
    71	    for view in conn.execute('select view_id from views where created_seq<=? order by created_seq, view_id', (seq,)):
    72	        switch = conn.execute('select open from view_switches where view_id=? and after_seq<=? order by id desc limit 1',
    73	                              (view['view_id'], seq)).fetchone()
    74	        if switch is None or switch['open']:
    75	            out.append(view['view_id'])
    76	    return out
