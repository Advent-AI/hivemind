def figure_in_passages(value, passages):
    """A condition's figure is quoted when it occurs, whitespace normalised, in one verified passage, with numeric boundaries: not
    preceded by a digit or by a decimal point or comma that follows a digit, and not followed by a digit or by a decimal point or comma
    that precedes a digit. It proves the figure is quoted, not that it belongs to the stated measure (that is a reader's check)."""
    figure = ' '.join(value.split())
    if not figure:
        return False
    for passage in passages:
        if passage is None:
            continue
        text = ' '.join(passage.split())
        start = text.find(figure)
        while start != -1:
            end = start + len(figure)
            before, before2 = text[start - 1:start], text[start - 2:start - 1]
            after, after2 = text[end:end + 1], text[end + 1:end + 2]
            left = not (before.isdigit() or (before in ('.', ',') and before and before2.isdigit()))
            right = not (after.isdigit() or (after in ('.', ',') and after and after2.isdigit()))
            if left and right:
                return True
            start = text.find(figure, start + 1)
    return False


def validate(answer, schema, item, shown):
    errors = model.check_schema(answer, schema)
    if errors:
        raise ContractError('; '.join(errors))
    thesis_ids = [x['local_id'] for x in answer['new_theses']]
    evidence_ids = [x['local_id'] for x in answer['evidence']]
    for name, ids in [('thesis', thesis_ids), ('evidence', evidence_ids)]:
        if any(not x.strip() for x in ids) or len(ids) != len(set(ids)):
            raise ContractError(f'{name} local IDs must be nonempty and unique')
    for thesis in answer['new_theses']:
        if not thesis['description'].strip() or not thesis['outcome'].strip():
            raise ContractError('new thesis requires a question and outcome')
    existing = {x['id'] for x in shown}
    linked_new = set()
    unresolved = []
    lookup_index = None
    index_failure = None
    lookup_errors = []
    interpreted = copy.deepcopy(answer)
    for ev in interpreted['evidence']:
        if not ev['summary'].strip():
            raise ContractError('evidence requires a summary')
        verified = []
        repaired = []
        for passage_number, quote in enumerate(ev['source_passages'], 1):
            if not quote.strip():
                raise ContractError('empty source passage')
            exact = quote in item['text']
            source = quote if exact else extraction.repair_quote(quote, item['text'])
            if not exact and (not source or source not in item['text'] or not preserves_quote(quote, source)):
                if lookup_index is None and index_failure is None:
                    try:
                        lookup_index = quote_lookup.build_index(item['text'])
                    except Exception as error:
                        index_failure = (type(error).__name__, str(error))
                failure = index_failure
                if failure is None:
                    try:
                        located = quote_lookup.find_quote(quote, item['text'], lookup_index)
                        if located and preserves_quote(quote, located):
                            source = located
                    except Exception as error:
                        failure = (type(error).__name__, str(error))
        if type(transport) is LiveTransport:
            archive = model.Archive(str(output_path))
            checksum = hashlib.sha256(dump({'settings': settings, 'prompt': prompt, 'closing': closing, 'schema': schema}).encode()).hexdigest()
            call_config = SimpleNamespace(provider=settings['provider'], version='clean-step1', checksum=checksum)
        theses = copy.deepcopy(initial_theses)
        outcome = {'status': 'complete', 'error': None}
        failed_items = []
        for sequence, item in enumerate(items, 1):
            shown = [{k: t[k] for k in ('id', 'description', 'outcome', 'period')} for t in theses]
            tags = [x['value'] for x in item['object_identifiers'] if x.get('kind') == 'ticker']
            payload = {'current_entity': entity, 'company_tags': tags, 'open_theses': shown, 'source_item': {
                'id': item['input_id'], 'publisher': item['publisher'], 'publication_date': item['publication_day'],
                'published_at': item['published_at'], 'publisher_type': item.get('publisher_type'),
                'authors': item.get('authors'), 'category': item.get('category'),
                'source_uri': item['source_uri'], 'title': item['title'], 'text': item['text']}}
            user = dump(payload) + (f'\n\n{closing}' if closing else '')
            request = model.build_request(setting, prompt, user, schema, 'clean_step1', settings['provider'])
            conn.execute('insert into trace (sequence,input_id,before_state,request,status) values (?,?,?,?,?)',
                         (sequence, item['input_id'], dump(theses), json.dumps(request), 'in_flight'))
            conn.commit()
            if type(transport) is LiveTransport:
                def record_reservation(amount):
                    conn.execute('update trace set reserved_usd=? where sequence=?', (amount, sequence))
                    conn.commit()
                transport.on_reserve = record_reservation
            response = None
            notes = []          # this step's retries, network and format, in order: written to retry_reason, none overwriting another
            try:
                if type(transport) is LiveTransport:
                    def capture(provider, built_request):
                        nonlocal response
                        try:
                            response = transport(provider, built_request)
                        except model.TransportError as error:
                            if hasattr(error, 'response_body'):
                                response = {'http_status': error.http_status, 'raw_body': error.response_body}
                                if hasattr(error, 'response_body_base64'):
                                    response['raw_body_base64'] = error.response_body_base64
                            raise
                        finally:
                            notes.extend(f'network retry, {note}' for note in transport.network_errors)
                            if notes:
                                with conn:
                                    conn.execute('update trace set retry_reason=? where sequence=?', ('; '.join(notes), sequence))
                        if transport.last_sent is not built_request:   # a provider adaptation changed the bytes: keep what was sent
                            response = dict(response, sent_request=transport.last_sent)
                        conn.execute('update trace set raw_response=? where sequence=?', (dump(response), sequence))
                        conn.commit()
                        choice = response['choices'][0]
"""Budgeted use of the repository's existing transport for OpenAI Luna and, in JSON mode, DeepSeek."""
import json
import math
import time

from hivemind import model


SUPPORTED = {('openai', 'gpt-6-luna'), ('deepseek', 'deepseek-flash'), ('deepseek', 'deepseek-v4-pro')}


def deepseek_json_mode(request, reasoning_effort):
    """DeepSeek refuses a strict JSON schema: the same schema is stated at the end of the system text and JSON mode is requested.
    model.call still checks the answer against the schema, so a nonconforming answer fails the item and is never repaired."""
    schema = request['response_format']['json_schema']['schema']
    messages = [dict(m) for m in request['messages']]
    messages[0]['content'] += '\n\nReturn only one JSON object that conforms to this JSON Schema:\n' + json.dumps(schema)
    adapted = dict(request, messages=messages, response_format={'type': 'json_object'})
    if reasoning_effort:
        adapted['reasoning_effort'] = reasoning_effort
    return adapted


NETWORK_ATTEMPTS = 3          # as production's transport (model.openai_transport): a dropped connection is tried up to three times
NETWORK_WAITS = (30, 60)      # seconds before the second and the third attempt
CALL_WAIT_SECONDS = 600       # the longest a call may wait on a silent connection before it counts as lost (D552)


def is_network_loss(error):
    """A send that brought no usable answer from the network: a TransportError with no HTTP status (reset, cut read, timeout), or 429 or 5xx."""
    if not isinstance(error, model.TransportError):
        return False
    status = getattr(error, 'http_status', None)
    return status is None or status == 429 or status >= 500


class LiveTransport:
    """With `ledger` (an object with `reserve(amount) -> bool` and `settle(reserved, actual)`, shared by every component of a run;
    D448), each attempt reserves its estimate on the ledger before it is sent and settles at the response's usage (its reservation when
    usage is missing or the send fails), and the cumulative `max_usd` check is not applied. Each network attempt is one send
    (`max_attempts=1`); a network loss (`is_network_loss`) is sent again, up to NETWORK_ATTEMPTS in all after NETWORK_WAITS, every attempt
    checked against the time and call limits and reserved and settled on its own; `network_errors` holds the losses of the last call, for
    the trace. A send waits on its connection for at most CALL_WAIT_SECONDS, or the run's remaining time when that is less: a
    connection that goes silent (the machine slept, the network dropped without an error) then times out and is a network loss
    like any other. The bound is on each wait for data, not on the whole call: an answer that keeps arriving is never cut.
    A resend may be a fresh sample (the provider may have produced an answer that never arrived). Anything else is raised."""

    def __init__(self, limits, send=None, clock=time.monotonic, ledger=None, wait=time.sleep):
        self.ledger = ledger
        self.wait = wait
        self.network_errors = []
        self.clock = clock
        self.start = clock()
        self.limits = limits
        self.send = send or model.openai_transport
        self.reserved = 0.0
        self.calls = 0
        self.on_reserve = lambda reserved: None
        self.reasoning_effort = None   # sent to DeepSeek; build_request sets it for OpenAI only
        self.last_sent = None          # the exact request sent, after any provider adaptation
        for key in ('max_usd', 'max_seconds', 'max_calls', 'input_usd_per_million', 'output_usd_per_million'):
            if isinstance(limits[key], bool) or not isinstance(limits[key], (int, float)) or not math.isfinite(limits[key]) or limits[key] <= 0:
# Can the new system open questions on the company's revenue and margin without number cards? Probe design, version 3 (D490), 2026-11-14

**What it can decide.** Whether c20, the adopted clean Step 1 request (c8) with one more reason in its closed set (the company's own annual
revenue or gross margin), opens the three questions the fresh week showed it lacks (fiscal 2027 revenue, fiscal 2028 revenue, the fiscal
2028 gross margin) on the stored articles that carry them, keeps and links the figures those articles state, opens no question on other
statement lines, quarters or other companies' figures, and does not suppress what c8 opens today. Two steps: step one on the stored
states; step two, only after step one passes, the same later articles against a state that already holds the new questions (does it open
them twice, or file a year under the wrong year?). Both must pass before the forward draw on the second fresh week. A failure stops the line
and goes to Alex. Neither step shows how one article's choices shape the next over a week (only a forward draw does), nor whether final
judgements improve.

**Alex's word (D490):** "试开这类问题", on the option "先在这周已存的文章上…试：能否开出这 3 个问题，同时不乱开、不重复；通过后再跑第二个没用过的新鲜周". D382 and D384
stay in force for the adopted path; the arm departs from them on this one point, for the test.

## The candidate (`clean-arch/step1-unfiled-2026-11-08/arms/c20-*`)

One direction, stated at its owners (the differences from c8, all of them):
- **§3's closed set gains a fifth reason, first in the list:** "main_driver: the company's own annual revenue or gross margin, for its
  current or next fiscal year, whether or not the company guides it: the revenue that carries the business, in total or of its main segment,
  or the gross margin ("the bank's net interest income this fiscal year"; "the retailer's same-store sales next fiscal year"). It is not
  every line of the statements. Name the measure, its scope and the fiscal year the item supports; a level and its growth rate are one thesis
  when the same reported figure settles both. The material that publishes the figure, usually the annual report, settles it."
- **The date rule** gains "a main_driver quantity, the release of that fiscal year's results" among the dates a reason fixes when the item
  gives none.
- **The do-not-open row** "a financial measure's level, growth, margin or guidance for any period, on its own" becomes "a quarter's figures
  or guidance, or the level, growth, margin or guidance of a financial measure that is not a main_driver quantity, on its own".
- "four reasons" becomes "five reasons" in §3 and in the closing check; the schema's `opens_as` gains `main_driver` and its description says
  five.
- Nothing else changes: the CONDITION bullet already sends the company's figures to "an open thesis about its revenue or earnings path"
  ("open or new" in its next sentence); "another estimate, source or wording of what an open thesis tracks" and "an annual quantity after
  next year" stand; `closest_open_thesis` and `why_a_separate_bet` are as they were.

**Source.** The signed standard §3, row A: "A 主驱动量 | main_driver | 标的 | 承载公司价值的那个年度量，不管公司指不指引：撑起业务的分部收入、毛利率、资本开支；跨行业如银行的净利息
收入、零售商的同店销售、公用事业的费率基数、航空公司的燃油成本（当它是争论焦点时）。不是每一行报表数 | 量，五档 | 公司财年的今年或明年；到期日是这个数的发布日 | 公布这个数的公开材料，通常是年报";
§4 for the quarter row ("季度数字和季度指引"), for writing who and what is counted ("算谁、不算谁、算什么写清楚") and for one result settling one
question ("同一个结果能判掉两题，就是同一题"). The two examples are the row's own; none names the covered company, a product or a number.

**Narrower than row A, on purpose, by D490's scope.** The row is "the annual quantity that carries the company's value" and also names
capital expenditure, a utility's rate base and an airline's fuel cost; Alex opened the test for revenue and margin, so the arm says revenue
or gross margin and carries only the two revenue examples. A question on another annual quantity is therefore outside the request as
written and counts as a number card below; that is a limit of this test, not a reading of the standard, and the frozen standard is not
changed. If the arm is ever adopted, the narrowing goes to Alex.

**Size.** System text 15,828 → 16,574 characters (+746); closing check the same length; schema one enum value. Growth reason: the standard's
row A has no sentence in the request (left out by D384); D490 opens the test of carrying it; no sentence can be cut for it without becoming
a second direction.

**Reviews before any send.** Blind audit of version 1 (`audit-c20-blind.md`): wider than D490 (fixed: revenue or gross margin), no date for
an item that gives none (fixed: the date rule), a growth example that reads as a second measure (fixed: the example and the level-and-growth
sentence), measure and scope not asked for (fixed). Blind audit of version 2 (`audit-c20v2-blind.md`): those points resolved except the
date, where it notes that "the release of that fiscal year's results" names an event and no calendar day: that is the form the adopted
request already uses for an obligation ("its next annual report"), and the answer-options step sets the due day by code from the fiscal year
when neither thesis nor article states one, so it is left as it is and the probe reports each thesis's period; "the fiscal year the item
supports" added from its second point (§4, "原文支持这个期间"); its other notes (the margin's tie to "carries the business", a sentence that the
row leaves the other reasons alone) are risks the cases measure, not contradictions. Council rounds 13 to 15 (`mw-codex-13.md` to
`mw-codex-15.md`): the counting below, and the blind reading of the kept-and-linked line (round 15's one condition for the send: "先补上独立、盲读的
事实保留与关联检查及其分歧处理，再发送第一步；第二步的构造器另行审查"). A synthetic answer following the
arm (one main_driver thesis, one linked statement) passes the arm's schema and every runner check; the same answer fails c8's schema and a
