{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"rg -n 'def schema_for|industry_aggregate|settled_by|measure|period_start|due_date' src/hivemind/extraction.py\"","aggregated_output":"22:ADMISSION_REASONS = ['main_driver', 'industry_aggregate', 'policy_stage', 'binding_obligation']\n96:# keyed-views-plan.md 2.1 and D167: the key a candidate carries; a market's size and a project's cost are measures of their own\n106:    return {'measure': {'type': 'string', 'enum': list(MEASURES)}, 'scope': {'type': 'string'},\n107:            'period_start': {'type': 'string', 'pattern': r'^\\d{4}-\\d{2}-\\d{2}$'}, 'period_end': {'type': 'string', 'pattern': r'^\\d{4}-\\d{2}-\\d{2}$'},\n135:    return candidate.get('kind') == 'theme' or candidate.get('measure') not in FINANCIAL_LINES\n162:def schema_for(version, shown_view_ids=()):\n169:    candidate['properties'].update({'opens_as': {'type': 'string', 'enum': list(ADMISSION_REASONS)}, 'settled_by': {'type': 'string'}})\n170:    candidate['required'] += ['opens_as', 'settled_by']\n364:            watched.append(f'  - {o}: ' + sep.join(e['measure'] + (f\"[{e['scope']}]\" if e.get('scope') else '') + (f\"({e['event_type']})\" if e.get('event_type') else '') for e in entries))\n397:        parts.append('[Research reference] Existing quantities and scopes (measure[scope](event_type)). Reuse a name only when the meaning is the same; '\n524:    \"\"\"None when a candidate's admission fields are well formed (D184/D185), else the problem: settled_by is not blank, and a binding\n526:    if not str(c.get('settled_by', '')).strip():\n527:        return 'settled_by is empty'\n626:                and c.get('measure') not in ('event', 'policy_event'):          # a dated event that names its quarter is not a quarterly figure\n629:        if c.get('measure') not in ('event', 'policy_event') and c.get('opens_as') != 'binding_obligation' \\\n644:        if c.get('measure'):          # keyed candidates keep their actual scope; reference lists do not gate admission (D155)\n651:                scope, source = universe.scope_and_source(object_id, c['measure'], c.get('scope', ''), c.get('event_type', 'n/a'))\n653:                if c['measure'] not in ('event', 'policy_event'):\n656:                        c = dict(c, period_start=period[0], period_end=period[1])\n658:                start = datetime.date.fromisoformat(c['period_start'])\n","exit_code":0,"status":"completed"}}
