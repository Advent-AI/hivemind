': judgement_id, 'rung': data['rung'], 'changed': data['changed'], 'cost': answer.cost_usd, 'cached': answer.cached}\n../../../src/hivemind/views/judging.py:287:def queued_by_change(conn, view_id):\n../../../src/hivemind/views/judging.py:296:def queued_by_ledger(conn, seq):\n../../../src/hivemind/views/judging.py:300:    for row in conn.execute('select view_id from judgements where seq=? and changed=1 order by judgement_id', (seq,)):\n../../../src/hivemind/views/judging.py:305:def round_of_judgements(archive, cfg, conn, changed_views, seq, item, *, transport=None):\n../../../src/hivemind/pull.py:12:    last = conn.execute('select rung from judgements where view_id=? order by seq desc, judgement_id desc limit 1', (view_id,)).fetchone()\n../../../src/hivemind/pull.py:30:def end_of_day(conn, day, seq):\n../../../src/hivemind/research_context.py:95:            judgements = self.rows('select * from judgements where view_id=? and seq<? order by seq desc,judgement_id desc limit 1', (vid,self.seq))\n../../../src/hivemind/placement.py:19:def takes(view):\n../../../src/hivemind/placement.py:59:def question_lines(shown):\n","exit_code":0,"status":"completed"}}
