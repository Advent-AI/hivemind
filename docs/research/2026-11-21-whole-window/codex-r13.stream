{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba ../../../src/hivemind/views/links.py | sed -n '15,48p;178,322p'\"","aggregated_output":"    15\tENGINE = 'jev-links'\n    16\tKIND = 'reads'\n    17\tTHRESHOLD = jev_matching.THRESHOLD\n    18\tLABELS = vocabulary.ASSET_LABELS                 # five-rung asset ladders run Strongly bullish .. Strongly bearish, or the reverse\n    19\tCANDIDATE_READS, THESIS_READS, NEITHER = 'candidate_reads_thesis', 'thesis_reads_candidate', 'neither'\n    20\tTOGETHER, OPPOSITE, NO_SIGN = 'together', 'opposite', 'no_clear_sign'\n    21\t\n    22\tREADS = {\n    23\t    CANDIDATE_READS: \"the CANDIDATE should be judged with the THESIS's current conclusion in view, because the THESIS's answer bounds \"\n    24\t                     \"or drives the CANDIDATE's: a part read against its whole (one product line's sales against the company's total \"\n    25\t                     \"sales; one region's loan book against the bank's total loans), or a quantity read against another it depends on \"\n    26\t                     \"(a component supplier's revenue against its largest customer's capital spending; an airline's fuel bill against \"\n    27\t                     \"its fuel volume)\",\n    28\t    THESIS_READS: \"the THESIS should be judged with the CANDIDATE's current conclusion in view, for the same reasons with the roles swapped\",\n    29\t    NEITHER: \"neither answer bounds or drives the other: unrelated quantities (a retailer's gross margin and its store openings in \"\n    30\t             \"another country), or the same quantity for the same period and scope; sharing a company, industry or topic is not enough\",\n    31\t}\n    32\tSIGN = {\n    33\t    TOGETHER: \"a higher answer to the question read makes a higher answer to the question reading it more likely (a company's total \"\n    34\t              \"sales and one product line's sales, when that line's share of the total holds steady; a customer's capital spending \"\n    35\t              \"and its component supplier's revenue)\",\n    36\t    OPPOSITE: \"a higher answer to the question read makes a lower answer to the question reading it more likely (an airline's fuel \"\n    37\t              \"bill and its operating margin; a retailer's markdowns and its gross margin)\",\n    38\t    NO_SIGN: \"the question read only caps the other without moving its most likely answer (a regulator's cap on a bank's fees set far \"\n    39\t             \"above what it charges), or the supplied text does not show which way it moves it\",\n    40\t}\n    41\tREADS_INSTRUCTIONS = (\"Should one of these two questions be judged with the other's current conclusion in view? Use only the supplied \"\n    42\t                      \"text. THESIS:\\n\")\n    43\tSIGN_INSTRUCTIONS = {\n    44\t    CANDIDATE_READS: \"If the THESIS's answer turned out higher, which way would that move the CANDIDATE's most likely answer? Use only the supplied text. THESIS:\\n\",\n    45\t    THESIS_READS: \"If the CANDIDATE's answer turned out higher, which way would that move the THESIS's most likely answer? Use only the supplied text. THESIS:\\n\",\n    46\t}\n    47\t\n    48\t\n   178\tdef _ask(archive, cfg, jobs, transport, record, stage):\n   179\t    \"\"\"One Jev request per job, asked in order; each job is written into the record before it is sent (its request sha, whether the\n   180\t    archive held it) and completed as it is answered (its call id). A failure names the failing job's sha and leaves the later jobs\n   181\t    marked not asked.\"\"\"\n   182\t    entries = []\n   183\t    for state, questions in jobs:\n   184\t        _, sha = model.request_identity(jev.request_for(cfg.matching, state, questions))\n   185\t        entries.append({'stage': stage, 'request_sha256': sha, 'questions': sorted(questions), 'archived_before': bool(archive.lookup(sha)),\n   186\t                        'status': 'not asked'})\n   187\t    record['calls'].extend(entries)\n   188\t    replies = []\n   189\t    for entry, (state, questions) in zip(entries, jobs):\n   190\t        try:\n   191\t            reply = jev.ask(archive, cfg, cfg.matching, state, questions, 'match', transport=transport)\n   192\t        except Exception as error:\n   193\t            entry['status'] = 'failed'\n   194\t            record['error'] = f'{type(error).__name__}: {error}'[:300]\n   195\t            record['failed_request_sha256'] = entry['request_sha256']\n   196\t            raise Refused(f'link question failed: {record[\"error\"]}', record) from error\n   197\t        entry['status'], entry['call_id'] = 'answered', reply.call_id\n   198\t        replies.append(reply.data)\n   199\t    return replies\n   200\t\n   201\t\n   202\tdef _passes(answer, accepted):\n   203\t    choice = answer['choice']\n   204\t    return choice if choice in accepted and answer['probabilities'][choice] >= THRESHOLD else None\n   205\t\n   206\t\n   207\tdef choose(archive, cfg, conn, handover, checked, lists, shown_views, *, transport=None):\n   208\t    \"\"\"The links this article proposes: [{'reader', 'read', 'candidate', 'direction', 'sign'}], reader and read being a candidate id\n   209\t    (canonical) or a stored view id; and the record of how they were chosen. Raises Refused for an unbound waiting row, a Jev\n   210\t    failure or a circle that remains after one correction (PRD 06).\"\"\"\n   211\t    record = {'pairs': [], 'calls': [], 'corrections': [], 'proposed': []}\n   212\t    if unbound_waits(conn):\n   213\t        record['error'] = 'the store holds an unbound waiting dependency row'\n   214\t        raise Refused(record['error'], record)\n   215\t    aliases, problems = identity.batch_plan(handover.candidates, checked.outcomes)\n   216\t    if problems:                                   # the writer refuses the same plan (WriteConflict); nothing to ask\n   217\t        record['skipped'] = problems\n   218\t        return [], record\n   219\t    evidence = handover.evidence\n   220\t    stage1, asked = [], []\n   221\t    for c in handover.candidates:\n   222\t        outcome, target, _ = checked.outcomes.get(c['id'], ('skip', None, []))\n   223\t        if outcome not in ('new', 'succession') or aliases.get(c['id']) != c['id']:\n   224\t            continue\n   225\t        rungs = candidate_rungs(conn, c, outcome, target)\n   226\t        if not is_number_question(c['kind'], rungs, c.get('measure')):\n   227\t            record['pairs'].append({'candidate': c['id'], 'eligible': False, 'why': 'not a number question'})\n   228\t            continue\n   229\t        listed = list(dict.fromkeys(list(lists.candidate_lists.get(c['id'], [])) + [v['view_id'] for v in shown_views]))\n   230\t        theses = []\n   231\t        for view_id in listed:\n   232\t            ok = store.is_open(conn, view_id) and stored_is_number_question(conn, view_id)\n   233\t            record['pairs'].append({'candidate': c['id'], 'thesis': view_id, 'eligible': ok})\n   234\t            if ok:\n   235\t                theses.append(view_id)\n   236\t        if theses:\n   237\t            state = jev_matching.candidate_state(c, evidence)\n   238\t            stage1.append((state, {f'reads__{v}': reads_question(jev_matching.thesis_text(conn, v)) for v in theses}))\n   239\t            asked.append((c, state, theses))\n   240\t    if not stage1:\n   241\t        return [], record\n   242\t    answers = _ask(archive, cfg, stage1, transport, record, 'reads')\n   243\t    directions = {}\n   244\t    for (c, state, theses), reply in zip(asked, answers):\n   245\t        for view_id in theses:\n   246\t            answer = reply[f'reads__{view_id}']\n   247\t            direction = _passes(answer, (CANDIDATE_READS, THESIS_READS))\n   248\t            record['pairs'].append({'candidate': c['id'], 'thesis': view_id, 'reads': answer['choice'], 'probabilities': answer['probabilities']})\n   249\t            if direction:\n   250\t                directions[(c['id'], view_id)] = direction\n   251\t    links = _signed(archive, cfg, conn, asked, directions, transport, record)\n   252\t    on_circle = circles(conn, links)\n   253\t    if on_circle:\n   254\t        links = _corrected(archive, cfg, conn, asked, directions, links, on_circle, transport, record)\n   255\t        remaining = circles(conn, links)\n   256\t        if remaining:\n   257\t            record['error'] = 'persistent cycle: ' + '; '.join(' -> '.join(path) for _, path in remaining)\n   258\t            raise Refused(record['error'], record)\n   259\t    record['proposed'] = links\n   260\t    return links, record\n   261\t\n   262\t\n   263\tdef _signed(archive, cfg, conn, asked, directions, transport, record, stage='sign'):\n   264\t    jobs, owners = [], []\n   265\t    for c, state, theses in asked:\n   266\t        questions = {f'sign__{v}': sign_question(jev_matching.thesis_text(conn, v), directions[(c['id'], v)]) for v in theses if (c['id'], v) in directions}\n   267\t        if questions:\n   268\t            jobs.append((state, questions))\n   269\t            owners.append(c)\n   270\t    links = []\n   271\t    if not jobs:\n   272\t        return links\n   273\t    for c, reply in zip(owners, _ask(archive, cfg, jobs, transport, record, stage)):\n   274\t        for qid, answer in sorted(reply.items()):\n   275\t            view_id = qid[len('sign__'):]\n   276\t            sign = _passes(answer, (TOGETHER, OPPOSITE))\n   277\t            record['pairs'].append({'candidate': c['id'], 'thesis': view_id, 'sign': answer['choice'], 'probabilities': answer['probabilities']})\n   278\t            if sign:\n   279\t                direction = directions[(c['id'], view_id)]\n   280\t                reader, read = (c['id'], view_id) if direction == CANDIDATE_READS else (view_id, c['id'])\n   281\t                links.append({'reader': reader, 'read': read, 'candidate': c['id'], 'thesis': view_id, 'direction': direction, 'sign': sign})\n   282\t    return links\n   283\t\n   284\t\n   285\tdef _corrected(archive, cfg, conn, asked, directions, links, on_circle, transport, record):\n   286\t    \"\"\"PRD 06: refuse a circle and ask the model to correct it, once: the pair's READS question again, the offending direction removed\n   287\t    and the circle named; the answer replaces the original.\"\"\"\n   288\t    offending = {(link['candidate'], link['thesis']): path for link, path in on_circle}\n   289\t    jobs, owners = [], []\n   290\t    for c, state, theses in asked:\n   291\t        questions = {}\n   292\t        for view_id in theses:\n   293\t            path = offending.get((c['id'], view_id))\n   294\t            if path is None:\n   295\t                continue\n   296\t            excluded = directions[(c['id'], view_id)]\n   297\t            named = [('the CANDIDATE' if node == c['id'] else 'the THESIS' if node == view_id else node) for node in path]\n   298\t            note = f'Reading this way would make {named[0]} read itself through {\" -> \".join(named)}; a question cannot read its own conclusion.'\n   299\t            questions[f'reads__{view_id}'] = reads_question(jev_matching.thesis_text(conn, view_id), excluded=excluded, note=note)\n   300\t            record['corrections'].append({'candidate': c['id'], 'thesis': view_id, 'rejected': excluded, 'path': path})\n   301\t        if questions:\n   302\t            jobs.append((state, questions))\n   303\t            owners.append(c)\n   304\t    kept = [link for link in links if (link['candidate'], link['thesis']) not in offending]\n   305\t    corrected = {}\n   306\t    for c, reply in zip(owners, _ask(archive, cfg, jobs, transport, record, 'correction')):\n   307\t        for qid, answer in reply.items():\n   308\t            view_id = qid[len('reads__'):]\n   309\t            directions.pop((c['id'], view_id), None)\n   310\t            direction = _passes(answer, (CANDIDATE_READS, THESIS_READS))\n   311\t            record['corrections'].append({'candidate': c['id'], 'thesis': view_id, 'answer': answer['choice'], 'probabilities': answer['probabilities']})\n   312\t            if direction:\n   313\t                corrected[(c['id'], view_id)] = direction\n   314\t    if corrected:\n   315\t        directions.update(corrected)\n   316\t        regrouped = [(c, state, [v for v in theses if (c['id'], v) in corrected]) for c, state, theses in asked]\n   317\t        kept += _signed(archive, cfg, conn, [g for g in regrouped if g[2]], corrected, transport, record, stage='correction sign')\n   318\t    return kept\n   319\t\n   320\t\n   321\t# ---------- the record ----------\n   322\t\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba ../../../src/hivemind/views/judging.py | sed -n '77,119p;125,198p;283,360p'\"","aggregated_output":"    77\tdef themes_in_force(conn, view_id):\n    78\t    \"\"\"The theme block of an asset thesis: every open theme thesis with a current state, with its rung label and whether a\n    79\t    changed conclusion was recorded after this thesis's last judgement. Empty for a theme thesis.\"\"\"\n    80\t    if store.view(conn, view_id)['object_kind'] == 'theme':\n    81\t        return []\n    82\t    last = store.current_state(conn, view_id)\n    83\t    out = []\n    84\t    for row in conn.execute(\"select view_id from views where object_kind='theme' order by view_id\"):\n    85\t        theme_id = row['view_id']\n    86\t        state = store.current_state(conn, theme_id)\n    87\t        if not state or not store.is_open(conn, theme_id):\n    88\t            continue\n    89\t        updated = bool(last) and bool(conn.execute('select 1 from judgements where view_id=? and changed=1 and judgement_id>? limit 1',\n    90\t                                                   (theme_id, last['judgement_id'])).fetchone())\n    91\t        rung = store.rungs_of(conn, theme_id)[state['rung'] - 1]\n    92\t        out.append({'view_id': theme_id, 'view': store.view(conn, theme_id), 'state': state, 'rung_label': rung['label'], 'updated': updated})\n    93\t    return out\n    94\t\n    95\t\n    96\tSTANCE_FIELDS = ['reference', 'implied_outcome']   # D260: what the market expects, and the figure or date the evidence implies\n    97\t\n    98\t\n    99\tclass JudgementRefused(Exception):\n   100\t    pass\n   101\t\n   102\t\n   103\tdef topological(conn, view_ids):\n   104\t    \"\"\"Dependencies first: a view comes after every view it depends on that is also in the set.\"\"\"\n   105\t    remaining = list(dict.fromkeys(view_ids))\n   106\t    ordered, placed = [], set()\n   107\t    while remaining:\n   108\t        progressed = False\n   109\t        for view_id in list(remaining):\n   110\t            deps = {d['resolved_to'] for d in store.dependencies_of(conn, view_id) if d['resolved_to']}\n   111\t            if deps.isdisjoint(set(remaining) - {view_id}) or deps <= placed:\n   112\t                ordered.append(view_id)\n   113\t                placed.add(view_id)\n   114\t                remaining.remove(view_id)\n   115\t                progressed = True\n   116\t        if not progressed:                 # a cycle slipped through: keep going in the given order\n   117\t            ordered.extend(remaining)\n   118\t            break\n   119\t    return ordered\n   125\t\n   126\t\n   127\tdef _dependency_lines_full(conn, target, d, state, rung_label, tv, flag):\n   128\t    \"\"\"judging-v8 (D694, design §3): the read judgement's comparison point and the system's forecast in full, labelled as ours, beside\n   129\t    the reasons excerpt; the read question not judged yet shows only that.\"\"\"\n   130\t    if not state:\n   131\t        return [f'- {target} ({flag}; {d[\"direction\"]}) {tv[\"question\"]}: now not judged yet']\n   132\t    return [f'- {target} ({flag}; {d[\"direction\"]}) {tv[\"question\"]}: now rung {state[\"rung\"]} {rung_label}, judged {state[\"publication_day\"]}',\n   133\t            f'    Comparison point stated by that judgement: {_indented(state.get(\"reference\") or \"not stated\")}',\n   134\t            f'    The system\\'s forecast for it (our own judgement, not evidence): {_indented(state.get(\"implied_outcome\") or \"not stated\")}',\n   135\t            f'    Reasons (excerpt): {_indented((state.get(\"reasons\") or \"\")[:600])}']\n   136\t\n   137\t\n   138\tdef _lines_english(conn, view_id, v, rungs, pieces, deps, last, themes=(), hidden=0, full_dependencies=False):\n   139\t    \"\"\"hidden: how many pieces in force are not shown. full_dependencies: the judging-v8 dependency block.\"\"\"\n   140\t    lines = [f'Thesis {view_id} ({v[\"object_id\"]}, {v[\"kind\"]}, focus \"{v[\"looks_at\"]}\", {v[\"year\"] or \"\"}, due {v[\"due_day\"]}): {v[\"question\"]}',\n   141\t             'Ladder: ' + ' / '.join(f'rung {r[\"position\"]} {r[\"label\"]}: {r[\"condition\"]}' for r in rungs), '',\n   142\t             f'[Evidence in view under this thesis, {len(pieces)} items]']\n   143\t    if hidden:\n   144\t        lines.append(f'[Not shown: {hidden} more pieces in force, read in earlier judgements; the previous conclusion carries them]')\n   145\t    for p in pieces:\n   146\t        src = p['sources'][0] if p['sources'] else {}\n   147\t        lines.append(f'- {p[\"evidence_id\"]} [{p[\"tier\"]}; {p[\"speaker\"]}; original source {p[\"original_who\"]} {p[\"original_day\"]}; from {src.get(\"input_id\")} {src.get(\"publication_day\")}] {p[\"one_line\"]}\\n    Quote: {p[\"quote\"][:400]}')\n   148\t        if p.get('replaced'):\n   149\t            lines.append(f'    It replaces {p[\"replaced\"][\"evidence_id\"]} ({p[\"replaced\"][\"original_day\"]}): {p[\"replaced\"][\"one_line\"]}')\n   150\t        if p.get('same_as'):\n   151\t            lines.append(f'    Opinion, not verified: the matcher read this as the same claim as {\", \".join(p[\"same_as\"])}; the argument counts one claim, one more outlet.')\n   152\t        if p.get('revises'):\n   153\t            lines.append(f'    Opinion, not verified: the matcher read it as a later version of {p[\"revises\"][\"evidence_id\"]} ({p[\"revises\"][\"original_day\"]}); both are in force: {p[\"revises\"][\"one_line\"]}')\n   154\t    if deps:\n   155\t        lines.append('\\n[Current conclusions of the theses it depends on]')\n   156\t        for d in deps:\n   157\t            target = d['resolved_to']\n   158\t            if not target:\n   159\t                lines.append(f'- the {d[\"wait_year\"]} thesis on chain {d[\"wait_chain_view_id\"]}: not yet created ({d[\"direction\"]})')\n   160\t                continue\n   161\t            tv = store.view(conn, target)\n   162\t            state = store.current_state(conn, target)\n   163\t            flag = 'historical only' if d['resolution'] == 'history_only' else ('closed' if not store.is_open(conn, target) else 'open')\n   164\t            rung_label = store.rungs_of(conn, target)[state['rung'] - 1]['label'] if state else 'not judged yet'\n   165\t            if full_dependencies:\n   166\t                lines.extend(_dependency_lines_full(conn, target, d, state, rung_label, tv, flag))\n   167\t                continue\n   168\t            lines.append(f'- {target} ({flag}; {d[\"direction\"]}) {tv[\"question\"]}: now rung {state[\"rung\"] if state else \"-\"} {rung_label}; reasons: {(state or {}).get(\"reasons\", \"\")[:600]}')\n   169\t    if themes:\n   170\t        lines.append(f'\\n[Themes in force, {len(themes)}]')\n   171\t        for theme in themes:\n   172\t            tv, state = theme['view'], theme['state']\n   173\t            mark = f'; {UPDATED_MARK}' if theme['updated'] else ''\n   174\t            lines.append(f'- {theme[\"view_id\"]} ({tv[\"object_id\"]}, due {tv[\"due_day\"]}) {tv[\"question\"]}: now rung {state[\"rung\"]} {theme[\"rung_label\"]}; '\n   175\t                         f'judged {state[\"publication_day\"]}{mark}; reasons: {(state[\"reasons\"] or \"\")[:THEME_REASONS_CHARS]}')\n   176\t    if last:\n   177\t        lines.append(f'\\n[Previous conclusion, for comparison only] rung {last[\"rung\"]}; reasons: {last[\"reasons\"][:800]}')\n   178\t    else:\n   179\t        lines.append('\\n[Previous conclusion] none: this is the first judgement, so changed must be true.')\n   180\t    lines.append('\\nAnswer per the JSON schema. cites may name only the evidence ids listed above; '\n   181\t                 + ('cites_views only the dependency thesis ids listed above' if deps else 'cites_views must be empty: this thesis depends on no other thesis')\n   182\t                 + ('; theme_pushes only the theme ids listed above; a theme id goes only in theme_pushes, never in cites or cites_views' if themes else '') + '.')\n   183\t    return lines\n   184\t\n   185\t\n   186\tdef build_prompt(conn, view_id, prompt_version):\n   187\t    require_supported(prompt_version)\n   188\t    v = store.view(conn, view_id)\n   189\t    rungs = store.rungs_of(conn, view_id)\n   190\t    pieces, hidden = evidence_in_view(conn, view_id)\n   191\t    deps = store.dependencies_of(conn, view_id)\n   192\t    last = store.current_state(conn, view_id)\n   193\t    lines = _lines_english(conn, view_id, v, rungs, pieces, deps, last, themes_in_force(conn, view_id), hidden=hidden,\n   194\t                           full_dependencies=prompt_version in FULL_DEPENDENCY_BLOCK)\n   195\t    with open(config.prompt_path(prompt_version + '.txt'), encoding='utf-8') as handle:\n   196\t        return handle.read(), '\\n'.join(lines)\n   197\t\n   198\t\n   283\tdef open_asset_views(conn):\n   284\t    return [v for v in store.open_views(conn) if store.view(conn, v)['object_kind'] != 'theme']\n   285\t\n   286\t\n   287\tdef queued_by_change(conn, view_id):\n   288\t    \"\"\"What a changed conclusion of this view queues: its dependants and, for a theme thesis, every open asset thesis. The one rule,\n   289\t    read for a live judgement and for the judgements a resumed round finds committed.\"\"\"\n   290\t    queued = store.dependants_of(conn, view_id)\n   291\t    if store.view(conn, view_id)['object_kind'] == 'theme':\n   292\t        queued = queued + open_asset_views(conn)\n   293\t    return queued\n   294\t\n   295\t\n   296\tdef queued_by_ledger(conn, seq):\n   297\t    \"\"\"What the judgements already committed at this sequence number queued; a fresh round finds nothing here, a resumed round\n   298\t    finds what the interrupted one had queued in memory.\"\"\"\n   299\t    queued = []\n   300\t    for row in conn.execute('select view_id from judgements where seq=? and changed=1 order by judgement_id', (seq,)):\n   301\t        queued.extend(queued_by_change(conn, row['view_id']))\n   302\t    return queued\n   303\t\n   304\t\n   305\tdef round_of_judgements(archive, cfg, conn, changed_views, seq, item, *, transport=None):\n   306\t    \"\"\"Judge the open views in changed_views, dependencies first; a changed conclusion queues open dependants.\n   307\t\n   308\t    Views that do not depend on each other are judged at the same time: each level of the dependency order is sent\n   309\t    to the model concurrently (the prompts are built and the answers checked and written in this thread, so the\n   310\t    database connection never crosses threads). A view waits while anything upstream of it is still pending, so a\n   311\t    dependant always reads this round's conclusion of its dependency. A view with no evidence in force stays\n   312\t    unjudged (D59), and a view already judged at this sequence number (a resumed round) is not judged twice.\n   313\t\n   314\t    Among the views ready to be judged, theme theses go first, so an asset thesis reads this round's theme conclusions; a theme judgement that says changed queues every open asset thesis with\n   315\t    evidence in force. The starting queue adds what the ledger says earlier commits at this sequence number queued.\"\"\"\n   316\t    import concurrent.futures\n   317\t\n   318\t    version = cfg.rejudging.prompt_version\n   319\t    schema = schema_for(version)\n   320\t\n   321\t    def eligible(view_id):\n   322\t        return store.is_open(conn, view_id) and not store.has_judgement(conn, view_id, seq) and bool(store.evidence_in_force(conn, view_id))\n   323\t\n   324\t    def is_theme(view_id):\n   325\t        return store.view(conn, view_id)['object_kind'] == 'theme'\n   326\t\n   327\t    pending = [v for v in topological(conn, list(changed_views) + queued_by_ledger(conn, seq)) if eligible(v)]\n   328\t    done, results = set(), []\n   329\t    while pending:\n   330\t        ready = [v for v in pending if upstream(conn, v).isdisjoint(set(pending) - {v})] or pending[:1]\n   331\t        level = [v for v in ready if is_theme(v)] or ready\n   332\t        prompts = {v: build_prompt(conn, v, version) for v in level}\n   333\t\n   334\t        def ask(view_id, note=''):\n   335\t            system, user = prompts[view_id]\n   336\t            return model.call(archive, cfg, cfg.rejudging, system, user + note, schema, 'judgement', 'judge', transport=transport)\n   337\t\n   338\t        with concurrent.futures.ThreadPoolExecutor(max_workers=JUDGE_WORKERS) as pool_:\n   339\t            answers = dict(zip(level, pool_.map(ask, level)))\n   340\t        for view_id in level:\n   341\t            answer = answers[view_id]\n   342\t            errors = check_answer(conn, view_id, answer.data, prompts[view_id][1])\n   343\t            if errors:\n   344\t                archive.retire(answer.call_id)                 # a refused answer never answers the same request again (a resume re-samples)\n   345\t                answer = ask(view_id, retry_note(errors))\n   346\t                errors = check_answer(conn, view_id, answer.data, prompts[view_id][1])\n   347\t                if errors:\n   348\t                    archive.retire(answer.call_id)\n   349\t                    raise JudgementRefused(f'{view_id}: ' + '; '.join(errors))\n   350\t            result = _record(conn, cfg, view_id, seq, item, answer)\n   351\t            done.add(view_id)\n   352\t            results.append(result)\n   353\t            if result['changed']:\n   354\t                for dependant in queued_by_change(conn, view_id):\n   355\t                    if dependant not in done and dependant not in pending and eligible(dependant):\n   356\t                        pending.append(dependant)\n   357\t        pending = [v for v in topological(conn, pending) if v not in done and eligible(v)]\n   358\t    return results\n","exit_code":0,"status":"completed"}}
