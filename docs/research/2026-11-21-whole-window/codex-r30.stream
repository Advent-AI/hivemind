  407\t  \"h4_double_count\": false,\n   408\t  \"h5\": false,\n   409\t  \"h1\": false\n   410\t },\n   411\t \"verdict\": [\n   412\t  \"pass\",\n   413\t  \"all three pairs improved\"\n   414\t ]\n   415\t}\n   416\t{\n   417\t \"a complete synthetic reading passes\": true,\n   418\t \"P rows only (no H review) is refused\": true,\n   419\t \"an unread H row is refused\": true,\n   420\t \"an incomplete gain review is refused\": true,\n   421\t \"every gain withdrawn by its reviews: not improved, fail\": true,\n   422\t \"an H4 double count fails\": true,\n   423\t \"a linked grounding error the control lacks fails\": true,\n   424\t \"two more H5 failures in a linked sequence fail\": true,\n   425\t \"a sequence the gate rejected makes it inconclusive\": true,\n   426\t \"a linked double refusal fails even with no P rows\": true,\n   427\t \"four more linked refusals on matched reader-days fail (H1)\": true,\n   428\t \"three more are tolerated (H1)\": true\n   429\t}\n   430\texit 0\n     1\t{\n     2\t \"old-2 reader judgements after their link days\": 247,\n     3\t \"structural H3 flags\": {\n     4\t  \"scope check\": 10,\n     5\t  \"own figure as market\": 80\n     6\t },\n     7\t \"fixed-date rows per sequence (4 readers x 7 dates, at most)\": 28\n     8\t}\n     9\t('v9', '2026-07-10', 'scope check', 'No FY2027 Data Center consensus or segment guidance is supplied, so there is no direct reference rung. The nearest company reference is $91 billion of total rev')\n    10\t('v9', '2026-07-12', 'own figure as market', \"No FY2027 Data Center consensus or segment guidance is supplied. The closest company reference is NVIDIA's $91B Q2 FY2027 total-revenue guidance, which, using Q\")\n    11\t('v9', '2026-07-13', 'scope check', \"No FY2027 Data Center consensus or segment guidance is supplied. The closest company reference is the $91B Q2 FY2027 total-revenue guide; using Q1 Data Center's\")\n    12\t('v9', '2026-07-14', 'own figure as market', 'No FY2027 Data