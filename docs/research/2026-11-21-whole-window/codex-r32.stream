{"type":"item.started","item":{"id":"item_14","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"python3 -B -c 'from pathlib import Path\nimport contextlib, copy, io, json, math\nfrom unittest.mock import patch\nimport verdict\nbase=Path(\\\"/private/tmp/claude-501/-Users-lchingen-hivemind/f1ea972d-85a1-4f27-8010-cf0b60054109/scratchpad\\\")\nout=base/\\\"paid-dry3\\\"\nfixture=base/\\\"e2e\\\"/\\\"pilot\\\"\nkey=json.loads((fixture/\\\"key.json\\\").read_text())\np=json.loads((fixture/\\\"p-read.json\\\").read_text())\nh=json.loads((fixture/\\\"h4.json\\\").read_text())\ng=json.loads((fixture/\\\"g.json\\\").read_text())\nfor r in g: r[\\\"reader\\\"].update({\\\"rule B material failure\\\":False, \\\"cpu increment\\\":\\\"none\\\"})\ndef decide(name,p,h,g):\n    values={\\\"/P\\\":p,\\\"/H\\\":h,\\\"/G\\\":g,\\\"/KEY\\\":key}\n    orig=Path.read_text\n    def read(self,*args,**kw):\n        if str(self) in values: return json.dumps(values[str(self)])\n        return orig(self,*args,**kw)\n    with patch.object(Path,\\\"read_text\\\",read), contextlib.redirect_stdout(io.StringIO()):\n        try: result=verdict.pilot_decision(out,\\\"/P\\\",\\\"/H\\\",\\\"/G\\\",\\\"/KEY\\\")\n        except verdict.Refused as e: result=(\\\"refused\\\",str(e))\n    print(name, result)\nfor seq in (\\\"linked-1\\\",\\\"control-1\\\"):\n    s=json.loads((out/seq/\\\"summary.json\\\").read_text())\n    print(seq, s[\\\"transport\\\"], len(s.get(\\\"days completed\\\",[])), s[\\\"acceptance\\\"][\\\"accepted\\\"])\ndecide(\\\"control fixture\\\",p,h,g)\nplain_p=[{k:r[k] for k in (\\\"part\\\",\\\"sequence\\\",\\\"segment judgement\\\",\\\"company judgement\\\",\\\"dates\\\")} | {\\\"reader\\\": {\\\"class\\\":r[\\\"reader\\\"][\\\"class\\\"], \\\"segment low\\\": None, \\\"segment high\\\":None}} for r in p]\nplain_h=[{\\\"part\\\":\\\"H4\\\",\\\"judgement\\\":r[\\\"judgement\\\"],\\\"reader\\\":{\\\"finding\\\":\\\"ok\\\"}} for r in h]\nplain_g=[{\\\"pair\\\":r[\\\"pair\\\"],\\\"judgement\\\":r[\\\"judgement\\\"],\\\"reader\\\":{\\\"rule B material failure\\\":False,\\\"cpu increment\\\":\\\"none\\\"}} for r in g]\ndecide(\\\"IDs and labels only, no forecasts, ranges, excerpts, or request evidence\\\",plain_p,plain_h,plain_g)\nh2=copy.deepcopy(h)\nh2[0][\\\"cpu_shown\\\"]=-1\nh2[0][\\\"request\\\"]=\\\"different request\\\"\nh2[0][\\\"paired arm in force\\\"]=None\ndecide(\\\"H4 row attached to the wrong inputs\\\",p,h2,g)\ng2=copy.deepcopy(g)\nfor r in g2:\n    if r[\\\"view\\\"]==\\\"v14\\\":\n        r[\\\"reader\\\"].update({\\\"cpu increment\\\":\\\"quantified\\\",\\\"corrected low\\\":370.0,\\\"corrected high\\\":370.0})\ndecide(\\\"proper CPU correction\\\",p,h,g2)\nfor r in g2:\n    if r[\\\"view\\\"]==\\\"v14\\\": r[\\\"reader\\\"][\\\"corrected high\\\"]=math.nan\ndecide(\\\"NaN CPU high\\\",p,h,g2)\np2=copy.deepcopy(p)\nfor r in p2:\n    if key[r[\\\"sequence\\\"]]==\\\"linked-1\\\":\n        r[\\\"reader\\\"].update({\\\"segment low\\\": 420.0,\\\"segment high\\\":420.0})\ndecide(\\\"linked labelled clear with segment 420 and company 400\\\",p2,h,g)\nh3=copy.deepcopy(h)+[{\\\"part\\\":\\\"H5\\\",\\\"reader\\\":{\\\"finding\\\":\\\"double count\\\"}}]\ndecide(\\\"stray H5 row says double count\\\",p,h3,g)\n'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
