ons\\\"])==c[\\\"questions\\\"] and purpose==\\\"match\\\"\n   if sha in juli:\n    assert juli[sha]==resp\n    used.append(sha[:12])\n   for key,v in ans.items():\n    target=key.split(\\\"__\\\")[1]\n    stage=c[\\\"stage\\\"]\n    assert parsed[(seq,target)][stage]==v[\\\"choice\\\"] and parsed[(seq,target)][\\\"p\\\" if stage==\\\"reads\\\" else \\\"sp\\\"]==v[\\\"probabilities\\\"]\n    if stage==\\\"reads\\\" and (seq,target) in watches and (seq,target) not in shown:\n     shown.add((seq,target))\n     print(\\\"PAIR\\\",seq,target,sha[:12])\n     print(req[\\\"state\\\"].splitlines()[0],req[\\\"state\\\"].splitlines()[-1])\n     print(\\\"\\\\n\\\".join(line for idx,line in enumerate(req[\\\"questions\\\"][key][\\\"instructions\\\"].splitlines()) if idx==1 or line.lstrip().startswith(\\\"Evidence:\\\")))\n  proposed=[]\n  for link in item[\\\"proposed\\\"]:\n   l=dict(link)\n   new=reg[\\\"{}:{}\\\".format(seq,l[\\\"thesis\\\"])][\\\"new\\\"]\n   for end in (\\\"reader\\\",\\\"read\\\"):\n    if l[end]==l[\\\"candidate\\\"]: l[end]=new\n   proposed.append(l)\n  assert not links.circles(g,proposed)\n  for l in proposed:\n   edges.append((seq,l[\\\"reader\\\"],l[\\\"read\\\"],l[\\\"sign\\\"]))\n   store.insert(g,\\\"dependencies\\\",view_id=l[\\\"reader\\\"],depends_on=l[\\\"read\\\"],kind=\\\"reads\\\",seq=seq)\n print(\\\"COUNTS\\\",dict(counts),\\\"reused\\\",used,\\\"calls paid\\\",sum(counts.values())-len(used),\\\"edges\\\",edges)\n print(\\\"score\\\",r.score([(str(i),parsed)],reg)[1])'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
