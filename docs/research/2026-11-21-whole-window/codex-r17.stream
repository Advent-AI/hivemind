{"type":"item.started","item":{"id":"item_13","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"PYTHONDONTWRITEBYTECODE=1 python3 -c 'import contextlib, json, sqlite3\nfrom pathlib import Path\nimport window_test as w\nimport read_census as r\nfrom hivemind.views import links, store\nfrom hivemind import model\nbase=(Path(\\\"../../..\\\").resolve()/\\\"poc/data/link-census-2026-11-21\\\")\nreg=json.loads(Path(\\\"expected-links.json\\\").read_text())\nwatches={(8,\\\"v1\\\"),(148,\\\"v9\\\"),(265,\\\"v14\\\"),(321,\\\"v16\\\"),(534,\\\"v16\\\"),(534,\\\"v9\\\"),(1238,\\\"v14\\\"),(1238,\\\"v9\\\")}\nshown=set()\ndef db(p): return sqlite3.connect(p.as_uri()+\\\"?mode=ro&immutable=1\\\",uri=True)\nfor i in (\\\"1\\\",\\\"2\\\",\\\"3\\\"):\n f=base/f\\\"census-{i}\\\"\n rec=json.loads((f/\\\"draw.json\\\").read_text())\n data=json.loads((f/\\\"census.json\\\").read_text())\n a=db(f/\\\"archive.sqlite\\\")\n views=db(f/\\\"views.sqlite\\\")\n starts={v:seq for v,seq in views.execute(\\\"select view_id,created_seq from views\\\")}\n juli=w.july_answers(i)\n parsed=r.decisions(f/\\\"views.sqlite\\\")\n counts={\\\"reads\\\":0,\\\"sign\\\":0}\n used=[]\n edges=[]\n g=sqlite3.connect(\\\":memory:\\\")\n g.row_factory=sqlite3.Row\n for table in (\\\"dependencies\\\",\\\"dependency_resolutions\\\"):g.execute(f\\\"create table {table} ({store.TABLES[table]})\\\")\n print(\\\"DRAW\\\",i,\\\"complete\\\",w.complete(data),\\\"unmet refusals\\\",data[\\\"left unmet\\\"],\\\"stored links\\\",views.execute(\\\"select count(*) from dependencies\\\").fetchone()[0])\n for item in data[\\\"openings with a pair shown\\\"]:\n  seq=item[\\\"seq\\\"]\n  for c in item[\\\"calls\\\"]:\n   counts[c[\\\"stage\\\"]]+=1\n   sha,req,resp,ans,purpose=a.execute(\\\"select request_sha256,request_json,response_json,answer_json,purpose from model_calls where call_id=?\\\",(c[\\\"call_id\\\"],)).fetchone()\n   req,resp,ans=map(json.loads,(req,resp,ans))\n   assert c[\\\"request_sha256\\\"]==sha==model.request_identity(req)[1] and resp[\\\"answers\\\"]==ans and sorted(req[\\\"questions\\\"])==c[\\\"questions\\\"] and purpose==\\\"match\\\"\n   if sha in juli:\n    assert juli[sha]==resp\n    used.append(sha[:12])\n   for key,v in ans.items():\n    if c[\\\"stage\\\"]==\\\"reads\\\":\n     target=key.split(\\\"__\\\")[1]\n     assert parsed[(seq,target)][\\\"reads\\\"]==v[\\\"choice\\\"] and parsed[(seq,target)][\\\"p\\\"]==v[\\\"probabilities\\\"]\n     if (seq,target) in watches and (seq,target) not in shown:\n      shown.add((seq,target))\n      print(\\\"PAIR\\\",seq,target,sha[:12])\n      print(req[\\\"state\\\"].splitlines()[0],req[\\\"state\\\"].splitlines()[-1])\n      print(\\\"\\\\n\\\".join(line for idx,line in enumerate(req[\\\"questions\\\"][key][\\\"instructions\\\"].splitlines()) if idx==1 or line.lstrip().startswith(\\\"Evidence:\\\")))\n    else:\n     target=key.split(\\\"__\\\")[1]\n     assert parsed[(seq,target)][\\\"sign\\\"]==v[\\\"choice\\\"] and parsed[(seq,target)][\\\"sp\\\"]==v[\\\"probabilities\\\"]\n  proposed=[]\n  new=[v for v,n in starts.items() if n==seq]\n  for link in item[\\\"proposed\\\"]:\n   l=dict(link)\n   for end in (\\\"reader\\\",\\\"read\\\"):\n    if l[end]==l[\\\"candidate\\\"]:\n     assert len(new)==1\n     l[end]=new[0]\n   proposed.append(l)\n  assert not links.circles(g,proposed)\n  for l in proposed:\n   edges.append((seq,l[\\\"reader\\\"],l[\\\"read\\\"],l[\\\"sign\\\"]))\n   store.insert(g,\\\"dependencies\\\",view_id=l[\\\"reader\\\"],depends_on=l[\\\"read\\\"],kind=\\\"reads\\\",seq=seq)\n print(\\\"COUNTS\\\",counts, \\\"reused\\\",used,\\\"calls paid\\\",sum(counts.values())-len(used),\\\"edges\\\",edges)\n scores=r.score([(str(i),parsed)],reg)[1]\n print(\\\"gate\\\",scores)'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
