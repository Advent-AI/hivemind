{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc 'nl -ba window_test.py'","aggregated_output":"     1\t\"\"\"The whole-window measurement of the linking version (poc-v119) against old-2 (poc-v118, 2026-07-01..09-20), D699.\n     2\t\n     3\t  python3 window_test.py neither <scratch>      # $0: poc-v119 over the whole window, every link question answered \"neither\", every\n     4\t                                                #     other request from a copy of old-2's archive; the result must equal old-2\n     5\t  python3 window_test.py census-dry <scratch>   # $0: the census pass with every eligible pair answered \"reads\"; must stay old-2\n     6\t  python3 window_test.py census <scratch> <draw> <ledger> <approved ceiling>   # paid (Jev only, at most $0.10, the ceiling Alex\n     7\t                                                #     names): the same pass with each link job sent to Jev and no link written, so the\n     8\t                                                #     replay stays old-2; one draw of the link decisions\n     9\t\n    10\tThe `neither` pass proves that poc-v119 without links is old-2 over all 1,884 articles (DESIGN.md table 3, first row, extended from the\n    11\tJuly prefix to the whole window), and lists every link question the version would ask: each opening of a number question with the\n    12\tnumber questions it was shown, the pairs eligible under D695, and the pairs not eligible with their reason.\n    13\t\"\"\"\n    14\timport json\n    15\timport math\n    16\timport shutil\n    17\timport sqlite3\n    18\timport sys\n    19\timport time\n    20\tfrom pathlib import Path\n    21\t\n    22\tREPO = Path(__file__).resolve().parents[3]\n    23\tJULY = REPO / 'docs/research/2026-11-20-production-readiness/dependency-design'\n    24\tsys.path.insert(0, str(REPO / 'src'))\n    25\tsys.path.insert(0, str(JULY))\n    26\tfrom hivemind import config, live_lock, model, replay, universe       # noqa: E402\n    27\tfrom hivemind.views import links                           # noqa: E402\n    28\timport july_test                                            # noqa: E402\n    29\timport rebuild_control                                      # noqa: E402\n    30\t\n    31\tHERE = Path(__file__).resolve().parent\n    32\t\n    33\tOLD2 = july_test.OLD2\n    34\tITEMS = july_test.ITEMS\n    35\tV119 = july_test.V119\n    36\tUNIVERSE = july_test.UNIVERSE\n    37\tWINDOW = ('2026-07-01', '2026-09-20')\n    38\t\n    39\t\n    40\tdef refused_rows():\n    41\t    \"\"\"old-2's answers its own run refused (the archive keeps them under the request's hash with a ':refused:' suffix, so no later\n    42\t    identical request is answered with them): {request hash: stored provider response}. A replay must meet each refusal again to\n    43\t    reach the stored retry.\"\"\"\n    44\t    stored = sqlite3.connect(f'file:{OLD2 / \"archive.sqlite\"}?mode=ro', uri=True)\n    45\t    return {sha.split(':refused:')[0]: json.loads(response) for sha, response in\n    46\t            stored.execute(\"select request_sha256, response_json from model_calls where request_sha256 like '%:refused:%' order by call_id\")}\n    47\t\n    48\t\n    49\tdef replay_window(folder, link_answer):\n    50\t    \"\"\"poc-v119 from an empty ledger over the whole window: link questions go to `link_answer`; every other request must be answered\n    51\t    from the copy of old-2's archive (an answer old-2's own run refused is given back once, so the check refuses it again); anything\n    52\t    else stops the pass. Returns the census: equality with old-2, every link job, every opening with its pairs.\"\"\"\n    53\t    if folder.exists():\n    54\t        raise SystemExit(f'{folder} exists: a pass starts from an empty folder')\n    55\t    folder.mkdir(parents=True)\n    56\t    shutil.copyfile(OLD2 / 'archive.sqlite', folder / 'archive.sqlite')\n    57\t    views = folder / 'views.sqlite'\n    58\t    marker = sqlite3.connect(views)                 # marked harness-only before the first item: ordinary writers refuse it (D694 §0)\n    59\t    marker.execute('create table harness_only (name text, day text)')\n    60\t    marker.execute(\"insert into harness_only values ('window_test.py', '2026-11-21')\")\n    61\t    marker.commit()\n    62\t    marker.close()\n    63\t    held = live_lock.acquire(str(views))            # the store lock for the whole pass: no second writer\n    64\t    asked, refused_again = [], []\n    65\t    stored_refusals = refused_rows()\n    66\t\n    67\t    def transport(*args):\n    68\t        if len(args) == 1 and july_test.is_link_request(args[0]):\n    69\t            asked.append(sorted(args[0]['questions']))\n    70\t            return link_answer(args[0])\n    71\t        response = stored_refusals.pop(model.request_identity(args[-1])[1], None)\n    72\t        if response is not None:                   # old-2's own run refused this answer: give it back, so the check refuses it again\n    73\t            refused_again.append(model.request_identity(args[-1])[1][:12])\n    74\t            return response\n    75\t        (folder / 'missed-request.json').write_text(json.dumps(args[-1], ensure_ascii=False, indent=1))\n    76\t        raise july_test.Stop('a request other than a link question missed the archive')\n    77\t    started = time.time()\n    78\t    try:\n    79\t        totals = replay.run(testdb_path=str(ITEMS), views_path=str(views), archive=model.Archive(str(folder / 'archive.sqlite')),\n    80\t                            cfg=config.load(str(V119)), universe=universe.load(str(UNIVERSE)), from_day=WINDOW[0], until_day=WINDOW[1],\n    81\t                            transport=transport, log=lambda *a: None, only_objects={'NVDA'})\n    82\t    finally:\n    83\t        live_lock.release(held)\n    84\t    print('totals:', totals, 'seconds:', round(time.time() - started))\n    85\t    conn = sqlite3.connect(f'file:{folder / \"views.sqlite\"}?mode=ro', uri=True)\n    86\t    last_seq = conn.execute('select max(seq) from days_completed').fetchone()[0]\n    87\t    stored_last = sqlite3.connect(f'file:{OLD2 / \"views.sqlite\"}?mode=ro', uri=True).execute('select max(seq) from days_completed').fetchone()[0]\n    88\t    print('last completed seq', last_seq, 'old-2', stored_last)\n    89\t    equal = last_seq == stored_last and rebuild_control.compare(folder / 'views.sqlite', last_seq)\n    90\t    openings = []\n    91\t    for attempt, seq, status, record_json in conn.execute('select attempt_id, seq, status, record_json from link_selections order by id'):\n    92\t        record = json.loads(record_json)\n    93\t        if status == 'proposed' and record.get('pairs'):\n    94\t            openings.append({'attempt': attempt, 'seq': seq, 'pairs': record['pairs'], 'calls': record.get('calls', []),\n    95\t                             'proposed': record.get('proposed', []), 'corrections': record.get('corrections', [])})\n    96\t    census = {'equal to old-2': equal, 'link jobs asked': len(asked), 'questions in them': sum(len(a) for a in asked),\n    97\t              \"old-2's refused answers met again\": refused_again, 'left unmet': sorted(sha[:12] for sha in stored_refusals),\n    98\t              'link rows written': conn.execute(\"select count(*) from dependencies where kind='reads'\").fetchone()[0],\n    99\t              'openings with a pair shown': openings}\n   100\t    (folder / 'census.json').write_text(json.dumps(census, indent=1))\n   101\t    print(json.dumps({k: v for k, v in census.items() if k != 'openings with a pair shown'}, indent=1))\n   102\t    for opening in openings:\n   103\t        eligible = [p['thesis'] for p in opening['pairs'] if p.get('eligible')]\n   104\t        print(opening['seq'], 'eligible', eligible, 'not eligible', len(opening['pairs']) - len(eligible))\n   105\t    return census\n   106\t\n   107\t\n   108\tdef neither(scratch):\n   109\t    return replay_window(scratch / 'neither-v119', july_test.fake_jev(set()))['equal to old-2']\n   110\t\n   111\t\n   112\tCENSUS_CEILING = 0.10\n   113\t\n   114\t\n   115\tclass Everything:\n   116\t    def __contains__(self, item):\n   117\t        return True\n   118\t\n   119\t\n   120\tdef without_links(run):\n   121\t    \"\"\"Run `run()` with the writer handed no proposed link (the census's only change to the product path).\"\"\"\n   122\t    from hivemind.views import writing\n   123\t    original_write = writing.write\n   124\t\n   125\t    def write_without_links(*args, **keywords):\n   126\t        keywords['proposed_links'] = None\n   127\t        return original_write(*args, **keywords)\n   128\t    writing.write = write_without_links\n   129\t    try:\n   130\t        return run()\n   131\t    finally:\n   132\t        writing.write = original_write\n   133\t\n   134\t\n   135\tdef complete(result):\n   136\t    \"\"\"A draw counts only when it asked every registered pair and finished each stage: the READS answers per opening are exactly the\n   137\t    eligible pairs of the `neither` pass, every READS answer that passed (a reading direction at 0.5 or more) has its SIGN answer, and\n   138\t    every Jev job was answered. Returns (complete, problems).\"\"\"\n   139\t    expected = {(o['seq'], p['thesis']) for o in json.loads((HERE / 'neither-census.json').read_text())['openings with a pair shown']\n   140\t                for p in o['pairs'] if p.get('eligible')}\n   141\t    problems, reads, signs = [], set(), set()\n   142\t    for opening in result['openings with a pair shown']:\n   143\t        for pair in opening['pairs']:\n   144\t            if 'reads' in pair:\n   145\t                reads.add((opening['seq'], pair['thesis']))\n   146\t                choice = pair['reads']\n   147\t                if choice != links.NEITHER and pair['probabilities'].get(choice, 0) >= links.THRESHOLD:\n   148\t                    signs.add((opening['seq'], pair['thesis']))\n   149\t        answered_signs = {(opening['seq'], p['thesis']) for p in opening['pairs'] if 'sign' in p}\n   150\t        missing = {s for s in signs if s[0] == opening['seq']} - answered_signs\n   151\t        if missing:\n   152\t            problems.append(f'seq {opening[\"seq\"]}: no SIGN answer for {sorted(missing)}')\n   153\t        problems += [f'seq {opening[\"seq\"]}: a job {c.get(\"stage\")} ended {c.get(\"status\")}' for c in opening['calls'] if c.get('status') != 'answered']\n   154\t    if reads != expected:\n   155\t        problems.append(f'READS pairs differ from the registered manifest: missing {sorted(expected - reads)}, extra {sorted(reads - expected)}')\n   156\t    return not problems, problems\n   157\t\n   158\t\n   159\tdef census_dry(scratch):\n   160\t    \"\"\"$0: the census pass with a fake Jev that answers every eligible pair \"the THESIS reads the CANDIDATE\", sign together (the\n   161\t    largest number of proposals); with the writer handed no link, the pass must still end equal to old-2 with no link row, and the\n   162\t    draw must be complete (every registered READS pair, a SIGN answer for each).\"\"\"\n   163\t    result = without_links(lambda: replay_window(scratch / 'census-dry', july_test.fake_jev(Everything())))\n   164\t    proposed = sum(len(o['proposed']) for o in result['openings with a pair shown'])\n   165\t    whole, problems = complete(result)\n   166\t    print('links proposed by the fake answers:', proposed, 'complete:', whole, problems)\n   167\t    return result['equal to old-2'] and result['link rows written'] == 0 and proposed == 105 and whole\n   168\t\n   169\t\n   170\tdef census(scratch, draw, ledger_path, approved):\n   171\t    \"\"\"One draw of the link decisions over the window: each link job sent to Jev as poc-v119 builds it, through the comparison runs'\n   172\t    reservation ledger (`july_test.budget_module`: Jev reserved at its published 64K limit for each of its three attempts); the\n   173\t    writer is handed no proposed link, so no link row is written and every later request stays old-2's (the pass checks equality at the\n   174\t    end). The ledger is created beforehand with the ceiling Alex approved; each draw registers its launcher, so the stop gate stops\n   175\t    every draw when one dies. A draw is counted only when it is complete and the ledger never stopped.\"\"\"\n   176\t    budget = july_test.budget_module()\n   177\t    if not (isinstance(approved, float) and math.isfinite(approved) and 0 < approved <= CENSUS_CEILING):\n   178\t        raise SystemExit(f'the approved ceiling must be a finite amount above 0 and at most ${CENSUS_CEILING}')\n   179\t    if not Path(ledger_path).exists():\n   180\t        raise SystemExit('the ledger does not exist: create it first (budget_replay.py --init-ledger L --ceiling <approved>)')\n   181\t    ledger = budget.SharedLedger(str(ledger_path))\n   182\t    ceiling = ledger.read()['ceiling']\n   183\t    if not (isinstance(ceiling, (int, float)) and math.isfinite(ceiling) and ceiling == approved):\n   184\t        raise SystemExit(f'the ledger ceiling {ceiling!r} is not the approved ${approved}: refused')\n   185\t    label = f'census-{draw}'\n   186\t    lock_handle = open(Path(ledger_path).with_name(f'{label}.launcher.lock'), 'a+')\n   187\t    if not ledger.claim_launcher(label, lock_handle):\n   188\t        raise SystemExit(f'another launch of {label} is running')\n   189\t    budget.install_stop_gate(ledger)\n   190\t    paid = budget.BudgetTransport(ledger)\n   191\t    result = without_links(lambda: replay_window(scratch / label, paid))\n   192\t    state = ledger.read()\n   193\t    ledger.remove_launcher(label)\n   194\t    whole, problems = complete(result)\n   195\t    print('ledger:', state, 'complete:', whole, problems)\n   196\t    return result['equal to old-2'] and result['link rows written'] == 0 and whole and not state.get('stopped') and not state['overrun']\n   197\t\n   198\t\n   199\tif __name__ == '__main__':\n   200\t    command, scratch = sys.argv[1], Path(sys.argv[2])\n   201\t    if command == 'neither':\n   202\t        sys.exit(0 if neither(scratch) else 1)\n   203\t    if command == 'census-dry':\n   204\t        sys.exit(0 if census_dry(scratch) else 1)\n   205\t    if command == 'census':\n   206\t        sys.exit(0 if census(scratch, sys.argv[3], Path(sys.argv[4]), float(sys.argv[5])) else 1)\n   207\t    raise SystemExit(f'unknown command {command}')\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_6","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc 'nl -ba expected_links.py; nl -ba expected-links.md'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc 'nl -ba expected_links.py; nl -ba expected-links.md'","aggregated_output":"     1\t\"\"\"The registered reading of every eligible pair of the census, written before any census answer is read (council R round 13): each\n     2\tof the 105 pairs of `neither-census.json` gets one class.\n     3\t\n     4\t  R  a required link, with its direction: a part read against its whole, the READS criterion's own first example (\"one product\n     5\t     line's sales against the company's total sales\") and D537's clear case (Data Center revenue reading total revenue). Missing it\n     6\t     is a miss; the opposite direction is a wrong link.\n     7\t  W  any link is wrong: neither answer bounds or drives the other (the criterion's \"neither\" class): a financing or commitment amount\n     8\t     against a revenue, growth or margin question (supply commitments excepted, below), and two financing amounts of different kinds.\n     9\t  O  open: defensible either way under the criterion as written (overlapping scopes; growth against the amount it is computed from;\n    10\t     another period of the same quantity; supply commitments against revenue or margin; gross margin against revenue). Reported, not\n    11\t     scored.\n    12\t\n    13\tThe seq-148 pairs were seen before this registration (the July test's answers): disclosed with every score.\n    14\t\n    15\t  python3 expected_links.py > expected-links.md\n    16\t\"\"\"\n    17\timport json\n    18\tfrom pathlib import Path\n    19\t\n    20\tHERE = Path(__file__).resolve().parent\n    21\tREQUIRED = {('v1', 'v2'): 'AI-cloud credit support is part of all customer and cloud-provider credit support, guarantees and backstops',\n    22\t            ('v9', 'v14'): 'Data Center revenue is part of total revenue (D537)',\n    23\t            ('v8', 'v14'): 'stand-alone CPU revenue is part of total revenue',\n    24\t            ('v16', 'v14'): 'total CPU revenue is part of total revenue',\n    25\t            ('v8', 'v16'): 'stand-alone CPU revenue is part of total CPU revenue'}\n    26\tFINANCING = {'v1', 'v2', 'v15', 'v29', 'v32', 'v36'}\n    27\tREVENUE = {'v8', 'v9', 'v14', 'v16', 'v17', 'v21', 'v35'}\n    28\tMARGIN = {'v28', 'v33'}\n    29\tOPEN_FINANCING = {frozenset({'v15', 'v32'}): 'a licence payment commitment may sit inside supply commitments',\n    30\t                  frozenset({'v29', 'v36'}): 'a convertible-bond investment may or may not count as an equity investment commitment'}\n    31\t\n    32\t\n    33\tdef classify(a, b):\n    34\t    \"\"\"(class, direction or None, reason) for the unordered pair a, b.\"\"\"\n    35\t    for (reader, read), reason in REQUIRED.items():\n    36\t        if {a, b} == {reader, read}:\n    37\t            return 'R', f'{reader} reads {read}', reason\n    38\t    pair = frozenset({a, b})\n    39\t    if pair in OPEN_FINANCING:\n    40\t        return 'O', None, OPEN_FINANCING[pair]\n    41\t    if 'v15' in pair and pair & (REVENUE | MARGIN):\n    42\t        return 'O', None, 'supply commitments are bought against expected revenue'\n    43\t    if pair <= FINANCING:\n    44\t        return 'W', None, 'two financing amounts of different kinds'\n    45\t    if pair & FINANCING and pair & (REVENUE | MARGIN):\n    46\t        return 'W', None, 'a financing amount against a revenue, growth or margin question'\n    47\t    return 'O', None, 'overlapping scopes, growth against its amount, another period, or margin against revenue'\n    48\t\n    49\t\n    50\tdef main():\n    51\t    census = json.loads((HERE / 'neither-census.json').read_text())\n    52\t    rows, counts = [], {'R': 0, 'W': 0, 'O': 0}\n    53\t    for opening in census['openings with a pair shown']:\n    54\t        for pair in opening['pairs']:\n    55\t            if not pair.get('eligible'):\n    56\t                continue\n    57\t            rows.append((opening['seq'], pair['thesis']))\n    58\t    import sqlite3\n    59\t    stored = sqlite3.connect('file:' + str(HERE.parents[2] / 'poc/data/comparison-2026-11-17/run/old-2/prod/views.sqlite') + '?mode=ro', uri=True)\n    60\t    new_at = {seq: stored.execute('select view_id from views where created_seq=? and view_id in (select view_id from view_keys)', (seq,)).fetchone()[0]\n    61\t              for seq, _ in rows}\n    62\t    out = {}\n    63\t    print('# Registered reading of the census pairs (written before any census answer; `expected_links.py`)\\n')\n    64\t    print('| seq | new | shown | class | required direction | reason |')\n    65\t    print('|---|---|---|---|---|---|')\n    66\t    for seq, thesis in rows:\n    67\t        kind, direction, reason = classify(new_at[seq], thesis)\n    68\t        counts[kind] += 1\n    69\t        out[f'{seq}:{thesis}'] = {'new': new_at[seq], 'shown': thesis, 'class': kind, 'direction': direction}\n    70\t        print(f'| {seq} | {new_at[seq]} | {thesis} | {kind} | {direction or \"\"} | {reason} |')\n    71\t    print(f'\\nPairs: {len(rows)}; R {counts[\"R\"]}, W {counts[\"W\"]}, O {counts[\"O\"]}. The seq-148 pairs were seen before this registration.')\n    72\t    (HERE / 'expected-links.json').write_text(json.dumps(out, indent=1))\n    73\t\n    74\t\n    75\tif __name__ == '__main__':\n    76\t    main()\n     1\t# Registered reading of the census pairs (written before any census answer; `expected_links.py`)\n     2\t\n     3\t| seq | new | shown | class | required direction | reason |\n     4\t|---|---|---|---|---|---|\n     5\t| 8 | v2 | v1 | R | v1 reads v2 | AI-cloud credit support is part of all customer and cloud-provider credit support, guarantees and backstops |\n     6\t| 49 | v8 | v1 | W |  | a financing amount against a revenue, growth or margin question |\n     7\t| 49 | v8 | v2 | W |  | a financing amount against a revenue, growth or margin question |\n     8\t| 62 | v9 | v8 | O |  | overlapping scopes, growth against its amount, another period, or margin against revenue |\n     9\t| 62 | v9 | v1 | W |  | a financing amount against a revenue, growth or margin question |\n    10\t| 62 | v9 | v2 | W |  | a financing amount against a revenue, growth or margin question |\n    11\t| 148 | v14 | v9 | R | v9 reads v14 | Data Center revenue is part of total revenue (D537) |\n    12\t| 148 | v14 | v8 | R | v8 reads v14 | stand-alone CPU revenue is part of total revenue |\n    13\t| 148 | v14 | v1 | W |  | a financing amount against a revenue, growth or margin question |\n    14\t| 148 | v14 | v2 | W |  | a financing amount against a revenue, growth or margin question |\n    15\t| 206 | v15 | v1 | W |  | two financing amounts of different kinds |\n    16\t| 206 | v15 | v2 | W |  | two financing amounts of different kinds |\n    17\t| 206 | v15 | v8 | O |  | supply commitments are bought against expected revenue |\n    18\t| 206 | v15 | v9 | O |  | supply commitments are bought against expected revenue |\n    19\t| 206 | v15 | v14 | O |  | supply commitments are bought against expected revenue |\n    20\t| 265 | v16 | v14 | R | v16 reads v14 | total CPU revenue is part of total revenue |\n    21\t| 265 | v16 | v8 | R | v8 reads v16 | stand-alone CPU revenue is part of total CPU revenue |\n    22\t| 265 | v16 | v9 | O |  | overlapping scopes, growth against its amount, another period, or margin against revenue |\n    23\t| 265 | v16 | v1 | W |  | a financing amount against a revenue, growth or margin question |\n    24\t| 265 | v16 | v15 | O |  | supply commitments are bought against expected revenue |\n    25\t| 265 | v16 | v2 | W |  | a financing amount against a revenue, growth or margin question |\n    26\t| 321 | v17 | v14 | O |  | overlapping scopes, growth against its amount, another period, or margin against revenue |\n    27\t| 321 | v17 | v16 | O |  | overlapping scopes, growth against its amount, another period, or margin against revenue |\n    28\t| 321 | v17 | v9 