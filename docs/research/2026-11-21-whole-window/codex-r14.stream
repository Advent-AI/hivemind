{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba read_census.py; nl -ba census-dry.log | sed -n '1,45p'\"","aggregated_output":"     1\t\"\"\"Score the census draws against the registered reading (`expected-links.json`, written before any census answer was read).\n     2\t\n     3\t  python3 read_census.py <census folder> [<census folder> ...] > census-result.md\n     4\t\n     5\tEach folder is one draw (`census-<n>/views.sqlite`, its `link_selections` rows). The three July answers to the seq-148 opening\n     6\t(`poc/data/july-link-test-2026-11-21/linked-{1,2,3}`, the same request) are added as three more draws of that opening.\n     7\t\n     8\tPer pair and draw: the READS answer (choice and probabilities), the SIGN answer when asked, and the decision the product takes (a link\n     9\tneeds a reading direction at 0.5 or more and a sign of together or opposite at 0.5 or more). Verdicts:\n    10\t  R pair: right (the registered direction linked), missed (no link), wrong (the opposite direction linked);\n    11\t  W pair: wrong (any link), right (no link);\n    12\t  O pair: reported only.\n    13\tA margin (the winning READS probability minus the next) below 0.10 on a linked or a required pair is flagged as fragile.\n    14\tThe gate (DESIGN.md §3): no wrong link in any draw, and v9 reads v14 linked in every draw.\n    15\t\"\"\"\n    16\timport json\n    17\timport sqlite3\n    18\timport sys\n    19\tfrom pathlib import Path\n    20\t\n    21\tHERE = Path(__file__).resolve().parent\n    22\tREPO = HERE.parents[2]\n    23\tJULY = REPO / 'poc/data/july-link-test-2026-11-21'\n    24\tTHRESHOLD = 0.5\n    25\tREADS = {'candidate_reads_thesis', 'thesis_reads_candidate'}\n    26\tSIGNS = {'together', 'opposite'}\n    27\t\n    28\t\n    29\tdef decisions(views_path):\n    30\t    \"\"\"{(seq, thesis): {'reads': choice, 'p': probabilities, 'sign': choice or None, 'sp': probabilities or None, 'new': view id}}\"\"\"\n    31\t    conn = sqlite3.connect(f'file:{views_path}?mode=ro', uri=True)\n    32\t    out = {}\n    33\t    for seq, record_json in conn.execute(\"select seq, record_json from link_selections where status='proposed' order by id\"):\n    34\t        record = json.loads(record_json)\n    35\t        for pair in record.get('pairs', []):\n    36\t            if 'thesis' not in pair:\n    37\t                continue\n    38\t            key = (seq, pair['thesis'])\n    39\t            entry = out.setdefault(key, {'reads': None, 'p': None, 'sign': None, 'sp': None})\n    40\t            if 'reads' in pair:\n    41\t                entry['reads'], entry['p'] = pair['reads'], pair['probabilities']\n    42\t            if 'sign' in pair:\n    43\t                entry['sign'], entry['sp'] = pair['sign'], pair['probabilities']\n    44\t    return out\n    45\t\n    46\t\n    47\tdef linked(entry, new, thesis):\n    48\t    \"\"\"The direction the product writes ('<reader> reads <read>') or None.\"\"\"\n    49\t    if entry['reads'] not in READS or entry['p'][entry['reads']] < THRESHOLD:\n    50\t        return None\n    51\t    if entry['sign'] not in SIGNS or entry['sp'][entry['sign']] < THRESHOLD:\n    52\t        return None\n    53\t    return f'{new} reads {thesis}' if entry['reads'] == 'candidate_reads_thesis' else f'{thesis} reads {new}'\n    54\t\n    55\t\n    56\tdef margin(entry):\n    57\t    values = sorted(entry['p'].values(), reverse=True)\n    58\t    return round(values[0] - values[1], 2)\n    59\t\n    60\t\n    61\tdef main():\n    62\t    expected = json.loads((HERE / 'expected-links.json').read_text())\n    63\t    draws = [(Path(f).name, decisions(Path(f) / 'views.sqlite')) for f in sys.argv[1:]]\n    64\t    draws += [(f'july-{s}', {k: v for k, v in decisions(JULY / s / 'views.sqlite').items() if k[0] == 148}) for s in ('linked-1', 'linked-2', 'linked-3')]\n    65\t    print('# Census of the link decisions over the window, scored against the registered reading\\n')\n    66\t    print('| seq | new | shown | class | registered | ' + ' | '.join(name for name, _ in draws) + ' |')\n    67\t    print('|---|---|---|---|---|' + '---|' * len(draws))\n    68\t    wrong, missed, right, fragile, gate_positive = [], [], [], [], []\n    69\t    for key, reg in expected.items():\n    70\t        seq, thesis = int(key.split(':')[0]), key.split(':')[1]\n    71\t        cells = []\n    72\t        for name, answers in draws:\n    73\t            entry = answers.get((seq, thesis))\n    74\t            if entry is None or entry['p'] is None:\n    75\t                cells.append('—')\n    76\t                continue\n    77\t            direction = linked(entry, reg['new'], thesis)\n    78\t            m = margin(entry)\n    79\t            short = {'candidate_reads_thesis': 'new→', 'thesis_reads_candidate': '←new', 'neither': 'none'}[entry['reads']]\n    80\t            cell = f\"{short} {entry['p'][entry['reads']]:.2f} (m {m:.2f})\" + (f\"; {entry['sign']} {entry['sp'][entry['sign']]:.2f}\" if entry['sign'] else '')\n    81\t            if reg['class'] == 'R':\n    82\t                verdict = 'right' if direction == reg['direction'] else ('missed' if direction is None else 'WRONG')\n    83\t            elif reg['class'] == 'W':\n    84\t                verdict = 'WRONG' if direction else 'right'\n    85\t            else:\n    86\t                verdict = f'linked: {direction}' if direction else 'no link'\n    87\t            if verdict == 'WRONG':\n    88\t                wrong.append((name, key, direction))\n    89\t            elif verdict == 'missed':\n    90\t                missed.append((name, key))\n    91\t            elif verdict == 'right' and reg['class'] == 'R':\n    92\t                right.append((name, key))\n    93\t            if (direction or reg['class'] == 'R') and m < 0.10:\n    94\t                fragile.append((name, key, m))\n    95\t            if key == '148:v9':\n    96\t                gate_positive.append(direction == 'v9 reads v14')\n    97\t            cells.append(f'{cell} → {verdict}')\n    98\t        print(f\"| {seq} | {reg['new']} | {thesis} | {reg['class']} | {reg['direction'] or ''} | \" + ' | '.join(cells) + ' |')\n    99\t    print(f'\\nDraws: {len(draws)} ({len(draws) - 3} census, 3 July at seq 148 only).')\n   100\t    print(f'Required links right: {len(right)}; missed: {len(missed)} {missed}')\n   101\t    print(f'Wrong links: {len(wrong)} {wrong}')\n   102\t    print(f'Fragile (margin below 0.10 on a linked or required pair): {len(fragile)} {fragile}')\n   103\t    gate = not wrong and bool(gate_positive) and all(gate_positive)\n   104\t    print(f'\\nGate (no wrong link in any draw; v9 reads v14 in every draw): {\"PASS\" if gate else \"FAIL\"}')\n   105\t\n   106\t\n   107\tif __name__ == '__main__':\n   108\t    main()\n     1\ttotals: {'items': 2077, 'extracted': 1884, 'skipped': 0, 'merged': 193, 'not_processed': 0, 'returned': 0, 'failed': 0, 'evidence': 5120, 'new_views': 43, 'judged': 1616, 'changed': 882, 'closed': 1} seconds: 382\n     2\tlast completed seq 1884 old-2 1884\n     3\tviews: rebuilt 43 stored 43 equal\n     4\tview_keys: rebuilt 43 stored 43 equal\n     5\tevidence: rebuilt 5102 stored 5102 equal\n     6\tevidence_links: rebuilt 6306 stored 6306 equal\n     7\tjudgements: rebuilt 1616 stored 1616 equal\n     8\trungs: rebuilt 137 stored 137 equal\n     9\tview_switches: rebuilt 44 stored 44 equal\n    10\tsuccessions: rebuilt 2 stored 2 equal\n    11\tdependencies: rebuilt 0 stored 0 equal\n    12\t{\n    13\t \"equal to old-2\": true,\n    14\t \"link jobs asked\": 28,\n    15\t \"questions in them\": 210,\n    16\t \"old-2's refused answers met again\": [\n    17\t  \"cfd45dde68ce\",\n    18\t  \"907eb29065b7\",\n    19\t  \"6d0c31a8460d\",\n    20\t  \"137e5f747345\"\n    21\t ],\n    22\t \"left unmet\": [],\n    23\t \"link rows written\": 0\n    24\t}\n    25\t8 eligible ['v1'] not eligible 3\n    26\t22 eligible [] not eligible 1\n    27\t42 eligible [] not eligible 2\n    28\t45 eligible [] not eligible 1\n    29\t49 eligible ['v1', 'v2'] not eligible 9\n    30\t62 eligible ['v8', 'v1', 'v2'] not eligible 11\n    31\t100 eligible [] not eligible 1\n    32\t101 eligible [] not eligible 1\n    33\t122 eligible [] not eligible 1\n    34\t145 eligible [] not eligible 1\n    35\t148 eligible ['v9', 'v8', 'v1', 'v2'] not eligible 17\n    36\t206 eligible ['v1', 'v2', 'v8', 'v9', 'v14'] not eligible 19\n    37\t265 eligible ['v14', 'v8', 'v9', 'v1', 'v15', 'v2'] not eligible 21\n    38\t321 eligible ['v14', 'v16', 'v9', 'v1', 'v8', 'v2', 'v15'] not eligible 23\n    39\t398 eligible [] not eligible 1\n    40\t456 eligible [] not eligible 1\n    41\t483 eligible [] not eligible 1\n    42\t534 eligible ['v17', 'v14', 'v16', 'v9', 'v1', 'v8', 'v15', 'v2'] not eligible 28\n    43\t546 eligible [] not eligible 1\n    44\t586 eligible [] not eligible 1\n    45\t590 eligible [] not eligible 1\n","exit_code":0,"status":"completed"}}
