{"type":"item.completed","item":{"id":"item_18","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba docs/research/2026-11-21-whole-window/verdict.py | sed -n '211,245p;340,404p'; nl -ba src/hivemind/views/judging.py | sed -n '110,198p'; nl -ba docs/research/2026-11-21-whole-window/PAID-DESIGN.md | sed -n '1,42p'\"","aggregated_output":"   211\t    return 'inconclusive', 'a pair undecided'\n   212\t\n   213\t\n   214\tH_FINDINGS = {'H3': ('ok', 'grounding error'), 'H4': ('ok', 'double count', 'supported increment', 'unresolved overlap'),\n   215\t              'H5': ('pass', 'material failure')}\n   216\tERROR_TYPES = ('own figure as market', 'company as segment consensus')\n   217\tH1_EXCESS = 4\n   218\tH5_EXCESS = 2\n   219\t\n   220\t\n   221\tdef h_key(row):\n   222\t    return (row['part'], row['sequence'], row['view'], row['judgement'], row.get('fixed_date'))\n   223\t\n   224\t\n   225\tdef h1(summaries):\n   226\t    \"\"\"Per pair: model refusals of readers on matched reader-days (judged in both arms), linked minus control; harm at 4 or more.\"\"\"\n   227\t    harm = {}\n   228\t    for n in ('1', '2', '3'):\n   229\t        linked, control = summaries[f'linked-{n}'], summaries[f'control-{n}']\n   230\t        days = {(j['view'], j['day']) for j in linked['reader judgements']} & {(j['view'], j['day']) for j in control['reader judgements']}\n   231\t\n   232\t        def refusals(summary):\n   233\t            return sum(1 for r in summary['archive judge rows written (dated)'] if r['reader'] and r['refused'] and (r['view'], r['day']) in days)\n   234\t        harm[n] = refusals(linked) - refusals(control) >= H1_EXCESS\n   235\t    return harm\n   236\t\n   237\t\n   238\tdef h_flags(h_rows):\n   239\t    \"\"\"H3, H4 and H5 from the read H rows.\"\"\"\n   240\t    by_key = {h_key(r): r for r in h_rows}\n   241\t    h3 = False\n   242\t    for row in h_rows:\n   243\t        if row['part'] == 'H3' and row['sequence'].startswith('linked') and row['reader']['finding'] == 'grounding error':\n   244\t            paired = row.get('paired arm in force') or {}\n   245\t            matched = [r for r in h_rows if r['part'] == 'H3' and r['sequence'] == paired.get('sequence') and r['judgement'] == paired.get('judgement')\n   340\t        by_read[r['judgement']] = r\n   341\t    if set(by_read) != set(by_expected):\n   342\t        raise Refused(f'{label}: {len(set(by_expected) - set(by_read))} expected rows missing, {len(set(by_read) - set(by_expected))} unexpected')\n   343\t    for j, r in by_read.items():\n   344\t        if any(r.get(k) != by_expected[j].get(k) for k in content):\n   345\t            raise Refused(f'{label}: judgement {j} differs from the row the stores give')\n   346\t\n   347\t\n   348\tdef pilot_decision(out, p_path, h4_path, gains_path, key_path, allow_dry=False):\n   349\t    \"\"\"The pilot's decision (D708) on pair 1 alone: continue, stop (not improved, undecided, or a harm), fail (a linked double refusal) or\n   350\t    inconclusive. It never gives the comparison's pass, which needs three pairs. The official decision needs the paid pair-1 summaries\n   351\t    (`allow_dry` is for the $0 checks only). Order (PAID-DESIGN.md §4): a linked double refusal; validity; coverage; harm; the control\n   352\t    floor; credited P.\"\"\"\n   353\t    import tempfile\n   354\t    import worksheet\n   355\t    summaries = {name: json.loads((Path(out) / name / 'summary.json').read_text()) for name in ('linked-1', 'control-1')}\n   356\t    if not allow_dry and any(s.get('transport') != 'paid' for s in summaries.values()):\n   357\t        raise Refused('the official pilot decision reads the paid pair-1 summaries')\n   358\t    if summaries['linked-1']['terminal'].get('outcome') == 'double refusal':\n   359\t        return report('fail', 'a linked double refusal')\n   360\t    if any(s['terminal'].get('outcome') != 'complete' for s in summaries.values()) or not all(s['acceptance']['accepted'] for s in summaries.values()):\n   361\t        return report('inconclusive', 'invalid or incomplete')\n   362\t    key = json.loads(Path(key_path).read_text())\n   363\t    if sorted(key.values()) != ['control-1', 'linked-1']:\n   364\t        raise Refused('the pilot key must name linked-1 and control-1')\n   365\t    p_read = json.loads(Path(p_path).read_text())\n   366\t    bind_p(p_read, key, out)\n   367\t    classes = read_classes(p_read, key, ('linked-1', 'control-1'))\n   368\t    h4 = [r for r in json.loads(Path(h4_path).read_text()) if r.get('part') == 'H4']\n   369\t    bind_rows(h4, [r for r in worksheet.h_rows(out, 'linked-1', None) if r['part'] == 'H4'], H4_CONTENT, 'H4')\n   370\t    for r in h4:\n   371\t        if r['reader'].get('finding') not in H_FINDINGS['H4'] or \\\n   372\t                not readings_complete(r['reader'], 'finding', H_FINDINGS['H4'], r['forecast'], r['reasons'], r['reference'], r['request']) or \\\n   373\t                not quoted(r['reader'].get('excerpt'), r['forecast'], r['reasons'], r['reference'], r['request']):\n   374\t            raise Refused(f'H4 judgement {r[\"judgement\"]}: the finding, its reading record or its quoted excerpt is missing')\n   375\t    window = calendar()\n   376\t    linked, control = classes['linked-1'], classes['control-1']\n   377\t    raw, detail = pair_outcome(linked, control, {}, window)\n   378\t    if raw == 'unreadable':\n   379\t        return report('inconclusive', 'coverage short', details=detail)\n   380\t    if any(r['reader']['finding'] == 'double count' for r in h4):\n   381\t        return report('stop', 'confirmed harm (H4 double count)')\n   382\t    pair_summaries = {f'{k}-{n}': summaries[f'{k}-1'] for k in ('linked', 'control') for n in ('1', '2', '3')}\n   383\t    if h1(pair_summaries)['1']:\n   384\t        return report('stop', 'confirmed harm (H1)')\n   385\t    if raw == 'untestable':\n   386\t        return report('inconclusive', 'control-1 under 2 definite dates', details=detail)\n   387\t    credit = {}\n   388\t    if raw == 'improved':\n   389\t        gains = json.loads(Path(gains_path).read_text())\n   390\t        with tempfile.TemporaryDirectory() as scratch:\n   391\t            (Path(scratch) / 'p.json').write_text(json.dumps(p_read))\n   392\t            expected = worksheet.gains(out, str(Path(scratch) / 'p.json'), key_path, str(Path(scratch) / 'g.json'))\n   393\t        bind_rows(gains, expected, GAIN_CONTENT, 'gain review')\n   394\t        credit = pair_credit(p_read, key, '1', linked, control, gains, window)\n   395\t    outcome, detail = pair_outcome(linked, control, credit, window)\n   396\t    decision = {'improved': ('continue', 'pair 1 improved after the gain review, H1 and H4 clear'),\n   397\t                'not improved': ('stop', 'pair 1 not improved'), 'undecided': ('stop', 'pair 1 undecided'),\n   398\t                'untestable': ('inconclusive', 'control-1 under 2 definite dates'), 'unreadable': ('inconclusive', 'coverage short')}[outcome]\n   399\t    return report(*decision, details=dict(detail, provisional=raw, adjusted=credit))\n   400\t\n   401\t\n   402\tdef report(outcome, reason, details=None):\n   403\t    print(json.dumps({'decision': [outcome, reason], **({'pair 1': details} if details else {})}, indent=1))\n   404\t    return outcome, reason\n   110\t            deps = {d['resolved_to'] for d in store.dependencies_of(conn, view_id) if d['resolved_to']}\n   111\t            if deps.isdisjoint(set(remaining) - {view_id}) or deps <= placed:\n   112\t                ordered.append(view_id)\n   113\t                placed.add(view_id)\n   114\t                remaining.remove(view_id)\n   115\t                progressed = True\n   116\t        if not progressed:                 # a cycle slipped through: keep going in the given order\n   117\t            ordered.extend(remaining)\n   118\t            break\n   119\t    return ordered\n   120\t\n   121\t\n   122\tdef _indented(text, indent='        '):\n   123\t    \"\"\"A stored value inside a block: every continuation line indented, so no physical line can read as a header or a listed id.\"\"\"\n   124\t    return str(text).replace('\\r\\n', '\\n').replace('\\n', '\\n' + indent)\n   125\t\n   126\t\n   127\tdef _dependency_lines_full(conn, target, d, state, rung_label, tv, flag):\n   128\t    \"\"\"judging-v8 (D694, design §3): the read judgement's comparison point and the system's forecast in full, labelled as ours, beside\n   129\t    the reasons excerpt; the read question not judged yet shows only that.\"\"\"\n   130\t    if not state:\n   131\t        return [f'- {target} ({flag}; {d[\"direction\"]}) {tv[\"question\"]}: now not judged yet']\n   132\t    return [f'- {target} ({flag}; {d[\"direction\"]}) {tv[\"question\"]}: now rung {state[\"rung\"]} {rung_label}, judged {state[\"publication_day\"]}',\n   133\t            f'    Comparison point stated by that judgement: {_indented(state.get(\"reference\") or \"not stated\")}',\n   134\t            f'    The system\\'s forecast for it (our own judgement, not evidence): {_indented(state.get(\"implied_outcome\") or \"not stated\")}',\n   135\t            f'    Reasons (excerpt): {_indented((state.get(\"reasons\") or \"\")[:600])}']\n   136\t\n   137\t\n   138\tdef _lines_english(conn, view_id, v, rungs, pieces, deps, last, themes=(), hidden=0, full_dependencies=False):\n   139\t    \"\"\"hidden: how many pieces in force are not shown. full_dependencies: the judging-v8 dependency block.\"\"\"\n   140\t    lines = [f'Thesis {view_id} ({v[\"object_id\"]}, {v[\"kind\"]}, focus \"{v[\"looks_at\"]}\", {v[\"year\"] or \"\"}, due {v[\"due_day\"]}): {v[\"question\"]}',\n   141\t             'Ladder: ' + ' / '.join(f'rung {r[\"position\"]} {r[\"label\"]}: {r[\"condition\"]}' for r in rungs), '',\n   142\t             f'[Evidence in view under this thesis, {len(pieces)} items]']\n   143\t    if hidden:\n   144\t        lines.append(f'[Not shown: {hidden} more pieces in force, read in earlier judgements; the previous conclusion carries them]')\n   145\t    for p in pieces:\n   146\t        src = p['sources'][0] if p['sources'] else {}\n   147\t        lines.append(f'- {p[\"evidence_id\"]} [{p[\"tier\"]}; {p[\"speaker\"]}; original source {p[\"original_who\"]} {p[\"original_day\"]}; from {src.get(\"input_id\")} {src.get(\"publication_day\")}] {p[\"one_line\"]}\\n    Quote: {p[\"quote\"][:400]}')\n   148\t        if p.get('replaced'):\n   149\t            lines.append(f'    It replaces {p[\"replaced\"][\"evidence_id\"]} ({p[\"replaced\"][\"original_day\"]}): {p[\"replaced\"][\"one_line\"]}')\n   150\t        if p.get('same_as'):\n   151\t            lines.append(f'    Opinion, not verified: the matcher read this as the same claim as {\", \".join(p[\"same_as\"])}; the argument counts one claim, one more outlet.')\n   152\t        if p.get('revises'):\n   153\t            lines.append(f'    Opinion, not verified: the matcher read it as a later version of {p[\"revises\"][\"evidence_id\"]} ({p[\"revises\"][\"original_day\"]}); both are in force: {p[\"revises\"][\"one_line\"]}')\n   154\t    if deps:\n   155\t        lines.append('\\n[Current conclusions of the theses it depends on]')\n   156\t        for d in deps:\n   157\t            target = d['resolved_to']\n   158\t            if not target:\n   159\t                lines.append(f'- the {d[\"wait_year\"]} thesis on chain {d[\"wait_chain_view_id\"]}: not yet created ({d[\"direction\"]})')\n   160\t                continue\n   161\t            tv = store.view(conn, target)\n   162\t            state = store.current_state(conn, target)\n   163\t            flag = 'historical only' if d['resolution'] == 'history_only' else ('closed' if not store.is_open(conn, target) else 'open')\n   164\t            rung_label = store.rungs_of(conn, target)[state['rung'] - 1]['label'] if state else 'not judged yet'\n   165\t            if full_dependencies:\n   166\t                lines.extend(_dependency_lines_full(conn, target, d, state, rung_label, tv, flag))\n   167\t                continue\n   168\t            lines.append(f'- {target} ({flag}; {d[\"direction\"]}) {tv[\"question\"]}: now rung {state[\"rung\"] if state else \"-\"} {rung_label}; reasons: {(state or {}).get(\"reasons\", \"\")[:600]}')\n   169\t    if themes:\n   170\t        lines.append(f'\\n[Themes in force, {len(themes)}]')\n   171\t        for theme in themes:\n   172\t            tv, state = theme['view'], theme['state']\n   173\t            mark = f'; {UPDATED_MARK}' if theme['updated'] else ''\n   174\t            lines.append(f'- {theme[\"view_id\"]} ({tv[\"object_id\"]}, due {tv[\"due_day\"]}) {tv[\"question\"]}: now rung {state[\"rung\"]} {theme[\"rung_label\"]}; '\n   175\t                         f'judged {state[\"publication_day\"]}{mark}; reasons: {(state[\"reasons\"] or \"\")[:THEME_REASONS_CHARS]}')\n   176\t    if last:\n   177\t        lines.append(f'\\n[Previous conclusion, for comparison only] rung {last[\"rung\"]}; reasons: {last[\"reasons\"][:800]}')\n   178\t    else:\n   179\t        lines.append('\\n[Previous conclusion] none: this is the first judgement, so changed must be true.')\n   180\t    lines.append('\\nAnswer per the JSON schema. cites may name only the evidence ids listed above; '\n   181\t                 + ('cites_views only the dependency thesis ids listed above' if deps else 'cites_views must be empty: this thesis depends on no other thesis')\n   182\t                 + ('; theme_pushes only the theme ids listed above; a theme id goes only in theme_pushes, never in cites or cites_views' if themes else '') + '.')\n   183\t    return lines\n   184\t\n   185\t\n   186\tdef build_prompt(conn, view_id, prompt_version):\n   187\t    require_supported(prompt_version)\n   188\t    v = store.view(conn, view_id)\n   189\t    rungs = store.rungs_of(conn, view_id)\n   190\t    pieces, hidden = evidence_in_view(conn, view_id)\n   191\t    deps = store.dependencies_of(conn, view_id)\n   192\t    last = store.current_state(conn, view_id)\n   193\t    lines = _lines_english(conn, view_id, v, rungs, pieces, deps, last, themes_in_force(conn, view_id), hidden=hidden,\n   194\t                           full_dependencies=prompt_version in FULL_DEPENDENCY_BLOCK)\n   195\t    with open(config.prompt_path(prompt_version + '.txt'), encoding='utf-8') as handle:\n   196\t        return handle.read(), '\\n'.join(lines)\n   197\t\n   198\t\n     1\t# The paid whole-window comparison of poc-v120 against fresh controls: design, version 7 (D699, D705, D706, D707; for council review)\n     2\t\n     3\tVersion 1 was reviewed in council R round 22 (`codex-r22.md`, NOT READY: four changes), version 2 in round 23 (`codex-r23.md`, NOT\n     4\tREADY: the reading rule and the freshness proof), version 3 in round 24 (`codex-r24.md`, NOT READY: three outcomes per pair, product\n     5\tagainst infrastructure failure, decisive gains traced, the worksheet), version 4 in round 25 (`codex-r25.md`, NOT READY: one rule for\n     6\tcredit), version 5 in round 26 (`codex-r26.md`, NOT READY: unquantifiable CPU gains marked together; coverage on the read classes); version 6\n     7\tpassed round 27; the build's reviews (rounds 28–29) changed H3's selection and the packets (§4, H3 and the worksheet); each finding is\n     8\tanswered below (§7).\n     9\t\n    10\t## 0. What it decides, and what it can reach\n    11\t\n    12\tIt decides whether linking (poc-v120: Jev's link questions version 2; judging-v8's fuller dependency block) makes the linked number\n    13\tquestions' judgements agree over the release window without harm elsewhere: the evidence for Alex's choice whether the linking version\n    14\treplaces poc-v118 (D699). It is paired on old-2's trajectory (DESIGN.md §1): every request byte-equal to one old-2 sent is answered with\n    15\told-2's answer; only the readers' judgements are bought.\n    16\t\n    17\t**The attainable verdict ($0):** Data Center FY2027 above total revenue FY2027 (`contradictions.py`, calendar dates 07-01..09-20,\n    18\tparser second version, before hand reading): old-1 11 days of 77, old-2 56 of 73, old-3 1 of 33 (that one a misparse,\n    19\t`parser-validation.md`). The class occurs and varies widely between draws; old-2's stored path is an extreme and not a fair control.\n    20\tA linked sequence that reconciles would show near zero; only fresh controls can serve as the baseline.\n    21\t\n    22\t## 1. Arms (paired by draw n = 1, 2, 3)\n    23\t\n    24\t- **linked-n:** poc-v120 from an empty store on its own copy of old-2's archive. Its link jobs are answered only by probe draw n's\n    25\t  answers, matched by request hash (`window_test.probe_answers`; any other link job stops the sequence before a purchase), so its links\n    26\t  are probe draw n's proposals, now written. Readers in all three draws: v9 (Data Center FY2027, reads v14), v14 (total revenue FY2027,\n    27\t  reads v8), v16 (total CPU FY2027, reads v14), v21 (revenue growth FY2027, reads v16, and v9 in draws 2 and 3).\n    28\t- **control-n:** poc-v118 from an empty store on its own copy of old-2's archive, its readers' old judgements retired as below.\n    29\t- **Fresh judgements, delimited by date (round 22):** a reader's link is written by an article of day D_R (v9, v14: 07-10, seq 148;\n    30\t  v16: seq 265's day; v21: seq 534's day); its first affected judgement is its first judgement on a day at or after D_R (old-2: seq 167,\n    31\t  274, 542). Every judgement of a reader on a day at or after D_R must be a fresh answer in both arms: in linked-n because its request\n    32\t  carries the dependency block, in control-n because the old request family is retired. The old family of a reader is identified by\n    33\t  reader and judgement day: every archive judge row of that reader (accepted answers, first attempts the stored run refused, and their\n    34\t  retries) whose judgement day is at or after D_R; archive rows carry no day, so a row is assigned to a day through old-2's\n    35\t  `judgements` table (accepted rows) and through its request text (the refused first attempts, whose request equals the retry's before\n    36\t  the correction lines). Every retired row is listed before the send and checked against old-2's judgements by reader and day.\n    37\t- **old-2's stored path:** a labelled historical baseline, outside the fresh-control figures.\n    38\t- All six sequences run at once, one paid call at a time within each (July's latch, round 22), one shared reservation ledger at the\n    39\t  ceiling Alex names.\n    40\t\n    41\t## 2. Harness rules (July's, `dependency-design/july_test.py`, extended to the window)\n    42\t\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_19","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"python3 -B -c 'import collections,json,pathlib,re,sqlite3,sys\nsys.path[:0]=['\\\\''src'\\\\'','\\\\''docs/research/2026-11-21-whole-window'\\\\'']\nfrom hivemind.views import judging\nimport contradictions\ndef op(p): return sqlite3.connect(pathlib.Path(p).resolve().as_uri()+'\\\\''?mode=ro'\\\\'',uri=True)\ndef distone(a,b):\n if a==b or abs(len(a)-len(b))>1: return False\n if len(a)==len(b): return sum(x\"'!=y for x,y in zip(a,b))==1\n s,l=sorted([a,b],key=len)\n return any(l[:i]+l[i+1:]==s for i in range(len(l)))\ndef view_of(t):\n return re.search(r'\"'\\\\''\"'^- (v'\"\\\\d+) \\\\('\\\\'',t,re.M).group(1) if False else t.splitlines()[0]\ndef group(text):\n return text.partition('\\\\''\\\\n\\\\nThe code returned the previous answer because: '\\\\'')[0]\nbase=sys.argv[1]\nfor run in ['\\\\''old-1'\\\\'','\\\\''old-2'\\\\'','\\\\''old-3'\\\\'','\\\\''control'\\\\'']:\n folder=base if run=='\\\\''control'\\\\'' else '\\\\''poc/data/comparison-2026-11-17/run/'\\\\''+run+'\\\\''/prod'\\\\''\n v,a=op(folder+'\\\\''/views.sqlite'\\\\''),op(folder+'\\\\''/archive.sqlite'\\\\'')\n a.row_factory=sqlite3.Row\n floor=8737 if run=='\\\\''control'\\\\'' else 0\n arows=list(a.execute(\\\"select * from model_calls where purpose='\\\\''judge'\\\\'' and call_id>? order by call_id\\\",(floor,)))\n prepared=[]\n for row in arows:\n  req=json.loads(row['\\\\''request_json'\\\\''])\n  t=req['\\\\''messages'\\\\''][-1]['\\\\''content'\\\\'']\n  prepared.append((row,t))\n print(run,'\\\\''archive judge calls'\\\\'',len(arows),'\\\\''refused'\\\\'',sum('\\\\'':refused:'\\\\'' in row['\\\\''request_sha256'\\\\''] for row in arows),\n       '\\\\''retry requests'\\\\'', sum(group(t)\"'!=t for row,t in prepared))\n for row,t in prepared:\n  if '\"'\\\\'':refused:'\\\\'' not in row['\\\\''request_sha256'\\\\''] and row['\\\\''call_id'\\\\'']\"'!=8809: continue\n  if row['\"'\\\\''call_id'\\\\'']==8809 and run\"'!='\"'\\\\''control'\\\\'': continue\n  data=json.loads(row['\\\\''answer_json'\\\\'']); ids=judging.evidence_shown_in(t); themes=judging.themes_shown_in(t)\n  cites=set(data['\\\\''cites'\\\\'']); pushes={p['\\\\''evidence_id'\\\\''] for p in data['\\\\''pushes'\\\\'']}; seen=cites|pushes\n  view_candidates=re.findall(r'\\\\''\"'^.*'\"\\\\bv\\\\d+\\\\b.*\"'$'\"'\\\\'', t[:400],re.M)\n  reject_fields={'\\\\''cites'\\\\'':sorted(cites-ids),'\\\\''pushes'\\\\'':sorted(pushes-ids),'\\\\''theme_pushes'\\\\'':sorted({p['\\\\''view_id'\\\\''] for p in data.get('\\\\''theme_pushes'\\\\'',[])}-themes),'\\\\''cites_views'\\\\'':data['\\\\''cites_views'\\\\'']}\n  near={i:sorted(ids2 for ids2 in ids if distone(i,ids2)) for i in sorted((seen-ids)&{i for i in seen if re.fullmatch('\\\\''e[0-9]+'\\\\'',i)})}\n  other_calls=[(r['\\\\''call_id'\\\\''],'\\\\'':refused:'\\\\'' in r['\\\\''request_sha256'\\\\'']) for r,txt in prepared if r['\\\\''call_id'\\\\'']>row['\\\\''call_id'\\\\''] and group(txt)==group(t) and txt\"'!=t]\n  print(row['\"'\\\\''call_id'\\\\''],view_candidates,reject_fields,'\\\\''near'\\\\'',near,'\\\\''n listed'\\\\'',len(ids),'\\\\''n cites'\\\\'',len(data['\\\\''cites'\\\\'']),'\\\\''cite missing'\\\\'',sorted(ids-cites) if row['\\\\''call_id'\\\\''] in (8938,8941) else len(ids-cites),'\\\\''n pushes'\\\\'',len(data['\\\\''pushes'\\\\'']),'\\\\''retry follow'\\\\'',other_calls,'\\\\''date & cost'\\\\'',row['\\\\''created_at'\\\\''],row['\\\\''cost_usd'\\\\''])\n  if row['\\\\''call_id'\\\\''] in (8938,8941) and run=='\\\\''control'\\\\'':\n   print('\\\\''retrynote'\\\\'',t[len(group(t)):], '\\\\''implied_outcome'\\\\'', data['\\\\''implied_outcome'\\\\''], '\\\\''shown lines'\\\\'', [line[:240] for line in t.splitlines() if re.match(r'\\\\''- (e3620|e3110|e3112) \\\\['\\\\'',line)])\n if run in ('\\\\''control'\\\\'','\\\\''old-2'\\\\''):\n  print('\\\\''parser summary'\\\\'', contradictions.pair(v),contradictions.summary(c