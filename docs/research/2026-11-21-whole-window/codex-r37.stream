 judged=29, changed=14, cost=0.0, cached_calls=28, failed='', dropped=0)\nrequests key views [('v16', 'exact cached request', 8940), ('v21', 'same request as 8938, corrected answer injected in memory'), ('v35', 'exact cached request', 7073), ('v35', 'exact cached request', 8936), ('v9', 'exact cached request', 8939)]\nwould retire [8936]\n8936 cites ['e3397', 'e3658', 'e3659', 'e3660', 'e3980', 'e3993', 'e4064', 'e4135', 'e4204', 'v10', 'v5', 'v6']\nday 09-08 new commits [('v14', 8937), ('v21', 8942), ('v9', 8939), ('v16', 8940)]\nday 09-08 processing marks [('failed', 'judgement refused twice: v21: e3111 is not among the evidence shown to v21; push on e3111 which was not shown to v21'), ('ok', '10 views changed, 29 judged, 14 changed conclusions')]\ndisk day 09-08 judgements still: 4\n","exit_code":0,"status":"completed"}}
