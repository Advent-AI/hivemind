{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba verdict.py | sed -n '40,125p;250,468p'; rg -n 'gain review|trace|unsupported|CPU|excerpt' e2e_checks.py\"","aggregated_output":"    40\t\n    41\timport math\n    42\t\n    43\tP_CONTENT = ('dates', 'segment forecast', 'segment reasons', 'company forecast', 'company reasons')\n    44\t\n    45\t\n    46\tdef finite_range(low, high):\n    47\t    return all(isinstance(v, (int, float)) and not isinstance(v, bool) and math.isfinite(v) for v in (low, high)) and low <= high\n    48\t\n    49\t\n    50\tdef readings_complete(fields, key_field, allowed):\n    51\t    \"\"\"The reading record: the first (Claude) and second (blind) readers' values, each one of `allowed`; when they differ, a third value\n    52\t    from a source-backed read with its source quoted (`third source`), which must be the final one; when they agree, the final value is\n    53\t    theirs.\"\"\"\n    54\t    first, second, third = fields.get(f'first {key_field}'), fields.get(f'second {key_field}'), fields.get(f'third {key_field}')\n    55\t    if first not in allowed or second not in allowed:\n    56\t        return False\n    57\t    if first == second:\n    58\t        return fields.get(key_field) == first\n    59\t    return third in allowed and bool(fields.get('third source')) and fields.get(key_field) == third\n    60\t\n    61\t\n    62\tdef quoted(excerpt, *texts):\n    63\t    \"\"\"An excerpt counts only when it is a non-empty piece of the text it was read from.\"\"\"\n    64\t    return isinstance(excerpt, str) and bool(excerpt.strip()) and any(excerpt in (text or '') for text in texts)\n    65\t\n    66\t\n    67\tdef check_p_row(row):\n    68\t    \"\"\"A read P row: the reading record complete; a resolved class carries finite, ordered FY2027 ranges for both answers with their\n    69\t    excerpts, and the class must be the one the ranges give (definite: segment low above company high; clear: segment high at or below\n    70\t    company low; overlap otherwise).\"\"\"\n    71\t    fields = row['reader']\n    72\t    if not readings_complete(fields, 'class', CLASSES):\n    73\t        raise Refused(f'{row[\"sequence\"]} {row[\"segment judgement\"]}/{row[\"company judgement\"]}: the reading record is incomplete')\n    74\t    if fields['class'] == 'unresolved':\n    75\t        return\n    76\t    s, c = (fields.get('segment low'), fields.get('segment high')), (fields.get('company low'), fields.get('company high'))\n    77\t    if not finite_range(*s) or not finite_range(*c):\n    78\t        raise Refused(f'{row[\"sequence\"]} {row[\"segment judgement\"]}/{row[\"company judgement\"]}: a resolved class needs both ranges')\n    79\t    if not quoted(fields.get('segment excerpt'), row['segment forecast'], row['segment reasons']) or \\\n    80\t            not quoted(fields.get('company excerpt'), row['company forecast'], row['company reasons']):\n    81\t        raise Refused(f'{row[\"sequence\"]} {row[\"segment judgement\"]}/{row[\"company judgement\"]}: an excerpt is not from its answer')\n    82\t    derived = 'definite' if s[0] > c[1] else ('clear' if s[1] <= c[0] else 'overlap')\n    83\t    if derived != fields['class']:\n    84\t        raise Refused(f'{row[\"sequence\"]} {row[\"segment judgement\"]}/{row[\"company judgement\"]}: class {fields[\"class\"]} but the ranges give {derived}')\n    85\t\n    86\t\n    87\tdef bind_p(rows, key, out):\n    88\t    \"\"\"Every read P row must be a row the stores give, content included (the two supplying judgement ids, the dates, both answers' full\n    89\t    forecast and reasons), and every row the stores give must be read; each row's reading is then checked (`check_p_row`).\"\"\"\n    90\t    import worksheet\n    91\t    expected = {}\n    92\t    for label, name in key.items():\n    93\t        for row in worksheet.p_rows(Path(out) / name, label):\n    94\t            expected[(label, row['segment judgement'], row['company judgement'])] = {k: row[k] for k in P_CONTENT}\n    95\t    read = {}\n    96\t    for row in rows:\n    97\t        if row.get('part') != 'P':\n    98\t            continue\n    99\t        k = (row['sequence'], row['segment judgement'], row['company judgement'])\n   100\t        if k in read:\n   101\t            raise Refused(f'{k}: read twice')\n   102\t        read[k] = {f: row.get(f) for f in P_CONTENT}\n   103\t    if read != expected:\n   104\t        missing, extra = set(expected) - set(read), set(read) - set(expected)\n   105\t        changed = [k for k in set(read) & set(expected) if read[k] != expected[k]]\n   106\t        raise Refused(f'the P reading is not the stores\\' pairs: {len(missing)} missing, {len(extra)} not in the stores, {len(changed)} changed')\n   107\t    for row in rows:\n   108\t        if row.get('part') == 'P':\n   109\t            check_p_row(row)\n   110\t\n   111\t\n   112\tdef read_classes(rows, key, sequences=SEQUENCES):\n   113\t    \"\"\"{sequence: {date: class}}, refusing anything but exactly one valid class per window date per sequence.\"\"\"\n   114\t    window = calendar()\n   115\t    out = {name: {} for name in sequences}\n   116\t    for row in rows:\n   117\t        if row.get('part') != 'P':\n   118\t            continue\n   119\t        name = key.get(row['sequence'])\n   120\t        if name not in out:\n   121\t            raise Refused(f'unknown sequence label {row[\"sequence\"]!r}')\n   122\t        value = row['reader']['class']\n   123\t        if value not in CLASSES:\n   124\t            raise Refused(f'{row[\"sequence\"]}: class {value!r} is not one of {CLASSES}')\n   125\t        for date in row['dates']:\n   250\t\n   251\tH_FINDINGS = {'H3': ('ok', 'grounding error'), 'H4': ('ok', 'double count', 'supported increment', 'unresolved overlap'),\n   252\t              'H5': ('pass', 'material failure')}\n   253\tERROR_TYPES = ('own figure as market', 'company as segment consensus')\n   254\tH1_EXCESS = 4\n   255\tH5_EXCESS = 2\n   256\t\n   257\t\n   258\tdef h_key(row):\n   259\t    return (row['part'], row['sequence'], row['view'], row['judgement'], row.get('fixed_date'))\n   260\t\n   261\t\n   262\tdef h1(summaries):\n   263\t    \"\"\"Per pair: model refusals of readers on matched reader-days (judged in both arms), linked minus control; harm at 4 or more.\"\"\"\n   264\t    harm = {}\n   265\t    for n in ('1', '2', '3'):\n   266\t        linked, control = summaries[f'linked-{n}'], summaries[f'control-{n}']\n   267\t        days = {(j['view'], j['day']) for j in linked['reader judgements']} & {(j['view'], j['day']) for j in control['reader judgements']}\n   268\t\n   269\t        def refusals(summary):\n   270\t            return sum(1 for r in summary['archive judge rows written (dated)'] if r['reader'] and r['refused'] and (r['view'], r['day']) in days)\n   271\t        harm[n] = refusals(linked) - refusals(control) >= H1_EXCESS\n   272\t    return harm\n   273\t\n   274\t\n   275\tdef h_flags(h_rows):\n   276\t    \"\"\"H3, H4 and H5 from the read H rows.\"\"\"\n   277\t    by_key = {h_key(r): r for r in h_rows}\n   278\t    h3 = False\n   279\t    for row in h_rows:\n   280\t        if row['part'] == 'H3' and row['sequence'].startswith('linked') and row['reader']['finding'] == 'grounding error':\n   281\t            paired = row.get('paired arm in force') or {}\n   282\t            matched = [r for r in h_rows if r['part'] == 'H3' and r['sequence'] == paired.get('sequence') and r['judgement'] == paired.get('judgement')\n   283\t                       and r['reader']['finding'] == 'grounding error' and r['reader']['error type'] == row['reader']['error type']]\n   284\t            if not matched:\n   285\t                h3 = True\n   286\t    h4 = any(r['part'] == 'H4' and r['reader']['finding'] == 'double count' for r in h_rows)\n   287\t    h5 = False\n   288\t    for n in ('1', '2', '3'):\n   289\t        def failures(name):\n   290\t            return sum(1 for r in h_rows if r['part'] == 'H5' and r['sequence'] == name and r['reader']['finding'] == 'material failure')\n   291\t        if failures(f'linked-{n}') - failures(f'control-{n}') >= H5_EXCESS:\n   292\t            h5 = True\n   293\t    return {'h3': h3, 'h4_double_count': h4, 'h5': h5}, by_key\n   294\t\n   295\t\n   296\tdef gain_credit(gain_rows, gain_dates, segment_ends):\n   297\t    \"\"\"{date: adjustment} from the reviews of each gain's two supplying linked answers (rounds 29–31): a material rule-B failure must say\n   298\t    whether the reconciliation rests on it, and withdraws credit when it does ('none'); an unquantifiable CPU increment makes the date\n   299\t    unresolved (every such date marked before the pair's bounds are recomputed once); a quantified one gives the company's corrected FY2027\n   300\t    range, compared on each gain date with that date's segment range as read: definite when the segment's low end exceeds the corrected\n   301\t    high end, overlap or clear otherwise.\"\"\"\n   302\t    by_judgement = {}\n   303\t    for r in gain_rows:\n   304\t        if r['judgement'] in by_judgement:\n   305\t            raise Refused(f'gain review of judgement {r[\"judgement\"]} given twice')\n   306\t        by_judgement[r['judgement']] = r\n   307\t    credit = {}\n   308\t    for date, judgement_ids in gain_dates.items():\n   309\t        reviews = [by_judgement.get(j) for j in judgement_ids]\n   310\t        if any(r is None for r in reviews):\n   311\t            raise Refused(f'{date}: a supplying answer has no gain review')\n   312\t        for r in reviews:\n   313\t            fields = r['reader']\n   314\t            if not isinstance(fields.get('rule B material failure'), bool) or fields.get('cpu increment') not in ('none', 'quantified', 'unquantifiable'):\n   315\t                raise Refused(f'gain review of judgement {r[\"judgement\"]} is incomplete')\n   316\t            if fields['rule B material failure'] and not isinstance(fields.get('reconciliation rests on it'), bool):\n   317\t                raise Refused(f'gain review of judgement {r[\"judgement\"]}: a material failure needs a finding on reliance')\n   318\t            if fields['cpu increment'] == 'quantified' and not finite_range(fields.get('corrected low'), fields.get('corrected high')):\n   319\t                raise Refused(f'gain review of judgement {r[\"judgement\"]}: a quantified CPU increment needs the corrected range')\n   320\t        if any(r['reader']['rule B material failure'] and r['reader']['reconciliation rests on it'] for r in reviews):\n   321\t            credit[date] = 'none'\n   322\t        elif any(r['reader']['cpu increment'] == 'unquantifiable' for r in reviews):\n   323\t            credit[date] = 'unresolved'\n   324\t        else:\n   325\t            corrected = [r['reader'] for r in reviews if r['reader']['cpu increment'] == 'quantified']\n   326\t            if corrected:\n   327\t                low, high = segment_ends[date]\n   328\t                c = corrected[0]\n   329\t                credit[date] = 'definite' if low > c['corrected high'] else ('clear' if high <= c['corrected low'] else 'overlap')\n   330\t    return credit\n   331\t\n   332\t\n   333\tdef gain_credit(gain_rows, gain_dates, segment_ends, company_ends=None):\n   334\t    \"\"\"{date: adjustment} from the reviews of each gain's two supplying linked answers (rounds 29–33). Every review quotes its rule-B trace\n   335\t    from the answer (`rule B trace`); a material failure must say whether the reconciliation rests on it, and withdraws credit when it does\n   336\t    ('none'); a CPU increment is reviewed only on the company (v14) answer: unquantifiable makes the date unresolved (every such date\n   337\t    marked before the pair's bounds are recomputed once); quantified needs the increment removed and a corrected range equal to the\n   338\t    company's read range minus it, compared on each gain date with that date's segment range: definite when the segment's low end exceeds\n   339\t    the corrected high end, clear when the segment's high end is at or below the corrected low end, overlap otherwise.\"\"\"\n   340\t    by_judgement = {}\n   341\t    for r in gain_rows:\n   342\t        if r['judgement'] in by_judgement:\n   343\t            raise Refused(f'gain review of judgement {r[\"judgement\"]} given twice')\n   344\t        by_judgement[r['judgement']] = r\n   345\t    credit = {}\n   346\t    for date, judgement_ids in gain_dates.items():\n   347\t        reviews = [by_judgement.get(j) for j in judgement_ids]\n   348\t        if any(r is None for r in reviews):\n   349\t            raise Refused(f'{date}: a supplying answer has no gain review')\n   350\t        for r in reviews:\n   351\t            fields = r['reader']\n   352\t            if not isinstance(fields.get('rule B material failure'), bool) or fields.get('cpu increment') not in ('none', 'quantified', 'unquantifiable'):\n   353\t                raise Refused(f'gain review of judgement {r[\"judgement\"]} is incomplete')\n   354\t            if not quoted(fields.get('rule B trace'), r.get('forecast'), r.get('reasons'), r.get('request')):\n   355\t                raise Refused(f'gain review of judgement {r[\"judgement\"]}: no rule-B trace quoted from the answer')\n   356\t            if fields['rule B material failure'] and not isinstance(fields.get('reconciliation rests on it'), bool):\n   357\t                raise Refused(f'gain review of judgement {r[\"judgement\"]}: a material failure needs a finding on reliance')\n   358\t            if fields['cpu increment'] != 'none' and r.get('view') != 'v14':\n   359\t                raise Refused(f'gain review of judgement {r[\"judgement\"]}: a CPU increment is reviewed only on the total-revenue answer')\n   360\t            if fields['cpu increment'] == 'quantified':\n   361\t                increment = fields.get('increment removed')\n   362\t                original = (company_ends or {}).get(r['judgement'])\n   363\t                if not finite_range(fields.get('corrected low'), fields.get('corrected high')) or not finite_range(0.0, increment if isinstance(increment, (int, float)) else float('nan')) \\\n   364\t                        or increment <= 0 or original is None or \\\n   365\t                        abs(fields['corrected low'] - (original[0] - increment)) > 0.05 or abs(fields['corrected high'] - (original[1] - increment)) > 0.05:\n   366\t                    raise Refused(f'gain review of judgement {r[\"judgement\"]}: the corrected range is not the read range minus the increment removed')\n   367\t        if any(r['reader']['rule B material failure'] and r['reader']['reconciliation rests on it'] for r in reviews):\n   368\t            credit[date] = 'none'\n   369\t        elif any(r['reader']['cpu increment'] == 'unquantifiable' for r in reviews):\n   370\t            credit[date] = 'unresolved'\n   371\t        else:\n   372\t            corrected = [r['reader'] for r in reviews if r['reader']['cpu increment'] == 'quantified']\n   373\t            if corrected:\n   374\t                low, high = segment_ends[date]\n   375\t                c = corrected[0]\n   376\t                credit[date] = 'definite' if low > c['corrected high'] else ('clear' if high <= c['corrected low'] else 'overlap')\n   377\t    return credit\n   378\t\n   379\t\n   380\tdef pair_credit(p_read, key, n, linked, control, gain_rows, window):\n   381\t    rows = [r for r in p_read if key[r['sequence']] == f'linked-{n}']\n   382\t    supplying = {d: (r['segment judgement'], r['company judgement']) for r in rows for d in r['dates']}\n   383\t    ends = {d: (r['reader']['segment low'], r['reader']['segment high']) for r in rows for d in r['dates']}\n   384\t    company_ends = {}\n   385\t    for r in rows:\n   386\t        value = (r['reader']['company low'], r['reader']['company high'])\n   387\t        if r['reader']['class'] != 'unresolved':\n   388\t            if company_ends.setdefault(r['company judgement'], value) != value:\n   389\t                raise Refused(f'company judgement {r[\"company judgement\"]} read with two different ranges')\n   390\t    gain_dates = {d: supplying[d] for d in window if linked[d] in ('overlap', 'clear') and control[d] == 'definite'}\n   391\t    return gain_credit([g for g in gain_rows if g['pair'] == n], gain_dates, ends, company_ends)\n   392\t\n   393\t\n   394\tH4_CONTENT = ('view', 'judgement', 'day', 'forecast', 'reasons', 'reference', 'request', 'shown', 'trace', 'paired arm in force', 'cpu_shown')\n   395\tGAIN_CONTENT = ('pair', 'judgement', 'view', 'day', 'forecast', 'reasons', 'reference', 'request', 'gain dates')\n   396\t\n   397\t\n   398\tdef bind_rows(read, expected, content, label):\n   399\t    by_read, by_expected = {}, {r['judgement']: r for r in expected}\n   400\t    for r in read:\n   401\t        if r['judgement'] in by_read:\n   402\t            raise Refused(f'{label}: judgement {r[\"judgement\"]} read twice')\n   403\t        by_read[r['judgement']] = r\n   404\t    if set(by_read) != set(by_expected):\n   405\t        raise Refused(f'{label}: {len(set(by_expected) - set(by_read))} expected rows missing, {len(set(by_read) - set(by_expected))} unexpected')\n   406\t    for j, r in by_read.items():\n   407\t        if any(r.get(k) != by_expected[j].get(k) for k in content):\n   408\t            raise Refused(f'{label}: judgement {j} differs from the row the stores give')\n   409\t\n   410\t\n   411\tdef pilot_decision(out, p_path, h4_path, gains_path, key_path, allow_dry=False):\n   412\t    \"\"\"The pilot's decision (D708) on pair 1 alone: continue, stop (not improved, undecided, or a harm), fail (a linked double refusal) or\n   413\t    inconclusive. It never gives the comparison's pass, which needs three pairs. The official decision needs the paid pair-1 summaries\n   414\t    (`allow_dry` is for the $0 checks only). Order (PAID-DESIGN.md §4): a linked double refusal; validity; coverage; harm; the control\n   415\t    floor; credited P.\"\"\"\n   416\t    import tempfile\n   417\t    import worksheet\n   418\t    summaries = {name: json.loads((Path(out) / name / 'summary.json').read_text()) for name in ('linked-1', 'control-1')}\n   419\t    if not allow_dry and any(s.get('transport') != 'paid' for s in summaries.values()):\n   420\t        raise Refused('the official pilot decision reads the paid pair-1 summaries')\n   421\t    if summaries['linked-1']['terminal'].get('outcome') == 'double refusal':\n   422\t        return report('fail', 'a linked double refusal')\n   423\t    if any(s['terminal'].get('outcome') != 'complete' for s in summaries.values()) or not all(s['acceptance']['accepted'] for s in summaries.values()):\n   424\t        return report('inconclusive', 'invalid or incomplete')\n   425\t    key = json.loads(Path(key_path).read_text())\n   426\t    if sorted(key.values()) != ['control-1', 'linked-1']:\n   427\t        raise Refused('the pilot key must name linked-1 and control-1')\n   428\t    p_read = json.loads(Path(p_path).read_text())\n   429\t    bind_p(p_read, key, out)\n   430\t    classes = read_classes(p_read, key, ('linked-1', 'control-1'))\n   431\t    h4 = [r for r in json.loads(Path(h4_path).read_text()) if r.get('part') == 'H4']\n   432\t    bind_rows(h4, [r for r in worksheet.h_rows(out, 'linked-1', None) if r['part'] == 'H4'], H4_CONTENT, 'H4')\n   433\t    for r in h4:\n   434\t        if r['reader'].get('finding') not in H_FINDINGS['H4'] or not readings_complete(r['reader'], 'finding', H_FINDINGS['H4']) or \\\n   435\t                not quoted(r['reader'].get('excerpt'), r['forecast'], r['reasons'], r['reference'], r['request']):\n   436\t            raise Refused(f'H4 judgement {r[\"judgement\"]}: the finding, its reading record or its quoted excerpt is missing')\n   437\t    window = calendar()\n   438\t    linked, control = classes['linked-1'], classes['control-1']\n   439\t    raw, detail = pair_outcome(linked, control, {}, window)\n   440\t    if raw == 'unreadable':\n   441\t        return report('inconclusive', 'coverage short', details=detail)\n   442\t    if any(r['reader']['finding'] == 'double count' for r in h4):\n   443\t        return report('stop', 'confirmed harm (H4 double count)')\n   444\t    pair_summaries = {f'{k}-{n}': summaries[f'{k}-1'] for k in ('linked', 'control') for n in ('1', '2', '3')}\n   445\t    if h1(pair_summaries)['1']:\n   446\t        return report('stop', 'confirmed harm (H1)')\n   447\t    if raw == 'untestable':\n   448\t        return report('inconclusive', 'control-1 under 2 definite dates', details=detail)\n   449\t    credit = {}\n   450\t    if raw == 'improved':\n   451\t        gains = json.loads(Path(gains_path).read_text())\n   452\t        with tempfile.TemporaryDirectory() as scratch:\n   453\t            (Path(scratch) / 'p.json').write_text(json.dumps(p_read))\n   454\t            expected = worksheet.gains(out, str(Path(scratch) / 'p.json'), key_path, str(Path(scratch) / 'g.json'))\n   455\t        bind_rows(gains, expected, GAIN_CONTENT, 'gain review')\n   456\t        credit = pair_credit(p_read, key, '1', linked, control, gains, window)\n   457\t    outcome, detail = pair_outcome(linked, control, credit, window)\n   458\t    decision = {'improved': ('continue', 'pair 1 improved after the gain review, H1 and H4 clear'),\n   459\t                'not improved': ('stop', 'pair 1 not improved'), 'undecided': ('stop', 'pair 1 undecided'),\n   460\t                'untestable': ('inconclusive', 'control-1 under 2 definite dates'), 'unreadable': ('inconclusive', 'coverage short')}[outcome]\n   461\t    return report(*decision, details=dict(detail, provisional=raw, adjusted=credit))\n   462\t\n   463\t\n   464\tdef report(outcome, reason, details=None):\n   465\t    print(json.dumps({'decision': [outcome, reason], **({'pair 1': details} if details else {})}, indent=1))\n   466\t    return outcome, reason\n   467\t\n   468\t\n47:        row['reader'].update({'finding': finding, 'first finding': finding, 'second finding': finding, 'excerpt': row['forecast'][:9]})\n52:    \"\"\"A P reading with its record: both readers agree; ranges and excerpts consistent with the class.\"\"\"\n55:                          'company low': 400.0, 'company high': 400.0, 'segment excerpt': row['segment forecast'][:9],\n56:                          'company excerpt': row['company forecast'][:9]})\n82:        g['reader'].update({'rule B material failure': False, 'cpu increment': 'none', 'rule B trace': g['forecast'][:9]})\n92:    results['an incomplete gain review is refused'] = outcome(out, write(scratch, p, h, g_bad), key_path)[0] == 'refused'\n156:        row['reader'].update({'finding': 'ok', 'first finding': 'ok', 'second finding': 'ok', 'excerpt': row['forecast'][:9]})\n160:        g['reader'].update({'rule B material failure': False, 'cpu increment': 'none', 'rule B trace': g['forecast'][:9]})\n183:    results['pilot: a quantified CPU correction is applied per gain date (the gains become definite: stop)'] = \\\n189:    results['pilot: every unquantifiable CPU gain unresolved together (stop: undecided)'] = decide(p, h4, unquantified) == ('stop', 'pair 1 undecided')\n226:                                                                                  'corrected high': 375.0, 'rule B trace': '$405B'}},\n227:            {'judgement': 2, 'view': 'v9', 'forecast': 'about $360B', 'reader': {'rule B material failure': False, 'cpu increment': 'none', 'rule B trace': '$360B'}},\n228:            {'judgement': 3, 'view': 'v9', 'forecast': 'about $390B', 'reader': {'rule B material failure': False, 'cpu increment': 'none', 'rule B trace': '$390B'}}]\n235:    made_up[0]['reader']['segment excerpt'] = 'a sentence that is not in the answer'\n236:    results['pilot: an excerpt not from its answer is refused'] = decide(made_up, h4, gains)[0] == 'refused'\n237:    no_trace = copy.deepcopy(gains)\n238:    no_trace[0]['reader']['rule B trace'] = ''\n239:    results['pilot: a gain review without its rule-B trace is refused'] = decide(p, h4, no_trace)[0] == 'refused'\n244:    results['pilot: a CPU correction on the Data Center answer is refused'] = decide(p, h4, on_segment)[0] == 'refused'\n","exit_code":0,"status":"completed"}}
