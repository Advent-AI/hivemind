{'\\\\''together'\\\\'':float(s=='\\\\''together'\\\\''),'\\\\''opposite'\\\\'':float(s=='\\\\''opposite'\\\\''),'\\\\''no_clear_sign'\\\\'':0}}\ndef scenario(name,draws,should,wrong_keys):\n    rows,s=read_census.score(draws,expected)\n    print(name,s['\\\\''gate'\\\\''],s['\\\\''wrong'\\\\''])\n    assert s['\\\\''gate'\\\\'']==should and {k for _,k,_,_ in s['\\\\''wrong'\\\\'']}==wrong_keys\nscenario('\\\\''stored'\\\\'',draws,False,{'\\\\''321:v16'\\\\'','\\\\''1238:v9'\\\\''})\nfixed=copy.deepcopy(draws)\nfor _,t in fixed: neither(t,(321,'\\\\''v16'\\\\''))\nscenario('\\\\''round 18 counterexample'\\\\'',fixed,False,{'\\\\''1238:v9'\\\\''})\nfor _,t in fixed: neither(t,(1238,'\\\\''v9'\\\\''))\nscenario('\\\\''both rejected'\\\\'',fixed,True,set())\nassert any(read_census.linked(t[1238,'\\\\''v14'\\\\''],'\\\\''v35'\\\\'','\\\\''v14'\\\\'')==('\\\\''v35 reads v14'\\\\'','\\\\''together'\\\\'') for _,t in fixed)\nfor key,read,sign in [((321,'\\\\''v16'\\\\''),'\\\\''candidate_reads_thesis'\\\\'','\\\\''opposite'\\\\''),((1238,'\\\\''v9'\\\\''),'\\\\''thesis_reads_candidate'\\\\'','\\\\''opposite'\\\\''),((321,'\\\\''v14'\\\\''),'\\\\''candidate_reads_thesis'\\\\'','\\\\''together'\\\\'')]:\n trial=copy.deepcopy(fixed)\n linked(trial[0][1],key,sign,read)\n scenario(str((key,read,sign)),trial,False,{f'\\\\''{key[0]}:{key[1]}'\\\\''})\ntry:\n    read_census.counted_draws([census/f'\\\\''census-{i}'\\\\'' for i in range(1,4)],'\\\\''v2'\\\\'')\nexcept read_census.Refused as e:\n    print('\\\\''base draws rejected in v2'\\\\'',e)\nelse:\n    raise AssertionError('\\\\''old draws accepted'\\\\'')\ndry=next(pathlib.Path('\\\\''/private/tmp/claude-501'\\\\'').glob('\\\\''**/window/probe-v2-dry/archive.sqlite'\\\\'')).parent\na=sqlite3.connect((dry/'\\\\''archive.sqlite'\\\\'').as_uri()+'\\\\''?mode=ro&immutable=1'\\\\'',uri=True)\nv=sqlite3.connect((dry/'\\\\''views.sqlite'\\\\'').as_uri()+'\\\\''?mode=ro&immutable=1'\\\\'',uri=True)\ncriteria=window_test.wording_v2()