{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba window_test.py | sed -n '40,105p;170,360p'\"","aggregated_output":"    40\tdef refused_rows():\n    41\t    \"\"\"old-2's answers its own run refused (the archive keeps them under the request's hash with a ':refused:' suffix, so no later\n    42\t    identical request is answered with them): {request hash: stored provider response}. A replay must meet each refusal again to\n    43\t    reach the stored retry.\"\"\"\n    44\t    stored = sqlite3.connect(f'file:{OLD2 / \"archive.sqlite\"}?mode=ro', uri=True)\n    45\t    return {sha.split(':refused:')[0]: json.loads(response) for sha, response in\n    46\t            stored.execute(\"select request_sha256, response_json from model_calls where request_sha256 like '%:refused:%' order by call_id\")}\n    47\t\n    48\t\n    49\tdef replay_window(folder, link_answer):\n    50\t    \"\"\"poc-v119 from an empty ledger over the whole window: link questions go to `link_answer`; every other request must be answered\n    51\t    from the copy of old-2's archive (an answer old-2's own run refused is given back once, so the check refuses it again); anything\n    52\t    else stops the pass. Returns the census: equality with old-2, every link job, every opening with its pairs.\"\"\"\n    53\t    if folder.exists():\n    54\t        raise SystemExit(f'{folder} exists: a pass starts from an empty folder')\n    55\t    folder.mkdir(parents=True)\n    56\t    shutil.copyfile(OLD2 / 'archive.sqlite', folder / 'archive.sqlite')\n    57\t    views = folder / 'views.sqlite'\n    58\t    marker = sqlite3.connect(views)                 # marked harness-only before the first item: ordinary writers refuse it (D694 §0)\n    59\t    marker.execute('create table harness_only (name text, day text)')\n    60\t    marker.execute(\"insert into harness_only values ('window_test.py', '2026-11-21')\")\n    61\t    marker.commit()\n    62\t    marker.close()\n    63\t    held = live_lock.acquire(str(views))            # the store lock for the whole pass: no second writer\n    64\t    asked, refused_again = [], []\n    65\t    stored_refusals = refused_rows()\n    66\t\n    67\t    def transport(*args):\n    68\t        if len(args) == 1 and july_test.is_link_request(args[0]):\n    69\t            asked.append(sorted(args[0]['questions']))\n    70\t            return link_answer(args[0])\n    71\t        response = stored_refusals.pop(model.request_identity(args[-1])[1], None)\n    72\t        if response is not None:                   # old-2's own run refused this answer: give it back, so the check refuses it again\n    73\t            refused_again.append(model.request_identity(args[-1])[1][:12])\n    74\t            return response\n    75\t        (folder / 'missed-request.json').write_text(json.dumps(args[-1], ensure_ascii=False, indent=1))\n    76\t        raise july_test.Stop('a request other than a link question missed the archive')\n    77\t    started = time.time()\n    78\t    try:\n    79\t        totals = replay.run(testdb_path=str(ITEMS), views_path=str(views), archive=model.Archive(str(folder / 'archive.sqlite')),\n    80\t                            cfg=config.load(str(V119)), universe=universe.load(str(UNIVERSE)), from_day=WINDOW[0], until_day=WINDOW[1],\n    81\t                            transport=transport, log=lambda *a: None, only_objects={'NVDA'})\n    82\t    finally:\n    83\t        live_lock.release(held)\n    84\t    print('totals:', totals, 'seconds:', round(time.time() - started))\n    85\t    conn = sqlite3.connect(f'file:{folder / \"views.sqlite\"}?mode=ro', uri=True)\n    86\t    last_seq = conn.execute('select max(seq) from days_completed').fetchone()[0]\n    87\t    stored_last = sqlite3.connect(f'file:{OLD2 / \"views.sqlite\"}?mode=ro', uri=True).execute('select max(seq) from days_completed').fetchone()[0]\n    88\t    print('last completed seq', last_seq, 'old-2', stored_last)\n    89\t    equal = last_seq == stored_last and rebuild_control.compare(folder / 'views.sqlite', last_seq)\n    90\t    openings = []\n    91\t    for attempt, seq, status, record_json in conn.execute('select attempt_id, seq, status, record_json from link_selections order by id'):\n    92\t        record = json.loads(record_json)\n    93\t        if status == 'proposed' and record.get('pairs'):\n    94\t            openings.append({'attempt': attempt, 'seq': seq, 'pairs': record['pairs'], 'calls': record.get('calls', []),\n    95\t                             'proposed': record.get('proposed', []), 'corrections': record.get('corrections', [])})\n    96\t    census = {'equal to old-2': equal, 'link jobs asked': len(asked), 'questions in them': sum(len(a) for a in asked),\n    97\t              \"old-2's refused answers met again\": refused_again, 'left unmet': sorted(sha[:12] for sha in stored_refusals),\n    98\t              'link rows written': conn.execute(\"select count(*) from dependencies where kind='reads'\").fetchone()[0],\n    99\t              'openings with a pair shown': openings}\n   100\t    (folder / 'census.json').write_text(json.dumps(census, indent=1))\n   101\t    print(json.dumps({k: v for k, v in census.items() if k != 'openings with a pair shown'}, indent=1))\n   102\t    for opening in openings:\n   103\t        eligible = [p['thesis'] for p in opening['pairs'] if p.get('eligible')]\n   104\t        print(opening['seq'], 'eligible', eligible, 'not eligible', len(opening['pairs']) - len(eligible))\n   105\t    return census\n   170\tdef census(scratch, draw, ledger_path, approved):\n   171\t    \"\"\"One draw of the link decisions over the window: each link job sent to Jev as poc-v119 builds it, through the comparison runs'\n   172\t    reservation ledger (`july_test.budget_module`: Jev reserved at its published 64K limit for each of its three attempts); the\n   173\t    writer is handed no proposed link, so no link row is written and every later request stays old-2's (the pass checks equality at the\n   174\t    end). The ledger is created beforehand with the ceiling Alex approved; each draw registers its launcher, so the stop gate stops\n   175\t    every draw when one dies. A draw is counted only when it is complete and the ledger never stopped.\"\"\"\n   176\t    budget = july_test.budget_module()\n   177\t    if not (isinstance(approved, float) and math.isfinite(approved) and 0 < approved <= CENSUS_CEILING):\n   178\t        raise SystemExit(f'the approved ceiling must be a finite amount above 0 and at most ${CENSUS_CEILING}')\n   179\t    if not Path(ledger_path).exists():\n   180\t        raise SystemExit('the ledger does not exist: create it first (budget_replay.py --init-ledger L --ceiling <approved>)')\n   181\t    ledger = budget.SharedLedger(str(ledger_path))\n   182\t    ceiling = ledger.read()['ceiling']\n   183\t    if not (isinstance(ceiling, (int, float)) and math.isfinite(ceiling) and ceiling == approved):\n   184\t        raise SystemExit(f'the ledger ceiling {ceiling!r} is not the approved ${approved}: refused')\n   185\t    label = f'census-{draw}'\n   186\t    lock_handle = open(Path(ledger_path).with_name(f'{label}.launcher.lock'), 'a+')\n   187\t    if not ledger.claim_launcher(label, lock_handle):\n   188\t        raise SystemExit(f'another launch of {label} is running')\n   189\t    budget.install_stop_gate(ledger)\n   190\t    try:\n   191\t        return census_pass(scratch / label, draw, budget.BudgetTransport(ledger), ledger.read, 'paid')\n   192\t    finally:\n   193\t        ledger.remove_launcher(label)\n   194\t\n   195\t\n   196\tJULY_SEQ = 148\n   197\tJULY_HASHES = {'6dcb76643aea831174f8c0811f5f9329ebf5ac60f072a6be4f6992fac2e698a1',     # READS, v14's opening against v1, v2, v8, v9\n   198\t               'd118a387e9861b93b1d19c79dc9d46f18f78c06b8e7243aa33940f269c9d81a2'}     # SIGN, v9\n   199\t\n   200\t\n   201\tdef census_pass(folder, draw, inner, ledger_state, transport_kind, stored=None):\n   202\t    \"\"\"One census draw into `folder`: the seq-148 jobs answered by this draw's July sample, every other link job by `inner`, the writer\n   203\t    handed no link. A link job at seq 148 whose request is not one of the two pinned July requests stops the pass before `inner`\n   204\t    (nothing is bought there). Writes `draw.json` with the transport kind ('paid' or 'dry'); the draw is counted only when it is\n   205\t    complete, reused both July answers, ended equal to old-2 with no link row, and the ledger neither stopped nor overran.\"\"\"\n   206\t    from hivemind.views import round as round_module\n   207\t    stored = july_answers(draw) if stored is None else stored\n   208\t    reused, current = [], {'seq': None}\n   209\t\n   210\t    def link_answer(request):\n   211\t        sha = model.request_identity(request)[1]\n   212\t        if sha in stored:                          # the July sample of this draw for the same request (seq 148): not bought again\n   213\t            reused.append(sha[:12])\n   214\t            return stored[sha]\n   215\t        if current['seq'] == JULY_SEQ:\n   216\t            raise july_test.Stop(f'a link job at seq {JULY_SEQ} is not one of the pinned July requests ({sha[:12]}): not sent')\n   217\t        return inner(request)\n   218\t    original_run = round_module.run\n   219\t\n   220\t    def run_noting_seq(conn, archive, cfg, uni, item, seq, *args, **keywords):\n   221\t        current['seq'] = seq\n   222\t        return original_run(conn, archive, cfg, uni, item, seq, *args, **keywords)\n   223\t    round_module.run = run_noting_seq\n   224\t    try:\n   225\t        result = without_links(lambda: replay_window(folder, link_answer))\n   226\t    finally:\n   227\t        round_module.run = original_run\n   228\t    state = ledger_state()\n   229\t    whole, problems = complete(result)\n   230\t    if sorted(reused) != sorted(sha[:12] for sha in stored):\n   231\t        whole, problems = False, problems + [f'July samples reused {reused}, expected {sorted(sha[:12] for sha in stored)}']\n   232\t    counted = result['equal to old-2'] and result['link rows written'] == 0 and whole and not state.get('stopped') and not state.get('overrun')\n   233\t    (folder / 'draw.json').write_text(json.dumps({'draw': draw, 'transport': transport_kind, 'counted': counted, 'complete': whole, 'problems': problems,\n   234\t                                                  'equal to old-2': result['equal to old-2'], 'july samples reused': reused,\n   235\t                                                  'ledger': state}, indent=1))\n   236\t    print('ledger:', state, 'complete:', whole, problems, 'july reused:', reused)\n   237\t    return counted\n   238\t\n   239\t\n   240\tdef census_reuse_dry(scratch):\n   241\t    \"\"\"$0: a census draw whose bought jobs are answered \"neither\" by a fake Jev: the seq-148 jobs must be answered by draw 1's July\n   242\t    sample (both reused), the draw complete and counted, and the record must show v9 reads v14 proposed at seq 148.\"\"\"\n   243\t    counted = census_pass(scratch / 'census-reuse-dry', '1', july_test.fake_jev(set()), lambda: {'stopped': False, 'overrun': False}, 'dry')\n   244\t    conn = sqlite3.connect(f'file:{scratch / \"census-reuse-dry\" / \"views.sqlite\"}?mode=ro', uri=True)\n   245\t    proposed = [json.loads(r)['proposed'] for (r,) in conn.execute(\"select record_json from link_selections where status='proposed' and seq=148\")]\n   246\t    print('seq 148 proposed:', proposed)\n   247\t    return counted and proposed and len(proposed[0]) == 1\n   248\t\n   249\t\n   250\tJULY_DRAWS = {'1': 'linked-1', '2': 'linked-2', '3': 'linked-3'}\n   251\t\n   252\t\n   253\tdef july_answers(draw):\n   254\t    \"\"\"The July test's answers to the seq-148 link jobs (READS, call 8738; SIGN, call 8739) of the linked sequence paired with this\n   255\t    draw: {request hash: stored Jev response}. The census rebuilds the same READS request (sha 6dcb7664…); the SIGN request matches\n   256\t    when the READS answer passes the same pairs, which the reused answer guarantees.\"\"\"\n   257\t    if draw not in JULY_DRAWS:\n   258\t        raise SystemExit(f'draw must be one of {sorted(JULY_DRAWS)} (each reuses one July sequence\\'s seq-148 answers)')\n   259\t    archive = sqlite3.connect(f'file:{REPO / \"poc/data/july-link-test-2026-11-21\" / JULY_DRAWS[draw] / \"archive.sqlite\"}?mode=ro', uri=True)\n   260\t    return pinned({sha: json.loads(response) for sha, response in\n   261\t                   archive.execute('select request_sha256, response_json from model_calls where call_id in (8738, 8739)')})\n   262\t\n   263\t\n   264\tdef pinned(stored):\n   265\t    \"\"\"The July answers, refused unless they are exactly the two pinned requests (checked before anything is sent).\"\"\"\n   266\t    if set(stored) != JULY_HASHES:\n   267\t        raise SystemExit(f'the July answers are not the two pinned requests: {sorted(s[:12] for s in stored)}')\n   268\t    return stored\n   269\t\n   270\t\n   271\tdef reuse_refusals(scratch):\n   272\t    \"\"\"$0: (1) a July loader missing one pinned row is refused before anything runs; (2) a seq-148 link job whose request is not\n   273\t    pinned stops the pass before the inner transport (the pass is given draw 1's SIGN answer only, so the seq-148 READS job is\n   274\t    unpinned); the inner transport records every call it receives.\"\"\"\n   275\t    full = july_answers('1')\n   276\t    one = {sha: answer for sha, answer in full.items() if sha.startswith('d118')}\n   277\t    try:\n   278\t        pinned(one)\n   279\t        loader = 'NOT REFUSED'\n   280\t    except SystemExit as error:\n   281\t        loader = f'refused: {error}'\n   282\t    received = []\n   283\t\n   284\t    def recording(request):\n   285\t        received.append(sorted(request['questions']))\n   286\t        return july_test.fake_jev(set())(request)\n   287\t    try:\n   288\t        census_pass(scratch / 'reuse-refusal', '1', recording, lambda: {'stopped': False, 'overrun': False}, 'dry', stored=one)\n   289\t        stop = 'NOT STOPPED'\n   290\t    except july_test.Stop as error:\n   291\t        stop = f'stopped: {error}'\n   292\t    except RuntimeError as error:                   # replay.run wraps a failed item's stop\n   293\t        stop = f'stopped: {error}'\n   294\t    at_148 = [q for q in received if 'reads__v9' in q]\n   295\t    print(json.dumps({'loader missing a pinned row': loader, 'unpinned seq-148 job': stop,\n   296\t                      'seq-148 READS job reached the inner transport': bool(at_148), 'inner calls before the stop': len(received)}, indent=1))\n   297\t    return loader.startswith('refused') and stop.startswith('stopped') and not at_148\n   298\t\n   299\t\n   300\tif __name__ == '__main__':\n   301\t    command, scratch = sys.argv[1], Path(sys.argv[2])\n   302\t    if command == 'neither':\n   303\t        sys.exit(0 if neither(scratch) else 1)\n   304\t    if command == 'census-dry':\n   305\t        sys.exit(0 if census_dry(scratch) else 1)\n   306\t    if command == 'census-reuse-dry':\n   307\t        sys.exit(0 if census_reuse_dry(scratch) else 1)\n   308\t    if command == 'reuse-refusals':\n   309\t        sys.exit(0 if reuse_refusals(scratch) else 1)\n   310\t    if command == 'census':\n   311\t        sys.exit(0 if census(scratch, sys.argv[3], Path(sys.argv[4]), float(sys.argv[5])) else 1)\n   312\t    raise SystemExit(f'unknown command {command}')\n","exit_code":0,"status":"completed"}}
