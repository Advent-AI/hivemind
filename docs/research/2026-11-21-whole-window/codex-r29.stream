{"type":"item.started","item":{"id":"item_14","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"python3 -B -c 'import contextlib,io,json,sqlite3\nfrom pathlib import Path\nfrom unittest import mock\nimport paid_run as p,worksheet as w,verdict as v\nbase=next(Path('\\\\''/private/tmp/claude-501'\\\\'').glob('\\\\''**/scratchpad/paid-dry2/linked-1/summary.json'\\\\'')).parent.parent\npin={d:p.pinned_plan(d) for d in p.DRAWS}\nall_s={n:json.loads((base/n/'\\\\''summary.json'\\\\'').read_text()) for n in w.SEQUENCES}\nby={}\nfor n in w.SEQUENCES:\n s=all_s[n]; check=p.acceptance(s,pin[s['\\\\''draw'\\\\'']],s['\\\\''kind'\\\\''])\n print(n,check['\\\\''accepted'\\\\''],'\\\\''post'\\\\'',sum(j['\\\\''must be fresh'\\\\''] for j in s['\\\\''reader judgements'\\\\'']),'\\\\''snapshots'\\\\'',s['\\\\''snapshot checks'\\\\''])\n assert check==s['\\\\''acceptance'\\\\'']\nsample=all_s['\\\\''linked-1'\\\\''].copy()\nsample['\\\\''ledger'\\\\'']={'\\\\''overrun'\\\\'':True,'\\\\''stopped'\\\\'':True}\nprint('\\\\''simulate last completed call set the ledger stop'\\\\'','\\\\''accepted:'\\\\'',p.acceptance(sample,pin['\\\\''1'\\\\''],'\\\\''linked'\\\\'')['\\\\''accepted'\\\\''])\nmut=base.parent/'\\\\''paid-mutants2/control-not-retired/control-1/summary.json'\\\\''\nassert mut.exists()\ns_bad=json.loads(mut.read_text())\nprint('\\\\''actual no-retirement mutant status'\\\\'',s_bad['\\\\''acceptance'\\\\'']['\\\\''accepted'\\\\''],s_bad['\\\\''terminal'\\\\''],all(s_bad['\\\\''trajectory (H2)'\\\\''].values()))\nkey={f'\\\\''S-{i}'\\\\'':n for i,n in enumerate(w.SEQUENCES)}\nwith contextlib.redirect_stdout(io.StringIO()):\n sheet=[]\n for label,n in key.items():\n  sheet+=w.p_rows(base/n,label)\n  sheet+=w.h_rows(base,n,label)\nprint('\\\\''actual worksheet label-to-arm leakage in H rows'\\\\'',len({(r['\\\\''label'\\\\''],r['\\\\''sequence'\\\\'']) for r in sheet if r['\\\\''part'\\\\'']\"'!='\"'\\\\''P'\\\\''}),'\\\\''H marks filled'\\\\'',sum(r['\\\\''reader'\\\\'']['\\\\''finding'\\\\''] is not None for r in sheet if r['\\\\''part'\\\\'']\"'!='\"'\\\\''P'\\\\''))\nwindow=v.calendar()\np_rows=[]\nfor label,n in key.items():\n for d in window:\n  p_rows.append({'\\\\''part'\\\\'':'\\\\''P'\\\\'','\\\\''sequence'\\\\'':label,'\\\\''dates'\\\\'':[d],'\\\\''reader'\\\\'':{'\\\\''class'\\\\'':'\\\\''definite'\\\\'' if n.startswith('\\\\''control'\\\\'') and d in window[:2] else '\\\\''clear'\\\\''}})\nfindings={'\\\\''flags'\\\\'':{f:False for f in v.FLAGS},'\\\\''gain_reviews'\\\\'':{n:{d:'\\\\''credit'\\\\'' for d in window[:2]} for n in p.DRAWS}}\nfiles={'\\\\''worksheet.json'\\\\'':json.dumps(p_rows), '\\\\''key.json'\\\\'':json.dumps(key), '\\\\''findings.json'\\\\'':json.dumps(findings)}\nfor n,s in all_s.items():files[f'\\\\''run/{n}/summary.json'\\\\'']=json.dumps(s)\ndef mocked(path,*args,**kwargs): return files[str(path)]\ndef call():\n with mock.patch.object(Path,'\\\\''read_text'\\\\'',mocked),contextlib.redirect_stdout(io.StringIO()):\n  return v.main(Path('\\\\''run'\\\\''),'\\\\''worksheet.json'\\\\'','\\\\''key.json'\\\\'','\\\\''findings.json'\\\\'')\nprint('\\\\''P-only verdict on the dry summaries, nothing read for harms or gain judgements'\\\\'',call())\nfiles['\\\\''run/control-1/summary.json'\\\\'']=mut.read_text()\nprint('\\\\''P-only verdict with the actual no-retirement mutant summary'\\\\'',call())\nfiles['\\\\''run/control-1/summary.json'\\\\'']=json.dumps(all_s['\\\\''control-1'\\\\''])\nfiles['\\\\''run/linked-1/summary.json'\\\\'']=(base.parent/'\\\\''paid-stop/dr/linked-1/summary.json'\\\\'').read_text()\np_first=json.loads(files['\\\\''worksheet.json'\\\\''])\nfiles['\\\\''worksheet.json'\\\\'']=json.dumps([r for r in p_first if key[r['\\\\''sequence'\\\\'']]\"'!='\"'\\\\''linked-1'\\\\''])\ntry:\n call()\nexcept v.Refused as e:print('\\\\''terminal linked double refusal with missing P:'\\\\'',str(e))\nc=p.old2()\ntotal=0\nfor view,cut in pin['\\\\''1'\\\\'']['\\\\''readers'\\\\''].items():\n prev=None; n=0; post=0; first=None\n for j in w.judgements(c,view):\n  if j[1]>=cut:\n   post+=1\n   hit=(prev is not None and (j[4] or '\\\\'''\\\\'')\"'!=(prev or '\"'\\\\'''\\\\'')) or bool(w.MARKET.search((j[4] or '\\\\'''\\\\'')+'\\\\'' '\\\\''+(j[3] or '\\\\'''\\\\'')))\n   n+=hit\n   if first is None:first=(j[1],hit)\n  prev=j[4]\n total+=n\n print('\\\\''old2 H3'\\\\'',view,n,'\\\\''of'\\\\'',post,'\\\\''first selected'\\\\'',first)\nprint('\\\\''old2 H3 rows each sequence at current filter'\\\\'',total,'\\\\''six similar sequences'\\\\'',total*6)\n'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
