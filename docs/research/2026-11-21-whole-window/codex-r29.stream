\n   156\t        `tokens` go to the attempt line only.\"\"\"\n   157\t        _LIVE.depth = max(0, getattr(_LIVE, 'depth', 0) - 1)\n   158\t        if not isinstance(actual, (int, float)) or isinstance(actual, bool) or not math.isfinite(actual) or actual <= 0:\n   159\t            actual = reserved\n   160\t        with self._locked() as state:\n   161\t            state['reserved'] = max(0.0, state['reserved'] - reserved)\n   162\t            state['spent'] += actual\n   163\t            if actual > reserved + 1e-12:\n   164\t                state['overrun'] = True\n   165\t                if not state.get('stopped'):\n   166\t                    state['stopped'], state['stop_reason'] = True, 'overrun'\n   167\t        self._note({'kind': kind, 'reserved': reserved, 'charged': actual, **({'tokens': tokens} if tokens is not None else {})})\n   168\t\n     1\t{\n     2\t \"1\": {\n     3\t  \"readers\": {\n     4\t   \"v14\": \"2026-07-10\",\n     5\t   \"v9\": \"2026-07-10\",\n     6\t   \"v16\": \"2026-07-15\",\n     7\t   \"v21\": \"2026-07-26\"\n     8\t  },\n     9\t  \"graph\": [\n    10\t   [\n    11\t    \"v14\",\n    12\t    \"v8\",\n    13\t    \"first_is_bullish\",\n    14\t    148\n    15\t   ],\n    16\t   [\n    17\t    \"v16\",\n    18\t    \"v14\",\n    19\t    \"first_is_bullish\",\n    20\t    265\n    21\t   ],\n    22\t   [\n    23\t    \"v21\",\n    24\t    \"v16\",\n    25\t    \"first_is_bullish\",\n    26\t    534\n    27\t   ],\n    28\t   [\n    29\t    \"v9\",\n    30\t    \"v14\",\n    31\t    \"first_is_bullish\",\n    32\t    148\n    33\t   ]\n    34\t  ],\n    35\t  \"probe jobs\": [\n    36\t   \"11e83c49a76d65578b983661a5157d1595fe68c575b984401023232f591d9b13\",\n    37\t   \"25788895affc04caad0c6dd2b70d768b11a42232a05233bc2191cdc9235479e3\",\n    38\t   \"391281f3dbd97dbe0e0148d7d190c69ca790a046627e5d929dcb638e6b459930\",\n    39\t   \"5fae56fe27f34e7c74fe32c4a7bce4188dd6753bddcd4ecfd6029a9f797c8c32\",\n    40\t   \"6aa4cab6896dbe2