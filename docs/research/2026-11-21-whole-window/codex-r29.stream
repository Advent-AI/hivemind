{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba paid_run.py | sed -n '18,241p'\"","aggregated_output":"    18\tequal to the pinned one, labels included (none in a control); the probe jobs consumed exactly the pinned set; every post-link reader\n    19\tjudgement answered by a fresh call made during its own day's judging, every pre-link one from the archive; the upstream snapshot check\n    20\trun and clean (each dependency entry of each reader request rendered from that dependency's latest accepted conclusion recorded when the\n    21\tprompt was built); the fixed trajectory (H2) by the pinned reader set. `send` exits non-zero when the gate fails.\n    22\t\"\"\"\n    23\timport json\n    24\timport math\n    25\timport shutil\n    26\timport sqlite3\n    27\timport sys\n    28\timport threading\n    29\tfrom pathlib import Path\n    30\t\n    31\tHERE = Path(__file__).resolve().parent\n    32\tREPO = HERE.parents[2]\n    33\tsys.path.insert(0, str(REPO / 'src'))\n    34\tsys.path.insert(0, str(REPO / 'docs/research/2026-11-20-production-readiness/dependency-design'))\n    35\tsys.path.insert(0, str(HERE))\n    36\tfrom hivemind import config, live_lock, model, replay, universe       # noqa: E402\n    37\tfrom hivemind.views import judging, store                              # noqa: E402\n    38\tfrom hivemind.views import round as round_module                       # noqa: E402\n    39\timport july_test                                                        # noqa: E402\n    40\timport window_test                                                      # noqa: E402\n    41\t\n    42\tOLD2 = july_test.OLD2\n    43\tITEMS = july_test.ITEMS\n    44\tV118 = REPO / 'poc/config/poc-v118.json'\n    45\tV120 = REPO / 'poc/config/poc-v120.json'\n    46\tUNIVERSE = july_test.UNIVERSE\n    47\tWINDOW = ('2026-07-01', '2026-09-20')\n    48\tDRAWS = ('1', '2', '3')\n    49\tPINNED = HERE / 'pinned-plan.json'\n    50\tCEILING_LIMIT = 15.0                       # the harness refuses a ceiling above this whatever is passed; Alex names the actual one\n    51\tCOMPARISON = 'Comparison point stated by that judgement: '\n    52\tFORECAST = \"The system's forecast for it (our own judgement, not evidence): \"\n    53\t\n    54\t\n    55\tdef old2():\n    56\t    return sqlite3.connect(f'file:{OLD2 / \"views.sqlite\"}?mode=ro', uri=True)\n    57\t\n    58\t\n    59\tdef day_of_seq(seq):\n    60\t    return old2().execute('select publication_day from processing_steps where sequence_no=? limit 1', (seq,)).fetchone()[0]\n    61\t\n    62\t\n    63\tdef opened_at(seq):\n    64\t    \"\"\"The question old-2 opened at `seq` (the link step's candidate `c1` there).\"\"\"\n    65\t    rows = old2().execute('select view_id from views where created_seq=? and view_id in (select view_id from view_keys)', (seq,)).fetchall()\n    66\t    if len(rows) != 1:\n    67\t        raise SystemExit(f'seq {seq}: {len(rows)} number questions opened, expected one')\n    68\t    return rows[0][0]\n    69\t\n    70\t\n    71\tdef probe_links(draw):\n    72\t    \"\"\"Probe draw <draw>'s proposed links as [(reader, read, sign, seq)], candidate ids resolved to the question old-2 opened there.\"\"\"\n    73\t    conn = sqlite3.connect(f'file:{REPO / \"poc/data/link-census-2026-11-21\" / f\"probe-v2-{draw}\" / \"views.sqlite\"}?mode=ro', uri=True)\n    74\t    out = []\n    75\t    for seq, record_json in conn.execute(\"select seq, record_json from link_selections where status='proposed' order by id\"):\n    76\t        for p in json.loads(record_json).get('proposed', []):\n    77\t            resolve = (lambda node, s=seq: opened_at(s) if not node.startswith('v') else node)\n    78\t            out.append((resolve(p['reader']), resolve(p['read']), p['sign'], seq))\n    79\t    return out\n    80\t\n    81\t\n    82\tdef readers(draw):\n    83\t    \"\"\"{reader: its link day}: the day of the article that writes its first link.\"\"\"\n    84\t    days = {}\n    85\t    for reader, _, _, seq in probe_links(draw):\n    86\t        day = day_of_seq(seq)\n    87\t        days[reader] = min(days.get(reader, day), day)\n    88\t    return days\n    89\t\n    90\t\n    91\tdef retired_rows(reader_days):\n    92\t    \"\"\"The old judge rows of each reader on its link day or later: old-2's accepted judgements by reader and day. Checked: every judge row\n    93\t    of that reader in old-2's archive from the first of them on is in the set (no refused first attempt or other row left behind).\"\"\"\n    94\t    conn, archive = old2(), sqlite3.connect(f'file:{OLD2 / \"archive.sqlite\"}?mode=ro', uri=True)\n    95\t    rows = {}\n    96\t    for reader, day in reader_days.items():\n    97\t        accepted = [c for (c,) in conn.execute('select call_id from judgements where view_id=? and publication_day>=? order by call_id', (reader, day))]\n    98\t        if not accepted:\n    99\t            continue\n   100\t        family = [c for c, r in archive.execute(\"select call_id, request_json from model_calls where purpose='judge' and call_id>=?\", (accepted[0],))\n   101\t                  if july_test.judged_view(json.loads(r)) == reader]\n   102\t        if sorted(family) != sorted(accepted):\n   103\t            raise SystemExit(f'{reader}: judge rows from call {accepted[0]} on are not exactly its accepted judgements from {day}: '\n   104\t                             f'{sorted(set(family) ^ set(accepted))[:5]}')\n   105\t        rows[reader] = accepted\n   106\t    return rows\n   107\t\n   108\t\n   109\tdef plan():\n   110\t    out = {}\n   111\t    for draw in DRAWS:\n   112\t        days = readers(draw)\n   113\t        retired = retired_rows(days)\n   114\t        out[draw] = {'links': probe_links(draw), 'readers': days, 'retired per reader': {r: len(c) for r, c in retired.items()}}\n   115\t    print(json.dumps(out, indent=1))\n   116\t    return out\n   117\t\n   118\t\n   119\tdef pin(dry_out):\n   120\t    \"\"\"pinned-plan.json: per draw the readers and link days, the probe's job hashes, and the committed graph of the dry linked run\n   121\t    (labels included). The acceptance gate and H2 read this file, never the admission code's own tables.\"\"\"\n   122\t    pinned = {}\n   123\t    for draw in DRAWS:\n   124\t        summary = json.loads((Path(dry_out) / f'linked-{draw}' / 'summary.json').read_text())\n   125\t        pinned[draw] = {'readers': readers(draw), 'graph': summary['links committed'], 'probe jobs': sorted(window_test.probe_answers(draw))}\n   126\t    PINNED.write_text(json.dumps(pinned, indent=1))\n   127\t    print(json.dumps({d: {'readers': p['readers'], 'graph': p['graph'], 'probe jobs': len(p['probe jobs'])} for d, p in pinned.items()}, indent=1))\n   128\t\n   129\t\n   130\tdef pinned_plan(draw):\n   131\t    if not PINNED.exists():\n   132\t        raise SystemExit('pinned-plan.json is missing: run `pin` on the reviewed dry runs first')\n   133\t    return json.loads(PINNED.read_text())[draw]\n   134\t\n   135\t\n   136\tdef is_judgement_request(request):\n   137\t    schema = (request.get('response_format') or {}).get('json_schema') or {}\n   138\t    return schema.get('name') == 'judgement' and july_test.judged_view(request) is not None\n   139\t\n   140\t\n   141\tclass SequenceRun:\n   142\t    \"\"\"One sequence: its transport, its latch, the judging day, the upstream snapshots and the record of every judge attempt.\"\"\"\n   143\t\n   144\t    def __init__(self, kind, draw, inner, folder):\n   145\t        self.kind, self.draw, self.inner, self.folder = kind, draw, inner, folder\n   146\t        self.reader_days = readers(draw)\n   147\t        self.probe = window_test.probe_answers(draw) if kind == 'linked' else {}\n   148\t        self.stored_refusals = window_test.refused_rows()\n   149\t        self.latch = july_test.Latch()\n   150\t        self.day = None\n   151\t        self.attempts, self.refusals_given, self.link_jobs = [], [], []\n   152\t        self.snapshots, self.snapshot_problems, self.snapshot_checks = [], [], 0\n   153\t        self.day_windows, self.terminal = {}, None\n   154\t        self.lock = threading.Lock()\n   155\t\n   156\t    def transport(self, *args):\n   157\t        request = args[-1]\n   158\t        if len(args) == 1:\n   159\t            if july_test.is_link_request(request) and self.kind == 'linked':\n   160\t                sha = model.request_identity(request)[1]\n   161\t                if sha not in self.probe:\n   162\t                    raise july_test.Stop(f'a link job outside probe draw {self.draw} ({sha[:12]}): not sent')\n   163\t                self.link_jobs.append(sha)\n   164\t                return self.probe[sha]\n   165\t            raise july_test.Stop('a Jev request missed the archive: not sent')\n   166\t        sha = model.request_identity(request)[1]\n   167\t        view_id = july_test.judged_view(request) if is_judgement_request(request) else None\n   168\t        if view_id is not None and view_id not in self.reader_days:\n   169\t            response = self.stored_refusals.pop(sha, None)\n   170\t            if response is not None:\n   171\t                self.refusals_given.append(sha[:12])\n   172\t                return response\n   173\t        day = self.day\n   174\t        allowed = view_id in self.reader_days and day is not None and day >= self.reader_days[view_id]\n   175\t        text = request['messages'][-1]['content']\n   176\t        with self.lock:\n   177\t            self.attempts.append({'view': view_id, 'day': day, 'sha': sha, 'retry': 'Correct it and answer again' in text, 'admitted': allowed})\n   178\t        if allowed:\n   179\t            self.check_snapshot(view_id, day, text)\n   180\t        return self.latch.run(allowed, f'unapproved request on {day} (thesis {view_id}): not sent', (view_id, day),\n   181\t                              lambda: self.inner(*args))\n   182\t\n   183\t    def build_prompt(self, original):\n   184\t        def wrapped(conn, view_id, prompt_version):\n   185\t            system, user = original(conn, view_id, prompt_version)\n   186\t            reads = {}\n   187\t            for dependency in store.dependencies_of(conn, view_id):\n   188\t                target = dependency['resolved_to']\n   189\t                state = store.current_state(conn, target) if target else None\n   190\t                reads[target] = None if not state else {k: state.get(k) for k in ('judgement_id', 'publication_day', 'rung', 'reasons',\n   191\t                                                                                   'reference', 'implied_outcome')}\n   192\t            with self.lock:\n   193\t                self.snapshots.append({'view': view_id, 'user': user, 'reads': reads, 'day': self.day})\n   194\t            return system, user\n   195\t        return wrapped\n   196\t\n   197\t    def check_snapshot(self, view_id, day, text):\n   198\t        \"\"\"Each dependency entry of the request, found by its own target id, is rendered from that dependency's conclusion recorded when\n   199\t        the prompt was built: its judgement day in the header, its comparison point, forecast and reasons excerpt line for line (a retry\n   200\t        carries the same prompt with the correction lines after it).\"\"\"\n   201\t        with self.lock:\n   202\t            built = [s for s in self.snapshots if s['view'] == view_id and text.startswith(s['user'])]\n   203\t        if not built:\n   204\t            if self.kind == 'linked':\n   205\t                self.snapshot_problems.append((view_id, day, 'no prompt recorded for this request'))\n   206\t            return\n   207\t        reads = built[-1]['reads']\n   208\t        if self.kind == 'linked' and not reads:\n   209\t            self.snapshot_problems.append((view_id, day, 'a linked reader request with no dependency recorded'))\n   210\t        lines = text.split('\\n')\n   211\t        checked = False\n   212\t        for target, state in reads.items():\n   213\t            if state is None:\n   214\t                continue\n   215\t            headers = [i for i, line in enumerate(lines) if line.startswith(f'- {target} (')]\n   216\t            if len(headers) != 1:\n   217\t                self.snapshot_problems.append((view_id, day, f'{target}: {len(headers)} dependency entries'))\n   218\t                continue\n   219\t            i = headers[0]\n   220\t            expected = [f'    {COMPARISON}{judging._indented(state.get(\"reference\") or \"not stated\")}',\n   221\t                        f'    {FORECAST}{judging._indented(state.get(\"implied_outcome\") or \"not stated\")}',\n   222\t                        f'    Reasons (excerpt): {judging._indented((state.get(\"reasons\") or \"\")[:600])}']\n   223\t            block = '\\n'.join(lines[i + 1:])\n   224\t            if not lines[i].endswith(f', judged {state[\"publication_day\"]}') or not block.startswith('\\n'.join(expected)):\n   225\t                self.snapshot_problems.append((view_id, day, f'{target}: entry is not its latest conclusion at prompt time '\n   226\t                                                              f'(judgement {state[\"judgement_id\"]})'))\n   227\t            checked = True\n   228\t        if checked:\n   229\t            with self.lock:\n   230\t                self.snapshot_checks += 1\n   231\t\n   232\t    def judge_day(self, original):\n   233\t        def wrapped(conn, archive_, cfg_, day, seq, **keywords):\n   234\t            before = archive_.conn.execute('select coalesce(max(call_id), 0) from model_calls').fetchone()[0]\n   235\t            self.day = day\n   236\t            try:\n   237\t                result = original(conn, archive_, cfg_, day, seq, **keywords)\n   238\t            finally:\n   239\t                self.day = None\n   240\t                after = archive_.conn.execute('select coalesce(max(call_id), 0) from model_calls').fetchone()[0]\n   241\t                self.day_windows[day] = (before, after)\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba paid_run.py | sed -n '243,447p'\"","aggregated_output":"   243\t            if failed and self.terminal is None:\n   244\t                text = str(failed)\n   245\t                view = text.split('judgement refused twice: ', 1)[1].split(':', 1)[0] if 'judgement refused twice: ' in text else None\n   246\t                self.terminal = ({'outcome': 'double refusal', 'view': view, 'day': day, 'reader': view in self.reader_days}\n   247\t                                 if view else {'outcome': 'infrastructure stop', 'day': day, 'reason': text[:300]})\n   248\t            return result\n   249\t        return wrapped\n   250\t\n   251\t\n   252\tdef prepare(folder, kind, draw):\n   253\t    if folder.exists():\n   254\t        raise SystemExit(f'{folder} exists: a sequence starts from an empty folder and is never resumed')\n   255\t    folder.mkdir(parents=True)\n   256\t    shutil.copyfile(OLD2 / 'archive.sqlite', folder / 'archive.sqlite')\n   257\t    archive = model.Archive(str(folder / 'archive.sqlite'))\n   258\t    top = archive.conn.execute('select coalesce(max(call_id), 0) from model_calls').fetchone()[0]\n   259\t    retired = []\n   260\t    if kind == 'control':\n   261\t        for reader, calls in retired_rows(readers(draw)).items():\n   262\t            for call_id in calls:\n   263\t                archive.retire(call_id)\n   264\t                retired.append((reader, call_id))\n   265\t    views = folder / 'views.sqlite'\n   266\t    marker = sqlite3.connect(views)\n   267\t    marker.execute('create table harness_only (name text, day text)')\n   268\t    marker.execute(\"insert into harness_only values ('paid_run.py', '2026-11-21')\")\n   269\t    marker.commit()\n   270\t    marker.close()\n   271\t    return archive, top, retired\n   272\t\n   273\t\n   274\tdef trajectory_check(views, reader_set):\n   275\t    \"\"\"H2: every non-reader judgement equal to old-2's by question and day (the request and every substantive field); every other table\n   276\t    equal, typed keys included.\"\"\"\n   277\t    built, stored = sqlite3.connect(f'file:{views}?mode=ro', uri=True), old2()\n   278\t    fields = ('view_id, publication_day, rung, reasons, reference, implied_outcome, cited_evidence_json, cited_views_json, pushes_json, '\n   279\t              'theme_pushes_json, changed, why_changed, request_sha256')\n   280\t\n   281\t    def rows(conn):\n   282\t        return sorted(tuple(r) for r in conn.execute(f'select {fields} from judgements') if r[0] not in reader_set)\n   283\t    tables = {'non-reader judgements': rows(built) == rows(stored)}\n   284\t    for name, sql in {'views': 'select view_id, question, created_seq from views',\n   285\t                      'view_keys': 'select view_id, measure, scope, period_start, period_end, unit from view_keys',\n   286\t                      'evidence': 'select evidence_id, quote, created_seq from evidence',\n   287\t                      'evidence_links': 'select evidence_id, view_id, seq from evidence_links',\n   288\t                      'rungs': 'select view_id, position, label, condition, lo, hi from rungs',\n   289\t                      'view_switches': 'select view_id, open, reason, after_seq from view_switches',\n   290\t                      'successions': 'select view_id, succeeds, seq from successions'}.items():\n   291\t        tables[name] = sorted(tuple(r) for r in built.execute(sql)) == sorted(tuple(r) for r in stored.execute(sql))\n   292\t    return {f'{k} equal': v for k, v in tables.items()}\n   293\t\n   294\t\n   295\tdef run_sequence(out, kind, draw, inner, ledger_state, transport_kind):\n   296\t    if kind not in ('linked', 'control') or draw not in DRAWS:\n   297\t        raise SystemExit('kind must be linked or control, draw 1, 2 or 3')\n   298\t    pinned = pinned_plan(draw)\n   299\t    folder = out / f'{kind}-{draw}'\n   300\t    archive, top, retired = prepare(folder, kind, draw)\n   301\t    run = SequenceRun(kind, draw, inner, folder)\n   302\t    cfg = config.load(str(V120 if kind == 'linked' else V118))\n   303\t    summary = {'kind': kind, 'draw': draw, 'transport': transport_kind, 'config': cfg.version, 'archive_top': top,\n   304\t               'reader days': run.reader_days, 'retired rows': len(retired), 'stopped': ''}\n   305\t    original_judge_day, original_build = round_module.judge_day, judging.build_prompt\n   306\t    round_module.judge_day, judging.build_prompt = run.judge_day(original_judge_day), run.build_prompt(original_build)\n   307\t    held = live_lock.acquire(str(folder / 'views.sqlite'))\n   308\t    try:\n   309\t        replay.run(testdb_path=str(ITEMS), views_path=str(folder / 'views.sqlite'), archive=archive, cfg=cfg, universe=universe.load(str(UNIVERSE)),\n   310\t                   from_day=WINDOW[0], until_day=WINDOW[1], transport=run.transport, log=lambda *a: None, only_objects={'NVDA'})\n   311\t    except Exception as error:\n   312\t        summary['stopped'] = f'{type(error).__name__}: {error}'[:500]\n   313\t        if run.terminal is None:\n   314\t            run.terminal = {'outcome': 'infrastructure stop', 'reason': summary['stopped']}\n   315\t    finally:\n   316\t        live_lock.release(held)\n   317\t        round_module.judge_day, judging.build_prompt = original_judge_day, original_build\n   318\t    conn = sqlite3.connect(f'file:{folder / \"views.sqlite\"}?mode=ro', uri=True)\n   319\t    reader_judgements = [dict(zip(('view', 'day', 'call_id', 'judgement_id'), r)) for r in conn.execute(\n   320\t        'select view_id, publication_day, call_id, judgement_id from judgements where view_id in (%s) order by judgement_id'\n   321\t        % ','.join('?' * len(pinned['readers'])), tuple(pinned['readers']))]\n   322\t    for j in reader_judgements:\n   323\t        window = run.day_windows.get(j['day'], (None, None))\n   324\t        j['must be fresh'] = j['day'] >= pinned['readers'][j['view']]\n   325\t        j['fresh on its day'] = window[0] is not None and window[0] < j['call_id'] <= window[1]\n   326\t        j['from the archive'] = j['call_id'] <= top\n   327\t    archive_conn = sqlite3.connect(f'file:{folder / \"archive.sqlite\"}?mode=ro', uri=True)\n   328\t    attempt_rows = []\n   329\t    for call_id, request_json, sha in archive_conn.execute(\"select call_id, request_json, request_sha256 from model_calls where purpose='judge' and call_id > ?\", (top,)):\n   330\t        view = july_test.judged_view(json.loads(request_json))\n   331\t        day = next((d for d, (b, a) in run.day_windows.items() if b < call_id <= a), None)\n   332\t        attempt_rows.append({'call_id': call_id, 'view': view, 'day': day, 'refused': ':refused:' in sha, 'reader': view in pinned['readers']})\n   333\t    committed = sorted(list(r) for r in conn.execute(\"select view_id, depends_on, direction, seq from dependencies where kind='reads'\"))\n   334\t    with open(folder / 'snapshots.jsonl', 'w') as handle:\n   335\t        for snapshot in run.snapshots:\n   336\t            handle.write(json.dumps({'view': snapshot['view'], 'day': snapshot['day'], 'reads': snapshot['reads']}) + '\\n')\n   337\t    summary.update({\n   338\t        'terminal': run.terminal or {'outcome': 'complete'},\n   339\t        'links committed': committed,\n   340\t        'link jobs consumed': sorted(run.link_jobs),\n   341\t        'judge attempts at the transport': run.attempts,\n   342\t        'archive judge rows written (dated)': attempt_rows,\n   343\t        'stored refusals given back': run.refusals_given,\n   344\t        'reader judgements': reader_judgements,\n   345\t        'snapshot problems': run.snapshot_problems, 'snapshot checks': run.snapshot_checks,\n   346\t        'trajectory (H2)': trajectory_check(folder / 'views.sqlite', set(pinned['readers'])),\n   347\t        'latch': run.latch.reason, 'ledger': ledger_state(),\n   348\t    })\n   349\t    summary['acceptance'] = acceptance(summary, pinned, kind)\n   350\t    (folder / 'summary.json').write_text(json.dumps(summary, indent=1, ensure_ascii=False))\n   351\t    return summary\n   352\t\n   353\t\n   354\tdef acceptance(summary, pinned, kind):\n   355\t    \"\"\"The one gate for the dry runs and the paid send.\"\"\"\n   356\t    judgements = summary['reader judgements']\n   357\t    checks = {\n   358\t        'window completed, no stop': summary['stopped'] == '' and summary['terminal'] == {'outcome': 'complete'},\n   359\t        'committed graph equals the pinned one (labels included)': summary['links committed'] == (pinned['graph'] if kind == 'linked' else []),\n   360\t        'probe jobs consumed exactly the pinned set': summary['link jobs consumed'] == (pinned['probe jobs'] if kind == 'linked' else []),\n   361\t        'every post-link reader judgement fresh on its own day': all(j['fresh on its day'] for j in judgements if j['must be fresh']),\n   362\t        'every pre-link reader judgement from the archive': all(j['from the archive'] for j in judgements if not j['must be fresh']),\n   363\t        'reader judgements present': bool(judgements),\n   364\t        'upstream snapshot clean': not summary['snapshot problems'],\n   365\t        'upstream snapshot exercised (linked)': kind == 'control' or summary['snapshot checks'] > 0,\n   366\t        'fixed trajectory (H2)': all(summary['trajectory (H2)'].values()),\n   367\t    }\n   368\t    return dict(checks, accepted=all(checks.values()))\n   369\t\n   370\t\n   371\tdef refusing_judge(label, refuse, twice=False):\n   372\t    \"\"\"July's marker judge, except that the first attempt of each (view, n) in `refuse` cites an evidence id it was not shown, so the\n   373\t    code refuses it; with `twice` the retry is refused the same way (a terminal refusal), else answered normally.\"\"\"\n   374\t    plain, attempts = july_test.fake_judge(label, {}), {}\n   375\t\n   376\t    def answer(provider, request):\n   377\t        text = request['messages'][-1]['content']\n   378\t        view_id = july_test.judged_view(request)\n   379\t        retry = 'Correct it and answer again' in text\n   380\t        if not retry:\n   381\t            attempts[view_id] = attempts.get(view_id, 0) + 1\n   382\t        if (view_id, attempts.get(view_id)) in refuse and (twice or not retry):\n   383\t            data = {'rung': 3, 'reference': f'REFUSED|{label}|{view_id}', 'implied_outcome': f'REFUSED|{label}|{view_id}', 'reasons': 'x',\n   384\t                    'cites': ['e999999'], 'cites_views': [], 'pushes': [], 'changed': True, 'why_changed': '', 'theme_pushes': []}\n   385\t            return {'choices': [{'message': {'content': json.dumps(data)}}], 'usage': {'prompt_tokens': 100, 'completion_tokens': 10}}\n   386\t        return plain(provider, request)\n   387\t    return answer\n   388\t\n   389\t\n   390\tdef dry(out, kind, draw, refuse=(), twice=False):\n   391\t    \"\"\"$0: the sequence with a fake judge answering every bought judgement with markers unique to the sequence, the question and the\n   392\t    attempt (every one says changed, so propagation is at its largest), through the same acceptance gate as the send.\"\"\"\n   393\t    judge = refusing_judge(f'{kind}-{draw}', set(refuse), twice) if refuse else july_test.fake_judge(f'{kind}-{draw}', {})\n   394\t    summary = run_sequence(out, kind, draw, july_test.dispatcher(judge, july_test.fake_jev(set()), []), lambda: {}, 'dry')\n   395\t    print(json.dumps({'sequence': f'{kind}-{draw}', 'terminal': summary['terminal'], 'stopped': summary['stopped'][:200],\n   396\t                      'bought (admitted attempts)': sum(1 for a in summary['judge attempts at the transport'] if a['admitted']),\n   397\t                      'snapshot checks': summary['snapshot checks'], **summary['acceptance']}, indent=1))\n   398\t    return summary\n   399\t\n   400\t\n   401\tdef send(out, kind, draw, ledger_path, approved):\n   402\t    budget = july_test.budget_module()\n   403\t    if not (isinstance(approved, float) and math.isfinite(approved) and 0 < approved <= CEILING_LIMIT):\n   404\t        raise SystemExit('the approved ceiling must be a finite amount above 0 (and within the harness limit)')\n   405\t    ledger = budget.SharedLedger(str(ledger_path))\n   406\t    ceiling = ledger.read()['ceiling']\n   407\t    if not (isinstance(ceiling, (int, float)) and math.isfinite(ceiling) and ceiling == approved):\n   408\t        raise SystemExit(f'the ledger ceiling {ceiling!r} is not the approved ${approved}: refused')\n   409\t    label = f'{kind}-{draw}'\n   410\t    lock_handle = open(Path(ledger_path).with_name(f'{label}.launcher.lock'), 'a+')\n   411\t    if not ledger.claim_launcher(label, lock_handle):\n   412\t        raise SystemExit(f'another launch of {label} is running')\n   413\t    budget.install_stop_gate(ledger)\n   414\t    try:\n   415\t        summary = run_sequence(out, kind, draw, budget.BudgetTransport(ledger), ledger.read, 'paid')\n   416\t    finally:\n   417\t        ledger.remove_launcher(label)\n   418\t    print(json.dumps({'sequence': label, 'terminal': summary['terminal'], 'stopped': summary['stopped'][:300],\n   419\t                      'ledger': summary['ledger'], **summary['acceptance']}, indent=1))\n   420\t    return summary['acceptance']['accepted']\n   421\t\n   422\t\n   423\tif __name__ == '__main__':\n   424\t    command = sys.argv[1]\n   425\t    if command == 'plan':\n   426\t        plan()\n   427\t    elif command == 'pin':\n   428\t        pin(sys.argv[2])\n   429\t    elif command == 'dry':\n   430\t        sys.exit(0 if dry(Path(sys.argv[2]), sys.argv[3], sys.argv[4])['acceptance']['accepted'] else 1)\n   431\t    elif command == 'dry-refused-upstream':\n   432\t        sys.exit(0 if dry(Path(sys.argv[2]), 'linked', sys.argv[3], refuse={('v14', 3)})['acceptance']['accepted'] else 1)\n   433\t    elif command == 'dry-double-refusal':\n   434\t        summary = dry(Path(sys.argv[2]), sys.argv[3], sys.argv[4], refuse={('v9', 2)}, twice=True)\n   435\t        expected = {'outcome': 'double refusal', 'view': 'v9', 'reader': True}\n   436\t        sys.exit(0 if all(summary['terminal'].get(k) == v for k, v in expected.items()) and not summary['acceptance']['accepted'] else 1)\n   437\t    elif command == 'send':\n   438\t        sys.exit(0 if send(Path(sys.argv[2]), sys.argv[3], sys.argv[4], Path(sys.argv[5]), float(sys.argv[6])) else 1)\n   439\t    else:\n   440\t        raise SystemExit(f'unknown command {command}')\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_7","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc 'nl -ba worksheet.py; nl -ba verdict.py'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc 'nl -ba worksheet.py; nl -ba verdict.py'","aggregated_output":"     1\t\"\"\"The reading worksheet of the paid comparison (PAID-DESIGN.md §4, \"The worksheet\"; pinned before the launch).\n     2\t\n     3\t  python3 worksheet.py build <out folder> <worksheet.json> <key.json>   # P rows (blind labels) and the H3, H4, H5 rows\n     4\t  python3 worksheet.py gains <out folder> <read worksheet.json> <key.json> <gains.json>   # the gain review rows, after P is read\n     5\t\n     6\tP rows (`part: P`): one per distinct v9/v14 answer pair per sequence on the fixed window 07-10..09-20 (each answer the last accepted\n     7\tjudgement on or before the date), keyed by both judgement ids, with the dates the pair covers, both answers' full forecast and reasons,\n     8\t`contradictions.py`'s lead class (an order for the reading, never the count) and the reader's fields. Sequences carry shuffled labels\n     9\t(S-A .. S-F); the key goes to <key.json>, kept outside the repository.\n    10\t\n    11\tH rows carry the exact request each answer was given (its user text from the archive; the dependency block is part of it and is marked\n    12\tby its own lines), the read judgements it was shown (judgement ids from the harness's snapshots), and the reader's fields:\n    13\t  H4: every post-link v14 judgement of the linked sequences, with the CPU (v8) conclusion it received and the paired control's v14\n    14\t      conclusion in force that day;\n    15\t  H5: v9 and v14 at the seven fixed dates in all six sequences (the conclusion in force), for July's rule B;\n    16\t  H3: every reader answer whose reference text differs from that reader's previous reference in the sequence, every reader answer whose\n    17\t      reference or reasons name a market figure (consensus, guidance, analyst, \"market expect\"), and the H5 answers.\n    18\tThe H rows reveal the arm (a linked request carries the dependency block); only the P rows are blind.\n    19\t\"\"\"\n    20\timport datetime\n    21\timport json\n    22\timport random\n    23\timport re\n    24\timport sqlite3\n    25\timport sys\n    26\tfrom pathlib import Path\n    27\t\n    28\tsys.path.insert(0, str(Path(__file__).resolve().parent))\n    29\timport contradictions                                                    # noqa: E402\n    30\t\n    31\tSEQUENCES = ('linked-1', 'linked-2', 'linked-3', 'control-1', 'control-2', 'control-3')\n    32\tSPAN = ('2026-07-10', '2026-09-20')\n    33\tFIXED_DATES = ('2026-07-12', '2026-07-26', '2026-08-09', '2026-08-23', '2026-09-06', '2026-09-13', '2026-09-20')\n    34\tSEGMENT, COMPANY, CPU = 'v9', 'v14', 'v8'\n    35\tREADERS = ('v9', 'v14', 'v16', 'v21')\n    36\tORDER = {'definite': 0, 'ambiguous': 1, 'overlap': 2, 'unparsed': 3, 'clear': 4}\n    37\tMARKET = re.compile(r'consensus|guidance|analyst|market expect', re.I)\n    38\tREADER_P = {'segment low': None, 'segment high': None, 'segment excerpt': '', 'company low': None, 'company high': None,\n    39\t            'company excerpt': '', 'class': None, 'note': ''}\n    40\tREADER_H = {'finding': None, 'material': None, 'excerpt': '', 'source traced': '', 'note': ''}\n    41\t\n    42\t\n    43\tdef window_dates():\n    44\t    day, end = datetime.date.fromisoformat(SPAN[0]), datetime.date.fromisoformat(SPAN[1])\n    45\t    while day <= end:\n    46\t        yield day.isoformat()\n    47\t        day += datetime.timedelta(days=1)\n    48\t\n    49\t\n    50\tdef connect(path):\n    51\t    return sqlite3.connect(f'file:{path}?mode=ro', uri=True)\n    52\t\n    53\t\n    54\tdef judgements(conn, view):\n    55\t    return conn.execute('select judgement_id, publication_day, implied_outcome, reasons, reference, call_id from judgements where view_id=? '\n    56\t                        'order by judgement_id', (view,)).fetchall()\n    57\t\n    58\t\n    59\tdef in_force(rows, date):\n    60\t    held = [j for j in rows if j[1] <= date]\n    61\t    return held[-1] if held else None\n    62\t\n    63\t\n    64\tdef request_text(archive, call_id):\n    65\t    row = archive.execute('select request_json from model_calls where call_id=?', (call_id,)).fetchone()\n    66\t    return json.loads(row[0])['messages'][-1]['content'] if row else None\n    67\t\n    68\t\n    69\tdef snapshots(folder):\n    70\t    path = Path(folder) / 'snapshots.jsonl'\n    71\t    return [json.loads(line) for line in path.read_text().splitlines()] if path.exists() else []\n    72\t\n    73\t\n    74\tdef shown(snaps, view, day):\n    75\t    \"\"\"The read judgements a reader was shown for its judgement on `day` (the last prompt built for it that day).\"\"\"\n    76\t    built = [s for s in snaps if s['view'] == view and s['day'] == day]\n    77\t    return {target: (state or {}).get('judgement_id') for target, state in (built[-1]['reads'] if built else {}).items()}\n    78\t\n    79\t\n    80\tdef p_rows(folder, label):\n    81\t    conn = connect(Path(folder) / 'views.sqlite')\n    82\t    segment_rows, company_rows = judgements(conn, SEGMENT), judgements(conn, COMPANY)\n    83\t    rows = {}\n    84\t    for date in window_dates():\n    85\t        segment, company = in_force(segment_rows, date), in_force(company_rows, date)\n    86\t        if not segment or not company:\n    87\t            continue\n    88\t        key = (segment[0], company[0])\n    89\t        if key not in rows:\n    90\t            rows[key] = {'part': 'P', 'sequence': label, 'segment judgement': segment[0], 'company judgement': company[0], 'dates': [],\n    91\t                         'segment forecast': segment[2], 'segment reasons': segment[3], 'company forecast': company[2],\n    92\t                         'company reasons': company[3],\n    93\t                         'lead class': contradictions.classify(contradictions.annual(segment[2]), contradictions.annual(company[2])),\n    94\t                         'reader': dict(READER_P)}\n    95\t        rows[key]['dates'].append(date)\n    96\t    return list(rows.values())\n    97\t\n    98\t\n    99\tdef h_rows(out, name, label):\n   100\t    folder = Path(out) / name\n   101\t    conn, archive, snaps = connect(folder / 'views.sqlite'), connect(folder / 'archive.sqlite'), snapshots(folder)\n   102\t    reader_days = json.loads((folder / 'summary.json').read_text())['reader days']\n   103\t    rows = []\n   104\t\n   105\t    def row(part, view, judgement, **extra):\n   106\t        return {'part': part, 'sequence': name, 'label': label, 'view': view, 'judgement': judgement[0], 'day': judgement[1],\n   107\t                'forecast': judgement[2], 'reasons': judgement[3], 'reference': judgement[4],\n   108\t                'request': request_text(archive, judgement[5]), 'shown': shown(snaps, view, judgement[1]), **extra, 'reader': dict(READER_H)}\n   109\t    if name.startswith('linked'):\n   110\t        control = connect(Path(out) / name.replace('linked', 'control') / 'views.sqlite')\n   111\t        control_company = judgements(control, COMPANY)\n   112\t        for j in judgements(conn, COMPANY):\n   113\t            if j[1] >= reader_days[COMPANY]:\n   114\t                paired = in_force(control_company, j[1])\n   115\t                rows.append(row('H4', COMPANY, j, cpu_shown=shown(snaps, COMPANY, j[1]).get(CPU),\n   116\t                                control_in_force={'judgement': paired[0], 'forecast': paired[2], 'reference': paired[4]} if paired else None))\n   117\t    for view in (SEGMENT, COMPANY):\n   118\t        rows_view = judgements(conn, view)\n   119\t        for date in FIXED_DATES:\n   120\t            j = in_force(rows_view, date)\n   121\t            if j:\n   122\t                rows.append(row('H5', view, j, fixed_date=date))\n   123\t    for view in READERS:\n   124\t        previous = None\n   125\t        for j in judgements(conn, view):\n   126\t            if j[1] < reader_days.get(view, '9999'):\n   127\t                previous = j[4]\n   128\t                continue\n   129\t            changed = previous is not None and (j[4] or '') != (previous or '')\n   130\t            if changed or MARKET.search((j[4] or '') + ' ' + (j[3] or '')):\n   131\t                rows.append(row('H3', view, j, reference_changed=changed))\n   132\t            previous = j[4]\n   133\t    return rows\n   134\t\n   135\t\n   136\tdef build(out, target, key_path, seed=None):\n   137\t    labels = [f'S-{c}' for c in 'ABCDEF']\n   138\t    random.Random(seed).shuffle(labels) if seed is not None else random.SystemRandom().shuffle(labels)\n   139\t    key = dict(zip(labels, SEQUENCES))\n   140\t    sheet = []\n   141\t    for label, name in key.items():\n   142\t        sheet += p_rows(Path(out) / name, label)\n   143\t        sheet += h_rows(out, name, label)\n   144\t    sheet.sort(key=lambda r: (r['part'], ORDER.get(r.get('lead class'), 9), r['sequence'], (r.get('dates') or [r.get('day')])[0]))\n   145\t    Path(target).write_text(json.dumps(sheet, indent=1, ensure_ascii=False))\n   146\t    Path(key_path).parent.mkdir(parents=True, exist_ok=True)\n   147\t    Path(key_path).write_text(json.dumps(key, indent=1))\n   148\t    summary = {part: sum(1 for r in sheet if r['part'] == part) for part in ('P', 'H3', 'H4', 'H5')}\n   149\t    summary['P dates per label'] = {label: sum(len(r['dates']) for r in sheet if r['part'] == 'P' and r['sequence'] == label) for label in key}\n   150\t    print(json.dumps(summary))\n   151\t    return sheet\n   152\t\n   153\t\n   154\tdef gains(out, read_sheet, key_path, target):\n   155\t    \"\"\"The gain review rows: for every date a linked sequence's pair is read overlap or clear while its control's is read definite, the\n   156\t    two linked answers in force (v9's and v14's), deduplicated by judgement id, each with its exact request, for rule B and H4.\"\"\"\n   157\t    key = json.loads(Path(key_path).read_text())\n   158\t    by_name = {name: label for label, name in key.items()}\n   159\t    sheet = json.loads(Path(read_sheet).read_text())\n   160\t    classes = {}\n   161\t    for row in sheet:\n   162\t        if row['part'] == 'P':\n   163\t            for date in row['dates']:\n   164\t                classes[(key[row['sequence']], date)] = (row['reader']['class'], row['segment judgement'], row['company judgement'])\n   165\t    rows = []\n   166\t    for n in ('1', '2', '3'):\n   167\t        archive = connect(Path(out) / f'linked-{n}' / 'archive.sqlite')\n   168\t        conn = connect(Path(out) / f'linked-{n}' / 'views.sqlite')\n   169\t        gain_dates = {}\n   170\t        for date in window_dates():\n   171\t            linked, control = classes.get((f'linked-{n}', date)), classes.get((f'control-{n}', date))\n   172\t            if linked and control and linked[0] in ('overlap', 'clear') and control[0] == 'definite':\n   173\t                for judgement_id in linked[1:]:\n   174\t                    gain_dates.setdefault(judgement_id, []).append(date)\n   175\t        for judgement_id, dates in sorted(gain_dates.items()):\n   176\t            j = conn.execute('select judgement_id, view_id, publication_day, implied_outcome, reasons, reference, call_id from judgements '\n   177\t                             'where judgement_id=?', (judgement_id,)).fetchone()\n   178\t            rows.append({'part': 'gain', 'pair': n, 'label': by_name[f'linked-{n}'], 'judgement': j[0], 'view': j[1], 'day': j[2],\n   179\t                         'forecast': j[3], 'reasons': j[4], 'reference': j[5], 'request': request_text(archive, j[6]), 'gain dates': dates,\n   180\t                         'reader': {'rule B material failure': None, 'reconciliation rests on it': None, 'cpu increment': None,\n   181\t                                    'credit-adjusted class': None, 'note': ''}})\n   182\t    Path(target).write_text(json.dumps(rows, indent=1, ensure_ascii=False))\n   183\t    print(json.dumps({'gain review rows': len(rows)}))\n   184\t    return rows\n   185\t\n   186\t\n   187\tif __name__ == '__main__':\n   188\t    if sys.argv[1] == 'build':\n   189\t        build(sys.argv[2], sys.argv[3], sys.argv[4])\n   190\t    elif sys.argv[1] == 'gains':\n   191\t        gains(sys.argv[2], sys.argv[3], sys.argv[4], sys.argv[5])\n   192\t    else:\n   193\t        raise SystemExit('build or gains')\n     1\t\"\"\"The verdict of the paid comparison from the read worksheet and the harm findings (PAID-DESIGN.md §4), written before the run.\n     2\t\n     3\t  python3 verdict.py <out folder> <read worksheet.json> <key.json> <findings.json>      # the verdict\n     4\t  python3 verdict.py --checks                              # $0: the verdict checks, including round 25's and 26's three cases\n     5\t\n     6\tEach worksheet row carries the reader's class (definite, overlap, clear, unresolved) for a pair of answers and the dates it covers;\n     7\tdates inherit their pair's class; each arm's 73 dates are counted definite (D), not definite (N) or unresolved (U).\n     8\t`findings.json` holds `gain_reviews` {pair: {date: 'credit' | 'none' | 'unresolved' | <a class>}} covering every gain of every pair that is\n     9\tprovisionally improved (a gain: linked not definite, control definite, on that date; only gains may be adjusted), and `flags`, every one\n    10\tan explicit boolean: `h1`, `h3`, `h4_double_count`, `h5`, and the four the run summaries decide (`linked_double_refusal`,\n    11\t`infrastructure_stop`, `control_double_refusal`, `trajectory_difference`), which must agree with the six `summary.json` files.\n    12\tThe input is refused when the worksheet does not hold, for each of the six sequences, exactly one read class for each of the 73 window\n    13\tdates, when a class is not one of the four, when a flag is missing or not a boolean, when a gain review is missing or invalid, or when a\n    14\tsummary-decided flag disagrees with the summaries.\n    15\t\"\"\"\n    16\timport datetime\n    17\tfrom pathlib import Path\n    18\timport json\n    19\timport sys\n    20\t\n    21\tWINDOW_DATES = 73\n    22\tSPAN = ('2026-07-10', '2026-09-20')\n    23\tCLASSES = ('definite', 'overlap', 'clear', 'unresolved')\n    24\tFLAGS = ('linked_double_refusal', 'infrastructure_stop', 'control_double_refusal', 'trajectory_difference', 'h1', 'h3', 'h4_double_count', 'h5')\n    25\tSEQUENCES = ('linked-1', 'linked-2', 'linked-3', 'control-1', 'control-2', 'control-3')\n    26\t\n    27\t\n    28\tclass Refused(SystemExit):\n    29\t    pass\n    30\t\n    31\t\n    32\tdef calendar():\n    33\t    day, end = datetime.date.fromisoformat(SPAN[0]), datetime.date.fromisoformat(SPAN[1])\n    34\t    out = []\n    35\t    while day <= end:\n    36\t        out.append(day.isoformat())\n    37\t        day += datetime.timedelta(days=1)\n    38\t    return out\n    39\t\n    40\t\n    41\tdef read_classes(rows, key):\n    42\t    \"\"\"{sequence: {date: class}}, refusing anything but exactly one valid class per window date per sequence.\"\"\"\n    43\t    window = calendar()\n    44\t    out = {name: {} for name in SEQUENCES}\n    45\t    for row in rows:\n    46\t        if row.get('part') != 'P':\n    47\t            continue\n    48\t        name = key.get(row['sequence'])\n    49\t        if name not in out:\n    50\t            raise Refused(f'unknown sequence label {row[\"sequence\"]!r}')\n    51\t        value = row['reader']['class']\n    52\t        if value not in CLASSES:\n    53\t            raise Refused(f'{row[\"sequence\"]}: class {value!r} is not one of {CLASSES}')\n    54\t        for date in row['dates']:\n    55\t            if date not in window:\n    56\t                raise Refused(f'{row[\"sequence\"]}: date {date} is outside the window')\n    57\t            if date in out[name]:\n    58\t                raise Refused(f'{row[\"sequence\"]}: date {date} read twice')\n    59\t            out[name][date] = value\n    60\t    for name, classes in out.items():\n    61\t        if sorted(classes) != window:\n    62\t            raise Refused(f'{name}: {len(classes)} dates read, not the window\\'s {len(window)}')\n    63\t    return out\n    64\t\n    65\t\n    66\tdef summary_flags(out):\n    67\t    summaries = {name: json.loads((Path(out) / name / 'summary.json').read_text()) for name in SEQUENCES}\n    68\t\n    69\t    def terminal(name):\n    70\t        return summaries[name]['terminal'].get('outcome')\n    71\t    return {'linked_double_refusal': any(terminal(n) == 'double refusal' for n in SEQUENCES if n.startswith('linked')),\n    72\t            'control_double_refusal': any(terminal(n) == 'double refusal' for n in SEQUENCES if n.startswith('control')),\n    73\t            'infrastructure_stop': any(terminal(n) == 'infrastructure stop' for n in SEQUENCES),\n    74\t            'trajectory_difference': any(not all(s['trajectory (H2)'].values()) for s in summaries.values())}\n    75\tREADABLE = 60\n    76\tCONTROL_FLOOR = 2\n    77\t\n    78\t\n    79\tdef date_classes(rows, sequence):\n    80\t    out = {}\n    81\t    for row in rows:\n    82\t        if row['sequence'] == sequence:\n    83\t            for date in row['dates']:\n    84\t                out[date] = row['reader']['class']\n    85\t    return out\n    86\t\n    87\t\n    88\tdef counts(classes, all_dates):\n    89\t    d = sum(1 for date in all_dates if classes.get(date) == 'definite')\n    90\t    u = sum(1 for date in all_dates if classes.get(date) in (None, 'unresolved'))\n    91\t    return d, u\n    92\t\n    93\t\n    94\tdef pair_outcome(linked, control, credit, all_dates):\n    95\t    \"\"\"(outcome, details): outcome is improved / not improved / undecided, or untestable / unreadable.\"\"\"\n    96\t    readable = {arm: sum(1 for date in all_dates if classes.get(date) in ('definite', 'overlap', 'clear'))\n    97\t                for arm, classes in (('linked', linked), ('control', control))}\n    98\t    adjusted = dict(linked)\n    99\t    for date, value in (credit or {}).items():\n   100\t        gain = linked.get(date) in ('overlap', 'clear') and control.get(date) == 'definite'\n   101\t        if not gain:\n   102\t            raise ValueError(f'{date}: credit may adjust only a gain (linked not definite, control definite)')\n   103\t        adjusted[date] = {'none': 'definite', 'unresolved': 'unresolved'}.get(value, value)\n   104\t    d_l, u_l = counts(adjusted, all_dates)\n   105\t    d_c, u_c = counts(control, all_dates)\n   106\t    details = {'D_L': d_l, 'U_L': u_l, 'D_C': d_c, 'U_C': u_c, 'readable': readable}\n   107\t    if min(readable.values()) < READABLE:\n   108\t        return 'unreadable', details\n   109\t    if d_c < CONTROL_FLOOR:\n   110\t        return 'untestable', details\n   111\t    if d_l + u_l < d_c:\n   112\t        return 'improved', details\n   113\t    if d_l >= d_c + u_c:\n   114\t        return 'not improved', details\n   115\t    return 'undecided', details\n   116\t\n   117\t\n   118\tdef verdict(outcomes, flags):\n   119\t    \"\"\"§4's precedence over the three pairs' outcomes and the run's harm flags.\"\"\"\n   120\t    if flags.get('linked_double_refusal'):\n   121\t        return 'fail', 'a linked double refusal'\n   122\t    if flags.get('infrastructure_stop') or flags.get('control_double_refusal') or flags.get('trajectory_difference') or 'unreadable' in outcomes:\n   123\t        return 'inconclusive', 'invalid or incomplete'\n   124\t    if any(flags.get(h) for h in ('h1', 'h3', 'h4_double_count', 'h5')):\n   125\t        return 'fail', 'confirmed harm'\n   126\t    if 'untestable' in outcomes:\n   127\t        return 'inconclusive', 'the class did not recur in a control'\n   128\t    if all(o == 'improved' for o in outcomes):\n   129\t        return 'pass', 'all three pairs improved'\n   130\t    if 'not improved' in outcomes:\n   131\t        return 'fail', 'a pair not improved'\n   132\t    return 'inconclusive', 'a pair undecided'\n   133\t\n   134\t\n   135\tdef main(out, worksheet_path, key_path, findings_path):\n   136\t    from pathlib import Path as _Path\n   137\t    rows, key, findings = (json.loads(_Path(p).read_text()) for p in (worksheet_path, key_path, findings_path))\n   138\t    classes = read_classes(rows, key)\n   139\t    flags = findings.get('flags')\n   140\t    if not isinstance(flags, dict) or any(not isinstance(flags.get(f), bool) for f in FLAGS):\n   141\t        raise Refused(f'findings must give every flag as a boolean: {FLAGS}')\n   142\t    decided = summary_flags(out)\n   143\t    for flag, value in decided.items():\n   144\t        if flags[flag] != value:\n   145\t            raise Refused(f'flag {flag} is {flags[flag]} in the findings but {value} in the run summaries')\n   146\t    window = calendar()\n   147\t    outcomes, details = [], {}\n   148\t    for n in ('1', '2', '3'):\n   149\t        linked, control = classes[f'linked-{n}'], classes[f'control-{n}']\n   150\t        provisional = pair_outcome(linked, control, {}, window)[0]\n   151\t        gain_dates = [d for d in window if linked[d] in ('overlap', 'clear') and control[d] == 'definite']\n   152\t        reviews = (findings.get('gain_reviews') or {}).get(n, {})\n   153\t        if provisional == 'improved' and sorted(reviews) != gain_dates:\n   154\t            raise Refused(f'pair {n}: the gain reviews cover {len(reviews)} dates, not its {len(gain_dates)} gains')\n   155\t        credit = {}\n   156\t        for date, value in reviews.items():\n   157\t            if value not in ('credit', 'none', 'unresolved') + CLASSES:\n   158\t                raise Refused(f'pair {n} {date}: gain review {value!r} is not valid')\n   159\t            if value != 'credit':\n   160\t                credit[date] = value\n   161\t        outcome, detail = pair_outcome(linked, control, credit, window)\n   162\t        outcomes.append(outcome)\n   163\t        details[n] = dict(detail, outcome=outcome, provisional=provisional, gains=len(gain_dates))\n   164\t    result = verdict(outcomes, flags)\n   165\t    print(json.dumps({'pairs': details, 'verdict': result}, indent=1))\n   166\t    return result\n   167\t\n   168\t\n   169\t# ---------- the $0 verdict checks ----------\n   170\t\n   171\tdef synthetic(definite_control=(), definite_linked=(), unresolved_linked=(), total=WINDOW_DATES):\n   172\t    dates = [f'd{i:02d}' for i in range(total)]\n   173\t    control = {d: ('definite' if d in definite_control else 'clear') for d in dates}\n   174\t    linked = {d: ('definite' if d in definite_linked else 'unresolved' if d in unresolved_linked else 'clear') for d in dates}\n   175\t    return dates, linked, control\n   176\t\n   177\t\n   178\tdef checks():\n   179\t    results = {}\n   180\t    dates, linked, control = synthetic(definite_control=('d01', 'd02'))\n   181\t    results['control 2 definite, linked none: improved'] = pair_outcome(linked, control, {}, dates)[0] == 'improved'\n   182\t    results['round 25: both gains reviewed and withdrawn: a tie, not improved'] = \\\n   183\t        pair_outcome(linked, control, {'d01': 'none', 'd02': 'none'}, dates)[0] == 'not improved'\n   184\t    results['round 25: one gain withdrawn alone still improved (so every gain must be reviewed)'] = \\\n   185\t        pair_outcome(linked, control, {'d01': 'none'}, dates)[0] == 'improved'\n   186\t    try:\n   187\t        pair_outcome(linked, control, {'d05': 'none'}, dates)       # d05 is clear in both arms: a shared error moves no date\n   188\t        results['round 25: a shared error on a clear date cannot be adjusted'] = False\n   189\t    except ValueError:\n   190\t        results['round 25: a shared error on a clear date cannot be adjusted'] = True\n   191\t    results['round 26: both gains on unquantifiable CPU increments: undecided'] = \\\n   192\t        pair_outcome(linked, control, {'d01': 'unresolved', 'd02': 'unresolved'}, dates)[0] == 'undecided'\n   193\t    dates, linked, control = synthetic(definite_control=('d01',))\n   194\t    results['a control with one definite date: untestable'] = pair_outcome(linked, control, {}, dates)[0] == 'untestable'\n   195\t    dates, linked, control = synthetic(definite_control=('d01', 'd02', 'd03'), unresolved_linked=tuple(f'd{i:02d}' for i in range(10, 24)))\n   196\t    results['14 unresolved linked dates: unreadable'] = pair_outcome(linked, control, {}, dates)[0] == 'unreadable'\n   197\t    dates, linked, control = synthetic(definite_control=('d01', 'd02', 'd03', 'd04', 'd05'), unresolved_linked=tuple(f'd{i:02d}' for i in range(10, 23)))\n   198\t    results['round 24: 5 control definite, 13 linked unresolved: undecided'] = pair_outcome(linked, control, {}, dates)[0] == 'undecided'\n   199\t    dates, linked, control = synthetic(definite_control=('d01', 'd02'), definite_linked=('d03', 'd04'))\n   200\t    results['linked as many definite dates as the control: not improved'] = pair_outcome(linked, control, {}, dates)[0] == 'not improved'\n   201\t    results['precedence: a linked double refusal fails even with every pair improved'] = \\\n   202\t        verdict(['improved'] * 3, {'linked_double_refusal': True}) == ('fail', 'a linked double refusal')\n   203\t    results['precedence: an infrastructure stop is inconclusive'] = verdict(['improved'] * 3, {'infrastructure_stop': True})[0] == 'inconclusive'\n   204\t    results['precedence: confirmed harm fails'] = verdict(['improved'] * 3, {'h4_double_count': True}) == ('fail', 'confirmed harm')\n   205\t    results['precedence: an undecided pair is inconclusive'] = verdict(['improved', 'improved', 'undecided'], {})[0] == 'inconclusive'\n   206\t    results['precedence: all improved passes'] = verdict(['improved'] * 3, {})[0] == 'pass'\n   207\t    print(json.dumps(results, indent=1))\n   208\t    return all(results.values())\n   209\t\n   210\t\n   211\tif __name__ == '__main__':\n   212\t    if sys.argv[1:] == ['--checks']:\n   213\t        sys.exit(0 if checks() else 1)\n   214\t    main(sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4])\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_8","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba worksheet.py | sed -n '1,160p'; nl -ba pinned-plan.json | sed -n '1,178p'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.started","item":{"id":"item_9","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba paid_run.py | sed -n '295,451p'; nl -ba paid_mutants.py | sed -n '1,115p'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba worksheet.py | sed -n '1,160p'; nl -ba pinned-plan.json | sed -n '1,178p'\"","aggregated_output":"     1\t\"\"\"The reading worksheet of the paid comparison (PAID-DESIGN.md §4, \"The worksheet\"; pinned before the launch).\n     2\t\n     3\t  python3 worksheet.py build <out folder> <worksheet.json> <key.json>   # P rows (blind labels) and the H3, H4, H5 rows\n     4\t  python3 worksheet.py gains <out folder> <read worksheet.json> <key.json> <gains.json>   # the gain review rows, after P is read\n     5\t\n     6\tP rows (`part: P`): one per distinct v9/v14 answer pair per sequence on the fixed window 07-10..09-20 (each answer the last accepted\n     7\tjudgement on or before the date), keyed by both judgement ids, with the dates the pair covers, both answers' full forecast and reasons,\n     8\t`contradictions.py`'s lead class (an order for the reading, never the count) and the reader's fields. Sequences carry shuffled labels\n     9\t(S-A .. S-F); the key goes to <key.json>, kept outside the repository.\n    10\t\n    11\tH rows carry the exact request each answer was given (its user text from the archive; the dependency block is part of it and is marked\n    12\tby its own lines), the read judgements it was shown (judgement ids from the harness's snapshots), and the reader's fields:\n    13\t  H4: every post-link v14 judgement of the linked sequences, with the CPU (v8) conclusion it received and the paired control's v14\n    14\t      conclusion in force that day;\n    15\t  H5: v9 and v14 at the seven fixed dates in all six sequences (the conclusion in force), for July's rule B;\n    16\t  H3: every reader answer whose reference text differs from that reader's previous reference in the sequence, every reader answer whose\n    17\t      reference or reasons name a market figure (consensus, guidance, analyst, \"market expect\"), and the H5 answers.\n    18\tThe H rows reveal the arm (a linked request carries the dependency block); only the P rows are blind.\n    19\t\"\"\"\n    20\timport datetime\n    21\timport json\n    22\timport random\n    23\timport re\n    24\timport sqlite3\n    25\timport sys\n    26\tfrom pathlib import Path\n    27\t\n    28\tsys.path.insert(0, str(Path(__file__).resolve().parent))\n    29\timport contradictions                                                    # noqa: E402\n    30\t\n    31\tSEQUENCES = ('linked-1', 'linked-2', 'linked-3', 'control-1', 'control-2', 'control-3')\n    32\tSPAN = ('2026-07-10', '2026-09-20')\n    33\tFIXED_DATES = ('2026-07-12', '2026-07-26', '2026-08-09', '2026-08-23', '2026-09-06', '2026-09-13', '2026-09-20')\n    34\tSEGMENT, COMPANY, CPU = 'v9', 'v14', 'v8'\n    35\tREADERS = ('v9', 'v14', 'v16', 'v21')\n    36\tORDER = {'definite': 0, 'ambiguous': 1, 'overlap': 2, 'unparsed': 3, 'clear': 4}\n    37\tMARKET = re.compile(r'consensus|guidance|analyst|market expect', re.I)\n    38\tREADER_P = {'segment low': None, 'segment high': None, 'segment excerpt': '', 'company low': None, 'company high': None,\n    39\t            'company excerpt': '', 'class': None, 'note': ''}\n    40\tREADER_H = {'finding': None, 'material': None, 'excerpt': '', 'source traced': '', 'note': ''}\n    41\t\n    42\t\n    43\tdef window_dates():\n    44\t    day, end = datetime.date.fromisoformat(SPAN[0]), datetime.date.fromisoformat(SPAN[1])\n    45\t    while day <= end:\n    46\t        yield day.isoformat()\n    47\t        day += datetime.timedelta(days=1)\n    48\t\n    49\t\n    50\tdef connect(path):\n    51\t    return sqlite3.connect(f'file:{path}?mode=ro', uri=True)\n    52\t\n    53\t\n    54\tdef judgements(conn, view):\n    55\t    return conn.execute('select judgement_id, publication_day, implied_outcome, reasons, reference, call_id from judgements where view_id=? '\n    56\t                        'order by judgement_id', (view,)).fetchall()\n    57\t\n    58\t\n    59\tdef in_force(rows, date):\n    60\t    held = [j for j in rows if j[1] <= date]\n    61\t    return held[-1] if held else None\n    62\t\n    63\t\n    64\tdef request_text(archive, call_id):\n    65\t    row = archive.execute('select request_json from model_calls where call_id=?', (call_id,)).fetchone()\n    66\t    return json.loads(row[0])['messages'][-1]['content'] if row else None\n    67\t\n    68\t\n    69\tdef snapshots(folder):\n    70\t    path = Path(folder) / 'snapshots.jsonl'\n    71\t    return [json.loads(line) for line in path.read_text().splitlines()] if path.exists() else []\n    72\t\n    73\t\n    74\tdef shown(snaps, view, day):\n    75\t    \"\"\"The read judgements a reader was shown for its judgement on `day` (the last prompt built for it that day).\"\"\"\n    76\t    built = [s for s in snaps if s['view'] == view and s['day'] == day]\n    77\t    return {target: (state or {}).get('judgement_id') for target, state in (built[-1]['reads'] if built else {}).items()}\n    78\t\n    79\t\n    80\tdef p_rows(folder, label):\n    81\t    conn = connect(Path(folder) / 'views.sqlite')\n    82\t    segment_rows, company_rows = judgements(conn, SEGMENT), judgements(conn, COMPANY)\n    83\t    rows = {}\n    84\t    for date in window_dates():\n    85\t        segment, company = in_force(segment_rows, date), in_force(company_rows, date)\n    86\t        if not segment or not company:\n    87\t            continue\n    88\t        key = (segment[0], company[0])\n    89\t        if key not in rows:\n    90\t            rows[key] = {'part': 'P', 'sequence': label, 'segment judgement': segment[0], 'company judgement': company[0], 'dates': [],\n    91\t                         'segment forecast': segment[2], 'segment reasons': segment[3], 'company forecast': company[2],\n    92\t                         'company reasons': company[3],\n    93\t                         'lead class': contradictions.classify(contradictions.annual(segment[2]), contradictions.annual(company[2])),\n    94\t                         'reader': dict(READER_P)}\n    95\t        rows[key]['dates'].append(date)\n    96\t    return list(rows.values())\n    97\t\n    98\t\n    99\tdef h_rows(out, name, label):\n   100\t    folder = Path(out) / name\n   101\t    conn, archive, snaps = connect(folder / 'views.sqlite'), connect(folder / 'archive.sqlite'), snapshots(folder)\n   102\t    reader_days = json.loads((folder / 'summary.json').read_text())['reader days']\n   103\t    rows = []\n   104\t\n   105\t    def row(part, view, judgement, **extra):\n   106\t        return {'part': part, 'sequence': name, 'label': label, 'view': view, 'judgement': judgement[0], 'day': judgement[1],\n   107\t                'forecast': judgement[2], 'reasons': judgement[3], 'reference': judgement[4],\n   108\t                'request': request_text(archive, judgement[5]), 'shown': shown(snaps, view, judgement[1]), **extra, 'reader': dict(READER_H)}\n   109\t    if name.startswith('linked'):\n   110\t        control = connect(Path(out) / name.replace('linked', 'control') / 'views.sqlite')\n   111\t        control_company = judgements(control, COMPANY)\n   112\t        for j in judgements(conn, COMPANY):\n   113\t            if j[1] >= reader_days[COMPANY]:\n   114\t                paired = in_force(control_company, j[1])\n   115\t                rows.append(row('H4', COMPANY, j, cpu_shown=shown(snaps, COMPANY, j[1]).get(CPU),\n   116\t                                control_in_force={'judgement': paired[0], 'forecast': paired[2], 'reference': paired[4]} if paired else None))\n   117\t    for view in (SEGMENT, COMPANY):\n   118\t        rows_view = judgements(conn, view)\n   119\t        for date in FIXED_DATES:\n   120\t            j = in_force(rows_view, date)\n   121\t            if j:\n   122\t                rows.append(row('H5', view, j, fixed_date=date))\n   123\t    for view in READERS:\n   124\t        previous = None\n   125\t        for j in judgements(conn, view):\n   126\t            if j[1] < reader_days.get(view, '9999'):\n   127\t                previous = j[4]\n   128\t                continue\n   129\t            changed = previous is not None and (j[4] or '') != (previous or '')\n   130\t            if changed or MARKET.search((j[4] or '') + ' ' + (j[3] or '')):\n   131\t                rows.append(row('H3', view, j, reference_changed=changed))\n   132\t            previous = j[4]\n   133\t    return rows\n   134\t\n   135\t\n   136\tdef build(out, target, key_path, seed=None):\n   137\t    labels = [f'S-{c}' for c in 'ABCDEF']\n   138\t    random.Random(seed).shuffle(labels) if seed is not None else random.SystemRandom().shuffle(labels)\n   139\t    key = dict(zip(labels, SEQUENCES))\n   140\t    sheet = []\n   141\t    for label, name in key.items():\n   142\t        sheet += p_rows(Path(out) / name, label)\n   143\t        sheet += h_rows(out, name, label)\n   144\t    sheet.sort(key=lambda r: (r['part'], ORDER.get(r.get('lead class'), 9), r['sequence'], (r.get('dates') or [r.get('day')])[0]))\n   145\t    Path(target).write_text(json.dumps(sheet, indent=1, ensure_ascii=False))\n   146\t    Path(key_path).parent.mkdir(parents=True, exist_ok=True)\n   147\t    Path(key_path).write_text(json.dumps(key, indent=1))\n   148\t    summary = {part: sum(1 for r in sheet if r['part'] == part) for part in ('P', 'H3', 'H4', 'H5')}\n   149\t    summary['P dates per label'] = {label: sum(len(r['dates']) for r in sheet if r['part'] == 'P' and r['sequence'] == label) for label in key}\n   150\t    print(json.dumps(summary))\n   151\t    return sheet\n   152\t\n   153\t\n   154\tdef gains(out, read_sheet, key_path, target):\n   155\t    \"\"\"The gain review rows: for every date a linked sequence's pair is read overlap or clear while its control's is read definite, the\n   156\t    two linked answers in force (v9's and v14's), deduplicated by judgement id, each with its exact request, for rule B and H4.\"\"\"\n   157\t    key = json.loads(Path(key_path).read_text())\n   158\t    by_name = {name: label for label, name in key.items()}\n   159\t    sheet = json.loads(Path(read_sheet).read_text())\n   160\t    classes = {}\n     1\t{\n     2\t \"1\": {\n     3\t  \"readers\": {\n     4\t   \"v14\": \"2026-07-10\",\n     5\t   \"v9\": \"2026-07-10\",\n     6\t   \"v16\": \"2026-07-15\",\n     7\t   \"v21\": \"2026-07-26\"\n     8\t  },\n     9\t  \"graph\": [\n    10\t   [\n    11\t    \"v14\",\n    12\t    \"v8\",\n    13\t    \"first_is_bullish\",\n    14\t    148\n    15\t   ],\n    16\t   [\n    17\t    \"v16\",\n    18\t    \"v14\",\n    19\t    \"first_is_bullish\",\n    20\t    265\n    21\t   ],\n    22\t   [\n    23\t    \"v21\",\n    24\t    \"v16\",\n    25\t    \"first_is_bullish\",\n    26\t    534\n    27\t   ],\n    28\t   [\n    29\t    \"v9\",\n    30\t    \"v14\",\n    31\t    \"first_is_bullish\",\n    32\t    148\n    33\t   ]\n    34\t  ],\n    35\t  \"probe jobs\": [\n    36\t   \"11e83c49a76d65578b983661a5157d1595fe68c575b984401023232f591d9b13\",\n    37\t   \"25788895affc04caad0c6dd2b70d768b11a42232a05233bc2191cdc9235479e3\",\n    38\t   \"391281f3dbd97dbe0e0148d7d190c69ca790a046627e5d929dcb638e6b459930\",\n    39\t   \"5fae56fe27f34e7c74fe32c4a7bce4188dd6753bddcd4ecfd6029a9f797c8c32\",\n    40\t   \"6aa4cab6896dbe282d10c0360cb77e64da2ed81dea89758ee7eec8caa3c1bf76\",\n    41\t   \"6c4dfbb14ef95a218f327e61dbf64fd9da2ddf221ca6c13021ed672588a1bbfb\",\n    42\t   \"76c80665773c622571600f303e99af79b7140a117b02b6f68cccd6a32b085fd2\",\n    43\t   \"8258076c659799eb99cb78d67eaa2c6e5e1840f96903641e22a6f9f0c5de505e\",\n    44\t   \"82829a5dcd66cd84b7ec5f682e97e49f128d4229a29cc35813c01430825f6485\",\n    45\t   \"87f3df389bd5aff4ff5f735a86f6d46dd17a2371de8c1202bb917512b225e51d\",\n    46\t   \"b0e2e1c6b281d56fa96ec44a55142b0556872b4c9e4cfc5332d7dd8f98e5c22a\",\n    47\t   \"b82dc91e0cb28a48f32122f13fa275c016cef68862c90d86fe7d33bb35a6fc7b\",\n    48\t   \"cd4a19d2b88ebb3a3c9c164af13149c44533a1bf3b542221b62f2fdaa882a167\",\n    49\t   \"d2610c2c8393aee36ed45113de1a77883d00b33c19540fccc99a352fbe5e3056\",\n    50\t   \"dc5782ad56e76a58f7bdabc73d19cd4eac9d149bf69d14daa658e3f7eda12c08\",\n    51\t   \"f3b34a931a47e3c7db8c30bfc685b6eb538b032bc87cd0e20d0c916662522245\",\n    52\t   \"fc19bd2695d52f1d540abfb6b3b6c52e836939935d585a4bebb9c87e20cb33eb\"\n    53\t  ]\n    54\t },\n    55\t \"2\": {\n    56\t  \"readers\": {\n    57\t   \"v14\": \"2026-07-10\",\n    58\t   \"v9\": \"2026-07-10\",\n    59\t   \"v16\": \"2026-07-15\",\n    60\t   \"v21\": \"2026-07-26\"\n    61\t  },\n    62\t  \"graph\": [\n    63\t   [\n    64\t    \"v14\",\n    65\t    \"v8\",\n    66\t    \"first_is_bullish\",\n    67\t    148\n    68\t   ],\n    69\t   [\n    70\t    \"v16\",\n    71\t    \"v14\",\n    72\t    \"first_is_bullish\",\n    73\t    265\n    74\t   ],\n    75\t   [\n    76\t    \"v21\",\n    77\t    \"v16\",\n    78\t    \"first_is_bullish\",\n    79\t    534\n    80\t   ],\n    81\t   [\n    82\t    \"v21\",\n    83\t    \"v9\",\n    84\t    \"first_is_bullish\",\n    85\t    534\n    86\t   ],\n    87\t   [\n    88\t    \"v9\",\n    89\t    \"v14\",\n    90\t    \"first_is_bullish\",\n    91\t    148\n    92\t   ]\n    93\t  ],\n    94\t  \"probe jobs\": [\n    95\t   \"03df150a0f341102f90c6c438f35f3c008ebd840095c6117fe58e78f82f02aa6\",\n    96\t   \"11e83c49a76d65578b983661a5157d1595fe68c575b984401023232f591d9b13\",\n    97\t   \"25788895affc04caad0c6dd2b70d768b11a42232a05233bc2191cdc9235479e3\",\n    98\t   \"391281f3dbd97dbe0e0148d7d190c69ca790a046627e5d929dcb638e6b459930\",\n    99\t   \"4031d71fc637976611525b37213b2fedb5dc322abd676d016c3caf03682cef9b\",\n   100\t   \"6aa4cab6896dbe282d10c0360cb77e64da2ed81dea89758ee7eec8caa3c1bf76\",\n   101\t   \"6c4dfbb14ef95a218f327e61dbf64fd9da2ddf221ca6c13021ed672588a1bbfb\",\n   102\t   \"76c80665773c622571600f303e99af79b7140a117b02b6f68cccd6a32b085fd2\",\n   103\t   \"8258076c659799eb99cb78d67eaa2c6e5e1840f96903641e22a6f9f0c5de505e\",\n   104\t   \"82829a5dcd66cd84b7ec5f682e97e49f128d4229a29cc35813c01430825f6485\",\n   105\t   \"87f3df389bd5aff4ff5f735a86f6d46dd17a2371de8c1202bb917512b225e51d\",\n   106\t   \"b0e2e1c6b281d56fa96ec44a55142b0556872b4c9e4cfc5332d7dd8f98e5c22a\",\n   107\t   \"b82dc91e0cb28a48f32122f13fa275c016cef68862c90d86fe7d33bb35a6fc7b\",\n   108\t   \"cd4a19d2b88ebb3a3c9c164af13149c44533a1bf3b542221b62f2fdaa882a167\",\n   109\t   \"d2610c2c8393aee36ed45113de1a77883d00b33c19540fccc99a352fbe5e3056\",\n   110\t   \"f3b34a931a47e3c7db8c30bfc685b6eb538b032bc87cd0e20d0c916662522245\",\n   111\t   \"fc19bd2695d52f1d540abfb6b3b6c52e836939935d585a4bebb9c87e20cb33eb\"\n   112\t  ]\n   113\t },\n   114\t \"3\": {\n   115\t  \"readers\": {\n   116\t   \"v14\": \"2026-07-10\",\n   117\t   \"v9\": \"2026-07-10\",\n   118\t   \"v16\": \"2026-07-15\",\n   119\t   \"v21\": \"2026-07-26\"\n   120\t  },\n   121\t  \"graph\": [\n   122\t   [\n   123\t    \"v14\",\n   124\t    \"v8\",\n   125\t    \"first_is_bullish\",\n   126\t    148\n   127\t   ],\n   128\t   [\n   129\t    \"v16\",\n   130\t    \"v14\",\n   131\t    \"first_is_bullish\",\n   132\t    265\n   133\t   ],\n   134\t   [\n   135\t    \"v16\",\n   136\t    \"v8\",\n   137\t    \"first_is_bullish\",\n   138\t    265\n   139\t   ],\n   140\t   [\n   141\t    \"v21\",\n   142\t    \"v16\",\n   143\t    \"first_is_bullish\",\n   144\t    534\n   145\t   ],\n   146\t   [\n   147\t    \"v21\",\n   148\t    \"v9\",\n   149\t    \"first_is_bullish\",\n   150\t    534\n   151\t   ],\n   152\t   [\n   153\t    \"v9\",\n   154\t    \"v14\",\n   155\t    \"first_is_bullish\",\n   156\t    148\n   157\t   ]\n   158\t  ],\n   159\t  \"probe jobs\": [\n   160\t   \"10fff886a1c1e6422e4914ad4b206b5fbce15b8ea8405ddc8d4952379e226b40\",\n   161\t   \"11e83c49a76d65578b983661a5157d1595fe68c575b984401023232f591d9b13\",\n   162\t   \"25788895affc04caad0c6dd2b70d768b11a42232a05233bc2191cdc9235479e3\",\n   163\t   \"391281f3dbd97dbe0e0148d7d190c69ca790a046627e5d929dcb638e6b459930\",\n   164\t   \"4031d71fc637976611525b37213b2fedb5dc322abd676d016c3caf03682cef9b\",\n   165\t   \"6aa4cab6896dbe282d10c0360cb77e64da2ed81dea89758ee7eec8caa3c1bf76\",\n   166\t   \"6c4dfbb14ef95a218f327e61dbf64fd9da2ddf221ca6c13021ed672588a1bbfb\",\n   167\t   \"76c80665773c622571600f303e99af79b7140a117b02b6f68cccd6a32b085fd2\",\n   168\t   \"8258076c659799eb99cb78d67eaa2c6e5e1840f96903641e22a6f9f0c5de505e\",\n   169\t   \"82829a5dcd66cd84b7ec5f682e97e49f128d4229a29cc35813c01430825f6485\",\n   170\t   \"87f3df389bd5aff4ff5f735a86f6d46dd17a2371de8c1202bb917512b225e51d\",\n   171\t   \"b0e2e1c6b281d56fa96ec44a55142b0556872b4c9e4cfc5332d7dd8f98e5c22a\",\n   172\t   \"b82dc91e0cb28a48f32122f13fa275c016cef68862c90d86fe7d33bb35a6fc7b\",\n   173\t   \"cd4a19d2b88ebb3a3c9c164af13149c44533a1bf3b542221b62f2fdaa882a167\",\n   174\t   \"d2610c2c8393aee36ed45113de1a77883d00b33c19540fccc99a352fbe5e3056\",\n   175\t   \"f3b34a931a47e3c7db8c30bfc685b6eb538b032bc87cd0e20d0c916662522245\",\n   176\t   \"fc19bd2695d52f1d540abfb6b3b6c52e836939935d585a4bebb9c87e20cb33eb\"\n   177\t  ]\n   178\t }\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba paid_run.py | sed -n '295,451p'; nl -ba paid_mutants.py | sed -n '1,115p'\"","aggregated_output":"   295\tdef run_sequence(out, kind, draw, inner, ledger_state, transport_kind):\n   296\t    if kind not in ('linked', 'control') or draw not in DRAWS:\n   297\t        raise SystemExit('kind must be linked or control, draw 1, 2 or 3')\n   298\t    pinned = pinned_plan(draw)\n   299\t    folder = out / f'{kind}-{draw}'\n   300\t    archive, top, retired = prepare(folder, kind, draw)\n   301\t    run = SequenceRun(kind, draw, inner, folder)\n   302\t    cfg = config.load(str(V120 if kind == 'linked' else V118))\n   303\t    summary = {'kind': kind, 'draw': draw, 'transport': transport_kind, 'config': cfg.version, 'archive_top': top,\n   304\t               'reader days': run.reader_days, 'retired rows': len(retired), 'stopped': ''}\n   305\t    original_judge_day, original_build = round_module.judge_day, judging.build_prompt\n   306\t    round_module.judge_day, judging.build_prompt = run.judge_day(original_judge_day), run.build_prompt(original_build)\n   307\t    held = live_lock.acquire(str(folder / 'views.sqlite'))\n   308\t    try:\n   309\t        replay.run(testdb_path=str(ITEMS), views_path=str(folder / 'views.sqlite'), archive=archive, cfg=cfg, universe=universe.load(str(UNIVERSE)),\n   310\t                   from_day=WINDOW[0], until_day=WINDOW[1], transport=run.transport, log=lambda *a: None, only_objects={'NVDA'})\n   311\t    except Exception as error:\n   312\t        summary['stopped'] = f'{type(error).__name__}: {error}'[:500]\n   313\t        if run.terminal is None:\n   314\t            run.terminal = {'outcome': 'infrastructure stop', 'reason': summary['stopped']}\n   315\t    finally:\n   316\t        live_lock.release(held)\n   317\t        round_module.judge_day, judging.build_prompt = original_judge_day, original_build\n   318\t    conn = sqlite3.connect(f'file:{folder / \"views.sqlite\"}?mode=ro', uri=True)\n   319\t    reader_judgements = [dict(zip(('view', 'day', 'call_id', 'judgement_id'), r)) for r in conn.execute(\n   320\t        'select view_id, publication_day, call_id, judgement_id from judgements where view_id in (%s) order by judgement_id'\n   321\t        % ','.join('?' * len(pinned['readers'])), tuple(pinned['readers']))]\n   322\t    for j in reader_judgements:\n   323\t        window = run.day_windows.get(j['day'], (None, None))\n   324\t        j['must be fresh'] = j['day'] >= pinned['readers'][j['view']]\n   325\t        j['fresh on its day'] = window[0] is not None and window[0] < j['call_id'] <= window[1]\n   326\t        j['from the archive'] = j['call_id'] <= top\n   327\t    archive_conn = sqlite3.connect(f'file:{folder / \"archive.sqlite\"}?mode=ro', uri=True)\n   328\t    attempt_rows = []\n   329\t    for call_id, request_json, sha in archive_conn.execute(\"select call_id, request_json, request_sha256 from model_calls where purpose='judge' and call_id > ?\", (top,)):\n   330\t        view = july_test.judged_view(json.loads(request_json))\n   331\t        day = next((d for d, (b, a) in run.day_windows.items() if b < call_id <= a), None)\n   332\t        attempt_rows.append({'call_id': call_id, 'view': view, 'day': day, 'refused': ':refused:' in sha, 'reader': view in pinned['readers']})\n   333\t    committed = sorted(list(r) for r in conn.execute(\"select view_id, depends_on, direction, seq from dependencies where kind='reads'\"))\n   334\t    with open(folder / 'snapshots.jsonl', 'w') as handle:\n   335\t        for snapshot in run.snapshots:\n   336\t            handle.write(json.dumps({'view': snapshot['view'], 'day': snapshot['day'], 'reads': snapshot['reads']}) + '\\n')\n   337\t    summary.update({\n   338\t        'terminal': run.terminal or {'outcome': 'complete'},\n   339\t        'links committed': committed,\n   340\t        'link jobs consumed': sorted(run.link_jobs),\n   341\t        'judge attempts at the transport': run.attempts,\n   342\t        'archive judge rows written (dated)': attempt_rows,\n   343\t        'stored refusals given back': run.refusals_given,\n   344\t        'reader judgements': reader_judgements,\n   345\t        'snapshot problems': run.snapshot_problems, 'snapshot checks': run.snapshot_checks,\n   346\t        'trajectory (H2)': trajectory_check(folder / 'views.sqlite', set(pinned['readers'])),\n   347\t        'latch': run.latch.reason, 'ledger': ledger_state(),\n   348\t    })\n   349\t    summary['acceptance'] = acceptance(summary, pinned, kind)\n   350\t    (folder / 'summary.json').write_text(json.dumps(summary, indent=1, ensure_ascii=False))\n   351\t    return summary\n   352\t\n   353\t\n   354\tdef acceptance(summary, pinned, kind):\n   355\t    \"\"\"The one gate for the dry runs and the paid send.\"\"\"\n   356\t    judgements = summary['reader judgements']\n   357\t    checks = {\n   358\t        'window completed, no stop': summary['stopped'] == '' and summary['terminal'] == {'outcome': 'complete'},\n   359\t        'committed graph equals the pinned one (labels included)': summary['links committed'] == (pinned['graph'] if kind == 'linked' else []),\n   360\t        'probe jobs consumed exactly the pinned set': summary['link jobs consumed'] == (pinned['probe jobs'] if kind == 'linked' else []),\n   361\t        'every post-link reader judgement fresh on its own day': all(j['fresh on its day'] for j in judgements if j['must be fresh']),\n   362\t        'every pre-link reader judgement from the archive': all(j['from the archive'] for j in judgements if not j['must be fresh']),\n   363\t        'reader judgements present': bool(judgements),\n   364\t        'upstream snapshot clean': not summary['snapshot problems'],\n   365\t        'upstream snapshot exercised (linked)': kind == 'control' or summary['snapshot checks'] > 0,\n   366\t        'fixed trajectory (H2)': all(summary['trajectory (H2)'].values()),\n   367\t    }\n   368\t    return dict(checks, accepted=all(checks.values()))\n   369\t\n   370\t\n   371\tdef refusing_judge(label, refuse, twice=False):\n   372\t    \"\"\"July's marker judge, except that the first attempt of each (view, n) in `refuse` cites an evidence id it was not shown, so the\n   373\t    code refuses it; with `twice` the retry is refused the same way (a terminal refusal), else answered normally.\"\"\"\n   374\t    plain, attempts = july_test.fake_judge(label, {}), {}\n   375\t\n   376\t    def answer(provider, request):\n   377\t        text = request['messages'][-1]['content']\n   378\t        view_id = july_test.judged_view(request)\n   379\t        retry = 'Correct it and answer again' in text\n   380\t        if not retry:\n   381\t            attempts[view_id] = attempts.get(view_id, 0) + 1\n   382\t        if (view_id, attempts.get(view_id)) in refuse and (twice or not retry):\n   383\t            data = {'rung': 3, 'reference': f'REFUSED|{label}|{view_id}', 'implied_outcome': f'REFUSED|{label}|{view_id}', 'reasons': 'x',\n   384\t                    'cites': ['e999999'], 'cites_views': [], 'pushes': [], 'changed': True, 'why_changed': '', 'theme_pushes': []}\n   385\t            return {'choices': [{'message': {'content': json.dumps(data)}}], 'usage': {'prompt_tokens': 100, 'completion_tokens': 10}}\n   386\t        return plain(provider, request)\n   387\t    return answer\n   388\t\n   389\t\n   390\tdef dry(out, kind, draw, refuse=(), twice=False):\n   391\t    \"\"\"$0: the sequence with a fake judge answering every bought judgement with markers unique to the sequence, the question and the\n   392\t    attempt (every one says changed, so propagation is at its largest), through the same acceptance gate as the send.\"\"\"\n   393\t    judge = refusing_judge(f'{kind}-{draw}', set(refuse), twice) if refuse else july_test.fake_judge(f'{kind}-{draw}', {})\n   394\t    summary = run_sequence(out, kind, draw, july_test.dispatcher(judge, july_test.fake_jev(set()), []), lambda: {}, 'dry')\n   395\t    print(json.dumps({'sequence': f'{kind}-{draw}', 'terminal': summary['terminal'], 'stopped': summary['stopped'][:200],\n   396\t                      'bought (admitted attempts)': sum(1 for a in summary['judge attempts at the transport'] if a['admitted']),\n   397\t                      'snapshot checks': summary['snapshot checks'], **summary['acceptance']}, indent=1))\n   398\t    return summary\n   399\t\n   400\t\n   401\tdef send(out, kind, draw, ledger_path, approved):\n   402\t    budget = july_test.budget_module()\n   403\t    if not (isinstance(approved, float) and math.isfinite(approved) and 0 < approved <= CEILING_LIMIT):\n   404\t        raise SystemExit('the approved ceiling must be a finite amount above 0 (and within the harness limit)')\n   405\t    ledger = budget.SharedLedger(str(ledger_path))\n   406\t    ceiling = ledger.read()['ceiling']\n   407\t    if not (isinstance(ceiling, (int, float)) and math.isfinite(ceiling) and ceiling == approved):\n   408\t        raise SystemExit(f'the ledger ceiling {ceiling!r} is not the approved ${approved}: refused')\n   409\t    label = f'{kind}-{draw}'\n   410\t    lock_handle = open(Path(ledger_path).with_name(f'{label}.launcher.lock'), 'a+')\n   411\t    if not ledger.claim_launcher(label, lock_handle):\n   412\t        raise SystemExit(f'another launch of {label} is running')\n   413\t    budget.install_stop_gate(ledger)\n   414\t    try:\n   415\t        summary = run_sequence(out, kind, draw, budget.BudgetTransport(ledger), ledger.read, 'paid')\n   416\t    finally:\n   417\t        ledger.remove_launcher(label)\n   418\t    print(json.dumps({'sequence': label, 'terminal': summary['terminal'], 'stopped': summary['stopped'][:300],\n   419\t                      'ledger': summary['ledger'], **summary['acceptance']}, indent=1))\n   420\t    return summary['acceptance']['accepted']\n   421\t\n   422\t\n   423\tif __name__ == '__main__':\n   424\t    command = sys.argv[1]\n   425\t    if command == 'plan':\n   426\t        plan()\n   427\t    elif command == 'pin':\n   428\t        pin(sys.argv[2])\n   429\t    elif command == 'dry':\n   430\t        sys.exit(0 if dry(Path(sys.argv[2]), sys.argv[3], sys.argv[4])['acceptance']['accepted'] else 1)\n   431\t    elif command == 'dry-refused-upstream':\n   432\t        sys.exit(0 if dry(Path(sys.argv[2]), 'linked', sys.argv[3], refuse={('v14', 3)})['acceptance']['accepted'] else 1)\n   433\t    elif command == 'dry-double-refusal':\n   434\t        summary = dry(Path(sys.argv[2]), sys.argv[3], sys.argv[4], refuse={('v9', 2)}, twice=True)\n   435\t        expected = {'outcome': 'double refusal', 'view': 'v9', 'reader': True}\n   436\t        sys.exit(0 if all(summary['terminal'].get(k) == v for k, v in expected.items()) and not summary['acceptance']['accepted'] else 1)\n   437\t    elif command == 'send':\n   438\t        sys.exit(0 if send(Path(sys.argv[2]), sys.argv[3], sys.argv[4], Path(sys.argv[5]), float(sys.argv[6])) else 1)\n   439\t    else:\n   440\t        raise SystemExit(f'unknown command {command}')\n     1\t\"\"\"$0 mutation check of the paid harness's own checks (PAID-DESIGN.md §3; AGENTS §4): each mutant changes one thing in its own process\n     2\tand must make the acceptance gate refuse the sequence (the named check false) or the sequence stop; the unmutated dry runs\n     3\t(paid-dry-*.log) are the controls. `units` runs the checks that need no replay.\n     4\t\n     5\t  python3 paid_mutants.py <scratch> <mutant name>\n     6\t  python3 paid_mutants.py units\n     7\t\"\"\"\n     8\timport json\n     9\timport sys\n    10\tfrom pathlib import Path\n    11\t\n    12\tsys.path.insert(0, str(Path(__file__).resolve().parent))\n    13\timport paid_run                                                         # noqa: E402\n    14\timport july_test                                                        # noqa: E402\n    15\tfrom hivemind.views import store as views_store                         # noqa: E402\n    16\t\n    17\tMUTANTS = {\n    18\t    'control not retired': ('control', '1', 'every post-link reader judgement fresh on its own day'),\n    19\t    'stale upstream recorded': ('linked', '1', 'upstream snapshot clean'),\n    20\t    'swapped upstreams': ('linked', '2', 'upstream snapshot clean'),\n    21\t    'a reader missing from the allow-list': ('linked', '1', 'window completed, no stop'),\n    22\t    'a probe link answer missing': ('linked', '1', 'window completed, no stop'),\n    23\t    'a non-reader bought': ('linked', '1', 'fixed trajectory (H2)'),\n    24\t}\n    25\t\n    26\t\n    27\tclass HarnessStore:\n    28\t    \"\"\"Only the harness's snapshot sees a mutated state; judging keeps the real store.\"\"\"\n    29\t\n    30\t    def __init__(self, current_state):\n    31\t        self.current_state = current_state\n    32\t\n    33\t    def __getattr__(self, attribute):\n    34\t        return getattr(views_store, attribute)\n    35\t\n    36\t\n    37\tdef run(scratch, name):\n    38\t    kind, draw, check = MUTANTS[name]\n    39\t    if name == 'control not retired':\n    40\t        paid_run.retired_rows = lambda reader_days: {}\n    41\t    elif name == 'stale upstream recorded':\n    42\t        def previous_state(conn, view_id):\n    43\t            rows = conn.execute('select judgement_id, rung, reasons, changed, seq, publication_day, reference, implied_outcome from judgements '\n    44\t                                'where view_id=? order by judgement_id desc limit 2', (view_id,)).fetchall()\n    45\t            return dict(rows[-1]) if rows else None\n    46\t        paid_run.store = HarnessStore(previous_state)\n    47\t    elif name == 'swapped upstreams':\n    48\t        def swapped(conn, view_id):\n    49\t            other = {'v9': 'v16', 'v16': 'v9'}.get(view_id, view_id)      # v21 reads v16 and v9 in draw 2: their states exchanged\n    50\t            return views_store.current_state(conn, other)\n    51\t        paid_run.store = HarnessStore(swapped)\n    52\t    elif name == 'a reader missing from the allow-list':\n    53\t        original_readers = paid_run.readers\n    54\t        paid_run.readers = lambda d: {k: v for k, v in original_readers(d).items() if k != 'v21'}\n    55\t    elif name == 'a probe link answer missing':\n    56\t        original_probe = paid_run.window_test.probe_answers\n    57\t\n    58\t        def fewer(d):\n    59\t            answers = original_probe(d)\n    60\t            answers.pop(sorted(answers)[0])\n    61\t            return answers\n    62\t        paid_run.window_test.probe_answers = fewer\n    63\t    elif name == 'a non-reader bought':\n    64\t        original_readers = paid_run.readers\n    65\t        paid_run.readers = lambda d: dict(original_readers(d), v8='2026-07-10')      # admission widened; the pinned plan is not\n    66\t        original_prepare = paid_run.prepare\n    67\t\n    68\t        def prepare(folder, kind_, draw_):\n    69\t            archive, top, retired = original_prepare(folder, kind_, draw_)\n    70\t            for (call_id,) in paid_run.old2().execute(\"select call_id from judgements where view_id='v8' and publication_day>='2026-07-10'\"):\n    71\t                archive.retire(call_id)\n    72\t            return archive, top, retired\n    73\t        paid_run.prepare = prepare\n    74\t    inner = july_test.dispatcher(july_test.fake_judge(f'mutant-{name}', {}), july_test.fake_jev(set()), [])\n    75\t    summary = paid_run.run_sequence(Path(scratch) / name.replace(' ', '-'), kind, draw, inner, lambda: {}, 'dry')\n    76\t    caught = not summary['acceptance'][check] and not summary['acceptance']['accepted']\n    77\t    print(json.dumps({'mutant': name, 'check expected to fail': check, 'caught': caught, 'stopped': summary['stopped'][:200],\n    78\t                      'acceptance': summary['acceptance']}, indent=1))\n    79\t    return caught\n    80\t\n    81\t\n    82\tdef units():\n    83\t    \"\"\"Checks without a replay: the latch race (July's); a request titled \"Thesis v14\" without the judgement schema, sent while a judging\n    84\t    day is set, is not admitted; a reader judgement whose call lies in another day's window is not fresh on its own day.\"\"\"\n    85\t    results = {'latch race': all(july_test.latch_race().values())}\n    86\t    run = paid_run.SequenceRun('linked', '1', lambda *a: {'ok': True}, Path('/nonexistent'))\n    87\t    run.day = '2026-07-20'\n    88\t    try:\n    89\t        run.transport('openai', {'messages': [{'role': 'user', 'content': 'Thesis v14 (NVDA, asset'}], 'response_format': {}})\n    90\t        results['a non-judgement request is not admitted'] = False\n    91\t    except july_test.Stop:\n    92\t        results['a non-judgement request is not admitted'] = run.attempts[-1]['admitted'] is False\n    93\t    pinned = {'readers': {'v9': '2026-07-10'}, 'graph': [], 'probe jobs': []}\n    94\t    judgement = {'view': 'v9', 'day': '2026-07-20', 'call_id': 105, 'judgement_id': 1, 'must be fresh': True,\n    95\t                 'fresh on its day': 100 < 105 <= 104, 'from the archive': False}\n    96\t    summary = {'stopped': '', 'terminal': {'outcome': 'complete'}, 'links committed': [], 'link jobs consumed': [],\n    97\t               'reader judgements': [judgement], 'snapshot problems': [], 'snapshot checks': 1, 'trajectory (H2)': {'x': True}}\n    98\t    results['a call outside its own day\\'s window is not fresh'] = not paid_run.acceptance(summary, pinned, 'control')['accepted']\n    99\t    print(json.dumps(results, indent=1))\n   100\t    return all(results.values())\n   101\t\n   102\t\n   103\tif __name__ == '__main__':\n   104\t    if sys.argv[1] == 'units':\n   105\t        sys.exit(0 if units() else 1)\n   106\t    sys.exit(0 if run(sys.argv[1], ' '.join(sys.argv[2:])) else 1)\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_10","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"for f in paid-dry-*.log paid-mutant-*.log paid-double-refusal-*.log paid-refused-reservation.log paid-units.log verdict-checks.log worksheet-verdict-dry.log; do printf '%s\\\\n' \\\"\"'$f\"; nl -ba \"$f\"; done; find /private/tmp/claude-501 -path '\"'*paid*/*/summary.json' -print | tail -36; rg -n 'preflight' PAID-BUILD.md\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"for f in paid-dry-*.log paid-mutant-*.log paid-double-refusal-*.log paid-refused-reservation.log paid-units.log verdict-checks.log worksheet-verdict-dry.log; do printf '%s\\\\n' \\\"\"'$f\"; nl -ba \"$f\"; done; find /private/tmp/claude-501 -path '\"'*paid*/*/summary.json' -print | tail -36; rg -n 'preflight' PAID-BUILD.md\"","aggregated_output":"paid-dry-control-1.log\n     1\t{\n     2\t \"sequence\": \"control-1\",\n     3\t \"terminal\": {\n     4\t  \"outcome\": \"complete\"\n     5\t },\n     6\t \"stopped\": \"\",\n     7\t \"bought (admitted attempts)\": 247,\n     8\t \"snapshot checks\": 0,\n     9\t \"window completed, no stop\": true,\n    10\t \"committed graph equals the pinned one (labels included)\": true,\n    11\t \"probe jobs consumed exactly the pinned set\": true,\n    12\t \"every post-link reader judgement fresh on its own day\": true,\n    13\t \"every pre-link reader judgement from the archive\": true,\n    14\t \"reader judgements present\": true,\n    15\t \"upstream snapshot clean\": true,\n    16\t \"upstream snapshot exercised (linked)\": true,\n    17\t \"fixed trajectory (H2)\": true,\n    18\t \"accepted\": true\n    19\t}\n    20\texit 0\npaid-dry-control-2.log\n     1\t{\n     2\t \"sequence\": \"control-2\",\n     3\t \"terminal\": {\n     4\t  \"outcome\": \"complete\"\n     5\t },\n     6\t \"stopped\": \"\",\n     7\t \"bought (admitted attempts)\": 247,\n     8\t \"snapshot checks\": 0,\n     9\t \"window completed, no stop\": true,\n    10\t \"committed graph equals the pinned one (labels included)\": true,\n    11\t \"probe jobs consumed exactly the pinned set\": true,\n    12\t \"every post-link reader judgement fresh on its own day\": true,\n    13\t \"every pre-link reader judgement from the archive\": true,\n    14\t \"reader judgements present\": true,\n    15\t \"upstream snapshot clean\": true,\n    16\t \"upstream snapshot exercised (linked)\": true,\n    17\t \"fixed trajectory (H2)\": true,\n    18\t \"accepted\": true\n    19\t}\n    20\texit 0\npaid-dry-control-3.log\n     1\t{\n     2\t \"sequence\": \"control-3\",\n     3\t \"terminal\": {\n     4\t  \"outcome\": \"complete\"\n     5\t },\n     6\t \"stopped\": \"\",\n     7\t \"bought (admitted attempts)\": 247,\n     8\t \"snapshot checks\": 0,\n     9\t \"window completed, no stop\": true,\n    10\t \"committed graph equals the pinned one (labels included)\": true,\n    11\t \"probe jobs consumed exactly the pinned set\": true,\n    12\t \"every post-link reader judgement fresh on its own day\": true,\n    13\t \"every pre-link reader judgement from the archive\": true,\n    14\t \"reader judgements present\": true,\n    15\t \"upstream snapshot clean\": true,\n    16\t \"upstream snapshot exercised (linked)\": true,\n    17\t \"fixed trajectory (H2)\": true,\n    18\t \"accepted\": true\n    19\t}\n    20\texit 0\npaid-dry-linked-1.log\n     1\t{\n     2\t \"sequence\": \"linked-1\",\n     3\t \"terminal\": {\n     4\t  \"outcome\": \"complete\"\n     5\t },\n     6\t \"stopped\": \"\",\n     7\t \"bought (admitted attempts)\": 266,\n     8\t \"snapshot checks\": 266,\n     9\t \"window completed, no stop\": true,\n    10\t \"committed graph equals the pinned one (labels included)\": true,\n    11\t \"probe jobs consumed exactly the pinned set\": true,\n    12\t \"every post-link reader judgement fresh on its own day\": true,\n    13\t \"every pre-link reader judgement from the archive\": true,\n    14\t \"reader judgements present\": true,\n    15\t \"upstream snapshot clean\": true,\n    16\t \"upstream snapshot exercised (linked)\": true,\n    17\t \"fixed trajectory (H2)\": true,\n    18\t \"accepted\": true\n    19\t}\n    20\texit 0\npaid-dry-linked-2.log\n     1\t{\n     2\t \"sequence\": \"linked-2\",\n     3\t \"terminal\": {\n     4\t  \"outcome\": \"complete\"\n     5\t },\n     6\t \"stopped\": \"\",\n     7\t \"bought (admitted attempts)\": 266,\n     8\t \"snapshot checks\": 266,\n     9\t \"window completed, no stop\": true,\n    10\t \"committed graph equals the pinned one (labels included)\": true,\n    11\t \"probe jobs consumed exactly the pinned set\": true,\n    12\t \"every post-link reader judgement fresh on its own day\": true,\n    13\t \"every pre-link reader judgement from the archive\": true,\n    14\t \"reader judgements present\": true,\n    15\t \"upstream snapshot clean\": true,\n    16\t \"upstream snapshot exercised (linked)\": true,\n    17\t \"fixed trajectory (H2)\": true,\n    18\t \"accepted\": true\n    19\t}\n    20\texit 0\npaid-dry-linked-3.log\n     1\t{\n     2\t \"sequence\": \"linked-3\",\n     3\t \"terminal\": {\n     4\t  \"outcome\": \"complete\"\n     5\t },\n     6\t \"stopped\": \"\",\n     7\t \"bought (admitted attempts)\": 266,\n     8\t \"snapshot checks\": 266,\n     9\t \"window completed, no stop\": true,\n    10\t \"committed graph equals the pinned one (labels included)\": true,\n    11\t \"probe jobs consumed exactly the pinned set\": true,\n    12\t \"every post-link reader judgement fresh on its own day\": true,\n    13\t \"every pre-link reader judgement from the archive\": true,\n    14\t \"reader judgements present\": true,\n    15\t \"upstream snapshot clean\": true,\n    16\t \"upstream snapshot exercised (linked)\": true,\n    17\t \"fixed trajectory (H2)\": true,\n    18\t \"accepted\": true\n    19\t}\n    20\texit 0\npaid-dry-refused-upstream.log\n     1\t{\n     2\t \"sequence\": \"linked-1\",\n     3\t \"terminal\": {\n     4\t  \"outcome\": \"complete\"\n     5\t },\n     6\t \"stopped\": \"\",\n     7\t \"bought (admitted attempts)\": 267,\n     8\t \"snapshot checks\": 267,\n     9\t \"window completed, no stop\": true,\n    10\t \"committed graph equals the pinned one (labels included)\": true,\n    11\t \"probe jobs consumed exactly the pinned set\": true,\n    12\t \"every post-link reader judgement fresh on its own day\": true,\n    13\t \"every pre-link reader judgement from the archive\": true,\n    14\t \"reader judgements present\": true,\n    15\t \"upstream snapshot clean\": true,\n    16\t \"upstream snapshot exercised (linked)\": true,\n    17\t \"fixed trajectory (H2)\": true,\n    18\t \"accepted\": true\n    19\t}\n    20\texit 0\npaid-mutant-1.log\n     1\t{\n     2\t \"mutant\": \"control not retired\",\n     3\t \"check expected to fail\": \"every post-link reader judgement fresh on its own day\",\n     4\t \"caught\": true,\n     5\t \"stopped\": \"\",\n     6\t \"acceptance\": {\n     7\t  \"window completed, no stop\": true,\n     8\t  \"committed graph equals the pinned one (labels included)\": true,\n     9\t  \"probe jobs consumed exactly the pinned set\": true,\n    10\t  \"every post-link reader judgement fresh on its own day\": false,\n    11\t  \"every pre-link reader judgement from the archive\": true,\n    12\t  \"reader judgements present\": true,\n    13\t  \"upstream snapshot clean\": true,\n    14\t  \"upstream snapshot exercised (linked)\": true,\n    15\t  \"fixed trajectory (H2)\": true,\n    16\t  \"accepted\": false\n    17\t }\n    18\t}\n    19\texit 0\npaid-mutant-2.log\n     1\t{\n     2\t \"mutant\": \"stale upstream recorded\",\n     3\t \"check expected to fail\": \"upstream snapshot clean\",\n     4\t \"caught\": true,\n     5\t \"stopped\": \"\",\n     6\t \"acceptance\": {\n     7\t  \"window completed, no stop\": true,\n     8\t  \"committed graph equals the pinned one (labels included)\": true,\n     9\t  \"probe jobs consumed exactly the pinned set\": true,\n    10\t  \"every post-link reader judgement fresh on its own day\": true,\n    11\t  \"every pre-link reader judgement from the archive\": true,\n    12\t  \"reader judgements present\": true,\n    13\t  \"upstream snapshot clean\": false,\n    14\t  \"upstream snapshot exercised (linked)\": true,\n    15\t  \"fixed trajectory (H2)\": true,\n 