{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba window_test.py | sed -n '38,310p'\"","aggregated_output":"    38\t\n    39\t\n    40\tdef refused_rows():\n    41\t    \"\"\"old-2's answers its own run refused (the archive keeps them under the request's hash with a ':refused:' suffix, so no later\n    42\t    identical request is answered with them): {request hash: stored provider response}. A replay must meet each refusal again to\n    43\t    reach the stored retry.\"\"\"\n    44\t    stored = sqlite3.connect(f'file:{OLD2 / \"archive.sqlite\"}?mode=ro', uri=True)\n    45\t    return {sha.split(':refused:')[0]: json.loads(response) for sha, response in\n    46\t            stored.execute(\"select request_sha256, response_json from model_calls where request_sha256 like '%:refused:%' order by call_id\")}\n    47\t\n    48\t\n    49\tdef replay_window(folder, link_answer):\n    50\t    \"\"\"poc-v119 from an empty ledger over the whole window: link questions go to `link_answer`; every other request must be answered\n    51\t    from the copy of old-2's archive (an answer old-2's own run refused is given back once, so the check refuses it again); anything\n    52\t    else stops the pass. Returns the census: equality with old-2, every link job, every opening with its pairs.\"\"\"\n    53\t    if folder.exists():\n    54\t        raise SystemExit(f'{folder} exists: a pass starts from an empty folder')\n    55\t    folder.mkdir(parents=True)\n    56\t    shutil.copyfile(OLD2 / 'archive.sqlite', folder / 'archive.sqlite')\n    57\t    views = folder / 'views.sqlite'\n    58\t    marker = sqlite3.connect(views)                 # marked harness-only before the first item: ordinary writers refuse it (D694 §0)\n    59\t    marker.execute('create table harness_only (name text, day text)')\n    60\t    marker.execute(\"insert into harness_only values ('window_test.py', '2026-11-21')\")\n    61\t    marker.commit()\n    62\t    marker.close()\n    63\t    held = live_lock.acquire(str(views))            # the store lock for the whole pass: no second writer\n    64\t    asked, refused_again = [], []\n    65\t    stored_refusals = refused_rows()\n    66\t\n    67\t    def transport(*args):\n    68\t        if len(args) == 1 and july_test.is_link_request(args[0]):\n    69\t            asked.append(sorted(args[0]['questions']))\n    70\t            return link_answer(args[0])\n    71\t        response = stored_refusals.pop(model.request_identity(args[-1])[1], None)\n    72\t        if response is not None:                   # old-2's own run refused this answer: give it back, so the check refuses it again\n    73\t            refused_again.append(model.request_identity(args[-1])[1][:12])\n    74\t            return response\n    75\t        (folder / 'missed-request.json').write_text(json.dumps(args[-1], ensure_ascii=False, indent=1))\n    76\t        raise july_test.Stop('a request other than a link question missed the archive')\n    77\t    started = time.time()\n    78\t    try:\n    79\t        totals = replay.run(testdb_path=str(ITEMS), views_path=str(views), archive=model.Archive(str(folder / 'archive.sqlite')),\n    80\t                            cfg=config.load(str(V119)), universe=universe.load(str(UNIVERSE)), from_day=WINDOW[0], until_day=WINDOW[1],\n    81\t                            transport=transport, log=lambda *a: None, only_objects={'NVDA'})\n    82\t    finally:\n    83\t        live_lock.release(held)\n    84\t    print('totals:', totals, 'seconds:', round(time.time() - started))\n    85\t    conn = sqlite3.connect(f'file:{folder / \"views.sqlite\"}?mode=ro', uri=True)\n    86\t    last_seq = conn.execute('select max(seq) from days_completed').fetchone()[0]\n    87\t    stored_last = sqlite3.connect(f'file:{OLD2 / \"views.sqlite\"}?mode=ro', uri=True).execute('select max(seq) from days_completed').fetchone()[0]\n    88\t    print('last completed seq', last_seq, 'old-2', stored_last)\n    89\t    equal = last_seq == stored_last and rebuild_control.compare(folder / 'views.sqlite', last_seq)\n    90\t    openings = []\n    91\t    for attempt, seq, status, record_json in conn.execute('select attempt_id, seq, status, record_json from link_selections order by id'):\n    92\t        record = json.loads(record_json)\n    93\t        if status == 'proposed' and record.get('pairs'):\n    94\t            openings.append({'attempt': attempt, 'seq': seq, 'pairs': record['pairs'], 'calls': record.get('calls', []),\n    95\t                             'proposed': record.get('proposed', []), 'corrections': record.get('corrections', [])})\n    96\t    census = {'equal to old-2': equal, 'link jobs asked': len(asked), 'questions in them': sum(len(a) for a in asked),\n    97\t              \"old-2's refused answers met again\": refused_again, 'left unmet': sorted(sha[:12] for sha in stored_refusals),\n    98\t              'link rows written': conn.execute(\"select count(*) from dependencies where kind='reads'\").fetchone()[0],\n    99\t              'openings with a pair shown': openings}\n   100\t    (folder / 'census.json').write_text(json.dumps(census, indent=1))\n   101\t    print(json.dumps({k: v for k, v in census.items() if k != 'openings with a pair shown'}, indent=1))\n   102\t    for opening in openings:\n   103\t        eligible = [p['thesis'] for p in opening['pairs'] if p.get('eligible')]\n   104\t        print(opening['seq'], 'eligible', eligible, 'not eligible', len(opening['pairs']) - len(eligible))\n   105\t    return census\n   106\t\n   107\t\n   108\tdef neither(scratch):\n   109\t    return replay_window(scratch / 'neither-v119', july_test.fake_jev(set()))['equal to old-2']\n   110\t\n   111\t\n   112\tCENSUS_CEILING = 0.10\n   113\t\n   114\t\n   115\tclass Everything:\n   116\t    def __contains__(self, item):\n   117\t        return True\n   118\t\n   119\t\n   120\tdef without_links(run):\n   121\t    \"\"\"Run `run()` with the writer handed no proposed link (the census's only change to the product path).\"\"\"\n   122\t    from hivemind.views import writing\n   123\t    original_write = writing.write\n   124\t\n   125\t    def write_without_links(*args, **keywords):\n   126\t        keywords['proposed_links'] = None\n   127\t        return original_write(*args, **keywords)\n   128\t    writing.write = write_without_links\n   129\t    try:\n   130\t        return run()\n   131\t    finally:\n   132\t        writing.write = original_write\n   133\t\n   134\t\n   135\tdef complete(result):\n   136\t    \"\"\"A draw counts only when it asked every registered pair and finished each stage: the READS answers per opening are exactly the\n   137\t    eligible pairs of the `neither` pass, every READS answer that passed (a reading direction at 0.5 or more) has its SIGN answer, and\n   138\t    every Jev job was answered. Returns (complete, problems).\"\"\"\n   139\t    expected = {(o['seq'], p['thesis']) for o in json.loads((HERE / 'neither-census.json').read_text())['openings with a pair shown']\n   140\t                for p in o['pairs'] if p.get('eligible')}\n   141\t    problems, reads, signs = [], set(), set()\n   142\t    for opening in result['openings with a pair shown']:\n   143\t        for pair in opening['pairs']:\n   144\t            if 'reads' in pair:\n   145\t                reads.add((opening['seq'], pair['thesis']))\n   146\t                choice = pair['reads']\n   147\t                if choice != links.NEITHER and pair['probabilities'].get(choice, 0) >= links.THRESHOLD:\n   148\t                    signs.add((opening['seq'], pair['thesis']))\n   149\t        answered_signs = {(opening['seq'], p['thesis']) for p in opening['pairs'] if 'sign' in p}\n   150\t        missing = {s for s in signs if s[0] == opening['seq']} - answered_signs\n   151\t        if missing:\n   152\t            problems.append(f'seq {opening[\"seq\"]}: no SIGN answer for {sorted(missing)}')\n   153\t        problems += [f'seq {opening[\"seq\"]}: a job {c.get(\"stage\")} ended {c.get(\"status\")}' for c in opening['calls'] if c.get('status') != 'answered']\n   154\t    if reads != expected:\n   155\t        problems.append(f'READS pairs differ from the registered manifest: missing {sorted(expected - reads)}, extra {sorted(reads - expected)}')\n   156\t    return not problems, problems\n   157\t\n   158\t\n   159\tdef census_dry(scratch):\n   160\t    \"\"\"$0: the census pass with a fake Jev that answers every eligible pair \"the THESIS reads the CANDIDATE\", sign together (the\n   161\t    largest number of proposals); with the writer handed no link, the pass must still end equal to old-2 with no link row, and the\n   162\t    draw must be complete (every registered READS pair, a SIGN answer for each).\"\"\"\n   163\t    result = without_links(lambda: replay_window(scratch / 'census-dry', july_test.fake_jev(Everything())))\n   164\t    proposed = sum(len(o['proposed']) for o in result['openings with a pair shown'])\n   165\t    whole, problems = complete(result)\n   166\t    print('links proposed by the fake answers:', proposed, 'complete:', whole, problems)\n   167\t    return result['equal to old-2'] and result['link rows written'] == 0 and proposed == 105 and whole\n   168\t\n   169\t\n   170\tdef census(scratch, draw, ledger_path, approved):\n   171\t    \"\"\"One draw of the link decisions over the window: each link job sent to Jev as poc-v119 builds it, through the comparison runs'\n   172\t    reservation ledger (`july_test.budget_module`: Jev reserved at its published 64K limit for each of its three attempts); the\n   173\t    writer is handed no proposed link, so no link row is written and every later request stays old-2's (the pass checks equality at the\n   174\t    end). The ledger is created beforehand with the ceiling Alex approved; each draw registers its launcher, so the stop gate stops\n   175\t    every draw when one dies. A draw is counted only when it is complete and the ledger never stopped.\"\"\"\n   176\t    budget = july_test.budget_module()\n   177\t    if not (isinstance(approved, float) and math.isfinite(approved) and 0 < approved <= CENSUS_CEILING):\n   178\t        raise SystemExit(f'the approved ceiling must be a finite amount above 0 and at most ${CENSUS_CEILING}')\n   179\t    if not Path(ledger_path).exists():\n   180\t        raise SystemExit('the ledger does not exist: create it first (budget_replay.py --init-ledger L --ceiling <approved>)')\n   181\t    ledger = budget.SharedLedger(str(ledger_path))\n   182\t    ceiling = ledger.read()['ceiling']\n   183\t    if not (isinstance(ceiling, (int, float)) and math.isfinite(ceiling) and ceiling == approved):\n   184\t        raise SystemExit(f'the ledger ceiling {ceiling!r} is not the approved ${approved}: refused')\n   185\t    label = f'census-{draw}'\n   186\t    lock_handle = open(Path(ledger_path).with_name(f'{label}.launcher.lock'), 'a+')\n   187\t    if not ledger.claim_launcher(label, lock_handle):\n   188\t        raise SystemExit(f'another launch of {label} is running')\n   189\t    budget.install_stop_gate(ledger)\n   190\t    try:\n   191\t        return census_pass(scratch / label, draw, budget.BudgetTransport(ledger), ledger.read)\n   192\t    finally:\n   193\t        ledger.remove_launcher(label)\n   194\t\n   195\t\n   196\tdef census_pass(folder, draw, inner, ledger_state):\n   197\t    \"\"\"One census draw into `folder`: the seq-148 jobs answered by this draw's July sample, every other link job by `inner`, the writer\n   198\t    handed no link. Writes `draw.json`; the draw is counted only when it is complete, reused both July answers, ended equal to old-2\n   199\t    with no link row, and the ledger neither stopped nor overran.\"\"\"\n   200\t    stored, reused = july_answers(draw), []\n   201\t\n   202\t    def link_answer(request):\n   203\t        sha = model.request_identity(request)[1]\n   204\t        if sha in stored:                          # the July sample of this draw for the same request (seq 148): not bought again\n   205\t            reused.append(sha[:12])\n   206\t            return stored[sha]\n   207\t        return inner(request)\n   208\t    result = without_links(lambda: replay_window(folder, link_answer))\n   209\t    state = ledger_state()\n   210\t    whole, problems = complete(result)\n   211\t    if sorted(reused) != sorted(sha[:12] for sha in stored):\n   212\t        whole, problems = False, problems + [f'July samples reused {reused}, expected {sorted(sha[:12] for sha in stored)}']\n   213\t    counted = result['equal to old-2'] and result['link rows written'] == 0 and whole and not state.get('stopped') and not state.get('overrun')\n   214\t    (folder / 'draw.json').write_text(json.dumps({'draw': draw, 'counted': counted, 'complete': whole, 'problems': problems,\n   215\t                                                  'equal to old-2': result['equal to old-2'], 'july samples reused': reused,\n   216\t                                                  'ledger': state}, indent=1))\n   217\t    print('ledger:', state, 'complete:', whole, problems, 'july reused:', reused)\n   218\t    return counted\n   219\t\n   220\t\n   221\tdef census_reuse_dry(scratch):\n   222\t    \"\"\"$0: a census draw whose bought jobs are answered \"neither\" by a fake Jev: the seq-148 jobs must be answered by draw 1's July\n   223\t    sample (both reused), the draw complete and counted, and the record must show v9 reads v14 proposed at seq 148.\"\"\"\n   224\t    counted = census_pass(scratch / 'census-reuse-dry', '1', july_test.fake_jev(set()), lambda: {'stopped': False, 'overrun': False})\n   225\t    conn = sqlite3.connect(f'file:{scratch / \"census-reuse-dry\" / \"views.sqlite\"}?mode=ro', uri=True)\n   226\t    proposed = [json.loads(r)['proposed'] for (r,) in conn.execute(\"select record_json from link_selections where status='proposed' and seq=148\")]\n   227\t    print('seq 148 proposed:', proposed)\n   228\t    return counted and proposed and len(proposed[0]) == 1\n   229\t\n   230\t\n   231\tJULY_DRAWS = {'1': 'linked-1', '2': 'linked-2', '3': 'linked-3'}\n   232\t\n   233\t\n   234\tdef july_answers(draw):\n   235\t    \"\"\"The July test's answers to the seq-148 link jobs (READS, call 8738; SIGN, call 8739) of the linked sequence paired with this\n   236\t    draw: {request hash: stored Jev response}. The census rebuilds the same READS request (sha 6dcb7664…); the SIGN request matches\n   237\t    when the READS answer passes the same pairs, which the reused answer guarantees.\"\"\"\n   238\t    if draw not in JULY_DRAWS:\n   239\t        raise SystemExit(f'draw must be one of {sorted(JULY_DRAWS)} (each reuses one July sequence\\'s seq-148 answers)')\n   240\t    archive = sqlite3.connect(f'file:{REPO / \"poc/data/july-link-test-2026-11-21\" / JULY_DRAWS[draw] / \"archive.sqlite\"}?mode=ro', uri=True)\n   241\t    return {sha: json.loads(response) for sha, response in\n   242\t            archive.execute('select request_sha256, response_json from model_calls where call_id in (8738, 8739)')}\n   243\t\n   244\t\n   245\tif __name__ == '__main__':\n   246\t    command, scratch = sys.argv[1], Path(sys.argv[2])\n   247\t    if command == 'neither':\n   248\t        sys.exit(0 if neither(scratch) else 1)\n   249\t    if command == 'census-dry':\n   250\t        sys.exit(0 if census_dry(scratch) else 1)\n   251\t    if command == 'census-reuse-dry':\n   252\t        sys.exit(0 if census_reuse_dry(scratch) else 1)\n   253\t    if command == 'census':\n   254\t        sys.exit(0 if census(scratch, sys.argv[3], Path(sys.argv[4]), float(sys.argv[5])) else 1)\n   255\t    raise SystemExit(f'unknown command {command}')\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc 'nl -ba read_census.py; nl -ba expected_links.py'","aggregated_output":"     1\t\"\"\"Score the census draws against the registered reading (`expected-links.json`, written before any census answer was read).\n     2\t\n     3\t  python3 read_census.py <census-1 folder> <census-2 folder> <census-3 folder> > census-result.md\n     4\t\n     5\tThe scorer refuses unless it is given exactly three distinct draws (1, 2, 3), each with a `draw.json` that says it was counted\n     6\t(complete, both July seq-148 answers reused, equal to old-2, no link row, the ledger never stopped or overran: `window_test.census`),\n     7\tand unless every registered pair has a READS answer in every draw.\n     8\t\n     9\tPer pair and draw: the READS answer (choice and probabilities), the SIGN answer when asked, and the decision the product takes (a link\n    10\tneeds a reading direction at 0.5 or more and a sign of together or opposite at 0.5 or more). Verdicts:\n    11\t  R pair (the known positive): right only when the registered direction is linked with the sign together (a higher total makes a\n    12\t    higher Data Center figure more likely); missed when no link is written; wrong for the opposite direction or the opposite sign;\n    13\t  W pair: wrong if linked, right if not;\n    14\t  O pair: reported only.\n    15\tA margin (the winning READS probability minus the next) below 0.10 on a linked or a required pair is flagged as fragile.\n    16\tThe gate (DESIGN.md §3): no wrong link in any draw, and the known positive right in every draw.\n    17\t\"\"\"\n    18\timport json\n    19\timport sqlite3\n    20\timport sys\n    21\tfrom pathlib import Path\n    22\t\n    23\tHERE = Path(__file__).resolve().parent\n    24\tTHRESHOLD = 0.5\n    25\tREADS = {'candidate_reads_thesis', 'thesis_reads_candidate'}\n    26\tSIGNS = {'together', 'opposite'}\n    27\tREQUIRED_SIGN = 'together'\n    28\t\n    29\t\n    30\tclass Refused(SystemExit):\n    31\t    pass\n    32\t\n    33\t\n    34\tdef decisions(views_path):\n    35\t    \"\"\"{(seq, thesis): {'reads': choice, 'p': probabilities, 'sign': choice or None, 'sp': probabilities or None}}\"\"\"\n    36\t    conn = sqlite3.connect(f'file:{views_path}?mode=ro', uri=True)\n    37\t    out = {}\n    38\t    for seq, record_json in conn.execute(\"select seq, record_json from link_selections where status='proposed' order by id\"):\n    39\t        for pair in json.loads(record_json).get('pairs', []):\n    40\t            if 'thesis' not in pair:\n    41\t                continue\n    42\t            entry = out.setdefault((seq, pair['thesis']), {'reads': None, 'p': None, 'sign': None, 'sp': None})\n    43\t            if 'reads' in pair:\n    44\t                entry['reads'], entry['p'] = pair['reads'], pair['probabilities']\n    45\t            if 'sign' in pair:\n    46\t                entry['sign'], entry['sp'] = pair['sign'], pair['probabilities']\n    47\t    return out\n    48\t\n    49\t\n    50\tdef linked(entry, new, thesis):\n    51\t    \"\"\"(direction '<reader> reads <read>', sign) the product writes, or (None, None).\"\"\"\n    52\t    if entry['reads'] not in READS or entry['p'][entry['reads']] < THRESHOLD:\n    53\t        return None, None\n    54\t    if entry['sign'] not in SIGNS or entry['sp'][entry['sign']] < THRESHOLD:\n    55\t        return None, None\n    56\t    direction = f'{new} reads {thesis}' if entry['reads'] == 'candidate_reads_thesis' else f'{thesis} reads {new}'\n    57\t    return direction, entry['sign']\n    58\t\n    59\t\n    60\tdef margin(entry):\n    61\t    values = sorted(entry['p'].values(), reverse=True)\n    62\t    return round(values[0] - values[1], 2)\n    63\t\n    64\t\n    65\tdef score(draws, expected):\n    66\t    \"\"\"draws: [(name, decisions)]. Returns (rows, summary); refuses when a registered pair has no READS answer in a draw.\"\"\"\n    67\t    rows, wrong, missed, right, fragile, positive = [], [], [], [], [], []\n    68\t    for key, reg in expected.items():\n    69\t        seq, thesis = int(key.split(':')[0]), key.split(':')[1]\n    70\t        cells = []\n    71\t        for name, answers in draws:\n    72\t            entry = answers.get((seq, thesis))\n    73\t            if entry is None or entry['p'] is None:\n    74\t                raise Refused(f'{name}: no READS answer for the registered pair {key}')\n    75\t            direction, sign = linked(entry, reg['new'], thesis)\n    76\t            m = margin(entry)\n    77\t            short = {'candidate_reads_thesis': 'new→', 'thesis_reads_candidate': '←new', 'neither': 'none'}[entry['reads']]\n    78\t            cell = f\"{short} {entry['p'][entry['reads']]:.2f} (m {m:.2f})\" + (f\"; {entry['sign']} {entry['sp'][entry['sign']]:.2f}\" if entry['sign'] else '')\n    79\t            if reg['class'] == 'R':\n    80\t                if direction is None:\n    81\t                    verdict = 'missed'\n    82\t                elif direction == reg['direction'] and sign == REQUIRED_SIGN:\n    83\t                    verdict = 'right'\n    84\t                else:\n    85\t                    verdict = 'WRONG'\n    86\t                positive.append(verdict == 'right')\n    87\t            elif reg['class'] == 'W':\n    88\t                verdict = 'WRONG' if direction else 'right'\n    89\t            else:\n    90\t                verdict = f'linked: {direction} ({sign})' if direction else 'no link'\n    91\t            if verdict == 'WRONG':\n    92\t                wrong.append((name, key, direction, sign))\n    93\t            elif verdict == 'missed':\n    94\t                missed.append((name, key))\n    95\t            elif verdict == 'right' and reg['class'] == 'R':\n    96\t                right.append((name, key))\n    97\t            if (direction or reg['class'] == 'R') and m < 0.10:\n    98\t                fragile.append((name, key, m))\n    99\t            cells.append(f'{cell} → {verdict}')\n   100\t        rows.append((seq, reg, thesis, cells))\n   101\t    gate = not wrong and bool(positive) and all(positive)\n   102\t    return rows, {'right': right, 'missed': missed, 'wrong': wrong, 'fragile': fragile, 'gate': gate}\n   103\t\n   104\t\n   105\tdef counted_draws(folders):\n   106\t    if len(folders) != 3:\n   107\t        raise Refused(f'three census draws are required, got {len(folders)}')\n   108\t    seen = []\n   109\t    for folder in folders:\n   110\t        record_path = Path(folder) / 'draw.json'\n   111\t        if not record_path.exists():\n   112\t            raise Refused(f'{folder}: no draw.json (not a census draw)')\n   113\t        record = json.loads(record_path.read_text())\n   114\t        if not record.get('counted'):\n   115\t            raise Refused(f'{folder}: the draw was not counted: {record.get(\"problems\")}')\n   116\t        seen.append(record['draw'])\n   117\t    if sorted(seen) != ['1', '2', '3']:\n   118\t        raise Refused(f'the draws must be 1, 2 and 3, got {seen}')\n   119\t    return [(Path(f).name, decisions(Path(f) / 'views.sqlite')) for f in folders]\n   120\t\n   121\t\n   122\tdef main(folders):\n   123\t    expected = json.loads((HERE / 'expected-links.json').read_text())\n   124\t    draws = counted_draws(folders)\n   125\t    rows, summary = score(draws, expected)\n   126\t    print('# Census of the link decisions over the window, scored against the registered reading\\n')\n   127\t    print('| seq | new | shown | class | registered | ' + ' | '.join(name for name, _ in draws) + ' |')\n   128\t    print('|---|---|---|---|---|' + '---|' * len(draws))\n   129\t    for seq, reg, thesis, cells in rows:\n   130\t        print(f\"| {seq} | {reg['new']} | {thesis} | {reg['class']} | {reg['direction'] or ''} | \" + ' | '.join(cells) + ' |')\n   131\t    print(f'\\nDraws: 3 (the seq-148 jobs of each answered by its paired July sample).')\n   132\t    print(f\"Known positive right: {len(summary['right'])}; missed: {len(summary['missed'])} {summary['missed']}\")\n   133\t    print(f\"Wrong links: {len(summary['wrong'])} {summary['wrong']}\")\n   134\t    print(f\"Fragile (margin below 0.10 on a linked or required pair): {len(summary['fragile'])} {summary['fragile']}\")\n   135\t    print(f\"\\nGate (no wrong link in any draw; the known positive right in every draw): {'PASS' if summary['gate'] else 'FAIL'}\")\n   136\t\n   137\t\n   138\tif __name__ == '__main__':\n   139\t    main(sys.argv[1:])\n     1\t\"\"\"The registered reading of every eligible pair of the census, written before any census answer is read (council R round 13): each\n     2\tof the 105 pairs of `neither-census.json` gets one class.\n     3\t\n     4\t  R  the required link, with its direction and sign: the known positive only (round 14), Data Center revenue reading total revenue\n     5\t     (D537's clear case; the READS criterion's own first example, a product line read against the company's total). Missing it is a\n     6\t     miss; the opposite direction or the opposite sign is a wrong link.\n     7\t  W  any link is wrong: neither answer bounds or drives the other (the criterion's \"neither\" class) and the material each was shown\n     8\t     names no connection: a financing or commitment amount against a revenue, growth or margin question (supply commitments, and credit\n     9\t     support against revenue, excepted below), and two financing amounts of different kinds.\n    10\t  O  open: defensible either way under the criterion as written (overlapping scopes; growth against the amount it is computed from;\n    11\t     another period of the same quantity; supply commitments against revenue or margin; gross margin against revenue). Reported, not\n    12\t     scored.\n    13\t\n    14\tThe seq-148 pairs were seen before this registration (the July test's answers): disclosed with every score.\n    15\t\n    16\t  python3 expected_links.py > expected-links.md\n    17\t\"\"\"\n    18\timport json\n    19\tfrom pathlib import Path\n    20\t\n    21\tHERE = Path(__file__).resolve().parent\n    22\tREQUIRED = {('v9', 'v14'): 'Data Center revenue read against total revenue: D537\\'s clear case, the known positive'}\n    23\tFINANCING = {'v1', 'v2', 'v15', 'v29', 'v32', 'v36'}\n    24\tREVENUE = {'v8', 'v9', 'v14', 'v16', 'v17', 'v21', 'v35'}\n    25\tMARGIN = {'v28', 'v33'}\n    26\tCREDIT = {'v1', 'v2'}\n    27\tOPEN_FINANCING = {frozenset({'v1', 'v2'}): 'AI-cloud credit support sits inside all customer and cloud-provider credit support; either may read the other',\n    28\t                  frozenset({'v15', 'v32'}): 'a licence payment commitment may sit inside supply commitments',\n    29\t                  frozenset({'v29', 'v36'}): 'a convertible-bond investment may or may not count as an equity investment commitment'}\n    30\t\n    31\t\n    32\tdef classify(a, b):\n    33\t    \"\"\"(class, direction or None, reason) for the unordered pair a, b, from the scopes and the evidence each was shown with (round 14:\n    34\t    only the known positive is required; a W pair is one whose shown material names no connection).\"\"\"\n    35\t    for (reader, read), reason in REQUIRED.items():\n    36\t        if {a, b} == {reader, read}:\n    37\t            return 'R', f'{reader} reads {read}', reason\n    38\t    pair = frozenset({a, b})\n    39\t    if pair in OPEN_FINANCING:\n    40\t        return 'O', None, OPEN_FINANCING[pair]\n    41\t    if 'v15' in pair and pair & (REVENUE | MARGIN):\n    42\t        return 'O', None, 'supply commitments, shown as \"tying its fortunes to hyperscaler order books\", against revenue or margin'\n    43\t    if pair & CREDIT and pair & REVENUE:\n    44\t        return 'O', None, 'the credit-support evidence shown says NVIDIA earns product revenue and a share of cloud revenue on the supported capacity'\n    45\t    if pair <= FINANCING:\n    46\t        return 'W', None, 'two financing amounts of different kinds; the shown material names no connection'\n    47\t    if pair & FINANCING and pair & (REVENUE | MARGIN):\n    48\t        return 'W', None, 'a financing amount against a revenue, growth or margin question; the shown material names no connection'\n    49\t    return 'O', None, 'part and whole far apart, overlapping scopes, growth against its amount, another period, or margin against revenue'\n    50\t\n    51\t\n    52\tdef main():\n    53\t    census = json.loads((HERE / 'neither-census.json').read_text())\n    54\t    rows, counts = [], {'R': 0, 'W': 0, 'O': 0}\n    55\t    for opening in census['openings with a pair shown']:\n    56\t        for pair in opening['pairs']:\n    57\t            if not pair.get('eligible'):\n    58\t                continue\n    59\t            rows.append((opening['seq'], pair['thesis']))\n    60\t    import sqlite3\n    61\t    stored = sqlite3.connect('file:' + str(HERE.parents[2] / 'poc/data/comparison-2026-11-17/run/old-2/prod/views.sqlite') + '?mode=ro', uri=True)\n    62\t    new_at = {seq: stored.execute('select view_id from views where created_seq=? and view_id in (select view_id from view_keys)', (seq,)).fetchone()[0]\n    63\t              for seq, _ in rows}\n    64\t    out = {}\n    65\t    print('# Registered reading of the census pairs (written before any census answer; `expected_links.py`)\\n')\n    66\t    print('| seq | new | shown | class | required direction | reason |')\n    67\t    print('|---|---|---|---|---|---|')\n    68\t    for seq, thesis in rows:\n    69\t        kind, direction, reason = classify(new_at[seq], thesis)\n    70\t        counts[kind] += 1\n    71\t        out[f'{seq}:{thesis}'] = {'new': new_at[seq], 'shown': thesis, 'class': kind, 'direction': direction}\n    72\t        print(f'| {seq} | {new_at[seq]} | {thesis} | {kind} | {direction or \"\"} | {reason} |')\n    73\t    print(f'\\nPairs: {len(rows)}; R {counts[\"R\"]}, W {counts[\"W\"]}, O {counts[\"O\"]}. The seq-148 pairs were seen before this registration.')\n    74\t    (HERE / 'expected-links.json').write_text(json.dumps(out, indent=1))\n    75\t\n    76\t\n    77\tif __name__ == '__main__':\n    78\t    main()\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_7","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba DESIGN.md | sed -n '70,140p'; rg -n -A 16 '\"'^## D700'\"' ../../DECISIONS-log.md\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba DESIGN.md | sed -n '70,140p'; rg -n -A 16 '\"'^## D700'\"' ../../DECISIONS-log.md\"","aggregated_output":"    70\t## 3. Before any judgement is bought: the link decisions over the window\n    71\t\n    72\t**The July answers were close to a coin flip.** In each linked sequence Jev answered the 07-10 opening of v14 (total revenue FY2027)\n    73\tagainst v9 (Data Center FY2027): \"v9 reads v14\" 0.52, 0.54, 0.51; \"v14 reads v9\" 0.47, 0.45, 0.48. The rule takes Jev's choice at\n    74\t0.5 or more (`links.THRESHOLD`), so a shift of 0.02 gives no link or the opposite link. The same opening's v14–v8 (stand-alone CPU)\n    75\tpair: \"v14 reads v8\" 0.47, 0.46, 0.44 (below the line), \"neither\" ~0.40. JULY-RESULT.md reported the link \"chosen in 3 of 3\" without\n    76\tthese margins; this is added to it.\n    77\t\n    78\t**Mechanism (prompt audit, `links.READS_CRITERIA`):** \"candidate_reads_thesis\" covers \"a part read against its whole ... or a\n    79\tquantity read against another it depends on\"; for a total against its own segment, both readings fit: the segment is a part of the\n    80\ttotal, and the total depends on the segment. D537 names the one sourced case for a new link: Data Center revenue reading total\n    81\trevenue; PRD 06 line 134 and D368 describe the historical seed arrows and give no rule for a newly chosen link (round 13). Verdict:\n    82\t**abstract** (the criterion admits both directions for a part against its whole).\n    83\t\n    84\t**The census** (`window_test.py census`, Jev only): the same whole-window pass with each link job sent to Jev as poc-v119 builds it\n    85\tand the writer handed no link, so no row is written and every later request stays old-2's (checked by the same equality). Three draws\n    86\tshare one reservation ledger, ceiling $0.10 (Alex, D700; Jev reserved at its published 64K limit for each of its three attempts, as in\n    87\tJuly). In draw n the two seq-148 jobs are answered by July's linked-n answers (the same requests, sha 6dcb7664… and d118a387…), not\n    88\tbought again (round 14); `census-reuse-dry` proved it at $0 (both reused, v9 reads v14 together proposed, complete, equal to old-2,\n    89\t`census-reuse-dry.log`).\n    90\tIts $0 checks: `census-dry` (every eligible pair answered \"the THESIS reads the CANDIDATE\", sign together: 28 jobs, 105 links\n    91\tproposed, 0 written, equal to old-2 in every table, `census-dry.log`); the mutant (the same fake answers with links written) stops on\n    92\t07-01 at the first reader judgement, which misses the archive (`census-mutant.log`). Cost: 14 READS jobs of 1 to 14 questions per\n    93\tdraw plus the SIGN jobs of what passes; Jev input at $0.042 per million tokens.\n    94\tRead for every eligible pair: the answer and its probabilities in each draw; whether the chosen direction and sign are right under\n    95\tthe criterion's own examples; whether the decision is the same in 3 of 3 draws.\n    96\t\n    97\t**The registered reading (rounds 13–14: a gate needs a known positive, registered before any answer is read):** `expected_links.py`\n    98\t→ `expected-links.md` / `.json` classes each of the 105 pairs from its scopes and the evidence each question was shown with: **R**,\n    99\tthe known positive only, v9 reads v14 with the sign together (D537's clear case; the criterion's own first example); **W**, any link\n   100\twrong: the shown material names no connection (equity investment, licence and convertible-bond amounts against revenue, growth or\n   101\tmargin; credit support against margin; two financing amounts of different kinds): 43 pairs; **O**, defensible either way and reported\n   102\tonly: 61 pairs (credit support against revenue, since its shown evidence says NVIDIA earns product revenue on the supported capacity;\n   103\tsupply commitments against revenue or margin; CPU parts against totals far above them; growth against its amount; another period).\n   104\tRound 14 moved the CPU-to-total and credit-support-to-revenue pairs out of R and W. The seq-148 pairs were seen before the\n   105\tregistration (the July answers), disclosed with every score.\n   106\t\n   107\t**Scoring** (`read_census.py`): it refuses unless given exactly draws 1, 2 and 3, each with a `draw.json` saying it was counted, and\n   108\tunless every registered pair has a READS answer in every draw. Per pair and draw: the READS and SIGN answers and the product's decision\n   109\t(a reading direction at 0.5 or more and a sign of together or opposite at 0.5 or more); R right only with the registered direction and\n   110\tthe sign together, missed with no link, wrong otherwise; W wrong if linked; a margin below 0.10 on a linked or required pair flagged\n   111\tfragile, not a gate. $0 checks (`scorer-checks.log`): no draws and folders without `draw.json` refused; a missing READS answer\n   112\trefused; the fake \"reads\" answers give 129 wrong links and gate FAIL; a control with only the known positive linked passes; the known\n   113\tpositive with the sign opposite, or reversed, fails.\n   114\t\n   115\t**Gate:** no wrong link in any draw, and the known positive right in every draw. Pass: the paid design goes to its own council round on\n   116\tthe current wording, with the misses, the O links and the fragile pairs disclosed. Fail: the wrong-link class goes to the council; a\n   117\twording that fixes the part-and-whole direction changes what the system does and goes to Alex with options and a recommendation before\n   118\tany judgement is bought. Already known: the known positive's July margins are 0.05, 0.09 and 0.03 (fragile).\n   119\t\n   120\t**A draw counts only when complete** (`window_test.complete`): its READS answers are exactly the registered pairs, every READS answer\n   121\tthat passed has its SIGN answer, every job was answered, the pass ends equal to old-2 with no link row, and the ledger never stopped\n   122\tor overran. Mutants on the dry record: a dropped READS answer, a dropped SIGN answer and a failed job are each caught.\n   123\t\n   124\t**Budget:** each draw registers its launcher with the shared ledger (`claim_launcher`, so the stop gate stops every draw when one\n   125\tdies); the ledger is created with the ceiling Alex names and the harness refuses any other, a non-finite one, or one above $0.10\n   126\t(checked: NaN, 0 and 0.2 refused). The store is marked harness-only and held under its lock for the pass. Priced from the dry pass's\n   127\t28 jobs: the ledger settles a Jev call at three times its reported input (`budget_replay`), so a draw settles about $0.022 at most\n   128\t(tokens 0.37 of the request's bytes, the larger July ratio; every SIGN job included); three draws $0.066; the largest reservation\n   129\t$0.0084. The draws run one after another, so the live headroom is one reservation (round 14: $0.066 + $0.0084 = about $0.074 under $0.10); a\n   130\tbudget stop leaves the census incomplete. Preflight over old-2's whole-window archive and ledger (`preflight-window.log`): extraction\n   131\t1,884 rows replayed, 6,817 statements judged, 69 dropped (as stored); matching 1,277 records judged, 3 refused and 10 skipped, all\n   132\tthree refusals artefacts of reading the final state (v28 and v14 \"already have a successor\", v40 \"closed\": the successions and the\n   133\tclosing came later), the 10 skipped requests rebuilt from the final state; enum names 46, none missing; 42 keyed open views, no\n   134\tduplicate key. The `neither` pass, which replays every request with the state of its time, met every request in the archive.\n   135\t\n   136\t## 4. The paid run (after the census, the council and Alex's ceiling)\n   137\t\n   138\t- **Linked, three sequences:** poc-v119, each on its own copy of old-2's archive and an empty ledger, the whole window. Jev's link\n   139\t  answers are not byte-stable (the July probabilities moved by up to 0.03), so the three may choose different links; each is read.\n   140\t- **Control, three sequences:** poc-v118 on its own archive copy with the judge rows of every reader of the linked sequences (their\n10515:## D700 · 2026-11-21 · Alex approves a $0.10 ceiling for the census of the link decisions before the whole-window run\n10516-\n10517-- **The question** (after council R round 13 found the July link's direction close to a coin flip, `docs/research/2026-11-21-whole-window/DESIGN.md`\n10518-  §3): \"正式完整运行之前，我想先花几美分，单独测一下连题这一步本身 … 把整个期间会遇到的 105 对候选题，每对问 3 遍，看它连得稳不稳、有没有连错。这一步不付钱买任何判断，预计 2–7 美分。上限 10 美分可以吗？\"\n10519-  Options: 10 美分 (recommended; link questions only, three draws, stop above $0.10, the result goes to the council before the run is\n10520-  decided); 先别花 (no census; the run discussed with the known coin-flip risk).\n10521-- **Alex's answer** (2026-11-21): \"10 美分 (推荐)\".\n10522-- **Decided (Alex):** the census may spend up to $0.10 (Jev link questions only, three draws, the writer handed no link), after the\n10523-  council passes its harness. The whole-window run keeps its own ceiling question (D699).\n","exit_code":0,"status":"completed"}}
