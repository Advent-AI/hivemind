rowth or margin question; the shown material names no connection |\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_10","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba ../../../src/hivemind/views/links.py | sed -n '17,41p;199,205p'; nl -ba ../../../src/hivemind/views/jev_matching.py | sed -n '55,69p'; nl -ba ../../../src/hivemind/views/matching.py | sed -n '160,175p'; tail -7 census-reuse-dry.log\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba ../../../src/hivemind/views/links.py | sed -n '17,41p;199,205p'; nl -ba ../../../src/hivemind/views/jev_matching.py | sed -n '55,69p'; nl -ba ../../../src/hivemind/views/matching.py | sed -n '160,175p'; tail -7 census-reuse-dry.log\"","aggregated_output":"    17\tTHRESHOLD = jev_matching.THRESHOLD\n    18\tLABELS = vocabulary.ASSET_LABELS                 # five-rung asset ladders run Strongly bullish .. Strongly bearish, or the reverse\n    19\tCANDIDATE_READS, THESIS_READS, NEITHER = 'candidate_reads_thesis', 'thesis_reads_candidate', 'neither'\n    20\tTOGETHER, OPPOSITE, NO_SIGN = 'together', 'opposite', 'no_clear_sign'\n    21\t\n    22\tREADS = {\n    23\t    CANDIDATE_READS: \"the CANDIDATE should be judged with the THESIS's current conclusion in view, because the THESIS's answer bounds \"\n    24\t                     \"or drives the CANDIDATE's: a part read against its whole (one product line's sales against the company's total \"\n    25\t                     \"sales; one region's loan book against the bank's total loans), or a quantity read against another it depends on \"\n    26\t                     \"(a component supplier's revenue against its largest customer's capital spending; an airline's fuel bill against \"\n    27\t                     \"its fuel volume)\",\n    28\t    THESIS_READS: \"the THESIS should be judged with the CANDIDATE's current conclusion in view, for the same reasons with the roles swapped\",\n    29\t    NEITHER: \"neither answer bounds or drives the other: unrelated quantities (a retailer's gross margin and its store openings in \"\n    30\t             \"another country), or the same quantity for the same period and scope; sharing a company, industry or topic is not enough\",\n    31\t}\n    32\tSIGN = {\n    33\t    TOGETHER: \"a higher answer to the question read makes a higher answer to the question reading it more likely (a company's total \"\n    34\t              \"sales and one product line's sales, when that line's share of the total holds steady; a customer's capital spending \"\n    35\t              \"and its component supplier's revenue)\",\n    36\t    OPPOSITE: \"a higher answer to the question read makes a lower answer to the question reading it more likely (an airline's fuel \"\n    37\t              \"bill and its operating margin; a retailer's markdowns and its gross margin)\",\n    38\t    NO_SIGN: \"the question read only caps the other without moving its most likely answer (a regulator's cap on a bank's fees set far \"\n    39\t             \"above what it charges), or the supplied text does not show which way it moves it\",\n    40\t}\n    41\tREADS_INSTRUCTIONS = (\"Should one of these two questions be judged with the other's current conclusion in view? Use only the supplied \"\n   199\t    return replies\n   200\t\n   201\t\n   202\tdef _passes(answer, accepted):\n   203\t    choice = answer['choice']\n   204\t    return choice if choice in accepted and answer['probabilities'][choice] >= THRESHOLD else None\n   205\t\n    55\t\n    56\tdef candidate_state(c, evidence):\n    57\t    rungs = ' / '.join(f'{r[\"label\"]}: {r[\"condition\"]}' for r in c['rungs'])\n    58\t    fields = ', '.join(f'{f}={c[f]}' for f in ('measure', 'scope', 'period_start', 'period_end', 'basis', 'unit', 'event_type') if c.get(f) not in (None, '', 'n/a'))\n    59\t    own = ' | '.join(f'[{e[\"speaker\"]} {e[\"original_day\"]}] {e[\"quote\"][:400]}' for e in evidence if e['id'] in c.get('evidence_ids', []))[:1600]\n    60\t    return (f'CANDIDATE ({c[\"kind\"]}, object {c[\"object\"]}, focus \"{c[\"looks_at\"]}\", {c[\"year\"]}, due {c[\"due_day\"]}): {c[\"question\"]}\\n'\n    61\t            f'Key: {fields}\\nLadder: {rungs}\\nIts evidence: {own}')\n    62\t\n    63\t\n    64\tdef thesis_text(conn, view_id):\n    65\t    \"\"\"The thesis as the judge should see it: the card and the quotes that define it (its first two pieces in force).\"\"\"\n    66\t    pieces = store.evidence_in_force(conn, view_id)[:2]\n    67\t    quotes = ''.join(f'\\n    Evidence: [{p[\"speaker\"]} {p[\"original_day\"]}] {p[\"quote\"][:400]}' for p in pieces)\n    68\t    return matching.describe_view(conn, view_id, english=True) + quotes\n    69\t\n   160\t\n   161\tdef describe_view(conn, view_id, english=False):\n   162\t    v = store.view(conn, view_id)\n   163\t    successor = conn.execute('select view_id from successions where succeeds=?', (view_id,)).fetchone()\n   164\t    if english:\n   165\t        rungs = ' / '.join(f'{r[\"label\"]}: {r[\"condition\"]}' for r in store.rungs_of(conn, view_id))\n   166\t        state = 'open' if store.is_open(conn, view_id) else 'closed'\n   167\t        tail = f'; successor already exists: {successor[\"view_id\"]}' if successor else ''\n   168\t        groups = store.groups_of_view(conn, view_id)\n   169\t        tail += f'; research group: ' + ', '.join(f'{g[\"group_id\"]} \"{g[\"name\"]}\"' for g in groups) if groups else ''\n   170\t        return f'{view_id} ({state}, {v[\"object_id\"]}, {v[\"kind\"]}, focus \"{v[\"looks_at\"]}\", {v[\"year\"] or \"\"}, due {v[\"due_day\"]}): {v[\"question\"]}\\n    Ladder: {rungs}{tail}'\n   171\t    rungs = ' / '.join(f'{r[\"label\"]}：{r[\"condition\"]}' for r in store.rungs_of(conn, view_id))\n   172\t    state = '开着' if store.is_open(conn, view_id) else '关了'\n   173\t    tail = f'；已有下一期 {successor[\"view_id\"]}' if successor else ''\n   174\t    return f'{view_id}（{state}，{v[\"object_id\"]}，{v[\"kind\"]}，看的是「{v[\"looks_at\"]}」，{v[\"year\"] or \"\"}，到期 {v[\"due_day\"]}）：{v[\"question\"]}\\n    梯子：{rungs}{tail}'\n   175\t\n1664 eligible [] not eligible 1\n1677 eligible [] not eligible 1\n1828 eligible [] not eligible 1\n1874 eligible [] not eligible 1\nledger: {'stopped': False, 'overrun': False} complete: True [] july reused: ['6dcb76643aea', 'd118a387e986']\nseq 148 proposed: [[{'candidate': 'c1', 'direction': 'thesis_reads_candidate', 'read': 'c1', 'reader': 'v9', 'sign': 'together', 'thesis': 'v9'}]]\nexit 0\n","exit_code":0,"status":"completed"}}
