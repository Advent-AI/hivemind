andidate('c2', question='Gaming revenue FY2027?', **dict(KEY, scope='Gaming'))\n   212\t    # c1 -> v1 -> c2 -> v2 -> c1, no stored path; every correction flips the pair, which closes the reverse circle\n   213\t    script = {('Data Center', 'reads__v1'): (links.CANDIDATE_READS, 0.8), ('Data Center', 'reads__v2'): (links.THESIS_READS, 0.8),\n   214\t              ('Gaming', 'reads__v1'): (links.THESIS_READS, 0.8), ('Gaming', 'reads__v2'): (links.CANDIDATE_READS, 0.8),\n   215\t              'sign__v1': (links.TOGETHER, 0.8), 'sign__v2': (links.TOGETHER, 0.8)}\n   216\t    flipped = dict(script)\n   217\t\n   218\t    def transport(request):\n   219\t        if any('read itself' in q['instructions'] for q in request['questions'].values()):\n   220\t            answers = {}\n   221\t            for qid, q in request['questions'].items():\n   222\t                remaining = [k for k in q['criteria'] if k != links.NEITHER][0]\n   223\t                answers[qid] = {'type': 'choice', 'choice': remaining, 'confidence': 0.8,\n   224\t                                'probabilities': {k: (0.8 if k == remaining else 0.2) for k in q['criteria']}}\n   225\t            return {'model': request['model'], 'answers': answers, 'usage': {'input_tokens': 10, 'output_tokens': 5}}\n   226\t        return scripted(flipped)(request)\n   227\t    with pytest.raises(links.Refused) as refused:\n   228\t        links.choose(model.Archive(str(tmp_path / 'a.sqlite')), CFG, conn, handover_of(a, b), checked_new('c1', 'c2'),\n   229\t                     matching.Lists({'c1': ['v1', 'v2'], 'c2': ['v1', 'v2']}, {}), [], transport=transport)\n   230\t    assert refused.value.record['error'].startswith('persistent cycle')\n   231\t\n   232\t\n   233\tdef test_a_store_with_an_unbound_wait_is_refused_and_a_bound_wait_counts_through_its_target(tmp_path):\n   234\t    conn = two_totals(tmp_path)\n   235\t    store.insert(conn, 'dependencies', view_id='v1', depends_on='', wait_chain_view_id='v2', wait_year='FY2029', direction='same', seq=1)\n   236\t    conn.commit()\n   237\t    dc = candidate('c1', question='Data Center revenue FY2027?')\n   238\t    with pytest.raises(links.Refused):\n   239\t        links.choose(model.Archive(str(tmp_path / 'a.sqlite')), CFG, conn, handover_of(dc), checked_new('c1'),\n   240\t                     matching.Lists({'c1': ['v1']}, {}), [], transport=recording({}))\n   241\t    dependency_id = conn.execute('select dependency_id from dependencies').fetchone()[0]\n   242\t    store.insert(conn, 'dependency_resolutions', dependency_id=dependency_id, resolved_to='v2', reason='waited year created', seq=1)\n   243\t    conn.commit()\n   244\t    assert links.unbound_waits(conn) == 0\n   245\t    assert links.circles(conn, [{'reader': 'v2', 'read': 'c1'}, {'reader': 'c1', 'read': 'v1'}]) != []   # v1 -> v2 through the bound wait\n   246\t\n   247\t\n   248\t# ---------- §4, test 4: the writer ----------\n   249\t\n   250\tdef write_with(conn, proposed, *handover_candidates, seq=2):\n   251\t    conn.execute('begin immediate')\n   252\t    written = writing.write(conn, UNIVERSE, seq, ITEM, handover_of(*handover_candidates), checked_new(*[c['id'] for c in handover_candidates]), {},\n   253\t                            proposed_links=proposed)\n   254\t    conn.commit()\n   255\t    return written\n   256\t\n   257\t\n   258\tdef test_an_existing_question_gains_a_reads_link_and_is_judged_that_day(tmp_path):\n   259\t    conn = ledger(tmp_path, [('v1', KEY, RUNGS, 'Data Center revenue FY2027?')])\n   260\t    total = candidate('c1', rungs=TOTAL_RUNGS, question='Total revenue FY2027?', **TOTAL)\n   261\t    written = write_with(conn, [{'reader': 'v1', 'read': 'c1', 'candidate': 'c1', 'thesis': 'v1', 'direction': links.THESIS_READS, 'sign': links.TOGETHER}], total)\n   262\t    new = written.new_views['c1']\n   263\t    row = conn.execute('select view_id, depends_on, direction, kind, seq from dependencies').fetchone()\n   264\t    assert tuple(row) == ('v1', new, 'first_is_bullish', 'reads', 2)\n   265\t    assert 'v1' in written.changed_views and written.links[0]['label'] == 'first_is_bullish'\n   266\t\n19:| Model settings and search result count | Extraction has settings per category: model, prompt version and reasoning effort. The thesis library has separate matching (the Jev engine, D169) and rejudgement settings, and an optional collision-judge setting: the generative model asked whether a candidate and a listed thesis of its own subject and measure are one question (D190); a version without it leaves matching to Jev alone. Config also sets the search result count, initially 10. Prompt content belongs to the extraction and thesis library modules. A settings version is immutable; a change creates a new one. | Chosen by a person |\n57:- D169: the matching setting names the Jev engine. D190: an optional collision-judge setting beside matching; a version without it leaves matching to Jev alone.\n/private/tmp/claude-501/-Users-lchingen-hivemind/f1ea972d-85a1-4f27-8010-cf0b60054109/scratchpad/link-mutants/mutant/src/hivemind/config.py\n/private/tmp/claude-501/-Users-lchingen-hivemind/f1ea972d-85a1-4f27-8010-cf0b60054109/scratchpad/mutants/mutant/src/hivemind/config.py\n","exit_code":0,"status":"completed"}}
