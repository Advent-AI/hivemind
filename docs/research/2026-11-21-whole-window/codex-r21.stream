s: str = ''  # matching under 'jev-links' only: the version of the link questions (views/links.py), 'links-v1' when unnamed (D705)\n \n \n-ENGINES = ('llm', 'jev')\n+ENGINES = ('llm', 'jev', 'jev-links')\n+LINK_QUESTIONS = ('links-v1', 'links-v2')     # the link question versions views/links.py builds (D694, D705)\n \n \n @dataclasses.dataclass(frozen=True)\n@@ -84,9 +86,16 @@ def _setting(name, raw):\n     engine = str(raw.get('engine', 'llm'))\n     if engine not in ENGINES:\n         raise ConfigError(f'setting {name}: engine {engine!r} is not one of {ENGINES}')\n+    link_questions = raw.get('link_questions')\n+    if link_questions is not None and engine != 'jev-links':\n+        raise ConfigError(f'setting {name}: link_questions is read only by the engine jev-links, not {engine!r}')\n+    if engine == 'jev-links':\n+        link_questions = 'links-v1' if link_questions is None else str(link_questions)\n+        if link_questions not in LINK_QUESTIONS:\n+            raise ConfigError(f'setting {name}: link_questions {link_questions!r} is not one of {LINK_QUESTIONS}')\n     return Setting(name=name, model=str(raw['model']), prompt_version=str(raw['prompt_version']),\n                    reasoning_effort=str(raw['reasoning_effort']),\n-                   max_output_tokens=int(raw['max_output_tokens']), engine=engine)\n+                   max_output_tokens=int(raw['max_output_tokens']), engine=engine, link_questions=link_questions or '')\n \n \n def load(path):\ndiff --git a/tests/test_frozen_questions_and_judgement.py b/tests/test_frozen_questions_and_judgement.py\nindex cf9d57a3..3d038b42 100644\n--- a/tests/test_frozen_questions_and_judgement.py\n+++ b/tests/test_frozen_questions_and_judgement.py\n@@ -9,15 +9,19 @@ import sys\n \n ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))\n sys.path.insert(0, os.path.join(ROOT, 'src'))\n-from hivemind.views import jev_matching, judging  # noqa: E402\n+from hivemind.views import jev_matching, judging, links  # noqa: E402\n \n FROZEN_FILES = {\n     'src/hivemind/prompts/collision-v2.txt': 'a5f0f58d53c4f4215b14e534935b1f95a79b35ba097d68c0ab598af7b88a3bd0',\n     'src/hivemind/prompts/judging-v7.txt': 'd499c4b89ad038ade9bd41e037d766d5e54defecef273541f46dc01509db5a2c',\n     'src/hivemind/prompts/matching-v3.txt': '04e23ee314e71cb094273b23e75f816c467176969b8c17dfec5a6e5d17a45a49',\n+    # D694: poc-v119's judge prompt is judging-v7's text byte for byte; only the code-built dependency block differs (tests/test_links.py)\n+    'src/hivemind/prompts/judging-v8.txt': 'd499c4b89ad038ade9bd41e037d766d5e54defecef273541f46dc01509db5a2c',\n }\n JUDGING_SCHEMA_SHA = '4d1469ae9c14256c24e2c39e1b6cc772cb25e160c937f32091fc4f35bf539ca9'\n MATCHER_QUESTIONS_SHA = '86cb70600ce456be3cd5197ef173c38023513157fa3c92e341036651f95a5218'\n+LINK_QUESTIONS_SHA = '4144f359701e0677159afb058701b721698ba3ae7bded61988de2f98f3c340b5'      # D694, D695: poc-v119's READS and SIGN questions\n+LINK_QUESTIONS_V2_SHA = '3fc3ffff5dc8437db05fcd8f6b0ef1043bf53c43f66734f4782c1517b666d47e'   # D705: poc-v120's links-v2 questions (WORDING-V2.md)\n \n \n def sha_of(value):\n@@ -34,3 +38,12 @@ def test_the_code_written_parts_of_the_question_and_judgement_requests_are_uncha\n     assert sha_of(judging.schema_for('judging-v7')) == JUDGING_SCHEMA_SHA\n     questions = [jev_matching.relation_question('X'), jev_matching.member_question('X'), jev_matching.piece_question('X')]\n     assert sha_of(questions) == MATCHER_QUESTIONS_SHA\n+\n+\n+def test_the_linking_version_pins_its_questions_and_keeps_the_judge_schema():\n+    assert sha_of(judging.schema_for('judging-v8')) == JUDGING_SCHEMA_SHA\n+    questions = [links.reads_question('X'), links.sign_question('X', links.CANDIDATE_READS), links.sign_question('X', links.THESIS_READS)]\n+    assert sha_of(questions) == LINK_QUESTIONS_SHA\n+    version_two = [links.reads_question('X', version='links-v2'), links.sign_question('X', links.CANDIDATE_READS, version='links-v2'),\n+                   links.sign_question('X', links.THESIS_READS, version='links-v2')]\n+    assert sha_of(version_two) == LINK_QUESTIONS_V2_SHA\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_9","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba ../../../tests/test_links.py | sed -n '1,100p;333,430p'; nl -ba ../../../tests/test_frozen_questions_and_judgement.py; rg -n --hidden -g '\"'!*.stream'\"' -g '\"'!*.log'\"' -g '\"'!*.sqlite'\"' 'READS ignores the configured version|filing narrows a reads link|QUESTION_SETS|def v120_replay|def wording_v2|def with_wording_v2|def probe_pass' . ../2026-11-20-production-readiness/dependency-design ../../../scripts ../../../.claude\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba ../../../tests/test_links.py | sed -n '1,100p;333,430p'; nl -ba ../../../tests/test_frozen_questions_and_judgement.py; rg -n --hidden -g '\"'!*.stream'\"' -g '\"'!*.log'\"' -g '\"'!*.sqlite'\"' 'READS ignores the configured version|filing narrows a reads link|QUESTION_SETS|def v120_replay|def wording_v2|def with_wording_v2|def probe_pass' . ../2026-11-20-production-readiness/dependency-design ../../../scripts ../../../.claude\"","aggregated_output":"     1\t\"\"\"Reading links between number questions (D694, D695): each test names the row of\n     2\tdocs/research/2026-11-20-production-readiness/dependency-design/DESIGN.md it proves (section and test number of its §11).\n     3\tReal ledgers on temporary paths; a scripted Jev transport and a scripted judge; no paid service.\"\"\"\n     4\timport dataclasses\n     5\timport importlib.util\n     6\timport json\n     7\timport os\n     8\timport sqlite3\n     9\timport subprocess\n    10\timport sys\n    11\t\n    12\timport pytest\n    13\t\n    14\tfrom test_jev_matching import scripted\n    15\tfrom test_keyed_views import ITEM, KEY, RUNGS, UNIVERSE, candidate\n    16\t\n    17\tROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))\n    18\tsys.path.insert(0, os.path.join(ROOT, 'src'))\n    19\tfrom hivemind import config, extraction, model  # noqa: E402\n    20\tfrom hivemind.views import judging, links, matching, store, writing  # noqa: E402\n    21\tfrom hivemind.views import round as rounds  # noqa: E402\n    22\t\n    23\tV118 = config.load(os.path.join(ROOT, 'poc', 'config', 'poc-v118.json'))\n    24\tV119 = config.load(os.path.join(ROOT, 'poc', 'config', 'poc-v119.json'))\n    25\tV120 = config.load(os.path.join(ROOT, 'poc', 'config', 'poc-v120.json'))\n    26\tCFG = dataclasses.replace(V119, collision=None)                       # Jev alone: the collision judge is not under test here\n    27\tCFG_JEV = dataclasses.replace(V118, collision=None)\n    28\tTOTAL = dict(KEY, measure='total_revenue', scope='', scope_source='none')      # as the product stores a total (view_keys: scope_source none)\n    29\tSCALE = 1.2                                                           # the total's ladder sits above the segment's\n    30\tTOTAL_RUNGS = [dict(r, lo=None if r['lo'] is None else r['lo'] * SCALE, hi=None if r['hi'] is None else r['hi'] * SCALE) for r in RUNGS]\n    31\tDAY_BEFORE = '2026-05-19'\n    32\t\n    33\t\n    34\tdef rising(rungs):\n    35\t    \"\"\"The same ladder stored with its values rising from the first rung (labels kept in place).\"\"\"\n    36\t    bounds = [(r['lo'], r['hi']) for r in rungs][::-1]\n    37\t    return [dict(r, lo=lo, hi=hi) for r, (lo, hi) in zip(rungs, bounds)]\n    38\t\n    39\t\n    40\tdef ledger(tmp_path, views):\n    41\t    \"\"\"A ledger holding `views` [(view_id, key, rungs, question)] created at seq 1 and open at the start of ITEM's day.\"\"\"\n    42\t    conn = store.open_db(str(tmp_path / 'views.sqlite'))\n    43\t    for view_id, key, rungs, question in views:\n    44\t        c = candidate('x', rungs=rungs, question=question, looks_at=question, **key)\n    45\t        store.create_view(conn, view_id=view_id, object_id='NVDA', object_kind='company', kind='asset', looks_at=question, question=question,\n    46\t                          due_day='2027-02-25', year='FY2027', rungs=rungs, seq=1, input_id='seed', created_at='2026-05-19T00:00:00')\n    47\t        store.add_key(conn, view_id, c, 1)\n    48\t        evidence_id = f'e{view_id[1:]}'\n    49\t        store.add_evidence(conn, evidence_id=evidence_id, quote=f'{question} statement', one_line=question, speaker='NVIDIA', original_who='NVIDIA',\n    50\t                           original_day='2026-05-19', tier='fact', event_time='', seq=1, input_id='seed')\n    51\t        store.add_source(conn, evidence_id, 'seed', 'T4', '2026-05-19', '', 1)\n    52\t        store.link(conn, evidence_id, view_id, 1)\n    53\t    store.insert(conn, 'days_completed', day=DAY_BEFORE, seq=1, at='2026-05-19T23:59:59')\n    54\t    conn.commit()\n    55\t    return conn\n    56\t\n    57\t\n    58\tdef handover_of(*candidates):\n    59\t    evidence = [{'id': f'h{c[\"id\"]}', 'quote': f'{c[\"question\"]} figure', 'one_line': c['question'], 'speaker': 'NVIDIA', 'original_who': 'NVIDIA',\n    60\t                 'original_day': '2026-05-20', 'tier': 'fact', 'event_time': '', 'location': '', 'links': [c['id']]} for c in candidates]\n    61\t    candidates = [dict(c, evidence_ids=[f'h{c[\"id\"]}']) for c in candidates]\n    62\t    return extraction.Handover(evidence, candidates, [], 0, '', True, 0.0)\n    63\t\n    64\t\n    65\tdef checked_new(*ids, outcome='new', target=None):\n    66\t    return matching.Checked({cid: (outcome, target, []) for cid in ids}, {}, [], {})\n    67\t\n    68\t\n    69\tdef recording(script):\n    70\t    sent = []\n    71\t    inner = scripted(script)\n    72\t\n    73\t    def transport(request):\n    74\t        sent.append(request)\n    75\t        return inner(request)\n    76\t    transport.sent = sent\n    77\t    return transport\n    78\t\n    79\t\n    80\tdef link_questions(sent):\n    81\t    return [qid for request in sent for qid in request['questions'] if qid.startswith(('reads__', 'sign__'))]\n    82\t\n    83\t\n    84\t# ---------- §5, test 1: the typed direction and the label ----------\n    85\t\n    86\tdef test_typed_direction_reads_bounds_in_rung_order_and_never_prose():\n    87\t    assert links.typed_direction(RUNGS) == -1 and links.typed_direction(rising(RUNGS)) == 1\n    88\t    shuffled = [RUNGS[0], RUNGS[2], RUNGS[1], RUNGS[3], RUNGS[4]]\n    89\t    assert links.typed_direction(shuffled) is None\n    90\t    overlapping = [dict(r) for r in RUNGS]\n    91\t    overlapping[1]['lo'] = 260e9                                       # rung 2 reaches below rung 3's top\n    92\t    assert links.typed_direction(overlapping) is None\n    93\t    open_inner = [dict(r) for r in RUNGS]\n    94\t    open_inner[2]['lo'] = None\n    95\t    assert links.typed_direction(open_inner) is None\n    96\t    assert links.typed_direction([{'label': r['label'], 'condition': r['condition']} for r in RUNGS]) is None   # prose only\n    97\t\n    98\t\n    99\tdef test_the_label_follows_the_sign_and_both_ladders():\n   100\t    assert links.label_for(RUNGS, TOTAL_RUNGS, links.TOGETHER) == 'first_is_bullish'          # the worked case (old-2 07-10)\n   333\t\n   334\t\n   335\tdef judge_transport(changed_by_view):\n   336\t    def transport(provider, request, *args, **kwargs):\n   337\t        view_id = request['messages'][-1]['content'].split(' ', 2)[1]\n   338\t        data = {'rung': 3, 'reference': 'r', 'implied_outcome': 'i', 'reasons': 'ok', 'cites': [], 'cites_views': [], 'pushes': [],\n   339\t                'changed': changed_by_view.get(view_id, False), 'why_changed': '', 'theme_pushes': []}\n   340\t        return {'choices': [{'message': {'content': json.dumps(data)}}], 'usage': {'prompt_tokens': 10, 'completion_tokens': 5}}\n   341\t    return transport\n   342\t\n   343\t\n   344\t@pytest.mark.parametrize('changed, queued', [(True, True), (False, False)])\n   345\tdef test_a_changed_read_conclusion_queues_its_reader_and_an_unchanged_one_does_not(tmp_path, changed, queued):\n   346\t    conn = ledger(tmp_path, [('v1', TOTAL, TOTAL_RUNGS, 'Total revenue FY2027?'), ('v2', KEY, RUNGS, 'Data Center revenue FY2027?')])\n   347\t    stored_link(conn, 'v2', 'v1')\n   348\t    judged(conn, 'v1', 1, 'old point', 'old forecast')\n   349\t    judged(conn, 'v2', 1, 'r', 'i')\n   350\t    results = judging.round_of_judgements(model.Archive(str(tmp_path / 'a.sqlite')), V119, conn, ['v1'], 5, {'input_id': 'day:2026-05-20', 'publication_day': '2026-05-20'},\n   351\t                                          transport=judge_transport({'v1': changed}))\n   352\t    assert [r['view_id'] for r in results] == (['v1', 'v2'] if queued else ['v1'])\n   353\t\n   354\t\n   355\t# ---------- §0, test 7: entry points ----------\n   356\t\n   357\tdef scripts_replay():\n   358\t    spec = importlib.util.spec_from_file_location('scripts_replay_under_test', os.path.join(ROOT, 'scripts', 'replay.py'))\n   359\t    module = importlib.util.module_from_spec(spec)\n   360\t    spec.loader.exec_module(module)\n   361\t    return module\n   362\t\n   363\t\n   364\tdef test_the_links_engine_loads_but_ordinary_launchers_refuse_it():\n   365\t    assert V119.matching.engine == links.ENGINE and V119.rejudging.prompt_version == 'judging-v8'\n   366\t    for version in (V119, V120):\n   367\t        with pytest.raises(SystemExit):\n   368\t            scripts_replay().refuse_links_engine(version)\n   369\t    scripts_replay().refuse_links_engine(V118)\n   370\t\n   371\t\n   372\t# ---------- WORDING-V2.md §5 (D705): the link question version ----------\n   373\t\n   374\tdef test_the_question_version_is_read_from_the_matching_setting_and_refused_when_unknown(tmp_path):\n   375\t    assert (V119.matching.link_questions, V120.matching.link_questions, V118.matching.link_questions) == ('links-v1', 'links-v2', '')\n   376\t    assert config.LINK_QUESTIONS == tuple(links.QUESTION_SETS)\n   377\t    raw = json.load(open(os.path.join(ROOT, 'poc', 'config', 'poc-v120.json')))\n   378\t    for engine, version in (('jev-links', 'links-v9'), ('jev', 'links-v2')):\n   379\t        path = tmp_path / f'{engine}-{version}.json'\n   380\t        path.write_text(json.dumps(dict(raw, matching=dict(raw['matching'], engine=engine, link_questions=version))))\n   381\t        with pytest.raises(config.ConfigError):\n   382\t            config.load(str(path))\n   383\t\n   384\t\n   385\tdef test_version_two_asks_its_own_criteria_at_every_stage_and_version_one_keeps_its_own(tmp_path):\n   386\t    for cfg, (reads, sign) in ((dataclasses.replace(V120, collision=None), (links.READS_V2, links.SIGN_V2)), (CFG, (links.READS, links.SIGN))):\n   387\t        folder = tmp_path / cfg.version\n   388\t        folder.mkdir()\n   389\t        conn = two_totals(folder)\n   390\t        stored_link(conn, 'v2', 'v1')                                     # as the circle test: a first answer, a correction, no link\n   391\t        first = recording({'reads__v1': (links.THESIS_READS, 0.8), 'reads__v2': (links.CANDIDATE_READS, 0.8),\n   392\t                           'sign__v1': (links.TOGETHER, 0.8), 'sign__v2': (links.TOGETHER, 0.8)})\n   393\t        correction = scripted({'reads__v1': (links.NEITHER, 0.9), 'reads__v2': (links.NEITHER, 0.9)})\n   394\t\n   395\t        def transport(request):\n   396\t            if any('read itself' in q['instructions'] for q in request['questions'].values()):\n   397\t                first.sent.append(request)\n   398\t                return correction(request)\n   399\t            return first(request)\n   400\t        links.choose(model.Archive(str(folder / 'a.sqlite')), cfg, conn, handover_of(candidate('c1', question='Data Center revenue FY2027?')),\n   401\t                     checked_new('c1'), matching.Lists({'c1': ['v1', 'v2']}, {}), [], transport=transport)\n   402\t        asked = [(qid, q) for request in first.sent for qid, q in request['questions'].items()]\n   403\t        assert {qid.split('__')[0] for qid, _ in asked} == {'reads', 'sign'} and any('read itself' in q['instructions'] for _, q in asked)\n   404\t        for qid, q in asked:\n   405\t            expected = reads if qid.startswith('reads__') else sign\n   406\t            assert q['criteria'] == {k: v for k, v in expected.items() if k in q['criteria']} and len(q['criteria']) >= 2\n   407\t\n   408\t\n   409\tdef test_an_ordinary_replay_refuses_a_harness_only_ledger_before_routing(tmp_path):\n   410\t    conn = ledger(tmp_path, [('v1', KEY, RUNGS, 'Data Center revenue FY2027?')])\n   411\t    conn.execute('create table harness_only (name text, day text)')\n   412\t    conn.commit()\n   413\t    conn.close()\n   414\t    before = os.path.getmtime(tmp_path / 'views.sqlite')\n   415\t    run = subprocess.run([sys.executable, os.path.join(ROOT, 'scripts', 'replay.py'), '--from', '2026-05-20', '--until', '2026-05-20',\n   416\t                          '--views', str(tmp_path / 'views.sqlite'), '--archive', str(tmp_path / 'archive.sqlite'), '--workers', '1'],\n   417\t                         capture_output=True, text=True, cwd=str(tmp_path))\n   418\t    assert run.returncode != 0 and 'harness-only' in run.stderr\n   419\t    assert os.path.getmtime(tmp_path / 'views.sqlite') == before and not (tmp_path / 'archive.sqlite').exists()\n   420\t\n   421\t\n   422\t# ---------- §1, tests 2 and 8: the link step inside the article, and its record ----------\n   423\t\n   424\tdef run_article(tmp_path, cfg, script, conn):\n   425\t    total = candidate('c1', rungs=TOTAL_RUNGS, question='Total revenue FY2027?', looks_at='total revenue', **TOTAL)\n   426\t    transport = recording(dict({'rel__v1': ('different', 0.9)}, **script))\n   427\t    item = dict(ITEM, text='Total revenue guidance.', publication_day='2026-05-20')\n   428\t    result = rounds.run(conn, model.Archive(str(tmp_path / 'archive.sqlite')), cfg, UNIVERSE, item, 2, transport=transport,\n   429\t                        extractor=lambda *args, **kwargs: handover_of(total))\n   430\t    return result, transport\n     1\t\"\"\"Steps 3 and 4 are frozen (D354, Alex 2026-11-03: \"那你跑了吧，我们赶紧确认step 3,4 可以freeze\"): opening and matching questions, and\n     2\tjudging them, as `poc/config/poc-v108.json` runs them (its sha256 is pinned in test_frozen_extraction_prompt.py). Every piece that shapes\n     3\tthose requests is pinned here: the collision judge's and the judge's prompt files, the matching prompt the configuration names, the\n     4\tjudge's answer schema, and the three questions the Jev matcher is asked. A change is a new version opened only by Alex's decision.\"\"\"\n     5\timport hashlib\n     6\timport json\n     7\timport os\n     8\timport sys\n     9\t\n    10\tROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))\n    11\tsys.path.insert(0, os.path.join(ROOT, 'src'))\n    12\tfrom hivemind.views import jev_matching, judging, links  # noqa: E402\n    13\t\n    14\tFROZEN_FILES = {\n    15\t    'src/hivemind/prompts/collision-v2.txt': 'a5f0f58d53c4f4215b14e534935b1f95a79b35ba097d68c0ab598af7b88a3bd0',\n    16\t    'src/hivemind/prompts/judging-v7.txt': 'd499c4b89ad038ade9bd41e037d766d5e54defecef273541f46dc01509db5a2c',\n    17\t    'src/hivemind/prompts/matching-v3.txt': '04e23ee314e71cb094273b23e75f816c467176969b8c17dfec5a6e5d17a45a49',\n    18\t    # D694: poc-v119's judge prompt is judging-v7's text byte for byte; only the code-built dependency block differs (tests/test_links.py)\n    19\t    'src/hivemind/prompts/judging-v8.txt': 'd499c4b89ad038ade9bd41e037d766d5e54defecef273541f46dc01509db5a2c',\n    20\t}\n    21\tJUDGING_SCHEMA_SHA = '4d1469ae9c14256c24e2c39e1b6cc772cb25e160c937f32091fc4f35bf539ca9'\n    22\tMATCHER_QUESTIONS_SHA = '86cb70600ce456be3cd5197ef173c38023513157fa3c92e341036651f95a5218'\n    23\tLINK_QUESTIONS_SHA = '4144f359701e0677159afb058701b721698ba3ae7bded61988de2f98f3c340b5'      # D694, D695: poc-v119's READS and SIGN questions\n    24\tLINK_QUESTIONS_V2_SHA = '3fc3ffff5dc8437db05fcd8f6b0ef1043bf53c43f66734f4782c1517b666d47e'   # D705: poc-v120's links-v2 questions (WORDING-V2.md)\n    25\t\n    26\t\n    27\tdef sha_of(value):\n    28\t    return hashlib.sha256(json.dumps(value, ensure_ascii=False, sort_keys=True).encode('utf-8')).hexdigest()\n    29\t\n    30\t\n    31\tdef test_the_frozen_question_and_judgement_prompt_files_are_unchanged():\n    32\t    for path, expected in FROZEN_FILES.items():\n    33\t        with open(os.path.join(ROOT, path), 'rb') as handle:\n    34\t            assert hashlib.sha256(handle.read()).hexdigest() == expected, f'{path} changed; steps 3 and 4 are frozen (D354)'\n    35\t\n    36\t\n    37\tdef test_the_code_written_parts_of_the_question_and_judgement_requests_are_unchanged():\n    38\t    assert sha_of(judging.schema_for('judging-v7')) == JUDGING_SCHEMA_SHA\n    39\t    questions = [jev_matching.relation_question('X'), jev_matching.member_question('X'), jev_matching.piece_question('X')]\n    40\t    assert sha_of(questions) == MATCHER_QUESTIONS_SHA\n    41\t\n    42\t\n    43\tdef test_the_linking_version_pins_its_questions_and_keeps_the_judge_schema():\n    44\t    assert sha_of(judging.schema_for('judging-v8')) == JUDGING_SCHEMA_SHA\n    45\t    questions = [links.reads_question('X'), links.sign_question('X', links.CANDIDATE_READS), links.sign_question('X', links.THESIS_READS)]\n    46\t    assert sha_of(questions) == LINK_QUESTIONS_SHA\n    47\t    version_two = [links.reads_question('X', version='links-v2'), links.sign_question('X', links.CANDIDATE_READS, version='links-v2'),\n    48\t                   links.sign_question('X', links.THESIS_READS, version='links-v2')]\n    49\t    assert sha_of(version_two) == LINK_QUESTIONS_V2_SHA\n./window_test.py:313:def wording_v2():\n./window_test.py:327:def with_wording_v2(run):\n./window_test.py:337:def probe_pass(folder, draw, inner, ledger_state, transport_kind):\n./window_test.py:409:def v120_replay(scratch, draw):\n../2026-11-20-production-readiness/dependency-design/mutants.py:15:    ('filing narrows a reads link', 'src/hivemind/views/store.py',\n./round21-brief.md:4:that add `link_questions`, `READS_V2`, `SIGN_V2`, `QUESTION_SETS`, the builders' `version` and its three callers, the new tests and\n./mutants.py:19:    ('filing narrows a reads link', 'src/hivemind/views/store.py',\n./mutants.py:37:     \"    criteria = {k: v for k, v in QUESTION_SETS[version][0].items() if k != excluded}\", \"    criteria = dict(QUESTION_SETS[version][0])\", LINKS,\n./mutants.py:40:    ('READS ignores the configured version', 'src/hivemind/views/links.py',\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_10","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba ../../../src/hivemind/config.py | sed -n '1,255p'; nl -ba ../../../src/hivemind/views/links.py | sed -n '1,100p;229,350p'; git -C ../../.. status --short -- src/hivemind/config.py src/hivemind/views/links.py tests/test_links.py tests/test_frozen_questions_and_judgement.py poc/config/poc-v118.json poc/config/poc-v119.json poc/config/poc-v120.json\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba ../../../src/hivemind/config.py | sed -n '1,255p'; nl -ba ../../../src/hivemind/views/links.py | sed -n '1,100p;229,350p'; git -C ../../.. status --short -- src/hivemind/config.py src/hivemind/views/links.py tests/test_links.py tests/test_frozen_questions_and_judgement.py poc/config/poc-v118.json poc/config/poc-v119.json poc/config/poc-v120.json\"","aggregated_output":"     1\t\"\"\"Config (docs/prd/03-config.md): a versioned file of the settings a person chooses, with a checksum written into\n     2\tevery model call's record. A version that references a missing setting is refused whole.\"\"\"\n     3\timport dataclasses\n     4\timport hashlib\n     5\timport json\n     6\timport os\n     7\t\n     8\tPROMPTS = os.path.join(os.path.dirname(__file__), 'prompts')\n     9\t\n    10\t\n    11\tclass ConfigError(ValueError):\n    12\t    pass\n    13\t\n    14\t\n    15\tdef prompt_path(name):\n    16\t    \"\"\"The file of a prompt the config names, for example role-v1.txt or matching-v1.txt.\"\"\"\n    17\t    return os.path.join(PROMPTS, name)\n    18\t\n    19\t\n    20\tdef _prompt_files(extraction, matching, rejudging, idea=None, idea_summary=None, collision=None, placement=None):\n    21\t    \"\"\"03-config: a version that names a prompt that does not exist is refused whole. An extraction setting's\n    22\t    prompt_version is '<category>-<v>': block 2 and 4 come from categories-<v>.json (the category's entry) and the\n    23\t    role from role-<v>.txt; matching, re-judging and the idea reading name their file without the extension.\"\"\"\n    24\t    for category, setting in extraction.items():\n    25\t        prefix, _, version = setting.prompt_version.rpartition('-')\n    26\t        if prefix != category or not version:\n    27\t            raise ConfigError(f'extraction.{category}: prompt_version {setting.prompt_version!r} must be {category}-<version>')\n    28\t        categories_file = prompt_path(f'categories-{version}.json')\n    29\t        if not os.path.exists(categories_file) or not os.path.exists(prompt_path(f'role-{version}.txt')):\n    30\t            raise ConfigError(f'extraction.{category}: prompts for version {version!r} do not exist')\n    31\t        with open(categories_file, encoding='utf-8') as handle:\n    32\t            if category not in json.load(handle):\n    33\t                raise ConfigError(f'extraction.{category}: categories-{version}.json has no entry for {category}')\n    34\t    for setting in (matching, rejudging, idea, idea_summary, collision, placement):\n    35\t        if setting is not None and not os.path.exists(prompt_path(setting.prompt_version + '.txt')):\n    36\t            raise ConfigError(f'{setting.name}: prompt {setting.prompt_version}.txt does not exist')\n    37\t\n    38\t\n    39\t@dataclasses.dataclass(frozen=True)\n    40\tclass Setting:\n    41\t    name: str\n    42\t    model: str\n    43\t    prompt_version: str\n    44\t    reasoning_effort: str\n    45\t    max_output_tokens: int\n    46\t    engine: str = 'llm'       # matching only: 'llm' (the generative call), 'jev' (TypeSafe Jev, views/jev_matching.py) or 'jev-links' (Jev, and the reading links of views/links.py, D694)\n    47\t    link_questions: str = ''  # matching under 'jev-links' only: the version of the link questions (views/links.py), 'links-v1' when unnamed (D705)\n    48\t\n    49\t\n    50\tENGINES = ('llm', 'jev', 'jev-links')\n    51\tLINK_QUESTIONS = ('links-v1', 'links-v2')     # the link question versions views/links.py builds (D694, D705)\n    52\t\n    53\t\n    54\t@dataclasses.dataclass(frozen=True)\n    55\tclass Config:\n    56\t    version: str\n    57\t    checksum: str\n    58\t    provider: str\n    59\t    search_top_n: int\n    60\t    extraction: dict          # category -> Setting\n    61\t    matching: Setting\n    62\t    rejudging: Setting\n    63\t    final_verdict: Setting\n    64\t    idea: Setting = None      # the service's reading of a user's idea (docs/poc/idea-card.md); absent in pipeline-only configs\n    65\t    idea_summary: Setting = None  # optional analyst TLDR after the mapping is fixed\n    66\t    collision: Setting = None # D190: the analyst question asked of the generative model when a candidate lists a thesis of its own object and measure; absent: Jev alone\n    67\t    placement: Setting = None # 2026-10-28: the call that files an item's statements under existing theses (extraction v20); absent before v20\n    68\t    baseline: Setting = None  # D364: the coverage-start reading of the company's latest report (hivemind.baseline); absent: no such step\n    69\t\n    70\t    def extraction_setting(self, category):\n    71\t        setting = self.extraction.get(category)\n    72\t        if setting is None:\n    73\t            raise ConfigError(f'no extraction setting for category {category} in config {self.version}')\n    74\t        return setting\n    75\t\n    76\t\n    77\tREQUIRED = ('model', 'prompt_version', 'reasoning_effort', 'max_output_tokens')\n    78\t\n    79\t\n    80\tdef _setting(name, raw):\n    81\t    if not isinstance(raw, dict):\n    82\t        raise ConfigError(f'setting {name} is missing')\n    83\t    missing = [key for key in REQUIRED if key not in raw]\n    84\t    if missing:\n    85\t        raise ConfigError(f'setting {name} lacks {missing}')\n    86\t    engine = str(raw.get('engine', 'llm'))\n    87\t    if engine not in ENGINES:\n    88\t        raise ConfigError(f'setting {name}: engine {engine!r} is not one of {ENGINES}')\n    89\t    link_questions = raw.get('link_questions')\n    90\t    if link_questions is not None and engine != 'jev-links':\n    91\t        raise ConfigError(f'setting {name}: link_questions is read only by the engine jev-links, not {engine!r}')\n    92\t    if engine == 'jev-links':\n    93\t        link_questions = 'links-v1' if link_questions is None else str(link_questions)\n    94\t        if link_questions not in LINK_QUESTIONS:\n    95\t            raise ConfigError(f'setting {name}: link_questions {link_questions!r} is not one of {LINK_QUESTIONS}')\n    96\t    return Setting(name=name, model=str(raw['model']), prompt_version=str(raw['prompt_version']),\n    97\t                   reasoning_effort=str(raw['reasoning_effort']),\n    98\t                   max_output_tokens=int(raw['max_output_tokens']), engine=engine, link_questions=link_questions or '')\n    99\t\n   100\t\n   101\tdef load(path):\n   102\t    with open(path, encoding='utf-8') as handle:\n   103\t        text = handle.read()\n   104\t    raw = json.loads(text)\n   105\t    for key in ('version', 'provider', 'search_top_n', 'extraction', 'matching', 'rejudging', 'final_verdict'):\n   106\t        if key not in raw:\n   107\t            raise ConfigError(f'config lacks {key}')\n   108\t    canonical = json.dumps({k: v for k, v in raw.items() if not k.startswith('_')}, sort_keys=True, ensure_ascii=False)\n   109\t    checksum = hashlib.sha256(canonical.encode('utf-8')).hexdigest()[:16]\n   110\t    extraction = {category: _setting(f'extraction.{category}', setting) for category, setting in raw['extraction'].items()}\n   111\t    matching, rejudging = _setting('matching', raw['matching']), _setting('rejudging', raw['rejudging'])\n   112\t    idea = _setting('idea', raw['idea']) if 'idea' in raw else None\n   113\t    idea_summary = _setting('idea_summary', raw['idea_summary']) if 'idea_summary' in raw else None\n   114\t    if idea_summary is not None and idea is None:\n   115\t        raise ConfigError('idea_summary requires an idea setting')\n   116\t    collision = _setting('collision', raw['collision']) if 'collision' in raw else None\n   117\t    placement = _setting('placement', raw['placement']) if 'placement' in raw else None\n   118\t    baseline = _setting('baseline', raw['baseline']) if 'baseline' in raw else None\n   119\t    _prompt_files(extraction, matching, rejudging, idea, idea_summary, collision, placement)       # final_verdict is kept in the file but no POC step calls it\n   120\t    if baseline is not None and not os.path.exists(prompt_path(baseline.prompt_version + '.json')):\n   121\t        raise ConfigError(f'baseline: prompt {baseline.prompt_version}.json does not exist')\n   122\t    return Config(version=str(raw['version']), checksum=checksum, provider=str(raw['provider']),\n   123\t                  search_top_n=int(raw['search_top_n']), extraction=extraction,\n   124\t                  matching=matching, rejudging=rejudging, final_verdict=_setting('final_verdict', raw['final_verdict']), idea=idea, idea_summary=idea_summary, collision=collision, placement=placement,\n   125\t                  baseline=baseline)\n     1\t\"\"\"Links between number questions, chosen in the matching step (D51, D368 item 2, D694, D695; the design and its four tables:\n     2\tdocs/research/2026-11-20-production-readiness/dependency-design/DESIGN.md).\n     3\t\n     4\tUnder the matching engine `jev-links` only, after matching has settled which candidates open: for each newly opened number question\n     5\tC and each open number question T on C's list, Jev is asked whether one should be judged with the other's conclusion in view (READS)\n     6\tand, for a pair that should, which way the read question moves the reading one (SIGN). Code decides only identity: which pairs are\n     7\tnumber questions, the canonical candidate, circles, and the label the judge is shown (from the sign and the typed rung bounds). A\n     8\tlink is written with kind `reads`: judging reads it as a dependency; filing does not treat it as a narrower home (D694 (a)).\n     9\t\"\"\"\n    10\timport json\n    11\t\n    12\tfrom .. import jev, model, vocabulary\n    13\tfrom . import identity, jev_matching, store\n    14\t\n    15\tENGINE = 'jev-links'\n    16\tKIND = 'reads'\n    17\tTHRESHOLD = jev_matching.THRESHOLD\n    18\tLABELS = vocabulary.ASSET_LABELS                 # five-rung asset ladders run Strongly bullish .. Strongly bearish, or the reverse\n    19\tCANDIDATE_READS, THESIS_READS, NEITHER = 'candidate_reads_thesis', 'thesis_reads_candidate', 'neither'\n    20\tTOGETHER, OPPOSITE, NO_SIGN = 'together', 'opposite', 'no_clear_sign'\n    21\t\n    22\tREADS = {\n    23\t    CANDIDATE_READS: \"the CANDIDATE should be judged with the THESIS's current conclusion in view, because the THESIS's answer bounds \"\n    24\t                     \"or drives the CANDIDATE's: a part read against its whole (one product line's sales against the company's total \"\n    25\t                     \"sales; one region's loan book against the bank's total loans), or a quantity read against another it depends on \"\n    26\t                     \"(a component supplier's revenue against its largest customer's capital spending; an airline's fuel bill against \"\n    27\t                     \"its fuel volume)\",\n    28\t    THESIS_READS: \"the THESIS should be judged with the CANDIDATE's current conclusion in view, for the same reasons with the roles swapped\",\n    29\t    NEITHER: \"neither answer bounds or drives the other: unrelated quantities (a retailer's gross margin and its store openings in \"\n    30\t             \"another country), or the same quantity for the same period and scope; sharing a company, industry or topic is not enough\",\n    31\t}\n    32\tSIGN = {\n    33\t    TOGETHER: \"a higher answer to the question read makes a higher answer to the question reading it more likely (a company's total \"\n    34\t              \"sales and one product line's sales, when that line's share of the total holds steady; a customer's capital spending \"\n    35\t              \"and its component supplier's revenue)\",\n    36\t    OPPOSITE: \"a higher answer to the question read makes a lower answer to the question reading it more likely (an airline's fuel \"\n    37\t              \"bill and its operating margin; a retailer's markdowns and its gross margin)\",\n    38\t    NO_SIGN: \"the question read only caps the other without moving its most likely answer (a regulator's cap on a bank's fees set far \"\n    39\t             \"above what it charges), or the supplied text does not show which way it moves it\",\n    40\t}\n    41\t# links-v2 (D703, D705; docs/research/2026-11-21-whole-window/WORDING-V2.md): links-v1 with a tie-break by the stronger full-period\n    42\t# anchor, links across periods only when the supplied text states how, and a base-effect example of the opposite sign\n    43\tREADS_V2 = {\n    44\t    CANDIDATE_READS: \"the CANDIDATE should be judged with the THESIS's current conclusion in view, because the THESIS's answer bounds \"\n    45\t                     \"or drives the CANDIDATE's: a part read against its whole (one product line's sales against the company's total \"\n    46\t                     \"sales; one region's loan book against the bank's total loans), or a quantity read against another it depends on \"\n    47\t                     \"(a component supplier's revenue against its largest customer's capital spending; an airline's fuel bill against \"\n    48\t                     \"its fuel volume) When either question could be judged with the other in view, the one whose answer the supplied \"\n    49\t                     \"text anchors less (no guidance, consensus or reported figure for the quantity and full period the question asks \"\n    50\t                     \"about) is the one judged with the other's conclusion in view.\",\n    51\t    THESIS_READS: READS[THESIS_READS],\n    52\t    NEITHER: \"neither answer bounds or drives the other: unrelated quantities (a retailer's gross margin and its store openings in \"\n    53\t             \"another country), or the same quantity for the same period and scope, or quantities of different periods when the \"\n    54\t             \"supplied text does not state how one period's answer moves the other's (a retailer's sales this year and its sales \"\n    55\t             \"growth next year, when the text only names both); sharing a company, industry or topic is not enough\",\n    56\t}\n    57\tSIGN_V2 = {\n    58\t    TOGETHER: SIGN[TOGETHER],\n    59\t    OPPOSITE: \"a higher answer to the question read makes a lower answer to the question reading it more likely (an airline's fuel \"\n    60\t              \"bill and its operating margin; a retailer's markdowns and its gross margin; one year's sales and the next year's sales \"\n    61\t              \"growth at a given next-year level, since a higher base lowers the growth)\",\n    62\t    NO_SIGN: SIGN[NO_SIGN],\n    63\t}\n    64\tQUESTION_SETS = {'links-v1': (READS, SIGN), 'links-v2': (READS_V2, SIGN_V2)}     # config.LINK_QUESTIONS names the same versions\n    65\tREADS_INSTRUCTIONS = (\"Should one of these two questions be judged with the other's current conclusion in view? Use only the supplied \"\n    66\t                      \"text. THESIS:\\n\")\n    67\tSIGN_INSTRUCTIONS = {\n    68\t    CANDIDATE_READS: \"If the THESIS's answer turned out higher, which way would that move the CANDIDATE's most likely answer? Use only the supplied text. THESIS:\\n\",\n    69\t    THESIS_READS: \"If the CANDIDATE's answer turned out higher, which way would that move the THESIS's most likely answer? Use only the supplied text. THESIS:\\n\",\n    70\t}\n    71\t\n    72\t\n    73\tclass Refused(RuntimeError):\n    74\t    \"\"\"The link step cannot finish for this article (a persistent circle, an unbound waiting row, a Jev failure); `record` says why.\"\"\"\n    75\t\n    76\t    def __init__(self, message, record):\n    77\t        super().__init__(message)\n    78\t        self.record = record\n    79\t\n    80\t\n    81\tdef reads_question(text, excluded=None, note='', version='links-v1'):\n    82\t    criteria = {k: v for k, v in QUESTION_SETS[version][0].items() if k != excluded}\n    83\t    return {'type': 'choice', 'criteria': criteria, 'instructions': READS_INSTRUCTIONS.replace('THESIS:\\n', (note + ' ' if note else '') + 'THESIS:\\n') + text}\n    84\t\n    85\t\n    86\tdef sign_question(text, direction, version='links-v1'):\n    87\t    return {'type': 'choice', 'criteria': dict(QUESTION_SETS[version][1]), 'instructions': SIGN_INSTRUCTIONS[direction] + text}\n    88\t\n    89\t\n    90\t# ---------- identity: which ladders are number ladders, and the label ----------\n    91\t\n    92\tdef typed_direction(rungs):\n    93\t    \"\"\"-1 when the values fall from the first rung to the last, +1 when they rise, None otherwise. Each rung is [lo, hi) of its typed\n    94\t    bounds; only the first and last rung may leave one outer end open; an interval with lo >= hi is invalid; adjacent rungs may\n    95\t    touch. Prose is never read.\"\"\"\n    96\t    if len(rungs) < 2:\n    97\t        return None\n    98\t    intervals = []\n    99\t    for index, rung in enumerate(rungs):\n   100\t        lo, hi = rung.get('lo'), rung.get('hi')\n   229\t\n   230\t\n   231\tdef choose(archive, cfg, conn, handover, checked, lists, shown_views, *, transport=None):\n   232\t    \"\"\"The links this article proposes: [{'reader', 'read', 'candidate', 'direction', 'sign'}], reader and read being a candidate id\n   233\t    (canonical) or a stored view id; and the record of how they were chosen. Raises Refused for an unbound waiting row, a Jev\n   234\t    failure or a circle that remains after one correction (PRD 06).\"\"\"\n   235\t    record = {'pairs': [], 'calls': [], 'corrections': [], 'proposed': []}\n   236\t    if unbound_waits(conn):\n   237\t        record['error'] = 'the store holds an unbound waiting dependency row'\n   238\t        raise Refused(record['error'], record)\n   239\t    aliases, problems = identity.batch_plan(handover.candidates, checked.outcomes)\n   240\t    if problems:                                   # the writer refuses the same plan (WriteConflict); nothing to ask\n   241\t        record['skipped'] = problems\n   242\t        return [], record\n   243\t    evidence = handover.evidence\n   244\t    stage1, asked = [], []\n   245\t    for c in handover.candidates:\n   246\t        outcome, target, _ = checked.outcomes.get(c['id'], ('skip', None, []))\n   247\t        if outcome not in ('new', 'succession') or aliases.get(c['id']) != c['id']:\n   248\t            continue\n   249\t        rungs = candidate_rungs(conn, c, outcome, target)\n   250\t        if not is_number_question(c['kind'], rungs, c.get('measure')):\n   251\t            record['pairs'].append({'candidate': c['id'], 'eligible': False, 'why': 'not a number question'})\n   252\t            continue\n   253\t        listed = list(dict.fromkeys(list(lists.candidate_lists.get(c['id'], [])) + [v['view_id'] for v in shown_views]))\n   254\t        theses = []\n   255\t        for view_id in listed:\n   256\t            ok = store.is_open(conn, view_id) and stored_is_number_question(conn, view_id)\n   257\t            record['pairs'].append({'candidate': c['id'], 'thesis': view_id, 'eligible': ok})\n   258\t            if ok:\n   259\t                theses.append(view_id)\n   260\t        if theses:\n   261\t            state = jev_matching.candidate_state(c, evidence)\n   262\t            stage1.append((state, {f'reads__{v}': reads_question(jev_matching.thesis_text(conn, v), version=cfg.matching.link_questions) for v in theses}))\n   263\t            asked.append((c, state, theses))\n   264\t    if not stage1:\n   265\t        return [], record\n   266\t    answers = _ask(archive, cfg, stage1, transport, record, 'reads')\n   267\t    directions = {}\n   268\t    for (c, state, theses), reply in zip(asked, answers):\n   269\t        for view_id in theses:\n   270\t            answer = reply[f'reads__{view_id}']\n   271\t            direction = _passes(answer, (CANDIDATE_READS, THESIS_READS))\n   272\t            record['pairs'].append({'candidate': c['id'], 'thesis': view_id, 'reads': answer['choice'], 'probabilities': answer['probabilities']})\n   273\t            if direction:\n   274\t                directions[(c['id'], view_id)] = direction\n   275\t    links = _signed(archive, cfg, conn, asked, directions, transport, record)\n   276\t    on_circle = circles(conn, links)\n   277\t    if on_circle:\n   278\t        links = _corrected(archive, cfg, conn, asked, directions, links, on_circle, transport, record)\n   279\t        remaining = circles(conn, links)\n   280\t        if remaining:\n   281\t            record['error'] = 'persistent cycle: ' + '; '.join(' -> '.join(path) for _, path in remaining)\n   282\t            raise Refused(record['error'], record)\n   283\t    record['proposed'] = links\n   284\t    return links, record\n   285\t\n   286\t\n   287\tdef _signed(archive, cfg, conn, asked, directions, transport, record, stage='sign'):\n   288\t    jobs, owners = [], []\n   289\t    for c, state, theses in asked:\n   290\t        questions = {f'sign__{v}': sign_question(jev_matching.thesis_text(conn, v), directions[(c['id'], v)], version=cfg.matching.link_questions)\n   291\t                     for v in theses if (c['id'], v) in directions}\n   292\t        if questions:\n   293\t            jobs.append((state, questions))\n   294\t            owners.append(c)\n   295\t    links = []\n   296\t    if not jobs:\n   297\t        return links\n   298\t    for c, reply in zip(owners, _ask(archive, cfg, jobs, transport, record, stage)):\n   299\t        for qid, answer in sorted(reply.items()):\n   300\t            view_id = qid[len('sign__'):]\n   301\t            sign = _passes(answer, (TOGETHER, OPPOSITE))\n   302\t            record['pairs'].append({'candidate': c['id'], 'thesis': view_id, 'sign': answer['choice'], 'probabilities': answer['probabilities']})\n   303\t            if sign:\n   304\t                direction = directions[(c['id'], view_id)]\n   305\t                reader, read = (c['id'], view_id) if direction == CANDIDATE_READS else (view_id, c['id'])\n   306\t                links.append({'reader': reader, 'read': read, 'candidate': c['id'], 'thesis': view_id, 'direction': direction, 'sign': sign})\n   307\t    return links\n   308\t\n   309\t\n   310\tdef _corrected(archive, cfg, conn, asked, directions, links, on_circle, transport, record):\n   311\t    \"\"\"PRD 06: refuse a circle and ask the model to correct it, once: the pair's READS question again, the offending direction removed\n   312\t    and the circle named; the answer replaces the original.\"\"\"\n   313\t    offending = {(link['candidate'], link['thesis']): path for link, path in on_circle}\n   314\t    jobs, owners = [], []\n   315\t    for c, state, theses in asked:\n   316\t        questions = {}\n   317\t        for view_id in theses:\n   318\t            path = offending.get((c['id'], view_id))\n   319\t            if path is None:\n   320\t                continue\n   321\t            excluded = directions[(c['id'], view_id)]\n   322\t            named = [('the CANDIDATE' if node == c['id'] else 'the THESIS' if node == view_id else node) for node in path]\n   323\t            note = f'Reading this way would make {named[0]} read itself through {\" -> \".join(named)}; a question cannot read its own conclusion.'\n   324\t            questions[f'reads__{view_id}'] = reads_question(jev_matching.thesis_text(conn, view_id), excluded=excluded, note=note,\n   325\t                                                            version=cfg.matching.link_questions)\n   326\t            record['corrections'].append({'candidate': c['id'], 'thesis': view_id, 'rejected': excluded, 'path': path})\n   327\t        if questions:\n   328\t            jobs.append((state, questions))\n   329\t            owners.append(c)\n   330\t    kept = [link for link in links if (link['candidate'], link['thesis']) not in offending]\n   331\t    corrected = {}\n   332\t    for c, reply in zip(owners, _ask(archive, cfg, jobs, transport, record, 'correction')):\n   333\t        for qid, answer in reply.items():\n   334\t            view_id = qid[len('reads__'):]\n   335\t            directions.pop((c['id'], view_id), None)\n   336\t            direction = _passes(answer, (CANDIDATE_READS, THESIS_READS))\n   337\t            record['corrections'].append({'candidate': c['id'], 'thesis': view_id, 'answer': answer['choice'], 'probabilities': answer['probabilities']})\n   338\t            if direction:\n   339\t                corrected[(c['id'], view_id)] = direction\n   340\t    if corrected:\n   341\t        directions.update(corrected)\n   342\t        regrouped = [(c, state, [v for v in theses if (c['id'], v) in corrected]) for c, state, theses in asked]\n   343\t        kept += _signed(archive, cfg, conn, [g for g in regrouped if g[2]], corrected, transport, record, stage='correction sign')\n   344\t    return kept\n   345\t\n   346\t\n   347\t# ---------- the record ----------\n   348\t\n   349\tdef attempt_id(conn, item):\n   350\t    count = conn.execute('select count(distinct attempt_id) from link_selections where input_id=?', (item['input_id'],)).fetchone()[0]\ngit: warning: confstr() failed with code 5: couldn't get path of DARWIN_USER_TEMP_DIR; using /tmp instead\ngit: error: couldn't create cache file '/tmp/xcrun_db-V6c8N3xs' (errno=Operation not permitted)\n2026-11-21 11:24:43.818 xcodebuild[54561:68759484]  DVTFilePathFSEvents: Failed to start fs event stream.\n2026-11-21 11:24:43.937 xcodebuild[54561:68759483] [MT] DVTDeveloperPaths: Failed to get length of DARWIN_USER_CACHE_DIR from confstr(3), error = Error Domain=NSPOSIXErrorDomain Code=5 \"Input/output error\". Using NSCachesDirectory instead.\ngit: warning: confstr() failed with code 5: couldn't get path of DARWIN_USER_TEMP_DIR; using /tmp instead\ngit: error: couldn't create cache file '/tmp/xcrun_db-D7M3NQ8M' (errno=Operation not permitted)\n2026-11-21 11:24:44.393 xcodebuild[54563:68759499]  DVTFilePathFSEvents: Failed to start fs event stream.\n2026-11-21 11:24:44.511 xcodebuild[54563:68759498] [MT] DVTDeveloperPaths: Failed to get length of DARWIN_USER_CACHE_DIR from confstr(3), error = Error Domain=NSPOSIXErrorDomain Code=5 \"Input/output error\". Using NSCachesDirectory instead.\n M src/hivemind/config.py\n M tests/test_frozen_questions_and_judgement.py\n?? poc/config/poc-v119.json\n?? poc/config/poc-v120.json\n?? src/hivemind/views/links.py\n?? tests/test_links.py\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_11","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba window_test.py | sed -n '50,90p;305,460p'; nl -ba mutants.py | sed -n '1,150p'; nl -ba v120-replay-1.log | tail -12; rg -n 'matching.engine|def refuse_links_engine' ../../../scripts/replay.py ../../../clean-arch/e2e-comparison-2026-11-13/budget_replay.py ../../../src/hivemind/views/round.py; rg -n 'dataclasses\\\\.asdict\\\\(|\\\\.matching\\\\.__dict__|vars\\\\(.*matching|\\\\.matching\\\\.link_questions' ../../../src ../../../scripts ../../../clean-arch --glob '*.py'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba window_test.py | sed -n '50,90p;305,460p'; nl -ba mutants.py | sed -n '1,150p'; nl -ba v120-replay-1.log | tail -12; rg -n 'matching.engine|def refuse_links_engine' ../../../scripts/replay.py ../../../clean-arch/e2e-comparison-2026-11-13/budget_replay.py ../../../src/hivemind/views/round.py; rg -n 'dataclasses\\\\.asdict\\\\(|\\\\.matching\\\\.__dict__|vars\\\\(.*matching|\\\\.matching\\\\.link_questions' ../../../src ../../../scripts ../../../clean-arch --glob '*.py'\"","aggregated_output":"    50\t\n    51\tdef replay_window(folder, link_answer, cfg_path=V119):\n    52\t    \"\"\"poc-v119 from an empty ledger over the whole window: link questions go to `link_answer`; every other request must be answered\n    53\t    from the copy of old-2's archive (an answer old-2's own run refused is given back once, so the check refuses it again); anything\n    54\t    else stops the pass. Returns the census: equality with old-2, every link job, every opening with its pairs.\"\"\"\n    55\t    if folder.exists():\n    56\t        raise SystemExit(f'{folder} exists: a pass starts from an empty folder')\n    57\t    folder.mkdir(parents=True)\n    58\t    shutil.copyfile(OLD2 / 'archive.sqlite', folder / 'archive.sqlite')\n    59\t    views = folder / 'views.sqlite'\n    60\t    marker = sqlite3.connect(views)                 # marked harness-only before the first item: ordinary writers refuse it (D694 §0)\n    61\t    marker.execute('create table harness_only (name text, day text)')\n    62\t    marker.execute(\"insert into harness_only values ('window_test.py', '2026-11-21')\")\n    63\t    marker.commit()\n    64\t    marker.close()\n    65\t    held = live_lock.acquire(str(views))            # the store lock for the whole pass: no second writer\n    66\t    asked, refused_again = [], []\n    67\t    stored_refusals = refused_rows()\n    68\t\n    69\t    def transport(*args):\n    70\t        if len(args) == 1 and july_test.is_link_request(args[0]):\n    71\t            asked.append(sorted(args[0]['questions']))\n    72\t            return link_answer(args[0])\n    73\t        response = stored_refusals.pop(model.request_identity(args[-1])[1], None)\n    74\t        if response is not None:                   # old-2's own run refused this answer: give it back, so the check refuses it again\n    75\t            refused_again.append(model.request_identity(args[-1])[1][:12])\n    76\t            return response\n    77\t        (folder / 'missed-request.json').write_text(json.dumps(args[-1], ensure_ascii=False, indent=1))\n    78\t        raise july_test.Stop('a request other than a link question missed the archive')\n    79\t    started = time.time()\n    80\t    try:\n    81\t        totals = replay.run(testdb_path=str(ITEMS), views_path=str(views), archive=model.Archive(str(folder / 'archive.sqlite')),\n    82\t                            cfg=config.load(str(cfg_path)), universe=universe.load(str(UNIVERSE)), from_day=WINDOW[0], until_day=WINDOW[1],\n    83\t                            transport=transport, log=lambda *a: None, only_objects={'NVDA'})\n    84\t    finally:\n    85\t        live_lock.release(held)\n    86\t    print('totals:', totals, 'seconds:', round(time.time() - started))\n    87\t    conn = sqlite3.connect(f'file:{folder / \"views.sqlite\"}?mode=ro', uri=True)\n    88\t    last_seq = conn.execute('select max(seq) from days_completed').fetchone()[0]\n    89\t    stored_last = sqlite3.connect(f'file:{OLD2 / \"views.sqlite\"}?mode=ro', uri=True).execute('select max(seq) from days_completed').fetchone()[0]\n    90\t    print('last completed seq', last_seq, 'old-2', stored_last)\n   305\tV2_TIE_BREAK = (\" When either question could be judged with the other in view, the one whose answer the supplied text anchors less (no \"\n   306\t                \"guidance, consensus or reported figure for the quantity and full period the question asks about) is the one judged \"\n   307\t                \"with the other's conclusion in view.\")\n   308\tV2_PERIODS = (\" or quantities of different periods when the supplied text does not state how one period's answer moves the other's (a \"\n   309\t              \"retailer's sales this year and its sales growth next year, when the text only names both);\")\n   310\tV2_BASE = \"; one year's sales and the next year's sales growth at a given next-year level, since a higher base lowers the growth)\"\n   311\t\n   312\t\n   313\tdef wording_v2():\n   314\t    \"\"\"The version-2 READS and SIGN criteria: the current texts with the three changes of WORDING-V2.md §2 (each anchored on a unique\n   315\t    phrase of the current text, so a moved text fails loudly).\"\"\"\n   316\t    reads, sign = dict(links.READS), dict(links.SIGN)\n   317\t    reads[links.CANDIDATE_READS] = reads[links.CANDIDATE_READS] + V2_TIE_BREAK\n   318\t    anchor = \"for the same period and scope;\"\n   319\t    assert reads[links.NEITHER].count(anchor) == 1\n   320\t    reads[links.NEITHER] = reads[links.NEITHER].replace(anchor, \"for the same period and scope,\" + V2_PERIODS)\n   321\t    tail = \"a retailer's markdowns and its gross margin)\"\n   322\t    assert sign[links.OPPOSITE].endswith(tail)\n   323\t    sign[links.OPPOSITE] = sign[links.OPPOSITE][:-1] + V2_BASE\n   324\t    return reads, sign\n   325\t\n   326\t\n   327\tdef with_wording_v2(run):\n   328\t    reads, sign = wording_v2()\n   329\t    original = links.READS, links.SIGN\n   330\t    links.READS, links.SIGN = reads, sign\n   331\t    try:\n   332\t        return run()\n   333\t    finally:\n   334\t        links.READS, links.SIGN = original\n   335\t\n   336\t\n   337\tdef probe_pass(folder, draw, inner, ledger_state, transport_kind):\n   338\t    \"\"\"One version-2 draw into `folder`: every link job asked with the version-2 texts (none matches a July request, so all are sent to\n   339\t    `inner`), the writer handed no link. Every request must carry the version-2 texts (checked as it is sent). Writes `draw.json`; the\n   340\t    draw is counted only when it is complete, ended equal to old-2 with no link row, and the ledger neither stopped nor overran.\"\"\"\n   341\t    reads, sign = wording_v2()\n   342\t    carried = []\n   343\t\n   344\t    def link_answer(request):\n   345\t        texts = [q['criteria'] for q in request['questions'].values()]\n   346\t        expected = reads if next(iter(request['questions'])).startswith('reads__') else sign\n   347\t        if any(criteria != {k: v for k, v in expected.items() if k in criteria} for criteria in texts):\n   348\t            raise july_test.Stop('a link job does not carry the version-2 criteria: not sent')\n   349\t        carried.append(len(texts))\n   350\t        return inner(request)\n   351\t    result = with_wording_v2(lambda: without_links(lambda: replay_window(folder, link_answer)))\n   352\t    state = ledger_state()\n   353\t    whole, problems = complete(result)\n   354\t    counted = result['equal to old-2'] and result['link rows written'] == 0 and whole and bool(carried) and not state.get('stopped') and not state.get('overrun')\n   355\t    (folder / 'draw.json').write_text(json.dumps({'draw': draw, 'wording': 'v2', 'transport': transport_kind, 'counted': counted,\n   356\t                                                  'complete': whole, 'problems': problems, 'equal to old-2': result['equal to old-2'],\n   357\t                                                  'jobs carrying version 2': len(carried), 'ledger': state}, indent=1))\n   358\t    print('ledger:', state, 'complete:', whole, problems, 'jobs carrying version 2:', len(carried))\n   359\t    return counted\n   360\t\n   361\t\n   362\tdef probe_v2_dry(scratch):\n   363\t    \"\"\"$0: the version-2 pass with every pair answered \"reads\", sign together: complete, equal to old-2, every job carrying the\n   364\t    version-2 texts, 105 proposals.\"\"\"\n   365\t    counted = probe_pass(scratch / 'probe-v2-dry', 'dry', july_test.fake_jev(Everything()), lambda: {'stopped': False, 'overrun': False}, 'dry')\n   366\t    conn = sqlite3.connect(f'file:{scratch / \"probe-v2-dry\" / \"views.sqlite\"}?mode=ro', uri=True)\n   367\t    proposed = sum(len(json.loads(r)['proposed']) for (r,) in conn.execute(\"select record_json from link_selections where status='proposed'\"))\n   368\t    print('proposals:', proposed)\n   369\t    return counted and proposed == 105\n   370\t\n   371\t\n   372\tdef probe_v2(scratch, draw, ledger_path, approved):\n   373\t    \"\"\"One paid version-2 draw on D700's ledger (the same checks as `census`: approved finite ceiling equal to the ledger's, launcher\n   374\t    registered, stop gate installed).\"\"\"\n   375\t    budget = july_test.budget_module()\n   376\t    if not (isinstance(approved, float) and math.isfinite(approved) and 0 < approved <= CENSUS_CEILING):\n   377\t        raise SystemExit(f'the approved ceiling must be a finite amount above 0 and at most ${CENSUS_CEILING}')\n   378\t    ledger = budget.SharedLedger(str(ledger_path))\n   379\t    ceiling = ledger.read()['ceiling']\n   380\t    if not (isinstance(ceiling, (int, float)) and math.isfinite(ceiling) and ceiling == approved):\n   381\t        raise SystemExit(f'the ledger ceiling {ceiling!r} is not the approved ${approved}: refused')\n   382\t    if draw not in ('1', '2', '3'):\n   383\t        raise SystemExit('draw must be 1, 2 or 3')\n   384\t    label = f'probe-v2-{draw}'\n   385\t    lock_handle = open(Path(ledger_path).with_name(f'{label}.launcher.lock'), 'a+')\n   386\t    if not ledger.claim_launcher(label, lock_handle):\n   387\t        raise SystemExit(f'another launch of {label} is running')\n   388\t    budget.install_stop_gate(ledger)\n   389\t    try:\n   390\t        return probe_pass(scratch / label, draw, budget.BudgetTransport(ledger), ledger.read, 'paid')\n   391\t    finally:\n   392\t        ledger.remove_launcher(label)\n   393\t\n   394\t\n   395\tV120 = REPO / 'poc/config/poc-v120.json'\n   396\t\n   397\t\n   398\tdef probe_answers(draw):\n   399\t    \"\"\"The link jobs a version-2 probe draw sent and their answers: {request hash: stored Jev response}.\"\"\"\n   400\t    archive = sqlite3.connect(f'file:{REPO / \"poc/data/link-census-2026-11-21\" / f\"probe-v2-{draw}\" / \"archive.sqlite\"}?mode=ro', uri=True)\n   401\t    top = sqlite3.connect(f'file:{OLD2 / \"archive.sqlite\"}?mode=ro', uri=True).execute('select max(call_id) from model_calls').fetchone()[0]\n   402\t    out = {}\n   403\t    for sha, request_json, response_json in archive.execute('select request_sha256, request_json, response_json from model_calls where call_id > ?', (top,)):\n   404\t        if july_test.is_link_request(json.loads(request_json)):\n   405\t            out[sha] = json.loads(response_json)\n   406\t    return out\n   407\t\n   408\t\n   409\tdef v120_replay(scratch, draw):\n   410\t    \"\"\"$0: the product configuration poc-v120 over the whole window, its link jobs answered only by the probe draw's own answers\n   411\t    matched by request hash (a job the probe did not send stops the pass), the writer handed no link as in the probe: every probe job\n   412\t    must be met, nothing else asked, and the pass must end equal to old-2. This proves the product's version-2 requests are the bytes\n   413\t    the probe sent.\"\"\"\n   414\t    stored, met = probe_answers(draw), []\n   415\t\n   416\t    def link_answer(request):\n   417\t        sha = model.request_identity(request)[1]\n   418\t        if sha not in stored:\n   419\t            raise july_test.Stop(f'poc-v120 built a link job the probe did not send ({sha[:12]})')\n   420\t        met.append(sha)\n   421\t        return stored[sha]\n   422\t    result = without_links(lambda: replay_window(scratch / f'v120-replay-{draw}', link_answer, V120))\n   423\t    every = sorted(met) == sorted(stored) and len(set(met)) == len(met)\n   424\t    print(json.dumps({'draw': draw, 'probe jobs': len(stored), 'met': len(met), 'every probe job met once': every,\n   425\t                      'equal to old-2': result['equal to old-2'], 'link rows written': result['link rows written']}, indent=1))\n   426\t    return every and result['equal to old-2'] and result['link rows written'] == 0\n   427\t\n   428\tif __name__ == '__main__':\n   429\t    command, scratch = sys.argv[1], Path(sys.argv[2])\n   430\t    if command == 'neither':\n   431\t        sys.exit(0 if neither(scratch) else 1)\n   432\t    if command == 'census-dry':\n   433\t        sys.exit(0 if census_dry(scratch) else 1)\n   434\t    if command == 'census-reuse-dry':\n   435\t        sys.exit(0 if census_reuse_dry(scratch) else 1)\n   436\t    if command == 'reuse-refusals':\n   437\t        sys.exit(0 if reuse_refusals(scratch) else 1)\n   438\t    if command == 'v120-replay':\n   439\t        sys.exit(0 if v120_replay(scratch, sys.argv[3]) else 1)\n   440\t    if command == 'probe-v2-dry':\n   441\t        sys.exit(0 if probe_v2_dry(scratch) else 1)\n   442\t    if command == 'probe-v2':\n   443\t        sys.exit(0 if probe_v2(scratch, sys.argv[3], Path(sys.argv[4]), float(sys.argv[5])) else 1)\n   444\t    if command == 'census':\n   445\t        sys.exit(0 if census(scratch, sys.argv[3], Path(sys.argv[4]), float(sys.argv[5])) else 1)\n   446\t    raise SystemExit(f'unknown command {command}')\n     1\t\"\"\"$0 mutation check of the linking version after the link question version was added (D705, WORDING-V2.md §5; AGENTS §4): the July\n     2\tmutants (`../2026-11-20-production-readiness/dependency-design/mutants.py`, one anchor moved with the builders) and the version's own.\n     3\tEach mutant is applied to a scratch copy of the tree, run without bytecode caches, and must make its named tests fail; the unmutated\n     4\tcopy must pass them.\n     5\t\n     6\t  python3 mutants.py <scratch folder>\n     7\t\"\"\"\n     8\timport os\n     9\timport shutil\n    10\timport subprocess\n    11\timport sys\n    12\tfrom pathlib import Path\n    13\t\n    14\tREPO = Path(__file__).resolve().parents[3]\n    15\tCOPY = ['src', 'scripts', 'tests', 'pytest.ini', 'poc/config', 'poc/universe.json', 'poc/seeds']\n    16\tLINKS, FROZEN = 'tests/test_links.py', 'tests/test_frozen_questions_and_judgement.py'\n    17\tMUTANTS = [\n    18\t    # the July mutants\n    19\t    ('filing narrows a reads link', 'src/hivemind/views/store.py',\n    20\t     \"\"\"    reads = \" and coalesce(kind, '') != 'reads'\" if\"\"\", \"\"\"    reads = \"\" if\"\"\", LINKS, 'test_a_reads_link_is_not_a_narrower_home'),\n    21\t    ('links asked under the jev engine', 'src/hivemind/views/round.py',\n    22\t     \"    if cfg.matching.engine == links.ENGINE:\", \"    if cfg.matching.engine in ('jev', links.ENGINE):\", LINKS,\n    23\t     'test_under_the_jev_engine_no_link_question_is_asked'),\n    24\t    ('an existing reader is not queued', 'src/hivemind/views/writing.py',\n    25\t     \"            written.changed_views.add(reader)\", \"            pass\", LINKS,\n    26\t     'test_an_existing_question_gains_a_reads_link or test_the_article_writes_the_link'),\n    27\t    ('an ordinary replay writes a harness ledger', 'scripts/replay.py',\n    28\t     \"    if marked:\\n        raise SystemExit('this ledger is marked harness-only; an ordinary replay does not write it')\", \"    pass\", LINKS,\n    29\t     'test_an_ordinary_replay_refuses_a_harness_only_ledger'),\n    30\t    ('the sign is ignored in the label', 'src/hivemind/views/links.py',\n    31\t     \"    want_read_high = favourable_is_high if sign == TOGETHER else not favourable_is_high\", \"    want_read_high = favourable_is_high\", LINKS,\n    32\t     'test_the_label_follows_the_sign'),\n    33\t    ('the circle check reads stored links only', 'src/hivemind/views/links.py',\n    34\t     \"    for link in proposed:\\n        graph.setdefault(link['reader'], set()).add(link['read'])\\n\", \"\", LINKS,\n    35\t     'test_a_circle_through_two_openings or test_a_circle_through_a_stored_link'),\n    36\t    ('a correction keeps the offending direction', 'src/hivemind/views/links.py',\n    37\t     \"    criteria = {k: v for k, v in QUESTION_SETS[version][0].items() if k != excluded}\", \"    criteria = dict(QUESTION_SETS[version][0])\", LINKS,\n    38\t     'test_a_circle_through_a_stored_link'),\n    39\t    # the question version (D705)\n    40\t    ('READS ignores the configured version', 'src/hivemind/views/links.py',\n    41\t     \"reads_question(jev_matching.thesis_text(conn, v), version=cfg.matching.link_questions)\", \"reads_question(jev_matching.thesis_text(conn, v))\",\n    42\t     LINKS, 'test_version_two_asks_its_own_criteria'),\n    43\t    ('SIGN ignores the configured version', 'src/hivemind/views/links.py',\n    44\t     \"directions[(c['id'], v)], version=cfg.matching.link_questions)\", \"directions[(c['id'], v)])\", LINKS,\n    45\t     'test_version_two_asks_its_own_criteria'),\n    46\t    ('a correction ignores the configured version', 'src/hivemind/views/links.py',\n    47\t     \"excluded=excluded, note=note,\\n                                                            version=cfg.matching.link_questions)\",\n    48\t     \"excluded=excluded, note=note)\", LINKS, 'test_version_two_asks_its_own_criteria'),\n    49\t    ('config accepts an unknown question version', 'src/hivemind/config.py',\n    50\t     \"        if link_questions not in LINK_QUESTIONS:\", \"        if False:\", LINKS, 'test_the_question_version_is_read'),\n    51\t    ('config accepts the field on another engine', 'src/hivemind/config.py',\n    52\t     \"    if link_questions is not None and engine != 'jev-links':\", \"    if False:\", LINKS, 'test_the_question_version_is_read'),\n    53\t    ('a version-2 text drifts by one word', 'src/hivemind/views/links.py',\n    54\t     \"since a higher base lowers the growth)\", \"since a higher base reduces the growth)\", FROZEN,\n    55\t     'test_the_linking_version_pins_its_questions'),\n    56\t]\n    57\t\n    58\t\n    59\tdef tree(scratch, name):\n    60\t    root = scratch / name\n    61\t    if root.exists():\n    62\t        shutil.rmtree(root)\n    63\t    for part in COPY:\n    64\t        source, target = REPO / part, root / part\n    65\t        target.parent.mkdir(parents=True, exist_ok=True)\n    66\t        (shutil.copytree if source.is_dir() else shutil.copyfile)(source, target, **({'ignore': shutil.ignore_patterns('__pycache__')} if source.is_dir() else {}))\n    67\t    return root\n    68\t\n    69\t\n    70\tdef run(root, test_file, selection):\n    71\t    environment = dict(os.environ, PYTHONDONTWRITEBYTECODE='1')\n    72\t    result = subprocess.run([sys.executable, '-m', 'pytest', '-q', '-p', 'no:cacheprovider', test_file, '-k', selection],\n    73\t                            cwd=root, capture_output=True, text=True, env=environment)\n    74\t    return result.returncode, result.stdout.strip().splitlines()[-1] if result.stdout.strip() else result.stderr[-200:]\n    75\t\n    76\t\n    77\tdef main():\n    78\t    scratch = Path(sys.argv[1])\n    79\t    scratch.mkdir(parents=True, exist_ok=True)\n    80\t    control = tree(scratch, 'control')\n    81\t    ok = True\n    82\t    for name, path, old, new, test_file, selection in MUTANTS:\n    83\t        code, summary = run(control, test_file, selection)\n    84\t        print(f'control  [{name}]: exit {code} {summary}')\n    85\t        ok = ok and code == 0\n    86\t        root = tree(scratch, 'mutant')\n    87\t        text = (root / path).read_text()\n    88\t        if text.count(old) != 1:\n    89\t            print(f'mutant   [{name}]: the mutated line is not found once: not applied')\n    90\t            ok = False\n    91\t            continue\n    92\t        (root / path).write_text(text.replace(old, new))\n    93\t        code, summary = run(root, test_file, selection)\n    94\t        caught = code != 0\n    95\t        ok = ok and caught\n    96\t        print(f'mutant   [{name}]: exit {code} {\"CAUGHT\" if caught else \"NOT CAUGHT\"} {summary}')\n    97\t    sys.exit(0 if ok else 1)\n    98\t\n    99\t\n   100\tif __name__ == '__main__':\n   101\t    main()\n    62\t1677 eligible [] not eligible 1\n    63\t1828 eligible [] not eligible 1\n    64\t1874 eligible [] not eligible 1\n    65\t{\n    66\t \"draw\": \"1\",\n    67\t \"probe jobs\": 17,\n    68\t \"met\": 17,\n    69\t \"every probe job met once\": true,\n    70\t \"equal to old-2\": true,\n    71\t \"link rows written\": 0\n    72\t}\n    73\texit 0\n../../../clean-arch/e2e-comparison-2026-11-13/budget_replay.py:364:    jev_workers = args.jev_workers if args.jev_workers is not None else (8 if cfg.matching.engine == 'jev' else 1)\n../../../scripts/replay.py:13:Jev matching questions at a time (8; one at a time for another matching engine); the ledger equals the serial one for\n../../../scripts/replay.py:66:def refuse_links_engine(cfg):\n../../../scripts/replay.py:67:    \"\"\"D694: poc-v119's matching engine runs only in its July test harness in this version, not from an ordinary launcher.\"\"\"\n../../../scripts/replay.py:68:    if cfg.matching.engine == 'jev-links':\n../../../scripts/replay.py:69:        raise SystemExit(f'config {cfg.version}: matching engine jev-links is not a product entry point in this version (D694)')\n../../../scripts/replay.py:108:        jev_workers = args.jev_workers if args.jev_workers is not None else (8 if cfg.matching.engine == 'jev' else 1)\n../../../src/hivemind/views/round.py:39:    engine = jev_matching if cfg.matching.engine in ('jev', links.ENGINE) else matching      # Jev answers once; a retry would be the same answer\n../../../src/hivemind/views/round.py:156:    if cfg.matching.engine == links.ENGINE:\n../../../src/hivemind/views/links.py:262:            stage1.append((state, {f'reads__{v}': reads_question(jev_matching.thesis_text(conn, v), version=cfg.matching.link_questions) for v in theses}))\n../../../src/hivemind/views/links.py:290:        questions = {f'sign__{v}': sign_question(jev_matching.thesis_text(conn, v), directions[(c['id'], v)], version=cfg.matching.link_questions)\n../../../src/hivemind/views/links.py:325:                                                            version=cfg.matching.link_questions)\n../../../src/hivemind/parallel_day.py:35:    return model.request_identity({'config': dataclasses.asdict(cfg), 'universe': vars(universe)})[1]\n../../../clean-arch/e2e-2026-11-09/control_v108.py:88:    return json.dumps({name: str(value) if isinstance(value, Path) else value for name, value in dataclasses.asdict(inputs).items()}, indent=1)\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_12","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba ../../../src/hivemind/parallel_day.py | sed -n '1,125p'; rg -n 'fingerprint|config_sha|checksum|resume|_fingerprint|signature' ../../../src/hivemind/parallel_day.py; nl -ba ../../../scripts/replay.py | sed -n '83,150p'; nl -ba ../../../clean-arch/e2e-comparison-2026-11-13/budget_replay.py | sed -n '343,378p'; rg -n 'plan_config|input_identity|identity.*config|asdict\\\\(cfg\\\\)|vars\\\\(cfg\\\\)' ../../../src ../../../tests ../../../scripts\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba ../../../src/hivemind/parallel_day.py | sed -n '1,125p'; rg -n 'fingerprint|config_sha|checksum|resume|_fingerprint|signature' ../../../src/hivemind/parallel_day.py; nl -ba ../../../scripts/replay.py | sed -n '83,150p'; nl -ba ../../../clean-arch/e2e-comparison-2026-11-13/budget_replay.py | sed -n '343,378p'; rg -n 'plan_config|input_identity|identity.*config|asdict\\\\(cfg\\\\)|vars\\\\(cfg\\\\)' ../../../src ../../../tests ../../../scripts\"","aggregated_output":"     1\t\"\"\"One day's items with concurrent request preparation and one ordered writer (D172, D181).\n     2\t\n     3\tAn item's accepted extraction must answer the exact request built from the ledger committed by the items before it,\n     4\tas in serial processing (D159). Extraction requests for later items are sent early, from the ledger as it stands;\n     5\tafter each commit, every waiting request that commit changed is built again and sent again, and at its turn an item\n     6\taccepts a prepared answer only if its request is byte-identical to the request built now. Matching questions within\n     7\tan item run concurrently and are applied in their planned order. Only this coordinator reads or writes the ledger;\n     8\tworkers receive copies and write only the thread-safe call archive. Opt-in through `replay.run(day_runner=...)`;\n     9\tthe default replay stays serial. The run's spend cap is checked after each committed item, so in-flight early\n    10\trequests can pass it by at most the worker count's calls.\n    11\t\"\"\"\n    12\timport concurrent.futures\n    13\timport copy\n    14\timport dataclasses\n    15\timport hashlib\n    16\timport json\n    17\tfrom pathlib import Path\n    18\timport time\n    19\t\n    20\tfrom . import extraction, model\n    21\tfrom .views import round as rounds, store\n    22\t\n    23\tPACKAGE = Path(__file__).resolve().parent\n    24\t\n    25\t\n    26\tdef digest(path):\n    27\t    value = hashlib.sha256()\n    28\t    with path.open('rb') as handle:\n    29\t        for chunk in iter(lambda: handle.read(1024 * 1024), b''):\n    30\t            value.update(chunk)\n    31\t    return value.hexdigest()\n    32\t\n    33\t\n    34\tdef environment_key(cfg, universe):\n    35\t    return model.request_identity({'config': dataclasses.asdict(cfg), 'universe': vars(universe)})[1]\n    36\t\n    37\t\n    38\tdef runtime_key():\n    39\t    files = sorted(PACKAGE.rglob('*.py')) + sorted((PACKAGE / 'prompts').glob('*'))\n    40\t    return model.request_identity({str(path.relative_to(PACKAGE.parent)): digest(path) for path in files if path.is_file()})[1]\n    41\t\n    42\t\n    43\tdef item_key(item):\n    44\t    return model.request_identity(item)[1]\n    45\t\n    46\t\n    47\tdef extraction_key(cfg, item, text, shown, universe):\n    48\t    setting, system, user, schema = extraction.request_for(cfg, item, text, shown, universe)\n    49\t    return model.request_identity(model.build_request(setting, system, user, schema, 'extraction', cfg.provider))[1]\n    50\t\n    51\t\n    52\tclass ParallelDay:\n    53\t    \"\"\"A `day_runner` for replay.run: per-day manifest, bounded early extraction, validated ordered commits.\"\"\"\n    54\t\n    55\t    def __init__(self, source_path, manifest_dir, *, extraction_workers=2, jev_workers=2):\n    56\t        for workers in (extraction_workers, jev_workers):\n    57\t            if not isinstance(workers, int) or isinstance(workers, bool) or workers < 1:\n    58\t                raise ValueError('worker counts must be positive integers')\n    59\t        self.source_path, self.manifest_dir = Path(source_path), Path(manifest_dir)\n    60\t        if not self.source_path.is_absolute() or not self.source_path.is_file() or not self.manifest_dir.is_absolute():\n    61\t            raise ValueError('use an existing absolute source path and an absolute manifest directory')\n    62\t        self.extraction_workers, self.jev_workers = extraction_workers, jev_workers\n    63\t        self.events = []\n    64\t\n    65\t    def _event(self, input_id, event, **fields):\n    66\t        self.events.append(dict(fields, input_id=input_id, event=event, t=time.perf_counter()))\n    67\t\n    68\t    def _manifest(self, conn, cfg, universe, items, day):\n    69\t        self.manifest_dir.mkdir(parents=True, exist_ok=True)\n    70\t        path = self.manifest_dir / f'day-{day}.json'\n    71\t        metadata = {'day': day, 'environment': environment_key(cfg, universe), 'runtime': runtime_key(),\n    72\t                    'source': digest(self.source_path), 'extraction_workers': self.extraction_workers,\n    73\t                    'jev_workers': self.jev_workers}\n    74\t        entries = [{'input_id': item['input_id'], 'seq': route.sequence_no, 'hash': item_key(item)} for item, route in items]\n    75\t        started = conn.execute(\"select 1 from processing_steps where publication_day=? and step in ('extracted','written','handed_over') limit 1\", (day,)).fetchone()\n    76\t        if not started:\n    77\t            # Nothing of this day is written in this ledger: a manifest left by another run or ledger guards nothing here.\n    78\t            path.write_text(json.dumps(dict(metadata, inputs=entries), sort_keys=True), encoding='utf-8')\n    79\t        elif not path.exists():\n    80\t            raise ValueError('cannot adopt a partially processed day without its parallel-day manifest; finish it with --workers 1')\n    81\t        try:\n    82\t            saved = json.loads(path.read_text())\n    83\t        except (OSError, ValueError) as error:\n    84\t            raise ValueError('unreadable parallel-day manifest; refusing to guess its inputs') from error\n    85\t        if {k: saved.get(k) for k in metadata} != metadata:\n    86\t            raise ValueError('parallel-day manifest source, configuration or runtime changed')\n    87\t        remaining = [entry for entry in saved['inputs'] if not store.is_processed(conn, entry['input_id'])]\n    88\t        if remaining != entries:\n    89\t            raise ValueError('parallel-day manifest input order or content changed')\n    90\t        return metadata\n    91\t\n    92\t    def __call__(self, conn, archive, cfg, universe, items, *, day, transport=None, log=print):\n    93\t        if cfg.matching.engine not in ('jev', 'jev-links') and self.jev_workers != 1:\n    94\t            raise ValueError('parallel matching is only implemented for Jev')\n    95\t        metadata = self._manifest(conn, cfg, universe, items, day)\n    96\t        frozen_cfg, frozen_universe = copy.deepcopy(cfg), copy.deepcopy(universe)\n    97\t        pending, prepared_futures, next_index = {}, [], 0\n    98\t        pool = concurrent.futures.ThreadPoolExecutor(max_workers=self.extraction_workers)\n    99\t\n   100\t        def current_request(item):\n   101\t            objects = [o['value'] for o in item.get('object_identifiers') or [] if frozen_universe.has(o['value'])]\n   102\t            shown = copy.deepcopy(extraction.shown_views(conn, frozen_cfg, item, objects))\n   103\t            owned_item = copy.deepcopy(item)\n   104\t            return owned_item, shown, extraction_key(frozen_cfg, owned_item, owned_item['text'], shown, frozen_universe)\n   105\t\n   106\t        def submit(item, owned_item, shown, key):\n   107\t            future = pool.submit(extraction.read_item, archive, frozen_cfg, owned_item, owned_item['text'], shown,\n   108\t                                 frozen_universe, transport=transport)      # the read; filing waits for the turn\n   109\t            pending[item['input_id']] = (key, item_key(owned_item), future, item)\n   110\t            prepared_futures.append((item['input_id'], future))\n   111\t            self._event(item['input_id'], 'prepared', request=key)\n   112\t\n   113\t        def fill():\n   114\t            nonlocal next_index\n   115\t            while next_index < len(items) and len(pending) < self.extraction_workers:\n   116\t                item, route = items[next_index]\n   117\t                next_index += 1\n   118\t                if route.resume_from and route.resume_from != 'extracted':\n   119\t                    continue  # The authoritative saved handover is owned by normal recovery.\n   120\t                submit(item, *current_request(item))\n   121\t\n   122\t        def refresh():\n   123\t            \"\"\"Re-prepare, right after a commit, every waiting request that commit changed; the turn still validates.\"\"\"\n   124\t            for input_id, (key, _, future, item) in list(pending.items()):\n   125\t                owned_item, shown, current = current_request(item)\n118:                if route.resume_from and route.resume_from != 'extracted':\n159:                result = rounds.run(conn, archive, frozen_cfg, frozen_universe, item, route.sequence_no, resume_from=route.resume_from,\n    83\t    parser.add_argument('--cap', type=float, default=None, help='USD spend cap for this run')\n    84\t    parser.add_argument('--max-items-per-day', type=int, default=None)\n    85\t    parser.add_argument('--workers', type=int, default=16, help='extraction requests prepared at a time (D183); 1 is the serial path')\n    86\t    parser.add_argument('--jev-workers', type=int, default=None,\n    87\t                        help='Jev matching questions sent at a time when --workers > 1; default 8 for Jev, 1 for another engine')\n    88\t    args = parser.parse_args()\n    89\t    os.makedirs(os.path.dirname(args.views), exist_ok=True)\n    90\t    log_path = os.path.join(os.path.dirname(args.views), 'replay.log')\n    91\t\n    92\t    def log(*parts):\n    93\t        line = ' '.join(str(p) for p in parts)\n    94\t        print(line, flush=True)\n    95\t        with open(log_path, 'a', encoding='utf-8') as handle:\n    96\t            handle.write(line + '\\n')\n    97\t\n    98\t    cfg = config.load(args.config)\n    99\t    if cfg.baseline is not None:\n   100\t        raise SystemExit(f'config {cfg.version} uses retired seeded-question baseline; select a configuration without it')\n   101\t    refuse_links_engine(cfg)\n   102\t    refuse_seeded_ledger(args.views)\n   103\t    refuse_harness_ledger(args.views)\n   104\t    uni = universe.load(args.universe)\n   105\t    archive = model.Archive(args.archive)\n   106\t    day_runner = None\n   107\t    if args.workers > 1:\n   108\t        jev_workers = args.jev_workers if args.jev_workers is not None else (8 if cfg.matching.engine == 'jev' else 1)\n   109\t        day_runner = parallel_day.ParallelDay(os.path.abspath(args.testdb), os.path.join(os.path.dirname(os.path.abspath(args.views)), 'manifests'),\n   110\t                                              extraction_workers=args.workers, jev_workers=jev_workers)\n   111\t    log(f'--- replay {args.from_day}..{args.until_day} config {cfg.version}/{cfg.checksum} provider {cfg.provider} universe {uni.version}'\n   112\t        f' workers {args.workers}')\n   113\t    totals = replay.run(testdb_path=args.testdb, views_path=args.views, archive=archive, cfg=cfg, universe=uni,\n   114\t                        from_day=args.from_day, until_day=args.until_day, day0=args.day0, spend_cap_usd=args.cap, log=log,\n   115\t                        only_objects=set(args.only.split(',')) if args.only else None, max_items_per_day=args.max_items_per_day,\n   116\t                        day_runner=day_runner)\n   117\t    log('totals:', totals)\n   118\t\n   119\t\n   120\tif __name__ == '__main__':\n   121\t    main()\n   343\t    def log(*parts):\n   344\t        line = ' '.join(str(p) for p in parts)\n   345\t        print(line, flush=True)\n   346\t        with open(log_path, 'a', encoding='utf-8') as handle:\n   347\t            handle.write(line + '\\n')\n   348\t\n   349\t    cfg = config.load(args.config)\n   350\t    if cfg.baseline is not None:\n   351\t        raise SystemExit(f'config {cfg.version} uses the retired seeded-question baseline: refused')\n   352\t    import importlib.util\n   353\t    spec = importlib.util.spec_from_file_location('scripts_replay', ROOT / 'scripts/replay.py')\n   354\t    scripts_replay = importlib.util.module_from_spec(spec)\n   355\t    spec.loader.exec_module(scripts_replay)\n   356\t    scripts_replay.refuse_links_engine(cfg)                   # the same refusals scripts/replay.py makes\n   357\t    scripts_replay.refuse_seeded_ledger(args.views)\n   358\t    scripts_replay.refuse_harness_ledger(args.views)\n   359\t    uni = universe.load(args.universe)\n   360\t    archive = model.Archive(args.archive)\n   361\t    ledger = SharedLedger(args.ledger)\n   362\t    install_stop_gate(ledger)                              # Jev's internal retries read the run's stop too (council mo R1)\n   363\t    transport = BudgetTransport(ledger)\n   364\t    jev_workers = args.jev_workers if args.jev_workers is not None else (8 if cfg.matching.engine == 'jev' else 1)\n   365\t    day_runner = parallel_day.ParallelDay(os.path.abspath(args.testdb), os.path.join(os.path.dirname(os.path.abspath(args.views)), 'manifests'),\n   366\t                                          extraction_workers=args.workers, jev_workers=jev_workers) if args.workers > 1 else None\n   367\t    log(f'--- budgeted replay {args.from_day}..{args.until_day} config {cfg.version}/{cfg.checksum} provider {cfg.provider} universe {uni.version} '\n   368\t        f'workers {args.workers}; ledger {args.ledger} {ledger.read()}')\n   369\t    totals = replay.run(testdb_path=args.testdb, views_path=args.views, archive=archive, cfg=cfg, universe=uni,\n   370\t                        from_day=args.from_day, until_day=args.until_day, spend_cap_usd=args.cap, log=log,\n   371\t                        only_objects=set(args.only.split(',')) if args.only else None, transport=transport, day_runner=day_runner)\n   372\t    log('totals:', totals)\n   373\t    log('ledger:', ledger.read())\n   374\t\n   375\t\n   376\tif __name__ == '__main__':\n   377\t    main()\n../../../src/hivemind/parallel_day.py:35:    return model.request_identity({'config': dataclasses.asdict(cfg), 'universe': vars(universe)})[1]\n","exit_code":0,"status":"completed"}}
