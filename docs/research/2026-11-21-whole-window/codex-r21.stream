ass\n def write_text(self,contents): buf[self.path]=contents\n def __str__(self): return self.path\nmem=MemoryPath()\nreal_store=store.open_db\nreal_archive=model.Archive\ntests={t.test_the_question_version_is_read_from_the_matching_setting_and_refused_when_unknown:lambda fn:fn(mem), t.test_version_two_asks_its_own_criteria_at_every_stage_and_version_one_keeps_its_own:lambda fn:fn(mem),f.test_the_linking_version_pins_its_questions_and_keeps_the_judge_schema:lambda fn:fn()}\nimport pytest\nwith mock.patch('\\\\''builtins.open'\\\\'',open_with_fake),mock.patch.object(store,'\\\\''open_db'\\\\'',lambda path:real_store('\\\\'':memory:'\\\\'')),mock.patch.object(model,'\\\\''Archive'\\\\'',lambda path:real_archive('\\\\'':memory:'\\\\'')):\n for fn,run in tests.items(): run(fn)\n print('\\\\''three focused controls pass in memory'\\\\'')\n for title,path,old,new,_,selector in mutants.MUTANTS[-6:]:\n  target=config if path.endswith('\\\\''config.py'\\\\'') else links\n  original=target.__dict__.copy()\n  text=(root/path).read_text()\n  assert text.count(old)==1\n  fn=next(fn for fn in tests if fn.__name__.startswith(selector))\n  try:\n    exec(compile(text.replace(old,new),str(root/path),'\\\\''exec'\\\\''),target.__dict__)\n    try:\n      tests[fn](fn)\n    except (AssertionError,pytest.fail.Exception) as e:\n      import traceback\n      where=next(x for x in reversed(traceback.extract_tb(e.__traceback__)) if x.filename.endswith(('\\\\''/test_links.py'\\\\'','\\\\''/test_frozen_questions_and_judgement.py'\\\\'')))\n      print(title,'\\\\''caught at'\\\\'',where.lineno,str(e))\n    else: raise Exception(title+'\\\\'' survived'\\\\'')\n  finally:\n    target.__dict__.clear()\n    target.__dict__.update(original)\n'\"","aggregated_output":"Traceback (most recent call last):\n  File \"<string>\", line 75, in <module>\nValueError: not enough values to unpack (expected 6, got 5)\npoc-v118 4f2aad7d25dae54d jev ''\npoc-v119 aa577d68c3148864 jev-links 'links-v1'\npoc-v120 90e