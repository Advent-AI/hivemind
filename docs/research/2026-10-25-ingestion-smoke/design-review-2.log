    20	def snapshot(source, before_seq):
    21	    """Records strictly before a sequence, including original FTS insertion order."""
    22	    dest = sqlite3.connect(':memory:')
    23	    dest.row_factory = sqlite3.Row
    24	    kept_views = {r['view_id'] for r in source.execute('select view_id from views where created_seq<?', (before_seq,))}
    25	    for table, schema in store.TABLES.items():
    26	        dest.execute(f'create table {table} ({schema})')
    27	        rows = source.execute(f'select * from {table} order by rowid')
    28	        for row in rows:
    29	            fields = list(row.keys())
    30	            sequence = next((f for f in ('created_seq', 'after_seq', 'seq', 'sequence_no') if f in fields), None)
    31	            if sequence and row[sequence] >= before_seq:
    32	                continue
    33	            if table == 'rungs' and row['view_id'] not in kept_views:
    34	                continue
    35	            dest.execute(f'insert into {table} ({",".join(fields)}) values ({",".join("?" for _ in fields)})', tuple(row))
    36	    for table, id_field, records in [('views_fts', 'view_id', 'views'), ('groups_fts', 'group_id', 'thesis_groups')]:
    37	        dest.execute(f'create virtual table {table} using fts5({id_field} unindexed, text, tokenize="trigram")')
    38	        kept = {r[0] for r in dest.execute(f'select {id_field} from {records}')}
    39	        for row in source.execute(f'select {id_field},text from {table} order by rowid'):
    40	            if row[0] in kept:
    41	                dest.execute(f'insert into {table} ({id_field},text) values (?,?)', tuple(row))
    42	    return dest
    43	
    44	
    45	def audit(folder, config):
    46	    uni = universe.load(str(ROOT / 'poc/universe.json'))
    47	    counts, examples, mismatches = collections.Counter(), [], []
    48	    with connect(ROOT / 'poc/data' / folder / 'views.sqlite') as source, connect(ROOT / 'poc/data' / folder / 'archive.sqlite') as archive, connect(ROOT / 'poc/data/items-window-tags2-2026-10-24.sqlite') as inputs:
    49	        meta = {r['input_id']: dict(r) for r in source.execute('select input_id,min(sequence_no) seq,min(publication_day) day from processing_steps where sequence_no>0 group by input_id')}
    50	        day_start = {}
    51	        for row in meta.values():
    52	            day_start[row['day']] = min(day_start.get(row['day'], row['seq']), row['seq'])
    53	        requests = list(archive.execute("select request_json from model_calls where config_version=? and purpose='extract' order by call_id", (config,)))
    54	        for row in requests:
    55	            original = json.loads(row[0])
    56	            input_id, day = ITEM.search(original['messages'][1]['content']).groups()
    57	            item = dict(inputs.execute('select * from items where input_id=?', (input_id,)).fetchone())
    58	            item['object_identifiers'] = json.loads(item['object_identifiers'])
    59	            objects = [o['value'] for o in item['object_identifiers'] if uni.has(o['value'])]
    60	            built = []
    61	            for seq in (meta[input_id]['seq'], day_start[day]):
    62	                db = snapshot(source, seq)
    63	                try:
    64	                    shown = store.views_for_prompt(db, objects)
    65	                    groups = store.groups_for_prompt(db, objects, item['title'] or '')
    66	                    built.append(extraction.build_prompt(item, item['text'], shown, uni, 'v10', groups))
    67	                finally:
    68	                    db.close()
    69	            saved = tuple(m['content'] for m in original['messages'])
    70	            counts['requests'] += 1
    71	            if built[0] != saved:
    72	                mismatches.append(input_id)
    73	                continue
    74	            counts['reproduced_original_request'] += 1
    75	            if built[0] != built[1]:
    76	                counts['different_at_day_start'] += 1
    77	                if len(examples) < 3:
    78	                    examples.append({'input_id': input_id, 'day': day, 'sequence': meta[input_id]['seq'], 'day_start_sequence': day_start[day]})
    79	        return {'counts': dict(counts), 'examples': examples, 'reconstruction_mismatches': mismatches}
    80	
    81	
    82	def main():
    83	    parser = argparse.ArgumentParser(description=__doc__)
    84	    parser.add_argument('--out', type=Path, required=True)
    85	    args = parser.parse_args()
    86	    results = {name: audit(*spec) for name, spec in ARMS.items()}
    87	    with args.out.open('x') as handle:
    88	        json.dump(results, handle, indent=2)
    89	    for name, result in results.items():
    90	        print(name, result['counts'], 'reconstruction mismatches', len(result['reconstruction_mismatches']))
    91	    if any(v['reconstruction_mismatches'] for v in results.values()):
    92	        raise SystemExit('historical reconstruction not exact: inspect mismatches before using the measure')
    93	
    94	
    95	if __name__ == '__main__':
    96	    main()

