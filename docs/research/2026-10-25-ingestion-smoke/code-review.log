   107	class StudyTransport:
   108	    """Shared across extraction, matching and judging; validate before freeing a slot."""
   109	
   110	    def __init__(self, guard, workers=2):
   111	        self.guard = guard
   112	        self.slots = threading.BoundedSemaphore(workers)
   113	        self.stopped = threading.Event()
   114	
   115	    def stop(self, reason):
   116	        self.guard.stop(reason)
   117	        self.stopped.set()
   118	
   119	    def __call__(self, *args):
   120	        with self.slots:
   121	            try:
   122	                response = self.guard(*args)
   123	                request = args[-1]
   124	                if len(args) == 2:
   125	                    value = json.loads(response['choices'][0]['message']['content'])
   126	                    errors = model.check_schema(value, request['response_format']['json_schema']['schema'])
   127	                else:
   128	                    errors = jev.validate(response.get('answers'), request['questions'])
   129	                if errors:
   130	                    raise model.SchemaError('; '.join(errors[:5]))
   131	                return response
   132	            except BaseException:
   133	                self.stop('terminal worker failure or cancellation')
   134	                raise
