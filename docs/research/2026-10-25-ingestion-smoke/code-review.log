   153	def audit(directory, trial, cfg, uni):
   154	    """Read actual product records and rebuild the accepted requests; never call a model."""
   155	    folder = directory / trial
   156	    errors, requests = [], []
   157	    with readonly(directory / 'ordered-baseline.sqlite') as baseline, readonly(folder / 'views.sqlite') as conn, readonly(folder / 'archive.sqlite') as archive, readonly(directory / 'items.sqlite') as source:
   158	        items = {i['input_id']: i for i in testdb.feed(source, DAY, DAY)}
   159	        for table in store.TABLES:
   160	            old = [tuple(r) for r in baseline.execute(f'select * from {table} order by rowid')]
   161	            prefix = [tuple(r) for r in conn.execute(f'select * from {table} order by rowid limit ?', (len(old),))]
   162	            if old != prefix:
   163	                errors.append(f'baseline changed: {table}')
   164	        hands = list(conn.execute('select * from handovers where seq>=? order by seq', (FIRST,)))
   165	        if [(r['input_id'], r['seq']) for r in hands] != [(i, FIRST + n) for n, i in enumerate(INPUTS)]:
   166	            errors.append('handover order/count differs')
   167	        for hand in hands:
   168	            item = items[hand['input_id']]
   169	            before = snapshot(conn, hand['seq'], exclude_unordered=True)
   170	            try:
   171	                objects = [o['value'] for o in item['object_identifiers'] if uni.has(o['value'])]
   172	                key = extraction_key(cfg, item, item['text'], store.views_for_prompt(before, objects), uni,
   173	                                     store.groups_for_prompt(before, objects, item.get('title') or ''))
   174	            finally:
   175	                before.close()
   176	            if not archive.execute("select 1 from model_calls where request_sha256=? and purpose='extract'", (key,)).fetchone():
   177	                errors.append('accepted request not rebuilt: ' + item['input_id'])
   178	            requests.append({'input_id': item['input_id'], 'seq': hand['seq'], 'request_sha256': key})
   179	            for evidence in json.loads(hand['handover_json'])['evidence']:
   180	                if extraction.normalise(evidence['quote']) not in extraction.normalise(item['text']):
   181	                    errors.append('quote missing from selected whole item')
   182	        for record in conn.execute('select * from match_records where seq>=?', (FIRST,)):
   183	            if json.loads(record['checks_json'])['refusals']:
   184	                errors.append('matching refusal')
   185	            for call in json.loads(record['shown_json']).get('requests', []):
   186	                if not archive.execute('select 1 from model_calls where call_id=? and request_sha256=?', (call['call_id'], call['request_sha256'])).fetchone():
   187	                    errors.append('matching request trace missing')
   188	        changed = rounds.changed_views_of_day(conn, DAY)
   189	        expected = {v for v in changed if store.is_open(conn, v) and store.evidence_in_force(conn, v)}
   190	        judgments = list(conn.execute('select * from judgements where seq>=?', (FIRST,)))
   191	        if sorted(r['view_id'] for r in judgments) != sorted(expected):
   192	            errors.append('daily judgement population differs')
   193	        if any(r['seq'] != FIRST + len(INPUTS) - 1 or r['input_id'] != 'day:' + DAY or r['publication_day'] != DAY for r in judgments):
   194	            errors.append('daily judgement ordering differs')
   195	        if store.last_completed_day(conn) != DAY:
   196	            errors.append('day not completed')
   197	        missing = conn.execute('select count(*) from thesis_group_members m left join views v using(view_id) left join thesis_groups g using(group_id) where v.view_id is null or g.group_id is null').fetchone()[0]
   198	        if missing:
   199	            errors.append('dangling group membership')
   200	        views = [dict(r) for r in conn.execute('select * from views order by rowid')]
   201	        groups = [dict(r) for r in conn.execute('select * from thesis_groups order by rowid')]
   202	        members = [dict(r) for r in conn.execute('select * from thesis_group_members order by rowid')]
   203	        evidence = [dict(r) for r in conn.execute('select * from evidence order by rowid')]
   204	        links = [dict(r) for r in conn.execute('select * from evidence_links order by rowid')]
   205	        sources = [dict(r) for r in conn.execute('select * from evidence_sources order by rowid')]
   206	        return {'errors': errors, 'accepted_requests': requests, 'views': views, 'groups': groups, 'members': members,
   207	                'evidence': evidence, 'links': links, 'sources': sources, 'judgements': [dict(r) for r in judgments],
   208	                'baseline_dependencies': baseline.execute('select count(*) from dependencies').fetchone()[0]}
