    31	    request = {'model': 'jev-1.14.0', 'state': '', 'questions': {'q': {}}}
    32	    reserve, max_input, _ = envelope('jev', request)
    33	    assert charge('jev', {'usage': {'input_tokens': max_input, 'output_tokens': 99}}, max_input, None) <= reserve
