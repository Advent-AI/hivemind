    41	def extraction_key(cfg, item, text, shown, universe, groups):
    42	    setting, system, user, schema = extraction.request_for(cfg, item, text, shown, universe, groups)
    43	    return model.request_identity(model.build_request(setting, system, user, schema, 'extraction', cfg.provider))[1]
