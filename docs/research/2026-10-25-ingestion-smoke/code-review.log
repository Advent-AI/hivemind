    51	def open_db(path):
    52	    os.makedirs(os.path.dirname(os.path.abspath(path)), exist_ok=True)
    53	    conn = sqlite3.connect(path)
    54	    conn.row_factory = sqlite3.Row
    55	    for name, columns in TABLES.items():
    56	        conn.execute(f'create table if not exists {name} ({columns})')
    57	        conn.execute(f"create trigger if not exists {name}_no_update before update on {name} begin select raise(abort, 'append-only'); end")
    58	        conn.execute(f"create trigger if not exists {name}_no_delete before delete on {name} begin select raise(abort, 'append-only'); end")
    59	    for statement in INDEXES:
    60	        conn.execute(statement)
    61	    ensure_writable_columns(conn)
    62	    conn.execute("create virtual table if not exists views_fts using fts5(view_id unindexed, text, tokenize='trigram')")
    63	    conn.execute("create virtual table if not exists groups_fts using fts5(group_id unindexed, text, tokenize='trigram')")
    64	    conn.execute('create index if not exists members_view on thesis_group_members(view_id)')
    65	    conn.commit()
    66	    return conn
