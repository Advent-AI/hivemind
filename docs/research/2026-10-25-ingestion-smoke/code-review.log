    45	def baseline_problems(conn):
    46	    problems = []
    47	    for table in store.TABLES:
    48	        fields = [r[1] for r in conn.execute(f'pragma table_info({table})')]
    49	        seq = next((f for f in ('created_seq', 'after_seq', 'seq', 'sequence_no') if f in fields), None)
    50	        if seq and conn.execute(f'select count(*) from {table} where {seq}=0 or {seq}>=?', (FIRST,)).fetchone()[0]:
    51	            problems.append(f'{table}: unordered or future sequence')
    52	        for date in ('publication_day', 'day'):
    53	            if date in fields and conn.execute(f'select count(*) from {table} where {date}>=?', (DAY,)).fetchone()[0]:
    54	                problems.append(f'{table}: future date')
    55	    return problems
