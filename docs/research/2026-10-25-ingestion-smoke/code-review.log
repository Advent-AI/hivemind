    20	def snapshot(source, before_seq, *, exclude_unordered=False):
    21	    """Records strictly before a sequence, including original FTS insertion order."""
    22	    dest = sqlite3.connect(':memory:')
    23	    dest.row_factory = sqlite3.Row
    24	    kept_views = {r['view_id'] for r in source.execute('select view_id from views where created_seq<?', (before_seq,))}
    25	    for table, schema in store.TABLES.items():
    26	        dest.execute(f'create table {table} ({schema})')
    27	        rows = source.execute(f'select * from {table} order by rowid')
    28	        for row in rows:
    29	            fields = list(row.keys())
    30	            sequence = next((f for f in ('created_seq', 'after_seq', 'seq', 'sequence_no') if f in fields), None)
    31	            if exclude_unordered and sequence and row[sequence] == 0:
    32	                continue
    33	            if sequence and row[sequence] >= before_seq:
    34	                continue
    35	            if table == 'rungs' and row['view_id'] not in kept_views:
    36	                continue
    37	            dest.execute(f'insert into {table} ({",".join(fields)}) values ({",".join("?" for _ in fields)})', tuple(row))
    38	    for table, id_field, records in [('views_fts', 'view_id', 'views'), ('groups_fts', 'group_id', 'thesis_groups')]:
    39	        dest.execute(f'create virtual table {table} using fts5({id_field} unindexed, text, tokenize="trigram")')
    40	        kept = {r[0] for r in dest.execute(f'select {id_field} from {records}')}
    41	        for row in source.execute(f'select {id_field},text from {table} order by rowid'):
    42	            if row[0] in kept:
    43	                dest.execute(f'insert into {table} ({id_field},text) values (?,?)', tuple(row))
    44	    return dest
