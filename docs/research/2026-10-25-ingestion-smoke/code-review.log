    32	def runtime_key():
    33	    files = sorted((ROOT / 'src/hivemind').rglob('*.py')) + sorted((ROOT / 'src/hivemind/prompts').glob('*')) + [Path(__file__)]
    34	    return model.request_identity({str(path.relative_to(ROOT)): digest(path) for path in files if path.is_file()})[1]
