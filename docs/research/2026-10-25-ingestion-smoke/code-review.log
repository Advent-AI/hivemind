    13	class BudgetError(RuntimeError):
    14	    pass
    15	
    16	
    17	def envelope(provider, request):
    18	    """Reserve documented maximum usage, without guessing tokens from characters."""
    19	    if provider == 'openai' and request.get('model') == 'gpt-6-luna':
    20	        allowed = {'model', 'messages', 'response_format', 'reasoning_effort', 'max_completion_tokens'}
    21	        if set(request) - allowed:
    22	            raise BudgetError('unreviewed OpenAI request fields')
    23	        cap = request.get('max_completion_tokens')
    24	        if type(cap) is not int or not 1 <= cap <= 128000:
    25	            raise BudgetError('unreviewed OpenAI output limit')
    26	        # Full documented input bound and the requested output bound, including
    27	        # highest reviewed Standard rates and the 10% regional premium.
    28	        reserved = (922000 * 550 + cap * 825 + 999) // 1000
    29	        return reserved, 922000, cap
    30	    if provider == 'jev' and request.get('model') == 'jev-1.14.0':
    31	        if set(request) != {'model', 'state', 'questions'} or not request['questions']:
    32	            raise BudgetError('unreviewed Jev request shape')
    33	        tokens = 65536 * (len(request['questions']) + 1)
    34	        return (tokens * 42 + 999) // 1000, tokens, None
    35	    raise BudgetError('unreviewed provider or model')
    36	
    37	
    38	def charge(provider, response, max_input, max_output):
    39	    usage = response.get('usage', {}) if isinstance(response, dict) else {}
    40	    names = ('prompt_tokens', 'completion_tokens') if provider == 'openai' else ('input_tokens', 'output_tokens')
    41	    counts = [usage.get(k) for k in names]
    42	    if any(type(n) is not int or n < 0 for n in counts) or counts[0] > max_input or (max_output is not None and counts[1] > max_output):
    43	        raise BudgetError('missing, invalid or above-envelope usage')
    44	    a, b = counts
    45	    # Integer microdollars, rounded up. OpenAI uses the highest reviewed Standard rate,
    46	    # not an estimate of a discount or the provider's eventual bill.
    47	    cost = (a * 550 + b * 825 + 999) // 1000 if provider == 'openai' else (a * 42 + 999) // 1000
    48	    return cost
    49	
