   137	def study_day(runner, transport):
   138	    def run(*args, **kwargs):
   139	        iterator = runner(*args, **kwargs)
   140	        try:
   141	            for result in iterator:
   142	                if result.failed:
   143	                    transport.stop('authoritative item failed')
   144	                yield result
   145	        except BaseException:
   146	            transport.stop('day cancelled or failed')
   147	            raise
   148	        finally:
   149	            iterator.close()
   150	    return run
