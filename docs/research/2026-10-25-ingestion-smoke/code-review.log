    23	def test_reservation_covers_maximum_documented_usage():
    24	    """Value-reader: reviewed prices and maximum context fit the reservation; units are microdollars."""
    25	    reserve, max_input, _ = envelope('openai', REQUEST)
    26	    maximum = {'usage': {'prompt_tokens': max_input, 'completion_tokens': 16000}}
    27	    assert charge('openai', reply(), max_input, 16000) == 633
