    95	    if [i['input_id'] for i in items] != list(INPUTS):
    96	        raise ValueError('selected input order differs')
    97	    with readonly(directory / 'inputs/items.sqlite') as original:
    98	        for item in items:
    99	            row = dict(original.execute('select * from items where input_id=?', (item['input_id'],)).fetchone())
   100	            row['object_identifiers'] = json.loads(row['object_identifiers'])
