   136	def single_attempt_http():
   137	    """Explicit live opt-in. Credentials are loaded once; tests supply a fake sender."""
   138	    keys = {'openai': model._key('openai'), 'jev': jev._key()}
   139	    urls = {'openai': model.ENDPOINTS['openai'][0], 'jev': jev.ENDPOINT}
   140	    if any(not isinstance(k, str) or not k for k in keys.values()):
   141	        raise BudgetError('configured provider credential missing')
   142	
   143	    def prepare(provider, body):
   144	        headers = {'Authorization': 'Bearer ' + keys[provider], 'Content-Type': 'application/json', 'Accept': 'application/json'}
   145	        data = json.dumps(body, sort_keys=True, ensure_ascii=False).encode('utf-8')
   146	        request = urllib.request.Request(urls[provider], data, headers)
   147	        def send():
   148	            try:
   149	                with urllib.request.urlopen(request, timeout=60) as reply:
   150	                    raw = reply.read()
   151	            except urllib.error.HTTPError as exc:
   152	                raise model.TransportError(f'{provider} HTTP {exc.code}; no automatic retry') from None
   153	            if any(k.encode('utf-8') in raw for k in keys.values()):
   154	                raise model.TransportError('credential in response; response not saved')
   155	            return json.loads(raw)
   156	        return send
   157	    return prepare
