   211	def run_trial(directory, trial, *, live=False, transport=None):
   212	    directory = Path(directory).resolve()
   213	    if trial not in ORDER or contract(directory) != json.loads((directory / 'study.json').read_text()):
   214	        raise ValueError('unknown trial or changed study contract')
   215	    previous = ORDER[:ORDER.index(trial)]
   216	    for name in previous:
   217	        saved = json.loads((directory / name / 'result.json').read_text())
   218	        if saved['failure'] or saved['audit']['errors']:
   219	            raise ValueError('prior trial failed')
   220	    if protected_changes(directory):
   221	        raise ValueError('protected database changed')
   222	    folder = directory / trial
   223	    if folder.exists():
   224	        raise ValueError('trial already started; preserve it')
   225	    cfg, uni = configuration()
   226	    if transport is None:
   227	        if not live:
   228	            raise ValueError('explicit offline transport or --live required')
   229	        transport = StudyTransport(GuardedTransport(directory / 'budget.sqlite', single_attempt_http(), max_calls=144))
   230	    folder.mkdir()
   231	    shutil.copyfile(directory / 'ordered-baseline.sqlite', folder / 'views.sqlite')
   232	    archive = model.Archive(folder / 'archive.sqlite')
   233	    runner = DayRunner(directory / 'items.sqlite', folder / 'manifests') if trial.startswith('concurrent') else None
   234	    before = transport.guard.summary()
   235	    old_handlers = {}
   236	    if live:
   237	        def cancel(signum, frame):
   238	            transport.stop('cancelled')
   239	            raise KeyboardInterrupt
   240	        for sig in (signal.SIGINT, signal.SIGTERM):
   241	            old_handlers[sig] = signal.signal(sig, cancel)
   242	    failed, result, inspected = None, None, None
   243	    started = time.perf_counter()
   244	    try:
   245	        result = replay.run(testdb_path=str(directory / 'items.sqlite'), views_path=str(folder / 'views.sqlite'), archive=archive,
   246	                            cfg=cfg, universe=uni, from_day=DAY, until_day=DAY, transport=transport,
   247	                            day_runner=study_day(runner, transport) if runner else None, log=lambda msg: print(msg, flush=True))
   248	        inspected = audit(directory, trial, cfg, uni)
   249	        if inspected['errors']:
   250	            raise ValueError('structural audit failed: ' + '; '.join(inspected['errors']))
   251	    except BaseException as exc:
   252	        transport.stop('trial failed')
   253	        failed = {'type': type(exc).__name__, 'message': str(exc)[:500]}
   254	        raise
   255	    finally:
   256	        elapsed = time.perf_counter() - started
   257	        for sig, handler in old_handlers.items():
   258	            signal.signal(sig, handler)
   259	        archive.conn.close()
   260	        after = transport.guard.summary()
   261	        report = {'trial': trial, 'seconds': elapsed, 'failure': failed, 'result': result, 'audit': inspected,
   262	                  'events': runner.events if runner else [], 'changed_protected': protected_changes(directory),
   263	                  'new_attempts': after['attempts'][len(before['attempts']):],
   264	                  'conservative_cost_microdollars': after['held_microdollars'] - before['held_microdollars']}
   265	        (folder / 'result.json').write_text(json.dumps(report, indent=2, ensure_ascii=False))
   266	        print(json.dumps({k: report[k] for k in ('trial', 'seconds', 'failure', 'changed_protected', 'conservative_cost_microdollars')}), flush=True)
   267	        if report['changed_protected'] and not failed:
   268	            raise ValueError('protected database changed')
   269	
   270	
   271	if __name__ == '__main__':
   272	    parser = argparse.ArgumentParser(description=__doc__)
   273	    parser.add_argument('--directory', type=Path, required=True)
   274	    parser.add_argument('--prepare', action='store_true')
   275	    parser.add_argument('--trial', choices=ORDER)
   276	    parser.add_argument('--live', action='store_true')
   277	    args = parser.parse_args()
   278	    if args.prepare:
   279	        prepare(args.directory.resolve())
   280	    elif args.trial:
   281	        run_trial(args.directory, args.trial, live=args.live)
   282	    else:
   283	        parser.error('choose --prepare or --trial')

