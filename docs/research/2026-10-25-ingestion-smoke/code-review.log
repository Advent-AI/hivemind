class Archive:
    """Shared by the extraction worker threads: one connection, every access under a lock."""

    def __init__(self, path):
        os.makedirs(os.path.dirname(os.path.abspath(path)), exist_ok=True)
        self.conn = sqlite3.connect(path, check_same_thread=False)
        self.conn.executescript(SCHEMA_SQL)
        import threading
        self.lock = threading.Lock()

    def lookup(self, sha):
        with self.lock:
            return self.conn.execute('select call_id, answer_json, prompt_chars, input_tokens, output_tokens from model_calls where request_sha256=?', (sha,)).fetchone()

    def record(self, **fields):
        """One row per distinct request; a second identical request recorded at the same moment (two threads, or a
        failed answer repeated within the same second) keeps the first row's id instead of failing."""
        columns = list(fields)
        with self.lock:
            cursor = self.conn.execute(f'insert or ignore into model_calls ({",".join(columns)}) values ({",".join("?" * len(columns))})',
                                       [fields[c] for c in columns])
            self.conn.commit()
            if cursor.rowcount == 0:
                return self.conn.execute('select call_id from model_calls where request_sha256=?', (fields['request_sha256'],)).fetchone()[0]
            return cursor.lastrowid

    def totals(self):
        with self.lock:
            return self.conn.execute('select count(*), coalesce(sum(cost_usd),0), coalesce(sum(input_tokens),0), coalesce(sum(output_tokens),0) from model_calls').fetchone()


def _key(provider):
    name = ENDPOINTS[provider][1]
    if os.environ.get(name):
        return os.environ[name]
    with open(CREDENTIALS, encoding='utf-8') as handle:
        return json.load(handle)[name]


"""The test database: the corpus items.sqlite built by poc/corpus/scripts/assemble.py, read as a stream in
publication order. This is "the team's own database" of D7: the system keeps no copy of the material, only the
processing record; an item's text is read from here when it is processed.

Order inside a day (the arrival order upstream would give): company documents (filings, transcripts, releases),
official material, then news by published_at. Only items with feed = 1 (an original, whole) or a copy of one are
streamed; the rest stay in the database for the review.
"""
import json
import sqlite3

def open_db(path):
    conn = sqlite3.connect(path)
    conn.row_factory = sqlite3.Row
    return conn


def feed(conn, from_day, until_day):
    """Yield items with from_day <= publication_day <= until_day in processing order."""
    rows = conn.execute(
        "select * from items where publication_day >= ? and publication_day <= ? and (feed = 1 or copy_of is not null) "
        "order by publication_day, case klass when '公司材料' then 0 when '官方材料' then 1 else 2 end, "
        "coalesce(published_at, ''), rowid", (from_day, until_day))
    for row in rows:
        item = dict(row)
        item['object_identifiers'] = json.loads(item.get('object_identifiers') or '[]')
        yield item


def count(conn, from_day, until_day):
    return conn.execute("select count(*) from items where publication_day >= ? and publication_day <= ? and feed = 1", (from_day, until_day)).fetchone()[0]
