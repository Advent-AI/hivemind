   182	def upstream(conn, view_id):
   183	    """Every view this one depends on, directly or through its dependencies."""
   184	    seen, stack = set(), [view_id]
   185	    while stack:
   186	        for dep in store.dependencies_of(conn, stack.pop()):
   187	            target = dep['resolved_to']
