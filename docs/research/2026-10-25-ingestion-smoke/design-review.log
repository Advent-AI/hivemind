   115	def _answers(archive, cfg, jobs, workers, transport):
   116	    """Ask independent questions; equal concurrent requests share one archived result."""
   117	    if not isinstance(workers, int) or isinstance(workers, bool) or workers < 1:
   118	        raise ValueError('Jev workers must be a positive integer')
   119	
   120	    def ask(job):
   121	        state, questions = job
   122	        return jev.ask(archive, cfg, cfg.matching, state, questions, 'match', transport=transport)
   123	
   124	    if workers == 1:
   125	        return [ask(job) if job[1] else None for job in jobs]
   126	    keys, unique, replies = [], {}, {}
   127	    for state, questions in jobs:
   128	        if not questions:
   129	            keys.append(None)
   130	            continue
   131	        _, key = model.request_identity(jev.request_for(cfg.matching, state, questions))
   132	        keys.append(key)
   133	        if key not in unique:
   134	            unique[key] = (state, copy.deepcopy(questions))
   135	    waiting, active = iter(unique.items()), {}
   136	    pool = concurrent.futures.ThreadPoolExecutor(max_workers=workers)
   137	    try:
   138	        def fill():
   139	            while len(active) < workers:
   140	                next_job = next(waiting, None)
   141	                if next_job is None:
   142	                    break
   143	                key, job = next_job
   144	                active[pool.submit(ask, job)] = key
   145	        fill()
   146	        while active:
   147	            concurrent.futures.wait(active, return_when=concurrent.futures.FIRST_COMPLETED)
   148	            completed = [future for future in active if future.done()]
   149	            # Check the whole completed set before submitting any replacement work.
   150	            for future in completed:
   151	                future.result()
   152	            for future in completed:
   153	                replies[active.pop(future)] = future.result()
   154	            fill()
   155	    finally:
   156	        for future in active:
   157	            future.cancel()
   158	        pool.shutdown(wait=True, cancel_futures=True)
   159	    results, used = [], set()
   160	    for key in keys:
   161	        if key is None:
   162	            results.append(None)
   163	            continue
   164	        answer = replies[key]
   165	        # A later logical use is exactly what a serial archive lookup would return.
   166	        results.append(dataclasses.replace(answer, cached=True, cost_usd=0.0) if key in used else answer)
   167	        used.add(key)
   168	    return results
