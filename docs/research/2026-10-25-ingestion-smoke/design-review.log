    49	def topological(conn, view_ids):
    50	    """Dependencies first: a view comes after every view it depends on that is also in the set."""
    51	    remaining = list(dict.fromkeys(view_ids))
    52	    ordered, placed = [], set()
    53	    while remaining:
    54	        progressed = False
    55	        for view_id in list(remaining):
    56	            deps = {d['resolved_to'] for d in store.dependencies_of(conn, view_id) if d['resolved_to']}
    57	            if deps.isdisjoint(set(remaining) - {view_id}) or deps <= placed:
    58	                ordered.append(view_id)
    59	                placed.add(view_id)
    60	                remaining.remove(view_id)
    61	                progressed = True
    62	        if not progressed:                 # a cycle slipped through: keep going in the given order
    63	            ordered.extend(remaining)
    64	            break
    65	    return ordered
