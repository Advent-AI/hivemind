   144	def check_answer(conn, view_id, data):
   145	    errors = []
   146	    in_force = {p['evidence_id'] for p in store.evidence_in_force(conn, view_id)}
   147	    deps = {d['resolved_to'] for d in store.dependencies_of(conn, view_id) if d['resolved_to']}
   148	    rungs = store.rungs_of(conn, view_id)
   149	    if not 1 <= data['rung'] <= len(rungs):
   150	        errors.append(f'rung {data["rung"]} outside 1..{len(rungs)}')
   151	    for cited in data['cites']:
   152	        if cited not in in_force:
   153	            errors.append(f'{cited} is not evidence in force under {view_id}' + (' (replaced)' if store.is_replaced(conn, cited) else ''))
   154	    for cited in data['cites_views']:
   155	        if cited not in deps:
   156	            errors.append(f'{cited} is not a dependency of {view_id}')
   157	    for push in data['pushes']:
   158	        if push['evidence_id'] not in in_force:
   159	            errors.append(f'push on {push["evidence_id"]} which is not under {view_id}')
   160	    last = store.current_state(conn, view_id)
   161	    if last is None and not data['changed']:
   162	        errors.append('first judgement must say changed')
   163	    if last is not None and last['rung'] != data['rung'] and not data['changed']:
   164	        errors.append(f'rung moved from {last["rung"]} to {data["rung"]} but changed is false')
