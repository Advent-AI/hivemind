    72	def judge_day(conn, archive, cfg, day, seq, *, transport=None, log=print):
    73	    """D63: one re-judging round per day over every open view whose reading changed that day, dependencies first,
    74	    recorded under the day's own processing record (input 'day:<date>'); a view already judged at this sequence
    75	    number (a resumed day) is not judged twice."""
