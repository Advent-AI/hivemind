    35	def _match(conn, archive, cfg, universe, item, seq, result, candidates, evidence, lists, shown, *, extra_views=(), call_offset=0, transport=None, workers=1):
    36	    """One matching call with one retry on a refused check. Returns Checked, or None after marking the failure."""
    37	    note = ''
    38	    checked = None
    39	    engine = jev_matching if cfg.matching.engine == 'jev' else matching      # Jev answers once; a retry would be the same answer
    40	    for attempt in range(1 if engine is jev_matching else 2):
    41	        try:
    42	            options = {'workers': workers} if engine is jev_matching else {}
    43	            answer = engine.decide(archive, cfg, conn, item, candidates, evidence, lists, shown, extra_views=extra_views, retry_note=note, transport=transport, **options)
    44	        except Exception as error:
    45	            _fail(conn, item, seq, result, 'matched', 'matching_failed', 'matching: ' + repr(error), type(error).__name__)
    46	            return None
    47	        result.cost += answer.cost_usd
    48	        result.cached_calls += int(answer.cached)
