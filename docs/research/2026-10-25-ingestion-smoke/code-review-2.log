def build_prompt(item, text, shown_views, universe, version='v1', shown_groups=()):
    """The five blocks of 05-extraction: role; this category and how to read it; who it is about plus the list's
    themes; what to read out; the objects' existing views with who depends on whom (no state, no evidence)."""
    category = item['category']
    categories = _categories(version)
    blocks = categories.get(category) or categories['T7']
    objects = [o['value'] for o in item.get('object_identifiers') or []]
    system = _read(f'role-{version}.txt')
    if is_english(version):
        return system, _build_prompt_english(item, text, shown_views, universe, version, category, blocks, objects, shown_groups)
    return system, _build_prompt_chinese(item, text, shown_views, universe, version, category, blocks, objects)


OBJECT_LABELS = vocabulary.ASSET_LABELS


def check_ladder(rungs, kind):
    """None when the ladder is well formed, else the problem. An asset ladder written from Strongly bearish up to
    Strongly bullish (the model often orders a revenue ladder by rising value) is the same ladder; normalise_ladder
    turns it round. Labels are compared in the canonical vocabulary."""
    if len(rungs) not in (2, 5):
        return f'ladder has {len(rungs)} rungs, needs 5 (or 2 for yes/no)'
    if any(not r['label'].strip() or not r['condition'].strip() for r in rungs):
        return 'a rung has an empty label or condition'
    if kind == 'asset' and len(rungs) == 5:
        labels = [vocabulary.canonical('label', r['label']) for r in rungs]
        if labels != OBJECT_LABELS and labels != OBJECT_LABELS[::-1]:
            return f'object view rungs must be {OBJECT_LABELS}, got {labels}'
    return None


def normalise_ladder(rungs, kind):
    """Position 1 is Strongly bullish (06-views): a reversed asset ladder is turned round, label and condition together."""
    if kind == 'asset' and len(rungs) == 5 and [vocabulary.canonical('label', r['label']) for r in rungs] == OBJECT_LABELS[::-1]:
        return list(reversed(rungs))
    return rungs


# 06-views ladder rule 6: a quarterly or half-year figure is evidence, not a view. The half-year forms name a revenue
# or sales figure (H1 收入, first-half revenue); an event scheduled in a half-year (ships in H2 2026) is not a figure.
QUARTERLY = re.compile(r'(\bQ[1-4]\b|第[一二三四1-4]季|季度|\bquarter(?!ly report)|fiscal Q[1-4]|\b(?:[12]H|H[12])\b(?:\s+(?:FY)?\d{4})?\s*收入|上半年收入|下半年收入'
                       r'|\b(?:[12]H|H[12])\b(?:\s+(?:FY)?\d{4})?\s+(?:revenue|sales|net sales)|\b(?:first|second)[- ]half(?:[- ]year)?\s+(?:revenue|sales|net sales)'
                       r'|\bhalf[- ]year\s+(?:revenue|sales|net sales))', re.I)


def request_for(cfg, item, text, shown_views, universe, shown_groups=()):
    """Build the setting, complete prompt and schema without making a call."""
    setting = cfg.extraction_setting(item['category'])
    version = setting.prompt_version.rpartition('-')[2]
    system, user = build_prompt(item, text, shown_views, universe, version, shown_groups)
    group_ids = [g['group_id'] for g in shown_groups]
    return setting, system, user, schema_for(version, group_ids)


def extract(archive, cfg, item, text, shown_views, universe, *, shown_groups=(), transport=None):
    setting, system, user, schema = request_for(cfg, item, text, shown_views, universe, shown_groups)
    version = setting.prompt_version.rpartition('-')[2]
    group_ids = [g['group_id'] for g in shown_groups]
    answer = model.call(archive, cfg, setting, system, user, schema, 'extraction', 'extract', transport=transport)
    evidence, candidates, dropped, new_groups = sift_with_groups(answer.data, item, text, {v['view_id'] for v in shown_views}, universe, english=is_english(version), shown_group_ids=group_ids)
    return Handover(evidence, candidates, dropped, answer.call_id, answer.request_sha256, answer.cached, answer.cost_usd, new_groups)


def check_bounds(rungs):
    """None when the rungs' numeric bounds form one unbroken partition (or none carries bounds), else the problem."""
    bounded = [r for r in rungs if r.get('lo') is not None or r.get('hi') is not None]
    if not bounded:
        return None
    if len(bounded) != len(rungs):
        return 'some rungs carry bounds and some do not'
    ordered = sorted(rungs, key=lambda r: -1e300 if r.get('lo') is None else float(r['lo']))
    for a, b in zip(ordered, ordered[1:]):
        if a.get('hi') is None or b.get('lo') is None or float(a['hi']) != float(b['lo']):
            return 'rung bounds overlap or leave a gap'
    if ordered[-1].get('hi') is not None:
        return 'the top rung must be open above'
    return None


def check_group_refs(c, shown_group_ids, declared):
    """None when a candidate's research-group references are well formed: no repeats, each a shown group id or a declared
    local id; empty is allowed (a company's own financial line belongs to the company, not to a group); else the problem."""
    refs = c.get('group_refs')
    if refs is None:
        return None                     # a version before groups
    if len(refs) != len(set(refs)):
        return 'group_refs repeats a group'
    unknown = [r for r in refs if r not in shown_group_ids and r not in declared]
    if unknown:
        return f'group_refs cites a group neither shown nor declared: {unknown}'
    return None


def sift_with_groups(data, item, text, shown_ids, universe=None, english=False, shown_group_ids=()):
    """sift, plus the research-group declarations (D149): candidates with bad references are dropped; a declared group is
    kept only when a kept candidate cites it (an unused declaration is ignored, D147). Returns (evidence, candidates, dropped, new_groups)."""
    declared = {}
    for g in data.get('new_groups', []) or []:
        if g['id'] in declared or not g['name'].strip() or not g['scope'].strip():
            declared = None
            break
        declared[g['id']] = {'id': g['id'], 'name': g['name'].strip(), 'scope': g['scope'].strip(), 'aliases': [a.strip() for a in g.get('aliases') or [] if a.strip()]}
    dropped_refs = []
    if declared is None:         # malformed declarations: every candidate citing a local id is dropped, shown ids still work
        declared = {}
    checked = dict(data, candidates=[])
    for c in data.get('candidates', []):
        problem = check_group_refs(c, set(shown_group_ids), declared)
        if problem:
            dropped_refs.append((c['id'], f'candidate group: {problem}'))
            continue
        checked['candidates'].append(c)
    evidence, candidates, dropped = sift(checked, item, text, shown_ids, universe, english=english)
    used = {r for c in candidates for r in c.get('group_refs', [])}
    return evidence, candidates, dropped_refs + dropped, [declared[g] for g in declared if g in used]


def sift(data, item, text, shown_ids, universe=None, english=False):
    """05-extraction step 3, the code checks on one answer: ladders, the quarter and year rules, due days, quotes in
    the text, links to shown views or kept candidates, one piece per sentence. Returns (evidence, candidates,
    dropped); the preflight runs it over every stored answer. The answer is read in the canonical vocabulary,
    whichever prompt version wrote it; english says which version's year contract applies (a bare year is a calendar
    year under the English versions, the company's fiscal year under the Chinese ones)."""
    data = vocabulary.extraction_answer(data)
    body = normalise(text)
    dropped = []
    candidates = []
    candidate_ids = set()
    for c in data.get('candidates', []):
        problem = check_ladder(c['rungs'], c['kind'])
        if problem:
            dropped.append((c['id'], f'candidate ladder: {problem}'))
            continue
        c = dict(c, rungs=normalise_ladder(c['rungs'], c['kind']))
        if QUARTERLY.search(c['looks_at'] + ' ' + c['question']) and c['kind'] == 'asset':
            dropped.append((c['id'], 'quarterly number: evidence, not a view (06-views ladder rule 6)'))
            continue
        year_match = re.search(r'(\d{4})', c['year'] or '')
        if c.get('measure') not in ('event', 'policy_event') and year_match and int(year_match.group(1)) > int(item['publication_day'][:4]) + 1:
            dropped.append((c['id'], f'year {c["year"]} is beyond next year: not opened (06-views 不开)'))
            continue
        if not re.match(r'\d{4}-\d{2}-\d{2}$', c['due_day']):
            dropped.append((c['id'], f'due_day not a date: {c["due_day"]!r}'))
            continue
        if c['due_day'] <= item['publication_day']:
            dropped.append((c['id'], f'due_day {c["due_day"]} not after the item'))
            continue
        if c.get('measure'):          # keyed candidates keep their actual scope; reference lists do not gate admission (D155)
            problem = check_bounds(c['rungs'])
            if problem:
                dropped.append((c['id'], f'candidate ladder bounds: {problem}'))
                continue
            if universe is not None:
                object_id = universe.resolve(c['object']) or c['object']
                scope, source = universe.scope_and_source(object_id, c['measure'], c.get('scope', ''), c.get('event_type', 'n/a'))
                c = dict(c, object=object_id, scope=scope, scope_source=source, key_version=2)
                if c['measure'] not in ('event', 'policy_event'):
                    period = universe.fiscal_period(object_id, c.get('year', ''), bare_is_calendar=english)                             # and the period of a yearly number
                    if period:
                        c = dict(c, period_start=period[0], period_end=period[1])
            try:
                start = datetime.date.fromisoformat(c['period_start'])
                end = datetime.date.fromisoformat(c['period_end'])
                if start > end:
                    raise ValueError('start after end')
            except (KeyError, ValueError):
                dropped.append((c['id'], 'invalid period: expected real dates with start <= end'))
                continue
        candidates.append(c)
        candidate_ids.add(c['id'])
    evidence = []
    kept_ids = set()
    by_quote = {}
    alias = {}
    for e in data.get('evidence', []):
        quote = normalise(e['quote'])
        if len(quote) < 8 or quote not in body:
            dropped.append((e['id'], 'quote not in item'))
            continue
        links = [l for l in e['links'] if l in shown_ids or l in candidate_ids]
        if not links:
            dropped.append((e['id'], f'links to nothing shown: {e["links"]}'))
            continue
        if quote in by_quote:            # the same sentence read out twice is one piece with both links
            first = by_quote[quote]
            first['links'].extend(l for l in links if l not in first['links'])
            alias[e['id']] = first['id']
            dropped.append((e['id'], f'same quote as {first["id"]}; merged'))
            continue
        e = dict(e, links=links)
        by_quote[quote] = e
        evidence.append(e)
        kept_ids.add(e['id'])
    final_candidates = []
    for c in candidates:
        ids = list(dict.fromkeys(alias.get(i, i) for i in c['evidence_ids'] if alias.get(i, i) in kept_ids))
        if not ids and item.get('publisher_type') != SELF_PUBLISHER_TYPE:
            dropped.append((c['id'], 'candidate without surviving evidence'))
            continue
        final_candidates.append(dict(c, evidence_ids=ids))
    for e in evidence:
        e['links'] = [l for l in e['links'] if l in shown_ids or any(c['id'] == l for c in final_candidates)]
"""The views database (docs/prd/06-views.md): append-only tables for views, rungs, judgements, evidence, links,
replacements, dependencies, successions, match records, processing steps and the review pool; a trigram
full-text index over the views for the matching lists; the queries the other modules read.

Every table refuses UPDATE and DELETE (triggers). Progress and counts are rows, never updates. There is no item
text here: evidence holds the quoted sentence and the one-line restatement only.
"""
import json
import os
import re
import sqlite3

TABLES = {
    'views': 'view_id text primary key, object_id text, object_kind text, kind text, looks_at text, question text, due_day text, year text, created_seq integer, created_from_input text, created_at text',
    'rungs': 'view_id text, position integer, label text, condition text, lo real, hi real',
    'view_keys': 'view_id text primary key, measure text, scope text, scope_key text, period_start text, period_end text, basis text, unit text, event_type text, seq integer, scope_source text, key_version integer',
    'view_switches': 'id integer primary key autoincrement, view_id text, open integer, reason text, by_whom text, after_seq integer',
    'judgements': 'judgement_id integer primary key autoincrement, view_id text, seq integer, input_id text, rung integer, reasons text, cited_evidence_json text, cited_views_json text, pushes_json text, changed integer, why_changed text, config_checksum text, call_id integer, request_sha256 text, publication_day text',
    'evidence': 'evidence_id text primary key, quote text, one_line text, speaker text, original_who text, original_day text, tier text, event_time text, created_seq integer, created_from_input text',
    'evidence_sources': 'id integer primary key autoincrement, evidence_id text, input_id text, category text, publication_day text, location text, seq integer',
    'evidence_links': 'id integer primary key autoincrement, evidence_id text, view_id text, seq integer',
    'replacements': 'id integer primary key autoincrement, old_evidence_id text, new_evidence_id text, said_day text, seq integer',
    'dependencies': 'dependency_id integer primary key autoincrement, view_id text, depends_on text, wait_chain_view_id text, wait_year text, direction text, seq integer',
    'dependency_resolutions': 'id integer primary key autoincrement, dependency_id integer, resolved_to text, reason text, seq integer',
    'successions': 'id integer primary key autoincrement, view_id text, succeeds text, seq integer',
    'handovers': 'id integer primary key autoincrement, input_id text, seq integer, handover_json text',
    'match_records': 'id integer primary key autoincrement, seq integer, input_id text, call_no integer, shown_json text, request_sha256 text, call_id integer, decisions_json text, checks_json text, written_json text',
    'processing_steps': 'id integer primary key autoincrement, input_id text, sequence_no integer, step text, result text, reason text, publication_day text, at text',
    'review_pool_entries': 'id integer primary key autoincrement, kind text, key text, example_json text, seq integer',
    'late_statements': 'id integer primary key autoincrement, input_id text, evidence_quote text, reason text, seq integer',
    'days_completed': 'id integer primary key autoincrement, day text, seq integer, at text',
    # D149 research groups: an ongoing business subject several distinct theses belong to; membership is decided by extraction and written with the thesis
    'thesis_groups': 'group_id text primary key, name text, scope text, aliases text, created_seq integer, created_from_input text',
    'thesis_group_members': 'id integer primary key autoincrement, group_id text, view_id text, seq integer, input_id text, basis text',
}

INDEXES = [
    'create index if not exists views_object on views(object_id)',
    'create index if not exists judgements_view on judgements(view_id, judgement_id)',
    # 06-views step 7: a view is judged once per round (one item = one sequence number)
    'create unique index if not exists judgements_once_per_round on judgements(view_id, seq)',
    'create index if not exists links_view on evidence_links(view_id)',
    'create index if not exists links_evidence on evidence_links(evidence_id)',
    'create index if not exists sources_evidence on evidence_sources(evidence_id)',
    'create index if not exists steps_input on processing_steps(input_id, id)',
    'create index if not exists switches_view on view_switches(view_id, id)',
    'create index if not exists deps_view on dependencies(view_id)',
]


def open_db(path):
    os.makedirs(os.path.dirname(os.path.abspath(path)), exist_ok=True)
    conn = sqlite3.connect(path)
    conn.row_factory = sqlite3.Row
    for name, columns in TABLES.items():
        conn.execute(f'create table if not exists {name} ({columns})')
        conn.execute(f"create trigger if not exists {name}_no_update before update on {name} begin select raise(abort, 'append-only'); end")
        conn.execute(f"create trigger if not exists {name}_no_delete before delete on {name} begin select raise(abort, 'append-only'); end")
    for statement in INDEXES:
        conn.execute(statement)
    ensure_writable_columns(conn)
    conn.execute("create virtual table if not exists views_fts using fts5(view_id unindexed, text, tokenize='trigram')")
    conn.execute("create virtual table if not exists groups_fts using fts5(group_id unindexed, text, tokenize='trigram')")
    conn.execute('create index if not exists members_view on thesis_group_members(view_id)')
    conn.commit()
    return conn


def insert(conn, table, **fields):
    columns = list(fields)
    cursor = conn.execute(f'insert into {table} ({",".join(columns)}) values ({",".join("?" * len(columns))})', [fields[c] for c in columns])
    return cursor.lastrowid


# ---------- views ----------

def create_view(conn, *, view_id, object_id, object_kind, kind, looks_at, question, due_day, year, rungs, seq, input_id, created_at):
    insert(conn, 'views', view_id=view_id, object_id=object_id, object_kind=object_kind, kind=kind, looks_at=looks_at,
           question=question, due_day=due_day, year=year, created_seq=seq, created_from_input=input_id, created_at=created_at)
    for position, rung in enumerate(rungs, start=1):
        insert(conn, 'rungs', view_id=view_id, position=position, label=rung['label'], condition=rung['condition'], lo=rung.get('lo'), hi=rung.get('hi'))
    insert(conn, 'view_switches', view_id=view_id, open=1, reason='created', by_whom='matching', after_seq=seq)
    conn.execute('insert into views_fts (view_id, text) values (?, ?)', (view_id, f'{object_id} {looks_at} {question}'))


def view(conn, view_id):
    row = conn.execute('select * from views where view_id=?', (view_id,)).fetchone()
    return dict(row) if row else None


def rungs_of(conn, view_id):
    """The rungs with their bounds when the ledger has them (keyed views); a ledger written before keys has no lo/hi columns."""
    rows = [dict(r) for r in conn.execute('select * from rungs where view_id=? order by position', (view_id,))]
    has_bounds = any(r.get('lo') is not None or r.get('hi') is not None for r in rows) or view_key(conn, view_id) is not None
    return [dict(position=r['position'], label=r['label'], condition=r['condition'],
                 **({'lo': r.get('lo'), 'hi': r.get('hi')} if has_bounds else {})) for r in rows]


def add_key(conn, view_id, key, seq):
    """The view's key (keyed-views-plan.md 2.1), written once with the view."""
    from .. import universe as _universe
    insert(conn, 'view_keys', view_id=view_id, measure=key['measure'], scope=key.get('scope', ''), scope_key=_universe.scope_key(key.get('scope', '')),
           period_start=key.get('period_start', ''), period_end=key.get('period_end', ''), basis=key.get('basis', 'n/a'), unit=key.get('unit', 'n/a'),
           event_type=key.get('event_type', 'n/a'), seq=seq, scope_source=key.get('scope_source', 'model'), key_version=key.get('key_version'))


def ensure_key_columns(conn):
    """A keyed ledger written before `scope_source` gains the column (append-only forbids updates, not new columns); its
    earlier keys read as model-owned scopes unless the scope is empty."""
    columns = [r[1] for r in conn.execute('pragma table_info(view_keys)')]
    if columns and 'scope_source' not in columns:
        conn.execute('alter table view_keys add column scope_source text')
    if columns and 'key_version' not in columns:
        conn.execute('alter table view_keys add column key_version integer')


def ensure_group_tables(conn):
    """A ledger written before research groups (D165) gains the group tables at its first write; nothing else changes."""
    for name in ('thesis_groups', 'thesis_group_members'):
        conn.execute(f'create table if not exists {name} ({TABLES[name]})')
"""Replay the test database through the pipeline day by day with no look-ahead.

For every calendar day from from_day to until_day: route each item published that day (dispatch), run its round
(extraction → matching → writing), then the day's one re-judging round over the views whose reading changed (D63),
then pull mode for that day. A guard refuses an item whose
publication day is after the replay day. The views database refuses to run a day at or before the last day it
completed (no backdating). After day0's pull the views database is copied to <views>.day0.sqlite for the agent
layer. Every day prints one line and the archive's cumulative cost."""
import datetime
import shutil
import time

from . import dispatch, pull, testdb
from .views import round as round_module, store


class StaleHandoverError(RuntimeError):
    """A saved parallel extraction cannot establish that it read its predecessors."""


def refuse_unfinished_parallel(conn):
    """D159: preserve old handovers, but never resume a day-start read as a sequential read."""
    pending = conn.execute("""select p.input_id, p.reason from processing_steps p
        where p.step='extracted' and p.result='ok'
        and p.id=(select max(q.id) from processing_steps q
                  where q.input_id=p.input_id and q.step='extracted' and q.result='ok')
        and not exists (select 1 from processing_steps q
                        where q.input_id=p.input_id and q.step='handed_over' and q.result='ok')
        order by p.sequence_no""")
    ids = [row['input_id'] for row in pending if row['reason'].endswith(' (parallel)')]
    if ids:
        raise StaleHandoverError('unfinished day-start extractions; keep this ledger and replay into a new one: ' + ', '.join(ids))


class LookAheadError(RuntimeError):
    pass


class BackdatingError(RuntimeError):
    pass


def calendar_days(from_day, until_day):
    day = datetime.date.fromisoformat(from_day)
    last = datetime.date.fromisoformat(until_day)
    while day <= last:
        yield day.isoformat()
        day += datetime.timedelta(days=1)


def run(*, testdb_path, views_path, archive, cfg, universe, from_day, until_day, day0=None, spend_cap_usd=None,
        transport=None, log=print, only_objects=None, max_items_per_day=None, day_runner=None):
    items_db = testdb.open_db(testdb_path)
    conn = store.open_db(views_path)
    refuse_unfinished_parallel(conn)
    last_done = store.last_completed_day(conn)
    start = from_day
    if last_done and from_day <= last_done:
        next_day = (datetime.date.fromisoformat(last_done) + datetime.timedelta(days=1)).isoformat()
        if next_day > until_day:
            raise BackdatingError(f'views database already completed {last_done}; nothing to run before it')
        log(f'resuming after the last completed day {last_done}')
        start = next_day
    last_written = conn.execute('select max(publication_day) from processing_steps where sequence_no > 0').fetchone()[0]
    if last_written and start < last_written:
        raise BackdatingError(f'views database already holds rounds of {last_written}; a replay cannot start before it (D31)')
    totals = {'items': 0, 'extracted': 0, 'skipped': 0, 'merged': 0, 'not_processed': 0, 'returned': 0, 'failed': 0,
              'evidence': 0, 'new_views': 0, 'judged': 0, 'changed': 0, 'closed': 0}
    calls_before, cost_before, *_ = archive.totals()
    for day in calendar_days(start, until_day):
        day_stats = {k: 0 for k in totals}
        day_cost_before = archive.totals()[1]
        processed = 0
        to_run = []
        for item in testdb.feed(items_db, day, day):
            if item['publication_day'] > day:
                raise LookAheadError(f'{item["input_id"]} is dated {item["publication_day"]}, after replay day {day}')
            if only_objects and not any(o['value'] in only_objects for o in item['object_identifiers']):
                continue
            if max_items_per_day and processed >= max_items_per_day:
                break
            day_stats['items'] += 1
            route = dispatch.route(conn, item, universe)
            if route.kind != 'extract':
                day_stats[route.kind] += 1
                if route.kind == 'merged':
                    dispatch.mark(conn, item, 0, 'merged', 'ok', route.reason)
                    conn.commit()
                continue
            processed += 1
            to_run.append((item, route))
        results = (day_runner(conn, archive, cfg, universe, to_run, day=day, transport=transport, log=log) if day_runner else
                   (round_module.run(conn, archive, cfg, universe, item, route.sequence_no, resume_from=route.resume_from, transport=transport, log=log)
                    for item, route in to_run))
        finished = 0
        try:
            for index, result in enumerate(results):
                if index >= len(to_run) or result.input_id != to_run[index][0]['input_id']:
                    raise RuntimeError('day runner returned results out of input order')
                finished += 1
                day_stats['extracted'] += 1
                day_stats['evidence'] += result.evidence
                day_stats['new_views'] += result.new_views
                day_stats['judged'] += result.judged
                day_stats['changed'] += result.changed
                if result.failed:
                    day_stats['failed'] += 1
                    log(f'  ! {result.input_id[:60]}: {result.failed}')
                    raise RuntimeError(f'item failed; day {day} remains resumable: {result.failed}')
                if spend_cap_usd is not None and archive.totals()[1] - cost_before > spend_cap_usd:
                    raise RuntimeError(f'spend cap {spend_cap_usd} reached on {day}')
        finally:
            if hasattr(results, 'close'):
                results.close()
        if finished != len(to_run):
            raise RuntimeError('day runner did not complete every routed item')
        seq = store.next_sequence(conn) - 1
        judged = round_module.judge_day(conn, archive, cfg, day, seq, transport=transport, log=log)
        day_stats['judged'] += judged.judged
        day_stats['changed'] += judged.changed
        if judged.failed:
            day_stats['failed'] += 1
            log(f'  ! day judging: {judged.failed}')
            raise RuntimeError(f'judging failed; day {day} remains resumable: {judged.failed}')
        closed = pull.end_of_day(conn, day, seq)
        day_stats['closed'] = len(closed)
        store.complete_day(conn, day, seq, time.strftime('%Y-%m-%dT%H:%M:%S'))
        conn.commit()
        for key in totals:
            totals[key] += day_stats[key]
        calls, cost, _, _ = archive.totals()
        day_cost = cost - day_cost_before  # Includes discarded speculative calls and repaired refusals.
        open_count = len(store.open_views(conn))
        log(f'{day} | items {day_stats["items"]:3d} extracted {day_stats["extracted"]:3d} merged {day_stats["merged"]:2d} skipped {day_stats["not_processed"]:2d} '
            f'failed {day_stats["failed"]:2d} | evidence {day_stats["evidence"]:3d} new views {day_stats["new_views"]:2d} judged {day_stats["judged"]:3d} '
            f'changed {day_stats["changed"]:3d} closed {len(closed)} | open views {open_count} | day ${day_cost:.2f} total ${cost - cost_before:.2f} calls {calls - calls_before}')
        if day0 and day == day0:
            conn.commit()
            shutil.copy(views_path, views_path + '.day0.sqlite')
            log(f'day 0 snapshot written: {views_path}.day0.sqlite')
    return totals

