            future.cancel()
            self.events.append({'input_id': item['input_id'], 'event': 'stale', 'before': prior_key, 'request': current_key})
            answer = extraction.extract(current_archive, current_cfg, item, text, shown, current_universe,
                                        shown_groups=shown_groups, transport=transport)
            validate_inputs()
            return answer

        try:
            fill()
