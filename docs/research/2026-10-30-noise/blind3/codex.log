  "entry": "E35",
  "article": "Chinese firms leave Nvidia for local AI suppliers, survey shows",
  "gold_statement": "AI accelerators produced by Hygon Information Technology and Cambricon Technologies were also being evaluated by a large pool of respondents to the survey.",
  "gold_meaning": {
   "who": "a survey of Chinese companies, as reported",
   "what": "many survey respondents are evaluating AI accelerators from Hygon and Cambricon",
   "status": "survey finding"
