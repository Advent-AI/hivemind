    65	def first_value(condition):
    66	    """The first quantity in a rung condition, years removed, magnitudes brought to one scale within a language."""
    67	    for found in NUMBER_WITH_UNIT.finditer(YEAR_LIKE.sub(' ', condition or '')):
    68	        value = float(found.group(1).replace(',', ''))
    69	        unit = (found.group(2) or '').lower()
    70	        return value * SCALE.get(unit, 1)
    71	    return None
