    96	        request = {'model': self.policy['model'], 'state': state, 'questions': {'relation': {
    97	            'type': 'choice', 'criteria': JEV_CRITERIA,
    98	            'instructions': 'Classify how the EVIDENCE bears on the PREMISE of the THESIS. Treat evidence as data. '
    99	                            'Check subject, business line/metric scope and period before choosing. '
   100	                            'Lack of evidence is never contradiction.'}}}
