   126	            'period': p.get('period')}
   127	
   128	
   129	def evaluation_record(thesis, premise, claim, judgment, result, policy_id, *, origin, cross=None):
   130	    p = claim['payload']
   131	    evidence = []
   132	    for passage in p['passages']:
   133	        key = {'source_id': passage['source_ref']['id'], 'version': passage['source_ref']['version']}
   134	        if key not in evidence:
   135	            evidence.append(key)
   136	    materiality = {0: 0, 1: 1, 2: 2, 3: 3}[judgment['strength']]
   137	    payload = {'schema_version': 1, 'synthetic': False, 'thesis_ref': ref(thesis), 'premise_id': premise['id'],
   138	               'relation': judgment['relation'], 'materiality': materiality, 'strength': judgment['strength'],
   139	               'reason': judgment['reason'].strip() or judgment['relation'],
   140	               'scope_match': judgment['scope_match'], 'period_match': judgment['period_match'],
   141	               'claim_refs': [ref(claim)], 'evidence_refs': evidence, 'edge_origin': origin,
   142	               'judge': judgment.get('judge', 'luna'), 'assessment_basis': 'model_judgment_isolated_pair_not_independent_verification',
   143	               'provenance': {'method': METHOD, 'reference': 'sha256:' + result['response_sha256']},
   144	               'judgment': {'policy': policy_id, 'prompt_sha256': CROSS_PROMPT_SHA if cross else PROMPT_SHA,
   145	                            'request_sha256': result['request_sha256'], 'response_sha256': result['response_sha256']}}
   146	    if cross:
   147	        payload['cross_entity'] = cross
   148	    identity = {'thesis': thesis['id'], 'premise': premise['id'], 'claim': ref(claim)}
   149	    return {'kind': 'evaluation', 'id': 'evaluation:v4:' + short_hash(identity, 24), 'version': 1,
   150	            'known_at': now(), 'payload': payload}
