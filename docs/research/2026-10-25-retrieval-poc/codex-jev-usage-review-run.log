    57	def validate_answers(response,request):
    58	    """The answers of a Jev response, checked against the request's questions (labels, distributions, choice
    59	    and score consistency); ModelError otherwise.
    60	    """
    61	    if not isinstance(response,dict) or response.get('model')!='jev-1.13.0':
    62	        raise ModelError('Jev response model mismatch')
    63	    answers=response.get('answers')
    64	    if not isinstance(answers,dict) or set(answers)!=set(request['questions']):
    65	        raise ModelError('Jev answer set mismatch')
    66	    def number(x):
    67	        if type(x) not in (float,int) or not math.isfinite(x):raise ModelError('invalid Jev numeric answer')
    68	        return x
    69	    for key,q in request['questions'].items():
    70	        a=answers[key]
    71	        if not isinstance(a,dict) or a.get('type')!=q['type']:raise ModelError('Jev answer type mismatch')
    72	        if q['type']=='noul':
    73	            if not 0 <= number(a.get('noul')) <= 1:raise ModelError('invalid noul range')
    74	            continue
    75	        if q['type'] not in {'choice','score'}:raise ModelError('unsupported Jev type')
    76	        labels=set(q['criteria']) if q['type']=='choice' else {str(i) for i in range(len(q['criteria']))}
    77	        probs=a.get('probabilities')
    78	        if not isinstance(probs,dict) or set(probs)!=labels:raise ModelError('Jev probability labels mismatch')
    79	        # Observed API probabilities/score are independently rounded to 2 decimals.
    80	        # Bound the total quantization error; preserve raw values, never normalize
    81	        # them silently or demand impossible exact floating-point equality.
    82	        if any(not 0 <= number(v) <= 1 for v in probs.values()) or abs(sum(probs.values())-1)>0.005*len(labels)+1e-9:
    83	            raise ModelError('invalid Jev distribution')
    84	        if not 0 <= number(a.get('confidence')) <= 1:raise ModelError('invalid Jev confidence')
    85	        if q['type']=='choice':
    86	            if a.get('choice') not in labels or probs[a['choice']] < max(probs.values())-0.0001:
    87	                raise ModelError('Jev choice disagrees with probabilities')
    88	        else:
    89	            if a.get('legend')!={str(i):v for i,v in enumerate(q['criteria'])}:
    90	                raise ModelError('Jev score legend mismatch')
    91	            expected=sum(int(k)*v for k,v in probs.items())
    92	            score=number(a.get('score'))
    93	            tolerance=0.005*(sum(int(k) for k in probs)+1)+1e-9
    94	            if not 0 <= score <= len(labels)-1 or abs(score-expected)>tolerance:
    95	                raise ModelError('Jev score disagrees with probabilities')
    96	    return answers
