    65	JEV_CRITERIA = {
    66	    'supports': 'Taken at face value, the evidence makes the premise more likely for its subject, metric/scope and period; for forward premises guidance/plans or a continuing reported trend count.',
    67	    'contradicts': 'The evidence makes the premise less likely for the same subject/scope/period: reported decline vs premised growth, guidance below, opposing statement, adverse ruling, operational reversal.',
    68	    'contextual': 'Same subject and mechanism but does not move the likelihood: background, definitions, generic boilerplate risk, restatement of framing.',
    69	    'irrelevant': 'Different subject or mechanism; no bearing.'}
    70	# Chosen on the bench-v1 dev split only (relations benchmark); see docs/BENCHMARK.md.
    71	CASCADE_THRESHOLD = 0.95
    72	
    73	
    74	class CascadeJudge:
    75	    """Jev first; accept its label at >= CASCADE_THRESHOLD confidence, else ask Luna.
    76	
    77	    Jev returns calibrated probabilities but no reason text, so accepted Jev
    78	    labels carry a generated reason naming the probability.
    79	    """
    80	
    81	    def __init__(self, llm, jev_client, jev_policy, archive, ledger_path):
    82	        import threading
    83	        self.llm, self.client, self.policy = llm, jev_client, jev_policy
    84	        self.archive, self.ledger_path = archive, ledger_path
    85	        self._local = threading.local()
    86	
    87	    def _ledger(self):
    88	        from .models import UsageLedger
    89	        if not hasattr(self._local, 'ledger'):
    90	            self._local.ledger = UsageLedger(self.ledger_path, self.policy)
    91	        return self._local.ledger
    92	
    93	    def __call__(self, thesis, premise, evidence, *, context=None):
    94	        from .jev import evaluate
