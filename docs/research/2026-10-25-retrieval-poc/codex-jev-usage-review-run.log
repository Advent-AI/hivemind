   110	def _words(text):
   111	    """Tokens for the within-view ranking: latin words and numbers, and character bigrams for Chinese runs (a
   112	    Chinese one-line has no spaces, so whole clauses would otherwise be single tokens that never overlap)."""
   113	    text = (text or '').lower()
   114	    words = set(re.findall(r'[a-z0-9]+(?:[.,][0-9]+)?%?', text))
   115	    for run in CJK_RUN.findall(text):
   116	        words.update(run[i:i + 2] for i in range(len(run) - 1))
   117	    return words
