    19	            raise ModelError('invalid Jev transport bounds')
    20	        self.key,self.timeout,self.max_bytes=key,timeout,max_bytes
    21	        self.opener=opener or build_opener(NoRedirect())
    22	
    23	    def complete(self,request):
    24	        if set(request)!={'model','state','questions'} or request['model']!='jev-1.13.0':
    25	            raise ModelError('only pinned typed Jev requests are supported')
    26	        if not isinstance(request['questions'],dict) or not 1 <= len(request['questions']) <= 64:
    27	            raise ModelError('invalid Jev question bound')
    28	        if not isinstance(request['state'],str) or not request['state'].strip():
    29	            raise ModelError('Jev state must be nonempty text')
    30	        for key, question in request['questions'].items():
    31	            if not isinstance(key,str) or not key or not isinstance(question,dict):
    32	                raise ModelError('invalid Jev question')
    33	            if question.get('type') not in {'choice','score','noul'} or not isinstance(question.get('instructions'),str):
    34	                raise ModelError('invalid Jev question type or instructions')
    35	            criteria=question.get('criteria')
    36	            if question['type']=='choice' and (not isinstance(criteria,dict) or not 2 <= len(criteria) <= 255
    37	                or any(not isinstance(k,str) or not k or not isinstance(v,str) for k,v in criteria.items())):
    38	                raise ModelError('invalid Jev choice criteria')
    39	            if question['type']=='score' and (not isinstance(criteria,list) or not 2 <= len(criteria) <= 10
    40	                or any(not isinstance(v,str) for v in criteria)):
    41	                raise ModelError('invalid Jev score criteria')
    42	        body=json_bytes(request)
    43	        if len(body)>120_000:raise ModelError('Jev input byte bound exceeded')
    44	        try:
    45	            req=Request(ENDPOINT,body,{'Authorization':'Bearer '+self.key,'Content-Type':'application/json','Accept':'application/json'})
    46	            with self.opener.open(req,timeout=self.timeout) as response:
