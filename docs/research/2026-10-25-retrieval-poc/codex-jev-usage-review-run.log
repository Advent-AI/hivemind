def effective_tags(claim, jev_result, *, mode='cascade', threshold=None, jev_dependency=None):
600
    """Return (tags, needs_adjudication).
601

602
    mode extraction: Luna extraction labels. jev: Jev labels. cascade: extraction labels unless Jev
603
    confidently (>= threshold) disagrees on role or channel, which sends the mention to Luna adjudication;
604
    with jev_dependency, a confident Jev dependency level replaces the extraction's.
605
    """
606
    rel = claim['payload']['relationship']
607
    base = {'role': rel['role'], 'channel': rel['channel'], 'dependency': rel['dependency'], 'source': 'extraction'}
608
    if mode == 'extraction' or not jev_result or jev_result.get('status') != 'validated_judgment':
609
        return base, False
610
    threshold = TAG_POLICY['threshold'] if threshold is None else threshold
611
    jev_dependency = TAG_POLICY['jev_dependency'] if jev_dependency is None else jev_dependency
612
    answers = jev_result['answers']
613
    if mode == 'jev':
614
        return {**{k: answers[k]['choice'] for k in ('role', 'channel', 'dependency')}, 'source': 'jev'}, False
615
    disagree = any(answers[k]['choice'] != base[k] and answers[k]['confidence'] >= threshold
616
                   for k in ('role', 'channel'))
617
    if jev_dependency and answers['dependency']['confidence'] >= threshold:
618
        base = dict(base, dependency=answers['dependency']['choice'])
619
    return base, disagree
