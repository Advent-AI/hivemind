     1	#!/usr/bin/env python3
     2	"""Score relationship-mention extraction and tagging against bench-x1 links gold.
     3	
     4	  score_links.py --db .runtime/v4/links.sqlite3 --split dev [--modes extraction jev cascade]
     5	                 [--thresholds 0.8 0.9 0.95] [--out results/links-dev.json]
     6	
     7	A gold item is recalled when a system relationship mention (claim_kind 'relationship') has the same
     8	source, a quote span overlapping the gold span (within 300 characters), the same subject entity and the
     9	same counterparty entity (names resolved with the pipeline resolver; unnamed counterparties match on
    10	kind). Role / channel / dependency accuracy is measured on recalled items per tagging mode. Negatives
    11	count as false positives when a system mention for the same pair overlaps the negative's quote with an
    12	effective role other than no_relationship. Jev and adjudication calls go through the shared usage
    13	ledger and request cache (reruns are free); running needs TYPESAFE_API_KEY and OPENAI_API_KEY only
    14	for requests not yet cached.
    15	"""
    16	import argparse
    17	import json
    18	import os
    19	import re
    20	import sys
    21	from pathlib import Path
    22	
    23	ROOT = Path(__file__).resolve().parents[2]
    24	sys.path.insert(0, str(ROOT / 'src'))
    25	
    26	from tn_hivemind.core.ledger import ReadOnlyLedger  # noqa: E402
    27	from tn_hivemind.data import relations as rel  # noqa: E402
    28	
    29	GOLD = Path(__file__).parent / 'gold'
    30	# A mention's share is right when it is the one percentage the extraction contract asks for (prompts/v4-relations-v1:
    31	# "a disclosed percentage exactly as written") and equals the gold's (DECISIONS S109). A series of years' shares
    32	# ("25%, 22% and 19%") is read by ``relations.share_percent`` as its first figure, so it is not a share. Reports
    33	# made before this id compared first figures and stay under their configuration ids.
    34	SHARE_SCORER = 'bench-x1-share-single-v2'
    35	# The whole field: one unsigned percentage, after at most one of the qualifications a disclosure uses.
    36	_QUALIFIERS = ('approximately', 'about', 'around', 'roughly', 'nearly', 'almost', 'over', 'under', 'more than',
    37	               'less than', 'at least', 'at most', 'up to')
    38	_ONE_PERCENTAGE = re.compile(r'(?:(?:' + '|'.join(_QUALIFIERS) + r')\s+)?\d+(?:\.\d+)?\s?%', re.IGNORECASE)
    39	
    40	
    41	def share_correct(share, gold_share):
    42	    """Whether a mention's whole share field is one unsigned percentage (``_ONE_PERCENTAGE``: not a series "32% and
    43	    28%", a range "28-32%", a sign "-32%", "+32%" or "minus 32%") equal to the gold share's (``SHARE_SCORER``)."""
    44	    return bool(_ONE_PERCENTAGE.fullmatch((share or '').strip())) and \
    45	        rel.share_percent(share) == rel.share_percent(gold_share)
    46	
    47	
    48	def load_gold(split):
    49	    items = []
    50	    for path in sorted(GOLD.glob('links-*.json')):
    51	        items += [dict(i, file=path.name) for i in json.loads(path.read_text())['items']]
    52	    return [i for i in items if split == 'all' or i['split'] == split]
    53	
    54	
    55	def near(a, b, slack=300):
    56	    return a[0] <= b[1] + slack and b[0] <= a[1] + slack
    57	
    58	
    59	def resolve_gold(resolver, name, kind):
    60	    if name.startswith('issuer:'):
    61	        return name
    62	    if kind in ('unnamed_company',):
    63	        return 'unnamed'
    64	    return resolver.lookup(name) or ('name:' + rel.normalize(name))
    65	
    66	
    67	STOP = {'the', 'of', 'and', 'a', 'an', 'its', 'our', 'for', 'in', 'on', 'to', 'with', 'other', 'certain'}
    68	
    69	
    70	def tokens(name):
    71	    return {w for w in rel.normalize(name).split() if w not in STOP}
    72	
    73	
    74	def acronym(name):
    75	    return ''.join(w[0] for w in rel.normalize(name).split() if w not in STOP)
    76	
    77	
    78	def same_party(gold_id, gold_name, system_id, system_name):
    79	    """Resolved ids equal, or (for names that did not resolve to the same entity) close names:
    80	    token Jaccard >= 0.5, containment, or acronym (CMA ~ Competition and Markets Authority)."""
    81	    if gold_id == system_id:
    82	        return True
    83	    if gold_id.startswith('issuer:') or system_id.startswith('issuer:'):
    84	        return False
    85	    a, b = tokens(gold_name), tokens(system_name)
    86	    if not a or not b:
    87	        return False
    88	    na, nb = rel.normalize(gold_name).replace(' ', ''), rel.normalize(system_name).replace(' ', '')
    89	    return (len(a & b) / len(a | b) >= 0.5 or na in nb or nb in na
    90	            or na == acronym(system_name) or nb == acronym(gold_name))
    91	
    92	
    93	def system_party(record_id, entities):
    94	    if record_id.startswith('entity:unnamed:'):
    95	        return 'unnamed'
    96	    return record_id
