   153	def existing_edges(ledger):
   154	    """(thesis_id, premise_id, claim_id) already judged for any thesis version."""
   155	    seen = set()
   156	    for record in ledger.records('evaluation'):
   157	        p = record['payload']
   158	        for claim_ref in p.get('claim_refs', []):
   159	            seen.add((p['thesis_ref']['id'], p['premise_id'], claim_ref['id']))
   160	    return seen
   161	
   162	
   163	def judge_proposed(llm, ledger, *, theses=None, workers=8, log=print, judge=None):
   164	    """Judge every proposed (premise, claim) link of current thesis heads not yet judged."""
   165	    sources = {s['id']: s for s in ledger.heads('source')}
   166	    theses = theses if theses is not None else [t for t in ledger.heads('thesis')
   167	                                                 if t['payload'].get('generation')]
   168	    done = existing_edges(ledger)
   169	    tasks = []
   170	    for thesis in theses:
   171	        for premise in thesis['payload']['premises']:
   172	            proposed = ({c: 'proposed_support' for c in premise.get('proposed_support', [])}
   173	                        | {c: 'proposed_oppose' for c in premise.get('proposed_oppose', [])})
   174	            for claim_ref in premise['claim_refs']:
   175	                if (thesis['id'], premise['id'], claim_ref['id']) in done:
   176	                    continue
   177	                claim = ledger.get('claim', claim_ref['id'], version=claim_ref['version'])
   178	                tasks.append((thesis, premise, claim, proposed.get(claim_ref['id'], 'proposed')))
   179	    log(f'edges: {len(tasks)} proposed links to judge')
   180	    return _judge(llm, ledger, tasks, sources, workers=workers, log=log, judge=judge)
   181	
   182	
   183	def _judge(llm, ledger, tasks, sources, *, workers, log, judge=None):
   184	    tasks = [t if len(t) == 5 else (*t, None) for t in tasks]
   185	
   186	    def run(task):
   187	        thesis, premise, claim, origin, cross = task
   188	        evidence = claim_evidence(claim, sources)
   189	        if cross:
   190	            evidence['link'] = cross['link']
   191	            return judge_pair(llm, thesis['payload'], premise, evidence,
   192	                              context={'thesis': thesis['id'], 'premise': premise['id'], 'claim': claim['id']})
   193	        function = judge or (lambda *a, **k: judge_pair(llm, *a, **k))
   194	        return function(thesis['payload'], premise, evidence,
   195	                        context={'thesis': thesis['id'], 'premise': premise['id'], 'claim': claim['id']})
   196	    counts = {label: 0 for label in LABELS}
   197	    counts['failed'] = 0
   198	    agree = {'proposed_support': [0, 0], 'proposed_oppose': [0, 0]}
   199	    records = []
   200	    for (thesis, premise, claim, origin, cross), outcome in llm.map(run, tasks, workers=workers):
   201	        if isinstance(outcome, Exception):
   202	            counts['failed'] += 1
   203	            ledger.reject('v4_edge', thesis['id'], str(outcome)[:200], {'premise': premise['id'], 'claim': claim['id']})
   204	            continue
   205	        judgment, result = outcome
   206	        counts[judgment['relation']] += 1
   207	        if origin in agree:
   208	            agree[origin][1] += 1
   209	            expected = 'supports' if origin == 'proposed_support' else 'contradicts'
   210	            agree[origin][0] += judgment['relation'] == expected
   211	        records.append(evaluation_record(thesis, premise, claim, judgment, result, llm.policy['id'], origin=origin,
   212	                                         cross=cross and {k: cross[k] for k in ('subject', 'route', 'link',
   213	                                                                              'relationship_ref', 'link_class')}))
   214	    for start in range(0, len(records), 200):
   215	        ledger.admit(records[start:start + 200])
   216	    log(f'edges: {counts}; generator/judge agreement {agree}')
   217	    return {'counts': counts, 'agreement': agree, 'judged': len(records)}
   218	
