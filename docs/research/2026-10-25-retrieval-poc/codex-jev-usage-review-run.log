   191	                                                       and same_party(counterparty, g['counterparty'], c, cname))) \
   192	                    and near(span, cspan):
   193	                overlap = min(span[1], cspan[1]) - max(span[0], cspan[0])
   194	                if best is None or overlap > best[0]:
   195	                    best = (overlap, claim)
   196	        if best:
   197	            matches[g['id']] = best[1]
   198	            used.add(best[1]['id'])
   199	    for label in mode_labels:
   200	        role_ok = channel_ok = dep_ok = share_ok = share_n = excluded = 0
   201	        confusion = {}
   202	        for g in positives:
   203	            claim = matches.get(g['id'])
   204	            if claim is None:
   205	                continue
   206	            t = tags[claim['id']]['tags'].get(label) or {**claim['payload']['relationship'], 'source': 'extraction'}
   207	            if t['role'] == 'no_relationship':
   208	                excluded += 1
   209	            role_ok += t['role'] == g['role']
   210	            channel_ok += t['channel'] == g['channel']
   211	            dep_ok += t['dependency'] == g['dependency']
   212	            if g.get('share'):
   213	                share_n += 1
   214	                share_ok += share_correct(claim['payload']['relationship'].get('share'), g['share'])
   215	            if t['role'] != g['role']:
   216	                pair = f"{g['role']}→{t['role']}"
   217	                confusion[pair] = confusion.get(pair, 0) + 1
   218	        recalled = len(matches) - excluded
   219	        fp = 0
   220	        for g in negatives:
   221	            subject = resolve_gold(resolver, g['subject'], 'company')
   222	            counterparty = resolve_gold(resolver, g['counterparty'], g['counterparty_kind'])
   223	            for claim in by_source.get(g['source_id'], []):
   224	                s, c, cspan = key(claim)
   225	                t = tags.get(claim['id'], {}).get('tags', {}).get(label) or {'role': claim['payload']['relationship']['role']}
   226	                cname = claim['payload']['relationship']['counterparty_name']
   227	                pair = {s, c} == {subject, counterparty} or (s == subject and same_party(counterparty, g['counterparty'], c, cname))
   228	                if pair and near((g['start'], g['end']), cspan, 50) \
   229	                        and t['role'] != 'no_relationship':
   230	                    fp += 1
   231	                    break
   232	        kept = [c for c in scoped if (tags.get(c['id'], {}).get('tags', {}).get(label) or {}).get('role') != 'no_relationship']
   233	        n = max(1, len(matches))
   234	        report['modes'][label] = {
   235	            'recall': round(recalled / max(1, len(positives)), 4), 'recalled': recalled, 'positives': len(positives),
   236	            'role_accuracy': round(role_ok / n, 4), 'channel_accuracy': round(channel_ok / n, 4),
   237	            'dependency_accuracy': round(dep_ok / n, 4),
   238	            'share_exact': f'{share_ok}/{share_n}', 'negatives': len(negatives), 'negative_false_positives': fp,
   239	            'system_mentions_kept': len(kept),
   240	            'matched_share_of_kept (precision lower bound vs non-exhaustive gold)':

