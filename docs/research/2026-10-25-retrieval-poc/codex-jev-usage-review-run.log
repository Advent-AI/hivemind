    74	def ladder_direction(rungs):
    75	    """+1 when the quantities rise from the first rung to the last, -1 when they fall, None when undecidable. The rungs'
    76	    numeric bounds decide when both ends carry them; the prose is read only for a ladder without bounds."""
    77	    first, last = rungs[0], rungs[-1]
    78	    if any(r.get('lo') is not None or r.get('hi') is not None for r in rungs):
    79	        if first.get('hi') is not None and last.get('lo') is not None and float(first['hi']) <= float(last['lo']):
    80	            return 1
    81	        if first.get('lo') is not None and last.get('hi') is not None and float(last['hi']) <= float(first['lo']):
    82	            return -1
    83	        return None
    84	    numbers = [first_value(rung['condition']) for rung in rungs]
    85	    known = [n for n in numbers if n is not None]
    86	    if len(known) < 2 or known[0] == known[-1]:
    87	        return None
    88	    return 1 if known[0] < known[-1] else -1
