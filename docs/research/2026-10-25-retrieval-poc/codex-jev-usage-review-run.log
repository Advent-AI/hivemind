    91	def same_orientation(previous, candidate):
    92	    """06-views: a successor's ladder keeps the predecessor's direction. Asset views carry the fixed labels, so equal
    93	    labels settle it; a theme view's labels are results that change with the period, so the direction of the numbers
    94	    is compared instead, and an undecidable pair is left to the model."""
    95	    if [vocabulary.canonical('label', r['label']) for r in previous] == [vocabulary.canonical('label', r['label']) for r in candidate]:
    96	        return True
    97	    before, after = ladder_direction(previous), ladder_direction(candidate)
    98	    return before is None or after is None or before == after
