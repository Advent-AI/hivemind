   120	def claim_evidence(claim, sources):
   121	    p = claim['payload']
   122	    passage = p['passages'][0]
   123	    source = sources[passage['source_ref']['id']]['payload']
   124	    return {'statement': p['statement'], 'quote': passage['quote'][:1200], 'attribution': p['attribution'],
