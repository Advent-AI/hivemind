   111	                        'reason': f"Jev classification ({label}, p={answer['probabilities'][label]:.2f}); no model rationale.",
   112	                        'judge': 'jev'}
   113	                pseudo = {'response_sha256': result['response_sha256'], 'request_sha256': result['request_sha256']}
   114	                return data, pseudo
