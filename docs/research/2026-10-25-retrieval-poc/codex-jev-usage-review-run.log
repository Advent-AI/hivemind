     1	"""Bounded typed judgments via the documented TypeSafe endpoint; no generation."""
     2	import math
     3	from urllib.error import HTTPError, URLError
     4	from urllib.request import Request, build_opener
     5	
     6	from ..core.archive import json_bytes
     7	from .transport import ModelError, NoRedirect
     8	from .usage import run_model
     9	
    10	ENDPOINT='https://api.typesafe.ai/v1/systemone'
    11	
    12	
    13	class Jev:
    14	    """The TypeSafe Jev client: typed choice, score and noul questions over one state text, pinned to jev-1.13.0."""
    15	    def __init__(self,key,*,timeout=30,max_bytes=1_000_000,opener=None):
    16	        if not isinstance(key,str) or not key or any(c.isspace() for c in key):
    17	            raise ModelError('Jev key missing or malformed')
    18	        if not 0 < timeout <= 60 or not 1 <= max_bytes <= 4_000_000:
    19	            raise ModelError('invalid Jev transport bounds')
    20	        self.key,self.timeout,self.max_bytes=key,timeout,max_bytes
    21	        self.opener=opener or build_opener(NoRedirect())
    22	
    23	    def complete(self,request):
    24	        if set(request)!={'model','state','questions'} or request['model']!='jev-1.13.0':
    25	            raise ModelError('only pinned typed Jev requests are supported')
    26	        if not isinstance(request['questions'],dict) or not 1 <= len(request['questions']) <= 64:
    27	            raise ModelError('invalid Jev question bound')
    28	        if not isinstance(request['state'],str) or not request['state'].strip():
    29	            raise ModelError('Jev state must be nonempty text')
    30	        for key, question in request['questions'].items():
    31	            if not isinstance(key,str) or not key or not isinstance(question,dict):
    32	                raise ModelError('invalid Jev question')
    33	            if question.get('type') not in {'choice','score','noul'} or not isinstance(question.get('instructions'),str):
    34	                raise ModelError('invalid Jev question type or instructions')
    35	            criteria=question.get('criteria')
    36	            if question['type']=='choice' and (not isinstance(criteria,dict) or not 2 <= len(criteria) <= 255
    37	                or any(not isinstance(k,str) or not k or not isinstance(v,str) for k,v in criteria.items())):
    38	                raise ModelError('invalid Jev choice criteria')
    39	            if question['type']=='score' and (not isinstance(criteria,list) or not 2 <= len(criteria) <= 10
    40	                or any(not isinstance(v,str) for v in criteria)):
    41	                raise ModelError('invalid Jev score criteria')
    42	        body=json_bytes(request)
    43	        if len(body)>120_000:raise ModelError('Jev input byte bound exceeded')
    44	        try:
    45	            req=Request(ENDPOINT,body,{'Authorization':'Bearer '+self.key,'Content-Type':'application/json','Accept':'application/json'})
    46	            with self.opener.open(req,timeout=self.timeout) as response:
    47	                raw=response.read(self.max_bytes+1)
    48	            if len(raw)>self.max_bytes:raise ModelError('Jev response exceeds byte bound')
    49	            if self.key.encode() in raw:raise ModelError('Jev response contains credential; not archived')
    50	            return raw
    51	        except ModelError:raise
    52	        except HTTPError as exc:raise ModelError('Jev HTTP '+str(exc.code)) from None
    53	        except (URLError,OSError,ValueError,UnicodeError):
    54	            raise ModelError('Jev transport failed; details omitted') from None
    55	
    56	
    57	def validate_answers(response,request):
    58	    """The answers of a Jev response, checked against the request's questions (labels, distributions, choice
    59	    and score consistency); ModelError otherwise.
    60	    """
    61	    if not isinstance(response,dict) or response.get('model')!='jev-1.13.0':
    62	        raise ModelError('Jev response model mismatch')
    63	    answers=response.get('answers')
    64	    if not isinstance(answers,dict) or set(answers)!=set(request['questions']):
    65	        raise ModelError('Jev answer set mismatch')
    66	    def number(x):
    67	        if type(x) not in (float,int) or not math.isfinite(x):raise ModelError('invalid Jev numeric answer')
    68	        return x
    69	    for key,q in request['questions'].items():
    70	        a=answers[key]
    71	        if not isinstance(a,dict) or a.get('type')!=q['type']:raise ModelError('Jev answer type mismatch')
    72	        if q['type']=='noul':
    73	            if not 0 <= number(a.get('noul')) <= 1:raise ModelError('invalid noul range')
    74	            continue
    75	        if q['type'] not in {'choice','score'}:raise ModelError('unsupported Jev type')
    76	        labels=set(q['criteria']) if q['type']=='choice' else {str(i) for i in range(len(q['criteria']))}
    77	        probs=a.get('probabilities')
    78	        if not isinstance(probs,dict) or set(probs)!=labels:raise ModelError('Jev probability labels mismatch')
    79	        # Observed API probabilities/score are independently rounded to 2 decimals.
    80	        # Bound the total quantization error; preserve raw values, never normalize
    81	        # them silently or demand impossible exact floating-point equality.
    82	        if any(not 0 <= number(v) <= 1 for v in probs.values()) or abs(sum(probs.values())-1)>0.005*len(labels)+1e-9:
    83	            raise ModelError('invalid Jev distribution')
    84	        if not 0 <= number(a.get('confidence')) <= 1:raise ModelError('invalid Jev confidence')
    85	        if q['type']=='choice':
    86	            if a.get('choice') not in labels or probs[a['choice']] < max(probs.values())-0.0001:
    87	                raise ModelError('Jev choice disagrees with probabilities')
    88	        else:
    89	            if a.get('legend')!={str(i):v for i,v in enumerate(q['criteria'])}:
    90	                raise ModelError('Jev score legend mismatch')
    91	            expected=sum(int(k)*v for k,v in probs.items())
    92	            score=number(a.get('score'))
    93	            tolerance=0.005*(sum(int(k) for k in probs)+1)+1e-9
    94	            if not 0 <= score <= len(labels)-1 or abs(score-expected)>tolerance:
    95	                raise ModelError('Jev score disagrees with probabilities')
    96	    return answers
    97	
    98	
    99	def evaluate(client,ledger,archive,request,*,rubric_version,retry=False):
   100	    """One budgeted Jev judgment through ``usage.run_model``, journaled under ``runs``; returns (journal digest,
   101	    result, cached).
   102	    """
   103	    call,cached=run_model(client,ledger,archive,request,
   104	                         context_key={'stage':'jev_judgment','rubric':rubric_version},retry=retry)
   105	    result={'stage':'jev_judgment','call_id':call['id'],'status':'pending' if call['status']=='reserved' else 'rejected',
   106	            'request_sha256':call['request_sha256'],'response_sha256':call['response_sha256'],'rubric_version':rubric_version}
   107	    if call['status']=='completed':
   108	        try:result.update(status='validated_judgment',answers=validate_answers(archive.read_json(call['response_sha256']),request))
   109	        except ModelError as exc:result['failure']=str(exc)
   110	    return archive.journal('runs',result),result,cached

