    35	def batch_plan(candidates, outcomes):
    36	    """Resolve same-answer duplicates and validate dependencies on the resulting identities before retry ends."""
    37	    aliases, first_by_key, errors = {}, {}, []
    38	    for candidate in candidates:
    39	        cid = candidate['id']
    40	        outcome = outcomes.get(cid, ('skip', None, []))
    41	        if outcome[0] not in ('new', 'succession'):
    42	            continue
    43	        key = automatic_key(candidate)
    44	        first = first_by_key.setdefault(key, cid) if key is not None else cid
    45	        aliases[cid] = first
    46	        if outcome[:2] != outcomes[first][:2]:
    47	            errors.append(f'candidate {cid}: same-key succession conflicts with {first}')
    48	    graph, directions = {}, {}
    49	    for cid, first in aliases.items():
    50	        for dep in outcomes[cid][2]:
    51	            target = aliases.get(dep['view_id'], dep['view_id'])
    52	            chain = aliases.get(dep['wait_chain_view_id'], dep['wait_chain_view_id'])
    53	            edge = (first, target, chain, dep['wait_year'])
    54	            if edge in directions and directions[edge] != dep['direction']:
    55	                errors.append(f'candidate {cid}: same-key dependency direction conflicts')
    56	            directions[edge] = dep['direction']
    57	            if target:
    58	                graph.setdefault(first, set()).add(target)
    59	    for cid in graph:
    60	        stack, seen = list(graph[cid]), set()
    61	        while stack:
    62	            target = stack.pop()
    63	            if target == cid:
    64	                errors.append(f'candidate {cid}: coalesced dependencies lead back to itself')
    65	                break
    66	            if target not in seen:
    67	                seen.add(target)
    68	                stack.extend(graph.get(target, ()))
    69	    return aliases, errors

