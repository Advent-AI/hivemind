   113	def recovery_chain(bindings, call_id):
   114	    """The calls of one request from its original failure to ``call_id`` along the recovery bindings
   115	    (``UsageLedgerReader.recoveries``: a successor that failed and was recovered again), oldest first; at most
   116	    ``MAX_RECOVERY_CHAIN`` recoveries deep, as ``UsageLedger.recovered_answer`` follows them."""
   117	    failed_of = {row['successor_call_id']: row['failed_call_id'] for row in bindings.values()}
