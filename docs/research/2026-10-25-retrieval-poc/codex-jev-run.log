    22	        alias = re.sub(r'\s+', ' ', (alias or '')).strip()
    23	        if len(alias) < MIN_ALIAS or alias.casefold() in banned or alias.casefold() in {a.casefold() for a in out}:
    24	            continue
    25	        out.append(alias)
