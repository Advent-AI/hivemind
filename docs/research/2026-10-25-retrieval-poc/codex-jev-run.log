     1	"""D155: exact identity and same-answer coalescing, shared by matching and writing."""
     2	from ..universe import scope_key
     3	
     4	KEY_VERSION = 2
     5	
     6	
     7	def automatic_key(value, object_id=None):
     8	    """Return a complete, code-owned key, or None when identity still needs judgement."""
     9	    if value.get('key_version') != KEY_VERSION or value.get('scope_source') not in ('none', 'watch'):
    10	        return None
    11	    if value.get('measure') in (None, 'other'):
    12	        return None
    13	    if value['measure'] in ('event', 'policy_event') and value.get('event_type') in (None, 'other', 'n/a'):
    14	        return None
    15	    return (object_id or value.get('object'), value['measure'], scope_key(value.get('scope', '')),
    16	            value.get('period_start'), value.get('period_end'), value.get('basis'), value.get('unit'), value.get('event_type'))
    17	
    18	
    19	def conflicts(key, candidate, *, merging):
    20	    """Known different quantities/events cannot merge; corrected scopes/periods bind only corrected keys."""
    21	    if key['measure'] != candidate['measure'] or key['event_type'] != candidate.get('event_type', 'n/a'):
    22	        return True
    23	    for field in ('basis', 'unit'):
    24	        a, b = key[field], candidate.get(field, 'n/a')
    25	        if a != 'n/a' and b != 'n/a' and a != b:
    26	            return True
    27	    if key.get('key_version') != KEY_VERSION or candidate.get('key_version') != KEY_VERSION:
    28	        return False
    29	    if (key.get('scope_source') in ('none', 'watch') and candidate.get('scope_source') in ('none', 'watch')
    30	            and scope_key(key['scope']) != scope_key(candidate.get('scope', ''))):
    31	        return True
    32	    return merging and (key['period_start'], key['period_end']) != (candidate.get('period_start'), candidate.get('period_end'))
    33	
    34	
    35	def batch_plan(candidates, outcomes):
    36	    """Resolve same-answer duplicates and validate dependencies on the resulting identities before retry ends."""
    37	    aliases, first_by_key, errors = {}, {}, []
    38	    for candidate in candidates:
    39	        cid = candidate['id']
    40	        outcome = outcomes.get(cid, ('skip', None, []))
    41	        if outcome[0] not in ('new', 'succession'):
    42	            continue
    43	        key = automatic_key(candidate)
    44	        first = first_by_key.setdefault(key, cid) if key is not None else cid
