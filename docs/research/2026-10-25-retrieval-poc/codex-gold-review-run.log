   181	def gold_states(gold, label, ledger):
   182	    """Per thesis: ('dedup', original) for the later members of a same-set; 'grouped' for required members of a matter;
   183	    'optional' where the gold abstains; otherwise 'new'. Company lines keep dedup/new only (never asked membership)."""
   184	    states, dedup_of = {}, {}
   185	    for entry in gold['identity']['same']:
   186	        if entry['ledger'] != label:
   187	            continue
   188	        ordered = sorted(entry['views'], key=lambda v: ledger.views[v]['created_seq'])
   189	        for later in ordered[1:]:
   190	            states[later] = 'dedup'
   191	            dedup_of[later] = ordered[0]
   192	    required, optional = set(), set()
   193	    for g in gold['groups'].values():
   194	        required |= set(g.get('members_required', {}).get(label, []))
   195	        optional |= set(g.get('members_optional', {}).get(label, []))
   196	    for vid in ledger.views:
   197	        if vid in states:
   198	            continue
   199	        if vid in required and ledger.tracks_a_matter(vid):
   200	            states[vid] = 'grouped'
   201	        elif vid in optional:
   202	            states[vid] = 'optional'
   203	        else:
   204	            states[vid] = 'new'
   205	    return states, dedup_of
