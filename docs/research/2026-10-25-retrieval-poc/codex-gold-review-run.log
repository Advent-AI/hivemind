   170	def relation_question(other_card, other_source):
   171	    return {'type': 'choice', 'criteria': RELATIONS,
   172	            'instructions': 'What relationship holds between the CANDIDATE and the THESIS below? Use only the supplied cards and source passages. '
   173	                            'Equal numbers and similar wording do not establish identity. THESIS:\n' + other_card + '\n' + other_source}
   174	
