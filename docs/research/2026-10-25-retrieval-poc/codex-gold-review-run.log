   445	def groups_for_prompt(conn, object_ids, text, top_n=10):
   446	    """05-extraction block 5b: the research groups the model may place a candidate in: every group with a member among
   447	    the objects' views, then the top N groups whose name, scope or objects match the item's title and objects (other
   448	    companies included). Each with its member theses' focus, so the model reads what the subject is about."""
   449	    found, order = {}, []
   450	    for object_id in object_ids:
   451	        for row in conn.execute("""select distinct g.* from thesis_groups g join thesis_group_members m on m.group_id=g.group_id
   452	                                   join views v on v.view_id=m.view_id where v.object_id=? order by g.created_seq""", (object_id,)):
   453	            if row['group_id'] not in found:
   454	                found[row['group_id']] = _group_record(row); order.append(row['group_id'])
   455	    words = [w for w in re.findall(r'[A-Za-z0-9][A-Za-z0-9.&-]+', f'{" ".join(object_ids)} {text or ""}') if len(w) >= 3]
   456	    if words:
   457	        query = ' OR '.join('"' + w.replace('"', '') + '"' for w in dict.fromkeys(words[:24]))
   458	        try:
   459	            for r in conn.execute('select group_id from groups_fts where groups_fts match ? order by rank limit ?', (query, top_n)):
   460	                if r['group_id'] not in found:
   461	                    found[r['group_id']] = group(conn, r['group_id']); order.append(r['group_id'])
   462	        except sqlite3.OperationalError:
   463	            pass
   464	    out = []
   465	    for group_id in order:
   466	        members = members_of_group(conn, group_id)
   467	        out.append(dict(found[group_id], members=[{'view_id': v, 'object_id': view(conn, v)['object_id'], 'looks_at': view(conn, v)['looks_at']} for v in members]))
   468	    return out

