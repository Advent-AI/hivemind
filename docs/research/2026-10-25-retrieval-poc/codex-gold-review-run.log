    18	def decisions(conn):
    19	    """(input short name, evidence handover id, view id) -> (outcome, target one-line) from the last first-pass record of each input."""
    20	    out = {}
    21	    for r in conn.execute('select input_id, call_no, decisions_json from match_records order by id'):
    22	        if r['call_no'] not in (1, 2):
    23	            continue
    24	        short = r['input_id'] if r['input_id'].startswith('truenorth:') else r['input_id'].split(':')[-1]
    25	        for x in json.loads(r['decisions_json'] or '{}').get('evidence', []):
    26	            target = x.get('target_evidence_id') or ''
    27	            text = ''
    28	            if target:
    29	                row = conn.execute('select one_line from evidence where evidence_id=?', (target,)).fetchone()
    30	                text = row['one_line'] if row else ''
    31	            out[f"{short}|{x['id']}|{x['view_id']}"] = (x['outcome'], text)
    32	    return out
    33	
