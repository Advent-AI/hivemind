   184	def describe_evidence(conn, evidence_id, english=False):
   185	    e = store.evidence(conn, evidence_id)
   186	    if english:
   187	        return f'{evidence_id} [{e["tier"]}; {e["speaker"]}; original source {e["original_who"]} {e["original_day"]}] {e["one_line"]} | quote: {e["quote"][:300]}'
   188	    return f'{evidence_id}［{e["tier"]}；{e["speaker"]}；原始来源 {e["original_who"]} {e["original_day"]}］{e["one_line"]}｜原句：{e["quote"][:300]}'
