   129	class Jev:
   130	    def __init__(self, cap_usd, dry_run, archive):
   131	        creds = json.loads(pathlib.Path(os.path.expanduser('~/.config/hivemind/credentials.json')).read_text())
   132	        self.key, self.cap_usd, self.dry_run, self.archive = creds['TYPESAFE_API_KEY'], cap_usd, dry_run, archive
   133	        self.spent_tokens, self.calls, self.dry_chars = 0, 0, 0
   134	
   135	    def ask(self, label, state, questions):
   136	        request = {'model': MODEL, 'state': state, 'questions': questions}
   137	        body = json.dumps(request).encode()
   138	        if self.dry_run:
   139	            self.calls += 1
   140	            self.dry_chars += len(body)
   141	            return None
   142	        if self.spent_tokens / 1e6 * PRICE_PER_M_INPUT > self.cap_usd:
   143	            raise SystemExit(f'budget cap ${self.cap_usd} reached after {self.calls} calls')
   144	        req = urllib.request.Request(ENDPOINT, body, {'Authorization': 'Bearer ' + self.key, 'Content-Type': 'application/json', 'Accept': 'application/json'})
   145	        t0 = time.time()
   146	        try:
   147	            with urllib.request.urlopen(req, timeout=90) as resp:
   148	                raw, status = resp.read(), resp.status
   149	        except urllib.error.HTTPError as exc:
   150	            raw, status = exc.read(), exc.code
   151	        elapsed = time.time() - t0
   152	        if self.key.encode() in raw:
   153	            raise SystemExit('response echoed the credential; aborting')
   154	        response = json.loads(raw) if raw[:1] == b'{' else {'raw': raw[:400].decode('utf-8', 'replace')}
   155	        self.spent_tokens += response.get('usage', {}).get('input_tokens', 0)
   156	        self.calls += 1
   157	        self.archive.append({'label': label, 'http_status': status, 'elapsed_s': round(elapsed, 3), 'request': request, 'response': response})
   158	        if status != 200:
   159	            print(f'  ! {label}: HTTP {status} {str(response)[:200]}', file=sys.stderr)
   160	            return None
   161	        return response['answers']
   162	
