   176	def relevance_question(object_id):
   177	    return {'type': 'noul', 'criteria': RELEVANCE_CRITERIA,
   178	            'instructions': f'Would a hedge-fund analyst covering {object_id} track the CANDIDATE question as part of an investment view? Judge from the supplied material only.'}
