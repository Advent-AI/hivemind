   247	def _user_text(conn, item, candidates, evidence, lists, shown_views, extra_views=(), english=False):
   248	    build = _user_text_english if english else _user_text_chinese
   249	    return build(conn, item, candidates, evidence, lists, shown_views, extra_views)
