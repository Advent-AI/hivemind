   274	
   275	def check(conn, universe, decisions, candidates, evidence, lists, shown_views):
   276	    decisions = vocabulary.matching_answer(decisions)
   277	    candidates = [vocabulary.candidate(c) for c in candidates]
   278	    shown_ids = {v['view_id'] for v in shown_views}
   279	    candidate_by_id = {c['id']: c for c in candidates}
   280	    # D51: a dependency is chosen among the views the model has in front of it: every list shown in this call,
   281	    # the views shown at extraction, and the candidates this answer opens
   282	    listed_all = set(shown_ids)
   283	    for hits in lists.candidate_lists.values():
   284	        listed_all.update(hits)
   285	    refusals, outcomes, not_opened, notes = [], {}, {}, []
   286	    raw_deps = {}
   287	    succession_targets = {}
   288	    answered = {d['id']: d for d in decisions.get('candidates', [])}
   289	    for c in candidates:
   290	        d = answered.get(c['id'])
   291	        if not d:
   292	            refusals.append(f'candidate {c["id"]} has no decision')
   293	            continue
   294	        outcome, target = d['outcome'], d['target_view_id'].strip()
   295	        listed = set(lists.candidate_lists.get(c['id'], [])) | shown_ids
   296	        if outcome in ('merge', 'succession') and target in candidate_by_id:
   297	            # a candidate cannot merge into another candidate of the same answer: only a stored thesis has a ladder and a due day to
   298	            # inherit. The model usually means "part of": both open, and the key coalesces them when they are the same quantity.
   299	            notes.append(f'candidate {c["id"]}: {outcome} into candidate {target} is not a destination; opened as a new view')
   300	            outcome, target = 'new', ''
   301	            d = dict(d, outcome=outcome, target_view_id='')
   302	        if outcome in ('merge', 'succession') and c.get('measure'):
   303	            # keyed-views-plan.md 2.5 rule 1: a different quantity, or another period, is never the same view, whatever the model says
   304	            target_key = store.view_key(conn, target) if target else None
   305	            target_view = store.view(conn, target) if target else None
   306	            if target_view and target_view['object_id'] != c['object']:
   307	                notes.append(f'candidate {c["id"]}: {outcome} into {target} refused: another object ({target_view["object_id"]} ≠ {c["object"]}); opened as a new view')
   308	                outcome, target, target_key = 'new', '', None
   309	                d = dict(d, outcome=outcome, target_view_id='')
   310	            if target_key and identity.conflicts(target_key, c, merging=outcome == 'merge'):
   311	                notes.append(f'candidate {c["id"]}: {outcome} into {target} refused by key ({target_key["measure"]}[{target_key["scope"]}] {target_key["period_start"]}..{target_key["period_end"]} ≠ {c["measure"]}[{c.get("scope", "")}] {c.get("period_start", "")}..{c.get("period_end", "")}); opened as a new view')
   312	                outcome, target = 'new', ''
   313	                d = dict(d, outcome=outcome, target_view_id='')
   314	        if outcome == 'new' and identity.automatic_key(c) is not None:
   315	            # rule 2 for a key code owns entirely: one open view with the same key and period is the same quantity; the model is not asked twice
   316	            twins = [v for v in lists.candidate_lists.get(c['id'], []) if _same_key(store.view_key(conn, v), c, (store.view(conn, v) or {}).get('object_id')) and store.is_open(conn, v)]
   317	            if len(twins) == 1:
   318	                notes.append(f'candidate {c["id"]}: opened as new by the model, merged into {twins[0]} by its key ({c["measure"]}[{c.get("scope", "")}] {c.get("period_start", "")}..{c.get("period_end", "")})')
   319	                outcome, target = 'merge', twins[0]
   320	                d = dict(d, outcome=outcome, target_view_id=target)
   321	        if outcome in ('merge', 'succession'):
   322	            if target not in listed:
   323	                refusals.append(f'candidate {c["id"]}: target {target!r} not in its list')
   324	                continue
   325	            if outcome == 'merge' and not store.is_open(conn, target):
   326	                refusals.append(f'candidate {c["id"]}: cannot attach to closed view {target}')
   327	                continue
   328	            if outcome == 'succession':
   329	                if conn.execute('select 1 from successions where succeeds=?', (target,)).fetchone():
   330	                    refusals.append(f'candidate {c["id"]}: {target} already has a successor')
   331	                    continue
   332	                if target in succession_targets:
   333	                    refusals.append(f'candidate {c["id"]}: {target} can have one successor; {succession_targets[target]} already succeeds it in this answer')
   334	                    continue
   335	                succession_targets[target] = c['id']
   336	                # 06-views: a successor keeps the predecessor's direction; the writer stores a numeric ladder in that direction (the first
   337	                # real succession, 2027 hyperscaler capex after 2026, came low-to-high where its predecessor ran high-to-low), so no refusal here
   338	        if outcome in ('new', 'succession'):
   339	            object_id = universe.resolve(c['object'])
   340	            if not object_id:
   341	                not_opened[c['id']] = f'object {c["object"]!r} not on the research list'
   342	                if c['kind'] == 'theme':
   343	                    store.pool(conn, 'suggested_theme', c['object'], {'question': c['question'], 'input_id': None}, 0)
   344	                outcomes[c['id']] = ('skip', None, [])
   345	                continue
   346	            outcomes[c['id']] = (outcome, target or None, [])
   347	            raw_deps[c['id']] = d.get('dependencies', [])
   348	        elif outcome == 'merge':
   349	            outcomes[c['id']] = (outcome, target, [])
   350	        else:
   351	            outcomes[c['id']] = ('skip', None, [])
   352	            not_opened[c['id']] = d.get('reason', '')
   353	    # dependencies, once every candidate's outcome is known
   354	    opened = {cid for cid, (outcome, _, _) in outcomes.items() if outcome in ('new', 'succession')}
   355	    for cid, dependencies in raw_deps.items():
   356	        deps = []
   357	        bad = False
   358	        for dep in dependencies:
   359	            view_id, chain, year = dep['view_id'].strip(), dep['wait_chain_view_id'].strip(), dep['wait_year'].strip()
   360	            if view_id:
   361	                if view_id in candidate_by_id and view_id not in opened:
   362	                    refusals.append(f'candidate {cid}: dependency {view_id} is a candidate that is not opened')
   363	                    bad = True
   364	                    break
   365	                if view_id not in listed_all and view_id not in candidate_by_id:
   366	                    refusals.append(f'candidate {cid}: dependency {view_id} was not shown')
   367	                    bad = True
   368	                    break
   369	                if view_id == cid:
   370	                    refusals.append(f'candidate {cid}: depends on itself')
   371	                    bad = True
   372	                    break
   373	                deps.append({'view_id': view_id, 'wait_chain_view_id': None, 'wait_year': None, 'direction': dep['direction']})
   374	            elif chain and year:
   375	                if chain not in listed_all and chain not in candidate_by_id:
   376	                    refusals.append(f'candidate {cid}: waited chain {chain} was not shown')
   377	                    bad = True
   378	                    break
   379	                deps.append({'view_id': None, 'wait_chain_view_id': chain, 'wait_year': year, 'direction': dep['direction']})
   380	        if bad:
   381	            continue
   382	        outcomes[cid] = (outcomes[cid][0], outcomes[cid][1], deps)
   383	    # no cycle among the candidates of one answer (06-views: 会的话这条不收，退回给模型改)
   384	    graph = {cid: [d['view_id'] for d in outcomes[cid][2] if d['view_id'] in candidate_by_id] for cid in raw_deps if cid in outcomes}
   385	    for cid in graph:
   386	        stack, seen = list(graph[cid]), set()
   387	        while stack:
   388	            current = stack.pop()
   389	            if current == cid:
   390	                refusals.append(f'candidate {cid}: its dependencies lead back to itself')
   391	                break
   392	            if current in seen:
   393	                continue
   394	            seen.add(current)
   395	            stack.extend(graph.get(current, []))
   396	    _, coalescing_errors = identity.batch_plan(candidates, outcomes)
   397	    refusals.extend(coalescing_errors)
   398	    evidence_out = {}
   399	    answered_e = {(d['id'], d['view_id']): d for d in decisions.get('evidence', [])}
   400	    shown_evidence = {e for listed in lists.evidence_lists.values() for e in listed}      # every evidence id this request shows the model
   401	    for key, listed in lists.evidence_lists.items():
   402	        d = answered_e.get(key)
   403	        if not d:
   404	            refusals.append(f'evidence {key[0]} under {key[1]} has no decision')
   405	            continue
   406	        outcome, target = d['outcome'], d['target_evidence_id'].strip()
   407	        if outcome in ('repeat', 'replace'):
   408	            # 06-views step 5: the target is a piece under the destination view. Its list shows that view's top N; a piece the
   409	            # request shows in another list is also a valid target when it is linked to this view (the model reads the whole request)
   410	            if target not in listed and not (target in shown_evidence and target in set(store.evidence_ids_under(conn, key[1]))):
   411	                refusals.append(f'evidence {key[0]}: target {target!r} not among {key[1]}\'s evidence shown')
   412	                continue
   413	            evidence_out[key] = (outcome, target, d['said_day'].strip())
   414	        else:
   415	            evidence_out[key] = ('new', None, d['said_day'].strip())
   416	    return Checked(outcomes, evidence_out, refusals, not_opened, notes)
     1	"""Research groups (D149, D165, D166): a group is one ongoing matter with a name, a scope and aliases, the names the
     2	matter goes by (products, projects, parties). Identity and membership are decided by code from those names, the way an
     3	object's aliases and a scope's aliases already are; the model only declares a matter that no stored group is, and may
     4	cite groups. A declaration whose aliases hit a stored group is that group; a thesis whose own text (focus, question,
     5	scope) carries a group's alias joins it, when the thesis itself tracks a matter; a company's own financial line joins only
     6	by the model's citation. Company names and tickers are never aliases: a company is not a group."""
     7	import json
     8	import re
     9	
    10	MIN_ALIAS = 3
    11	
    12	
    13	def clean_aliases(aliases, name, universe=None):
    14	    """The aliases a group may carry: its own name, the declared aliases, each at least three characters and not a
    15	    research object's id, name or alias (the company-folder guard at the alias level)."""
    16	    banned = set()
    17	    if universe is not None:         # a research object's id and names; its search aliases include product names, which groups may use
    18	        for record in list(universe.companies.values()) + list(universe.themes.values()):
    19	            banned.update(x.casefold() for x in (record['id'], record.get('name', ''), record.get('legacy_name', '')) if x)
    20	    out = []
    21	    for alias in [name] + list(aliases or []):
    22	        alias = re.sub(r'\s+', ' ', (alias or '')).strip()
    23	        if len(alias) < MIN_ALIAS or alias.casefold() in banned or alias.casefold() in {a.casefold() for a in out}:
    24	            continue
    25	        out.append(alias)
    26	    return out
    27	
    28	
    29	def hits(aliases, text):
    30	    """The aliases that occur in the text as whole words, case-insensitively."""
    31	    found = []
    32	    folded = text or ''
    33	    for alias in aliases or []:
    34	        if re.search(r'(?<![A-Za-z0-9])' + re.escape(alias) + r'(?![A-Za-z0-9])', folded, re.I):
    35	            found.append(alias)
    36	    return found
    37	
    38	
    39	def candidate_text(c):
    40	    return ' '.join(str(c.get(k) or '') for k in ('looks_at', 'question', 'scope'))
    41	
    42	
    43	def stored_groups(conn):
    44	    from . import store
    45	    return [store._group_record(r) for r in conn.execute('select * from thesis_groups order by rowid')]
    46	
    47	
    48	def plan(declared, existing, candidates, new_views, tracks_a_matter, universe=None):
    49	    """Decide, before any write, which declarations become groups, which are a stored group under another name, and
    50	    every membership of the theses being written.
    51	
    52	    declared: the handover's new_groups [{id, name, scope, aliases}]; existing: stored_groups(conn); candidates: the
    53	    handover's candidates; new_views: candidate id -> view id for the theses this write creates. Returns
    54	    (creations, memberships, notes): creations = [{local_id, name, scope, aliases}] in declaration order;
    55	    memberships = [(view_id, group_key, basis)] where group_key is a stored group_id or a local id of a creation."""
    56	    notes = []
    57	    alias_index = {}                                  # casefolded alias -> stored group id
    58	    for g in existing:
    59	        for alias in g['aliases']:
    60	            alias_index.setdefault(alias.casefold(), g['group_id'])
    61	    redirected, creations, created_aliases = {}, [], {}
    62	    founders = {ref for c in candidates if c['id'] in new_views and tracks_a_matter(c) for ref in c.get('group_refs') or []}
    63	    for d in declared or []:
    64	        aliases = clean_aliases(d.get('aliases'), d['name'], universe)
    65	        same = [alias_index[a.casefold()] for a in aliases if a.casefold() in alias_index]
    66	        if same:
    67	            redirected[d['id']] = same[0]
    68	            notes.append(f'declared group {d["id"]} "{d["name"]}" is stored group {same[0]} by its names; not created')
    69	            continue
    70	        if d['id'] not in founders:
    71	            notes.append(f'declared group {d["id"]} "{d["name"]}" is cited by no written thesis that tracks a matter; not created')
    72	            continue
    73	        creations.append({'local_id': d['id'], 'name': d['name'], 'scope': d['scope'], 'aliases': aliases})
    74	        created_aliases[d['id']] = aliases
    75	    memberships, seen = [], set()
    76	
    77	    def add(view_id, key, basis):
    78	        if (view_id, key) not in seen:
    79	            seen.add((view_id, key))
    80	            memberships.append((view_id, key, basis))
    81	
    82	    for c in candidates:
    83	        if c['id'] not in new_views:
