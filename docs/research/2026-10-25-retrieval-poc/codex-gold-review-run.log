    68	class Ledger:
    69	    def __init__(self, label, path, items):
    70	        self.label, self.conn, self.items = label, connect(path), items
    71	        self.has_keys = has_table(self.conn, 'view_keys')
    72	        self.views = {r['view_id']: r for r in self.conn.execute('select * from views order by created_seq, rowid')}
    73	
    74	    def key(self, vid):
    75	        if not self.has_keys:
    76	            return None
    77	        k = self.conn.execute('select * from view_keys where view_id=?', (vid,)).fetchone()
    78	        return dict(k) if k else None
    79	
    80	    def card(self, vid):
    81	        v, k = self.views[vid], self.key(vid)
    82	        fields = ', '.join(f"{f}={k[f]}" for f in ('measure', 'scope', 'period_start', 'period_end', 'basis', 'unit', 'event_type')
    83	                           if k and k.get(f) not in (None, '', 'n/a'))
    84	        question = v['question'] if 'question' in v.keys() else ''
    85	        return f"{v['object_id']} | {v['looks_at']} | {question} | {fields}".strip(' |')
    86	
    87	    def tracks_a_matter(self, vid):
    88	        k = self.key(vid)
    89	        return (k or {}).get('measure') not in FINANCIAL_LINES
    90	
    91	    def initiating(self, vid):
    92	        try:
    93	            ev = self.conn.execute("select e.quote, s.input_id, s.publication_day from evidence e join evidence_links l on l.evidence_id=e.evidence_id "
    94	                                   "join evidence_sources s on s.evidence_id=e.evidence_id where l.view_id=? order by e.rowid, s.id limit 1", (vid,)).fetchone()
    95	        except sqlite3.OperationalError:
    96	            return None, None, None
    97	        return (ev['quote'], ev['input_id'], ev['publication_day']) if ev else (None, None, None)
    98	
    99	    def source_block(self, vid, with_window=True):
   100	        quote, input_id, day = self.initiating(vid)
   101	        if not quote:
   102	            return 'INITIATING SOURCE: (none stored)', False
   103	        window = self.items.window(input_id, quote) if with_window else None
   104	        return f"INITIATING SOURCE ({input_id}, {day})\nQUOTE: {quote}" + (f"\nSURROUNDING PASSAGE: {window}" if window else ''), bool(window)
   105	
   106	    def earlier_same_object(self, vid):
   107	        v = self.views[vid]
   108	        earlier = [u for u in self.views.values() if u['object_id'] == v['object_id'] and u['created_seq'] < v['created_seq']]
   109	        return [u['view_id'] for u in earlier[-MAX_EARLIER:]]
   110	
   111	    def groups(self):
   112	        return self.conn.execute('select * from thesis_groups order by rowid').fetchall() if has_table(self.conn, 'thesis_groups') else []
   113	
   114	    def group_card_at(self, group, seq):
   115	        """The group as it stood before sequence `seq`: name, scope, aliases and the member questions written before then."""
   116	        members = self.conn.execute('select v.looks_at from thesis_group_members m join views v on v.view_id=m.view_id where m.group_id=? and m.seq<? order by m.seq',
   117	                                    (group['group_id'], seq)).fetchall()
   118	        return (f"{group['name']}. Scope: {group['scope']} Also called: {', '.join(json.loads(group['aliases'] or '[]'))}. "
   119	                f"Member questions so far: {'; '.join(m['looks_at'] for m in members) or '(none yet)'}")
   120	
   121	    def stored_memberships(self):
   122	        out = collections.defaultdict(set)
   123	        if has_table(self.conn, 'thesis_group_members'):
   124	            for r in self.conn.execute('select view_id, group_id from thesis_group_members'):
   125	                out[r['view_id']].add(r['group_id'])
   126	        return out
