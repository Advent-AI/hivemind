   219	def _user_text_english(conn, item, candidates, evidence, lists, shown_views, extra_views=()):
   220	    parts = [f'Item: {item["input_id"]}, published {item["publication_day"]}, category {item["category"]}.']
   221	    if candidates:
   222	        parts.append('[Candidate theses]')
   223	        for c in candidates:
   224	            rungs = ' / '.join(f'{r["label"]}: {r["condition"]}' for r in c['rungs'])
   225	            listed = lists.candidate_lists.get(c['id'], [])
   226	            parts.append(f'- {c["id"]} ({c["kind"]}, object {c["object"]}, focus "{c["looks_at"]}", {c["year"]}, due {c["due_day"]}): {c["question"]}\n    Ladder: {rungs}\n    Its evidence: ' +
   227	                         '; '.join(e['one_line'] for e in evidence if e['id'] in c['evidence_ids'])[:1500])
   228	            if listed:
   229	                parts.append('    Existing theses found by search:\n' + '\n'.join('    · ' + describe_view(conn, v, english=True) for v in listed))
   230	            else:
   231	                parts.append('    Existing theses found by search: none.')
   232	    if shown_views:
   233	        parts.append('[Existing theses shown to the model at extraction]\n' + '\n'.join('· ' + describe_view(conn, v['view_id'], english=True) for v in shown_views))
   234	    for v in extra_views:
   235	        parts.append('· ' + describe_view(conn, v, english=True))
   236	    direct = [(e, vid) for e in evidence for vid in e['links'] if (e['id'], vid) in lists.evidence_lists]
   237	    if direct:
   238	        parts.append('[Evidence linked to existing theses, to compare with the evidence already under that thesis]')
   239	        for e, vid in direct:
   240	            parts.append(f'- {e["id"]} → {vid} [{e["tier"]}; {e["speaker"]}; {e["original_who"]} {e["original_day"]}] {e["one_line"]} | quote: {e["quote"][:300]}')
   241	            listed = lists.evidence_lists[(e['id'], vid)]
   242	            parts.append('    Already under that thesis:\n' + ('\n'.join('    · ' + describe_evidence(conn, x, english=True) for x in listed) if listed else '    · no evidence yet'))
   243	    parts.append('Return, per the JSON schema, each candidate\'s destination and dependencies, and one decision for every evidence → thesis pair listed above (id and view_id exactly as listed). Empty arrays when there is nothing. An absent target is an empty string.')
   244	    return '\n'.join(parts)
