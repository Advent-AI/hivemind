    49	def validate(answers, questions):
    50	    """The answers of a response against the request's questions; a list of problems."""
    51	    problems = []
    52	    if not isinstance(answers, dict) or set(answers) != set(questions):
    53	        return ['answer set differs from the questions asked']
    54	    for qid, question in questions.items():
    55	        answer = answers[qid]
    56	        if not isinstance(answer, dict) or answer.get('type') != question['type']:
    57	            problems.append(f'{qid}: answer type mismatch')
    58	            continue
    59	        if question['type'] == 'noul':
    60	            if not isinstance(answer.get('noul'), (int, float)) or not 0 <= answer['noul'] <= 1:
    61	                problems.append(f'{qid}: noul out of range')
    62	        elif question['type'] == 'choice':
    63	            probabilities = answer.get('probabilities')
    64	            if answer.get('choice') not in question['criteria'] or not isinstance(probabilities, dict) or set(probabilities) != set(question['criteria']):
    65	                problems.append(f'{qid}: choice or probabilities do not match the criteria')
    66	    return problems
