   108	
   109	
   110	def _words(text):
   111	    """Tokens for the within-view ranking: latin words and numbers, and character bigrams for Chinese runs (a
   112	    Chinese one-line has no spaces, so whole clauses would otherwise be single tokens that never overlap)."""
   113	    text = (text or '').lower()
   114	    words = set(re.findall(r'[a-z0-9]+(?:[.,][0-9]+)?%?', text))
   115	    for run in CJK_RUN.findall(text):
   116	        words.update(run[i:i + 2] for i in range(len(run) - 1))
   117	    return words
   118	
   119	
   120	def rank_evidence(conn, view_id, one_line, top_n):
   121	    """The view's evidence in force ranked by word overlap with the new piece's one-line (the within-view search)."""
   122	    pieces = store.evidence_in_force(conn, view_id)
   123	    target = _words(one_line)
   124	    scored = sorted(pieces, key=lambda p: -len(target & _words(p['one_line'] + ' ' + p['quote'])))
   125	    return [p['evidence_id'] for p in scored[:top_n]]
