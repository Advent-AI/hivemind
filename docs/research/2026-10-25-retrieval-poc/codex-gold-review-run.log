   408	def score(args):
   409	    out = ROOT / args.out
   410	    data = json.loads((out / 'results.json').read_text())
   411	    gold, items = json.loads((ROOT / GOLD).read_text()), Items(ITEMS)
   412	    md = [f"# Jev POC results ({data['model']}, threshold {data['threshold']}, {data['calls']} calls, {data['input_tokens']:,} input tokens, ${data['cost_usd']})", '']
   413	    rows_all = []
   414	    for label in sorted({r['ledger'] for r in data['per_thesis']}):
   415	        ledger = Ledger(label, LEDGERS[label], items)
   416	        gstates, dedup_of = gold_states(gold, label, ledger)
   417	        stored = ledger.stored_memberships()
   418	        rows, rep_pairs = [], collections.defaultdict(dict)
   419	        for r in data['per_thesis']:
   420	            if r['ledger'] != label:
   421	                continue
   422	            vid = r['view_id']
   423	            for variant in (('stored', 'clean') if ledger.groups() else ('clean',)):
   424	                state, target, p = decide(ledger, vid, r['answers'], variant)
   425	                rep_pairs[(vid, variant)][r['replicate']] = state
   426	                if r['replicate'] == 0:
   427	                    control = 'grouped' if stored.get(vid) else 'new'
   428	                    rows.append({'ledger': label, 'view_id': vid, 'looks_at': ledger.views[vid]['looks_at'], 'variant': variant, 'gold': gstates[vid],
   429	                                 'jev': state, 'target': target, 'p': p, 'control': control, 'tracks_a_matter': ledger.tracks_a_matter(vid),
   430	                                 'relevance': r['answers'].get('relevance', {}).get('noul'), 'windowed': r['windowed']})
   431	        rows_all += rows
   432	        md.append(f'## Ledger {label}: {len(ledger.views)} theses, {sum(1 for v in ledger.views if ledger.tracks_a_matter(v))} matter-tracking')
   433	        founders = {m['view_id'] for g in ledger.groups() for m in ledger.conn.execute(
   434	            'select view_id from thesis_group_members where group_id=? and seq<=?', (g['group_id'], g['created_seq']))}
   435	        for variant in sorted({r['variant'] for r in rows}):
   436	            sub = [r for r in rows if r['variant'] == variant and r['gold'] in STATES]
   437	            table, right, total = confusion(sub, 'gold', 'jev')
   438	            ctable, cright, ctotal = confusion(sub, 'gold', 'control')
   439	            md += [f'### Jev decisions, group cards = {variant} ({right}/{total} three-state agreement with the gold, target not checked)', table, '',
   440	                   f'### Control: the pipeline as stored ({cright}/{ctotal})', ctable, '']
   441	            # Judged scoring: the target matter must be one the gold requires; founders are the model's declaration, not a
   442	            # judge case under stored cards; single-member own matters are acceptable either way; disputed and unlabelled
   443	            # cases are reported, never scored.
   444	            verdicts = collections.Counter()
   445	            detail = []
   446	            for r in sub:
   447	                verdict, why = judge(gold, label, ledger, r, variant, founders, dedup_of)
   448	                r[f'verdict_{variant}'] = verdict
   449	                verdicts[verdict] += 1
   450	                if verdict not in ('right',):
   451	                    detail.append(f"- {verdict:10s} {r['view_id']} {r['looks_at'][:58]}: gold {r['gold']} → Jev {r['jev']} ({r['target']}, {r['p']}) {why}")
   452	            judged = verdicts['right'] + verdicts['wrong']
   453	            cverdicts = collections.Counter(judge_control(gold, label, ledger, r, founders) for r in sub)
   454	            cjudged = cverdicts['right'] + cverdicts['wrong']
   455	            md += [f"### Judged, cards = {variant}: Jev **{verdicts['right']}/{judged}** right on judged cases "
   456	                   f"(founder {verdicts['founder']}, own matter {verdicts['own_matter']}, disputed {verdicts['disputed']}, unlabelled {verdicts['unlabelled']} set aside); "
   457	                   f"control **{cverdicts['right']}/{cjudged}** on its judged cases (disputed {cverdicts['disputed']}, own matter {cverdicts['own_matter']} set aside)", '']
   458	            md += detail + ['']
   459	        if any(len(v) == 2 for v in rep_pairs.values()):
   460	            pairs = [v for v in rep_pairs.values() if len(v) == 2]
   461	            agree = sum(1 for v in pairs if v[0] == v[1])
   462	            md += [f'### Repeatability: {agree}/{len(pairs)} three-state decisions identical across two fresh replicates', '']
   463	        dangling_gold = sum(1 for r in rows if r['variant'] == rows[0]['variant'] and r['tracks_a_matter'] and r['gold'] == 'new')
   464	        dangling_jev = sum(1 for r in rows if r['variant'] == rows[0]['variant'] and r['tracks_a_matter'] and r['jev'] == 'new')
   465	        dangling_ctl = sum(1 for r in rows if r['variant'] == rows[0]['variant'] and r['tracks_a_matter'] and r['control'] == 'new')
   466	        md += [f'Dangling matter-tracking theses (state new): control {dangling_ctl}, Jev {dangling_jev}, gold {dangling_gold}.', '']
   467	        md.append('### Relevance diagnostic (noul, matter-tracking theses, lowest first; D154: measured, not applied)')
   468	        for r in sorted((r for r in rows if r['variant'] == rows[0]['variant'] and r['tracks_a_matter'] and r['relevance'] is not None), key=lambda r: r['relevance'])[:12]:
   469	            md.append(f"- {r['relevance']:.2f} {r['view_id']} {r['looks_at'][:70]}")
   470	        md.append('')
   471	    if any(r['ledger'] == 'G' for r in rows_all):
   472	        g1 = ['v1', 'v4', 'v5', 'v12', 'v18', 'v19', 'v20', 'v39', 'v42']
   473	        md.append('## F1 diagnostic: the fused g1 members against the clean Rubin and capex cards (p)')
   474	        md.append('| thesis | rubin_rollout | hyperscaler_capex_cycle |')
   475	        md.append('|---|---:|---:|')
   476	        answers = {r['view_id']: r['answers'] for r in data['per_thesis'] if r['ledger'] == 'G' and r['replicate'] == 0}
   477	        for vid in g1:
   478	            a = answers.get(vid, {})
   479	            md.append(f"| {vid} | {a.get('clean__rubin_rollout', {}).get('noul', '—')} | {a.get('clean__hyperscaler_capex_cycle', {}).get('noul', '—')} |")
   480	        md.append('')
   481	    if data['identity']:
   482	        labels = list(RELATIONS)
   483	        table = collections.Counter((r['gold'], r['choice']) for r in data['identity'])
   484	        md += ['## Identity on the gold pairs (five-way)', '| gold \\ Jev | ' + ' | '.join(labels) + ' |', '|---|' + '---|' * len(labels)]
   485	        gold_map = {'same': 'same_quantity_or_event', 'part_of': 'part_of', 'related_not_same': 'same_matter_different_quantity', 'different': 'different'}
   486	        for g in ('same', 'part_of', 'related_not_same', 'different'):
   487	            md.append(f'| {g} | ' + ' | '.join(str(table[(g, l)]) for l in labels) + ' |')
   488	        exact = sum(1 for r in data['identity'] if r['choice'] == gold_map[r['gold']])
   489	        binary = sum(1 for r in data['identity'] if (r['choice'] == 'same_quantity_or_event') == (r['gold'] == 'same'))
   490	        md += ['', f"Exact label {exact}/{len(data['identity'])}; binary same/not-same {binary}/{len(data['identity'])}.", '']
   491	        for r in data['identity']:
   492	            if r['choice'] != gold_map[r['gold']]:
   493	                md.append(f"- {r['ledger']} {r['pair'][0]}/{r['pair'][1]}: gold {r['gold']} → Jev {r['choice']} {r['probabilities']}")
   494	    (out / 'summary.md').write_text('\n'.join(md) + '\n')
   495	    (out / 'decisions.json').write_text(json.dumps(rows_all, indent=1, ensure_ascii=False) + '\n')
   496	    print('\n'.join(md))
   497	
