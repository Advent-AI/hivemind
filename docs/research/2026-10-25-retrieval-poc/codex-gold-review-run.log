    61	                errors.append(f"- {key}: {outcome} right, target not acceptable: {text[:80]}")
    62	            else:
    63	                right += 1
    64	                per_class[g['gold']][0] += 1
    65	        total = right + wrong_kind + wrong_target
    66	        print(f"\n{label}: {right}/{total} right ({wrong_kind} wrong kind, {wrong_target} wrong target, {missing} not decided in this ledger)")
    67	        for cls in ('repeat', 'replace', 'new'):
