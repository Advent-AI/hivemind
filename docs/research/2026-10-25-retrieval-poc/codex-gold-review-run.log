   290	def matter_labels(gold, label, vid):
   291	    """(required matters, optional matters, forbidden matters, labelled?) for one thesis in one ledger."""
   292	    required, optional, forbidden = set(), set(), set()
   293	    for name, g in gold['groups'].items():
   294	        if 'matter' not in g:
   295	            continue
   296	        if vid in g.get('members_required', {}).get(label, []):
   297	            required.add(name)
   298	        if vid in g.get('members_optional', {}).get(label, []):
   299	            optional.add(name)
   300	        if vid in g.get('members_forbidden', {}).get(label, []):
   301	            forbidden.add(name)
   302	    return required, optional, forbidden
   303	
   304	
   305	def own_matter(gold, label, vid):
   306	    return vid in gold['groups'].get('separate_company_matters', {}).get(label, {})
   307	
   308	
   309	FULLY_LABELLED = {'G', 'E'}    # ledgers whose gold names every matter's required and forbidden members; C labels two matters only
   310	
   311	
   312	def disputed(gold, label, ledger, vid):
   313	    """A gold label Alex has to settle: the Vera CPU membership, and every company capex line the gold requires in the capex
   314	    cycle while D165 and `FINANCIAL_LINES` keep it out of every group (the pipeline never asks it)."""
   315	    if any(d.get('ledger') == label and vid in d.get('views', []) for d in gold.get('_disputes', [])):
   316	        return True
   317	    required, _, _ = matter_labels(gold, label, vid)
   318	    return bool(required) and (ledger.key(vid) or {}).get('measure') in FINANCIAL_LINES
   319	
   320	
   321	def unlabelled(gold, label, ledger, vid, decided_matters=frozenset()):
   322	    """In a partially labelled ledger, a matter-tracking thesis whose gold labels cannot judge the decision taken: no label at
   323	    all, or only forbidden labels while the decision names none of those matters (a `new`, or a grouping into an unlabelled
   324	    matter). Set aside for whichever arm took that decision."""
   325	    if label in FULLY_LABELLED or not ledger.tracks_a_matter(vid) or own_matter(gold, label, vid):
   326	        return False
   327	    required, optional, forbidden = matter_labels(gold, label, vid)
   328	    if required or optional:
   329	        return False
   330	    return not (forbidden & set(decided_matters))
   331	
   332	
   333	def stored_group_matters(gold, group_id):
   334	    """Which gold matters a stored G group stands for (g1 fuses two; g2 and g4 are both the China controls)."""
   335	    return {'g1': {'rubin_rollout', 'hyperscaler_capex_cycle'}, 'g2': {'china_chip_export_controls'}, 'g4': {'china_chip_export_controls'},
   336	            'g3': {'own:intel'}, 'g5': {'own:globalstar'}}.get(group_id, set())
   337	
   338	
   339	def judge(gold, label, ledger, r, variant, founders, dedup_of):
   340	    vid, state, target = r['view_id'], r['jev'], r['target']
   341	    if disputed(gold, label, ledger, vid):
   342	        return 'disputed', '(gold label disputed: Vera CPU, or a company capex line the gold requires against D165)'
   343	    if variant == 'stored' and vid in founders and r['gold'] == 'grouped':
   344	        return 'founder', '(founded its group in the same input; nothing to judge against)'
   345	    decided = (stored_group_matters(gold, target) if variant == 'stored' else {target}) if state == 'grouped' else set()
   346	    if r['gold'] != 'dedup' and state != 'dedup' and unlabelled(gold, label, ledger, vid, decided):
   347	        return 'unlabelled', '(the gold cannot judge this decision in this ledger)'
   348	    if r['gold'] == 'dedup':
   349	        return ('right', '') if state == 'dedup' and target in {dedup_of[vid]} | {v for v, o in dedup_of.items() if o == dedup_of[vid]} else ('wrong', f'(duplicate of {dedup_of[vid]})')
   350	    if state == 'dedup':
   351	        return 'wrong', '(false duplicate)'
   352	    required, optional, forbidden = matter_labels(gold, label, vid)
   353	    if state == 'grouped':
   354	        matters = stored_group_matters(gold, target) if variant == 'stored' else {target}
   355	        if matters & required:
   356	            return 'right', ''
   357	        if matters & optional:
   358	            return 'optional', '(gold abstains on this membership)'
   359	        if matters & forbidden:
   360	            return 'wrong', '(forbidden membership)'
   361	        if own_matter(gold, label, vid):
   362	            return 'wrong', '(an own matter pulled into another)'
   363	        if required:
   364	            return 'wrong', f'(required in {sorted(required)})'
   365	        return 'wrong', '(grouped where the gold says new)'
   366	    # state new
   367	    if own_matter(gold, label, vid):
   368	        return 'own_matter', ''
   369	    if required:
   370	        return 'wrong', f'(required in {sorted(required)})'
   371	    return 'right', ''
   372	
   373	
   374	def judge_control(gold, label, ledger, r, founders):
   375	    vid = r['view_id']
   376	    if disputed(gold, label, ledger, vid):
   377	        return 'disputed'
   378	    if r['gold'] == 'dedup':
   379	        return 'wrong'          # the pipeline wrote it as a separate thesis
   380	    required, optional, forbidden = matter_labels(gold, label, vid)
   381	    stored = ledger.stored_memberships().get(vid, set())
   382	    if unlabelled(gold, label, ledger, vid, set().union(*(stored_group_matters(gold, g) for g in stored)) if stored else set()):
   383	        return 'unlabelled'
   384	    if stored:
   385	        matters = set().union(*(stored_group_matters(gold, g) for g in stored))
   386	        if matters & required:
   387	            return 'right'
   388	        if own_matter(gold, label, vid) or any(m.startswith('own:') for m in matters):
   389	            return 'own_matter'
   390	        if matters & optional:
   391	            return 'optional'
   392	        return 'wrong'
   393	    if own_matter(gold, label, vid):
   394	        return 'own_matter'
   395	    return 'wrong' if required else 'right'
   396	
