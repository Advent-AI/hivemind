    35	def main():
    36	    ap = argparse.ArgumentParser()
    37	    ap.add_argument('--gold', required=True)
    38	    ap.add_argument('--ledger', action='append', required=True, help='label=path, repeatable')
    39	    args = ap.parse_args()
    40	    gold = json.loads((ROOT / args.gold).read_text())['decisions']
    41	    judged = {k: v for k, v in gold.items() if not v.get('uncertain')}
    42	    print(f"gold: {len(gold)} decisions, {len(judged)} judged, {len(gold) - len(judged)} uncertain; by class "
    43	          f"{dict(collections.Counter(v['gold'] for v in judged.values()))}")
    44	    for spec in args.ledger:
    45	        label, path = spec.split('=', 1)
    46	        got = decisions(ro(ROOT / path / 'views.sqlite'))
    47	        right = wrong_kind = wrong_target = missing = 0
    48	        per_class = collections.defaultdict(lambda: [0, 0])
    49	        errors = []
    50	        for key, g in judged.items():
    51	            if key not in got:
    52	                missing += 1
    53	                continue
    54	            outcome, text = got[key]
    55	            per_class[g['gold']][1] += 1
