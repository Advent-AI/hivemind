    47	class Items:
    48	    def __init__(self, path):
    49	        self.conn = connect(path)
    50	
    51	    def window(self, input_id, quote, radius=600):
    52	        """The quote's surroundings in its source: ±radius characters, cut back to sentence boundaries. A fixed rule."""
    53	        row = self.conn.execute('select text from items where input_id=?', (input_id,)).fetchone()
    54	        if not row or not row['text'] or not quote:
    55	            return None
    56	        text = row['text']
    57	        i = text.find(quote[:60])
    58	        if i < 0:
    59	            return None
    60	        a, b = max(0, i - radius), min(len(text), i + len(quote) + radius)
    61	        if a:
    62	            a = max(text.rfind('. ', 0, a) + 2, 0)
    63	        e = text.find('. ', b)
    64	        b = e + 1 if e > 0 else b
    65	        return text[a:b]
