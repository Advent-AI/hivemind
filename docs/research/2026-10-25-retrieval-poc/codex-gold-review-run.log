   208	def decide(ledger, vid, answers, variant):
   209	    """Code's three-state rule over Jev's answers: dedup if some earlier thesis is `same` (p ≥ threshold) and the keys allow a
   210	    merge; else grouped if some visible group card (stored or clean, per variant) scores ≥ threshold; else new."""
   211	    key = ledger.key(vid)
   212	    best_same, same_target = 0.0, None
   213	    for qid, ans in answers.items():
   214	        if not qid.startswith('rel__'):
   215	            continue
   216	        p = (ans.get('probabilities') or {}).get('same_quantity_or_event', 0.0)
   217	        target = qid[len('rel__'):]
   218	        other = ledger.key(target)
   219	        gate = conflicts(key, other, merging=True) if key and other and key.get('measure') and other.get('measure') else False
   220	        if ans.get('choice') == 'same_quantity_or_event' and p >= THRESHOLD and not gate and p > best_same:
   221	            best_same, same_target = p, target
   222	    if same_target:
   223	        return 'dedup', same_target, best_same
   224	    if ledger.tracks_a_matter(vid):
   225	        prefix = 'stored__' if variant == 'stored' else 'clean__'
   226	        hits = sorted(((ans.get('noul', 0.0), qid[len(prefix):]) for qid, ans in answers.items() if qid.startswith(prefix)), reverse=True)
   227	        if hits and hits[0][0] >= THRESHOLD:
   228	            return 'grouped', hits[0][1], hits[0][0]
   229	    return 'new', None, None
