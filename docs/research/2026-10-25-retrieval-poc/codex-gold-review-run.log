   128	def _same_key(key, c, view_object=None):
   129	    """Only a complete, corrected, code-owned key authorizes automatic identity."""
   130	    target = identity.automatic_key(c)
   131	    return target is not None and bool(key) and identity.automatic_key(key, view_object) == target
