   266	@dataclasses.dataclass
   267	class Checked:
   268	    outcomes: dict         # candidate id -> (outcome, target or None, dependencies list)
   269	    evidence: dict         # (evidence id, view_id) -> (outcome, target_evidence_id or None, said_day)
   270	    refusals: list
   271	    not_opened: dict       # candidate id -> reason
   272	    notes: list = dataclasses.field(default_factory=list)
