   134	def key_matches(conn, c):
   135	    """keyed-views-plan.md 2.5: the open views a keyed candidate must be confirmed against (same object, measure and scope,
   136	    overlapping period); empty for a candidate without a key."""
   137	    if not c.get('measure'):
   138	        return []
   139	    from .. import universe as _universe
   140	    # a model-written scope is wording, not identity: such a candidate is compared with every open view of its measure and period
   141	    scope_key = _universe.scope_key(c.get('scope', '')) if c.get('scope_source') in ('none', 'watch') else None
   142	    return store.open_views_with_key(conn, c['object'], c['measure'], scope_key, c.get('period_start', ''), c.get('period_end', ''), c.get('basis', 'n/a'), c.get('unit', 'n/a'), c.get('event_type', 'n/a'))
   143	
   144	
   145	def build_lists(conn, handover, shown_views, top_n):
   146	    candidate_lists = {}
   147	    for c in handover.candidates:
   148	        same_key = key_matches(conn, c)
   149	        if same_key:                      # a keyed candidate is compared with the views that share its key, a narrow question
   150	            exact = store.exact_key_views(conn, c)
   151	            candidate_lists[c['id']] = list(dict.fromkeys(exact + same_key))[:top_n]
   152	            continue
   153	        hits = store.search_views(conn, f'{c["object"]} {c["looks_at"]} {c["question"]}', top_n)
   154	        for v in shown_views:
   155	            if v['view_id'] not in hits and v['object_id'] == c['object']:
   156	                hits.append(v['view_id'])
   157	        candidate_lists[c['id']] = hits[:top_n]
   158	    evidence_lists = {}
   159	    candidate_ids = {c['id'] for c in handover.candidates}
   160	    for e in handover.evidence:
   161	        for view_id in e['links']:
   162	            if view_id in candidate_ids:
   163	                continue
   164	            evidence_lists[(e['id'], view_id)] = rank_evidence(conn, view_id, e['one_line'], top_n)
   165	    return Lists(candidate_lists, evidence_lists)
