    69	def ask(archive, cfg, setting, state, questions, purpose, *, transport=None):
    70	    """One Jev request, archived; returns model.Answer whose data is the `answers` map."""
    71	    request = {'model': setting.model, 'state': state, 'questions': questions}
    72	    request_json = json.dumps(request, sort_keys=True, ensure_ascii=False)
    73	    sha = hashlib.sha256(request_json.encode('utf-8')).hexdigest()
    74	    prompt_chars = len(request_json)
    75	    hit = archive.lookup(sha)
    76	    if hit:
    77	        call_id, answer_json, _, input_tokens, output_tokens = hit
    78	        return model.Answer(json.loads(answer_json), call_id, sha, True, prompt_chars, input_tokens or 0, output_tokens or 0, 0.0)
    79	    started = time.time()
    80	    response = (transport or globals()['transport'])(request)
    81	    seconds = round(time.time() - started, 2)
    82	    answers = response.get('answers') if isinstance(response, dict) else None
    83	    problems = validate(answers, questions)
