   168	def describe_view(conn, view_id, english=False):
   169	    v = store.view(conn, view_id)
   170	    successor = conn.execute('select view_id from successions where succeeds=?', (view_id,)).fetchone()
   171	    if english:
   172	        rungs = ' / '.join(f'{r["label"]}: {r["condition"]}' for r in store.rungs_of(conn, view_id))
   173	        state = 'open' if store.is_open(conn, view_id) else 'closed'
   174	        tail = f'; successor already exists: {successor["view_id"]}' if successor else ''
   175	        groups = store.groups_of_view(conn, view_id)
   176	        tail += f'; research group: ' + ', '.join(f'{g["group_id"]} "{g["name"]}"' for g in groups) if groups else ''
   177	        return f'{view_id} ({state}, {v["object_id"]}, {v["kind"]}, focus "{v["looks_at"]}", {v["year"] or ""}, due {v["due_day"]}): {v["question"]}\n    Ladder: {rungs}{tail}'
   178	    rungs = ' / '.join(f'{r["label"]}：{r["condition"]}' for r in store.rungs_of(conn, view_id))
   179	    state = '开着' if store.is_open(conn, view_id) else '关了'
   180	    tail = f'；已有下一期 {successor["view_id"]}' if successor else ''
   181	    return f'{view_id}（{state}，{v["object_id"]}，{v["kind"]}，看的是「{v["looks_at"]}」，{v["year"] or ""}，到期 {v["due_day"]}）：{v["question"]}\n    梯子：{rungs}{tail}'
   182	
