EXAMPLE handovers {'id': 1, 'input_id': 'truenorth:transcript:NVDA:2026-02-25', 'seq': 1, 'handover_json': '{"evidence": [{"id": "e1", "quote": "Total revenue of $68 billion was up 73% year-over-year, accelerating from Q3.", "one_line": "NVIDIA CFO Colette Kress reported Q4 FY2026 total revenue of $68 billion, up 73% year over year.", "speaker": "Colette Kress, NVIDIA CFO", "original_who": "", "original_day": "", "tier": "fact", "event_time": "Q4 FY2026", "links": ["c1"]}, {"id": "e2", "quote": "On a full year basis, data center generated revenue of $194 billion, up 68% year-over-year.", "one_line": "NVIDIA CFO Colette Kress reported FY2026 data-center revenue of $194 billion, up 68% year over year.", "speaker": "Colette Kress, NVIDIA CFO", "original_who": "", "original_day": "", "tier": "fact", "event_time": "FY2026", "links": ["c2"]}, {"id": "e3", "quote": "We look ahead, we expect sequential revenue growth throughout calendar 2026, exceeding what was included in the $500 billion Blackwell and Rubin revenue opportunity we shared last year.", "one_line": "NVIDIA CFO Colette Kress said the company expects sequential revenue growth throughout calendar 2026 and expects revenue to exceed the previously shared $500 billion Blackwell and Rubin opportunity.", "speaker": "Colette Kress, NVIDIA CFO", "original_who": "", "original_day": "", "tier": "party_statement", "event_time": "Calendar 2026", "links": ["c1", "c3"]}, {"id": "e4", "quote": "We believe we have inventory and supply commitments in place to address future demand, including shipments extending into calendar 2027.", "one_line": "NVIDIA CFO Colette Kress said NVIDIA believes its inventory and supply commitments can address demand, with shipments extending into calendar 2027.", "speaker": "Colette Kress, NVIDIA CFO", "original_who": "", "original_day": "", "tier": "party_statement", "event_time": "Calendar 2027", "links": ["c1", "c2"]}, {"id": "e5", "quote": "We unveiled the Rubin platform last month at CES comprised of 6 new chips, the Vera CPU, Rubin GPU, NVLink 6 Switch, ConnectX-9 SuperNIC, BlueField-4 DPUs and Spectrum-6 Ethernet switch.", "one_line": "NVIDIA CEO Jensen Huang said the Rubin platform unveiled at CES comprises six chips, including Vera CPU, Rubin GPU, NVLink 6 Switch, ConnectX-9 SuperNIC, BlueField-4 DPUs and Spectrum-6 Ethernet switch.", "speaker": "Jen-Hsun Huang, NVIDIA CEO", "original_who": "", "original_day": "", "tier": "party_statement", "event_time": "January 2026", "links": ["c4"]}, {"id": "e6", "quote": "We shipped our first Vera Rubin samples to customers earlier this week, and we remain on track to commence production shipments in the second half of the year.", "one_line": "NVIDIA management said it shipped initial Vera Rubin samples to customers and remains on track to begin production shipments in H2 2026.", "speaker": "Colette Kress, NVIDIA CFO", "original_who": "", "original_day": "", "tier": "party_statement", "event_time": "H2 2026", "links": ["c4"]}, {"id": "e7", "quote": "For the full year, we continue to see gross margins in the mid-70s.", "one_line": "NVIDIA CFO Colette Kress said the company expects FY2027 gross margins in the mid-70s.", "speaker": "Colette Kress, NVIDIA CFO", "original_who": "", "original_day": "", "tier": "party_statement", "event_time": "FY2027", "links": ["c5"]}, {"id": "e8", "quote": "For the full year, we expect non-GAAP operating expenses to grow in the low 40s on a year-over-year basis as we continue to invest in our expanding opportunity set.", "one_line": "NVIDIA CFO Colette Kress said FY2027 non-GAAP operating expenses are expected to grow in the low 40s percent year over year.", "speaker": "Colette Kress, NVIDIA CFO", "original_who": "", "original_day": "", "tier": "party_statement", "event_time": "FY2027", "links": ["c6"]}, {"id": "e9", "quote": "For the full year fiscal year \'27, we expect GAAP and non-GAAP tax rates to be in between 7% and 19%, excluding any discrete items and material changes to our tax environment.", "one_line": "NVIDIA CFO Colette Kress said FY2027 GAAP and non-GAAP tax rates are expected to be 7%–19%, excluding discrete items and material tax-environment changes.", "speaker": "Colette Kress, NVIDIA CFO", "original_who": "", "original_day": "", "tier": "party_statement", "event_time": "FY2027", "links": ["c7"]}, {"id": "e10", "quote": "While small amounts of H200 products for China-based customers were approved by the U.S. government, we have yet to generate any revenue. And we do not know whether any imports will be allowed into China.", "one_line": "NVIDIA CFO Colette Kress said the U.S. government approved small amounts of H200 products for China-based customers, but NVIDIA had generated no revenue and did not know whether imports into China would be allowed.", "speaker": "Colette Kress, NVIDIA CFO", "original_who": "", "original_day": "", "tier": "party_statement", "event_time": "As of 2026-02-25", "links": ["c8"]}, {"id": "e11", "quote": "Analyst expectations for 2026 CapEx across the top 5 cloud providers and hyperscalers who collectively account for a little over 50% of our data center revenue are up nearly $120 billion since the start of the year and approaching $700 billion.", "one_line": "NVIDIA CFO Colette Kress said analyst expectations for 2026 capex at the top five cloud providers and hyperscalers had risen nearly $120 billion since the start of the year and were approaching $700 billion.", "speaker": "Colette Kress, NVIDIA CFO", "original_who": "Analysts", "original_day": "2026-02-25", "tier": "third_party_view", "event_time": "Calendar 2026", "links": ["c9"]}, {"id": "e12", "quote": "In fiscal year 2026, our sovereign AI business more than tripled year-over-year and over $30 billion, driven primarily by customers based in Canada, France, the Netherlands, Singapore and the U.K.", "one_line": "NVIDIA CFO Colette Kress said FY2026 sovereign AI business revenue exceeded $30 billion and more than tripled year over year.", "speaker": "Colette Kress, NVIDIA CFO", "original_who": "", "original_day": "", "tier": "fact", "event_time": "FY2026", "links": ["c10"]}, {"id": "e13", "quote": "Last week, we announced that Meta is deploying millions of Blackwells and Rubin GPUs, NVIDIA CPUs and Spectrum x Ethernet for training and inference.", "one_line": "NVIDIA CEO Jensen Huang said Meta announced it is deploying millions of Blackwell and Rubin GPUs, NVIDIA CPUs and Spectrum-X Ethernet for training and inference.", "speaker": "Jen-Hsun Huang, NVIDIA CEO", "original_who": "Meta", "original_day": "2026-02-18", "tier": "party_statement", "event_time": "2026-02-18", "links": ["c4"]}], "candidates": [{"id": "c1", "object": "NVDA", "kind": "asset", "looks_at": "NVIDIA consolidated annual revenue", "question": "Can sustained AI infrastructure demand and sequential growth through calendar 2026 drive NVIDIA FY2027 total revenue into which range?", "rungs": [{"label": "Strongly bullish", "condition": "FY2027 total revenue is at least $400 billion.", "lo": 400000000000, "hi": null}, {"label": "Bullish", "condition": "FY2027 total revenue is at least $350 billion and below $400 billion.", "lo": 350000000000, "hi": 400000000000}, {"label": "Neutral", "condition": "FY2027 total revenue is at least $300 billion and below $350 billion.", "lo": 300000000000, "hi": 350000000000}, {"label": "Bearish", "condition": "FY2027 total revenue is at least $250 billion and below $300 billion.", "lo": 250000000000, "hi": 300000000000}, {"label": "Strongly bearish", "condition": "FY2027 total revenue is below $250 billion.", "lo": null, "hi": 250000000000}], "due_day": "2027-02-24", "year": "FY2027", "evidence_ids": ["e1", "e3", "e4"], "measure": "total_revenue", "scope": "NVIDIA consolidated", "period_start": "2026-02-01", "period_end": "2027-01-31", "basis": "GAAP", "unit": "USD", "event_type": "n/a", "group_refs": [], "scope_source": "model", "key_version": 2}, {"id": "c2", "object": "NVDA", "kind": "asset", "looks_at": "Data C