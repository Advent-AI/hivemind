   214	def decide(archive, cfg, conn, item, candidates, evidence, lists, shown_views, *, extra_views=(), retry_note='', transport=None, llm_transport=None, workers=1):
   215	    data = {'candidates': [], 'evidence': []}
   216	    total = Decision(data, 0, '', True, 0, 0, 0, 0.0)
   217	    shas = []
   218	    jobs, candidate_jobs, evidence_jobs = [], [], []
   219	    # All database reads and request construction stay on the coordinator thread.
   220	    for c in candidates:
   221	        listed = list(dict.fromkeys(list(lists.candidate_lists.get(c['id'], [])) + [v['view_id'] for v in shown_views]))
   222	        fixed = shared_quantity_target(conn, c)                       # D197: code decides a shared quantity's destination; Jev is not asked its relations
   223	        questions = {} if fixed else {f'rel__{v}': relation_question(thesis_text(conn, v)) for v in listed}
   224	        groups = store.groups_for_prompt(conn, [c['object']], f'{c["looks_at"]} {c["question"]}')
   225	        for g in groups:
   226	            questions[f'member__{g["group_id"]}'] = member_question(group_text(g))
   227	        candidate_jobs.append((c, listed, groups, len(jobs) if questions else None, fixed))
   228	        if questions:
   229	            jobs.append((candidate_state(c, evidence), questions))
   230	    for e in evidence:
   231	        pairs = [(e['id'], v) for v in e['links'] if (e['id'], v) in lists.evidence_lists]
   232	        if not pairs:
   233	            continue
   234	        questions = {f'piece__{v}__{x}': piece_question(matching.describe_evidence(conn, x, english=True)) for _, v in pairs for x in lists.evidence_lists[(e['id'], v)]}
   235	        said_day = e.get('original_day') or item['publication_day']
   236	        evidence_jobs.append((e, pairs, said_day, len(jobs)))
   237	        jobs.append((piece_state(e, said_day), questions))
   238	    replies = _answers(archive, cfg, jobs, workers, transport)
   239	
   240	    def answers_for(index):
   241	        answer = replies[index]
   242	        if answer is None:
   243	            return {}
   244	        total.cost_usd += answer.cost_usd
   245	        total.input_tokens += answer.input_tokens
   246	        total.output_tokens += answer.output_tokens
   247	        total.prompt_chars += answer.prompt_chars
   248	        total.cached = total.cached and answer.cached
   249	        total.call_id = answer.call_id
   250	        total.calls += 1
   251	        shas.append(answer.request_sha256)
   252	        total.request_records.append({'call_id': answer.call_id, 'request_sha256': answer.request_sha256})
   253	        return answer.data
   254	
   255	    for c, listed, groups, job_index, fixed in candidate_jobs:
   256	        answers = answers_for(job_index) if job_index is not None else {}
   257	        joined = [g['group_id'] for g in groups if answers[f'member__{g["group_id"]}']['noul'] >= THRESHOLD]
   258	        for group_id in joined:
   259	            if group_id not in (c.get('group_refs') or []) and group_id not in (c.get('jev_group_refs') or []):
   260	                c.setdefault('jev_group_refs', []).append(group_id)          # the writer records these with basis 'jev'
   261	        if fixed:                                                # D197: one aggregate per theme, measure and period; the wording is not identity
   262	            data['candidates'].append({'id': c['id'], 'outcome': fixed[0], 'target_view_id': fixed[1], 'dependencies': [],
   263	                                       'reason': f'shared quantity: {fixed[0]} by key (D197); groups joined: {joined or "none"}'})
   264	            continue
   265	        same = sorted(((answers[f'rel__{v}']['probabilities']['same_quantity_or_event'], v) for v in listed
   266	                       if answers[f'rel__{v}']['choice'] == 'same_quantity_or_event' and answers[f'rel__{v}']['probabilities']['same_quantity_or_event'] >= THRESHOLD),
   267	                      reverse=True)
   268	        reasons = '; '.join(f'{qid[5:]}: {_summary(a)}' for qid, a in answers.items() if qid.startswith('rel__'))
   269	        outcome, target = 'new', ''
   270	        for _, v in same:
   271	            # the key decides what 'the same' may mean: a different quantity is declined here; the same quantity for a later period is a
   272	            # succession (06-views), when the thesis has no successor yet; otherwise a merge into an open thesis
   273	            key = store.view_key(conn, v) if c.get('measure') else None
   274	            if key and identity.conflicts(key, c, merging=False):
   275	                continue
   276	            if key and identity.conflicts(key, c, merging=True):          # the same quantity for another period
   277	                if can_succeed(conn, v, key, c):
   278	                    outcome, target = 'succession', v
   279	                    break
   280	                continue
   281	            if store.is_open(conn, v):
   282	                outcome, target = 'merge', v
   283	                break
   284	        if outcome == 'new':
   285	            # the judge says 'the same quantity for another period'; code decides the direction, the typed fields and the successor
   286	            other = sorted(((answers[f'rel__{v}']['probabilities']['same_quantity_other_period'], v) for v in listed
   287	                            if answers[f'rel__{v}']['choice'] == 'same_quantity_other_period' and answers[f'rel__{v}']['probabilities']['same_quantity_other_period'] >= THRESHOLD),
   288	                           reverse=True)
   289	            for _, v in other:
   290	                key = store.view_key(conn, v) if c.get('measure') else None
   291	                if can_succeed(conn, v, key, c):
   292	                    outcome, target = 'succession', v
   293	                    break
   294	        if outcome == 'new':
   295	            successor_of = succession_target(conn, c, listed)
   296	            if successor_of:
   297	                outcome, target = 'succession', successor_of
   298	        peers = collision_peers(conn, c, listed) if getattr(cfg, 'collision', None) else []
   299	        judged = ''
   300	        if peers:
   301	            answer, verdicts = ask_collision_judge(archive, cfg, conn, candidate_state(c, evidence), peers, llm_transport)
   302	            total.cost_usd += answer.cost_usd
   303	            total.input_tokens += answer.input_tokens
   304	            total.output_tokens += answer.output_tokens
   305	            total.calls += 1
   306	            total.cached = total.cached and answer.cached
   307	            shas.append(answer.request_sha256)
   308	            total.request_records.append({'call_id': answer.call_id, 'request_sha256': answer.request_sha256})
   309	            judged = '; collision judge: ' + ', '.join(f'{v}: {verdicts.get(v, "(no answer)")}' for v in peers)
   310	            if target in peers and verdicts.get(target) not in ('same_question', 'same_question_other_period'):
   311	                outcome, target = 'new', ''                      # Jev's merge or succession on a peer the judge keeps apart
   312	            if outcome == 'new':
   313	                for v in peers:
   314	                    key = store.view_key(conn, v)
   315	                    if verdicts.get(v) == 'same_question' and not identity.conflicts(key, c, merging=False):
   316	                        if identity.conflicts(key, c, merging=True):
   317	                            if can_succeed(conn, v, key, c):
   318	                                outcome, target = 'succession', v
   319	                                break
   320	                            continue
   321	                        if store.is_open(conn, v):
   322	                            outcome, target = 'merge', v
   323	                            break
   324	                    if verdicts.get(v) == 'same_question_other_period' and can_succeed(conn, v, key, c):
   325	                        outcome, target = 'succession', v
   326	                        break
   327	        data['candidates'].append({'id': c['id'], 'outcome': outcome, 'target_view_id': target or '', 'dependencies': [],
   328	                                   'reason': f'jev: {reasons or "no list"}; groups joined: {joined or "none"}{judged}'})
   329	    for e, pairs, said_day, job_index in evidence_jobs:
   330	        answers = answers_for(job_index)
   331	        for _, v in pairs:
   332	            scored = [(answers[f'piece__{v}__{x}'], x) for x in lists.evidence_lists[(e['id'], v)]]
   333	            repeats = sorted(((a['probabilities']['same_statement'], x) for a, x in scored if a['choice'] == 'same_statement' and a['probabilities']['same_statement'] >= THRESHOLD), reverse=True)
   334	            replaces = sorted(((a['probabilities']['supersedes'], x) for a, x in scored if a['choice'] == 'supersedes' and a['probabilities']['supersedes'] >= THRESHOLD), reverse=True)
   335	            outcome, target = ('repeat', repeats[0][1]) if repeats else ('replace', replaces[0][1]) if replaces else ('new', '')
   336	            data['evidence'].append({'id': e['id'], 'view_id': v, 'outcome': outcome, 'target_evidence_id': target or '', 'said_day': said_day,
   337	                                     'reason': 'jev: ' + '; '.join(f'{x}: {_summary(a)}' for a, x in scored)})
   338	    total.request_sha256 = hashlib.sha256('+'.join(shas).encode('utf-8')).hexdigest() if shas else ''
   339	    return total
     1	"""D155: exact identity and same-answer coalescing, shared by matching and writing.
     2	
     3	D197: a shared quantity (a candidate admitted as industry_aggregate / shared_quantity, a key stored with scope_source
     4	'shared') is one thesis per theme, measure and period; its scope (the population or wording of the aggregate) is not
     5	part of its identity."""
     6	from ..universe import scope_key
     7	
     8	KEY_VERSION = 2
     9	SHARED_REASONS = ('industry_aggregate', 'shared_quantity')
    10	EVENT_MEASURES = ('event', 'policy_event')
    11	
    12	
    13	def is_shared(value):
    14	    """A shared quantity: by its admission reason on a candidate, by its stored scope source on a key."""
    15	    return value.get('measure') not in (None, 'other', *EVENT_MEASURES) and (value.get('scope_source') == 'shared' or value.get('opens_as') in SHARED_REASONS)
    16	
    17	
    18	def automatic_key(value, object_id=None):
    19	    """Return a complete, code-owned key, or None when identity still needs judgement."""
    20	    if value.get('key_version') != KEY_VERSION:
    21	        return None
    22	    if value.get('measure') in (None, 'other'):
    23	        return None
    24	    if is_shared(value):
    25	        return (object_id or value.get('object'), value['measure'], '', value.get('period_start'), value.get('period_end'),
    26	                value.get('basis'), value.get('unit'), value.get('event_type'))
    27	    if value.get('scope_source') not in ('none', 'watch'):
    28	        return None
    29	    if value['measure'] in EVENT_MEASURES and value.get('event_type') in (None, 'other', 'n/a'):
    30	        return None
    31	    return (object_id or value.get('object'), value['measure'], scope_key(value.get('scope', '')),
    32	            value.get('period_start'), value.get('period_end'), value.get('basis'), value.get('unit'), value.get('event_type'))
    33	
    34	
    35	def conflicts(key, candidate, *, merging):
    36	    """Known different quantities/events cannot merge; corrected scopes/periods bind only corrected keys."""
    37	    if key['measure'] != candidate['measure'] or key['event_type'] != candidate.get('event_type', 'n/a'):
    38	        return True
    39	    for field in ('basis', 'unit'):
    40	        a, b = key[field], candidate.get(field, 'n/a')
    41	        if a != 'n/a' and b != 'n/a' and a != b:
    42	            return True
    43	    if key.get('key_version') != KEY_VERSION or candidate.get('key_version') != KEY_VERSION:
    44	        return False
    45	    if (key.get('scope_source') in ('none', 'watch') and candidate.get('scope_source') in ('none', 'watch')
    46	            and scope_key(key['scope']) != scope_key(candidate.get('scope', ''))):
    47	        return True
    48	    return merging and (key['period_start'], key['period_end']) != (candidate.get('period_start'), candidate.get('period_end'))
    49	
    50	
    51	def batch_plan(candidates, outcomes):
    52	    """Resolve same-answer duplicates and validate dependencies on the resulting identities before retry ends."""
    53	    aliases, first_by_key, errors = {}, {}, []
    54	    for candidate in candidates:
    55	        cid = candidate['id']
    56	        outcome = outcomes.get(cid, ('skip', None, []))
    57	        if outcome[0] not in ('new', 'succession'):
    58	            continue
