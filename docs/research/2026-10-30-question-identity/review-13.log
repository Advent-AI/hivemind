    17	THRESHOLD = 0.5
    18	# D190: the collision judge. Jev reads wording and calls a population variant of one aggregate 'part of' (six 2026 aggregates on the r3
    19	# ledger, each judged 'new'); the generative model, asked the analyst's question, merged five of six. It is asked only for the theses of
    20	# the candidate's own object and measure, and its verdict on those replaces Jev's.
    21	COLLISION_RELATIONS = ['same_question', 'same_question_other_period', 'distinct_question_same_matter', 'different']
    22	COLLISION_SCHEMA = {'type': 'object', 'additionalProperties': False, 'required': ['relations'],
    23	                    'properties': {'relations': {'type': 'array', 'items': {'type': 'object', 'additionalProperties': False, 'required': ['thesis_id', 'relation', 'why'],
    24	                                   'properties': {'thesis_id': {'type': 'string'}, 'relation': {'type': 'string', 'enum': COLLISION_RELATIONS}, 'why': {'type': 'string'}}}}}}
    25	RELATIONS = {"same_quantity_or_event": "both ask about the same defined quantity or the same event: alternative wordings, or two estimates or figures of that one quantity",
    26	             "same_quantity_other_period": "the same defined quantity or event series for another period, such as the next fiscal or calendar year",
    27	             "part_of": "one asks about a strict component or subset of the other, in either direction; not identical",
    28	             "same_matter_different_quantity": "one ongoing matter, two distinct quantities or events, neither a component of the other",
    29	             "different": "different matters; sharing a company or industry is not enough",
    30	             "cannot_tell": "the supplied material is insufficient or inconsistent"}
    31	MEMBER_CRITERIA = {"true": "the CANDIDATE tracks this matter, one of its stated components, its implementation, or a deployment the supplied material connects to it",
    32	                   "false": "the supplied material shows a different matter, or a question outside the GROUP's stated scope"}
    33	# 06-views.md, the evidence table: repeat = "the same evidence already exists under the thesis: a retelling, the same number in text and
    34	# table, or the same speaker repeating the same statement"; replace = "a later account of the same matter: a speaker revises guidance,
    35	# forecast or event progress; an official confirms/denies a rumour; or the original source revises its statement". The criteria carry
    36	# those words; the first seed run (log row 35) read "same occasion" into them and missed six cross-document repeats.
    37	PIECES = {"same_statement": "the same evidence: a retelling, the same number stated in text and in a table or in another document, or the same speaker repeating the same statement; wording, precision and document may differ",
    38	          "supersedes": "a later version of the same statement or number, changed: the same speaker revises that guidance, forecast or event-progress statement, an official confirms or denies that reported claim, or the original source revises that statement; another statement on the same topic is not this",
    39	          "different": "a different fact, figure or matter, or a figure for another period or quantity, even if on the same topic"}
