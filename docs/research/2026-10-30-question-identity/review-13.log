    71	def group_text(group):
    72	    members = '; '.join(m['looks_at'] for m in group.get('members', []))
    73	    return f'{group["name"]}. Scope: {group["scope"]} Also called: {", ".join(group.get("aliases") or [])}. Member questions: {members or "(none yet)"}'
