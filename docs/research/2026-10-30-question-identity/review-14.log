   195	def collision_peers(conn, c, listed):
   196	    """The listed theses of the candidate's own object and measure: where one question may be held twice under other words."""
   197	    peers = []
   198	    for v in listed:
   199	        key = store.view_key(conn, v) if c.get('measure') else None
   200	        if key and key.get('measure') == c.get('measure') and (store.view(conn, v) or {}).get('object_id') == c['object']:
   201	            peers.append(v)
   202	    return peers
