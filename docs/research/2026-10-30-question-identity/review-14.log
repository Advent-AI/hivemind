   281	    answered = {d['id']: d for d in decisions.get('candidates', [])}
   282	    for c in candidates:
   283	        d = answered.get(c['id'])
   284	        if not d:
   285	            refusals.append(f'candidate {c["id"]} has no decision')
   286	            continue
   287	        outcome, target = d['outcome'], d['target_view_id'].strip()
   288	        listed = set(lists.candidate_lists.get(c['id'], [])) | shown_ids
   289	        if outcome in ('merge', 'succession') and target in candidate_by_id:
   290	            # a candidate cannot merge into another candidate of the same answer: only a stored thesis has a ladder and a due day to
   291	            # inherit. The model usually means "part of": both open, and the key coalesces them when they are the same quantity.
   292	            notes.append(f'candidate {c["id"]}: {outcome} into candidate {target} is not a destination; opened as a new view')
   293	            outcome, target = 'new', ''
   294	            d = dict(d, outcome=outcome, target_view_id='')
   295	        if outcome in ('merge', 'succession') and c.get('measure'):
   296	            # keyed-views-plan.md 2.5 rule 1: a different quantity, or another period, is never the same view, whatever the model says
   297	            target_key = store.view_key(conn, target) if target else None
   298	            target_view = store.view(conn, target) if target else None
   299	            if target_view and target_view['object_id'] != c['object']:
   300	                notes.append(f'candidate {c["id"]}: {outcome} into {target} refused: another object ({target_view["object_id"]} ≠ {c["object"]}); opened as a new view')
   301	                outcome, target, target_key = 'new', '', None
   302	                d = dict(d, outcome=outcome, target_view_id='')
   303	            if target_key and identity.conflicts(target_key, c, merging=outcome == 'merge'):
   304	                notes.append(f'candidate {c["id"]}: {outcome} into {target} refused by key ({target_key["measure"]}[{target_key["scope"]}] {target_key["period_start"]}..{target_key["period_end"]} ≠ {c["measure"]}[{c.get("scope", "")}] {c.get("period_start", "")}..{c.get("period_end", "")}); opened as a new view')
   305	                outcome, target = 'new', ''
   306	                d = dict(d, outcome=outcome, target_view_id='')
