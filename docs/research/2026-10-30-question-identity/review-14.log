   358	                    break
   359	                if view_id not in listed_all and view_id not in candidate_by_id:
   360	                    refusals.append(f'candidate {cid}: dependency {view_id} was not shown')
   361	                    bad = True
   362	                    break
   363	                if view_id == cid:
   364	                    refusals.append(f'candidate {cid}: depends on itself')
   365	                    bad = True
   366	                    break
   367	                deps.append({'view_id': view_id, 'wait_chain_view_id': None, 'wait_year': None, 'direction': dep['direction']})
   368	            elif chain and year:
   369	                if chain not in listed_all and chain not in candidate_by_id:
   370	                    refusals.append(f'candidate {cid}: waited chain {chain} was not shown')
   371	                    bad = True
   372	                    break
   373	                deps.append({'view_id': None, 'wait_chain_view_id': chain, 'wait_year': year, 'direction': dep['direction']})
   374	        if bad:
   375	            continue
   376	        outcomes[cid] = (outcomes[cid][0], outcomes[cid][1], deps)
   377	    # no cycle among the candidates of one answer (06-views: 会的话这条不收，退回给模型改)
   378	    graph = {cid: [d['view_id'] for d in outcomes[cid][2] if d['view_id'] in candidate_by_id] for cid in raw_deps if cid in outcomes}
