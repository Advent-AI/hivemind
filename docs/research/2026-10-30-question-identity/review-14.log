   317	                continue
   318	            if outcome == 'merge' and not store.is_open(conn, target):
   319	                refusals.append(f'candidate {c["id"]}: cannot attach to closed view {target}')
   320	                continue
   321	            if outcome == 'succession':
   322	                if conn.execute('select 1 from successions where succeeds=?', (target,)).fetchone():
   323	                    refusals.append(f'candidate {c["id"]}: {target} already has a successor')
   324	                    continue
   325	                first = succession_targets.get(target)
   326	                if first is not None and (identity.automatic_key(c) is None or identity.automatic_key(c) != identity.automatic_key(first)):
   327	                    refusals.append(f'candidate {c["id"]}: {target} can have one successor; {first["id"]} already succeeds it in this answer')
