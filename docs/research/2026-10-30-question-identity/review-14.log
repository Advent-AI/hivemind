   184	def _user_text_chinese(conn, item, candidates, evidence, lists, shown_views, extra_views=()):
   185	    parts = [f'信息：{item["input_id"]}，发布日 {item["publication_day"]}，类别 {item["category"]}。']
   186	    if candidates:
