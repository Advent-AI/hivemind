    39	                    input_id = user.split(marker, 1)[1].split(',', 1)[0]
    40	                    self.recorded[input_id] = json.loads(answer_json)         # the last recorded answer for the item
    41	        self.counts = {'extraction': 0, 'extraction_unrecorded': 0, 'collision': 0, 'judgement': 0, 'jev': 0}
