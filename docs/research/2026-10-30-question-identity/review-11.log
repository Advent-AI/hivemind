    51	def batch_plan(candidates, outcomes):
    52	    """Resolve same-answer duplicates and validate dependencies on the resulting identities before retry ends."""
    53	    aliases, first_by_key, errors = {}, {}, []
    54	    for candidate in candidates:
    55	        cid = candidate['id']
    56	        outcome = outcomes.get(cid, ('skip', None, []))
    57	        if outcome[0] not in ('new', 'succession'):
    58	            continue
    59	        key = automatic_key(candidate)
    60	        first = first_by_key.setdefault(key, cid) if key is not None else cid
    61	        aliases[cid] = first
    62	        if outcome[:2] != outcomes[first][:2]:
    63	            errors.append(f'candidate {cid}: same-key succession conflicts with {first}')
    64	    graph, directions = {}, {}
    65	    for cid, first in aliases.items():
    66	        for dep in outcomes[cid][2]:
    67	            target = aliases.get(dep['view_id'], dep['view_id'])
    68	            chain = aliases.get(dep['wait_chain_view_id'], dep['wait_chain_view_id'])
    69	            edge = (first, target, chain, dep['wait_year'])
