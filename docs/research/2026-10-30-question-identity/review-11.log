    98	def _words(text):
    99	    """Tokens for the within-view ranking: latin words and numbers, and character bigrams for Chinese runs (a
   100	    Chinese one-line has no spaces, so whole clauses would otherwise be single tokens that never overlap)."""
   101	    text = (text or '').lower()
   102	    words = set(re.findall(r'[a-z0-9]+(?:[.,][0-9]+)?%?', text))
   103	    for run in CJK_RUN.findall(text):
   104	        words.update(run[i:i + 2] for i in range(len(run) - 1))
   105	    return words
