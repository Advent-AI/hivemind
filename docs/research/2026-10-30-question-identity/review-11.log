    80	def run_arm(name, cfg_path, source, out):
    81	    folder = out / name
    82	    folder.mkdir(parents=True, exist_ok=True)
    83	    cfg = config.load(cfg_path)
    84	    uni = universe.load(ROOT / 'poc' / 'universe.json')
    85	    archive = model.Archive(str(folder / 'archive.sqlite'))
    86	    transport = Pinned(source / 'archive.sqlite', source / 'views.sqlite', str(folder / 'views.sqlite'))
    87	    log_path = folder / 'replay.log'
    88	
    89	    def log(*parts):
    90	        with open(log_path, 'a', encoding='utf-8') as handle:
    91	            handle.write(' '.join(str(p) for p in parts) + '\n')
    92	
    93	    totals = []
    94	    for from_day, until_day, only in STAGES:
    95	        totals.append(replay.run(testdb_path=ITEMS, views_path=str(folder / 'views.sqlite'), archive=archive, cfg=cfg, universe=uni,
    96	                                 from_day=from_day, until_day=until_day, spend_cap_usd=3.0, log=log, only_objects=only, transport=transport))
    97	    (folder / 'summary.json').write_text(json.dumps({'config': cfg.version, 'totals': totals, 'transport_calls': transport.counts}, indent=1, default=str))
    98	    print(name, cfg.version, transport.counts, totals[-1] if totals else None, flush=True)
