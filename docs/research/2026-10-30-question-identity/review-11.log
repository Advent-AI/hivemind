   122	def key_matches(conn, c):
   123	    """keyed-views-plan.md 2.5: the open views a keyed candidate must be confirmed against (same object, measure and scope,
   124	    overlapping period); empty for a candidate without a key."""
   125	    if not c.get('measure'):
   126	        return []
   127	    from .. import universe as _universe
   128	    # a model-written scope is wording, not identity: such a candidate is compared with every open view of its measure and period
   129	    scope_key = _universe.scope_key(c.get('scope', '')) if c.get('scope_source') in ('none', 'watch') else None
   130	    return store.open_views_with_key(conn, c['object'], c['measure'], scope_key, c.get('period_start', ''), c.get('period_end', ''), c.get('basis', 'n/a'), c.get('unit', 'n/a'), c.get('event_type', 'n/a'))
