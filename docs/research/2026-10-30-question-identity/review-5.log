    90	def piece_question(text):
    91	    return {'type': 'choice', 'criteria': PIECES,
    92	            'instructions': 'How does the INCOMING PIECE relate to the STORED PIECE below, already under the same thesis? Use only the supplied text. STORED PIECE:\n' + text}
