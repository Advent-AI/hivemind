    96	                                 from_day=from_day, until_day=until_day, spend_cap_usd=3.0, log=log, only_objects=only, transport=transport))
    97	    (folder / 'summary.json').write_text(json.dumps({'config': cfg.version, 'totals': totals, 'transport_calls': transport.counts}, indent=1, default=str))
    98	    print(name, cfg.version, transport.counts, totals[-1] if totals else None, flush=True)
    99	
