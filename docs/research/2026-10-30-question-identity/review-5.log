    95	def can_succeed(conn, view_id, key, c):
    96	    """06-views succession: the candidate asks the same object's quantity (no typed field conflicts: measure, event type, a stated
    97	    basis or unit, a code-owned scope) for a later period that does not overlap, and the thesis has no successor yet."""
    98	    return bool(key) and (store.view(conn, view_id) or {}).get('object_id') == c['object'] \
    99	        and not identity.conflicts(key, c, merging=False) \
   100	        and bool(key.get('period_end') and c.get('period_start') and key['period_end'] < c['period_start']) \
   101	        and not conn.execute('select 1 from successions where succeeds=?', (view_id,)).fetchone()
   102	
