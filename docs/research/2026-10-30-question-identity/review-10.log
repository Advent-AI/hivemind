    53	def place(archive, cfg, statements, shown, *, item=None, transport=None, prompt=None):
    54	    """Returns (placed, unfiled, answer): every statement with its links decided; the extraction's candidate links kept; the
    55	    caller drops the unfiled.
    56	    prompt names the placement prompt file; the configuration's is the default."""
    57	    if not statements:
    58	        return [], [], None
    59	    with open(config.prompt_path((prompt or cfg.placement.prompt_version) + '.txt'), encoding='utf-8') as handle:
    60	        system = handle.read()
    61	    user = build_request(statements, shown, item=item)
    62	    answer = model.call(archive, cfg, cfg.placement, system, user, SCHEMA, 'placement', 'place', transport=transport)
    63	    allowed = {v['view_id'] for v in shown}
    64	    decided = {}
    65	    for p in answer.data['placements']:
    66	        decided.setdefault(p['id'], [l for l in p['links'] if l in allowed])
    67	    placed, unfiled = [], []
    68	    for e in statements:
    69	        links = list(dict.fromkeys([l for l in e.get('links', []) if CANDIDATE_ID.match(l)] + decided.get(e['id'], [])))
    70	        (placed if links else unfiled).append(dict(e, links=links))
    71	    return placed, unfiled, answer

