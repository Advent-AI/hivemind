   608	def file_reading(reading, archive, cfg, item, shown_views, *, transport=None):
   609	    """The handover: from v20 the placement call files the read statements under the open theses shown now (D207); earlier versions
   610	    hand the read over as it is. A statement no open question takes is dropped as 'no home' (D209), like every other drop: a
   611	    candidate left with none of its evidence is dropped too, and a statement whose only link was such a candidate has no home."""
   612	    evidence, candidates, dropped, answer = reading.evidence, reading.candidates, list(reading.dropped), reading.answer
   613	    cost, cached = answer.cost_usd, answer.cached
   614	    if places(reading.version):
   615	        from . import placement
   616	        evidence, unfiled, placed_answer = placement.place(archive, cfg, evidence, shown_views, transport=transport, item=item)
   617	        dropped.extend((e['id'], 'no home') for e in unfiled)
   618	        if placed_answer is not None:
   619	            cost += placed_answer.cost_usd
   620	            cached = cached and placed_answer.cached
   621	        while True:
   622	            candidates = candidates_with_evidence(candidates, {e['id'] for e in evidence}, item, dropped)
   623	            candidate_ids = {c['id'] for c in candidates}
   624	            evidence = [dict(e, links=[l for l in e['links'] if not placement.CANDIDATE_ID.match(l) or l in candidate_ids]) for e in evidence]
   625	            homeless = [e for e in evidence if not e['links']]
   626	            if not homeless:
   627	                break
   628	            dropped.extend((e['id'], 'no home') for e in homeless)
   629	            evidence = [e for e in evidence if e['links']]
   630	    return Handover(evidence, candidates, dropped, answer.call_id, answer.request_sha256, cached, cost, reading.new_groups)
