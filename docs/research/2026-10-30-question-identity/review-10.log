   118	        store.ensure_writable_columns(conn)
   119	        result = _write(conn, universe, seq, item, handover, checked, second_pass)
   120	    except Exception:
   121	        conn.execute('rollback to view_write')
   122	        conn.execute('release view_write')
   123	        raise
