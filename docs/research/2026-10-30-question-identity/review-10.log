   112	def write(conn, universe, seq, item, handover, checked, second_pass):
   113	    """Write atomically within the caller's transaction; the caller commits the completion marker with it."""
   114	    if not conn.in_transaction:
   115	        conn.execute('begin immediate')
   116	    conn.execute('savepoint view_write')
