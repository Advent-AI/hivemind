   121	def succession_target(conn, c, listed):
   122	    """The succession code decides alone: the same scope as well (a model-worded scope that differs goes to the judge)."""
   123	    if not c.get('measure') or not c.get('period_start'):
   124	        return None
   125	    for view_id in listed:
   126	        key = store.view_key(conn, view_id)
   127	        if key and _universe.scope_key(key.get('scope', '')) == _universe.scope_key(c.get('scope', '')) and can_succeed(conn, view_id, key, c):
   128	            return view_id
   129	    return None
