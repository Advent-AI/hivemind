   104	def shared_quantity_target(conn, c):
   105	    """D197: a shared quantity's destination is code's. An open thesis of the same theme, measure and period is the same
   106	    thesis (merge); the latest earlier period without a successor is its predecessor (succession); otherwise none."""
   107	    if not identity.is_shared(c) or not c.get('period_start'):
   108	        return None
   109	    exact = store.exact_key_views(conn, c)
   110	    if exact:
   111	        return 'merge', exact[0]
   112	    earlier = []
   113	    for row in conn.execute('select k.view_id, k.period_end from view_keys k join views v using(view_id) where v.object_id=? and k.measure=? order by k.period_end desc',
   114	                            (c['object'], c['measure'])):
   115	        key = store.view_key(conn, row['view_id'])
   116	        if key and identity.is_shared(key) and can_succeed(conn, row['view_id'], key, c):
   117	            earlier.append(row['view_id'])
   118	    return ('succession', earlier[0]) if earlier else None
