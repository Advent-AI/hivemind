    56	def candidate_state(c, evidence):
    57	    rungs = ' / '.join(f'{r["label"]}: {r["condition"]}' for r in c['rungs'])
    58	    fields = ', '.join(f'{f}={c[f]}' for f in ('measure', 'scope', 'period_start', 'period_end', 'basis', 'unit', 'event_type') if c.get(f) not in (None, '', 'n/a'))
    59	    own = ' | '.join(f'[{e["speaker"]} {e["original_day"]}] {e["quote"][:400]}' for e in evidence if e['id'] in c.get('evidence_ids', []))[:1600]
    60	    return (f'CANDIDATE ({c["kind"]}, object {c["object"]}, focus "{c["looks_at"]}", {c["year"]}, due {c["due_day"]}): {c["question"]}\n'
    61	            f'Key: {fields}\nLadder: {rungs}\nIts evidence: {own}')
    62	
    63	
    64	def thesis_text(conn, view_id):
    65	    """The thesis as the judge should see it: the card and the quotes that define it (its first two pieces in force)."""
    66	    pieces = store.evidence_in_force(conn, view_id)[:2]
    67	    quotes = ''.join(f'\n    Evidence: [{p["speaker"]} {p["original_day"]}] {p["quote"][:400]}' for p in pieces)
    68	    return matching.describe_view(conn, view_id, english=True) + quotes
    69	
    70	
    71	def group_text(group):
    72	    members = '; '.join(m['looks_at'] for m in group.get('members', []))
    73	    return f'{group["name"]}. Scope: {group["scope"]} Also called: {", ".join(group.get("aliases") or [])}. Member questions: {members or "(none yet)"}'
    74	
    75	
    76	def piece_state(e, said_day):
    77	    return f'INCOMING PIECE [{e["tier"]}; {e["speaker"]}; original source {e["original_who"]}, stated {said_day}] {e["one_line"]} | quote: {e["quote"][:600]}'
    78	
    79	
    80	def relation_question(text):
    81	    return {'type': 'choice', 'criteria': RELATIONS,
    82	            'instructions': 'What relationship holds between the CANDIDATE and the THESIS below? Use only the supplied text. Equal numbers and similar wording do not establish identity. THESIS:\n' + text}
    83	
    84	
    85	def member_question(text):
    86	    return {'type': 'noul', 'criteria': MEMBER_CRITERIA,
    87	            'instructions': 'Does the CANDIDATE belong to the ongoing matter defined by GROUP below? Use only the supplied text; a shared company, industry or word is not enough. GROUP:\n' + text}
    88	
    89	
    90	def piece_question(text):
    91	    return {'type': 'choice', 'criteria': PIECES,
    92	            'instructions': 'How does the INCOMING PIECE relate to the STORED PIECE below, already under the same thesis? Use only the supplied text. STORED PIECE:\n' + text}
