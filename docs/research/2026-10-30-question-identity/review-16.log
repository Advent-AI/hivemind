    95	def can_succeed(conn, view_id, key, c):
    96	    """06-views succession: the candidate asks the same object's quantity (no typed field conflicts: measure, event type, a stated
    97	    basis or unit, a code-owned scope) for a later period that does not overlap, and the thesis has no successor yet."""
    98	    return bool(key) and (store.view(conn, view_id) or {}).get('object_id') == c['object'] \
    99	        and not identity.conflicts(key, c, merging=False) \
   100	        and bool(key.get('period_end') and c.get('period_start') and key['period_end'] < c['period_start']) \
   101	        and not conn.execute('select 1 from successions where succeeds=?', (view_id,)).fetchone()
   102	
   103	
   104	def shared_quantity_target(conn, c):
   105	    """D197: a shared quantity's destination is code's. An open thesis of the same theme, measure and period is the same
   106	    thesis (merge); the latest earlier period without a successor is its predecessor (succession); otherwise none."""
   107	    if not identity.is_shared(c) or not c.get('period_start'):
   108	        return None
   109	    exact = store.exact_key_views(conn, c)
   110	    if exact:
   111	        return 'merge', exact[0]
   112	    earlier = []
   113	    for row in conn.execute('select k.view_id, k.period_end from view_keys k join views v using(view_id) where v.object_id=? and k.measure=? order by k.period_end desc',
   114	                            (c['object'], c['measure'])):
   115	        key = store.view_key(conn, row['view_id'])
   116	        if key and identity.is_shared(key) and can_succeed(conn, row['view_id'], key, c):
   117	            earlier.append(row['view_id'])
   118	    return ('succession', earlier[0]) if earlier else None
   119	
   120	
   121	def succession_target(conn, c, listed):
   122	    """The succession code decides alone: the same scope as well (a model-worded scope that differs goes to the judge)."""
   123	    if not c.get('measure') or not c.get('period_start'):
   124	        return None
   125	    for view_id in listed:
   126	        key = store.view_key(conn, view_id)
   127	        if key and _universe.scope_key(key.get('scope', '')) == _universe.scope_key(c.get('scope', '')) and can_succeed(conn, view_id, key, c):
   128	            return view_id
   129	    return None
