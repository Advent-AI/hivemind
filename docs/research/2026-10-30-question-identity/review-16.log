   259	@dataclasses.dataclass
   260	class Checked:
   261	    outcomes: dict         # candidate id -> (outcome, target or None, dependencies list)
   262	    evidence: dict         # (evidence id, view_id) -> (outcome, target_evidence_id or None, said_day)
   263	    refusals: list
   264	    not_opened: dict       # candidate id -> reason
   265	    notes: list = dataclasses.field(default_factory=list)
