   267	
   268	def check(conn, universe, decisions, candidates, evidence, lists, shown_views):
   269	    decisions = vocabulary.matching_answer(decisions)
   270	    candidates = [vocabulary.candidate(c) for c in candidates]
   271	    shown_ids = {v['view_id'] for v in shown_views}
   272	    candidate_by_id = {c['id']: c for c in candidates}
   273	    # D51: a dependency is chosen among the views the model has in front of it: every list shown in this call,
   274	    # the views shown at extraction, and the candidates this answer opens
   275	    listed_all = set(shown_ids)
   276	    for hits in lists.candidate_lists.values():
   277	        listed_all.update(hits)
   278	    refusals, outcomes, not_opened, notes = [], {}, {}, []
   279	    raw_deps = {}
   280	    succession_targets = {}
   281	    answered = {d['id']: d for d in decisions.get('candidates', [])}
   282	    for c in candidates:
   283	        d = answered.get(c['id'])
   284	        if not d:
   285	            refusals.append(f'candidate {c["id"]} has no decision')
   286	            continue
   287	        outcome, target = d['outcome'], d['target_view_id'].strip()
   288	        listed = set(lists.candidate_lists.get(c['id'], [])) | shown_ids
   289	        if outcome in ('merge', 'succession') and target in candidate_by_id:
   290	            # a candidate cannot merge into another candidate of the same answer: only a stored thesis has a ladder and a due day to
   291	            # inherit. The model usually means "part of": both open, and the key coalesces them when they are the same quantity.
   292	            notes.append(f'candidate {c["id"]}: {outcome} into candidate {target} is not a destination; opened as a new view')
   293	            outcome, target = 'new', ''
   294	            d = dict(d, outcome=outcome, target_view_id='')
   295	        if outcome in ('merge', 'succession') and c.get('measure'):
   296	            # keyed-views-plan.md 2.5 rule 1: a different quantity, or another period, is never the same view, whatever the model says
   297	            target_key = store.view_key(conn, target) if target else None
   298	            target_view = store.view(conn, target) if target else None
   299	            if target_view and target_view['object_id'] != c['object']:
   300	                notes.append(f'candidate {c["id"]}: {outcome} into {target} refused: another object ({target_view["object_id"]} ≠ {c["object"]}); opened as a new view')
   301	                outcome, target, target_key = 'new', '', None
   302	                d = dict(d, outcome=outcome, target_view_id='')
   303	            if target_key and identity.conflicts(target_key, c, merging=outcome == 'merge'):
   304	                notes.append(f'candidate {c["id"]}: {outcome} into {target} refused by key ({target_key["measure"]}[{target_key["scope"]}] {target_key["period_start"]}..{target_key["period_end"]} ≠ {c["measure"]}[{c.get("scope", "")}] {c.get("period_start", "")}..{c.get("period_end", "")}); opened as a new view')
   305	                outcome, target = 'new', ''
   306	                d = dict(d, outcome=outcome, target_view_id='')
   307	        if outcome == 'new' and identity.automatic_key(c) is not None:
   308	            # rule 2 for a key code owns entirely: one open view with the same key and period is the same quantity; the model is not asked twice
   309	            twins = [v for v in lists.candidate_lists.get(c['id'], []) if _same_key(store.view_key(conn, v), c, (store.view(conn, v) or {}).get('object_id')) and store.is_open(conn, v)]
   310	            if len(twins) == 1:
   311	                notes.append(f'candidate {c["id"]}: opened as new by the model, merged into {twins[0]} by its key ({c["measure"]}[{c.get("scope", "")}] {c.get("period_start", "")}..{c.get("period_end", "")})')
   312	                outcome, target = 'merge', twins[0]
   313	                d = dict(d, outcome=outcome, target_view_id=target)
   314	        if outcome in ('merge', 'succession'):
   315	            if target not in listed:
   316	                refusals.append(f'candidate {c["id"]}: target {target!r} not in its list')
   317	                continue
   318	            if outcome == 'merge' and not store.is_open(conn, target):
   319	                refusals.append(f'candidate {c["id"]}: cannot attach to closed view {target}')
   320	                continue
   321	            if outcome == 'succession':
   322	                if conn.execute('select 1 from successions where succeeds=?', (target,)).fetchone():
   323	                    refusals.append(f'candidate {c["id"]}: {target} already has a successor')
   324	                    continue
   325	                first = succession_targets.get(target)
   326	                if first is not None and (identity.automatic_key(c) is None or identity.automatic_key(c) != identity.automatic_key(first)):
   327	                    refusals.append(f'candidate {c["id"]}: {target} can have one successor; {first["id"]} already succeeds it in this answer')
   328	                    continue
   329	                succession_targets.setdefault(target, c)             # a second wording with the same code-owned key is the same successor (coalesced by batch_plan)
   330	                # 06-views: a successor keeps the predecessor's direction; the writer stores a numeric ladder in that direction (the first
   331	                # real succession, 2027 hyperscaler capex after 2026, came low-to-high where its predecessor ran high-to-low), so no refusal here
   332	        if outcome in ('new', 'succession'):
   333	            object_id = universe.resolve(c['object'])
   334	            if not object_id:
   335	                not_opened[c['id']] = f'object {c["object"]!r} not on the research list'
   336	                if c['kind'] == 'theme':
   337	                    store.pool(conn, 'suggested_theme', c['object'], {'question': c['question'], 'input_id': None}, 0)
   338	                outcomes[c['id']] = ('skip', None, [])
   339	                continue
   340	            outcomes[c['id']] = (outcome, target or None, [])
   341	            raw_deps[c['id']] = d.get('dependencies', [])
   342	        elif outcome == 'merge':
   343	            outcomes[c['id']] = (outcome, target, [])
   344	        else:
   345	            outcomes[c['id']] = ('skip', None, [])
   346	            not_opened[c['id']] = d.get('reason', '')
   347	    # dependencies, once every candidate's outcome is known
   348	    opened = {cid for cid, (outcome, _, _) in outcomes.items() if outcome in ('new', 'succession')}
   349	    for cid, dependencies in raw_deps.items():
   350	        deps = []
   351	        bad = False
   352	        for dep in dependencies:
   353	            view_id, chain, year = dep['view_id'].strip(), dep['wait_chain_view_id'].strip(), dep['wait_year'].strip()
   354	            if view_id:
   355	                if view_id in candidate_by_id and view_id not in opened:
   356	                    refusals.append(f'candidate {cid}: dependency {view_id} is a candidate that is not opened')
   357	                    bad = True
   358	                    break
   359	                if view_id not in listed_all and view_id not in candidate_by_id:
   360	                    refusals.append(f'candidate {cid}: dependency {view_id} was not shown')
   361	                    bad = True
   362	                    break
   363	                if view_id == cid:
   364	                    refusals.append(f'candidate {cid}: depends on itself')
   365	                    bad = True
   366	                    break
   367	                deps.append({'view_id': view_id, 'wait_chain_view_id': None, 'wait_year': None, 'direction': dep['direction']})
   368	            elif chain and year:
   369	                if chain not in listed_all and chain not in candidate_by_id:
   370	                    refusals.append(f'candidate {cid}: waited chain {chain} was not shown')
   371	                    bad = True
   372	                    break
   373	                deps.append({'view_id': None, 'wait_chain_view_id': chain, 'wait_year': year, 'direction': dep['direction']})
   374	        if bad:
   375	            continue
   376	        outcomes[cid] = (outcomes[cid][0], outcomes[cid][1], deps)
   377	    # no cycle among the candidates of one answer (06-views: 会的话这条不收，退回给模型改)
   378	    graph = {cid: [d['view_id'] for d in outcomes[cid][2] if d['view_id'] in candidate_by_id] for cid in raw_deps if cid in outcomes}
   379	    for cid in graph:
   380	        stack, seen = list(graph[cid]), set()
   381	        while stack:
   382	            current = stack.pop()
   383	            if current == cid:
   384	                refusals.append(f'candidate {cid}: its dependencies lead back to itself')
   385	                break
   386	            if current in seen:
   387	                continue
   388	            seen.add(current)
   389	            stack.extend(graph.get(current, []))
   390	    _, coalescing_errors = identity.batch_plan(candidates, outcomes)
   391	    refusals.extend(coalescing_errors)
   392	    evidence_out = {}
   393	    answered_e = {(d['id'], d['view_id']): d for d in decisions.get('evidence', [])}
   394	    shown_evidence = {e for listed in lists.evidence_lists.values() for e in listed}      # every evidence id this request shows the model
   395	    shown_for_piece = {}                                                                     # handover piece -> ids shown for it under any thesis
   396	    for (piece_id, _), listed in lists.evidence_lists.items():
   397	        shown_for_piece.setdefault(piece_id, set()).update(listed)
   398	    for key, listed in lists.evidence_lists.items():
   399	        d = answered_e.get(key)
   400	        if not d:
   401	            refusals.append(f'evidence {key[0]} under {key[1]} has no decision')
   402	            continue
   403	        outcome, target = d['outcome'], d['target_evidence_id'].strip()
   404	        if outcome in ('repeat', 'replace'):
   405	            # 06-views step 5: the target is a piece under the destination view. Its list shows that view's top N; a piece the
   406	            # request shows in another list is also a valid target when it is linked to this view (the model reads the whole request).
   407	            # A repeat may also name a piece shown for this same evidence under another of its theses: a repeat adds a source and
   408	            # any new thesis link (06-views step 6), and the writer resolves the piece to that one stored identity for all its theses.
   409	            # A replacement stays within the destination thesis.
   410	            same_piece_repeat = outcome == 'repeat' and target in shown_for_piece.get(key[0], set())
   411	            if target not in listed and not same_piece_repeat and not (target in shown_evidence and target in set(store.evidence_ids_under(conn, key[1]))):
   412	                refusals.append(f'evidence {key[0]}: target {target!r} not among {key[1]}\'s evidence shown')
   413	                continue
   414	            evidence_out[key] = (outcome, target, d['said_day'].strip())
   415	        else:
   416	            evidence_out[key] = ('new', None, d['said_day'].strip())
   417	    return Checked(outcomes, evidence_out, refusals, not_opened, notes)

