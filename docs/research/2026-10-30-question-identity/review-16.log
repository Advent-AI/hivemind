   166	        state = 'open' if store.is_open(conn, view_id) else 'closed'
   167	        tail = f'; successor already exists: {successor["view_id"]}' if successor else ''
   168	        groups = store.groups_of_view(conn, view_id)
   169	        tail += f'; research group: ' + ', '.join(f'{g["group_id"]} "{g["name"]}"' for g in groups) if groups else ''
   170	        return f'{view_id} ({state}, {v["object_id"]}, {v["kind"]}, focus "{v["looks_at"]}", {v["year"] or ""}, due {v["due_day"]}): {v["question"]}\n    Ladder: {rungs}{tail}'
   171	    rungs = ' / '.join(f'{r["label"]}：{r["condition"]}' for r in store.rungs_of(conn, view_id))
   172	    state = '开着' if store.is_open(conn, view_id) else '关了'
   173	    tail = f'；已有下一期 {successor["view_id"]}' if successor else ''
   174	    return f'{view_id}（{state}，{v["object_id"]}，{v["kind"]}，看的是「{v["looks_at"]}」，{v["year"] or ""}，到期 {v["due_day"]}）：{v["question"]}\n    梯子：{rungs}{tail}'
