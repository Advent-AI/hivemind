   245	def decide(archive, cfg, conn, item, candidates, evidence, lists, shown_views, *, extra_views=(), retry_note='', transport=None):
   246	    english = is_english(cfg.matching.prompt_version)
   247	    with open(config.prompt_path(cfg.matching.prompt_version + '.txt'), encoding='utf-8') as handle:
   248	        system = handle.read()
   249	    user = _user_text(conn, item, candidates, evidence, lists, shown_views, extra_views, english=english)
   250	    if retry_note:
   251	        if english:
   252	            user += '\n\nThe code returned the previous answer because: ' + retry_note + '\nCorrect it and answer again.'
   253	        else:
   254	            user += '\n\n上一次的答案被代码退回，原因：' + retry_note + '\n请改正后再交。'
   255	    answer = model.call(archive, cfg, cfg.matching, system, user, schema_for(cfg.matching.prompt_version), 'matching', 'match', transport=transport)
   256	    return answer
