"""The matching step answered by Jev instead of a generative call (log row 34). For each candidate: its relation to every
thesis on its list (one `choice` per thesis) and its membership of every visible research group (one `noul` per group);
for each incoming piece of evidence: its relation to every stored piece on its list under each linked thesis (one
`choice` per stored piece). Code turns the probabilities into an answer in the matching schema, so `matching.check` and
`writing.write` run unchanged: `merge` when a listed open thesis is the same quantity or event, `succession` when a
listed thesis carries the same key for an earlier period and has no successor, else `new`; `repeat` when a stored
piece is the same statement, `replace` when the incoming piece supersedes it, else `new`. Dependencies are not asked.
Thresholds are pre-set (0.5); a membership above the threshold is added to the candidate's group references."""
import dataclasses
import hashlib
import concurrent.futures
import copy

from .. import config, jev, model, universe as _universe
from . import identity, matching, store

THRESHOLD = 0.5
# D190: the collision judge. Jev reads wording and calls a population variant of one aggregate 'part of' (six 2026 aggregates on the r3
# ledger, each judged 'new'); the generative model, asked the analyst's question, merged five of six. It is asked only for the theses of
# the candidate's own object and measure, and its verdict on those replaces Jev's.
COLLISION_RELATIONS = ['same_question', 'same_question_other_period', 'distinct_question_same_matter', 'different']
COLLISION_SCHEMA = {'type': 'object', 'additionalProperties': False, 'required': ['relations'],
                    'properties': {'relations': {'type': 'array', 'items': {'type': 'object', 'additionalProperties': False, 'required': ['thesis_id', 'relation', 'why'],
                                   'properties': {'thesis_id': {'type': 'string'}, 'relation': {'type': 'string', 'enum': COLLISION_RELATIONS}, 'why': {'type': 'string'}}}}}}
RELATIONS = {"same_quantity_or_event": "both ask about the same defined quantity or the same event: alternative wordings, or two estimates or figures of that one quantity",
             "same_quantity_other_period": "the same defined quantity or event series for another period, such as the next fiscal or calendar year",
             "part_of": "one asks about a strict component or subset of the other, in either direction; not identical",
             "same_matter_different_quantity": "one ongoing matter, two distinct quantities or events, neither a component of the other",
             "different": "different matters; sharing a company or industry is not enough",
             "cannot_tell": "the supplied material is insufficient or inconsistent"}
MEMBER_CRITERIA = {"true": "the CANDIDATE tracks this matter, one of its stated components, its implementation, or a deployment the supplied material connects to it",
                   "false": "the supplied material shows a different matter, or a question outside the GROUP's stated scope"}
# 06-views.md, the evidence table: repeat = "the same evidence already exists under the thesis: a retelling, the same number in text and
# table, or the same speaker repeating the same statement"; replace = "a later account of the same matter: a speaker revises guidance,
# forecast or event progress; an official confirms/denies a rumour; or the original source revises its statement". The criteria carry
# those words; the first seed run (log row 35) read "same occasion" into them and missed six cross-document repeats.
PIECES = {"same_statement": "the same evidence: a retelling, the same number stated in text and in a table or in another document, or the same speaker repeating the same statement; wording, precision and document may differ",
          "supersedes": "a later version of the same statement or number, changed: the same speaker revises that guidance, forecast or event-progress statement, an official confirms or denies that reported claim, or the original source revises that statement; another statement on the same topic is not this",
          "different": "a different fact, figure or matter, or a figure for another period or quantity, even if on the same topic"}


@dataclasses.dataclass
class Decision:
    data: dict
    call_id: int
    request_sha256: str
    cached: bool
    prompt_chars: int
    input_tokens: int
    output_tokens: int
    cost_usd: float
    calls: int = 0
    request_records: list = dataclasses.field(default_factory=list)


def candidate_state(c, evidence):
    rungs = ' / '.join(f'{r["label"]}: {r["condition"]}' for r in c['rungs'])
    fields = ', '.join(f'{f}={c[f]}' for f in ('measure', 'scope', 'period_start', 'period_end', 'basis', 'unit', 'event_type') if c.get(f) not in (None, '', 'n/a'))
    own = ' | '.join(f'[{e["speaker"]} {e["original_day"]}] {e["quote"][:400]}' for e in evidence if e['id'] in c.get('evidence_ids', []))[:1600]
    return (f'CANDIDATE ({c["kind"]}, object {c["object"]}, focus "{c["looks_at"]}", {c["year"]}, due {c["due_day"]}): {c["question"]}\n'
            f'Key: {fields}\nLadder: {rungs}\nIts evidence: {own}')


def thesis_text(conn, view_id):
    """The thesis as the judge should see it: the card and the quotes that define it (its first two pieces in force)."""
    pieces = store.evidence_in_force(conn, view_id)[:2]
    quotes = ''.join(f'\n    Evidence: [{p["speaker"]} {p["original_day"]}] {p["quote"][:400]}' for p in pieces)
    return matching.describe_view(conn, view_id, english=True) + quotes


def group_text(group):
    members = '; '.join(m['looks_at'] for m in group.get('members', []))
    return f'{group["name"]}. Scope: {group["scope"]} Also called: {", ".join(group.get("aliases") or [])}. Member questions: {members or "(none yet)"}'


def piece_state(e, said_day):
    return f'INCOMING PIECE [{e["tier"]}; {e["speaker"]}; original source {e["original_who"]}, stated {said_day}] {e["one_line"]} | quote: {e["quote"][:600]}'


def relation_question(text):
    return {'type': 'choice', 'criteria': RELATIONS,
            'instructions': 'What relationship holds between the CANDIDATE and the THESIS below? Use only the supplied text. Equal numbers and similar wording do not establish identity. THESIS:\n' + text}


def member_question(text):
    return {'type': 'noul', 'criteria': MEMBER_CRITERIA,
            'instructions': 'Does the CANDIDATE belong to the ongoing matter defined by GROUP below? Use only the supplied text; a shared company, industry or word is not enough. GROUP:\n' + text}


def piece_question(text):
    return {'type': 'choice', 'criteria': PIECES,
            'instructions': 'How does the INCOMING PIECE relate to the STORED PIECE below, already under the same thesis? Use only the supplied text. STORED PIECE:\n' + text}


def can_succeed(conn, view_id, key, c):
    """06-views succession: the candidate asks the same object's quantity (no typed field conflicts: measure, event type, a stated
    basis or unit, a code-owned scope) for a later period that does not overlap, and the thesis has no successor yet."""
    return bool(key) and (store.view(conn, view_id) or {}).get('object_id') == c['object'] \
        and not identity.conflicts(key, c, merging=False) \
        and bool(key.get('period_end') and c.get('period_start') and key['period_end'] < c['period_start']) \
        and not conn.execute('select 1 from successions where succeeds=?', (view_id,)).fetchone()


def shared_quantity_target(conn, c):
    """D197: a shared quantity's destination is code's. An open thesis of the same theme, measure and period is the same
    thesis (merge); the latest earlier period without a successor is its predecessor (succession); otherwise none."""
    if not identity.is_shared(c) or not c.get('period_start'):
        return None
    exact = store.exact_key_views(conn, c)
    if exact:
        return 'merge', exact[0]
    earlier = []
    for row in conn.execute('select k.view_id, k.period_end from view_keys k join views v using(view_id) where v.object_id=? and k.measure=? order by k.period_end desc',
                            (c['object'], c['measure'])):
        key = store.view_key(conn, row['view_id'])
        if key and identity.is_shared(key) and can_succeed(conn, row['view_id'], key, c):
            earlier.append(row['view_id'])
    return ('succession', earlier[0]) if earlier else None


def succession_target(conn, c, listed):
    """The succession code decides alone: the same scope as well (a model-worded scope that differs goes to the judge)."""
    if not c.get('measure') or not c.get('period_start'):
        return None
    for view_id in listed:
        key = store.view_key(conn, view_id)
        if key and _universe.scope_key(key.get('scope', '')) == _universe.scope_key(c.get('scope', '')) and can_succeed(conn, view_id, key, c):
            return view_id
    return None


def _summary(answer):
    if answer['type'] == 'noul':
        return f'{answer["noul"]:.2f}'
    top = max(answer['probabilities'].items(), key=lambda kv: kv[1])
    return f'{top[0]} {top[1]:.2f}'


def _answers(archive, cfg, jobs, workers, transport):
    """Ask independent questions; equal concurrent requests share one archived result."""
    if not isinstance(workers, int) or isinstance(workers, bool) or workers < 1:
        raise ValueError('Jev workers must be a positive integer')

    def ask(job):
        state, questions = job
        return jev.ask(archive, cfg, cfg.matching, state, questions, 'match', transport=transport)

    if workers == 1:
        return [ask(job) if job[1] else None for job in jobs]
    keys, unique, replies = [], {}, {}
    for state, questions in jobs:
        if not questions:
            keys.append(None)
            continue
        _, key = model.request_identity(jev.request_for(cfg.matching, state, questions))
        keys.append(key)
        if key not in unique:
            unique[key] = (state, copy.deepcopy(questions))
    waiting, active = iter(unique.items()), {}
    pool = concurrent.futures.ThreadPoolExecutor(max_workers=workers)
    try:
        def fill():
            while len(active) < workers:
                next_job = next(waiting, None)
                if next_job is None:
                    break
                key, job = next_job
                active[pool.submit(ask, job)] = key
        fill()
        while active:
            concurrent.futures.wait(active, return_when=concurrent.futures.FIRST_COMPLETED)
            completed = [future for future in active if future.done()]
            # Check the whole completed set before submitting any replacement work.
            for future in completed:
                future.result()
            for future in completed:
                replies[active.pop(future)] = future.result()
            fill()
    finally:
        for future in active:
            future.cancel()
        pool.shutdown(wait=True, cancel_futures=True)
    results, used = [], set()
    for key in keys:
        if key is None:
            results.append(None)
            continue
        answer = replies[key]
        # A later logical use is exactly what a serial archive lookup would return.
        results.append(dataclasses.replace(answer, cached=True, cost_usd=0.0) if key in used else answer)
        used.add(key)
    return results


def collision_peers(conn, c, listed):
    """The listed theses of the candidate's own object and measure: where one question may be held twice under other words."""
    peers = []
    for v in listed:
        key = store.view_key(conn, v) if c.get('measure') else None
        if key and key.get('measure') == c.get('measure') and (store.view(conn, v) or {}).get('object_id') == c['object']:
            peers.append(v)
    return peers


def ask_collision_judge(archive, cfg, conn, state, peers, llm_transport):
    """One generative call: the candidate's state and the peers' thesis texts; returns {thesis_id: relation}."""
    with open(config.prompt_path(cfg.collision.prompt_version + '.txt'), encoding='utf-8') as handle:
        system = handle.read()
    user = state + '\n\nTHESES:\n' + '\n'.join(f'--- {v}\n{thesis_text(conn, v)}' for v in peers) + '\n\nFor each thesis id, state the relation.'
    answer = model.call(archive, cfg, cfg.collision, system, user, COLLISION_SCHEMA, 'collision', 'match', transport=llm_transport)
    return answer, {r['thesis_id']: r['relation'] for r in answer.data['relations'] if r['thesis_id'] in peers}


def decide(archive, cfg, conn, item, candidates, evidence, lists, shown_views, *, extra_views=(), retry_note='', transport=None, llm_transport=None, workers=1):
    data = {'candidates': [], 'evidence': []}
    total = Decision(data, 0, '', True, 0, 0, 0, 0.0)
    shas = []
    jobs, candidate_jobs, evidence_jobs = [], [], []
    # All database reads and request construction stay on the coordinator thread.
    for c in candidates:
        listed = list(dict.fromkeys(list(lists.candidate_lists.get(c['id'], [])) + [v['view_id'] for v in shown_views]))
        fixed = shared_quantity_target(conn, c)                       # D197: code decides a shared quantity's destination; Jev is not asked its relations
        questions = {} if fixed else {f'rel__{v}': relation_question(thesis_text(conn, v)) for v in listed}
        groups = store.groups_for_prompt(conn, [c['object']], f'{c["looks_at"]} {c["question"]}')
        for g in groups:
            questions[f'member__{g["group_id"]}'] = member_question(group_text(g))
        candidate_jobs.append((c, listed, groups, len(jobs) if questions else None, fixed))
        if questions:
            jobs.append((candidate_state(c, evidence), questions))
    for e in evidence:
        pairs = [(e['id'], v) for v in e['links'] if (e['id'], v) in lists.evidence_lists]
        if not pairs:
            continue
        questions = {f'piece__{v}__{x}': piece_question(matching.describe_evidence(conn, x, english=True)) for _, v in pairs for x in lists.evidence_lists[(e['id'], v)]}
        said_day = e.get('original_day') or item['publication_day']
        evidence_jobs.append((e, pairs, said_day, len(jobs)))
        jobs.append((piece_state(e, said_day), questions))
    replies = _answers(archive, cfg, jobs, workers, transport)

    def answers_for(index):
        answer = replies[index]
        if answer is None:
            return {}
        total.cost_usd += answer.cost_usd
        total.input_tokens += answer.input_tokens
        total.output_tokens += answer.output_tokens
        total.prompt_chars += answer.prompt_chars
        total.cached = total.cached and answer.cached
        total.call_id = answer.call_id
        total.calls += 1
        shas.append(answer.request_sha256)
        total.request_records.append({'call_id': answer.call_id, 'request_sha256': answer.request_sha256})
        return answer.data

    for c, listed, groups, job_index, fixed in candidate_jobs:
        answers = answers_for(job_index) if job_index is not None else {}
        joined = [g['group_id'] for g in groups if answers[f'member__{g["group_id"]}']['noul'] >= THRESHOLD]
        for group_id in joined:
            if group_id not in (c.get('group_refs') or []) and group_id not in (c.get('jev_group_refs') or []):
                c.setdefault('jev_group_refs', []).append(group_id)          # the writer records these with basis 'jev'
        if fixed:                                                # D197: one aggregate per theme, measure and period; the wording is not identity
            data['candidates'].append({'id': c['id'], 'outcome': fixed[0], 'target_view_id': fixed[1], 'dependencies': [],
                                       'reason': f'shared quantity: {fixed[0]} by key (D197); groups joined: {joined or "none"}'})
            continue
        same = sorted(((answers[f'rel__{v}']['probabilities']['same_quantity_or_event'], v) for v in listed
                       if answers[f'rel__{v}']['choice'] == 'same_quantity_or_event' and answers[f'rel__{v}']['probabilities']['same_quantity_or_event'] >= THRESHOLD),
                      reverse=True)
        reasons = '; '.join(f'{qid[5:]}: {_summary(a)}' for qid, a in answers.items() if qid.startswith('rel__'))
        outcome, target = 'new', ''
        for _, v in same:
            # the key decides what 'the same' may mean: a different quantity is declined here; the same quantity for a later period is a
            # succession (06-views), when the thesis has no successor yet; otherwise a merge into an open thesis
            key = store.view_key(conn, v) if c.get('measure') else None
            if key and identity.conflicts(key, c, merging=False):
                continue
            if key and identity.conflicts(key, c, merging=True):          # the same quantity for another period
                if can_succeed(conn, v, key, c):
                    outcome, target = 'succession', v
                    break
                continue
            if store.is_open(conn, v):
                outcome, target = 'merge', v
                break
        if outcome == 'new':
            # the judge says 'the same quantity for another period'; code decides the direction, the typed fields and the successor
            other = sorted(((answers[f'rel__{v}']['probabilities']['same_quantity_other_period'], v) for v in listed
                            if answers[f'rel__{v}']['choice'] == 'same_quantity_other_period' and answers[f'rel__{v}']['probabilities']['same_quantity_other_period'] >= THRESHOLD),
                           reverse=True)
            for _, v in other:
                key = store.view_key(conn, v) if c.get('measure') else None
                if can_succeed(conn, v, key, c):
                    outcome, target = 'succession', v
                    break
        if outcome == 'new':
            successor_of = succession_target(conn, c, listed)
            if successor_of:
                outcome, target = 'succession', successor_of
        peers = collision_peers(conn, c, listed) if getattr(cfg, 'collision', None) else []
        judged = ''
        if peers:
            answer, verdicts = ask_collision_judge(archive, cfg, conn, candidate_state(c, evidence), peers, llm_transport)
            total.cost_usd += answer.cost_usd
            total.input_tokens += answer.input_tokens
            total.output_tokens += answer.output_tokens
            total.calls += 1
            total.cached = total.cached and answer.cached
            shas.append(answer.request_sha256)
            total.request_records.append({'call_id': answer.call_id, 'request_sha256': answer.request_sha256})
            judged = '; collision judge: ' + ', '.join(f'{v}: {verdicts.get(v, "(no answer)")}' for v in peers)
            if target in peers and verdicts.get(target) not in ('same_question', 'same_question_other_period'):
                outcome, target = 'new', ''                      # Jev's merge or succession on a peer the judge keeps apart
            if outcome == 'new':
                for v in peers:
                    key = store.view_key(conn, v)
                    if verdicts.get(v) == 'same_question' and not identity.conflicts(key, c, merging=False):
                        if identity.conflicts(key, c, merging=True):
                            if can_succeed(conn, v, key, c):
                                outcome, target = 'succession', v
                                break
                            continue
                        if store.is_open(conn, v):
                            outcome, target = 'merge', v
                            break
                    if verdicts.get(v) == 'same_question_other_period' and can_succeed(conn, v, key, c):
                        outcome, target = 'succession', v
                        break
        data['candidates'].append({'id': c['id'], 'outcome': outcome, 'target_view_id': target or '', 'dependencies': [],
                                   'reason': f'jev: {reasons or "no list"}; groups joined: {joined or "none"}{judged}'})
    for e, pairs, said_day, job_index in evidence_jobs:
        answers = answers_for(job_index)
        for _, v in pairs:
            scored = [(answers[f'piece__{v}__{x}'], x) for x in lists.evidence_lists[(e['id'], v)]]
            repeats = sorted(((a['probabilities']['same_statement'], x) for a, x in scored if a['choice'] == 'same_statement' and a['probabilities']['same_statement'] >= THRESHOLD), reverse=True)
            replaces = sorted(((a['probabilities']['supersedes'], x) for a, x in scored if a['choice'] == 'supersedes' and a['probabilities']['supersedes'] >= THRESHOLD), reverse=True)
            outcome, target = ('repeat', repeats[0][1]) if repeats else ('replace', replaces[0][1]) if replaces else ('new', '')
            data['evidence'].append({'id': e['id'], 'view_id': v, 'outcome': outcome, 'target_evidence_id': target or '', 'said_day': said_day,
                                     'reason': 'jev: ' + '; '.join(f'{x}: {_summary(a)}' for a, x in scored)})
    total.request_sha256 = hashlib.sha256('+'.join(shas).encode('utf-8')).hexdigest() if shas else ''
    return total
"""06-views.md steps 3–5: build the search lists, ask the model where each candidate view and each piece of evidence
goes (two calls: direct evidence with the candidates; evidence linked to candidates once their destination is
known), and check the answers by code (ids in the lists, attach only to open views, the object on the list,
succession unique and oriented, dependencies among shown views or a waited year, no cycles).

matching-v1 asks and answers in Chinese; matching-v2 and later ask and answer in English (D163). The schema, the
request text and the retry note follow the prompt version; every answer is checked in the canonical vocabulary."""
import dataclasses
import json
import re

from .. import config, model, vocabulary
from . import identity, store

OUTCOMES = vocabulary.CANDIDATE_OUTCOMES
EVIDENCE_OUTCOMES = vocabulary.EVIDENCE_OUTCOMES
LEGACY_OUTCOMES = list(vocabulary.LEGACY['candidate_outcome'])
LEGACY_EVIDENCE_OUTCOMES = list(vocabulary.LEGACY['evidence_outcome'])
ENGLISH_FROM = 2                  # the first matching prompt version written in English


def version_number(prompt_version):
    return int(str(prompt_version or '').rpartition('-v')[2] or 0)


def is_english(prompt_version):
    return version_number(prompt_version) >= ENGLISH_FROM


def schema_for(prompt_version):
    english = is_english(prompt_version)
    outcomes = OUTCOMES if english else LEGACY_OUTCOMES
    evidence_outcomes = EVIDENCE_OUTCOMES if english else LEGACY_EVIDENCE_OUTCOMES
    direction = {'type': 'string', 'enum': vocabulary.DIRECTIONS} if english else {'type': 'string'}
    return {
        'type': 'object', 'additionalProperties': False, 'required': ['candidates', 'evidence'],
        'properties': {
            'candidates': {'type': 'array', 'items': {
                'type': 'object', 'additionalProperties': False, 'required': ['id', 'outcome', 'target_view_id', 'reason', 'dependencies'],
                'properties': {
                    'id': {'type': 'string'}, 'outcome': {'type': 'string', 'enum': outcomes}, 'target_view_id': {'type': 'string'},
                    'reason': {'type': 'string'},
                    'dependencies': {'type': 'array', 'items': {'type': 'object', 'additionalProperties': False,
                                                                'required': ['view_id', 'wait_chain_view_id', 'wait_year', 'direction'],
                                                                'properties': {'view_id': {'type': 'string'}, 'wait_chain_view_id': {'type': 'string'},
                                                                               'wait_year': {'type': 'string'}, 'direction': direction}}}}}},
            'evidence': {'type': 'array', 'items': {
                'type': 'object', 'additionalProperties': False, 'required': ['id', 'view_id', 'outcome', 'target_evidence_id', 'said_day', 'reason'],
                'properties': {'id': {'type': 'string'}, 'view_id': {'type': 'string'}, 'outcome': {'type': 'string', 'enum': evidence_outcomes},
                               'target_evidence_id': {'type': 'string'}, 'said_day': {'type': 'string'}, 'reason': {'type': 'string'}}}},
        },
    }


SCHEMA = schema_for('matching-v1')          # the shape of the answers stored under matching-v1


NUMBER_WITH_UNIT = re.compile(r'(-?\d+(?:[.,]\d+)?)\s*(万亿|亿|百万|%|trillion|billion|million|tn|bn|mn)?', re.I)
YEAR_LIKE = re.compile(r'(?:FY|财年)\s*\d{4}|\d{4}\s*(?:年|财年)|\d{4}-\d{2}-\d{2}')
SCALE = {'万亿': 1e4, 'trillion': 1e3, 'tn': 1e3, 'million': 1e-3, 'mn': 1e-3}      # 亿 and billion are the unscaled magnitudes of their language


def first_value(condition):
    """The first quantity in a rung condition, years removed, magnitudes brought to one scale within a language."""
    for found in NUMBER_WITH_UNIT.finditer(YEAR_LIKE.sub(' ', condition or '')):
        value = float(found.group(1).replace(',', ''))
        unit = (found.group(2) or '').lower()
        return value * SCALE.get(unit, 1)
    return None


def ladder_direction(rungs):
    """+1 when the quantities rise from the first rung to the last, -1 when they fall, None when undecidable. The rungs'
    numeric bounds decide when both ends carry them; the prose is read only for a ladder without bounds."""
    first, last = rungs[0], rungs[-1]
    if any(r.get('lo') is not None or r.get('hi') is not None for r in rungs):
        if first.get('hi') is not None and last.get('lo') is not None and float(first['hi']) <= float(last['lo']):
            return 1
        if first.get('lo') is not None and last.get('hi') is not None and float(last['hi']) <= float(first['lo']):
            return -1
        return None
    numbers = [first_value(rung['condition']) for rung in rungs]
    known = [n for n in numbers if n is not None]
    if len(known) < 2 or known[0] == known[-1]:
        return None
    return 1 if known[0] < known[-1] else -1


@dataclasses.dataclass
class Lists:
    candidate_lists: dict      # candidate id -> [view_id]
    evidence_lists: dict       # (evidence handover id, view_id) -> [evidence_id]


CJK_RUN = re.compile(r'[一-鿿]+')


def _words(text):
    """Tokens for the within-view ranking: latin words and numbers, and character bigrams for Chinese runs (a
    Chinese one-line has no spaces, so whole clauses would otherwise be single tokens that never overlap)."""
    text = (text or '').lower()
    words = set(re.findall(r'[a-z0-9]+(?:[.,][0-9]+)?%?', text))
    for run in CJK_RUN.findall(text):
        words.update(run[i:i + 2] for i in range(len(run) - 1))
    return words


def rank_evidence(conn, view_id, one_line, top_n):
    """The view's evidence in force ranked by word overlap with the new piece's one-line (the within-view search)."""
    pieces = store.evidence_in_force(conn, view_id)
    target = _words(one_line)
    scored = sorted(pieces, key=lambda p: -len(target & _words(p['one_line'] + ' ' + p['quote'])))
    return [p['evidence_id'] for p in scored[:top_n]]


def _same_key(key, c, view_object=None):
    """Only a complete, corrected, code-owned key authorizes automatic identity."""
    target = identity.automatic_key(c)
    return target is not None and bool(key) and identity.automatic_key(key, view_object) == target


def key_matches(conn, c):
    """keyed-views-plan.md 2.5: the open views a keyed candidate must be confirmed against (same object, measure and scope,
    overlapping period); empty for a candidate without a key."""
    if not c.get('measure'):
        return []
    from .. import universe as _universe
    # a model-written scope is wording, not identity: such a candidate is compared with every open view of its measure and period
    scope_key = _universe.scope_key(c.get('scope', '')) if c.get('scope_source') in ('none', 'watch') else None
    return store.open_views_with_key(conn, c['object'], c['measure'], scope_key, c.get('period_start', ''), c.get('period_end', ''), c.get('basis', 'n/a'), c.get('unit', 'n/a'), c.get('event_type', 'n/a'))


def build_lists(conn, handover, shown_views, top_n):
    candidate_lists = {}
    for c in handover.candidates:
        same_key = key_matches(conn, c)
        if identity.is_shared(c):         # D197: a shared quantity is compared with every thesis of its theme and measure, its predecessors included
            family = [r['view_id'] for r in conn.execute('select k.view_id from view_keys k join views v using(view_id) where v.object_id=? and k.measure=? order by k.period_end desc',
                                                         (c['object'], c['measure']))]
            candidate_lists[c['id']] = list(dict.fromkeys(store.exact_key_views(conn, c) + family))[:top_n]
            continue
        if same_key:                      # a keyed candidate is compared with the views that share its key, a narrow question
            exact = store.exact_key_views(conn, c)
            candidate_lists[c['id']] = list(dict.fromkeys(exact + same_key))[:top_n]
            continue
        hits = store.search_views(conn, f'{c["object"]} {c["looks_at"]} {c["question"]}', top_n)
        for v in shown_views:
            if v['view_id'] not in hits and v['object_id'] == c['object']:
                hits.append(v['view_id'])
        candidate_lists[c['id']] = hits[:top_n]
    evidence_lists = {}
    candidate_ids = {c['id'] for c in handover.candidates}
    for e in handover.evidence:
        for view_id in e['links']:
            if view_id in candidate_ids:
                continue
            evidence_lists[(e['id'], view_id)] = rank_evidence(conn, view_id, e['one_line'], top_n)
    return Lists(candidate_lists, evidence_lists)


def describe_view(conn, view_id, english=False):
    v = store.view(conn, view_id)
    successor = conn.execute('select view_id from successions where succeeds=?', (view_id,)).fetchone()
    if english:
        rungs = ' / '.join(f'{r["label"]}: {r["condition"]}' for r in store.rungs_of(conn, view_id))
        state = 'open' if store.is_open(conn, view_id) else 'closed'
        tail = f'; successor already exists: {successor["view_id"]}' if successor else ''
        groups = store.groups_of_view(conn, view_id)
        tail += f'; research group: ' + ', '.join(f'{g["group_id"]} "{g["name"]}"' for g in groups) if groups else ''
        return f'{view_id} ({state}, {v["object_id"]}, {v["kind"]}, focus "{v["looks_at"]}", {v["year"] or ""}, due {v["due_day"]}): {v["question"]}\n    Ladder: {rungs}{tail}'
    rungs = ' / '.join(f'{r["label"]}：{r["condition"]}' for r in store.rungs_of(conn, view_id))
    state = '开着' if store.is_open(conn, view_id) else '关了'
    tail = f'；已有下一期 {successor["view_id"]}' if successor else ''
    return f'{view_id}（{state}，{v["object_id"]}，{v["kind"]}，看的是「{v["looks_at"]}」，{v["year"] or ""}，到期 {v["due_day"]}）：{v["question"]}\n    梯子：{rungs}{tail}'


def describe_evidence(conn, evidence_id, english=False):
    e = store.evidence(conn, evidence_id)
    if english:
        return f'{evidence_id} [{e["tier"]}; {e["speaker"]}; original source {e["original_who"]} {e["original_day"]}] {e["one_line"]} | quote: {e["quote"][:300]}'
    return f'{evidence_id}［{e["tier"]}；{e["speaker"]}；原始来源 {e["original_who"]} {e["original_day"]}］{e["one_line"]}｜原句：{e["quote"][:300]}'


def _user_text_chinese(conn, item, candidates, evidence, lists, shown_views, extra_views=()):
    parts = [f'信息：{item["input_id"]}，发布日 {item["publication_day"]}，类别 {item["category"]}。']
    if candidates:
        parts.append('【候选观点】')
        for c in candidates:
            rungs = ' / '.join(f'{r["label"]}：{r["condition"]}' for r in c['rungs'])
            listed = lists.candidate_lists.get(c['id'], [])
            parts.append(f'- {c["id"]}（{c["kind"]}，对象 {c["object"]}，看的是「{c["looks_at"]}」，{c["year"]}，到期 {c["due_day"]}）：{c["question"]}\n    梯子：{rungs}\n    它的证据：' +
                         '；'.join(e['one_line'] for e in evidence if e['id'] in c['evidence_ids'])[:1500])
            if listed:
                parts.append('    搜出来的已有观点：\n' + '\n'.join('    · ' + describe_view(conn, v) for v in listed))
            else:
                parts.append('    搜出来的已有观点：没有。')
    if shown_views:
        parts.append('【抽取时给模型看过的已有观点】\n' + '\n'.join('· ' + describe_view(conn, v['view_id']) for v in shown_views))
    for v in extra_views:
        parts.append('· ' + describe_view(conn, v))
    direct = [(e, vid) for e in evidence for vid in e['links'] if (e['id'], vid) in lists.evidence_lists]
    if direct:
        parts.append('【连在已有观点上的证据，和那条观点下已有的证据比】')
        for e, vid in direct:
            parts.append(f'- {e["id"]} → {vid}［{e["tier"]}；{e["speaker"]}；{e["original_who"]} {e["original_day"]}］{e["one_line"]}｜原句：{e["quote"][:300]}')
            listed = lists.evidence_lists[(e['id'], vid)]
            parts.append('    那条观点下已有的：\n' + ('\n'.join('    · ' + describe_evidence(conn, x) for x in listed) if listed else '    · 还没有证据'))
    parts.append('按 JSON schema 交出每个候选观点的去向和依赖、每条证据的去向。没有的数组交空。target 没有就写空字符串。')
    return '\n'.join(parts)


def _user_text_english(conn, item, candidates, evidence, lists, shown_views, extra_views=()):
    parts = [f'Item: {item["input_id"]}, published {item["publication_day"]}, category {item["category"]}.']
    if candidates:
        parts.append('[Candidate theses]')
        for c in candidates:
            rungs = ' / '.join(f'{r["label"]}: {r["condition"]}' for r in c['rungs'])
            listed = lists.candidate_lists.get(c['id'], [])
            parts.append(f'- {c["id"]} ({c["kind"]}, object {c["object"]}, focus "{c["looks_at"]}", {c["year"]}, due {c["due_day"]}): {c["question"]}\n    Ladder: {rungs}\n    Its evidence: ' +
                         '; '.join(e['one_line'] for e in evidence if e['id'] in c['evidence_ids'])[:1500])
            if listed:
                parts.append('    Existing theses found by search:\n' + '\n'.join('    · ' + describe_view(conn, v, english=True) for v in listed))
            else:
                parts.append('    Existing theses found by search: none.')
    if shown_views:
        parts.append('[Existing theses shown to the model at extraction]\n' + '\n'.join('· ' + describe_view(conn, v['view_id'], english=True) for v in shown_views))
    for v in extra_views:
        parts.append('· ' + describe_view(conn, v, english=True))
    direct = [(e, vid) for e in evidence for vid in e['links'] if (e['id'], vid) in lists.evidence_lists]
    if direct:
        parts.append('[Evidence linked to existing theses, to compare with the evidence already under that thesis]')
        for e, vid in direct:
            parts.append(f'- {e["id"]} → {vid} [{e["tier"]}; {e["speaker"]}; {e["original_who"]} {e["original_day"]}] {e["one_line"]} | quote: {e["quote"][:300]}')
            listed = lists.evidence_lists[(e['id'], vid)]
            parts.append('    Already under that thesis:\n' + ('\n'.join('    · ' + describe_evidence(conn, x, english=True) for x in listed) if listed else '    · no evidence yet'))
    parts.append('Return, per the JSON schema, each candidate\'s destination and dependencies, and one decision for every evidence → thesis pair listed above (id and view_id exactly as listed). Empty arrays when there is nothing. An absent target is an empty string.')
    return '\n'.join(parts)


def _user_text(conn, item, candidates, evidence, lists, shown_views, extra_views=(), english=False):
    build = _user_text_english if english else _user_text_chinese
    return build(conn, item, candidates, evidence, lists, shown_views, extra_views)


def decide(archive, cfg, conn, item, candidates, evidence, lists, shown_views, *, extra_views=(), retry_note='', transport=None):
    english = is_english(cfg.matching.prompt_version)
    with open(config.prompt_path(cfg.matching.prompt_version + '.txt'), encoding='utf-8') as handle:
        system = handle.read()
    user = _user_text(conn, item, candidates, evidence, lists, shown_views, extra_views, english=english)
    if retry_note:
        if english:
            user += '\n\nThe code returned the previous answer because: ' + retry_note + '\nCorrect it and answer again.'
        else:
            user += '\n\n上一次的答案被代码退回，原因：' + retry_note + '\n请改正后再交。'
    answer = model.call(archive, cfg, cfg.matching, system, user, schema_for(cfg.matching.prompt_version), 'matching', 'match', transport=transport)
    return answer


@dataclasses.dataclass
class Checked:
    outcomes: dict         # candidate id -> (outcome, target or None, dependencies list)
    evidence: dict         # (evidence id, view_id) -> (outcome, target_evidence_id or None, said_day)
    refusals: list
    not_opened: dict       # candidate id -> reason
    notes: list = dataclasses.field(default_factory=list)


def check(conn, universe, decisions, candidates, evidence, lists, shown_views):
    decisions = vocabulary.matching_answer(decisions)
    candidates = [vocabulary.candidate(c) for c in candidates]
    shown_ids = {v['view_id'] for v in shown_views}
    candidate_by_id = {c['id']: c for c in candidates}
    # D51: a dependency is chosen among the views the model has in front of it: every list shown in this call,
    # the views shown at extraction, and the candidates this answer opens
    listed_all = set(shown_ids)
    for hits in lists.candidate_lists.values():
        listed_all.update(hits)
    refusals, outcomes, not_opened, notes = [], {}, {}, []
    raw_deps = {}
    succession_targets = {}
    answered = {d['id']: d for d in decisions.get('candidates', [])}
    for c in candidates:
        d = answered.get(c['id'])
        if not d:
            refusals.append(f'candidate {c["id"]} has no decision')
            continue
        outcome, target = d['outcome'], d['target_view_id'].strip()
        listed = set(lists.candidate_lists.get(c['id'], [])) | shown_ids
        if outcome in ('merge', 'succession') and target in candidate_by_id:
            # a candidate cannot merge into another candidate of the same answer: only a stored thesis has a ladder and a due day to
            # inherit. The model usually means "part of": both open, and the key coalesces them when they are the same quantity.
            notes.append(f'candidate {c["id"]}: {outcome} into candidate {target} is not a destination; opened as a new view')
            outcome, target = 'new', ''
            d = dict(d, outcome=outcome, target_view_id='')
        if outcome in ('merge', 'succession') and c.get('measure'):
            # keyed-views-plan.md 2.5 rule 1: a different quantity, or another period, is never the same view, whatever the model says
            target_key = store.view_key(conn, target) if target else None
            target_view = store.view(conn, target) if target else None
            if target_view and target_view['object_id'] != c['object']:
                notes.append(f'candidate {c["id"]}: {outcome} into {target} refused: another object ({target_view["object_id"]} ≠ {c["object"]}); opened as a new view')
                outcome, target, target_key = 'new', '', None
                d = dict(d, outcome=outcome, target_view_id='')
            if target_key and identity.conflicts(target_key, c, merging=outcome == 'merge'):
                notes.append(f'candidate {c["id"]}: {outcome} into {target} refused by key ({target_key["measure"]}[{target_key["scope"]}] {target_key["period_start"]}..{target_key["period_end"]} ≠ {c["measure"]}[{c.get("scope", "")}] {c.get("period_start", "")}..{c.get("period_end", "")}); opened as a new view')
                outcome, target = 'new', ''
                d = dict(d, outcome=outcome, target_view_id='')
        if outcome == 'new' and identity.automatic_key(c) is not None:
            # rule 2 for a key code owns entirely: one open view with the same key and period is the same quantity; the model is not asked twice
            twins = [v for v in lists.candidate_lists.get(c['id'], []) if _same_key(store.view_key(conn, v), c, (store.view(conn, v) or {}).get('object_id')) and store.is_open(conn, v)]
            if len(twins) == 1:
                notes.append(f'candidate {c["id"]}: opened as new by the model, merged into {twins[0]} by its key ({c["measure"]}[{c.get("scope", "")}] {c.get("period_start", "")}..{c.get("period_end", "")})')
                outcome, target = 'merge', twins[0]
                d = dict(d, outcome=outcome, target_view_id=target)
        if outcome in ('merge', 'succession'):
            if target not in listed:
                refusals.append(f'candidate {c["id"]}: target {target!r} not in its list')
                continue
            if outcome == 'merge' and not store.is_open(conn, target):
                refusals.append(f'candidate {c["id"]}: cannot attach to closed view {target}')
                continue
            if outcome == 'succession':
                if conn.execute('select 1 from successions where succeeds=?', (target,)).fetchone():
                    refusals.append(f'candidate {c["id"]}: {target} already has a successor')
                    continue
                first = succession_targets.get(target)
                if first is not None and (identity.automatic_key(c) is None or identity.automatic_key(c) != identity.automatic_key(first)):
                    refusals.append(f'candidate {c["id"]}: {target} can have one successor; {first["id"]} already succeeds it in this answer')
                    continue
                succession_targets.setdefault(target, c)             # a second wording with the same code-owned key is the same successor (coalesced by batch_plan)
                # 06-views: a successor keeps the predecessor's direction; the writer stores a numeric ladder in that direction (the first
                # real succession, 2027 hyperscaler capex after 2026, came low-to-high where its predecessor ran high-to-low), so no refusal here
        if outcome in ('new', 'succession'):
            object_id = universe.resolve(c['object'])
            if not object_id:
                not_opened[c['id']] = f'object {c["object"]!r} not on the research list'
                if c['kind'] == 'theme':
                    store.pool(conn, 'suggested_theme', c['object'], {'question': c['question'], 'input_id': None}, 0)
                outcomes[c['id']] = ('skip', None, [])
                continue
            outcomes[c['id']] = (outcome, target or None, [])
            raw_deps[c['id']] = d.get('dependencies', [])
        elif outcome == 'merge':
            outcomes[c['id']] = (outcome, target, [])
        else:
            outcomes[c['id']] = ('skip', None, [])
            not_opened[c['id']] = d.get('reason', '')
    # dependencies, once every candidate's outcome is known
    opened = {cid for cid, (outcome, _, _) in outcomes.items() if outcome in ('new', 'succession')}
    for cid, dependencies in raw_deps.items():
        deps = []
        bad = False
        for dep in dependencies:
            view_id, chain, year = dep['view_id'].strip(), dep['wait_chain_view_id'].strip(), dep['wait_year'].strip()
            if view_id:
                if view_id in candidate_by_id and view_id not in opened:
                    refusals.append(f'candidate {cid}: dependency {view_id} is a candidate that is not opened')
                    bad = True
                    break
                if view_id not in listed_all and view_id not in candidate_by_id:
                    refusals.append(f'candidate {cid}: dependency {view_id} was not shown')
                    bad = True
                    break
                if view_id == cid:
                    refusals.append(f'candidate {cid}: depends on itself')
                    bad = True
                    break
                deps.append({'view_id': view_id, 'wait_chain_view_id': None, 'wait_year': None, 'direction': dep['direction']})
            elif chain and year:
                if chain not in listed_all and chain not in candidate_by_id:
                    refusals.append(f'candidate {cid}: waited chain {chain} was not shown')
                    bad = True
                    break
                deps.append({'view_id': None, 'wait_chain_view_id': chain, 'wait_year': year, 'direction': dep['direction']})
        if bad:
            continue
        outcomes[cid] = (outcomes[cid][0], outcomes[cid][1], deps)
    # no cycle among the candidates of one answer (06-views: 会的话这条不收，退回给模型改)
    graph = {cid: [d['view_id'] for d in outcomes[cid][2] if d['view_id'] in candidate_by_id] for cid in raw_deps if cid in outcomes}
    for cid in graph:
        stack, seen = list(graph[cid]), set()
        while stack:
            current = stack.pop()
            if current == cid:
                refusals.append(f'candidate {cid}: its dependencies lead back to itself')
                break
            if current in seen:
                continue
            seen.add(current)
            stack.extend(graph.get(current, []))
    _, coalescing_errors = identity.batch_plan(candidates, outcomes)
    refusals.extend(coalescing_errors)
    evidence_out = {}
    answered_e = {(d['id'], d['view_id']): d for d in decisions.get('evidence', [])}
    shown_evidence = {e for listed in lists.evidence_lists.values() for e in listed}      # every evidence id this request shows the model
    shown_for_piece = {}                                                                     # handover piece -> ids shown for it under any thesis
    for (piece_id, _), listed in lists.evidence_lists.items():
        shown_for_piece.setdefault(piece_id, set()).update(listed)
    for key, listed in lists.evidence_lists.items():
        d = answered_e.get(key)
        if not d:
            refusals.append(f'evidence {key[0]} under {key[1]} has no decision')
            continue
        outcome, target = d['outcome'], d['target_evidence_id'].strip()
        if outcome in ('repeat', 'replace'):
            # 06-views step 5: the target is a piece under the destination view. Its list shows that view's top N; a piece the
            # request shows in another list is also a valid target when it is linked to this view (the model reads the whole request).
            # A repeat may also name a piece shown for this same evidence under another of its theses: a repeat adds a source and
            # any new thesis link (06-views step 6), and the writer resolves the piece to that one stored identity for all its theses.
            # A replacement stays within the destination thesis.
            same_piece_repeat = outcome == 'repeat' and target in shown_for_piece.get(key[0], set())
            if target not in listed and not same_piece_repeat and not (target in shown_evidence and target in set(store.evidence_ids_under(conn, key[1]))):
                refusals.append(f'evidence {key[0]}: target {target!r} not among {key[1]}\'s evidence shown')
                continue
            evidence_out[key] = (outcome, target, d['said_day'].strip())
        else:
            evidence_out[key] = ('new', None, d['said_day'].strip())
    return Checked(outcomes, evidence_out, refusals, not_opened, notes)
"""D155: exact identity and same-answer coalescing, shared by matching and writing.

D197: a shared quantity (a candidate admitted as industry_aggregate / shared_quantity, a key stored with scope_source
'shared') is one thesis per theme, measure and period; its scope (the population or wording of the aggregate) is not
part of its identity."""
from ..universe import scope_key

KEY_VERSION = 2
SHARED_REASONS = ('industry_aggregate', 'shared_quantity')
EVENT_MEASURES = ('event', 'policy_event')


def is_shared(value):
    """A shared quantity: by its admission reason on a candidate, by its stored scope source on a key."""
    return value.get('measure') not in (None, 'other', *EVENT_MEASURES) and (value.get('scope_source') == 'shared' or value.get('opens_as') in SHARED_REASONS)


def automatic_key(value, object_id=None):
    """Return a complete, code-owned key, or None when identity still needs judgement."""
    if value.get('key_version') != KEY_VERSION:
        return None
    if value.get('measure') in (None, 'other'):
        return None
    if is_shared(value):
        return (object_id or value.get('object'), value['measure'], '', value.get('period_start'), value.get('period_end'),
                value.get('basis'), value.get('unit'), value.get('event_type'))
    if value.get('scope_source') not in ('none', 'watch'):
        return None
    if value['measure'] in EVENT_MEASURES and value.get('event_type') in (None, 'other', 'n/a'):
        return None
    return (object_id or value.get('object'), value['measure'], scope_key(value.get('scope', '')),
            value.get('period_start'), value.get('period_end'), value.get('basis'), value.get('unit'), value.get('event_type'))


def conflicts(key, candidate, *, merging):
    """Known different quantities/events cannot merge; corrected scopes/periods bind only corrected keys."""
    if key['measure'] != candidate['measure'] or key['event_type'] != candidate.get('event_type', 'n/a'):
        return True
    for field in ('basis', 'unit'):
        a, b = key[field], candidate.get(field, 'n/a')
        if a != 'n/a' and b != 'n/a' and a != b:
            return True
    if key.get('key_version') != KEY_VERSION or candidate.get('key_version') != KEY_VERSION:
        return False
    if (key.get('scope_source') in ('none', 'watch') and candidate.get('scope_source') in ('none', 'watch')
            and scope_key(key['scope']) != scope_key(candidate.get('scope', ''))):
        return True
    return merging and (key['period_start'], key['period_end']) != (candidate.get('period_start'), candidate.get('period_end'))


def batch_plan(candidates, outcomes):
    """Resolve same-answer duplicates and validate dependencies on the resulting identities before retry ends."""
    aliases, first_by_key, errors = {}, {}, []
    for candidate in candidates:
        cid = candidate['id']
        outcome = outcomes.get(cid, ('skip', None, []))
        if outcome[0] not in ('new', 'succession'):
            continue
        key = automatic_key(candidate)
        first = first_by_key.setdefault(key, cid) if key is not None else cid
        aliases[cid] = first
        if outcome[:2] != outcomes[first][:2]:
            errors.append(f'candidate {cid}: same-key succession conflicts with {first}')
    graph, directions = {}, {}
    for cid, first in aliases.items():
        for dep in outcomes[cid][2]:
            target = aliases.get(dep['view_id'], dep['view_id'])
            chain = aliases.get(dep['wait_chain_view_id'], dep['wait_chain_view_id'])
            edge = (first, target, chain, dep['wait_year'])
            if edge in directions and directions[edge] != dep['direction']:
                errors.append(f'candidate {cid}: same-key dependency direction conflicts')
            directions[edge] = dep['direction']
            if target:
                graph.setdefault(first, set()).add(target)
    for cid in graph:
        stack, seen = list(graph[cid]), set()
        while stack:
            target = stack.pop()
            if target == cid:
                errors.append(f'candidate {cid}: coalesced dependencies lead back to itself')
                break
            if target not in seen:
                seen.add(target)
                stack.extend(graph.get(target, ()))
    return aliases, errors
You are a senior hedge-fund analyst keeping a short list of live questions per company and theme. A question is one decision. Two texts are the same question when the same outcome settles both and you would not keep two cards for them: another estimate, source or wording, another population or proxy of one aggregate (the top five, five named companies, the largest four), or the same deal or proceeding described twice. They are distinct questions in one matter when their answers can move apart and you would want each: a component with its own drivers, a different quantity in the same deal (a guarantee beside a financing), a different event. The same quantity or event series for a later period is a succession. Judge from the texts only; equal numbers and similar words do not decide.

