     1	"""Placement (D207, 2026-10-28; docs/research/2026-10-28-extraction-quality/routing-analysis.md): from extraction v20 the statements an
     2	item yields are filed by a separate call that reads only the item's title line, the statements and the open questions, each question
     3	with a 'takes' line written by code from its key and its research group. The rule is the placement prompt the configuration names:
     4	`placement-narrow-v1` (one home, the narrowest question that names the matter; a company-wide figure question takes only its own
     5	figures and guidance) or `placement-v1` (the old link rule, kept for comparison). A statement the placer files nowhere is dropped with the reason 'no home'
     6	(D209: evidence is what bears on an open question; the handover's dropped record is where evaluation reads what was thrown away);
     7	a link the extraction gave to one of its own candidates (c1 …) is kept as it is, the placer decides only the links to existing theses. Measured on the frozen gold over three draws: core statements filed right
     8	55% → 82%, wrong links 9 → 3, links to the two revenue sinks 63/60/44 → 6/1/5."""
     9	import re
    10	
    11	from . import config, model
    12	
    13	SCHEMA = {'type': 'object', 'additionalProperties': False, 'required': ['placements'],
    14	          'properties': {'placements': {'type': 'array', 'items': {'type': 'object', 'additionalProperties': False, 'required': ['id', 'links'],
    15	                                                                     'properties': {'id': {'type': 'string'}, 'links': {'type': 'array', 'items': {'type': 'string'}}}}}}}
    16	CANDIDATE_ID = re.compile(r'^c\d+$')
    17	
    18	
    19	def matter(view):
    20	    """The research group(s) the thesis belongs to: the matter's other names in the press and what is happening (D149 aliases)."""
    21	    parts = []
    22	    for g in view.get('groups') or []:
    23	        names = [a for a in (g.get('aliases') or []) if a and a != g.get('name')]
    24	        parts.append(f"the matter '{g['name']}'" + (f" (also called {', '.join(names[:6])})" if names else '') + f": {g['scope']}")
    25	    return '; '.join(parts)
    26	
    27	
    28	def takes(view):
    29	    """What a question collects, from its key and its research group: the one sentence the placer reads beside the question."""
    30	    key = view.get('key') or {}
    31	    measure, scope = key.get('measure') or '', key.get('scope') or view.get('looks_at') or view.get('object_id')
    32	    tail = f"; statements about {matter(view)} belong here under any of those names" if matter(view) else ''
    33	    if measure == 'policy_event':
    34	        return (f"takes: the decisions, drafts, approvals, denials and deadlines of this process, and any statement of whether and how much "
    35	                f"the permitted or restricted activity is actually happening: {scope}{tail}")
    36	    if measure == 'event':
    37	        if key.get('event_type') in ('launch', 'shipment', 'deployment'):
    38	            return f"takes: steps, dates, delays, confirmations and denials of this event, and named customers' statements about receiving it: {scope}{tail}"
    39	        return f"takes: the terms, amounts, counterparties, agreements and approvals of this obligation or deal, and its steps, confirmations and denials: {scope}{tail}"
    40	    population = ", including estimates for another population or wording of the same aggregate" if view.get('kind') == 'theme' else ''
    41	    return (f"takes: {measure or 'the figure'} figures, guidance, estimates and revisions for {scope} over {key.get('period_start')}..{key.get('period_end')}{population}, "
    42	            f"and the direct drivers of that figure stated with a size{tail}")
    43	
    44	
    45	def build_request(statements, shown, item=None):
    46	    head = f"[Item] {item.get('publisher') or ''}, {item.get('publication_day') or ''}: {item.get('title') or ''}\n\n" if item else ''
    47	    lines = [f"  - {v['view_id']} ({v['object_id']}, due {v['due_day']}): {v['question']}\n      {takes(v)}" for v in shown]
    48	    return (head + '[Open questions]\n' + '\n'.join(lines) + '\n\n[Statements]\n'
    49	            + '\n'.join(f"  - {e['id']} [{e.get('tier')}] who: {e.get('original_who') or e.get('speaker') or ''} | {e.get('one_line')} | quote: {(e.get('quote') or '')[:240]}" for e in statements)
