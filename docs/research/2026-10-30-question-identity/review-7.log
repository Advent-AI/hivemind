    64	def thesis_text(conn, view_id):
    65	    """The thesis as the judge should see it: the card and the quotes that define it (its first two pieces in force)."""
    66	    pieces = store.evidence_in_force(conn, view_id)[:2]
    67	    quotes = ''.join(f'\n    Evidence: [{p["speaker"]} {p["original_day"]}] {p["quote"][:400]}' for p in pieces)
    68	    return matching.describe_view(conn, view_id, english=True) + quotes
