   132	def _summary(answer):
   133	    if answer['type'] == 'noul':
   134	        return f'{answer["noul"]:.2f}'
   135	    top = max(answer['probabilities'].items(), key=lambda kv: kv[1])
   136	    return f'{top[0]} {top[1]:.2f}'
