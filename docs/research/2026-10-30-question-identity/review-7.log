   139	def _answers(archive, cfg, jobs, workers, transport):
   140	    """Ask independent questions; equal concurrent requests share one archived result."""
   141	    if not isinstance(workers, int) or isinstance(workers, bool) or workers < 1:
   142	        raise ValueError('Jev workers must be a positive integer')
   143	
   144	    def ask(job):
   145	        state, questions = job
   146	        return jev.ask(archive, cfg, cfg.matching, state, questions, 'match', transport=transport)
   147	
   148	    if workers == 1:
   149	        return [ask(job) if job[1] else None for job in jobs]
   150	    keys, unique, replies = [], {}, {}
   151	    for state, questions in jobs:
   152	        if not questions:
   153	            keys.append(None)
   154	            continue
   155	        _, key = model.request_identity(jev.request_for(cfg.matching, state, questions))
   156	        keys.append(key)
   157	        if key not in unique:
   158	            unique[key] = (state, copy.deepcopy(questions))
   159	    waiting, active = iter(unique.items()), {}
   160	    pool = concurrent.futures.ThreadPoolExecutor(max_workers=workers)
   161	    try:
   162	        def fill():
   163	            while len(active) < workers:
   164	                next_job = next(waiting, None)
   165	                if next_job is None:
   166	                    break
   167	                key, job = next_job
   168	                active[pool.submit(ask, job)] = key
   169	        fill()
   170	        while active:
   171	            concurrent.futures.wait(active, return_when=concurrent.futures.FIRST_COMPLETED)
   172	            completed = [future for future in active if future.done()]
   173	            # Check the whole completed set before submitting any replacement work.
   174	            for future in completed:
   175	                future.result()
   176	            for future in completed:
   177	                replies[active.pop(future)] = future.result()
   178	            fill()
   179	    finally:
   180	        for future in active:
   181	            future.cancel()
   182	        pool.shutdown(wait=True, cancel_futures=True)
   183	    results, used = [], set()
   184	    for key in keys:
   185	        if key is None:
   186	            results.append(None)
   187	            continue
   188	        answer = replies[key]
   189	        # A later logical use is exactly what a serial archive lookup would return.
   190	        results.append(dataclasses.replace(answer, cached=True, cost_usd=0.0) if key in used else answer)
   191	        used.add(key)
   192	    return results
