    30	def schema_for(prompt_version):
    31	    english = is_english(prompt_version)
    32	    outcomes = OUTCOMES if english else LEGACY_OUTCOMES
    33	    evidence_outcomes = EVIDENCE_OUTCOMES if english else LEGACY_EVIDENCE_OUTCOMES
    34	    direction = {'type': 'string', 'enum': vocabulary.DIRECTIONS} if english else {'type': 'string'}
    35	    return {
    36	        'type': 'object', 'additionalProperties': False, 'required': ['candidates', 'evidence'],
    37	        'properties': {
    38	            'candidates': {'type': 'array', 'items': {
    39	                'type': 'object', 'additionalProperties': False, 'required': ['id', 'outcome', 'target_view_id', 'reason', 'dependencies'],
    40	                'properties': {
    41	                    'id': {'type': 'string'}, 'outcome': {'type': 'string', 'enum': outcomes}, 'target_view_id': {'type': 'string'},
    42	                    'reason': {'type': 'string'},
    43	                    'dependencies': {'type': 'array', 'items': {'type': 'object', 'additionalProperties': False,
    44	                                                                'required': ['view_id', 'wait_chain_view_id', 'wait_year', 'direction'],
    45	                                                                'properties': {'view_id': {'type': 'string'}, 'wait_chain_view_id': {'type': 'string'},
    46	                                                                               'wait_year': {'type': 'string'}, 'direction': direction}}}}}},
    47	            'evidence': {'type': 'array', 'items': {
    48	                'type': 'object', 'additionalProperties': False, 'required': ['id', 'view_id', 'outcome', 'target_evidence_id', 'said_day', 'reason'],
    49	                'properties': {'id': {'type': 'string'}, 'view_id': {'type': 'string'}, 'outcome': {'type': 'string', 'enum': evidence_outcomes},
    50	                               'target_evidence_id': {'type': 'string'}, 'said_day': {'type': 'string'}, 'reason': {'type': 'string'}}}},
    51	        },
    52	    }
    53	
    54	
    55	SCHEMA = schema_for('matching-v1')          # the shape of the answers stored under matching-v1
    56	
    57	
    58	NUMBER_WITH_UNIT = re.compile(r'(-?\d+(?:[.,]\d+)?)\s*(万亿|亿|百万|%|trillion|billion|million|tn|bn|mn)?', re.I)
    59	YEAR_LIKE = re.compile(r'(?:FY|财年)\s*\d{4}|\d{4}\s*(?:年|财年)|\d{4}-\d{2}-\d{2}')
    60	SCALE = {'万亿': 1e4, 'trillion': 1e3, 'tn': 1e3, 'million': 1e-3, 'mn': 1e-3}      # 亿 and billion are the unscaled magnitudes of their language
    61	
    62	
    63	def first_value(condition):
    64	    """The first quantity in a rung condition, years removed, magnitudes brought to one scale within a language."""
    65	    for found in NUMBER_WITH_UNIT.finditer(YEAR_LIKE.sub(' ', condition or '')):
    66	        value = float(found.group(1).replace(',', ''))
    67	        unit = (found.group(2) or '').lower()
    68	        return value * SCALE.get(unit, 1)
    69	    return None
    70	
    71	
    72	def ladder_direction(rungs):
    73	    """+1 when the quantities rise from the first rung to the last, -1 when they fall, None when undecidable. The rungs'
    74	    numeric bounds decide when both ends carry them; the prose is read only for a ladder without bounds."""
    75	    first, last = rungs[0], rungs[-1]
    76	    if any(r.get('lo') is not None or r.get('hi') is not None for r in rungs):
    77	        if first.get('hi') is not None and last.get('lo') is not None and float(first['hi']) <= float(last['lo']):
    78	            return 1
    79	        if first.get('lo') is not None and last.get('hi') is not None and float(last['hi']) <= float(first['lo']):
    80	            return -1
    81	        return None
    82	    numbers = [first_value(rung['condition']) for rung in rungs]
    83	    known = [n for n in numbers if n is not None]
    84	    if len(known) < 2 or known[0] == known[-1]:
    85	        return None
    86	    return 1 if known[0] < known[-1] else -1
    87	
