   184	def _user_text_chinese(conn, item, candidates, evidence, lists, shown_views, extra_views=()):
   185	    parts = [f'信息：{item["input_id"]}，发布日 {item["publication_day"]}，类别 {item["category"]}。']
   186	    if candidates:
   187	        parts.append('【候选观点】')
   188	        for c in candidates:
   189	            rungs = ' / '.join(f'{r["label"]}：{r["condition"]}' for r in c['rungs'])
   190	            listed = lists.candidate_lists.get(c['id'], [])
   191	            parts.append(f'- {c["id"]}（{c["kind"]}，对象 {c["object"]}，看的是「{c["looks_at"]}」，{c["year"]}，到期 {c["due_day"]}）：{c["question"]}\n    梯子：{rungs}\n    它的证据：' +
   192	                         '；'.join(e['one_line'] for e in evidence if e['id'] in c['evidence_ids'])[:1500])
   193	            if listed:
   194	                parts.append('    搜出来的已有观点：\n' + '\n'.join('    · ' + describe_view(conn, v) for v in listed))
   195	            else:
   196	                parts.append('    搜出来的已有观点：没有。')
   197	    if shown_views:
   198	        parts.append('【抽取时给模型看过的已有观点】\n' + '\n'.join('· ' + describe_view(conn, v['view_id']) for v in shown_views))
   199	    for v in extra_views:
   200	        parts.append('· ' + describe_view(conn, v))
   201	    direct = [(e, vid) for e in evidence for vid in e['links'] if (e['id'], vid) in lists.evidence_lists]
   202	    if direct:
   203	        parts.append('【连在已有观点上的证据，和那条观点下已有的证据比】')
   204	        for e, vid in direct:
   205	            parts.append(f'- {e["id"]} → {vid}［{e["tier"]}；{e["speaker"]}；{e["original_who"]} {e["original_day"]}］{e["one_line"]}｜原句：{e["quote"][:300]}')
   206	            listed = lists.evidence_lists[(e['id'], vid)]
   207	            parts.append('    那条观点下已有的：\n' + ('\n'.join('    · ' + describe_evidence(conn, x) for x in listed) if listed else '    · 还没有证据'))
   208	    parts.append('按 JSON schema 交出每个候选观点的去向和依赖、每条证据的去向。没有的数组交空。target 没有就写空字符串。')
   209	    return '\n'.join(parts)
