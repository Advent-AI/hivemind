     2	merged or succession; opened new with the collision judge calling a peer the same question (blocked later), the same question for
     3	another period, or a distinct question in the same matter; opened new on Jev alone by its strongest label; or nothing to compare."""
     4	import sqlite3, json, sys, re, collections
     5	def census(db):
     6	    conn = sqlite3.connect(f'file:{db}?mode=ro', uri=True)
     7	    conn.row_factory = sqlite3.Row
     8	    holding = collections.defaultdict(list)
     9	    for rec in conn.execute('select id, input_id, decisions_json from match_records order by id'):
    10	        if json.loads(rec['decisions_json'] or '{}').get('candidates'):
    11	            holding[rec['input_id']].append(rec)
    12	    if any(len(recs) > 1 for recs in holding.values()):
    13	        raise SystemExit('an input has candidates in more than one match record: decide which one counts before counting')
    14	    classes = collections.Counter()
    15	    examples = collections.defaultdict(list)
    16	    for input_id, (rec,) in holding.items():
    17	        for c in json.loads(rec['decisions_json'] or '{}').get('candidates', []):
    18	            reason = c.get('reason', '')
    19	            outcome = c.get('outcome')
    20	            if outcome in ('merge', 'succession'):
    21	                cls = outcome
    22	            elif 'no list' in reason:
    23	                cls = 'new: nothing listed'
    24	            else:
    25	                judge = reason.split('collision judge: ')[1] if 'collision judge: ' in reason else ''
    26	                verdicts = re.findall(r'(v\d+): (\w+)', judge)
    27	                labels = re.findall(r'(v\d+): (\w+) ([0-9.]+)', reason.split('; groups joined')[0])
    28	                if verdicts:
    29	                    kinds = {k for _, k in verdicts}
    30	                    if 'same_question' in kinds: cls = 'new: judge said same question'
    31	                    elif 'same_question_other_period' in kinds: cls = 'new: judge said other period'
    32	                    elif 'distinct_question_same_matter' in kinds: cls = 'new: judge said distinct, same matter'
    33	                    else: cls = 'new: judge said different'
    34	                else:
    35	                    order = ['same_quantity_or_event', 'same_quantity_other_period', 'part_of', 'same_matter_different_quantity', 'cannot_tell', 'different']
    36	                    best = min((order.index(l) for _, l, _ in labels if l in order), default=len(order) - 1)
    37	                    cls = 'new: Jev alone, strongest ' + order[best]
    38	            classes[cls] += 1
    39	            if len(examples[cls]) < 3:
    40	                examples[cls].append((input_id, reason[:160]))
    41	    return classes, examples, conn.execute('select count(*) from views').fetchone()[0]
