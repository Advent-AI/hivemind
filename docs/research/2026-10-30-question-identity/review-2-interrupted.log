    89	@dataclasses.dataclass
    90	class Lists:
    91	    candidate_lists: dict      # candidate id -> [view_id]
    92	    evidence_lists: dict       # (evidence handover id, view_id) -> [evidence_id]
    93	
    94	
    95	CJK_RUN = re.compile(r'[一-鿿]+')
    96	
    97	
    98	def _words(text):
    99	    """Tokens for the within-view ranking: latin words and numbers, and character bigrams for Chinese runs (a
   100	    Chinese one-line has no spaces, so whole clauses would otherwise be single tokens that never overlap)."""
   101	    text = (text or '').lower()
   102	    words = set(re.findall(r'[a-z0-9]+(?:[.,][0-9]+)?%?', text))
   103	    for run in CJK_RUN.findall(text):
   104	        words.update(run[i:i + 2] for i in range(len(run) - 1))
   105	    return words
   106	
   107	
   108	def rank_evidence(conn, view_id, one_line, top_n):
   109	    """The view's evidence in force ranked by word overlap with the new piece's one-line (the within-view search)."""
   110	    pieces = store.evidence_in_force(conn, view_id)
   111	    target = _words(one_line)
   112	    scored = sorted(pieces, key=lambda p: -len(target & _words(p['one_line'] + ' ' + p['quote'])))
   113	    return [p['evidence_id'] for p in scored[:top_n]]
   114	
   115	
   116	def _same_key(key, c, view_object=None):
   117	    """Only a complete, corrected, code-owned key authorizes automatic identity."""
   118	    target = identity.automatic_key(c)
   119	    return target is not None and bool(key) and identity.automatic_key(key, view_object) == target
   120	
   121	
   122	def key_matches(conn, c):
   123	    """keyed-views-plan.md 2.5: the open views a keyed candidate must be confirmed against (same object, measure and scope,
   124	    overlapping period); empty for a candidate without a key."""
   125	    if not c.get('measure'):
   126	        return []
   127	    from .. import universe as _universe
   128	    # a model-written scope is wording, not identity: such a candidate is compared with every open view of its measure and period
   129	    scope_key = _universe.scope_key(c.get('scope', '')) if c.get('scope_source') in ('none', 'watch') else None
   130	    return store.open_views_with_key(conn, c['object'], c['measure'], scope_key, c.get('period_start', ''), c.get('period_end', ''), c.get('basis', 'n/a'), c.get('unit', 'n/a'), c.get('event_type', 'n/a'))
   131	
   132	
   133	def build_lists(conn, handover, shown_views, top_n):
   134	    candidate_lists = {}
   135	    for c in handover.candidates:
   136	        same_key = key_matches(conn, c)
   137	        if identity.is_shared(c):         # D197: a shared quantity is compared with every thesis of its theme and measure, its predecessors included
   138	            family = [r['view_id'] for r in conn.execute('select k.view_id from view_keys k join views v using(view_id) where v.object_id=? and k.measure=? order by k.period_end desc',
   139	                                                         (c['object'], c['measure']))]
   140	            candidate_lists[c['id']] = list(dict.fromkeys(store.exact_key_views(conn, c) + family))[:top_n]
   141	            continue
   142	        if same_key:                      # a keyed candidate is compared with the views that share its key, a narrow question
   143	            exact = store.exact_key_views(conn, c)
   144	            candidate_lists[c['id']] = list(dict.fromkeys(exact + same_key))[:top_n]
   145	            continue
   146	        hits = store.search_views(conn, f'{c["object"]} {c["looks_at"]} {c["question"]}', top_n)
   147	        for v in shown_views:
   148	            if v['view_id'] not in hits and v['object_id'] == c['object']:
   149	                hits.append(v['view_id'])
   150	        candidate_lists[c['id']] = hits[:top_n]
   151	    evidence_lists = {}
   152	    candidate_ids = {c['id'] for c in handover.candidates}
   153	    for e in handover.evidence:
   154	        for view_id in e['links']:
   155	            if view_id in candidate_ids:
   156	                continue
   157	            evidence_lists[(e['id'], view_id)] = rank_evidence(conn, view_id, e['one_line'], top_n)
   158	    return Lists(candidate_lists, evidence_lists)
