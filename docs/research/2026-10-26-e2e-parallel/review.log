   136	def audit(directory, folder, cfg, uni):
   137	    """Rebuild every accepted request from its committed prefix and check the ledger's day records; no model call."""
   138	    items = day_items(directory)
   139	    first = first_sequence(directory)
   140	    errors = []
   141	    with readonly(directory / 'inputs/baseline.sqlite') as baseline, readonly(folder / 'views.sqlite') as conn, \
   142	            readonly(folder / 'archive.sqlite') as archive:
   143	        for table in store.TABLES:
   144	            old = [tuple(r) for r in baseline.execute(f'select * from {table} order by rowid')]
   145	            if old != [tuple(r) for r in conn.execute(f'select * from {table} order by rowid limit ?', (len(old),))]:
   146	                errors.append(f'start-of-day records changed: {table}')
   147	        hands = list(conn.execute('select * from handovers where seq>=? order by seq', (first,)))
   148	        if [(r['input_id'], r['seq']) for r in hands] != [(i['input_id'], first + n) for n, i in enumerate(items)]:
   149	            errors.append('handover order or count differs from dispatch order')
   150	        by_id = {i['input_id']: i for i in items}
   151	        for hand in hands:
   152	            item = by_id[hand['input_id']]
   153	            before = snapshot(conn, hand['seq'], exclude_unordered=True)
   154	            try:
   155	                objects = [o['value'] for o in item['object_identifiers'] if uni.has(o['value'])]
   156	                shown = store.views_for_prompt(before, objects)
   157	                groups = store.groups_for_prompt(before, objects, item.get('title') or '')
   158	                key = extraction_key(cfg, item, item['text'], shown, uni, groups)
   159	            finally:
