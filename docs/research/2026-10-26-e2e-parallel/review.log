    47	class RecordedProvider:
    48	    def __init__(self, calls, delay_scale, limit):
    49	        self.calls, self.scale = calls, delay_scale
    50	        self.lock = threading.Lock()
    51	        self.slots = threading.BoundedSemaphore(limit)
    52	        self.active = self.peak = 0
    53	        self.events = []
    54	
    55	    def __call__(self, *args):
    56	        with self.slots:
    57	            return self._call(*args)
    58	
    59	    def _call(self, *args):
    60	        request = args[-1]
    61	        sha = model.request_identity(request)[1]
    62	        recorded = self.calls.get(sha)
    63	        exact = recorded is not None
    64	        if recorded:
    65	            response = json.loads(recorded['response_json'])
    66	            duration = recorded['seconds']
    67	            kind = recorded['purpose']
    68	        elif len(args) == 2 and request['response_format']['json_schema']['name'] == 'extraction':
    69	            # Only a prepared request that is never accepted may use this response.
    70	            response = {'choices': [{'message': {'content': json.dumps(
    71	                {'evidence': [], 'candidates': [], 'new_groups': []})}}],
    72	                'usage': {'prompt_tokens': 0, 'completion_tokens': 0}}
    73	            duration, kind = 5.0, 'unrecorded_speculation'
    74	        else:
    75	            raise ValueError('unrecorded authoritative request: ' + sha)
    76	        with self.lock:
    77	            self.active += 1
    78	            self.peak = max(self.peak, self.active)
    79	            event = {'request_sha256': sha, 'kind': kind, 'start': time.perf_counter(),
    80	                     'recorded_seconds': duration, 'synthetic': recorded is None,
    81	                     'exact_recorded_request': exact}
    82	            self.events.append(event)
    83	        try:
    84	            threading.Event().wait(duration * self.scale)
    85	            return copy.deepcopy(response)
    86	        finally:
    87	            with self.lock:
    88	                event['end'] = time.perf_counter()
    89	                self.active -= 1
