    26	def digest(path):
    27	    value = hashlib.sha256()
    28	    with path.open('rb') as handle:
    29	        for chunk in iter(lambda: handle.read(1024 * 1024), b''):
    30	            value.update(chunk)
    31	    return value.hexdigest()
