    53	def charge(provider, response, max_input, max_output):
    54	    usage = response.get('usage', {}) if isinstance(response, dict) else {}
    55	    names = ('prompt_tokens', 'completion_tokens') if provider == 'openai' else ('input_tokens', 'output_tokens')
    56	    counts = [usage.get(k) for k in names]
    57	    if any(type(n) is not int or n < 0 for n in counts) or counts[0] > max_input or (max_output is not None and counts[1] > max_output):
    58	        raise BudgetError('missing, invalid or above-envelope usage')
    59	    a, b = counts
    60	    # Integer microdollars, rounded up. OpenAI uses the highest reviewed Standard rate,
    61	    # not an estimate of a discount or the provider's eventual bill.
    62	    cost = (a * 550 + b * 825 + 999) // 1000 if provider == 'openai' else (a * 42 + 999) // 1000
    63	    return cost
