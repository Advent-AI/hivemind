    36	def test_concurrent_admission_cannot_overspend(tmp_path):
    37	    """Ready/admit: reserve both in-flight costs before a third request can send."""
    38	    entered, release = threading.Event(), threading.Event()
    39	    count = 0
    40	    lock = threading.Lock()
    41	    def send(*args):
    42	        nonlocal count
    43	        with lock:
    44	            count += 1
    45	            position = count
    46	            if count == 2:
    47	                entered.set()
    48	        if position <= 2:
    49	            assert release.wait(5)
    50	        return reply()
    51	    guard = GuardedTransport(tmp_path / 'budget.sqlite', lambda *a: lambda: send(*a))
    52	    with ThreadPoolExecutor(max_workers=2) as pool:
    53	        first = pool.submit(guard, 'openai', REQUEST)
    54	        second = pool.submit(guard, 'openai', REQUEST)
    55	        try:
    56	            assert entered.wait(5)
    57	            with pytest.raises(BudgetError):
    58	                guard('openai', REQUEST)
    59	            assert count == 2
    60	            assert guard.summary()['held_microdollars'] == 1040600
    61	        finally:
    62	            release.set()
    63	        first.result(); second.result()
    64	    assert guard.summary()['held_microdollars'] == 1266
