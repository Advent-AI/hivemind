   138	        except BaseException as exc:
   139	            # No raw exception text: HTTP/SDK exceptions can contain credentials or headers.
   140	            with self.lock:
   141	                self.conn.execute('update attempts set state=?,charged=?,response_json=?,error=?,seconds=? where id=?',
