    94	class LiveTransport:
    95	    """Bounded outbound slots and bounded retries over one budget journal; one timing event per attempt."""
    96	
    97	    def __init__(self, guard, *, outbound, attempts):
    98	        self.guard, self.attempts = guard, attempts
    99	        self.slots = threading.BoundedSemaphore(outbound)
   100	        self.lock = threading.Lock()
   101	        self.active = self.peak = 0
   102	        self.events = []
   103	
   104	    def __call__(self, *args):
   105	        request = args[-1]
   106	        kind = request['response_format']['json_schema']['name'] if len(args) == 2 else 'jev'
   107	        for attempt in range(1, self.attempts + 1):
   108	            with self.slots:
   109	                with self.lock:
   110	                    self.active += 1
   111	                    self.peak = max(self.peak, self.active)
   112	                event = {'kind': kind, 'attempt': attempt, 'start': time.perf_counter(), 'request_sha256': model.request_identity(request)[1]}
   113	                try:
   114	                    response = self.guard(*args)
   115	                    event['outcome'] = 'ok'
   116	                    return response
   117	                except RetryableError as error:
   118	                    event['outcome'] = str(error)
   119	                    if attempt == self.attempts:
   120	                        raise
   121	                except BaseException as error:
   122	                    event['outcome'] = type(error).__name__
   123	                    raise
   124	                finally:
   125	                    event['end'] = time.perf_counter()
   126	                    with self.lock:
   127	                        self.active -= 1
   128	                        self.events.append(event)
   129	            threading.Event().wait(2 * attempt)
   130	
