   216	def cross_replay(directory, trial, cfg, uni):
   217	    """Run the trial's answers through the other mode with no network; the ledger must be identical."""
   218	    folder = directory / trial
   219	    target = folder / 'cross-replay'
   220	    if target.exists():
   221	        shutil.rmtree(target)       # derived data: rebuilt from the trial's own archive
   222	    target.mkdir()
   223	    shutil.copyfile(directory / 'inputs/baseline.sqlite', target / 'views.sqlite')
   224	    if trial.startswith('parallel'):
   225	        shutil.copyfile(folder / 'archive.sqlite', target / 'archive.sqlite')
   226	        transport, runner, unknown = refuse_network, None, None
   227	    else:
   228	        provider = ArchiveProvider(folder / 'archive.sqlite')
   229	        transport, unknown = provider, provider
   230	        runner = ParallelDay(directory / 'inputs/items.sqlite', target / 'manifests',
   231	                           extraction_workers=LIMITS['extraction_workers'], jev_workers=LIMITS['jev_workers'])
   232	    archive = model.Archive(target / 'archive.sqlite')
   233	    try:
   234	        replay.run(testdb_path=str(directory / 'inputs/items.sqlite'), views_path=str(target / 'views.sqlite'), archive=archive,
   235	                   cfg=cfg, universe=uni, from_day=DAY, until_day=DAY, transport=transport, day_runner=runner, log=lambda s: None)
   236	    finally:
   237	        archive.conn.close()
   238	    expected, actual = logical_rows(folder / 'views.sqlite'), logical_rows(target / 'views.sqlite')
   239	    different = [table for table in expected if expected[table] != actual[table]]
   240	    checked = audit(directory, target, cfg, uni) if trial.startswith('serial') else None
   241	    return {'mode': 'serial' if runner is None else 'parallel', 'different_tables': different,
   242	            'tables_compared': len(expected), 'rows_compared': sum(len(v) for v in expected.values()),
   243	            'discarded_unknown_speculations': unknown.unknown if unknown else 0,
   244	            'audit_errors': checked['errors'] if checked else []}
