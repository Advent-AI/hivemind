    98	        before = snapshot(conn, hand['seq'], exclude_unordered=True)
    99	        objects = [o['value'] for o in item['object_identifiers'] if uni.has(o['value'])]
   100	        shown = store.views_for_prompt(before, objects)
   101	        groups = store.groups_for_prompt(before, objects, item.get('title') or '')
   102	        key = extraction_key(cfg, item, item['text'], shown, uni, groups)
   103	        assert key in calls, 'synthetic speculative result became authoritative'
   104	        version = cfg.extraction_setting(item['category']).prompt_version.rpartition('-')[2]
   105	        evidence, candidates, dropped, new_groups = extraction.sift_with_groups(
   106	            json.loads(calls[key]['answer_json']), item, item['text'], {v['view_id'] for v in shown}, uni,
   107	            english=extraction.is_english(version), shown_group_ids=[g['group_id'] for g in groups])
   108	        expected = {'evidence': evidence, 'candidates': candidates, 'dropped': dropped, 'new_groups': new_groups}
   109	        assert json.loads(json.dumps(expected)) == json.loads(hand['handover_json']), 'handover differs from exact archived answer'
   110	        accepted.append(key)
   111	        before.close()
   112	    assert len(accepted) == len(items)
   113	    return accepted
