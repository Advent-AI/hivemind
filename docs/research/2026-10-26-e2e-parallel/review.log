   284	class RecordedPrepare:
   285	    """Offline rehearsal of the live path: the golden run's recorded answers at a scaled recorded duration."""
   286	
   287	    def __init__(self, archive_path, scale):
   288	        with readonly(archive_path) as db:
   289	            self.calls = {r['request_sha256']: (json.loads(r['response_json']), r['seconds'] or 0.0) for r in db.execute(
   290	                'select request_sha256,response_json,seconds from model_calls where answer_json is not null')}
   291	        self.scale = scale
   292	
   293	    def __call__(self, provider, request):
   294	        sha = model.request_identity(request)[1]
   295	        if sha in self.calls:
   296	            response, seconds = self.calls[sha]
   297	        elif provider == 'openai' and request['response_format']['json_schema']['name'] == 'extraction':
   298	            response, seconds = {'choices': [{'message': {'content': json.dumps({'evidence': [], 'candidates': [], 'new_groups': []})}}],
   299	                                 'usage': {'prompt_tokens': 0, 'completion_tokens': 0}}, 7.0
   300	        else:
   301	            raise AssertionError('rehearsal request not recorded: ' + sha)
   302	
   303	        def send():
   304	            threading.Event().wait(seconds * self.scale)
   305	            return json.loads(json.dumps(response))
   306	        return send
