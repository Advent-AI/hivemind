   391	def summarize(directory):
   392	    directory = directory.resolve()
   393	    done = [n for n in ORDER if (directory / n / 'result.json').exists()]
   394	    reports = {n: json.loads((directory / n / 'result.json').read_text()) for n in done}
   395	    by_mode = {}
   396	    for name, report in reports.items():
   397	        by_mode.setdefault(name.split('-')[0], []).append(report)
   398	    timing = {}
   399	    for mode, rows in by_mode.items():
   400	        timing[mode] = {key: {'samples': [round(r[key], 2) for r in rows], 'median': round(statistics.median(r[key] for r in rows), 2)}
   401	                        for key in ('seconds', 'ingestion_seconds', 'judging_seconds')}
   402	        timing[mode]['published_rate_usd'] = round(sum(r['published_rate_usd'] for r in rows), 6)
   403	    if {'serial', 'parallel'} <= set(timing):
   404	        timing['speedup'] = {key: round(timing['serial'][key]['median'] / timing['parallel'][key]['median'], 3)
   405	                             for key in ('seconds', 'ingestion_seconds', 'judging_seconds')}
   406	    summary = {'trials': done, 'timing': timing,
   407	               'correctness': {n: {'audit_errors': r['audit']['errors'], 'cross_replay': r['cross_replay']} for n, r in reports.items()},
   408	               'drift': drift(directory, done)}
   409	    (directory / 'summary.json').write_text(json.dumps(summary, indent=2, ensure_ascii=False))
   410	    print(json.dumps(summary['timing'], indent=2))
   411	    return summary
