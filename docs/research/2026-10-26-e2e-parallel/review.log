   136	def audit(directory, folder, cfg, uni):
   137	    """Rebuild every accepted request from its committed prefix and check the ledger's day records; no model call."""
   138	    items = day_items(directory)
   139	    first = first_sequence(directory)
   140	    errors = []
   141	    with readonly(directory / 'inputs/baseline.sqlite') as baseline, readonly(folder / 'views.sqlite') as conn, \
   142	            readonly(folder / 'archive.sqlite') as archive:
   143	        for table in store.TABLES:
   144	            old = [tuple(r) for r in baseline.execute(f'select * from {table} order by rowid')]
   145	            if old != [tuple(r) for r in conn.execute(f'select * from {table} order by rowid limit ?', (len(old),))]:
   146	                errors.append(f'start-of-day records changed: {table}')
   147	        hands = list(conn.execute('select * from handovers where seq>=? order by seq', (first,)))
   148	        if [(r['input_id'], r['seq']) for r in hands] != [(i['input_id'], first + n) for n, i in enumerate(items)]:
   149	            errors.append('handover order or count differs from dispatch order')
   150	        by_id = {i['input_id']: i for i in items}
   151	        for hand in hands:
   152	            item = by_id[hand['input_id']]
   153	            before = snapshot(conn, hand['seq'], exclude_unordered=True)
   154	            try:
   155	                objects = [o['value'] for o in item['object_identifiers'] if uni.has(o['value'])]
   156	                shown = store.views_for_prompt(before, objects)
   157	                groups = store.groups_for_prompt(before, objects, item.get('title') or '')
   158	                key = extraction_key(cfg, item, item['text'], shown, uni, groups)
   159	            finally:
   160	                before.close()
   161	            accepted = archive.execute("select request_json,answer_json from model_calls where request_sha256=? and purpose='extract'", (key,)).fetchone()
   162	            if not accepted:
   163	                errors.append('accepted handover has no exact current-prefix request: ' + item['input_id'])
   164	                continue
   165	            if model.request_identity(json.loads(accepted['request_json']))[1] != key:
   166	                errors.append('archived request body differs from its hash: ' + item['input_id'])
   167	            version = cfg.extraction_setting(item['category']).prompt_version.rpartition('-')[2]
   168	            evidence, candidates, dropped, new_groups = extraction.sift_with_groups(
   169	                json.loads(accepted['answer_json']), item, item['text'], {v['view_id'] for v in shown}, uni,
   170	                english=extraction.is_english(version), shown_group_ids=[g['group_id'] for g in groups])
   171	            expected = {'evidence': evidence, 'candidates': candidates, 'dropped': dropped, 'new_groups': new_groups}
   172	            if json.loads(json.dumps(expected)) != json.loads(hand['handover_json']):
   173	                errors.append('accepted handover differs from its bound answer: ' + item['input_id'])
   174	        for record in conn.execute('select * from match_records where seq>=?', (first,)):
   175	            for call in json.loads(record['shown_json']).get('requests', []):
   176	                if not archive.execute('select 1 from model_calls where call_id=? and request_sha256=?', (call['call_id'], call['request_sha256'])).fetchone():
   177	                    errors.append('matching request trace missing')
   178	        changed = rounds.changed_views_of_day(conn, DAY)
   179	        expected_judged = {v for v in changed if store.is_open(conn, v) and store.evidence_in_force(conn, v)}
   180	        judged = list(conn.execute('select * from judgements where seq>=?', (first,)))
   181	        if sorted(r['view_id'] for r in judged) != sorted(expected_judged):
   182	            errors.append('daily judgement population differs')
   183	        if any(r['input_id'] != 'day:' + DAY or r['publication_day'] != DAY for r in judged):
   184	            errors.append('daily judgement record differs')
   185	        if store.last_completed_day(conn) != DAY:
   186	            errors.append('day not completed')
   187	        if conn.execute('select count(*) from thesis_group_members m left join views v using(view_id) left join thesis_groups g using(group_id) '
   188	                        'where v.view_id is null or g.group_id is null').fetchone()[0]:
   189	            errors.append('dangling group membership')
   190	    return {'errors': errors, 'handovers': len(hands), 'judged': len(judged)}
