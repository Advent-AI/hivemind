    52	# Jev reports each probability rounded to two decimals independently of the choice it made on the unrounded values, so the
    53	# chosen option may print one unit below another (0.47 against 0.48; 1 of 2,353 archived choice answers on 2026-10-25).
    54	ROUNDING = 0.01
    55	
    56	
    57	def validate(answers, questions):
    58	    """The answers of a response against the request's questions; a list of problems."""
    59	    problems = []
    60	    if not isinstance(answers, dict) or set(answers) != set(questions):
    61	        return ['answer set differs from the questions asked']
    62	    for qid, question in questions.items():
    63	        answer = answers[qid]
    64	        if not isinstance(answer, dict) or answer.get('type') != question['type']:
    65	            problems.append(f'{qid}: answer type mismatch')
    66	            continue
    67	        if question['type'] == 'noul':
    68	            if not isinstance(answer.get('noul'), (int, float)) or not 0 <= answer['noul'] <= 1:
    69	                problems.append(f'{qid}: noul out of range')
    70	        elif question['type'] == 'choice':
    71	            probabilities = answer.get('probabilities')
    72	            if answer.get('choice') not in question['criteria'] or not isinstance(probabilities, dict) or set(probabilities) != set(question['criteria']):
    73	                problems.append(f'{qid}: choice or probabilities do not match the criteria')
    74	            elif any(not isinstance(v, (int, float)) or isinstance(v, bool) or not 0 <= v <= 1 for v in probabilities.values()) \
    75	                    or abs(sum(probabilities.values()) - 1) > 0.005 * len(probabilities) + 1e-9:
    76	                problems.append(f'{qid}: probabilities are not a distribution')
    77	            elif probabilities[answer['choice']] < max(probabilities.values()) - ROUNDING - 1e-9:
    78	                problems.append(f'{qid}: choice is not the most probable option')
    79	    return problems
