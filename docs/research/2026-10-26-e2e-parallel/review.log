    66	class GuardedTransport:
    67	    """One coordinator's journal; unresolved work survives crashes and closes admission."""
    68	
    69	    def __init__(self, path, prepare, *, cap_microdollars=1500000, max_calls=36, envelope_for=envelope, halt_on_failure=True):
    70	        path = Path(path)
    71	        if not path.is_absolute() or type(cap_microdollars) is not int or cap_microdollars <= 0 or type(max_calls) is not int or max_calls <= 0:
    72	            raise ValueError('absolute journal path and positive integer limits required')
    73	        self.lock, self.prepare = threading.Lock(), prepare
    74	        self.envelope_for, self.halt_on_failure = envelope_for, halt_on_failure
    75	        self.conn = sqlite3.connect(path, check_same_thread=False)
    76	        self.conn.executescript('''
    77	            create table if not exists settings (id integer primary key check(id=1), cap integer, max_calls integer, halted text);
    78	            create table if not exists attempts (
    79	              id integer primary key, provider text, request_sha256 text, request_json text,
    80	              reserved integer, charged integer, state text, response_json text, error text,
    81	              seconds real, completed_order integer);
    82	        ''')
    83	        row = self.conn.execute('select cap,max_calls,halted from settings').fetchone()
    84	        if row is None:
    85	            self.conn.execute('insert into settings values (1,?,?,NULL)', (cap_microdollars, max_calls))
    86	        elif row[:2] != (cap_microdollars, max_calls):
    87	            raise BudgetError('journal limits changed')
    88	        # A crash leaves an attempt reserved or dispatched; a recorded retryable failure holds its reservation instead.
    89	        unresolved = "state!='complete'" if halt_on_failure else "state in ('reserved','dispatched')"
    90	        if self.conn.execute(f"select 1 from attempts where {unresolved} limit 1").fetchone():
    91	            self.conn.execute("update settings set halted='unresolved prior attempt' where id=1")
    92	        self.conn.commit()
    93	
    94	    def stop(self, reason):
    95	        with self.lock:
    96	            self.conn.execute('update settings set halted=coalesce(halted,?) where id=1', (reason,))
    97	            self.conn.commit()
    98	
    99	    def summary(self):
   100	        with self.lock:
   101	            self.conn.row_factory = sqlite3.Row
   102	            attempts = [dict(r) for r in self.conn.execute('select id,provider,request_sha256,reserved,charged,state,error,seconds,completed_order from attempts order by id')]
   103	            halted = self.conn.execute('select halted from settings').fetchone()[0]
   104	            self.conn.row_factory = None
   105	        return {'attempts': attempts, 'halted': halted,
   106	                'held_microdollars': sum(r['charged'] if r['charged'] is not None else r['reserved'] for r in attempts)}
   107	
   108	    def __call__(self, *args):
   109	        provider, request = args if len(args) == 2 else ('jev', args[0])
   110	        reserved, max_input, max_output = self.envelope_for(provider, request)
   111	        text, sha = model.request_identity(request)
   112	        with self.lock:
   113	            cap, max_calls, halted = self.conn.execute('select cap,max_calls,halted from settings').fetchone()
   114	            count, held = self.conn.execute('select count(*),coalesce(sum(coalesce(charged,reserved)),0) from attempts').fetchone()
   115	            if halted or count >= max_calls or held + reserved > cap:
   116	                raise BudgetError('admission closed or study limit reached')
   117	            cur = self.conn.execute("insert into attempts(provider,request_sha256,request_json,reserved,state) values (?,?,?,?,'reserved')", (provider, sha, text, reserved))
   118	            ident = cur.lastrowid
   119	            self.conn.commit()
   120	        start = time.perf_counter()
   121	        encoded = None
   122	        dispatched = False
   123	        try:
   124	            # Preparation is local only. Cancellation and dispatch then share one
   125	            # decision point; work committed here is in flight, even before socket I/O.
   126	            send = self.prepare(provider, request)
   127	            with self.lock:
   128	                if self.conn.execute('select halted from settings').fetchone()[0]:
   129	                    raise BudgetError('cancelled before dispatch')
