   267	def drift(directory, names):
   268	    """Item agreement between every pair of ledgers (the golden included); sampler noise sets the floor."""
   269	    first = first_sequence(directory)
   270	    ledgers = {'gold': directory / 'inputs/gold.sqlite'}
   271	    ledgers.update({n: directory / n / 'views.sqlite' for n in names})
   272	    sig = {n: signatures(p, first) for n, p in ledgers.items()}
   273	    pairs = {}
   274	    keys = list(sig)
   275	    for i, a in enumerate(keys):
   276	        for b in keys[i + 1:]:
   277	            items = sig[a][0]
   278	            same = sum(sig[a][0][k] == sig[b][0].get(k) for k in items)
   279	            linked = sum(sig[a][0][k]['existing_linked'] == sig[b][0].get(k, {}).get('existing_linked') for k in items)
   280	            pairs[f'{a}~{b}'] = {'items_identical': same, 'existing_links_identical': linked, 'items': len(items)}
   281	    return {'totals': {n: s[1] for n, s in sig.items()}, 'pairs': pairs}
