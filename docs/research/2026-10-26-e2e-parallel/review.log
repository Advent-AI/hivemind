    19	def scripted(script):
    20	    """A Jev transport answering each question from `script`: a key is a question id, or (needle, question id) to apply only
    21	    when the needle occurs in the state; 'different' / 0.05 otherwise."""
    22	    def transport(request):
    23	        answers = {}
    24	        state = request['state']
    25	
    26	        def lookup(qid, default):
    27	            for key, value in script.items():
    28	                if isinstance(key, tuple) and key[1] == qid and key[0] in state:
    29	                    return value
    30	            return script.get(qid, default)
    31	        for qid, q in request['questions'].items():
    32	            if q['type'] == 'noul':
    33	                answers[qid] = {'type': 'noul', 'noul': lookup(qid, 0.05)}
    34	            else:
    35	                labels = list(q['criteria'])
    36	                chosen, p = lookup(qid, (('different' if 'different' in labels else labels[-1]), 0.9))
    37	                probabilities = {label: round((1 - p) / (len(labels) - 1), 3) for label in labels}
    38	                probabilities[chosen] = p
