   309	def run_trial(directory, trial, *, prepare=None):
   310	    directory = directory.resolve()
   311	    if trial not in ORDER or json.loads((directory / 'study.json').read_text()) != contract(directory):
   312	        raise ValueError('unknown trial or changed study contract')
   313	    for name in ORDER[:ORDER.index(trial)]:
   314	        saved = json.loads((directory / name / 'result.json').read_text())
   315	        if saved['failure'] or saved['audit']['errors'] or saved['cross_replay']['different_tables']:
   316	            raise ValueError(f'prior trial {name} failed; the study stops')
   317	    folder = directory / trial
   318	    if folder.exists():
   319	        raise ValueError('trial already started; preserve it')
   320	    cfg, uni = configuration()
   321	    guard = GuardedTransport(directory / 'budget.sqlite', prepare or single_attempt_http(), cap_microdollars=LIMITS['cap_microdollars'],
   322	                             max_calls=LIMITS['max_calls'], envelope_for=request_envelope, halt_on_failure=False)
   323	    transport = LiveTransport(guard, outbound=LIMITS['outbound'], attempts=LIMITS['attempts_per_call'])
   324	    folder.mkdir()
   325	    shutil.copyfile(directory / 'inputs/baseline.sqlite', folder / 'views.sqlite')
   326	    archive = model.Archive(folder / 'archive.sqlite')
   327	    runner = (ParallelDay(directory / 'inputs/items.sqlite', folder / 'manifests', extraction_workers=LIMITS['extraction_workers'],
   328	                        jev_workers=LIMITS['jev_workers']) if trial.startswith('parallel') else None)
   329	    marks = {}
   330	    original_judge_day = rounds.judge_day
   331	
   332	    def timed_judge_day(*args, **kwargs):
   333	        marks['judging_started'] = time.perf_counter()
   334	        try:
   335	            return original_judge_day(*args, **kwargs)
   336	        finally:
   337	            marks['judging_finished'] = time.perf_counter()
   338	
   339	    def cancel(signum, frame):
   340	        guard.stop('cancelled')
   341	        raise KeyboardInterrupt
   342	    handlers = {sig: signal.signal(sig, cancel) for sig in (signal.SIGINT, signal.SIGTERM)}
   343	    before = guard.summary()
   344	    failure = result = checked = crossed = None
   345	    rounds.judge_day = timed_judge_day
   346	    started = time.perf_counter()
   347	    try:
   348	        result = replay.run(testdb_path=str(directory / 'inputs/items.sqlite'), views_path=str(folder / 'views.sqlite'), archive=archive,
   349	                            cfg=cfg, universe=uni, from_day=DAY, until_day=DAY, transport=transport, day_runner=runner,
   350	                            log=lambda message: print(trial, message, flush=True))
   351	        finished = time.perf_counter()
   352	    except BaseException as error:
   353	        finished = time.perf_counter()
   354	        guard.stop('trial failed')
   355	        failure = {'type': type(error).__name__, 'message': str(error)[:500]}
   356	    finally:
   357	        rounds.judge_day = original_judge_day
   358	        for sig, handler in handlers.items():
   359	            signal.signal(sig, handler)
   360	        archive.conn.close()
   361	    if failure is None:
   362	        try:
   363	            checked = audit(directory, folder, cfg, uni)
   364	            crossed = cross_replay(directory, trial, cfg, uni)
   365	        except Exception as error:      # recorded as a failed check, never as a pass
   366	            crossed = {'different_tables': [f'cross-replay failed: {type(error).__name__}: {str(error)[:300]}']}
   367	    after = guard.summary()
   368	    attempts = after['attempts'][len(before['attempts']):]
   369	    with readonly(folder / 'archive.sqlite') as db:
   370	        priced = [dict(r) for r in db.execute('select purpose,model,count(*) n,sum(input_tokens) i,sum(output_tokens) o from model_calls '
   371	                                              'where answer_json is not null group by purpose,model')]
   372	    published = sum(r['i'] / 1e6 * model.PRICES[r['model']][0] + r['o'] / 1e6 * model.PRICES[r['model']][1] for r in priced)
   373	    report = {'trial': trial, 'failure': failure, 'seconds': finished - started,
   374	              'ingestion_seconds': marks.get('judging_started', finished) - started,
   375	              'judging_seconds': marks.get('judging_finished', finished) - marks.get('judging_started', finished),
   376	              'result': result, 'audit': checked or {'errors': ['not audited']}, 'cross_replay': crossed or {'different_tables': ['not run']},
   377	              'provider_peak_inflight': transport.peak, 'attempts': len(attempts),
   378	              'retried_attempts': sum(e['attempt'] > 1 for e in transport.events),
   379	              'conservative_microdollars': after['held_microdollars'] - before['held_microdollars'],
   380	              'published_rate_usd': round(published, 6), 'calls_by_purpose': priced,
   381	              'runner_events': [dict(e, t=e['t'] - started) for e in runner.events] if runner else [],
   382	              'transport_events': [dict(e, start=e['start'] - started, end=e['end'] - started) for e in transport.events]}
   383	    (folder / 'result.json').write_text(json.dumps(report, indent=2, ensure_ascii=False))
   384	    print(json.dumps({k: report[k] for k in ('trial', 'failure', 'seconds', 'ingestion_seconds', 'judging_seconds', 'provider_peak_inflight',
   385	                                             'retried_attempts', 'published_rate_usd')}
   386	                     | {'audit_errors': report['audit']['errors'], 'cross_replay_different': report['cross_replay']['different_tables']}), flush=True)
   387	    if failure:
   388	        raise RuntimeError(f'{trial} failed: {failure}')
   389	
