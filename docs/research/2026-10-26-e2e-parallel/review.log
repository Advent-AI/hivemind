     2	questions}`; each question is `noul` (yes/no → a probability), `choice` (labelled options → `choice`, `probabilities`,
     3	`confidence`) or `score`. Every call is archived in `model_calls` like every other model call, keyed by the request's
     4	digest, so a byte-identical request is served from the archive; input is priced from `model.PRICES`, output is free."""
     5	import http.client
     6	import json
     7	import os
     8	import time
     9	import urllib.error
    10	import urllib.request
    11	import uuid
    12	
    13	from . import model
    14	
    15	ENDPOINT = 'https://api.typesafe.ai/v1/systemone'
    16	KEY_NAME = 'TYPESAFE_API_KEY'
    17	RETRY_STATUSES = {429, 529}
    18	ATTEMPTS = 3
    19	
    20	
    21	def _key():
    22	    if os.environ.get(KEY_NAME):
    23	        return os.environ[KEY_NAME]
    24	    with open(model.CREDENTIALS, encoding='utf-8') as handle:
    25	        return json.load(handle)[KEY_NAME]
    26	
    27	
    28	def transport(request, timeout=60):
    29	    """POST the request; up to three attempts, pausing before each retry, on a rate-limit or overload status or a
    30	    connection that fails without a reply; any other failure is a TransportError. The body is the same sorted text the
    31	    archive digests, so a cache hit is byte-identical to what was sent."""
    32	    body = json.dumps(request, sort_keys=True, ensure_ascii=False).encode('utf-8')
    33	    key = _key()
    34	    for attempt in range(ATTEMPTS):
    35	        req = urllib.request.Request(ENDPOINT, body, {'Authorization': 'Bearer ' + key, 'Content-Type': 'application/json', 'Accept': 'application/json'})
    36	        try:
    37	            with urllib.request.urlopen(req, timeout=timeout) as response:
    38	                raw = response.read()
    39	            break
    40	        except urllib.error.HTTPError as error:
    41	            if error.code not in RETRY_STATUSES or attempt == ATTEMPTS - 1:
    42	                raise model.TransportError(f'Jev HTTP {error.code}') from None
    43	        except (urllib.error.URLError, OSError, http.client.HTTPException) as error:   # a dropped or truncated reply
    44	            if attempt == ATTEMPTS - 1:
    45	                raise model.TransportError(f'Jev transport failed: {type(error).__name__}') from None
    46	        time.sleep(2 * (attempt + 1))
    47	    if key.encode('utf-8') in raw:
    48	        raise model.TransportError('Jev response echoed the credential; not archived')
    49	    return json.loads(raw.decode('utf-8'))
