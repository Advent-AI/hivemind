   247	def signatures(path, first):
   248	    """One comparable line per item: evidence and candidate counts, existing theses linked, links to new theses, new theses."""
   249	    with readonly(path) as db:
   250	        existing = {r[0] for r in db.execute('select view_id from views where created_seq<?', (first,))}
   251	        result = {}
   252	        for hand in db.execute('select input_id,seq,handover_json from handovers where seq>=? order by seq', (first,)):
   253	            data = json.loads(hand['handover_json'])
   254	            links = [r[0] for r in db.execute('select view_id from evidence_links where seq=?', (hand['seq'],))]
   255	            result[hand['input_id']] = {'evidence': len(data['evidence']), 'candidates': len(data['candidates']),
   256	                                        'existing_linked': sorted({v for v in links if v in existing}),
   257	                                        'new_links': sum(v not in existing for v in links),
   258	                                        'new_views': db.execute('select count(*) from views where created_seq=?', (hand['seq'],)).fetchone()[0]}
   259	        totals = {'evidence_links': db.execute('select count(*) from evidence_links where seq>=?', (first,)).fetchone()[0],
   260	                  'new_evidence': db.execute('select count(*) from evidence where created_seq>=?', (first,)).fetchone()[0],
   261	                  'new_views': db.execute('select count(*) from views where created_seq>=?', (first,)).fetchone()[0],
   262	                  'judged': db.execute('select count(*) from judgements where seq>=?', (first,)).fetchone()[0],
   263	                  'judged_views': sorted(r[0] for r in db.execute('select view_id from judgements where seq>=?', (first,)))}
   264	    return result, totals
