    14	class BudgetError(RuntimeError):
    15	    pass
    16	
    17	
    18	class RetryableError(model.TransportError):
    19	    """No usable reply arrived (network failure, rate limit or server error); the attempt's usage stays unknown."""
    20	
    21	
    22	def envelope(provider, request):
    23	    """Reserve documented maximum usage, without guessing tokens from characters."""
    24	    if provider == 'openai' and request.get('model') == 'gpt-6-luna':
    25	        allowed = {'model', 'messages', 'response_format', 'reasoning_effort', 'max_completion_tokens'}
    26	        if set(request) - allowed:
    27	            raise BudgetError('unreviewed OpenAI request fields')
    28	        cap = request.get('max_completion_tokens')
    29	        if type(cap) is not int or not 1 <= cap <= 128000:
    30	            raise BudgetError('unreviewed OpenAI output limit')
    31	        # Full documented input bound and the requested output bound, including
    32	        # highest reviewed Standard rates and the 10% regional premium.
    33	        reserved = (922000 * 550 + cap * 825 + 999) // 1000
    34	        return reserved, 922000, cap
    35	    if provider == 'jev' and request.get('model') == 'jev-1.14.0':
    36	        if set(request) != {'model', 'state', 'questions'} or not request['questions']:
    37	            raise BudgetError('unreviewed Jev request shape')
    38	        tokens = 65536 * (len(request['questions']) + 1)
    39	        return (tokens * 42 + 999) // 1000, tokens, None
    40	    raise BudgetError('unreviewed provider or model')
    41	
    42	
    43	def request_envelope(provider, request):
    44	    """Reserve from the request itself: a byte-level tokenizer never makes more input tokens than the request's UTF-8
    45	    bytes; 2,048 tokens cover message framing. The output bound is the request's own cap; rates are as in envelope()."""
    46	    reserved, _, cap = envelope(provider, request)
    47	    if provider != 'openai':
    48	        return reserved, _, cap
    49	    bound = len(model.request_identity(request)[0].encode('utf-8')) + 2048
    50	    return (bound * 550 + cap * 825 + 999) // 1000, bound, cap
    51	
    52	
    53	def charge(provider, response, max_input, max_output):
    54	    usage = response.get('usage', {}) if isinstance(response, dict) else {}
    55	    names = ('prompt_tokens', 'completion_tokens') if provider == 'openai' else ('input_tokens', 'output_tokens')
    56	    counts = [usage.get(k) for k in names]
    57	    if any(type(n) is not int or n < 0 for n in counts) or counts[0] > max_input or (max_output is not None and counts[1] > max_output):
    58	        raise BudgetError('missing, invalid or above-envelope usage')
    59	    a, b = counts
    60	    # Integer microdollars, rounded up. OpenAI uses the highest reviewed Standard rate,
    61	    # not an estimate of a discount or the provider's eventual bill.
    62	    cost = (a * 550 + b * 825 + 999) // 1000 if provider == 'openai' else (a * 42 + 999) // 1000
    63	    return cost
