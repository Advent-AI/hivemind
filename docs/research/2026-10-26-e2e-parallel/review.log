   160	def single_attempt_http():
   161	    """Explicit live opt-in. Credentials are loaded once; tests supply a fake sender. A failure without a usable
   162	    reply (network, rate limit, server error) is a RetryableError; any other HTTP status is final."""
   163	    keys = {'openai': model._key('openai'), 'jev': jev._key()}
   164	    urls = {'openai': model.ENDPOINTS['openai'][0], 'jev': jev.ENDPOINT}
   165	    if any(not isinstance(k, str) or not k for k in keys.values()):
   166	        raise BudgetError('configured provider credential missing')
   167	
   168	    def prepare(provider, body):
   169	        headers = {'Authorization': 'Bearer ' + keys[provider], 'Content-Type': 'application/json', 'Accept': 'application/json'}
   170	        data = json.dumps(body, sort_keys=True, ensure_ascii=False).encode('utf-8')
   171	        request = urllib.request.Request(urls[provider], data, headers)
   172	        def send():
   173	            try:
   174	                with urllib.request.urlopen(request, timeout=TIMEOUTS[provider]) as reply:
   175	                    raw = reply.read()
   176	            except urllib.error.HTTPError as exc:
   177	                kind = RetryableError if exc.code in RETRYABLE_STATUSES else model.TransportError
   178	                raise kind(f'{provider} HTTP {exc.code}') from None
   179	            except (OSError, http.client.HTTPException) as exc:   # URLError, timeouts, TLS EOF, truncated replies
   180	                raise RetryableError(f'{provider} transport failed: {type(exc).__name__}') from None
   181	            if any(k.encode('utf-8') in raw for k in keys.values()):
   182	                raise model.TransportError('credential in response; response not saved')
   183	            return json.loads(raw)
   184	        return send
   185	    return prepare
