   193	class ArchiveProvider:
   194	    """Serves a trial's own answers to the concurrent runner; an unknown request may only be a speculation that the
   195	    runner then discards (the cross-replay comparison and audit fail if one is accepted)."""
   196	
   197	    def __init__(self, archive_path):
   198	        with readonly(archive_path) as db:
   199	            self.calls = {r['request_sha256']: json.loads(r['response_json']) for r in db.execute(
   200	                'select request_sha256,response_json from model_calls where answer_json is not null')}
   201	        self.lock, self.unknown = threading.Lock(), 0
   202	
   203	    def __call__(self, *args):
   204	        request = args[-1]
   205	        sha = model.request_identity(request)[1]
   206	        if sha in self.calls:
   207	            return json.loads(json.dumps(self.calls[sha]))
   208	        if len(args) == 2 and request['response_format']['json_schema']['name'] == 'extraction':
   209	            with self.lock:
   210	                self.unknown += 1
   211	            return {'choices': [{'message': {'content': json.dumps({'evidence': [], 'candidates': [], 'new_groups': []})}}],
   212	                    'usage': {'prompt_tokens': 0, 'completion_tokens': 0}}
   213	        raise AssertionError('authoritative request missing from the trial archive: ' + sha)
