   100	    problems = validate(answers, questions)
   101	    usage = response.get('usage') or {} if isinstance(response, dict) else {}
   102	    input_tokens, output_tokens = int(usage.get('input_tokens') or 0), int(usage.get('output_tokens') or 0)
   103	    price_in, _ = model.PRICES.get(setting.model, (0.0, 0.0))
   104	    cost = round(input_tokens / 1e6 * price_in, 6)
   105	    call_id = archive.record(purpose=purpose, config_version=cfg.version, config_checksum=cfg.checksum, model=setting.model,
   106	                             request_sha256=sha if not problems else sha + ':schema:' + uuid.uuid4().hex[:8], request_json=request_json,
   107	                             response_json=json.dumps(response, ensure_ascii=False)[:200000], answer_json=json.dumps(answers, ensure_ascii=False) if answers is not None else None,
   108	                             prompt_chars=prompt_chars, input_tokens=input_tokens, output_tokens=output_tokens, cost_usd=cost,
   109	                             seconds=seconds, created_at=time.strftime('%Y-%m-%dT%H:%M:%S'))
   110	    if problems:
   111	        raise model.SchemaError('; '.join(problems[:5]))
   112	    return model.Answer(answers, call_id, sha, False, prompt_chars, input_tokens, output_tokens, cost)

