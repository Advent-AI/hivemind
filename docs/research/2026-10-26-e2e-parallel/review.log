    43	def request_envelope(provider, request):
    44	    """Reserve from the request itself: a byte-level tokenizer never makes more input tokens than the request's UTF-8
    45	    bytes; 2,048 tokens cover message framing. The output bound is the request's own cap; rates are as in envelope()."""
