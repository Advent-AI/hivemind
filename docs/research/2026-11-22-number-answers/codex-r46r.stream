re_periods': []}\n   179\tR4_PASSAGES = store_passages('old-3', ['e3660'])\n   180\t\n   181\t\n   182\tdef r4():\n   183\t    return {'figures': [\n   184\t        src('c20', 'e3660', '$20 billion', 20.0, 'USD bn', 'guidance', W('NVIDIA', 'revenue', 'CPU', 'FY2027')),\n   185\t        src('m2', 'e3660', 'more than double', 2.0, 'x', 'guidance', W('NVIDIA', 'revenue multiple', 'CPU', 'FY2028'), 'multiplier', '>'),\n   186\t        comp('cpu28', 'product', ['c20', 'm2'], 40.0, 'USD bn', W('NVIDIA', 'revenue', 'CPU', 'FY2028'), basis='guidance', bound='>'),\n   187\t        est('vera28', (38.0, 39.0), 'USD bn', W('NVIDIA', 'revenue', 'Vera CPU', 'FY2028'),\n   188\t            \"management's CPU outlook read as Vera's, trimmed for no shipment volume in hand and AMD's benchmarks\", ['cpu28'],\n   189\t            adjusts={'figure': 'cpu28', 'type': 'trim'}),\n   190\t    ], 'answers': [ans('v41', 'vera28', 3, {'figure': 'cpu28'})]}\n   191\t\n   192\t\n   193\t# ---------- G1–G4: the frozen gold's reasoning (q01, q02, q19, q22) ----------\n   194\tG_PASSAGES = packet_passages(['i037', 'i090', 'i280', 'i281', 'i295', 'i106', 'i219', 'i216', 'i288', 'i129', 'i096', 'i218', 'i256', 'i173'])\n   101\t        return [('C1', f'{fig[\"id\"]}: value {fig.get(\"value\")} {unit} bound {bound} does not equal \"{expr[\"text\"]}\" as component {comp}')]\n   102\t    return []\n   103\t\n   104\t\n   105\tdef _interval(fig):\n   106\t    if 'low' in fig and 'high' in fig:\n   107\t        return fig['low'], fig['high']\n   108\t    return fig['value'], fig['value']\n   109\t\n   110\t\n   111\tdef _compute(op, inputs, signs, out_unit=None):\n   141\t        return los[0] * (1 - los[1] / 100.0), his[0] * (1 + his[1] / 100.0)\n   142\t    raise ValueError(op)\n   143\t\n   144\t\n   145\tDIRECTION = {'>': 'lower', '>=': 'lower', 'approx_above': 'lower', '<': 'upper', '<=': 'upper', 'approx_below': 'upper',\n   146\t             'approx': 'two-sided', None: None}\n   147\tFLIP = {'lower': 'upper', 'upper': 'lower', 'two-sided': 'two-sided', None: None}\n   148\t\n   149\t\n   150\tdef _bound_direction(op, ins):\n   151\t    \"\"\"For positive operands: which side the result is bounded on, from its inputs' bounds (None: a point).\"\"\"\n   152\t    dirs = [DIRECTION.get(i.get('bound')) for i in ins]\n   153\t    if op == 'ratio' and len(dirs) == 2:\n   154\t        dirs = [dirs[0], FLIP[dirs[1]]]\n   155\t    if op == 'difference' and len(dirs) == 2:\n   156\t        dirs = [dirs[0], FLIP[dirs[1]]]\n   157\t    found = {d for d in dirs if d}\n   158\t    if not found:\n   159\t        return None\n   160\t    return found.pop() if len(found) == 1 and 'two-sided' not in found else 'two-sided'\n   161\t\n   162\t\n   163\tdef _close(declared, expected, unit):\ngate-run14.txt:26:PASS  R4     trim definitely crosses 40\ngate-run14.txt:103:PASS  R1rneg  C6: no such rung\ngate-run14.txt:104:        C6: v9: rung -2 is not one of 1..5\ngate-run14.txt:106:PASS  R1r6   C6: no such rung\ngate-run14.txt:107:        C6: v9: rung 6 is not one of 1..5\ngate-run14.txt:109:PASS  R1rnone  C6: no such rung\ngate-run14.txt:110:        C6: v9: rung None is not one of 1..5\nDESIGN.md:71:| **C1 source expression** [46b.2] | code extracts every complete numeric expression from the cited passage as shown, with its qualifiers and unit. Points: \"$108.0 billion\". Ranges: \"$105–110 billion\". Relative: \"$108.0 billion, plus or minus 2%\" is midpoint 108 ±2%. Bounds: \"more than $730 billion\" (>730), \"at least\" (>=). Approximate bounds: \"nearly $800 billion\" (approx_below 800). Multipliers: \"double\" ×2, \"more than double\" (>×2). A source figure names one extracted expression and a component of it (midpoint, low, high, bound, multiplier), and must equal it exactly: value, unit, sign and qualifier. Any other wording cannot be a source figure | a figure that strips a qualifier ($730 from \"more than $730 billion\"); a bound used as a point; a wrong number within 0.5%