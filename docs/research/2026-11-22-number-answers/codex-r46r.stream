{"type":"item.started","item":{"id":"item_7","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"python3 -B -c '\nimport pathlib,json,io,contextlib,copy,types\nimport gate as g, calc_check as c, render_v13 as r, mutants\ndef replay(func, log):\n    p=io.StringIO()\n    with contextlib.redirect_stdout(p): status=func()\n    assert status==0 and p.getvalue()==pathlib.Path(log).read_text()\nreplay(g.main,'\\\\''gate-run14.txt'\\\\'')\nassert g.MANIFEST==json.loads(pathlib.Path('\\\\''gate-run14.fixtures.json'\\\\'').read_text())\nreplay(r.main,'\\\\''render-r1.txt'\\\\'')\noriginal=g.cc\npath=pathlib.Path('\\\\''calc_check.py'\\\\'')\nsrc=path.read_text()\nfor name,old,new,target in mutants.MUTANTS:\n    g.cc=original\n    if old:\n        assert src.count(old)==1,name\n        mod=types.ModuleType('\\\\''in_memory_calc_check'\\\\'')\n        exec(compile(src.replace(old,new),str(path),'\\\\''exec'\\\\''),mod.__dict__)\n        g.cc=mod\n    misses={name for name,ok,_,_ in g.run() if not ok}\n    assert (target in misses if target else not misses),(name,misses)\ng.cc=original\nprint('\\\\''63 gate items, 29 mutants and stored render reproduced'\\\\'')\ndef check(name,case,passages):\n    fam,x=case['\\\\''family'\\\\''],case['\\\\''calc'\\\\'']\n    schema=r.v13_schema(list(fam['\\\\''members'\\\\'']),list(passages),[])\n    wire=r.strict(x,schema)\n    clean=r.without_nulls(wire)\n    report=c.check(fam,passages,clean)\n    print(name, r.model.check_schema(wire,schema), report['\\\\''errors'\\\\''], c.publish_decision(fam,clean,report))\nfor name in ('\\\\''R1c'\\\\'','\\\\''R1rneg'\\\\'','\\\\''R1r6'\\\\'','\\\\''R1rnone'\\\\''):\n    check(name,g.MANIFEST[name],g.R1_PASSAGES)\nfor rung in (2,3):\n    a=copy.deepcopy(g.MANIFEST['\\\\''R4'\\\\''])\n    x=a['\\\\''calc'\\\\'']\n    trim=next(f for f in x['\\\\''figures'\\\\''] if f['\\\\''id'\\\\'']=='\\\\''vera28'\\\\'')\n    trim.pop('\\\\''low'\\\\'')\n    trim.pop('\\\\''high'\\\\'')\n    trim.update(value=40.0,bound='\\\\''<'\\\\'')\n    x['\\\\''answers'\\\\''][0].update(rung=rung,reasons='\\\\''The Vera CPU forecast is below \"'$40B.'\"'\\\\'')\n    check(f'\\\\''R4 strictly below \"'$40B, rung {rung}'\"'\\\\'',a,g.R4_PASSAGES)\n'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"python3 -B -c '\nimport pathlib,json,io,contextlib,copy,types\nimport gate as g, calc_check as c, render_v13 as r, mutants\ndef replay(func, log):\n    p=io.StringIO()\n    with contextlib.redirect_stdout(p): status=func()\n    assert status==0 and p.getvalue()==pathlib.Path(log).read_text()\nreplay(g.main,'\\\\''gate-run14.txt'\\\\'')\nassert g.MANIFEST==json.loads(pathlib.Path('\\\\''gate-run14.fixtures.json'\\\\'').read_text())\nreplay(r.main,'\\\\''render-r1.txt'\\\\'')\noriginal=g.cc\npath=pathlib.Path('\\\\''calc_check.py'\\\\'')\nsrc=path.read_text()\nfor name,old,new,target in mutants.MUTANTS:\n    g.cc=original\n    if old:\n        assert src.count(old)==1,name\n        mod=types.ModuleType('\\\\''in_memory_calc_check'\\\\'')\n        exec(compile(src.replace(old,new),str(path),'\\\\''exec'\\\\''),mod.__dict__)\n        g.cc=mod\n    misses={name for name,ok,_,_ in g.run() if not ok}\n    assert (target in misses if target else not misses),(name,misses)\ng.cc=original\nprint('\\\\''63 gate items, 29 mutants and stored render reproduced'\\\\'')\ndef check(name,case,passages):\n    fam,x=case['\\\\''family'\\\\''],case['\\\\''calc'\\\\'']\n    schema=r.v13_schema(list(fam['\\\\''members'\\\\'']),list(passages),[])\n    wire=r.strict(x,schema)\n    clean=r.without_nulls(wire)\n    report=c.check(fam,passages,clean)\n    print(name, r.model.check_schema(wire,schema), report['\\\\''errors'\\\\''], c.publish_decision(fam,clean,report))\nfor name in ('\\\\''R1c'\\\\'','\\\\''R1rneg'\\\\'','\\\\''R1r6'\\\\'','\\\\''R1rnone'\\\\''):\n    check(name,g.MANIFEST[name],g.R1_PASSAGES)\nfor rung in (2,3):\n    a=copy.deepcopy(g.MANIFEST['\\\\''R4'\\\\''])\n    x=a['\\\\''calc'\\\\'']\n    trim=next(f for f in x['\\\\''figures'\\\\''] if f['\\\\''id'\\\\'']=='\\\\''vera28'\\\\'')\n    trim.pop('\\\\''low'\\\\'')\n    trim.pop('\\\\''high'\\\\'')\n    trim.update(value=40.0,bound='\\\\''<'\\\\'')\n    x['\\\\''answers'\\\\''][0].update(rung=rung,reasons='\\\\''The Vera CPU forecast is below \"'$40B.'\"'\\\\'')\n    check(f'\\\\''R4 strictly below \"'$40B, rung {rung}'\"'\\\\'',a,g.R4_PASSAGES)\n'\"","aggregated_output":"63 gate items, 29 mutants and stored render reproduced\nR1c [] [] publish\nR1rneg [] [('C6', 'v9: rung -2 is not one of 1..5')] refused\nR1r6 [] [('C6', 'v9: rung 6 is not one of 1..5')] refused\nR1rnone [] [('C6', 'v9: rung None is not one of 1..5')] refused\nR4 strictly below $40B, rung 2 [] [] publish\nR4 strictly below $40B, rung 3 [] [('C6', 'v41: rung 3 ([30, 40]) contains no part of its outcome 40.0–40.0')] refused\n","exit_code":0,"status":"completed"}}
