{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba paid_gate.py | sed -n '374,581p'\"","aggregated_output":"   374\t\n   375\t\n   376\tdef normalise(calc):\n   377\t    \"\"\"Figure ids renumbered F1.. and member prefixes removed, so the arm cannot be read from the ids.\"\"\"\n   378\t    rename = {f['id']: f'F{n}' for n, f in enumerate(calc['figures'], 1)}\n   379\t    out = []\n   380\t    for f in calc['figures']:\n   381\t        g = dict(f, id=rename[f['id']])\n   382\t        for key in ('inputs', 'rests_on', 'converts'):\n   383\t            if key in g:\n   384\t                g[key] = [rename.get(x, x) for x in g[key]]\n   385\t        for key in ('disputed', 'bridge'):\n   386\t            if key in g:\n   387\t                g[key] = rename.get(g[key], g[key])\n   388\t        if 'adjusts' in g:\n   389\t            g['adjusts'] = dict(g['adjusts'], figure=rename.get(g['adjusts']['figure'], g['adjusts']['figure']))\n   390\t        out.append(g)\n   391\t    answers = []\n   392\t    for a in calc['answers']:\n   393\t        a2 = dict(a)\n   394\t        if 'outcome' in a2:\n   395\t            a2['outcome'] = rename.get(a2['outcome'], a2['outcome'])\n   396\t        if (a2.get('reference') or {}).get('figure'):\n   397\t            a2['reference'] = {'figure': rename.get(a2['reference']['figure'], a2['reference']['figure'])}\n   398\t        answers.append(a2)\n   399\t    return {'figures': out, 'answers': answers}, rename\n   400\t\n   401\t\n   402\tdef run_digest(out):\n   403\t    h = hashlib.sha256()\n   404\t    for name in ('answers.jsonl', 'results.json', 'plan.json'):\n   405\t        path = out / name\n   406\t        h.update(name.encode() + b'\\0' + (path.read_bytes() if path.exists() else b''))\n   407\t    return h.hexdigest()\n   408\t\n   409\t\n   410\tdef card_view(calc, view_id, recorded):\n   411\t    \"\"\"[47b.3] One card as its own derivation: the figures its outcome and reference rest on, renumbered F1.. for this card alone, and\n   412\t    the recorded assumptions about its outcome mapped to the same numbers.\"\"\"\n   413\t    figs = {f['id']: f for f in calc['figures']}\n   414\t    refs = lambda f: list(f.get('inputs', [])) + [r for r in f.get('rests_on', []) if r in figs] + \\\n   415\t        ([f['adjusts']['figure']] if f.get('adjusts') else []) + ([f['bridge']] if f.get('bridge') else [])\n   416\t    ans = next(a for a in calc['answers'] if a['view_id'] == view_id)\n   417\t    own = set()\n   418\t    for start in (ans.get('outcome'), (ans.get('reference') or {}).get('figure')):\n   419\t        if start in figs:\n   420\t            own |= cc._upstream_of(start, figs, refs) | {start}\n   421\t    sub = {'figures': [f for f in calc['figures'] if f['id'] in own], 'answers': [ans]}\n   422\t    norm, rename = normalise(sub)\n   423\t    mapped = []\n   424\t    for r in recorded:                                    # an assumption about this card's outcome, or about one of its own figures\n   425\t        named = [r[k] for k in ('figure', 'bridge') if isinstance(r.get(k), str)]\n   426\t        if (r.get('outcome') == view_id or any(n in rename for n in named)) and all(n in rename for n in named):\n   427\t            mapped.append({k: rename[v] if k in ('figure', 'bridge') else v for k, v in r.items()})\n   428\t    return norm, mapped, sorted({f['evidence'] for f in sub['figures'] if f.get('evidence')} | set(ans.get('cites', []))\n   429\t                                | {x for f in sub['figures'] for x in f.get('rests_on', []) if str(x).startswith('e')})\n   430\t\n   431\t\n   432\tdef packets(out, key_dir):\n   433\t    if (key_dir / 'packet-key.json').exists():            # [47b.4] the inventory and key are frozen once made\n   434\t        raise SystemExit(f'{key_dir / \"packet-key.json\"} exists: the packets are frozen; refused')\n   435\t    results = json.loads((out / 'results.json').read_text())\n   436\t    items = {(i['unit'], i['arm']): i for i in json.loads((out / 'plan.json').read_text())}\n   437\t    units = []\n   438\t    for key, entry in results['finals'].items():\n   439\t        unit, arm, draw = key.split('|')\n   440\t        if not arm.startswith('separate-'):\n   441\t            units.append((unit, arm, draw, entry, {v: entry for v in items[(unit, arm)]['members']}))\n   442\t    for key, entry in results['reconciled'].items():\n   443\t        unit, draw = key.split('|')\n   444\t        per_card = {a.split('-', 1)[1]: results['finals'].get(f'{unit}|{a}|{draw}', {}) for (u, a) in items if u == unit and a.startswith('separate-')}\n   445\t        units.append((unit, 'separate', draw, entry, per_card))\n   446\t    rng = random.Random(secrets.randbits(64))\n   447\t    rng.shuffle(units)\n   448\t    key, lines = {'run_digest': run_digest(out), 'packets': {}}, []\n   449\t    for n, (unit, arm, draw, entry, per_card) in enumerate(units, 1):\n   450\t        pid = f'P{n:02d}'\n   451\t        base = items[(unit, 'joint' if unit.startswith('pair') else 'single')]\n   452\t        decision = entry.get('decision')\n   453\t        grounds = set()\n   454\t        lines.append(f'## {pid}')\n   455\t        lines.append('Code decision for the packet: ' + ('published' if decision == 'publish' else 'not published'))\n   456\t        for v in base['members']:\n   457\t            q = base['questions'][v]\n   458\t            lines.append(f'### Card {v}: {q[\"question\"]}\\n  Ladder: ' + ' / '.join(f'rung {i + 1}: {c}' for i, c in enumerate(q['ladder'])))\n   459\t            source = per_card.get(v, {})\n   460\t            for a in source.get('attempts', []):          # every attempt of this card, with neutral labels and check codes only\n   461\t                codes = sorted({c for c, _ in (a.get('errors') or [])})\n   462\t                lines.append(f'  Attempt {a[\"attempt\"]}: ' + ('accepted by the checks' if a.get('decision') in ('publish', 'held') else 'refused')\n   463\t                             + (f' ({\", \".join(codes)})' if codes else ''))\n   464\t            if not source.get('attempts'):\n   465\t                lines.append('  No attempt was made.')\n   466\t            data = source.get('data')\n   467\t            if data:\n   468\t                calc = strip(data)\n   469\t                fam = base['family'] if arm != 'separate' else only(base['family'], v)\n   470\t                try:\n   471\t                    checked = cc.check(fam, base['passages'], calc)\n   472\t                except Exception as error:\n   473\t                    checked = {'errors': [('checker', str(error))], 'recorded': [], 'published': {}}\n   474\t                try:\n   475\t                    norm, recorded, named = card_view(calc, v, checked.get('recorded', []))\n   476\t                except StopIteration:\n   477\t                    lines.append('  The answer has no card for this question.')\n   478\t                    continue\n   479\t                grounds |= set(named) | {f['id'] for f in norm['figures']}\n   480\t                lines.append('  Passages, as the request showed them:\\n' + '\\n'.join('  ' + base['shown'].get(e, f'- {e} (not shown)') for e in named))\n   481\t                lines.append('  Figures (declared):\\n' + '\\n'.join(f'  - {json.dumps(f, ensure_ascii=False)}' for f in norm['figures']))\n   482\t                lines.append('  Recomputed outcome: ' + json.dumps((checked.get('published') or {}).get(v)))\n   483\t                lines.append('  Recorded assumptions: ' + json.dumps(recorded))\n   484\t                lines.append('  Card: ' + json.dumps(norm['answers'][0], ensure_ascii=False))\n   485\t        lines.append('For each card answer yes or no, each with a ground that names a passage (e...) or figure (F...) of this packet: '\n   486\t                     + '; '.join(f'{k}: {v}' for k, v in QUESTIONS.items()) + '\\n')\n   487\t        key['packets'][pid] = {'unit': unit, 'arm': arm, 'draw': draw, 'decision': decision, 'members': base['members'], 'grounds': sorted(grounds)}\n   488\t    text = '\\n'.join(lines)\n   489\t    key['packets_sha256'] = hashlib.sha256(text.encode()).hexdigest()\n   490\t    key_dir.mkdir(parents=True, exist_ok=True)\n   491\t    with open(out / 'packets.md', 'x') as handle:\n   492\t        handle.write(text)\n   493\t    with open(key_dir / 'packet-key.json', 'x') as handle:\n   494\t        json.dump(key, handle, indent=1)\n   495\t    print(f'{len(units)} packets; key in {key_dir}')\n   496\t\n   497\t\n   498\tdef _grounded(ground, grounds):\n   499\t    \"\"\"[47b.4] A ground is non-empty text that names at least one passage or figure of the packet.\"\"\"\n   500\t    return isinstance(ground, str) and ground.strip() != '' and any(re.search(rf'\\b{re.escape(g)}\\b', ground) for g in grounds)\n   501\t\n   502\t\n   503\tdef final_readings(pid, cards, members, grounds=()):\n   504\t    \"\"\"[47.4] Two independent readings per card (A, B), each question answered yes/no with its ground; a third decides each\n   505\t    disagreement. Returns ({card: {question: answer}}, problems).\"\"\"\n   506\t    problems, final = [], {}\n   507\t    if sorted(cards) != sorted(members):\n   508\t        return None, [f'{pid}: cards {sorted(cards)} are not the unit\\'s {sorted(members)}']\n   509\t    for v, r in cards.items():\n   510\t        final[v] = {}\n   511\t        for q in QUESTIONS:\n   512\t            a, b = (r.get(x, {}).get(q, {}) for x in ('A', 'B'))\n   513\t            for name, x in (('A', a), ('B', b)):\n   514\t                if x.get('answer') not in ('yes', 'no') or not _grounded(x.get('ground'), grounds):\n   515\t                    problems.append(f'{pid} {v} {q}: reader {name} gave no yes/no with a ground from this packet')\n   516\t            if a.get('answer') == b.get('answer'):\n   517\t                final[v][q] = a.get('answer')\n   518\t            else:\n   519\t                t = r.get('third', {}).get(q, {})\n   520\t                if t.get('answer') not in ('yes', 'no') or not _grounded(t.get('ground'), grounds):\n   521\t                    problems.append(f'{pid} {v} {q}: the readers disagree and no third reading decides')\n   522\t                final[v][q] = t.get('answer')\n   523\t    return final, problems\n   524\t\n   525\t\n   526\tdef verdict(out, readings_path, key_dir):\n   527\t    \"\"\"D725's registered lines on validated readings, bound to this run.\"\"\"\n   528\t    frozen = json.loads((key_dir / 'packet-key.json').read_text())\n   529\t    submitted = json.loads(Path(readings_path).read_text())\n   530\t    key = frozen['packets']\n   531\t    problems = [] if frozen.get('run_digest') == run_digest(out) else ['the packet key does not belong to this run']   # [47b.4]\n   532\t    packets_path = out / 'packets.md'\n   533\t    if not packets_path.exists() or hashlib.sha256(packets_path.read_bytes()).hexdigest() != frozen.get('packets_sha256'):\n   534\t        problems.append('packets.md is not the frozen one')\n   535\t    if submitted.get('packets_sha256') != frozen.get('packets_sha256'):\n   536\t        problems.append('the readings were not made on the frozen packets')\n   537\t    readings = submitted.get('packets', {})\n   538\t    results = json.loads((out / 'results.json').read_text())\n   539\t    unfinished = [k for k, v in results['finals'].items() if v.get('decision') not in ('publish', 'held', 'unresolved')]\n   540\t    problems += [f'{k}: {results[\"finals\"][k][\"decision\"]}' for k in unfinished]                                  # [47b.2] from the records\n   541\t    problems += [f'{pid}: not read' for pid in key if pid not in readings] + [f'{pid}: not a packet' for pid in readings if pid not in key]\n   542\t    usable_pairs = {'joint': {}, 'separate': {}}\n   543\t    defects = []\n   544\t    for pid, k in key.items():\n   545\t        if pid not in readings:\n   546\t            continue\n   547\t        final, probs = final_readings(pid, readings[pid], k['members'], k.get('grounds', []))\n   548\t        problems += probs\n   549\t        if final is None:\n   550\t            continue\n   551\t        if k['decision'] == 'publish' and k['arm'] in ('joint', 'single'):      # D725: defects across the joint and singleton answers\n   552\t            for v, r in final.items():\n   553\t                if 'yes' in (r['contradiction'], r['internal_reference'], r['deciding_gap']):\n   554\t                    defects.append((pid, k['unit'], k['arm'], v))\n   555\t        if k['unit'].startswith('pair') and k['arm'] in usable_pairs:\n   556\t            usable_pairs[k['arm']].setdefault(k['unit'], []).append(k['decision'] == 'publish' and all(r['usable'] == 'yes' for r in final.values()))\n   557\t    joint_total = sum(sum(v) for v in usable_pairs['joint'].values())\n   558\t    separate_total = sum(sum(v) for v in usable_pairs['separate'].values())\n   559\t    per_snapshot = {u: sum(v) for u, v in usable_pairs['joint'].items()}\n   560\t    complete = (not problems and len(key) == 27 and len(usable_pairs['joint']) == 3 and len(usable_pairs['separate']) == 3\n   561\t                and all(len(v) == 3 for arm in usable_pairs.values() for v in arm.values()))\n   562\t    passes = complete and not defects and joint_total >= 8 and all(n >= 2 for n in per_snapshot.values()) and joint_total - separate_total >= 3\n   563\t    summary = {'complete': complete, 'problems': problems[:20], 'joint usable pairs': joint_total, 'separate usable pairs': separate_total,\n   564\t               'joint per snapshot': per_snapshot, 'published defects': defects,\n   565\t               'verdict': 'PASS' if passes else ('INCOMPLETE' if not complete else 'STOP')}\n   566\t    print(json.dumps(summary, indent=1))\n   567\t    return summary\n   568\t\n   569\t\n   570\tif __name__ == '__main__':\n   571\t    cmd = sys.argv[1] if len(sys.argv) > 1 else ''\n   572\t    if cmd == 'plan' and len(sys.argv) == 3:\n   573\t        plan(sys.argv[2])\n   574\t    elif cmd == 'send' and len(sys.argv) == 5 and not sys.argv[2].startswith('-'):\n   575\t        send(Path(sys.argv[2]), float(sys.argv[3]), sys.argv[4])\n   576\t    elif cmd == 'packets' and len(sys.argv) == 4:\n   577\t        packets(Path(sys.argv[2]), Path(sys.argv[3]))\n   578\t    elif cmd == 'verdict' and len(sys.argv) == 5:\n   579\t        verdict(Path(sys.argv[2]), sys.argv[3], Path(sys.argv[4]))\n   580\t    else:\n   581\t        raise SystemExit(__doc__)\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba paid_gate.py | sed -n '140,360p'\"","aggregated_output":"   140\tclass Gate:\n   141\t    def __init__(self, out, transport, ledger=None):\n   142\t        self.out, self.transport, self.ledger = out, transport, ledger\n   143\t        self.cfg = config.load(str(CONFIG))\n   144\t        self.lock = threading.Lock()\n   145\t        (out / 'archives').mkdir(parents=True, exist_ok=True)\n   146\t\n   147\t    def request(self, it, user):\n   148\t        return model.build_request(self.cfg.rejudging, it['system'], user, it['schema'], 'judgement', self.cfg.provider)\n   149\t\n   150\t    def record(self, line):\n   151\t        with self.lock, open(self.out / 'answers.jsonl', 'a') as handle:\n   152\t            handle.write(json.dumps(line, ensure_ascii=False) + '\\n')\n   153\t\n   154\t    def attempt(self, it, draw, user, n):\n   155\t        name = f'{it[\"unit\"]}-{it[\"arm\"]}-d{draw}-a{n}.sqlite'\n   156\t        archive = model.Archive(str(self.out / 'archives' / name))\n   157\t        line = {'unit': it['unit'], 'arm': it['arm'], 'draw': draw, 'attempt': n,\n   158\t                'request_sha256': model.request_identity(self.request(it, user))[1]}\n   159\t        self.record(dict(line, status='started'))                          # [47.3] recorded before the provider is called\n   160\t        data = None\n   161\t        try:\n   162\t            answer = model.call(archive, self.cfg, self.cfg.rejudging, it['system'], user, it['schema'], 'judgement', 'judge', transport=self.transport)\n   163\t            data = answer.data\n   164\t            line.update(cost_usd=answer.cost_usd, data=data)\n   165\t            calc = strip(data)\n   166\t            result = cc.check(it['family'], it['passages'], calc)\n   167\t            decision = cc.publish_decision(it['family'], calc, result)\n   168\t            line.update(status='answered', errors=result['errors'], recorded=result['recorded'], published=result.get('published'), decision=decision)\n   169\t        except model.SchemaError as error:\n   170\t            row = archive.conn.execute('select response_json from model_calls order by call_id desc limit 1').fetchone()\n   171\t            line.update(status='format invalid', error=str(error)[:500], decision='refused', errors=[('schema', str(error)[:300])],\n   172\t                        raw=row[0][:20000] if row and row[0] else None)\n   173\t        except model.TransportError as error:\n   174\t            line.update(status='transport error', error=str(error)[:500], decision='transport')\n   175\t        except Exception as error:                                       # [47.3] a checker failure is recorded with the raw answer and refused\n   176\t            line.update(status='checker error', error=f'{type(error).__name__}: {error}'[:500], decision='refused',\n   177\t                        errors=[('checker', f'{type(error).__name__}: {error}'[:300])], data=data)\n   178\t        self.record(line)\n   179\t        return line\n   180\t\n   181\t    def unit(self, it, draw):\n   182\t        first = self.attempt(it, draw, it['user'], 1)\n   183\t        if first['decision'] != 'refused':\n   184\t            return first, [first]\n   185\t        reasons = '; '.join(f'{c}: {d}' for c, d in first.get('errors', []))[:4000]\n   186\t        second = self.attempt(it, draw, it['user'] + RETRY_MARK + reasons, 2)\n   187\t        final = dict(second, decision='unresolved') if second['decision'] == 'refused' else second\n   188\t        return final, [first, second]\n   189\t\n   190\t    def run(self, items):\n   191\t        try:\n   192\t            for draw in DRAWS:\n   193\t                for it in items:\n   194\t                    if self.ledger is not None and self.ledger.read().get('stopped'):\n   195\t                        continue\n   196\t                    self.unit(it, draw)\n   197\t        finally:                                          # [47b.2] the results come from the attempt records, written even after an abort\n   198\t            summary = summarise(self.out, items, self.ledger.read() if self.ledger else None)\n   199\t        return summary\n   200\t\n   201\t\n   202\tdef attempt_records(out):\n   203\t    path = out / 'answers.jsonl'\n   204\t    return [json.loads(l) for l in path.read_text().splitlines()] if path.exists() else []\n   205\t\n   206\t\n   207\tdef derive_finals(out, items):\n   208\t    \"\"\"Each planned unit and draw: 'dispatched' (a started line), 'completed' (a finished line), and the decision of its last finished\n   209\t    attempt (a second refusal is unresolved). A unit with no started line is not sent; one started but not finished is interrupted.\"\"\"\n   210\t    records = attempt_records(out)\n   211\t    finals = {}\n   212\t    for it in items:\n   213\t        for draw in DRAWS:\n   214\t            mine = [r for r in records if r['unit'] == it['unit'] and r['arm'] == it['arm'] and r['draw'] == draw]\n   215\t            started = [r for r in mine if r['status'] == 'started']\n   216\t            done = [r for r in mine if r['status'] != 'started']\n   217\t            key = f'{it[\"unit\"]}|{it[\"arm\"]}|{draw}'\n   218\t            if not started:\n   219\t                finals[key] = {'decision': 'not sent', 'attempts': []}\n   220\t                continue\n   221\t            if len(done) < len(started):\n   222\t                finals[key] = {'decision': 'interrupted', 'attempts': done}\n   223\t                continue\n   224\t            last = done[-1]\n   225\t            decision = last['decision']\n   226\t            if decision == 'refused':                          # a second refusal is unresolved; a first with no retry sent is incomplete\n   227\t                decision = 'unresolved' if len(done) >= 2 else 'retry not sent'\n   228\t            finals[key] = {k: last.get(k) for k in ('status', 'data', 'errors', 'recorded', 'published')}\n   229\t            finals[key].update(decision=decision, attempts=[{k: r.get(k) for k in ('attempt', 'status', 'decision', 'errors', 'data')} for r in done])\n   230\t    return finals\n   231\t\n   232\t\n   233\tdef summarise(out, items, ledger_state):\n   234\t    finals = derive_finals(out, items)\n   235\t    reconciled = {}\n   236\t    for draw_store, total, dc in PAIRS:                     # the separate arm, reconciled over the pair's family\n   237\t        for draw in DRAWS:\n   238\t            a, b = (finals.get(f'pair-{draw_store}|separate-{m[0]}|{draw}', {}) for m in (total, dc))\n   239\t            if a.get('decision') != 'publish' or b.get('decision') != 'publish':\n   240\t                reconciled[f'pair-{draw_store}|{draw}'] = {'decision': 'not reconciled', 'members': [a.get('decision'), b.get('decision')]}\n   241\t                continue\n   242\t            merged = merge([(total[0], strip(a['data'])), (dc[0], strip(b['data']))])\n   243\t            family = pair_family(draw_store, total, dc)\n   244\t            pas = next(i['passages'] for i in items if i['unit'] == f'pair-{draw_store}' and i['arm'] == 'joint')\n   245\t            result = cc.check(family, pas, {k: merged[k] for k in ('figures', 'answers')})\n   246\t            reconciled[f'pair-{draw_store}|{draw}'] = {'decision': cc.publish_decision(family, merged, result), 'errors': result['errors'],\n   247\t                                                     'published': result.get('published'), 'calc': merged}\n   248\t    summary = {'finals': finals, 'reconciled': reconciled, 'ledger': ledger_state}\n   249\t    (out / 'results.json').write_text(json.dumps(summary, indent=1, ensure_ascii=False))\n   250\t    return summary\n   251\t\n   252\t\n   253\tdef _same_value(a, b):\n   254\t    \"\"\"Two recomputed (interval, bound) values are the same when their bounds match and each end agrees within 1e-9 relative.\"\"\"\n   255\t    if a is None or b is None or a[1] != b[1]:\n   256\t        return False\n   257\t    return all(abs(x - y) <= 1e-9 * max(1.0, abs(x), abs(y)) for x, y in zip(a[0], b[0]))\n   258\t\n   259\t\n   260\tdef merge(parts):\n   261\t    \"\"\"Two separate answers as one calculation: each figure id prefixed by its member; then [47.1] forecasts of the same quantity and\n   262\t    scenario whose recomputed values and bounds are equal are unified (references point to the first, the duplicate's derivation kept\n   263\t    beside the calculation), and forecasts that differ are both kept, so the family's checks see a real conflict, not a copy.\"\"\"\n   264\t    figures, answers, recomputed = [], [], {}\n   265\t    for view_id, calc in parts:\n   266\t        rename = {f['id']: f'{view_id}.{f[\"id\"]}' for f in calc['figures']}\n   267\t        figs = {f['id']: f for f in calc['figures']}\n   268\t        refs = lambda f, figs=figs: list(f.get('inputs', [])) + [r for r in f.get('rests_on', []) if r in figs] + \\\n   269\t            ([f['adjusts']['figure']] if f.get('adjusts') else []) + ([f['bridge']] if f.get('bridge') else [])\n   270\t        try:\n   271\t            values = cc._evaluate_bounded(figs, refs, {})\n   272\t        except Exception:\n   273\t            values = {}\n   274\t        for f in calc['figures']:\n   275\t            g = dict(f, id=rename[f['id']])\n   276\t            for key in ('inputs', 'rests_on', 'converts'):\n   277\t                if key in g:\n   278\t                    g[key] = [rename.get(x, x) for x in g[key]]\n   279\t            for key in ('disputed', 'bridge'):\n   280\t                if key in g:\n   281\t                    g[key] = rename.get(g[key], g[key])\n   282\t            if 'adjusts' in g:\n   283\t                g['adjusts'] = dict(g['adjusts'], figure=rename.get(g['adjusts']['figure'], g['adjusts']['figure']))\n   284\t            figures.append(g)\n   285\t            recomputed[g['id']] = values.get(f['id'])\n   286\t        for a in calc['answers']:\n   287\t            a2 = dict(a)\n   288\t            if 'outcome' in a2:\n   289\t                a2['outcome'] = rename.get(a2['outcome'], a2['outcome'])\n   290\t            if a2.get('reference', {}).get('figure'):\n   291\t                a2['reference'] = {'figure': rename.get(a2['reference']['figure'], a2['reference']['figure'])}\n   292\t            answers.append(a2)\n   293\t    key = lambda f: (f['what']['population'], f['what']['measure'], f['what']['scope'], f['what']['period'], f.get('scenario', 'base'))\n   294\t    first, alias, duplicates = {}, {}, []\n   295\t    for g in figures:\n   296\t        if g.get('basis') != 'forecast':\n   297\t            continue\n   298\t        k = key(g)\n   299\t        if k in first and _same_value(recomputed.get(first[k]), recomputed.get(g['id'])):           # [47b.1] a fixed numeric equivalence\n   300\t            alias[g['id']] = first[k]\n   301\t        else:\n   302\t            first.setdefault(k, g['id'])\n   303\t    if alias:\n   304\t        kept = []\n   305\t        for g in figures:\n   306\t            if g['id'] in alias:\n   307\t                duplicates.append(g)\n   308\t                continue\n   309\t            for k2 in ('inputs', 'rests_on', 'converts'):\n   310\t                if k2 in g:\n   311\t                    g[k2] = [alias.get(x, x) for x in g[k2]]\n   312\t            for k2 in ('disputed', 'bridge'):\n   313\t                if k2 in g:\n   314\t                    g[k2] = alias.get(g[k2], g[k2])\n   315\t            if 'adjusts' in g:\n   316\t                g['adjusts'] = dict(g['adjusts'], figure=alias.get(g['adjusts']['figure'], g['adjusts']['figure']))\n   317\t            kept.append(g)\n   318\t        figures = kept\n   319\t        for a in answers:\n   320\t            if a.get('outcome') in alias:\n   321\t                a['outcome'] = alias[a['outcome']]\n   322\t            if a.get('reference', {}).get('figure') in alias:\n   323\t                a['reference'] = {'figure': alias[a['reference']['figure']]}\n   324\t    return {'figures': figures, 'answers': answers, 'unified': [{'kept': alias[d['id']], 'duplicate': d} for d in duplicates]}\n   325\t\n   326\t\n   327\tdef budget_module():\n   328\t    import importlib.util\n   329\t    spec = importlib.util.spec_from_file_location('budget_replay_v13', REPO / 'clean-arch/e2e-comparison-2026-11-13/budget_replay.py')\n   330\t    module = importlib.util.module_from_spec(spec)\n   331\t    spec.loader.exec_module(module)\n   332\t    return module\n   333\t\n   334\t\n   335\tdef send(out, approved, plan_path):\n   336\t    if APPROVED_CEILING is None or approved != APPROVED_CEILING:\n   337\t        raise SystemExit(f'the approved ceiling is {APPROVED_CEILING} (Alex names it); refused')\n   338\t    if out.exists():\n   339\t        raise SystemExit(f'{out} exists: the gate starts from an empty folder')\n   340\t    text = Path(plan_path).read_text()\n   341\t    if hashlib.sha256(text.encode()).hexdigest() != PINNED_PLAN_SHA256:          # [47.2] only the reviewed plan\n   342\t        raise SystemExit('the plan is not the reviewed one (sha256 differs); refused')\n   343\t    AUTH.parent.mkdir(parents=True, exist_ok=True)\n   344\t    try:                                                                     # [47.2] one authorization, one ledger, one launch\n   345\t        with open(AUTH, 'x') as handle:\n   346\t            json.dump({'plan_sha256': PINNED_PLAN_SHA256, 'ceiling': approved, 'out': str(out)}, handle)\n   347\t    except FileExistsError:\n   348\t        raise SystemExit(f'{AUTH} exists: this authorization was already used; refused')\n   349\t    items = json.loads(text)\n   350\t    if len({(i['unit'], i['arm']) for i in items}) != len(items):\n   351\t        raise SystemExit('duplicate (unit, arm) in the plan; refused')\n   352\t    out.mkdir(parents=True)\n   353\t    (out / 'plan.json').write_text(json.dumps(items))\n   354\t    budget = budget_module()\n   355\t    budget.SharedLedger.init(str(out / 'ledger.json'), approved)\n   356\t    ledger = budget.SharedLedger(str(out / 'ledger.json'))\n   357\t    lock_handle = open(out / 'gate.launcher.lock', 'a+')\n   358\t    if not ledger.claim_launcher('v13-gate', lock_handle):\n   359\t        raise SystemExit('another launch is running')\n   360\t    remove_gate = budget.install_stop_gate(ledger)\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_8","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba paid_rehearsal.py | sed -n '207,291p;316,392p'; nl -ba paid_mutants.py | sed -n '10,80p'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba paid_rehearsal.py | sed -n '207,291p;316,392p'; nl -ba paid_mutants.py | sed -n '10,80p'\"","aggregated_output":"   207\t    yes = lambda a='yes': {'answer': a, 'ground': 'F1 rehearsal'}\n   208\t\n   209\t    def card(usable='yes', gap='no', drop=None, b_differs=None, third=None):\n   210\t        def one():\n   211\t            r = {'usable': yes(usable), 'contradiction': yes('no'), 'internal_reference': yes('no'), 'deciding_gap': yes(gap)}\n   212\t            if drop:\n   213\t                r[drop] = {'answer': 'no', 'ground': ''}\n   214\t            return r\n   215\t        a, b = one(), one()\n   216\t        if b_differs:\n   217\t            b[b_differs] = yes('no' if a[b_differs]['answer'] == 'yes' else 'yes')\n   218\t        out = {'A': a, 'B': b}\n   219\t        if third:\n   220\t            out['third'] = third\n   221\t        return out\n   222\t\n   223\t    def readings(good_separate, defect_arm=None, drop_packet=False, bad_card=False, missing_ground=False, disagree=None, null_ground=False,\n   224\t                 foreign_ground=False):\n   225\t        rd, seen_sep, defect_done = {}, 0, False\n   226\t        for pid, k in sorted(key.items()):\n   227\t            usable = 'yes'\n   228\t            if k['arm'] == 'separate':\n   229\t                seen_sep += 1\n   230\t                usable = 'yes' if seen_sep <= good_separate else 'no'\n   231\t            rd[pid] = {v: card(usable) for v in k['members']}\n   232\t            if defect_arm and k['arm'] == defect_arm and not defect_done:\n   233\t                rd[pid][k['members'][0]] = card(usable, gap='yes')\n   234\t                defect_done = True\n   235\t        first = sorted(rd)[0]\n   236\t        if drop_packet:\n   237\t            rd.pop(first)\n   238\t        if bad_card:\n   239\t            rd[first]['v999'] = rd[first].pop(sorted(rd[first])[0])\n   240\t        if missing_ground:\n   241\t            rd[first][sorted(rd[first])[0]] = card(drop='usable')\n   242\t        if disagree is not None:\n   243\t            rd[first][sorted(rd[first])[0]] = card(b_differs='usable', third=disagree)\n   244\t        if null_ground:\n   245\t            rd[first][sorted(rd[first])[0]]['A']['usable'] = {'answer': 'yes', 'ground': None}\n   246\t        if foreign_ground:\n   247\t            rd[first][sorted(rd[first])[0]]['A']['usable'] = {'answer': 'yes', 'ground': 'the passage about the total'}\n   248\t        return rd\n   249\t\n   250\t    def verdict_of(rd, name, out=None, keys=None, packets_sha=None):\n   251\t        path = scratch / f'readings-{name}.json'\n   252\t        path.write_text(json.dumps({'packets_sha256': packets_sha or frozen['packets_sha256'], 'packets': rd}))\n   253\t        return pg.verdict(out or scratch / 'clean', str(path), keys or keydir)\n   254\t    v = verdict_of(readings(9), 'all-good')\n   255\t    check('verdict: both arms usable everywhere: STOP (gain under 3)', v['verdict'] == 'STOP' and v['joint usable pairs'] == 9 and v['separate usable pairs'] == 9)\n   256\t    v = verdict_of(readings(5), 'gain-4')\n   257\t    check('verdict: joint 9, separate 5: PASS', v['verdict'] == 'PASS', str(v['separate usable pairs']))\n   258\t    v = verdict_of(readings(5, defect_arm='single'), 'single-defect')\n   259\t    check('verdict: one published singleton defect: STOP', v['verdict'] == 'STOP' and len(v['published defects']) == 1)\n   260\t    v = verdict_of(readings(5, defect_arm='separate'), 'separate-defect')\n   261\t    check('verdict: a defect in the separate arm alone does not stop', v['verdict'] == 'PASS')\n   262\t    for name, kw in (('missing packet', {'drop_packet': True}), ('invented card', {'bad_card': True}), ('missing ground', {'missing_ground': True}),\n   263\t                     ('disagreement, no third', {'disagree': None, 'drop_packet': False})):\n   264\t        rd = readings(5, **kw) if name != 'disagreement, no third' else readings(5, disagree={})\n   265\t        v = verdict_of(rd, name.replace(' ', '-').replace(',', ''))\n   266\t        check(f'verdict: {name}: INCOMPLETE', v['verdict'] == 'INCOMPLETE', '; '.join(v['problems'][:1]))\n   267\t    v = verdict_of(readings(5, disagree={'usable': yes('yes')}), 'third-decides')\n   268\t    check('verdict: a disagreement decided by the third reader is complete', v['complete'], '; '.join(v['problems'][:1]))\n   269\t    for name, kw in (('null ground', {'null_ground': True}), ('ground naming nothing in the packet', {'foreign_ground': True})):\n   270\t        v = verdict_of(readings(5, **kw), name.replace(' ', '-'))\n   271\t        check(f'verdict: {name}: INCOMPLETE', v['verdict'] == 'INCOMPLETE', '; '.join(v['problems'][:1]))\n   272\t    v = verdict_of(readings(5), 'other-packets', packets_sha='0' * 64)\n   273\t    check('verdict: readings made on other packets: INCOMPLETE', v['verdict'] == 'INCOMPLETE', '; '.join(v['problems'][:1]))\n   274\t    shutil.copytree(scratch / 'clean', scratch / 'clean-changed')\n   275\t    changed = json.loads((scratch / 'clean-changed' / 'results.json').read_text())\n   276\t    changed['finals']['single-O|single|1']['decision'] = 'held'\n   277\t    (scratch / 'clean-changed' / 'results.json').write_text(json.dumps(changed))\n   278\t    v = verdict_of(readings(5), 'changed-run', out=scratch / 'clean-changed')\n   279\t    check('verdict: a run changed after the packets were frozen: INCOMPLETE', v['verdict'] == 'INCOMPLETE' and any('does not belong' in x for x in v['problems']),\n   280\t          '; '.join(v['problems'][:1]))\n   281\t\n   282\t    # [47b.3] one card's view: its own figures renumbered, its assumption records mapped to the same numbers, others left out\n   283\t    calc = {'figures': [{'id': 'v14.q4f', 'kind': 'source', 'evidence': 'e7', 'rests_on': []},\n   284\t                        {'id': 'v14.dc', 'kind': 'computed', 'inputs': ['v14.q4f', 'v14.q4f'], 'rests_on': []},\n   285\t                        {'id': 'v9.other', 'kind': 'source', 'evidence': 'e8', 'rests_on': []}],\n   286\t            'answers': [{'view_id': 'v14', 'outcome': 'v14.dc', 'reference': {'figure': None}, 'cites': ['e7']}]}\n   287\t    norm, mapped, named = pg.card_view(calc, 'v14', [{'type': 'overlap', 'figure': 'v14.q4f', 'outcome': 'v14'},\n   288\t                                                     {'type': 'bridge', 'figure': 'v9.other', 'bridge': 'v9.other', 'alternate': 'undetermined'}])\n   289\t    blob = json.dumps([norm, mapped])\n   290\t    check('card view: own figures only, renumbered; the assumption record mapped, the other card\\'s left out',\n   291\t          [f['id'] for f in norm['figures']] == ['F1', 'F2'] and mapped == [{'type': 'overlap', 'figure': 'F1', 'outcome': 'v14'}]\n   316\t                plan_path.write_text((HERE / 'paid-plan.json').read_text() + ' ')\n   317\t            try:\n   318\t                pg.send(scratch / f'send-{name.replace(\" \", \"-\")}', 0.5, str(plan_path))\n   319\t                refused = ''\n   320\t            except SystemExit as error:\n   321\t                refused = str(error)\n   322\t            check(f'send refuses {name}', expect in refused and not (scratch / f'send-{name.replace(\" \", \"-\")}').exists(), refused[:80])\n   323\t    finally:\n   324\t        pg.APPROVED_CEILING, pg.AUTH = saved\n   325\t\n   326\t    s, lines, stub, led = scenario(scratch, 'retry')\n   327\t    o = [l for l in lines if l['unit'] == 'single-O' and l['draw'] == 1]\n   328\t    check('retry: a refused calculation is retried once with its errors and then publishes', [l['decision'] for l in o] == ['refused', 'publish'], str([l['decision'] for l in o]))\n   329\t    s, lines, stub, led = scenario(scratch, 'unresolved')\n   330\t    check('unresolved: two refusals make the unit unresolved', s['finals']['single-S|single|1']['decision'] == 'unresolved')\n   331\t    s, lines, stub, led = scenario(scratch, 'format')\n   332\t    e = [l for l in lines if l['unit'] == 'single-E' and l['draw'] == 1]\n   333\t    check('format: a schema-invalid answer is refused, then retried', [l['status'] for l in e] == ['format invalid', 'answered'], str([l['status'] for l in e]))\n   334\t    s, lines, stub, led = scenario(scratch, 'separate-contradiction')\n   335\t    rec = s['reconciled']['pair-old-2|1']\n   336\t    check('separate: two answers that each pass alone are refused when reconciled (C3)', rec['decision'] == 'refused' and any(c == 'C3' for c, _ in rec['errors']),\n   337\t          rec['decision'])\n   338\t    s, lines, stub, led = scenario(scratch, 'ledger-stop')\n   339\t    not_sent = [k for k, v in s['finals'].items() if str(v.get('decision', '')).startswith('not sent')]\n   340\t    check('ledger-stop: after the ledger stops, nothing more is sent', led.get('stopped') and len(lines) == 5 and len(not_sent) >= 30, f'{len(lines)} attempts, {len(not_sent)} not sent')\n   341\t    s, lines, stub, led = scenario(scratch, 'separate-agree-float')\n   342\t    rec = s['reconciled']['pair-old-2|1']\n   343\t    check('separate-agree-float: Q3 forecasts equal within floating-point error are unified, and the pair reconciles',\n   344\t          rec['decision'] == 'publish' and len(rec['calc']['unified']) == 1, str(rec.get('errors'))[:120])\n   345\t    fkeys = scratch / 'key-float'\n   346\t    pg.packets(scratch / 'separate-agree-float', fkeys)\n   347\t    fkey = json.loads((fkeys / 'packet-key.json').read_text())['packets']\n   348\t    pid = next(p for p, k in fkey.items() if k['unit'] == 'pair-old-2' and k['arm'] == 'separate' and k['draw'] == '1')\n   349\t    section = (scratch / 'separate-agree-float' / 'packets.md').read_text().split(f'## {pid}\\n')[1].split('\\n## ')[0]\n   350\t    check('packets: a reconciled card is shown with its own original derivation, not the unified copy',\n   351\t          '110.00000000000001' in section and section.count('rehearsal Q3') == 2, pid)\n   352\t\n   353\t    rkeys = scratch / 'key-retry'                            # the 'retry' scenario above: single-O's first answer refused, the retry published\n   354\t    pg.packets(scratch / 'retry', rkeys)\n   355\t    rkey = json.loads((rkeys / 'packet-key.json').read_text())['packets']\n   356\t    pid = next(p for p, k in rkey.items() if k['unit'] == 'single-O' and k['draw'] == '1')\n   357\t    section = (scratch / 'retry' / 'packets.md').read_text().split(f'## {pid}\\n')[1].split('\\n## ')[0]\n   358\t    check('packets: every attempt is listed with its check codes', 'Attempt 1: refused (C6)' in section and 'Attempt 2: accepted by the checks' in section,\n   359\t          pid)\n   360\t\n   361\t    s, lines, stub, led = scenario(scratch, 'one-transport')\n   362\t    check('one-transport: a request that fails in transport is final as transport, not published', s['finals']['single-E|single|1']['decision'] == 'transport')\n   363\t    tkeys = scratch / 'key-transport'\n   364\t    pg.packets(scratch / 'one-transport', tkeys)\n   365\t    tfrozen = json.loads((tkeys / 'packet-key.json').read_text())\n   366\t    rd = {pid: {v: card() for v in k['members']} for pid, k in tfrozen['packets'].items()}\n   367\t    v = verdict_of(rd, 'transport', out=scratch / 'one-transport', keys=tkeys, packets_sha=tfrozen['packets_sha256'])\n   368\t    check('verdict: a unit failed in transport makes the verdict INCOMPLETE', v['verdict'] == 'INCOMPLETE'\n   369\t          and any('single-E|single|1: transport' in x for x in v['problems']), '; '.join(v['problems'][:2]))\n   370\t\n   371\t    s, lines, stub, led = scenario(scratch, 'interrupt', interrupted=True)\n   372\t    f = s['finals']\n   373\t    check('interrupt: results are written from the records; the unit in flight is interrupted, the rest not sent',\n   374\t          (scratch / 'interrupt' / 'results.json').exists() and f['single-O|single|1']['decision'] == 'interrupted'\n   375\t          and f['single-S|single|1']['decision'] == 'not sent' and f['pair-old-1|joint|1']['decision'] == 'publish',\n   376\t          str({k: v['decision'] for k, v in list(f.items())[9:12]}))\n   377\t    synthetic = scratch / 'retry-not-sent'\n   378\t    synthetic.mkdir()\n   379\t    base = {'unit': 'single-O', 'arm': 'single', 'draw': 1, 'attempt': 1}\n   380\t    (synthetic / 'answers.jsonl').write_text(json.dumps(dict(base, status='started')) + '\\n'\n   381\t                                             + json.dumps(dict(base, status='answered', decision='refused', errors=[['C6', 'x']])) + '\\n')\n   382\t    finals = pg.derive_finals(synthetic, [i for i in PLAN if i['unit'] == 'single-O'])\n   383\t    check('a refused first answer whose retry was never sent is incomplete, not refused or not sent',\n   384\t          finals['single-O|single|1']['decision'] == 'retry not sent' and finals['single-O|single|2']['decision'] == 'not sent')\n   385\t    print(f'{sum(checks)} of {len(checks)} checks pass')\n   386\t    return 0 if all(checks) else 1\n   387\t\n   388\t\n   389\tif __name__ == '__main__':\n   390\t    if len(sys.argv) != 2 or sys.argv[1].startswith('-'):\n   391\t        raise SystemExit('usage: paid_rehearsal.py <scratch folder>')\n   392\t    raise SystemExit(main(sys.argv[1]))\n    10\t    ('equivalence is exact equality', \"return all(abs(x - y) <= 1e-9 * max(1.0, abs(x), abs(y)) for x, y in zip(a[0], b[0]))\",\n    11\t     'return a[0] == b[0]', 'separate-agree-float'),\n    12\t    ('a transport failure counts as finished', \"v.get('decision') not in ('publish', 'held', 'unresolved')]\",\n    13\t     \"v.get('decision') not in ('publish', 'held', 'unresolved', 'transport')]\", 'a unit failed in transport'),\n    14\t    ('an attempt in flight is not seen', 'if len(done) < len(started):', 'if False:', 'interrupt:'),\n    15\t    ('results only on a clean exit', \"        finally:                                          # [47b.2] the results come from the attempt records, written even after an abort\\n            summary\",\n    16\t     '        except BaseException:\\n            raise\\n        if True:\\n            summary', 'interrupt:'),\n    17\t    ('a first refusal with no retry counts as unresolved', \"decision = 'unresolved' if len(done) >= 2 else 'retry not sent'\", \"decision = 'unresolved'\",\n    18\t     'retry was never sent'),\n    19\t    ('any text is a ground', \" and any(re.search(rf'\\\\b{re.escape(g)}\\\\b', ground) for g in grounds)\", '', 'ground naming nothing'),\n    20\t    ('the key is not bound to the run', \"problems = [] if frozen.get('run_digest') == run_digest(out) else ['the packet key does not belong to this run']\",\n    21\t     'problems = []', 'a run changed after'),\n    22\t    ('the readings are not bound to the packets', \"if submitted.get('packets_sha256') != frozen.get('packets_sha256'):\", 'if False:', 'readings made on other packets'),\n    23\t    ('the packets can be remade', \"if (key_dir / 'packet-key.json').exists():\", 'if False:', 'a second packets run is refused',\n    24\t     [(\"open(out / 'packets.md', 'x')\", \"open(out / 'packets.md', 'w')\"), (\"open(key_dir / 'packet-key.json', 'x')\", \"open(key_dir / 'packet-key.json', 'w')\")]),\n    25\t    ('a card shows the whole calculation', \"sub = {'figures': [f for f in calc['figures'] if f['id'] in own], 'answers': [ans]}\",\n    26\t     \"sub = {'figures': list(calc['figures']), 'answers': [ans]}\", 'card view'),\n    27\t    ('assumption records keep their raw ids', \"mapped.append({k: rename[v] if k in ('figure', 'bridge') else v for k, v in r.items()})\",\n    28\t     'mapped.append(dict(r))', 'card view'),\n    29\t    ('a reconciled card shows the merged calculation',\n    30\t     \"per_card = {a.split('-', 1)[1]: results['finals'].get(f'{unit}|{a}|{draw}', {}) for (u, a) in items if u == unit and a.startswith('separate-')}\",\n    31\t     \"per_card = {a.split('-', 1)[1]: dict(results['finals'].get(f'{unit}|{a}|{draw}', {}), data=entry.get('calc')) for (u, a) in items if u == unit and a.startswith('separate-')}\",\n    32\t     'own original derivation'),\n    33\t    ('only the last attempt is listed', \"for a in source.get('attempts', []):\", \"for a in source.get('attempts', [])[-1:]:\", 'every attempt is listed'),\n    34\t]\n    35\t\n    36\t\n    37\tdef build(folder, mutant):\n    38\t    folder.mkdir(parents=True)\n    39\t    gate = (HERE / 'paid_gate.py').read_text()\n    40\t    gate = gate.replace('HERE = Path(__file__).resolve().parent', f'HERE = Path({str(HERE)!r})')\n    41\t    if mutant:\n    42\t        pairs = [(mutant[1], mutant[2])] + (mutant[4] if len(mutant) > 4 else [])\n    43\t        for old, new in pairs:\n    44\t            if gate.count(old) != 1:\n    45\t                raise SystemExit(f'{mutant[0]}: the site occurs {gate.count(old)} times')\n    46\t            gate = gate.replace(old, new)\n    47\t    (folder / 'paid_gate.py').write_text(gate)\n    48\t    rehearsal = (HERE / 'paid_rehearsal.py').read_text().replace(\n    49\t        'HERE = Path(__file__).resolve().parent\\nsys.path.insert(0, str(HERE))',\n    50\t        f'HERE = Path({str(HERE)!r})\\nsys.path.insert(0, str(HERE))\\nsys.path.insert(0, {str(folder)!r})')\n    51\t    (folder / 'paid_rehearsal.py').write_text(rehearsal)\n    52\t\n    53\t\n    54\tdef run(scratch, n, mutant):\n    55\t    folder = scratch / f'm{n:02d}'\n    56\t    build(folder, mutant)\n    57\t    result = subprocess.run([sys.executable, str(folder / 'paid_rehearsal.py'), str(folder / 'work')], capture_output=True, text=True,\n    58\t                            env={'PYTHONDONTWRITEBYTECODE': '1', 'PATH': '/usr/bin:/bin', 'HOME': str(Path.home())})\n    59\t    out = result.stdout + result.stderr\n    60\t    if mutant is None:\n    61\t        return n, 'control', result.returncode == 0 and 'FAIL' not in out, out.strip().splitlines()[-1]\n    62\t    failed = [l for l in out.splitlines() if l.startswith('FAIL') and mutant[3] in l]\n    63\t    crash = 'Traceback' in out\n    64\t    detail = failed[0][:110] if failed else (out.strip().splitlines()[-1][:200] if crash else 'not caught')\n    65\t    return n, mutant[0], bool(failed) or crash, ('crash: ' if crash and not failed else '') + detail\n    66\t\n    67\t\n    68\tif __name__ == '__main__':\n    69\t    scratch = Path(sys.argv[1])\n    70\t    jobs = [(0, None)] + list(enumerate(MUTANTS, 1))\n    71\t    with concurrent.futures.ThreadPoolExecutor(8) as pool:\n    72\t        results = sorted(pool.map(lambda job: run(scratch, *job), jobs))\n    73\t    for n, name, ok, detail in results:\n    74\t        print(f'{\"CAUGHT\" if ok and n else (\"PASS\" if ok else \"MISSED\" if n else \"CONTROL FAILS\")}  {n:02d} {name}  {detail}')\n    75\t    print(f'{sum(1 for n, _, ok, _ in results if n and ok)} of {len(MUTANTS)} mutants caught; control {\"passes\" if results[0][2] else \"FAILS\"}')\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_9","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"python3 -B -c '\nimport contextlib, copy, hashlib,io,json,pathlib\nimport gate as g, paid_gate as pg\nplan=json.loads(pathlib.Path('\\\\''paid-plan.json'\\\\'').read_text())\nprint('\\\\''plan pinned and regenerated'\\\\'',hashlib.sha256(pathlib.Path('\\\\''paid-plan.json'\\\\'').read_bytes()).hexdigest()==pg.PINNED_PLAN_SHA256,pg.build_plan()==plan)\nclass Mem:\n    fs={}\n    def __init__(self,p): self.p=p\n    def __truediv__(self,k): return Mem(self.p+'\\\\''/'\\\\''+k)\n    def read_text(self): return self.fs[self.p]\n    def read_bytes(self): return self.read_text().encode()\n    def write_text(self,s): self.fs[self.p]=s\n    def exists(self): return self.p in self.fs\n    def mkdir(self,**kw): pass\nclass MemWriter(io.StringIO):\n    def __init__(self,path,mode):\n        self.path=path\n        if mode=='\\\\''x'\\\\'' and path.exists(): raise FileExistsError(path.p)\n        super().__init__()\n    def __exit__(self,*exc):\n        self.path.write_text(self.getvalue())\n        return super().__exit__(*exc)\npg.open=MemWriter\nactual_path=pg.Path\npg.Path=Mem\ndef write(out,name,x): (out/name).write_text(json.dumps(x))\ndef quiet(f,*a):\n    with contextlib.redirect_stdout(io.StringIO()): return f(*a)\ni=next(i for i in plan if i['\\\\''unit'\\\\'']=='\\\\''single-E'\\\\'')\nfa,ev=i['\\\\''family'\\\\''],i['\\\\''passages'\\\\'']\nu={'\\\\''figures'\\\\'':[],'\\\\''answers'\\\\'':[{'\\\\''view_id'\\\\'':'\\\\''v41'\\\\'','\\\\''shape'\\\\'':'\\\\''unresolved'\\\\'','\\\\''why'\\\\'':'\\\\''the shown evidence does not support a number'\\\\'','\\\\''reasons'\\\\'':'\\\\'''\\\\'','\\\\''cites'\\\\'':[],'\\\\''pushes'\\\\'':[],'\\\\''theme_pushes'\\\\'':[]}]}\nassert not pg.model.check_schema(pg.rv.strict(u,i['\\\\''schema'\\\\'']),i['\\\\''schema'\\\\''])\nrep=pg.cc.check(fa,ev,u)\nprint('\\\\''actual legitimate abstention'\\\\'',rep,pg.cc.publish_decision(fa,u,rep))\nr={'\\\\''decision'\\\\'':'\\\\''publish'\\\\'','\\\\''attempts'\\\\'':[{'\\\\''attempt'\\\\'':1,'\\\\''status'\\\\'':'\\\\''answered'\\\\'','\\\\''decision'\\\\'':'\\\\''refused'\\\\'','\\\\''errors'\\\\'':[['\\\\''C8'\\\\'','\\\\''scope'\\\\'']],'\\\\''data'\\\\'':{'\\\\''sentinel'\\\\'':'\\\\''ORIGINAL ATTEMPT REASON'\\\\''}},{'\\\\''attempt'\\\\'':2,'\\\\''status'\\\\'':'\\\\''answered'\\\\'','\\\\''decision'\\\\'':'\\\\''publish'\\\\'','\\\\''data'\\\\'':u}],'\\\\''data'\\\\'':u}\na,k=Mem('\\\\''abstention'\\\\''),Mem('\\\\''u-key'\\\\'')\nwrite(a,'\\\\''plan.json'\\\\'',plan); write(a,'\\\\''results.json'\\\\'',{'\\\\''finals'\\\\'':{'\\\\''single-E|single|1'\\\\'':r},'\\\\''reconciled'\\\\'':{}})\n(a/'\\\\''answers.jsonl'\\\\'').write_text('\\\\'''\\\\'')\nquiet(pg.packets,a,k)\nfrozen=json.loads((k/'\\\\''packet-key.json'\\\\'').read_text())\nbody=(a/'\\\\''packets.md'\\\\'').read_text()\nprint('\\\\''valid abstention grounds'\\\\'',frozen['\\\\''packets'\\\\'']['\\\\''P01'\\\\'']['\\\\''grounds'\\\\''],'\\\\''earlier attempt content shown'\\\\'', '\\\\''ORIGINAL ATTEMPT REASON'\\\\'' in body,'\\\\''earlier label shown'\\\\'','\\\\''Attempt 1: refused (C8)'\\\\'' in body)\nout,key_path=Mem('\\\\''run'\\\\''),Mem('\\\\''key'\\\\'')\nitems=[i for i in plan if i['\\\\''arm'\\\\''] in ('\\\\''joint'\\\\'','\\\\''single'\\\\'')]\nfinals={f'\\\\''{i[\\\"unit\\\"]}|{i[\\\"arm\\\"]}|{d}'\\\\'':{'\\\\''decision'\\\\'':'\\\\''publish'\\\\''} for i in plan for d in (1,2,3)}\nwrite(out,'\\\\''plan.json'\\\\'',plan); write(out,'\\\\''results.json'\\\\'',{'\\\\''finals'\\\\'':finals,'\\\\''reconciled'\\\\'':{}})\n(out/'\\\\''answers.jsonl'\\\\'').write_text('\\\\'''\\\\''); (out/'\\\\''packets.md'\\\\'').write_text('\\\\''frozen content'\\\\'')\nconfigured={'\\\\''packets_sha256'\\\\'':hashlib.sha256((out/'\\\\''packets.md'\\\\'').read_bytes()).hexdigest(),'\\\\''run_digest'\\\\'':pg.run_digest(out),'\\\\''packets'\\\\'':{}}\nreadings={}\nfor it in items:\n  for arm in (('\\\\''joint'\\\\'','\\\\''separate'\\\\'') if it['\\\\''arm'\\\\'']=='\\\\''joint'\\\\'' else ('\\\\''single'\\\\'',)):\n    for d in (1,2,3):\n      pid=f'\\\\''P{len(readings)+1:02d}'\\\\''\n      configured['\\\\''packets'\\\\''][pid]=dict(unit=it['\\\\''unit'\\\\''],arm=arm,draw=str(d),decision='\\\\''publish'\\\\'',members=it['\\\\''members'\\\\''],grounds=['\\\\''F1'\\\\''])\n      ai={name:dict(answer='\\\\''yes'\\\\'' if (name=='\\\\''usable'\\\\'' and arm\"'!='\"'\\\\''separate'\\\\'') or (name=='\\\\''deciding_gap'\\\\'' and it['\\\\''unit'\\\\'']=='\\\\''single-E'\\\\'' and d==3) else '\\\\''no'\\\\'',ground='\\\\''F1 basis'\\\\'') for name in pg.QUESTIONS}\n      readings[pid]={v:dict(A=ai,B=ai) for v in it['\\\\''members'\\\\'']}\nend=next(k for k,v in configured['\\\\''packets'\\\\''].items() if v['\\\\''unit'\\\\'']=='\\\\''single-E'\\\\'' and v['\\\\''draw'\\\\'']=='\\\\''3'\\\\'')\nrd=Mem('\\\\''rd'\\\\'')\nrd.write_text(json.dumps({'\\\\''packets_sha256'\\\\'':configured['\\\\''packets_sha256'\\\\''],'\\\\''packets'\\\\'':readings}))\nwrite(key_path,'\\\\''packet-key.json'\\\\'',configured)\nprint('\\\\''before change'\\\\'',quiet(pg.verdict,out,'\\\\''rd'\\\\'',key_path))\nconfigured['\\\\''packets'\\\\''][end]['\\\\''decision'\\\\'']='\\\\''held'\\\\''\nwrite(key_path,'\\\\''packet-key.json'\\\\'',configured)\nprint('\\\\''after editing one key decision with no digest update'\\\\'',quiet(pg.verdict,out,'\\\\''rd'\\\\'',key_path))\nbad=Mem('\\\\''truncated'\\\\'')\none=dict(unit='\\\\''single-E'\\\\'',arm='\\\\''single'\\\\'',draw=1,attempt=1,status='\\\\''started'\\\\'')\n(bad/'\\\\''answers.jsonl'\\\\'').write_text(json.dumps(one)+'\\\\''\\\\n{\\\"unit\\\": \\\"single-E\\\", \\\"arm\\\":'\\\\'')\ntry:\n    pg.summarise(bad,plan,{})\nexcept Exception as e:\n    print('\\\\''aborted journal tail'\\\\'',type(e).__name__,'\\\\''recoverable results artifact'\\\\'', (bad/'\\\\''results.json'\\\\'').exists())\npg.Path=actual_path\n'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
