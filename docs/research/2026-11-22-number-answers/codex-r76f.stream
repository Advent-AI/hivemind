_FILE).read_bytes().replace(b'Morningstar', b'Morningstan')),\ntests/test_release.py:404:    (tmp_path / 'outside.json').write_bytes((linked / release.DATA_FILE).read_bytes())\ntests/test_release.py:410:    raw = (repeated / release.DATA_FILE).read_bytes()\ntests/test_release.py:459:    assert written['counts'] == FIXTURE_COUNTS and written['withheld_unresolved'] == FIXTURE_UNRESOLVED and written['data_bytes'] == FIXTURE_DATA_BYTES\ntests/test_release.py:483:    items_hash = hashlib.sha256(stores[1].read_bytes()).hexdigest()\ntests/test_release.py:487:    assert refused.returncode == 1 and hashlib.sha256(same.read_bytes()).hexdigest() == items_hash\ntests/test_release.py:494:    assert linked.returncode == 2 and hashlib.sha256(stores[1].read_bytes()).hexdigest() == items_hash\ntests/test_release.py:500:        assert checked.returncode == 2 and hashlib.sha256(variant.read_bytes()).hexdigest() == items_hash\ntests/test_release.py:542:STAGED_CHECK = (\"counts, data, size = release.check_package(staged, views_db, items_db, expected_as_of=bound)\", \"counts, size = release.check_export(data), 0\")\ntests/test_release.py:644:    assert printed['counts'] == FIXTURE_COUNTS and printed['withheld_unresolved'] == FIXTURE_UNRESOLVED and printed['data_bytes'] == FIXTURE_DATA_BYTES\nsrc/hivemind/release.py:24:FORMAT = 'hivemind-release/1'\nsrc/hivemind/release.py:29:PACKAGE_FILES = frozenset({DATA_FILE, MANIFEST_FILE})\nsrc/hivemind/release.py:394:    \"\"\"The package's data, read with the repeated-member check. `check_package` returns the data it checked, which is the copy to\nsrc/hivemind/release.py:396:    return _parse((Path(package) / DATA_FILE).read_bytes(), DATA_FILE)\nsrc/hivemind/release.py:442:def check_package(path, views_db=None, items_db=None, expected_as_of=None):\nsrc/hivemind/release.py:456:        if sorted(names) != sorted(PACKAGE_FILES):\nsrc/hivemind/release.py:457:            raise ReleaseRefused(f'{path}: holds {sorted(names)}, not exactly {sorted(PACKAGE_