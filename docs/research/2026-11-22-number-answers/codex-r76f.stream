{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"ls -l poc/data/release-check-2026-11-23g/old-1/package && nl -ba docs/research/2026-11-22-number-answers/release_check.py | sed -n '145,210p'\"","aggregated_output":"total 11320\n-rw-r--r--@ 1 lchingen  staff      169 Nov 23 11:32 manifest.json\n-rw-r--r--@ 1 lchingen  staff  5788634 Nov 23 11:32 release-data.json\n   145\t\n   146\tdef main(out):\n   147\t    out = Path(out).absolute()\n   148\t    out.mkdir()                                            # a new folder; refuses an existing one\n   149\t    results = {'stores': {}}\n   150\t    packages = {}\n   151\t    for name, (ledger, items) in STORES.items():\n   152\t        (out / name).mkdir()\n   153\t        report, data = build(ledger, items, out / name / 'package')\n   154\t        packages[name] = data\n   155\t        library_bytes, library_seconds = library_baseline(ledger, items)\n   156\t        seconds = report['export_seconds'] + report['check_seconds']\n   157\t        results['stores'][name] = {\n   158\t            'as_of': report['as_of'], 'counts': report['counts'], 'withheld_unresolved': len(report['withheld_unresolved']),\n   159\t            'unresolved': report['withheld_unresolved'], 'data_bytes': report['data_bytes'], 'library_bytes': library_bytes,\n   160\t            'seconds': round(seconds, 2), 'library_seconds': round(library_seconds, 2),\n   161\t            'bytes_within_budget': report['data_bytes'] <= library_bytes,\n   162\t            'seconds_within_budget': seconds <= 3 * library_seconds and seconds <= 120,\n   163\t            'diagnostics': diagnostics(ledger, data, out / name / 'package')}\n   164\t        print(name, json.dumps({k: v for k, v in results['stores'][name].items() if k not in ('unresolved', 'diagnostics')}), 'hits', len(results['stores'][name]['diagnostics']['hits']))\n   165\t\n   166\t    ledger, items = STORES['old-1']\n   167\t    data, package = packages['old-1'], out / 'old-1' / 'package'\n   168\t    conn = service.open_ledger(str(ledger))\n   169\t    stored = {row['evidence_id']: row for row in conn.execute(\"select * from evidence where evidence_id in ('e2295','e1865','e3597')\")}\n   170\t    implied = conn.execute('select implied_outcome from judgements where judgement_id=1580').fetchone()[0]\n   171\t    in_force_v8 = [e['evidence_id'] for e in service.evidence(conn, 'v8', data['as_of'])]\n   172\t    conn.close()\n   173\t    required_text = {   # each example's full stored text, written down before the run (old-1, 2026-11-23); compared exactly\n   174\t        'e2295': ('Morningstar cites NVIDIA Data Center revenue of $3 billion in FY2020 and $194 billion in FY2026, and estimates $361 billion in FY2027, up 86% year over year.',\n   175\t                  'Nvidia’s DC business has achieved exponential growth already, rising from $3 billion in fiscal 2020 to $194 billion in fiscal 2026, and we estimate it will be $361 billion in fiscal 2027, representing 86% annual growth.'),\n   176\t        'e1865': ('The author identifies firm SpaceX procurement commitments and NVIDIA Data Center growth above 60% into FY2028 as bullish confirmation conditions.',\n   177\t                  'Bullish confirmation would require firm procurement commitments for the SpaceX buildout and continued NVIDIA Data Center growth above 60% into fiscal 2028.'),\n   178\t        'e3597': ('The author says analysts estimate NVIDIA revenue of about $390 billion in calendar 2027 and over $550 billion in calendar 2028, with annual sales growth of roughly 24% to 25%.',\n   179\t                  'Analysts see revenue reaching about $390 billion in 2027 and more than $550 billion in 2028, with annual sales growth of roughly 24% to 25%.')}\n   180\t    kept = {}\n   181\t    for evidence_id in ('e2295', 'e1865', 'e3597'):              # the fixed examples: a missing one is a failure, not a smaller list\n   182\t        if evidence_id not in stored:\n   183\t            kept[evidence_id] = {'questions': [], 'equal_to_store': False, 'present': False}\n   184\t            continue\n   185\t        holders = [(q['id'], e) for q in data['questions'] for e in q['evidence'] if e['id'] == evidence_id]\n   186\t        kept[evidence_id] = {'questions': [h[0] for h in holders],\n   187\t                             'equal_to_store': all(e['one_line'] == stored[evidence_id]['one_line'] and e['quote'] == stored[evidence_id]['quote'] for _, e in holders) and bool(holders),\n   188\t                             'present': bool(holders),\n   189\t                             'holds_its_wording': bool(holders) and all((e['one_line'], e['quote']) == required_text[evidence_id] for _, e in holders)}\n   190\t    forged = out / 'old-1' / 'forged-summary'\n   191\t    shutil.copytree(package, forged)\n   192\t    changed = json.loads(json.dumps(data))\n   193\t    next(e for e in by_id(changed)['v8']['evidence'] if e['id'] == 'e2295')['one_line'] = implied\n   194\t    refresh(forged, changed)\n   195\t    prose = out / 'old-1' / 'forged-manifest'\n   196\t    shutil.copytree(package, prose)\n   197\t    refresh(prose, manifest_extra={'note': implied})\n   198\t    v8 = by_id(data)['v8']\n   199\t    results['decisive'] = {'kept': kept, 'implied_outcome_j1580': implied[:120],\n   200\t                           'substituted_into_e2295_refused': refused(ledger, items, forged),\n   201\t                           'added_to_manifest_refused': refused(ledger, items, prose),\n   202\t                           'unchanged_package_passes': check(ledger, items, package)['fields_compared']}\n   203\t    results['decisive']['forged_value_is_j1580'] = implied.startswith(J1580_PREFIX)\n   204\t    results['old-1/v8'] = {'class': v8['class'], 'forecast': v8['forecast'], 'evidence': len(v8['evidence']),\n   205\t                           'same_ids_as_service_evidence': [e['id'] for e in v8['evidence']] == in_force_v8}\n   206\t\n   207\t    leaks = {}\n   208\t    for name, view_id, day, judgement_id in (('old-3', 'v36', '2026-08-25', 799), ('old-1', 'v10', '2026-08-28', 865)):\n   209\t        ledger, items = STORES[name]\n   210\t        report, dated = build(ledger, items, out / name / f'package-{day}', day)\n","exit_code":0,"status":"completed"}}
