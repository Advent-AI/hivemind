{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"cd docs/research/2026-11-22-number-answers && nl -ba paid_gate.py | sed -n '1,85p;420,650p;735,885p'\"","aggregated_output":"     1\t\"\"\"The paid gate of judging-v13 (D725's registered test; D729, D730). Harness-only; nothing here is product code.\n     2\t\n     3\t  python3 paid_gate.py plan <out.json>                        # $0: build every request from the stored runs and check them\n     4\t  python3 paid_gate.py send <new out folder> <ceiling>        # paid: only at the ceiling Alex names (APPROVED_CEILING)\n     5\t  python3 paid_gate.py packets <out folder> <key folder>      # $0: blind reading packets, the arm hidden; the key kept outside the repo\n     6\t  python3 paid_gate.py verdict <out folder> <readings.json> <key folder>   # $0: the registered pass and stop lines\n     7\t\n     8\tThe test (D725, RESULT.md): the 09-20 total and Data Center pair in each of three stored draws, judged jointly (one v13 family call)\n     9\tand separately (each member alone, the same union of evidence, the same v13 format), three samples each; plus three samples each of\n    10\tthe O, S and E singletons. 9 + 18 + 9 = 36 first attempts. A calculation the checks refuse is retried once with its errors; a second\n    11\trefusal makes the unit unresolved. The separate arm's two answers are then reconciled by the same checks over the pair's family.\n    12\t\"\"\"\n    13\timport hashlib\n    14\timport json\n    15\timport random\n    16\timport re\n    17\timport secrets\n    18\timport sqlite3\n    19\timport sys\n    20\timport threading\n    21\tfrom pathlib import Path\n    22\t\n    23\tHERE = Path(__file__).resolve().parent\n    24\tREPO = HERE.parents[2]\n    25\tsys.path.insert(0, str(HERE))\n    26\tsys.path.insert(0, str(REPO / 'src'))\n    27\timport calc_check as cc                                                 # noqa: E402\n    28\timport calc_small as cs                                                 # noqa: E402\n    29\timport render_v13 as rv                                                 # noqa: E402\n    30\tfrom hivemind import config, model                                      # noqa: E402\n    31\t\n    32\tRUN = REPO / 'poc/data/comparison-2026-11-17/run'\n    33\tCONFIG = REPO / 'poc/config/poc-v118.json'                              # its re-judging model setting: gpt-6-luna, medium, 16000 output tokens\n    34\tSYSTEM = (HERE / 'judging-v13-draft.txt').read_text()\n    35\tSYSTEM_S = (HERE / 'judging-v13s.txt').read_text()                      # the small format (D737): one sentence changed\n    36\tCHECKERS = {None: cc, 'v13': cc, 'v13s': cs}\n    37\tAPPROVED_CEILING = 0.5                                                  # Alex, 2026-11-22 (D732): \"0.5 美元 (推荐)\"\n    38\tPINNED_PLAN_SHA256 = (HERE / 'paid-plan.sha256').read_text().strip() if (HERE / 'paid-plan.sha256').exists() else None\n    39\tAUTH = Path.home() / '.hivemind-keys/v13-paid-gate/authorization.json'\n    40\t# D753: Alex's one-time exception, a v13s re-send. Its own reviewed plan pin and its own one-time authorization; the v13 ones stay.\n    41\tPINNED_PLAN_V13S = (HERE / 'paid-plan-v13s.sha256').read_text().strip() if (HERE / 'paid-plan-v13s.sha256').exists() else None\n    42\tAUTH_V13S = Path.home() / '.hivemind-keys/v13s-paid-gate/authorization.json'\n    43\tDRAWS = (1, 2, 3)\n    44\tRETRY_MARK = '\\n\\nThe code refused the previous answer because: '\n    45\tPAIRS = [('old-1', ('v4', 9014), ('v8', 9022)), ('old-2', ('v14', 8729), ('v9', 8737)), ('old-3', ('v3', 9183), ('v35', 9177))]\n    46\tSINGLETONS = [('O', 'old-2', 'v29', 8734, ('NVIDIA', 'equity investment commitments', 'company', 'end of FY2027')),\n    47\t              ('S', 'old-2', 'v6', 8595, ('four largest AI hyperscalers', 'data-center capex', 'combined', 'CY2027')),\n    48\t              ('E', 'old-3', 'v41', 9166, ('NVIDIA', 'revenue', 'Vera CPU', 'FY2028'))]\n    49\t\n    50\t\n    51\tdef W(population, measure, scope, period):\n    52\t    return {'population': population, 'measure': measure, 'scope': scope, 'period': period}\n    53\t\n    54\t\n    55\tdef bands(draw, view_id):\n    56\t    conn = sqlite3.connect(f'file:{RUN / draw / \"prod/views.sqlite\"}?mode=ro', uri=True)\n    57\t    rows = conn.execute('select lo, hi from rungs where view_id=? order by position', (view_id,)).fetchall()\n    58\t    return [[lo / 1e9 if lo is not None else None, hi / 1e9 if hi is not None else None] for lo, hi in rows]\n    59\t\n    60\t\n    61\tdef passages(draw, evidence_ids):\n    62\t    \"\"\"What each request showed of a passage: the quote cut at 400 characters (judging._lines_english).\"\"\"\n    63\t    conn = sqlite3.connect(f'file:{RUN / draw / \"prod/views.sqlite\"}?mode=ro', uri=True)\n    64\t    rows = conn.execute(f'select evidence_id, quote, speaker from evidence where evidence_id in ({\",\".join(\"?\" * len(evidence_ids))})',\n    65\t                        evidence_ids).fetchall()\n    66\t    return {e: {'text': (q or '')[:400], 'speaker': s} for e, q, s in rows}\n    67\t\n    68\t\n    69\tdef pair_family(draw, total, dc):\n    70\t    return {'members': {total[0]: {'what': W('NVIDIA', 'revenue', 'company', 'FY2027'), 'bands': bands(draw, total[0])},\n    71\t                        dc[0]: {'what': W('NVIDIA', 'revenue', 'Data Center', 'FY2027'), 'bands': bands(draw, dc[0])}},\n    72\t            'relations': [{'type': 'part_of', 'part': dc[0], 'whole': total[0]}],\n    73\t            'shared': [W('NVIDIA', 'revenue', 'company', 'FY2027 Q3'), W('NVIDIA', 'revenue', 'company', 'FY2027 Q4')],\n    74\t            'compare_periods': ['FY2027 Q3', 'FY2027 Q4', 'FY2027']}\n    75\t\n    76\t\n    77\tdef only(family, view_id):\n    78\t    out = {'members': {view_id: family['members'][view_id]}, 'relations': [], 'shared': family['shared'], 'compare_periods': []}\n    79\t    if 'part_scopes' in family:                                         # [53] the separate arm keeps S8's part-of scopes (D738)\n    80\t        out['part_scopes'] = family['part_scopes']\n    81\t    return out\n    82\t\n    83\t\n    84\tdef small_family(family, part_scopes=(), notes=None):\n    85\t    \"\"\"[D737] A family for the small format: each member's unit (USD bn: the bands are in billions), the part-of scopes S8 reads, and\n   420\t    return summary\n   421\t\n   422\t\n   423\tdef budget_module():\n   424\t    import importlib.util\n   425\t    spec = importlib.util.spec_from_file_location('budget_replay_v13', REPO / 'clean-arch/e2e-comparison-2026-11-13/budget_replay.py')\n   426\t    module = importlib.util.module_from_spec(spec)\n   427\t    spec.loader.exec_module(module)\n   428\t    return module\n   429\t\n   430\t\n   431\tdef send(out, approved, plan_path):\n   432\t    if APPROVED_CEILING is None or approved != APPROVED_CEILING:\n   433\t        raise SystemExit(f'the approved ceiling is {APPROVED_CEILING} (Alex names it); refused')\n   434\t    if out.exists():\n   435\t        raise SystemExit(f'{out} exists: the gate starts from an empty folder')\n   436\t    text = Path(plan_path).read_text()\n   437\t    items = json.loads(text)\n   438\t    formats = {i.get('format') for i in items}\n   439\t    if formats == {'v13s'}:                                                  # D753: the v13s re-send has its own pin and authorization\n   440\t        pin, auth = PINNED_PLAN_V13S, AUTH_V13S\n   441\t    elif 'v13s' in formats:\n   442\t        raise SystemExit('the plan mixes formats; refused')\n   443\t    else:\n   444\t        pin, auth = PINNED_PLAN_SHA256, AUTH\n   445\t    if pin is None or hashlib.sha256(text.encode()).hexdigest() != pin:          # [47.2] only the reviewed plan\n   446\t        raise SystemExit('the plan is not the reviewed one (sha256 differs); refused')\n   447\t    auth.parent.mkdir(parents=True, exist_ok=True)\n   448\t    try:                                                                     # [47.2] one authorization, one ledger, one launch\n   449\t        with open(auth, 'x') as handle:\n   450\t            json.dump({'plan_sha256': pin, 'ceiling': approved, 'out': str(out)}, handle)\n   451\t    except FileExistsError:\n   452\t        raise SystemExit(f'{auth} exists: this authorization was already used; refused')\n   453\t    if len({(i['unit'], i['arm']) for i in items}) != len(items):\n   454\t        raise SystemExit('duplicate (unit, arm) in the plan; refused')\n   455\t    out.mkdir(parents=True)\n   456\t    (out / 'plan.json').write_text(json.dumps(items))\n   457\t    budget = budget_module()\n   458\t    budget.SharedLedger.init(str(out / 'ledger.json'), approved)\n   459\t    ledger = budget.SharedLedger(str(out / 'ledger.json'))\n   460\t    lock_handle = open(out / 'gate.launcher.lock', 'a+')\n   461\t    if not ledger.claim_launcher('v13-gate', lock_handle):\n   462\t        raise SystemExit('another launch is running')\n   463\t    remove_gate = budget.install_stop_gate(ledger)\n   464\t    try:\n   465\t        summary = Gate(out, budget.BudgetTransport(ledger), ledger).run(items)\n   466\t    finally:\n   467\t        remove_gate()\n   468\t        ledger.remove_launcher('v13-gate')\n   469\t    print(json.dumps({k: v.get('decision') for k, v in summary['finals'].items()}, indent=1))\n   470\t\n   471\t\n   472\t# ---------- blind reading ----------\n   473\tQUESTIONS = {'usable': 'the outcome is usable and supported by the shown passages it rests on',\n   474\t             'contradiction': 'with the other card of its packet, it states a hard numerical contradiction',\n   475\t             'internal_reference': \"the system's own forecast is presented as the market's expectation\",\n   476\t             'deciding_gap': 'an unresolved overlap, a change of scope or an unsized adjustment decides its band'}\n   477\t\n   478\t\n   479\tFIGURE_TOKEN = re.compile(r'\\b([A-Za-z0-9]*F\\d+)\\b')\n   480\tPASSAGE_TOKEN = re.compile(r'\\b(e\\d+)\\b')\n   481\tPASSAGE_RANGE = re.compile(r'\\be(\\d+)\\s*[-–]\\s*e?(\\d+)\\b')\n   482\t\n   483\t\n   484\tdef renamed_text(text, rename):\n   485\t    \"\"\"[D753, council 70] Figure ids inside prose follow the renumbering, so a reference in the reasons still points to the figure the\n   486\t    writer meant; an id the card does not show is left as written.\"\"\"\n   487\t    return FIGURE_TOKEN.sub(lambda m: rename.get(m.group(1), m.group(1)), text) if isinstance(text, str) else text\n   488\t\n   489\t\n   490\tdef named_in_text(text, figure_ids, shown_passages):\n   491\t    \"\"\"[D753, council 70] The figure ids and passage ids a prose field names, a written range e5399-e5404 included in full.\"\"\"\n   492\t    if not isinstance(text, str):\n   493\t        return set(), set()\n   494\t    figures = {t for t in FIGURE_TOKEN.findall(text) if t in figure_ids}\n   495\t    passages = {t for t in PASSAGE_TOKEN.findall(text) if t in shown_passages}\n   496\t    for lo, hi in PASSAGE_RANGE.findall(text):\n   497\t        lo, hi = int(lo), int(hi)\n   498\t        if 0 < hi - lo <= 50:\n   499\t            passages |= {f'e{n}' for n in range(lo, hi + 1) if f'e{n}' in shown_passages}\n   500\t    return figures, passages\n   501\t\n   502\t\n   503\tdef normalise(calc, prefix=''):\n   504\t    \"\"\"Figure ids renumbered F1.. (after `prefix`) and member prefixes removed, so the arm cannot be read from the ids. Ids named in\n   505\t    prose (reasons, why, basis_text) are renumbered with them.\"\"\"\n   506\t    rename = {f['id']: f'{prefix}F{n}' for n, f in enumerate(calc['figures'], 1)}\n   507\t    out = []\n   508\t    for f in calc['figures']:\n   509\t        g = dict(f, id=rename[f['id']])\n   510\t        if 'basis_text' in g:\n   511\t            g['basis_text'] = renamed_text(g['basis_text'], rename)\n   512\t        for key in ('inputs', 'rests_on', 'converts'):\n   513\t            if key in g:\n   514\t                g[key] = [rename.get(x, x) for x in g[key]]\n   515\t        for key in ('disputed', 'bridge'):\n   516\t            if key in g:\n   517\t                g[key] = rename.get(g[key], g[key])\n   518\t        if 'adjusts' in g:\n   519\t            g['adjusts'] = dict(g['adjusts'], figure=rename.get(g['adjusts']['figure'], g['adjusts']['figure']))\n   520\t        out.append(g)\n   521\t    answers = []\n   522\t    for a in calc['answers']:\n   523\t        a2 = dict(a)\n   524\t        for key in ('reasons', 'why'):\n   525\t            if key in a2:\n   526\t                a2[key] = renamed_text(a2[key], rename)\n   527\t        if isinstance((a2.get('reference') or {}).get('unavailable'), str):\n   528\t            a2['reference'] = {'unavailable': renamed_text(a2['reference']['unavailable'], rename)}\n   529\t        if 'outcome' in a2:\n   530\t            a2['outcome'] = rename.get(a2['outcome'], a2['outcome'])\n   531\t        if (a2.get('reference') or {}).get('figure'):\n   532\t            a2['reference'] = {'figure': rename.get(a2['reference']['figure'], a2['reference']['figure'])}\n   533\t        answers.append(a2)\n   534\t    return {'figures': out, 'answers': answers}, rename\n   535\t\n   536\t\n   537\tdef run_digest(out):\n   538\t    h = hashlib.sha256()\n   539\t    for name in ('answers.jsonl', 'retries.jsonl', 'results.json', 'plan.json'):\n   540\t        path = out / name\n   541\t        h.update(name.encode() + b'\\0' + (path.read_bytes() if path.exists() else b''))\n   542\t    return h.hexdigest()\n   543\t\n   544\t\n   545\tdef card_view(calc, view_id, recorded, prefix='', ck=cc, shown=()):\n   546\t    \"\"\"[47b.3] One card as its own derivation: the figures its outcome and reference rest on, renumbered F1.. (after `prefix`) for this\n   547\t    card alone, and the recorded assumptions about its outcome or its own figures mapped to the same numbers. [D753, council 70] It also\n   548\t    shows every figure and passage the card's prose names (reasons, why, the reference's unavailability, and the basis of a shown\n   549\t    figure), with what those figures rest on, so an unresolved card keeps the passages it weighed and no prose reference dangles.\"\"\"\n   550\t    figs = {f['id']: f for f in calc['figures']}\n   551\t    refs = lambda f: list(f.get('inputs', [])) + [r for r in f.get('rests_on', []) if r in figs] + \\\n   552\t        ([f['adjusts']['figure']] if f.get('adjusts') else []) + ([f['bridge']] if f.get('bridge') else [])\n   553\t    ans = next(a for a in calc['answers'] if a['view_id'] == view_id)\n   554\t    shown = set(shown)\n   555\t    own, text_passages = set(), set()\n   556\t    starts = {ans.get('outcome'), (ans.get('reference') or {}).get('figure')} - {None}\n   557\t    for key in ('reasons', 'why'):\n   558\t        found, passages = named_in_text(ans.get(key), figs, shown)\n   559\t        starts |= found\n   560\t        text_passages |= passages\n   561\t    found, passages = named_in_text((ans.get('reference') or {}).get('unavailable'), figs, shown)\n   562\t    starts |= found\n   563\t    text_passages |= passages\n   564\t    while starts:                                         # the closure over figures named in the prose of figures already shown\n   565\t        for start in [s for s in starts if s in figs]:\n   566\t            own |= ck._upstream_of(start, figs, refs) | {start}\n   567\t        starts = set()\n   568\t        for fid in own:\n   569\t            found, passages = named_in_text(figs[fid].get('basis_text'), figs, shown)\n   570\t            starts |= found - own\n   571\t            text_passages |= passages\n   572\t    sub = {'figures': [f for f in calc['figures'] if f['id'] in own], 'answers': [ans]}\n   573\t    norm, rename = normalise(sub, prefix)\n   574\t    mapped = []\n   575\t    for r in recorded:                                    # an assumption about this card's outcome, or about one of its own figures\n   576\t        named = [r[k] for k in ('figure', 'bridge') if isinstance(r.get(k), str)]\n   577\t        if (r.get('outcome') == view_id or any(n in rename for n in named)) and all(n in rename for n in named):\n   578\t            mapped.append({k: rename[v] if k in ('figure', 'bridge') else v for k, v in r.items()})\n   579\t    return norm, mapped, sorted({f['evidence'] for f in sub['figures'] if f.get('evidence')} | set(ans.get('cites', []))\n   580\t                                | {x for f in sub['figures'] for x in f.get('rests_on', []) if str(x).startswith('e')} | text_passages)\n   581\t\n   582\t\n   583\tNO_ANSWER = {'not sent': 'No request was sent for this card.', 'interrupted': 'The request was started; no answer was recorded.',\n   584\t             'transport': 'No answer arrived.', 'retry not sent': 'The answer was refused and its retry was not sent.'}\n   585\tFORMAT_INVALID = 'The answer did not match the required format.'\n   586\t\n   587\t\n   588\tdef packet_units(results, items):\n   589\t    \"\"\"Every packet the run gives, as (unit, arm, draw) -> (decision, per-card source): the joint and singleton answers from the finals,\n   590\t    the separate arm's reconciled pairs with each card's own separate answer.\"\"\"\n   591\t    units = {}\n   592\t    for key, entry in results['finals'].items():\n   593\t        unit, arm, draw = key.split('|')\n   594\t        if not arm.startswith('separate-'):\n   595\t            first = first_attempt(entry)                    # [47e.1] the first attempt is scored on both arms\n   596\t            units[(unit, arm, draw)] = (first.get('decision'), {v: first for v in items[(unit, arm)]['members']})\n   597\t    for key, entry in results['reconciled'].items():\n   598\t        unit, draw = key.split('|')\n   599\t        per_card = {a.split('-', 1)[1]: first_attempt(results['finals'].get(f'{unit}|{a}|{draw}', {})) for (u, a) in items\n   600\t                    if u == unit and a.startswith('separate-')}\n   601\t        units[(unit, 'separate', draw)] = (entry.get('decision'), per_card)\n   602\t    return units\n   603\t\n   604\t\n   605\tdef card_lines(base, fam, v, token, data, final_label, prefix=''):\n   606\t    \"\"\"One card's answer as a reader sees it: the passages it names, its own figures, its recomputed outcome and assumptions, the card.\n   607\t    Returns (lines, ids a ground may name).\"\"\"\n   608\t    if not data:\n   609\t        return [f'  {final_label}'], set()\n   610\t    fmt = base.get('format')\n   611\t    calc = decode(data, fmt, fam)\n   612\t    try:\n   613\t        checked = checker(fmt).check(fam, base['passages'], calc)\n   614\t    except Exception as error:\n   615\t        checked = {'errors': [('checker', str(error))], 'recorded': [], 'published': {}}\n   616\t    try:\n   617\t        norm, recorded, named = card_view(calc, v, checked.get('recorded', []), prefix, checker(fmt), base.get('shown', {}))\n   618\t    except StopIteration:\n   619\t        return ['  The answer has no card for this question.'], set()\n   620\t    lines = ['  Passages, as the request showed them:\\n' + '\\n'.join('  ' + base['shown'].get(e, f'- {e} (not shown)') for e in named),\n   621\t             '  Figures (declared):\\n' + '\\n'.join(f'  - {json.dumps(f, ensure_ascii=False)}' for f in norm['figures']),\n   622\t             '  Recomputed outcome: ' + json.dumps((checked.get('published') or {}).get(v)),\n   623\t             '  Recorded assumptions: ' + json.dumps(recorded),\n   624\t             f'  Card {token}: ' + json.dumps(norm['answers'][0], ensure_ascii=False)]\n   625\t    return lines, set(named) | {f['id'] for f in norm['figures']}\n   626\t\n   627\t\n   628\tdef packet_body(items, unit, arm, decision, per_card):\n   629\t    \"\"\"[47d.3, 47e.1] One scoring packet: each card's scored (first) answer only. No attempt history, no code decision and no check code,\n   630\t    which would tell separate calls from one joint call; the verdict applies the code's decision itself. Returns (lines, grounds, members).\"\"\"\n   631\t    base = items[(unit, 'joint' if unit.startswith('pair') else 'single')]\n   632\t    grounds, lines = set(), []\n   633\t    for number, v in enumerate(base['members'], 1):\n   634\t        q = base['questions'][v]\n   635\t        token = f'K{number}'\n   636\t        grounds.add(token)\n   637\t        lines.append(f'### Card {token}: {q[\"question\"]}\\n  Ladder: ' + ' / '.join(f'rung {i + 1}: {c}' for i, c in enumerate(q['ladder'])))\n   638\t        source = per_card.get(v, {})                         # the scored (first) attempt of this card\n   639\t        label = NO_ANSWER.get(source.get('decision'), FORMAT_INVALID if source.get('status') == 'format invalid' else NO_ANSWER['not sent'])\n   640\t        fam = base['family'] if arm != 'separate' else only(base['family'], v)\n   641\t        body, named = card_lines(base, fam, v, token, source.get('data'), label)\n   642\t        lines += body\n   643\t        grounds |= named\n   644\t    lines.append('For each card answer yes or no, each with a ground that names a card (K...), passage (e...) or figure (F...) of this packet: '\n   645\t                 + '; '.join(f'{k}: {t}' for k, t in QUESTIONS.items()) + '\\n')\n   646\t    return lines, sorted(grounds), base['members']\n   647\t\n   648\t\n   649\tdef key_commitment(key):\n   650\t    return hashlib.sha256(json.dumps(key, sort_keys=True).encode()).hexdigest()\n   735\t        handle.write(attempts_text)\n   736\t    print(f'{len(key[\"order\"])} packets, {len(key[\"attempts\"])} diagnostic attempts; key in {key_dir}')\n   737\t\n   738\t\n   739\tdef _grounded(ground, grounds):\n   740\t    \"\"\"[47b.4] A ground is non-empty text that names at least one card, passage or figure of the packet.\"\"\"\n   741\t    return isinstance(ground, str) and ground.strip() != '' and any(re.search(rf'\\b{re.escape(g)}\\b', ground) for g in grounds)\n   742\t\n   743\t\n   744\tdef final_readings(pid, cards, members, grounds=()):\n   745\t    \"\"\"[47.4] Two independent readings per card (A, B), each question answered yes/no with its ground; a third decides each\n   746\t    disagreement. Returns ({card: {question: answer}}, problems).\"\"\"\n   747\t    problems, final = [], {}\n   748\t    if sorted(cards) != sorted(members):\n   749\t        return None, [f'{pid}: cards {sorted(cards)} are not the unit\\'s {sorted(members)}']\n   750\t    for v, r in cards.items():\n   751\t        final[v] = {}\n   752\t        for q in QUESTIONS:\n   753\t            a, b = (r.get(x, {}).get(q, {}) for x in ('A', 'B'))\n   754\t            for name, x in (('A', a), ('B', b)):\n   755\t                if x.get('answer') not in ('yes', 'no') or not _grounded(x.get('ground'), grounds):\n   756\t                    problems.append(f'{pid} {v} {q}: reader {name} gave no yes/no with a ground from this packet')\n   757\t            if a.get('answer') == b.get('answer'):\n   758\t                final[v][q] = a.get('answer')\n   759\t            else:\n   760\t                t = r.get('third', {}).get(q, {})\n   761\t                if t.get('answer') not in ('yes', 'no') or not _grounded(t.get('ground'), grounds):\n   762\t                    problems.append(f'{pid} {v} {q}: the readers disagree and no third reading decides')\n   763\t                final[v][q] = t.get('answer')\n   764\t    return final, problems\n   765\t\n   766\t\n   767\tdef verdict(out, readings_path, key_dir):\n   768\t    \"\"\"[47e.4] Seal the readings into the run (readings.json, created once), compute D725's lines once and write verdict.json bound to\n   769\t    the readings, the key and the packets. A second verdict on the run is refused; `replay` recomputes and compares.\"\"\"\n   770\t    if (out / 'verdict.json').exists() or (out / 'readings.json').exists():\n   771\t        raise SystemExit(f'{out} already has sealed readings or a verdict; refused (use replay)')\n   772\t    data = Path(readings_path).read_bytes()\n   773\t    with open(out / 'readings.json', 'xb') as handle:\n   774\t        handle.write(data)\n   775\t    summary = score(out, key_dir)\n   776\t    frozen = json.loads((key_dir / 'packet-key.json').read_text())\n   777\t    record = {'readings_sha256': hashlib.sha256(data).hexdigest(), 'key_commitment': key_commitment(frozen),\n   778\t              'packets_sha256': hashlib.sha256((out / 'packets.md').read_bytes()).hexdigest() if (out / 'packets.md').exists() else None,\n   779\t              'run_digest': run_digest(out), 'summary': summary}\n   780\t    with open(out / 'verdict.json', 'x') as handle:\n   781\t        json.dump(record, handle, indent=1)\n   782\t    return summary\n   783\t\n   784\t\n   785\tdef replay(out, key_dir):\n   786\t    \"\"\"Recompute the verdict from the sealed readings and compare it with verdict.json.\"\"\"\n   787\t    record = json.loads((out / 'verdict.json').read_text())\n   788\t    data = (out / 'readings.json').read_bytes()\n   789\t    same = (hashlib.sha256(data).hexdigest() == record['readings_sha256'] and record['run_digest'] == run_digest(out)\n   790\t            and record['key_commitment'] == key_commitment(json.loads((key_dir / 'packet-key.json').read_text())))\n   791\t    summary = score(out, key_dir)\n   792\t    matches = same and summary == record['summary']\n   793\t    print(json.dumps({'reproduced': matches}, indent=1))\n   794\t    return matches\n   795\t\n   796\t\n   797\tdef score(out, key_dir):\n   798\t    \"\"\"D725's registered lines on the sealed readings, bound to this run.\"\"\"\n   799\t    frozen = json.loads((key_dir / 'packet-key.json').read_text())\n   800\t    submitted = json.loads((out / 'readings.json').read_text())\n   801\t    problems = [] if frozen.get('run_digest') == run_digest(out) else ['the packet key does not belong to this run']   # [47b.4]\n   802\t    text, key, units = render_packets(out, frozen)                  # [47c.2] every packet rendered again from the run\n   803\t    if sorted(tuple(u) for _, u in frozen['order']) != sorted(units):\n   804\t        problems.append('the key does not map one packet to each unit of the run')\n   805\t    sha = hashlib.sha256(text.encode()).hexdigest()\n   806\t    packets_path = out / 'packets.md'\n   807\t    written = packets_path.read_text() if packets_path.exists() else ''\n   808\t    if not written.startswith(f'Key commitment: {key_commitment(frozen)}\\n'):      # [47d.1] the mapping the readers' text committed to\n   809\t        problems.append('the key is not the one packets.md committed to')\n   810\t    if hashlib.sha256(written.encode()).hexdigest() != sha:\n   811\t        problems.append('packets.md is not the text the run and the key give')\n   812\t    if submitted.get('packets_sha256') != sha:\n   813\t        problems.append('the readings were not made on the frozen packets')\n   814\t    readings = submitted.get('packets', {})\n   815\t    results = json.loads((out / 'results.json').read_text())\n   816\t    problems += [f'answers.jsonl line {d[\"line\"]} is damaged' for d in results.get('damaged', [])\n   817\t                 if d.get('journal') == 'answers.jsonl']                     # [47g] a damaged retry record stays diagnostic\n   818\t    scored = {k: first_attempt(v)['decision'] for k, v in results['finals'].items()}            # [47f.1] completeness from the scored attempts\n   819\t    problems += [f'{k}: {d}' for k, d in scored.items() if d not in ('publish', 'held', 'refused')]               # [47b.2] from the records\n   820\t    problems += [f'{pid}: not read' for pid in key if pid not in readings] + [f'{pid}: not a packet' for pid in readings if pid not in key]\n   821\t    usable_pairs = {'joint': {}, 'separate': {}}\n   822\t    defects = []\n   823\t    for pid, k in key.items():\n   824\t        if pid not in readings:\n   825\t            continue\n   826\t        final, probs = final_readings(pid, readings[pid], list(k['cards']), k['grounds'])\n   827\t        problems += probs\n   828\t        if final is None:\n   829\t            continue\n   830\t        if k['decision'] == 'publish' and k['arm'] in ('joint', 'single'):      # D725: defects across the joint and singleton answers\n   831\t            for v, r in final.items():\n   832\t                if 'yes' in (r['contradiction'], r['internal_reference'], r['deciding_gap']):\n   833\t                    defects.append((pid, k['unit'], k['arm'], k['cards'][v]))\n   834\t        if k['unit'].startswith('pair') and k['arm'] in usable_pairs:\n   835\t            usable_pairs[k['arm']].setdefault(k['unit'], []).append(k['decision'] == 'publish' and all(r['usable'] == 'yes' for r in final.values()))\n   836\t    joint_total = sum(sum(v) for v in usable_pairs['joint'].values())\n   837\t    separate_total = sum(sum(v) for v in usable_pairs['separate'].values())\n   838\t    per_snapshot = {u: sum(v) for u, v in usable_pairs['joint'].items()}\n   839\t    complete = (not problems and len(key) == 27 and len(usable_pairs['joint']) == 3 and len(usable_pairs['separate']) == 3\n   840\t                and all(len(v) == 3 for arm in usable_pairs.values() for v in arm.values()))\n   841\t    passes = complete and not defects and joint_total >= 8 and all(n >= 2 for n in per_snapshot.values()) and joint_total - separate_total >= 3\n   842\t    summary = {'complete': complete, 'problems': problems[:20], 'joint usable pairs': joint_total, 'separate usable pairs': separate_total,\n   843\t               'joint per snapshot': per_snapshot, 'published defects': defects,\n   844\t               'verdict': 'PASS' if passes else ('INCOMPLETE' if not complete else 'STOP')}\n   845\t    print(json.dumps(summary, indent=1))\n   846\t    return summary\n   847\t\n   848\t\n   849\tif __name__ == '__main__':\n   850\t    cmd = sys.argv[1] if len(sys.argv) > 1 else ''\n   851\t    if cmd == 'plan' and len(sys.argv) == 3:\n   852\t        plan(sys.argv[2])\n   853\t    elif cmd == 'plan-v13s' and len(sys.argv) == 3:                     # D737: the small format's plan, $0\n   854\t        plan(sys.argv[2], 'v13s')\n   855\t    elif cmd == 'send' and len(sys.argv) == 5 and not sys.argv[2].startswith('-'):\n   856\t        send(Path(sys.argv[2]), float(sys.argv[3]), sys.argv[4])\n   857\t    elif cmd == 'packets' and len(sys.argv) == 4:\n   858\t        packets(Path(sys.argv[2]), Path(sys.argv[3]))\n   859\t    elif cmd == 'recover' and len(sys.argv) == 3:\n   860\t        recover(Path(sys.argv[2]))\n   861\t    elif cmd == 'verdict' and len(sys.argv) == 5:\n   862\t        verdict(Path(sys.argv[2]), sys.argv[3], Path(sys.argv[4]))\n   863\t    elif cmd == 'replay' and len(sys.argv) == 4:\n   864\t        replay(Path(sys.argv[2]), Path(sys.argv[3]))\n   865\t    else:\n   866\t        raise SystemExit(__doc__)\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc 'cd docs/research/2026-11-22-number-answers && nl -ba assemble_readings.py && diff -u reader-brief-v13.md reader-brief-v13s.md && true'","aggregated_output":"     1\t\"\"\"The blind reading step of the judging-v13 paid gate (PAID-GATE.md §4): split packets.md into reader batches, list the\n     2\tdisagreements between readers A and B for a third reader, and assemble the readings file that `paid_gate.py verdict` seals.\n     3\t\n     4\tUsage:\n     5\t  python3 assemble_readings.py split <packets.md> <out folder> <batches>\n     6\t  python3 assemble_readings.py third <packets.md> <reader A json> <reader B json> <out prompt file>\n     7\t  python3 assemble_readings.py assemble <packets.md> <reader A json> <reader B json> <third json or -> <out readings json>\n     8\t  python3 assemble_readings.py split-exact <packets.md> <out folder> <batches> <brief.md>        # D753: the exact file in every batch\n     9\t  python3 assemble_readings.py third-exact <packets.md> <reader A json> <reader B json> <out prompt file> <brief.md>\n    10\t\"\"\"\n    11\timport hashlib\n    12\timport json\n    13\timport re\n    14\timport sys\n    15\tfrom pathlib import Path\n    16\t\n    17\tHERE = Path(__file__).resolve().parent\n    18\tQUESTIONS = ('usable', 'contradiction', 'internal_reference', 'deciding_gap')\n    19\t\n    20\t\n    21\tdef sections(text):\n    22\t    \"\"\"The packets in order: [(pid, section text)], each section starting at its '## P..' line.\"\"\"\n    23\t    found = list(re.finditer(r'^## (P\\d+)\\n', text, re.M))\n    24\t    return [(m.group(1), text[m.start():(found[i + 1].start() if i + 1 < len(found) else len(text))]) for i, m in enumerate(found)]\n    25\t\n    26\t\n    27\tdef read_json(path):\n    28\t    \"\"\"A reader's answer: the outermost JSON object in the file (fences and prose around it are ignored).\"\"\"\n    29\t    text = Path(path).read_text()\n    30\t    start, end = text.find('{'), text.rfind('}')\n    31\t    if start < 0 or end < start:\n    32\t        raise SystemExit(f'{path}: no JSON object')\n    33\t    return json.loads(text[start:end + 1])\n    34\t\n    35\t\n    36\tdef split(packets_path, out, batches):\n    37\t    text = Path(packets_path).read_text()\n    38\t    parts = sections(text)\n    39\t    brief = (HERE / 'reader-brief-v13.md').read_text()\n    40\t    out.mkdir(parents=True, exist_ok=False)\n    41\t    size = -(-len(parts) // batches)\n    42\t    for b in range(batches):\n    43\t        chunk = parts[b * size:(b + 1) * size]\n    44\t        if chunk:\n    45\t            (out / f'batch-{b + 1}.md').write_text(brief + '\\n\\n# Packets\\n\\n' + ''.join(s for _, s in chunk))\n    46\t            print(f'batch-{b + 1}: {\", \".join(p for p, _ in chunk)} ({sum(len(s) for _, s in chunk)} chars)')\n    47\t\n    48\t\n    49\tdef split_exact(packets_path, out, batches, brief_path):\n    50\t    \"\"\"[D753, council 70] Every reader batch carries the exact packets.md, unchanged (its key-commitment line included), and names\n    51\t    separately the packets that batch must answer, so the text the readers receive is the text whose sha256 the readings carry.\"\"\"\n    52\t    text = Path(packets_path).read_text()\n    53\t    ids = [pid for pid, _ in sections(text)]\n    54\t    brief = Path(brief_path).read_text()\n    55\t    out.mkdir(parents=True, exist_ok=False)\n    56\t    size = -(-len(ids) // batches)\n    57\t    for b in range(batches):\n    58\t        chunk = ids[b * size:(b + 1) * size]\n    59\t        if chunk:\n    60\t            (out / f'batch-{b + 1}.md').write_text(\n    61\t                brief + '\\n\\n# Your packets\\n\\nAnswer only these packets, every card of each: ' + ', '.join(chunk)\n    62\t                + '. The file below holds all packets; leave the others.\\n\\n# The packets file (exact)\\n\\n' + text)\n    63\t            print(f'batch-{b + 1}: {\", \".join(chunk)}')\n    64\t\n    65\t\n    66\tdef third_exact(packets_path, a_path, b_path, out, brief_path):\n    67\t    \"\"\"[D753, council 70] The third reading with the exact packets.md and the two readings of each disputed question.\"\"\"\n    68\t    text = Path(packets_path).read_text()\n    69\t    a, b = read_json(a_path), read_json(b_path)\n    70\t    rows = disagreements(a, b)\n    71\t    lines = [Path(brief_path).read_text(), '\\n# Third reading\\n',\n    72\t             'Two readers disagreed on the questions listed below. For each one, read that packet in the file below and both readings, '\n    73\t             'and give your own answer (yes or no) with a ground naming an id of that packet. Return only JSON: '\n    74\t             '{\"P01\": {\"K1\": {\"usable\": {\"answer\": \"...\", \"ground\": \"...\"}}}} with exactly the listed packet, card and question keys.\\n']\n    75\t    for pid, card, q in rows:\n    76\t        lines.append(f'Disagreement: {pid} {card} {q}\\n  Reader 1: {json.dumps(a[pid][card][q], ensure_ascii=False)}\\n'\n    77\t                     f'  Reader 2: {json.dumps(b[pid][card][q], ensure_ascii=False)}\\n')\n    78\t    lines.append('\\n# The packets file (exact)\\n\\n' + text)\n    79\t    Path(out).write_text('\\n'.join(lines))\n    80\t    print(f'{len(rows)} disagreements in {len({r[0] for r in rows})} packets')\n    81\t\n    82\t\n    83\tdef disagreements(a, b):\n    84\t    return sorted((pid, card, q) for pid in a for card in a[pid] for q in QUESTIONS\n    85\t                  if a[pid][card].get(q, {}).get('answer') != b.get(pid, {}).get(card, {}).get(q, {}).get('answer'))\n    86\t\n    87\t\n    88\tdef third(packets_path, a_path, b_path, out):\n    89\t    text = Path(packets_path).read_text()\n    90\t    by_pid = dict(sections(text))\n    91\t    a, b = read_json(a_path), read_json(b_path)\n    92\t    rows = disagreements(a, b)\n    93\t    brief = (HERE / 'reader-brief-v13.md').read_text()\n    94\t    lines = [brief, '\\n# Third reading\\n',\n    95\t             'Two readers disagreed on the questions listed below. For each one, read the packet and both readings, and give your own '\n    96\t             'answer (yes or no) with a ground naming an id of that packet. Return only JSON: '\n    97\t             '{\"P01\": {\"K1\": {\"usable\": {\"answer\": \"...\", \"ground\": \"...\"}}}} with exactly the listed packet, card and question keys.\\n']\n    98\t    for pid in sorted({r[0] for r in rows}):\n    99\t        lines.append(by_pid[pid])\n   100\t        for _, card, q in [r for r in rows if r[0] == pid]:\n   101\t            lines.append(f'Disagreement: {pid} {card} {q}\\n  Reader 1: {json.dumps(a[pid][card][q], ensure_ascii=False)}\\n'\n   102\t                         f'  Reader 2: {json.dumps(b[pid][card][q], ensure_ascii=False)}\\n')\n   103\t    Path(out).write_text('\\n'.join(lines))\n   104\t    print(f'{len(rows)} disagreements in {len({r[0] for r in rows})} packets')\n   105\t\n   106\t\n   107\tdef assemble(packets_path, a_path, b_path, third_path, out):\n   108\t    data = Path(packets_path).read_bytes()\n   109\t    a, b = read_json(a_path), read_json(b_path)\n   110\t    t = read_json(third_path) if third_path != '-' else {}\n   111\t    readings = {}\n   112\t    for pid in sorted(set(a) | set(b)):\n   113\t        readings[pid] = {}\n   114\t        for card in sorted(set(a.get(pid, {})) | set(b.get(pid, {}))):\n   115\t            entry = {'A': a.get(pid, {}).get(card, {}), 'B': b.get(pid, {}).get(card, {})}\n   116\t            if t.get(pid, {}).get(card):\n   117\t                entry['third'] = t[pid][card]\n   118\t            readings[pid][card] = entry\n   119\t    Path(out).write_text(json.dumps({'packets_sha256': hashlib.sha256(data).hexdigest(), 'packets': readings}, indent=1, ensure_ascii=False))\n   120\t    print(f'{len(readings)} packets assembled; {len(disagreements(a, b))} disagreements, {sum(len(v) for v in t.values())} cards with a third reading')\n   121\t\n   122\t\n   123\tif __name__ == '__main__':\n   124\t    cmd = sys.argv[1] if len(sys.argv) > 1 else ''\n   125\t    if cmd == 'split' and len(sys.argv) == 5:\n   126\t        split(sys.argv[2], Path(sys.argv[3]), int(sys.argv[4]))\n   127\t    elif cmd == 'third' and len(sys.argv) == 6:\n   128\t        third(*sys.argv[2:6])\n   129\t    elif cmd == 'split-exact' and len(sys.argv) == 6:                      # D753: the exact file, the batch's packets named\n   130\t        split_exact(sys.argv[2], Path(sys.argv[3]), int(sys.argv[4]), sys.argv[5])\n   131\t    elif cmd == 'third-exact' and len(sys.argv) == 7:\n   132\t        third_exact(*sys.argv[2:7])\n   133\t    elif cmd == 'assemble' and len(sys.argv) == 7:\n   134\t        assemble(*sys.argv[2:7])\n   135\t    else:\n   136\t        raise SystemExit(__doc__)\n--- reader-brief-v13.md\t2026-11-22 15:23:46\n+++ reader-brief-v13s.md\t2026-11-23 02:09:43\n@@ -1,4 +1,4 @@\n-# Blind reading brief: judging-v13 paid gate (registered in PAID-GATE.md §4)\n+# Blind reading brief: judging-v13s paid gate (PAID-GATE.md §4, with Alex's rulings D747 and D753)\n \n You are a blind reader. The packets below each hold one or two cards. A card is a forecast answer to one question about a company\n figure. For each card the packet shows:\n@@ -15,10 +15,17 @@\n at least one id from **the same packet**: a card (K1, K2), a passage (e123) or a figure (F4).\n \n 1. **usable:** the outcome is usable and supported by the shown passages it rests on.\n+   - A forecast may rest on a related figure when the passages do not give the asked quantity, if the card explains why the\n+     comparison applies to the companies, the period and the quantity asked, and why, under its own stated assumptions, its band is\n+     more likely. The other band may remain possible.\n+   - A card that answers \"can't tell yet\" (unresolved) is usable when it weighs the evidence, gives the company's target as context\n+     where there is one, and names the fact that would decide the band. A bare statement of uncertainty is not usable.\n 2. **contradiction:** with the other card of its packet, it states a hard numerical contradiction. For a packet with one card, the\n    answer is no.\n 3. **internal_reference:** the system's own forecast is presented as the market's expectation.\n 4. **deciding_gap:** an unresolved overlap, a change of scope or an unsized adjustment decides its band.\n+   - A published number that rests on an unsized adjustment (a share, deduction, discount or pace the passages neither size nor\n+     bound) that determines its band: yes. A card that answers \"can't tell yet\" has no band: no.\n \n Rules:\n - Judge only from the packet text: the passages, the figures and the card. Do not use outside knowledge of the company.\n","exit_code":1,"status":"failed"}}
{"type":"item.started","item":{"id":"item_11","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba docs/DECISIONS-log.md | sed -n '11573,11593p;11754,11784p' && cd docs/research/2026-11-22-number-answers && nl -ba reader-brief-v13s.md && nl -ba PAID-GATE.md | tail -14 && rg --files --no-ignore /private/tmp . ../../.. -g '*paid_gate*' -g '*before*d753*' -g '*assemble_readings*' 2>/dev/null | head -90\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba docs/DECISIONS-log.md | sed -n '11573,11593p;11754,11784p' && cd docs/research/2026-11-22-number-answers && nl -ba reader-brief-v13s.md && nl -ba PAID-GATE.md | tail -14 && rg --files --no-ignore /private/tmp . ../../.. -g '*paid_gate*' -g '*before*d753*' -g '*assemble_readings*' 2>/dev/null | head -90\"","aggregated_output":" 11573\t## D747 · 2026-11-23 · Alex rules that a forecast may rest on an explained indirect comparison\n 11574\t\n 11575\t- **The question** (after D746): \"资料没直接给出题目问的那个数，只能拿一个相关的数字来比。比如问四大云厂商今年的数据中心开支能不能过 7000 亿，资料只说“这四家 AI 基础设施开支超过 7300 亿”。这种比较能说明结果更可能落在线的某一边，但另一边也还有可能。这时系统可以发布预测吗，还是要等资料能直接算出落在哪边？\"\n 11576\t  - Options:\n 11577\t    - \"可以发布，要讲清楚 (推荐)\": the answer must explain why the comparison applies to the companies, the year and the quantity\n 11578\t      asked, and why, under its own assumptions, that side is more likely; an answer that cannot explain it is not supported;\n 11579\t    - \"先说“还判断不了”\";\n 11580\t    - \"先停在这里\".\n 11581\t- **Alex's answer** (2026-11-23): \"可以发布，要讲清楚 (推荐)\".\n 11582\t- **Decided (Alex).** When the passages do not give the asked quantity, a forecast may rest on a related figure. It is supported\n 11583\t  only when the answer explains two things: why the comparison applies to the companies, the period and the quantity asked; and why,\n 11584\t  under the answer's own stated assumptions, the chosen side of the line is more likely. An answer that cannot explain this is not\n 11585\t  supported.\n 11586\t  - D741 ruling 3 still holds: a total used for a narrower quantity states the deduction as its own figure, or gives a supported\n 11587\t    bound.\n 11588\t  - D745's ruling still holds: a justified unresolved answer counts as usable.\n 11589\t- **Next (D746).** The ruling's words go into the shared reader definitions (`blind_rules.py`). Then one $0 blinded re-read of nine\n 11590\t  stored answers, registered with its expected readings and reviewed by the council before any packet is read.\n 11591\t\n 11592\t## D748 · 2026-11-23 · The D747 re-read fails on a self-contradicting floor; three of four earlier splits settle under the ruling; council 63: ask Alex to authorize the E writer repair; the paid re-send stays on hold\n 11593\t\n 11754\t## D753 · 2026-11-23 · Alex chooses \"can't tell yet\" as the E-type default and a one-time paid exception\n 11755\t\n 11756\t- **The questions** (after D752):\n 11757\t  1. \"公司重申一个目标，正好落在两个预测档之间的那条线附近（比如 Vera CPU 明年“超过翻倍”，正好压在 400 亿线上）。把目标和其他证据都权衡过，还是说不出哪一档更可能。这时系统应该给读者看什么？\" Options:\n 11758\t     - \"显示“暂时判断不了” (推荐)\": the target as context, \"can't tell yet\", and the missing fact named; the council agreed; no\n 11759\t       request change;\n 11760\t     - \"按公司目标所在的档\".\n 11761\t  2. \"最后一次不花钱的写手测试里，有一份 E 题预测被两家都判了没依据，没达到你定的“0 元测试干净通过才付费”。理事会在这一题上意见不一：Codex 主张先不付费，我主张破例一次。你选哪个？\" Options:\n 11762\t     - \"先不付费，停在这里\" (Codex);\n 11763\t     - \"破例一次，付费重发\" (Claude): 36 requests to luna, ≤ $0.50 including retries; a pass earns design work only, and an E-type\n 11764\t       forced number stops the run;\n 11765\t     - \"先停，我想谈谈\".\n 11766\t- **Alex's answers** (2026-11-23): \"显示“暂时判断不了” (推荐)\"; \"破例一次，付费重发\".\n 11767\t- **Decided (Alex):**\n 11768\t  1. When a reaffirmed target sits near a band line and, after weighing it with the other evidence, neither band is more likely, the\n 11769\t     system shows \"can't tell yet\" with the target as context and names the deciding fact. The request already states it (line 9);\n 11770\t     nothing changes.\n 11771\t  2. A one-time exception to D749's clean-pass condition: the paid re-send of the 36 requests, rebuilt in v13s with the D751 request,\n 11772\t     under D725's lines and the paid gate's reading rule (`PAID-GATE.md` §4), with a total cap of $0.50 including diagnostic\n 11773\t     retries. It is prepared at $0 and reviewed by the council before the send.\n     1\t# Blind reading brief: judging-v13s paid gate (PAID-GATE.md §4, with Alex's rulings D747 and D753)\n     2\t\n     3\tYou are a blind reader. The packets below each hold one or two cards. A card is a forecast answer to one question about a company\n     4\tfigure. For each card the packet shows:\n     5\t- the question and its ladder of rungs;\n     6\t- every passage the answer names, exactly as the model was shown it;\n     7\t- the figures the answer declared (a source figure read from a passage, a computed figure, or an estimate stated as the model's own);\n     8\t- the outcome as the code recomputed it from those figures;\n     9\t- the assumptions the code recorded (an overlap, an adjustment or a bridge, and whether it can move the outcome across a rung boundary);\n    10\t- the card itself (its rung, its reference, its reasons and its citations).\n    11\t\n    12\tA card with no answer says why in plain words.\n    13\t\n    14\tFor **every card**, answer the four questions below. Each answer is yes or no, with a ground. A ground is a short sentence that names\n    15\tat least one id from **the same packet**: a card (K1, K2), a passage (e123) or a figure (F4).\n    16\t\n    17\t1. **usable:** the outcome is usable and supported by the shown passages it rests on.\n    18\t   - A forecast may rest on a related figure when the passages do not give the asked quantity, if the card explains why the\n    19\t     comparison applies to the companies, the period and the quantity asked, and why, under its own stated assumptions, its band is\n    20\t     more likely. The other band may remain possible.\n    21\t   - A card that answers \"can't tell yet\" (unresolved) is usable when it weighs the evidence, gives the company's target as context\n    22\t     where there is one, and names the fact that would decide the band. A bare statement of uncertainty is not usable.\n    23\t2. **contradiction:** with the other card of its packet, it states a hard numerical contradiction. For a packet with one card, the\n    24\t   answer is no.\n    25\t3. **internal_reference:** the system's own forecast is presented as the market's expectation.\n    26\t4. **deciding_gap:** an unresolved overlap, a change of scope or an unsized adjustment decides its band.\n    27\t   - A published number that rests on an unsized adjustment (a share, deduction, discount or pace the passages neither size nor\n    28\t     bound) that determines its band: yes. A card that answers \"can't tell yet\" has no band: no.\n    29\t\n    30\tRules:\n    31\t- Judge only from the packet text: the passages, the figures and the card. Do not use outside knowledge of the company.\n    32\t- Read only the packet text given to you. Do not open any other file. Do not guess how a packet was produced.\n    33\t- A card that has no answer cannot be usable.\n    34\t\n    35\tReturn only JSON, in this shape (every packet and every card of your batch, all four questions each):\n    36\t\n    37\t```json\n    38\t{\"P01\": {\"K1\": {\"usable\": {\"answer\": \"yes\", \"ground\": \"...\"}, \"contradiction\": {\"answer\": \"no\", \"ground\": \"...\"},\n    39\t                \"internal_reference\": {\"answer\": \"no\", \"ground\": \"...\"}, \"deciding_gap\": {\"answer\": \"no\", \"ground\": \"...\"}},\n    40\t         \"K2\": {...}}}\n    41\t```\n   304\t  2. **The reader brief** is `reader-brief-v13s.md`. It is the v13 brief with Alex's two rulings, the same words for both readers and\n   305\t     the third reader:\n   306\t     - `usable` accepts an explained related figure (D747) and a \"can't tell yet\" that weighs the evidence, gives the target as\n   307\t       context and names the deciding fact (D753);\n   308\t     - `deciding_gap` is yes for a published number whose band an unsized adjustment determines, and no for a \"can't tell yet\".\n   309\t  3. **The exact file.** Readers receive the exact `packets.md` (`assemble_readings.py split-exact`; `third-exact` for the third\n   310\t     reader), with their packet ids named separately, so the sha256 the readings carry is the text they read.\n   311\t  4. **The launch.** It runs from the repository root, detached, with the log and pid outside the run folder:\n   312\t     `python3 docs/research/2026-11-22-number-answers/paid_gate.py send poc/data/judging-v13s-paid-2026-11-23 0.5\n   313\t     docs/research/2026-11-22-number-answers/paid-plan-v13s.json`.\n   314\t     - All 36 scored attempts precede any diagnostic retry.\n   315\t     - A terminal transport failure on a first attempt makes the result INCOMPLETE.\n   316\t- **Re-checked after the changes:** rehearsal 19 of 19, paid mutants 33 of 33 with the control passing, cases 111 of 111, and the plan\n   317\t  pin unchanged.\n./paid_gate.py\n./assemble_readings.py\n./__pycache__/paid_gate.cpython-310.pyc\n./__pycache__/assemble_readings.cpython-310.pyc\n../../../docs/research/2026-11-22-number-answers/paid_gate.py\n../../../docs/research/2026-11-22-number-answers/assemble_readings.py\n../../../docs/research/2026-11-22-number-answers/__pycache__/paid_gate.cpython-310.pyc\n../../../docs/research/2026-11-22-number-answers/__pycache__/assemble_readings.cpython-310.pyc\n/private/tmp/claude-501/-Users-lchingen-hivemind/f1ea972d-85a1-4f27-8010-cf0b60054109/scratchpad/mut-d753b/m26/paid_gate.py\n/private/tmp/claude-501/-Users-lchingen-hivemind/f1ea972d-85a1-4f27-8010-cf0b60054109/scratchpad/mut-d753b/m29/paid_gate.py\n/private/tmp/claude-501/-Users-lchingen-hivemind/f1ea972d-85a1-4f27-8010-cf0b60054109/scratchpad/mut-d753b/m19/paid_gate.py\n/private/tmp/claude-501/-Users-lchingen-hivemind/f1ea972d-85a1-4f27-8010-cf0b60054109/scratchpad/s4treeA/paid_gate.py\n/private/tmp/claude-501/-Users-lchingen-hivemind/f1ea972d-85a1-4f27-8010-cf0b60054109/scratchpad/s4treeA/assemble_readings.py\n/private/tmp/claude-501/-Users-lchingen-hivemind/f1ea972d-85a1-4f27-8010-cf0b60054109/scratchpad/mut-d753b/m20/paid_gate.py\n/private/tmp/cla