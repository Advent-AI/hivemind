{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba paid_gate.py | sed -n '395,700p'\"","aggregated_output":"   395\tQUESTIONS = {'usable': 'the outcome is usable and supported by the shown passages it rests on',\n   396\t             'contradiction': 'with the other card of its packet, it states a hard numerical contradiction',\n   397\t             'internal_reference': \"the system's own forecast is presented as the market's expectation\",\n   398\t             'deciding_gap': 'an unresolved overlap, a change of scope or an unsized adjustment decides its band'}\n   399\t\n   400\t\n   401\tdef normalise(calc, prefix=''):\n   402\t    \"\"\"Figure ids renumbered F1.. (after `prefix`) and member prefixes removed, so the arm cannot be read from the ids.\"\"\"\n   403\t    rename = {f['id']: f'{prefix}F{n}' for n, f in enumerate(calc['figures'], 1)}\n   404\t    out = []\n   405\t    for f in calc['figures']:\n   406\t        g = dict(f, id=rename[f['id']])\n   407\t        for key in ('inputs', 'rests_on', 'converts'):\n   408\t            if key in g:\n   409\t                g[key] = [rename.get(x, x) for x in g[key]]\n   410\t        for key in ('disputed', 'bridge'):\n   411\t            if key in g:\n   412\t                g[key] = rename.get(g[key], g[key])\n   413\t        if 'adjusts' in g:\n   414\t            g['adjusts'] = dict(g['adjusts'], figure=rename.get(g['adjusts']['figure'], g['adjusts']['figure']))\n   415\t        out.append(g)\n   416\t    answers = []\n   417\t    for a in calc['answers']:\n   418\t        a2 = dict(a)\n   419\t        if 'outcome' in a2:\n   420\t            a2['outcome'] = rename.get(a2['outcome'], a2['outcome'])\n   421\t        if (a2.get('reference') or {}).get('figure'):\n   422\t            a2['reference'] = {'figure': rename.get(a2['reference']['figure'], a2['reference']['figure'])}\n   423\t        answers.append(a2)\n   424\t    return {'figures': out, 'answers': answers}, rename\n   425\t\n   426\t\n   427\tdef run_digest(out):\n   428\t    h = hashlib.sha256()\n   429\t    for name in ('answers.jsonl', 'results.json', 'plan.json'):\n   430\t        path = out / name\n   431\t        h.update(name.encode() + b'\\0' + (path.read_bytes() if path.exists() else b''))\n   432\t    return h.hexdigest()\n   433\t\n   434\t\n   435\tdef card_view(calc, view_id, recorded, prefix=''):\n   436\t    \"\"\"[47b.3] One card as its own derivation: the figures its outcome and reference rest on, renumbered F1.. (after `prefix`) for this\n   437\t    card alone, and the recorded assumptions about its outcome or its own figures mapped to the same numbers.\"\"\"\n   438\t    figs = {f['id']: f for f in calc['figures']}\n   439\t    refs = lambda f: list(f.get('inputs', [])) + [r for r in f.get('rests_on', []) if r in figs] + \\\n   440\t        ([f['adjusts']['figure']] if f.get('adjusts') else []) + ([f['bridge']] if f.get('bridge') else [])\n   441\t    ans = next(a for a in calc['answers'] if a['view_id'] == view_id)\n   442\t    own = set()\n   443\t    for start in (ans.get('outcome'), (ans.get('reference') or {}).get('figure')):\n   444\t        if start in figs:\n   445\t            own |= cc._upstream_of(start, figs, refs) | {start}\n   446\t    sub = {'figures': [f for f in calc['figures'] if f['id'] in own], 'answers': [ans]}\n   447\t    norm, rename = normalise(sub, prefix)\n   448\t    mapped = []\n   449\t    for r in recorded:                                    # an assumption about this card's outcome, or about one of its own figures\n   450\t        named = [r[k] for k in ('figure', 'bridge') if isinstance(r.get(k), str)]\n   451\t        if (r.get('outcome') == view_id or any(n in rename for n in named)) and all(n in rename for n in named):\n   452\t            mapped.append({k: rename[v] if k in ('figure', 'bridge') else v for k, v in r.items()})\n   453\t    return norm, mapped, sorted({f['evidence'] for f in sub['figures'] if f.get('evidence')} | set(ans.get('cites', []))\n   454\t                                | {x for f in sub['figures'] for x in f.get('rests_on', []) if str(x).startswith('e')})\n   455\t\n   456\t\n   457\tNO_ANSWER = {'not sent': 'No request was sent for this card.', 'interrupted': 'The request was started; no answer was recorded.',\n   458\t             'transport': 'No answer arrived.', 'retry not sent': 'The answer was refused and its retry was not sent.'}\n   459\tFORMAT_INVALID = 'The answer did not match the required format.'\n   460\t\n   461\t\n   462\tdef packet_units(results, items):\n   463\t    \"\"\"Every packet the run gives, as (unit, arm, draw) -> (decision, per-card source): the joint and singleton answers from the finals,\n   464\t    the separate arm's reconciled pairs with each card's own separate answer.\"\"\"\n   465\t    units = {}\n   466\t    for key, entry in results['finals'].items():\n   467\t        unit, arm, draw = key.split('|')\n   468\t        if not arm.startswith('separate-'):\n   469\t            units[(unit, arm, draw)] = (entry.get('decision'), {v: entry for v in items[(unit, arm)]['members']})\n   470\t    for key, entry in results['reconciled'].items():\n   471\t        unit, draw = key.split('|')\n   472\t        per_card = {a.split('-', 1)[1]: results['finals'].get(f'{unit}|{a}|{draw}', {}) for (u, a) in items if u == unit and a.startswith('separate-')}\n   473\t        units[(unit, 'separate', draw)] = (entry.get('decision'), per_card)\n   474\t    return units\n   475\t\n   476\t\n   477\tdef card_lines(base, fam, v, token, data, final_label, prefix=''):\n   478\t    \"\"\"One card's answer as a reader sees it: the passages it names, its own figures, its recomputed outcome and assumptions, the card.\n   479\t    Returns (lines, ids a ground may name).\"\"\"\n   480\t    if not data:\n   481\t        return [f'  {final_label}'], set()\n   482\t    calc = strip(data)\n   483\t    try:\n   484\t        checked = cc.check(fam, base['passages'], calc)\n   485\t    except Exception as error:\n   486\t        checked = {'errors': [('checker', str(error))], 'recorded': [], 'published': {}}\n   487\t    try:\n   488\t        norm, recorded, named = card_view(calc, v, checked.get('recorded', []), prefix)\n   489\t    except StopIteration:\n   490\t        return ['  The answer has no card for this question.'], set()\n   491\t    lines = ['  Passages, as the request showed them:\\n' + '\\n'.join('  ' + base['shown'].get(e, f'- {e} (not shown)') for e in named),\n   492\t             '  Figures (declared):\\n' + '\\n'.join(f'  - {json.dumps(f, ensure_ascii=False)}' for f in norm['figures']),\n   493\t             '  Recomputed outcome: ' + json.dumps((checked.get('published') or {}).get(v)),\n   494\t             '  Recorded assumptions: ' + json.dumps(recorded),\n   495\t             f'  Card {token}: ' + json.dumps(norm['answers'][0], ensure_ascii=False)]\n   496\t    return lines, set(named) | {f['id'] for f in norm['figures']}\n   497\t\n   498\t\n   499\tdef packet_body(items, unit, arm, decision, per_card):\n   500\t    \"\"\"[47d.3] One scoring packet: each card's final answer only. No attempt history, no code decision and no check code, which would\n   501\t    tell separate calls from one joint call; the verdict applies the code's decision itself. Returns (lines, grounds, members).\"\"\"\n   502\t    base = items[(unit, 'joint' if unit.startswith('pair') else 'single')]\n   503\t    grounds, lines = set(), []\n   504\t    for number, v in enumerate(base['members'], 1):\n   505\t        q = base['questions'][v]\n   506\t        token = f'K{number}'\n   507\t        grounds.add(token)\n   508\t        lines.append(f'### Card {token}: {q[\"question\"]}\\n  Ladder: ' + ' / '.join(f'rung {i + 1}: {c}' for i, c in enumerate(q['ladder'])))\n   509\t        source = per_card.get(v, {})\n   510\t        attempts = source.get('attempts') or []\n   511\t        last = attempts[-1] if attempts else {}\n   512\t        label = NO_ANSWER.get(source.get('decision'), FORMAT_INVALID if last.get('status') == 'format invalid' else NO_ANSWER['not sent'])\n   513\t        fam = base['family'] if arm != 'separate' else only(base['family'], v)\n   514\t        body, named = card_lines(base, fam, v, token, last.get('data'), label)\n   515\t        lines += body\n   516\t        grounds |= named\n   517\t    lines.append('For each card answer yes or no, each with a ground that names a card (K...), passage (e...) or figure (F...) of this packet: '\n   518\t                 + '; '.join(f'{k}: {t}' for k, t in QUESTIONS.items()) + '\\n')\n   519\t    return lines, sorted(grounds), base['members']\n   520\t\n   521\t\n   522\tdef key_commitment(key):\n   523\t    return hashlib.sha256(json.dumps(key, sort_keys=True).encode()).hexdigest()\n   524\t\n   525\t\n   526\tdef render_packets(out, key):\n   527\t    \"\"\"The scoring packets for a key {salt, run_digest, order}: the key's salted sha256 first (so the text the readers receive commits\n   528\t    to the mapping), then each packet in the key's order, rendered from the run's results and plan.\"\"\"\n   529\t    results = json.loads((out / 'results.json').read_text())\n   530\t    items = {(i['unit'], i['arm']): i for i in json.loads((out / 'plan.json').read_text())}\n   531\t    units = packet_units(results, items)\n   532\t    lines, rendered = [f'Key commitment: {key_commitment(key)}', ''], {}\n   533\t    for pid, unit_key in key['order']:\n   534\t        decision, per_card = units[tuple(unit_key)]\n   535\t        body, grounds, members = packet_body(items, unit_key[0], unit_key[1], decision, per_card)\n   536\t        lines += [f'## {pid}'] + body\n   537\t        rendered[pid] = {'unit': unit_key[0], 'arm': unit_key[1], 'draw': unit_key[2], 'decision': decision, 'grounds': grounds,\n   538\t                         'cards': {f'K{n}': v for n, v in enumerate(members, 1)}}\n   539\t    return '\\n'.join(lines), rendered, units\n   540\t\n   541\t\n   542\tdef render_attempts(out, labels):\n   543\t    \"\"\"[47d.3] Earlier attempts, for diagnostic reading only and never scored: each under its own shuffled label (D01..), with the\n   544\t    question and that attempt's own answer, and no link to a packet.\"\"\"\n   545\t    results = json.loads((out / 'results.json').read_text())\n   546\t    items = {(i['unit'], i['arm']): i for i in json.loads((out / 'plan.json').read_text())}\n   547\t    lines = []\n   548\t    for label, (unit, arm, draw, v, attempt) in labels:\n   549\t        entry = results['finals'][f'{unit}|{arm}|{draw}']\n   550\t        a = next(x for x in entry['attempts'] if x['attempt'] == attempt)\n   551\t        base = items[(unit, 'joint' if unit.startswith('pair') else 'single')]\n   552\t        fam = base['family'] if arm in ('joint', 'single') else only(base['family'], v)\n   553\t        status = FORMAT_INVALID if a.get('status') == 'format invalid' else NO_ANSWER['transport']\n   554\t        lines.append(f'## {label}: {base[\"questions\"][v][\"question\"]}')\n   555\t        lines += card_lines(base, fam, v, 'K1', a.get('data'), status, 'T.')[0]\n   556\t    return '\\n'.join(lines)\n   557\t\n   558\t\n   559\tdef packets(out, key_dir):\n   560\t    if (key_dir / 'packet-key.json').exists():            # [47b.4] the inventory and key are frozen once made\n   561\t        raise SystemExit(f'{key_dir / \"packet-key.json\"} exists: the packets are frozen; refused')\n   562\t    results = json.loads((out / 'results.json').read_text())\n   563\t    items = {(i['unit'], i['arm']): i for i in json.loads((out / 'plan.json').read_text())}\n   564\t    rng = random.Random(secrets.randbits(64))\n   565\t    unit_keys = sorted(packet_units(results, items))\n   566\t    rng.shuffle(unit_keys)\n   567\t    earlier = sorted((k.split('|')[0], k.split('|')[1], k.split('|')[2], v, a['attempt'])\n   568\t                     for k, e in results['finals'].items() for a in (e.get('attempts') or [])[:-1]\n   569\t                     for v in items[tuple(k.split('|')[:2])]['members'])\n   570\t    rng.shuffle(earlier)\n   571\t    key = {'salt': secrets.token_hex(16), 'run_digest': run_digest(out), 'order': [(f'P{n:02d}', list(u)) for n, u in enumerate(unit_keys, 1)],\n   572\t           'attempts': [(f'D{n:02d}', list(e)) for n, e in enumerate(earlier, 1)]}\n   573\t    text = render_packets(out, key)[0]\n   574\t    key_dir.mkdir(parents=True, exist_ok=True)\n   575\t    with open(out / 'packets.md', 'x') as handle:\n   576\t        handle.write(text)\n   577\t    with open(out / 'attempts.md', 'x') as handle:\n   578\t        handle.write(render_attempts(out, key['attempts']))\n   579\t    with open(key_dir / 'packet-key.json', 'x') as handle:\n   580\t        json.dump(key, handle, indent=1)\n   581\t    print(f'{len(key[\"order\"])} packets, {len(key[\"attempts\"])} earlier attempts; key in {key_dir}')\n   582\t\n   583\t\n   584\tdef _grounded(ground, grounds):\n   585\t    \"\"\"[47b.4] A ground is non-empty text that names at least one card, passage or figure of the packet.\"\"\"\n   586\t    return isinstance(ground, str) and ground.strip() != '' and any(re.search(rf'\\b{re.escape(g)}\\b', ground) for g in grounds)\n   587\t\n   588\t\n   589\tdef final_readings(pid, cards, members, grounds=()):\n   590\t    \"\"\"[47.4] Two independent readings per card (A, B), each question answered yes/no with its ground; a third decides each\n   591\t    disagreement. Returns ({card: {question: answer}}, problems).\"\"\"\n   592\t    problems, final = [], {}\n   593\t    if sorted(cards) != sorted(members):\n   594\t        return None, [f'{pid}: cards {sorted(cards)} are not the unit\\'s {sorted(members)}']\n   595\t    for v, r in cards.items():\n   596\t        final[v] = {}\n   597\t        for q in QUESTIONS:\n   598\t            a, b = (r.get(x, {}).get(q, {}) for x in ('A', 'B'))\n   599\t            for name, x in (('A', a), ('B', b)):\n   600\t                if x.get('answer') not in ('yes', 'no') or not _grounded(x.get('ground'), grounds):\n   601\t                    problems.append(f'{pid} {v} {q}: reader {name} gave no yes/no with a ground from this packet')\n   602\t            if a.get('answer') == b.get('answer'):\n   603\t                final[v][q] = a.get('answer')\n   604\t            else:\n   605\t                t = r.get('third', {}).get(q, {})\n   606\t                if t.get('answer') not in ('yes', 'no') or not _grounded(t.get('ground'), grounds):\n   607\t                    problems.append(f'{pid} {v} {q}: the readers disagree and no third reading decides')\n   608\t                final[v][q] = t.get('answer')\n   609\t    return final, problems\n   610\t\n   611\t\n   612\tdef verdict(out, readings_path, key_dir):\n   613\t    \"\"\"D725's registered lines on validated readings, bound to this run.\"\"\"\n   614\t    frozen = json.loads((key_dir / 'packet-key.json').read_text())\n   615\t    submitted = json.loads(Path(readings_path).read_text())\n   616\t    problems = [] if frozen.get('run_digest') == run_digest(out) else ['the packet key does not belong to this run']   # [47b.4]\n   617\t    text, key, units = render_packets(out, frozen)                  # [47c.2] every packet rendered again from the run\n   618\t    if sorted(tuple(u) for _, u in frozen['order']) != sorted(units):\n   619\t        problems.append('the key does not map one packet to each unit of the run')\n   620\t    sha = hashlib.sha256(text.encode()).hexdigest()\n   621\t    packets_path = out / 'packets.md'\n   622\t    written = packets_path.read_text() if packets_path.exists() else ''\n   623\t    if not written.startswith(f'Key commitment: {key_commitment(frozen)}\\n'):      # [47d.1] the mapping the readers' text committed to\n   624\t        problems.append('the key is not the one packets.md committed to')\n   625\t    if hashlib.sha256(written.encode()).hexdigest() != sha:\n   626\t        problems.append('packets.md is not the text the run and the key give')\n   627\t    if submitted.get('packets_sha256') != sha:\n   628\t        problems.append('the readings were not made on the frozen packets')\n   629\t    readings = submitted.get('packets', {})\n   630\t    results = json.loads((out / 'results.json').read_text())\n   631\t    problems += [f'answers.jsonl line {d[\"line\"]} is damaged' for d in results.get('damaged', [])]\n   632\t    unfinished = [k for k, v in results['finals'].items() if v.get('decision') not in ('publish', 'held', 'unresolved')]\n   633\t    problems += [f'{k}: {results[\"finals\"][k][\"decision\"]}' for k in unfinished]                                  # [47b.2] from the records\n   634\t    problems += [f'{pid}: not read' for pid in key if pid not in readings] + [f'{pid}: not a packet' for pid in readings if pid not in key]\n   635\t    usable_pairs = {'joint': {}, 'separate': {}}\n   636\t    defects = []\n   637\t    for pid, k in key.items():\n   638\t        if pid not in readings:\n   639\t            continue\n   640\t        final, probs = final_readings(pid, readings[pid], list(k['cards']), k['grounds'])\n   641\t        problems += probs\n   642\t        if final is None:\n   643\t            continue\n   644\t        if k['decision'] == 'publish' and k['arm'] in ('joint', 'single'):      # D725: defects across the joint and singleton answers\n   645\t            for v, r in final.items():\n   646\t                if 'yes' in (r['contradiction'], r['internal_reference'], r['deciding_gap']):\n   647\t                    defects.append((pid, k['unit'], k['arm'], k['cards'][v]))\n   648\t        if k['unit'].startswith('pair') and k['arm'] in usable_pairs:\n   649\t            usable_pairs[k['arm']].setdefault(k['unit'], []).append(k['decision'] == 'publish' and all(r['usable'] == 'yes' for r in final.values()))\n   650\t    joint_total = sum(sum(v) for v in usable_pairs['joint'].values())\n   651\t    separate_total = sum(sum(v) for v in usable_pairs['separate'].values())\n   652\t    per_snapshot = {u: sum(v) for u, v in usable_pairs['joint'].items()}\n   653\t    complete = (not problems and len(key) == 27 and len(usable_pairs['joint']) == 3 and len(usable_pairs['separate']) == 3\n   654\t                and all(len(v) == 3 for arm in usable_pairs.values() for v in arm.values()))\n   655\t    passes = complete and not defects and joint_total >= 8 and all(n >= 2 for n in per_snapshot.values()) and joint_total - separate_total >= 3\n   656\t    summary = {'complete': complete, 'problems': problems[:20], 'joint usable pairs': joint_total, 'separate usable pairs': separate_total,\n   657\t               'joint per snapshot': per_snapshot, 'published defects': defects,\n   658\t               'verdict': 'PASS' if passes else ('INCOMPLETE' if not complete else 'STOP')}\n   659\t    print(json.dumps(summary, indent=1))\n   660\t    return summary\n   661\t\n   662\t\n   663\tif __name__ == '__main__':\n   664\t    cmd = sys.argv[1] if len(sys.argv) > 1 else ''\n   665\t    if cmd == 'plan' and len(sys.argv) == 3:\n   666\t        plan(sys.argv[2])\n   667\t    elif cmd == 'send' and len(sys.argv) == 5 and not sys.argv[2].startswith('-'):\n   668\t        send(Path(sys.argv[2]), float(sys.argv[3]), sys.argv[4])\n   669\t    elif cmd == 'packets' and len(sys.argv) == 4:\n   670\t        packets(Path(sys.argv[2]), Path(sys.argv[3]))\n   671\t    elif cmd == 'recover' and len(sys.argv) == 3:\n   672\t        recover(Path(sys.argv[2]))\n   673\t    elif cmd == 'verdict' and len(sys.argv) == 5:\n   674\t        verdict(Path(sys.argv[2]), sys.argv[3], Path(sys.argv[4]))\n   675\t    else:\n   676\t        raise SystemExit(__doc__)\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba paid_gate.py | sed -n '135,395p'\"","aggregated_output":"   135\t\n   136\tdef strip(data):\n   137\t    return rv.without_nulls(data)\n   138\t\n   139\t\n   140\tclass Gate:\n   141\t    def __init__(self, out, transport, ledger=None):\n   142\t        self.out, self.transport, self.ledger = out, transport, ledger\n   143\t        self.cfg = config.load(str(CONFIG))\n   144\t        self.lock = threading.Lock()\n   145\t        (out / 'archives').mkdir(parents=True, exist_ok=True)\n   146\t\n   147\t    def request(self, it, user):\n   148\t        return model.build_request(self.cfg.rejudging, it['system'], user, it['schema'], 'judgement', self.cfg.provider)\n   149\t\n   150\t    def record(self, line):\n   151\t        with self.lock, open(self.out / 'answers.jsonl', 'a') as handle:\n   152\t            handle.write(json.dumps(line, ensure_ascii=False) + '\\n')\n   153\t\n   154\t    def attempt(self, it, draw, user, n):\n   155\t        name = f'{it[\"unit\"]}-{it[\"arm\"]}-d{draw}-a{n}.sqlite'\n   156\t        archive = model.Archive(str(self.out / 'archives' / name))\n   157\t        line = {'unit': it['unit'], 'arm': it['arm'], 'draw': draw, 'attempt': n,\n   158\t                'request_sha256': model.request_identity(self.request(it, user))[1]}\n   159\t        self.record(dict(line, status='started'))                          # [47.3] recorded before the provider is called\n   160\t        data = None\n   161\t        try:\n   162\t            answer = model.call(archive, self.cfg, self.cfg.rejudging, it['system'], user, it['schema'], 'judgement', 'judge', transport=self.transport)\n   163\t            data = answer.data\n   164\t            line.update(cost_usd=answer.cost_usd, data=data)\n   165\t            calc = strip(data)\n   166\t            result = cc.check(it['family'], it['passages'], calc)\n   167\t            decision = cc.publish_decision(it['family'], calc, result)\n   168\t            line.update(status='answered', errors=result['errors'], recorded=result['recorded'], published=result.get('published'), decision=decision)\n   169\t        except model.SchemaError as error:\n   170\t            row = archive.conn.execute('select response_json from model_calls order by call_id desc limit 1').fetchone()\n   171\t            line.update(status='format invalid', error=str(error)[:500], decision='refused', errors=[('schema', str(error)[:300])],\n   172\t                        raw=row[0][:20000] if row and row[0] else None)\n   173\t        except model.TransportError as error:\n   174\t            line.update(status='transport error', error=str(error)[:500], decision='transport')\n   175\t        except Exception as error:                                       # [47.3] a checker failure is recorded with the raw answer and refused\n   176\t            line.update(status='checker error', error=f'{type(error).__name__}: {error}'[:500], decision='refused',\n   177\t                        errors=[('checker', f'{type(error).__name__}: {error}'[:300])], data=data)\n   178\t        self.record(line)\n   179\t        return line\n   180\t\n   181\t    def unit(self, it, draw):\n   182\t        first = self.attempt(it, draw, it['user'], 1)\n   183\t        if first['decision'] != 'refused':\n   184\t            return first, [first]\n   185\t        reasons = '; '.join(f'{c}: {d}' for c, d in first.get('errors', []))[:4000]\n   186\t        second = self.attempt(it, draw, it['user'] + RETRY_MARK + reasons, 2)\n   187\t        final = dict(second, decision='unresolved') if second['decision'] == 'refused' else second\n   188\t        return final, [first, second]\n   189\t\n   190\t    def run(self, items):\n   191\t        try:\n   192\t            for draw in DRAWS:\n   193\t                for it in items:\n   194\t                    if self.ledger is not None and self.ledger.read().get('stopped'):\n   195\t                        continue\n   196\t                    self.unit(it, draw)\n   197\t        finally:                                          # [47b.2] the results come from the attempt records, written even after an abort\n   198\t            summary = summarise(self.out, items, self.ledger.read() if self.ledger else None)\n   199\t        return summary\n   200\t\n   201\t\n   202\tdef attempt_records(out, damaged=None):\n   203\t    \"\"\"The committed journal entries. A line that does not parse (a write torn by a crash) is skipped and listed in `damaged`, so its\n   204\t    attempt counts as unfinished and the run as incomplete.\"\"\"\n   205\t    path = out / 'answers.jsonl'\n   206\t    records = []\n   207\t    for number, text in enumerate(path.read_text(errors='replace').splitlines() if path.exists() else [], 1):\n   208\t        try:\n   209\t            records.append(json.loads(text))\n   210\t        except json.JSONDecodeError:\n   211\t            if damaged is not None:\n   212\t                damaged.append({'line': number, 'text': text[:200]})\n   213\t    return records\n   214\t\n   215\t\n   216\tdef derive_finals(out, items, damaged=None):\n   217\t    \"\"\"Each planned unit and draw: 'dispatched' (a started line), 'completed' (a finished line), and the decision of its last finished\n   218\t    attempt (a second refusal is unresolved). A unit with no started line is not sent; one started but not finished is interrupted.\"\"\"\n   219\t    records = attempt_records(out, damaged)\n   220\t    finals = {}\n   221\t    for it in items:\n   222\t        for draw in DRAWS:\n   223\t            mine = [r for r in records if r['unit'] == it['unit'] and r['arm'] == it['arm'] and r['draw'] == draw]\n   224\t            started = [r for r in mine if r['status'] == 'started']\n   225\t            done = [r for r in mine if r['status'] != 'started']\n   226\t            key = f'{it[\"unit\"]}|{it[\"arm\"]}|{draw}'\n   227\t            if not started:\n   228\t                finals[key] = {'decision': 'not sent', 'attempts': []}\n   229\t                continue\n   230\t            if len(done) < len(started):\n   231\t                unfinished = [{'attempt': r['attempt'], 'status': 'interrupted', 'decision': 'interrupted'} for r in started\n   232\t                              if r['attempt'] not in {d['attempt'] for d in done}]\n   233\t                finals[key] = {'decision': 'interrupted', 'attempts': [{k: r.get(k) for k in ('attempt', 'status', 'decision', 'errors', 'data')}\n   234\t                                                                       for r in done] + unfinished}\n   235\t                continue\n   236\t            last = done[-1]\n   237\t            decision = last['decision']\n   238\t            if decision == 'refused':                          # a second refusal is unresolved; a first with no retry sent is incomplete\n   239\t                decision = 'unresolved' if len(done) >= 2 else 'retry not sent'\n   240\t            finals[key] = {k: last.get(k) for k in ('status', 'data', 'errors', 'recorded', 'published')}\n   241\t            finals[key].update(decision=decision, attempts=[{k: r.get(k) for k in ('attempt', 'status', 'decision', 'errors', 'data')} for r in done])\n   242\t    return finals\n   243\t\n   244\t\n   245\tdef summarise(out, items, ledger_state):\n   246\t    damaged = []\n   247\t    finals = derive_finals(out, items, damaged)\n   248\t    reconciled = {}\n   249\t    for draw_store, total, dc in PAIRS:                     # the separate arm, reconciled over the pair's family\n   250\t        for draw in DRAWS:\n   251\t            a, b = (finals.get(f'pair-{draw_store}|separate-{m[0]}|{draw}', {}) for m in (total, dc))\n   252\t            if a.get('decision') != 'publish' or b.get('decision') != 'publish':\n   253\t                reconciled[f'pair-{draw_store}|{draw}'] = {'decision': 'not reconciled', 'members': [a.get('decision'), b.get('decision')]}\n   254\t                continue\n   255\t            family = pair_family(draw_store, total, dc)\n   256\t            merged = merge([(total[0], strip(a['data'])), (dc[0], strip(b['data']))], {cc._key(s) for s in family['shared']})\n   257\t            pas = next(i['passages'] for i in items if i['unit'] == f'pair-{draw_store}' and i['arm'] == 'joint')\n   258\t            result = cc.check(family, pas, {k: merged[k] for k in ('figures', 'answers')})\n   259\t            reconciled[f'pair-{draw_store}|{draw}'] = {'decision': cc.publish_decision(family, merged, result), 'errors': result['errors'],\n   260\t                                                     'published': result.get('published'), 'calc': merged}\n   261\t    summary = {'finals': finals, 'reconciled': reconciled, 'ledger': ledger_state, 'damaged': damaged}\n   262\t    (out / 'results.json').write_text(json.dumps(summary, indent=1, ensure_ascii=False))\n   263\t    return summary\n   264\t\n   265\t\n   266\tdef _same_value(a, b):\n   267\t    \"\"\"Two recomputed (interval, bound) values are the same when their bounds match and each end agrees within 1e-9 relative.\"\"\"\n   268\t    if a is None or b is None or a[1] != b[1]:\n   269\t        return False\n   270\t    return all(abs(x - y) <= 1e-9 * max(1.0, abs(x), abs(y)) for x, y in zip(a[0], b[0]))\n   271\t\n   272\t\n   273\tdef merge(parts, shared_keys):\n   274\t    \"\"\"Two separate answers as one calculation: each figure id prefixed by its member; then [47.1, 47c.1] a forecast of a declared\n   275\t    shared quantity in the second call is unified with the first call's forecast of the same quantity and scenario when their\n   276\t    recomputed values are the same (references point to the first, the duplicate kept beside the calculation). Duplicates inside one\n   277\t    call are never unified, and forecasts that differ are both kept, so the family's checks judge them as they judge a joint answer.\"\"\"\n   278\t    figures, answers, recomputed, owner = [], [], {}, {}\n   279\t    for view_id, calc in parts:\n   280\t        rename = {f['id']: f'{view_id}.{f[\"id\"]}' for f in calc['figures']}\n   281\t        figs = {f['id']: f for f in calc['figures']}\n   282\t        refs = lambda f, figs=figs: list(f.get('inputs', [])) + [r for r in f.get('rests_on', []) if r in figs] + \\\n   283\t            ([f['adjusts']['figure']] if f.get('adjusts') else []) + ([f['bridge']] if f.get('bridge') else [])\n   284\t        try:\n   285\t            values = cc._evaluate_bounded(figs, refs, {})\n   286\t        except Exception:\n   287\t            values = {}\n   288\t        for f in calc['figures']:\n   289\t            g = dict(f, id=rename[f['id']])\n   290\t            for key in ('inputs', 'rests_on', 'converts'):\n   291\t                if key in g:\n   292\t                    g[key] = [rename.get(x, x) for x in g[key]]\n   293\t            for key in ('disputed', 'bridge'):\n   294\t                if key in g:\n   295\t                    g[key] = rename.get(g[key], g[key])\n   296\t            if 'adjusts' in g:\n   297\t                g['adjusts'] = dict(g['adjusts'], figure=rename.get(g['adjusts']['figure'], g['adjusts']['figure']))\n   298\t            figures.append(g)\n   299\t            recomputed[g['id']] = values.get(f['id'])\n   300\t            owner[g['id']] = view_id\n   301\t        for a in calc['answers']:\n   302\t            a2 = dict(a)\n   303\t            if 'outcome' in a2:\n   304\t                a2['outcome'] = rename.get(a2['outcome'], a2['outcome'])\n   305\t            if a2.get('reference', {}).get('figure'):\n   306\t                a2['reference'] = {'figure': rename.get(a2['reference']['figure'], a2['reference']['figure'])}\n   307\t            answers.append(a2)\n   308\t    key = lambda f: (f['what']['population'], f['what']['measure'], f['what']['scope'], f['what']['period'], f.get('scenario', 'base'))\n   309\t    candidates = {}\n   310\t    for g in figures:\n   311\t        if g.get('basis') == 'forecast' and cc._key(g['what']) in shared_keys:\n   312\t            candidates.setdefault(key(g), {}).setdefault(owner[g['id']], []).append(g['id'])\n   313\t    alias, duplicates = {}, []\n   314\t    for k, by_call in candidates.items():                  # [47d.2] one to one: each call holds exactly one candidate\n   315\t        if len(by_call) == 2 and all(len(ids) == 1 for ids in by_call.values()):\n   316\t            (a,), (b,) = (by_call[v] for v, _ in parts)\n   317\t            if _same_value(recomputed.get(a), recomputed.get(b)):         # [47b.1] a fixed numeric equivalence\n   318\t                alias[b] = a\n   319\t    if alias:\n   320\t        kept = []\n   321\t        for g in figures:\n   322\t            if g['id'] in alias:\n   323\t                duplicates.append(g)\n   324\t                continue\n   325\t            for k2 in ('inputs', 'rests_on', 'converts'):\n   326\t                if k2 in g:\n   327\t                    g[k2] = [alias.get(x, x) for x in g[k2]]\n   328\t            for k2 in ('disputed', 'bridge'):\n   329\t                if k2 in g:\n   330\t                    g[k2] = alias.get(g[k2], g[k2])\n   331\t            if 'adjusts' in g:\n   332\t                g['adjusts'] = dict(g['adjusts'], figure=alias.get(g['adjusts']['figure'], g['adjusts']['figure']))\n   333\t            kept.append(g)\n   334\t        figures = kept\n   335\t        for a in answers:\n   336\t            if a.get('outcome') in alias:\n   337\t                a['outcome'] = alias[a['outcome']]\n   338\t            if a.get('reference', {}).get('figure') in alias:\n   339\t                a['reference'] = {'figure': alias[a['reference']['figure']]}\n   340\t    return {'figures': figures, 'answers': answers, 'unified': [{'kept': alias[d['id']], 'duplicate': d} for d in duplicates]}\n   341\t\n   342\t\n   343\tdef recover(out):\n   344\t    \"\"\"Read-only: rebuild results.json from the journal of a stopped run; nothing is sent.\"\"\"\n   345\t    items = json.loads((out / 'plan.json').read_text())\n   346\t    ledger = json.loads((out / 'ledger.json').read_text()) if (out / 'ledger.json').exists() else None\n   347\t    summary = summarise(out, items, ledger)\n   348\t    print(json.dumps({'damaged': summary['damaged'], 'finals': {k: v['decision'] for k, v in summary['finals'].items()}}, indent=1))\n   349\t    return summary\n   350\t\n   351\t\n   352\tdef budget_module():\n   353\t    import importlib.util\n   354\t    spec = importlib.util.spec_from_file_location('budget_replay_v13', REPO / 'clean-arch/e2e-comparison-2026-11-13/budget_replay.py')\n   355\t    module = importlib.util.module_from_spec(spec)\n   356\t    spec.loader.exec_module(module)\n   357\t    return module\n   358\t\n   359\t\n   360\tdef send(out, approved, plan_path):\n   361\t    if APPROVED_CEILING is None or approved != APPROVED_CEILING:\n   362\t        raise SystemExit(f'the approved ceiling is {APPROVED_CEILING} (Alex names it); refused')\n   363\t    if out.exists():\n   364\t        raise SystemExit(f'{out} exists: the gate starts from an empty folder')\n   365\t    text = Path(plan_path).read_text()\n   366\t    if hashlib.sha256(text.encode()).hexdigest() != PINNED_PLAN_SHA256:          # [47.2] only the reviewed plan\n   367\t        raise SystemExit('the plan is not the reviewed one (sha256 differs); refused')\n   368\t    AUTH.parent.mkdir(parents=True, exist_ok=True)\n   369\t    try:                                                                     # [47.2] one authorization, one ledger, one launch\n   370\t        with open(AUTH, 'x') as handle:\n   371\t            json.dump({'plan_sha256': PINNED_PLAN_SHA256, 'ceiling': approved, 'out': str(out)}, handle)\n   372\t    except FileExistsError:\n   373\t        raise SystemExit(f'{AUTH} exists: this authorization was already used; refused')\n   374\t    items = json.loads(text)\n   375\t    if len({(i['unit'], i['arm']) for i in items}) != len(items):\n   376\t        raise SystemExit('duplicate (unit, arm) in the plan; refused')\n   377\t    out.mkdir(parents=True)\n   378\t    (out / 'plan.json').write_text(json.dumps(items))\n   379\t    budget = budget_module()\n   380\t    budget.SharedLedger.init(str(out / 'ledger.json'), approved)\n   381\t    ledger = budget.SharedLedger(str(out / 'ledger.json'))\n   382\t    lock_handle = open(out / 'gate.launcher.lock', 'a+')\n   383\t    if not ledger.claim_launcher('v13-gate', lock_handle):\n   384\t        raise SystemExit('another launch is running')\n   385\t    remove_gate = budget.install_stop_gate(ledger)\n   386\t    try:\n   387\t        summary = Gate(out, budget.BudgetTransport(ledger), ledger).run(items)\n   388\t    finally:\n   389\t        remove_gate()\n   390\t        ledger.remove_launcher('v13-gate')\n   391\t    print(json.dumps({k: v.get('decision') for k, v in summary['finals'].items()}, indent=1))\n   392\t\n   393\t\n   394\t# ---------- blind reading ----------\n   395\tQUESTIONS = {'usable': 'the outcome is usable and supported by the shown passages it rests on',\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_9","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"rg -n '\"'^#{1,5} |47e|independent|score|changed|ceiling'\"' PAID-GATE.md; tail -10 rehearsal.log; tail -7 paid-mutants.log\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"rg -n '\"'^#{1,5} |47e|independent|score|changed|ceiling'\"' PAID-GATE.md; tail -10 rehearsal.log; tail -7 paid-mutants.log\"","aggregated_output":"1:# judging-v13 paid gate: plan, harness and reading rule (registered before any send; D725, D729, D730)\n3:## 1. What is sent\n24:## 2. Spend and stops\n26:- **The ledger:** one, at Alex's ceiling (`paid_gate.py send <folder> <ceiling> paid-plan.json` refuses any other ceiling).\n29:- **Estimate:** about $0.004–0.008 a call, so $0.15–0.30 for 36, plus retries. **Proposed ceiling: $0.50.**\n32:## 3. The $0 rehearsal (`paid_rehearsal.py`, `rehearsal.log`: 16 of 16)\n34:- **Clean run:** 36 first attempts, every HTTP body byte-equal to an independently built request, every unit published, the separate\n35:  arm reconciled in 9 of 9, the spend settled under the ceiling.\n46:## 3b. After council round 47 (`codex-r47.md`)\n68:- **Rehearsal:** 27 of 27 (`rehearsal.log`). The $0 gate still passes (`gate-run27.txt`: 87 of 87), and the mutants are unchanged.\n70:## 3c. After council round 47b (`codex-r47b.md`)\n103:  - a second packets run, readings made on other packets, a run changed after freezing, and null or foreign grounds are each refused\n106:  defences on a scratch copy. The plan is unchanged (sha256 `6f81dae5…`), and `calc_check.py` is unchanged since gate run 27.\n108:## 3d. After council round 47c (`codex-r47c.md`)\n138:  - The swap test exchanged P01 and P02. In about 2 of 26 shuffles, these are two draws of the same unit and arm.\n149:## 3e. After council round 47d (`codex-r47d.md`): three structural rules\n157:   - Earlier attempts go to `attempts.md`. That file is for diagnostic reading only and is never scored. Each attempt sits under its\n179:## 4. The reading rule (fixed now, before any answer exists)\n196:  both readings and the passages, and its answer decides. No reading is changed after the verdict is computed.\n205:## 5. What the result decides\nPASS  separate-within-dup-shared: two equal shared forecasts within one call are not unified with each other, so C4 refuses as within one call  refused [\"('NVIDIA', 'revenue', 'company', 'FY2027 Q3') base: 3 forecast nodes (v14.q3_two_a, v14.q3_two_b, v9.q3_one_v9); exactly one per scenario is required\"]\nPASS  separate-within-dup-second: the second call's two equal shared forecasts are not both unified to the first call's one (C4 refuses)  refused [\"('NVIDIA', 'revenue', 'company', 'FY2027 Q3') base: 3 forecast nodes (v14.q3_one_v14, v9.q3_two_a, v9.q3_two_b); exactly one per scenario is required\"]\nPASS  abstain: an unresolved singleton is published and can be read with its card as the ground  \nPASS  verdict: a swap of two packets with identical text: INCOMPLETE (the key is not the committed one)  the key is not the one packets.md committed to\nPASS  verdict: decisions written into the key: INCOMPLETE (the key is not the committed one)  INCOMPLETE\nPASS  torn journal: recover keeps the committed entries, marks the torn attempt interrupted and the line damaged, sends nothing  single-E|single|3: interrupted\nPASS  torn journal: the interrupted card's packet says the request was started and no answer recorded  P06\nPASS  verdict: a damaged journal line makes the verdict INCOMPLETE  answers.jsonl line 72 is damaged\nPASS  a refused first answer whose retry was never sent is incomplete, not refused or not sent  \n51 of 51 checks pass\nCAUGHT  15 a several-candidate second call is unified  FAIL  separate-within-dup-second: the second call's two equal shared forecasts are not both unified to the fir\nCAUGHT  16 the commitment is not checked  FAIL  verdict: a swap of two packets with identical text: INCOMPLETE (the key is not the committed one)  packe\nCAUGHT  17 an interrupted card reads as never sent  FAIL  torn journal: the interrupted card's packet says the request was started and no answer recorded  P08\nCAUGHT  18 a card is not a ground  FAIL  abstain: an unresolved singleton is published and can be read with its card as the ground  P02 K1 usable\nCAUGHT  19 a torn journal line stops the summary  crash: json.decoder.JSONDecodeError: Expecting ',' delimiter: line 1 column 532 (char 531)\nCAUGHT  20 a damaged line does not make the verdict incomplete  FAIL  verdict: a damaged journal line makes the verdict INCOMPLETE  single-E|single|3: interrupted\n20 of 20 mutants caught; control passes\n","exit_code":0,"status":"completed"}}
