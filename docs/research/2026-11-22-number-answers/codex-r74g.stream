{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"rg -n '\"'^#+ .*D(726|756|757|758)'\"\\\\b|\"'^'\"\\\\| D(726|756|757|758) ' docs/DECISIONS-log.md\"","aggregated_output":"10991:## D726 · 2026-11-22 · Alex opens a judge version for related number questions ($0 gate first) and agrees to \"Forecast unavailable\" as the first-release interim\n11799:## D755 · 2026-11-23 · The paid re-send STOPs (complete); council 71: close v13s at STOP and carry D726's \"Forecast unavailable\" into the first release\n11823:## D756 · 2026-11-23 · Alex closes the v13s line; the first release shows number questions as \"Forecast unavailable\"\n11842:## D757 · 2026-11-23 · Toward production: the \"Forecast unavailable\" release design is ready for when Alex opens release work (council 72–72d); two choices go to Alex\n11867:## D758 · 2026-11-23 · Under D439 the council opens local release work for \"Forecast unavailable\"; non-number questions show no explanation text (§4 a); the v13s checker defects are closed as won't-fix (council 73)\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba src/hivemind/service.py | sed -n '1,360p'\"","aggregated_output":"     1\t\"\"\"Read-only answers over the views ledger, as of a calendar day (docs/poc/service.md).\n     2\t\n     3\tNothing here reads the clock (D12, D13): every function takes `as_of`, a day, and the default is the ledger's last\n     4\tcompleted day. A row is visible as of a day when the sequence number it was written under belongs to an item or a\n     5\tdaily round dated on or before that day. Nothing here writes.\n     6\t\"\"\"\n     7\timport json\n     8\timport re\n     9\timport sqlite3\n    10\tfrom decimal import Decimal\n    11\t\n    12\tfrom . import vocabulary\n    13\tfrom .views import store\n    14\t\n    15\tTIER_FACT = vocabulary.TIERS[0]          # 'fact'; a legacy ledger's '发生的事' compares equal through vocabulary.canonical\n    16\tCOMPARATORS = ('>=', '<', '=')\n    17\t\n    18\t\n    19\tdef open_ledger(path):\n    20\t    \"\"\"A read-only connection to a views database.\"\"\"\n    21\t    return store.open_read_only(path)\n    22\t\n    23\t\n    24\tdef default_as_of(conn):\n    25\t    \"\"\"Today's default day: the last completed day, or a legacy ledger's last judgement day. Read only through `resolve_bound`.\"\"\"\n    26\t    return store.last_completed_day(conn) or conn.execute('select max(publication_day) from judgements').fetchone()[0]\n    27\t\n    28\t\n    29\tclass FirstDayNotCompleted(ValueError):\n    30\t    \"\"\"The store holds processing steps and no completed day: its first day is still in progress, and nothing is served from it\n    31\t    (live-service/OPERATING-CONTRACT.md, row 4; open defect 10).\"\"\"\n    32\t\n    33\t    def __init__(self):\n    34\t        super().__init__(\"the store's first day has not completed\")\n    35\t\n    36\t\n    37\tclass BoundNotCompleted(ValueError):\n    38\t    \"\"\"An explicit upper bound later than the store's last completed day: refused, naming that day (OPERATING-CONTRACT.md, row 3).\"\"\"\n    39\t\n    40\t    def __init__(self, requested, last_completed_day):\n    41\t        self.requested, self.last_completed_day = requested, last_completed_day\n    42\t        super().__init__(f'day not completed: {requested} is after the last completed day {last_completed_day}')\n    43\t\n    44\t\n    45\tclass RangeNotOrdered(ValueError):\n    46\t    \"\"\"A range whose start is after its resolved end: a window reaching into days not yet completed (council round 124).\"\"\"\n    47\t\n    48\t    def __init__(self, start, end):\n    49\t        self.start, self.end = start, end\n    50\t        super().__init__(f'range start after its end: {start} to {end}')\n    51\t\n    52\t\n    53\tdef first_day_unfinished(conn):\n    54\t    return store.last_completed_day(conn) is None and conn.execute('select 1 from processing_steps limit 1').fetchone() is not None\n    55\t\n    56\t\n    57\tdef resolve_bound(conn, bound, *, unfiltered=False):\n    58\t    \"\"\"The one owner of an upper date bound, explicit or omitted (OPERATING-CONTRACT.md, row 3).\n    59\t\n    60\t    A store whose first day is in progress is refused. An omitted bound is today's default day; with `unfiltered` (the bundle\n    61\t    functions, whose omitted bound read every record), it is the last completed day, or None (no filter, as before) on a store with\n    62\t    none. An explicit bound later than the last completed day is refused, whatever the store holds after it; one on or before it\n    63\t    passes. Idempotent: a bound it passed passes again.\"\"\"\n    64\t    if first_day_unfinished(conn):\n    65\t        raise FirstDayNotCompleted()\n    66\t    last = store.last_completed_day(conn)\n    67\t    if not bound:\n    68\t        return last if unfiltered else default_as_of(conn)\n    69\t    if last is not None and bound > last:\n    70\t        raise BoundNotCompleted(bound, last)\n    71\t    return bound\n    72\t\n    73\t\n    74\tdef resolve_range(conn, start, end):\n    75\t    \"\"\"A range's end resolved by `resolve_bound` (an explicit future end is refused there); a start after the end is refused. A start\n    76\t    equal to the end reads as before: an empty window for `changes`, whose start is excluded, and that one day for `history`, whose\n    77\t    start is included; a client polling \"what changed since the day I last saw\" keeps its empty answer until a day completes\n    78\t    (council round 124). An end that resolves to None (an empty store) is compared with nothing, as before.\"\"\"\n    79\t    end = resolve_bound(conn, end)\n    80\t    if start and end is not None and start > end:\n    81\t        raise RangeNotOrdered(start, end)\n    82\t    return end\n    83\t\n    84\t\n    85\t_SEQ_DAYS = {}      # id(connection) → (connection, (max sequence, rows), map); a sqlite3 connection cannot carry attributes\n    86\t\n    87\t\n    88\tdef seq_day_map(conn):\n    89\t    \"\"\"sequence number → the publication day of the item or daily round written under it. Cached per connection and\n    90\t    rebuilt when processing_steps has grown (an open ledger gains steps while the pipeline runs); without the cache\n    91\t    one view with 367 pieces of evidence cost 1,224 full scans (0.46 s, measured 2026-10-24).\"\"\"\n    92\t    stamp = tuple(conn.execute('select max(sequence_no), count(*) from processing_steps').fetchone())\n    93\t    entry = _SEQ_DAYS.get(id(conn))\n    94\t    if entry is not None and entry[0] is conn and entry[1] == stamp:\n    95\t        return entry[2]\n    96\t    cache = {}\n    97\t    for seq, day in conn.execute('select sequence_no, min(publication_day) from processing_steps where sequence_no > 0 group by sequence_no'):\n    98\t        cache[seq] = day\n    99\t    if cache:                 # sequence 0 is the seed questions written before the first item (D253): visible from the ledger's first day\n   100\t        cache[0] = min(cache.values())\n   101\t    if len(_SEQ_DAYS) >= 64:\n   102\t        _SEQ_DAYS.clear()\n   103\t    _SEQ_DAYS[id(conn)] = (conn, stamp, cache)\n   104\t    return cache\n   105\t\n   106\t\n   107\tdef day_of_seq(conn, seq):\n   108\t    return seq_day_map(conn).get(seq)\n   109\t\n   110\t\n   111\tdef visible(conn, seq, as_of):\n   112\t    day = day_of_seq(conn, seq)\n   113\t    return day is not None and day <= as_of\n   114\t\n   115\t\n   116\t# ---------- views\n   117\t\n   118\tdef view_exists(conn, record, as_of):\n   119\t    return visible(conn, record['created_seq'], as_of)\n   120\t\n   121\t\n   122\tdef is_open_as_of(conn, view_id, as_of):\n   123\t    for row in conn.execute('select open, after_seq from view_switches where view_id=? order by id desc', (view_id,)):\n   124\t        if visible(conn, row['after_seq'], as_of):\n   125\t            return bool(row['open'])\n   126\t    return True\n   127\t\n   128\t\n   129\tdef state_as_of(conn, view_id, as_of):\n   130\t    \"\"\"The last judgement on or before the day, with the day the current position was first taken.\"\"\"\n   131\t    rows = [dict(r) for r in conn.execute('select * from judgements where view_id=? and publication_day<=? order by judgement_id', (view_id, as_of))]\n   132\t    if not rows:\n   133\t        return None\n   134\t    last = rows[-1]\n   135\t    since, previous = last['publication_day'], None\n   136\t    for row in reversed(rows[:-1]):\n   137\t        if row['rung'] != last['rung']:\n   138\t            previous = row['rung']\n   139\t            break\n   140\t        since = row['publication_day']\n   141\t    return {'position': last['rung'], 'judgement_day': last['publication_day'], 'since_day': since, 'previous_position': previous,\n   142\t            'rounds': len(rows), 'why_changed': last['why_changed'], 'reasons': last['reasons'], 'theme_pushes': _json(last.get('theme_pushes_json'))}\n   143\t\n   144\t\n   145\tdef summaries(conn, as_of=None, include_closed=False):\n   146\t    \"\"\"Every view as of the day as a light record (id, object, kind, what it looks at, the question, due day, open,\n   147\t    dependency and dependant ids): what a search ranks. The full record with its evidence counts is `view`; listing\n   148\t    92 of those cost 0.29 s per search (1,205 evidence reads), measured 2026-10-24.\"\"\"\n   149\t    as_of = resolve_bound(conn, as_of)\n   150\t    out = []\n   151\t    for record in conn.execute('select * from views order by created_seq'):\n   152\t        record = dict(record)\n   153\t        if not view_exists(conn, record, as_of):\n   154\t            continue\n   155\t        is_open = is_open_as_of(conn, record['view_id'], as_of)\n   156\t        if not include_closed and not is_open:\n   157\t            continue\n   158\t        out.append({'view_id': record['view_id'], 'object': record['object_id'], 'object_kind': record['object_kind'], 'kind': record['kind'],\n   159\t                    'looks_at': record['looks_at'], 'question': record['question'], 'due_day': record['due_day'], 'open': is_open,\n   160\t                    'dependencies': [d['view_id'] for d in dependencies(conn, record['view_id'], as_of)], 'dependants': dependants(conn, record['view_id'], as_of)})\n   161\t    return out\n   162\t\n   163\t\n   164\tdef views(conn, object_id=None, as_of=None, include_closed=False):\n   165\t    as_of = resolve_bound(conn, as_of)\n   166\t    rows = conn.execute('select * from views' + (' where object_id=?' if object_id else '') + ' order by created_seq', (object_id,) if object_id else ()).fetchall()\n   167\t    out = []\n   168\t    for record in rows:\n   169\t        record = dict(record)\n   170\t        if not view_exists(conn, record, as_of):\n   171\t            continue\n   172\t        if not include_closed and not is_open_as_of(conn, record['view_id'], as_of):\n   173\t            continue\n   174\t        out.append(view(conn, record['view_id'], as_of, record=record))\n   175\t    return out\n   176\t\n   177\t\n   178\tdef dependencies(conn, view_id, as_of):\n   179\t    \"\"\"The view's dependencies recorded on or before the day, each pointing at the target resolved on or before it.\"\"\"\n   180\t    out = []\n   181\t    for dep in conn.execute('select * from dependencies where view_id=? order by dependency_id', (view_id,)):\n   182\t        if not visible(conn, dep['seq'], as_of):\n   183\t            continue\n   184\t        target = dep['depends_on']\n   185\t        for res in conn.execute('select resolved_to, seq from dependency_resolutions where dependency_id=? order by id desc', (dep['dependency_id'],)):\n   186\t            if visible(conn, res['seq'], as_of):\n   187\t                target = res['resolved_to']\n   188\t                break\n   189\t        out.append({'view_id': target, 'direction': dep['direction'], 'wait_chain_view_id': dep['wait_chain_view_id'], 'wait_year': dep['wait_year'], 'since_day': day_of_seq(conn, dep['seq'])})\n   190\t    return out\n   191\t\n   192\t\n   193\tdef dependants(conn, view_id, as_of):\n   194\t    \"\"\"The views recorded on or before the day as depending on this one (directly or by a resolution).\"\"\"\n   195\t    direct = [r['view_id'] for r in conn.execute('select view_id, seq from dependencies where depends_on=?', (view_id,)) if visible(conn, r['seq'], as_of)]\n   196\t    resolved = [r['view_id'] for r in conn.execute('select d.view_id, r.seq from dependency_resolutions r join dependencies d on d.dependency_id=r.dependency_id where r.resolved_to=?', (view_id,)) if visible(conn, r['seq'], as_of)]\n   197\t    return sorted(set(direct + resolved))\n   198\t\n   199\t\n   200\tdef view(conn, view_id, as_of=None, record=None):\n   201\t    as_of = resolve_bound(conn, as_of)\n   202\t    record = record or store.view(conn, view_id)\n   203\t    if not record or not view_exists(conn, record, as_of):\n   204\t        return None\n   205\t    rungs = store.rungs_of(conn, view_id)\n   206\t    state = state_as_of(conn, view_id, as_of)\n   207\t    if state:\n   208\t        rung = next((r for r in rungs if r['position'] == state['position']), None)\n   209\t        state['label'] = rung['label'] if rung else None\n   210\t        state['condition'] = rung['condition'] if rung else None\n   211\t    in_force = evidence(conn, view_id, as_of)\n   212\t    return {\n   213\t        'view_id': view_id, 'object': record['object_id'], 'object_kind': record['object_kind'], 'kind': record['kind'],\n   214\t        'looks_at': record['looks_at'], 'question': record['question'], 'due_day': record['due_day'], 'year': record['year'],\n   215\t        'created_day': day_of_seq(conn, record['created_seq']), 'created_from': record['created_from_input'],\n   216\t        'as_of': as_of, 'open': is_open_as_of(conn, view_id, as_of), 'rungs': rungs, 'state': state,\n   217\t        'dependencies': dependencies(conn, view_id, as_of), 'dependants': dependants(conn, view_id, as_of),\n   218\t        'counts': {'rounds': state['rounds'] if state else 0, 'evidence': len(in_force), 'facts': sum(1 for e in in_force if vocabulary.canonical('tier', e['tier']) == TIER_FACT)},\n   219\t    }\n   220\t\n   221\t\n   222\t# ---------- evidence\n   223\t\n   224\tdef evidence_record(conn, evidence_id, as_of, arrived_seq=None):\n   225\t    \"\"\"One piece of evidence with only the sources recorded on or before the day (a later outlet of the same\n   226\t    sentence is not yet known on that day).\"\"\"\n   227\t    piece = store.evidence(conn, evidence_id)\n   228\t    if not piece:\n   229\t        return None\n   230\t    sources = [dict(s) for s in conn.execute('select input_id, category, publication_day, seq from evidence_sources where evidence_id=? order by id', (evidence_id,)) if visible(conn, s['seq'], as_of)]\n   231\t    replaces = conn.execute('select old_evidence_id, seq from replacements where new_evidence_id=?', (evidence_id,)).fetchone()\n   232\t    return {'evidence_id': piece['evidence_id'], 'one_line': piece['one_line'], 'quote': piece['quote'], 'tier': piece['tier'],\n   233\t            'speaker': piece['speaker'], 'original_who': piece['original_who'], 'original_day': piece['original_day'], 'event_time': piece['event_time'],\n   234\t            'day': day_of_seq(conn, arrived_seq if arrived_seq is not None else piece['created_seq']), 'sources': sources, 'outlets': len(sources),\n   235\t            'replaces': replaces['old_evidence_id'] if replaces and visible(conn, replaces['seq'], as_of) else None}\n   236\t\n   237\t\n   238\tdef evidence(conn, view_id, as_of=None, tier=None):\n   239\t    \"\"\"Evidence linked to the view on or before the day and not replaced on or before it, with its sources.\"\"\"\n   240\t    as_of = resolve_bound(conn, as_of)\n   241\t    out = []\n   242\t    for link in conn.execute('select evidence_id, seq from evidence_links where view_id=? order by id', (view_id,)):\n   243\t        if not visible(conn, link['seq'], as_of):\n   244\t            continue\n   245\t        replacement = conn.execute('select new_evidence_id, said_day, seq from replacements where old_evidence_id=? order by id desc limit 1', (link['evidence_id'],)).fetchone()\n   246\t        if replacement and visible(conn, replacement['seq'], as_of):\n   247\t            continue\n   248\t        piece = evidence_record(conn, link['evidence_id'], as_of, link['seq'])\n   249\t        if tier and piece['tier'] != tier:\n   250\t            continue\n   251\t        out.append(piece)\n   252\t    return out\n   253\t\n   254\t\n   255\t# ---------- history\n   256\t\n   257\tdef history(conn, view_id, from_day=None, to_day=None):\n   258\t    to_day = resolve_range(conn, from_day, to_day)\n   259\t    from_day = from_day or '0000-00-00'\n   260\t    judgements = []\n   261\t    previous = None\n   262\t    for row in conn.execute('select * from judgements where view_id=? order by judgement_id', (view_id,)):\n   263\t        entry = {'day': row['publication_day'], 'seq': row['seq'], 'position': row['rung'], 'changed': bool(row['changed']), 'moved_from': previous if previous is not None and previous != row['rung'] else None,\n   264\t                 'why_changed': row['why_changed'], 'reasons': row['reasons'], 'cited': _unique(_json(row['cited_evidence_json'])), 'pushes': _json(row['pushes_json']),\n   265\t                 'theme_pushes': _json(row['theme_pushes_json'] if 'theme_pushes_json' in row.keys() else None), 'round': row['input_id']}\n   266\t        previous = row['rung']\n   267\t        if from_day <= row['publication_day'] <= to_day:\n   268\t            judgements.append(entry)\n   269\t    arrivals = {}\n   270\t    for link in conn.execute('select evidence_id, seq from evidence_links where view_id=?', (view_id,)):\n   271\t        day = day_of_seq(conn, link['seq'])\n   272\t        if day and from_day <= day <= to_day:\n   273\t            piece = store.evidence(conn, link['evidence_id'])\n   274\t            bucket = arrivals.setdefault(day, {'evidence': 0, 'facts': 0})\n   275\t            bucket['evidence'] += 1\n   276\t            bucket['facts'] += int(vocabulary.canonical('tier', piece['tier']) == TIER_FACT)\n   277\t    replacements = [{'day': day_of_seq(conn, r['seq']), 'old': r['old_evidence_id'], 'new': r['new_evidence_id'], 'said_day': r['said_day']}\n   278\t                    for r in conn.execute('select r.* from replacements r join evidence_links l on l.evidence_id=r.new_evidence_id where l.view_id=?', (view_id,))\n   279\t                    if day_of_seq(conn, r['seq']) and from_day <= day_of_seq(conn, r['seq']) <= to_day]\n   280\t    switches = [{'day': day_of_seq(conn, s['after_seq']), 'open': bool(s['open']), 'reason': s['reason']}\n   281\t                for s in conn.execute('select * from view_switches where view_id=? order by id', (view_id,)) if day_of_seq(conn, s['after_seq']) and from_day <= day_of_seq(conn, s['after_seq']) <= to_day]\n   282\t    return {'view_id': view_id, 'from_day': from_day, 'to_day': to_day, 'judgements': judgements,\n   283\t            'changes': [j for j in judgements if j['moved_from'] is not None], 'arrivals': dict(sorted(arrivals.items())),\n   284\t            'replacements': replacements, 'switches': switches}\n   285\t\n   286\t\n   287\tclass LedgerError(ValueError):\n   288\t    \"\"\"A ledger record the service cannot read (corrupt JSON): refused, never read as empty.\"\"\"\n   289\t\n   290\t\n   291\tclass StoreUnreadable(LedgerError):\n   292\t    \"\"\"The store could not be opened, or its read transaction begun and pinned (live-service/OPERATING-CONTRACT.md, row 1): named by\n   293\t    its path, never answered with an empty or stale state.\"\"\"\n   294\t\n   295\t\n   296\tdef open_pinned(path):\n   297\t    \"\"\"A reader's connection with its committed state pinned (row 2: `BEGIN`, then a first read, which in WAL mode fixes the state\n   298\t    every later read of the request sees). A SQLite failure in these three steps closes what was opened and raises `StoreUnreadable`\n   299\t    naming the path; a later SQLite error is not covered here.\"\"\"\n   300\t    conn = None\n   301\t    try:\n   302\t        conn = open_ledger(path)\n   303\t        conn.execute('begin')\n   304\t        conn.execute('select 1 from sqlite_master limit 1').fetchone()\n   305\t        return conn\n   306\t    except sqlite3.Error as error:\n   307\t        if conn is not None:\n   308\t            conn.close()\n   309\t        raise StoreUnreadable(f'{path}: {error}') from error\n   310\t\n   311\t\n   312\tdef _unique(ids):\n   313\t    \"\"\"A judgement's cites as the UI contract reads them: each id once, first occurrence kept. The writer stores the set from\n   314\t    2026-10-28; the sealed ledger sealed-2026-10-28-v34-nvda-3m-through-0828 holds one judgement (v2, id 736) that cites an id twice.\"\"\"\n   315\t    seen, out = set(), []\n   316\t    for value in ids:\n   317\t        if value not in seen:\n   318\t            seen.add(value)\n   319\t            out.append(value)\n   320\t    return out\n   321\t\n   322\t\n   323\tdef _json(text):\n   324\t    if not text:\n   325\t        return []\n   326\t    try:\n   327\t        return json.loads(text)\n   328\t    except ValueError as error:\n   329\t        raise LedgerError(f'a judgement record holds invalid JSON: {text[:60]!r}') from error\n   330\t\n   331\t\n   332\t# ---------- the processing record\n   333\t\n   334\tdef record(conn, view_id, as_of=None):\n   335\t    \"\"\"The last check of the view on or before the day: when, by which round, how much came in that day.\"\"\"\n   336\t    as_of = resolve_bound(conn, as_of)\n   337\t    row = conn.execute('select input_id, publication_day, seq from judgements where view_id=? and publication_day<=? order by judgement_id desc limit 1', (view_id, as_of)).fetchone()\n   338\t    if not row:\n   339\t        return {'view_id': view_id, 'as_of': as_of, 'last_check': None}\n   340\t    day = row['publication_day']\n   341\t    items = [r['input_id'] for r in conn.execute(\"select distinct input_id from processing_steps where publication_day=? and step='handed_over' and result='ok' and input_id not like 'day:%'\", (day,))]\n   342\t    arrived = sum(1 for link in conn.execute('select seq from evidence_links where view_id=?', (view_id,)) if day_of_seq(conn, link['seq']) == day)\n   343\t    return {'view_id': view_id, 'as_of': as_of, 'last_check': {'day': day, 'round': row['input_id'], 'items_processed_that_day': len(items), 'evidence_arrived_that_day': arrived}}\n   344\t\n   345\t\n   346\t# ---------- changes since a day\n   347\t\n   348\tdef changes(conn, since_day, to_day=None):\n   349\t    \"\"\"Judgements that said 'changed' after since_day (exclusive) up to to_day, with their cited evidence.\"\"\"\n   350\t    to_day = resolve_range(conn, since_day, to_day)\n   351\t    out = []\n   352\t    previous = {}\n   353\t    for row in conn.execute('select * from judgements order by judgement_id'):\n   354\t        before = previous.get(row['view_id'])\n   355\t        previous[row['view_id']] = row['rung']\n   356\t        if not row['changed'] or not (since_day < row['publication_day'] <= to_day):\n   357\t            continue\n   358\t        cited = [piece for piece in (evidence_record(conn, e, row['publication_day']) for e in _unique(_json(row['cited_evidence_json']))) if piece]\n   359\t        out.append({'view_id': row['view_id'], 'day': row['publication_day'], 'from_position': before, 'to_position': row['rung'],\n   360\t                    'position_moved': before is not None and before != row['rung'], 'why_changed': row['why_changed'], 'cited': cited})\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba src/hivemind/bundle.py | sed -n '1,345p'\"","aggregated_output":"     1\t\"\"\"One view in the shape the front end reads: the ladder, every judgement round with the model's reason and the\n     2\tevidence it cited, the evidence in force with tiers, speakers and sources, dependencies, replacements and the freeze\n     3\tswitches. The same shaping writes the mock's data file (scripts/mock_data.py) and answers POST /ideas, so the front\n     4\tend's adapter reads both. Read-only on every database. With `as_of`, rows written after that day are left out.\"\"\"\n     5\timport json\n     6\tfrom contextlib import contextmanager\n     7\tfrom datetime import date\n     8\t\n     9\tfrom . import service\n    10\tfrom .views import store\n    11\t\n    12\t\n    13\t@contextmanager\n    14\tdef read_snapshot(*connections):\n    15\t    \"\"\"Pin each read connection for a complete envelope; preserve a caller's transaction.\"\"\"\n    16\t    owned = []\n    17\t    try:\n    18\t        for conn in connections:\n    19\t            if conn is not None and not conn.in_transaction:\n    20\t                conn.execute('begin')\n    21\t                owned.append(conn)\n    22\t        yield\n    23\t    finally:\n    24\t        for conn in reversed(owned):\n    25\t            conn.rollback()\n    26\t\n    27\t\n    28\tdef item_lookup(items_db):\n    29\t    \"\"\"input id → title, publisher and category of a stored item, from the items database (or the id alone when the\n    30\t    database is not given or does not hold it).\"\"\"\n    31\t    cache = {}\n    32\t\n    33\t    def item_of(input_id):\n    34\t        if input_id not in cache:\n    35\t            row = items_db.execute('select title, publisher, publisher_type, category, publication_day, source_uri from items where input_id=?', (input_id,)).fetchone() if items_db is not None else None\n    36\t            cache[input_id] = dict(row) if row else {'title': input_id, 'publisher': '', 'publisher_type': '', 'category': '', 'publication_day': '', 'source_uri': ''}\n    37\t        return cache[input_id]\n    38\t    return item_of\n    39\t\n    40\t\n    41\tdef _visible(views_db, seq, as_of):\n    42\t    return as_of is None or service.visible(views_db, seq, as_of)\n    43\t\n    44\t\n    45\tdef ladder_row(views_db, view_id):\n    46\t    \"\"\"The view's ladder as the new system's writer stored it (`clean_ladders`, written in the view's own call): the parsed\n    47\t    ladder; 'no table' for a store without that table (a legacy ledger); 'no row' when the store has the table and no row for the\n    48\t    view. A row that is not readable JSON with a ladder, or two rows for one view, is refused.\"\"\"\n    49\t    if not views_db.execute(\"select 1 from sqlite_master where type='table' and name='clean_ladders'\").fetchone():\n    50\t        return 'no table'\n    51\t    rows = views_db.execute('select checked_answer from clean_ladders where view_id=?', (view_id,)).fetchall()\n    52\t    if not rows:\n    53\t        return 'no row'\n    54\t    if len(rows) > 1:\n    55\t        raise ValueError(f'{view_id}: {len(rows)} ladder rows for one view')\n    56\t    try:\n    57\t        ladder = json.loads(rows[0][0])['ladder']\n    58\t    except (TypeError, ValueError, KeyError) as error:\n    59\t        raise ValueError(f'{view_id}: its ladder row holds no readable ladder ({error!r})')\n    60\t    if not isinstance(ladder, dict):\n    61\t        raise ValueError(f'{view_id}: its ladder row holds no readable ladder')\n    62\t    return ladder\n    63\t\n    64\t\n    65\tdef not_judged(views_db, view_id, created_seq, as_of=None):\n    66\t    \"\"\"D397: the parts of a topic its one judged question leaves out, with their reasons, from the view's ladder row. None for a\n    67\t    legacy ledger, for a view with no row, and before the view's creation at as_of; [] when the row lists none. A malformed row,\n    68\t    or two rows for one view, is refused. Called directly for a view not visible at the resolved bound, it refuses the view\n    69\t    (OPERATING-CONTRACT.md, row 3), so a question created after that day is never returned.\"\"\"\n    70\t    as_of = service.resolve_bound(views_db, as_of, unfiltered=True)\n    71\t    if as_of is not None and not _visible(views_db, created_seq, as_of):\n    72\t        raise KeyError(f'{view_id} is not available as of {as_of}')\n    73\t    ladder = ladder_row(views_db, view_id)\n    74\t    if ladder in ('no table', 'no row'):\n    75\t        return None\n    76\t    parts = ladder.get('not_judged')\n    77\t    if not isinstance(parts, list) or not all(isinstance(p, dict) and isinstance(p.get('part'), str) and isinstance(p.get('why'), str) for p in parts):\n    78\t        raise ValueError(f'{view_id}: its parts not judged are not a list of {{part, why}} texts')\n    79\t    return [{'part': p['part'], 'why': p['why']} for p in parts]\n    80\t\n    81\t\n    82\tdef answer_shape(views_db, view_id):\n    83\t    \"\"\"(shape, favourable end) of the view's answer choices, as the page needs them to read the stored labels without inventing a\n    84\t    direction (page-contract/DESIGN.md): (None, None) for a legacy ledger; ('unrecorded', None) for a view with no row in a store\n    85\t    that has rows; ('event', None) or ('figure', 'higher' | 'lower' | 'n/a') from the row. Not suppressed before creation: it says\n    86\t    how to read the labels, which are shown as they are.\"\"\"\n    87\t    ladder = ladder_row(views_db, view_id)\n    88\t    if ladder == 'no table':\n    89\t        return None, None\n    90\t    if ladder == 'no row':\n    91\t        return 'unrecorded', None\n    92\t    if ladder.get('event'):\n    93\t        return 'event', None\n    94\t    figure = ladder.get('figure')\n    95\t    if isinstance(figure, dict) and figure.get('favourable_end') in ('higher', 'lower', 'n/a'):\n    96\t        return 'figure', figure['favourable_end']\n    97\t    raise ValueError(f'{view_id}: its ladder row is neither an event nor a figure with a favourable end')\n    98\t\n    99\t\n   100\tdef view_bundle(views_db, item_of, view_id, as_of=None):\n   101\t    \"\"\"One view's complete record as of the bound (resolved; an omitted bound on a store with no completed day reads every\n   102\t    record, as before). A view not visible at the bound is refused (OPERATING-CONTRACT.md, row 3).\"\"\"\n   103\t    as_of = service.resolve_bound(views_db, as_of, unfiltered=True)\n   104\t    v = views_db.execute('select * from views where view_id=?', (view_id,)).fetchone()\n   105\t    if v is None:\n   106\t        raise KeyError(view_id)\n   107\t    if as_of is not None and not service.view_exists(views_db, v, as_of):\n   108\t        raise KeyError(f'{view_id} is not available as of {as_of}')\n   109\t    columns = {r[1] for r in views_db.execute('pragma table_info(rungs)')}\n   110\t    bounds = ', lo, hi' if {'lo', 'hi'} <= columns else ''          # a ledger written before keys has no bounds; the adapter then reads the prose\n   111\t    rungs = [dict(r) for r in views_db.execute(f'select position, label, condition{bounds} from rungs where view_id=? order by position', (view_id,))]\n   112\t    switches = [dict(r) for r in views_db.execute('select open, reason, after_seq from view_switches where view_id=? order by id', (view_id,))\n   113\t                if _visible(views_db, r['after_seq'], as_of)]\n   114\t    for switch in switches:\n   115\t        switch['day'] = service.day_of_seq(views_db, switch['after_seq'])\n   116\t    judgements = []\n   117\t    for j in views_db.execute('select * from judgements where view_id=? order by judgement_id', (view_id,)):\n   118\t        if as_of is not None and j['publication_day'] > as_of:\n   119\t            continue\n   120\t        judgements.append({'id': str(j['judgement_id']), 'day': j['publication_day'], 'seq': j['seq'], 'rung': j['rung'], 'changed': bool(j['changed']),\n   121\t                           'why_changed': j['why_changed'], 'reasons': j['reasons'], 'cited': list(dict.fromkeys(json.loads(j['cited_evidence_json'] or '[]'))),   # each id once (UI contract uniqueItems); the sealed 2026-10-28 ledger holds one judgement citing an id twice\n   122\t                           'cited_views': json.loads(j['cited_views_json'] or '[]'), 'pushes': json.loads(j['pushes_json'] or '[]'),\n   123\t                           'from_item': j['input_id']})\n   124\t    evidence = []\n   125\t    for e in views_db.execute('select e.*, l.seq as linked_seq from evidence_links l join evidence e on e.evidence_id=l.evidence_id where l.view_id=? order by l.id', (view_id,)):\n   126\t        if not _visible(views_db, e['linked_seq'], as_of):\n   127\t            continue\n   128\t        sources = [dict(s) for s in views_db.execute('select input_id, publication_day, seq from evidence_sources where evidence_id=? order by id', (e['evidence_id'],))\n   129\t                   if _visible(views_db, s['seq'], as_of)]\n   130\t        replaced_by = views_db.execute('select new_evidence_id, said_day, seq from replacements where old_evidence_id=? order by id desc limit 1', (e['evidence_id'],)).fetchone()\n   131\t        if replaced_by is not None and not _visible(views_db, replaced_by['seq'], as_of):\n   132\t            replaced_by = None\n   133\t        replaces = views_db.execute('select old_evidence_id, seq from replacements where new_evidence_id=?', (e['evidence_id'],)).fetchone()\n   134\t        if replaces and not _visible(views_db, replaces['seq'], as_of):\n   135\t            replaces = None\n   136\t        first = sources[0] if sources else {'input_id': e['created_from_input'], 'publication_day': '', 'seq': e['created_seq']}\n   137\t        item = item_of(first['input_id'])\n   138\t        evidence.append({'id': e['evidence_id'], 'one_line': e['one_line'], 'quote': e['quote'], 'tier': e['tier'], 'speaker': e['speaker'],\n   139\t                         'original_who': e['original_who'], 'original_day': e['original_day'], 'event_time': e['event_time'],\n   140\t                         'day': first['publication_day'] or item['publication_day'], 'seq': first['seq'], 'linked_seq': e['linked_seq'],\n   141\t                         'arrival_day': service.day_of_seq(views_db, e['linked_seq']),\n   142\t                         'source': {'title': item['title'], 'publisher': item['publisher'], 'publisher_type': item['publisher_type'],\n   143\t                                    'category': item['category'], 'uri': item['source_uri']},\n   144\t                         'sources': [{'input_id': s['input_id'], 'day': s['publication_day'],\n   145\t                                      'arrival_day': service.day_of_seq(views_db, s['seq']),\n   146\t                                      'source': item_of(s['input_id'])} for s in sources],\n   147\t                         'outlets': len(sources), 'replaced_by': {'new_evidence_id': replaced_by['new_evidence_id'], 'said_day': replaced_by['said_day'],\n   148\t                                                               'day': service.day_of_seq(views_db, replaced_by['seq'])} if replaced_by else None,\n   149\t                         'replaces': replaces['old_evidence_id'] if replaces else None})\n   150\t    dependencies = [dict(r) for r in views_db.execute('select dependency_id, depends_on, direction, wait_chain_view_id, wait_year, seq from dependencies where view_id=? order by dependency_id', (view_id,))\n   151\t                    if _visible(views_db, r['seq'], as_of)]\n   152\t    for dependency in dependencies:\n   153\t        dependency['day'] = service.day_of_seq(views_db, dependency['seq'])\n   154\t        dependency['resolutions'] = [dict(target=r['resolved_to'], day=service.day_of_seq(views_db, r['seq']), seq=r['seq'])\n   155\t                                    for r in views_db.execute('select resolved_to, seq from dependency_resolutions where dependency_id=? order by id', (dependency['dependency_id'],))\n   156\t                                    if _visible(views_db, r['seq'], as_of)]\n   157\t    dependants = sorted({r['view_id'] for r in views_db.execute('select view_id, seq from dependencies where depends_on=?', (view_id,)) if _visible(views_db, r['seq'], as_of)},\n   158\t                        key=lambda s: (len(s), s))\n   159\t    created = item_of(v['created_from_input'])\n   160\t    key = store.view_key(views_db, view_id)\n   161\t    identity = {name: key[name] for name in ('measure', 'scope', 'period_start', 'period_end', 'basis', 'unit', 'event_type')} if key else None\n   162\t    successions = [{'thesis_id': r['succeeds'] if r['view_id'] == view_id else r['view_id'],\n   163\t                    'relation': 'previous' if r['view_id'] == view_id else 'next',\n   164\t                    'day': service.day_of_seq(views_db, r['seq'])}\n   165\t                   for r in views_db.execute('select * from successions where view_id=? or succeeds=? order by id', (view_id, view_id))\n   166\t                   if _visible(views_db, r['seq'], as_of)]\n   167\t    return {'view_id': view_id, 'object': v['object_id'], 'kind': v['kind'], 'looks_at': v['looks_at'], 'question': v['question'],\n   168\t            'due_day': v['due_day'], 'year': v['year'], 'identity': identity, 'successions': successions,\n   169\t            'created_seq': v['created_seq'], 'created_day': service.day_of_seq(views_db, v['created_seq']),\n   170\t            'created_from': {'title': created['title'], 'publisher': created['publisher'], 'category': created['category']},\n   171\t            'rungs': rungs, 'open': not any(not s['open'] for s in switches), 'switches': switches,\n   172\t            'judgements': judgements, 'evidence': evidence, 'dependencies': dependencies, 'dependants': dependants,\n   173\t            'not_judged': not_judged(views_db, view_id, v['created_seq'], as_of),\n   174\t            **dict(zip(('answer_shape', 'favourable_end'), answer_shape(views_db, view_id)))}\n   175\t\n   176\t\n   177\tdef days(views_db, as_of=None):\n   178\t    \"\"\"The completed days the front end's time axis runs over, up to as_of.\"\"\"\n   179\t    as_of = service.resolve_bound(views_db, as_of, unfiltered=True)\n   180\t    return [r[0] for r in views_db.execute('select day from days_completed order by day') if as_of is None or r[0] <= as_of]\n   181\t\n   182\t\n   183\tdef _bundles(views_db, items_db, view_ids, as_of=None, coverage='selection'):\n   184\t    \"\"\"Complete, dated UI inputs for caller-selected theses; no search, model call or ledger write. Its bound is already resolved\n   185\t    by its caller (`thesis_bundles`, `library`).\"\"\"\n   186\t    date.fromisoformat(as_of)\n   187\t    if not isinstance(view_ids, list) or not view_ids or any(not isinstance(id, str) or not id for id in view_ids):\n   188\t        raise ValueError('thesis_bundles needs a non-empty list of view ids')\n   189\t    lookup = item_lookup(items_db)\n   190\t    records = []\n   191\t    for view_id in dict.fromkeys(view_ids):\n   192\t        row = views_db.execute('select * from views where view_id=?', (view_id,)).fetchone()\n   193\t        if row is None or not service.view_exists(views_db, row, as_of):\n   194\t            raise KeyError(f'{view_id} is not available as of {as_of}')\n   195\t        records.append(view_bundle(views_db, lookup, view_id, as_of))\n   196\t    return {'as_of': as_of, 'days': days(views_db, as_of), 'views': records,\n   197\t            'coverage': coverage, 'groups': research_groups(views_db, view_ids, as_of)}\n   198\t\n   199\t\n   200\tdef research_groups(conn, view_ids, as_of):\n   201\t    \"\"\"Stored groups, with dated memberships limited to the envelope's loaded theses.\"\"\"\n   202\t    if not conn.execute('pragma table_info(thesis_groups)').fetchone():\n   203\t        return []\n   204\t    loaded = set(view_ids)\n   205\t    result = []\n   206\t    for row in conn.execute('select * from thesis_groups order by created_seq, rowid'):\n   207\t        if not service.visible(conn, row['created_seq'], as_of):\n   208\t            continue\n   209\t        members = [{'thesis_id': m['view_id'], 'day': service.day_of_seq(conn, m['seq']), 'basis': m['basis'] or ''}\n   210\t                   for m in conn.execute('select * from thesis_group_members where group_id=? order by id', (row['group_id'],))\n   211\t                   if m['view_id'] in loaded and service.visible(conn, m['seq'], as_of)]\n   212\t        if members:\n   213\t            result.append({'id': row['group_id'], 'name': row['name'], 'scope': row['scope'],\n   214\t                           'aliases': json.loads(row['aliases'] or '[]') if 'aliases' in row.keys() else [],\n   215\t                           'created_day': service.day_of_seq(conn, row['created_seq']), 'members': members})\n   216\t    return result\n   217\t\n   218\t\n   219\tdef thesis_bundles(views_db, items_db, view_ids, as_of=None):\n   220\t    \"\"\"Selected complete thesis records, pinned to one read transaction.\"\"\"\n   221\t    with read_snapshot(views_db, items_db):\n   222\t        return _bundles(views_db, items_db, view_ids, service.resolve_bound(views_db, as_of))\n   223\t\n   224\t\n   225\tdef library(views_db, items_db, as_of=None):\n   226\t    \"\"\"All theses, including closed ones, and stored groups; no search or model call.\"\"\"\n   227\t    with read_snapshot(views_db, items_db):\n   228\t        as_of = service.resolve_bound(views_db, as_of)\n   229\t        if not as_of:\n   230\t            raise ValueError('The library has no completed day; supply as_of')\n   231\t        date.fromisoformat(as_of)\n   232\t        view_ids = [r['view_id'] for r in views_db.execute('select * from views order by created_seq, rowid')\n   233\t                    if service.view_exists(views_db, r, as_of)]\n   234\t        if not view_ids:\n   235\t            return {'as_of': as_of, 'days': days(views_db, as_of), 'views': [], 'coverage': 'library', 'groups': []}\n   236\t        return _bundles(views_db, items_db, view_ids, as_of, coverage='library')\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_15","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba docs/DECISIONS-log.md | sed -n '10991,11010p;11823,11906p'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba docs/DECISIONS-log.md | sed -n '10991,11010p;11823,11906p'\"","aggregated_output":" 10991\t## D726 · 2026-11-22 · Alex opens a judge version for related number questions ($0 gate first) and agrees to \"Forecast unavailable\" as the first-release interim\n 10992\t\n 10993\t- **The questions** (after D725):\n 10994\t  - \"要不要开一个新的判官版本来试修法（相关的题合在一次里算，每个数字标明出处，程序检查算术和出处）？\" Options: 开，先做 0 元那一关\n 10995\t    (recommended: the format and checks designed and through the council, then the $0 gate on five stored cases, four gold controls and\n 10996\t    three planted errors; the paid gate asks Alex for its ceiling); 先不开.\n 10997\t  - \"第一版上线前的过渡：数字题只显示问题和来源，档位和预测文字写成'预测暂缺'，等通过检查再放出来。你同意这个做法吗？\" Options: 同意\n 10998\t    (recommended); 暂不定.\n 10999\t- **Alex's answers** (2026-11-22): \"开，先做 0 元那一关 (推荐)\"; \"同意 (推荐)\".\n 11000\t- **Decided (Alex):**\n 11001\t  - A new judge version is opened for the bounded test of D725: related number questions judged together, with labelled figures and\n 11002\t    code checks of identity and arithmetic. It is designed and reviewed at $0, then the $0 gate runs. The paid gate needs Alex's\n 11003\t    ceiling.\n 11004\t  - Until the number answers pass, a first release shows number questions with their sources and \"Forecast unavailable\": the band, the\n 11005\t    forecast text and its history withheld together. It is built with the release work, which is not started.\n 11006\t- poc-v118 stays the product.\n 11007\t\n 11008\t## D727 · 2026-11-22 · judging-v13's $0 gate: the design passed council (round 46e); gate runs 1–6 and council rounds 46f–46j; the gate is not yet passed; one choice goes to Alex\n 11009\t\n 11010\t- **Design:** `docs/research/2026-11-22-number-answers/DESIGN.md`, v1 to v9. Council rounds 46 to 46e reached READY FOR THE $0 GATE on v5.\n 11823\t## D756 · 2026-11-23 · Alex closes the v13s line; the first release shows number questions as \"Forecast unavailable\"\n 11824\t\n 11825\t- **The question** (after D755): \"付费重发的结论是“停”：luna 在新格式下格式错误多（36 个首发里 22 个被拒），在说不清的题上还会硬给数；不过“两题合在一起算”确实避免了自相矛盾。数字题这条线下一步怎么走？\"\n 11826\t  - Options:\n 11827\t    - \"结束这条线，预测暂缺上线 (推荐)\": the council's consensus;\n 11828\t    - \"换更强的模型再小测一次\": a stronger model or higher effort, with a small paid probe and a cap Alex names;\n 11829\t    - \"先停，我想谈谈\".\n 11830\t- **Alex's answer** (2026-11-23): \"结束这条线，预测暂缺上线 (推荐)\".\n 11831\t- **Decided (Alex):**\n 11832\t  - The v13s judge line ends at its STOP. Nothing from it enters the product, and poc-v118 stays the product (D690).\n 11833\t  - The first release carries D726: number questions show the question and its sources with \"Forecast unavailable\", the band, the\n 11834\t    forecast text and the history withheld together.\n 11835\t  - The one next step, when release work opens, is a $0 check of the reader's screen on a stored number question that has a\n 11836\t    forecast and history: only the question, its sources and \"Forecast unavailable\" appear.\n 11837\t- **Kept for the record, not built:**\n 11838\t  - the D725 consistency finding (separate answers contradicted each other in 8 of 9 pairs, joint answers in none);\n 11839\t  - the open checker defects in `PAID-V13S-RESULT.md` §5;\n 11840\t  - the v13s request and harness in `docs/research/2026-11-22-number-answers/`.\n 11841\t\n 11842\t## D757 · 2026-11-23 · Toward production: the \"Forecast unavailable\" release design is ready for when Alex opens release work (council 72–72d); two choices go to Alex\n 11843\t\n 11844\t- **Why.** Alex's direction tonight was to converge and head toward production (D750), and he chose to release with \"Forecast\n 11845\t  unavailable\" (D756). D726 says it \"is built with the release work, which is not started\". Council 72 agreed that opening release\n 11846\t  work is Alex's call, so tonight's step is the design, not the build.\n 11847\t- **The gap, measured at $0** (`docs/research/2026-11-22-number-answers/FORECAST-UNAVAILABLE-DESIGN.md` §1):\n 11848\t  - today every reader of a number question can see its forecast: the service, the idea input, the closing text;\n 11849\t  - Yes/No and event explanations can quote number forecasts (`old-3/v36` judgement 799, `old-1/v10` judgement 865).\n 11850\t- **The design, after four review rounds** (`codex-r72.md` … `codex-r72d.md`):\n 11851\t  - one release exporter with an explicit allow-list, called directly by the release builder; the finished package is checked;\n 11852\t  - for a number question, the allow-list holds only the question, its sources and \"Forecast unavailable\";\n 11853\t  - the release reads nothing else: no live POC service, no translated or prepared JSON, no composite trials;\n 11854\t  - identity is structural: a question is a number question unless it is an event measure or a canonical Yes/No pair, and unresolved\n 11855\t    records are withheld and listed. Verified on four stores with no wrong result;\n 11856\t  - tests, mutants and an end-to-end acceptance on `old-1/v8` and the two known event leaks.\n 11857\t  - **Why an allow-list.** Rounds 72 and 72b each found new leak paths in a reader-by-reader design, so revision 3 replaced that\n 11858\t    approach with one structural rule.\n 11859\t- **Open for Alex:**\n 11860\t  1. whether to open release work now (then: build to this design, then the $0 release check);\n 11861\t  2. what questions that are not number questions show in the release:\n 11862\t     - (a) answer and label without explanation text, recommended by the council and Claude;\n 11863\t     - (b) explanations only where the judge was shown no number question's state: 21 of 85 questions at the latest answer, and it\n 11864\t       cannot guarantee that no number forecast is quoted.\n 11865\t- **Not done.** Nothing is built and nothing is committed. The POC is unchanged.\n 11866\t\n 11867\t## D758 · 2026-11-23 · Under D439 the council opens local release work for \"Forecast unavailable\"; non-number questions show no explanation text (§4 a); the v13s checker defects are closed as won't-fix (council 73)\n 11868\t\n 11869\t- **Why the council decides.** Alex is asleep and delegated tonight's decisions (D750: \"这边的决策交给你，还有 Council … 准备要往\n 11870\t  Production 方向去走了\"). He had already chosen the behaviour (D726 \"同意\"; D756 \"结束这条线，预测暂缺上线\"). D757 left two\n 11871\t  choices for him; under D439 a choice that would go to Alex goes to the council when it is reversible and within the limits.\n 11872\t- **Council round 73** (`docs/research/2026-11-22-number-answers/round73-brief.md`, `codex-r73.md`, `claude-r73.md`), consensus:\n 11873\t  1. **Release work opens tonight, local and at $0:** the exporter, the release builder, the package check, tests and mutants, the $0\n 11874\t     release check. Nothing committed, pushed, published or deployed; the POC and colleagues' page unchanged. Reversible: the package\n 11875\t     can be deleted without touching what the POC serves. D726's \"not started\" described the state on 2026-11-22 and set no gate.\n 11876\t  2. **§4 (a):** an event or Yes/No question shows its question, evidence and answer with its original label, and no generated\n 11877\t     explanation. It alone guarantees no number forecast reaches a reader through prose (option (b) cannot: a request carries the\n 11878\t     question's earlier reasoning, `views/judging.py:211`). The cost is real: readers lose the written rationale for those answers.\n 11879\t  3. **The v13s checker defects** (`PAID-V13S-RESULT.md` §5) are closed as won't-fix: `calc_small.py` has callers only in research\n 11880\t     code, the line is closed (D756), and the STOP bars tuning on the 36 answers. The findings stay on record.\n 11881\t  4. **Order:** the exporter and the checked package first; the reader's screen second (it completes D756's screen check). How the\n 11882\t     idea path enters the release is settled in the build design's review (round 74).\n 11883\t- **Still Alex's:** commit, push, publish, deploy, colleagues' POC page, any paid send or judge work.\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_16","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba src/hivemind/service.py | sed -n '195,295p'; rg -n 'def ladder_bands|def open_read_only|def rungs_of|def view_key|def canonical|EVENT_MEASURES' src/hivemind/{service.py,vocabulary.py,views/store.py,views/identity.py}\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba src/hivemind/service.py | sed -n '195,295p'; rg -n 'def ladder_bands|def open_read_only|def rungs_of|def view_key|def canonical|EVENT_MEASURES' src/hivemind/{service.py,vocabulary.py,views/store.py,views/identity.py}\"","aggregated_output":"   195\t    direct = [r['view_id'] for r in conn.execute('select view_id, seq from dependencies where depends_on=?', (view_id,)) if visible(conn, r['seq'], as_of)]\n   196\t    resolved = [r['view_id'] for r in conn.execute('select d.view_id, r.seq from dependency_resolutions r join dependencies d on d.dependency_id=r.dependency_id where r.resolved_to=?', (view_id,)) if visible(conn, r['seq'], as_of)]\n   197\t    return sorted(set(direct + resolved))\n   198\t\n   199\t\n   200\tdef view(conn, view_id, as_of=None, record=None):\n   201\t    as_of = resolve_bound(conn, as_of)\n   202\t    record = record or store.view(conn, view_id)\n   203\t    if not record or not view_exists(conn, record, as_of):\n   204\t        return None\n   205\t    rungs = store.rungs_of(conn, view_id)\n   206\t    state = state_as_of(conn, view_id, as_of)\n   207\t    if state:\n   208\t        rung = next((r for r in rungs if r['position'] == state['position']), None)\n   209\t        state['label'] = rung['label'] if rung else None\n   210\t        state['condition'] = rung['condition'] if rung else None\n   211\t    in_force = evidence(conn, view_id, as_of)\n   212\t    return {\n   213\t        'view_id': view_id, 'object': record['object_id'], 'object_kind': record['object_kind'], 'kind': record['kind'],\n   214\t        'looks_at': record['looks_at'], 'question': record['question'], 'due_day': record['due_day'], 'year': record['year'],\n   215\t        'created_day': day_of_seq(conn, record['created_seq']), 'created_from': record['created_from_input'],\n   216\t        'as_of': as_of, 'open': is_open_as_of(conn, view_id, as_of), 'rungs': rungs, 'state': state,\n   217\t        'dependencies': dependencies(conn, view_id, as_of), 'dependants': dependants(conn, view_id, as_of),\n   218\t        'counts': {'rounds': state['rounds'] if state else 0, 'evidence': len(in_force), 'facts': sum(1 for e in in_force if vocabulary.canonical('tier', e['tier']) == TIER_FACT)},\n   219\t    }\n   220\t\n   221\t\n   222\t# ---------- evidence\n   223\t\n   224\tdef evidence_record(conn, evidence_id, as_of, arrived_seq=None):\n   225\t    \"\"\"One piece of evidence with only the sources recorded on or before the day (a later outlet of the same\n   226\t    sentence is not yet known on that day).\"\"\"\n   227\t    piece = store.evidence(conn, evidence_id)\n   228\t    if not piece:\n   229\t        return None\n   230\t    sources = [dict(s) for s in conn.execute('select input_id, category, publication_day, seq from evidence_sources where evidence_id=? order by id', (evidence_id,)) if visible(conn, s['seq'], as_of)]\n   231\t    replaces = conn.execute('select old_evidence_id, seq from replacements where new_evidence_id=?', (evidence_id,)).fetchone()\n   232\t    return {'evidence_id': piece['evidence_id'], 'one_line': piece['one_line'], 'quote': piece['quote'], 'tier': piece['tier'],\n   233\t            'speaker': piece['speaker'], 'original_who': piece['original_who'], 'original_day': piece['original_day'], 'event_time': piece['event_time'],\n   234\t            'day': day_of_seq(conn, arrived_seq if arrived_seq is not None else piece['created_seq']), 'sources': sources, 'outlets': len(sources),\n   235\t            'replaces': replaces['old_evidence_id'] if replaces and visible(conn, replaces['seq'], as_of) else None}\n   236\t\n   237\t\n   238\tdef evidence(conn, view_id, as_of=None, tier=None):\n   239\t    \"\"\"Evidence linked to the view on or before the day and not replaced on or before it, with its sources.\"\"\"\n   240\t    as_of = resolve_bound(conn, as_of)\n   241\t    out = []\n   242\t    for link in conn.execute('select evidence_id, seq from evidence_links where view_id=? order by id', (view_id,)):\n   243\t        if not visible(conn, link['seq'], as_of):\n   244\t            continue\n   245\t        replacement = conn.execute('select new_evidence_id, said_day, seq from replacements where old_evidence_id=? order by id desc limit 1', (link['evidence_id'],)).fetchone()\n   246\t        if replacement and visible(conn, replacement['seq'], as_of):\n   247\t            continue\n   248\t        piece = evidence_record(conn, link['evidence_id'], as_of, link['seq'])\n   249\t        if tier and piece['tier'] != tier:\n   250\t            continue\n   251\t        out.append(piece)\n   252\t    return out\n   253\t\n   254\t\n   255\t# ---------- history\n   256\t\n   257\tdef history(conn, view_id, from_day=None, to_day=None):\n   258\t    to_day = resolve_range(conn, from_day, to_day)\n   259\t    from_day = from_day or '0000-00-00'\n   260\t    judgements = []\n   261\t    previous = None\n   262\t    for row in conn.execute('select * from judgements where view_id=? order by judgement_id', (view_id,)):\n   263\t        entry = {'day': row['publication_day'], 'seq': row['seq'], 'position': row['rung'], 'changed': bool(row['changed']), 'moved_from': previous if previous is not None and previous != row['rung'] else None,\n   264\t                 'why_changed': row['why_changed'], 'reasons': row['reasons'], 'cited': _unique(_json(row['cited_evidence_json'])), 'pushes': _json(row['pushes_json']),\n   265\t                 'theme_pushes': _json(row['theme_pushes_json'] if 'theme_pushes_json' in row.keys() else None), 'round': row['input_id']}\n   266\t        previous = row['rung']\n   267\t        if from_day <= row['publication_day'] <= to_day:\n   268\t            judgements.append(entry)\n   269\t    arrivals = {}\n   270\t    for link in conn.execute('select evidence_id, seq from evidence_links where view_id=?', (view_id,)):\n   271\t        day = day_of_seq(conn, link['seq'])\n   272\t        if day and from_day <= day <= to_day:\n   273\t            piece = store.evidence(conn, link['evidence_id'])\n   274\t            bucket = arrivals.setdefault(day, {'evidence': 0, 'facts': 0})\n   275\t            bucket['evidence'] += 1\n   276\t            bucket['facts'] += int(vocabulary.canonical('tier', piece['tier']) == TIER_FACT)\n   277\t    replacements = [{'day': day_of_seq(conn, r['seq']), 'old': r['old_evidence_id'], 'new': r['new_evidence_id'], 'said_day': r['said_day']}\n   278\t                    for r in conn.execute('select r.* from replacements r join evidence_links l on l.evidence_id=r.new_evidence_id where l.view_id=?', (view_id,))\n   279\t                    if day_of_seq(conn, r['seq']) and from_day <= day_of_seq(conn, r['seq']) <= to_day]\n   280\t    switches = [{'day': day_of_seq(conn, s['after_seq']), 'open': bool(s['open']), 'reason': s['reason']}\n   281\t                for s in conn.execute('select * from view_switches where view_id=? order by id', (view_id,)) if day_of_seq(conn, s['after_seq']) and from_day <= day_of_seq(conn, s['after_seq']) <= to_day]\n   282\t    return {'view_id': view_id, 'from_day': from_day, 'to_day': to_day, 'judgements': judgements,\n   283\t            'changes': [j for j in judgements if j['moved_from'] is not None], 'arrivals': dict(sorted(arrivals.items())),\n   284\t            'replacements': replacements, 'switches': switches}\n   285\t\n   286\t\n   287\tclass LedgerError(ValueError):\n   288\t    \"\"\"A ledger record the service cannot read (corrupt JSON): refused, never read as empty.\"\"\"\n   289\t\n   290\t\n   291\tclass StoreUnreadable(LedgerError):\n   292\t    \"\"\"The store could not be opened, or its read transaction begun and pinned (live-service/OPERATING-CONTRACT.md, row 1): named by\n   293\t    its path, never answered with an empty or stale state.\"\"\"\n   294\t\n   295\t\nsrc/hivemind/views/identity.py:10:EVENT_MEASURES = ('event', 'policy_event')\nsrc/hivemind/views/identity.py:15:    return value.get('measure') not in (None, 'other', *EVENT_MEASURES) and (value.get('scope_source') == 'shared' or value.get('opens_as') in SHARED_REASONS)\nsrc/hivemind/views/identity.py:29:    if value['measure'] in EVENT_MEASURES and value.get('event_type') in (None, 'other', 'n/a'):\nsrc/hivemind/views/identity.py:55:    if key['measure'] != candidate['measure'] and not (key['measure'] in EVENT_MEASURES and candidate['measure'] in EVENT_MEASURES):\nsrc/hivemind/views/identity.py:69:    if key['measure'] in EVENT_MEASURES:\nsrc/hivemind/views/store.py:97:def rungs_of(conn, view_id):\nsrc/hivemind/views/store.py:159:def view_key(conn, view_id):\nsrc/hivemind/views/store.py:223:def open_read_only(path):\nsrc/hivemind/vocabulary.py:28:def canonical(field, value):\nsrc/hivemind/service.py:499:def ladder_bands(rungs):\n","exit_code":0,"status":"completed"}}
