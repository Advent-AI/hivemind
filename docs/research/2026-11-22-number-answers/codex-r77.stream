{"type":"item.completed","item":{"id":"item_23","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"rg -n 'missing page|read once|_read_regular|missing.*file|missing.*index' tests/test_release.py; nl -ba tests/test_release.py | sed -n '300,330p;425,465p'; nl -ba docs/research/2026-11-22-number-answers/release_check.py | sed -n '22,42p;125,149p;181,213p;260,290p'\"","aggregated_output":"312:        'missing page': (lambda p: (p / 'index.html').unlink(), lambda p: f\"{p}: holds ['manifest.json', 'release-data.json'], {files}\"),\n   300\t# ---------- §6 tests 9, 10, 13, 15, 16: the package and the origin check\n   301\t\n   302\t\n   303\tdef test_9_package_files_hash_and_manifest(stores, tmp_path):\n   304\t    \"\"\"§1 check_package, §6 test 9.\"\"\"\n   305\t    out = tmp_path / 'release'\n   306\t    data = build_package(stores, out)\n   307\t    assert check(stores, out)['fields_compared'] > 0\n   308\t    files = \"not exactly ['index.html', 'manifest.json', 'release-data.json']\"\n   309\t    variants = {\n   310\t        'foreign file': (lambda p: (p / 'notes.txt').write_text('x'), lambda p: f\"{p}: holds ['index.html', 'manifest.json', 'notes.txt', 'release-data.json'], {files}\"),\n   311\t        'subdirectory': (lambda p: (p / 'extra').mkdir(), lambda p: f\"{p}: holds ['extra', 'index.html', 'manifest.json', 'release-data.json'], {files}\"),\n   312\t        'missing page': (lambda p: (p / 'index.html').unlink(), lambda p: f\"{p}: holds ['manifest.json', 'release-data.json'], {files}\"),\n   313\t        'changed byte': (lambda p: (p / release.DATA_FILE).write_bytes((p / release.DATA_FILE).read_bytes().replace(b'Morningstar', b'Morningstan')),\n   314\t                         lambda p: 'the manifest sha256 does not match the data file'),\n   315\t        'manifest prose': (lambda p: (p / release.MANIFEST_FILE).write_text(json.dumps({**json.loads((p / release.MANIFEST_FILE).read_text()), 'note': 'About $390 billion'})),\n   316\t                           lambda p: \"the manifest: keys off the allow-list ['note'], missing []\"),\n   317\t        'manifest day': (lambda p: (p / release.MANIFEST_FILE).write_text(json.dumps({**json.loads((p / release.MANIFEST_FILE).read_text()), 'as_of': DAYS[0]})),\n   318\t                         lambda p: f\"the manifest as_of '{DAYS[0]}' differs from the data '{DAYS[2]}'\"),\n   319\t    }\n   320\t    for name, (damage, message) in variants.items():\n   321\t        copy = tmp_path / f'copy-{name.replace(\" \", \"-\")}'\n   322\t        shutil.copytree(out, copy)\n   323\t        damage(copy)\n   324\t        refused_with(lambda: check(stores, copy), message(copy))\n   325\t    with pytest.raises(FileExistsError):\n   326\t        staged = release.stage(out)\n   327\t        release.write_package(data, staged)\n   328\t        release.publish(staged, out)\n   329\t    (tmp_path / '.other.staging-x').mkdir()            # another build's debris blocks nothing\n   330\t    assert build_package(stores, tmp_path / 'other')\n   425\t    os.mkfifo(piped / release.DATA_FILE)\n   426\t    result = run('check', piped, '--ledger', stores[0], '--items', stores[1], timeout=30)      # a blocking open would hang here\n   427\t    assert result.returncode == 1\n   428\t    stderr_line(result, f'refused: ReleaseRefused: {piped}/release-data.json: not a regular file')\n   429\t\n   430\t\n   431\tdef test_16_the_day_must_be_valid_and_canonical(stores):\n   432\t    \"\"\"§2 day rows, §6 test 16.\"\"\"\n   433\t    refused_with(lambda: export(stores, '2026-08-99'), \"not a day: '2026-08-99'\")\n   434\t    with pytest.raises(release.ReleaseRefused) as caught:      # Python 3.10 refuses the spelling as a day; 3.11+ reads it, and the canonical rule refuses it\n   435\t        export(stores, '20260825')\n   436\t    assert str(caught.value) in (\"not a day: '20260825'\", \"a day must be written YYYY-MM-DD: '20260825'\")\n   437\t    assert [e['id'] for e in by_id(export(stores, '2026-08-25'))['v1']['evidence']] == ['e1', 'e4']\n   438\t    views_db = service.open_ledger(str(stores[0]))\n   439\t    try:\n   440\t        refused_with(lambda: release.resolve(views_db, '2026-08-27'), 'day not completed: 2026-08-27 is after the last completed day 2026-08-26', service.BoundNotCompleted)\n   441\t    finally:\n   442\t        views_db.close()\n   443\t\n   444\t\n   445\tdef test_16_a_day_before_the_first_question_gives_an_empty_package(stores):\n   446\t    \"\"\"§2 row \"valid day before the first visible question\", §6 test 16: the store's questions open on 08-24.\"\"\"\n   447\t    data = export(stores, '2026-08-23')\n   448\t    assert data['as_of'] == '2026-08-23' and data['questions'] == []\n   449\t\n   450\t\n   451\t# ---------- §6 tests 11, 17, 18: the command\n   452\t\n   453\t\n   454\tdef test_11_command_end_to_end_with_check_statuses(stores, tmp_path):\n   455\t    \"\"\"§1 the builder and check, §6 test 11.\"\"\"\n   456\t    out = tmp_path / 'release'\n   457\t    built = run('build', '--ledger', stores[0], '--items', stores[1], '--out', out)\n   458\t    assert built.returncode == 0, built.stderr\n   459\t    report = out.with_name('release.report.json')\n   460\t    written = json.loads(report.read_text())\n   461\t    assert set(written) == REPORT_KEYS and (written['ledger'], written['items'], written['as_of']) == (str(stores[0]), str(stores[1]), DAYS[2])\n   462\t    assert written['counts'] == FIXTURE_COUNTS and written['withheld_unresolved'] == FIXTURE_UNRESOLVED and written['data_bytes'] == FIXTURE_DATA_BYTES\n   463\t    assert written['export_seconds'] >= 0 and written['check_seconds'] >= 0\n   464\t    occupied = run('check', out, '--ledger', stores[0], '--items', stores[1])\n   465\t    assert occupied.returncode == 2 and occupied.stdout.startswith(f'passes {out}: ')\n    22\tCOMMAND = REPO / 'scripts' / 'release_build.py'\n    23\tMARKER = 'Forecast unavailable'                     # D726's words, written here, not read from the module under test\n    24\tFORMAT, ALLOW_LIST = 'hivemind-release/2', 'release-allow-list/1'   # RELEASE-PAGE.md's identifiers, written here, not read from the module\n    25\tDATED = {'old-3/v36@2026-08-25': ('2026-08-25', 3239), 'old-1/v10@2026-08-28': ('2026-08-28', 5673)}   # each dated package's day and evidence\n    26\tEXPECTED = {   # each store's default day, classes and evidence, fixed before this run from the reviewed first run (councils 75–75e reproduced them)\n    27\t    'old-1': ('2026-09-20', {'number': 19, 'event': 28, 'yes_no': 0}, 8251),\n    28\t    'old-2': ('2026-09-20', {'number': 17, 'event': 26, 'yes_no': 0}, 6306),\n    29\t    'old-3': ('2026-09-20', {'number': 18, 'event': 31, 'yes_no': 0}, 6659),\n    30\t    'served': ('2026-08-28', {'number': 13, 'event': 55, 'yes_no': 0}, 6461),\n    31\t}\n    32\tJ1580_PREFIX = 'About $390 billion: $164 billion reported in the first half'   # the system's own forecast used as the forged value\n    33\tCLOSING_REASON = 'due 2026-09-20, frozen on 2026-09-20 at rung 2 Bullish'\n    34\tCOMPARISON_ITEMS = REPO / 'poc/data/comparison-2026-11-17/items-comparison.sqlite'\n    35\tSTORES = {\n    36\t    'old-1': (REPO / 'poc/data/comparison-2026-11-17/run/old-1/prod/views.sqlite', COMPARISON_ITEMS),\n    37\t    'old-2': (REPO / 'poc/data/comparison-2026-11-17/run/old-2/prod/views.sqlite', COMPARISON_ITEMS),\n    38\t    'old-3': (REPO / 'poc/data/comparison-2026-11-17/run/old-3/prod/views.sqlite', COMPARISON_ITEMS),\n    39\t    'served': (REPO / 'poc/data/served-2026-10-28-v34-nvda-3m-through-0828/views.sqlite', REPO / 'poc/data/items-nvda-2026-07-01-10-27.sqlite'),\n    40\t}\n    41\t\n    42\t\n   125\t    return {q['id']: q for q in data['questions']}\n   126\t\n   127\t\n   128\tdef refresh(package, data=None, manifest_extra=None):\n   129\t    \"\"\"A forged copy made consistent everywhere but the store: its page made from the forged data again and both hashes refreshed, so\n   130\t    the store comparison is what must refuse it.\"\"\"\n   131\t    if data is not None:\n   132\t        payload = json.dumps(data, ensure_ascii=False, separators=(',', ':')).encode()\n   133\t        (package / release.DATA_FILE).write_bytes(payload)\n   134\t        (package / release.PAGE_FILE).write_bytes(release.render_page(payload))\n   135\t    manifest = json.loads((package / release.MANIFEST_FILE).read_text())\n   136\t    manifest['data_sha256'] = hashlib.sha256((package / release.DATA_FILE).read_bytes()).hexdigest()\n   137\t    manifest['page_sha256'] = hashlib.sha256((package / release.PAGE_FILE).read_bytes()).hexdigest()\n   138\t    manifest.update(manifest_extra or {})\n   139\t    (package / release.MANIFEST_FILE).write_text(json.dumps(manifest))\n   140\t\n   141\t\n   142\tdef refused(ledger, items, package):\n   143\t    try:\n   144\t        check(ledger, items, package)\n   145\t    except release.ReleaseRefused as error:\n   146\t        return str(error)\n   147\t    return None\n   148\t\n   149\t\n   181\t                  'Bullish confirmation would require firm procurement commitments for the SpaceX buildout and continued NVIDIA Data Center growth above 60% into fiscal 2028.'),\n   182\t        'e3597': ('The author says analysts estimate NVIDIA revenue of about $390 billion in calendar 2027 and over $550 billion in calendar 2028, with annual sales growth of roughly 24% to 25%.',\n   183\t                  'Analysts see revenue reaching about $390 billion in 2027 and more than $550 billion in 2028, with annual sales growth of roughly 24% to 25%.')}\n   184\t    kept = {}\n   185\t    for evidence_id in ('e2295', 'e1865', 'e3597'):              # the fixed examples: a missing one is a failure, not a smaller list\n   186\t        if evidence_id not in stored:\n   187\t            kept[evidence_id] = {'questions': [], 'equal_to_store': False, 'present': False}\n   188\t            continue\n   189\t        holders = [(q['id'], e) for q in data['questions'] for e in q['evidence'] if e['id'] == evidence_id]\n   190\t        kept[evidence_id] = {'questions': [h[0] for h in holders],\n   191\t                             'equal_to_store': all(e['one_line'] == stored[evidence_id]['one_line'] and e['quote'] == stored[evidence_id]['quote'] for _, e in holders) and bool(holders),\n   192\t                             'present': bool(holders),\n   193\t                             'holds_its_wording': bool(holders) and all((e['one_line'], e['quote']) == required_text[evidence_id] for _, e in holders)}\n   194\t    forged = out / 'old-1' / 'forged-summary'\n   195\t    shutil.copytree(package, forged)\n   196\t    changed = json.loads(json.dumps(data))\n   197\t    next(e for e in by_id(changed)['v8']['evidence'] if e['id'] == 'e2295')['one_line'] = implied\n   198\t    refresh(forged, changed)\n   199\t    prose = out / 'old-1' / 'forged-manifest'\n   200\t    shutil.copytree(package, prose)\n   201\t    refresh(prose, manifest_extra={'note': implied})\n   202\t    v8 = by_id(data)['v8']\n   203\t    results['decisive'] = {'kept': kept, 'implied_outcome_j1580': implied[:120],\n   204\t                           'substituted_into_e2295_refused': refused(ledger, items, forged),\n   205\t                           'added_to_manifest_refused': refused(ledger, items, prose),\n   206\t                           'unchanged_package_passes': check(ledger, items, package)['fields_compared']}\n   207\t    results['decisive']['forged_value_is_j1580'] = implied.startswith(J1580_PREFIX)\n   208\t    results['old-1/v8'] = {'class': v8['class'], 'forecast': v8['forecast'], 'evidence': len(v8['evidence']),\n   209\t                           'same_ids_as_service_evidence': [e['id'] for e in v8['evidence']] == in_force_v8}\n   210\t\n   211\t    leaks = {}\n   212\t    for name, view_id, day, judgement_id in (('old-3', 'v36', '2026-08-25', 799), ('old-1', 'v10', '2026-08-28', 865)):\n   213\t        ledger, items = STORES[name]\n   260\t    (out / 'results.json').write_text(json.dumps(results, ensure_ascii=False, indent=1))\n   261\t    print(json.dumps({k: v for k, v in results.items() if k != 'stores'}, ensure_ascii=False, indent=1))\n   262\t    failures = [f'{name}: {key}' for name, s in results['stores'].items() for key in ('bytes_within_budget', 'seconds_within_budget') if not s[key]]\n   263\t    for name in STORES:                                          # the delivered identifiers, data and manifest, against the literal ones\n   264\t        delivered = json.loads((out / name / 'package' / release.MANIFEST_FILE).read_text())\n   265\t        failures += [] if (packages[name]['format'], packages[name]['allow_list'], delivered['format'], delivered['allow_list']) == (FORMAT, ALLOW_LIST, FORMAT, ALLOW_LIST) else [f'{name}: format or allow-list']\n   266\t    failures += [f'{name}: day, classes or evidence' for name, (day, classes, evidence) in EXPECTED.items()\n   267\t                 if (results['stores'][name]['as_of'], results['stores'][name]['counts']['questions'], results['stores'][name]['counts']['evidence']) != (day, classes, evidence)]\n   268\t    failures += [] if results['decisive']['forged_value_is_j1580'] else ['the forged value is not the system forecast j1580']\n   269\t    decisive = results['decisive']\n   270\t    failures += [f'kept {e}' for e in ('e2295', 'e1865', 'e3597')\n   271\t                 if not (decisive['kept'].get(e, {}).get('present') and decisive['kept'][e]['equal_to_store'] and decisive['kept'][e]['holds_its_wording'])]\n   272\t    expected_reasons = {'substituted_into_e2295_refused': 'question v8.evidence e2295.one_line: differs from the store',\n   273\t                        'added_to_manifest_refused': \"the manifest: keys off the allow-list ['note'], missing []\"}   # exact, so another refusal (a stale hash) does not count\n   274\t    failures += [k for k, reason in expected_reasons.items() if decisive[k] != reason]\n   275\t    failures += [] if (results['old-1/v8']['same_ids_as_service_evidence'] and results['old-1/v8']['forecast'] == MARKER\n   276\t                       and results['old-1/v8']['class'] == 'number' and results['old-1/v8']['evidence'] == 1284) else ['old-1/v8']\n   277\t    for name, leak in results['leaks'].items():\n   278\t        failures += [f'{name}: {k}' for k in ('label_kept', 'why_changed_absent', 'reasons_absent') if not leak[k]]\n   279\t        failures += [] if leak['answer'] == 'Yes' else [f'{name}: answer']\n   280\t        failures += [] if (leak['package_as_of'], leak['manifest_as_of'], leak['evidence']) == (DATED[name][0], DATED[name][0], DATED[name][1]) else [f'{name}: package day or evidence']\n   281\t        failures += [] if leak['latest_judgement'] == leak['expected_judgement'] else [f'{name}: judgement']\n   282\t        failures += [f'{name}: {phrase} found' for phrase, hits in leak['phrase_fields'].items() if hits]\n   283\t    failures += [] if (results['control']['id'], results['control']['answer']) == ('v3', 'Yes') and results['control']['label_equals_store'] and results['control']['evidence_equals_store'] else ['control']\n   284\t    closing = results['closing']\n   285\t    failures += [] if closing['reason'] == CLOSING_REASON and closing['bundle_exposes_reason'] and closing['package_open'] is False and closing['reason_absent'] else ['closing']\n   286\t    if failures:\n   287\t        raise SystemExit(f'release check FAILED: {failures}')\n   288\t    print('release check: every acceptance item and budget met; diagnostic hits to read by hand:',\n   289\t          {name: len(s['diagnostics']['hits']) for name, s in results['stores'].items()})\n   290\t\n","exit_code":0,"status":"completed"}}
