{"type":"item.completed","item":{"id":"item_19","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"rg -n 'format|page|sha256|forg|results|failures' docs/research/2026-11-22-number-answers/release_check.py\"","aggregated_output":"7:every decoded package field; the size and speed budgets against `bundle.library` on the same store. Writes results.json there.\"\"\"\n32:J1580_PREFIX = 'About $390 billion: $164 billion reported in the first half'   # the system's own forecast used as the forged value\n129:    \"\"\"A forged copy made consistent everywhere but the store: its page made from the forged data again and both hashes refreshed, so\n134:        (package / release.PAGE_FILE).write_bytes(release.render_page(payload))\n136:    manifest['data_sha256'] = hashlib.sha256((package / release.DATA_FILE).read_bytes()).hexdigest()\n137:    manifest['page_sha256'] = hashlib.sha256((package / release.PAGE_FILE).read_bytes()).hexdigest()\n153:    results = {'stores': {}}\n161:        results['stores'][name] = {\n168:        print(name, json.dumps({k: v for k, v in results['stores'][name].items() if k not in ('unresolved', 'diagnostics')}), 'hits', len(results['stores'][name]['diagnostics']['hits']))\n194:    forged = out / 'old-1' / 'forged-summary'\n195:    shutil.copytree(package, forged)\n198:    refresh(forged, changed)\n199:    prose = out / 'old-1' / 'forged-manifest'\n203:    results['decisive'] = {'kept': kept, 'implied_outcome_j1580': implied[:120],\n204:                           'substituted_into_e2295_refused': refused(ledger, items, forged),\n207:    results['decisive']['forged_value_is_j1580'] = implied.startswith(J1580_PREFIX)\n208:    results['old-1/v8'] = {'class': v8['class'], 'forecast': v8['forecast'], 'evidence': len(v8['evidence']),\n228:    results['leaks'] = leaks\n236:    results['control'] = {'id': control['id'], 'answer': control['answer'], 'label_equals_store': control['answer'] == stored_label,\n257:    results['closing'] = {'reason': reason, 'bundle_exposes_reason': any(s.get('reason') == reason for s in exposed['switches']),\n260:    (out / 'results.json').write_text(json.dumps(results, ensure_ascii=False, indent=1))\n261:    print(json.dumps({k: v for k, v in results.items() if k != 'stores'}, ensure_ascii=False, indent=1))\n262:    failures = [f'{name}: {key}' for name, s in results['stores'].items() for key in ('bytes_within_budget', 'seconds_within_budget') if not s[key]]\n265:        failures += [] if (packages[name]['format'], packages[name]['allow_list'], delivered['format'], delivered['allow_list']) == (FORMAT, ALLOW_LIST, FORMAT, ALLOW_LIST) else [f'{name}: format or allow-list']\n266:    failures += [f'{name}: day, classes or evidence' for name, (day, classes, evidence) in EXPECTED.items()\n267:                 if (results['stores'][name]['as_of'], results['stores'][name]['counts']['questions'], results['stores'][name]['counts']['evidence']) != (day, classes, evidence)]\n268:    failures += [] if results['decisive']['forged_value_is_j1580'] else ['the forged value is not the system forecast j1580']\n269:    decisive = results['decisive']\n270:    failures += [f'kept {e}' for e in ('e2295', 'e1865', 'e3597')\n274:    failures += [k for k, reason in expected_reasons.items() if decisive[k] != reason]\n275:    failures += [] if (results['old-1/v8']['same_ids_as_service_evidence'] and results['old-1/v8']['forecast'] == MARKER\n276:                       and results['old-1/v8']['class'] == 'number' and results['old-1/v8']['evidence'] == 1284) else ['old-1/v8']\n277:    for name, leak in results['leaks'].items():\n278:        failures += [f'{name}: {k}' for k in ('label_kept', 'why_changed_absent', 'reasons_absent') if not leak[k]]\n279:        failures += [] if leak['answer'] == 'Yes' else [f'{name}: answer']\n280:        failures += [] if (leak['package_as_of'], leak['manifest_as_of'], leak['evidence']) == (DATED[name][0], DATED[name][0], DATED[name][1]) else [f'{name}: package day or evidence']\n281:        failures += [] if leak['latest_judgement'] == leak['expected_judgement'] else [f'{name}: judgement']\n282:        failures += [f'{name}: {phrase} found' for phrase, hits in leak['phrase_fields'].items() if hits]\n283:    failures += [] if (results['control']['id'], results['control']['answer']) == ('v3', 'Yes') and results['control']['label_equals_store'] and results['control']['evidence_equals_store'] else ['control']\n284:    closing = results['closing']\n285:    failures += [] if closing['reason'] == CLOSING_REASON and closing['bundle_exposes_reason'] and closing['package_open'] is False and closing['reason_absent'] else ['closing']\n286:    if failures:\n287:        raise SystemExit(f'release check FAILED: {failures}')\n289:          {name: len(s['diagnostics']['hits']) for name, s in results['stores'].items()})\n","exit_code":0,"status":"completed"}}
