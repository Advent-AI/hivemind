{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba src/hivemind/release.py | sed -n '265,600p'\"","aggregated_output":"   265\t    return 1\n   266\t\n   267\t\n   268\tdef _compare(expected, actual, where):\n   269\t    \"\"\"The number of leaf values compared; the first difference is refused, naming where it is.\"\"\"\n   270\t    if isinstance(expected, dict):\n   271\t        if not isinstance(actual, dict) or set(expected) != set(actual):\n   272\t            raise ReleaseRefused(f'{where}: fields differ from the store')\n   273\t        return sum(_compare(expected[key], actual[key], f'{where}.{key}') for key in expected)\n   274\t    if isinstance(expected, list):\n   275\t        if not isinstance(actual, list) or len(expected) != len(actual):\n   276\t            raise ReleaseRefused(f'{where}: {len(actual) if isinstance(actual, list) else \"no\"} entries where the store has {len(expected)}')\n   277\t        return sum(_compare(e, a, f'{where}[{n}]') for n, (e, a) in enumerate(zip(expected, actual)))\n   278\t    if type(expected) is not type(actual) or expected != actual:\n   279\t        raise ReleaseRefused(f'{where}: differs from the store')\n   280\t    return 1\n   281\t\n   282\t\n   283\tdef check_origins(views_db, items_db, data, expected_as_of):\n   284\t    \"\"\"Every package field against its permitted stored source at `expected_as_of`, derived from the store and never from the\n   285\t    package: the day, each question's class, the questions, evidence and sources in order with their counts. Its reads are its own\n   286\t    SQL, apart from the identity rule (`question_class`) and the day of a sequence number (`service.visible`). Returns the number of\n   287\t    fields compared.\"\"\"\n   288\t    with bundle.read_snapshot(views_db, items_db):\n   289\t        as_of = canonical_day(expected_as_of)\n   290\t        if data['as_of'] != as_of:\n   291\t            raise ReleaseRefused(f'the package is dated {data[\"as_of\"]}, the store bound is {as_of}')\n   292\t        views = [row for row in views_db.execute('select view_id, question, created_seq from views order by created_seq, rowid')\n   293\t                 if service.visible(views_db, row['created_seq'], as_of)]\n   294\t        packaged = data['questions']\n   295\t        if [q['id'] for q in packaged] != [row['view_id'] for row in views]:\n   296\t            raise ReleaseRefused(f'the questions differ from the store: {len(packaged)} entries where the store has {len(views)}'\n   297\t                                 if len(packaged) != len(views) else 'the questions or their order differ from the store')\n   298\t        compared = _compare(FORMAT, data['format'], 'package.format') + _compare(ALLOW_LIST, data['allow_list'], 'package.allow_list') + 1\n   299\t        for view, question in zip(views, packaged):\n   300\t            view_id = view['view_id']\n   301\t            positions = {row['position']: row['label'] for row in views_db.execute('select position, label from rungs where view_id=? order by position', (view_id,))}\n   302\t            labels = list(positions.values())\n   303\t            kind = question_class(views_db, view_id, labels, as_of)\n   304\t            record = {'id': view_id, 'question': view['question'], 'open': _open_at(views_db, view_id, as_of), 'class': kind}\n   305\t            if kind == 'number':\n   306\t                record['forecast'] = FORECAST_UNAVAILABLE\n   307\t            else:\n   308\t                latest = views_db.execute('select rung from judgements where view_id=? and publication_day<=? order by judgement_id desc limit 1', (view_id, as_of)).fetchone()\n   309\t                if latest is not None and latest['rung'] not in positions:\n   310\t                    raise ReleaseRefused(f'question {view_id}: its latest judgement names rung {latest[\"rung\"]}, which its ladder does not hold')\n   311\t                record['answers'] = labels\n   312\t                record['answer'] = None if latest is None else positions[latest['rung']]\n   313\t            expected_evidence = _expected_evidence(views_db, items_db, view_id, as_of)\n   314\t            if not isinstance(question.get('evidence'), list) or len(question['evidence']) != len(expected_evidence):\n   315\t                found = len(question['evidence']) if isinstance(question.get('evidence'), list) else 'no'\n   316\t                raise ReleaseRefused(f'question {view_id}.evidence: {found} entries where the store has {len(expected_evidence)}')\n   317\t            record['evidence'] = question['evidence']           # compared piece by piece below, named by the stored evidence id\n   318\t            compared += _compare(record, question, f'question {view_id}') - _leaves(question['evidence'])\n   319\t            for expected, actual in zip(expected_evidence, question['evidence']):\n   320\t                compared += _compare(expected, actual, f'question {view_id}.evidence {expected[\"id\"]}')\n   321\t        return compared\n   322\t\n   323\t\n   324\t# ---------- the package\n   325\t\n   326\tdef _dump(value):\n   327\t    return json.dumps(value, ensure_ascii=False, separators=(',', ':')).encode('utf-8')\n   328\t\n   329\t\n   330\tdef stage(out_dir):\n   331\t    \"\"\"A private staging folder, unique to this invocation, beside the destination.\"\"\"\n   332\t    out_dir = Path(out_dir)\n   333\t    return Path(tempfile.mkdtemp(dir=out_dir.parent, prefix=f'.{out_dir.name}.staging-'))\n   334\t\n   335\t\n   336\tdef write_package(data, staged):\n   337\t    \"\"\"The data file, the reader's page made from it, and their manifest, written into the staging folder.\"\"\"\n   338\t    payload = _dump(data)\n   339\t    page = render_page(payload)\n   340\t    (Path(staged) / DATA_FILE).write_bytes(payload)\n   341\t    (Path(staged) / PAGE_FILE).write_bytes(page)\n   342\t    manifest = {'format': data['format'], 'allow_list': data['allow_list'], 'as_of': data['as_of'],\n   343\t                'data_sha256': hashlib.sha256(payload).hexdigest(), 'page_sha256': hashlib.sha256(page).hexdigest()}\n   344\t    (Path(staged) / MANIFEST_FILE).write_bytes(_dump(manifest))\n   345\t\n   346\t\n   347\tdef _no_replace_rename():\n   348\t    libc = ctypes.CDLL(ctypes.util.find_library('c'), use_errno=True)\n   349\t    if sys.platform == 'darwin' and hasattr(libc, 'renamex_np'):\n   350\t        call = libc.renamex_np\n   351\t        call.argtypes, call.restype = [ctypes.c_char_p, ctypes.c_char_p, ctypes.c_uint], ctypes.c_int\n   352\t        return lambda source, target: call(source, target, RENAME_EXCL)\n   353\t    if sys.platform.startswith('linux') and hasattr(libc, 'renameat2'):\n   354\t        call = libc.renameat2\n   355\t        call.argtypes, call.restype = [ctypes.c_int, ctypes.c_char_p, ctypes.c_int, ctypes.c_char_p, ctypes.c_uint], ctypes.c_int\n   356\t        return lambda source, target: call(AT_FDCWD, source, AT_FDCWD, target, RENAME_NOREPLACE)\n   357\t    return None\n   358\t\n   359\t\n   360\tdef publish(staged, out_dir):\n   361\t    \"\"\"One atomic move of the staged folder to the destination that refuses any existing destination, empty or not.\"\"\"\n   362\t    rename = _no_replace_rename()\n   363\t    if rename is None:\n   364\t        raise ReleaseRefused('this platform offers no atomic rename that refuses an existing destination')\n   365\t    if rename(os.fsencode(str(staged)), os.fsencode(str(out_dir))) != 0:\n   366\t        code = ctypes.get_errno()\n   367\t        if code in (errno.ENOTSUP, errno.EINVAL, errno.ENOSYS):\n   368\t            raise ReleaseRefused(f'the filesystem refuses an atomic no-replace rename ({os.strerror(code)})')\n   369\t        raise OSError(code, os.strerror(code), str(out_dir))\n   370\t\n   371\t\n   372\tdef publish_report(report, path):\n   373\t    \"\"\"The report, written to a private temporary file and linked to its name; the link refuses any existing path, and its success\n   374\t    is the moment the report is published. Returns None, or the temporary file it could not remove after publishing.\"\"\"\n   375\t    path = Path(path)\n   376\t    descriptor, temporary = tempfile.mkstemp(dir=path.parent, prefix=f'.{path.name}.')\n   377\t    try:\n   378\t        with os.fdopen(descriptor, 'wb') as handle:\n   379\t            handle.write(json.dumps(report, ensure_ascii=False, indent=1).encode('utf-8'))\n   380\t        os.link(temporary, path)\n   381\t    except BaseException:\n   382\t        os.unlink(temporary)\n   383\t        raise\n   384\t    try:\n   385\t        os.unlink(temporary)\n   386\t    except OSError:\n   387\t        return temporary\n   388\t    return None\n   389\t\n   390\t\n   391\tdef _unique_members(pairs):\n   392\t    names = [name for name, _ in pairs]\n   393\t    if len(names) != len(set(names)):\n   394\t        raise ReleaseRefused(f'a JSON member name repeats: {sorted({n for n in names if names.count(n) > 1})}')\n   395\t    return dict(pairs)\n   396\t\n   397\t\n   398\tdef read_data(package):\n   399\t    \"\"\"The package's data, read with the repeated-member check. `check_package` returns the data it checked, which is the copy to\n   400\t    trust; this reader is for inspection only.\"\"\"\n   401\t    return _parse((Path(package) / DATA_FILE).read_bytes(), DATA_FILE)\n   402\t\n   403\t\n   404\tURI_CHARACTERS = '%?#'\n   405\t\n   406\t\n   407\tdef store_path(path):\n   408\t    \"\"\"The resolved store path, the one the opener is then given (so the opener's own resolution has nothing left to follow): refused\n   409\t    when it holds a character a SQLite URI decodes (`store.open_read_only` puts the path into a `file:` URI unescaped, so `%2D` would\n   410\t    open a `-`).\"\"\"\n   411\t    real = os.path.realpath(path)\n   412\t    found = sorted({c for c in real if c in URI_CHARACTERS})\n   413\t    if found:\n   414\t        raise ReleaseRefused(f'{path}: a store path may not contain {found}, which the SQLite opener reads as URI syntax')\n   415\t    return real\n   416\t\n   417\t\n   418\tdef _read_regular(folder, name, where):\n   419\t    \"\"\"The bytes of one regular file in an opened folder, read once through a descriptor that refuses a symbolic link and opens a pipe\n   420\t    without waiting, so its type is refused instead.\"\"\"\n   421\t    try:\n   422\t        descriptor = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=folder)   # a pipe or device never blocks the check\n   423\t    except OSError as error:\n   424\t        if error.errno == errno.ELOOP:\n   425\t            raise ReleaseRefused(f'{where}/{name}: not a regular file') from None\n   426\t        raise\n   427\t    try:\n   428\t        if not stat.S_ISREG(os.fstat(descriptor).st_mode):\n   429\t            raise ReleaseRefused(f'{where}/{name}: not a regular file')\n   430\t        chunks = []\n   431\t        while True:\n   432\t            chunk = os.read(descriptor, 1 << 20)\n   433\t            if not chunk:\n   434\t                return b''.join(chunks)\n   435\t            chunks.append(chunk)\n   436\t    finally:\n   437\t        os.close(descriptor)\n   438\t\n   439\t\n   440\tdef _parse(raw, name):\n   441\t    try:\n   442\t        return json.loads(raw.decode('utf-8'), object_pairs_hook=_unique_members)\n   443\t    except (UnicodeDecodeError, json.JSONDecodeError) as error:\n   444\t        raise ReleaseRefused(f'{name}: not JSON ({error})') from None\n   445\t\n   446\t\n   447\tdef check_package(path, views_db=None, items_db=None, expected_as_of=None):\n   448\t    \"\"\"The package as a reader receives it: a real folder holding exactly the two regular files, each read once through one handle on\n   449\t    the folder; JSON with no repeated member name; a closed manifest that agrees with the data and the sha256 of the very bytes\n   450\t    parsed; data that passes `check_export` and, with the stores, `check_origins` at `expected_as_of` (or at the package's own day\n   451\t    passed through `resolve`); and a page equal, byte for byte, to `render_page` of the very data bytes checked. Returns (counts, the data\n   452\t    checked, its size in bytes).\"\"\"\n   453\t    path = Path(path)\n   454\t    try:\n   455\t        folder = os.open(path, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)\n   456\t    except OSError as error:\n   457\t        if error.errno in (errno.ELOOP, errno.ENOTDIR):\n   458\t            raise ReleaseRefused(f'{path}: not a folder') from None\n   459\t        raise\n   460\t    try:\n   461\t        names = os.listdir(folder)\n   462\t        if sorted(names) != sorted(PACKAGE_FILES):\n   463\t            raise ReleaseRefused(f'{path}: holds {sorted(names)}, not exactly {sorted(PACKAGE_FILES)}')\n   464\t        raw, manifest_raw, page = (_read_regular(folder, DATA_FILE, path), _read_regular(folder, MANIFEST_FILE, path),\n   465\t                                   _read_regular(folder, PAGE_FILE, path))\n   466\t    finally:\n   467\t        os.close(folder)\n   468\t    manifest, data = _parse(manifest_raw, MANIFEST_FILE), _parse(raw, DATA_FILE)\n   469\t    counts = check_export(data)\n   470\t    _keys(manifest, 'manifest', 'the manifest')\n   471\t    if manifest['data_sha256'] != hashlib.sha256(raw).hexdigest():\n   472\t        raise ReleaseRefused('the manifest sha256 does not match the data file')\n   473\t    if page != render_page(raw):\n   474\t        raise ReleaseRefused('the page is not the page made from its data')\n   475\t    if manifest['page_sha256'] != hashlib.sha256(page).hexdigest():\n   476\t        raise ReleaseRefused('the manifest page_sha256 does not match the page')\n   477\t    for name in ('format', 'allow_list', 'as_of'):\n   478\t        if manifest[name] != data[name]:\n   479\t            raise ReleaseRefused(f'the manifest {name} {manifest[name]!r} differs from the data {data[name]!r}')\n   480\t    if views_db is not None:\n   481\t        bound = expected_as_of if expected_as_of is not None else resolve(views_db, data['as_of'])\n   482\t        counts['fields_compared'] = check_origins(views_db, items_db, data, bound)\n   483\t    return counts, data, len(raw)\n   484\t\n   485\t\n   486\t# ---------- the reader's page (slice 2, RELEASE-PAGE.md)\n   487\t\n   488\tPAGE_STYLE = (\n   489\t    ':root{--paper:#f5f2eb;--wash:#ebe9e2;--rule:#dfddd6;--ink:#0f140d;--ink-2:#393d36;--ink-3:#6a6c65;color-scheme:light dark}'\n   490\t    '@media (prefers-color-scheme: dark){:root{--paper:#0f140d;--wash:#1b2018;--rule:#393d36;--ink:#f5f2eb;--ink-2:#dfddd6;--ink-3:#9f9f98}}'\n   491\t    '*{box-sizing:border-box}'\n   492\t    'body{margin:0;background:var(--paper);color:var(--ink);font:15px/1.5 \"Helvetica Neue\",Helvetica,Arial,sans-serif}'\n   493\t    'main{max-width:860px;margin:0 auto;padding:24px 16px 64px}'\n   494\t    '#fallback{max-width:860px;margin:24px auto;padding:0 16px;color:var(--ink-2)}'\n   495\t    '.release-title{font-size:22px;font-weight:600;margin:0 0 4px}'\n   496\t    '.release-day,.release-counts{margin:0;color:var(--ink-3);font-size:13px}'\n   497\t    '.release-header{border-bottom:1px solid var(--rule);padding-bottom:16px;margin-bottom:8px}'\n   498\t    '.question{border-bottom:1px solid var(--rule);padding:16px 0}'\n   499\t    '.question-text{font-size:16px;font-weight:600;margin:0 0 6px;overflow-wrap:anywhere}'\n   500\t    '.question-status{display:inline-block;margin:0 12px 0 0;font-size:12px;color:var(--ink-3);text-transform:none}'\n   501\t    '.question-forecast,.question-answer{display:inline-block;margin:0;font-size:13px;padding:1px 8px;border:1px solid var(--rule);border-radius:999px;background:var(--wash)}'\n   502\t    '.evidence{margin-top:10px}'\n   503\t    '.evidence-count{cursor:pointer;font-size:13px;color:var(--ink-2)}'\n   504\t    '.evidence-none{margin:10px 0 0;font-size:13px;color:var(--ink-3)}'\n   505\t    '.evidence-list{margin:8px 0 0;padding-left:20px}'\n   506\t    '.evidence-item{margin:0 0 14px}'\n   507\t    '.evidence-summary{margin:0 0 4px;overflow-wrap:anywhere}'\n   508\t    '.evidence-quote{margin:0 0 4px;padding-left:10px;border-left:2px solid var(--rule);color:var(--ink-2);overflow-wrap:anywhere}'\n   509\t    '.evidence-meta{margin:0 0 4px;font-size:12px;color:var(--ink-3);overflow-wrap:anywhere}'\n   510\t    '.source-list{margin:0;padding-left:16px;font-size:12px;color:var(--ink-3)}'\n   511\t    '.source>span{overflow-wrap:anywhere;margin-right:12px}'\n   512\t)\n   513\t\n   514\tPAGE_SCRIPT = (\n   515\t    \"(function(){'use strict';\"\n   516\t    \"var data=JSON.parse(document.getElementById('release-data').textContent);\"\n   517\t    \"var root=document.getElementById('release');\"\n   518\t    \"function el(tag,cls,text){var e=document.createElement(tag);if(cls){e.className=cls;}if(text!==undefined){e.textContent=text;}return e;}\"\n   519\t    \"function piece(e){var item=el('li','evidence-item');\"\n   520\t    \"item.appendChild(el('p','evidence-summary',e.one_line));\"\n   521\t    \"item.appendChild(el('blockquote','evidence-quote',e.quote));\"\n   522\t    \"item.appendChild(el('p','evidence-meta',e.tier+' \\\\u00b7 '+e.speaker+' \\\\u00b7 original: '+e.original_who+(e.original_day?', '+e.original_day:'')));\"\n   523\t    \"var sources=el('ul','source-list');\"\n   524\t    \"e.sources.forEach(function(s){var row=el('li','source');\"\n   525\t    \"row.appendChild(el('span','source-title',s.title));row.appendChild(el('span','source-publisher',s.publisher));\"\n   526\t    \"row.appendChild(el('span','source-day',s.day));row.appendChild(el('span','source-address',s.uri));sources.appendChild(row);});\"\n   527\t    \"item.appendChild(sources);return item;}\"\n   528\t    \"var counts={number:0,event:0,yes_no:0};data.questions.forEach(function(q){counts[q['class']]+=1;});\"\n   529\t    \"var header=el('header','release-header');header.appendChild(el('h1','release-title','Hivemind release'));\"\n   530\t    \"header.appendChild(el('p','release-day','As of '+data.as_of));\"\n   531\t    \"header.appendChild(el('p','release-counts',counts.number+' number questions \\\\u00b7 '+counts.event+' event questions \\\\u00b7 '+counts.yes_no+' Yes/No questions'));\"\n   532\t    \"root.appendChild(header);\"\n   533\t    \"if(!data.questions.length){root.appendChild(el('p','release-empty','No questions as of '+data.as_of));}\"\n   534\t    \"data.questions.forEach(function(q){var card=el('article','question');card.dataset.id=q.id;\"\n   535\t    \"card.appendChild(el('h2','question-text',q.question));card.appendChild(el('p','question-status',q.open?'Open':'Closed'));\"\n   536\t    \"if(q['class']==='number'){card.appendChild(el('p','question-forecast',q.forecast));}\"\n   537\t    \"else{card.appendChild(el('p','question-answer',q.answer===null?'Not yet answered':'Answer: '+q.answer));}\"\n   538\t    \"var n=q.evidence.length;\"\n   539\t    \"if(!n){card.appendChild(el('p','evidence-none','No evidence in force'));}\"\n   540\t    \"else{var details=el('details','evidence');details.appendChild(el('summary','evidence-count',n+(n===1?' piece of evidence':' pieces of evidence')));\"\n   541\t    \"var list=null;details.addEventListener('toggle',function(){if(details.open&&!list){list=el('ol','evidence-list');\"\n   542\t    \"q.evidence.forEach(function(e){list.appendChild(piece(e));});details.appendChild(list);}});card.appendChild(details);}\"\n   543\t    \"root.appendChild(card);});\"\n   544\t    \"var fallback=document.getElementById('fallback');fallback.parentNode.removeChild(fallback);\"\n   545\t    \"})();\"\n   546\t)\n   547\t\n   548\tPAGE_CSP = (\"default-src 'none'; script-src {script}; style-src {style}; img-src 'none'; font-src 'none'; connect-src 'none'; \"\n   549\t            \"base-uri 'none'; form-action 'none'\")\n   550\tEMBED_ESCAPED = ('<', '>', '&', chr(0x2028), chr(0x2029))\n   551\t\n   552\t\n   553\tdef _source_hash(text):\n   554\t    return \"'sha256-\" + base64.b64encode(hashlib.sha256(text.encode('utf-8')).digest()).decode('ascii') + \"'\"\n   555\t\n   556\t\n   557\tdef embed(data_bytes):\n   558\t    \"\"\"The data file's text with `<`, `>`, `&`, U+2028 and U+2029 replaced by their six-character JSON escapes: still the same JSON,\n   559\t    and unable to close or comment out the block it sits in.\"\"\"\n   560\t    text = data_bytes.decode('utf-8')\n   561\t    for character in EMBED_ESCAPED:\n   562\t        text = text.replace(character, chr(92) + f'u{ord(character):04x}')\n   563\t    return text\n   564\t\n   565\t\n   566\tDATA_PLACEHOLDER = '@@RELEASE_DATA@@'\n   567\t\n   568\t\n   569\tdef page_template():\n   570\t    \"\"\"The whole reader's page with its one data placeholder: charset and CSP first; the CSP admits only this template's own script and\n   571\t    style and no connection, image, font, base or form target. Its sha256 is pinned in the tests.\"\"\"\n   572\t    csp = PAGE_CSP.format(script=_source_hash(PAGE_SCRIPT), style=_source_hash(PAGE_STYLE))\n   573\t    return ('<!doctype html>\\n<html lang=\"en\">\\n<head>\\n<meta charset=\"utf-8\">\\n'\n   574\t            f'<meta http-equiv=\"Content-Security-Policy\" content=\"{csp}\">\\n'\n   575\t            '<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\\n<title>Hivemind release</title>\\n'\n   576\t            f'<style>{PAGE_STYLE}</style>\\n</head>\\n<body>\\n'\n   577\t            '<p id=\"fallback\">This release page needs JavaScript to show its questions.</p>\\n<main id=\"release\"></main>\\n'\n   578\t            f'<script type=\"application/json\" id=\"release-data\">{DATA_PLACEHOLDER}</script>\\n'\n   579\t            f'<script>{PAGE_SCRIPT}</script>\\n</body>\\n</html>\\n')\n   580\t\n   581\t\n   582\tdef render_page(data_bytes):\n   583\t    \"\"\"The reader's page: the pinned template split once at its placeholder, with the escaped data inserted.\"\"\"\n   584\t    before, after = page_template().split(DATA_PLACEHOLDER)\n   585\t    return (before + embed(data_bytes) + after).encode('utf-8')\n   586\t\n   587\t\n   588\t# ---------- the report\n   589\t\n   590\tdef withheld_unresolved(views_db, data):\n   591\t    \"\"\"For the release report only: the number questions whose ladder does not resolve to bands, with the reason and whether the\n   592\t    view has a key. Withheld like every number question; this list never enters the package.\"\"\"\n   593\t    out = []\n   594\t    for question in data['questions']:\n   595\t        if question['class'] != 'number':\n   596\t            continue\n   597\t        bands, reason = service.ladder_bands(store.rungs_of(views_db, question['id']))\n   598\t        if bands is None:\n   599\t            out.append({'id': question['id'], 'reason': reason, 'has_key': key_measure(views_db, question['id'], data['as_of']) is not None})\n   600\t    return out\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba src/hivemind/release.py | sed -n '1,245p'\"","aggregated_output":"     1\t\"\"\"The \"Forecast unavailable\" release: one allow-listed export of a views ledger, its package and its checks\n     2\t(docs/research/2026-11-22-number-answers/RELEASE-BUILD.md; D726, D756, D758).\n     3\t\n     4\tA number question carries its question, its evidence in force and the marker \"Forecast unavailable\". An event or Yes/No question\n     5\tcarries its question, its evidence and its answer labels. Nothing else is read into the package: no rung condition or bound, no\n     6\tjudgement reason or explanation, no switch reason, no history. Before a package is published, every field is compared with its\n     7\tstored source at the package's day, and nothing published replaces an existing path.\n     8\t\"\"\"\n     9\timport base64\n    10\timport ctypes\n    11\timport ctypes.util\n    12\timport errno\n    13\timport hashlib\n    14\timport json\n    15\timport os\n    16\timport stat\n    17\timport sys\n    18\timport tempfile\n    19\tfrom datetime import date\n    20\tfrom pathlib import Path\n    21\t\n    22\tfrom . import bundle, service, vocabulary\n    23\tfrom .views import identity, store\n    24\t\n    25\tFORMAT = 'hivemind-release/2'           # 2: the package holds the reader's page (RELEASE-PAGE.md)\n    26\tALLOW_LIST = 'release-allow-list/1'\n    27\tFORECAST_UNAVAILABLE = 'Forecast unavailable'\n    28\tDATA_FILE = 'release-data.json'\n    29\tMANIFEST_FILE = 'manifest.json'\n    30\tPAGE_FILE = 'index.html'\n    31\tPACKAGE_FILES = frozenset({DATA_FILE, MANIFEST_FILE, PAGE_FILE})\n    32\tCLASSES = ('number', 'event', 'yes_no')\n    33\tALLOWED = {\n    34\t    'envelope': frozenset({'format', 'allow_list', 'as_of', 'questions'}),\n    35\t    'number': frozenset({'id', 'question', 'open', 'class', 'forecast', 'evidence'}),\n    36\t    'answered': frozenset({'id', 'question', 'open', 'class', 'answers', 'answer', 'evidence'}),\n    37\t    'evidence': frozenset({'id', 'one_line', 'quote', 'tier', 'speaker', 'original_who', 'original_day', 'sources'}),\n    38\t    'source': frozenset({'title', 'publisher', 'day', 'uri'}),\n    39\t    'manifest': frozenset({'format', 'allow_list', 'as_of', 'data_sha256', 'page_sha256'}),\n    40\t}\n    41\tEVIDENCE_TEXT = ('one_line', 'quote', 'tier', 'speaker', 'original_who', 'original_day')\n    42\tSOURCE_TEXT = ('title', 'publisher', 'day', 'uri')\n    43\tRENAME_EXCL = 0x4          # macOS <stdio.h>: renamex_np refuses an existing destination\n    44\tRENAME_NOREPLACE = 0x1     # Linux <linux/fs.h>: renameat2 refuses an existing destination\n    45\tAT_FDCWD = -100\n    46\t\n    47\t\n    48\tclass ReleaseRefused(ValueError):\n    49\t    \"\"\"The release refuses the input, the export or the package; the message names what and where.\"\"\"\n    50\t\n    51\t\n    52\t# ---------- the day\n    53\t\n    54\tdef canonical_day(text):\n    55\t    \"\"\"A day written YYYY-MM-DD, returned unchanged; anything else is refused. The stores compare days as text, so a day Python\n    56\t    also reads (20260825) would select rows from later days.\"\"\"\n    57\t    try:\n    58\t        day = date.fromisoformat(text)\n    59\t    except (TypeError, ValueError):\n    60\t        raise ReleaseRefused(f'not a day: {text!r}') from None\n    61\t    if day.isoformat() != text:\n    62\t        raise ReleaseRefused(f'a day must be written YYYY-MM-DD: {text!r}')\n    63\t    return text\n    64\t\n    65\t\n    66\tdef resolve(views_db, as_of=None):\n    67\t    \"\"\"The bound of a build or a check, one rule for both: a given day must be canonical; `service.resolve_bound` then refuses an\n    68\t    unfinished first day or a day after the last completed day; an omitted day with no default is refused.\"\"\"\n    69\t    if as_of is not None:\n    70\t        canonical_day(as_of)\n    71\t    bound = service.resolve_bound(views_db, as_of)\n    72\t    if not bound:\n    73\t        raise ReleaseRefused('the store has no default day; supply --as-of')\n    74\t    return canonical_day(bound)\n    75\t\n    76\t\n    77\t# ---------- identity\n    78\t\n    79\tdef _has_table(conn, name):\n    80\t    return conn.execute(\"select 1 from sqlite_master where type='table' and name=?\", (name,)).fetchone() is not None\n    81\t\n    82\t\n    83\tdef key_measure(conn, view_id, as_of):\n    84\t    \"\"\"The measure of the view's key as recorded on or before the day, or None: no key table, no key, or a key written after the\n    85\t    day (a later key never reclassifies an earlier package).\"\"\"\n    86\t    if not _has_table(conn, 'view_keys'):\n    87\t        return None\n    88\t    row = conn.execute('select measure, seq from view_keys where view_id=?', (view_id,)).fetchone()\n    89\t    return row['measure'] if row is not None and service.visible(conn, row['seq'], as_of) else None\n    90\t\n    91\t\n    92\tdef ladder(conn, view_id):\n    93\t    \"\"\"(position, label) of every rung, by position: the only rung columns the package reads.\"\"\"\n    94\t    return [(row['position'], row['label']) for row in conn.execute('select position, label from rungs where view_id=? order by position', (view_id,))]\n    95\t\n    96\t\n    97\tdef question_class(conn, view_id, labels, as_of):\n    98\t    \"\"\"'event' for an event measure in the key recorded by the day, 'yes_no' for exactly two labels that are Yes and No in the stored\n    99\t    vocabulary, else 'number' (a view with no key and a ladder whose bands do not resolve included): the forecast of every number\n   100\t    question is withheld.\"\"\"\n   101\t    if key_measure(conn, view_id, as_of) in identity.EVENT_MEASURES:\n   102\t        return 'event'\n   103\t    if len(labels) == 2 and {vocabulary.canonical('label', label) for label in labels} == {'Yes', 'No'}:\n   104\t        return 'yes_no'\n   105\t    return 'number'\n   106\t\n   107\t\n   108\tdef _answer(conn, view_id, as_of, positions):\n   109\t    \"\"\"The stored label of the latest judgement's rung on or before the day, or None when the question is not yet judged.\"\"\"\n   110\t    row = conn.execute('select rung from judgements where view_id=? and publication_day<=? order by judgement_id desc limit 1', (view_id, as_of)).fetchone()\n   111\t    if row is None:\n   112\t        return None\n   113\t    if row['rung'] not in positions:\n   114\t        raise ReleaseRefused(f'{view_id}: its latest judgement names rung {row[\"rung\"]}, which its ladder does not hold')\n   115\t    return positions[row['rung']]\n   116\t\n   117\t\n   118\t# ---------- the export\n   119\t\n   120\tdef _item(items_db, cache, input_id, evidence_id):\n   121\t    if input_id not in cache:\n   122\t        row = items_db.execute('select title, publisher, source_uri from items where input_id=?', (input_id,)).fetchone()\n   123\t        if row is None:\n   124\t            raise ReleaseRefused(f'evidence {evidence_id}: source item {input_id} is not in the items database')\n   125\t        cache[input_id] = row\n   126\t    return cache[input_id]\n   127\t\n   128\t\n   129\tdef _visible_views(conn, as_of):\n   130\t    return [row for row in conn.execute('select view_id, question, created_seq from views order by created_seq, rowid') if service.visible(conn, row['created_seq'], as_of)]\n   131\t\n   132\t\n   133\tdef release_export(views_db, items_db, as_of=None):\n   134\t    \"\"\"The release data as of the bound: every question visible on that day, closed ones included, built field by field from the\n   135\t    allow-list. The result passes `check_export` or nothing is returned.\"\"\"\n   136\t    with bundle.read_snapshot(views_db, items_db):\n   137\t        bound = resolve(views_db, as_of)\n   138\t        items, questions = {}, []\n   139\t        for view in _visible_views(views_db, bound):\n   140\t            view_id = view['view_id']\n   141\t            rungs = ladder(views_db, view_id)\n   142\t            labels = [label for _, label in rungs]\n   143\t            kind = question_class(views_db, view_id, labels, bound)\n   144\t            record = {'id': view_id, 'question': view['question'], 'open': service.is_open_as_of(views_db, view_id, bound), 'class': kind}\n   145\t            if kind == 'number':\n   146\t                record['forecast'] = FORECAST_UNAVAILABLE\n   147\t            else:\n   148\t                record['answers'] = labels\n   149\t                record['answer'] = _answer(views_db, view_id, bound, dict(rungs))\n   150\t            evidence = []\n   151\t            for piece in service.evidence(views_db, view_id, bound):\n   152\t                sources = []\n   153\t                for source in piece['sources']:\n   154\t                    item = _item(items_db, items, source['input_id'], piece['evidence_id'])\n   155\t                    sources.append({'title': item['title'], 'publisher': item['publisher'], 'day': source['publication_day'], 'uri': item['source_uri']})\n   156\t                evidence.append({'id': piece['evidence_id'], **{name: piece[name] for name in EVIDENCE_TEXT}, 'sources': sources})\n   157\t            record['evidence'] = evidence\n   158\t            questions.append(record)\n   159\t        data = {'format': FORMAT, 'allow_list': ALLOW_LIST, 'as_of': bound, 'questions': questions}\n   160\t    check_export(data)\n   161\t    return data\n   162\t\n   163\t\n   164\t# ---------- the closed set\n   165\t\n   166\tdef _keys(value, kind, where):\n   167\t    if not isinstance(value, dict):\n   168\t        raise ReleaseRefused(f'{where}: not an object')\n   169\t    if set(value) != ALLOWED[kind]:\n   170\t        extra, missing = sorted(set(value) - ALLOWED[kind]), sorted(ALLOWED[kind] - set(value))\n   171\t        raise ReleaseRefused(f'{where}: keys off the allow-list {extra}, missing {missing}')\n   172\t\n   173\t\n   174\tdef _texts(value, names, where):\n   175\t    for name in names:\n   176\t        if not isinstance(value[name], str):\n   177\t            raise ReleaseRefused(f'{where}: {name} is not text')\n   178\t\n   179\t\n   180\tdef check_export(data):\n   181\t    \"\"\"Every object at every level holds exactly its record type's keys, with values of the allowed kinds. Returns the counts\n   182\t    judged.\"\"\"\n   183\t    _keys(data, 'envelope', 'the package')\n   184\t    if data['format'] != FORMAT or data['allow_list'] != ALLOW_LIST:\n   185\t        raise ReleaseRefused(f'the package names format {data[\"format\"]!r} and allow-list {data[\"allow_list\"]!r}')\n   186\t    canonical_day(data['as_of'])\n   187\t    if not isinstance(data['questions'], list):\n   188\t        raise ReleaseRefused('the package: questions is not a list')\n   189\t    counts = {'questions': {kind: 0 for kind in CLASSES}, 'evidence': 0, 'sources': 0}\n   190\t    for position, question in enumerate(data['questions']):\n   191\t        where = f'question {position}'\n   192\t        if not isinstance(question, dict) or question.get('class') not in CLASSES:\n   193\t            raise ReleaseRefused(f'{where}: no allowed class')\n   194\t        kind = question['class']\n   195\t        _keys(question, 'number' if kind == 'number' else 'answered', where)\n   196\t        _texts(question, ('id', 'question'), where)\n   197\t        where = f'question {question[\"id\"]}'\n   198\t        if not isinstance(question['open'], bool):\n   199\t            raise ReleaseRefused(f'{where}: open is not true or false')\n   200\t        if kind == 'number':\n   201\t            if question['forecast'] != FORECAST_UNAVAILABLE:\n   202\t                raise ReleaseRefused(f'{where}: a number question carries only the marker')\n   203\t        else:\n   204\t            answers = question['answers']\n   205\t            if not (isinstance(answers, list) and len(answers) == 2 and all(isinstance(a, str) for a in answers)):\n   206\t                raise ReleaseRefused(f'{where}: answers are not two labels')\n   207\t            if question['answer'] is not None and question['answer'] not in answers:\n   208\t                raise ReleaseRefused(f'{where}: the answer is not one of its labels')\n   209\t        if not isinstance(question['evidence'], list):\n   210\t            raise ReleaseRefused(f'{where}: evidence is not a list')\n   211\t        for piece in question['evidence']:\n   212\t            _keys(piece, 'evidence', f'{where} evidence')\n   213\t            _texts(piece, ('id',), f'{where} evidence')\n   214\t            _texts(piece, EVIDENCE_TEXT, f'{where} evidence {piece[\"id\"]}')\n   215\t            if not isinstance(piece['sources'], list):\n   216\t                raise ReleaseRefused(f'{where} evidence {piece[\"id\"]}: sources is not a list')\n   217\t            for source in piece['sources']:\n   218\t                _keys(source, 'source', f'{where} evidence {piece[\"id\"]} source')\n   219\t                _texts(source, SOURCE_TEXT, f'{where} evidence {piece[\"id\"]} source')\n   220\t            counts['sources'] += len(piece['sources'])\n   221\t        counts['evidence'] += len(question['evidence'])\n   222\t        counts['questions'][kind] += 1\n   223\t    return counts\n   224\t\n   225\t\n   226\t# ---------- the origin check\n   227\t\n   228\tdef _open_at(conn, view_id, as_of):\n   229\t    for row in conn.execute('select open, after_seq from view_switches where view_id=? order by id desc', (view_id,)):\n   230\t        if service.visible(conn, row['after_seq'], as_of):\n   231\t            return bool(row['open'])\n   232\t    return True\n   233\t\n   234\t\n   235\tdef _expected_evidence(views_db, items_db, view_id, as_of):\n   236\t    \"\"\"The evidence in force at the day, by its own SQL: visible links in link order, minus those whose latest replacement is\n   237\t    visible; each source row visible at the day, in row order, with its item required.\"\"\"\n   238\t    out = []\n   239\t    for link in views_db.execute('select evidence_id, seq from evidence_links where view_id=? order by id', (view_id,)).fetchall():\n   240\t        if not service.visible(views_db, link['seq'], as_of):\n   241\t            continue\n   242\t        latest = views_db.execute('select seq from replacements where old_evidence_id=? order by id desc limit 1', (link['evidence_id'],)).fetchone()\n   243\t        if latest is not None and service.visible(views_db, latest['seq'], as_of):\n   244\t            continue\n   245\t        row = views_db.execute(f'select evidence_id, {\", \".join(EVIDENCE_TEXT)} from evidence where evidence_id=?', (link['evidence_id'],)).fetchone()\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_17","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba tests/test_release.py | sed -n '610,860p'\"","aggregated_output":"   610\t    signals = tmp_path / 'signals'\n   611\t    signals.mkdir()\n   612\t    paused = scratch(tmp_path, [('scripts/release_build.py', '    return write_report(summary, report)\\n\\n\\ndef check',\n   613\t                                 f\"    {pause_code(signals, 'report', indent='    ')}return write_report(summary, report)\\n\\n\\ndef check\")])\n   614\t    out = tmp_path / 'release'\n   615\t    marker = tmp_path / 'release.report.json'\n   616\t    code, _, err = run_paused(paused, ['build', '--ledger', stores[0], '--items', stores[1], '--out', out], signals, 'report', lambda: marker.write_text('occupied'))\n   617\t    assert code == 2 and marker.read_text() == 'occupied'\n   618\t    assert any(line.startswith('report not written ([Errno 17] File exists: ') and line.endswith(f\"-> '{marker}'); run check to write it\") for line in err.splitlines()), err\n   619\t    checked = run('check', out, '--ledger', stores[0], '--items', stores[1])\n   620\t    assert checked.returncode == 2 and checked.stdout.startswith(f'passes {out}: ') and marker.read_text() == 'occupied'\n   621\t\n   622\t\n   623\tdef test_20_a_temporary_file_left_after_the_link_still_counts_as_published(stores, tmp_path):\n   624\t    \"\"\"§1 publish_report, §6 test 20.\"\"\"\n   625\t    command = scratch(tmp_path, [('src/hivemind/release.py', '    try:\\n        os.unlink(temporary)\\n    except OSError:',\n   626\t                                  \"    try:\\n        raise PermissionError('test: cannot remove')\\n    except OSError:\")])\n   627\t    out = tmp_path / 'release'\n   628\t    result = subprocess.run([sys.executable, str(command), 'build', '--ledger', stores[0], '--items', stores[1], '--out', out], capture_output=True, text=True)\n   629\t    leftovers = list(tmp_path.glob('.release.report.json.*'))\n   630\t    assert result.returncode == 0 and len(leftovers) == 1\n   631\t    stderr_line(result, f'report published; its temporary file {leftovers[0]} could not be removed')\n   632\t    assert json.loads(out.with_name('release.report.json').read_text())['as_of'] == DAYS[2]\n   633\t    assert list(tmp_path.glob('.release.report.json.*'))\n   634\t\n   635\t\n   636\tdef test_21_check_that_cannot_write_its_report_exits_2(stores, tmp_path):\n   637\t    \"\"\"§1 check's statuses, §6 test 21.\"\"\"\n   638\t    out = tmp_path / 'release'\n   639\t    build_package(stores, out)\n   640\t    command = scratch(tmp_path, [('src/hivemind/release.py', \"    descriptor, temporary = tempfile.mkstemp(dir=path.parent, prefix=f'.{path.name}.')\",\n   641\t                                  \"    raise PermissionError('test: cannot create')\")])\n   642\t    result = subprocess.run([sys.executable, str(command), 'check', out, '--ledger', stores[0], '--items', stores[1]], capture_output=True, text=True)\n   643\t    assert result.returncode == 2 and result.stdout.startswith(f'passes {out}: ')\n   644\t    stderr_line(result, 'report not written (test: cannot create); run check to write it')\n   645\t    printed = json.loads(result.stdout[result.stdout.index('\\n{') + 1:])    # the whole report, printed on its own lines, though not written\n   646\t    assert set(printed) == REPORT_KEYS and (printed['ledger'], printed['items'], printed['as_of']) == (str(stores[0]), str(stores[1]), DAYS[2])\n   647\t    assert printed['counts'] == FIXTURE_COUNTS and printed['withheld_unresolved'] == FIXTURE_UNRESOLVED and printed['data_bytes'] == FIXTURE_DATA_BYTES\n   648\t    assert printed['export_seconds'] is None and printed['check_seconds'] >= 0\n   649\t\n   650\t\n   651\t# ---------- council 75: key visibility, text fields, store paths, the writer's own refusal\n   652\t\n   653\t\n   654\tdef test_22_a_key_written_after_the_day_does_not_reclassify_it(stores, tmp_path):\n   655\t    \"\"\"§1 question_class (council 75): a question with no key on 08-24 that gains an event key on 08-25 stays a number question in\n   656\t    the 08-24 package.\"\"\"\n   657\t    conn = store.open_db(str(stores[0]))\n   658\t    store.create_view(conn, view_id='v8', looks_at='NVIDIA buyback', question='How large a buyback will NVIDIA announce by 2027?',\n   659\t                      rungs=[{'label': 'Above the estimate', 'condition': 'At least $60 billion'}, {'label': 'Below the estimate', 'condition': 'Less than $60 billion'}],\n   660\t                      object_id='NVDA', object_kind='company', kind='asset', due_day='2027-01-31', year='2027', seq=1, input_id='item-1', created_at='2026-08-24T12:00:00Z')\n   661\t    judge(conn, 'v8', 1, 1, 'The estimate is about $70 billion.')\n   662\t    store.insert(conn, 'view_keys', view_id='v8', measure='event', scope='NVIDIA', scope_key='nvidia', period_start='2026-02-01', period_end='2027-01-31',\n   663\t                 basis='n/a', unit='n/a', event_type='other', seq=2, scope_source='model', key_version=1)\n   664\t    conn.commit()\n   665\t    conn.close()\n   666\t    early, late = by_id(export(stores, DAYS[0]))['v8'], by_id(export(stores, DAYS[1]))['v8']\n   667\t    assert (early['class'], early.get('forecast')) == ('number', MARKER)\n   668\t    assert (late['class'], late['answer']) == ('event', 'Above the estimate')\n   669\t    out = tmp_path / 'early'\n   670\t    build_package(stores, out, DAYS[0])\n   671\t    assert by_id(release.read_data(out))['v8']['class'] == 'number'\n   672\t\n   673\t\n   674\tEVIDENCE_COLUMNS = {'one_line': 'one_line', 'quote': 'quote', 'tier': 'tier', 'speaker': 'speaker', 'original_who': 'original_who', 'original_day': 'original_day'}\n   675\tSOURCE_COLUMNS = {'title': ('items', 'title'), 'publisher': ('items', 'publisher'), 'uri': ('items', 'source_uri'), 'day': ('sources', 'publication_day')}\n   676\t\n   677\t\n   678\t@pytest.mark.parametrize('field', [*EVIDENCE_COLUMNS, *SOURCE_COLUMNS])\n   679\tdef test_23_every_evidence_and_source_text_field_must_be_text(tmp_path, field):\n   680\t    \"\"\"§1 check_export (council 75): a null in any of the ten text fields the closed set requires is refused, at the writer.\"\"\"\n   681\t    views, items = make_store(tmp_path / 'views.sqlite'), make_items(tmp_path / 'items.sqlite', ids=('item-1', 'item-2', 'item-3', 'item-9'))\n   682\t    conn = store.open_db(str(views))\n   683\t    values = dict(evidence_id='e7', quote='Officials said the rule would be published.', one_line='Officials expect the rule.', speaker='Publisher',\n   684\t                  original_who='Officials', original_day=DAYS[0], tier='party_statement', event_time=None, created_seq=1, created_from_input='item-9')\n   685\t    if field in EVIDENCE_COLUMNS:\n   686\t        values[EVIDENCE_COLUMNS[field]] = None\n   687\t    store.insert(conn, 'evidence', **values)\n   688\t    store.insert(conn, 'evidence_links', evidence_id='e7', view_id='v6', seq=1)\n   689\t    store.insert(conn, 'evidence_sources', evidence_id='e7', input_id='item-9', category='T1',\n   690\t                 publication_day=None if field == 'day' else DAYS[0], seq=1)\n   691\t    conn.commit()\n   692\t    conn.close()\n   693\t    if field in SOURCE_COLUMNS and SOURCE_COLUMNS[field][0] == 'items':\n   694\t        items_conn = sqlite3.connect(items)\n   695\t        items_conn.execute(f\"update items set {SOURCE_COLUMNS[field][1]} = null where input_id = 'item-9'\")\n   696\t        items_conn.commit()\n   697\t        items_conn.close()\n   698\t    where = 'question v6 evidence e7' + ('' if field in EVIDENCE_COLUMNS else ' source')\n   699\t    refused_with(lambda: export((views, items)), f'{where}: {field} is not text')\n   700\t\n   701\t\n   702\tdef test_24_a_store_path_with_uri_syntax_is_refused(stores, tmp_path):\n   703\t    \"\"\"§1 store_path (councils 75, 75b): a path holding a character the SQLite URI opener decodes is refused before anything is opened;\n   704\t    an accepted path is returned resolved, so the opener does not resolve a link a second time.\"\"\"\n   705\t    odd = tmp_path / 'a%2Db'\n   706\t    odd.mkdir()\n   707\t    shutil.copyfile(stores[0], odd / 'views.sqlite')\n   708\t    message = f\"{odd / 'views.sqlite'}: a store path may not contain ['%'], which the SQLite opener reads as URI syntax\"\n   709\t    refused_with(lambda: release.store_path(odd / 'views.sqlite'), message)\n   710\t    result = run('build', '--ledger', odd / 'views.sqlite', '--items', stores[1], '--out', tmp_path / 'release')\n   711\t    assert result.returncode == 1 and not (tmp_path / 'release').exists()\n   712\t    stderr_line(result, f'refused: ReleaseRefused: {message}')\n   713\t    assert release.store_path(stores[0]) == os.path.realpath(stores[0])\n   714\t    link = tmp_path / 'link.sqlite'\n   715\t    link.symlink_to(stores[0])\n   716\t    assert release.store_path(link) == os.path.realpath(stores[0])          # the opener is given the target, with nothing left to follow\n   717\t\n   718\t\n   719\tDRIVER = \"\"\"import sys\n   720\tsys.path.insert(0, sys.argv[1])\n   721\tfrom hivemind import release, service\n   722\tfrom hivemind.views import store\n   723\tviews, items = service.open_ledger(sys.argv[2]), store.open_read_only(sys.argv[3])\n   724\ttry:\n   725\t    data = release.release_export(views, items)\n   726\t    print('returned', sorted(data['questions'][0]))\n   727\texcept release.ReleaseRefused as error:\n   728\t    print('refused', error)\n   729\t\"\"\"\n   730\tWRITER_FAULT = (\"                record['forecast'] = FORECAST_UNAVAILABLE\\n            else:\\n                record['answers'] = labels\\n                record['answer'] = _answer(\",\n   731\t                \"                record['forecast'] = FORECAST_UNAVAILABLE\\n                record['condition'] = 'FY2027 revenue is at least $350 billion'\\n            else:\\n\"\n   732\t                \"                record['answers'] = labels\\n                record['answer'] = _answer(\")\n   733\tSELF_CHECK = (\"    check_export(data)\\n    return data\\n\", \"    return data\\n\")\n   734\t\n   735\t\n   736\tdef test_25_the_writer_refuses_its_own_off_list_field(stores, tmp_path):\n   737\t    \"\"\"§1 release_export (AGENTS §3, council 75), the mutation pair: a writer fault adding `condition` is refused inside\n   738\t    `release_export`; with the writer's own check removed, the off-list field is returned.\"\"\"\n   739\t    driver = tmp_path / 'driver.py'\n   740\t    driver.write_text(DRIVER)\n   741\t    for name, edits, expected in (('fault', [WRITER_FAULT], 'refused'), ('unchecked', [WRITER_FAULT, SELF_CHECK], 'returned')):\n   742\t        command = scratch(tmp_path / name, [('src/hivemind/release.py', *edit) for edit in edits])\n   743\t        result = subprocess.run([sys.executable, str(driver), str(command.parents[1] / 'src'), str(stores[0]), str(stores[1])], capture_output=True, text=True,\n   744\t                                env={**os.environ, 'PYTHONDONTWRITEBYTECODE': '1'})\n   745\t        assert result.stdout.startswith(expected), (name, result.stdout, result.stderr)\n   746\t        if name == 'unchecked':\n   747\t            assert result.stdout.strip() == \"returned ['class', 'condition', 'evidence', 'forecast', 'id', 'open', 'question']\", result.stdout\n   748\t        else:\n   749\t            assert result.stdout.strip() == \"refused question 0: keys off the allow-list ['condition'], missing []\", result.stdout\n   750\t\n   751\t\n   752\t# ---------- slice 2: the reader's page (RELEASE-PAGE.md revision 7)\n   753\t\n   754\timport base64  # noqa: E402\n   755\timport re  # noqa: E402\n   756\t\n   757\tNETWORK_APIS = ('fetch', 'XMLHttpRequest', 'WebSocket', 'EventSource', 'sendBeacon', 'import(', 'Worker', 'innerHTML', 'outerHTML',\n   758\t                'insertAdjacentHTML', 'document.write', 'eval(', 'Function(', \"createElement('a')\", 'href', 'src')\n   759\tCLIPPING_PROPERTIES = ('content', 'overflow', 'overflow-x', 'overflow-y', 'clip', 'clip-path', 'contain', 'text-overflow', 'line-clamp',\n   760\t                       '-webkit-line-clamp', 'max-height', 'opacity', 'visibility')\n   761\t\n   762\t\n   763\tdef test_26_the_page_is_a_pure_function_of_the_data_with_literal_escapes():\n   764\t    \"\"\"RELEASE-PAGE.md §5 tests 1 and 2: the same data gives the same page; <, >, &, U+2028 and U+2029 become their six-character\n   765\t    JSON escapes, so the data block cannot close or comment out, and it parses back to the same data.\"\"\"\n   766\t    hostile = '</script><img src=x onerror=alert(1)> & a line' + chr(0x2028) + 'break' + chr(0x2029) + '<!--'\n   767\t    payload = json.dumps({'quote': hostile}, ensure_ascii=False).encode()\n   768\t    page = release.render_page(payload)\n   769\t    assert page == release.render_page(payload)\n   770\t    block = page.decode().split('<script type=\"application/json\" id=\"release-data\">')[1].split('</script>')[0]\n   771\t    backslash = chr(92)\n   772\t    assert block == payload.decode().replace('<', backslash + 'u003c').replace('>', backslash + 'u003e').replace('&', backslash + 'u0026') \\\n   773\t        .replace(chr(0x2028), backslash + 'u2028').replace(chr(0x2029), backslash + 'u2029')\n   774\t    assert '</script' not in block and '<!--' not in block and json.loads(block) == {'quote': hostile}\n   775\t    assert page.decode().count('<script') == 2\n   776\t\n   777\t\n   778\tdef test_27_the_template_has_no_network_code_drawn_text_or_clipping():\n   779\t    \"\"\"RELEASE-PAGE.md §5 test 3: the script uses no network or markup-writing API and makes no link; the stylesheet draws no text and\n   780\t    clips nothing; the CSP is exactly the designed policy with the hashes of the template's own script and style; charset and CSP\n   781\t    come first.\"\"\"\n   782\t    for api in NETWORK_APIS:\n   783\t        assert api not in release.PAGE_SCRIPT, api\n   784\t    for name in CLIPPING_PROPERTIES:\n   785\t        assert not re.search(r'(?<![-\\w])' + re.escape(name) + r'\\s*:', release.PAGE_STYLE), name\n   786\t    assert 'nowrap' not in release.PAGE_STYLE\n   787\t    digest = lambda text: \"'sha256-\" + base64.b64encode(hashlib.sha256(text.encode()).digest()).decode() + \"'\"\n   788\t    csp = (f\"default-src 'none'; script-src {digest(release.PAGE_SCRIPT)}; style-src {digest(release.PAGE_STYLE)}; img-src 'none'; \"\n   789\t           \"font-src 'none'; connect-src 'none'; base-uri 'none'; form-action 'none'\")\n   790\t    template = release.page_template()\n   791\t    assert template.startswith('<!doctype html>\\n<html lang=\"en\">\\n<head>\\n<meta charset=\"utf-8\">\\n'\n   792\t                               f'<meta http-equiv=\"Content-Security-Policy\" content=\"{csp}\">\\n')\n   793\t    assert template.count(release.DATA_PLACEHOLDER) == 1\n   794\t\n   795\t\n   796\tdef test_28_the_package_page_must_be_the_page_of_its_data(stores, tmp_path):\n   797\t    \"\"\"RELEASE-PAGE.md §5 test 4: a page changed by one byte, or with a fetch added and its CSP and hashes updated, is refused because\n   798\t    it is not render_page(data); a correct page with only its manifest hash wrong is refused for that reason; a fourth file is\n   799\t    refused.\"\"\"\n   800\t    out = tmp_path / 'release'\n   801\t    build_package(stores, out)\n   802\t    assert check(stores, out)['fields_compared'] == FIXTURE_COUNTS['fields_compared']\n   803\t\n   804\t    def copy_with(name, page=None, page_hash=None):\n   805\t        target = tmp_path / name\n   806\t        shutil.copytree(out, target)\n   807\t        if page is not None:\n   808\t            (target / release.PAGE_FILE).write_bytes(page)\n   809\t        manifest = json.loads((target / release.MANIFEST_FILE).read_text())\n   810\t        manifest['page_sha256'] = page_hash or hashlib.sha256((target / release.PAGE_FILE).read_bytes()).hexdigest()\n   811\t        (target / release.MANIFEST_FILE).write_text(json.dumps(manifest))\n   812\t        return target\n   813\t\n   814\t    original = (out / release.PAGE_FILE).read_bytes()\n   815\t    one_byte = copy_with('one-byte', original.replace(b'needs JavaScript', b'needs Javascript'))\n   816\t    refused_with(lambda: check(stores, one_byte), 'the page is not the page made from its data')\n   817\t    script = release.PAGE_SCRIPT\n   818\t    added = script.replace(\"(function(){'use strict';\", \"(function(){'use strict';fetch('http://127.0.0.1:59999/library').catch(function(){});\")\n   819\t    digest = lambda text: \"'sha256-\" + base64.b64encode(hashlib.sha256(text.encode()).digest()).decode() + \"'\"\n   820\t    fetching = original.decode().replace(script, added).replace(digest(script), digest(added)).encode()\n   821\t    assert fetching != original\n   822\t    refused_with(lambda: check(stores, copy_with('fetching', fetching)), 'the page is not the page made from its data')\n   823\t    wrong_hash = copy_with('wrong-hash', page_hash='0' * 64)\n   824\t    refused_with(lambda: check(stores, wrong_hash), 'the manifest page_sha256 does not match the page')\n   825\t    fourth = tmp_path / 'fourth'\n   826\t    shutil.copytree(out, fourth)\n   827\t    (fourth / 'extra.html').write_text('<p>x</p>')\n   828\t    refused_with(lambda: check(stores, fourth), f\"{fourth}: holds ['extra.html', 'index.html', 'manifest.json', 'release-data.json'], \"\n   829\t                                                \"not exactly ['index.html', 'manifest.json', 'release-data.json']\")\n   830\t\n   831\t\n   832\tCERTIFIED_TEMPLATE_SHA256 = 'f94bb3cbf5ba1030ee37f0111b78bf2e58f7f767d77aa7e7d2443677e5811ae2'   # certified by poc/data/release-screen-2026-11-23b\n   833\t\n   834\t\n   835\tdef test_29_the_page_template_is_the_one_the_screen_run_certified():\n   836\t    \"\"\"RELEASE-PAGE.md revision 7, test 3: the whole page template, with its data placeholder, is the one the $0 screen run certified\n   837\t    (poc/data/release-screen-2026-11-23b); any change to any part of it fails here until a new screen run certifies it.\"\"\"\n   838\t    assert hashlib.sha256(release.page_template().encode('utf-8')).hexdigest() == CERTIFIED_TEMPLATE_SHA256\n","exit_code":0,"status":"completed"}}
