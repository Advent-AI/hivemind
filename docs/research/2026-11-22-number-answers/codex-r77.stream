{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc 'nl -ba docs/research/2026-11-22-number-answers/release_screen_prepare.py'","aggregated_output":"     1\t\"\"\"Prepare the $0 screen check of RELEASE-PAGE.md §6: build the format-2 pages with the real command, and freeze screen-expected.json\n     2\tfrom the accepted slice-1 packages before the first screen run.\n     3\t\n     4\t    python3 docs/research/2026-11-22-number-answers/release_screen_prepare.py <new run folder>\n     5\t\n     6\tThe expected file is written from the data of `poc/data/release-check-2026-11-23g/` (the packages council 75g accepted), not from the\n     7\tpages under test, and its sha256 is printed for the result.\"\"\"\n     8\timport hashlib\n     9\timport json\n    10\timport shutil\n    11\timport subprocess\n    12\timport sys\n    13\tfrom pathlib import Path\n    14\t\n    15\tREPO = Path(__file__).resolve().parents[3]\n    16\tsys.path.insert(0, str(REPO / 'src'))\n    17\tsys.path.insert(0, str(REPO / 'tests'))\n    18\tfrom hivemind import release, service  # noqa: E402\n    19\tfrom hivemind.views import store  # noqa: E402\n    20\t\n    21\tACCEPTED = REPO / 'poc/data/release-check-2026-11-23g'\n    22\tCOMPARISON_ITEMS = REPO / 'poc/data/comparison-2026-11-17/items-comparison.sqlite'\n    23\tOLD = {name: REPO / f'poc/data/comparison-2026-11-17/run/{name}/prod/views.sqlite' for name in ('old-1', 'old-3')}\n    24\tDOT = f' {chr(0xb7)} '\n    25\tESCAPE_QUOTE = '</script><img src=x onerror=alert(1)> & a line' + chr(0x2028) + 'break'\n    26\t\n    27\t\n    28\tdef counts_line(questions):\n    29\t    n = {kind: sum(q['class'] == kind for q in questions) for kind in ('number', 'event', 'yes_no')}\n    30\t    return f\"{n['number']} number questions{DOT}{n['event']} event questions{DOT}{n['yes_no']} Yes/No questions\"\n    31\t\n    32\t\n    33\tdef kept(texts):\n    34\t    \"\"\"The page's reading rule: each text trimmed, empty texts dropped.\"\"\"\n    35\t    return [t.strip() for t in texts if t and t.strip()]\n    36\t\n    37\t\n    38\tdef card_top(q):\n    39\t    n = len(q['evidence'])\n    40\t    status = 'Open' if q['open'] else 'Closed'\n    41\t    shown = q['forecast'] if q['class'] == 'number' else ('Not yet answered' if q['answer'] is None else f\"Answer: {q['answer']}\")\n    42\t    count = 'No evidence in force' if n == 0 else f\"{n} {'piece' if n == 1 else 'pieces'} of evidence\"\n    43\t    return kept([q['question'], status, shown, count])\n    44\t\n    45\t\n    46\tdef group(e):\n    47\t    day = f\", {e['original_day']}\" if e['original_day'] else ''           # the page adds the day only when there is one\n    48\t    texts = [e['one_line'], e['quote'], f\"{e['tier']}{DOT}{e['speaker']}{DOT}original: {e['original_who']}{day}\"]\n    49\t    for s in e['sources']:\n    50\t        texts += [s['title'], s['publisher'], s['day'], s['uri']]\n    51\t    return kept(texts)\n    52\t\n    53\t\n    54\tdef frozen_page(data, checked):\n    55\t    header = kept(['Hivemind release', f\"As of {data['as_of']}\", counts_line(data['questions'])])\n    56\t    cards = [{'id': q['id'], 'top': card_top(q), 'groups': []} for q in data['questions']]\n    57\t    collapsed = {'header': header, 'cards': cards, 'other': [], 'clipped': [], 'unreadable': []}\n    58\t    expanded = json.loads(json.dumps(collapsed))\n    59\t    target = next(c for c in expanded['cards'] if c['id'] == checked)\n    60\t    target['groups'] = [group(e) for e in next(q for q in data['questions'] if q['id'] == checked)['evidence']]\n    61\t    return {'count': len(data['questions']), 'collapsed': collapsed, 'expanded': expanded}\n    62\t\n    63\t\n    64\tdef build(ledger, items, out, as_of=None):\n    65\t    args = [sys.executable, str(REPO / 'scripts/release_build.py'), 'build', '--ledger', str(ledger), '--items', str(items), '--out', str(out)]\n    66\t    result = subprocess.run(args + (['--as-of', as_of] if as_of else []), capture_output=True, text=True, env={'PATH': '/usr/bin:/bin', 'PYTHONDONTWRITEBYTECODE': '1'})\n    67\t    if result.returncode:\n    68\t        raise SystemExit(f'build {out}: {result.stderr}')\n    69\t\n    70\t\n    71\tdef main(run):\n    72\t    run = Path(run).absolute()\n    73\t    run.mkdir()\n    74\t    build(OLD['old-1'], COMPARISON_ITEMS, run / 'old-1')\n    75\t    build(OLD['old-3'], COMPARISON_ITEMS, run / 'old-3-0825', '2026-08-25')\n    76\t    build(OLD['old-1'], COMPARISON_ITEMS, run / 'old-1-0828', '2026-08-28')\n    77\t    import test_release as fixture                                  # the test suite's fixture store, plus one hostile quote\n    78\t    scratch = run / '.escape-stores'\n    79\t    scratch.mkdir()\n    80\t    views, items = fixture.make_store(scratch / 'views.sqlite'), fixture.make_items(scratch / 'items.sqlite')\n    81\t    conn = store.open_db(str(views))\n    82\t    fixture.evidence(conn, 'e9', 'v6', 1, 'A hostile quote, shown as text.', ESCAPE_QUOTE, [('item-1', 1)])\n    83\t    conn.commit()\n    84\t    conn.close()\n    85\t    build(views, items, run / 'escape')\n    86\t    data = lambda folder: json.loads((ACCEPTED / folder / 'release-data.json').read_text())\n    87\t    expected = {\n    88\t        'accepted': str(ACCEPTED),\n    89\t        'pages': {'old-1/v8': frozen_page(data('old-1/package'), 'v8'),\n    90\t                  'old-3/v36@2026-08-25': frozen_page(data('old-3/package-2026-08-25'), 'v36'),\n    91\t                  'old-1/v10@2026-08-28': frozen_page(data('old-1/package-2026-08-28'), 'v10')},\n    92\t        'morningstar_quote': next(e['quote'] for q in data('old-1/package')['questions'] for e in q['evidence'] if e['id'] == 'e2295'),\n    93\t        'escape': {'question': 'v6', 'quote': ESCAPE_QUOTE.strip(), 'count': 7},\n    94\t    }\n    95\t    path = run / 'screen-expected.json'\n    96\t    path.write_text(json.dumps(expected, ensure_ascii=False, indent=1))\n    97\t    print('screen-expected.json sha256', hashlib.sha256(path.read_bytes()).hexdigest())\n    98\t\n    99\t\n   100\tif __name__ == '__main__':\n   101\t    main(sys.argv[1])\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_14","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc 'nl -ba docs/research/2026-11-22-number-answers/release_screen.mjs'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc 'nl -ba docs/research/2026-11-22-number-answers/release_screen.mjs'","aggregated_output":"     1\t/**\n     2\t * The $0 screen check of RELEASE-PAGE.md §6: headless Chrome through its DevTools protocol (Node's built-in WebSocket), each page\n     3\t * opened from file://, every visible text of each checked card compared with the frozen list in screen-expected.json.\n     4\t *\n     5\t *   node release_screen.mjs <run folder> <screen-expected.json>\n     6\t *\n     7\t * The run folder holds old-1/index.html, old-3-0825/index.html, old-1-0828/index.html and escape/index.html. The two negative\n     8\t * pages (a restored fetch, an extra visible forecast line) are written into the run folder from old-1's page. Exits 1 when any\n     9\t * check fails, including a negative page that passes.\n    10\t */\n    11\timport { spawn } from 'node:child_process';\n    12\timport { createHash } from 'node:crypto';\n    13\timport fs from 'node:fs';\n    14\timport path from 'node:path';\n    15\t\n    16\tconst [runFolder, expectedPath] = process.argv.slice(2).map((p) => path.resolve(p));   // file:// needs an absolute path\n    17\tconst expectedBytes = fs.readFileSync(expectedPath);\n    18\tconst expected = JSON.parse(expectedBytes);\n    19\tconst CHROME = '/Applications/Google Chrome.app/Contents/MacOS/Google Chrome';\n    20\tconst results = { expected_sha256: createHash('sha256').update(expectedBytes).digest('hex'), pages: {}, failures: [] };\n    21\tconst fail = (where, what) => results.failures.push(`${where}: ${what}`);\n    22\t\n    23\tfunction cspHash(text) {\n    24\t  return `'sha256-${createHash('sha256').update(text, 'utf8').digest('base64')}'`;\n    25\t}\n    26\t\n    27\t/** A copy of a page with its inline script edited and the CSP script hash recomputed, so the edited script runs. */\n    28\tfunction mutate(source, target, edit) {\n    29\t  const page = fs.readFileSync(source, 'utf8');\n    30\t  const start = page.lastIndexOf('<script>') + '<script>'.length;\n    31\t  const end = page.lastIndexOf('</script>');\n    32\t  const script = page.slice(start, end);\n    33\t  const changed = edit(script);\n    34\t  if (changed === script) throw new Error(`mutation of ${source} changed nothing`);\n    35\t  const out = (page.slice(0, start) + changed + page.slice(end)).replace(cspHash(script), cspHash(changed));\n    36\t  fs.mkdirSync(path.dirname(target), { recursive: true });\n    37\t  fs.writeFileSync(target, out);\n    38\t}\n    39\t\n    40\tasync function browser() {\n    41\t  const profile = fs.mkdtempSync(path.join(runFolder, '.chrome-'));\n    42\t  const chrome = spawn(CHROME, ['--headless=new', '--disable-gpu', '--no-first-run', '--no-default-browser-check', `--user-data-dir=${profile}`,\n    43\t                                '--remote-debugging-port=0', 'about:blank'], { stdio: 'ignore' });\n    44\t  let port;\n    45\t  for (let i = 0; i < 200 && !port; i++) {\n    46\t    await new Promise((r) => setTimeout(r, 50));\n    47\t    try { port = fs.readFileSync(path.join(profile, 'DevToolsActivePort'), 'utf8').split('\\n')[0]; } catch { /* not yet */ }\n    48\t  }\n    49\t  if (!port) throw new Error('Chrome did not open its debugging port');\n    50\t  return { chrome, port };\n    51\t}\n    52\t\n    53\tasync function session(port) {\n    54\t  const target = await (await fetch(`http://127.0.0.1:${port}/json/new?about:blank`, { method: 'PUT' })).json();\n    55\t  const ws = new WebSocket(target.webSocketDebuggerUrl);\n    56\t  await new Promise((r) => ws.addEventListener('open', r));\n    57\t  let id = 0;\n    58\t  const pending = new Map();\n    59\t  const events = [];\n    60\t  ws.addEventListener('message', (m) => {\n    61\t    const d = JSON.parse(m.data);\n    62\t    if (d.id && pending.has(d.id)) { pending.get(d.id)(d); pending.delete(d.id); } else events.push(d);\n    63\t  });\n    64\t  const send = (method, params = {}) => new Promise((r) => { const n = ++id; pending.set(n, r); ws.send(JSON.stringify({ id: n, method, params })); });\n    65\t  const evaluate = async (expression) => {\n    66\t    const answer = await send('Runtime.evaluate', { expression, returnByValue: true, awaitPromise: true });\n    67\t    if (answer.result?.exceptionDetails) throw new Error(`page evaluation failed: ${answer.result.exceptionDetails.text}`);\n    68\t    return answer.result.result.value;\n    69\t  };\n    70\t  for (const domain of ['Network', 'Log', 'Runtime', 'Page']) await send(`${domain}.enable`);\n    71\t  return { ws, send, evaluate, events };\n    72\t}\n    73\t\n    74\tconst VISIBLE = `((e) => e.checkVisibility({ opacityProperty: true, visibilityProperty: true, contentVisibilityAuto: true })\n    75\t  && e.getBoundingClientRect().width > 0 && e.getBoundingClientRect().height > 0)`;\n    76\tconst TOGGLE = `(async (id, open) => {\n    77\t  const card = [...document.querySelectorAll('article.question')].find((a) => a.dataset.id === id);\n    78\t  const details = card && card.querySelector('details');\n    79\t  if (details && details.open !== open) { details.open = open; await new Promise((r) => setTimeout(r, 50)); }\n    80\t  return Boolean(card);\n    81\t})`;\n    82\tconst READ_PAGE = `(() => {\n    83\t  const visible = ${VISIBLE};\n    84\t  const page = { header: [], cards: [], other: [], clipped: [], unreadable: [] };\n    85\t  const rgb = (c) => { const m = c.match(/rgba?\\\\(([^)]+)\\\\)/); if (!m) return null; const v = m[1].split(',').map((x) => parseFloat(x)); return { r: v[0], g: v[1], b: v[2], a: v.length > 3 ? v[3] : 1 }; };\n    86\t  const lum = ({ r, g, b }) => { const f = (x) => { x /= 255; return x <= 0.03928 ? x / 12.92 : ((x + 0.055) / 1.055) ** 2.4; }; return 0.2126 * f(r) + 0.7152 * f(g) + 0.0722 * f(b); };\n    87\t  const background = (e) => { for (let a = e; a; a = a.parentElement) { const c = rgb(getComputedStyle(a).backgroundColor); if (c && c.a > 0) return c; } return rgb(getComputedStyle(document.documentElement).backgroundColor) || { r: 255, g: 255, b: 255, a: 1 }; };\n    88\t  const contrast = (e) => { const f = lum(rgb(getComputedStyle(e).color)), b = lum(background(e)); return (Math.max(f, b) + 0.05) / (Math.min(f, b) + 0.05); };\n    89\t  const clippingAncestor = (e) => { for (let a = e.parentElement; a && a !== document.body; a = a.parentElement) { const s = getComputedStyle(a);\n    90\t    if (s.overflowX !== 'visible' || s.overflowY !== 'visible' || /paint|strict|content/.test(s.contain) || s.clipPath !== 'none') return true; } return false; };\n    91\t  const byId = new Map();\n    92\t  const walker = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT);\n    93\t  for (let n = walker.nextNode(); n; n = walker.nextNode()) {\n    94\t    const text = n.textContent.trim();\n    95\t    const owner = n.parentElement;\n    96\t    if (!text || !owner || owner.closest('script') || !visible(owner)) continue;\n    97\t    if ((getComputedStyle(owner).display !== 'inline' && (owner.scrollWidth > owner.clientWidth + 1 || owner.scrollHeight > owner.clientHeight + 1)) || clippingAncestor(owner)) {\n    98\t      page.clipped.push(text.slice(0, 80));\n    99\t    }\n   100\t    if (contrast(owner) < 4.5) page.unreadable.push(text.slice(0, 80));\n   101\t    const card = owner.closest('article.question');\n   102\t    if (owner.closest('header.release-header')) { page.header.push(text); continue; }\n   103\t    if (!card) { page.other.push(text); continue; }\n   104\t    let entry = byId.get(card.dataset.id);\n   105\t    if (!entry) { entry = { id: card.dataset.id, top: [], groups: [] }; byId.set(card.dataset.id, entry); page.cards.push(entry); }\n   106\t    const item = owner.closest('li.evidence-item');\n   107\t    if (!item) { entry.top.push(text); continue; }\n   108\t    const index = [...card.querySelectorAll('li.evidence-item')].indexOf(item);\n   109\t    while (entry.groups.length <= index) entry.groups.push([]);\n   110\t    entry.groups[index].push(text);\n   111\t  }\n   112\t  for (const entry of page.cards) entry.groups = entry.groups.filter((g) => g.length);\n   113\t  return page;\n   114\t})()`;\n   115\t\n   116\tconst same = (a, b) => JSON.stringify(a) === JSON.stringify(b);\n   117\t\n   118\tasync function open(port, file, count, { media, metrics } = {}) {\n   119\t  const s = await session(port);\n   120\t  if (metrics) await s.send('Emulation.setDeviceMetricsOverride', metrics);\n   121\t  if (media) await s.send('Emulation.setEmulatedMedia', { features: media });\n   122\t  const started = performance.now();\n   123\t  await s.send('Page.navigate', { url: `file://${file}` });\n   124\t  let seconds = null;\n   125\t  for (let i = 0; i < 160; i++) {\n   126\t    const ready = await s.evaluate(`(() => { const visible = ${VISIBLE}; const cards = [...document.querySelectorAll('article.question')];\n   127\t      return document.getElementById('fallback') === null && cards.length === ${count} && cards.every(visible); })()`).catch(() => false);\n   128\t    if (ready) { seconds = (performance.now() - started) / 1000; break; }\n   129\t    await new Promise((r) => setTimeout(r, 25));\n   130\t  }\n   131\t  return { ...s, seconds };\n   132\t}\n   133\t\n   134\tfunction signals(events) {\n   135\t  const requests = events.filter((e) => e.method === 'Network.requestWillBeSent').map((e) => e.params.request.url);\n   136\t  const errors = events.filter((e) => (e.method === 'Log.entryAdded' && e.params.entry.level === 'error')\n   137\t    || e.method === 'Runtime.exceptionThrown' || (e.method === 'Runtime.consoleAPICalled' && e.params.type === 'error'))\n   138\t    .map((e) => e.params.entry ? `${e.params.entry.source}: ${e.params.entry.text}` : e.method);\n   139\t  return { requests, errors };\n   140\t}\n   141\t\n   142\t/** The whole read page, collapsed, with the card expanded, and after closing and reopening it, against the frozen pages. */\n   143\tasync function checkPage(s, where, id, frozen) {\n   144\t  await s.evaluate(`${TOGGLE}(${JSON.stringify(id)}, false)`);\n   145\t  const collapsed = await s.evaluate(READ_PAGE);\n   146\t  await s.evaluate(`${TOGGLE}(${JSON.stringify(id)}, true)`);\n   147\t  const expanded = await s.evaluate(READ_PAGE);\n   148\t  await s.evaluate(`${TOGGLE}(${JSON.stringify(id)}, false)`);\n   149\t  await s.evaluate(`${TOGGLE}(${JSON.stringify(id)}, true)`);\n   150\t  const reopened = await s.evaluate(READ_PAGE);\n   151\t  const outcome = { collapsed: same(collapsed, frozen.collapsed), expanded: same(expanded, frozen.expanded), reopened: same(reopened, frozen.expanded) };\n   152\t  for (const [k, v] of Object.entries(outcome)) if (!v) fail(where, `${id} ${k} page differs from the frozen page`);\n   153\t  const card = expanded.cards.find((c) => c.id === id);\n   154\t  return { outcome, other: expanded.other, card_top: card ? card.top : null, card_groups: card ? card.groups.length : null };\n   155\t}\n   156\t\n   157\tconst { chrome, port } = await browser();\n   158\tconst PHONE = { width: 390, height: 844, deviceScaleFactor: 2, mobile: true };\n   159\tconst DARK = [{ name: 'prefers-color-scheme', value: 'dark' }];\n   160\tconst LIGHT = [{ name: 'prefers-color-scheme', value: 'light' }];   // headless Chrome follows the system scheme unless told\n   161\ttry {\n   162\t  const old1 = path.join(runFolder, 'old-1', 'index.html');\n   163\t  const v8 = expected.pages['old-1/v8'];\n   164\t  {\n   165\t    const s = await open(port, old1, v8.count, { media: LIGHT });\n   166\t    const page = { seconds: s.seconds, check: await checkPage(s, 'old-1', 'v8', v8) };\n   167\t    page.links = await s.evaluate(`document.querySelectorAll('a,[href],[src]').length`);\n   168\t    if (page.links !== 0) fail('old-1', `${page.links} links or sources`);\n   169\t    page.light_background = await s.evaluate(`getComputedStyle(document.body).backgroundColor`);\n   170\t    if (page.light_background !== 'rgb(245, 242, 235)') fail('old-1', `light background ${page.light_background}`);\n   171\t    const top = await s.evaluate(`(() => { const c = [...document.querySelectorAll('article.question')].find((a) => a.dataset.id === 'v8'); return c.getBoundingClientRect().top + window.scrollY; })()`);\n   172\t    const shot = await s.send('Page.captureScreenshot', { format: 'png', clip: { x: 0, y: Math.max(0, top - 16), width: 900, height: 1100, scale: 1 }, captureBeyondViewport: true });\n   173\t    if (shot.result?.data) fs.writeFileSync(path.join(runFolder, 'old-1-v8.png'), Buffer.from(shot.result.data, 'base64'));\n   174\t    page.signals = signals(s.events);\n   175\t    if (page.signals.requests.length !== 1 || !page.signals.requests[0].endsWith('/old-1/index.html')) fail('old-1', `requests ${page.signals.requests}`);\n   176\t    if (page.signals.errors.length) fail('old-1', `errors ${page.signals.errors}`);\n   177\t    page.size = fs.statSync(old1).size;\n   178\t    page.data_size = fs.statSync(path.join(runFolder, 'old-1', 'release-data.json')).size;\n   179\t    if (page.size > page.data_size + 65536) fail('old-1', `page ${page.size} bytes over data ${page.data_size} + 64 KB`);\n   180\t    if (s.seconds === null || s.seconds > 3) fail('old-1', `rendered in ${s.seconds} s`);\n   181\t    s.ws.close();\n   182\t    results.pages['old-1'] = page;\n   183\t  }\n   184\t  {\n   185\t    const s = await open(port, old1, v8.count, { metrics: PHONE, media: DARK });\n   186\t    const phone = { check: await checkPage(s, 'old-1 phone', 'v8', v8) };\n   187\t    phone.scroll_width = await s.evaluate(`document.scrollingElement.scrollWidth`);\n   188\t    phone.dark_background = await s.evaluate(`getComputedStyle(document.body).backgroundColor`);\n   189\t    phone.morningstar = await s.evaluate(`(() => {\n   190\t      const quote = [...document.querySelectorAll('.evidence-quote')].find((q) => q.textContent === ${JSON.stringify(expected.morningstar_quote)});\n   191\t      if (!quote) return null;\n   192\t      quote.scrollIntoView();\n   193\t      const range = document.createRange(); range.selectNodeContents(quote);\n   194\t      const box = quote.getBoundingClientRect();\n   195\t      return { lines: new Set([...range.getClientRects()].map((r) => Math.round(r.top))).size, left: box.left, right: box.right };\n   196\t    })()`);\n   197\t    if (phone.scroll_width > 390) fail('old-1 phone', `scroll width ${phone.scroll_width}`);\n   198\t    if (phone.dark_background !== 'rgb(15, 20, 13)') fail('old-1 dark', `background ${phone.dark_background}`);\n   199\t    if (!phone.morningstar || phone.morningstar.lines < 2 || phone.morningstar.left < 0 || phone.morningstar.right > 390) fail('old-1 phone', `Morningstar quote ${JSON.stringify(phone.morningstar)}`);\n   200\t    s.ws.close();\n   201\t    results.pages['old-1 phone dark'] = phone;\n   202\t  }\n   203\t  for (const [folder, key, id] of [['old-3-0825', 'old-3/v36@2026-08-25', 'v36'], ['old-1-0828', 'old-1/v10@2026-08-28', 'v10']]) {\n   204\t    const frozen = expected.pages[key];\n   205\t    const s = await open(port, path.join(runFolder, folder, 'index.html'), frozen.count);\n   206\t    const page = { check: await checkPage(s, key, id, frozen), signals: signals(s.events) };\n   207\t    if (page.signals.errors.length) fail(key, `errors ${page.signals.errors}`);\n   208\t    s.ws.close();\n   209\t    results.pages[key] = page;\n   210\t  }\n   211\t  {\n   212\t    const s = await open(port, path.join(runFolder, 'escape', 'index.html'), expected.escape.count);\n   213\t    await s.evaluate(`${TOGGLE}(${JSON.stringify(expected.escape.question)}, true)`);\n   214\t    const page = {\n   215\t      quote_visible: await s.evaluate(`[...document.querySelectorAll('.evidence-quote')].some((q) => q.textContent === ${JSON.stringify(expected.escape.quote)})`),\n   216\t      images: await s.evaluate(`document.querySelectorAll('img').length`),\n   217\t      signals: signals(s.events),\n   218\t    };\n   219\t    if (!page.quote_visible) fail('escape', 'the quote is not shown as text');\n   220\t    if (page.images !== 0) fail('escape', `${page.images} img elements`);\n   221\t    if (page.signals.errors.length) fail('escape', `errors ${page.signals.errors}`);\n   222\t    s.ws.close();\n   223\t    results.pages.escape = page;\n   224\t  }\n   225\t  // the negative pages: each must be caught for its own reason\n   226\t  const negative = async (name, edit, options, judge) => {\n   227\t    const target = path.join(runFolder, `mutant-${name}`, 'index.html');\n   228\t    mutate(old1, target, edit);\n   229\t    const s = await open(port, target, v8.count, options);\n   230\t    const before = results.failures.length;\n   231\t    const verdict = await judge(s);\n   232\t    results.failures.splice(before);                  // a negative page's own failures are its expected outcome\n   233\t    results.pages[`mutant-${name}`] = verdict;\n   234\t    if (!verdict.caught) fail(`mutant-${name}`, 'not caught');\n   235\t    s.ws.close();\n   236\t  };\n   237\t  const ENTRY = \"(function(){'use strict';\";\n   238\t  const FORECAST = \"if(q['class']==='number'){card.appendChild(el('p','question-forecast',q.forecast));}\";\n   239\t  await negative('fetch', (x) => x.replace(ENTRY, `${ENTRY}fetch('http://127.0.0.1:59999/library').catch(function(){});`), {}, async (s) => {\n   240\t    const sig = signals(s.events);\n   241\t    const named = sig.errors.some((e) => e.startsWith('security:') && e.includes('http://127.0.0.1:59999/library') && e.includes('connect-src'));\n   242\t    return { caught: s.seconds !== null && named, rendered: s.seconds !== null, named };\n   243\t  });\n   244\t  await negative('line-inside', (x) => x.replace(FORECAST, `${FORECAST.slice(0, -1)}if(q.id==='v8'){card.appendChild(el('p','note','Forecast: $361 billion'));}}`), {}, async (s) => {\n   245\t    const check = await checkPage(s, 'line-inside', 'v8', v8);\n   246\t    return { caught: !check.outcome.collapsed, card_top: check.card_top };\n   247\t  });\n   248\t  await negative('line-beside', (x) => x.replace(\"root.appendChild(card);}\", \"if(q.id==='v8'){root.appendChild(el('p','note','Forecast: $361 billion'));}root.appendChild(card);}\"), {}, async (s) => {\n   249\t    const check = await checkPage(s, 'line-beside', 'v8', v8);\n   250\t    return { caught: !check.outcome.collapsed && check.other.includes('Forecast: $361 billion'), other: check.other };\n   251\t  });\n   252\t  await negative('transparent', (x) => x.replace(\"var root=document.getElementById('release');\", \"var root=document.getElementById('release');root.style.opacity='0';\"), {}, async (s) => {\n   253\t    return { caught: s.seconds === null || s.seconds > 3, seconds: s.seconds };\n   254\t  });\n   255\t  await negative('clipped', (x) => x.replace(\"item.appendChild(el('blockquote','evidence-quote',e.quote));\",\n   256\t    \"var bq=el('blockquote','evidence-quote',e.quote);bq.style.whiteSpace='nowrap';bq.style.overflow='hidden';bq.style.textOverflow='ellipsis';item.appendChild(bq);\"),\n   257\t  { metrics: PHONE }, async (s) => {\n   258\t    await s.evaluate(`${TOGGLE}('v8', true)`);\n   259\t    const page = await s.evaluate(READ_PAGE);\n   260\t    return { caught: page.clipped.length > 0, clipped: page.clipped.length };\n   261\t  });\n   262\t  await negative('clipping-wrapper', (x) => x.replace(\"item.appendChild(el('blockquote','evidence-quote',e.quote));\",\n   263\t    \"var wrap=el('div','quote-wrap');wrap.style.contain='paint';wrap.style.height='1.5em';wrap.appendChild(el('blockquote','evidence-quote',e.quote));item.appendChild(wrap);\"),\n   264\t  { metrics: PHONE }, async (s) => {\n   265\t    await s.evaluate(`${TOGGLE}('v8', true)`);\n   266\t    const page = await s.evaluate(READ_PAGE);\n   267\t    return { caught: page.clipped.length > 0, clipped: page.clipped.length };\n   268\t  });\n   269\t  await negative('own-background', (x) => x.replace(FORECAST, \"if(q['class']==='number'){var ob=el('p','question-forecast',q.forecast);ob.style.color='rgb(15, 20, 13)';ob.style.background='rgb(15, 20, 13)';card.appendChild(ob);}\"),\n   270\t  {}, async (s) => {\n   271\t    const page = await s.evaluate(READ_PAGE);\n   272\t    return { caught: page.unreadable.includes('Forecast unavailable'), unreadable: page.unreadable.length };\n   273\t  });\n   274\t  await negative('unreadable-marker', (x) => x.replace(FORECAST, \"if(q['class']==='number'){var mk=el('p','question-forecast',q.forecast);mk.style.color='rgb(15, 20, 13)';mk.style.background='rgb(15, 20, 13)';card.appendChild(mk);}\"),\n   275\t  { media: DARK }, async (s) => {\n   276\t    const page = await s.evaluate(READ_PAGE);\n   277\t    return { caught: page.unreadable.includes('Forecast unavailable'), unreadable: page.unreadable.length };\n   278\t  });\n   279\t} finally {\n   280\t  chrome.kill();\n   281\t}\n   282\tfs.writeFileSync(path.join(runFolder, 'screen-results.json'), JSON.stringify(results, null, 1));\n   283\tconsole.log(JSON.stringify({ failures: results.failures, seconds: results.pages['old-1']?.seconds, expected_sha256: results.expected_sha256 }, null, 1));\n   284\tprocess.exit(results.failures.length ? 1 : 0);\n","exit_code":0,"status":"completed"}}
