ng.get(d.id)(d); pending.delete(d.id); } else events.push(d); });\n    12\tconst send = (method, params = {}) => new Promise(r => { const n = ++id; pending.set(n, r); ws.send(JSON.stringify({ id: n, method, params })); });\n    13\tawait send('Network.enable'); await send('Log.enable'); await send('Runtime.enable'); await send('Page.enable');\n    14\tawait send('Page.navigate', { url: `file://${dir}/t.html` });\n    15\tawait new Promise(r => setTimeout(r, 1500));\n    16\tconst text = await send('Runtime.evaluate', { expression: 'document.getElementById(\"o\").textContent', returnByValue: true });\n    17\tfor (const e of events) {\n    18\t  if (e.method === 'Network.requestWillBeSent') console.log('REQUEST', e.params.request.url);\n    19\t  if (e.method === 'Network.loadingFailed') console.log('FAILED', e.params.blockedReason, e.params.errorText);\n    20\t  if (e.method === 'Log.entryAdded') console.log('LOG', e.params.entry.source, e.params.entry.level, e.params.entry.text.slice(0, 120));\n    21\t  if (e.method === 'Runtime.consoleAPICalled' || e.method === 'Runtime.exceptionThrown') console.log('RUNTIME', e.method);\n    22\t}\n    23\tconsole.log('TEXT', text.result.result.value);\n    24\tws.close(); chrome.kill();\ndrwxr-xr-x@   3 lchingen  wheel        96 Nov 20 08:00 a3-mutants\ndrwxr-xr-x@   8 lchingen  wheel       256 Nov 16 20:23 astra-mutants\ndrwxr-xr-x@   2 lchingen  wheel        64 Nov 21 08:00 busyprobe\ndrwxr-xr-x@   5 lchingen  wheel       160 Nov 23 11:41 cdp\ndrwxr-xr-x@   4 lchingen  wheel       128 Nov 21 17:35 citation-mutants\ndrwxr-xr-x@   7 lchingen  wheel       224 Nov 16 03:09 compare-test-030741\ndrwxr-xr-x@  22 lchingen  wheel       704 Nov 22 08:00 d400-reader-mutants\ndrwxr-xr-x@   5 lchingen  wheel       160 Nov 20 17:19 dep-probe\ndrwxr-xr-x@   8 lchingen  wheel       256 Nov 20 17:21 dep-probe-check\ndrwxr-xr-x@   8 lchingen  wheel       256 Nov 20 17:23 dep-probe-check2\ndrwxr-xr-x@  15 lchingen  wheel       480 Nov 20 17:25