({k: v.get('caught') for k, v in r['pages'].items() if k.startswith('mutant')})\"\n120130 python3 - <<'PY'\nfrom pathlib import Path\np = Path('tests/test_release.py'); t = p.read_text()\nold = \"CERTIFIED_TEMPLATE_SHA256 = 'ea40964f0c2aaaa6170173c9625923bbf4205e0558de244aeeb4bfbde73f5ae1'   # certified by the screen run of 2026-11-23\"\nassert t.count(old) == 1\nt = t.replace(old, \"CERTIFIED_TEMPLATE_SHA256 = 'f94bb3cbf5ba1030ee37f0111b78bf2e58f7f767d77aa7e7d2443677e5811ae2'   # certified by poc/data/release-screen-2026-11-23b\")\nt = t.replace(\"    (poc/data/release-screen-2026-11-23); any change to any part of it fails here until a new screen run certifies it.\", \"    (poc/data/release-screen-2026-11-23b); any change to any part of it fails here until a new screen run certifies it.\")\np.write_text(t)\nPY\nPYTHONPATH=src:poc PYTHONDONTWRITEBYTECODE=1 python3 -m pytest tests/test_release.py -q -p no:cacheprovider 2>&1 | tail -1\n120132 cd /Users/lchingen/hivemind && python3 - <<'PY'\nfrom pathlib import Path\np = Path('tests/test_release.py'); t = p.read_text()\nold = \"CERTIFIED_TEMPLATE_SHA256 = 'ea40964f0c2aaaa6170173c9625923bbf4205e0558de244aeeb4bfbde73f5ae1'   # certified by the screen run of 2026-11-23\"\nassert t.count(old) == 1\nt = t.replace(old, \"CERTIFIED_TEMPLATE_SHA256 = 'f94bb3cbf5ba1030ee37f0111b78bf2e58f7f767d77aa7e7d2443677e5811ae2'   # certified by poc/data/release-screen-2026-11-23b\")\nt = t.replace(\"    (poc/data/release-screen-2026-11-23); any change to any part of it fails here until a new screen run certifies it.\", \"    (poc/data/release-screen-2026-11-23b); any change to any part of it fails here until a new screen run certifies it.\")\np.write_text(t)\nPY\nPYTHONPATH=src:poc PYTHONDONTWRITEBYTECODE=1 python3 -m pytest tests/test_release.py -q -p no:cacheprovider 2>&1 | tail -1\n120137 PYTHONPATH=src:poc PYTHONDONTWRITEBYTECODE=1 python3 -m pytest tests -q -p no:cacheprovider 2>&1 | grep -E \"passed|failed\"; PYTHONDONTWRITEBYTECODE