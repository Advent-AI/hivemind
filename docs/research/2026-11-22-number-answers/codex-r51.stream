{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc 'nl -ba docs/research/2026-11-22-number-answers/render_v13.py'","aggregated_output":"     1\t\"\"\"Render one stored family's judging-v13 request (old-2 calls 8729 and 8737 on 2026-09-20) and check a conforming answer through the\n     2\tv13 schema (model.check_schema) and calc_check. Harness-only, $0, no model call. Usage: python3 render_v13.py [out-prefix]\"\"\"\n     3\timport json\n     4\timport sqlite3\n     5\timport sys\n     6\tfrom pathlib import Path\n     7\t\n     8\tHERE = Path(__file__).resolve().parent\n     9\tREPO = HERE.parents[2]\n    10\tsys.path.insert(0, str(HERE))\n    11\tsys.path.insert(0, str(REPO / 'src'))\n    12\timport calc_check as cc  # noqa: E402\n    13\timport gate  # noqa: E402\n    14\tfrom hivemind import model  # noqa: E402\n    15\t\n    16\tS, N = {'type': 'string'}, {'type': 'number'}\n    17\t\n    18\t\n    19\tdef nullable(schema):\n    20\t    return {'anyOf': [schema, {'type': 'null'}]}\n    21\t\n    22\t\n    23\tdef obj(props, desc=None):\n    24\t    out = {'type': 'object', 'properties': props, 'required': list(props), 'additionalProperties': False}\n    25\t    if desc:\n    26\t        out['description'] = desc\n    27\t    return out\n    28\t\n    29\t\n    30\tdef v13_schema(member_ids, evidence_ids, theme_ids):\n    31\t    what = obj({k: S for k in ('population', 'measure', 'scope', 'period')},\n    32\t               'What the number measures: population, measure (the quantity, such as revenue or units; never its basis), scope, period.')\n    33\t    figure = obj({\n    34\t        'id': S, 'what': what,\n    35\t        'basis': {'type': 'string', 'enum': sorted(cc.BASES - {'prior_forecast'}), 'description': 'reported: an actual; guidance: the company\\'s '\n    36\t                  'outlook; consensus: analysts\\' average; third_party: one outside party; forecast: this family\\'s forecast.'},\n    37\t        'scenario': S,\n    38\t        'kind': {'type': 'string', 'enum': ['computed', 'estimate', 'source'], 'description': 'source: stated in a shown passage; computed: one '\n    39\t                 'operation on named figures; estimate: your judgement, stated as yours.'},\n    40\t        'value': nullable(N), 'low': nullable(N), 'high': nullable(N),\n    41\t        'bound': nullable({'type': 'string', 'enum': ['>', '>=', '<', '<=', 'approx', 'approx_below', 'approx_above']}),\n    42\t        'unit': S,\n    43\t        'evidence': nullable(S),\n    44\t        'expression': nullable({'type': 'string', 'description': 'Source only: the complete numeric expression exactly as the passage writes '\n    45\t                                'it, qualifiers included (for example \"more than $2 billion\", \"$4.5 billion, plus or minus 3%\", \"more than triple\").'}),\n    46\t        'component': nullable({'type': 'string', 'enum': ['value', 'bound', 'midpoint', 'relative', 'low', 'high', 'multiplier']}),\n    47\t        'inputs': nullable({'type': 'array', 'items': S}),\n    48\t        'operation': nullable({'type': 'string', 'enum': sorted(cc.OPERATIONS)}),\n    49\t        'signs': nullable({'type': 'array', 'items': N}),\n    50\t        'relation': nullable({'type': 'string', 'enum': ['time_aggregation', 'accounting_parts', 'stated_in_addition', 'overlap_unknown'],\n    51\t                              'description': 'Sum and roll_forward: periods of one quantity; declared parts of a whole; a source says they add; '\n    52\t                              'unknown overlap (name the disputed figure).'}),\n    53\t        'disputed': nullable(S),\n    54\t        'bridge': nullable({'type': 'string', 'description': 'Only when no listed identity covers the operation (periods of one quantity, '\n    55\t                            'declared parts, a balance and its flows, a stated share or multiplier, a total over a per-unit price): an '\n    56\t                            'estimate stating the conversion and listing the operands it converts.'}),\n    57\t        'basis_text': nullable(S), 'rests_on': nullable({'type': 'array', 'items': S}),\n    58\t        'adjusts': nullable(obj({'figure': S, 'type': {'type': 'string', 'enum': ['discount', 'uplift', 'trim']}})),\n    59\t        'converts': nullable({'type': 'array', 'items': S}),\n    60\t    })\n    61\t    push = obj({'evidence_id': {'type': 'string', 'enum': evidence_ids}, 'push': {'type': 'string', 'enum': ['toward_first', 'toward_last', 'none']}})\n    62\t    theme_push = obj({'view_id': {'type': 'string', 'enum': theme_ids or ['none']},\n    63\t                      'push': {'type': 'string', 'enum': ['toward_first', 'toward_last', 'none']}})\n    64\t    answer = obj({\n    65\t        'view_id': {'type': 'string', 'enum': member_ids},\n    66\t        'shape': {'type': 'string', 'enum': ['forecast', 'unresolved']},\n    67\t        'outcome': nullable(S), 'rung': nullable({'type': 'integer'}),\n    68\t        'reference': nullable(obj({'figure': nullable(S), 'unavailable': nullable(S)}, 'An external figure, or a calculation from external '\n    69\t                              'and reported figures, or unavailable with why.')),\n    70\t        'reasons': S, 'why': nullable(S),\n    71\t        'cites': {'type': 'array', 'items': {'type': 'string', 'enum': evidence_ids}},\n    72\t        'pushes': {'type': 'array', 'items': push}, 'theme_pushes': {'type': 'array', 'items': theme_push},\n    73\t    })\n    74\t    return obj({'figures': {'type': 'array', 'items': figure}, 'answers': {'type': 'array', 'items': answer}})\n    75\t\n    76\t\n    77\tdef parts(user):\n    78\t    head, rest = user.split('\\n\\n[Evidence in view', 1)\n    79\t    evidence = '[Evidence in view' + rest.split('\\n\\n[', 1)[0]\n    80\t    tail = '\\n\\n[' + rest.split('\\n\\n[', 1)[1] if '\\n\\n[' in rest else ''\n    81\t    blocks = {b.split(']', 1)[0]: '[' + b for b in tail.split('\\n\\n[')[1:]}\n    82\t    return head, evidence, blocks\n    83\t\n    84\t\n    85\tdef render(archive_path, calls, family, shown=None):\n    86\t    \"\"\"The v13 user message for a family from its members' stored requests: the members in `shown` (default: all) get a header; the\n    87\t    evidence in view is the union over every call, each passage once; the themes once; each member's exact figure keys.\"\"\"\n    88\t    archive = sqlite3.connect(f'file:{archive_path}?mode=ro', uri=True)\n    89\t    heads, lines, seen, themes, earlier = [], [], set(), '', []\n    90\t    shown = set(shown) if shown is not None else {v for v, _ in calls}\n    91\t    for view_id, call_id in calls:\n    92\t        user = json.loads(archive.execute('select request_json from model_calls where call_id=?', (call_id,)).fetchone()[0])['messages'][1]['content']\n    93\t        head, evidence, blocks = parts(user)\n    94\t        if view_id in shown:\n    95\t            heads.append(head)\n    96\t        for item in evidence.split('\\n- ')[1:]:\n    97\t            eid = item.split(' ', 1)[0]\n    98\t            if eid not in seen:\n    99\t                seen.add(eid)\n   100\t                lines.append('- ' + item)\n   101\t        themes = themes or next((v for k, v in blocks.items() if k.startswith('Themes')), '')\n   102\t        prev = next((v for k, v in blocks.items() if k.startswith('Previous')), '').split('\\n\\nAnswer per the JSON schema')[0]   # [46g.1] v7's output line goes\n   103\t        earlier.append(f'- {view_id}: ' + prev.replace('[Previous conclusion, for comparison only]', 'our earlier forecast, not a source:').strip())\n   104\t    rel = '; '.join(f'{r[\"part\"]} is part of {r[\"whole\"]}' if r['type'] == 'part_of' else f'{r[\"later\"]} rests on {r[\"earlier\"]}\\'s base'\n   105\t                    for r in family['relations'] if {r.get('part'), r.get('whole'), r.get('later'), r.get('earlier')} - {None} <= shown) or 'none'\n   106\t    shared = '; '.join(f'{w[\"population\"]}, {w[\"measure\"]}, {w[\"scope\"]}, {w[\"period\"]}' for w in family['shared']) or 'none'\n   107\t    keys = '; '.join(f'{v} = {m[\"what\"][\"population\"]} | {m[\"what\"][\"measure\"]} | {m[\"what\"][\"scope\"]} | {m[\"what\"][\"period\"]}'\n   108\t                     for v, m in family.get('members', {}).items() if v in shown)\n   109\t    user = ('[Family] members:\\n' + '\\n\\n'.join(heads) + f'\\n\\nRelations: {rel}.\\nShared quantities, one forecast each per scenario: {shared}.\\n'\n   110\t            + (f'Outcome keys (population | measure | scope | period), to be used exactly: {keys}.\\n' if keys else '') + '\\n'\n   111\t            f'[Evidence in view for the family, {len(lines)} items]\\n' + '\\n'.join(lines) + '\\n\\n' + themes\n   112\t            + '\\n\\nAnswer per the JSON schema: one calculation for the family and one answer per member.')   # D728: no earlier forecast\n   113\t    return user, sorted(seen), [t.split(' ', 1)[0] for t in themes.split('\\n- ')[1:]]\n   114\t\n   115\t\n   116\tdef strict(calc, schema):\n   117\t    \"\"\"Fill every optional field with null, as strict structured output returns it.\"\"\"\n   118\t    fprops = schema['properties']['figures']['items']['properties']\n   119\t    aprops = schema['properties']['answers']['items']['properties']\n   120\t    figs = [{k: f.get(k) for k in fprops} for f in calc['figures']]\n   121\t    for f in figs:\n   122\t        f['scenario'] = f['scenario'] or 'base'\n   123\t        if f['what'] is None:\n   124\t            f['what'] = {'population': '', 'measure': '', 'scope': '', 'period': ''}\n   125\t    answers = []\n   126\t    for a in calc['answers']:\n   127\t        a2 = {k: a.get(k) for k in aprops}\n   128\t        if a2['reference'] is not None:\n   129\t            a2['reference'] = {'figure': a['reference'].get('figure'), 'unavailable': a['reference'].get('unavailable')}\n   130\t        a2['why'] = a.get('why')\n   131\t        answers.append(a2)\n   132\t    return {'figures': figs, 'answers': answers}\n   133\t\n   134\t\n   135\tdef without_nulls(calc):\n   136\t    clean = lambda d: {k: v for k, v in d.items() if v is not None}\n   137\t    answers = []\n   138\t    for a in calc['answers']:\n   139\t        a2 = clean(a)\n   140\t        if 'reference' in a2:\n   141\t            a2['reference'] = clean(a2['reference'])\n   142\t        answers.append(a2)\n   143\t    return {'figures': [clean(f) for f in calc['figures']], 'answers': answers}\n   144\t\n   145\t\n   146\tdef main():\n   147\t    archive = REPO / 'poc/data/comparison-2026-11-17/run/old-2/prod/archive.sqlite'\n   148\t    system = (HERE / 'judging-v13-draft.txt').read_text()\n   149\t    user, evidence_ids, theme_ids = render(archive, [('v14', 8729), ('v9', 8737)], gate.R1_FAMILY)\n   150\t    schema = v13_schema(['v14', 'v9'], evidence_ids, theme_ids)\n   151\t    calc = gate.r1('c')\n   152\t    answer = strict(calc, schema)\n   153\t    schema_errors = model.check_schema(answer, schema)\n   154\t    for a in answer['answers']:\n   155\t        a['cites'] = [e for e in a['cites'] if e in evidence_ids]\n   156\t    result = cc.check(gate.R1_FAMILY, gate.R1_PASSAGES, without_nulls(answer))\n   157\t    missing = sorted({f['evidence'] for f in calc['figures'] if f.get('evidence')} - set(evidence_ids))\n   158\t    report = [f'system {len(system)} characters; user {len(user)} characters; schema {len(json.dumps(schema))} characters',\n   159\t              f'evidence items {len(evidence_ids)}; themes {len(theme_ids)}',\n   160\t              f'source passages the answer cites that the rendered request does not show: {missing or \"none\"}',\n   161\t              f'schema errors: {schema_errors or \"none\"}', f'calc_check errors: {result[\"errors\"] or \"none\"}',\n   162\t              f'recorded: {json.dumps(result[\"recorded\"])}']\n   163\t    print('\\n'.join(report))\n   164\t    family_sb = {'members': {}, 'relations': [{'type': 'same_base', 'later': 'v35', 'earlier': 'v14'}],\n   165\t                 'shared': [{'population': 'NVIDIA', 'measure': 'revenue', 'scope': 'company', 'period': 'FY2027'}]}\n   166\t    user_sb, _, _ = render(archive, [('v14', 8729), ('v35', 8732)], family_sb)\n   167\t    line = next(l for l in user_sb.split('\\n') if l.startswith('Relations:'))\n   168\t    report.append(f'same-base family (calls 8729, 8732): {line}')\n   169\t    print(report[-1])\n   170\t    if \"v35 rests on v14's base\" not in line:\n   171\t        return 1\n   172\t    if len(sys.argv) > 1:\n   173\t        prefix = Path(sys.argv[1])\n   174\t        prefix.with_suffix('.request.json').write_text(json.dumps({'system': system, 'user': user, 'schema': schema}, indent=1))\n   175\t        prefix.with_suffix('.answer.json').write_text(json.dumps(answer, indent=1))\n   176\t        prefix.with_suffix('.txt').write_text('\\n'.join(report) + '\\n')\n   177\t    return 0 if not schema_errors and not result['errors'] and not missing else 1\n   178\t\n   179\t\n   180\tif __name__ == '__main__':\n   181\t    raise SystemExit(main())\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc 'nl -ba docs/research/2026-11-22-number-answers/DESIGN.md'","aggregated_output":"     1\t# judging-v13: related number questions judged together, with a checked calculation (design v10, after council round 46j and D728; for round 46k)\n     2\t\n     3\tOpened by Alex (D726) for the bounded test of D725. Harness-only until a later decision: no product configuration names it, and\n     4\tthe ordinary launchers refuse it (D359, D723). The frozen judge (judging-v7, poc-v118) is unchanged.\n     5\t\n     6\tv2 answered round 46 (`codex-r46.md`, changes marked [46.n]). v3 answers round 46b (`codex-r46b.md`, marked [46b.n]). Rounds 46 and\n     7\t46b found the same weakness five times: the checks trusted what the answer declares about itself (its `uses` list, its labels, a\n     8\tshortened span). **v3's structural rule:** code derives every relation it checks from the calculation itself and from the passage\n     9\ttext, and the answer declares nothing code relies on without checking it:\n    10\t- each outcome's inputs are found by walking the figure graph;\n    11\t- a future quantity shared by the family enters any forecast only through the family's one forecast node for it, checked on every\n    12\t  path from an outcome, not by membership in the graph [46c.1];\n    13\t- a source figure must equal a complete numeric expression that code extracts from the passage.\n    14\t\n    15\t## 1. What changes\n    16\t\n    17\t| Piece | judging-v7 (today) | judging-v13 |\n    18\t|---|---|---|\n    19\t| Unit | one question per call | one **family** per call: the number questions of one company whose quantities overlap (a total and its segment or product line, a level and its growth, and a later year declared to rest on an earlier year's base [46.2]). Each keeps its own answer |\n    20\t| Who forms a family | none (0 dependencies) | **declared** for the test from the stored cases, with typed relations: `part_of(part, whole)` and `same_base(later, earlier)`. Production would need a matching version that names them |\n    21\t| Evidence shown | each question's own evidence in view (D198) | the union of the members' evidence in view, each passage once with its attribution; themes once |\n    22\t| Previous conclusion | rung and reasons, cut at 800 characters, unmarked | **not shown** (D728). Whether a member's conclusion changed is derived by code afterwards from its earlier rung, outcome and source figures (`calc_check.changed`) |\n    23\t| Answer | prose fields plus one answer-wide citation list | a calculation (figures) plus exactly one answer per member (§2) |\n    24\t| Request text | judging-v7 | a full v13 request written and audited (§5) [46.6] |\n    25\t| Failure | refused twice: the question is left as it was | refused twice: the family is recorded **unresolved** and no member is updated. A member may also answer `unresolved` itself (§2) [46.5] |\n    26\t\n    27\t## 2. The answer format (closed set; the schema enforces shape, code enforces §3)\n    28\t\n    29\t```\n    30\tfigures: [ { id,\n    31\t             what: { population, measure, scope, period },     # canonical: measure is the quantity (\"revenue\"), not its basis [46.1]\n    32\t             basis: \"reported\" | \"guidance\" | \"consensus\" | \"third_party\" | \"forecast\" | \"prior_forecast\",\n    33\t             scenario: \"base\" | \"<named>\",                       # default \"base\" [46.1]\n    34\t             kind: \"source\" | \"computed\" | \"estimate\",\n    35\t             value | {low, high} | {bound: \">\" | \">=\" | \"<\" | \"<=\" | \"approx\" | \"approx_below\" | \"approx_above\", value} | {multiplier, bound?},  unit,   # [46c.3]\n    36\t             # kind source:   evidence: \"<id>\", expression: <index of a complete expression code extracts from that passage>,\n    37\t             #                component: \"midpoint\" | \"low\" | \"high\" | \"bound\" | \"multiplier\" | \"value\"            [46b.2]\n    38\t             # kind computed: inputs: [...], operation: sum|difference|product|ratio|growth|apply_growth|share|range_from_relative|roll_forward,   # [46c.2]\n    39\t             #                relation (sum and roll_forward): \"accounting_parts\" | \"time_aggregation\" | \"stated_in_addition\" | \"overlap_unknown\",\n    40\t             #                disputed (overlap_unknown only): \"<the operand whose inclusion is in doubt>\"            [46b.4, 46d]\n    41\t             #                bridge (when inputs' what differ from the output's): \"<figure id of an estimate>\"   [46.3]\n    42\t             # kind estimate: basis_text, rests_on: [figure ids, evidence ids],\n    43\t             #                adjusts (optional): { figure: \"<id>\", type: \"discount\" | \"uplift\" | \"trim\" }            [46.3]\n    44\t             #                a bridge estimate also names `converts: [operand ids]` and the assumption           [46b.3]\n    45\t           } ]\n    46\tanswers: [ { view_id, shape: \"forecast\", outcome: \"<figure id>\", rung,                 # [46b.5] two shapes\n    47\t             reference: { figure: \"<id>\" } | { unavailable: \"<why>\" },                # per answer [46.2]\n    48\t             reasons, cites, pushes, theme_pushes, changed, why_changed }\n    49\t         | { view_id, shape: \"unresolved\", why, cites, changed, why_changed } ]       # no outcome, no rung\n    50\t```\n    51\t\n    52\t- **An arithmetic intermediate and the analyst's final range are distinct figures** [46.2]. For example, q02's $392B × 92% is a\n    53\t  `computed` figure. The final $370–400B is an `estimate` resting on it and on q01's range. Code checks the intermediate's arithmetic\n    54\t  and never requires the final range to equal it.\n    55\t- **`prior`** figures (basis `prior_forecast`) are for comparison only [46f.4]. They need a pointer to an earlier answer shown in the\n    56\t  request and must equal a figure that answer states (C10). They may feed no figure. A declared `same_base` reads the family's own\n    57\t  forecast node of the earlier member at the same snapshot (q22 reads q01's): C9.\n    58\t- **`roll_forward`** [46c.2]: an opening balance as of a date, plus additions and minus drawdowns over a later period, gives the\n    59\t  balance at that period's end. It is the accounting identity for a stock and its flows. An addition whose inclusion in the opening\n    60\t  balance is in doubt carries `relation: overlap_unknown` and `disputed` (R2's $18B).\n    61\t- **Scenarios carry ranges** [46b.1]. A forecast node is a point within a scenario. A range across members is written as paired\n    62\t  scenarios (for example `low`, `high`) whose nodes stay paired. The analyst's final answer may be a range `estimate` resting on the\n    63\t  scenario outcomes.\n    64\t- **The family declaration** (by the harness, not by the answer) lists the shared quantities and periods the members depend on, for\n    65\t  example company revenue for each FY2027 quarter, and the typed relations [46b.1].\n    66\t\n    67\t## 3. What code checks (identity and arithmetic only)\n    68\t\n    69\t| Check | Rule | Refuses |\n    70\t|---|---|---|\n    71\t| **C1 source expression** [46b.2] | code extracts every complete numeric expression from the cited passage as shown, with its qualifiers and unit. Points: \"$108.0 billion\". Ranges: \"$105–110 billion\". Relative: \"$108.0 billion, plus or minus 2%\" is midpoint 108 ±2%. Bounds: \"more than $730 billion\" (>730), \"at least\" (>=). Approximate bounds: \"nearly $800 billion\" (approx_below 800). Multipliers: \"double\" ×2, \"more than double\" (>×2). A source figure names one extracted expression and a component of it (midpoint, low, high, bound, multiplier), and must equal it exactly: value, unit, sign and qualifier. Any other wording cannot be a source figure | a figure that strips a qualifier ($730 from \"more than $730 billion\"); a bound used as a point; a wrong number within 0.5% (108.5); a figure naming no extracted expression |\n    72\t| **C2 arithmetic** | a `computed` figure recomputes from its inputs by its operation. Rounding: to the figure's stated precision, at most 0.5% or 0.1 unit. `range_from_relative` makes 108 ± 2% into 105.84–110.16 | a wrong sum, share or endpoint |\n    73\t| **C3 part within whole** [46b.1] | for each declared `part_of`, in each scenario, for each declared period: the part's value, found by walking the graph from the part member's outcome to its node for that period, is at most the whole's. Annual and quarters are compared where the declaration names them | a segment quarter above the company quarter |\n    74\t| **C4 one forecast per shared quantity** [46b.1, 46c.1] | for each shared quantity and period the declaration names, each scenario has exactly one `basis: forecast` node. **Every path** in the graph from a member's outcome to any figure that measures that quantity and period passes through that node. A guide, consensus or other source of a future period may feed the forecast node; no path from an outcome may reach it while avoiding the node | the $108B guide feeding v14's $113.5B forecast and, on another path, v9's Data Center Q3 directly: the same guide node, a bypass |\n    75\t| **C5 reference** [46b.3, 46c.1] | each answer's reference is `unavailable` with a reason, or a direct `source` figure of basis consensus, guidance or third_party from a passage whose speaker is not the system, or a `computed` figure whose whole graph is computed figures over such sources and `reported` sources (q02: $392B consensus × 92% reported mix). No `estimate`, `forecast` or `prior_forecast` anywhere in the reference's graph. Its provenance is shown | the system's own forecast presented as the market's, directly or wrapped in an estimate that cites outside evidence |\n    76\t| **C6 rung and outcome** [46.2] | the chosen rung's band overlaps the outcome (a point: contains it). The reasons say why that band, where the range overlaps several | a rung no part of the outcome falls in |\n    77\t| **C7 structure** [46.5] | exactly one answer per member; an answer's outcome `what` matches its member's question (population, measure, scope, period, from the question's typed key); figure ids are unique; references are not dangling and not circular; operations come from the closed set | a missing or doubled member, a borrowed outcome, a dangling or circular figure |\n    78\t| **C8 operand compatibility** [46b.3] | by operation. **sum/difference:** same measure, population and scope, with periods either disjoint and together forming the output period (`time_aggregation`), or identical with a declared relation (`accounting_parts` needs a declared `part_of`). **roll_forward:** an opening balance as of a date, and flows over a period starting then or later, give the closing balance [46c.2]. **per unit** [gate run 1]: a total over a price per unit gives units, and units times that price give the total, for one population and scope (q19's $20B at $5,000 a Vera CPU is four million units). **share:** numerator and denominator stated, with a declared `part_of` or a reported mix. **product/ratio:** a change of measure, population, scope or period not covered above needs a bridge estimate whose `converts` names the actual operands, and an assumption | 730/800 × $1.3T with no bridge naming e1786's four-company 2026 spending and e2535's five-company capex; a bridge that converts other operands |\n    79\t\n    80\t| **C4 scenarios** [46g.3, 46h.1, 46i.1] | each scenario has one forecast node per shared quantity. Scenario membership is derived along the whole path: no figure of a point scenario may depend, at any depth, on a forecast node of another scenario. A `range` summary is an estimate with low and high, is an answer's outcome, and feeds no figure; only it may rest on several scenarios; a bypass is a path that reaches the quantity through no forecast node of any scenario | a low path on the high total; a guide relabelled as an alternate scenario and read by the base |\n    81\t| **C4 derived scenarios** [46j.1] | a figure's scenarios are those of the estimates it rests on at any depth; a point-scenario figure may rest on no estimate of another scenario; related members (`part_of`) cover the same scenarios, so C3 compares like with like | the company in `base` and Data Center in `alt`; crossed share estimates |\n    82\t| **C5 one choice** [46g.2] | a reference names exactly one of a figure or `unavailable` | a prior figure hidden beside an \"unavailable\" reason |\n    83\t| **C9 same base** [46f.3, 46j.2] | for each `same_base(later, earlier)`, the later member rests on the earlier member's forecast nodes (its outcome, or the scenario paths behind its range summary), and every path to a figure of the earlier quantity and period passes through one of them; scenarios match by C4 | FY2028 grown from the $392B consensus instead of q01's $400–435B forecast |\n    84\t| **C10 earlier forecasts** [46f.3, 46f.4, 46h.2, 46i.2] | a figure is an earlier forecast when its kind is prior, its basis is prior_forecast or it carries a pointer (derived, not labelled), and it must then be kind prior with basis prior_forecast; such a figure points to an earlier answer shown in the request and equals a figure that answer states; it feeds no figure and is no answer's outcome | an invented or misdated earlier figure; an earlier forecast used as an input |\n    85\t| **C2 bound direction** [46f.3] | for positive operands, a result's bound side follows its inputs: sums and products keep a lower or upper side, a ratio's or difference's second operand flips it, and mixed sides give `approx` | \"more than double\" times $20B declared below $40B |\n    86\t\n    87\t**Recorded, not refused** (visible to readers and to the page) [46.3]:\n    88\t- **Overlap:** a `sum` or `roll_forward` with relation `overlap_unknown`. Its alternate recomputes that same calculation without the\n    89\t  named `disputed` operand, all else fixed [46b.4, 46d].\n    90\t- **Adjustment:** an `estimate` that `adjusts` a figure. Its alternate is the adjusted figure (R4: the bound \">40\").\n    91\t- **Bridge:** every bridge; alternate undetermined.\n    92\t- **Boundaries** [46f.3]: a point alternate, or a bound lying beyond the outcome on its own side, decides a crossing definitely; a bound on\n    93\t  the near side only possibly. Code recomputes, from unrounded values, each outcome under each defined alternate. It records which rung boundary the\n    94\t  assumption definitely or possibly decides: \"crosses $40B\" when the alternate is a bound, a rung change when the alternate is a\n    95\t  point. Where a downstream estimate has no formula, or no alternate is defined, it records \"undetermined\". A reader decides whether a\n    96\t  boundary-deciding assumption is supported. D721/D722: unresolved inclusion is never treated as proof of double counting.\n    97\t\n    98\t**The model keeps:** drivers, weights, discounts, scenarios, the choice among overlapping bands, and whether to step off the\n    99\treference. Code never prefers guidance, prescribes a haircut, refuses an estimate for being one, or picks a band from a midpoint.\n   100\t\n   101\t## 4. Tables\n   102\t\n   103\t**Value × reader.**\n   104\t- **The calculation, the recorded assumptions and band-deciding flags:** read by the checks, the readers' packets, and later the\n   105\t  page.\n   106\t- **`unresolved`:** read by the round (no member updated) and the bundle (\"Forecast unavailable\", D726).\n   107\t- **The family declaration:** read by the request builder, C3, C4 and C7.\n   108\t- **Nothing in poc-v118 reads any of it.**\n   109\t\n   110\t**New path × old checks.**\n   111\t- v7's id, push and theme checks apply per member answer. Rung checks apply to `forecast` answers only [46b.5]. `cites` names shown\n   112\t  evidence only.\n   113\t- `cites_views` is always empty.\n   114\t- v7's request bytes are unchanged (the frozen pins).\n   115\t\n   116\t**State × event (the test harness).** Inputs are fixed: the stored requests' passages and the gold packet's items, as of the stored\n   117\tday.\n   118\t\n   119\t| Event | Outcome |\n   120\t|---|---|\n   121\t| success | the calculation and answers are recorded with their check results |\n   122\t| refusal | the errors are recorded; one retry with them |\n   123\t| second refusal | the family is unresolved, recorded |\n   124\t| a member's own `unresolved` [46b.5] | recorded; the family is held (no member updated) when any other member's outcome depends on a shared quantity or relation involving it; otherwise the others publish if they pass |\n   125\t| crash midway | the attempt is recorded incomplete and counts as no result |\n   126\t\n   127\tNothing writes a product store. Production lifecycle (members closing or opening, families changing) is designed only if the test\n   128\tpasses.\n   129\t\n   130\t**Prior decisions:**\n   131\t- D24, D28: bounded to the figures open questions consume.\n   132\t- D198: evidence in view, unioned.\n   133\t- D260, D263: the standard kept.\n   134\t- D359, D723: no product launcher.\n   135\t- D695: number questions.\n   136\t- D711, D721, D722: linking passed conclusions, and unresolved inclusion is not double counting.\n   137\t- D725, D726.\n   138\t\n   139\t## 5. The v13 request text (written and audited at $0 before the gate closes) [46.6]\n   140\t\n   141\t- **The basis:** judging-v7's standard sentences are kept, among them the reference, run-rate, discount, sizing, identities and\n   142\t  consistency.\n   143\t- **Replaced where they conflict with a family:**\n   144\t  - the single-question delivery (\"the current conclusions of dependencies\");\n   145\t  - \"the previous conclusion carries\" pieces not shown, which becomes \"our earlier forecast, not a source\";\n   146\t  - the one-reference, one-outcome output sentence;\n   147\t  - the dependency-consistency sentence, which becomes the family's own consistency, the same clause made family-wide.\n   148\t- **Added:** how to write figures (kinds, bases, expressions, relations, bridges, `adjusts`, `unresolved`).\n   149\t- **The audit:** every changed sentence is shown with its source (D260, D263, D725, this design), read against a stored family\n   150\t  request, and its character count before and after is reported (AGENTS §6).\n   151\t\n   152\t## 6. The $0 gate (registered; each defect must produce its named finding) [46.5]\n   153\t\n   154\t| Item | Content | Pass: the named finding |\n   155\t|---|---|---|\n   156\t| R1a | old-2 8729 (v14) and 8737 (v9) on 09-20, as stored: v9 Q4 146, v14 Q4 127 | **C3** on Q4 |\n   157\t| R1b | the same, with Q3 as stored: **one** guide node (midpoint 108 from e2499, labelled `guidance`) feeds v14's company Q3 forecast (113.5, beat-adjusted) and, on a second path, v9's Data Center Q3 (108 × 92.5% = 99.9) | **C4** on Q3 company revenue (the bypass path), independent of C3 |\n   158\t| R1c (control) | the same guide node (midpoint 108 ±2%, e2499's expression) feeding one shared Q3 forecast node (113.5) that both members read | passes |\n   159\t| R2 | old-2 8734 as `roll_forward`: the $25B balance as of July 26 (e2620), plus the $18B committed for the rest of the fiscal year (e2889) as `overlap_unknown` and `disputed`, plus MediaTek and the talks as estimates | passes C8; recorded overlap; the alternate without the $18B (about $35B) decides the $50B boundary (conditional) |\n   160\t| R3 | old-2 8595: 730 (e1786, bound \">\") / 800 (e2535, bound \"approx_below\") × 1,300 (e2535, point) | stripped qualifiers: **C1**. Qualifiers kept: passes C1, then **C8** without a bridge naming those operands. With the bridge: recorded, undetermined |\n   161\t| R4 | old-3 9166: 20 × (>2) (e3660, \"more than double\") gives >40, trimmed to 38–39 by `adjusts: trim` | recorded adjustment that definitely crosses the $40B boundary (rung 2 is $40–50B, rung 1 $50B+) |\n   162\t| G1–G4 (controls) | q01, q02, q19, q22, from `gold-v1.json`'s reasoning (expressions from the packet items). q01's Q1 + Q2 as `time_aggregation`; q02's comparison $392B (consensus) × 92% (reported mix); q22 in one family with q01, reading q01's FY2027 node | all pass, estimates visible; q02's reference passes C5; q19's overlapping range passes C6 with its reason |\n   163\t| P1–P3 (plants, on control copies) | P1, an amount absent from its expression; P2, a wrong sum; P3a, a prior forecast as the reference; P3b, the same figure wrapped in an estimate that cites outside evidence | P1 **C1**, P2 **C2**, P3a and P3b **C5**, each for its intended reason |\n   164\t| T1–T7 (C1 forms, real passages) | e2499 midpoint 108 ±2% (accepted as `midpoint`); e1786 \">730\"; e2535 approx_below 800 and the point 1,300; e3660 \">×2\"; stripped forms \"$730\", \"800\", \"double\" against those passages; 108.5 against e2499 | T1–T3 parse as stated; the stripped forms and 108.5 refused |\n   165\t| U1–U2 (paths) | a member answering `unresolved` while another member's outcome needs its shared quantity; a calculation refused twice | the family held, recorded; the family unresolved, recorded |\n   166\t\n   167\t- **Stop:** any missing finding, a finding for the wrong reason, or a control the format cannot express.\n   168\t- **Then:** Council B on the gate's output. The paid gate's ceiling goes to Alex.\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc 'nl -ba docs/research/2026-11-22-number-answers/paid_rehearsal.py'","aggregated_output":"     1\t\"\"\"$0 rehearsal of the judging-v13 paid gate: the provider stubbed at urllib.request.urlopen beneath the real budget transport, the real\n     2\tmodel.openai_transport and the real stop gate. Every HTTP body must equal, byte for byte, a request built here independently from the\n     3\tplan. Usage: python3 paid_rehearsal.py <scratch folder>   (runs every scenario; prints one line per check; exit 1 on any failure).\"\"\"\n     4\timport io\n     5\timport json\n     6\timport os\n     7\timport shutil\n     8\timport sys\n     9\timport urllib.error\n    10\timport urllib.request\n    11\tfrom pathlib import Path\n    12\t\n    13\tHERE = Path(__file__).resolve().parent\n    14\tsys.path.insert(0, str(HERE))\n    15\timport paid_gate as pg                                                  # noqa: E402\n    16\tfrom hivemind import model                                              # noqa: E402\n    17\t\n    18\tPLAN = json.loads((HERE / 'paid-plan.json').read_text())\n    19\tBY_USER = {it['user']: it for it in PLAN}\n    20\t\n    21\t\n    22\t\n    23\tclass FakeResponse:\n    24\t    def __init__(self, body):\n    25\t        self.body, self.status = body, 200\n    26\t\n    27\t    def read(self):\n    28\t        return self.body\n    29\t\n    30\t    def __enter__(self):\n    31\t        return self\n    32\t\n    33\t    def __exit__(self, *exc):\n    34\t        return False\n    35\t\n    36\t\n    37\tdef mid(band):\n    38\t    lo, hi = band\n    39\t    return (lo + hi) / 2 if lo is not None and hi is not None else (lo + 10 if lo is not None else hi - 10)\n    40\t\n    41\t\n    42\tdef valid_answer(it, flavour='ok'):\n    43\t    \"\"\"A schema-valid v13 answer that passes every check: one estimate outcome per member, inside its second rung (a part below its\n    44\t    whole), the reference unavailable. Flavours: 'bad-rung'; 'q3-agree' / 'q3-disagree' (each outcome rests on a company Q3 forecast;\n    45\t    'q3-disagree' gives the Data Center member a different one); 'div-zero' (a ratio over a zero figure).\"\"\"\n    46\t    fprops = it['schema']['properties']['figures']['items']['properties']\n    47\t    aprops = it['schema']['properties']['answers']['items']['properties']\n    48\t    figures, answers = [], []\n    49\t    shared = (it['family'].get('shared') or [None])[0]\n    50\t    for n, view_id in enumerate(it['members']):\n    51\t        m = it['family']['members'][view_id]\n    52\t        band = m['bands'][1]\n    53\t        value = mid(band) - (5.0 * n)\n    54\t        rests = []\n    55\t        if flavour in ('q3-agree', 'q3-disagree', 'q3-float', 'q3-unit') and shared:\n    56\t            q3 = {k: None for k in fprops}\n    57\t            q3_value = 115.0 if (flavour == 'q3-disagree' and m['what']['scope'] == 'Data Center') else 110.0\n    58\t            if flavour == 'q3-float' and m['what']['scope'] == 'Data Center':\n    59\t                q3_value = 110.00000000000001            # [47b.1] equal within floating-point error, not bit for bit\n    60\t            q3_unit = 'USD' if (flavour == 'q3-unit' and m['what']['scope'] == 'Data Center') else 'USD bn'   # [47e.2] the same number, another unit\n    61\t            q3.update(id=f'q3_{view_id}', what=shared, basis='forecast', scenario='base', kind='estimate', value=q3_value, unit=q3_unit,\n    62\t                      basis_text='rehearsal Q3', rests_on=[])\n    63\t            figures.append(q3)\n    64\t            rests = [q3['id']]\n    65\t        if flavour == 'div-zero':\n    66\t            z = {k: None for k in fprops}\n    67\t            z.update(id='zero', what=m['what'], basis='forecast', scenario='base', kind='estimate', value=0.0, unit='USD bn', basis_text='zero', rests_on=[])\n    68\t            r = {k: None for k in fprops}\n    69\t            r.update(id='ratio', what=m['what'], basis='forecast', scenario='base', kind='computed', value=1.0, unit='x', operation='ratio', inputs=['zero', 'zero'])\n    70\t            figures += [z, r]\n    71\t        if flavour == 'dc-q4-dup' and m['what']['scope'] == 'Data Center':   # [47c.1] two equal forecasts of one quarter in one answer\n    72\t            for copy in ('a', 'b'):\n    73\t                d = {k: None for k in fprops}\n    74\t                d.update(id=f'dcq4_{copy}', what=dict(m['what'], period='FY2027 Q4'), basis='forecast', scenario='base', kind='estimate',\n    75\t                         value=50.0, unit='USD bn', basis_text='rehearsal DC Q4', rests_on=[])\n    76\t                figures.append(d)\n    77\t            rests = rests + ['dcq4_a', 'dcq4_b']\n    78\t        if flavour in ('q3-dup-total', 'q3-dup-dc') and shared:\n    79\t            if (m['what']['scope'] == 'Data Center') == (flavour == 'q3-dup-total'):\n    80\t                q3 = {k: None for k in fprops}\n    81\t                q3.update(id=f'q3_one_{view_id}', what=shared, basis='forecast', scenario='base', kind='estimate', value=110.0, unit='USD bn',\n    82\t                          basis_text='rehearsal Q3', rests_on=[])\n    83\t                figures.append(q3)\n    84\t                rests = [q3['id']]\n    85\t            else:\n    86\t                for copy in ('a', 'b'):\n    87\t                    q3 = {k: None for k in fprops}\n    88\t                    q3.update(id=f'q3_two_{copy}', what=shared, basis='forecast', scenario='base', kind='estimate', value=110.0,\n    89\t                              unit='USD bn', basis_text='rehearsal Q3', rests_on=[])\n    90\t                    figures.append(q3)\n    91\t        if flavour == 'abstain':\n    92\t            ans = {k: None for k in aprops}\n    93\t            ans.update(view_id=view_id, shape='unresolved', why='the shown passages give no figure for this quantity', reasons='rehearsal',\n    94\t                       cites=[], pushes=[], theme_pushes=[], outcome=None, rung=None, reference=None)\n    95\t            answers.append(ans)\n    96\t            continue\n    97\t        fig = {k: None for k in fprops}\n    98\t        fig.update(id=f'o_{view_id}', what=m['what'], basis='forecast', scenario='base', kind='estimate', value=value, unit='USD bn',\n    99\t                   basis_text='rehearsal estimate', rests_on=rests)\n   100\t        figures.append(fig)\n   101\t        ans = {k: None for k in aprops}\n   102\t        ans.update(view_id=view_id, shape='forecast', outcome=fig['id'], rung=99 if flavour == 'bad-rung' else 2,\n   103\t                   reference={'figure': None, 'unavailable': 'no market figure in the shown passages'}, reasons='rehearsal', cites=[],\n   104\t                   pushes=[], theme_pushes=[])\n   105\t        answers.append(ans)\n   106\t    if flavour == 'q3-agree' and len(it['members']) == 2:   # one shared node in a joint answer\n   107\t        figures = [f for f in figures if f['id'] != f'q3_{it[\"members\"][1]}']\n   108\t        figures[-1]['rests_on'] = [f'q3_{it[\"members\"][0]}']\n   109\t    return {'figures': figures, 'answers': answers}\n   110\t\n   111\t\n   112\tdef http_error(url, code):\n   113\t    return urllib.error.HTTPError(url, code, f'HTTP {code}', {}, io.BytesIO(json.dumps({'error': {'code': code}}).encode()))\n   114\t\n   115\t\n   116\tclass Stub:\n   117\t    def __init__(self, cfg, scenario, ledger):\n   118\t        self.cfg, self.scenario, self.ledger, self.calls, self.problems, self.sent, self.sequence = cfg, scenario, ledger, {}, [], 0, []\n   119\t\n   120\t    def expected(self, it, user):\n   121\t        s = self.cfg.rejudging\n   122\t        return json.dumps({'model': s.model, 'messages': [{'role': 'system', 'content': it['system']}, {'role': 'user', 'content': user}],\n   123\t                           'response_format': {'type': 'json_schema', 'json_schema': {'name': 'judgement', 'strict': True, 'schema': it['schema']}},\n   124\t                           'max_completion_tokens': s.max_output_tokens, 'reasoning_effort': s.reasoning_effort}).encode('utf-8')\n   125\t\n   126\t    def __call__(self, http_request, *args, **kwargs):\n   127\t        body = http_request.data\n   128\t        request = json.loads(body)\n   129\t        user = request['messages'][1]['content']\n   130\t        base = user.split(pg.RETRY_MARK)[0]\n   131\t        it = BY_USER.get(base)\n   132\t        if it is None or body != self.expected(it, user):\n   133\t            self.problems.append('a body that is not the planned request, byte for byte')\n   134\t            raise http_error(http_request.full_url, 400)\n   135\t        key = (it['unit'], it['arm'])\n   136\t        self.calls[key] = self.calls.get(key, 0) + 1\n   137\t        self.sent += 1\n   138\t        n, s = self.calls[key], self.scenario\n   139\t        retry = pg.RETRY_MARK in user\n   140\t        self.sequence.append(retry)\n   141\t        if s == 'ledger-stop' and self.sent == 5:\n   142\t            self.ledger.stop('rehearsal: stopped after four sends')\n   143\t            raise http_error(http_request.full_url, 503)\n   144\t        flavour = 'ok'\n   145\t        if s == 'retry' and key == ('single-O', 'single') and not retry and n == 1:\n   146\t            flavour = 'bad-rung'\n   147\t        if s == 'unresolved' and key == ('single-S', 'single'):      # every call refused: each draw's first answer and its retry\n   148\t            flavour = 'bad-rung'\n   149\t        if s in ('separate-agree', 'separate-disagree', 'separate-agree-float', 'separate-unit') and it['unit'] == 'pair-old-2':\n   150\t            flavour = {'separate-agree': 'q3-agree', 'separate-disagree': 'q3-disagree', 'separate-agree-float': 'q3-float', 'separate-unit': 'q3-unit'}[s]\n   151\t        if s == 'separate-within-dup' and it['unit'] == 'pair-old-2':\n   152\t            flavour = 'dc-q4-dup'\n   153\t        if s == 'separate-within-dup-shared' and it['unit'] == 'pair-old-2' and it['arm'].startswith('separate-'):\n   154\t            flavour = 'q3-dup-total'\n   155\t        if s == 'separate-within-dup-second' and it['unit'] == 'pair-old-2' and it['arm'].startswith('separate-'):\n   156\t            flavour = 'q3-dup-dc'\n   157\t        if s == 'abstain' and key == ('single-S', 'single'):\n   158\t            flavour = 'abstain'\n   159\t        if s == 'one-transport' and key == ('single-E', 'single') and n == 1:\n   160\t            raise http_error(http_request.full_url, 400)\n   161\t        if s == 'interrupt' and key == ('single-O', 'single'):       # stopped at single-O's second call: draw 2's first attempt\n   162\t            if n == 1:\n   163\t                flavour = 'bad-rung'\n   164\t            else:\n   165\t                raise KeyboardInterrupt('rehearsal: the launcher is stopped during a scored attempt')\n   166\t        if s in ('interrupt-retry', 'retry-transport') and key == ('single-O', 'single'):\n   167\t            if not retry:\n   168\t                flavour = 'bad-rung'\n   169\t            elif s == 'interrupt-retry':\n   170\t                raise KeyboardInterrupt('rehearsal: the launcher is stopped during a diagnostic retry')\n   171\t            else:\n   172\t                raise http_error(http_request.full_url, 400)\n   173\t        if s == 'null-content' and key == ('single-E', 'single') and n == 1:   # [47f.2] a provider refusal with no content\n   174\t            return FakeResponse(json.dumps({'choices': [{'message': {'content': None, 'refusal': 'rehearsal refusal text'}}],\n   175\t                                            'usage': {'prompt_tokens': len(body) // 4, 'completion_tokens': 5}}).encode('utf-8'))\n   176\t        if s == 'div-zero' and key == ('single-O', 'single') and n == 1:\n   177\t            flavour = 'div-zero'\n   178\t        data = valid_answer(it, flavour)\n   179\t        if s == 'separate-contradiction' and it['arm'].startswith('separate-v9'):   # the Data Center card alone, above the total's value\n   180\t            data['figures'][-1]['value'] = 440.0\n   181\t            data['answers'][0]['rung'] = 2\n   182\t        if s == 'joint-retry-fix' and it['unit'] == 'pair-old-2' and not retry and (it['arm'] == 'joint' or it['arm'] == 'separate-v9'):\n   183\t            data['figures'][-1]['value'] = 440.0                 # [47e.1] the Data Center card above the total, on the first attempt\n   184\t        if s == 'format' and key == ('single-E', 'single') and n == 1:\n   185\t            data['answers'][0].pop('reasons')\n   186\t        if s == 'unicode' and key == ('single-O', 'single') and n == 1:    # [47g] other Unicode line separators inside an answer\n   187\t            data['answers'][0]['reasons'] = 'first line\\u2028second line\\x85third line\\u2029end'\n   188\t        if s == 'long-raw' and key == ('single-E', 'single') and n == 1:   # [47f.2] a long malformed answer naming a passage at its end\n   189\t            data['answers'][0]['why'] = 'x' * 25000 + ' see ' + sorted(it['shown'])[-1]\n   190\t            data['answers'][0].pop('pushes')\n   191\t        usage = {'prompt_tokens': len(body) // 4, 'completion_tokens': 800}\n   192\t        return FakeResponse(json.dumps({'choices': [{'message': {'content': json.dumps(data)}}], 'usage': usage}).encode('utf-8'))\n   193\t\n   194\t\n   195\tdef scenario(scratch, name, ceiling=0.5, interrupted=False):\n   196\t    out = scratch / name\n   197\t    out.mkdir(parents=True)\n   198\t    budget = pg.budget_module()\n   199\t    budget.SharedLedger.init(str(out / 'ledger.json'), ceiling)\n   200\t    ledger = budget.SharedLedger(str(out / 'ledger.json'))\n   201\t    gate = pg.Gate(out, budget.BudgetTransport(ledger, sleep=lambda seconds: None), ledger)\n   202\t    (out / 'plan.json').write_text(json.dumps(PLAN))\n   203\t    stub = Stub(gate.cfg, name, ledger)\n   204\t    saved = (urllib.request.urlopen, os.environ.get('OPENAI_API_KEY'))\n   205\t    os.environ['OPENAI_API_KEY'] = 'rehearsal-dummy-not-a-key'\n   206\t    urllib.request.urlopen = stub\n   207\t    remove_gate = budget.install_stop_gate(ledger)\n   208\t    summary = None\n   209\t    try:\n   210\t        summary = gate.run(PLAN)\n   211\t    except KeyboardInterrupt:\n   212\t        if not interrupted:\n   213\t            raise\n   214\t        summary = json.loads((out / 'results.json').read_text())   # written by the run's own finally\n   215\t    finally:\n   216\t        remove_gate()\n   217\t        urllib.request.urlopen = saved[0]\n   218\t        if saved[1] is None:\n   219\t            os.environ.pop('OPENAI_API_KEY', None)\n   220\t        else:\n   221\t            os.environ['OPENAI_API_KEY'] = saved[1]\n   222\t    lines = pg.attempt_records(out)                          # both journals: scored first attempts, then diagnostic retries\n   223\t    starts = [l for l in lines if l['status'] == 'started']\n   224\t    done = [l for l in lines if l['status'] != 'started']\n   225\t    if len(starts) != len(done) and not interrupted:\n   226\t        raise SystemExit(f'{name}: {len(starts)} started lines against {len(done)} finished attempts')\n   227\t    return summary, done, stub, ledger.read()\n   228\t\n   229\t\n   230\tdef main(scratch):\n   231\t    scratch = Path(scratch)\n   232\t    checks = []\n   233\t\n   234\t    def check(name, ok, detail=''):\n   235\t        checks.append(ok)\n   236\t        print(f'{\"PASS\" if ok else \"FAIL\"}  {name}  {detail}')\n   237\t\n   238\t    s, lines, stub, led = scenario(scratch, 'clean')\n   239\t    check('clean: 36 first attempts, no retry', len(lines) == 36 and all(l['attempt'] == 1 for l in lines), f'{len(lines)} attempts')\n   240\t    check('clean: every body byte-equal to the planned request', not stub.problems, str(stub.problems[:1]))\n   241\t    check('clean: every unit publishes', all(v['decision'] == 'publish' for v in s['finals'].values()))\n   242\t    check('clean: the separate arm reconciles in all 9 pairs', all(v['decision'] == 'publish' for v in s['reconciled'].values()) and len(s['reconciled']) == 9)\n   243\t    check('clean: spend settled under the ceiling', led['spent'] <= led['ceiling'] and not led.get('stopped'), f'spent {led[\"spent\"]:.4f}')\n   244\t    keydir = scratch / 'key-clean'\n   245\t    pg.packets(scratch / 'clean', keydir)\n   246\t    frozen = json.loads((keydir / 'packet-key.json').read_text())\n   247\t    text = (scratch / 'clean' / 'packets.md').read_text()\n   248\t    key = pg.render_packets(scratch / 'clean', frozen)[1]\n   249\t    clean_sha = pg.hashlib.sha256(text.encode()).hexdigest()\n   250\t    check('packets: 27 packets; no arm word or member prefix in the text', len(key) == 27 and 'joint' not in text and 'separate' not in text\n   251\t          and not any(f'{v}.' in text for v in ('v4', 'v8', 'v14', 'v9', 'v3', 'v35')), f'{len(key)} packets')\n   252\t    check('packets: the key is bound to the run, and the readers\\' text commits to the key', frozen['run_digest'] == pg.run_digest(scratch / 'clean')\n   253\t          and text.startswith(f'Key commitment: {pg.key_commitment(frozen)}\\n') and len(frozen['salt']) == 32)\n   254\t    check('packets: the scoring text holds final answers only (no attempt, code decision or check code)',\n   255\t          'Attempt' not in text and 'Code decision' not in text and 'published' not in text and not any(f'(C{n}' in text for n in range(1, 11)))\n   256\t    try:\n   257\t        pg.packets(scratch / 'clean', keydir)\n   258\t        again = ''\n   259\t    except SystemExit as error:\n   260\t        again = str(error)\n   261\t    check('packets: a second packets run is refused, the key unchanged', 'frozen' in again\n   262\t          and json.loads((keydir / 'packet-key.json').read_text()) == frozen, again[:80])\n   263\t    yes = lambda a='yes': {'answer': a, 'ground': 'F1 rehearsal'}\n   264\t\n   265\t    def card(usable='yes', gap='no', drop=None, b_differs=None, third=None):\n   266\t        def one():\n   267\t            r = {'usable': yes(usable), 'contradiction': yes('no'), 'internal_reference': yes('no'), 'deciding_gap': yes(gap)}\n   268\t            if drop:\n   269\t                r[drop] = {'answer': 'no', 'ground': ''}\n   270\t            return r\n   271\t        a, b = one(), one()\n   272\t        if b_differs:\n   273\t            b[b_differs] = yes('no' if a[b_differs]['answer'] == 'yes' else 'yes')\n   274\t        out = {'A': a, 'B': b}\n   275\t        if third:\n   276\t            out['third'] = third\n   277\t        return out\n   278\t\n   279\t    def readings(good_separate, defect_arm=None, drop_packet=False, bad_card=False, missing_ground=False, disagree=None, null_ground=False,\n   280\t                 foreign_ground=False):\n   281\t        rd, seen_sep, defect_done = {}, 0, False\n   282\t        for pid, k in sorted(key.items()):\n   283\t            usable = 'yes'\n   284\t            if k['arm'] == 'separate':\n   285\t                seen_sep += 1\n   286\t                usable = 'yes' if seen_sep <= good_separate else 'no'\n   287\t            rd[pid] = {c: card(usable) for c in k['cards']}\n   288\t            if defect_arm and k['arm'] == defect_arm and not defect_done:\n   289\t                rd[pid]['K1'] = card(usable, gap='yes')\n   290\t                defect_done = True\n   291\t        first = sorted(rd)[0]\n   292\t        if drop_packet:\n   293\t            rd.pop(first)\n   294\t        if bad_card:\n   295\t            rd[first]['v999'] = rd[first].pop(sorted(rd[first])[0])\n   296\t        if missing_ground:\n   297\t            rd[first][sorted(rd[first])[0]] = card(drop='usable')\n   298\t        if disagree is not None:\n   299\t            rd[first][sorted(rd[first])[0]] = card(b_differs='usable', third=disagree)\n   300\t        if null_ground:\n   301\t            rd[first][sorted(rd[first])[0]]['A']['usable'] = {'answer': 'yes', 'ground': None}\n   302\t        if foreign_ground:\n   303\t            rd[first][sorted(rd[first])[0]]['A']['usable'] = {'answer': 'yes', 'ground': 'the passage about the total'}\n   304\t        return rd\n   305\t\n   306\t    def verdict_of(rd, name, out=None, keys=None, packets_sha=None):\n   307\t        copy = scratch / f'verdict-{name}'                   # [47e.4] a run takes one verdict: each case reads its own copy of the run\n   308\t        shutil.copytree(out or scratch / 'clean', copy, ignore=shutil.ignore_patterns('archives', 'readings.json', 'verdict.json'))\n   309\t        path = scratch / f'readings-{name}.json'\n   310\t        path.write_text(json.dumps({'packets_sha256': packets_sha or clean_sha, 'packets': rd}))\n   311\t        return pg.verdict(copy, str(path), keys or keydir)\n   312\t    v = verdict_of(readings(9), 'all-good')\n   313\t    check('verdict: both arms usable everywhere: STOP (gain under 3)', v['verdict'] == 'STOP' and v['joint usable pairs'] == 9 and v['separate usable pairs'] == 9)\n   314\t    try:\n   315\t        pg.verdict(scratch / 'verdict-all-good', str(scratch / 'readings-all-good.json'), keydir)\n   316\t        second = ''\n   317\t    except SystemExit as error:\n   318\t        second = str(error)\n   319\t    sealed = scratch / 'verdict-all-good'\n   320\t    replayed = pg.replay(sealed, keydir)\n   321\t    (sealed / 'readings.json').write_text((sealed / 'readings.json').read_text().replace('\"no\"', '\"yes\"', 1))\n   322\t    check('verdict: a run takes one verdict; replay reproduces it from the sealed readings, and fails once they are edited',\n   323\t          'refused' in second and replayed and not pg.replay(sealed, keydir), second[:80])\n   324\t    v = verdict_of(readings(5), 'gain-4')\n   325\t    check('verdict: joint 9, separate 5: PASS', v['verdict'] == 'PASS', str(v['separate usable pairs']))\n   326\t    v = verdict_of(readings(5, defect_arm='single'), 'single-defect')\n   327\t    check('verdict: one published singleton defect: STOP', v['verdict'] == 'STOP' and len(v['published defects']) == 1)\n   328\t    v = verdict_of(readings(5, defect_arm='separate'), 'separate-defect')\n   329\t    check('verdict: a defect in the separate arm alone does not stop', v['verdict'] == 'PASS')\n   330\t    for name, kw in (('missing packet', {'drop_packet': True}), ('invented card', {'bad_card': True}), ('missing ground', {'missing_ground': True}),\n   331\t                     ('disagreement, no third', {'disagree': None, 'drop_packet': False})):\n   332\t        rd = readings(5, **kw) if name != 'disagreement, no third' else readings(5, disagree={})\n   333\t        v = verdict_of(rd, name.replace(' ', '-').replace(',', ''))\n   334\t        check(f'verdict: {name}: INCOMPLETE', v['verdict'] == 'INCOMPLETE', '; '.join(v['problems'][:1]))\n   335\t    v = verdict_of(readings(5, disagree={'usable': yes('yes')}), 'third-decides')\n   336\t    check('verdict: a disagreement decided by the third reader is complete', v['complete'], '; '.join(v['problems'][:1]))\n   337\t    for name, kw in (('null ground', {'null_ground': True}), ('ground naming nothing in the packet', {'foreign_ground': True})):\n   338\t        v = verdict_of(readings(5, **kw), name.replace(' ', '-'))\n   339\t        check(f'verdict: {name}: INCOMPLETE', v['verdict'] == 'INCOMPLETE', '; '.join(v['problems'][:1]))\n   340\t    v = verdict_of(readings(5), 'other-packets', packets_sha='0' * 64)\n   341\t    check('verdict: readings made on other packets: INCOMPLETE', v['verdict'] == 'INCOMPLETE', '; '.join(v['problems'][:1]))\n   342\t    shutil.copytree(scratch / 'clean', scratch / 'clean-changed')\n   343\t    changed = json.loads((scratch / 'clean-changed' / 'results.json').read_text())\n   344\t    changed['finals']['single-O|single|1']['decision'] = 'held'\n   345\t    (scratch / 'clean-changed' / 'results.json').write_text(json.dumps(changed))\n   346\t    v = verdict_of(readings(5), 'changed-run', out=scratch / 'clean-changed')\n   347\t    check('verdict: a run changed after the packets were frozen: INCOMPLETE', v['verdict'] == 'INCOMPLETE' and any('does not belong' in x for x in v['problems']),\n   348\t          '; '.join(v['problems'][:1]))\n   349\t\n   350\t    # [47b.3] one card's view: its own figures renumbered, its assumption records mapped to the same numbers, others left out\n   351\t    calc = {'figures': [{'id': 'v14.q4f', 'kind': 'source', 'evidence': 'e7', 'rests_on': []},\n   352\t                        {'id': 'v14.dc', 'kind': 'computed', 'inputs': ['v14.q4f', 'v14.q4f'], 'rests_on': []},\n   353\t                        {'id': 'v9.other', 'kind': 'source', 'evidence': 'e8', 'rests_on': []}],\n   354\t            'answers': [{'view_id': 'v14', 'outcome': 'v14.dc', 'reference': {'figure': None}, 'cites': ['e7']}]}\n   355\t    norm, mapped, named = pg.card_view(calc, 'v14', [{'type': 'overlap', 'figure': 'v14.q4f', 'outcome': 'v14'},\n   356\t                                                     {'type': 'bridge', 'figure': 'v9.other', 'bridge': 'v9.other', 'alternate': 'undetermined'}])\n   357\t    blob = json.dumps([norm, mapped])\n   358\t    check('card view: own figures only, renumbered; the assumption record mapped, the other card\\'s left out',\n   359\t          [f['id'] for f in norm['figures']] == ['F1', 'F2'] and mapped == [{'type': 'overlap', 'figure': 'F1', 'outcome': 'v14'}]\n   360\t          and 'v14.' not in blob and 'v9' not in blob and named == ['e7'], blob[:160])\n   361\t\n   362\t    s, lines, stub, led = scenario(scratch, 'separate-agree')\n   363\t    rec = s['reconciled']['pair-old-2|1']\n   364\t    check('separate-agree: equal shared Q3 forecasts are unified, and the pair reconciles', rec['decision'] == 'publish', str(rec.get('errors'))[:120])\n   365\t    s, lines, stub, led = scenario(scratch, 'separate-disagree')\n   366\t    rec = s['reconciled']['pair-old-2|1']\n   367\t    check('separate-disagree: different shared Q3 forecasts are refused (C4)', rec['decision'] == 'refused' and any(c == 'C4' for c, _ in rec['errors']))\n   368\t    s, lines, stub, led = scenario(scratch, 'div-zero')\n   369\t    o = [l for l in lines if l['unit'] == 'single-O' and l['draw'] == 1]\n   370\t    check('div-zero: recorded and refused (C2), then retried', [l['decision'] for l in o] == ['refused', 'publish']\n   371\t          and any(c == 'C2' for c, _ in o[0]['errors']), str([l['decision'] for l in o]))\n   372\t    s, lines, stub, led = scenario(scratch, 'reservation', ceiling=0.0001)\n   373\t    check('reservation: a refused reservation never reaches the provider and is recorded', stub.sent == 0 and all(\n   374\t        l['decision'] == 'transport' for l in lines) and len(lines) > 0, f'{stub.sent} provider calls')\n   375\t    saved = (pg.APPROVED_CEILING, pg.AUTH)\n   376\t    try:\n   377\t        pg.APPROVED_CEILING, pg.AUTH = None, scratch / 'auth' / 'authorization.json'\n   378\t        for name, setup, expect in (('no ceiling named', lambda: None, 'approved ceiling'),\n   379\t                                    ('a changed plan', lambda: setattr(pg, 'APPROVED_CEILING', 0.5), 'not the reviewed one'),\n   380\t                                    ('a used authorization', lambda: (pg.AUTH.parent.mkdir(parents=True, exist_ok=True), pg.AUTH.write_text('{}')), 'already used')):\n   381\t            setup()\n   382\t            plan_path = scratch / 'changed-plan.json' if name == 'a changed plan' else HERE / 'paid-plan.json'\n   383\t            if name == 'a changed plan':\n   384\t                plan_path.write_text((HERE / 'paid-plan.json').read_text() + ' ')\n   385\t            try:\n   386\t                pg.send(scratch / f'send-{name.replace(\" \", \"-\")}', 0.5, str(plan_path))\n   387\t                refused = ''\n   388\t            except SystemExit as error:\n   389\t                refused = str(error)\n   390\t            check(f'send refuses {name}', expect in refused and not (scratch / f'send-{name.replace(\" \", \"-\")}').exists(), refused[:80])\n   391\t    finally:\n   392\t        pg.APPROVED_CEILING, pg.AUTH = saved\n   393\t\n   394\t    s, lines, stub, led = scenario(scratch, 'retry')\n   395\t    o = [l for l in lines if l['unit'] == 'single-O' and l['draw'] == 1]\n   396\t    check('retry: a refused calculation is retried once with its errors and then publishes', [l['decision'] for l in o] == ['refused', 'publish'], str([l['decision'] for l in o]))\n   397\t    s, lines, stub, led = scenario(scratch, 'unresolved')\n   398\t    check('unresolved: two refusals make the unit unresolved', s['finals']['single-S|single|1']['decision'] == 'unresolved')\n   399\t    s, lines, stub, led = scenario(scratch, 'format')\n   400\t    e = [l for l in lines if l['unit'] == 'single-E' and l['draw'] == 1]\n   401\t    check('format: a schema-invalid answer is refused, then retried', [l['status'] for l in e] == ['format invalid', 'answered'], str([l['status'] for l in e]))\n   402\t    fk = scratch / 'key-format'\n   403\t    pg.packets(scratch / 'format', fk)\n   404\t    fmt = pg.render_packets(scratch / 'format', json.loads((fk / 'packet-key.json').read_text()))[1]\n   405\t    fpid = next(p for p, k in fmt.items() if k['unit'] == 'single-E' and k['draw'] == '1')\n   406\t    fsection = (scratch / 'format' / 'packets.md').read_text().split(f'## {fpid}\\n')[1].split('\\n## ')[0]\n   407\t    ftext = (scratch / 'format' / 'attempts.md').read_text()\n   408\t    check('format: the scoring packet carries the neutral label; the returned text is in the unscored attempts file (with the retry)',\n   409\t          pg.FORMAT_INVALID in fsection and 'The text returned' in ftext and '\"view_id\": \"v41\"' in ftext and ftext.count('## D') == 2, fpid)\n   410\t    s, lines, stub, led = scenario(scratch, 'separate-contradiction')\n   411\t    rec = s['reconciled']['pair-old-2|1']\n   412\t    check('separate: two answers that each pass alone are refused when reconciled (C3)', rec['decision'] == 'refused' and any(c == 'C3' for c, _ in rec['errors']),\n   413\t          rec['decision'])\n   414\t    s, lines, stub, led = scenario(scratch, 'ledger-stop')\n   415\t    not_sent = [k for k, v in s['finals'].items() if str(v.get('decision', '')).startswith('not sent')]\n   416\t    check('ledger-stop: after the ledger stops, nothing more is sent', led.get('stopped') and len(lines) == 5 and len(not_sent) >= 30, f'{len(lines)} attempts, {len(not_sent)} not sent')\n   417\t    s, lines, stub, led = scenario(scratch, 'separate-agree-float')\n   418\t    rec = s['reconciled']['pair-old-2|1']\n   419\t    check('separate-agree-float: Q3 forecasts equal within floating-point error are unified, and the pair reconciles',\n   420\t          rec['decision'] == 'publish' and len(rec['calc']['unified']) == 1, str(rec.get('errors'))[:120])\n   421\t    fkeys = scratch / 'key-float'\n   422\t    pg.packets(scratch / 'separate-agree-float', fkeys)\n   423\t    fkey = pg.render_packets(scratch / 'separate-agree-float', json.loads((fkeys / 'packet-key.json').read_text()))[1]\n   424\t    pid = next(p for p, k in fkey.items() if k['unit'] == 'pair-old-2' and k['arm'] == 'separate' and k['draw'] == '1')\n   425\t    section = (scratch / 'separate-agree-float' / 'packets.md').read_text().split(f'## {pid}\\n')[1].split('\\n## ')[0]\n   426\t    check('packets: a reconciled card is shown with its own original derivation, not the unified copy',\n   427\t          '110.00000000000001' in section and section.count('rehearsal Q3') == 2, pid)\n   428\t\n   429\t    rkeys = scratch / 'key-retry'                            # the 'retry' scenario above: single-O's first answer refused, the retry published\n   430\t    pg.packets(scratch / 'retry', rkeys)\n   431\t    rfrozen = json.loads((rkeys / 'packet-key.json').read_text())\n   432\t    rkey = pg.render_packets(scratch / 'retry', rfrozen)[1]\n   433\t    pid = next(p for p, k in rkey.items() if k['unit'] == 'single-O' and k['draw'] == '1')\n   434\t    section = (scratch / 'retry' / 'packets.md').read_text().split(f'## {pid}\\n')[1].split('\\n## ')[0]\n   435\t    attempts_text = (scratch / 'retry' / 'attempts.md').read_text()\n   436\t    check('packets: the scoring packet shows the first answer (scored); the retry is only in the unscored attempts file, unlinked',\n   437\t          '\"rung\": 99' in section and '\"rung\": 2' not in section and rkey[pid]['decision'] == 'refused' and len(rfrozen['attempts']) == 1\n   438\t          and '\"rung\": 2' in attempts_text and 'T.F1' in attempts_text and '## P' not in attempts_text and 'D01' in attempts_text, pid)\n   439\t\n   440\t    s, lines, stub, led = scenario(scratch, 'one-transport')\n   441\t    check('one-transport: a request that fails in transport is final as transport, not published', s['finals']['single-E|single|1']['decision'] == 'transport')\n   442\t    tkeys = scratch / 'key-transport'\n   443\t    pg.packets(scratch / 'one-transport', tkeys)\n   444\t    tfrozen = json.loads((tkeys / 'packet-key.json').read_text())\n   445\t    rd = {pid: {c: card() for c in k['cards']} for pid, k in pg.render_packets(scratch / 'one-transport', tfrozen)[1].items()}\n   446\t    v = verdict_of(rd, 'transport', out=scratch / 'one-transport', keys=tkeys, packets_sha=pg.hashlib.sha256((scratch / 'one-transport' / 'packets.md').read_bytes()).hexdigest())\n   447\t    check('verdict: a unit failed in transport makes the verdict INCOMPLETE', v['verdict'] == 'INCOMPLETE'\n   448\t          and any('single-E|single|1: transport' in x for x in v['problems']), '; '.join(v['problems'][:2]))\n   449\t\n   450\t\n   451\t    def read_all(folder, keys):\n   452\t        pg.packets(scratch / folder, keys)\n   453\t        kf = json.loads((keys / 'packet-key.json').read_text())\n   454\t        rend = pg.render_packets(scratch / folder, kf)[1]\n   455\t        rd = {pid: {c: card() for c in k['cards']} for pid, k in rend.items()}\n   456\t        return verdict_of(rd, folder, out=scratch / folder, keys=keys,\n   457\t                          packets_sha=pg.hashlib.sha256((scratch / folder / 'packets.md').read_bytes()).hexdigest())\n   458\t\n   459\t    s, lines, stub, led = scenario(scratch, 'interrupt', interrupted=True)\n   460\t    f = s['finals']\n   461\t    v = read_all('interrupt', scratch / 'key-interrupt')\n   462\t    check('interrupt during a scored attempt: results written; that attempt interrupted, later ones not sent, no retry yet; INCOMPLETE',\n   463\t          (scratch / 'interrupt' / 'results.json').exists() and f['single-O|single|2']['decision'] == 'interrupted'\n   464\t          and f['single-S|single|2']['decision'] == 'not sent' and f['single-O|single|1']['decision'] == 'retry not sent'\n   465\t          and f['pair-old-1|joint|1']['decision'] == 'publish' and v['verdict'] == 'INCOMPLETE', '; '.join(v['problems'][:2]))\n   466\t    s, lines, stub, led = scenario(scratch, 'interrupt-retry', interrupted=True)\n   467\t    f = s['finals']\n   468\t    v = read_all('interrupt-retry', scratch / 'key-interrupt-retry')\n   469\t    firsts = [l for l in lines if l['attempt'] == 1]\n   470\t    check('interrupt during a diagnostic retry: all 36 scored attempts are recorded and the verdict is complete',\n   471\t          len(firsts) == 36 and f['single-O|single|1']['decision'] == 'interrupted' and pg.first_attempt(f['single-O|single|1'])['decision'] == 'refused'\n   472\t          and v['complete'], '; '.join(v['problems'][:2]))\n   473\t    s, lines, stub, led = scenario(scratch, 'retry-transport')\n   474\t    v = read_all('retry-transport', scratch / 'key-retry-transport')\n   475\t    check('a diagnostic retry that fails in transport leaves the scored test complete', s['finals']['single-O|single|1']['decision'] == 'transport'\n   476\t          and v['complete'], '; '.join(v['problems'][:2]))\n   477\t    check('every scored first attempt is sent before any retry (the provider\\'s own call order)', True in stub.sequence\n   478\t          and stub.sequence.index(True) == stub.sequence.count(False) == 36, str(stub.sequence.index(True) if True in stub.sequence else None))\n   479\t    s, lines, stub, led = scenario(scratch, 'null-content')\n   480\t    v = read_all('null-content', scratch / 'key-null-content')\n   481\t    check('a provider refusal with null content: packets are made, and its text is in the attempts file',\n   482\t          '(the model refused: rehearsal refusal text)' in (scratch / 'null-content' / 'attempts.md').read_text(), v['verdict'])\n   483\t    s, lines, stub, led = scenario(scratch, 'long-raw')\n   484\t    read_all('long-raw', scratch / 'key-long-raw')\n   485\t    single_e = next(i for i in PLAN if i['unit'] == 'single-E')\n   486\t    named = sorted(single_e['shown'])[-1]\n   487\t    check('a long malformed answer is kept whole: the passage it names at its end is shown in the attempts file',\n   488\t          single_e['shown'][named] in (scratch / 'long-raw' / 'attempts.md').read_text(), named)\n   489\t    atomic = scratch / 'atomic'\n   490\t    shutil.copytree(scratch / 'clean', atomic, ignore=shutil.ignore_patterns('archives', 'packets.md', 'attempts.md'))\n   491\t    saved_render = pg.render_attempts\n   492\t    pg.render_attempts = lambda *a, **k: (_ for _ in ()).throw(RuntimeError('rehearsal: rendering fails'))\n   493\t    try:\n   494\t        pg.packets(atomic, scratch / 'key-atomic')\n   495\t    except RuntimeError:\n   496\t        pass\n   497\t    finally:\n   498\t        pg.render_attempts = saved_render\n   499\t    nothing = not (atomic / 'packets.md').exists() and not (atomic / 'attempts.md').exists() and not (scratch / 'key-atomic').exists()\n   500\t    try:\n   501\t        pg.packets(atomic, scratch / 'key-atomic')\n   502\t        again = ''\n   503\t    except SystemExit as error:\n   504\t        again = str(error)\n   505\t    check('packets are written only after both files render: a failed render leaves nothing, and a second call then succeeds',\n   506\t          nothing and not again and (atomic / 'packets.md').exists() and (scratch / 'key-atomic' / 'packet-key.json').exists(), again[:80])\n   507\t    # [47c.1] duplicates inside one answer are judged in both arms alike: never unified by the reconciliation\n   508\t    s, lines, stub, led = scenario(scratch, 'separate-within-dup')\n   509\t    rec, joint = s['reconciled']['pair-old-2|1'], s['finals']['pair-old-2|joint|1']\n   510\t    check('separate-within-dup: two equal forecasts inside one answer are kept, so the reconciled pair is refused as the joint one is (C3)',\n   511\t          rec['decision'] == 'refused' and any(c == 'C3' and 'ambiguous' in m for c, m in rec['errors']) and joint['decision'] == 'unresolved'\n   512\t          and not rec['calc']['unified'], f\"{rec['decision']} / joint {joint['decision']}\")\n   513\t    s, lines, stub, led = scenario(scratch, 'separate-within-dup-shared')\n   514\t    rec = s['reconciled']['pair-old-2|1']\n   515\t    check('separate-within-dup-shared: two equal shared forecasts within one call are not unified with each other, so C4 refuses as within one call',\n   516\t          rec['decision'] == 'refused' and any(c == 'C4' and 'forecast nodes' in m for c, m in rec['errors']) and not rec['calc']['unified'],\n   517\t          f\"{rec['decision']} {[m for c, m in rec.get('errors', []) if c == 'C4'][:1]}\")\n   518\t    s, lines, stub, led = scenario(scratch, 'separate-within-dup-second')\n   519\t    rec = s['reconciled']['pair-old-2|1']\n   520\t    check('separate-within-dup-second: the second call\\'s two equal shared forecasts are not both unified to the first call\\'s one (C4 refuses)',\n   521\t          rec['decision'] == 'refused' and any(c == 'C4' and '3 forecast nodes' in m for c, m in rec['errors']) and not rec['calc']['unified'],\n   522\t          f\"{rec['decision']} {[m for c, m in rec.get('errors', []) if c == 'C4'][:1]}\")\n   523\t    # [47c.3] an abstention can be read: its card is a ground\n   524\t    s, lines, stub, led = scenario(scratch, 'abstain')\n   525\t    akeys = scratch / 'key-abstain'\n   526\t    pg.packets(scratch / 'abstain', akeys)\n   527\t    afrozen = json.loads((akeys / 'packet-key.json').read_text())\n   528\t    arend = pg.render_packets(scratch / 'abstain', afrozen)[1]\n   529\t    apid = next(p for p, k in arend.items() if k['unit'] == 'single-S' and k['draw'] == '1')\n   530\t    rd = {pid: {c: card() for c in k['cards']} for pid, k in arend.items()}\n   531\t    for pid, k in arend.items():                            # every draw of single-S abstains\n   532\t        if k['unit'] == 'single-S':\n   533\t            rd[pid] = {'K1': {x: {q: {'answer': 'no', 'ground': 'K1 is unresolved: no figure in the shown passages'} for q in pg.QUESTIONS} for x in ('A', 'B')}}\n   534\t    v = verdict_of(rd, 'abstain', out=scratch / 'abstain', keys=akeys, packets_sha=pg.hashlib.sha256((scratch / 'abstain' / 'packets.md').read_bytes()).hexdigest())\n   535\t    check('abstain: an unresolved singleton is published and can be read with its card as the ground', s['finals']['single-S|single|1']['decision'] == 'publish'\n   536\t          and arend[apid]['grounds'] == ['K1'] and v['complete'], '; '.join(v['problems'][:1]))\n   537\t    # [47c.2, 47d.1] the key orders the packets, and the readers' text commits to it: a swap of two packets whose text is identical\n   538\t    swapped = json.loads(json.dumps(frozen))   # (two draws of one unit and arm answer alike in the rehearsal) is still caught\n   539\t    twin = next(n for n, (_, u) in enumerate(swapped['order']) if n and u[:2] == swapped['order'][0][1][:2])\n   540\t    swapped['order'][0][1], swapped['order'][twin][1] = swapped['order'][twin][1], swapped['order'][0][1]\n   541\t    (scratch / 'key-swapped').mkdir()\n   542\t    (scratch / 'key-swapped' / 'packet-key.json').write_text(json.dumps(swapped))\n   543\t    same_text = pg.render_packets(scratch / 'clean', swapped)[0].split('\\n', 1)[1] == text.split('\\n', 1)[1]\n   544\t    v = verdict_of(readings(5), 'swapped', keys=scratch / 'key-swapped')\n   545\t    check('verdict: a swap of two packets with identical text: INCOMPLETE (the key is not the committed one)', same_text and v['verdict'] == 'INCOMPLETE'\n   546\t          and any('committed to' in x for x in v['problems']), '; '.join(v['problems'][:1]))\n   547\t    claimed = dict(frozen, packets={pid: {'decision': 'held'} for pid, _ in frozen['order']})\n   548\t    (scratch / 'key-claimed').mkdir()\n   549\t    (scratch / 'key-claimed' / 'packet-key.json').write_text(json.dumps(claimed))\n   550\t    forged = verdict_of(readings(5, defect_arm='single'), 'claimed', keys=scratch / 'key-claimed')\n   551\t    check('verdict: decisions written into the key: INCOMPLETE (the key is not the committed one)', forged['verdict'] == 'INCOMPLETE'\n   552\t          and any('committed to' in x for x in forged['problems']), forged['verdict'])\n   553\t    # [47c.4] a torn journal entry: the committed entries are kept, the torn attempt is unfinished, the run incomplete, nothing sent\n   554\t    shutil.copytree(scratch / 'clean', scratch / 'torn', ignore=shutil.ignore_patterns('packets.md', 'attempts.md', 'results.json'))\n   555\t    journal = (scratch / 'torn' / 'answers.jsonl').read_text().split('\\n')[:-1]\n   556\t    last = json.loads(journal[-1])\n   557\t    (scratch / 'torn' / 'answers.jsonl').write_text('\\n'.join(journal[:-1] + [journal[-1][:len(journal[-1]) // 2]]) + '\\n')\n   558\t    saved_open = urllib.request.urlopen\n   559\t    urllib.request.urlopen = lambda *a, **k: (_ for _ in ()).throw(AssertionError('recover sent a request'))\n   560\t    try:\n   561\t        rs = pg.recover(scratch / 'torn')\n   562\t    finally:\n   563\t        urllib.request.urlopen = saved_open\n   564\t    torn_key = f\"{last['unit']}|{last['arm']}|{last['draw']}\"\n   565\t    check('torn journal: recover keeps the committed entries, marks the torn attempt interrupted and the line damaged, sends nothing',\n   566\t          len(rs['damaged']) == 1 and rs['finals'][torn_key]['decision'] == 'interrupted'\n   567\t          and sum(v['decision'] == 'publish' for v in rs['finals'].values()) == 35, f\"{torn_key}: {rs['finals'][torn_key]['decision']}\")\n   568\t    tk = scratch / 'key-torn'\n   569\t    pg.packets(scratch / 'torn', tk)\n   570\t    tf = json.loads((tk / 'packet-key.json').read_text())\n   571\t    trend = pg.render_packets(scratch / 'torn', tf)[1]\n   572\t    rd = {pid: {c: card() for c in k['cards']} for pid, k in trend.items()}\n   573\t    v = verdict_of(rd, 'torn', out=scratch / 'torn', keys=tk, packets_sha=pg.hashlib.sha256((scratch / 'torn' / 'packets.md').read_bytes()).hexdigest())\n   574\t    tpid = next(p for p, k in trend.items() if (k['unit'], k['arm'], k['draw']) == (last['unit'], last['arm'], str(last['draw'])))\n   575\t    tsection = (scratch / 'torn' / 'packets.md').read_text().split(f'## {tpid}\\n')[1].split('\\n## ')[0]\n   576\t    check('torn journal: the interrupted card\\'s packet says the request was started and no answer recorded',\n   577\t          'The request was started; no answer was recorded.' in tsection and rs['finals'][torn_key]['attempts'][-1]['status'] == 'interrupted', tpid)\n   578\t    check('verdict: a damaged journal line makes the verdict INCOMPLETE', v['verdict'] == 'INCOMPLETE' and any('damaged' in x for x in v['problems']),\n   579\t          '; '.join(v['problems'][:1]))\n   580\t    # [47e.1] the first attempt is scored on both arms: a joint retry that repairs a cross-card conflict does not count\n   581\t    s, lines, stub, led = scenario(scratch, 'joint-retry-fix')\n   582\t    jk = scratch / 'key-joint-retry'\n   583\t    pg.packets(scratch / 'joint-retry-fix', jk)\n   584\t    jfrozen = json.loads((jk / 'packet-key.json').read_text())\n   585\t    jrend = pg.render_packets(scratch / 'joint-retry-fix', jfrozen)[1]\n   586\t    jpid = next(p for p, k in jrend.items() if (k['unit'], k['arm'], k['draw']) == ('pair-old-2', 'joint', '1'))\n   587\t    rd = {pid: {c: card() for c in k['cards']} for pid, k in jrend.items()}\n   588\t    v = verdict_of(rd, 'joint-retry', out=scratch / 'joint-retry-fix', keys=jk,\n   589\t                   packets_sha=pg.hashlib.sha256((scratch / 'joint-retry-fix' / 'packets.md').read_bytes()).hexdigest())\n   590\t    check('joint-retry-fix: the joint pair is final-published after its retry but scored on its refused first attempt, like the separate pair',\n   591\t          s['finals']['pair-old-2|joint|1']['decision'] == 'publish' and jrend[jpid]['decision'] == 'refused'\n   592\t          and s['reconciled']['pair-old-2|1']['decision'] == 'refused' and v['joint usable pairs'] == 6 and v['separate usable pairs'] == 6,   # all 3 draws of old-2\n   593\t          f\"joint {v['joint usable pairs']}, separate {v['separate usable pairs']}\")\n   594\t    s, lines, stub, led = scenario(scratch, 'separate-unit')\n   595\t    rec = s['reconciled']['pair-old-2|1']\n   596\t    check('separate-unit: the same number in another unit is not unified (C4 refuses)', rec['decision'] == 'refused'\n   597\t          and any(c == 'C4' and 'forecast nodes' in m for c, m in rec['errors']) and not rec['calc']['unified'], rec['decision'])\n   598\t    # [47g] a damaged retry record stays diagnostic; Unicode separators inside an answer are not record breaks\n   599\t    shutil.copytree(scratch / 'retry', scratch / 'torn-retry', ignore=shutil.ignore_patterns('archives', 'packets.md', 'attempts.md', 'results.json'))\n   600\t    rpath = scratch / 'torn-retry' / 'retries.jsonl'\n   601\t    if not rpath.exists():\n   602\t        check('a damaged retry record is reported and the retry is interrupted, but the scored test stays complete', False, 'no retries journal')\n   603\t    else:\n   604\t        rj = rpath.read_text().split('\\n')[:-1]\n   605\t        rpath.write_text('\\n'.join(rj[:-1] + [rj[-1][:len(rj[-1]) // 2]]) + '\\n')\n   606\t        rs = pg.recover(scratch / 'torn-retry')\n   607\t        v = read_all('torn-retry', scratch / 'key-torn-retry')\n   608\t        check('a damaged retry record is reported and the retry is interrupted, but the scored test stays complete',\n   609\t              [d['journal'] for d in rs['damaged']] == ['retries.jsonl'] and rs['finals']['single-O|single|1']['decision'] == 'interrupted'\n   610\t              and v['complete'], '; '.join(v['problems'][:2]))\n   611\t    s, lines, stub, led = scenario(scratch, 'unicode')\n   612\t    v = read_all('unicode', scratch / 'key-unicode')\n   613\t    check('Unicode line separators inside an answer are kept in one record: the unit publishes and the verdict is complete',\n   614\t          '\\u2028' in (scratch / 'unicode' / 'answers.jsonl').read_text() and not s['damaged']\n   615\t          and s['finals']['single-O|single|1']['decision'] == 'publish' and v['complete'], '; '.join(v['problems'][:2]))\n   616\t    synthetic = scratch / 'retry-not-sent'\n   617\t    synthetic.mkdir()\n   618\t    base = {'unit': 'single-O', 'arm': 'single', 'draw': 1, 'attempt': 1}\n   619\t    (synthetic / 'answers.jsonl').write_text(json.dumps(dict(base, status='started')) + '\\n'\n   620\t                                             + json.dumps(dict(base, status='answered', decision='refused', errors=[['C6', 'x']])) + '\\n')\n   621\t    finals = pg.derive_finals(synthetic, [i for i in PLAN if i['unit'] == 'single-O'])\n   622\t    check('a refused first answer whose retry was never sent is incomplete, not refused or not sent',\n   623\t          finals['single-O|single|1']['decision'] == 'retry not sent' and finals['single-O|single|2']['decision'] == 'not sent')\n   624\t    print(f'{sum(checks)} of {len(checks)} checks pass')\n   625\t    return 0 if all(checks) else 1\n   626\t\n   627\t\n   628\tif __name__ == '__main__':\n   629\t    if len(sys.argv) != 2 or sys.argv[1].startswith('-'):\n   630\t        raise SystemExit('usage: paid_rehearsal.py <scratch folder>')\n   631\t    raise SystemExit(main(sys.argv[1]))\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc 'nl -ba docs/research/2026-11-22-number-answers/gate.py'","aggregated_output":"     1\t\"\"\"The $0 gate of judging-v13 (DESIGN.md v5 §6, registered in D725 and council round 46e). Harness-only; reads stored stores\n     2\tread-only and the frozen gold packet; writes nothing but its report. Usage: python3 gate.py [report.txt]; exit 1 on any miss.\"\"\"\n     3\timport copy\n     4\timport json\n     5\timport sqlite3\n     6\timport sys\n     7\tfrom pathlib import Path\n     8\t\n     9\tHERE = Path(__file__).resolve().parent\n    10\tsys.path.insert(0, str(HERE))\n    11\timport calc_check as cc  # noqa: E402\n    12\t\n    13\tREPO = HERE.parents[2]\n    14\tRUN = REPO / 'poc/data/comparison-2026-11-17/run'\n    15\tPACKET = REPO / 'docs/research/2026-11-01-e2e-loop/judgement-gold/packet-v1.json'\n    16\t\n    17\t\n    18\tdef store_passages(draw, ids):\n    19\t    conn = sqlite3.connect(f'file:{RUN / draw / \"prod/views.sqlite\"}?mode=ro', uri=True)\n    20\t    rows = conn.execute(f'select evidence_id, quote, speaker from evidence where evidence_id in ({\",\".join(\"?\" * len(ids))})', ids).fetchall()\n    21\t    assert len(rows) == len(ids), (draw, ids, rows)\n    22\t    return {e: {'text': q, 'speaker': s} for e, q, s in rows}\n    23\t\n    24\t\n    25\tdef packet_passages(ids):\n    26\t    items = {it['id']: it for it in json.loads(PACKET.read_text())['items']}\n    27\t    return {i: {'text': items[i]['passage'], 'speaker': items[i]['who']} for i in ids}\n    28\t\n    29\t\n    30\tdef W(population, measure, scope, period):\n    31\t    return {'population': population, 'measure': measure, 'scope': scope, 'period': period}\n    32\t\n    33\t\n    34\tdef src(fid, evidence, expression, value, unit, basis, what, component='value', bound=None):\n    35\t    fig = {'id': fid, 'kind': 'source', 'evidence': evidence, 'expression': expression, 'component': component, 'value': value,\n    36\t           'unit': unit, 'basis': basis, 'what': what}\n    37\t    if bound:\n    38\t        fig['bound'] = bound\n    39\t    return fig\n    40\t\n    41\t\n    42\tdef comp(fid, op, inputs, value, unit, what, basis='forecast', **extra):\n    43\t    fig = {'id': fid, 'kind': 'computed', 'operation': op, 'inputs': inputs, 'unit': unit, 'basis': basis, 'what': what}\n    44\t    fig.update({'low': value[0], 'high': value[1]} if isinstance(value, tuple) else {'value': value})\n    45\t    fig.update(extra)\n    46\t    return fig\n    47\t\n    48\t\n    49\tdef est(fid, value, unit, what, basis_text, rests_on=(), basis='forecast', **extra):\n    50\t    fig = {'id': fid, 'kind': 'estimate', 'unit': unit, 'basis': basis, 'what': what, 'basis_text': basis_text, 'rests_on': list(rests_on)}\n    51\t    fig.update({'low': value[0], 'high': value[1]} if isinstance(value, tuple) else {'value': value})\n    52\t    fig.update(extra)\n    53\t    return fig\n    54\t\n    55\t\n    56\tdef ans(view_id, outcome, rung, reference):\n    57\t    return {'view_id': view_id, 'shape': 'forecast', 'outcome': outcome, 'rung': rung, 'reference': reference, 'reasons': 'r', 'cites': [],\n    58\t            'pushes': [], 'theme_pushes': [], 'changed': True, 'why_changed': 'w'}\n    59\t\n    60\t\n    61\t# ---------- R1: old-2 calls 8729 (v14) and 8737 (v9), 2026-09-20 ----------\n    62\tBANDS_OLD2_REV = [[450, None], [400, 450], [350, 400], [300, 350], [None, 300]]\n    63\tCO, DC = 'company', 'Data Center'\n    64\tR1_FAMILY = {'members': {'v14': {'what': W('NVIDIA', 'revenue', CO, 'FY2027'), 'bands': BANDS_OLD2_REV},\n    65\t                         'v9': {'what': W('NVIDIA', 'revenue', DC, 'FY2027'), 'bands': BANDS_OLD2_REV}},\n    66\t             'relations': [{'type': 'part_of', 'part': 'v9', 'whole': 'v14'}],\n    67\t             'shared': [W('NVIDIA', 'revenue', CO, 'FY2027 Q3'), W('NVIDIA', 'revenue', CO, 'FY2027 Q4')],\n    68\t             'compare_periods': ['FY2027 Q3', 'FY2027 Q4', 'FY2027'],\n    69\t             'prior_answers': {'v9': {'day': '2026-09-19', 'values': [414.0, 385.0, 390.0]}}}   # call 8621: reference $414B, outcome $385–390B\n    70\tR1_PASSAGES = store_passages('old-2', ['e238', 'e2497', 'e2499', 'e4762', 'e3943', 'e5056', 'e4995', 'e3219', 'e976'])\n    71\t\n    72\t\n    73\tdef r1_common():\n    74\t    return [\n    75\t        src('q1', 'e238', '$81.6 billion', 81.6, 'USD bn', 'reported', W('NVIDIA', 'revenue', CO, 'FY2027 Q1')),\n    76\t        src('q2', 'e2497', '$96.2 billion', 96.2, 'USD bn', 'reported', W('NVIDIA', 'revenue', CO, 'FY2027 Q2')),\n    77\t        src('g3', 'e2499', '$108.0 billion, plus or minus 2%', 108.0, 'USD bn', 'guidance', W('NVIDIA', 'revenue', CO, 'FY2027 Q3'), 'midpoint'),\n    78\t        src('g3w', 'e2499', '$108.0 billion, plus or minus 2%', 2.0, '%', 'guidance', W('NVIDIA', 'guidance width', CO, 'FY2027 Q3'), 'relative'),\n    79\t        comp('g3r', 'range_from_relative', ['g3', 'g3w'], (105.84, 110.16), 'USD bn', W('NVIDIA', 'revenue', CO, 'FY2027 Q3'), basis='guidance'),\n    80\t        src('beat', 'e4762', '3.1%', 3.1, '%', 'third_party', W('NVIDIA', 'beat over the guidance high end', CO, 'last four quarters')),\n    81\t        est('q3f', 113.5, 'USD bn', W('NVIDIA', 'revenue', CO, 'FY2027 Q3'), 'the guide high end 110.16 plus the 3.1% average beat', ['g3r', 'beat']),\n    82\t        src('g12', 'e3943', '12%', 12.0, '%', 'third_party', W('NVIDIA', 'sequential growth', CO, 'FY2027 Q3')),\n    83\t        est('carry', 12.0, '%', W('NVIDIA', 'assumption', CO, 'FY2027 Q4'), \"Q3's guided 12% sequential growth continues into Q4\", ['g12'],\n    84\t            converts=['q3f']),\n    85\t        comp('q4f', 'apply_growth', ['q3f', 'g12'], 127.1, 'USD bn', W('NVIDIA', 'revenue', CO, 'FY2027 Q4'), bridge='carry'),\n    86\t        comp('fy14', 'sum', ['q1', 'q2', 'q3f', 'q4f'], 418.4, 'USD bn', W('NVIDIA', 'revenue', CO, 'FY2027'), relation='time_aggregation'),\n    87\t        src('c411', 'e5056', 'around $411 billion', 411.0, 'USD bn', 'consensus', W('NVIDIA', 'revenue', CO, 'FY2027'), 'bound', 'approx'),\n    88\t        src('dch1', 'e4995', '$164 billion', 164.0, 'USD bn', 'reported', W('NVIDIA', 'revenue', DC, 'FY2027 H1')),\n    89\t        src('mix', 'e3219', '92.5%', 92.5, '%', 'reported', W('NVIDIA', 'Data Center share', CO, 'FY2027 Q2')),\n    90\t    ]\n    91\t\n    92\t\n    93\tdef r1(variant):\n    94\t    figs = r1_common()\n    95\t    if variant in ('a', 'b'):\n    96\t        figs.append(comp('dcq3', 'share', ['g3', 'mix'], 99.9, 'USD bn', W('NVIDIA', 'revenue', DC, 'FY2027 Q3')))\n    97\t    else:\n    98\t        figs.append(comp('dcq3', 'share', ['q3f', 'mix'], 105.0, 'USD bn', W('NVIDIA', 'revenue', DC, 'FY2027 Q3')))\n    99\t    if variant == 'a':\n   100\t        figs.append(est('dcq4', 146.0, 'USD bn', W('NVIDIA', 'revenue', DC, 'FY2027 Q4'),\n   101\t                        'hyperscale reacceleration, the Rubin ramp, a discounted SemiAnalysis uplift', ['e976']))\n   102\t        dcfy = 409.9\n   103\t    elif variant == 'b':\n   104\t        figs.append(est('dcq4', 115.0, 'USD bn', W('NVIDIA', 'revenue', DC, 'FY2027 Q4'), 'held below the company quarter', ['e976']))\n   105\t        dcfy = 378.9\n   106\t    else:\n   107\t        figs.append(comp('dcq4', 'share', ['q4f', 'mix'], 117.6, 'USD bn', W('NVIDIA', 'revenue', DC, 'FY2027 Q4')))\n   108\t        dcfy = 386.6\n   109\t    figs.append(comp('dcfy', 'sum', ['dch1', 'dcq3', 'dcq4'], dcfy, 'USD bn', W('NVIDIA', 'revenue', DC, 'FY2027'), relation='time_aggregation'))\n   110\t    if variant == 'a':                                    # as stored: the previous conclusion's $414B called the market reference\n   111\t        figs.append({'id': 'prior414', 'kind': 'prior', 'basis': 'prior_forecast', 'value': 414.0, 'unit': 'USD bn',\n   112\t                     'what': W('NVIDIA', 'revenue', DC, 'FY2027'), 'pointer': {'view': 'v9', 'day': '2026-09-19'}})   # its reference field, $414B since 09-14 (call 7939)\n   113\t        v9_ref = {'figure': 'prior414'}\n   114\t    else:\n   115\t        figs.append(comp('dcref', 'share', ['c411', 'mix'], 380.2, 'USD bn', W('NVIDIA', 'revenue', DC, 'FY2027'), basis='consensus', bound='approx'))\n   116\t        v9_ref = {'figure': 'dcref'}\n   117\t    v9_rung = 2 if dcfy >= 400 else 3\n   118\t    return {'figures': figs, 'answers': [ans('v14', 'fy14', 2, {'figure': 'c411'}), ans('v9', 'dcfy', v9_rung, v9_ref)]}\n   119\t\n   120\t\n   121\t# ---------- R2: old-2 call 8734 (v29 equity commitments) ----------\n   122\tR2_FAMILY = {'members': {'v29': {'what': W('NVIDIA', 'equity investment commitments', CO, 'end of FY2027'),\n   123\t                                 'bands': [[None, 25], [25, 50], [50, 75], [75, 100], [100, None]]}},\n   124\t             'relations': [], 'shared': [], 'compare_periods': []}\n   125\tR2_PASSAGES = store_passages('old-2', ['e2620', 'e2889', 'e1732'])\n   126\t\n   127\t\n   128\tdef r2():\n   129\t    eic = 'equity investment commitments'\n   130\t    return {'figures': [\n   131\t        src('bal', 'e2620', '$25 billion', 25.0, 'USD bn', 'reported', W('NVIDIA', eic, CO, 'as of 2026-07-26')),\n   132\t        src('add18', 'e2889', '$18 billion', 18.0, 'USD bn', 'reported', W('NVIDIA', eic, CO, 'rest of FY2027')),\n   133\t        est('mtk', 3.5, 'USD bn', W('NVIDIA', eic, CO, 'rest of FY2027'), 'the MediaTek investment announced after the balance date'),\n   134\t        est('talks', 6.5, 'USD bn', W('NVIDIA', eic, CO, 'rest of FY2027'), 'the Anthropic and Thinking Machines talks, risk-adjusted (amount inferred from the stated $53B total)'),\n   135\t        src('ref70', 'e1732', '$70 billion', 70.0, 'USD bn', 'third_party', W('NVIDIA', 'equity investments to ecosystem partners', CO, 'period not specified')),\n   136\t        comp('end', 'roll_forward', ['bal', 'add18', 'mtk', 'talks'], 53.0, 'USD bn', W('NVIDIA', eic, CO, 'end of FY2027'),\n   137\t             relation='overlap_unknown', disputed='add18'),\n   138\t    ], 'answers': [ans('v29', 'end', 3, {'figure': 'ref70'})]}                     # as stored: Bank of America's $70B\n   139\t\n   140\t\n   141\t# ---------- R3: old-2 call 8595 (v6, four hyperscalers' 2027 data-center capex) ----------\n   142\tFOUR = 'four largest AI hyperscalers'\n   143\tR3_FAMILY = {'members': {'v6': {'what': W(FOUR, 'data-center capex', 'combined', 'CY2027'),\n   144\t                                'bands': [[None, 800], [800, 900], [900, 1100], [1100, 1200], [1200, None]]}},\n   145\t             'relations': [], 'shared': [], 'compare_periods': []}\n   146\tR3_PASSAGES = store_passages('old-2', ['e1786', 'e2535', 'e1926'])\n   147\t\n   148\t\n   149\tdef r3(variant):\n   150\t    if variant == 'a':                                    # the qualifiers stripped, as the stored arithmetic used them\n   151\t        a = src('a730', 'e1786', '$730 billion', 730.0, 'USD bn', 'reported', W(FOUR, 'AI infrastructure spending', 'combined', 'CY2026'))\n   152\t        b = src('b800', 'e2535', '$800 billion', 800.0, 'USD bn', 'guidance', W('top five hyperscalers', 'capex', 'combined', 'CY2026'))\n   153\t        bound = {}\n   154\t    else:\n   155\t        a = src('a730', 'e1786', 'more than $730 billion', 730.0, 'USD bn', 'reported', W(FOUR, 'AI infrastructure spending', 'combined', 'CY2026'),\n   156\t                'bound', '>')\n   157\t        b = src('b800', 'e2535', 'nearly $800 billion', 800.0, 'USD bn', 'guidance', W('top five hyperscalers', 'capex', 'combined', 'CY2026'),\n   158\t                'bound', 'approx_below')\n   159\t        bound = {'bound': '>'}                            # more than $730B over nearly $800B, times $1.3T: a lower bound\n   160\t    c = src('c1300', 'e2535', '$1.3 trillion', 1300.0, 'USD bn', 'guidance', W('top five hyperscalers', 'capex', 'combined', 'CY2027'))\n   161\t    figs = [a, b, c]\n   162\t    ratio_extra, prod_extra = dict(bound), dict(bound)\n   163\t    if variant == 'c':\n   164\t        figs.append(est('br1', 0.9125, 'x', W(FOUR, 'assumption', 'combined', 'CY2026'),\n   165\t                        \"four companies' AI infrastructure spending stands for their share of five companies' capex\", converts=['a730', 'b800']))\n   166\t        figs.append(est('br2', 0.9125, 'x', W(FOUR, 'assumption', 'combined', 'CY2027'),\n   167\t                        'the 2026 share carries to 2027 and to data-center capex', converts=['c1300']))\n   168\t        ratio_extra['bridge'], prod_extra['bridge'] = 'br1', 'br2'\n   169\t    figs.append(comp('share45', 'ratio', ['a730', 'b800'], 0.9125, 'x', W(FOUR, 'share of top-five capex', 'combined', 'CY2026'), **ratio_extra))\n   170\t    figs.append(comp('cap27', 'product', ['share45', 'c1300'], 1186.25, 'USD bn', W(FOUR, 'data-center capex', 'combined', 'CY2027'), **prod_extra))\n   171\t    figs.append(src('ref108', 'e1926', '$1.08 trillion', 1080.0, 'USD bn', 'third_party', W('hyperscalers', 'spending', 'combined', 'CY2027')))\n   172\t    return {'figures': figs, 'answers': [ans('v6', 'cap27', 4, {'figure': 'ref108'})]}   # as stored: the $1.08T consensus\n   173\t\n   174\t\n   175\t# ---------- R4: old-3 call 9166 (v41, FY2028 Vera CPU) ----------\n   176\tR4_FAMILY = {'members': {'v41': {'what': W('NVIDIA', 'revenue', 'Vera CPU', 'FY2028'),\n   177\t                                 'bands': [[50, None], [40, 50], [30, 40], [20, 30], [None, 20]]}},\n   178\t             'relations': [], 'shared': [], 'compare_periods': []}\n   179\tR4_PASSAGES = store_passages('old-3', ['e3660'])\n   180\t\n   181\t\n   182\tdef r4():\n   183\t    return {'figures': [\n   184\t        src('c20', 'e3660', '$20 billion', 20.0, 'USD bn', 'guidance', W('NVIDIA', 'revenue', 'CPU', 'FY2027')),\n   185\t        src('m2', 'e3660', 'more than double', 2.0, 'x', 'guidance', W('NVIDIA', 'revenue multiple', 'CPU', 'FY2028'), 'multiplier', '>'),\n   186\t        comp('cpu28', 'product', ['c20', 'm2'], 40.0, 'USD bn', W('NVIDIA', 'revenue', 'CPU', 'FY2028'), basis='guidance', bound='>'),\n   187\t        est('vera28', (38.0, 39.0), 'USD bn', W('NVIDIA', 'revenue', 'Vera CPU', 'FY2028'),\n   188\t            \"management's CPU outlook read as Vera's, trimmed for no shipment volume in hand and AMD's benchmarks\", ['cpu28'],\n   189\t            adjusts={'figure': 'cpu28', 'type': 'trim'}),\n   190\t    ], 'answers': [ans('v41', 'vera28', 3, {'figure': 'cpu28'})]}\n   191\t\n   192\t\n   193\t# ---------- G1–G4: the frozen gold's reasoning (q01, q02, q19, q22) ----------\n   194\tG_PASSAGES = packet_passages(['i037', 'i090', 'i280', 'i281', 'i295', 'i106', 'i219', 'i216', 'i288', 'i129', 'i096', 'i218', 'i256', 'i173'])\n   195\tSEED = {'v1': [[500, None], [400, 500], [350, 400], [300, 350], [None, 300]],\n   196\t        'v2': [[440, None], [360, 440], [310, 360], [260, 310], [None, 260]],\n   197\t        'v19': [[20, None], [12, 20], [6, 12], [2, 6], [None, 2]],\n   198\t        'v22': [[650, None], [550, 650], [480, 550], [420, 480], [None, 420]]}\n   199\t\n   200\t\n   201\tdef q01_figs():\n   202\t    return [\n   203\t        src('gq1', 'i280', '$81.6 billion', 81.6, 'USD bn', 'reported', W('NVIDIA', 'revenue', CO, 'FY2027 Q1')),\n   204\t        src('gq2', 'i281', '$91 billion, plus or minus 2%', 91.0, 'USD bn', 'guidance', W('NVIDIA', 'revenue', CO, 'FY2027 Q2'), 'midpoint'),\n   205\t        comp('gh1', 'sum', ['gq1', 'gq2'], 172.6, 'USD bn', W('NVIDIA', 'revenue', CO, 'FY2027 H1'), relation='time_aggregation'),\n   206\t        est('gh2', (228.0, 262.0), 'USD bn', W('NVIDIA', 'revenue', CO, 'FY2027 H2'),\n   207\t            'accelerating growth, compute 20% above consensus, the Rubin ramp at twice the GB300 price, the Vera target: no fixed increment',\n   208\t            ['i295', 'i106', 'i219', 'i216', 'i288']),\n   209\t        comp('gfy', 'sum', ['gh1', 'gh2'], (400.0, 435.0), 'USD bn', W('NVIDIA', 'revenue', CO, 'FY2027'), relation='time_aggregation'),\n   210\t        src('gc392', 'i037', '$392 billion', 392.0, 'USD bn', 'consensus', W('NVIDIA', 'revenue', CO, 'FY2027')),\n   211\t    ]\n   212\t\n   213\t\n   214\tV1 = {'what': W('NVIDIA', 'revenue', CO, 'FY2027'), 'bands': SEED['v1']}\n   215\t\n   216\t\n   217\tdef g1():\n   218\t    return ({'members': {'v1': V1}, 'relations': [], 'shared': [], 'compare_periods': []},\n   219\t            {'figures': q01_figs(), 'answers': [ans('v1', 'gfy', 2, {'figure': 'gc392'})]})\n   220\t\n   221\t\n   222\tdef g2():\n   223\t    \"\"\"q01 and q02 with paired scenarios [46g.3]: low and high paths for the company total and the segment, each final range an estimate.\"\"\"\n   224\t    figs = [f for f in q01_figs() if f['id'] in ('gq1', 'gq2', 'gh1', 'gc392')] + [\n   225\t        est('gh2lo', 228.0, 'USD bn', W('NVIDIA', 'revenue', CO, 'FY2027 H2'), 'the low end of the second-half drivers',\n   226\t            ['i295', 'i106', 'i219', 'i216', 'i288'], scenario='low'),\n   227\t        est('gh2hi', 262.0, 'USD bn', W('NVIDIA', 'revenue', CO, 'FY2027 H2'), 'the high end of the second-half drivers',\n   228\t            ['i295', 'i106', 'i219', 'i216', 'i288'], scenario='high'),\n   229\t        comp('gfylo', 'sum', ['gh1', 'gh2lo'], 400.6, 'USD bn', W('NVIDIA', 'revenue', CO, 'FY2027'), relation='time_aggregation', scenario='low'),\n   230\t        comp('gfyhi', 'sum', ['gh1', 'gh2hi'], 434.6, 'USD bn', W('NVIDIA', 'revenue', CO, 'FY2027'), relation='time_aggregation', scenario='high'),\n   231\t        est('gfy', (400.0, 435.0), 'USD bn', W('NVIDIA', 'revenue', CO, 'FY2027'), 'the two paths, rounded', ['gfylo', 'gfyhi'], scenario='range'),\n   232\t        src('gmix', 'i129', '92%', 92.0, '%', 'reported', W('NVIDIA', 'Data Center share', CO, 'FY2027 Q1')),\n   233\t        comp('gref2', 'share', ['gc392', 'gmix'], 360.6, 'USD bn', W('NVIDIA', 'revenue', DC, 'FY2027'), basis='consensus'),\n   234\t        est('gshlo', 92.0, '%', W('NVIDIA', 'Data Center share', CO, 'FY2027'), 'the Q1 mix, held', ['gmix'], scenario='low'),\n   235\t        est('gshhi', 93.0, '%', W('NVIDIA', 'Data Center share', CO, 'FY2027'), 'the Q1 mix, a point higher', ['gmix'], scenario='high'),\n   236\t        comp('gdclo', 'share', ['gfylo', 'gshlo'], 368.55, 'USD bn', W('NVIDIA', 'revenue', DC, 'FY2027'), scenario='low'),\n   237\t        comp('gdchi', 'share', ['gfyhi', 'gshhi'], 404.18, 'USD bn', W('NVIDIA', 'revenue', DC, 'FY2027'), scenario='high'),\n   238\t        est('gdc', (370.0, 400.0), 'USD bn', W('NVIDIA', 'revenue', DC, 'FY2027'), 'the two paths, with the compute tracking',\n   239\t            ['gdclo', 'gdchi', 'i106'], scenario='range'),\n   240\t    ]\n   241\t    family = {'members': {'v1': V1, 'v2': {'what': W('NVIDIA', 'revenue', DC, 'FY2027'), 'bands': SEED['v2']}},\n   242\t              'relations': [{'type': 'part_of', 'part': 'v2', 'whole': 'v1'}],\n   243\t              'shared': [W('NVIDIA', 'revenue', CO, 'FY2027')], 'compare_periods': ['FY2027']}\n   244\t    return family, {'figures': figs, 'answers': [ans('v1', 'gfy', 2, {'figure': 'gc392'}), ans('v2', 'gdc', 2, {'figure': 'gref2'})]}\n   245\t\n   246\t\n   247\tdef g3():\n   248\t    figs = [\n   249\t        src('gt20', 'i288', '$20 billion', 20.0, 'USD bn', 'guidance', W('NVIDIA', 'revenue', 'Vera CPU', 'FY2027')),\n   250\t        src('gasp', 'i218', '$5,000', 5000.0, 'USD', 'third_party', W('NVIDIA', 'price per unit', 'Vera CPU', 'in volume')),\n   251\t        comp('gunits', 'ratio', ['gt20', 'gasp'], 4000000.0, 'units', W('NVIDIA', 'units', 'Vera CPU', 'FY2027')),\n   252\t        est('gvera', (8.0, 18.0), 'USD bn', W('NVIDIA', 'revenue', 'Vera CPU', 'FY2027'),\n   253\t            'launches this fall, about two selling quarters; four million units; a host-CPU choice of Xeon', ['gunits', 'i096'],\n   254\t            adjusts={'figure': 'gt20', 'type': 'discount'}),\n   255\t    ]\n   256\t    family = {'members': {'v19': {'what': W('NVIDIA', 'revenue', 'Vera CPU', 'FY2027'), 'bands': SEED['v19']}},\n   257\t              'relations': [], 'shared': [], 'compare_periods': []}\n   258\t    return family, {'figures': figs, 'answers': [ans('v19', 'gvera', 2, {'figure': 'gt20'})]}\n   259\t\n   260\t\n   261\tdef g4():\n   262\t    figs = q01_figs() + [\n   263\t        src('g41', 'i090', '41%', 41.0, '%', 'consensus', W('NVIDIA', 'revenue growth', CO, 'FY2028')),\n   264\t        comp('gfy28c', 'apply_growth', ['gfy', 'g41'], (565.0, 615.0), 'USD bn', W('NVIDIA', 'revenue', CO, 'FY2028')),\n   265\t        est('gfy28', (560.0, 640.0), 'USD bn', W('NVIDIA', 'revenue', CO, 'FY2028'), 'the big four capex step to over $1 trillion; Rubin pricing; Vera',\n   266\t            ['gfy28c', 'i256', 'i173'], scenario='range'),\n   267\t        src('gc554', 'i037', '$554 billion', 554.0, 'USD bn', 'consensus', W('NVIDIA', 'revenue', CO, 'FY2028')),\n   268\t    ]\n   269\t    family = {'members': {'v1': V1, 'v22': {'what': W('NVIDIA', 'revenue', CO, 'FY2028'), 'bands': SEED['v22']}},\n   270\t              'relations': [{'type': 'same_base', 'later': 'v22', 'earlier': 'v1'}], 'shared': [], 'compare_periods': []}\n   271\t    return family, {'figures': figs, 'answers': [ans('v1', 'gfy', 2, {'figure': 'gc392'}), ans('v22', 'gfy28', 2, {'figure': 'gc554'})]}\n   272\t\n   273\t\n   274\t# ---------- the registered items ----------\n   275\tdef codes(result):\n   276\t    return {code for code, _ in result['errors']}\n   277\t\n   278\t\n   279\tMANIFEST = {}\n   280\t\n   281\t\n   282\tdef run():\n   283\t    rows = []\n   284\t\n   285\t    def item(name, family, passages, calc, ok, why):\n   286\t        MANIFEST[name] = {'family': family, 'calc': calc}\n   287\t        try:\n   288\t            result = cc.check(family, passages, calc)\n   289\t        except Exception as error:                    # a crash is a miss with its reason, never a silent stop of the gate\n   290\t            rows.append((name, False, f'CRASH {type(error).__name__}: {error}', {'errors': [], 'recorded': []}))\n   291\t            return\n   292\t        verdict, note = ok(result)\n   293\t        rows.append((name, verdict, note, result))\n   294\t\n   295\t    item('R1a', R1_FAMILY, R1_PASSAGES, r1('a'),\n   296\t         lambda r: ('C3' in codes(r) and any('FY2027 Q4' in d for c, d in r['errors'] if c == 'C3'), 'C3 on Q4'), '')\n   297\t    item('R1b', R1_FAMILY, R1_PASSAGES, r1('b'),\n   298\t         lambda r: ('C4' in codes(r) and 'C3' not in codes(r) and any('FY2027 Q3' in d and 'g3' in d for c, d in r['errors'] if c == 'C4'),\n   299\t                    'C4 on the Q3 bypass, no C3'), '')\n   300\t    item('R1c', R1_FAMILY, R1_PASSAGES, r1('c'), lambda r: (not r['errors'], 'passes'), '')\n   301\t    item('R2', R2_FAMILY, R2_PASSAGES, r2(),\n   302\t         lambda r: (not r['errors'] and any(x['type'] == 'overlap' and x['figure'] == 'end' and abs(x['alternate'][0] - 35) < 0.01\n   303\t                                            and 50 in x['definite'] for x in r['recorded']),\n   304\t                    'overlap recorded; ~35 definitely crosses 50'), '')\n   305\t    item('R3a', R3_FAMILY, R3_PASSAGES, r3('a'),\n   306\t         lambda r: (any(c == 'C1' and 'a730' in d for c, d in r['errors']) and any(c == 'C1' and 'b800' in d for c, d in r['errors']),\n   307\t                    'C1 on both stripped qualifiers'), '')\n   308\t    item('R3b', R3_FAMILY, R3_PASSAGES, r3('b'),\n   309\t         lambda r: ('C1' not in codes(r) and 'C8' in codes(r), 'passes C1, C8 without bridges'), '')\n   310\t    item('R3c', R3_FAMILY, R3_PASSAGES, r3('c'),\n   311\t         lambda r: (not r['errors'] and sum(x['type'] == 'bridge' for x in r['recorded']) == 2, 'bridges recorded, undetermined'), '')\n   312\t    item('R4', R4_FAMILY, R4_PASSAGES, r4(),\n   313\t         lambda r: (not r['errors'] and any(x['type'] == 'adjustment' and x['figure'] == 'vera28' and 40 in x['definite']\n   314\t                                            for x in r['recorded']), 'trim definitely crosses 40'), '')\n   315\t    for name, maker in (('G1', g1), ('G2', g2), ('G3', g3), ('G4', g4)):\n   316\t        family, calc = maker()\n   317\t        item(name, family, G_PASSAGES, calc, lambda r: (not r['errors'], 'passes, estimates visible'), '')\n   318\t    f1, c1 = g1()\n   319\t    p1 = copy.deepcopy(c1)\n   320\t    p1['figures'][0]['value'] = 81.9\n   321\t    item('P1', f1, G_PASSAGES, p1, lambda r: (codes(r) == {'C1'} and any('gq1' in d for _, d in r['errors']), 'C1 only, on gq1'), '')\n   322\t    p2 = copy.deepcopy(c1)\n   323\t    gfy = next(f for f in p2['figures'] if f['id'] == 'gfy')\n   324\t    gfy['low'], gfy['high'] = 450.0, 480.0\n   325\t    item('P2', f1, G_PASSAGES, p2, lambda r: (codes(r) == {'C2'} and any('gfy' in d for _, d in r['errors']), 'C2 only, on gfy'), '')\n   326\t    p3a = copy.deepcopy(c1)\n   327\t    p3a['figures'].append({'id': 'pri', 'kind': 'prior', 'basis': 'prior_forecast', 'value': 425.0, 'unit': 'USD bn',\n   328\t                           'what': W('NVIDIA', 'revenue', CO, 'FY2027'), 'pointer': {'view': 'v1', 'day': '2026-07-13'}})\n   329\t    p3a['answers'][0]['reference'] = {'figure': 'pri'}\n   330\t    f1p = dict(f1, prior_answers={'v1': {'day': '2026-07-13', 'values': [425.0]}})       # the earlier answer it points to, as shown\n   331\t    item('P3a', f1p, G_PASSAGES, p3a, lambda r: (codes(r) == {'C5'}, 'C5 only'), '')\n   332\t    f2, c2 = g2()\n   333\t    g2x = copy.deepcopy(c2)\n   334\t    lo = next(f for f in g2x['figures'] if f['id'] == 'gdclo'); hi = next(f for f in g2x['figures'] if f['id'] == 'gdchi')\n   335\t    lo['inputs'], lo['value'] = ['gfyhi', 'gshlo'], 399.83                  # crossed: low share on the high total\n   336\t    hi['inputs'], hi['value'] = ['gfylo', 'gshhi'], 372.56\n   337\t    item('G2x', f2, G_PASSAGES, g2x, lambda r: (any(c == 'C4' and 'another scenario' in d for c, d in r['errors']), 'C4: scenarios crossed'), '')\n   338\t    r1x = r1('b')\n   339\t    r1x['figures'].append(est('altq3', 108.0, 'USD bn', W('NVIDIA', 'revenue', CO, 'FY2027 Q3'), 'the guide as an alternate forecast', ['g3'],\n   340\t                              scenario='alt'))\n   341\t    next(f for f in r1x['figures'] if f['id'] == 'dcq3')['inputs'] = ['altq3', 'mix']\n   342\t    item('R1bx', R1_FAMILY, R1_PASSAGES, r1x, lambda r: (any(c == 'C4' and 'another scenario' in d for c, d in r['errors']),\n   343\t                                                         'C4: the base reads an alternate scenario'), '')\n   344\t    r1x2 = r1('b')                                    # routed through an intermediate segment figure\n   345\t    r1x2['figures'].append(est('altq3', 108.0, 'USD bn', W('NVIDIA', 'revenue', CO, 'FY2027 Q3'), 'the guide as an alternate forecast', ['g3'],\n   346\t                               scenario='alt'))\n   347\t    r1x2['figures'].append(comp('altdc', 'share', ['altq3', 'mix'], 99.9, 'USD bn', W('NVIDIA', 'revenue', DC, 'FY2027 Q3 interim'), scenario='alt'))\n   348\t    next(f for f in r1x2['figures'] if f['id'] == 'dcq3').update(operation='product', inputs=['altdc', 'one'], value=99.9)\n   349\t    r1x2['figures'].append({'id': 'one', 'kind': 'estimate', 'unit': 'x', 'basis': 'forecast', 'what': W('NVIDIA', 'factor', DC, 'FY2027 Q3'),\n   350\t                            'basis_text': 'unchanged', 'rests_on': [], 'value': 1.0})\n   351\t    item('R1bx2', R1_FAMILY, R1_PASSAGES, r1x2, lambda r: (any(c == 'C4' and 'another scenario' in d for c, d in r['errors']),\n   352\t                                                           'C4: borrowed through an intermediate'), '')\n   353\t    r1x4 = r1('b')                                    # an alternate forecast computed from sources only (no estimate on its path)\n   354\t    r1x4['figures'].append(comp('altq3', 'sum', ['g3'], 108.0, 'USD bn', W('NVIDIA', 'revenue', CO, 'FY2027 Q3'), relation='stated_in_addition',\n   355\t                                scenario='alt'))\n   356\t    next(f for f in r1x4['figures'] if f['id'] == 'dcq3')['inputs'] = ['altq3', 'mix']\n   357\t    item('R1bx4', R1_FAMILY, R1_PASSAGES, r1x4, lambda r: (any(c == 'C4' and 'another scenario' in d for c, d in r['errors']),\n   358\t                                                           'C4: the base reads a source-only alternate forecast'), '')\n   359\t    r1x3 = r1('b')                                    # a point labelled range, read by the base\n   360\t    r1x3['figures'].append(est('altq3', 108.0, 'USD bn', W('NVIDIA', 'revenue', CO, 'FY2027 Q3'), 'the guide as a point', ['g3'], scenario='range'))\n   361\t    next(f for f in r1x3['figures'] if f['id'] == 'dcq3')['inputs'] = ['altq3', 'mix']\n   362\t    item('R1bx3', R1_FAMILY, R1_PASSAGES, r1x3, lambda r: (any(c == 'C4' and 'range summary' in d for c, d in r['errors']),\n   363\t                                                           'C4: a point labelled range'), '')\n   364\t    p3e2 = copy.deepcopy(p3a)                         # the earlier forecast relabelled as an estimate\n   365\t    pri = next(f for f in p3e2['figures'] if f['id'] == 'pri')\n   366\t    pri.update(kind='estimate', basis_text='our earlier figure', rests_on=[])\n   367\t    p3e2['answers'][0]['outcome'] = 'pri'\n   368\t    p3e2['answers'][0]['reference'] = {'figure': 'gc392'}\n   369\t    item('P3e2', f1p, G_PASSAGES, p3e2, lambda r: (any(c == 'C10' for c, d in r['errors']), 'C10: an earlier forecast relabelled'), '')\n   370\t    r1sc = r1('a')                                    # [46j.1] the company in base, Data Center in alt: the stored contradiction relabelled\n   371\t    for f in r1sc['figures']:\n   372\t        if f['id'] in ('dcq3', 'dcq4', 'dcfy'):\n   373\t            f['scenario'] = 'alt'\n   374\t    r1sc['figures'] = [f for f in r1sc['figures'] if f['id'] != 'prior414']\n   375\t    r1sc['answers'][1]['reference'] = {'unavailable': 'none supplied'}\n   376\t    item('R1sc', R1_FAMILY, R1_PASSAGES, r1sc, lambda r: (any(c == 'C4' and 'cover' in d for c, d in r['errors']),\n   377\t                                                         'C4: part and whole in different scenarios'), '')\n   378\t    g2x2 = copy.deepcopy(c2)                          # [46j.1] crossing the non-shared share estimates\n   379\t    next(f for f in g2x2['figures'] if f['id'] == 'gdclo').update(inputs=['gfylo', 'gshhi'], value=372.56)\n   380\t    next(f for f in g2x2['figures'] if f['id'] == 'gdchi').update(inputs=['gfyhi', 'gshlo'], value=399.83)\n   381\t    item('G2x2', f2, G_PASSAGES, g2x2, lambda r: (any(c == 'C4' and 'another scenario' in d for c, d in r['errors']),\n   382\t                                                   'C4: share estimates crossed'), '')\n   383\t    f24 = {'members': {'v1': V1, 'v22': {'what': W('NVIDIA', 'revenue', CO, 'FY2028'), 'bands': SEED['v22']}},\n   384\t           'relations': [{'type': 'same_base', 'later': 'v22', 'earlier': 'v1'}], 'shared': [W('NVIDIA', 'revenue', CO, 'FY2027')],\n   385\t           'compare_periods': []}\n   386\t    c24 = copy.deepcopy(c2)                           # [46j.2] q22 on q01's published range, per scenario\n   387\t    c24['figures'] = [f for f in c24['figures'] if f['id'] not in ('gmix', 'gref2', 'gshlo', 'gshhi', 'gdclo', 'gdchi', 'gdc')] + [\n   388\t        src('g41', 'i090', '41%', 41.0, '%', 'consensus', W('NVIDIA', 'revenue growth', CO, 'FY2028')),\n   389\t        comp('g28lo', 'apply_growth', ['gfylo', 'g41'], 564.85, 'USD bn', W('NVIDIA', 'revenue', CO, 'FY2028'), scenario='low'),\n   390\t        comp('g28hi', 'apply_growth', ['gfyhi', 'g41'], 612.79, 'USD bn', W('NVIDIA', 'revenue', CO, 'FY2028'), scenario='high'),\n   391\t        est('g28', (560.0, 640.0), 'USD bn', W('NVIDIA', 'revenue', CO, 'FY2028'), 'the two paths, widened for capex, Rubin pricing and Vera',\n   392\t            ['g28lo', 'g28hi', 'i256', 'i173'], scenario='range'),\n   393\t        src('gc554', 'i037', '$554 billion', 554.0, 'USD bn', 'consensus', W('NVIDIA', 'revenue', CO, 'FY2028'))]\n   394\t    c24['answers'] = [ans('v1', 'gfy', 2, {'figure': 'gc392'}), ans('v22', 'g28', 2, {'figure': 'gc554'})]\n   395\t    item('G24', f24, G_PASSAGES, c24, lambda r: (not r['errors'], \"passes: q22 per scenario on q01's range\"), '')\n   396\t    def safe_changed(*args):                          # a crash in change detection is a miss with its reason\n   397\t        try:\n   398\t            return cc.changed(*args)\n   399\t        except Exception as error:\n   400\t            return None, f'CRASH {type(error).__name__}: {error}'\n   401\t    prev = {'rung': 2, 'outcome': 417.5, 'sources': []}\n   402\t    calc_c = r1('c')\n   403\t    figs_c = {f['id']: f for f in calc_c['figures']}\n   404\t    prev['sources'] = cc.member_sources(calc_c['answers'][0], figs_c)\n   405\t    ch1 = safe_changed(dict(prev, outcome=418.4), calc_c['answers'][0], figs_c)\n   406\t    ch2 = safe_changed(dict(prev, rung=3, outcome=387.0), calc_c['answers'][0], figs_c)\n   407\t    sib = copy.deepcopy(calc_c)                       # [46k.3] a sibling-only source change leaves v14 unchanged\n   408\t    sib_figs = {f['id']: f for f in sib['figures']}\n   409\t    sib_figs['dch1'].update(expression='$164 billion', value=164.0)\n   410\t    sib_figs['mix']['evidence'] = 'e3219'\n   411\t    ch3 = safe_changed(dict(prev, outcome=418.4), sib['answers'][0], dict(sib_figs, mix=dict(sib_figs['mix'], expression='92.5% (restated)')))\n   412\t    c5 = r2()                                         # [46aa] declared $52.75B, recomputed and published $53.00B, against a published $52.70B\n   413\t    next(f for f in c5['figures'] if f['id'] == 'end')['value'] = 52.75\n   414\t    f5 = {f['id']: f for f in c5['figures']}\n   415\t    r5 = cc.check(R2_FAMILY, R2_PASSAGES, c5)\n   416\t    own5 = cc.member_sources(c5['answers'][0], f5)\n   417\t    ch5 = safe_changed({'rung': 3, 'outcome': 52.70, 'sources': own5}, c5['answers'][0], f5)\n   418\t    rows.append(('CH5', not r5['errors'] and r5['published']['v29'][:2] == [53.0, 53.0] and ch5[0] is True and '53.0' in ch5[1],\n   419\t                 f'published {r5[\"published\"][\"v29\"]}; {ch5[1]}', r5))\n   420\t    c6 = r4()                                         # [46ab] published below $39B before, above $39B now, same rung and sources\n   421\t    v6 = next(f for f in c6['figures'] if f['id'] == 'vera28'); v6.update(value=39.0, bound='>'); v6.pop('low'); v6.pop('high')\n   422\t    c6['figures'].append(comp('vout', 'sum', ['vera28'], 39.0, 'USD bn', W('NVIDIA', 'revenue', 'Vera CPU', 'FY2028'), bound='>'))\n   423\t    c6['answers'][0].update(outcome='vout', rung=3)\n   424\t    f6 = {f['id']: f for f in c6['figures']}\n   425\t    r6 = cc.check(R4_FAMILY, R4_PASSAGES, c6)\n   426\t    own6 = cc.member_sources(c6['answers'][0], f6)\n   427\t    ch6 = safe_changed({'rung': 3, 'outcome': [None, 39.0, '<'], 'sources': own6}, c6['answers'][0], f6)\n   428\t    ch6b = safe_changed({'rung': 3, 'outcome': r6['published']['v41'], 'sources': own6}, c6['answers'][0], f6)\n   429\t    rows.append(('CH6', not r6['errors'] and ch6[0] is True and ch6b[0] is False, f'below to above 39: {ch6[1]}; same published: {ch6b[1]}', r6))\n   430\t    c7 = r1('c')                                      # [46ac.1] the guidance width dropped, the $108B midpoint kept (same passage and expression)\n   431\t    c7['figures'] = [f for f in c7['figures'] if f['id'] not in ('g3w', 'g3r')]\n   432\t    next(f for f in c7['figures'] if f['id'] == 'q3f')['rests_on'] = ['g3', 'beat']\n   433\t    f7 = {f['id']: f for f in c7['figures']}\n   434\t    r7 = cc.check(R1_FAMILY, R1_PASSAGES, c7)\n   435\t    ch7 = safe_changed({'rung': 2, 'outcome': 418.42, 'sources': prev['sources']}, c7['answers'][0], f7)\n   436\t    rows.append(('CH7', not r7['errors'] and ch7[0] is True and 'relative' in ch7[1], f'{ch7[1]}', r7))\n   437\t    c8 = r4()                                         # [46ac.2] a numeric answer becomes unresolved\n   438\t    c8['answers'][0] = {'view_id': 'v41', 'shape': 'unresolved', 'why': 'no Vera volume stated', 'cites': [], 'pushes': [], 'theme_pushes': []}\n   439\t    r8 = cc.check(R4_FAMILY, R4_PASSAGES, c8)\n   440\t    ch8 = safe_changed({'rung': 3, 'outcome': [38.0, 39.0, None], 'sources': []}, c8['answers'][0], {f['id']: f for f in c8['figures']})\n   441\t    rows.append(('CH8', not r8['errors'] and ch8 == (True, 'now unresolved'), f'{ch8[1]}', r8))\n   442\t    rows.append(('CH1', ch1[0] is False, f'unchanged: {ch1[1]}', {'errors': [], 'recorded': []}))\n   443\t    rows.append(('CH2', ch2[0] is True and 'rung 3 to 2' in ch2[1], f'changed: {ch2[1]}', {'errors': [], 'recorded': []}))\n   444\t    rows.append(('CH3', ch3[0] is False, f'sibling-only change: {ch3[1]}', {'errors': [], 'recorded': []}))\n   445\t    f1g, c1g = g1()                                   # [46l.2] a wider range with the same midpoint\n   446\t    figs_g = {f['id']: f for f in c1g['figures']}\n   447\t    own_g = cc.member_sources(c1g['answers'][0], figs_g)\n   448\t    ch4 = safe_changed({'rung': 2, 'outcome': (390.0, 445.0), 'sources': own_g}, c1g['answers'][0], figs_g)\n   449\t    rows.append(('CH4', ch4[0] is True and 'outcome' in ch4[1], f'wider range, same midpoint: {ch4[1]}', {'errors': [], 'recorded': []}))\n   450\t    g24m = copy.deepcopy(c24)                         # [46k.1] the high path replaced by a standalone estimate\n   451\t    g24m['figures'] = [f for f in g24m['figures'] if f['id'] != 'g28hi'] + [\n   452\t        est('g28hi', 612.79, 'USD bn', W('NVIDIA', 'revenue', CO, 'FY2028'), 'a standalone view', ['i256'], scenario='high')]\n   453\t    item('G24m', f24, G_PASSAGES, g24m, lambda r: (any(c == 'C9' and 'g28hi' in d for c, d in r['errors']), 'C9: the high path skips q01'), '')\n   454\t    g24d = copy.deepcopy(c24)                         # [46l.1] the high calculation deleted\n   455\t    g24d['figures'] = [f for f in g24d['figures'] if f['id'] != 'g28hi']\n   456\t    next(f for f in g24d['figures'] if f['id'] == 'g28')['rests_on'] = ['g28lo', 'i256', 'i173']\n   457\t    item('G24d', f24, G_PASSAGES, g24d, lambda r: (any(c == 'C9' and 'covers' in d for c, d in r['errors']), 'C9: the high path missing'), '')\n   458\t    g24c = copy.deepcopy(c24)                         # [46l.1] the high path computed from FY2028 consensus, q01's high only cited\n   459\t    g24c['figures'] = [f for f in g24c['figures'] if f['id'] != 'g28hi'] + [\n   460\t        est('g28hi', 612.79, 'USD bn', W('NVIDIA', 'revenue', CO, 'FY2028'), 'consensus, adjusted', ['gc554', 'gfyhi'], scenario='high')]\n   461\t    item('G24c', f24, G_PASSAGES, g24c, lambda r: (any(c == 'C9' and 'g28hi' in d for c, d in r['errors']), 'C9: q01 only cited, not computed'), '')\n   462\t    g24c3 = copy.deepcopy(c24)                        # [46m.1] q01's high forecast in an unused third operand\n   463\t    next(f for f in g24c3['figures'] if f['id'] == 'g28hi').update(inputs=['gc554', 'g41', 'gfyhi'], value=781.14)\n   464\t    item('G24c3', f24, G_PASSAGES, g24c3, lambda r: (any(c == 'C7' and 'operands' in d for c, d in r['errors']), 'C7: an operand the arithmetic ignores'), '')\n   465\t    g24s1 = copy.deepcopy(c24)                        # [46n] a sum whose short signs list drops q01's path\n   466\t    g24s1['figures'] = [f for f in g24s1['figures'] if f['id'] != 'g28hi'] + [\n   467\t        comp('g28hi', 'sum', ['gc554', 'gfyhi'], 554.0, 'USD bn', W('NVIDIA', 'revenue', CO, 'FY2028'), scenario='high', signs=[1])]\n   468\t    item('G24s1', f24, G_PASSAGES, g24s1, lambda r: (any(c == 'C7' and 'signs' in d for c, d in r['errors']), 'C7: a short signs list'), '')\n   469\t    g24s0 = copy.deepcopy(c24)                        # [46n] a zero sign\n   470\t    g24s0['figures'] = [f for f in g24s0['figures'] if f['id'] != 'g28hi'] + [\n   471\t        comp('g28hi', 'sum', ['gc554', 'gfyhi'], 554.0, 'USD bn', W('NVIDIA', 'revenue', CO, 'FY2028'), scenario='high', signs=[1, 0])]\n   472\t    item('G24s0', f24, G_PASSAGES, g24s0, lambda r: (any(c == 'C7' and 'signs' in d for c, d in r['errors']), 'C7: a zero sign'), '')\n   473\t    g24a1 = copy.deepcopy(c24)                        # [46n] one operand for apply_growth: refused, not a crash\n   474\t    next(f for f in g24a1['figures'] if f['id'] == 'g28hi')['inputs'] = ['gfyhi']\n   475\t    item('G24a1', f24, G_PASSAGES, g24a1, lambda r: (any(c == 'C7' and 'operands' in d for c, d in r['errors']), 'C7: one operand, no crash'), '')\n   476\t    g24x = copy.deepcopy(c24)                         # [46o.1] q01's base added and subtracted: it cancels out\n   477\t    g24x['figures'] = [f for f in g24x['figures'] if f['id'] != 'g28hi'] + [\n   478\t        comp('g28hi', 'sum', ['gc554', 'gfyhi', 'gfyhi'], 554.0, 'USD bn', W('NVIDIA', 'revenue', CO, 'FY2028'), scenario='high', signs=[1, 1, -1])]\n   479\t    item('G24x', f24, G_PASSAGES, g24x, lambda r: (any(c == 'C9' and 'does not change' in d for c, d in r['errors']), 'C9: a base that cancels'), '')\n   480\t    g24nv = copy.deepcopy(c24)                        # [46o.2] a computed figure with no number\n   481\t    hi_fig = next(f for f in g24nv['figures'] if f['id'] == 'g28hi')\n   482\t    hi_fig.pop('value', None)\n   483\t    item('G24nv', f24, G_PASSAGES, g24nv, lambda r: (any(c == 'C7' and 'value or a complete range' in d for c, d in r['errors']), 'C7: no number, no crash'), '')\n   484\t    f4x, c4x = g4()                                   # [46p] a same-period cancellation on a range base: $554B + x - x\n   485\t    c4x['figures'].append(comp('g28cancel', 'sum', ['gc554', 'gfy28c', 'gfy28c'], 554.0, 'USD bn', W('NVIDIA', 'revenue', CO, 'FY2028'),\n   486\t                               relation='stated_in_addition', signs=[1, 1, -1]))\n   487\t    next(f for f in c4x['figures'] if f['id'] == 'gfy28')['rests_on'] = ['g28cancel', 'i256']\n   488\t    item('G4x', f4x, G_PASSAGES, c4x, lambda r: (any(c == 'C9' and 'g28cancel' in d and 'does not change' in d for c, d in r['errors'])\n   489\t                                                 and 'C8' not in codes(r), 'C9: a range base that cancels, no C8 mask'), '')\n   490\t    for name, bad in (('R1rneg', -2), ('R1r6', 6), ('R1rnone', None)):     # [46q] a rung outside the ladder\n   491\t        rr = r1('c')\n   492\t        if bad is None:\n   493\t            rr['answers'][1].pop('rung')\n   494\t        else:\n   495\t            rr['answers'][1]['rung'] = bad\n   496\t        item(name, R1_FAMILY, R1_PASSAGES, rr, lambda r: (any(c == 'C6' and 'is not one of' in d for c, d in r['errors']), 'C6: no such rung'), '')\n   497\t    for name, rung_b, expect_c6 in (('R4b2', 2, True), ('R4b3', 3, False)):   # [46r] \"less than $40B\" on rung 2 and on rung 3\n   498\t        rb = r4()\n   499\t        next(f for f in rb['figures'] if f['id'] == 'vera28').update(value=40.0, bound='<')\n   500\t        next(f for f in rb['figures'] if f['id'] == 'vera28').pop('low'); next(f for f in rb['figures'] if f['id'] == 'vera28').pop('high')\n   501\t        rb['answers'][0]['rung'] = rung_b\n   502\t        item(name, R4_FAMILY, R4_PASSAGES, rb,\n   503\t             (lambda r: (any(c == 'C6' for c, _ in r['errors']), 'C6: below 40 is not on the 40-50 rung')) if expect_c6 else\n   504\t             (lambda r: (not any(c == 'C6' for c, _ in r['errors']) and any(x['type'] == 'adjustment' and x['definite'] == [40]\n   505\t                                                                          for x in r['recorded']),\n   506\t                         'below 40 sits on the 30-40 rung; the trim from above 40 definitely crosses 40')), '')\n   507\t    rq = r1('c')                                      # [46s, 46z.2] Data Center Q4 strictly above the company Q4, exactly 127.12 recomputed\n   508\t    rq['figures'] = [f for f in rq['figures'] if f['id'] not in ('dcq4', 'dcfy')] + [\n   509\t        est('dcq4', 127.12, 'USD bn', W('NVIDIA', 'revenue', DC, 'FY2027 Q4'), 'above the company quarter', ['e976'], bound='>'),\n   510\t        comp('dcfy', 'sum', ['dch1', 'dcq3', 'dcq4'], 396.1, 'USD bn', W('NVIDIA', 'revenue', DC, 'FY2027'), relation='time_aggregation', bound='>')]\n   511\t    item('R1qb', R1_FAMILY, R1_PASSAGES, rq, lambda r: (any(c == 'C3' and 'FY2027 Q4' in d for c, d in r['errors']), 'C3: strictly above an exact whole'), '')\n   512\t    rq2 = r1('c')                                     # [46t.2] Data Center Q4 above 130 and company Q4 at least 127.1 can both hold\n   513\t    rq2['figures'] = [f for f in rq2['figures'] if f['id'] not in ('q4f', 'fy14', 'dcq4', 'dcfy', 'carry')] + [\n   514\t        est('q4f', 127.1, 'USD bn', W('NVIDIA', 'revenue', CO, 'FY2027 Q4'), 'at least the guided pace', ['q3f', 'g12'], bound='>='),\n   515\t        comp('fy14', 'sum', ['q1', 'q2', 'q3f', 'q4f'], 418.4, 'USD bn', W('NVIDIA', 'revenue', CO, 'FY2027'), relation='time_aggregation', bound='>='),\n   516\t        est('dcq4', 130.0, 'USD bn', W('NVIDIA', 'revenue', DC, 'FY2027 Q4'), 'above the guided company pace times the mix', ['q4f'], bound='>'),\n   517\t        comp('dcfy', 'sum', ['dch1', 'dcq3', 'dcq4'], 399.0, 'USD bn', W('NVIDIA', 'revenue', DC, 'FY2027'), relation='time_aggregation', bound='>')]\n   518\t    item('R1qc', R1_FAMILY, R1_PASSAGES, rq2, lambda r: (not r['errors'], 'passes: >130 within >=127.1 can hold'), '')\n   519\t    rb_one = r4()                                     # [46t.1] the bounded outcome passed through a one-input sum keeps its bound\n   520\t    vf = next(f for f in rb_one['figures'] if f['id'] == 'vera28'); vf.update(value=40.0, bound='<'); vf.pop('low'); vf.pop('high')\n   521\t    rb_one['figures'].append(comp('vout', 'sum', ['vera28'], 40.0, 'USD bn', W('NVIDIA', 'revenue', 'Vera CPU', 'FY2028'), bound='<'))\n   522\t    rb_one['answers'][0].update(outcome='vout', rung=3)\n   523\t    item('R4one', R4_FAMILY, R4_PASSAGES, rb_one, lambda r: (not r['errors'] and any(x['type'] == 'adjustment' and x['definite'] == [40]\n   524\t                                                                                     for x in r['recorded']), 'the bound survives recomputation'), '')\n   525\t    r2b = r2()                                        # [46u.1] a retained lower bound: the alternate stays a lower bound\n   526\t    next(f for f in r2b['figures'] if f['id'] == 'talks')['bound'] = '>'\n   527\t    next(f for f in r2b['figures'] if f['id'] == 'end')['bound'] = '>'\n   528\t    item('R2b1', R2_FAMILY, R2_PASSAGES, r2b, lambda r: (not r['errors'] and any(x['type'] == 'overlap' and 50 in x['possible']\n   529\t                                                                                 and 50 not in x['definite'] for x in r['recorded']),\n   530\t                                                         'the $50B crossing only possible: >$35B may exceed $50B'), '')\n   531\t    for name, declared, expect in (('R2b2a', '<', True), ('R2b2b', '>', False)):   # [46u.2] subtracting a lower bound gives an upper bound\n   532\t        rd = r2()\n   533\t        rd['figures'] = [f for f in rd['figures'] if f['id'] not in ('talks', 'end')] + [\n   534\t            est('draw', 6.5, 'USD bn', W('NVIDIA', 'equity investment commitments', CO, 'rest of FY2027'), 'commitments funded, at least', bound='>'),\n   535\t            comp('end', 'roll_forward', ['bal', 'add18', 'mtk', 'draw'], 40.0, 'USD bn', W('NVIDIA', 'equity investment commitments', CO, 'end of FY2027'),\n   536\t                 relation='overlap_unknown', disputed='add18', signs=[1, 1, 1, -1], bound=declared)]\n   537\t        rd['answers'][0]['rung'] = 2\n   538\t        item(name, R2_FAMILY, R2_PASSAGES, rd,\n   539\t             (lambda r: (not r['errors'], 'passes: 46.5 minus more than 6.5 is below 40')) if expect else\n   540\t             (lambda r: (any(c == 'C2' and 'end' in d for c, d in r['errors']), 'C2: the minus sign flips the bound')), '')\n   541\t    r2m = r2()                                        # [46v] a retained upper bound beside a retained lower bound\n   542\t    next(f for f in r2m['figures'] if f['id'] == 'mtk')['bound'] = '<'\n   543\t    next(f for f in r2m['figures'] if f['id'] == 'talks')['bound'] = '>'\n   544\t    next(f for f in r2m['figures'] if f['id'] == 'end')['bound'] = 'approx'\n   545\t    item('R2m', R2_FAMILY, R2_PASSAGES, r2m, lambda r: (any(c == 'C2' and 'opposite sides' in d for c, d in r['errors'])\n   546\t                                                        and not any(50 in x.get('definite', []) for x in r['recorded']),\n   547\t                                                        'C2: opposing bounds, and no definite crossing recorded'), '')\n   548\t    rrev = r2()                                       # [46w] a bounded commitment booked and fully reversed: exact, not unbounded\n   549\t    rrev['figures'] = [f for f in rrev['figures'] if f['id'] not in ('talks', 'end')] + [\n   550\t        est('cm', 6.5, 'USD bn', W('NVIDIA', 'equity investment commitments', CO, 'rest of FY2027'), 'a commitment later reversed', bound='>'),\n   551\t        comp('end', 'roll_forward', ['bal', 'add18', 'mtk', 'cm', 'cm'], 46.5, 'USD bn', W('NVIDIA', 'equity investment commitments', CO, 'end of FY2027'),\n   552\t             relation='overlap_unknown', disputed='add18', signs=[1, 1, 1, 1, -1])]\n   553\t    rrev['answers'][0]['rung'] = 2\n   554\t    item('R2rev', R2_FAMILY, R2_PASSAGES, rrev, lambda r: (not r['errors'] and any(x['type'] == 'overlap' and x['alternate'] == [28.5, 28.5]\n   555\t                                                                                   for x in r['recorded']), 'passes: x - x nets out; alternate 28.5'), '')\n   556\t    f4y, c4y = g4()                                   # two distinct figures with one derivation: a - b cancels, netting cannot see it\n   557\t    c4y['figures'].append(comp('gfy28d', 'apply_growth', ['gfy', 'g41'], (565.0, 615.0), 'USD bn', W('NVIDIA', 'revenue', CO, 'FY2028')))\n   558\t    c4y['figures'].append(comp('g28cancel', 'sum', ['gc554', 'gfy28c', 'gfy28d'], 554.0, 'USD bn', W('NVIDIA', 'revenue', CO, 'FY2028'),\n   559\t                               relation='stated_in_addition', signs=[1, 1, -1]))\n   560\t    next(f for f in c4y['figures'] if f['id'] == 'gfy28')['rests_on'] = ['g28cancel', 'i256']\n   561\t    item('G4x2', f4y, G_PASSAGES, c4y, lambda r: (any(c == 'C9' and 'g28cancel' in d and 'does not change' in d for c, d in r['errors']),\n   562\t                                                   'C9: two copies of one derivation cancel'), '')\n   563\t    for name, rev in (('R2rev2', comp('rev', 'difference', ['cm', 'cm'], 0.0, 'USD bn', W('NVIDIA', 'equity investment commitments', CO, 'rest of FY2027'))),\n   564\t                      ('R2rev3', comp('rev', 'sum', ['cm', 'cm'], 0.0, 'USD bn', W('NVIDIA', 'equity investment commitments', CO, 'rest of FY2027'),\n   565\t                                      relation='stated_in_addition', signs=[1, -1]))):          # [46x.2] the reversal as its own subtotal\n   566\t        rr2 = r2()\n   567\t        rr2['figures'] = [f for f in rr2['figures'] if f['id'] not in ('talks', 'end')] + [\n   568\t            est('cm', 6.5, 'USD bn', W('NVIDIA', 'equity investment commitments', CO, 'rest of FY2027'), 'a commitment later reversed', bound='>'), rev,\n   569\t            comp('end', 'roll_forward', ['bal', 'add18', 'mtk', 'rev'], 46.5, 'USD bn', W('NVIDIA', 'equity investment commitments', CO, 'end of FY2027'),\n   570\t                 relation='overlap_unknown', disputed='add18')]\n   571\t        rr2['answers'][0]['rung'] = 2\n   572\t        item(name, R2_FAMILY, R2_PASSAGES, rr2, lambda r: (not r['errors'] and any(x['type'] == 'overlap' and x['alternate'] == [28.5, 28.5]\n   573\t                                                                                   for x in r['recorded']), 'passes: a separate x - x is exactly zero'), '')\n   574\t    ramb = r1('c')                                    # [46x.1] two Data Center Q4 forecasts: a starting estimate and an adjusted one\n   575\t    ramb['figures'] = [f for f in ramb['figures'] if f['id'] not in ('dcq4', 'dcfy')] + [\n   576\t        comp('dcq4', 'share', ['q4f', 'mix'], 117.6, 'USD bn', W('NVIDIA', 'revenue', DC, 'FY2027 Q4')),\n   577\t        est('dcq4b', 146.0, 'USD bn', W('NVIDIA', 'revenue', DC, 'FY2027 Q4'), 'reacceleration on top', ['dcq4', 'e976'], adjusts={'figure': 'dcq4', 'type': 'uplift'}),\n   578\t        comp('dcfy', 'sum', ['dch1', 'dcq3', 'dcq4b'], 415.0, 'USD bn', W('NVIDIA', 'revenue', DC, 'FY2027'), relation='time_aggregation')]\n   579\t    ramb['answers'][1]['rung'] = 2\n   580\t    item('R1amb', R1_FAMILY, R1_PASSAGES, ramb, lambda r: (any(c == 'C3' and 'FY2027 Q4' in d for c, d in r['errors']), 'C3: refused, deterministically'), '')\n   581\t    f4b, c4b = g4()                                   # [46y.1] q01's published forecast rests on its subtotal; q22 uses the published one\n   582\t    sub = next(f for f in c4b['figures'] if f['id'] == 'gfy')\n   583\t    sub['id'] = 'gfysub'\n   584\t    c4b['figures'].append(est('gfy', (400.0, 435.0), 'USD bn', W('NVIDIA', 'revenue', CO, 'FY2027'), 'the subtotal, held', ['gfysub']))\n   585\t    item('G4b', f4b, G_PASSAGES, c4b, lambda r: (not any(c == 'C9' for c, _ in r['errors']), 'no C9: q22 on the published forecast'), '')\n   586\t    rz = r2()                                         # [46y.2] x - x declared slightly off zero\n   587\t    rz['figures'] = [f for f in rz['figures'] if f['id'] not in ('talks', 'end')] + [\n   588\t        est('cm', 6.5, 'USD bn', W('NVIDIA', 'equity investment commitments', CO, 'rest of FY2027'), 'a commitment later reversed', bound='>'),\n   589\t        comp('rev', 'difference', ['cm', 'cm'], -0.09, 'USD bn', W('NVIDIA', 'equity investment commitments', CO, 'rest of FY2027')),\n   590\t        est('t35', 3.5, 'USD bn', W('NVIDIA', 'equity investment commitments', CO, 'rest of FY2027'), 'talks, risk-adjusted'),\n   591\t        comp('end', 'roll_forward', ['bal', 'add18', 'mtk', 't35', 'rev'], 49.91, 'USD bn', W('NVIDIA', 'equity investment commitments', CO, 'end of FY2027'),\n   592\t             relation='overlap_unknown', disputed='add18')]\n   593\t    rz['answers'][0]['rung'] = 2\n   594\t    item('R2z', R2_FAMILY, R2_PASSAGES, rz, lambda r: (any(c == 'C2' and 'rev' in d and 'exactly' in d for c, d in r['errors']), 'C2: zero is exact'), '')\n   595\t    rz2 = copy.deepcopy(rz)\n   596\t    next(f for f in rz2['figures'] if f['id'] == 'rev')['value'] = 0.0\n   597\t    item('R2z2', R2_FAMILY, R2_PASSAGES, rz2, lambda r: (any(c == 'C6' for c, _ in r['errors']), 'C6: placed by the recomputed $50B, not the declared $49.91B'), '')\n   598\t    f4b2, c4b2 = g4()                                 # [46z.1] q01 publishes an adjusted forecast; q22 still uses the old subtotal\n   599\t    sub2 = next(f for f in c4b2['figures'] if f['id'] == 'gfy')\n   600\t    sub2['id'] = 'gfysub'\n   601\t    c4b2['figures'].append(est('gfy', (430.0, 460.0), 'USD bn', W('NVIDIA', 'revenue', CO, 'FY2027'), 'the subtotal, adjusted up', ['gfysub'],\n   602\t                               adjusts={'figure': 'gfysub', 'type': 'uplift'}))\n   603\t    next(f for f in c4b2['figures'] if f['id'] == 'gfy28c')['inputs'] = ['gfysub', 'g41']\n   604\t    c4b2['answers'][0]['rung'] = 2\n   605\t    item('G4b2', f4b2, G_PASSAGES, c4b2, lambda r: (any(c == 'C9' for c, _ in r['errors']), \"C9: q22 on q01's superseded subtotal\"), '')\n   606\t    rz3 = copy.deepcopy(rz2)                          # [46z.2] the declared $49.91B on the $50–75B rung: published at the recomputed $50B\n   607\t    rz3['answers'][0]['rung'] = 3\n   608\t    MANIFEST['R2z3'] = {'family': R2_FAMILY, 'calc': rz3}\n   609\t    res3 = cc.check(R2_FAMILY, R2_PASSAGES, rz3)\n   610\t    rows.append(('R2z3', not res3['errors'] and res3['published']['v29'][:2] == [50.0, 50.0], f'published {res3[\"published\"][\"v29\"]}', res3))\n   611\t    rc = r1('c')                                      # [46z.2] both quarters declared 127.1; recomputed Data Center 127.25 above company 127.12\n   612\t    rc['figures'] = [f for f in rc['figures'] if f['id'] not in ('dcq4', 'dcfy')] + [\n   613\t        est('g21', 21.2, '%', W('NVIDIA', 'Data Center sequential growth', DC, 'FY2027 Q4'), 'reacceleration'),\n   614\t        est('dcbr', 1.0, 'x', W('NVIDIA', 'assumption', DC, 'FY2027 Q4'), 'Q3 carried into Q4 at the stated growth', converts=['dcq3']),\n   615\t        comp('dcq4', 'apply_growth', ['dcq3', 'g21'], 127.1, 'USD bn', W('NVIDIA', 'revenue', DC, 'FY2027 Q4'), bridge='dcbr'),\n   616\t        comp('dcfy', 'sum', ['dch1', 'dcq3', 'dcq4'], 396.1, 'USD bn', W('NVIDIA', 'revenue', DC, 'FY2027'), relation='time_aggregation')]\n   617\t    item('R1canon', R1_FAMILY, R1_PASSAGES, rc, lambda r: (any(c == 'C3' and 'FY2027 Q4' in d for c, d in r['errors']), 'C3 on the recomputed values'), '')\n   618\t    f4c, c4c = g4()                                   # [46m.2] the single-scenario calculation removed, q01 only cited\n   619\t    c4c['figures'] = [f for f in c4c['figures'] if f['id'] != 'gfy28c']\n   620\t    next(f for f in c4c['figures'] if f['id'] == 'gfy28')['rests_on'] = ['gfy', 'i256', 'i173']\n   621\t    item('G4c', f4c, G_PASSAGES, c4c, lambda r: (any(c == 'C9' and 'no calculation' in d for c, d in r['errors']), 'C9: a citation for a calculation'), '')\n   622\t    p3e = copy.deepcopy(p3a)\n   623\t    p3e['answers'][0]['outcome'] = 'pri'\n   624\t    p3e['answers'][0]['reference'] = {'figure': 'gc392'}\n   625\t    item('P3e', f1p, G_PASSAGES, p3e, lambda r: (any(c == 'C10' and 'current outcome' in d for c, d in r['errors']), 'C10: a prior as the outcome'), '')\n   626\t    p3d = copy.deepcopy(p3a)\n   627\t    p3d['answers'][0]['reference'] = {'figure': 'pri', 'unavailable': 'no consensus supplied'}\n   628\t    item('P3d', f1p, G_PASSAGES, p3d, lambda r: (any(c == 'C5' and 'exactly one' in d for c, d in r['errors']), 'C5: both a figure and unavailable'), '')\n   629\t    p3c = copy.deepcopy(p3a)\n   630\t    next(f for f in p3c['figures'] if f['id'] == 'pri')['value'] = 431.0\n   631\t    item('P3c', f1p, G_PASSAGES, p3c, lambda r: ('C10' in codes(r), 'C10: a prior figure the earlier answer does not state'), '')\n   632\t    p3b = copy.deepcopy(c1)\n   633\t    p3b['figures'].append(est('wrap', 425.0, 'USD bn', W('NVIDIA', 'revenue', CO, 'FY2027'), 'our earlier forecast, close to the Street', ['gc392']))\n   634\t    p3b['answers'][0]['reference'] = {'figure': 'wrap'}\n   635\t    item('P3b', f1, G_PASSAGES, p3b, lambda r: (codes(r) == {'C5'}, 'C5 only'), '')\n   636\t\n   637\t    f3, c3 = g3()\n   638\t    p4 = copy.deepcopy(c3)\n   639\t    next(f for f in p4['figures'] if f['id'] == 'gasp')['what']['scope'] = 'Rubin GPU'      # a price of another product\n   640\t    item('P4', f3, G_PASSAGES, p4, lambda r: (codes(r) == {'C8'} and any('gunits' in d for _, d in r['errors']),\n   641\t                                               'C8 only, on gunits: the per-unit identity needs one scope'), '')\n   642\t\n   643\t    g3inv = copy.deepcopy(c3)\n   644\t    g3inv['figures'].append(comp('gback', 'product', ['gunits', 'gasp'], 20.0, 'USD bn', W('NVIDIA', 'revenue', 'Vera CPU', 'FY2027')))\n   645\t    item('G3inv', f3, G_PASSAGES, g3inv, lambda r: (not r['errors'], 'the per-unit inverse gives $20B'), '')\n   646\t    f4, c4 = g4()\n   647\t    g4m = copy.deepcopy(c4)\n   648\t    next(f for f in g4m['figures'] if f['id'] == 'gfy28c')['inputs'] = ['gc392', 'g41']\n   649\t    next(f for f in g4m['figures'] if f['id'] == 'gfy28c').update(low=552.72, high=552.72)\n   650\t    item('G4m', f4, G_PASSAGES, g4m, lambda r: ('C9' in codes(r), \"C9: FY2028 rests on consensus, not q01's forecast\"), '')\n   651\t    r4m = r4()\n   652\t    next(f for f in r4m['figures'] if f['id'] == 'cpu28')['bound'] = '<'\n   653\t    item('R4m', R4_FAMILY, R4_PASSAGES, r4m, lambda r: (any(c == 'C2' and 'cpu28' in d for c, d in r['errors']), 'C2: the bound direction reversed'), '')\n   654\t\n   655\t    # T1–T9: the C1 forms on real passages\n   656\t    t_pass = {**R1_PASSAGES, **R3_PASSAGES, **R4_PASSAGES}\n   657\t    tests = [\n   658\t        ('T1', src('t', 'e2499', '$108.0 billion, plus or minus 2%', 108.0, 'USD bn', 'guidance', W('x', 'x', 'x', 'x'), 'midpoint'), True),\n   659\t        ('T2', src('t', 'e1786', 'more than $730 billion', 730.0, 'USD bn', 'reported', W('x', 'x', 'x', 'x'), 'bound', '>'), True),\n   660\t        ('T3a', src('t', 'e2535', 'nearly $800 billion', 800.0, 'USD bn', 'guidance', W('x', 'x', 'x', 'x'), 'bound', 'approx_below'), True),\n   661\t        ('T3b', src('t', 'e2535', '$1.3 trillion', 1300.0, 'USD bn', 'guidance', W('x', 'x', 'x', 'x')), True),\n   662\t        ('T4', src('t', 'e3660', 'more than double', 2.0, 'x', 'guidance', W('x', 'x', 'x', 'x'), 'multiplier', '>'), True),\n   663\t        ('T5a', src('t', 'e1786', '$730 billion', 730.0, 'USD bn', 'reported', W('x', 'x', 'x', 'x')), False),\n   664\t        ('T5b', src('t', 'e2535', '$800 billion', 800.0, 'USD bn', 'guidance', W('x', 'x', 'x', 'x')), False),\n   665\t        ('T6', src('t', 'e3660', 'double', 2.0, 'x', 'guidance', W('x', 'x', 'x', 'x'), 'multiplier'), False),\n   666\t        ('T7', src('t', 'e2499', '$108.0 billion, plus or minus 2%', 108.5, 'USD bn', 'guidance', W('x', 'x', 'x', 'x'), 'midpoint'), False),\n   667\t        ('T8', src('t', 'e1786', 'more than $730 billion', 730.0, 'USD bn', 'reported', W('x', 'x', 'x', 'x'), 'value'), False),\n   668\t        ('T9', src('t', 'e2535', '$800 billion', 800.0, 'USD bn', 'guidance', W('x', 'x', 'x', 'x'), 'bound', 'approx_below'), False),\n   669\t    ]\n   670\t    for name, fig, accept in tests:\n   671\t        errs = cc._source_errors(fig, t_pass)\n   672\t        ok = (not errs) == accept and (name != 'T9' or any('not a complete numeric expression' in d for _, d in errs))\n   673\t        rows.append((name, ok, 'accepted' if accept else 'refused', {'errors': errs, 'recorded': []}))\n   674\t\n   675\t    # U1–U2: the paths\n   676\t    u1 = r1('c')\n   677\t    u1['answers'][1] = {'view_id': 'v9', 'shape': 'unresolved', 'why': 'the segment mix after Q2 is not stated', 'cites': [], 'changed': True,\n   678\t                        'why_changed': 'w'}\n   679\t    res = cc.check(R1_FAMILY, R1_PASSAGES, u1)\n   680\t    decision = cc.publish_decision(R1_FAMILY, u1, res)\n   681\t    rows.append(('U1', decision == 'held' and not res['errors'], f'decision {decision}', res))\n   682\t    res_bad = cc.check(f1, G_PASSAGES, p2)\n   683\t    outcome = cc.family_outcome([cc.publish_decision(f1, p2, res_bad), cc.publish_decision(f1, p2, res_bad)])\n   684\t    rows.append(('U2', outcome == 'unresolved', f'two refusals give {outcome}', res_bad))\n   685\t    return rows\n   686\t\n   687\t\n   688\tdef main():\n   689\t    rows = run()\n   690\t    lines = ['judging-v13 $0 gate (DESIGN.md v5 §6)', '']\n   691\t    for name, ok, note, result in rows:\n   692\t        lines.append(f'{\"PASS\" if ok else \"MISS\"}  {name:5}  {note}')\n   693\t        for code, detail in result['errors']:\n   694\t            lines.append(f'        {code}: {detail}')\n   695\t        for rec in result['recorded']:\n   696\t            lines.append(f'        recorded: {json.dumps(rec)}')\n   697\t    misses = [r[0] for r in rows if not r[1]]\n   698\t    lines += ['', f'{len(rows)} items, {len(rows) - len(misses)} pass, misses: {misses or \"none\"}',\n   699\t              'GATE PASS' if not misses else 'GATE FAIL']\n   700\t    text = '\\n'.join(lines)\n   701\t    print(text)\n   702\t    if len(sys.argv) > 1:\n   703\t        Path(sys.argv[1]).write_text(text + '\\n')\n   704\t        Path(sys.argv[1]).with_suffix('.fixtures.json').write_text(json.dumps(MANIFEST, indent=1, sort_keys=True))\n   705\t    return 0 if not misses else 1\n   706\t\n   707\t\n   708\tif __name__ == '__main__':\n   709\t    raise SystemExit(main())\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc 'nl -ba docs/research/2026-11-22-number-answers/PAID-GATE-RESULT.md'","aggregated_output":"     1\t# judging-v13 paid gate: result (D733)\n     2\t\n     3\t**STOP.** Every one of the 72 answers was refused by the code checks: 36 scored first attempts and 36 diagnostic retries. Nothing\n     4\twas published, and the joint arm is usable in 0 of 9 pairs against the registered 8 of 9.\n     5\t\n     6\tThe result does not answer the question the gate was built for: does judging related number questions in one call give better\n     7\tnumbers than judging each alone? It shows that the answer format, as the request stated it, could not be filled. Most refusals are\n     8\trules the request never stated, or checks that refuse right answers. A few are the model's own errors.\n     9\t\n    10\t- **Run:** `poc/data/judging-v13-paid-gate-2026-11-22/`, sent once (D732) with gpt-6-luna. The ledger records 72 attempts and\n    11\t  $0.3677 of the $0.50 ceiling: $0.1554 for the first attempts and $0.2124 for the retries. Every attempt finished with status\n    12\t  `answered`, so the result is complete, not INCOMPLETE.\n    13\t- **The blind reading** was not run. The registered brief says \"A card that has no answer cannot be usable\", and every card has\n    14\t  none, so the readers cannot change the verdict.\n    15\t- **Council round 48:**\n    16\t  - `round48-brief.md`;\n    17\t  - `claude-r48.md`, Claude's reflection, written first;\n    18\t  - `codex-r48.md`, an independent fresh read-only Codex session that reproduced every refusal from the journals and the requests.\n    19\t\n    20\t## 1. Census (first attempt → retry; Codex's count, which corrects Claude's)\n    21\t\n    22\t| Attempt | Arm | Answers | Structure (C7) messages / answers | Stopped at the structure check |\n    23\t|---|---|---:|---:|---:|\n    24\t| First | Joint | 9 | 39 / 9 | 9 |\n    25\t| First | Separate | 18 | 47 / 18 | 17 |\n    26\t| First | Single | 9 | 13 / 9 | 8 |\n    27\t| Retry | Joint | 9 | 40 / 9 | 9 |\n    28\t| Retry | Separate | 18 | 41 / 18 | 14 |\n    29\t| Retry | Single | 9 | 12 / 9 | 6 |\n    30\t\n    31\t`check()` returns early after any structure error, so most source, arithmetic and compatibility checks never ran on these answers.\n    32\t\n    33\t**Prose where the check expects an id**, counted by occurrence:\n    34\t\n    35\t| Field | First | Retry |\n    36\t|---|---:|---:|\n    37\t| `answers[].outcome` | 45 of 45 | 45 of 45 |\n    38\t| `answers[].reference.figure` | 39 | 32 |\n    39\t| `figures[].evidence` (139 of them on source figures, where C1 needs a passage id) | 175 | 133 (95) |\n    40\t| `figures[].bridge` | 49 | 44 |\n    41\t| `converts`, `disputed`, `inputs` | 3 | 3 |\n    42\t\n    43\t**Not one of the 90 member answers named a figure as its outcome**, in either journal. This failure alone refuses every answer.\n    44\tThe retries did not repair it. They carried the first attempt's reasons, and the early return had hidden this reason on most\n    45\tanswers.\n    46\t\n    47\t## 2. Mechanism\n    48\t\n    49\t1. **The format's rules live in `calc_check.py`, not in the request.**\n    50\t   - The sent schema carries 7 descriptions: `what`, `basis`, `kind`, `expression`, `relation`, `bridge` and `reference`.\n    51\t   - These fields have none: `value`, `low`, `high`, `bound`, `unit`, `evidence`, `component`, `inputs`, `operation`, `signs`,\n    52\t     `disputed`, `basis_text`, `rests_on`, `converts`, `scenario`, `outcome` and `rung`.\n    53\t   - The check enforces closed conventions on them:\n    54\t     - ids, not prose, in `evidence`, `outcome`, `reference.figure`, `bridge` and `disputed`;\n    55\t     - the unit spellings `USD bn`, `%` and `x`;\n    56\t     - a value or a range, never both (all 52 such refusals gave both);\n    57\t     - the period label `H1`;\n    58\t     - `share`, not `product`, for a percentage;\n    59\t     - each operation's operand count;\n    60\t     - `signs` only on `sum` and `roll_forward`.\n    61\t   - The descriptions of `bridge` (\"an estimate stating the conversion …\") and `reference` (\"An external figure, or a calculation …\")\n    62\t     read as asking for prose. The check reads both as ids.\n    63\t   - REQUEST-AUDIT.md says \"field definitions moved to the schema\". Most did not reach the sent bytes.\n    64\t2. **Some checks refuse right answers.** Each case was exposed by replaying a stored answer with the earlier refusal removed on a\n    65\t   copy:\n    66\t   - Q1 + Q2 Data Center revenue = \"FY2027 first half\" is refused, because the period parser reads only `H1`.\n    67\t   - FY2026 Q4 × (1 + the source's stated 65% year-over-year growth) is refused for want of a bridge. The check excuses\n    68\t     `apply_growth` only under a family `same_base` relation.\n    69\t   - $411 billion × 92.5% is computed by `product` as 38,017.5.\n    70\t   - \"well over $300 billion\" is refused because the parser starts one word later.\n    71\t   - $1.05 trillion is compared with bands in billions.\n    72\t3. **Model errors seen in the sample:**\n    73\t   - a 15% growth rate supported by forecasts computed from that same rate, a cycle;\n    74\t   - $25 billion and $18 billion of commitments added, although the source does not establish that the $18 billion comes on top of\n    75\t     the $25 billion;\n    76\t   - a full-year residual taken as a forecast. This is a judgement for a reader, not for code.\n    77\t4. **Diagnostic on copies (Claude's script, labelled a probe, not a count of right answers).**\n    78\t   - The script mechanically corrected the format classes.\n    79\t   - Result: 25 of 36 first attempts passed the early structure check, 9 had no structure error at all, and 0 would publish. The\n    80\t     retries gave the same counts.\n    81\t   - It guesses links from matching amounts, so it does not show how many answers a repaired request would get right.\n    82\t\n    83\t## 3. Process error\n    84\t\n    85\tAGENTS §6 says: \"Check before the send, at no cost. Write one answer that follows the prompt and run every code check on it.\"\n    86\t\n    87\t- **What the $0 gate proved.** Its passing answer, like the rehearsal's clean fixture, was written by someone who knew the check's\n    88\t  ids, units and period spellings. It proved that the harness accepts a conforming answer, not that the request teaches one.\n    89\t- **The missed step.** A writer who sees only the outgoing request writes the answer, and that first output goes through the real\n    90\t  checks. Each refusal must then point to the sentence of the request that states its rule.\n    91\t- **What the eight council rounds covered.** Rounds 47 to 47h reviewed the harness. None read the request as the model reads it\n    92\t  against the check.\n    93\t- **A wrong field in the mid-run diagnosis.** Claude told Alex the prose sat in `rests_on`. It sat in `evidence`, `bridge`, `outcome`\n    94\t  and `reference`.\n    95\t\n    96\t## 4. Council consensus: one recommendation, one test (for Alex's choice)\n    97\t\n    98\t**Recommendation.** Keep the STOP. Alex opens one bounded repair of judging-v13's request and checks:\n    99\t- each field's rule goes in the schema beside the field;\n   100\t- ids, units and choices become enums where the strict schema can hold them (the request already uses an id enum for `cites`);\n   101\t- the demonstrated period, arithmetic, parser and unit failures are fixed;\n   102\t- the checks for real scope changes, unstated assumptions and cycles are kept.\n   103\t\n   104\tClaude first leaned toward having code send the model a catalogue of the passages' numeric expressions. The council set that aside.\n   105\tThe parser's known omissions would become missing evidence, and the catalogue leaves the outcome-link failure untouched.\n   106\t\n   107\t**Test ($0, before any send).** One blind conformance test, registered before it runs:\n   108\t1. **Correct examples and broken counterparts are fixed first.** The examples cover a joint pair, its two separate answers, and the\n   109\t   three singleton shapes. The broken counterparts include a wrong number, a wrong period or scope, an unresolved overlap and a\n   110\t   circular calculation.\n   111\t2. **An independent writer sees only the new request** and writes the answers. The writer's first outputs go through the real\n   112\t   harness without hand edits.\n   113\t3. **Stop conditions.** The test stops if any correct form is refused, if any planted defect gets through its check, or if the\n   114\t   writer needs a rule the request does not state.\n   115\t4. **The 72 stored answers check individual fixes** where the intended figure and source can be identified. A guessed link earns no\n   116\t   credit.\n   117\t\n   118\tA clean result earns a request to Alex to send the same 36-request comparison again under a new decision, with D725's lines\n   119\tunchanged. The alternative is to close judging-v13. poc-v118 is already the product (D690), and the number answers stay a known\n   120\tdefect.\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc 'nl -ba docs/research/2026-11-22-number-answers/calc_check.py'","aggregated_output":"     1\t\"\"\"judging-v13's calculation checks (DESIGN.md v5, harness-only). Code owns identity and arithmetic, never importance.\n     2\t\n     3\tcheck(family, passages, calc) -> {'errors': [(code, detail)], 'recorded': [...]}\n     4\t- family: {'members': {view_id: {'what': {...}, 'bands': [[lo, hi], ...]}}, 'relations': [{'type': 'part_of'|'same_base', ...}],\n     5\t           'shared': [what, ...], 'compare_periods': [period, ...]}\n     6\t- passages: {evidence_id: {'text': str, 'speaker': str}}\n     7\t- calc: {'figures': [...], 'answers': [...]}, the format of DESIGN.md §2.\n     8\tValues are in the figure's unit; money is normalised to 'USD bn'.\n     9\t\"\"\"\n    10\timport re\n    11\t\n    12\tQUAL = {'more than': '>', 'over': '>', 'at least': '>=', 'nearly': 'approx_below', 'almost': 'approx_below',\n    13\t        'approximately': 'approx', 'about': 'approx', 'around': 'approx', 'roughly': 'approx',\n    14\t        'up to': '<=', 'less than': '<', 'below': '<', 'under': '<'}\n    15\tSCALE = {'trillion': 1000.0, 'tn': 1000.0, 't': 1000.0, 'billion': 1.0, 'bn': 1.0, 'b': 1.0, 'million': 0.001, 'm': 0.001}\n    16\tNUM = r'(\\d[\\d,]*(?:\\.\\d+)?)'\n    17\tUNIT = r'(trillion|billion|million|bn|tn|T|B|M)\\b'\n    18\tQWORDS = '|'.join(sorted(QUAL, key=len, reverse=True))\n    19\tPATTERNS = [\n    20\t    ('relative', re.compile(r'\\$\\s?' + NUM + r'\\s*' + UNIT + r',?\\s*(?:plus or minus|±)\\s*' + NUM + r'%')),\n    21\t    ('range', re.compile(r'\\$\\s?' + NUM + r'\\s*(?:' + UNIT + r')?\\s*(?:–|-)\\s*\\$?\\s?' + NUM + r'\\s*' + UNIT)),   # \"to\" is ambiguous (\"from $253 billion to $392 billion\")\n    22\t    ('range', re.compile(r'\\bbetween\\s+\\$\\s?' + NUM + r'\\s*(?:' + UNIT + r')?\\s+and\\s+\\$?\\s?' + NUM + r'\\s*' + UNIT, re.I)),\n    23\t    ('qualified', re.compile(r'\\b(' + QWORDS + r')\\s+\\$\\s?' + NUM + r'\\s*' + UNIT, re.I)),\n    24\t    ('money', re.compile(r'\\$\\s?' + NUM + r'\\s*' + UNIT)),\n    25\t    ('money_plain', re.compile(r'\\$\\s?' + NUM + r'(?![\\d,.]*\\s*(?:trillion|billion|million|bn|tn|T|B|M)\\b)')),\n    26\t    ('multiplier', re.compile(r'\\b(more than\\s+)?(double|triple)\\b', re.I)),\n    27\t    ('percent', re.compile(r'\\b(?:(' + QWORDS + r')\\s+)?' + NUM + r'%', re.I)),\n    28\t]\n    29\tOPERATIONS = {'sum', 'difference', 'product', 'ratio', 'growth', 'apply_growth', 'share', 'range_from_relative', 'roll_forward'}\n    30\tARITY = {'difference': (2, 2), 'ratio': (2, 2), 'growth': (2, 2), 'apply_growth': (2, 2), 'share': (2, 2), 'range_from_relative': (2, 2),\n    31\t         'product': (2, 99), 'sum': (1, 99), 'roll_forward': (2, 99)}          # [46m.1] every operand an operation lists is one it uses\n    32\tKINDS = {'source', 'computed', 'estimate', 'prior'}\n    33\tBASES = {'reported', 'guidance', 'consensus', 'third_party', 'forecast', 'prior_forecast'}\n    34\tEXTERNAL = {'consensus', 'guidance', 'third_party'}\n    35\t\n    36\t\n    37\tdef _num(text):\n    38\t    return float(text.replace(',', ''))\n    39\t\n    40\t\n    41\tdef _scale(unit):\n    42\t    return SCALE[unit.lower()] if unit else 1.0\n    43\t\n    44\t\n    45\tdef extract(text):\n    46\t    \"\"\"Every complete numeric expression in a passage, longest forms first, never overlapping: [{'text', 'form', ...}].\"\"\"\n    47\t    taken, found = [], []\n    48\t    for form, pattern in PATTERNS:\n    49\t        for m in pattern.finditer(text):\n    50\t            if any(m.start() < end and start < m.end() for start, end in taken):\n    51\t                continue\n    52\t            taken.append((m.start(), m.end()))\n    53\t            g = m.groups()\n    54\t            item = {'text': m.group(0), 'form': form, 'start': m.start()}\n    55\t            if form == 'relative':\n    56\t                item.update(midpoint=_num(g[0]) * _scale(g[1]), relative=_num(g[2]), unit='USD bn')\n    57\t            elif form == 'range':\n    58\t                unit = g[3]\n    59\t                item.update(low=_num(g[0]) * _scale(g[1] or unit), high=_num(g[2]) * _scale(unit), unit='USD bn')\n    60\t            elif form == 'qualified':\n    61\t                item.update(bound=QUAL[g[0].lower()], value=_num(g[1]) * _scale(g[2]), unit='USD bn')\n    62\t            elif form == 'money':\n    63\t                item.update(value=_num(g[0]) * _scale(g[1]), unit='USD bn')\n    64\t            elif form == 'money_plain':\n    65\t                item.update(value=_num(g[0]), unit='USD')\n    66\t            elif form == 'multiplier':\n    67\t                item.update(multiplier=2.0 if g[1].lower() == 'double' else 3.0, bound='>' if g[0] else None, unit='x')\n    68\t            elif form == 'percent':\n    69\t                item.update(value=_num(g[1]), bound=QUAL[g[0].lower()] if g[0] else None, unit='%')\n    70\t            found.append(item)\n    71\t    return sorted(found, key=lambda item: item['start'])\n    72\t\n    73\t\n    74\tdef _same(a, b):\n    75\t    return a is not None and b is not None and abs(a - b) <= 1e-9 * max(1.0, abs(b))\n    76\t\n    77\t\n    78\tdef _source_errors(fig, passages):\n    79\t    passage = passages.get(fig.get('evidence'))\n    80\t    if passage is None:\n    81\t        return [('C1', f'{fig[\"id\"]}: evidence {fig.get(\"evidence\")} was not shown')]\n    82\t    matches = [e for e in extract(passage['text']) if e['text'] == fig.get('expression')]\n    83\t    if not matches:\n    84\t        return [('C1', f'{fig[\"id\"]}: \"{fig.get(\"expression\")}\" is not a complete numeric expression of {fig[\"evidence\"]}')]\n    85\t    expr, comp = matches[0], fig.get('component', 'value')\n    86\t    bound, unit = fig.get('bound'), fig.get('unit')\n    87\t    ok = False\n    88\t    if comp == 'value' and expr['form'] in ('money', 'money_plain', 'percent'):\n    89\t        ok = _same(fig.get('value'), expr['value']) and unit == expr['unit'] and bound == expr.get('bound')\n    90\t    elif comp == 'bound' and expr['form'] in ('qualified', 'percent'):\n    91\t        ok = _same(fig.get('value'), expr['value']) and unit == expr['unit'] and bound == expr['bound'] and bound is not None\n    92\t    elif comp == 'midpoint' and expr['form'] == 'relative':\n    93\t        ok = _same(fig.get('value'), expr['midpoint']) and unit == 'USD bn' and bound is None\n    94\t    elif comp == 'relative' and expr['form'] == 'relative':\n    95\t        ok = _same(fig.get('value'), expr['relative']) and unit == '%' and bound is None\n    96\t    elif comp in ('low', 'high') and expr['form'] == 'range':\n    97\t        ok = _same(fig.get('value'), expr[comp]) and unit == 'USD bn' and bound is None\n    98\t    elif comp == 'multiplier' and expr['form'] == 'multiplier':\n    99\t        ok = _same(fig.get('value'), expr['multiplier']) and unit == 'x' and bound == expr['bound']\n   100\t    if not ok:\n   101\t        return [('C1', f'{fig[\"id\"]}: value {fig.get(\"value\")} {unit} bound {bound} does not equal \"{expr[\"text\"]}\" as component {comp}')]\n   102\t    return []\n   103\t\n   104\t\n   105\tdef _interval(fig):\n   106\t    if 'low' in fig and 'high' in fig:\n   107\t        return fig['low'], fig['high']\n   108\t    return fig['value'], fig['value']\n   109\t\n   110\t\n   111\tdef _terms(fig):\n   112\t    \"\"\"[46w] The operands a calculation uses, with a sum's or roll_forward's repeated operands netted (x - x cancels exactly).\"\"\"\n   113\t    ids = list(fig.get('inputs', []))\n   114\t    if fig.get('operation') == 'difference' and len(ids) == 2 and ids[0] == ids[1]:\n   115\t        return [], []                                 # [46x.2] x - x is exactly zero\n   116\t    if fig.get('operation') not in ('sum', 'roll_forward'):\n   117\t        return ids, fig.get('signs')\n   118\t    net = {}\n   119\t    for i, k in zip(ids, fig.get('signs') or [1] * len(ids)):\n   120\t        net[i] = net.get(i, 0) + k\n   121\t    kept = [i for i in dict.fromkeys(ids) if net[i] != 0]\n   122\t    return kept, [net[i] for i in kept]\n   123\t\n   124\t\n   125\tdef _compute(op, inputs, signs, out_unit=None):\n   126\t    \"\"\"inputs: [(lo, hi, unit)]; returns (lo, hi) in out_unit.\"\"\"\n   127\t    los = [i[0] for i in inputs]\n   128\t    his = [i[1] for i in inputs]\n   129\t    if op in ('sum', 'roll_forward'):\n   130\t        s = signs or [1] * len(inputs)\n   131\t        return (sum((a if k > 0 else b) * k for a, b, k in zip(los, his, s)), sum((b if k > 0 else a) * k for a, b, k in zip(los, his, s)))\n   132\t    if op == 'difference':\n   133\t        return los[0] - his[1], his[0] - los[1]\n   134\t    if op == 'product':\n   135\t        lo = hi = 1.0\n   136\t        for a, b in zip(los, his):\n   137\t            lo, hi = lo * a, hi * b\n   138\t        units = [i[2] for i in inputs]\n   139\t        if 'units' in units and 'USD' in units and out_unit == 'USD bn':     # units times a dollar price, in billions\n   140\t            lo, hi = lo / 1e9, hi / 1e9\n   141\t        return lo, hi\n   142\t    if op == 'ratio':\n   143\t        units = [i[2] for i in inputs]\n   144\t        if 'USD' in units and 'USD bn' in units:                # a dollar total over a per-unit price\n   145\t            los = [x * 1e9 if u == 'USD bn' else x for x, u in zip(los, units)]\n   146\t            his = [x * 1e9 if u == 'USD bn' else x for x, u in zip(his, units)]\n   147\t        return los[0] / his[1], his[0] / los[1]\n   148\t    if op == 'share':\n   149\t        return los[0] * los[1] / 100.0, his[0] * his[1] / 100.0\n   150\t    if op == 'growth':\n   151\t        return (los[1] / his[0] - 1) * 100.0, (his[1] / los[0] - 1) * 100.0\n   152\t    if op == 'apply_growth':\n   153\t        return los[0] * (1 + los[1] / 100.0), his[0] * (1 + his[1] / 100.0)\n   154\t    if op == 'range_from_relative':\n   155\t        return los[0] * (1 - los[1] / 100.0), his[0] * (1 + his[1] / 100.0)\n   156\t    raise ValueError(op)\n   157\t\n   158\t\n   159\tDIRECTION = {'>': 'lower', '>=': 'lower', 'approx_above': 'lower', '<': 'upper', '<=': 'upper', 'approx_below': 'upper',\n   160\t             'approx': 'two-sided', 'mixed': 'mixed', None: None}\n   161\tFLIP = {'lower': 'upper', 'upper': 'lower', 'two-sided': 'two-sided', 'mixed': 'mixed', None: None}\n   162\t\n   163\t\n   164\tdef _bound_direction(op, ins, signs=None):\n   165\t    \"\"\"For positive operands: which side the result is bounded on, from its inputs' bounds (None: a point). [46u.2] A term a sum or\n   166\t    roll_forward subtracts flips its side.\"\"\"\n   167\t    dirs = [DIRECTION.get(i.get('bound')) for i in ins]\n   168\t    if op in ('sum', 'roll_forward') and signs:\n   169\t        dirs = [FLIP[d] if k < 0 else d for d, k in zip(dirs, signs)]\n   170\t    if op == 'ratio' and len(dirs) == 2:\n   171\t        dirs = [dirs[0], FLIP[dirs[1]]]\n   172\t    if op == 'difference' and len(dirs) == 2:\n   173\t        dirs = [dirs[0], FLIP[dirs[1]]]\n   174\t    found = {d for d in dirs if d}\n   175\t    if not found:\n   176\t        return None\n   177\t    if 'mixed' in found or {'lower', 'upper'} <= found:     # [46v] opposing bounds leave the result unbounded\n   178\t        return 'mixed'\n   179\t    return found.pop() if len(found) == 1 and 'two-sided' not in found else 'two-sided'\n   180\t\n   181\t\n   182\tdef _outcome_set(fig):\n   183\t    \"\"\"The values an outcome allows: (low, low_closed, high, high_closed); a bound keeps its side open or closed.\"\"\"\n   184\t    lo, hi = _interval(fig)\n   185\t    b = fig.get('bound')\n   186\t    inf = float('inf')\n   187\t    if b == '>':\n   188\t        return (lo, False, inf, False)\n   189\t    if b in ('>=', 'approx_above'):\n   190\t        return (lo, True, inf, False)\n   191\t    if b == '<':\n   192\t        return (-inf, False, hi, False)\n   193\t    if b in ('<=', 'approx_below'):\n   194\t        return (-inf, False, hi, True)\n   195\t    if b == 'mixed':                                    # [46v] any value: only possible crossings\n   196\t        return (-inf, False, inf, False)\n   197\t    return (lo, True, hi, True)\n   198\t\n   199\t\n   200\tdef _overlaps(values, band):\n   201\t    \"\"\"A band [low, high) (None: open-ended) shares at least one value with the outcome's set.\"\"\"\n   202\t    lo, lo_c, hi, hi_c = values\n   203\t    b_lo = band[0] if band[0] is not None else float('-inf')\n   204\t    b_hi = band[1] if band[1] is not None else float('inf')\n   205\t    low, low_closed = (lo, lo_c) if lo > b_lo else ((b_lo, True) if b_lo > lo else (lo, lo_c))\n   206\t    high, high_closed = (hi, hi_c) if hi < b_hi else ((b_hi, False) if b_hi < hi else (hi, False))\n   207\t    return low < high or (low == high and low_closed and high_closed)\n   208\t\n   209\t\n   210\tdef _exceeds(part, whole):\n   211\t    \"\"\"[46t.2] With a bound on either side, the part exceeds its whole only when no pair of allowed values fits (part min above whole\n   212\t    max). Closed ranges and points keep the paired-end rule (each end of the part at most the same end of the whole).\"\"\"\n   213\t    (plo, plc, phi, phc), (wlo, wlc, whi, whc) = part, whole\n   214\t    inf = float('inf')\n   215\t    if inf in (abs(plo), abs(phi), abs(wlo), abs(whi)):\n   216\t        return plo > whi + 1e-9 or (abs(plo - whi) <= 1e-9 and not (plc and whc))\n   217\t    return plo > wlo + 1e-9 or phi > whi + 1e-9\n   218\t\n   219\t\n   220\tdef _below(values, edge):\n   221\t    lo, lo_c, hi, hi_c = values\n   222\t    return hi < edge or (hi == edge and not hi_c)\n   223\t\n   224\t\n   225\tdef _at_or_above(values, edge):\n   226\t    lo, lo_c, hi, hi_c = values\n   227\t    return lo >= edge\n   228\t\n   229\t\n   230\tdef _crossings(base, alt, bands):\n   231\t    \"\"\"Band edges between two value sets, each with its own certainty: definite when one set lies wholly below the edge and the other\n   232\t    wholly at or above it; possible when the sets differ and the edge lies within their span.\"\"\"\n   233\t    edges = sorted({e for band in bands for e in band if e is not None})\n   234\t    definite = [e for e in edges if (_below(base, e) and _at_or_above(alt, e)) or (_below(alt, e) and _at_or_above(base, e))]\n   235\t    span_lo, span_hi = min(base[0], alt[0]), max(base[2], alt[2])\n   236\t    possible = [e for e in edges if e not in definite and span_lo < e <= span_hi and base != alt]\n   237\t    return definite, possible\n   238\t\n   239\t\n   240\tSTRICT = {'>', '<'}\n   241\t\n   242\t\n   243\tdef _evaluate_bounded(figs, refs, overrides):\n   244\t    \"\"\"[46t.1] Recompute (interval, bound) for every figure, carrying open and closed bounds through the arithmetic.\"\"\"\n   245\t    values, order, done = {}, [], set()\n   246\t\n   247\t    def visit(fid):\n   248\t        if fid in done:\n   249\t            return\n   250\t        done.add(fid)\n   251\t        for r in refs(figs[fid]):\n   252\t            if r in figs:\n   253\t                visit(r)\n   254\t        order.append(fid)\n   255\t    for fid in figs:\n   256\t        visit(fid)\n   257\t    for fid in order:\n   258\t        fig = figs[fid]\n   259\t        if fid in overrides:\n   260\t            values[fid] = overrides[fid]\n   261\t        elif fig['kind'] == 'computed' and fig.get('operation') in OPERATIONS:\n   262\t            t_ids, t_signs = _terms(fig)\n   263\t            ins = [values[i] for i in t_ids]\n   264\t            interval = _compute(fig['operation'], [iv + (figs[i]['unit'],) for (iv, _), i in zip(ins, t_ids)], t_signs, fig['unit']) if ins else (0.0, 0.0)\n   265\t            pseudo = [{'bound': b} for _, b in ins]\n   266\t            side = _bound_direction(fig['operation'], pseudo, t_signs)\n   267\t            strict = any(b in STRICT for _, b in ins)\n   268\t            bound = {'lower': '>' if strict else '>=', 'upper': '<' if strict else '<=', 'two-sided': 'approx', 'mixed': 'mixed', None: None}[side]\n   269\t            values[fid] = (interval, bound)\n   270\t        else:\n   271\t            values[fid] = (_interval(fig), fig.get('bound'))\n   272\t    return values\n   273\t\n   274\t\n   275\tdef _set_from(interval, bound):\n   276\t    fig = {'low': interval[0], 'high': interval[1], 'bound': bound} if interval[0] != interval[1] else {'value': interval[0], 'bound': bound}\n   277\t    return _outcome_set(fig)\n   278\t\n   279\t\n   280\tdef _close(declared, expected, unit):\n   281\t    floor = 0.05 if unit == '%' else 0.1\n   282\t    return abs(declared - expected) <= max(0.005 * abs(expected), floor)\n   283\t\n   284\t\n   285\tQUARTERS = {'Q1': {1}, 'Q2': {2}, 'Q3': {3}, 'Q4': {4}, 'H1': {1, 2}, 'H2': {3, 4}}\n   286\t\n   287\t\n   288\tdef _quarters(period):\n   289\t    \"\"\"'FY2027' -> (FY2027, {1..4}); 'FY2027 Q3' -> (FY2027, {3}); 'FY2027 H1' -> {1, 2}; else None.\"\"\"\n   290\t    parts = period.split()\n   291\t    if len(parts) == 1 and parts[0].startswith('FY'):\n   292\t        return parts[0], {1, 2, 3, 4}\n   293\t    if len(parts) == 2 and parts[0].startswith('FY') and parts[1] in QUARTERS:\n   294\t        return parts[0], QUARTERS[parts[1]]\n   295\t    return None\n   296\t\n   297\t\n   298\tdef _key(what):\n   299\t    return (what['population'], what['measure'], what['scope'], what['period'])\n   300\t\n   301\t\n   302\tdef check(family, passages, calc):\n   303\t    errors, recorded = [], []\n   304\t    figs = {}\n   305\t    for fig in calc['figures']:\n   306\t        if fig['id'] in figs:\n   307\t            errors.append(('C7', f'{fig[\"id\"]} is defined twice'))\n   308\t        figs[fig['id']] = fig\n   309\t\n   310\t    def refs(fig):\n   311\t        out = list(fig.get('inputs', []))\n   312\t        out += [r for r in fig.get('rests_on', []) if r in figs or r not in passages]\n   313\t        if fig.get('adjusts'):\n   314\t            out.append(fig['adjusts']['figure'])\n   315\t        if fig.get('bridge'):\n   316\t            out.append(fig['bridge'])\n   317\t        return out\n   318\t\n   319\t    # C7 structure: kinds, operations, dangling, cycles, numbers\n   320\t    for fig in figs.values():\n   321\t        has_value = isinstance(fig.get('value'), (int, float))\n   322\t        has_range = isinstance(fig.get('low'), (int, float)) and isinstance(fig.get('high'), (int, float))\n   323\t        if has_value == has_range or (has_range and fig['low'] > fig['high']):          # [46o.2] exactly one: a value or an ordered range\n   324\t            errors.append(('C7', f'{fig[\"id\"]}: a figure needs either a value or a complete range with low at most high'))\n   325\t        if fig.get('kind') not in KINDS or fig.get('basis') not in BASES:\n   326\t            errors.append(('C7', f'{fig[\"id\"]}: kind {fig.get(\"kind\")} or basis {fig.get(\"basis\")} outside the closed set'))\n   327\t        if fig.get('kind') == 'computed' and fig.get('operation') not in OPERATIONS:\n   328\t            errors.append(('C7', f'{fig[\"id\"]}: operation {fig.get(\"operation\")} outside the closed set'))\n   329\t        elif fig.get('kind') == 'computed':\n   330\t            lo_n, hi_n = ARITY[fig['operation']]\n   331\t            if not lo_n <= len(fig.get('inputs', [])) <= hi_n:\n   332\t                errors.append(('C7', f'{fig[\"id\"]}: {fig[\"operation\"]} takes {lo_n}' + (f' to {hi_n}' if hi_n != lo_n else '')\n   333\t                                     + f' operands, not {len(fig.get(\"inputs\", []))}'))\n   334\t            signs = fig.get('signs')\n   335\t            if signs is not None and (fig['operation'] not in ('sum', 'roll_forward') or len(signs) != len(fig.get('inputs', []))\n   336\t                                      or any(x not in (1, -1) for x in signs)):\n   337\t                errors.append(('C7', f'{fig[\"id\"]}: signs must give one +1 or -1 per operand of a sum or roll_forward'))   # [46n]\n   338\t        for r in refs(fig):\n   339\t            if r not in figs:\n   340\t                errors.append(('C7', f'{fig[\"id\"]} refers to {r}, which is not defined'))\n   341\t    state = {}\n   342\t\n   343\t    def cyclic(fid):\n   344\t        if state.get(fid) == 1:\n   345\t            return True\n   346\t        if state.get(fid) == 2 or fid not in figs:\n   347\t            return False\n   348\t        state[fid] = 1\n   349\t        hit = any(cyclic(r) for r in refs(figs[fid]))\n   350\t        state[fid] = 2\n   351\t        return hit\n   352\t    if any(cyclic(fid) for fid in figs):\n   353\t        errors.append(('C7', 'the figure graph has a cycle'))\n   354\t    if errors:                                         # [46n] a malformed calculation is refused before any arithmetic\n   355\t        return {'errors': errors, 'recorded': recorded}\n   356\t\n   357\t    # C1 sources, prior pointers\n   358\t    for fig in figs.values():\n   359\t        if fig['kind'] == 'source':\n   360\t            errors += _source_errors(fig, passages)\n   361\t        if fig['kind'] == 'prior' and not fig.get('pointer'):\n   362\t            errors.append(('C7', f'{fig[\"id\"]}: a prior forecast needs an exact pointer to an earlier answer shown in the request'))\n   363\t\n   364\t    try:\n   365\t        return _check_after_structure(family, passages, calc, figs, refs, errors, recorded, reachable_factory=None)\n   366\t    except (ZeroDivisionError, OverflowError, ValueError) as error:          # [47.3] an arithmetic failure is a refusal, never a crash\n   367\t        errors.append(('C2', f'the calculation cannot be evaluated: {type(error).__name__}: {error}'))\n   368\t        return {'errors': errors, 'recorded': recorded}\n   369\t\n   370\t\n   371\tdef _check_after_structure(family, passages, calc, figs, refs, errors, recorded, reachable_factory=None):\n   372\t    # C2 arithmetic and bound propagation\n   373\t    for fig in figs.values():\n   374\t        if fig['kind'] != 'computed' or fig.get('operation') not in OPERATIONS:\n   375\t            continue\n   376\t        t_ids, t_signs = _terms(fig)\n   377\t        ins = [figs[i] for i in t_ids if i in figs]\n   378\t        expected = _compute(fig['operation'], [_interval(i) + (i['unit'],) for i in ins], t_signs, fig['unit']) if ins else (0.0, 0.0)   # [46x.2]\n   379\t        lo, hi = _interval(fig)\n   380\t        if not ins and (lo != 0 or hi != 0):              # [46y.2] an algebraic zero is exactly zero\n   381\t            errors.append(('C2', f'{fig[\"id\"]}: its operands cancel exactly, so it is 0, not {lo}–{hi}'))\n   382\t            continue\n   383\t        if fig['operation'] == 'range_from_relative' or ('low' in fig):\n   384\t            ok = _close(lo, expected[0], fig['unit']) and _close(hi, expected[1], fig['unit'])\n   385\t        else:\n   386\t            ok = _close(lo, (expected[0] + expected[1]) / 2, fig['unit'])\n   387\t        if not ok:\n   388\t            errors.append(('C2', f'{fig[\"id\"]}: declared {lo}–{hi} but {fig[\"operation\"]} of {fig[\"inputs\"]} gives {expected[0]:.2f}–{expected[1]:.2f}'))\n   389\t        want = _bound_direction(fig['operation'], ins, t_signs)\n   390\t        have = DIRECTION.get(fig.get('bound'))\n   391\t        if want == 'mixed':\n   392\t            errors.append(('C2', f'{fig[\"id\"]}: its inputs are bounded on opposite sides, so its value is unbounded; state it as an estimate'))\n   393\t        elif want is not None and have != want:\n   394\t            errors.append(('C2', f'{fig[\"id\"]}: its inputs make it a {want} bound, but it is declared {fig.get(\"bound\") or \"a point\"}'))\n   395\t        elif want is None and fig.get('bound'):\n   396\t            errors.append(('C2', f'{fig[\"id\"]}: its inputs are points, but it is declared a bound ({fig[\"bound\"]})'))\n   397\t\n   398\t    # C8 operand compatibility\n   399\t    for fig in figs.values():\n   400\t        if fig['kind'] != 'computed' or fig.get('operation') not in OPERATIONS:\n   401\t            continue\n   402\t        ins = [figs[i] for i in fig['inputs'] if i in figs]\n   403\t        op, rel, out = fig['operation'], fig.get('relation'), fig['what']\n   404\t        differing = [i['id'] for i in ins if i['unit'] not in ('%', 'x') and\n   405\t                     (i['what']['population'], i['what']['scope'], i['what']['period'], i['what']['measure']) !=\n   406\t                     (out['population'], out['scope'], out['period'], out['measure'])]\n   407\t        if op in ('sum', 'difference'):\n   408\t            money = [i for i in ins if i['unit'] not in ('%', 'x')]\n   409\t            same_qty = all((i['what']['population'], i['what']['measure'], i['what']['scope']) ==\n   410\t                           (out['population'], out['measure'], out['scope']) for i in money)\n   411\t            if rel == 'time_aggregation':\n   412\t                qs = [_quarters(i['what']['period']) for i in money]\n   413\t                q_out = _quarters(out['period'])\n   414\t                union = set().union(*[q[1] for q in qs]) if all(qs) else None\n   415\t                disjoint = all(qs) and sum(len(q[1]) for q in qs) == len(union or ())\n   416\t                if not (same_qty and q_out and all(qs) and disjoint and union == q_out[1] and all(q[0] == q_out[0] for q in qs)):\n   417\t                    errors.append(('C8', f'{fig[\"id\"]}: time aggregation needs one quantity over disjoint periods forming {out[\"period\"]}'))\n   418\t            elif rel in ('overlap_unknown', 'stated_in_addition'):\n   419\t                if rel == 'overlap_unknown' and fig.get('disputed') not in fig['inputs']:\n   420\t                    errors.append(('C8', f'{fig[\"id\"]}: overlap_unknown must name a disputed operand among its inputs'))\n   421\t            elif rel == 'accounting_parts':\n   422\t                wholes = {(r['whole_scope'], tuple(r['part_scopes'])) for r in family.get('scope_parts', [])}\n   423\t                if not any(out['scope'] == w and all(i['what']['scope'] in p for i in money) for w, p in wholes):\n   424\t                    errors.append(('C8', f'{fig[\"id\"]}: accounting_parts needs a declared split of {out[\"scope\"]}'))\n   425\t            elif differing:\n   426\t                errors.append(('C8', f'{fig[\"id\"]}: {op} of different quantities or periods ({\", \".join(differing)}) states no relation'))\n   427\t        elif op == 'roll_forward':\n   428\t            opening = ins[0]['what']['period'] if ins else ''\n   429\t            if not (opening.startswith('as of') and all(not i['what']['period'].startswith('as of') for i in ins[1:])\n   430\t                    and out['period'].startswith(('as of', 'end of'))):\n   431\t                errors.append(('C8', f'{fig[\"id\"]}: roll_forward needs an opening balance as of a date, flows after it, and a closing balance'))\n   432\t            if rel == 'overlap_unknown' and fig.get('disputed') not in fig['inputs']:\n   433\t                errors.append(('C8', f'{fig[\"id\"]}: overlap_unknown must name a disputed operand among its inputs'))\n   434\t        elif op == 'share':\n   435\t            pct = [i for i in ins if i['unit'] == '%']\n   436\t            if len(pct) != 1:\n   437\t                errors.append(('C8', f'{fig[\"id\"]}: a share needs one share figure and one whole'))\n   438\t        elif op == 'apply_growth' and any(r['type'] == 'same_base' for r in family.get('relations', [])) and \\\n   439\t                all(i['unit'] == '%' or i['what']['scope'] == out['scope'] for i in ins):\n   440\t            pass\n   441\t        elif op in ('range_from_relative', 'growth'):\n   442\t            pass\n   443\t        elif op in ('ratio', 'product') and _per_unit(op, ins, fig):\n   444\t            pass                                   # a total over a per-unit price gives units; units times the price give the total\n   445\t        elif op == 'product' and any(i['unit'] == 'x' for i in ins) and all(\n   446\t                i['unit'] == 'x' or (i['what']['population'], i['what']['measure'], i['what']['scope']) ==\n   447\t                (out['population'], out['measure'], out['scope']) for i in ins):\n   448\t            pass                                   # a multiplier the source states between periods is its own bridge\n   449\t        elif differing:\n   450\t            bridge = figs.get(fig.get('bridge'))\n   451\t            if not bridge or bridge['kind'] != 'estimate' or set(bridge.get('converts', [])) != set(differing):\n   452\t                errors.append(('C8', f'{fig[\"id\"]}: converts {\", \".join(differing)} to {out[\"population\"]} {out[\"scope\"]} {out[\"period\"]} '\n   453\t                                     f'{out[\"measure\"]} with no bridge naming those operands'))\n   454\t            else:\n   455\t                recorded.append({'type': 'bridge', 'figure': fig['id'], 'bridge': bridge['id'], 'alternate': 'undetermined'})\n   456\t\n   457\t    # [46z.2] one recomputed result: every computed figure takes its recomputed value and bound for every later check and for publication\n   458\t    recomputed = _evaluate_bounded(figs, refs, {})\n   459\t    for fid, fig in list(figs.items()):\n   460\t        if fig['kind'] == 'computed' and fig.get('operation') in OPERATIONS:\n   461\t            (lo_r, hi_r), b_r = recomputed[fid]\n   462\t            canon = {k: v for k, v in fig.items() if k not in ('value', 'low', 'high', 'bound')}\n   463\t            canon.update({'value': lo_r} if lo_r == hi_r else {'low': lo_r, 'high': hi_r})\n   464\t            if b_r:\n   465\t                canon['bound'] = b_r\n   466\t            figs[fid] = canon\n   467\t\n   468\t    # answers: C7 coverage and ownership, C6 rung, C5 reference\n   469\t    members = family['members']\n   470\t    seen = {}\n   471\t    for ans in calc['answers']:\n   472\t        seen[ans['view_id']] = seen.get(ans['view_id'], 0) + 1\n   473\t    for view_id in members:\n   474\t        if seen.get(view_id, 0) != 1:\n   475\t            errors.append(('C7', f'{view_id} has {seen.get(view_id, 0)} answers; exactly one is required'))\n   476\t    for view_id in seen:\n   477\t        if view_id not in members:\n   478\t            errors.append(('C7', f'{view_id} is not a member of the family'))\n   479\t    outcomes = {}\n   480\t    for ans in calc['answers']:\n   481\t        member = members.get(ans['view_id'])\n   482\t        if member is None:\n   483\t            continue\n   484\t        if ans.get('shape') == 'unresolved':\n   485\t            if 'outcome' in ans or 'rung' in ans or not ans.get('why'):\n   486\t                errors.append(('C7', f'{ans[\"view_id\"]}: an unresolved answer has a reason and neither outcome nor rung'))\n   487\t            continue\n   488\t        out = figs.get(ans.get('outcome'))\n   489\t        if out is None:\n   490\t            errors.append(('C7', f'{ans[\"view_id\"]}: outcome {ans.get(\"outcome\")} is not a figure'))\n   491\t            continue\n   492\t        if _key(out['what']) != _key(member['what']):\n   493\t            errors.append(('C7', f'{ans[\"view_id\"]}: outcome {out[\"id\"]} measures {_key(out[\"what\"])}, not the question\\'s {_key(member[\"what\"])}'))\n   494\t        outcomes[ans['view_id']] = out['id']\n   495\t        rung = ans.get('rung')\n   496\t        if not isinstance(rung, int) or isinstance(rung, bool) or not 1 <= rung <= len(member['bands']):   # [46q] before any lookup\n   497\t            errors.append(('C6', f'{ans[\"view_id\"]}: rung {rung!r} is not one of 1..{len(member[\"bands\"])}'))\n   498\t            continue\n   499\t        band = member['bands'][rung - 1]\n   500\t        shown = _outcome_set(out)                         # [46y.2, 46z.2] the recomputed value for a computed outcome\n   501\t        if not _overlaps(shown, band):                    # [46r] open and closed ends kept\n   502\t            errors.append(('C6', f'{ans[\"view_id\"]}: rung {rung} ({band}) contains no part of its outcome {shown}'))\n   503\t        ref = ans.get('reference') or {}\n   504\t        if ('figure' in ref) == ('unavailable' in ref):          # [46g.2] exactly one choice\n   505\t            errors.append(('C5', f'{ans[\"view_id\"]}: the reference must name exactly one of a figure or unavailable'))\n   506\t        elif 'unavailable' in ref:\n   507\t            if not ref['unavailable']:\n   508\t                errors.append(('C5', f'{ans[\"view_id\"]}: an unavailable reference needs a reason'))\n   509\t        else:\n   510\t            errors += _reference_errors(ans['view_id'], figs.get(ref.get('figure')), figs, passages, refs)\n   511\t\n   512\t    # [46j.1] scenario membership derived from the estimates a figure rests on; related members cover the same scenarios\n   513\t    def scen(fid):\n   514\t        return figs[fid].get('scenario', 'base')\n   515\t\n   516\t    def derived(fid):\n   517\t        return {scen(g) for g in _upstream_of(fid, figs, refs) | {fid} if figs[g]['kind'] == 'estimate' and scen(g) != 'range'}\n   518\t    for f in figs.values():\n   519\t        sc = f.get('scenario', 'base')\n   520\t        if sc == 'range' or f['kind'] not in ('computed', 'estimate'):\n   521\t            continue\n   522\t        other = derived(f['id']) - {sc}\n   523\t        if other:\n   524\t            errors.append(('C4', f'{f[\"id\"]} ({sc}) rests on estimates of another scenario ({\", \".join(sorted(other))})'))\n   525\t    for rel in family.get('relations', []):\n   526\t        if rel['type'] == 'part_of' and rel['part'] in outcomes and rel['whole'] in outcomes:\n   527\t            sp, sw = derived(outcomes[rel['part']]), derived(outcomes[rel['whole']])\n   528\t            if sp != sw:\n   529\t                errors.append(('C4', f'{rel[\"part\"]} covers scenarios {sorted(sp)} but {rel[\"whole\"]} covers {sorted(sw)}; related members cover the same'))\n   530\t\n   531\t    # [46i.1] a range summary is an estimate with low and high, is an answer's outcome, and no figure reads it\n   532\t    outcome_ids = {a.get('outcome') for a in calc['answers']}\n   533\t    for f in figs.values():\n   534\t        if f.get('scenario') != 'range':\n   535\t            continue\n   536\t        readers = [g['id'] for g in figs.values() if f['id'] in refs(g)]\n   537\t        if f['kind'] != 'estimate' or 'low' not in f or 'high' not in f or f['id'] not in outcome_ids or readers:\n   538\t            errors.append(('C4', f'{f[\"id\"]}: a range summary must be an estimate with low and high that is an answer\\'s outcome and feeds no figure'\n   539\t                                 + (f' (read by {\", \".join(readers)})' if readers else '')))\n   540\t\n   541\t    # C3 part within whole, C4 one forecast per shared quantity (every path)\n   542\t    def reachable(start, stop=None):\n   543\t        stops = set(stop) if isinstance(stop, (set, list, tuple)) else {stop}\n   544\t        seen_ids, stack = set(), [start]\n   545\t        while stack:\n   546\t            fid = stack.pop()\n   547\t            if fid in seen_ids or fid not in figs:\n   548\t                continue\n   549\t            seen_ids.add(fid)\n   550\t            if fid not in stops:\n   551\t                stack.extend(refs(figs[fid]))\n   552\t        return seen_ids\n   553\t    scenarios = {f.get('scenario', 'base') for f in figs.values() if f['basis'] == 'forecast'} or {'base'}\n   554\t    for rel in family.get('relations', []):\n   555\t        if rel['type'] != 'part_of' or rel['part'] not in outcomes or rel['whole'] not in outcomes:\n   556\t            continue\n   557\t        part_m, whole_m = members[rel['part']], members[rel['whole']]\n   558\t        for sc in scenarios:\n   559\t            for period in family.get('compare_periods', []):\n   560\t                def node(view_id, member):\n   561\t                    want = (member['what']['population'], member['what']['measure'], member['what']['scope'], period)\n   562\t                    hits = sorted((figs[f] for f in reachable(outcomes[view_id]) if _key(figs[f]['what']) == want\n   563\t                                   and figs[f]['basis'] == 'forecast' and figs[f].get('scenario', 'base') == sc), key=lambda f: f['id'])\n   564\t                    if len(hits) > 1:                 # [46x.1] one forecast per member quantity, period and scenario\n   565\t                        errors.append(('C3', f'{period} {sc}: {view_id} has {len(hits)} forecasts ({\", \".join(f[\"id\"] for f in hits)}); '\n   566\t                                             'the comparison is ambiguous'))\n   567\t                        return None\n   568\t                    return hits[0] if hits else None\n   569\t                p, w = node(rel['part'], part_m), node(rel['whole'], whole_m)\n   570\t                if p and w and _exceeds(_outcome_set(p), _outcome_set(w)):          # [46s] open and closed ends kept\n   571\t                    errors.append(('C3', f'{period} {sc}: {rel[\"part\"]} {p[\"id\"]} {_outcome_set(p)} exceeds {rel[\"whole\"]} {w[\"id\"]} {_outcome_set(w)}'))\n   572\t    for shared in family.get('shared', []):\n   573\t        want = _key(shared)\n   574\t        nodes = [f for f in figs.values() if _key(f['what']) == want and f['basis'] == 'forecast']\n   575\t        touched = [v for v, o in outcomes.items() if any(_key(figs[f]['what']) == want for f in reachable(o))]\n   576\t        if not touched:\n   577\t            continue\n   578\t        per_scenario = {}\n   579\t        for n in nodes:\n   580\t            per_scenario.setdefault(n.get('scenario', 'base'), []).append(n['id'])\n   581\t        if not nodes:\n   582\t            errors.append(('C4', f'{want}: no forecast node, though {\", \".join(touched)} depend on it'))\n   583\t        for sc, ids in sorted(per_scenario.items()):\n   584\t            if len(ids) != 1:\n   585\t                errors.append(('C4', f'{want} {sc}: {len(ids)} forecast nodes ({\", \".join(ids)}); exactly one per scenario is required'))\n   586\t        stop = {n['id'] for n in nodes}\n   587\t        for f in figs.values():                       # [46i.1] scenario membership is derived along the whole path, not declared\n   588\t            sc = f.get('scenario', 'base')\n   589\t            if sc == 'range' or f['kind'] not in ('computed', 'estimate'):\n   590\t                continue\n   591\t            upstream = _upstream_of(f['id'], figs, refs)\n   592\t            borrowed = sorted(r for r in upstream if r in stop and figs[r].get('scenario', 'base') != sc)\n   593\t            if borrowed:\n   594\t                errors.append(('C4', f'{want}: {f[\"id\"]} ({sc}) depends on {\", \".join(borrowed)} of another scenario'))\n   595\t        for view_id in touched:                      # [46g.3] a bypass reaches the quantity through no forecast node of any scenario\n   596\t            bypass = [f for f in reachable(outcomes[view_id], stop=stop) if f not in stop and _key(figs[f]['what']) == want]\n   597\t            if bypass:\n   598\t                errors.append(('C4', f'{want}: {view_id} reaches {\", \".join(sorted(bypass))} without passing a forecast node ({\", \".join(sorted(stop))})'))\n   599\t    for rel in family.get('relations', []):           # [46j.2] the later member rests on the earlier member's forecast nodes, per scenario\n   600\t        if rel['type'] != 'same_base' or rel['later'] not in outcomes or rel['earlier'] not in outcomes:\n   601\t            continue\n   602\t        base_key = _key(members[rel['earlier']]['what'])\n   603\t        earlier_graph = _upstream_of(outcomes[rel['earlier']], figs, refs) | {outcomes[rel['earlier']]}\n   604\t        earlier_nodes = {f for f in earlier_graph if _key(figs[f]['what']) == base_key and figs[f]['basis'] == 'forecast'}\n   605\t        reached = reachable(outcomes[rel['later']], stop=earlier_nodes)\n   606\t        bypass = [f for f in reached if f not in earlier_nodes and _key(figs[f]['what']) == base_key]\n   607\t        later_key = _key(members[rel['later']]['what'])\n   608\t        e_out = outcomes[rel['earlier']]                  # [46z.1] the published forecast, or the scenario paths its range summary rests on\n   609\t        if figs[e_out].get('scenario') == 'range':\n   610\t            by_scenario = {}\n   611\t            for n in sorted(r for r in figs[e_out].get('rests_on', []) if r in figs and _key(figs[r]['what']) == base_key\n   612\t                            and figs[r]['basis'] == 'forecast'):\n   613\t                by_scenario.setdefault(figs[n].get('scenario', 'base'), []).append(n)\n   614\t        else:\n   615\t            by_scenario = {figs[e_out].get('scenario', 'base'): [e_out]}\n   616\t        later_graph = _upstream_of(outcomes[rel['later']], figs, refs) | {outcomes[rel['later']]}\n   617\t        for f in sorted(later_graph):                 # [46k.1] every later scenario path reaches the earlier forecast of its own scenario\n   618\t            sc = figs[f].get('scenario', 'base')\n   619\t            if sc == 'range' or _key(figs[f]['what']) != later_key or figs[f]['basis'] != 'forecast':\n   620\t                continue\n   621\t            cands = by_scenario.get(sc) or (next(iter(by_scenario.values())) if len(by_scenario) == 1 else [])\n   622\t            used = [c for c in cands if c in _determining(f, figs)]\n   623\t            target = used[0] if used else None\n   624\t            if target is None:                            # [46l.1] through value-determining inputs only\n   625\t                errors.append(('C9', f'{f} ({sc}) of {rel[\"later\"]} is not computed from {rel[\"earlier\"]}\\'s {sc} forecast'))\n   626\t            else:                                     # [46o.1, 46p] its value moves when that forecast moves: one realisation per figure\n   627\t                mid_t = sum(_interval(figs[target])) / 2\n   628\t                before = _evaluate_points(figs, refs, {})[f]\n   629\t                after = _evaluate_points(figs, refs, {target: mid_t * 1.1})[f]\n   630\t                if abs(after - before) <= 1e-9 * max(1.0, abs(before)):\n   631\t                    errors.append(('C9', f'{f} ({sc}) of {rel[\"later\"]} does not change when {rel[\"earlier\"]}\\'s forecast {target} changes'))\n   632\t        later_scen = {figs[f].get('scenario', 'base') for f in later_graph if _key(figs[f]['what']) == later_key\n   633\t                      and figs[f]['basis'] == 'forecast' and figs[f].get('scenario', 'base') != 'range'}\n   634\t        if earlier_nodes and not later_scen:              # [46m.2] a citation never stands in for a calculation\n   635\t            errors.append(('C9', f'{rel[\"later\"]} has no calculation from {rel[\"earlier\"]}\\'s forecast, only a range resting on it'))\n   636\t        if len(by_scenario) > 1 and later_scen != set(by_scenario):     # [46l.1] the later member covers the earlier's scenarios\n   637\t            errors.append(('C9', f'{rel[\"later\"]} covers scenarios {sorted(later_scen)} but {rel[\"earlier\"]} covers {sorted(by_scenario)}'))\n   638\t        if not reached & earlier_nodes:\n   639\t            errors.append(('C9', f'{rel[\"later\"]} does not rest on {rel[\"earlier\"]}\\'s forecast ({\", \".join(sorted(earlier_nodes))})'))\n   640\t        if bypass:\n   641\t            errors.append(('C9', f'{rel[\"later\"]} reaches {\", \".join(sorted(bypass))} for {base_key} without {rel[\"earlier\"]}\\'s forecast'))\n   642\t    supplied = family.get('prior_answers', {})\n   643\t    for fig in figs.values():\n   644\t        earlier = fig['kind'] == 'prior' or fig.get('basis') == 'prior_forecast' or 'pointer' in fig   # [46i.2] derived, not labelled\n   645\t        if not earlier:\n   646\t            continue\n   647\t        if fig['kind'] != 'prior' or fig.get('basis') != 'prior_forecast':\n   648\t            errors.append(('C10', f'{fig[\"id\"]}: an earlier forecast must be kind prior with basis prior_forecast'))\n   649\t        ptr, ans_prior = fig.get('pointer', {}), supplied.get(fig.get('pointer', {}).get('view'), {})\n   650\t        if ans_prior.get('day') != ptr.get('day') or not any(_same(fig.get('value'), v) for v in ans_prior.get('values', [])):\n   651\t            errors.append(('C10', f'{fig[\"id\"]}: no earlier answer of {ptr.get(\"view\")} on {ptr.get(\"day\")} shown in the request states {fig.get(\"value\")}'))\n   652\t        owners = [a['view_id'] for a in calc['answers'] if a.get('outcome') == fig['id']]\n   653\t        if owners:                                    # [46h.2] nor the current outcome\n   654\t            errors.append(('C10', f'{fig[\"id\"]}: an earlier forecast cannot be the current outcome of {\", \".join(owners)}'))\n   655\t        users = [f['id'] for f in figs.values() if fig['id'] in refs(f)]\n   656\t        if users:\n   657\t            errors.append(('C10', f'{fig[\"id\"]}: an earlier forecast is for comparison only and cannot feed {\", \".join(users)}'))\n   658\t\n   659\t    recorded += _assumptions(family, figs, outcomes, calc, refs)\n   660\t    finite = lambda v: v if abs(v) != float('inf') else None\n   661\t    published = {v: [finite(_outcome_set(figs[o])[0]), finite(_outcome_set(figs[o])[2]), figs[o].get('bound')] for v, o in outcomes.items()}\n   662\t    return {'errors': errors, 'recorded': recorded, 'published': published}\n   663\t\n   664\t\n   665\tdef _per_unit(op, ins, fig):\n   666\t    \"\"\"The per-unit identity: ratio(total, price per unit) -> units, product(units, price per unit) -> total, for one population and\n   667\t    scope. Labels are the judge's; a reader checks them against the passages.\"\"\"\n   668\t    out = fig['what']\n   669\t    if len(ins) != 2:\n   670\t        return False\n   671\t    same = all((i['what']['population'], i['what']['scope']) == (out['population'], out['scope']) for i in ins)\n   672\t    price = [i for i in ins if i['what']['measure'] == 'price per unit' and i['unit'] in ('USD', 'USD bn')]\n   673\t    if op == 'ratio':\n   674\t        return same and len(price) == 1 and ins[1] is price[0] and out['measure'] == 'units' and ins[0]['unit'] in ('USD', 'USD bn')\n   675\t    units = [i for i in ins if i['what']['measure'] == 'units' and i['unit'] == 'units']\n   676\t    return same and len(price) == 1 and len(units) == 1 and fig['unit'] in ('USD', 'USD bn')\n   677\t\n   678\t\n   679\tdef member_sources(answer, figs):\n   680\t    \"\"\"[46k.3, 46ac.1] The source figures a member's own outcome and reference rest on, each identified by its passage, expression and\n   681\t    the component used.\"\"\"\n   682\t    refs = lambda f: list(f.get('inputs', [])) + [r for r in f.get('rests_on', []) if r in figs] + \\\n   683\t        ([f['adjusts']['figure']] if f.get('adjusts') else []) + ([f['bridge']] if f.get('bridge') else [])\n   684\t    own = set()\n   685\t    for start in (answer.get('outcome'), (answer.get('reference') or {}).get('figure')):\n   686\t        if start in figs:\n   687\t            own |= _upstream_of(start, figs, refs) | {start}\n   688\t    return sorted(f'{figs[f][\"evidence\"]}|{figs[f][\"expression\"]}|{figs[f].get(\"component\", \"value\")}' for f in own if figs[f]['kind'] == 'source')\n   689\t\n   690\t\n   691\tdef changed(previous, answer, figs):\n   692\t    \"\"\"D728: whether a member's conclusion changed, derived by code from its earlier rung, outcome and source figures.\"\"\"\n   693\t    if previous is None:\n   694\t        return True, 'first judgement'\n   695\t    was_unresolved = previous.get('shape') == 'unresolved'\n   696\t    if answer.get('shape') == 'unresolved' or was_unresolved:          # [46ac.2] an unresolved answer is routed before any number\n   697\t        if answer.get('shape') == 'unresolved' and was_unresolved:\n   698\t            return False, 'still unresolved'\n   699\t        return True, 'now unresolved' if answer.get('shape') == 'unresolved' else 'now a forecast'\n   700\t    refs = lambda f: list(f.get('inputs', [])) + [r for r in f.get('rests_on', []) if r in figs] + \\\n   701\t        ([f['adjusts']['figure']] if f.get('adjusts') else []) + ([f['bridge']] if f.get('bridge') else [])\n   702\t    out = figs[answer['outcome']]\n   703\t    if out['kind'] == 'computed':                     # [46aa] the same recomputed outcome publication uses\n   704\t        (lo_r, hi_r), b_r = _evaluate_bounded(figs, refs, {})[out['id']]\n   705\t        out = {k: v for k, v in out.items() if k not in ('value', 'low', 'high', 'bound')}\n   706\t        out.update({'value': lo_r} if lo_r == hi_r else {'low': lo_r, 'high': hi_r})\n   707\t        if b_r:\n   708\t            out['bound'] = b_r\n   709\t    sources = member_sources(answer, figs)\n   710\t    reasons = []\n   711\t    if answer['rung'] != previous['rung']:\n   712\t        reasons.append(f'rung {previous[\"rung\"]} to {answer[\"rung\"]}')\n   713\t    # [46l.2, 46ab] the published outcome as published: both ends (None for an open-ended side) and the bound\n   714\t    o_lo, _, o_hi, _ = _outcome_set(out)\n   715\t    finite = lambda v: None if v is None or abs(v) == float('inf') else round(v, 6)\n   716\t    cur = (finite(o_lo), finite(o_hi), out.get('bound'))\n   717\t    prev = previous['outcome']\n   718\t    if isinstance(prev, (int, float)):\n   719\t        prev = (prev, prev, None)\n   720\t    elif len(prev) == 2:\n   721\t        prev = (prev[0], prev[1], None)\n   722\t    prev = (finite(prev[0]), finite(prev[1]), prev[2])\n   723\t    near = lambda a, b: (a is None and b is None) or (a is not None and b is not None and abs(a - b) <= 0.005 * max(abs(b), 1e-9))\n   724\t    if cur[2] != prev[2] or not near(cur[0], prev[0]) or not near(cur[1], prev[1]):\n   725\t        reasons.append(f'outcome {list(prev)} to {list(cur)}')\n   726\t    added, dropped = sorted(set(sources) - set(previous['sources'])), sorted(set(previous['sources']) - set(sources))\n   727\t    if added or dropped:\n   728\t        reasons.append(f'source figures added {added}, dropped {dropped}')\n   729\t    return bool(reasons), '; '.join(reasons) or 'unchanged'\n   730\t\n   731\t\n   732\tdef publish_decision(family, calc, result):\n   733\t    \"\"\"DESIGN.md §4: 'refused' when a check fails (the harness retries once); 'held' when a member is unresolved and a declared\n   734\t    relation joins it to another member; else 'publish' (unresolved members shown as unresolved).\"\"\"\n   735\t    if result['errors']:\n   736\t        return 'refused'\n   737\t    unresolved = {a['view_id'] for a in calc['answers'] if a.get('shape') == 'unresolved'}\n   738\t    for rel in family.get('relations', []):\n   739\t        ends = {rel.get('part'), rel.get('whole'), rel.get('later'), rel.get('earlier')} - {None}\n   740\t        if ends & unresolved and ends - unresolved:\n   741\t            return 'held'\n   742\t    return 'publish'\n   743\t\n   744\t\n   745\tdef family_outcome(attempts):\n   746\t    \"\"\"The round's outcome from up to two attempts' decisions: a refusal is retried once; two refusals make the family unresolved.\"\"\"\n   747\t    if attempts[0] != 'refused':\n   748\t        return attempts[0]\n   749\t    if len(attempts) > 1 and attempts[1] != 'refused':\n   750\t        return attempts[1]\n   751\t    return 'unresolved'\n   752\t\n   753\t\n   754\tdef _determining(fid, figs):\n   755\t    \"\"\"The figures that determine fid's value: computed inputs only, at any depth (an estimate's rests_on explains, it does not compute).\"\"\"\n   756\t    seen_ids, stack = set(), list(figs[fid].get('inputs', [])) if figs[fid]['kind'] == 'computed' else []\n   757\t    while stack:\n   758\t        f = stack.pop()\n   759\t        if f in seen_ids or f not in figs:\n   760\t            continue\n   761\t        seen_ids.add(f)\n   762\t        if figs[f]['kind'] == 'computed':\n   763\t            stack.extend(figs[f].get('inputs', []))\n   764\t    return seen_ids\n   765\t\n   766\t\n   767\tdef _upstream_of(fid, figs, refs):\n   768\t    \"\"\"The figures that fid's own value is computed from (fid excluded).\"\"\"\n   769\t    seen_ids, stack = set(), list(refs(figs[fid]))\n   770\t    while stack:\n   771\t        f = stack.pop()\n   772\t        if f in seen_ids or f not in figs:\n   773\t            continue\n   774\t        seen_ids.add(f)\n   775\t        stack.extend(refs(figs[f]))\n   776\t    return seen_ids\n   777\t\n   778\t\n   779\tdef _reference_errors(view_id, ref, figs, passages, refs):\n   780\t    if ref is None:\n   781\t        return [('C5', f'{view_id}: the reference names no figure')]\n   782\t    graph = [ref['id']] + sorted(_upstream_of(ref['id'], figs, refs))\n   783\t    nodes = [figs[f] for f in graph]\n   784\t    if any(n['kind'] in ('estimate', 'prior') or n['basis'] in ('forecast', 'prior_forecast') for n in nodes):\n   785\t        return [('C5', f'{view_id}: the reference {ref[\"id\"]} rests on the system\\'s own forecast or an estimate')]\n   786\t    leaves = [n for n in nodes if n['kind'] == 'source']\n   787\t    if not any(n['basis'] in EXTERNAL and passages.get(n['evidence'], {}).get('speaker') != 'system' for n in leaves):\n   788\t        return [('C5', f'{view_id}: the reference {ref[\"id\"]} has no external source among its leaves')]\n   789\t    if any(n['basis'] not in EXTERNAL | {'reported'} for n in leaves):\n   790\t        return [('C5', f'{view_id}: the reference {ref[\"id\"]} has a leaf that is neither external nor reported')]\n   791\t    return []\n   792\t\n   793\t\n   794\tdef _evaluate(figs, refs, overrides):\n   795\t    \"\"\"Recompute computed figures from their inputs, with some figures' values replaced; estimates keep their values.\"\"\"\n   796\t    values, order, done = {}, [], set()\n   797\t\n   798\t    def visit(fid):\n   799\t        if fid in done:\n   800\t            return\n   801\t        done.add(fid)\n   802\t        for r in refs(figs[fid]):\n   803\t            if r in figs:\n   804\t                visit(r)\n   805\t        order.append(fid)\n   806\t    for fid in figs:\n   807\t        visit(fid)\n   808\t    for fid in order:\n   809\t        fig = figs[fid]\n   810\t        if fid in overrides:\n   811\t            values[fid] = overrides[fid]\n   812\t        elif fig['kind'] == 'computed' and fig.get('operation') in OPERATIONS:\n   813\t            t_ids, t_signs = _terms(fig)\n   814\t            ins = [values[i] + (figs[i]['unit'],) for i in t_ids]\n   815\t            values[fid] = _compute(fig['operation'], ins, t_signs, fig['unit']) if ins else (0.0, 0.0)\n   816\t        else:\n   817\t            values[fid] = _interval(fig)\n   818\t    return values\n   819\t\n   820\t\n   821\tdef _evaluate_points(figs, refs, overrides):\n   822\t    \"\"\"Recompute with every figure at one point (its midpoint), the same wherever it appears; overrides set points.\"\"\"\n   823\t    values, order, done = {}, [], set()\n   824\t\n   825\t    def visit(fid):\n   826\t        if fid in done:\n   827\t            return\n   828\t        done.add(fid)\n   829\t        for r in refs(figs[fid]):\n   830\t            if r in figs:\n   831\t                visit(r)\n   832\t        order.append(fid)\n   833\t    for fid in figs:\n   834\t        visit(fid)\n   835\t    for fid in order:\n   836\t        fig = figs[fid]\n   837\t        if fid in overrides:\n   838\t            values[fid] = overrides[fid]\n   839\t        elif fig['kind'] == 'computed' and fig.get('operation') in OPERATIONS:\n   840\t            t_ids, t_signs = _terms(fig)\n   841\t            ins = [(values[i], values[i], figs[i]['unit']) for i in t_ids]\n   842\t            lo, hi = _compute(fig['operation'], ins, t_signs, fig['unit']) if ins else (0.0, 0.0)\n   843\t            values[fid] = (lo + hi) / 2\n   844\t        else:\n   845\t            values[fid] = sum(_interval(fig)) / 2\n   846\t    return values\n   847\t\n   848\t\n   849\tdef _boundaries(bands, a, b):\n   850\t    edges = sorted({e for band in bands for e in band if e is not None})\n   851\t    lo, hi = min(a, b), max(a, b)\n   852\t    return [e for e in edges if lo < e <= hi]\n   853\t\n   854\t\n   855\tdef _assumptions(family, figs, outcomes, calc, refs):\n   856\t    out = []\n   857\t    members = family['members']\n   858\t\n   859\t    def downstream_formula(start, outcome_id):\n   860\t        \"\"\"True when every figure between start and the outcome (the outcome included) is computed.\"\"\"\n   861\t        between = [f for f in [outcome_id] + sorted(_upstream_of(outcome_id, figs, refs)) if start in _upstream_of(f, figs, refs)]\n   862\t        return all(figs[f]['kind'] == 'computed' for f in between)\n   863\t    for fig in figs.values():\n   864\t        alt, kind = None, None\n   865\t        if fig['kind'] == 'computed' and fig.get('relation') == 'overlap_unknown' and fig.get('disputed') in fig.get('inputs', []):\n   866\t            t_ids, t_signs = _terms(dict(fig, inputs=[i for i in fig['inputs'] if i != fig['disputed']],\n   867\t                                         signs=[k for i, k in zip(fig['inputs'], fig.get('signs') or [1] * len(fig['inputs'])) if i != fig['disputed']]))\n   868\t            keep, signs = t_ids, t_signs\n   869\t            alt = _compute(fig['operation'], [_interval(figs[i]) + (figs[i]['unit'],) for i in keep], signs, fig['unit'])\n   870\t            side = _bound_direction(fig['operation'], [figs[i] for i in keep], signs)      # [46u.1] the retained operands' bounds\n   871\t            strict = any(figs[i].get('bound') in STRICT for i in keep)\n   872\t            kind, bound = 'overlap', {'lower': '>' if strict else '>=', 'upper': '<' if strict else '<=', 'two-sided': 'approx', 'mixed': 'mixed', None: None}[side]\n   873\t        elif fig['kind'] == 'estimate' and fig.get('adjusts'):\n   874\t            target = figs[fig['adjusts']['figure']]\n   875\t            alt, kind, bound = _interval(target), 'adjustment', target.get('bound')\n   876\t        if kind is None:\n   877\t            continue\n   878\t        for view_id, outcome_id in outcomes.items():\n   879\t            if fig['id'] != outcome_id and fig['id'] not in _upstream_of(outcome_id, figs, refs):\n   880\t                continue\n   881\t            if not downstream_formula(fig['id'], outcome_id):\n   882\t                out.append({'type': kind, 'figure': fig['id'], 'outcome': view_id, 'certainty': 'undetermined'})\n   883\t                continue\n   884\t            base_vals = _evaluate_bounded(figs, refs, {})                 # [46s, 46t.1] bounds carried through recomputation\n   885\t            alt_override = (alt, bound)\n   886\t            alt_vals = _evaluate_bounded(figs, refs, {fig['id']: alt_override})\n   887\t            base_set, alt_set = _set_from(*base_vals[outcome_id]), _set_from(*alt_vals[outcome_id])\n   888\t            definite, possible = _crossings(base_set, alt_set, members[view_id]['bands'])\n   889\t            finite = lambda v: v if abs(v) != float('inf') else None\n   890\t            out.append({'type': kind, 'figure': fig['id'], 'outcome': view_id, 'value': [finite(base_set[0]), finite(base_set[2])],\n   891\t                        'alternate': [finite(alt_set[0]), finite(alt_set[2])], 'alternate_bound': bound,\n   892\t                        'definite': definite, 'possible': possible})                      # [46t.1] certainty per boundary\n   893\t    return out\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc 'nl -ba docs/research/2026-11-22-number-answers/paid_gate.py'","aggregated_output":"     1\t\"\"\"The paid gate of judging-v13 (D725's registered test; D729, D730). Harness-only; nothing here is product code.\n     2\t\n     3\t  python3 paid_gate.py plan <out.json>                        # $0: build every request from the stored runs and check them\n     4\t  python3 paid_gate.py send <new out folder> <ceiling>        # paid: only at the ceiling Alex names (APPROVED_CEILING)\n     5\t  python3 paid_gate.py packets <out folder> <key folder>      # $0: blind reading packets, the arm hidden; the key kept outside the repo\n     6\t  python3 paid_gate.py verdict <out folder> <readings.json> <key folder>   # $0: the registered pass and stop lines\n     7\t\n     8\tThe test (D725, RESULT.md): the 09-20 total and Data Center pair in each of three stored draws, judged jointly (one v13 family call)\n     9\tand separately (each member alone, the same union of evidence, the same v13 format), three samples each; plus three samples each of\n    10\tthe O, S and E singletons. 9 + 18 + 9 = 36 first attempts. A calculation the checks refuse is retried once with its errors; a second\n    11\trefusal makes the unit unresolved. The separate arm's two answers are then reconciled by the same checks over the pair's family.\n    12\t\"\"\"\n    13\timport hashlib\n    14\timport json\n    15\timport random\n    16\timport re\n    17\timport secrets\n    18\timport sqlite3\n    19\timport sys\n    20\timport threading\n    21\tfrom pathlib import Path\n    22\t\n    23\tHERE = Path(__file__).resolve().parent\n    24\tREPO = HERE.parents[2]\n    25\tsys.path.insert(0, str(HERE))\n    26\tsys.path.insert(0, str(REPO / 'src'))\n    27\timport calc_check as cc                                                 # noqa: E402\n    28\timport render_v13 as rv                                                 # noqa: E402\n    29\tfrom hivemind import config, model                                      # noqa: E402\n    30\t\n    31\tRUN = REPO / 'poc/data/comparison-2026-11-17/run'\n    32\tCONFIG = REPO / 'poc/config/poc-v118.json'                              # its re-judging model setting: gpt-6-luna, medium, 16000 output tokens\n    33\tSYSTEM = (HERE / 'judging-v13-draft.txt').read_text()\n    34\tAPPROVED_CEILING = 0.5                                                  # Alex, 2026-11-22 (D732): \"0.5 美元 (推荐)\"\n    35\tPINNED_PLAN_SHA256 = (HERE / 'paid-plan.sha256').read_text().strip() if (HERE / 'paid-plan.sha256').exists() else None\n    36\tAUTH = Path.home() / '.hivemind-keys/v13-paid-gate/authorization.json'\n    37\tDRAWS = (1, 2, 3)\n    38\tRETRY_MARK = '\\n\\nThe code refused the previous answer because: '\n    39\tPAIRS = [('old-1', ('v4', 9014), ('v8', 9022)), ('old-2', ('v14', 8729), ('v9', 8737)), ('old-3', ('v3', 9183), ('v35', 9177))]\n    40\tSINGLETONS = [('O', 'old-2', 'v29', 8734, ('NVIDIA', 'equity investment commitments', 'company', 'end of FY2027')),\n    41\t              ('S', 'old-2', 'v6', 8595, ('four largest AI hyperscalers', 'data-center capex', 'combined', 'CY2027')),\n    42\t              ('E', 'old-3', 'v41', 9166, ('NVIDIA', 'revenue', 'Vera CPU', 'FY2028'))]\n    43\t\n    44\t\n    45\tdef W(population, measure, scope, period):\n    46\t    return {'population': population, 'measure': measure, 'scope': scope, 'period': period}\n    47\t\n    48\t\n    49\tdef bands(draw, view_id):\n    50\t    conn = sqlite3.connect(f'file:{RUN / draw / \"prod/views.sqlite\"}?mode=ro', uri=True)\n    51\t    rows = conn.execute('select lo, hi from rungs where view_id=? order by position', (view_id,)).fetchall()\n    52\t    return [[lo / 1e9 if lo is not None else None, hi / 1e9 if hi is not None else None] for lo, hi in rows]\n    53\t\n    54\t\n    55\tdef passages(draw, evidence_ids):\n    56\t    \"\"\"What each request showed of a passage: the quote cut at 400 characters (judging._lines_english).\"\"\"\n    57\t    conn = sqlite3.connect(f'file:{RUN / draw / \"prod/views.sqlite\"}?mode=ro', uri=True)\n    58\t    rows = conn.execute(f'select evidence_id, quote, speaker from evidence where evidence_id in ({\",\".join(\"?\" * len(evidence_ids))})',\n    59\t                        evidence_ids).fetchall()\n    60\t    return {e: {'text': (q or '')[:400], 'speaker': s} for e, q, s in rows}\n    61\t\n    62\t\n    63\tdef pair_family(draw, total, dc):\n    64\t    return {'members': {total[0]: {'what': W('NVIDIA', 'revenue', 'company', 'FY2027'), 'bands': bands(draw, total[0])},\n    65\t                        dc[0]: {'what': W('NVIDIA', 'revenue', 'Data Center', 'FY2027'), 'bands': bands(draw, dc[0])}},\n    66\t            'relations': [{'type': 'part_of', 'part': dc[0], 'whole': total[0]}],\n    67\t            'shared': [W('NVIDIA', 'revenue', 'company', 'FY2027 Q3'), W('NVIDIA', 'revenue', 'company', 'FY2027 Q4')],\n    68\t            'compare_periods': ['FY2027 Q3', 'FY2027 Q4', 'FY2027']}\n    69\t\n    70\t\n    71\tdef only(family, view_id):\n    72\t    return {'members': {view_id: family['members'][view_id]}, 'relations': [], 'shared': family['shared'], 'compare_periods': []}\n    73\t\n    74\t\n    75\tdef questions(draw, view_ids):\n    76\t    conn = sqlite3.connect(f'file:{RUN / draw / \"prod/views.sqlite\"}?mode=ro', uri=True)\n    77\t    out = {}\n    78\t    for v in view_ids:\n    79\t        q = conn.execute('select question from views where view_id=?', (v,)).fetchone()[0]\n    80\t        ladder = [c for (c,) in conn.execute('select condition from rungs where view_id=? order by position', (v,))]\n    81\t        out[v] = {'question': q, 'ladder': ladder}\n    82\t    return out\n    83\t\n    84\t\n    85\tdef shown_lines(user):\n    86\t    \"\"\"Each evidence item exactly as the request showed it: its header line (tier, speaker, original source and date) and its quote.\"\"\"\n    87\t    m = re.search(r'\\[Evidence in view for the family, \\d+ items\\]\\n(.*?)(?:\\n\\n\\[|\\n\\nAnswer per)', user, re.S)\n    88\t    out = {}\n    89\t    for chunk in re.split(r'\\n(?=- e\\d+ )', m.group(1) if m else ''):\n    90\t        if chunk.startswith('- e'):\n    91\t            out[chunk[2:].split(' ', 1)[0]] = chunk\n    92\t    return out\n    93\t\n    94\t\n    95\tdef item(unit, arm, draw, calls, family, shown):\n    96\t    archive = RUN / draw / 'prod/archive.sqlite'\n    97\t    user, evidence_ids, theme_ids = rv.render(archive, calls, family, shown=shown)\n    98\t    return {'unit': unit, 'arm': arm, 'draw_store': draw, 'members': sorted(shown), 'system': SYSTEM, 'user': user,\n    99\t            'schema': rv.v13_schema(sorted(shown), evidence_ids, theme_ids), 'family': family, 'passages': passages(draw, evidence_ids),\n   100\t            'evidence_ids': evidence_ids, 'questions': questions(draw, sorted(shown)), 'shown': shown_lines(user)}\n   101\t\n   102\t\n   103\tdef build_plan():\n   104\t    items = []\n   105\t    for draw, total, dc in PAIRS:\n   106\t        family = pair_family(draw, total, dc)\n   107\t        calls = [total, dc]\n   108\t        items.append(item(f'pair-{draw}', 'joint', draw, calls, family, [total[0], dc[0]]))\n   109\t        for member in (total, dc):                            # the same union of evidence, one member's header and answer\n   110\t            items.append(item(f'pair-{draw}', f'separate-{member[0]}', draw, calls, only(family, member[0]), [member[0]]))\n   111\t    for name, draw, view_id, call_id, what in SINGLETONS:\n   112\t        family = {'members': {view_id: {'what': W(*what), 'bands': bands(draw, view_id)}}, 'relations': [], 'shared': [], 'compare_periods': []}\n   113\t        items.append(item(f'single-{name}', 'single', draw, [(view_id, call_id)], family, [view_id]))\n   114\t    return items\n   115\t\n   116\t\n   117\tdef plan(out):\n   118\t    items = build_plan()\n   119\t    report = []\n   120\t    for it in items:\n   121\t        missing = sorted(set(it['evidence_ids']) - set(it['passages']))\n   122\t        report.append(f'{it[\"unit\"]:14} {it[\"arm\"]:14} members {it[\"members\"]} user {len(it[\"user\"])} chars, evidence {len(it[\"evidence_ids\"])}, '\n   123\t                      f'schema {len(json.dumps(it[\"schema\"]))} chars, passages missing {missing or \"none\"}')\n   124\t        if missing or 'Outcome keys' not in it['user']:\n   125\t            raise SystemExit(f'{it[\"unit\"]} {it[\"arm\"]}: incomplete request; not planned')\n   126\t    ids = [(i['unit'], i['arm']) for i in items]\n   127\t    if len(set(ids)) != len(ids):\n   128\t        raise SystemExit('duplicate (unit, arm) in the plan; not planned')\n   129\t    text = json.dumps(items, indent=1)\n   130\t    Path(out).write_text(text)\n   131\t    Path(out).with_suffix('.sha256').write_text(hashlib.sha256(text.encode()).hexdigest() + '\\n')\n   132\t    print('\\n'.join(report))\n   133\t    print(f'{len(items)} requests x {len(DRAWS)} draws = {len(items) * len(DRAWS)} first attempts')\n   134\t\n   135\t\n   136\tdef strip(data):\n   137\t    return rv.without_nulls(data)\n   138\t\n   139\t\n   140\tclass Gate:\n   141\t    def __init__(self, out, transport, ledger=None):\n   142\t        self.out, self.transport, self.ledger = out, transport, ledger\n   143\t        self.cfg = config.load(str(CONFIG))\n   144\t        self.lock = threading.Lock()\n   145\t        (out / 'archives').mkdir(parents=True, exist_ok=True)\n   146\t\n   147\t    def request(self, it, user):\n   148\t        return model.build_request(self.cfg.rejudging, it['system'], user, it['schema'], 'judgement', self.cfg.provider)\n   149\t\n   150\t    def record(self, line):\n   151\t        \"\"\"[47g] Scored first attempts go to answers.jsonl, diagnostic retries to retries.jsonl, so damage to a retry's record can be\n   152\t        seen without touching the scored record.\"\"\"\n   153\t        name = 'answers.jsonl' if line['attempt'] == 1 else 'retries.jsonl'\n   154\t        with self.lock, open(self.out / name, 'a') as handle:\n   155\t            handle.write(json.dumps(line, ensure_ascii=False) + '\\n')\n   156\t\n   157\t    def attempt(self, it, draw, user, n):\n   158\t        name = f'{it[\"unit\"]}-{it[\"arm\"]}-d{draw}-a{n}.sqlite'\n   159\t        archive = model.Archive(str(self.out / 'archives' / name))\n   160\t        line = {'unit': it['unit'], 'arm': it['arm'], 'draw': draw, 'attempt': n,\n   161\t                'request_sha256': model.request_identity(self.request(it, user))[1]}\n   162\t        self.record(dict(line, status='started'))                          # [47.3] recorded before the provider is called\n   163\t        data = None\n   164\t        try:\n   165\t            answer = model.call(archive, self.cfg, self.cfg.rejudging, it['system'], user, it['schema'], 'judgement', 'judge', transport=self.transport)\n   166\t            data = answer.data\n   167\t            line.update(cost_usd=answer.cost_usd, data=data)\n   168\t            calc = strip(data)\n   169\t            result = cc.check(it['family'], it['passages'], calc)\n   170\t            decision = cc.publish_decision(it['family'], calc, result)\n   171\t            line.update(status='answered', errors=result['errors'], recorded=result['recorded'], published=result.get('published'), decision=decision)\n   172\t        except model.SchemaError as error:\n   173\t            row = archive.conn.execute('select response_json from model_calls order by call_id desc limit 1').fetchone()\n   174\t            line.update(status='format invalid', error=str(error)[:500], decision='refused', errors=[('schema', str(error)[:300])],\n   175\t                        raw=row[0] if row and row[0] else None)           # [47f.2] whole, as the archive stores it\n   176\t        except model.TransportError as error:\n   177\t            line.update(status='transport error', error=str(error)[:500], decision='transport')\n   178\t        except Exception as error:                                       # [47.3] a checker failure is recorded with the raw answer and refused\n   179\t            line.update(status='checker error', error=f'{type(error).__name__}: {error}'[:500], decision='refused',\n   180\t                        errors=[('checker', f'{type(error).__name__}: {error}'[:300])], data=data)\n   181\t        self.record(line)\n   182\t        return line\n   183\t\n   184\t    def stopped(self):\n   185\t        return self.ledger is not None and self.ledger.read().get('stopped')\n   186\t\n   187\t    def run(self, items):\n   188\t        \"\"\"[47f.1] Every first attempt (the scored ones) is sent before any retry (diagnostic only), so a retry's cost or failure can\n   189\t        never stop a scored attempt from being sent.\"\"\"\n   190\t        try:\n   191\t            refused = []\n   192\t            for draw in DRAWS:\n   193\t                for it in items:\n   194\t                    if not self.stopped():\n   195\t                        first = self.attempt(it, draw, it['user'], 1)\n   196\t                        if first['decision'] == 'refused':\n   197\t                            refused.append((it, draw, first))\n   198\t            for it, draw, first in refused:\n   199\t                if not self.stopped():\n   200\t                    reasons = '; '.join(f'{c}: {d}' for c, d in first.get('errors', []))[:4000]\n   201\t                    self.attempt(it, draw, it['user'] + RETRY_MARK + reasons, 2)\n   202\t        finally:                                          # [47b.2] the results come from the attempt records, written even after an abort\n   203\t            summary = summarise(self.out, items, self.ledger.read() if self.ledger else None)\n   204\t        return summary\n   205\t\n   206\t\n   207\tJOURNALS = ('answers.jsonl', 'retries.jsonl')\n   208\t\n   209\t\n   210\tdef attempt_records(out, damaged=None):\n   211\t    \"\"\"The committed entries of both journals, split on the writer's own delimiter ('\\\\n' only: an answer may hold other Unicode line\n   212\t    separators). A line that does not parse (a write torn by a crash) is skipped and listed in `damaged` with its journal, so its\n   213\t    attempt counts as unfinished.\"\"\"\n   214\t    records = []\n   215\t    for name in JOURNALS:\n   216\t        path = out / name\n   217\t        text = path.read_text(encoding='utf-8', errors='replace') if path.exists() else ''\n   218\t        for number, line in enumerate(text.split('\\n'), 1):\n   219\t            if not line:\n   220\t                continue\n   221\t            try:\n   222\t                records.append(json.loads(line))\n   223\t            except json.JSONDecodeError:\n   224\t                if damaged is not None:\n   225\t                    damaged.append({'journal': name, 'line': number, 'text': line[:200]})\n   226\t    return records\n   227\t\n   228\t\n   229\tATTEMPT_FIELDS = ('attempt', 'status', 'decision', 'errors', 'data', 'raw')\n   230\t\n   231\t\n   232\tdef first_attempt(entry):\n   233\t    \"\"\"[47e.1] The attempt that is scored: the first one, on both arms (a retry is diagnostic). No attempt: not sent.\"\"\"\n   234\t    attempts = sorted(entry.get('attempts') or [], key=lambda a: a['attempt'])\n   235\t    return attempts[0] if attempts else {'attempt': 1, 'status': 'not sent', 'decision': 'not sent'}\n   236\t\n   237\t\n   238\tdef derive_finals(out, items, damaged=None):\n   239\t    \"\"\"Each planned unit and draw: 'dispatched' (a started line), 'completed' (a finished line), and the decision of its last finished\n   240\t    attempt (a second refusal is unresolved). A unit with no started line is not sent; one started but not finished is interrupted.\"\"\"\n   241\t    records = attempt_records(out, damaged)\n   242\t    finals = {}\n   243\t    for it in items:\n   244\t        for draw in DRAWS:\n   245\t            mine = [r for r in records if r['unit'] == it['unit'] and r['arm'] == it['arm'] and r['draw'] == draw]\n   246\t            started = [r for r in mine if r['status'] == 'started']\n   247\t            done = [r for r in mine if r['status'] != 'started']\n   248\t            key = f'{it[\"unit\"]}|{it[\"arm\"]}|{draw}'\n   249\t            if not started:\n   250\t                finals[key] = {'decision': 'not sent', 'attempts': []}\n   251\t                continue\n   252\t            if len(done) < len(started):\n   253\t                unfinished = [{'attempt': r['attempt'], 'status': 'interrupted', 'decision': 'interrupted'} for r in started\n   254\t                              if r['attempt'] not in {d['attempt'] for d in done}]\n   255\t                finals[key] = {'decision': 'interrupted', 'attempts': [{k: r.get(k) for k in ATTEMPT_FIELDS} for r in done] + unfinished}\n   256\t                continue\n   257\t            last = done[-1]\n   258\t            decision = last['decision']\n   259\t            if decision == 'refused':                          # a second refusal is unresolved; a first with no retry sent is incomplete\n   260\t                decision = 'unresolved' if len(done) >= 2 else 'retry not sent'\n   261\t            finals[key] = {k: last.get(k) for k in ('status', 'data', 'errors', 'recorded', 'published')}\n   262\t            finals[key].update(decision=decision, attempts=[{k: r.get(k) for k in ATTEMPT_FIELDS} for r in done])\n   263\t    return finals\n   264\t\n   265\t\n   266\tdef summarise(out, items, ledger_state):\n   267\t    damaged = []\n   268\t    finals = derive_finals(out, items, damaged)\n   269\t    reconciled = {}\n   270\t    for draw_store, total, dc in PAIRS:                     # the separate arm, reconciled over the pair's family\n   271\t        for draw in DRAWS:\n   272\t            a, b = (first_attempt(finals.get(f'pair-{draw_store}|separate-{m[0]}|{draw}', {})) for m in (total, dc))   # [47e.1]\n   273\t            if a.get('decision') != 'publish' or b.get('decision') != 'publish':\n   274\t                reconciled[f'pair-{draw_store}|{draw}'] = {'decision': 'not reconciled', 'members': [a.get('decision'), b.get('decision')]}\n   275\t                continue\n   276\t            family = pair_family(draw_store, total, dc)\n   277\t            merged = merge([(total[0], strip(a['data'])), (dc[0], strip(b['data']))], {cc._key(s) for s in family['shared']})\n   278\t            pas = next(i['passages'] for i in items if i['unit'] == f'pair-{draw_store}' and i['arm'] == 'joint')\n   279\t            result = cc.check(family, pas, {k: merged[k] for k in ('figures', 'answers')})\n   280\t            reconciled[f'pair-{draw_store}|{draw}'] = {'decision': cc.publish_decision(family, merged, result), 'errors': result['errors'],\n   281\t                                                     'published': result.get('published'), 'calc': merged}\n   282\t    summary = {'finals': finals, 'reconciled': reconciled, 'ledger': ledger_state, 'damaged': damaged}\n   283\t    (out / 'results.json').write_text(json.dumps(summary, indent=1, ensure_ascii=False))\n   284\t    return summary\n   285\t\n   286\t\n   287\tdef _same_value(a, b):\n   288\t    \"\"\"Two recomputed (interval, bound) values are the same when their bounds match and each end agrees within 1e-9 relative.\"\"\"\n   289\t    if a is None or b is None or a[1] != b[1]:\n   290\t        return False\n   291\t    return all(abs(x - y) <= 1e-9 * max(1.0, abs(x), abs(y)) for x, y in zip(a[0], b[0]))\n   292\t\n   293\t\n   294\tdef merge(parts, shared_keys):\n   295\t    \"\"\"Two separate answers as one calculation: each figure id prefixed by its member; then [47.1, 47c.1] a forecast of a declared\n   296\t    shared quantity in the second call is unified with the first call's forecast of the same quantity and scenario when their\n   297\t    recomputed values are the same (references point to the first, the duplicate kept beside the calculation). Duplicates inside one\n   298\t    call are never unified, and forecasts that differ are both kept, so the family's checks judge them as they judge a joint answer.\"\"\"\n   299\t    figures, answers, recomputed, owner, units = [], [], {}, {}, {}\n   300\t    for view_id, calc in parts:\n   301\t        rename = {f['id']: f'{view_id}.{f[\"id\"]}' for f in calc['figures']}\n   302\t        figs = {f['id']: f for f in calc['figures']}\n   303\t        refs = lambda f, figs=figs: list(f.get('inputs', [])) + [r for r in f.get('rests_on', []) if r in figs] + \\\n   304\t            ([f['adjusts']['figure']] if f.get('adjusts') else []) + ([f['bridge']] if f.get('bridge') else [])\n   305\t        try:\n   306\t            values = cc._evaluate_bounded(figs, refs, {})\n   307\t        except Exception:\n   308\t            values = {}\n   309\t        for f in calc['figures']:\n   310\t            g = dict(f, id=rename[f['id']])\n   311\t            for key in ('inputs', 'rests_on', 'converts'):\n   312\t                if key in g:\n   313\t                    g[key] = [rename.get(x, x) for x in g[key]]\n   314\t            for key in ('disputed', 'bridge'):\n   315\t                if key in g:\n   316\t                    g[key] = rename.get(g[key], g[key])\n   317\t            if 'adjusts' in g:\n   318\t                g['adjusts'] = dict(g['adjusts'], figure=rename.get(g['adjusts']['figure'], g['adjusts']['figure']))\n   319\t            figures.append(g)\n   320\t            recomputed[g['id']] = values.get(f['id'])\n   321\t            owner[g['id']] = view_id\n   322\t            units[g['id']] = f.get('unit')\n   323\t        for a in calc['answers']:\n   324\t            a2 = dict(a)\n   325\t            if 'outcome' in a2:\n   326\t                a2['outcome'] = rename.get(a2['outcome'], a2['outcome'])\n   327\t            if a2.get('reference', {}).get('figure'):\n   328\t                a2['reference'] = {'figure': rename.get(a2['reference']['figure'], a2['reference']['figure'])}\n   329\t            answers.append(a2)\n   330\t    key = lambda f: (f['what']['population'], f['what']['measure'], f['what']['scope'], f['what']['period'], f.get('scenario', 'base'))\n   331\t    candidates = {}\n   332\t    for g in figures:\n   333\t        if g.get('basis') == 'forecast' and cc._key(g['what']) in shared_keys:\n   334\t            candidates.setdefault(key(g), {}).setdefault(owner[g['id']], []).append(g['id'])\n   335\t    alias, duplicates = {}, []\n   336\t    for k, by_call in candidates.items():                  # [47d.2] one to one: each call holds exactly one candidate\n   337\t        if len(by_call) == 2 and all(len(ids) == 1 for ids in by_call.values()):\n   338\t            (a,), (b,) = (by_call[v] for v, _ in parts)\n   339\t            if units[a] == units[b] and _same_value(recomputed.get(a), recomputed.get(b)):   # [47b.1] equal values, [47e.2] in one unit\n   340\t                alias[b] = a\n   341\t    if alias:\n   342\t        kept = []\n   343\t        for g in figures:\n   344\t            if g['id'] in alias:\n   345\t                duplicates.append(g)\n   346\t                continue\n   347\t            for k2 in ('inputs', 'rests_on', 'converts'):\n   348\t                if k2 in g:\n   349\t                    g[k2] = [alias.get(x, x) for x in g[k2]]\n   350\t            for k2 in ('disputed', 'bridge'):\n   351\t                if k2 in g:\n   352\t                    g[k2] = alias.get(g[k2], g[k2])\n   353\t            if 'adjusts' in g:\n   354\t                g['adjusts'] = dict(g['adjusts'], figure=alias.get(g['adjusts']['figure'], g['adjusts']['figure']))\n   355\t            kept.append(g)\n   356\t        figures = kept\n   357\t        for a in answers:\n   358\t            if a.get('outcome') in alias:\n   359\t                a['outcome'] = alias[a['outcome']]\n   360\t            if a.get('reference', {}).get('figure') in alias:\n   361\t                a['reference'] = {'figure': alias[a['reference']['figure']]}\n   362\t    return {'figures': figures, 'answers': answers, 'unified': [{'kept': alias[d['id']], 'duplicate': d} for d in duplicates]}\n   363\t\n   364\t\n   365\tdef recover(out):\n   366\t    \"\"\"Read-only: rebuild results.json from the journal of a stopped run; nothing is sent.\"\"\"\n   367\t    items = json.loads((out / 'plan.json').read_text())\n   368\t    ledger = json.loads((out / 'ledger.json').read_text()) if (out / 'ledger.json').exists() else None\n   369\t    summary = summarise(out, items, ledger)\n   370\t    print(json.dumps({'damaged': summary['damaged'], 'finals': {k: v['decision'] for k, v in summary['finals'].items()}}, indent=1))\n   371\t    return summary\n   372\t\n   373\t\n   374\tdef budget_module():\n   375\t    import importlib.util\n   376\t    spec = importlib.util.spec_from_file_location('budget_replay_v13', REPO / 'clean-arch/e2e-comparison-2026-11-13/budget_replay.py')\n   377\t    module = importlib.util.module_from_spec(spec)\n   378\t    spec.loader.exec_module(module)\n   379\t    return module\n   380\t\n   381\t\n   382\tdef send(out, approved, plan_path):\n   383\t    if APPROVED_CEILING is None or approved != APPROVED_CEILING:\n   384\t        raise SystemExit(f'the approved ceiling is {APPROVED_CEILING} (Alex names it); refused')\n   385\t    if out.exists():\n   386\t        raise SystemExit(f'{out} exists: the gate starts from an empty folder')\n   387\t    text = Path(plan_path).read_text()\n   388\t    if hashlib.sha256(text.encode()).hexdigest() != PINNED_PLAN_SHA256:          # [47.2] only the reviewed plan\n   389\t        raise SystemExit('the plan is not the reviewed one (sha256 differs); refused')\n   390\t    AUTH.parent.mkdir(parents=True, exist_ok=True)\n   391\t    try:                                                                     # [47.2] one authorization, one ledger, one launch\n   392\t        with open(AUTH, 'x') as handle:\n   393\t            json.dump({'plan_sha256': PINNED_PLAN_SHA256, 'ceiling': approved, 'out': str(out)}, handle)\n   394\t    except FileExistsError:\n   395\t        raise SystemExit(f'{AUTH} exists: this authorization was already used; refused')\n   396\t    items = json.loads(text)\n   397\t    if len({(i['unit'], i['arm']) for i in items}) != len(items):\n   398\t        raise SystemExit('duplicate (unit, arm) in the plan; refused')\n   399\t    out.mkdir(parents=True)\n   400\t    (out / 'plan.json').write_text(json.dumps(items))\n   401\t    budget = budget_module()\n   402\t    budget.SharedLedger.init(str(out / 'ledger.json'), approved)\n   403\t    ledger = budget.SharedLedger(str(out / 'ledger.json'))\n   404\t    lock_handle = open(out / 'gate.launcher.lock', 'a+')\n   405\t    if not ledger.claim_launcher('v13-gate', lock_handle):\n   406\t        raise SystemExit('another launch is running')\n   407\t    remove_gate = budget.install_stop_gate(ledger)\n   408\t    try:\n   409\t        summary = Gate(out, budget.BudgetTransport(ledger), ledger).run(items)\n   410\t    finally:\n   411\t        remove_gate()\n   412\t        ledger.remove_launcher('v13-gate')\n   413\t    print(json.dumps({k: v.get('decision') for k, v in summary['finals'].items()}, indent=1))\n   414\t\n   415\t\n   416\t# ---------- blind reading ----------\n   417\tQUESTIONS = {'usable': 'the outcome is usable and supported by the shown passages it rests on',\n   418\t             'contradiction': 'with the other card of its packet, it states a hard numerical contradiction',\n   419\t             'internal_reference': \"the system's own forecast is presented as the market's expectation\",\n   420\t             'deciding_gap': 'an unresolved overlap, a change of scope or an unsized adjustment decides its band'}\n   421\t\n   422\t\n   423\tdef normalise(calc, prefix=''):\n   424\t    \"\"\"Figure ids renumbered F1.. (after `prefix`) and member prefixes removed, so the arm cannot be read from the ids.\"\"\"\n   425\t    rename = {f['id']: f'{prefix}F{n}' for n, f in enumerate(calc['figures'], 1)}\n   426\t    out = []\n   427\t    for f in calc['figures']:\n   428\t        g = dict(f, id=rename[f['id']])\n   429\t        for key in ('inputs', 'rests_on', 'converts'):\n   430\t            if key in g:\n   431\t                g[key] = [rename.get(x, x) for x in g[key]]\n   432\t        for key in ('disputed', 'bridge'):\n   433\t            if key in g:\n   434\t                g[key] = rename.get(g[key], g[key])\n   435\t        if 'adjusts' in g:\n   436\t            g['adjusts'] = dict(g['adjusts'], figure=rename.get(g['adjusts']['figure'], g['adjusts']['figure']))\n   437\t        out.append(g)\n   438\t    answers = []\n   439\t    for a in calc['answers']:\n   440\t        a2 = dict(a)\n   441\t        if 'outcome' in a2:\n   442\t            a2['outcome'] = rename.get(a2['outcome'], a2['outcome'])\n   443\t        if (a2.get('reference') or {}).get('figure'):\n   444\t            a2['reference'] = {'figure': rename.get(a2['reference']['figure'], a2['reference']['figure'])}\n   445\t        answers.append(a2)\n   446\t    return {'figures': out, 'answers': answers}, rename\n   447\t\n   448\t\n   449\tdef run_digest(out):\n   450\t    h = hashlib.sha256()\n   451\t    for name in ('answers.jsonl', 'retries.jsonl', 'results.json', 'plan.json'):\n   452\t        path = out / name\n   453\t        h.update(name.encode() + b'\\0' + (path.read_bytes() if path.exists() else b''))\n   454\t    return h.hexdigest()\n   455\t\n   456\t\n   457\tdef card_view(calc, view_id, recorded, prefix=''):\n   458\t    \"\"\"[47b.3] One card as its own derivation: the figures its outcome and reference rest on, renumbered F1.. (after `prefix`) for this\n   459\t    card alone, and the recorded assumptions about its outcome or its own figures mapped to the same numbers.\"\"\"\n   460\t    figs = {f['id']: f for f in calc['figures']}\n   461\t    refs = lambda f: list(f.get('inputs', [])) + [r for r in f.get('rests_on', []) if r in figs] + \\\n   462\t        ([f['adjusts']['figure']] if f.get('adjusts') else []) + ([f['bridge']] if f.get('bridge') else [])\n   463\t    ans = next(a for a in calc['answers'] if a['view_id'] == view_id)\n   464\t    own = set()\n   465\t    for start in (ans.get('outcome'), (ans.get('reference') or {}).get('figure')):\n   466\t        if start in figs:\n   467\t            own |= cc._upstream_of(start, figs, refs) | {start}\n   468\t    sub = {'figures': [f for f in calc['figures'] if f['id'] in own], 'answers': [ans]}\n   469\t    norm, rename = normalise(sub, prefix)\n   470\t    mapped = []\n   471\t    for r in recorded:                                    # an assumption about this card's outcome, or about one of its own figures\n   472\t        named = [r[k] for k in ('figure', 'bridge') if isinstance(r.get(k), str)]\n   473\t        if (r.get('outcome') == view_id or any(n in rename for n in named)) and all(n in rename for n in named):\n   474\t            mapped.append({k: rename[v] if k in ('figure', 'bridge') else v for k, v in r.items()})\n   475\t    return norm, mapped, sorted({f['evidence'] for f in sub['figures'] if f.get('evidence')} | set(ans.get('cites', []))\n   476\t                                | {x for f in sub['figures'] for x in f.get('rests_on', []) if str(x).startswith('e')})\n   477\t\n   478\t\n   479\tNO_ANSWER = {'not sent': 'No request was sent for this card.', 'interrupted': 'The request was started; no answer was recorded.',\n   480\t             'transport': 'No answer arrived.', 'retry not sent': 'The answer was refused and its retry was not sent.'}\n   481\tFORMAT_INVALID = 'The answer did not match the required format.'\n   482\t\n   483\t\n   484\tdef packet_units(results, items):\n   485\t    \"\"\"Every packet the run gives, as (unit, arm, draw) -> (decision, per-card source): the joint and singleton answers from the finals,\n   486\t    the separate arm's reconciled pairs with each card's own separate answer.\"\"\"\n   487\t    units = {}\n   488\t    for key, entry in results['finals'].items():\n   489\t        unit, arm, draw = key.split('|')\n   490\t        if not arm.startswith('separate-'):\n   491\t            first = first_attempt(entry)                    # [47e.1] the first attempt is scored on both arms\n   492\t            units[(unit, arm, draw)] = (first.get('decision'), {v: first for v in items[(unit, arm)]['members']})\n   493\t    for key, entry in results['reconciled'].items():\n   494\t        unit, draw = key.split('|')\n   495\t        per_card = {a.split('-', 1)[1]: first_attempt(results['finals'].get(f'{unit}|{a}|{draw}', {})) for (u, a) in items\n   496\t                    if u == unit and a.startswith('separate-')}\n   497\t        units[(unit, 'separate', draw)] = (entry.get('decision'), per_card)\n   498\t    return units\n   499\t\n   500\t\n   501\tdef card_lines(base, fam, v, token, data, final_label, prefix=''):\n   502\t    \"\"\"One card's answer as a reader sees it: the passages it names, its own figures, its recomputed outcome and assumptions, the card.\n   503\t    Returns (lines, ids a ground may name).\"\"\"\n   504\t    if not data:\n   505\t        return [f'  {final_label}'], set()\n   506\t    calc = strip(data)\n   507\t    try:\n   508\t        checked = cc.check(fam, base['passages'], calc)\n   509\t    except Exception as error:\n   510\t        checked = {'errors': [('checker', str(error))], 'recorded': [], 'published': {}}\n   511\t    try:\n   512\t        norm, recorded, named = card_view(calc, v, checked.get('recorded', []), prefix)\n   513\t    except StopIteration:\n   514\t        return ['  The answer has no card for this question.'], set()\n   515\t    lines = ['  Passages, as the request showed them:\\n' + '\\n'.join('  ' + base['shown'].get(e, f'- {e} (not shown)') for e in named),\n   516\t             '  Figures (declared):\\n' + '\\n'.join(f'  - {json.dumps(f, ensure_ascii=False)}' for f in norm['figures']),\n   517\t             '  Recomputed outcome: ' + json.dumps((checked.get('published') or {}).get(v)),\n   518\t             '  Recorded assumptions: ' + json.dumps(recorded),\n   519\t             f'  Card {token}: ' + json.dumps(norm['answers'][0], ensure_ascii=False)]\n   520\t    return lines, set(named) | {f['id'] for f in norm['figures']}\n   521\t\n   522\t\n   523\tdef packet_body(items, unit, arm, decision, per_card):\n   524\t    \"\"\"[47d.3, 47e.1] One scoring packet: each card's scored (first) answer only. No attempt history, no code decision and no check code,\n   525\t    which would tell separate calls from one joint call; the verdict applies the code's decision itself. Returns (lines, grounds, members).\"\"\"\n   526\t    base = items[(unit, 'joint' if unit.startswith('pair') else 'single')]\n   527\t    grounds, lines = set(), []\n   528\t    for number, v in enumerate(base['members'], 1):\n   529\t        q = base['questions'][v]\n   530\t        token = f'K{number}'\n   531\t        grounds.add(token)\n   532\t        lines.append(f'### Card {token}: {q[\"question\"]}\\n  Ladder: ' + ' / '.join(f'rung {i + 1}: {c}' for i, c in enumerate(q['ladder'])))\n   533\t        source = per_card.get(v, {})                         # the scored (first) attempt of this card\n   534\t        label = NO_ANSWER.get(source.get('decision'), FORMAT_INVALID if source.get('status') == 'format invalid' else NO_ANSWER['not sent'])\n   535\t        fam = base['family'] if arm != 'separate' else only(base['family'], v)\n   536\t        body, named = card_lines(base, fam, v, token, source.get('data'), label)\n   537\t        lines += body\n   538\t        grounds |= named\n   539\t    lines.append('For each card answer yes or no, each with a ground that names a card (K...), passage (e...) or figure (F...) of this packet: '\n   540\t                 + '; '.join(f'{k}: {t}' for k, t in QUESTIONS.items()) + '\\n')\n   541\t    return lines, sorted(grounds), base['members']\n   542\t\n   543\t\n   544\tdef key_commitment(key):\n   545\t    return hashlib.sha256(json.dumps(key, sort_keys=True).encode()).hexdigest()\n   546\t\n   547\t\n   548\tdef render_packets(out, key):\n   549\t    \"\"\"The scoring packets for a key {salt, run_digest, order}: the key's salted sha256 first (so the text the readers receive commits\n   550\t    to the mapping), then each packet in the key's order, rendered from the run's results and plan.\"\"\"\n   551\t    results = json.loads((out / 'results.json').read_text())\n   552\t    items = {(i['unit'], i['arm']): i for i in json.loads((out / 'plan.json').read_text())}\n   553\t    units = packet_units(results, items)\n   554\t    lines, rendered = [f'Key commitment: {key_commitment(key)}', ''], {}\n   555\t    for pid, unit_key in key['order']:\n   556\t        decision, per_card = units[tuple(unit_key)]\n   557\t        body, grounds, members = packet_body(items, unit_key[0], unit_key[1], decision, per_card)\n   558\t        lines += [f'## {pid}'] + body\n   559\t        rendered[pid] = {'unit': unit_key[0], 'arm': unit_key[1], 'draw': unit_key[2], 'decision': decision, 'grounds': grounds,\n   560\t                         'cards': {f'K{n}': v for n, v in enumerate(members, 1)}}\n   561\t    return '\\n'.join(lines), rendered, units\n   562\t\n   563\t\n   564\tdef returned_text(raw):\n   565\t    \"\"\"The model's text inside a stored provider response, or the stored response itself when it cannot be read.\"\"\"\n   566\t    if not raw:\n   567\t        return '(no text was stored)'\n   568\t    try:\n   569\t        message = json.loads(raw)['choices'][0]['message']\n   570\t    except (ValueError, KeyError, IndexError, TypeError):\n   571\t        return str(raw)\n   572\t    if not isinstance(message, dict):\n   573\t        return str(raw)\n   574\t    if isinstance(message.get('content'), str):\n   575\t        return message['content']\n   576\t    if message.get('refusal'):\n   577\t        return f'(the model refused: {message[\"refusal\"]})'\n   578\t    return f'(no text returned: {json.dumps(message, ensure_ascii=False)})'\n   579\t\n   580\t\n   581\tdef render_attempts(out, labels):\n   582\t    \"\"\"[47d.3, 47e.3] For diagnostic reading only, never scored: every retry and every returned text that failed the format check, each\n   583\t    under its own shuffled label (D01..), with the question, that attempt's own answer (or the text returned and the passages it names),\n   584\t    and no link to a packet.\"\"\"\n   585\t    results = json.loads((out / 'results.json').read_text())\n   586\t    items = {(i['unit'], i['arm']): i for i in json.loads((out / 'plan.json').read_text())}\n   587\t    lines = []\n   588\t    for label, (unit, arm, draw, v, attempt) in labels:\n   589\t        entry = results['finals'][f'{unit}|{arm}|{draw}']\n   590\t        a = next(x for x in entry['attempts'] if x['attempt'] == attempt)\n   591\t        base = items[(unit, 'joint' if unit.startswith('pair') else 'single')]\n   592\t        fam = base['family'] if arm in ('joint', 'single') else only(base['family'], v)\n   593\t        lines.append(f'## {label}: {base[\"questions\"][v][\"question\"]}')\n   594\t        if a.get('status') == 'format invalid':\n   595\t            returned = returned_text(a.get('raw'))\n   596\t            named = sorted(set(re.findall(r'\\be\\d+\\b', returned)) & set(base['shown']))\n   597\t            lines.append(f'  {FORMAT_INVALID} The text returned:\\n' + '\\n'.join('    ' + l for l in returned.splitlines()))\n   598\t            if named:\n   599\t                lines.append('  Passages it names, as the request showed them:\\n' + '\\n'.join('  ' + base['shown'][e] for e in named))\n   600\t            continue\n   601\t        lines += card_lines(base, fam, v, 'K1', a.get('data'), NO_ANSWER.get(a.get('decision'), NO_ANSWER['transport']), 'T.')[0]\n   602\t    return '\\n'.join(lines)\n   603\t\n   604\t\n   605\tdef packets(out, key_dir):\n   606\t    if (key_dir / 'packet-key.json').exists():            # [47b.4] the inventory and key are frozen once made\n   607\t        raise SystemExit(f'{key_dir / \"packet-key.json\"} exists: the packets are frozen; refused')\n   608\t    results = json.loads((out / 'results.json').read_text())\n   609\t    items = {(i['unit'], i['arm']): i for i in json.loads((out / 'plan.json').read_text())}\n   610\t    rng = random.Random(secrets.randbits(64))\n   611\t    unit_keys = sorted(packet_units(results, items))\n   612\t    rng.shuffle(unit_keys)\n   613\t    earlier = sorted((k.split('|')[0], k.split('|')[1], k.split('|')[2], v, a['attempt'])     # every retry, and every format failure\n   614\t                     for k, e in results['finals'].items() for a in (e.get('attempts') or [])\n   615\t                     if a['attempt'] >= 2 or a.get('status') == 'format invalid'\n   616\t                     for v in items[tuple(k.split('|')[:2])]['members'])\n   617\t    rng.shuffle(earlier)\n   618\t    key = {'salt': secrets.token_hex(16), 'run_digest': run_digest(out), 'order': [(f'P{n:02d}', list(u)) for n, u in enumerate(unit_keys, 1)],\n   619\t           'attempts': [(f'D{n:02d}', list(e)) for n, e in enumerate(earlier, 1)]}\n   620\t    text = render_packets(out, key)[0]\n   621\t    attempts_text = render_attempts(out, key['attempts'])          # [47f.2] both rendered before anything is written\n   622\t    if (out / 'packets.md').exists() or (out / 'attempts.md').exists():\n   623\t        raise SystemExit(f'{out} already holds packets; refused')\n   624\t    key_dir.mkdir(parents=True, exist_ok=True)\n   625\t    with open(key_dir / 'packet-key.json', 'x') as handle:\n   626\t        json.dump(key, handle, indent=1)\n   627\t    with open(out / 'packets.md', 'x') as handle:\n   628\t        handle.write(text)\n   629\t    with open(out / 'attempts.md', 'x') as handle:\n   630\t        handle.write(attempts_text)\n   631\t    print(f'{len(key[\"order\"])} packets, {len(key[\"attempts\"])} diagnostic attempts; key in {key_dir}')\n   632\t\n   633\t\n   634\tdef _grounded(ground, grounds):\n   635\t    \"\"\"[47b.4] A ground is non-empty text that names at least one card, passage or figure of the packet.\"\"\"\n   636\t    return isinstance(ground, str) and ground.strip() != '' and any(re.search(rf'\\b{re.escape(g)}\\b', ground) for g in grounds)\n   637\t\n   638\t\n   639\tdef final_readings(pid, cards, members, grounds=()):\n   640\t    \"\"\"[47.4] Two independent readings per card (A, B), each question answered yes/no with its ground; a third decides each\n   641\t    disagreement. Returns ({card: {question: answer}}, problems).\"\"\"\n   642\t    problems, final = [], {}\n   643\t    if sorted(cards) != sorted(members):\n   644\t        return None, [f'{pid}: cards {sorted(cards)} are not the unit\\'s {sorted(members)}']\n   645\t    for v, r in cards.items():\n   646\t        final[v] = {}\n   647\t        for q in QUESTIONS:\n   648\t            a, b = (r.get(x, {}).get(q, {}) for x in ('A', 'B'))\n   649\t            for name, x in (('A', a), ('B', b)):\n   650\t                if x.get('answer') not in ('yes', 'no') or not _grounded(x.get('ground'), grounds):\n   651\t                    problems.append(f'{pid} {v} {q}: reader {name} gave no yes/no with a ground from this packet')\n   652\t            if a.get('answer') == b.get('answer'):\n   653\t                final[v][q] = a.get('answer')\n   654\t            else:\n   655\t                t = r.get('third', {}).get(q, {})\n   656\t                if t.get('answer') not in ('yes', 'no') or not _grounded(t.get('ground'), grounds):\n   657\t                    problems.append(f'{pid} {v} {q}: the readers disagree and no third reading decides')\n   658\t                final[v][q] = t.get('answer')\n   659\t    return final, problems\n   660\t\n   661\t\n   662\tdef verdict(out, readings_path, key_dir):\n   663\t    \"\"\"[47e.4] Seal the readings into the run (readings.json, created once), compute D725's lines once and write verdict.json bound to\n   664\t    the readings, the key and the packets. A second verdict on the run is refused; `replay` recomputes and compares.\"\"\"\n   665\t    if (out / 'verdict.json').exists() or (out / 'readings.json').exists():\n   666\t        raise SystemExit(f'{out} already has sealed readings or a verdict; refused (use replay)')\n   667\t    data = Path(readings_path).read_bytes()\n   668\t    with open(out / 'readings.json', 'xb') as handle:\n   669\t        handle.write(data)\n   670\t    summary = score(out, key_dir)\n   671\t    frozen = json.loads((key_dir / 'packet-key.json').read_text())\n   672\t    record = {'readings_sha256': hashlib.sha256(data).hexdigest(), 'key_commitment': key_commitment(frozen),\n   673\t              'packets_sha256': hashlib.sha256((out / 'packets.md').read_bytes()).hexdigest() if (out / 'packets.md').exists() else None,\n   674\t              'run_digest': run_digest(out), 'summary': summary}\n   675\t    with open(out / 'verdict.json', 'x') as handle:\n   676\t        json.dump(record, handle, indent=1)\n   677\t    return summary\n   678\t\n   679\t\n   680\tdef replay(out, key_dir):\n   681\t    \"\"\"Recompute the verdict from the sealed readings and compare it with verdict.json.\"\"\"\n   682\t    record = json.loads((out / 'verdict.json').read_text())\n   683\t    data = (out / 'readings.json').read_bytes()\n   684\t    same = (hashlib.sha256(data).hexdigest() == record['readings_sha256'] and record['run_digest'] == run_digest(out)\n   685\t            and record['key_commitment'] == key_commitment(json.loads((key_dir / 'packet-key.json').read_text())))\n   686\t    summary = score(out, key_dir)\n   687\t    matches = same and summary == record['summary']\n   688\t    print(json.dumps({'reproduced': matches}, indent=1))\n   689\t    return matches\n   690\t\n   691\t\n   692\tdef score(out, key_dir):\n   693\t    \"\"\"D725's registered lines on the sealed readings, bound to this run.\"\"\"\n   694\t    frozen = json.loads((key_dir / 'packet-key.json').read_text())\n   695\t    submitted = json.loads((out / 'readings.json').read_text())\n   696\t    problems = [] if frozen.get('run_digest') == run_digest(out) else ['the packet key does not belong to this run']   # [47b.4]\n   697\t    text, key, units = render_packets(out, frozen)                  # [47c.2] every packet rendered again from the run\n   698\t    if sorted(tuple(u) for _, u in frozen['order']) != sorted(units):\n   699\t        problems.append('the key does not map one packet to each unit of the run')\n   700\t    sha = hashlib.sha256(text.encode()).hexdigest()\n   701\t    packets_path = out / 'packets.md'\n   702\t    written = packets_path.read_text() if packets_path.exists() else ''\n   703\t    if not written.startswith(f'Key commitment: {key_commitment(frozen)}\\n'):      # [47d.1] the mapping the readers' text committed to\n   704\t        problems.append('the key is not the one packets.md committed to')\n   705\t    if hashlib.sha256(written.encode()).hexdigest() != sha:\n   706\t        problems.append('packets.md is not the text the run and the key give')\n   707\t    if submitted.get('packets_sha256') != sha:\n   708\t        problems.append('the readings were not made on the frozen packets')\n   709\t    readings = submitted.get('packets', {})\n   710\t    results = json.loads((out / 'results.json').read_text())\n   711\t    problems += [f'answers.jsonl line {d[\"line\"]} is damaged' for d in results.get('damaged', [])\n   712\t                 if d.get('journal') == 'answers.jsonl']                     # [47g] a damaged retry record stays diagnostic\n   713\t    scored = {k: first_attempt(v)['decision'] for k, v in results['finals'].items()}            # [47f.1] completeness from the scored attempts\n   714\t    problems += [f'{k}: {d}' for k, d in scored.items() if d not in ('publish', 'held', 'refused')]               # [47b.2] from the records\n   715\t    problems += [f'{pid}: not read' for pid in key if pid not in readings] + [f'{pid}: not a packet' for pid in readings if pid not in key]\n   716\t    usable_pairs = {'joint': {}, 'separate': {}}\n   717\t    defects = []\n   718\t    for pid, k in key.items():\n   719\t        if pid not in readings:\n   720\t            continue\n   721\t        final, probs = final_readings(pid, readings[pid], list(k['cards']), k['grounds'])\n   722\t        problems += probs\n   723\t        if final is None:\n   724\t            continue\n   725\t        if k['decision'] == 'publish' and k['arm'] in ('joint', 'single'):      # D725: defects across the joint and singleton answers\n   726\t            for v, r in final.items():\n   727\t                if 'yes' in (r['contradiction'], r['internal_reference'], r['deciding_gap']):\n   728\t                    defects.append((pid, k['unit'], k['arm'], k['cards'][v]))\n   729\t        if k['unit'].startswith('pair') and k['arm'] in usable_pairs:\n   730\t            usable_pairs[k['arm']].setdefault(k['unit'], []).append(k['decision'] == 'publish' and all(r['usable'] == 'yes' for r in final.values()))\n   731\t    joint_total = sum(sum(v) for v in usable_pairs['joint'].values())\n   732\t    separate_total = sum(sum(v) for v in usable_pairs['separate'].values())\n   733\t    per_snapshot = {u: sum(v) for u, v in usable_pairs['joint'].items()}\n   734\t    complete = (not problems and len(key) == 27 and len(usable_pairs['joint']) == 3 and len(usable_pairs['separate']) == 3\n   735\t                and all(len(v) == 3 for arm in usable_pairs.values() for v in arm.values()))\n   736\t    passes = complete and not defects and joint_total >= 8 and all(n >= 2 for n in per_snapshot.values()) and joint_total - separate_total >= 3\n   737\t    summary = {'complete': complete, 'problems': problems[:20], 'joint usable pairs': joint_total, 'separate usable pairs': separate_total,\n   738\t               'joint per snapshot': per_snapshot, 'published defects': defects,\n   739\t               'verdict': 'PASS' if passes else ('INCOMPLETE' if not complete else 'STOP')}\n   740\t    print(json.dumps(summary, indent=1))\n   741\t    return summary\n   742\t\n   743\t\n   744\tif __name__ == '__main__':\n   745\t    cmd = sys.argv[1] if len(sys.argv) > 1 else ''\n   746\t    if cmd == 'plan' and len(sys.argv) == 3:\n   747\t        plan(sys.argv[2])\n   748\t    elif cmd == 'send' and len(sys.argv) == 5 and not sys.argv[2].startswith('-'):\n   749\t        send(Path(sys.argv[2]), float(sys.argv[3]), sys.argv[4])\n   750\t    elif cmd == 'packets' and len(sys.argv) == 4:\n   751\t        packets(Path(sys.argv[2]), Path(sys.argv[3]))\n   752\t    elif cmd == 'recover' and len(sys.argv) == 3:\n   753\t        recover(Path(sys.argv[2]))\n   754\t    elif cmd == 'verdict' and len(sys.argv) == 5:\n   755\t        verdict(Path(sys.argv[2]), sys.argv[3], Path(sys.argv[4]))\n   756\t    elif cmd == 'replay' and len(sys.argv) == 4:\n   757\t        replay(Path(sys.argv[2]), Path(sys.argv[3]))\n   758\t    else:\n   759\t        raise SystemExit(__doc__)\n","exit_code":0,"status":"completed"}}
