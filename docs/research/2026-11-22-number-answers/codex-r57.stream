{"type":"item.completed","item":{"id":"item_36","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"cd docs/research/2026-11-22-number-answers && nl -ba small_cases.py | sed -n '210,225p;655,693p'; nl -ba calc_small.py | sed -n '594,661p;764,810p'\"","aggregated_output":"   210\t    figs = [F('S', W('four companies', 'CY2026', measure='capex'), 'source', 'reported', 'USD bn', value=1200.0, evidence_id='e13', quote_number='$1.2 trillion', qualifier='none'),\n   211\t            F('O', W('four companies', 'CY2026', measure='capex'), 'estimate', 'forecast', 'USD bn', value=1250.0, basis_text='x', rests_on=['S'], outcome_for=['s'])]\n   212\t    return one(figs, family=single(W('four companies', 'CY2026', measure='capex'), ((1000.0, 1500.0),)))\n   213\t\n   214\t\n   215\t@case('A1', 'a range outcome overlapping its rung', 'pass')\n   216\tdef _():\n   217\t    figs = [F('O', W('company', 'FY2027'), 'estimate', 'forecast', 'USD bn', low=380.0, high=400.0, basis_text='a range', outcome_for=['s'])]\n   218\t    return one(figs, rung=2, family=single(W('company', 'FY2027'), ((400.0, None), (350.0, 400.0))))\n   219\t\n   220\t\n   221\t@case('A1', 'one figure marked for two members', 'pass')\n   222\tdef _():\n   223\t    fam = {'members': {'a': {'what': W('company', 'FY2027'), 'unit': 'USD bn', 'bands': [[None, None]]},\n   224\t                       'b': {'what': W('company', 'FY2027'), 'unit': 'USD bn', 'bands': [[None, None]]}},\n   225\t           'relations': [], 'shared': [], 'compare_periods': [], 'part_scopes': []}\n   655\tluna('prose in inputs', 'S7', lambda a: fig(a, 'F6').update(inputs=['Q1 revenue', 'F2', 'F4', 'F5']))\n   656\tluna('an outcome in \"USD trillion\"', 'schema', lambda a: fig(a, 'F6').update(unit='USD trillion'))\n   657\tluna('\"65% growth in Q4\" copied as the number', 'S1', lambda a: a['figures'].append(F(\n   658\t    'G', W('company', 'FY2027 Q4', measure='growth'), 'source', 'third_party', '%', value=65.0, evidence_id='e8', quote_number='65% growth in Q4',\n   659\t    qualifier='none')))\n   660\t\n   661\t\n   662\tdef main():\n   663\t    failures = 0\n   664\t    for group, name, expect, recorded, build in CASES:\n   665\t        answer, family = build()\n   666\t        result = run(copy.deepcopy(answer), family)\n   667\t        if 'schema' in result:\n   668\t            got = 'schema'\n   669\t            detail = result['schema'][:1]\n   670\t        else:\n   671\t            codes = sorted({c for c, _ in result['errors']})\n   672\t            got = 'pass' if not codes else ','.join(codes)\n   673\t            detail = result['errors'][:2]\n   674\t        ok = got == expect                               # [54] exactly the registered rule(s): no other refusal may stand in for it\n   675\t        if ok and name in MESSAGES and not any(MESSAGES[name] in d for _, d in result.get('errors', [])):\n   676\t            ok, detail = False, [f'the refusal does not say \"{MESSAGES[name]}\"'] + list(result.get('errors', []))[:2]\n   677\t        if ok and recorded:\n   678\t            ok = any(r['type'] == recorded for r in result.get('recorded', []))\n   679\t            if not ok:\n   680\t                detail = [f'missing recorded {recorded}: {[r[\"type\"] for r in result.get(\"recorded\", [])]}']\n   681\t        failures += not ok\n   682\t        print(f'{\"PASS\" if ok else \"FAIL\"}  {group}  {name}  [expected {expect}{\" + recorded \" + recorded if recorded else \"\"}; got {got}]'\n   683\t              + ('' if ok else f'  {json.dumps(detail, ensure_ascii=False)[:400]}'))\n   684\t    print(f'{len(CASES) - failures} of {len(CASES)} cases as registered')\n   685\t    return 1 if failures else 0\n   686\t\n   687\t\n   688\tif __name__ == '__main__':\n   689\t    raise SystemExit(main())\n   594\tdef _adopted(outcomes, figs):\n   595\t    \"\"\"[54] The figures the outcomes adopt: each reached from an outcome (inputs and rests_on) with no figure of its own quantity and\n   596\t    period between them. A figure beneath another of its own quantity and period (a point a final range rests on) is its basis, not a\n   597\t    second value.\"\"\"\n   598\t    tops, seen_ids = set(), set()\n   599\t\n   600\t    def walk(fid, keys):\n   601\t        if fid not in figs or (fid, keys) in seen_ids:\n   602\t            return\n   603\t        seen_ids.add((fid, keys))\n   604\t        f = figs[fid]\n   605\t        k = _key(f['what'])\n   606\t        if k not in keys:\n   607\t            tops.add(fid)\n   608\t        for r in list(f.get('inputs') or []) + [r for r in f.get('rests_on') or [] if r in figs]:\n   609\t            walk(r, keys | {k})\n   610\t    for out in outcomes.values():\n   611\t        walk(out, frozenset())\n   612\t    return tops\n   613\t\n   614\t\n   615\tdef _shared(family, figs, outcomes):\n   616\t    errors = []\n   617\t    by_key = {}\n   618\t    for fid in _adopted(outcomes, figs):                   # [54] forecasts the outcomes adopt; an unused alternative is not counted\n   619\t        if figs[fid]['basis'] == 'forecast':\n   620\t            by_key.setdefault(_key(figs[fid]['what']), []).append(fid)\n   621\t    nodes = {}\n   622\t    for fid, f in figs.items():\n   623\t        if f['basis'] == 'forecast':\n   624\t            nodes.setdefault(_key(f['what']), []).append(fid)\n   625\t    for k, ids in sorted(by_key.items()):\n   626\t        if len(ids) > 1:\n   627\t            errors.append(('S4', f'{\" | \".join(k)}: {len(ids)} forecasts ({\", \".join(sorted(ids))}); compute it once and use that figure'))\n   628\t    for want in family.get('shared', []):\n   629\t        key = _key(want)\n   630\t        node = by_key.get(key) or nodes.get(key, [])\n   631\t        for v, out in sorted(outcomes.items()):\n   632\t            reached, stack, seen_ids = [], [out], set()\n   633\t            while stack:\n   634\t                fid = stack.pop()\n   635\t                if fid in seen_ids or fid not in figs:\n   636\t                    continue\n   637\t                seen_ids.add(fid)\n   638\t                f = figs[fid]\n   639\t                if _key(f['what']) == key:\n   640\t                    reached.append(fid)\n   641\t                    if f['basis'] == 'forecast':\n   642\t                        continue                           # through the forecast figure: what lies beneath it is its basis\n   643\t                stack.extend(f.get('inputs') or [])\n   644\t            if not reached:\n   645\t                continue\n   646\t            if len(node) != 1:\n   647\t                errors.append(('S4', f'{v}: uses {\" | \".join(key)} but the calculation has {len(node)} forecast figures for it'))\n   648\t                continue\n   649\t            bypass = sorted(r for r in reached if r != node[0])      # the walk never descends below the forecast figure\n   650\t            if bypass:\n   651\t                errors.append(('S4', f'{v}: uses {\", \".join(bypass)} for {\" | \".join(key)} beside its forecast figure {node[0]}'))\n   652\t    return errors\n   653\t\n   654\t\n   655\tdef _part_whole(family, figs, calc, outcomes):\n   656\t    errors = []\n   657\t    members = family['members']\n   658\t    for rel in family.get('relations', []):\n   659\t        if rel.get('type') != 'part_of' or rel['part'] not in outcomes or rel['whole'] not in outcomes:\n   660\t            continue\n   661\t        p_what, w_what = members[rel['part']]['what'], members[rel['whole']]['what']\n   764\tdef check(family, passages, calc):\n   765\t    figs = {f['id']: f for f in calc['figures'] if isinstance(f.get('id'), str)}\n   766\t    errors = _structure(family, passages, calc, figs)\n   767\t    if errors:\n   768\t        return {'errors': errors, 'recorded': [], 'published': {}}\n   769\t    engine = _Calc(figs)\n   770\t    errors = _sources(passages, figs) + _arithmetic(figs, engine)\n   771\t    for f in figs.values():\n   772\t        if engine.interval(f['id']) is None and not any(e[1].startswith(f['id'] + ':') for e in errors):\n   773\t            errors.append(('S2', f'{f[\"id\"]}: the value cannot be evaluated'))\n   774\t    if errors:\n   775\t        return {'errors': errors, 'recorded': [], 'published': {}}\n   776\t    answer_errors, outcomes = _answers(family, figs, engine, calc['answers'])\n   777\t    errors = answer_errors + _shared(family, figs, outcomes) + _part_whole(family, figs, engine, outcomes) + _sums(family, figs)\n   778\t    published = {v: list(engine.interval(o)) + [None] for v, o in outcomes.items()}\n   779\t    return {'errors': errors, 'recorded': _recorded(family, figs, outcomes), 'published': published}\n   780\t\n   781\t\n   782\tdef publish_decision(family, calc, result):\n   783\t    \"\"\"'refused' when a check fails; 'held' when a member is unresolved and a declared relation joins it to another member; else\n   784\t    'publish' (an unresolved member is shown as unresolved).\"\"\"\n   785\t    if result['errors']:\n   786\t        return 'refused'\n   787\t    unresolved = {a['view_id'] for a in calc['answers'] if a.get('shape') == 'unresolved'}\n   788\t    for rel in family.get('relations', []):\n   789\t        ends = {rel.get('part'), rel.get('whole'), rel.get('later'), rel.get('earlier')} - {None}\n   790\t        if ends & unresolved and ends - unresolved:\n   791\t            return 'held'\n   792\t    return 'publish'\n","exit_code":0,"status":"completed"}}
