== 'computed' and fig.get('operation') in OPERATIONS:\n   461\t            (lo_r, hi_r), b_r = recomputed[fid]\n   462\t            canon = {k: v for k, v in fig.items() if k not in ('value', 'low', 'high', 'bound')}\n   463\t            canon.update({'value': lo_r} if lo_r == hi_r else {'low': lo_r, 'high': hi_r})\n   464\t            if b_r:\n   465\t                canon['bound'] = b_r\n   466\t            figs[fid] = canon\n   467\t\n   468\t    # answers: C7 coverage and ownership, C6 rung, C5 reference\n   469\t    members = family['members']\n   470\t    seen = {}\n   471\t    for ans in calc['answers']:\n   472\t        seen[ans['view_id']] = seen.get(ans['view_id'], 0) + 1\n   473\t    for view_id in members:\n   474\t        if seen.get(view_id, 0) != 1:\n   475\t            errors.append(('C7', f'{view_id} has {seen.get(view_id, 0)} answers; exactly one is required'))\n   476\t    for view_id in seen:\n   650\t        if ans_prior.get('day') != ptr.get('day') or not any(_same(fig.get('value'), v) for v in ans_prior.get('values', [])):\n   651\t            errors.append(('C10', f'{fig[\"id\"]}: no earlier answer of {ptr.get(\"view\")} on {ptr.get(\"day\")} shown in the request states {fig.get(\"value\")}'))\n   652\t        owners = [a['view_id'] for a in calc['answers'] if a.get('outcome') == fig['id']]\n   653\t        if owners:                                    # [46h.2] nor the current outcome\n   654\t            errors.append(('C10', f'{fig[\"id\"]}: an earlier forecast cannot be the current outcome of {\", \".join(owners)}'))\n   655\t        users = [f['id'] for f in figs.values() if fig['id'] in refs(f)]\n   656\t        if users:\n   657\t            errors.append(('C10', f'{fig[\"id\"]}: an earlier forecast is for comparison only and cannot feed {\", \".join(users)}'))\n   658\t\n   659\t    recorded += _assumptions(family, figs, outcomes, calc, refs)\n   660\t    finite = lambda v: v if abs(v) != float('inf') else None\n   661\t    published = {v: [finite(_outcome_set(figs[o])[0]), finite(_outcome_set(figs[o])[2]), figs[o].get('bound')] for v, o in outcomes.items()}\n   662\t    return {'errors': errors, 'recorded': recorded, 'published': published}\n   663\t\n   664\t\n   665\tdef _per_unit(op, ins, fig):\n   210\tdef attempt_records(out, damaged=None):\n   211\t    \"\"\"The committed entries of both journals, split on the writer's own delimiter ('\\\\n' only: an answer may hold other Unicode line\n   212\t    separators). A line that does not parse (a write torn by a crash) is skipped and listed in `damaged` with its journal, so its\n   213\t    attempt counts as unfinished.\"\"\"\n   214\t    records = []\n   215\t    for name in JOURNALS:\n   216\t        path = out / name\n   217\t        text = path.read_text(encoding='utf-8', errors='replace') if path.exists() else ''\n   218\t        for number, line in enumerate(text.split('\\n'), 1):\n   219\t            if not line:\n   220\t                continue\n   221\t            try:\n   222\t                records.append(json.loads(line))\n   223\t            except json.JSONDecodeError:\n   224\t                if damaged is not None:\n   225\t                    damaged.append({'journal': name, 'line': number, 'text': line[:200]})\n   226\t    return records\n   227\t\n   228\t\n   229\tATTEMPT_FIELDS = ('attempt', 'status', 'decision', 'errors', 'data', 'raw')\n   230\t\n   231\t\n   232\tdef first_attempt(entry):\n   233\t    \"\"\"[47e.1] The attempt that is scored: the first one, on both arms (a retry is diagnostic). No attempt: not sent.\"\"\"\n   234\t    attempts = sorted(entry.get('attempts') or [], key=lambda a: a['attempt'])\n   235\t    return attempts[0] if attempts else {'attempt': 1, 'status': 'not sent', 'decision': 'not sent'}\n   236\t\n   237\t\n   238\tdef derive_finals(out, items, damaged=None):\n   548\tdef render_packets(out, key):\n   549\t    \"\"\"The scoring packets for a key {salt, run_digest, order}: the key's salted sha256 first (so the text the readers receive commits\n   550\t    to the mapping), then each packet in the key's order, rendered from the run's results and plan.\"\"\"\n   551\t    results = json.loads((out / 'results.json').read_text())\n   552\t    items = {(i['unit'], i['arm']): i for i in json.loads((out / 'plan.json').read_text())}\n   553\t    units = packet_units(results, items)\n   554\t    lines, rendered = [f'Key commitment: {key_commitment(key)}', ''], {}\n   555\t    for pid, unit_key in key['order']:\n   556\t        decision, per_card = units[tuple(unit_key)]\n   557\t        body, grounds, members = packet_body(items, unit_key[0], unit_key[1], decision, per_card)\n   558\t        lines += [f'## {pid}'] + body\n   559\t        rendered[pid] = {'unit': unit_key[0], 'arm': unit_key[1], 'draw': unit_key[2], 'decision': decision, 'grounds': grounds,\n   560\t                         'cards': {f'K{n}': v for n, v in enumerate(members, 1)}}\n   561\t    return '\\n'.join(lines), rendered, units\n   562\t\n   563\t\n   564\tdef returned_text(raw):\n   504\t        again = str(error)\n   505\t    check('packets are written only after both files render: a failed render leaves nothing, and a second call then succeeds',\n   506\t          nothing and not again and (atomic / 'packets.md').exists() and (scratch / 'key-atomic' / 'packet-key.json').exists(), again[:80])\n   507\t    # [47c.1] duplicates inside one answer are judged in both arms alike: never unified by the reconciliation\n   508\t    s, lines, stub, led = scenario(scratch, 'separate-within-dup')\n   509\t    rec, joint = s['reconciled']['pair-old-2|1'], s['finals']['pair-old-2|joint|1']\n   510\t    check('separate-within-dup: two equal forecasts inside one answer are kept, so the reconciled pair is refused as the joint one is (C3)',\n   511\t          rec['decision'] == 'refused' and any(c == 'C3' and 'ambiguous' in m for c, m in rec['errors']) and joint['decision'] == 'unresolved'\n   512\t          and not rec['calc']['unified'], f\"{rec['decision']} / joint {joint['decision']}\")\n   513\t    s, lines, stub, led = scenario(scratch, 'separate-within-dup-shared')\n   514\t    rec = s['reconciled']['pair-old-2|1']\n   515\t    check('separate-within-dup-shared: two equal shared forecasts within one call are not unified with each other, so C4 refuses as within one call',\n   516\t          rec['decision'] == 'refused' and any(c == 'C4' and 'forecast nodes' in m for c, m in rec['errors']) and not rec['calc']['unified'],\n   517\t          f\"{rec['decision']} {[m for c, m in rec.get('errors', []) if c == 'C4'][:1]}\")\n   518\t    s, lines, stub, led = scenario(scratch, 'separate-within-dup-second')\n   519\t    rec = s['reconciled']['pair-old-2|1']\n   520\t    check('separate-within-dup-second: the second call\\'s two equal shared forecasts are not both unified to the first call\\'s one (C4 refuses)',\n   521\t          rec['decision'] == 'refused' and any(c == 'C4' and '3 forecast nodes' in m for c, m in rec['errors']) and not rec['calc']['unified'],\n   522\t          f\"{rec['decision']} {[m for c, m in rec.get('errors', []) if c == 'C4'][:1]}\")\n   523\t    # [47c.3] an abstention can be read: its card is a ground\n   524\t    s, lines, stub, led = scenario(scratch, 'abstain')\n   525\t    akeys = scratch / 'key-abstain'\n   526\t    pg.packets(scratch / 'abstain', akeys)\n   527\t    afrozen = json.loads((akeys / 'packet-key.json').read_text())\n   528\t    arend = pg.render_packets(scratch / 'abstain', afrozen)[1]\n   529\t    apid = next(p for p, k in arend.items() if k['unit'] == 'single-S' and k['draw'] == '1')\n   530\t    rd = {pid: {c: card() for c in k['cards']} for pid, k in arend.items()}\n   531\t    for pid, k in arend.items():                            # every draw of single-S abstains\n   532\t        if k['unit'] == 'single-S':\n   533\t            rd[pid] = {'K1': {x: {q: {'answer': 'no', 'ground': 'K1 is unresolved: no figure in the shown passages'} for q in pg.QUESTIONS} for x in ('A', 'B')}}\n   534\t    v = verdict_of(rd, 'abstain', out=scratch / 'abstain', keys=akeys, packets_sha=pg.hashlib.sha256((scratch / 'abstain' / 'packets.md').read_bytes()).hexdigest())\n   535\t    check('abstain: an unresolved singleton is published and can be read with its card as the ground', s['finals']['single-S|single|1']['decision'] == 'publish'\n   536\t          and arend[apid]['grounds'] == ['K1'] and v['complete'], '; '.join(v['problems'][:1]))\n   537\t    # [47c.2, 47d.1] the key orders the packets, and the readers' text commits to it: a swap of two packets whose text is identical\n   538\t    swapped = json.loads(json.dumps(frozen))   # (two draws of one unit and arm answer alike in the rehearsal) is still caught\n   539\t    twin = next(n for n, (_, u) in enumerate(swapped['order']) if n and u[:2] == swapped['order'][0][1][:2])\n   596\t    check('separate-unit: the same number in another unit is not unified (C4 refuses)', rec['decision'] == 'refused'\n   597\t          and any(c == 'C4' and 'forecast nodes' in m for c, m in rec['errors']) and not rec['calc']['unified'], rec['decision'])\n   598\t    # [47g] a damaged retry record stays diagnostic; Unicode separators inside an answer are not record breaks\n   599\t    shutil.copytree(scratch / 'retry', scratch / 'torn-retry', ignore=shutil.ignore_patterns('archives', 'packets.md', 'attempts.md', 'results.json'))\n   600\t    rpath = scratch / 'torn-retry' / 'retries.jsonl'\n   601\t    if not rpath.exists():\n   602\t        check('a damaged retry record is reported and the retry is interrupted, but the scored test stays complete', False, 'no retries journal')\n   603\t    else:\n   604\t        rj = rpath.read_text().split('\\n')[:-1]\n   605\t        rpath.write_text('\\n'.join(rj[:-1] + [rj[-1][:len(rj[-1]) // 2]]) + '\\n')\n   606\t        rs = pg.recover(scratch / 'torn-retry')\n   607\t        v = read_all('torn-retry', scratch / 'key-torn-retry')\n   608\t        check('a damaged retry record is reported and the retry is interrupted, but the scored test stays complete',\n   609\t              [d['journal'] for d in rs['damaged']] == ['retries.jsonl'] and rs['finals']['single-O|single|1']['decision'] == 'interrupted'\n   610\t              and v['complete'], '; '.join(v['problems'][:2]))\n   611\t    s, lines, stub, led = scenario(scratch, 'unicode')\n   612\t    v = read_all('unicode', scratch / 'key-unicode')\n   613\t    check('Unicode line separators inside an answer are kept in one record: the unit publishes and the verdict is complete',\n   614\t          '\\u2028' in (scratch / 'unicode' / 'answers.jsonl').read_text() and not s['damaged']\n   615\t          and s['finals']['single-O|single|1']['decision'] == 'publish' and v['complete'], '; '.join(v['problems'][:2]))\n   616\t    synthetic = scratch / 'retry-not-sent'\n8678:   \"e2951\": {\n9808:   \"e2951\": \"- e2951 [party_statement; finance.yahoo.com; original source NVIDIA CFO Colette Kress 2026-0\n11172:   \"e2951\": {\n12292:   \"e2951\": \"- e2951 [party_statement; finance.yahoo.com; original source NVIDIA CFO Colette Kress 2026-\n13656:   \"e2951\": {\n14776:   \"e2951\": \"- e2951 [party_statement; finance.yahoo.com; original source NVIDIA CFO Colette Kress 2026-\n16753:   \"e5267\": {\n17583:   \"e5267\": \"- e5267 [fact; uk.finance.yahoo.com; original source NVIDIA ; from gnews:3742f4ebc0994af8eb\n19432:   \"e5267\": {\n20252:   \"e5267\": \"- e5267 [fact; uk.finance.yahoo.com; original source NVIDIA ; from gnews:3742f4ebc0994af8eb\n22101:   \"e5267\": {\n22921:   \"e5267\": \"- e5267 [fact; uk.finance.yahoo.com; original source NVIDIA ; from gnews:3742f4ebc0994af8eb\n23790:   \"e4669\": {\n23906:   \"e4669\": \"- e4669 [rumour; InvestingNews; original source Reuters ; from gnews:65814ac898f65c6b360be3\n24549:   \"e1926\": {\n24706:   \"e1926\": \"- e1926 [third_party_view; uk.finance.yahoo.com, citing Bank of America; original source Ba\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_33","type":"agent_message","text":"**Round 52 finds serious gaps. I would hold v13s before code.** A joint answer can add Data Center revenue to company revenue by multiplying the segment figure by `1` first. It can also mark its own estimate as the market reference by putting genuine guidance underneath it. Both pass the written checks.\n\n## 1. High severity — the five defects\n\n1. **(a) S8 — A part can still be added into its whole.** Take a $350B company forecast and a $75B Data Center forecast that it already includes. Multiply the $75B by `1x`, label the result “revenue adjustment,” then add it to the company forecast. The result is $425B and the segment stays below it. S8 sees a company figure plus an adjustment, so it passes. An estimate of $425B that names both figures in `rests_on` also passes. **Closing text:** “An addition to a whole must not include any part already counted in it, even through an intermediate calculation. If an estimate adds a figure, list it as an arithmetic input so the addition can be checked.” Two sentences can express the rule. Code can follow arithmetic inputs through a multiplier of one. It cannot tell whether an opaque estimate added a figure or merely considered it. The design needs an explicit way to carry that distinction. [S8 and estimate links](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/SMALL-DESIGN.md:39)\n\n2. **(a) S4 — Two forecasts can pass as one.** Give company Q3 a $110B estimate with `basis: forecast`. Beneath it, use a $118.8B Q3 calculation made by multiplying $108B guidance by the answer’s own `1.1x` uplift. Label the $118.8B calculation `reported`. The outcomes reach it only through the $110B figure and S4 counts exactly one forecast. A simpler case needs no mislabelling. Two Data Center Q4 forecasts pass because the request lists only **company** Q3 and Q4 as shared. **Closing text:** “For each quarter and quantity used by an outcome, mark every forward value that incorporates your own estimate as `forecast`, even when it is computed. Use one such figure per quantity and quarter, and use it wherever that forecast feeds an outcome.” This closes the examples if code derives estimate ancestry and checks all quarter quantities used by the outcomes. It can still accept genuine guidance as an input to the one forecast. [S4](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/SMALL-DESIGN.md:40) · [Quantities registered by the harness](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/paid_gate.py:63)\n\n3. **(a), (d) S5 — “Beneath” leaves the reference itself unchecked.** Mark a $44B estimate `reported`, put a genuine guidance source in its `rests_on`, and mark the estimate in `reference_for`. There is an external source beneath it and no estimate or forecast beneath it. The estimate **is** the marked figure. The same bypass works with a computed root marked `forecast` whose operands are all external or reported. Conversely, a literal descendants-only check for the required external source refuses a direct consensus quote because it has no children. **Closing text:** “Check the marked reference itself and every figure it depends on. Each must be a source or a computation with no forecast basis, and at least one source, which may be the marked figure itself, must be quoted consensus, guidance or a third-party figure.” The legacy checker already walks from the root. [S5](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/SMALL-DESIGN.md:41) · [Reference field](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/SMALL-DESIGN.md:75) · [Legacy reference walk](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/calc_check.py:779)\n\n4. **(a), (c), (d) S3 and S6 — The declared numbers can disagree with the calculation that the reader gets.** A part computed as $100.8B can declare $100.4B, while its whole computed as $100.1B declares $100.5B. Both declarations are within S2’s tolerance. Comparing declarations passes a part that exceeds its whole. The same issue changes an answer at a rung edge. A declared $391.9B fits P-v4 rung 3, while a recomputed $392.1B fits rung 2. **Closing text:** “Compare part and whole using the recomputed values, and use the same values to select and publish the rung. Apply the arithmetic tolerance only when comparing the declared result with the recomputed result.” Also, paired ends presuppose comparable ranges. A $107B segment base case can be right alongside a $105.84–110.16B company range if the company’s low case also has lower segment revenue. Treating the segment point as both ends refuses it. State when the two ends represent matching cases. With independent ranges, code can prove a contradiction when the part’s minimum exceeds the whole’s maximum. [S2, S3 and S6](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/SMALL-DESIGN.md:37) · [Archived company range](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/paid-plan.json:1194) · [Legacy recomputation order](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/calc_check.py:457)\n\n5. **(a), (c), (d) S2 — The operations allow wrong arithmetic and leave correct range arithmetic undefined.** `sum($108B, 2%) = $110B` passes the stated scalar equation. The inputs describe different quantities, so the period rule does not apply, and the only stated unit ban is for `product`. For ranges, the correct result of `[-3,-2] × [2,4]` is `[-12,-4]`. I ran the legacy calculation in memory and got `[-6,-8]`. I also got two finite ends from dividing by `[-1,1]`, even though that interval includes zero. **Closing text:** “Add or subtract in the same unit, and use the input and result units stated for each operation. For a range, compute both extrema before taking any midpoint, and refuse division by a range containing zero.” The operation table still needs to define those units and say whether a midpoint declaration is published as a point or retains the computed range. [S2](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/SMALL-DESIGN.md:37) · [Operation wording](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/SMALL-DESIGN.md:71) · [Legacy arithmetic](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/calc_check.py:125)\n\n6. **(a), (c), (d) S1 — A compound number can be copied exactly and still be read wrong.** The shown guidance says `$108.0 billion, plus or minus 2%`. An answer can copy the two literal numbers, encode `2%` as a positive point, then produce a $110.16B guidance figure. S1 does not define `plus or minus` as a qualifier or a signed range. A1 asks for `apply_growth` ends but never says how the negative end enters the calculation. **Closing text:** “Copy the complete numeric expression in the shown quote, including its sign, currency, scale and both ends when it gives a range. For ‘plus or minus’ or `±`, copy the midpoint and the tolerance as separate linked figures and encode the tolerance as the rate range from minus to plus.” Pin the accepted spellings alongside that rule. I checked real examples of `US$10 billion`, `$96.2bn`, `roughly twice`, and the `between $105.84 billion and $110.16 billion` range. The old parser accepts `bn`, drops `US` from the matched token, and misses `twice`. The closed qualifier list also cannot represent the actual phrase `near double`. A source explicitly in euros must retain that currency distinction. [S1 and fields](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/SMALL-DESIGN.md:66) · [Guidance](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/paid-plan.json:1130) · [US-dollar quote](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/paid-plan.json:23790) · [Legacy parser](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/calc_check.py:12)\n\n## 2. Medium severity — correct answers and request wording\n\n- **(c), (d) S8 bars a valid subtraction and leaves period spelling unsettled.** Company revenue minus Data Center revenue gives **non–Data Center revenue**. The blanket ban on any difference combining part and whole refuses it. The period rule also has two scopes. §2 names particular FY forms, while §3 says it applies whenever inputs are periods of one quantity. The journals contain a correct `Q1 + Q2 = FY2027 first half`. The wire schema still permits that string, and A3 expects it to be impossible or refused. State the accepted period labels, their aliases, and how same-year calendar periods are treated for S. Allow the same-period subtraction when the result is the remainder. Keep `Q1 + Q2 = H1` and `FY − Q1–Q3 = Q4` as positive controls. [S8](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/SMALL-DESIGN.md:39) · [Period and operation fields](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/SMALL-DESIGN.md:61) · [Stored first-half calculation](/Users/lchingen/hivemind/poc/data/judging-v13-paid-gate-2026-11-22/answers.jsonl:2)\n\n- **(b), (d) A marked outcome can still be a qualified source, and the unresolved instructions contradict the required fields.** S6 checks the outcome’s key, unit and rung, but never requires the marked figure to be the answer’s forecast. A source saying `under $400 billion` can be marked as a $400B outcome in a rung starting at $400B. Say that an outcome marker belongs on the answer’s explicit forecast point or range. Separately, “unresolved: why, and nothing else” conflicts with the unchanged required `reasons`, `cites`, `pushes` and `theme_pushes`. List which fields are null and which arrays are empty. Also state how `rests_on` resolves a string that is both a figure ID and a passage ID. Otherwise a link can silently change meaning in decoding or renumbering. [Outcome and answer fields](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/SMALL-DESIGN.md:73) · [Required wire fields](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/render_v13.py:23) · [ID rewriting](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/paid_gate.py:423)\n\n- **(d) The examples name no covered company or product.** The company and member IDs in the actual family header are request data. Render the relation from the family so `v8` and `v4` do not appear in the other pairs. Three enforcement details still need to reach the request: S3’s paired-end rule is absent from the header, `sum` and `product` have no minimum arity stated, and §3 asks for a reason for the chosen rung of a range where S6 checks only overlap. I found no new substantive judging rule in the proposed system-text edit. The range explanation can remain an instruction to the writer and a fact for the reader. [Operation, rung and family wording](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/SMALL-DESIGN.md:71)\n\n## 3. High severity — build and blind test\n\n- **(b), (e) Format selection must reach reconciliation and the reader packets.** `Gate.attempt` is only one reader. `summarise` strips the two stored wire answers and calls the old checker on the merged result. `card_lines` also strips and rechecks the stored answer, including in the diagnostic view. Without format-aware decoding there, a reply accepted using `outcome_for` arrives at the card with no internal `outcome` pointer. `normalise` can consume the decoded graph as written, provided the decoder resolves the links and the recorded assumptions use IDs the card renderer remaps. Rehearse one v13s reply through the first attempt, reconciliation, card render and recovery. Write v13s-specific fixtures for legacy cases that cannot be represented as written, including the old `USD` intermediate, and assert the new rule IDs. [Reconciliation](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/paid_gate.py:266) · [Card decoding](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/paid_gate.py:501) · [Rehearsal fixtures](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/paid_rehearsal.py:42)\n\n- **(e) Byte-for-byte replay is possible with the original ledger snapshot.** I rebuilt the 12-item old plan byte for byte and reproduced `results.json` in memory from the journals using the ledger embedded in the saved results. Recovery using the directory’s live `ledger.json` differs at `ledger.launchers`, because the launcher entry was removed after results were written. Name the saved snapshot in the compatibility test and exercise the no-format path. [Recovery input](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/paid_gate.py:365) · [Launcher cleanup](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/paid_gate.py:409)\n\n- **(e) A1–A3 can go green while the counterexamples above pass.** A2 plants a direct sum, two already-labelled forecasts and an estimate *under* a reference. Those do not test the indirect addition, hidden forecast or estimate *at* the reference. Add those pairs, the recomputed rung edge, the source grammar cases, the legitimate remainder, and a missing range end. A3’s wording is also weaker at the stop line than in its procedure. Require the encoded mistake to fail at the schema, or to be **actually refused** by the stated check. A sentence that says it is forbidden does not prove the checker refused it. Test “first half” against the agreed period contract. The stored trillion outcome was `1.05` explicitly labelled `USD trillion`. Pair its schema rejection with an accepted `1050 USD bn` version. [A1–A3](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/SMALL-DESIGN.md:126) · [Stop conditions](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/SMALL-DESIGN.md:180) · [Stored trillion outcome](/Users/lchingen/hivemind/poc/data/judging-v13-paid-gate-2026-11-22/retries.jsonl:22)\n\n- **(e) A supported forecast with a bad reference can count as usable.** Part B asks whether the forecast is supported, and the stop lines allow another reply to cover a bad one. A supported forecast whose own estimate is passed off as the reference can therefore be counted usable, or be overlooked if the other writer gets the case right. Have readers independently mark support and any of D737’s named defects on every first reply. An accepted named defect or broken structure should trigger the corresponding stop. For support, give both readers the same complete shown passages, mask writer identity and checker decisions, and require each reader to name the passage or assumption that puts the forecast in its band. Then reveal refusals for the separate wording review. Define `INCOMPLETE` against the inventory of 12 first replies and required readings, so a missing session or undecided reading cannot disappear from the count. [Reader protocol and stop lines](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/SMALL-DESIGN.md:168) · [Existing reader brief](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/reader-brief-v13.md:3)\n\n**Registered inputs verified.** The six cases use the listed calls and ladder edges. The P union has 296 passages, with 79 exact quotes absent from the old plan. S has 50, with 41 absent. O and E have 30 and 15, with none absent. S call 9043 really asks about **calendar 2026**. O call 8507 asks about the **publication** of the FY2027 report. The registration explains that the intended number is the fiscal-close balance published in that report. Put that explanation in the request the writers and readers get. [Registration](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/SMALL-DESIGN.md:117)\n\nI recommend one revision to the written rules and test fixtures before implementation. The decisive check is an end-to-end rehearsal where each named defect fails its check and the paired correct answer survives through the reader’s card. This review was read-only and made no provider calls."}}
