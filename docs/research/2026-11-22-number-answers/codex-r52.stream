\\''answered'\\\\'']\n print(f,len(rows))\n for n,r in rows:\n  for g in r['\\\\''data'\\\\'']['\\\\''figures'\\\\'']:\n   if g.get('\\\\''operation'\\\\'')=='\\\\''apply_growth'\\\\'' and (g.get('\\\\''low'\\\\'') is not None or g.get('\\\\''high'\\\\'') is not None):\n    print('\\\\''growth range'\\\\'',n,r['\\\\''unit'\\\\''],g['\\\\''id'\\\\''],g['\\\\''inputs'\\\\''],g.get('\\\\''value'\\\\''),g.get('\\\\''low'\\\\''),g.get('\\\\''high'\\\\''))\n   if (g.get('\\\\''expression'\\\\'') or '\\\\'''\\\\'').lower().find('\\\\''twice'\\\\'')>=0 or (g.get('\\\\''unit'\\\\'') or '\\\\'''\\\\'').lower().find('\\\\''trillion'\\\\'')>=0:\n    print('\\\\''special'\\\\'',n,r['\\\\''unit'\\\\''],g['\\\\''id'\\\\''],g.get('\\\\''expression'\\\\''),g.get('\\\\''unit'\\\\''),g.get('\\\\''value'\\\\''))'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
