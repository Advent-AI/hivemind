{"type":"item.started","item":{"id":"item_7","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"python3 -B -c '\nimport pathlib,json,io,contextlib,copy,types\nimport gate as g, calc_check as c, render_v13 as r, mutants\ndef replay(func, log):\n    p=io.StringIO()\n    with contextlib.redirect_stdout(p): status=func()\n    assert status==0 and p.getvalue()==pathlib.Path(log).read_text()\nreplay(g.main,'\\\\''gate-run13.txt'\\\\'')\nassert g.MANIFEST==json.loads(pathlib.Path('\\\\''gate-run13.fixtures.json'\\\\'').read_text())\nreplay(r.main,'\\\\''render-r1.txt'\\\\'')\noriginal=g.cc\npath=pathlib.Path('\\\\''calc_check.py'\\\\'')\nsrc=path.read_text()\nfor name,old,new,target in mutants.MUTANTS:\n    g.cc=original\n    if old:\n        assert src.count(old)==1,name\n        mod=types.ModuleType('\\\\''in_memory_calc_check'\\\\'')\n        exec(compile(src.replace(old,new),str(path),'\\\\''exec'\\\\''),mod.__dict__)\n        g.cc=mod\n    misses={name for name,ok,_,_ in g.run() if not ok}\n    assert (target in misses if target else not misses),(name,misses)\ng.cc=original\nprint('\\\\''60 gate items, 28 mutants and stored render reproduced'\\\\'')\ndef check(name,case,passages):\n    fam,x=case['\\\\''family'\\\\''],case['\\\\''calc'\\\\'']\n    schema=r.v13_schema(list(fam['\\\\''members'\\\\'']),list(passages),[])\n    strict=r.strict(x,schema)\n    print(name, r.model.check_schema(strict,schema), c.check(fam,passages,r.without_nulls(strict))['\\\\''errors'\\\\''])\nfor name in ('\\\\''G4x'\\\\'','\\\\''G4'\\\\'','\\\\''G24'\\\\''):\n    check(name,g.MANIFEST[name],g.G_PASSAGES)\ncase=copy.deepcopy(g.MANIFEST['\\\\''G4x'\\\\''])\nfig=next(f for f in case['\\\\''calc'\\\\'']['\\\\''figures'\\\\''] if f['\\\\''id'\\\\'']=='\\\\''g28cancel'\\\\'')\nfig.pop('\\\\''value'\\\\'')\nfig.update(low=504.0,high=604.0)\ncheck('\\\\''G4x with range output'\\\\'',case,g.G_PASSAGES)\ncase=copy.deepcopy(g.MANIFEST['\\\\''R1c'\\\\''])\nprint('\\\\''R1c original rungs'\\\\'',[(a['\\\\''view_id'\\\\''],a['\\\\''rung'\\\\'']) for a in case['\\\\''calc'\\\\'']['\\\\''answers'\\\\'']])\nnext(a for a in case['\\\\''calc'\\\\'']['\\\\''answers'\\\\''] if a['\\\\''view_id'\\\\'']=='\\\\''v9'\\\\'')['\\\\''rung'\\\\'']=-2\ncheck('\\\\''R1c with negative rung equivalent to rung 3 by indexing'\\\\'',case,g.R1_PASSAGES)\n'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
