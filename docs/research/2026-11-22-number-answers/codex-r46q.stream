{"type":"item.started","item":{"id":"item_8","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"python3 -B -c '\nimport copy, gate as g,calc_check as c,render_v13 as r\nfor rung in (-2,6,None):\n    x=g.r1('\\\\''c'\\\\'')\n    next(a for a in x['\\\\''answers'\\\\''] if a['\\\\''view_id'\\\\'']=='\\\\''v9'\\\\'')['\\\\''rung'\\\\'']=rung\n    schema=r.v13_schema(list(g.R1_FAMILY['\\\\''members'\\\\'']),list(g.R1_PASSAGES),[])\n    wire=r.strict(x,schema)\n    print('\\\\''rung'\\\\'',rung,'\\\\''schema:'\\\\'',r.model.check_schema(wire,schema))\n    try:\n        calc=r.without_nulls(wire)\n        outcome=c.check(g.R1_FAMILY,g.R1_PASSAGES,calc)\n        print('\\\\''errors:'\\\\'',outcome['\\\\''errors'\\\\''],'\\\\''decision:'\\\\'',c.publish_decision(g.R1_FAMILY,calc,outcome))\n    except (IndexError, KeyError) as error:\n        import traceback, pathlib\n        frame=traceback.extract_tb(error.__traceback__)[-1]\n        print(type(error).__name__, str(error),f'\\\\''{pathlib.Path(frame.filename).name}:{frame.lineno}'\\\\'')\n'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
