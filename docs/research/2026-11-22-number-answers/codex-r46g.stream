{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba mutants.py | sed -n '1,140p'; sed -n '13,80p;105,135p' DESIGN.md; sed -n '1,11p' judging-v13-draft.txt; nl -ba calc_check.py | sed -n '311,352p'\"","aggregated_output":"     1\t\"\"\"Mutants of calc_check.py: each disables one rule on a scratch copy; the gate must miss the item that exercises it, and the\n     2\tunmutated control must pass. Harness-only. Usage: python3 mutants.py <scratch dir>  (writes the table to stdout).\"\"\"\n     3\timport os\n     4\timport shutil\n     5\timport subprocess\n     6\timport sys\n     7\tfrom pathlib import Path\n     8\t\n     9\tHERE = Path(__file__).resolve().parent\n    10\tMUTANTS = [\n    11\t    ('control (unmutated)', None, None, None),\n    12\t    ('C4 path rule off', \"if f != nodes[0]['id'] and _key(figs[f]['what']) == want]\", \"if False]\", 'R1b'),\n    13\t    ('C3 off', \"if plo > wlo + 1e-9 or phi > whi + 1e-9:\", \"if False:\", 'R1a'),\n    14\t    ('C1 accepts any substring (alone)', \"matches = [e for e in extract(passage['text']) if e['text'] == fig.get('expression')]\",\n    15\t     \"matches = [e for e in extract(passage['text']) if fig.get('expression') in e['text']]\", 'T9'),\n    16\t    ('C5 allows estimates', \"if any(n['kind'] in ('estimate', 'prior') or n['basis'] in ('forecast', 'prior_forecast') for n in nodes):\",\n    17\t     \"if any(n['kind'] == 'prior' for n in nodes):\", 'P3b'),\n    18\t    ('per-unit identity ignores scope', \"same = all((i['what']['population'], i['what']['scope']) == (out['population'], out['scope']) for i in ins)\",\n    19\t     \"same = True\", 'P4'),\n    20\t    ('per-unit inverse loses its scale', \"            lo, hi = lo / 1e9, hi / 1e9\", \"            pass\", 'G3inv'),\n    21\t    ('C2 tolerance 50%', \"return abs(declared - expected) <= max(0.005 * abs(expected), floor)\",\n    22\t     \"return abs(declared - expected) <= max(0.5 * abs(expected), floor)\", 'P2'),\n    23\t    ('bound direction ignored', \"        if want is not None and have != want:\", \"        if want is not None and have is None:\", 'R4m'),\n    24\t    ('C9 same base off (both clauses)', \"        if rel['type'] != 'same_base' or rel['later'] not in outcomes\", \"        if True or rel['later'] not in outcomes\", 'G4m'),\n    25\t    ('C10 prior not authenticated', \"        if ans_prior.get('day') != ptr.get('day') or not any(_same(fig.get('value'), v) for v in ans_prior.get('values', [])):\",\n    26\t     \"        if False:\", 'P3c'),\n    27\t]\n    28\t\n    29\t\n    30\tdef main(scratch):\n    31\t    scratch = Path(scratch)\n    32\t    src = (HERE / 'calc_check.py').read_text()\n    33\t    gate = (HERE / 'gate.py').read_text().replace('REPO = HERE.parents[2]', f\"REPO = Path('{HERE.parents[2]}')\")\n    34\t    print('mutant | expected miss | result')\n    35\t    failed = 0\n    36\t    for name, old, new, target in MUTANTS:\n    37\t        if old is not None and src.count(old) != 1:\n    38\t            print(f'{name} | {target} | MUTATION SITE NOT FOUND ONCE')\n    39\t            failed += 1\n    40\t            continue\n    41\t        folder = scratch / name.replace(' ', '_').replace('(', '').replace(')', '')\n    42\t        folder.mkdir(parents=True, exist_ok=True)\n    43\t        (folder / 'calc_check.py').write_text(src if old is None else src.replace(old, new))\n    44\t        (folder / 'gate.py').write_text(gate.replace('HERE = Path(__file__).resolve().parent', f\"HERE = Path('{folder}')\"))\n    45\t        run = subprocess.run([sys.executable, 'gate.py'], cwd=folder, capture_output=True, text=True, env={**os.environ, 'PYTHONDONTWRITEBYTECODE': '1'})\n    46\t        misses = run.stdout.split('misses:')[-1].strip().splitlines()[0] if 'misses:' in run.stdout else f'no output: {run.stderr.strip()[-200:]}'\n    47\t        if target is None:\n    48\t            ok = run.returncode == 0\n    49\t            print(f'{name} | none | {\"PASS\" if ok else \"BROKEN\"} ({misses})')\n    50\t        else:\n    51\t            ok = run.returncode == 1 and f\"'{target}'\" in misses\n    52\t            print(f'{name} | {target} | {\"CAUGHT\" if ok else \"NOT CAUGHT\"} ({misses})')\n    53\t        failed += not ok\n    54\t    shutil.rmtree(scratch, ignore_errors=True)\n    55\t    return 1 if failed else 0\n    56\t\n    57\t\n    58\tif __name__ == '__main__':\n    59\t    if len(sys.argv) != 2 or sys.argv[1].startswith('-'):\n    60\t        raise SystemExit('usage: mutants.py <scratch dir>')\n    61\t    raise SystemExit(main(sys.argv[1]))\n- a source figure must equal a complete numeric expression that code extracts from the passage.\n\n## 1. What changes\n\n| Piece | judging-v7 (today) | judging-v13 |\n|---|---|---|\n| Unit | one question per call | one **family** per call: the number questions of one company whose quantities overlap (a total and its segment or product line, a level and its growth, and a later year declared to rest on an earlier year's base [46.2]). Each keeps its own answer |\n| Who forms a family | none (0 dependencies) | **declared** for the test from the stored cases, with typed relations: `part_of(part, whole)` and `same_base(later, earlier)`. Production would need a matching version that names them |\n| Evidence shown | each question's own evidence in view (D198) | the union of the members' evidence in view, each passage once with its attribution; themes once |\n| Previous conclusion | rung and reasons, cut at 800 characters, unmarked | each member's previous rung and outcome, labelled \"our earlier forecast, not a source\". It can enter a calculation only as a `prior_forecast` figure (§2), never as a source or a market reference |\n| Answer | prose fields plus one answer-wide citation list | a calculation (figures) plus exactly one answer per member (§2) |\n| Request text | judging-v7 | a full v13 request written and audited (§5) [46.6] |\n| Failure | refused twice: the question is left as it was | refused twice: the family is recorded **unresolved** and no member is updated. A member may also answer `unresolved` itself (§2) [46.5] |\n\n## 2. The answer format (closed set; the schema enforces shape, code enforces §3)\n\n```\nfigures: [ { id,\n             what: { population, measure, scope, period },     # canonical: measure is the quantity (\"revenue\"), not its basis [46.1]\n             basis: \"reported\" | \"guidance\" | \"consensus\" | \"third_party\" | \"forecast\" | \"prior_forecast\",\n             scenario: \"base\" | \"<named>\",                       # default \"base\" [46.1]\n             kind: \"source\" | \"computed\" | \"estimate\",\n             value | {low, high} | {bound: \">\" | \">=\" | \"<\" | \"<=\" | \"approx\" | \"approx_below\" | \"approx_above\", value} | {multiplier, bound?},  unit,   # [46c.3]\n             # kind source:   evidence: \"<id>\", expression: <index of a complete expression code extracts from that passage>,\n             #                component: \"midpoint\" | \"low\" | \"high\" | \"bound\" | \"multiplier\" | \"value\"            [46b.2]\n             # kind computed: inputs: [...], operation: sum|difference|product|ratio|growth|apply_growth|share|range_from_relative|roll_forward,   # [46c.2]\n             #                relation (sum and roll_forward): \"accounting_parts\" | \"time_aggregation\" | \"stated_in_addition\" | \"overlap_unknown\",\n             #                disputed (overlap_unknown only): \"<the operand whose inclusion is in doubt>\"            [46b.4, 46d]\n             #                bridge (when inputs' what differ from the output's): \"<figure id of an estimate>\"   [46.3]\n             # kind estimate: basis_text, rests_on: [figure ids, evidence ids],\n             #                adjusts (optional): { figure: \"<id>\", type: \"discount\" | \"uplift\" | \"trim\" }            [46.3]\n             #                a bridge estimate also names `converts: [operand ids]` and the assumption           [46b.3]\n           } ]\nanswers: [ { view_id, shape: \"forecast\", outcome: \"<figure id>\", rung,                 # [46b.5] two shapes\n             reference: { figure: \"<id>\" } | { unavailable: \"<why>\" },                # per answer [46.2]\n             reasons, cites, pushes, theme_pushes, changed, why_changed }\n         | { view_id, shape: \"unresolved\", why, cites, changed, why_changed } ]       # no outcome, no rung\n```\n\n- **An arithmetic intermediate and the analyst's final range are distinct figures** [46.2]. For example, q02's $392B × 92% is a\n  `computed` figure. The final $370–400B is an `estimate` resting on it and on q01's range. Code checks the intermediate's arithmetic\n  and never requires the final range to equal it.\n- **`prior`** figures (basis `prior_forecast`) are for comparison only [46f.4]. They need a pointer to an earlier answer shown in the\n  request and must equal a figure that answer states (C10). They may feed no figure. A declared `same_base` reads the family's own\n  forecast node of the earlier member at the same snapshot (q22 reads q01's): C9.\n- **`roll_forward`** [46c.2]: an opening balance as of a date, plus additions and minus drawdowns over a later period, gives the\n  balance at that period's end. It is the accounting identity for a stock and its flows. An addition whose inclusion in the opening\n  balance is in doubt carries `relation: overlap_unknown` and `disputed` (R2's $18B).\n- **Scenarios carry ranges** [46b.1]. A forecast node is a point within a scenario. A range across members is written as paired\n  scenarios (for example `low`, `high`) whose nodes stay paired. The analyst's final answer may be a range `estimate` resting on the\n  scenario outcomes.\n- **The family declaration** (by the harness, not by the answer) lists the shared quantities and periods the members depend on, for\n  example company revenue for each FY2027 quarter, and the typed relations [46b.1].\n\n## 3. What code checks (identity and arithmetic only)\n\n| Check | Rule | Refuses |\n|---|---|---|\n| **C1 source expression** [46b.2] | code extracts every complete numeric expression from the cited passage as shown, with its qualifiers and unit. Points: \"$108.0 billion\". Ranges: \"$105–110 billion\". Relative: \"$108.0 billion, plus or minus 2%\" is midpoint 108 ±2%. Bounds: \"more than $730 billion\" (>730), \"at least\" (>=). Approximate bounds: \"nearly $800 billion\" (approx_below 800). Multipliers: \"double\" ×2, \"more than double\" (>×2). A source figure names one extracted expression and a component of it (midpoint, low, high, bound, multiplier), and must equal it exactly: value, unit, sign and qualifier. Any other wording cannot be a source figure | a figure that strips a qualifier ($730 from \"more than $730 billion\"); a bound used as a point; a wrong number within 0.5% (108.5); a figure naming no extracted expression |\n| **C2 arithmetic** | a `computed` figure recomputes from its inputs by its operation. Rounding: to the figure's stated precision, at most 0.5% or 0.1 unit. `range_from_relative` makes 108 ± 2% into 105.84–110.16 | a wrong sum, share or endpoint |\n| **C3 part within whole** [46b.1] | for each declared `part_of`, in each scenario, for each declared period: the part's value, found by walking the graph from the part member's outcome to its node for that period, is at most the whole's. Annual and quarters are compared where the declaration names them | a segment quarter above the company quarter |\n| **C4 one forecast per shared quantity** [46b.1, 46c.1] | for each shared quantity and period the declaration names, each scenario has exactly one `basis: forecast` node. **Every path** in the graph from a member's outcome to any figure that measures that quantity and period passes through that node. A guide, consensus or other source of a future period may feed the forecast node; no path from an outcome may reach it while avoiding the node | the $108B guide feeding v14's $113.5B forecast and, on another path, v9's Data Center Q3 directly: the same guide node, a bypass |\n| **C5 reference** [46b.3, 46c.1] | each answer's reference is `unavailable` with a reason, or a direct `source` figure of basis consensus, guidance or third_party from a passage whose speaker is not the system, or a `computed` figure whose whole graph is computed figures over such sources and `reported` sources (q02: $392B consensus × 92% reported mix). No `estimate`, `forecast` or `prior_forecast` anywhere in the reference's graph. Its provenance is shown | the system's own forecast presented as the market's, directly or wrapped in an estimate that cites outside evidence |\n| **C6 rung and outcome** [46.2] | the chosen rung's band overlaps the outcome (a point: contains it). The reasons say why that band, where the range overlaps several | a rung no part of the outcome falls in |\n| **C7 structure** [46.5] | exactly one answer per member; an answer's outcome `what` matches its member's question (population, measure, scope, period, from the question's typed key); figure ids are unique; references are not dangling and not circular; operations come from the closed set | a missing or doubled member, a borrowed outcome, a dangling or circular figure |\n| **C8 operand compatibility** [46b.3] | by operation. **sum/difference:** same measure, population and scope, with periods either disjoint and together forming the output period (`time_aggregation`), or identical with a declared relation (`accounting_parts` needs a declared `part_of`). **roll_forward:** an opening balance as of a date, and flows over a period starting then or later, give the closing balance [46c.2]. **per unit** [gate run 1]: a total over a price per unit gives units, and units times that price give the total, for one population and scope (q19's $20B at $5,000 a Vera CPU is four million units). **share:** numerator and denominator stated, with a declared `part_of` or a reported mix. **product/ratio:** a change of measure, population, scope or period not covered above needs a bridge estimate whose `converts` names the actual operands, and an assumption | 730/800 × $1.3T with no bridge naming e1786's four-company 2026 spending and e2535's five-company capex; a bridge that converts other operands |\n\n| **C9 same base** [46f.3] | for each `same_base(later, earlier)`, the later member's outcome rests on the earlier member's outcome, and every path from it to a figure of the earlier member's quantity and period passes through that outcome | FY2028 grown from the $392B consensus instead of q01's $400–435B forecast |\n- **Nothing in poc-v118 reads any of it.**\n\n**New path × old checks.**\n- v7's id, push and theme checks apply per member answer. Rung checks apply to `forecast` answers only [46b.5]. `cites` names shown\n  evidence only.\n- `cites_views` is always empty.\n- v7's request bytes are unchanged (the frozen pins).\n\n**State × event (the test harness).** Inputs are fixed: the stored requests' passages and the gold packet's items, as of the stored\nday.\n\n| Event | Outcome |\n|---|---|\n| success | the calculation and answers are recorded with their check results |\n| refusal | the errors are recorded; one retry with them |\n| second refusal | the family is unresolved, recorded |\n| a member's own `unresolved` [46b.5] | recorded; the family is held (no member updated) when any other member's outcome depends on a shared quantity or relation involving it; otherwise the others publish if they pass |\n| crash midway | the attempt is recorded incomplete and counts as no result |\n\nNothing writes a product store. Production lifecycle (members closing or opening, families changing) is designed only if the test\npasses.\n\n**Prior decisions:**\n- D24, D28: bounded to the figures open questions consume.\n- D198: evidence in view, unioned.\n- D260, D263: the standard kept.\n- D359, D723: no product launcher.\n- D695: number questions.\n- D711, D721, D722: linking passed conclusions, and unresolved inclusion is not double counting.\n- D725, D726.\n\nYou are a senior hedge-fund analyst judging the current rungs of a family of related number theses: one company's quantities that overlap, such as a total and its segment, a level and its growth, or a later year that rests on an earlier year's base. Use only the supplied evidence and themes in force. Each rung is your forecast: the outcome the evidence in force makes most likely at the due date, not the one it has proved.\n\n- Rejudge every member from the evidence shown (what recent judgements relied on and what arrived recently) and the themes in force. Pieces in force that no recent judgement relied on are not shown; each member's earlier forecast reflects them, but its figures are our own, never a source and never the market's expectation. Do not add to or subtract from a previous score. The earlier forecasts are supplied only for comparison.\n- Judge each member against a reference: what the market expects for that question (consensus, the company's guidance, the stated plan or deadline). Say where the reference sits on its ladder. A consensus or guidance figure by itself keeps the judgement at the reference's rung; once other evidence has arrived it is never the reason to stay. Then derive the outcome the evidence implies: reported figures and guidance give a run-rate that carries the guided growth forward, never the last quarter annualised flat; a quantified revision, a customer's demand number, a supplier's constraint, a confirmed delay or cancellation shift it. A target for a product with no shipments yet is discounted by default; it is taken in full only when the evidence shows the volume in hand. Build the family's figures once and read every member's outcome from them: a part cannot exceed its whole, a figure that spans several periods or products gives a question only its share, and a quantity the family shares has one forecast per scenario. Compare each outcome with its rung boundaries, and move when it crosses one.\n- Weigh by tier and by novelty. Only fact can establish that a rung's outcome already holds; \"not established\" is a statement of confidence, never a reason to stay. Guidance for the current or next quarter is the strongest forecast input. A management target for a product not yet shipping, or an ambition spanning years, is an input to be discounted for time and execution (how many selling quarters remain, what volume and price the figure implies, what the company's own choices say), not an answer; consensus is where the market stands, not the answer either. third_party_view and rumour move the forecast in proportion to their specificity (a number, a date, a named party): a research firm's shipment or revenue tracking with a number counts. A commitment or deal that is announced but not sized is sized from its disclosed comparable (the same programme's other deal, scaled by capacity or units); a figure no one states is derived from the accounting identities in the evidence when they allow it. A repeat, another outlet for the same claim, or an opinion that adds no new fact or calculation moves nothing. Missing confirmation alone is not grounds for the lowest or highest rung: an event not being confirmed is not confirmation that it did not happen.\n- An evidence item that replaces another includes its predecessor for context, such as guidance revised from 12% to 25% growth. The predecessor is no longer evidence in force.\n- \"Themes in force\" lists the library's open theme theses (policy stages, shared quantities) with their current conclusions. They are our own judgements, never evidence: do not cite them in cites. Weigh each one that bears on a member and report it in that member's theme_pushes with the direction it pushes that member (toward_first, toward_last or none); leave out a theme that does not bear on it. A theme marked \"updated since this thesis was last judged\" may change the conclusion; one that is not marked already stood at the previous judgement. When no themes are listed, theme_pushes is empty.\n- Your conclusions must be consistent with each other and with the themes in force as shown: a share cannot be judged at zero while the policy that gates it is judged likely to open.\n- Return the family's figures and one answer per member, as the JSON schema defines them. Every number an answer rests on is a figure; a number you judge rather than read or compute is an estimate, stated as yours. When the evidence cannot support a member's forecast, answer it unresolved and say why. Write explanations in English; preserve IDs and any quoted source text.\n- changed is true for a different rung or a change to the key facts or figures supporting the same rung, including a changed implied outcome. Repetition or another source for the same statement does not alone change the conclusion. A first judgement always has changed true.\n   311\t    members = family['members']\n   312\t    seen = {}\n   313\t    for ans in calc['answers']:\n   314\t        seen[ans['view_id']] = seen.get(ans['view_id'], 0) + 1\n   315\t    for view_id in members:\n   316\t        if seen.get(view_id, 0) != 1:\n   317\t            errors.append(('C7', f'{view_id} has {seen.get(view_id, 0)} answers; exactly one is required'))\n   318\t    for view_id in seen:\n   319\t        if view_id not in members:\n   320\t            errors.append(('C7', f'{view_id} is not a member of the family'))\n   321\t    outcomes = {}\n   322\t    for ans in calc['answers']:\n   323\t        member = members.get(ans['view_id'])\n   324\t        if member is None:\n   325\t            continue\n   326\t        if ans.get('shape') == 'unresolved':\n   327\t            if 'outcome' in ans or 'rung' in ans or not ans.get('why'):\n   328\t                errors.append(('C7', f'{ans[\"view_id\"]}: an unresolved answer has a reason and neither outcome nor rung'))\n   329\t            continue\n   330\t        out = figs.get(ans.get('outcome'))\n   331\t        if out is None:\n   332\t            errors.append(('C7', f'{ans[\"view_id\"]}: outcome {ans.get(\"outcome\")} is not a figure'))\n   333\t            continue\n   334\t        if _key(out['what']) != _key(member['what']):\n   335\t            errors.append(('C7', f'{ans[\"view_id\"]}: outcome {out[\"id\"]} measures {_key(out[\"what\"])}, not the question\\'s {_key(member[\"what\"])}'))\n   336\t        outcomes[ans['view_id']] = out['id']\n   337\t        lo, hi = _interval(out)\n   338\t        band = member['bands'][ans['rung'] - 1]\n   339\t        b_lo, b_hi = band[0] if band[0] is not None else float('-inf'), band[1] if band[1] is not None else float('inf')\n   340\t        if not (lo < b_hi and hi >= b_lo):\n   341\t            errors.append(('C6', f'{ans[\"view_id\"]}: rung {ans[\"rung\"]} ({band}) contains no part of its outcome {lo}–{hi}'))\n   342\t        ref = ans.get('reference', {})\n   343\t        if 'unavailable' in ref:\n   344\t            if not ref['unavailable']:\n   345\t                errors.append(('C5', f'{ans[\"view_id\"]}: an unavailable reference needs a reason'))\n   346\t        else:\n   347\t            errors += _reference_errors(ans['view_id'], figs.get(ref.get('figure')), figs, passages, refs)\n   348\t\n   349\t    # C3 part within whole, C4 one forecast per shared quantity (every path)\n   350\t    def reachable(start, stop=None):\n   351\t        seen_ids, stack = set(), [start]\n   352\t        while stack:\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_9","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"python3 -B -c 'import copy, contextlib, io, json, pathlib, sys, types\nimport gate as g, calc_check as c, render_v13 as r, mutants as m\no=io.StringIO()\nwith contextlib.redirect_stdout(o): status=g.main()\nprint('\\\\''run3 equals file'\\\\'', status, o.getvalue()==pathlib.Path('\\\\''gate-run3.txt'\\\\'').read_text(), '\\\\''manifest equals file'\\\\'',json.loads(json.dumps(g.MANIFEST))==json.loads(pathlib.Path('\\\\''gate-run3.fixtures.json'\\\\'').read_text()))\nsrc=pathlib.Path('\\\\''calc_check.py'\\\\'').read_text()\nfor name,old,new,target in m.MUTANTS:\n cc=types.ModuleType('\\\\''cc'\\\\'')\n if old: assert src.count(old)==1\n exec(compile(src if old is None else src.replace(old,new),'\\\\''mutant in memory'\\\\'','\\\\''exec'\\\\''),vars(cc))\n g.cc=cc\n misses=[k for k,ok,*_ in g.run() if not ok]\n assert (not misses) if target is None else target in misses,(target,misses)\nprint('\\\\''mutants independently match the expected misses'\\\\'')\ng.cc=c\nreq=json.loads(pathlib.Path('\\\\''render-r1.request.json'\\\\'').read_text())\nbase=json.loads(pathlib.Path('\\\\''render-r1.answer.json'\\\\'').read_text())\nprint('\\\\''baseline schema/check'\\\\'',r.model.check_schema(base,req['\\\\''schema'\\\\'']),c.check(g.R1_FAMILY,g.R1_PASSAGES,r.without_nulls(base))['\\\\''errors'\\\\''])\nx=copy.deepcopy(base)\nx['\\\\''answers'\\\\''][0]['\\\\''cites_views'\\\\'']=[]\nprint('\\\\''follows rendered legacy instruction, schema'\\\\'',r.model.check_schema(x,req['\\\\''schema'\\\\'']))\nx=copy.deepcopy(g.r1('\\\\''c'\\\\''))\nprior=next(k for k in g.r1('\\\\''a'\\\\'')['\\\\''figures'\\\\''] if k['\\\\''id'\\\\'']=='\\\\''prior414'\\\\'')\nx['\\\\''figures'\\\\''].append(prior)\nx['\\\\''answers'\\\\''][1]['\\\\''reference'\\\\'']={'\\\\''figure'\\\\'':'\\\\''prior414'\\\\'','\\\\''unavailable'\\\\'':'\\\\''No external segment estimate for this scope'\\\\''}\nx=r.strict(x,req['\\\\''schema'\\\\''])\nprint('\\\\''prior plus unavailable schema/check'\\\\'',r.model.check_schema(x,req['\\\\''schema'\\\\'']),c.check(g.R1_FAMILY,g.R1_PASSAGES,r.without_nulls(x))['\\\\''errors'\\\\''])\nfam, x=g.g2()\nfam['\\\\''shared'\\\\'']=[fam['\\\\''members'\\\\'']['\\\\''v1'\\\\'']['\\\\''what'\\\\'']]\nfigures={k['\\\\''id'\\\\'']:k for k in x['\\\\''figures'\\\\'']}\nprint('\\\\''G2 with shared declaration, unpaired control'\\\\'',c.check(fam,g.G_PASSAGES,x)['\\\\''errors'\\\\''])\nnew=[figures[k] for k in ('\\\\''gc392'\\\\'','\\\\''gmix'\\\\'','\\\\''gref2'\\\\'')]\nco=fam['\\\\''members'\\\\'']['\\\\''v1'\\\\'']['\\\\''what'\\\\''];dc=fam['\\\\''members'\\\\'']['\\\\''v2'\\\\'']['\\\\''what'\\\\'']\nfor s,total,share in (('\\\\''low'\\\\'',400,92.5),('\\\\''high'\\\\'',435,92)):\n new += [\n  g.est('\\\\''total_'\\\\''+s,total,'\\\\''USD bn'\\\\'',co,'\\\\''Gold total endpoint'\\\\'',scenario=s),\n  g.est('\\\\''mix_'\\\\''+s,share,'\\\\''%'\\\\'',figures['\\\\''gsh'\\\\'']['\\\\''what'\\\\''],'\\\\''Gold allowed mix'\\\\'', ['\\\\''gmix'\\\\''],scenario=s),\n  g.comp('\\\\''dc_'\\\\''+s,'\\\\''share'\\\\'',['\\\\''total_'\\\\''+s,'\\\\''mix_'\\\\''+s],total*share/100,'\\\\''USD bn'\\\\'',dc,scenario=s)]\nnew += [g.est('\\\\''gfy'\\\\'',(400,435),'\\\\''USD bn'\\\\'',co,'\\\\''Gold total range'\\\\'', ['\\\\''total_low'\\\\'','\\\\''total_high'\\\\'']),\n        g.est('\\\\''gdc'\\\\'',(370,400),'\\\\''USD bn'\\\\'',dc,'\\\\''Gold segment range'\\\\'', ['\\\\''dc_low'\\\\'','\\\\''dc_high'\\\\''])]\nx['\\\\''figures'\\\\'']=new\nprint('\\\\''G2 paired scenarios'\\\\'',c.check(fam,g.G_PASSAGES,x)['\\\\''errors'\\\\''])\n'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
