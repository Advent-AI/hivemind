{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc 'nl -ba scripts/release_build.py'","aggregated_output":"     1\t\"\"\"Build or check the \"Forecast unavailable\" release package (docs/research/2026-11-22-number-answers/RELEASE-BUILD.md).\n     2\t\n     3\t    release_build.py build --ledger <views.sqlite> --items <items.sqlite> [--as-of YYYY-MM-DD] --out <folder>\n     4\t    release_build.py check <folder> --ledger <views.sqlite> --items <items.sqlite>\n     5\t\n     6\tNo model or network call; both stores are read only. The package is checked in a private staging folder against the stores before\n     7\tone atomic move publishes it, and neither the package nor the report ever replaces an existing path. Exit statuses: 0 done; 1\n     8\trefused, with nothing published by this command; 2 the package is published (build) or passes (check) but the report name is taken\n     9\tor the report could not be written.\n    10\t\"\"\"\n    11\timport argparse\n    12\timport os\n    13\timport shutil\n    14\timport sys\n    15\timport time\n    16\tfrom pathlib import Path\n    17\t\n    18\tROOT = Path(__file__).resolve().parents[1]\n    19\tsys.path.insert(0, str(ROOT / 'src'))\n    20\tfrom hivemind import release, service  # noqa: E402\n    21\tfrom hivemind.views import store  # noqa: E402\n    22\t\n    23\t\n    24\tdef report_path(out):\n    25\t    return out.with_name(out.name + '.report.json')\n    26\t\n    27\t\n    28\tdef write_report(report, path):\n    29\t    \"\"\"0 when the report is published (naming any temporary file left behind), 2 when it is not.\"\"\"\n    30\t    try:\n    31\t        leftover = release.publish_report(report, path)\n    32\t    except OSError as error:\n    33\t        print(f'report not written ({error}); run check to write it', file=sys.stderr)\n    34\t        return 2\n    35\t    print(f'report: {path}')\n    36\t    if leftover:\n    37\t        print(f'report published; its temporary file {leftover} could not be removed', file=sys.stderr)\n    38\t    return 0\n    39\t\n    40\t\n    41\tdef build(args):\n    42\t    out = Path(args.out).absolute()\n    43\t    report = report_path(out)\n    44\t    for path in (out, report):\n    45\t        if os.path.lexists(path):\n    46\t            print(f'refused: {path} exists', file=sys.stderr)\n    47\t            return 1\n    48\t    started = time.time()\n    49\t    staged = views_db = items_db = None\n    50\t    try:\n    51\t        views_db, items_db = service.open_ledger(str(args.ledger)), store.open_read_only(str(args.items))\n    52\t        bound = release.resolve(views_db, args.as_of)\n    53\t        staged = release.stage(out)\n    54\t        data = release.release_export(views_db, items_db, bound)\n    55\t        export_seconds = time.time() - started\n    56\t        release.write_package(data, staged)\n    57\t        checked = time.time()\n    58\t        counts = release.check_package(staged, views_db, items_db, expected_as_of=bound)\n    59\t        unresolved = release.withheld_unresolved(views_db, data)\n    60\t        size = (staged / release.DATA_FILE).stat().st_size\n    61\t        check_seconds = time.time() - checked\n    62\t        release.publish(staged, out)\n    63\t        staged = None                       # published: this build no longer owns the staging name\n    64\t    except Exception as error:              # any failure before publication: nothing at --out from this build\n    65\t        print(f'refused: {type(error).__name__}: {error}', file=sys.stderr)\n    66\t        return 1\n    67\t    finally:\n    68\t        if staged is not None:\n    69\t            shutil.rmtree(staged)\n    70\t        for conn in (views_db, items_db):\n    71\t            if conn is not None:\n    72\t                conn.close()\n    73\t    print(f'published {out}: {counts}')\n    74\t    summary = {'ledger': str(args.ledger), 'items': str(args.items), 'as_of': bound, 'counts': counts,\n    75\t               'withheld_unresolved': unresolved, 'data_bytes': size,\n    76\t               'export_seconds': round(export_seconds, 2), 'check_seconds': round(check_seconds, 2)}\n    77\t    return write_report(summary, report)\n    78\t\n    79\t\n    80\tdef check(args):\n    81\t    out = Path(args.package).absolute()\n    82\t    views_db = items_db = None\n    83\t    try:\n    84\t        views_db, items_db = service.open_ledger(str(args.ledger)), store.open_read_only(str(args.items))\n    85\t        started = time.time()\n    86\t        counts = release.check_package(out, views_db, items_db)\n    87\t        check_seconds = time.time() - started\n    88\t        data = release.read_data(out)\n    89\t        unresolved = release.withheld_unresolved(views_db, data)\n    90\t        size = (out / release.DATA_FILE).stat().st_size\n    91\t    except Exception as error:\n    92\t        print(f'refused: {type(error).__name__}: {error}', file=sys.stderr)\n    93\t        return 1\n    94\t    finally:\n    95\t        for conn in (views_db, items_db):\n    96\t            if conn is not None:\n    97\t                conn.close()\n    98\t    print(f'passes {out}: {counts}')\n    99\t    summary = {'ledger': str(args.ledger), 'items': str(args.items), 'as_of': data['as_of'], 'counts': counts,\n   100\t               'withheld_unresolved': unresolved, 'data_bytes': size,\n   101\t               'export_seconds': None, 'check_seconds': round(check_seconds, 2)}\n   102\t    return write_report(summary, report_path(out))\n   103\t\n   104\t\n   105\tdef main(argv=None):\n   106\t    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)\n   107\t    commands = parser.add_subparsers(dest='command', required=True)\n   108\t    make = commands.add_parser('build')\n   109\t    make.add_argument('--ledger', required=True, type=Path)\n   110\t    make.add_argument('--items', required=True, type=Path)\n   111\t    make.add_argument('--as-of')\n   112\t    make.add_argument('--out', required=True, type=Path)\n   113\t    verify = commands.add_parser('check')\n   114\t    verify.add_argument('package', type=Path)\n   115\t    verify.add_argument('--ledger', required=True, type=Path)\n   116\t    verify.add_argument('--items', required=True, type=Path)\n   117\t    args = parser.parse_args(argv)\n   118\t    return build(args) if args.command == 'build' else check(args)\n   119\t\n   120\t\n   121\tif __name__ == '__main__':\n   122\t    sys.exit(main())\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc 'nl -ba src/hivemind/release.py'","aggregated_output":"     1\t\"\"\"The \"Forecast unavailable\" release: one allow-listed export of a views ledger, its package and its checks\n     2\t(docs/research/2026-11-22-number-answers/RELEASE-BUILD.md; D726, D756, D758).\n     3\t\n     4\tA number question carries its question, its evidence in force and the marker \"Forecast unavailable\". An event or Yes/No question\n     5\tcarries its question, its evidence and its answer labels. Nothing else is read into the package: no rung condition or bound, no\n     6\tjudgement reason or explanation, no switch reason, no history. Before a package is published, every field is compared with its\n     7\tstored source at the package's day, and nothing published replaces an existing path.\n     8\t\"\"\"\n     9\timport ctypes\n    10\timport ctypes.util\n    11\timport errno\n    12\timport hashlib\n    13\timport json\n    14\timport os\n    15\timport stat\n    16\timport sys\n    17\timport tempfile\n    18\tfrom datetime import date\n    19\tfrom pathlib import Path\n    20\t\n    21\tfrom . import bundle, service, vocabulary\n    22\tfrom .views import identity, store\n    23\t\n    24\tFORMAT = 'hivemind-release/1'\n    25\tALLOW_LIST = 'release-allow-list/1'\n    26\tFORECAST_UNAVAILABLE = 'Forecast unavailable'\n    27\tDATA_FILE = 'release-data.json'\n    28\tMANIFEST_FILE = 'manifest.json'\n    29\tPACKAGE_FILES = frozenset({DATA_FILE, MANIFEST_FILE})\n    30\tCLASSES = ('number', 'event', 'yes_no')\n    31\tALLOWED = {\n    32\t    'envelope': frozenset({'format', 'allow_list', 'as_of', 'questions'}),\n    33\t    'number': frozenset({'id', 'question', 'open', 'class', 'forecast', 'evidence'}),\n    34\t    'answered': frozenset({'id', 'question', 'open', 'class', 'answers', 'answer', 'evidence'}),\n    35\t    'evidence': frozenset({'id', 'one_line', 'quote', 'tier', 'speaker', 'original_who', 'original_day', 'sources'}),\n    36\t    'source': frozenset({'title', 'publisher', 'day', 'uri'}),\n    37\t    'manifest': frozenset({'format', 'allow_list', 'as_of', 'data_sha256'}),\n    38\t}\n    39\tEVIDENCE_TEXT = ('one_line', 'quote', 'tier', 'speaker', 'original_who', 'original_day')\n    40\tSOURCE_TEXT = ('title', 'publisher', 'day', 'uri')\n    41\tRENAME_EXCL = 0x4          # macOS <stdio.h>: renamex_np refuses an existing destination\n    42\tRENAME_NOREPLACE = 0x1     # Linux <linux/fs.h>: renameat2 refuses an existing destination\n    43\tAT_FDCWD = -100\n    44\t\n    45\t\n    46\tclass ReleaseRefused(ValueError):\n    47\t    \"\"\"The release refuses the input, the export or the package; the message names what and where.\"\"\"\n    48\t\n    49\t\n    50\t# ---------- the day\n    51\t\n    52\tdef canonical_day(text):\n    53\t    \"\"\"A day written YYYY-MM-DD, returned unchanged; anything else is refused. The stores compare days as text, so a day Python\n    54\t    also reads (20260825) would select rows from later days.\"\"\"\n    55\t    try:\n    56\t        day = date.fromisoformat(text)\n    57\t    except (TypeError, ValueError):\n    58\t        raise ReleaseRefused(f'not a day: {text!r}') from None\n    59\t    if day.isoformat() != text:\n    60\t        raise ReleaseRefused(f'a day must be written YYYY-MM-DD: {text!r}')\n    61\t    return text\n    62\t\n    63\t\n    64\tdef resolve(views_db, as_of=None):\n    65\t    \"\"\"The bound of a build or a check, one rule for both: a given day must be canonical; `service.resolve_bound` then refuses an\n    66\t    unfinished first day or a day after the last completed day; an omitted day with no default is refused.\"\"\"\n    67\t    if as_of is not None:\n    68\t        canonical_day(as_of)\n    69\t    bound = service.resolve_bound(views_db, as_of)\n    70\t    if not bound:\n    71\t        raise ReleaseRefused('the store has no default day; supply --as-of')\n    72\t    return canonical_day(bound)\n    73\t\n    74\t\n    75\t# ---------- identity\n    76\t\n    77\tdef _has_table(conn, name):\n    78\t    return conn.execute(\"select 1 from sqlite_master where type='table' and name=?\", (name,)).fetchone() is not None\n    79\t\n    80\t\n    81\tdef key_measure(conn, view_id):\n    82\t    \"\"\"The view key's measure, or None for a view with no key or a ledger with no key table.\"\"\"\n    83\t    if not _has_table(conn, 'view_keys'):\n    84\t        return None\n    85\t    row = conn.execute('select measure from view_keys where view_id=?', (view_id,)).fetchone()\n    86\t    return row['measure'] if row else None\n    87\t\n    88\t\n    89\tdef ladder(conn, view_id):\n    90\t    \"\"\"(position, label) of every rung, by position: the only rung columns the package reads.\"\"\"\n    91\t    return [(row['position'], row['label']) for row in conn.execute('select position, label from rungs where view_id=? order by position', (view_id,))]\n    92\t\n    93\t\n    94\tdef question_class(conn, view_id, labels):\n    95\t    \"\"\"'event' for an event measure, 'yes_no' for exactly two labels that are Yes and No in the stored vocabulary, else 'number'\n    96\t    (a view with no key and a ladder whose bands do not resolve included): the forecast of every number question is withheld.\"\"\"\n    97\t    if key_measure(conn, view_id) in identity.EVENT_MEASURES:\n    98\t        return 'event'\n    99\t    if len(labels) == 2 and {vocabulary.canonical('label', label) for label in labels} == {'Yes', 'No'}:\n   100\t        return 'yes_no'\n   101\t    return 'number'\n   102\t\n   103\t\n   104\tdef _answer(conn, view_id, as_of, positions):\n   105\t    \"\"\"The stored label of the latest judgement's rung on or before the day, or None when the question is not yet judged.\"\"\"\n   106\t    row = conn.execute('select rung from judgements where view_id=? and publication_day<=? order by judgement_id desc limit 1', (view_id, as_of)).fetchone()\n   107\t    if row is None:\n   108\t        return None\n   109\t    if row['rung'] not in positions:\n   110\t        raise ReleaseRefused(f'{view_id}: its latest judgement names rung {row[\"rung\"]}, which its ladder does not hold')\n   111\t    return positions[row['rung']]\n   112\t\n   113\t\n   114\t# ---------- the export\n   115\t\n   116\tdef _item(items_db, cache, input_id):\n   117\t    if input_id not in cache:\n   118\t        row = items_db.execute('select title, publisher, source_uri from items where input_id=?', (input_id,)).fetchone()\n   119\t        if row is None:\n   120\t            raise ReleaseRefused(f'source item {input_id} is not in the items database')\n   121\t        cache[input_id] = row\n   122\t    return cache[input_id]\n   123\t\n   124\t\n   125\tdef _visible_views(conn, as_of):\n   126\t    return [row for row in conn.execute('select view_id, question, created_seq from views order by created_seq, rowid') if service.visible(conn, row['created_seq'], as_of)]\n   127\t\n   128\t\n   129\tdef release_export(views_db, items_db, as_of=None):\n   130\t    \"\"\"The release data as of the bound: every question visible on that day, closed ones included, built field by field from the\n   131\t    allow-list. The result passes `check_export` or nothing is returned.\"\"\"\n   132\t    with bundle.read_snapshot(views_db, items_db):\n   133\t        bound = resolve(views_db, as_of)\n   134\t        items, questions = {}, []\n   135\t        for view in _visible_views(views_db, bound):\n   136\t            view_id = view['view_id']\n   137\t            rungs = ladder(views_db, view_id)\n   138\t            labels = [label for _, label in rungs]\n   139\t            kind = question_class(views_db, view_id, labels)\n   140\t            record = {'id': view_id, 'question': view['question'], 'open': service.is_open_as_of(views_db, view_id, bound), 'class': kind}\n   141\t            if kind == 'number':\n   142\t                record['forecast'] = FORECAST_UNAVAILABLE\n   143\t            else:\n   144\t                record['answers'] = labels\n   145\t                record['answer'] = _answer(views_db, view_id, bound, dict(rungs))\n   146\t            evidence = []\n   147\t            for piece in service.evidence(views_db, view_id, bound):\n   148\t                sources = []\n   149\t                for source in piece['sources']:\n   150\t                    item = _item(items_db, items, source['input_id'])\n   151\t                    sources.append({'title': item['title'], 'publisher': item['publisher'], 'day': source['publication_day'], 'uri': item['source_uri']})\n   152\t                evidence.append({'id': piece['evidence_id'], **{name: piece[name] for name in EVIDENCE_TEXT}, 'sources': sources})\n   153\t            record['evidence'] = evidence\n   154\t            questions.append(record)\n   155\t        data = {'format': FORMAT, 'allow_list': ALLOW_LIST, 'as_of': bound, 'questions': questions}\n   156\t    check_export(data)\n   157\t    return data\n   158\t\n   159\t\n   160\t# ---------- the closed set\n   161\t\n   162\tdef _keys(value, kind, where):\n   163\t    if not isinstance(value, dict):\n   164\t        raise ReleaseRefused(f'{where}: not an object')\n   165\t    if set(value) != ALLOWED[kind]:\n   166\t        extra, missing = sorted(set(value) - ALLOWED[kind]), sorted(ALLOWED[kind] - set(value))\n   167\t        raise ReleaseRefused(f'{where}: keys off the allow-list {extra}, missing {missing}')\n   168\t\n   169\t\n   170\tdef _texts(value, names, where, nullable=True):\n   171\t    for name in names:\n   172\t        if not (isinstance(value[name], str) or (nullable and value[name] is None)):\n   173\t            raise ReleaseRefused(f'{where}: {name} is not text')\n   174\t\n   175\t\n   176\tdef check_export(data):\n   177\t    \"\"\"Every object at every level holds exactly its record type's keys, with values of the allowed kinds. Returns the counts\n   178\t    judged.\"\"\"\n   179\t    _keys(data, 'envelope', 'the package')\n   180\t    if data['format'] != FORMAT or data['allow_list'] != ALLOW_LIST:\n   181\t        raise ReleaseRefused(f'the package names format {data[\"format\"]!r} and allow-list {data[\"allow_list\"]!r}')\n   182\t    canonical_day(data['as_of'])\n   183\t    if not isinstance(data['questions'], list):\n   184\t        raise ReleaseRefused('the package: questions is not a list')\n   185\t    counts = {'questions': {kind: 0 for kind in CLASSES}, 'evidence': 0, 'sources': 0}\n   186\t    for position, question in enumerate(data['questions']):\n   187\t        where = f'question {position}'\n   188\t        if not isinstance(question, dict) or question.get('class') not in CLASSES:\n   189\t            raise ReleaseRefused(f'{where}: no allowed class')\n   190\t        kind = question['class']\n   191\t        _keys(question, 'number' if kind == 'number' else 'answered', where)\n   192\t        _texts(question, ('id', 'question'), where, nullable=False)\n   193\t        where = f'question {question[\"id\"]}'\n   194\t        if not isinstance(question['open'], bool):\n   195\t            raise ReleaseRefused(f'{where}: open is not true or false')\n   196\t        if kind == 'number':\n   197\t            if question['forecast'] != FORECAST_UNAVAILABLE:\n   198\t                raise ReleaseRefused(f'{where}: a number question carries only the marker')\n   199\t        else:\n   200\t            answers = question['answers']\n   201\t            if not (isinstance(answers, list) and len(answers) == 2 and all(isinstance(a, str) for a in answers)):\n   202\t                raise ReleaseRefused(f'{where}: answers are not two labels')\n   203\t            if question['answer'] is not None and question['answer'] not in answers:\n   204\t                raise ReleaseRefused(f'{where}: the answer is not one of its labels')\n   205\t        if not isinstance(question['evidence'], list):\n   206\t            raise ReleaseRefused(f'{where}: evidence is not a list')\n   207\t        for piece in question['evidence']:\n   208\t            _keys(piece, 'evidence', f'{where} evidence')\n   209\t            _texts(piece, ('id',), f'{where} evidence', nullable=False)\n   210\t            _texts(piece, EVIDENCE_TEXT, f'{where} evidence {piece[\"id\"]}')\n   211\t            if not isinstance(piece['sources'], list):\n   212\t                raise ReleaseRefused(f'{where} evidence {piece[\"id\"]}: sources is not a list')\n   213\t            for source in piece['sources']:\n   214\t                _keys(source, 'source', f'{where} evidence {piece[\"id\"]} source')\n   215\t                _texts(source, SOURCE_TEXT, f'{where} evidence {piece[\"id\"]} source')\n   216\t            counts['sources'] += len(piece['sources'])\n   217\t        counts['evidence'] += len(question['evidence'])\n   218\t        counts['questions'][kind] += 1\n   219\t    return counts\n   220\t\n   221\t\n   222\t# ---------- the origin check\n   223\t\n   224\tdef _open_at(conn, view_id, as_of):\n   225\t    for row in conn.execute('select open, after_seq from view_switches where view_id=? order by id desc', (view_id,)):\n   226\t        if service.visible(conn, row['after_seq'], as_of):\n   227\t            return bool(row['open'])\n   228\t    return True\n   229\t\n   230\t\n   231\tdef _expected_evidence(views_db, items_db, view_id, as_of):\n   232\t    \"\"\"The evidence in force at the day, by its own SQL: visible links in link order, minus those whose latest replacement is\n   233\t    visible; each source row visible at the day, in row order, with its item required.\"\"\"\n   234\t    out = []\n   235\t    for link in views_db.execute('select evidence_id, seq from evidence_links where view_id=? order by id', (view_id,)).fetchall():\n   236\t        if not service.visible(views_db, link['seq'], as_of):\n   237\t            continue\n   238\t        latest = views_db.execute('select seq from replacements where old_evidence_id=? order by id desc limit 1', (link['evidence_id'],)).fetchone()\n   239\t        if latest is not None and service.visible(views_db, latest['seq'], as_of):\n   240\t            continue\n   241\t        row = views_db.execute(f'select evidence_id, {\", \".join(EVIDENCE_TEXT)} from evidence where evidence_id=?', (link['evidence_id'],)).fetchone()\n   242\t        if row is None:\n   243\t            raise ReleaseRefused(f'{view_id}: link to evidence {link[\"evidence_id\"]}, which the store does not hold')\n   244\t        sources = []\n   245\t        for source in views_db.execute('select input_id, publication_day, seq from evidence_sources where evidence_id=? order by id', (link['evidence_id'],)).fetchall():\n   246\t            if not service.visible(views_db, source['seq'], as_of):\n   247\t                continue\n   248\t            item = items_db.execute('select title, publisher, source_uri from items where input_id=?', (source['input_id'],)).fetchone()\n   249\t            if item is None:\n   250\t                raise ReleaseRefused(f'evidence {row[\"evidence_id\"]}: source item {source[\"input_id\"]} is not in the items database')\n   251\t            sources.append({'title': item['title'], 'publisher': item['publisher'], 'day': source['publication_day'], 'uri': item['source_uri']})\n   252\t        out.append({'id': row['evidence_id'], **{name: row[name] for name in EVIDENCE_TEXT}, 'sources': sources})\n   253\t    return out\n   254\t\n   255\t\n   256\tdef _compare(expected, actual, where):\n   257\t    \"\"\"The number of leaf values compared; the first difference is refused, naming where it is.\"\"\"\n   258\t    if isinstance(expected, dict):\n   259\t        if not isinstance(actual, dict) or set(expected) != set(actual):\n   260\t            raise ReleaseRefused(f'{where}: fields differ from the store')\n   261\t        return sum(_compare(expected[key], actual[key], f'{where}.{key}') for key in expected)\n   262\t    if isinstance(expected, list):\n   263\t        if not isinstance(actual, list) or len(expected) != len(actual):\n   264\t            raise ReleaseRefused(f'{where}: {len(actual) if isinstance(actual, list) else \"no\"} entries where the store has {len(expected)}')\n   265\t        return sum(_compare(e, a, f'{where}[{n}]') for n, (e, a) in enumerate(zip(expected, actual)))\n   266\t    if type(expected) is not type(actual) or expected != actual:\n   267\t        raise ReleaseRefused(f'{where}: differs from the store')\n   268\t    return 1\n   269\t\n   270\t\n   271\tdef check_origins(views_db, items_db, data, expected_as_of):\n   272\t    \"\"\"Every package field against its permitted stored source at `expected_as_of`, derived from the store and never from the\n   273\t    package: the day, each question's class, the questions, evidence and sources in order with their counts. Its reads are its own\n   274\t    SQL, apart from the identity rule (`question_class`) and the day of a sequence number (`service.visible`). Returns the number of\n   275\t    fields compared.\"\"\"\n   276\t    with bundle.read_snapshot(views_db, items_db):\n   277\t        as_of = canonical_day(expected_as_of)\n   278\t        if data['as_of'] != as_of:\n   279\t            raise ReleaseRefused(f'the package is dated {data[\"as_of\"]}, the store bound is {as_of}')\n   280\t        views = [row for row in views_db.execute('select view_id, question, created_seq from views order by created_seq, rowid')\n   281\t                 if service.visible(views_db, row['created_seq'], as_of)]\n   282\t        packaged = data['questions']\n   283\t        if [q['id'] for q in packaged] != [row['view_id'] for row in views]:\n   284\t            raise ReleaseRefused(f'the questions differ from the store: {len(packaged)} entries where the store has {len(views)}'\n   285\t                                 if len(packaged) != len(views) else 'the questions or their order differ from the store')\n   286\t        compared = _compare(FORMAT, data['format'], 'package.format') + _compare(ALLOW_LIST, data['allow_list'], 'package.allow_list') + 1\n   287\t        for view, question in zip(views, packaged):\n   288\t            view_id = view['view_id']\n   289\t            positions = {row['position']: row['label'] for row in views_db.execute('select position, label from rungs where view_id=? order by position', (view_id,))}\n   290\t            labels = list(positions.values())\n   291\t            kind = question_class(views_db, view_id, labels)\n   292\t            record = {'id': view_id, 'question': view['question'], 'open': _open_at(views_db, view_id, as_of), 'class': kind}\n   293\t            if kind == 'number':\n   294\t                record['forecast'] = FORECAST_UNAVAILABLE\n   295\t            else:\n   296\t                latest = views_db.execute('select rung from judgements where view_id=? and publication_day<=? order by judgement_id desc limit 1', (view_id, as_of)).fetchone()\n   297\t                if latest is not None and latest['rung'] not in positions:\n   298\t                    raise ReleaseRefused(f'question {view_id}: its latest judgement names rung {latest[\"rung\"]}, which its ladder does not hold')\n   299\t                record['answers'] = labels\n   300\t                record['answer'] = None if latest is None else positions[latest['rung']]\n   301\t            record['evidence'] = _expected_evidence(views_db, items_db, view_id, as_of)\n   302\t            compared += _compare(record, question, f'question {view_id}')\n   303\t        return compared\n   304\t\n   305\t\n   306\t# ---------- the package\n   307\t\n   308\tdef _dump(value):\n   309\t    return json.dumps(value, ensure_ascii=False, separators=(',', ':')).encode('utf-8')\n   310\t\n   311\t\n   312\tdef stage(out_dir):\n   313\t    \"\"\"A private staging folder, unique to this invocation, beside the destination.\"\"\"\n   314\t    out_dir = Path(out_dir)\n   315\t    return Path(tempfile.mkdtemp(dir=out_dir.parent, prefix=f'.{out_dir.name}.staging-'))\n   316\t\n   317\t\n   318\tdef write_package(data, staged):\n   319\t    \"\"\"The data file and its manifest, written into the staging folder.\"\"\"\n   320\t    payload = _dump(data)\n   321\t    (Path(staged) / DATA_FILE).write_bytes(payload)\n   322\t    manifest = {'format': data['format'], 'allow_list': data['allow_list'], 'as_of': data['as_of'], 'data_sha256': hashlib.sha256(payload).hexdigest()}\n   323\t    (Path(staged) / MANIFEST_FILE).write_bytes(_dump(manifest))\n   324\t\n   325\t\n   326\tdef _no_replace_rename():\n   327\t    libc = ctypes.CDLL(ctypes.util.find_library('c'), use_errno=True)\n   328\t    if sys.platform == 'darwin' and hasattr(libc, 'renamex_np'):\n   329\t        call = libc.renamex_np\n   330\t        call.argtypes, call.restype = [ctypes.c_char_p, ctypes.c_char_p, ctypes.c_uint], ctypes.c_int\n   331\t        return lambda source, target: call(source, target, RENAME_EXCL)\n   332\t    if sys.platform.startswith('linux') and hasattr(libc, 'renameat2'):\n   333\t        call = libc.renameat2\n   334\t        call.argtypes, call.restype = [ctypes.c_int, ctypes.c_char_p, ctypes.c_int, ctypes.c_char_p, ctypes.c_uint], ctypes.c_int\n   335\t        return lambda source, target: call(AT_FDCWD, source, AT_FDCWD, target, RENAME_NOREPLACE)\n   336\t    return None\n   337\t\n   338\t\n   339\tdef publish(staged, out_dir):\n   340\t    \"\"\"One atomic move of the staged folder to the destination that refuses any existing destination, empty or not.\"\"\"\n   341\t    rename = _no_replace_rename()\n   342\t    if rename is None:\n   343\t        raise ReleaseRefused('this platform offers no atomic rename that refuses an existing destination')\n   344\t    if rename(os.fsencode(str(staged)), os.fsencode(str(out_dir))) != 0:\n   345\t        code = ctypes.get_errno()\n   346\t        if code in (errno.ENOTSUP, errno.EINVAL, errno.ENOSYS):\n   347\t            raise ReleaseRefused(f'the filesystem refuses an atomic no-replace rename ({os.strerror(code)})')\n   348\t        raise OSError(code, os.strerror(code), str(out_dir))\n   349\t\n   350\t\n   351\tdef publish_report(report, path):\n   352\t    \"\"\"The report, written to a private temporary file and linked to its name; the link refuses any existing path, and its success\n   353\t    is the moment the report is published. Returns None, or the temporary file it could not remove after publishing.\"\"\"\n   354\t    path = Path(path)\n   355\t    descriptor, temporary = tempfile.mkstemp(dir=path.parent, prefix=f'.{path.name}.')\n   356\t    try:\n   357\t        with os.fdopen(descriptor, 'wb') as handle:\n   358\t            handle.write(json.dumps(report, ensure_ascii=False, indent=1).encode('utf-8'))\n   359\t        os.link(temporary, path)\n   360\t    except BaseException:\n   361\t        os.unlink(temporary)\n   362\t        raise\n   363\t    try:\n   364\t        os.unlink(temporary)\n   365\t    except OSError:\n   366\t        return temporary\n   367\t    return None\n   368\t\n   369\t\n   370\tdef _unique_members(pairs):\n   371\t    names = [name for name, _ in pairs]\n   372\t    if len(names) != len(set(names)):\n   373\t        raise ReleaseRefused(f'a JSON member name repeats: {sorted({n for n in names if names.count(n) > 1})}')\n   374\t    return dict(pairs)\n   375\t\n   376\t\n   377\tdef _read_json(path):\n   378\t    path = Path(path)\n   379\t    try:\n   380\t        return json.loads(path.read_bytes().decode('utf-8'), object_pairs_hook=_unique_members)\n   381\t    except (UnicodeDecodeError, json.JSONDecodeError) as error:\n   382\t        raise ReleaseRefused(f'{path.name}: not JSON ({error})') from None\n   383\t\n   384\t\n   385\tdef read_data(package):\n   386\t    \"\"\"The package's data, read with the repeated-member check; call `check_package` first to trust it.\"\"\"\n   387\t    return _read_json(Path(package) / DATA_FILE)\n   388\t\n   389\t\n   390\tdef check_package(path, views_db=None, items_db=None, expected_as_of=None):\n   391\t    \"\"\"The package as a reader receives it: a real folder holding exactly the two regular files; JSON with no repeated member\n   392\t    name; a closed manifest that agrees with the data and its sha256; data that passes `check_export` and, with the stores,\n   393\t    `check_origins` at `expected_as_of` (or at the package's own day passed through `resolve`). Returns the counts.\"\"\"\n   394\t    path = Path(path)\n   395\t    if not stat.S_ISDIR(os.lstat(path).st_mode):\n   396\t        raise ReleaseRefused(f'{path}: not a folder')\n   397\t    names = os.listdir(path)\n   398\t    if sorted(names) != sorted(PACKAGE_FILES):\n   399\t        raise ReleaseRefused(f'{path}: holds {sorted(names)}, not exactly {sorted(PACKAGE_FILES)}')\n   400\t    for name in names:\n   401\t        if not stat.S_ISREG(os.lstat(path / name).st_mode):\n   402\t            raise ReleaseRefused(f'{path / name}: not a regular file')\n   403\t    raw = (path / DATA_FILE).read_bytes()\n   404\t    manifest, data = _read_json(path / MANIFEST_FILE), _read_json(path / DATA_FILE)\n   405\t    counts = check_export(data)\n   406\t    _keys(manifest, 'manifest', 'the manifest')\n   407\t    if manifest['data_sha256'] != hashlib.sha256(raw).hexdigest():\n   408\t        raise ReleaseRefused('the manifest sha256 does not match the data file')\n   409\t    for name in ('format', 'allow_list', 'as_of'):\n   410\t        if manifest[name] != data[name]:\n   411\t            raise ReleaseRefused(f'the manifest {name} {manifest[name]!r} differs from the data {data[name]!r}')\n   412\t    if views_db is not None:\n   413\t        bound = expected_as_of if expected_as_of is not None else resolve(views_db, data['as_of'])\n   414\t        counts['fields_compared'] = check_origins(views_db, items_db, data, bound)\n   415\t    return counts\n   416\t\n   417\t\n   418\t# ---------- the report\n   419\t\n   420\tdef withheld_unresolved(views_db, data):\n   421\t    \"\"\"For the release report only: the number questions whose ladder does not resolve to bands, with the reason and whether the\n   422\t    view has a key. Withheld like every number question; this list never enters the package.\"\"\"\n   423\t    out = []\n   424\t    for question in data['questions']:\n   425\t        if question['class'] != 'number':\n   426\t            continue\n   427\t        bands, reason = service.ladder_bands(store.rungs_of(views_db, question['id']))\n   428\t        if bands is None:\n   429\t            out.append({'id': question['id'], 'reason': reason, 'has_key': key_measure(views_db, question['id']) is not None})\n   430\t    return out\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc 'nl -ba docs/research/2026-11-22-number-answers/RELEASE-BUILD.md | head -325'","aggregated_output":"     1\t# \"Forecast unavailable\" release: build design for slice 1 (the exporter and the checked package)\n     2\t\n     3\t**Status: revision 10, for council round 74j. No code yet.** Release work was opened by the council under D439 (D758). The behaviour is\n     4\tfixed by D726, D756 and `FORECAST-UNAVAILABLE-DESIGN.md` (revision 4). This page holds the AGENTS §2 tables for the first slice.\n     5\t\n     6\t**Revision 2 answers `codex-r74.md`** (see `claude-r74.md`):\n     7\t- the pass condition is an origin check of every field against its stored source, not a string sweep;\n     8\t- a missing source item is refused;\n     9\t- the package is checked before it is moved into place;\n    10\t- the manifest is a closed set;\n    11\t- the bound is validated as a date;\n    12\t- narrow reads;\n    13\t- size and speed budgets;\n    14\t- tests that separate every branch;\n    15\t- `object`, `kind` and groups dropped;\n    16\t- no idea submission.\n    17\t\n    18\tThe evidence summary stays as extraction stored it (§8, disputed in `claude-r74.md`).\n    19\t\n    20\t**Revision 3 answers `codex-r74b.md`.**\n    21\t- The checker derives everything it compares from the store, never from the package: the date, each question's class, the records and their counts.\n    22\t- A missing source item refuses `check` too.\n    23\t- The files must be two regular, non-symlink files, with no duplicate JSON member names.\n    24\t- The staging folder has one owner.\n    25\t- The builder's refusal is tested through the builder.\n    26\t- The diagnostics read only the columns a store has.\n    27\t\n    28\t**Revision 4 answers `codex-r74c.md`.**\n    29\t- One date rule for build and `check`.\n    30\t- Questions are ordered by `created_seq, rowid`.\n    31\t- (Superseded in revision 5.) The build claimed its output folder before staging.\n    32\t- Cleanup sits where the staging path is known.\n    33\t- A report failure after publication has its own outcome.\n    34\t- The builder's refusal is proved through the real command on a scratch copy.\n    35\t- Tests 9, 13, 14 and 15 are sharpened.\n    36\t\n    37\t**Revision 5 answers `codex-r74d.md` with one structural rule** (AGENTS §1: the publication mechanism drew findings in 74b, 74c and\n    38\t74d). Staging is private, and the only public step is one atomic move that refuses any existing destination. There is no public\n    39\tclaim, so nothing public is created early or cleaned up. Staging is removed in a `finally` covering its whole life, so any error,\n    40\tdatabase errors included, leaves nothing at `--out`.\n    41\t\n    42\t**Revision 6 answers `codex-r74e.md`.**\n    43\t- The build's cleanup responsibility ends the moment `publish` succeeds: the staging path is cleared and the `finally` removes nothing\n    44\t  after that, so a folder later created at the freed staging name is never touched.\n    45\t- The late refusal at `publish`, and the end of cleanup after it, are proved through the real command on scratch copies with a\n    46\t  pause.\n    47\t\n    48\t**Revision 7 answers `codex-r74f.md`.**\n    49\t- An explicit day is parsed first and used everywhere in its canonical `YYYY-MM-DD` form. Python reads `20260825` as the same day,\n    50\t  but the stores compare days as text.\n    51\t- Neither command writes a report over an input database.\n    52\t\n    53\t**Revision 8 answers `codex-r74g.md` with one rule for every public write** (report writing drew findings in 74f and 74g). Nothing the\n    54\tbuild or `check` writes ever replaces an existing path:\n    55\t- the package is published by `publish` (`RENAME_EXCL`);\n    56\t- the report is published by writing a private temporary file, then `os.link` to the report name, which fails with `EEXIST` when\n    57\t  anything exists there.\n    58\t\n    59\tVerified on this Mac: `os.link` refuses an existing file, a case-variant name of it (`ITEMS.SQLITE` for `items.sqlite`), and a\n    60\tsymbolic link, leaving each untouched. An input database always exists, so no report can replace one. The path comparison of\n    61\trevision 7 is subsumed and dropped.\n    62\t\n    63\t**Revision 9 answers `codex-r74h.md`.**\n    64\t- A report is published the moment its link succeeds. A later failure to remove the temporary file is reported as published, naming\n    65\t  the leftover file.\n    66\t- `check`'s exit statuses are explicit, and the end-to-end tests assert them.\n    67\t\n    68\t**Revision 10 answers `codex-r74i.md`:** `check` follows the build's rule. Any failure to publish the report before the link succeeds\n    69\t(the name occupied, or the temporary file not created or written, such as `EACCES`) is exit 2 after the printed pass.\n    70\t\n    71\t## 0. Scope\n    72\t\n    73\t- **Slice 1 (this page), $0:**\n    74\t  - the exporter `release_export` and its self-check;\n    75\t  - the package writer, the package check and the origin check;\n    76\t  - the release builder, which calls the exporter directly;\n    77\t  - tests and mutants;\n    78\t  - the $0 release check on stored stores.\n    79\t- **Slice 2, next.** The release page reads only the package: no live service, no `/library` fetch, no translated JSON, no composite\n    80\t  trials, no idea submission control or route. It gets a browser check of the `old-1/v8` screen, which completes D756's screen check.\n    81\t- **No idea submission in the release** (council 74). The idea path (`idea.py`) reads the ledger at every step and calls a paid model\n    82\t  per idea. The design's §5 idea acceptance (an idea card backed only by `v8`, and its composed request) is carried forward as pending\n    83\t  for the first idea-enabled slice.\n    84\t- **Not in scope:**\n    85\t  - the POC, its API, MCP and page (unchanged);\n    86\t  - colleagues' page;\n    87\t  - frozen pieces, extraction included;\n    88\t  - any model call;\n    89\t  - commit, publish, deploy.\n    90\t\n    91\t## 1. What is built\n    92\t\n    93\t`src/hivemind/release.py` is the one owner, beside `service.py`.\n    94\t\n    95\t- **Constants:**\n    96\t  - `FORMAT = 'hivemind-release/1'`;\n    97\t  - `ALLOW_LIST = 'release-allow-list/1'`;\n    98\t  - `FORECAST_UNAVAILABLE = 'Forecast unavailable'`;\n    99\t  - `PACKAGE_FILES = {'manifest.json', 'release-data.json'}`.\n   100\t- **`ALLOWED`:** the closed key set per record type.\n   101\t\n   102\t  | Record | Keys |\n   103\t  |---|---|\n   104\t  | envelope | `format`, `allow_list`, `as_of`, `questions` |\n   105\t  | number question | `id`, `question`, `open`, `class` (= `number`), `forecast` (= the marker), `evidence` |\n   106\t  | event or Yes/No question | `id`, `question`, `open`, `class` (`event` or `yes_no`), `answers` (the two stored rung labels, in position order), `answer` (the stored label of the latest judgement's rung on or before the bound, or null), `evidence` |\n   107\t  | evidence in force at the bound | `id`, `one_line`, `quote`, `tier`, `speaker`, `original_who`, `original_day`, `sources` |\n   108\t  | source recorded on or before the bound | `title`, `publisher`, `day`, `uri` |\n   109\t  | manifest | `format`, `allow_list`, `as_of`, `data_sha256` |\n   110\t\n   111\t- **`question_class(views_db, view_id, labels)`** (design §3):\n   112\t  - `event` when the view key's measure is in `identity.EVENT_MEASURES`. The key is read as `select measure from view_keys`, and\n   113\t    only when the table exists;\n   114\t  - `yes_no` when there are exactly two labels which, through `vocabulary.canonical('label', …)`, are `Yes` and `No` in either order;\n   115\t  - `number` otherwise: a view with no key, or one whose bands cannot be resolved.\n   116\t- **`release_export(views_db, items_db, as_of=None)`:**\n   117\t  - pins both connections (`bundle.read_snapshot`);\n   118\t  - takes an explicit day only in canonical form: `date.fromisoformat(day).isoformat()` must equal the text given, otherwise\n   119\t    `ReleaseRefused` (so `20260825` is refused, not read as `2026-08-25`). It then resolves the bound with `service.resolve_bound`,\n   120\t    refuses a store with no default day, and uses that canonical text in every query;\n   121\t  - exports every view that exists at the bound (`service.view_exists`), closed ones included, in `created_seq, rowid` order;\n   122\t  - builds each record field by field from the table above, with column-limited SQL:\n   123\t    - `select view_id, question, created_seq from views order by created_seq, rowid`;\n   124\t    - `select position, label from rungs`;\n   125\t    - `select rung from judgements where view_id=? and publication_day<=? order by judgement_id desc limit 1`;\n   126\t    - `service.is_open_as_of`, which reads only `open` and `after_seq`;\n   127\t  - takes evidence in force from `service.evidence` and its fields from that record;\n   128\t  - looks up each source's `title`, `publisher` and `source_uri` in the items database by `input_id`. A visible source whose item is\n   129\t    missing raises `ReleaseRefused` (there is no fallback to the id);\n   130\t  - calls `check_export` on its own result before returning (AGENTS §3: the writer refuses).\n   131\t- **`check_export(data)`:** the closed-set check.\n   132\t  - Every dict at every level has exactly its record type's keys.\n   133\t  - Value checks:\n   134\t    - `format` and `allow_list` equal the constants, and `as_of` is a canonical `YYYY-MM-DD` day (`date.fromisoformat(as_of).isoformat() == as_of`);\n   135\t    - `class` is in its set;\n   136\t    - a number record's `forecast` is the marker;\n   137\t    - `answers` is two strings, and `answer` is one of them or null;\n   138\t    - `open` is a bool and every text field is a string.\n   139\t  - It returns the counts it judged: questions per class, evidence, sources.\n   140\t- **`check_origins(views_db, items_db, data, expected_as_of)`:** the pass condition. It is independent of the exporter's code path.\n   141\t  It derives everything it compares from the store, never from the package.\n   142\t  - **The bound: one rule for both commands.** `expected_as_of` is given by the caller.\n   143\t    - The builder passes the bound it resolved: `service.resolve_bound` on the requested day, or the default when none is given; an\n   144\t      omitted day with no default is refused.\n   145\t    - `check` passes the package's `as_of` through the same `service.resolve_bound`, which refuses a day after a store's last\n   146\t      completed day. A legacy ledger with no completed days accepts any valid date in both commands alike.\n   147\t    - The package's `as_of` must equal `expected_as_of`.\n   148\t  - **The class** of each question is derived from the stored measure and labels (`question_class`). The permitted keys and values\n   149\t    are then chosen from that class, never from the package's `class` field.\n   150\t  - **Order and counts.** The questions are compared as an ordered list in `created_seq, rowid` order, as `bundle.library` orders\n   151\t    them (`old-2/v2` and `v3` share sequence 8). Each question's evidence is compared in link order (`evidence_links.id`), and its\n   152\t    sources in row order (`evidence_sources.id`). A duplicate question, evidence record or source therefore fails.\n   153\t\n   154\t  It compares every field with its permitted stored source at the bound, by direct SQL:\n   155\t  - the question set equals the views visible at the bound, with `question` equal to `views.question`;\n   156\t  - `open` equals the latest visible switch's `open`;\n   157\t  - for `event` and `yes_no`: `answers` equal the rung labels in position order, and `answer` equals the label of the latest judgement\n   158\t    rung on or before the bound, or null;\n   159\t  - for `number`: only the marker;\n   160\t  - the evidence id set equals the links visible at the bound, minus those whose latest replacement is visible, computed in its own\n   161\t    SQL. Each evidence field equals the `evidence` row's column;\n   162\t  - each source list starts from every visible `evidence_sources` row, in row order, with `day` taken from\n   163\t    `evidence_sources.publication_day`. Each row needs a matching `items` row for `title`, `publisher` and `source_uri`; a row with no\n   164\t    item raises `ReleaseRefused` (a left join, so a missing item is never silently dropped).\n   165\t\n   166\t  Any difference raises `ReleaseRefused`, naming the question, the field and the evidence id. It returns the number of fields\n   167\t  compared.\n   168\t- **`stage(out_dir)`:** creates a private staging folder with a name unique to this invocation, `tempfile.mkdtemp(dir=out_dir.parent,\n   169\t  prefix='.<name>.staging-')`. Creation is exclusive, so only this invocation owns it. It returns the path.\n   170\t- **`write_package(data, staged)`:** writes `release-data.json` and `manifest.json` into the staging folder. It creates nothing\n   171\t  else.\n   172\t- **`publish(staged, out_dir)`:** one atomic move that refuses any existing destination, empty or not:\n   173\t  - on macOS, `renamex_np(staged, out_dir, RENAME_EXCL)` through `ctypes`. Verified on this Mac: onto a free path it succeeds; onto\n   174\t    an existing empty or non-empty folder it fails with `EEXIST`, and both folders stay as they were;\n   175\t  - on Linux, `renameat2(AT_FDCWD, staged, AT_FDCWD, out_dir, RENAME_NOREPLACE)`;\n   176\t  - where neither call exists, or the filesystem lacks support (`ENOTSUP`, `EINVAL`), it raises `ReleaseRefused`.\n   177\t\n   178\t  It never replaces, creates or removes anything at `out_dir` except by that one move.\n   179\t- **`check_package(path, views_db=None, items_db=None, expected_as_of=None)`:**\n   180\t  - the directory holds exactly `PACKAGE_FILES`, each a regular file and not a symbolic link (`os.lstat`), with no subdirectories;\n   181\t  - both files parse as JSON with no duplicate member name at any level (an `object_pairs_hook` that refuses a repeated key);\n   182\t  - the manifest has exactly its four keys, and its `format`, `allow_list` and `as_of` equal the data's;\n   183\t  - its sha256 equals the data file's;\n   184\t  - the data passes `check_export`, and, when the stores are given, `check_origins` with the expected bound;\n   185\t  - it returns the counts.\n   186\t- **`withheld_unresolved(views_db, data)`** is for the report only. It lists the number questions whose `service.ladder_bands(rungs)`\n   187\t  returns `(None, reason)`, with the reason and whether the view has a key. Its output never enters the package.\n   188\t\n   189\t`scripts/release_build.py`:\n   190\t- **`build --ledger --items [--as-of] --out`:**\n   191\t  1. refuse an existing `--out` or `<out>.report.json` early, as a convenience. The no-replace publication of each holds the\n   192\t     guarantee;\n   193\t  2. resolve the bound once: a given `--as-of` must be canonical `YYYY-MM-DD` (as above), then `service.resolve_bound`;\n   194\t  3. `stage(--out)`. From here a `finally` removes this staging folder while the build still owns it;\n   195\t  4. `release_export` at that bound;\n   196\t  5. `write_package` into the staging folder;\n   197\t  6. `check_package` on the staged folder, with the stores and the resolved bound;\n   198\t  7. `publish` to `--out`. The moment it succeeds, the build drops its staging path (`staged = None`); the `finally` then removes\n   199\t     nothing;\n   200\t  8. `publish_report`: write the report to a private temporary file in the same folder (`tempfile.mkstemp`), then `os.link` it to\n   201\t     `<out>.report.json`. The link fails with `EEXIST` if anything exists at that name. **A successful link is the moment the report\n   202\t     is published.** The temporary file is then removed. If that removal fails, the command still reports the report as published,\n   203\t     names the leftover temporary file, and exits 0.\n   204\t\n   205\t  The failure outcomes:\n   206\t  - **Before publication** (steps 2–7): any exception, whether `ReleaseRefused`, `OSError`, `sqlite3.Error` or another, prints the\n   207\t    reason and exits 1. The `finally` removes this build's staging folder; nothing exists at `--out` from this build. A corrected\n   208\t    retry at the same `--out` succeeds.\n   209\t  - **After publication, before the link** (step 8 fails before the link succeeds, including `EEXIST`): the package is final and\n   210\t    checked, and whatever is at the report name is untouched. Exit 2 with \"package published and checked; report not written; run\n   211\t    `check` to write it\".\n   212\t\n   213\t  It has no input path for prepared or translated JSON, and it takes no clock reading; the folder name is the caller's (D12, D13).\n   214\t- **`check <out> --ledger --items`:** re-runs `check_package` on an existing package, with the stores, the package's canonical\n   215\t  `as_of` validated against the store (above), and the regular-file and duplicate-key checks. It leaves the package in place, prints\n   216\t  the report, and writes `<out>.report.json` only through `publish_report`, so it never replaces anything. Its exit statuses:\n   217\t  - 0: the package passes, and the report was published;\n   218\t  - 2: the package passes, and the report is not published: its name is occupied (an earlier report, or anything else, which stays\n   219\t    untouched), or writing the temporary file or the link fails for any other reason, which is printed;\n   220\t  - 1: the package is refused, with the reason. This is also the retry after a report write failed. Its report gives `check_seconds` and marks\n   221\t  `export_seconds` as not measured.\n   222\t- **The report:**\n   223\t  - the store path and the bound;\n   224\t  - counts per class;\n   225\t  - the unresolved list;\n   226\t  - the fields compared;\n   227\t  - bytes;\n   228\t  - `export_seconds` (build only) and `check_seconds`.\n   229\t\n   230\t## 2. State × event (one export, read-only)\n   231\t\n   232\t| State / event | What happens | What is written | Day used |\n   233\t|---|---|---|---|\n   234\t| Store's first day still in progress | `FirstDayNotCompleted`; the build stops | nothing | none |\n   235\t| Store with no completed day and no judgement, `--as-of` omitted | refused: \"no default day; supply --as-of\" | nothing | none |\n   236\t| `--as-of` not a valid date (`2026-08-99`) | refused by `date.fromisoformat` | nothing | none |\n   237\t| `--as-of` valid but not canonical (`20260825`) | refused: the stores compare days as text, so a non-canonical day would read rows from later days | nothing | none |\n   238\t| The report name is occupied, by a file, a case-variant name of an input, or a symbolic link (build or `check`) | the build refuses at the start; a name occupied later makes `publish_report` fail with `EEXIST` and exit 2; `check` exits 2 after printing; whatever is there is untouched | the package only (build) | — |\n   239\t| `--as-of` after the last completed day | `BoundNotCompleted`; the build stops | nothing | requested day |\n   240\t| `--as-of` valid, before the first visible question | empty `questions`; the report says 0 | package | bound |\n   241\t| `--as-of` omitted | last completed day (a legacy ledger: its last judgement day) | package | resolved bound |\n   242\t| View created after the bound | not exported | — | bound |\n   243\t| View closed on or before the bound | `open: false`, with no reason and no day | — | bound |\n   244\t| Closed, then reopened, before the bound | the last visible switch wins | — | bound |\n   245\t| Event or Yes/No not yet judged at the bound | `answer: null` | — | bound |\n   246\t| Evidence replaced on or before the bound | excluded; the replacement is in force | — | bound |\n   247\t| Evidence replaced after the bound | kept | — | bound |\n   248\t| Source recorded after the bound | excluded | — | bound |\n   249\t| Visible source with no row in the items database | `ReleaseRefused`, naming the evidence and input id | nothing final | bound |\n   250\t| Store written by a live run | not supported. The builder is given a snapshot (AGENTS §9), and both connections are pinned | — | — |\n   251\t| `--out` exists, empty or not, at the start | refused early; `publish` would also refuse | nothing | — |\n   252\t| `check_export`, `check_package` or `check_origins` refuses | this build's staging folder is removed, exit non-zero | nothing final | — |\n   253\t| A write, check or move fails, or a database error (`sqlite3.Error`, such as an items database with no `items` table) | exit 1; the `finally` removes this build's staging; a corrected retry at the same `--out` succeeds | nothing | — |\n   254\t| A folder, empty or not, appears at `--out` after staging | `publish` refuses with `EEXIST`; that folder is untouched; staging removed; exit 1 | nothing of this build | — |\n   255\t| The filesystem has no atomic no-replace move | `publish` refuses; staging removed; exit 1 | nothing | — |\n   256\t| Crash while staging | a uniquely named staging folder is left as debris. Nothing is at `--out`, and no later build is blocked | staging only | — |\n   257\t| Crash after the rename, before the report | the package is final and checked; `check` rewrites the report | package | — |\n   258\t| The report write fails after publication | exit 2: the package is final and checked; `check` regenerates the report | package | — |\n   259\t| Two builds aimed at one `--out` | each stages privately; the first `publish` wins; the second's `publish` refuses with `EEXIST`, and its `finally` removes only its own staging | the winner's package | — |\n   260\t| Package `as_of` later than the store's last completed day (`check`) | refused by `resolve_bound` | nothing | package `as_of` |\n   261\t| A legacy ledger with no completed days, explicit day | the build and `check` both accept any valid date (one rule) | package | requested day |\n   262\t| A package file is a symbolic link, or a JSON member name repeats | `check_package` refuses | nothing | — |\n   263\t| The package's `class` disagrees with the store's (a Yes/No answer replaced by the marker) | `check_origins` refuses: class is derived from the store | nothing final | bound |\n   264\t| Store or configuration changed between builds | each package records its bound and data sha256; the report names the store path | — | — |\n   265\t| Legacy ledger: no `view_keys` table, `是`/`否` labels | no key, so no event; the labels canonicalise to Yes/No | — | — |\n   266\t\n   267\t## 3. Value × reader\n   268\t\n   269\tReaders of the package:\n   270\t- `check_package` and `check_origins`;\n   271\t- the release page (slice 2);\n   272\t- the tests.\n   273\t\n   274\tThe report's reader is the person building. No POC code imports `release`.\n   275\t\n   276\t| Value | Permitted source at the bound | Checked by |\n   277\t|---|---|---|\n   278\t| `id`, `question` | `views.view_id`, `views.question` | `check_origins` |\n   279\t| `open` | the latest visible `view_switches.open` | `check_origins` |\n   280\t| `class` | `view_keys.measure`, `rungs.label` | `check_origins` derives it from the store; tests and mutants check the identity rule |\n   281\t| `answers`, `answer` | `rungs.label` by position; the latest `judgements.rung` on or before the bound | `check_origins` |\n   282\t| `forecast` | the constant marker | `check_export` |\n   283\t| evidence fields | the `evidence` row; visible `evidence_links` minus visible replacements | `check_origins` |\n   284\t| source fields | every visible `evidence_sources` row (`publication_day` as `day`); its `items` row's `title`, `publisher`, `source_uri`, required | `check_origins` (left join; a missing item refuses) |\n   285\t| manifest | the data's `format`, `allow_list`, `as_of`; the data sha256 | `check_package` |\n   286\t| report (outside the package) | `ladder_bands` per number question; counts | read by the builder's user |\n   287\t\n   288\t**Never read by `release_export`:**\n   289\t- `rungs.condition`, `lo`, `hi`;\n   290\t- `judgements.reasons`, `why_changed`, `implied_outcome`, `reference`, `pushes_json`, `theme_pushes_json`, `cited_*`;\n   291\t- `view_switches.reason`;\n   292\t- `clean_ladders`;\n   293\t- `thesis_groups`;\n   294\t- `dependencies`, `successions`.\n   295\t\n   296\t## 4. New path × old checks\n   297\t\n   298\t| Check on the old path (`bundle.library`, `view_bundle`, `service`) | New path |\n   299\t|---|---|\n   300\t| `resolve_bound`: unfinished first day, future bound | same call |\n   301\t| `bundle.library`: no default day refused; `date.fromisoformat` | same two checks |\n   302\t| A view not visible at the bound is not served | same `view_exists` |\n   303\t| Sources visible at the bound; replacements applied | same `service.evidence`, verified independently by `check_origins` |\n   304\t| Pinned read transaction | same `bundle.read_snapshot` |\n   305\t| `item_lookup` falls back to the id for a missing item | refused instead |\n   306\t| A malformed `clean_ladders` row is refused | not read |\n   307\t| Corrupt judgement JSON is refused | no JSON column read |\n   308\t| The UI contract rejects unknown fields | the release's own `check_export`; the page's reading of it is slice 2 |\n   309\t\n   310\t## 5. Prior decisions\n   311\t\n   312\t- D726: number questions show sources and \"Forecast unavailable\", with band, forecast text and history withheld together.\n   313\t- D756: Alex's choice.\n   314\t- D757: the design, revision 4.\n   315\t- D758: the release is opened; §4 (a); order.\n   316\t- D12/D13: no clock.\n   317\t- D163: English product text.\n   318\t- D690: poc-v118 stays the product.\n   319\t- D261: the ruler is untouched.\n   320\t- D274: the extraction prompt is frozen.\n   321\t\n   322\t## 6. Tests (`tests/test_release.py`) and mutants\n   323\t\n   324\tThe fixtures use a real store on a temporary path (`store.create_view`, `store.insert`), with a real items database. Each test names\n   325\tits row above:\n","exit_code":0,"status":"completed"}}
