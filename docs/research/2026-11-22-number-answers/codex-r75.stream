{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc 'nl -ba /private/tmp/claude-501/-Users-lchingen-hivemind/f1ea972d-85a1-4f27-8010-cf0b60054109/scratchpad/release_mutants.py'","aggregated_output":"     1\t\"\"\"RELEASE-BUILD.md §6 mutants: each applied to a scratch copy (PYTHONDONTWRITEBYTECODE, no __pycache__) must fail\n     2\ttests/test_release.py; the unmutated control must pass.\"\"\"\n     3\timport shutil\n     4\timport subprocess\n     5\timport sys\n     6\timport tempfile\n     7\tfrom pathlib import Path\n     8\t\n     9\tREPO = Path('/Users/lchingen/hivemind')\n    10\tR, B = 'src/hivemind/release.py', 'scripts/release_build.py'\n    11\tMUTANTS = {\n    12\t    'condition emitted on number records': (R, \"                record['forecast'] = FORECAST_UNAVAILABLE\\n            else:\\n                record['answers'] = labels\\n                record['answer'] = _answer(\",\n    13\t                                            \"                record['forecast'] = FORECAST_UNAVAILABLE\\n                record['condition'] = 'FY2027 revenue is at least $350 billion'\\n            else:\\n                record['answers'] = labels\\n                record['answer'] = _answer(\"),\n    14\t    'one_line from the latest why_changed': (R, \"evidence.append({'id': piece['evidence_id'], **{name: piece[name] for name in EVIDENCE_TEXT}, 'sources': sources})\",\n    15\t                                             \"evidence.append({'id': piece['evidence_id'], **{name: piece[name] for name in EVIDENCE_TEXT}, 'sources': sources, 'one_line': (views_db.execute('select why_changed from judgements where view_id=? order by judgement_id desc limit 1', (view_id,)).fetchone() or {'why_changed': piece['one_line']})['why_changed']})\"),\n    16\t    'event test removed': (R, \"    if key_measure(conn, view_id) in identity.EVENT_MEASURES:\\n        return 'event'\\n\", ''),\n    17\t    'Yes/No test removed': (R, \"    if len(labels) == 2 and {vocabulary.canonical('label', label) for label in labels} == {'Yes', 'No'}:\\n        return 'yes_no'\\n\", ''),\n    18\t    'check_package without the file-set check': (R, \"    if sorted(names) != sorted(PACKAGE_FILES):\\n        raise\", \"    if False:\\n        raise\"),\n    19\t    'manifest keys unchecked': (R, \"    _keys(manifest, 'manifest', 'the manifest')\\n\", ''),\n    20\t    'check_export without the closed-key check': (R, \"    if set(value) != ALLOWED[kind]:\", \"    if not set(value) >= ALLOWED[kind]:\"),\n    21\t    'check_origins skipping evidence fields': (R, \"            record['evidence'] = _expected_evidence(views_db, items_db, view_id, as_of)\\n            compared +=\",\n    22\t                                               \"            record['evidence'] = question['evidence']\\n            compared +=\"),\n    23\t    'check_origins taking the class from the package': (R, \"            kind = question_class(views_db, view_id, labels)\\n            record = {'id': view_id, 'question': view['question'], 'open': _open_at(\",\n    24\t                                                        \"            kind = question['class']\\n            record = {'id': view_id, 'question': view['question'], 'open': _open_at(\"),\n    25\t    'check_origins comparing sets': (R, \"        packaged = data['questions']\\n\", \"        packaged = list({q['id']: q for q in data['questions']}.values())\\n\"),\n    26\t    'check_origins with an inner join': (R, \"            if item is None:\\n                raise ReleaseRefused(f'evidence {row[\\\"evidence_id\\\"]}\", \"            if item is None:\\n                continue\\n                raise ReleaseRefused(f'evidence {row[\\\"evidence_id\\\"]}\"),\n    27\t    'check without validating the day': (R, \"        bound = expected_as_of if expected_as_of is not None else resolve(views_db, data['as_of'])\",\n    28\t                                         \"        bound = expected_as_of if expected_as_of is not None else data['as_of']\"),\n    29\t    'builder skipping the staged check': (B, \"counts = release.check_package(staged, views_db, items_db, expected_as_of=bound)\", \"counts = release.check_export(data)\"),\n    30\t    'symbolic-link check removed': (R, \"        if not stat.S_ISREG(os.lstat(path / name).st_mode):\", \"        if not stat.S_ISREG(os.stat(path / name).st_mode):\"),\n    31\t    'duplicate-key check removed': (R, \"    if len(names) != len(set(names)):\", \"    if False:\"),\n    32\t    'switch reason emitted': (R, \"            record = {'id': view_id, 'question': view['question'], 'open': service.is_open_as_of(views_db, view_id, bound), 'class': kind}\",\n    33\t                              \"            record = {'id': view_id, 'question': view['question'], 'open': service.is_open_as_of(views_db, view_id, bound), 'class': kind, 'reason': (views_db.execute('select reason from view_switches where view_id=? order by id desc', (view_id,)).fetchone() or {'reason': ''})['reason']}\"),\n    34\t    'missing-item refusal replaced by the id fallback': (R, \"        if row is None:\\n            raise ReleaseRefused(f'source item {input_id} is not in the items database')\",\n    35\t                                                         \"        if row is None:\\n            row = {'title': input_id, 'publisher': '', 'source_uri': ''}\"),\n    36\t    'publish replaced by os.rename': (R, \"    rename = _no_replace_rename()\\n    if rename is None:\", \"    rename = lambda source, target: os.rename(source, target) or 0\\n    if rename is None:\"),\n    37\t    'the finally removed': (B, \"        if staged is not None:\\n            shutil.rmtree(staged)\\n\", ''),\n    38\t    'staging path not dropped after publish': (B, \"        staged = None                       # published\", \"        pass                                # published\"),\n    39\t    'canonical-day check removed': (R, \"    if day.isoformat() != text:\\n        raise ReleaseRefused\", \"    if False:\\n        raise ReleaseRefused\"),\n    40\t    'publish_report replaced by os.replace': (R, \"        os.link(temporary, path)\\n\", \"        os.replace(temporary, path)\\n        open(temporary, 'w').close()\\n\"),\n    41\t}\n    42\t\n    43\t\n    44\tdef tree(where):\n    45\t    root = Path(where)\n    46\t    shutil.copytree(REPO / 'src', root / 'src', ignore=shutil.ignore_patterns('__pycache__'))\n    47\t    shutil.copytree(REPO / 'scripts', root / 'scripts', ignore=shutil.ignore_patterns('__pycache__'))\n    48\t    (root / 'tests').mkdir()\n    49\t    for name in ('test_release.py', 'conftest.py'):\n    50\t        shutil.copy(REPO / 'tests' / name, root / 'tests' / name)\n    51\t    return root\n    52\t\n    53\t\n    54\tdef run(root):\n    55\t    return subprocess.run([sys.executable, '-m', 'pytest', 'tests/test_release.py', '-q', '-p', 'no:cacheprovider'], cwd=root, capture_output=True, text=True,\n    56\t                          env={'PATH': '/usr/bin:/bin:/usr/local/bin:/opt/homebrew/bin', 'PYTHONPATH': f'{root}/src:{root}/poc', 'PYTHONDONTWRITEBYTECODE': '1', 'HOME': str(Path.home())}, timeout=900)\n    57\t\n    58\t\n    59\twith tempfile.TemporaryDirectory() as base:\n    60\t    control = run(tree(Path(base) / 'control'))\n    61\t    print('control:', 'PASS' if control.returncode == 0 else 'FAIL', control.stdout.strip().splitlines()[-1])\n    62\t    caught = 0\n    63\t    for n, (name, (relative, old, new)) in enumerate(MUTANTS.items()):\n    64\t        root = tree(Path(base) / f'm{n}')\n    65\t        path = root / relative\n    66\t        text = path.read_text()\n    67\t        assert text.count(old) == 1, (name, text.count(old))\n    68\t        path.write_text(text.replace(old, new))\n    69\t        result = run(root)\n    70\t        failed = [line.split(' ')[1].split('::')[-1] for line in result.stdout.splitlines() if line.startswith('FAILED')]\n    71\t        caught += result.returncode != 0\n    72\t        print(f'{\"CAUGHT\" if result.returncode else \"MISSED\"}  {name}: {len(failed)} failing: {\", \".join(failed[:6])}')\n    73\t    print(f'{caught} of {len(MUTANTS)} mutants caught')\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc 'nl -ba tests/test_release.py'","aggregated_output":"     1\t\"\"\"The \"Forecast unavailable\" release package (docs/research/2026-11-22-number-answers/RELEASE-BUILD.md, revision 10; D726, D758).\n     2\t\n     3\tEach test names the design row it proves (§1 the closed set and the checks, §2 state × event, §6 the numbered tests). The stores are\n     4\treal SQLite files on a temporary path; the only edits of code are the mutation-procedure scratch copies of §6 tests 12, 14, 19, 20\n     5\tand 21, which insert a pause or a fault into a copy of the module and the command.\"\"\"\n     6\timport hashlib\n     7\timport json\n     8\timport os\n     9\timport shutil\n    10\timport sqlite3\n    11\timport subprocess\n    12\timport sys\n    13\timport time\n    14\tfrom pathlib import Path\n    15\t\n    16\timport pytest\n    17\t\n    18\tROOT = Path(__file__).resolve().parents[1]\n    19\tsys.path.insert(0, str(ROOT / 'src'))\n    20\tfrom hivemind import release, service  # noqa: E402\n    21\tfrom hivemind.views import store  # noqa: E402\n    22\t\n    23\tCOMMAND = ROOT / 'scripts' / 'release_build.py'\n    24\tDAYS = ['2026-08-24', '2026-08-25', '2026-08-26']\n    25\tASSET_LABELS = ['Strongly bullish', 'Bullish', 'Neutral', 'Bearish', 'Strongly bearish']\n    26\tV1_CONDITIONS = ['FY2027 revenue is at least $400 billion.', 'FY2027 revenue is at least $350 billion and less than $400 billion.',\n    27\t                 'FY2027 revenue is at least $300 billion and less than $350 billion.', 'FY2027 revenue is at least $250 billion and less than $300 billion.',\n    28\t                 'FY2027 revenue is less than $250 billion.']\n    29\tV1_BOUNDS = [(400e9, None), (350e9, 400e9), (300e9, 350e9), (250e9, 300e9), (None, 250e9)]\n    30\tV1_REASONS = 'The first-half figure and the third-quarter guide support an estimate of about $390 billion for the year.'\n    31\tV1_WHY = 'Moved up to the $350 billion to under $400 billion rung on the raised guide.'\n    32\tV5_WHY = 'Spending of around $1 trillion in 2027 makes acceleration likely.'\n    33\tV6_WHY = 'The revenue question now sits in the $350 billion to under $400 billion rung, which the rule would cut.'\n    34\tCLOSING = 'due 2026-08-25, frozen on 2026-08-25 at rung 2 Bullish'\n    35\t\n    36\t\n    37\tdef make_items(path, ids=('item-1', 'item-2', 'item-3')):\n    38\t    conn = sqlite3.connect(path)\n    39\t    conn.execute('create table items (input_id text primary key, title text, publisher text, publisher_type text, category text, publication_day text, source_uri text)')\n    40\t    for n, input_id in enumerate(ids, 1):\n    41\t        conn.execute('insert into items values (?,?,?,?,?,?,?)', (input_id, f'Article {n} on data-center spending', f'Publisher {n}', 'news', 'T1',\n    42\t                                                                 DAYS[min(n, 3) - 1], f'https://example.com/article-{n}'))\n    43\t    conn.commit()\n    44\t    conn.close()\n    45\t    return path\n    46\t\n    47\t\n    48\tdef five_rungs(conditions, bounds=None):\n    49\t    return [dict(label=label, condition=condition, **({'lo': lo, 'hi': hi} if bounds else {}))\n    50\t            for label, condition, (lo, hi) in zip(ASSET_LABELS, conditions, bounds or [(None, None)] * 5)]\n    51\t\n    52\t\n    53\tdef key(conn, view_id, measure, event_type='n/a'):\n    54\t    store.insert(conn, 'view_keys', view_id=view_id, measure=measure, scope='NVIDIA', scope_key='nvidia', period_start='2026-02-01',\n    55\t                 period_end='2027-01-31', basis='n/a', unit='USD', event_type=event_type, seq=1, scope_source='model', key_version=1)\n    56\t\n    57\t\n    58\tdef judge(conn, view_id, seq, rung, why, reasons='', implied=None):\n    59\t    store.insert(conn, 'judgements', view_id=view_id, seq=seq, input_id=f'item-{seq}', rung=rung, reasons=reasons, cited_evidence_json='[]',\n    60\t                 cited_views_json='[]', pushes_json='[]', changed=1, why_changed=why, publication_day=DAYS[seq - 1], theme_pushes_json='[]',\n    61\t                 reference=None, implied_outcome=implied)\n    62\t\n    63\t\n    64\tdef evidence(conn, evidence_id, view_id, seq, one_line, quote, sources):\n    65\t    store.insert(conn, 'evidence', evidence_id=evidence_id, quote=quote, one_line=one_line, speaker='Publisher', original_who='NVIDIA',\n    66\t                 original_day=DAYS[seq - 1], tier='party_statement', event_time=None, created_seq=seq, created_from_input=f'item-{seq}')\n    67\t    store.insert(conn, 'evidence_links', evidence_id=evidence_id, view_id=view_id, seq=seq)\n    68\t    for input_id, source_seq in sources:\n    69\t        store.insert(conn, 'evidence_sources', evidence_id=evidence_id, input_id=input_id, category='T1', publication_day=DAYS[source_seq - 1], seq=source_seq)\n    70\t\n    71\t\n    72\tdef make_store(path):\n    73\t    \"\"\"§6 fixture: three completed days; a number question with bounds (v1), one whose conditions resolve without a key (v2), unresolved\n    74\t    ones with a key (v3) and without (v4), a Yes/No question with numeric bounds (v5), an event (v6) and a closed number question (v7).\"\"\"\n    75\t    conn = store.open_db(str(path))\n    76\t    for seq, day in enumerate(DAYS, 1):\n    77\t        store.insert(conn, 'processing_steps', input_id=f'item-{seq}', sequence_no=seq, step='handed_over', result='ok', publication_day=day)\n    78\t        store.insert(conn, 'days_completed', day=day, seq=seq)\n    79\t    common = dict(object_id='NVDA', object_kind='company', kind='asset', due_day='2027-02-25', year='2027', seq=1, input_id='item-1', created_at='2026-08-24T12:00:00Z')\n    80\t    store.create_view(conn, view_id='v1', looks_at='NVIDIA revenue in FY2027', question='How much revenue will NVIDIA report for FY2027?', rungs=five_rungs(V1_CONDITIONS, V1_BOUNDS), **common)\n    81\t    key(conn, 'v1', 'revenue')\n    82\t    store.create_view(conn, view_id='v2', looks_at='NVIDIA FY2027 capital spending', question='How much will NVIDIA spend on capital in FY2027?',\n    83\t                      rungs=[{'label': '看多', 'condition': '不低于4000亿美元'}, {'label': '看空', 'condition': '低于4000亿美元'}], **common)\n    84\t    unreadable = ['Revenue is clearly strong.', 'Revenue is strong.', 'Revenue is flat.', 'Revenue is weak.', 'Revenue is clearly weak.']\n    85\t    store.create_view(conn, view_id='v3', looks_at='NVIDIA gaming revenue', question='How much gaming revenue will NVIDIA report for FY2027?', rungs=five_rungs(unreadable), **common)\n    86\t    key(conn, 'v3', 'segment_revenue')\n    87\t    store.create_view(conn, view_id='v4', looks_at='NVIDIA auto revenue', question='How much automotive revenue will NVIDIA report for FY2027?', rungs=five_rungs(unreadable), **common)\n    88\t    store.create_view(conn, view_id='v5', looks_at='Hyperscaler capex growth', question='Will hyperscaler capital spending growth accelerate in 2027?',\n    89\t                      rungs=[{'label': 'Yes', 'condition': 'Growth above zero', 'lo': 0.0, 'hi': None}, {'label': 'No', 'condition': 'Growth at or below zero', 'lo': None, 'hi': 0.0}], **common)\n    90\t    key(conn, 'v5', 'growth_rate')\n    91\t    store.create_view(conn, view_id='v6', looks_at='US export restriction', question='Will the US adopt the chip export restriction by 2027-01-31?',\n    92\t                      rungs=[{'label': 'Restriction adopted', 'condition': 'The rule is adopted'}, {'label': 'No restriction adopted', 'condition': 'The rule is not adopted'}], **common)\n    93\t    key(conn, 'v6', 'policy_event', 'regulation')\n    94\t    store.create_view(conn, view_id='v7', looks_at='NVIDIA Q2 revenue', question='How much revenue will NVIDIA report for Q2 FY2027?', rungs=five_rungs(V1_CONDITIONS, V1_BOUNDS), **common)\n    95\t    key(conn, 'v7', 'revenue')\n    96\t    judge(conn, 'v1', 1, 2, V1_WHY, V1_REASONS, 'About $390 billion')\n    97\t    judge(conn, 'v5', 1, 1, V5_WHY)\n    98\t    judge(conn, 'v6', 1, 2, V6_WHY)\n    99\t    judge(conn, 'v7', 1, 2, 'Held at the Bullish rung.')\n   100\t    store.insert(conn, 'view_switches', view_id='v7', open=0, reason=CLOSING, by_whom='pull', after_seq=2)\n   101\t    evidence(conn, 'e1', 'v1', 1, 'NVIDIA reported $164 billion of revenue in the first half.', 'The company generated $164 billion in the first six months.', [('item-1', 1), ('item-3', 3)])\n   102\t    evidence(conn, 'e2', 'v1', 3, 'Morningstar estimates $361 billion of revenue for the year.', 'We estimate it will be $361 billion in fiscal 2027.', [('item-3', 3)])\n   103\t    evidence(conn, 'e3', 'v1', 1, 'An early report put spending at $90 billion.', 'Spending was $90 billion, the report said.', [('item-1', 1)])\n   104\t    evidence(conn, 'e4', 'v1', 2, 'A corrected report put spending at $95 billion.', 'Spending was $95 billion, the corrected report said.', [('item-2', 2)])\n   105\t    store.insert(conn, 'replacements', old_evidence_id='e3', new_evidence_id='e4', said_day=DAYS[1], seq=2)\n   106\t    evidence(conn, 'e5', 'v6', 1, 'Officials said the export rule is under review.', 'The rule is under review, officials said.', [('item-1', 1)])\n   107\t    evidence(conn, 'e6', 'v5', 1, 'Bullish confirmation would need firm orders, the author said.', 'Bullish confirmation would require firm procurement commitments.', [('item-2', 1)])\n   108\t    conn.commit()\n   109\t    conn.close()\n   110\t    return path\n   111\t\n   112\t\n   113\t@pytest.fixture\n   114\tdef stores(tmp_path):\n   115\t    return make_store(tmp_path / 'views.sqlite'), make_items(tmp_path / 'items.sqlite')\n   116\t\n   117\t\n   118\tdef export(stores, as_of=None):\n   119\t    views_db, items_db = service.open_ledger(str(stores[0])), store.open_read_only(str(stores[1]))\n   120\t    try:\n   121\t        return release.release_export(views_db, items_db, as_of)\n   122\t    finally:\n   123\t        views_db.close()\n   124\t        items_db.close()\n   125\t\n   126\t\n   127\tdef strings(value):\n   128\t    \"\"\"Every decoded string in the package (keys excluded).\"\"\"\n   129\t    if isinstance(value, dict):\n   130\t        return [s for v in value.values() for s in strings(v)]\n   131\t    if isinstance(value, list):\n   132\t        return [s for v in value for s in strings(v)]\n   133\t    return [value] if isinstance(value, str) else []\n   134\t\n   135\t\n   136\tdef by_id(data):\n   137\t    return {q['id']: q for q in data['questions']}\n   138\t\n   139\t\n   140\tdef run(*args, cwd=None):\n   141\t    return subprocess.run([sys.executable, str(COMMAND), *map(str, args)], capture_output=True, text=True, cwd=cwd,\n   142\t                          env={**os.environ, 'PYTHONDONTWRITEBYTECODE': '1'}, timeout=120)\n   143\t\n   144\t\n   145\tdef build_package(stores, out, as_of=None):\n   146\t    views_db, items_db = service.open_ledger(str(stores[0])), store.open_read_only(str(stores[1]))\n   147\t    try:\n   148\t        data = release.release_export(views_db, items_db, as_of)\n   149\t        staged = release.stage(out)\n   150\t        release.write_package(data, staged)\n   151\t        release.check_package(staged, views_db, items_db, expected_as_of=data['as_of'])\n   152\t        release.publish(staged, out)\n   153\t        return data\n   154\t    finally:\n   155\t        views_db.close()\n   156\t        items_db.close()\n   157\t\n   158\t\n   159\tdef rewrite_data(package, data):\n   160\t    \"\"\"A copy of the package's data with its manifest hash refreshed, so every other check still passes.\"\"\"\n   161\t    payload = json.dumps(data, ensure_ascii=False, separators=(',', ':')).encode()\n   162\t    (package / release.DATA_FILE).write_bytes(payload)\n   163\t    manifest = json.loads((package / release.MANIFEST_FILE).read_text())\n   164\t    manifest.update(as_of=data['as_of'], data_sha256=hashlib.sha256(payload).hexdigest())\n   165\t    (package / release.MANIFEST_FILE).write_text(json.dumps(manifest))\n   166\t\n   167\t\n   168\tdef check(stores, package):\n   169\t    views_db, items_db = service.open_ledger(str(stores[0])), store.open_read_only(str(stores[1]))\n   170\t    try:\n   171\t        return release.check_package(package, views_db, items_db)\n   172\t    finally:\n   173\t        views_db.close()\n   174\t        items_db.close()\n   175\t\n   176\t\n   177\t# ---------- §6 tests 1–8: the export\n   178\t\n   179\t\n   180\tdef test_1_every_object_holds_exactly_its_record_types_keys(stores):\n   181\t    \"\"\"§1 ALLOWED, §6 test 1: the export passes the closed-set check; one added key fails it.\"\"\"\n   182\t    data = export(stores)\n   183\t    counts = release.check_export(data)\n   184\t    assert counts['questions'] == {'number': 5, 'event': 1, 'yes_no': 1} and counts['evidence'] == 5\n   185\t    assert set(by_id(data)['v1']) == release.ALLOWED['number'] and set(by_id(data)['v6']) == release.ALLOWED['answered']\n   186\t    by_id(data)['v1']['condition'] = V1_CONDITIONS[1]\n   187\t    with pytest.raises(release.ReleaseRefused, match='off the allow-list'):\n   188\t        release.check_export(data)\n   189\t\n   190\t\n   191\tdef test_2_number_question_carries_only_the_marker_and_its_evidence(stores):\n   192\t    \"\"\"§6 test 2 (D726): no rung label, condition, reason, explanation or implied outcome of v1 reaches any decoded field.\"\"\"\n   193\t    data = export(stores)\n   194\t    v1 = by_id(data)['v1']\n   195\t    assert v1['class'] == 'number' and v1['forecast'] == release.FORECAST_UNAVAILABLE\n   196\t    assert [e['id'] for e in v1['evidence']] == ['e1', 'e2', 'e4']\n   197\t    texts = strings(data)\n   198\t    for forbidden in [*V1_CONDITIONS, V1_REASONS, V1_WHY, 'About $390 billion', 'Strongly bullish', 'Neutral', 'Strongly bearish']:\n   199\t        assert not any(forbidden in text for text in texts), forbidden\n   200\t\n   201\t\n   202\tdef test_3_identity_branches_and_the_unresolved_report(stores):\n   203\t    \"\"\"§1 question_class, §6 test 3: a condition-only ladder that resolves and unresolved ladders with and without a key are all\n   204\t    number questions; only the unresolved two are listed.\"\"\"\n   205\t    data = export(stores)\n   206\t    assert {q['id']: q['class'] for q in data['questions']} == {'v1': 'number', 'v2': 'number', 'v3': 'number', 'v4': 'number', 'v5': 'yes_no', 'v6': 'event', 'v7': 'number'}\n   207\t    views_db = service.open_ledger(str(stores[0]))\n   208\t    try:\n   209\t        listed = {entry['id']: entry['has_key'] for entry in release.withheld_unresolved(views_db, data)}\n   210\t    finally:\n   211\t        views_db.close()\n   212\t    assert listed == {'v3': True, 'v4': False}\n   213\t\n   214\t\n   215\tdef test_4_yes_no_with_numeric_bounds_keeps_its_label_not_its_explanation(stores):\n   216\t    \"\"\"§6 test 4 (§4 a): v5 is Yes/No with its answer; its explanation quoting $1 trillion is absent.\"\"\"\n   217\t    data = export(stores)\n   218\t    v5 = by_id(data)['v5']\n   219\t    assert (v5['class'], v5['answers'], v5['answer']) == ('yes_no', ['Yes', 'No'], 'Yes')\n   220\t    assert not any('$1 trillion' in text for text in strings(data))\n   221\t\n   222\t\n   223\tdef test_5_event_keeps_its_labels_not_its_explanation(stores):\n   224\t    \"\"\"§6 test 5: an event with the served ledger's labels keeps them; its explanation quoting v1's rung is absent.\"\"\"\n   225\t    data = export(stores)\n   226\t    v6 = by_id(data)['v6']\n   227\t    assert (v6['class'], v6['answers'], v6['answer']) == ('event', ['Restriction adopted', 'No restriction adopted'], 'No restriction adopted')\n   228\t    assert not any(V6_WHY in text for text in strings(data))\n   229\t\n   230\t\n   231\tdef test_6_legacy_ledger_without_a_key_table_reads_chinese_yes_no(tmp_path):\n   232\t    \"\"\"§6 test 6, §2 legacy row: no view_keys table; 是/否 labels are Yes/No.\"\"\"\n   233\t    path = tmp_path / 'legacy.sqlite'\n   234\t    conn = store.open_db(str(path))\n   235\t    conn.execute('drop table view_keys')\n   236\t    store.insert(conn, 'processing_steps', input_id='item-1', sequence_no=1, step='handed_over', result='ok', publication_day=DAYS[0])\n   237\t    store.insert(conn, 'days_completed', day=DAYS[0], seq=1)\n   238\t    store.create_view(conn, view_id='v1', object_id='NVDA', object_kind='company', kind='asset', looks_at='Shipments', question='会开始量产出货吗？',\n   239\t                      due_day='2026-12-31', year='2026', rungs=[{'label': '是', 'condition': '开始出货'}, {'label': '否', 'condition': '未开始出货'}],\n   240\t                      seq=1, input_id='item-1', created_at='2026-08-24T12:00:00Z')\n   241\t    judge(conn, 'v1', 1, 1, '已确认出货。')\n   242\t    conn.commit()\n   243\t    conn.close()\n   244\t    data = export((path, make_items(tmp_path / 'items.sqlite')))\n   245\t    assert (data['questions'][0]['class'], data['questions'][0]['answer']) == ('yes_no', '是')\n   246\t\n   247\t\n   248\tdef test_7_closed_question_shows_closed_without_its_reason(stores):\n   249\t    \"\"\"§6 test 7, §2 closing row: v7 is closed at 08-25; the closing reason naming its rung is absent.\"\"\"\n   250\t    assert by_id(export(stores, DAYS[0]))['v7']['open'] is True\n   251\t    data = export(stores)\n   252\t    assert by_id(data)['v7']['open'] is False\n   253\t    assert not any(CLOSING in text or 'frozen on' in text for text in strings(data))\n   254\t\n   255\t\n   256\tdef test_8_replacements_and_sources_follow_the_day_and_missing_items_refuse(stores, tmp_path):\n   257\t    \"\"\"§6 test 8, §2 replacement and source rows: e3 is in force until its replacement on 08-25; e1's second source appears on 08-26;\n   258\t    a visible source with no item is refused.\"\"\"\n   259\t    early, late = by_id(export(stores, DAYS[0]))['v1'], by_id(export(stores))['v1']\n   260\t    assert [e['id'] for e in early['evidence']] == ['e1', 'e3']\n   261\t    assert [e['id'] for e in late['evidence']] == ['e1', 'e2', 'e4']\n   262\t    assert [s['day'] for s in early['evidence'][0]['sources']] == [DAYS[0]]\n   263\t    assert [s['day'] for s in late['evidence'][0]['sources']] == [DAYS[0], DAYS[2]]\n   264\t    short = make_items(tmp_path / 'short.sqlite', ids=('item-1', 'item-2'))\n   265\t    with pytest.raises(release.ReleaseRefused, match='item-3 is not in the items database'):\n   266\t        export((stores[0], short))\n   267\t\n   268\t\n   269\t# ---------- §6 tests 9, 10, 13, 15, 16: the package and the origin check\n   270\t\n   271\t\n   272\tdef test_9_package_files_hash_and_manifest(stores, tmp_path):\n   273\t    \"\"\"§1 check_package, §6 test 9.\"\"\"\n   274\t    out = tmp_path / 'release'\n   275\t    data = build_package(stores, out)\n   276\t    assert check(stores, out)['fields_compared'] > 0\n   277\t    variants = {\n   278\t        'foreign file': lambda p: (p / 'notes.txt').write_text('x'),\n   279\t        'subdirectory': lambda p: (p / 'extra').mkdir(),\n   280\t        'changed byte': lambda p: (p / release.DATA_FILE).write_bytes((p / release.DATA_FILE).read_bytes().replace(b'Morningstar', b'Morningstan')),\n   281\t        'manifest prose': lambda p: (p / release.MANIFEST_FILE).write_text(json.dumps({**json.loads((p / release.MANIFEST_FILE).read_text()), 'note': 'About $390 billion'})),\n   282\t        'manifest day': lambda p: (p / release.MANIFEST_FILE).write_text(json.dumps({**json.loads((p / release.MANIFEST_FILE).read_text()), 'as_of': DAYS[0]})),\n   283\t    }\n   284\t    for name, damage in variants.items():\n   285\t        copy = tmp_path / f'copy-{name.replace(\" \", \"-\")}'\n   286\t        shutil.copytree(out, copy)\n   287\t        damage(copy)\n   288\t        with pytest.raises(release.ReleaseRefused):\n   289\t            check(stores, copy)\n   290\t    with pytest.raises(FileExistsError):\n   291\t        staged = release.stage(out)\n   292\t        release.write_package(data, staged)\n   293\t        release.publish(staged, out)\n   294\t    (tmp_path / '.other.staging-x').mkdir()            # another build's debris blocks nothing\n   295\t    assert build_package(stores, tmp_path / 'other')\n   296\t\n   297\t\n   298\tdef test_10_origin_check_derives_everything_from_the_store(stores, tmp_path):\n   299\t    \"\"\"§1 check_origins, §6 test 10: a forecast in a summary, a class swap, duplicates and a future day are each refused.\"\"\"\n   300\t    out = tmp_path / 'release'\n   301\t    data = build_package(stores, out)\n   302\t    cases = {}\n   303\t    forged = json.loads(json.dumps(data))\n   304\t    by_id(forged)['v1']['evidence'][1]['one_line'] = 'About $390 billion'\n   305\t    cases['forecast in a summary'] = (forged, 'one_line')\n   306\t    swapped = json.loads(json.dumps(data))\n   307\t    v5 = by_id(swapped)['v5']\n   308\t    for name in ('answers', 'answer'):\n   309\t        del v5[name]\n   310\t    v5.update({'class': 'number', 'forecast': release.FORECAST_UNAVAILABLE})\n   311\t    cases['class swap'] = (swapped, 'v5')\n   312\t    doubled = json.loads(json.dumps(data))\n   313\t    doubled['questions'].insert(1, doubled['questions'][0])\n   314\t    cases['duplicate question'] = (doubled, 'entries')\n   315\t    repeated = json.loads(json.dumps(data))\n   316\t    by_id(repeated)['v1']['evidence'].append(by_id(repeated)['v1']['evidence'][0])\n   317\t    cases['duplicate evidence'] = (repeated, 'entries')\n   318\t    future = json.loads(json.dumps(data))\n   319\t    future['as_of'] = '2026-08-27'\n   320\t    cases['future day'] = (future, 'not completed')\n   321\t    for name, (changed, reason) in cases.items():\n   322\t        copy = tmp_path / f'copy-{name.replace(\" \", \"-\")}'\n   323\t        shutil.copytree(out, copy)\n   324\t        rewrite_data(copy, changed)\n   325\t        with pytest.raises(ValueError, match=reason):\n   326\t            check(stores, copy)\n   327\t\n   328\t\n   329\tdef test_10_legacy_store_without_completed_days_passes_one_date_rule(tmp_path):\n   330\t    \"\"\"§2 legacy row, §6 test 10: no completed days and no processing steps; an explicit day after the last judgement builds and the\n   331\t    same day passes a later check.\"\"\"\n   332\t    path = tmp_path / 'legacy.sqlite'\n   333\t    conn = store.open_db(str(path))\n   334\t    store.create_view(conn, view_id='v1', object_id='NVDA', object_kind='company', kind='asset', looks_at='Shipments', question='Will shipments begin?',\n   335\t                      due_day='2026-12-31', year='2026', rungs=[{'label': 'Yes', 'condition': 'Begin'}, {'label': 'No', 'condition': 'Do not begin'}],\n   336\t                      seq=1, input_id='item-1', created_at='2026-08-24T12:00:00Z')\n   337\t    judge(conn, 'v1', 1, 1, 'Shipments confirmed.')\n   338\t    conn.commit()\n   339\t    conn.close()\n   340\t    pair = (path, make_items(tmp_path / 'items.sqlite'))\n   341\t    build_package(pair, tmp_path / 'release', '2026-09-30')\n   342\t    assert check(pair, tmp_path / 'release')['questions'] == {'number': 0, 'event': 0, 'yes_no': 0}\n   343\t\n   344\t\n   345\tdef test_13_check_refuses_a_missing_item_even_when_the_package_omits_its_source(stores, tmp_path):\n   346\t    \"\"\"§6 test 13: the items copy lacks item-3 and the package copy lacks e2 (whose only source is item-3) with its hash refreshed.\"\"\"\n   347\t    out = tmp_path / 'release'\n   348\t    data = build_package(stores, out)\n   349\t    short = make_items(tmp_path / 'short.sqlite', ids=('item-1', 'item-2'))\n   350\t    copy = tmp_path / 'copy'\n   351\t    shutil.copytree(out, copy)\n   352\t    by_id(data)['v1']['evidence'] = [e for e in by_id(data)['v1']['evidence'] if e['id'] != 'e2']\n   353\t    for piece in by_id(data)['v1']['evidence']:\n   354\t        piece['sources'] = [s for s in piece['sources'] if s['uri'] != 'https://example.com/article-3']\n   355\t    rewrite_data(copy, data)\n   356\t    with pytest.raises(release.ReleaseRefused, match='item-3 is not in the items database'):\n   357\t        check((stores[0], short), copy)\n   358\t\n   359\t\n   360\tdef test_15_symbolic_links_and_repeated_member_names_are_refused(stores, tmp_path):\n   361\t    \"\"\"§6 test 15.\"\"\"\n   362\t    out = tmp_path / 'release'\n   363\t    build_package(stores, out)\n   364\t    linked = tmp_path / 'linked'\n   365\t    shutil.copytree(out, linked)\n   366\t    (tmp_path / 'outside.json').write_bytes((linked / release.DATA_FILE).read_bytes())\n   367\t    (linked / release.DATA_FILE).unlink()\n   368\t    (linked / release.DATA_FILE).symlink_to(tmp_path / 'outside.json')\n   369\t    with pytest.raises(release.ReleaseRefused, match='not a regular file'):\n   370\t        check(stores, linked)\n   371\t    repeated = tmp_path / 'repeated'\n   372\t    shutil.copytree(out, repeated)\n   373\t    raw = (repeated / release.DATA_FILE).read_bytes()\n   374\t    genuine = b'\"one_line\":\"Morningstar estimates $361 billion of revenue for the year.\"'\n   375\t    assert raw.count(genuine) == 1\n   376\t    payload = raw.replace(genuine, b'\"one_line\":\"About $390 billion\",' + genuine)\n   377\t    (repeated / release.DATA_FILE).write_bytes(payload)\n   378\t    manifest = json.loads((repeated / release.MANIFEST_FILE).read_text())\n   379\t    manifest['data_sha256'] = hashlib.sha256(payload).hexdigest()\n   380\t    (repeated / release.MANIFEST_FILE).write_text(json.dumps(manifest))\n   381\t    with pytest.raises(release.ReleaseRefused, match='member name repeats'):\n   382\t        check(stores, repeated)\n   383\t\n   384\t\n   385\tdef test_16_the_day_must_be_valid_and_canonical(stores):\n   386\t    \"\"\"§2 day rows, §6 test 16.\"\"\"\n   387\t    for day in ('2026-08-99', '20260825'):\n   388\t        with pytest.raises(release.ReleaseRefused):\n   389\t            export(stores, day)\n   390\t    assert [e['id'] for e in by_id(export(stores, '2026-08-25'))['v1']['evidence']] == ['e1', 'e4']\n   391\t    views_db = service.open_ledger(str(stores[0]))\n   392\t    try:\n   393\t        with pytest.raises(service.BoundNotCompleted):\n   394\t            release.resolve(views_db, '2026-08-27')\n   395\t    finally:\n   396\t        views_db.close()\n   397\t\n   398\t\n   399\tdef test_16_a_day_before_the_first_question_gives_an_empty_package(stores):\n   400\t    \"\"\"§2 row \"valid day before the first visible question\", §6 test 16: the store's questions open on 08-24.\"\"\"\n   401\t    data = export(stores, '2026-08-23')\n   402\t    assert data['as_of'] == '2026-08-23' and data['questions'] == []\n   403\t\n   404\t\n   405\t# ---------- §6 tests 11, 17, 18: the command\n   406\t\n   407\t\n   408\tdef test_11_command_end_to_end_with_check_statuses(stores, tmp_path):\n   409\t    \"\"\"§1 the builder and check, §6 test 11.\"\"\"\n   410\t    out = tmp_path / 'release'\n   411\t    built = run('build', '--ledger', stores[0], '--items', stores[1], '--out', out)\n   412\t    assert built.returncode == 0, built.stderr\n   413\t    report = out.with_name('release.report.json')\n   414\t    assert json.loads(report.read_text())['as_of'] == DAYS[2]\n   415\t    occupied = run('check', out, '--ledger', stores[0], '--items', stores[1])\n   416\t    assert occupied.returncode == 2 and 'passes' in occupied.stdout\n   417\t    report.unlink()\n   418\t    fresh = run('check', out, '--ledger', stores[0], '--items', stores[1])\n   419\t    assert fresh.returncode == 0 and report.exists() and json.loads(report.read_text())['export_seconds'] is None\n   420\t\n   421\t\n   422\tdef test_17_database_error_leaves_nothing_and_a_retry_succeeds(stores, tmp_path):\n   423\t    \"\"\"§2 database-error row, §6 test 17.\"\"\"\n   424\t    broken = tmp_path / 'broken.sqlite'\n   425\t    sqlite3.connect(broken).execute('create table other (x)').connection.commit()\n   426\t    out = tmp_path / 'release'\n   427\t    failed = run('build', '--ledger', stores[0], '--items', broken, '--out', out)\n   428\t    assert failed.returncode == 1 and 'OperationalError' in failed.stderr\n   429\t    assert not out.exists() and not list(tmp_path.glob('.release.staging-*'))\n   430\t    assert run('build', '--ledger', stores[0], '--items', stores[1], '--out', out).returncode == 0\n   431\t\n   432\t\n   433\tdef test_18_no_report_ever_replaces_an_input(stores, tmp_path):\n   434\t    \"\"\"§1 publish_report, §6 test 18: the report name is the items file itself, a symbolic link to it, and (on a case-insensitive\n   435\t    volume) a case-variant name of it.\"\"\"\n   436\t    items_hash = hashlib.sha256(stores[1].read_bytes()).hexdigest()\n   437\t    same = tmp_path / 'same.report.json'\n   438\t    shutil.copyfile(stores[1], same)\n   439\t    refused = run('build', '--ledger', stores[0], '--items', same, '--out', tmp_path / 'same')\n   440\t    assert refused.returncode == 1 and hashlib.sha256(same.read_bytes()).hexdigest() == items_hash\n   441\t    out = tmp_path / 'pkg'\n   442\t    assert run('build', '--ledger', stores[0], '--items', stores[1], '--out', out).returncode == 0\n   443\t    report = tmp_path / 'pkg.report.json'\n   444\t    report.unlink()\n   445\t    report.symlink_to(stores[1])\n   446\t    linked = run('check', out, '--ledger', stores[0], '--items', stores[1])\n   447\t    assert linked.returncode == 2 and hashlib.sha256(stores[1].read_bytes()).hexdigest() == items_hash\n   448\t    report.unlink()\n   449\t    variant = tmp_path / 'PKG.REPORT.JSON'\n   450\t    shutil.copyfile(stores[1], variant)\n   451\t    if report.exists():                                  # a case-insensitive volume: the variant is the report name\n   452\t        checked = run('check', out, '--ledger', stores[0], '--items', variant)\n   453\t        assert checked.returncode == 2 and hashlib.sha256(variant.read_bytes()).hexdigest() == items_hash\n   454\t\n   455\t\n   456\t# ---------- §6 tests 12, 14, 19, 20, 21: scratch copies of the command (the AGENTS §4 mutation procedure)\n   457\t\n   458\t\n   459\tdef scratch(tmp_path, edits):\n   460\t    \"\"\"A copy of the package and the command with text edits applied; each edit must match once.\"\"\"\n   461\t    root = tmp_path / 'scratch'\n   462\t    shutil.copytree(ROOT / 'src' / 'hivemind', root / 'src' / 'hivemind', ignore=shutil.ignore_patterns('__pycache__'))\n   463\t    (root / 'scripts').mkdir()\n   464\t    shutil.copy(COMMAND, root / 'scripts' / 'release_build.py')\n   465\t    for relative, old, new in edits:\n   466\t        path = root / relative\n   467\t        text = path.read_text()\n   468\t        assert text.count(old) == 1, (relative, old)\n   469\t        path.write_text(text.replace(old, new))\n   470\t    return root / 'scripts' / 'release_build.py'\n   471\t\n   472\t\n   473\tdef pause_code(signals, name, indent='        '):\n   474\t    \"\"\"Code that signals it has paused and waits for the test's resume file, ending at `indent` for the line it precedes.\"\"\"\n   475\t    return (f\"__import__('pathlib').Path({str(signals / ('paused-' + name))!r}).touch()\\n\"\n   476\t            f\"{indent}while not __import__('pathlib').Path({str(signals / ('resume-' + name))!r}).exists(): __import__('time').sleep(0.02)\\n{indent}\")\n   477\t\n   478\t\n   479\tdef run_paused(command, args, signals, name, action):\n   480\t    process = subprocess.Popen([sys.executable, str(command), *map(str, args)], stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True,\n   481\t                               env={**os.environ, 'PYTHONDONTWRITEBYTECODE': '1'})\n   482\t    deadline = time.time() + 60\n   483\t    while not (signals / f'paused-{name}').exists():\n   484\t        assert process.poll() is None and time.time() < deadline, process.communicate()\n   485\t        time.sleep(0.02)\n   486\t    action()\n   487\t    (signals / f'resume-{name}').touch()\n   488\t    out, err = process.communicate(timeout=120)\n   489\t    return process.returncode, out, err\n   490\t\n   491\t\n   492\tFAULT = (\"evidence.append({'id': piece['evidence_id'], **{name: piece[name] for name in EVIDENCE_TEXT}, 'sources': sources})\",\n   493\t         \"evidence.append({'id': piece['evidence_id'], **{name: piece[name] for name in EVIDENCE_TEXT}, 'sources': sources, \"\n   494\t         \"'one_line': views_db.execute('select why_changed from judgements where view_id=? order by judgement_id desc limit 1', (view_id,)).fetchone()['why_changed'] if view_id == 'v1' else piece['one_line']})\")\n   495\tSTAGED_CHECK = (\"counts = release.check_package(staged, views_db, items_db, expected_as_of=bound)\", \"counts = release.check_export(data)\")\n   496\t\n   497\t\n   498\tdef test_12_the_staged_check_is_what_stops_a_writer_fault(stores, tmp_path):\n   499\t    \"\"\"§6 test 12: with a writer fault the command refuses and leaves nothing; with the fault and no staged check the bad package is\n   500\t    published, so the staged check is what prevents it.\"\"\"\n   501\t    faulty = scratch(tmp_path / 'a', [('src/hivemind/release.py', *FAULT)])\n   502\t    out = tmp_path / 'release'\n   503\t    refused = subprocess.run([sys.executable, str(faulty), 'build', '--ledger', stores[0], '--items', stores[1], '--out', out], capture_output=True, text=True)\n   504\t    assert refused.returncode == 1 and 'one_line' in refused.stderr\n   505\t    assert not out.exists() and not list(tmp_path.glob('.release.staging-*'))\n   506\t    unguarded = scratch(tmp_path / 'b', [('src/hivemind/release.py', *FAULT), ('scripts/release_build.py', *STAGED_CHECK)])\n   507\t    published = subprocess.run([sys.executable, str(unguarded), 'build', '--ledger', stores[0], '--items', stores[1], '--out', out], capture_output=True, text=True)\n   508\t    assert published.returncode == 0, published.stderr\n   509\t    assert V1_WHY in (out / release.DATA_FILE).read_text()\n   510\t\n   511\t\n   512\tdef test_14_publication_never_replaces_or_removes_another_folder(stores, tmp_path):\n   513\t    \"\"\"§1 publish, §2 rows on an occupied --out and two builds, §6 test 14.\"\"\"\n   514\t    data = export(stores)\n   515\t    out = tmp_path / 'release'\n   516\t    first, second = release.stage(out), release.stage(out)\n   517\t    release.write_package(data, first)\n   518\t    release.write_package(data, second)\n   519\t    release.publish(first, out)\n   520\t    with pytest.raises(FileExistsError):\n   521\t        release.publish(second, out)\n   522\t    assert second.exists() and check(stores, out)['fields_compared'] > 0\n   523\t    other = tmp_path / 'other'\n   524\t    staged = release.stage(other)\n   525\t    release.write_package(data, staged)\n   526\t    other.mkdir()\n   527\t    with pytest.raises(FileExistsError):\n   528\t        release.publish(staged, other)\n   529\t    assert other.is_dir() and not any(other.iterdir())\n   530\t    early = tmp_path / 'early'\n   531\t    early.mkdir()\n   532\t    assert run('build', '--ledger', stores[0], '--items', stores[1], '--out', early).returncode == 1 and early.is_dir()\n   533\t\n   534\t    signals = tmp_path / 'signals'\n   535\t    signals.mkdir()\n   536\t    paused = scratch(tmp_path / 'late', [('scripts/release_build.py', 'release.publish(staged, out)', pause_code(signals, 'publish') + 'release.publish(staged, out)')])\n   537\t    late = tmp_path / 'late-out'\n   538\t    holder = {}\n   539\t\n   540\t    def occupy():\n   541\t        late.mkdir()\n   542\t        holder['identity'] = (late.stat().st_dev, late.stat().st_ino)\n   543\t    code, _, err = run_paused(paused, ['build', '--ledger', stores[0], '--items', stores[1], '--out', late], signals, 'publish', occupy)\n   544\t    assert code == 1 and 'File exists' in err\n   545\t    assert (late.stat().st_dev, late.stat().st_ino) == holder['identity'] and not any(late.iterdir())\n   546\t    assert not list(tmp_path.glob('.late-out.staging-*'))\n   547\t\n   548\t    after = scratch(tmp_path / 'after', [('scripts/release_build.py', 'staged = None                       #',\n   549\t                                          f\"freed = staged\\n        staged = None\\n        {pause_code(signals, 'freed')}freed.mkdir(); (freed / 'marker').write_text('mine')  #\")])\n   550\t    done = tmp_path / 'after-out'\n   551\t    code, _, err = run_paused(after, ['build', '--ledger', stores[0], '--items', stores[1], '--out', done], signals, 'freed', lambda: None)\n   552\t    assert code == 0, err\n   553\t    markers = list(tmp_path.glob('.after-out.staging-*/marker'))\n   554\t    assert len(markers) == 1 and markers[0].read_text() == 'mine'\n   555\t\n   556\t\n   557\tdef test_19_a_report_name_taken_during_the_build_survives(stores, tmp_path):\n   558\t    \"\"\"§2 report rows, §6 test 19.\"\"\"\n   559\t    signals = tmp_path / 'signals'\n   560\t    signals.mkdir()\n   561\t    paused = scratch(tmp_path, [('scripts/release_build.py', '    return write_report(summary, report)\\n\\n\\ndef check',\n   562\t                                 f\"    {pause_code(signals, 'report', indent='    ')}return write_report(summary, report)\\n\\n\\ndef check\")])\n   563\t    out = tmp_path / 'release'\n   564\t    marker = tmp_path / 'release.report.json'\n   565\t    code, _, err = run_paused(paused, ['build', '--ledger', stores[0], '--items', stores[1], '--out', out], signals, 'report', lambda: marker.write_text('occupied'))\n   566\t    assert code == 2 and 'report not written' in err and marker.read_text() == 'occupied'\n   567\t    checked = run('check', out, '--ledger', stores[0], '--items', stores[1])\n   568\t    assert checked.returncode == 2 and 'passes' in checked.stdout and marker.read_text() == 'occupied'\n   569\t\n   570\t\n   571\tdef test_20_a_temporary_file_left_after_the_link_still_counts_as_published(stores, tmp_path):\n   572\t    \"\"\"§1 publish_report, §6 test 20.\"\"\"\n   573\t    command = scratch(tmp_path, [('src/hivemind/release.py', '    try:\\n        os.unlink(temporary)\\n    except OSError:',\n   574\t                                  \"    try:\\n        raise PermissionError('test: cannot remove')\\n    except OSError:\")])\n   575\t    out = tmp_path / 'release'\n   576\t    result = subprocess.run([sys.executable, str(command), 'build', '--ledger', stores[0], '--items', stores[1], '--out', out], capture_output=True, text=True)\n   577\t    assert result.returncode == 0 and 'report published' in result.stderr\n   578\t    assert json.loads(out.with_name('release.report.json').read_text())['as_of'] == DAYS[2]\n   579\t    assert list(tmp_path.glob('.release.report.json.*'))\n   580\t\n   581\t\n   582\tdef test_21_check_that_cannot_write_its_report_exits_2(stores, tmp_path):\n   583\t    \"\"\"§1 check's statuses, §6 test 21.\"\"\"\n   584\t    out = tmp_path / 'release'\n   585\t    build_package(stores, out)\n   586\t    command = scratch(tmp_path, [('src/hivemind/release.py', \"    descriptor, temporary = tempfile.mkstemp(dir=path.parent, prefix=f'.{path.name}.')\",\n   587\t                                  \"    raise PermissionError('test: cannot create')\")])\n   588\t    result = subprocess.run([sys.executable, str(command), 'check', out, '--ledger', stores[0], '--items', stores[1]], capture_output=True, text=True)\n   589\t    assert result.returncode == 2 and 'passes' in result.stdout and 'cannot create' in result.stderr\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc 'nl -ba docs/research/2026-11-22-number-answers/release_check.py'","aggregated_output":"     1\t\"\"\"The $0 release check of RELEASE-BUILD.md §7 on four stored stores, read-only (a closing switch is added only to a copy).\n     2\t\n     3\t    python3 docs/research/2026-11-22-number-answers/release_check.py <new output folder>\n     4\t\n     5\tBuilds each store's package with the real command, then: the decisive acceptance case on old-1; old-1/v8; the two known Yes/No leaks\n     6\tat their own days; an unchanged event control; a closing switch on a copy; the diagnostic search of every forbidden stored string in\n     7\tevery decoded package field; the size and speed budgets against `bundle.library` on the same store. Writes results.json there.\"\"\"\n     8\timport hashlib\n     9\timport json\n    10\timport shutil\n    11\timport sqlite3\n    12\timport subprocess\n    13\timport sys\n    14\timport time\n    15\tfrom pathlib import Path\n    16\t\n    17\tREPO = Path(__file__).resolve().parents[3]\n    18\tsys.path.insert(0, str(REPO / 'src'))\n    19\tfrom hivemind import bundle, release, service  # noqa: E402\n    20\tfrom hivemind.views import store  # noqa: E402\n    21\t\n    22\tCOMMAND = REPO / 'scripts' / 'release_build.py'\n    23\tCOMPARISON_ITEMS = REPO / 'poc/data/comparison-2026-11-17/items-comparison.sqlite'\n    24\tSTORES = {\n    25\t    'old-1': (REPO / 'poc/data/comparison-2026-11-17/run/old-1/prod/views.sqlite', COMPARISON_ITEMS),\n    26\t    'old-2': (REPO / 'poc/data/comparison-2026-11-17/run/old-2/prod/views.sqlite', COMPARISON_ITEMS),\n    27\t    'old-3': (REPO / 'poc/data/comparison-2026-11-17/run/old-3/prod/views.sqlite', COMPARISON_ITEMS),\n    28\t    'served': (REPO / 'poc/data/served-2026-10-28-v34-nvda-3m-through-0828/views.sqlite', REPO / 'poc/data/items-nvda-2026-07-01-10-27.sqlite'),\n    29\t}\n    30\t\n    31\t\n    32\tdef build(ledger, items, out, as_of=None):\n    33\t    args = [sys.executable, str(COMMAND), 'build', '--ledger', str(ledger), '--items', str(items), '--out', str(out)] + (['--as-of', as_of] if as_of else [])\n    34\t    result = subprocess.run(args, capture_output=True, text=True, env={'PATH': '/usr/bin:/bin', 'PYTHONDONTWRITEBYTECODE': '1'})\n    35\t    if result.returncode != 0:\n    36\t        raise SystemExit(f'build {out} exited {result.returncode}: {result.stderr}')\n    37\t    return json.loads(out.with_name(out.name + '.report.json').read_text()), release.read_data(out)\n    38\t\n    39\t\n    40\tdef check(ledger, items, package):\n    41\t    views_db, items_db = service.open_ledger(str(ledger)), store.open_read_only(str(items))\n    42\t    try:\n    43\t        return release.check_package(package, views_db, items_db)\n    44\t    finally:\n    45\t        views_db.close()\n    46\t        items_db.close()\n    47\t\n    48\t\n    49\tdef fields(data):\n    50\t    \"\"\"(question id, field path, evidence id, text) for every decoded string of the package.\"\"\"\n    51\t    for question in data['questions']:\n    52\t        for name in ('question', 'answer'):\n    53\t            if isinstance(question.get(name), str):\n    54\t                yield question['id'], name, None, question[name]\n    55\t        for n, label in enumerate(question.get('answers') or []):\n    56\t            yield question['id'], f'answers[{n}]', None, label\n    57\t        for piece in question['evidence']:\n    58\t            for name in release.EVIDENCE_TEXT:\n    59\t                if isinstance(piece[name], str):\n    60\t                    yield question['id'], name, piece['id'], piece[name]\n    61\t            for n, source in enumerate(piece['sources']):\n    62\t                for name in release.SOURCE_TEXT:\n    63\t                    if isinstance(source[name], str):\n    64\t                        yield question['id'], f'sources[{n}].{name}', piece['id'], source[name]\n    65\t\n    66\t\n    67\tdef forbidden(ledger, data):\n    68\t    \"\"\"Every stored string the package must not hold, by question and kind; judgement columns read only where the store has them.\"\"\"\n    69\t    conn = service.open_ledger(str(ledger))\n    70\t    try:\n    71\t        columns = {row[1] for row in conn.execute('pragma table_info(judgements)')}\n    72\t        texts = [c for c in ('reasons', 'why_changed', 'implied_outcome', 'reference') if c in columns]\n    73\t        out = []\n    74\t        for question in data['questions']:\n    75\t            view_id = question['id']\n    76\t            if question['class'] == 'number':\n    77\t                for row in conn.execute('select label, condition from rungs where view_id=?', (view_id,)):\n    78\t                    out += [(view_id, 'rung label', row['label']), (view_id, 'rung condition', row['condition'])]\n    79\t            for row in conn.execute(f'select {\", \".join(texts)} from judgements where view_id=?', (view_id,)):\n    80\t                out += [(view_id, name, row[name]) for name in texts]\n    81\t            out += [(view_id, 'switch reason', row['reason']) for row in conn.execute(\"select reason from view_switches where view_id=? and reason!='created'\", (view_id,))]\n    82\t        return [entry for entry in out if entry[2]], [c for c in ('implied_outcome', 'reference') if c not in columns]\n    83\t    finally:\n    84\t        conn.close()\n    85\t\n    86\t\n    87\tdef diagnostics(ledger, data):\n    88\t    stored, absent = forbidden(ledger, data)\n    89\t    located = list(fields(data))\n    90\t    joined = '\\x00'.join(text for *_, text in located)\n    91\t    hits = []\n    92\t    for view_id, kind, text in set(stored):\n    93\t        if text in joined:\n    94\t            for question_id, path, evidence_id, field in located:\n    95\t                if text in field:\n    96\t                    hits.append({'stored_in': view_id, 'kind': kind, 'text': text[:200], 'found_in': question_id, 'field': path, 'evidence': evidence_id})\n    97\t    return {'stored_strings_judged': len(set(stored)), 'package_strings': len(located), 'judgement_columns_absent': absent, 'hits': hits}\n    98\t\n    99\t\n   100\tdef library_baseline(ledger, items):\n   101\t    views_db, items_db = service.open_ledger(str(ledger)), store.open_read_only(str(items))\n   102\t    try:\n   103\t        started = time.time()\n   104\t        payload = bundle.library(views_db, items_db)\n   105\t        return len(json.dumps(payload, ensure_ascii=False).encode()), time.time() - started\n   106\t    finally:\n   107\t        views_db.close()\n   108\t        items_db.close()\n   109\t\n   110\t\n   111\tdef by_id(data):\n   112\t    return {q['id']: q for q in data['questions']}\n   113\t\n   114\t\n   115\tdef refresh(package, data=None, manifest_extra=None):\n   116\t    if data is not None:\n   117\t        payload = json.dumps(data, ensure_ascii=False, separators=(',', ':')).encode()\n   118\t        (package / release.DATA_FILE).write_bytes(payload)\n   119\t    manifest = json.loads((package / release.MANIFEST_FILE).read_text())\n   120\t    manifest['data_sha256'] = hashlib.sha256((package / release.DATA_FILE).read_bytes()).hexdigest()\n   121\t    manifest.update(manifest_extra or {})\n   122\t    (package / release.MANIFEST_FILE).write_text(json.dumps(manifest))\n   123\t\n   124\t\n   125\tdef refused(ledger, items, package):\n   126\t    try:\n   127\t        check(ledger, items, package)\n   128\t    except release.ReleaseRefused as error:\n   129\t        return str(error)\n   130\t    return None\n   131\t\n   132\t\n   133\tdef main(out):\n   134\t    out = Path(out).absolute()\n   135\t    out.mkdir()                                            # a new folder; refuses an existing one\n   136\t    results = {'stores': {}}\n   137\t    packages = {}\n   138\t    for name, (ledger, items) in STORES.items():\n   139\t        (out / name).mkdir()\n   140\t        report, data = build(ledger, items, out / name / 'package')\n   141\t        packages[name] = data\n   142\t        library_bytes, library_seconds = library_baseline(ledger, items)\n   143\t        seconds = report['export_seconds'] + report['check_seconds']\n   144\t        results['stores'][name] = {\n   145\t            'as_of': report['as_of'], 'counts': report['counts'], 'withheld_unresolved': len(report['withheld_unresolved']),\n   146\t            'unresolved': report['withheld_unresolved'], 'data_bytes': report['data_bytes'], 'library_bytes': library_bytes,\n   147\t            'seconds': round(seconds, 2), 'library_seconds': round(library_seconds, 2),\n   148\t            'bytes_within_budget': report['data_bytes'] <= library_bytes,\n   149\t            'seconds_within_budget': seconds <= 3 * library_seconds and seconds <= 120,\n   150\t            'diagnostics': diagnostics(ledger, data)}\n   151\t        print(name, json.dumps({k: v for k, v in results['stores'][name].items() if k not in ('unresolved', 'diagnostics')}), 'hits', len(results['stores'][name]['diagnostics']['hits']))\n   152\t\n   153\t    ledger, items = STORES['old-1']\n   154\t    data, package = packages['old-1'], out / 'old-1' / 'package'\n   155\t    conn = service.open_ledger(str(ledger))\n   156\t    stored = {row['evidence_id']: row for row in conn.execute(\"select * from evidence where evidence_id in ('e2295','e1865','e3597')\")}\n   157\t    implied = conn.execute('select implied_outcome from judgements where judgement_id=1580').fetchone()[0]\n   158\t    in_force_v8 = [e['evidence_id'] for e in service.evidence(conn, 'v8', data['as_of'])]\n   159\t    conn.close()\n   160\t    kept = {}\n   161\t    for evidence_id in stored:\n   162\t        holders = [(q['id'], e) for q in data['questions'] for e in q['evidence'] if e['id'] == evidence_id]\n   163\t        kept[evidence_id] = {'questions': [h[0] for h in holders],\n   164\t                             'equal_to_store': all(e['one_line'] == stored[evidence_id]['one_line'] and e['quote'] == stored[evidence_id]['quote'] for _, e in holders) and bool(holders)}\n   165\t    forged = out / 'old-1' / 'forged-summary'\n   166\t    shutil.copytree(package, forged)\n   167\t    changed = json.loads(json.dumps(data))\n   168\t    next(e for e in by_id(changed)['v8']['evidence'] if e['id'] == 'e2295')['one_line'] = implied\n   169\t    refresh(forged, changed)\n   170\t    prose = out / 'old-1' / 'forged-manifest'\n   171\t    shutil.copytree(package, prose)\n   172\t    refresh(prose, manifest_extra={'note': implied})\n   173\t    v8 = by_id(data)['v8']\n   174\t    results['decisive'] = {'kept': kept, 'implied_outcome_j1580': implied[:120],\n   175\t                           'substituted_into_e2295_refused': refused(ledger, items, forged),\n   176\t                           'added_to_manifest_refused': refused(ledger, items, prose),\n   177\t                           'unchanged_package_passes': check(ledger, items, package)['fields_compared']}\n   178\t    results['old-1/v8'] = {'class': v8['class'], 'forecast': v8['forecast'], 'evidence': len(v8['evidence']),\n   179\t                           'same_ids_as_service_evidence': [e['id'] for e in v8['evidence']] == in_force_v8}\n   180\t\n   181\t    leaks = {}\n   182\t    for name, view_id, day, judgement_id in (('old-3', 'v36', '2026-08-25', 799), ('old-1', 'v10', '2026-08-28', 865)):\n   183\t        ledger, items = STORES[name]\n   184\t        report, dated = build(ledger, items, out / name / f'package-{day}', day)\n   185\t        conn = service.open_ledger(str(ledger))\n   186\t        row = conn.execute('select judgement_id, rung, why_changed, reasons from judgements where view_id=? and publication_day<=? order by judgement_id desc limit 1', (view_id, day)).fetchone()\n   187\t        label = conn.execute('select label from rungs where view_id=? and position=?', (view_id, row['rung'])).fetchone()[0]\n   188\t        conn.close()\n   189\t        record = by_id(dated)[view_id]\n   190\t        texts = [text for *_, text in fields(dated)]\n   191\t        leaks[f'{name}/{view_id}@{day}'] = {\n   192\t            'latest_judgement': row['judgement_id'], 'expected_judgement': judgement_id, 'label_kept': record['answer'] == label, 'answer': record['answer'],\n   193\t            'why_changed_absent': not any(row['why_changed'] in t for t in texts), 'reasons_absent': not any((row['reasons'] or '\\x01') in t for t in texts),\n   194\t            'around_1_trillion_fields': [(q, p, e, t[:160]) for q, p, e, t in fields(dated) if 'around $1 trillion' in t]}\n   195\t    results['leaks'] = leaks\n   196\t\n   197\t    ledger, items = STORES['old-1']\n   198\t    conn = service.open_ledger(str(ledger))\n   199\t    control = next(q for q in data['questions'] if q['class'] == 'event' and q['id'] not in ('v10',) and q['answer'] is not None)\n   200\t    stored_label = conn.execute('select r.label from judgements j join rungs r on r.view_id=j.view_id and r.position=j.rung where j.view_id=? and j.publication_day<=? order by j.judgement_id desc limit 1', (control['id'], data['as_of'])).fetchone()[0]\n   201\t    control_ids = [e['evidence_id'] for e in service.evidence(conn, control['id'], data['as_of'])]\n   202\t    conn.close()\n   203\t    results['control'] = {'id': control['id'], 'answer': control['answer'], 'label_equals_store': control['answer'] == stored_label,\n   204\t                          'evidence_equals_store': [e['id'] for e in control['evidence']] == control_ids}\n   205\t\n   206\t    closing = out / 'old-1' / 'closing'\n   207\t    closing.mkdir()\n   208\t    copy = closing / 'views.sqlite'\n   209\t    shutil.copyfile(ledger, copy)\n   210\t    conn = sqlite3.connect(copy)\n   211\t    rung = conn.execute(\"select rung from judgements where view_id='v8' order by judgement_id desc limit 1\").fetchone()[0]\n   212\t    rung_label = conn.execute(\"select label from rungs where view_id='v8' and position=?\", (rung,)).fetchone()[0]\n   213\t    reason = f'due {data[\"as_of\"]}, frozen on {data[\"as_of\"]} at rung {rung} {rung_label}'\n   214\t    last_seq = conn.execute('select max(sequence_no) from processing_steps').fetchone()[0]\n   215\t    conn.execute(\"insert into view_switches (view_id, open, reason, by_whom, after_seq) values ('v8', 0, ?, 'pull', ?)\", (reason, last_seq))\n   216\t    conn.commit()\n   217\t    conn.close()\n   218\t    views_db, items_db = service.open_ledger(str(copy)), store.open_read_only(str(items))\n   219\t    exposed = bundle.view_bundle(views_db, bundle.item_lookup(items_db), 'v8')\n   220\t    views_db.close()\n   221\t    items_db.close()\n   222\t    report, closed = build(copy, items, closing / 'package')\n   223\t    texts = [text for *_, text in fields(closed)]\n   224\t    results['closing'] = {'reason': reason, 'bundle_exposes_reason': any(s.get('reason') == reason for s in exposed['switches']),\n   225\t                          'package_open': by_id(closed)['v8']['open'], 'reason_absent': not any(reason in t for t in texts),\n   226\t                          'rung_label_in_v8_fields': [p for q, p, e, t in fields(closed) if q == 'v8' and t == rung_label]}\n   227\t    (out / 'results.json').write_text(json.dumps(results, ensure_ascii=False, indent=1))\n   228\t    print(json.dumps({k: v for k, v in results.items() if k != 'stores'}, ensure_ascii=False, indent=1))\n   229\t\n   230\t\n   231\tif __name__ == '__main__':\n   232\t    main(sys.argv[1])\n","exit_code":0,"status":"completed"}}
