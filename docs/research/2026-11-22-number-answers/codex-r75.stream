, 'src'))\nSTORED_DATA = {\n    'test_event_horizon': ['poc/data/keyed-2026-10-25/archive-T2.sqlite', 'poc/data/items-window-tags2-2026-10-24.sqlite'],\n    'test_idea': ['poc/data/sealed-2026-10-24-run3-through-0815/views.sqlite', 'poc/data/items-window.sqlite'],\n    'test_search': ['poc/data/sealed-2026-10-24-run3-through-0815/views.sqlite'],\n    'test_service': ['poc/data/sealed-2026-10-24-run3-through-0815/views.sqlite'],\n    'test_ui_bundles': ['poc/data/sealed-2026-10-24-run3-through-0815/views.sqlite', 'poc/data/items-window.sqlite'],\n    'test_sequential_replay': ['poc/data/views-2026-10-25-v15-T2b-aborted-fresh-archive.sqlite'],\n}\n\n\ndef pytest_collection_modifyitems(config, items):\n    for item in items:\n        needed = STORED_DATA.get(item.module.__name__, [])\n        missing = [p for p in needed if not os.path.exists(os.path.join(ROOT, p))]\n        if missing:\n            item.add_marker(pytest.mark.skip(reason=f'stored data not present: {missing[0]}'))\n\n\n@pytest.fixture(autouse=True)\ndef no_credentials(monkeypatch):\n    from hivemind import jev, model\n\n    def refuse(*arguments):          # pytest.fail raises a BaseException, which the pipeline's `except Exception` cannot record as an item failure\n        pytest.fail('a test read a credential: a model or Jev call escaped its fake transport')\n    monkeypatch.setattr(model, '_key', refuse)\n    monkeypatch.setattr(jev, '_key', refuse)\n\n\n@pytest.fixture(autouse=True, scope='session')\ndef locks_in_a_temporary_folder(tmp_path_factory):\n    \"\"\"No test writes outside temporary folders (AGENTS §4): the writer lock's folder (live_lock, OPERATING-CONTRACT row 7) is moved\n    into one for the whole session.\"\"\"\n    from hivemind import live_lock\n    saved = live_lock.LOCK_FOLDER\n    live_lock.LOCK_FOLDER = str(tmp_path_factory.mktemp('locks'))\n    yield\n    live_lock.LOCK_FOLDER = saved\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_22","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"PYTHONDONTWRITEBYTECODE=1 PYTHONPATH=src /Users/lchingen/.pyenv/versions/3.10.10/bin/python3 -B -c 'from pathlib import Path\nimport sqlite3,json,collections,hashlib,sys,runpy\nfrom hivemind import release\nrc=runpy.run_path('\\\\''docs/research/2026-11-22-number-answers/release_check.py'\\\\'')\nbase=Path('\\\\''poc/data/release-check-2026-11-23'\\\\'')\nres=json.loads((base/'\\\\''results.json'\\\\'').read_bytes())\ndef ro(p):\n c=sqlite3.connect(p.resolve().as_uri()+'\\\\''?mode=ro&immutable=1'\\\\'',uri=True)\n c.row_factory=sqlite3.Row\n return c\ndef walk(v):\n if isinstance(v,dict):\n  for x in v.values(): yield from walk(x)\n elif isinstance(v,list):\n  for x in v: yield from walk(x)\n elif isinstance(v,str): yield v\nfor name,(ledger,items) in rc['\\\\''STORES'\\\\''].items():\n p=base/name/'\\\\''package'\\\\''\n c=release.check_package(p,ro(ledger),ro(items))\n print('\\\\''independently checked'\\\\'',name,c,flush=True)\n'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.started","item":{"id":"item_23","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"PYTHONDONTWRITEBYTECODE=1 PYTHONPATH=src /Users/lchingen/.pyenv/versions/3.10.10/bin/python3 -B -c 'from pathlib import Path\nimport sqlite3,json,collections,hashlib,sys,runpy\nfrom hivemind import release\nrc=runpy.run_path('\\\\''docs/research/2026-11-22-number-answers/release_check.py'\\\\'')\nbase=Path('\\\\''poc/data/release-check-2026-11-23'\\\\'')\nres=json.loads((base/'\\\\''results.json'\\\\'').read_bytes())\ndef ro(p):\n c=sqlite3.connect(p.resolve().as_uri()+'\\\\''?mode=ro&immutable=1'\\\\'',uri=True)\n c.row_factory=sqlite3.Row\n return c\ndef walk(v):\n if isinstance(v,dict):\n  for x in v.values(): yield from walk(x)\n elif isinstance(v,list):\n  for x in v: yield from walk(x)\n elif isinstance(v,str): yield v\nfor name,(ledger,items) in rc['\\\\''STORES'\\\\''].items():\n d=release.read_data(base/name/'\\\\''package'\\\\''); m=json.loads((base/name/'\\\\''package/manifest.json'\\\\'').read_bytes()); db=ro(ledger)\n diag=res['\\\\''stores'\\\\''][name]['\\\\''diagnostics'\\\\'']\n flat=list(walk(d)); ctr=collections.Counter(); \n for q in d['\\\\''questions'\\\\'']:\n  for e in q['\\\\''evidence'\\\\'']:\n   for k in release.EVIDENCE_TEXT:\n    if e[k] is None: ctr[k]+=1\n   for s in e['\\\\''sources'\\\\'']:\n    for k,v in s.items():\n     if v is None: ctr[k]+=1\n print(name,'\\\\''all data'\\\\'',len(flat),'\\\\''manifest'\\\\'',len(list(walk(m))),'\\\\''searched'\\\\'',diag['\\\\''package_strings'\\\\''],'\\\\''nulls'\\\\'',dict(ctr),'\\\\''ratios'\\\\'',res['\\\\''stores'\\\\''][name]['\\\\''data_bytes'\\\\'']/res['\\\\''stores'\\\\''][name]['\\\\''library_bytes'\\\\''],res['\\\\''stores'\\\\''][name]['\\\\''seconds'\\\\'']/res['\\\\''stores'\\\\''][name]['\\\\''library_seconds'\\\\''])\n print('\\\\''db'\\\\'',tuple(db.execute('\\\\''select count(*),count(distinct evidence_id) from evidence_sources'\\\\'').fetchone()), '\\\\''missing'\\\\'',db.execute('\\\\''select count(*) from evidence where evidence_id not in (select evidence_id from evidence_sources)'\\\\'').fetchone()[0])\n print('\\\\''skipped reason count'\\\\'',db.execute(\\\"select count(*) from view_switches where reason='\\\\''created'\\\\''\\\").fetchone()[0], '\\\\''occurrences in data'\\\\'',sum('\\\\''created'\\\\'' in s for s in flat))\n print('\\\\''hits'\\\\'',collections.Counter(h['\\\\''field'\\\\''] for h in diag['\\\\''hits'\\\\'']))\n cols={r[1] for r in db.execute('\\\\''pragma table_info(view_keys)'\\\\'')}\n if cols:\n  print('\\\\''keys different seq'\\\\'',db.execute('\\\\''select count(*) from view_keys k join views v using(view_id) where k.seq\"'!=v.created_seq'\"'\\\\'').fetchone()[0])\n conditions={r[0] for q in d['\\\\''questions'\\\\''] if q['\\\\''class'\\\\'']\"'!='\"'\\\\''number'\\\\'' for r in db.execute('\\\\''select condition from rungs where view_id=?'\\\\'',(q['\\\\''id'\\\\''],)) if r[0]}\n joined='\\\\''\\\\x01'\\\\''.join(flat); hits=[c for c in conditions if c in joined];print('\\\\''event conditions'\\\\'',len(conditions),'\\\\''matches'\\\\'',len(hits),hits[:3])\n if name=='\\\\''old-1'\\\\'':\n  print('\\\\''j865'\\\\'',tuple(db.execute('\\\\''select reasons,why_changed,implied_outcome from judgements where judgement_id=865'\\\\'').fetchone()))\n  close=release.read_data(base/name/'\\\\''closing/package'\\\\'');v8=next(q for q in close['\\\\''questions'\\\\''] if q['\\\\''id'\\\\'']=='\\\\''v8'\\\\'');hits=[(e['\\\\''id'\\\\''],k,v[:85]) for e in v8['\\\\''evidence'\\\\''] for k,v in [('\\\\''quote'\\\\'',e['\\\\''quote'\\\\'']),('\\\\''one_line'\\\\'',e['\\\\''one_line'\\\\'']),('\\\\''title'\\\\'',e['\\\\''sources'\\\\''][0]['\\\\''title'\\\\''])] if isinstance(v,str) and '\\\\''Bullish'\\\\'' in v]\n  print('\\\\''closing'\\\\'',len(hits),hits[:3])\n'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
