\"v30\",\n9892:      \"stored_in\": \"v30\",\n9900:      \"stored_in\": \"v30\",\n9908:      \"stored_in\": \"v30\",\n9916:      \"stored_in\": \"v30\",\n9924:      \"stored_in\": \"v30\",\n9932:      \"stored_in\": \"v24\",\n9940:      \"stored_in\": \"v24\",\n9948:      \"stored_in\": \"v24\",\n9956:      \"stored_in\": \"v24\",\n9964:      \"stored_in\": \"v24\",\n9972:      \"stored_in\": \"v24\",\n9980:      \"stored_in\": \"v24\",\n9988:      \"stored_in\": \"v24\",\n9996:      \"stored_in\": \"v24\",\n10004:      \"stored_in\": \"v24\",\n10012:      \"stored_in\": \"v24\",\n10020:      \"stored_in\": \"v24\",\n10028:      \"stored_in\": \"v24\",\n10036:      \"stored_in\": \"v24\",\n10044:      \"stored_in\": \"v24\",\n10052:      \"stored_in\": \"v24\",\n10060:      \"stored_in\": \"v24\",\n10068:      \"stored_in\": \"v24\",\n10079: \"decisive\": {\n10087:    \"equal_to_store\": true\n10093:    \"equal_to_store\": true\n10100:    \"equal_to_store\": true\n10104:  \"substituted_into_e2295_refused\": \"question v8.evidence[529].one_line: differs from the store\",\n10134: \"control\": {\n10137:  \"label_equals_store\": true,\n10138:  \"evidence_equals_store\": true\n10140: \"closing\": {\ntotal 448\ndrwxr-xr-x@   7 lchingen  staff     224 Nov 23 10:39 .\ndrwxr-xr-x@ 252 lchingen  staff    8064 Nov 23 10:38 ..\ndrwxr-xr-x@   9 lchingen  staff     288 Nov 23 10:39 old-1\ndrwxr-xr-x@   4 lchingen  staff     128 Nov 23 10:38 old-2\ndrwxr-xr-x@   6 lchingen  staff     192 Nov 23 10:39 old-3\n-rw-r--r--@   1 lchingen  staff  225599 Nov 23 10:39 results.json\ndrwxr-xr-x@   4 lchingen  staff     128 Nov 23 10:39 served\n","exit_code":0,"status":"completed"}}
