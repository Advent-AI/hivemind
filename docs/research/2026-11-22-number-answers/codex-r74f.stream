/views/store.py:396:    \"\"\"None on a ledger written before D202 (no revisions table), which read-only openers cannot extend.\"\"\"\nsrc/hivemind/views/store.py:490:def last_completed_day(conn):\n","exit_code":0,"status":"completed"}}
