{"type":"item.completed","item":{"id":"item_28","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"python3.13 -B -c 'from datetime import date; print(date.fromisoformat(\\\"20260825\\\"))'; nl -ba src/hivemind/views/store.py | sed -n '222,233p;488,506p'; rg -n 'YYYY-MM-DD|as_of.*isoformat' src/hivemind scripts | head -35\"","aggregated_output":"2026-08-25\n   222\t\n   223\tdef open_read_only(path):\n   224\t    \"\"\"The views database for a reader (the agent layer, reports): no schema creation, no writes. Opened by its own path: a symlink\n   225\t    resolved, a store with another hard link refused (`live_lock.LockRefused`; live-service/OPERATING-CONTRACT.md, row 7), since\n   226\t    SQLite finds a WAL store's side files by the opened path.\"\"\"\n   227\t    from hivemind import live_lock\n   228\t    real, _ = live_lock.own_path(path)\n   229\t    conn = sqlite3.connect(f'file:{real}?mode=ro', uri=True, timeout=READ_BUSY_TIMEOUT_SECONDS)\n   230\t    conn.row_factory = sqlite3.Row\n   231\t    return conn\n   232\t\n   233\t\n   488\t\n   489\t\n   490\tdef last_completed_day(conn):\n   491\t    row = conn.execute('select day from days_completed order by id desc limit 1').fetchone()\n   492\t    return row['day'] if row else None\n   493\t\n   494\t\n   495\t# ---------- research groups (D149) ----------\n   496\t\n   497\tdef add_group(conn, *, group_id, name, scope, seq, input_id, object_ids=(), aliases=()):\n   498\t    \"\"\"A research group, created when the first accepted thesis that cites it is written, with the names it goes by; the\n   499\t    search text carries the objects of its members so that an item about those objects finds it.\"\"\"\n   500\t    insert(conn, 'thesis_groups', group_id=group_id, name=name, scope=scope, aliases=json.dumps(list(aliases), ensure_ascii=False), created_seq=seq, created_from_input=input_id)\n   501\t    conn.execute('insert into groups_fts (group_id, text) values (?, ?)', (group_id, f'{\" \".join(object_ids)} {name} {scope} {\" \".join(aliases)}'))\n   502\t\n   503\t\n   504\tdef add_group_aliases(conn, group_id, aliases, seq, input_id):\n   505\t    \"\"\"The names a later declaration gives a stored group (D166: a declaration whose names hit a stored group is that group, so its\n   506\t    other names are the matter's too). Each name is appended once, case-insensitively, and joins the group's search text.\nscripts/hivemind_api.py:229:            raise ValueError('changes needs since=YYYY-MM-DD')\n","exit_code":0,"status":"completed"}}
