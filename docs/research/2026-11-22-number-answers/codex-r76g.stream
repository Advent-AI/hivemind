 23 11:21 round75e-brief.md\n-rw-r--r--@   1 lchingen  staff     2293 Nov 23 11:30 round75f-brief.md\n-rw-r--r--@   1 lchingen  staff     1568 Nov 23 11:34 round75g-brief.md\n-rw-r--r--@   1 lchingen  staff     2125 Nov 23 11:41 round76-brief.md\n-rw-r--r--@   1 lchingen  staff     1074 Nov 23 11:44 round76b-brief.md\n-rw-r--r--@   1 lchingen  staff     1077 Nov 23 11:46 round76c-brief.md\n-rw-r--r--@   1 lchingen  staff     1077 Nov 23 11:48 round76d-brief.md\n-rw-r--r--@   1 lchingen  staff     1077 Nov 23 11:50 round76e-brief.md\n-rw-r--r--@   1 lchingen  staff     1171 Nov 23 11:52 round76f-brief.md\n-rw-r--r--@   1 lchingen  staff     1818 Nov 23 11:54 round76g-brief.md\n-rw-r--r--@   1 lchingen  staff    38590 Nov 22 20:04 s4-ratestop-calc_small.py.txt\n-rw-r--r--@   1 lchingen  staff      812 Nov 22 20:22 s4-replay.log\n-rw-r--r--@   1 lchingen  staff     1757 Nov 22 20:04 s4_census.py\n-rw-r--r--@   1 lchingen  staff     4288 Nov 22 20:22 s4_replay.py\n-rw-r--r--@   1 lchingen  staff     9408 Nov 22 23:29 small-cases.log\n-rw-r--r--@   1 lchingen  staff     5924 Nov 22 23:29 small-mutants.log\n-rw-r--r--@   1 lchingen  staff     2603 Nov 22 23:29 small-rehearsal.log\n-rw-r--r--@   1 lchingen  staff    47880 Nov 22 23:29 small_cases.py\n-rw-r--r--@   1 lchingen  staff     8555 Nov 22 23:29 small_mutants.py\n-rw-r--r--@   1 lchingen  staff    13493 Nov 22 19:20 small_rehearsal.py\n     201 docs/prd/10-filing-phase.md\n    1239 docs/CURRENT_STATE.md\n     299 docs/research/2026-11-22-number-answers/RELEASE-PAGE.md\n    1739 total\n","exit_code":0,"status":"completed"}}
