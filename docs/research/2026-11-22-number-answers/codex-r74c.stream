{"type":"item.completed","item":{"id":"item_25","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba tests/test_bound_resolver.py | sed -n '42,90p;125,170p'; nl -ba docs/research/2026-11-14-use-acceptance/live-service/OPERATING-CONTRACT.md | sed -n '304,333p'\"","aggregated_output":"    42\t        for name, kind, call in bound_cases.calls(conn, state):\n    43\t            found[(state, name, kind)] = bound_cases.outcome(call)\n    44\t        if state == 'partial':\n    45\t            view_id, created_seq = bound_cases.first_view(conn)\n    46\t            item_of = bound_cases.bundle.item_lookup(None)\n    47\t            explicit_last = {'bundle.view_bundle': bound_cases.outcome(lambda: bound_cases.bundle.view_bundle(conn, item_of, view_id, LAST['partial'])),\n    48\t                             'bundle.not_judged': bound_cases.outcome(lambda: bound_cases.bundle.not_judged(conn, view_id, created_seq, LAST['partial'])),\n    49\t                             'bundle.days': bound_cases.outcome(lambda: bound_cases.bundle.days(conn, LAST['partial']))}\n    50\t        conn.close()\n    51\t    return found, explicit_last\n    52\t\n    53\t\n    54\tdef expected(state, name, kind, explicit_last):\n    55\t    before = BASELINE[f'{state}|{name}|{kind}']\n    56\t    if state == 'first_day':\n    57\t        return ['error', \"FirstDayNotCompleted: the store's first day has not completed\"]\n    58\t    if kind == 'future' and state in LAST:\n    59\t        return ['error', f\"BoundNotCompleted: day not completed: {bound_cases.STATES[state]['future']} is after the last completed day {LAST[state]}\"]\n    60\t    if state == 'partial' and kind == 'omitted' and name in UNFILTERED:\n    61\t        return explicit_last[name]\n    62\t    if name == 'search.search' and kind == 'past' and before != ['ok', None]:\n    63\t        # row 4a: the lexical ranking now counts only views visible at the bound, so a past bound no longer ranks among views created\n    64\t        # after it; its own proof is the backup equality in test_search_live.py\n    65\t        return CHANGED_BY_ROW_4A\n    66\t    if state == 'empty' and name == 'bundle.not_judged' and kind in ('past', 'future'):\n    67\t        # the direct-call rule (round 122): a view not visible at an explicit bound is refused, here one the empty store does not hold\n    68\t        return ['error', f\"KeyError: 'v1 is not available as of {bound_cases.STATES[state][kind]}'\"]\n    69\t    return before\n    70\t\n    71\t\n    72\tCHANGED_BY_ROW_4A = 'changed by row 4a'\n    73\t\n    74\t\n    75\tdef test_every_call_on_every_state_keeps_todays_outcome_except_where_the_contract_changes_it(outcomes):\n    76\t    found, explicit_last = outcomes\n    77\t    assert len(found) == len(BASELINE) == 176\n    78\t    wrong = {key: (got, expected(*key, explicit_last)) for key, got in found.items()\n    79\t             if expected(*key, explicit_last) != CHANGED_BY_ROW_4A and got != expected(*key, explicit_last)}\n    80\t    assert wrong == {}\n    81\t\n    82\t\n    83\tdef test_the_partial_store_no_longer_returns_its_half_processed_day_by_default(outcomes):\n    84\t    \"\"\"The decisive case: before the change an omitted bound on the served store's bundle functions read 2026-08-29's records.\"\"\"\n    85\t    found, explicit_last = outcomes\n    86\t    changed = [name for name in UNFILTERED if BASELINE[f'partial|{name}|omitted'] != found[('partial', name, 'omitted')]]\n    87\t    assert 'bundle.days' not in changed or found[('partial', 'bundle.days', 'omitted')] == explicit_last['bundle.days']\n    88\t    assert all(found[('partial', name, 'omitted')] == explicit_last[name] for name in UNFILTERED)\n    89\t\n    90\t\n   125\t                     for n in ast.walk(node) if isinstance(n, ast.Call)}\n   126\t            yield node.name, calls\n   127\t\n   128\t\n   129\tdef structural_breaches():\n   130\t    \"\"\"Every function of the four modules with a date parameter calls the resolver or is a listed helper; nothing outside the\n   131\t    resolver calls `default_as_of`.\"\"\"\n   132\t    breaches = []\n   133\t    for module in HELPERS:\n   134\t        for name, calls in _date_functions(module):\n   135\t            if name not in HELPERS[module] and not calls & {'resolve_bound', 'resolve_range'}:\n   136\t                breaches.append(f'{module}.{name}: takes a date and does not resolve it')\n   137\t        source = open(os.path.join(ROOT, 'src', 'hivemind', f'{module}.py')).read()\n   138\t        for node in ast.walk(ast.parse(source)):\n   139\t            if isinstance(node, ast.FunctionDef) and node.name not in ('resolve_bound', 'default_as_of'):\n   140\t                for call in ast.walk(node):\n   141\t                    if isinstance(call, ast.Call) and (getattr(call.func, 'attr', None) == 'default_as_of' or getattr(call.func, 'id', None) == 'default_as_of'):\n   142\t                        breaches.append(f'{module}.{node.name}: calls default_as_of outside the resolver')\n   143\t    return breaches\n   144\t\n   145\t\n   146\tdef test_no_module_resolves_a_bound_outside_the_resolver():\n   147\t    assert structural_breaches() == []\n   148\t\n   149\t\n   150\tdef test_the_api_maps_the_three_refusals_with_their_days():\n   151\t    import hivemind_api\n   152\t    assert hivemind_api.error_response(service.FirstDayNotCompleted()) == (503, {'error': \"the store's first day has not completed\"})\n   153\t    assert hivemind_api.error_response(service.BoundNotCompleted('2026-09-30', '2026-08-28')) == (\n   154\t        409, {'error': 'day not completed', 'requested': '2026-09-30', 'last_completed_day': '2026-08-28'})\n   155\t    assert hivemind_api.error_response(service.RangeNotOrdered('2026-08-21', '2026-08-20')) == (\n   156\t        409, {'error': 'range start after its end', 'start': '2026-08-21', 'end': '2026-08-20'})\n   157\t    assert hivemind_api.error_response(KeyError('v9')) == (404, {'error': \"not found: 'v9'\"})\n   158\t\n   159\t\n   160\tdef test_a_ledger_without_the_completed_day_table_fails_with_the_missing_table_error(tmp_path):\n   161\t    \"\"\"What is checked (council round 126): today's default (`default_as_of`, unchanged) already fails on such a ledger with SQLite's\n   162\t    missing-table error, so an omitted bound failed this way before too; every public function, with an omitted or an explicit bound,\n   163\t    now fails with that same error. Before the resolver an explicit bound skipped `default_as_of` and could answer; that case is a\n   164\t    change, with no such ledger among the 143 stored ones.\"\"\"\n   165\t    import sqlite3\n   166\t    from hivemind import bundle\n   167\t    path = str(tmp_path / 'legacy.sqlite')\n   168\t    bound_cases.store.open_db(path).close()\n   169\t    raw = sqlite3.connect(path)\n   170\t    raw.execute('drop table days_completed')\n   304\t9. **The resolver keeps legacy and empty stores as today:** a legacy ledger with no `days_completed` and an empty store give the\n   305\t   same answers before and after `resolve_bound` is introduced.\n   306\t10. **The paused-writer harness** (`page-contract/serving_while_writing.py`) re-run: every check holds and the first-day case passes.\n   307\t\n   308\t## Row 3's product-facing contract (council rounds 120 to 123; A1, clamping, withdrawn)\n   309\t\n   310\t**The rule.**\n   311\t\n   312\t- **On every store with a `days_completed` table**, finished or not, partial rows or not, an explicit upper bound later than the last\n   313\t  completed day is refused. The same date gets the same answer whenever it is asked.\n   314\t- An omitted bound gives the last completed day, as today.\n   315\t- **Steps but no completed day:** refused as the first day.\n   316\t- **`days_completed` present with no steps and no completed day** (an empty new store): read as today. An omitted bound gives what\n   317\t  `default_as_of` gives today (none), and an explicit bound passes.\n   318\t- **A ledger without the `days_completed` table:** today's default already queries that table (`store.last_completed_day`), so such\n   319\t  a ledger already fails today with SQLite's \"no such table\" for an omitted bound. Through the resolver, an explicit bound fails\n   320\t  the same way too, where before it skipped the default and could answer: a change, with none among the 143 stored ledgers.\n   321\t- **Ranges** (amended in council round 124): a start after its resolved end is refused, for `changes` and `history` alike. A start\n   322\t  equal to the end reads as before: an empty window for `changes`, whose start is excluded, so a polling client keeps its empty\n   323\t  answer until a day completes; and that one day for `history`, whose start is included.\n   324\t\n   325\t**The owner, and what the structural check enforces.**\n   326\t\n   327\t- **`service.resolve_bound(conn, bound)`** raises `FirstDayNotCompleted` or `BoundNotCompleted(requested, last_completed_day)`, and is\n   328\t  idempotent: a bound it has already passed passes again. On an empty store (tables, no steps, no completed day) or a legacy ledger,\n   329\t  an omitted bound resolves to what `default_as_of` gives today, which can be `None`.\n   330\t- **`service.resolve_range(conn, start, end)`** resolves `end` through `resolve_bound`, then raises `RangeNotOrdered(start, end)`\n   331\t  when the start is after the end (round 124). When the end resolves to `None` (an empty store), it compares nothing and keeps\n   332\t  today's outcome.\n   333\t- `error_response` maps all three exceptions.\n","exit_code":0,"status":"completed"}}
