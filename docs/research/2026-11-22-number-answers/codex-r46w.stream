daries(bands, a, b):\ncalc_check.py:788:            kind, bound = 'overlap', {'lower': '>' if strict else '>=', 'upper': '<' if strict else '<=', 'two-sided': 'approx', 'mixed': 'mixed', None: None}[side]\ncalc_check.py:801:            alt_override = (alt, bound)\ncalc_check.py:802:            alt_vals = _evaluate_bounded(figs, refs, {fig['id']: alt_override})\n   143\t\n   144\t\n   145\tDIRECTION = {'>': 'lower', '>=': 'lower', 'approx_above': 'lower', '<': 'upper', '<=': 'upper', 'approx_below': 'upper',\n   146\t             'approx': 'two-sided', 'mixed': 'mixed', None: None}\n   147\tFLIP = {'lower': 'upper', 'upper': 'lower', 'two-sided': 'two-sided', 'mixed': 'mixed', None: None}\n   148\t\n   149\t\n   150\tdef _bound_direction(op, ins, signs=None):\n   151\t    \"\"\"For positive operands: which side the result is bounded on, from its inputs' bounds (None: a point). [46u.2] A term a sum or\n   152\t    roll_forward subtracts flips its side.\"\"\"\n   153\t    dirs = [DIRECTION.get(i.get('bound')) for i in ins]\n   154\t    if op in ('sum', 'roll_forward') and signs:\n   155\t        dirs = [FLIP[d] if k < 0 else d for d, k in zip(dirs, signs)]\n   156\t    if op == 'ratio' and len(dirs) == 2:\n   157\t        dirs = [dirs[0], FLIP[dirs[1]]]\n   158\t    if op == 'difference' and len(dirs) == 2:\n   159\t        dirs = [dirs[0], FLIP[dirs[1]]]\n   160\t    found = {d for d in dirs if d}\n   161\t    if not found:\n   162\t        return None\n   163\t    if 'mixed' in found or {'lower', 'upper'} <= found:     # [46v] opposing bounds leave the result unbounded\n   164\t        return 'mixed'\n   165\t    return found.pop() if len(found) == 1 and 'two-sided' not in found else 'two-sided'\n   166\t\n   167\t\n   168\tdef _outcome_set(fig):\n   169\t    \"\"\"The values an outcome allows: (low, low_closed, high, high_closed); a bound keeps its side open or closed.\"\"\"\n   170\t    lo, hi = _interval(fig)\n   171\t    b = fig.get('bound')\n   172\t    inf = float('inf')\n   173\t    if b == '>':\n   174\t        return (lo, False, inf, False)\n   175\t    if b in ('>=', 'approx_above'):\n   176\t        return (lo, True, inf, False)\n   177\t    if b == '<':\n   178\t        return (-inf, False, hi, False)\n   179\t    if b in ('<=', 'approx_below'):\n   180\t        return (-inf, False, hi, True)\n   181\t    if b == 'mixed':                                    # [46v] any value: only possible crossings\n   182\t        return (-inf, False, inf, False)\n   183\t    return (lo, True, hi, True)\n   184\t\n   185\t\n   186\tdef _overlaps(values, band):\n   187\t    \"\"\"A band [low, high) (None: open-ended) shares at least one value with the outcome's set.\"\"\"\n   188\t    lo, lo_c, hi, hi_c = values\n   189\t    b_lo = band[0] if band[0] is not None else float('-inf')\n   190\t    b_hi = band[1] if band[1] is not None else float('inf')\n   191\t    low, low_closed = (lo, lo_c) if lo > b_lo else ((b_lo, True) if b_lo > lo else (lo, lo_c))\n   192\t    high, high_closed = (hi, hi_c) if hi < b_hi else ((b_hi, False) if b_hi < hi else (hi, False))\n   193\t    return low < high or (low == high and low_closed and high_closed)\n   194\t\n   195\t\n   196\tdef _exceeds(part, whole):\n   197\t    \"\"\"[46t.2] With a bound on either side, the part exceeds its whole only when no pair of allowed values fits (part min above whole\n   198\t    max). Closed ranges and points keep the paired-end rule (each end of the part at most the same end of the whole).\"\"\"\n   199\t    (plo, plc, phi, phc), (wlo, wlc, whi, whc) = part, whole\n   200\t    inf = float('inf')\n   201\t    if inf in (abs(plo), abs(phi), abs(wlo), abs(whi)):\n   202\t        return plo > whi + 1e-9 or (abs(plo - whi) <= 1e-9 and not (plc and whc))\n   203\t    return plo > wlo + 1e-9 or phi > whi + 1e-9\n   204\t\n   205\t\n   206\tdef _below(values, edge):\n   207\t    lo, lo_c, hi, hi_c = values\n   208\t    return hi < edge or (hi == edge and not hi_c)\n   209\t\n   210\t\n   211\tdef _at_or_above(values, edge):\n   212\t    lo, lo_c, hi, hi_c = values\n   213\t    return lo >= edge\n   214\t\n   215\t\n   216\tdef _crossings(base, alt, bands):\n   217\t    \"\"\"Band edges between two value sets, each with its own certainty: definite when one set lies wholly below the edge and the other\n   218\t    wholly at or above it; possible when the sets differ and the edge lies within their span.\"\"\"\n   219\t    edges = sorted({e for band in bands for e in band if e is not None})\n   220\t    definite = [e for e in edges if (_below(base, e) and _at_or_above(alt, e)) or (_below(alt, e) and _at_or_above(base, e))]\n   221\t    span_lo, span_hi = min(base[0], alt[0]), max(base[2], alt[2])\n   222\t    possible = [e for e in edges if e not in definite and span_lo < e <= span_hi and base != alt]\n   223\t    return definite, possible\n   224\t\n   225\t\n   226\tSTRICT = {'>', '<'}\n   227\t\n   228\t\n   229\tdef _evaluate_bounded(figs, refs, overrides):\n   230\t    \"\"\"[46t.1] Recompute (interval, bound) for every figure, carrying open and closed bounds through the arithmetic.\"\"\"\n   231\t    values, order, done = {}, [], set()\n   232\t\n   233\t    def visit(fid):\n   234\t        if fid in done:\n   235\t            return\n   236\t        done.add(fid)\n   237\t        for r in refs(figs[fid]):\n   238\t            if r in figs:\n   239\t                visit(r)\n   240\t        order.append(fid)\n   241\t    for fid in figs:\n   242\t        visit(fid)\n   243\t    for fid in order:\n   244\t        fig = figs[fid]\n   245\t        if fid in overrides:\n   246\t            values[fid] = overrides[fid]\n   247\t        elif fig['kind'] == 'computed' and fig.get('operation') in OPERATIONS:\n   248\t            ins = [values[i] for i in fig['inputs']]\n   249\t            interval = _compute(fig['operation'], [iv + (figs[i]['unit'],) for (iv, _), i in zip(ins, fig['inputs'])], fig.get('signs'), fig['unit'])\n   250\t            pseudo = [{'bound': b} for _, b in ins]\n   251\t            side = _bound_direction(fig['operation'], pseudo, fig.get('signs'))\n   252\t            strict = any(b in STRICT for _, b in ins)\n   253\t            bound = {'lower': '>' if strict else '>=', 'upper': '<' if strict else '<=', 'two-sided': 'approx', 'mixed': 'mixed', None: None}[side]\n   254\t            values[fid] = (interval, bound)\n   255\t        else:\n   256\t            values[fid] = (_interval(fig), fig.get('bound'))\n   257\t    return values\n   258\t\n   259\t\n   260\tdef _set_from(interval, bound):\n   261\t    fig = {'low': interval[0], 'high': interval[1], 'bound': bound} if interval[0] != interval[1] else {'value': interval[0], 'bound': bound}\n   262\t    return _outcome_set(fig)\n   263\t\n   264\t\n   342\t    # C1 sources, prior pointers\n   343\t    for fig in figs.values():\n   344\t        if fig['kind'] == 'source':\n   345\t            errors += _source_errors(fig, passages)\n   346\t        if fig['kind'] == 'prior' and not fig.get('pointer'):\n   347\t            errors.append(('C7', f'{fig[\"id\"]}: a prior forecast needs an exact pointer to an earlier answer shown in the request'))\n   348\t\n   349\t    # C2 arithmetic and bound propagation\n   350\t    for fig in figs.values():\n   351\t        if fig['kind'] != 'computed' or fig.get('operation') not in OPERATIONS:\n   352\t            continue\n   353\t        ins = [figs[i] for i in fig['inputs'] if i in figs]\n   354\t        expected = _compute(fig['operation'], [_interval(i) + (i['unit'],) for i in ins], fig.get('signs'), fig['unit'])\n   355\t        lo, hi = _interval(fig)\n   356\t        if fig['operation'] == 'range_from_relative' or ('low' in fig):\n   357\t            ok = _close(lo, expected[0], fig['unit']) and _close(hi, expected[1], fig['unit'])\n   358\t        else:\n   359\t            ok = _close(lo, (expected[0] + expected[1]) / 2, fig['unit'])\n   360\t        if not ok:\n   361\t            errors.append(('C2', f'{fig[\"id\"]}: declared {lo}–{hi} but {fig[\"operation\"]} of {fig[\"inputs\"]} gives {expected[0]:.2f}–{expected[1]:.2f}'))\n   362\t        want = _bound_direction(fig['operation'], ins, fig.get('signs'))\n   363\t        have = DIRECTION.get(fig.get('bound'))\n   364\t        if want == 'mixed':\n   365\t            errors.append(('C2', f'{fig[\"id\"]}: its inputs are bounded on opposite sides, so its value is unbounded; state it as an estimate'))\n   366\t        elif want is not None and have != want:\n   367\t            errors.append(('C2', f'{fig[\"id\"]}: its inputs make it a {want} bound, but it is declared {fig.get(\"bound\") or \"a point\"}'))\n   368\t        elif want is None and fig.get('bound'):\n   369\t            errors.append(('C2', f'{fig[\"id\"]}: its inputs are points, but it is declared a bound ({fig[\"bound\"]})'))\n   370\t\n   371\t    # C8 operand compatibility\n   372\t    for fig in figs.values():\n   373\t        if fig['kind'] != 'computed' or fig.get('operation') not in OPERATIONS:\n   374\t            continue\n   375\t        ins = [figs[i] for i in fig['inputs'] if i in figs]\n   376\t        op, rel, out = fig['operation'], fig.get('relation'), fig['what']\n   377\t        differing = [i['id'] for i in ins if i['unit'] not in ('%', 'x') and\n   774\t    members = family['members']\n   775\t\n   776\t    def downstream_formula(start, outcome_id):\n   777\t        \"\"\"True when every figure between start and the outcome (the outcome included) is computed.\"\"\"\n   778\t        between = [f for f in [outcome_id] + sorted(_upstream_of(outcome_id, figs, refs)) if start in _upstream_of(f, figs, refs)]\n   779\t        return all(figs[f]['kind'] == 'computed' for f in between)\n   780\t    for fig in figs.values():\n   781\t        alt, kind = None, None\n   782\t        if fig['kind'] == 'computed' and fig.get('relation') == 'overlap_unknown' and fig.get('disputed') in fig.get('inputs', []):\n   783\t            keep = [i for i in fig['inputs'] if i != fig['disputed']]\n   784\t            signs = [s for i, s in zip(fig['inputs'], fig.get('signs') or [1] * len(fig['inputs'])) if i != fig['disputed']]\n   785\t            alt = _compute(fig['operation'], [_interval(figs[i]) + (figs[i]['unit'],) for i in keep], signs, fig['unit'])\n   786\t            side = _bound_direction(fig['operation'], [figs[i] for i in keep], signs)      # [46u.1] the retained operands' bounds\n   787\t            strict = any(figs[i].get('bound') in STRICT for i in keep)\n   788\t            kind, bound = 'overlap', {'lower': '>' if strict else '>=', 'upper': '<' if strict else '<=', 'two-sided': 'approx', 'mixed': 'mixed', None: None}[side]\n   789\t        elif fig['kind'] == 'estimate' and fig.get('adjusts'):\n   790\t            target = figs[fig['adjusts']['figure']]\n   791\t            alt, kind, bound = _interval(target), 'adjustment', target.get('bound')\n   792\t        if kind is None:\n   793\t            continue\n   794\t        for view_id, outcome_id in outcomes.items():\n   795\t            if fig['id'] != outcome_id and fig['id'] not in _upstream_of(outcome_id, figs, refs):\n   796\t                continue\n   797\t            if not downstream_formula(fig['id'], outcome_id):\n   798\t                out.append({'type': kind, 'figure': fig['id'], 'outcome': view_id, 'certainty': 'undetermined'})\n   799\t                continue\n   800\t            base_vals = _evaluate_bounded(figs, refs, {})                 # [46s, 46t.1] bounds carried through recomputation\n   801\t            alt_override = (alt, bound)\n   802\t            alt_vals = _evaluate_bounded(figs, refs, {fig['id']: alt_override})\n   803\t            base_set, alt_set = _set_from(*base_vals[outcome_id]), _set_from(*alt_vals[outcome_id])\n   804\t            definite, possible = _crossings(base_set, alt_set, members[view_id]['bands'])\n   805\t            finite = lambda v: v if abs(v) != float('inf') else None\n   806\t            out.append({'type': kind, 'figure': fig['id'], 'outcome': view_id, 'value': [finite(base_set[0]), finite(base_set[2])],\n   807\t                        'alternate': [finite(alt_set[0]), finite(alt_set[2])], 'alternate_bound': bound,\n   808\t                        'definite': definite, 'possible': possible})                      # [46t.1] certainty per boundary\n   809\t    return out\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_6","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"python3 -B -c '\nimport pathlib,json,io,contextlib,copy,types\nimport gate as g, calc_check as c, render_v13 as r, mutants\ndef replay(func, log):\n    p=io.StringIO()\n    with contextlib.redirect_stdout(p): status=func()\n    assert status==0 and p.getvalue()==pathlib.Path(log).read_text()\nreplay(g.main,'\\\\''gate-run19.txt'\\\\'')\nassert g.MANIFEST==json.loads(pathlib.Path('\\\\''gate-run19.fixtures.json'\\\\'').read_text())\nreplay(r.main,'\\\\''render-r1.txt'\\\\'')\noriginal=g.cc\npath=pathlib.Path('\\\\''calc_check.py'\\\\'')\nsrc=path.read_text()\nfor name,old,new,target in mutants.MUTANTS:\n    g.cc=original\n    if old:\n        assert src.count(old)==1,name\n        mod=types.ModuleType('\\\\''in_memory_calc_check'\\\\'')\n        exec(compile(src.replace(old,new),str(path),'\\\\''exec'\\\\''),mod.__dict__)\n        g.cc=mod\n    misses={name for name,ok,_,_ in g.run() if not ok}\n    assert (target in misses if target else not misses),(name,misses)\ng.cc=original\nprint('\\\\''72 gate items, 37 mutants and stored render reproduced'\\\\'')\ndef fig(calc,fid):\n    return next(f for f in calc['\\\\''figures'\\\\''] if f['\\\\''id'\\\\'']==fid)\ndef check(name,case):\n    fam,x=case['\\\\''family'\\\\''],case['\\\\''calc'\\\\'']\n    schema=r.v13_schema(list(fam['\\\\''members'\\\\'']),list(g.R2_PASSAGES),[])\n    wire=r.strict(x,schema)\n    clean=r.without_nulls(wire)\n    report=c.check(fam,g.R2_PASSAGES,clean)\n    print(name,r.model.check_schema(wire,schema),report,c.publish_decision(fam,clean,report))\nfor name in ('\\\\''R2'\\\\'','\\\\''R2m'\\\\'','\\\\''R2b1'\\\\'','\\\\''R2b2a'\\\\'','\\\\''R2b2b'\\\\''):\n    check(name,g.MANIFEST[name])\ncase=copy.deepcopy(g.MANIFEST['\\\\''R2'\\\\''])\nx=case['\\\\''calc'\\\\'']\nfig(x,'\\\\''talks'\\\\'').update(bound='\\\\''>'\\\\'',basis_text='\\\\''The separately booked pending commitment had a lower bound of \"'$6.5B. It was reversed in full.'\"'\\\\'')\nfig(x,'\\\\''end'\\\\'').update(inputs=['\\\\''bal'\\\\'','\\\\''add18'\\\\'','\\\\''mtk'\\\\'','\\\\''talks'\\\\'','\\\\''talks'\\\\''],signs=[1,1,1,1,-1],value=46.5)\nx['\\\\''answers'\\\\''][0]['\\\\''rung'\\\\'']=2\ncheck('\\\\''R2 books then fully reverses the same bounded commitment'\\\\'',case)\nprint('\\\\''control totals at low and high allowed amounts'\\\\'',[(a,25+18+3.5+a-a,25+3.5+a-a) for a in (6.6,70.)])\ncase=copy.deepcopy(g.MANIFEST['\\\\''R2b2a'\\\\''])\nx=case['\\\\''calc'\\\\'']\nprint('\\\\''R2b2a terms'\\\\'',[(f['\\\\''id'\\\\''],f.get('\\\\''bound'\\\\'')) for f in x['\\\\''figures'\\\\''] if f.get('\\\\''bound'\\\\'')])\n'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
