{"type":"item.started","item":{"id":"item_46","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"python3 -B -c 'from pathlib import Path\nimport sqlite3,collections,re,sys,json\nroot=Path(\\\"poc/data\\\")\nbase=root/\\\"comparison-2026-11-17\\\"\ndef conn(p):\n c=sqlite3.connect(p.resolve().as_uri()+\\\"?mode=ro&immutable=1\\\",uri=True)\n c.row_factory=sqlite3.Row\n return c\ninputs=[(f\\\"old-{i}\\\",base/f\\\"run/old-{i}/prod/views.sqlite\\\",base/\\\"items-comparison.sqlite\\\") for i in (1,2,3)]+[(\\\"served\\\",root/\\\"served-2026-10-28-v34-nvda-3m-through-0828/views.sqlite\\\",root/\\\"items-nvda-2026-07-01-10-27.sqlite\\\")]\nfor name,p,ip in inputs:\n c=conn(p); i=conn(ip); sids=set(r[0] for r in c.execute(\\\"select distinct input_id from evidence_sources\\\")); src=[tuple(r) for r in i.execute(\\\"select input_id,title,publisher,source_uri from items\\\") if r[0] in sids]\n print(name,\\\"source values\\\",len(src),\\\"empty\\\", {f:sum(not r[k] for r in src) for k,f in enumerate([\\\"id\\\",\\\"title\\\",\\\"publisher\\\",\\\"uri\\\"])})\n for a,b,d,u in src:\n  if not u: print(\\\"no uri example\\\",a,(b or \\\"\\\")[:90]);break\n if name in ('\\\\''old-1'\\\\'','\\\\''old-2'\\\\''):\n  for t in ['\\\\''v8'\\\\'','\\\\''v38'\\\\'','\\\\''v15'\\\\'']:\n   v=c.execute(\\\"select question,measure from views join view_keys using(view_id) where view_id=?\\\",(t,)).fetchone()\n   print(t,tuple(v) if v else None)\n'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
