{"type":"item.started","item":{"id":"item_25","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"python3 -B -c 'from pathlib import Path\nimport sqlite3,collections,re,sys,json\nroot=Path(\\\"poc/data\\\")\nbase=root/\\\"comparison-2026-11-17\\\"\ndef conn(p):\n c=sqlite3.connect(p.resolve().as_uri()+\\\"?mode=ro&immutable=1\\\",uri=True)\n c.row_factory=sqlite3.Row\n return c\ninputs=[(f\\\"old-{i}\\\",base/f\\\"run/old-{i}/prod/views.sqlite\\\",base/\\\"items-comparison.sqlite\\\") for i in (1,2,3)]+[(\\\"served\\\",root/\\\"served-2026-10-28-v34-nvda-3m-through-0828/views.sqlite\\\",root/\\\"items-nvda-2026-07-01-10-27.sqlite\\\")]\nname,p,ip=inputs[0]; c=conn(p); i=conn(ip)\nfor row in i.execute(\\\"select input_id, publisher, title, substr(text,1,300) from items where input_id like '\\\\''extra:%'\\\\'' or input_id like '\\\\''truenorth:%'\\\\''\\\"):\n print(tuple(row))\nfor e in c.execute(\\\"select e.*,group_concat(view_id) as v from evidence e join evidence_links using(evidence_id) where created_from_input like '\\\\''truenorth:%'\\\\'' group by e.evidence_id limit 6\\\"):\n print(e['\\\\''v'\\\\''],e['\\\\''one_line'\\\\''],e['\\\\''quote'\\\\''])\nfor e in c.execute(\\\"select e.*, group_concat(view_id) as v from evidence e join evidence_links using(evidence_id) where evidence_id in ('\\\\''e2295'\\\\'','\\\\''e5309'\\\\'','\\\\''e5384'\\\\'','\\\\''e5385'\\\\'') group by e.evidence_id\\\"):\n print(e['\\\\''v'\\\\''],e['\\\\''evidence_id'\\\\''],e['\\\\''one_line'\\\\''],e['\\\\''quote'\\\\''],dict(i.execute(\\\"select input_id,title,source_uri from items where input_id=?\\\",(e['\\\\''created_from_input'\\\\''],)).fetchone()))\n'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
