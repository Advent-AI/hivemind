{"type":"item.started","item":{"id":"item_23","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"python3 -B -c 'from pathlib import Path\nimport sqlite3,collections,re,sys,json\nroot=Path(\\\"poc/data\\\")\nbase=root/\\\"comparison-2026-11-17\\\"\ndef conn(p):\n c=sqlite3.connect(p.resolve().as_uri()+\\\"?mode=ro&immutable=1\\\",uri=True)\n c.row_factory=sqlite3.Row\n return c\ninputs=[(f\\\"old-{i}\\\",base/f\\\"run/old-{i}/prod/views.sqlite\\\",base/\\\"items-comparison.sqlite\\\") for i in (1,2,3)]+[(\\\"served\\\",root/\\\"served-2026-10-28-v34-nvda-3m-through-0828/views.sqlite\\\",root/\\\"items-nvda-2026-07-01-10-27.sqlite\\\")]\nfor name,p,ip in inputs:\n c=conn(p); i=conn(ip)\n print(name,[(t,c.execute(f\\\"select count(*) from {t}\\\").fetchone()[0]) for t in (\\\"views\\\",\\\"evidence\\\",\\\"evidence_sources\\\",\\\"judgements\\\",\\\"replacements\\\")])\n print(\\\"labels\\\",list(map(tuple,c.execute(\\\"select label,count(*) from rungs group by label order by count(*) desc limit 25\\\"))))\n print(\\\"source cats\\\",list(map(tuple,c.execute(\\\"select category,count(*) from evidence_sources group by category\\\"))))\n print(\\\"kinds\\\",list(map(tuple,c.execute(\\\"select distinct object_id,kind from views limit 12\\\"))))\n if name==\\\"old-1\\\":\n  print(\\\"items schema\\\",[r[1] for r in i.execute(\\\"pragma table_info(items)\\\")])\n  print(\\\"questions\\\",list(map(tuple,c.execute(\\\"select view_id,question from views order by rowid\\\"))))\n  print(\\\"judgements\\\",dict(c.execute(\\\"select * from judgements where view_id='\\\\''v8'\\\\'' order by judgement_id desc limit 1\\\").fetchone()))\n  print(\\\"samples\\\", [dict(r) for r in c.execute(\\\"select * from evidence join evidence_links using(evidence_id) where view_id='\\\\''v8'\\\\'' limit 4\\\")])\n'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
