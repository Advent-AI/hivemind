last_check(conn, view_id):\nsrc/hivemind/views/store.py:486:def complete_day(conn, day, seq, at):\nsrc/hivemind/views/store.py:490:def last_completed_day(conn):\nsrc/hivemind/views/store.py:497:def add_group(conn, *, group_id, name, scope, seq, input_id, object_ids=(), aliases=()):\nsrc/hivemind/views/store.py:504:def add_group_aliases(conn, group_id, aliases, seq, input_id):\nsrc/hivemind/views/store.py:520:def add_member(conn, group_id, view_id, seq, input_id, basis='model'):\nsrc/hivemind/views/store.py:528:def _group_record(row, conn=None):\nsrc/hivemind/views/store.py:542:def group(conn, group_id):\nsrc/hivemind/views/store.py:547:def groups_of_view(conn, view_id):\nsrc/hivemind/views/store.py:551:def groups_of_view_at(conn, view_id, seq):\nsrc/hivemind/views/store.py:563:def members_of_group(conn, group_id):\nsrc/hivemind/views/store.py:567:def groups_for_prompt(conn, object_ids, text, top_n=10):\nsrc/hivemind/idea.py:48:def full_payload(text, as_of, parts, candidates, idea_rows):\nsrc/hivemind/idea.py:55:def lean_payload(text, as_of, parts, candidates, idea_rows):\nsrc/hivemind/idea.py:97:def prompts(setting):\nsrc/hivemind/idea.py:106:def object_list(ledger, as_of, aliases=None):\nsrc/hivemind/idea.py:120:def judged(ledger, view_id, as_of, detailed=False):\nsrc/hivemind/idea.py:131:def brief(ledger, results, as_of, detailed=False):\nsrc/hivemind/idea.py:144:def related_views(ledger, view_ids, as_of, exclude=()):\nsrc/hivemind/idea.py:164:def service_direct(part, directs, looks_at):\nsrc/hivemind/idea.py:184:def english(*fields):\nsrc/hivemind/idea.py:188:def call_english(archive, cfg, setting, system, user, schema, name, transport, fields_of):\nsrc/hivemind/idea.py:200:def canonical_query(part, aliases=None):\nsrc/hivemind/idea.py:207:def merged(first, second, limit):\nsrc/hivemind/idea.py:218:def read_idea(ledger, index, items, archive, cfg, text, as_of=None, k=10, aliases=None, semantic=True, transport=None, bundles=True, embed=search.openai_embeddings, on_progress=None):\nsrc/hivemind/service.py:19:def open_ledger(path):\nsrc/hivemind/service.py:24:def default_as_of(conn):\nsrc/hivemind/service.py:29:class FirstDayNotCompleted(ValueError):\nsrc/hivemind/service.py:37:class BoundNotCompleted(ValueError):\nsrc/hivemind/service.py:45:class RangeNotOrdered(ValueError):\nsrc/hivemind/service.py:53:def first_day_unfinished(conn):\nsrc/hivemind/service.py:57:def resolve_bound(conn, bound, *, unfiltered=False):\nsrc/hivemind/service.py:74:def resolve_range(conn, start, end):\nsrc/hivemind/service.py:88:def seq_day_map(conn):\nsrc/hivemind/service.py:107:def day_of_seq(conn, seq):\nsrc/hivemind/service.py:111:def visible(conn, seq, as_of):\nsrc/hivemind/service.py:118:def view_exists(conn, record, as_of):\nsrc/hivemind/service.py:122:def is_open_as_of(conn, view_id, as_of):\nsrc/hivemind/service.py:129:def state_as_of(conn, view_id, as_of):\nsrc/hivemind/service.py:145:def summaries(conn, as_of=None, include_closed=False):\nsrc/hivemind/service.py:164:def views(conn, object_id=None, as_of=None, include_closed=False):\nsrc/hivemind/service.py:178:def dependencies(conn, view_id, as_of):\nsrc/hivemind/service.py:193:def dependants(conn, view_id, as_of):\nsrc/hivemind/service.py:200:def view(conn, view_id, as_of=None, record=None):\nsrc/hivemind/service.py:224:def evidence_record(conn, evidence_id, as_of, arrived_seq=None):\nsrc/hivemind/service.py:238:def evidence(conn, view_id, as_of=None, tier=None):\nsrc/hivemind/service.py:257:def history(conn, view_id, from_day=None, to_day=None):\nsrc/hivemind/service.py:287:class LedgerError(ValueError):\nsrc/hivemind/service.py:291:class StoreUnreadable(LedgerError):\nsrc/hivemind/service.py:296:def open_pinned(path):\nsrc/hivemind/service.py:312:def _unique(ids):\nsrc/hivemind/service.py:323:def _json(text):\nsrc/hivemind/service.py:334:def record(conn, view_id, as_of=None):\nsrc/hivemind/service.py:348:def changes(conn, since_day, to_day=None):\nsrc/hivemind/service.py:385:def _comparators(clause):\nsrc/hivemind/service.py:404:def operative_clause(condition):\nsrc/hivemind/service.py:422:def _amounts(text):\nsrc/hivemind/service.py:436:def band(condition):\nsrc/hivemind/service.py:487:def numeric_bands(rungs):\nsrc/hivemind/service.py:499:def ladder_bands(rungs):\nsrc/hivemind/service.py:523:def _contains(b, yi):\nsrc/hivemind/service.py:528:def verdict_for(comparator, judged, yi):\nsrc/hivemind/service.py:542:def evaluate(conn, view_id, comparator, value_usd, as_of=None):\nsrc/hivemind/bundle.py:14:def read_snapshot(*connections):\nsrc/hivemind/bundle.py:28:def item_lookup(items_db):\nsrc/hivemind/bundle.py:41:def _visible(views_db, seq, as_of):\nsrc/hivemind/bundle.py:45:def ladder_row(views_db, view_id):\nsrc/hivemind/bundle.py:65:def not_judged(views_db, view_id, created_seq, as_of=None):\nsrc/hivemind/bundle.py:82:def answer_shape(views_db, view_id):\nsrc/hivemind/bundle.py:100:def view_bundle(views_db, item_of, view_id, as_of=None):\nsrc/hivemind/bundle.py:177:def days(views_db, as_of=None):\nsrc/hivemind/bundle.py:183:def _bundles(views_db, items_db, view_ids, as_of=None, coverage='selection'):\nsrc/hivemind/bundle.py:200:def research_groups(conn, view_ids, as_of):\nsrc/hivemind/bundle.py:219:def thesis_bundles(views_db, items_db, view_ids, as_of=None):\nsrc/hivemind/bundle.py:225:def library(views_db, items_db, as_of=None):\n\"\"\"D155: exact identity and same-answer coalescing, shared by matching and writing.\n\nD197: a shared quantity (a candidate admitted as industry_aggregate / shared_quantity, a key stored with scope_source\n'shared') is one thesis per theme, measure and period; its scope (the population or wording of the aggregate) is not\npart of its identity.\"\"\"\nfrom ..universe import scope_key\n\nKEY_VERSION = 2\nSHARED_REASONS = ('industry_aggregate', 'shared_quantity')\nEVENT_MEASURES = ('event', 'policy_event')\n\n\ndef is_shared(value):\n    \"\"\"A shared quantity: by its admission reason on a candidate, by its stored scope source on a key.\"\"\"\n    return value.get('measure') not in (None, 'other', *EVENT_MEASURES) and (value.get('scope_source') == 'shared' or value.get('opens_as') in SHARED_REASONS)\n\n\ndef automatic_key(value, object_id=None):\n    \"\"\"Return a complete, code-owned key, or None when identity still needs judgement.\"\"\"\n    if value.get('key_version') != KEY_VERSION:\n        return None\n    if value.get('measure') in (None, 'other'):\n        return None\n    if is_shared(value):\n        return (object_id or value.get('object'), value['measure'], '', value.get('period_start'), value.get('period_end'),\n                value.get('basis'), value.get('unit'), value.get('event_type'))\n    if value.get('scope_source') not in ('none', 'watch'):\n        return None\n    if value['measure'] in EVENT_MEASURES and value.get('event_type') in (None, 'other', 'n/a'):\n        return None\n    return (object_id or value.get('object'), value['measure'], scope_key(value.get('scope', '')),\n            value.get('period_start'), value.get('period_end'), value.get('basis'), value.get('unit'), value.get('event_type'))\n\n\nGENERATION_MILESTONES = ('launch', 'shipment')\n\n\ndef same_generation_milestones(key, candidate):\n    \"\"\"D248 item 3: a product generation's launch and its shipments are milestones of one question, asked at the step that brings\n    revenue; the judge of sameness (Jev) says whether they are the same generation, this only lifts the event-type conflict.\"\"\"\n    return key.get('measure') == 'event' and key.get('event_type') in GENERATION_MILESTONES and candidate.get('event_type') in GENERATION_MILESTONES\n\n\ndef one_process(key, candidate):\n    \"\"\"D258 (R2-f): a policy process's steps are one process; the model's event-type word for it (licence, approval, other) is not\n    identity. One 14-day draw opened three questions on one licensing decision because that word varied.\"\"\"\n    return 'policy_event' in (key.get('measure'), candidate.get('measure'))\n\n\ndef conflicts(key, candidate, *, merging):\n    \"\"\"Known different quantities/events cannot merge; corrected scopes/periods bind only corrected keys. An event's period is its\n    deadline: another deadline never conflicts (D248 item 2: while the earlier-deadline question is open, a later deadline is its\n    evidence; a closed one is succeeded by `can_succeed`, which compares the periods itself). `event` and `policy_event` are one\n    measure family (D258, R2-f): the model typed one licensing decision both ways, and the names and the judge of sameness decide.\"\"\"\n    if key['measure'] != candidate['measure'] and not (key['measure'] in EVENT_MEASURES and candidate['measure'] in EVENT_MEASURES):\n        return True\n    if (key['event_type'] != candidate.get('event_type', 'n/a') and not same_generation_milestones(key, candidate)\n            and not one_process(key, candidate)):\n        return True\n    for field in ('basis', 'unit'):\n        a, b = key[field], candidate.get(field, 'n/a')\n        if a != 'n/a' and b != 'n/a' and a != b:\n            return True\n    if key.get('key_version') != KEY_VERSION or candidate.get('key_version') != KEY_VERSION:\n        return False\n    if (key.get('scope_source') in ('none', 'watch') and candidate.get('scope_source') in ('none', 'watch')\n            and scope_key(key['scope']) != scope_key(candidate.get('scope', ''))):\n        return True\n    if key['measure'] in EVENT_MEASURES:\n        return False\n    return merging and (key['period_start'], key['period_end']) != (candidate.get('period_start'), candidate.get('period_end'))\n\n\ndef batch_plan(candidates, outcomes):\n    \"\"\"Resolve same-answer duplicates and validate dependencies on the resulting identities before retry ends.\"\"\"\n    aliases, first_by_key, errors = {}, {}, []\n    for candidate in candidates:\n        cid = candidate['id']\n        outcome = outcomes.get(cid, ('skip', None, []))\n        if outcome[0] not in ('new', 'succession'):\n","exit_code":0,"status":"completed"}}
