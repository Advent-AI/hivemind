{"type":"item.started","item":{"id":"item_16","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba src/hivemind/views/store.py | sed -n '8,106p;158,172p;223,242p;348,379p'; nl -ba src/hivemind/vocabulary.py | head -n 55\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba src/hivemind/service.py | sed -n '16,146p;220,257p'; rg -n 'def ladder_bands|def .*bands' src/hivemind/service.py\"","aggregated_output":"    16\tCOMPARATORS = ('>=', '<', '=')\n    17\t\n    18\t\n    19\tdef open_ledger(path):\n    20\t    \"\"\"A read-only connection to a views database.\"\"\"\n    21\t    return store.open_read_only(path)\n    22\t\n    23\t\n    24\tdef default_as_of(conn):\n    25\t    \"\"\"Today's default day: the last completed day, or a legacy ledger's last judgement day. Read only through `resolve_bound`.\"\"\"\n    26\t    return store.last_completed_day(conn) or conn.execute('select max(publication_day) from judgements').fetchone()[0]\n    27\t\n    28\t\n    29\tclass FirstDayNotCompleted(ValueError):\n    30\t    \"\"\"The store holds processing steps and no completed day: its first day is still in progress, and nothing is served from it\n    31\t    (live-service/OPERATING-CONTRACT.md, row 4; open defect 10).\"\"\"\n    32\t\n    33\t    def __init__(self):\n    34\t        super().__init__(\"the store's first day has not completed\")\n    35\t\n    36\t\n    37\tclass BoundNotCompleted(ValueError):\n    38\t    \"\"\"An explicit upper bound later than the store's last completed day: refused, naming that day (OPERATING-CONTRACT.md, row 3).\"\"\"\n    39\t\n    40\t    def __init__(self, requested, last_completed_day):\n    41\t        self.requested, self.last_completed_day = requested, last_completed_day\n    42\t        super().__init__(f'day not completed: {requested} is after the last completed day {last_completed_day}')\n    43\t\n    44\t\n    45\tclass RangeNotOrdered(ValueError):\n    46\t    \"\"\"A range whose start is after its resolved end: a window reaching into days not yet completed (council round 124).\"\"\"\n    47\t\n    48\t    def __init__(self, start, end):\n    49\t        self.start, self.end = start, end\n    50\t        super().__init__(f'range start after its end: {start} to {end}')\n    51\t\n    52\t\n    53\tdef first_day_unfinished(conn):\n    54\t    return store.last_completed_day(conn) is None and conn.execute('select 1 from processing_steps limit 1').fetchone() is not None\n    55\t\n    56\t\n    57\tdef resolve_bound(conn, bound, *, unfiltered=False):\n    58\t    \"\"\"The one owner of an upper date bound, explicit or omitted (OPERATING-CONTRACT.md, row 3).\n    59\t\n    60\t    A store whose first day is in progress is refused. An omitted bound is today's default day; with `unfiltered` (the bundle\n    61\t    functions, whose omitted bound read every record), it is the last completed day, or None (no filter, as before) on a store with\n    62\t    none. An explicit bound later than the last completed day is refused, whatever the store holds after it; one on or before it\n    63\t    passes. Idempotent: a bound it passed passes again.\"\"\"\n    64\t    if first_day_unfinished(conn):\n    65\t        raise FirstDayNotCompleted()\n    66\t    last = store.last_completed_day(conn)\n    67\t    if not bound:\n    68\t        return last if unfiltered else default_as_of(conn)\n    69\t    if last is not None and bound > last:\n    70\t        raise BoundNotCompleted(bound, last)\n    71\t    return bound\n    72\t\n    73\t\n    74\tdef resolve_range(conn, start, end):\n    75\t    \"\"\"A range's end resolved by `resolve_bound` (an explicit future end is refused there); a start after the end is refused. A start\n    76\t    equal to the end reads as before: an empty window for `changes`, whose start is excluded, and that one day for `history`, whose\n    77\t    start is included; a client polling \"what changed since the day I last saw\" keeps its empty answer until a day completes\n    78\t    (council round 124). An end that resolves to None (an empty store) is compared with nothing, as before.\"\"\"\n    79\t    end = resolve_bound(conn, end)\n    80\t    if start and end is not None and start > end:\n    81\t        raise RangeNotOrdered(start, end)\n    82\t    return end\n    83\t\n    84\t\n    85\t_SEQ_DAYS = {}      # id(connection) → (connection, (max sequence, rows), map); a sqlite3 connection cannot carry attributes\n    86\t\n    87\t\n    88\tdef seq_day_map(conn):\n    89\t    \"\"\"sequence number → the publication day of the item or daily round written under it. Cached per connection and\n    90\t    rebuilt when processing_steps has grown (an open ledger gains steps while the pipeline runs); without the cache\n    91\t    one view with 367 pieces of evidence cost 1,224 full scans (0.46 s, measured 2026-10-24).\"\"\"\n    92\t    stamp = tuple(conn.execute('select max(sequence_no), count(*) from processing_steps').fetchone())\n    93\t    entry = _SEQ_DAYS.get(id(conn))\n    94\t    if entry is not None and entry[0] is conn and entry[1] == stamp:\n    95\t        return entry[2]\n    96\t    cache = {}\n    97\t    for seq, day in conn.execute('select sequence_no, min(publication_day) from processing_steps where sequence_no > 0 group by sequence_no'):\n    98\t        cache[seq] = day\n    99\t    if cache:                 # sequence 0 is the seed questions written before the first item (D253): visible from the ledger's first day\n   100\t        cache[0] = min(cache.values())\n   101\t    if len(_SEQ_DAYS) >= 64:\n   102\t        _SEQ_DAYS.clear()\n   103\t    _SEQ_DAYS[id(conn)] = (conn, stamp, cache)\n   104\t    return cache\n   105\t\n   106\t\n   107\tdef day_of_seq(conn, seq):\n   108\t    return seq_day_map(conn).get(seq)\n   109\t\n   110\t\n   111\tdef visible(conn, seq, as_of):\n   112\t    day = day_of_seq(conn, seq)\n   113\t    return day is not None and day <= as_of\n   114\t\n   115\t\n   116\t# ---------- views\n   117\t\n   118\tdef view_exists(conn, record, as_of):\n   119\t    return visible(conn, record['created_seq'], as_of)\n   120\t\n   121\t\n   122\tdef is_open_as_of(conn, view_id, as_of):\n   123\t    for row in conn.execute('select open, after_seq from view_switches where view_id=? order by id desc', (view_id,)):\n   124\t        if visible(conn, row['after_seq'], as_of):\n   125\t            return bool(row['open'])\n   126\t    return True\n   127\t\n   128\t\n   129\tdef state_as_of(conn, view_id, as_of):\n   130\t    \"\"\"The last judgement on or before the day, with the day the current position was first taken.\"\"\"\n   131\t    rows = [dict(r) for r in conn.execute('select * from judgements where view_id=? and publication_day<=? order by judgement_id', (view_id, as_of))]\n   132\t    if not rows:\n   133\t        return None\n   134\t    last = rows[-1]\n   135\t    since, previous = last['publication_day'], None\n   136\t    for row in reversed(rows[:-1]):\n   137\t        if row['rung'] != last['rung']:\n   138\t            previous = row['rung']\n   139\t            break\n   140\t        since = row['publication_day']\n   141\t    return {'position': last['rung'], 'judgement_day': last['publication_day'], 'since_day': since, 'previous_position': previous,\n   142\t            'rounds': len(rows), 'why_changed': last['why_changed'], 'reasons': last['reasons'], 'theme_pushes': _json(last.get('theme_pushes_json'))}\n   143\t\n   144\t\n   145\tdef summaries(conn, as_of=None, include_closed=False):\n   146\t    \"\"\"Every view as of the day as a light record (id, object, kind, what it looks at, the question, due day, open,\n   220\t\n   221\t\n   222\t# ---------- evidence\n   223\t\n   224\tdef evidence_record(conn, evidence_id, as_of, arrived_seq=None):\n   225\t    \"\"\"One piece of evidence with only the sources recorded on or before the day (a later outlet of the same\n   226\t    sentence is not yet known on that day).\"\"\"\n   227\t    piece = store.evidence(conn, evidence_id)\n   228\t    if not piece:\n   229\t        return None\n   230\t    sources = [dict(s) for s in conn.execute('select input_id, category, publication_day, seq from evidence_sources where evidence_id=? order by id', (evidence_id,)) if visible(conn, s['seq'], as_of)]\n   231\t    replaces = conn.execute('select old_evidence_id, seq from replacements where new_evidence_id=?', (evidence_id,)).fetchone()\n   232\t    return {'evidence_id': piece['evidence_id'], 'one_line': piece['one_line'], 'quote': piece['quote'], 'tier': piece['tier'],\n   233\t            'speaker': piece['speaker'], 'original_who': piece['original_who'], 'original_day': piece['original_day'], 'event_time': piece['event_time'],\n   234\t            'day': day_of_seq(conn, arrived_seq if arrived_seq is not None else piece['created_seq']), 'sources': sources, 'outlets': len(sources),\n   235\t            'replaces': replaces['old_evidence_id'] if replaces and visible(conn, replaces['seq'], as_of) else None}\n   236\t\n   237\t\n   238\tdef evidence(conn, view_id, as_of=None, tier=None):\n   239\t    \"\"\"Evidence linked to the view on or before the day and not replaced on or before it, with its sources.\"\"\"\n   240\t    as_of = resolve_bound(conn, as_of)\n   241\t    out = []\n   242\t    for link in conn.execute('select evidence_id, seq from evidence_links where view_id=? order by id', (view_id,)):\n   243\t        if not visible(conn, link['seq'], as_of):\n   244\t            continue\n   245\t        replacement = conn.execute('select new_evidence_id, said_day, seq from replacements where old_evidence_id=? order by id desc limit 1', (link['evidence_id'],)).fetchone()\n   246\t        if replacement and visible(conn, replacement['seq'], as_of):\n   247\t            continue\n   248\t        piece = evidence_record(conn, link['evidence_id'], as_of, link['seq'])\n   249\t        if tier and piece['tier'] != tier:\n   250\t            continue\n   251\t        out.append(piece)\n   252\t    return out\n   253\t\n   254\t\n   255\t# ---------- history\n   256\t\n   257\tdef history(conn, view_id, from_day=None, to_day=None):\n487:def numeric_bands(rungs):\n499:def ladder_bands(rungs):\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba src/hivemind/views/store.py | sed -n '8,106p;158,172p;223,242p;348,379p'; nl -ba src/hivemind/vocabulary.py | head -n 55\"","aggregated_output":"     8\timport json\n     9\timport os\n    10\timport re\n    11\timport sqlite3\n    12\t\n    13\tTABLES = {\n    14\t    'views': 'view_id text primary key, object_id text, object_kind text, kind text, looks_at text, question text, due_day text, year text, created_seq integer, created_from_input text, created_at text',\n    15\t    'rungs': 'view_id text, position integer, label text, condition text, lo real, hi real',\n    16\t    'view_keys': 'view_id text primary key, measure text, scope text, scope_key text, period_start text, period_end text, basis text, unit text, event_type text, seq integer, scope_source text, key_version integer',\n    17\t    'view_switches': 'id integer primary key autoincrement, view_id text, open integer, reason text, by_whom text, after_seq integer',\n    18\t    'judgements': 'judgement_id integer primary key autoincrement, view_id text, seq integer, input_id text, rung integer, reasons text, cited_evidence_json text, cited_views_json text, pushes_json text, changed integer, why_changed text, config_checksum text, call_id integer, request_sha256 text, publication_day text, theme_pushes_json text, reference text, implied_outcome text',\n    19\t    'evidence': 'evidence_id text primary key, quote text, one_line text, speaker text, original_who text, original_day text, tier text, event_time text, created_seq integer, created_from_input text',\n    20\t    'evidence_sources': 'id integer primary key autoincrement, evidence_id text, input_id text, category text, publication_day text, location text, seq integer',\n    21\t    'evidence_links': 'id integer primary key autoincrement, evidence_id text, view_id text, seq integer',\n    22\t    'replacements': 'id integer primary key autoincrement, old_evidence_id text, new_evidence_id text, said_day text, seq integer',   # history: written before D202, read as before\n    23\t    'revisions': 'id integer primary key autoincrement, old_evidence_id text, new_evidence_id text, said_day text, seq integer',      # D202: the new piece revises the old; both stay in force\n    24\t    'same_claims': 'id integer primary key autoincrement, old_evidence_id text, new_evidence_id text, seq integer',                    # D204: the matcher read the new piece as the same claim as the old; both stored, both in force\n    25\t    'dependencies': 'dependency_id integer primary key autoincrement, view_id text, depends_on text, wait_chain_view_id text, wait_year text, direction text, seq integer, kind text default \\'\\'',   # kind: '' (a seed's or the generative matcher's row, read as before) or 'reads' (a chosen reading link, D694)\n    26\t    'dependency_resolutions': 'id integer primary key autoincrement, dependency_id integer, resolved_to text, reason text, seq integer',\n    27\t    'successions': 'id integer primary key autoincrement, view_id text, succeeds text, seq integer',\n    28\t    'handovers': 'id integer primary key autoincrement, input_id text, seq integer, handover_json text',\n    29\t    'match_records': 'id integer primary key autoincrement, seq integer, input_id text, call_no integer, shown_json text, request_sha256 text, call_id integer, decisions_json text, checks_json text, written_json text',\n    30\t    'processing_steps': 'id integer primary key autoincrement, input_id text, sequence_no integer, step text, result text, reason text, publication_day text, at text',\n    31\t    'review_pool_entries': 'id integer primary key autoincrement, kind text, key text, example_json text, seq integer',\n    32\t    'late_statements': 'id integer primary key autoincrement, input_id text, evidence_quote text, reason text, seq integer',\n    33\t    'days_completed': 'id integer primary key autoincrement, day text, seq integer, at text',\n    34\t    # D694: how the links of an article were chosen (views/links.py), append-only per attempt: proposed, then committed or failed\n    35\t    'link_selections': 'id integer primary key autoincrement, attempt_id text, seq integer, input_id text, config_checksum text, status text, record_json text',\n    36\t    # D149 research groups: an ongoing business subject several distinct theses belong to; membership is decided by extraction and written with the thesis\n    37\t    'thesis_groups': 'group_id text primary key, name text, scope text, aliases text, created_seq integer, created_from_input text',\n    38\t    'thesis_group_members': 'id integer primary key autoincrement, group_id text, view_id text, seq integer, input_id text, basis text',\n    39\t    # D166 (2026-11-01): the names a later declaration gives a stored group, appended once each; a group's aliases are its creation's plus these\n    40\t    'thesis_group_aliases': 'id integer primary key autoincrement, group_id text, alias text, seq integer, input_id text',\n    41\t}\n    42\t\n    43\tINDEXES = [\n    44\t    'create index if not exists views_object on views(object_id)',\n    45\t    'create index if not exists judgements_view on judgements(view_id, judgement_id)',\n    46\t    # 06-views step 7: a view is judged once per round (one item = one sequence number)\n    47\t    'create unique index if not exists judgements_once_per_round on judgements(view_id, seq)',\n    48\t    'create index if not exists links_view on evidence_links(view_id)',\n    49\t    'create index if not exists links_evidence on evidence_links(evidence_id)',\n    50\t    'create index if not exists sources_evidence on evidence_sources(evidence_id)',\n    51\t    'create index if not exists steps_input on processing_steps(input_id, id)',\n    52\t    'create index if not exists switches_view on view_switches(view_id, id)',\n    53\t    'create index if not exists deps_view on dependencies(view_id)',\n    54\t]\n    55\t\n    56\t\n    57\tdef open_db(path):\n    58\t    os.makedirs(os.path.dirname(os.path.abspath(path)), exist_ok=True)\n    59\t    conn = sqlite3.connect(path)\n    60\t    conn.row_factory = sqlite3.Row\n    61\t    for name, columns in TABLES.items():\n    62\t        conn.execute(f'create table if not exists {name} ({columns})')\n    63\t        conn.execute(f\"create trigger if not exists {name}_no_update before update on {name} begin select raise(abort, 'append-only'); end\")\n    64\t        conn.execute(f\"create trigger if not exists {name}_no_delete before delete on {name} begin select raise(abort, 'append-only'); end\")\n    65\t    for statement in INDEXES:\n    66\t        conn.execute(statement)\n    67\t    ensure_writable_columns(conn)\n    68\t    conn.execute(\"create virtual table if not exists views_fts using fts5(view_id unindexed, text, tokenize='trigram')\")\n    69\t    conn.execute(\"create virtual table if not exists groups_fts using fts5(group_id unindexed, text, tokenize='trigram')\")\n    70\t    conn.execute('create index if not exists members_view on thesis_group_members(view_id)')\n    71\t    conn.commit()\n    72\t    return conn\n    73\t\n    74\t\n    75\tdef insert(conn, table, **fields):\n    76\t    columns = list(fields)\n    77\t    cursor = conn.execute(f'insert into {table} ({\",\".join(columns)}) values ({\",\".join(\"?\" * len(columns))})', [fields[c] for c in columns])\n    78\t    return cursor.lastrowid\n    79\t\n    80\t\n    81\t# ---------- views ----------\n    82\t\n    83\tdef create_view(conn, *, view_id, object_id, object_kind, kind, looks_at, question, due_day, year, rungs, seq, input_id, created_at):\n    84\t    insert(conn, 'views', view_id=view_id, object_id=object_id, object_kind=object_kind, kind=kind, looks_at=looks_at,\n    85\t           question=question, due_day=due_day, year=year, created_seq=seq, created_from_input=input_id, created_at=created_at)\n    86\t    for position, rung in enumerate(rungs, start=1):\n    87\t        insert(conn, 'rungs', view_id=view_id, position=position, label=rung['label'], condition=rung['condition'], lo=rung.get('lo'), hi=rung.get('hi'))\n    88\t    insert(conn, 'view_switches', view_id=view_id, open=1, reason='created', by_whom='matching', after_seq=seq)\n    89\t    conn.execute('insert into views_fts (view_id, text) values (?, ?)', (view_id, f'{object_id} {looks_at} {question}'))\n    90\t\n    91\t\n    92\tdef view(conn, view_id):\n    93\t    row = conn.execute('select * from views where view_id=?', (view_id,)).fetchone()\n    94\t    return dict(row) if row else None\n    95\t\n    96\t\n    97\tdef rungs_of(conn, view_id):\n    98\t    \"\"\"The rungs with their bounds when the ledger has them (keyed views); a ledger written before keys has no lo/hi columns.\"\"\"\n    99\t    rows = [dict(r) for r in conn.execute('select * from rungs where view_id=? order by position', (view_id,))]\n   100\t    has_bounds = any(r.get('lo') is not None or r.get('hi') is not None for r in rows) or view_key(conn, view_id) is not None\n   101\t    return [dict(position=r['position'], label=r['label'], condition=r['condition'],\n   102\t                 **({'lo': r.get('lo'), 'hi': r.get('hi')} if has_bounds else {})) for r in rows]\n   103\t\n   104\t\n   105\tdef add_key(conn, view_id, key, seq):\n   106\t    \"\"\"The view's key (keyed-views-plan.md 2.1), written once with the view.\"\"\"\n   158\t\n   159\tdef view_key(conn, view_id):\n   160\t    if not conn.execute('pragma table_info(view_keys)').fetchone():\n   161\t        return None\n   162\t    row = conn.execute('select * from view_keys where view_id=?', (view_id,)).fetchone()\n   163\t    if not row:\n   164\t        return None\n   165\t    key = dict(row)\n   166\t    if not key.get('scope_source'):\n   167\t        key['scope_source'] = 'none' if not key['scope'] else 'model'\n   168\t    return key\n   169\t\n   170\t\n   171\tdef open_views_with_key(conn, object_id, measure, scope_key, period_start, period_end, basis='n/a', unit='n/a', event_type=None):\n   172\t    \"\"\"Open views of the object with the same measure, scope and unit whose period overlaps: the ones a candidate must\n   223\tdef open_read_only(path):\n   224\t    \"\"\"The views database for a reader (the agent layer, reports): no schema creation, no writes. Opened by its own path: a symlink\n   225\t    resolved, a store with another hard link refused (`live_lock.LockRefused`; live-service/OPERATING-CONTRACT.md, row 7), since\n   226\t    SQLite finds a WAL store's side files by the opened path.\"\"\"\n   227\t    from hivemind import live_lock\n   228\t    real, _ = live_lock.own_path(path)\n   229\t    conn = sqlite3.connect(f'file:{real}?mode=ro', uri=True, timeout=READ_BUSY_TIMEOUT_SECONDS)\n   230\t    conn.row_factory = sqlite3.Row\n   231\t    return conn\n   232\t\n   233\t\n   234\tdef current_state(conn, view_id):\n   235\t    \"\"\"The latest judgement: rung, reasons, changed, seq and day, and its reference and implied outcome (D260) where the ledger has them.\"\"\"\n   236\t    columns = {r[1] for r in conn.execute('pragma table_info(judgements)')}\n   237\t    stance = ''.join(f', {field}' for field in ('reference', 'implied_outcome') if field in columns)\n   238\t    row = conn.execute(f'select judgement_id, rung, reasons, changed, seq, publication_day{stance} from judgements where view_id=? order by judgement_id desc limit 1', (view_id,)).fetchone()\n   239\t    return dict(row) if row else None\n   240\t\n   241\t\n   242\tdef dependencies_of(conn, view_id):\n   348\t    except sqlite3.OperationalError:\n   349\t        return []\n   350\t    return [r['view_id'] for r in rows]\n   351\t\n   352\t\n   353\t# ---------- evidence ----------\n   354\t\n   355\tdef add_evidence(conn, *, evidence_id, quote, one_line, speaker, original_who, original_day, tier, event_time, seq, input_id):\n   356\t    insert(conn, 'evidence', evidence_id=evidence_id, quote=quote, one_line=one_line, speaker=speaker, original_who=original_who,\n   357\t           original_day=original_day, tier=tier, event_time=event_time, created_seq=seq, created_from_input=input_id)\n   358\t\n   359\t\n   360\tdef add_source(conn, evidence_id, input_id, category, publication_day, location, seq):\n   361\t    insert(conn, 'evidence_sources', evidence_id=evidence_id, input_id=input_id, category=category, publication_day=publication_day, location=location, seq=seq)\n   362\t\n   363\t\n   364\tdef link(conn, evidence_id, view_id, seq):\n   365\t    exists = conn.execute('select 1 from evidence_links where evidence_id=? and view_id=?', (evidence_id, view_id)).fetchone()\n   366\t    if not exists:\n   367\t        insert(conn, 'evidence_links', evidence_id=evidence_id, view_id=view_id, seq=seq)\n   368\t        return True\n   369\t    return False\n   370\t\n   371\t\n   372\tdef replace(conn, old_id, new_id, said_day, seq):\n   373\t    \"\"\"Retires old_id (history before D202; kept for the readers and tests of stored ledgers, no longer called by the writer).\"\"\"\n   374\t    insert(conn, 'replacements', old_evidence_id=old_id, new_evidence_id=new_id, said_day=said_day, seq=seq)\n   375\t\n   376\t\n   377\tdef revise(conn, old_id, new_id, said_day, seq):\n   378\t    \"\"\"D202: new_id is the matcher's later version of old_id; both stay in force, the judge sees the path.\"\"\"\n   379\t    insert(conn, 'revisions', old_evidence_id=old_id, new_evidence_id=new_id, said_day=said_day, seq=seq)\n     1\t\"\"\"The canonical English values of every closed field the pipeline reads (D163, docs/research/2026-10-25-english/plan.md,\n     2\t\"Canonical vocabulary\"), and the exact legacy-to-canonical conversion of the values the Chinese prompt versions wrote.\n     3\t\n     4\tA value is converted only where an answer or a stored record is read for comparison; prose is never touched, rows are\n     5\tnever rewritten, and an unknown value passes through unchanged so that the schema or the code check that owns the\n     6\tfield refuses it as before.\"\"\"\n     7\t\n     8\tKINDS = ['asset', 'theme']\n     9\tTIERS = ['fact', 'party_statement', 'third_party_view', 'rumour']\n    10\tCANDIDATE_OUTCOMES = ['merge', 'succession', 'new', 'skip']\n    11\tEVIDENCE_OUTCOMES = ['repeat', 'replace', 'new']\n    12\tPUSHES = ['toward_first', 'toward_last', 'none']\n    13\tDIRECTIONS = ['first_is_bullish', 'last_is_bullish', 'same', 'opposite']\n    14\tASSET_LABELS = ['Strongly bullish', 'Bullish', 'Neutral', 'Bearish', 'Strongly bearish']\n    15\tYES_NO = ['Yes', 'No']\n    16\t\n    17\tLEGACY = {\n    18\t    'kind': {'对象观点': 'asset', '主题观点': 'theme'},\n    19\t    'tier': {'发生的事': 'fact', '当事人说的': 'party_statement', '第三方看法': 'third_party_view', '传闻': 'rumour'},\n    20\t    'candidate_outcome': {'归入已有的': 'merge', '接续': 'succession', '新观点': 'new', '不开': 'skip'},\n    21\t    'evidence_outcome': {'重复': 'repeat', '替代': 'replace', '新证据': 'new'},\n    22\t    'push': {'推向第一格': 'toward_first', '推向最后一格': 'toward_last', '不推': 'none'},\n    23\t    'direction': {'对方第一格是看多': 'first_is_bullish', '对方最后一格是看多': 'last_is_bullish', '同向': 'same', '反向': 'opposite'},\n    24\t    'label': {'强烈看多': 'Strongly bullish', '看多': 'Bullish', '中性': 'Neutral', '看空': 'Bearish', '强烈看空': 'Strongly bearish', '是': 'Yes', '否': 'No'},\n    25\t}\n    26\t\n    27\t\n    28\tdef canonical(field, value):\n    29\t    \"\"\"The canonical value of a closed field: a legacy value converted, a canonical one kept, anything else unchanged.\"\"\"\n    30\t    if not isinstance(value, str):\n    31\t        return value\n    32\t    return LEGACY[field].get(value.strip(), value)\n    33\t\n    34\t\n    35\tdef legacy(field, value):\n    36\t    \"\"\"The Chinese spelling of a canonical value, for a request built for a Chinese prompt version.\"\"\"\n    37\t    for old, new in LEGACY[field].items():\n    38\t        if new == value:\n    39\t            return old\n    40\t    return value\n    41\t\n    42\t\n    43\tdef extraction_answer(data):\n    44\t    \"\"\"An extraction answer with canonical kind, tier and standard rung labels; other fields untouched.\"\"\"\n    45\t    out = dict(data)\n    46\t    out['candidates'] = [dict(c, kind=canonical('kind', c.get('kind')),\n    47\t                              rungs=[dict(r, label=canonical('label', r.get('label'))) for r in c.get('rungs', [])]) for c in data.get('candidates', [])]\n    48\t    out['evidence'] = [dict(e, tier=canonical('tier', e.get('tier'))) for e in data.get('evidence', [])]\n    49\t    return out\n    50\t\n    51\t\n    52\tdef candidate(c):\n    53\t    \"\"\"A handover candidate (fresh or saved) with canonical kind and labels.\"\"\"\n    54\t    return dict(c, kind=canonical('kind', c.get('kind')), rungs=[dict(r, label=canonical('label', r.get('label'))) for r in c.get('rungs', [])])\n    55\t\n","exit_code":0,"status":"completed"}}
