{"type":"item.completed","item":{"id":"item_24","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba docs/research/2026-11-22-number-answers/small_cases.py | sed -n '66,163p;320,435p'\"","aggregated_output":"    66\t\n    67\t\n    68\tdef F(id, what, kind, basis, unit, **kw):\n    69\t    f = {k: None for k in FIELDS}\n    70\t    f.update(id=id, what=what, kind=kind, basis=basis, unit=unit, outcome_for=[], reference_for=[])\n    71\t    f.update(kw)\n    72\t    return f\n    73\t\n    74\t\n    75\tdef A(view, shape='forecast', rung=None, reference_unavailable=None, why=None):\n    76\t    return {'view_id': view, 'shape': shape, 'rung': rung, 'reference_unavailable': reference_unavailable, 'reasons': 'case',\n    77\t            'why': why, 'cites': [], 'pushes': [], 'theme_pushes': []}\n    78\t\n    79\t\n    80\tdef base_pair():\n    81\t    \"\"\"A correct joint answer: company quarters, one shared Q3/Q4 forecast, Data Center quarters through share, a consensus reference.\"\"\"\n    82\t    figs = [\n    83\t        F('F1', W('company', 'FY2027 Q1'), 'source', 'reported', 'USD bn', value=81.6, evidence_id='e1', quote_number='$81.6 billion', qualifier='none'),\n    84\t        F('F2', W('company', 'FY2027 Q2'), 'source', 'reported', 'USD bn', value=96.2, evidence_id='e2', quote_number='$96.2 billion', qualifier='none'),\n    85\t        F('F3', W('company', 'FY2027 Q3'), 'source', 'guidance', 'USD bn', value=108.0, evidence_id='e3',\n    86\t          quote_number='$108.0 billion, plus or minus 2%', qualifier='none'),\n    87\t        F('F4', W('company', 'FY2027 Q3'), 'estimate', 'forecast', 'USD bn', value=110.0, basis_text='a small beat on guidance', rests_on=['F3']),\n    88\t        F('F5', W('company', 'FY2027 Q4'), 'estimate', 'forecast', 'USD bn', value=115.0, basis_text='growth continues', rests_on=['F4']),\n    89\t        F('F6', W('company', 'FY2027'), 'computed', 'forecast', 'USD bn', value=402.8, inputs=['F1', 'F2', 'F4', 'F5'], operation='sum',\n    90\t          outcome_for=['v4']),\n    91\t        F('F7', W('Data Center', 'FY2027 Q1'), 'source', 'reported', 'USD bn', value=75.3, evidence_id='e4', quote_number='$75.3 billion', qualifier='none'),\n    92\t        F('F8', W('Data Center', 'FY2027 Q2'), 'source', 'reported', 'USD bn', value=89.0, evidence_id='e5', quote_number='$89.0 billion', qualifier='none'),\n    93\t        F('F9', W('Data Center', 'FY2027 Q2', measure='share of revenue'), 'source', 'reported', '%', value=92.5, evidence_id='e5',\n    94\t          quote_number='92.5%', qualifier='none'),\n    95\t        F('F10', W('Data Center', 'FY2027 Q3'), 'computed', 'forecast', 'USD bn', value=101.75, inputs=['F4', 'F9'], operation='share'),\n    96\t        F('F11', W('Data Center', 'FY2027 Q4'), 'computed', 'forecast', 'USD bn', value=106.375, inputs=['F5', 'F9'], operation='share'),\n    97\t        F('F12', W('Data Center', 'FY2027'), 'computed', 'forecast', 'USD bn', value=372.425, inputs=['F7', 'F8', 'F10', 'F11'], operation='sum',\n    98\t          outcome_for=['v8']),\n    99\t        F('F13', W('company', 'FY2027'), 'source', 'consensus', 'USD bn', value=411.0, evidence_id='e6', quote_number='$411 billion',\n   100\t          qualifier='none', reference_for=['v4']),\n   101\t    ]\n   102\t    return {'figures': figs, 'answers': [A('v4', rung=2), A('v8', rung=2, reference_unavailable='no market figure for this segment')]}\n   103\t\n   104\t\n   105\tdef single(what, bands=((None, None),)):\n   106\t    return {'members': {'s': {'what': what, 'unit': 'USD bn', 'bands': [list(b) for b in bands]}}, 'relations': [], 'shared': [],\n   107\t            'compare_periods': [], 'part_scopes': []}\n   108\t\n   109\t\n   110\tdef one(figs, rung=1, family=None, reference_unavailable='none shown'):\n   111\t    fam = family or single(figs[-1]['what'], ((None, None),))\n   112\t    return {'figures': figs, 'answers': [A('s', rung=rung, reference_unavailable=reference_unavailable)]}, fam\n   113\t\n   114\t\n   115\tdef run(answer, family, passages=PASSAGES):\n   116\t    members = sorted(family['members'])\n   117\t    schema = rv.v13s_schema(members, EVIDENCE, [])\n   118\t    schema_errors = model.check_schema(answer, schema)\n   119\t    if schema_errors:\n   120\t        return {'schema': schema_errors}\n   121\t    calc = cs.from_answer(answer, family)\n   122\t    return cs.check(family, passages, calc)\n   123\t\n   124\t\n   125\tdef fig(answer, fid):\n   126\t    return next(f for f in answer['figures'] if f['id'] == fid)\n   127\t\n   128\t\n   129\tCASES = []\n   130\t\n   131\t\n   132\tMESSAGES = {}\n   133\t\n   134\t\n   135\tdef case(group, name, expect, recorded=None, message=None):\n   136\t    def wrap(build):\n   137\t        CASES.append((group, name, expect, recorded, build))\n   138\t        if message:\n   139\t            MESSAGES[name] = message                     # the intended refusal's own words, where another rule could also refuse\n   140\t        return build\n   141\t    return wrap\n   142\t\n   143\t\n   144\t# ---------- A1: correct forms pass ----------\n   145\t@case('A1', 'the base joint answer', 'pass')\n   146\tdef _():\n   147\t    return base_pair(), PAIR\n   148\t\n   149\t\n   150\t@case('A1', '$108.0B ± 2% as a range (low and high)', 'pass')\n   151\tdef _():\n   152\t    a = base_pair()\n   153\t    fig(a, 'F3').update(value=None, low=105.84, high=110.16)\n   154\t    return a, PAIR\n   155\t\n   156\t\n   157\t@case('A1', 'Q1 + Q2 = H1, then H1 + Q3 + Q4 = FY', 'pass')\n   158\tdef _():\n   159\t    a = base_pair()\n   160\t    a['figures'].append(F('H1', W('company', 'FY2027 H1'), 'computed', 'reported', 'USD bn', value=177.8, inputs=['F1', 'F2'], operation='sum'))\n   161\t    fig(a, 'F6').update(inputs=['H1', 'F4', 'F5'])\n   162\t    return a, PAIR\n   163\t\n   320\t    figs[-1].update(kind='estimate', inputs=None, operation=None, basis_text='the midpoint', rests_on=['A3'], outcome_for=['s'])\n   321\t    return one(figs)\n   322\t\n   323\t\n   324\t@case('A1', 'a point Data Center forecast beside a company range (lowest against highest)', 'pass')\n   325\tdef _():\n   326\t    a = base_pair()\n   327\t    fig(a, 'F4').update(value=None, low=105.84, high=110.16)\n   328\t    fig(a, 'F10').update(kind='estimate', basis_text='segment stays near its mix', inputs=None, operation=None, value=100.0, rests_on=['F4'])\n   329\t    fig(a, 'F6').update(value=None, low=398.64, high=402.96)\n   330\t    fig(a, 'F12').update(value=370.675)\n   331\t    return a, PAIR\n   332\t\n   333\t\n   334\t@case('A1', 'a final range estimate resting on a computed point of the same quantity', 'pass', recorded='one quantity, several figures')\n   335\tdef _():\n   336\t    a = base_pair()\n   337\t    fig(a, 'F12').update(outcome_for=[])                 # the computed point keeps basis forecast: the final range is the value adopted\n   338\t    a['figures'].append(F('R', W('Data Center', 'FY2027'), 'estimate', 'forecast', 'USD bn', low=360.0, high=385.0, basis_text='a range around it',\n   339\t                          rests_on=['F12'], outcome_for=['v8']))\n   340\t    return a, PAIR\n   341\t\n   342\t\n   343\t@case('A1', 'two outside estimates averaged into one starting point', 'pass')\n   344\tdef _():\n   345\t    figs = [F('S1', W('four companies', 'CY2026', measure='capex'), 'source', 'third_party', 'USD bn', value=745.0, evidence_id='e18', quote_number='$745 billion', qualifier='none'),\n   346\t            F('S2', W('four companies', 'CY2026', measure='capex'), 'source', 'third_party', 'USD bn', value=760.0, evidence_id='e19', quote_number='$760 billion', qualifier='none'),\n   347\t            F('T', W('four companies', 'CY2026', measure='capex, two sources'), 'computed', 'third_party', 'USD bn', value=1505.0, inputs=['S1', 'S2'], operation='sum'),\n   348\t            F('H', W('four companies', 'CY2026', measure='capex'), 'computed', 'forecast', 'USD bn', value=752.5, inputs=['T', 'D'], operation='ratio'),\n   349\t            F('D', W('four companies', 'CY2026', measure='divisor'), 'estimate', 'forecast', 'x', value=2.0, basis_text='two sources'),\n   350\t            F('O', W('four companies', 'CY2026', measure='capex'), 'estimate', 'forecast', 'USD bn', value=752.5, basis_text='the average', rests_on=['H'], outcome_for=['s'])]\n   351\t    figs[3]['basis'] = 'third_party'\n   352\t    return one(figs)\n   353\t\n   354\t\n   355\t@case('A1', 'the remainder: company − Data Center = the rest', 'pass')\n   356\tdef _():\n   357\t    a = base_pair()\n   358\t    a['figures'].append(F('REST', W('other', 'FY2027'), 'computed', 'forecast', 'USD bn', value=30.375, inputs=['F6', 'F12'], operation='difference'))\n   359\t    return a, PAIR\n   360\t\n   361\t\n   362\t# ---------- A2: defects are refused by their named rule ----------\n   363\tdef defect(name, rule, mutate, family=PAIR, base=base_pair, recorded=None):\n   364\t    @case('A2', name, rule, recorded)\n   365\t    def _():\n   366\t        a = base()\n   367\t        mutate(a)\n   368\t        return a, family\n   369\t\n   370\t\n   371\tdefect('108.5 for \"$108.0 billion\" (S1)', 'S1', lambda a: fig(a, 'F3').update(value=108.5))\n   372\tdefect('a qualifier the quote does not write (S1)', 'S1', lambda a: fig(a, 'F1').update(qualifier='about'))\n   373\tdefect('a number not written in the quote (S1)', 'S1', lambda a: fig(a, 'F1').update(quote_number='$81.62 billion', value=81.62))\n   374\tdefect('\"± 2%\" read as a positive point 110.16 (S1)', 'S1', lambda a: fig(a, 'F3').update(value=110.16))\n   375\tdefect('a plain wrong sum (S2)', 'S2', lambda a: fig(a, 'F6').update(value=410.0))\n   376\tdefect('money × % through product (S2)', 'S2', lambda a: fig(a, 'F10').update(operation='product'))\n   377\tdefect('a three-input difference (S7)', 'S7', lambda a: fig(a, 'F6').update(operation='difference'))\n   378\tdefect('a part forecast above the whole for Q3 (S3)', 'S3', lambda a: (fig(a, 'F9').update(value=92.5), fig(a, 'F10').update(\n   379\t    kind='estimate', basis_text='segment', inputs=None, operation=None, value=112.0, rests_on=['F4']), fig(a, 'F12').update(value=382.675)))\n   380\tdefect('a part outcome above the whole outcome (S3)', 'S3', lambda a: (fig(a, 'F12').update(\n   381\t    kind='estimate', basis_text='segment', inputs=None, operation=None, value=405.0, rests_on=['F10']), a['answers'][1].update(rung=1)))\n   382\tdefect('Data Center added into company in one sum (S8)', 'S8', lambda a: a['figures'].append(F(\n   383\t    'BAD', W('company', 'FY2027'), 'computed', 'forecast', 'USD bn', value=775.225, inputs=['F6', 'F12'], operation='sum')))\n   384\tdefect('Q2 + Q3 labelled H1 (S8)', 'S8', lambda a: a['figures'].append(F(\n   385\t    'BAD', W('company', 'FY2027 H1'), 'computed', 'forecast', 'USD bn', value=206.2, inputs=['F2', 'F4'], operation='sum')))\n   386\tdefect('FY − Q1 labelled Q4 (S8)', 'S8', lambda a: a['figures'].append(F(\n   387\t    'BAD', W('company', 'FY2027 Q4'), 'computed', 'consensus', 'USD bn', value=329.4, inputs=['F13', 'F1'], operation='difference')))\n   388\tdefect('two forecasts of one shared quarter, both used (S4)', 'S4', lambda a: (a['figures'].append(F(\n   389\t    'BAD', W('company', 'FY2027 Q3'), 'estimate', 'forecast', 'USD bn', value=112.0, basis_text='another view')),\n   390\t    fig(a, 'F10').update(inputs=['BAD', 'F9'], value=103.6), fig(a, 'F12').update(value=374.275)))\n   391\tdefect('an unused second forecast of a quarter is not counted (passes)', 'pass', lambda a: a['figures'].append(F(\n   392\t    'ALT', W('company', 'FY2027 Q3'), 'estimate', 'forecast', 'USD bn', value=112.0, basis_text='an alternative not used')))\n   393\tdefect('Q3 guidance used directly beside the Q3 forecast (S4)', 'S4', lambda a: fig(a, 'F10').update(inputs=['F3', 'F9'], value=99.9))\n   394\tdefect('two Data Center Q4 forecasts, both used (S4)', 'S4', lambda a: (a['figures'].append(F(\n   395\t    'BAD', W('Data Center', 'FY2027 Q4'), 'estimate', 'forecast', 'USD bn', value=104.0, basis_text='another view')),\n   396\t    fig(a, 'F12').update(outcome_for=[]), a['figures'].append(F('X', W('Data Center', 'FY2027'), 'estimate', 'forecast', 'USD bn', value=372.0,\n   397\t                                                                basis_text='near the sum', rests_on=['F12', 'BAD'], outcome_for=['v8']))))\n   398\tdefect('an estimate marked as the reference (S5)', 'S5', lambda a: (a['figures'].append(F(\n   399\t    'R8', W('Data Center', 'FY2027'), 'estimate', 'reported', 'USD bn', value=380.0, basis_text='looks like consensus', rests_on=['F13'],\n   400\t    reference_for=['v8'])), a['answers'][1].update(reference_unavailable=None)))\n   401\tdefect('a computed reference with basis forecast (S5)', 'S5', lambda a: (a['figures'].append(F(\n   402\t    'SH', W('Data Center', 'FY2027', measure='share of revenue'), 'source', 'consensus', '%', value=92.0, evidence_id='e25', quote_number='92%',\n   403\t    qualifier='none')), a['figures'].append(F(\n   404\t    'R8', W('Data Center', 'FY2027 consensus view'), 'computed', 'forecast', 'USD bn', value=378.12, inputs=['F13', 'SH'], operation='share',\n   405\t    reference_for=['v8'])), a['answers'][1].update(reference_unavailable=None)))      # an outside full-year share: only the forecast basis refuses it\n   406\tdefect('a reference resting on an estimate (S5)', 'S5', lambda a: (a['figures'].append(F(\n   407\t    'R8', W('Data Center', 'FY2027'), 'computed', 'consensus', 'USD bn', value=373.45, inputs=['F13', 'M'], operation='share',\n   408\t    reference_for=['v8'])), a['figures'].append(F('M', W('Data Center', 'FY2027', measure='mix'), 'estimate', 'forecast', '%', value=90.86,\n   409\t                                                    basis_text='mix')), a['answers'][1].update(reference_unavailable=None)))\n   410\tdefect('a reported-only reference (S5)', 'S5', lambda a: (fig(a, 'F1').update(reference_for=['v8']), a['answers'][1].update(reference_unavailable=None)))\n   411\tdefect('both a reference figure and a reason (S5)', 'S5', lambda a: a['answers'][0].update(reference_unavailable='also none'))\n   412\tdefect('neither a reference figure nor a reason (S5)', 'S5', lambda a: a['answers'][1].update(reference_unavailable=None))\n   413\tdefect('no outcome marker (S6)', 'S6', lambda a: fig(a, 'F12').update(outcome_for=[]))\n   414\tdefect('two outcome markers (S6)', 'S6', lambda a: fig(a, 'F11').update(outcome_for=['v8']))\n   415\tdefect('a marker on an unresolved member (S7)', 'S7', lambda a: a['answers'][1].update(shape='unresolved', why='none', rung=None,\n   416\t                                                                                     reference_unavailable=None))\n   417\tdefect('an outcome key mismatch (S6)', 'S6', lambda a: fig(a, 'F12').update(what=W('Data Center', 'FY2027', population='NVIDIA Corp')))\n   418\tdefect('a source as the outcome (S6)', 'S6', lambda a: (fig(a, 'F12').update(outcome_for=[]), a['figures'].append(F(\n   419\t    'SRC', W('Data Center', 'FY2027'), 'source', 'third_party', 'USD bn', value=300.0, evidence_id='e7', quote_number='$300 billion',\n   420\t    qualifier='over', outcome_for=['v8'])), a['answers'][1].update(rung=3)))\n   421\tdefect('a share above 100% (S2)', 'S2', lambda a: (fig(a, 'F9').update(kind='estimate', basis='forecast', evidence_id=None, quote_number=None,\n   422\t    qualifier=None, value=110.0, basis_text='mix'), fig(a, 'F10').update(value=121.0), fig(a, 'F11').update(value=126.5),\n   423\t    fig(a, 'F12').update(value=411.8)))\n   424\tdefect('a rung outside the ladder (S6)', 'S6', lambda a: a['answers'][0].update(rung=9))\n   425\tdefect('a rung whose band misses the outcome (S6)', 'S6', lambda a: a['answers'][0].update(rung=1))\n   426\tdefect('a declared value within tolerance whose recomputed value crosses the edge (S6)', 'S6', lambda a: (\n   427\t    fig(a, 'F5').update(value=104.3), fig(a, 'F6').update(value=391.9), a['answers'][0].update(rung=3),\n   428\t    fig(a, 'F11').update(value=96.4775), fig(a, 'F12').update(value=362.5275)))\n   429\tdefect('value with low (S7)', 'S7', lambda a: fig(a, 'F1').update(low=80.0))\n   430\tdefect('a cycle through rests_on (S7)', 'S7', lambda a: fig(a, 'F4').update(rests_on=['F5']))\n   431\tdefect('a passage id in inputs (S7)', 'S7', lambda a: fig(a, 'F6').update(inputs=['F1', 'e2', 'F4', 'F5']))\n   432\tdefect('a source with basis forecast (S7)', 'S7', lambda a: fig(a, 'F3').update(basis='forecast'))\n   433\tdefect('duplicate member answers (S7)', 'S7', lambda a: a['answers'].append(A('v4', rung=2)))\n   434\tdefect('a figure id equal to a passage id (S7)', 'S7', lambda a: a['figures'].append(F(\n   435\t    'e1', W('company', 'FY2027 Q1'), 'estimate', 'reported', 'USD bn', value=81.6, basis_text='copy')))\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_25","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba docs/research/2026-11-22-number-answers/SMALL-DESIGN.md | sed -n '1,57p;173,241p'\"","aggregated_output":"     1\t# judging-v13 small format (v13s): code refuses only the five defects and broken structure (D737)\n     2\t\n     3\tAlex (D737) chose to shrink the format. Code refuses an answer only for these five defects:\n     4\t- a number misread;\n     5\t- wrong arithmetic;\n     6\t- a part above its whole, or added into it;\n     7\t- two forecasts of one quarter;\n     8\t- an own estimate passed off as the market's.\n     9\t\n    10\tIt also refuses broken structure. Each rule is written in one or two sentences beside its field. Every other rule of `DESIGN.md`'s\n    11\tchecks becomes something the readers see, not a refusal.\n    12\t\n    13\t**Review scope (D737):** a counterexample that lets none of the five defects through, and breaks no structure, is a reader's matter,\n    14\tnot a finding. **Out of scope:**\n    15\t- the frozen ruler and `poc-v118`;\n    16\t- D725's pass lines and D731's harness rules;\n    17\t- the old run and its checker `calc_check.py`, which stay as they are, so the old run stays reproducible.\n    18\t\n    19\t## 1. What is dropped, and where it goes\n    20\t\n    21\t| Today's rule (DESIGN.md) | v13s |\n    22\t|---|---|\n    23\t| bounds and their propagation (C2 bound direction, C3/C6 open ends) | a source's qualifier is checked against the quote and shown to readers; computed figures are points or ranges |\n    24\t| scenarios, scenario membership, `range` summaries (C4) | one forecast per shared quantity; an outcome may be a range |\n    25\t| relations `time_aggregation` / `accounting_parts` / `stated_in_addition` / `overlap_unknown`, and `disputed` | periods of one quantity must make up the output's period (S8); an uncertain overlap is written as an estimate with its assumption |\n    26\t| bridges and `converts` (C8) | a conversion between quantities is computed or estimated as the analyst chooses; code records each computed figure whose inputs measure another quantity, and readers judge it |\n    27\t| `roll_forward`, the per-unit identity, `range_from_relative`, `signs` | `sum`, `difference`, `product`, `ratio`, `share`, `growth`, `apply_growth` |\n    28\t| `adjusts` | an estimate rests on the figure it changes |\n    29\t| C9 (same base), C10 (earlier forecasts) | none of the gate's families declares a same base; the request shows no earlier forecast (D728) |\n    30\t| the exact-expression grammar (C1) | the number as written (`quote_number`) plus a qualifier from a closed list |\n    31\t\n    32\t## 2. The rules code enforces (revised after round 52, `codex-r52.md`; the revision is marked [52])\n    33\t\n    34\t**[52] Shared definitions.**\n    35\t- **Uses.** A figure *uses* another when the other is among its `inputs`, at any depth. An estimate's `rests_on` is a judgement, not\n    36\t  a use. Code records it for readers, and an estimate is the value the figures above it use.\n    37\t- **Recomputed values.** The published value of a computed figure is the recomputed one, a point or a range. S3, S4 and S6 compare\n    38\t  recomputed values. S2's tolerance applies only between a declared value and its recomputed value.\n    39\t\n    40\t| # | Defect | Rule [52] (as the request states it) | Where stated |\n    41\t|---|---|---|---|\n    42\t| S1 | a number misread | A source figure names its passage (`evidence_id`) and copies the number exactly as the quote writes it (`quote_number`). The number is in US dollars ($, US$) with its scale (trillion, billion, bn, million), or is a percentage, or is one of the words double, triple or twice. The value equals it, with money in billions. A minus written before it makes the value negative. A qualifier written just before it (or \"or more\" / \"or less\" just after) goes in `qualifier`. A written range (\"$3–4 billion\", \"between $3 billion and $4 billion\") gives low and high. \"$4.5 billion, plus or minus 3%\" is copied whole, and gives its range as low and high or its midpoint as value. Money in another currency cannot be a source. | `kind`, `evidence_id`, `quote_number`, `qualifier`, `unit` |\n    43\t| S2 | wrong arithmetic | A computed figure equals its operation's result within 0.5% (at least 0.1, or 0.05 for %). Units are those `operation` states for each operation; a sum or difference adds one unit. A range input gives a range: both extremes are computed first, and a midpoint may be declared as value. Division by a range that contains zero is refused. | `operation` |\n    44\t| S3 | a part above its whole | For each period the Relations line lists, and for the outcomes, the part's lowest recomputed value used for that period may not exceed the whole's highest. | the family header |\n    45\t| S8 | a part added into its whole; periods misadded | A sum never adds a figure that uses (or is) the part's quantity to one that uses (or is) the whole's: the whole already includes the part. A difference may subtract the part from the whole only to give the rest, another scope. When a sum's or difference's inputs are periods of one quantity, each period is written FY2027, FY2027 Q3, FY2027 H1, FY2027 Q1-Q3 (or CY likewise), and together they make up the output's period exactly (Q1 + Q2 = H1; FY − Q1-Q3 = Q4). An estimate that rests on both the part and the whole is recorded for readers. | `operation`; `what.period`; the family header |\n    46\t| S4 | two forecasts of one quarter | Every number the outcomes use for one quantity and period is the same figure. Compute each quantity and period once, as a point or a range, and use that figure wherever it is needed. (Guidance or consensus beneath that figure is fine; a second figure of the same quantity and period reached on another path is not.) | the family header; `figures` |\n    47\t| S5 | an own estimate passed off as the market's | The figure marked in `reference_for` and every figure beneath it (inputs and rests_on) is a source, or computed with no basis forecast. None is an estimate. At least one is a quoted consensus, guidance or third_party figure, which may be the marked figure itself. A forecast member has exactly one marked reference figure or a `reference_unavailable` reason. | `reference_for`; `reference_unavailable` |\n    48\t| S6 | structure: the answer's number | A forecast member has exactly one figure marked in `outcome_for`. It is a computed or estimate figure with basis forecast (the analyst's own forecast, even when it agrees with consensus). Its `what` is the member's outcome key, its unit is USD bn, and its rung is 1 to the ladder's length. The rung's band (lower edge included, upper excluded) holds the recomputed outcome, or overlaps it for a range. | `outcome_for`; `rung` |\n    49\t| S7 | structure: the calculation | Ids are unique and never equal a passage id. `inputs` name figures; `rests_on` names figures or passages. No figure uses itself. A figure has value, or low and high (low ≤ high), never both. A source has `evidence_id` and `quote_number`; a computed figure has `inputs` and `operation`; an estimate has `basis_text`. Basis forecast is never on a source. There is one answer per member. An unresolved answer has `why`, rung null, `reference_unavailable` null and no marked figure. | the field descriptions |\n    50\t\n    51\t**[52] Operation units (stated in `operation`):**\n    52\t- sum and difference: one unit in, the same out.\n    53\t- product: USD bn × x → USD bn; x × x → x; % × x → %; never USD bn × %.\n    54\t- ratio: same unit → x; USD bn ÷ x → USD bn.\n    55\t- share(whole, percent): whole's unit.\n    56\t- growth(old, new): same unit → %.\n    57\t- apply_growth(base, rate %): base's unit.\n   173\t**Part A, code, $0.** Each case asserts its intended rule and message. The schema's validity is checked first, so a schema error\n   174\tcannot mask the rule under test.\n   175\t- **A1, correct forms.** Each passes:\n   176\t  - a $4.5 billion ± 3% guidance as two sources with apply_growth ends;\n   177\t  - Q1 + Q2 = H1;\n   178\t  - FY − Q1-Q3 = Q4;\n   179\t  - a year-over-year rate on last year's quarter (recorded);\n   180\t  - whole × mix through share;\n   181\t  - \"over $300 billion\" with qualifier over;\n   182\t  - \"-3%\";\n   183\t  - \"$300 million or more\" with qualifier \"or more\";\n   184\t  - $1.2 trillion as 1200 USD bn;\n   185\t  - a range outcome overlapping its rung;\n   186\t  - one figure marked for two members (its own family);\n   187\t  - a computed external reference;\n   188\t  - an unresolved member;\n   189\t  - a conversion between quantities (recorded);\n   190\t  - \"not only still expects $20 billion\" as a source;\n   191\t  - 12% × 2x = 24%.\n   192\t- **A2, defects.** Each is refused by its named rule:\n   193\t  - **S1:** 108.5 for \"$108.0 billion\"; a qualifier dropped; one invented; \"-3%\" as 3; a number not in the quote; a passage's\n   194\t    summary number; trillions as 1.2 USD bn.\n   195\t  - **S2:** a plain wrong result; a wrong end of a range; division by zero; money × %; a three-input difference.\n   196\t  - **S3:** a part forecast above the whole for a listed quarter; an outcome above the whole's.\n   197\t  - **S8:** company + Data Center in one sum; Q2 + Q3 labelled H1; FY − Q1 labelled Q4.\n   198\t  - **S4:** two forecasts of one shared quarter; an outcome reaching guidance for a shared quarter beside the forecast.\n   199\t  - **S5:** a forecast beneath a reference; an estimate beneath a reference; a reported-only reference; both a marked reference and\n   200\t    a reason; neither.\n   201\t  - **S6:** no outcome marker; two; a marker on an unresolved member; an outcome key mismatch; a rung outside the ladder; a rung\n   202\t    whose band misses the outcome; at the band's upper edge.\n   203\t  - **S7:** value with low; a cycle; a dangling input; a passage id in inputs; a source with basis forecast; duplicate answers.\n   204\t- **A3, Luna's observed mistakes** from both journals, each encoded in v13s. Each is impossible under the schema or refused with a\n   205\t  reason the request states (the sentence is quoted):\n   206\t  - prose outcome, reference and evidence;\n   207\t  - unit spellings;\n   208\t  - value with range;\n   209\t  - a four-input difference;\n   210\t  - money × % through product;\n   211\t  - \"first half\";\n   212\t  - a passage id in inputs;\n   213\t  - a trillion outcome.\n   214\t\n   215\t**[52] Additions to Part A.**\n   216\t- **A1 adds:**\n   217\t  - the remainder company − Data Center = the rest;\n   218\t  - \"US$10 billion\", \"$96.2bn\", \"roughly twice\", \"between $105.84 billion and $110.16 billion\";\n   219\t  - \"$108.0 billion, plus or minus 2%\" as a range and as a midpoint;\n   220\t  - a point Data Center forecast beside a company range (S3 holds);\n   221\t  - a final range estimate resting on a computed point of the same quantity (S4 holds).\n   222\t- **A2 adds:**\n   223\t  - Data Center × 1x added to company (S8);\n   224\t  - an estimate resting on both part and whole (recorded, not refused, and the record asserted);\n   225\t  - two Data Center Q4 figures on two paths (S4);\n   226\t  - Q3 guidance used directly beside a Q3 forecast (S4);\n   227\t  - an estimate itself marked as the reference (S5);\n   228\t  - a computed reference with basis forecast (S5);\n   229\t  - a declared value within tolerance whose recomputed value crosses the rung edge (S6 on the recomputed value);\n   230\t  - a part whose recomputed lowest value exceeds the whole's recomputed highest, while its declared value does not (S3);\n   231\t  - sum($108B, 2%) (S2 unit);\n   232\t  - division by [-1, 1] (S2);\n   233\t  - [-3, -2] × [2, 4] declared other than [-12, -4] (S2);\n   234\t  - a source as the outcome (S6);\n   235\t  - a figure id equal to a passage id (S7);\n   236\t  - \"plus or minus 2%\" copied as \"2%\" and used as +2% for the range (S1);\n   237\t  - a euro amount (S1).\n   238\t- **A3:** each mistake must be refused by the schema or **actually refused** by its stated rule (asserted). \"first half\" is refused by\n   239\t  S8 when summed. \"1.05 USD trillion\" fails the schema, and \"1050 USD bn\" passes.\n   240\t- **A4, the end to end rehearsal.** One v13s reply goes through the first attempt, the separate-arm reconciliation, the card render and\n   241\t  recovery. For each named defect, the defective answer fails its rule while its paired correct answer reaches the reader's card. The\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_26","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba docs/research/2026-11-22-number-answers/calc_small.py | sed -n '648,764p'\"","aggregated_output":"   648\t                continue\n   649\t            bypass = sorted(r for r in reached if r != node[0])      # the walk never descends below the forecast figure\n   650\t            if bypass:\n   651\t                errors.append(('S4', f'{v}: uses {\", \".join(bypass)} for {\" | \".join(key)} beside its forecast figure {node[0]}'))\n   652\t    return errors\n   653\t\n   654\t\n   655\tdef _part_whole(family, figs, calc, outcomes):\n   656\t    errors = []\n   657\t    members = family['members']\n   658\t    for rel in family.get('relations', []):\n   659\t        if rel.get('type') != 'part_of' or rel['part'] not in outcomes or rel['whole'] not in outcomes:\n   660\t            continue\n   661\t        p_what, w_what = members[rel['part']]['what'], members[rel['whole']]['what']\n   662\t        pairs = [(outcomes[rel['part']], outcomes[rel['whole']], 'outcome')]\n   663\t        for period in family.get('compare_periods', []):\n   664\t            if period == p_what['period']:\n   665\t                continue\n   666\t            p_key = (p_what['population'], p_what['measure'], p_what['scope'], period)\n   667\t            w_key = (w_what['population'], w_what['measure'], w_what['scope'], period)\n   668\t            for p in _tops(outcomes[rel['part']], p_key, figs):\n   669\t                for w in _tops(outcomes[rel['whole']], w_key, figs):\n   670\t                    pairs.append((p, w, period))\n   671\t        for part, whole, label in pairs:\n   672\t            pv, wv = calc.interval(part), calc.interval(whole)\n   673\t            if pv is None or wv is None:\n   674\t                continue\n   675\t            if not calc.fits(part, whole):\n   676\t                errors.append(('S3', f'{label}: the part {part} ({pv[0]:g}–{pv[1]:g}) exceeds the whole {whole} ({wv[0]:g}–{wv[1]:g})'))\n   677\t    return errors\n   678\t\n   679\t\n   680\tdef _sums(family, figs):\n   681\t    errors = []\n   682\t    scopes = family.get('part_scopes', [])\n   683\t    for f in figs.values():\n   684\t        if f['kind'] != 'computed' or f['operation'] not in ('sum', 'difference'):\n   685\t            continue\n   686\t        fid, ins = f['id'], [figs[i] for i in f['inputs']]\n   687\t        for ps in scopes:\n   688\t            same = [i for i in ins if (i['what']['population'], i['what']['measure']) == (ps['population'], ps['measure'])]\n   689\t            parts = [i for i in same if i['what']['scope'] == ps['part']]\n   690\t            wholes = [i for i in same if i['what']['scope'] == ps['whole']]\n   691\t            if not parts or not wholes:\n   692\t                continue\n   693\t            if f['operation'] == 'sum':\n   694\t                if any(_overlap(p['what']['period'], w['what']['period']) for p in parts for w in wholes):\n   695\t                    errors.append(('S8', f'{fid}: adds {ps[\"part\"]} into {ps[\"whole\"]} for the same period, which already includes it'))\n   696\t            elif not (ins[0]['what']['scope'] == ps['whole'] and ins[1]['what']['scope'] == ps['part']\n   697\t                      and ins[0]['what']['period'] == ins[1]['what']['period'] == f['what']['period']\n   698\t                      and f['what']['scope'] not in (ps['part'], ps['whole'])):\n   699\t                errors.append(('S8', f'{fid}: a difference may take {ps[\"part\"]} from {ps[\"whole\"]} of the same period only to give the rest'))\n   700\t        group = ins + [f]\n   701\t        if len({_quantity(g['what']) for g in group}) != 1:\n   702\t            continue\n   703\t        periods = [g['what']['period'] for g in group]\n   704\t        inputs_periods = periods[:-1]\n   705\t        if f['operation'] == 'sum' and len(set(inputs_periods)) < len(inputs_periods):\n   706\t            errors.append(('S8', f'{fid}: adds one quantity for the same period more than once ({\", \".join(inputs_periods)})'))\n   707\t            continue\n   708\t        if len(set(periods)) == 1:\n   709\t            continue\n   710\t        parsed = [_period(p) for p in periods]\n   711\t        if not any(parsed):\n   712\t            continue\n   713\t        if not all(parsed):\n   714\t            errors.append(('S8', f'{fid}: when periods of one quantity are added or subtracted, write each as FY2027, FY2027 Q3, FY2027 H1 or '\n   715\t                                 f'FY2027 Q1-Q3 (or CY likewise); got {\", \".join(periods)}'))\n   716\t            continue\n   717\t        years = {p[0] for p in parsed}\n   718\t        *parts_p, out = parsed\n   719\t        if len(years) != 1:\n   720\t            ok = False\n   721\t        elif f['operation'] == 'sum':\n   722\t            total = [q for p in parts_p for q in p[1]]\n   723\t            ok = len(total) == len(set(total)) and set(total) == out[1]\n   724\t        else:\n   725\t            ok = parts_p[1][1] <= parts_p[0][1] and parts_p[0][1] - parts_p[1][1] == out[1]\n   726\t        if not ok:\n   727\t            sign = ' + ' if f['operation'] == 'sum' else ' − '\n   728\t            errors.append(('S8', f'{fid}: {sign.join(periods[:-1])} does not make up {periods[-1]}'))\n   729\t    return errors\n   730\t\n   731\t\n   732\tdef _recorded(family, figs, outcomes):\n   733\t    recorded = []\n   734\t    scopes = family.get('part_scopes', [])\n   735\t    for f in figs.values():\n   736\t        fid = f['id']\n   737\t        if f['kind'] == 'estimate':\n   738\t            recorded.append({'type': 'estimate', 'figure': fid, 'assumption': f.get('basis_text')})\n   739\t            rested = {figs[r]['what']['scope'] for r in f.get('rests_on') or [] if r in figs}\n   740\t            if any({ps['part'], ps['whole']} <= rested for ps in scopes):\n   741\t                recorded.append({'type': 'part and whole in one estimate', 'figure': fid})\n   742\t        elif f['kind'] == 'computed':\n   743\t            money = [figs[i] for i in f['inputs'] if figs[i]['unit'] == 'USD bn']\n   744\t            if any(_quantity(i['what']) != _quantity(f['what']) for i in money) and f['operation'] != 'share':\n   745\t                recorded.append({'type': 'conversion between quantities', 'figure': fid})\n   746\t            if f['operation'] in ('apply_growth', 'product') and any(i['what']['period'] != f['what']['period'] for i in money):\n   747\t                recorded.append({'type': 'carried across periods', 'figure': fid})\n   748\t            if f['operation'] == 'sum' and any({ps['part'], ps['whole']} <= {i['what']['scope'] for i in money} for ps in scopes):\n   749\t                recorded.append({'type': 'part and whole added for different periods', 'figure': fid})\n   750\t        elif (f.get('qualifier') or 'none') != 'none':\n   751\t            recorded.append({'type': 'qualified source', 'figure': fid, 'qualifier': f['qualifier']})\n   752\t    used = set()\n   753\t    for out in outcomes.values():\n   754\t        used |= {out} | _beneath(out, figs)\n   755\t    by_key = {}\n   756\t    for fid in used:\n   757\t        by_key.setdefault(_key(figs[fid]['what']), []).append(fid)\n   758\t    for k, ids in sorted(by_key.items()):\n   759\t        if len(ids) > 1:\n   760\t            recorded.append({'type': 'one quantity, several figures', 'figure': sorted(ids)[0], 'figures': sorted(ids), 'what': list(k)})\n   761\t    return recorded\n   762\t\n   763\t\n   764\tdef check(family, passages, calc):\n","exit_code":0,"status":"completed"}}
