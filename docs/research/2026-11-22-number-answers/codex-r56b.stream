{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba docs/research/2026-11-22-number-answers/render_v13.py | sed -n '75,260p'\"","aggregated_output":"    75\t    return obj({'figures': {'type': 'array', 'items': figure}, 'answers': {'type': 'array', 'items': answer}})\n    76\t\n    77\t\n    78\tQUALIFIERS = list(calc_small.QUALIFIERS)                 # one owner: the checker's closed list\n    79\t\n    80\t\n    81\tdef v13s_schema(member_ids, evidence_ids, theme_ids):\n    82\t    \"\"\"The small format (SMALL-DESIGN.md §3 [52], D737, D738): each rule the checks enforce stated beside its field.\"\"\"\n    83\t    members = {'type': 'array', 'items': {'type': 'string', 'enum': member_ids}}\n    84\t    what = obj({'population': S,\n    85\t                'measure': {'type': 'string', 'description': 'The quantity, such as revenue or capital expenditure; never its basis.'},\n    86\t                'scope': S,\n    87\t                'period': {'type': 'string', 'description': 'For example FY2027, FY2027 Q3, FY2027 H1, FY2027 Q1-Q3, CY2026, end of FY2027.'}},\n    88\t               'What the number measures. Where the request lists keys (outcome keys, shared quantities), copy them exactly.')\n    89\t    figure = obj({\n    90\t        'id': {'type': 'string', 'description': 'Short and unique, such as F1; never a passage id.'},\n    91\t        'what': what,\n    92\t        'kind': {'type': 'string', 'enum': ['source', 'computed', 'estimate'], 'description': \"source: a number written in a shown passage's \"\n    93\t                 'quote; computed: one operation on other figures; estimate: your judgement, with its assumption in basis_text.'},\n    94\t        'basis': {'type': 'string', 'enum': ['reported', 'guidance', 'consensus', 'third_party', 'forecast'], 'description': \"reported: an \"\n    95\t                  \"actual; guidance: the company's outlook; consensus: analysts' average; third_party: one outside party; forecast: this \"\n    96\t                  \"family's own forecast, on a computed or estimate figure only.\"},\n    97\t        'value': nullable({'type': 'number', 'description': 'A point. Give value, or low and high, never both.'}),\n    98\t        'low': nullable({'type': 'number', 'description': 'A range, low at most high, with value null.'}),\n    99\t        'high': nullable({'type': 'number', 'description': 'A range, low at most high, with value null.'}),\n   100\t        'unit': {'type': 'string', 'enum': ['USD bn', '%', 'x'], 'description': 'USD bn: money in billions of US dollars ($1.2 trillion = '\n   101\t                 '1200; $500 million = 0.5). %: a percentage as its number (7.5% = 7.5). x: a multiple (double = 2).'},\n   102\t        'evidence_id': nullable({'type': 'string', 'enum': evidence_ids, 'description': 'Source only: the passage whose quote holds the number.'}),\n   103\t        'quote_number': nullable({'type': 'string', 'description': \"Source only: a complete number exactly as the quote writes it, never a \"\n   104\t                                  \"piece of a longer number, range or 'plus or minus' expression, with its currency and scale or its percent \"\n   105\t                                  \"sign, and nothing else: '$4.5 billion', 'US$300 million', '$2.1bn', '40%', '-3%', \"\n   106\t                                  \"'double', 'twice'. The value is the number as written (a minus only when the quote writes one). A written \"\n   107\t                                  \"range in full ('$3–4 billion', 'between $3 billion and $4 billion', '$3 billion to $4 billion'), given as low and high; a change \"\n   108\t                                  \"written 'from $3 billion to $5 billion' is two numbers, each copied alone. '$4.5 billion, \"\n   109\t                                  \"plus or minus 3%' in full, given as low and high or its midpoint as value. Only US dollars.\"}),\n   110\t        'qualifier': nullable({'type': 'string', 'enum': QUALIFIERS, 'description': \"Source only: the qualifier the quote writes just before \"\n   111\t                               \"the number (or 'or more' / 'or less' just after); none when there is none.\"}),\n   112\t        'inputs': nullable({'type': 'array', 'items': S, 'description': \"Computed only: ids of figures, never passages, in the operation's order.\"}),\n   113\t        'operation': nullable({'type': 'string', 'enum': ['sum', 'difference', 'product', 'ratio', 'share', 'growth', 'apply_growth'],\n   114\t                               'description': 'Computed only. sum(a, b, …) = a + b + … (one unit); difference(a, b) = a − b (one unit); '\n   115\t                               'product(a, b, …) = a × b × … (USD bn × x, x × x or % × x; never USD bn × %); ratio(a, b) = a ÷ b (same units '\n   116\t                               'give x; a ÷ x keeps a\\'s unit); share(whole, percent) = whole × percent ÷ 100, the percent from 0 to 100; '\n   117\t                               'growth(old, new) = the % change, in one unit; apply_growth(base, rate %) = base × (1 + rate ÷ 100). sum and '\n   118\t                               'product take two or more inputs; the others exactly two. Never divide by a figure that can be zero. A range '\n   119\t                               'input gives a range: compute both extremes, a figure used twice taking one value; you may declare the '\n   120\t                               'midpoint as value. The figure equals the result within 0.5% (at least 0.1, or 0.05 for %). A sum never adds '\n   121\t                               \"a figure of the part's quantity to one of the whole's for the same period (the whole already includes the \"\n   122\t                               'part); a difference may take the part from the whole of the same period only to give the rest. A sum never adds '\n   123\t                               'one quantity for the same period twice. When '\n   124\t                               'a sum or difference combines periods of one quantity, write them FY2027, FY2027 Q3, FY2027 H1 or FY2027 '\n   125\t                               \"Q1-Q3 (or CY likewise), and they make up the output's period exactly (Q1 + Q2 = H1; FY − Q1-Q3 = Q4).\"}),\n   126\t        'basis_text': nullable({'type': 'string', 'description': 'Estimate only: the assumption, in words.'}),\n   127\t        'rests_on': nullable({'type': 'array', 'items': S, 'description': 'Estimate only: the ids of the figures and passages it rests on.'}),\n   128\t        'outcome_for': dict(members, description='The members whose forecast this figure is: your own forecast (a computed or estimate figure '\n   129\t                            'with basis forecast, even when it agrees with consensus), exactly one for each member answered as a forecast, '\n   130\t                            \"none for an unresolved one. Its what is the member's outcome key, in USD bn.\"),\n   131\t        'reference_for': dict(members, description=\"The members for which this figure is the market's reference. It and every figure beneath \"\n   132\t                              'it is a source or a computed figure, never an estimate or a forecast, and at least one of them is a quoted '\n   133\t                              \"consensus, guidance or outside figure. A past period's reported share or multiple carried to another period \"\n   134\t                              \"(a quarter's mix applied to the year) makes it our comparison estimate, not the market's reference.\"),\n   135\t    })\n   136\t    push = obj({'evidence_id': {'type': 'string', 'enum': evidence_ids}, 'push': {'type': 'string', 'enum': ['toward_first', 'toward_last', 'none']}})\n   137\t    theme_push = obj({'view_id': {'type': 'string', 'enum': theme_ids or ['none']},\n   138\t                      'push': {'type': 'string', 'enum': ['toward_first', 'toward_last', 'none']}})\n   139\t    answer = obj({\n   140\t        'view_id': {'type': 'string', 'enum': member_ids},\n   141\t        'shape': {'type': 'string', 'enum': ['forecast', 'unresolved'], 'description': 'forecast: a figure marked in outcome_for, a rung, and '\n   142\t                  'a reference (a figure marked in reference_for, or reference_unavailable). unresolved: why; rung and reference_unavailable '\n   143\t                  'null; no figure marked for it.'},\n   144\t        'rung': nullable({'type': 'integer', 'description': 'Forecast only: the rung whose band holds the outcome as the code recomputes it '\n   145\t                          '(a band includes its lower edge, not its upper); for a range outcome, a band it overlaps, with the reason in reasons.'}),\n   146\t        'reference_unavailable': nullable({'type': 'string', 'description': 'Forecast only, when no figure is marked as its reference: why.'}),\n   147\t        'reasons': S,\n   148\t        'why': nullable({'type': 'string', 'description': 'Unresolved only: why the evidence cannot support a forecast.'}),\n   149\t        'cites': {'type': 'array', 'items': {'type': 'string', 'enum': evidence_ids}},\n   150\t        'pushes': {'type': 'array', 'items': push}, 'theme_pushes': {'type': 'array', 'items': theme_push},\n   151\t    })\n   152\t    return obj({'figures': {'type': 'array', 'items': figure, 'description': 'The family\\'s calculation. Use one forecast figure for each '\n   153\t                            'quantity and period, as a point or a range, wherever that quantity is needed (outside figures beneath it, or a '\n   154\t                            'point a final range rests on, are fine). A growth rate computed from guidance may serve as a stated benchmark for an estimate. '\n   155\t                            'To turn a total into a narrower quantity (data-center spending out of total capital expenditure), write the '\n   156\t                            'deduction or share as its own figure, or give a supported bound; never relabel a total as the narrower quantity. '\n   157\t                            'Figures name each other by id; no figure may depend on itself.'},\n   158\t                'answers': {'type': 'array', 'items': answer}})\n   159\t\n   160\t\n   161\tdef v13s_header(family, shown):\n   162\t    \"\"\"[52] The family header's rule lines, rendered from the family's data.\"\"\"\n   163\t    lines = []\n   164\t    for r in family.get('relations', []):\n   165\t        if r['type'] == 'part_of' and {r['part'], r['whole']} <= shown:\n   166\t            periods = ', '.join(p for p in family.get('compare_periods', []) if p != family['members'][r['part']]['what']['period'])\n   167\t            lines.append(f'Relations: {r[\"part\"]} is part of {r[\"whole\"]}. For each of {periods} and for the outcomes, the part\\'s figure may '\n   168\t                         'not exceed the whole\\'s: for every value of anything both rest on, and otherwise the part\\'s low end may not exceed '\n   169\t                         'the whole\\'s high end.')\n   170\t    if not lines:\n   171\t        lines.append('Relations: none.')\n   172\t    for ps in family.get('part_scopes', []):\n   173\t        lines.append(f'Scopes: {ps[\"population\"]} {ps[\"measure\"]} {ps[\"part\"]} is part of {ps[\"population\"]} {ps[\"measure\"]} {ps[\"whole\"]}. A sum '\n   174\t                     'never adds the part into the whole for the same period; a difference may take the part from the whole of the same '\n   175\t                     'period only to give the rest.')\n   176\t    shared = '; '.join(f'{w[\"population\"]}, {w[\"measure\"]}, {w[\"scope\"]}, {w[\"period\"]}' for w in family.get('shared', [])) or 'none'\n   177\t    lines.append(f'Shared quantities, one forecast figure each, through which every figure an outcome uses for that quantity goes: {shared}.')\n   178\t    keys = '; '.join(f'{v} = {m[\"what\"][\"population\"]} | {m[\"what\"][\"measure\"]} | {m[\"what\"][\"scope\"]} | {m[\"what\"][\"period\"]}'\n   179\t                     + (f' ({m[\"key_note\"]})' if m.get('key_note') else '') for v, m in family.get('members', {}).items() if v in shown)\n   180\t    lines.append(f'Outcome keys (population | measure | scope | period), in USD bn, to be used exactly: {keys}.')\n   181\t    return '\\n'.join(lines) + '\\n'\n   182\t\n   183\t\n   184\tdef parts(user):\n   185\t    head, rest = user.split('\\n\\n[Evidence in view', 1)\n   186\t    evidence = '[Evidence in view' + rest.split('\\n\\n[', 1)[0]\n   187\t    tail = '\\n\\n[' + rest.split('\\n\\n[', 1)[1] if '\\n\\n[' in rest else ''\n   188\t    blocks = {b.split(']', 1)[0]: '[' + b for b in tail.split('\\n\\n[')[1:]}\n   189\t    return head, evidence, blocks\n   190\t\n   191\t\n   192\tdef render(archive_path, calls, family, shown=None, fmt='v13'):\n   193\t    \"\"\"The v13 user message for a family from its members' stored requests: the members in `shown` (default: all) get a header; the\n   194\t    evidence in view is the union over every call, each passage once; the themes once; each member's exact figure keys. fmt 'v13s'\n   195\t    gives the small format's header lines (v13's bytes are unchanged).\"\"\"\n   196\t    archive = sqlite3.connect(f'file:{archive_path}?mode=ro', uri=True)\n   197\t    heads, lines, seen, themes, earlier = [], [], set(), '', []\n   198\t    shown = set(shown) if shown is not None else {v for v, _ in calls}\n   199\t    for view_id, call_id in calls:\n   200\t        user = json.loads(archive.execute('select request_json from model_calls where call_id=?', (call_id,)).fetchone()[0])['messages'][1]['content']\n   201\t        head, evidence, blocks = parts(user)\n   202\t        if view_id in shown:\n   203\t            heads.append(head)\n   204\t        for item in evidence.split('\\n- ')[1:]:\n   205\t            eid = item.split(' ', 1)[0]\n   206\t            if eid not in seen:\n   207\t                seen.add(eid)\n   208\t                lines.append('- ' + item)\n   209\t        themes = themes or next((v for k, v in blocks.items() if k.startswith('Themes')), '')\n   210\t        prev = next((v for k, v in blocks.items() if k.startswith('Previous')), '').split('\\n\\nAnswer per the JSON schema')[0]   # [46g.1] v7's output line goes\n   211\t        earlier.append(f'- {view_id}: ' + prev.replace('[Previous conclusion, for comparison only]', 'our earlier forecast, not a source:').strip())\n   212\t    rel = '; '.join(f'{r[\"part\"]} is part of {r[\"whole\"]}' if r['type'] == 'part_of' else f'{r[\"later\"]} rests on {r[\"earlier\"]}\\'s base'\n   213\t                    for r in family['relations'] if {r.get('part'), r.get('whole'), r.get('later'), r.get('earlier')} - {None} <= shown) or 'none'\n   214\t    shared = '; '.join(f'{w[\"population\"]}, {w[\"measure\"]}, {w[\"scope\"]}, {w[\"period\"]}' for w in family['shared']) or 'none'\n   215\t    keys = '; '.join(f'{v} = {m[\"what\"][\"population\"]} | {m[\"what\"][\"measure\"]} | {m[\"what\"][\"scope\"]} | {m[\"what\"][\"period\"]}'\n   216\t                     for v, m in family.get('members', {}).items() if v in shown)\n   217\t    if fmt == 'v13s':\n   218\t        header = v13s_header(family, shown)\n   219\t    else:\n   220\t        header = (f'Relations: {rel}.\\nShared quantities, one forecast each per scenario: {shared}.\\n'\n   221\t                  + (f'Outcome keys (population | measure | scope | period), to be used exactly: {keys}.\\n' if keys else ''))\n   222\t    user = ('[Family] members:\\n' + '\\n\\n'.join(heads) + '\\n\\n' + header + '\\n'\n   223\t            f'[Evidence in view for the family, {len(lines)} items]\\n' + '\\n'.join(lines) + '\\n\\n' + themes\n   224\t            + '\\n\\nAnswer per the JSON schema: one calculation for the family and one answer per member.')   # D728: no earlier forecast\n   225\t    return user, sorted(seen), [t.split(' ', 1)[0] for t in themes.split('\\n- ')[1:]]\n   226\t\n   227\t\n   228\tdef strict(calc, schema):\n   229\t    \"\"\"Fill every optional field with null, as strict structured output returns it.\"\"\"\n   230\t    fprops = schema['properties']['figures']['items']['properties']\n   231\t    aprops = schema['properties']['answers']['items']['properties']\n   232\t    figs = [{k: f.get(k) for k in fprops} for f in calc['figures']]\n   233\t    for f in figs:\n   234\t        f['scenario'] = f['scenario'] or 'base'\n   235\t        if f['what'] is None:\n   236\t            f['what'] = {'population': '', 'measure': '', 'scope': '', 'period': ''}\n   237\t    answers = []\n   238\t    for a in calc['answers']:\n   239\t        a2 = {k: a.get(k) for k in aprops}\n   240\t        if a2['reference'] is not None:\n   241\t            a2['reference'] = {'figure': a['reference'].get('figure'), 'unavailable': a['reference'].get('unavailable')}\n   242\t        a2['why'] = a.get('why')\n   243\t        answers.append(a2)\n   244\t    return {'figures': figs, 'answers': answers}\n   245\t\n   246\t\n   247\tdef without_nulls(calc):\n   248\t    clean = lambda d: {k: v for k, v in d.items() if v is not None}\n   249\t    answers = []\n   250\t    for a in calc['answers']:\n   251\t        a2 = clean(a)\n   252\t        if 'reference' in a2:\n   253\t            a2['reference'] = clean(a2['reference'])\n   254\t        answers.append(a2)\n   255\t    return {'figures': [clean(f) for f in calc['figures']], 'answers': answers}\n   256\t\n   257\t\n   258\tdef main():\n   259\t    archive = REPO / 'poc/data/comparison-2026-11-17/run/old-2/prod/archive.sqlite'\n   260\t    system = (HERE / 'judging-v13-draft.txt').read_text()\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba docs/research/2026-11-22-number-answers/calc_small.py | sed -n '300,800p'\"","aggregated_output":"   300\t            result = None\n   301\t        self._intervals[fid] = result\n   302\t        return result\n   303\t\n   304\t    def fits(self, part, whole):\n   305\t        \"\"\"[54] The part can be at most the whole: for every combination of the leaves they share, some value of each one's own leaves\n   306\t        puts the part at or below the whole (independent ranges: the part's low end at most the whole's high end).\"\"\"\n   307\t        lp, lw = self.leaves(part), self.leaves(whole)\n   308\t        shared = lp & lw\n   309\t        if len(lp | lw) > MAX_RANGE_LEAVES:\n   310\t            return True\n   311\t        for s in self.assignments(shared):\n   312\t            low_part = min(self.point(part, dict(s, **a)) for a in self.assignments(lp - shared))\n   313\t            high_whole = max(self.point(whole, dict(s, **a)) for a in self.assignments(lw - shared))\n   314\t            if low_part > high_whole + 1e-9 * max(1.0, abs(high_whole)):\n   315\t                return False\n   316\t        return True\n   317\t\n   318\t\n   319\tdef evaluate(figs):\n   320\t    calc = _Calc(figs)\n   321\t    return {fid: calc.interval(fid) for fid in figs}\n   322\t\n   323\t\n   324\tdef _evaluate_bounded(figs, refs, overrides):\n   325\t    \"\"\"The harness's reconciliation reads (interval, bound); v13s has no bounds.\"\"\"\n   326\t    try:\n   327\t        return {fid: (v, None) for fid, v in evaluate(figs).items() if v is not None}\n   328\t    except Exception:\n   329\t        return {}\n   330\t\n   331\t\n   332\tdef _upstream_of(fid, figs, refs):\n   333\t    seen_ids, stack = set(), list(refs(figs[fid]))\n   334\t    while stack:\n   335\t        f = stack.pop()\n   336\t        if f in seen_ids or f not in figs:\n   337\t            continue\n   338\t        seen_ids.add(f)\n   339\t        stack.extend(refs(figs[f]))\n   340\t    return seen_ids\n   341\t\n   342\t\n   343\tdef _uses(fid, figs):\n   344\t    \"\"\"The figures fid uses through inputs, at any depth (fid excluded).\"\"\"\n   345\t    return _upstream_of(fid, figs, lambda f: list(f.get('inputs') or []))\n   346\t\n   347\t\n   348\tdef _beneath(fid, figs):\n   349\t    \"\"\"The figures beneath fid through inputs and rests_on, at any depth (fid excluded).\"\"\"\n   350\t    return _upstream_of(fid, figs, lambda f: list(f.get('inputs') or []) + [r for r in f.get('rests_on') or [] if r in figs])\n   351\t\n   352\t\n   353\tdef _tops(start, key, figs):\n   354\t    \"\"\"[54] The figures of `key` an answer adopts: those reached from its outcome (inputs and rests_on) before any other figure of\n   355\t    that key.\"\"\"\n   356\t    found, stack, seen_ids = [], [start], set()\n   357\t    while stack:\n   358\t        fid = stack.pop()\n   359\t        if fid in seen_ids or fid not in figs:\n   360\t            continue\n   361\t        seen_ids.add(fid)\n   362\t        f = figs[fid]\n   363\t        if _key(f['what']) == key:\n   364\t            found.append(fid)\n   365\t            continue\n   366\t        stack.extend(list(f.get('inputs') or []) + [r for r in f.get('rests_on') or [] if r in figs])\n   367\t    return sorted(found)\n   368\t\n   369\t\n   370\t# ---------- the checks ----------\n   371\tdef _structure(family, passages, calc, figs):\n   372\t    errors = list(calc.get('decode_errors') or [])\n   373\t    ids = [f.get('id') for f in calc['figures']]\n   374\t    for fid in sorted({i for i in ids if ids.count(i) > 1}, key=str):\n   375\t        errors.append(('S7', f'{fid} is defined twice'))\n   376\t    for f in calc['figures']:\n   377\t        fid = f.get('id')\n   378\t        if not isinstance(fid, str) or not fid:\n   379\t            errors.append(('S7', 'a figure has no id'))\n   380\t            continue\n   381\t        if fid in passages:\n   382\t            errors.append(('S7', f'{fid}: a figure id must not be a passage id'))\n   383\t        if f.get('kind') not in KINDS or f.get('basis') not in BASES or f.get('unit') not in UNITS:\n   384\t            errors.append(('S7', f'{fid}: kind, basis or unit outside the closed set'))\n   385\t            continue\n   386\t        numbers = [f.get(k) for k in ('value', 'low', 'high') if isinstance(f.get(k), (int, float))]\n   387\t        if any(not math.isfinite(n) or abs(n) > LIMIT for n in numbers):\n   388\t            errors.append(('S7', f'{fid}: a number that is not finite or beyond {LIMIT:g}'))\n   389\t            continue\n   390\t        has_value = isinstance(f.get('value'), (int, float))\n   391\t        has_low, has_high = isinstance(f.get('low'), (int, float)), isinstance(f.get('high'), (int, float))\n   392\t        if has_value == (has_low or has_high) or has_low != has_high:\n   393\t            errors.append(('S7', f'{fid}: a figure has value, or low and high, never both and never one end alone'))\n   394\t        elif has_low and has_high and f['low'] > f['high']:\n   395\t            errors.append(('S7', f'{fid}: low is above high'))\n   396\t        kind = f['kind']\n   397\t        if kind != 'source' and (f.get('evidence') or f.get('quote_number') or (f.get('qualifier') or 'none') != 'none'):\n   398\t            errors.append(('S7', f'{fid}: evidence_id, quote_number and qualifier are for source figures only'))\n   399\t        if kind != 'computed' and (f.get('inputs') or f.get('operation')):\n   400\t            errors.append(('S7', f'{fid}: inputs and operation are for computed figures only'))\n   401\t        if kind != 'estimate' and f.get('rests_on'):\n   402\t            errors.append(('S7', f'{fid}: rests_on is for estimates only'))\n   403\t        if kind == 'source':\n   404\t            if f['basis'] == 'forecast':\n   405\t                errors.append(('S7', f'{fid}: a source cannot have basis forecast'))\n   406\t            if not f.get('evidence') or not f.get('quote_number'):\n   407\t                errors.append(('S7', f'{fid}: a source needs evidence_id and quote_number'))\n   408\t        elif kind == 'computed':\n   409\t            ins, op = f.get('inputs') or [], f.get('operation')\n   410\t            if op not in ARITY or not ins:\n   411\t                errors.append(('S7', f'{fid}: a computed figure needs inputs and an operation from the closed set'))\n   412\t            else:\n   413\t                lo_n, hi_n = ARITY[op]\n   414\t                if len(ins) < lo_n or (hi_n is not None and len(ins) > hi_n):\n   415\t                    errors.append(('S7', f'{fid}: {op} takes ' + (f'exactly {lo_n}' if hi_n == lo_n else f'{lo_n} or more') + f' inputs, not {len(ins)}'))\n   416\t            for i in ins:\n   417\t                if i in passages and i not in figs:\n   418\t                    errors.append(('S7', f'{fid}: inputs name passage {i}; inputs name figures only'))\n   419\t                elif i not in figs:\n   420\t                    errors.append(('S7', f'{fid}: input {i} is not a figure'))\n   421\t        elif not _text(f.get('basis_text')):\n   422\t            errors.append(('S7', f'{fid}: an estimate needs basis_text'))\n   423\t        for r in f.get('rests_on') or []:\n   424\t            if r not in figs and r not in passages:\n   425\t                errors.append(('S7', f'{fid}: rests_on names {r}, which is neither a figure nor a shown passage'))\n   426\t    state = {}\n   427\t\n   428\t    def cyclic(fid):\n   429\t        if state.get(fid) == 1:\n   430\t            return True\n   431\t        if state.get(fid) == 2 or fid not in figs:\n   432\t            return False\n   433\t        state[fid] = 1\n   434\t        f = figs[fid]\n   435\t        hit = any(cyclic(r) for r in list(f.get('inputs') or []) + [r for r in f.get('rests_on') or [] if r in figs])\n   436\t        state[fid] = 2\n   437\t        return hit\n   438\t    if any(cyclic(fid) for fid in figs):\n   439\t        errors.append(('S7', 'a figure depends on itself (through inputs or rests_on)'))\n   440\t    members = family['members']\n   441\t    seen = {}\n   442\t    for a in calc['answers']:\n   443\t        seen[a.get('view_id')] = seen.get(a.get('view_id'), 0) + 1\n   444\t    for v in members:\n   445\t        if seen.get(v, 0) != 1:\n   446\t            errors.append(('S7', f'{v} has {seen.get(v, 0)} answers; exactly one is required'))\n   447\t    for v in seen:\n   448\t        if v not in members:\n   449\t            errors.append(('S7', f'{v} is not a member of the family'))\n   450\t    return errors\n   451\t\n   452\t\n   453\tdef _sources(passages, figs):\n   454\t    errors = []\n   455\t    for f in figs.values():\n   456\t        if f['kind'] != 'source':\n   457\t            continue\n   458\t        fid, qn, ev = f['id'], f['quote_number'], f['evidence']\n   459\t        if ev not in passages:\n   460\t            errors.append(('S1', f'{fid}: evidence_id {ev} is not a shown passage'))\n   461\t            continue\n   462\t        text = passages[ev]['text']\n   463\t        spans = expressions(text)\n   464\t        starts = [(s, e) for s, e in spans if text[s:e] == qn]\n   465\t        if not starts:\n   466\t            inside = [text[s:e] for s, e in spans if qn in text[s:e]]\n   467\t            errors.append(('S1', f'{fid}: \"{qn}\" is part of the longer expression \"{inside[0]}\" in {ev}; copy it whole' if inside else\n   468\t                           f'{fid}: \"{qn}\" is not written in the quote of {ev} as a complete number'))\n   469\t            continue\n   470\t        parsed = parse_number(qn)\n   471\t        if parsed is None:\n   472\t            errors.append(('S1', f'{fid}: \"{qn}\" is not a US-dollar amount, a percentage or double, triple or twice, as written'))\n   473\t            continue\n   474\t        if f['unit'] != parsed['unit']:\n   475\t            errors.append(('S1', f'{fid}: \"{qn}\" is in {parsed[\"unit\"]}, not {f[\"unit\"]}'))\n   476\t            continue\n   477\t        if 'low' in parsed:\n   478\t            ok = (_same(f.get('low'), parsed['low']) and _same(f.get('high'), parsed['high'])) or \\\n   479\t                 ('mid' in parsed and _same(f.get('value'), parsed['mid']))\n   480\t        else:\n   481\t            ok = _same(f.get('value'), parsed['value'])\n   482\t        if not ok:\n   483\t            want = (f'low {parsed[\"low\"]:g} and high {parsed[\"high\"]:g}' + (f', or value {parsed[\"mid\"]:g}' if 'mid' in parsed else '')\n   484\t                    if 'low' in parsed else f'value {parsed[\"value\"]:g}')\n   485\t            errors.append(('S1', f'{fid}: \"{qn}\" gives {want} {parsed[\"unit\"]}'))\n   486\t            continue\n   487\t        q = f.get('qualifier') or 'none'\n   488\t        written = []\n   489\t        for start, end in starts:\n   490\t            before, after = text[:start], text[end:]\n   491\t            found = next((w for w in QUALIFIERS_BEFORE if re.search(r'(?:^|\\W)' + re.escape(w) + r'\\s*$', before, re.I)), None)\n   492\t            if found is None:\n   493\t                found = next((w for w in QUALIFIERS_AFTER if re.match(r'^\\s*,?\\s*' + re.escape(w) + r'\\b', after, re.I)), None)\n   494\t            written.append(found or 'none')\n   495\t        if q not in written:\n   496\t            errors.append(('S1', f'{fid}: the quote writes \"{written[0] if written else \"none\"}\" with \"{qn}\", but the qualifier is {q}'))\n   497\t    return errors\n   498\t\n   499\t\n   500\tdef _arithmetic(figs, calc):\n   501\t    errors = []\n   502\t    for f in figs.values():\n   503\t        if f['kind'] != 'computed':\n   504\t            continue\n   505\t        fid, op, ins = f['id'], f['operation'], f['inputs']\n   506\t        unit = _result_unit(op, [figs[i]['unit'] for i in ins])\n   507\t        if unit is None:\n   508\t            hint = ' (use share for a whole times a percentage)' if op == 'product' else ''\n   509\t            errors.append(('S2', f'{fid}: {op} cannot take inputs in {\", \".join(figs[i][\"unit\"] for i in ins)}{hint}'))\n   510\t            continue\n   511\t        if unit != f['unit']:\n   512\t            errors.append(('S2', f'{fid}: {op} of these inputs gives {unit}, not {f[\"unit\"]}'))\n   513\t            continue\n   514\t        got = {i: calc.interval(i) for i in ins}\n   515\t        if not all(got.values()):\n   516\t            continue                                       # an input that cannot be evaluated is refused at that input\n   517\t        if op in ('ratio', 'growth'):\n   518\t            denominator = got[ins[1]] if op == 'ratio' else got[ins[0]]\n   519\t            if denominator[0] <= 0 <= denominator[1]:\n   520\t                errors.append(('S2', f'{fid}: divides by a figure whose value can be zero'))\n   521\t                continue\n   522\t        if op == 'share' and not (0 <= got[ins[1]][0] and got[ins[1]][1] <= 100):\n   523\t            errors.append(('S2', f'{fid}: a share takes a percentage from 0 to 100'))\n   524\t            continue\n   525\t        value = calc.interval(fid)\n   526\t        if value is None:\n   527\t            errors.append(('S2', f'{fid}: the value cannot be evaluated'))\n   528\t            continue\n   529\t        lo, hi = value\n   530\t        if _is_range(f):\n   531\t            ok = _close(f['low'], lo, unit) and _close(f['high'], hi, unit)\n   532\t        else:\n   533\t            ok = _close(f['value'], (lo + hi) / 2, unit)\n   534\t        if not ok:\n   535\t            declared = f'{f[\"low\"]:g}–{f[\"high\"]:g}' if _is_range(f) else f'{f[\"value\"]:g}'\n   536\t            got_text = f'{lo:.4g}' if lo == hi else f'{lo:.4g}–{hi:.4g}'\n   537\t            errors.append(('S2', f'{fid}: declared {declared} but {op} of {\", \".join(ins)} gives {got_text}'))\n   538\t    return errors\n   539\t\n   540\t\n   541\tdef _overlaps_band(interval, band):\n   542\t    lo, hi = interval\n   543\t    b_lo = band[0] if band[0] is not None else -math.inf\n   544\t    b_hi = band[1] if band[1] is not None else math.inf\n   545\t    if lo == hi:\n   546\t        return b_lo <= lo < b_hi\n   547\t    return lo < b_hi and hi >= b_lo\n   548\t\n   549\t\n   550\tdef _answers(family, figs, calc, answers):\n   551\t    errors, outcomes = [], {}\n   552\t    members = family['members']\n   553\t    for a in answers:\n   554\t        v = a.get('view_id')\n   555\t        member = members.get(v)\n   556\t        if member is None or a.get('shape') == 'unresolved':\n   557\t            continue\n   558\t        out = figs.get(a.get('outcome'))\n   559\t        if out is None:\n   560\t            continue                                       # reported by from_answer\n   561\t        if out['kind'] not in ('computed', 'estimate') or out['basis'] != 'forecast':\n   562\t            errors.append(('S6', f'{v}: its outcome {out[\"id\"]} must be your own forecast (a computed or estimate figure with basis forecast)'))\n   563\t        if _key(out['what']) != _key(member['what']):\n   564\t            errors.append(('S6', f'{v}: outcome {out[\"id\"]} measures {\" | \".join(_key(out[\"what\"]))}, not the question\\'s {\" | \".join(_key(member[\"what\"]))}'))\n   565\t        if out['unit'] != member.get('unit', 'USD bn'):\n   566\t            errors.append(('S6', f'{v}: outcome {out[\"id\"]} is in {out[\"unit\"]}, not {member.get(\"unit\", \"USD bn\")}'))\n   567\t        outcomes[v] = out['id']\n   568\t        rung = a.get('rung')\n   569\t        if not isinstance(rung, int) or isinstance(rung, bool) or not 1 <= rung <= len(member['bands']):\n   570\t            errors.append(('S6', f'{v}: rung {rung!r} is not one of 1..{len(member[\"bands\"])}'))\n   571\t            continue\n   572\t        interval = calc.interval(out['id'])\n   573\t        if interval is not None and not _overlaps_band(interval, member['bands'][rung - 1]):\n   574\t            shown = f'{interval[0]:g}' if interval[0] == interval[1] else f'{interval[0]:g}–{interval[1]:g}'\n   575\t            errors.append(('S6', f'{v}: rung {rung} {member[\"bands\"][rung - 1]} does not hold its outcome {shown} as recomputed'))\n   576\t        ref = (a.get('reference') or {}).get('figure')\n   577\t        if ref in figs:\n   578\t            chain = {ref} | _beneath(ref, figs)\n   579\t            if any(figs[g]['kind'] == 'estimate' for g in chain):\n   580\t                errors.append(('S5', f'{v}: its reference {ref} is or rests on an estimate'))\n   581\t            elif any(figs[g]['basis'] == 'forecast' for g in chain):\n   582\t                errors.append(('S5', f'{v}: its reference {ref} is or rests on a forecast'))\n   583\t            elif not any(figs[g]['kind'] == 'source' and figs[g]['basis'] in EXTERNAL for g in chain):\n   584\t                errors.append(('S5', f'{v}: its reference {ref} has no quoted consensus, guidance or outside figure'))\n   585\t            else:                                          # [D741] a past period's reported share or multiple carried to another period\n   586\t                carried = sorted(g for g in chain if figs[g]['basis'] == 'reported' and figs[g]['unit'] in ('%', 'x')\n   587\t                                 and figs[g]['what']['period'] != figs[ref]['what']['period'])\n   588\t                if carried:\n   589\t                    errors.append(('S5', f'{v}: its reference {ref} carries the reported {\", \".join(carried)} of another period to '\n   590\t                                         f'{figs[ref][\"what\"][\"period\"]}; that makes it our comparison estimate, not the market\\'s reference'))\n   591\t    return errors, outcomes\n   592\t\n   593\t\n   594\tdef _adopted(outcomes, figs):\n   595\t    \"\"\"[54] The figures the outcomes adopt: each reached from an outcome (inputs and rests_on) with no figure of its own quantity and\n   596\t    period between them. A figure beneath another of its own quantity and period (a point a final range rests on) is its basis, not a\n   597\t    second value.\"\"\"\n   598\t    tops, seen_ids = set(), set()\n   599\t\n   600\t    def walk(fid, keys):\n   601\t        if fid not in figs or (fid, keys) in seen_ids:\n   602\t            return\n   603\t        seen_ids.add((fid, keys))\n   604\t        f = figs[fid]\n   605\t        k = _key(f['what'])\n   606\t        if k not in keys:\n   607\t            tops.add(fid)\n   608\t        for r in list(f.get('inputs') or []) + [r for r in f.get('rests_on') or [] if r in figs]:\n   609\t            walk(r, keys | {k})\n   610\t    for out in outcomes.values():\n   611\t        walk(out, frozenset())\n   612\t    return tops\n   613\t\n   614\t\n   615\tdef _shared(family, figs, outcomes):\n   616\t    errors = []\n   617\t    by_key = {}\n   618\t    for fid in _adopted(outcomes, figs):                   # [54] forecasts the outcomes adopt; an unused alternative is not counted\n   619\t        if figs[fid]['basis'] == 'forecast':\n   620\t            by_key.setdefault(_key(figs[fid]['what']), []).append(fid)\n   621\t    nodes = {}\n   622\t    for fid, f in figs.items():\n   623\t        if f['basis'] == 'forecast':\n   624\t            nodes.setdefault(_key(f['what']), []).append(fid)\n   625\t    for k, ids in sorted(by_key.items()):\n   626\t        if len(ids) > 1:\n   627\t            errors.append(('S4', f'{\" | \".join(k)}: {len(ids)} forecasts ({\", \".join(sorted(ids))}); compute it once and use that figure'))\n   628\t    for want in family.get('shared', []):\n   629\t        key = _key(want)\n   630\t        node = by_key.get(key) or nodes.get(key, [])\n   631\t        for v, out in sorted(outcomes.items()):\n   632\t            reached, stack, seen_ids = [], [out], set()\n   633\t            while stack:\n   634\t                fid = stack.pop()\n   635\t                if fid in seen_ids or fid not in figs:\n   636\t                    continue\n   637\t                seen_ids.add(fid)\n   638\t                f = figs[fid]\n   639\t                if _key(f['what']) == key:\n   640\t                    reached.append(fid)\n   641\t                    if f['basis'] == 'forecast':\n   642\t                        continue                           # through the forecast figure: what lies beneath it is its basis\n   643\t                stack.extend(f.get('inputs') or [])\n   644\t            if not reached:\n   645\t                continue\n   646\t            if len(node) != 1:\n   647\t                errors.append(('S4', f'{v}: uses {\" | \".join(key)} but the calculation has {len(node)} forecast figures for it'))\n   648\t                continue\n   649\t            bypass = sorted(r for r in reached if r != node[0])      # the walk never descends below the forecast figure\n   650\t            if bypass:\n   651\t                errors.append(('S4', f'{v}: uses {\", \".join(bypass)} for {\" | \".join(key)} beside its forecast figure {node[0]}'))\n   652\t    return errors\n   653\t\n   654\t\n   655\tdef _part_whole(family, figs, calc, outcomes):\n   656\t    errors = []\n   657\t    members = family['members']\n   658\t    for rel in family.get('relations', []):\n   659\t        if rel.get('type') != 'part_of' or rel['part'] not in outcomes or rel['whole'] not in outcomes:\n   660\t            continue\n   661\t        p_what, w_what = members[rel['part']]['what'], members[rel['whole']]['what']\n   662\t        pairs = [(outcomes[rel['part']], outcomes[rel['whole']], 'outcome')]\n   663\t        for period in family.get('compare_periods', []):\n   664\t            if period == p_what['period']:\n   665\t                continue\n   666\t            p_key = (p_what['population'], p_what['measure'], p_what['scope'], period)\n   667\t            w_key = (w_what['population'], w_what['measure'], w_what['scope'], period)\n   668\t            for p in _tops(outcomes[rel['part']], p_key, figs):\n   669\t                for w in _tops(outcomes[rel['whole']], w_key, figs):\n   670\t                    pairs.append((p, w, period))\n   671\t        for part, whole, label in pairs:\n   672\t            pv, wv = calc.interval(part), calc.interval(whole)\n   673\t            if pv is None or wv is None:\n   674\t                continue\n   675\t            if not calc.fits(part, whole):\n   676\t                errors.append(('S3', f'{label}: the part {part} ({pv[0]:g}–{pv[1]:g}) exceeds the whole {whole} ({wv[0]:g}–{wv[1]:g})'))\n   677\t    return errors\n   678\t\n   679\t\n   680\tdef _sums(family, figs):\n   681\t    errors = []\n   682\t    scopes = family.get('part_scopes', [])\n   683\t    for f in figs.values():\n   684\t        if f['kind'] != 'computed' or f['operation'] not in ('sum', 'difference'):\n   685\t            continue\n   686\t        fid, ins = f['id'], [figs[i] for i in f['inputs']]\n   687\t        for ps in scopes:\n   688\t            same = [i for i in ins if (i['what']['population'], i['what']['measure']) == (ps['population'], ps['measure'])]\n   689\t            parts = [i for i in same if i['what']['scope'] == ps['part']]\n   690\t            wholes = [i for i in same if i['what']['scope'] == ps['whole']]\n   691\t            if not parts or not wholes:\n   692\t                continue\n   693\t            if f['operation'] == 'sum':\n   694\t                if any(_overlap(p['what']['period'], w['what']['period']) for p in parts for w in wholes):\n   695\t                    errors.append(('S8', f'{fid}: adds {ps[\"part\"]} into {ps[\"whole\"]} for the same period, which already includes it'))\n   696\t            elif not (ins[0]['what']['scope'] == ps['whole'] and ins[1]['what']['scope'] == ps['part']\n   697\t                      and ins[0]['what']['period'] == ins[1]['what']['period'] == f['what']['period']\n   698\t                      and f['what']['scope'] not in (ps['part'], ps['whole'])):\n   699\t                errors.append(('S8', f'{fid}: a difference may take {ps[\"part\"]} from {ps[\"whole\"]} of the same period only to give the rest'))\n   700\t        group = ins + [f]\n   701\t        if len({_quantity(g['what']) for g in group}) != 1:\n   702\t            continue\n   703\t        periods = [g['what']['period'] for g in group]\n   704\t        inputs_periods = periods[:-1]\n   705\t        if f['operation'] == 'sum' and len(set(inputs_periods)) < len(inputs_periods):\n   706\t            errors.append(('S8', f'{fid}: adds one quantity for the same period more than once ({\", \".join(inputs_periods)})'))\n   707\t            continue\n   708\t        if len(set(periods)) == 1:\n   709\t            continue\n   710\t        parsed = [_period(p) for p in periods]\n   711\t        if not any(parsed):\n   712\t            continue\n   713\t        if not all(parsed):\n   714\t            errors.append(('S8', f'{fid}: when periods of one quantity are added or subtracted, write each as FY2027, FY2027 Q3, FY2027 H1 or '\n   715\t                                 f'FY2027 Q1-Q3 (or CY likewise); got {\", \".join(periods)}'))\n   716\t            continue\n   717\t        years = {p[0] for p in parsed}\n   718\t        *parts_p, out = parsed\n   719\t        if len(years) != 1:\n   720\t            ok = False\n   721\t        elif f['operation'] == 'sum':\n   722\t            total = [q for p in parts_p for q in p[1]]\n   723\t            ok = len(total) == len(set(total)) and set(total) == out[1]\n   724\t        else:\n   725\t            ok = parts_p[1][1] <= parts_p[0][1] and parts_p[0][1] - parts_p[1][1] == out[1]\n   726\t        if not ok:\n   727\t            sign = ' + ' if f['operation'] == 'sum' else ' − '\n   728\t            errors.append(('S8', f'{fid}: {sign.join(periods[:-1])} does not make up {periods[-1]}'))\n   729\t    return errors\n   730\t\n   731\t\n   732\tdef _recorded(family, figs, outcomes):\n   733\t    recorded = []\n   734\t    scopes = family.get('part_scopes', [])\n   735\t    for f in figs.values():\n   736\t        fid = f['id']\n   737\t        if f['kind'] == 'estimate':\n   738\t            recorded.append({'type': 'estimate', 'figure': fid, 'assumption': f.get('basis_text')})\n   739\t            rested = {figs[r]['what']['scope'] for r in f.get('rests_on') or [] if r in figs}\n   740\t            if any({ps['part'], ps['whole']} <= rested for ps in scopes):\n   741\t                recorded.append({'type': 'part and whole in one estimate', 'figure': fid})\n   742\t        elif f['kind'] == 'computed':\n   743\t            money = [figs[i] for i in f['inputs'] if figs[i]['unit'] == 'USD bn']\n   744\t            if any(_quantity(i['what']) != _quantity(f['what']) for i in money) and f['operation'] != 'share':\n   745\t                recorded.append({'type': 'conversion between quantities', 'figure': fid})\n   746\t            if f['operation'] in ('apply_growth', 'product') and any(i['what']['period'] != f['what']['period'] for i in money):\n   747\t                recorded.append({'type': 'carried across periods', 'figure': fid})\n   748\t            if f['operation'] == 'sum' and any({ps['part'], ps['whole']} <= {i['what']['scope'] for i in money} for ps in scopes):\n   749\t                recorded.append({'type': 'part and whole added for different periods', 'figure': fid})\n   750\t        elif (f.get('qualifier') or 'none') != 'none':\n   751\t            recorded.append({'type': 'qualified source', 'figure': fid, 'qualifier': f['qualifier']})\n   752\t    used = set()\n   753\t    for out in outcomes.values():\n   754\t        used |= {out} | _beneath(out, figs)\n   755\t    by_key = {}\n   756\t    for fid in used:\n   757\t        by_key.setdefault(_key(figs[fid]['what']), []).append(fid)\n   758\t    for k, ids in sorted(by_key.items()):\n   759\t        if len(ids) > 1:\n   760\t            recorded.append({'type': 'one quantity, several figures', 'figure': sorted(ids)[0], 'figures': sorted(ids), 'what': list(k)})\n   761\t    return recorded\n   762\t\n   763\t\n   764\tdef check(family, passages, calc):\n   765\t    figs = {f['id']: f for f in calc['figures'] if isinstance(f.get('id'), str)}\n   766\t    errors = _structure(family, passages, calc, figs)\n   767\t    if errors:\n   768\t        return {'errors': errors, 'recorded': [], 'published': {}}\n   769\t    engine = _Calc(figs)\n   770\t    errors = _sources(passages, figs) + _arithmetic(figs, engine)\n   771\t    for f in figs.values():\n   772\t        if engine.interval(f['id']) is None and not any(e[1].startswith(f['id'] + ':') for e in errors):\n   773\t            errors.append(('S2', f'{f[\"id\"]}: the value cannot be evaluated'))\n   774\t    if errors:\n   775\t        return {'errors': errors, 'recorded': [], 'published': {}}\n   776\t    answer_errors, outcomes = _answers(family, figs, engine, calc['answers'])\n   777\t    errors = answer_errors + _shared(family, figs, outcomes) + _part_whole(family, figs, engine, outcomes) + _sums(family, figs)\n   778\t    published = {v: list(engine.interval(o)) + [None] for v, o in outcomes.items()}\n   779\t    return {'errors': errors, 'recorded': _recorded(family, figs, outcomes), 'published': published}\n   780\t\n   781\t\n   782\tdef publish_decision(family, calc, result):\n   783\t    \"\"\"'refused' when a check fails; 'held' when a member is unresolved and a declared relation joins it to another member; else\n   784\t    'publish' (an unresolved member is shown as unresolved).\"\"\"\n   785\t    if result['errors']:\n   786\t        return 'refused'\n   787\t    unresolved = {a['view_id'] for a in calc['answers'] if a.get('shape') == 'unresolved'}\n   788\t    for rel in family.get('relations', []):\n   789\t        ends = {rel.get('part'), rel.get('whole'), rel.get('later'), rel.get('earlier')} - {None}\n   790\t        if ends & unresolved and ends - unresolved:\n   791\t            return 'held'\n   792\t    return 'publish'\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba docs/research/2026-11-22-number-answers/SMALL-DESIGN.md | sed -n '1,290p'\"","aggregated_output":"     1\t# judging-v13 small format (v13s): code refuses only the five defects and broken structure (D737)\n     2\t\n     3\tAlex (D737) chose to shrink the format. Code refuses an answer only for these five defects:\n     4\t- a number misread;\n     5\t- wrong arithmetic;\n     6\t- a part above its whole, or added into it;\n     7\t- two forecasts of one quarter;\n     8\t- an own estimate passed off as the market's.\n     9\t\n    10\tIt also refuses broken structure. Each rule is written in one or two sentences beside its field. Every other rule of `DESIGN.md`'s\n    11\tchecks becomes something the readers see, not a refusal.\n    12\t\n    13\t**Review scope (D737):** a counterexample that lets none of the five defects through, and breaks no structure, is a reader's matter,\n    14\tnot a finding. **Out of scope:**\n    15\t- the frozen ruler and `poc-v118`;\n    16\t- D725's pass lines and D731's harness rules;\n    17\t- the old run and its checker `calc_check.py`, which stay as they are, so the old run stays reproducible.\n    18\t\n    19\t## 1. What is dropped, and where it goes\n    20\t\n    21\t| Today's rule (DESIGN.md) | v13s |\n    22\t|---|---|\n    23\t| bounds and their propagation (C2 bound direction, C3/C6 open ends) | a source's qualifier is checked against the quote and shown to readers; computed figures are points or ranges |\n    24\t| scenarios, scenario membership, `range` summaries (C4) | one forecast per shared quantity; an outcome may be a range |\n    25\t| relations `time_aggregation` / `accounting_parts` / `stated_in_addition` / `overlap_unknown`, and `disputed` | periods of one quantity must make up the output's period (S8); an uncertain overlap is written as an estimate with its assumption |\n    26\t| bridges and `converts` (C8) | a conversion between quantities is computed or estimated as the analyst chooses; code records each computed figure whose inputs measure another quantity, and readers judge it |\n    27\t| `roll_forward`, the per-unit identity, `range_from_relative`, `signs` | `sum`, `difference`, `product`, `ratio`, `share`, `growth`, `apply_growth` |\n    28\t| `adjusts` | an estimate rests on the figure it changes |\n    29\t| C9 (same base), C10 (earlier forecasts) | none of the gate's families declares a same base; the request shows no earlier forecast (D728) |\n    30\t| the exact-expression grammar (C1) | the number as written (`quote_number`) plus a qualifier from a closed list |\n    31\t\n    32\t## 2. The rules code enforces (revised after round 52, `codex-r52.md`; the revision is marked [52])\n    33\t\n    34\t**[52] Shared definitions.**\n    35\t- **Uses.** A figure *uses* another when the other is among its `inputs`, at any depth. An estimate's `rests_on` is a judgement, not\n    36\t  a use. Code records it for readers, and an estimate is the value the figures above it use.\n    37\t- **Recomputed values.** The published value of a computed figure is the recomputed one, a point or a range. S3, S4 and S6 compare\n    38\t  recomputed values. S2's tolerance applies only between a declared value and its recomputed value.\n    39\t\n    40\t| # | Defect | Rule [52] (as the request states it) | Where stated |\n    41\t|---|---|---|---|\n    42\t| S1 | a number misread | A source figure names its passage (`evidence_id`) and copies the number exactly as the quote writes it (`quote_number`). The number is in US dollars ($, US$) with its scale (trillion, billion, bn, million), or is a percentage, or is one of the words double, triple or twice. The value equals it, with money in billions. A minus written before it makes the value negative. A qualifier written just before it (or \"or more\" / \"or less\" just after) goes in `qualifier`. A written range (\"$3–4 billion\", \"between $3 billion and $4 billion\") gives low and high. \"$4.5 billion, plus or minus 3%\" is copied whole, and gives its range as low and high or its midpoint as value. Money in another currency cannot be a source. | `kind`, `evidence_id`, `quote_number`, `qualifier`, `unit` |\n    43\t| S2 | wrong arithmetic | A computed figure equals its operation's result within 0.5% (at least 0.1, or 0.05 for %). Units are those `operation` states for each operation; a sum or difference adds one unit. A range input gives a range: both extremes are computed first, and a midpoint may be declared as value. Division by a range that contains zero is refused. | `operation` |\n    44\t| S3 | a part above its whole | For each period the Relations line lists, and for the outcomes, the part's lowest recomputed value used for that period may not exceed the whole's highest. | the family header |\n    45\t| S8 | a part added into its whole; periods misadded | A sum never adds a figure that uses (or is) the part's quantity to one that uses (or is) the whole's: the whole already includes the part. A difference may subtract the part from the whole only to give the rest, another scope. When a sum's or difference's inputs are periods of one quantity, each period is written FY2027, FY2027 Q3, FY2027 H1, FY2027 Q1-Q3 (or CY likewise), and together they make up the output's period exactly (Q1 + Q2 = H1; FY − Q1-Q3 = Q4). An estimate that rests on both the part and the whole is recorded for readers. | `operation`; `what.period`; the family header |\n    46\t| S4 | two forecasts of one quarter | Every number the outcomes use for one quantity and period is the same figure. Compute each quantity and period once, as a point or a range, and use that figure wherever it is needed. (Guidance or consensus beneath that figure is fine; a second figure of the same quantity and period reached on another path is not.) | the family header; `figures` |\n    47\t| S5 | an own estimate passed off as the market's | The figure marked in `reference_for` and every figure beneath it (inputs and rests_on) is a source, or computed with no basis forecast. None is an estimate. At least one is a quoted consensus, guidance or third_party figure, which may be the marked figure itself. A forecast member has exactly one marked reference figure or a `reference_unavailable` reason. | `reference_for`; `reference_unavailable` |\n    48\t| S6 | structure: the answer's number | A forecast member has exactly one figure marked in `outcome_for`. It is a computed or estimate figure with basis forecast (the analyst's own forecast, even when it agrees with consensus). Its `what` is the member's outcome key, its unit is USD bn, and its rung is 1 to the ladder's length. The rung's band (lower edge included, upper excluded) holds the recomputed outcome, or overlaps it for a range. | `outcome_for`; `rung` |\n    49\t| S7 | structure: the calculation | Ids are unique and never equal a passage id. `inputs` name figures; `rests_on` names figures or passages. No figure uses itself. A figure has value, or low and high (low ≤ high), never both. A source has `evidence_id` and `quote_number`; a computed figure has `inputs` and `operation`; an estimate has `basis_text`. Basis forecast is never on a source. There is one answer per member. An unresolved answer has `why`, rung null, `reference_unavailable` null and no marked figure. | the field descriptions |\n    50\t\n    51\t**[52] Operation units (stated in `operation`):**\n    52\t- sum and difference: one unit in, the same out.\n    53\t- product: USD bn × x → USD bn; x × x → x; % × x → %; never USD bn × %.\n    54\t- ratio: same unit → x; USD bn ÷ x → USD bn.\n    55\t- share(whole, percent): whole's unit.\n    56\t- growth(old, new): same unit → %.\n    57\t- apply_growth(base, rate %): base's unit.\n    58\t\n    59\t## 2-old. The rules as first written (superseded by the revision above)\n    60\t\n    61\t| # | Defect | Rule (as the request states it) | Where stated |\n    62\t|---|---|---|---|\n    63\t| S1 | a number misread | A source figure names its passage (`evidence_id`) and copies the number as the quote writes it (`quote_number`): with currency, scale or percent sign, or the words double, triple or twice. The figure's value equals it, in billions of dollars for money. A minus written before it makes the value negative. A qualifier written just before it (or \"or more\" / \"or less\" just after) is given in `qualifier`, and none is given when none is written. A written range gives low and high. | `kind`, `evidence_id`, `quote_number`, `qualifier`, `unit` |\n    64\t| S2 | wrong arithmetic | A computed figure equals its operation's result within 0.5% (at least 0.1, or 0.05 for %). A range input gives a range: low and high, or their midpoint as value. Money is never multiplied by a percentage (use share). Arity is as `operation` states. | `operation` |\n    65\t| S3 | a part above its whole | For each period the Relations line lists, the part's forecast figure is at most the whole's: each end of the part's value or range is at most the same end of the whole's. The part's outcome is at most the whole's outcome. | the family header; `outcome_for` |\n    66\t| S8 | a part added into its whole; periods misadded | A sum or difference never combines the part's quantity with the whole's (Relations). When a sum's or difference's inputs are periods of one quantity written as FY2027, FY2027 Q3, FY2027 H1 or FY2027 Q1-Q3, they make up the output's period exactly (Q1 + Q2 = H1; FY − Q1-Q3 = Q4). | `operation`; `what.period`; the family header |\n    67\t| S4 | two forecasts of one quarter | For each shared quantity the request lists, at most one figure has basis forecast. When a member's outcome uses that quantity, exactly one does, and every figure of that quantity the outcome uses is reached only through it (the forecast itself may be computed from guidance or consensus). | the family header; `basis` |\n    68\t| S5 | an own estimate passed off as the market's | A figure marked in `reference_for` has, at any depth beneath it, no estimate and no forecast, and at least one source of basis consensus, guidance or third_party. A forecast member has exactly one marked reference figure or a `reference_unavailable` reason. | `reference_for`; `reference_unavailable` |\n    69\t| S6 | structure: the answer's number | A forecast member has exactly one figure marked in `outcome_for`. Its `what` is the member's outcome key, its unit is USD bn, and its rung is 1 to the ladder's length. The rung's band (lower edge included, upper excluded) holds the outcome, or overlaps it for a range. | `outcome_for`; `rung` |\n    70\t| S7 | structure: the calculation | Ids are unique. `inputs` name figures and `rests_on` names figures or passages. No figure depends on itself. A figure has value, or low and high (low ≤ high), never both. A source has `evidence_id` and `quote_number`; a computed figure has `inputs` and `operation`; an estimate has `basis_text`. Basis forecast is never on a source. There is one answer per member. An unresolved answer has `why`, no rung, no marked figure and no reference. | the field descriptions |\n    71\t\n    72\t**Recorded for readers, never refused:**\n    73\t- each estimate's assumption;\n    74\t- each computed figure whose money inputs measure another population, measure or scope than its output;\n    75\t- each growth applied to a base of another period;\n    76\t- each source qualifier.\n    77\t\n    78\t## 3. The wire schema, word for word (examples from no covered company, AGENTS §6)\n    79\t\n    80\t**[52] These descriptions replace the ones in the table below:**\n    81\t\n    82\t| Field | Description [52] |\n    83\t|---|---|\n    84\t| `figures` (array) | \"The family's calculation. Compute each quantity and period once, as a point or a range, and use that figure wherever it is needed. Figures name each other by id; no figure may use itself.\" |\n    85\t| `id` | \"Short and unique, such as F1; never a passage id.\" |\n    86\t| `quote_number` | \"Source only: the number exactly as the quote writes it, with its currency and scale or its percent sign, and nothing else: '$4.5 billion', 'US$300 million', '$2.1bn', '40%', '-3%', 'double', 'twice'. A written range in full ('$3–4 billion', 'between $3 billion and $4 billion'), given as low and high. '$4.5 billion, plus or minus 3%' in full, given as low and high or its midpoint as value. Only US dollars.\" |\n    87\t| `qualifier` | enum adds `near`; \"Source only: the qualifier the quote writes just before the number (or 'or more' / 'or less' just after); none when there is none.\" |\n    88\t| `operation` | \"Computed only. sum(a, b, …) = a + b + … (one unit); difference(a, b) = a − b (one unit); product(a, b, …) = a × b × … (USD bn × x, x × x or % × x; never USD bn × %); ratio(a, b) = a ÷ b (same units give x; USD bn ÷ x gives USD bn); share(whole, percent) = whole × percent ÷ 100; growth(old, new) = the % change; apply_growth(base, rate %) = base × (1 + rate ÷ 100). sum and product take two or more inputs; the others exactly two. A range input gives a range: compute both extremes; you may declare the midpoint as value. The figure equals the result within 0.5% (at least 0.1, or 0.05 for %). A sum never adds a figure built on the part's quantity to one built on the whole's (the whole already includes the part); a difference may take the part from the whole only to give the rest. When its inputs are periods of one quantity, write them FY2027, FY2027 Q3, FY2027 H1 or FY2027 Q1-Q3 (or CY likewise), and they make up the output's period exactly (Q1 + Q2 = H1; FY − Q1-Q3 = Q4).\" |\n    89\t| `outcome_for` | \"The members whose forecast this figure is: your own forecast (a computed or estimate figure with basis forecast, even when it agrees with consensus), exactly one for each member answered as a forecast, none for an unresolved one. Its what is the member's outcome key, in USD bn.\" |\n    90\t| `reference_for` | \"The members for which this figure is the market's reference. It and every figure beneath it is a source or a computed figure, never an estimate or a forecast, and at least one of them is a quoted consensus, guidance or outside figure.\" |\n    91\t| `shape` | \"forecast: a figure marked in outcome_for, a rung, and a reference (a figure marked in reference_for, or reference_unavailable). unresolved: why; rung and reference_unavailable null; no figure marked for it.\" |\n    92\t\n    93\t**[52] The family header is rendered from the family's data** (no member id is fixed in code):\n    94\t- \"Relations: <part> is part of <whole>. For each of <compare periods> and for the outcomes, the part's lowest value may not exceed the\n    95\t  whole's highest. A sum never adds the part into the whole.\"\n    96\t- \"Shared quantities: …\" (unchanged list).\n    97\t- \"Outcome keys …, in USD bn, to be used exactly: …\"\n    98\t- For O: \"<key>: the balance at the end of FY2027, as the FY2027 annual report publishes it.\"\n    99\t\n   100\t**figures[]**\n   101\t\n   102\t| Field | Type | Description |\n   103\t|---|---|---|\n   104\t| (array) | | \"The family's calculation: every number an answer rests on, once. Figures name each other by id; no figure may depend on itself.\" |\n   105\t| `id` | string | \"Short and unique, such as F1.\" |\n   106\t| `what` | object | \"What the number measures. Where the request lists keys (outcome keys, shared quantities), copy them exactly.\" |\n   107\t| `what.measure` | string | \"The quantity, such as revenue or capital expenditure; never its basis.\" |\n   108\t| `what.period` | string | \"For example FY2027, FY2027 Q3, FY2027 H1, FY2027 Q1-Q3, CY2026, end of FY2027.\" |\n   109\t| `kind` | enum source, computed, estimate | \"source: a number written in a shown passage's quote; computed: one operation on other figures; estimate: your judgement, with its assumption in basis_text.\" |\n   110\t| `basis` | enum reported, guidance, consensus, third_party, forecast | \"reported: an actual; guidance: the company's outlook; consensus: analysts' average; third_party: one outside party; forecast: this family's own forecast, on a computed or estimate figure only.\" |\n   111\t| `value` | number or null | \"A point. Give value, or low and high, never both.\" |\n   112\t| `low`, `high` | number or null | \"A range, low at most high.\" |\n   113\t| `unit` | enum USD bn, %, x | \"USD bn: money in billions of US dollars ($1.2 trillion = 1200; $500 million = 0.5). %: a percentage as its number (7.5% = 7.5). x: a multiple (double = 2).\" |\n   114\t| `evidence_id` | enum of passage ids, or null | \"Source only: the passage whose quote holds the number.\" |\n   115\t| `quote_number` | string or null | \"Source only: the number exactly as the quote writes it, with its currency, scale or percent sign and nothing else, for example '$4.5 billion', '$300 million', '40%', '-3%', 'double'; a written range ('$3–4 billion') in full, given as low and high.\" |\n   116\t| `qualifier` | enum none, more than, over, at least, about, approximately, around, roughly, nearly, almost, up to, less than, below, under, or more, or less; or null | \"Source only: the qualifier the quote writes just before the number (or 'or more' / 'or less' just after); none when there is none.\" |\n   117\t| `inputs` | array of strings or null | \"Computed only: ids of figures, never passages, in the operation's order.\" |\n   118\t| `operation` | enum sum, difference, product, ratio, share, growth, apply_growth; or null | \"Computed only. sum(a, b, …) = a + b + …; difference(a, b) = a − b; product(a, b, …) = a × b × …, never money by a percentage; ratio(a, b) = a ÷ b; share(whole, percent) = whole × percent ÷ 100; growth(old, new) = the % change from old to new; apply_growth(base, rate) = base × (1 + rate ÷ 100). difference, ratio, share, growth and apply_growth take exactly two inputs. A range input gives a range (low and high, or their midpoint as value). The figure equals the result within 0.5% (at least 0.1, or 0.05 for %). A sum or difference never combines the part's quantity with the whole's; when its inputs are periods of one quantity, they make up the output's period exactly (Q1 + Q2 = H1; FY − Q1-Q3 = Q4).\" |\n   119\t| `basis_text` | string or null | \"Estimate only: the assumption, in words.\" |\n   120\t| `rests_on` | array of strings or null | \"Estimate only: the ids of the figures and passages it rests on.\" |\n   121\t| `outcome_for` | array of member ids (enum) | \"The members whose forecast this figure is: exactly one figure for each member answered as a forecast, none for an unresolved one. Its what is the member's outcome key, in USD bn.\" |\n   122\t| `reference_for` | array of member ids (enum) | \"The members for which this figure is the market's reference: a consensus, guidance or outside figure from a shown passage, or one computed only from such figures and reported ones. No estimate or forecast anywhere beneath it.\" |\n   123\t\n   124\t**answers[]**\n   125\t\n   126\t| Field | Description |\n   127\t|---|---|\n   128\t| `view_id` | (enum, unchanged) |\n   129\t| `shape` | \"forecast: a figure marked in outcome_for, a rung, and a reference (a figure marked in reference_for, or reference_unavailable). unresolved: why, and nothing else.\" |\n   130\t| `rung` | \"Forecast only: the rung whose band holds the outcome (a band includes its lower edge, not its upper); for a range outcome, a band it overlaps, with the reason in reasons.\" |\n   131\t| `reference_unavailable` | \"Forecast only, when no figure is marked as its reference: why.\" |\n   132\t| `reasons`, `why`, `cites`, `pushes`, `theme_pushes` | unchanged; `why`: \"Unresolved only: why the evidence cannot support a forecast.\" |\n   133\t\n   134\t**The family header (user message)**\n   135\t- \"Relations: v8 is part of v4: for each of FY2027 Q3, FY2027 Q4, FY2027, the part's forecast figure may not exceed the whole's, and\n   136\t  a sum or difference never combines the two.\"\n   137\t- \"Shared quantities, one forecast figure each, through which every figure that uses the quantity takes it: …\"\n   138\t- \"Outcome keys (population | measure | scope | period), in USD bn, to be used exactly: …\"\n   139\t\n   140\t**The system text:** one change. \"a quantity the family shares has one forecast per scenario\" becomes \"a quantity the family shares\n   141\thas one forecast\". Every other sentence is unchanged.\n   142\t\n   143\t## 4. Build\n   144\t\n   145\t- **New files.** `calc_small.py` holds `from_answer(data, family)` (wire to internal, with S6/S7 marker errors), `check`,\n   146\t  `publish_decision`, `evaluate`, `upstream_of` and `key`, and returns `{errors, recorded, published}` as `calc_check` does.\n   147\t  `render_v13.v13s_schema` builds the schema; `judging-v13s.txt` holds the system text.\n   148\t- **The plan.** `paid_gate.item` takes a format. A v13s plan (`paid-plan-v13s.json`, pinned) uses `calc_small`. A plan without a\n   149\t  format uses `calc_check` and `strip`, so the old run's `results.json` reproduces byte for byte on a copy.\n   150\t- **Rehearsal and mutants.** The rehearsal takes the plan path. Its stub answers are written in v13s. Each rule S1–S8 gets a mutant.\n   151\t- **Size.** Characters and estimated tokens for the whole request, before and after, per item. The schema is expected to be smaller\n   152\t  than today's (17 figure fields against 23, shorter descriptions than v2).\n   153\t\n   154\t**Value × reader.**\n   155\t- `from_answer`'s output is read by `check`, `publish_decision`, `merge`, `card_view` and `normalise`. It uses the internal names\n   156\t  those readers read (`evidence`, `inputs`, `rests_on`, `outcome`, `reference`), and the dropped keys never appear.\n   157\t- `merge`'s unification of a shared forecast uses `evaluate`'s values with no bound.\n   158\t- The reader brief is unchanged. Its `deciding_gap` question is where readers judge the recorded conversions and estimates.\n   159\t\n   160\t**State × event:** unchanged from D731. A refusal is retried once, diagnostic only; the first attempt is scored.\n   161\t\n   162\t## 5. The $0 blind test (registered; REPAIR-DESIGN.md §5 with rounds 51's fixes)\n   163\t\n   164\t**Inputs.** Each case's archive, call, question, ladder and unit are registered, and the build refuses a heading that differs.\n   165\t\n   166\t| Case | Archive / call | Key | Ladder edges ($bn) | Role |\n   167\t|---|---|---|---|---|\n   168\t| P (joint), P-v4, P-v8 (separate) | old-1 v4 8810, v8 8816 | NVIDIA revenue company FY2027; NVIDIA revenue Data Center FY2027 | 431.2/392/352.8/313.6; 400/350/300/250 | the pair; 79 quotes absent from the gate |\n   169\t| S | old-3 v6 9043 | four largest AI hyperscalers, data-center capex, combined, CY2026 | 500/600/700/800 | fresh: 41 of 50 quotes absent from the gate |\n   170\t| O | old-2 v29 8507 | NVIDIA equity investment commitments company end of FY2027 (the fiscal year-end balance the annual report publishes) | 25/50/75/100 | control |\n   171\t| E | old-3 v41 9071 | NVIDIA revenue Vera CPU FY2028 | 50/40/30/20 | control |\n   172\t\n   173\t**Part A, code, $0.** Each case asserts its intended rule and message. The schema's validity is checked first, so a schema error\n   174\tcannot mask the rule under test.\n   175\t- **A1, correct forms.** Each passes:\n   176\t  - a $4.5 billion ± 3% guidance as two sources with apply_growth ends;\n   177\t  - Q1 + Q2 = H1;\n   178\t  - FY − Q1-Q3 = Q4;\n   179\t  - a year-over-year rate on last year's quarter (recorded);\n   180\t  - whole × mix through share;\n   181\t  - \"over $300 billion\" with qualifier over;\n   182\t  - \"-3%\";\n   183\t  - \"$300 million or more\" with qualifier \"or more\";\n   184\t  - $1.2 trillion as 1200 USD bn;\n   185\t  - a range outcome overlapping its rung;\n   186\t  - one figure marked for two members (its own family);\n   187\t  - a computed external reference;\n   188\t  - an unresolved member;\n   189\t  - a conversion between quantities (recorded);\n   190\t  - \"not only still expects $20 billion\" as a source;\n   191\t  - 12% × 2x = 24%.\n   192\t- **A2, defects.** Each is refused by its named rule:\n   193\t  - **S1:** 108.5 for \"$108.0 billion\"; a qualifier dropped; one invented; \"-3%\" as 3; a number not in the quote; a passage's\n   194\t    summary number; trillions as 1.2 USD bn.\n   195\t  - **S2:** a plain wrong result; a wrong end of a range; division by zero; money × %; a three-input difference.\n   196\t  - **S3:** a part forecast above the whole for a listed quarter; an outcome above the whole's.\n   197\t  - **S8:** company + Data Center in one sum; Q2 + Q3 labelled H1; FY − Q1 labelled Q4.\n   198\t  - **S4:** two forecasts of one shared quarter; an outcome reaching guidance for a shared quarter beside the forecast.\n   199\t  - **S5:** a forecast beneath a reference; an estimate beneath a reference; a reported-only reference; both a marked reference and\n   200\t    a reason; neither.\n   201\t  - **S6:** no outcome marker; two; a marker on an unresolved member; an outcome key mismatch; a rung outside the ladder; a rung\n   202\t    whose band misses the outcome; at the band's upper edge.\n   203\t  - **S7:** value with low; a cycle; a dangling input; a passage id in inputs; a source with basis forecast; duplicate answers.\n   204\t- **A3, Luna's observed mistakes** from both journals, each encoded in v13s. Each is impossible under the schema or refused with a\n   205\t  reason the request states (the sentence is quoted):\n   206\t  - prose outcome, reference and evidence;\n   207\t  - unit spellings;\n   208\t  - value with range;\n   209\t  - a four-input difference;\n   210\t  - money × % through product;\n   211\t  - \"first half\";\n   212\t  - a passage id in inputs;\n   213\t  - a trillion outcome.\n   214\t\n   215\t**[52] Additions to Part A.**\n   216\t- **A1 adds:**\n   217\t  - the remainder company − Data Center = the rest;\n   218\t  - \"US$10 billion\", \"$96.2bn\", \"roughly twice\", \"between $105.84 billion and $110.16 billion\";\n   219\t  - \"$108.0 billion, plus or minus 2%\" as a range and as a midpoint;\n   220\t  - a point Data Center forecast beside a company range (S3 holds);\n   221\t  - a final range estimate resting on a computed point of the same quantity (S4 holds).\n   222\t- **A2 adds:**\n   223\t  - Data Center × 1x added to company (S8);\n   224\t  - an estimate resting on both part and whole (recorded, not refused, and the record asserted);\n   225\t  - two Data Center Q4 figures on two paths (S4);\n   226\t  - Q3 guidance used directly beside a Q3 forecast (S4);\n   227\t  - an estimate itself marked as the reference (S5);\n   228\t  - a computed reference with basis forecast (S5);\n   229\t  - a declared value within tolerance whose recomputed value crosses the rung edge (S6 on the recomputed value);\n   230\t  - a part whose recomputed lowest value exceeds the whole's recomputed highest, while its declared value does not (S3);\n   231\t  - sum($108B, 2%) (S2 unit);\n   232\t  - division by [-1, 1] (S2);\n   233\t  - [-3, -2] × [2, 4] declared other than [-12, -4] (S2);\n   234\t  - a source as the outcome (S6);\n   235\t  - a figure id equal to a passage id (S7);\n   236\t  - \"plus or minus 2%\" copied as \"2%\" and used as +2% for the range (S1);\n   237\t  - a euro amount (S1).\n   238\t- **A3:** each mistake must be refused by the schema or **actually refused** by its stated rule (asserted). \"first half\" is refused by\n   239\t  S8 when summed. \"1.05 USD trillion\" fails the schema, and \"1050 USD bn\" passes.\n   240\t- **A4, the end to end rehearsal.** One v13s reply goes through the first attempt, the separate-arm reconciliation, the card render and\n   241\t  recovery. For each named defect, the defective answer fails its rule while its paired correct answer reaches the reader's card. The\n   242\t  old run's `results.json` reproduces from its journals with the ledger snapshot saved inside it.\n   243\t\n   244\t**[52] Readers.**\n   245\t- **What they get.** Both readers get the same complete shown passages, with the writer's identity and the checker's decision masked.\n   246\t- **What they mark, on every first reply:**\n   247\t  - whether each forecast is supported, naming the passage or assumption that puts it in its band;\n   248\t  - any of D737's five defects;\n   249\t  - broken structure.\n   250\t- **The wording review is separate.** Refusals are revealed only after that marking, for the review of whether the request states\n   251\t  the rule.\n   252\t- **An accepted reply with a named defect** (marked by both readers, or by the third reader) is a stop.\n   253\t- **INCOMPLETE** is judged against the inventory of 12 first replies and 24 readings plus the third readings due.\n   254\t\n   255\t**Part B, blind writers ($0 at the provider).**\n   256\t- **The writers.** Each of the six cases is written once by a fresh Claude subagent and once by a fresh read-only Codex session, 12\n   257\t  sessions in all. Each gets only that case's exact outgoing system text, user text and schema.\n   258\t- **The first outputs** go through `model.check_schema`, `from_answer` and `check` unedited.\n   259\t- **The readers.** Two readers who wrote neither the design nor the answers (a Claude subagent and a Codex session) grade **every**\n   260\t  answer, accepted or refused, against the shown passages. For each answer they record:\n   261\t  - for each refusal, whether the exact request states the condition (the sentence quoted) and whether the answer was right;\n   262\t  - for each accepted answer, whether each forecast is supported, and whether its recorded conversions or estimates decide its band.\n   263\t- **A third reader** settles disagreements.\n   264\t- **Usable** means accepted, publishable by `publish_decision`, and supported by the readers. For the joint case, both forecasts must\n   265\t  be supported in one reply.\n   266\t\n   267\t**Stop.** The test stops on any of these:\n   268\t- an A1 form refused;\n   269\t- an A2 defect not refused by its rule;\n   270\t- an A3 mistake neither impossible nor stated;\n   271\t- a Part B refusal whose condition the request does not state, or that refuses a right answer;\n   272\t- an INCOMPLETE run;\n   273\t- a case with zero usable first replies across both writers;\n   274\t- the joint case without both supported forecasts in one reply.\n   275\t\n   276\t**A clean result** goes to Alex as the request for the paid re-send: the same 36 requests rebuilt in v13s, under a new decision with\n   277\tD725's lines. Only that run measures whether luna can do it.\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_17","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba docs/research/2026-11-22-number-answers/small_cases.py | sed -n '1,180p;285,465p;570,680p'\"","aggregated_output":"     1\t\"\"\"The v13s small format's Part A cases (SMALL-DESIGN.md §5 [52], D738): A1 correct forms pass, A2 defects are refused by their named\n     2\trule (or recorded, where D738 says so), A3 Luna's observed mistakes are impossible under the schema or refused by their stated rule.\n     3\tEach case runs the real path: the v13s schema (model.check_schema), calc_small.from_answer, calc_small.check. $0.\n     4\tUsage: python3 small_cases.py   (prints one line per case; exit 1 on any failure).\"\"\"\n     5\timport copy\n     6\timport json\n     7\timport os\n     8\timport sys\n     9\tfrom pathlib import Path\n    10\t\n    11\tHERE = Path(__file__).resolve().parent\n    12\tREPO = HERE.parents[2]\n    13\tsys.path.insert(0, str(HERE))\n    14\tsys.path.insert(0, str(REPO / 'src'))\n    15\tif os.environ.get('CALC_SMALL_DIR'):                     # small_mutants.py: a mutated calc_small.py on a scratch copy\n    16\t    sys.path.insert(0, os.environ['CALC_SMALL_DIR'])\n    17\timport calc_small as cs  # noqa: E402\n    18\timport render_v13 as rv  # noqa: E402\n    19\tfrom hivemind import model  # noqa: E402\n    20\t\n    21\tFIELDS = ['id', 'what', 'kind', 'basis', 'value', 'low', 'high', 'unit', 'evidence_id', 'quote_number', 'qualifier', 'inputs', 'operation',\n    22\t          'basis_text', 'rests_on', 'outcome_for', 'reference_for']\n    23\tPASSAGES = {\n    24\t    'e1': 'First-quarter revenue was $81.6 billion, up 85% from a year ago.',\n    25\t    'e2': 'Second-quarter revenue was $96.2 billion.',\n    26\t    'e3': 'Revenue is expected to be $108.0 billion, plus or minus 2%.',\n    27\t    'e4': 'Data Center revenue was $75.3 billion in the first quarter.',\n    28\t    'e5': 'Data Center revenue was $89.0 billion in the second quarter, 92.5% of total revenue.',\n    29\t    'e6': 'Analysts expect full-year revenue of $411 billion.',\n    30\t    'e7': 'Data center revenue will be well over $300 billion next year.',\n    31\t    'e8': 'and 65% growth in Q4.',\n    32\t    'e9': 'Fourth-quarter revenue a year ago was $68.1 billion.',\n    33\t    'e10': 'the company not only still expects $20 billion in sales, but roughly twice that number next year.',\n    34\t    'e11': 'A plant costing $300 million or more is planned.',\n    35\t    'e12': 'Margins moved -3% in the period.',\n    36\t    'e13': 'Combined spending reached $1.2 trillion.',\n    37\t    'e14': 'The bonds total US$10 billion; sales were $96.2bn; the range is between $105.84 billion and $110.16 billion.',\n    38\t    'e15': 'The program costs €5 billion.',\n    39\t    'e16': 'Spending will not be over $300 billion.',\n    40\t    'e17': 'Unit prices rose 12% and volumes doubled.',\n    41\t    'e18': 'Spending is tracked at $745 billion.',\n    42\t    'e19': 'Another estimate puts spending at $760 billion.',\n    43\t    'e20': 'The share is between 72% and 73% of the total.',\n    44\t    'e21': 'The fund may invest as much as $10 billion.',\n    45\t    'e22': 'Gross margin was 40% and the segment took 25% of it.',\n    46\t    'e23': 'Analysts believe the market will grow fivefold between this year and 2030, from $35 billion to $170 billion.',\n    47\t    'e24': 'Capex guidance ranges from $195 billion to $205 billion.',\n    48\t    'e25': 'Analysts expect the segment to take 92% of revenue this year.',\n    49\t}\n    50\tPASSAGES = {k: {'text': v, 'speaker': 'an outlet'} for k, v in PASSAGES.items()}\n    51\tEVIDENCE = sorted(PASSAGES)\n    52\t\n    53\t\n    54\tdef W(scope, period, measure='revenue', population='NVIDIA'):\n    55\t    return {'population': population, 'measure': measure, 'scope': scope, 'period': period}\n    56\t\n    57\t\n    58\tPAIR = {'members': {'v4': {'what': W('company', 'FY2027'), 'unit': 'USD bn',\n    59\t                           'bands': [[431.2, None], [392.0, 431.2], [352.8, 392.0], [313.6, 352.8], [None, 313.6]]},\n    60\t                    'v8': {'what': W('Data Center', 'FY2027'), 'unit': 'USD bn',\n    61\t                           'bands': [[400.0, None], [350.0, 400.0], [300.0, 350.0], [250.0, 300.0], [None, 250.0]]}},\n    62\t        'relations': [{'type': 'part_of', 'part': 'v8', 'whole': 'v4'}],\n    63\t        'shared': [W('company', 'FY2027 Q3'), W('company', 'FY2027 Q4')],\n    64\t        'compare_periods': ['FY2027 Q3', 'FY2027 Q4', 'FY2027'],\n    65\t        'part_scopes': [{'population': 'NVIDIA', 'measure': 'revenue', 'part': 'Data Center', 'whole': 'company'}]}\n    66\t\n    67\t\n    68\tdef F(id, what, kind, basis, unit, **kw):\n    69\t    f = {k: None for k in FIELDS}\n    70\t    f.update(id=id, what=what, kind=kind, basis=basis, unit=unit, outcome_for=[], reference_for=[])\n    71\t    f.update(kw)\n    72\t    return f\n    73\t\n    74\t\n    75\tdef A(view, shape='forecast', rung=None, reference_unavailable=None, why=None):\n    76\t    return {'view_id': view, 'shape': shape, 'rung': rung, 'reference_unavailable': reference_unavailable, 'reasons': 'case',\n    77\t            'why': why, 'cites': [], 'pushes': [], 'theme_pushes': []}\n    78\t\n    79\t\n    80\tdef base_pair():\n    81\t    \"\"\"A correct joint answer: company quarters, one shared Q3/Q4 forecast, Data Center quarters through share, a consensus reference.\"\"\"\n    82\t    figs = [\n    83\t        F('F1', W('company', 'FY2027 Q1'), 'source', 'reported', 'USD bn', value=81.6, evidence_id='e1', quote_number='$81.6 billion', qualifier='none'),\n    84\t        F('F2', W('company', 'FY2027 Q2'), 'source', 'reported', 'USD bn', value=96.2, evidence_id='e2', quote_number='$96.2 billion', qualifier='none'),\n    85\t        F('F3', W('company', 'FY2027 Q3'), 'source', 'guidance', 'USD bn', value=108.0, evidence_id='e3',\n    86\t          quote_number='$108.0 billion, plus or minus 2%', qualifier='none'),\n    87\t        F('F4', W('company', 'FY2027 Q3'), 'estimate', 'forecast', 'USD bn', value=110.0, basis_text='a small beat on guidance', rests_on=['F3']),\n    88\t        F('F5', W('company', 'FY2027 Q4'), 'estimate', 'forecast', 'USD bn', value=115.0, basis_text='growth continues', rests_on=['F4']),\n    89\t        F('F6', W('company', 'FY2027'), 'computed', 'forecast', 'USD bn', value=402.8, inputs=['F1', 'F2', 'F4', 'F5'], operation='sum',\n    90\t          outcome_for=['v4']),\n    91\t        F('F7', W('Data Center', 'FY2027 Q1'), 'source', 'reported', 'USD bn', value=75.3, evidence_id='e4', quote_number='$75.3 billion', qualifier='none'),\n    92\t        F('F8', W('Data Center', 'FY2027 Q2'), 'source', 'reported', 'USD bn', value=89.0, evidence_id='e5', quote_number='$89.0 billion', qualifier='none'),\n    93\t        F('F9', W('Data Center', 'FY2027 Q2', measure='share of revenue'), 'source', 'reported', '%', value=92.5, evidence_id='e5',\n    94\t          quote_number='92.5%', qualifier='none'),\n    95\t        F('F10', W('Data Center', 'FY2027 Q3'), 'computed', 'forecast', 'USD bn', value=101.75, inputs=['F4', 'F9'], operation='share'),\n    96\t        F('F11', W('Data Center', 'FY2027 Q4'), 'computed', 'forecast', 'USD bn', value=106.375, inputs=['F5', 'F9'], operation='share'),\n    97\t        F('F12', W('Data Center', 'FY2027'), 'computed', 'forecast', 'USD bn', value=372.425, inputs=['F7', 'F8', 'F10', 'F11'], operation='sum',\n    98\t          outcome_for=['v8']),\n    99\t        F('F13', W('company', 'FY2027'), 'source', 'consensus', 'USD bn', value=411.0, evidence_id='e6', quote_number='$411 billion',\n   100\t          qualifier='none', reference_for=['v4']),\n   101\t    ]\n   102\t    return {'figures': figs, 'answers': [A('v4', rung=2), A('v8', rung=2, reference_unavailable='no market figure for this segment')]}\n   103\t\n   104\t\n   105\tdef single(what, bands=((None, None),)):\n   106\t    return {'members': {'s': {'what': what, 'unit': 'USD bn', 'bands': [list(b) for b in bands]}}, 'relations': [], 'shared': [],\n   107\t            'compare_periods': [], 'part_scopes': []}\n   108\t\n   109\t\n   110\tdef one(figs, rung=1, family=None, reference_unavailable='none shown'):\n   111\t    fam = family or single(figs[-1]['what'], ((None, None),))\n   112\t    return {'figures': figs, 'answers': [A('s', rung=rung, reference_unavailable=reference_unavailable)]}, fam\n   113\t\n   114\t\n   115\tdef run(answer, family, passages=PASSAGES):\n   116\t    members = sorted(family['members'])\n   117\t    schema = rv.v13s_schema(members, EVIDENCE, [])\n   118\t    schema_errors = model.check_schema(answer, schema)\n   119\t    if schema_errors:\n   120\t        return {'schema': schema_errors}\n   121\t    calc = cs.from_answer(answer, family)\n   122\t    return cs.check(family, passages, calc)\n   123\t\n   124\t\n   125\tdef fig(answer, fid):\n   126\t    return next(f for f in answer['figures'] if f['id'] == fid)\n   127\t\n   128\t\n   129\tCASES = []\n   130\t\n   131\t\n   132\tMESSAGES = {}\n   133\t\n   134\t\n   135\tdef case(group, name, expect, recorded=None, message=None):\n   136\t    def wrap(build):\n   137\t        CASES.append((group, name, expect, recorded, build))\n   138\t        if message:\n   139\t            MESSAGES[name] = message                     # the intended refusal's own words, where another rule could also refuse\n   140\t        return build\n   141\t    return wrap\n   142\t\n   143\t\n   144\t# ---------- A1: correct forms pass ----------\n   145\t@case('A1', 'the base joint answer', 'pass')\n   146\tdef _():\n   147\t    return base_pair(), PAIR\n   148\t\n   149\t\n   150\t@case('A1', '$108.0B ± 2% as a range (low and high)', 'pass')\n   151\tdef _():\n   152\t    a = base_pair()\n   153\t    fig(a, 'F3').update(value=None, low=105.84, high=110.16)\n   154\t    return a, PAIR\n   155\t\n   156\t\n   157\t@case('A1', 'Q1 + Q2 = H1, then H1 + Q3 + Q4 = FY', 'pass')\n   158\tdef _():\n   159\t    a = base_pair()\n   160\t    a['figures'].append(F('H1', W('company', 'FY2027 H1'), 'computed', 'reported', 'USD bn', value=177.8, inputs=['F1', 'F2'], operation='sum'))\n   161\t    fig(a, 'F6').update(inputs=['H1', 'F4', 'F5'])\n   162\t    return a, PAIR\n   163\t\n   164\t\n   165\t@case('A1', 'FY − Q1-Q3 = Q4 (a residual)', 'pass')\n   166\tdef _():\n   167\t    a = base_pair()\n   168\t    a['figures'] += [F('N9', W('company', 'FY2027 Q1-Q3'), 'computed', 'forecast', 'USD bn', value=287.8, inputs=['F1', 'F2', 'F4'], operation='sum'),\n   169\t                     F('C4', W('company', 'FY2027 Q4'), 'computed', 'consensus', 'USD bn', value=123.2, inputs=['F13', 'N9'], operation='difference')]\n   170\t    return a, PAIR\n   171\t\n   172\t\n   173\t@case('A1', 'a year-over-year rate on last year\\'s quarter (recorded, not refused)', 'pass', recorded='carried across periods')\n   174\tdef _():\n   175\t    figs = [F('B', W('company', 'FY2026 Q4'), 'source', 'reported', 'USD bn', value=68.1, evidence_id='e9', quote_number='$68.1 billion', qualifier='none'),\n   176\t            F('G', W('company', 'FY2027 Q4', measure='revenue growth'), 'source', 'third_party', '%', value=65.0, evidence_id='e8', quote_number='65%', qualifier='none'),\n   177\t            F('O', W('company', 'FY2027 Q4'), 'computed', 'forecast', 'USD bn', value=112.365, inputs=['B', 'G'], operation='apply_growth', outcome_for=['s'])]\n   178\t    return one(figs)\n   179\t\n   180\t\n   285\tdef _():\n   286\t    figs = [F('S1', W('four companies', 'CY2026', measure='capex'), 'source', 'third_party', 'USD bn', value=745.0, evidence_id='e18',\n   287\t              quote_number='$745 billion', qualifier='none'),\n   288\t            F('M', W('four companies', 'CY2026', measure='data-center share'), 'estimate', 'forecast', 'x', value=0.8, basis_text='most capex is data centers'),\n   289\t            F('O', W('four companies', 'CY2026', measure='data-center capex'), 'computed', 'forecast', 'USD bn', value=596.0, inputs=['S1', 'M'],\n   290\t              operation='product', outcome_for=['s'])]\n   291\t    return one(figs)\n   292\t\n   293\t\n   294\t@case('A1', '\"not only still expects $20 billion\" as a source, \"roughly twice\" as a multiple', 'pass')\n   295\tdef _():\n   296\t    figs = [F('B', W('company', 'FY2027', measure='CPU sales'), 'source', 'guidance', 'USD bn', value=20.0, evidence_id='e10', quote_number='$20 billion', qualifier='none'),\n   297\t            F('X', W('company', 'FY2028', measure='CPU sales multiple'), 'source', 'guidance', 'x', value=2.0, evidence_id='e10', quote_number='twice', qualifier='roughly'),\n   298\t            F('O', W('company', 'FY2028', measure='CPU sales'), 'computed', 'forecast', 'USD bn', value=40.0, inputs=['B', 'X'], operation='product', outcome_for=['s'])]\n   299\t    return one(figs)\n   300\t\n   301\t\n   302\t@case('A1', '12% × 2x = 24%', 'pass')\n   303\tdef _():\n   304\t    figs = [F('P', W('unit', 'FY2027', measure='price change'), 'source', 'reported', '%', value=12.0, evidence_id='e17', quote_number='12%', qualifier='none'),\n   305\t            F('X', W('unit', 'FY2027', measure='factor'), 'estimate', 'forecast', 'x', value=2.0, basis_text='two steps'),\n   306\t            F('Q', W('unit', 'FY2027', measure='price change'), 'computed', 'forecast', '%', value=24.0, inputs=['P', 'X'], operation='product'),\n   307\t            F('O', W('company', 'FY2027'), 'estimate', 'forecast', 'USD bn', value=10.0, basis_text='x', rests_on=['Q'], outcome_for=['s'])]\n   308\t    return one(figs)\n   309\t\n   310\t\n   311\t@case('A1', 'US$10 billion, $96.2bn, a written range', 'pass')\n   312\tdef _():\n   313\t    figs = [F('A1', W('bonds', 'FY2027', measure='size'), 'source', 'reported', 'USD bn', value=10.0, evidence_id='e14', quote_number='US$10 billion', qualifier='none'),\n   314\t            F('A2', W('company', 'FY2027 Q2'), 'source', 'reported', 'USD bn', value=96.2, evidence_id='e14', quote_number='$96.2bn', qualifier='none'),\n   315\t            F('A3', W('company', 'FY2027 Q3'), 'source', 'guidance', 'USD bn', low=105.84, high=110.16, evidence_id='e14',\n   316\t              quote_number='between $105.84 billion and $110.16 billion', qualifier='none'),\n   317\t            F('O', W('company', 'FY2027 Q3'), 'computed', 'forecast', 'USD bn', value=108.0, inputs=['A3', 'A3'], operation='sum'),\n   318\t            ]\n   319\t    figs[-1].update(inputs=['A3'], operation='sum')\n   320\t    figs[-1].update(kind='estimate', inputs=None, operation=None, basis_text='the midpoint', rests_on=['A3'], outcome_for=['s'])\n   321\t    return one(figs)\n   322\t\n   323\t\n   324\t@case('A1', 'a point Data Center forecast beside a company range (lowest against highest)', 'pass')\n   325\tdef _():\n   326\t    a = base_pair()\n   327\t    fig(a, 'F4').update(value=None, low=105.84, high=110.16)\n   328\t    fig(a, 'F10').update(kind='estimate', basis_text='segment stays near its mix', inputs=None, operation=None, value=100.0, rests_on=['F4'])\n   329\t    fig(a, 'F6').update(value=None, low=398.64, high=402.96)\n   330\t    fig(a, 'F12').update(value=370.675)\n   331\t    return a, PAIR\n   332\t\n   333\t\n   334\t@case('A1', 'a final range estimate resting on a computed point of the same quantity', 'pass', recorded='one quantity, several figures')\n   335\tdef _():\n   336\t    a = base_pair()\n   337\t    fig(a, 'F12').update(outcome_for=[])                 # the computed point keeps basis forecast: the final range is the value adopted\n   338\t    a['figures'].append(F('R', W('Data Center', 'FY2027'), 'estimate', 'forecast', 'USD bn', low=360.0, high=385.0, basis_text='a range around it',\n   339\t                          rests_on=['F12'], outcome_for=['v8']))\n   340\t    return a, PAIR\n   341\t\n   342\t\n   343\t@case('A1', 'two outside estimates averaged into one starting point', 'pass')\n   344\tdef _():\n   345\t    figs = [F('S1', W('four companies', 'CY2026', measure='capex'), 'source', 'third_party', 'USD bn', value=745.0, evidence_id='e18', quote_number='$745 billion', qualifier='none'),\n   346\t            F('S2', W('four companies', 'CY2026', measure='capex'), 'source', 'third_party', 'USD bn', value=760.0, evidence_id='e19', quote_number='$760 billion', qualifier='none'),\n   347\t            F('T', W('four companies', 'CY2026', measure='capex, two sources'), 'computed', 'third_party', 'USD bn', value=1505.0, inputs=['S1', 'S2'], operation='sum'),\n   348\t            F('H', W('four companies', 'CY2026', measure='capex'), 'computed', 'forecast', 'USD bn', value=752.5, inputs=['T', 'D'], operation='ratio'),\n   349\t            F('D', W('four companies', 'CY2026', measure='divisor'), 'estimate', 'forecast', 'x', value=2.0, basis_text='two sources'),\n   350\t            F('O', W('four companies', 'CY2026', measure='capex'), 'estimate', 'forecast', 'USD bn', value=752.5, basis_text='the average', rests_on=['H'], outcome_for=['s'])]\n   351\t    figs[3]['basis'] = 'third_party'\n   352\t    return one(figs)\n   353\t\n   354\t\n   355\t@case('A1', 'the remainder: company − Data Center = the rest', 'pass')\n   356\tdef _():\n   357\t    a = base_pair()\n   358\t    a['figures'].append(F('REST', W('other', 'FY2027'), 'computed', 'forecast', 'USD bn', value=30.375, inputs=['F6', 'F12'], operation='difference'))\n   359\t    return a, PAIR\n   360\t\n   361\t\n   362\t# ---------- A2: defects are refused by their named rule ----------\n   363\tdef defect(name, rule, mutate, family=PAIR, base=base_pair, recorded=None):\n   364\t    @case('A2', name, rule, recorded)\n   365\t    def _():\n   366\t        a = base()\n   367\t        mutate(a)\n   368\t        return a, family\n   369\t\n   370\t\n   371\tdefect('108.5 for \"$108.0 billion\" (S1)', 'S1', lambda a: fig(a, 'F3').update(value=108.5))\n   372\tdefect('a qualifier the quote does not write (S1)', 'S1', lambda a: fig(a, 'F1').update(qualifier='about'))\n   373\tdefect('a number not written in the quote (S1)', 'S1', lambda a: fig(a, 'F1').update(quote_number='$81.62 billion', value=81.62))\n   374\tdefect('\"± 2%\" read as a positive point 110.16 (S1)', 'S1', lambda a: fig(a, 'F3').update(value=110.16))\n   375\tdefect('a plain wrong sum (S2)', 'S2', lambda a: fig(a, 'F6').update(value=410.0))\n   376\tdefect('money × % through product (S2)', 'S2', lambda a: fig(a, 'F10').update(operation='product'))\n   377\tdefect('a three-input difference (S7)', 'S7', lambda a: fig(a, 'F6').update(operation='difference'))\n   378\tdefect('a part forecast above the whole for Q3 (S3)', 'S3', lambda a: (fig(a, 'F9').update(value=92.5), fig(a, 'F10').update(\n   379\t    kind='estimate', basis_text='segment', inputs=None, operation=None, value=112.0, rests_on=['F4']), fig(a, 'F12').update(value=382.675)))\n   380\tdefect('a part outcome above the whole outcome (S3)', 'S3', lambda a: (fig(a, 'F12').update(\n   381\t    kind='estimate', basis_text='segment', inputs=None, operation=None, value=405.0, rests_on=['F10']), a['answers'][1].update(rung=1)))\n   382\tdefect('Data Center added into company in one sum (S8)', 'S8', lambda a: a['figures'].append(F(\n   383\t    'BAD', W('company', 'FY2027'), 'computed', 'forecast', 'USD bn', value=775.225, inputs=['F6', 'F12'], operation='sum')))\n   384\tdefect('Q2 + Q3 labelled H1 (S8)', 'S8', lambda a: a['figures'].append(F(\n   385\t    'BAD', W('company', 'FY2027 H1'), 'computed', 'forecast', 'USD bn', value=206.2, inputs=['F2', 'F4'], operation='sum')))\n   386\tdefect('FY − Q1 labelled Q4 (S8)', 'S8', lambda a: a['figures'].append(F(\n   387\t    'BAD', W('company', 'FY2027 Q4'), 'computed', 'consensus', 'USD bn', value=329.4, inputs=['F13', 'F1'], operation='difference')))\n   388\tdefect('two forecasts of one shared quarter, both used (S4)', 'S4', lambda a: (a['figures'].append(F(\n   389\t    'BAD', W('company', 'FY2027 Q3'), 'estimate', 'forecast', 'USD bn', value=112.0, basis_text='another view')),\n   390\t    fig(a, 'F10').update(inputs=['BAD', 'F9'], value=103.6), fig(a, 'F12').update(value=374.275)))\n   391\tdefect('an unused second forecast of a quarter is not counted (passes)', 'pass', lambda a: a['figures'].append(F(\n   392\t    'ALT', W('company', 'FY2027 Q3'), 'estimate', 'forecast', 'USD bn', value=112.0, basis_text='an alternative not used')))\n   393\tdefect('Q3 guidance used directly beside the Q3 forecast (S4)', 'S4', lambda a: fig(a, 'F10').update(inputs=['F3', 'F9'], value=99.9))\n   394\tdefect('two Data Center Q4 forecasts, both used (S4)', 'S4', lambda a: (a['figures'].append(F(\n   395\t    'BAD', W('Data Center', 'FY2027 Q4'), 'estimate', 'forecast', 'USD bn', value=104.0, basis_text='another view')),\n   396\t    fig(a, 'F12').update(outcome_for=[]), a['figures'].append(F('X', W('Data Center', 'FY2027'), 'estimate', 'forecast', 'USD bn', value=372.0,\n   397\t                                                                basis_text='near the sum', rests_on=['F12', 'BAD'], outcome_for=['v8']))))\n   398\tdefect('an estimate marked as the reference (S5)', 'S5', lambda a: (a['figures'].append(F(\n   399\t    'R8', W('Data Center', 'FY2027'), 'estimate', 'reported', 'USD bn', value=380.0, basis_text='looks like consensus', rests_on=['F13'],\n   400\t    reference_for=['v8'])), a['answers'][1].update(reference_unavailable=None)))\n   401\tdefect('a computed reference with basis forecast (S5)', 'S5', lambda a: (a['figures'].append(F(\n   402\t    'SH', W('Data Center', 'FY2027', measure='share of revenue'), 'source', 'consensus', '%', value=92.0, evidence_id='e25', quote_number='92%',\n   403\t    qualifier='none')), a['figures'].append(F(\n   404\t    'R8', W('Data Center', 'FY2027 consensus view'), 'computed', 'forecast', 'USD bn', value=378.12, inputs=['F13', 'SH'], operation='share',\n   405\t    reference_for=['v8'])), a['answers'][1].update(reference_unavailable=None)))      # an outside full-year share: only the forecast basis refuses it\n   406\tdefect('a reference resting on an estimate (S5)', 'S5', lambda a: (a['figures'].append(F(\n   407\t    'R8', W('Data Center', 'FY2027'), 'computed', 'consensus', 'USD bn', value=373.45, inputs=['F13', 'M'], operation='share',\n   408\t    reference_for=['v8'])), a['figures'].append(F('M', W('Data Center', 'FY2027', measure='mix'), 'estimate', 'forecast', '%', value=90.86,\n   409\t                                                    basis_text='mix')), a['answers'][1].update(reference_unavailable=None)))\n   410\tdefect('a reported-only reference (S5)', 'S5', lambda a: (fig(a, 'F1').update(reference_for=['v8']), a['answers'][1].update(reference_unavailable=None)))\n   411\tdefect('both a reference figure and a reason (S5)', 'S5', lambda a: a['answers'][0].update(reference_unavailable='also none'))\n   412\tdefect('neither a reference figure nor a reason (S5)', 'S5', lambda a: a['answers'][1].update(reference_unavailable=None))\n   413\tdefect('no outcome marker (S6)', 'S6', lambda a: fig(a, 'F12').update(outcome_for=[]))\n   414\tdefect('two outcome markers (S6)', 'S6', lambda a: fig(a, 'F11').update(outcome_for=['v8']))\n   415\tdefect('a marker on an unresolved member (S7)', 'S7', lambda a: a['answers'][1].update(shape='unresolved', why='none', rung=None,\n   416\t                                                                                     reference_unavailable=None))\n   417\tdefect('an outcome key mismatch (S6)', 'S6', lambda a: fig(a, 'F12').update(what=W('Data Center', 'FY2027', population='NVIDIA Corp')))\n   418\tdefect('a source as the outcome (S6)', 'S6', lambda a: (fig(a, 'F12').update(outcome_for=[]), a['figures'].append(F(\n   419\t    'SRC', W('Data Center', 'FY2027'), 'source', 'third_party', 'USD bn', value=300.0, evidence_id='e7', quote_number='$300 billion',\n   420\t    qualifier='over', outcome_for=['v8'])), a['answers'][1].update(rung=3)))\n   421\tdefect('a share above 100% (S2)', 'S2', lambda a: (fig(a, 'F9').update(kind='estimate', basis='forecast', evidence_id=None, quote_number=None,\n   422\t    qualifier=None, value=110.0, basis_text='mix'), fig(a, 'F10').update(value=121.0), fig(a, 'F11').update(value=126.5),\n   423\t    fig(a, 'F12').update(value=411.8)))\n   424\tdefect('a rung outside the ladder (S6)', 'S6', lambda a: a['answers'][0].update(rung=9))\n   425\tdefect('a rung whose band misses the outcome (S6)', 'S6', lambda a: a['answers'][0].update(rung=1))\n   426\tdefect('a declared value within tolerance whose recomputed value crosses the edge (S6)', 'S6', lambda a: (\n   427\t    fig(a, 'F5').update(value=104.3), fig(a, 'F6').update(value=391.9), a['answers'][0].update(rung=3),\n   428\t    fig(a, 'F11').update(value=96.4775), fig(a, 'F12').update(value=362.5275)))\n   429\tdefect('value with low (S7)', 'S7', lambda a: fig(a, 'F1').update(low=80.0))\n   430\tdefect('a cycle through rests_on (S7)', 'S7', lambda a: fig(a, 'F4').update(rests_on=['F5']))\n   431\tdefect('a passage id in inputs (S7)', 'S7', lambda a: fig(a, 'F6').update(inputs=['F1', 'e2', 'F4', 'F5']))\n   432\tdefect('a source with basis forecast (S7)', 'S7', lambda a: fig(a, 'F3').update(basis='forecast'))\n   433\tdefect('duplicate member answers (S7)', 'S7', lambda a: a['answers'].append(A('v4', rung=2)))\n   434\tdefect('a figure id equal to a passage id (S7)', 'S7', lambda a: a['figures'].append(F(\n   435\t    'e1', W('company', 'FY2027 Q1'), 'estimate', 'reported', 'USD bn', value=81.6, basis_text='copy')))\n   436\tdefect('an estimate resting on both part and whole (recorded, not refused)', 'pass', lambda a: a['figures'].append(F(\n   437\t    'BOTH', W('company', 'FY2027', measure='combined'), 'estimate', 'forecast', 'USD bn', value=775.0, basis_text='both', rests_on=['F6', 'F12'])),\n   438\t    recorded='part and whole in one estimate')\n   439\tdefect('Data Center × 1x added to company (recorded as a conversion, not refused: D738)', 'pass', lambda a: a['figures'] + [\n   440\t    a['figures'].append(F('ONE', W('company', 'FY2027', measure='factor'), 'estimate', 'forecast', 'x', value=1.0, basis_text='one')),\n   441\t    a['figures'].append(F('ADJ', W('company', 'FY2027', measure='revenue adjustment'), 'computed', 'forecast', 'USD bn', value=372.425,\n   442\t                          inputs=['F12', 'ONE'], operation='product'))], recorded='conversion between quantities')\n   443\t\n   444\t\n   445\t@case('A2', 'division by a range that contains zero (S2)', 'S2', message='can be zero')\n   446\tdef _():\n   447\t    figs = [F('Z', W('a', 'FY2027', measure='z'), 'estimate', 'forecast', 'x', low=-1.0, high=1.0, basis_text='z'),\n   448\t            F('N', W('a', 'FY2027', measure='n'), 'estimate', 'forecast', 'USD bn', value=10.0, basis_text='n'),\n   449\t            F('O', W('a', 'FY2027'), 'computed', 'forecast', 'USD bn', value=0.0, inputs=['N', 'Z'], operation='ratio', outcome_for=['s'])]\n   450\t    return one(figs)                                     # 0.0 is the midpoint of the vertices: only the zero-divisor rule refuses it\n   451\t\n   452\t\n   453\t@case('A2', '[-3, -2] × [2, 4] declared other than [-12, -4] (S2)', 'S2')\n   454\tdef _():\n   455\t    figs = [F('P', W('a', 'FY2027', measure='p'), 'estimate', 'forecast', 'x', low=-3.0, high=-2.0, basis_text='p'),\n   456\t            F('Q', W('a', 'FY2027', measure='q'), 'estimate', 'forecast', 'x', low=2.0, high=4.0, basis_text='q'),\n   457\t            F('R', W('a', 'FY2027', measure='r'), 'computed', 'forecast', 'x', low=-8.0, high=-6.0, inputs=['P', 'Q'], operation='product'),\n   458\t            F('O', W('a', 'FY2027'), 'estimate', 'forecast', 'USD bn', value=1.0, basis_text='o', rests_on=['R'], outcome_for=['s'])]\n   459\t    return one(figs)\n   460\t\n   461\t\n   462\t@case('A2', 'a figure used twice takes one value: ratio(F, F) over a range is 1, not a spread (passes)', 'pass')\n   463\tdef _():\n   464\t    figs = [F('P', W('a', 'FY2027', measure='p'), 'estimate', 'forecast', 'USD bn', low=50.0, high=150.0, basis_text='p'),\n   465\t            F('R', W('a', 'FY2027', measure='r'), 'computed', 'forecast', 'x', value=1.0, inputs=['P', 'P'], operation='ratio'),\n   570\t            F('R', W('a', 'FY2027', measure='r'), 'computed', 'forecast', 'x', low=lo, high=hi, inputs=['P', 'P'], operation='product'),\n   571\t            F('O', W('a', 'FY2027'), 'estimate', 'forecast', 'USD bn', value=1.0, basis_text='o', rests_on=['R'], outcome_for=['s'])]\n   572\t\n   573\t\n   574\t@case('A1', 'a part added to the whole for different periods: company H1 + Data Center Q3 (recorded, not refused)', 'pass',\n   575\t      recorded='part and whole added for different periods')\n   576\tdef _():\n   577\t    a = base_pair()\n   578\t    a['figures'] += [F('H1', W('company', 'FY2027 H1'), 'computed', 'reported', 'USD bn', value=177.8, inputs=['F1', 'F2'], operation='sum'),\n   579\t                     F('FL', W('company and Data Center', 'FY2027 Q1-Q3', measure='revenue floor'), 'computed', 'forecast', 'USD bn',\n   580\t                       value=279.55, inputs=['H1', 'F10'], operation='sum')]\n   581\t    return a, PAIR\n   582\t\n   583\t\n   584\t@case('A1', 'a share of a percentage: 25% of 40% = 10%', 'pass')\n   585\tdef _():\n   586\t    figs = [F('M', W('company', 'FY2027', measure='gross margin'), 'source', 'reported', '%', value=40.0, evidence_id='e22', quote_number='40%', qualifier='none'),\n   587\t            F('S', W('segment', 'FY2027', measure='share of margin'), 'source', 'reported', '%', value=25.0, evidence_id='e22', quote_number='25%', qualifier='none'),\n   588\t            F('X', W('segment', 'FY2027', measure='margin points'), 'computed', 'forecast', '%', value=10.0, inputs=['M', 'S'], operation='share'),\n   589\t            F('O', W('company', 'FY2027'), 'estimate', 'forecast', 'USD bn', value=1.0, basis_text='o', rests_on=['X'], outcome_for=['s'])]\n   590\t    return one(figs)\n   591\t\n   592\t\n   593\t@case('A1', '\"between 72% and 73%\" and \"as much as $10 billion\"', 'pass')\n   594\tdef _():\n   595\t    figs = [F('B', W('segment', 'FY2027', measure='share'), 'source', 'reported', '%', low=72.0, high=73.0, evidence_id='e20',\n   596\t              quote_number='between 72% and 73%', qualifier='none'),\n   597\t            F('C', W('fund', 'FY2027', measure='investment'), 'source', 'reported', 'USD bn', value=10.0, evidence_id='e21',\n   598\t              quote_number='$10 billion', qualifier='as much as'),\n   599\t            F('O', W('fund', 'FY2027', measure='investment'), 'estimate', 'forecast', 'USD bn', value=8.0, basis_text='below the cap',\n   600\t              rests_on=['B', 'C'], outcome_for=['s'])]\n   601\t    return one(figs)\n   602\t\n   603\t\n   604\t# ---------- A3: Luna's observed mistakes, encoded in v13s ----------\n   605\tdef luna(name, expect, mutate, base=base_pair, family=PAIR):\n   606\t    @case('A3', name, expect)\n   607\t    def _():\n   608\t        a = base()\n   609\t        mutate(a)\n   610\t        return a, family\n   611\t\n   612\t\n   613\tluna('a prose outcome (an outcome marker must name a member)', 'schema', lambda a: fig(a, 'F6').update(outcome_for=['$398.1 billion']))\n   614\tluna('a prose evidence id', 'schema', lambda a: fig(a, 'F1').update(evidence_id='NVIDIA reported FY2026 revenue of $215.9 billion.'))\n   615\tluna('a prose reference (a reference marker must name a member)', 'schema', lambda a: fig(a, 'F13').update(reference_for=['Analyst consensus of $411 billion']))\n   616\tluna('a unit spelled \"USD billions\"', 'schema', lambda a: fig(a, 'F1').update(unit='USD billions'))\n   617\tluna('value with a range (both given)', 'S7', lambda a: fig(a, 'F3').update(low=105.84, high=110.16))\n   618\tluna('a four-input difference', 'S7', lambda a: fig(a, 'F6').update(operation='difference'))\n   619\tluna('money × % through product', 'S2', lambda a: (fig(a, 'F10').update(operation='product', value=10175.0),\n   620\t                                                  fig(a, 'F12').update(value=10445.675)))      # arithmetic consistent: only the unit rule refuses it\n   621\tluna('\"FY2027 first half\" summed from quarters', 'S8', lambda a: a['figures'].append(F(\n   622\t    'H1', W('company', 'FY2027 first half'), 'computed', 'reported', 'USD bn', value=177.8, inputs=['F1', 'F2'], operation='sum')))\n   623\tluna('a passage id in inputs', 'S7', lambda a: fig(a, 'F6').update(inputs=['e1', 'F2', 'F4', 'F5']))\n   624\tluna('prose in inputs', 'S7', lambda a: fig(a, 'F6').update(inputs=['Q1 revenue', 'F2', 'F4', 'F5']))\n   625\tluna('an outcome in \"USD trillion\"', 'schema', lambda a: fig(a, 'F6').update(unit='USD trillion'))\n   626\tluna('\"65% growth in Q4\" copied as the number', 'S1', lambda a: a['figures'].append(F(\n   627\t    'G', W('company', 'FY2027 Q4', measure='growth'), 'source', 'third_party', '%', value=65.0, evidence_id='e8', quote_number='65% growth in Q4',\n   628\t    qualifier='none')))\n   629\t\n   630\t\n   631\tdef main():\n   632\t    failures = 0\n   633\t    for group, name, expect, recorded, build in CASES:\n   634\t        answer, family = build()\n   635\t        result = run(copy.deepcopy(answer), family)\n   636\t        if 'schema' in result:\n   637\t            got = 'schema'\n   638\t            detail = result['schema'][:1]\n   639\t        else:\n   640\t            codes = sorted({c for c, _ in result['errors']})\n   641\t            got = 'pass' if not codes else ','.join(codes)\n   642\t            detail = result['errors'][:2]\n   643\t        ok = got == expect                               # [54] exactly the registered rule(s): no other refusal may stand in for it\n   644\t        if ok and name in MESSAGES and not any(MESSAGES[name] in d for _, d in result.get('errors', [])):\n   645\t            ok, detail = False, [f'the refusal does not say \"{MESSAGES[name]}\"'] + list(result.get('errors', []))[:2]\n   646\t        if ok and recorded:\n   647\t            ok = any(r['type'] == recorded for r in result.get('recorded', []))\n   648\t            if not ok:\n   649\t                detail = [f'missing recorded {recorded}: {[r[\"type\"] for r in result.get(\"recorded\", [])]}']\n   650\t        failures += not ok\n   651\t        print(f'{\"PASS\" if ok else \"FAIL\"}  {group}  {name}  [expected {expect}{\" + recorded \" + recorded if recorded else \"\"}; got {got}]'\n   652\t              + ('' if ok else f'  {json.dumps(detail, ensure_ascii=False)[:400]}'))\n   653\t    print(f'{len(CASES) - failures} of {len(CASES)} cases as registered')\n   654\t    return 1 if failures else 0\n   655\t\n   656\t\n   657\tif __name__ == '__main__':\n   658\t    raise SystemExit(main())\n","exit_code":0,"status":"completed"}}
