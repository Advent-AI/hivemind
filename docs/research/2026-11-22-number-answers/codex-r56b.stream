{"type":"item.completed","item":{"id":"item_20","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba docs/research/2026-11-22-number-answers/render_v13.py | sed -n '88,205p'\"","aggregated_output":"    88\t               'What the number measures. Where the request lists keys (outcome keys, shared quantities), copy them exactly.')\n    89\t    figure = obj({\n    90\t        'id': {'type': 'string', 'description': 'Short and unique, such as F1; never a passage id.'},\n    91\t        'what': what,\n    92\t        'kind': {'type': 'string', 'enum': ['source', 'computed', 'estimate'], 'description': \"source: a number written in a shown passage's \"\n    93\t                 'quote; computed: one operation on other figures; estimate: your judgement, with its assumption in basis_text.'},\n    94\t        'basis': {'type': 'string', 'enum': ['reported', 'guidance', 'consensus', 'third_party', 'forecast'], 'description': \"reported: an \"\n    95\t                  \"actual; guidance: the company's outlook; consensus: analysts' average; third_party: one outside party; forecast: this \"\n    96\t                  \"family's own forecast, on a computed or estimate figure only.\"},\n    97\t        'value': nullable({'type': 'number', 'description': 'A point. Give value, or low and high, never both.'}),\n    98\t        'low': nullable({'type': 'number', 'description': 'A range, low at most high, with value null.'}),\n    99\t        'high': nullable({'type': 'number', 'description': 'A range, low at most high, with value null.'}),\n   100\t        'unit': {'type': 'string', 'enum': ['USD bn', '%', 'x'], 'description': 'USD bn: money in billions of US dollars ($1.2 trillion = '\n   101\t                 '1200; $500 million = 0.5). %: a percentage as its number (7.5% = 7.5). x: a multiple (double = 2).'},\n   102\t        'evidence_id': nullable({'type': 'string', 'enum': evidence_ids, 'description': 'Source only: the passage whose quote holds the number.'}),\n   103\t        'quote_number': nullable({'type': 'string', 'description': \"Source only: a complete number exactly as the quote writes it, never a \"\n   104\t                                  \"piece of a longer number, range or 'plus or minus' expression, with its currency and scale or its percent \"\n   105\t                                  \"sign, and nothing else: '$4.5 billion', 'US$300 million', '$2.1bn', '40%', '-3%', \"\n   106\t                                  \"'double', 'twice'. The value is the number as written (a minus only when the quote writes one). A written \"\n   107\t                                  \"range in full ('$3–4 billion', 'between $3 billion and $4 billion', '$3 billion to $4 billion'), given as low and high; a change \"\n   108\t                                  \"written 'from $3 billion to $5 billion' is two numbers, each copied alone. '$4.5 billion, \"\n   109\t                                  \"plus or minus 3%' in full, given as low and high or its midpoint as value. Only US dollars.\"}),\n   110\t        'qualifier': nullable({'type': 'string', 'enum': QUALIFIERS, 'description': \"Source only: the qualifier the quote writes just before \"\n   111\t                               \"the number (or 'or more' / 'or less' just after); none when there is none.\"}),\n   112\t        'inputs': nullable({'type': 'array', 'items': S, 'description': \"Computed only: ids of figures, never passages, in the operation's order.\"}),\n   113\t        'operation': nullable({'type': 'string', 'enum': ['sum', 'difference', 'product', 'ratio', 'share', 'growth', 'apply_growth'],\n   114\t                               'description': 'Computed only. sum(a, b, …) = a + b + … (one unit); difference(a, b) = a − b (one unit); '\n   115\t                               'product(a, b, …) = a × b × … (USD bn × x, x × x or % × x; never USD bn × %); ratio(a, b) = a ÷ b (same units '\n   116\t                               'give x; a ÷ x keeps a\\'s unit); share(whole, percent) = whole × percent ÷ 100, the percent from 0 to 100; '\n   117\t                               'growth(old, new) = the % change, in one unit; apply_growth(base, rate %) = base × (1 + rate ÷ 100). sum and '\n   118\t                               'product take two or more inputs; the others exactly two. Never divide by a figure that can be zero. A range '\n   119\t                               'input gives a range: compute both extremes, a figure used twice taking one value; you may declare the '\n   120\t                               'midpoint as value. The figure equals the result within 0.5% (at least 0.1, or 0.05 for %). A sum never adds '\n   121\t                               \"a figure of the part's quantity to one of the whole's for the same period (the whole already includes the \"\n   122\t                               'part); a difference may take the part from the whole of the same period only to give the rest. A sum never adds '\n   123\t                               'one quantity for the same period twice. When '\n   124\t                               'a sum or difference combines periods of one quantity, write them FY2027, FY2027 Q3, FY2027 H1 or FY2027 '\n   125\t                               \"Q1-Q3 (or CY likewise), and they make up the output's period exactly (Q1 + Q2 = H1; FY − Q1-Q3 = Q4).\"}),\n   126\t        'basis_text': nullable({'type': 'string', 'description': 'Estimate only: the assumption, in words.'}),\n   127\t        'rests_on': nullable({'type': 'array', 'items': S, 'description': 'Estimate only: the ids of the figures and passages it rests on.'}),\n   128\t        'outcome_for': dict(members, description='The members whose forecast this figure is: your own forecast (a computed or estimate figure '\n   129\t                            'with basis forecast, even when it agrees with consensus), exactly one for each member answered as a forecast, '\n   130\t                            \"none for an unresolved one. Its what is the member's outcome key, in USD bn.\"),\n   131\t        'reference_for': dict(members, description=\"The members for which this figure is the market's reference. It and every figure beneath \"\n   132\t                              'it is a source or a computed figure, never an estimate or a forecast, and at least one of them is a quoted '\n   133\t                              \"consensus, guidance or outside figure. A past period's reported share or multiple carried to another period \"\n   134\t                              \"(a quarter's mix applied to the year) makes it our comparison estimate, not the market's reference.\"),\n   135\t    })\n   136\t    push = obj({'evidence_id': {'type': 'string', 'enum': evidence_ids}, 'push': {'type': 'string', 'enum': ['toward_first', 'toward_last', 'none']}})\n   137\t    theme_push = obj({'view_id': {'type': 'string', 'enum': theme_ids or ['none']},\n   138\t                      'push': {'type': 'string', 'enum': ['toward_first', 'toward_last', 'none']}})\n   139\t    answer = obj({\n   140\t        'view_id': {'type': 'string', 'enum': member_ids},\n   141\t        'shape': {'type': 'string', 'enum': ['forecast', 'unresolved'], 'description': 'forecast: a figure marked in outcome_for, a rung, and '\n   142\t                  'a reference (a figure marked in reference_for, or reference_unavailable). unresolved: why; rung and reference_unavailable '\n   143\t                  'null; no figure marked for it.'},\n   144\t        'rung': nullable({'type': 'integer', 'description': 'Forecast only: the rung whose band holds the outcome as the code recomputes it '\n   145\t                          '(a band includes its lower edge, not its upper); for a range outcome, a band it overlaps, with the reason in reasons.'}),\n   146\t        'reference_unavailable': nullable({'type': 'string', 'description': 'Forecast only, when no figure is marked as its reference: why.'}),\n   147\t        'reasons': S,\n   148\t        'why': nullable({'type': 'string', 'description': 'Unresolved only: why the evidence cannot support a forecast.'}),\n   149\t        'cites': {'type': 'array', 'items': {'type': 'string', 'enum': evidence_ids}},\n   150\t        'pushes': {'type': 'array', 'items': push}, 'theme_pushes': {'type': 'array', 'items': theme_push},\n   151\t    })\n   152\t    return obj({'figures': {'type': 'array', 'items': figure, 'description': 'The family\\'s calculation. Use one forecast figure for each '\n   153\t                            'quantity and period, as a point or a range, wherever that quantity is needed (outside figures beneath it, or a '\n   154\t                            'point a final range rests on, are fine). A growth rate computed from guidance may serve as a stated benchmark for an estimate. '\n   155\t                            'To turn a total into a narrower quantity (data-center spending out of total capital expenditure), write the '\n   156\t                            'deduction or share as its own figure, or give a supported bound; never relabel a total as the narrower quantity. '\n   157\t                            'Figures name each other by id; no figure may depend on itself.'},\n   158\t                'answers': {'type': 'array', 'items': answer}})\n   159\t\n   160\t\n   161\tdef v13s_header(family, shown):\n   162\t    \"\"\"[52] The family header's rule lines, rendered from the family's data.\"\"\"\n   163\t    lines = []\n   164\t    for r in family.get('relations', []):\n   165\t        if r['type'] == 'part_of' and {r['part'], r['whole']} <= shown:\n   166\t            periods = ', '.join(p for p in family.get('compare_periods', []) if p != family['members'][r['part']]['what']['period'])\n   167\t            lines.append(f'Relations: {r[\"part\"]} is part of {r[\"whole\"]}. For each of {periods} and for the outcomes, the part\\'s figure may '\n   168\t                         'not exceed the whole\\'s: for every value of anything both rest on, and otherwise the part\\'s low end may not exceed '\n   169\t                         'the whole\\'s high end.')\n   170\t    if not lines:\n   171\t        lines.append('Relations: none.')\n   172\t    for ps in family.get('part_scopes', []):\n   173\t        lines.append(f'Scopes: {ps[\"population\"]} {ps[\"measure\"]} {ps[\"part\"]} is part of {ps[\"population\"]} {ps[\"measure\"]} {ps[\"whole\"]}. A sum '\n   174\t                     'never adds the part into the whole for the same period; a difference may take the part from the whole of the same '\n   175\t                     'period only to give the rest.')\n   176\t    shared = '; '.join(f'{w[\"population\"]}, {w[\"measure\"]}, {w[\"scope\"]}, {w[\"period\"]}' for w in family.get('shared', [])) or 'none'\n   177\t    lines.append(f'Shared quantities, one forecast figure each, through which every figure an outcome uses for that quantity goes: {shared}.')\n   178\t    keys = '; '.join(f'{v} = {m[\"what\"][\"population\"]} | {m[\"what\"][\"measure\"]} | {m[\"what\"][\"scope\"]} | {m[\"what\"][\"period\"]}'\n   179\t                     + (f' ({m[\"key_note\"]})' if m.get('key_note') else '') for v, m in family.get('members', {}).items() if v in shown)\n   180\t    lines.append(f'Outcome keys (population | measure | scope | period), in USD bn, to be used exactly: {keys}.')\n   181\t    return '\\n'.join(lines) + '\\n'\n   182\t\n   183\t\n   184\tdef parts(user):\n   185\t    head, rest = user.split('\\n\\n[Evidence in view', 1)\n   186\t    evidence = '[Evidence in view' + rest.split('\\n\\n[', 1)[0]\n   187\t    tail = '\\n\\n[' + rest.split('\\n\\n[', 1)[1] if '\\n\\n[' in rest else ''\n   188\t    blocks = {b.split(']', 1)[0]: '[' + b for b in tail.split('\\n\\n[')[1:]}\n   189\t    return head, evidence, blocks\n   190\t\n   191\t\n   192\tdef render(archive_path, calls, family, shown=None, fmt='v13'):\n   193\t    \"\"\"The v13 user message for a family from its members' stored requests: the members in `shown` (default: all) get a header; the\n   194\t    evidence in view is the union over every call, each passage once; the themes once; each member's exact figure keys. fmt 'v13s'\n   195\t    gives the small format's header lines (v13's bytes are unchanged).\"\"\"\n   196\t    archive = sqlite3.connect(f'file:{archive_path}?mode=ro', uri=True)\n   197\t    heads, lines, seen, themes, earlier = [], [], set(), '', []\n   198\t    shown = set(shown) if shown is not None else {v for v, _ in calls}\n   199\t    for view_id, call_id in calls:\n   200\t        user = json.loads(archive.execute('select request_json from model_calls where call_id=?', (call_id,)).fetchone()[0])['messages'][1]['content']\n   201\t        head, evidence, blocks = parts(user)\n   202\t        if view_id in shown:\n   203\t            heads.append(head)\n   204\t        for item in evidence.split('\\n- ')[1:]:\n   205\t            eid = item.split(' ', 1)[0]\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_19","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba docs/research/2026-11-22-number-answers/SMALL-DESIGN.md | sed -n '56,179p'\"","aggregated_output":"    56\t- growth(old, new): same unit → %.\n    57\t- apply_growth(base, rate %): base's unit.\n    58\t\n    59\t## 2-old. The rules as first written (superseded by the revision above)\n    60\t\n    61\t| # | Defect | Rule (as the request states it) | Where stated |\n    62\t|---|---|---|---|\n    63\t| S1 | a number misread | A source figure names its passage (`evidence_id`) and copies the number as the quote writes it (`quote_number`): with currency, scale or percent sign, or the words double, triple or twice. The figure's value equals it, in billions of dollars for money. A minus written before it makes the value negative. A qualifier written just before it (or \"or more\" / \"or less\" just after) is given in `qualifier`, and none is given when none is written. A written range gives low and high. | `kind`, `evidence_id`, `quote_number`, `qualifier`, `unit` |\n    64\t| S2 | wrong arithmetic | A computed figure equals its operation's result within 0.5% (at least 0.1, or 0.05 for %). A range input gives a range: low and high, or their midpoint as value. Money is never multiplied by a percentage (use share). Arity is as `operation` states. | `operation` |\n    65\t| S3 | a part above its whole | For each period the Relations line lists, the part's forecast figure is at most the whole's: each end of the part's value or range is at most the same end of the whole's. The part's outcome is at most the whole's outcome. | the family header; `outcome_for` |\n    66\t| S8 | a part added into its whole; periods misadded | A sum or difference never combines the part's quantity with the whole's (Relations). When a sum's or difference's inputs are periods of one quantity written as FY2027, FY2027 Q3, FY2027 H1 or FY2027 Q1-Q3, they make up the output's period exactly (Q1 + Q2 = H1; FY − Q1-Q3 = Q4). | `operation`; `what.period`; the family header |\n    67\t| S4 | two forecasts of one quarter | For each shared quantity the request lists, at most one figure has basis forecast. When a member's outcome uses that quantity, exactly one does, and every figure of that quantity the outcome uses is reached only through it (the forecast itself may be computed from guidance or consensus). | the family header; `basis` |\n    68\t| S5 | an own estimate passed off as the market's | A figure marked in `reference_for` has, at any depth beneath it, no estimate and no forecast, and at least one source of basis consensus, guidance or third_party. A forecast member has exactly one marked reference figure or a `reference_unavailable` reason. | `reference_for`; `reference_unavailable` |\n    69\t| S6 | structure: the answer's number | A forecast member has exactly one figure marked in `outcome_for`. Its `what` is the member's outcome key, its unit is USD bn, and its rung is 1 to the ladder's length. The rung's band (lower edge included, upper excluded) holds the outcome, or overlaps it for a range. | `outcome_for`; `rung` |\n    70\t| S7 | structure: the calculation | Ids are unique. `inputs` name figures and `rests_on` names figures or passages. No figure depends on itself. A figure has value, or low and high (low ≤ high), never both. A source has `evidence_id` and `quote_number`; a computed figure has `inputs` and `operation`; an estimate has `basis_text`. Basis forecast is never on a source. There is one answer per member. An unresolved answer has `why`, no rung, no marked figure and no reference. | the field descriptions |\n    71\t\n    72\t**Recorded for readers, never refused:**\n    73\t- each estimate's assumption;\n    74\t- each computed figure whose money inputs measure another population, measure or scope than its output;\n    75\t- each growth applied to a base of another period;\n    76\t- each source qualifier.\n    77\t\n    78\t## 3. The wire schema, word for word (examples from no covered company, AGENTS §6)\n    79\t\n    80\t**[52] These descriptions replace the ones in the table below:**\n    81\t\n    82\t| Field | Description [52] |\n    83\t|---|---|\n    84\t| `figures` (array) | \"The family's calculation. Compute each quantity and period once, as a point or a range, and use that figure wherever it is needed. Figures name each other by id; no figure may use itself.\" |\n    85\t| `id` | \"Short and unique, such as F1; never a passage id.\" |\n    86\t| `quote_number` | \"Source only: the number exactly as the quote writes it, with its currency and scale or its percent sign, and nothing else: '$4.5 billion', 'US$300 million', '$2.1bn', '40%', '-3%', 'double', 'twice'. A written range in full ('$3–4 billion', 'between $3 billion and $4 billion'), given as low and high. '$4.5 billion, plus or minus 3%' in full, given as low and high or its midpoint as value. Only US dollars.\" |\n    87\t| `qualifier` | enum adds `near`; \"Source only: the qualifier the quote writes just before the number (or 'or more' / 'or less' just after); none when there is none.\" |\n    88\t| `operation` | \"Computed only. sum(a, b, …) = a + b + … (one unit); difference(a, b) = a − b (one unit); product(a, b, …) = a × b × … (USD bn × x, x × x or % × x; never USD bn × %); ratio(a, b) = a ÷ b (same units give x; USD bn ÷ x gives USD bn); share(whole, percent) = whole × percent ÷ 100; growth(old, new) = the % change; apply_growth(base, rate %) = base × (1 + rate ÷ 100). sum and product take two or more inputs; the others exactly two. A range input gives a range: compute both extremes; you may declare the midpoint as value. The figure equals the result within 0.5% (at least 0.1, or 0.05 for %). A sum never adds a figure built on the part's quantity to one built on the whole's (the whole already includes the part); a difference may take the part from the whole only to give the rest. When its inputs are periods of one quantity, write them FY2027, FY2027 Q3, FY2027 H1 or FY2027 Q1-Q3 (or CY likewise), and they make up the output's period exactly (Q1 + Q2 = H1; FY − Q1-Q3 = Q4).\" |\n    89\t| `outcome_for` | \"The members whose forecast this figure is: your own forecast (a computed or estimate figure with basis forecast, even when it agrees with consensus), exactly one for each member answered as a forecast, none for an unresolved one. Its what is the member's outcome key, in USD bn.\" |\n    90\t| `reference_for` | \"The members for which this figure is the market's reference. It and every figure beneath it is a source or a computed figure, never an estimate or a forecast, and at least one of them is a quoted consensus, guidance or outside figure.\" |\n    91\t| `shape` | \"forecast: a figure marked in outcome_for, a rung, and a reference (a figure marked in reference_for, or reference_unavailable). unresolved: why; rung and reference_unavailable null; no figure marked for it.\" |\n    92\t\n    93\t**[52] The family header is rendered from the family's data** (no member id is fixed in code):\n    94\t- \"Relations: <part> is part of <whole>. For each of <compare periods> and for the outcomes, the part's lowest value may not exceed the\n    95\t  whole's highest. A sum never adds the part into the whole.\"\n    96\t- \"Shared quantities: …\" (unchanged list).\n    97\t- \"Outcome keys …, in USD bn, to be used exactly: …\"\n    98\t- For O: \"<key>: the balance at the end of FY2027, as the FY2027 annual report publishes it.\"\n    99\t\n   100\t**figures[]**\n   101\t\n   102\t| Field | Type | Description |\n   103\t|---|---|---|\n   104\t| (array) | | \"The family's calculation: every number an answer rests on, once. Figures name each other by id; no figure may depend on itself.\" |\n   105\t| `id` | string | \"Short and unique, such as F1.\" |\n   106\t| `what` | object | \"What the number measures. Where the request lists keys (outcome keys, shared quantities), copy them exactly.\" |\n   107\t| `what.measure` | string | \"The quantity, such as revenue or capital expenditure; never its basis.\" |\n   108\t| `what.period` | string | \"For example FY2027, FY2027 Q3, FY2027 H1, FY2027 Q1-Q3, CY2026, end of FY2027.\" |\n   109\t| `kind` | enum source, computed, estimate | \"source: a number written in a shown passage's quote; computed: one operation on other figures; estimate: your judgement, with its assumption in basis_text.\" |\n   110\t| `basis` | enum reported, guidance, consensus, third_party, forecast | \"reported: an actual; guidance: the company's outlook; consensus: analysts' average; third_party: one outside party; forecast: this family's own forecast, on a computed or estimate figure only.\" |\n   111\t| `value` | number or null | \"A point. Give value, or low and high, never both.\" |\n   112\t| `low`, `high` | number or null | \"A range, low at most high.\" |\n   113\t| `unit` | enum USD bn, %, x | \"USD bn: money in billions of US dollars ($1.2 trillion = 1200; $500 million = 0.5). %: a percentage as its number (7.5% = 7.5). x: a multiple (double = 2).\" |\n   114\t| `evidence_id` | enum of passage ids, or null | \"Source only: the passage whose quote holds the number.\" |\n   115\t| `quote_number` | string or null | \"Source only: the number exactly as the quote writes it, with its currency, scale or percent sign and nothing else, for example '$4.5 billion', '$300 million', '40%', '-3%', 'double'; a written range ('$3–4 billion') in full, given as low and high.\" |\n   116\t| `qualifier` | enum none, more than, over, at least, about, approximately, around, roughly, nearly, almost, up to, less than, below, under, or more, or less; or null | \"Source only: the qualifier the quote writes just before the number (or 'or more' / 'or less' just after); none when there is none.\" |\n   117\t| `inputs` | array of strings or null | \"Computed only: ids of figures, never passages, in the operation's order.\" |\n   118\t| `operation` | enum sum, difference, product, ratio, share, growth, apply_growth; or null | \"Computed only. sum(a, b, …) = a + b + …; difference(a, b) = a − b; product(a, b, …) = a × b × …, never money by a percentage; ratio(a, b) = a ÷ b; share(whole, percent) = whole × percent ÷ 100; growth(old, new) = the % change from old to new; apply_growth(base, rate) = base × (1 + rate ÷ 100). difference, ratio, share, growth and apply_growth take exactly two inputs. A range input gives a range (low and high, or their midpoint as value). The figure equals the result within 0.5% (at least 0.1, or 0.05 for %). A sum or difference never combines the part's quantity with the whole's; when its inputs are periods of one quantity, they make up the output's period exactly (Q1 + Q2 = H1; FY − Q1-Q3 = Q4).\" |\n   119\t| `basis_text` | string or null | \"Estimate only: the assumption, in words.\" |\n   120\t| `rests_on` | array of strings or null | \"Estimate only: the ids of the figures and passages it rests on.\" |\n   121\t| `outcome_for` | array of member ids (enum) | \"The members whose forecast this figure is: exactly one figure for each member answered as a forecast, none for an unresolved one. Its what is the member's outcome key, in USD bn.\" |\n   122\t| `reference_for` | array of member ids (enum) | \"The members for which this figure is the market's reference: a consensus, guidance or outside figure from a shown passage, or one computed only from such figures and reported ones. No estimate or forecast anywhere beneath it.\" |\n   123\t\n   124\t**answers[]**\n   125\t\n   126\t| Field | Description |\n   127\t|---|---|\n   128\t| `view_id` | (enum, unchanged) |\n   129\t| `shape` | \"forecast: a figure marked in outcome_for, a rung, and a reference (a figure marked in reference_for, or reference_unavailable). unresolved: why, and nothing else.\" |\n   130\t| `rung` | \"Forecast only: the rung whose band holds the outcome (a band includes its lower edge, not its upper); for a range outcome, a band it overlaps, with the reason in reasons.\" |\n   131\t| `reference_unavailable` | \"Forecast only, when no figure is marked as its reference: why.\" |\n   132\t| `reasons`, `why`, `cites`, `pushes`, `theme_pushes` | unchanged; `why`: \"Unresolved only: why the evidence cannot support a forecast.\" |\n   133\t\n   134\t**The family header (user message)**\n   135\t- \"Relations: v8 is part of v4: for each of FY2027 Q3, FY2027 Q4, FY2027, the part's forecast figure may not exceed the whole's, and\n   136\t  a sum or difference never combines the two.\"\n   137\t- \"Shared quantities, one forecast figure each, through which every figure that uses the quantity takes it: …\"\n   138\t- \"Outcome keys (population | measure | scope | period), in USD bn, to be used exactly: …\"\n   139\t\n   140\t**The system text:** one change. \"a quantity the family shares has one forecast per scenario\" becomes \"a quantity the family shares\n   141\thas one forecast\". Every other sentence is unchanged.\n   142\t\n   143\t## 4. Build\n   144\t\n   145\t- **New files.** `calc_small.py` holds `from_answer(data, family)` (wire to internal, with S6/S7 marker errors), `check`,\n   146\t  `publish_decision`, `evaluate`, `upstream_of` and `key`, and returns `{errors, recorded, published}` as `calc_check` does.\n   147\t  `render_v13.v13s_schema` builds the schema; `judging-v13s.txt` holds the system text.\n   148\t- **The plan.** `paid_gate.item` takes a format. A v13s plan (`paid-plan-v13s.json`, pinned) uses `calc_small`. A plan without a\n   149\t  format uses `calc_check` and `strip`, so the old run's `results.json` reproduces byte for byte on a copy.\n   150\t- **Rehearsal and mutants.** The rehearsal takes the plan path. Its stub answers are written in v13s. Each rule S1–S8 gets a mutant.\n   151\t- **Size.** Characters and estimated tokens for the whole request, before and after, per item. The schema is expected to be smaller\n   152\t  than today's (17 figure fields against 23, shorter descriptions than v2).\n   153\t\n   154\t**Value × reader.**\n   155\t- `from_answer`'s output is read by `check`, `publish_decision`, `merge`, `card_view` and `normalise`. It uses the internal names\n   156\t  those readers read (`evidence`, `inputs`, `rests_on`, `outcome`, `reference`), and the dropped keys never appear.\n   157\t- `merge`'s unification of a shared forecast uses `evaluate`'s values with no bound.\n   158\t- The reader brief is unchanged. Its `deciding_gap` question is where readers judge the recorded conversions and estimates.\n   159\t\n   160\t**State × event:** unchanged from D731. A refusal is retried once, diagnostic only; the first attempt is scored.\n   161\t\n   162\t## 5. The $0 blind test (registered; REPAIR-DESIGN.md §5 with rounds 51's fixes)\n   163\t\n   164\t**Inputs.** Each case's archive, call, question, ladder and unit are registered, and the build refuses a heading that differs.\n   165\t\n   166\t| Case | Archive / call | Key | Ladder edges ($bn) | Role |\n   167\t|---|---|---|---|---|\n   168\t| P (joint), P-v4, P-v8 (separate) | old-1 v4 8810, v8 8816 | NVIDIA revenue company FY2027; NVIDIA revenue Data Center FY2027 | 431.2/392/352.8/313.6; 400/350/300/250 | the pair; 79 quotes absent from the gate |\n   169\t| S | old-3 v6 9043 | four largest AI hyperscalers, data-center capex, combined, CY2026 | 500/600/700/800 | fresh: 41 of 50 quotes absent from the gate |\n   170\t| O | old-2 v29 8507 | NVIDIA equity investment commitments company end of FY2027 (the fiscal year-end balance the annual report publishes) | 25/50/75/100 | control |\n   171\t| E | old-3 v41 9071 | NVIDIA revenue Vera CPU FY2028 | 50/40/30/20 | control |\n   172\t\n   173\t**Part A, code, $0.** Each case asserts its intended rule and message. The schema's validity is checked first, so a schema error\n   174\tcannot mask the rule under test.\n   175\t- **A1, correct forms.** Each passes:\n   176\t  - a $4.5 billion ± 3% guidance as two sources with apply_growth ends;\n   177\t  - Q1 + Q2 = H1;\n   178\t  - FY − Q1-Q3 = Q4;\n   179\t  - a year-over-year rate on last year's quarter (recorded);\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_21","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba docs/research/2026-11-22-number-answers/calc_small.py | sed -n '55,205p;230,304p;745,810p'\"","aggregated_output":"    55\tdef parse_number(text):\n    56\t    \"\"\"A quote_number as written: {'unit', 'value'} or {'unit', 'low', 'high'[, 'mid']}; None when it is not one complete form.\"\"\"\n    57\t    text = (text or '').strip()\n    58\t    for form, pattern in _ANCHORED:\n    59\t        m = pattern.match(text)\n    60\t        if not m:\n    61\t            continue\n    62\t        g = m.groups()\n    63\t        if form == 'relative':\n    64\t            mid, rel = _money(g[0], g[1]), _num(g[2])\n    65\t            return {'unit': 'USD bn', 'low': mid * (1 - rel / 100), 'high': mid * (1 + rel / 100), 'mid': mid}\n    66\t        if form == 'range':\n    67\t            if not (g[1] or g[3]):\n    68\t                return None\n    69\t            return {'unit': 'USD bn', 'low': _money(g[0], g[1] or g[3]), 'high': _money(g[2], g[3] or g[1])}\n    70\t        if form == 'percent_range':\n    71\t            return {'unit': '%', 'low': _num(g[0]), 'high': _num(g[1])}\n    72\t        if form == 'money':\n    73\t            return {'unit': 'USD bn', 'value': (-1.0 if g[0] else 1.0) * _money(g[1], g[2])}\n    74\t        if form == 'percent':\n    75\t            return {'unit': '%', 'value': (-1.0 if g[0] else 1.0) * _num(g[1])}\n    76\t        return {'unit': 'x', 'value': 3.0 if g[0].lower() == 'triple' else 2.0}\n    77\t    return None\n    78\t\n    79\t\n    80\t_CHANGE = re.compile(r'(?<!rang)(?<!range)(?<!ranges)(?<!ranging)\\bfrom\\s*$', re.I)\n    81\t\n    82\t\n    83\tdef expressions(text):\n    84\t    \"\"\"[54] Every complete numeric expression in a quote, as (start, end), longest forms first and never overlapping. [D740] An\n    85\t    'X to Y' written after 'from' (not 'range(s) from' or 'ranging from') is a change between two values, so its two amounts are\n    86\t    separate expressions.\"\"\"\n    87\t    taken = []\n    88\t    for form, pattern in _SCAN:\n    89\t        for m in pattern.finditer(text):\n    90\t            if form == 'range' and re.search(r'\\bto\\b', m.group(0), re.I) and not m.group(0).lower().startswith('between'):\n    91\t                before = text[:m.start()].rstrip().lower()\n    92\t                if before.endswith('from') and not re.search(r'\\b(range|ranges|ranged|ranging)\\s+from$', before):\n    93\t                    continue\n    94\t            if not any(m.start() < e and s < m.end() for s, e in taken):\n    95\t                taken.append((m.start(), m.end()))\n    96\t    return sorted(taken)\n    97\t\n    98\t\n    99\tdef _key(what):\n   100\t    return (what['population'], what['measure'], what['scope'], what['period'])\n   101\t\n   102\t\n   103\tdef _quantity(what):\n   104\t    return (what['population'], what['measure'], what['scope'])\n   105\t\n   106\t\n   107\tdef _same(a, b):\n   108\t    return a is not None and b is not None and abs(a - b) <= 1e-9 * max(1.0, abs(a), abs(b))\n   109\t\n   110\t\n   111\tdef _close(declared, expected, unit):\n   112\t    return abs(declared - expected) <= max(0.005 * abs(expected), 0.05 if unit == '%' else 0.1)\n   113\t\n   114\t\n   115\tdef _is_range(fig):\n   116\t    return isinstance(fig.get('low'), (int, float)) and isinstance(fig.get('high'), (int, float))\n   117\t\n   118\t\n   119\tdef _interval(fig):\n   120\t    if _is_range(fig):\n   121\t        return float(fig['low']), float(fig['high'])\n   122\t    return float(fig['value']), float(fig['value'])\n   123\t\n   124\t\n   125\tdef _period(text):\n   126\t    m = _PERIOD.match((text or '').strip())\n   127\t    if not m:\n   128\t        return None\n   129\t    year, part = m.group(1) + m.group(2), m.group(3)\n   130\t    if part is None:\n   131\t        quarters = {1, 2, 3, 4}\n   132\t    elif part.startswith('H'):\n   133\t        quarters = {1, 2} if part == 'H1' else {3, 4}\n   134\t    else:\n   135\t        a, _, b = part.partition('-')\n   136\t        lo, hi = int(a[1]), int((b or a)[1])\n   137\t        if lo > hi:\n   138\t            return None\n   139\t        quarters = set(range(lo, hi + 1))\n   140\t    return year, quarters\n   141\t\n   142\t\n   143\tdef _overlap(p1, p2):\n   144\t    \"\"\"[54] Two periods overlap: the same label, or parsed fiscal periods of one year that share a quarter.\"\"\"\n   145\t    if p1 == p2:\n   146\t        return True\n   147\t    a, b = _period(p1), _period(p2)\n   148\t    return bool(a and b and a[0] == b[0] and a[1] & b[1])\n   149\t\n   150\t\n   151\t# ---------- decoding the wire shape ----------\n   152\tFIGURE_FIELDS = ('id', 'what', 'kind', 'basis', 'value', 'low', 'high', 'unit', 'quote_number', 'qualifier', 'inputs', 'operation',\n   153\t                 'basis_text', 'rests_on')\n   154\t\n   155\t\n   156\tdef _text(value):\n   157\t    return value if isinstance(value, str) and value.strip() else None\n   158\t\n   159\t\n   160\tdef from_answer(data, family):\n   161\t    \"\"\"The v13s wire answer as the internal shape: `evidence_id` becomes `evidence`; the markers become each answer's `outcome` and\n   162\t    `reference`; marker errors go in `decode_errors` (S5, S6, S7). An empty string counts as absent.\"\"\"\n   163\t    errors, figures, outcome_for, reference_for = [], [], {}, {}\n   164\t    members = family['members']\n   165\t    for f in data.get('figures') or []:\n   166\t        g = {k: f[k] for k in FIGURE_FIELDS if f.get(k) is not None}\n   167\t        if f.get('evidence_id') is not None:\n   168\t            g['evidence'] = f['evidence_id']\n   169\t        for marks, store in (('outcome_for', outcome_for), ('reference_for', reference_for)):\n   170\t            listed = f.get(marks) or []\n   171\t            for v in sorted(set(listed)):\n   172\t                if listed.count(v) > 1:\n   173\t                    errors.append(('S7', f'{f.get(\"id\")}: {marks} lists {v} more than once'))\n   174\t                store.setdefault(v, []).append(f.get('id'))\n   175\t        figures.append(g)\n   176\t    answers = []\n   177\t    for a in data.get('answers') or []:\n   178\t        v = a.get('view_id')\n   179\t        a2 = {k: a[k] for k in ('view_id', 'shape', 'rung', 'reasons', 'cites', 'pushes', 'theme_pushes') if a.get(k) is not None}\n   180\t        if _text(a.get('why')):\n   181\t            a2['why'] = a['why']\n   182\t        if v not in members:\n   183\t            answers.append(a2)\n   184\t            continue\n   185\t        outs, refs, reason = outcome_for.get(v, []), reference_for.get(v, []), _text(a.get('reference_unavailable'))\n   186\t        if a.get('shape') == 'unresolved':\n   187\t            if outs or refs or reason or a.get('rung') is not None or not _text(a.get('why')):\n   188\t                errors.append(('S7', f'{v}: an unresolved answer has why, rung and reference_unavailable null, and no figure marked for it'))\n   189\t        else:\n   190\t            if len(outs) == 1:\n   191\t                a2['outcome'] = outs[0]\n   192\t            else:\n   193\t                errors.append(('S6', f'{v}: {len(outs)} figures are marked as its outcome; exactly one is required'))\n   194\t            if len(refs) == 1 and not reason:\n   195\t                a2['reference'] = {'figure': refs[0]}\n   196\t            elif not refs and reason:\n   197\t                a2['reference'] = {'unavailable': reason}\n   198\t            else:\n   199\t                errors.append(('S5', f'{v}: needs exactly one of a figure marked as its reference or reference_unavailable'))\n   200\t        answers.append(a2)\n   201\t    for v in set(outcome_for) | set(reference_for):\n   202\t        if v not in members:\n   203\t            errors.append(('S7', f'{v} is marked on a figure but is not a member of the family'))\n   204\t    return {'figures': figures, 'answers': answers, 'decode_errors': errors}\n   205\t\n   230\tdef _apply(op, xs):\n   231\t    if op == 'sum':\n   232\t        return sum(xs)\n   233\t    if op == 'difference':\n   234\t        return xs[0] - xs[1]\n   235\t    if op == 'product':\n   236\t        return math.prod(xs)\n   237\t    if op == 'ratio':\n   238\t        return xs[0] / xs[1]\n   239\t    if op == 'share':\n   240\t        return xs[0] * xs[1] / 100.0\n   241\t    if op == 'growth':\n   242\t        return (xs[1] / xs[0] - 1.0) * 100.0\n   243\t    if op == 'apply_growth':\n   244\t        return xs[0] * (1.0 + xs[1] / 100.0)\n   245\t    raise ValueError(op)\n   246\t\n   247\t\n   248\tclass _Calc:\n   249\t    \"\"\"[54] Each figure's value as a function of the ranged figures it rests on through inputs (its range leaves): one uncertain number\n   250\t    takes one value on every path, and a range's extremes come from every combination of its leaves' ends (and zero, when a leaf\n   251\t    straddles it).\"\"\"\n   252\t\n   253\t    def __init__(self, figs):\n   254\t        self.figs, self._leaves, self._intervals = figs, {}, {}\n   255\t\n   256\t    def leaves(self, fid):\n   257\t        if fid not in self._leaves:\n   258\t            f = self.figs[fid]\n   259\t            if f.get('kind') == 'computed':\n   260\t                out = set()\n   261\t                for i in f.get('inputs') or []:\n   262\t                    if i in self.figs:\n   263\t                        out |= self.leaves(i)\n   264\t                self._leaves[fid] = out\n   265\t            else:\n   266\t                self._leaves[fid] = {fid} if _is_range(f) else set()\n   267\t        return self._leaves[fid]\n   268\t\n   269\t    def point(self, fid, assign):\n   270\t        f = self.figs[fid]\n   271\t        if f.get('kind') == 'computed':\n   272\t            return _apply(f['operation'], [self.point(i, assign) for i in f['inputs']])\n   273\t        return assign[fid] if fid in assign else float(f['value'])\n   274\t\n   275\t    def choices(self, fid):\n   276\t        lo, hi = _interval(self.figs[fid])\n   277\t        return sorted({lo, hi} | ({0.0} if lo < 0 < hi else set()))\n   278\t\n   279\t    def assignments(self, ids):\n   280\t        ids = sorted(ids)\n   281\t        for combo in itertools.product(*[self.choices(i) for i in ids]):\n   282\t            yield dict(zip(ids, combo))\n   283\t\n   284\t    def interval(self, fid):\n   285\t        \"\"\"(low, high), or None when it cannot be evaluated.\"\"\"\n   286\t        if fid in self._intervals:\n   287\t            return self._intervals[fid]\n   288\t        f = self.figs[fid]\n   289\t        try:\n   290\t            if f.get('kind') != 'computed':\n   291\t                result = _interval(f)\n   292\t            else:\n   293\t                leaves = self.leaves(fid)\n   294\t                if len(leaves) > MAX_RANGE_LEAVES:\n   295\t                    result = None\n   296\t                else:\n   297\t                    values = [self.point(fid, a) for a in self.assignments(leaves)]\n   298\t                    result = (min(values), max(values)) if all(math.isfinite(v) for v in values) else None\n   299\t        except (ZeroDivisionError, OverflowError, ValueError, KeyError, TypeError, RecursionError):\n   300\t            result = None\n   301\t        self._intervals[fid] = result\n   302\t        return result\n   303\t\n   304\t    def fits(self, part, whole):\n   745\t                recorded.append({'type': 'conversion between quantities', 'figure': fid})\n   746\t            if f['operation'] in ('apply_growth', 'product') and any(i['what']['period'] != f['what']['period'] for i in money):\n   747\t                recorded.append({'type': 'carried across periods', 'figure': fid})\n   748\t            if f['operation'] == 'sum' and any({ps['part'], ps['whole']} <= {i['what']['scope'] for i in money} for ps in scopes):\n   749\t                recorded.append({'type': 'part and whole added for different periods', 'figure': fid})\n   750\t        elif (f.get('qualifier') or 'none') != 'none':\n   751\t            recorded.append({'type': 'qualified source', 'figure': fid, 'qualifier': f['qualifier']})\n   752\t    used = set()\n   753\t    for out in outcomes.values():\n   754\t        used |= {out} | _beneath(out, figs)\n   755\t    by_key = {}\n   756\t    for fid in used:\n   757\t        by_key.setdefault(_key(figs[fid]['what']), []).append(fid)\n   758\t    for k, ids in sorted(by_key.items()):\n   759\t        if len(ids) > 1:\n   760\t            recorded.append({'type': 'one quantity, several figures', 'figure': sorted(ids)[0], 'figures': sorted(ids), 'what': list(k)})\n   761\t    return recorded\n   762\t\n   763\t\n   764\tdef check(family, passages, calc):\n   765\t    figs = {f['id']: f for f in calc['figures'] if isinstance(f.get('id'), str)}\n   766\t    errors = _structure(family, passages, calc, figs)\n   767\t    if errors:\n   768\t        return {'errors': errors, 'recorded': [], 'published': {}}\n   769\t    engine = _Calc(figs)\n   770\t    errors = _sources(passages, figs) + _arithmetic(figs, engine)\n   771\t    for f in figs.values():\n   772\t        if engine.interval(f['id']) is None and not any(e[1].startswith(f['id'] + ':') for e in errors):\n   773\t            errors.append(('S2', f'{f[\"id\"]}: the value cannot be evaluated'))\n   774\t    if errors:\n   775\t        return {'errors': errors, 'recorded': [], 'published': {}}\n   776\t    answer_errors, outcomes = _answers(family, figs, engine, calc['answers'])\n   777\t    errors = answer_errors + _shared(family, figs, outcomes) + _part_whole(family, figs, engine, outcomes) + _sums(family, figs)\n   778\t    published = {v: list(engine.interval(o)) + [None] for v, o in outcomes.items()}\n   779\t    return {'errors': errors, 'recorded': _recorded(family, figs, outcomes), 'published': published}\n   780\t\n   781\t\n   782\tdef publish_decision(family, calc, result):\n   783\t    \"\"\"'refused' when a check fails; 'held' when a member is unresolved and a declared relation joins it to another member; else\n   784\t    'publish' (an unresolved member is shown as unresolved).\"\"\"\n   785\t    if result['errors']:\n   786\t        return 'refused'\n   787\t    unresolved = {a['view_id'] for a in calc['answers'] if a.get('shape') == 'unresolved'}\n   788\t    for rel in family.get('relations', []):\n   789\t        ends = {rel.get('part'), rel.get('whole'), rel.get('later'), rel.get('earlier')} - {None}\n   790\t        if ends & unresolved and ends - unresolved:\n   791\t            return 'held'\n   792\t    return 'publish'\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_22","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba docs/research/2026-11-22-number-answers/small_cases.py | sed -n '1,150p;300,425p'\"","aggregated_output":"     1\t\"\"\"The v13s small format's Part A cases (SMALL-DESIGN.md §5 [52], D738): A1 correct forms pass, A2 defects are refused by their named\n     2\trule (or recorded, where D738 says so), A3 Luna's observed mistakes are impossible under the schema or refused by their stated rule.\n     3\tEach case runs the real path: the v13s schema (model.check_schema), calc_small.from_answer, calc_small.check. $0.\n     4\tUsage: python3 small_cases.py   (prints one line per case; exit 1 on any failure).\"\"\"\n     5\timport copy\n     6\timport json\n     7\timport os\n     8\timport sys\n     9\tfrom pathlib import Path\n    10\t\n    11\tHERE = Path(__file__).resolve().parent\n    12\tREPO = HERE.parents[2]\n    13\tsys.path.insert(0, str(HERE))\n    14\tsys.path.insert(0, str(REPO / 'src'))\n    15\tif os.environ.get('CALC_SMALL_DIR'):                     # small_mutants.py: a mutated calc_small.py on a scratch copy\n    16\t    sys.path.insert(0, os.environ['CALC_SMALL_DIR'])\n    17\timport calc_small as cs  # noqa: E402\n    18\timport render_v13 as rv  # noqa: E402\n    19\tfrom hivemind import model  # noqa: E402\n    20\t\n    21\tFIELDS = ['id', 'what', 'kind', 'basis', 'value', 'low', 'high', 'unit', 'evidence_id', 'quote_number', 'qualifier', 'inputs', 'operation',\n    22\t          'basis_text', 'rests_on', 'outcome_for', 'reference_for']\n    23\tPASSAGES = {\n    24\t    'e1': 'First-quarter revenue was $81.6 billion, up 85% from a year ago.',\n    25\t    'e2': 'Second-quarter revenue was $96.2 billion.',\n    26\t    'e3': 'Revenue is expected to be $108.0 billion, plus or minus 2%.',\n    27\t    'e4': 'Data Center revenue was $75.3 billion in the first quarter.',\n    28\t    'e5': 'Data Center revenue was $89.0 billion in the second quarter, 92.5% of total revenue.',\n    29\t    'e6': 'Analysts expect full-year revenue of $411 billion.',\n    30\t    'e7': 'Data center revenue will be well over $300 billion next year.',\n    31\t    'e8': 'and 65% growth in Q4.',\n    32\t    'e9': 'Fourth-quarter revenue a year ago was $68.1 billion.',\n    33\t    'e10': 'the company not only still expects $20 billion in sales, but roughly twice that number next year.',\n    34\t    'e11': 'A plant costing $300 million or more is planned.',\n    35\t    'e12': 'Margins moved -3% in the period.',\n    36\t    'e13': 'Combined spending reached $1.2 trillion.',\n    37\t    'e14': 'The bonds total US$10 billion; sales were $96.2bn; the range is between $105.84 billion and $110.16 billion.',\n    38\t    'e15': 'The program costs €5 billion.',\n    39\t    'e16': 'Spending will not be over $300 billion.',\n    40\t    'e17': 'Unit prices rose 12% and volumes doubled.',\n    41\t    'e18': 'Spending is tracked at $745 billion.',\n    42\t    'e19': 'Another estimate puts spending at $760 billion.',\n    43\t    'e20': 'The share is between 72% and 73% of the total.',\n    44\t    'e21': 'The fund may invest as much as $10 billion.',\n    45\t    'e22': 'Gross margin was 40% and the segment took 25% of it.',\n    46\t    'e23': 'Analysts believe the market will grow fivefold between this year and 2030, from $35 billion to $170 billion.',\n    47\t    'e24': 'Capex guidance ranges from $195 billion to $205 billion.',\n    48\t    'e25': 'Analysts expect the segment to take 92% of revenue this year.',\n    49\t}\n    50\tPASSAGES = {k: {'text': v, 'speaker': 'an outlet'} for k, v in PASSAGES.items()}\n    51\tEVIDENCE = sorted(PASSAGES)\n    52\t\n    53\t\n    54\tdef W(scope, period, measure='revenue', population='NVIDIA'):\n    55\t    return {'population': population, 'measure': measure, 'scope': scope, 'period': period}\n    56\t\n    57\t\n    58\tPAIR = {'members': {'v4': {'what': W('company', 'FY2027'), 'unit': 'USD bn',\n    59\t                           'bands': [[431.2, None], [392.0, 431.2], [352.8, 392.0], [313.6, 352.8], [None, 313.6]]},\n    60\t                    'v8': {'what': W('Data Center', 'FY2027'), 'unit': 'USD bn',\n    61\t                           'bands': [[400.0, None], [350.0, 400.0], [300.0, 350.0], [250.0, 300.0], [None, 250.0]]}},\n    62\t        'relations': [{'type': 'part_of', 'part': 'v8', 'whole': 'v4'}],\n    63\t        'shared': [W('company', 'FY2027 Q3'), W('company', 'FY2027 Q4')],\n    64\t        'compare_periods': ['FY2027 Q3', 'FY2027 Q4', 'FY2027'],\n    65\t        'part_scopes': [{'population': 'NVIDIA', 'measure': 'revenue', 'part': 'Data Center', 'whole': 'company'}]}\n    66\t\n    67\t\n    68\tdef F(id, what, kind, basis, unit, **kw):\n    69\t    f = {k: None for k in FIELDS}\n    70\t    f.update(id=id, what=what, kind=kind, basis=basis, unit=unit, outcome_for=[], reference_for=[])\n    71\t    f.update(kw)\n    72\t    return f\n    73\t\n    74\t\n    75\tdef A(view, shape='forecast', rung=None, reference_unavailable=None, why=None):\n    76\t    return {'view_id': view, 'shape': shape, 'rung': rung, 'reference_unavailable': reference_unavailable, 'reasons': 'case',\n    77\t            'why': why, 'cites': [], 'pushes': [], 'theme_pushes': []}\n    78\t\n    79\t\n    80\tdef base_pair():\n    81\t    \"\"\"A correct joint answer: company quarters, one shared Q3/Q4 forecast, Data Center quarters through share, a consensus reference.\"\"\"\n    82\t    figs = [\n    83\t        F('F1', W('company', 'FY2027 Q1'), 'source', 'reported', 'USD bn', value=81.6, evidence_id='e1', quote_number='$81.6 billion', qualifier='none'),\n    84\t        F('F2', W('company', 'FY2027 Q2'), 'source', 'reported', 'USD bn', value=96.2, evidence_id='e2', quote_number='$96.2 billion', qualifier='none'),\n    85\t        F('F3', W('company', 'FY2027 Q3'), 'source', 'guidance', 'USD bn', value=108.0, evidence_id='e3',\n    86\t          quote_number='$108.0 billion, plus or minus 2%', qualifier='none'),\n    87\t        F('F4', W('company', 'FY2027 Q3'), 'estimate', 'forecast', 'USD bn', value=110.0, basis_text='a small beat on guidance', rests_on=['F3']),\n    88\t        F('F5', W('company', 'FY2027 Q4'), 'estimate', 'forecast', 'USD bn', value=115.0, basis_text='growth continues', rests_on=['F4']),\n    89\t        F('F6', W('company', 'FY2027'), 'computed', 'forecast', 'USD bn', value=402.8, inputs=['F1', 'F2', 'F4', 'F5'], operation='sum',\n    90\t          outcome_for=['v4']),\n    91\t        F('F7', W('Data Center', 'FY2027 Q1'), 'source', 'reported', 'USD bn', value=75.3, evidence_id='e4', quote_number='$75.3 billion', qualifier='none'),\n    92\t        F('F8', W('Data Center', 'FY2027 Q2'), 'source', 'reported', 'USD bn', value=89.0, evidence_id='e5', quote_number='$89.0 billion', qualifier='none'),\n    93\t        F('F9', W('Data Center', 'FY2027 Q2', measure='share of revenue'), 'source', 'reported', '%', value=92.5, evidence_id='e5',\n    94\t          quote_number='92.5%', qualifier='none'),\n    95\t        F('F10', W('Data Center', 'FY2027 Q3'), 'computed', 'forecast', 'USD bn', value=101.75, inputs=['F4', 'F9'], operation='share'),\n    96\t        F('F11', W('Data Center', 'FY2027 Q4'), 'computed', 'forecast', 'USD bn', value=106.375, inputs=['F5', 'F9'], operation='share'),\n    97\t        F('F12', W('Data Center', 'FY2027'), 'computed', 'forecast', 'USD bn', value=372.425, inputs=['F7', 'F8', 'F10', 'F11'], operation='sum',\n    98\t          outcome_for=['v8']),\n    99\t        F('F13', W('company', 'FY2027'), 'source', 'consensus', 'USD bn', value=411.0, evidence_id='e6', quote_number='$411 billion',\n   100\t          qualifier='none', reference_for=['v4']),\n   101\t    ]\n   102\t    return {'figures': figs, 'answers': [A('v4', rung=2), A('v8', rung=2, reference_unavailable='no market figure for this segment')]}\n   103\t\n   104\t\n   105\tdef single(what, bands=((None, None),)):\n   106\t    return {'members': {'s': {'what': what, 'unit': 'USD bn', 'bands': [list(b) for b in bands]}}, 'relations': [], 'shared': [],\n   107\t            'compare_periods': [], 'part_scopes': []}\n   108\t\n   109\t\n   110\tdef one(figs, rung=1, family=None, reference_unavailable='none shown'):\n   111\t    fam = family or single(figs[-1]['what'], ((None, None),))\n   112\t    return {'figures': figs, 'answers': [A('s', rung=rung, reference_unavailable=reference_unavailable)]}, fam\n   113\t\n   114\t\n   115\tdef run(answer, family, passages=PASSAGES):\n   116\t    members = sorted(family['members'])\n   117\t    schema = rv.v13s_schema(members, EVIDENCE, [])\n   118\t    schema_errors = model.check_schema(answer, schema)\n   119\t    if schema_errors:\n   120\t        return {'schema': schema_errors}\n   121\t    calc = cs.from_answer(answer, family)\n   122\t    return cs.check(family, passages, calc)\n   123\t\n   124\t\n   125\tdef fig(answer, fid):\n   126\t    return next(f for f in answer['figures'] if f['id'] == fid)\n   127\t\n   128\t\n   129\tCASES = []\n   130\t\n   131\t\n   132\tMESSAGES = {}\n   133\t\n   134\t\n   135\tdef case(group, name, expect, recorded=None, message=None):\n   136\t    def wrap(build):\n   137\t        CASES.append((group, name, expect, recorded, build))\n   138\t        if message:\n   139\t            MESSAGES[name] = message                     # the intended refusal's own words, where another rule could also refuse\n   140\t        return build\n   141\t    return wrap\n   142\t\n   143\t\n   144\t# ---------- A1: correct forms pass ----------\n   145\t@case('A1', 'the base joint answer', 'pass')\n   146\tdef _():\n   147\t    return base_pair(), PAIR\n   148\t\n   149\t\n   150\t@case('A1', '$108.0B ± 2% as a range (low and high)', 'pass')\n   300\t\n   301\t\n   302\t@case('A1', '12% × 2x = 24%', 'pass')\n   303\tdef _():\n   304\t    figs = [F('P', W('unit', 'FY2027', measure='price change'), 'source', 'reported', '%', value=12.0, evidence_id='e17', quote_number='12%', qualifier='none'),\n   305\t            F('X', W('unit', 'FY2027', measure='factor'), 'estimate', 'forecast', 'x', value=2.0, basis_text='two steps'),\n   306\t            F('Q', W('unit', 'FY2027', measure='price change'), 'computed', 'forecast', '%', value=24.0, inputs=['P', 'X'], operation='product'),\n   307\t            F('O', W('company', 'FY2027'), 'estimate', 'forecast', 'USD bn', value=10.0, basis_text='x', rests_on=['Q'], outcome_for=['s'])]\n   308\t    return one(figs)\n   309\t\n   310\t\n   311\t@case('A1', 'US$10 billion, $96.2bn, a written range', 'pass')\n   312\tdef _():\n   313\t    figs = [F('A1', W('bonds', 'FY2027', measure='size'), 'source', 'reported', 'USD bn', value=10.0, evidence_id='e14', quote_number='US$10 billion', qualifier='none'),\n   314\t            F('A2', W('company', 'FY2027 Q2'), 'source', 'reported', 'USD bn', value=96.2, evidence_id='e14', quote_number='$96.2bn', qualifier='none'),\n   315\t            F('A3', W('company', 'FY2027 Q3'), 'source', 'guidance', 'USD bn', low=105.84, high=110.16, evidence_id='e14',\n   316\t              quote_number='between $105.84 billion and $110.16 billion', qualifier='none'),\n   317\t            F('O', W('company', 'FY2027 Q3'), 'computed', 'forecast', 'USD bn', value=108.0, inputs=['A3', 'A3'], operation='sum'),\n   318\t            ]\n   319\t    figs[-1].update(inputs=['A3'], operation='sum')\n   320\t    figs[-1].update(kind='estimate', inputs=None, operation=None, basis_text='the midpoint', rests_on=['A3'], outcome_for=['s'])\n   321\t    return one(figs)\n   322\t\n   323\t\n   324\t@case('A1', 'a point Data Center forecast beside a company range (lowest against highest)', 'pass')\n   325\tdef _():\n   326\t    a = base_pair()\n   327\t    fig(a, 'F4').update(value=None, low=105.84, high=110.16)\n   328\t    fig(a, 'F10').update(kind='estimate', basis_text='segment stays near its mix', inputs=None, operation=None, value=100.0, rests_on=['F4'])\n   329\t    fig(a, 'F6').update(value=None, low=398.64, high=402.96)\n   330\t    fig(a, 'F12').update(value=370.675)\n   331\t    return a, PAIR\n   332\t\n   333\t\n   334\t@case('A1', 'a final range estimate resting on a computed point of the same quantity', 'pass', recorded='one quantity, several figures')\n   335\tdef _():\n   336\t    a = base_pair()\n   337\t    fig(a, 'F12').update(outcome_for=[])                 # the computed point keeps basis forecast: the final range is the value adopted\n   338\t    a['figures'].append(F('R', W('Data Center', 'FY2027'), 'estimate', 'forecast', 'USD bn', low=360.0, high=385.0, basis_text='a range around it',\n   339\t                          rests_on=['F12'], outcome_for=['v8']))\n   340\t    return a, PAIR\n   341\t\n   342\t\n   343\t@case('A1', 'two outside estimates averaged into one starting point', 'pass')\n   344\tdef _():\n   345\t    figs = [F('S1', W('four companies', 'CY2026', measure='capex'), 'source', 'third_party', 'USD bn', value=745.0, evidence_id='e18', quote_number='$745 billion', qualifier='none'),\n   346\t            F('S2', W('four companies', 'CY2026', measure='capex'), 'source', 'third_party', 'USD bn', value=760.0, evidence_id='e19', quote_number='$760 billion', qualifier='none'),\n   347\t            F('T', W('four companies', 'CY2026', measure='capex, two sources'), 'computed', 'third_party', 'USD bn', value=1505.0, inputs=['S1', 'S2'], operation='sum'),\n   348\t            F('H', W('four companies', 'CY2026', measure='capex'), 'computed', 'forecast', 'USD bn', value=752.5, inputs=['T', 'D'], operation='ratio'),\n   349\t            F('D', W('four companies', 'CY2026', measure='divisor'), 'estimate', 'forecast', 'x', value=2.0, basis_text='two sources'),\n   350\t            F('O', W('four companies', 'CY2026', measure='capex'), 'estimate', 'forecast', 'USD bn', value=752.5, basis_text='the average', rests_on=['H'], outcome_for=['s'])]\n   351\t    figs[3]['basis'] = 'third_party'\n   352\t    return one(figs)\n   353\t\n   354\t\n   355\t@case('A1', 'the remainder: company − Data Center = the rest', 'pass')\n   356\tdef _():\n   357\t    a = base_pair()\n   358\t    a['figures'].append(F('REST', W('other', 'FY2027'), 'computed', 'forecast', 'USD bn', value=30.375, inputs=['F6', 'F12'], operation='difference'))\n   359\t    return a, PAIR\n   360\t\n   361\t\n   362\t# ---------- A2: defects are refused by their named rule ----------\n   363\tdef defect(name, rule, mutate, family=PAIR, base=base_pair, recorded=None):\n   364\t    @case('A2', name, rule, recorded)\n   365\t    def _():\n   366\t        a = base()\n   367\t        mutate(a)\n   368\t        return a, family\n   369\t\n   370\t\n   371\tdefect('108.5 for \"$108.0 billion\" (S1)', 'S1', lambda a: fig(a, 'F3').update(value=108.5))\n   372\tdefect('a qualifier the quote does not write (S1)', 'S1', lambda a: fig(a, 'F1').update(qualifier='about'))\n   373\tdefect('a number not written in the quote (S1)', 'S1', lambda a: fig(a, 'F1').update(quote_number='$81.62 billion', value=81.62))\n   374\tdefect('\"± 2%\" read as a positive point 110.16 (S1)', 'S1', lambda a: fig(a, 'F3').update(value=110.16))\n   375\tdefect('a plain wrong sum (S2)', 'S2', lambda a: fig(a, 'F6').update(value=410.0))\n   376\tdefect('money × % through product (S2)', 'S2', lambda a: fig(a, 'F10').update(operation='product'))\n   377\tdefect('a three-input difference (S7)', 'S7', lambda a: fig(a, 'F6').update(operation='difference'))\n   378\tdefect('a part forecast above the whole for Q3 (S3)', 'S3', lambda a: (fig(a, 'F9').update(value=92.5), fig(a, 'F10').update(\n   379\t    kind='estimate', basis_text='segment', inputs=None, operation=None, value=112.0, rests_on=['F4']), fig(a, 'F12').update(value=382.675)))\n   380\tdefect('a part outcome above the whole outcome (S3)', 'S3', lambda a: (fig(a, 'F12').update(\n   381\t    kind='estimate', basis_text='segment', inputs=None, operation=None, value=405.0, rests_on=['F10']), a['answers'][1].update(rung=1)))\n   382\tdefect('Data Center added into company in one sum (S8)', 'S8', lambda a: a['figures'].append(F(\n   383\t    'BAD', W('company', 'FY2027'), 'computed', 'forecast', 'USD bn', value=775.225, inputs=['F6', 'F12'], operation='sum')))\n   384\tdefect('Q2 + Q3 labelled H1 (S8)', 'S8', lambda a: a['figures'].append(F(\n   385\t    'BAD', W('company', 'FY2027 H1'), 'computed', 'forecast', 'USD bn', value=206.2, inputs=['F2', 'F4'], operation='sum')))\n   386\tdefect('FY − Q1 labelled Q4 (S8)', 'S8', lambda a: a['figures'].append(F(\n   387\t    'BAD', W('company', 'FY2027 Q4'), 'computed', 'consensus', 'USD bn', value=329.4, inputs=['F13', 'F1'], operation='difference')))\n   388\tdefect('two forecasts of one shared quarter, both used (S4)', 'S4', lambda a: (a['figures'].append(F(\n   389\t    'BAD', W('company', 'FY2027 Q3'), 'estimate', 'forecast', 'USD bn', value=112.0, basis_text='another view')),\n   390\t    fig(a, 'F10').update(inputs=['BAD', 'F9'], value=103.6), fig(a, 'F12').update(value=374.275)))\n   391\tdefect('an unused second forecast of a quarter is not counted (passes)', 'pass', lambda a: a['figures'].append(F(\n   392\t    'ALT', W('company', 'FY2027 Q3'), 'estimate', 'forecast', 'USD bn', value=112.0, basis_text='an alternative not used')))\n   393\tdefect('Q3 guidance used directly beside the Q3 forecast (S4)', 'S4', lambda a: fig(a, 'F10').update(inputs=['F3', 'F9'], value=99.9))\n   394\tdefect('two Data Center Q4 forecasts, both used (S4)', 'S4', lambda a: (a['figures'].append(F(\n   395\t    'BAD', W('Data Center', 'FY2027 Q4'), 'estimate', 'forecast', 'USD bn', value=104.0, basis_text='another view')),\n   396\t    fig(a, 'F12').update(outcome_for=[]), a['figures'].append(F('X', W('Data Center', 'FY2027'), 'estimate', 'forecast', 'USD bn', value=372.0,\n   397\t                                                                basis_text='near the sum', rests_on=['F12', 'BAD'], outcome_for=['v8']))))\n   398\tdefect('an estimate marked as the reference (S5)', 'S5', lambda a: (a['figures'].append(F(\n   399\t    'R8', W('Data Center', 'FY2027'), 'estimate', 'reported', 'USD bn', value=380.0, basis_text='looks like consensus', rests_on=['F13'],\n   400\t    reference_for=['v8'])), a['answers'][1].update(reference_unavailable=None)))\n   401\tdefect('a computed reference with basis forecast (S5)', 'S5', lambda a: (a['figures'].append(F(\n   402\t    'SH', W('Data Center', 'FY2027', measure='share of revenue'), 'source', 'consensus', '%', value=92.0, evidence_id='e25', quote_number='92%',\n   403\t    qualifier='none')), a['figures'].append(F(\n   404\t    'R8', W('Data Center', 'FY2027 consensus view'), 'computed', 'forecast', 'USD bn', value=378.12, inputs=['F13', 'SH'], operation='share',\n   405\t    reference_for=['v8'])), a['answers'][1].update(reference_unavailable=None)))      # an outside full-year share: only the forecast basis refuses it\n   406\tdefect('a reference resting on an estimate (S5)', 'S5', lambda a: (a['figures'].append(F(\n   407\t    'R8', W('Data Center', 'FY2027'), 'computed', 'consensus', 'USD bn', value=373.45, inputs=['F13', 'M'], operation='share',\n   408\t    reference_for=['v8'])), a['figures'].append(F('M', W('Data Center', 'FY2027', measure='mix'), 'estimate', 'forecast', '%', value=90.86,\n   409\t                                                    basis_text='mix')), a['answers'][1].update(reference_unavailable=None)))\n   410\tdefect('a reported-only reference (S5)', 'S5', lambda a: (fig(a, 'F1').update(reference_for=['v8']), a['answers'][1].update(reference_unavailable=None)))\n   411\tdefect('both a reference figure and a reason (S5)', 'S5', lambda a: a['answers'][0].update(reference_unavailable='also none'))\n   412\tdefect('neither a reference figure nor a reason (S5)', 'S5', lambda a: a['answers'][1].update(reference_unavailable=None))\n   413\tdefect('no outcome marker (S6)', 'S6', lambda a: fig(a, 'F12').update(outcome_for=[]))\n   414\tdefect('two outcome markers (S6)', 'S6', lambda a: fig(a, 'F11').update(outcome_for=['v8']))\n   415\tdefect('a marker on an unresolved member (S7)', 'S7', lambda a: a['answers'][1].update(shape='unresolved', why='none', rung=None,\n   416\t                                                                                     reference_unavailable=None))\n   417\tdefect('an outcome key mismatch (S6)', 'S6', lambda a: fig(a, 'F12').update(what=W('Data Center', 'FY2027', population='NVIDIA Corp')))\n   418\tdefect('a source as the outcome (S6)', 'S6', lambda a: (fig(a, 'F12').update(outcome_for=[]), a['figures'].append(F(\n   419\t    'SRC', W('Data Center', 'FY2027'), 'source', 'third_party', 'USD bn', value=300.0, evidence_id='e7', quote_number='$300 billion',\n   420\t    qualifier='over', outcome_for=['v8'])), a['answers'][1].update(rung=3)))\n   421\tdefect('a share above 100% (S2)', 'S2', lambda a: (fig(a, 'F9').update(kind='estimate', basis='forecast', evidence_id=None, quote_number=None,\n   422\t    qualifier=None, value=110.0, basis_text='mix'), fig(a, 'F10').update(value=121.0), fig(a, 'F11').update(value=126.5),\n   423\t    fig(a, 'F12').update(value=411.8)))\n   424\tdefect('a rung outside the ladder (S6)', 'S6', lambda a: a['answers'][0].update(rung=9))\n   425\tdefect('a rung whose band misses the outcome (S6)', 'S6', lambda a: a['answers'][0].update(rung=1))\n","exit_code":0,"status":"completed"}}
