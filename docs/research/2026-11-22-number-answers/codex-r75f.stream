{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc 'nl -ba docs/research/2026-11-22-number-answers/release_check.py'","aggregated_output":"     1\t\"\"\"The $0 release check of RELEASE-BUILD.md §7 on four stored stores, read-only (a closing switch is added only to a copy).\n     2\t\n     3\t    python3 docs/research/2026-11-22-number-answers/release_check.py <new output folder>\n     4\t\n     5\tBuilds each store's package with the real command, then: the decisive acceptance case on old-1; old-1/v8; the two known Yes/No leaks\n     6\tat their own days; an unchanged event control; a closing switch on a copy; the diagnostic search of every forbidden stored string in\n     7\tevery decoded package field; the size and speed budgets against `bundle.library` on the same store. Writes results.json there.\"\"\"\n     8\timport hashlib\n     9\timport json\n    10\timport shutil\n    11\timport sqlite3\n    12\timport subprocess\n    13\timport sys\n    14\timport time\n    15\tfrom pathlib import Path\n    16\t\n    17\tREPO = Path(__file__).resolve().parents[3]\n    18\tsys.path.insert(0, str(REPO / 'src'))\n    19\tfrom hivemind import bundle, release, service  # noqa: E402\n    20\tfrom hivemind.views import store  # noqa: E402\n    21\t\n    22\tCOMMAND = REPO / 'scripts' / 'release_build.py'\n    23\tMARKER = 'Forecast unavailable'                     # D726's words, written here, not read from the module under test\n    24\tEXPECTED = {   # each store's default day, classes and evidence, fixed before this run from the reviewed first run (councils 75–75e reproduced them)\n    25\t    'old-1': ('2026-09-20', {'number': 19, 'event': 28, 'yes_no': 0}, 8251),\n    26\t    'old-2': ('2026-09-20', {'number': 17, 'event': 26, 'yes_no': 0}, 6306),\n    27\t    'old-3': ('2026-09-20', {'number': 18, 'event': 31, 'yes_no': 0}, 6659),\n    28\t    'served': ('2026-08-28', {'number': 13, 'event': 55, 'yes_no': 0}, 6461),\n    29\t}\n    30\tJ1580_PREFIX = 'About $390 billion: $164 billion reported in the first half'   # the system's own forecast used as the forged value\n    31\tCLOSING_REASON = 'due 2026-09-20, frozen on 2026-09-20 at rung 2 Bullish'\n    32\tCOMPARISON_ITEMS = REPO / 'poc/data/comparison-2026-11-17/items-comparison.sqlite'\n    33\tSTORES = {\n    34\t    'old-1': (REPO / 'poc/data/comparison-2026-11-17/run/old-1/prod/views.sqlite', COMPARISON_ITEMS),\n    35\t    'old-2': (REPO / 'poc/data/comparison-2026-11-17/run/old-2/prod/views.sqlite', COMPARISON_ITEMS),\n    36\t    'old-3': (REPO / 'poc/data/comparison-2026-11-17/run/old-3/prod/views.sqlite', COMPARISON_ITEMS),\n    37\t    'served': (REPO / 'poc/data/served-2026-10-28-v34-nvda-3m-through-0828/views.sqlite', REPO / 'poc/data/items-nvda-2026-07-01-10-27.sqlite'),\n    38\t}\n    39\t\n    40\t\n    41\tdef build(ledger, items, out, as_of=None):\n    42\t    args = [sys.executable, str(COMMAND), 'build', '--ledger', str(ledger), '--items', str(items), '--out', str(out)] + (['--as-of', as_of] if as_of else [])\n    43\t    result = subprocess.run(args, capture_output=True, text=True, env={'PATH': '/usr/bin:/bin', 'PYTHONDONTWRITEBYTECODE': '1'})\n    44\t    if result.returncode != 0:\n    45\t        raise SystemExit(f'build {out} exited {result.returncode}: {result.stderr}')\n    46\t    return json.loads(out.with_name(out.name + '.report.json').read_text()), release.read_data(out)\n    47\t\n    48\t\n    49\tdef check(ledger, items, package):\n    50\t    views_db, items_db = service.open_ledger(str(ledger)), store.open_read_only(str(items))\n    51\t    try:\n    52\t        return release.check_package(package, views_db, items_db)[0]\n    53\t    finally:\n    54\t        views_db.close()\n    55\t        items_db.close()\n    56\t\n    57\t\n    58\tdef fields(data, manifest=None):\n    59\t    \"\"\"(question id, field path, evidence id, text) for every decoded string of the package: every string value of the data at\n    60\t    every level (ids, classes and the marker included) and of the manifest.\"\"\"\n    61\t    def walk(value, path, question_id, evidence_id):\n    62\t        if isinstance(value, dict):\n    63\t            question_id = value['id'] if 'class' in value else question_id\n    64\t            evidence_id = value['id'] if 'one_line' in value else evidence_id\n    65\t            for key, item in value.items():\n    66\t                yield from walk(item, f'{path}.{key}' if path else key, question_id, evidence_id)\n    67\t        elif isinstance(value, list):\n    68\t            for n, item in enumerate(value):\n    69\t                yield from walk(item, f'{path}[{n}]', question_id, evidence_id)\n    70\t        elif isinstance(value, str):\n    71\t            yield question_id, path, evidence_id, value\n    72\t    yield from walk(data, '', None, None)\n    73\t    if manifest is not None:\n    74\t        yield from walk(manifest, 'manifest', None, None)\n    75\t\n    76\t\n    77\tdef forbidden(ledger, data):\n    78\t    \"\"\"Every stored string the package must not hold, by question and kind; judgement columns read only where the store has them.\"\"\"\n    79\t    conn = service.open_ledger(str(ledger))\n    80\t    try:\n    81\t        columns = {row[1] for row in conn.execute('pragma table_info(judgements)')}\n    82\t        texts = [c for c in ('reasons', 'why_changed', 'implied_outcome', 'reference') if c in columns]\n    83\t        out = []\n    84\t        for question in data['questions']:\n    85\t            view_id = question['id']\n    86\t            for row in conn.execute('select label, condition from rungs where view_id=?', (view_id,)):\n    87\t                if question['class'] == 'number':                # an event's or Yes/No question's labels are its shown answers\n    88\t                    out.append((view_id, 'rung label', row['label']))\n    89\t                out.append((view_id, 'rung condition', row['condition']))\n    90\t            for row in conn.execute(f'select {\", \".join(texts)} from judgements where view_id=?', (view_id,)):\n    91\t                out += [(view_id, name, row[name]) for name in texts]\n    92\t            out += [(view_id, 'switch reason', row['reason']) for row in conn.execute('select reason from view_switches where view_id=?', (view_id,))]\n    93\t        return [entry for entry in out if entry[2]], [c for c in ('implied_outcome', 'reference') if c not in columns]\n    94\t    finally:\n    95\t        conn.close()\n    96\t\n    97\t\n    98\tdef diagnostics(ledger, data, package):\n    99\t    stored, absent = forbidden(ledger, data)\n   100\t    located = list(fields(data, json.loads((package / release.MANIFEST_FILE).read_text())))\n   101\t    joined = '\\x00'.join(text for *_, text in located)\n   102\t    hits = []\n   103\t    for view_id, kind, text in set(stored):\n   104\t        if text in joined:\n   105\t            for question_id, path, evidence_id, field in located:\n   106\t                if text in field:\n   107\t                    hits.append({'stored_in': view_id, 'kind': kind, 'text': text[:200], 'found_in': question_id, 'field': path, 'evidence': evidence_id})\n   108\t    return {'stored_strings_judged': len(set(stored)), 'package_strings': len(located), 'judgement_columns_absent': absent, 'hits': hits}\n   109\t\n   110\t\n   111\tdef library_baseline(ledger, items):\n   112\t    views_db, items_db = service.open_ledger(str(ledger)), store.open_read_only(str(items))\n   113\t    try:\n   114\t        started = time.monotonic()\n   115\t        payload = bundle.library(views_db, items_db)\n   116\t        return len(json.dumps(payload, ensure_ascii=False).encode()), time.monotonic() - started\n   117\t    finally:\n   118\t        views_db.close()\n   119\t        items_db.close()\n   120\t\n   121\t\n   122\tdef by_id(data):\n   123\t    return {q['id']: q for q in data['questions']}\n   124\t\n   125\t\n   126\tdef refresh(package, data=None, manifest_extra=None):\n   127\t    if data is not None:\n   128\t        payload = json.dumps(data, ensure_ascii=False, separators=(',', ':')).encode()\n   129\t        (package / release.DATA_FILE).write_bytes(payload)\n   130\t    manifest = json.loads((package / release.MANIFEST_FILE).read_text())\n   131\t    manifest['data_sha256'] = hashlib.sha256((package / release.DATA_FILE).read_bytes()).hexdigest()\n   132\t    manifest.update(manifest_extra or {})\n   133\t    (package / release.MANIFEST_FILE).write_text(json.dumps(manifest))\n   134\t\n   135\t\n   136\tdef refused(ledger, items, package):\n   137\t    try:\n   138\t        check(ledger, items, package)\n   139\t    except release.ReleaseRefused as error:\n   140\t        return str(error)\n   141\t    return None\n   142\t\n   143\t\n   144\tdef main(out):\n   145\t    out = Path(out).absolute()\n   146\t    out.mkdir()                                            # a new folder; refuses an existing one\n   147\t    results = {'stores': {}}\n   148\t    packages = {}\n   149\t    for name, (ledger, items) in STORES.items():\n   150\t        (out / name).mkdir()\n   151\t        report, data = build(ledger, items, out / name / 'package')\n   152\t        packages[name] = data\n   153\t        library_bytes, library_seconds = library_baseline(ledger, items)\n   154\t        seconds = report['export_seconds'] + report['check_seconds']\n   155\t        results['stores'][name] = {\n   156\t            'as_of': report['as_of'], 'counts': report['counts'], 'withheld_unresolved': len(report['withheld_unresolved']),\n   157\t            'unresolved': report['withheld_unresolved'], 'data_bytes': report['data_bytes'], 'library_bytes': library_bytes,\n   158\t            'seconds': round(seconds, 2), 'library_seconds': round(library_seconds, 2),\n   159\t            'bytes_within_budget': report['data_bytes'] <= library_bytes,\n   160\t            'seconds_within_budget': seconds <= 3 * library_seconds and seconds <= 120,\n   161\t            'diagnostics': diagnostics(ledger, data, out / name / 'package')}\n   162\t        print(name, json.dumps({k: v for k, v in results['stores'][name].items() if k not in ('unresolved', 'diagnostics')}), 'hits', len(results['stores'][name]['diagnostics']['hits']))\n   163\t\n   164\t    ledger, items = STORES['old-1']\n   165\t    data, package = packages['old-1'], out / 'old-1' / 'package'\n   166\t    conn = service.open_ledger(str(ledger))\n   167\t    stored = {row['evidence_id']: row for row in conn.execute(\"select * from evidence where evidence_id in ('e2295','e1865','e3597')\")}\n   168\t    implied = conn.execute('select implied_outcome from judgements where judgement_id=1580').fetchone()[0]\n   169\t    in_force_v8 = [e['evidence_id'] for e in service.evidence(conn, 'v8', data['as_of'])]\n   170\t    conn.close()\n   171\t    required_text = {   # each example's full stored text, written down before the run (old-1, 2026-11-23); compared exactly\n   172\t        'e2295': ('Morningstar cites NVIDIA Data Center revenue of $3 billion in FY2020 and $194 billion in FY2026, and estimates $361 billion in FY2027, up 86% year over year.',\n   173\t                  'Nvidia’s DC business has achieved exponential growth already, rising from $3 billion in fiscal 2020 to $194 billion in fiscal 2026, and we estimate it will be $361 billion in fiscal 2027, representing 86% annual growth.'),\n   174\t        'e1865': ('The author identifies firm SpaceX procurement commitments and NVIDIA Data Center growth above 60% into FY2028 as bullish confirmation conditions.',\n   175\t                  'Bullish confirmation would require firm procurement commitments for the SpaceX buildout and continued NVIDIA Data Center growth above 60% into fiscal 2028.'),\n   176\t        'e3597': ('The author says analysts estimate NVIDIA revenue of about $390 billion in calendar 2027 and over $550 billion in calendar 2028, with annual sales growth of roughly 24% to 25%.',\n   177\t                  'Analysts see revenue reaching about $390 billion in 2027 and more than $550 billion in 2028, with annual sales growth of roughly 24% to 25%.')}\n   178\t    kept = {}\n   179\t    for evidence_id in ('e2295', 'e1865', 'e3597'):              # the fixed examples: a missing one is a failure, not a smaller list\n   180\t        if evidence_id not in stored:\n   181\t            kept[evidence_id] = {'questions': [], 'equal_to_store': False, 'present': False}\n   182\t            continue\n   183\t        holders = [(q['id'], e) for q in data['questions'] for e in q['evidence'] if e['id'] == evidence_id]\n   184\t        kept[evidence_id] = {'questions': [h[0] for h in holders],\n   185\t                             'equal_to_store': all(e['one_line'] == stored[evidence_id]['one_line'] and e['quote'] == stored[evidence_id]['quote'] for _, e in holders) and bool(holders),\n   186\t                             'present': bool(holders),\n   187\t                             'holds_its_wording': bool(holders) and all((e['one_line'], e['quote']) == required_text[evidence_id] for _, e in holders)}\n   188\t    forged = out / 'old-1' / 'forged-summary'\n   189\t    shutil.copytree(package, forged)\n   190\t    changed = json.loads(json.dumps(data))\n   191\t    next(e for e in by_id(changed)['v8']['evidence'] if e['id'] == 'e2295')['one_line'] = implied\n   192\t    refresh(forged, changed)\n   193\t    prose = out / 'old-1' / 'forged-manifest'\n   194\t    shutil.copytree(package, prose)\n   195\t    refresh(prose, manifest_extra={'note': implied})\n   196\t    v8 = by_id(data)['v8']\n   197\t    results['decisive'] = {'kept': kept, 'implied_outcome_j1580': implied[:120],\n   198\t                           'substituted_into_e2295_refused': refused(ledger, items, forged),\n   199\t                           'added_to_manifest_refused': refused(ledger, items, prose),\n   200\t                           'unchanged_package_passes': check(ledger, items, package)['fields_compared']}\n   201\t    results['decisive']['forged_value_is_j1580'] = implied.startswith(J1580_PREFIX)\n   202\t    results['old-1/v8'] = {'class': v8['class'], 'forecast': v8['forecast'], 'evidence': len(v8['evidence']),\n   203\t                           'same_ids_as_service_evidence': [e['id'] for e in v8['evidence']] == in_force_v8}\n   204\t\n   205\t    leaks = {}\n   206\t    for name, view_id, day, judgement_id in (('old-3', 'v36', '2026-08-25', 799), ('old-1', 'v10', '2026-08-28', 865)):\n   207\t        ledger, items = STORES[name]\n   208\t        report, dated = build(ledger, items, out / name / f'package-{day}', day)\n   209\t        conn = service.open_ledger(str(ledger))\n   210\t        row = conn.execute('select judgement_id, rung, why_changed, reasons from judgements where view_id=? and publication_day<=? order by judgement_id desc limit 1', (view_id, day)).fetchone()\n   211\t        label = conn.execute('select label from rungs where view_id=? and position=?', (view_id, row['rung'])).fetchone()[0]\n   212\t        conn.close()\n   213\t        record = by_id(dated)[view_id]\n   214\t        texts = [text for *_, text in fields(dated)]\n   215\t        leaks[f'{name}/{view_id}@{day}'] = {\n   216\t            'latest_judgement': row['judgement_id'], 'expected_judgement': judgement_id, 'label_kept': record['answer'] == label, 'answer': record['answer'],\n   217\t            'why_changed_absent': not any(row['why_changed'] in t for t in texts), 'reasons_absent': not any((row['reasons'] or '\\x01') in t for t in texts),\n   218\t            'phrase_fields': {phrase: [(q, p, e, t[:160]) for q, p, e, t in fields(dated) if phrase in t]\n   219\t                              for phrase in ('around $1 trillion', 'rung 4', 'at rung', 'capex at rung')}}\n   220\t    results['leaks'] = leaks\n   221\t\n   222\t    ledger, items = STORES['old-1']\n   223\t    conn = service.open_ledger(str(ledger))\n   224\t    control = next(q for q in data['questions'] if q['class'] == 'event' and q['id'] not in ('v10',) and q['answer'] is not None)\n   225\t    stored_label = conn.execute('select r.label from judgements j join rungs r on r.view_id=j.view_id and r.position=j.rung where j.view_id=? and j.publication_day<=? order by j.judgement_id desc limit 1', (control['id'], data['as_of'])).fetchone()[0]\n   226\t    control_ids = [e['evidence_id'] for e in service.evidence(conn, control['id'], data['as_of'])]\n   227\t    conn.close()\n   228\t    results['control'] = {'id': control['id'], 'answer': control['answer'], 'label_equals_store': control['answer'] == stored_label,\n   229\t                          'evidence_equals_store': [e['id'] for e in control['evidence']] == control_ids}\n   230\t\n   231\t    closing = out / 'old-1' / 'closing'\n   232\t    closing.mkdir()\n   233\t    copy = closing / 'views.sqlite'\n   234\t    shutil.copyfile(ledger, copy)\n   235\t    conn = sqlite3.connect(copy)\n   236\t    rung = conn.execute(\"select rung from judgements where view_id='v8' order by judgement_id desc limit 1\").fetchone()[0]\n   237\t    rung_label = conn.execute(\"select label from rungs where view_id='v8' and position=?\", (rung,)).fetchone()[0]\n   238\t    reason = f'due {data[\"as_of\"]}, frozen on {data[\"as_of\"]} at rung {rung} {rung_label}'\n   239\t    last_seq = conn.execute('select max(sequence_no) from processing_steps').fetchone()[0]\n   240\t    conn.execute(\"insert into view_switches (view_id, open, reason, by_whom, after_seq) values ('v8', 0, ?, 'pull', ?)\", (reason, last_seq))\n   241\t    conn.commit()\n   242\t    conn.close()\n   243\t    views_db, items_db = service.open_ledger(str(copy)), store.open_read_only(str(items))\n   244\t    exposed = bundle.view_bundle(views_db, bundle.item_lookup(items_db), 'v8')\n   245\t    views_db.close()\n   246\t    items_db.close()\n   247\t    report, closed = build(copy, items, closing / 'package')\n   248\t    texts = [text for *_, text in fields(closed)]\n   249\t    results['closing'] = {'reason': reason, 'bundle_exposes_reason': any(s.get('reason') == reason for s in exposed['switches']),\n   250\t                          'package_open': by_id(closed)['v8']['open'], 'reason_absent': not any(reason in t for t in texts),\n   251\t                          'rung_label_inside_v8_fields': [(p, e, t[:120]) for q, p, e, t in fields(closed) if q == 'v8' and rung_label in t]}\n   252\t    (out / 'results.json').write_text(json.dumps(results, ensure_ascii=False, indent=1))\n   253\t    print(json.dumps({k: v for k, v in results.items() if k != 'stores'}, ensure_ascii=False, indent=1))\n   254\t    failures = [f'{name}: {key}' for name, s in results['stores'].items() for key in ('bytes_within_budget', 'seconds_within_budget') if not s[key]]\n   255\t    failures += [f'{name}: day, classes or evidence' for name, (day, classes, evidence) in EXPECTED.items()\n   256\t                 if (results['stores'][name]['as_of'], results['stores'][name]['counts']['questions'], results['stores'][name]['counts']['evidence']) != (day, classes, evidence)]\n   257\t    failures += [] if results['decisive']['forged_value_is_j1580'] else ['the forged value is not the system forecast j1580']\n   258\t    decisive = results['decisive']\n   259\t    failures += [f'kept {e}' for e in ('e2295', 'e1865', 'e3597')\n   260\t                 if not (decisive['kept'].get(e, {}).get('present') and decisive['kept'][e]['equal_to_store'] and decisive['kept'][e]['holds_its_wording'])]\n   261\t    expected_reasons = {'substituted_into_e2295_refused': 'question v8.evidence e2295.one_line: differs from the store',\n   262\t                        'added_to_manifest_refused': \"the manifest: keys off the allow-list ['note'], missing []\"}   # exact, so another refusal (a stale hash) does not count\n   263\t    failures += [k for k, reason in expected_reasons.items() if decisive[k] != reason]\n   264\t    failures += [] if (results['old-1/v8']['same_ids_as_service_evidence'] and results['old-1/v8']['forecast'] == MARKER\n   265\t                       and results['old-1/v8']['class'] == 'number' and results['old-1/v8']['evidence'] == 1284) else ['old-1/v8']\n   266\t    for name, leak in results['leaks'].items():\n   267\t        failures += [f'{name}: {k}' for k in ('label_kept', 'why_changed_absent', 'reasons_absent') if not leak[k]]\n   268\t        failures += [] if leak['answer'] == 'Yes' else [f'{name}: answer']\n   269\t        failures += [] if leak['latest_judgement'] == leak['expected_judgement'] else [f'{name}: judgement']\n   270\t        failures += [f'{name}: {phrase} found' for phrase, hits in leak['phrase_fields'].items() if hits]\n   271\t    failures += [] if (results['control']['id'], results['control']['answer']) == ('v3', 'Yes') and results['control']['label_equals_store'] and results['control']['evidence_equals_store'] else ['control']\n   272\t    closing = results['closing']\n   273\t    failures += [] if closing['reason'] == CLOSING_REASON and closing['bundle_exposes_reason'] and closing['package_open'] is False and closing['reason_absent'] else ['closing']\n   274\t    if failures:\n   275\t        raise SystemExit(f'release check FAILED: {failures}')\n   276\t    print('release check: every acceptance item and budget met; diagnostic hits to read by hand:',\n   277\t          {name: len(s['diagnostics']['hits']) for name, s in results['stores'].items()})\n   278\t\n   279\t\n   280\tif __name__ == '__main__':\n   281\t    main(sys.argv[1])\n","exit_code":0,"status":"completed"}}
