{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba tests/test_release.py | sed -n '1,365p'\"","aggregated_output":"     1\t\"\"\"The \"Forecast unavailable\" release package (docs/research/2026-11-22-number-answers/RELEASE-BUILD.md, revision 10; D726, D758).\n     2\t\n     3\tEach test names the design row it proves (§1 the closed set and the checks, §2 state × event, §6 the numbered tests). The stores are\n     4\treal SQLite files on a temporary path; the only edits of code are the mutation-procedure scratch copies of §6 tests 12, 14, 19, 20\n     5\tand 21, which insert a pause or a fault into a copy of the module and the command.\"\"\"\n     6\timport hashlib\n     7\timport json\n     8\timport os\n     9\timport shutil\n    10\timport sqlite3\n    11\timport subprocess\n    12\timport sys\n    13\timport time\n    14\tfrom pathlib import Path\n    15\t\n    16\timport pytest\n    17\t\n    18\tROOT = Path(__file__).resolve().parents[1]\n    19\tsys.path.insert(0, str(ROOT / 'src'))\n    20\tfrom hivemind import release, service  # noqa: E402\n    21\tfrom hivemind.views import store  # noqa: E402\n    22\t\n    23\tCOMMAND = ROOT / 'scripts' / 'release_build.py'\n    24\tDAYS = ['2026-08-24', '2026-08-25', '2026-08-26']\n    25\tASSET_LABELS = ['Strongly bullish', 'Bullish', 'Neutral', 'Bearish', 'Strongly bearish']\n    26\tV1_CONDITIONS = ['FY2027 revenue is at least $400 billion.', 'FY2027 revenue is at least $350 billion and less than $400 billion.',\n    27\t                 'FY2027 revenue is at least $300 billion and less than $350 billion.', 'FY2027 revenue is at least $250 billion and less than $300 billion.',\n    28\t                 'FY2027 revenue is less than $250 billion.']\n    29\tV1_BOUNDS = [(400e9, None), (350e9, 400e9), (300e9, 350e9), (250e9, 300e9), (None, 250e9)]\n    30\tV1_REASONS = 'The first-half figure and the third-quarter guide support an estimate of about $390 billion for the year.'\n    31\tV1_WHY = 'Moved up to the $350 billion to under $400 billion rung on the raised guide.'\n    32\tV5_WHY = 'Spending of around $1 trillion in 2027 makes acceleration likely.'\n    33\tV6_WHY = 'The revenue question now sits in the $350 billion to under $400 billion rung, which the rule would cut.'\n    34\tCLOSING = 'due 2026-08-25, frozen on 2026-08-25 at rung 2 Bullish'\n    35\tE6_ONE_LINE = 'Bullish confirmation would need firm orders, the author said.'       # the fixture's one genuine source use of a label word\n    36\tE6_QUOTE = 'Bullish confirmation would require firm procurement commitments.'\n    37\tREPORT_KEYS = {'ledger', 'items', 'as_of', 'counts', 'withheld_unresolved', 'data_bytes', 'export_seconds', 'check_seconds'}\n    38\tMARKER = 'Forecast unavailable'                                     # D726's words, written here, not read from the module under test\n    39\tNUMBER_KEYS = {'id', 'question', 'open', 'class', 'forecast', 'evidence'}\n    40\tANSWERED_KEYS = {'id', 'question', 'open', 'class', 'answers', 'answer', 'evidence'}\n    41\tFIXTURE_COUNTS = {'questions': {'number': 5, 'event': 1, 'yes_no': 1}, 'evidence': 5, 'sources': 6, 'fields_compared': 101}\n    42\tFIXTURE_DATA_BYTES = 3313\n    43\tUNREADABLE = 'conditions not read as amounts: positions [1, 2, 3, 4, 5]'\n    44\tFIXTURE_UNRESOLVED = [{'id': 'v3', 'reason': UNREADABLE, 'has_key': True}, {'id': 'v4', 'reason': UNREADABLE, 'has_key': False}]\n    45\t\n    46\t\n    47\tdef refused_with(call, message, kind=release.ReleaseRefused):\n    48\t    \"\"\"The call is refused with exactly this message (a refusal for another reason does not count).\"\"\"\n    49\t    with pytest.raises(kind) as caught:\n    50\t        call()\n    51\t    assert str(caught.value) == message, (str(caught.value), message)\n    52\t\n    53\t\n    54\tdef stderr_line(result, line):\n    55\t    assert line in result.stderr.splitlines(), (result.stderr, line)\n    56\t\n    57\t\n    58\tdef make_items(path, ids=('item-1', 'item-2', 'item-3')):\n    59\t    conn = sqlite3.connect(path)\n    60\t    conn.execute('create table items (input_id text primary key, title text, publisher text, publisher_type text, category text, publication_day text, source_uri text)')\n    61\t    for n, input_id in enumerate(ids, 1):\n    62\t        conn.execute('insert into items values (?,?,?,?,?,?,?)', (input_id, f'Article {n} on data-center spending', f'Publisher {n}', 'news', 'T1',\n    63\t                                                                 DAYS[min(n, 3) - 1], f'https://example.com/article-{n}'))\n    64\t    conn.commit()\n    65\t    conn.close()\n    66\t    return path\n    67\t\n    68\t\n    69\tdef five_rungs(conditions, bounds=None):\n    70\t    return [dict(label=label, condition=condition, **({'lo': lo, 'hi': hi} if bounds else {}))\n    71\t            for label, condition, (lo, hi) in zip(ASSET_LABELS, conditions, bounds or [(None, None)] * 5)]\n    72\t\n    73\t\n    74\tdef key(conn, view_id, measure, event_type='n/a'):\n    75\t    store.insert(conn, 'view_keys', view_id=view_id, measure=measure, scope='NVIDIA', scope_key='nvidia', period_start='2026-02-01',\n    76\t                 period_end='2027-01-31', basis='n/a', unit='USD', event_type=event_type, seq=1, scope_source='model', key_version=1)\n    77\t\n    78\t\n    79\tdef judge(conn, view_id, seq, rung, why, reasons='', implied=None):\n    80\t    store.insert(conn, 'judgements', view_id=view_id, seq=seq, input_id=f'item-{seq}', rung=rung, reasons=reasons, cited_evidence_json='[]',\n    81\t                 cited_views_json='[]', pushes_json='[]', changed=1, why_changed=why, publication_day=DAYS[seq - 1], theme_pushes_json='[]',\n    82\t                 reference=None, implied_outcome=implied)\n    83\t\n    84\t\n    85\tdef evidence(conn, evidence_id, view_id, seq, one_line, quote, sources):\n    86\t    store.insert(conn, 'evidence', evidence_id=evidence_id, quote=quote, one_line=one_line, speaker='Publisher', original_who='NVIDIA',\n    87\t                 original_day=DAYS[seq - 1], tier='party_statement', event_time=None, created_seq=seq, created_from_input=f'item-{seq}')\n    88\t    store.insert(conn, 'evidence_links', evidence_id=evidence_id, view_id=view_id, seq=seq)\n    89\t    for input_id, source_seq in sources:\n    90\t        store.insert(conn, 'evidence_sources', evidence_id=evidence_id, input_id=input_id, category='T1', publication_day=DAYS[source_seq - 1], seq=source_seq)\n    91\t\n    92\t\n    93\tdef make_store(path):\n    94\t    \"\"\"§6 fixture: three completed days; a number question with bounds (v1), one whose conditions resolve without a key (v2), unresolved\n    95\t    ones with a key (v3) and without (v4), a Yes/No question with numeric bounds (v5), an event (v6) and a closed number question (v7).\"\"\"\n    96\t    conn = store.open_db(str(path))\n    97\t    for seq, day in enumerate(DAYS, 1):\n    98\t        store.insert(conn, 'processing_steps', input_id=f'item-{seq}', sequence_no=seq, step='handed_over', result='ok', publication_day=day)\n    99\t        store.insert(conn, 'days_completed', day=day, seq=seq)\n   100\t    common = dict(object_id='NVDA', object_kind='company', kind='asset', due_day='2027-02-25', year='2027', seq=1, input_id='item-1', created_at='2026-08-24T12:00:00Z')\n   101\t    store.create_view(conn, view_id='v1', looks_at='NVIDIA revenue in FY2027', question='How much revenue will NVIDIA report for FY2027?', rungs=five_rungs(V1_CONDITIONS, V1_BOUNDS), **common)\n   102\t    key(conn, 'v1', 'revenue')\n   103\t    store.create_view(conn, view_id='v2', looks_at='NVIDIA FY2027 capital spending', question='How much will NVIDIA spend on capital in FY2027?',\n   104\t                      rungs=[{'label': '看多', 'condition': '不低于4000亿美元'}, {'label': '看空', 'condition': '低于4000亿美元'}], **common)\n   105\t    unreadable = ['Revenue is clearly strong.', 'Revenue is strong.', 'Revenue is flat.', 'Revenue is weak.', 'Revenue is clearly weak.']\n   106\t    store.create_view(conn, view_id='v3', looks_at='NVIDIA gaming revenue', question='How much gaming revenue will NVIDIA report for FY2027?', rungs=five_rungs(unreadable), **common)\n   107\t    key(conn, 'v3', 'segment_revenue')\n   108\t    store.create_view(conn, view_id='v4', looks_at='NVIDIA auto revenue', question='How much automotive revenue will NVIDIA report for FY2027?', rungs=five_rungs(unreadable), **common)\n   109\t    store.create_view(conn, view_id='v5', looks_at='Hyperscaler capex growth', question='Will hyperscaler capital spending growth accelerate in 2027?',\n   110\t                      rungs=[{'label': 'Yes', 'condition': 'Growth above zero', 'lo': 0.0, 'hi': None}, {'label': 'No', 'condition': 'Growth at or below zero', 'lo': None, 'hi': 0.0}], **common)\n   111\t    key(conn, 'v5', 'growth_rate')\n   112\t    store.create_view(conn, view_id='v6', looks_at='US export restriction', question='Will the US adopt the chip export restriction by 2027-01-31?',\n   113\t                      rungs=[{'label': 'Restriction adopted', 'condition': 'The rule is adopted'}, {'label': 'No restriction adopted', 'condition': 'The rule is not adopted'}], **common)\n   114\t    key(conn, 'v6', 'policy_event', 'regulation')\n   115\t    store.create_view(conn, view_id='v7', looks_at='NVIDIA Q2 revenue', question='How much revenue will NVIDIA report for Q2 FY2027?', rungs=five_rungs(V1_CONDITIONS, V1_BOUNDS), **common)\n   116\t    key(conn, 'v7', 'revenue')\n   117\t    judge(conn, 'v1', 1, 2, V1_WHY, V1_REASONS, 'About $390 billion')\n   118\t    judge(conn, 'v5', 1, 1, V5_WHY)\n   119\t    judge(conn, 'v6', 1, 2, V6_WHY)\n   120\t    judge(conn, 'v7', 1, 2, 'Held at the Bullish rung.')\n   121\t    store.insert(conn, 'view_switches', view_id='v7', open=0, reason=CLOSING, by_whom='pull', after_seq=2)\n   122\t    evidence(conn, 'e1', 'v1', 1, 'NVIDIA reported $164 billion of revenue in the first half.', 'The company generated $164 billion in the first six months.', [('item-1', 1), ('item-3', 3)])\n   123\t    evidence(conn, 'e2', 'v1', 3, 'Morningstar estimates $361 billion of revenue for the year.', 'We estimate it will be $361 billion in fiscal 2027.', [('item-3', 3)])\n   124\t    evidence(conn, 'e3', 'v1', 1, 'An early report put spending at $90 billion.', 'Spending was $90 billion, the report said.', [('item-1', 1)])\n   125\t    evidence(conn, 'e4', 'v1', 2, 'A corrected report put spending at $95 billion.', 'Spending was $95 billion, the corrected report said.', [('item-2', 2)])\n   126\t    store.insert(conn, 'replacements', old_evidence_id='e3', new_evidence_id='e4', said_day=DAYS[1], seq=2)\n   127\t    evidence(conn, 'e5', 'v6', 1, 'Officials said the export rule is under review.', 'The rule is under review, officials said.', [('item-1', 1)])\n   128\t    evidence(conn, 'e6', 'v5', 1, E6_ONE_LINE, E6_QUOTE, [('item-2', 1)])\n   129\t    conn.commit()\n   130\t    conn.close()\n   131\t    return path\n   132\t\n   133\t\n   134\t@pytest.fixture\n   135\tdef stores(tmp_path):\n   136\t    return make_store(tmp_path / 'views.sqlite'), make_items(tmp_path / 'items.sqlite')\n   137\t\n   138\t\n   139\tdef export(stores, as_of=None):\n   140\t    views_db, items_db = service.open_ledger(str(stores[0])), store.open_read_only(str(stores[1]))\n   141\t    try:\n   142\t        return release.release_export(views_db, items_db, as_of)\n   143\t    finally:\n   144\t        views_db.close()\n   145\t        items_db.close()\n   146\t\n   147\t\n   148\tdef strings(value):\n   149\t    \"\"\"Every decoded string in the package (keys excluded).\"\"\"\n   150\t    if isinstance(value, dict):\n   151\t        return [s for v in value.values() for s in strings(v)]\n   152\t    if isinstance(value, list):\n   153\t        return [s for v in value for s in strings(v)]\n   154\t    return [value] if isinstance(value, str) else []\n   155\t\n   156\t\n   157\tdef by_id(data):\n   158\t    return {q['id']: q for q in data['questions']}\n   159\t\n   160\t\n   161\tdef run(*args, cwd=None, timeout=120):\n   162\t    return subprocess.run([sys.executable, str(COMMAND), *map(str, args)], capture_output=True, text=True, cwd=cwd,\n   163\t                          env={**os.environ, 'PYTHONDONTWRITEBYTECODE': '1'}, timeout=timeout)\n   164\t\n   165\t\n   166\tdef build_package(stores, out, as_of=None):\n   167\t    views_db, items_db = service.open_ledger(str(stores[0])), store.open_read_only(str(stores[1]))\n   168\t    try:\n   169\t        data = release.release_export(views_db, items_db, as_of)\n   170\t        staged = release.stage(out)\n   171\t        release.write_package(data, staged)\n   172\t        release.check_package(staged, views_db, items_db, expected_as_of=data['as_of'])\n   173\t        release.publish(staged, out)\n   174\t        return data\n   175\t    finally:\n   176\t        views_db.close()\n   177\t        items_db.close()\n   178\t\n   179\t\n   180\tdef rewrite_data(package, data):\n   181\t    \"\"\"A copy of the package's data with its manifest hash refreshed, so every other check still passes.\"\"\"\n   182\t    payload = json.dumps(data, ensure_ascii=False, separators=(',', ':')).encode()\n   183\t    (package / release.DATA_FILE).write_bytes(payload)\n   184\t    manifest = json.loads((package / release.MANIFEST_FILE).read_text())\n   185\t    manifest.update(as_of=data['as_of'], data_sha256=hashlib.sha256(payload).hexdigest())\n   186\t    (package / release.MANIFEST_FILE).write_text(json.dumps(manifest))\n   187\t\n   188\t\n   189\tdef check(stores, package):\n   190\t    \"\"\"The counts of `check_package` with the stores.\"\"\"\n   191\t    views_db, items_db = service.open_ledger(str(stores[0])), store.open_read_only(str(stores[1]))\n   192\t    try:\n   193\t        return release.check_package(package, views_db, items_db)[0]\n   194\t    finally:\n   195\t        views_db.close()\n   196\t        items_db.close()\n   197\t\n   198\t\n   199\t# ---------- §6 tests 1–8: the export\n   200\t\n   201\t\n   202\tdef test_1_every_object_holds_exactly_its_record_types_keys(stores):\n   203\t    \"\"\"§1 ALLOWED, §6 test 1: the export passes the closed-set check; one added key fails it.\"\"\"\n   204\t    data = export(stores)\n   205\t    counts = release.check_export(data)\n   206\t    assert counts['questions'] == {'number': 5, 'event': 1, 'yes_no': 1} and counts['evidence'] == 5\n   207\t    assert set(by_id(data)['v1']) == NUMBER_KEYS and set(by_id(data)['v6']) == ANSWERED_KEYS\n   208\t    by_id(data)['v1']['condition'] = V1_CONDITIONS[1]\n   209\t    refused_with(lambda: release.check_export(data), \"question 0: keys off the allow-list ['condition'], missing []\")\n   210\t\n   211\t\n   212\tdef test_2_number_question_carries_only_the_marker_and_its_evidence(stores):\n   213\t    \"\"\"§6 test 2 (D726): no rung label, condition, reason, explanation or implied outcome of v1 reaches any decoded field.\"\"\"\n   214\t    data = export(stores)\n   215\t    v1 = by_id(data)['v1']\n   216\t    assert v1['class'] == 'number' and v1['forecast'] == MARKER\n   217\t    assert [e['id'] for e in v1['evidence']] == ['e1', 'e2', 'e4']\n   218\t    texts, own = strings(data), strings(v1)\n   219\t    for forbidden in [*V1_CONDITIONS, V1_REASONS, V1_WHY, 'About $390 billion']:\n   220\t        assert not any(forbidden in text for text in texts), forbidden\n   221\t    for label in ASSET_LABELS:                        # the selected label \"Bullish\" included; v1's own fields hold none\n   222\t        assert not any(label in text for text in own), label\n   223\t    allowed = {'Bullish': {('v5', 'e6', 'one_line'): E6_ONE_LINE, ('v5', 'e6', 'quote'): E6_QUOTE}}   # the fixture's genuine wording, by location\n   224\t    for label in ASSET_LABELS:\n   225\t        found = {(q['id'], e['id'], name): e[name] for q in data['questions'] for e in q['evidence'] for name in ('one_line', 'quote') if label in e[name]}\n   226\t        found.update({(q['id'], None, key): text for q in data['questions'] for key, value in q.items() if key != 'evidence'\n   227\t                      for text in strings(value) if label in text})\n   228\t        assert found == allowed.get(label, {}), (label, found)\n   229\t\n   230\t\n   231\tdef test_3_identity_branches_and_the_unresolved_report(stores):\n   232\t    \"\"\"§1 question_class, §6 test 3: a condition-only ladder that resolves and unresolved ladders with and without a key are all\n   233\t    number questions; only the unresolved two are listed.\"\"\"\n   234\t    data = export(stores)\n   235\t    assert {q['id']: q['class'] for q in data['questions']} == {'v1': 'number', 'v2': 'number', 'v3': 'number', 'v4': 'number', 'v5': 'yes_no', 'v6': 'event', 'v7': 'number'}\n   236\t    views_db = service.open_ledger(str(stores[0]))\n   237\t    try:\n   238\t        listed = {entry['id']: entry['has_key'] for entry in release.withheld_unresolved(views_db, data)}\n   239\t    finally:\n   240\t        views_db.close()\n   241\t    assert listed == {'v3': True, 'v4': False}\n   242\t\n   243\t\n   244\tdef test_4_yes_no_with_numeric_bounds_keeps_its_label_not_its_explanation(stores):\n   245\t    \"\"\"§6 test 4 (§4 a): v5 is Yes/No with its answer; its explanation quoting $1 trillion is absent.\"\"\"\n   246\t    data = export(stores)\n   247\t    v5 = by_id(data)['v5']\n   248\t    assert (v5['class'], v5['answers'], v5['answer']) == ('yes_no', ['Yes', 'No'], 'Yes')\n   249\t    assert not any('$1 trillion' in text for text in strings(data))\n   250\t\n   251\t\n   252\tdef test_5_event_keeps_its_labels_not_its_explanation(stores):\n   253\t    \"\"\"§6 test 5: an event with the served ledger's labels keeps them; its explanation quoting v1's rung is absent.\"\"\"\n   254\t    data = export(stores)\n   255\t    v6 = by_id(data)['v6']\n   256\t    assert (v6['class'], v6['answers'], v6['answer']) == ('event', ['Restriction adopted', 'No restriction adopted'], 'No restriction adopted')\n   257\t    assert not any(V6_WHY in text for text in strings(data))\n   258\t\n   259\t\n   260\tdef test_6_legacy_ledger_without_a_key_table_reads_chinese_yes_no(tmp_path):\n   261\t    \"\"\"§6 test 6, §2 legacy row: no view_keys table; 是/否 labels are Yes/No.\"\"\"\n   262\t    path = tmp_path / 'legacy.sqlite'\n   263\t    conn = store.open_db(str(path))\n   264\t    conn.execute('drop table view_keys')\n   265\t    store.insert(conn, 'processing_steps', input_id='item-1', sequence_no=1, step='handed_over', result='ok', publication_day=DAYS[0])\n   266\t    store.insert(conn, 'days_completed', day=DAYS[0], seq=1)\n   267\t    store.create_view(conn, view_id='v1', object_id='NVDA', object_kind='company', kind='asset', looks_at='Shipments', question='会开始量产出货吗？',\n   268\t                      due_day='2026-12-31', year='2026', rungs=[{'label': '是', 'condition': '开始出货'}, {'label': '否', 'condition': '未开始出货'}],\n   269\t                      seq=1, input_id='item-1', created_at='2026-08-24T12:00:00Z')\n   270\t    judge(conn, 'v1', 1, 1, '已确认出货。')\n   271\t    conn.commit()\n   272\t    conn.close()\n   273\t    data = export((path, make_items(tmp_path / 'items.sqlite')))\n   274\t    assert (data['questions'][0]['class'], data['questions'][0]['answer']) == ('yes_no', '是')\n   275\t\n   276\t\n   277\tdef test_7_closed_question_shows_closed_without_its_reason(stores):\n   278\t    \"\"\"§6 test 7, §2 closing row: v7 is closed at 08-25; the closing reason naming its rung is absent.\"\"\"\n   279\t    assert by_id(export(stores, DAYS[0]))['v7']['open'] is True\n   280\t    data = export(stores)\n   281\t    assert by_id(data)['v7']['open'] is False\n   282\t    assert not any(CLOSING in text or 'frozen on' in text for text in strings(data))\n   283\t\n   284\t\n   285\tdef test_8_replacements_and_sources_follow_the_day_and_missing_items_refuse(stores, tmp_path):\n   286\t    \"\"\"§6 test 8, §2 replacement and source rows: e3 is in force until its replacement on 08-25; e1's second source appears on 08-26;\n   287\t    a visible source with no item is refused.\"\"\"\n   288\t    early, late = by_id(export(stores, DAYS[0]))['v1'], by_id(export(stores))['v1']\n   289\t    assert [e['id'] for e in early['evidence']] == ['e1', 'e3']\n   290\t    assert [e['id'] for e in late['evidence']] == ['e1', 'e2', 'e4']\n   291\t    assert [s['day'] for s in early['evidence'][0]['sources']] == [DAYS[0]]\n   292\t    assert [s['day'] for s in late['evidence'][0]['sources']] == [DAYS[0], DAYS[2]]\n   293\t    short = make_items(tmp_path / 'short.sqlite', ids=('item-1', 'item-2'))\n   294\t    refused_with(lambda: export((stores[0], short)), 'evidence e1: source item item-3 is not in the items database')\n   295\t\n   296\t\n   297\t# ---------- §6 tests 9, 10, 13, 15, 16: the package and the origin check\n   298\t\n   299\t\n   300\tdef test_9_package_files_hash_and_manifest(stores, tmp_path):\n   301\t    \"\"\"§1 check_package, §6 test 9.\"\"\"\n   302\t    out = tmp_path / 'release'\n   303\t    data = build_package(stores, out)\n   304\t    assert check(stores, out)['fields_compared'] > 0\n   305\t    files = \"not exactly ['manifest.json', 'release-data.json']\"\n   306\t    variants = {\n   307\t        'foreign file': (lambda p: (p / 'notes.txt').write_text('x'), lambda p: f\"{p}: holds ['manifest.json', 'notes.txt', 'release-data.json'], {files}\"),\n   308\t        'subdirectory': (lambda p: (p / 'extra').mkdir(), lambda p: f\"{p}: holds ['extra', 'manifest.json', 'release-data.json'], {files}\"),\n   309\t        'changed byte': (lambda p: (p / release.DATA_FILE).write_bytes((p / release.DATA_FILE).read_bytes().replace(b'Morningstar', b'Morningstan')),\n   310\t                         lambda p: 'the manifest sha256 does not match the data file'),\n   311\t        'manifest prose': (lambda p: (p / release.MANIFEST_FILE).write_text(json.dumps({**json.loads((p / release.MANIFEST_FILE).read_text()), 'note': 'About $390 billion'})),\n   312\t                           lambda p: \"the manifest: keys off the allow-list ['note'], missing []\"),\n   313\t        'manifest day': (lambda p: (p / release.MANIFEST_FILE).write_text(json.dumps({**json.loads((p / release.MANIFEST_FILE).read_text()), 'as_of': DAYS[0]})),\n   314\t                         lambda p: f\"the manifest as_of '{DAYS[0]}' differs from the data '{DAYS[2]}'\"),\n   315\t    }\n   316\t    for name, (damage, message) in variants.items():\n   317\t        copy = tmp_path / f'copy-{name.replace(\" \", \"-\")}'\n   318\t        shutil.copytree(out, copy)\n   319\t        damage(copy)\n   320\t        refused_with(lambda: check(stores, copy), message(copy))\n   321\t    with pytest.raises(FileExistsError):\n   322\t        staged = release.stage(out)\n   323\t        release.write_package(data, staged)\n   324\t        release.publish(staged, out)\n   325\t    (tmp_path / '.other.staging-x').mkdir()            # another build's debris blocks nothing\n   326\t    assert build_package(stores, tmp_path / 'other')\n   327\t\n   328\t\n   329\tdef test_10_origin_check_derives_everything_from_the_store(stores, tmp_path):\n   330\t    \"\"\"§1 check_origins, §6 test 10: a forecast in a summary, a class swap, duplicates, another order and a future day are each\n   331\t    refused.\"\"\"\n   332\t    out = tmp_path / 'release'\n   333\t    data = build_package(stores, out)\n   334\t    cases = {}\n   335\t    forged = json.loads(json.dumps(data))\n   336\t    by_id(forged)['v1']['evidence'][1]['one_line'] = 'About $390 billion'\n   337\t    cases['forecast in a summary'] = (forged, 'question v1.evidence e2.one_line: differs from the store')\n   338\t    swapped = json.loads(json.dumps(data))\n   339\t    v5 = by_id(swapped)['v5']\n   340\t    for name in ('answers', 'answer'):\n   341\t        del v5[name]\n   342\t    v5.update({'class': 'number', 'forecast': MARKER})\n   343\t    cases['class swap'] = (swapped, 'question v5: fields differ from the store')\n   344\t    doubled = json.loads(json.dumps(data))\n   345\t    doubled['questions'].insert(1, doubled['questions'][0])\n   346\t    cases['duplicate question'] = (doubled, 'the questions differ from the store: 8 entries where the store has 7')\n   347\t    repeated = json.loads(json.dumps(data))\n   348\t    by_id(repeated)['v1']['evidence'].append(by_id(repeated)['v1']['evidence'][0])\n   349\t    cases['duplicate evidence'] = (repeated, 'question v1.evidence: 4 entries where the store has 3')\n   350\t    future = json.loads(json.dumps(data))\n   351\t    future['as_of'] = '2026-08-27'\n   352\t    cases['future day'] = (future, 'day not completed: 2026-08-27 is after the last completed day 2026-08-26')\n   353\t    reordered = json.loads(json.dumps(data))\n   354\t    reordered['questions'][0], reordered['questions'][1] = reordered['questions'][1], reordered['questions'][0]\n   355\t    cases['reordered questions'] = (reordered, 'the questions or their order differ from the store')\n   356\t    swapped = json.loads(json.dumps(data))\n   357\t    pieces = by_id(swapped)['v1']['evidence']\n   358\t    pieces[0], pieces[1] = pieces[1], pieces[0]\n   359\t    cases['reordered evidence'] = (swapped, 'question v1.evidence e1.id: differs from the store')\n   360\t    for name, (changed, reason) in cases.items():\n   361\t        copy = tmp_path / f'copy-{name.replace(\" \", \"-\")}'\n   362\t        shutil.copytree(out, copy)\n   363\t        rewrite_data(copy, changed)\n   364\t        refused_with(lambda: check(stores, copy), reason, ValueError)\n   365\t\n","exit_code":0,"status":"completed"}}
