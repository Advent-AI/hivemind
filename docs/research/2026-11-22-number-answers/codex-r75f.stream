{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba tests/test_release.py | sed -n '366,760p'\"","aggregated_output":"   366\t\n   367\tdef test_10_legacy_store_without_completed_days_passes_one_date_rule(tmp_path):\n   368\t    \"\"\"§2 legacy row, §6 test 10: no completed days and no processing steps; an explicit day after the last judgement builds and the\n   369\t    same day passes a later check.\"\"\"\n   370\t    path = tmp_path / 'legacy.sqlite'\n   371\t    conn = store.open_db(str(path))\n   372\t    store.create_view(conn, view_id='v1', object_id='NVDA', object_kind='company', kind='asset', looks_at='Shipments', question='Will shipments begin?',\n   373\t                      due_day='2026-12-31', year='2026', rungs=[{'label': 'Yes', 'condition': 'Begin'}, {'label': 'No', 'condition': 'Do not begin'}],\n   374\t                      seq=1, input_id='item-1', created_at='2026-08-24T12:00:00Z')\n   375\t    judge(conn, 'v1', 1, 1, 'Shipments confirmed.')\n   376\t    conn.commit()\n   377\t    conn.close()\n   378\t    pair = (path, make_items(tmp_path / 'items.sqlite'))\n   379\t    build_package(pair, tmp_path / 'release', '2026-09-30')\n   380\t    assert check(pair, tmp_path / 'release')['questions'] == {'number': 0, 'event': 0, 'yes_no': 0}\n   381\t\n   382\t\n   383\tdef test_13_check_refuses_a_missing_item_even_when_the_package_omits_its_source(stores, tmp_path):\n   384\t    \"\"\"§6 test 13: the items copy lacks item-3; the package copy drops every item-3 source, keeping e2 with none, its hash refreshed.\n   385\t    A checker that silently skips a missing item accepts this pair; the release refuses it, naming the item.\"\"\"\n   386\t    out = tmp_path / 'release'\n   387\t    data = build_package(stores, out)\n   388\t    short = make_items(tmp_path / 'short.sqlite', ids=('item-1', 'item-2'))\n   389\t    copy = tmp_path / 'copy'\n   390\t    shutil.copytree(out, copy)\n   391\t    for piece in by_id(data)['v1']['evidence']:      # e1 loses its item-3 source, e2 keeps its record with no source: what a checker\n   392\t        piece['sources'] = [s for s in piece['sources'] if s['uri'] != 'https://example.com/article-3']   # that drops missing items expects\n   393\t    rewrite_data(copy, data)\n   394\t    refused_with(lambda: check((stores[0], short), copy), 'evidence e1: source item item-3 is not in the items database')\n   395\t\n   396\t\n   397\tdef test_15_symbolic_links_and_repeated_member_names_are_refused(stores, tmp_path):\n   398\t    \"\"\"§6 test 15: a symbolic link, a repeated member name and a named pipe are refused (the pipe without waiting).\"\"\"\n   399\t    out = tmp_path / 'release'\n   400\t    build_package(stores, out)\n   401\t    linked = tmp_path / 'linked'\n   402\t    shutil.copytree(out, linked)\n   403\t    (tmp_path / 'outside.json').write_bytes((linked / release.DATA_FILE).read_bytes())\n   404\t    (linked / release.DATA_FILE).unlink()\n   405\t    (linked / release.DATA_FILE).symlink_to(tmp_path / 'outside.json')\n   406\t    refused_with(lambda: check(stores, linked), f'{linked}/release-data.json: not a regular file')\n   407\t    repeated = tmp_path / 'repeated'\n   408\t    shutil.copytree(out, repeated)\n   409\t    raw = (repeated / release.DATA_FILE).read_bytes()\n   410\t    genuine = b'\"one_line\":\"Morningstar estimates $361 billion of revenue for the year.\"'\n   411\t    assert raw.count(genuine) == 1\n   412\t    payload = raw.replace(genuine, b'\"one_line\":\"About $390 billion\",' + genuine)\n   413\t    (repeated / release.DATA_FILE).write_bytes(payload)\n   414\t    manifest = json.loads((repeated / release.MANIFEST_FILE).read_text())\n   415\t    manifest['data_sha256'] = hashlib.sha256(payload).hexdigest()\n   416\t    (repeated / release.MANIFEST_FILE).write_text(json.dumps(manifest))\n   417\t    refused_with(lambda: check(stores, repeated), \"a JSON member name repeats: ['one_line']\")\n   418\t    piped = tmp_path / 'piped'\n   419\t    shutil.copytree(out, piped)\n   420\t    (piped / release.DATA_FILE).unlink()\n   421\t    os.mkfifo(piped / release.DATA_FILE)\n   422\t    result = run('check', piped, '--ledger', stores[0], '--items', stores[1], timeout=30)      # a blocking open would hang here\n   423\t    assert result.returncode == 1\n   424\t    stderr_line(result, f'refused: ReleaseRefused: {piped}/release-data.json: not a regular file')\n   425\t\n   426\t\n   427\tdef test_16_the_day_must_be_valid_and_canonical(stores):\n   428\t    \"\"\"§2 day rows, §6 test 16.\"\"\"\n   429\t    refused_with(lambda: export(stores, '2026-08-99'), \"not a day: '2026-08-99'\")\n   430\t    with pytest.raises(release.ReleaseRefused) as caught:      # Python 3.10 refuses the spelling as a day; 3.11+ reads it, and the canonical rule refuses it\n   431\t        export(stores, '20260825')\n   432\t    assert str(caught.value) in (\"not a day: '20260825'\", \"a day must be written YYYY-MM-DD: '20260825'\")\n   433\t    assert [e['id'] for e in by_id(export(stores, '2026-08-25'))['v1']['evidence']] == ['e1', 'e4']\n   434\t    views_db = service.open_ledger(str(stores[0]))\n   435\t    try:\n   436\t        refused_with(lambda: release.resolve(views_db, '2026-08-27'), 'day not completed: 2026-08-27 is after the last completed day 2026-08-26', service.BoundNotCompleted)\n   437\t    finally:\n   438\t        views_db.close()\n   439\t\n   440\t\n   441\tdef test_16_a_day_before_the_first_question_gives_an_empty_package(stores):\n   442\t    \"\"\"§2 row \"valid day before the first visible question\", §6 test 16: the store's questions open on 08-24.\"\"\"\n   443\t    data = export(stores, '2026-08-23')\n   444\t    assert data['as_of'] == '2026-08-23' and data['questions'] == []\n   445\t\n   446\t\n   447\t# ---------- §6 tests 11, 17, 18: the command\n   448\t\n   449\t\n   450\tdef test_11_command_end_to_end_with_check_statuses(stores, tmp_path):\n   451\t    \"\"\"§1 the builder and check, §6 test 11.\"\"\"\n   452\t    out = tmp_path / 'release'\n   453\t    built = run('build', '--ledger', stores[0], '--items', stores[1], '--out', out)\n   454\t    assert built.returncode == 0, built.stderr\n   455\t    report = out.with_name('release.report.json')\n   456\t    written = json.loads(report.read_text())\n   457\t    assert set(written) == REPORT_KEYS and (written['ledger'], written['items'], written['as_of']) == (str(stores[0]), str(stores[1]), DAYS[2])\n   458\t    assert written['counts'] == FIXTURE_COUNTS and written['withheld_unresolved'] == FIXTURE_UNRESOLVED and written['data_bytes'] == FIXTURE_DATA_BYTES\n   459\t    assert written['export_seconds'] >= 0 and written['check_seconds'] >= 0\n   460\t    occupied = run('check', out, '--ledger', stores[0], '--items', stores[1])\n   461\t    assert occupied.returncode == 2 and occupied.stdout.startswith(f'passes {out}: ')\n   462\t    report.unlink()\n   463\t    fresh = run('check', out, '--ledger', stores[0], '--items', stores[1])\n   464\t    assert fresh.returncode == 0 and report.exists() and json.loads(report.read_text())['export_seconds'] is None\n   465\t\n   466\t\n   467\tdef test_17_database_error_leaves_nothing_and_a_retry_succeeds(stores, tmp_path):\n   468\t    \"\"\"§2 database-error row, §6 test 17.\"\"\"\n   469\t    broken = tmp_path / 'broken.sqlite'\n   470\t    sqlite3.connect(broken).execute('create table other (x)').connection.commit()\n   471\t    out = tmp_path / 'release'\n   472\t    failed = run('build', '--ledger', stores[0], '--items', broken, '--out', out)\n   473\t    assert failed.returncode == 1\n   474\t    stderr_line(failed, 'refused: OperationalError: no such table: items')\n   475\t    assert not out.exists() and not list(tmp_path.glob('.release.staging-*'))\n   476\t    assert run('build', '--ledger', stores[0], '--items', stores[1], '--out', out).returncode == 0\n   477\t\n   478\t\n   479\tdef test_18_no_report_ever_replaces_an_input(stores, tmp_path):\n   480\t    \"\"\"§1 publish_report, §6 test 18: the report name is the items file itself, a symbolic link to it, and (on a case-insensitive\n   481\t    volume) a case-variant name of it.\"\"\"\n   482\t    items_hash = hashlib.sha256(stores[1].read_bytes()).hexdigest()\n   483\t    same = tmp_path / 'same.report.json'\n   484\t    shutil.copyfile(stores[1], same)\n   485\t    refused = run('build', '--ledger', stores[0], '--items', same, '--out', tmp_path / 'same')\n   486\t    assert refused.returncode == 1 and hashlib.sha256(same.read_bytes()).hexdigest() == items_hash\n   487\t    out = tmp_path / 'pkg'\n   488\t    assert run('build', '--ledger', stores[0], '--items', stores[1], '--out', out).returncode == 0\n   489\t    report = tmp_path / 'pkg.report.json'\n   490\t    report.unlink()\n   491\t    report.symlink_to(stores[1])\n   492\t    linked = run('check', out, '--ledger', stores[0], '--items', stores[1])\n   493\t    assert linked.returncode == 2 and hashlib.sha256(stores[1].read_bytes()).hexdigest() == items_hash\n   494\t    report.unlink()\n   495\t    variant = tmp_path / 'PKG.REPORT.JSON'\n   496\t    shutil.copyfile(stores[1], variant)\n   497\t    if report.exists():                                  # a case-insensitive volume: the variant is the report name\n   498\t        checked = run('check', out, '--ledger', stores[0], '--items', variant)\n   499\t        assert checked.returncode == 2 and hashlib.sha256(variant.read_bytes()).hexdigest() == items_hash\n   500\t\n   501\t\n   502\t# ---------- §6 tests 12, 14, 19, 20, 21: scratch copies of the command (the AGENTS §4 mutation procedure)\n   503\t\n   504\t\n   505\tdef scratch(tmp_path, edits):\n   506\t    \"\"\"A copy of the package and the command with text edits applied; each edit must match once.\"\"\"\n   507\t    root = tmp_path / 'scratch'\n   508\t    shutil.copytree(ROOT / 'src' / 'hivemind', root / 'src' / 'hivemind', ignore=shutil.ignore_patterns('__pycache__'))\n   509\t    (root / 'scripts').mkdir()\n   510\t    shutil.copy(COMMAND, root / 'scripts' / 'release_build.py')\n   511\t    for relative, old, new in edits:\n   512\t        path = root / relative\n   513\t        text = path.read_text()\n   514\t        assert text.count(old) == 1, ('scratch anchor', relative, old)\n   515\t        path.write_text(text.replace(old, new))\n   516\t    return root / 'scripts' / 'release_build.py'\n   517\t\n   518\t\n   519\tdef pause_code(signals, name, indent='        '):\n   520\t    \"\"\"Code that signals it has paused and waits for the test's resume file, ending at `indent` for the line it precedes.\"\"\"\n   521\t    return (f\"__import__('pathlib').Path({str(signals / ('paused-' + name))!r}).touch()\\n\"\n   522\t            f\"{indent}while not __import__('pathlib').Path({str(signals / ('resume-' + name))!r}).exists(): __import__('time').sleep(0.02)\\n{indent}\")\n   523\t\n   524\t\n   525\tdef run_paused(command, args, signals, name, action):\n   526\t    process = subprocess.Popen([sys.executable, str(command), *map(str, args)], stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True,\n   527\t                               env={**os.environ, 'PYTHONDONTWRITEBYTECODE': '1'})\n   528\t    deadline = time.time() + 60\n   529\t    while not (signals / f'paused-{name}').exists():\n   530\t        assert process.poll() is None and time.time() < deadline, process.communicate()\n   531\t        time.sleep(0.02)\n   532\t    action()\n   533\t    (signals / f'resume-{name}').touch()\n   534\t    out, err = process.communicate(timeout=120)\n   535\t    return process.returncode, out, err\n   536\t\n   537\t\n   538\tFAULT = (\"evidence.append({'id': piece['evidence_id'], **{name: piece[name] for name in EVIDENCE_TEXT}, 'sources': sources})\",\n   539\t         \"evidence.append({'id': piece['evidence_id'], **{name: piece[name] for name in EVIDENCE_TEXT}, 'sources': sources, \"\n   540\t         \"'one_line': views_db.execute('select why_changed from judgements where view_id=? order by judgement_id desc limit 1', (view_id,)).fetchone()['why_changed'] if view_id == 'v1' else piece['one_line']})\")\n   541\tSTAGED_CHECK = (\"counts, data, size = release.check_package(staged, views_db, items_db, expected_as_of=bound)\", \"counts, size = release.check_export(data), 0\")\n   542\t\n   543\t\n   544\tdef test_12_the_staged_check_is_what_stops_a_writer_fault(stores, tmp_path):\n   545\t    \"\"\"§6 test 12: with a writer fault the command refuses and leaves nothing; with the fault and no staged check the bad package is\n   546\t    published, so the staged check is what prevents it.\"\"\"\n   547\t    faulty = scratch(tmp_path / 'a', [('src/hivemind/release.py', *FAULT)])\n   548\t    out = tmp_path / 'release'\n   549\t    refused = subprocess.run([sys.executable, str(faulty), 'build', '--ledger', stores[0], '--items', stores[1], '--out', out], capture_output=True, text=True)\n   550\t    assert refused.returncode == 1\n   551\t    stderr_line(refused, 'refused: ReleaseRefused: question v1.evidence e1.one_line: differs from the store')\n   552\t    assert not out.exists() and not list(tmp_path.glob('.release.staging-*'))\n   553\t    unguarded = scratch(tmp_path / 'b', [('src/hivemind/release.py', *FAULT), ('scripts/release_build.py', *STAGED_CHECK)])\n   554\t    published = subprocess.run([sys.executable, str(unguarded), 'build', '--ledger', stores[0], '--items', stores[1], '--out', out], capture_output=True, text=True)\n   555\t    assert published.returncode == 0, published.stderr\n   556\t    assert V1_WHY in (out / release.DATA_FILE).read_text()\n   557\t\n   558\t\n   559\tdef test_14_publication_never_replaces_or_removes_another_folder(stores, tmp_path):\n   560\t    \"\"\"§1 publish, §2 rows on an occupied --out and two builds, §6 test 14.\"\"\"\n   561\t    data = export(stores)\n   562\t    out = tmp_path / 'release'\n   563\t    first, second = release.stage(out), release.stage(out)\n   564\t    release.write_package(data, first)\n   565\t    release.write_package(data, second)\n   566\t    release.publish(first, out)\n   567\t    with pytest.raises(FileExistsError):\n   568\t        release.publish(second, out)\n   569\t    assert second.exists() and check(stores, out)['fields_compared'] > 0\n   570\t    other = tmp_path / 'other'\n   571\t    staged = release.stage(other)\n   572\t    release.write_package(data, staged)\n   573\t    other.mkdir()\n   574\t    with pytest.raises(FileExistsError):\n   575\t        release.publish(staged, other)\n   576\t    assert other.is_dir() and not any(other.iterdir())\n   577\t    early = tmp_path / 'early'\n   578\t    early.mkdir()\n   579\t    assert run('build', '--ledger', stores[0], '--items', stores[1], '--out', early).returncode == 1 and early.is_dir()\n   580\t\n   581\t    signals = tmp_path / 'signals'\n   582\t    signals.mkdir()\n   583\t    paused = scratch(tmp_path / 'late', [('scripts/release_build.py', 'release.publish(staged, out)', pause_code(signals, 'publish') + 'release.publish(staged, out)')])\n   584\t    late = tmp_path / 'late-out'\n   585\t    holder = {}\n   586\t\n   587\t    def occupy():\n   588\t        late.mkdir()\n   589\t        holder['identity'] = (late.stat().st_dev, late.stat().st_ino)\n   590\t    code, _, err = run_paused(paused, ['build', '--ledger', stores[0], '--items', stores[1], '--out', late], signals, 'publish', occupy)\n   591\t    assert code == 1 and f\"refused: FileExistsError: [Errno 17] File exists: '{late}'\" in err.splitlines()\n   592\t    assert (late.stat().st_dev, late.stat().st_ino) == holder['identity'] and not any(late.iterdir())\n   593\t    assert not list(tmp_path.glob('.late-out.staging-*'))\n   594\t\n   595\t    after = scratch(tmp_path / 'after', [('scripts/release_build.py', '        release.publish(staged, out)\\n',\n   596\t                                          f\"        release.publish(staged, out)\\n        {pause_code(signals, 'freed')}staged.mkdir(); (staged / 'marker').write_text('mine')\\n\")])\n   597\t    done = tmp_path / 'after-out'\n   598\t    code, _, err = run_paused(after, ['build', '--ledger', stores[0], '--items', stores[1], '--out', done], signals, 'freed', lambda: None)\n   599\t    assert code == 0, err\n   600\t    markers = list(tmp_path.glob('.after-out.staging-*/marker'))\n   601\t    assert len(markers) == 1 and markers[0].read_text() == 'mine'\n   602\t\n   603\t\n   604\tdef test_19_a_report_name_taken_during_the_build_survives(stores, tmp_path):\n   605\t    \"\"\"§2 report rows, §6 test 19.\"\"\"\n   606\t    signals = tmp_path / 'signals'\n   607\t    signals.mkdir()\n   608\t    paused = scratch(tmp_path, [('scripts/release_build.py', '    return write_report(summary, report)\\n\\n\\ndef check',\n   609\t                                 f\"    {pause_code(signals, 'report', indent='    ')}return write_report(summary, report)\\n\\n\\ndef check\")])\n   610\t    out = tmp_path / 'release'\n   611\t    marker = tmp_path / 'release.report.json'\n   612\t    code, _, err = run_paused(paused, ['build', '--ledger', stores[0], '--items', stores[1], '--out', out], signals, 'report', lambda: marker.write_text('occupied'))\n   613\t    assert code == 2 and marker.read_text() == 'occupied'\n   614\t    assert any(line.startswith('report not written ([Errno 17] File exists: ') and line.endswith(f\"-> '{marker}'); run check to write it\") for line in err.splitlines()), err\n   615\t    checked = run('check', out, '--ledger', stores[0], '--items', stores[1])\n   616\t    assert checked.returncode == 2 and checked.stdout.startswith(f'passes {out}: ') and marker.read_text() == 'occupied'\n   617\t\n   618\t\n   619\tdef test_20_a_temporary_file_left_after_the_link_still_counts_as_published(stores, tmp_path):\n   620\t    \"\"\"§1 publish_report, §6 test 20.\"\"\"\n   621\t    command = scratch(tmp_path, [('src/hivemind/release.py', '    try:\\n        os.unlink(temporary)\\n    except OSError:',\n   622\t                                  \"    try:\\n        raise PermissionError('test: cannot remove')\\n    except OSError:\")])\n   623\t    out = tmp_path / 'release'\n   624\t    result = subprocess.run([sys.executable, str(command), 'build', '--ledger', stores[0], '--items', stores[1], '--out', out], capture_output=True, text=True)\n   625\t    leftovers = list(tmp_path.glob('.release.report.json.*'))\n   626\t    assert result.returncode == 0 and len(leftovers) == 1\n   627\t    stderr_line(result, f'report published; its temporary file {leftovers[0]} could not be removed')\n   628\t    assert json.loads(out.with_name('release.report.json').read_text())['as_of'] == DAYS[2]\n   629\t    assert list(tmp_path.glob('.release.report.json.*'))\n   630\t\n   631\t\n   632\tdef test_21_check_that_cannot_write_its_report_exits_2(stores, tmp_path):\n   633\t    \"\"\"§1 check's statuses, §6 test 21.\"\"\"\n   634\t    out = tmp_path / 'release'\n   635\t    build_package(stores, out)\n   636\t    command = scratch(tmp_path, [('src/hivemind/release.py', \"    descriptor, temporary = tempfile.mkstemp(dir=path.parent, prefix=f'.{path.name}.')\",\n   637\t                                  \"    raise PermissionError('test: cannot create')\")])\n   638\t    result = subprocess.run([sys.executable, str(command), 'check', out, '--ledger', stores[0], '--items', stores[1]], capture_output=True, text=True)\n   639\t    assert result.returncode == 2 and result.stdout.startswith(f'passes {out}: ')\n   640\t    stderr_line(result, 'report not written (test: cannot create); run check to write it')\n   641\t    printed = json.loads(result.stdout[result.stdout.index('\\n{') + 1:])    # the whole report, printed on its own lines, though not written\n   642\t    assert set(printed) == REPORT_KEYS and (printed['ledger'], printed['items'], printed['as_of']) == (str(stores[0]), str(stores[1]), DAYS[2])\n   643\t    assert printed['counts'] == FIXTURE_COUNTS and printed['withheld_unresolved'] == FIXTURE_UNRESOLVED and printed['data_bytes'] == FIXTURE_DATA_BYTES\n   644\t    assert printed['export_seconds'] is None and printed['check_seconds'] >= 0\n   645\t\n   646\t\n   647\t# ---------- council 75: key visibility, text fields, store paths, the writer's own refusal\n   648\t\n   649\t\n   650\tdef test_22_a_key_written_after_the_day_does_not_reclassify_it(stores, tmp_path):\n   651\t    \"\"\"§1 question_class (council 75): a question with no key on 08-24 that gains an event key on 08-25 stays a number question in\n   652\t    the 08-24 package.\"\"\"\n   653\t    conn = store.open_db(str(stores[0]))\n   654\t    store.create_view(conn, view_id='v8', looks_at='NVIDIA buyback', question='How large a buyback will NVIDIA announce by 2027?',\n   655\t                      rungs=[{'label': 'Above the estimate', 'condition': 'At least $60 billion'}, {'label': 'Below the estimate', 'condition': 'Less than $60 billion'}],\n   656\t                      object_id='NVDA', object_kind='company', kind='asset', due_day='2027-01-31', year='2027', seq=1, input_id='item-1', created_at='2026-08-24T12:00:00Z')\n   657\t    judge(conn, 'v8', 1, 1, 'The estimate is about $70 billion.')\n   658\t    store.insert(conn, 'view_keys', view_id='v8', measure='event', scope='NVIDIA', scope_key='nvidia', period_start='2026-02-01', period_end='2027-01-31',\n   659\t                 basis='n/a', unit='n/a', event_type='other', seq=2, scope_source='model', key_version=1)\n   660\t    conn.commit()\n   661\t    conn.close()\n   662\t    early, late = by_id(export(stores, DAYS[0]))['v8'], by_id(export(stores, DAYS[1]))['v8']\n   663\t    assert (early['class'], early.get('forecast')) == ('number', MARKER)\n   664\t    assert (late['class'], late['answer']) == ('event', 'Above the estimate')\n   665\t    out = tmp_path / 'early'\n   666\t    build_package(stores, out, DAYS[0])\n   667\t    assert by_id(release.read_data(out))['v8']['class'] == 'number'\n   668\t\n   669\t\n   670\tEVIDENCE_COLUMNS = {'one_line': 'one_line', 'quote': 'quote', 'tier': 'tier', 'speaker': 'speaker', 'original_who': 'original_who', 'original_day': 'original_day'}\n   671\tSOURCE_COLUMNS = {'title': ('items', 'title'), 'publisher': ('items', 'publisher'), 'uri': ('items', 'source_uri'), 'day': ('sources', 'publication_day')}\n   672\t\n   673\t\n   674\t@pytest.mark.parametrize('field', [*EVIDENCE_COLUMNS, *SOURCE_COLUMNS])\n   675\tdef test_23_every_evidence_and_source_text_field_must_be_text(tmp_path, field):\n   676\t    \"\"\"§1 check_export (council 75): a null in any of the ten text fields the closed set requires is refused, at the writer.\"\"\"\n   677\t    views, items = make_store(tmp_path / 'views.sqlite'), make_items(tmp_path / 'items.sqlite', ids=('item-1', 'item-2', 'item-3', 'item-9'))\n   678\t    conn = store.open_db(str(views))\n   679\t    values = dict(evidence_id='e7', quote='Officials said the rule would be published.', one_line='Officials expect the rule.', speaker='Publisher',\n   680\t                  original_who='Officials', original_day=DAYS[0], tier='party_statement', event_time=None, created_seq=1, created_from_input='item-9')\n   681\t    if field in EVIDENCE_COLUMNS:\n   682\t        values[EVIDENCE_COLUMNS[field]] = None\n   683\t    store.insert(conn, 'evidence', **values)\n   684\t    store.insert(conn, 'evidence_links', evidence_id='e7', view_id='v6', seq=1)\n   685\t    store.insert(conn, 'evidence_sources', evidence_id='e7', input_id='item-9', category='T1',\n   686\t                 publication_day=None if field == 'day' else DAYS[0], seq=1)\n   687\t    conn.commit()\n   688\t    conn.close()\n   689\t    if field in SOURCE_COLUMNS and SOURCE_COLUMNS[field][0] == 'items':\n   690\t        items_conn = sqlite3.connect(items)\n   691\t        items_conn.execute(f\"update items set {SOURCE_COLUMNS[field][1]} = null where input_id = 'item-9'\")\n   692\t        items_conn.commit()\n   693\t        items_conn.close()\n   694\t    where = 'question v6 evidence e7' + ('' if field in EVIDENCE_COLUMNS else ' source')\n   695\t    refused_with(lambda: export((views, items)), f'{where}: {field} is not text')\n   696\t\n   697\t\n   698\tdef test_24_a_store_path_with_uri_syntax_is_refused(stores, tmp_path):\n   699\t    \"\"\"§1 store_path (councils 75, 75b): a path holding a character the SQLite URI opener decodes is refused before anything is opened;\n   700\t    an accepted path is returned resolved, so the opener does not resolve a link a second time.\"\"\"\n   701\t    odd = tmp_path / 'a%2Db'\n   702\t    odd.mkdir()\n   703\t    shutil.copyfile(stores[0], odd / 'views.sqlite')\n   704\t    message = f\"{odd / 'views.sqlite'}: a store path may not contain ['%'], which the SQLite opener reads as URI syntax\"\n   705\t    refused_with(lambda: release.store_path(odd / 'views.sqlite'), message)\n   706\t    result = run('build', '--ledger', odd / 'views.sqlite', '--items', stores[1], '--out', tmp_path / 'release')\n   707\t    assert result.returncode == 1 and not (tmp_path / 'release').exists()\n   708\t    stderr_line(result, f'refused: ReleaseRefused: {message}')\n   709\t    assert release.store_path(stores[0]) == os.path.realpath(stores[0])\n   710\t    link = tmp_path / 'link.sqlite'\n   711\t    link.symlink_to(stores[0])\n   712\t    assert release.store_path(link) == os.path.realpath(stores[0])          # the opener is given the target, with nothing left to follow\n   713\t\n   714\t\n   715\tDRIVER = \"\"\"import sys\n   716\tsys.path.insert(0, sys.argv[1])\n   717\tfrom hivemind import release, service\n   718\tfrom hivemind.views import store\n   719\tviews, items = service.open_ledger(sys.argv[2]), store.open_read_only(sys.argv[3])\n   720\ttry:\n   721\t    data = release.release_export(views, items)\n   722\t    print('returned', sorted(data['questions'][0]))\n   723\texcept release.ReleaseRefused as error:\n   724\t    print('refused', error)\n   725\t\"\"\"\n   726\tWRITER_FAULT = (\"                record['forecast'] = FORECAST_UNAVAILABLE\\n            else:\\n                record['answers'] = labels\\n                record['answer'] = _answer(\",\n   727\t                \"                record['forecast'] = FORECAST_UNAVAILABLE\\n                record['condition'] = 'FY2027 revenue is at least $350 billion'\\n            else:\\n\"\n   728\t                \"                record['answers'] = labels\\n                record['answer'] = _answer(\")\n   729\tSELF_CHECK = (\"    check_export(data)\\n    return data\\n\", \"    return data\\n\")\n   730\t\n   731\t\n   732\tdef test_25_the_writer_refuses_its_own_off_list_field(stores, tmp_path):\n   733\t    \"\"\"§1 release_export (AGENTS §3, council 75), the mutation pair: a writer fault adding `condition` is refused inside\n   734\t    `release_export`; with the writer's own check removed, the off-list field is returned.\"\"\"\n   735\t    driver = tmp_path / 'driver.py'\n   736\t    driver.write_text(DRIVER)\n   737\t    for name, edits, expected in (('fault', [WRITER_FAULT], 'refused'), ('unchecked', [WRITER_FAULT, SELF_CHECK], 'returned')):\n   738\t        command = scratch(tmp_path / name, [('src/hivemind/release.py', *edit) for edit in edits])\n   739\t        result = subprocess.run([sys.executable, str(driver), str(command.parents[1] / 'src'), str(stores[0]), str(stores[1])], capture_output=True, text=True,\n   740\t                                env={**os.environ, 'PYTHONDONTWRITEBYTECODE': '1'})\n   741\t        assert result.stdout.startswith(expected), (name, result.stdout, result.stderr)\n   742\t        if name == 'unchecked':\n   743\t            assert result.stdout.strip() == \"returned ['class', 'condition', 'evidence', 'forecast', 'id', 'open', 'question']\", result.stdout\n   744\t        else:\n   745\t            assert result.stdout.strip() == \"refused question 0: keys off the allow-list ['condition'], missing []\", result.stdout\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_14","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba scripts/release_build.py\nnl -ba src/hivemind/release.py | sed -n '1,250p'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba scripts/release_build.py\nnl -ba src/hivemind/release.py | sed -n '1,250p'\"","aggregated_output":"     1\t\"\"\"Build or check the \"Forecast unavailable\" release package (docs/research/2026-11-22-number-answers/RELEASE-BUILD.md).\n     2\t\n     3\t    release_build.py build --ledger <views.sqlite> --items <items.sqlite> [--as-of YYYY-MM-DD] --out <folder>\n     4\t    release_build.py check <folder> --ledger <views.sqlite> --items <items.sqlite>\n     5\t\n     6\tNo model or network call; both stores are read only. The package is checked in a private staging folder against the stores before\n     7\tone atomic move publishes it, and neither the package nor the report ever replaces an existing path. Exit statuses: 0 done; 1\n     8\trefused, with nothing published by this command; 2 the package is published (build) or passes (check) but the report name is taken\n     9\tor the report could not be written.\n    10\t\"\"\"\n    11\timport argparse\n    12\timport json\n    13\timport os\n    14\timport shutil\n    15\timport sys\n    16\timport time\n    17\tfrom pathlib import Path\n    18\t\n    19\tROOT = Path(__file__).resolve().parents[1]\n    20\tsys.path.insert(0, str(ROOT / 'src'))\n    21\tfrom hivemind import release, service  # noqa: E402\n    22\tfrom hivemind.views import store  # noqa: E402\n    23\t\n    24\t\n    25\tdef report_path(out):\n    26\t    return out.with_name(out.name + '.report.json')\n    27\t\n    28\t\n    29\tdef write_report(report, path):\n    30\t    \"\"\"Print the report, then publish it: 0 when it is published (naming any temporary file left behind), 2 when it is not.\"\"\"\n    31\t    print(json.dumps(report, ensure_ascii=False, indent=1))\n    32\t    try:\n    33\t        leftover = release.publish_report(report, path)\n    34\t    except OSError as error:\n    35\t        print(f'report not written ({error}); run check to write it', file=sys.stderr)\n    36\t        return 2\n    37\t    print(f'report: {path}')\n    38\t    if leftover:\n    39\t        print(f'report published; its temporary file {leftover} could not be removed', file=sys.stderr)\n    40\t    return 0\n    41\t\n    42\t\n    43\tdef build(args):\n    44\t    out = Path(args.out).absolute()\n    45\t    report = report_path(out)\n    46\t    for path in (out, report):\n    47\t        if os.path.lexists(path):\n    48\t            print(f'refused: {path} exists', file=sys.stderr)\n    49\t            return 1\n    50\t    started = time.monotonic()\n    51\t    staged = views_db = items_db = None\n    52\t    try:\n    53\t        views_db = service.open_ledger(str(release.store_path(args.ledger)))\n    54\t        items_db = store.open_read_only(str(release.store_path(args.items)))\n    55\t        bound = release.resolve(views_db, args.as_of)\n    56\t        staged = release.stage(out)\n    57\t        data = release.release_export(views_db, items_db, bound)\n    58\t        export_seconds = time.monotonic() - started\n    59\t        release.write_package(data, staged)\n    60\t        checked = time.monotonic()\n    61\t        counts, data, size = release.check_package(staged, views_db, items_db, expected_as_of=bound)\n    62\t        unresolved = release.withheld_unresolved(views_db, data)\n    63\t        check_seconds = time.monotonic() - checked\n    64\t        release.publish(staged, out)\n    65\t        staged = None                       # published: this build no longer owns the staging name\n    66\t    except Exception as error:              # any failure before publication: nothing at --out from this build\n    67\t        print(f'refused: {type(error).__name__}: {error}', file=sys.stderr)\n    68\t        return 1\n    69\t    finally:\n    70\t        if staged is not None:\n    71\t            shutil.rmtree(staged)\n    72\t        for conn in (views_db, items_db):\n    73\t            if conn is not None:\n    74\t                conn.close()\n    75\t    print(f'published {out}: {counts}')\n    76\t    summary = {'ledger': str(args.ledger), 'items': str(args.items), 'as_of': bound, 'counts': counts,\n    77\t               'withheld_unresolved': unresolved, 'data_bytes': size,\n    78\t               'export_seconds': round(export_seconds, 2), 'check_seconds': round(check_seconds, 2)}\n    79\t    return write_report(summary, report)\n    80\t\n    81\t\n    82\tdef check(args):\n    83\t    out = Path(args.package).absolute()\n    84\t    views_db = items_db = None\n    85\t    try:\n    86\t        views_db = service.open_ledger(str(release.store_path(args.ledger)))\n    87\t        items_db = store.open_read_only(str(release.store_path(args.items)))\n    88\t        started = time.monotonic()\n    89\t        counts, data, size = release.check_package(out, views_db, items_db)\n    90\t        check_seconds = time.monotonic() - started\n    91\t        unresolved = release.withheld_unresolved(views_db, data)\n    92\t    except Exception as error:\n    93\t        print(f'refused: {type(error).__name__}: {error}', file=sys.stderr)\n    94\t        return 1\n    95\t    finally:\n    96\t        for conn in (views_db, items_db):\n    97\t            if conn is not None:\n    98\t                conn.close()\n    99\t    print(f'passes {out}: {counts}')\n   100\t    summary = {'ledger': str(args.ledger), 'items': str(args.items), 'as_of': data['as_of'], 'counts': counts,\n   101\t               'withheld_unresolved': unresolved, 'data_bytes': size,\n   102\t               'export_seconds': None, 'check_seconds': round(check_seconds, 2)}\n   103\t    return write_report(summary, report_path(out))\n   104\t\n   105\t\n   106\tdef main(argv=None):\n   107\t    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)\n   108\t    commands = parser.add_subparsers(dest='command', required=True)\n   109\t    make = commands.add_parser('build')\n   110\t    make.add_argument('--ledger', required=True, type=Path)\n   111\t    make.add_argument('--items', required=True, type=Path)\n   112\t    make.add_argument('--as-of')\n   113\t    make.add_argument('--out', required=True, type=Path)\n   114\t    verify = commands.add_parser('check')\n   115\t    verify.add_argument('package', type=Path)\n   116\t    verify.add_argument('--ledger', required=True, type=Path)\n   117\t    verify.add_argument('--items', required=True, type=Path)\n   118\t    args = parser.parse_args(argv)\n   119\t    return build(args) if args.command == 'build' else check(args)\n   120\t\n   121\t\n   122\tif __name__ == '__main__':\n   123\t    sys.exit(main())\n     1\t\"\"\"The \"Forecast unavailable\" release: one allow-listed export of a views ledger, its package and its checks\n     2\t(docs/research/2026-11-22-number-answers/RELEASE-BUILD.md; D726, D756, D758).\n     3\t\n     4\tA number question carries its question, its evidence in force and the marker \"Forecast unavailable\". An event or Yes/No question\n     5\tcarries its question, its evidence and its answer labels. Nothing else is read into the package: no rung condition or bound, no\n     6\tjudgement reason or explanation, no switch reason, no history. Before a package is published, every field is compared with its\n     7\tstored source at the package's day, and nothing published replaces an existing path.\n     8\t\"\"\"\n     9\timport ctypes\n    10\timport ctypes.util\n    11\timport errno\n    12\timport hashlib\n    13\timport json\n    14\timport os\n    15\timport stat\n    16\timport sys\n    17\timport tempfile\n    18\tfrom datetime import date\n    19\tfrom pathlib import Path\n    20\t\n    21\tfrom . import bundle, service, vocabulary\n    22\tfrom .views import identity, store\n    23\t\n    24\tFORMAT = 'hivemind-release/1'\n    25\tALLOW_LIST = 'release-allow-list/1'\n    26\tFORECAST_UNAVAILABLE = 'Forecast unavailable'\n    27\tDATA_FILE = 'release-data.json'\n    28\tMANIFEST_FILE = 'manifest.json'\n    29\tPACKAGE_FILES = frozenset({DATA_FILE, MANIFEST_FILE})\n    30\tCLASSES = ('number', 'event', 'yes_no')\n    31\tALLOWED = {\n    32\t    'envelope': frozenset({'format', 'allow_list', 'as_of', 'questions'}),\n    33\t    'number': frozenset({'id', 'question', 'open', 'class', 'forecast', 'evidence'}),\n    34\t    'answered': frozenset({'id', 'question', 'open', 'class', 'answers', 'answer', 'evidence'}),\n    35\t    'evidence': frozenset({'id', 'one_line', 'quote', 'tier', 'speaker', 'original_who', 'original_day', 'sources'}),\n    36\t    'source': frozenset({'title', 'publisher', 'day', 'uri'}),\n    37\t    'manifest': frozenset({'format', 'allow_list', 'as_of', 'data_sha256'}),\n    38\t}\n    39\tEVIDENCE_TEXT = ('one_line', 'quote', 'tier', 'speaker', 'original_who', 'original_day')\n    40\tSOURCE_TEXT = ('title', 'publisher', 'day', 'uri')\n    41\tRENAME_EXCL = 0x4          # macOS <stdio.h>: renamex_np refuses an existing destination\n    42\tRENAME_NOREPLACE = 0x1     # Linux <linux/fs.h>: renameat2 refuses an existing destination\n    43\tAT_FDCWD = -100\n    44\t\n    45\t\n    46\tclass ReleaseRefused(ValueError):\n    47\t    \"\"\"The release refuses the input, the export or the package; the message names what and where.\"\"\"\n    48\t\n    49\t\n    50\t# ---------- the day\n    51\t\n    52\tdef canonical_day(text):\n    53\t    \"\"\"A day written YYYY-MM-DD, returned unchanged; anything else is refused. The stores compare days as text, so a day Python\n    54\t    also reads (20260825) would select rows from later days.\"\"\"\n    55\t    try:\n    56\t        day = date.fromisoformat(text)\n    57\t    except (TypeError, ValueError):\n    58\t        raise ReleaseRefused(f'not a day: {text!r}') from None\n    59\t    if day.isoformat() != text:\n    60\t        raise ReleaseRefused(f'a day must be written YYYY-MM-DD: {text!r}')\n    61\t    return text\n    62\t\n    63\t\n    64\tdef resolve(views_db, as_of=None):\n    65\t    \"\"\"The bound of a build or a check, one rule for both: a given day must be canonical; `service.resolve_bound` then refuses an\n    66\t    unfinished first day or a day after the last completed day; an omitted day with no default is refused.\"\"\"\n    67\t    if as_of is not None:\n    68\t        canonical_day(as_of)\n    69\t    bound = service.resolve_bound(views_db, as_of)\n    70\t    if not bound:\n    71\t        raise ReleaseRefused('the store has no default day; supply --as-of')\n    72\t    return canonical_day(bound)\n    73\t\n    74\t\n    75\t# ---------- identity\n    76\t\n    77\tdef _has_table(conn, name):\n    78\t    return conn.execute(\"select 1 from sqlite_master where type='table' and name=?\", (name,)).fetchone() is not None\n    79\t\n    80\t\n    81\tdef key_measure(conn, view_id, as_of):\n    82\t    \"\"\"The measure of the view's key as recorded on or before the day, or None: no key table, no key, or a key written after the\n    83\t    day (a later key never reclassifies an earlier package).\"\"\"\n    84\t    if not _has_table(conn, 'view_keys'):\n    85\t        return None\n    86\t    row = conn.execute('select measure, seq from view_keys where view_id=?', (view_id,)).fetchone()\n    87\t    return row['measure'] if row is not None and service.visible(conn, row['seq'], as_of) else None\n    88\t\n    89\t\n    90\tdef ladder(conn, view_id):\n    91\t    \"\"\"(position, label) of every rung, by position: the only rung columns the package reads.\"\"\"\n    92\t    return [(row['position'], row['label']) for row in conn.execute('select position, label from rungs where view_id=? order by position', (view_id,))]\n    93\t\n    94\t\n    95\tdef question_class(conn, view_id, labels, as_of):\n    96\t    \"\"\"'event' for an event measure in the key recorded by the day, 'yes_no' for exactly two labels that are Yes and No in the stored\n    97\t    vocabulary, else 'number' (a view with no key and a ladder whose bands do not resolve included): the forecast of every number\n    98\t    question is withheld.\"\"\"\n    99\t    if key_measure(conn, view_id, as_of) in identity.EVENT_MEASURES:\n   100\t        return 'event'\n   101\t    if len(labels) == 2 and {vocabulary.canonical('label', label) for label in labels} == {'Yes', 'No'}:\n   102\t        return 'yes_no'\n   103\t    return 'number'\n   104\t\n   105\t\n   106\tdef _answer(conn, view_id, as_of, positions):\n   107\t    \"\"\"The stored label of the latest judgement's rung on or before the day, or None when the question is not yet judged.\"\"\"\n   108\t    row = conn.execute('select rung from judgements where view_id=? and publication_day<=? order by judgement_id desc limit 1', (view_id, as_of)).fetchone()\n   109\t    if row is None:\n   110\t        return None\n   111\t    if row['rung'] not in positions:\n   112\t        raise ReleaseRefused(f'{view_id}: its latest judgement names rung {row[\"rung\"]}, which its ladder does not hold')\n   113\t    return positions[row['rung']]\n   114\t\n   115\t\n   116\t# ---------- the export\n   117\t\n   118\tdef _item(items_db, cache, input_id, evidence_id):\n   119\t    if input_id not in cache:\n   120\t        row = items_db.execute('select title, publisher, source_uri from items where input_id=?', (input_id,)).fetchone()\n   121\t        if row is None:\n   122\t            raise ReleaseRefused(f'evidence {evidence_id}: source item {input_id} is not in the items database')\n   123\t        cache[input_id] = row\n   124\t    return cache[input_id]\n   125\t\n   126\t\n   127\tdef _visible_views(conn, as_of):\n   128\t    return [row for row in conn.execute('select view_id, question, created_seq from views order by created_seq, rowid') if service.visible(conn, row['created_seq'], as_of)]\n   129\t\n   130\t\n   131\tdef release_export(views_db, items_db, as_of=None):\n   132\t    \"\"\"The release data as of the bound: every question visible on that day, closed ones included, built field by field from the\n   133\t    allow-list. The result passes `check_export` or nothing is returned.\"\"\"\n   134\t    with bundle.read_snapshot(views_db, items_db):\n   135\t        bound = resolve(views_db, as_of)\n   136\t        items, questions = {}, []\n   137\t        for view in _visible_views(views_db, bound):\n   138\t            view_id = view['view_id']\n   139\t            rungs = ladder(views_db, view_id)\n   140\t            labels = [label for _, label in rungs]\n   141\t            kind = question_class(views_db, view_id, labels, bound)\n   142\t            record = {'id': view_id, 'question': view['question'], 'open': service.is_open_as_of(views_db, view_id, bound), 'class': kind}\n   143\t            if kind == 'number':\n   144\t                record['forecast'] = FORECAST_UNAVAILABLE\n   145\t            else:\n   146\t                record['answers'] = labels\n   147\t                record['answer'] = _answer(views_db, view_id, bound, dict(rungs))\n   148\t            evidence = []\n   149\t            for piece in service.evidence(views_db, view_id, bound):\n   150\t                sources = []\n   151\t                for source in piece['sources']:\n   152\t                    item = _item(items_db, items, source['input_id'], piece['evidence_id'])\n   153\t                    sources.append({'title': item['title'], 'publisher': item['publisher'], 'day': source['publication_day'], 'uri': item['source_uri']})\n   154\t                evidence.append({'id': piece['evidence_id'], **{name: piece[name] for name in EVIDENCE_TEXT}, 'sources': sources})\n   155\t            record['evidence'] = evidence\n   156\t            questions.append(record)\n   157\t        data = {'format': FORMAT, 'allow_list': ALLOW_LIST, 'as_of': bound, 'questions': questions}\n   158\t    check_export(data)\n   159\t    return data\n   160\t\n   161\t\n   162\t# ---------- the closed set\n   163\t\n   164\tdef _keys(value, kind, where):\n   165\t    if not isinstance(value, dict):\n   166\t        raise ReleaseRefused(f'{where}: not an object')\n   167\t    if set(value) != ALLOWED[kind]:\n   168\t        extra, missing = sorted(set(value) - ALLOWED[kind]), sorted(ALLOWED[kind] - set(value))\n   169\t        raise ReleaseRefused(f'{where}: keys off the allow-list {extra}, missing {missing}')\n   170\t\n   171\t\n   172\tdef _texts(value, names, where):\n   173\t    for name in names:\n   174\t        if not isinstance(value[name], str):\n   175\t            raise ReleaseRefused(f'{where}: {name} is not text')\n   176\t\n   177\t\n   178\tdef check_export(data):\n   179\t    \"\"\"Every object at every level holds exactly its record type's keys, with values of the allowed kinds. Returns the counts\n   180\t    judged.\"\"\"\n   181\t    _keys(data, 'envelope', 'the package')\n   182\t    if data['format'] != FORMAT or data['allow_list'] != ALLOW_LIST:\n   183\t        raise ReleaseRefused(f'the package names format {data[\"format\"]!r} and allow-list {data[\"allow_list\"]!r}')\n   184\t    canonical_day(data['as_of'])\n   185\t    if not isinstance(data['questions'], list):\n   186\t        raise ReleaseRefused('the package: questions is not a list')\n   187\t    counts = {'questions': {kind: 0 for kind in CLASSES}, 'evidence': 0, 'sources': 0}\n   188\t    for position, question in enumerate(data['questions']):\n   189\t        where = f'question {position}'\n   190\t        if not isinstance(question, dict) or question.get('class') not in CLASSES:\n   191\t            raise ReleaseRefused(f'{where}: no allowed class')\n   192\t        kind = question['class']\n   193\t        _keys(question, 'number' if kind == 'number' else 'answered', where)\n   194\t        _texts(question, ('id', 'question'), where)\n   195\t        where = f'question {question[\"id\"]}'\n   196\t        if not isinstance(question['open'], bool):\n   197\t            raise ReleaseRefused(f'{where}: open is not true or false')\n   198\t        if kind == 'number':\n   199\t            if question['forecast'] != FORECAST_UNAVAILABLE:\n   200\t                raise ReleaseRefused(f'{where}: a number question carries only the marker')\n   201\t        else:\n   202\t            answers = question['answers']\n   203\t            if not (isinstance(answers, list) and len(answers) == 2 and all(isinstance(a, str) for a in answers)):\n   204\t                raise ReleaseRefused(f'{where}: answers are not two labels')\n   205\t            if question['answer'] is not None and question['answer'] not in answers:\n   206\t                raise ReleaseRefused(f'{where}: the answer is not one of its labels')\n   207\t        if not isinstance(question['evidence'], list):\n   208\t            raise ReleaseRefused(f'{where}: evidence is not a list')\n   209\t        for piece in question['evidence']:\n   210\t            _keys(piece, 'evidence', f'{where} evidence')\n   211\t            _texts(piece, ('id',), f'{where} evidence')\n   212\t            _texts(piece, EVIDENCE_TEXT, f'{where} evidence {piece[\"id\"]}')\n   213\t            if not isinstance(piece['sources'], list):\n   214\t                raise ReleaseRefused(f'{where} evidence {piece[\"id\"]}: sources is not a list')\n   215\t            for source in piece['sources']:\n   216\t                _keys(source, 'source', f'{where} evidence {piece[\"id\"]} source')\n   217\t                _texts(source, SOURCE_TEXT, f'{where} evidence {piece[\"id\"]} source')\n   218\t            counts['sources'] += len(piece['sources'])\n   219\t        counts['evidence'] += len(question['evidence'])\n   220\t        counts['questions'][kind] += 1\n   221\t    return counts\n   222\t\n   223\t\n   224\t# ---------- the origin check\n   225\t\n   226\tdef _open_at(conn, view_id, as_of):\n   227\t    for row in conn.execute('select open, after_seq from view_switches where view_id=? order by id desc', (view_id,)):\n   228\t        if service.visible(conn, row['after_seq'], as_of):\n   229\t            return bool(row['open'])\n   230\t    return True\n   231\t\n   232\t\n   233\tdef _expected_evidence(views_db, items_db, view_id, as_of):\n   234\t    \"\"\"The evidence in force at the day, by its own SQL: visible links in link order, minus those whose latest replacement is\n   235\t    visible; each source row visible at the day, in row order, with its item required.\"\"\"\n   236\t    out = []\n   237\t    for link in views_db.execute('select evidence_id, seq from evidence_links where view_id=? order by id', (view_id,)).fetchall():\n   238\t        if not service.visible(views_db, link['seq'], as_of):\n   239\t            continue\n   240\t        latest = views_db.execute('select seq from replacements where old_evidence_id=? order by id desc limit 1', (link['evidence_id'],)).fetchone()\n   241\t        if latest is not None and service.visible(views_db, latest['seq'], as_of):\n   242\t            continue\n   243\t        row = views_db.execute(f'select evidence_id, {\", \".join(EVIDENCE_TEXT)} from evidence where evidence_id=?', (link['evidence_id'],)).fetchone()\n   244\t        if row is None:\n   245\t            raise ReleaseRefused(f'{view_id}: link to evidence {link[\"evidence_id\"]}, which the store does not hold')\n   246\t        sources = []\n   247\t        for source in views_db.execute('select input_id, publication_day, seq from evidence_sources where evidence_id=? order by id', (link['evidence_id'],)).fetchall():\n   248\t            if not service.visible(views_db, source['seq'], as_of):\n   249\t                continue\n   250\t            item = items_db.execute('select title, publisher, source_uri from items where input_id=?', (source['input_id'],)).fetchone()\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_15","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba src/hivemind/release.py | sed -n '250,490p'\nnl -ba docs/research/2026-11-22-number-answers/RELEASE-BUILD.md | sed -n '11,33p;77,170p'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba src/hivemind/release.py | sed -n '250,490p'\nnl -ba docs/research/2026-11-22-number-answers/RELEASE-BUILD.md | sed -n '11,33p;77,170p'\"","aggregated_output":"   250\t            item = items_db.execute('select title, publisher, source_uri from items where input_id=?', (source['input_id'],)).fetchone()\n   251\t            if item is None:\n   252\t                raise ReleaseRefused(f'evidence {row[\"evidence_id\"]}: source item {source[\"input_id\"]} is not in the items database')\n   253\t            sources.append({'title': item['title'], 'publisher': item['publisher'], 'day': source['publication_day'], 'uri': item['source_uri']})\n   254\t        out.append({'id': row['evidence_id'], **{name: row[name] for name in EVIDENCE_TEXT}, 'sources': sources})\n   255\t    return out\n   256\t\n   257\t\n   258\tdef _leaves(value):\n   259\t    if isinstance(value, dict):\n   260\t        return sum(_leaves(v) for v in value.values())\n   261\t    if isinstance(value, list):\n   262\t        return sum(_leaves(v) for v in value)\n   263\t    return 1\n   264\t\n   265\t\n   266\tdef _compare(expected, actual, where):\n   267\t    \"\"\"The number of leaf values compared; the first difference is refused, naming where it is.\"\"\"\n   268\t    if isinstance(expected, dict):\n   269\t        if not isinstance(actual, dict) or set(expected) != set(actual):\n   270\t            raise ReleaseRefused(f'{where}: fields differ from the store')\n   271\t        return sum(_compare(expected[key], actual[key], f'{where}.{key}') for key in expected)\n   272\t    if isinstance(expected, list):\n   273\t        if not isinstance(actual, list) or len(expected) != len(actual):\n   274\t            raise ReleaseRefused(f'{where}: {len(actual) if isinstance(actual, list) else \"no\"} entries where the store has {len(expected)}')\n   275\t        return sum(_compare(e, a, f'{where}[{n}]') for n, (e, a) in enumerate(zip(expected, actual)))\n   276\t    if type(expected) is not type(actual) or expected != actual:\n   277\t        raise ReleaseRefused(f'{where}: differs from the store')\n   278\t    return 1\n   279\t\n   280\t\n   281\tdef check_origins(views_db, items_db, data, expected_as_of):\n   282\t    \"\"\"Every package field against its permitted stored source at `expected_as_of`, derived from the store and never from the\n   283\t    package: the day, each question's class, the questions, evidence and sources in order with their counts. Its reads are its own\n   284\t    SQL, apart from the identity rule (`question_class`) and the day of a sequence number (`service.visible`). Returns the number of\n   285\t    fields compared.\"\"\"\n   286\t    with bundle.read_snapshot(views_db, items_db):\n   287\t        as_of = canonical_day(expected_as_of)\n   288\t        if data['as_of'] != as_of:\n   289\t            raise ReleaseRefused(f'the package is dated {data[\"as_of\"]}, the store bound is {as_of}')\n   290\t        views = [row for row in views_db.execute('select view_id, question, created_seq from views order by created_seq, rowid')\n   291\t                 if service.visible(views_db, row['created_seq'], as_of)]\n   292\t        packaged = data['questions']\n   293\t        if [q['id'] for q in packaged] != [row['view_id'] for row in views]:\n   294\t            raise ReleaseRefused(f'the questions differ from the store: {len(packaged)} entries where the store has {len(views)}'\n   295\t                                 if len(packaged) != len(views) else 'the questions or their order differ from the store')\n   296\t        compared = _compare(FORMAT, data['format'], 'package.format') + _compare(ALLOW_LIST, data['allow_list'], 'package.allow_list') + 1\n   297\t        for view, question in zip(views, packaged):\n   298\t            view_id = view['view_id']\n   299\t            positions = {row['position']: row['label'] for row in views_db.execute('select position, label from rungs where view_id=? order by position', (view_id,))}\n   300\t            labels = list(positions.values())\n   301\t            kind = question_class(views_db, view_id, labels, as_of)\n   302\t            record = {'id': view_id, 'question': view['question'], 'open': _open_at(views_db, view_id, as_of), 'class': kind}\n   303\t            if kind == 'number':\n   304\t                record['forecast'] = FORECAST_UNAVAILABLE\n   305\t            else:\n   306\t                latest = views_db.execute('select rung from judgements where view_id=? and publication_day<=? order by judgement_id desc limit 1', (view_id, as_of)).fetchone()\n   307\t                if latest is not None and latest['rung'] not in positions:\n   308\t                    raise ReleaseRefused(f'question {view_id}: its latest judgement names rung {latest[\"rung\"]}, which its ladder does not hold')\n   309\t                record['answers'] = labels\n   310\t                record['answer'] = None if latest is None else positions[latest['rung']]\n   311\t            expected_evidence = _expected_evidence(views_db, items_db, view_id, as_of)\n   312\t            if not isinstance(question.get('evidence'), list) or len(question['evidence']) != len(expected_evidence):\n   313\t                found = len(question['evidence']) if isinstance(question.get('evidence'), list) else 'no'\n   314\t                raise ReleaseRefused(f'question {view_id}.evidence: {found} entries where the store has {len(expected_evidence)}')\n   315\t            record['evidence'] = question['evidence']           # compared piece by piece below, named by the stored evidence id\n   316\t            compared += _compare(record, question, f'question {view_id}') - _leaves(question['evidence'])\n   317\t            for expected, actual in zip(expected_evidence, question['evidence']):\n   318\t                compared += _compare(expected, actual, f'question {view_id}.evidence {expected[\"id\"]}')\n   319\t        return compared\n   320\t\n   321\t\n   322\t# ---------- the package\n   323\t\n   324\tdef _dump(value):\n   325\t    return json.dumps(value, ensure_ascii=False, separators=(',', ':')).encode('utf-8')\n   326\t\n   327\t\n   328\tdef stage(out_dir):\n   329\t    \"\"\"A private staging folder, unique to this invocation, beside the destination.\"\"\"\n   330\t    out_dir = Path(out_dir)\n   331\t    return Path(tempfile.mkdtemp(dir=out_dir.parent, prefix=f'.{out_dir.name}.staging-'))\n   332\t\n   333\t\n   334\tdef write_package(data, staged):\n   335\t    \"\"\"The data file and its manifest, written into the staging folder.\"\"\"\n   336\t    payload = _dump(data)\n   337\t    (Path(staged) / DATA_FILE).write_bytes(payload)\n   338\t    manifest = {'format': data['format'], 'allow_list': data['allow_list'], 'as_of': data['as_of'], 'data_sha256': hashlib.sha256(payload).hexdigest()}\n   339\t    (Path(staged) / MANIFEST_FILE).write_bytes(_dump(manifest))\n   340\t\n   341\t\n   342\tdef _no_replace_rename():\n   343\t    libc = ctypes.CDLL(ctypes.util.find_library('c'), use_errno=True)\n   344\t    if sys.platform == 'darwin' and hasattr(libc, 'renamex_np'):\n   345\t        call = libc.renamex_np\n   346\t        call.argtypes, call.restype = [ctypes.c_char_p, ctypes.c_char_p, ctypes.c_uint], ctypes.c_int\n   347\t        return lambda source, target: call(source, target, RENAME_EXCL)\n   348\t    if sys.platform.startswith('linux') and hasattr(libc, 'renameat2'):\n   349\t        call = libc.renameat2\n   350\t        call.argtypes, call.restype = [ctypes.c_int, ctypes.c_char_p, ctypes.c_int, ctypes.c_char_p, ctypes.c_uint], ctypes.c_int\n   351\t        return lambda source, target: call(AT_FDCWD, source, AT_FDCWD, target, RENAME_NOREPLACE)\n   352\t    return None\n   353\t\n   354\t\n   355\tdef publish(staged, out_dir):\n   356\t    \"\"\"One atomic move of the staged folder to the destination that refuses any existing destination, empty or not.\"\"\"\n   357\t    rename = _no_replace_rename()\n   358\t    if rename is None:\n   359\t        raise ReleaseRefused('this platform offers no atomic rename that refuses an existing destination')\n   360\t    if rename(os.fsencode(str(staged)), os.fsencode(str(out_dir))) != 0:\n   361\t        code = ctypes.get_errno()\n   362\t        if code in (errno.ENOTSUP, errno.EINVAL, errno.ENOSYS):\n   363\t            raise ReleaseRefused(f'the filesystem refuses an atomic no-replace rename ({os.strerror(code)})')\n   364\t        raise OSError(code, os.strerror(code), str(out_dir))\n   365\t\n   366\t\n   367\tdef publish_report(report, path):\n   368\t    \"\"\"The report, written to a private temporary file and linked to its name; the link refuses any existing path, and its success\n   369\t    is the moment the report is published. Returns None, or the temporary file it could not remove after publishing.\"\"\"\n   370\t    path = Path(path)\n   371\t    descriptor, temporary = tempfile.mkstemp(dir=path.parent, prefix=f'.{path.name}.')\n   372\t    try:\n   373\t        with os.fdopen(descriptor, 'wb') as handle:\n   374\t            handle.write(json.dumps(report, ensure_ascii=False, indent=1).encode('utf-8'))\n   375\t        os.link(temporary, path)\n   376\t    except BaseException:\n   377\t        os.unlink(temporary)\n   378\t        raise\n   379\t    try:\n   380\t        os.unlink(temporary)\n   381\t    except OSError:\n   382\t        return temporary\n   383\t    return None\n   384\t\n   385\t\n   386\tdef _unique_members(pairs):\n   387\t    names = [name for name, _ in pairs]\n   388\t    if len(names) != len(set(names)):\n   389\t        raise ReleaseRefused(f'a JSON member name repeats: {sorted({n for n in names if names.count(n) > 1})}')\n   390\t    return dict(pairs)\n   391\t\n   392\t\n   393\tdef read_data(package):\n   394\t    \"\"\"The package's data, read with the repeated-member check. `check_package` returns the data it checked, which is the copy to\n   395\t    trust; this reader is for inspection only.\"\"\"\n   396\t    return _parse((Path(package) / DATA_FILE).read_bytes(), DATA_FILE)\n   397\t\n   398\t\n   399\tURI_CHARACTERS = '%?#'\n   400\t\n   401\t\n   402\tdef store_path(path):\n   403\t    \"\"\"The resolved store path, the one the opener is then given (so the opener's own resolution has nothing left to follow): refused\n   404\t    when it holds a character a SQLite URI decodes (`store.open_read_only` puts the path into a `file:` URI unescaped, so `%2D` would\n   405\t    open a `-`).\"\"\"\n   406\t    real = os.path.realpath(path)\n   407\t    found = sorted({c for c in real if c in URI_CHARACTERS})\n   408\t    if found:\n   409\t        raise ReleaseRefused(f'{path}: a store path may not contain {found}, which the SQLite opener reads as URI syntax')\n   410\t    return real\n   411\t\n   412\t\n   413\tdef _read_regular(folder, name, where):\n   414\t    \"\"\"The bytes of one regular file in an opened folder, read once through a descriptor that refuses a symbolic link and opens a pipe\n   415\t    without waiting, so its type is refused instead.\"\"\"\n   416\t    try:\n   417\t        descriptor = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=folder)   # a pipe or device never blocks the check\n   418\t    except OSError as error:\n   419\t        if error.errno == errno.ELOOP:\n   420\t            raise ReleaseRefused(f'{where}/{name}: not a regular file') from None\n   421\t        raise\n   422\t    try:\n   423\t        if not stat.S_ISREG(os.fstat(descriptor).st_mode):\n   424\t            raise ReleaseRefused(f'{where}/{name}: not a regular file')\n   425\t        chunks = []\n   426\t        while True:\n   427\t            chunk = os.read(descriptor, 1 << 20)\n   428\t            if not chunk:\n   429\t                return b''.join(chunks)\n   430\t            chunks.append(chunk)\n   431\t    finally:\n   432\t        os.close(descriptor)\n   433\t\n   434\t\n   435\tdef _parse(raw, name):\n   436\t    try:\n   437\t        return json.loads(raw.decode('utf-8'), object_pairs_hook=_unique_members)\n   438\t    except (UnicodeDecodeError, json.JSONDecodeError) as error:\n   439\t        raise ReleaseRefused(f'{name}: not JSON ({error})') from None\n   440\t\n   441\t\n   442\tdef check_package(path, views_db=None, items_db=None, expected_as_of=None):\n   443\t    \"\"\"The package as a reader receives it: a real folder holding exactly the two regular files, each read once through one handle on\n   444\t    the folder; JSON with no repeated member name; a closed manifest that agrees with the data and the sha256 of the very bytes\n   445\t    parsed; data that passes `check_export` and, with the stores, `check_origins` at `expected_as_of` (or at the package's own day\n   446\t    passed through `resolve`). Returns (counts, the data checked, its size in bytes).\"\"\"\n   447\t    path = Path(path)\n   448\t    try:\n   449\t        folder = os.open(path, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)\n   450\t    except OSError as error:\n   451\t        if error.errno in (errno.ELOOP, errno.ENOTDIR):\n   452\t            raise ReleaseRefused(f'{path}: not a folder') from None\n   453\t        raise\n   454\t    try:\n   455\t        names = os.listdir(folder)\n   456\t        if sorted(names) != sorted(PACKAGE_FILES):\n   457\t            raise ReleaseRefused(f'{path}: holds {sorted(names)}, not exactly {sorted(PACKAGE_FILES)}')\n   458\t        raw, manifest_raw = _read_regular(folder, DATA_FILE, path), _read_regular(folder, MANIFEST_FILE, path)\n   459\t    finally:\n   460\t        os.close(folder)\n   461\t    manifest, data = _parse(manifest_raw, MANIFEST_FILE), _parse(raw, DATA_FILE)\n   462\t    counts = check_export(data)\n   463\t    _keys(manifest, 'manifest', 'the manifest')\n   464\t    if manifest['data_sha256'] != hashlib.sha256(raw).hexdigest():\n   465\t        raise ReleaseRefused('the manifest sha256 does not match the data file')\n   466\t    for name in ('format', 'allow_list', 'as_of'):\n   467\t        if manifest[name] != data[name]:\n   468\t            raise ReleaseRefused(f'the manifest {name} {manifest[name]!r} differs from the data {data[name]!r}')\n   469\t    if views_db is not None:\n   470\t        bound = expected_as_of if expected_as_of is not None else resolve(views_db, data['as_of'])\n   471\t        counts['fields_compared'] = check_origins(views_db, items_db, data, bound)\n   472\t    return counts, data, len(raw)\n   473\t\n   474\t\n   475\t# ---------- the report\n   476\t\n   477\tdef withheld_unresolved(views_db, data):\n   478\t    \"\"\"For the release report only: the number questions whose ladder does not resolve to bands, with the reason and whether the\n   479\t    view has a key. Withheld like every number question; this list never enters the package.\"\"\"\n   480\t    out = []\n   481\t    for question in data['questions']:\n   482\t        if question['class'] != 'number':\n   483\t            continue\n   484\t        bands, reason = service.ladder_bands(store.rungs_of(views_db, question['id']))\n   485\t        if bands is None:\n   486\t            out.append({'id': question['id'], 'reason': reason, 'has_key': key_measure(views_db, question['id'], data['as_of']) is not None})\n   487\t    return out\n    11\t  `fstat`). It hashes and parses the same bytes and returns `(counts, data, bytes)`, so the command reports what was checked.\n    12\t- **A store path whose resolved form holds `%`, `?` or `#` is refused** (`release.store_path`), because `store.open_read_only` puts\n    13\t  the path into a SQLite `file:` URI unescaped (test 24). The opener itself is shared POC code and is not changed here.\n    14\t- **The writer's own refusal** is proved by a scratch-copy pair (test 25).\n    15\t- **Both commands print the whole report** before publishing it. Durations use `time.monotonic`. Refusals name the evidence id.\n    16\t- **Council 75b** (`codex-r75b.md`):\n    17\t  - `store_path` returns the resolved path, which the opener is given, so a link is not resolved twice (test 24);\n    18\t  - package files are opened without waiting (`O_NONBLOCK`), so a named pipe is refused by type instead of blocking `check` (test 15);\n    19\t  - reordered questions and evidence are tested (test 10).\n    20\t- **Councils 75c and 75d, verification only.** The mutant runner judges each catch from the full failure message in pytest's XML\n    21\t  report. One structural rule holds for every acceptance assertion: compare against fixed expected values written down before the run,\n    22\t  never values taken from the output under test, and match each refusal's exact reason. Council 75e: applied to every assertion in\n    23\t  `tests/test_release.py` and every check in `release_check.py`. Release work was opened by the council under D439 (D758). The behaviour is\n    24\tfixed by D726, D756 and `FORECAST-UNAVAILABLE-DESIGN.md` (revision 4). This page holds the AGENTS §2 tables for the first slice.\n    25\t\n    26\t**Revision 2 answers `codex-r74.md`** (see `claude-r74.md`):\n    27\t- the pass condition is an origin check of every field against its stored source, not a string sweep;\n    28\t- a missing source item is refused;\n    29\t- the package is checked before it is moved into place;\n    30\t- the manifest is a closed set;\n    31\t- the bound is validated as a date;\n    32\t- narrow reads;\n    33\t- size and speed budgets;\n    77\t  anything exists there.\n    78\t\n    79\tVerified on this Mac: `os.link` refuses an existing file, a case-variant name of it (`ITEMS.SQLITE` for `items.sqlite`), and a\n    80\tsymbolic link, leaving each untouched. An input database always exists, so no report can replace one. The path comparison of\n    81\trevision 7 is subsumed and dropped.\n    82\t\n    83\t**Revision 9 answers `codex-r74h.md`.**\n    84\t- A report is published the moment its link succeeds. A later failure to remove the temporary file is reported as published, naming\n    85\t  the leftover file.\n    86\t- `check`'s exit statuses are explicit, and the end-to-end tests assert them.\n    87\t\n    88\t**Revision 10 answers `codex-r74i.md`:** `check` follows the build's rule. Any failure to publish the report before the link succeeds\n    89\t(the name occupied, or the temporary file not created or written, such as `EACCES`) is exit 2 after the printed pass.\n    90\t\n    91\t## 0. Scope\n    92\t\n    93\t- **Slice 1 (this page), $0:**\n    94\t  - the exporter `release_export` and its self-check;\n    95\t  - the package writer, the package check and the origin check;\n    96\t  - the release builder, which calls the exporter directly;\n    97\t  - tests and mutants;\n    98\t  - the $0 release check on stored stores.\n    99\t- **Slice 2, next.** The release page reads only the package: no live service, no `/library` fetch, no translated JSON, no composite\n   100\t  trials, no idea submission control or route. It gets a browser check of the `old-1/v8` screen, which completes D756's screen check.\n   101\t- **No idea submission in the release** (council 74). The idea path (`idea.py`) reads the ledger at every step and calls a paid model\n   102\t  per idea. The design's §5 idea acceptance (an idea card backed only by `v8`, and its composed request) is carried forward as pending\n   103\t  for the first idea-enabled slice.\n   104\t- **Not in scope:**\n   105\t  - the POC, its API, MCP and page (unchanged);\n   106\t  - colleagues' page;\n   107\t  - frozen pieces, extraction included;\n   108\t  - any model call;\n   109\t  - commit, publish, deploy.\n   110\t\n   111\t## 1. What is built\n   112\t\n   113\t`src/hivemind/release.py` is the one owner, beside `service.py`.\n   114\t\n   115\t- **Constants:**\n   116\t  - `FORMAT = 'hivemind-release/1'`;\n   117\t  - `ALLOW_LIST = 'release-allow-list/1'`;\n   118\t  - `FORECAST_UNAVAILABLE = 'Forecast unavailable'`;\n   119\t  - `PACKAGE_FILES = {'manifest.json', 'release-data.json'}`.\n   120\t- **`ALLOWED`:** the closed key set per record type.\n   121\t\n   122\t  | Record | Keys |\n   123\t  |---|---|\n   124\t  | envelope | `format`, `allow_list`, `as_of`, `questions` |\n   125\t  | number question | `id`, `question`, `open`, `class` (= `number`), `forecast` (= the marker), `evidence` |\n   126\t  | event or Yes/No question | `id`, `question`, `open`, `class` (`event` or `yes_no`), `answers` (the two stored rung labels, in position order), `answer` (the stored label of the latest judgement's rung on or before the bound, or null), `evidence` |\n   127\t  | evidence in force at the bound | `id`, `one_line`, `quote`, `tier`, `speaker`, `original_who`, `original_day`, `sources` |\n   128\t  | source recorded on or before the bound | `title`, `publisher`, `day`, `uri` |\n   129\t  | manifest | `format`, `allow_list`, `as_of`, `data_sha256` |\n   130\t\n   131\t- **`question_class(views_db, view_id, labels)`** (design §3):\n   132\t  - `event` when the view key's measure is in `identity.EVENT_MEASURES`. The key is read as `select measure from view_keys`, and\n   133\t    only when the table exists;\n   134\t  - `yes_no` when there are exactly two labels which, through `vocabulary.canonical('label', …)`, are `Yes` and `No` in either order;\n   135\t  - `number` otherwise: a view with no key, or one whose bands cannot be resolved.\n   136\t- **`release_export(views_db, items_db, as_of=None)`:**\n   137\t  - pins both connections (`bundle.read_snapshot`);\n   138\t  - takes an explicit day only in canonical form: `date.fromisoformat(day).isoformat()` must equal the text given, otherwise\n   139\t    `ReleaseRefused` (so `20260825` is refused, not read as `2026-08-25`). It then resolves the bound with `service.resolve_bound`,\n   140\t    refuses a store with no default day, and uses that canonical text in every query;\n   141\t  - exports every view that exists at the bound (`service.view_exists`), closed ones included, in `created_seq, rowid` order;\n   142\t  - builds each record field by field from the table above, with column-limited SQL:\n   143\t    - `select view_id, question, created_seq from views order by created_seq, rowid`;\n   144\t    - `select position, label from rungs`;\n   145\t    - `select rung from judgements where view_id=? and publication_day<=? order by judgement_id desc limit 1`;\n   146\t    - `service.is_open_as_of`, which reads only `open` and `after_seq`;\n   147\t  - takes evidence in force from `service.evidence` and its fields from that record;\n   148\t  - looks up each source's `title`, `publisher` and `source_uri` in the items database by `input_id`. A visible source whose item is\n   149\t    missing raises `ReleaseRefused` (there is no fallback to the id);\n   150\t  - calls `check_export` on its own result before returning (AGENTS §3: the writer refuses).\n   151\t- **`check_export(data)`:** the closed-set check.\n   152\t  - Every dict at every level has exactly its record type's keys.\n   153\t  - Value checks:\n   154\t    - `format` and `allow_list` equal the constants, and `as_of` is a canonical `YYYY-MM-DD` day (`date.fromisoformat(as_of).isoformat() == as_of`);\n   155\t    - `class` is in its set;\n   156\t    - a number record's `forecast` is the marker;\n   157\t    - `answers` is two strings, and `answer` is one of them or null;\n   158\t    - `open` is a bool and every text field is a string.\n   159\t  - It returns the counts it judged: questions per class, evidence, sources.\n   160\t- **`check_origins(views_db, items_db, data, expected_as_of)`:** the pass condition. It is independent of the exporter's code path.\n   161\t  It derives everything it compares from the store, never from the package.\n   162\t  - **The bound: one rule for both commands.** `expected_as_of` is given by the caller.\n   163\t    - The builder passes the bound it resolved: `service.resolve_bound` on the requested day, or the default when none is given; an\n   164\t      omitted day with no default is refused.\n   165\t    - `check` passes the package's `as_of` through the same `service.resolve_bound`, which refuses a day after a store's last\n   166\t      completed day. A legacy ledger with no completed days accepts any valid date in both commands alike.\n   167\t    - The package's `as_of` must equal `expected_as_of`.\n   168\t  - **The class** of each question is derived from the stored measure and labels (`question_class`). The permitted keys and values\n   169\t    are then chosen from that class, never from the package's `class` field.\n   170\t  - **Order and counts.** The questions are compared as an ordered list in `created_seq, rowid` order, as `bundle.library` orders\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_16","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba src/hivemind/release.py | sed -n '412,474p'\nnl -ba docs/research/2026-11-22-number-answers/RELEASE-BUILD.md | sed -n '171,251p'\nrg -n 'hivemind-release/1|release-allow-list/1|expected_as_of|report.*refus' tests/test_release.py docs/research/2026-11-22-number-answers/release_check.py\nnl -ba poc/data/release-check-2026-11-23f/results.json | tail -130\nls -a poc/data/release-check-2026-11-23f/old-1\nls -l poc/data/comparison-2026-11-17/run/old-1/prod/views.sqlite*\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba src/hivemind/release.py | sed -n '412,474p'\nnl -ba docs/research/2026-11-22-number-answers/RELEASE-BUILD.md | sed -n '171,251p'\nrg -n 'hivemind-release/1|release-allow-list/1|expected_as_of|report.*refus' tests/test_release.py docs/research/2026-11-22-number-answers/release_check.py\nnl -ba poc/data/release-check-2026-11-23f/results.json | tail -130\nls -a poc/data/release-check-2026-11-23f/old-1\nls -l poc/data/comparison-2026-11-17/run/old-1/prod/views.sqlite*\"","aggregated_output":"   412\t\n   413\tdef _read_regular(folder, name, where):\n   414\t    \"\"\"The bytes of one regular file in an opened folder, read once through a descriptor that refuses a symbolic link and opens a pipe\n   415\t    without waiting, so its type is refused instead.\"\"\"\n   416\t    try:\n   417\t        descriptor = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=folder)   # a pipe or device never blocks the check\n   418\t    except OSError as error:\n   419\t        if error.errno == errno.ELOOP:\n   420\t            raise ReleaseRefused(f'{where}/{name}: not a regular file') from None\n   421\t        raise\n   422\t    try:\n   423\t        if not stat.S_ISREG(os.fstat(descriptor).st_mode):\n   424\t            raise ReleaseRefused(f'{where}/{name}: not a regular file')\n   425\t        chunks = []\n   426\t        while True:\n   427\t            chunk = os.read(descriptor, 1 << 20)\n   428\t            if not chunk:\n   429\t                return b''.join(chunks)\n   430\t            chunks.append(chunk)\n   431\t    finally:\n   432\t        os.close(descriptor)\n   433\t\n   434\t\n   435\tdef _parse(raw, name):\n   436\t    try:\n   437\t        return json.loads(raw.decode('utf-8'), object_pairs_hook=_unique_members)\n   438\t    except (UnicodeDecodeError, json.JSONDecodeError) as error:\n   439\t        raise ReleaseRefused(f'{name}: not JSON ({error})') from None\n   440\t\n   441\t\n   442\tdef check_package(path, views_db=None, items_db=None, expected_as_of=None):\n   443\t    \"\"\"The package as a reader receives it: a real folder holding exactly the two regular files, each read once through one handle on\n   444\t    the folder; JSON with no repeated member name; a closed manifest that agrees with the data and the sha256 of the very bytes\n   445\t    parsed; data that passes `check_export` and, with the stores, `check_origins` at `expected_as_of` (or at the package's own day\n   446\t    passed through `resolve`). Returns (counts, the data checked, its size in bytes).\"\"\"\n   447\t    path = Path(path)\n   448\t    try:\n   449\t        folder = os.open(path, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)\n   450\t    except OSError as error:\n   451\t        if error.errno in (errno.ELOOP, errno.ENOTDIR):\n   452\t            raise ReleaseRefused(f'{path}: not a folder') from None\n   453\t        raise\n   454\t    try:\n   455\t        names = os.listdir(folder)\n   456\t        if sorted(names) != sorted(PACKAGE_FILES):\n   457\t            raise ReleaseRefused(f'{path}: holds {sorted(names)}, not exactly {sorted(PACKAGE_FILES)}')\n   458\t        raw, manifest_raw = _read_regular(folder, DATA_FILE, path), _read_regular(folder, MANIFEST_FILE, path)\n   459\t    finally:\n   460\t        os.close(folder)\n   461\t    manifest, data = _parse(manifest_raw, MANIFEST_FILE), _parse(raw, DATA_FILE)\n   462\t    counts = check_export(data)\n   463\t    _keys(manifest, 'manifest', 'the manifest')\n   464\t    if manifest['data_sha256'] != hashlib.sha256(raw).hexdigest():\n   465\t        raise ReleaseRefused('the manifest sha256 does not match the data file')\n   466\t    for name in ('format', 'allow_list', 'as_of'):\n   467\t        if manifest[name] != data[name]:\n   468\t            raise ReleaseRefused(f'the manifest {name} {manifest[name]!r} differs from the data {data[name]!r}')\n   469\t    if views_db is not None:\n   470\t        bound = expected_as_of if expected_as_of is not None else resolve(views_db, data['as_of'])\n   471\t        counts['fields_compared'] = check_origins(views_db, items_db, data, bound)\n   472\t    return counts, data, len(raw)\n   473\t\n   474\t\n   171\t    them (`old-2/v2` and `v3` share sequence 8). Each question's evidence is compared in link order (`evidence_links.id`), and its\n   172\t    sources in row order (`evidence_sources.id`). A duplicate question, evidence record or source therefore fails.\n   173\t\n   174\t  It compares every field with its permitted stored source at the bound, by direct SQL:\n   175\t  - the question set equals the views visible at the bound, with `question` equal to `views.question`;\n   176\t  - `open` equals the latest visible switch's `open`;\n   177\t  - for `event` and `yes_no`: `answers` equal the rung labels in position order, and `answer` equals the label of the latest judgement\n   178\t    rung on or before the bound, or null;\n   179\t  - for `number`: only the marker;\n   180\t  - the evidence id set equals the links visible at the bound, minus those whose latest replacement is visible, computed in its own\n   181\t    SQL. Each evidence field equals the `evidence` row's column;\n   182\t  - each source list starts from every visible `evidence_sources` row, in row order, with `day` taken from\n   183\t    `evidence_sources.publication_day`. Each row needs a matching `items` row for `title`, `publisher` and `source_uri`; a row with no\n   184\t    item raises `ReleaseRefused` (a left join, so a missing item is never silently dropped).\n   185\t\n   186\t  Any difference raises `ReleaseRefused`, naming the question, the field and the evidence id. It returns the number of fields\n   187\t  compared.\n   188\t- **`stage(out_dir)`:** creates a private staging folder with a name unique to this invocation, `tempfile.mkdtemp(dir=out_dir.parent,\n   189\t  prefix='.<name>.staging-')`. Creation is exclusive, so only this invocation owns it. It returns the path.\n   190\t- **`write_package(data, staged)`:** writes `release-data.json` and `manifest.json` into the staging folder. It creates nothing\n   191\t  else.\n   192\t- **`publish(staged, out_dir)`:** one atomic move that refuses any existing destination, empty or not:\n   193\t  - on macOS, `renamex_np(staged, out_dir, RENAME_EXCL)` through `ctypes`. Verified on this Mac: onto a free path it succeeds; onto\n   194\t    an existing empty or non-empty folder it fails with `EEXIST`, and both folders stay as they were;\n   195\t  - on Linux, `renameat2(AT_FDCWD, staged, AT_FDCWD, out_dir, RENAME_NOREPLACE)`;\n   196\t  - where neither call exists, or the filesystem lacks support (`ENOTSUP`, `EINVAL`), it raises `ReleaseRefused`.\n   197\t\n   198\t  It never replaces, creates or removes anything at `out_dir` except by that one move.\n   199\t- **`check_package(path, views_db=None, items_db=None, expected_as_of=None)`:**\n   200\t  - the directory holds exactly `PACKAGE_FILES`, each a regular file and not a symbolic link (`os.lstat`), with no subdirectories;\n   201\t  - both files parse as JSON with no duplicate member name at any level (an `object_pairs_hook` that refuses a repeated key);\n   202\t  - the manifest has exactly its four keys, and its `format`, `allow_list` and `as_of` equal the data's;\n   203\t  - its sha256 equals the data file's;\n   204\t  - the data passes `check_export`, and, when the stores are given, `check_origins` with the expected bound;\n   205\t  - it returns the counts.\n   206\t- **`withheld_unresolved(views_db, data)`** is for the report only. It lists the number questions whose `service.ladder_bands(rungs)`\n   207\t  returns `(None, reason)`, with the reason and whether the view has a key. Its output never enters the package.\n   208\t\n   209\t`scripts/release_build.py`:\n   210\t- **`build --ledger --items [--as-of] --out`:**\n   211\t  1. refuse an existing `--out` or `<out>.report.json` early, as a convenience. The no-replace publication of each holds the\n   212\t     guarantee;\n   213\t  2. resolve the bound once: a given `--as-of` must be canonical `YYYY-MM-DD` (as above), then `service.resolve_bound`;\n   214\t  3. `stage(--out)`. From here a `finally` removes this staging folder while the build still owns it;\n   215\t  4. `release_export` at that bound;\n   216\t  5. `write_package` into the staging folder;\n   217\t  6. `check_package` on the staged folder, with the stores and the resolved bound;\n   218\t  7. `publish` to `--out`. The moment it succeeds, the build drops its staging path (`staged = None`); the `finally` then removes\n   219\t     nothing;\n   220\t  8. `publish_report`: write the report to a private temporary file in the same folder (`tempfile.mkstemp`), then `os.link` it to\n   221\t     `<out>.report.json`. The link fails with `EEXIST` if anything exists at that name. **A successful link is the moment the report\n   222\t     is published.** The temporary file is then removed. If that removal fails, the command still reports the report as published,\n   223\t     names the leftover temporary file, and exits 0.\n   224\t\n   225\t  The failure outcomes:\n   226\t  - **Before publication** (steps 2–7): any exception, whether `ReleaseRefused`, `OSError`, `sqlite3.Error` or another, prints the\n   227\t    reason and exits 1. The `finally` removes this build's staging folder; nothing exists at `--out` from this build. A corrected\n   228\t    retry at the same `--out` succeeds.\n   229\t  - **After publication, before the link** (step 8 fails before the link succeeds, including `EEXIST`): the package is final and\n   230\t    checked, and whatever is at the report name is untouched. Exit 2 with \"package published and checked; report not written; run\n   231\t    `check` to write it\".\n   232\t\n   233\t  It has no input path for prepared or translated JSON, and it takes no clock reading; the folder name is the caller's (D12, D13).\n   234\t- **`check <out> --ledger --items`:** re-runs `check_package` on an existing package, with the stores, the package's canonical\n   235\t  `as_of` validated against the store (above), and the regular-file and duplicate-key checks. It leaves the package in place, prints\n   236\t  the report, and writes `<out>.report.json` only through `publish_report`, so it never replaces anything. Its exit statuses:\n   237\t  - 0: the package passes, and the report was published;\n   238\t  - 2: the package passes, and the report is not published: its name is occupied (an earlier report, or anything else, which stays\n   239\t    untouched), or writing the temporary file or the link fails for any other reason, which is printed;\n   240\t  - 1: the package is refused, with the reason. This is also the retry after a report write failed. Its report gives `check_seconds` and marks\n   241\t  `export_seconds` as not measured.\n   242\t- **The report:**\n   243\t  - the store path and the bound;\n   244\t  - counts per class;\n   245\t  - the unresolved list;\n   246\t  - the fields compared;\n   247\t  - bytes;\n   248\t  - `export_seconds` (build only) and `check_seconds`.\n   249\t\n   250\t## 2. State × event (one export, read-only)\n   251\t\ntests/test_release.py:172:        release.check_package(staged, views_db, items_db, expected_as_of=data['as_of'])\ntests/test_release.py:541:STAGED_CHECK = (\"counts, data, size = release.check_package(staged, views_db, items_db, expected_as_of=bound)\", \"counts, size = release.check_export(data), 0\")\n 44554\t     },\n 44555\t     {\n 44556\t      \"stored_in\": \"v27\",\n 44557\t      \"kind\": \"switch reason\",\n 44558\t      \"text\": \"created\",\n 44559\t      \"found_in\": \"v21\",\n 44560\t      \"field\": \"questions[20].evidence[92].quote\",\n 44561\t      \"evidence\": \"e1967\"\n 44562\t     }\n 44563\t    ]\n 44564\t   }\n 44565\t  }\n 44566\t },\n 44567\t \"decisive\": {\n 44568\t  \"kept\": {\n 44569\t   \"e2295\": {\n 44570\t    \"questions\": [\n 44571\t     \"v8\"\n 44572\t    ],\n 44573\t    \"equal_to_store\": true,\n 44574\t    \"present\": true,\n 44575\t    \"holds_its_wording\": true\n 44576\t   },\n 44577\t   \"e1865\": {\n 44578\t    \"questions\": [\n 44579\t     \"v4\",\n 44580\t     \"v5\",\n 44581\t     \"v8\"\n 44582\t    ],\n 44583\t    \"equal_to_store\": true,\n 44584\t    \"present\": true,\n 44585\t    \"holds_its_wording\": true\n 44586\t   },\n 44587\t   \"e3597\": {\n 44588\t    \"questions\": [\n 44589\t     \"v4\",\n 44590\t     \"v5\"\n 44591\t    ],\n 44592\t    \"equal_to_store\": true,\n 44593\t    \"present\": true,\n 44594\t    \"holds_its_wording\": true\n 44595\t   }\n 44596\t  },\n 44597\t  \"implied_outcome_j1580\": \"About $390 billion: $164 billion reported in the first half, about $100 billion in Q3 using the $108 billion total-reven\",\n 44598\t  \"substituted_into_e2295_refused\": \"question v8.evidence e2295.one_line: differs from the store\",\n 44599\t  \"added_to_manifest_refused\": \"the manifest: keys off the allow-list ['note'], missing []\",\n 44600\t  \"unchanged_package_passes\": 91055,\n 44601\t  \"forged_value_is_j1580\": true\n 44602\t },\n 44603\t \"old-1/v8\": {\n 44604\t  \"class\": \"number\",\n 44605\t  \"forecast\": \"Forecast unavailable\",\n 44606\t  \"evidence\": 1284,\n 44607\t  \"same_ids_as_service_evidence\": true\n 44608\t },\n 44609\t \"leaks\": {\n 44610\t  \"old-3/v36@2026-08-25\": {\n 44611\t   \"latest_judgement\": 799,\n 44612\t   \"expected_judgement\": 799,\n 44613\t   \"label_kept\": true,\n 44614\t   \"answer\": \"Yes\",\n 44615\t   \"why_changed_absent\": true,\n 44616\t   \"reasons_absent\": true,\n 44617\t   \"phrase_fields\": {\n 44618\t    \"around $1 trillion\": [],\n 44619\t    \"rung 4\": [],\n 44620\t    \"at rung\": [],\n 44621\t    \"capex at rung\": []\n 44622\t   }\n 44623\t  },\n 44624\t  \"old-1/v10@2026-08-28\": {\n 44625\t   \"latest_judgement\": 865,\n 44626\t   \"expected_judgement\": 865,\n 44627\t   \"label_kept\": true,\n 44628\t   \"answer\": \"Yes\",\n 44629\t   \"why_changed_absent\": true,\n 44630\t   \"reasons_absent\": true,\n 44631\t   \"phrase_fields\": {\n 44632\t    \"around $1 trillion\": [],\n 44633\t    \"rung 4\": [],\n 44634\t    \"at rung\": [],\n 44635\t    \"capex at rung\": []\n 44636\t   }\n 44637\t  }\n 44638\t },\n 44639\t \"control\": {\n 44640\t  \"id\": \"v3\",\n 44641\t  \"answer\": \"Yes\",\n 44642\t  \"label_equals_store\": true,\n 44643\t  \"evidence_equals_store\": true\n 44644\t },\n 44645\t \"closing\": {\n 44646\t  \"reason\": \"due 2026-09-20, frozen on 2026-09-20 at rung 2 Bullish\",\n 44647\t  \"bundle_exposes_reason\": true,\n 44648\t  \"package_open\": false,\n 44649\t  \"reason_absent\": true,\n 44650\t  \"rung_label_inside_v8_fields\": [\n 44651\t   [\n 44652\t    \"questions[7].evidence[300].sources[0].title\",\n 44653\t    \"e1484\",\n 44654\t    \"Can Nvidia Reclaim $5 Trillion? Jensen Huang’s Bullish AI Call Says Yes\"\n 44655\t   ],\n 44656\t   [\n 44657\t    \"questions[7].evidence[301].sources[0].title\",\n 44658\t    \"e1485\",\n 44659\t    \"Can Nvidia Reclaim $5 Trillion? Jensen Huang’s Bullish AI Call Says Yes\"\n 44660\t   ],\n 44661\t   [\n 44662\t    \"questions[7].evidence[393].quote\",\n 44663\t    \"e1865\",\n 44664\t    \"Bullish confirmation would require firm procurement commitments for the SpaceX buildout and continued NVIDIA Data Center\"\n 44665\t   ],\n 44666\t   [\n 44667\t    \"questions[7].evidence[1167].sources[0].title\",\n 44668\t    \"e4721\",\n 44669\t    \"Oracle Surges on AI Growth as AMD, Nvidia Stay Bullish\"\n 44670\t   ],\n 44671\t   [\n 44672\t    \"questions[7].evidence[1168].sources[0].title\",\n 44673\t    \"e4722\",\n 44674\t    \"Oracle Surges on AI Growth as AMD, Nvidia Stay Bullish\"\n 44675\t   ],\n 44676\t   [\n 44677\t    \"questions[7].evidence[1169].sources[0].title\",\n 44678\t    \"e4723\",\n 44679\t    \"Oracle Surges on AI Growth as AMD, Nvidia Stay Bullish\"\n 44680\t   ]\n 44681\t  ]\n 44682\t }\n 44683\t}.\n..\nclosing\nforged-manifest\nforged-summary\npackage\npackage-2026-08-28\npackage-2026-08-28.report.json\npackage.report.json\n-rw-r--r--@ 1 lchingen  staff  19767296 Nov 18 01:20 poc/data/comparison-2026-11-17/run/old-1/prod/views.sqlite\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_17","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"python3 -B -c 'import ast,json,runpy\nfrom pathlib import Path\nroot=Path(\\\"docs/research/2026-11-22-number-answers/release_check.py\\\")\ng=runpy.run_path(str(root))\nout=Path(\\\"poc/data/release-check-2026-11-23f\\\")\nbody=next(f for f in ast.parse(root.read_text()).body if getattr(f,\\\"name\\\",\\\"\\\")==\\\"main\\\").body\ndef run_lines(first,last,env):\n    nodes=[x for x in body if first<=x.lineno<=last]\n    exec(compile(ast.Module(body=nodes,type_ignores=[]),str(root),\\\"exec\\\"),env)\ng.update(out=out, results=json.loads((out/\\\"results.json\\\").read_text()))\ndef existing(ledger,items,path,day):\n    data=json.loads((path.parent/\\\"package\\\"/\\\"release-data.json\\\").read_bytes())\n    intended=json.loads((path/\\\"release-data.json\\\").read_bytes())\n    print(path.parent.name,\\\"asked\\\",day,\\\"returned\\\",data[\\\"as_of\\\"],\\\"questions intended/returned\\\",len(intended[\\\"questions\\\"]),len(data[\\\"questions\\\"]), \\\"evidence intended/returned\\\",*(sum(len(q[\\\"evidence\\\"]) for q in x[\\\"questions\\\"]) for x in [intended,data]))\n    return {}, data\ng[\\\"build\\\"]=existing\nrun_lines(205,220,g)\nrun_lines(254,273,g)\nprint(\\\"failures\\\",g[\\\"failures\\\"])'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
