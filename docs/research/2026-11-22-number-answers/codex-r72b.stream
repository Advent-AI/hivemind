, period_start text, period_end text, basis text, unit text, event_type text, seq integer, scope_source text, key_version integer',\nsrc/hivemind/views/store.py:100:    has_bounds = any(r.get('lo') is not None or r.get('hi') is not None for r in rows) or view_key(conn, view_id) is not None\nsrc/hivemind/views/store.py:110:    insert(conn, 'view_keys', view_id=view_id, measure=key['measure'], scope=key.get('scope', ''), scope_key=_universe.scope_key(key.get('scope', '')),\nsrc/hivemind/views/store.py:118:    columns = [r[1] for r in conn.execute('pragma table_info(view_keys)')]\nsrc/hivemind/views/store.py:120:        conn.execute('alter table view_keys add column scope_source text')\nsrc/hivemind/views/store.py:122:        conn.execute('alter table view_keys add column key_version integer')\nsrc/hivemind/views/store.py:159:def view_key(conn, view_id):\nsrc/hivemind/views/store.py:160:    if not conn.execute('pragma table_info(view_keys)').fetchone():\nsrc/hivemind/views/store.py:162:    row = conn.execute('select * from view_keys where view_id=?', (view_id,)).fetchone()\nsrc/hivemind/views/store.py:175:    rows = [dict(r) for r in conn.execute('''select k.* from view_keys k join views v on v.view_id=k.view_id\nsrc/hivemind/views/store.py:191:    rows = conn.execute('''select k.*, v.object_id from view_keys k join views v on v.view_id=k.view_id\nsrc/hivemind/extraction.py:48:    return [dict(v, key=store.view_key(conn, v['view_id']) or {},\nsrc/hivemind/research_context.py:48:        keys = self.rows('select * from view_keys where view_id=? and seq<?', (vid,self.seq))\nsrc/hivemind/bundle.py:160:    key = store.view_key(views_db, view_id)\n","exit_code":0,"status":"completed"}}
