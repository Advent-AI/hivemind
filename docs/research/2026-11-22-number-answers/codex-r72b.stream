      });\n   107\t        app.showGraph({ day: library.getDay() });\n   108\t      }\n   109\t      if (deferredPresentation) {\n   110\t        const { spec, dataset } = deferredPresentation;\n   111\t        present(spec, dataset);\n   112\t      } else if (leadingDirty) {\n   113\t        app.updateLeading();\n   114\t        leadingDirty = false;\n   115\t      }\n   116\t      if (firstVisit) composer.open();\n   117\t      updateSendState();\n   118\t    }\n   119\t    function present(spec, dataset = null) {\n   120\t      if (root.hidden) {\n   121\t        deferredPresentation = { spec, dataset };\n   122\t        return;\n   123\t      }\n   124\t      if (dataset) app.setDataset(dataset);\n   125\t      app.showGraph({ ...spec, ...(idea.state === 'answered' ? { trigger, action } : {}) });\n   126\t      deferredPresentation = null;\n   127\t      leadingDirty = false;\n   128\t    }\n   129\t    const leadingCard = (layout = {}) =>\n   130\t      ideaCard({\n   131\t        ...idea,\n   132\t        ...layout,\n   133\t        onOpen: () =>\n   134\t          ideaDetail.open(idea.card, data.theses, idea.composite, idea.day, idea.createdDay),\n   135\t        scoreOf: (position) => {\n   136\t          const thesis = app\n   137\t            ?.getDataset()\n   138\t            .theses.find((t) => t.id === idea.card?.reading?.chosen[0]?.view_id);\n   139\t          if (!thesis) return `position ${position}`;\n   140\t          return undirected(thesis)\n124:      if (dataset) app.setDataset(dataset);\n262:        library.setDataset(next, { day: next.as_of }); // the supplied snapshot defines the displayed date (thesis-ui.md)\n10:<body class=\"hm-ui demo\">\n    \"model\": \"gpt-6-luna\",\n    \"prompt_version\": \"matching-v1\",\n    \"reasoning_effort\": \"medium\",\n    \"max_output_tokens\": 12000\n  },\n  \"rejudging\": {\n    \"model\": \"gpt-6-luna\",\n    \"prompt_version\": \"judging-v1\",\n    \"reasoning_effort\": \"medium\",\n    \"max_output_tokens\": 8000\n  },\n  \"final_verdict\": {\n    \"model\": \"gpt-6-luna\",\n    \"prompt_version\": \"verdict-v0\",\n    \"reasoning_effort\": \"medium\",\n    \"max_output_tokens\": 8000\n  },\n  \"idea\": {\n    \"model\": \"gpt-6-luna\",\n    \"prompt_version\": \"idea-v7\",\n    \"reasoning_effort\": \"none\",\n    \"max_output_tokens\": 4000\n  },\n  \"idea_summary\": {\n    \"model\": \"gpt-6-luna\",\n    \"prompt_version\": \"idea-summary-v8\",\n    \"reasoning_effort\": \"low\",\n    \"max_output_tokens\": 4000\n  }\n}\nmock_build.py\nmock_data.py\nmock_translate.py\n","exit_code":0,"status":"completed"}}
