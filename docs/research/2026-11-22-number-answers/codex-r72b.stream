{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc 'nl -ba scripts/hivemind_api.py; nl -ba scripts/hivemind_mcp.py'","aggregated_output":"     1\t\"\"\"The HTTP front of the Hivemind service (docs/poc/service.md, docs/poc/idea-card.md): JSON on one port, one route\n     2\tper call, every answer from src/hivemind/service.py, search.py and idea.py. The web page's front; agents use MCP.\n     3\t\n     4\tGET routes (query string parameters in brackets):\n     5\t  /search          [q, k, as_of, include_closed]\n     6\t  /views           [object, as_of, include_closed]\n     7\t  /views/<id>      [as_of]\n     8\t  /views/<id>/history   [from, to]\n     9\t  /views/<id>/evidence  [as_of, tier]\n    10\t  /views/<id>/record    [as_of]\n    11\t  /changes         [since, to]\n    12\t  /evaluate        [view_id, comparator (>=, <, =), value_usd, as_of]\n    13\t  /days            the ledger's first and last completed day\n    14\t  /thesis-bundles   [ids (comma-separated), as_of] complete dated frontend inputs\n    15\t  /library         [as_of] all collected theses and stored groups, without a model call\n    16\tPOST route (JSON body):\n    17\t  /ideas           {text, as_of?, k?, bundles?} → the idea card (mapping and optional analyst summary; none when no view is recorded); bundles:false leaves the\n    18\t                   views' bundles out for a page that fetches /thesis-bundles itself\n    19\t                   Accept: application/x-ndjson streams progress then result, or an error record\n    20\t\n    21\tEvery request opens its own connections (the server is threaded; an idea call takes seconds and must not block the\n    22\tpage's reads). Usage: python3 scripts/hivemind_api.py [--host 127.0.0.1] [--port 8788] [--views DB] [--items DB]\n    23\t[--index DB] [--archive DB] [--config JSON] [--lexical]\n    24\t\"\"\"\n    25\timport argparse\n    26\timport http.server\n    27\timport json\n    28\timport os\n    29\timport sys\n    30\timport urllib.parse\n    31\t\n    32\tROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))\n    33\tsys.path.insert(0, os.path.join(ROOT, 'src'))\n    34\tfrom hivemind import bundle, config, idea, live_lock, model, search, service  # noqa: E402\n    35\tfrom hivemind.views import store  # noqa: E402\n    36\t\n    37\tPATHS = {}\n    38\tALIASES = {}\n    39\tCFG = None\n    40\tSEMANTIC = True\n    41\tREQUEST_ERRORS = (KeyError, service.LedgerError, live_lock.LockRefused, model.TransportError, model.SchemaError, config.ConfigError, ValueError, TypeError)\n    42\t\n    43\t\n    44\tdef error_response(error):\n    45\t    \"\"\"(status, body) for a request's error. The store's date refusals carry their days (OPERATING-CONTRACT.md, row 3).\"\"\"\n    46\t    if isinstance(error, service.FirstDayNotCompleted):\n    47\t        return 503, {'error': str(error)}\n    48\t    if isinstance(error, service.BoundNotCompleted):\n    49\t        return 409, {'error': 'day not completed', 'requested': error.requested, 'last_completed_day': error.last_completed_day}\n    50\t    if isinstance(error, service.RangeNotOrdered):\n    51\t        return 409, {'error': 'range start after its end', 'start': error.start, 'end': error.end}\n    52\t    if isinstance(error, KeyError):\n    53\t        return 404, {'error': f'not found: {error}'}\n    54\t    if isinstance(error, (service.LedgerError, live_lock.LockRefused)):     # the store cannot be served as configured (row 7)\n    55\t        return 500, {'error': str(error)}\n    56\t    if isinstance(error, (model.TransportError, model.SchemaError, config.ConfigError)):\n    57\t        return 502, {'error': f'{type(error).__name__}: {str(error)[:200]}'}\n    58\t    return 400, {'error': str(error)}\n    59\t\n    60\t\n    61\tclass Connections:\n    62\t    \"\"\"The databases one request reads: opened on entry, closed on exit, never shared between threads. The ledger's committed state\n    63\t    is pinned by BEGIN and a first read, so every read of the request sees one state while a writer commits (live-service/\n    64\t    OPERATING-CONTRACT.md, row 2); a failure while opening closes what was already opened.\"\"\"\n    65\t\n    66\t    def __init__(self, read_only=False):\n    67\t        self.read_only = read_only\n    68\t\n    69\t    def __enter__(self):\n    70\t        self.ledger = self.index = self.items = self.archive = None\n    71\t        try:\n    72\t            self.ledger = service.open_pinned(PATHS['views'])\n    73\t            self.index = None if self.read_only else search.open_index(PATHS['index'])\n    74\t            self.items = store.open_read_only(PATHS['items']) if PATHS.get('items') and os.path.exists(PATHS['items']) else None\n    75\t            self.archive = None if self.read_only else model.Archive(PATHS['archive'])\n    76\t        except BaseException:\n    77\t            self._close()\n    78\t            raise\n    79\t        return self\n    80\t\n    81\t    def _close(self):\n    82\t        if self.ledger is not None and self.ledger.in_transaction:\n    83\t            self.ledger.rollback()\n    84\t        for conn in (self.ledger, self.index, self.items):\n    85\t            if conn is not None:\n    86\t                conn.close()\n    87\t\n    88\t    def __exit__(self, *exc):\n    89\t        self._close()\n    90\t\n    91\t\n    92\tclass Handler(http.server.BaseHTTPRequestHandler):\n    93\t    def log_message(self, fmt, *args):   # one line per request, no query text or body (an idea can carry anything)\n    94\t        sys.stderr.write(f'{self.address_string()} {self.command} {self.path.split(\"?\")[0]}\\n')\n    95\t\n    96\t    def _send(self, status, payload):\n    97\t        body = json.dumps(payload, ensure_ascii=False).encode('utf-8')\n    98\t        self.send_response(status)\n    99\t        self.send_header('Content-Type', 'application/json; charset=utf-8')\n   100\t        self._cors()\n   101\t        self.send_header('Content-Length', str(len(body)))\n   102\t        self.end_headers()\n   103\t        self.wfile.write(body)\n   104\t\n   105\t    def _cors(self):\n   106\t        self.send_header('Access-Control-Allow-Origin', '*')\n   107\t        self.send_header('Access-Control-Allow-Methods', 'GET, POST, OPTIONS')\n   108\t        self.send_header('Access-Control-Allow-Headers', 'Content-Type')\n   109\t\n   110\t    def do_OPTIONS(self):          # a browser's preflight before a JSON POST\n   111\t        self.send_response(204)\n   112\t        self._cors()\n   113\t        self.end_headers()\n   114\t\n   115\t    def _answer(self, work, read_only=False):\n   116\t        try:\n   117\t            with Connections(read_only) as db:\n   118\t                self._send(200, work(db))\n   119\t        except REQUEST_ERRORS as error:\n   120\t            status, body = error_response(error)\n   121\t            self._send(status, body)\n   122\t\n   123\t    def _stream_answer(self, work, prepare):\n   124\t        \"\"\"The streamed Idea answer, in one read transaction: `prepare` checks the request (its date resolved, the first day refused)\n   125\t        before any header, so a refusal is a normal status and body; then the 200 headers and the work, in the same transaction.\"\"\"\n   126\t        headers_sent = False\n   127\t\n   128\t        def emit(event):\n   129\t            self.wfile.write((json.dumps(event, ensure_ascii=False) + '\\n').encode('utf-8'))\n   130\t            self.wfile.flush()\n   131\t\n   132\t        try:\n   133\t            with Connections() as db:\n   134\t                prepare(db)\n   135\t                self.send_response(200)\n   136\t                self.send_header('Content-Type', 'application/x-ndjson; charset=utf-8')\n   137\t                self.send_header('Cache-Control', 'no-store')\n   138\t                self._cors()\n   139\t                self.end_headers()\n   140\t                headers_sent = True\n   141\t                card = work(db, lambda stage: emit({'type': 'progress', 'stage': stage}))\n   142\t                emit({'type': 'result', 'data': card})\n   143\t        except (BrokenPipeError, ConnectionResetError):\n   144\t            return\n   145\t        except REQUEST_ERRORS as error:\n   146\t            status, body = error_response(error)\n   147\t            if not headers_sent:\n   148\t                self._send(status, body)\n   149\t                return\n   150\t            try:\n   151\t                emit({'type': 'error', 'status': status, 'message': body['error'], **{k: v for k, v in body.items() if k != 'error'}})\n   152\t            except (BrokenPipeError, ConnectionResetError):\n   153\t                pass\n   154\t\n   155\t    def do_GET(self):\n   156\t        url = urllib.parse.urlsplit(self.path)\n   157\t        q = {k: v[0] for k, v in urllib.parse.parse_qs(url.query).items()}\n   158\t        parts = [p for p in url.path.split('/') if p]\n   159\t        self._answer(lambda db: route(db, parts, q), read_only=parts in (['library'], ['thesis-bundles']))\n   160\t\n   161\t    def do_POST(self):\n   162\t        parts = [p for p in urllib.parse.urlsplit(self.path).path.split('/') if p]\n   163\t        length = int(self.headers.get('Content-Length') or 0)\n   164\t        raw = self.rfile.read(length) if length else b''\n   165\t\n   166\t        def request_body():\n   167\t            if parts != ['ideas']:\n   168\t                raise KeyError('/'.join(parts))\n   169\t            try:\n   170\t                body = json.loads(raw or b'{}')\n   171\t            except json.JSONDecodeError as error:\n   172\t                raise ValueError(f'the body is not JSON: {error}')\n   173\t            if not isinstance(body, dict) or not str(body.get('text') or '').strip():\n   174\t                raise ValueError('POST /ideas needs a JSON body with text')\n   175\t            return body\n   176\t\n   177\t        def prepare(db):\n   178\t            \"\"\"The store's date refusals, before any header (OPERATING-CONTRACT.md, row 3): a first-day store, and a date after the last\n   179\t            completed day. A malformed body or a missing configuration is answered in the stream, as before (D281).\"\"\"\n   180\t            try:\n   181\t                as_of = request_body().get('as_of') or None\n   182\t            except (KeyError, ValueError):\n   183\t                as_of = None                          # the body's own error is raised by `work`, in the stream\n   184\t            service.resolve_bound(db.ledger, as_of)\n   185\t\n   186\t        def work(db, on_progress=None):\n   187\t            body = request_body()\n   188\t            if CFG is None:\n   189\t                raise config.ConfigError('the server was started without --config, so it cannot read ideas')\n   190\t            return idea.read_idea(db.ledger, db.index, db.items, db.archive, CFG, body['text'], body.get('as_of') or None,\n   191\t                                  int(body.get('k') or 10), aliases=ALIASES, semantic=SEMANTIC, bundles=body.get('bundles', True) is not False,\n   192\t                                  on_progress=on_progress)\n   193\t        accepted = [part.split(';', 1)[0].strip() for part in self.headers.get('Accept', '').split(',')]\n   194\t        if parts == ['ideas'] and 'application/x-ndjson' in accepted:\n   195\t            self._stream_answer(work, prepare)\n   196\t        else:\n   197\t            self._answer(work)\n   198\t\n   199\tdef flag(value):\n   200\t    return str(value).lower() in ('1', 'true', 'yes')\n   201\t\n   202\t\n   203\tdef route(db, parts, q):\n   204\t    ledger, as_of = db.ledger, q.get('as_of') or None\n   205\t    if parts == ['library']:\n   206\t        return bundle.library(ledger, db.items, as_of)\n   207\t    if parts == ['thesis-bundles']:\n   208\t        return bundle.thesis_bundles(ledger, db.items, [id.strip() for id in q.get('ids', '').split(',') if id.strip()], as_of)\n   209\t    if parts == ['search']:\n   210\t        return search.search(ledger, db.index, q.get('q', ''), int(q.get('k', 10)), as_of, flag(q.get('include_closed', '')), aliases=ALIASES, semantic=SEMANTIC)\n   211\t    if parts == ['views']:\n   212\t        return service.views(ledger, q.get('object') or None, as_of, flag(q.get('include_closed', '')))\n   213\t    if len(parts) == 2 and parts[0] == 'views':\n   214\t        record = service.view(ledger, parts[1], as_of)\n   215\t        if record is None:\n   216\t            raise KeyError(parts[1])\n   217\t        return record\n   218\t    if len(parts) == 3 and parts[0] == 'views':\n   219\t        view_id, what = parts[1], parts[2]\n   220\t        if what == 'history':\n   221\t            return service.history(ledger, view_id, q.get('from') or None, q.get('to') or None)\n   222\t        if what == 'evidence':\n   223\t            return service.evidence(ledger, view_id, as_of, q.get('tier') or None)\n   224\t        if what == 'record':\n   225\t            return service.record(ledger, view_id, as_of)\n   226\t        raise KeyError(what)\n   227\t    if parts == ['changes']:\n   228\t        if not q.get('since'):\n   229\t            raise ValueError('changes needs since=YYYY-MM-DD')\n   230\t        return service.changes(ledger, q['since'], q.get('to') or None)\n   231\t    if parts == ['evaluate']:\n   232\t        if not all(k in q for k in ('view_id', 'comparator', 'value_usd')):\n   233\t            raise ValueError('evaluate needs view_id, comparator and value_usd')\n   234\t        answer = service.evaluate(ledger, q['view_id'], q['comparator'], float(q['value_usd']), as_of)\n   235\t        if answer is None:\n   236\t            raise KeyError(q['view_id'])\n   237\t        return answer\n   238\t    if parts == ['days']:\n   239\t        service.resolve_bound(ledger, None)          # a first-day store is refused here too (OPERATING-CONTRACT.md, row 4)\n   240\t        row = ledger.execute('select min(day), max(day) from days_completed').fetchone()\n   241\t        return {'first_day': row[0], 'last_day': row[1]}\n   242\t    raise KeyError('/'.join(parts))\n   243\t\n   244\t\n   245\tdef index_at_start(embed=None):\n   246\t    \"\"\"The search index built at start to the last completed day (OPERATING-CONTRACT.md, row 4a); on a first-day store nothing is\n   247\t    built, and search stays lexical until the service is restarted after a day completes. Returns the line the server prints.\"\"\"\n   248\t    with Connections() as db:\n   249\t        try:\n   250\t            embedded, unchanged, tokens, error = search.ensure_index(db.ledger, db.index, **({'embed': embed} if embed else {}))\n   251\t        except service.FirstDayNotCompleted:\n   252\t            return \"index: not built, the store's first day has not completed; search is lexical until a restart after it completes\"\n   253\t    return f'index: {embedded} views embedded, {unchanged} unchanged, {tokens} tokens' + (f'; embedding stopped ({error}): search runs lexical until the rest is built' if error else '')\n   254\t\n   255\t\n   256\tdef main():\n   257\t    global ALIASES, CFG, SEMANTIC\n   258\t    parser = argparse.ArgumentParser()\n   259\t    parser.add_argument('--views', default=os.path.join(ROOT, 'poc', 'data', 'served-2026-10-28-v34-nvda-3m-through-0828', 'views.sqlite'))\n   260\t    parser.add_argument('--items', default=os.path.join(ROOT, 'poc', 'data', 'items-nvda-2026-07-01-10-27.sqlite'), help='the items database, for source titles in the idea card')\n   261\t    parser.add_argument('--index', default=os.path.join(ROOT, 'poc', 'data', 'service-english', 'search-index.sqlite'))\n   262\t    parser.add_argument('--archive', default=os.path.join(ROOT, 'poc', 'data', 'service-english', 'idea-archive.sqlite'), help='where idea model calls are archived for replay')\n   263\t    parser.add_argument('--config', default=os.path.join(ROOT, 'poc', 'config', 'poc-v118-idea.json'), help='the config whose idea settings name the mapping and final assessment models and prompts')\n   264\t    parser.add_argument('--universe', default=os.path.join(ROOT, 'poc', 'universe.json'))\n   265\t    parser.add_argument('--host', default='127.0.0.1')\n   266\t    parser.add_argument('--port', type=int, default=8788)\n   267\t    parser.add_argument('--lexical', action='store_true', help='no embedding at all (no network): search ranks by the trigram index and says mode lexical')\n   268\t    args = parser.parse_args()\n   269\t    PATHS.update(views=args.views, items=args.items, index=args.index, archive=args.archive)\n   270\t    os.makedirs(os.path.dirname(os.path.abspath(args.archive)), exist_ok=True)\n   271\t    ALIASES = search.object_aliases(args.universe)\n   272\t    CFG = config.load(args.config) if args.config and os.path.exists(args.config) else None\n   273\t    SEMANTIC = not args.lexical\n   274\t    if not os.path.exists(args.items):\n   275\t        print(f'items database not found ({args.items}): idea cards name sources by input id', flush=True)\n   276\t    if CFG is None:\n   277\t        print('no config: GET routes only, POST /ideas answers 502', flush=True)\n   278\t    else:\n   279\t        print(f'config {CFG.version}: ideas read by {CFG.idea.model} ({CFG.idea.prompt_version}, effort {CFG.idea.reasoning_effort}); archive {os.path.basename(args.archive)}', flush=True)\n   280\t        if CFG.idea_summary is not None:\n   281\t            print(f'analyst summary: {CFG.idea_summary.model} ({CFG.idea_summary.prompt_version}, effort {CFG.idea_summary.reasoning_effort})', flush=True)\n   282\t    if args.lexical:\n   283\t        print('--lexical: no embedding; every search answers in lexical mode', flush=True)\n   284\t    else:\n   285\t        print(index_at_start(), flush=True)\n   286\t    print(f'hivemind api on http://{args.host}:{args.port}  ledger {os.path.basename(os.path.dirname(args.views))}/{os.path.basename(args.views)}  index {os.path.basename(args.index)}', flush=True)\n   287\t    server = http.server.ThreadingHTTPServer((args.host, args.port), Handler)\n   288\t    server.daemon_threads = True\n   289\t    server.serve_forever()\n   290\t\n   291\t\n   292\tif __name__ == '__main__':\n   293\t    main()\n     1\t\"\"\"The MCP front of the Hivemind service (docs/poc/service.md): one tool per call, stdio transport, every answer from\n     2\tsrc/hivemind/service.py and search.py. Hivemind is a database with a search engine on top: the caller searches,\n     3\tchooses which views to keep and how to arrange them, and reads each view's state, history and evidence. Nothing\n     4\there writes to the ledger or knows who is asking.\n     5\t\n     6\tUsage: python3 scripts/hivemind_mcp.py [--views DB] [--index DB]\n     7\tClaude Code: claude mcp add hivemind -- python3 /path/to/scripts/hivemind_mcp.py\n     8\t\"\"\"\n     9\timport argparse\n    10\timport contextlib\n    11\timport os\n    12\timport sys\n    13\t\n    14\tfrom mcp.server.fastmcp import FastMCP\n    15\t\n    16\tROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))\n    17\tsys.path.insert(0, os.path.join(ROOT, 'src'))\n    18\tfrom hivemind import bundle, search as search_module, service  # noqa: E402\n    19\tfrom hivemind.views import store  # noqa: E402\n    20\t\n    21\tparser = argparse.ArgumentParser()\n    22\tparser.add_argument('--views', default=os.path.join(ROOT, 'poc', 'data', 'served-2026-10-28-v34-nvda-3m-through-0828', 'views.sqlite'))\n    23\tparser.add_argument('--index', default=os.path.join(ROOT, 'poc', 'data', 'service-english', 'search-index.sqlite'))\n    24\tparser.add_argument('--universe', default=os.path.join(ROOT, 'poc', 'universe.json'))\n    25\tparser.add_argument('--items', default=os.path.join(ROOT, 'poc', 'data', 'items-nvda-2026-07-01-10-27.sqlite'))\n    26\tparser.add_argument('--lexical', action='store_true', help='no embedding at all (no network): search ranks by the trigram index and says mode lexical')\n    27\tparser.add_argument('--transport', choices=['stdio', 'streamable-http'], default='stdio', help='stdio for a local agent; streamable-http to serve /mcp over HTTP (Docker)')\n    28\tparser.add_argument('--host', default='127.0.0.1')\n    29\tparser.add_argument('--port', type=int, default=8789)\n    30\tARGS = parser.parse_args()\n    31\tALIASES = search_module.object_aliases(ARGS.universe)\n    32\t\n    33\tfrom hivemind import idea as idea_module  # noqa: E402\n    34\t\n    35\t\n    36\t@contextlib.contextmanager\n    37\tdef connections():\n    38\t    \"\"\"One tool call's databases (live-service/OPERATING-CONTRACT.md, row 2): the ledger, items and index opened per call, never shared\n    39\t    between calls (a search writes the index's query cache); the ledger's committed state pinned by BEGIN and a first read; every\n    40\t    connection closed on every path, a failure while opening included.\"\"\"\n    41\t    opened = []\n    42\t    try:\n    43\t        ledger = service.open_pinned(ARGS.views)\n    44\t        opened.append(ledger)\n    45\t        index = search_module.open_index(ARGS.index)\n    46\t        opened.append(index)\n    47\t        items = store.open_read_only(ARGS.items) if os.path.exists(ARGS.items) else None\n    48\t        if items is not None:\n    49\t            opened.append(items)\n    50\t        yield ledger, items, index\n    51\t    finally:\n    52\t        if opened and opened[0].in_transaction:\n    53\t            opened[0].rollback()\n    54\t        for conn in reversed(opened):\n    55\t            conn.close()\n    56\t\n    57\t\n    58\tdef start_objects():\n    59\t    \"\"\"The object list for the server's instructions, computed once at start and labelled with its day; every tool reads the current\n    60\t    last completed day. Start-up indexing embeds only views visible at the last completed day, and none on a first-day store (row 4a).\"\"\"\n    61\t    with connections() as (ledger, _items, index):\n    62\t        if not ARGS.lexical:\n    63\t            try:\n    64\t                embedded, _unchanged, _tokens, error = search_module.ensure_index(ledger, index)\n    65\t                if error:\n    66\t                    sys.stderr.write(f'hivemind: embedding stopped ({error}) after {embedded} views; search runs lexical until the rest is built\\n')\n    67\t            except service.FirstDayNotCompleted:\n    68\t                sys.stderr.write(\"hivemind: index not built, the store's first day has not completed; search is lexical until a restart\\n\")\n    69\t        try:\n    70\t            day = service.resolve_bound(ledger, None)\n    71\t        except service.FirstDayNotCompleted:\n    72\t            return \"No day of this ledger has completed yet; every tool refuses until one has.\"\n    73\t        return (f'Objects as of {day}, when this server started; every tool reads the current last completed day. '\n    74\t                + idea_module.object_list(ledger, day, ALIASES))\n    75\t\n    76\t\n    77\tOBJECTS = start_objects()\n    78\tmcp = FastMCP('hivemind', host=ARGS.host, port=ARGS.port, instructions=(\n    79\t    'Hivemind is a ledger of research views (a dated question with a five-step ladder, judged every day on evidence) '\n    80\t    'with a search engine on top. To read an idea against it: first break the idea into its parts, the one to four '\n    81\t    'questions whose answers decide it (each about one concrete quantity, date or event); search with the idea and with '\n    82\t    'each part (k=20); map each part to every view whose question answers it or whose outcome would move it, leaving out '\n    83\t    'views that only share a company or a word; then read each mapped view (state as of a day, history, evidence) and '\n    84\t    'say what the judged positions tell about each part and which parts no view covers. Say judged, never true. Every '\n    85\t    'tool takes as_of, a calendar day; the default is the ledger\\'s last completed day. Nothing here changes the ledger. '\n    86\t    'search matches each view\\'s own text (question, what it looks at, ladder conditions; Chinese, English queries work): '\n    87\t    'ask for one object and one quantity or event per query; views(object) lists everything under one object. '\n    88\t    + OBJECTS))\n    89\t\n    90\t\n    91\t@mcp.tool()\n    92\tdef thesis_library(as_of: str = '') -> dict:\n    93\t    \"\"\"All collected theses and their stored research groups, including ungrouped and closed theses.\n    94\t    Membership is not a dependency or a parent-child relationship. No model call or ledger write.\"\"\"\n    95\t    with connections() as (ledger, items, _index):\n    96\t        return bundle.library(ledger, items, as_of or None)\n    97\t\n    98\t\n    99\t@mcp.tool()\n   100\tdef thesis_bundles(view_ids: list[str], as_of: str = '') -> dict:\n   101\t    \"\"\"Complete UI inputs for selected thesis ids: dated states, assessments, sources, evidence and relationships.\n   102\t    Pass this envelope to the frontend's fromBundles adapter. Read-only; does not call a model.\"\"\"\n   103\t    with connections() as (ledger, items, _index):\n   104\t        return bundle.thesis_bundles(ledger, items, view_ids, as_of or None)\n   105\t\n   106\t\n   107\t@mcp.tool()\n   108\tdef search(query: str, k: int = 10, as_of: str = '', include_closed: bool = False) -> dict:\n   109\t    \"\"\"Top-k views for an idea or sentence: id, object, kind, what it looks at, the question, due day, dependencies\n   110\t    (the views it is judged after) and dependants, with the score and its parts. Views, never evidence: evidence is\n   111\t    anchored under its view.\"\"\"\n   112\t    with connections() as (ledger, _items, index):\n   113\t        return search_module.search(ledger, index, query, k, as_of or None, include_closed, aliases=ALIASES, semantic=not ARGS.lexical)\n   114\t\n   115\t\n   116\t@mcp.tool()\n   117\tdef views(object: str = '', as_of: str = '', include_closed: bool = False) -> list:\n   118\t    \"\"\"The views of one object (a ticker like NVDA or a theme id like ai-capex), or all views, as of a day.\"\"\"\n   119\t    with connections() as (ledger, _items, _index):\n   120\t        return service.views(ledger, object or None, as_of or None, include_closed)\n   121\t\n   122\t\n   123\t@mcp.tool()\n   124\tdef view(view_id: str, as_of: str = '') -> dict:\n   125\t    \"\"\"One view as of a day: the question, the ladder (positions 1..5, position 1 the most bullish outcome; or 2 for\n   126\t    yes/no), the judged position with its label and condition and since when, whether open, dependencies and\n   127\t    dependants, counts of rounds, evidence and facts.\"\"\"\n   128\t    with connections() as (ledger, _items, _index):\n   129\t        record = service.view(ledger, view_id, as_of or None)\n   130\t    if record is None:\n   131\t        raise ValueError(f'no view {view_id} as of {as_of or \"the last completed day\"}')\n   132\t    return record\n   133\t\n   134\t\n   135\t@mcp.tool()\n   136\tdef history(view_id: str, from_day: str = '', to_day: str = '') -> dict:\n   137\t    \"\"\"Every judgement round in the span (day, position, whether it changed, why, the cited evidence ids and the push\n   138\t    each gave), evidence arrivals per day, position changes, replacements of guidance, open/close switches.\"\"\"\n   139\t    with connections() as (ledger, _items, _index):\n   140\t        return service.history(ledger, view_id, from_day or None, to_day or None)\n   141\t\n   142\t\n   143\t@mcp.tool()\n   144\tdef evidence(view_id: str, as_of: str = '', tier: str = '') -> list:\n   145\t    \"\"\"Evidence in force under the view as of a day: one line, the source's own words, tier (发生的事 fact, 当事人说的\n   146\t    party statement, 第三方看法 third-party view, 传闻 rumour), speaker, when it arrived, its sources.\"\"\"\n   147\t    with connections() as (ledger, _items, _index):\n   148\t        return service.evidence(ledger, view_id, as_of or None, tier or None)\n   149\t\n   150\t\n   151\t@mcp.tool()\n   152\tdef record(view_id: str, as_of: str = '') -> dict:\n   153\t    \"\"\"The last check of the view on or before the day: when, by which round, how many items were processed that\n   154\t    day and how much evidence arrived under the view.\"\"\"\n   155\t    with connections() as (ledger, _items, _index):\n   156\t        return service.record(ledger, view_id, as_of or None)\n   157\t\n   158\t\n   159\t@mcp.tool()\n   160\tdef changes(since_day: str, to_day: str = '') -> list:\n   161\t    \"\"\"Judgements that said 'changed' after since_day, each with the view, from/to position and the evidence cited.\"\"\"\n   162\t    with connections() as (ledger, _items, _index):\n   163\t        return service.changes(ledger, since_day, to_day or None)\n   164\t\n   165\t\n   166\t@mcp.tool()\n   167\tdef evaluate(view_id: str, comparator: str, value_usd: float, as_of: str = '') -> dict:\n   168\t    \"\"\"A claim against a view's ladder: 'the quantity >= / < / = value_usd'. Returns the ladder position the\n   169\t    threshold sits in, the judged position, and the verdict: holds (the judged band is wholly on the claim's side),\n   170\t    not_yet (wholly on the other side) or borderline (the threshold cuts through the judged band).\"\"\"\n   171\t    with connections() as (ledger, _items, _index):\n   172\t        answer = service.evaluate(ledger, view_id, comparator, value_usd, as_of or None)\n   173\t    if answer is None:\n   174\t        raise ValueError(f'no view {view_id} as of {as_of or \"the last completed day\"}')\n   175\t    return answer\n   176\t\n   177\t\n   178\tif __name__ == '__main__':\n   179\t    mcp.run(transport=ARGS.transport)\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc 'nl -ba src/hivemind/service.py'","aggregated_output":"     1\t\"\"\"Read-only answers over the views ledger, as of a calendar day (docs/poc/service.md).\n     2\t\n     3\tNothing here reads the clock (D12, D13): every function takes `as_of`, a day, and the default is the ledger's last\n     4\tcompleted day. A row is visible as of a day when the sequence number it was written under belongs to an item or a\n     5\tdaily round dated on or before that day. Nothing here writes.\n     6\t\"\"\"\n     7\timport json\n     8\timport re\n     9\timport sqlite3\n    10\tfrom decimal import Decimal\n    11\t\n    12\tfrom . import vocabulary\n    13\tfrom .views import store\n    14\t\n    15\tTIER_FACT = vocabulary.TIERS[0]          # 'fact'; a legacy ledger's '发生的事' compares equal through vocabulary.canonical\n    16\tCOMPARATORS = ('>=', '<', '=')\n    17\t\n    18\t\n    19\tdef open_ledger(path):\n    20\t    \"\"\"A read-only connection to a views database.\"\"\"\n    21\t    return store.open_read_only(path)\n    22\t\n    23\t\n    24\tdef default_as_of(conn):\n    25\t    \"\"\"Today's default day: the last completed day, or a legacy ledger's last judgement day. Read only through `resolve_bound`.\"\"\"\n    26\t    return store.last_completed_day(conn) or conn.execute('select max(publication_day) from judgements').fetchone()[0]\n    27\t\n    28\t\n    29\tclass FirstDayNotCompleted(ValueError):\n    30\t    \"\"\"The store holds processing steps and no completed day: its first day is still in progress, and nothing is served from it\n    31\t    (live-service/OPERATING-CONTRACT.md, row 4; open defect 10).\"\"\"\n    32\t\n    33\t    def __init__(self):\n    34\t        super().__init__(\"the store's first day has not completed\")\n    35\t\n    36\t\n    37\tclass BoundNotCompleted(ValueError):\n    38\t    \"\"\"An explicit upper bound later than the store's last completed day: refused, naming that day (OPERATING-CONTRACT.md, row 3).\"\"\"\n    39\t\n    40\t    def __init__(self, requested, last_completed_day):\n    41\t        self.requested, self.last_completed_day = requested, last_completed_day\n    42\t        super().__init__(f'day not completed: {requested} is after the last completed day {last_completed_day}')\n    43\t\n    44\t\n    45\tclass RangeNotOrdered(ValueError):\n    46\t    \"\"\"A range whose start is after its resolved end: a window reaching into days not yet completed (council round 124).\"\"\"\n    47\t\n    48\t    def __init__(self, start, end):\n    49\t        self.start, self.end = start, end\n    50\t        super().__init__(f'range start after its end: {start} to {end}')\n    51\t\n    52\t\n    53\tdef first_day_unfinished(conn):\n    54\t    return store.last_completed_day(conn) is None and conn.execute('select 1 from processing_steps limit 1').fetchone() is not None\n    55\t\n    56\t\n    57\tdef resolve_bound(conn, bound, *, unfiltered=False):\n    58\t    \"\"\"The one owner of an upper date bound, explicit or omitted (OPERATING-CONTRACT.md, row 3).\n    59\t\n    60\t    A store whose first day is in progress is refused. An omitted bound is today's default day; with `unfiltered` (the bundle\n    61\t    functions, whose omitted bound read every record), it is the last completed day, or None (no filter, as before) on a store with\n    62\t    none. An explicit bound later than the last completed day is refused, whatever the store holds after it; one on or before it\n    63\t    passes. Idempotent: a bound it passed passes again.\"\"\"\n    64\t    if first_day_unfinished(conn):\n    65\t        raise FirstDayNotCompleted()\n    66\t    last = store.last_completed_day(conn)\n    67\t    if not bound:\n    68\t        return last if unfiltered else default_as_of(conn)\n    69\t    if last is not None and bound > last:\n    70\t        raise BoundNotCompleted(bound, last)\n    71\t    return bound\n    72\t\n    73\t\n    74\tdef resolve_range(conn, start, end):\n    75\t    \"\"\"A range's end resolved by `resolve_bound` (an explicit future end is refused there); a start after the end is refused. A start\n    76\t    equal to the end reads as before: an empty window for `changes`, whose start is excluded, and that one day for `history`, whose\n    77\t    start is included; a client polling \"what changed since the day I last saw\" keeps its empty answer until a day completes\n    78\t    (council round 124). An end that resolves to None (an empty store) is compared with nothing, as before.\"\"\"\n    79\t    end = resolve_bound(conn, end)\n    80\t    if start and end is not None and start > end:\n    81\t        raise RangeNotOrdered(start, end)\n    82\t    return end\n    83\t\n    84\t\n    85\t_SEQ_DAYS = {}      # id(connection) → (connection, (max sequence, rows), map); a sqlite3 connection cannot carry attributes\n    86\t\n    87\t\n    88\tdef seq_day_map(conn):\n    89\t    \"\"\"sequence number → the publication day of the item or daily round written under it. Cached per connection and\n    90\t    rebuilt when processing_steps has grown (an open ledger gains steps while the pipeline runs); without the cache\n    91\t    one view with 367 pieces of evidence cost 1,224 full scans (0.46 s, measured 2026-10-24).\"\"\"\n    92\t    stamp = tuple(conn.execute('select max(sequence_no), count(*) from processing_steps').fetchone())\n    93\t    entry = _SEQ_DAYS.get(id(conn))\n    94\t    if entry is not None and entry[0] is conn and entry[1] == stamp:\n    95\t        return entry[2]\n    96\t    cache = {}\n    97\t    for seq, day in conn.execute('select sequence_no, min(publication_day) from processing_steps where sequence_no > 0 group by sequence_no'):\n    98\t        cache[seq] = day\n    99\t    if cache:                 # sequence 0 is the seed questions written before the first item (D253): visible from the ledger's first day\n   100\t        cache[0] = min(cache.values())\n   101\t    if len(_SEQ_DAYS) >= 64:\n   102\t        _SEQ_DAYS.clear()\n   103\t    _SEQ_DAYS[id(conn)] = (conn, stamp, cache)\n   104\t    return cache\n   105\t\n   106\t\n   107\tdef day_of_seq(conn, seq):\n   108\t    return seq_day_map(conn).get(seq)\n   109\t\n   110\t\n   111\tdef visible(conn, seq, as_of):\n   112\t    day = day_of_seq(conn, seq)\n   113\t    return day is not None and day <= as_of\n   114\t\n   115\t\n   116\t# ---------- views\n   117\t\n   118\tdef view_exists(conn, record, as_of):\n   119\t    return visible(conn, record['created_seq'], as_of)\n   120\t\n   121\t\n   122\tdef is_open_as_of(conn, view_id, as_of):\n   123\t    for row in conn.execute('select open, after_seq from view_switches where view_id=? order by id desc', (view_id,)):\n   124\t        if visible(conn, row['after_seq'], as_of):\n   125\t            return bool(row['open'])\n   126\t    return True\n   127\t\n   128\t\n   129\tdef state_as_of(conn, view_id, as_of):\n   130\t    \"\"\"The last judgement on or before the day, with the day the current position was first taken.\"\"\"\n   131\t    rows = [dict(r) for r in conn.execute('select * from judgements where view_id=? and publication_day<=? order by judgement_id', (view_id, as_of))]\n   132\t    if not rows:\n   133\t        return None\n   134\t    last = rows[-1]\n   135\t    since, previous = last['publication_day'], None\n   136\t    for row in reversed(rows[:-1]):\n   137\t        if row['rung'] != last['rung']:\n   138\t            previous = row['rung']\n   139\t            break\n   140\t        since = row['publication_day']\n   141\t    return {'position': last['rung'], 'judgement_day': last['publication_day'], 'since_day': since, 'previous_position': previous,\n   142\t            'rounds': len(rows), 'why_changed': last['why_changed'], 'reasons': last['reasons'], 'theme_pushes': _json(last.get('theme_pushes_json'))}\n   143\t\n   144\t\n   145\tdef summaries(conn, as_of=None, include_closed=False):\n   146\t    \"\"\"Every view as of the day as a light record (id, object, kind, what it looks at, the question, due day, open,\n   147\t    dependency and dependant ids): what a search ranks. The full record with its evidence counts is `view`; listing\n   148\t    92 of those cost 0.29 s per search (1,205 evidence reads), measured 2026-10-24.\"\"\"\n   149\t    as_of = resolve_bound(conn, as_of)\n   150\t    out = []\n   151\t    for record in conn.execute('select * from views order by created_seq'):\n   152\t        record = dict(record)\n   153\t        if not view_exists(conn, record, as_of):\n   154\t            continue\n   155\t        is_open = is_open_as_of(conn, record['view_id'], as_of)\n   156\t        if not include_closed and not is_open:\n   157\t            continue\n   158\t        out.append({'view_id': record['view_id'], 'object': record['object_id'], 'object_kind': record['object_kind'], 'kind': record['kind'],\n   159\t                    'looks_at': record['looks_at'], 'question': record['question'], 'due_day': record['due_day'], 'open': is_open,\n   160\t                    'dependencies': [d['view_id'] for d in dependencies(conn, record['view_id'], as_of)], 'dependants': dependants(conn, record['view_id'], as_of)})\n   161\t    return out\n   162\t\n   163\t\n   164\tdef views(conn, object_id=None, as_of=None, include_closed=False):\n   165\t    as_of = resolve_bound(conn, as_of)\n   166\t    rows = conn.execute('select * from views' + (' where object_id=?' if object_id else '') + ' order by created_seq', (object_id,) if object_id else ()).fetchall()\n   167\t    out = []\n   168\t    for record in rows:\n   169\t        record = dict(record)\n   170\t        if not view_exists(conn, record, as_of):\n   171\t            continue\n   172\t        if not include_closed and not is_open_as_of(conn, record['view_id'], as_of):\n   173\t            continue\n   174\t        out.append(view(conn, record['view_id'], as_of, record=record))\n   175\t    return out\n   176\t\n   177\t\n   178\tdef dependencies(conn, view_id, as_of):\n   179\t    \"\"\"The view's dependencies recorded on or before the day, each pointing at the target resolved on or before it.\"\"\"\n   180\t    out = []\n   181\t    for dep in conn.execute('select * from dependencies where view_id=? order by dependency_id', (view_id,)):\n   182\t        if not visible(conn, dep['seq'], as_of):\n   183\t            continue\n   184\t        target = dep['depends_on']\n   185\t        for res in conn.execute('select resolved_to, seq from dependency_resolutions where dependency_id=? order by id desc', (dep['dependency_id'],)):\n   186\t            if visible(conn, res['seq'], as_of):\n   187\t                target = res['resolved_to']\n   188\t                break\n   189\t        out.append({'view_id': target, 'direction': dep['direction'], 'wait_chain_view_id': dep['wait_chain_view_id'], 'wait_year': dep['wait_year'], 'since_day': day_of_seq(conn, dep['seq'])})\n   190\t    return out\n   191\t\n   192\t\n   193\tdef dependants(conn, view_id, as_of):\n   194\t    \"\"\"The views recorded on or before the day as depending on this one (directly or by a resolution).\"\"\"\n   195\t    direct = [r['view_id'] for r in conn.execute('select view_id, seq from dependencies where depends_on=?', (view_id,)) if visible(conn, r['seq'], as_of)]\n   196\t    resolved = [r['view_id'] for r in conn.execute('select d.view_id, r.seq from dependency_resolutions r join dependencies d on d.dependency_id=r.dependency_id where r.resolved_to=?', (view_id,)) if visible(conn, r['seq'], as_of)]\n   197\t    return sorted(set(direct + resolved))\n   198\t\n   199\t\n   200\tdef view(conn, view_id, as_of=None, record=None):\n   201\t    as_of = resolve_bound(conn, as_of)\n   202\t    record = record or store.view(conn, view_id)\n   203\t    if not record or not view_exists(conn, record, as_of):\n   204\t        return None\n   205\t    rungs = store.rungs_of(conn, view_id)\n   206\t    state = state_as_of(conn, view_id, as_of)\n   207\t    if state:\n   208\t        rung = next((r for r in rungs if r['position'] == state['position']), None)\n   209\t        state['label'] = rung['label'] if rung else None\n   210\t        state['condition'] = rung['condition'] if rung else None\n   211\t    in_force = evidence(conn, view_id, as_of)\n   212\t    return {\n   213\t        'view_id': view_id, 'object': record['object_id'], 'object_kind': record['object_kind'], 'kind': record['kind'],\n   214\t        'looks_at': record['looks_at'], 'question': record['question'], 'due_day': record['due_day'], 'year': record['year'],\n   215\t        'created_day': day_of_seq(conn, record['created_seq']), 'created_from': record['created_from_input'],\n   216\t        'as_of': as_of, 'open': is_open_as_of(conn, view_id, as_of), 'rungs': rungs, 'state': state,\n   217\t        'dependencies': dependencies(conn, view_id, as_of), 'dependants': dependants(conn, view_id, as_of),\n   218\t        'counts': {'rounds': state['rounds'] if state else 0, 'evidence': len(in_force), 'facts': sum(1 for e in in_force if vocabulary.canonical('tier', e['tier']) == TIER_FACT)},\n   219\t    }\n   220\t\n   221\t\n   222\t# ---------- evidence\n   223\t\n   224\tdef evidence_record(conn, evidence_id, as_of, arrived_seq=None):\n   225\t    \"\"\"One piece of evidence with only the sources recorded on or before the day (a later outlet of the same\n   226\t    sentence is not yet known on that day).\"\"\"\n   227\t    piece = store.evidence(conn, evidence_id)\n   228\t    if not piece:\n   229\t        return None\n   230\t    sources = [dict(s) for s in conn.execute('select input_id, category, publication_day, seq from evidence_sources where evidence_id=? order by id', (evidence_id,)) if visible(conn, s['seq'], as_of)]\n   231\t    replaces = conn.execute('select old_evidence_id, seq from replacements where new_evidence_id=?', (evidence_id,)).fetchone()\n   232\t    return {'evidence_id': piece['evidence_id'], 'one_line': piece['one_line'], 'quote': piece['quote'], 'tier': piece['tier'],\n   233\t            'speaker': piece['speaker'], 'original_who': piece['original_who'], 'original_day': piece['original_day'], 'event_time': piece['event_time'],\n   234\t            'day': day_of_seq(conn, arrived_seq if arrived_seq is not None else piece['created_seq']), 'sources': sources, 'outlets': len(sources),\n   235\t            'replaces': replaces['old_evidence_id'] if replaces and visible(conn, replaces['seq'], as_of) else None}\n   236\t\n   237\t\n   238\tdef evidence(conn, view_id, as_of=None, tier=None):\n   239\t    \"\"\"Evidence linked to the view on or before the day and not replaced on or before it, with its sources.\"\"\"\n   240\t    as_of = resolve_bound(conn, as_of)\n   241\t    out = []\n   242\t    for link in conn.execute('select evidence_id, seq from evidence_links where view_id=? order by id', (view_id,)):\n   243\t        if not visible(conn, link['seq'], as_of):\n   244\t            continue\n   245\t        replacement = conn.execute('select new_evidence_id, said_day, seq from replacements where old_evidence_id=? order by id desc limit 1', (link['evidence_id'],)).fetchone()\n   246\t        if replacement and visible(conn, replacement['seq'], as_of):\n   247\t            continue\n   248\t        piece = evidence_record(conn, link['evidence_id'], as_of, link['seq'])\n   249\t        if tier and piece['tier'] != tier:\n   250\t            continue\n   251\t        out.append(piece)\n   252\t    return out\n   253\t\n   254\t\n   255\t# ---------- history\n   256\t\n   257\tdef history(conn, view_id, from_day=None, to_day=None):\n   258\t    to_day = resolve_range(conn, from_day, to_day)\n   259\t    from_day = from_day or '0000-00-00'\n   260\t    judgements = []\n   261\t    previous = None\n   262\t    for row in conn.execute('select * from judgements where view_id=? order by judgement_id', (view_id,)):\n   263\t        entry = {'day': row['publication_day'], 'seq': row['seq'], 'position': row['rung'], 'changed': bool(row['changed']), 'moved_from': previous if previous is not None and previous != row['rung'] else None,\n   264\t                 'why_changed': row['why_changed'], 'reasons': row['reasons'], 'cited': _unique(_json(row['cited_evidence_json'])), 'pushes': _json(row['pushes_json']),\n   265\t                 'theme_pushes': _json(row['theme_pushes_json'] if 'theme_pushes_json' in row.keys() else None), 'round': row['input_id']}\n   266\t        previous = row['rung']\n   267\t        if from_day <= row['publication_day'] <= to_day:\n   268\t            judgements.append(entry)\n   269\t    arrivals = {}\n   270\t    for link in conn.execute('select evidence_id, seq from evidence_links where view_id=?', (view_id,)):\n   271\t        day = day_of_seq(conn, link['seq'])\n   272\t        if day and from_day <= day <= to_day:\n   273\t            piece = store.evidence(conn, link['evidence_id'])\n   274\t            bucket = arrivals.setdefault(day, {'evidence': 0, 'facts': 0})\n   275\t            bucket['evidence'] += 1\n   276\t            bucket['facts'] += int(vocabulary.canonical('tier', piece['tier']) == TIER_FACT)\n   277\t    replacements = [{'day': day_of_seq(conn, r['seq']), 'old': r['old_evidence_id'], 'new': r['new_evidence_id'], 'said_day': r['said_day']}\n   278\t                    for r in conn.execute('select r.* from replacements r join evidence_links l on l.evidence_id=r.new_evidence_id where l.view_id=?', (view_id,))\n   279\t                    if day_of_seq(conn, r['seq']) and from_day <= day_of_seq(conn, r['seq']) <= to_day]\n   280\t    switches = [{'day': day_of_seq(conn, s['after_seq']), 'open': bool(s['open']), 'reason': s['reason']}\n   281\t                for s in conn.execute('select * from view_switches where view_id=? order by id', (view_id,)) if day_of_seq(conn, s['after_seq']) and from_day <= day_of_seq(conn, s['after_seq']) <= to_day]\n   282\t    return {'view_id': view_id, 'from_day': from_day, 'to_day': to_day, 'judgements': judgements,\n   283\t            'changes': [j for j in judgements if j['moved_from'] is not None], 'arrivals': dict(sorted(arrivals.items())),\n   284\t            'replacements': replacements, 'switches': switches}\n   285\t\n   286\t\n   287\tclass LedgerError(ValueError):\n   288\t    \"\"\"A ledger record the service cannot read (corrupt JSON): refused, never read as empty.\"\"\"\n   289\t\n   290\t\n   291\tclass StoreUnreadable(LedgerError):\n   292\t    \"\"\"The store could not be opened, or its read transaction begun and pinned (live-service/OPERATING-CONTRACT.md, row 1): named by\n   293\t    its path, never answered with an empty or stale state.\"\"\"\n   294\t\n   295\t\n   296\tdef open_pinned(path):\n   297\t    \"\"\"A reader's connection with its committed state pinned (row 2: `BEGIN`, then a first read, which in WAL mode fixes the state\n   298\t    every later read of the request sees). A SQLite failure in these three steps closes what was opened and raises `StoreUnreadable`\n   299\t    naming the path; a later SQLite error is not covered here.\"\"\"\n   300\t    conn = None\n   301\t    try:\n   302\t        conn = open_ledger(path)\n   303\t        conn.execute('begin')\n   304\t        conn.execute('select 1 from sqlite_master limit 1').fetchone()\n   305\t        return conn\n   306\t    except sqlite3.Error as error:\n   307\t        if conn is not None:\n   308\t            conn.close()\n   309\t        raise StoreUnreadable(f'{path}: {error}') from error\n   310\t\n   311\t\n   312\tdef _unique(ids):\n   313\t    \"\"\"A judgement's cites as the UI contract reads them: each id once, first occurrence kept. The writer stores the set from\n   314\t    2026-10-28; the sealed ledger sealed-2026-10-28-v34-nvda-3m-through-0828 holds one judgement (v2, id 736) that cites an id twice.\"\"\"\n   315\t    seen, out = set(), []\n   316\t    for value in ids:\n   317\t        if value not in seen:\n   318\t            seen.add(value)\n   319\t            out.append(value)\n   320\t    return out\n   321\t\n   322\t\n   323\tdef _json(text):\n   324\t    if not text:\n   325\t        return []\n   326\t    try:\n   327\t        return json.loads(text)\n   328\t    except ValueError as error:\n   329\t        raise LedgerError(f'a judgement record holds invalid JSON: {text[:60]!r}') from error\n   330\t\n   331\t\n   332\t# ---------- the processing record\n   333\t\n   334\tdef record(conn, view_id, as_of=None):\n   335\t    \"\"\"The last check of the view on or before the day: when, by which round, how much came in that day.\"\"\"\n   336\t    as_of = resolve_bound(conn, as_of)\n   337\t    row = conn.execute('select input_id, publication_day, seq from judgements where view_id=? and publication_day<=? order by judgement_id desc limit 1', (view_id, as_of)).fetchone()\n   338\t    if not row:\n   339\t        return {'view_id': view_id, 'as_of': as_of, 'last_check': None}\n   340\t    day = row['publication_day']\n   341\t    items = [r['input_id'] for r in conn.execute(\"select distinct input_id from processing_steps where publication_day=? and step='handed_over' and result='ok' and input_id not like 'day:%'\", (day,))]\n   342\t    arrived = sum(1 for link in conn.execute('select seq from evidence_links where view_id=?', (view_id,)) if day_of_seq(conn, link['seq']) == day)\n   343\t    return {'view_id': view_id, 'as_of': as_of, 'last_check': {'day': day, 'round': row['input_id'], 'items_processed_that_day': len(items), 'evidence_arrived_that_day': arrived}}\n   344\t\n   345\t\n   346\t# ---------- changes since a day\n   347\t\n   348\tdef changes(conn, since_day, to_day=None):\n   349\t    \"\"\"Judgements that said 'changed' after since_day (exclusive) up to to_day, with their cited evidence.\"\"\"\n   350\t    to_day = resolve_range(conn, since_day, to_day)\n   351\t    out = []\n   352\t    previous = {}\n   353\t    for row in conn.execute('select * from judgements order by judgement_id'):\n   354\t        before = previous.get(row['view_id'])\n   355\t        previous[row['view_id']] = row['rung']\n   356\t        if not row['changed'] or not (since_day < row['publication_day'] <= to_day):\n   357\t            continue\n   358\t        cited = [piece for piece in (evidence_record(conn, e, row['publication_day']) for e in _unique(_json(row['cited_evidence_json']))) if piece]\n   359\t        out.append({'view_id': row['view_id'], 'day': row['publication_day'], 'from_position': before, 'to_position': row['rung'],\n   360\t                    'position_moved': before is not None and before != row['rung'], 'why_changed': row['why_changed'], 'cited': cited})\n   361\t    return out\n   362\t\n   363\t\n   364\t# ---------- a claim against a ladder\n   365\t#\n   366\t# A rung's condition is a sentence like \"不低于 1650 亿美元且不高于 1690 亿美元，处于公司指引区间\". The band is read from\n   367\t# the comparator words and the amount that follows each; remarks after ；or ， are not part of it. The ladder is\n   368\t# evaluable only when its bands form one unbroken partition of the line (06-views: 格和格不重叠、不留空), so a\n   369\t# condition the parser cannot read makes the whole ladder \"not evaluable\" rather than a wrong verdict.\n   370\t\n   371\tINF = float('inf')\n   372\tUNIT_USD = {'万亿': Decimal('1e12'), '千亿': Decimal('1e11'), '亿': Decimal('1e8'), '万': Decimal('1e4'), None: Decimal(1)}   # exact: 269.79亿 is 26,979,000,000, not ...000.000004\n   373\t# an amount: a number with a Chinese magnitude or followed by 美元; a bare number counts only right after a comparator\n   374\t# or a range separator (大于或等于0, 小于-10亿), so years (2026年, FY2026) and model names (H100) are not amounts\n   375\tAMOUNT_TOKEN = re.compile(r'(?<![A-Za-z\\d.])(-?\\d[\\d,]*(?:\\.\\d+)?)\\s*(万亿|千亿|亿|万)?(\\s*美元)?')\n   376\tCOMPARATORS_RE = [\n   377\t    ('lo_inc', re.compile(r'不低于|不少于|至少|大于或等于|大于等于|达到或超过|达到(?!或)|≥|>=')),\n   378\t    ('lo_exc', re.compile(r'(?<!不)高于|(?<![不或])超过|大于(?!或等于|等于)|多于|>(?!=)')),\n   379\t    ('hi_inc', re.compile(r'不高于|不超过|至多|小于或等于|小于等于|≤|<=')),\n   380\t    ('hi_exc', re.compile(r'(?<!不)低于|不足|不到|(?<!不)少于|小于(?!或等于|等于)|<(?!=)')),\n   381\t    ('exact', re.compile(r'恰为|恰好为|恰好|(?<![或大小])等于')),\n   382\t]\n   383\t\n   384\t\n   385\tdef _comparators(clause):\n   386\t    \"\"\"(start, end, kind) for every comparator word, the longest match winning where words overlap\n   387\t    (\"大于或等于\" is one lower-inclusive comparator, not also a \"大于\" and an \"等于\").\"\"\"\n   388\t    found = []\n   389\t    for kind, regex in COMPARATORS_RE:\n   390\t        for match in regex.finditer(clause):\n   391\t            found.append((match.start(), match.end(), kind))\n   392\t    found.sort(key=lambda m: (m[0], -(m[1] - m[0])))\n   393\t    kept = []\n   394\t    for start, end, kind in found:\n   395\t        if kept and start < kept[-1][1]:          # inside the previous, longer match\n   396\t            continue\n   397\t        kept.append((start, end, kind))\n   398\t    return kept\n   399\tPOSTFIX_LO = re.compile(r'\\s*(?:及以上|或以上|以上)')\n   400\tPOSTFIX_HI = re.compile(r'\\s*(?:及以下|以下|以内)')\n   401\tRANGE_SEP = re.compile(r'\\s*(?:至|到|~|–|—)\\s*(?:不足|低于)?\\s*')\n   402\t\n   403\t\n   404\tdef operative_clause(condition):\n   405\t    \"\"\"The part of a condition that states the bound: the first clause (split at ；or ，) that names a money amount,\n   406\t    joined with the clauses that continue it (且 / 并且 / 但 / 或 / 并); a dateline before it (\"截至2026-12-31，\") and a\n   407\t    remark after it (\"，处于公司指引区间\", \"；与公司所称…相符\") are dropped. Parenthesised asides are removed first.\"\"\"\n   408\t    text = re.sub(r'（[^）]*）|\\([^)]*\\)', '', condition)\n   409\t    clauses = [c for c in re.split(r'[；，;]', text) if c.strip()]\n   410\t    chosen = []\n   411\t    for clause in clauses:\n   412\t        if not chosen:\n   413\t            if _amounts(clause):\n   414\t                chosen.append(clause)\n   415\t        elif re.match(r'\\s*(?:且|并且|并|但|或)', clause):\n   416\t            chosen.append(clause)\n   417\t        else:\n   418\t            break\n   419\t    return ''.join(chosen)\n   420\t\n   421\t\n   422\tdef _amounts(text):\n   423\t    \"\"\"(start, end, value_usd) for every money amount in the clause: a number with a Chinese magnitude or followed\n   424\t    by 美元, or a bare zero (\"大于或等于0\", \"小于0\"). A bare non-zero number is not money (30%, 4吉瓦, 2025年).\"\"\"\n   425\t    out = []\n   426\t    for match in AMOUNT_TOKEN.finditer(text):\n   427\t        number, unit, dollars = match.group(1), match.group(2), match.group(3)\n   428\t        value = float(Decimal(number.replace(',', '')) * UNIT_USD[unit])\n   429\t        following = text[match.end():match.end() + 1]\n   430\t        if unit is None and dollars is None and (value != 0 or following not in ('', '且', '、', '，', '；', '）', ' ', '美', '至', '到')):\n   431\t            continue          # 30%, 0%, 4吉瓦, 1个百分点, 2025年: not money\n   432\t        out.append((match.start(), match.end(), value))\n   433\t    return out\n   434\t\n   435\t\n   436\tdef band(condition):\n   437\t    \"\"\"(lo, lo_inclusive, hi, hi_inclusive) in USD, open ends as ±inf, read from the comparator words and the amount\n   438\t    each binds to (\"不低于 1650 亿美元且不高于 1690 亿美元\"), a range (\"650亿美元至720亿美元（含两端）\", \"0至不足1000亿\"),\n   439\t    a postfix (\"9000亿美元及以上\") or an exact amount (\"恰为2500亿美元\"). Remarks after ；or ， and parenthesised\n   440\t    asides are not read. None when the condition names no amount or reads inconsistently.\"\"\"\n   441\t    clause = operative_clause(condition or '')\n   442\t    inclusive_ends = bool(re.search(r'含两端|含端|包含两端', condition or ''))\n   443\t    amounts = _amounts(clause)\n   444\t    lo, lo_inc, hi, hi_inc, found = -INF, False, INF, False, False\n   445\t\n   446\t    def next_amount(after):\n   447\t        for start, end, value in amounts:\n   448\t            if start >= after:\n   449\t                return start, end, value\n   450\t        return None\n   451\t\n   452\t    for start, end, kind in _comparators(clause):\n   453\t        hit = next_amount(end)\n   454\t        if not hit or hit[0] - end > 40:\n   455\t            continue\n   456\t        value = hit[2]\n   457\t        if kind == 'exact':\n   458\t            return (value, True, value, True)\n   459\t        if kind == 'lo_inc':\n   460\t            lo, lo_inc = value, True\n   461\t        elif kind == 'lo_exc':\n   462\t            lo, lo_inc = value, False\n   463\t        elif kind == 'hi_inc':\n   464\t            hi, hi_inc = value, True\n   465\t        else:\n   466\t            hi, hi_inc = value, False\n   467\t        found = True\n   468\t    for start, end, value in amounts:\n   469\t        tail = clause[end:]\n   470\t        if POSTFIX_LO.match(tail):\n   471\t            lo, lo_inc, found = value, True, True\n   472\t        elif POSTFIX_HI.match(tail):\n   473\t            hi, hi_inc, found = value, True, True\n   474\t        sep = RANGE_SEP.match(tail)\n   475\t        if sep:\n   476\t            partner = next_amount(end + sep.end())\n   477\t            if partner and partner[0] == end + sep.end() and partner[2] > value:\n   478\t                lo, lo_inc, hi, found = value, True, partner[2], True\n   479\t                hi_inc = inclusive_ends or not re.search(r'不足|低于', sep.group(0))\n   480\t    if not found:\n   481\t        return None\n   482\t    if lo > hi or (lo == hi and not (lo_inc and hi_inc)):\n   483\t        return None\n   484\t    return (lo, lo_inc, hi, hi_inc)\n   485\t\n   486\t\n   487\tdef numeric_bands(rungs):\n   488\t    \"\"\"Bands from the rungs' own numeric bounds (keyed views): lower bound inclusive, upper exclusive, the two ends open;\n   489\t    None when a rung has no bounds.\"\"\"\n   490\t    if not rungs or any(r.get('lo') is None and r.get('hi') is None for r in rungs):\n   491\t        return None\n   492\t    out = {}\n   493\t    for r in rungs:\n   494\t        lo = -INF if r.get('lo') is None else float(r['lo']); hi = INF if r.get('hi') is None else float(r['hi'])\n   495\t        out[r['position']] = (lo, True, hi, False)\n   496\t    return out\n   497\t\n   498\t\n   499\tdef ladder_bands(rungs):\n   500\t    \"\"\"Every rung's band, or None with the reason when the ladder is not one unbroken partition by amount. Rungs that\n   501\t    carry numeric bounds are read from them; the prose parser serves the views written before keys.\"\"\"\n   502\t    numeric = numeric_bands(rungs)\n   503\t    if numeric is not None:\n   504\t        ordered = sorted(numeric.items(), key=lambda pb: pb[1][0])\n   505\t        for (p1, a), (p2, b) in zip(ordered, ordered[1:]):\n   506\t            if a[2] != b[0]:\n   507\t                return None, f'numeric bands of positions {p1} and {p2} overlap or leave a gap'\n   508\t        return numeric, None\n   509\t    bands = [(r['position'], band(r['condition'])) for r in rungs]\n   510\t    unreadable = [p for p, b in bands if b is None]\n   511\t    if unreadable:\n   512\t        return None, f'conditions not read as amounts: positions {unreadable}'\n   513\t    ordered = sorted(bands, key=lambda pb: (pb[1][0], pb[1][2]))\n   514\t    for (p1, a), (p2, b) in zip(ordered, ordered[1:]):\n   515\t        if a[2] != b[0] or a[3] == b[1]:          # adjacent bands share the boundary amount and exactly one of them owns it\n   516\t            return None, f'bands of positions {p1} and {p2} overlap or leave a gap'\n   517\t    lowest, highest = ordered[0][1], ordered[-1][1]\n   518\t    if not (lowest[0] == -INF or (lowest[0] == 0 and lowest[1])) or highest[2] != INF:     # an amount that cannot be negative may start at 0\n   519\t        return None, 'the ladder does not cover the line up to +inf'\n   520\t    return dict(bands), None\n   521\t\n   522\t\n   523\tdef _contains(b, yi):\n   524\t    lo, lo_inc, hi, hi_inc = b\n   525\t    return (lo < yi or (lo == yi and lo_inc)) and (yi < hi or (yi == hi and hi_inc))\n   526\t\n   527\t\n   528\tdef verdict_for(comparator, judged, yi):\n   529\t    \"\"\"Whether every value in the judged band satisfies the claim (holds), none does (not_yet), or some do.\"\"\"\n   530\t    lo, lo_inc, hi, hi_inc = judged\n   531\t    all_at_least = lo > yi or (lo == yi)                       # every value >= yi (lo == yi exclusive gives values > yi)\n   532\t    all_below = hi < yi or (hi == yi and not hi_inc)\n   533\t    if comparator == '>=':\n   534\t        return 'holds' if all_at_least else 'not_yet' if all_below else 'borderline'\n   535\t    if comparator == '<':\n   536\t        return 'holds' if all_below else 'not_yet' if all_at_least else 'borderline'\n   537\t    if lo == hi == yi:\n   538\t        return 'holds'\n   539\t    return 'borderline' if _contains(judged, yi) else 'not_yet'\n   540\t\n   541\t\n   542\tdef evaluate(conn, view_id, comparator, value_usd, as_of=None):\n   543\t    \"\"\"A claim \"quantity >= / < / = value\" against the view's ladder as of the day: the rung the threshold sits in,\n   544\t    the judged rung, and whether every value of the judged band satisfies the claim (holds), none does (not_yet), or\n   545\t    only some do (borderline). Only a ladder whose rungs read as one unbroken partition by amount is evaluated.\"\"\"\n   546\t    as_of = resolve_bound(conn, as_of)\n   547\t    if comparator not in COMPARATORS:\n   548\t        raise ValueError(f'comparator must be one of {COMPARATORS}')\n   549\t    record = view(conn, view_id, as_of)\n   550\t    if not record:\n   551\t        return None\n   552\t    yi = float(value_usd)          # bands are in USD too\n   553\t    bands, problem = ladder_bands(record['rungs'])\n   554\t    if bands is None:\n   555\t        return {'view_id': view_id, 'as_of': as_of, 'evaluable': False, 'reason': problem}\n   556\t    claim_position = next((p for p, b in bands.items() if _contains(b, yi)), None)\n   557\t    state = record['state']\n   558\t    if not state:\n   559\t        return {'view_id': view_id, 'as_of': as_of, 'evaluable': True, 'comparator': comparator, 'value_usd': value_usd, 'claim_position': claim_position, 'judged_position': None, 'verdict': 'not_judged'}\n   560\t    return {'view_id': view_id, 'as_of': as_of, 'evaluable': True, 'comparator': comparator, 'value_usd': value_usd,\n   561\t            'claim_position': claim_position, 'judged_position': state['position'], 'judged_label': state['label'], 'judged_condition': state['condition'],\n   562\t            'verdict': verdict_for(comparator, bands[state['position']], yi)}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_9","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba src/hivemind/identity.py; nl -ba src/hivemind/views/links.py | sed -n '115,180p'; nl -ba tests/test_service.py | head -165\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba src/hivemind/identity.py; nl -ba src/hivemind/views/links.py | sed -n '115,180p'; nl -ba tests/test_service.py | head -165\"","aggregated_output":"nl: src/hivemind/identity.py: No such file or directory\n   115\t        return 1\n   116\t    return None\n   117\t\n   118\t\n   119\tdef favourable_end(rungs):\n   120\t    \"\"\"'first' or 'last': the end whose stored label is Strongly bullish, on a five-rung ladder carrying the canonical labels in order\n   121\t    or reversed; None otherwise.\"\"\"\n   122\t    labels = [vocabulary.canonical('label', r['label']) for r in rungs]\n   123\t    if labels == LABELS:\n   124\t        return 'first'\n   125\t    if labels == LABELS[::-1]:\n   126\t        return 'last'\n   127\t    return None\n   128\t\n   129\t\n   130\tdef label_for(reader_rungs, read_rungs, sign):\n   131\t    \"\"\"The existing direction label (`first_is_bullish` / `last_is_bullish`): which end of the read question's ladder is favourable for\n   132\t    the reading asset question, given the sign; None when undecidable.\"\"\"\n   133\t    reader_direction, read_direction, favourable = typed_direction(reader_rungs), typed_direction(read_rungs), favourable_end(reader_rungs)\n   134\t    if None in (reader_direction, read_direction, favourable) or sign not in (TOGETHER, OPPOSITE):\n   135\t        return None\n   136\t    reader_high = 'first' if reader_direction == -1 else 'last'\n   137\t    favourable_is_high = favourable == reader_high\n   138\t    want_read_high = favourable_is_high if sign == TOGETHER else not favourable_is_high\n   139\t    read_high = 'first' if read_direction == -1 else 'last'\n   140\t    end = read_high if want_read_high else ('last' if read_high == 'first' else 'first')\n   141\t    return 'first_is_bullish' if end == 'first' else 'last_is_bullish'\n   142\t\n   143\t\n   144\tdef is_number_question(kind, rungs, measure):\n   145\t    \"\"\"D695: an asset question with a five-rung number ladder (canonical labels, typed direction) and a measure that is not an event.\"\"\"\n   146\t    return (kind == 'asset' and len(rungs) == 5 and bool(measure) and measure not in identity.EVENT_MEASURES\n   147\t            and typed_direction(rungs) is not None and favourable_end(rungs) is not None)\n   148\t\n   149\t\n   150\tdef stored_is_number_question(conn, view_id):\n   151\t    v, key = store.view(conn, view_id), store.view_key(conn, view_id)\n   152\t    return bool(v) and is_number_question(v['kind'], store.rungs_of(conn, view_id), (key or {}).get('measure'))\n   153\t\n   154\t\n   155\tdef candidate_rungs(conn, c, outcome, target):\n   156\t    \"\"\"The candidate's rungs as the writer will store them (a successor is oriented like its predecessor).\"\"\"\n   157\t    if outcome == 'succession' and target:\n   158\t        from .writing import oriented_like\n   159\t        return oriented_like(c, store.rungs_of(conn, target), [])['rungs']\n   160\t    return c['rungs']\n   161\t\n   162\t\n   163\t# ---------- the reading graph ----------\n   164\t\n   165\tdef stored_edges(conn):\n   166\t    \"\"\"Every stored dependency at its effective target (a bound wait counts through the question it is bound to).\"\"\"\n   167\t    edges = {}\n   168\t    for (view_id,) in conn.execute('select distinct view_id from dependencies'):\n   169\t        for dep in store.dependencies_of(conn, view_id):\n   170\t            if dep['resolved_to']:\n   171\t                edges.setdefault(view_id, set()).add(dep['resolved_to'])\n   172\t    return edges\n   173\t\n   174\t\n   175\tdef unbound_waits(conn):\n   176\t    return conn.execute(\"select count(*) from dependencies where coalesce(depends_on, '')='' and coalesce(wait_year, '')!='' \"\n   177\t                        \"and dependency_id not in (select dependency_id from dependency_resolutions)\").fetchone()[0]\n   178\t\n   179\t\n   180\tdef circles(conn, proposed):\n     1\t\"\"\"The service's as-of reads on the sealed ledger (real data, read-only). Requirements: docs/poc/service.md\n     2\t\"Checks the new path must pass\": as_of never looks ahead (views, switches, judgements, evidence, sources,\n     3\trelationships); evaluate reads every money ladder as one partition or refuses; a corrupt record is refused.\n     4\t\n     5\tRun: python3 -m pytest tests/test_service.py -q\n     6\t\"\"\"\n     7\timport os\n     8\timport re\n     9\timport sys\n    10\t\n    11\timport pytest\n    12\t\n    13\tROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))\n    14\tsys.path.insert(0, os.path.join(ROOT, 'src'))\n    15\tfrom hivemind import service  # noqa: E402\n    16\tfrom hivemind.views import store  # noqa: E402\n    17\t\n    18\tLEDGER = os.path.join(ROOT, 'poc', 'data', 'sealed-2026-10-24-run3-through-0815', 'views.sqlite')\n    19\tINF = float('inf')\n    20\t\n    21\t\n    22\t@pytest.fixture(scope='module')\n    23\tdef ledger():\n    24\t    return service.open_ledger(LEDGER)\n    25\t\n    26\t\n    27\tdef test_default_as_of_is_the_last_completed_day(ledger):\n    28\t    assert service.default_as_of(ledger) == '2026-08-15'\n    29\t\n    30\t\n    31\tdef test_state_as_of_never_looks_ahead(ledger):\n    32\t    # v3 (data center revenue) moved from position 3 to 2 on 2026-05-20\n    33\t    before, after = service.view(ledger, 'v3', '2026-05-19'), service.view(ledger, 'v3', '2026-05-20')\n    34\t    assert before['state']['position'] == 3 and after['state']['position'] == 2\n    35\t    assert after['state']['previous_position'] == 3 and after['state']['since_day'] == '2026-05-20'\n    36\t    assert before['counts']['evidence'] < after['counts']['evidence']\n    37\t\n    38\t\n    39\tdef test_a_view_does_not_exist_before_its_opening_day(ledger):\n    40\t    opened = ledger.execute(\"select publication_day from processing_steps where sequence_no=(select created_seq from views where view_id='v16') limit 1\").fetchone()[0]\n    41\t    assert opened == '2026-07-24'\n    42\t    assert service.view(ledger, 'v16', '2026-07-23') is None\n    43\t    assert service.view(ledger, 'v16', '2026-07-24') is not None\n    44\t    assert 'v16' not in {v['view_id'] for v in service.views(ledger, 'NVDA', '2026-07-23')}\n    45\t\n    46\t\n    47\tdef test_frozen_views_are_closed_only_from_their_freeze_day(ledger):\n    48\t    assert service.view(ledger, 'v24', '2026-08-01')['open'] is True\n    49\t    assert service.view(ledger, 'v24', '2026-08-02')['open'] is False\n    50\t    assert 'v24' not in {v['view_id'] for v in service.views(ledger, 'NVDA', '2026-08-15')}\n    51\t    assert 'v24' in {v['view_id'] for v in service.views(ledger, 'NVDA', '2026-08-15', include_closed=True)}\n    52\t\n    53\t\n    54\tdef test_relationships_are_as_of_too(ledger):\n    55\t    # v94 (opened 2026-08-15) depends on v1; on 2026-02-25 v1 cannot yet have it as a dependant\n    56\t    assert 'v94' in service.view(ledger, 'v1', '2026-08-15')['dependants']\n    57\t    assert 'v94' not in service.view(ledger, 'v1', '2026-02-25')['dependants']\n    58\t    late = ledger.execute(\"\"\"with m as (select sequence_no, min(publication_day) d from processing_steps where sequence_no>0 group by 1)\n    59\t        select count(*) from dependencies dep join views v on v.view_id=dep.depends_on join m md on md.sequence_no=dep.seq join m mv on mv.sequence_no=v.created_seq where md.d > mv.d\"\"\").fetchone()[0]\n    60\t    assert late == 28          # the relationships that would leak without the filter (Codex's census)\n    61\t    for dep in service.view(ledger, 'v3', '2026-05-20')['dependencies']:\n    62\t        assert dep['since_day'] <= '2026-05-20'\n    63\t\n    64\t\n    65\tdef test_history_lists_the_change_with_its_cited_evidence(ledger):\n    66\t    h = service.history(ledger, 'v1', '2026-07-01', '2026-08-15')\n    67\t    moves = [(c['day'], c['moved_from'], c['position']) for c in h['changes']]\n    68\t    assert ('2026-07-26', 3, 4) in moves and ('2026-08-15', 4, 5) in moves\n    69\t    assert all(j['cited'] for j in h['changes'])\n    70\t    assert sum(b['evidence'] for b in h['arrivals'].values()) > 0\n    71\t\n    72\t\n    73\tdef test_evidence_excludes_replaced_guidance_after_the_replacement_day(ledger):\n    74\t    repl = ledger.execute('select r.old_evidence_id, r.new_evidence_id, r.seq, l.view_id from replacements r join evidence_links l on l.evidence_id=r.old_evidence_id limit 1').fetchone()\n    75\t    day = service.day_of_seq(ledger, repl['seq'])\n    76\t    before = {e['evidence_id'] for e in service.evidence(ledger, repl['view_id'], service.day_of_seq(ledger, repl['seq'] - 1) or '2026-05-19')}\n    77\t    after = {e['evidence_id'] for e in service.evidence(ledger, repl['view_id'], day)}\n    78\t    assert repl['old_evidence_id'] in before and repl['old_evidence_id'] not in after and repl['new_evidence_id'] in after\n    79\t\n    80\t\n    81\tdef test_changes_cite_evidence_with_only_the_sources_known_that_day(ledger):\n    82\t    # e3 under v4 gained outlets on 05-20 and 08-06; the 02-25 change must not show them\n    83\t    changed = [c for c in service.changes(ledger, '2026-02-24', '2026-02-25') if c['view_id'] == 'v4']\n    84\t    assert changed and any(e['evidence_id'] == 'e3' for e in changed[0]['cited'])\n    85\t    e3 = next(e for e in changed[0]['cited'] if e['evidence_id'] == 'e3')\n    86\t    assert all(s['publication_day'] <= '2026-02-25' for s in e3['sources']) and e3['outlets'] == len(e3['sources'])\n    87\t    assert ledger.execute(\"select count(*) from evidence_sources where evidence_id='e3'\").fetchone()[0] > e3['outlets']\n    88\t\n    89\t\n    90\tdef test_every_money_ladder_reads_as_one_partition_or_is_refused(ledger):\n    91\t    # a money ladder is one whose conditions name dollar amounts; decided by the text, not by the parser under test\n    92\t    money = re.compile(r'\\d\\s*(?:万亿|千亿|亿|万)?\\s*美元')\n    93\t    evaluable, refused, no_money = [], [], []\n    94\t    for (view_id,) in ledger.execute('select view_id from views'):\n    95\t        rungs = store.rungs_of(ledger, view_id)\n    96\t        if sum(1 for r in rungs if money.search(r['condition'])) < 3:\n    97\t            no_money.append(view_id)\n    98\t            continue\n    99\t        bands, problem = service.ladder_bands(rungs)\n   100\t        (evaluable if bands else refused).append((view_id, problem))\n   101\t    assert len(evaluable) == 43 and refused == [], refused\n   102\t    # the non-money ladders (percentages, gigawatts) read partially or not at all, and evaluate refuses them\n   103\t    for view_id in ('v32', 'v51', 'v52', 'v61', 'v81', 'v93'):\n   104\t        assert service.evaluate(ledger, view_id, '>=', 1)['evaluable'] is False\n   105\t    assert service.band('最终担保融资金额为0至不足1000亿美元') == (0.0, True, 1e11, False)\n   106\t    assert service.band('截至2026-12-31，筹集总额不低于5000亿美元且低于7500亿美元。') == (5e11, True, 7.5e11, False)   # the dateline is not the bound\n   107\t    assert service.band('不低于100亿美元，且低于200亿美元') == (1e10, True, 2e10, False)                              # a continued clause is\n   108\t    assert service.band('FY2027 OEM设备及大型数据中心收入不低于FY2026按披露占比计算的269.79亿美元、且低于400亿美元')[0] == 26979000000.0   # exact, not ...000.000004\n   109\t    assert service.ladder_bands([{'position': 1, 'condition': '低于100亿美元'}, {'position': 2, 'condition': '高于100亿美元'}])[0] is None   # nobody owns 100亿\n   110\t    assert service.band('FY2026 全年总费用不低于 1650 亿美元且不高于 1690 亿美元，处于公司指引区间') == (1.65e11, True, 1.69e11, True)\n   111\t    assert service.band('FY2027全年总收入为650亿美元至720亿美元（含两端）') == (6.5e10, True, 7.2e10, True)\n   112\t    assert service.band('FY2027全年总收入不低于FY2025的220亿美元、且低于FY2026的391亿美元') == (2.2e10, True, 3.91e10, False)\n   113\t    assert service.band('FY2026全年总收入大于或等于104亿美元（Q2收入26亿美元按四个季度年化）且小于124亿美元') == (1.04e10, True, 1.24e10, False)\n   114\t    assert service.band('达到9000亿美元及以上') == (9e11, True, INF, False)\n   115\t    assert service.band('园区总成本恰为5000亿美元') == (5e11, True, 5e11, True)\n   116\t    assert service.band('同比增长超过70%且不超过100%') is None\n   117\t\n   118\t\n   119\tdef test_evaluate_judges_the_claim_against_the_judged_band(ledger):\n   120\t    holds = service.evaluate(ledger, 'v3', '>=', 300e9)\n   121\t    assert holds['claim_position'] == 2 and holds['judged_position'] == 2 and holds['verdict'] == 'holds'\n   122\t    assert service.evaluate(ledger, 'v3', '>=', 325e9)['verdict'] == 'borderline'\n   123\t    assert service.evaluate(ledger, 'v3', '>=', 350e9)['verdict'] == 'not_yet'\n   124\t    assert service.evaluate(ledger, 'v3', '<', 350e9)['verdict'] == 'holds'\n   125\t    assert service.evaluate(ledger, 'v3', '=', 325e9)['verdict'] == 'borderline'        # a band does not establish equality\n   126\t    assert service.evaluate(ledger, 'v3', '>=', 300e9, '2026-05-19')['judged_position'] == 3\n   127\t    # Codex's two cases: a [0, 1000亿) band straddles 500亿; \"不高于 1690 亿\" puts 1690 亿 inside position 3\n   128\t    assert service.evaluate(ledger, 'v17', '>=', 50e9)['verdict'] == 'borderline'\n   129\t    v27 = service.evaluate(ledger, 'v27', '>=', 169e9)\n   130\t    assert v27['claim_position'] == 3 and v27['verdict'] == 'borderline'\n   131\t    # Codex's second pass: a boundary written as 269.79亿 is exactly 26,979,000,000 and belongs to position 3; v70's\n   132\t    # dateline does not hide its bound\n   133\t    v84 = service.evaluate(ledger, 'v84', '=', 26979000000)\n   134\t    assert v84['claim_position'] == 3 and v84['verdict'] == 'borderline'\n   135\t    v70 = service.evaluate(ledger, 'v70', '>=', 500e9)\n   136\t    assert v70['evaluable'] and v70['claim_position'] == 3 and v70['verdict'] in ('holds', 'borderline', 'not_yet')\n   137\t    assert service.evaluate(ledger, 'v7', '>=', 1e9)['evaluable'] is False      # a yes/no ladder has no amounts\n   138\t    assert service.evaluate(ledger, 'v51', '>=', 1)['evaluable'] is False       # a percentage ladder is refused, not guessed\n   139\t    with pytest.raises(ValueError):\n   140\t        service.evaluate(ledger, 'v3', '>', 300e9)\n   141\t\n   142\t\n   143\tdef test_record_and_changes_name_real_rounds(ledger):\n   144\t    rec = service.record(ledger, 'v3', '2026-08-15')['last_check']\n   145\t    assert rec['day'] == '2026-08-15' and rec['round'].startswith('day:') and rec['items_processed_that_day'] > 0\n   146\t    moved = [c for c in service.changes(ledger, '2026-07-25', '2026-07-26') if c['position_moved']]\n   147\t    assert any(c['view_id'] == 'v1' and c['from_position'] == 3 and c['to_position'] == 4 and c['cited'] for c in moved)\n   148\t    assert service.changes(ledger, '2026-08-15') == []\n   149\t\n   150\t\n   151\tdef test_a_corrupt_judgement_record_is_refused_not_read_as_empty():\n   152\t    with pytest.raises(service.LedgerError):\n   153\t        service._json('[broken')\n   154\t    assert service._json('') == [] and service._json('[\"e1\"]') == ['e1']\n","exit_code":0,"status":"completed"}}
