\\\\\\\'')) and tag(t,r'\\\\\\\\\\\\\\\\''(?:plus|add|sum|combin|\\\\\\\\\\\\\\\\+)'\\\\\\\\\\\\\\\\'') for t in texts)\\\\n   elif f=='\\\\\\\\\\\\\\\\''capex'\\\\\\\\\\\\\\\\'':\\\\n    hit=any(set([D(730),D(800),D(1300)])<=set(figures(t,'\\\\\\\\\\\\\\\\''USD'\\\\\\\\\\\\\\\\'')) and tag(t,r'\\\\\\\\\\\\\\\\''proxy|share|ratio|scal'\\\\\\\\\\\\\\\\'') for t in texts)\\\\n   else:\\\\n    hit=any(tag(t,r'\\\\\\\\\\\\\\\\''discount|haircut|trim'\\\\\\\\\\\\\\\\'') and bool(set(D(n) for n in (35,36,37,38,39,39.5))&set(figures(t,'\\\\\\\\\\\\\\\\''USD'\\\\\\\\\\\\\\\\''))) for t in texts)\\\\n   if hit:hits.append(j)\\\\n  print(i,id,f,len(rows),len(hits), '\\\\\\\\\\\\\\\\''dates'\\\\\\\\\\\\\\\\'',[j['\\\\\\\\\\\\\\\\''publication_day'\\\\\\\\\\\\\\\\''][5:] for j in hits])\\\\n  for j in hits[:1]+hits[-1:]:\\\\n   d,raw=req(a,j); t=user(d); ed=evidence(t)\\\\n   print(j['\\\\\\\\\\\\\\\\''call_id'\\\\\\\\\\\\\\\\''],j['\\\\\\\\\\\\\\\\''publication_day'\\\\\\\\\\\\\\\\''],j['\\\\\\\\\\\\\\\\''implied_outcome'\\\\\\\\\\\\\\\\''],j['\\\\\\\\\\\\\\\\''reference'\\\\\\\\\\\\\\\\''])\\\\n   for k in raw['\\\\\\\\\\\\\\\\''cites'\\\\\\\\\\\\\\\\'']:\\\\n    e=ed[k]\\\\n    if (f=='\\\\\\\\\\\\\\\\''equity'\\\\\\\\\\\\\\\\'' and any(x in figures(e,'\\\\\\\\\\\\\\\\''USD'\\\\\\\\\\\\\\\\'') for x in (D(18),D(25)))) or (f=='\\\\\\\\\\\\\\\\''capex'\\\\\\\\\\\\\\\\'' and any(x in figures(e,'\\\\\\\\\\\\\\\\''USD'\\\\\\\\\\\\\\\\'') for x in (D(730),D(1300)))) or (f=='\\\\\\\\\\\\\\\\''vera'\\\\\\\\\\\\\\\\'' and tag(e,'\\\\\\\\\\\\\\\\''doubl'\\\\\\\\\\\\\\\\'')):print(e[:440])\\\\n'\\\\\\\"\\\",\\\"aggregated_output\\\":\\\"1 v28 equity 35 8 dates ['09-07', '09-09', '09-15', '09-16', '09-17', '09-18', '09-19', '09-20']\\\\n7204 2026-09-07 Approximately $43 billion outstanding at the FY2027 annual report: carry forward the prior roughly $40 billion estimate based on the $25 billion disclosed balance and the $18 billion committed for the rest of FY2027, then modestly increase it for the newly reported $3 billion SB Energy investment, without counting the contingent lease assumption. The disclosed $25 billion of equity-investment commitments outstanding as of July 26, 2026; this is rung 1 (below $35 billion).\\\\n- e2766 [party_statement; NVIDIA Corporation; original source NVIDIA Corporation 2026-08-26; from edgar:NVDA:0001045810-26-000075:nvda-20260726.htm 2026-08-26] NVIDIA reported $99 billion of equity investments and $25 billion of equity investment commitments as of July 26, 2026.\\\\n    Quote: These include equity investments of $99 billion and equity investment commitments of $25 billion as of July 26, 2026.\\\\n    Opinion, not verified: the \\\\n- e3044 [party_statement; Business Insider; original source NVIDIA 2026-08-26; from gnews:aec1fae1b903de5c43ba7fdf 2026-08-26] NVIDIA said it had $18 billion committed to equity investments for the rest of FY2027, in addition to $47.9 billion already held in private companies.\\\\n    Quote: The company said Wednesday that it has $18 billion committed to equity investments for the rest of its fiscal year, on top of $47.9 billion it already \\\\n9016 2026-09-20 About $75 billion outstanding at the FY2027 annual report: use Bank of America’s approximately $70 billion commitment estimate as the anchor and allow a modest net increase for later disclosed deals, discounted for overlap and funding before the report. The company-based reference is about $43 billion ($25 billion of commitments as of July 26 plus $18 billion committed for the rest of FY2027), which is rung 2. No dated market consensus is supplied.\\\\n- e2766 [party_statement; NVIDIA Corporation; original source NVIDIA Corporation 2026-08-26; from edgar:NVDA:0001045810-26-000075:nvda-20260726.htm 2026-08-26] NVIDIA reported $99 billion of equity investments and $25 billion of equity investment commitments as of July 26, 2026.\\\\n    Quote: These include equity investments of $99 billion and equity investment commitments of $25 billion as of July 26, 2026.\\\\n    Opinion, not verified: the \\\\n- e3044 [party_statement; Business Insider; original source NVIDIA 2026-08-26; from gnews:aec1fae1b903de5c43ba7fdf 2026-08-26] NVIDIA said it had $18 billion committed to equity investments for the rest of FY2027, in addition to $47.9 billion already held in private companies.\\\\n    Quote: The company said Wednesday that it has $18 billion committed to equity investments for the rest of its fiscal year, on top of $47.9 billion it already \\\\n- e3481 [party_statement; ifre.com; original source NVIDIA ; from gnews:3c6f653cbcaeacf9f11fa1fc 2026-08-28] NVIDIA expects to invest $25 billion of equity in suppliers and customers over the next few years.\\\\n    Quote: Nvidia said it expects to inject US$25bn of equity into its suppliers and customers over the next few years.\\\\n1 v7 capex 46 0 dates []\\\\n1 v44 vera 11 9 dates ['09-12', '09-13', '09-14', '09-15', '09-16', '09-17', '09-18', '09-19', '09-20']\\\\n7876 2026-09-12 About $35 billion for FY2028: take the stated $20 billion FY2027 potential times more than 2 as a nominal $40 billion-plus reference, then discount it because the evidence does not show the FY2028 volume in hand. No absolute-dollar market consensus is supplied. Management's stated potential—$20 billion in FY2027 and more than double that in FY2028—implies at least $40 billion, placing the reference at rung 1.\\\\n- e4641 [party_statement; fool.com (analyst); original source NVIDIA ; from gnews:3c5c71e12ed2a7001ce14f1a 2026-09-10] NVIDIA expects Vera CPU revenue in FY2028 to be double its FY2027 Vera CPU revenue.\\\\n    Quote: What's more, Nvidia expects its Vera CPU revenue to double next year.\\\\n    Opinion, not verified: the matcher read this as the same claim as e4712; the argument counts one claim, one more outlet.\\\\n- e4712 [party_statement; fool.com (analyst), reporting Jensen Huang's Q2 investor conference call remarks; original source Jensen Huang, NVIDIA CEO 2026-08-26; from gnews:0ba93692dc5df4b999fe3729 2026-09-11] Jensen Huang expected NVIDIA CPU revenue to more than double in FY2028.\\\\n    Quote: Huang expects CPU revenue to more than double next fiscal year, making Nvidia one of the leading suppliers in the server CPU market.\\\\n    Opinion, no\\\\n- e4805 [party_statement; fool.com (Bram Berkowitz); original source NVIDIA management ; from gnews:c70bc12967b9b53426b5fb10 2026-09-12] NVIDIA management reiterated potential Vera CPU revenue of $20 billion in FY2027 and said it could more than double in FY2028.\\\\n    Quote: Management also reiterated that it still sees $20 billion in potential revenue from Vera CPUs in its current fiscal year, with the potential to more than double that\\\\n9020 2026-09-20 About $35 billion for FY2028: discount the management-stated $40 billion-plus potential for the absence of disclosed shipment volumes or realized Vera CPU revenue; full production and standalone sales support execution, while AMD’s reported benchmarks are a competitive risk. NVIDIA management’s potential $20 billion of Vera CPU revenue in FY2027 and potential to more than double it in FY2028 implies $40 billion-plus, which is rung 1.\\\\n- e4805 [party_statement; fool.com (Bram Berkowitz); original source NVIDIA management ; from gnews:c70bc12967b9b53426b5fb10 2026-09-12] NVIDIA management reiterated potential Vera CPU revenue of $20 billion in FY2027 and said it could more than double in FY2028.\\\\n    Quote: Management also reiterated that it still sees $20 billion in potential revenue from Vera CPUs in its current fiscal year, with the potential to more than double that\\\\n2 v29 equity 37 17 dates ['08-26', '08-27', '08-28', '08-29', '08-30', '08-31', '09-07', '09-08', '09-09', '09-10', '09-11', '09-12', '09-13', '09-14', '09-15', '09-19', '09-20']\\\\n4938 2026-08-26 About $43 billion: the $25 billion of commitments reported as of July 26 plus the $18 billion NVIDIA said was committed for the remainder of FY20