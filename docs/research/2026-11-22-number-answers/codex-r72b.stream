{"type":"item.completed","item":{"id":"item_17","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba src/hivemind/service.py | sed -n '119,363p'; nl -ba src/hivemind/pull.py | head -72\"","aggregated_output":"   119\t    return visible(conn, record['created_seq'], as_of)\n   120\t\n   121\t\n   122\tdef is_open_as_of(conn, view_id, as_of):\n   123\t    for row in conn.execute('select open, after_seq from view_switches where view_id=? order by id desc', (view_id,)):\n   124\t        if visible(conn, row['after_seq'], as_of):\n   125\t            return bool(row['open'])\n   126\t    return True\n   127\t\n   128\t\n   129\tdef state_as_of(conn, view_id, as_of):\n   130\t    \"\"\"The last judgement on or before the day, with the day the current position was first taken.\"\"\"\n   131\t    rows = [dict(r) for r in conn.execute('select * from judgements where view_id=? and publication_day<=? order by judgement_id', (view_id, as_of))]\n   132\t    if not rows:\n   133\t        return None\n   134\t    last = rows[-1]\n   135\t    since, previous = last['publication_day'], None\n   136\t    for row in reversed(rows[:-1]):\n   137\t        if row['rung'] != last['rung']:\n   138\t            previous = row['rung']\n   139\t            break\n   140\t        since = row['publication_day']\n   141\t    return {'position': last['rung'], 'judgement_day': last['publication_day'], 'since_day': since, 'previous_position': previous,\n   142\t            'rounds': len(rows), 'why_changed': last['why_changed'], 'reasons': last['reasons'], 'theme_pushes': _json(last.get('theme_pushes_json'))}\n   143\t\n   144\t\n   145\tdef summaries(conn, as_of=None, include_closed=False):\n   146\t    \"\"\"Every view as of the day as a light record (id, object, kind, what it looks at, the question, due day, open,\n   147\t    dependency and dependant ids): what a search ranks. The full record with its evidence counts is `view`; listing\n   148\t    92 of those cost 0.29 s per search (1,205 evidence reads), measured 2026-10-24.\"\"\"\n   149\t    as_of = resolve_bound(conn, as_of)\n   150\t    out = []\n   151\t    for record in conn.execute('select * from views order by created_seq'):\n   152\t        record = dict(record)\n   153\t        if not view_exists(conn, record, as_of):\n   154\t            continue\n   155\t        is_open = is_open_as_of(conn, record['view_id'], as_of)\n   156\t        if not include_closed and not is_open:\n   157\t            continue\n   158\t        out.append({'view_id': record['view_id'], 'object': record['object_id'], 'object_kind': record['object_kind'], 'kind': record['kind'],\n   159\t                    'looks_at': record['looks_at'], 'question': record['question'], 'due_day': record['due_day'], 'open': is_open,\n   160\t                    'dependencies': [d['view_id'] for d in dependencies(conn, record['view_id'], as_of)], 'dependants': dependants(conn, record['view_id'], as_of)})\n   161\t    return out\n   162\t\n   163\t\n   164\tdef views(conn, object_id=None, as_of=None, include_closed=False):\n   165\t    as_of = resolve_bound(conn, as_of)\n   166\t    rows = conn.execute('select * from views' + (' where object_id=?' if object_id else '') + ' order by created_seq', (object_id,) if object_id else ()).fetchall()\n   167\t    out = []\n   168\t    for record in rows:\n   169\t        record = dict(record)\n   170\t        if not view_exists(conn, record, as_of):\n   171\t            continue\n   172\t        if not include_closed and not is_open_as_of(conn, record['view_id'], as_of):\n   173\t            continue\n   174\t        out.append(view(conn, record['view_id'], as_of, record=record))\n   175\t    return out\n   176\t\n   177\t\n   178\tdef dependencies(conn, view_id, as_of):\n   179\t    \"\"\"The view's dependencies recorded on or before the day, each pointing at the target resolved on or before it.\"\"\"\n   180\t    out = []\n   181\t    for dep in conn.execute('select * from dependencies where view_id=? order by dependency_id', (view_id,)):\n   182\t        if not visible(conn, dep['seq'], as_of):\n   183\t            continue\n   184\t        target = dep['depends_on']\n   185\t        for res in conn.execute('select resolved_to, seq from dependency_resolutions where dependency_id=? order by id desc', (dep['dependency_id'],)):\n   186\t            if visible(conn, res['seq'], as_of):\n   187\t                target = res['resolved_to']\n   188\t                break\n   189\t        out.append({'view_id': target, 'direction': dep['direction'], 'wait_chain_view_id': dep['wait_chain_view_id'], 'wait_year': dep['wait_year'], 'since_day': day_of_seq(conn, dep['seq'])})\n   190\t    return out\n   191\t\n   192\t\n   193\tdef dependants(conn, view_id, as_of):\n   194\t    \"\"\"The views recorded on or before the day as depending on this one (directly or by a resolution).\"\"\"\n   195\t    direct = [r['view_id'] for r in conn.execute('select view_id, seq from dependencies where depends_on=?', (view_id,)) if visible(conn, r['seq'], as_of)]\n   196\t    resolved = [r['view_id'] for r in conn.execute('select d.view_id, r.seq from dependency_resolutions r join dependencies d on d.dependency_id=r.dependency_id where r.resolved_to=?', (view_id,)) if visible(conn, r['seq'], as_of)]\n   197\t    return sorted(set(direct + resolved))\n   198\t\n   199\t\n   200\tdef view(conn, view_id, as_of=None, record=None):\n   201\t    as_of = resolve_bound(conn, as_of)\n   202\t    record = record or store.view(conn, view_id)\n   203\t    if not record or not view_exists(conn, record, as_of):\n   204\t        return None\n   205\t    rungs = store.rungs_of(conn, view_id)\n   206\t    state = state_as_of(conn, view_id, as_of)\n   207\t    if state:\n   208\t        rung = next((r for r in rungs if r['position'] == state['position']), None)\n   209\t        state['label'] = rung['label'] if rung else None\n   210\t        state['condition'] = rung['condition'] if rung else None\n   211\t    in_force = evidence(conn, view_id, as_of)\n   212\t    return {\n   213\t        'view_id': view_id, 'object': record['object_id'], 'object_kind': record['object_kind'], 'kind': record['kind'],\n   214\t        'looks_at': record['looks_at'], 'question': record['question'], 'due_day': record['due_day'], 'year': record['year'],\n   215\t        'created_day': day_of_seq(conn, record['created_seq']), 'created_from': record['created_from_input'],\n   216\t        'as_of': as_of, 'open': is_open_as_of(conn, view_id, as_of), 'rungs': rungs, 'state': state,\n   217\t        'dependencies': dependencies(conn, view_id, as_of), 'dependants': dependants(conn, view_id, as_of),\n   218\t        'counts': {'rounds': state['rounds'] if state else 0, 'evidence': len(in_force), 'facts': sum(1 for e in in_force if vocabulary.canonical('tier', e['tier']) == TIER_FACT)},\n   219\t    }\n   220\t\n   221\t\n   222\t# ---------- evidence\n   223\t\n   224\tdef evidence_record(conn, evidence_id, as_of, arrived_seq=None):\n   225\t    \"\"\"One piece of evidence with only the sources recorded on or before the day (a later outlet of the same\n   226\t    sentence is not yet known on that day).\"\"\"\n   227\t    piece = store.evidence(conn, evidence_id)\n   228\t    if not piece:\n   229\t        return None\n   230\t    sources = [dict(s) for s in conn.execute('select input_id, category, publication_day, seq from evidence_sources where evidence_id=? order by id', (evidence_id,)) if visible(conn, s['seq'], as_of)]\n   231\t    replaces = conn.execute('select old_evidence_id, seq from replacements where new_evidence_id=?', (evidence_id,)).fetchone()\n   232\t    return {'evidence_id': piece['evidence_id'], 'one_line': piece['one_line'], 'quote': piece['quote'], 'tier': piece['tier'],\n   233\t            'speaker': piece['speaker'], 'original_who': piece['original_who'], 'original_day': piece['original_day'], 'event_time': piece['event_time'],\n   234\t            'day': day_of_seq(conn, arrived_seq if arrived_seq is not None else piece['created_seq']), 'sources': sources, 'outlets': len(sources),\n   235\t            'replaces': replaces['old_evidence_id'] if replaces and visible(conn, replaces['seq'], as_of) else None}\n   236\t\n   237\t\n   238\tdef evidence(conn, view_id, as_of=None, tier=None):\n   239\t    \"\"\"Evidence linked to the view on or before the day and not replaced on or before it, with its sources.\"\"\"\n   240\t    as_of = resolve_bound(conn, as_of)\n   241\t    out = []\n   242\t    for link in conn.execute('select evidence_id, seq from evidence_links where view_id=? order by id', (view_id,)):\n   243\t        if not visible(conn, link['seq'], as_of):\n   244\t            continue\n   245\t        replacement = conn.execute('select new_evidence_id, said_day, seq from replacements where old_evidence_id=? order by id desc limit 1', (link['evidence_id'],)).fetchone()\n   246\t        if replacement and visible(conn, replacement['seq'], as_of):\n   247\t            continue\n   248\t        piece = evidence_record(conn, link['evidence_id'], as_of, link['seq'])\n   249\t        if tier and piece['tier'] != tier:\n   250\t            continue\n   251\t        out.append(piece)\n   252\t    return out\n   253\t\n   254\t\n   255\t# ---------- history\n   256\t\n   257\tdef history(conn, view_id, from_day=None, to_day=None):\n   258\t    to_day = resolve_range(conn, from_day, to_day)\n   259\t    from_day = from_day or '0000-00-00'\n   260\t    judgements = []\n   261\t    previous = None\n   262\t    for row in conn.execute('select * from judgements where view_id=? order by judgement_id', (view_id,)):\n   263\t        entry = {'day': row['publication_day'], 'seq': row['seq'], 'position': row['rung'], 'changed': bool(row['changed']), 'moved_from': previous if previous is not None and previous != row['rung'] else None,\n   264\t                 'why_changed': row['why_changed'], 'reasons': row['reasons'], 'cited': _unique(_json(row['cited_evidence_json'])), 'pushes': _json(row['pushes_json']),\n   265\t                 'theme_pushes': _json(row['theme_pushes_json'] if 'theme_pushes_json' in row.keys() else None), 'round': row['input_id']}\n   266\t        previous = row['rung']\n   267\t        if from_day <= row['publication_day'] <= to_day:\n   268\t            judgements.append(entry)\n   269\t    arrivals = {}\n   270\t    for link in conn.execute('select evidence_id, seq from evidence_links where view_id=?', (view_id,)):\n   271\t        day = day_of_seq(conn, link['seq'])\n   272\t        if day and from_day <= day <= to_day:\n   273\t            piece = store.evidence(conn, link['evidence_id'])\n   274\t            bucket = arrivals.setdefault(day, {'evidence': 0, 'facts': 0})\n   275\t            bucket['evidence'] += 1\n   276\t            bucket['facts'] += int(vocabulary.canonical('tier', piece['tier']) == TIER_FACT)\n   277\t    replacements = [{'day': day_of_seq(conn, r['seq']), 'old': r['old_evidence_id'], 'new': r['new_evidence_id'], 'said_day': r['said_day']}\n   278\t                    for r in conn.execute('select r.* from replacements r join evidence_links l on l.evidence_id=r.new_evidence_id where l.view_id=?', (view_id,))\n   279\t                    if day_of_seq(conn, r['seq']) and from_day <= day_of_seq(conn, r['seq']) <= to_day]\n   280\t    switches = [{'day': day_of_seq(conn, s['after_seq']), 'open': bool(s['open']), 'reason': s['reason']}\n   281\t                for s in conn.execute('select * from view_switches where view_id=? order by id', (view_id,)) if day_of_seq(conn, s['after_seq']) and from_day <= day_of_seq(conn, s['after_seq']) <= to_day]\n   282\t    return {'view_id': view_id, 'from_day': from_day, 'to_day': to_day, 'judgements': judgements,\n   283\t            'changes': [j for j in judgements if j['moved_from'] is not None], 'arrivals': dict(sorted(arrivals.items())),\n   284\t            'replacements': replacements, 'switches': switches}\n   285\t\n   286\t\n   287\tclass LedgerError(ValueError):\n   288\t    \"\"\"A ledger record the service cannot read (corrupt JSON): refused, never read as empty.\"\"\"\n   289\t\n   290\t\n   291\tclass StoreUnreadable(LedgerError):\n   292\t    \"\"\"The store could not be opened, or its read transaction begun and pinned (live-service/OPERATING-CONTRACT.md, row 1): named by\n   293\t    its path, never answered with an empty or stale state.\"\"\"\n   294\t\n   295\t\n   296\tdef open_pinned(path):\n   297\t    \"\"\"A reader's connection with its committed state pinned (row 2: `BEGIN`, then a first read, which in WAL mode fixes the state\n   298\t    every later read of the request sees). A SQLite failure in these three steps closes what was opened and raises `StoreUnreadable`\n   299\t    naming the path; a later SQLite error is not covered here.\"\"\"\n   300\t    conn = None\n   301\t    try:\n   302\t        conn = open_ledger(path)\n   303\t        conn.execute('begin')\n   304\t        conn.execute('select 1 from sqlite_master limit 1').fetchone()\n   305\t        return conn\n   306\t    except sqlite3.Error as error:\n   307\t        if conn is not None:\n   308\t            conn.close()\n   309\t        raise StoreUnreadable(f'{path}: {error}') from error\n   310\t\n   311\t\n   312\tdef _unique(ids):\n   313\t    \"\"\"A judgement's cites as the UI contract reads them: each id once, first occurrence kept. The writer stores the set from\n   314\t    2026-10-28; the sealed ledger sealed-2026-10-28-v34-nvda-3m-through-0828 holds one judgement (v2, id 736) that cites an id twice.\"\"\"\n   315\t    seen, out = set(), []\n   316\t    for value in ids:\n   317\t        if value not in seen:\n   318\t            seen.add(value)\n   319\t            out.append(value)\n   320\t    return out\n   321\t\n   322\t\n   323\tdef _json(text):\n   324\t    if not text:\n   325\t        return []\n   326\t    try:\n   327\t        return json.loads(text)\n   328\t    except ValueError as error:\n   329\t        raise LedgerError(f'a judgement record holds invalid JSON: {text[:60]!r}') from error\n   330\t\n   331\t\n   332\t# ---------- the processing record\n   333\t\n   334\tdef record(conn, view_id, as_of=None):\n   335\t    \"\"\"The last check of the view on or before the day: when, by which round, how much came in that day.\"\"\"\n   336\t    as_of = resolve_bound(conn, as_of)\n   337\t    row = conn.execute('select input_id, publication_day, seq from judgements where view_id=? and publication_day<=? order by judgement_id desc limit 1', (view_id, as_of)).fetchone()\n   338\t    if not row:\n   339\t        return {'view_id': view_id, 'as_of': as_of, 'last_check': None}\n   340\t    day = row['publication_day']\n   341\t    items = [r['input_id'] for r in conn.execute(\"select distinct input_id from processing_steps where publication_day=? and step='handed_over' and result='ok' and input_id not like 'day:%'\", (day,))]\n   342\t    arrived = sum(1 for link in conn.execute('select seq from evidence_links where view_id=?', (view_id,)) if day_of_seq(conn, link['seq']) == day)\n   343\t    return {'view_id': view_id, 'as_of': as_of, 'last_check': {'day': day, 'round': row['input_id'], 'items_processed_that_day': len(items), 'evidence_arrived_that_day': arrived}}\n   344\t\n   345\t\n   346\t# ---------- changes since a day\n   347\t\n   348\tdef changes(conn, since_day, to_day=None):\n   349\t    \"\"\"Judgements that said 'changed' after since_day (exclusive) up to to_day, with their cited evidence.\"\"\"\n   350\t    to_day = resolve_range(conn, since_day, to_day)\n   351\t    out = []\n   352\t    previous = {}\n   353\t    for row in conn.execute('select * from judgements order by judgement_id'):\n   354\t        before = previous.get(row['view_id'])\n   355\t        previous[row['view_id']] = row['rung']\n   356\t        if not row['changed'] or not (since_day < row['publication_day'] <= to_day):\n   357\t            continue\n   358\t        cited = [piece for piece in (evidence_record(conn, e, row['publication_day']) for e in _unique(_json(row['cited_evidence_json']))) if piece]\n   359\t        out.append({'view_id': row['view_id'], 'day': row['publication_day'], 'from_position': before, 'to_position': row['rung'],\n   360\t                    'position_moved': before is not None and before != row['rung'], 'why_changed': row['why_changed'], 'cited': cited})\n   361\t    return out\n   362\t\n   363\t\n     1\t\"\"\"Pull mode (D54, D356): at the end of a day (the day passed in, never read from a clock), every open view whose due day has come\n     2\tis frozen where its state stands and closed. The closing record names the rung it froze at; a view that was never judged closes\n     3\twith \"no data to verify\" (AGENTS §8: missing data is neither a pass nor a fail). Nothing waits for the day's items, there is no\n     4\tseparate final review, and no other question is re-judged here.\"\"\"\n     5\tfrom . import dispatch\n     6\tfrom .views import store\n     7\t\n     8\tNO_DATA = 'no data to verify'\n     9\t\n    10\t\n    11\tdef closing_reason(conn, view_id, due_day, day):\n    12\t    last = conn.execute('select rung from judgements where view_id=? order by seq desc, judgement_id desc limit 1', (view_id,)).fetchone()\n    13\t    if last is None:\n    14\t        return f'due {due_day}, closed on {day} with no judgement: {NO_DATA}'\n    15\t    label = conn.execute('select label from rungs where view_id=? and position=?', (view_id, last['rung'])).fetchone()\n    16\t    return f'due {due_day}, frozen on {day} at rung {last[\"rung\"]} {label[\"label\"] if label else \"\"}'.rstrip()\n    17\t\n    18\t\n    19\tdef closing_sequence(conn, day, seq):\n    20\t    \"\"\"The sequence number the day's closings are written under, so that they are dated on that day: the day's last number when\n    21\t    the day wrote it, else a new one recorded as the day's own step (a day with no items would otherwise date them on the day before).\"\"\"\n    22\t    row = conn.execute('select min(publication_day) from processing_steps where sequence_no=?', (seq,)).fetchone()\n    23\t    if seq > 0 and row[0] == day:\n    24\t        return seq\n    25\t    own = max(store.next_sequence(conn), seq + 1)\n    26\t    dispatch.mark(conn, {'input_id': f'day:{day}', 'publication_day': day}, own, 'closed', 'ok', 'due questions closed at the end of the day')\n    27\t    return own\n    28\t\n    29\t\n    30\tdef end_of_day(conn, day, seq):\n    31\t    due = [row for row in conn.execute('select view_id, due_day from views where due_day <= ? order by created_seq', (day,)).fetchall()\n    32\t           if store.is_open(conn, row['view_id'])]\n    33\t    if due:\n    34\t        seq = closing_sequence(conn, day, seq)\n    35\t    for row in due:\n    36\t        store.close_view(conn, row['view_id'], closing_reason(conn, row['view_id'], row['due_day'], day), 'pull', seq)\n    37\t    conn.commit()\n    38\t    return [row['view_id'] for row in due]\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_18","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba src/hivemind/idea_composite.py | head -290; rg -n 'prepareCompositeTrial|composite-trials' poc/ui scripts --glob '\"'!package-lock*'\"'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_18","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba src/hivemind/idea_composite.py | head -290; rg -n 'prepareCompositeTrial|composite-trials' poc/ui scripts --glob '\"'!package-lock*'\"'\"","aggregated_output":"     1\t\"\"\"The final Idea assessment's representative selection; scores remain deterministic UI calculations.\"\"\"\n     2\timport copy\n     3\t\n     4\tfrom . import model\n     5\tfrom .views import store\n     6\t\n     7\tPLAN_SCHEMA = {\n     8\t    'type': 'object', 'additionalProperties': False, 'required': ['drivers', 'excluded'],\n     9\t    'properties': {\n    10\t        'drivers': {'type': 'array', 'items': {\n    11\t            'type': 'object', 'additionalProperties': False,\n    12\t            'required': ['thesis_id', 'label', 'supporting_end', 'reason'],\n    13\t            'properties': {'thesis_id': {'type': 'string'}, 'label': {'type': 'string'},\n    14\t                           'supporting_end': {'type': 'string', 'enum': ['first', 'last']},\n    15\t                           'reason': {'type': 'string'}}}},\n    16\t        'excluded': {'type': 'array', 'items': {\n    17\t            'type': 'object', 'additionalProperties': False, 'required': ['thesis_id', 'reason'],\n    18\t            'properties': {'thesis_id': {'type': 'string'}, 'reason': {'type': 'string'}}}},\n    19\t    },\n    20\t}\n    21\tSCHEMA = {\n    22\t    'type': 'object', 'additionalProperties': False, 'required': ['summary', 'composite'],\n    23\t    'properties': {'summary': {'type': 'string'}, 'composite': PLAN_SCHEMA},\n    24\t}\n    25\t\n    26\t\n    27\tdef disposition_schema(selected):\n    28\t    \"\"\"One required property per selected identity prevents missing, duplicate or foreign dispositions.\"\"\"\n    29\t    driver = {'type': 'object', 'additionalProperties': False,\n    30\t              'required': ['kind', 'label', 'supporting_end', 'reason'],\n    31\t              'properties': {'kind': {'type': 'string', 'enum': ['driver']}, 'label': {'type': 'string'},\n    32\t                             'supporting_end': {'type': 'string', 'enum': ['first', 'last']}, 'reason': {'type': 'string'}}}\n    33\t    excluded = {'type': 'object', 'additionalProperties': False, 'required': ['kind', 'reason'],\n    34\t                'properties': {'kind': {'type': 'string', 'enum': ['excluded']}, 'reason': {'type': 'string'}}}\n    35\t    ids = list(dict.fromkeys(entry['view_id'] for entry in selected))\n    36\t    return {'type': 'object', 'additionalProperties': False, 'required': ['summary', 'composite'],\n    37\t            'properties': {'summary': {'type': 'string'},\n    38\t                           'composite': {'type': 'object', 'additionalProperties': False, 'required': ids,\n    39\t                                         'properties': {ident: {'anyOf': [driver, excluded]} for ident in ids}}}}\n    40\t\n    41\t\n    42\tdef bind_dispositions(answer, selected, records, as_of):\n    43\t    errors = model.check_schema(answer, disposition_schema(selected))\n    44\t    if errors:\n    45\t        raise model.SchemaError('; '.join(errors))\n    46\t    plan = {'drivers': [], 'excluded': []}\n    47\t    for ident, entry in answer['composite'].items():\n    48\t        key = 'drivers' if entry['kind'] == 'driver' else 'excluded'\n    49\t        plan[key].append({'thesis_id': ident, **{name: value for name, value in entry.items() if name != 'kind'}})\n    50\t    return bind(plan, selected, records, as_of)\n    51\t\n    52\t\n    53\tdef disposition_prose(answer):\n    54\t    return [answer['summary'], *([answer['outcome']] if 'outcome' in answer else []), *(value for entry in answer['composite'].values()\n    55\t                                 for name, value in entry.items() if name in ('label', 'reason', 'weight_reason'))]\n    56\t\n    57\t\n    58\tdef outcome_schema(selected):\n    59\t    schema = disposition_schema(selected)\n    60\t    schema['required'] += ['outcome', 'claim_direction']\n    61\t    schema['properties']['outcome'] = {'type': 'string'}\n    62\t    schema['properties']['claim_direction'] = {'type': 'string', 'enum': ['higher', 'lower', 'unclear']}\n    63\t    for choice in schema['properties']['composite']['properties'].values():\n    64\t        driver = choice['anyOf'][0]\n    65\t        driver['required'] = ['raises_outcome_end' if key == 'supporting_end' else key for key in driver['required']]\n    66\t        driver['properties']['raises_outcome_end'] = driver['properties'].pop('supporting_end', {'type': 'string', 'enum': ['first', 'last']})\n    67\t    return schema\n    68\t\n    69\t\n    70\tdef bind_outcome(answer, selected, records, as_of):\n    71\t    errors = model.check_schema(answer, outcome_schema(selected))\n    72\t    if errors:\n    73\t        raise model.SchemaError('; '.join(errors))\n    74\t    if not answer['outcome'].strip():\n    75\t        raise model.SchemaError('composite: the assessed outcome must be named')\n    76\t    dispositions = {}\n    77\t    for ident, entry in answer['composite'].items():\n    78\t        value = dict(entry)\n    79\t        if entry['kind'] == 'driver':\n    80\t            if answer['claim_direction'] == 'unclear':\n    81\t                raise model.SchemaError('composite: an unclear claim cannot have scored drivers')\n    82\t            end = value.pop('raises_outcome_end')\n    83\t            value['supporting_end'] = end if answer['claim_direction'] == 'higher' else ('last' if end == 'first' else 'first')\n    84\t        dispositions[ident] = value\n    85\t    plan = bind_dispositions({'summary': answer['summary'], 'composite': dispositions}, selected, records, as_of)\n    86\t    plan['target'] = {'outcome': answer['outcome'], 'direction': answer['claim_direction']}\n    87\t    return plan\n    88\t\n    89\t\n    90\tdef endpoint_schema(theses):\n    91\t    schema = outcome_schema([{'view_id': thesis['view_id']} for thesis in theses])\n    92\t    properties = schema['properties']['composite']['properties']\n    93\t    for thesis in theses:\n    94\t        choice = copy.deepcopy(properties[thesis['view_id']])\n    95\t        driver = choice['anyOf'][0]\n    96\t        driver['required'] = ['raises_outcome_position' if key == 'raises_outcome_end' else key for key in driver['required']]\n    97\t        del driver['properties']['raises_outcome_end']\n    98\t        driver['properties']['raises_outcome_position'] = {'type': 'string', 'enum': [str(r['position']) for r in thesis['ladder']]}\n    99\t        properties[thesis['view_id']] = choice\n   100\t    return schema\n   101\t\n   102\t\n   103\tdef bind_endpoints(answer, selected, records, as_of, theses):\n   104\t    errors = model.check_schema(answer, endpoint_schema(theses))\n   105\t    if errors:\n   106\t        raise model.SchemaError('; '.join(errors))\n   107\t    first = {t['view_id']: str(t['ladder'][0]['position']) for t in theses}\n   108\t    converted = copy.deepcopy(answer)\n   109\t    for ident, entry in converted['composite'].items():\n   110\t        if entry['kind'] == 'driver':\n   111\t            position = entry.pop('raises_outcome_position')\n   112\t            entry['raises_outcome_end'] = 'first' if position == first[ident] else 'last'\n   113\t    return bind_outcome(converted, selected, records, as_of)\n   114\t\n   115\t\n   116\tdef weighted_schema(theses):\n   117\t    schema = endpoint_schema(theses)\n   118\t    for choice in schema['properties']['composite']['properties'].values():\n   119\t        driver, excluded = choice['anyOf']\n   120\t        driver['required'] += ['weight_percent', 'weight_reason']\n   121\t        driver['properties'].update(weight_percent={'type': 'integer', 'minimum': 1, 'maximum': 100},\n   122\t                                    weight_reason={'type': 'string'})\n   123\t        excluded['required'].append('weight_percent')\n   124\t        excluded['properties']['weight_percent'] = {'type': 'integer', 'enum': [0]}\n   125\t    return schema\n   126\t\n   127\t\n   128\tdef bind_weighted(answer, selected, records, as_of, theses):\n   129\t    \"\"\"Bind explicit impact percentages without normalizing or changing the selected identities.\"\"\"\n   130\t    errors = model.check_schema(answer, weighted_schema(theses))\n   131\t    if errors:\n   132\t        raise model.SchemaError('; '.join(errors))\n   133\t    total = 0\n   134\t    drivers = 0\n   135\t    stripped = copy.deepcopy(answer)\n   136\t    for ident, entry in answer['composite'].items():\n   137\t        weight = entry['weight_percent']\n   138\t        if entry['kind'] == 'driver':\n   139\t            if not 1 <= weight <= 100 or not entry['weight_reason'].strip():\n   140\t                raise model.SchemaError(f'composite {ident}: a driver needs 1–100 impact percent and a reason')\n   141\t            total += weight\n   142\t            drivers += 1\n   143\t            del stripped['composite'][ident]['weight_reason']\n   144\t        elif weight != 0:\n   145\t            raise model.SchemaError(f'composite {ident}: an excluded thesis must have zero weight')\n   146\t        del stripped['composite'][ident]['weight_percent']\n   147\t    if total != (100 if drivers else 0):\n   148\t        raise model.SchemaError(f'composite: impact weights must sum to 100, got {total}')\n   149\t    plan = bind_endpoints(stripped, selected, records, as_of, theses)\n   150\t    for entry in plan['drivers'] + plan['excluded']:\n   151\t        original = answer['composite'][entry['thesis_id']]\n   152\t        entry['weight_percent'] = original['weight_percent']\n   153\t        if 'weight_reason' in original:\n   154\t            entry['weight_reason'] = original['weight_reason']\n   155\t    plan.update(version='idea-composite/3', method='weighted')\n   156\t    return plan\n   157\t\n   158\t\n   159\tdef positive_schema(theses):\n   160\t    ids = [t['view_id'] for t in theses]\n   161\t    properties = {\n   162\t        'thesis_id': {'type': 'string', **({'enum': ids} if ids else {})},\n   163\t        'label': {'type': 'string'},\n   164\t        'raises_outcome_position': {'type': 'string', 'enum': ['1', '2', '3', '4', '5']},\n   165\t        'reason': {'type': 'string'},\n   166\t        'weight_percent': {'type': 'integer', 'minimum': 1, 'maximum': 100},\n   167\t        'weight_reason': {'type': 'string'},\n   168\t    }\n   169\t    return {'type': 'object', 'additionalProperties': False,\n   170\t            'required': ['summary', 'outcome', 'claim_direction', 'composite'],\n   171\t            'properties': {'summary': {'type': 'string'}, 'outcome': {'type': 'string'},\n   172\t                           'claim_direction': {'type': 'string', 'enum': ['higher', 'lower', 'unclear']},\n   173\t                           'composite': {'type': 'array', 'items': {'type': 'object', 'additionalProperties': False,\n   174\t                                         'required': list(properties), 'properties': properties}}}}\n   175\t\n   176\t\n   177\tdef bind_positive(answer, selected, records, as_of, theses):\n   178\t    \"\"\"Only positively weighted model choices become Idea associations.\"\"\"\n   179\t    errors = model.check_schema(answer, positive_schema(theses))\n   180\t    if errors:\n   181\t        raise model.SchemaError('; '.join(errors))\n   182\t    allowed = {s['view_id'] for s in selected}\n   183\t    dispositions = {}\n   184\t    for entry in answer['composite']:\n   185\t        ident = entry['thesis_id']\n   186\t        if ident not in allowed or ident in dispositions:\n   187\t            raise model.SchemaError(f'composite {ident}: must be a unique supplied candidate')\n   188\t        dispositions[ident] = {'kind': 'driver', **{k: v for k, v in entry.items() if k != 'thesis_id'}}\n   189\t    converted = {**answer, 'composite': dispositions}\n   190\t    adopted = [s for s in selected if s['view_id'] in dispositions]\n   191\t    plan = bind_weighted(converted, adopted, records, as_of, [t for t in theses if t['view_id'] in dispositions])\n   192\t    del plan['excluded']\n   193\t    plan['version'] = 'idea-composite/4'\n   194\t    return plan\n   195\t\n   196\t\n   197\tdef positive_prose(answer):\n   198\t    return [answer['summary'], answer['outcome'], *(entry[key] for entry in answer['composite']\n   199\t             for key in ('label', 'reason', 'weight_reason'))]\n   200\t\n   201\t\n   202\tdef adoption_schema(theses):\n   203\t    \"\"\"The positive-selection answer with one item shape per candidate: each pins its thesis_id and offers only that\n   204\t    thesis's own endpoint positions, so the request cannot ask for an endpoint the binder refuses.\"\"\"\n   205\t    def item(thesis_id=None, positions=('1', '2', '3', '4', '5')):\n   206\t        return {'type': 'object', 'additionalProperties': False,\n   207\t                'required': ['thesis_id', 'label', 'raises_outcome_position', 'reason', 'weight_percent', 'weight_reason'],\n   208\t                'properties': {'thesis_id': {'type': 'string', **({'enum': [thesis_id]} if thesis_id else {})},\n   209\t                               'label': {'type': 'string'},\n   210\t                               'raises_outcome_position': {'type': 'string', 'enum': list(positions)},\n   211\t                               'reason': {'type': 'string'},\n   212\t                               'weight_percent': {'type': 'integer', 'minimum': 1, 'maximum': 100},\n   213\t                               'weight_reason': {'type': 'string'}}}\n   214\t    choices = [item(t['view_id'], [str(rung['position']) for rung in t['ladder']]) for t in theses]\n   215\t    return {'type': 'object', 'additionalProperties': False,\n   216\t            'required': ['summary', 'outcome', 'claim_direction', 'composite'],\n   217\t            'properties': {'summary': {'type': 'string'}, 'outcome': {'type': 'string'},\n   218\t                           'claim_direction': {'type': 'string', 'enum': ['higher', 'lower', 'unclear']},\n   219\t                           'composite': {'type': 'array', 'items': {'anyOf': choices} if choices else item()}}}\n   220\t\n   221\t\n   222\tdef bind_adoption(answer, selected, records, as_of, theses, schema):\n   223\t    \"\"\"Bind an answer checked against the exact schema that was sent; code checks only what a schema cannot say.\"\"\"\n   224\t    errors = model.check_schema(answer, schema)\n   225\t    if errors:\n   226\t        raise model.SchemaError('; '.join(errors))\n   227\t    if not answer['outcome'].strip():\n   228\t        raise model.SchemaError('composite: the assessed outcome must be named')\n   229\t    if answer['composite'] and answer['claim_direction'] == 'unclear':\n   230\t        raise model.SchemaError('composite: an unclear claim cannot have scored drivers')\n   231\t    first = {t['view_id']: str(t['ladder'][0]['position']) for t in theses}\n   232\t    allowed = {s['view_id'] for s in selected} & set(first)\n   233\t    drivers, seen, total = [], set(), 0\n   234\t    for entry in answer['composite']:\n   235\t        ident = entry['thesis_id']\n   236\t        if ident not in allowed or ident in seen:\n   237\t            raise model.SchemaError(f'composite {ident}: must be a unique supplied candidate')\n   238\t        if not all(entry[key].strip() for key in ('label', 'reason', 'weight_reason')):\n   239\t            raise model.SchemaError(f'composite {ident}: label, reason and weight reason must be nonempty')\n   240\t        seen.add(ident)\n   241\t        total += entry['weight_percent']\n   242\t        raises = 'first' if entry['raises_outcome_position'] == first[ident] else 'last'\n   243\t        supporting = raises if answer['claim_direction'] == 'higher' else ('last' if raises == 'first' else 'first')\n   244\t        drivers.append({'thesis_id': ident, 'label': entry['label'], 'reason': entry['reason'], 'supporting_end': supporting,\n   245\t                        'question': records[ident]['question'], 'weight_percent': entry['weight_percent'],\n   246\t                        'weight_reason': entry['weight_reason']})\n   247\t    if total != (100 if drivers else 0):\n   248\t        raise model.SchemaError(f'composite: impact weights must sum to 100, got {total}')\n   249\t    return {'version': 'idea-composite/4', 'method': 'weighted', 'as_of': as_of, 'drivers': drivers,\n   250\t            'target': {'outcome': answer['outcome'], 'direction': answer['claim_direction']}}\n   251\t\n   252\t\n   253\tdef contract(prompt_version, selected, ledger=None):\n   254\t    \"\"\"The schema, prose fields and binder belonging to each versioned composite prompt.\"\"\"\n   255\t    if prompt_version == 'idea-summary-v8':\n   256\t        theses = add_ladders(ledger, [{'view_id': entry['view_id']} for entry in selected], endpoints_only=True)\n   257\t        schema = adoption_schema(theses)\n   258\t        return schema, positive_prose, lambda answer, *args: bind_adoption(answer, *args, theses, schema)\n   259\t    if prompt_version == 'idea-summary-v7':\n   260\t        theses = add_ladders(ledger, [{'view_id': entry['view_id']} for entry in selected], endpoints_only=True)\n   261\t        return positive_schema(theses), positive_prose, lambda answer, *args: bind_positive(answer, *args, theses)\n   262\t    if prompt_version == 'idea-summary-v6':\n   263\t        theses = add_ladders(ledger, [{'view_id': entry['view_id']} for entry in selected], endpoints_only=True)\n   264\t        return weighted_schema(theses), disposition_prose, lambda answer, *args: bind_weighted(answer, *args, theses)\n   265\t    if prompt_version == 'idea-summary-v5':\n   266\t        theses = add_ladders(ledger, [{'view_id': entry['view_id']} for entry in selected], endpoints_only=True)\n   267\t        return endpoint_schema(theses), disposition_prose, lambda answer, *args: bind_endpoints(answer, *args, theses)\n   268\t    if prompt_version == 'idea-summary-v4':\n   269\t        return outcome_schema(selected), disposition_prose, bind_outcome\n   270\t    if prompt_version == 'idea-summary-v3':\n   271\t        return disposition_schema(selected), disposition_prose, bind_dispositions\n   272\t    if prompt_version == 'idea-summary-v2':\n   273\t        return SCHEMA, prose, lambda answer, *args: bind(answer['composite'], *args)\n   274\t    return None\n   275\t\n   276\t\n   277\tdef add_ladders(ledger, theses, endpoints_only=False):\n   278\t    \"\"\"Supply the immutable ordered outcomes, without copying evidence or guessing UI score orientation.\"\"\"\n   279\t    result = []\n   280\t    for thesis in theses:\n   281\t        rungs = store.rungs_of(ledger, thesis['view_id'])\n   282\t        if endpoints_only:\n   283\t            rungs = [rungs[0], rungs[-1]]\n   284\t        result.append({**thesis, 'ladder': [{key: rung[key] for key in ('position', 'label', 'condition')} for rung in rungs]})\n   285\t    return result\n   286\t\n   287\t\n   288\tdef prose(answer):\n   289\t    return [answer['summary'], *(value for driver in answer['composite']['drivers'] for value in (driver['label'], driver['reason'])),\n   290\t            *(entry['reason'] for entry in answer['composite']['excluded'])]\npoc/ui/src/idea/composite.js:188:export function prepareCompositeTrial(trials, card, dataset) {\nscripts/mock_build.py:24:    parser.add_argument('--composite-trials', type=Path, help='explicit JSON trial baskets for the Idea score preview')\npoc/ui/README.md:92:python3 scripts/mock_build.py --composite-trials poc/config/idea-composite-trial-2026-10-26.json\npoc/ui/README.md:95:The default build omits trial baskets. Only the exact configured Idea and date receive this trial chart. `prepareCompositeTrial` checks representative identity and connections; `compositeAt` reads a dated point; `scoreHistoryChart` renders fractional values with the shared chart style. The trial does not modify the canonical thesis schema or write an Idea score into the ledger.\npoc/ui/src/bootstrap.js:8:  prepareCompositeTrial,\npoc/ui/src/bootstrap.js:29:      document.getElementById('composite-trials')?.textContent || '[]',\npoc/ui/src/bootstrap.js:209:            (next ? prepareCompositeTrial(compositeTrials, card, next) : null);\npoc/ui/src/index.js:25:  prepareCompositeTrial,\npoc/ui/test/mutations.mjs:188:    `import assert from 'node:assert/strict';import {prepareCompositeTrial,compositeAt} from './src/idea/composite.js';const trial=prepareCompositeTrial(${JSON.stringify(plans)},${JSON.stringify(card)},${JSON.stringify(currentData)});assert.equal(compositeAt(trial,'2026-07-29').value,0.5);`,\npoc/ui/test/not-judged.test.js:154:import { prepareCompositeTrial } from '../src/idea/composite.js';\npoc/ui/test/not-judged.test.js:215:    () => prepareCompositeTrial(trials, card, data),\npoc/ui/test/composite.test.js:8:  prepareCompositeTrial,\npoc/ui/test/composite.test.js:319:  const trial = prepareCompositeTrial(plans, card, data);\npoc/ui/test/composite.test.js:329:  assert.equal(compositeAt(prepareCompositeTrial(plans, card, future), '2026-08-15').value, 0);\npoc/ui/test/composite.test.js:334:  assert.equal(compositeAt(prepareCompositeTrial(inverted, card, data), '2026-07-29').value, -0.5);\npoc/ui/test/composite.test.js:340:  let point = compositeAt(prepareCompositeTrial(plans, card, missing), '2026-08-15');\npoc/ui/test/composite.test.js:344:  point = compositeAt(prepareCompositeTrial(plans, card, missing), '2026-08-15');\npoc/ui/test/composite.test.js:349:  assert.equal(compositeAt(prepareCompositeTrial(plans, repeated, data), '2026-07-29').value, 0.5);\npoc/ui/test/composite.test.js:354:    prepareCompositeTrial(plans, { ...card, reading: { ...card.reading, chosen: [] } }, data),\npoc/ui/test/composite.test.js:358:    prepareCompositeTrial(\npoc/ui/test/composite.test.js:379:    assert.throws(() => prepareCompositeTrial(changed, card, data), TypeError);\npoc/ui/test/composite.test.js:384:  const trial = prepareCompositeTrial(plans, card, data);\n","exit_code":0,"status":"completed"}}
