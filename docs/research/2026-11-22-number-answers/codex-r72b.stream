{"type":"item.completed","item":{"id":"item_19","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba scripts/mock_data.py | head -125; rg -n 'localStorage|sessionStorage|indexedDB|fixture|fallback|compositeTrial' poc/ui/src; rg -n 'cited_views_json|pushes_json' src/hivemind | head -90\"","aggregated_output":"     1\t\"\"\"Pull the data a front-end mock needs from a sealed views database: every view of the chosen objects with its\n     2\tladder, its judgement history (rung per round with the model's reason and the evidence it cited), the evidence in\n     3\tforce with tiers, speakers and sources, dependencies, replacements and the freeze switches. Writes one JSON file.\n     4\tThe shaping is src/hivemind/bundle.py, the same one POST /ideas answers with. Read-only on every database; nothing\n     5\tis sent to a model.\n     6\t\n     7\tUsage: python3 scripts/mock_data.py --out poc/mock/data.json [--objects NVDA ai-capex]\n     8\t\"\"\"\n     9\timport argparse\n    10\timport json\n    11\timport os\n    12\timport sys\n    13\t\n    14\tROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))\n    15\tsys.path.insert(0, os.path.join(ROOT, 'src'))\n    16\tfrom hivemind import bundle  # noqa: E402\n    17\tfrom hivemind.views import store  # noqa: E402\n    18\t\n    19\t\n    20\tdef main():\n    21\t    parser = argparse.ArgumentParser()\n    22\t    parser.add_argument('--views', default=os.path.join(ROOT, 'poc', 'data', 'sealed-2026-10-24-run3-through-0815', 'views.sqlite'))\n    23\t    parser.add_argument('--items', default=os.path.join(ROOT, 'poc', 'data', 'items-window.sqlite'))\n    24\t    parser.add_argument('--objects', nargs='*', default=['NVDA', 'ai-capex'])\n    25\t    parser.add_argument('--out', default=os.path.join(ROOT, 'poc', 'mock', 'data.json'))\n    26\t    args = parser.parse_args()\n    27\t    views_db, items_db = store.open_read_only(args.views), store.open_read_only(args.items)\n    28\t    marks = ','.join('?' * len(args.objects))\n    29\t    ids = [r[0] for r in views_db.execute(f'select view_id from views where object_id in ({marks}) order by created_seq', args.objects)]\n    30\t    item_of = bundle.item_lookup(items_db)\n    31\t    out = {'objects': args.objects, 'views': [bundle.view_bundle(views_db, item_of, view_id) for view_id in ids], 'days': bundle.days(views_db)}\n    32\t    with open(args.out, 'w', encoding='utf-8') as handle:\n    33\t        json.dump(out, handle, ensure_ascii=False, indent=0)\n    34\t    print(f'{len(out[\"views\"])} views, {sum(len(v[\"judgements\"]) for v in out[\"views\"])} judgements, {sum(len(v[\"evidence\"]) for v in out[\"views\"])} evidence links → {args.out} ({os.path.getsize(args.out) // 1024} KB)')\n    35\t\n    36\t\n    37\tif __name__ == '__main__':\n    38\t    main()\npoc/ui/src/bootstrap.js:28:    const compositeTrials = JSON.parse(\npoc/ui/src/bootstrap.js:209:            (next ? prepareCompositeTrial(compositeTrials, card, next) : null);\nsrc/hivemind/views/judging.py:309:                                reasons=data['reasons'], cited_evidence_json=json.dumps(data['cites']), cited_views_json=json.dumps(data['cites_views']),\nsrc/hivemind/views/judging.py:310:                                pushes_json=json.dumps(data['pushes'], ensure_ascii=False), changed=1 if data['changed'] else 0,\nsrc/hivemind/views/judging.py:311:                                theme_pushes_json=json.dumps(data.get('theme_pushes', []), ensure_ascii=False),\nsrc/hivemind/views/store.py:18:    'judgements': 'judgement_id integer primary key autoincrement, view_id text, seq integer, input_id text, rung integer, reasons text, cited_evidence_json text, cited_views_json text, pushes_json text, changed integer, why_changed text, config_checksum text, call_id integer, request_sha256 text, publication_day text, theme_pushes_json text, reference text, implied_outcome text',\nsrc/hivemind/views/store.py:150:    if 'theme_pushes_json' not in judgement_columns:\nsrc/hivemind/views/store.py:151:        conn.execute('alter table judgements add column theme_pushes_json text')     # D195: judgements written before the theme block read as []\nsrc/hivemind/bundle.py:122:                           'cited_views': json.loads(j['cited_views_json'] or '[]'), 'pushes': json.loads(j['pushes_json'] or '[]'),\nsrc/hivemind/service.py:142:            'rounds': len(rows), 'why_changed': last['why_changed'], 'reasons': last['reasons'], 'theme_pushes': _json(last.get('theme_pushes_json'))}\nsrc/hivemind/service.py:264:                 'why_changed': row['why_changed'], 'reasons': row['reasons'], 'cited': _unique(_json(row['cited_evidence_json'])), 'pushes': _json(row['pushes_json']),\nsrc/hivemind/service.py:265:                 'theme_pushes': _json(row['theme_pushes_json'] if 'theme_pushes_json' in row.keys() else None), 'round': row['input_id']}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_20","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba src/hivemind/extraction.py | sed -n '465,528p'; nl -ba src/hivemind/views/identity.py | head -74; rg -n -F \\\"'是'\\\" poc/ui/src src/hivemind | head -50; nl -ba docker-compose.yml | head -100; nl -ba Dockerfile; ls -a web\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_20","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba src/hivemind/extraction.py | sed -n '465,528p'; nl -ba src/hivemind/views/identity.py | head -74; rg -n -F \\\"'是'\\\" poc/ui/src src/hivemind | head -50; nl -ba docker-compose.yml | head -100; nl -ba Dockerfile; ls -a web\"","aggregated_output":"   465\t    return Reading(evidence, candidates, dropped, new_groups, answer, setting.prompt_version.rpartition('-')[2])\n   466\t\n   467\t\n   468\tdef file_reading(reading, item, shown_views):\n   469\t    \"\"\"The handover: the extraction's own links are the filing (D256). A statement linked to a question and to a question that\n   470\t    question depends on keeps the narrower one (D207); a statement no open question and no kept candidate takes is dropped as 'no\n   471\t    home' (D209), like every other drop: a candidate left with none of its evidence is dropped too, and a statement whose only link was\n   472\t    such a candidate has no home.\"\"\"\n   473\t    candidates, dropped, answer = reading.candidates, list(reading.dropped), reading.answer\n   474\t    parents = {v['view_id']: v.get('parents') or [] for v in shown_views}\n   475\t    evidence = [dict(e, links=narrowest_links(e['links'], parents)) for e in reading.evidence]\n   476\t    while True:\n   477\t        candidates = candidates_with_evidence(candidates, {e['id'] for e in evidence}, item, dropped)\n   478\t        candidate_ids = {c['id'] for c in candidates}\n   479\t        evidence = [dict(e, links=[l for l in e['links'] if not placement.CANDIDATE_ID.match(l) or l in candidate_ids]) for e in evidence]\n   480\t        homeless = [e for e in evidence if not e['links']]\n   481\t        if not homeless:\n   482\t            break\n   483\t        dropped.extend((e['id'], 'no home') for e in homeless)\n   484\t        evidence = [e for e in evidence if e['links']]\n   485\t    return Handover(evidence, candidates, dropped, answer.call_id, answer.request_sha256, answer.cached, answer.cost_usd, reading.new_groups)\n   486\t\n   487\t\n   488\tdef extract(archive, cfg, item, text, shown_views, universe, *, transport=None):\n   489\t    \"\"\"One item through extraction: read, then file under the questions shown.\"\"\"\n   490\t    return file_reading(read_item(archive, cfg, item, text, shown_views, universe, transport=transport), item, shown_views)\n   491\t\n   492\t\n   493\tdef check_bounds(rungs):\n   494\t    \"\"\"None when the rungs' numeric bounds form one unbroken partition (or none carries bounds), else the problem.\"\"\"\n   495\t    bounded = [r for r in rungs if r.get('lo') is not None or r.get('hi') is not None]\n   496\t    if not bounded:\n   497\t        return None\n   498\t    if len(bounded) != len(rungs):\n   499\t        return 'some rungs carry bounds and some do not'\n   500\t    ordered = sorted(rungs, key=lambda r: -1e300 if r.get('lo') is None else float(r['lo']))\n   501\t    for a, b in zip(ordered, ordered[1:]):\n   502\t        if a.get('hi') is None or b.get('lo') is None or float(a['hi']) != float(b['lo']):\n   503\t            return 'rung bounds overlap or leave a gap'\n   504\t    if ordered[-1].get('hi') is not None:\n   505\t        return 'the top rung must be open above'\n   506\t    return None\n   507\t\n   508\t\n   509\tdef check_group_refs(c, declared):\n   510\t    \"\"\"None when a candidate's research-group references are well formed: no repeats, each a declared local id; empty is allowed\n   511\t    (a company's own financial line belongs to the company, not to a group); else the problem.\"\"\"\n   512\t    refs = c.get('group_refs')\n   513\t    if refs is None:\n   514\t        return None\n   515\t    if len(refs) != len(set(refs)):\n   516\t        return 'group_refs repeats a group'\n   517\t    unknown = [r for r in refs if r not in declared]\n   518\t    if unknown:\n   519\t        return f'group_refs cites a group not declared in this answer: {unknown}'\n   520\t    return None\n   521\t\n   522\t\n   523\tdef check_admission(c, publication_day):\n   524\t    \"\"\"None when a candidate's admission fields are well formed (D184/D185), else the problem: settled_by is not blank, and a binding\n   525\t    obligation is due within 18 months.\"\"\"\n   526\t    if not str(c.get('settled_by', '')).strip():\n   527\t        return 'settled_by is empty'\n   528\t    if c['opens_as'] == 'binding_obligation':\n     1\t\"\"\"D155: exact identity and same-answer coalescing, shared by matching and writing.\n     2\t\n     3\tD197: a shared quantity (a candidate admitted as industry_aggregate / shared_quantity, a key stored with scope_source\n     4\t'shared') is one thesis per theme, measure and period; its scope (the population or wording of the aggregate) is not\n     5\tpart of its identity.\"\"\"\n     6\tfrom ..universe import scope_key\n     7\t\n     8\tKEY_VERSION = 2\n     9\tSHARED_REASONS = ('industry_aggregate', 'shared_quantity')\n    10\tEVENT_MEASURES = ('event', 'policy_event')\n    11\t\n    12\t\n    13\tdef is_shared(value):\n    14\t    \"\"\"A shared quantity: by its admission reason on a candidate, by its stored scope source on a key.\"\"\"\n    15\t    return value.get('measure') not in (None, 'other', *EVENT_MEASURES) and (value.get('scope_source') == 'shared' or value.get('opens_as') in SHARED_REASONS)\n    16\t\n    17\t\n    18\tdef automatic_key(value, object_id=None):\n    19\t    \"\"\"Return a complete, code-owned key, or None when identity still needs judgement.\"\"\"\n    20\t    if value.get('key_version') != KEY_VERSION:\n    21\t        return None\n    22\t    if value.get('measure') in (None, 'other'):\n    23\t        return None\n    24\t    if is_shared(value):\n    25\t        return (object_id or value.get('object'), value['measure'], '', value.get('period_start'), value.get('period_end'),\n    26\t                value.get('basis'), value.get('unit'), value.get('event_type'))\n    27\t    if value.get('scope_source') not in ('none', 'watch'):\n    28\t        return None\n    29\t    if value['measure'] in EVENT_MEASURES and value.get('event_type') in (None, 'other', 'n/a'):\n    30\t        return None\n    31\t    return (object_id or value.get('object'), value['measure'], scope_key(value.get('scope', '')),\n    32\t            value.get('period_start'), value.get('period_end'), value.get('basis'), value.get('unit'), value.get('event_type'))\n    33\t\n    34\t\n    35\tGENERATION_MILESTONES = ('launch', 'shipment')\n    36\t\n    37\t\n    38\tdef same_generation_milestones(key, candidate):\n    39\t    \"\"\"D248 item 3: a product generation's launch and its shipments are milestones of one question, asked at the step that brings\n    40\t    revenue; the judge of sameness (Jev) says whether they are the same generation, this only lifts the event-type conflict.\"\"\"\n    41\t    return key.get('measure') == 'event' and key.get('event_type') in GENERATION_MILESTONES and candidate.get('event_type') in GENERATION_MILESTONES\n    42\t\n    43\t\n    44\tdef one_process(key, candidate):\n    45\t    \"\"\"D258 (R2-f): a policy process's steps are one process; the model's event-type word for it (licence, approval, other) is not\n    46\t    identity. One 14-day draw opened three questions on one licensing decision because that word varied.\"\"\"\n    47\t    return 'policy_event' in (key.get('measure'), candidate.get('measure'))\n    48\t\n    49\t\n    50\tdef conflicts(key, candidate, *, merging):\n    51\t    \"\"\"Known different quantities/events cannot merge; corrected scopes/periods bind only corrected keys. An event's period is its\n    52\t    deadline: another deadline never conflicts (D248 item 2: while the earlier-deadline question is open, a later deadline is its\n    53\t    evidence; a closed one is succeeded by `can_succeed`, which compares the periods itself). `event` and `policy_event` are one\n    54\t    measure family (D258, R2-f): the model typed one licensing decision both ways, and the names and the judge of sameness decide.\"\"\"\n    55\t    if key['measure'] != candidate['measure'] and not (key['measure'] in EVENT_MEASURES and candidate['measure'] in EVENT_MEASURES):\n    56\t        return True\n    57\t    if (key['event_type'] != candidate.get('event_type', 'n/a') and not same_generation_milestones(key, candidate)\n    58\t            and not one_process(key, candidate)):\n    59\t        return True\n    60\t    for field in ('basis', 'unit'):\n    61\t        a, b = key[field], candidate.get(field, 'n/a')\n    62\t        if a != 'n/a' and b != 'n/a' and a != b:\n    63\t            return True\n    64\t    if key.get('key_version') != KEY_VERSION or candidate.get('key_version') != KEY_VERSION:\n    65\t        return False\n    66\t    if (key.get('scope_source') in ('none', 'watch') and candidate.get('scope_source') in ('none', 'watch')\n    67\t            and scope_key(key['scope']) != scope_key(candidate.get('scope', ''))):\n    68\t        return True\n    69\t    if key['measure'] in EVENT_MEASURES:\n    70\t        return False\n    71\t    return merging and (key['period_start'], key['period_end']) != (candidate.get('period_start'), candidate.get('period_end'))\n    72\t\n    73\t\n    74\tdef batch_plan(candidates, outcomes):\nsrc/hivemind/vocabulary.py:24:    'label': {'强烈看多': 'Strongly bullish', '看多': 'Bullish', '中性': 'Neutral', '看空': 'Bearish', '强烈看空': 'Strongly bearish', '是': 'Yes', '否': 'No'},\n     1\t# docker compose up --build\n     2\t# api: http://127.0.0.1:8788 (GET routes + POST /ideas); mcp: http://127.0.0.1:8789/mcp (streamable HTTP).\n     3\t# Both ports bind to the host's loopback only. The ledger and the items database are mounted read-only; the\n     4\t# service folder holds the search index and the idea archive; the credentials file is mounted read-only into the\n     5\t# path src/hivemind/model.py reads (never copied into the image, never in this file).\n     6\tservices:\n     7\t  api:\n     8\t    build: .\n     9\t    command: [\"python3\", \"scripts/hivemind_api.py\", \"--host\", \"0.0.0.0\", \"--port\", \"8788\",\n    10\t              \"--views\", \"/data/ledger/views.sqlite\", \"--items\", \"/data/items/items-window.sqlite\",\n    11\t              \"--index\", \"/data/service/search-index.sqlite\", \"--archive\", \"/data/service/idea-archive.sqlite\",\n    12\t              \"--config\", \"poc/config/poc-v33-idea.json\"]\n    13\t    ports: [\"127.0.0.1:8788:8788\"]\n    14\t    volumes:\n    15\t      - ./poc/data/served-2026-10-28-v34-nvda-3m-through-0828:/data/ledger:ro\n    16\t      - ./poc/data/items-nvda-2026-07-01-10-27.sqlite:/data/items/items-window.sqlite:ro\n    17\t      - ./poc/data/service-english:/data/service\n    18\t      - ${HOME}/.config/hivemind/credentials.json:/root/.config/hivemind/credentials.json:ro\n    19\t    healthcheck:\n    20\t      test: [\"CMD\", \"python3\", \"-c\", \"import urllib.request; urllib.request.urlopen('http://127.0.0.1:8788/days', timeout=3)\"]\n    21\t      interval: 30s\n    22\t      timeout: 5s\n    23\t      retries: 3\n    24\t  mcp:\n    25\t    build:\n    26\t      context: .\n    27\t      dockerfile: Dockerfile.mcp\n    28\t    command: [\"python3\", \"scripts/hivemind_mcp.py\", \"--transport\", \"streamable-http\", \"--host\", \"0.0.0.0\", \"--port\", \"8789\",\n    29\t              \"--views\", \"/data/ledger/views.sqlite\", \"--items\", \"/data/items/items-window.sqlite\", \"--index\", \"/data/service/search-index.sqlite\"]\n    30\t    ports: [\"127.0.0.1:8789:8789\"]\n    31\t    volumes:\n    32\t      - ./poc/data/served-2026-10-28-v34-nvda-3m-through-0828:/data/ledger:ro\n    33\t      - ./poc/data/items-nvda-2026-07-01-10-27.sqlite:/data/items/items-window.sqlite:ro\n    34\t      - ./poc/data/service-english:/data/service\n    35\t      - ${HOME}/.config/hivemind/credentials.json:/root/.config/hivemind/credentials.json:ro\n     1\t# The Hivemind HTTP front (scripts/hivemind_api.py): standard library only, so the image needs no package index.\n     2\t# Data (the ledger, the items database, the index, the archive) and the credentials file are mounted at run time,\n     3\t# never copied into the image. The MCP front's image is Dockerfile.mcp (it adds the mcp package from local wheels).\n     4\tFROM python:3.12-slim\n     5\tWORKDIR /app\n     6\tCOPY src/ /app/src/\n     7\tCOPY scripts/hivemind_api.py scripts/hivemind_mcp.py /app/scripts/\n     8\tCOPY poc/universe.json /app/poc/universe.json\n     9\tCOPY poc/config/ /app/poc/config/\n    10\tENV PYTHONUNBUFFERED=1\n    11\tEXPOSE 8788\n    12\tCMD [\"python3\", \"scripts/hivemind_api.py\", \"--host\", \"0.0.0.0\", \"--port\", \"8788\"]\n.\n..\ndesign-system\nhivemind-logo.svg\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_21","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba scripts/hivemind_mcp.py | sed -n '48,218p'; nl -ba src/hivemind/idea_composite.py | sed -n '175,287p'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_21","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba scripts/hivemind_mcp.py | sed -n '48,218p'; nl -ba src/hivemind/idea_composite.py | sed -n '175,287p'\"","aggregated_output":"    48\t        if items is not None:\n    49\t            opened.append(items)\n    50\t        yield ledger, items, index\n    51\t    finally:\n    52\t        if opened and opened[0].in_transaction:\n    53\t            opened[0].rollback()\n    54\t        for conn in reversed(opened):\n    55\t            conn.close()\n    56\t\n    57\t\n    58\tdef start_objects():\n    59\t    \"\"\"The object list for the server's instructions, computed once at start and labelled with its day; every tool reads the current\n    60\t    last completed day. Start-up indexing embeds only views visible at the last completed day, and none on a first-day store (row 4a).\"\"\"\n    61\t    with connections() as (ledger, _items, index):\n    62\t        if not ARGS.lexical:\n    63\t            try:\n    64\t                embedded, _unchanged, _tokens, error = search_module.ensure_index(ledger, index)\n    65\t                if error:\n    66\t                    sys.stderr.write(f'hivemind: embedding stopped ({error}) after {embedded} views; search runs lexical until the rest is built\\n')\n    67\t            except service.FirstDayNotCompleted:\n    68\t                sys.stderr.write(\"hivemind: index not built, the store's first day has not completed; search is lexical until a restart\\n\")\n    69\t        try:\n    70\t            day = service.resolve_bound(ledger, None)\n    71\t        except service.FirstDayNotCompleted:\n    72\t            return \"No day of this ledger has completed yet; every tool refuses until one has.\"\n    73\t        return (f'Objects as of {day}, when this server started; every tool reads the current last completed day. '\n    74\t                + idea_module.object_list(ledger, day, ALIASES))\n    75\t\n    76\t\n    77\tOBJECTS = start_objects()\n    78\tmcp = FastMCP('hivemind', host=ARGS.host, port=ARGS.port, instructions=(\n    79\t    'Hivemind is a ledger of research views (a dated question with a five-step ladder, judged every day on evidence) '\n    80\t    'with a search engine on top. To read an idea against it: first break the idea into its parts, the one to four '\n    81\t    'questions whose answers decide it (each about one concrete quantity, date or event); search with the idea and with '\n    82\t    'each part (k=20); map each part to every view whose question answers it or whose outcome would move it, leaving out '\n    83\t    'views that only share a company or a word; then read each mapped view (state as of a day, history, evidence) and '\n    84\t    'say what the judged positions tell about each part and which parts no view covers. Say judged, never true. Every '\n    85\t    'tool takes as_of, a calendar day; the default is the ledger\\'s last completed day. Nothing here changes the ledger. '\n    86\t    'search matches each view\\'s own text (question, what it looks at, ladder conditions; Chinese, English queries work): '\n    87\t    'ask for one object and one quantity or event per query; views(object) lists everything under one object. '\n    88\t    + OBJECTS))\n    89\t\n    90\t\n    91\t@mcp.tool()\n    92\tdef thesis_library(as_of: str = '') -> dict:\n    93\t    \"\"\"All collected theses and their stored research groups, including ungrouped and closed theses.\n    94\t    Membership is not a dependency or a parent-child relationship. No model call or ledger write.\"\"\"\n    95\t    with connections() as (ledger, items, _index):\n    96\t        return bundle.library(ledger, items, as_of or None)\n    97\t\n    98\t\n    99\t@mcp.tool()\n   100\tdef thesis_bundles(view_ids: list[str], as_of: str = '') -> dict:\n   101\t    \"\"\"Complete UI inputs for selected thesis ids: dated states, assessments, sources, evidence and relationships.\n   102\t    Pass this envelope to the frontend's fromBundles adapter. Read-only; does not call a model.\"\"\"\n   103\t    with connections() as (ledger, items, _index):\n   104\t        return bundle.thesis_bundles(ledger, items, view_ids, as_of or None)\n   105\t\n   106\t\n   107\t@mcp.tool()\n   108\tdef search(query: str, k: int = 10, as_of: str = '', include_closed: bool = False) -> dict:\n   109\t    \"\"\"Top-k views for an idea or sentence: id, object, kind, what it looks at, the question, due day, dependencies\n   110\t    (the views it is judged after) and dependants, with the score and its parts. Views, never evidence: evidence is\n   111\t    anchored under its view.\"\"\"\n   112\t    with connections() as (ledger, _items, index):\n   113\t        return search_module.search(ledger, index, query, k, as_of or None, include_closed, aliases=ALIASES, semantic=not ARGS.lexical)\n   114\t\n   115\t\n   116\t@mcp.tool()\n   117\tdef views(object: str = '', as_of: str = '', include_closed: bool = False) -> list:\n   118\t    \"\"\"The views of one object (a ticker like NVDA or a theme id like ai-capex), or all views, as of a day.\"\"\"\n   119\t    with connections() as (ledger, _items, _index):\n   120\t        return service.views(ledger, object or None, as_of or None, include_closed)\n   121\t\n   122\t\n   123\t@mcp.tool()\n   124\tdef view(view_id: str, as_of: str = '') -> dict:\n   125\t    \"\"\"One view as of a day: the question, the ladder (positions 1..5, position 1 the most bullish outcome; or 2 for\n   126\t    yes/no), the judged position with its label and condition and since when, whether open, dependencies and\n   127\t    dependants, counts of rounds, evidence and facts.\"\"\"\n   128\t    with connections() as (ledger, _items, _index):\n   129\t        record = service.view(ledger, view_id, as_of or None)\n   130\t    if record is None:\n   131\t        raise ValueError(f'no view {view_id} as of {as_of or \"the last completed day\"}')\n   132\t    return record\n   133\t\n   134\t\n   135\t@mcp.tool()\n   136\tdef history(view_id: str, from_day: str = '', to_day: str = '') -> dict:\n   137\t    \"\"\"Every judgement round in the span (day, position, whether it changed, why, the cited evidence ids and the push\n   138\t    each gave), evidence arrivals per day, position changes, replacements of guidance, open/close switches.\"\"\"\n   139\t    with connections() as (ledger, _items, _index):\n   140\t        return service.history(ledger, view_id, from_day or None, to_day or None)\n   141\t\n   142\t\n   143\t@mcp.tool()\n   144\tdef evidence(view_id: str, as_of: str = '', tier: str = '') -> list:\n   145\t    \"\"\"Evidence in force under the view as of a day: one line, the source's own words, tier (发生的事 fact, 当事人说的\n   146\t    party statement, 第三方看法 third-party view, 传闻 rumour), speaker, when it arrived, its sources.\"\"\"\n   147\t    with connections() as (ledger, _items, _index):\n   148\t        return service.evidence(ledger, view_id, as_of or None, tier or None)\n   149\t\n   150\t\n   151\t@mcp.tool()\n   152\tdef record(view_id: str, as_of: str = '') -> dict:\n   153\t    \"\"\"The last check of the view on or before the day: when, by which round, how many items were processed that\n   154\t    day and how much evidence arrived under the view.\"\"\"\n   155\t    with connections() as (ledger, _items, _index):\n   156\t        return service.record(ledger, view_id, as_of or None)\n   157\t\n   158\t\n   159\t@mcp.tool()\n   160\tdef changes(since_day: str, to_day: str = '') -> list:\n   161\t    \"\"\"Judgements that said 'changed' after since_day, each with the view, from/to position and the evidence cited.\"\"\"\n   162\t    with connections() as (ledger, _items, _index):\n   163\t        return service.changes(ledger, since_day, to_day or None)\n   164\t\n   165\t\n   166\t@mcp.tool()\n   167\tdef evaluate(view_id: str, comparator: str, value_usd: float, as_of: str = '') -> dict:\n   168\t    \"\"\"A claim against a view's ladder: 'the quantity >= / < / = value_usd'. Returns the ladder position the\n   169\t    threshold sits in, the judged position, and the verdict: holds (the judged band is wholly on the claim's side),\n   170\t    not_yet (wholly on the other side) or borderline (the threshold cuts through the judged band).\"\"\"\n   171\t    with connections() as (ledger, _items, _index):\n   172\t        answer = service.evaluate(ledger, view_id, comparator, value_usd, as_of or None)\n   173\t    if answer is None:\n   174\t        raise ValueError(f'no view {view_id} as of {as_of or \"the last completed day\"}')\n   175\t    return answer\n   176\t\n   177\t\n   178\tif __name__ == '__main__':\n   179\t    mcp.run(transport=ARGS.transport)\n   175\t\n   176\t\n   177\tdef bind_positive(answer, selected, records, as_of, theses):\n   178\t    \"\"\"Only positively weighted model choices become Idea associations.\"\"\"\n   179\t    errors = model.check_schema(answer, positive_schema(theses))\n   180\t    if errors:\n   181\t        raise model.SchemaError('; '.join(errors))\n   182\t    allowed = {s['view_id'] for s in selected}\n   183\t    dispositions = {}\n   184\t    for entry in answer['composite']:\n   185\t        ident = entry['thesis_id']\n   186\t        if ident not in allowed or ident in dispositions:\n   187\t            raise model.SchemaError(f'composite {ident}: must be a unique supplied candidate')\n   188\t        dispositions[ident] = {'kind': 'driver', **{k: v for k, v in entry.items() if k != 'thesis_id'}}\n   189\t    converted = {**answer, 'composite': dispositions}\n   190\t    adopted = [s for s in selected if s['view_id'] in dispositions]\n   191\t    plan = bind_weighted(converted, adopted, records, as_of, [t for t in theses if t['view_id'] in dispositions])\n   192\t    del plan['excluded']\n   193\t    plan['version'] = 'idea-composite/4'\n   194\t    return plan\n   195\t\n   196\t\n   197\tdef positive_prose(answer):\n   198\t    return [answer['summary'], answer['outcome'], *(entry[key] for entry in answer['composite']\n   199\t             for key in ('label', 'reason', 'weight_reason'))]\n   200\t\n   201\t\n   202\tdef adoption_schema(theses):\n   203\t    \"\"\"The positive-selection answer with one item shape per candidate: each pins its thesis_id and offers only that\n   204\t    thesis's own endpoint positions, so the request cannot ask for an endpoint the binder refuses.\"\"\"\n   205\t    def item(thesis_id=None, positions=('1', '2', '3', '4', '5')):\n   206\t        return {'type': 'object', 'additionalProperties': False,\n   207\t                'required': ['thesis_id', 'label', 'raises_outcome_position', 'reason', 'weight_percent', 'weight_reason'],\n   208\t                'properties': {'thesis_id': {'type': 'string', **({'enum': [thesis_id]} if thesis_id else {})},\n   209\t                               'label': {'type': 'string'},\n   210\t                               'raises_outcome_position': {'type': 'string', 'enum': list(positions)},\n   211\t                               'reason': {'type': 'string'},\n   212\t                               'weight_percent': {'type': 'integer', 'minimum': 1, 'maximum': 100},\n   213\t                               'weight_reason': {'type': 'string'}}}\n   214\t    choices = [item(t['view_id'], [str(rung['position']) for rung in t['ladder']]) for t in theses]\n   215\t    return {'type': 'object', 'additionalProperties': False,\n   216\t            'required': ['summary', 'outcome', 'claim_direction', 'composite'],\n   217\t            'properties': {'summary': {'type': 'string'}, 'outcome': {'type': 'string'},\n   218\t                           'claim_direction': {'type': 'string', 'enum': ['higher', 'lower', 'unclear']},\n   219\t                           'composite': {'type': 'array', 'items': {'anyOf': choices} if choices else item()}}}\n   220\t\n   221\t\n   222\tdef bind_adoption(answer, selected, records, as_of, theses, schema):\n   223\t    \"\"\"Bind an answer checked against the exact schema that was sent; code checks only what a schema cannot say.\"\"\"\n   224\t    errors = model.check_schema(answer, schema)\n   225\t    if errors:\n   226\t        raise model.SchemaError('; '.join(errors))\n   227\t    if not answer['outcome'].strip():\n   228\t        raise model.SchemaError('composite: the assessed outcome must be named')\n   229\t    if answer['composite'] and answer['claim_direction'] == 'unclear':\n   230\t        raise model.SchemaError('composite: an unclear claim cannot have scored drivers')\n   231\t    first = {t['view_id']: str(t['ladder'][0]['position']) for t in theses}\n   232\t    allowed = {s['view_id'] for s in selected} & set(first)\n   233\t    drivers, seen, total = [], set(), 0\n   234\t    for entry in answer['composite']:\n   235\t        ident = entry['thesis_id']\n   236\t        if ident not in allowed or ident in seen:\n   237\t            raise model.SchemaError(f'composite {ident}: must be a unique supplied candidate')\n   238\t        if not all(entry[key].strip() for key in ('label', 'reason', 'weight_reason')):\n   239\t            raise model.SchemaError(f'composite {ident}: label, reason and weight reason must be nonempty')\n   240\t        seen.add(ident)\n   241\t        total += entry['weight_percent']\n   242\t        raises = 'first' if entry['raises_outcome_position'] == first[ident] else 'last'\n   243\t        supporting = raises if answer['claim_direction'] == 'higher' else ('last' if raises == 'first' else 'first')\n   244\t        drivers.append({'thesis_id': ident, 'label': entry['label'], 'reason': entry['reason'], 'supporting_end': supporting,\n   245\t                        'question': records[ident]['question'], 'weight_percent': entry['weight_percent'],\n   246\t                        'weight_reason': entry['weight_reason']})\n   247\t    if total != (100 if drivers else 0):\n   248\t        raise model.SchemaError(f'composite: impact weights must sum to 100, got {total}')\n   249\t    return {'version': 'idea-composite/4', 'method': 'weighted', 'as_of': as_of, 'drivers': drivers,\n   250\t            'target': {'outcome': answer['outcome'], 'direction': answer['claim_direction']}}\n   251\t\n   252\t\n   253\tdef contract(prompt_version, selected, ledger=None):\n   254\t    \"\"\"The schema, prose fields and binder belonging to each versioned composite prompt.\"\"\"\n   255\t    if prompt_version == 'idea-summary-v8':\n   256\t        theses = add_ladders(ledger, [{'view_id': entry['view_id']} for entry in selected], endpoints_only=True)\n   257\t        schema = adoption_schema(theses)\n   258\t        return schema, positive_prose, lambda answer, *args: bind_adoption(answer, *args, theses, schema)\n   259\t    if prompt_version == 'idea-summary-v7':\n   260\t        theses = add_ladders(ledger, [{'view_id': entry['view_id']} for entry in selected], endpoints_only=True)\n   261\t        return positive_schema(theses), positive_prose, lambda answer, *args: bind_positive(answer, *args, theses)\n   262\t    if prompt_version == 'idea-summary-v6':\n   263\t        theses = add_ladders(ledger, [{'view_id': entry['view_id']} for entry in selected], endpoints_only=True)\n   264\t        return weighted_schema(theses), disposition_prose, lambda answer, *args: bind_weighted(answer, *args, theses)\n   265\t    if prompt_version == 'idea-summary-v5':\n   266\t        theses = add_ladders(ledger, [{'view_id': entry['view_id']} for entry in selected], endpoints_only=True)\n   267\t        return endpoint_schema(theses), disposition_prose, lambda answer, *args: bind_endpoints(answer, *args, theses)\n   268\t    if prompt_version == 'idea-summary-v4':\n   269\t        return outcome_schema(selected), disposition_prose, bind_outcome\n   270\t    if prompt_version == 'idea-summary-v3':\n   271\t        return disposition_schema(selected), disposition_prose, bind_dispositions\n   272\t    if prompt_version == 'idea-summary-v2':\n   273\t        return SCHEMA, prose, lambda answer, *args: bind(answer['composite'], *args)\n   274\t    return None\n   275\t\n   276\t\n   277\tdef add_ladders(ledger, theses, endpoints_only=False):\n   278\t    \"\"\"Supply the immutable ordered outcomes, without copying evidence or guessing UI score orientation.\"\"\"\n   279\t    result = []\n   280\t    for thesis in theses:\n   281\t        rungs = store.rungs_of(ledger, thesis['view_id'])\n   282\t        if endpoints_only:\n   283\t            rungs = [rungs[0], rungs[-1]]\n   284\t        result.append({**thesis, 'ladder': [{key: rung[key] for key in ('position', 'label', 'condition')} for rung in rungs]})\n   285\t    return result\n   286\t\n   287\t\n","exit_code":0,"status":"completed"}}
