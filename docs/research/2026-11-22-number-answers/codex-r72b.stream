{"type":"item.started","item":{"id":"item_13","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"rg -n 'EVENT_MEASURES|MEASURES|yes_no|Yes.*No' src/hivemind/{views,identity*,extraction.py}; nl -ba src/hivemind/service.py | sed -n '360,570p'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba src/hivemind/bundle.py; nl -ba src/hivemind/search.py | sed -n '36,75p;213,305p'\"","aggregated_output":"     1\t\"\"\"One view in the shape the front end reads: the ladder, every judgement round with the model's reason and the\n     2\tevidence it cited, the evidence in force with tiers, speakers and sources, dependencies, replacements and the freeze\n     3\tswitches. The same shaping writes the mock's data file (scripts/mock_data.py) and answers POST /ideas, so the front\n     4\tend's adapter reads both. Read-only on every database. With `as_of`, rows written after that day are left out.\"\"\"\n     5\timport json\n     6\tfrom contextlib import contextmanager\n     7\tfrom datetime import date\n     8\t\n     9\tfrom . import service\n    10\tfrom .views import store\n    11\t\n    12\t\n    13\t@contextmanager\n    14\tdef read_snapshot(*connections):\n    15\t    \"\"\"Pin each read connection for a complete envelope; preserve a caller's transaction.\"\"\"\n    16\t    owned = []\n    17\t    try:\n    18\t        for conn in connections:\n    19\t            if conn is not None and not conn.in_transaction:\n    20\t                conn.execute('begin')\n    21\t                owned.append(conn)\n    22\t        yield\n    23\t    finally:\n    24\t        for conn in reversed(owned):\n    25\t            conn.rollback()\n    26\t\n    27\t\n    28\tdef item_lookup(items_db):\n    29\t    \"\"\"input id → title, publisher and category of a stored item, from the items database (or the id alone when the\n    30\t    database is not given or does not hold it).\"\"\"\n    31\t    cache = {}\n    32\t\n    33\t    def item_of(input_id):\n    34\t        if input_id not in cache:\n    35\t            row = items_db.execute('select title, publisher, publisher_type, category, publication_day, source_uri from items where input_id=?', (input_id,)).fetchone() if items_db is not None else None\n    36\t            cache[input_id] = dict(row) if row else {'title': input_id, 'publisher': '', 'publisher_type': '', 'category': '', 'publication_day': '', 'source_uri': ''}\n    37\t        return cache[input_id]\n    38\t    return item_of\n    39\t\n    40\t\n    41\tdef _visible(views_db, seq, as_of):\n    42\t    return as_of is None or service.visible(views_db, seq, as_of)\n    43\t\n    44\t\n    45\tdef ladder_row(views_db, view_id):\n    46\t    \"\"\"The view's ladder as the new system's writer stored it (`clean_ladders`, written in the view's own call): the parsed\n    47\t    ladder; 'no table' for a store without that table (a legacy ledger); 'no row' when the store has the table and no row for the\n    48\t    view. A row that is not readable JSON with a ladder, or two rows for one view, is refused.\"\"\"\n    49\t    if not views_db.execute(\"select 1 from sqlite_master where type='table' and name='clean_ladders'\").fetchone():\n    50\t        return 'no table'\n    51\t    rows = views_db.execute('select checked_answer from clean_ladders where view_id=?', (view_id,)).fetchall()\n    52\t    if not rows:\n    53\t        return 'no row'\n    54\t    if len(rows) > 1:\n    55\t        raise ValueError(f'{view_id}: {len(rows)} ladder rows for one view')\n    56\t    try:\n    57\t        ladder = json.loads(rows[0][0])['ladder']\n    58\t    except (TypeError, ValueError, KeyError) as error:\n    59\t        raise ValueError(f'{view_id}: its ladder row holds no readable ladder ({error!r})')\n    60\t    if not isinstance(ladder, dict):\n    61\t        raise ValueError(f'{view_id}: its ladder row holds no readable ladder')\n    62\t    return ladder\n    63\t\n    64\t\n    65\tdef not_judged(views_db, view_id, created_seq, as_of=None):\n    66\t    \"\"\"D397: the parts of a topic its one judged question leaves out, with their reasons, from the view's ladder row. None for a\n    67\t    legacy ledger, for a view with no row, and before the view's creation at as_of; [] when the row lists none. A malformed row,\n    68\t    or two rows for one view, is refused. Called directly for a view not visible at the resolved bound, it refuses the view\n    69\t    (OPERATING-CONTRACT.md, row 3), so a question created after that day is never returned.\"\"\"\n    70\t    as_of = service.resolve_bound(views_db, as_of, unfiltered=True)\n    71\t    if as_of is not None and not _visible(views_db, created_seq, as_of):\n    72\t        raise KeyError(f'{view_id} is not available as of {as_of}')\n    73\t    ladder = ladder_row(views_db, view_id)\n    74\t    if ladder in ('no table', 'no row'):\n    75\t        return None\n    76\t    parts = ladder.get('not_judged')\n    77\t    if not isinstance(parts, list) or not all(isinstance(p, dict) and isinstance(p.get('part'), str) and isinstance(p.get('why'), str) for p in parts):\n    78\t        raise ValueError(f'{view_id}: its parts not judged are not a list of {{part, why}} texts')\n    79\t    return [{'part': p['part'], 'why': p['why']} for p in parts]\n    80\t\n    81\t\n    82\tdef answer_shape(views_db, view_id):\n    83\t    \"\"\"(shape, favourable end) of the view's answer choices, as the page needs them to read the stored labels without inventing a\n    84\t    direction (page-contract/DESIGN.md): (None, None) for a legacy ledger; ('unrecorded', None) for a view with no row in a store\n    85\t    that has rows; ('event', None) or ('figure', 'higher' | 'lower' | 'n/a') from the row. Not suppressed before creation: it says\n    86\t    how to read the labels, which are shown as they are.\"\"\"\n    87\t    ladder = ladder_row(views_db, view_id)\n    88\t    if ladder == 'no table':\n    89\t        return None, None\n    90\t    if ladder == 'no row':\n    91\t        return 'unrecorded', None\n    92\t    if ladder.get('event'):\n    93\t        return 'event', None\n    94\t    figure = ladder.get('figure')\n    95\t    if isinstance(figure, dict) and figure.get('favourable_end') in ('higher', 'lower', 'n/a'):\n    96\t        return 'figure', figure['favourable_end']\n    97\t    raise ValueError(f'{view_id}: its ladder row is neither an event nor a figure with a favourable end')\n    98\t\n    99\t\n   100\tdef view_bundle(views_db, item_of, view_id, as_of=None):\n   101\t    \"\"\"One view's complete record as of the bound (resolved; an omitted bound on a store with no completed day reads every\n   102\t    record, as before). A view not visible at the bound is refused (OPERATING-CONTRACT.md, row 3).\"\"\"\n   103\t    as_of = service.resolve_bound(views_db, as_of, unfiltered=True)\n   104\t    v = views_db.execute('select * from views where view_id=?', (view_id,)).fetchone()\n   105\t    if v is None:\n   106\t        raise KeyError(view_id)\n   107\t    if as_of is not None and not service.view_exists(views_db, v, as_of):\n   108\t        raise KeyError(f'{view_id} is not available as of {as_of}')\n   109\t    columns = {r[1] for r in views_db.execute('pragma table_info(rungs)')}\n   110\t    bounds = ', lo, hi' if {'lo', 'hi'} <= columns else ''          # a ledger written before keys has no bounds; the adapter then reads the prose\n   111\t    rungs = [dict(r) for r in views_db.execute(f'select position, label, condition{bounds} from rungs where view_id=? order by position', (view_id,))]\n   112\t    switches = [dict(r) for r in views_db.execute('select open, reason, after_seq from view_switches where view_id=? order by id', (view_id,))\n   113\t                if _visible(views_db, r['after_seq'], as_of)]\n   114\t    for switch in switches:\n   115\t        switch['day'] = service.day_of_seq(views_db, switch['after_seq'])\n   116\t    judgements = []\n   117\t    for j in views_db.execute('select * from judgements where view_id=? order by judgement_id', (view_id,)):\n   118\t        if as_of is not None and j['publication_day'] > as_of:\n   119\t            continue\n   120\t        judgements.append({'id': str(j['judgement_id']), 'day': j['publication_day'], 'seq': j['seq'], 'rung': j['rung'], 'changed': bool(j['changed']),\n   121\t                           'why_changed': j['why_changed'], 'reasons': j['reasons'], 'cited': list(dict.fromkeys(json.loads(j['cited_evidence_json'] or '[]'))),   # each id once (UI contract uniqueItems); the sealed 2026-10-28 ledger holds one judgement citing an id twice\n   122\t                           'cited_views': json.loads(j['cited_views_json'] or '[]'), 'pushes': json.loads(j['pushes_json'] or '[]'),\n   123\t                           'from_item': j['input_id']})\n   124\t    evidence = []\n   125\t    for e in views_db.execute('select e.*, l.seq as linked_seq from evidence_links l join evidence e on e.evidence_id=l.evidence_id where l.view_id=? order by l.id', (view_id,)):\n   126\t        if not _visible(views_db, e['linked_seq'], as_of):\n   127\t            continue\n   128\t        sources = [dict(s) for s in views_db.execute('select input_id, publication_day, seq from evidence_sources where evidence_id=? order by id', (e['evidence_id'],))\n   129\t                   if _visible(views_db, s['seq'], as_of)]\n   130\t        replaced_by = views_db.execute('select new_evidence_id, said_day, seq from replacements where old_evidence_id=? order by id desc limit 1', (e['evidence_id'],)).fetchone()\n   131\t        if replaced_by is not None and not _visible(views_db, replaced_by['seq'], as_of):\n   132\t            replaced_by = None\n   133\t        replaces = views_db.execute('select old_evidence_id, seq from replacements where new_evidence_id=?', (e['evidence_id'],)).fetchone()\n   134\t        if replaces and not _visible(views_db, replaces['seq'], as_of):\n   135\t            replaces = None\n   136\t        first = sources[0] if sources else {'input_id': e['created_from_input'], 'publication_day': '', 'seq': e['created_seq']}\n   137\t        item = item_of(first['input_id'])\n   138\t        evidence.append({'id': e['evidence_id'], 'one_line': e['one_line'], 'quote': e['quote'], 'tier': e['tier'], 'speaker': e['speaker'],\n   139\t                         'original_who': e['original_who'], 'original_day': e['original_day'], 'event_time': e['event_time'],\n   140\t                         'day': first['publication_day'] or item['publication_day'], 'seq': first['seq'], 'linked_seq': e['linked_seq'],\n   141\t                         'arrival_day': service.day_of_seq(views_db, e['linked_seq']),\n   142\t                         'source': {'title': item['title'], 'publisher': item['publisher'], 'publisher_type': item['publisher_type'],\n   143\t                                    'category': item['category'], 'uri': item['source_uri']},\n   144\t                         'sources': [{'input_id': s['input_id'], 'day': s['publication_day'],\n   145\t                                      'arrival_day': service.day_of_seq(views_db, s['seq']),\n   146\t                                      'source': item_of(s['input_id'])} for s in sources],\n   147\t                         'outlets': len(sources), 'replaced_by': {'new_evidence_id': replaced_by['new_evidence_id'], 'said_day': replaced_by['said_day'],\n   148\t                                                               'day': service.day_of_seq(views_db, replaced_by['seq'])} if replaced_by else None,\n   149\t                         'replaces': replaces['old_evidence_id'] if replaces else None})\n   150\t    dependencies = [dict(r) for r in views_db.execute('select dependency_id, depends_on, direction, wait_chain_view_id, wait_year, seq from dependencies where view_id=? order by dependency_id', (view_id,))\n   151\t                    if _visible(views_db, r['seq'], as_of)]\n   152\t    for dependency in dependencies:\n   153\t        dependency['day'] = service.day_of_seq(views_db, dependency['seq'])\n   154\t        dependency['resolutions'] = [dict(target=r['resolved_to'], day=service.day_of_seq(views_db, r['seq']), seq=r['seq'])\n   155\t                                    for r in views_db.execute('select resolved_to, seq from dependency_resolutions where dependency_id=? order by id', (dependency['dependency_id'],))\n   156\t                                    if _visible(views_db, r['seq'], as_of)]\n   157\t    dependants = sorted({r['view_id'] for r in views_db.execute('select view_id, seq from dependencies where depends_on=?', (view_id,)) if _visible(views_db, r['seq'], as_of)},\n   158\t                        key=lambda s: (len(s), s))\n   159\t    created = item_of(v['created_from_input'])\n   160\t    key = store.view_key(views_db, view_id)\n   161\t    identity = {name: key[name] for name in ('measure', 'scope', 'period_start', 'period_end', 'basis', 'unit', 'event_type')} if key else None\n   162\t    successions = [{'thesis_id': r['succeeds'] if r['view_id'] == view_id else r['view_id'],\n   163\t                    'relation': 'previous' if r['view_id'] == view_id else 'next',\n   164\t                    'day': service.day_of_seq(views_db, r['seq'])}\n   165\t                   for r in views_db.execute('select * from successions where view_id=? or succeeds=? order by id', (view_id, view_id))\n   166\t                   if _visible(views_db, r['seq'], as_of)]\n   167\t    return {'view_id': view_id, 'object': v['object_id'], 'kind': v['kind'], 'looks_at': v['looks_at'], 'question': v['question'],\n   168\t            'due_day': v['due_day'], 'year': v['year'], 'identity': identity, 'successions': successions,\n   169\t            'created_seq': v['created_seq'], 'created_day': service.day_of_seq(views_db, v['created_seq']),\n   170\t            'created_from': {'title': created['title'], 'publisher': created['publisher'], 'category': created['category']},\n   171\t            'rungs': rungs, 'open': not any(not s['open'] for s in switches), 'switches': switches,\n   172\t            'judgements': judgements, 'evidence': evidence, 'dependencies': dependencies, 'dependants': dependants,\n   173\t            'not_judged': not_judged(views_db, view_id, v['created_seq'], as_of),\n   174\t            **dict(zip(('answer_shape', 'favourable_end'), answer_shape(views_db, view_id)))}\n   175\t\n   176\t\n   177\tdef days(views_db, as_of=None):\n   178\t    \"\"\"The completed days the front end's time axis runs over, up to as_of.\"\"\"\n   179\t    as_of = service.resolve_bound(views_db, as_of, unfiltered=True)\n   180\t    return [r[0] for r in views_db.execute('select day from days_completed order by day') if as_of is None or r[0] <= as_of]\n   181\t\n   182\t\n   183\tdef _bundles(views_db, items_db, view_ids, as_of=None, coverage='selection'):\n   184\t    \"\"\"Complete, dated UI inputs for caller-selected theses; no search, model call or ledger write. Its bound is already resolved\n   185\t    by its caller (`thesis_bundles`, `library`).\"\"\"\n   186\t    date.fromisoformat(as_of)\n   187\t    if not isinstance(view_ids, list) or not view_ids or any(not isinstance(id, str) or not id for id in view_ids):\n   188\t        raise ValueError('thesis_bundles needs a non-empty list of view ids')\n   189\t    lookup = item_lookup(items_db)\n   190\t    records = []\n   191\t    for view_id in dict.fromkeys(view_ids):\n   192\t        row = views_db.execute('select * from views where view_id=?', (view_id,)).fetchone()\n   193\t        if row is None or not service.view_exists(views_db, row, as_of):\n   194\t            raise KeyError(f'{view_id} is not available as of {as_of}')\n   195\t        records.append(view_bundle(views_db, lookup, view_id, as_of))\n   196\t    return {'as_of': as_of, 'days': days(views_db, as_of), 'views': records,\n   197\t            'coverage': coverage, 'groups': research_groups(views_db, view_ids, as_of)}\n   198\t\n   199\t\n   200\tdef research_groups(conn, view_ids, as_of):\n   201\t    \"\"\"Stored groups, with dated memberships limited to the envelope's loaded theses.\"\"\"\n   202\t    if not conn.execute('pragma table_info(thesis_groups)').fetchone():\n   203\t        return []\n   204\t    loaded = set(view_ids)\n   205\t    result = []\n   206\t    for row in conn.execute('select * from thesis_groups order by created_seq, rowid'):\n   207\t        if not service.visible(conn, row['created_seq'], as_of):\n   208\t            continue\n   209\t        members = [{'thesis_id': m['view_id'], 'day': service.day_of_seq(conn, m['seq']), 'basis': m['basis'] or ''}\n   210\t                   for m in conn.execute('select * from thesis_group_members where group_id=? order by id', (row['group_id'],))\n   211\t                   if m['view_id'] in loaded and service.visible(conn, m['seq'], as_of)]\n   212\t        if members:\n   213\t            result.append({'id': row['group_id'], 'name': row['name'], 'scope': row['scope'],\n   214\t                           'aliases': json.loads(row['aliases'] or '[]') if 'aliases' in row.keys() else [],\n   215\t                           'created_day': service.day_of_seq(conn, row['created_seq']), 'members': members})\n   216\t    return result\n   217\t\n   218\t\n   219\tdef thesis_bundles(views_db, items_db, view_ids, as_of=None):\n   220\t    \"\"\"Selected complete thesis records, pinned to one read transaction.\"\"\"\n   221\t    with read_snapshot(views_db, items_db):\n   222\t        return _bundles(views_db, items_db, view_ids, service.resolve_bound(views_db, as_of))\n   223\t\n   224\t\n   225\tdef library(views_db, items_db, as_of=None):\n   226\t    \"\"\"All theses, including closed ones, and stored groups; no search or model call.\"\"\"\n   227\t    with read_snapshot(views_db, items_db):\n   228\t        as_of = service.resolve_bound(views_db, as_of)\n   229\t        if not as_of:\n   230\t            raise ValueError('The library has no completed day; supply as_of')\n   231\t        date.fromisoformat(as_of)\n   232\t        view_ids = [r['view_id'] for r in views_db.execute('select * from views order by created_seq, rowid')\n   233\t                    if service.view_exists(views_db, r, as_of)]\n   234\t        if not view_ids:\n   235\t            return {'as_of': as_of, 'days': days(views_db, as_of), 'views': [], 'coverage': 'library', 'groups': []}\n   236\t        return _bundles(views_db, items_db, view_ids, as_of, coverage='library')\n    36\t\"\"\"\n    37\t\n    38\t\n    39\tdef open_index(path):\n    40\t    conn = sqlite3.connect(path)\n    41\t    conn.row_factory = sqlite3.Row\n    42\t    conn.executescript(SCHEMA_SQL)\n    43\t    return conn\n    44\t\n    45\t\n    46\tdef view_text(record, rungs):\n    47\t    \"\"\"What a view is searched by: its object, kind, what it looks at, the question and the rung conditions.\"\"\"\n    48\t    return ' '.join([record['object_id'], record['kind'], record['looks_at'] or '', record['question'] or '', *(r['condition'] for r in rungs)])\n    49\t\n    50\t\n    51\tdef sha(text):\n    52\t    return hashlib.sha256(text.encode('utf-8')).hexdigest()\n    53\t\n    54\t\n    55\tdef openai_embeddings(texts, embedding_model=EMBEDDING_MODEL, timeout=120):\n    56\t    \"\"\"One embeddings call for a batch of texts: returns (vectors, total_tokens).\"\"\"\n    57\t    body = json.dumps({'model': embedding_model, 'input': texts}).encode('utf-8')\n    58\t    headers = {'Authorization': f'Bearer {model._key(\"openai\")}', 'Content-Type': 'application/json'}\n    59\t    last = None\n    60\t    for attempt in range(3):\n    61\t        try:\n    62\t            with urllib.request.urlopen(urllib.request.Request(EMBEDDINGS_URL, data=body, headers=headers, method='POST'), timeout=timeout) as response:\n    63\t                answer = json.loads(response.read().decode('utf-8'))\n    64\t            vectors = [item['embedding'] for item in sorted(answer['data'], key=lambda d: d['index'])]\n    65\t            return vectors, int((answer.get('usage') or {}).get('total_tokens') or 0)\n    66\t        except urllib.error.HTTPError as error:\n    67\t            # the status and the provider's error type only: the body of an auth error can echo the request's headers\n    68\t            body = error.read().decode('utf-8', 'ignore')\n    69\t            try:\n    70\t                kind = (json.loads(body).get('error') or {}).get('type') or ''\n    71\t            except (ValueError, AttributeError):\n    72\t                kind = ''\n    73\t            last = f'embeddings HTTP {error.code}' + (f' ({kind})' if kind else '')\n    74\t            if error.code in (400, 401, 403, 404):\n    75\t                raise model.TransportError(last)\n   213\tdef visible_lexical_order(corpus, text, top_n):\n   214\t    \"\"\"The trigram ranking `store.search_views` gives, computed over `corpus` only (the views visible at the request's bound), so the\n   215\t    ranking's statistics never include a view the request cannot see (OPERATING-CONTRACT.md, row 4a). Same text per view, same query,\n   216\t    same tokenizer, the views in creation order.\"\"\"\n   217\t    words = [w for w in text.replace('？', ' ').replace('，', ' ').split() if len(w) >= 2]\n   218\t    if not words or not corpus:\n   219\t        return []\n   220\t    query = ' OR '.join('\"' + w.replace('\"', '') + '\"' for w in words[:12])\n   221\t    memory = sqlite3.connect(':memory:')\n   222\t    try:\n   223\t        memory.execute(\"create virtual table views_fts using fts5(view_id unindexed, text, tokenize='trigram')\")\n   224\t        memory.executemany('insert into views_fts (view_id, text) values (?, ?)',\n   225\t                           [(record['view_id'], f\"{record['object']} {record['looks_at']} {record['question']}\") for record in corpus])\n   226\t        return [row[0] for row in memory.execute('select view_id from views_fts where views_fts match ? order by rank limit ?', (query, top_n))]\n   227\t    except sqlite3.OperationalError:\n   228\t        return []\n   229\t    finally:\n   230\t        memory.close()\n   231\t\n   232\t\n   233\tdef lexical_terms(query, limit=12):\n   234\t    \"\"\"What the ledger's trigram index is asked for: the Latin words of three characters or more, and every\n   235\t    three-character window of each Chinese run (Chinese has no spaces to split on; the index matches on\n   236\t    trigrams). 2026-10-24: a Chinese idea written without spaces matched nothing as one phrase.\"\"\"\n   237\t    terms = [m.group(0) for m in LATIN_WORD.finditer(query)]\n   238\t    for run in CJK.findall(query):\n   239\t        terms += [run[i:i + 3] for i in range(len(run) - 2)] or [run]\n   240\t    seen, out = set(), []\n   241\t    for term in terms:\n   242\t        if term.lower() not in seen:\n   243\t            seen.add(term.lower())\n   244\t            out.append(term)\n   245\t    return out[:limit]\n   246\t\n   247\t\n   248\tdef search(ledger, index, query, k=10, as_of=None, include_closed=False, embed=openai_embeddings, embedding_model=EMBEDDING_MODEL, aliases=None, semantic=True):\n   249\t    \"\"\"Top-k views for a query as of a day: cosine similarity on the view text, plus a small boost when the query\n   250\t    names the view's object and when the ledger's trigram index also matches. The ranking is 'semantic' only when\n   251\t    semantic ranking is allowed, every candidate has a usable vector made from its current text and the query could\n   252\t    be embedded; otherwise it is 'lexical' (the trigram index's own order), and the answer says so and names the\n   253\t    views without a fresh vector. `semantic=False` (a front started with --lexical) never calls the embedder.\n   254\t    `results` is null when the library holds no view on anything the idea names as of that day (D91): no company\n   255\t    or theme of the universe is named in it and the ledger's own text index matches no view; otherwise the ranked\n   256\t    list comes back whole and the caller judges which views correspond (D76).\"\"\"\n   257\t    as_of = service.resolve_bound(ledger, as_of)\n   258\t    candidates = service.summaries(ledger, as_of, include_closed)\n   259\t    if not candidates:\n   260\t        return {'query': query, 'as_of': as_of, 'mode': 'semantic' if semantic else 'lexical', 'missing_vectors': [], 'results': None}\n   261\t    mentioned = objects_in(query, aliases or {})\n   262\t    corpus = service.summaries(ledger, as_of, include_closed=True)                              # every view visible at the bound\n   263\t    lexical_order = visible_lexical_order(corpus, ' '.join(lexical_terms(query)), 50)           # trigram ranking over those only, best first\n   264\t    lexical_rank = {view_id: i for i, view_id in enumerate(lexical_order)}\n   265\t    vectors = fresh_vectors(ledger, index, embedding_model, [record['view_id'] for record in candidates]) if semantic else {}\n   266\t    missing = [record['view_id'] for record in candidates if record['view_id'] not in vectors]\n   267\t    mode, q = 'semantic', None\n   268\t    if not semantic or missing:\n   269\t        mode = 'lexical'\n   270\t    else:\n   271\t        try:\n   272\t            q, _ = query_vector(index, query, embed, embedding_model)\n   273\t        except (model.TransportError, OSError):\n   274\t            mode = 'lexical'\n   275\t    results = []\n   276\t    for record in candidates:\n   277\t        semantic = cosine(q, vectors[record['view_id']]) if q is not None else 0.0\n   278\t        object_hit = record['object'] in mentioned\n   279\t        text_hit = record['view_id'] in lexical_rank\n   280\t        # with embeddings a text hit is a small nudge; without them the trigram index's own order is the ranking\n   281\t        text_score = (TEXT_BOOST if mode == 'semantic' else 1.0 - lexical_rank[record['view_id']] / max(1, len(lexical_order))) if text_hit else 0.0\n   282\t        score = semantic + (OBJECT_BOOST if object_hit else 0.0) + text_score\n   283\t        results.append({'view_id': record['view_id'], 'object': record['object'], 'kind': record['kind'], 'looks_at': record['looks_at'], 'question': record['question'],\n   284\t                        'due_day': record['due_day'], 'open': record['open'], 'dependencies': record['dependencies'], 'dependants': record['dependants'],\n   285\t                        'score': round(score, 4), 'parts': {'semantic': round(semantic, 4), 'object_hit': object_hit, 'text_hit': text_hit}})\n   286\t    results.sort(key=lambda r: -r['score'])\n   287\t    named_or_matched = any(r['parts']['object_hit'] or r['parts']['text_hit'] for r in results)\n   288\t    best = max((r['parts']['semantic'] for r in results), default=0.0)\n   289\t    if not named_or_matched and (q is None or best < NULL_FLOOR):\n   290\t        return {'query': query, 'as_of': as_of, 'mode': mode, 'missing_vectors': missing, 'results': None}     # no recorded view on anything the idea names\n   291\t    return {'query': query, 'as_of': as_of, 'mode': mode, 'missing_vectors': missing, 'results': results[:k]}\n   292\t\n   293\t\n   294\tdef fake_embed(texts, embedding_model=EMBEDDING_MODEL, dims=256):\n   295\t    \"\"\"A deterministic stand-in for tests: a bag of character bigrams hashed into a fixed number of dimensions, so\n   296\t    texts sharing words share directions. Never used for the real index.\"\"\"\n   297\t    out = []\n   298\t    for text in texts:\n   299\t        vector = [0.0] * dims\n   300\t        lowered = re.sub(r'\\s+', ' ', text.lower())\n   301\t        for i in range(len(lowered) - 1):\n   302\t            vector[int(hashlib.md5(lowered[i:i + 2].encode('utf-8')).hexdigest(), 16) % dims] += 1.0\n   303\t        out.append(vector)\n   304\t    return out, sum(len(t) for t in texts) // 4\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba src/hivemind/idea.py | sed -n '104,430p'\"","aggregated_output":"   104\t\n   105\t\n   106\tdef object_list(ledger, as_of, aliases=None):\n   107\t    \"\"\"What the library covers, in one line: each object with open views as of the day and its count, then the\n   108\t    universe's objects with no view yet. About 250 characters on the sealed ledger against 5,095 for a full catalog.\"\"\"\n   109\t    as_of = service.resolve_bound(ledger, as_of)\n   110\t    counts, kinds = {}, {}\n   111\t    for record in service.views(ledger, None, as_of):\n   112\t        counts[record['object']] = counts.get(record['object'], 0) + 1\n   113\t        kinds[record['object']] = record['object_kind']\n   114\t    covered = '; '.join(f'{obj} ({kinds[obj]}) {n}' for obj, n in sorted(counts.items(), key=lambda kv: -kv[1]))\n   115\t    missing = sorted(o for o in (aliases or {}) if o not in counts)\n   116\t    return (f'Objects with open views as of {as_of} (object, kind, number of views): {covered}.'\n   117\t            + (f' Objects in the universe with no view yet: {\", \".join(missing)}.' if missing else ''))\n   118\t\n   119\t\n   120\tdef judged(ledger, view_id, as_of, detailed=False):\n   121\t    state = service.state_as_of(ledger, view_id, as_of)\n   122\t    if not state:\n   123\t        return None\n   124\t    rung = next((g for g in store.rungs_of(ledger, view_id) if g['position'] == state['position']), {})\n   125\t    result = {'position': state['position'], 'label': rung.get('label', '')}\n   126\t    if detailed:\n   127\t        result.update(condition=rung.get('condition', ''), day=state['judgement_day'], reasons=state['reasons'])\n   128\t    return result\n   129\t\n   130\t\n   131\tdef brief(ledger, results, as_of, detailed=False):\n   132\t    \"\"\"Candidate state at the requested date; analyst context is explicit and versioned by the caller.\"\"\"\n   133\t    as_of = service.resolve_bound(ledger, as_of)\n   134\t    records = []\n   135\t    for result in results:\n   136\t        record = {'view_id': result['view_id'], 'object': result['object'], 'looks_at': result['looks_at'],\n   137\t                  'judged': judged(ledger, result['view_id'], as_of, detailed)}\n   138\t        if detailed:\n   139\t            record['question'] = result['question']\n   140\t        records.append(record)\n   141\t    return records\n   142\t\n   143\t\n   144\tdef related_views(ledger, view_ids, as_of, exclude=()):\n   145\t    \"\"\"The given views' neighbours in the ledger's dependency graph, as of the day: what each depends on (upstream)\n   146\t    and what depends on it (downstream), with the judged position; `exclude` are views already on the card.\n   147\t    Deterministic and free; the model is not asked. The card follows the graph only from the views of the first\n   148\t    part, the thing the idea is about: from every mapped view it fanned out to 12 cards on a one-line idea.\"\"\"\n   149\t    as_of = service.resolve_bound(ledger, as_of)\n   150\t    out, seen = [], set(view_ids) | set(exclude)\n   151\t    for view_id in view_ids:\n   152\t        for dep in service.dependencies(ledger, view_id, as_of):\n   153\t            target = ledger.execute('select * from views where view_id=?', (dep['view_id'],)).fetchone()\n   154\t            if dep['view_id'] not in seen and target is not None and service.view_exists(ledger, target, as_of):\n   155\t                seen.add(dep['view_id'])\n   156\t                out.append({'view_id': dep['view_id'], 'via': view_id, 'relation': 'upstream', 'direction': dep['direction'], 'judged': judged(ledger, dep['view_id'], as_of)})\n   157\t        for other in service.dependants(ledger, view_id, as_of):\n   158\t            if other not in seen:\n   159\t                seen.add(other)\n   160\t                out.append({'view_id': other, 'via': view_id, 'relation': 'downstream', 'direction': None, 'judged': judged(ledger, other, as_of)})\n   161\t    return out\n   162\t\n   163\t\n   164\tdef service_direct(part, directs, looks_at):\n   165\t    \"\"\"The first part's direct view: among the views the model called direct, in the order the part's own search\n   166\t    ranked them, the first whose text carries the part's year (a fiscal year that covers the calendar year counts:\n   167\t    FY2027 for \"2026\"); a part that names no year takes the first. The model's label picks the quantity, the year\n   168\t    check and the search order keep the pick the same across samples. Until 2026-10-24 the rule took the top search\n   169\t    hit on object and year alone and overrode the model's label in 4 of 31 picks (TSMC capex → TSMC revenue, Meta\n   170\t    capex → total expenses, NVIDIA total revenue → a segment, Rubin revenue → total revenue); there is no object\n   171\t    test, because a theme's view (TSMC capex under supply-chain-shift) is a company part's direct view.\"\"\"\n   172\t    years = {y.upper().replace(' ', '') for y in YEAR.findall(part.get('period', '') + ' ' + part.get('looks_for', ''))}\n   173\t    covered = set(years)\n   174\t    for y in list(years):\n   175\t        if y.isdigit():\n   176\t            covered |= {f'FY{y}', f'FY{int(y) + 1}'}\n   177\t    for view_id in directs:\n   178\t        text_years = {y.upper().replace(' ', '') for y in YEAR.findall(looks_at.get(view_id) or '')}\n   179\t        if not years or covered & text_years:\n   180\t            return view_id\n   181\t    return None\n   182\t\n   183\t\n   184\tdef english(*fields):\n   185\t    return not any(CJK.search(str(f or '')) for f in fields)\n   186\t\n   187\t\n   188\tdef call_english(archive, cfg, setting, system, user, schema, name, transport, fields_of):\n   189\t    \"\"\"One model call whose answer must be English (D133): when a field comes back in Chinese the call is made once\n   190\t    more with the instruction repeated; the second answer stands either way, and the slip is counted.\"\"\"\n   191\t    made = [model.call(archive, cfg, setting, system, user, schema, name, 'idea', transport=transport)]\n   192\t    slips = 0\n   193\t    if not english(*fields_of(made[-1].data)):\n   194\t        slips = 1\n   195\t        made.append(model.call(archive, cfg, setting, system, user + '\\n\\nWrite every field in English.', schema, name, 'idea', transport=transport))\n   196\t        slips += 0 if english(*fields_of(made[-1].data)) else 1\n   197\t    return made, slips\n   198\t\n   199\t\n   200\tdef canonical_query(part, aliases=None):\n   201\t    \"\"\"The service's own query for a part: the object's id (a ticker or theme id, itself an alias the search boosts),\n   202\t    what the part looks for, the period. The model's free-text query varies between samples and so do its\n   203\t    candidates; this one does not (iteration 8).\"\"\"\n   204\t    return ' '.join(x for x in (part.get('object', ''), part.get('looks_for', ''), part.get('period', '')) if x).strip()\n   205\t\n   206\t\n   207\tdef merged(first, second, limit):\n   208\t    \"\"\"Two ranked lists interleaved without repeats, the first list's top first.\"\"\"\n   209\t    out, seen = [], set()\n   210\t    for a, b in zip(first + [None] * len(second), second + [None] * len(first)):\n   211\t        for r in (a, b):\n   212\t            if r is not None and r['view_id'] not in seen:\n   213\t                seen.add(r['view_id'])\n   214\t                out.append(r)\n   215\t    return out[:limit]\n   216\t\n   217\t\n   218\tdef read_idea(ledger, index, items, archive, cfg, text, as_of=None, k=10, aliases=None, semantic=True, transport=None, bundles=True, embed=search.openai_embeddings, on_progress=None):\n   219\t    \"\"\"The idea card: idea, what the idea's own search found, the reading (typed parts, the candidates each got, the\n   220\t    views each maps to, the summary, the claim), the related views from the dependency graph, the evaluation, every\n   221\t    view's bundle, the days, the trace of searches, and all call costs. No recorded view → no model call.\"\"\"\n   222\t    text = (text or '').strip()\n   223\t    if not text:\n   224\t        raise ValueError('an idea needs text')\n   225\t    as_of = service.resolve_bound(ledger, as_of)\n   226\t    report = on_progress or (lambda stage: None)\n   227\t    report('search')\n   228\t    found = search.search(ledger, index, text, k, as_of, aliases=aliases, semantic=semantic, embed=embed)\n   229\t    card = {'idea': {'text': text, 'as_of': as_of}, 'search': {'mode': found['mode'], 'candidates': [r['view_id'] for r in found['results'] or []]},\n   230\t            'reading': None, 'evaluation': None, 'related': [], 'views': [], 'days': bundle.days(ledger, as_of),\n   231\t            'no_recorded_view': found['results'] is None, 'cost': dict(NO_COST)}\n   232\t    if found['results'] is None:\n   233\t        return card\n   234\t    setting = cfg.idea\n   235\t    if setting is None:\n   236\t        raise config.ConfigError(f'config {cfg.version} has no idea setting')\n   237\t    decompose_prompt, map_prompt = prompts(setting)\n   238\t    started = time.time()\n   239\t    cost = dict(NO_COST)\n   240\t    cost['cached'] = True\n   241\t\n   242\t    def spend(answer):\n   243\t        cost['usd'] += answer.cost_usd\n   244\t        cost['input_tokens'] += answer.input_tokens\n   245\t        cost['output_tokens'] += answer.output_tokens\n   246\t        cost['turns'] += 1\n   247\t        cost['cached'] = cost['cached'] and answer.cached\n   248\t\n   249\t    # call 1: the parts\n   250\t    report('decompose')\n   251\t    user = f'Idea: {text}\\nDay: {as_of} (the library as judged on this day)\\n\\n{object_list(ledger, as_of, aliases)}'\n   252\t    made, slips = call_english(archive, cfg, setting, decompose_prompt, user, DECOMPOSE, 'idea_decompose', transport,\n   253\t                               lambda d: [f for p in d['parts'] for f in (p['looks_for'], p['period'])])\n   254\t    for answer in made:\n   255\t        spend(answer)\n   256\t    first = made[-1]\n   257\t    parts = [dict(p) for p in first.data['parts'][:MAX_PARTS]]\n   258\t    # the service: one search per part, the candidates each part got\n   259\t    report('retrieve')\n   260\t    detailed = setting.prompt_version == 'idea-v12'\n   261\t    idea_rows = brief(ledger, found['results'][:IDEA_ROWS], as_of, detailed)\n   262\t    trace, candidates, ranks = [], [], []\n   263\t    queries = [((part.get('query') or '').strip() or canonical_query(part, aliases), canonical_query(part, aliases)) for part in parts]\n   264\t    if semantic and found['mode'] == 'semantic':\n   265\t        search.warm_queries(index, [q for pair in queries for q in pair], embed)      # one embeddings round trip for every part instead of two per part\n   266\t    # a part's candidates: the service's canonical query and the model's own, interleaved (tried 2026-10-25 and dropped:\n   267\t    # the object's views ranked by the idea text alone lost the model's finds, gold direct right 17 → 15 of 19)\n   268\t    for i, (part, (query, own)) in enumerate(zip(parts, queries)):\n   269\t        hit = search.search(ledger, index, query, PER_PART, as_of, aliases=aliases, semantic=semantic, embed=embed)\n   270\t        steady = search.search(ledger, index, own, PER_PART, as_of, aliases=aliases, semantic=semantic, embed=embed) if own.lower() != query.lower() else hit\n   271\t        rows = brief(ledger, merged(steady['results'] or [], hit['results'] or [], PER_PART), as_of, detailed)\n   272\t        candidates.append(rows)\n   273\t        ranks.append({r['view_id']: n for n, r in enumerate(hit['results'] or [])})      # the part's own search order, the tie-break among the model's direct views\n   274\t        trace.append({'tool': 'search', 'part': i, 'query': query, 'canonical': own, 'returned': [r['view_id'] for r in rows]})\n   275\t    # call 2: the mapping\n   276\t    report('map')\n   277\t    map_schema, payload = CONTRACTS.get(setting.prompt_version, (MAP, full_payload))\n   278\t    user = payload(text, as_of, parts, candidates, idea_rows)\n   279\t    made, more = call_english(archive, cfg, setting, map_prompt, user, map_schema, 'idea_map', transport,\n   280\t                              lambda d: [d['summary'], *(p.get('why', '') for p in d['parts'])])\n   281\t    slips += more\n   282\t    for answer in made:\n   283\t        spend(answer)\n   284\t    second = made[-1]\n   285\t    # the service keeps the mapping honest: only candidates, in the parts' order; direct and driver views go on the\n   286\t    # canvas, context stays on the card; the first part's direct view is the service's own pick when the rule holds\n   287\t    idea_ids = {r['view_id'] for r in idea_rows}\n   288\t    looks_at = {r['view_id']: r['looks_at'] for rows in candidates + [idea_rows] for r in rows}\n   289\t    mapping = {m['index']: m for m in second.data['parts'] if isinstance(m.get('index'), int)}\n   290\t    parts_out, chosen, dropped, seen = [], [], [], set()\n   291\t    for i, part in enumerate(parts):\n   292\t        m = mapping.get(i, {'views': [], 'why': 'the mapping call did not answer this part'})\n   293\t        allowed = {r['view_id'] for r in candidates[i]} | idea_ids\n   294\t        market = bool(MARKET_READING.search(part.get('looks_for', '') or ''))\n   295\t        tiers = {'direct': [], 'driver': [], 'context': []}\n   296\t        directs = [v.get('view_id') for v in m.get('views') or [] if v.get('fit') == 'direct' and v.get('view_id') in allowed]\n   297\t        ordered = sorted(dict.fromkeys(directs), key=lambda v: (ranks[i].get(v, len(ranks[i])), directs.index(v)))\n   298\t        decided = service_direct(part, ordered, looks_at) if i == 0 and not market else None\n   299\t        if decided:\n   300\t            tiers['direct'].append(decided)\n   301\t        for v in m.get('views') or []:\n   302\t            view_id, fit = v.get('view_id'), v.get('fit', 'context')\n   303\t            if market:\n   304\t                dropped.append({'view_id': view_id, 'why': f'part {i} is a market reading ({part[\"looks_for\"][:50]}); the library holds no view on prices'})\n   305\t            elif view_id not in allowed:\n   306\t                dropped.append({'view_id': view_id, 'why': f'not among the candidates of part {i} ({part[\"looks_for\"][:60]})'})\n   307\t            elif all(view_id not in tiers[k] for k in tiers):\n   308\t                if fit == 'driver' and len(tiers['driver']) >= DRIVERS_PER_PART and not (\n   309\t                        cfg.idea_summary and cfg.idea_summary.prompt_version in ('idea-summary-v6', 'idea-summary-v7', 'idea-summary-v8')):\n   310\t                    tiers['context'].append(view_id)          # beyond the cap a driver is kept on the card, not the canvas\n   311\t                else:\n   312\t                    tiers[fit].append(view_id)\n   313\t        mapped = tiers['direct'] + tiers['driver']\n   314\t        parts_out.append({'index': i, 'object': part['object'], 'looks_for': part['looks_for'], 'period': part['period'], 'query': trace[i]['query'],\n   315\t                          'candidates': [r['view_id'] for r in candidates[i]], 'view_ids': mapped, 'direct': tiers['direct'], 'driver': tiers['driver'],\n   316\t                          'context': tiers['context'], 'service_direct': decided, 'market_reading': market,\n   317\t                          'clauses': {v['view_id']: v['clause'] for v in m.get('views') or [] if v.get('clause')},     # idea-v10: how each driver moves the part\n   318\t                          'why': 'a market reading: the library holds no view on prices' if market else m.get('why', '')})\n   319\t        for view_id in mapped:\n   320\t            if view_id not in seen:\n   321\t                seen.add(view_id)\n   322\t                chosen.append({'view_id': view_id, 'why': m.get('why', ''), 'part': part['looks_for'], 'fit': 'direct' if view_id in tiers['direct'] else 'driver'})\n   323\t    # the claim: the idea must state an amount; the claimed part must map to a view; the service evaluates\n   324\t    claim, evaluation = first.data['claim'], None\n   325\t    if claim is not None:\n   326\t        if not MONEY_IN_IDEA.search(text):\n   327\t            dropped.append({'view_id': None, 'why': 'the claim states an amount the idea does not'})\n   328\t            claim = None\n   329\t        elif not (0 <= claim['part'] < len(parts_out)):\n   330\t            dropped.append({'view_id': None, 'why': 'the claim names a part that does not exist'})\n   331\t        elif parts_out[claim['part']]['market_reading']:\n   332\t            dropped.append({'view_id': None, 'why': 'the claim is about a market price; the library holds no view on prices'})\n   333\t        elif not parts_out[claim['part']]['direct']:\n   334\t            dropped.append({'view_id': None, 'why': 'the claimed part has no direct view; a driver is not the quantity the idea names'})\n   335\t        else:\n   336\t            claim = dict(claim, view_id=parts_out[claim['part']]['direct'][0])\n   337\t            evaluation = service.evaluate(ledger, claim['view_id'], claim['comparator'], float(claim['value_usd']), as_of)\n   338\t    related = related_views(ledger, parts_out[0]['view_ids'] if parts_out else [], as_of, exclude=[c['view_id'] for c in chosen])\n   339\t    summary = second.data['summary']\n   340\t    composite = None\n   341\t    if cfg.idea_summary is not None:\n   342\t        report('summarize')\n   343\t        summary_setting = cfg.idea_summary\n   344\t        with open(config.prompt_path(summary_setting.prompt_version + '.txt'), encoding='utf-8') as handle:\n   345\t            summary_prompt = handle.read().strip()\n   346\t        records = {r['view_id']: r for r in service.summaries(ledger, as_of)}\n   347\t        context = {'idea': text, 'as_of': as_of, 'evaluation': evaluation,\n   348\t                   'parts': [{key: part[key] for key in ('object', 'looks_for', 'period', 'direct', 'driver', 'context', 'why')} for part in parts_out],\n   349\t                   'theses': brief(ledger, [records[c['view_id']] for c in chosen], as_of, detailed=True)}\n   350\t        composite_contract = idea_composite.contract(summary_setting.prompt_version, chosen, ledger)\n   351\t        if composite_contract:\n   352\t            context['theses'] = idea_composite.add_ladders(ledger, context['theses'], endpoints_only=summary_setting.prompt_version in ('idea-summary-v5', 'idea-summary-v6', 'idea-summary-v7', 'idea-summary-v8'))\n   353\t            for part in context['parts']:\n   354\t                del part['why']\n   355\t            if summary_setting.prompt_version in ('idea-summary-v7', 'idea-summary-v8'):\n   356\t                context['candidate_theses'] = context.pop('theses')\n   357\t        schema, prose, bind_composite = composite_contract or (SUMMARY, lambda d: [d['summary']], None)\n   358\t        made, more = call_english(archive, cfg, summary_setting, summary_prompt, json.dumps(context, ensure_ascii=False),\n   359\t                                  schema, 'idea_summary', transport, prose)\n   360\t        slips += more\n   361\t        for answer in made:\n   362\t            spend(answer)\n   363\t        summary = made[-1].data['summary']\n   364\t        if bind_composite:\n   365\t            composite = bind_composite(made[-1].data, chosen, records, as_of)\n   366\t            if composite['version'] == 'idea-composite/4':\n   367\t                mapped = {entry['view_id']: entry for entry in chosen}\n   368\t                chosen = [mapped[entry['thesis_id']] for entry in composite['drivers']]\n   369\t                adopted = {entry['view_id'] for entry in chosen}\n   370\t                for part in parts_out:\n   371\t                    for key in ('view_ids', 'direct', 'driver', 'context'):\n   372\t                        part[key] = [ident for ident in part[key] if ident in adopted]\n   373\t                    if part['service_direct'] not in adopted:\n   374\t                        part['service_direct'] = None\n   375\t                    part['clauses'] = {ident: clause for ident, clause in part['clauses'].items() if ident in adopted}\n   376\t                if claim and claim['view_id'] not in adopted:\n   377\t                    claim, evaluation = None, None\n   378\t                related = []\n   379\t    card['reading'] = {'summary': summary, 'parts': parts_out, 'chosen': chosen, 'claim': claim, 'dropped': dropped, 'trace': trace, 'language_slips': slips}\n   380\t    if composite is not None:\n   381\t        card['reading']['composite'] = composite\n   382\t    card['evaluation'] = evaluation\n   383\t    card['related'] = related\n   384\t    if bundles:        # a page that fetches /thesis-bundles itself asks for the card alone: 20 KB instead of 2.7 MB\n   385\t        item_of = bundle.item_lookup(items)\n   386\t        card['views'] = [bundle.view_bundle(ledger, item_of, view_id, as_of) for view_id in [c['view_id'] for c in chosen] + [r['view_id'] for r in related]]\n   387\t    cost['seconds'] = round(time.time() - started, 1)\n   388\t    card['cost'] = cost\n   389\t    return card\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"rg -n 'EVENT_MEASURES|MEASURES|yes_no|Yes.*No' src/hivemind/{views,identity*,extraction.py}; nl -ba src/hivemind/service.py | sed -n '360,570p'\"","aggregated_output":"zsh:1: no matches found: src/hivemind/identity*\n   360\t                    'position_moved': before is not None and before != row['rung'], 'why_changed': row['why_changed'], 'cited': cited})\n   361\t    return out\n   362\t\n   363\t\n   364\t# ---------- a claim against a ladder\n   365\t#\n   366\t# A rung's condition is a sentence like \"不低于 1650 亿美元且不高于 1690 亿美元，处于公司指引区间\". The band is read from\n   367\t# the comparator words and the amount that follows each; remarks after ；or ， are not part of it. The ladder is\n   368\t# evaluable only when its bands form one unbroken partition of the line (06-views: 格和格不重叠、不留空), so a\n   369\t# condition the parser cannot read makes the whole ladder \"not evaluable\" rather than a wrong verdict.\n   370\t\n   371\tINF = float('inf')\n   372\tUNIT_USD = {'万亿': Decimal('1e12'), '千亿': Decimal('1e11'), '亿': Decimal('1e8'), '万': Decimal('1e4'), None: Decimal(1)}   # exact: 269.79亿 is 26,979,000,000, not ...000.000004\n   373\t# an amount: a number with a Chinese magnitude or followed by 美元; a bare number counts only right after a comparator\n   374\t# or a range separator (大于或等于0, 小于-10亿), so years (2026年, FY2026) and model names (H100) are not amounts\n   375\tAMOUNT_TOKEN = re.compile(r'(?<![A-Za-z\\d.])(-?\\d[\\d,]*(?:\\.\\d+)?)\\s*(万亿|千亿|亿|万)?(\\s*美元)?')\n   376\tCOMPARATORS_RE = [\n   377\t    ('lo_inc', re.compile(r'不低于|不少于|至少|大于或等于|大于等于|达到或超过|达到(?!或)|≥|>=')),\n   378\t    ('lo_exc', re.compile(r'(?<!不)高于|(?<![不或])超过|大于(?!或等于|等于)|多于|>(?!=)')),\n   379\t    ('hi_inc', re.compile(r'不高于|不超过|至多|小于或等于|小于等于|≤|<=')),\n   380\t    ('hi_exc', re.compile(r'(?<!不)低于|不足|不到|(?<!不)少于|小于(?!或等于|等于)|<(?!=)')),\n   381\t    ('exact', re.compile(r'恰为|恰好为|恰好|(?<![或大小])等于')),\n   382\t]\n   383\t\n   384\t\n   385\tdef _comparators(clause):\n   386\t    \"\"\"(start, end, kind) for every comparator word, the longest match winning where words overlap\n   387\t    (\"大于或等于\" is one lower-inclusive comparator, not also a \"大于\" and an \"等于\").\"\"\"\n   388\t    found = []\n   389\t    for kind, regex in COMPARATORS_RE:\n   390\t        for match in regex.finditer(clause):\n   391\t            found.append((match.start(), match.end(), kind))\n   392\t    found.sort(key=lambda m: (m[0], -(m[1] - m[0])))\n   393\t    kept = []\n   394\t    for start, end, kind in found:\n   395\t        if kept and start < kept[-1][1]:          # inside the previous, longer match\n   396\t            continue\n   397\t        kept.append((start, end, kind))\n   398\t    return kept\n   399\tPOSTFIX_LO = re.compile(r'\\s*(?:及以上|或以上|以上)')\n   400\tPOSTFIX_HI = re.compile(r'\\s*(?:及以下|以下|以内)')\n   401\tRANGE_SEP = re.compile(r'\\s*(?:至|到|~|–|—)\\s*(?:不足|低于)?\\s*')\n   402\t\n   403\t\n   404\tdef operative_clause(condition):\n   405\t    \"\"\"The part of a condition that states the bound: the first clause (split at ；or ，) that names a money amount,\n   406\t    joined with the clauses that continue it (且 / 并且 / 但 / 或 / 并); a dateline before it (\"截至2026-12-31，\") and a\n   407\t    remark after it (\"，处于公司指引区间\", \"；与公司所称…相符\") are dropped. Parenthesised asides are removed first.\"\"\"\n   408\t    text = re.sub(r'（[^）]*）|\\([^)]*\\)', '', condition)\n   409\t    clauses = [c for c in re.split(r'[；，;]', text) if c.strip()]\n   410\t    chosen = []\n   411\t    for clause in clauses:\n   412\t        if not chosen:\n   413\t            if _amounts(clause):\n   414\t                chosen.append(clause)\n   415\t        elif re.match(r'\\s*(?:且|并且|并|但|或)', clause):\n   416\t            chosen.append(clause)\n   417\t        else:\n   418\t            break\n   419\t    return ''.join(chosen)\n   420\t\n   421\t\n   422\tdef _amounts(text):\n   423\t    \"\"\"(start, end, value_usd) for every money amount in the clause: a number with a Chinese magnitude or followed\n   424\t    by 美元, or a bare zero (\"大于或等于0\", \"小于0\"). A bare non-zero number is not money (30%, 4吉瓦, 2025年).\"\"\"\n   425\t    out = []\n   426\t    for match in AMOUNT_TOKEN.finditer(text):\n   427\t        number, unit, dollars = match.group(1), match.group(2), match.group(3)\n   428\t        value = float(Decimal(number.replace(',', '')) * UNIT_USD[unit])\n   429\t        following = text[match.end():match.end() + 1]\n   430\t        if unit is None and dollars is None and (value != 0 or following not in ('', '且', '、', '，', '；', '）', ' ', '美', '至', '到')):\n   431\t            continue          # 30%, 0%, 4吉瓦, 1个百分点, 2025年: not money\n   432\t        out.append((match.start(), match.end(), value))\n   433\t    return out\n   434\t\n   435\t\n   436\tdef band(condition):\n   437\t    \"\"\"(lo, lo_inclusive, hi, hi_inclusive) in USD, open ends as ±inf, read from the comparator words and the amount\n   438\t    each binds to (\"不低于 1650 亿美元且不高于 1690 亿美元\"), a range (\"650亿美元至720亿美元（含两端）\", \"0至不足1000亿\"),\n   439\t    a postfix (\"9000亿美元及以上\") or an exact amount (\"恰为2500亿美元\"). Remarks after ；or ， and parenthesised\n   440\t    asides are not read. None when the condition names no amount or reads inconsistently.\"\"\"\n   441\t    clause = operative_clause(condition or '')\n   442\t    inclusive_ends = bool(re.search(r'含两端|含端|包含两端', condition or ''))\n   443\t    amounts = _amounts(clause)\n   444\t    lo, lo_inc, hi, hi_inc, found = -INF, False, INF, False, False\n   445\t\n   446\t    def next_amount(after):\n   447\t        for start, end, value in amounts:\n   448\t            if start >= after:\n   449\t                return start, end, value\n   450\t        return None\n   451\t\n   452\t    for start, end, kind in _comparators(clause):\n   453\t        hit = next_amount(end)\n   454\t        if not hit or hit[0] - end > 40:\n   455\t            continue\n   456\t        value = hit[2]\n   457\t        if kind == 'exact':\n   458\t            return (value, True, value, True)\n   459\t        if kind == 'lo_inc':\n   460\t            lo, lo_inc = value, True\n   461\t        elif kind == 'lo_exc':\n   462\t            lo, lo_inc = value, False\n   463\t        elif kind == 'hi_inc':\n   464\t            hi, hi_inc = value, True\n   465\t        else:\n   466\t            hi, hi_inc = value, False\n   467\t        found = True\n   468\t    for start, end, value in amounts:\n   469\t        tail = clause[end:]\n   470\t        if POSTFIX_LO.match(tail):\n   471\t            lo, lo_inc, found = value, True, True\n   472\t        elif POSTFIX_HI.match(tail):\n   473\t            hi, hi_inc, found = value, True, True\n   474\t        sep = RANGE_SEP.match(tail)\n   475\t        if sep:\n   476\t            partner = next_amount(end + sep.end())\n   477\t            if partner and partner[0] == end + sep.end() and partner[2] > value:\n   478\t                lo, lo_inc, hi, found = value, True, partner[2], True\n   479\t                hi_inc = inclusive_ends or not re.search(r'不足|低于', sep.group(0))\n   480\t    if not found:\n   481\t        return None\n   482\t    if lo > hi or (lo == hi and not (lo_inc and hi_inc)):\n   483\t        return None\n   484\t    return (lo, lo_inc, hi, hi_inc)\n   485\t\n   486\t\n   487\tdef numeric_bands(rungs):\n   488\t    \"\"\"Bands from the rungs' own numeric bounds (keyed views): lower bound inclusive, upper exclusive, the two ends open;\n   489\t    None when a rung has no bounds.\"\"\"\n   490\t    if not rungs or any(r.get('lo') is None and r.get('hi') is None for r in rungs):\n   491\t        return None\n   492\t    out = {}\n   493\t    for r in rungs:\n   494\t        lo = -INF if r.get('lo') is None else float(r['lo']); hi = INF if r.get('hi') is None else float(r['hi'])\n   495\t        out[r['position']] = (lo, True, hi, False)\n   496\t    return out\n   497\t\n   498\t\n   499\tdef ladder_bands(rungs):\n   500\t    \"\"\"Every rung's band, or None with the reason when the ladder is not one unbroken partition by amount. Rungs that\n   501\t    carry numeric bounds are read from them; the prose parser serves the views written before keys.\"\"\"\n   502\t    numeric = numeric_bands(rungs)\n   503\t    if numeric is not None:\n   504\t        ordered = sorted(numeric.items(), key=lambda pb: pb[1][0])\n   505\t        for (p1, a), (p2, b) in zip(ordered, ordered[1:]):\n   506\t            if a[2] != b[0]:\n   507\t                return None, f'numeric bands of positions {p1} and {p2} overlap or leave a gap'\n   508\t        return numeric, None\n   509\t    bands = [(r['position'], band(r['condition'])) for r in rungs]\n   510\t    unreadable = [p for p, b in bands if b is None]\n   511\t    if unreadable:\n   512\t        return None, f'conditions not read as amounts: positions {unreadable}'\n   513\t    ordered = sorted(bands, key=lambda pb: (pb[1][0], pb[1][2]))\n   514\t    for (p1, a), (p2, b) in zip(ordered, ordered[1:]):\n   515\t        if a[2] != b[0] or a[3] == b[1]:          # adjacent bands share the boundary amount and exactly one of them owns it\n   516\t            return None, f'bands of positions {p1} and {p2} overlap or leave a gap'\n   517\t    lowest, highest = ordered[0][1], ordered[-1][1]\n   518\t    if not (lowest[0] == -INF or (lowest[0] == 0 and lowest[1])) or highest[2] != INF:     # an amount that cannot be negative may start at 0\n   519\t        return None, 'the ladder does not cover the line up to +inf'\n   520\t    return dict(bands), None\n   521\t\n   522\t\n   523\tdef _contains(b, yi):\n   524\t    lo, lo_inc, hi, hi_inc = b\n   525\t    return (lo < yi or (lo == yi and lo_inc)) and (yi < hi or (yi == hi and hi_inc))\n   526\t\n   527\t\n   528\tdef verdict_for(comparator, judged, yi):\n   529\t    \"\"\"Whether every value in the judged band satisfies the claim (holds), none does (not_yet), or some do.\"\"\"\n   530\t    lo, lo_inc, hi, hi_inc = judged\n   531\t    all_at_least = lo > yi or (lo == yi)                       # every value >= yi (lo == yi exclusive gives values > yi)\n   532\t    all_below = hi < yi or (hi == yi and not hi_inc)\n   533\t    if comparator == '>=':\n   534\t        return 'holds' if all_at_least else 'not_yet' if all_below else 'borderline'\n   535\t    if comparator == '<':\n   536\t        return 'holds' if all_below else 'not_yet' if all_at_least else 'borderline'\n   537\t    if lo == hi == yi:\n   538\t        return 'holds'\n   539\t    return 'borderline' if _contains(judged, yi) else 'not_yet'\n   540\t\n   541\t\n   542\tdef evaluate(conn, view_id, comparator, value_usd, as_of=None):\n   543\t    \"\"\"A claim \"quantity >= / < / = value\" against the view's ladder as of the day: the rung the threshold sits in,\n   544\t    the judged rung, and whether every value of the judged band satisfies the claim (holds), none does (not_yet), or\n   545\t    only some do (borderline). Only a ladder whose rungs read as one unbroken partition by amount is evaluated.\"\"\"\n   546\t    as_of = resolve_bound(conn, as_of)\n   547\t    if comparator not in COMPARATORS:\n   548\t        raise ValueError(f'comparator must be one of {COMPARATORS}')\n   549\t    record = view(conn, view_id, as_of)\n   550\t    if not record:\n   551\t        return None\n   552\t    yi = float(value_usd)          # bands are in USD too\n   553\t    bands, problem = ladder_bands(record['rungs'])\n   554\t    if bands is None:\n   555\t        return {'view_id': view_id, 'as_of': as_of, 'evaluable': False, 'reason': problem}\n   556\t    claim_position = next((p for p, b in bands.items() if _contains(b, yi)), None)\n   557\t    state = record['state']\n   558\t    if not state:\n   559\t        return {'view_id': view_id, 'as_of': as_of, 'evaluable': True, 'comparator': comparator, 'value_usd': value_usd, 'claim_position': claim_position, 'judged_position': None, 'verdict': 'not_judged'}\n   560\t    return {'view_id': view_id, 'as_of': as_of, 'evaluable': True, 'comparator': comparator, 'value_usd': value_usd,\n   561\t            'claim_position': claim_position, 'judged_position': state['position'], 'judged_label': state['label'], 'judged_condition': state['condition'],\n   562\t            'verdict': verdict_for(comparator, bands[state['position']], yi)}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_14","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba src/hivemind/views/store.py | sed -n '88,115p;155,174p'; nl -ba docs/research/2026-10-25-english/data-manifest.md | head -26; nl -ba scripts/mock_build.py; nl -ba poc/ui/prepare-data.mjs; ls web; rg --files | rg 'nginx|Dockerfile|mock_data|verify-page|service-worker'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba src/hivemind/views/store.py | sed -n '88,115p;155,174p'; nl -ba docs/research/2026-10-25-english/data-manifest.md | head -26; nl -ba scripts/mock_build.py; nl -ba poc/ui/prepare-data.mjs; ls web; rg --files | rg 'nginx|Dockerfile|mock_data|verify-page|service-worker'\"","aggregated_output":"    88\t    insert(conn, 'view_switches', view_id=view_id, open=1, reason='created', by_whom='matching', after_seq=seq)\n    89\t    conn.execute('insert into views_fts (view_id, text) values (?, ?)', (view_id, f'{object_id} {looks_at} {question}'))\n    90\t\n    91\t\n    92\tdef view(conn, view_id):\n    93\t    row = conn.execute('select * from views where view_id=?', (view_id,)).fetchone()\n    94\t    return dict(row) if row else None\n    95\t\n    96\t\n    97\tdef rungs_of(conn, view_id):\n    98\t    \"\"\"The rungs with their bounds when the ledger has them (keyed views); a ledger written before keys has no lo/hi columns.\"\"\"\n    99\t    rows = [dict(r) for r in conn.execute('select * from rungs where view_id=? order by position', (view_id,))]\n   100\t    has_bounds = any(r.get('lo') is not None or r.get('hi') is not None for r in rows) or view_key(conn, view_id) is not None\n   101\t    return [dict(position=r['position'], label=r['label'], condition=r['condition'],\n   102\t                 **({'lo': r.get('lo'), 'hi': r.get('hi')} if has_bounds else {})) for r in rows]\n   103\t\n   104\t\n   105\tdef add_key(conn, view_id, key, seq):\n   106\t    \"\"\"The view's key (keyed-views-plan.md 2.1), written once with the view.\"\"\"\n   107\t    from .. import universe as _universe\n   108\t    from .identity import is_shared\n   109\t    scope_source = 'shared' if is_shared(key) else key.get('scope_source', 'model')      # D197: an aggregate's scope is wording\n   110\t    insert(conn, 'view_keys', view_id=view_id, measure=key['measure'], scope=key.get('scope', ''), scope_key=_universe.scope_key(key.get('scope', '')),\n   111\t           period_start=key.get('period_start', ''), period_end=key.get('period_end', ''), basis=key.get('basis', 'n/a'), unit=key.get('unit', 'n/a'),\n   112\t           event_type=key.get('event_type', 'n/a'), seq=seq, scope_source=scope_source, key_version=key.get('key_version'))\n   113\t\n   114\t\n   115\tdef ensure_key_columns(conn):\n   155\t    if 'kind' not in {r[1] for r in conn.execute('pragma table_info(dependencies)')}:\n   156\t        conn.execute(\"alter table dependencies add column kind text default ''\")   # D694: every row written before reads ''\n   157\t\n   158\t\n   159\tdef view_key(conn, view_id):\n   160\t    if not conn.execute('pragma table_info(view_keys)').fetchone():\n   161\t        return None\n   162\t    row = conn.execute('select * from view_keys where view_id=?', (view_id,)).fetchone()\n   163\t    if not row:\n   164\t        return None\n   165\t    key = dict(row)\n   166\t    if not key.get('scope_source'):\n   167\t        key['scope_source'] = 'none' if not key['scope'] else 'model'\n   168\t    return key\n   169\t\n   170\t\n   171\tdef open_views_with_key(conn, object_id, measure, scope_key, period_start, period_end, basis='n/a', unit='n/a', event_type=None):\n   172\t    \"\"\"Open views of the object with the same measure, scope and unit whose period overlaps: the ones a candidate must\n   173\t    be confirmed against before it may open (keyed-views-plan.md 2.5). A basis or unit of n/a on either side matches\n   174\t    any; GAAP and non-GAAP are two quantities, and so are a level in USD and a growth rate in percent.\"\"\"\n     1\t# Data manifest, 2026-10-25 close-out\n     2\t\n     3\tThe ledgers, model-call archives and traces of this phase stay on disk under `poc/data/` (git-ignored, 727 MB) and in one backup outside the repository. Nothing here was deleted at the close-out. Checksums are the first 16 hex digits of SHA-256, taken on 2026-10-25 after the last run.\n     4\t\n     5\tBackup: `~/hivemind-backups/poc-data-2026-10-25.tar.gz` (158 MB, 273 files, the whole `poc/data/` tree), SHA-256 `a346bb8d460444f05a06973ef54717c97151fb0e521e0c1c4bcd0dd200ddf2c1`.\n     6\tSecond backup: `~/hivemind-backups/poc-reports-ignored-2026-10-25.tar.gz` (5385 files: the git-ignored trace pages and recall-oracle archives under `poc/reports/`), SHA-256 `bc5191711280bb9e42a398edf05bc9dcbae07611d2c5615639367fe800b42fa5`.\n     7\t\n     8\t## Input\n     9\t\n    10\t| file | what it is | SHA-256 |\n    11\t|---|---|---|\n    12\t| `poc/data/items-window-tags2-2026-10-24.sqlite` | the item window every English run replays (2026-02-25 to 2026-08-15) | 02791fd2b1b3d6ab |\n    13\t\n    14\t## The measured ledgers (build log rows 43–49)\n    15\t\n    16\tEach folder holds `views.sqlite` (the ledger), `archive.sqlite` (every model and Jev call, request and answer), the run logs, and for the two D167 arms a week snapshot (`views.week.sqlite`, `archive.week.sqlite`) taken before August.\n    17\t\n    18\t| folder | configuration | window | role | views | archive |\n    19\t|---|---|---|---|---|---|\n    20\t| `english-v23-jev-2026-10-25` | `poc-v23` (extraction v10, Jev matching) | seed, week, Aug 1–15 | D167 arm; the default engine from D169 | f6ba83ffa79caafc | bc3e769937323819 |\n    21\t| `english-v23-llm-2026-10-25` | `poc-v23-llm` (extraction v10, generative matching) | seed, week, Aug 1–15 | D167 control arm | a1ee44f68a179705 | d629f8df6b308a39 |\n    22\t| `english-groups4-2026-10-25` | `poc-v21` | seed, week | control of the first Jev benchmark (row 41) | fe11a3bf86342f2c | 5b5042a5e5140125 |\n    23\t| `english-jev2-2026-10-25` | `poc-v22` | seed, week | Jev arm of the first benchmark (row 41) | cfe09822456e9cd7 | 5bab7f8d33740f3f |\n    24\t| `english-jev3-2026-10-25` | `poc-v22`, fixed engine | seed | engine replicate (row 37) | c460b6797a475645 | 406654ab0aeffed2 |\n    25\t| `english-jev-2026-10-25` | `poc-v22`, first criteria | seed | first Jev seed (row 35) | c589e2304f3d3e9e | c7a462e4e4e129ad |\n    26\t| `english-2026-10-25` | `poc-v17`–`v20` | seed, week, part of August | the English library build (rows 1–33) | — | 8bec7d710f0259ea |\n     1\t\"\"\"Validate data and bundle the modular Thesis UI into the portable mock HTML.\n     2\t\n     3\tInstall build dependencies once with ``npm ci --prefix poc/ui``. No model or network\n     4\tcalls are made by this build. Existing source data and translation caches are not changed.\n     5\t\"\"\"\n     6\timport argparse\n     7\timport json\n     8\tfrom pathlib import Path\n     9\timport subprocess\n    10\timport sys\n    11\t\n    12\tROOT = Path(__file__).resolve().parents[1]\n    13\tsys.path.insert(0, str(ROOT / 'src'))\n    14\tfrom hivemind import bundle, service  # noqa: E402\n    15\tfrom hivemind.views import store  # noqa: E402\n    16\t\n    17\t\n    18\tdef main():\n    19\t    parser = argparse.ArgumentParser(description=__doc__)\n    20\t    parser.add_argument('--data', type=Path, help='explicit legacy JSON export; otherwise read the current ledger')\n    21\t    parser.add_argument('--ledger', type=Path, default=ROOT / 'poc/data/served-2026-10-28-v34-nvda-3m-through-0828/views.sqlite')\n    22\t    parser.add_argument('--items', type=Path, default=ROOT / 'poc/data/items-nvda-2026-07-01-10-27.sqlite')\n    23\t    parser.add_argument('--out', type=Path, default=ROOT / 'poc/mock/index.html')\n    24\t    parser.add_argument('--composite-trials', type=Path, help='explicit JSON trial baskets for the Idea score preview')\n    25\t    parser.add_argument('--market-data', type=Path, default=ROOT / 'poc/ui/data/nvda-2026-10-27.json', help='dated real stock-price snapshot for the Action preview')\n    26\t    args = parser.parse_args()\n    27\t    if args.data:\n    28\t        data = json.loads(args.data.read_text())\n    29\t    else:\n    30\t        conn, items = service.open_ledger(str(args.ledger)), store.open_read_only(str(args.items))\n    31\t        try:\n    32\t            data = bundle.library(conn, items)\n    33\t        finally:\n    34\t            conn.close()\n    35\t            items.close()\n    36\t    if args.data and not data.get('schema_version') and args.ledger.exists():\n    37\t        conn = service.open_ledger(str(args.ledger))\n    38\t        try:\n    39\t            data['sequence_days'] = service.seq_day_map(conn)\n    40\t        finally:\n    41\t            conn.close()\n    42\t    ui = ROOT / 'poc/ui'\n    43\t    bundled = subprocess.run(['node', str(ui / 'build.mjs'), '--json'], capture_output=True, text=True)\n    44\t    if bundled.returncode:\n    45\t        print('UI build failed. Install its pinned dependencies with: npm ci --prefix poc/ui', file=sys.stderr)\n    46\t        print(bundled.stderr, file=sys.stderr)\n    47\t        bundled.check_returncode()\n    48\t    built = json.loads(bundled.stdout)\n    49\t    prepared = subprocess.run(['node', str(ui / 'prepare-data.mjs')], input=json.dumps(data, ensure_ascii=False), capture_output=True, text=True)\n    50\t    if prepared.returncode:\n    51\t        print(prepared.stderr, file=sys.stderr)\n    52\t        prepared.check_returncode()\n    53\t    print(prepared.stderr.strip())\n    54\t    market = subprocess.run(['node', str(ui / 'prepare-data.mjs'), '--market'], input=args.market_data.read_text(), capture_output=True, text=True)\n    55\t    if market.returncode:\n    56\t        print(market.stderr, file=sys.stderr)\n    57\t        market.check_returncode()\n    58\t    print(market.stderr.strip())\n    59\t    template = (ROOT / 'poc/mock/index.template.html').read_text()\n    60\t    page = template.replace('__STYLES__', built['style']).replace('__SCRIPT__', built['script'].replace('</script', '<\\\\/script'))\n    61\t    page = page.replace('__DATA__', prepared.stdout.replace('<', '\\\\u003c'))\n    62\t    page = page.replace('__MARKET_DATA__', market.stdout.replace('<', '\\\\u003c'))\n    63\t    trials = json.loads(args.composite_trials.read_text()) if args.composite_trials else []\n    64\t    page = page.replace('__COMPOSITE_TRIALS__', json.dumps(trials, ensure_ascii=False).replace('<', '\\\\u003c'))\n    65\t    output = args.out.resolve()\n    66\t    output.parent.mkdir(parents=True, exist_ok=True)\n    67\t    temporary = output.with_suffix(output.suffix + '.tmp')\n    68\t    temporary.write_text(page)\n    69\t    temporary.replace(output)\n    70\t    print(f'UI: {len(built[\"script\"].encode()):,} JS bytes; wrote {output} ({len(page.encode()):,} bytes)')\n    71\t\n    72\t\n    73\tif __name__ == '__main__':\n    74\t    main()\n     1\timport fs from 'node:fs';\n     2\timport { performance } from 'node:perf_hooks';\n     3\timport { fromBundles } from './src/adapters/bundle.js';\n     4\timport { parseDataset } from './src/model/contract.js';\n     5\timport { readMarketSnapshot } from './src/model/market.js';\n     6\t\n     7\tconst source = JSON.parse(fs.readFileSync(0, 'utf8'));\n     8\tconst start = performance.now();\n     9\tconst market = process.argv.includes('--market');\n    10\tconst dataset = market\n    11\t  ? readMarketSnapshot(source)\n    12\t  : source.schema_version\n    13\t    ? parseDataset(source)\n    14\t    : fromBundles(source);\n    15\tprocess.stderr.write(\n    16\t  `Validated ${market ? `${dataset.hourly.length + dataset.daily.length} price observations` : `${dataset.theses.length} theses`} in ${(performance.now() - start).toFixed(1)}ms\\n`,\n    17\t);\n    18\tprocess.stdout.write(JSON.stringify(dataset));\ndesign-system\nhivemind-logo.svg\nDockerfile\nDockerfile.mcp\nscripts/mock_data.py\npoc/ui/verify-page.mjs\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_15","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"rg -n 'EVENT_MEASURES|MEASURES' src/hivemind/views/identity.py; nl -ba src/hivemind/search.py | tail -60; nl -ba src/hivemind/idea.py | sed -n '116,175p;221,395p'; rg -n 'compositeTrials|composite_trials|COMPOSITE_TRIALS|localStorage|sessionStorage' poc/ui/src poc/mock/index.template.html\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"rg -n 'EVENT_MEASURES|MEASURES' src/hivemind/views/identity.py; nl -ba src/hivemind/search.py | tail -60; nl -ba src/hivemind/idea.py | sed -n '116,175p;221,395p'; rg -n 'compositeTrials|composite_trials|COMPOSITE_TRIALS|localStorage|sessionStorage' poc/ui/src poc/mock/index.template.html\"","aggregated_output":"10:EVENT_MEASURES = ('event', 'policy_event')\n15:    return value.get('measure') not in (None, 'other', *EVENT_MEASURES) and (value.get('scope_source') == 'shared' or value.get('opens_as') in SHARED_REASONS)\n29:    if value['measure'] in EVENT_MEASURES and value.get('event_type') in (None, 'other', 'n/a'):\n55:    if key['measure'] != candidate['measure'] and not (key['measure'] in EVENT_MEASURES and candidate['measure'] in EVENT_MEASURES):\n69:    if key['measure'] in EVENT_MEASURES:\n   245\t    return out[:limit]\n   246\t\n   247\t\n   248\tdef search(ledger, index, query, k=10, as_of=None, include_closed=False, embed=openai_embeddings, embedding_model=EMBEDDING_MODEL, aliases=None, semantic=True):\n   249\t    \"\"\"Top-k views for a query as of a day: cosine similarity on the view text, plus a small boost when the query\n   250\t    names the view's object and when the ledger's trigram index also matches. The ranking is 'semantic' only when\n   251\t    semantic ranking is allowed, every candidate has a usable vector made from its current text and the query could\n   252\t    be embedded; otherwise it is 'lexical' (the trigram index's own order), and the answer says so and names the\n   253\t    views without a fresh vector. `semantic=False` (a front started with --lexical) never calls the embedder.\n   254\t    `results` is null when the library holds no view on anything the idea names as of that day (D91): no company\n   255\t    or theme of the universe is named in it and the ledger's own text index matches no view; otherwise the ranked\n   256\t    list comes back whole and the caller judges which views correspond (D76).\"\"\"\n   257\t    as_of = service.resolve_bound(ledger, as_of)\n   258\t    candidates = service.summaries(ledger, as_of, include_closed)\n   259\t    if not candidates:\n   260\t        return {'query': query, 'as_of': as_of, 'mode': 'semantic' if semantic else 'lexical', 'missing_vectors': [], 'results': None}\n   261\t    mentioned = objects_in(query, aliases or {})\n   262\t    corpus = service.summaries(ledger, as_of, include_closed=True)                              # every view visible at the bound\n   263\t    lexical_order = visible_lexical_order(corpus, ' '.join(lexical_terms(query)), 50)           # trigram ranking over those only, best first\n   264\t    lexical_rank = {view_id: i for i, view_id in enumerate(lexical_order)}\n   265\t    vectors = fresh_vectors(ledger, index, embedding_model, [record['view_id'] for record in candidates]) if semantic else {}\n   266\t    missing = [record['view_id'] for record in candidates if record['view_id'] not in vectors]\n   267\t    mode, q = 'semantic', None\n   268\t    if not semantic or missing:\n   269\t        mode = 'lexical'\n   270\t    else:\n   271\t        try:\n   272\t            q, _ = query_vector(index, query, embed, embedding_model)\n   273\t        except (model.TransportError, OSError):\n   274\t            mode = 'lexical'\n   275\t    results = []\n   276\t    for record in candidates:\n   277\t        semantic = cosine(q, vectors[record['view_id']]) if q is not None else 0.0\n   278\t        object_hit = record['object'] in mentioned\n   279\t        text_hit = record['view_id'] in lexical_rank\n   280\t        # with embeddings a text hit is a small nudge; without them the trigram index's own order is the ranking\n   281\t        text_score = (TEXT_BOOST if mode == 'semantic' else 1.0 - lexical_rank[record['view_id']] / max(1, len(lexical_order))) if text_hit else 0.0\n   282\t        score = semantic + (OBJECT_BOOST if object_hit else 0.0) + text_score\n   283\t        results.append({'view_id': record['view_id'], 'object': record['object'], 'kind': record['kind'], 'looks_at': record['looks_at'], 'question': record['question'],\n   284\t                        'due_day': record['due_day'], 'open': record['open'], 'dependencies': record['dependencies'], 'dependants': record['dependants'],\n   285\t                        'score': round(score, 4), 'parts': {'semantic': round(semantic, 4), 'object_hit': object_hit, 'text_hit': text_hit}})\n   286\t    results.sort(key=lambda r: -r['score'])\n   287\t    named_or_matched = any(r['parts']['object_hit'] or r['parts']['text_hit'] for r in results)\n   288\t    best = max((r['parts']['semantic'] for r in results), default=0.0)\n   289\t    if not named_or_matched and (q is None or best < NULL_FLOOR):\n   290\t        return {'query': query, 'as_of': as_of, 'mode': mode, 'missing_vectors': missing, 'results': None}     # no recorded view on anything the idea names\n   291\t    return {'query': query, 'as_of': as_of, 'mode': mode, 'missing_vectors': missing, 'results': results[:k]}\n   292\t\n   293\t\n   294\tdef fake_embed(texts, embedding_model=EMBEDDING_MODEL, dims=256):\n   295\t    \"\"\"A deterministic stand-in for tests: a bag of character bigrams hashed into a fixed number of dimensions, so\n   296\t    texts sharing words share directions. Never used for the real index.\"\"\"\n   297\t    out = []\n   298\t    for text in texts:\n   299\t        vector = [0.0] * dims\n   300\t        lowered = re.sub(r'\\s+', ' ', text.lower())\n   301\t        for i in range(len(lowered) - 1):\n   302\t            vector[int(hashlib.md5(lowered[i:i + 2].encode('utf-8')).hexdigest(), 16) % dims] += 1.0\n   303\t        out.append(vector)\n   304\t    return out, sum(len(t) for t in texts) // 4\n   116\t    return (f'Objects with open views as of {as_of} (object, kind, number of views): {covered}.'\n   117\t            + (f' Objects in the universe with no view yet: {\", \".join(missing)}.' if missing else ''))\n   118\t\n   119\t\n   120\tdef judged(ledger, view_id, as_of, detailed=False):\n   121\t    state = service.state_as_of(ledger, view_id, as_of)\n   122\t    if not state:\n   123\t        return None\n   124\t    rung = next((g for g in store.rungs_of(ledger, view_id) if g['position'] == state['position']), {})\n   125\t    result = {'position': state['position'], 'label': rung.get('label', '')}\n   126\t    if detailed:\n   127\t        result.update(condition=rung.get('condition', ''), day=state['judgement_day'], reasons=state['reasons'])\n   128\t    return result\n   129\t\n   130\t\n   131\tdef brief(ledger, results, as_of, detailed=False):\n   132\t    \"\"\"Candidate state at the requested date; analyst context is explicit and versioned by the caller.\"\"\"\n   133\t    as_of = service.resolve_bound(ledger, as_of)\n   134\t    records = []\n   135\t    for result in results:\n   136\t        record = {'view_id': result['view_id'], 'object': result['object'], 'looks_at': result['looks_at'],\n   137\t                  'judged': judged(ledger, result['view_id'], as_of, detailed)}\n   138\t        if detailed:\n   139\t            record['question'] = result['question']\n   140\t        records.append(record)\n   141\t    return records\n   142\t\n   143\t\n   144\tdef related_views(ledger, view_ids, as_of, exclude=()):\n   145\t    \"\"\"The given views' neighbours in the ledger's dependency graph, as of the day: what each depends on (upstream)\n   146\t    and what depends on it (downstream), with the judged position; `exclude` are views already on the card.\n   147\t    Deterministic and free; the model is not asked. The card follows the graph only from the views of the first\n   148\t    part, the thing the idea is about: from every mapped view it fanned out to 12 cards on a one-line idea.\"\"\"\n   149\t    as_of = service.resolve_bound(ledger, as_of)\n   150\t    out, seen = [], set(view_ids) | set(exclude)\n   151\t    for view_id in view_ids:\n   152\t        for dep in service.dependencies(ledger, view_id, as_of):\n   153\t            target = ledger.execute('select * from views where view_id=?', (dep['view_id'],)).fetchone()\n   154\t            if dep['view_id'] not in seen and target is not None and service.view_exists(ledger, target, as_of):\n   155\t                seen.add(dep['view_id'])\n   156\t                out.append({'view_id': dep['view_id'], 'via': view_id, 'relation': 'upstream', 'direction': dep['direction'], 'judged': judged(ledger, dep['view_id'], as_of)})\n   157\t        for other in service.dependants(ledger, view_id, as_of):\n   158\t            if other not in seen:\n   159\t                seen.add(other)\n   160\t                out.append({'view_id': other, 'via': view_id, 'relation': 'downstream', 'direction': None, 'judged': judged(ledger, other, as_of)})\n   161\t    return out\n   162\t\n   163\t\n   164\tdef service_direct(part, directs, looks_at):\n   165\t    \"\"\"The first part's direct view: among the views the model called direct, in the order the part's own search\n   166\t    ranked them, the first whose text carries the part's year (a fiscal year that covers the calendar year counts:\n   167\t    FY2027 for \"2026\"); a part that names no year takes the first. The model's label picks the quantity, the year\n   168\t    check and the search order keep the pick the same across samples. Until 2026-10-24 the rule took the top search\n   169\t    hit on object and year alone and overrode the model's label in 4 of 31 picks (TSMC capex → TSMC revenue, Meta\n   170\t    capex → total expenses, NVIDIA total revenue → a segment, Rubin revenue → total revenue); there is no object\n   171\t    test, because a theme's view (TSMC capex under supply-chain-shift) is a company part's direct view.\"\"\"\n   172\t    years = {y.upper().replace(' ', '') for y in YEAR.findall(part.get('period', '') + ' ' + part.get('looks_for', ''))}\n   173\t    covered = set(years)\n   174\t    for y in list(years):\n   175\t        if y.isdigit():\n   221\t    view's bundle, the days, the trace of searches, and all call costs. No recorded view → no model call.\"\"\"\n   222\t    text = (text or '').strip()\n   223\t    if not text:\n   224\t        raise ValueError('an idea needs text')\n   225\t    as_of = service.resolve_bound(ledger, as_of)\n   226\t    report = on_progress or (lambda stage: None)\n   227\t    report('search')\n   228\t    found = search.search(ledger, index, text, k, as_of, aliases=aliases, semantic=semantic, embed=embed)\n   229\t    card = {'idea': {'text': text, 'as_of': as_of}, 'search': {'mode': found['mode'], 'candidates': [r['view_id'] for r in found['results'] or []]},\n   230\t            'reading': None, 'evaluation': None, 'related': [], 'views': [], 'days': bundle.days(ledger, as_of),\n   231\t            'no_recorded_view': found['results'] is None, 'cost': dict(NO_COST)}\n   232\t    if found['results'] is None:\n   233\t        return card\n   234\t    setting = cfg.idea\n   235\t    if setting is None:\n   236\t        raise config.ConfigError(f'config {cfg.version} has no idea setting')\n   237\t    decompose_prompt, map_prompt = prompts(setting)\n   238\t    started = time.time()\n   239\t    cost = dict(NO_COST)\n   240\t    cost['cached'] = True\n   241\t\n   242\t    def spend(answer):\n   243\t        cost['usd'] += answer.cost_usd\n   244\t        cost['input_tokens'] += answer.input_tokens\n   245\t        cost['output_tokens'] += answer.output_tokens\n   246\t        cost['turns'] += 1\n   247\t        cost['cached'] = cost['cached'] and answer.cached\n   248\t\n   249\t    # call 1: the parts\n   250\t    report('decompose')\n   251\t    user = f'Idea: {text}\\nDay: {as_of} (the library as judged on this day)\\n\\n{object_list(ledger, as_of, aliases)}'\n   252\t    made, slips = call_english(archive, cfg, setting, decompose_prompt, user, DECOMPOSE, 'idea_decompose', transport,\n   253\t                               lambda d: [f for p in d['parts'] for f in (p['looks_for'], p['period'])])\n   254\t    for answer in made:\n   255\t        spend(answer)\n   256\t    first = made[-1]\n   257\t    parts = [dict(p) for p in first.data['parts'][:MAX_PARTS]]\n   258\t    # the service: one search per part, the candidates each part got\n   259\t    report('retrieve')\n   260\t    detailed = setting.prompt_version == 'idea-v12'\n   261\t    idea_rows = brief(ledger, found['results'][:IDEA_ROWS], as_of, detailed)\n   262\t    trace, candidates, ranks = [], [], []\n   263\t    queries = [((part.get('query') or '').strip() or canonical_query(part, aliases), canonical_query(part, aliases)) for part in parts]\n   264\t    if semantic and found['mode'] == 'semantic':\n   265\t        search.warm_queries(index, [q for pair in queries for q in pair], embed)      # one embeddings round trip for every part instead of two per part\n   266\t    # a part's candidates: the service's canonical query and the model's own, interleaved (tried 2026-10-25 and dropped:\n   267\t    # the object's views ranked by the idea text alone lost the model's finds, gold direct right 17 → 15 of 19)\n   268\t    for i, (part, (query, own)) in enumerate(zip(parts, queries)):\n   269\t        hit = search.search(ledger, index, query, PER_PART, as_of, aliases=aliases, semantic=semantic, embed=embed)\n   270\t        steady = search.search(ledger, index, own, PER_PART, as_of, aliases=aliases, semantic=semantic, embed=embed) if own.lower() != query.lower() else hit\n   271\t        rows = brief(ledger, merged(steady['results'] or [], hit['results'] or [], PER_PART), as_of, detailed)\n   272\t        candidates.append(rows)\n   273\t        ranks.append({r['view_id']: n for n, r in enumerate(hit['results'] or [])})      # the part's own search order, the tie-break among the model's direct views\n   274\t        trace.append({'tool': 'search', 'part': i, 'query': query, 'canonical': own, 'returned': [r['view_id'] for r in rows]})\n   275\t    # call 2: the mapping\n   276\t    report('map')\n   277\t    map_schema, payload = CONTRACTS.get(setting.prompt_version, (MAP, full_payload))\n   278\t    user = payload(text, as_of, parts, candidates, idea_rows)\n   279\t    made, more = call_english(archive, cfg, setting, map_prompt, user, map_schema, 'idea_map', transport,\n   280\t                              lambda d: [d['summary'], *(p.get('why', '') for p in d['parts'])])\n   281\t    slips += more\n   282\t    for answer in made:\n   283\t        spend(answer)\n   284\t    second = made[-1]\n   285\t    # the service keeps the mapping honest: only candidates, in the parts' order; direct and driver views go on the\n   286\t    # canvas, context stays on the card; the first part's direct view is the service's own pick when the rule holds\n   287\t    idea_ids = {r['view_id'] for r in idea_rows}\n   288\t    looks_at = {r['view_id']: r['looks_at'] for rows in candidates + [idea_rows] for r in rows}\n   289\t    mapping = {m['index']: m for m in second.data['parts'] if isinstance(m.get('index'), int)}\n   290\t    parts_out, chosen, dropped, seen = [], [], [], set()\n   291\t    for i, part in enumerate(parts):\n   292\t        m = mapping.get(i, {'views': [], 'why': 'the mapping call did not answer this part'})\n   293\t        allowed = {r['view_id'] for r in candidates[i]} | idea_ids\n   294\t        market = bool(MARKET_READING.search(part.get('looks_for', '') or ''))\n   295\t        tiers = {'direct': [], 'driver': [], 'context': []}\n   296\t        directs = [v.get('view_id') for v in m.get('views') or [] if v.get('fit') == 'direct' and v.get('view_id') in allowed]\n   297\t        ordered = sorted(dict.fromkeys(directs), key=lambda v: (ranks[i].get(v, len(ranks[i])), directs.index(v)))\n   298\t        decided = service_direct(part, ordered, looks_at) if i == 0 and not market else None\n   299\t        if decided:\n   300\t            tiers['direct'].append(decided)\n   301\t        for v in m.get('views') or []:\n   302\t            view_id, fit = v.get('view_id'), v.get('fit', 'context')\n   303\t            if market:\n   304\t                dropped.append({'view_id': view_id, 'why': f'part {i} is a market reading ({part[\"looks_for\"][:50]}); the library holds no view on prices'})\n   305\t            elif view_id not in allowed:\n   306\t                dropped.append({'view_id': view_id, 'why': f'not among the candidates of part {i} ({part[\"looks_for\"][:60]})'})\n   307\t            elif all(view_id not in tiers[k] for k in tiers):\n   308\t                if fit == 'driver' and len(tiers['driver']) >= DRIVERS_PER_PART and not (\n   309\t                        cfg.idea_summary and cfg.idea_summary.prompt_version in ('idea-summary-v6', 'idea-summary-v7', 'idea-summary-v8')):\n   310\t                    tiers['context'].append(view_id)          # beyond the cap a driver is kept on the card, not the canvas\n   311\t                else:\n   312\t                    tiers[fit].append(view_id)\n   313\t        mapped = tiers['direct'] + tiers['driver']\n   314\t        parts_out.append({'index': i, 'object': part['object'], 'looks_for': part['looks_for'], 'period': part['period'], 'query': trace[i]['query'],\n   315\t                          'candidates': [r['view_id'] for r in candidates[i]], 'view_ids': mapped, 'direct': tiers['direct'], 'driver': tiers['driver'],\n   316\t                          'context': tiers['context'], 'service_direct': decided, 'market_reading': market,\n   317\t                          'clauses': {v['view_id']: v['clause'] for v in m.get('views') or [] if v.get('clause')},     # idea-v10: how each driver moves the part\n   318\t                          'why': 'a market reading: the library holds no view on prices' if market else m.get('why', '')})\n   319\t        for view_id in mapped:\n   320\t            if view_id not in seen:\n   321\t                seen.add(view_id)\n   322\t                chosen.append({'view_id': view_id, 'why': m.get('why', ''), 'part': part['looks_for'], 'fit': 'direct' if view_id in tiers['direct'] else 'driver'})\n   323\t    # the claim: the idea must state an amount; the claimed part must map to a view; the service evaluates\n   324\t    claim, evaluation = first.data['claim'], None\n   325\t    if claim is not None:\n   326\t        if not MONEY_IN_IDEA.search(text):\n   327\t            dropped.append({'view_id': None, 'why': 'the claim states an amount the idea does not'})\n   328\t            claim = None\n   329\t        elif not (0 <= claim['part'] < len(parts_out)):\n   330\t            dropped.append({'view_id': None, 'why': 'the claim names a part that does not exist'})\n   331\t        elif parts_out[claim['part']]['market_reading']:\n   332\t            dropped.append({'view_id': None, 'why': 'the claim is about a market price; the library holds no view on prices'})\n   333\t        elif not parts_out[claim['part']]['direct']:\n   334\t            dropped.append({'view_id': None, 'why': 'the claimed part has no direct view; a driver is not the quantity the idea names'})\n   335\t        else:\n   336\t            claim = dict(claim, view_id=parts_out[claim['part']]['direct'][0])\n   337\t            evaluation = service.evaluate(ledger, claim['view_id'], claim['comparator'], float(claim['value_usd']), as_of)\n   338\t    related = related_views(ledger, parts_out[0]['view_ids'] if parts_out else [], as_of, exclude=[c['view_id'] for c in chosen])\n   339\t    summary = second.data['summary']\n   340\t    composite = None\n   341\t    if cfg.idea_summary is not None:\n   342\t        report('summarize')\n   343\t        summary_setting = cfg.idea_summary\n   344\t        with open(config.prompt_path(summary_setting.prompt_version + '.txt'), encoding='utf-8') as handle:\n   345\t            summary_prompt = handle.read().strip()\n   346\t        records = {r['view_id']: r for r in service.summaries(ledger, as_of)}\n   347\t        context = {'idea': text, 'as_of': as_of, 'evaluation': evaluation,\n   348\t                   'parts': [{key: part[key] for key in ('object', 'looks_for', 'period', 'direct', 'driver', 'context', 'why')} for part in parts_out],\n   349\t                   'theses': brief(ledger, [records[c['view_id']] for c in chosen], as_of, detailed=True)}\n   350\t        composite_contract = idea_composite.contract(summary_setting.prompt_version, chosen, ledger)\n   351\t        if composite_contract:\n   352\t            context['theses'] = idea_composite.add_ladders(ledger, context['theses'], endpoints_only=summary_setting.prompt_version in ('idea-summary-v5', 'idea-summary-v6', 'idea-summary-v7', 'idea-summary-v8'))\n   353\t            for part in context['parts']:\n   354\t                del part['why']\n   355\t            if summary_setting.prompt_version in ('idea-summary-v7', 'idea-summary-v8'):\n   356\t                context['candidate_theses'] = context.pop('theses')\n   357\t        schema, prose, bind_composite = composite_contract or (SUMMARY, lambda d: [d['summary']], None)\n   358\t        made, more = call_english(archive, cfg, summary_setting, summary_prompt, json.dumps(context, ensure_ascii=False),\n   359\t                                  schema, 'idea_summary', transport, prose)\n   360\t        slips += more\n   361\t        for answer in made:\n   362\t            spend(answer)\n   363\t        summary = made[-1].data['summary']\n   364\t        if bind_composite:\n   365\t            composite = bind_composite(made[-1].data, chosen, records, as_of)\n   366\t            if composite['version'] == 'idea-composite/4':\n   367\t                mapped = {entry['view_id']: entry for entry in chosen}\n   368\t                chosen = [mapped[entry['thesis_id']] for entry in composite['drivers']]\n   369\t                adopted = {entry['view_id'] for entry in chosen}\n   370\t                for part in parts_out:\n   371\t                    for key in ('view_ids', 'direct', 'driver', 'context'):\n   372\t                        part[key] = [ident for ident in part[key] if ident in adopted]\n   373\t                    if part['service_direct'] not in adopted:\n   374\t                        part['service_direct'] = None\n   375\t                    part['clauses'] = {ident: clause for ident, clause in part['clauses'].items() if ident in adopted}\n   376\t                if claim and claim['view_id'] not in adopted:\n   377\t                    claim, evaluation = None, None\n   378\t                related = []\n   379\t    card['reading'] = {'summary': summary, 'parts': parts_out, 'chosen': chosen, 'claim': claim, 'dropped': dropped, 'trace': trace, 'language_slips': slips}\n   380\t    if composite is not None:\n   381\t        card['reading']['composite'] = composite\n   382\t    card['evaluation'] = evaluation\n   383\t    card['related'] = related\n   384\t    if bundles:        # a page that fetches /thesis-bundles itself asks for the card alone: 20 KB instead of 2.7 MB\n   385\t        item_of = bundle.item_lookup(items)\n   386\t        card['views'] = [bundle.view_bundle(ledger, item_of, view_id, as_of) for view_id in [c['view_id'] for c in chosen] + [r['view_id'] for r in related]]\n   387\t    cost['seconds'] = round(time.time() - started, 1)\n   388\t    card['cost'] = cost\n   389\t    return card\npoc/mock/index.template.html:28:<script id=\"composite-trials\" type=\"application/json\">__COMPOSITE_TRIALS__</script>\npoc/ui/src/bootstrap.js:28:    const compositeTrials = JSON.parse(\npoc/ui/src/bootstrap.js:209:            (next ? prepareCompositeTrial(compositeTrials, card, next) : null);\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_16","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"PYTHONPATH=src python3 -B -c 'import sqlite3,glob,collections\nfrom hivemind import service\nfrom hivemind.views import store, identity\nfor f in sorted(glob.glob('\\\\''poc/data/comparison-2026-11-17/run/old-?/prod/views.sqlite'\\\\''))+glob.glob('\\\\''poc/data/sealed-2026-10-24-run3-through-0815/views.sqlite'\\\\'')+glob.glob('\\\\''poc/data/english-v23-jev-2026-10-25/views.sqlite'\\\\''):\n c=sqlite3.connect('\\\\''file:'\\\\''+f+'\\\\''?mode=ro&immutable=1'\\\\'',uri=True);c.row_factory=sqlite3.Row\n cnt=collections.Counter(); labels=collections.Counter()\n print(f)\n for v in c.execute('\\\\''select * from views order by rowid'\\\\''):\n  i=v['\\\\''view_id'\\\\'']; r=store.rungs_of(c,i); k=store.view_key(c,i) or {}; labs=tuple(x['\\\\''label'\\\\''] for x in r); ls={l.lower().strip() for l in labs}; bands,error=service.ladder_bands(r)\n  event=k.get('\\\\''measure'\\\\'') in identity.EVENT_MEASURES\n  yn=len(labs)==2 and ls in ({'\\\\''yes'\\\\'','\\\\''no'\\\\''},{'\\\\''是'\\\\'','\\\\''否'\\\\''})\n  category='\\\\''event'\\\\'' if event else '\\\\''binary'\\\\'' if yn else '\\\\''amount'\\\\'' if bands else '\\\\''unhandled-key'\\\\'' if k else '\\\\''ambiguous'\\\\''\n  cnt[category]+=1;labels[labs]+=1\n  if f.find('\\\\''english-v23'\\\\'')\"'!=-1:\n   if i=='\"'\\\\''v37'\\\\'': print(i,k.get('\\\\''measure'\\\\''),r)\n  elif '\\\\''sealed'\\\\'' in f or category in ('\\\\''unhandled-key'\\\\'','\\\\''ambiguous'\\\\'') or event and (bands or len(labs)\"'!=2) or not event and yn or '\"'\\\\''old-1'\\\\'' in f:\n   print(i,category,k.get('\\\\''measure'\\\\''),'\\\\''/'\\\\''.join(labs),v['\\\\''question'\\\\''])\n print(cnt,labels)'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"PYTHONPATH=src python3 -B -c 'import sqlite3,glob,collections\nfrom hivemind import service\nfrom hivemind.views import store, identity\nfor f in sorted(glob.glob('\\\\''poc/data/comparison-2026-11-17/run/old-?/prod/views.sqlite'\\\\''))+glob.glob('\\\\''poc/data/sealed-2026-10-24-run3-through-0815/views.sqlite'\\\\'')+glob.glob('\\\\''poc/data/english-v23-jev-2026-10-25/views.sqlite'\\\\''):\n c=sqlite3.connect('\\\\''file:'\\\\''+f+'\\\\''?mode=ro&immutable=1'\\\\'',uri=True);c.row_factory=sqlite3.Row\n cnt=collections.Counter(); labels=collections.Counter()\n print(f)\n for v in c.execute('\\\\''select * from views order by rowid'\\\\''):\n  i=v['\\\\''view_id'\\\\'']; r=store.rungs_of(c,i); k=store.view_key(c,i) or {}; labs=tuple(x['\\\\''label'\\\\''] for x in r); ls={l.lower().strip() for l in labs}; bands,error=service.ladder_bands(r)\n  event=k.get('\\\\''measure'\\\\'') in identity.EVENT_MEASURES\n  yn=len(labs)==2 and ls in ({'\\\\''yes'\\\\'','\\\\''no'\\\\''},{'\\\\''是'\\\\'','\\\\''否'\\\\''})\n  category='\\\\''event'\\\\'' if event else '\\\\''binary'\\\\'' if yn else '\\\\''amount'\\\\'' if bands else '\\\\''unhandled-key'\\\\'' if k else '\\\\''ambiguous'\\\\''\n  cnt[category]+=1;labels[labs]+=1\n  if f.find('\\\\''english-v23'\\\\'')\"'!=-1:\n   if i=='\"'\\\\''v37'\\\\'': print(i,k.get('\\\\''measure'\\\\''),r)\n  elif '\\\\''sealed'\\\\'' in f or category in ('\\\\''unhandled-key'\\\\'','\\\\''ambiguous'\\\\'') or event and (bands or len(labs)\"'!=2) or not event and yn or '\"'\\\\''old-1'\\\\'' in f:\n   print(i,category,k.get('\\\\''measure'\\\\''),'\\\\''/'\\\\''.join(labs),v['\\\\''question'\\\\''])\n print(cnt,labels)'\"","aggregated_output":"poc/data/comparison-2026-11-17/run/old-1/prod/views.sqlite\nv1 amount financing_amount Strongly bullish/Bullish/Neutral/Bearish/Strongly bearish How much credit support for AI clouds will NVIDIA have committed at the end of FY2027?\nv2 amount financing_amount Strongly bullish/Bullish/Neutral/Bearish/Strongly bearish What total amount of NVIDIA’s credit-support and capacity-purchase obligations will be outstanding at the FY2027 annual report?\nv3 event event Yes/No Will NVIDIA begin shipping its Rubin platform by December 31, 2026?\nv4 amount total_revenue Strongly bullish/Bullish/Neutral/Bearish/Strongly bearish What will NVIDIA's total revenue be in FY2027?\nv5 amount total_revenue Strongly bullish/Bullish/Neutral/Bearish/Strongly bearish What will NVIDIA's total revenue be in FY2028?\nv6 amount spend_total Below $500 billion/$500 billion to below $600 billion/$600 billion to below $700 billion/$700 billion to below $800 billion/$800 billion or more How much will the four largest AI hyperscalers spend on data center capital expenditures in calendar 2026?\nv7 amount spend_total Below $800 billion/$800 billion to below $900 billion/$900 billion to below $1.1 trillion/$1.1 trillion to below $1.2 trillion/$1.2 trillion or more How much will the four largest AI hyperscalers spend on data center capital expenditures in calendar 2027?\nv8 amount segment_revenue Strongly bullish/Bullish/Neutral/Bearish/Strongly bearish How much Data Center segment revenue will NVIDIA report for FY2027?\nv9 event policy_event No/Yes Will China authorize purchases of Nvidia H200 chips by AI companies by January 31, 2027?\nv10 event event Yes/No Will NVIDIA complete an investment in Firmus Technologies’ preference shares by December 31, 2026?\nv11 amount gross_margin Strongly bullish/Bullish/Neutral/Bearish/Strongly bearish What gross margin will NVIDIA report for FY2027?\nv12 event event Yes/No Will the French competition authority conclude its antitrust investigation into NVIDIA by January 31, 2027?\nv13 event event Yes/No Will NVIDIA begin shipping its Kyber NVL144 next-generation AI rack system by December 31, 2028?\nv14 amount financing_amount Strongly bullish/Bullish/Neutr