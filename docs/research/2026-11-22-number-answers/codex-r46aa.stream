gate.py:573:    rz3 = copy.deepcopy(rz2)                          # [46z.2] the declared $49.91B on the $50–75B rung: published at the recomputed $50B\ngate.py:575:    MANIFEST['R2z3'] = {'family': R2_FAMILY, 'calc': rz3}\ngate.py:577:    rows.append(('R2z3', not res3['errors'] and res3['published']['v29'][:2] == [50.0, 50.0], f'published {res3[\"published\"][\"v29\"]}', res3))\ngate.py:578:    rc = r1('c')                                      # [46z.2] both quarters declared 127.1; recomputed Data Center 127.25 above company 127.12\ngate.py:584:    item('R1canon', R1_FAMILY, R1_PASSAGES, rc, lambda r: (any(c == 'C3' and 'FY2027 Q4' in d for c, d in r['errors']), 'C3 on the recomputed values'), '')\ngate-run23.txt:63:        C4: altq3: a range summary must be an estimate with low and high that is an answer's outcome and feeds no figure (read by dcq3)\ngate-run23.txt:145:PASS  G4b    no C9: q22 on the published forecast\ngate-run23.txt:153:PASS  G4b2   C9: q22 on q01's superseded subtotal\ngate-run23.txt:156:PASS  R2z3   published [50.0, 50.0, None]\ngate-run23.txt:158:PASS  R1canon  C3 on the recomputed values\ncalc_check.py:243:def _evaluate_bounded(figs, refs, overrides):\ncalc_check.py:449:    # [46z.2] one recomputed result: every computed figure takes its recomputed value and bound for every later check and for publication\ncalc_check.py:450:    recomputed = _evaluate_bounded(figs, refs, {})\ncalc_check.py:492:        shown = _outcome_set(out)                         # [46y.2, 46z.2] the recomputed value for a computed outcome\ncalc_check.py:523:    # [46i.1] a range summary is an estimate with low and high, is an answer's outcome, and no figure reads it\ncalc_check.py:530:            errors.append(('C4', f'{f[\"id\"]}: a range summary must be an estimate with low and high that is an answer\\'s outcome and feeds no figure'\ncalc_check.py:600:        e_out = outcomes[rel['earlier']]                  # [46z.1] the published forecast, or the scenario paths its range summary rests on\ncalc_check.py:602:            by_scenario = {}\ncalc_check.py:605:                by_scenario.setdefault(figs[n].get('scenario', 'base'), []).append(n)\ncalc_check.py:607:            by_scenario = {figs[e_out].get('scenario', 'base'): [e_out]}\ncalc_check.py:613:            cands = by_scenario.get(sc) or (next(iter(by_scenario.values())) if len(by_scenario) == 1 else [])\ncalc_check.py:628:        if len(by_scenario) > 1 and later_scen != set(by_scenario):     # [46l.1] the later member covers the earlier's scenarios\ncalc_check.py:629:            errors.append(('C9', f'{rel[\"later\"]} covers scenarios {sorted(later_scen)} but {rel[\"earlier\"]} covers {sorted(by_scenario)}'))\ncalc_check.py:653:    published = {v: [finite(_outcome_set(figs[o])[0]), finite(_outcome_set(figs[o])[2]), figs[o].get('bound')] for v, o in outcomes.items()}\ncalc_check.py:654:    return {'errors': errors, 'recorded': recorded, 'published': published}\ncalc_check.py:849:            base_vals = _evaluate_bounded(figs, refs, {})                 # [46s, 46t.1] bounds carried through recomputation\ncalc_check.py:851:            alt_vals = _evaluate_bounded(figs, refs, {fig['id']: alt_override})\nsystem 4373 characters; user 121246 characters; schema 9626 characters\nevidence items 237; themes 9\nsource passages the answer cites that the rendered request does not show: none\nschema errors: none\ncalc_check errors: none\nrecorded: [{\"type\": \"bridge\", \"figure\": \"q4f\", \"bridge\": \"carry\", \"alternate\": \"undetermined\"}]\nsame-base family (calls 8729, 8732): Relations: v35 rests on v14's base.\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba calc_check.py | sed -n '229,282p;360,426p;465,532p;572,677p'; nl -ba gate.py | sed -n '541,613p'; ls gate-run23*\"","aggregated_output":"   229\t\n   230\tdef _crossings(base, alt, bands):\n   231\t    \"\"\"Band edges between two value sets, each with its own certainty: definite when one set lies wholly below the edge and the other\n   232\t    wholly at or above it; possible when the sets differ and the edge lies within their span.\"\"\"\n   233\t    edges = sorted({e for band in bands for e in band if e is not None})\n   234\t    definite = [e for e in edges if (_below(base, e) and _at_or_above(alt, e)) or (_below(alt, e) and _at_or_above(base, e))]\n   235\t    span_lo, span_hi = min(base[0], alt[0]), max(base[2], alt[2])\n   236\t    possible = [e for e in edges if e not in definite and span_lo < e <= span_hi and base != alt]\n   237\t    return definite, possible\n   238\t\n   239\t\n   240\tSTRICT = {'>', '<'}\n   241\t\n   242\t\n   243\tdef _evaluate_bounded(figs, refs, overrides):\n   244\t    \"\"\"[46t.1] Recompute (interval, bound) for every figure, carrying open and closed bounds through the arithmetic.\"\"\"\n   245\t    values, order, done = {}, [], set()\n   246\t\n   247\t    def visit(fid):\n   248\t        if fid in done:\n   249\t            return\n   250\t        done.add(fid)\n   251\t        for r in refs(figs[fid]):\n   252\t            if r in figs:\n   253\t                visit(r)\n   254\t        order.append(fid)\n   255\t    for fid in figs:\n   256\t        visit(fid)\n   257\t    for fid in order:\n   258\t        fig = figs[fid]\n   259\t        if fid in overrides:\n   260\t            values[fid] = overrides[fid]\n   261\t        elif fig['kind'] == 'computed' and fig.get('operation') in OPERATIONS:\n   262\t            t_ids, t_signs = _terms(fig)\n   263\t            ins = [values[i] for i in t_ids]\n   264\t            interval = _compute(fig['operation'], [iv + (figs[i]['unit'],) for (iv, _), i in zip(ins, t_ids)], t_signs, fig['unit']) if ins else (0.0, 0.0)\n   265\t            pseudo = [{'bound': b} for _, b in ins]\n   266\t            side = _bound_direction(fig['operation'], pseudo, t_signs)\n   267\t            strict = any(b in STRICT for _, b in ins)\n   268\t            bound = {'lower': '>' if strict else '>=', 'upper': '<' if strict else '<=', 'two-sided': 'approx', 'mixed': 'mixed', None: None}[side]\n   269\t            values[fid] = (interval, bound)\n   270\t        else:\n   271\t            values[fid] = (_interval(fig), fig.get('bound'))\n   272\t    return values\n   273\t\n   274\t\n   275\tdef _set_from(interval, bound):\n   276\t    fig = {'low': interval[0], 'high': interval[1], 'bound': bound} if interval[0] != interval[1] else {'value': interval[0], 'bound': bound}\n   277\t    return _outcome_set(fig)\n   278\t\n   279\t\n   280\tdef _close(declared, expected, unit):\n   281\t    floor = 0.05 if unit == '%' else 0.1\n   282\t    return abs(declared - expected) <= max(0.005 * abs(expected), floor)\n   360\t            errors += _source_errors(fig, passages)\n   361\t        if fig['kind'] == 'prior' and not fig.get('pointer'):\n   362\t            errors.append(('C7', f'{fig[\"id\"]}: a prior forecast needs an exact pointer to an earlier answer shown in the request'))\n   363\t\n   364\t    # C2 arithmetic and bound propagation\n   365\t    for fig in figs.values():\n   366\t        if fig['kind'] != 'computed' or fig.get('operation') not in OPERATIONS:\n   367\t            continue\n   368\t        t_ids, t_signs = _terms(fig)\n   369\t        ins = [figs[i] for i in t_ids if i in figs]\n   370\t        expected = _compute(fig['operation'], [_interval(i) + (i['unit'],) for i in ins], t_signs, fig['unit']) if ins else (0.0, 0.0)   # [46x.2]\n   371\t        lo, hi = _interval(fig)\n   372\t        if not ins and (lo != 0 or hi != 0):              # [46y.2] an algebraic zero is exactly zero\n   373\t            errors.append(('C2', f'{fig[\"id\"]}: its operands cancel exactly, so it is 0, not {lo}–{hi}'))\n   374\t            continue\n   375\t        if fig['operation'] == 'range_from_relative' or ('low' in fig):\n   376\t            ok = _close(lo, expected[0], fig['unit']) and _close(hi, expected[1], fig['unit'])\n   377\t        else:\n   378\t            ok = _close(lo, (expected[0] + expected[1]) / 2, fig['unit'])\n   379\t        if not ok:\n   380\t            errors.append(('C2', f'{fig[\"id\"]}: declared {lo}–{hi} but {fig[\"operation\"]} of {fig[\"inputs\"]} gives {expected[0]:.2f}–{expected[1]:.2f}'))\n   381\t        want = _bound_direction(fig['operation'], ins, t_signs)\n   382\t        have = DIRECTION.get(fig.get('bound'))\n   383\t        if want == 'mixed':\n   384\t            errors.append(('C2', f'{fig[\"id\"]}: its inputs are bounded on opposite sides, so its value is unbounded; state it as an estimate'))\n   385\t        elif want is not None and have != want:\n   386\t            errors.append(('C2', f'{fig[\"id\"]}: its inputs make it a {want} bound, but it is declared {fig.get(\"bound\") or \"a point\"}'))\n   387\t        elif want is None and fig.get('bound'):\n   388\t            errors.append(('C2', f'{fig[\"id\"]}: its inputs are points, but it is declared a bound ({fig[\"bound\"]})'))\n   389\t\n   390\t    # C8 operand compatibility\n   391\t    for fig in figs.values():\n   392\t        if fig['kind'] != 'computed' or fig.get('operation') not in OPERATIONS:\n   393\t            continue\n   394\t        ins = [figs[i] for i in fig['inputs'] if i in figs]\n   395\t        op, rel, out = fig['operation'], fig.get('relation'), fig['what']\n   396\t        differing = [i['id'] for i in ins if i['unit'] not in ('%', 'x') and\n   397\t                     (i['what']['population'], i['what']['scope'], i['what']['period'], i['what']['measure']) !=\n   398\t                     (out['population'], out['scope'], out['period'], out['measure'])]\n   399\t        if op in ('sum', 'difference'):\n   400\t            money = [i for i in ins if i['unit'] not in ('%', 'x')]\n   401\t            same_qty = all((i['what']['population'], i['what']['measure'], i['what']['scope']) ==\n   402\t                           (out['population'], out['measure'], out['scope']) for i in money)\n   403\t            if rel == 'time_aggregation':\n   404\t                qs = [_quarters(i['what']['period']) for i in money]\n   405\t                q_out = _quarters(out['period'])\n   406\t                union = set().union(*[q[1] for q in qs]) if all(qs) else None\n   407\t                disjoint = all(qs) and sum(len(q[1]) for q in qs) == len(union or ())\n   408\t                if not (same_qty and q_out and all(qs) and disjoint and union == q_out[1] and all(q[0] == q_out[0] for q in qs)):\n   409\t                    errors.append(('C8', f'{fig[\"id\"]}: time aggregation needs one quantity over disjoint periods forming {out[\"period\"]}'))\n   410\t            elif rel in ('overlap_unknown', 'stated_in_addition'):\n   411\t                if rel == 'overlap_unknown' and fig.get('disputed') not in fig['inputs']:\n   412\t                    errors.append(('C8', f'{fig[\"id\"]}: overlap_unknown must name a disputed operand among its inputs'))\n   413\t            elif rel == 'accounting_parts':\n   414\t                wholes = {(r['whole_scope'], tuple(r['part_scopes'])) for r in family.get('scope_parts', [])}\n   415\t                if not any(out['scope'] == w and all(i['what']['scope'] in p for i in money) for w, p in wholes):\n   416\t                    errors.append(('C8', f'{fig[\"id\"]}: accounting_parts needs a declared split of {out[\"scope\"]}'))\n   417\t            elif differing:\n   418\t                errors.append(('C8', f'{fig[\"id\"]}: {op} of different quantities or periods ({\", \".join(differing)}) states no relation'))\n   419\t        elif op == 'roll_forward':\n   420\t            opening = ins[0]['what']['period'] if ins else ''\n   421\t            if not (opening.startswith('as of') and all(not i['what']['period'].startswith('as of') for i in ins[1:])\n   422\t                    and out['period'].startswith(('as of', 'end of'))):\n   423\t                errors.append(('C8', f'{fig[\"id\"]}: roll_forward needs an opening balance as of a date, flows after it, and a closing balance'))\n   424\t            if rel == 'overlap_unknown' and fig.get('disputed') not in fig['inputs']:\n   425\t                errors.append(('C8', f'{fig[\"id\"]}: overlap_unknown must name a disputed operand among its inputs'))\n   426\t        elif op == 'share':\n   465\t    for view_id in members:\n   466\t        if seen.get(view_id, 0) != 1:\n   467\t            errors.append(('C7', f'{view_id} has {seen.get(view_id, 0)} answers; exactly one is required'))\n   468\t    for view_id in seen:\n   469\t        if view_id not in members:\n   470\t            errors.append(('C7', f'{view_id} is not a member of the family'))\n   471\t    outcomes = {}\n   472\t    for ans in calc['answers']:\n   473\t        member = members.get(ans['view_id'])\n   474\t        if member is None:\n   475\t            continue\n   476\t        if ans.get('shape') == 'unresolved':\n   477\t            if 'outcome' in ans or 'rung' in ans or not ans.get('why'):\n   478\t                errors.append(('C7', f'{ans[\"view_id\"]}: an unresolved answer has a reason and neither outcome nor rung'))\n   479\t            continue\n   480\t        out = figs.get(ans.get('outcome'))\n   481\t        if out is None:\n   482\t            errors.append(('C7', f'{ans[\"view_id\"]}: outcome {ans.get(\"outcome\")} is not a figure'))\n   483\t            continue\n   484\t        if _key(out['what']) != _key(member['what']):\n   485\t            errors.append(('C7', f'{ans[\"view_id\"]}: outcome {out[\"id\"]} measures {_key(out[\"what\"])}, not the question\\'s {_key(member[\"what\"])}'))\n   486\t        outcomes[ans['view_id']] = out['id']\n   487\t        rung = ans.get('rung')\n   488\t        if not isinstance(rung, int) or isinstance(rung, bool) or not 1 <= rung <= len(member['bands']):   # [46q] before any lookup\n   489\t            errors.append(('C6', f'{ans[\"view_id\"]}: rung {rung!r} is not one of 1..{len(member[\"bands\"])}'))\n   490\t            continue\n   491\t        band = member['bands'][rung - 1]\n   492\t        shown = _outcome_set(out)                         # [46y.2, 46z.2] the recomputed value for a computed outcome\n   493\t        if not _overlaps(shown, band):                    # [46r] open and closed ends kept\n   494\t            errors.append(('C6', f'{ans[\"view_id\"]}: rung {rung} ({band}) contains no part of its outcome {shown}'))\n   495\t        ref = ans.get('reference') or {}\n   496\t        if ('figure' in ref) == ('unavailable' in ref):          # [46g.2] exactly one choice\n   497\t            errors.append(('C5', f'{ans[\"view_id\"]}: the reference must name exactly one of a figure or unavailable'))\n   498\t        elif 'unavailable' in ref:\n   499\t            if not ref['unavailable']:\n   500\t                errors.append(('C5', f'{ans[\"view_id\"]}: an unavailable reference needs a reason'))\n   501\t        else:\n   502\t            errors += _reference_errors(ans['view_id'], figs.get(ref.get('figure')), figs, passages, refs)\n   503\t\n   504\t    # [46j.1] scenario membership derived from the estimates a figure rests on; related members cover the same scenarios\n   505\t    def scen(fid):\n   506\t        return figs[fid].get('scenario', 'base')\n   507\t\n   508\t    def derived(fid):\n   509\t        return {scen(g) for g in _upstream_of(fid, figs, refs) | {fid} if figs[g]['kind'] == 'estimate' and scen(g) != 'range'}\n   510\t    for f in figs.values():\n   511\t        sc = f.get('scenario', 'base')\n   512\t        if sc == 'range' or f['kind'] not in ('computed', 'estimate'):\n   513\t            continue\n   514\t        other = derived(f['id']) - {sc}\n   515\t        if other:\n   516\t            errors.append(('C4', f'{f[\"id\"]} ({sc}) rests on estimates of another scenario ({\", \".join(sorted(other))})'))\n   517\t    for rel in family.get('relations', []):\n   518\t        if rel['type'] == 'part_of' and rel['part'] in outcomes and rel['whole'] in outcomes:\n   519\t            sp, sw = derived(outcomes[rel['part']]), derived(outcomes[rel['whole']])\n   520\t            if sp != sw:\n   521\t                errors.append(('C4', f'{rel[\"part\"]} covers scenarios {sorted(sp)} but {rel[\"whole\"]} covers {sorted(sw)}; related members cover the same'))\n   522\t\n   523\t    # [46i.1] a range summary is an estimate with low and high, is an answer's outcome, and no figure reads it\n   524\t    outcome_ids = {a.get('outcome') for a in calc['answers']}\n   525\t    for f in figs.values():\n   526\t        if f.get('scenario') != 'range':\n   527\t            continue\n   528\t        readers = [g['id'] for g in figs.values() if f['id'] in refs(g)]\n   529\t        if f['kind'] != 'estimate' or 'low' not in f or 'high' not in f or f['id'] not in outcome_ids or readers:\n   530\t            errors.append(('C4', f'{f[\"id\"]}: a range summary must be an estimate with low and high that is an answer\\'s outcome and feeds no figure'\n   531\t                                 + (f' (read by {\", \".join(readers)})' if readers else '')))\n   532\t\n   572\t            per_scenario.setdefault(n.get('scenario', 'base'), []).append(n['id'])\n   573\t        if not nodes:\n   574\t            errors.append(('C4', f'{want}: no forecast node, though {\", \".join(touched)} depend on it'))\n   575\t        for sc, ids in sorted(per_scenario.items()):\n   576\t            if len(ids) != 1:\n   577\t                errors.append(('C4', f'{want} {sc}: {len(ids)} forecast nodes ({\", \".join(ids)}); exactly one per scenario is required'))\n   578\t        stop = {n['id'] for n in nodes}\n   579\t        for f in figs.values():                       # [46i.1] scenario membership is derived along the whole path, not declared\n   580\t            sc = f.get('scenario', 'base')\n   581\t            if sc == 'range' or f['kind'] not in ('computed', 'estimate'):\n   582\t                continue\n   583\t            upstream = _upstream_of(f['id'], figs, refs)\n   584\t            borrowed = sorted(r for r in upstream if r in stop and figs[r].get('scenario', 'base') != sc)\n   585\t            if borrowed:\n   586\t                errors.append(('C4', f'{want}: {f[\"id\"]} ({sc}) depends on {\", \".join(borrowed)} of another scenario'))\n   587\t        for view_id in touched:                      # [46g.3] a bypass reaches the quantity through no forecast node of any scenario\n   588\t            bypass = [f for f in reachable(outcomes[view_id], stop=stop) if f not in stop and _key(figs[f]['what']) == want]\n   589\t            if bypass:\n   590\t                errors.append(('C4', f'{want}: {view_id} reaches {\", \".join(sorted(bypass))} without passing a forecast node ({\", \".join(sorted(stop))})'))\n   591\t    for rel in family.get('relations', []):           # [46j.2] the later member rests on the earlier member's forecast nodes, per scenario\n   592\t        if rel['type'] != 'same_base' or rel['later'] not in outcomes or rel['earlier'] not in outcomes:\n   593\t            continue\n   594\t        base_key = _key(members[rel['earlier']]['what'])\n   595\t        earlier_graph = _upstream_of(outcomes[rel['earlier']], figs, refs) | {outcomes[rel['earlier']]}\n   596\t        earlier_nodes = {f for f in earlier_graph if _key(figs[f]['what']) == base_key and figs[f]['basis'] == 'forecast'}\n   597\t        reached = reachable(outcomes[rel['later']], stop=earlier_nodes)\n   598\t        bypass = [f for f in reached if f not in earlier_nodes and _key(figs[f]['what']) == base_key]\n   599\t        later_key = _key(members[rel['later']]['what'])\n   600\t        e_out = outcomes[rel['earlier']]                  # [46z.1] the published forecast, or the scenario paths its range summary rests on\n   601\t        if figs[e_out].get('scenario') == 'range':\n   602\t            by_scenario = {}\n   603\t            for n in sorted(r for r in figs[e_out].get('rests_on', []) if r in figs and _key(figs[r]['what']) == base_key\n   604\t                            and figs[r]['basis'] == 'forecast'):\n   605\t                by_scenario.setdefault(figs[n].get('scenario', 'base'), []).append(n)\n   606\t        else:\n   607\t            by_scenario = {figs[e_out].get('scenario', 'base'): [e_out]}\n   608\t        later_graph = _upstream_of(outcomes[rel['later']], figs, refs) | {outcomes[rel['later']]}\n   609\t        for f in sorted(later_graph):                 # [46k.1] every later scenario path reaches the earlier forecast of its own scenario\n   610\t            sc = figs[f].get('scenario', 'base')\n   611\t            if sc == 'range' or _key(figs[f]['what']) != later_key or figs[f]['basis'] != 'forecast':\n   612\t                continue\n   613\t            cands = by_scenario.get(sc) or (next(iter(by_scenario.values())) if len(by_scenario) == 1 else [])\n   614\t            used = [c for c in cands if c in _determining(f, figs)]\n   615\t            target = used[0] if used else None\n   616\t            if target is None:                            # [46l.1] through value-determining inputs only\n   617\t                errors.append(('C9', f'{f} ({sc}) of {rel[\"later\"]} is not computed from {rel[\"earlier\"]}\\'s {sc} forecast'))\n   618\t            else:                                     # [46o.1, 46p] its value moves when that forecast moves: one realisation per figure\n   619\t                mid_t = sum(_interval(figs[target])) / 2\n   620\t                before = _evaluate_points(figs, refs, {})[f]\n   621\t                after = _evaluate_points(figs, refs, {target: mid_t * 1.1})[f]\n   622\t                if abs(after - before) <= 1e-9 * max(1.0, abs(before)):\n   623\t                    errors.append(('C9', f'{f} ({sc}) of {rel[\"later\"]} does not change when {rel[\"earlier\"]}\\'s forecast {target} changes'))\n   624\t        later_scen = {figs[f].get('scenario', 'base') for f in later_graph if _key(figs[f]['what']) == later_key\n   625\t                      and figs[f]['basis'] == 'forecast' and figs[f].get('scenario', 'base') != 'range'}\n   626\t        if earlier_nodes and not later_scen:              # [46m.2] a citation never stands in for a calculation\n   627\t            errors.append(('C9', f'{rel[\"later\"]} has no calculation from {rel[\"earlier\"]}\\'s forecast, only a range resting on it'))\n   628\t        if len(by_scenario) > 1 and later_scen != set(by_scenario):     # [46l.1] the later member covers the earlier's scenarios\n   629\t            errors.append(('C9', f'{rel[\"later\"]} covers scenarios {sorted(later_scen)} but {rel[\"earlier\"]} covers {sorted(by_scenario)}'))\n   630\t        if not reached & earlier_nodes:\n   631\t            errors.append(('C9', f'{rel[\"later\"]} does not rest on {rel[\"earlier\"]}\\'s forecast ({\", \".join(sorted(earlier_nodes))})'))\n   632\t        if bypass:\n   633\t            errors.append(('C9', f'{rel[\"later\"]} reaches {\", \".join(sorted(bypass))} for {base_key} without {rel[\"earlier\"]}\\'s forecast'))\n   634\t    supplied = family.get('prior_answers', {})\n   635\t    for fig in figs.values():\n   636\t        earlier = fig['kind'] == 'prior' or fig.get('basis') == 'prior_forecast' or 'pointer' in fig   # [46i.2] derived, not labelled\n   637\t        if not earlier:\n   638\t            continue\n   639\t        if fig['kind'] != 'prior' or fig.get('basis') != 'prior_forecast':\n   640\t            errors.append(('C10', f'{fig[\"id\"]}: an earlier forecast must be kind prior with basis prior_forecast'))\n   641\t        ptr, ans_prior = fig.get('pointer', {}), supplied.get(fig.get('pointer', {}).get('view'), {})\n   642\t        if ans_prior.get('day') != ptr.get('day') or not any(_same(fig.get('value'), v) for v in ans_prior.get('values', [])):\n   643\t            errors.append(('C10', f'{fig[\"id\"]}: no earlier answer of {ptr.get(\"view\")} on {ptr.get(\"day\")} shown in the request states {fig.get(\"value\")}'))\n   644\t        owners = [a['view_id'] for a in calc['answers'] if a.get('outcome') == fig['id']]\n   645\t        if owners:                                    # [46h.2] nor the current outcome\n   646\t            errors.append(('C10', f'{fig[\"id\"]}: an earlier forecast cannot be the current outcome of {\", \".join(owners)}'))\n   647\t        users = [f['id'] for f in figs.values() if fig['id'] in refs(f)]\n   648\t        if users:\n   649\t            errors.append(('C10', f'{fig[\"id\"]}: an earlier forecast is for comparison only and cannot feed {\", \".join(users)}'))\n   650\t\n   651\t    recorded += _assumptions(family, figs, outcomes, calc, refs)\n   652\t    finite = lambda v: v if abs(v) != float('inf') else None\n   653\t    published = {v: [finite(_outcome_set(figs[o])[0]), finite(_outcome_set(figs[o])[2]), figs[o].get('bound')] for v, o in outcomes.items()}\n   654\t    return {'errors': errors, 'recorded': recorded, 'published': published}\n   655\t\n   656\t\n   657\tdef _per_unit(op, ins, fig):\n   658\t    \"\"\"The per-unit identity: ratio(total, price per unit) -> units, product(units, price per unit) -> total, for one population and\n   659\t    scope. Labels are the judge's; a reader checks them against the passages.\"\"\"\n   660\t    out = fig['what']\n   661\t    if len(ins) != 2:\n   662\t        return False\n   663\t    same = all((i['what']['population'], i['what']['scope']) == (out['population'], out['scope']) for i in ins)\n   664\t    price = [i for i in ins if i['what']['measure'] == 'price per unit' and i['unit'] in ('USD', 'USD bn')]\n   665\t    if op == 'ratio':\n   666\t        return same and len(price) == 1 and ins[1] is price[0] and out['measure'] == 'units' and ins[0]['unit'] in ('USD', 'USD bn')\n   667\t    units = [i for i in ins if i['what']['measure'] == 'units' and i['unit'] == 'units']\n   668\t    return same and len(price) == 1 and len(units) == 1 and fig['unit'] in ('USD', 'USD bn')\n   669\t\n   670\t\n   671\tdef changed(previous, answer, figs):\n   672\t    \"\"\"D728: whether a member's conclusion changed, derived by code from its earlier rung, outcome and source figures.\"\"\"\n   673\t    if previous is None:\n   674\t        return True, 'first judgement'\n   675\t    out = figs[answer['outcome']]\n   676\t    mid = sum(_interval(out)) / 2\n   677\t    refs = lambda f: list(f.get('inputs', [])) + [r for r in f.get('rests_on', []) if r in figs] + \\\n   541\t    ramb = r1('c')                                    # [46x.1] two Data Center Q4 forecasts: a starting estimate and an adjusted one\n   542\t    ramb['figures'] = [f for f in ramb['figures'] if f['id'] not in ('dcq4', 'dcfy')] + [\n   543\t        comp('dcq4', 'share', ['q4f', 'mix'], 117.6, 'USD bn', W('NVIDIA', 'revenue', DC, 'FY2027 Q4')),\n   544\t        est('dcq4b', 146.0, 'USD bn', W('NVIDIA', 'revenue', DC, 'FY2027 Q4'), 'reacceleration on top', ['dcq4', 'e976'], adjusts={'figure': 'dcq4', 'type': 'uplift'}),\n   545\t        comp('dcfy', 'sum', ['dch1', 'dcq3', 'dcq4b'], 415.0, 'USD bn', W('NVIDIA', 'revenue', DC, 'FY2027'), relation='time_aggregation')]\n   546\t    ramb['answers'][1]['rung'] = 2\n   547\t    item('R1amb', R1_FAMILY, R1_PASSAGES, ramb, lambda r: (any(c == 'C3' and 'FY2027 Q4' in d for c, d in r['errors']), 'C3: refused, deterministically'), '')\n   548\t    f4b, c4b = g4()                                   # [46y.1] q01's published forecast rests on its subtotal; q22 uses the published one\n   549\t    sub = next(f for f in c4b['figures'] if f['id'] == 'gfy')\n   550\t    sub['id'] = 'gfysub'\n   551\t    c4b['figures'].append(est('gfy', (400.0, 435.0), 'USD bn', W('NVIDIA', 'revenue', CO, 'FY2027'), 'the subtotal, held', ['gfysub']))\n   552\t    item('G4b', f4b, G_PASSAGES, c4b, lambda r: (not any(c == 'C9' for c, _ in r['errors']), 'no C9: q22 on the published forecast'), '')\n   553\t    rz = r2()                                         # [46y.2] x - x declared slightly off zero\n   554\t    rz['figures'] = [f for f in rz['figures'] if f['id'] not in ('talks', 'end')] + [\n   555\t        est('cm', 6.5, 'USD bn', W('NVIDIA', 'equity investment commitments', CO, 'rest of FY2027'), 'a commitment later reversed', bound='>'),\n   556\t        comp('rev', 'difference', ['cm', 'cm'], -0.09, 'USD bn', W('NVIDIA', 'equity investment commitments', CO, 'rest of FY2027')),\n   557\t        est('t35', 3.5, 'USD bn', W('NVIDIA', 'equity investment commitments', CO, 'rest of FY2027'), 'talks, risk-adjusted'),\n   558\t        comp('end', 'roll_forward', ['bal', 'add18', 'mtk', 't35', 'rev'], 49.91, 'USD bn', W('NVIDIA', 'equity investment commitments', CO, 'end of FY2027'),\n   559\t             relation='overlap_unknown', disputed='add18')]\n   560\t    rz['answers'][0]['rung'] = 2\n   561\t    item('R2z', R2_FAMILY, R2_PASSAGES, rz, lambda r: (any(c == 'C2' and 'rev' in d and 'exactly' in d for c, d in r['errors']), 'C2: zero is exact'), '')\n   562\t    rz2 = copy.deepcopy(rz)\n   563\t    next(f for f in rz2['figures'] if f['id'] == 'rev')['value'] = 0.0\n   564\t    item('R2z2', R2_FAMILY, R2_PASSAGES, rz2, lambda r: (any(c == 'C6' for c, _ in r['errors']), 'C6: placed by the recomputed $50B, not the declared $49.91B'), '')\n   565\t    f4b2, c4b2 = g4()                                 # [46z.1] q01 publishes an adjusted forecast; q22 still uses the old subtotal\n   566\t    sub2 = next(f for f in c4b2['figures'] if f['id'] == 'gfy')\n   567\t    sub2['id'] = 'gfysub'\n   568\t    c4b2['figures'].append(est('gfy', (430.0, 460.0), 'USD bn', W('NVIDIA', 'revenue', CO, 'FY2027'), 'the subtotal, adjusted up', ['gfysub'],\n   569\t                               adjusts={'figure': 'gfysub', 'type': 'uplift'}))\n   570\t    next(f for f in c4b2['figures'] if f['id'] == 'gfy28c')['inputs'] = ['gfysub', 'g41']\n   571\t    c4b2['answers'][0]['rung'] = 2\n   572\t    item('G4b2', f4b2, G_PASSAGES, c4b2, lambda r: (any(c == 'C9' for c, _ in r['errors']), \"C9: q22 on q01's superseded subtotal\"), '')\n   573\t    rz3 = copy.deepcopy(rz2)                          # [46z.2] the declared $49.91B on the $50–75B rung: published at the recomputed $50B\n   574\t    rz3['answers'][0]['rung'] = 3\n   575\t    MANIFEST['R2z3'] = {'family': R2_FAMILY, 'calc': rz3}\n   576\t    res3 = cc.check(R2_FAMILY, R2_PASSAGES, rz3)\n   577\t    rows.append(('R2z3', not res3['errors'] and res3['published']['v29'][:2] == [50.0, 50.0], f'published {res3[\"published\"][\"v29\"]}', res3))\n   578\t    rc = r1('c')                                      # [46z.2] both quarters declared 127.1; recomputed Data Center 127.25 above company 127.12\n   579\t    rc['figures'] = [f for f in rc['figures'] if f['id'] not in ('dcq4', 'dcfy')] + [\n   580\t        est('g21', 21.2, '%', W('NVIDIA', 'Data Center sequential growth', DC, 'FY2027 Q4'), 'reacceleration'),\n   581\t        est('dcbr', 1.0, 'x', W('NVIDIA', 'assumption', DC, 'FY2027 Q4'), 'Q3 carried into Q4 at the stated growth', converts=['dcq3']),\n   582\t        comp('dcq4', 'apply_growth', ['dcq3', 'g21'], 127.1, 'USD bn', W('NVIDIA', 'revenue', DC, 'FY2027 Q4'), bridge='dcbr'),\n   583\t        comp('dcfy', 'sum', ['dch1', 'dcq3', 'dcq4'], 396.1, 'USD bn', W('NVIDIA', 'revenue', DC, 'FY2027'), relation='time_aggregation')]\n   584\t    item('R1canon', R1_FAMILY, R1_PASSAGES, rc, lambda r: (any(c == 'C3' and 'FY2027 Q4' in d for c, d in r['errors']), 'C3 on the recomputed values'), '')\n   585\t    f4c, c4c = g4()                                   # [46m.2] the single-scenario calculation removed, q01 only cited\n   586\t    c4c['figures'] = [f for f in c4c['figures'] if f['id'] != 'gfy28c']\n   587\t    next(f for f in c4c['figures'] if f['id'] == 'gfy28')['rests_on'] = ['gfy', 'i256', 'i173']\n   588\t    item('G4c', f4c, G_PASSAGES, c4c, lambda r: (any(c == 'C9' and 'no calculation' in d for c, d in r['errors']), 'C9: a citation for a calculation'), '')\n   589\t    p3e = copy.deepcopy(p3a)\n   590\t    p3e['answers'][0]['outcome'] = 'pri'\n   591\t    p3e['answers'][0]['reference'] = {'figure': 'gc392'}\n   592\t    item('P3e', f1p, G_PASSAGES, p3e, lambda r: (any(c == 'C10' and 'current outcome' in d for c, d in r['errors']), 'C10: a prior as the outcome'), '')\n   593\t    p3d = copy.deepcopy(p3a)\n   594\t    p3d['answers'][0]['reference'] = {'figure': 'pri', 'unavailable': 'no consensus supplied'}\n   595\t    item('P3d', f1p, G_PASSAGES, p3d, lambda r: (any(c == 'C5' and 'exactly one' in d for c, d in r['errors']), 'C5: both a figure and unavailable'), '')\n   596\t    p3c = copy.deepcopy(p3a)\n   597\t    next(f for f in p3c['figures'] if f['id'] == 'pri')['value'] = 431.0\n   598\t    item('P3c', f1p, G_PASSAGES, p3c, lambda r: ('C10' in codes(r), 'C10: a prior figure the earlier answer does not state'), '')\n   599\t    p3b = copy.deepcopy(c1)\n   600\t    p3b['figures'].append(est('wrap', 425.0, 'USD bn', W('NVIDIA', 'revenue', CO, 'FY2027'), 'our earlier forecast, close to the Street', ['gc392']))\n   601\t    p3b['answers'][0]['reference'] = {'figure': 'wrap'}\n   602\t    item('P3b', f1, G_PASSAGES, p3b, lambda r: (codes(r) == {'C5'}, 'C5 only'), '')\n   603\t\n   604\t    f3, c3 = g3()\n   605\t    p4 = copy.deepcopy(c3)\n   606\t    next(f for f in p4['figures'] if f['id'] == 'gasp')['what']['scope'] = 'Rubin GPU'      # a price of another product\n   607\t    item('P4', f3, G_PASSAGES, p4, lambda r: (codes(r) == {'C8'} and any('gunits' in d for _, d in r['errors']),\n   608\t                                               'C8 only, on gunits: the per-unit identity needs one scope'), '')\n   609\t\n   610\t    g3inv = copy.deepcopy(c3)\n   611\t    g3inv['figures'].append(comp('gback', 'product', ['gunits', 'gasp'], 20.0, 'USD bn', W('NVIDIA', 'revenue', 'Vera CPU', 'FY2027')))\n   612\t    item('G3inv', f3, G_PASSAGES, g3inv, lambda r: (not r['errors'], 'the per-unit inverse gives $20B'), '')\n   613\t    f4, c4 = g4()\ngate-run23.fixtures.json\ngate-run23.txt\n","exit_code":0,"status":"completed"}}
