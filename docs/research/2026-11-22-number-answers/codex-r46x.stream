{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba calc_check.py | sed -n '99,192p;243,280p;362,430p;530,600p;676,852p'\"","aggregated_output":"    99\t        ok = _same(fig.get('value'), expr['multiplier']) and unit == 'x' and bound == expr['bound']\n   100\t    if not ok:\n   101\t        return [('C1', f'{fig[\"id\"]}: value {fig.get(\"value\")} {unit} bound {bound} does not equal \"{expr[\"text\"]}\" as component {comp}')]\n   102\t    return []\n   103\t\n   104\t\n   105\tdef _interval(fig):\n   106\t    if 'low' in fig and 'high' in fig:\n   107\t        return fig['low'], fig['high']\n   108\t    return fig['value'], fig['value']\n   109\t\n   110\t\n   111\tdef _terms(fig):\n   112\t    \"\"\"[46w] The operands a calculation uses, with a sum's or roll_forward's repeated operands netted (x - x cancels exactly).\"\"\"\n   113\t    ids = list(fig.get('inputs', []))\n   114\t    if fig.get('operation') not in ('sum', 'roll_forward'):\n   115\t        return ids, fig.get('signs')\n   116\t    net = {}\n   117\t    for i, k in zip(ids, fig.get('signs') or [1] * len(ids)):\n   118\t        net[i] = net.get(i, 0) + k\n   119\t    kept = [i for i in dict.fromkeys(ids) if net[i] != 0]\n   120\t    return kept, [net[i] for i in kept]\n   121\t\n   122\t\n   123\tdef _compute(op, inputs, signs, out_unit=None):\n   124\t    \"\"\"inputs: [(lo, hi, unit)]; returns (lo, hi) in out_unit.\"\"\"\n   125\t    los = [i[0] for i in inputs]\n   126\t    his = [i[1] for i in inputs]\n   127\t    if op in ('sum', 'roll_forward'):\n   128\t        s = signs or [1] * len(inputs)\n   129\t        return (sum((a if k > 0 else b) * k for a, b, k in zip(los, his, s)), sum((b if k > 0 else a) * k for a, b, k in zip(los, his, s)))\n   130\t    if op == 'difference':\n   131\t        return los[0] - his[1], his[0] - los[1]\n   132\t    if op == 'product':\n   133\t        lo = hi = 1.0\n   134\t        for a, b in zip(los, his):\n   135\t            lo, hi = lo * a, hi * b\n   136\t        units = [i[2] for i in inputs]\n   137\t        if 'units' in units and 'USD' in units and out_unit == 'USD bn':     # units times a dollar price, in billions\n   138\t            lo, hi = lo / 1e9, hi / 1e9\n   139\t        return lo, hi\n   140\t    if op == 'ratio':\n   141\t        units = [i[2] for i in inputs]\n   142\t        if 'USD' in units and 'USD bn' in units:                # a dollar total over a per-unit price\n   143\t            los = [x * 1e9 if u == 'USD bn' else x for x, u in zip(los, units)]\n   144\t            his = [x * 1e9 if u == 'USD bn' else x for x, u in zip(his, units)]\n   145\t        return los[0] / his[1], his[0] / los[1]\n   146\t    if op == 'share':\n   147\t        return los[0] * los[1] / 100.0, his[0] * his[1] / 100.0\n   148\t    if op == 'growth':\n   149\t        return (los[1] / his[0] - 1) * 100.0, (his[1] / los[0] - 1) * 100.0\n   150\t    if op == 'apply_growth':\n   151\t        return los[0] * (1 + los[1] / 100.0), his[0] * (1 + his[1] / 100.0)\n   152\t    if op == 'range_from_relative':\n   153\t        return los[0] * (1 - los[1] / 100.0), his[0] * (1 + his[1] / 100.0)\n   154\t    raise ValueError(op)\n   155\t\n   156\t\n   157\tDIRECTION = {'>': 'lower', '>=': 'lower', 'approx_above': 'lower', '<': 'upper', '<=': 'upper', 'approx_below': 'upper',\n   158\t             'approx': 'two-sided', 'mixed': 'mixed', None: None}\n   159\tFLIP = {'lower': 'upper', 'upper': 'lower', 'two-sided': 'two-sided', 'mixed': 'mixed', None: None}\n   160\t\n   161\t\n   162\tdef _bound_direction(op, ins, signs=None):\n   163\t    \"\"\"For positive operands: which side the result is bounded on, from its inputs' bounds (None: a point). [46u.2] A term a sum or\n   164\t    roll_forward subtracts flips its side.\"\"\"\n   165\t    dirs = [DIRECTION.get(i.get('bound')) for i in ins]\n   166\t    if op in ('sum', 'roll_forward') and signs:\n   167\t        dirs = [FLIP[d] if k < 0 else d for d, k in zip(dirs, signs)]\n   168\t    if op == 'ratio' and len(dirs) == 2:\n   169\t        dirs = [dirs[0], FLIP[dirs[1]]]\n   170\t    if op == 'difference' and len(dirs) == 2:\n   171\t        dirs = [dirs[0], FLIP[dirs[1]]]\n   172\t    found = {d for d in dirs if d}\n   173\t    if not found:\n   174\t        return None\n   175\t    if 'mixed' in found or {'lower', 'upper'} <= found:     # [46v] opposing bounds leave the result unbounded\n   176\t        return 'mixed'\n   177\t    return found.pop() if len(found) == 1 and 'two-sided' not in found else 'two-sided'\n   178\t\n   179\t\n   180\tdef _outcome_set(fig):\n   181\t    \"\"\"The values an outcome allows: (low, low_closed, high, high_closed); a bound keeps its side open or closed.\"\"\"\n   182\t    lo, hi = _interval(fig)\n   183\t    b = fig.get('bound')\n   184\t    inf = float('inf')\n   185\t    if b == '>':\n   186\t        return (lo, False, inf, False)\n   187\t    if b in ('>=', 'approx_above'):\n   188\t        return (lo, True, inf, False)\n   189\t    if b == '<':\n   190\t        return (-inf, False, hi, False)\n   191\t    if b in ('<=', 'approx_below'):\n   192\t        return (-inf, False, hi, True)\n   243\t    values, order, done = {}, [], set()\n   244\t\n   245\t    def visit(fid):\n   246\t        if fid in done:\n   247\t            return\n   248\t        done.add(fid)\n   249\t        for r in refs(figs[fid]):\n   250\t            if r in figs:\n   251\t                visit(r)\n   252\t        order.append(fid)\n   253\t    for fid in figs:\n   254\t        visit(fid)\n   255\t    for fid in order:\n   256\t        fig = figs[fid]\n   257\t        if fid in overrides:\n   258\t            values[fid] = overrides[fid]\n   259\t        elif fig['kind'] == 'computed' and fig.get('operation') in OPERATIONS:\n   260\t            t_ids, t_signs = _terms(fig)\n   261\t            ins = [values[i] for i in t_ids]\n   262\t            interval = _compute(fig['operation'], [iv + (figs[i]['unit'],) for (iv, _), i in zip(ins, t_ids)], t_signs, fig['unit']) if ins else (0.0, 0.0)\n   263\t            pseudo = [{'bound': b} for _, b in ins]\n   264\t            side = _bound_direction(fig['operation'], pseudo, t_signs)\n   265\t            strict = any(b in STRICT for _, b in ins)\n   266\t            bound = {'lower': '>' if strict else '>=', 'upper': '<' if strict else '<=', 'two-sided': 'approx', 'mixed': 'mixed', None: None}[side]\n   267\t            values[fid] = (interval, bound)\n   268\t        else:\n   269\t            values[fid] = (_interval(fig), fig.get('bound'))\n   270\t    return values\n   271\t\n   272\t\n   273\tdef _set_from(interval, bound):\n   274\t    fig = {'low': interval[0], 'high': interval[1], 'bound': bound} if interval[0] != interval[1] else {'value': interval[0], 'bound': bound}\n   275\t    return _outcome_set(fig)\n   276\t\n   277\t\n   278\tdef _close(declared, expected, unit):\n   279\t    floor = 0.05 if unit == '%' else 0.1\n   280\t    return abs(declared - expected) <= max(0.005 * abs(expected), floor)\n   362\t    # C2 arithmetic and bound propagation\n   363\t    for fig in figs.values():\n   364\t        if fig['kind'] != 'computed' or fig.get('operation') not in OPERATIONS:\n   365\t            continue\n   366\t        t_ids, t_signs = _terms(fig)\n   367\t        ins = [figs[i] for i in t_ids if i in figs]\n   368\t        if not ins:\n   369\t            errors.append(('C2', f'{fig[\"id\"]}: its operands cancel to nothing'))\n   370\t            continue\n   371\t        expected = _compute(fig['operation'], [_interval(i) + (i['unit'],) for i in ins], t_signs, fig['unit'])\n   372\t        lo, hi = _interval(fig)\n   373\t        if fig['operation'] == 'range_from_relative' or ('low' in fig):\n   374\t            ok = _close(lo, expected[0], fig['unit']) and _close(hi, expected[1], fig['unit'])\n   375\t        else:\n   376\t            ok = _close(lo, (expected[0] + expected[1]) / 2, fig['unit'])\n   377\t        if not ok:\n   378\t            errors.append(('C2', f'{fig[\"id\"]}: declared {lo}–{hi} but {fig[\"operation\"]} of {fig[\"inputs\"]} gives {expected[0]:.2f}–{expected[1]:.2f}'))\n   379\t        want = _bound_direction(fig['operation'], ins, t_signs)\n   380\t        have = DIRECTION.get(fig.get('bound'))\n   381\t        if want == 'mixed':\n   382\t            errors.append(('C2', f'{fig[\"id\"]}: its inputs are bounded on opposite sides, so its value is unbounded; state it as an estimate'))\n   383\t        elif want is not None and have != want:\n   384\t            errors.append(('C2', f'{fig[\"id\"]}: its inputs make it a {want} bound, but it is declared {fig.get(\"bound\") or \"a point\"}'))\n   385\t        elif want is None and fig.get('bound'):\n   386\t            errors.append(('C2', f'{fig[\"id\"]}: its inputs are points, but it is declared a bound ({fig[\"bound\"]})'))\n   387\t\n   388\t    # C8 operand compatibility\n   389\t    for fig in figs.values():\n   390\t        if fig['kind'] != 'computed' or fig.get('operation') not in OPERATIONS:\n   391\t            continue\n   392\t        ins = [figs[i] for i in fig['inputs'] if i in figs]\n   393\t        op, rel, out = fig['operation'], fig.get('relation'), fig['what']\n   394\t        differing = [i['id'] for i in ins if i['unit'] not in ('%', 'x') and\n   395\t                     (i['what']['population'], i['what']['scope'], i['what']['period'], i['what']['measure']) !=\n   396\t                     (out['population'], out['scope'], out['period'], out['measure'])]\n   397\t        if op in ('sum', 'difference'):\n   398\t            money = [i for i in ins if i['unit'] not in ('%', 'x')]\n   399\t            same_qty = all((i['what']['population'], i['what']['measure'], i['what']['scope']) ==\n   400\t                           (out['population'], out['measure'], out['scope']) for i in money)\n   401\t            if rel == 'time_aggregation':\n   402\t                qs = [_quarters(i['what']['period']) for i in money]\n   403\t                q_out = _quarters(out['period'])\n   404\t                union = set().union(*[q[1] for q in qs]) if all(qs) else None\n   405\t                disjoint = all(qs) and sum(len(q[1]) for q in qs) == len(union or ())\n   406\t                if not (same_qty and q_out and all(qs) and disjoint and union == q_out[1] and all(q[0] == q_out[0] for q in qs)):\n   407\t                    errors.append(('C8', f'{fig[\"id\"]}: time aggregation needs one quantity over disjoint periods forming {out[\"period\"]}'))\n   408\t            elif rel in ('overlap_unknown', 'stated_in_addition'):\n   409\t                if rel == 'overlap_unknown' and fig.get('disputed') not in fig['inputs']:\n   410\t                    errors.append(('C8', f'{fig[\"id\"]}: overlap_unknown must name a disputed operand among its inputs'))\n   411\t            elif rel == 'accounting_parts':\n   412\t                wholes = {(r['whole_scope'], tuple(r['part_scopes'])) for r in family.get('scope_parts', [])}\n   413\t                if not any(out['scope'] == w and all(i['what']['scope'] in p for i in money) for w, p in wholes):\n   414\t                    errors.append(('C8', f'{fig[\"id\"]}: accounting_parts needs a declared split of {out[\"scope\"]}'))\n   415\t            elif differing:\n   416\t                errors.append(('C8', f'{fig[\"id\"]}: {op} of different quantities or periods ({\", \".join(differing)}) states no relation'))\n   417\t        elif op == 'roll_forward':\n   418\t            opening = ins[0]['what']['period'] if ins else ''\n   419\t            if not (opening.startswith('as of') and all(not i['what']['period'].startswith('as of') for i in ins[1:])\n   420\t                    and out['period'].startswith(('as of', 'end of'))):\n   421\t                errors.append(('C8', f'{fig[\"id\"]}: roll_forward needs an opening balance as of a date, flows after it, and a closing balance'))\n   422\t            if rel == 'overlap_unknown' and fig.get('disputed') not in fig['inputs']:\n   423\t                errors.append(('C8', f'{fig[\"id\"]}: overlap_unknown must name a disputed operand among its inputs'))\n   424\t        elif op == 'share':\n   425\t            pct = [i for i in ins if i['unit'] == '%']\n   426\t            if len(pct) != 1:\n   427\t                errors.append(('C8', f'{fig[\"id\"]}: a share needs one share figure and one whole'))\n   428\t        elif op == 'apply_growth' and any(r['type'] == 'same_base' for r in family.get('relations', [])) and \\\n   429\t                all(i['unit'] == '%' or i['what']['scope'] == out['scope'] for i in ins):\n   430\t            pass\n   530\t        return seen_ids\n   531\t    scenarios = {f.get('scenario', 'base') for f in figs.values() if f['basis'] == 'forecast'} or {'base'}\n   532\t    for rel in family.get('relations', []):\n   533\t        if rel['type'] != 'part_of' or rel['part'] not in outcomes or rel['whole'] not in outcomes:\n   534\t            continue\n   535\t        part_m, whole_m = members[rel['part']], members[rel['whole']]\n   536\t        for sc in scenarios:\n   537\t            for period in family.get('compare_periods', []):\n   538\t                def node(view_id, member):\n   539\t                    want = (member['what']['population'], member['what']['measure'], member['what']['scope'], period)\n   540\t                    hits = [figs[f] for f in reachable(outcomes[view_id]) if _key(figs[f]['what']) == want\n   541\t                            and figs[f]['basis'] == 'forecast' and figs[f].get('scenario', 'base') == sc]\n   542\t                    return hits[0] if hits else None\n   543\t                p, w = node(rel['part'], part_m), node(rel['whole'], whole_m)\n   544\t                if p and w and _exceeds(_outcome_set(p), _outcome_set(w)):          # [46s] open and closed ends kept\n   545\t                    errors.append(('C3', f'{period} {sc}: {rel[\"part\"]} {p[\"id\"]} {_outcome_set(p)} exceeds {rel[\"whole\"]} {w[\"id\"]} {_outcome_set(w)}'))\n   546\t    for shared in family.get('shared', []):\n   547\t        want = _key(shared)\n   548\t        nodes = [f for f in figs.values() if _key(f['what']) == want and f['basis'] == 'forecast']\n   549\t        touched = [v for v, o in outcomes.items() if any(_key(figs[f]['what']) == want for f in reachable(o))]\n   550\t        if not touched:\n   551\t            continue\n   552\t        per_scenario = {}\n   553\t        for n in nodes:\n   554\t            per_scenario.setdefault(n.get('scenario', 'base'), []).append(n['id'])\n   555\t        if not nodes:\n   556\t            errors.append(('C4', f'{want}: no forecast node, though {\", \".join(touched)} depend on it'))\n   557\t        for sc, ids in sorted(per_scenario.items()):\n   558\t            if len(ids) != 1:\n   559\t                errors.append(('C4', f'{want} {sc}: {len(ids)} forecast nodes ({\", \".join(ids)}); exactly one per scenario is required'))\n   560\t        stop = {n['id'] for n in nodes}\n   561\t        for f in figs.values():                       # [46i.1] scenario membership is derived along the whole path, not declared\n   562\t            sc = f.get('scenario', 'base')\n   563\t            if sc == 'range' or f['kind'] not in ('computed', 'estimate'):\n   564\t                continue\n   565\t            upstream = _upstream_of(f['id'], figs, refs)\n   566\t            borrowed = sorted(r for r in upstream if r in stop and figs[r].get('scenario', 'base') != sc)\n   567\t            if borrowed:\n   568\t                errors.append(('C4', f'{want}: {f[\"id\"]} ({sc}) depends on {\", \".join(borrowed)} of another scenario'))\n   569\t        for view_id in touched:                      # [46g.3] a bypass reaches the quantity through no forecast node of any scenario\n   570\t            bypass = [f for f in reachable(outcomes[view_id], stop=stop) if f not in stop and _key(figs[f]['what']) == want]\n   571\t            if bypass:\n   572\t                errors.append(('C4', f'{want}: {view_id} reaches {\", \".join(sorted(bypass))} without passing a forecast node ({\", \".join(sorted(stop))})'))\n   573\t    for rel in family.get('relations', []):           # [46j.2] the later member rests on the earlier member's forecast nodes, per scenario\n   574\t        if rel['type'] != 'same_base' or rel['later'] not in outcomes or rel['earlier'] not in outcomes:\n   575\t            continue\n   576\t        base_key = _key(members[rel['earlier']]['what'])\n   577\t        earlier_graph = _upstream_of(outcomes[rel['earlier']], figs, refs) | {outcomes[rel['earlier']]}\n   578\t        earlier_nodes = {f for f in earlier_graph if _key(figs[f]['what']) == base_key and figs[f]['basis'] == 'forecast'}\n   579\t        reached = reachable(outcomes[rel['later']], stop=earlier_nodes)\n   580\t        bypass = [f for f in reached if f not in earlier_nodes and _key(figs[f]['what']) == base_key]\n   581\t        later_key = _key(members[rel['later']]['what'])\n   582\t        by_scenario = {figs[n].get('scenario', 'base'): n for n in earlier_nodes if figs[n].get('scenario', 'base') != 'range'}\n   583\t        later_graph = _upstream_of(outcomes[rel['later']], figs, refs) | {outcomes[rel['later']]}\n   584\t        for f in sorted(later_graph):                 # [46k.1] every later scenario path reaches the earlier forecast of its own scenario\n   585\t            sc = figs[f].get('scenario', 'base')\n   586\t            if sc == 'range' or _key(figs[f]['what']) != later_key or figs[f]['basis'] != 'forecast':\n   587\t                continue\n   588\t            target = by_scenario.get(sc) or (next(iter(by_scenario.values())) if len(by_scenario) == 1 else None)\n   589\t            if target is None or target not in _determining(f, figs):       # [46l.1] through value-determining inputs only\n   590\t                errors.append(('C9', f'{f} ({sc}) of {rel[\"later\"]} is not computed from {rel[\"earlier\"]}\\'s {sc} forecast'))\n   591\t            else:                                     # [46o.1, 46p] its value moves when that forecast moves: one realisation per figure\n   592\t                mid_t = sum(_interval(figs[target])) / 2\n   593\t                before = _evaluate_points(figs, refs, {})[f]\n   594\t                after = _evaluate_points(figs, refs, {target: mid_t * 1.1})[f]\n   595\t                if abs(after - before) <= 1e-9 * max(1.0, abs(before)):\n   596\t                    errors.append(('C9', f'{f} ({sc}) of {rel[\"later\"]} does not change when {rel[\"earlier\"]}\\'s forecast {target} changes'))\n   597\t        later_scen = {figs[f].get('scenario', 'base') for f in later_graph if _key(figs[f]['what']) == later_key\n   598\t                      and figs[f]['basis'] == 'forecast' and figs[f].get('scenario', 'base') != 'range'}\n   599\t        if earlier_nodes and not later_scen:              # [46m.2] a citation never stands in for a calculation\n   600\t            errors.append(('C9', f'{rel[\"later\"]} has no calculation from {rel[\"earlier\"]}\\'s forecast, only a range resting on it'))\n   676\t        if ends & unresolved and ends - unresolved:\n   677\t            return 'held'\n   678\t    return 'publish'\n   679\t\n   680\t\n   681\tdef family_outcome(attempts):\n   682\t    \"\"\"The round's outcome from up to two attempts' decisions: a refusal is retried once; two refusals make the family unresolved.\"\"\"\n   683\t    if attempts[0] != 'refused':\n   684\t        return attempts[0]\n   685\t    if len(attempts) > 1 and attempts[1] != 'refused':\n   686\t        return attempts[1]\n   687\t    return 'unresolved'\n   688\t\n   689\t\n   690\tdef _determining(fid, figs):\n   691\t    \"\"\"The figures that determine fid's value: computed inputs only, at any depth (an estimate's rests_on explains, it does not compute).\"\"\"\n   692\t    seen_ids, stack = set(), list(figs[fid].get('inputs', [])) if figs[fid]['kind'] == 'computed' else []\n   693\t    while stack:\n   694\t        f = stack.pop()\n   695\t        if f in seen_ids or f not in figs:\n   696\t            continue\n   697\t        seen_ids.add(f)\n   698\t        if figs[f]['kind'] == 'computed':\n   699\t            stack.extend(figs[f].get('inputs', []))\n   700\t    return seen_ids\n   701\t\n   702\t\n   703\tdef _upstream_of(fid, figs, refs):\n   704\t    \"\"\"The figures that fid's own value is computed from (fid excluded).\"\"\"\n   705\t    seen_ids, stack = set(), list(refs(figs[fid]))\n   706\t    while stack:\n   707\t        f = stack.pop()\n   708\t        if f in seen_ids or f not in figs:\n   709\t            continue\n   710\t        seen_ids.add(f)\n   711\t        stack.extend(refs(figs[f]))\n   712\t    return seen_ids\n   713\t\n   714\t\n   715\tdef _reference_errors(view_id, ref, figs, passages, refs):\n   716\t    if ref is None:\n   717\t        return [('C5', f'{view_id}: the reference names no figure')]\n   718\t    graph = [ref['id']] + sorted(_upstream_of(ref['id'], figs, refs))\n   719\t    nodes = [figs[f] for f in graph]\n   720\t    if any(n['kind'] in ('estimate', 'prior') or n['basis'] in ('forecast', 'prior_forecast') for n in nodes):\n   721\t        return [('C5', f'{view_id}: the reference {ref[\"id\"]} rests on the system\\'s own forecast or an estimate')]\n   722\t    leaves = [n for n in nodes if n['kind'] == 'source']\n   723\t    if not any(n['basis'] in EXTERNAL and passages.get(n['evidence'], {}).get('speaker') != 'system' for n in leaves):\n   724\t        return [('C5', f'{view_id}: the reference {ref[\"id\"]} has no external source among its leaves')]\n   725\t    if any(n['basis'] not in EXTERNAL | {'reported'} for n in leaves):\n   726\t        return [('C5', f'{view_id}: the reference {ref[\"id\"]} has a leaf that is neither external nor reported')]\n   727\t    return []\n   728\t\n   729\t\n   730\tdef _evaluate(figs, refs, overrides):\n   731\t    \"\"\"Recompute computed figures from their inputs, with some figures' values replaced; estimates keep their values.\"\"\"\n   732\t    values, order, done = {}, [], set()\n   733\t\n   734\t    def visit(fid):\n   735\t        if fid in done:\n   736\t            return\n   737\t        done.add(fid)\n   738\t        for r in refs(figs[fid]):\n   739\t            if r in figs:\n   740\t                visit(r)\n   741\t        order.append(fid)\n   742\t    for fid in figs:\n   743\t        visit(fid)\n   744\t    for fid in order:\n   745\t        fig = figs[fid]\n   746\t        if fid in overrides:\n   747\t            values[fid] = overrides[fid]\n   748\t        elif fig['kind'] == 'computed' and fig.get('operation') in OPERATIONS:\n   749\t            t_ids, t_signs = _terms(fig)\n   750\t            ins = [values[i] + (figs[i]['unit'],) for i in t_ids]\n   751\t            values[fid] = _compute(fig['operation'], ins, t_signs, fig['unit']) if ins else (0.0, 0.0)\n   752\t        else:\n   753\t            values[fid] = _interval(fig)\n   754\t    return values\n   755\t\n   756\t\n   757\tdef _evaluate_points(figs, refs, overrides):\n   758\t    \"\"\"Recompute with every figure at one point (its midpoint), the same wherever it appears; overrides set points.\"\"\"\n   759\t    values, order, done = {}, [], set()\n   760\t\n   761\t    def visit(fid):\n   762\t        if fid in done:\n   763\t            return\n   764\t        done.add(fid)\n   765\t        for r in refs(figs[fid]):\n   766\t            if r in figs:\n   767\t                visit(r)\n   768\t        order.append(fid)\n   769\t    for fid in figs:\n   770\t        visit(fid)\n   771\t    for fid in order:\n   772\t        fig = figs[fid]\n   773\t        if fid in overrides:\n   774\t            values[fid] = overrides[fid]\n   775\t        elif fig['kind'] == 'computed' and fig.get('operation') in OPERATIONS:\n   776\t            t_ids, t_signs = _terms(fig)\n   777\t            ins = [(values[i], values[i], figs[i]['unit']) for i in t_ids]\n   778\t            lo, hi = _compute(fig['operation'], ins, t_signs, fig['unit']) if ins else (0.0, 0.0)\n   779\t            values[fid] = (lo + hi) / 2\n   780\t        else:\n   781\t            values[fid] = sum(_interval(fig)) / 2\n   782\t    return values\n   783\t\n   784\t\n   785\tdef _boundaries(bands, a, b):\n   786\t    edges = sorted({e for band in bands for e in band if e is not None})\n   787\t    lo, hi = min(a, b), max(a, b)\n   788\t    return [e for e in edges if lo < e <= hi]\n   789\t\n   790\t\n   791\tdef _assumptions(family, figs, outcomes, calc, refs):\n   792\t    out = []\n   793\t    members = family['members']\n   794\t\n   795\t    def downstream_formula(start, outcome_id):\n   796\t        \"\"\"True when every figure between start and the outcome (the outcome included) is computed.\"\"\"\n   797\t        between = [f for f in [outcome_id] + sorted(_upstream_of(outcome_id, figs, refs)) if start in _upstream_of(f, figs, refs)]\n   798\t        return all(figs[f]['kind'] == 'computed' for f in between)\n   799\t    for fig in figs.values():\n   800\t        alt, kind = None, None\n   801\t        if fig['kind'] == 'computed' and fig.get('relation') == 'overlap_unknown' and fig.get('disputed') in fig.get('inputs', []):\n   802\t            t_ids, t_signs = _terms(dict(fig, inputs=[i for i in fig['inputs'] if i != fig['disputed']],\n   803\t                                         signs=[k for i, k in zip(fig['inputs'], fig.get('signs') or [1] * len(fig['inputs'])) if i != fig['disputed']]))\n   804\t            keep, signs = t_ids, t_signs\n   805\t            alt = _compute(fig['operation'], [_interval(figs[i]) + (figs[i]['unit'],) for i in keep], signs, fig['unit'])\n   806\t            side = _bound_direction(fig['operation'], [figs[i] for i in keep], signs)      # [46u.1] the retained operands' bounds\n   807\t            strict = any(figs[i].get('bound') in STRICT for i in keep)\n   808\t            kind, bound = 'overlap', {'lower': '>' if strict else '>=', 'upper': '<' if strict else '<=', 'two-sided': 'approx', 'mixed': 'mixed', None: None}[side]\n   809\t        elif fig['kind'] == 'estimate' and fig.get('adjusts'):\n   810\t            target = figs[fig['adjusts']['figure']]\n   811\t            alt, kind, bound = _interval(target), 'adjustment', target.get('bound')\n   812\t        if kind is None:\n   813\t            continue\n   814\t        for view_id, outcome_id in outcomes.items():\n   815\t            if fig['id'] != outcome_id and fig['id'] not in _upstream_of(outcome_id, figs, refs):\n   816\t                continue\n   817\t            if not downstream_formula(fig['id'], outcome_id):\n   818\t                out.append({'type': kind, 'figure': fig['id'], 'outcome': view_id, 'certainty': 'undetermined'})\n   819\t                continue\n   820\t            base_vals = _evaluate_bounded(figs, refs, {})                 # [46s, 46t.1] bounds carried through recomputation\n   821\t            alt_override = (alt, bound)\n   822\t            alt_vals = _evaluate_bounded(figs, refs, {fig['id']: alt_override})\n   823\t            base_set, alt_set = _set_from(*base_vals[outcome_id]), _set_from(*alt_vals[outcome_id])\n   824\t            definite, possible = _crossings(base_set, alt_set, members[view_id]['bands'])\n   825\t            finite = lambda v: v if abs(v) != float('inf') else None\n   826\t            out.append({'type': kind, 'figure': fig['id'], 'outcome': view_id, 'value': [finite(base_set[0]), finite(base_set[2])],\n   827\t                        'alternate': [finite(alt_set[0]), finite(alt_set[2])], 'alternate_bound': bound,\n   828\t                        'definite': definite, 'possible': possible})                      # [46t.1] certainty per boundary\n   829\t    return out\n","exit_code":0,"status":"completed"}}
