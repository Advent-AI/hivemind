{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"python3 -B -c '\nimport pathlib,json,io,contextlib,copy,types\nimport gate as g, calc_check as c, render_v13 as r, mutants\ndef replay(func, log):\n    p=io.StringIO()\n    with contextlib.redirect_stdout(p): status=func()\n    assert status==0 and p.getvalue()==pathlib.Path(log).read_text()\nreplay(g.main,'\\\\''gate-run20.txt'\\\\'')\nassert g.MANIFEST==json.loads(pathlib.Path('\\\\''gate-run20.fixtures.json'\\\\'').read_text())\nreplay(r.main,'\\\\''render-r1.txt'\\\\'')\noriginal=g.cc\npath=pathlib.Path('\\\\''calc_check.py'\\\\'')\nsrc=path.read_text()\nfor name,old,new,target in mutants.MUTANTS:\n    g.cc=original\n    if old:\n        assert src.count(old)==1,name\n        mod=types.ModuleType('\\\\''in_memory_calc_check'\\\\'')\n        exec(compile(src.replace(old,new),str(path),'\\\\''exec'\\\\''),mod.__dict__)\n        g.cc=mod\n    misses={name for name,ok,_,_ in g.run() if not ok}\n    assert (target in misses if target else not misses),(name,misses)\ng.cc=original\nprint('\\\\''74 gate items, 38 mutants and stored render reproduced'\\\\'')\ndef fig(calc,fid):\n    return next(f for f in calc['\\\\''figures'\\\\''] if f['\\\\''id'\\\\'']==fid)\ndef check(name,case,passages):\n    fam,x=case['\\\\''family'\\\\''],case['\\\\''calc'\\\\'']\n    schema=r.v13_schema(list(fam['\\\\''members'\\\\'']),list(passages),[])\n    wire=r.strict(x,schema)\n    clean=r.without_nulls(wire)\n    report=c.check(fam,passages,clean)\n    print(name,r.model.check_schema(wire,schema),report, c.publish_decision(fam,clean,report))\nfor name,ps in (('\\\\''R2rev'\\\\'',g.R2_PASSAGES),('\\\\''R2m'\\\\'',g.R2_PASSAGES),('\\\\''G4x2'\\\\'',g.G_PASSAGES)):\n    check(name,g.MANIFEST[name],ps)\ncase=copy.deepcopy(g.MANIFEST['\\\\''R2rev'\\\\''])\nx=case['\\\\''calc'\\\\'']\nfor op,extra in (('\\\\''difference'\\\\'',{}),('\\\\''sum'\\\\'',{'\\\\''signs'\\\\'':[1,-1]})):\n    cp=copy.deepcopy(case)\n    y=cp['\\\\''calc'\\\\'']\n    t=fig(y,'\\\\''talks'\\\\'')\n    y['\\\\''figures'\\\\''].append(g.comp('\\\\''net_reversal'\\\\'',op,['\\\\''talks'\\\\'','\\\\''talks'\\\\''],0.,'\\\\''USD bn'\\\\'',t['\\\\''what'\\\\''],**extra))\n    fig(y,'\\\\''end'\\\\'').update(inputs=['\\\\''bal'\\\\'','\\\\''add18'\\\\'','\\\\''mtk'\\\\'','\\\\''net_reversal'\\\\''],signs=[1,1,1,1])\n    check(f'\\\\''R2rev broken into a separate exact zero using {op}'\\\\'',cp,g.R2_PASSAGES)\n'\"","aggregated_output":"Traceback (most recent call last):\n  File \"<string>\", line 41, in <module>\n  File \"<string>\", line 26, in fig\nStopIteration\n74 gate items, 38 mutants and stored render reproduced\nR2rev [] {'errors': [], 'recorded': [{'type': 'overlap', 'figure': 'end', 'outcome': 'v29', 'value': [46.5, 46.5], 'alternate': [28.5, 28.5], 'alternate_bound': None, 'definite': [], 'possible': []}]} publish\nR2m [] {'errors': [('C2', 'end: its inputs are bounded on opposite sides, so its value is unbounded; state it as an estimate')], 'recorded': [{'type': 'overlap', 'figure': 'end', 'outcome': 'v29', 'value': [None, None], 'alternate': [None, None], 'alternate_bound': 'mixed', 'definite': [], 'possible': []}]} refused\nG4x2 [] {'errors': [('C9', \"g28cancel (base) of v22 does not change when v1's forecast gfy changes\")], 'recorded': []} refused\n","exit_code":1,"status":"failed"}}
