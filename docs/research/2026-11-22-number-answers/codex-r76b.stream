ews_db, items_db, as_of)\n   143\t    finally:\n   144\t        views_db.close()\n   145\t        items_db.close()\n   146\t\n   147\t\n   148\tdef strings(value):\n   149\t    \"\"\"Every decoded string in the package (keys excluded).\"\"\"\n   150\t    if isinstance(value, dict):\n   151\t        return [s for v in value.values() for s in strings(v)]\n   152\t    if isinstance(value, list):\n   153\t        return [s for v in value for s in strings(v)]\n   154\t    return [value] if isinstance(value, str) else []\n   155\t\n   156\t\n   157\tdef by_id(data):\n   158\t    return {q['id']: q for q in data['questions']}\n","exit_code":0,"status":"completed"}}
