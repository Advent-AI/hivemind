{"type":"item.completed","item":{"id":"item_17","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba src/hivemind/release.py | sed -n '333,490p'\"","aggregated_output":"   333\t\n   334\tdef write_package(data, staged):\n   335\t    \"\"\"The data file and its manifest, written into the staging folder.\"\"\"\n   336\t    payload = _dump(data)\n   337\t    (Path(staged) / DATA_FILE).write_bytes(payload)\n   338\t    manifest = {'format': data['format'], 'allow_list': data['allow_list'], 'as_of': data['as_of'], 'data_sha256': hashlib.sha256(payload).hexdigest()}\n   339\t    (Path(staged) / MANIFEST_FILE).write_bytes(_dump(manifest))\n   340\t\n   341\t\n   342\tdef _no_replace_rename():\n   343\t    libc = ctypes.CDLL(ctypes.util.find_library('c'), use_errno=True)\n   344\t    if sys.platform == 'darwin' and hasattr(libc, 'renamex_np'):\n   345\t        call = libc.renamex_np\n   346\t        call.argtypes, call.restype = [ctypes.c_char_p, ctypes.c_char_p, ctypes.c_uint], ctypes.c_int\n   347\t        return lambda source, target: call(source, target, RENAME_EXCL)\n   348\t    if sys.platform.startswith('linux') and hasattr(libc, 'renameat2'):\n   349\t        call = libc.renameat2\n   350\t        call.argtypes, call.restype = [ctypes.c_int, ctypes.c_char_p, ctypes.c_int, ctypes.c_char_p, ctypes.c_uint], ctypes.c_int\n   351\t        return lambda source, target: call(AT_FDCWD, source, AT_FDCWD, target, RENAME_NOREPLACE)\n   352\t    return None\n   353\t\n   354\t\n   355\tdef publish(staged, out_dir):\n   356\t    \"\"\"One atomic move of the staged folder to the destination that refuses any existing destination, empty or not.\"\"\"\n   357\t    rename = _no_replace_rename()\n   358\t    if rename is None:\n   359\t        raise ReleaseRefused('this platform offers no atomic rename that refuses an existing destination')\n   360\t    if rename(os.fsencode(str(staged)), os.fsencode(str(out_dir))) != 0:\n   361\t        code = ctypes.get_errno()\n   362\t        if code in (errno.ENOTSUP, errno.EINVAL, errno.ENOSYS):\n   363\t            raise ReleaseRefused(f'the filesystem refuses an atomic no-replace rename ({os.strerror(code)})')\n   364\t        raise OSError(code, os.strerror(code), str(out_dir))\n   365\t\n   366\t\n   367\tdef publish_report(report, path):\n   368\t    \"\"\"The report, written to a private temporary file and linked to its name; the link refuses any existing path, and its success\n   369\t    is the moment the report is published. Returns None, or the temporary file it could not remove after publishing.\"\"\"\n   370\t    path = Path(path)\n   371\t    descriptor, temporary = tempfile.mkstemp(dir=path.parent, prefix=f'.{path.name}.')\n   372\t    try:\n   373\t        with os.fdopen(descriptor, 'wb') as handle:\n   374\t            handle.write(json.dumps(report, ensure_ascii=False, indent=1).encode('utf-8'))\n   375\t        os.link(temporary, path)\n   376\t    except BaseException:\n   377\t        os.unlink(temporary)\n   378\t        raise\n   379\t    try:\n   380\t        os.unlink(temporary)\n   381\t    except OSError:\n   382\t        return temporary\n   383\t    return None\n   384\t\n   385\t\n   386\tdef _unique_members(pairs):\n   387\t    names = [name for name, _ in pairs]\n   388\t    if len(names) != len(set(names)):\n   389\t        raise ReleaseRefused(f'a JSON member name repeats: {sorted({n for n in names if names.count(n) > 1})}')\n   390\t    return dict(pairs)\n   391\t\n   392\t\n   393\tdef read_data(package):\n   394\t    \"\"\"The package's data, read with the repeated-member check. `check_package` returns the data it checked, which is the copy to\n   395\t    trust; this reader is for inspection only.\"\"\"\n   396\t    return _parse((Path(package) / DATA_FILE).read_bytes(), DATA_FILE)\n   397\t\n   398\t\n   399\tURI_CHARACTERS = '%?#'\n   400\t\n   401\t\n   402\tdef store_path(path):\n   403\t    \"\"\"The resolved store path, the one the opener is then given (so the opener's own resolution has nothing left to follow): refused\n   404\t    when it holds a character a SQLite URI decodes (`store.open_read_only` puts the path into a `file:` URI unescaped, so `%2D` would\n   405\t    open a `-`).\"\"\"\n   406\t    real = os.path.realpath(path)\n   407\t    found = sorted({c for c in real if c in URI_CHARACTERS})\n   408\t    if found:\n   409\t        raise ReleaseRefused(f'{path}: a store path may not contain {found}, which the SQLite opener reads as URI syntax')\n   410\t    return real\n   411\t\n   412\t\n   413\tdef _read_regular(folder, name, where):\n   414\t    \"\"\"The bytes of one regular file in an opened folder, read once through a descriptor that refuses a symbolic link and opens a pipe\n   415\t    without waiting, so its type is refused instead.\"\"\"\n   416\t    try:\n   417\t        descriptor = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=folder)   # a pipe or device never blocks the check\n   418\t    except OSError as error:\n   419\t        if error.errno == errno.ELOOP:\n   420\t            raise ReleaseRefused(f'{where}/{name}: not a regular file') from None\n   421\t        raise\n   422\t    try:\n   423\t        if not stat.S_ISREG(os.fstat(descriptor).st_mode):\n   424\t            raise ReleaseRefused(f'{where}/{name}: not a regular file')\n   425\t        chunks = []\n   426\t        while True:\n   427\t            chunk = os.read(descriptor, 1 << 20)\n   428\t            if not chunk:\n   429\t                return b''.join(chunks)\n   430\t            chunks.append(chunk)\n   431\t    finally:\n   432\t        os.close(descriptor)\n   433\t\n   434\t\n   435\tdef _parse(raw, name):\n   436\t    try:\n   437\t        return json.loads(raw.decode('utf-8'), object_pairs_hook=_unique_members)\n   438\t    except (UnicodeDecodeError, json.JSONDecodeError) as error:\n   439\t        raise ReleaseRefused(f'{name}: not JSON ({error})') from None\n   440\t\n   441\t\n   442\tdef check_package(path, views_db=None, items_db=None, expected_as_of=None):\n   443\t    \"\"\"The package as a reader receives it: a real folder holding exactly the two regular files, each read once through one handle on\n   444\t    the folder; JSON with no repeated member name; a closed manifest that agrees with the data and the sha256 of the very bytes\n   445\t    parsed; data that passes `check_export` and, with the stores, `check_origins` at `expected_as_of` (or at the package's own day\n   446\t    passed through `resolve`). Returns (counts, the data checked, its size in bytes).\"\"\"\n   447\t    path = Path(path)\n   448\t    try:\n   449\t        folder = os.open(path, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)\n   450\t    except OSError as error:\n   451\t        if error.errno in (errno.ELOOP, errno.ENOTDIR):\n   452\t            raise ReleaseRefused(f'{path}: not a folder') from None\n   453\t        raise\n   454\t    try:\n   455\t        names = os.listdir(folder)\n   456\t        if sorted(names) != sorted(PACKAGE_FILES):\n   457\t            raise ReleaseRefused(f'{path}: holds {sorted(names)}, not exactly {sorted(PACKAGE_FILES)}')\n   458\t        raw, manifest_raw = _read_regular(folder, DATA_FILE, path), _read_regular(folder, MANIFEST_FILE, path)\n   459\t    finally:\n   460\t        os.close(folder)\n   461\t    manifest, data = _parse(manifest_raw, MANIFEST_FILE), _parse(raw, DATA_FILE)\n   462\t    counts = check_export(data)\n   463\t    _keys(manifest, 'manifest', 'the manifest')\n   464\t    if manifest['data_sha256'] != hashlib.sha256(raw).hexdigest():\n   465\t        raise ReleaseRefused('the manifest sha256 does not match the data file')\n   466\t    for name in ('format', 'allow_list', 'as_of'):\n   467\t        if manifest[name] != data[name]:\n   468\t            raise ReleaseRefused(f'the manifest {name} {manifest[name]!r} differs from the data {data[name]!r}')\n   469\t    if views_db is not None:\n   470\t        bound = expected_as_of if expected_as_of is not None else resolve(views_db, data['as_of'])\n   471\t        counts['fields_compared'] = check_origins(views_db, items_db, data, bound)\n   472\t    return counts, data, len(raw)\n   473\t\n   474\t\n   475\t# ---------- the report\n   476\t\n   477\tdef withheld_unresolved(views_db, data):\n   478\t    \"\"\"For the release report only: the number questions whose ladder does not resolve to bands, with the reason and whether the\n   479\t    view has a key. Withheld like every number question; this list never enters the package.\"\"\"\n   480\t    out = []\n   481\t    for question in data['questions']:\n   482\t        if question['class'] != 'number':\n   483\t            continue\n   484\t        bands, reason = service.ladder_bands(store.rungs_of(views_db, question['id']))\n   485\t        if bands is None:\n   486\t            out.append({'id': question['id'], 'reason': reason, 'has_key': key_measure(views_db, question['id'], data['as_of']) is not None})\n   487\t    return out\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_18","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba tests/test_release.py | sed -n '174,192p;288,335p;400,435p'\"","aggregated_output":"   174\t        return data\n   175\t    finally:\n   176\t        views_db.close()\n   177\t        items_db.close()\n   178\t\n   179\t\n   180\tdef rewrite_data(package, data):\n   181\t    \"\"\"A copy of the package's data with its manifest hash refreshed, so every other check still passes.\"\"\"\n   182\t    payload = json.dumps(data, ensure_ascii=False, separators=(',', ':')).encode()\n   183\t    (package / release.DATA_FILE).write_bytes(payload)\n   184\t    manifest = json.loads((package / release.MANIFEST_FILE).read_text())\n   185\t    manifest.update(as_of=data['as_of'], data_sha256=hashlib.sha256(payload).hexdigest())\n   186\t    (package / release.MANIFEST_FILE).write_text(json.dumps(manifest))\n   187\t\n   188\t\n   189\tdef check(stores, package):\n   190\t    \"\"\"The counts of `check_package` with the stores.\"\"\"\n   191\t    views_db, items_db = service.open_ledger(str(stores[0])), store.open_read_only(str(stores[1]))\n   192\t    try:\n   288\t    a visible source with no item is refused.\"\"\"\n   289\t    early, late = by_id(export(stores, DAYS[0]))['v1'], by_id(export(stores))['v1']\n   290\t    assert [e['id'] for e in early['evidence']] == ['e1', 'e3']\n   291\t    assert [e['id'] for e in late['evidence']] == ['e1', 'e2', 'e4']\n   292\t    assert [s['day'] for s in early['evidence'][0]['sources']] == [DAYS[0]]\n   293\t    assert [s['day'] for s in late['evidence'][0]['sources']] == [DAYS[0], DAYS[2]]\n   294\t    short = make_items(tmp_path / 'short.sqlite', ids=('item-1', 'item-2'))\n   295\t    refused_with(lambda: export((stores[0], short)), 'evidence e1: source item item-3 is not in the items database')\n   296\t\n   297\t\n   298\t# ---------- §6 tests 9, 10, 13, 15, 16: the package and the origin check\n   299\t\n   300\t\n   301\tdef test_9_package_files_hash_and_manifest(stores, tmp_path):\n   302\t    \"\"\"§1 check_package, §6 test 9.\"\"\"\n   303\t    out = tmp_path / 'release'\n   304\t    data = build_package(stores, out)\n   305\t    assert check(stores, out)['fields_compared'] > 0\n   306\t    files = \"not exactly ['manifest.json', 'release-data.json']\"\n   307\t    variants = {\n   308\t        'foreign file': (lambda p: (p / 'notes.txt').write_text('x'), lambda p: f\"{p}: holds ['manifest.json', 'notes.txt', 'release-data.json'], {files}\"),\n   309\t        'subdirectory': (lambda p: (p / 'extra').mkdir(), lambda p: f\"{p}: holds ['extra', 'manifest.json', 'release-data.json'], {files}\"),\n   310\t        'changed byte': (lambda p: (p / release.DATA_FILE).write_bytes((p / release.DATA_FILE).read_bytes().replace(b'Morningstar', b'Morningstan')),\n   311\t                         lambda p: 'the manifest sha256 does not match the data file'),\n   312\t        'manifest prose': (lambda p: (p / release.MANIFEST_FILE).write_text(json.dumps({**json.loads((p / release.MANIFEST_FILE).read_text()), 'note': 'About $390 billion'})),\n   313\t                           lambda p: \"the manifest: keys off the allow-list ['note'], missing []\"),\n   314\t        'manifest day': (lambda p: (p / release.MANIFEST_FILE).write_text(json.dumps({**json.loads((p / release.MANIFEST_FILE).read_text()), 'as_of': DAYS[0]})),\n   315\t                         lambda p: f\"the manifest as_of '{DAYS[0]}' differs from the data '{DAYS[2]}'\"),\n   316\t    }\n   317\t    for name, (damage, message) in variants.items():\n   318\t        copy = tmp_path / f'copy-{name.replace(\" \", \"-\")}'\n   319\t        shutil.copytree(out, copy)\n   320\t        damage(copy)\n   321\t        refused_with(lambda: check(stores, copy), message(copy))\n   322\t    with pytest.raises(FileExistsError):\n   323\t        staged = release.stage(out)\n   324\t        release.write_package(data, staged)\n   325\t        release.publish(staged, out)\n   326\t    (tmp_path / '.other.staging-x').mkdir()            # another build's debris blocks nothing\n   327\t    assert build_package(stores, tmp_path / 'other')\n   328\t\n   329\t\n   330\tdef test_10_origin_check_derives_everything_from_the_store(stores, tmp_path):\n   331\t    \"\"\"§1 check_origins, §6 test 10: a forecast in a summary, a class swap, duplicates, another order and a future day are each\n   332\t    refused.\"\"\"\n   333\t    out = tmp_path / 'release'\n   334\t    data = build_package(stores, out)\n   335\t    cases = {}\n   400\t    out = tmp_path / 'release'\n   401\t    build_package(stores, out)\n   402\t    linked = tmp_path / 'linked'\n   403\t    shutil.copytree(out, linked)\n   404\t    (tmp_path / 'outside.json').write_bytes((linked / release.DATA_FILE).read_bytes())\n   405\t    (linked / release.DATA_FILE).unlink()\n   406\t    (linked / release.DATA_FILE).symlink_to(tmp_path / 'outside.json')\n   407\t    refused_with(lambda: check(stores, linked), f'{linked}/release-data.json: not a regular file')\n   408\t    repeated = tmp_path / 'repeated'\n   409\t    shutil.copytree(out, repeated)\n   410\t    raw = (repeated / release.DATA_FILE).read_bytes()\n   411\t    genuine = b'\"one_line\":\"Morningstar estimates $361 billion of revenue for the year.\"'\n   412\t    assert raw.count(genuine) == 1\n   413\t    payload = raw.replace(genuine, b'\"one_line\":\"About $390 billion\",' + genuine)\n   414\t    (repeated / release.DATA_FILE).write_bytes(payload)\n   415\t    manifest = json.loads((repeated / release.MANIFEST_FILE).read_text())\n   416\t    manifest['data_sha256'] = hashlib.sha256(payload).hexdigest()\n   417\t    (repeated / release.MANIFEST_FILE).write_text(json.dumps(manifest))\n   418\t    refused_with(lambda: check(stores, repeated), \"a JSON member name repeats: ['one_line']\")\n   419\t    piped = tmp_path / 'piped'\n   420\t    shutil.copytree(out, piped)\n   421\t    (piped / release.DATA_FILE).unlink()\n   422\t    os.mkfifo(piped / release.DATA_FILE)\n   423\t    result = run('check', piped, '--ledger', stores[0], '--items', stores[1], timeout=30)      # a blocking open would hang here\n   424\t    assert result.returncode == 1\n   425\t    stderr_line(result, f'refused: ReleaseRefused: {piped}/release-data.json: not a regular file')\n   426\t\n   427\t\n   428\tdef test_16_the_day_must_be_valid_and_canonical(stores):\n   429\t    \"\"\"§2 day rows, §6 test 16.\"\"\"\n   430\t    refused_with(lambda: export(stores, '2026-08-99'), \"not a day: '2026-08-99'\")\n   431\t    with pytest.raises(release.ReleaseRefused) as caught:      # Python 3.10 refuses the spelling as a day; 3.11+ reads it, and the canonical rule refuses it\n   432\t        export(stores, '20260825')\n   433\t    assert str(caught.value) in (\"not a day: '20260825'\", \"a day must be written YYYY-MM-DD: '20260825'\")\n   434\t    assert [e['id'] for e in by_id(export(stores, '2026-08-25'))['v1']['evidence']] == ['e1', 'e4']\n   435\t    views_db = service.open_ledger(str(stores[0]))\n","exit_code":0,"status":"completed"}}
