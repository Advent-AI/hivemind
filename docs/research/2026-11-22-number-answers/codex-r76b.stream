{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba docs/research/2026-11-22-number-answers/release_check.py | sed -n '206,290p'\nnl -ba tests/test_release.py | rg -n 'refresh|3_313|3,313|3313|manifest|format|read once|three files'\nrg -n 'PAGE|format|manifest|forged|refresh' docs/research/2026-11-22-number-answers/release_mutants.py\"","aggregated_output":"   206\t\n   207\t    leaks = {}\n   208\t    for name, view_id, day, judgement_id in (('old-3', 'v36', '2026-08-25', 799), ('old-1', 'v10', '2026-08-28', 865)):\n   209\t        ledger, items = STORES[name]\n   210\t        report, dated = build(ledger, items, out / name / f'package-{day}', day)\n   211\t        conn = service.open_ledger(str(ledger))\n   212\t        row = conn.execute('select judgement_id, rung, why_changed, reasons from judgements where view_id=? and publication_day<=? order by judgement_id desc limit 1', (view_id, day)).fetchone()\n   213\t        label = conn.execute('select label from rungs where view_id=? and position=?', (view_id, row['rung'])).fetchone()[0]\n   214\t        conn.close()\n   215\t        record = by_id(dated)[view_id]\n   216\t        dated_manifest = json.loads((out / name / f'package-{day}' / release.MANIFEST_FILE).read_text())\n   217\t        texts = [text for *_, text in fields(dated)]\n   218\t        leaks[f'{name}/{view_id}@{day}'] = {\n   219\t            'package_as_of': dated['as_of'], 'manifest_as_of': dated_manifest['as_of'], 'evidence': report['counts']['evidence'],\n   220\t            'latest_judgement': row['judgement_id'], 'expected_judgement': judgement_id, 'label_kept': record['answer'] == label, 'answer': record['answer'],\n   221\t            'why_changed_absent': not any(row['why_changed'] in t for t in texts), 'reasons_absent': not any((row['reasons'] or '\\x01') in t for t in texts),\n   222\t            'phrase_fields': {phrase: [(q, p, e, t[:160]) for q, p, e, t in fields(dated) if phrase in t]\n   223\t                              for phrase in ('around $1 trillion', 'rung 4', 'at rung', 'capex at rung')}}\n   224\t    results['leaks'] = leaks\n   225\t\n   226\t    ledger, items = STORES['old-1']\n   227\t    conn = service.open_ledger(str(ledger))\n   228\t    control = next(q for q in data['questions'] if q['class'] == 'event' and q['id'] not in ('v10',) and q['answer'] is not None)\n   229\t    stored_label = conn.execute('select r.label from judgements j join rungs r on r.view_id=j.view_id and r.position=j.rung where j.view_id=? and j.publication_day<=? order by j.judgement_id desc limit 1', (control['id'], data['as_of'])).fetchone()[0]\n   230\t    control_ids = [e['evidence_id'] for e in service.evidence(conn, control['id'], data['as_of'])]\n   231\t    conn.close()\n   232\t    results['control'] = {'id': control['id'], 'answer': control['answer'], 'label_equals_store': control['answer'] == stored_label,\n   233\t                          'evidence_equals_store': [e['id'] for e in control['evidence']] == control_ids}\n   234\t\n   235\t    closing = out / 'old-1' / 'closing'\n   236\t    closing.mkdir()\n   237\t    copy = closing / 'views.sqlite'\n   238\t    shutil.copyfile(ledger, copy)\n   239\t    conn = sqlite3.connect(copy)\n   240\t    rung = conn.execute(\"select rung from judgements where view_id='v8' order by judgement_id desc limit 1\").fetchone()[0]\n   241\t    rung_label = conn.execute(\"select label from rungs where view_id='v8' and position=?\", (rung,)).fetchone()[0]\n   242\t    reason = f'due {data[\"as_of\"]}, frozen on {data[\"as_of\"]} at rung {rung} {rung_label}'\n   243\t    last_seq = conn.execute('select max(sequence_no) from processing_steps').fetchone()[0]\n   244\t    conn.execute(\"insert into view_switches (view_id, open, reason, by_whom, after_seq) values ('v8', 0, ?, 'pull', ?)\", (reason, last_seq))\n   245\t    conn.commit()\n   246\t    conn.close()\n   247\t    views_db, items_db = service.open_ledger(str(copy)), store.open_read_only(str(items))\n   248\t    exposed = bundle.view_bundle(views_db, bundle.item_lookup(items_db), 'v8')\n   249\t    views_db.close()\n   250\t    items_db.close()\n   251\t    report, closed = build(copy, items, closing / 'package')\n   252\t    texts = [text for *_, text in fields(closed)]\n   253\t    results['closing'] = {'reason': reason, 'bundle_exposes_reason': any(s.get('reason') == reason for s in exposed['switches']),\n   254\t                          'package_open': by_id(closed)['v8']['open'], 'reason_absent': not any(reason in t for t in texts),\n   255\t                          'rung_label_inside_v8_fields': [(p, e, t[:120]) for q, p, e, t in fields(closed) if q == 'v8' and rung_label in t]}\n   256\t    (out / 'results.json').write_text(json.dumps(results, ensure_ascii=False, indent=1))\n   257\t    print(json.dumps({k: v for k, v in results.items() if k != 'stores'}, ensure_ascii=False, indent=1))\n   258\t    failures = [f'{name}: {key}' for name, s in results['stores'].items() for key in ('bytes_within_budget', 'seconds_within_budget') if not s[key]]\n   259\t    for name in STORES:                                          # the delivered identifiers, data and manifest, against the literal ones\n   260\t        delivered = json.loads((out / name / 'package' / release.MANIFEST_FILE).read_text())\n   261\t        failures += [] if (packages[name]['format'], packages[name]['allow_list'], delivered['format'], delivered['allow_list']) == (FORMAT, ALLOW_LIST, FORMAT, ALLOW_LIST) else [f'{name}: format or allow-list']\n   262\t    failures += [f'{name}: day, classes or evidence' for name, (day, classes, evidence) in EXPECTED.items()\n   263\t                 if (results['stores'][name]['as_of'], results['stores'][name]['counts']['questions'], results['stores'][name]['counts']['evidence']) != (day, classes, evidence)]\n   264\t    failures += [] if results['decisive']['forged_value_is_j1580'] else ['the forged value is not the system forecast j1580']\n   265\t    decisive = results['decisive']\n   266\t    failures += [f'kept {e}' for e in ('e2295', 'e1865', 'e3597')\n   267\t                 if not (decisive['kept'].get(e, {}).get('present') and decisive['kept'][e]['equal_to_store'] and decisive['kept'][e]['holds_its_wording'])]\n   268\t    expected_reasons = {'substituted_into_e2295_refused': 'question v8.evidence e2295.one_line: differs from the store',\n   269\t                        'added_to_manifest_refused': \"the manifest: keys off the allow-list ['note'], missing []\"}   # exact, so another refusal (a stale hash) does not count\n   270\t    failures += [k for k, reason in expected_reasons.items() if decisive[k] != reason]\n   271\t    failures += [] if (results['old-1/v8']['same_ids_as_service_evidence'] and results['old-1/v8']['forecast'] == MARKER\n   272\t                       and results['old-1/v8']['class'] == 'number' and results['old-1/v8']['evidence'] == 1284) else ['old-1/v8']\n   273\t    for name, leak in results['leaks'].items():\n   274\t        failures += [f'{name}: {k}' for k in ('label_kept', 'why_changed_absent', 'reasons_absent') if not leak[k]]\n   275\t        failures += [] if leak['answer'] == 'Yes' else [f'{name}: answer']\n   276\t        failures += [] if (leak['package_as_of'], leak['manifest_as_of'], leak['evidence']) == (DATED[name][0], DATED[name][0], DATED[name][1]) else [f'{name}: package day or evidence']\n   277\t        failures += [] if leak['latest_judgement'] == leak['expected_judgement'] else [f'{name}: judgement']\n   278\t        failures += [f'{name}: {phrase} found' for phrase, hits in leak['phrase_fields'].items() if hits]\n   279\t    failures += [] if (results['control']['id'], results['control']['answer']) == ('v3', 'Yes') and results['control']['label_equals_store'] and results['control']['evidence_equals_store'] else ['control']\n   280\t    closing = results['closing']\n   281\t    failures += [] if closing['reason'] == CLOSING_REASON and closing['bundle_exposes_reason'] and closing['package_open'] is False and closing['reason_absent'] else ['closing']\n   282\t    if failures:\n   283\t        raise SystemExit(f'release check FAILED: {failures}')\n   284\t    print('release check: every acceptance item and budget met; diagnostic hits to read by hand:',\n   285\t          {name: len(s['diagnostics']['hits']) for name, s in results['stores'].items()})\n   286\t\n   287\t\n   288\tif __name__ == '__main__':\n   289\t    main(sys.argv[1])\n42:    42\tFIXTURE_DATA_BYTES = 3313\n181:   181\t    \"\"\"A copy of the package's data with its manifest hash refreshed, so every other check still passes.\"\"\"\n184:   184\t    manifest = json.loads((package / release.MANIFEST_FILE).read_text())\n185:   185\t    manifest.update(as_of=data['as_of'], data_sha256=hashlib.sha256(payload).hexdigest())\n186:   186\t    (package / release.MANIFEST_FILE).write_text(json.dumps(manifest))\n208:   208\t    assert (data['format'], data['allow_list']) == ('hivemind-release/1', 'release-allow-list/1')     # revision 11's identifiers, literal\n301:   301\tdef test_9_package_files_hash_and_manifest(stores, tmp_path):\n306:   306\t    files = \"not exactly ['manifest.json', 'release-data.json']\"\n308:   308\t        'foreign file': (lambda p: (p / 'notes.txt').write_text('x'), lambda p: f\"{p}: holds ['manifest.json', 'notes.txt', 'release-data.json'], {files}\"),\n309:   309\t        'subdirectory': (lambda p: (p / 'extra').mkdir(), lambda p: f\"{p}: holds ['extra', 'manifest.json', 'release-data.json'], {files}\"),\n311:   311\t                         lambda p: 'the manifest sha256 does not match the data file'),\n312:   312\t        'manifest prose': (lambda p: (p / release.MANIFEST_FILE).write_text(json.dumps({**json.loads((p / release.MANIFEST_FILE).read_text()), 'note': 'About $390 billion'})),\n313:   313\t                           lambda p: \"the manifest: keys off the allow-list ['note'], missing []\"),\n314:   314\t        'manifest day': (lambda p: (p / release.MANIFEST_FILE).write_text(json.dumps({**json.loads((p / release.MANIFEST_FILE).read_text()), 'as_of': DAYS[0]})),\n315:   315\t                         lambda p: f\"the manifest as_of '{DAYS[0]}' differs from the data '{DAYS[2]}'\"),\n385:   385\t    \"\"\"§6 test 13: the items copy lacks item-3; the package copy drops every item-3 source, keeping e2 with none, its hash refreshed.\n415:   415\t    manifest = json.loads((repeated / release.MANIFEST_FILE).read_text())\n416:   416\t    manifest['data_sha256'] = hashlib.sha256(payload).hexdigest()\n417:   417\t    (repeated / release.MANIFEST_FILE).write_text(json.dumps(manifest))\n20:    'manifest keys unchecked': (R, \"    _keys(manifest, 'manifest', 'the manifest')\\n\", ''),\n45:    'canonical-day check removed': (R, \"    if day.isoformat() != text:\\n        raise ReleaseRefused\", \"    if False:\\n        raise ReleaseRefused\"),\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_16","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"python3 -B -c 'import json,pathlib\nroot=pathlib.Path(\\\"poc/data/release-check-2026-11-23g\\\")\nfor p in sorted(root.glob(\\\"old-*/*/release-data.json\\\")):\n if \\\"forged\\\" in str(p): continue\n b=p.read_bytes();d=json.loads(b);print(str(p.parent),d[\\\"as_of\\\"],len(d[\\\"questions\\\"]),sum((6-len(ch.encode()))*b.count(ch.encode()) for ch in \\\"<>&\\\\u2028\\\\u2029\\\"))\n for q in d[\\\"questions\\\"]:\n  if q[\\\"id\\\"] in (\\\"v8\\\",\\\"v10\\\",\\\"v36\\\"): print(q[\\\"id\\\"],q[\\\"question\\\"],q[\\\"open\\\"],q.get(\\\"forecast\\\",q.get(\\\"answer\\\")),len(q[\\\"evidence\\\"]))\n if p.parent==root/\\\"old-1/package\\\":\n  v8=next(q for q in d[\\\"questions\\\"] if q[\\\"id\\\"]==\\\"v8\\\"); print(\\\"sample\\\",v8[\\\"evidence\\\"][0]);print(\\\"longest address\\\",max(len(s[\\\"uri\\\"]) for e in v8[\\\"evidence\\\"] for s in e[\\\"sources\\\"]))'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
