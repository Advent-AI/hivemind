40\t      \"basis\": \"third_party\",\n   141\t      \"value\": null,\n   142\t      \"low\": 720,\n   143\t      \"high\": 745,\n   144\t      \"unit\": \"USD bn\",\n   145\t      \"evidence_id\": \"e5014\",\n   146\t      \"quote_number\": \"$720 billion to $745 billion\",\n   147\t      \"qualifier\": \"roughly\",\n   148\t      \"inputs\": null,\n   149\t      \"operation\": null,\n   150\t      \"basis_text\": null,\n   151\t      \"rests_on\": null,\n   152\t      \"outcome_for\": [],\n   153\t      \"reference_for\": [\"v6\"]\n   154\t    },\n   155\t    {\n   156\t      \"id\": \"F9\",\n   157\t      \"what\": {\"population\": \"Microsoft\", \"measure\": \"capital expenditure\", \"scope\": \"implied by the four-company tally less the three guided companies\", \"period\": \"CY2026\"},\n   158\t      \"kind\": \"computed\",\n   159\t      \"basis\": \"third_party\",\n   160\t      \"value\": null,\n   161\t      \"low\": 150,\n   162\t      \"high\": 205,\n   163\t      \"unit\": \"USD bn\",\n   164\t      \"evidence_id\": null,\n   165\t      \"quote_number\": null,\n   166\t      \"qualifier\": null,\n   167\t      \"inputs\": [\"F8\", \"F4\"],\n   168\t      \"operation\": \"difference\",\n   169\t      \"basis_text\": null,\n   170\t      \"rests_on\": null,\n   171\t      \"outcome_for\": [],\n   172\t      \"reference_for\": []\n   173\t    },\n   174\t    {\n   175\t      \"id\": \"F10\",\n   176\t      \"what\": {\"population\": \"Microsoft\", \"measure\": \"capital expenditure\", \"scope\": \"total\", \"period\": \"CY2026\"},\n   177\t      \"kind\": \"estimate\",\n   178\t      \"basis\": \"forecast\",\n   179\t      \"value\": 165,\n   180\t      \"low\": null,\n   181\t      \"high\": null,\n   182\t      \"unit\": \"USD bn\",\n   183\t      \"evidence_id\": null,\n   184\t      \"quote_number\": null,\n   185\t      \"qualifier\": null,\n   186\t      \"inputs\": null,\n   187\t      \"operation\": null,\n   188\t      \"basis_text\": \"My estimate of Microsoft's calendar-2026 capital expenditure; no calendar-year guidance is shown. The January-March 2026 quarter (fiscal Q3) was $30.88bn, up 84% from a year earlier (F5, F6). A continued sequential rise of about 16% a quarter, the pace that compounds to roughly 84% over a year and is supported by the $678bn Azure backlog (F7), gives about 30.9 + 35.8 + 41.6 + 48.2 = $156bn; the four-company tally less the three guided companies implies $150-205bn (F9). $165bn follows the run-rate path and moves partway into the tally-implied range, staying in its lower part because the run-rate is the only Microsoft-specific number.\",\n   189\t      \"rests_on\": [\"F5\", \"F6\", \"F7\", \"F9\"],\n   190\t      \"outcome_for\": [],\n   191\t      \"reference_for\": []\n   192\t    },\n   193\t    {\n   194\t      \"id\": \"F11\",\n   195\t      \"what\": {\"population\": \"four largest AI hyperscalers\", \"measure\": \"capital expenditure\", \"scope\": \"combined\", \"period\": \"CY2026\"},\n   196\t      \"kind\": \"computed\",\n   197\t      \"basis\": \"forecast\",\n   198\t      \"value\": 720,\n   199\t      \"low\": null,\n   200\t      \"high\": null,\n   201\t      \"unit\": \"USD bn\",\n   202\t      \"evidence_id\": null,\n   203\t      \"quote_number\": null,\n   204\t      \"qualifier\": null,\n   205\t      \"inputs\": [\"F4\", \"F10\"],\n   206\t      \"operation\": \"sum\",\n   207\t      \"basis_text\": null,\n   208\t      \"rests_on\": null,\n   209\t      \"outcome_for\": [],\n   210\t      \"reference_for\": []\n   211\t    },\n   212\t    {\n   213\t      \"id\": \"F12\",\n   214\t      \"what\": {\"population\": \"Amazon, Meta Platforms, Microsoft and Alphabet\", \"measure\": \"AI infrastructure spending\", \"scope\": \"combined\", \"period\": \"CY2026\"},\n   215\t      \"kind\": \"source\",\n   216\t      \"basis\": \"guidance\",\n   217\t      \"value\": 730,\n   218\t      \"low\": null,\n   219\t      \"high\": null,\n   220\t      \"unit\": \"USD bn\",\n   221\t      \"evidence_id\": \"e1947\",\n   222\t      \"quote_number\": \"$730 billion\",\n   223\t      \"qualifier\": \"more than\",\n   224\t      \"inputs\": null,\n   225\t      \"operation\": null,\n   226\t      \"basis_text\": null,\n   227\t      \"rests_on\": null,\n   228\t      \"outcome_for\": [],\n   229\t      \"reference_for\": []\n   230\t    },\n   231\t    {\n   232\t      \"id\": \"F13\",\n   233\t      \"what\": {\"population\": \"Meta Platforms\", \"measure\": \"AI capital expenditure\", \"scope\": \"total\", \"period\": \"CY2026\"},\n   234\t      \"kind\": \"source\",\n   235\t      \"basis\": \"third_party\",\n   236\t      \"value\": 130,\n   237\t      \"low\": null,\n   238\t      \"high\": null,\n   239\t      \"unit\": \"USD bn\",\n   240\t      \"evidence_id\": \"e3686\",\n   241\t      \"quote_number\": \"$130 billion\",\n   242\t      \"qualifier\": \"none\",\n   243\t      \"inputs\": null,\n   244\t      \"operation\": null,\n   245\t      \"basis_text\": null,\n   246\t      \"rests_on\": null,\n   247\t      \"outcome_for\": [],\n   248\t      \"reference_for\": []\n   249\t    },\n   250\t    {\n   251\t      \"id\": \"F14\",\n   252\t      \"what\": {\"population\": \"four largest AI hyperscalers\", \"measure\": \"data-center share of capital expenditure\", \"scope\": \"combined\", \"period\": \"CY2026\"},\n   253\t      \"kind\": \"estimate\",\n   254\t      \"basis\": \"forecast\",\n   255\t      \"value\": 98,\n   256\t      \"low\": null,\n   257\t      \"high\": null,\n   258\t      \"unit\": \"%\",\n   259\t      \"evidence_id\": null,\n   260\t      \"quote_number\": null,\n   261\t      \"qualifier\": null,\n   262\t      \"inputs\": null,\n   263\t      \"operation\": null,\n   264\t      \"basis_text\": \"My estimate of the share of the four companies' 2026 capital expenditure that is data-center (AI infrastructure) spending. The companies' indicated AI-infrastructure total, more than $730bn (F12), is at or above the total-capex tally of $720-745bn (F8), which puts the share near 100%; Meta's planned AI capex of $130bn (F13) sits inside its $125-145bn total guidance (F2), about 96% of the midpoint; Amazon's raise to $220bn was mostly memory-chip costs, i.e. server hardware (e1649); outside estimates put spending on data centers at about $750bn (e1416, e4082). No passage sizes non-data-center spending such as offices or logistics, so I keep a 2% residual; the passages bound the share between about 96% and 100%.\",\n   265\t      \"rests_on\": [\"F12\", \"F8\", \"F13\", \"F2\", \"e1649\", \"e1416\", \"e4082\"],\n   266\t      \"outcome_for\": [],\n   267\t      \"reference_for\": []\n   268\t    },\n   269\t    {\n   270\t      \"id\": \"F15\",\n   271\t      \"what\": {\"population\": \"four largest AI hyperscalers\", \"measure\": \"data-center capex\", \"scope\": \"combined\", \"period\": \"CY2026\"},\n   272\t      \"kind\": \"computed\",\n   273\t      \"basis\": \"forecast\",\n   274\t      \"value\": 705.6,\n   275\t      \"low\": null,\n   276\t      \"high\": null,\n   277\t      \"unit\": \"USD bn\",\n   278\t      \"evidence_id\": null,\n   279\t      \"quote_number\": null,\n   280\t      \"qualifier\": null,\n   281\t      \"inputs\": [\"F11\", \"F14\"],\n   282\t      \"operation\": \"share\",\n   283\t      \"basis_text\": null,\n   284\t      \"rests_on\": null,\n   285\t      \"outcome_for\": [\"v6\"],\n   286\t      \"reference_for\": []\n   287\t    },\n   288\t    {\n   289\t      \"id\": \"F16\",\n   290\t      \"what\": {\"population\": \"four largest hyperscalers\", \"measure\": \"capital expenditure\", \"scope\": \"combined\", \"period\": \"CY2026\"},\n   291\t      \"kind\": \"source\",\n   292\t      \"basis\": \"third_party\",\n   293\t      \"value\": 745,\n   294\t      \"low\": null,\n   295\t      \"high\": null,\n   296\t      \"unit\": \"USD bn\",\n   297\t      \"evidence_id\": \"e1856\",\n   298\t      \"quote_number\": \"$745 billion\",