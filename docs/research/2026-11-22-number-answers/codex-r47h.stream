{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba paid_gate.py | sed -n '141,282p;445,457p;605,633p;690,748p'\"","aggregated_output":"   141\t    def __init__(self, out, transport, ledger=None):\n   142\t        self.out, self.transport, self.ledger = out, transport, ledger\n   143\t        self.cfg = config.load(str(CONFIG))\n   144\t        self.lock = threading.Lock()\n   145\t        (out / 'archives').mkdir(parents=True, exist_ok=True)\n   146\t\n   147\t    def request(self, it, user):\n   148\t        return model.build_request(self.cfg.rejudging, it['system'], user, it['schema'], 'judgement', self.cfg.provider)\n   149\t\n   150\t    def record(self, line):\n   151\t        \"\"\"[47g] Scored first attempts go to answers.jsonl, diagnostic retries to retries.jsonl, so damage to a retry's record can be\n   152\t        seen without touching the scored record.\"\"\"\n   153\t        name = 'answers.jsonl' if line['attempt'] == 1 else 'retries.jsonl'\n   154\t        with self.lock, open(self.out / name, 'a') as handle:\n   155\t            handle.write(json.dumps(line, ensure_ascii=False) + '\\n')\n   156\t\n   157\t    def attempt(self, it, draw, user, n):\n   158\t        name = f'{it[\"unit\"]}-{it[\"arm\"]}-d{draw}-a{n}.sqlite'\n   159\t        archive = model.Archive(str(self.out / 'archives' / name))\n   160\t        line = {'unit': it['unit'], 'arm': it['arm'], 'draw': draw, 'attempt': n,\n   161\t                'request_sha256': model.request_identity(self.request(it, user))[1]}\n   162\t        self.record(dict(line, status='started'))                          # [47.3] recorded before the provider is called\n   163\t        data = None\n   164\t        try:\n   165\t            answer = model.call(archive, self.cfg, self.cfg.rejudging, it['system'], user, it['schema'], 'judgement', 'judge', transport=self.transport)\n   166\t            data = answer.data\n   167\t            line.update(cost_usd=answer.cost_usd, data=data)\n   168\t            calc = strip(data)\n   169\t            result = cc.check(it['family'], it['passages'], calc)\n   170\t            decision = cc.publish_decision(it['family'], calc, result)\n   171\t            line.update(status='answered', errors=result['errors'], recorded=result['recorded'], published=result.get('published'), decision=decision)\n   172\t        except model.SchemaError as error:\n   173\t            row = archive.conn.execute('select response_json from model_calls order by call_id desc limit 1').fetchone()\n   174\t            line.update(status='format invalid', error=str(error)[:500], decision='refused', errors=[('schema', str(error)[:300])],\n   175\t                        raw=row[0] if row and row[0] else None)           # [47f.2] whole, as the archive stores it\n   176\t        except model.TransportError as error:\n   177\t            line.update(status='transport error', error=str(error)[:500], decision='transport')\n   178\t        except Exception as error:                                       # [47.3] a checker failure is recorded with the raw answer and refused\n   179\t            line.update(status='checker error', error=f'{type(error).__name__}: {error}'[:500], decision='refused',\n   180\t                        errors=[('checker', f'{type(error).__name__}: {error}'[:300])], data=data)\n   181\t        self.record(line)\n   182\t        return line\n   183\t\n   184\t    def stopped(self):\n   185\t        return self.ledger is not None and self.ledger.read().get('stopped')\n   186\t\n   187\t    def run(self, items):\n   188\t        \"\"\"[47f.1] Every first attempt (the scored ones) is sent before any retry (diagnostic only), so a retry's cost or failure can\n   189\t        never stop a scored attempt from being sent.\"\"\"\n   190\t        try:\n   191\t            refused = []\n   192\t            for draw in DRAWS:\n   193\t                for it in items:\n   194\t                    if not self.stopped():\n   195\t                        first = self.attempt(it, draw, it['user'], 1)\n   196\t                        if first['decision'] == 'refused':\n   197\t                            refused.append((it, draw, first))\n   198\t            for it, draw, first in refused:\n   199\t                if not self.stopped():\n   200\t                    reasons = '; '.join(f'{c}: {d}' for c, d in first.get('errors', []))[:4000]\n   201\t                    self.attempt(it, draw, it['user'] + RETRY_MARK + reasons, 2)\n   202\t        finally:                                          # [47b.2] the results come from the attempt records, written even after an abort\n   203\t            summary = summarise(self.out, items, self.ledger.read() if self.ledger else None)\n   204\t        return summary\n   205\t\n   206\t\n   207\tJOURNALS = ('answers.jsonl', 'retries.jsonl')\n   208\t\n   209\t\n   210\tdef attempt_records(out, damaged=None):\n   211\t    \"\"\"The committed entries of both journals, split on the writer's own delimiter ('\\\\n' only: an answer may hold other Unicode line\n   212\t    separators). A line that does not parse (a write torn by a crash) is skipped and listed in `damaged` with its journal, so its\n   213\t    attempt counts as unfinished.\"\"\"\n   214\t    records = []\n   215\t    for name in JOURNALS:\n   216\t        path = out / name\n   217\t        text = path.read_text(encoding='utf-8', errors='replace') if path.exists() else ''\n   218\t        for number, line in enumerate(text.split('\\n'), 1):\n   219\t            if not line:\n   220\t                continue\n   221\t            try:\n   222\t                records.append(json.loads(line))\n   223\t            except json.JSONDecodeError:\n   224\t                if damaged is not None:\n   225\t                    damaged.append({'journal': name, 'line': number, 'text': line[:200]})\n   226\t    return records\n   227\t\n   228\t\n   229\tATTEMPT_FIELDS = ('attempt', 'status', 'decision', 'errors', 'data', 'raw')\n   230\t\n   231\t\n   232\tdef first_attempt(entry):\n   233\t    \"\"\"[47e.1] The attempt that is scored: the first one, on both arms (a retry is diagnostic). No attempt: not sent.\"\"\"\n   234\t    attempts = sorted(entry.get('attempts') or [], key=lambda a: a['attempt'])\n   235\t    return attempts[0] if attempts else {'attempt': 1, 'status': 'not sent', 'decision': 'not sent'}\n   236\t\n   237\t\n   238\tdef derive_finals(out, items, damaged=None):\n   239\t    \"\"\"Each planned unit and draw: 'dispatched' (a started line), 'completed' (a finished line), and the decision of its last finished\n   240\t    attempt (a second refusal is unresolved). A unit with no started line is not sent; one started but not finished is interrupted.\"\"\"\n   241\t    records = attempt_records(out, damaged)\n   242\t    finals = {}\n   243\t    for it in items:\n   244\t        for draw in DRAWS:\n   245\t            mine = [r for r in records if r['unit'] == it['unit'] and r['arm'] == it['arm'] and r['draw'] == draw]\n   246\t            started = [r for r in mine if r['status'] == 'started']\n   247\t            done = [r for r in mine if r['status'] != 'started']\n   248\t            key = f'{it[\"unit\"]}|{it[\"arm\"]}|{draw}'\n   249\t            if not started:\n   250\t                finals[key] = {'decision': 'not sent', 'attempts': []}\n   251\t                continue\n   252\t            if len(done) < len(started):\n   253\t                unfinished = [{'attempt': r['attempt'], 'status': 'interrupted', 'decision': 'interrupted'} for r in started\n   254\t                              if r['attempt'] not in {d['attempt'] for d in done}]\n   255\t                finals[key] = {'decision': 'interrupted', 'attempts': [{k: r.get(k) for k in ATTEMPT_FIELDS} for r in done] + unfinished}\n   256\t                continue\n   257\t            last = done[-1]\n   258\t            decision = last['decision']\n   259\t            if decision == 'refused':                          # a second refusal is unresolved; a first with no retry sent is incomplete\n   260\t                decision = 'unresolved' if len(done) >= 2 else 'retry not sent'\n   261\t            finals[key] = {k: last.get(k) for k in ('status', 'data', 'errors', 'recorded', 'published')}\n   262\t            finals[key].update(decision=decision, attempts=[{k: r.get(k) for k in ATTEMPT_FIELDS} for r in done])\n   263\t    return finals\n   264\t\n   265\t\n   266\tdef summarise(out, items, ledger_state):\n   267\t    damaged = []\n   268\t    finals = derive_finals(out, items, damaged)\n   269\t    reconciled = {}\n   270\t    for draw_store, total, dc in PAIRS:                     # the separate arm, reconciled over the pair's family\n   271\t        for draw in DRAWS:\n   272\t            a, b = (first_attempt(finals.get(f'pair-{draw_store}|separate-{m[0]}|{draw}', {})) for m in (total, dc))   # [47e.1]\n   273\t            if a.get('decision') != 'publish' or b.get('decision') != 'publish':\n   274\t                reconciled[f'pair-{draw_store}|{draw}'] = {'decision': 'not reconciled', 'members': [a.get('decision'), b.get('decision')]}\n   275\t                continue\n   276\t            family = pair_family(draw_store, total, dc)\n   277\t            merged = merge([(total[0], strip(a['data'])), (dc[0], strip(b['data']))], {cc._key(s) for s in family['shared']})\n   278\t            pas = next(i['passages'] for i in items if i['unit'] == f'pair-{draw_store}' and i['arm'] == 'joint')\n   279\t            result = cc.check(family, pas, {k: merged[k] for k in ('figures', 'answers')})\n   280\t            reconciled[f'pair-{draw_store}|{draw}'] = {'decision': cc.publish_decision(family, merged, result), 'errors': result['errors'],\n   281\t                                                     'published': result.get('published'), 'calc': merged}\n   282\t    summary = {'finals': finals, 'reconciled': reconciled, 'ledger': ledger_state, 'damaged': damaged}\n   445\t        answers.append(a2)\n   446\t    return {'figures': out, 'answers': answers}, rename\n   447\t\n   448\t\n   449\tdef run_digest(out):\n   450\t    h = hashlib.sha256()\n   451\t    for name in ('answers.jsonl', 'retries.jsonl', 'results.json', 'plan.json'):\n   452\t        path = out / name\n   453\t        h.update(name.encode() + b'\\0' + (path.read_bytes() if path.exists() else b''))\n   454\t    return h.hexdigest()\n   455\t\n   456\t\n   457\tdef card_view(calc, view_id, recorded, prefix=''):\n   605\tdef packets(out, key_dir):\n   606\t    if (key_dir / 'packet-key.json').exists():            # [47b.4] the inventory and key are frozen once made\n   607\t        raise SystemExit(f'{key_dir / \"packet-key.json\"} exists: the packets are frozen; refused')\n   608\t    results = json.loads((out / 'results.json').read_text())\n   609\t    items = {(i['unit'], i['arm']): i for i in json.loads((out / 'plan.json').read_text())}\n   610\t    rng = random.Random(secrets.randbits(64))\n   611\t    unit_keys = sorted(packet_units(results, items))\n   612\t    rng.shuffle(unit_keys)\n   613\t    earlier = sorted((k.split('|')[0], k.split('|')[1], k.split('|')[2], v, a['attempt'])     # every retry, and every format failure\n   614\t                     for k, e in results['finals'].items() for a in (e.get('attempts') or [])\n   615\t                     if a['attempt'] >= 2 or a.get('status') == 'format invalid'\n   616\t                     for v in items[tuple(k.split('|')[:2])]['members'])\n   617\t    rng.shuffle(earlier)\n   618\t    key = {'salt': secrets.token_hex(16), 'run_digest': run_digest(out), 'order': [(f'P{n:02d}', list(u)) for n, u in enumerate(unit_keys, 1)],\n   619\t           'attempts': [(f'D{n:02d}', list(e)) for n, e in enumerate(earlier, 1)]}\n   620\t    text = render_packets(out, key)[0]\n   621\t    attempts_text = render_attempts(out, key['attempts'])          # [47f.2] both rendered before anything is written\n   622\t    if (out / 'packets.md').exists() or (out / 'attempts.md').exists():\n   623\t        raise SystemExit(f'{out} already holds packets; refused')\n   624\t    key_dir.mkdir(parents=True, exist_ok=True)\n   625\t    with open(key_dir / 'packet-key.json', 'x') as handle:\n   626\t        json.dump(key, handle, indent=1)\n   627\t    with open(out / 'packets.md', 'x') as handle:\n   628\t        handle.write(text)\n   629\t    with open(out / 'attempts.md', 'x') as handle:\n   630\t        handle.write(attempts_text)\n   631\t    print(f'{len(key[\"order\"])} packets, {len(key[\"attempts\"])} diagnostic attempts; key in {key_dir}')\n   632\t\n   633\t\n   690\t\n   691\t\n   692\tdef score(out, key_dir):\n   693\t    \"\"\"D725's registered lines on the sealed readings, bound to this run.\"\"\"\n   694\t    frozen = json.loads((key_dir / 'packet-key.json').read_text())\n   695\t    submitted = json.loads((out / 'readings.json').read_text())\n   696\t    problems = [] if frozen.get('run_digest') == run_digest(out) else ['the packet key does not belong to this run']   # [47b.4]\n   697\t    text, key, units = render_packets(out, frozen)                  # [47c.2] every packet rendered again from the run\n   698\t    if sorted(tuple(u) for _, u in frozen['order']) != sorted(units):\n   699\t        problems.append('the key does not map one packet to each unit of the run')\n   700\t    sha = hashlib.sha256(text.encode()).hexdigest()\n   701\t    packets_path = out / 'packets.md'\n   702\t    written = packets_path.read_text() if packets_path.exists() else ''\n   703\t    if not written.startswith(f'Key commitment: {key_commitment(frozen)}\\n'):      # [47d.1] the mapping the readers' text committed to\n   704\t        problems.append('the key is not the one packets.md committed to')\n   705\t    if hashlib.sha256(written.encode()).hexdigest() != sha:\n   706\t        problems.append('packets.md is not the text the run and the key give')\n   707\t    if submitted.get('packets_sha256') != sha:\n   708\t        problems.append('the readings were not made on the frozen packets')\n   709\t    readings = submitted.get('packets', {})\n   710\t    results = json.loads((out / 'results.json').read_text())\n   711\t    problems += [f'answers.jsonl line {d[\"line\"]} is damaged' for d in results.get('damaged', [])\n   712\t                 if d.get('journal') == 'answers.jsonl']                     # [47g] a damaged retry record stays diagnostic\n   713\t    scored = {k: first_attempt(v)['decision'] for k, v in results['finals'].items()}            # [47f.1] completeness from the scored attempts\n   714\t    problems += [f'{k}: {d}' for k, d in scored.items() if d not in ('publish', 'held', 'refused')]               # [47b.2] from the records\n   715\t    problems += [f'{pid}: not read' for pid in key if pid not in readings] + [f'{pid}: not a packet' for pid in readings if pid not in key]\n   716\t    usable_pairs = {'joint': {}, 'separate': {}}\n   717\t    defects = []\n   718\t    for pid, k in key.items():\n   719\t        if pid not in readings:\n   720\t            continue\n   721\t        final, probs = final_readings(pid, readings[pid], list(k['cards']), k['grounds'])\n   722\t        problems += probs\n   723\t        if final is None:\n   724\t            continue\n   725\t        if k['decision'] == 'publish' and k['arm'] in ('joint', 'single'):      # D725: defects across the joint and singleton answers\n   726\t            for v, r in final.items():\n   727\t                if 'yes' in (r['contradiction'], r['internal_reference'], r['deciding_gap']):\n   728\t                    defects.append((pid, k['unit'], k['arm'], k['cards'][v]))\n   729\t        if k['unit'].startswith('pair') and k['arm'] in usable_pairs:\n   730\t            usable_pairs[k['arm']].setdefault(k['unit'], []).append(k['decision'] == 'publish' and all(r['usable'] == 'yes' for r in final.values()))\n   731\t    joint_total = sum(sum(v) for v in usable_pairs['joint'].values())\n   732\t    separate_total = sum(sum(v) for v in usable_pairs['separate'].values())\n   733\t    per_snapshot = {u: sum(v) for u, v in usable_pairs['joint'].items()}\n   734\t    complete = (not problems and len(key) == 27 and len(usable_pairs['joint']) == 3 and len(usable_pairs['separate']) == 3\n   735\t                and all(len(v) == 3 for arm in usable_pairs.values() for v in arm.values()))\n   736\t    passes = complete and not defects and joint_total >= 8 and all(n >= 2 for n in per_snapshot.values()) and joint_total - separate_total >= 3\n   737\t    summary = {'complete': complete, 'problems': problems[:20], 'joint usable pairs': joint_total, 'separate usable pairs': separate_total,\n   738\t               'joint per snapshot': per_snapshot, 'published defects': defects,\n   739\t               'verdict': 'PASS' if passes else ('INCOMPLETE' if not complete else 'STOP')}\n   740\t    print(json.dumps(summary, indent=1))\n   741\t    return summary\n   742\t\n   743\t\n   744\tif __name__ == '__main__':\n   745\t    cmd = sys.argv[1] if len(sys.argv) > 1 else ''\n   746\t    if cmd == 'plan' and len(sys.argv) == 3:\n   747\t        plan(sys.argv[2])\n   748\t    elif cmd == 'send' and len(sys.argv) == 5 and not sys.argv[2].startswith('-'):\n","exit_code":0,"status":"completed"}}
