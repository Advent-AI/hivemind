{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba paid_gate.py | sed -n '365,422p'; rg -n 'PRICES|gpt-6-luna\\\\b|CACHED_INPUT_SHARE' ../../../src/hivemind/model.py ../../../poc/config/poc-v118.json; nl -ba ../../../clean-arch/e2e-comparison-2026-11-13/budget_replay.py | sed -n '131,145p;227,234p;268,291p'\"","aggregated_output":"   365\tdef recover(out):\n   366\t    \"\"\"Read-only: rebuild results.json from the journal of a stopped run; nothing is sent.\"\"\"\n   367\t    items = json.loads((out / 'plan.json').read_text())\n   368\t    ledger = json.loads((out / 'ledger.json').read_text()) if (out / 'ledger.json').exists() else None\n   369\t    summary = summarise(out, items, ledger)\n   370\t    print(json.dumps({'damaged': summary['damaged'], 'finals': {k: v['decision'] for k, v in summary['finals'].items()}}, indent=1))\n   371\t    return summary\n   372\t\n   373\t\n   374\tdef budget_module():\n   375\t    import importlib.util\n   376\t    spec = importlib.util.spec_from_file_location('budget_replay_v13', REPO / 'clean-arch/e2e-comparison-2026-11-13/budget_replay.py')\n   377\t    module = importlib.util.module_from_spec(spec)\n   378\t    spec.loader.exec_module(module)\n   379\t    return module\n   380\t\n   381\t\n   382\tdef send(out, approved, plan_path):\n   383\t    if APPROVED_CEILING is None or approved != APPROVED_CEILING:\n   384\t        raise SystemExit(f'the approved ceiling is {APPROVED_CEILING} (Alex names it); refused')\n   385\t    if out.exists():\n   386\t        raise SystemExit(f'{out} exists: the gate starts from an empty folder')\n   387\t    text = Path(plan_path).read_text()\n   388\t    if hashlib.sha256(text.encode()).hexdigest() != PINNED_PLAN_SHA256:          # [47.2] only the reviewed plan\n   389\t        raise SystemExit('the plan is not the reviewed one (sha256 differs); refused')\n   390\t    AUTH.parent.mkdir(parents=True, exist_ok=True)\n   391\t    try:                                                                     # [47.2] one authorization, one ledger, one launch\n   392\t        with open(AUTH, 'x') as handle:\n   393\t            json.dump({'plan_sha256': PINNED_PLAN_SHA256, 'ceiling': approved, 'out': str(out)}, handle)\n   394\t    except FileExistsError:\n   395\t        raise SystemExit(f'{AUTH} exists: this authorization was already used; refused')\n   396\t    items = json.loads(text)\n   397\t    if len({(i['unit'], i['arm']) for i in items}) != len(items):\n   398\t        raise SystemExit('duplicate (unit, arm) in the plan; refused')\n   399\t    out.mkdir(parents=True)\n   400\t    (out / 'plan.json').write_text(json.dumps(items))\n   401\t    budget = budget_module()\n   402\t    budget.SharedLedger.init(str(out / 'ledger.json'), approved)\n   403\t    ledger = budget.SharedLedger(str(out / 'ledger.json'))\n   404\t    lock_handle = open(out / 'gate.launcher.lock', 'a+')\n   405\t    if not ledger.claim_launcher('v13-gate', lock_handle):\n   406\t        raise SystemExit('another launch is running')\n   407\t    remove_gate = budget.install_stop_gate(ledger)\n   408\t    try:\n   409\t        summary = Gate(out, budget.BudgetTransport(ledger), ledger).run(items)\n   410\t    finally:\n   411\t        remove_gate()\n   412\t        ledger.remove_launcher('v13-gate')\n   413\t    print(json.dumps({k: v.get('decision') for k, v in summary['finals'].items()}, indent=1))\n   414\t\n   415\t\n   416\t# ---------- blind reading ----------\n   417\tQUESTIONS = {'usable': 'the outcome is usable and supported by the shown passages it rests on',\n   418\t             'contradiction': 'with the other card of its packet, it states a hard numerical contradiction',\n   419\t             'internal_reference': \"the system's own forecast is presented as the market's expectation\",\n   420\t             'deciding_gap': 'an unresolved overlap, a change of scope or an unsized adjustment decides its band'}\n   421\t\n   422\t\n../../../src/hivemind/model.py:31:# cached 2026-11-03); Alex's Opus trial only (2026-11-16, \"你试试看opus\"). Cache reads ($0.20) are priced at CACHED_INPUT_SHARE, an over-estimate.\n../../../src/hivemind/model.py:32:# gpt-6-luna: the published standard rates on 2026-10-25 (developers.openai.com/api/docs/models/gpt-6-luna: $0.10/M input, $0.50/M output,\n../../../src/hivemind/model.py:35:PRICES = {'gpt-6-luna': (0.10, 0.50), 'gpt-6.1-sol': (2.00, 10.00), 'gpt-6-astra': (10.00, 50.00), 'claude-opus-5-5': (4.00, 20.00), 'deepseek-flash': (0.30, 1.20), 'deepseek-v4-pro': (1.32, 3.96),\n../../../src/hivemind/model.py:37:CACHED_INPUT_SHARE = 0.10          # cached input tokens are priced at 10% of the input rate (gpt-6-luna page, read again 2026-10-27)\n../../../src/hivemind/model.py:279:    price_in, price_out = PRICES.get(setting.model, (0.0, 0.0))\n../../../src/hivemind/model.py:280:    cost = round((input_tokens - cached_tokens) / 1e6 * price_in + cached_tokens / 1e6 * price_in * CACHED_INPUT_SHARE + output_tokens / 1e6 * price_out, 6)\n../../../poc/config/poc-v118.json:8:      \"model\": \"gpt-6-luna\",\n../../../poc/config/poc-v118.json:14:      \"model\": \"gpt-6-luna\",\n../../../poc/config/poc-v118.json:20:      \"model\": \"gpt-6-luna\",\n../../../poc/config/poc-v118.json:26:      \"model\": \"gpt-6-luna\",\n../../../poc/config/poc-v118.json:32:      \"model\": \"gpt-6-luna\",\n../../../poc/config/poc-v118.json:38:      \"model\": \"gpt-6-luna\",\n../../../poc/config/poc-v118.json:44:      \"model\": \"gpt-6-luna\",\n../../../poc/config/poc-v118.json:50:      \"model\": \"gpt-6-luna\",\n../../../poc/config/poc-v118.json:56:      \"model\": \"gpt-6-luna\",\n../../../poc/config/poc-v118.json:62:      \"model\": \"gpt-6-luna\",\n../../../poc/config/poc-v118.json:76:    \"model\": \"gpt-6-luna\",\n../../../poc/config/poc-v118.json:82:    \"model\": \"gpt-6-luna\",\n../../../poc/config/poc-v118.json:88:    \"model\": \"gpt-6-luna\",\n../../../poc/config/poc-v118.json:94:    \"model\": \"gpt-6-luna\",\n   131\t    def reserve(self, amount):\n   132\t        with self._locked() as state:\n   133\t            granted = not (state.get('stopped') or state['overrun'] or state['spent'] + state['reserved'] + amount > state['ceiling'])\n   134\t            if granted:\n   135\t                state['reserved'] += amount\n   136\t                state['attempts'] += 1\n   137\t            else:\n   138\t                state['refused'] += 1\n   139\t                if not state.get('stopped'):\n   140\t                    state['stopped'] = True\n   141\t                    state['stop_reason'] = 'overrun' if state['overrun'] else f'a reservation of ${amount:.6f} would pass the ${state[\"ceiling\"]:.2f} ceiling'\n   142\t        if not granted:\n   143\t            self._note({'refused': amount})                  # after the stop is saved\n   144\t            return False\n   145\t        _LIVE.depth = getattr(_LIVE, 'depth', 0) + 1\n   227\tdef llm_estimate(request):\n   228\t    price_in, price_out = model.PRICES[request['model']]\n   229\t    cap = request.get('max_completion_tokens', request.get('max_tokens'))\n   230\t    if isinstance(cap, bool) or not isinstance(cap, int) or cap <= 0:\n   231\t        raise model.TransportError('request without a positive output cap: refused by the budget')\n   232\t    tokens_in = 2 * len(json.dumps(request).encode('utf-8')) + 4096\n   233\t    return (tokens_in * price_in + cap * price_out) / 1e6\n   234\t\n   268\t    def __call__(self, *args):\n   269\t        if len(args) == 1:\n   270\t            return self._jev(args[0])\n   271\t        provider, request = args\n   272\t        for attempt in range(3):\n   273\t            estimate = llm_estimate(request)\n   274\t            if not self.ledger.reserve(estimate):\n   275\t                raise model.TransportError('the shared budget ceiling would be passed: not sent')\n   276\t            try:\n   277\t                response = model.openai_transport(provider, request, max_attempts=1)\n   278\t            except model.TransportError as error:\n   279\t                self.ledger.settle(estimate, estimate)\n   280\t                status = getattr(error, 'http_status', None)\n   281\t                if status in CLIENT_ERRORS or attempt == 2 or (status is not None and status != 429 and status < 500):\n   282\t                    raise\n   283\t                self.sleep(5 * (attempt + 1))\n   284\t                continue\n   285\t            except Exception:\n   286\t                self.ledger.settle(estimate, estimate)\n   287\t                raise\n   288\t            cost = llm_cost(response, request)\n   289\t            self.ledger.settle(estimate, estimate if cost is None else cost)\n   290\t            return response\n   291\t        raise model.TransportError('no answer after three attempts')\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_10","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"python3 -B -c 'import contextlib, io, json\nimport paid_gate as pg, paid_rehearsal as pr\nfiles={}\nclass Mem:\n    def __init__(self, path): self.path = path\n    def __truediv__(self, name): return Mem(self.path+'\\\\''/'\\\\''+name)\n    def read_text(self, **kwargs): return files[self.path]\n    def read_bytes(self): return self.read_text().encode()\n    def write_text(self, data): files[self.path] = data\n    def exists(self): return self.path in files\nout=Mem('\\\\''run'\\\\'')\nkeys=Mem('\\\\''keys'\\\\'')\n(out/'\\\\''plan.json'\\\\'').write_text(json.dumps(pr.PLAN))\njournal=[]\nfor draw in pg.DRAWS:\n    for item in pr.PLAN:\n        base=dict(unit=item['\\\\''unit'\\\\''], arm=item['\\\\''arm'\\\\''], draw=draw, attempt=1)\n        bad=(item['\\\\''unit'\\\\''],draw)==('\\\\''single-E'\\\\'',3)\n        data=pr.valid_answer(item,'\\\\''bad-rung'\\\\'' if bad else '\\\\''ok'\\\\'')\n        if (item['\\\\''unit'\\\\''],item['\\\\''arm'\\\\''],draw)==('\\\\''pair-old-1'\\\\'','\\\\''joint'\\\\'',1):\n            data['\\\\''answers'\\\\''][0]['\\\\''reasons'\\\\'']='\\\\''first'\\\\''+chr(0x2028)+'\\\\''second'\\\\''+chr(0x85)+'\\\\''third'\\\\''+chr(0x2029)+'\\\\''fourth'\\\\''\n        calc=pg.strip(data)\n        result=pg.cc.check(item['\\\\''family'\\\\''],item['\\\\''passages'\\\\''],calc)\n        journal.extend([dict(base,status='\\\\''started'\\\\''),dict(base,status='\\\\''answered'\\\\'',decision=pg.cc.publish_decision(item['\\\\''family'\\\\''],calc,result),data=data)])\nretry=dict(unit='\\\\''single-E'\\\\'',arm='\\\\''single'\\\\'',draw=3,attempt=2,status='\\\\''started'\\\\'')\nanswer_text='\\\\''\\\\n'\\\\''.join(json.dumps(r,ensure_ascii=False) for r in journal)+'\\\\''\\\\n'\\\\''\nretry_text=json.dumps(retry)+'\\\\''\\\\n'\\\\''\ntorn='\\\\''{\\\"unit\\\":\\\"single-E\\\",\\\"arm\\\":\\\"single\\\",\\\"draw\\\":3,\\\"attempt\\\":2'\\\\''\ndef set_up(ans, diag):\n    (out/'\\\\''answers.jsonl'\\\\'').write_text(ans)\n    (out/'\\\\''retries.jsonl'\\\\'').write_text(diag)\n    results=pg.summarise(out,pr.PLAN,None)\n    items={(i['\\\\''unit'\\\\''],i['\\\\''arm'\\\\'']):i for i in pr.PLAN}\n    order=[(f'\\\\''P{i:02}'\\\\'',list(u)) for i,u in enumerate(sorted(pg.packet_units(results,items)),1)]\n    key=dict(salt='\\\\''probe'\\\\'',run_digest=pg.run_digest(out),order=order,attempts=[])\n    (keys/'\\\\''packet-key.json'\\\\'').write_text(json.dumps(key))\n    text, rendered, _=pg.render_packets(out,key)\n    (out/'\\\\''packets.md'\\\\'').write_text(text)\n    rd={}\n    for pid, k in rendered.items():\n        rd[pid]={}\n        for token in k['\\\\''cards'\\\\'']:\n            good=k['\\\\''arm'\\\\'']\"'!='\"'\\\\''separate'\\\\'' or int(k['\\\\''draw'\\\\''])==1\n            answers={q:dict(answer='\\\\''yes'\\\\'' if good and q=='\\\\''usable'\\\\'' else '\\\\''no'\\\\'',ground=f'\\\\''{token} reading'\\\\'') for q in pg.QUESTIONS}\n            rd[pid][token]={'\\\\''A'\\\\'':answers,'\\\\''B'\\\\'':answers}\n    (out/'\\\\''readings.json'\\\\'').write_text(json.dumps(dict(packets_sha256=pg.hashlib.sha256(text.encode()).hexdigest(),packets=rd)))\n    return results\ndef score():\n    with contextlib.redirect_stdout(io.StringIO()): return pg.score(out,keys)\nfor test,ans,diag in [('\\\\''Unicode in scored answer'\\\\'',answer_text,retry_text),('\\\\''torn retry'\\\\'',answer_text,retry_text+torn),('\\\\''torn scored answer'\\\\'',answer_text[:answer_text.rfind(chr(10),0,-1)+1]+torn,'\\\\'''\\\\'')]:\n    res=set_up(ans,diag)\n    report=score()\n    print(test,report['\\\\''verdict'\\\\''],(report['\\\\''joint usable pairs'\\\\''],report['\\\\''separate usable pairs'\\\\'']),[d['\\\\''journal'\\\\''] for d in res['\\\\''damaged'\\\\'']])\n    if test=='\\\\''torn retry'\\\\'':\n        assert report['\\\\''complete'\\\\''] and res['\\\\''finals'\\\\'']['\\\\''single-E|single|3'\\\\'']['\\\\''attempts'\\\\''][1]['\\\\''status'\\\\'']=='\\\\''interrupted'\\\\''\n        (out/'\\\\''retries.jsonl'\\\\'').write_text(diag+'\\\\''changed'\\\\'')\n        report=score()\n        print('\\\\''diagnostic journal edited after packets'\\\\'',report['\\\\''verdict'\\\\''],report['\\\\''problems'\\\\''][0])\n        assert report['\\\\''verdict'\\\\'']=='\\\\''INCOMPLETE'\\\\''\n    elif test=='\\\\''Unicode in scored answer'\\\\'':\n        assert report['\\\\''verdict'\\\\'']=='\\\\''PASS'\\\\'' and not res['\\\\''damaged'\\\\'']\n    else:\n        assert report['\\\\''verdict'\\\\'']=='\\\\''INCOMPLETE'\\\\''\n'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
