expected null'])\npatched estimated ('publish', [], {'v6': [679.25, 745.0, None]})\npatched none ('refused', [('S1', 'F11: the quote writes \"estimated\" with \"$750 billion\", but the qualifier is none')], {})\npatched invented ('refused', [('S1', 'F11: the quote writes \"none\" with \"$760 billion\", but the qualifier is estimated')], {})\nchanged originals ['T10']\nunresolved ('refused', [('S7', 'v6: an unresolved answer has why, rung and reference_unavailable null, and no figure marked for it')], {})\nmutant accepts dropped qualifier True\n","exit_code":0,"status":"completed"}}
