{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba calc_check.py | sed -n '348,550p'\"","aggregated_output":"   348\t        else:\n   349\t            errors += _reference_errors(ans['view_id'], figs.get(ref.get('figure')), figs, passages, refs)\n   350\t\n   351\t    # [46j.1] scenario membership derived from the estimates a figure rests on; related members cover the same scenarios\n   352\t    def scen(fid):\n   353\t        return figs[fid].get('scenario', 'base')\n   354\t\n   355\t    def derived(fid):\n   356\t        return {scen(g) for g in _upstream_of(fid, figs, refs) | {fid} if figs[g]['kind'] == 'estimate' and scen(g) != 'range'}\n   357\t    for f in figs.values():\n   358\t        sc = f.get('scenario', 'base')\n   359\t        if sc == 'range' or f['kind'] not in ('computed', 'estimate'):\n   360\t            continue\n   361\t        other = derived(f['id']) - {sc}\n   362\t        if other:\n   363\t            errors.append(('C4', f'{f[\"id\"]} ({sc}) rests on estimates of another scenario ({\", \".join(sorted(other))})'))\n   364\t    for rel in family.get('relations', []):\n   365\t        if rel['type'] == 'part_of' and rel['part'] in outcomes and rel['whole'] in outcomes:\n   366\t            sp, sw = derived(outcomes[rel['part']]), derived(outcomes[rel['whole']])\n   367\t            if sp != sw:\n   368\t                errors.append(('C4', f'{rel[\"part\"]} covers scenarios {sorted(sp)} but {rel[\"whole\"]} covers {sorted(sw)}; related members cover the same'))\n   369\t\n   370\t    # [46i.1] a range summary is an estimate with low and high, is an answer's outcome, and no figure reads it\n   371\t    outcome_ids = {a.get('outcome') for a in calc['answers']}\n   372\t    for f in figs.values():\n   373\t        if f.get('scenario') != 'range':\n   374\t            continue\n   375\t        readers = [g['id'] for g in figs.values() if f['id'] in refs(g)]\n   376\t        if f['kind'] != 'estimate' or 'low' not in f or 'high' not in f or f['id'] not in outcome_ids or readers:\n   377\t            errors.append(('C4', f'{f[\"id\"]}: a range summary must be an estimate with low and high that is an answer\\'s outcome and feeds no figure'\n   378\t                                 + (f' (read by {\", \".join(readers)})' if readers else '')))\n   379\t\n   380\t    # C3 part within whole, C4 one forecast per shared quantity (every path)\n   381\t    def reachable(start, stop=None):\n   382\t        stops = set(stop) if isinstance(stop, (set, list, tuple)) else {stop}\n   383\t        seen_ids, stack = set(), [start]\n   384\t        while stack:\n   385\t            fid = stack.pop()\n   386\t            if fid in seen_ids or fid not in figs:\n   387\t                continue\n   388\t            seen_ids.add(fid)\n   389\t            if fid not in stops:\n   390\t                stack.extend(refs(figs[fid]))\n   391\t        return seen_ids\n   392\t    scenarios = {f.get('scenario', 'base') for f in figs.values() if f['basis'] == 'forecast'} or {'base'}\n   393\t    for rel in family.get('relations', []):\n   394\t        if rel['type'] != 'part_of' or rel['part'] not in outcomes or rel['whole'] not in outcomes:\n   395\t            continue\n   396\t        part_m, whole_m = members[rel['part']], members[rel['whole']]\n   397\t        for sc in scenarios:\n   398\t            for period in family.get('compare_periods', []):\n   399\t                def node(view_id, member):\n   400\t                    want = (member['what']['population'], member['what']['measure'], member['what']['scope'], period)\n   401\t                    hits = [figs[f] for f in reachable(outcomes[view_id]) if _key(figs[f]['what']) == want\n   402\t                            and figs[f]['basis'] == 'forecast' and figs[f].get('scenario', 'base') == sc]\n   403\t                    return hits[0] if hits else None\n   404\t                p, w = node(rel['part'], part_m), node(rel['whole'], whole_m)\n   405\t                if p and w:\n   406\t                    (plo, phi), (wlo, whi) = _interval(p), _interval(w)\n   407\t                    if plo > wlo + 1e-9 or phi > whi + 1e-9:\n   408\t                        errors.append(('C3', f'{period} {sc}: {rel[\"part\"]} {p[\"id\"]} ({plo}–{phi}) exceeds {rel[\"whole\"]} {w[\"id\"]} ({wlo}–{whi})'))\n   409\t    for shared in family.get('shared', []):\n   410\t        want = _key(shared)\n   411\t        nodes = [f for f in figs.values() if _key(f['what']) == want and f['basis'] == 'forecast']\n   412\t        touched = [v for v, o in outcomes.items() if any(_key(figs[f]['what']) == want for f in reachable(o))]\n   413\t        if not touched:\n   414\t            continue\n   415\t        per_scenario = {}\n   416\t        for n in nodes:\n   417\t            per_scenario.setdefault(n.get('scenario', 'base'), []).append(n['id'])\n   418\t        if not nodes:\n   419\t            errors.append(('C4', f'{want}: no forecast node, though {\", \".join(touched)} depend on it'))\n   420\t        for sc, ids in sorted(per_scenario.items()):\n   421\t            if len(ids) != 1:\n   422\t                errors.append(('C4', f'{want} {sc}: {len(ids)} forecast nodes ({\", \".join(ids)}); exactly one per scenario is required'))\n   423\t        stop = {n['id'] for n in nodes}\n   424\t        for f in figs.values():                       # [46i.1] scenario membership is derived along the whole path, not declared\n   425\t            sc = f.get('scenario', 'base')\n   426\t            if sc == 'range' or f['kind'] not in ('computed', 'estimate'):\n   427\t                continue\n   428\t            upstream = _upstream_of(f['id'], figs, refs)\n   429\t            borrowed = sorted(r for r in upstream if r in stop and figs[r].get('scenario', 'base') != sc)\n   430\t            if borrowed:\n   431\t                errors.append(('C4', f'{want}: {f[\"id\"]} ({sc}) depends on {\", \".join(borrowed)} of another scenario'))\n   432\t        for view_id in touched:                      # [46g.3] a bypass reaches the quantity through no forecast node of any scenario\n   433\t            bypass = [f for f in reachable(outcomes[view_id], stop=stop) if f not in stop and _key(figs[f]['what']) == want]\n   434\t            if bypass:\n   435\t                errors.append(('C4', f'{want}: {view_id} reaches {\", \".join(sorted(bypass))} without passing a forecast node ({\", \".join(sorted(stop))})'))\n   436\t    for rel in family.get('relations', []):           # [46j.2] the later member rests on the earlier member's forecast nodes, per scenario\n   437\t        if rel['type'] != 'same_base' or rel['later'] not in outcomes or rel['earlier'] not in outcomes:\n   438\t            continue\n   439\t        base_key = _key(members[rel['earlier']]['what'])\n   440\t        earlier_graph = _upstream_of(outcomes[rel['earlier']], figs, refs) | {outcomes[rel['earlier']]}\n   441\t        earlier_nodes = {f for f in earlier_graph if _key(figs[f]['what']) == base_key and figs[f]['basis'] == 'forecast'}\n   442\t        reached = reachable(outcomes[rel['later']], stop=earlier_nodes)\n   443\t        bypass = [f for f in reached if f not in earlier_nodes and _key(figs[f]['what']) == base_key]\n   444\t        later_key = _key(members[rel['later']]['what'])\n   445\t        by_scenario = {figs[n].get('scenario', 'base'): n for n in earlier_nodes if figs[n].get('scenario', 'base') != 'range'}\n   446\t        later_graph = _upstream_of(outcomes[rel['later']], figs, refs) | {outcomes[rel['later']]}\n   447\t        for f in sorted(later_graph):                 # [46k.1] every later scenario path reaches the earlier forecast of its own scenario\n   448\t            sc = figs[f].get('scenario', 'base')\n   449\t            if sc == 'range' or _key(figs[f]['what']) != later_key or figs[f]['basis'] != 'forecast':\n   450\t                continue\n   451\t            target = by_scenario.get(sc) or (next(iter(by_scenario.values())) if len(by_scenario) == 1 else None)\n   452\t            if target is None or target not in _determining(f, figs):       # [46l.1] through value-determining inputs only\n   453\t                errors.append(('C9', f'{f} ({sc}) of {rel[\"later\"]} is not computed from {rel[\"earlier\"]}\\'s {sc} forecast'))\n   454\t        later_scen = {figs[f].get('scenario', 'base') for f in later_graph if _key(figs[f]['what']) == later_key\n   455\t                      and figs[f]['basis'] == 'forecast' and figs[f].get('scenario', 'base') != 'range'}\n   456\t        if len(by_scenario) > 1 and later_scen != set(by_scenario):     # [46l.1] the later member covers the earlier's scenarios\n   457\t            errors.append(('C9', f'{rel[\"later\"]} covers scenarios {sorted(later_scen)} but {rel[\"earlier\"]} covers {sorted(by_scenario)}'))\n   458\t        if not reached & earlier_nodes:\n   459\t            errors.append(('C9', f'{rel[\"later\"]} does not rest on {rel[\"earlier\"]}\\'s forecast ({\", \".join(sorted(earlier_nodes))})'))\n   460\t        if bypass:\n   461\t            errors.append(('C9', f'{rel[\"later\"]} reaches {\", \".join(sorted(bypass))} for {base_key} without {rel[\"earlier\"]}\\'s forecast'))\n   462\t    supplied = family.get('prior_answers', {})\n   463\t    for fig in figs.values():\n   464\t        earlier = fig['kind'] == 'prior' or fig.get('basis') == 'prior_forecast' or 'pointer' in fig   # [46i.2] derived, not labelled\n   465\t        if not earlier:\n   466\t            continue\n   467\t        if fig['kind'] != 'prior' or fig.get('basis') != 'prior_forecast':\n   468\t            errors.append(('C10', f'{fig[\"id\"]}: an earlier forecast must be kind prior with basis prior_forecast'))\n   469\t        ptr, ans_prior = fig.get('pointer', {}), supplied.get(fig.get('pointer', {}).get('view'), {})\n   470\t        if ans_prior.get('day') != ptr.get('day') or not any(_same(fig.get('value'), v) for v in ans_prior.get('values', [])):\n   471\t            errors.append(('C10', f'{fig[\"id\"]}: no earlier answer of {ptr.get(\"view\")} on {ptr.get(\"day\")} shown in the request states {fig.get(\"value\")}'))\n   472\t        owners = [a['view_id'] for a in calc['answers'] if a.get('outcome') == fig['id']]\n   473\t        if owners:                                    # [46h.2] nor the current outcome\n   474\t            errors.append(('C10', f'{fig[\"id\"]}: an earlier forecast cannot be the current outcome of {\", \".join(owners)}'))\n   475\t        users = [f['id'] for f in figs.values() if fig['id'] in refs(f)]\n   476\t        if users:\n   477\t            errors.append(('C10', f'{fig[\"id\"]}: an earlier forecast is for comparison only and cannot feed {\", \".join(users)}'))\n   478\t\n   479\t    recorded += _assumptions(family, figs, outcomes, calc, refs)\n   480\t    return {'errors': errors, 'recorded': recorded}\n   481\t\n   482\t\n   483\tdef _per_unit(op, ins, fig):\n   484\t    \"\"\"The per-unit identity: ratio(total, price per unit) -> units, product(units, price per unit) -> total, for one population and\n   485\t    scope. Labels are the judge's; a reader checks them against the passages.\"\"\"\n   486\t    out = fig['what']\n   487\t    if len(ins) != 2:\n   488\t        return False\n   489\t    same = all((i['what']['population'], i['what']['scope']) == (out['population'], out['scope']) for i in ins)\n   490\t    price = [i for i in ins if i['what']['measure'] == 'price per unit' and i['unit'] in ('USD', 'USD bn')]\n   491\t    if op == 'ratio':\n   492\t        return same and len(price) == 1 and ins[1] is price[0] and out['measure'] == 'units' and ins[0]['unit'] in ('USD', 'USD bn')\n   493\t    units = [i for i in ins if i['what']['measure'] == 'units' and i['unit'] == 'units']\n   494\t    return same and len(price) == 1 and len(units) == 1 and fig['unit'] in ('USD', 'USD bn')\n   495\t\n   496\t\n   497\tdef changed(previous, answer, figs):\n   498\t    \"\"\"D728: whether a member's conclusion changed, derived by code from its earlier rung, outcome and source figures.\"\"\"\n   499\t    if previous is None:\n   500\t        return True, 'first judgement'\n   501\t    out = figs[answer['outcome']]\n   502\t    mid = sum(_interval(out)) / 2\n   503\t    refs = lambda f: list(f.get('inputs', [])) + [r for r in f.get('rests_on', []) if r in figs] + \\\n   504\t        ([f['adjusts']['figure']] if f.get('adjusts') else []) + ([f['bridge']] if f.get('bridge') else [])\n   505\t    own = _upstream_of(out['id'], figs, refs) | {out['id']}                  # [46k.3] the member's own outcome and reference only\n   506\t    ref = (answer.get('reference') or {}).get('figure')\n   507\t    if ref in figs:\n   508\t        own |= _upstream_of(ref, figs, refs) | {ref}\n   509\t    sources = sorted(figs[f]['evidence'] + ':' + figs[f]['expression'] for f in own if figs[f]['kind'] == 'source')\n   510\t    reasons = []\n   511\t    if answer['rung'] != previous['rung']:\n   512\t        reasons.append(f'rung {previous[\"rung\"]} to {answer[\"rung\"]}')\n   513\t    lo, hi = _interval(out)                                                    # [46l.2] both ends, not the midpoint\n   514\t    p_lo, p_hi = previous['outcome'] if isinstance(previous['outcome'], (tuple, list)) else (previous['outcome'], previous['outcome'])\n   515\t    if abs(lo - p_lo) > 0.005 * max(abs(p_lo), 1e-9) or abs(hi - p_hi) > 0.005 * max(abs(p_hi), 1e-9):\n   516\t        reasons.append(f'outcome {p_lo}–{p_hi} to {round(lo, 3)}–{round(hi, 3)}')\n   517\t    added, dropped = sorted(set(sources) - set(previous['sources'])), sorted(set(previous['sources']) - set(sources))\n   518\t    if added or dropped:\n   519\t        reasons.append(f'source figures added {added}, dropped {dropped}')\n   520\t    return bool(reasons), '; '.join(reasons) or 'unchanged'\n   521\t\n   522\t\n   523\tdef publish_decision(family, calc, result):\n   524\t    \"\"\"DESIGN.md §4: 'refused' when a check fails (the harness retries once); 'held' when a member is unresolved and a declared\n   525\t    relation joins it to another member; else 'publish' (unresolved members shown as unresolved).\"\"\"\n   526\t    if result['errors']:\n   527\t        return 'refused'\n   528\t    unresolved = {a['view_id'] for a in calc['answers'] if a.get('shape') == 'unresolved'}\n   529\t    for rel in family.get('relations', []):\n   530\t        ends = {rel.get('part'), rel.get('whole'), rel.get('later'), rel.get('earlier')} - {None}\n   531\t        if ends & unresolved and ends - unresolved:\n   532\t            return 'held'\n   533\t    return 'publish'\n   534\t\n   535\t\n   536\tdef family_outcome(attempts):\n   537\t    \"\"\"The round's outcome from up to two attempts' decisions: a refusal is retried once; two refusals make the family unresolved.\"\"\"\n   538\t    if attempts[0] != 'refused':\n   539\t        return attempts[0]\n   540\t    if len(attempts) > 1 and attempts[1] != 'refused':\n   541\t        return attempts[1]\n   542\t    return 'unresolved'\n   543\t\n   544\t\n   545\tdef _determining(fid, figs):\n   546\t    \"\"\"The figures that determine fid's value: computed inputs only, at any depth (an estimate's rests_on explains, it does not compute).\"\"\"\n   547\t    seen_ids, stack = set(), list(figs[fid].get('inputs', [])) if figs[fid]['kind'] == 'computed' else []\n   548\t    while stack:\n   549\t        f = stack.pop()\n   550\t        if f in seen_ids or f not in figs:\n","exit_code":0,"status":"completed"}}
