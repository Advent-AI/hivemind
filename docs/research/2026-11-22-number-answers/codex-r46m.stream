 inputs, value, unit, what, basis='forecast', **extra):\ngate.py:44:    fig.update({'low': value[0], 'high': value[1]} if isinstance(value, tuple) else {'value': value})\ngate.py:49:def est(fid, value, unit, what, basis_text, rests_on=(), basis='forecast', **extra):\ngate.py:51:    fig.update({'low': value[0], 'high': value[1]} if isinstance(value, tuple) else {'value': value})\ngate.py:69:             'prior_answers': {'v9': {'day': '2026-09-19', 'values': [414.0, 385.0, 390.0]}}}   # call 8621: reference $414B, outcome $385–390B\ngate.py:111:        figs.append({'id': 'prior414', 'kind': 'prior', 'basis': 'prior_forecast', 'value': 414.0, 'unit': 'USD bn',\ngate.py:193:# ---------- G1–G4: the frozen gold's reasoning (q01, q02, q19, q22) ----------\ngate.py:310:    for name, maker in (('G1', g1), ('G2', g2), ('G3', g3), ('G4', g4)):\ngate.py:315:    p1['figures'][0]['value'] = 81.9\ngate.py:322:    p3a['figures'].append({'id': 'pri', 'kind': 'prior', 'basis': 'prior_forecast', 'value': 425.0, 'unit': 'USD bn',\ngate.py:325:    f1p = dict(f1, prior_answers={'v1': {'day': '2026-07-13', 'values': [425.0]}})       # the earlier answer it points to, as shown\ngate.py:330:    lo['inputs'], lo['value'] = ['gfyhi', 'gshlo'], 399.83                  # crossed: low share on the high total\ngate.py:331:    hi['inputs'], hi['value'] = ['gfylo', 'gshhi'], 372.56\ngate.py:343:    next(f for f in r1x2['figures'] if f['id'] == 'dcq3').update(operation='product', inputs=['altdc', 'one'], value=99.9)\ngate.py:345:                            'basis_text': 'unchanged', 'rests_on': [], 'value': 1.0})\ngate.py:374:    next(f for f in g2x2['figures'] if f['id'] == 'gdclo').update(inputs=['gfylo', 'gshhi'], value=372.56)\ngate.py:375:    next(f for f in g2x2['figures'] if f['id'] == 'gdchi').update(inputs=['gfyhi', 'gshlo'], value=399.83)\ngate.py:390:    item('G24', f24, G_PASSAGES, c24, lambda r: (not r['errors'], \"passes: q22 per scenario on q01's range\"), '')\ngate.py:401:    sib_figs['dch1'].update(expression='$164 billion', value=164.0)\ngate.py:407:    f1g, c1g = g1()                                   # [46l.2] a wider range with the same midpoint\ngate.py:411:    rows.append(('CH4', ch4[0] is True and 'outcome' in ch4[1], f'wider range, same midpoint: {ch4[1]}', {'errors': [], 'recorded': []}))\ngate.py:415:    item('G24m', f24, G_PASSAGES, g24m, lambda r: (any(c == 'C9' and 'g28hi' in d for c, d in r['errors']), 'C9: the high path skips q01'), '')\ngate.py:416:    g24d = copy.deepcopy(c24)                         # [46l.1] the high calculation deleted\ngate.py:419:    item('G24d', f24, G_PASSAGES, g24d, lambda r: (any(c == 'C9' and 'covers' in d for c, d in r['errors']), 'C9: the high path missing'), '')\ngate.py:420:    g24c = copy.deepcopy(c24)                         # [46l.1] the high path computed from FY2028 consensus, q01's high only cited\ngate.py:423:    item('G24c', f24, G_PASSAGES, g24c, lambda r: (any(c == 'C9' and 'g28hi' in d for c, d in r['errors']), 'C9: q01 only cited, not computed'), '')\ngate.py:432:    next(f for f in p3c['figures'] if f['id'] == 'pri')['value'] = 431.0\ngate.py:452:    item('G4m', f4, G_PASSAGES, g4m, lambda r: ('C9' in codes(r), \"C9: FY2028 rests on consensus, not q01's forecast\"), '')\ngate.py:469:        ('T8', src('t', 'e1786', 'more than $730 billion', 730.0, 'USD bn', 'reported', W('x', 'x', 'x', 'x'), 'value'), False),\n","exit_code":0,"status":"completed"}}
