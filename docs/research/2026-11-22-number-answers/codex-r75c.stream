{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc 'nl -ba docs/research/2026-11-22-number-answers/release_check.py'","aggregated_output":"     1\t\"\"\"The $0 release check of RELEASE-BUILD.md §7 on four stored stores, read-only (a closing switch is added only to a copy).\n     2\t\n     3\t    python3 docs/research/2026-11-22-number-answers/release_check.py <new output folder>\n     4\t\n     5\tBuilds each store's package with the real command, then: the decisive acceptance case on old-1; old-1/v8; the two known Yes/No leaks\n     6\tat their own days; an unchanged event control; a closing switch on a copy; the diagnostic search of every forbidden stored string in\n     7\tevery decoded package field; the size and speed budgets against `bundle.library` on the same store. Writes results.json there.\"\"\"\n     8\timport hashlib\n     9\timport json\n    10\timport shutil\n    11\timport sqlite3\n    12\timport subprocess\n    13\timport sys\n    14\timport time\n    15\tfrom pathlib import Path\n    16\t\n    17\tREPO = Path(__file__).resolve().parents[3]\n    18\tsys.path.insert(0, str(REPO / 'src'))\n    19\tfrom hivemind import bundle, release, service  # noqa: E402\n    20\tfrom hivemind.views import store  # noqa: E402\n    21\t\n    22\tCOMMAND = REPO / 'scripts' / 'release_build.py'\n    23\tCOMPARISON_ITEMS = REPO / 'poc/data/comparison-2026-11-17/items-comparison.sqlite'\n    24\tSTORES = {\n    25\t    'old-1': (REPO / 'poc/data/comparison-2026-11-17/run/old-1/prod/views.sqlite', COMPARISON_ITEMS),\n    26\t    'old-2': (REPO / 'poc/data/comparison-2026-11-17/run/old-2/prod/views.sqlite', COMPARISON_ITEMS),\n    27\t    'old-3': (REPO / 'poc/data/comparison-2026-11-17/run/old-3/prod/views.sqlite', COMPARISON_ITEMS),\n    28\t    'served': (REPO / 'poc/data/served-2026-10-28-v34-nvda-3m-through-0828/views.sqlite', REPO / 'poc/data/items-nvda-2026-07-01-10-27.sqlite'),\n    29\t}\n    30\t\n    31\t\n    32\tdef build(ledger, items, out, as_of=None):\n    33\t    args = [sys.executable, str(COMMAND), 'build', '--ledger', str(ledger), '--items', str(items), '--out', str(out)] + (['--as-of', as_of] if as_of else [])\n    34\t    result = subprocess.run(args, capture_output=True, text=True, env={'PATH': '/usr/bin:/bin', 'PYTHONDONTWRITEBYTECODE': '1'})\n    35\t    if result.returncode != 0:\n    36\t        raise SystemExit(f'build {out} exited {result.returncode}: {result.stderr}')\n    37\t    return json.loads(out.with_name(out.name + '.report.json').read_text()), release.read_data(out)\n    38\t\n    39\t\n    40\tdef check(ledger, items, package):\n    41\t    views_db, items_db = service.open_ledger(str(ledger)), store.open_read_only(str(items))\n    42\t    try:\n    43\t        return release.check_package(package, views_db, items_db)[0]\n    44\t    finally:\n    45\t        views_db.close()\n    46\t        items_db.close()\n    47\t\n    48\t\n    49\tdef fields(data, manifest=None):\n    50\t    \"\"\"(question id, field path, evidence id, text) for every decoded string of the package: every string value of the data at\n    51\t    every level (ids, classes and the marker included) and of the manifest.\"\"\"\n    52\t    def walk(value, path, question_id, evidence_id):\n    53\t        if isinstance(value, dict):\n    54\t            question_id = value['id'] if 'class' in value else question_id\n    55\t            evidence_id = value['id'] if 'one_line' in value else evidence_id\n    56\t            for key, item in value.items():\n    57\t                yield from walk(item, f'{path}.{key}' if path else key, question_id, evidence_id)\n    58\t        elif isinstance(value, list):\n    59\t            for n, item in enumerate(value):\n    60\t                yield from walk(item, f'{path}[{n}]', question_id, evidence_id)\n    61\t        elif isinstance(value, str):\n    62\t            yield question_id, path, evidence_id, value\n    63\t    yield from walk(data, '', None, None)\n    64\t    if manifest is not None:\n    65\t        yield from walk(manifest, 'manifest', None, None)\n    66\t\n    67\t\n    68\tdef forbidden(ledger, data):\n    69\t    \"\"\"Every stored string the package must not hold, by question and kind; judgement columns read only where the store has them.\"\"\"\n    70\t    conn = service.open_ledger(str(ledger))\n    71\t    try:\n    72\t        columns = {row[1] for row in conn.execute('pragma table_info(judgements)')}\n    73\t        texts = [c for c in ('reasons', 'why_changed', 'implied_outcome', 'reference') if c in columns]\n    74\t        out = []\n    75\t        for question in data['questions']:\n    76\t            view_id = question['id']\n    77\t            for row in conn.execute('select label, condition from rungs where view_id=?', (view_id,)):\n    78\t                if question['class'] == 'number':                # an event's or Yes/No question's labels are its shown answers\n    79\t                    out.append((view_id, 'rung label', row['label']))\n    80\t                out.append((view_id, 'rung condition', row['condition']))\n    81\t            for row in conn.execute(f'select {\", \".join(texts)} from judgements where view_id=?', (view_id,)):\n    82\t                out += [(view_id, name, row[name]) for name in texts]\n    83\t            out += [(view_id, 'switch reason', row['reason']) for row in conn.execute('select reason from view_switches where view_id=?', (view_id,))]\n    84\t        return [entry for entry in out if entry[2]], [c for c in ('implied_outcome', 'reference') if c not in columns]\n    85\t    finally:\n    86\t        conn.close()\n    87\t\n    88\t\n    89\tdef diagnostics(ledger, data, package):\n    90\t    stored, absent = forbidden(ledger, data)\n    91\t    located = list(fields(data, json.loads((package / release.MANIFEST_FILE).read_text())))\n    92\t    joined = '\\x00'.join(text for *_, text in located)\n    93\t    hits = []\n    94\t    for view_id, kind, text in set(stored):\n    95\t        if text in joined:\n    96\t            for question_id, path, evidence_id, field in located:\n    97\t                if text in field:\n    98\t                    hits.append({'stored_in': view_id, 'kind': kind, 'text': text[:200], 'found_in': question_id, 'field': path, 'evidence': evidence_id})\n    99\t    return {'stored_strings_judged': len(set(stored)), 'package_strings': len(located), 'judgement_columns_absent': absent, 'hits': hits}\n   100\t\n   101\t\n   102\tdef library_baseline(ledger, items):\n   103\t    views_db, items_db = service.open_ledger(str(ledger)), store.open_read_only(str(items))\n   104\t    try:\n   105\t        started = time.monotonic()\n   106\t        payload = bundle.library(views_db, items_db)\n   107\t        return len(json.dumps(payload, ensure_ascii=False).encode()), time.monotonic() - started\n   108\t    finally:\n   109\t        views_db.close()\n   110\t        items_db.close()\n   111\t\n   112\t\n   113\tdef by_id(data):\n   114\t    return {q['id']: q for q in data['questions']}\n   115\t\n   116\t\n   117\tdef refresh(package, data=None, manifest_extra=None):\n   118\t    if data is not None:\n   119\t        payload = json.dumps(data, ensure_ascii=False, separators=(',', ':')).encode()\n   120\t        (package / release.DATA_FILE).write_bytes(payload)\n   121\t    manifest = json.loads((package / release.MANIFEST_FILE).read_text())\n   122\t    manifest['data_sha256'] = hashlib.sha256((package / release.DATA_FILE).read_bytes()).hexdigest()\n   123\t    manifest.update(manifest_extra or {})\n   124\t    (package / release.MANIFEST_FILE).write_text(json.dumps(manifest))\n   125\t\n   126\t\n   127\tdef refused(ledger, items, package):\n   128\t    try:\n   129\t        check(ledger, items, package)\n   130\t    except release.ReleaseRefused as error:\n   131\t        return str(error)\n   132\t    return None\n   133\t\n   134\t\n   135\tdef main(out):\n   136\t    out = Path(out).absolute()\n   137\t    out.mkdir()                                            # a new folder; refuses an existing one\n   138\t    results = {'stores': {}}\n   139\t    packages = {}\n   140\t    for name, (ledger, items) in STORES.items():\n   141\t        (out / name).mkdir()\n   142\t        report, data = build(ledger, items, out / name / 'package')\n   143\t        packages[name] = data\n   144\t        library_bytes, library_seconds = library_baseline(ledger, items)\n   145\t        seconds = report['export_seconds'] + report['check_seconds']\n   146\t        results['stores'][name] = {\n   147\t            'as_of': report['as_of'], 'counts': report['counts'], 'withheld_unresolved': len(report['withheld_unresolved']),\n   148\t            'unresolved': report['withheld_unresolved'], 'data_bytes': report['data_bytes'], 'library_bytes': library_bytes,\n   149\t            'seconds': round(seconds, 2), 'library_seconds': round(library_seconds, 2),\n   150\t            'bytes_within_budget': report['data_bytes'] <= library_bytes,\n   151\t            'seconds_within_budget': seconds <= 3 * library_seconds and seconds <= 120,\n   152\t            'diagnostics': diagnostics(ledger, data, out / name / 'package')}\n   153\t        print(name, json.dumps({k: v for k, v in results['stores'][name].items() if k not in ('unresolved', 'diagnostics')}), 'hits', len(results['stores'][name]['diagnostics']['hits']))\n   154\t\n   155\t    ledger, items = STORES['old-1']\n   156\t    data, package = packages['old-1'], out / 'old-1' / 'package'\n   157\t    conn = service.open_ledger(str(ledger))\n   158\t    stored = {row['evidence_id']: row for row in conn.execute(\"select * from evidence where evidence_id in ('e2295','e1865','e3597')\")}\n   159\t    implied = conn.execute('select implied_outcome from judgements where judgement_id=1580').fetchone()[0]\n   160\t    in_force_v8 = [e['evidence_id'] for e in service.evidence(conn, 'v8', data['as_of'])]\n   161\t    conn.close()\n   162\t    kept = {}\n   163\t    for evidence_id in ('e2295', 'e1865', 'e3597'):              # the fixed examples: a missing one is a failure, not a smaller list\n   164\t        if evidence_id not in stored:\n   165\t            kept[evidence_id] = {'questions': [], 'equal_to_store': False, 'present': False}\n   166\t            continue\n   167\t        holders = [(q['id'], e) for q in data['questions'] for e in q['evidence'] if e['id'] == evidence_id]\n   168\t        kept[evidence_id] = {'questions': [h[0] for h in holders],\n   169\t                             'equal_to_store': all(e['one_line'] == stored[evidence_id]['one_line'] and e['quote'] == stored[evidence_id]['quote'] for _, e in holders) and bool(holders),\n   170\t                             'present': bool(holders)}\n   171\t    forged = out / 'old-1' / 'forged-summary'\n   172\t    shutil.copytree(package, forged)\n   173\t    changed = json.loads(json.dumps(data))\n   174\t    next(e for e in by_id(changed)['v8']['evidence'] if e['id'] == 'e2295')['one_line'] = implied\n   175\t    refresh(forged, changed)\n   176\t    prose = out / 'old-1' / 'forged-manifest'\n   177\t    shutil.copytree(package, prose)\n   178\t    refresh(prose, manifest_extra={'note': implied})\n   179\t    v8 = by_id(data)['v8']\n   180\t    results['decisive'] = {'kept': kept, 'implied_outcome_j1580': implied[:120],\n   181\t                           'substituted_into_e2295_refused': refused(ledger, items, forged),\n   182\t                           'added_to_manifest_refused': refused(ledger, items, prose),\n   183\t                           'unchanged_package_passes': check(ledger, items, package)['fields_compared']}\n   184\t    results['old-1/v8'] = {'class': v8['class'], 'forecast': v8['forecast'], 'evidence': len(v8['evidence']),\n   185\t                           'same_ids_as_service_evidence': [e['id'] for e in v8['evidence']] == in_force_v8}\n   186\t\n   187\t    leaks = {}\n   188\t    for name, view_id, day, judgement_id in (('old-3', 'v36', '2026-08-25', 799), ('old-1', 'v10', '2026-08-28', 865)):\n   189\t        ledger, items = STORES[name]\n   190\t        report, dated = build(ledger, items, out / name / f'package-{day}', day)\n   191\t        conn = service.open_ledger(str(ledger))\n   192\t        row = conn.execute('select judgement_id, rung, why_changed, reasons from judgements where view_id=? and publication_day<=? order by judgement_id desc limit 1', (view_id, day)).fetchone()\n   193\t        label = conn.execute('select label from rungs where view_id=? and position=?', (view_id, row['rung'])).fetchone()[0]\n   194\t        conn.close()\n   195\t        record = by_id(dated)[view_id]\n   196\t        texts = [text for *_, text in fields(dated)]\n   197\t        leaks[f'{name}/{view_id}@{day}'] = {\n   198\t            'latest_judgement': row['judgement_id'], 'expected_judgement': judgement_id, 'label_kept': record['answer'] == label, 'answer': record['answer'],\n   199\t            'why_changed_absent': not any(row['why_changed'] in t for t in texts), 'reasons_absent': not any((row['reasons'] or '\\x01') in t for t in texts),\n   200\t            'phrase_fields': {phrase: [(q, p, e, t[:160]) for q, p, e, t in fields(dated) if phrase in t]\n   201\t                              for phrase in ('around $1 trillion', 'rung 4', 'at rung', 'capex at rung')}}\n   202\t    results['leaks'] = leaks\n   203\t\n   204\t    ledger, items = STORES['old-1']\n   205\t    conn = service.open_ledger(str(ledger))\n   206\t    control = next(q for q in data['questions'] if q['class'] == 'event' and q['id'] not in ('v10',) and q['answer'] is not None)\n   207\t    stored_label = conn.execute('select r.label from judgements j join rungs r on r.view_id=j.view_id and r.position=j.rung where j.view_id=? and j.publication_day<=? order by j.judgement_id desc limit 1', (control['id'], data['as_of'])).fetchone()[0]\n   208\t    control_ids = [e['evidence_id'] for e in service.evidence(conn, control['id'], data['as_of'])]\n   209\t    conn.close()\n   210\t    results['control'] = {'id': control['id'], 'answer': control['answer'], 'label_equals_store': control['answer'] == stored_label,\n   211\t                          'evidence_equals_store': [e['id'] for e in control['evidence']] == control_ids}\n   212\t\n   213\t    closing = out / 'old-1' / 'closing'\n   214\t    closing.mkdir()\n   215\t    copy = closing / 'views.sqlite'\n   216\t    shutil.copyfile(ledger, copy)\n   217\t    conn = sqlite3.connect(copy)\n   218\t    rung = conn.execute(\"select rung from judgements where view_id='v8' order by judgement_id desc limit 1\").fetchone()[0]\n   219\t    rung_label = conn.execute(\"select label from rungs where view_id='v8' and position=?\", (rung,)).fetchone()[0]\n   220\t    reason = f'due {data[\"as_of\"]}, frozen on {data[\"as_of\"]} at rung {rung} {rung_label}'\n   221\t    last_seq = conn.execute('select max(sequence_no) from processing_steps').fetchone()[0]\n   222\t    conn.execute(\"insert into view_switches (view_id, open, reason, by_whom, after_seq) values ('v8', 0, ?, 'pull', ?)\", (reason, last_seq))\n   223\t    conn.commit()\n   224\t    conn.close()\n   225\t    views_db, items_db = service.open_ledger(str(copy)), store.open_read_only(str(items))\n   226\t    exposed = bundle.view_bundle(views_db, bundle.item_lookup(items_db), 'v8')\n   227\t    views_db.close()\n   228\t    items_db.close()\n   229\t    report, closed = build(copy, items, closing / 'package')\n   230\t    texts = [text for *_, text in fields(closed)]\n   231\t    results['closing'] = {'reason': reason, 'bundle_exposes_reason': any(s.get('reason') == reason for s in exposed['switches']),\n   232\t                          'package_open': by_id(closed)['v8']['open'], 'reason_absent': not any(reason in t for t in texts),\n   233\t                          'rung_label_inside_v8_fields': [(p, e, t[:120]) for q, p, e, t in fields(closed) if q == 'v8' and rung_label in t]}\n   234\t    (out / 'results.json').write_text(json.dumps(results, ensure_ascii=False, indent=1))\n   235\t    print(json.dumps({k: v for k, v in results.items() if k != 'stores'}, ensure_ascii=False, indent=1))\n   236\t    failures = [f'{name}: {key}' for name, s in results['stores'].items() for key in ('bytes_within_budget', 'seconds_within_budget') if not s[key]]\n   237\t    decisive = results['decisive']\n   238\t    failures += [f'kept {e}' for e in ('e2295', 'e1865', 'e3597') if not (decisive['kept'].get(e, {}).get('present') and decisive['kept'][e]['equal_to_store'])]\n   239\t    failures += [k for k in ('substituted_into_e2295_refused', 'added_to_manifest_refused') if not decisive[k]]\n   240\t    failures += [] if results['old-1/v8']['same_ids_as_service_evidence'] and results['old-1/v8']['forecast'] == release.FORECAST_UNAVAILABLE else ['old-1/v8']\n   241\t    for name, leak in results['leaks'].items():\n   242\t        failures += [f'{name}: {k}' for k in ('label_kept', 'why_changed_absent', 'reasons_absent') if not leak[k]]\n   243\t        failures += [] if leak['latest_judgement'] == leak['expected_judgement'] else [f'{name}: judgement']\n   244\t        failures += [f'{name}: {phrase} found' for phrase, hits in leak['phrase_fields'].items() if hits]\n   245\t    failures += [] if results['control']['label_equals_store'] and results['control']['evidence_equals_store'] else ['control']\n   246\t    closing = results['closing']\n   247\t    failures += [] if closing['bundle_exposes_reason'] and closing['package_open'] is False and closing['reason_absent'] else ['closing']\n   248\t    if failures:\n   249\t        raise SystemExit(f'release check FAILED: {failures}')\n   250\t    print('release check: every acceptance item and budget met; diagnostic hits to read by hand:',\n   251\t          {name: len(s['diagnostics']['hits']) for name, s in results['stores'].items()})\n   252\t\n   253\t\n   254\tif __name__ == '__main__':\n   255\t    main(sys.argv[1])\n","exit_code":0,"status":"completed"}}
