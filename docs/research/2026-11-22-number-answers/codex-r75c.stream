{"type":"item.started","item":{"id":"item_20","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"python3 -B -c 'import runpy, pathlib, json\nm=runpy.run_path('\\\\''docs/research/2026-11-22-number-answers/release_check.py'\\\\'')\nbase=pathlib.Path('\\\\''poc/data/release-check-2026-11-23c'\\\\'')\nr=json.loads((base/'\\\\''results.json'\\\\'').read_text())\nlabels=set(); created=set(); texts={True:set(),False:set()}\nfor k, (v,i) in m['\\\\''STORES'\\\\''].items():\n b=base/k/'\\\\''package'\\\\''\n c=m['\\\\''check'\\\\''](v,i,b)\n s=r['\\\\''stores'\\\\''][k]\n d=m['\\\\''release'\\\\''].read_data(b)\n p=list(m['\\\\''fields'\\\\''](d, json.loads((b/'\\\\''manifest.json'\\\\'').read_text())))\n f={path:text for _,path,_,text in p}\n for h in s['\\\\''diagnostics'\\\\'']['\\\\''hits'\\\\'']:\n  islabel=h['\\\\''kind'\\\\'']=='\\\\''rung label'\\\\''; (labels if islabel else created).add((k,h['\\\\''field'\\\\'']))\n  texts[islabel].add(f[h['\\\\''field'\\\\'']])\n print(k, c, '\\\\''bytes'\\\\'', (b/'\\\\''release-data.json'\\\\'').stat().st_size, '\\\\''times'\\\\'',s['\\\\''seconds'\\\\''],s['\\\\''library_seconds'\\\\''],'\\\\''ratio'\\\\'',round(s['\\\\''seconds'\\\\'']/s['\\\\''library_seconds'\\\\''],3), '\\\\''hits'\\\\'',len(s['\\\\''diagnostics'\\\\'']['\\\\''hits'\\\\'']), '\\\\''all sources singleton'\\\\'',all(len(e['\\\\''sources'\\\\''])==1 for q in d['\\\\''questions'\\\\''] for e in q['\\\\''evidence'\\\\'']),flush=True)\nprint('\\\\''label & created field counts'\\\\'',len(labels),len(created),'\\\\''distinct texts'\\\\'',len(texts[True]),len(texts[False]))\nledger,items=m['\\\\''STORES'\\\\'']['\\\\''old-1'\\\\'']\nfor b in ('\\\\''forged-summary'\\\\'','\\\\''forged-manifest'\\\\''):\n print(b,m['\\\\''refused'\\\\''](ledger,items,base/'\\\\''old-1'\\\\''/b))'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
