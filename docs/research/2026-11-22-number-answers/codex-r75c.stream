{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba docs/research/2026-11-22-number-answers/release_mutants.py; nl -ba docs/research/2026-11-22-number-answers/RELEASE-BUILD.md | sed -n '1,32p;89,245p;338,476p'\"","aggregated_output":"     1\t\"\"\"RELEASE-BUILD.md §6 mutants: each applied to a scratch copy (PYTHONDONTWRITEBYTECODE, no __pycache__) must fail\n     2\ttests/test_release.py; the unmutated control must pass.\"\"\"\n     3\timport shutil\n     4\timport subprocess\n     5\timport sys\n     6\timport tempfile\n     7\tfrom pathlib import Path\n     8\t\n     9\tREPO = Path('/Users/lchingen/hivemind')\n    10\tR, B = 'src/hivemind/release.py', 'scripts/release_build.py'\n    11\tMUTANTS = {\n    12\t    'condition emitted on number records': (R, \"                record['forecast'] = FORECAST_UNAVAILABLE\\n            else:\\n                record['answers'] = labels\\n                record['answer'] = _answer(\",\n    13\t                                            \"                record['forecast'] = FORECAST_UNAVAILABLE\\n                record['condition'] = 'FY2027 revenue is at least $350 billion'\\n            else:\\n                record['answers'] = labels\\n                record['answer'] = _answer(\"),\n    14\t    'one_line from the latest why_changed': (R, \"evidence.append({'id': piece['evidence_id'], **{name: piece[name] for name in EVIDENCE_TEXT}, 'sources': sources})\",\n    15\t                                             \"evidence.append({'id': piece['evidence_id'], **{name: piece[name] for name in EVIDENCE_TEXT}, 'sources': sources, 'one_line': (views_db.execute('select why_changed from judgements where view_id=? order by judgement_id desc limit 1', (view_id,)).fetchone() or {'why_changed': piece['one_line']})['why_changed']})\"),\n    16\t    'event test removed': (R, \"    if key_measure(conn, view_id, as_of) in identity.EVENT_MEASURES:\\n        return 'event'\\n\", ''),\n    17\t    'Yes/No test removed': (R, \"    if len(labels) == 2 and {vocabulary.canonical('label', label) for label in labels} == {'Yes', 'No'}:\\n        return 'yes_no'\\n\", ''),\n    18\t    'check_package without the file-set check': (R, \"        if sorted(names) != sorted(PACKAGE_FILES):\\n            raise\", \"        if False:\\n            raise\"),\n    19\t    'manifest keys unchecked': (R, \"    _keys(manifest, 'manifest', 'the manifest')\\n\", ''),\n    20\t    'check_export without the closed-key check': (R, \"    if set(value) != ALLOWED[kind]:\", \"    if not set(value) >= ALLOWED[kind]:\"),\n    21\t    'check_origins skipping evidence fields': (R, \"            expected_evidence = _expected_evidence(views_db, items_db, view_id, as_of)\\n\",\n    22\t                                               \"            expected_evidence = question['evidence']\\n\"),\n    23\t    'check_origins taking the class from the package': (R, \"            kind = question_class(views_db, view_id, labels, as_of)\\n            record = {'id': view_id, 'question': view['question'], 'open': _open_at(\",\n    24\t                                                        \"            kind = question['class']\\n            record = {'id': view_id, 'question': view['question'], 'open': _open_at(\"),\n    25\t    'check_origins accepting duplicates': (R, \"        packaged = data['questions']\\n\", \"        packaged = list({q['id']: q for q in data['questions']}.values())\\n\"),\n    26\t    'check_origins accepting another order': (R, \"        packaged = data['questions']\\n\",\n    27\t                                              \"        packaged = sorted(data['questions'], key=lambda q: [r['view_id'] for r in views].index(q['id']) if q['id'] in [r['view_id'] for r in views] else -1)\\n\"),\n    28\t    'pipe opened blocking': (R, \"os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=folder)\", \"os.O_RDONLY | os.O_NOFOLLOW, dir_fd=folder)\"),\n    29\t    'store path returned unresolved': (R, \"        raise ReleaseRefused(f'{path}: a store path may not contain {found}, which the SQLite opener reads as URI syntax')\\n    return real\",\n    30\t                                       \"        raise ReleaseRefused(f'{path}: a store path may not contain {found}, which the SQLite opener reads as URI syntax')\\n    return path\"),\n    31\t    'check_origins with an inner join': (R, \"            if item is None:\\n                raise ReleaseRefused(f'evidence {row[\\\"evidence_id\\\"]}\", \"            if item is None:\\n                continue\\n                raise ReleaseRefused(f'evidence {row[\\\"evidence_id\\\"]}\"),\n    32\t    'check without validating the day': (R, \"        bound = expected_as_of if expected_as_of is not None else resolve(views_db, data['as_of'])\",\n    33\t                                         \"        bound = expected_as_of if expected_as_of is not None else data['as_of']\"),\n    34\t    'builder skipping the staged check': (B, \"counts, data, size = release.check_package(staged, views_db, items_db, expected_as_of=bound)\", \"counts, size = release.check_export(data), 0\"),\n    35\t    'symbolic-link check removed': (R, \"os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=folder)\", \"os.open(name, os.O_RDONLY | os.O_NONBLOCK, dir_fd=folder)\"),\n    36\t    'duplicate-key check removed': (R, \"    if len(names) != len(set(names)):\", \"    if False:\"),\n    37\t    'switch reason emitted': (R, \"            record = {'id': view_id, 'question': view['question'], 'open': service.is_open_as_of(views_db, view_id, bound), 'class': kind}\",\n    38\t                              \"            record = {'id': view_id, 'question': view['question'], 'open': service.is_open_as_of(views_db, view_id, bound), 'class': kind, 'reason': (views_db.execute('select reason from view_switches where view_id=? order by id desc', (view_id,)).fetchone() or {'reason': ''})['reason']}\"),\n    39\t    'missing-item refusal replaced by the id fallback': (R, \"        if row is None:\\n            raise ReleaseRefused(f'evidence {evidence_id}: source item {input_id} is not in the items database')\",\n    40\t                                                         \"        if row is None:\\n            row = {'title': input_id, 'publisher': '', 'source_uri': ''}\"),\n    41\t    'publish replaced by os.rename': (R, \"    rename = _no_replace_rename()\\n    if rename is None:\", \"    rename = lambda source, target: os.rename(source, target) or 0\\n    if rename is None:\"),\n    42\t    'the finally removed': (B, \"        if staged is not None:\\n            shutil.rmtree(staged)\\n\", ''),\n    43\t    'staging path not dropped after publish': (B, \"        staged = None                       # published\", \"        pass                                # published\"),\n    44\t    'canonical-day check removed': (R, \"    if day.isoformat() != text:\\n        raise ReleaseRefused\", \"    if False:\\n        raise ReleaseRefused\"),\n    45\t    'key read without its day': (R, \"    return row['measure'] if row is not None and service.visible(conn, row['seq'], as_of) else None\",\n    46\t                                 \"    return row['measure'] if row is not None else None\"),\n    47\t    'null accepted as text': (R, \"        if not isinstance(value[name], str):\", \"        if not (isinstance(value[name], str) or value[name] is None):\"),\n    48\t    'store-path refusal removed': (R, \"    if found:\\n        raise ReleaseRefused(f'{path}: a store path\", \"    if False:\\n        raise ReleaseRefused(f'{path}: a store path\"),\n    49\t    'writer self-check removed': (R, \"    check_export(data)\\n    return data\\n\", \"    return data\\n\"),\n    50\t    'publish_report replaced by os.replace': (R, \"        os.link(temporary, path)\\n\", \"        os.replace(temporary, path)\\n        open(temporary, 'w').close()\\n\"),\n    51\t}\n    52\t\n    53\t\n    54\tdef tree(where):\n    55\t    root = Path(where)\n    56\t    shutil.copytree(REPO / 'src', root / 'src', ignore=shutil.ignore_patterns('__pycache__'))\n    57\t    shutil.copytree(REPO / 'scripts', root / 'scripts', ignore=shutil.ignore_patterns('__pycache__'))\n    58\t    (root / 'tests').mkdir()\n    59\t    for name in ('test_release.py', 'conftest.py'):\n    60\t        shutil.copy(REPO / 'tests' / name, root / 'tests' / name)\n    61\t    return root\n    62\t\n    63\t\n    64\tdef run(root):\n    65\t    return subprocess.run([sys.executable, '-m', 'pytest', 'tests/test_release.py', '-q', '-rf', '-p', 'no:cacheprovider'], cwd=root, capture_output=True, text=True,\n    66\t                          env={'PATH': '/usr/bin:/bin:/usr/local/bin:/opt/homebrew/bin', 'PYTHONPATH': f'{root}/src:{root}/poc', 'PYTHONDONTWRITEBYTECODE': '1', 'HOME': str(Path.home())}, timeout=900)\n    67\t\n    68\t\n    69\twith tempfile.TemporaryDirectory() as base:\n    70\t    control = run(tree(Path(base) / 'control'))\n    71\t    print('control:', 'PASS' if control.returncode == 0 else 'FAIL', control.stdout.strip().splitlines()[-1])\n    72\t    if control.returncode != 0:\n    73\t        raise SystemExit('the unmutated control fails: no mutant is judged')\n    74\t    caught = 0\n    75\t    for n, (name, (relative, old, new)) in enumerate(MUTANTS.items()):\n    76\t        root = tree(Path(base) / f'm{n}')\n    77\t        path = root / relative\n    78\t        text = path.read_text()\n    79\t        assert text.count(old) == 1, (name, text.count(old))\n    80\t        path.write_text(text.replace(old, new))\n    81\t        result = run(root)\n    82\t        failed = [line.split(' ')[1].split('::')[-1] for line in result.stdout.splitlines()\n    83\t                  if line.startswith('FAILED') and 'scratch anchor' not in line]      # a test that failed only on its own scratch edit is not a catch\n    84\t        errors = [line for line in result.stdout.splitlines() if line.startswith('ERROR')]\n    85\t        verdict = 'CAUGHT' if failed and not errors else 'MISSED' if not errors else 'ERROR'   # a setup or collection error is not a catch\n    86\t        caught += verdict == 'CAUGHT'\n    87\t        print(f'{verdict}  {name}: {len(failed)} failing: {\", \".join(failed[:6])}' + (f' | errors: {errors[:2]}' if errors else ''))\n    88\t    print(f'{caught} of {len(MUTANTS)} mutants caught')\n     1\t# \"Forecast unavailable\" release: build design for slice 1 (the exporter and the checked package)\n     2\t\n     3\t**Status: revision 11. Built** (`src/hivemind/release.py`, `scripts/release_build.py`, `tests/test_release.py`; result in\n     4\t`RELEASE-CHECK-RESULT.md`). Revision 10 was ready per council 74j; revision 11 records the changes council 75 required of the build.\n     5\t\n     6\t**Revision 11 (council 75, `codex-r75.md`).** Each change is in the code and has a test and a mutant:\n     7\t- **A view key counts only once it is visible at the bound** (its `seq`). A key written later never reclassifies an earlier package\n     8\t  (test 22).\n     9\t- **Text fields are strings, never null,** as §1 already specified (test 23). The four stores hold no null evidence or item fields.\n    10\t- **`check_package` reads each file once,** through one handle on the folder (`O_DIRECTORY | O_NOFOLLOW`, then `O_NOFOLLOW` per file and\n    11\t  `fstat`). It hashes and parses the same bytes and returns `(counts, data, bytes)`, so the command reports what was checked.\n    12\t- **A store path whose resolved form holds `%`, `?` or `#` is refused** (`release.store_path`), because `store.open_read_only` puts\n    13\t  the path into a SQLite `file:` URI unescaped (test 24). The opener itself is shared POC code and is not changed here.\n    14\t- **The writer's own refusal** is proved by a scratch-copy pair (test 25).\n    15\t- **Both commands print the whole report** before publishing it. Durations use `time.monotonic`. Refusals name the evidence id.\n    16\t- **Council 75b** (`codex-r75b.md`):\n    17\t  - `store_path` returns the resolved path, which the opener is given, so a link is not resolved twice (test 24);\n    18\t  - package files are opened without waiting (`O_NONBLOCK`), so a named pipe is refused by type instead of blocking `check` (test 15);\n    19\t  - reordered questions and evidence are tested (test 10). Release work was opened by the council under D439 (D758). The behaviour is\n    20\tfixed by D726, D756 and `FORECAST-UNAVAILABLE-DESIGN.md` (revision 4). This page holds the AGENTS §2 tables for the first slice.\n    21\t\n    22\t**Revision 2 answers `codex-r74.md`** (see `claude-r74.md`):\n    23\t- the pass condition is an origin check of every field against its stored source, not a string sweep;\n    24\t- a missing source item is refused;\n    25\t- the package is checked before it is moved into place;\n    26\t- the manifest is a closed set;\n    27\t- the bound is validated as a date;\n    28\t- narrow reads;\n    29\t- size and speed budgets;\n    30\t- tests that separate every branch;\n    31\t- `object`, `kind` and groups dropped;\n    32\t- no idea submission.\n    89\t- **Slice 1 (this page), $0:**\n    90\t  - the exporter `release_export` and its self-check;\n    91\t  - the package writer, the package check and the origin check;\n    92\t  - the release builder, which calls the exporter directly;\n    93\t  - tests and mutants;\n    94\t  - the $0 release check on stored stores.\n    95\t- **Slice 2, next.** The release page reads only the package: no live service, no `/library` fetch, no translated JSON, no composite\n    96\t  trials, no idea submission control or route. It gets a browser check of the `old-1/v8` screen, which completes D756's screen check.\n    97\t- **No idea submission in the release** (council 74). The idea path (`idea.py`) reads the ledger at every step and calls a paid model\n    98\t  per idea. The design's §5 idea acceptance (an idea card backed only by `v8`, and its composed request) is carried forward as pending\n    99\t  for the first idea-enabled slice.\n   100\t- **Not in scope:**\n   101\t  - the POC, its API, MCP and page (unchanged);\n   102\t  - colleagues' page;\n   103\t  - frozen pieces, extraction included;\n   104\t  - any model call;\n   105\t  - commit, publish, deploy.\n   106\t\n   107\t## 1. What is built\n   108\t\n   109\t`src/hivemind/release.py` is the one owner, beside `service.py`.\n   110\t\n   111\t- **Constants:**\n   112\t  - `FORMAT = 'hivemind-release/1'`;\n   113\t  - `ALLOW_LIST = 'release-allow-list/1'`;\n   114\t  - `FORECAST_UNAVAILABLE = 'Forecast unavailable'`;\n   115\t  - `PACKAGE_FILES = {'manifest.json', 'release-data.json'}`.\n   116\t- **`ALLOWED`:** the closed key set per record type.\n   117\t\n   118\t  | Record | Keys |\n   119\t  |---|---|\n   120\t  | envelope | `format`, `allow_list`, `as_of`, `questions` |\n   121\t  | number question | `id`, `question`, `open`, `class` (= `number`), `forecast` (= the marker), `evidence` |\n   122\t  | event or Yes/No question | `id`, `question`, `open`, `class` (`event` or `yes_no`), `answers` (the two stored rung labels, in position order), `answer` (the stored label of the latest judgement's rung on or before the bound, or null), `evidence` |\n   123\t  | evidence in force at the bound | `id`, `one_line`, `quote`, `tier`, `speaker`, `original_who`, `original_day`, `sources` |\n   124\t  | source recorded on or before the bound | `title`, `publisher`, `day`, `uri` |\n   125\t  | manifest | `format`, `allow_list`, `as_of`, `data_sha256` |\n   126\t\n   127\t- **`question_class(views_db, view_id, labels)`** (design §3):\n   128\t  - `event` when the view key's measure is in `identity.EVENT_MEASURES`. The key is read as `select measure from view_keys`, and\n   129\t    only when the table exists;\n   130\t  - `yes_no` when there are exactly two labels which, through `vocabulary.canonical('label', …)`, are `Yes` and `No` in either order;\n   131\t  - `number` otherwise: a view with no key, or one whose bands cannot be resolved.\n   132\t- **`release_export(views_db, items_db, as_of=None)`:**\n   133\t  - pins both connections (`bundle.read_snapshot`);\n   134\t  - takes an explicit day only in canonical form: `date.fromisoformat(day).isoformat()` must equal the text given, otherwise\n   135\t    `ReleaseRefused` (so `20260825` is refused, not read as `2026-08-25`). It then resolves the bound with `service.resolve_bound`,\n   136\t    refuses a store with no default day, and uses that canonical text in every query;\n   137\t  - exports every view that exists at the bound (`service.view_exists`), closed ones included, in `created_seq, rowid` order;\n   138\t  - builds each record field by field from the table above, with column-limited SQL:\n   139\t    - `select view_id, question, created_seq from views order by created_seq, rowid`;\n   140\t    - `select position, label from rungs`;\n   141\t    - `select rung from judgements where view_id=? and publication_day<=? order by judgement_id desc limit 1`;\n   142\t    - `service.is_open_as_of`, which reads only `open` and `after_seq`;\n   143\t  - takes evidence in force from `service.evidence` and its fields from that record;\n   144\t  - looks up each source's `title`, `publisher` and `source_uri` in the items database by `input_id`. A visible source whose item is\n   145\t    missing raises `ReleaseRefused` (there is no fallback to the id);\n   146\t  - calls `check_export` on its own result before returning (AGENTS §3: the writer refuses).\n   147\t- **`check_export(data)`:** the closed-set check.\n   148\t  - Every dict at every level has exactly its record type's keys.\n   149\t  - Value checks:\n   150\t    - `format` and `allow_list` equal the constants, and `as_of` is a canonical `YYYY-MM-DD` day (`date.fromisoformat(as_of).isoformat() == as_of`);\n   151\t    - `class` is in its set;\n   152\t    - a number record's `forecast` is the marker;\n   153\t    - `answers` is two strings, and `answer` is one of them or null;\n   154\t    - `open` is a bool and every text field is a string.\n   155\t  - It returns the counts it judged: questions per class, evidence, sources.\n   156\t- **`check_origins(views_db, items_db, data, expected_as_of)`:** the pass condition. It is independent of the exporter's code path.\n   157\t  It derives everything it compares from the store, never from the package.\n   158\t  - **The bound: one rule for both commands.** `expected_as_of` is given by the caller.\n   159\t    - The builder passes the bound it resolved: `service.resolve_bound` on the requested day, or the default when none is given; an\n   160\t      omitted day with no default is refused.\n   161\t    - `check` passes the package's `as_of` through the same `service.resolve_bound`, which refuses a day after a store's last\n   162\t      completed day. A legacy ledger with no completed days accepts any valid date in both commands alike.\n   163\t    - The package's `as_of` must equal `expected_as_of`.\n   164\t  - **The class** of each question is derived from the stored measure and labels (`question_class`). The permitted keys and values\n   165\t    are then chosen from that class, never from the package's `class` field.\n   166\t  - **Order and counts.** The questions are compared as an ordered list in `created_seq, rowid` order, as `bundle.library` orders\n   167\t    them (`old-2/v2` and `v3` share sequence 8). Each question's evidence is compared in link order (`evidence_links.id`), and its\n   168\t    sources in row order (`evidence_sources.id`). A duplicate question, evidence record or source therefore fails.\n   169\t\n   170\t  It compares every field with its permitted stored source at the bound, by direct SQL:\n   171\t  - the question set equals the views visible at the bound, with `question` equal to `views.question`;\n   172\t  - `open` equals the latest visible switch's `open`;\n   173\t  - for `event` and `yes_no`: `answers` equal the rung labels in position order, and `answer` equals the label of the latest judgement\n   174\t    rung on or before the bound, or null;\n   175\t  - for `number`: only the marker;\n   176\t  - the evidence id set equals the links visible at the bound, minus those whose latest replacement is visible, computed in its own\n   177\t    SQL. Each evidence field equals the `evidence` row's column;\n   178\t  - each source list starts from every visible `evidence_sources` row, in row order, with `day` taken from\n   179\t    `evidence_sources.publication_day`. Each row needs a matching `items` row for `title`, `publisher` and `source_uri`; a row with no\n   180\t    item raises `ReleaseRefused` (a left join, so a missing item is never silently dropped).\n   181\t\n   182\t  Any difference raises `ReleaseRefused`, naming the question, the field and the evidence id. It returns the number of fields\n   183\t  compared.\n   184\t- **`stage(out_dir)`:** creates a private staging folder with a name unique to this invocation, `tempfile.mkdtemp(dir=out_dir.parent,\n   185\t  prefix='.<name>.staging-')`. Creation is exclusive, so only this invocation owns it. It returns the path.\n   186\t- **`write_package(data, staged)`:** writes `release-data.json` and `manifest.json` into the staging folder. It creates nothing\n   187\t  else.\n   188\t- **`publish(staged, out_dir)`:** one atomic move that refuses any existing destination, empty or not:\n   189\t  - on macOS, `renamex_np(staged, out_dir, RENAME_EXCL)` through `ctypes`. Verified on this Mac: onto a free path it succeeds; onto\n   190\t    an existing empty or non-empty folder it fails with `EEXIST`, and both folders stay as they were;\n   191\t  - on Linux, `renameat2(AT_FDCWD, staged, AT_FDCWD, out_dir, RENAME_NOREPLACE)`;\n   192\t  - where neither call exists, or the filesystem lacks support (`ENOTSUP`, `EINVAL`), it raises `ReleaseRefused`.\n   193\t\n   194\t  It never replaces, creates or removes anything at `out_dir` except by that one move.\n   195\t- **`check_package(path, views_db=None, items_db=None, expected_as_of=None)`:**\n   196\t  - the directory holds exactly `PACKAGE_FILES`, each a regular file and not a symbolic link (`os.lstat`), with no subdirectories;\n   197\t  - both files parse as JSON with no duplicate member name at any level (an `object_pairs_hook` that refuses a repeated key);\n   198\t  - the manifest has exactly its four keys, and its `format`, `allow_list` and `as_of` equal the data's;\n   199\t  - its sha256 equals the data file's;\n   200\t  - the data passes `check_export`, and, when the stores are given, `check_origins` with the expected bound;\n   201\t  - it returns the counts.\n   202\t- **`withheld_unresolved(views_db, data)`** is for the report only. It lists the number questions whose `service.ladder_bands(rungs)`\n   203\t  returns `(None, reason)`, with the reason and whether the view has a key. Its output never enters the package.\n   204\t\n   205\t`scripts/release_build.py`:\n   206\t- **`build --ledger --items [--as-of] --out`:**\n   207\t  1. refuse an existing `--out` or `<out>.report.json` early, as a convenience. The no-replace publication of each holds the\n   208\t     guarantee;\n   209\t  2. resolve the bound once: a given `--as-of` must be canonical `YYYY-MM-DD` (as above), then `service.resolve_bound`;\n   210\t  3. `stage(--out)`. From here a `finally` removes this staging folder while the build still owns it;\n   211\t  4. `release_export` at that bound;\n   212\t  5. `write_package` into the staging folder;\n   213\t  6. `check_package` on the staged folder, with the stores and the resolved bound;\n   214\t  7. `publish` to `--out`. The moment it succeeds, the build drops its staging path (`staged = None`); the `finally` then removes\n   215\t     nothing;\n   216\t  8. `publish_report`: write the report to a private temporary file in the same folder (`tempfile.mkstemp`), then `os.link` it to\n   217\t     `<out>.report.json`. The link fails with `EEXIST` if anything exists at that name. **A successful link is the moment the report\n   218\t     is published.** The temporary file is then removed. If that removal fails, the command still reports the report as published,\n   219\t     names the leftover temporary file, and exits 0.\n   220\t\n   221\t  The failure outcomes:\n   222\t  - **Before publication** (steps 2–7): any exception, whether `ReleaseRefused`, `OSError`, `sqlite3.Error` or another, prints the\n   223\t    reason and exits 1. The `finally` removes this build's staging folder; nothing exists at `--out` from this build. A corrected\n   224\t    retry at the same `--out` succeeds.\n   225\t  - **After publication, before the link** (step 8 fails before the link succeeds, including `EEXIST`): the package is final and\n   226\t    checked, and whatever is at the report name is untouched. Exit 2 with \"package published and checked; report not written; run\n   227\t    `check` to write it\".\n   228\t\n   229\t  It has no input path for prepared or translated JSON, and it takes no clock reading; the folder name is the caller's (D12, D13).\n   230\t- **`check <out> --ledger --items`:** re-runs `check_package` on an existing package, with the stores, the package's canonical\n   231\t  `as_of` validated against the store (above), and the regular-file and duplicate-key checks. It leaves the package in place, prints\n   232\t  the report, and writes `<out>.report.json` only through `publish_report`, so it never replaces anything. Its exit statuses:\n   233\t  - 0: the package passes, and the report was published;\n   234\t  - 2: the package passes, and the report is not published: its name is occupied (an earlier report, or anything else, which stays\n   235\t    untouched), or writing the temporary file or the link fails for any other reason, which is printed;\n   236\t  - 1: the package is refused, with the reason. This is also the retry after a report write failed. Its report gives `check_seconds` and marks\n   237\t  `export_seconds` as not measured.\n   238\t- **The report:**\n   239\t  - the store path and the bound;\n   240\t  - counts per class;\n   241\t  - the unresolved list;\n   242\t  - the fields compared;\n   243\t  - bytes;\n   244\t  - `export_seconds` (build only) and `check_seconds`.\n   245\t\n   338\t## 6. Tests (`tests/test_release.py`) and mutants\n   339\t\n   340\tThe fixtures use a real store on a temporary path (`store.create_view`, `store.insert`), with a real items database. Each test names\n   341\tits row above:\n   342\t1. **Closed set (§1).**\n   343\t   - Every dict in a fixture export has exactly its type's keys.\n   344\t   - Positive control: an export with one added key fails `check_export`.\n   345\t2. **Number with `lo`/`hi`.** The record carries the marker. No rung label, condition, `reasons`, `why_changed` or `implied_outcome` of\n   346\t   that view appears in any decoded package field.\n   347\t3. **Branch fixtures for identity and the report:**\n   348\t   - a condition-only number that resolves: `number`, and absent from `withheld_unresolved`;\n   349\t   - an unresolved number with a key: `number`, and present;\n   350\t   - an unresolved number without a key: `number`, and present.\n   351\t4. **Yes/No with numeric bounds** (`growth_rate` key, labels Yes/No): `yes_no`, with its answer label. A `why_changed` quoting\n   352\t   \"$1 trillion\" is absent.\n   353\t5. **Event with the served ledger's `v49` labels,** \"Restriction adopted\" / \"No restriction adopted\": `event`, with its label kept. A\n   354\t   `why_changed` quoting another question's band is absent.\n   355\t6. **Legacy store** with no `view_keys` table and `是`/`否` labels: `yes_no`.\n   356\t7. **Closing switch** whose reason names the band label: `open: false`, and the reason is absent.\n   357\t8. **Replacement and source visibility** at two bounds. A visible source with a missing item is refused.\n   358\t9. **Package:**\n   359\t   - staged, then checked, passes;\n   360\t   - a foreign file fails, and so does a subdirectory;\n   361\t   - a changed data byte fails;\n   362\t   - an extra manifest key with an unchanged data hash fails;\n   363\t   - a manifest `as_of` differing from the data's fails;\n   364\t   - an existing `--out`, empty or not, is refused, and a leftover staging folder from another build does not block a build.\n   365\t10. **Origin check, each from the store:**\n   366\t    - in a staged copy, the system's forecast text placed in an evidence `one_line` fails, naming the field;\n   367\t    - a Yes/No record turned into a number record, keeping the closed set, fails;\n   368\t    - a duplicated question, and a duplicated evidence record, each fails;\n   369\t    - a package whose `as_of` is a day later than the store's last completed day fails `check`;\n   370\t    - a legacy fixture with no completed days, built at an explicit day later than its last judgement, passes a later `check`.\n   371\t11. **Builder end to end,** run as the user calls it (subprocess, `--as-of` omitted):\n   372\t    - the build exits 0, and the package and its report exist;\n   373\t    - `check` with the build's report still in place prints a passing result and exits 2;\n   374\t    - after the test removes that report, `check` exits 0 and publishes a fresh one.\n   375\t12. **Builder refusal, through the real command, on a scratch copy** (the AGENTS §4 mutation procedure; no fake in the suite):\n   376\t    - the unchanged command succeeds on the fixture store (test 11);\n   377\t    - on a scratch copy, the writer fault \"one evidence `one_line` taken from the latest judgement's `why_changed`\" is introduced.\n   378\t      The same command exits 1 with the origin-mismatch reason, no `--out` and no staging folder left;\n   379\t    - on a second scratch copy, the same writer fault plus the builder's staged check removed: the bad package reaches `--out`. That\n   380\t      shows the staged check is what prevents publication.\n   381\t13. **`check` with a missing item.** A finished package. Then a copy of the items database with one referenced item deleted, and a\n   382\t    copy of the package with that same source removed and its manifest hash refreshed. `check` refuses, naming the missing item. (An\n   383\t    inner-join mutant accepts this pair, so this case catches it.)\n   384\t14. **The publication rule.**\n   385\t    - Module steps: builds A and B both stage, then A publishes. B's `publish` refuses with `EEXIST`. A's package passes `check`, and\n   386\t      B's staging is still there for its owner to remove.\n   387\t    - Module steps: after staging, a foreign *empty* folder is put at `--out`. `publish` refuses, and the foreign folder still exists\n   388\t      afterwards, empty.\n   389\t    - The command, early: an existing empty `--out` gives exit 1, and the folder survives.\n   390\t    - The command, late (a scratch copy with a pause before `publish`, released by the test): the test creates an empty folder at\n   391\t      `--out` during the pause. The command exits 1, its staging folder is removed, and the same empty folder survives (same device\n   392\t      and inode).\n   393\t    - The command, after the move (a scratch copy with a pause just after `publish`): the test recreates the freed staging name as a\n   394\t      folder holding a marker file. After the command exits 0, the marker is still there.\n   395\t18. **Report over an input.** `--out` is chosen so that `<out>.report.json` is the items database, three ways: the same path, a\n   396\t    case-variant name on this case-insensitive volume, and a symbolic link to it. `build` refuses, and `check` on an existing package\n   397\t    exits 2. The items file's sha256 is unchanged.\n   398\t19. **Report name taken during the build** (a scratch copy with a pause just before `publish_report`): the test writes a marker file\n   399\t    at the report name. The command exits 2 and the marker is unchanged. `check` then prints a passing result, exits 2, and leaves the\n   400\t    marker unchanged.\n   401\t21. **`check` cannot write its report** (a scratch copy in which creating the report's temporary file raises `PermissionError`): `check`\n   402\t    prints the passing result and the write error, and exits 2.\n   403\t20. **Temporary file left after the link** (a scratch copy in which removing the report's temporary file raises): the build exits 0\n   404\t    and says the report is published, naming the leftover temporary file. The report exists and equals the build's report.\n   405\t17. **A database error through the command.** A valid ledger with an items database that has no `items` table: exit 1, the database\n   406\t    error printed, nothing at `--out`, no staging folder left. A retry at the same `--out` with the correct items database succeeds.\n   407\t15. **Files:**\n   408\t    - a symbolic link in place of `release-data.json` fails;\n   409\t    - a data file whose repeated `one_line` member has the genuine value last, with the manifest hash refreshed so every other\n   410\t      check passes, fails on the repeated name.\n   411\t16. **Bound validation:**\n   412\t    - `2026-08-99` is refused;\n   413\t    - `20260825` is refused, while `2026-08-25` builds. On a fixture with evidence on both sides of that day, the package holds only\n   414\t      the earlier evidence;\n   415\t    - a valid day before the first question gives an empty package.\n   416\t\n   417\t**Mutants,** on a scratch copy with `PYTHONDONTWRITEBYTECODE=1`; each must fail a test:\n   418\t- `condition` emitted on number records;\n   419\t- `one_line` taken from the latest judgement's `why_changed`;\n   420\t- the event test removed;\n   421\t- the Yes/No test removed;\n   422\t- `check_package` without the file-set check;\n   423\t- manifest keys unchecked;\n   424\t- `check_export` without the closed-key check;\n   425\t- `check_origins` skipping evidence fields;\n   426\t- `check_origins` taking the class from the package;\n   427\t- `check_origins` comparing sets instead of ordered lists;\n   428\t- `check_origins` with an inner join to `items`;\n   429\t- `check` without validating the package's `as_of` against the store;\n   430\t- the builder skipping the staged `check_package` (the scratch-copy pair in test 12);\n   431\t- `publish` replaced by `os.rename` (test 14's foreign empty folder is then replaced);\n   432\t- the `finally` removed (test 17 then leaves staging);\n   433\t- the staging path not dropped after `publish` (test 14's marker is then removed);\n   434\t- the canonical-day check removed (test 16's `20260825` then builds with later evidence);\n   435\t- `publish_report` replaced by `os.replace` (tests 18 and 19 then overwrite the items file and the marker);\n   436\t- the symbolic-link check removed;\n   437\t- the duplicate-key check removed;\n   438\t- the switch reason emitted;\n   439\t- the missing-item refusal replaced by the id fallback.\n   440\t\n   441\t## 7. The $0 release check (stored stores, read-only)\n   442\t\n   443\tStores: `old-1`, `old-2`, `old-3` (`comparison-2026-11-17/run/old-N/prod/views.sqlite`, items `items-comparison.sqlite`) and the\n   444\tserved ledger with its items database.\n   445\t\n   446\t**Budgets,** set before the first control (AGENTS §2):\n   447\t- the package's data bytes at most `bundle.library`'s JSON bytes on the same store and bound;\n   448\t- export plus all checks at most three times `bundle.library`'s seconds on the same store, and at most 120 s per store.\n   449\t\n   450\tThe steps:\n   451\t1. **Build each store's package at its default bound.** The build passes `check_package` with `check_origins`. Report the fields\n   452\t   compared, the counts per class and the unresolved list.\n   453\t2. **The decisive acceptance case** (council 74), on the `old-1` package:\n   454\t   - Morningstar's `$361 billion` estimate (`e2295`) is kept, its summary and quote equal to the stored ones;\n   455\t   - the genuine \"Bullish confirmation\" quote (`e1865`) is kept;\n   456\t   - the genuine analyst \"$390 billion\" quote (`e3597`) is kept, as the control;\n   457\t   - in a copy of the staged package, the system's `old-1` j1580 `implied_outcome` (\"About $390 billion…\") substituted into\n   458\t     `e2295`'s summary fails `check_origins`;\n   459\t   - the same text added to the manifest fails `check_package`.\n   460\t3. **`old-1/v8`:** `class` is `number`, with the marker and the same evidence ids as `service.evidence` at the bound.\n   461\t4. **The known event leaks at their own dates.** Export `old-3` at 2026-08-25 (`v36` j799 is the latest judgement) and `old-1` at\n   462\t   2026-08-28 (`v10` j865). Each keeps its original answer label, and j799's \"around $1 trillion\" text and j865's band text are absent.\n   463\t5. **Control:** one unchanged event question keeps its label and evidence.\n   464\t6. **Closing.** On a temporary copy of `old-1`, add a closing switch for `v8` in the store's own format (\"due …, frozen on … at\n   465\t   rung N <label>\"). First confirm that `bundle.view_bundle` exposes the reason with the band label. Then confirm the package shows\n   466\t   `open: false` and not the reason.\n   467\t7. **Diagnostics** (not the gate). For every question, take each string the package must not hold:\n   468\t   - rung labels and conditions;\n   469\t   - judgement `reasons` and `why_changed`, and `implied_outcome` and `reference` where the store has those columns (the served\n   470\t     ledger has neither; the report says so);\n   471\t   - switch reasons.\n   472\t\n   473\t   Search every decoded string field of the package for each, with no floor. List every hit with its question, field, evidence id\n   474\t   and the stored string it matched, and read each by hand. A genuine source quote, such as `e1865`'s \"Bullish\", is recorded as such.\n   475\t8. **Budgets:** bytes and seconds against the budgets above.\n   476\t\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_15","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba tests/test_release.py | sed -n '1,407p'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba tests/test_release.py | sed -n '1,407p'\"","aggregated_output":"     1\t\"\"\"The \"Forecast unavailable\" release package (docs/research/2026-11-22-number-answers/RELEASE-BUILD.md, revision 10; D726, D758).\n     2\t\n     3\tEach test names the design row it proves (§1 the closed set and the checks, §2 state × event, §6 the numbered tests). The stores are\n     4\treal SQLite files on a temporary path; the only edits of code are the mutation-procedure scratch copies of §6 tests 12, 14, 19, 20\n     5\tand 21, which insert a pause or a fault into a copy of the module and the command.\"\"\"\n     6\timport hashlib\n     7\timport json\n     8\timport os\n     9\timport shutil\n    10\timport sqlite3\n    11\timport subprocess\n    12\timport sys\n    13\timport time\n    14\tfrom pathlib import Path\n    15\t\n    16\timport pytest\n    17\t\n    18\tROOT = Path(__file__).resolve().parents[1]\n    19\tsys.path.insert(0, str(ROOT / 'src'))\n    20\tfrom hivemind import release, service  # noqa: E402\n    21\tfrom hivemind.views import store  # noqa: E402\n    22\t\n    23\tCOMMAND = ROOT / 'scripts' / 'release_build.py'\n    24\tDAYS = ['2026-08-24', '2026-08-25', '2026-08-26']\n    25\tASSET_LABELS = ['Strongly bullish', 'Bullish', 'Neutral', 'Bearish', 'Strongly bearish']\n    26\tV1_CONDITIONS = ['FY2027 revenue is at least $400 billion.', 'FY2027 revenue is at least $350 billion and less than $400 billion.',\n    27\t                 'FY2027 revenue is at least $300 billion and less than $350 billion.', 'FY2027 revenue is at least $250 billion and less than $300 billion.',\n    28\t                 'FY2027 revenue is less than $250 billion.']\n    29\tV1_BOUNDS = [(400e9, None), (350e9, 400e9), (300e9, 350e9), (250e9, 300e9), (None, 250e9)]\n    30\tV1_REASONS = 'The first-half figure and the third-quarter guide support an estimate of about $390 billion for the year.'\n    31\tV1_WHY = 'Moved up to the $350 billion to under $400 billion rung on the raised guide.'\n    32\tV5_WHY = 'Spending of around $1 trillion in 2027 makes acceleration likely.'\n    33\tV6_WHY = 'The revenue question now sits in the $350 billion to under $400 billion rung, which the rule would cut.'\n    34\tCLOSING = 'due 2026-08-25, frozen on 2026-08-25 at rung 2 Bullish'\n    35\t\n    36\t\n    37\tdef make_items(path, ids=('item-1', 'item-2', 'item-3')):\n    38\t    conn = sqlite3.connect(path)\n    39\t    conn.execute('create table items (input_id text primary key, title text, publisher text, publisher_type text, category text, publication_day text, source_uri text)')\n    40\t    for n, input_id in enumerate(ids, 1):\n    41\t        conn.execute('insert into items values (?,?,?,?,?,?,?)', (input_id, f'Article {n} on data-center spending', f'Publisher {n}', 'news', 'T1',\n    42\t                                                                 DAYS[min(n, 3) - 1], f'https://example.com/article-{n}'))\n    43\t    conn.commit()\n    44\t    conn.close()\n    45\t    return path\n    46\t\n    47\t\n    48\tdef five_rungs(conditions, bounds=None):\n    49\t    return [dict(label=label, condition=condition, **({'lo': lo, 'hi': hi} if bounds else {}))\n    50\t            for label, condition, (lo, hi) in zip(ASSET_LABELS, conditions, bounds or [(None, None)] * 5)]\n    51\t\n    52\t\n    53\tdef key(conn, view_id, measure, event_type='n/a'):\n    54\t    store.insert(conn, 'view_keys', view_id=view_id, measure=measure, scope='NVIDIA', scope_key='nvidia', period_start='2026-02-01',\n    55\t                 period_end='2027-01-31', basis='n/a', unit='USD', event_type=event_type, seq=1, scope_source='model', key_version=1)\n    56\t\n    57\t\n    58\tdef judge(conn, view_id, seq, rung, why, reasons='', implied=None):\n    59\t    store.insert(conn, 'judgements', view_id=view_id, seq=seq, input_id=f'item-{seq}', rung=rung, reasons=reasons, cited_evidence_json='[]',\n    60\t                 cited_views_json='[]', pushes_json='[]', changed=1, why_changed=why, publication_day=DAYS[seq - 1], theme_pushes_json='[]',\n    61\t                 reference=None, implied_outcome=implied)\n    62\t\n    63\t\n    64\tdef evidence(conn, evidence_id, view_id, seq, one_line, quote, sources):\n    65\t    store.insert(conn, 'evidence', evidence_id=evidence_id, quote=quote, one_line=one_line, speaker='Publisher', original_who='NVIDIA',\n    66\t                 original_day=DAYS[seq - 1], tier='party_statement', event_time=None, created_seq=seq, created_from_input=f'item-{seq}')\n    67\t    store.insert(conn, 'evidence_links', evidence_id=evidence_id, view_id=view_id, seq=seq)\n    68\t    for input_id, source_seq in sources:\n    69\t        store.insert(conn, 'evidence_sources', evidence_id=evidence_id, input_id=input_id, category='T1', publication_day=DAYS[source_seq - 1], seq=source_seq)\n    70\t\n    71\t\n    72\tdef make_store(path):\n    73\t    \"\"\"§6 fixture: three completed days; a number question with bounds (v1), one whose conditions resolve without a key (v2), unresolved\n    74\t    ones with a key (v3) and without (v4), a Yes/No question with numeric bounds (v5), an event (v6) and a closed number question (v7).\"\"\"\n    75\t    conn = store.open_db(str(path))\n    76\t    for seq, day in enumerate(DAYS, 1):\n    77\t        store.insert(conn, 'processing_steps', input_id=f'item-{seq}', sequence_no=seq, step='handed_over', result='ok', publication_day=day)\n    78\t        store.insert(conn, 'days_completed', day=day, seq=seq)\n    79\t    common = dict(object_id='NVDA', object_kind='company', kind='asset', due_day='2027-02-25', year='2027', seq=1, input_id='item-1', created_at='2026-08-24T12:00:00Z')\n    80\t    store.create_view(conn, view_id='v1', looks_at='NVIDIA revenue in FY2027', question='How much revenue will NVIDIA report for FY2027?', rungs=five_rungs(V1_CONDITIONS, V1_BOUNDS), **common)\n    81\t    key(conn, 'v1', 'revenue')\n    82\t    store.create_view(conn, view_id='v2', looks_at='NVIDIA FY2027 capital spending', question='How much will NVIDIA spend on capital in FY2027?',\n    83\t                      rungs=[{'label': '看多', 'condition': '不低于4000亿美元'}, {'label': '看空', 'condition': '低于4000亿美元'}], **common)\n    84\t    unreadable = ['Revenue is clearly strong.', 'Revenue is strong.', 'Revenue is flat.', 'Revenue is weak.', 'Revenue is clearly weak.']\n    85\t    store.create_view(conn, view_id='v3', looks_at='NVIDIA gaming revenue', question='How much gaming revenue will NVIDIA report for FY2027?', rungs=five_rungs(unreadable), **common)\n    86\t    key(conn, 'v3', 'segment_revenue')\n    87\t    store.create_view(conn, view_id='v4', looks_at='NVIDIA auto revenue', question='How much automotive revenue will NVIDIA report for FY2027?', rungs=five_rungs(unreadable), **common)\n    88\t    store.create_view(conn, view_id='v5', looks_at='Hyperscaler capex growth', question='Will hyperscaler capital spending growth accelerate in 2027?',\n    89\t                      rungs=[{'label': 'Yes', 'condition': 'Growth above zero', 'lo': 0.0, 'hi': None}, {'label': 'No', 'condition': 'Growth at or below zero', 'lo': None, 'hi': 0.0}], **common)\n    90\t    key(conn, 'v5', 'growth_rate')\n    91\t    store.create_view(conn, view_id='v6', looks_at='US export restriction', question='Will the US adopt the chip export restriction by 2027-01-31?',\n    92\t                      rungs=[{'label': 'Restriction adopted', 'condition': 'The rule is adopted'}, {'label': 'No restriction adopted', 'condition': 'The rule is not adopted'}], **common)\n    93\t    key(conn, 'v6', 'policy_event', 'regulation')\n    94\t    store.create_view(conn, view_id='v7', looks_at='NVIDIA Q2 revenue', question='How much revenue will NVIDIA report for Q2 FY2027?', rungs=five_rungs(V1_CONDITIONS, V1_BOUNDS), **common)\n    95\t    key(conn, 'v7', 'revenue')\n    96\t    judge(conn, 'v1', 1, 2, V1_WHY, V1_REASONS, 'About $390 billion')\n    97\t    judge(conn, 'v5', 1, 1, V5_WHY)\n    98\t    judge(conn, 'v6', 1, 2, V6_WHY)\n    99\t    judge(conn, 'v7', 1, 2, 'Held at the Bullish rung.')\n   100\t    store.insert(conn, 'view_switches', view_id='v7', open=0, reason=CLOSING, by_whom='pull', after_seq=2)\n   101\t    evidence(conn, 'e1', 'v1', 1, 'NVIDIA reported $164 billion of revenue in the first half.', 'The company generated $164 billion in the first six months.', [('item-1', 1), ('item-3', 3)])\n   102\t    evidence(conn, 'e2', 'v1', 3, 'Morningstar estimates $361 billion of revenue for the year.', 'We estimate it will be $361 billion in fiscal 2027.', [('item-3', 3)])\n   103\t    evidence(conn, 'e3', 'v1', 1, 'An early report put spending at $90 billion.', 'Spending was $90 billion, the report said.', [('item-1', 1)])\n   104\t    evidence(conn, 'e4', 'v1', 2, 'A corrected report put spending at $95 billion.', 'Spending was $95 billion, the corrected report said.', [('item-2', 2)])\n   105\t    store.insert(conn, 'replacements', old_evidence_id='e3', new_evidence_id='e4', said_day=DAYS[1], seq=2)\n   106\t    evidence(conn, 'e5', 'v6', 1, 'Officials said the export rule is under review.', 'The rule is under review, officials said.', [('item-1', 1)])\n   107\t    evidence(conn, 'e6', 'v5', 1, 'Bullish confirmation would need firm orders, the author said.', 'Bullish confirmation would require firm procurement commitments.', [('item-2', 1)])\n   108\t    conn.commit()\n   109\t    conn.close()\n   110\t    return path\n   111\t\n   112\t\n   113\t@pytest.fixture\n   114\tdef stores(tmp_path):\n   115\t    return make_store(tmp_path / 'views.sqlite'), make_items(tmp_path / 'items.sqlite')\n   116\t\n   117\t\n   118\tdef export(stores, as_of=None):\n   119\t    views_db, items_db = service.open_ledger(str(stores[0])), store.open_read_only(str(stores[1]))\n   120\t    try:\n   121\t        return release.release_export(views_db, items_db, as_of)\n   122\t    finally:\n   123\t        views_db.close()\n   124\t        items_db.close()\n   125\t\n   126\t\n   127\tdef strings(value):\n   128\t    \"\"\"Every decoded string in the package (keys excluded).\"\"\"\n   129\t    if isinstance(value, dict):\n   130\t        return [s for v in value.values() for s in strings(v)]\n   131\t    if isinstance(value, list):\n   132\t        return [s for v in value for s in strings(v)]\n   133\t    return [value] if isinstance(value, str) else []\n   134\t\n   135\t\n   136\tdef by_id(data):\n   137\t    return {q['id']: q for q in data['questions']}\n   138\t\n   139\t\n   140\tdef run(*args, cwd=None, timeout=120):\n   141\t    return subprocess.run([sys.executable, str(COMMAND), *map(str, args)], capture_output=True, text=True, cwd=cwd,\n   142\t                          env={**os.environ, 'PYTHONDONTWRITEBYTECODE': '1'}, timeout=timeout)\n   143\t\n   144\t\n   145\tdef build_package(stores, out, as_of=None):\n   146\t    views_db, items_db = service.open_ledger(str(stores[0])), store.open_read_only(str(stores[1]))\n   147\t    try:\n   148\t        data = release.release_export(views_db, items_db, as_of)\n   149\t        staged = release.stage(out)\n   150\t        release.write_package(data, staged)\n   151\t        release.check_package(staged, views_db, items_db, expected_as_of=data['as_of'])\n   152\t        release.publish(staged, out)\n   153\t        return data\n   154\t    finally:\n   155\t        views_db.close()\n   156\t        items_db.close()\n   157\t\n   158\t\n   159\tdef rewrite_data(package, data):\n   160\t    \"\"\"A copy of the package's data with its manifest hash refreshed, so every other check still passes.\"\"\"\n   161\t    payload = json.dumps(data, ensure_ascii=False, separators=(',', ':')).encode()\n   162\t    (package / release.DATA_FILE).write_bytes(payload)\n   163\t    manifest = json.loads((package / release.MANIFEST_FILE).read_text())\n   164\t    manifest.update(as_of=data['as_of'], data_sha256=hashlib.sha256(payload).hexdigest())\n   165\t    (package / release.MANIFEST_FILE).write_text(json.dumps(manifest))\n   166\t\n   167\t\n   168\tdef check(stores, package):\n   169\t    \"\"\"The counts of `check_package` with the stores.\"\"\"\n   170\t    views_db, items_db = service.open_ledger(str(stores[0])), store.open_read_only(str(stores[1]))\n   171\t    try:\n   172\t        return release.check_package(package, views_db, items_db)[0]\n   173\t    finally:\n   174\t        views_db.close()\n   175\t        items_db.close()\n   176\t\n   177\t\n   178\t# ---------- §6 tests 1–8: the export\n   179\t\n   180\t\n   181\tdef test_1_every_object_holds_exactly_its_record_types_keys(stores):\n   182\t    \"\"\"§1 ALLOWED, §6 test 1: the export passes the closed-set check; one added key fails it.\"\"\"\n   183\t    data = export(stores)\n   184\t    counts = release.check_export(data)\n   185\t    assert counts['questions'] == {'number': 5, 'event': 1, 'yes_no': 1} and counts['evidence'] == 5\n   186\t    assert set(by_id(data)['v1']) == release.ALLOWED['number'] and set(by_id(data)['v6']) == release.ALLOWED['answered']\n   187\t    by_id(data)['v1']['condition'] = V1_CONDITIONS[1]\n   188\t    with pytest.raises(release.ReleaseRefused, match='off the allow-list'):\n   189\t        release.check_export(data)\n   190\t\n   191\t\n   192\tdef test_2_number_question_carries_only_the_marker_and_its_evidence(stores):\n   193\t    \"\"\"§6 test 2 (D726): no rung label, condition, reason, explanation or implied outcome of v1 reaches any decoded field.\"\"\"\n   194\t    data = export(stores)\n   195\t    v1 = by_id(data)['v1']\n   196\t    assert v1['class'] == 'number' and v1['forecast'] == release.FORECAST_UNAVAILABLE\n   197\t    assert [e['id'] for e in v1['evidence']] == ['e1', 'e2', 'e4']\n   198\t    texts, own = strings(data), strings(v1)\n   199\t    for forbidden in [*V1_CONDITIONS, V1_REASONS, V1_WHY, 'About $390 billion']:\n   200\t        assert not any(forbidden in text for text in texts), forbidden\n   201\t    for label in ASSET_LABELS:                        # the selected label \"Bullish\" included; v1's own fields hold none\n   202\t        assert not any(label in text for text in own), label\n   203\t    shown = [text for q in data['questions'] for key, value in q.items() if key != 'evidence' for text in strings(value)]\n   204\t    for label in ASSET_LABELS:                        # nor does any question's own field (only sources may use the word)\n   205\t        assert not any(label in text for text in shown), label\n   206\t\n   207\t\n   208\tdef test_3_identity_branches_and_the_unresolved_report(stores):\n   209\t    \"\"\"§1 question_class, §6 test 3: a condition-only ladder that resolves and unresolved ladders with and without a key are all\n   210\t    number questions; only the unresolved two are listed.\"\"\"\n   211\t    data = export(stores)\n   212\t    assert {q['id']: q['class'] for q in data['questions']} == {'v1': 'number', 'v2': 'number', 'v3': 'number', 'v4': 'number', 'v5': 'yes_no', 'v6': 'event', 'v7': 'number'}\n   213\t    views_db = service.open_ledger(str(stores[0]))\n   214\t    try:\n   215\t        listed = {entry['id']: entry['has_key'] for entry in release.withheld_unresolved(views_db, data)}\n   216\t    finally:\n   217\t        views_db.close()\n   218\t    assert listed == {'v3': True, 'v4': False}\n   219\t\n   220\t\n   221\tdef test_4_yes_no_with_numeric_bounds_keeps_its_label_not_its_explanation(stores):\n   222\t    \"\"\"§6 test 4 (§4 a): v5 is Yes/No with its answer; its explanation quoting $1 trillion is absent.\"\"\"\n   223\t    data = export(stores)\n   224\t    v5 = by_id(data)['v5']\n   225\t    assert (v5['class'], v5['answers'], v5['answer']) == ('yes_no', ['Yes', 'No'], 'Yes')\n   226\t    assert not any('$1 trillion' in text for text in strings(data))\n   227\t\n   228\t\n   229\tdef test_5_event_keeps_its_labels_not_its_explanation(stores):\n   230\t    \"\"\"§6 test 5: an event with the served ledger's labels keeps them; its explanation quoting v1's rung is absent.\"\"\"\n   231\t    data = export(stores)\n   232\t    v6 = by_id(data)['v6']\n   233\t    assert (v6['class'], v6['answers'], v6['answer']) == ('event', ['Restriction adopted', 'No restriction adopted'], 'No restriction adopted')\n   234\t    assert not any(V6_WHY in text for text in strings(data))\n   235\t\n   236\t\n   237\tdef test_6_legacy_ledger_without_a_key_table_reads_chinese_yes_no(tmp_path):\n   238\t    \"\"\"§6 test 6, §2 legacy row: no view_keys table; 是/否 labels are Yes/No.\"\"\"\n   239\t    path = tmp_path / 'legacy.sqlite'\n   240\t    conn = store.open_db(str(path))\n   241\t    conn.execute('drop table view_keys')\n   242\t    store.insert(conn, 'processing_steps', input_id='item-1', sequence_no=1, step='handed_over', result='ok', publication_day=DAYS[0])\n   243\t    store.insert(conn, 'days_completed', day=DAYS[0], seq=1)\n   244\t    store.create_view(conn, view_id='v1', object_id='NVDA', object_kind='company', kind='asset', looks_at='Shipments', question='会开始量产出货吗？',\n   245\t                      due_day='2026-12-31', year='2026', rungs=[{'label': '是', 'condition': '开始出货'}, {'label': '否', 'condition': '未开始出货'}],\n   246\t                      seq=1, input_id='item-1', created_at='2026-08-24T12:00:00Z')\n   247\t    judge(conn, 'v1', 1, 1, '已确认出货。')\n   248\t    conn.commit()\n   249\t    conn.close()\n   250\t    data = export((path, make_items(tmp_path / 'items.sqlite')))\n   251\t    assert (data['questions'][0]['class'], data['questions'][0]['answer']) == ('yes_no', '是')\n   252\t\n   253\t\n   254\tdef test_7_closed_question_shows_closed_without_its_reason(stores):\n   255\t    \"\"\"§6 test 7, §2 closing row: v7 is closed at 08-25; the closing reason naming its rung is absent.\"\"\"\n   256\t    assert by_id(export(stores, DAYS[0]))['v7']['open'] is True\n   257\t    data = export(stores)\n   258\t    assert by_id(data)['v7']['open'] is False\n   259\t    assert not any(CLOSING in text or 'frozen on' in text for text in strings(data))\n   260\t\n   261\t\n   262\tdef test_8_replacements_and_sources_follow_the_day_and_missing_items_refuse(stores, tmp_path):\n   263\t    \"\"\"§6 test 8, §2 replacement and source rows: e3 is in force until its replacement on 08-25; e1's second source appears on 08-26;\n   264\t    a visible source with no item is refused.\"\"\"\n   265\t    early, late = by_id(export(stores, DAYS[0]))['v1'], by_id(export(stores))['v1']\n   266\t    assert [e['id'] for e in early['evidence']] == ['e1', 'e3']\n   267\t    assert [e['id'] for e in late['evidence']] == ['e1', 'e2', 'e4']\n   268\t    assert [s['day'] for s in early['evidence'][0]['sources']] == [DAYS[0]]\n   269\t    assert [s['day'] for s in late['evidence'][0]['sources']] == [DAYS[0], DAYS[2]]\n   270\t    short = make_items(tmp_path / 'short.sqlite', ids=('item-1', 'item-2'))\n   271\t    with pytest.raises(release.ReleaseRefused, match='item-3 is not in the items database'):\n   272\t        export((stores[0], short))\n   273\t\n   274\t\n   275\t# ---------- §6 tests 9, 10, 13, 15, 16: the package and the origin check\n   276\t\n   277\t\n   278\tdef test_9_package_files_hash_and_manifest(stores, tmp_path):\n   279\t    \"\"\"§1 check_package, §6 test 9.\"\"\"\n   280\t    out = tmp_path / 'release'\n   281\t    data = build_package(stores, out)\n   282\t    assert check(stores, out)['fields_compared'] > 0\n   283\t    variants = {\n   284\t        'foreign file': (lambda p: (p / 'notes.txt').write_text('x'), 'not exactly'),\n   285\t        'subdirectory': (lambda p: (p / 'extra').mkdir(), 'not exactly'),\n   286\t        'changed byte': (lambda p: (p / release.DATA_FILE).write_bytes((p / release.DATA_FILE).read_bytes().replace(b'Morningstar', b'Morningstan')), 'sha256'),\n   287\t        'manifest prose': (lambda p: (p / release.MANIFEST_FILE).write_text(json.dumps({**json.loads((p / release.MANIFEST_FILE).read_text()), 'note': 'About $390 billion'})), 'off the allow-list'),\n   288\t        'manifest day': (lambda p: (p / release.MANIFEST_FILE).write_text(json.dumps({**json.loads((p / release.MANIFEST_FILE).read_text()), 'as_of': DAYS[0]})), 'differs from the data'),\n   289\t    }\n   290\t    for name, (damage, reason) in variants.items():\n   291\t        copy = tmp_path / f'copy-{name.replace(\" \", \"-\")}'\n   292\t        shutil.copytree(out, copy)\n   293\t        damage(copy)\n   294\t        with pytest.raises(release.ReleaseRefused, match=reason):\n   295\t            check(stores, copy)\n   296\t    with pytest.raises(FileExistsError):\n   297\t        staged = release.stage(out)\n   298\t        release.write_package(data, staged)\n   299\t        release.publish(staged, out)\n   300\t    (tmp_path / '.other.staging-x').mkdir()            # another build's debris blocks nothing\n   301\t    assert build_package(stores, tmp_path / 'other')\n   302\t\n   303\t\n   304\tdef test_10_origin_check_derives_everything_from_the_store(stores, tmp_path):\n   305\t    \"\"\"§1 check_origins, §6 test 10: a forecast in a summary, a class swap, duplicates, another order and a future day are each\n   306\t    refused.\"\"\"\n   307\t    out = tmp_path / 'release'\n   308\t    data = build_package(stores, out)\n   309\t    cases = {}\n   310\t    forged = json.loads(json.dumps(data))\n   311\t    by_id(forged)['v1']['evidence'][1]['one_line'] = 'About $390 billion'\n   312\t    cases['forecast in a summary'] = (forged, 'evidence e2.one_line')\n   313\t    swapped = json.loads(json.dumps(data))\n   314\t    v5 = by_id(swapped)['v5']\n   315\t    for name in ('answers', 'answer'):\n   316\t        del v5[name]\n   317\t    v5.update({'class': 'number', 'forecast': release.FORECAST_UNAVAILABLE})\n   318\t    cases['class swap'] = (swapped, 'v5')\n   319\t    doubled = json.loads(json.dumps(data))\n   320\t    doubled['questions'].insert(1, doubled['questions'][0])\n   321\t    cases['duplicate question'] = (doubled, 'entries')\n   322\t    repeated = json.loads(json.dumps(data))\n   323\t    by_id(repeated)['v1']['evidence'].append(by_id(repeated)['v1']['evidence'][0])\n   324\t    cases['duplicate evidence'] = (repeated, 'entries')\n   325\t    future = json.loads(json.dumps(data))\n   326\t    future['as_of'] = '2026-08-27'\n   327\t    cases['future day'] = (future, 'not completed')\n   328\t    reordered = json.loads(json.dumps(data))\n   329\t    reordered['questions'][0], reordered['questions'][1] = reordered['questions'][1], reordered['questions'][0]\n   330\t    cases['reordered questions'] = (reordered, 'order')\n   331\t    swapped = json.loads(json.dumps(data))\n   332\t    pieces = by_id(swapped)['v1']['evidence']\n   333\t    pieces[0], pieces[1] = pieces[1], pieces[0]\n   334\t    cases['reordered evidence'] = (swapped, 'evidence e1')\n   335\t    for name, (changed, reason) in cases.items():\n   336\t        copy = tmp_path / f'copy-{name.replace(\" \", \"-\")}'\n   337\t        shutil.copytree(out, copy)\n   338\t        rewrite_data(copy, changed)\n   339\t        with pytest.raises(ValueError, match=reason):\n   340\t            check(stores, copy)\n   341\t\n   342\t\n   343\tdef test_10_legacy_store_without_completed_days_passes_one_date_rule(tmp_path):\n   344\t    \"\"\"§2 legacy row, §6 test 10: no completed days and no processing steps; an explicit day after the last judgement builds and the\n   345\t    same day passes a later check.\"\"\"\n   346\t    path = tmp_path / 'legacy.sqlite'\n   347\t    conn = store.open_db(str(path))\n   348\t    store.create_view(conn, view_id='v1', object_id='NVDA', object_kind='company', kind='asset', looks_at='Shipments', question='Will shipments begin?',\n   349\t                      due_day='2026-12-31', year='2026', rungs=[{'label': 'Yes', 'condition': 'Begin'}, {'label': 'No', 'condition': 'Do not begin'}],\n   350\t                      seq=1, input_id='item-1', created_at='2026-08-24T12:00:00Z')\n   351\t    judge(conn, 'v1', 1, 1, 'Shipments confirmed.')\n   352\t    conn.commit()\n   353\t    conn.close()\n   354\t    pair = (path, make_items(tmp_path / 'items.sqlite'))\n   355\t    build_package(pair, tmp_path / 'release', '2026-09-30')\n   356\t    assert check(pair, tmp_path / 'release')['questions'] == {'number': 0, 'event': 0, 'yes_no': 0}\n   357\t\n   358\t\n   359\tdef test_13_check_refuses_a_missing_item_even_when_the_package_omits_its_source(stores, tmp_path):\n   360\t    \"\"\"§6 test 13: the items copy lacks item-3; the package copy drops every item-3 source, keeping e2 with none, its hash refreshed.\n   361\t    A checker that silently skips a missing item accepts this pair; the release refuses it, naming the item.\"\"\"\n   362\t    out = tmp_path / 'release'\n   363\t    data = build_package(stores, out)\n   364\t    short = make_items(tmp_path / 'short.sqlite', ids=('item-1', 'item-2'))\n   365\t    copy = tmp_path / 'copy'\n   366\t    shutil.copytree(out, copy)\n   367\t    for piece in by_id(data)['v1']['evidence']:      # e1 loses its item-3 source, e2 keeps its record with no source: what a checker\n   368\t        piece['sources'] = [s for s in piece['sources'] if s['uri'] != 'https://example.com/article-3']   # that drops missing items expects\n   369\t    rewrite_data(copy, data)\n   370\t    with pytest.raises(release.ReleaseRefused, match='evidence e1: source item item-3 is not in the items database'):\n   371\t        check((stores[0], short), copy)\n   372\t\n   373\t\n   374\tdef test_15_symbolic_links_and_repeated_member_names_are_refused(stores, tmp_path):\n   375\t    \"\"\"§6 test 15: a symbolic link, a repeated member name and a named pipe are refused (the pipe without waiting).\"\"\"\n   376\t    out = tmp_path / 'release'\n   377\t    build_package(stores, out)\n   378\t    linked = tmp_path / 'linked'\n   379\t    shutil.copytree(out, linked)\n   380\t    (tmp_path / 'outside.json').write_bytes((linked / release.DATA_FILE).read_bytes())\n   381\t    (linked / release.DATA_FILE).unlink()\n   382\t    (linked / release.DATA_FILE).symlink_to(tmp_path / 'outside.json')\n   383\t    with pytest.raises(release.ReleaseRefused, match='not a regular file'):\n   384\t        check(stores, linked)\n   385\t    repeated = tmp_path / 'repeated'\n   386\t    shutil.copytree(out, repeated)\n   387\t    raw = (repeated / release.DATA_FILE).read_bytes()\n   388\t    genuine = b'\"one_line\":\"Morningstar estimates $361 billion of revenue for the year.\"'\n   389\t    assert raw.count(genuine) == 1\n   390\t    payload = raw.replace(genuine, b'\"one_line\":\"About $390 billion\",' + genuine)\n   391\t    (repeated / release.DATA_FILE).write_bytes(payload)\n   392\t    manifest = json.loads((repeated / release.MANIFEST_FILE).read_text())\n   393\t    manifest['data_sha256'] = hashlib.sha256(payload).hexdigest()\n   394\t    (repeated / release.MANIFEST_FILE).write_text(json.dumps(manifest))\n   395\t    with pytest.raises(release.ReleaseRefused, match='member name repeats'):\n   396\t        check(stores, repeated)\n   397\t    piped = tmp_path / 'piped'\n   398\t    shutil.copytree(out, piped)\n   399\t    (piped / release.DATA_FILE).unlink()\n   400\t    os.mkfifo(piped / release.DATA_FILE)\n   401\t    result = run('check', piped, '--ledger', stores[0], '--items', stores[1], timeout=30)      # a blocking open would hang here\n   402\t    assert result.returncode == 1 and 'not a regular file' in result.stderr\n   403\t\n   404\t\n   405\tdef test_16_the_day_must_be_valid_and_canonical(stores):\n   406\t    \"\"\"§2 day rows, §6 test 16.\"\"\"\n   407\t    for day in ('2026-08-99', '20260825'):\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_16","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba tests/test_release.py | sed -n '405,710p'; ls -la poc/data/release-check-2026-11-23c; rg -n 'def (open_read_only|open_ledger|real_path|visible|read_snapshot)' src/hivemind\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba tests/test_release.py | sed -n '405,710p'; ls -la poc/data/release-check-2026-11-23c; rg -n 'def (open_read_only|open_ledger|real_path|visible|read_snapshot)' src/hivemind\"","aggregated_output":"   405\tdef test_16_the_day_must_be_valid_and_canonical(stores):\n   406\t    \"\"\"§2 day rows, §6 test 16.\"\"\"\n   407\t    for day in ('2026-08-99', '20260825'):\n   408\t        with pytest.raises(release.ReleaseRefused):\n   409\t            export(stores, day)\n   410\t    assert [e['id'] for e in by_id(export(stores, '2026-08-25'))['v1']['evidence']] == ['e1', 'e4']\n   411\t    views_db = service.open_ledger(str(stores[0]))\n   412\t    try:\n   413\t        with pytest.raises(service.BoundNotCompleted):\n   414\t            release.resolve(views_db, '2026-08-27')\n   415\t    finally:\n   416\t        views_db.close()\n   417\t\n   418\t\n   419\tdef test_16_a_day_before_the_first_question_gives_an_empty_package(stores):\n   420\t    \"\"\"§2 row \"valid day before the first visible question\", §6 test 16: the store's questions open on 08-24.\"\"\"\n   421\t    data = export(stores, '2026-08-23')\n   422\t    assert data['as_of'] == '2026-08-23' and data['questions'] == []\n   423\t\n   424\t\n   425\t# ---------- §6 tests 11, 17, 18: the command\n   426\t\n   427\t\n   428\tdef test_11_command_end_to_end_with_check_statuses(stores, tmp_path):\n   429\t    \"\"\"§1 the builder and check, §6 test 11.\"\"\"\n   430\t    out = tmp_path / 'release'\n   431\t    built = run('build', '--ledger', stores[0], '--items', stores[1], '--out', out)\n   432\t    assert built.returncode == 0, built.stderr\n   433\t    report = out.with_name('release.report.json')\n   434\t    assert json.loads(report.read_text())['as_of'] == DAYS[2]\n   435\t    occupied = run('check', out, '--ledger', stores[0], '--items', stores[1])\n   436\t    assert occupied.returncode == 2 and 'passes' in occupied.stdout\n   437\t    report.unlink()\n   438\t    fresh = run('check', out, '--ledger', stores[0], '--items', stores[1])\n   439\t    assert fresh.returncode == 0 and report.exists() and json.loads(report.read_text())['export_seconds'] is None\n   440\t\n   441\t\n   442\tdef test_17_database_error_leaves_nothing_and_a_retry_succeeds(stores, tmp_path):\n   443\t    \"\"\"§2 database-error row, §6 test 17.\"\"\"\n   444\t    broken = tmp_path / 'broken.sqlite'\n   445\t    sqlite3.connect(broken).execute('create table other (x)').connection.commit()\n   446\t    out = tmp_path / 'release'\n   447\t    failed = run('build', '--ledger', stores[0], '--items', broken, '--out', out)\n   448\t    assert failed.returncode == 1 and 'OperationalError' in failed.stderr\n   449\t    assert not out.exists() and not list(tmp_path.glob('.release.staging-*'))\n   450\t    assert run('build', '--ledger', stores[0], '--items', stores[1], '--out', out).returncode == 0\n   451\t\n   452\t\n   453\tdef test_18_no_report_ever_replaces_an_input(stores, tmp_path):\n   454\t    \"\"\"§1 publish_report, §6 test 18: the report name is the items file itself, a symbolic link to it, and (on a case-insensitive\n   455\t    volume) a case-variant name of it.\"\"\"\n   456\t    items_hash = hashlib.sha256(stores[1].read_bytes()).hexdigest()\n   457\t    same = tmp_path / 'same.report.json'\n   458\t    shutil.copyfile(stores[1], same)\n   459\t    refused = run('build', '--ledger', stores[0], '--items', same, '--out', tmp_path / 'same')\n   460\t    assert refused.returncode == 1 and hashlib.sha256(same.read_bytes()).hexdigest() == items_hash\n   461\t    out = tmp_path / 'pkg'\n   462\t    assert run('build', '--ledger', stores[0], '--items', stores[1], '--out', out).returncode == 0\n   463\t    report = tmp_path / 'pkg.report.json'\n   464\t    report.unlink()\n   465\t    report.symlink_to(stores[1])\n   466\t    linked = run('check', out, '--ledger', stores[0], '--items', stores[1])\n   467\t    assert linked.returncode == 2 and hashlib.sha256(stores[1].read_bytes()).hexdigest() == items_hash\n   468\t    report.unlink()\n   469\t    variant = tmp_path / 'PKG.REPORT.JSON'\n   470\t    shutil.copyfile(stores[1], variant)\n   471\t    if report.exists():                                  # a case-insensitive volume: the variant is the report name\n   472\t        checked = run('check', out, '--ledger', stores[0], '--items', variant)\n   473\t        assert checked.returncode == 2 and hashlib.sha256(variant.read_bytes()).hexdigest() == items_hash\n   474\t\n   475\t\n   476\t# ---------- §6 tests 12, 14, 19, 20, 21: scratch copies of the command (the AGENTS §4 mutation procedure)\n   477\t\n   478\t\n   479\tdef scratch(tmp_path, edits):\n   480\t    \"\"\"A copy of the package and the command with text edits applied; each edit must match once.\"\"\"\n   481\t    root = tmp_path / 'scratch'\n   482\t    shutil.copytree(ROOT / 'src' / 'hivemind', root / 'src' / 'hivemind', ignore=shutil.ignore_patterns('__pycache__'))\n   483\t    (root / 'scripts').mkdir()\n   484\t    shutil.copy(COMMAND, root / 'scripts' / 'release_build.py')\n   485\t    for relative, old, new in edits:\n   486\t        path = root / relative\n   487\t        text = path.read_text()\n   488\t        assert text.count(old) == 1, ('scratch anchor', relative, old)\n   489\t        path.write_text(text.replace(old, new))\n   490\t    return root / 'scripts' / 'release_build.py'\n   491\t\n   492\t\n   493\tdef pause_code(signals, name, indent='        '):\n   494\t    \"\"\"Code that signals it has paused and waits for the test's resume file, ending at `indent` for the line it precedes.\"\"\"\n   495\t    return (f\"__import__('pathlib').Path({str(signals / ('paused-' + name))!r}).touch()\\n\"\n   496\t            f\"{indent}while not __import__('pathlib').Path({str(signals / ('resume-' + name))!r}).exists(): __import__('time').sleep(0.02)\\n{indent}\")\n   497\t\n   498\t\n   499\tdef run_paused(command, args, signals, name, action):\n   500\t    process = subprocess.Popen([sys.executable, str(command), *map(str, args)], stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True,\n   501\t                               env={**os.environ, 'PYTHONDONTWRITEBYTECODE': '1'})\n   502\t    deadline = time.time() + 60\n   503\t    while not (signals / f'paused-{name}').exists():\n   504\t        assert process.poll() is None and time.time() < deadline, process.communicate()\n   505\t        time.sleep(0.02)\n   506\t    action()\n   507\t    (signals / f'resume-{name}').touch()\n   508\t    out, err = process.communicate(timeout=120)\n   509\t    return process.returncode, out, err\n   510\t\n   511\t\n   512\tFAULT = (\"evidence.append({'id': piece['evidence_id'], **{name: piece[name] for name in EVIDENCE_TEXT}, 'sources': sources})\",\n   513\t         \"evidence.append({'id': piece['evidence_id'], **{name: piece[name] for name in EVIDENCE_TEXT}, 'sources': sources, \"\n   514\t         \"'one_line': views_db.execute('select why_changed from judgements where view_id=? order by judgement_id desc limit 1', (view_id,)).fetchone()['why_changed'] if view_id == 'v1' else piece['one_line']})\")\n   515\tSTAGED_CHECK = (\"counts, data, size = release.check_package(staged, views_db, items_db, expected_as_of=bound)\", \"counts, size = release.check_export(data), 0\")\n   516\t\n   517\t\n   518\tdef test_12_the_staged_check_is_what_stops_a_writer_fault(stores, tmp_path):\n   519\t    \"\"\"§6 test 12: with a writer fault the command refuses and leaves nothing; with the fault and no staged check the bad package is\n   520\t    published, so the staged check is what prevents it.\"\"\"\n   521\t    faulty = scratch(tmp_path / 'a', [('src/hivemind/release.py', *FAULT)])\n   522\t    out = tmp_path / 'release'\n   523\t    refused = subprocess.run([sys.executable, str(faulty), 'build', '--ledger', stores[0], '--items', stores[1], '--out', out], capture_output=True, text=True)\n   524\t    assert refused.returncode == 1 and 'evidence e1.one_line' in refused.stderr\n   525\t    assert not out.exists() and not list(tmp_path.glob('.release.staging-*'))\n   526\t    unguarded = scratch(tmp_path / 'b', [('src/hivemind/release.py', *FAULT), ('scripts/release_build.py', *STAGED_CHECK)])\n   527\t    published = subprocess.run([sys.executable, str(unguarded), 'build', '--ledger', stores[0], '--items', stores[1], '--out', out], capture_output=True, text=True)\n   528\t    assert published.returncode == 0, published.stderr\n   529\t    assert V1_WHY in (out / release.DATA_FILE).read_text()\n   530\t\n   531\t\n   532\tdef test_14_publication_never_replaces_or_removes_another_folder(stores, tmp_path):\n   533\t    \"\"\"§1 publish, §2 rows on an occupied --out and two builds, §6 test 14.\"\"\"\n   534\t    data = export(stores)\n   535\t    out = tmp_path / 'release'\n   536\t    first, second = release.stage(out), release.stage(out)\n   537\t    release.write_package(data, first)\n   538\t    release.write_package(data, second)\n   539\t    release.publish(first, out)\n   540\t    with pytest.raises(FileExistsError):\n   541\t        release.publish(second, out)\n   542\t    assert second.exists() and check(stores, out)['fields_compared'] > 0\n   543\t    other = tmp_path / 'other'\n   544\t    staged = release.stage(other)\n   545\t    release.write_package(data, staged)\n   546\t    other.mkdir()\n   547\t    with pytest.raises(FileExistsError):\n   548\t        release.publish(staged, other)\n   549\t    assert other.is_dir() and not any(other.iterdir())\n   550\t    early = tmp_path / 'early'\n   551\t    early.mkdir()\n   552\t    assert run('build', '--ledger', stores[0], '--items', stores[1], '--out', early).returncode == 1 and early.is_dir()\n   553\t\n   554\t    signals = tmp_path / 'signals'\n   555\t    signals.mkdir()\n   556\t    paused = scratch(tmp_path / 'late', [('scripts/release_build.py', 'release.publish(staged, out)', pause_code(signals, 'publish') + 'release.publish(staged, out)')])\n   557\t    late = tmp_path / 'late-out'\n   558\t    holder = {}\n   559\t\n   560\t    def occupy():\n   561\t        late.mkdir()\n   562\t        holder['identity'] = (late.stat().st_dev, late.stat().st_ino)\n   563\t    code, _, err = run_paused(paused, ['build', '--ledger', stores[0], '--items', stores[1], '--out', late], signals, 'publish', occupy)\n   564\t    assert code == 1 and 'File exists' in err\n   565\t    assert (late.stat().st_dev, late.stat().st_ino) == holder['identity'] and not any(late.iterdir())\n   566\t    assert not list(tmp_path.glob('.late-out.staging-*'))\n   567\t\n   568\t    after = scratch(tmp_path / 'after', [('scripts/release_build.py', '        release.publish(staged, out)\\n',\n   569\t                                          f\"        release.publish(staged, out)\\n        {pause_code(signals, 'freed')}staged.mkdir(); (staged / 'marker').write_text('mine')\\n\")])\n   570\t    done = tmp_path / 'after-out'\n   571\t    code, _, err = run_paused(after, ['build', '--ledger', stores[0], '--items', stores[1], '--out', done], signals, 'freed', lambda: None)\n   572\t    assert code == 0, err\n   573\t    markers = list(tmp_path.glob('.after-out.staging-*/marker'))\n   574\t    assert len(markers) == 1 and markers[0].read_text() == 'mine'\n   575\t\n   576\t\n   577\tdef test_19_a_report_name_taken_during_the_build_survives(stores, tmp_path):\n   578\t    \"\"\"§2 report rows, §6 test 19.\"\"\"\n   579\t    signals = tmp_path / 'signals'\n   580\t    signals.mkdir()\n   581\t    paused = scratch(tmp_path, [('scripts/release_build.py', '    return write_report(summary, report)\\n\\n\\ndef check',\n   582\t                                 f\"    {pause_code(signals, 'report', indent='    ')}return write_report(summary, report)\\n\\n\\ndef check\")])\n   583\t    out = tmp_path / 'release'\n   584\t    marker = tmp_path / 'release.report.json'\n   585\t    code, _, err = run_paused(paused, ['build', '--ledger', stores[0], '--items', stores[1], '--out', out], signals, 'report', lambda: marker.write_text('occupied'))\n   586\t    assert code == 2 and 'report not written' in err and marker.read_text() == 'occupied'\n   587\t    checked = run('check', out, '--ledger', stores[0], '--items', stores[1])\n   588\t    assert checked.returncode == 2 and 'passes' in checked.stdout and marker.read_text() == 'occupied'\n   589\t\n   590\t\n   591\tdef test_20_a_temporary_file_left_after_the_link_still_counts_as_published(stores, tmp_path):\n   592\t    \"\"\"§1 publish_report, §6 test 20.\"\"\"\n   593\t    command = scratch(tmp_path, [('src/hivemind/release.py', '    try:\\n        os.unlink(temporary)\\n    except OSError:',\n   594\t                                  \"    try:\\n        raise PermissionError('test: cannot remove')\\n    except OSError:\")])\n   595\t    out = tmp_path / 'release'\n   596\t    result = subprocess.run([sys.executable, str(command), 'build', '--ledger', stores[0], '--items', stores[1], '--out', out], capture_output=True, text=True)\n   597\t    assert result.returncode == 0 and 'report published' in result.stderr\n   598\t    assert json.loads(out.with_name('release.report.json').read_text())['as_of'] == DAYS[2]\n   599\t    assert list(tmp_path.glob('.release.report.json.*'))\n   600\t\n   601\t\n   602\tdef test_21_check_that_cannot_write_its_report_exits_2(stores, tmp_path):\n   603\t    \"\"\"§1 check's statuses, §6 test 21.\"\"\"\n   604\t    out = tmp_path / 'release'\n   605\t    build_package(stores, out)\n   606\t    command = scratch(tmp_path, [('src/hivemind/release.py', \"    descriptor, temporary = tempfile.mkstemp(dir=path.parent, prefix=f'.{path.name}.')\",\n   607\t                                  \"    raise PermissionError('test: cannot create')\")])\n   608\t    result = subprocess.run([sys.executable, str(command), 'check', out, '--ledger', stores[0], '--items', stores[1]], capture_output=True, text=True)\n   609\t    assert result.returncode == 2 and 'passes' in result.stdout and 'cannot create' in result.stderr\n   610\t\n   611\t\n   612\t# ---------- council 75: key visibility, text fields, store paths, the writer's own refusal\n   613\t\n   614\t\n   615\tdef test_22_a_key_written_after_the_day_does_not_reclassify_it(stores, tmp_path):\n   616\t    \"\"\"§1 question_class (council 75): a question with no key on 08-24 that gains an event key on 08-25 stays a number question in\n   617\t    the 08-24 package.\"\"\"\n   618\t    conn = store.open_db(str(stores[0]))\n   619\t    store.create_view(conn, view_id='v8', looks_at='NVIDIA buyback', question='How large a buyback will NVIDIA announce by 2027?',\n   620\t                      rungs=[{'label': 'Above the estimate', 'condition': 'At least $60 billion'}, {'label': 'Below the estimate', 'condition': 'Less than $60 billion'}],\n   621\t                      object_id='NVDA', object_kind='company', kind='asset', due_day='2027-01-31', year='2027', seq=1, input_id='item-1', created_at='2026-08-24T12:00:00Z')\n   622\t    judge(conn, 'v8', 1, 1, 'The estimate is about $70 billion.')\n   623\t    store.insert(conn, 'view_keys', view_id='v8', measure='event', scope='NVIDIA', scope_key='nvidia', period_start='2026-02-01', period_end='2027-01-31',\n   624\t                 basis='n/a', unit='n/a', event_type='other', seq=2, scope_source='model', key_version=1)\n   625\t    conn.commit()\n   626\t    conn.close()\n   627\t    early, late = by_id(export(stores, DAYS[0]))['v8'], by_id(export(stores, DAYS[1]))['v8']\n   628\t    assert (early['class'], early.get('forecast')) == ('number', release.FORECAST_UNAVAILABLE)\n   629\t    assert (late['class'], late['answer']) == ('event', 'Above the estimate')\n   630\t    out = tmp_path / 'early'\n   631\t    build_package(stores, out, DAYS[0])\n   632\t    assert by_id(release.read_data(out))['v8']['class'] == 'number'\n   633\t\n   634\t\n   635\tEVIDENCE_COLUMNS = {'one_line': 'one_line', 'quote': 'quote', 'tier': 'tier', 'speaker': 'speaker', 'original_who': 'original_who', 'original_day': 'original_day'}\n   636\tSOURCE_COLUMNS = {'title': ('items', 'title'), 'publisher': ('items', 'publisher'), 'uri': ('items', 'source_uri'), 'day': ('sources', 'publication_day')}\n   637\t\n   638\t\n   639\t@pytest.mark.parametrize('field', [*EVIDENCE_COLUMNS, *SOURCE_COLUMNS])\n   640\tdef test_23_every_evidence_and_source_text_field_must_be_text(tmp_path, field):\n   641\t    \"\"\"§1 check_export (council 75): a null in any of the ten text fields the closed set requires is refused, at the writer.\"\"\"\n   642\t    views, items = make_store(tmp_path / 'views.sqlite'), make_items(tmp_path / 'items.sqlite', ids=('item-1', 'item-2', 'item-3', 'item-9'))\n   643\t    conn = store.open_db(str(views))\n   644\t    values = dict(evidence_id='e7', quote='Officials said the rule would be published.', one_line='Officials expect the rule.', speaker='Publisher',\n   645\t                  original_who='Officials', original_day=DAYS[0], tier='party_statement', event_time=None, created_seq=1, created_from_input='item-9')\n   646\t    if field in EVIDENCE_COLUMNS:\n   647\t        values[EVIDENCE_COLUMNS[field]] = None\n   648\t    store.insert(conn, 'evidence', **values)\n   649\t    store.insert(conn, 'evidence_links', evidence_id='e7', view_id='v6', seq=1)\n   650\t    store.insert(conn, 'evidence_sources', evidence_id='e7', input_id='item-9', category='T1',\n   651\t                 publication_day=None if field == 'day' else DAYS[0], seq=1)\n   652\t    conn.commit()\n   653\t    conn.close()\n   654\t    if field in SOURCE_COLUMNS and SOURCE_COLUMNS[field][0] == 'items':\n   655\t        items_conn = sqlite3.connect(items)\n   656\t        items_conn.execute(f\"update items set {SOURCE_COLUMNS[field][1]} = null where input_id = 'item-9'\")\n   657\t        items_conn.commit()\n   658\t        items_conn.close()\n   659\t    with pytest.raises(release.ReleaseRefused, match=f'{field} is not text'):\n   660\t        export((views, items))\n   661\t\n   662\t\n   663\tdef test_24_a_store_path_with_uri_syntax_is_refused(stores, tmp_path):\n   664\t    \"\"\"§1 store_path (councils 75, 75b): a path holding a character the SQLite URI opener decodes is refused before anything is opened;\n   665\t    an accepted path is returned resolved, so the opener does not resolve a link a second time.\"\"\"\n   666\t    odd = tmp_path / 'a%2Db'\n   667\t    odd.mkdir()\n   668\t    shutil.copyfile(stores[0], odd / 'views.sqlite')\n   669\t    with pytest.raises(release.ReleaseRefused, match='URI syntax'):\n   670\t        release.store_path(odd / 'views.sqlite')\n   671\t    result = run('build', '--ledger', odd / 'views.sqlite', '--items', stores[1], '--out', tmp_path / 'release')\n   672\t    assert result.returncode == 1 and 'URI syntax' in result.stderr and not (tmp_path / 'release').exists()\n   673\t    assert release.store_path(stores[0]) == os.path.realpath(stores[0])\n   674\t    link = tmp_path / 'link.sqlite'\n   675\t    link.symlink_to(stores[0])\n   676\t    assert release.store_path(link) == os.path.realpath(stores[0])          # the opener is given the target, with nothing left to follow\n   677\t\n   678\t\n   679\tDRIVER = \"\"\"import sys\n   680\tsys.path.insert(0, sys.argv[1])\n   681\tfrom hivemind import release, service\n   682\tfrom hivemind.views import store\n   683\tviews, items = service.open_ledger(sys.argv[2]), store.open_read_only(sys.argv[3])\n   684\ttry:\n   685\t    data = release.release_export(views, items)\n   686\t    print('returned', sorted(data['questions'][0]))\n   687\texcept release.ReleaseRefused as error:\n   688\t    print('refused', error)\n   689\t\"\"\"\n   690\tWRITER_FAULT = (\"                record['forecast'] = FORECAST_UNAVAILABLE\\n            else:\\n                record['answers'] = labels\\n                record['answer'] = _answer(\",\n   691\t                \"                record['forecast'] = FORECAST_UNAVAILABLE\\n                record['condition'] = 'FY2027 revenue is at least $350 billion'\\n            else:\\n\"\n   692\t                \"                record['answers'] = labels\\n                record['answer'] = _answer(\")\n   693\tSELF_CHECK = (\"    check_export(data)\\n    return data\\n\", \"    return data\\n\")\n   694\t\n   695\t\n   696\tdef test_25_the_writer_refuses_its_own_off_list_field(stores, tmp_path):\n   697\t    \"\"\"§1 release_export (AGENTS §3, council 75), the mutation pair: a writer fault adding `condition` is refused inside\n   698\t    `release_export`; with the writer's own check removed, the off-list field is returned.\"\"\"\n   699\t    driver = tmp_path / 'driver.py'\n   700\t    driver.write_text(DRIVER)\n   701\t    for name, edits, expected in (('fault', [WRITER_FAULT], 'refused'), ('unchecked', [WRITER_FAULT, SELF_CHECK], 'returned')):\n   702\t        command = scratch(tmp_path / name, [('src/hivemind/release.py', *edit) for edit in edits])\n   703\t        result = subprocess.run([sys.executable, str(driver), str(command.parents[1] / 'src'), str(stores[0]), str(stores[1])], capture_output=True, text=True,\n   704\t                                env={**os.environ, 'PYTHONDONTWRITEBYTECODE': '1'})\n   705\t        assert result.stdout.startswith(expected), (name, result.stdout, result.stderr)\n   706\t        assert ('condition' in result.stdout) if name == 'unchecked' else ('off the allow-list' in result.stdout)\ntotal 2208\ndrwxr-xr-x@   7 lchingen  staff      224 Nov 23 11:04 .\ndrwxr-xr-x@ 254 lchingen  staff     8128 Nov 23 11:03 ..\ndrwxr-xr-x@   9 lchingen  staff      288 Nov 23 11:04 old-1\ndrwxr-xr-x@   4 lchingen  staff      128 Nov 23 11:03 old-2\ndrwxr-xr-x@   6 lchingen  staff      192 Nov 23 11:04 old-3\n-rw-r--r--@   1 lchingen  staff  1130302 Nov 23 11:04 results.json\ndrwxr-xr-x@   4 lchingen  staff      128 Nov 23 11:04 served\nsrc/hivemind/views/store.py:223:def open_read_only(path):\nsrc/hivemind/search.py:213:def visible_lexical_order(corpus, text, top_n):\nsrc/hivemind/service.py:19:def open_ledger(path):\nsrc/hivemind/service.py:111:def visible(conn, seq, as_of):\nsrc/hivemind/bundle.py:14:def read_snapshot(*connections):\n","exit_code":0,"status":"completed"}}
