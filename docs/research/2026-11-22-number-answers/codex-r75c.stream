{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc 'nl -ba scripts/release_build.py'","aggregated_output":"     1\t\"\"\"Build or check the \"Forecast unavailable\" release package (docs/research/2026-11-22-number-answers/RELEASE-BUILD.md).\n     2\t\n     3\t    release_build.py build --ledger <views.sqlite> --items <items.sqlite> [--as-of YYYY-MM-DD] --out <folder>\n     4\t    release_build.py check <folder> --ledger <views.sqlite> --items <items.sqlite>\n     5\t\n     6\tNo model or network call; both stores are read only. The package is checked in a private staging folder against the stores before\n     7\tone atomic move publishes it, and neither the package nor the report ever replaces an existing path. Exit statuses: 0 done; 1\n     8\trefused, with nothing published by this command; 2 the package is published (build) or passes (check) but the report name is taken\n     9\tor the report could not be written.\n    10\t\"\"\"\n    11\timport argparse\n    12\timport json\n    13\timport os\n    14\timport shutil\n    15\timport sys\n    16\timport time\n    17\tfrom pathlib import Path\n    18\t\n    19\tROOT = Path(__file__).resolve().parents[1]\n    20\tsys.path.insert(0, str(ROOT / 'src'))\n    21\tfrom hivemind import release, service  # noqa: E402\n    22\tfrom hivemind.views import store  # noqa: E402\n    23\t\n    24\t\n    25\tdef report_path(out):\n    26\t    return out.with_name(out.name + '.report.json')\n    27\t\n    28\t\n    29\tdef write_report(report, path):\n    30\t    \"\"\"Print the report, then publish it: 0 when it is published (naming any temporary file left behind), 2 when it is not.\"\"\"\n    31\t    print(json.dumps(report, ensure_ascii=False, indent=1))\n    32\t    try:\n    33\t        leftover = release.publish_report(report, path)\n    34\t    except OSError as error:\n    35\t        print(f'report not written ({error}); run check to write it', file=sys.stderr)\n    36\t        return 2\n    37\t    print(f'report: {path}')\n    38\t    if leftover:\n    39\t        print(f'report published; its temporary file {leftover} could not be removed', file=sys.stderr)\n    40\t    return 0\n    41\t\n    42\t\n    43\tdef build(args):\n    44\t    out = Path(args.out).absolute()\n    45\t    report = report_path(out)\n    46\t    for path in (out, report):\n    47\t        if os.path.lexists(path):\n    48\t            print(f'refused: {path} exists', file=sys.stderr)\n    49\t            return 1\n    50\t    started = time.monotonic()\n    51\t    staged = views_db = items_db = None\n    52\t    try:\n    53\t        views_db = service.open_ledger(str(release.store_path(args.ledger)))\n    54\t        items_db = store.open_read_only(str(release.store_path(args.items)))\n    55\t        bound = release.resolve(views_db, args.as_of)\n    56\t        staged = release.stage(out)\n    57\t        data = release.release_export(views_db, items_db, bound)\n    58\t        export_seconds = time.monotonic() - started\n    59\t        release.write_package(data, staged)\n    60\t        checked = time.monotonic()\n    61\t        counts, data, size = release.check_package(staged, views_db, items_db, expected_as_of=bound)\n    62\t        unresolved = release.withheld_unresolved(views_db, data)\n    63\t        check_seconds = time.monotonic() - checked\n    64\t        release.publish(staged, out)\n    65\t        staged = None                       # published: this build no longer owns the staging name\n    66\t    except Exception as error:              # any failure before publication: nothing at --out from this build\n    67\t        print(f'refused: {type(error).__name__}: {error}', file=sys.stderr)\n    68\t        return 1\n    69\t    finally:\n    70\t        if staged is not None:\n    71\t            shutil.rmtree(staged)\n    72\t        for conn in (views_db, items_db):\n    73\t            if conn is not None:\n    74\t                conn.close()\n    75\t    print(f'published {out}: {counts}')\n    76\t    summary = {'ledger': str(args.ledger), 'items': str(args.items), 'as_of': bound, 'counts': counts,\n    77\t               'withheld_unresolved': unresolved, 'data_bytes': size,\n    78\t               'export_seconds': round(export_seconds, 2), 'check_seconds': round(check_seconds, 2)}\n    79\t    return write_report(summary, report)\n    80\t\n    81\t\n    82\tdef check(args):\n    83\t    out = Path(args.package).absolute()\n    84\t    views_db = items_db = None\n    85\t    try:\n    86\t        views_db = service.open_ledger(str(release.store_path(args.ledger)))\n    87\t        items_db = store.open_read_only(str(release.store_path(args.items)))\n    88\t        started = time.monotonic()\n    89\t        counts, data, size = release.check_package(out, views_db, items_db)\n    90\t        check_seconds = time.monotonic() - started\n    91\t        unresolved = release.withheld_unresolved(views_db, data)\n    92\t    except Exception as error:\n    93\t        print(f'refused: {type(error).__name__}: {error}', file=sys.stderr)\n    94\t        return 1\n    95\t    finally:\n    96\t        for conn in (views_db, items_db):\n    97\t            if conn is not None:\n    98\t                conn.close()\n    99\t    print(f'passes {out}: {counts}')\n   100\t    summary = {'ledger': str(args.ledger), 'items': str(args.items), 'as_of': data['as_of'], 'counts': counts,\n   101\t               'withheld_unresolved': unresolved, 'data_bytes': size,\n   102\t               'export_seconds': None, 'check_seconds': round(check_seconds, 2)}\n   103\t    return write_report(summary, report_path(out))\n   104\t\n   105\t\n   106\tdef main(argv=None):\n   107\t    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)\n   108\t    commands = parser.add_subparsers(dest='command', required=True)\n   109\t    make = commands.add_parser('build')\n   110\t    make.add_argument('--ledger', required=True, type=Path)\n   111\t    make.add_argument('--items', required=True, type=Path)\n   112\t    make.add_argument('--as-of')\n   113\t    make.add_argument('--out', required=True, type=Path)\n   114\t    verify = commands.add_parser('check')\n   115\t    verify.add_argument('package', type=Path)\n   116\t    verify.add_argument('--ledger', required=True, type=Path)\n   117\t    verify.add_argument('--items', required=True, type=Path)\n   118\t    args = parser.parse_args(argv)\n   119\t    return build(args) if args.command == 'build' else check(args)\n   120\t\n   121\t\n   122\tif __name__ == '__main__':\n   123\t    sys.exit(main())\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc 'nl -ba src/hivemind/release.py'","aggregated_output":"     1\t\"\"\"The \"Forecast unavailable\" release: one allow-listed export of a views ledger, its package and its checks\n     2\t(docs/research/2026-11-22-number-answers/RELEASE-BUILD.md; D726, D756, D758).\n     3\t\n     4\tA number question carries its question, its evidence in force and the marker \"Forecast unavailable\". An event or Yes/No question\n     5\tcarries its question, its evidence and its answer labels. Nothing else is read into the package: no rung condition or bound, no\n     6\tjudgement reason or explanation, no switch reason, no history. Before a package is published, every field is compared with its\n     7\tstored source at the package's day, and nothing published replaces an existing path.\n     8\t\"\"\"\n     9\timport ctypes\n    10\timport ctypes.util\n    11\timport errno\n    12\timport hashlib\n    13\timport json\n    14\timport os\n    15\timport stat\n    16\timport sys\n    17\timport tempfile\n    18\tfrom datetime import date\n    19\tfrom pathlib import Path\n    20\t\n    21\tfrom . import bundle, service, vocabulary\n    22\tfrom .views import identity, store\n    23\t\n    24\tFORMAT = 'hivemind-release/1'\n    25\tALLOW_LIST = 'release-allow-list/1'\n    26\tFORECAST_UNAVAILABLE = 'Forecast unavailable'\n    27\tDATA_FILE = 'release-data.json'\n    28\tMANIFEST_FILE = 'manifest.json'\n    29\tPACKAGE_FILES = frozenset({DATA_FILE, MANIFEST_FILE})\n    30\tCLASSES = ('number', 'event', 'yes_no')\n    31\tALLOWED = {\n    32\t    'envelope': frozenset({'format', 'allow_list', 'as_of', 'questions'}),\n    33\t    'number': frozenset({'id', 'question', 'open', 'class', 'forecast', 'evidence'}),\n    34\t    'answered': frozenset({'id', 'question', 'open', 'class', 'answers', 'answer', 'evidence'}),\n    35\t    'evidence': frozenset({'id', 'one_line', 'quote', 'tier', 'speaker', 'original_who', 'original_day', 'sources'}),\n    36\t    'source': frozenset({'title', 'publisher', 'day', 'uri'}),\n    37\t    'manifest': frozenset({'format', 'allow_list', 'as_of', 'data_sha256'}),\n    38\t}\n    39\tEVIDENCE_TEXT = ('one_line', 'quote', 'tier', 'speaker', 'original_who', 'original_day')\n    40\tSOURCE_TEXT = ('title', 'publisher', 'day', 'uri')\n    41\tRENAME_EXCL = 0x4          # macOS <stdio.h>: renamex_np refuses an existing destination\n    42\tRENAME_NOREPLACE = 0x1     # Linux <linux/fs.h>: renameat2 refuses an existing destination\n    43\tAT_FDCWD = -100\n    44\t\n    45\t\n    46\tclass ReleaseRefused(ValueError):\n    47\t    \"\"\"The release refuses the input, the export or the package; the message names what and where.\"\"\"\n    48\t\n    49\t\n    50\t# ---------- the day\n    51\t\n    52\tdef canonical_day(text):\n    53\t    \"\"\"A day written YYYY-MM-DD, returned unchanged; anything else is refused. The stores compare days as text, so a day Python\n    54\t    also reads (20260825) would select rows from later days.\"\"\"\n    55\t    try:\n    56\t        day = date.fromisoformat(text)\n    57\t    except (TypeError, ValueError):\n    58\t        raise ReleaseRefused(f'not a day: {text!r}') from None\n    59\t    if day.isoformat() != text:\n    60\t        raise ReleaseRefused(f'a day must be written YYYY-MM-DD: {text!r}')\n    61\t    return text\n    62\t\n    63\t\n    64\tdef resolve(views_db, as_of=None):\n    65\t    \"\"\"The bound of a build or a check, one rule for both: a given day must be canonical; `service.resolve_bound` then refuses an\n    66\t    unfinished first day or a day after the last completed day; an omitted day with no default is refused.\"\"\"\n    67\t    if as_of is not None:\n    68\t        canonical_day(as_of)\n    69\t    bound = service.resolve_bound(views_db, as_of)\n    70\t    if not bound:\n    71\t        raise ReleaseRefused('the store has no default day; supply --as-of')\n    72\t    return canonical_day(bound)\n    73\t\n    74\t\n    75\t# ---------- identity\n    76\t\n    77\tdef _has_table(conn, name):\n    78\t    return conn.execute(\"select 1 from sqlite_master where type='table' and name=?\", (name,)).fetchone() is not None\n    79\t\n    80\t\n    81\tdef key_measure(conn, view_id, as_of):\n    82\t    \"\"\"The measure of the view's key as recorded on or before the day, or None: no key table, no key, or a key written after the\n    83\t    day (a later key never reclassifies an earlier package).\"\"\"\n    84\t    if not _has_table(conn, 'view_keys'):\n    85\t        return None\n    86\t    row = conn.execute('select measure, seq from view_keys where view_id=?', (view_id,)).fetchone()\n    87\t    return row['measure'] if row is not None and service.visible(conn, row['seq'], as_of) else None\n    88\t\n    89\t\n    90\tdef ladder(conn, view_id):\n    91\t    \"\"\"(position, label) of every rung, by position: the only rung columns the package reads.\"\"\"\n    92\t    return [(row['position'], row['label']) for row in conn.execute('select position, label from rungs where view_id=? order by position', (view_id,))]\n    93\t\n    94\t\n    95\tdef question_class(conn, view_id, labels, as_of):\n    96\t    \"\"\"'event' for an event measure in the key recorded by the day, 'yes_no' for exactly two labels that are Yes and No in the stored\n    97\t    vocabulary, else 'number' (a view with no key and a ladder whose bands do not resolve included): the forecast of every number\n    98\t    question is withheld.\"\"\"\n    99\t    if key_measure(conn, view_id, as_of) in identity.EVENT_MEASURES:\n   100\t        return 'event'\n   101\t    if len(labels) == 2 and {vocabulary.canonical('label', label) for label in labels} == {'Yes', 'No'}:\n   102\t        return 'yes_no'\n   103\t    return 'number'\n   104\t\n   105\t\n   106\tdef _answer(conn, view_id, as_of, positions):\n   107\t    \"\"\"The stored label of the latest judgement's rung on or before the day, or None when the question is not yet judged.\"\"\"\n   108\t    row = conn.execute('select rung from judgements where view_id=? and publication_day<=? order by judgement_id desc limit 1', (view_id, as_of)).fetchone()\n   109\t    if row is None:\n   110\t        return None\n   111\t    if row['rung'] not in positions:\n   112\t        raise ReleaseRefused(f'{view_id}: its latest judgement names rung {row[\"rung\"]}, which its ladder does not hold')\n   113\t    return positions[row['rung']]\n   114\t\n   115\t\n   116\t# ---------- the export\n   117\t\n   118\tdef _item(items_db, cache, input_id, evidence_id):\n   119\t    if input_id not in cache:\n   120\t        row = items_db.execute('select title, publisher, source_uri from items where input_id=?', (input_id,)).fetchone()\n   121\t        if row is None:\n   122\t            raise ReleaseRefused(f'evidence {evidence_id}: source item {input_id} is not in the items database')\n   123\t        cache[input_id] = row\n   124\t    return cache[input_id]\n   125\t\n   126\t\n   127\tdef _visible_views(conn, as_of):\n   128\t    return [row for row in conn.execute('select view_id, question, created_seq from views order by created_seq, rowid') if service.visible(conn, row['created_seq'], as_of)]\n   129\t\n   130\t\n   131\tdef release_export(views_db, items_db, as_of=None):\n   132\t    \"\"\"The release data as of the bound: every question visible on that day, closed ones included, built field by field from the\n   133\t    allow-list. The result passes `check_export` or nothing is returned.\"\"\"\n   134\t    with bundle.read_snapshot(views_db, items_db):\n   135\t        bound = resolve(views_db, as_of)\n   136\t        items, questions = {}, []\n   137\t        for view in _visible_views(views_db, bound):\n   138\t            view_id = view['view_id']\n   139\t            rungs = ladder(views_db, view_id)\n   140\t            labels = [label for _, label in rungs]\n   141\t            kind = question_class(views_db, view_id, labels, bound)\n   142\t            record = {'id': view_id, 'question': view['question'], 'open': service.is_open_as_of(views_db, view_id, bound), 'class': kind}\n   143\t            if kind == 'number':\n   144\t                record['forecast'] = FORECAST_UNAVAILABLE\n   145\t            else:\n   146\t                record['answers'] = labels\n   147\t                record['answer'] = _answer(views_db, view_id, bound, dict(rungs))\n   148\t            evidence = []\n   149\t            for piece in service.evidence(views_db, view_id, bound):\n   150\t                sources = []\n   151\t                for source in piece['sources']:\n   152\t                    item = _item(items_db, items, source['input_id'], piece['evidence_id'])\n   153\t                    sources.append({'title': item['title'], 'publisher': item['publisher'], 'day': source['publication_day'], 'uri': item['source_uri']})\n   154\t                evidence.append({'id': piece['evidence_id'], **{name: piece[name] for name in EVIDENCE_TEXT}, 'sources': sources})\n   155\t            record['evidence'] = evidence\n   156\t            questions.append(record)\n   157\t        data = {'format': FORMAT, 'allow_list': ALLOW_LIST, 'as_of': bound, 'questions': questions}\n   158\t    check_export(data)\n   159\t    return data\n   160\t\n   161\t\n   162\t# ---------- the closed set\n   163\t\n   164\tdef _keys(value, kind, where):\n   165\t    if not isinstance(value, dict):\n   166\t        raise ReleaseRefused(f'{where}: not an object')\n   167\t    if set(value) != ALLOWED[kind]:\n   168\t        extra, missing = sorted(set(value) - ALLOWED[kind]), sorted(ALLOWED[kind] - set(value))\n   169\t        raise ReleaseRefused(f'{where}: keys off the allow-list {extra}, missing {missing}')\n   170\t\n   171\t\n   172\tdef _texts(value, names, where):\n   173\t    for name in names:\n   174\t        if not isinstance(value[name], str):\n   175\t            raise ReleaseRefused(f'{where}: {name} is not text')\n   176\t\n   177\t\n   178\tdef check_export(data):\n   179\t    \"\"\"Every object at every level holds exactly its record type's keys, with values of the allowed kinds. Returns the counts\n   180\t    judged.\"\"\"\n   181\t    _keys(data, 'envelope', 'the package')\n   182\t    if data['format'] != FORMAT or data['allow_list'] != ALLOW_LIST:\n   183\t        raise ReleaseRefused(f'the package names format {data[\"format\"]!r} and allow-list {data[\"allow_list\"]!r}')\n   184\t    canonical_day(data['as_of'])\n   185\t    if not isinstance(data['questions'], list):\n   186\t        raise ReleaseRefused('the package: questions is not a list')\n   187\t    counts = {'questions': {kind: 0 for kind in CLASSES}, 'evidence': 0, 'sources': 0}\n   188\t    for position, question in enumerate(data['questions']):\n   189\t        where = f'question {position}'\n   190\t        if not isinstance(question, dict) or question.get('class') not in CLASSES:\n   191\t            raise ReleaseRefused(f'{where}: no allowed class')\n   192\t        kind = question['class']\n   193\t        _keys(question, 'number' if kind == 'number' else 'answered', where)\n   194\t        _texts(question, ('id', 'question'), where)\n   195\t        where = f'question {question[\"id\"]}'\n   196\t        if not isinstance(question['open'], bool):\n   197\t            raise ReleaseRefused(f'{where}: open is not true or false')\n   198\t        if kind == 'number':\n   199\t            if question['forecast'] != FORECAST_UNAVAILABLE:\n   200\t                raise ReleaseRefused(f'{where}: a number question carries only the marker')\n   201\t        else:\n   202\t            answers = question['answers']\n   203\t            if not (isinstance(answers, list) and len(answers) == 2 and all(isinstance(a, str) for a in answers)):\n   204\t                raise ReleaseRefused(f'{where}: answers are not two labels')\n   205\t            if question['answer'] is not None and question['answer'] not in answers:\n   206\t                raise ReleaseRefused(f'{where}: the answer is not one of its labels')\n   207\t        if not isinstance(question['evidence'], list):\n   208\t            raise ReleaseRefused(f'{where}: evidence is not a list')\n   209\t        for piece in question['evidence']:\n   210\t            _keys(piece, 'evidence', f'{where} evidence')\n   211\t            _texts(piece, ('id',), f'{where} evidence')\n   212\t            _texts(piece, EVIDENCE_TEXT, f'{where} evidence {piece[\"id\"]}')\n   213\t            if not isinstance(piece['sources'], list):\n   214\t                raise ReleaseRefused(f'{where} evidence {piece[\"id\"]}: sources is not a list')\n   215\t            for source in piece['sources']:\n   216\t                _keys(source, 'source', f'{where} evidence {piece[\"id\"]} source')\n   217\t                _texts(source, SOURCE_TEXT, f'{where} evidence {piece[\"id\"]} source')\n   218\t            counts['sources'] += len(piece['sources'])\n   219\t        counts['evidence'] += len(question['evidence'])\n   220\t        counts['questions'][kind] += 1\n   221\t    return counts\n   222\t\n   223\t\n   224\t# ---------- the origin check\n   225\t\n   226\tdef _open_at(conn, view_id, as_of):\n   227\t    for row in conn.execute('select open, after_seq from view_switches where view_id=? order by id desc', (view_id,)):\n   228\t        if service.visible(conn, row['after_seq'], as_of):\n   229\t            return bool(row['open'])\n   230\t    return True\n   231\t\n   232\t\n   233\tdef _expected_evidence(views_db, items_db, view_id, as_of):\n   234\t    \"\"\"The evidence in force at the day, by its own SQL: visible links in link order, minus those whose latest replacement is\n   235\t    visible; each source row visible at the day, in row order, with its item required.\"\"\"\n   236\t    out = []\n   237\t    for link in views_db.execute('select evidence_id, seq from evidence_links where view_id=? order by id', (view_id,)).fetchall():\n   238\t        if not service.visible(views_db, link['seq'], as_of):\n   239\t            continue\n   240\t        latest = views_db.execute('select seq from replacements where old_evidence_id=? order by id desc limit 1', (link['evidence_id'],)).fetchone()\n   241\t        if latest is not None and service.visible(views_db, latest['seq'], as_of):\n   242\t            continue\n   243\t        row = views_db.execute(f'select evidence_id, {\", \".join(EVIDENCE_TEXT)} from evidence where evidence_id=?', (link['evidence_id'],)).fetchone()\n   244\t        if row is None:\n   245\t            raise ReleaseRefused(f'{view_id}: link to evidence {link[\"evidence_id\"]}, which the store does not hold')\n   246\t        sources = []\n   247\t        for source in views_db.execute('select input_id, publication_day, seq from evidence_sources where evidence_id=? order by id', (link['evidence_id'],)).fetchall():\n   248\t            if not service.visible(views_db, source['seq'], as_of):\n   249\t                continue\n   250\t            item = items_db.execute('select title, publisher, source_uri from items where input_id=?', (source['input_id'],)).fetchone()\n   251\t            if item is None:\n   252\t                raise ReleaseRefused(f'evidence {row[\"evidence_id\"]}: source item {source[\"input_id\"]} is not in the items database')\n   253\t            sources.append({'title': item['title'], 'publisher': item['publisher'], 'day': source['publication_day'], 'uri': item['source_uri']})\n   254\t        out.append({'id': row['evidence_id'], **{name: row[name] for name in EVIDENCE_TEXT}, 'sources': sources})\n   255\t    return out\n   256\t\n   257\t\n   258\tdef _leaves(value):\n   259\t    if isinstance(value, dict):\n   260\t        return sum(_leaves(v) for v in value.values())\n   261\t    if isinstance(value, list):\n   262\t        return sum(_leaves(v) for v in value)\n   263\t    return 1\n   264\t\n   265\t\n   266\tdef _compare(expected, actual, where):\n   267\t    \"\"\"The number of leaf values compared; the first difference is refused, naming where it is.\"\"\"\n   268\t    if isinstance(expected, dict):\n   269\t        if not isinstance(actual, dict) or set(expected) != set(actual):\n   270\t            raise ReleaseRefused(f'{where}: fields differ from the store')\n   271\t        return sum(_compare(expected[key], actual[key], f'{where}.{key}') for key in expected)\n   272\t    if isinstance(expected, list):\n   273\t        if not isinstance(actual, list) or len(expected) != len(actual):\n   274\t            raise ReleaseRefused(f'{where}: {len(actual) if isinstance(actual, list) else \"no\"} entries where the store has {len(expected)}')\n   275\t        return sum(_compare(e, a, f'{where}[{n}]') for n, (e, a) in enumerate(zip(expected, actual)))\n   276\t    if type(expected) is not type(actual) or expected != actual:\n   277\t        raise ReleaseRefused(f'{where}: differs from the store')\n   278\t    return 1\n   279\t\n   280\t\n   281\tdef check_origins(views_db, items_db, data, expected_as_of):\n   282\t    \"\"\"Every package field against its permitted stored source at `expected_as_of`, derived from the store and never from the\n   283\t    package: the day, each question's class, the questions, evidence and sources in order with their counts. Its reads are its own\n   284\t    SQL, apart from the identity rule (`question_class`) and the day of a sequence number (`service.visible`). Returns the number of\n   285\t    fields compared.\"\"\"\n   286\t    with bundle.read_snapshot(views_db, items_db):\n   287\t        as_of = canonical_day(expected_as_of)\n   288\t        if data['as_of'] != as_of:\n   289\t            raise ReleaseRefused(f'the package is dated {data[\"as_of\"]}, the store bound is {as_of}')\n   290\t        views = [row for row in views_db.execute('select view_id, question, created_seq from views order by created_seq, rowid')\n   291\t                 if service.visible(views_db, row['created_seq'], as_of)]\n   292\t        packaged = data['questions']\n   293\t        if [q['id'] for q in packaged] != [row['view_id'] for row in views]:\n   294\t            raise ReleaseRefused(f'the questions differ from the store: {len(packaged)} entries where the store has {len(views)}'\n   295\t                                 if len(packaged) != len(views) else 'the questions or their order differ from the store')\n   296\t        compared = _compare(FORMAT, data['format'], 'package.format') + _compare(ALLOW_LIST, data['allow_list'], 'package.allow_list') + 1\n   297\t        for view, question in zip(views, packaged):\n   298\t            view_id = view['view_id']\n   299\t            positions = {row['position']: row['label'] for row in views_db.execute('select position, label from rungs where view_id=? order by position', (view_id,))}\n   300\t            labels = list(positions.values())\n   301\t            kind = question_class(views_db, view_id, labels, as_of)\n   302\t            record = {'id': view_id, 'question': view['question'], 'open': _open_at(views_db, view_id, as_of), 'class': kind}\n   303\t            if kind == 'number':\n   304\t                record['forecast'] = FORECAST_UNAVAILABLE\n   305\t            else:\n   306\t                latest = views_db.execute('select rung from judgements where view_id=? and publication_day<=? order by judgement_id desc limit 1', (view_id, as_of)).fetchone()\n   307\t                if latest is not None and latest['rung'] not in positions:\n   308\t                    raise ReleaseRefused(f'question {view_id}: its latest judgement names rung {latest[\"rung\"]}, which its ladder does not hold')\n   309\t                record['answers'] = labels\n   310\t                record['answer'] = None if latest is None else positions[latest['rung']]\n   311\t            expected_evidence = _expected_evidence(views_db, items_db, view_id, as_of)\n   312\t            if not isinstance(question.get('evidence'), list) or len(question['evidence']) != len(expected_evidence):\n   313\t                found = len(question['evidence']) if isinstance(question.get('evidence'), list) else 'no'\n   314\t                raise ReleaseRefused(f'question {view_id}.evidence: {found} entries where the store has {len(expected_evidence)}')\n   315\t            record['evidence'] = question['evidence']           # compared piece by piece below, named by the stored evidence id\n   316\t            compared += _compare(record, question, f'question {view_id}') - _leaves(question['evidence'])\n   317\t            for expected, actual in zip(expected_evidence, question['evidence']):\n   318\t                compared += _compare(expected, actual, f'question {view_id}.evidence {expected[\"id\"]}')\n   319\t        return compared\n   320\t\n   321\t\n   322\t# ---------- the package\n   323\t\n   324\tdef _dump(value):\n   325\t    return json.dumps(value, ensure_ascii=False, separators=(',', ':')).encode('utf-8')\n   326\t\n   327\t\n   328\tdef stage(out_dir):\n   329\t    \"\"\"A private staging folder, unique to this invocation, beside the destination.\"\"\"\n   330\t    out_dir = Path(out_dir)\n   331\t    return Path(tempfile.mkdtemp(dir=out_dir.parent, prefix=f'.{out_dir.name}.staging-'))\n   332\t\n   333\t\n   334\tdef write_package(data, staged):\n   335\t    \"\"\"The data file and its manifest, written into the staging folder.\"\"\"\n   336\t    payload = _dump(data)\n   337\t    (Path(staged) / DATA_FILE).write_bytes(payload)\n   338\t    manifest = {'format': data['format'], 'allow_list': data['allow_list'], 'as_of': data['as_of'], 'data_sha256': hashlib.sha256(payload).hexdigest()}\n   339\t    (Path(staged) / MANIFEST_FILE).write_bytes(_dump(manifest))\n   340\t\n   341\t\n   342\tdef _no_replace_rename():\n   343\t    libc = ctypes.CDLL(ctypes.util.find_library('c'), use_errno=True)\n   344\t    if sys.platform == 'darwin' and hasattr(libc, 'renamex_np'):\n   345\t        call = libc.renamex_np\n   346\t        call.argtypes, call.restype = [ctypes.c_char_p, ctypes.c_char_p, ctypes.c_uint], ctypes.c_int\n   347\t        return lambda source, target: call(source, target, RENAME_EXCL)\n   348\t    if sys.platform.startswith('linux') and hasattr(libc, 'renameat2'):\n   349\t        call = libc.renameat2\n   350\t        call.argtypes, call.restype = [ctypes.c_int, ctypes.c_char_p, ctypes.c_int, ctypes.c_char_p, ctypes.c_uint], ctypes.c_int\n   351\t        return lambda source, target: call(AT_FDCWD, source, AT_FDCWD, target, RENAME_NOREPLACE)\n   352\t    return None\n   353\t\n   354\t\n   355\tdef publish(staged, out_dir):\n   356\t    \"\"\"One atomic move of the staged folder to the destination that refuses any existing destination, empty or not.\"\"\"\n   357\t    rename = _no_replace_rename()\n   358\t    if rename is None:\n   359\t        raise ReleaseRefused('this platform offers no atomic rename that refuses an existing destination')\n   360\t    if rename(os.fsencode(str(staged)), os.fsencode(str(out_dir))) != 0:\n   361\t        code = ctypes.get_errno()\n   362\t        if code in (errno.ENOTSUP, errno.EINVAL, errno.ENOSYS):\n   363\t            raise ReleaseRefused(f'the filesystem refuses an atomic no-replace rename ({os.strerror(code)})')\n   364\t        raise OSError(code, os.strerror(code), str(out_dir))\n   365\t\n   366\t\n   367\tdef publish_report(report, path):\n   368\t    \"\"\"The report, written to a private temporary file and linked to its name; the link refuses any existing path, and its success\n   369\t    is the moment the report is published. Returns None, or the temporary file it could not remove after publishing.\"\"\"\n   370\t    path = Path(path)\n   371\t    descriptor, temporary = tempfile.mkstemp(dir=path.parent, prefix=f'.{path.name}.')\n   372\t    try:\n   373\t        with os.fdopen(descriptor, 'wb') as handle:\n   374\t            handle.write(json.dumps(report, ensure_ascii=False, indent=1).encode('utf-8'))\n   375\t        os.link(temporary, path)\n   376\t    except BaseException:\n   377\t        os.unlink(temporary)\n   378\t        raise\n   379\t    try:\n   380\t        os.unlink(temporary)\n   381\t    except OSError:\n   382\t        return temporary\n   383\t    return None\n   384\t\n   385\t\n   386\tdef _unique_members(pairs):\n   387\t    names = [name for name, _ in pairs]\n   388\t    if len(names) != len(set(names)):\n   389\t        raise ReleaseRefused(f'a JSON member name repeats: {sorted({n for n in names if names.count(n) > 1})}')\n   390\t    return dict(pairs)\n   391\t\n   392\t\n   393\tdef read_data(package):\n   394\t    \"\"\"The package's data, read with the repeated-member check. `check_package` returns the data it checked, which is the copy to\n   395\t    trust; this reader is for inspection only.\"\"\"\n   396\t    return _parse((Path(package) / DATA_FILE).read_bytes(), DATA_FILE)\n   397\t\n   398\t\n   399\tURI_CHARACTERS = '%?#'\n   400\t\n   401\t\n   402\tdef store_path(path):\n   403\t    \"\"\"The resolved store path, the one the opener is then given (so the opener's own resolution has nothing left to follow): refused\n   404\t    when it holds a character a SQLite URI decodes (`store.open_read_only` puts the path into a `file:` URI unescaped, so `%2D` would\n   405\t    open a `-`).\"\"\"\n   406\t    real = os.path.realpath(path)\n   407\t    found = sorted({c for c in real if c in URI_CHARACTERS})\n   408\t    if found:\n   409\t        raise ReleaseRefused(f'{path}: a store path may not contain {found}, which the SQLite opener reads as URI syntax')\n   410\t    return real\n   411\t\n   412\t\n   413\tdef _read_regular(folder, name, where):\n   414\t    \"\"\"The bytes of one regular file in an opened folder, read once through a descriptor that refuses a symbolic link and opens a pipe\n   415\t    without waiting, so its type is refused instead.\"\"\"\n   416\t    try:\n   417\t        descriptor = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=folder)   # a pipe or device never blocks the check\n   418\t    except OSError as error:\n   419\t        if error.errno == errno.ELOOP:\n   420\t            raise ReleaseRefused(f'{where}/{name}: not a regular file') from None\n   421\t        raise\n   422\t    try:\n   423\t        if not stat.S_ISREG(os.fstat(descriptor).st_mode):\n   424\t            raise ReleaseRefused(f'{where}/{name}: not a regular file')\n   425\t        chunks = []\n   426\t        while True:\n   427\t            chunk = os.read(descriptor, 1 << 20)\n   428\t            if not chunk:\n   429\t                return b''.join(chunks)\n   430\t            chunks.append(chunk)\n   431\t    finally:\n   432\t        os.close(descriptor)\n   433\t\n   434\t\n   435\tdef _parse(raw, name):\n   436\t    try:\n   437\t        return json.loads(raw.decode('utf-8'), object_pairs_hook=_unique_members)\n   438\t    except (UnicodeDecodeError, json.JSONDecodeError) as error:\n   439\t        raise ReleaseRefused(f'{name}: not JSON ({error})') from None\n   440\t\n   441\t\n   442\tdef check_package(path, views_db=None, items_db=None, expected_as_of=None):\n   443\t    \"\"\"The package as a reader receives it: a real folder holding exactly the two regular files, each read once through one handle on\n   444\t    the folder; JSON with no repeated member name; a closed manifest that agrees with the data and the sha256 of the very bytes\n   445\t    parsed; data that passes `check_export` and, with the stores, `check_origins` at `expected_as_of` (or at the package's own day\n   446\t    passed through `resolve`). Returns (counts, the data checked, its size in bytes).\"\"\"\n   447\t    path = Path(path)\n   448\t    try:\n   449\t        folder = os.open(path, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)\n   450\t    except OSError as error:\n   451\t        if error.errno in (errno.ELOOP, errno.ENOTDIR):\n   452\t            raise ReleaseRefused(f'{path}: not a folder') from None\n   453\t        raise\n   454\t    try:\n   455\t        names = os.listdir(folder)\n   456\t        if sorted(names) != sorted(PACKAGE_FILES):\n   457\t            raise ReleaseRefused(f'{path}: holds {sorted(names)}, not exactly {sorted(PACKAGE_FILES)}')\n   458\t        raw, manifest_raw = _read_regular(folder, DATA_FILE, path), _read_regular(folder, MANIFEST_FILE, path)\n   459\t    finally:\n   460\t        os.close(folder)\n   461\t    manifest, data = _parse(manifest_raw, MANIFEST_FILE), _parse(raw, DATA_FILE)\n   462\t    counts = check_export(data)\n   463\t    _keys(manifest, 'manifest', 'the manifest')\n   464\t    if manifest['data_sha256'] != hashlib.sha256(raw).hexdigest():\n   465\t        raise ReleaseRefused('the manifest sha256 does not match the data file')\n   466\t    for name in ('format', 'allow_list', 'as_of'):\n   467\t        if manifest[name] != data[name]:\n   468\t            raise ReleaseRefused(f'the manifest {name} {manifest[name]!r} differs from the data {data[name]!r}')\n   469\t    if views_db is not None:\n   470\t        bound = expected_as_of if expected_as_of is not None else resolve(views_db, data['as_of'])\n   471\t        counts['fields_compared'] = check_origins(views_db, items_db, data, bound)\n   472\t    return counts, data, len(raw)\n   473\t\n   474\t\n   475\t# ---------- the report\n   476\t\n   477\tdef withheld_unresolved(views_db, data):\n   478\t    \"\"\"For the release report only: the number questions whose ladder does not resolve to bands, with the reason and whether the\n   479\t    view has a key. Withheld like every number question; this list never enters the package.\"\"\"\n   480\t    out = []\n   481\t    for question in data['questions']:\n   482\t        if question['class'] != 'number':\n   483\t            continue\n   484\t        bands, reason = service.ladder_bands(store.rungs_of(views_db, question['id']))\n   485\t        if bands is None:\n   486\t            out.append({'id': question['id'], 'reason': reason, 'has_key': key_measure(views_db, question['id'], data['as_of']) is not None})\n   487\t    return out\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc 'nl -ba docs/research/2026-11-22-number-answers/codex-r75.md; nl -ba docs/research/2026-11-22-number-answers/codex-r75b.md'","aggregated_output":"     1\t**Verdict: slice 1 is not accepted.** All four saved packages passed my read-only comparison with their stores. I also reproduced both refusals of the substituted $390 billion forecast. The release still accepts a value revision 10 forbids, and I reproduced a historical case where the exporter and checker agree on an answer that should have been withheld. [Saved acceptance results:10079](/Users/lchingen/hivemind/poc/data/release-check-2026-11-23/results.json:10079)\n     2\t\n     3\t### 1. Design and leaks\n     4\t\n     5\t| Finding | Evidence and consequence |\n     6\t|---|---|\n     7\t| **A later classification can expose an earlier forecast.** | In memory, an August 24 question initially exported “Forecast unavailable.” After adding an event key dated August 25, the **same August 24 export** showed “Above the estimate,” and the origin check passed. Both paths use a key lookup that ignores its sequence. The normal writer creates the key with the question, and I found zero sequence mismatches in the four stores. The exposure applies to a snapshot that breaks that convention. [Key lookup:81](/Users/lchingen/hivemind/src/hivemind/release.py:81) · [Origin check:289](/Users/lchingen/hivemind/src/hivemind/release.py:289) · [Writer:42](/Users/lchingen/hivemind/src/hivemind/views/writing.py:42) |\n     8\t| **Ten required text fields accept `null`.** | Revision 10 requires strings for all six evidence text fields and all four source fields. On an in-memory copy of `old-1`, a visible evidence record with a null summary passed both export and origin checking. This is a package-contract failure. I found no such null in the four saved packages. [Design:138](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/RELEASE-BUILD.md:138) · [Type check:170](/Users/lchingen/hivemind/src/hivemind/release.py:170) · [Affected fields:210](/Users/lchingen/hivemind/src/hivemind/release.py:210) |\n     9\t| **`check` can verify different bytes from the ones it hashes or reports.** | It checks file type by pathname, reads the data for its hash, then reopens it for parsing. The command opens it a third time for the report. If an existing package changes during verification, the hash, origin comparison, and reported date can describe different contents. The four stored packages were stable. [Package reads:400](/Users/lchingen/hivemind/src/hivemind/release.py:400) · [Report read:86](/Users/lchingen/hivemind/scripts/release_build.py:86) |\n    10\t| **Both commands can open a different database from the path named in the report.** | The release passes paths to an opener that inserts the literal filename into a SQLite URI without escaping it. I verified that SQLite decodes `%2D` in a directory name to `-`. If both literal paths exist, the filesystem check can inspect one database while export and origin checking read the other. The four recorded input paths do not have this ambiguity. [Command:51](/Users/lchingen/hivemind/scripts/release_build.py:51) · [Filesystem check:40](/Users/lchingen/hivemind/src/hivemind/live_lock.py:40) · [SQLite open:229](/Users/lchingen/hivemind/src/hivemind/views/store.py:229) |\n    11\t\n    12\tThere are also command and diagnostic departures with no observed forecast exposure. On a report-write failure, `check` prints only counts, so the user loses the date, unresolved list, size, and timings that revision 10 says it prints. Timings use the adjustable wall clock. An export-side missing-item error omits the evidence ID, and a changed summary is reported by list position instead of evidence ID. The direct visibility test and the separate required item lookup implement the specified selection and missing-item refusal on a stable snapshot. [Command contract:213](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/RELEASE-BUILD.md:213) · [Printed result:98](/Users/lchingen/hivemind/scripts/release_build.py:98) · [Timer:48](/Users/lchingen/hivemind/scripts/release_build.py:48) · [Item error:116](/Users/lchingen/hivemind/src/hivemind/release.py:116) · [Observed summary error:10104](/Users/lchingen/hivemind/poc/data/release-check-2026-11-23/results.json:10104)\n    13\t\n    14\t### 2. Tests and mutants\n    15\t\n    16\tThe recorded full-suite run did pass 412 tests. I reviewed all 23 release tests. Several assertions can pass after the behavior they claim to protect has been removed. [Suite output:6](/private/tmp/claude-501/-Users-lchingen-hivemind/f1ea972d-85a1-4f27-8010-cf0b60054109/tasks/bt1qa93h2.output:6)\n    17\t\n    18\t- **The staging-ownership test supplies the behavior it claims to prove.** Its instrumentation inserts `staged = None` itself. The mutant removes the exact text the instrumentation needs to find, so setup can fail before the marker is created. This leaves the claimed marker-survival proof vacuous against its designated mutant. [Test:548](/Users/lchingen/hivemind/tests/test_release.py:548) · [Edit precondition:468](/Users/lchingen/hivemind/tests/test_release.py:468) · [Mutant:38](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/release_mutants.py:38)\n    19\t- **The missing-item test damages two things.** It removes the source and the entire `e2` record. A checker that silently skips a missing source still expects `e2` with an empty source list, so it refuses this package for an independent reason. The mutant fails the expected-message assertion, but the design explicitly requires a pair the faulty checker *accepts*. [Test:345](/Users/lchingen/hivemind/tests/test_release.py:345) · [Checker:245](/Users/lchingen/hivemind/src/hivemind/release.py:245) · [Design:365](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/RELEASE-BUILD.md:365)\n    20\t- **Three other protections lack a decisive assertion.** Test 1 calls `check_export` again after export, so it cannot detect removal of the writer’s self-check. Test 2 omits the selected label “Bullish” and the label “Bearish” from its forbidden list. Test 9 changes a stored summary and accepts any refusal, so origin checking still makes it pass if hash verification is removed. [Test 1:180](/Users/lchingen/hivemind/tests/test_release.py:180) · [Test 2:191](/Users/lchingen/hivemind/tests/test_release.py:191) · [Test 9:280](/Users/lchingen/hivemind/tests/test_release.py:280)\n    21\t- **“21 of 22 caught” counts failing processes.** The scratch copies exclude bytecode and use their own source path. The runner nevertheless continues after a failed control and counts every nonzero pytest exit, including setup errors. Its “sets” mutant only deduplicates questions while preserving order. The date exception is supported independently: on Python 3.13 I reproduced 621 pieces for August 25 and 1,284 through September 20 with the compact-date mutant. [Mutant edits:25](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/release_mutants.py:25) · [Environment and counting:44](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/release_mutants.py:44) · [Date result:16](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/RELEASE-CHECK-RESULT.md:16)\n    22\t\n    23\t### 3. The $0 result\n    24\t\n    25\tI reproduced the reported class, evidence, source, and field-comparison counts for all four default packages. The byte and time ratios follow from the saved numbers. The closing switch also worked: `v8` was closed and its full closing reason was absent. Three claims exceed what the check established. [Store results:3](/Users/lchingen/hivemind/poc/data/release-check-2026-11-23/results.json:3) · [Closing result:10140](/Users/lchingen/hivemind/poc/data/release-check-2026-11-23/results.json:10140)\n    26\t\n    27\t- **“Bullish” appears in six `v8` fields in the closing package.** Five are source titles and one is the genuine `e1865` quote. The script tested whole-field equality. The report claimed absence from every field. These six occurrences are permitted source wording. [Comparison:226](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/release_check.py:226) · [Claim:60](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/RELEASE-CHECK-RESULT.md:60) · [Six field locations:140](/Users/lchingen/hivemind/poc/data/release-check-2026-11-23/results.json:140)\n    28\t- **The diagnostic search was incomplete.** Across the four packages it skipped 28,170 decoded data strings plus all 16 manifest strings. It also skipped event conditions and the stored switch reason `created`, which occurs in 81 actual package fields. Revision 10 calls for reading every hit. The report records a sample of 14 out of 1,245 reported matches. [Field selection:49](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/release_check.py:49) · [Stored-string selection:76](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/release_check.py:76) · [Requirement:451](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/RELEASE-BUILD.md:451) · [Sample:81](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/RELEASE-CHECK-RESULT.md:81)\n    29\t- **The dated check never tests j865’s selected-band phrase.** It searches for the full explanation and for j799’s “around $1 trillion.” A shortened copy containing only j865’s “rung 4” would escape that check. I searched the saved August 28 data separately and found zero occurrences of “rung 4.” The script also records failed acceptance comparisons and exceeded budgets as values in JSON without making them fail the command. [Required dated check:445](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/RELEASE-BUILD.md:445) · [Actual comparison:190](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/release_check.py:190) · [Budget handling:143](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/release_check.py:143) · [Command completion:227](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/release_check.py:227)\n    30\t\n    31\tThe four saved packages support the narrower conclusion that their forecasts were withheld and their permitted content matched the named stores. The historical classification case, accepted nulls, and verification gaps prevent accepting slice 1 as specified.     1\t**Verdict: slice 1 is not accepted.** All four saved packages matched their stores. The August 24 buyback question now says “Forecast unavailable,” and the August 25 package shows “Above the estimate.” Two command defects and two gaps in the acceptance checks remain. [Date correction](/Users/lchingen/hivemind/src/hivemind/release.py:87) · [Two-day test](/Users/lchingen/hivemind/tests/test_release.py:610)\n     2\t\n     3\t### Findings that block acceptance\n     4\t\n     5\t| Finding | Evidence and consequence |\n     6\t|---|---|\n     7\t| **Both commands can still verify against the wrong database if a store symlink changes.** | The release checks the characters in the resolved path, then returns the original path. The opener resolves it a second time. If the link changes between those operations, the path used by SQLite can differ from the one that passed the check. Export and verification can then agree with each other while reading the wrong store. The fix covers stable paths, including the four saved inputs. Test 24 exercises a fixed directory only. [Release path check](/Users/lchingen/hivemind/src/hivemind/release.py:405) · [Second resolution](/Users/lchingen/hivemind/src/hivemind/live_lock.py:42) · [SQLite open](/Users/lchingen/hivemind/src/hivemind/views/store.py:228) · [Test 24](/Users/lchingen/hivemind/tests/test_release.py:630) |\n     8\t| **The revised package reader can hang indefinitely on a file it promises to refuse.** | It opens each entry for blocking reads before checking its type. For a named pipe with no writer, the open waits and the regular-file check is never reached. This is a new failure in `check`. The existing test covers a symbolic link. [Open and type check](/Users/lchingen/hivemind/src/hivemind/release.py:414) · [Regular-file requirement](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/RELEASE-BUILD.md:192) · [File test](/Users/lchingen/hivemind/tests/test_release.py:363) |\n     9\t| **The acceptance script can pass with a required example missing.** | It builds the list of examples from whichever requested IDs the database returns, then checks only that list. I replayed its final decision in memory against the saved results. Removing `e1865` or `e3597`, one at a time, produced zero failures in both cases. All three examples were present in the actual run. The report’s claim that *any* missed item fails the command is too broad. [Selection](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/release_check.py:158) · [Pass decision](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/release_check.py:234) · [Report claim](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/RELEASE-CHECK-RESULT.md:57) |\n    10\t| **The round-75 finding about order remains open.** | The production checker compares ordered lists. The test labeled “comparing sets” still removes duplicate question IDs while preserving their order. Test 10 adds duplicates and never swaps two distinct entries. Its success therefore gives no evidence that the suite catches a checker that accepts reordered records. The runner now stops on a failed control, but it still credits any failed test body, including a scratch-edit assertion, without checking which assertion failed. [Production comparison](/Users/lchingen/hivemind/src/hivemind/release.py:293) · [Mutant](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/release_mutants.py:25) · [Test 10](/Users/lchingen/hivemind/tests/test_release.py:315) · [Scratch assertion](/Users/lchingen/hivemind/tests/test_release.py:471) · [Runner verdict](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/release_mutants.py:77) |\n    11\t\n    12\t### Other round-75 findings\n    13\t\n    14\t- **Historical classification and required text are fixed in code.** I checked both buyback dates and independently tried `null` in each of the ten required evidence and source fields. All ten were refused. Test 23 itself exercises only the summary, so it would still pass if validation disappeared from the four source fields. [Text validation](/Users/lchingen/hivemind/src/hivemind/release.py:212) · [Source validation](/Users/lchingen/hivemind/src/hivemind/release.py:217) · [Test 23](/Users/lchingen/hivemind/tests/test_release.py:618)\n    15\t- **The hash, parser, and command report now use the same data.** Both commands print the full report before attempting to write it and use monotonic timing. Missing-source and changed-summary errors now identify the evidence. Test 9 requires the hash-specific refusal. [Package read](/Users/lchingen/hivemind/src/hivemind/release.py:455) · [Report output](/Users/lchingen/hivemind/scripts/release_build.py:29) · [Check timing and data](/Users/lchingen/hivemind/scripts/release_build.py:88) · [Missing source](/Users/lchingen/hivemind/src/hivemind/release.py:122) · [Test 9](/Users/lchingen/hivemind/tests/test_release.py:283)\n    16\t- **The staging-marker, missing-item, and writer self-check tests now distinguish the intended failures.** Test 2 also checks all five forecast labels, although only within `v1`. A label copied into another question would escape that assertion. [Marker survival](/Users/lchingen/hivemind/tests/test_release.py:551) · [Missing-item pair](/Users/lchingen/hivemind/tests/test_release.py:356) · [Writer self-check pair](/Users/lchingen/hivemind/tests/test_release.py:662) · [Label assertion](/Users/lchingen/hivemind/tests/test_release.py:198)\n    17\t\n    18\t### What the saved run establishes\n    19\t\n    20\tI reproduced all four packages’ comparison counts and byte sizes, plus both refusals of the substituted `$390 billion` forecast. The saved timings meet the stated budgets. The dated checks now include “rung 4.” The closing package shows `v8` closed, omits its closing reason, and retains the six genuine source occurrences of “Bullish.” The recorded full suite passed 416 tests. [Store results](/Users/lchingen/hivemind/poc/data/release-check-2026-11-23b/results.json:3) · [Both refusals](/Users/lchingen/hivemind/poc/data/release-check-2026-11-23b/results.json:44592) · [Dated checks](/Users/lchingen/hivemind/poc/data/release-check-2026-11-23b/results.json:44602) · [Closing check](/Users/lchingen/hivemind/poc/data/release-check-2026-11-23b/results.json:44638) · [Suite result](/private/tmp/claude-501/-Users-lchingen-hivemind/f1ea972d-85a1-4f27-8010-cf0b60054109/tasks/bi89r1zvy.output:3)\n    21\t\n    22\tOne diagnostic count needs correction. The forecast-label matches occupy **257 package fields containing 32 distinct texts**. Every match was in a source title or quote. The report calls these “32 distinct places.” I found no off-list value or value unequal to its store in the four reviewed packages. [Diagnostic records](/Users/lchingen/hivemind/poc/data/release-check-2026-11-23b/results.json:27) · [Report wording](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/RELEASE-CHECK-RESULT.md:102)","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_10","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba docs/research/2026-11-22-number-answers/RELEASE-CHECK-RESULT.md; rg -n 'revision 11|Revision 11|\"'^#'\"' docs/research/2026-11-22-number-answers/RELEASE-BUILD.md\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba docs/research/2026-11-22-number-answers/RELEASE-CHECK-RESULT.md; rg -n 'revision 11|Revision 11|\"'^#'\"' docs/research/2026-11-22-number-answers/RELEASE-BUILD.md\"","aggregated_output":"     1\t# \"Forecast unavailable\" release, slice 1: built and checked at $0 (2026-11-23)\n     2\t\n     3\t**Result.** Slice 1 is built to `RELEASE-BUILD.md`:\n     4\t- revision 10 was ready per council 74j, after ten review rounds;\n     5\t- revision 11 records what councils 75 and 75b required of the build.\n     6\t\n     7\tIt passes its tests, its mutants and the $0 release check on four stored stores. Nothing is committed, published or deployed. The POC\n     8\tis unchanged; no POC code imports the release module.\n     9\t\n    10\t- Code: `src/hivemind/release.py`, `scripts/release_build.py`, `tests/test_release.py`.\n    11\t- Check: `release_check.py`; mutants: `release_mutants.py` (both in this folder).\n    12\t- Output: `poc/data/release-check-2026-11-23c/`. The runs `release-check-2026-11-23/` and `-23b/` predate the fixes of councils 75\n    13\t  and 75b and are kept for the record; their numbers are the same.\n    14\t\n    15\t## 1. Council 75's findings, and what changed\n    16\t\n    17\tCouncil 75 (`codex-r75.md`) reproduced the four packages' counts and both refusals of the substituted forecast. It did not accept the\n    18\tslice. Its findings and the fixes:\n    19\t\n    20\t| Finding | Fix | Proof |\n    21\t|---|---|---|\n    22\t| A key written after the bound could reclassify an earlier package (the key lookup ignored its `seq`) | the key counts only when visible at the bound | test 22; mutant \"key read without its day\" |\n    23\t| Ten text fields accepted null, which revision 10 forbids | strings only | test 23; mutant \"null accepted as text\" |\n    24\t| `check` read the data file three times: it could hash one version and certify another | one read through one folder handle; hash and parse the same bytes; the command reports that data | structural (`check_package`) |\n    25\t| A path holding `%` could make SQLite open a different file from the one named | `release.store_path` refuses `%`, `?`, `#` | test 24; mutant \"store-path refusal removed\" |\n    26\t| Test 14's marker case supplied the very line its mutant removes | the instrumentation no longer touches the line that drops the staging path | test 14; mutant caught |\n    27\t| Test 13 damaged two things | the package copy keeps `e2` with no source, which is what a checker that drops missing items expects | test 13; mutant \"inner join\" caught |\n    28\t| Tests 1, 2 and 9 lacked decisive assertions | test 25 proves the writer's own refusal; test 2 checks all five labels in `v1`'s own fields; test 9 names each refusal's reason | mutants caught |\n    29\t| The mutant runner counted any non-zero exit | it stops on a failing control, and counts a catch only with a failing test and no setup or collection error | run below |\n    30\t| My first result overstated the closing check, the diagnostic search and the dated check, and the script never failed | corrected below; the script now fails on any missed acceptance item or budget | this run |\n    31\t\n    32\t**Council 75b** (`codex-r75b.md`) confirmed the fixes above and found four more gaps, now fixed:\n    33\t\n    34\t| Finding | Fix | Proof |\n    35\t|---|---|---|\n    36\t| The store-path check returned the original path, which the opener resolved again | `store_path` returns the resolved path, and the opener is given that | test 24 (a symbolic link); mutant \"store path returned unresolved\" |\n    37\t| A named pipe in a package would make `check` hang instead of refusing | files are opened without waiting (`O_NONBLOCK`), then refused by type | test 15, through the command with a 30 s bound; mutant \"pipe opened blocking\" |\n    38\t| The check script could pass with a required example missing | the three examples are a fixed list; a missing one fails the script | this run |\n    39\t| No test reordered records, and the runner credited a failure of a test's own scratch edit | test 10 reorders questions and evidence; scratch edits fail with \"scratch anchor\", which the runner does not count | mutant \"check_origins accepting another order\" |\n    40\t\n    41\tIt also asked that test 23 cover all ten text fields (now one case per field) and that test 2 check every question's own fields for\n    42\tthe labels (done).\n    43\t\n    44\t**No regression.**\n    45\t- The release tests: 36 pass. The full suite passed with 416 tests before council 75b's changes; it is re-run in the next step.\n    46\t- Mutants: 28 of 29 are caught by failing tests, not counting scratch-edit failures, with no setup errors.\n    47\t- **The 29th, the canonical-day check removed, is equivalent on this repository's Python 3.10.10,** whose `date.fromisoformat` already\n    48\t  refuses `20260825`. Under Python 3.13, on a temporary copy of `old-1` with one later completed day:\n    49\t  - the real code refuses `20260825`;\n    50\t  - the mutant exports `v8` with 1,284 pieces of evidence through 2026-09-20 into a package dated 2026-08-25, where the right package\n    51\t    holds 621.\n    52\t\n    53\t## 2. The $0 release check (design §7)\n    54\t\n    55\t| Store | Bound | Number / event / Yes-No | Evidence | Fields compared | Data bytes (library) | Seconds (library) |\n    56\t|---|---|---|---|---|---|---|\n    57\t| old-1 | 2026-09-20 | 19 / 28 / 0 | 8,251 | 91,055 | 5,788,634 (14,478,536) | 8.59 (6.77) |\n    58\t| old-2 | 2026-09-20 | 17 / 26 / 0 | 6,306 | 69,636 | 4,427,609 (11,893,701) | 6.47 (5.11) |\n    59\t| old-3 | 2026-09-20 | 18 / 31 / 0 | 6,659 | 73,559 | 4,685,247 (12,375,915) | 6.78 (5.45) |\n    60\t| served | 2026-08-28 | 13 / 55 / 0 | 6,461 | 71,524 | 4,612,321 (12,145,774) | 4.49 (3.50) |\n    61\t\n    62\t- **Every package passed its origin check:** every field compared with its stored source at the bound.\n    63\t- **No number question is unresolved** in these stores.\n    64\t- **Budgets met:**\n    65\t  - the bytes are 0.37–0.40 of the existing library's;\n    66\t  - the seconds are 1.24–1.28 times the library's, against a budget of 3 times and 120 s.\n    67\t- **How the evidence is counted.** The count includes each piece once per question that holds it. Every piece has exactly one source\n    68\t  row (`old-1`: 5,390 rows for 5,390 pieces).\n    69\t- **The script exits non-zero on any missed acceptance item** (each example, refusal, leak, control and closing check named in it) or\n    70\t  budget; this run ended \"every acceptance item and budget met\".\n    71\t\n    72\t**The decisive acceptance case** (council 74, `old-1`):\n    73\t- **Kept, equal to the store:**\n    74\t  - Morningstar's $361 billion (`e2295`, under `v8`);\n    75\t  - the genuine \"Bullish confirmation\" quote (`e1865`, under `v4`, `v5`, `v8`);\n    76\t  - the analysts' \"$390 billion\" (`e3597`, under `v4`, `v5`).\n    77\t- **The system's own forecast** (`j1580` implied outcome, \"About $390 billion: …\"):\n    78\t  - substituted into `e2295`'s summary, it is refused, naming `question v8.evidence e2295.one_line`;\n    79\t  - added to the manifest, it is refused, naming the off-list key.\n    80\t\n    81\t**The other checks:**\n    82\t- **`old-1/v8`:** class `number`, marked \"Forecast unavailable\". Its 1,284 pieces of evidence are the same ids as `service.evidence` at\n    83\t  the bound.\n    84\t- **The known Yes/No leaks at their own days.**\n    85\t  - `old-3/v36` at 2026-08-25 (judgement 799) and `old-1/v10` at 2026-08-28 (judgement 865) are the latest judgements there.\n    86\t  - Both keep \"Yes\".\n    87\t  - The full explanation and reason texts are absent.\n    88\t  - So are the judgements' own phrases: \"around $1 trillion\", \"rung 4\", \"at rung\" and \"capex at rung\" occur in no field.\n    89\t- **Control:** event `old-1/v3` keeps \"Yes\" and its evidence, equal to the store.\n    90\t- **Closing,** on a copy of `old-1` with a closing switch for `v8`, \"due 2026-09-20, frozen on 2026-09-20 at rung 2 Bullish\":\n    91\t  - `bundle.view_bundle` exposes it;\n    92\t  - the package shows `open: false`;\n    93\t  - the reason appears nowhere.\n    94\t  - The word \"Bullish\" does occur inside six `v8` fields: five source titles and the genuine `e1865` quote. That is source wording,\n    95\t    which the design keeps.\n    96\t\n    97\t## 3. The diagnostic search, every hit read\n    98\t\n    99\tThe search covered every decoded string of each package, ids, classes, the marker and the manifest included. For each question it\n   100\ttook every stored string the package must not hold:\n   101\t- rung labels of number questions;\n   102\t- the rung conditions of every question;\n   103\t- judgement reasons, explanations, implied outcomes and references, where the store has those columns (the served ledger lacks the\n   104\t  last two);\n   105\t- every switch reason, \"created\" included.\n   106\t\n   107\t| Store | Stored strings judged | Package strings | Hits |\n   108\t|---|---|---|---|\n   109\t| old-1 | 6,670 | 91,012 | 1,378: \"created\" 987, \"Bullish\" 391 |\n   110\t| old-2 | 6,677 | 69,597 | 771: \"created\" 516, \"Bullish\" 255 |\n   111\t| old-3 | 7,045 | 73,514 | 1,613: \"created\" 1,176, labels 437 (\"Bullish\", \"High\", \"Low\", \"Bearish\", \"Middle\") |\n   112\t| served | 2,149 | 71,460 | 1,794: \"created\" 1,632, \"Bullish\" 162 |\n   113\t\n   114\t- **No condition, reason, explanation, implied outcome, reference or closing reason is found anywhere.**\n   115\t- **The label hits are 257 package fields holding 32 distinct texts, all read.** Every one is source wording:\n   116\t  - headlines: \"Jensen Huang's Bullish Call …\", \"Stock Traded Lower\", \"Earnings Call Highlights\", \"Lows Not Seen Since 2019\",\n   117\t    \"Sky-High P/E\", \"That Bearish Bet\";\n   118\t  - the memory term \"High Bandwidth Memory\";\n   119\t  - the analyst quote \"Bullish confirmation would require …\".\n   120\t- **The \"created\" hits fall in 33 distinct texts, all containing the ordinary word.** It is every question's creation reason and\n   121\t  carries no forecast.\n   122\t\n   123\t## 4. Not shown, and still open\n   124\t\n   125\t- **The reader's screen** (slice 2, D756's screen check) is not built. The release page must read only this package, with no live\n   126\t  fetch and no idea submission, and needs a browser check of the `old-1/v8` screen.\n   127\t- **The idea path in the release:** deferred (council 74); its acceptance is pending.\n   128\t- **The recorded disagreement on evidence summaries** (`RELEASE-BUILD.md` §8) stands.\n   129\t- **`store.open_read_only` puts a path into a SQLite URI unescaped.** That is shared POC code; the release refuses such paths\n   130\t  rather than changing it.\n1:# \"Forecast unavailable\" release: build design for slice 1 (the exporter and the checked package)\n3:**Status: revision 11. Built** (`src/hivemind/release.py`, `scripts/release_build.py`, `tests/test_release.py`; result in\n4:`RELEASE-CHECK-RESULT.md`). Revision 10 was ready per council 74j; revision 11 records the changes council 75 required of the build.\n6:**Revision 11 (council 75, `codex-r75.md`).** Each change is in the code and has a test and a mutant:\n87:## 0. Scope\n107:## 1. What is built\n246:## 2. State × event (one export, read-only)\n283:## 3. Value × reader\n312:## 4. New path × old checks\n326:## 5. Prior decisions\n338:## 6. Tests (`tests/test_release.py`) and mutants\n441:## 7. The $0 release check (stored stores, read-only)\n477:## 8. A disclosed property, not built: evidence summaries keep extraction's wording\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_11","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"tail -n 3 docs/research/2026-11-04-filing-end-to-end/log.md; rg -n 'slice 1|round 75' docs/CURRENT_STATE.md | cut -c1-600 | head -15\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"tail -n 3 docs/research/2026-11-04-filing-end-to-end/log.md; rg -n 'slice 1|round 75' docs/CURRENT_STATE.md | cut -c1-600 | head -15\"","aggregated_output":"| 39 | 11-05 | 第 3 步：做进正式系统（设计四张表，Codex 审 3 轮：第 1 轮 4 条严重、第 2 轮 2 条严重，都改；第 3 轮无严重问题） | 建成 `baseline.run` + poc-v116 + baseline-v3 提示词文件；$0 核对：44 份请求和验证时逐字节相同，3 次存下的回答走正式代码写出的记录完全一样，第一天判断正好判这些题，网页从开始跟踪那天可见；新测试 12 条、6 个弄坏版本都抓出、全套 272 条通过；设计页和 PRD 00/03/04/05/06 更新，`docs/check.py` 通过 | 交 Alex：要不要跑 14 天三遍完整验收（约 5 美元） |\n| 40 | 11-05 | Alex：\"跑验收\"。14 天三遍完整验收：poc-v116（开始跟踪时读财报）三遍、当天重跑 poc-v108 三遍作对照，冻结尺子打分（事先锁定 `acceptance-design.md`）；电脑中途在电池上睡了约 5 小时，6 遍被暂停，插电后自己接着跑完 | **全过**：v10、v12 各 3/3（对照从没判过）；合计 53 对 45（满分 57，+8）；唯一少两次的 v17（0/3 对 2/3）两人都认定不是起点数：同一份抽取请求，新配置两遍碰巧留下\"中国份额归零\"那句，对照没留；约 4.79 美元 | 交 Alex：poc-v116 是否成为默认 |\n| 41 | 11-05 | Alex：\"都做\"（poc-v116 设成默认；提交代码、开 PR）。默认配置改成 poc-v116，默认的条目数据库换成带财报网页原文的那一份（旧的没有原文，新默认会在它上面拒跑）；测试按用户的用法补上：不给种子题就拒绝，给了就先读财报再跑第一天 | 测试全过，5 个弄坏的版本都抓出；配置的设置和验收三遍记下的校验码一致（只改了配置里的注释）；花钱前的检查脚本在新配置的运行数据上照常跑完，但不复查读财报那一步的引用检查（记为未补的缺口）；D366 | 提交、开 PR；下一类问题等 Alex |\n448:**The one next task: build slice 1 of the \"Forecast unavailable\" release once its build design passes council 74 (D758).** Under\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_12","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"cat docs/research/2026-11-22-number-answers/codex-r75.md; nl -ba src/hivemind/release.py | sed -n '322,510p'; nl -ba scripts/release_build.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"cat docs/research/2026-11-22-number-answers/codex-r75.md; nl -ba src/hivemind/release.py | sed -n '322,510p'; nl -ba scripts/release_build.py\"","aggregated_output":"**Verdict: slice 1 is not accepted.** All four saved packages passed my read-only comparison with their stores. I also reproduced both refusals of the substituted $390 billion forecast. The release still accepts a value revision 10 forbids, and I reproduced a historical case where the exporter and checker agree on an answer that should have been withheld. [Saved acceptance results:10079](/Users/lchingen/hivemind/poc/data/release-check-2026-11-23/results.json:10079)\n\n### 1. Design and leaks\n\n| Finding | Evidence and consequence |\n|---|---|\n| **A later classification can expose an earlier forecast.** | In memory, an August 24 question initially exported “Forecast unavailable.” After adding an event key dated August 25, the **same August 24 export** showed “Above the estimate,” and the origin check passed. Both paths use a key lookup that ignores its sequence. The normal writer creates the key with the question, and I found zero sequence mismatches in the four stores. The exposure applies to a snapshot that breaks that convention. [Key lookup:81](/Users/lchingen/hivemind/src/hivemind/release.py:81) · [Origin check:289](/Users/lchingen/hivemind/src/hivemind/release.py:289) · [Writer:42](/Users/lchingen/hivemind/src/hivemind/views/writing.py:42) |\n| **Ten required text fields accept `null`.** | Revision 10 requires strings for all six evidence text fields and all four source fields. On an in-memory copy of `old-1`, a visible evidence record with a null summary passed both export and origin checking. This is a package-contract failure. I found no such null in the four saved packages. [Design:138](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/RELEASE-BUILD.md:138) · [Type check:170](/Users/lchingen/hivemind/src/hivemind/release.py:170) · [Affected fields:210](/Users/lchingen/hivemind/src/hivemind/release.py:210) |\n| **`check` can verify different bytes from the ones it hashes or reports.** | It checks file type by pathname, reads the data for its hash, then reopens it for parsing. The command opens it a third time for the report. If an existing package changes during verification, the hash, origin comparison, and reported date can describe different contents. The four stored packages were stable. [Package reads:400](/Users/lchingen/hivemind/src/hivemind/release.py:400) · [Report read:86](/Users/lchingen/hivemind/scripts/release_build.py:86) |\n| **Both commands can open a different database from the path named in the report.** | The release passes paths to an opener that inserts the literal filename into a SQLite URI without escaping it. I verified that SQLite decodes `%2D` in a directory name to `-`. If both literal paths exist, the filesystem check can inspect one database while export and origin checking read the other. The four recorded input paths do not have this ambiguity. [Command:51](/Users/lchingen/hivemind/scripts/release_build.py:51) · [Filesystem check:40](/Users/lchingen/hivemind/src/hivemind/live_lock.py:40) · [SQLite open:229](/Users/lchingen/hivemind/src/hivemind/views/store.py:229) |\n\nThere are also command and diagnostic departures with no observed forecast exposure. On a report-write failure, `check` prints only counts, so the user loses the date, unresolved list, size, and timings that revision 10 says it prints. Timings use the adjustable wall clock. An export-side missing-item error omits the evidence ID, and a changed summary is reported by list position instead of evidence ID. The direct visibility test and the separate required item lookup implement the specified selection and missing-item refusal on a stable snapshot. [Command contract:213](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/RELEASE-BUILD.md:213) · [Printed result:98](/Users/lchingen/hivemind/scripts/release_build.py:98) · [Timer:48](/Users/lchingen/hivemind/scripts/release_build.py:48) · [Item error:116](/Users/lchingen/hivemind/src/hivemind/release.py:116) · [Observed summary error:10104](/Users/lchingen/hivemind/poc/data/release-check-2026-11-23/results.json:10104)\n\n### 2. Tests and mutants\n\nThe recorded full-suite run did pass 412 tests. I reviewed all 23 release tests. Several assertions can pass after the behavior they claim to protect has been removed. [Suite output:6](/private/tmp/claude-501/-Users-lchingen-hivemind/f1ea972d-85a1-4f27-8010-cf0b60054109/tasks/bt1qa93h2.output:6)\n\n- **The staging-ownership test supplies the behavior it claims to prove.** Its instrumentation inserts `staged = None` itself. The mutant removes the exact text the instrumentation needs to find, so setup can fail before the marker is created. This leaves the claimed marker-survival proof vacuous against its designated mutant. [Test:548](/Users/lchingen/hivemind/tests/test_release.py:548) · [Edit precondition:468](/Users/lchingen/hivemind/tests/test_release.py:468) · [Mutant:38](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/release_mutants.py:38)\n- **The missing-item test damages two things.** It removes the source and the entire `e2` record. A checker that silently skips a missing source still expects `e2` with an empty source list, so it refuses this package for an independent reason. The mutant fails the expected-message assertion, but the design explicitly requires a pair the faulty checker *accepts*. [Test:345](/Users/lchingen/hivemind/tests/test_release.py:345) · [Checker:245](/Users/lchingen/hivemind/src/hivemind/release.py:245) · [Design:365](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/RELEASE-BUILD.md:365)\n- **Three other protections lack a decisive assertion.** Test 1 calls `check_export` again after export, so it cannot detect removal of the writer’s self-check. Test 2 omits the selected label “Bullish” and the label “Bearish” from its forbidden list. Test 9 changes a stored summary and accepts any refusal, so origin checking still makes it pass if hash verification is removed. [Test 1:180](/Users/lchingen/hivemind/tests/test_release.py:180) · [Test 2:191](/Users/lchingen/hivemind/tests/test_release.py:191) · [Test 9:280](/Users/lchingen/hivemind/tests/test_release.py:280)\n- **“21 of 22 caught” counts failing processes.** The scratch copies exclude bytecode and use their own source path. The runner nevertheless continues after a failed control and counts every nonzero pytest exit, including setup errors. Its “sets” mutant only deduplicates questions while preserving order. The date exception is supported independently: on Python 3.13 I reproduced 621 pieces for August 25 and 1,284 through September 20 with the compact-date mutant. [Mutant edits:25](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/release_mutants.py:25) · [Environment and counting:44](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/release_mutants.py:44) · [Date result:16](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/RELEASE-CHECK-RESULT.md:16)\n\n### 3. The $0 result\n\nI reproduced the reported class, evidence, source, and field-comparison counts for all four default packages. The byte and time ratios follow from the saved numbers. The closing switch also worked: `v8` was closed and its full closing reason was absent. Three claims exceed what the check established. [Store results:3](/Users/lchingen/hivemind/poc/data/release-check-2026-11-23/results.json:3) · [Closing result:10140](/Users/lchingen/hivemind/poc/data/release-check-2026-11-23/results.json:10140)\n\n- **“Bullish” appears in six `v8` fields in the closing package.** Five are source titles and one is the genuine `e1865` quote. The script tested whole-field equality. The report claimed absence from every field. These six occurrences are permitted source wording. [Comparison:226](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/release_check.py:226) · [Claim:60](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/RELEASE-CHECK-RESULT.md:60) · [Six field locations:140](/Users/lchingen/hivemind/poc/data/release-check-2026-11-23/results.json:140)\n- **The diagnostic search was incomplete.** Across the four packages it skipped 28,170 decoded data strings plus all 16 manifest strings. It also skipped event conditions and the stored switch reason `created`, which occurs in 81 actual package fields. Revision 10 calls for reading every hit. The report records a sample of 14 out of 1,245 reported matches. [Field selection:49](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/release_check.py:49) · [Stored-string selection:76](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/release_check.py:76) · [Requirement:451](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/RELEASE-BUILD.md:451) · [Sample:81](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/RELEASE-CHECK-RESULT.md:81)\n- **The dated check never tests j865’s selected-band phrase.** It searches for the full explanation and for j799’s “around $1 trillion.” A shortened copy containing only j865’s “rung 4” would escape that check. I searched the saved August 28 data separately and found zero occurrences of “rung 4.” The script also records failed acceptance comparisons and exceeded budgets as values in JSON without making them fail the command. [Required dated check:445](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/RELEASE-BUILD.md:445) · [Actual comparison:190](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/release_check.py:190) · [Budget handling:143](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/release_check.py:143) · [Command completion:227](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/release_check.py:227)\n\nThe four saved packages support the narrower conclusion that their forecasts were withheld and their permitted content matched the named stores. The historical classification case, accepted nulls, and verification gaps prevent accepting slice 1 as specified.   322\t# ---------- the package\n   323\t\n   324\tdef _dump(value):\n   325\t    return json.dumps(value, ensure_ascii=False, separators=(',', ':')).encode('utf-8')\n   326\t\n   327\t\n   328\tdef stage(out_dir):\n   329\t    \"\"\"A private staging folder, unique to this invocation, beside the destination.\"\"\"\n   330\t    out_dir = Path(out_dir)\n   331\t    return Path(tempfile.mkdtemp(dir=out_dir.parent, prefix=f'.{out_dir.name}.staging-'))\n   332\t\n   333\t\n   334\tdef write_package(data, staged):\n   335\t    \"\"\"The data file and its manifest, written into the staging folder.\"\"\"\n   336\t    payload = _dump(data)\n   337\t    (Path(staged) / DATA_FILE).write_bytes(payload)\n   338\t    manifest = {'format': data['format'], 'allow_list': data['allow_list'], 'as_of': data['as_of'], 'data_sha256': hashlib.sha256(payload).hexdigest()}\n   339\t    (Path(staged) / MANIFEST_FILE).write_bytes(_dump(manifest))\n   340\t\n   341\t\n   342\tdef _no_replace_rename():\n   343\t    libc = ctypes.CDLL(ctypes.util.find_library('c'), use_errno=True)\n   344\t    if sys.platform == 'darwin' and hasattr(libc, 'renamex_np'):\n   345\t        call = libc.renamex_np\n   346\t        call.argtypes, call.restype = [ctypes.c_char_p, ctypes.c_char_p, ctypes.c_uint], ctypes.c_int\n   347\t        return lambda source, target: call(source, target, RENAME_EXCL)\n   348\t    if sys.platform.startswith('linux') and hasattr(libc, 'renameat2'):\n   349\t        call = libc.renameat2\n   350\t        call.argtypes, call.restype = [ctypes.c_int, ctypes.c_char_p, ctypes.c_int, ctypes.c_char_p, ctypes.c_uint], ctypes.c_int\n   351\t        return lambda source, target: call(AT_FDCWD, source, AT_FDCWD, target, RENAME_NOREPLACE)\n   352\t    return None\n   353\t\n   354\t\n   355\tdef publish(staged, out_dir):\n   356\t    \"\"\"One atomic move of the staged folder to the destination that refuses any existing destination, empty or not.\"\"\"\n   357\t    rename = _no_replace_rename()\n   358\t    if rename is None:\n   359\t        raise ReleaseRefused('this platform offers no atomic rename that refuses an existing destination')\n   360\t    if rename(os.fsencode(str(staged)), os.fsencode(str(out_dir))) != 0:\n   361\t        code = ctypes.get_errno()\n   362\t        if code in (errno.ENOTSUP, errno.EINVAL, errno.ENOSYS):\n   363\t            raise ReleaseRefused(f'the filesystem refuses an atomic no-replace rename ({os.strerror(code)})')\n   364\t        raise OSError(code, os.strerror(code), str(out_dir))\n   365\t\n   366\t\n   367\tdef publish_report(report, path):\n   368\t    \"\"\"The report, written to a private temporary file and linked to its name; the link refuses any existing path, and its success\n   369\t    is the moment the report is published. Returns None, or the temporary file it could not remove after publishing.\"\"\"\n   370\t    path = Path(path)\n   371\t    descriptor, temporary = tempfile.mkstemp(dir=path.parent, prefix=f'.{path.name}.')\n   372\t    try:\n   373\t        with os.fdopen(descriptor, 'wb') as handle:\n   374\t            handle.write(json.dumps(report, ensure_ascii=False, indent=1).encode('utf-8'))\n   375\t        os.link(temporary, path)\n   376\t    except BaseException:\n   377\t        os.unlink(temporary)\n   378\t        raise\n   379\t    try:\n   380\t        os.unlink(temporary)\n   381\t    except OSError:\n   382\t        return temporary\n   383\t    return None\n   384\t\n   385\t\n   386\tdef _unique_members(pairs):\n   387\t    names = [name for name, _ in pairs]\n   388\t    if len(names) != len(set(names)):\n   389\t        raise ReleaseRefused(f'a JSON member name repeats: {sorted({n for n in names if names.count(n) > 1})}')\n   390\t    return dict(pairs)\n   391\t\n   392\t\n   393\tdef read_data(package):\n   394\t    \"\"\"The package's data, read with the repeated-member check. `check_package` returns the data it checked, which is the copy to\n   395\t    trust; this reader is for inspection only.\"\"\"\n   396\t    return _parse((Path(package) / DATA_FILE).read_bytes(), DATA_FILE)\n   397\t\n   398\t\n   399\tURI_CHARACTERS = '%?#'\n   400\t\n   401\t\n   402\tdef store_path(path):\n   403\t    \"\"\"The resolved store path, the one the opener is then given (so the opener's own resolution has nothing left to follow): refused\n   404\t    when it holds a character a SQLite URI decodes (`store.open_read_only` puts the path into a `file:` URI unescaped, so `%2D` would\n   405\t    open a `-`).\"\"\"\n   406\t    real = os.path.realpath(path)\n   407\t    found = sorted({c for c in real if c in URI_CHARACTERS})\n   408\t    if found:\n   409\t        raise ReleaseRefused(f'{path}: a store path may not contain {found}, which the SQLite opener reads as URI syntax')\n   410\t    return real\n   411\t\n   412\t\n   413\tdef _read_regular(folder, name, where):\n   414\t    \"\"\"The bytes of one regular file in an opened folder, read once through a descriptor that refuses a symbolic link and opens a pipe\n   415\t    without waiting, so its type is refused instead.\"\"\"\n   416\t    try:\n   417\t        descriptor = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=folder)   # a pipe or device never blocks the check\n   418\t    except OSError as error:\n   419\t        if error.errno == errno.ELOOP:\n   420\t            raise ReleaseRefused(f'{where}/{name}: not a regular file') from None\n   421\t        raise\n   422\t    try:\n   423\t        if not stat.S_ISREG(os.fstat(descriptor).st_mode):\n   424\t            raise ReleaseRefused(f'{where}/{name}: not a regular file')\n   425\t        chunks = []\n   426\t        while True:\n   427\t            chunk = os.read(descriptor, 1 << 20)\n   428\t            if not chunk:\n   429\t                return b''.join(chunks)\n   430\t            chunks.append(chunk)\n   431\t    finally:\n   432\t        os.close(descriptor)\n   433\t\n   434\t\n   435\tdef _parse(raw, name):\n   436\t    try:\n   437\t        return json.loads(raw.decode('utf-8'), object_pairs_hook=_unique_members)\n   438\t    except (UnicodeDecodeError, json.JSONDecodeError) as error:\n   439\t        raise ReleaseRefused(f'{name}: not JSON ({error})') from None\n   440\t\n   441\t\n   442\tdef check_package(path, views_db=None, items_db=None, expected_as_of=None):\n   443\t    \"\"\"The package as a reader receives it: a real folder holding exactly the two regular files, each read once through one handle on\n   444\t    the folder; JSON with no repeated member name; a closed manifest that agrees with the data and the sha256 of the very bytes\n   445\t    parsed; data that passes `check_export` and, with the stores, `check_origins` at `expected_as_of` (or at the package's own day\n   446\t    passed through `resolve`). Returns (counts, the data checked, its size in bytes).\"\"\"\n   447\t    path = Path(path)\n   448\t    try:\n   449\t        folder = os.open(path, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)\n   450\t    except OSError as error:\n   451\t        if error.errno in (errno.ELOOP, errno.ENOTDIR):\n   452\t            raise ReleaseRefused(f'{path}: not a folder') from None\n   453\t        raise\n   454\t    try:\n   455\t        names = os.listdir(folder)\n   456\t        if sorted(names) != sorted(PACKAGE_FILES):\n   457\t            raise ReleaseRefused(f'{path}: holds {sorted(names)}, not exactly {sorted(PACKAGE_FILES)}')\n   458\t        raw, manifest_raw = _read_regular(folder, DATA_FILE, path), _read_regular(folder, MANIFEST_FILE, path)\n   459\t    finally:\n   460\t        os.close(folder)\n   461\t    manifest, data = _parse(manifest_raw, MANIFEST_FILE), _parse(raw, DATA_FILE)\n   462\t    counts = check_export(data)\n   463\t    _keys(manifest, 'manifest', 'the manifest')\n   464\t    if manifest['data_sha256'] != hashlib.sha256(raw).hexdigest():\n   465\t        raise ReleaseRefused('the manifest sha256 does not match the data file')\n   466\t    for name in ('format', 'allow_list', 'as_of'):\n   467\t        if manifest[name] != data[name]:\n   468\t            raise ReleaseRefused(f'the manifest {name} {manifest[name]!r} differs from the data {data[name]!r}')\n   469\t    if views_db is not None:\n   470\t        bound = expected_as_of if expected_as_of is not None else resolve(views_db, data['as_of'])\n   471\t        counts['fields_compared'] = check_origins(views_db, items_db, data, bound)\n   472\t    return counts, data, len(raw)\n   473\t\n   474\t\n   475\t# ---------- the report\n   476\t\n   477\tdef withheld_unresolved(views_db, data):\n   478\t    \"\"\"For the release report only: the number questions whose ladder does not resolve to bands, with the reason and whether the\n   479\t    view has a key. Withheld like every number question; this list never enters the package.\"\"\"\n   480\t    out = []\n   481\t    for question in data['questions']:\n   482\t        if question['class'] != 'number':\n   483\t            continue\n   484\t        bands, reason = service.ladder_bands(store.rungs_of(views_db, question['id']))\n   485\t        if bands is None:\n   486\t            out.append({'id': question['id'], 'reason': reason, 'has_key': key_measure(views_db, question['id'], data['as_of']) is not None})\n   487\t    return out\n     1\t\"\"\"Build or check the \"Forecast unavailable\" release package (docs/research/2026-11-22-number-answers/RELEASE-BUILD.md).\n     2\t\n     3\t    release_build.py build --ledger <views.sqlite> --items <items.sqlite> [--as-of YYYY-MM-DD] --out <folder>\n     4\t    release_build.py check <folder> --ledger <views.sqlite> --items <items.sqlite>\n     5\t\n     6\tNo model or network call; both stores are read only. The package is checked in a private staging folder against the stores before\n     7\tone atomic move publishes it, and neither the package nor the report ever replaces an existing path. Exit statuses: 0 done; 1\n     8\trefused, with nothing published by this command; 2 the package is published (build) or passes (check) but the report name is taken\n     9\tor the report could not be written.\n    10\t\"\"\"\n    11\timport argparse\n    12\timport json\n    13\timport os\n    14\timport shutil\n    15\timport sys\n    16\timport time\n    17\tfrom pathlib import Path\n    18\t\n    19\tROOT = Path(__file__).resolve().parents[1]\n    20\tsys.path.insert(0, str(ROOT / 'src'))\n    21\tfrom hivemind import release, service  # noqa: E402\n    22\tfrom hivemind.views import store  # noqa: E402\n    23\t\n    24\t\n    25\tdef report_path(out):\n    26\t    return out.with_name(out.name + '.report.json')\n    27\t\n    28\t\n    29\tdef write_report(report, path):\n    30\t    \"\"\"Print the report, then publish it: 0 when it is published (naming any temporary file left behind), 2 when it is not.\"\"\"\n    31\t    print(json.dumps(report, ensure_ascii=False, indent=1))\n    32\t    try:\n    33\t        leftover = release.publish_report(report, path)\n    34\t    except OSError as error:\n    35\t        print(f'report not written ({error}); run check to write it', file=sys.stderr)\n    36\t        return 2\n    37\t    print(f'report: {path}')\n    38\t    if leftover:\n    39\t        print(f'report published; its temporary file {leftover} could not be removed', file=sys.stderr)\n    40\t    return 0\n    41\t\n    42\t\n    43\tdef build(args):\n    44\t    out = Path(args.out).absolute()\n    45\t    report = report_path(out)\n    46\t    for path in (out, report):\n    47\t        if os.path.lexists(path):\n    48\t            print(f'refused: {path} exists', file=sys.stderr)\n    49\t            return 1\n    50\t    started = time.monotonic()\n    51\t    staged = views_db = items_db = None\n    52\t    try:\n    53\t        views_db = service.open_ledger(str(release.store_path(args.ledger)))\n    54\t        items_db = store.open_read_only(str(release.store_path(args.items)))\n    55\t        bound = release.resolve(views_db, args.as_of)\n    56\t        staged = release.stage(out)\n    57\t        data = release.release_export(views_db, items_db, bound)\n    58\t        export_seconds = time.monotonic() - started\n    59\t        release.write_package(data, staged)\n    60\t        checked = time.monotonic()\n    61\t        counts, data, size = release.check_package(staged, views_db, items_db, expected_as_of=bound)\n    62\t        unresolved = release.withheld_unresolved(views_db, data)\n    63\t        check_seconds = time.monotonic() - checked\n    64\t        release.publish(staged, out)\n    65\t        staged = None                       # published: this build no longer owns the staging name\n    66\t    except Exception as error:              # any failure before publication: nothing at --out from this build\n    67\t        print(f'refused: {type(error).__name__}: {error}', file=sys.stderr)\n    68\t        return 1\n    69\t    finally:\n    70\t        if staged is not None:\n    71\t            shutil.rmtree(staged)\n    72\t        for conn in (views_db, items_db):\n    73\t            if conn is not None:\n    74\t                conn.close()\n    75\t    print(f'published {out}: {counts}')\n    76\t    summary = {'ledger': str(args.ledger), 'items': str(args.items), 'as_of': bound, 'counts': counts,\n    77\t               'withheld_unresolved': unresolved, 'data_bytes': size,\n    78\t               'export_seconds': round(export_seconds, 2), 'check_seconds': round(check_seconds, 2)}\n    79\t    return write_report(summary, report)\n    80\t\n    81\t\n    82\tdef check(args):\n    83\t    out = Path(args.package).absolute()\n    84\t    views_db = items_db = None\n    85\t    try:\n    86\t        views_db = service.open_ledger(str(release.store_path(args.ledger)))\n    87\t        items_db = store.open_read_only(str(release.store_path(args.items)))\n    88\t        started = time.monotonic()\n    89\t        counts, data, size = release.check_package(out, views_db, items_db)\n    90\t        check_seconds = time.monotonic() - started\n    91\t        unresolved = release.withheld_unresolved(views_db, data)\n    92\t    except Exception as error:\n    93\t        print(f'refused: {type(error).__name__}: {error}', file=sys.stderr)\n    94\t        return 1\n    95\t    finally:\n    96\t        for conn in (views_db, items_db):\n    97\t            if conn is not None:\n    98\t                conn.close()\n    99\t    print(f'passes {out}: {counts}')\n   100\t    summary = {'ledger': str(args.ledger), 'items': str(args.items), 'as_of': data['as_of'], 'counts': counts,\n   101\t               'withheld_unresolved': unresolved, 'data_bytes': size,\n   102\t               'export_seconds': None, 'check_seconds': round(check_seconds, 2)}\n   103\t    return write_report(summary, report_path(out))\n   104\t\n   105\t\n   106\tdef main(argv=None):\n   107\t    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)\n   108\t    commands = parser.add_subparsers(dest='command', required=True)\n   109\t    make = commands.add_parser('build')\n   110\t    make.add_argument('--ledger', required=True, type=Path)\n   111\t    make.add_argument('--items', required=True, type=Path)\n   112\t    make.add_argument('--as-of')\n   113\t    make.add_argument('--out', required=True, type=Path)\n   114\t    verify = commands.add_parser('check')\n   115\t    verify.add_argument('package', type=Path)\n   116\t    verify.add_argument('--ledger', required=True, type=Path)\n   117\t    verify.add_argument('--items', required=True, type=Path)\n   118\t    args = parser.parse_args(argv)\n   119\t    return build(args) if args.command == 'build' else check(args)\n   120\t\n   121\t\n   122\tif __name__ == '__main__':\n   123\t    sys.exit(main())\n","exit_code":0,"status":"completed"}}
