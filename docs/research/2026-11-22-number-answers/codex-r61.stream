e\",\n    83\t   \"number misread\",\n    84\t   [\n    85\t    \"F11\"\n    86\t   ],\n    87\t   \"uphold\",\n    88\t   \"uphold\"\n    89\t  ]\n    90\t ],\n    91\t \"split_marks\": [],\n    92\t \"support\": {\n    93\t  \"T02 O/claude v29\": [\n    94\t   \"split\",\n    95\t   [\n    96\t    \"no\",\n    97\t    \"yes\",\n    98\t    \"no\",\n    99\t    \"yes\"\n   100\t   ]\n   101\t  ],\n   102\t  \"T04 P/codex v4\": [\n   103\t   \"yes\",\n   104\t   [\n   105\t    \"yes\",\n   106\t    \"yes\"\n   107\t   ]\n   108\t  ],\n   109\t  \"T04 P/codex v8\": [\n   110\t   \"yes\",\n   111\t   [\n   112\t    \"yes\",\n   113\t    \"yes\"\n   114\t   ]\n   115\t  ],\n   116\t  \"T05 P-v8/claude v8\": [\n   117\t   \"yes\",\n   118\t   [\n   119\t    \"yes\",\n   120\t    \"yes\"\n   121\t   ]\n   122\t  ],\n   123\t  \"T06 S/codex v6\": [\n   124\t   \"no\",\n   125\t   [\n   126\t    \"no\",\n   127\t    \"no\"\n   128\t   ]\n   129\t  ],\n   130\t  \"T07 P-v4/codex v4\": [\n   131\t   \"yes\",\n   132\t   [\n   133\t    \"yes\",\n   134\t    \"yes\"\n   135\t   ]\n   136\t  ],\n   137\t  \"T09 P-v4/claude v4\": [\n   138\t   \"yes\",\n   139\t   [\n   140\t    \"yes\",\n   141\t    \"yes\"\n   142\t   ]\n   143\t  ],\n   144\t  \"T10 S/claude v6\": [\n   145\t   \"split\",\n   146\t   [\n   147\t    \"no\",\n   148\t    \"yes\",\n   149\t    \"no\",\n   150\t    \"yes\"\n   151\t   ]\n   152\t  ],\n   153\t  \"T11 P-v8/codex v8\": [\n   154\t   \"yes\",\n   155\t   [\n   156\t    \"yes\",\n   157\t    \"yes\"\n   158\t   ]\n   159\t  ],\n   160\t  \"T12 O/codex v29\": [\n   161\t   \"yes\",\n   162\t   [\n   163\t    \"no\",\n   164\t    \"yes\",\n   165\t    \"yes\",\n   166\t    \"yes\"\n   167\t   ]\n   168\t  ],\n   169\t  \"T15 E/claude v41\": [\n   170\t   \"yes\",\n   171\t   [\n   172\t    \"yes\",\n   173\t    \"yes\"\n   174\t   ]\n   175\t  ],\n   176\t  \"T16 P/claude v4\": [\n   177\t   \"yes\",\n   178\t   [\n   179\t    \"yes\",\n   180\t    \"yes\"\n   181\t   ]\n   182\t  ],\n   183\t  \"T16 P/claude v8\": [\n   184\t   \"yes\",\n   185\t   [\n   186\t    \"yes\",\n   187\t    \"yes\"\n   188\t   ]\n   189\t  ],\n   190\t  \"T17 E/codex v41\": [\n   191\t   \"no\",\n   192\t   [\n   193\t    \"no\",\n   194\t    \"no\"\n   195\t   ]\n   196\t  ]\n   197\t },\n   198\t \"usable\": {\n   199\t  \"O\": [\n   200\t   \"codex\"\n   201\t  ],\n   202\t  \"P\": [\n   203\t   \"codex\",\n   204\t   \"claude\"\n   205\t  ],\n   206\t  \"P-v8\": [\n   207\t   \"claude\",\n   208\t   \"codex\"\n   209\t  ],\n   210\t  \"S\": [],\n   211\t  \"P-v4\": [\n   212\t   \"codex\",\n   213\t   \"claude\"\n   214\t  ],\n   215\t  \"E\": [\n   216\t   \"claude\"\n   217\t  ]\n   218\t }\n   219\t}     1\t{\n     2\t \"T01\": {\n     3\t  \"case\": \"P\",\n     4\t  \"writer\": \"K-midpoint\",\n     5\t  \"answer\": \"reread2-controls/K-midpoint.json\",\n     6\t  \"figure\": \"F7\"\n     7\t },\n     8\t \"T02\": {\n     9\t  \"case\": \"O\",\n    10\t  \"writer\": \"claude\",\n    11\t  \"answer\": \"O/answers/claude.json\"\n    12\t },\n    13\t \"T03\": {\n    14\t  \"case\": \"E\",\n    15\t  \"writer\": \"K-overlap\",\n    16\t  \"answer\": \"reread2-controls/K-overlap.json\",\n    17\t  \"figure\": \"F8\"\n    18\t },\n    19\t \"T04\": {\n    20\t  \"case\": \"P\",\n    21\t  \"writer\": \"codex\",\n    22\t  \"answer\": \"P/answers/codex.json\"\n    23\t },\n    24\t \"T05\": {\n    25\t  \"case\": \"P-v8\",\n    26\t  \"writer\": \"claude\",\n    27\t  \"answer\": \"P-v8/answers/claude.json\"\n    28\t },\n    29\t \"T06\": {\n    30\t  \"case\": \"S\",\n    31\t  \"writer\": \"codex\",\n    32\t  \"answer\": \"S/answers/codex.json\"\n    33\t },\n    34\t \"T07\": {\n    35\t  \"case\": \"P-v4\",\n    36\t  \"writer\": \"codex\",\n    37\t  \"answer\": \"P-v4/answers/codex.json\"\n    38\t },\n    39\t \"T08\": {\n    40\t  \"case\": \"P\",\n    41\t  \"writer\": \"K-misread\",\n    42\t  \"answer\": \"reread2-controls/K-misread.json\",\n    43\t  \"figure\": \"F7\"\n    44\t },\n    45\t \"T09\": {\n    46\t  \"case\": \"P-v4\",\n    47\t  \"writer\": \"claude\",\n    48\t  \"answer\": \"P-v4/answers/claude.json\"\n    49\t },\n    50\t \"T10\": {\n    51\t  \"case\": \"S\",\n    52\t  \"writer\": \"claude\",\n    53\t  \"answer\": \"S/answers/claude.json\"\n    54\t },\n    55\t \"T11\": {\n    56\t  \"case\": \"P-v8\",\n    57\t  \"writer\": \"codex\",\n    58\t  \"answer\": \"P-v8/answers/codex.json\"\n    59\t },\n    60\t \"T12\": {\n    61\t  \"case\": \"O\",\n    62\t  \"writer\": \"codex\",\n    63\t  \"answer\": \"O/answers/codex.json\"\n    64\t },\n    65\t \"T13\": {\n    66\t  \"case\": \"E\",\n    67\t  \"writer\": \"K-unsupported\",\n    68\t  \"answer\": \"reread2-controls/K-unsupported.json\",\n    69\t  \"figure\": \"F7\"\n    70\t },\n    71\t \"T14\": {\n    72\t  \"case\": \"E\",\n    73\t  \"writer\": \"K-disjoint\",\n    74\t  \"answer\": \"reread2-controls/K-disjoint.json\",\n    75\t  \"figure\": \"F8\"\n    76\t },\n    77\t \"T15\": {\n    78\t  \"case\": \"E\",\n    79\t  \"writer\": \"claude\",\n    80\t  \"answer\": \"E/answers/claude.json\"\n    81\t },\n    82\t \"T16\": {\n    83\t  \"case\": \"P\",\n    84\t  \"writer\": \"claude\",\n    85\t  \"answer\": \"P/answers/claude.json\"\n    86\t },\n    87\t \"T17\": {\n    88\t  \"case\": \"E\",\n    89\t  \"writer\": \"codex\",\n    90\t  \"answer\": \"E/answers/codex.json\"\n    91\t }\n    92\t}","exit_code":0,"status":"completed"}}
