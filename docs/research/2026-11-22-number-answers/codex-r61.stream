ate-run7.fixtures.json\ngate-run7.txt\ngate-run8.fixtures.json\ngate-run8.txt\ngate-run9.fixtures.json\ngate-run9.txt\ngate.py\npaid-mutants.log\npaid-plan.json\npaid-plan.sha256\npaid_gate.py\npaid_mutants.py\npaid_rehearsal.py\nround60-brief.md\n","exit_code":0,"status":"completed"}}
