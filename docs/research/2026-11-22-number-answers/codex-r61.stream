"rests_on\": null,\n   114\t      \"outcome_for\": [],\n   115\t      \"reference_for\": []\n   116\t    },\n   117\t    {\n   118\t      \"id\": \"F7\",\n   119\t      \"what\": {\"population\": \"Microsoft\", \"measure\": \"Azure contracted backlog\", \"scope\": \"Azure cloud platform\", \"period\": \"end of FY2026\"},\n   120\t      \"kind\": \"source\",\n   121\t      \"basis\": \"reported\",\n   122\t      \"value\": 678,\n   123\t      \"low\": null,\n   124\t      \"high\": null,\n   125\t      \"unit\": \"USD bn\",\n   126\t      \"evidence_id\": \"e4405\",\n   127\t      \"quote_number\": \"$678 billion\",\n   128\t      \"qualifier\": \"none\",\n   129\t      \"inputs\": null,\n   130\t      \"operation\": null,\n   131\t      \"basis_text\": null,\n   132\t      \"rests_on\": null,\n   133\t      \"outcome_for\": [],\n   134\t      \"reference_for\": []\n   135\t    },\n   136\t    {\n   137\t      \"id\": \"F8\",\n   138\t      \"what\": {\"population\": \"Amazon, Alphabet, Microsoft and Meta Platforms\", \"measure\": \"capital expenditure\", \"scope\": \"combined\", \"period\": \"CY2026\"},\n   139\t      \"kind\": \"source\",\n   140\t      \"basis\": \"third_party\",\n   141\t      \"value\": null,\n   142\t      \"low\": 720,\n   143\t      \"high\": 745,\n   144\t      \"unit\": \"USD bn\",\n   145\t      \"evidence_id\": \"e5014\",\n   146\t      \"quote_number\": \"$720 billion to $745 billion\",\n   147\t      \"qualifier\": \"roughly\",\n   148\t      \"inputs\": null,\n   149\t      \"operation\": null,\n   150\t      \"basis_text\": null,\n   151\t      \"rests_on\": null,\n   152\t      \"outcome_for\": [],\n   153\t      \"reference_for\": [\"v6\"]\n   154\t    },\n   155\t    {\n   156\t      \"id\": \"F9\",\n   157\t      \"what\": {\"population\": \"Microsoft\", \"measure\": \"capital expenditure\", \"scope\": \"implied by the four-company tally less the three guided companies\", \"period\": \"CY2026\"},\n   158\t      \"kind\": \"computed\",\n   159\t      \"basis\": \"third_party\",\n   160\t      \"value\": null,\n   161\t      \"low\": 150,\n   162\t      \"high\": 205,\n   163\t      \"unit\": \"USD bn\",\n   164\t      \"evidence_id\": null,\n   165\t      \"quote_number\": null,\n   166\t      \"qualifier\": null,\n   167\t      \"inputs\": [\"F8\", \"F4\"],\n   168\t      \"operation\": \"difference\",\n   169\t      \"basis_text\": null,\n   170\t      \"rests_on\": null,\n   171\t      \"outcome_for\": [],\n   172\t      \"reference_for\": []\n   173\t    },\n   174\t    {\n   175\t      \"id\": \"F10\",\n   176\t      \"what\": {\"population\": \"Microsoft\", \"measure\": \"capital expenditure\", \"scope\": \"total\", \"period\": \"CY2026\"},\n   177\t      \"kind\": \"estimate\",\n   178\t      \"basis\": \"forecast\",\n   179\t      \"value\": 165,\n   180\t      \"low\": null,\n   181\t      \"high\": null,\n   182\t      \"unit\": \"USD bn\",\n   183\t      \"evidence_id\": null,\n   184\t      \"quote_number\": null,\n   185\t      \"qualifier\": null,\n   186\t      \"inputs\": null,\n   187\t      \"operation\": null,\n   188\t      \"basis_text\": \"My estimate of Microsoft's calendar-2026 capital expenditure; no calendar-year guidance is shown. The January-March 2026 quarter (fiscal Q3) was $30.88bn, up 84% from a year earlier (F5, F6). A continued sequential rise of about 16% a quarter, the pace that compounds to roughly 84% over a year and is supported by the $678bn Azure backlog (F7), gives about 30.9 + 35.8 + 41.6 + 48.2 = $156bn; the four-company tally less the three guided companies implies $150-205bn (F9). $165bn follows the run-rate path and moves partway into the tally-implied range, staying in its lower part because the run-rate is the only Microsoft-specific number.\",\n   189\t      \"rests_on\": [\"F5\", \"F6\", \"F7\", \"F9\"],\n   190\t      \"outcome_for\": [],\n   191\t      \"reference_for\": []\n   192\t    },\n   193\t    {\n   194\t      \"id\": \"F11\",\n   195\t      \"what\": {\"population\": \"four largest AI hyperscalers\", \"measure\": \"capital expenditure\", \"scope\": \"combined\", \"period\": \"CY2026\"},\n   196\t      \"kind\": \"computed\",\n   197\t      \"basis\": \"forecast\",\n   198\t      \"value\": 720,\n   199\t      \"low\": null,\n   200\t      \"high\": null,\n   201\t      \"unit\": \"USD bn\",\n   202\t      \"evidence_id\": null,\n   203\t      \"quote_number\": null,\n   204\t      \"qualifier\": null,\n   205\t      \"inputs\": [\"F4\", \"F10\"],\n   206\t      \"operation\": \"sum\",\n   207\t      \"basis_text\": null,\n   208\t      \"rests_on\": null,\n   209\t      \"outcome_for\": [],\n   210\t      \"reference_for\": []\n   211\t    },\n   212\t    {\n   213\t      \"id\": \"F12\",\n   214\t      \"what\": {\"population\": \"Amazon, Meta Platforms, Microsoft and Alphabet\", \"measure\": \"AI infrastructure spending\", \"scope\": \"combined\", \"period\": \"CY2026\"},\n   215\t      \"kind\": \"source\",\n   216\t      \"basis\": \"guidance\",\n   217\t      \"value\": 730,\n   218\t      \"low\": null,\n   219\t      \"high\": null,\n   220\t      \"unit\": \"USD bn\",\n   221\t      \"evidence_id\": \"e1947\",\n   222\t      \"quote_number\": \"$730 billion\",\n   223\t      \"qualifier\": \"more than\",\n   224\t      \"inputs\": null,\n   225\t      \"operation\": null,\n   226\t      \"basis_text\": null,\n   227\t      \"rests_on\": null,\n   228\t      \"outcome_for\": [],\n   229\t      \"reference_for\": []\n   230\t    },\n   231\t    {\n   232\t      \"id\": \"F13\",\n   233\t      \"what\": {\"population\": \"Meta Platforms\", \"measure\": \"AI capital expenditure\", \"scope\": \"total\", \"period\": \"CY2026\"},\n   234\t      \"kind\": \"source\",\n   235\t      \"basis\": \"third_party\",\n   236\t      \"value\": 130,\n   237\t      \"low\": null,\n   238\t      \"high\": null,\n   239\t      \"unit\": \"USD bn\",\n   240\t      \"evidence_id\": \"e3686\",\n   241\t      \"quote_number\": \"$130 billion\",\n   242\t      \"qualifier\": \"none\",\n   243\t      \"inputs\": null,\n   244\t      \"operation\": null,\n   245\t      \"basis_text\": null,\n   246\t      \"rests_on\": null,\n   247\t      \"outcome_for\": [],\n   248\t      \"reference_for\": []\n   249\t    },\n   250\t    {\n   251\t      \"id\": \"F14\",\n   252\t      \"what\": {\"population\": \"four largest AI hyperscalers\", \"measure\": \"data-center share of capital expenditure\", \"scope\": \"combined\", \"period\": \"CY2026\"},\n   253\t      \"kind\": \"estimate\",\n   254\t      \"basis\": \"forecast\",\n   255\t      \"value\": 98,\n   256\t      \"low\": null,\n   257\t      \"high\": null,\n   258\t      \"unit\": \"%\",\n   259\t      \"evidence_id\": null,\n   260\t      \"quote_number\": null,\n   261\t      \"qualifier\": null,\n   262\t      \"inputs\": null,\n   263\t      \"operation\": null,\n   264\t      \"basis_text\": \"My estimate of the share of the four companies' 2026 capital expenditure that is data-center (AI infrastructure) spending. The companies' indicated AI-infrastructure total, more than $730bn (F12), is at or above the total-capex tally of $720-745bn (F8), which puts the share near 100%; Meta's planned AI capex of $130bn (F13) sits inside its $125-145bn total guidance (F2), about 96% of the midpoint; Amazon's raise to $220bn was mostly memory-chip costs, i.e. server hardware (e1649); outside estimates put spending on data centers at about $750bn (e1416, e4082). No passage sizes non-data-center spending such as offices or logistics, so I keep a 2% residual; the passages bound the share between about 96% and 100%.\",\n   265\t      \"rests_on\": [\"F12\", \"F8\", \"F13\", \"F2\", \"e1649\", \"e1416\", \"e4082\"],\n   266\t      \"outcome_for\": [],\n   267\t      \"reference_for\": []\n   268\t    },\n   269\t    {\n   270\t      \"id\": \"F15\",\n   271\t      \"what\": {\"population\": \"four largest AI hyperscalers\", \"measure\": \"data-center capex\", \"scope\": \"combined\", \"period\": \"CY2026\"},\n   272\t      \"kind\": \"computed\",\n   273\t      \"basis\": \"forecast\",\n   274\t      \"value\": 705.6,\n   275\t      \"low\": null,\n   276\t      \"high\": null,\n   277\t      \"unit\": \"USD bn\",\n   278\t      \"evidence_id\": null,\n   279\t      \"quote_number\": null,\n   280\t      \"qualifier\": null,\n   281\t      \"inputs\": [\"F11\", \"F14\"],\n   282\t      \"operation\": \"share\",\n   283\t      \"basis_text\": null,\n   284\t      \"rests_on\": null,\n   285\t      \"outcome_for\": [\"v6\"],\n   286\t      \"reference_for\": []\n   287\t    },\n   288\t    {\n   289\t      \"id\": \"F16\",\n   290\t      \"what\": {\"population\": \"four largest hyperscalers\", \"measure\": \"capital expenditure\", \"scope\": \"combined\", \"period\": \"CY2026\"},\n   291\t      \"kind\": \"source\",\n   292\t      \"basis\": \"third_party\",\n   293\t      \"value\": 745,\n   294\t      \"low\": null,\n   295\t      \"high\": null,\n   296\t      \"unit\": \"USD bn\",\n   297\t      \"evidence_id\": \"e1856\",\n   298\t      \"quote_number\": \"$745 billion\",\n   299\t      \"qualifier\": \"near\",\n   300\t      \"inputs\": null,\n   301\t      \"operation\": null,\n   302\t      \"basis_text\": null,\n   303\t      \"rests_on\": null,\n   304\t      \"outcome_for\": [],\n   305\t      \"reference_for\": []\n   306\t    },\n   307\t    {\n   308\t      \"id\": \"F17\",\n   309\t      \"what\": {\"population\": \"top four hyperscalers\", \"measure\": \"capital expenditure\", \"scope\": \"combined\", \"period\": \"CY2026\"},\n   310\t      \"kind\": \"source\",\n   311\t      \"basis\": \"third_party\",\n   312\t      \"value\": 760,\n   313\t      \"low\": null,\n   314\t      \"high\": null,\n   315\t      \"unit\": \"USD bn\",\n   316\t      \"evidence_id\": \"e2458\",\n   317\t      \"quote_number\": \"$760 billion\",\n   318\t      \"qualifier\": \"none\",\n   319\t      \"inputs\": null,\n   320\t      \"operation\": null,\n   321\t      \"basis_text\": null,\n   322\t      \"rests_on\": null,\n   323\t      \"outcome_for\": [],\n   324\t      \"reference_for\": []\n   325\t    },\n   326\t    {\n   327\t      \"id\": \"F18\",\n   328\t      \"what\": {\"population\": \"tech giants\", \"measure\": \"data-center spending\", \"scope\": \"combined\", \"period\": \"CY2026\"},\n   329\t      \"kind\": \"source\",\n   330\t      \"basis\": \"third_party\",\n   331\t      \"value\": 750,\n   332\t      \"low\": null,\n   333\t      \"high\": null,\n   334\t      \"unit\": \"USD bn\",\n   335\t      \"evidence_id\": \"e1416\",\n   336\t      \"quote_number\": \"$750 billion\",\n   337\t      \"qualifier\": \"estimated\",\n   338\t      \"inputs\": null,\n   339\t      \"operation\": null,\n   340\t      \"basis_text\": null,\n   341\t      \"rests_on\": null,\n   342\t      \"outcome_for\": [],\n   343\t      \"reference_for\": []\n   344\t    },\n   345\t    {\n   346\t      \"id\": \"F19\",\n   347\t      \"what\": {\"population\": \"top five hyperscalers\", \"measure\": \"capital expenditure\", \"scope\": \"combined\", \"period\": \"CY2026\"},\n   348\t      \"kind\": \"source\",\n   349\t      \"basis\": \"third_party\",\n   350\t      \"value\": 800,\n   351\t      \"low\": null,\n   352\t      \"high\": null,\n   353\t      \"unit\": \"USD bn\",\n   354\t      \"evidence_id\": \"e2759\",\n   355\t      \"quote_number\": \"$800 billion\",\n   356\t      \"qualifier\": \"nearly\",\n   357\t      \"inputs\": null,\n   358\t      \"operation\": null,\n   359\t      \"basis_text\": null,\n   360\t      \"rests_on\": null,\n   361\t      \"outcome_for\": [],\n   362\t      \"reference_for\": []\n   363\t    },\n   364\t    {\n   365\t      \"id\": \"F20\",\n   366\t      \"what\": {\"population\": \"Microsoft, Alphabet, Amazon, Meta and Oracle\", \"measure\": \"capital expenditure\", \"scope\": \"combined\", \"period\": \"CY2026\"},\n   367\t      \"kind\": \"source\",\n   368\t      \"basis\": \"third_party\",\n   369\t      \"value\": 795,\n   370\t      \"low\": null,\n   371\t      \"high\": null,\n   372\t      \"unit\": \"USD bn\",\n   373\t      \"evidence_id\": \"e5055\",\n   374\t      \"quote_number\": \"$795 billion\",\n   375\t      \"qualifier\": \"roughly\",\n   376\t      \"inputs\": null,\n   377\t      \"operation\": null,\n   378\t      \"basis_text\": null,\n   379\t      \"rests_on\": null,\n   380\t      \"outcome_for\": [],\n   381\t      \"reference_for\": []\n   382\t    }\n   383\t  ],\n   384\t  \"answers\": [\n   385\t    {\n   386\t      \"view_id\": \"v6\",\n   387\t      \"shape\": \"forecast\",\n   388\t      \"rung\": 4,\n   389\t      \"reference_unavailable\": null,\n   390\t      \"reasons\": \"Reference: outside tallies put the four companies' combined 2026 capital spending at roughly $720-745bn (Zacks, e5014; about $745bn tracking, e1856), inside rung 4 ($700-800bn). Build: the three companies with full-year guidance add to $540-570bn (F4): Alphabet $195-205bn after raising from $180-190bn (e1254), Meta $125-145bn after a raise (e1549), Amazon $220bn after raising from $200bn (e1649). Microsoft gives no calendar-year guidance in the evidence; its January-March 2026 quarter was $30.88bn, up 84% (e922), and a continued ramp of about 16% a quarter gives about $156bn, while the tally less the other three implies $150-205bn; I use $165bn (F10, my estimate). Total capital expenditure is therefore about $720bn (F11; $705-735bn across the guidance ranges). The question asks for data-center spending, which is narrower than total capex, so I apply a 98% data-center share (F14, my estimate): the companies indicated more than $730bn of AI-infrastructure spending (e1947), at or above the total tally; Meta's $130bn of AI capex (e3686) sits inside its $125-145bn guidance; Amazon's raise was mostly memory chips; outside estimates put spending on data centers near $750bn (e1416, e4082). The share is bounded at about 96-100% by these passages, giving data-center capex of about $706bn (F15), rung 4; the supported floor from e1947 (more than $730bn of AI infrastructure) also lies in rung 4. Rung 5 is not supported: the $795-800bn figures (NVIDIA, e2759; BofA, e5055) cover five companies, Oracle among them in BofA's list, so the four sit below $800bn, and the highest four-company tally is $760bn (e2458). Pushing up: three mid-year guidance raises, rising memory costs that lift the dollar cost of the same build (e1649), and strong cloud demand (Azure backlog $678bn, e4405; Google Cloud +82%, e4406; AWS's best quarter in four years, e4404). Pushing down: about $130bn of US data-center projects blocked or delayed this year (e122, not specific to these four), and grid-connection and electrician constraints (e5292, e1545); the memory shortage (e4566) limits volume but raises price, so it cuts both ways. The forecast sits close to the $700bn edge, so the main risk is rung 3 if Microsoft's ramp or the data-center share comes in lower; the repeated raises make an undershoot of guidance less likely. The many reprints of NVIDIA's top-five figure count as one claim (e4564's '$1.3 billion' for 2027 is a misprint of $1.3 trillion).\",\n   391\t      \"why\": null,\n   392\t      \"cites\": [\"e5014\", \"e1856\", \"e1254\", \"e1549\", \"e1649\", \"e922\", \"e4405\", \"e1947\", \"e3686\", \"e1416\", \"e4082\", \"e2458\", \"e2759\", \"e5055\", \"e4406\", \"e4404\", \"e122\", \"e5292\", \"e1545\", \"e4566\"],\n   393\t      \"pushes\": [\n   394\t        {\"evidence_id\": \"e1254\", \"push\": \"toward_last\"},\n   395\t        {\"evidence_id\": \"e1549\", \"push\": \"toward_last\"},\n   396\t        {\"evidence_id\": \"e1649\", \"push\": \"toward_last\"},\n   397\t        {\"evidence_id\": \"e922\", \"push\": \"toward_last\"},\n   398\t        {\"evidence_id\": \"e5014\", \"push\": \"toward_last\"},\n   399\t        {\"evidence_id\": \"e1856\", \"push\": \"toward_last\"},\n   400\t        {\"evidence_id\": \"e1947\", \"push\": \"toward_last\"},\n   401\t        {\"evidence_id\": \"e2458\", \"push\": \"toward_last\"},\n   402\t        {\"evidence_id\": \"e1416\", \"push\": \"toward_last\"},\n   403\t        {\"evidence_id\": \"e4082\", \"push\": \"toward_last\"},\n   404\t        {\"evidence_id\": \"e2759\", \"push\": \"toward_last\"},\n   405\t        {\"evidence_id\": \"e5055\", \"push\": \"toward_last\"},\n   406\t        {\"evidence_id\": \"e4405\", \"push\": \"toward_last\"},\n   407\t        {\"evidence_id\": \"e4406\", \"push\": \"toward_last\"},\n   408\t        {\"evidence_id\": \"e4404\", \"push\": \"toward_last\"},\n   409\t        {\"evidence_id\": \"e3686\", \"push\": \"none\"},\n   410\t        {\"evidence_id\": \"e122\", \"push\": \"toward_first\"},\n   411\t        {\"evidence_id\": \"e5292\", \"push\": \"toward_first\"},\n   412\t        {\"evidence_id\": \"e1545\", \"push\": \"toward_first\"},\n   413\t        {\"evidence_id\": \"e4566\", \"push\": \"none\"},\n   414\t        {\"evidence_id\": \"e2079\", \"push\": \"none\"},\n   415\t        {\"evidence_id\": \"e4790\", \"push\": \"none\"},\n   416\t        {\"evidence_id\": \"e4567\", \"push\": \"none\"},\n   417\t        {\"evidence_id\": \"e5081\", \"push\": \"none\"},\n   418\t        {\"evidence_id\": \"e5105\", \"push\": \"none\"},\n   419\t        {\"evidence_id\": \"e5114\", \"push\": \"none\"},\n   420\t        {\"evidence_id\": \"e5358\", \"push\": \"none\"},\n   421\t        {\"evidence_id\": \"e5376\", \"push\": \"none\"},\n   422\t        {\"evidence_id\": \"e4766\", \"push\": \"none\"},\n   423\t        {\"evidence_id\": \"e4514\", \"push\": \"none\"},\n   424\t        {\"evidence_id\": \"e4564\", \"push\": \"none\"},\n   425\t        {\"evidence_id\": \"e5170\", \"push\": \"none\"},\n   426\t        {\"evidence_id\": \"e2081\", \"push\": \"none\"},\n   427\t        {\"evidence_id\": \"e4807\", \"push\": \"none\"},\n   428\t        {\"evidence_id