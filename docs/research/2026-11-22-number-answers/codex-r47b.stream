f expected(self, it, user):\n96:    def __call__(self, http_request, *args, **kwargs):\n132:def scenario(scratch, name, ceiling=0.5):\n162:def main(scratch):\n166:    def check(name, ok, detail=''):\n184:    def card(usable='yes', gap='no', drop=None, b_differs=None, third=None):\n198:    def readings(good_separate, defect_arm=None, drop_packet=False, bad_card=False, missing_ground=False, disagree=None):\n220:    def verdict_of(rd, name):\n","exit_code":0,"status":"completed"}}
