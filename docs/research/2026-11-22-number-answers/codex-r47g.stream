{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba paid_gate.py | sed -n '146,254p;553,622p;649,733p'\"","aggregated_output":"   146\t\n   147\t    def request(self, it, user):\n   148\t        return model.build_request(self.cfg.rejudging, it['system'], user, it['schema'], 'judgement', self.cfg.provider)\n   149\t\n   150\t    def record(self, line):\n   151\t        with self.lock, open(self.out / 'answers.jsonl', 'a') as handle:\n   152\t            handle.write(json.dumps(line, ensure_ascii=False) + '\\n')\n   153\t\n   154\t    def attempt(self, it, draw, user, n):\n   155\t        name = f'{it[\"unit\"]}-{it[\"arm\"]}-d{draw}-a{n}.sqlite'\n   156\t        archive = model.Archive(str(self.out / 'archives' / name))\n   157\t        line = {'unit': it['unit'], 'arm': it['arm'], 'draw': draw, 'attempt': n,\n   158\t                'request_sha256': model.request_identity(self.request(it, user))[1]}\n   159\t        self.record(dict(line, status='started'))                          # [47.3] recorded before the provider is called\n   160\t        data = None\n   161\t        try:\n   162\t            answer = model.call(archive, self.cfg, self.cfg.rejudging, it['system'], user, it['schema'], 'judgement', 'judge', transport=self.transport)\n   163\t            data = answer.data\n   164\t            line.update(cost_usd=answer.cost_usd, data=data)\n   165\t            calc = strip(data)\n   166\t            result = cc.check(it['family'], it['passages'], calc)\n   167\t            decision = cc.publish_decision(it['family'], calc, result)\n   168\t            line.update(status='answered', errors=result['errors'], recorded=result['recorded'], published=result.get('published'), decision=decision)\n   169\t        except model.SchemaError as error:\n   170\t            row = archive.conn.execute('select response_json from model_calls order by call_id desc limit 1').fetchone()\n   171\t            line.update(status='format invalid', error=str(error)[:500], decision='refused', errors=[('schema', str(error)[:300])],\n   172\t                        raw=row[0] if row and row[0] else None)           # [47f.2] whole, as the archive stores it\n   173\t        except model.TransportError as error:\n   174\t            line.update(status='transport error', error=str(error)[:500], decision='transport')\n   175\t        except Exception as error:                                       # [47.3] a checker failure is recorded with the raw answer and refused\n   176\t            line.update(status='checker error', error=f'{type(error).__name__}: {error}'[:500], decision='refused',\n   177\t                        errors=[('checker', f'{type(error).__name__}: {error}'[:300])], data=data)\n   178\t        self.record(line)\n   179\t        return line\n   180\t\n   181\t    def stopped(self):\n   182\t        return self.ledger is not None and self.ledger.read().get('stopped')\n   183\t\n   184\t    def run(self, items):\n   185\t        \"\"\"[47f.1] Every first attempt (the scored ones) is sent before any retry (diagnostic only), so a retry's cost or failure can\n   186\t        never stop a scored attempt from being sent.\"\"\"\n   187\t        try:\n   188\t            refused = []\n   189\t            for draw in DRAWS:\n   190\t                for it in items:\n   191\t                    if not self.stopped():\n   192\t                        first = self.attempt(it, draw, it['user'], 1)\n   193\t                        if first['decision'] == 'refused':\n   194\t                            refused.append((it, draw, first))\n   195\t            for it, draw, first in refused:\n   196\t                if not self.stopped():\n   197\t                    reasons = '; '.join(f'{c}: {d}' for c, d in first.get('errors', []))[:4000]\n   198\t                    self.attempt(it, draw, it['user'] + RETRY_MARK + reasons, 2)\n   199\t        finally:                                          # [47b.2] the results come from the attempt records, written even after an abort\n   200\t            summary = summarise(self.out, items, self.ledger.read() if self.ledger else None)\n   201\t        return summary\n   202\t\n   203\t\n   204\tdef attempt_records(out, damaged=None):\n   205\t    \"\"\"The committed journal entries. A line that does not parse (a write torn by a crash) is skipped and listed in `damaged`, so its\n   206\t    attempt counts as unfinished and the run as incomplete.\"\"\"\n   207\t    path = out / 'answers.jsonl'\n   208\t    records = []\n   209\t    for number, text in enumerate(path.read_text(errors='replace').splitlines() if path.exists() else [], 1):\n   210\t        try:\n   211\t            records.append(json.loads(text))\n   212\t        except json.JSONDecodeError:\n   213\t            if damaged is not None:\n   214\t                damaged.append({'line': number, 'text': text[:200]})\n   215\t    return records\n   216\t\n   217\t\n   218\tATTEMPT_FIELDS = ('attempt', 'status', 'decision', 'errors', 'data', 'raw')\n   219\t\n   220\t\n   221\tdef first_attempt(entry):\n   222\t    \"\"\"[47e.1] The attempt that is scored: the first one, on both arms (a retry is diagnostic). No attempt: not sent.\"\"\"\n   223\t    attempts = sorted(entry.get('attempts') or [], key=lambda a: a['attempt'])\n   224\t    return attempts[0] if attempts else {'attempt': 1, 'status': 'not sent', 'decision': 'not sent'}\n   225\t\n   226\t\n   227\tdef derive_finals(out, items, damaged=None):\n   228\t    \"\"\"Each planned unit and draw: 'dispatched' (a started line), 'completed' (a finished line), and the decision of its last finished\n   229\t    attempt (a second refusal is unresolved). A unit with no started line is not sent; one started but not finished is interrupted.\"\"\"\n   230\t    records = attempt_records(out, damaged)\n   231\t    finals = {}\n   232\t    for it in items:\n   233\t        for draw in DRAWS:\n   234\t            mine = [r for r in records if r['unit'] == it['unit'] and r['arm'] == it['arm'] and r['draw'] == draw]\n   235\t            started = [r for r in mine if r['status'] == 'started']\n   236\t            done = [r for r in mine if r['status'] != 'started']\n   237\t            key = f'{it[\"unit\"]}|{it[\"arm\"]}|{draw}'\n   238\t            if not started:\n   239\t                finals[key] = {'decision': 'not sent', 'attempts': []}\n   240\t                continue\n   241\t            if len(done) < len(started):\n   242\t                unfinished = [{'attempt': r['attempt'], 'status': 'interrupted', 'decision': 'interrupted'} for r in started\n   243\t                              if r['attempt'] not in {d['attempt'] for d in done}]\n   244\t                finals[key] = {'decision': 'interrupted', 'attempts': [{k: r.get(k) for k in ATTEMPT_FIELDS} for r in done] + unfinished}\n   245\t                continue\n   246\t            last = done[-1]\n   247\t            decision = last['decision']\n   248\t            if decision == 'refused':                          # a second refusal is unresolved; a first with no retry sent is incomplete\n   249\t                decision = 'unresolved' if len(done) >= 2 else 'retry not sent'\n   250\t            finals[key] = {k: last.get(k) for k in ('status', 'data', 'errors', 'recorded', 'published')}\n   251\t            finals[key].update(decision=decision, attempts=[{k: r.get(k) for k in ATTEMPT_FIELDS} for r in done])\n   252\t    return finals\n   253\t\n   254\t\n   553\tdef returned_text(raw):\n   554\t    \"\"\"The model's text inside a stored provider response, or the stored response itself when it cannot be read.\"\"\"\n   555\t    if not raw:\n   556\t        return '(no text was stored)'\n   557\t    try:\n   558\t        message = json.loads(raw)['choices'][0]['message']\n   559\t    except (ValueError, KeyError, IndexError, TypeError):\n   560\t        return str(raw)\n   561\t    if not isinstance(message, dict):\n   562\t        return str(raw)\n   563\t    if isinstance(message.get('content'), str):\n   564\t        return message['content']\n   565\t    if message.get('refusal'):\n   566\t        return f'(the model refused: {message[\"refusal\"]})'\n   567\t    return f'(no text returned: {json.dumps(message, ensure_ascii=False)})'\n   568\t\n   569\t\n   570\tdef render_attempts(out, labels):\n   571\t    \"\"\"[47d.3, 47e.3] For diagnostic reading only, never scored: every retry and every returned text that failed the format check, each\n   572\t    under its own shuffled label (D01..), with the question, that attempt's own answer (or the text returned and the passages it names),\n   573\t    and no link to a packet.\"\"\"\n   574\t    results = json.loads((out / 'results.json').read_text())\n   575\t    items = {(i['unit'], i['arm']): i for i in json.loads((out / 'plan.json').read_text())}\n   576\t    lines = []\n   577\t    for label, (unit, arm, draw, v, attempt) in labels:\n   578\t        entry = results['finals'][f'{unit}|{arm}|{draw}']\n   579\t        a = next(x for x in entry['attempts'] if x['attempt'] == attempt)\n   580\t        base = items[(unit, 'joint' if unit.startswith('pair') else 'single')]\n   581\t        fam = base['family'] if arm in ('joint', 'single') else only(base['family'], v)\n   582\t        lines.append(f'## {label}: {base[\"questions\"][v][\"question\"]}')\n   583\t        if a.get('status') == 'format invalid':\n   584\t            returned = returned_text(a.get('raw'))\n   585\t            named = sorted(set(re.findall(r'\\be\\d+\\b', returned)) & set(base['shown']))\n   586\t            lines.append(f'  {FORMAT_INVALID} The text returned:\\n' + '\\n'.join('    ' + l for l in returned.splitlines()))\n   587\t            if named:\n   588\t                lines.append('  Passages it names, as the request showed them:\\n' + '\\n'.join('  ' + base['shown'][e] for e in named))\n   589\t            continue\n   590\t        lines += card_lines(base, fam, v, 'K1', a.get('data'), NO_ANSWER.get(a.get('decision'), NO_ANSWER['transport']), 'T.')[0]\n   591\t    return '\\n'.join(lines)\n   592\t\n   593\t\n   594\tdef packets(out, key_dir):\n   595\t    if (key_dir / 'packet-key.json').exists():            # [47b.4] the inventory and key are frozen once made\n   596\t        raise SystemExit(f'{key_dir / \"packet-key.json\"} exists: the packets are frozen; refused')\n   597\t    results = json.loads((out / 'results.json').read_text())\n   598\t    items = {(i['unit'], i['arm']): i for i in json.loads((out / 'plan.json').read_text())}\n   599\t    rng = random.Random(secrets.randbits(64))\n   600\t    unit_keys = sorted(packet_units(results, items))\n   601\t    rng.shuffle(unit_keys)\n   602\t    earlier = sorted((k.split('|')[0], k.split('|')[1], k.split('|')[2], v, a['attempt'])     # every retry, and every format failure\n   603\t                     for k, e in results['finals'].items() for a in (e.get('attempts') or [])\n   604\t                     if a['attempt'] >= 2 or a.get('status') == 'format invalid'\n   605\t                     for v in items[tuple(k.split('|')[:2])]['members'])\n   606\t    rng.shuffle(earlier)\n   607\t    key = {'salt': secrets.token_hex(16), 'run_digest': run_digest(out), 'order': [(f'P{n:02d}', list(u)) for n, u in enumerate(unit_keys, 1)],\n   608\t           'attempts': [(f'D{n:02d}', list(e)) for n, e in enumerate(earlier, 1)]}\n   609\t    text = render_packets(out, key)[0]\n   610\t    attempts_text = render_attempts(out, key['attempts'])          # [47f.2] both rendered before anything is written\n   611\t    if (out / 'packets.md').exists() or (out / 'attempts.md').exists():\n   612\t        raise SystemExit(f'{out} already holds packets; refused')\n   613\t    key_dir.mkdir(parents=True, exist_ok=True)\n   614\t    with open(key_dir / 'packet-key.json', 'x') as handle:\n   615\t        json.dump(key, handle, indent=1)\n   616\t    with open(out / 'packets.md', 'x') as handle:\n   617\t        handle.write(text)\n   618\t    with open(out / 'attempts.md', 'x') as handle:\n   619\t        handle.write(attempts_text)\n   620\t    print(f'{len(key[\"order\"])} packets, {len(key[\"attempts\"])} diagnostic attempts; key in {key_dir}')\n   621\t\n   622\t\n   649\t\n   650\t\n   651\tdef verdict(out, readings_path, key_dir):\n   652\t    \"\"\"[47e.4] Seal the readings into the run (readings.json, created once), compute D725's lines once and write verdict.json bound to\n   653\t    the readings, the key and the packets. A second verdict on the run is refused; `replay` recomputes and compares.\"\"\"\n   654\t    if (out / 'verdict.json').exists() or (out / 'readings.json').exists():\n   655\t        raise SystemExit(f'{out} already has sealed readings or a verdict; refused (use replay)')\n   656\t    data = Path(readings_path).read_bytes()\n   657\t    with open(out / 'readings.json', 'xb') as handle:\n   658\t        handle.write(data)\n   659\t    summary = score(out, key_dir)\n   660\t    frozen = json.loads((key_dir / 'packet-key.json').read_text())\n   661\t    record = {'readings_sha256': hashlib.sha256(data).hexdigest(), 'key_commitment': key_commitment(frozen),\n   662\t              'packets_sha256': hashlib.sha256((out / 'packets.md').read_bytes()).hexdigest() if (out / 'packets.md').exists() else None,\n   663\t              'run_digest': run_digest(out), 'summary': summary}\n   664\t    with open(out / 'verdict.json', 'x') as handle:\n   665\t        json.dump(record, handle, indent=1)\n   666\t    return summary\n   667\t\n   668\t\n   669\tdef replay(out, key_dir):\n   670\t    \"\"\"Recompute the verdict from the sealed readings and compare it with verdict.json.\"\"\"\n   671\t    record = json.loads((out / 'verdict.json').read_text())\n   672\t    data = (out / 'readings.json').read_bytes()\n   673\t    same = (hashlib.sha256(data).hexdigest() == record['readings_sha256'] and record['run_digest'] == run_digest(out)\n   674\t            and record['key_commitment'] == key_commitment(json.loads((key_dir / 'packet-key.json').read_text())))\n   675\t    summary = score(out, key_dir)\n   676\t    matches = same and summary == record['summary']\n   677\t    print(json.dumps({'reproduced': matches}, indent=1))\n   678\t    return matches\n   679\t\n   680\t\n   681\tdef score(out, key_dir):\n   682\t    \"\"\"D725's registered lines on the sealed readings, bound to this run.\"\"\"\n   683\t    frozen = json.loads((key_dir / 'packet-key.json').read_text())\n   684\t    submitted = json.loads((out / 'readings.json').read_text())\n   685\t    problems = [] if frozen.get('run_digest') == run_digest(out) else ['the packet key does not belong to this run']   # [47b.4]\n   686\t    text, key, units = render_packets(out, frozen)                  # [47c.2] every packet rendered again from the run\n   687\t    if sorted(tuple(u) for _, u in frozen['order']) != sorted(units):\n   688\t        problems.append('the key does not map one packet to each unit of the run')\n   689\t    sha = hashlib.sha256(text.encode()).hexdigest()\n   690\t    packets_path = out / 'packets.md'\n   691\t    written = packets_path.read_text() if packets_path.exists() else ''\n   692\t    if not written.startswith(f'Key commitment: {key_commitment(frozen)}\\n'):      # [47d.1] the mapping the readers' text committed to\n   693\t        problems.append('the key is not the one packets.md committed to')\n   694\t    if hashlib.sha256(written.encode()).hexdigest() != sha:\n   695\t        problems.append('packets.md is not the text the run and the key give')\n   696\t    if submitted.get('packets_sha256') != sha:\n   697\t        problems.append('the readings were not made on the frozen packets')\n   698\t    readings = submitted.get('packets', {})\n   699\t    results = json.loads((out / 'results.json').read_text())\n   700\t    problems += [f'answers.jsonl line {d[\"line\"]} is damaged' for d in results.get('damaged', [])]\n   701\t    scored = {k: first_attempt(v)['decision'] for k, v in results['finals'].items()}            # [47f.1] completeness from the scored attempts\n   702\t    problems += [f'{k}: {d}' for k, d in scored.items() if d not in ('publish', 'held', 'refused')]               # [47b.2] from the records\n   703\t    problems += [f'{pid}: not read' for pid in key if pid not in readings] + [f'{pid}: not a packet' for pid in readings if pid not in key]\n   704\t    usable_pairs = {'joint': {}, 'separate': {}}\n   705\t    defects = []\n   706\t    for pid, k in key.items():\n   707\t        if pid not in readings:\n   708\t            continue\n   709\t        final, probs = final_readings(pid, readings[pid], list(k['cards']), k['grounds'])\n   710\t        problems += probs\n   711\t        if final is None:\n   712\t            continue\n   713\t        if k['decision'] == 'publish' and k['arm'] in ('joint', 'single'):      # D725: defects across the joint and singleton answers\n   714\t            for v, r in final.items():\n   715\t                if 'yes' in (r['contradiction'], r['internal_reference'], r['deciding_gap']):\n   716\t                    defects.append((pid, k['unit'], k['arm'], k['cards'][v]))\n   717\t        if k['unit'].startswith('pair') and k['arm'] in usable_pairs:\n   718\t            usable_pairs[k['arm']].setdefault(k['unit'], []).append(k['decision'] == 'publish' and all(r['usable'] == 'yes' for r in final.values()))\n   719\t    joint_total = sum(sum(v) for v in usable_pairs['joint'].values())\n   720\t    separate_total = sum(sum(v) for v in usable_pairs['separate'].values())\n   721\t    per_snapshot = {u: sum(v) for u, v in usable_pairs['joint'].items()}\n   722\t    complete = (not problems and len(key) == 27 and len(usable_pairs['joint']) == 3 and len(usable_pairs['separate']) == 3\n   723\t                and all(len(v) == 3 for arm in usable_pairs.values() for v in arm.values()))\n   724\t    passes = complete and not defects and joint_total >= 8 and all(n >= 2 for n in per_snapshot.values()) and joint_total - separate_total >= 3\n   725\t    summary = {'complete': complete, 'problems': problems[:20], 'joint usable pairs': joint_total, 'separate usable pairs': separate_total,\n   726\t               'joint per snapshot': per_snapshot, 'published defects': defects,\n   727\t               'verdict': 'PASS' if passes else ('INCOMPLETE' if not complete else 'STOP')}\n   728\t    print(json.dumps(summary, indent=1))\n   729\t    return summary\n   730\t\n   731\t\n   732\tif __name__ == '__main__':\n   733\t    cmd = sys.argv[1] if len(sys.argv) > 1 else ''\n","exit_code":0,"status":"completed"}}
