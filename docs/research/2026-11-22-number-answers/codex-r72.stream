   285\t    # the service keeps the mapping honest: only candidates, in the parts' order; direct and driver views go on the\n   286\t    # canvas, context stays on the card; the first part's direct view is the service's own pick when the rule holds\n   287\t    idea_ids = {r['view_id'] for r in idea_rows}\n   288\t    looks_at = {r['view_id']: r['looks_at'] for rows in candidates + [idea_rows] for r in rows}\n   289\t    mapping = {m['index']: m for m in second.data['parts'] if isinstance(m.get('index'), int)}\n   290\t    parts_out, chosen, dropped, seen = [], [], [], set()\n   291\t    for i, part in enumerate(parts):\n   292\t        m = mapping.get(i, {'views': [], 'why': 'the mapping call did not answer this part'})\n   293\t        allowed = {r['view_id'] for r in candidates[i]} | idea_ids\n   294\t        market = bool(MARKET_READING.search(part.get('looks_for', '') or ''))\n   295\t        tiers = {'direct': [], 'driver': [], 'context': []}\n   296\t        directs = [v.get('view_id') for v in m.get('views') or [] if v.get('fit') == 'direct' and v.get('view_id') in allowed]\n   297\t        ordered = sorted(dict.fromkeys(directs), key=lambda v: (ranks[i].get(v, len(ranks[i])), directs.index(v)))\n   298\t        decided = service_direct(part, ordered, looks_at) if i == 0 and not market else None\n   299\t        if decided:\n   300\t            tiers['direct'].append(decided)\n   301\t        for v in m.get('views') or []:\n   302\t            view_id, fit = v.get('view_id'), v.get('fit', 'context')\n   303\t            if market:\n   304\t                dropped.append({'view_id': view_id, 'why': f'part {i} is a market reading ({part[\"looks_for\"][:50]}); the library holds no view on prices'})\n   305\t            elif view_id not in allowed:\n   306\t                dropped.append({'view_id': view_id, 'why': f'not among the candidates of part {i} ({part[\"looks_for\"][:60]})'})\n   307\t            elif all(view_id not in tiers[k] for k in tiers):\n   308