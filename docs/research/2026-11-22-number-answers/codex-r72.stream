er include a view the request cannot see (OPERATING-CONTRACT.md, row 4a). Same text per view, same query,\n   216\t    same tokenizer, the views in creation order.\"\"\"\n   217\t    words = [w for w in text.replace('？', ' ').replace('，', ' ').split() if len(w) >= 2]\n   218\t    if not words or not corpus:\n   219\t        return []\n   220\t    query = ' OR '.join('\"' + w.replace('\"', '') + '\"' for w in words[:12])\n   221\t    memory = sqlite3.connect(':memory:')\n   222\t    try:\n   223\t        memory.execute(\"create virtual table views_fts using fts5(view_id unindexed, text, tokenize='trigram')\")\n   224\t        memory.executemany('insert into views_fts (view_id, text) values (?, ?)',\n   225\t                           [(record['view_id'], f\"{record['object']} {record['looks_at']} {record['question']}\") for record in corpus])\n   226\t        return [row[0] for row in memory.execute('select view_id from views_fts where views_fts match ? order by rank limit ?', (query, top_n))]\n   227\t    except sqlite3.OperationalError:\n   228\t        return []\n   229\t    finally:\n   230\t        memory.close()\n   231\t\n   232\t\n   233\tdef lexical_terms(query, limit=12):\n   234\t    \"\"\"What the ledger's trigram index is asked for: the Latin words of three characters or more, and every\n   235\t    three-character window of each Chinese run (Chinese has no spaces to split on; the index matches on\n   236\t    trigrams). 2026-10-24: a Chinese idea written without spaces matched nothing as one phrase.\"\"\"\n   237\t    terms = [m.group(0) for m in LATIN_WORD.finditer(query)]\n   238\t    for run in CJK.findall(query):\n   239\t        terms += [run[i:i + 3] for i in range(len(run) - 2)] or [run]\n   240\t    seen, out = set(), []\n   241\t    for term in terms:\n   242\t        if term.lower() not in seen:\n   243\t            seen.add(term.lower())\n   244\t            out.append(term)\n   245\t    return out[:limit]\n   246\t\n   247\t\n   248\tdef search(ledger, index, query, k=10, as_of=None, include_closed=False, embed=openai_embeddings, embedding_model=EMBEDDING_MODEL, aliases=None, semantic=True):\n   249\t    \"\"\"Top-k views for a query as of a day: cosine similarity on the view text, plus a small boost when the query\n   250\t    names the view's object and when the ledger's trigram index also matches. The ranking is 'semantic' only when\n   251\t    semantic ranking is allowed, every candidate has a usable vector made from its current text and the query could\n   252\t    be embedded; otherwise it is 'lexical' (the trigram index's own order), and the answer says so and names the\n   253\t    views without a fresh vector. `semantic=False` (a front started with --lexical) never calls the embedder.\n   254\t    `results` is null when the library holds no view on anything the idea names as of that day (D91): no company\n   255\t    or theme of the universe is named in it and the ledger's own text index matches no view; otherwise the ranked\n   256\t    list comes back whole and the caller judges which views correspond (D76).\"\"\"\n   257\t    as_of = service.resolve_bound(ledger, as_of)\n   258\t    candidates = service.summaries(ledger, as_of, include_closed)\n   259\t    if not candidates:\n   260\t        return {'query': query, 'as_of': as_of, 'mode': 'semantic' if semantic else 'lexical', 'missing_vectors': [], 'results': None}\n   261\t    mentioned = objects_in(query, aliases or {})\n   262\t    corpus = service.summaries(ledger, as_of, include_closed=True)                              # every view visible at the bound\n   263\t    lexical_order = visible_lexical_order(corpus, ' '.join(lexical_terms(query)), 50)           # trigram ranking over those only, best first\n   264\t    lexical_rank = {view_id: i for i, view_id in enumerate(lexical_order)}\n   265\t    vectors = fresh_vectors(ledger, index, embedding_model, [record['view_id'] for record in candidates]) if semantic else {}\n   266\t    missing = [record['view_id'] for record in candidates if record['view_id'] not in vectors]\n   267\t    mode, q = 'semantic', None\n   268\t    if not semantic or missing:\n   269\t        mode = 'lexical'\n   270\t    else:\n   271\t        try:\n   272\t            q, _ = query_vector(index, query, embed, embedding_model)\n   273\t        except (model.TransportError, OSError):\n   274\t            mode = 'lexical'\n   275\t    results = []\n   276\t    for record in candidates:\n   277\t        semantic = cosine(q, vectors[record['view_id']]) if q is not None else 0.0\n   278\t        object_hit = record['object'] in mentioned\n   279\t        text_hit = record['view_id'] in lexical_rank\n   280\t        # with embeddings a text hit is a small nudge; without them the trigram index's own order is the ranking\n   281\t        text_score = (TEXT_BOOST if mode == 'semantic' else 1.0 - lexical_rank[record['view_id']] / max(1, len(lexical_order))) if text_hit else 0.0\n   282\t        score = semantic + (OBJECT_BOOST if object_hit else 0.0) + text_score\n   283\t        results.append({'view_id': record['view_id'], 'object': record['object'], 'kind': record['kind'], 'looks_at': record['looks_at'], 'question': record['question'],\n   284\t                        'due_day': record['due_day'], 'open': record['open'], 'dependencies': record['dependencies'], 'dependants': record['dependants'],\n   285\t                        'score': round(score, 4), 'parts': {'semantic': round(semantic, 4), 'object_hit': object_hit, 'text_hit': text_hit}})\n   286\t    results.sort(key=lambda r: -r['score'])\n   287\t    named_or_matched = any(r['parts']['object_hit'] or r['parts']['text_hit'] for r in results)\n   288\t    best = max((r['parts']['semantic'] for r in results), default=0.0)\n   289\t    if not named_or_matched and (q is None or best < NULL_FLOOR):\n   290\t        return {'query': query, 'as_of': as_of, 'mode': mode, 'missing_vectors': missing, 'results': None}     # no recorded view on anything the idea names\n   291\t    return {'query': query, 'as_of': as_of, 'mode': mode, 'missing_vectors': missing, 'results': results[:k]}\n   292\t\n","exit_code":0,"status":"completed"}}
