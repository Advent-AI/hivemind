ontent\"><section id=\"panel-overview\" role=\"tabpanel\" aria-labelledby=\"tab-overview\">\n   196\t      ${\n   197\t        latest\n   198\t          ? `<div class=\"detail-section\"><h3 class=\"detail-heading\">Current assessment</h3><blockquote class=\"detail-copy assessment-conclusion\">${esc(v.rungs[latest.rung - 1].condition)}</blockquote>${assessmentHtml(v, latest)}</div>\n   199\t      <details class=\"detail-disclosure\"><summary>Recent evidence</summary><div class=\"detail-disclosure-body\">${keyEvidence.length ? keyEvidence.map((e) => evidenceHtml(e, detail.day)).join('') : '<p class=\"detail-muted\">No evidence cited in this assessment.</p>'}</div></details>`\n   200\t          : '<p class=\"detail-copy\">There is no assessment for this thesis at the selected date.</p>'\n   201\t      }\n   202\t      ${notJudgedHtml(v)}\n   203\t      ${relationsHtml(v, data, detail.day)}\n   204\t      <details class=\"detail-disclosure\"><summary>About this thesis</summary><dl class=\"detail-definitions\">${identityHtml(v)}<dt>First seen</dt><dd>${esc(longDay(v.created_day))}</dd><dt>Original source</dt><dd>${esc(v.created_from.title)}</dd><dt>Status</dt><dd><span class=\"chip chip--line\">${statusAt(v, detail.day)}</span></dd>${closing ? `<dt>Closing record</dt><dd>${esc(closing)}</dd>` : ''}</dl></details>\n   205\t    </section><section id=\"panel-evidence\" role=\"tabpanel\" aria-labelledby=\"tab-evidence\" hidden></section><section id=\"panel-history\" role=\"tabpanel\" aria-labelledby=\"tab-history\" hidden></section></div>`,\n   206\t    );\n   207\t    all('[data-thesis]').forEach(\n   208\t      (button) => (button.onclick = () => open(button.dataset.thesis, detail.day)),\n   209\t    );\n   210\t  }\n   211\t  function renderEvidence() {\n   212\t    const panel = find('panel-evidence');\n   213\t    panel.dataset.ready = 'true';\n   214\t    const tiers = [...new Set(detail.thesis.evidence.map((e) => e.tier))];\n   215\t    setHTML(\n   216\t      panel,\n   217\t      `<div class=\"evidence-tools\"><input class=\"detail-input\" id=\"evidenceSearch\" type=\"search\" placeholder=\"Find evidence…\" aria-label=\"Find evidence\"><div id=\"evidenceTypeFilter\"></div></div><div id=\"evidenceResults\"></div>`,\n   218\t    );\n   219\t    find('evidenceSearch').oninput = (event) => {\n   220\t      detail.query = event.target.value;\n1:import { assessmentAt, groupsFor, isSuperseded, statusAt } from './thesis.js';\n33:      const ad = assessmentAt(a, day)?.day || a.created_day;\n34:      const bd = assessmentAt(b, day)?.day || b.created_day;\n44:  const evidence = new Set(\n46:      t.evidence.filter((e) => e.arrival_day <= day && !isSuperseded(e, day)).map((e) => e.id),\n53:    evidence: evidence.size,\n     1\t/** Generate a browser fixture for instance isolation and host-driven updates. */\n     2\timport fs from 'node:fs/promises';\n     3\t\n     4\tconst page = await fs.readFile(new URL('../mock/index.html', import.meta.url), 'utf8');\n     5\tconst css = page.match(/<style>([\\s\\S]*?)<\\/style>/)[1];\n     6\tconst data = page.match(/<script id=\"data\" type=\"application\\/json\">([\\s\\S]*?)<\\/script>/)[1];\n     7\tconst script = page.slice(page.lastIndexOf('<script>') + 8, page.lastIndexOf('</script>'));\n     8\tconst fixture = `<!doctype html><html><head><meta charset=\"utf-8\"><link rel=\"stylesheet\" href=\"../../../web/design-system/fonts-embedded.css\"><style>${css}\n     9\tbody { margin:20px; background:var(--paper);font-family:var(--sans); } .hosts {display:grid;grid-template-columns:1fr 1fr;gap:16px;} .host {height:540px;border:1px solid var(--rule);margin-top:16px;} .test-actions {display:flex;gap:12px;flex-wrap:wrap;} .test-actions button {padding:10px;}</style></head><body class=\"hm-ui\"><h1>Thesis component verification</h1><div class=\"test-actions\"><button id=\"open-first\">Open first</button><button id=\"open-second\">Open second</button><button id=\"empty-history\">Open before first assessment</button><button id=\"invalid\">Reject invalid update</button><button id=\"destroy\">Destroy first</button><button id=\"recreate\">Recreate first</button></div><p id=\"result\" role=\"status\">Ready</p><div class=\"hosts\"><div class=\"host\" id=\"first\"></div><div class=\"host\" id=\"second\"></div></div><script id=\"fixture-data\" type=\"application/json\">${data}</script><script>${script}</script><script>\n    10\tconst dataset=JSON.parse(document.querySelector('#fixture-data').textContent);\n    11\tconst primary=dataset.theses.find(t=>t.id==='v3') || dataset.theses[0];\n    12\tlet first=Hivemind.createThesisExplorer(document.querySelector('#first'),{dataset});\n    13\tconst second=Hivemind.createThesisExplorer(document.querySelector('#second'),{dataset});\n    14\tfirst.showGraph({primaryId:primary.id});second.showGraph({primaryId:dataset.theses[0].id});\n    15\tconst result=document.querySelector('#result');\n    16\tdocument.querySelector('#open-first').onclick=()=>first.openThesis(primary.id);\n    25\tfunction history(drivers, dataset, asOf, weighted = false) {\n    26\t  const byId = new Map(dataset.theses.map((thesis) => [thesis.id, thesis]));\n    27\t  const start = dataset.days[0] || asOf;\n    28\t  const dates = new Set([start, asOf]);\n    29\t  for (const driver of drivers)\n    30\t    for (const judgement of byId.get(driver.thesis_id).judgements)\n    31\t      if (judgement.day >= start && judgement.day <= asOf) dates.add(judgement.day);\n    32\t  const series = [...dates].sort().map((day) => {\n    33\t    const contributions = drivers.map((driver) => {\n    34\t      const thesis = byId.get(driver.thesis_id);\n    35\t      const judgement = assessmentAt(thesis, day);\n    36\t      const raw = judgement ? numericScore(thesis, judgement.rung) : null;\n    37\t      return { ...driver, score: raw, signed: raw === null ? null : raw * driver.direction };\n    38\t    });\n    39\t    const active = contributions.filter((entry) => entry.signed !== null);\n    40\t    const sum = active.reduce(\n    41\t      (total, entry) => total + entry.signed * (weighted ? entry.weight_percent / 100 : 1),\n    42\t      0,\n    43\t    );\n    44\t    for (const entry of contributions)\n    45\t      entry.contribution =\n    46\t        entry.signed === null\n    47\t          ? null\n    48\t          : entry.signed * (weighted ? entry.weight_percent / 100 : 1 / active.length);\n    49\t    return {\n    50\t      day,\n    51\t      value: weighted\n    52\t        ? drivers.length && active.length === drivers.length\n    53\t          ? sum\n    54\t          : null\n    55\t        : active.length\n    56\t          ? sum / active.length\n    57\t          : null,\n    58\t      scored: active.length,\n    59\t      total: drivers.length,\n    60\t      contributions,\n    61\t    };\n","exit_code":0,"status":"completed"}}
