{"type":"item.started","item":{"id":"item_40","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba src/hivemind/pull.py | head -95; nl -ba poc/ui/src/model/thesis.js | sed -n '50,77p'; nl -ba src/hivemind/idea_composite.py | sed -n '251,286p'; nl -ba poc/ui/src/components/relations.js | head -95; rg -n 'service|mock|show_views|card\\\\.render|conditions\\\\.scan|report\\\\.py' scripts --glob '*.py' | rg 'card.render|conditions.scan' | head -24; ls scripts | rg 'agent|belief|bet|condition|event'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_40","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba src/hivemind/pull.py | head -95; nl -ba poc/ui/src/model/thesis.js | sed -n '50,77p'; nl -ba src/hivemind/idea_composite.py | sed -n '251,286p'; nl -ba poc/ui/src/components/relations.js | head -95; rg -n 'service|mock|show_views|card\\\\.render|conditions\\\\.scan|report\\\\.py' scripts --glob '*.py' | rg 'card.render|conditions.scan' | head -24; ls scripts | rg 'agent|belief|bet|condition|event'\"","aggregated_output":"     1\t\"\"\"Pull mode (D54, D356): at the end of a day (the day passed in, never read from a clock), every open view whose due day has come\n     2\tis frozen where its state stands and closed. The closing record names the rung it froze at; a view that was never judged closes\n     3\twith \"no data to verify\" (AGENTS §8: missing data is neither a pass nor a fail). Nothing waits for the day's items, there is no\n     4\tseparate final review, and no other question is re-judged here.\"\"\"\n     5\tfrom . import dispatch\n     6\tfrom .views import store\n     7\t\n     8\tNO_DATA = 'no data to verify'\n     9\t\n    10\t\n    11\tdef closing_reason(conn, view_id, due_day, day):\n    12\t    last = conn.execute('select rung from judgements where view_id=? order by seq desc, judgement_id desc limit 1', (view_id,)).fetchone()\n    13\t    if last is None:\n    14\t        return f'due {due_day}, closed on {day} with no judgement: {NO_DATA}'\n    15\t    label = conn.execute('select label from rungs where view_id=? and position=?', (view_id, last['rung'])).fetchone()\n    16\t    return f'due {due_day}, frozen on {day} at rung {last[\"rung\"]} {label[\"label\"] if label else \"\"}'.rstrip()\n    17\t\n    18\t\n    19\tdef closing_sequence(conn, day, seq):\n    20\t    \"\"\"The sequence number the day's closings are written under, so that they are dated on that day: the day's last number when\n    21\t    the day wrote it, else a new one recorded as the day's own step (a day with no items would otherwise date them on the day before).\"\"\"\n    22\t    row = conn.execute('select min(publication_day) from processing_steps where sequence_no=?', (seq,)).fetchone()\n    23\t    if seq > 0 and row[0] == day:\n    24\t        return seq\n    25\t    own = max(store.next_sequence(conn), seq + 1)\n    26\t    dispatch.mark(conn, {'input_id': f'day:{day}', 'publication_day': day}, own, 'closed', 'ok', 'due questions closed at the end of the day')\n    27\t    return own\n    28\t\n    29\t\n    30\tdef end_of_day(conn, day, seq):\n    31\t    due = [row for row in conn.execute('select view_id, due_day from views where due_day <= ? order by created_seq', (day,)).fetchall()\n    32\t           if store.is_open(conn, row['view_id'])]\n    33\t    if due:\n    34\t        seq = closing_sequence(conn, day, seq)\n    35\t    for row in due:\n    36\t        store.close_view(conn, row['view_id'], closing_reason(conn, row['view_id'], row['due_day'], day), 'pull', seq)\n    37\t    conn.commit()\n    38\t    return [row['view_id'] for row in due]\n    50\t}\n    51\texport function historyIndexAt(thesis, day) {\n    52\t  return thesis.judgements.findLastIndex((j) => j.day <= day);\n    53\t}\n    54\texport function statusAt(thesis, day) {\n    55\t  if (day < thesis.created_day) return 'Not open yet';\n    56\t  const last = lastOf(thesis.switches.filter((s) => s.day <= day));\n    57\t  return last && !last.open ? 'Closed' : 'Open';\n    58\t}\n    59\texport function closingAt(thesis, day) {\n    60\t  const last = lastOf(thesis.switches.filter((s) => s.day <= day));\n    61\t  return last && !last.open ? last.reason : null;\n    62\t}\n    63\texport function snapshotThesis(thesis, day) {\n    64\t  return {\n    65\t    ...thesis,\n    66\t    judgements: judgementsUpTo(thesis, day),\n    67\t    evidence: thesis.evidence\n    68\t      .filter((e) => e.arrival_day <= day)\n    69\t      .map((e) => ({\n    70\t        ...e,\n    71\t        sources: e.sources.filter((s) => s.arrival_day <= day),\n    72\t        replaced_by: e.replaced_by?.day && e.replaced_by.day > day ? null : e.replaced_by,\n    73\t      })),\n    74\t    dependencies: dependenciesAt(thesis, day),\n    75\t    successions: thesis.successions.filter((s) => s.day <= day),\n    76\t    switches: thesis.switches.filter((s) => s.day <= day),\n    77\t    notJudged: day < thesis.created_day ? null : (thesis.notJudged ?? null),\n   251\t\n   252\t\n   253\tdef contract(prompt_version, selected, ledger=None):\n   254\t    \"\"\"The schema, prose fields and binder belonging to each versioned composite prompt.\"\"\"\n   255\t    if prompt_version == 'idea-summary-v8':\n   256\t        theses = add_ladders(ledger, [{'view_id': entry['view_id']} for entry in selected], endpoints_only=True)\n   257\t        schema = adoption_schema(theses)\n   258\t        return schema, positive_prose, lambda answer, *args: bind_adoption(answer, *args, theses, schema)\n   259\t    if prompt_version == 'idea-summary-v7':\n   260\t        theses = add_ladders(ledger, [{'view_id': entry['view_id']} for entry in selected], endpoints_only=True)\n   261\t        return positive_schema(theses), positive_prose, lambda answer, *args: bind_positive(answer, *args, theses)\n   262\t    if prompt_version == 'idea-summary-v6':\n   263\t        theses = add_ladders(ledger, [{'view_id': entry['view_id']} for entry in selected], endpoints_only=True)\n   264\t        return weighted_schema(theses), disposition_prose, lambda answer, *args: bind_weighted(answer, *args, theses)\n   265\t    if prompt_version == 'idea-summary-v5':\n   266\t        theses = add_ladders(ledger, [{'view_id': entry['view_id']} for entry in selected], endpoints_only=True)\n   267\t        return endpoint_schema(theses), disposition_prose, lambda answer, *args: bind_endpoints(answer, *args, theses)\n   268\t    if prompt_version == 'idea-summary-v4':\n   269\t        return outcome_schema(selected), disposition_prose, bind_outcome\n   270\t    if prompt_version == 'idea-summary-v3':\n   271\t        return disposition_schema(selected), disposition_prose, bind_dispositions\n   272\t    if prompt_version == 'idea-summary-v2':\n   273\t        return SCHEMA, prose, lambda answer, *args: bind(answer['composite'], *args)\n   274\t    return None\n   275\t\n   276\t\n   277\tdef add_ladders(ledger, theses, endpoints_only=False):\n   278\t    \"\"\"Supply the immutable ordered outcomes, without copying evidence or guessing UI score orientation.\"\"\"\n   279\t    result = []\n   280\t    for thesis in theses:\n   281\t        rungs = store.rungs_of(ledger, thesis['view_id'])\n   282\t        if endpoints_only:\n   283\t            rungs = [rungs[0], rungs[-1]]\n   284\t        result.append({**thesis, 'ladder': [{key: rung[key] for key in ('position', 'label', 'condition')} for rung in rungs]})\n   285\t    return result\n   286\t\n     1\timport { esc, SEP } from './dom.js';\n     2\timport { groupsFor, dependenciesAt } from '../model/thesis.js';\n     3\t\n     4\t/** Group membership, causal dependencies and period succession stay separate. */\n     5\texport function relationsHtml(thesis, data, day) {\n     6\t  const loaded = new Map(data.theses.filter((t) => t.created_day <= day).map((t) => [t.id, t]));\n     7\t  const button = (id) =>\n     8\t    loaded.has(id)\n     9\t      ? `<button class=\"related-item\" type=\"button\" data-thesis=\"${esc(id)}\"><span>${esc(loaded.get(id).question)}</span></button>`\n    10\t      : '<p class=\"detail-muted\">Related thesis is not loaded.</p>';\n    11\t  const groups = groupsFor(data, thesis.id, day);\n    12\t  const membership = groups.length\n    13\t    ? `<details class=\"detail-disclosure\"><summary>Research groups (${groups.length})</summary><div class=\"detail-disclosure-body\">${groups\n    14\t        .map(\n    15\t          (g) =>\n    16\t            `<div class=\"thesis-group\"><strong>${esc(g.name)}</strong><p>${esc(g.scope)}</p>${g.members\n    17\t              .filter((m) => m.thesis_id !== thesis.id && m.day <= day)\n    18\t              .map((m) => button(m.thesis_id))\n    19\t              .join('')}</div>`,\n    20\t        )\n    21\t        .join('')}</div></details>`\n    22\t    : '';\n    23\t  const dependencies = dependenciesAt(thesis, day);\n    24\t  const dependants = [...loaded.values()].filter((t) =>\n    25\t    dependenciesAt(t, day).some((d) => d.depends_on === thesis.id),\n    26\t  );\n    27\t  const links =\n    28\t    dependencies.length || dependants.length\n    29\t      ? `<details class=\"detail-disclosure\"><summary>Dependencies</summary><div class=\"detail-disclosure-body\">${dependencies.map((d) => `<p class=\"detail-muted\">Depends on${d.direction ? ` ${SEP} ${esc(d.direction)}` : ''}</p>${d.depends_on ? button(d.depends_on) : `<p class=\"detail-copy\">Waiting for a thesis for ${esc(d.wait_year || 'a future period')}.</p>`}`).join('')}${dependants.length ? '<p class=\"detail-muted\">Used by</p>' + dependants.map((t) => button(t.id)).join('') : ''}</div></details>`\n    30\t      : '';\n    31\t  const successions = thesis.successions.filter((s) => s.day <= day);\n    32\t  const periods = successions.length\n    33\t    ? `<details class=\"detail-disclosure\"><summary>Other periods</summary><div class=\"detail-disclosure-body\">${successions.map((s) => `<p class=\"detail-muted\">${s.relation === 'previous' ? 'Previous' : 'Next'} period</p>${button(s.thesis_id)}`).join('')}</div></details>`\n    34\t    : '';\n    35\t  return membership + links + periods;\n    36\t}\n    37\t\n    38\texport function identityHtml(thesis) {\n    39\t  const identity = thesis.identity;\n    40\t  const rows = [\n    41\t    ['Subject', thesis.object],\n    42\t    ['Period', thesis.year],\n    43\t  ];\n    44\t  if (identity)\n    45\t    rows.push(\n    46\t      ['Measure', identity.measure.replaceAll('_', ' ')],\n    47\t      ['Scope', identity.scope],\n    48\t      ['Period start', identity.period_start],\n    49\t      ['Period end', identity.period_end],\n    50\t      ['Basis', identity.basis],\n    51\t      ['Unit', identity.unit],\n    52\t    );\n    53\t  return rows\n    54\t    .filter(([, value]) => value && value !== 'n/a')\n    55\t    .map(([label, value]) => `<dt>${label}</dt><dd>${esc(value)}</dd>`)\n    56\t    .join('');\n    57\t}\nscripts/agent_day0.py:62:        events = conditions.scan(views, conn_agent, 0)\nscripts/agent_day0.py:73:        print(card.render(views, conn_agent, args.user, args.view))\nagent_day0.py\n","exit_code":0,"status":"completed"}}
