ded = [r for r in rungs if r.get('lo') is not None or r.get('hi') is not None]\n498:    if len(bounded) != len(rungs):\n499:        return 'some rungs carry bounds and some do not'\n500:    ordered = sorted(rungs, key=lambda r: -1e300 if r.get('lo') is None else float(r['lo']))\n620:        problem = check_ladder(c['rungs'], c['kind'])\n624:        c = dict(c, rungs=normalise_ladder(c['rungs'], c['kind']))\n645:            problem = check_bounds(c['rungs'])\n92:def typed_direction(rungs):\n94:    bounds; only the first and last rung may leave one outer end open; an interval with lo >= hi is invalid; adjacent rungs may\n96:    if len(rungs) < 2:\n99:    for index, rung in enumerate(rungs):\n101:        outer = index in (0, len(rungs) - 1)\n119:def favourable_end(rungs):\n122:    labels = [vocabulary.canonical('label', r['label']) for r in rungs]\n130:def label_for(reader_rungs, read_rungs, sign):\n133:    reader_direction, read_direction, favourable = typed_direction(reader_rungs), typed_direction(read_rungs), favourable_end(reader_rungs)\n144:def is_number_question(kind, rungs, measure):\n146:    return (kind == 'asset' and len(rungs) == 5 and bool(measure) and measure not in identity.EVENT_MEASURES\n147:            and typed_direction(rungs) is not None and favourable_end(rungs) is not None)\n152:    return bool(v) and is_number_question(v['kind'], store.rungs_of(conn, view_id), (key or {}).get('measure'))\n155:def candidate_rungs(conn, c, outcome, target):\n156:    \"\"\"The candidate's rungs as the writer will store them (a successor is oriented like its predecessor).\"\"\"\n159:        return oriented_like(c, store.rungs_of(conn, target), [])['rungs']\n160:    return c['rungs']\n249:        rungs = candidate_rungs(conn, c, outcome, target)\n250:        if not is_number_question(c['kind'], rungs, c.get('measure')):\nzsh:1: no matches found: docs/research/2026-11-22-number-answers/README*\n","exit_code":0,"status":"completed"}}
