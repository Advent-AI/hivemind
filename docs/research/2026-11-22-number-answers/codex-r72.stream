{"type":"item.completed","item":{"id":"item_27","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba poc/ui/src/idea/idea.js | sed -n '107,164p'; rg -n 'rungs|judgements|additionalProperties' poc/ui/src/model/thesis.schema.json | head -42; rg -n 'judgement|rung|history|score' poc/ui/src/idea/composite.js | head -60; rg -n -i 'rung|band|forecast|judg|score' poc/ui/src/model/library.js | head -68\"","aggregated_output":"   107\t\n   108\texport function fmtUsd(value) {\n   109\t  const units = [\n   110\t    [1e12, 'T'],\n   111\t    [1e9, 'B'],\n   112\t    [1e6, 'M'],\n   113\t  ];\n   114\t  for (const [size, suffix] of units) {\n   115\t    if (Math.abs(value) >= size) {\n   116\t      const n = value / size;\n   117\t      return `$${Number.isInteger(n) ? n : n.toFixed(2).replace(/\\.?0+$/, '')}${suffix}`;\n   118\t    }\n   119\t  }\n   120\t  return `$${value}`;\n   121\t}\n   122\t\n   123\t/** What the card's chip and status line say, from the service's answer alone (no DOM). `scoreOf(position)`\n   124\t * renders a ladder position the way the thesis cards do (+2 … −2) when the thesis is loaded. */\n   125\texport function statusOf(card, scoreOf = (position) => `position ${position}`) {\n   126\t  if (card.no_recorded_view)\n   127\t    return {\n   128\t      badge: 'No thesis',\n   129\t      cls: 'chip--line',\n   130\t      line: 'No recorded view on anything in this idea.',\n   131\t      summary: '',\n   132\t    };\n   133\t  const chosen = card.reading?.chosen || [];\n   134\t  const summary = esc(card.reading.summary);\n   135\t  if (!chosen.length) return { badge: 'No thesis', cls: 'chip--line', line: '', summary };\n   136\t  const e = card.evaluation;\n   137\t  if (e && e.evaluable !== false && e.verdict && VERDICT[e.verdict]) {\n   138\t    const claim = `${e.comparator} ${fmtUsd(e.value_usd)}`;\n   139\t    const at = e.claim_position ? ` at ${scoreOf(e.claim_position)}` : '';\n   140\t    return {\n   141\t      badge: VERDICT[e.verdict],\n   142\t      cls: e.verdict === 'holds' ? 'chip--ink' : 'chip--line',\n   143\t      line: `Your claim <b>${esc(claim)}</b>${esc(at)} ${SEP} Judged <b>${esc(scoreOf(e.judged_position))}</b> ${esc(e.judged_label || '')}`,\n   144\t      summary,\n   145\t    };\n   146\t  }\n   147\t  return {\n   148\t    badge: `${chosen.length} ${chosen.length === 1 ? 'thesis' : 'theses'}`,\n   149\t    cls: 'chip--line',\n   150\t    line: '',\n   151\t    summary,\n   152\t  };\n   153\t}\n   154\t\n   155\t/** The card element the canvas leads with. `state` is one of pending, answered, failed. */\n   156\texport function ideaCard({\n   157\t  text,\n   158\t  state,\n   159\t  card,\n   160\t  error,\n   161\t  scoreOf,\n   162\t  onOpen,\n   163\t  composite,\n   164\t  compositeNote = '',\n6:  \"additionalProperties\": false,\n46:      \"additionalProperties\": false,\n75:      \"additionalProperties\": false,\n120:      \"additionalProperties\": false,\n160:      \"additionalProperties\": false,\n202:              \"additionalProperties\": false,\n274:      \"additionalProperties\": false,\n317:      \"additionalProperties\": false,\n337:      \"additionalProperties\": false,\n369:        \"rungs\": {\n377:        \"judgements\": {\n433:            \"additionalProperties\": false,\n457:        \"rungs\",\n458:        \"judgements\",\n469:      \"additionalProperties\": false,\n497:      \"additionalProperties\": false,\n513:      \"additionalProperties\": false,\n544:      \"additionalProperties\": false,\n560:      \"additionalProperties\": false,\n577:      \"additionalProperties\": false,\n1:import { assessmentAt, score, undirected } from '../model/thesis.js';\n18:  const value = score(thesis, position);\n20:    throw new TypeError('Unsupported composite input score');\n25:function history(drivers, dataset, asOf, weighted = false) {\n30:    for (const judgement of byId.get(driver.thesis_id).judgements)\n31:      if (judgement.day >= start && judgement.day <= asOf) dates.add(judgement.day);\n35:      const judgement = assessmentAt(thesis, day);\n36:      const raw = judgement ? numericScore(thesis, judgement.rung) : null;\n37:      return { ...driver, score: raw, signed: raw === null ? null : raw * driver.direction };\n58:      scored: active.length,\n66:/** Default API plan: interpret its supporting ladder end using the card's existing score scale. */\n105:      throw new TypeError('An unclear composite cannot have scored drivers');\n160:    const first = numericScore(thesis, thesis.rungs[0].position);\n184:  return { ...plan, excluded, drivers, ...history(drivers, dataset, plan.as_of, weighted) };\n235:    ...history(drivers, dataset, plan.as_of),\n245:      scored: 0,\n260:    throw new TypeError('Confidence requires a score from −2 to +2');\n3:/** All filtering reads the same dated library; no group, score or edge is inferred. */\n","exit_code":0,"status":"completed"}}
