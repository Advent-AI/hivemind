{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc 'nl -ba src/hivemind/service.py'","aggregated_output":"     1\t\"\"\"Read-only answers over the views ledger, as of a calendar day (docs/poc/service.md).\n     2\t\n     3\tNothing here reads the clock (D12, D13): every function takes `as_of`, a day, and the default is the ledger's last\n     4\tcompleted day. A row is visible as of a day when the sequence number it was written under belongs to an item or a\n     5\tdaily round dated on or before that day. Nothing here writes.\n     6\t\"\"\"\n     7\timport json\n     8\timport re\n     9\timport sqlite3\n    10\tfrom decimal import Decimal\n    11\t\n    12\tfrom . import vocabulary\n    13\tfrom .views import store\n    14\t\n    15\tTIER_FACT = vocabulary.TIERS[0]          # 'fact'; a legacy ledger's '发生的事' compares equal through vocabulary.canonical\n    16\tCOMPARATORS = ('>=', '<', '=')\n    17\t\n    18\t\n    19\tdef open_ledger(path):\n    20\t    \"\"\"A read-only connection to a views database.\"\"\"\n    21\t    return store.open_read_only(path)\n    22\t\n    23\t\n    24\tdef default_as_of(conn):\n    25\t    \"\"\"Today's default day: the last completed day, or a legacy ledger's last judgement day. Read only through `resolve_bound`.\"\"\"\n    26\t    return store.last_completed_day(conn) or conn.execute('select max(publication_day) from judgements').fetchone()[0]\n    27\t\n    28\t\n    29\tclass FirstDayNotCompleted(ValueError):\n    30\t    \"\"\"The store holds processing steps and no completed day: its first day is still in progress, and nothing is served from it\n    31\t    (live-service/OPERATING-CONTRACT.md, row 4; open defect 10).\"\"\"\n    32\t\n    33\t    def __init__(self):\n    34\t        super().__init__(\"the store's first day has not completed\")\n    35\t\n    36\t\n    37\tclass BoundNotCompleted(ValueError):\n    38\t    \"\"\"An explicit upper bound later than the store's last completed day: refused, naming that day (OPERATING-CONTRACT.md, row 3).\"\"\"\n    39\t\n    40\t    def __init__(self, requested, last_completed_day):\n    41\t        self.requested, self.last_completed_day = requested, last_completed_day\n    42\t        super().__init__(f'day not completed: {requested} is after the last completed day {last_completed_day}')\n    43\t\n    44\t\n    45\tclass RangeNotOrdered(ValueError):\n    46\t    \"\"\"A range whose start is after its resolved end: a window reaching into days not yet completed (council round 124).\"\"\"\n    47\t\n    48\t    def __init__(self, start, end):\n    49\t        self.start, self.end = start, end\n    50\t        super().__init__(f'range start after its end: {start} to {end}')\n    51\t\n    52\t\n    53\tdef first_day_unfinished(conn):\n    54\t    return store.last_completed_day(conn) is None and conn.execute('select 1 from processing_steps limit 1').fetchone() is not None\n    55\t\n    56\t\n    57\tdef resolve_bound(conn, bound, *, unfiltered=False):\n    58\t    \"\"\"The one owner of an upper date bound, explicit or omitted (OPERATING-CONTRACT.md, row 3).\n    59\t\n    60\t    A store whose first day is in progress is refused. An omitted bound is today's default day; with `unfiltered` (the bundle\n    61\t    functions, whose omitted bound read every record), it is the last completed day, or None (no filter, as before) on a store with\n    62\t    none. An explicit bound later than the last completed day is refused, whatever the store holds after it; one on or before it\n    63\t    passes. Idempotent: a bound it passed passes again.\"\"\"\n    64\t    if first_day_unfinished(conn):\n    65\t        raise FirstDayNotCompleted()\n    66\t    last = store.last_completed_day(conn)\n    67\t    if not bound:\n    68\t        return last if unfiltered else default_as_of(conn)\n    69\t    if last is not None and bound > last:\n    70\t        raise BoundNotCompleted(bound, last)\n    71\t    return bound\n    72\t\n    73\t\n    74\tdef resolve_range(conn, start, end):\n    75\t    \"\"\"A range's end resolved by `resolve_bound` (an explicit future end is refused there); a start after the end is refused. A start\n    76\t    equal to the end reads as before: an empty window for `changes`, whose start is excluded, and that one day for `history`, whose\n    77\t    start is included; a client polling \"what changed since the day I last saw\" keeps its empty answer until a day completes\n    78\t    (council round 124). An end that resolves to None (an empty store) is compared with nothing, as before.\"\"\"\n    79\t    end = resolve_bound(conn, end)\n    80\t    if start and end is not None and start > end:\n    81\t        raise RangeNotOrdered(start, end)\n    82\t    return end\n    83\t\n    84\t\n    85\t_SEQ_DAYS = {}      # id(connection) → (connection, (max sequence, rows), map); a sqlite3 connection cannot carry attributes\n    86\t\n    87\t\n    88\tdef seq_day_map(conn):\n    89\t    \"\"\"sequence number → the publication day of the item or daily round written under it. Cached per connection and\n    90\t    rebuilt when processing_steps has grown (an open ledger gains steps while the pipeline runs); without the cache\n    91\t    one view with 367 pieces of evidence cost 1,224 full scans (0.46 s, measured 2026-10-24).\"\"\"\n    92\t    stamp = tuple(conn.execute('select max(sequence_no), count(*) from processing_steps').fetchone())\n    93\t    entry = _SEQ_DAYS.get(id(conn))\n    94\t    if entry is not None and entry[0] is conn and entry[1] == stamp:\n    95\t        return entry[2]\n    96\t    cache = {}\n    97\t    for seq, day in conn.execute('select sequence_no, min(publication_day) from processing_steps where sequence_no > 0 group by sequence_no'):\n    98\t        cache[seq] = day\n    99\t    if cache:                 # sequence 0 is the seed questions written before the first item (D253): visible from the ledger's first day\n   100\t        cache[0] = min(cache.values())\n   101\t    if len(_SEQ_DAYS) >= 64:\n   102\t        _SEQ_DAYS.clear()\n   103\t    _SEQ_DAYS[id(conn)] = (conn, stamp, cache)\n   104\t    return cache\n   105\t\n   106\t\n   107\tdef day_of_seq(conn, seq):\n   108\t    return seq_day_map(conn).get(seq)\n   109\t\n   110\t\n   111\tdef visible(conn, seq, as_of):\n   112\t    day = day_of_seq(conn, seq)\n   113\t    return day is not None and day <= as_of\n   114\t\n   115\t\n   116\t# ---------- views\n   117\t\n   118\tdef view_exists(conn, record, as_of):\n   119\t    return visible(conn, record['created_seq'], as_of)\n   120\t\n   121\t\n   122\tdef is_open_as_of(conn, view_id, as_of):\n   123\t    for row in conn.execute('select open, after_seq from view_switches where view_id=? order by id desc', (view_id,)):\n   124\t        if visible(conn, row['after_seq'], as_of):\n   125\t            return bool(row['open'])\n   126\t    return True\n   127\t\n   128\t\n   129\tdef state_as_of(conn, view_id, as_of):\n   130\t    \"\"\"The last judgement on or before the day, with the day the current position was first taken.\"\"\"\n   131\t    rows = [dict(r) for r in conn.execute('select * from judgements where view_id=? and publication_day<=? order by judgement_id', (view_id, as_of))]\n   132\t    if not rows:\n   133\t        return None\n   134\t    last = rows[-1]\n   135\t    since, previous = last['publication_day'], None\n   136\t    for row in reversed(rows[:-1]):\n   137\t        if row['rung'] != last['rung']:\n   138\t            previous = row['rung']\n   139\t            break\n   140\t        since = row['publication_day']\n   141\t    return {'position': last['rung'], 'judgement_day': last['publication_day'], 'since_day': since, 'previous_position': previous,\n   142\t            'rounds': len(rows), 'why_changed': last['why_changed'], 'reasons': last['reasons'], 'theme_pushes': _json(last.get('theme_pushes_json'))}\n   143\t\n   144\t\n   145\tdef summaries(conn, as_of=None, include_closed=False):\n   146\t    \"\"\"Every view as of the day as a light record (id, object, kind, what it looks at, the question, due day, open,\n   147\t    dependency and dependant ids): what a search ranks. The full record with its evidence counts is `view`; listing\n   148\t    92 of those cost 0.29 s per search (1,205 evidence reads), measured 2026-10-24.\"\"\"\n   149\t    as_of = resolve_bound(conn, as_of)\n   150\t    out = []\n   151\t    for record in conn.execute('select * from views order by created_seq'):\n   152\t        record = dict(record)\n   153\t        if not view_exists(conn, record, as_of):\n   154\t            continue\n   155\t        is_open = is_open_as_of(conn, record['view_id'], as_of)\n   156\t        if not include_closed and not is_open:\n   157\t            continue\n   158\t        out.append({'view_id': record['view_id'], 'object': record['object_id'], 'object_kind': record['object_kind'], 'kind': record['kind'],\n   159\t                    'looks_at': record['looks_at'], 'question': record['question'], 'due_day': record['due_day'], 'open': is_open,\n   160\t                    'dependencies': [d['view_id'] for d in dependencies(conn, record['view_id'], as_of)], 'dependants': dependants(conn, record['view_id'], as_of)})\n   161\t    return out\n   162\t\n   163\t\n   164\tdef views(conn, object_id=None, as_of=None, include_closed=False):\n   165\t    as_of = resolve_bound(conn, as_of)\n   166\t    rows = conn.execute('select * from views' + (' where object_id=?' if object_id else '') + ' order by created_seq', (object_id,) if object_id else ()).fetchall()\n   167\t    out = []\n   168\t    for record in rows:\n   169\t        record = dict(record)\n   170\t        if not view_exists(conn, record, as_of):\n   171\t            continue\n   172\t        if not include_closed and not is_open_as_of(conn, record['view_id'], as_of):\n   173\t            continue\n   174\t        out.append(view(conn, record['view_id'], as_of, record=record))\n   175\t    return out\n   176\t\n   177\t\n   178\tdef dependencies(conn, view_id, as_of):\n   179\t    \"\"\"The view's dependencies recorded on or before the day, each pointing at the target resolved on or before it.\"\"\"\n   180\t    out = []\n   181\t    for dep in conn.execute('select * from dependencies where view_id=? order by dependency_id', (view_id,)):\n   182\t        if not visible(conn, dep['seq'], as_of):\n   183\t            continue\n   184\t        target = dep['depends_on']\n   185\t        for res in conn.execute('select resolved_to, seq from dependency_resolutions where dependency_id=? order by id desc', (dep['dependency_id'],)):\n   186\t            if visible(conn, res['seq'], as_of):\n   187\t                target = res['resolved_to']\n   188\t                break\n   189\t        out.append({'view_id': target, 'direction': dep['direction'], 'wait_chain_view_id': dep['wait_chain_view_id'], 'wait_year': dep['wait_year'], 'since_day': day_of_seq(conn, dep['seq'])})\n   190\t    return out\n   191\t\n   192\t\n   193\tdef dependants(conn, view_id, as_of):\n   194\t    \"\"\"The views recorded on or before the day as depending on this one (directly or by a resolution).\"\"\"\n   195\t    direct = [r['view_id'] for r in conn.execute('select view_id, seq from dependencies where depends_on=?', (view_id,)) if visible(conn, r['seq'], as_of)]\n   196\t    resolved = [r['view_id'] for r in conn.execute('select d.view_id, r.seq from dependency_resolutions r join dependencies d on d.dependency_id=r.dependency_id where r.resolved_to=?', (view_id,)) if visible(conn, r['seq'], as_of)]\n   197\t    return sorted(set(direct + resolved))\n   198\t\n   199\t\n   200\tdef view(conn, view_id, as_of=None, record=None):\n   201\t    as_of = resolve_bound(conn, as_of)\n   202\t    record = record or store.view(conn, view_id)\n   203\t    if not record or not view_exists(conn, record, as_of):\n   204\t        return None\n   205\t    rungs = store.rungs_of(conn, view_id)\n   206\t    state = state_as_of(conn, view_id, as_of)\n   207\t    if state:\n   208\t        rung = next((r for r in rungs if r['position'] == state['position']), None)\n   209\t        state['label'] = rung['label'] if rung else None\n   210\t        state['condition'] = rung['condition'] if rung else None\n   211\t    in_force = evidence(conn, view_id, as_of)\n   212\t    return {\n   213\t        'view_id': view_id, 'object': record['object_id'], 'object_kind': record['object_kind'], 'kind': record['kind'],\n   214\t        'looks_at': record['looks_at'], 'question': record['question'], 'due_day': record['due_day'], 'year': record['year'],\n   215\t        'created_day': day_of_seq(conn, record['created_seq']), 'created_from': record['created_from_input'],\n   216\t        'as_of': as_of, 'open': is_open_as_of(conn, view_id, as_of), 'rungs': rungs, 'state': state,\n   217\t        'dependencies': dependencies(conn, view_id, as_of), 'dependants': dependants(conn, view_id, as_of),\n   218\t        'counts': {'rounds': state['rounds'] if state else 0, 'evidence': len(in_force), 'facts': sum(1 for e in in_force if vocabulary.canonical('tier', e['tier']) == TIER_FACT)},\n   219\t    }\n   220\t\n   221\t\n   222\t# ---------- evidence\n   223\t\n   224\tdef evidence_record(conn, evidence_id, as_of, arrived_seq=None):\n   225\t    \"\"\"One piece of evidence with only the sources recorded on or before the day (a later outlet of the same\n   226\t    sentence is not yet known on that day).\"\"\"\n   227\t    piece = store.evidence(conn, evidence_id)\n   228\t    if not piece:\n   229\t        return None\n   230\t    sources = [dict(s) for s in conn.execute('select input_id, category, publication_day, seq from evidence_sources where evidence_id=? order by id', (evidence_id,)) if visible(conn, s['seq'], as_of)]\n   231\t    replaces = conn.execute('select old_evidence_id, seq from replacements where new_evidence_id=?', (evidence_id,)).fetchone()\n   232\t    return {'evidence_id': piece['evidence_id'], 'one_line': piece['one_line'], 'quote': piece['quote'], 'tier': piece['tier'],\n   233\t            'speaker': piece['speaker'], 'original_who': piece['original_who'], 'original_day': piece['original_day'], 'event_time': piece['event_time'],\n   234\t            'day': day_of_seq(conn, arrived_seq if arrived_seq is not None else piece['created_seq']), 'sources': sources, 'outlets': len(sources),\n   235\t            'replaces': replaces['old_evidence_id'] if replaces and visible(conn, replaces['seq'], as_of) else None}\n   236\t\n   237\t\n   238\tdef evidence(conn, view_id, as_of=None, tier=None):\n   239\t    \"\"\"Evidence linked to the view on or before the day and not replaced on or before it, with its sources.\"\"\"\n   240\t    as_of = resolve_bound(conn, as_of)\n   241\t    out = []\n   242\t    for link in conn.execute('select evidence_id, seq from evidence_links where view_id=? order by id', (view_id,)):\n   243\t        if not visible(conn, link['seq'], as_of):\n   244\t            continue\n   245\t        replacement = conn.execute('select new_evidence_id, said_day, seq from replacements where old_evidence_id=? order by id desc limit 1', (link['evidence_id'],)).fetchone()\n   246\t        if replacement and visible(conn, replacement['seq'], as_of):\n   247\t            continue\n   248\t        piece = evidence_record(conn, link['evidence_id'], as_of, link['seq'])\n   249\t        if tier and piece['tier'] != tier:\n   250\t            continue\n   251\t        out.append(piece)\n   252\t    return out\n   253\t\n   254\t\n   255\t# ---------- history\n   256\t\n   257\tdef history(conn, view_id, from_day=None, to_day=None):\n   258\t    to_day = resolve_range(conn, from_day, to_day)\n   259\t    from_day = from_day or '0000-00-00'\n   260\t    judgements = []\n   261\t    previous = None\n   262\t    for row in conn.execute('select * from judgements where view_id=? order by judgement_id', (view_id,)):\n   263\t        entry = {'day': row['publication_day'], 'seq': row['seq'], 'position': row['rung'], 'changed': bool(row['changed']), 'moved_from': previous if previous is not None and previous != row['rung'] else None,\n   264\t                 'why_changed': row['why_changed'], 'reasons': row['reasons'], 'cited': _unique(_json(row['cited_evidence_json'])), 'pushes': _json(row['pushes_json']),\n   265\t                 'theme_pushes': _json(row['theme_pushes_json'] if 'theme_pushes_json' in row.keys() else None), 'round': row['input_id']}\n   266\t        previous = row['rung']\n   267\t        if from_day <= row['publication_day'] <= to_day:\n   268\t            judgements.append(entry)\n   269\t    arrivals = {}\n   270\t    for link in conn.execute('select evidence_id, seq from evidence_links where view_id=?', (view_id,)):\n   271\t        day = day_of_seq(conn, link['seq'])\n   272\t        if day and from_day <= day <= to_day:\n   273\t            piece = store.evidence(conn, link['evidence_id'])\n   274\t            bucket = arrivals.setdefault(day, {'evidence': 0, 'facts': 0})\n   275\t            bucket['evidence'] += 1\n   276\t            bucket['facts'] += int(vocabulary.canonical('tier', piece['tier']) == TIER_FACT)\n   277\t    replacements = [{'day': day_of_seq(conn, r['seq']), 'old': r['old_evidence_id'], 'new': r['new_evidence_id'], 'said_day': r['said_day']}\n   278\t                    for r in conn.execute('select r.* from replacements r join evidence_links l on l.evidence_id=r.new_evidence_id where l.view_id=?', (view_id,))\n   279\t                    if day_of_seq(conn, r['seq']) and from_day <= day_of_seq(conn, r['seq']) <= to_day]\n   280\t    switches = [{'day': day_of_seq(conn, s['after_seq']), 'open': bool(s['open']), 'reason': s['reason']}\n   281\t                for s in conn.execute('select * from view_switches where view_id=? order by id', (view_id,)) if day_of_seq(conn, s['after_seq']) and from_day <= day_of_seq(conn, s['after_seq']) <= to_day]\n   282\t    return {'view_id': view_id, 'from_day': from_day, 'to_day': to_day, 'judgements': judgements,\n   283\t            'changes': [j for j in judgements if j['moved_from'] is not None], 'arrivals': dict(sorted(arrivals.items())),\n   284\t            'replacements': replacements, 'switches': switches}\n   285\t\n   286\t\n   287\tclass LedgerError(ValueError):\n   288\t    \"\"\"A ledger record the service cannot read (corrupt JSON): refused, never read as empty.\"\"\"\n   289\t\n   290\t\n   291\tclass StoreUnreadable(LedgerError):\n   292\t    \"\"\"The store could not be opened, or its read transaction begun and pinned (live-service/OPERATING-CONTRACT.md, row 1): named by\n   293\t    its path, never answered with an empty or stale state.\"\"\"\n   294\t\n   295\t\n   296\tdef open_pinned(path):\n   297\t    \"\"\"A reader's connection with its committed state pinned (row 2: `BEGIN`, then a first read, which in WAL mode fixes the state\n   298\t    every later read of the request sees). A SQLite failure in these three steps closes what was opened and raises `StoreUnreadable`\n   299\t    naming the path; a later SQLite error is not covered here.\"\"\"\n   300\t    conn = None\n   301\t    try:\n   302\t        conn = open_ledger(path)\n   303\t        conn.execute('begin')\n   304\t        conn.execute('select 1 from sqlite_master limit 1').fetchone()\n   305\t        return conn\n   306\t    except sqlite3.Error as error:\n   307\t        if conn is not None:\n   308\t            conn.close()\n   309\t        raise StoreUnreadable(f'{path}: {error}') from error\n   310\t\n   311\t\n   312\tdef _unique(ids):\n   313\t    \"\"\"A judgement's cites as the UI contract reads them: each id once, first occurrence kept. The writer stores the set from\n   314\t    2026-10-28; the sealed ledger sealed-2026-10-28-v34-nvda-3m-through-0828 holds one judgement (v2, id 736) that cites an id twice.\"\"\"\n   315\t    seen, out = set(), []\n   316\t    for value in ids:\n   317\t        if value not in seen:\n   318\t            seen.add(value)\n   319\t            out.append(value)\n   320\t    return out\n   321\t\n   322\t\n   323\tdef _json(text):\n   324\t    if not text:\n   325\t        return []\n   326\t    try:\n   327\t        return json.loads(text)\n   328\t    except ValueError as error:\n   329\t        raise LedgerError(f'a judgement record holds invalid JSON: {text[:60]!r}') from error\n   330\t\n   331\t\n   332\t# ---------- the processing record\n   333\t\n   334\tdef record(conn, view_id, as_of=None):\n   335\t    \"\"\"The last check of the view on or before the day: when, by which round, how much came in that day.\"\"\"\n   336\t    as_of = resolve_bound(conn, as_of)\n   337\t    row = conn.execute('select input_id, publication_day, seq from judgements where view_id=? and publication_day<=? order by judgement_id desc limit 1', (view_id, as_of)).fetchone()\n   338\t    if not row:\n   339\t        return {'view_id': view_id, 'as_of': as_of, 'last_check': None}\n   340\t    day = row['publication_day']\n   341\t    items = [r['input_id'] for r in conn.execute(\"select distinct input_id from processing_steps where publication_day=? and step='handed_over' and result='ok' and input_id not like 'day:%'\", (day,))]\n   342\t    arrived = sum(1 for link in conn.execute('select seq from evidence_links where view_id=?', (view_id,)) if day_of_seq(conn, link['seq']) == day)\n   343\t    return {'view_id': view_id, 'as_of': as_of, 'last_check': {'day': day, 'round': row['input_id'], 'items_processed_that_day': len(items), 'evidence_arrived_that_day': arrived}}\n   344\t\n   345\t\n   346\t# ---------- changes since a day\n   347\t\n   348\tdef changes(conn, since_day, to_day=None):\n   349\t    \"\"\"Judgements that said 'changed' after since_day (exclusive) up to to_day, with their cited evidence.\"\"\"\n   350\t    to_day = resolve_range(conn, since_day, to_day)\n   351\t    out = []\n   352\t    previous = {}\n   353\t    for row in conn.execute('select * from judgements order by judgement_id'):\n   354\t        before = previous.get(row['view_id'])\n   355\t        previous[row['view_id']] = row['rung']\n   356\t        if not row['changed'] or not (since_day < row['publication_day'] <= to_day):\n   357\t            continue\n   358\t        cited = [piece for piece in (evidence_record(conn, e, row['publication_day']) for e in _unique(_json(row['cited_evidence_json']))) if piece]\n   359\t        out.append({'view_id': row['view_id'], 'day': row['publication_day'], 'from_position': before, 'to_position': row['rung'],\n   360\t                    'position_moved': before is not None and before != row['rung'], 'why_changed': row['why_changed'], 'cited': cited})\n   361\t    return out\n   362\t\n   363\t\n   364\t# ---------- a claim against a ladder\n   365\t#\n   366\t# A rung's condition is a sentence like \"不低于 1650 亿美元且不高于 1690 亿美元，处于公司指引区间\". The band is read from\n   367\t# the comparator words and the amount that follows each; remarks after ；or ， are not part of it. The ladder is\n   368\t# evaluable only when its bands form one unbroken partition of the line (06-views: 格和格不重叠、不留空), so a\n   369\t# condition the parser cannot read makes the whole ladder \"not evaluable\" rather than a wrong verdict.\n   370\t\n   371\tINF = float('inf')\n   372\tUNIT_USD = {'万亿': Decimal('1e12'), '千亿': Decimal('1e11'), '亿': Decimal('1e8'), '万': Decimal('1e4'), None: Decimal(1)}   # exact: 269.79亿 is 26,979,000,000, not ...000.000004\n   373\t# an amount: a number with a Chinese magnitude or followed by 美元; a bare number counts only right after a comparator\n   374\t# or a range separator (大于或等于0, 小于-10亿), so years (2026年, FY2026) and model names (H100) are not amounts\n   375\tAMOUNT_TOKEN = re.compile(r'(?<![A-Za-z\\d.])(-?\\d[\\d,]*(?:\\.\\d+)?)\\s*(万亿|千亿|亿|万)?(\\s*美元)?')\n   376\tCOMPARATORS_RE = [\n   377\t    ('lo_inc', re.compile(r'不低于|不少于|至少|大于或等于|大于等于|达到或超过|达到(?!或)|≥|>=')),\n   378\t    ('lo_exc', re.compile(r'(?<!不)高于|(?<![不或])超过|大于(?!或等于|等于)|多于|>(?!=)')),\n   379\t    ('hi_inc', re.compile(r'不高于|不超过|至多|小于或等于|小于等于|≤|<=')),\n   380\t    ('hi_exc', re.compile(r'(?<!不)低于|不足|不到|(?<!不)少于|小于(?!或等于|等于)|<(?!=)')),\n   381\t    ('exact', re.compile(r'恰为|恰好为|恰好|(?<![或大小])等于')),\n   382\t]\n   383\t\n   384\t\n   385\tdef _comparators(clause):\n   386\t    \"\"\"(start, end, kind) for every comparator word, the longest match winning where words overlap\n   387\t    (\"大于或等于\" is one lower-inclusive comparator, not also a \"大于\" and an \"等于\").\"\"\"\n   388\t    found = []\n   389\t    for kind, regex in COMPARATORS_RE:\n   390\t        for match in regex.finditer(clause):\n   391\t            found.append((match.start(), match.end(), kind))\n   392\t    found.sort(key=lambda m: (m[0], -(m[1] - m[0])))\n   393\t    kept = []\n   394\t    for start, end, kind in found:\n   395\t        if kept and start < kept[-1][1]:          # inside the previous, longer match\n   396\t            continue\n   397\t        kept.append((start, end, kind))\n   398\t    return kept\n   399\tPOSTFIX_LO = re.compile(r'\\s*(?:及以上|或以上|以上)')\n   400\tPOSTFIX_HI = re.compile(r'\\s*(?:及以下|以下|以内)')\n   401\tRANGE_SEP = re.compile(r'\\s*(?:至|到|~|–|—)\\s*(?:不足|低于)?\\s*')\n   402\t\n   403\t\n   404\tdef operative_clause(condition):\n   405\t    \"\"\"The part of a condition that states the bound: the first clause (split at ；or ，) that names a money amount,\n   406\t    joined with the clauses that continue it (且 / 并且 / 但 / 或 / 并); a dateline before it (\"截至2026-12-31，\") and a\n   407\t    remark after it (\"，处于公司指引区间\", \"；与公司所称…相符\") are dropped. Parenthesised asides are removed first.\"\"\"\n   408\t    text = re.sub(r'（[^）]*）|\\([^)]*\\)', '', condition)\n   409\t    clauses = [c for c in re.split(r'[；，;]', text) if c.strip()]\n   410\t    chosen = []\n   411\t    for clause in clauses:\n   412\t        if not chosen:\n   413\t            if _amounts(clause):\n   414\t                chosen.append(clause)\n   415\t        elif re.match(r'\\s*(?:且|并且|并|但|或)', clause):\n   416\t            chosen.append(clause)\n   417\t        else:\n   418\t            break\n   419\t    return ''.join(chosen)\n   420\t\n   421\t\n   422\tdef _amounts(text):\n   423\t    \"\"\"(start, end, value_usd) for every money amount in the clause: a number with a Chinese magnitude or followed\n   424\t    by 美元, or a bare zero (\"大于或等于0\", \"小于0\"). A bare non-zero number is not money (30%, 4吉瓦, 2025年).\"\"\"\n   425\t    out = []\n   426\t    for match in AMOUNT_TOKEN.finditer(text):\n   427\t        number, unit, dollars = match.group(1), match.group(2), match.group(3)\n   428\t        value = float(Decimal(number.replace(',', '')) * UNIT_USD[unit])\n   429\t        following = text[match.end():match.end() + 1]\n   430\t        if unit is None and dollars is None and (value != 0 or following not in ('', '且', '、', '，', '；', '）', ' ', '美', '至', '到')):\n   431\t            continue          # 30%, 0%, 4吉瓦, 1个百分点, 2025年: not money\n   432\t        out.append((match.start(), match.end(), value))\n   433\t    return out\n   434\t\n   435\t\n   436\tdef band(condition):\n   437\t    \"\"\"(lo, lo_inclusive, hi, hi_inclusive) in USD, open ends as ±inf, read from the comparator words and the amount\n   438\t    each binds to (\"不低于 1650 亿美元且不高于 1690 亿美元\"), a range (\"650亿美元至720亿美元（含两端）\", \"0至不足1000亿\"),\n   439\t    a postfix (\"9000亿美元及以上\") or an exact amount (\"恰为2500亿美元\"). Remarks after ；or ， and parenthesised\n   440\t    asides are not read. None when the condition names no amount or reads inconsistently.\"\"\"\n   441\t    clause = operative_clause(condition or '')\n   442\t    inclusive_ends = bool(re.search(r'含两端|含端|包含两端', condition or ''))\n   443\t    amounts = _amounts(clause)\n   444\t    lo, lo_inc, hi, hi_inc, found = -INF, False, INF, False, False\n   445\t\n   446\t    def next_amount(after):\n   447\t        for start, end, value in amounts:\n   448\t            if start >= after:\n   449\t                return start, end, value\n   450\t        return None\n   451\t\n   452\t    for start, end, kind in _comparators(clause):\n   453\t        hit = next_amount(end)\n   454\t        if not hit or hit[0] - end > 40:\n   455\t            continue\n   456\t        value = hit[2]\n   457\t        if kind == 'exact':\n   458\t            return (value, True, value, True)\n   459\t        if kind == 'lo_inc':\n   460\t            lo, lo_inc = value, True\n   461\t        elif kind == 'lo_exc':\n   462\t            lo, lo_inc = value, False\n   463\t        elif kind == 'hi_inc':\n   464\t            hi, hi_inc = value, True\n   465\t        else:\n   466\t            hi, hi_inc = value, False\n   467\t        found = True\n   468\t    for start, end, value in amounts:\n   469\t        tail = clause[end:]\n   470\t        if POSTFIX_LO.match(tail):\n   471\t            lo, lo_inc, found = value, True, True\n   472\t        elif POSTFIX_HI.match(tail):\n   473\t            hi, hi_inc, found = value, True, True\n   474\t        sep = RANGE_SEP.match(tail)\n   475\t        if sep:\n   476\t            partner = next_amount(end + sep.end())\n   477\t            if partner and partner[0] == end + sep.end() and partner[2] > value:\n   478\t                lo, lo_inc, hi, found = value, True, partner[2], True\n   479\t                hi_inc = inclusive_ends or not re.search(r'不足|低于', sep.group(0))\n   480\t    if not found:\n   481\t        return None\n   482\t    if lo > hi or (lo == hi and not (lo_inc and hi_inc)):\n   483\t        return None\n   484\t    return (lo, lo_inc, hi, hi_inc)\n   485\t\n   486\t\n   487\tdef numeric_bands(rungs):\n   488\t    \"\"\"Bands from the rungs' own numeric bounds (keyed views): lower bound inclusive, upper exclusive, the two ends open;\n   489\t    None when a rung has no bounds.\"\"\"\n   490\t    if not rungs or any(r.get('lo') is None and r.get('hi') is None for r in rungs):\n   491\t        return None\n   492\t    out = {}\n   493\t    for r in rungs:\n   494\t        lo = -INF if r.get('lo') is None else float(r['lo']); hi = INF if r.get('hi') is None else float(r['hi'])\n   495\t        out[r['position']] = (lo, True, hi, False)\n   496\t    return out\n   497\t\n   498\t\n   499\tdef ladder_bands(rungs):\n   500\t    \"\"\"Every rung's band, or None with the reason when the ladder is not one unbroken partition by amount. Rungs that\n   501\t    carry numeric bounds are read from them; the prose parser serves the views written before keys.\"\"\"\n   502\t    numeric = numeric_bands(rungs)\n   503\t    if numeric is not None:\n   504\t        ordered = sorted(numeric.items(), key=lambda pb: pb[1][0])\n   505\t        for (p1, a), (p2, b) in zip(ordered, ordered[1:]):\n   506\t            if a[2] != b[0]:\n   507\t                return None, f'numeric bands of positions {p1} and {p2} overlap or leave a gap'\n   508\t        return numeric, None\n   509\t    bands = [(r['position'], band(r['condition'])) for r in rungs]\n   510\t    unreadable = [p for p, b in bands if b is None]\n   511\t    if unreadable:\n   512\t        return None, f'conditions not read as amounts: positions {unreadable}'\n   513\t    ordered = sorted(bands, key=lambda pb: (pb[1][0], pb[1][2]))\n   514\t    for (p1, a), (p2, b) in zip(ordered, ordered[1:]):\n   515\t        if a[2] != b[0] or a[3] == b[1]:          # adjacent bands share the boundary amount and exactly one of them owns it\n   516\t            return None, f'bands of positions {p1} and {p2} overlap or leave a gap'\n   517\t    lowest, highest = ordered[0][1], ordered[-1][1]\n   518\t    if not (lowest[0] == -INF or (lowest[0] == 0 and lowest[1])) or highest[2] != INF:     # an amount that cannot be negative may start at 0\n   519\t        return None, 'the ladder does not cover the line up to +inf'\n   520\t    return dict(bands), None\n   521\t\n   522\t\n   523\tdef _contains(b, yi):\n   524\t    lo, lo_inc, hi, hi_inc = b\n   525\t    return (lo < yi or (lo == yi and lo_inc)) and (yi < hi or (yi == hi and hi_inc))\n   526\t\n   527\t\n   528\tdef verdict_for(comparator, judged, yi):\n   529\t    \"\"\"Whether every value in the judged band satisfies the claim (holds), none does (not_yet), or some do.\"\"\"\n   530\t    lo, lo_inc, hi, hi_inc = judged\n   531\t    all_at_least = lo > yi or (lo == yi)                       # every value >= yi (lo == yi exclusive gives values > yi)\n   532\t    all_below = hi < yi or (hi == yi and not hi_inc)\n   533\t    if comparator == '>=':\n   534\t        return 'holds' if all_at_least else 'not_yet' if all_below else 'borderline'\n   535\t    if comparator == '<':\n   536\t        return 'holds' if all_below else 'not_yet' if all_at_least else 'borderline'\n   537\t    if lo == hi == yi:\n   538\t        return 'holds'\n   539\t    return 'borderline' if _contains(judged, yi) else 'not_yet'\n   540\t\n   541\t\n   542\tdef evaluate(conn, view_id, comparator, value_usd, as_of=None):\n   543\t    \"\"\"A claim \"quantity >= / < / = value\" against the view's ladder as of the day: the rung the threshold sits in,\n   544\t    the judged rung, and whether every value of the judged band satisfies the claim (holds), none does (not_yet), or\n   545\t    only some do (borderline). Only a ladder whose rungs read as one unbroken partition by amount is evaluated.\"\"\"\n   546\t    as_of = resolve_bound(conn, as_of)\n   547\t    if comparator not in COMPARATORS:\n   548\t        raise ValueError(f'comparator must be one of {COMPARATORS}')\n   549\t    record = view(conn, view_id, as_of)\n   550\t    if not record:\n   551\t        return None\n   552\t    yi = float(value_usd)          # bands are in USD too\n   553\t    bands, problem = ladder_bands(record['rungs'])\n   554\t    if bands is None:\n   555\t        return {'view_id': view_id, 'as_of': as_of, 'evaluable': False, 'reason': problem}\n   556\t    claim_position = next((p for p, b in bands.items() if _contains(b, yi)), None)\n   557\t    state = record['state']\n   558\t    if not state:\n   559\t        return {'view_id': view_id, 'as_of': as_of, 'evaluable': True, 'comparator': comparator, 'value_usd': value_usd, 'claim_position': claim_position, 'judged_position': None, 'verdict': 'not_judged'}\n   560\t    return {'view_id': view_id, 'as_of': as_of, 'evaluable': True, 'comparator': comparator, 'value_usd': value_usd,\n   561\t            'claim_position': claim_position, 'judged_position': state['position'], 'judged_label': state['label'], 'judged_condition': state['condition'],\n   562\t            'verdict': verdict_for(comparator, bands[state['position']], yi)}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc 'nl -ba src/hivemind/idea.py'","aggregated_output":"     1\t\"\"\"An idea mapped against the library in two model calls, with the service doing every lookup in between\n     2\t(docs/poc/idea-card.md, D112, D135). Call 1 breaks the idea into typed parts (object, what to look for, period,\n     3\ta search query) and reads a dollar claim. The service then searches once per part, keeps the candidates each part\n     4\tgot, and asks call 2 to map each part to its candidates and write the summary. The service admits only candidate\n     5\tids, follows the ledger's dependency graph from the mapped views to their upstream and downstream views, evaluates\n     6\tthe claim itself, and builds the card with every view in the front end's shape. An explicitly configured final\n     7\tcall writes the analyst summary after selection. The calls are archived; exact requests replay for $0.\"\"\"\n     8\timport json\n     9\timport re\n    10\timport time\n    11\t\n    12\tfrom . import bundle, config, idea_composite, model, search, service\n    13\tfrom .views import store\n    14\t\n    15\tDECOMPOSE = {\n    16\t    'type': 'object', 'additionalProperties': False, 'required': ['parts', 'claim'],\n    17\t    'properties': {\n    18\t        'parts': {'type': 'array', 'items': {'type': 'object', 'additionalProperties': False, 'required': ['object', 'looks_for', 'period', 'query'],\n    19\t                                             'properties': {'object': {'type': 'string'}, 'looks_for': {'type': 'string'}, 'period': {'type': 'string'}, 'query': {'type': 'string'}}}},\n    20\t        'claim': {'anyOf': [{'type': 'null'},\n    21\t                            {'type': 'object', 'additionalProperties': False, 'required': ['part', 'comparator', 'value_usd'],\n    22\t                             'properties': {'part': {'type': 'integer'}, 'comparator': {'type': 'string', 'enum': ['>=', '<', '=']}, 'value_usd': {'type': 'number'}}}]},\n    23\t    },\n    24\t}\n    25\tMAP = {\n    26\t    'type': 'object', 'additionalProperties': False, 'required': ['parts', 'summary'],\n    27\t    'properties': {\n    28\t        'parts': {'type': 'array', 'items': {'type': 'object', 'additionalProperties': False, 'required': ['index', 'views', 'why'],\n    29\t                                             'properties': {'index': {'type': 'integer'},\n    30\t                                                            'views': {'type': 'array', 'items': {'type': 'object', 'additionalProperties': False, 'required': ['view_id', 'fit'],\n    31\t                                                                                                 'properties': {'view_id': {'type': 'string'}, 'fit': {'type': 'string', 'enum': ['direct', 'driver', 'context']}}}},\n    32\t                                                            'why': {'type': 'string'}}}},\n    33\t        'summary': {'type': 'string'},\n    34\t    },\n    35\t}\n    36\tMAP_LEAN = {\n    37\t    'type': 'object', 'additionalProperties': False, 'required': ['parts', 'summary'],\n    38\t    'properties': {\n    39\t        'parts': {'type': 'array', 'items': {'type': 'object', 'additionalProperties': False, 'required': ['index', 'views'],\n    40\t                                             'properties': {'index': {'type': 'integer'},\n    41\t                                                            'views': {'type': 'array', 'items': {'type': 'object', 'additionalProperties': False, 'required': ['view_id', 'fit'],\n    42\t                                                                                                 'properties': {'view_id': {'type': 'string'}, 'fit': {'type': 'string', 'enum': ['direct', 'driver', 'context']}}}}}}},\n    43\t        'summary': {'type': 'string'},\n    44\t    },\n    45\t}\n    46\t\n    47\t\n    48\tdef full_payload(text, as_of, parts, candidates, idea_rows):\n    49\t    \"\"\"The mapping call's message up to idea-v7: every part with its candidates written out, then the idea's own rows.\"\"\"\n    50\t    return (f'Idea: {text}\\nDay: {as_of}\\n\\nParts and the candidates the library found for each:\\n'\n    51\t            + json.dumps([{'index': i, 'object': p['object'], 'looks_for': p['looks_for'], 'period': p['period'], 'candidates': candidates[i]} for i, p in enumerate(parts)], ensure_ascii=False)\n    52\t            + \"\\n\\nThe idea's own search results:\\n\" + json.dumps(idea_rows, ensure_ascii=False))\n    53\t\n    54\t\n    55\tdef lean_payload(text, as_of, parts, candidates, idea_rows):\n    56\t    \"\"\"The mapping call's message from idea-v8: parts carry candidate ids, every candidate is written once (measured\n    57\t    2026-10-24: 28 briefs per message, 15 distinct, 45% of the text a repeat), the idea's own results are ids.\"\"\"\n    58\t    table = {}\n    59\t    for rows in candidates + [idea_rows]:\n    60\t        for r in rows:\n    61\t            table.setdefault(r['view_id'], r)\n    62\t    return (f'Idea: {text}\\nDay: {as_of}\\n\\nParts and the ids of the candidates the library found for each:\\n'\n    63\t            + json.dumps([{'index': i, 'object': p['object'], 'looks_for': p['looks_for'], 'period': p['period'], 'candidates': [r['view_id'] for r in candidates[i]]} for i, p in enumerate(parts)], ensure_ascii=False)\n    64\t            + '\\n\\nThe candidates, each once:\\n' + json.dumps(list(table.values()), ensure_ascii=False)\n    65\t            + \"\\n\\nThe idea's own search results (ids):\\n\" + json.dumps([r['view_id'] for r in idea_rows]))\n    66\t\n    67\t\n    68\tMAP_CLAUSE = {\n    69\t    'type': 'object', 'additionalProperties': False, 'required': ['parts', 'summary'],\n    70\t    'properties': {\n    71\t        'parts': {'type': 'array', 'items': {'type': 'object', 'additionalProperties': False, 'required': ['index', 'views', 'why'],\n    72\t                                             'properties': {'index': {'type': 'integer'},\n    73\t                                                            'views': {'type': 'array', 'items': {'type': 'object', 'additionalProperties': False, 'required': ['view_id', 'fit', 'clause'],\n    74\t                                                                                                 'properties': {'view_id': {'type': 'string'}, 'fit': {'type': 'string', 'enum': ['direct', 'driver', 'context']},\n    75\t                                                                                                                'clause': {'type': 'string'}}}},\n    76\t                                                            'why': {'type': 'string'}}}},\n    77\t        'summary': {'type': 'string'},\n    78\t    },\n    79\t}\n    80\t\n    81\t# the mapping schema and payload shape belong to the prompt that describes them (an example is an instruction):\n    82\t# a prompt version not listed here uses the idea-v7 contract\n    83\tCONTRACTS = {'idea-v8': (MAP_LEAN, lean_payload), 'idea-v9': (MAP_LEAN, full_payload), 'idea-v10': (MAP_CLAUSE, full_payload), 'idea-v12': (MAP, lean_payload)}\n    84\tSUMMARY = {'type': 'object', 'additionalProperties': False, 'required': ['summary'],\n    85\t           'properties': {'summary': {'type': 'string'}}}\n    86\tMARKET_READING = re.compile(r'share price|stock price|price target|market cap|valuation|multiple|p/e\\b|股价|市值|估值', re.I)\n    87\tCJK = re.compile(r'[\\u4e00-\\u9fff]')\n    88\tYEAR = re.compile(r'(FY\\s?20\\d\\d|20\\d\\d)', re.I)\n    89\tMONEY_IN_IDEA = re.compile(r'\\$\\s?\\d|\\d[\\d,.]*\\s*(?:billion|bn|trillion|tn|million|mn|[bBmMtT]\\b|万亿|千亿|亿|万美元|美元|%)', re.I)\n    90\tNO_COST = {'usd': 0.0, 'input_tokens': 0, 'output_tokens': 0, 'seconds': 0.0, 'cached': False, 'turns': 0}\n    91\tPER_PART = 8          # candidates kept per part\n    92\tDRIVERS_PER_PART = 3  # the model orders drivers most direct first; the rest is noise on the canvas (measured 2026-10-24: six-driver parts on a one-line idea)\n    93\tIDEA_ROWS = 5         # candidates kept from the idea's own search\n    94\tMAX_PARTS = 4\n    95\t\n    96\t\n    97\tdef prompts(setting):\n    98\t    \"\"\"The two system prompts of the setting's file, split at the marker line.\"\"\"\n    99\t    with open(config.prompt_path(setting.prompt_version + '.txt'), encoding='utf-8') as handle:\n   100\t        decompose, _, mapping = handle.read().partition('=== map ===')\n   101\t    if not mapping.strip():\n   102\t        raise config.ConfigError(f'{setting.prompt_version}.txt has no \"=== map ===\" section')\n   103\t    return decompose.strip(), mapping.strip()\n   104\t\n   105\t\n   106\tdef object_list(ledger, as_of, aliases=None):\n   107\t    \"\"\"What the library covers, in one line: each object with open views as of the day and its count, then the\n   108\t    universe's objects with no view yet. About 250 characters on the sealed ledger against 5,095 for a full catalog.\"\"\"\n   109\t    as_of = service.resolve_bound(ledger, as_of)\n   110\t    counts, kinds = {}, {}\n   111\t    for record in service.views(ledger, None, as_of):\n   112\t        counts[record['object']] = counts.get(record['object'], 0) + 1\n   113\t        kinds[record['object']] = record['object_kind']\n   114\t    covered = '; '.join(f'{obj} ({kinds[obj]}) {n}' for obj, n in sorted(counts.items(), key=lambda kv: -kv[1]))\n   115\t    missing = sorted(o for o in (aliases or {}) if o not in counts)\n   116\t    return (f'Objects with open views as of {as_of} (object, kind, number of views): {covered}.'\n   117\t            + (f' Objects in the universe with no view yet: {\", \".join(missing)}.' if missing else ''))\n   118\t\n   119\t\n   120\tdef judged(ledger, view_id, as_of, detailed=False):\n   121\t    state = service.state_as_of(ledger, view_id, as_of)\n   122\t    if not state:\n   123\t        return None\n   124\t    rung = next((g for g in store.rungs_of(ledger, view_id) if g['position'] == state['position']), {})\n   125\t    result = {'position': state['position'], 'label': rung.get('label', '')}\n   126\t    if detailed:\n   127\t        result.update(condition=rung.get('condition', ''), day=state['judgement_day'], reasons=state['reasons'])\n   128\t    return result\n   129\t\n   130\t\n   131\tdef brief(ledger, results, as_of, detailed=False):\n   132\t    \"\"\"Candidate state at the requested date; analyst context is explicit and versioned by the caller.\"\"\"\n   133\t    as_of = service.resolve_bound(ledger, as_of)\n   134\t    records = []\n   135\t    for result in results:\n   136\t        record = {'view_id': result['view_id'], 'object': result['object'], 'looks_at': result['looks_at'],\n   137\t                  'judged': judged(ledger, result['view_id'], as_of, detailed)}\n   138\t        if detailed:\n   139\t            record['question'] = result['question']\n   140\t        records.append(record)\n   141\t    return records\n   142\t\n   143\t\n   144\tdef related_views(ledger, view_ids, as_of, exclude=()):\n   145\t    \"\"\"The given views' neighbours in the ledger's dependency graph, as of the day: what each depends on (upstream)\n   146\t    and what depends on it (downstream), with the judged position; `exclude` are views already on the card.\n   147\t    Deterministic and free; the model is not asked. The card follows the graph only from the views of the first\n   148\t    part, the thing the idea is about: from every mapped view it fanned out to 12 cards on a one-line idea.\"\"\"\n   149\t    as_of = service.resolve_bound(ledger, as_of)\n   150\t    out, seen = [], set(view_ids) | set(exclude)\n   151\t    for view_id in view_ids:\n   152\t        for dep in service.dependencies(ledger, view_id, as_of):\n   153\t            target = ledger.execute('select * from views where view_id=?', (dep['view_id'],)).fetchone()\n   154\t            if dep['view_id'] not in seen and target is not None and service.view_exists(ledger, target, as_of):\n   155\t                seen.add(dep['view_id'])\n   156\t                out.append({'view_id': dep['view_id'], 'via': view_id, 'relation': 'upstream', 'direction': dep['direction'], 'judged': judged(ledger, dep['view_id'], as_of)})\n   157\t        for other in service.dependants(ledger, view_id, as_of):\n   158\t            if other not in seen:\n   159\t                seen.add(other)\n   160\t                out.append({'view_id': other, 'via': view_id, 'relation': 'downstream', 'direction': None, 'judged': judged(ledger, other, as_of)})\n   161\t    return out\n   162\t\n   163\t\n   164\tdef service_direct(part, directs, looks_at):\n   165\t    \"\"\"The first part's direct view: among the views the model called direct, in the order the part's own search\n   166\t    ranked them, the first whose text carries the part's year (a fiscal year that covers the calendar year counts:\n   167\t    FY2027 for \"2026\"); a part that names no year takes the first. The model's label picks the quantity, the year\n   168\t    check and the search order keep the pick the same across samples. Until 2026-10-24 the rule took the top search\n   169\t    hit on object and year alone and overrode the model's label in 4 of 31 picks (TSMC capex → TSMC revenue, Meta\n   170\t    capex → total expenses, NVIDIA total revenue → a segment, Rubin revenue → total revenue); there is no object\n   171\t    test, because a theme's view (TSMC capex under supply-chain-shift) is a company part's direct view.\"\"\"\n   172\t    years = {y.upper().replace(' ', '') for y in YEAR.findall(part.get('period', '') + ' ' + part.get('looks_for', ''))}\n   173\t    covered = set(years)\n   174\t    for y in list(years):\n   175\t        if y.isdigit():\n   176\t            covered |= {f'FY{y}', f'FY{int(y) + 1}'}\n   177\t    for view_id in directs:\n   178\t        text_years = {y.upper().replace(' ', '') for y in YEAR.findall(looks_at.get(view_id) or '')}\n   179\t        if not years or covered & text_years:\n   180\t            return view_id\n   181\t    return None\n   182\t\n   183\t\n   184\tdef english(*fields):\n   185\t    return not any(CJK.search(str(f or '')) for f in fields)\n   186\t\n   187\t\n   188\tdef call_english(archive, cfg, setting, system, user, schema, name, transport, fields_of):\n   189\t    \"\"\"One model call whose answer must be English (D133): when a field comes back in Chinese the call is made once\n   190\t    more with the instruction repeated; the second answer stands either way, and the slip is counted.\"\"\"\n   191\t    made = [model.call(archive, cfg, setting, system, user, schema, name, 'idea', transport=transport)]\n   192\t    slips = 0\n   193\t    if not english(*fields_of(made[-1].data)):\n   194\t        slips = 1\n   195\t        made.append(model.call(archive, cfg, setting, system, user + '\\n\\nWrite every field in English.', schema, name, 'idea', transport=transport))\n   196\t        slips += 0 if english(*fields_of(made[-1].data)) else 1\n   197\t    return made, slips\n   198\t\n   199\t\n   200\tdef canonical_query(part, aliases=None):\n   201\t    \"\"\"The service's own query for a part: the object's id (a ticker or theme id, itself an alias the search boosts),\n   202\t    what the part looks for, the period. The model's free-text query varies between samples and so do its\n   203\t    candidates; this one does not (iteration 8).\"\"\"\n   204\t    return ' '.join(x for x in (part.get('object', ''), part.get('looks_for', ''), part.get('period', '')) if x).strip()\n   205\t\n   206\t\n   207\tdef merged(first, second, limit):\n   208\t    \"\"\"Two ranked lists interleaved without repeats, the first list's top first.\"\"\"\n   209\t    out, seen = [], set()\n   210\t    for a, b in zip(first + [None] * len(second), second + [None] * len(first)):\n   211\t        for r in (a, b):\n   212\t            if r is not None and r['view_id'] not in seen:\n   213\t                seen.add(r['view_id'])\n   214\t                out.append(r)\n   215\t    return out[:limit]\n   216\t\n   217\t\n   218\tdef read_idea(ledger, index, items, archive, cfg, text, as_of=None, k=10, aliases=None, semantic=True, transport=None, bundles=True, embed=search.openai_embeddings, on_progress=None):\n   219\t    \"\"\"The idea card: idea, what the idea's own search found, the reading (typed parts, the candidates each got, the\n   220\t    views each maps to, the summary, the claim), the related views from the dependency graph, the evaluation, every\n   221\t    view's bundle, the days, the trace of searches, and all call costs. No recorded view → no model call.\"\"\"\n   222\t    text = (text or '').strip()\n   223\t    if not text:\n   224\t        raise ValueError('an idea needs text')\n   225\t    as_of = service.resolve_bound(ledger, as_of)\n   226\t    report = on_progress or (lambda stage: None)\n   227\t    report('search')\n   228\t    found = search.search(ledger, index, text, k, as_of, aliases=aliases, semantic=semantic, embed=embed)\n   229\t    card = {'idea': {'text': text, 'as_of': as_of}, 'search': {'mode': found['mode'], 'candidates': [r['view_id'] for r in found['results'] or []]},\n   230\t            'reading': None, 'evaluation': None, 'related': [], 'views': [], 'days': bundle.days(ledger, as_of),\n   231\t            'no_recorded_view': found['results'] is None, 'cost': dict(NO_COST)}\n   232\t    if found['results'] is None:\n   233\t        return card\n   234\t    setting = cfg.idea\n   235\t    if setting is None:\n   236\t        raise config.ConfigError(f'config {cfg.version} has no idea setting')\n   237\t    decompose_prompt, map_prompt = prompts(setting)\n   238\t    started = time.time()\n   239\t    cost = dict(NO_COST)\n   240\t    cost['cached'] = True\n   241\t\n   242\t    def spend(answer):\n   243\t        cost['usd'] += answer.cost_usd\n   244\t        cost['input_tokens'] += answer.input_tokens\n   245\t        cost['output_tokens'] += answer.output_tokens\n   246\t        cost['turns'] += 1\n   247\t        cost['cached'] = cost['cached'] and answer.cached\n   248\t\n   249\t    # call 1: the parts\n   250\t    report('decompose')\n   251\t    user = f'Idea: {text}\\nDay: {as_of} (the library as judged on this day)\\n\\n{object_list(ledger, as_of, aliases)}'\n   252\t    made, slips = call_english(archive, cfg, setting, decompose_prompt, user, DECOMPOSE, 'idea_decompose', transport,\n   253\t                               lambda d: [f for p in d['parts'] for f in (p['looks_for'], p['period'])])\n   254\t    for answer in made:\n   255\t        spend(answer)\n   256\t    first = made[-1]\n   257\t    parts = [dict(p) for p in first.data['parts'][:MAX_PARTS]]\n   258\t    # the service: one search per part, the candidates each part got\n   259\t    report('retrieve')\n   260\t    detailed = setting.prompt_version == 'idea-v12'\n   261\t    idea_rows = brief(ledger, found['results'][:IDEA_ROWS], as_of, detailed)\n   262\t    trace, candidates, ranks = [], [], []\n   263\t    queries = [((part.get('query') or '').strip() or canonical_query(part, aliases), canonical_query(part, aliases)) for part in parts]\n   264\t    if semantic and found['mode'] == 'semantic':\n   265\t        search.warm_queries(index, [q for pair in queries for q in pair], embed)      # one embeddings round trip for every part instead of two per part\n   266\t    # a part's candidates: the service's canonical query and the model's own, interleaved (tried 2026-10-25 and dropped:\n   267\t    # the object's views ranked by the idea text alone lost the model's finds, gold direct right 17 → 15 of 19)\n   268\t    for i, (part, (query, own)) in enumerate(zip(parts, queries)):\n   269\t        hit = search.search(ledger, index, query, PER_PART, as_of, aliases=aliases, semantic=semantic, embed=embed)\n   270\t        steady = search.search(ledger, index, own, PER_PART, as_of, aliases=aliases, semantic=semantic, embed=embed) if own.lower() != query.lower() else hit\n   271\t        rows = brief(ledger, merged(steady['results'] or [], hit['results'] or [], PER_PART), as_of, detailed)\n   272\t        candidates.append(rows)\n   273\t        ranks.append({r['view_id']: n for n, r in enumerate(hit['results'] or [])})      # the part's own search order, the tie-break among the model's direct views\n   274\t        trace.append({'tool': 'search', 'part': i, 'query': query, 'canonical': own, 'returned': [r['view_id'] for r in rows]})\n   275\t    # call 2: the mapping\n   276\t    report('map')\n   277\t    map_schema, payload = CONTRACTS.get(setting.prompt_version, (MAP, full_payload))\n   278\t    user = payload(text, as_of, parts, candidates, idea_rows)\n   279\t    made, more = call_english(archive, cfg, setting, map_prompt, user, map_schema, 'idea_map', transport,\n   280\t                              lambda d: [d['summary'], *(p.get('why', '') for p in d['parts'])])\n   281\t    slips += more\n   282\t    for answer in made:\n   283\t        spend(answer)\n   284\t    second = made[-1]\n   285\t    # the service keeps the mapping honest: only candidates, in the parts' order; direct and driver views go on the\n   286\t    # canvas, context stays on the card; the first part's direct view is the service's own pick when the rule holds\n   287\t    idea_ids = {r['view_id'] for r in idea_rows}\n   288\t    looks_at = {r['view_id']: r['looks_at'] for rows in candidates + [idea_rows] for r in rows}\n   289\t    mapping = {m['index']: m for m in second.data['parts'] if isinstance(m.get('index'), int)}\n   290\t    parts_out, chosen, dropped, seen = [], [], [], set()\n   291\t    for i, part in enumerate(parts):\n   292\t        m = mapping.get(i, {'views': [], 'why': 'the mapping call did not answer this part'})\n   293\t        allowed = {r['view_id'] for r in candidates[i]} | idea_ids\n   294\t        market = bool(MARKET_READING.search(part.get('looks_for', '') or ''))\n   295\t        tiers = {'direct': [], 'driver': [], 'context': []}\n   296\t        directs = [v.get('view_id') for v in m.get('views') or [] if v.get('fit') == 'direct' and v.get('view_id') in allowed]\n   297\t        ordered = sorted(dict.fromkeys(directs), key=lambda v: (ranks[i].get(v, len(ranks[i])), directs.index(v)))\n   298\t        decided = service_direct(part, ordered, looks_at) if i == 0 and not market else None\n   299\t        if decided:\n   300\t            tiers['direct'].append(decided)\n   301\t        for v in m.get('views') or []:\n   302\t            view_id, fit = v.get('view_id'), v.get('fit', 'context')\n   303\t            if market:\n   304\t                dropped.append({'view_id': view_id, 'why': f'part {i} is a market reading ({part[\"looks_for\"][:50]}); the library holds no view on prices'})\n   305\t            elif view_id not in allowed:\n   306\t                dropped.append({'view_id': view_id, 'why': f'not among the candidates of part {i} ({part[\"looks_for\"][:60]})'})\n   307\t            elif all(view_id not in tiers[k] for k in tiers):\n   308\t                if fit == 'driver' and len(tiers['driver']) >= DRIVERS_PER_PART and not (\n   309\t                        cfg.idea_summary and cfg.idea_summary.prompt_version in ('idea-summary-v6', 'idea-summary-v7', 'idea-summary-v8')):\n   310\t                    tiers['context'].append(view_id)          # beyond the cap a driver is kept on the card, not the canvas\n   311\t                else:\n   312\t                    tiers[fit].append(view_id)\n   313\t        mapped = tiers['direct'] + tiers['driver']\n   314\t        parts_out.append({'index': i, 'object': part['object'], 'looks_for': part['looks_for'], 'period': part['period'], 'query': trace[i]['query'],\n   315\t                          'candidates': [r['view_id'] for r in candidates[i]], 'view_ids': mapped, 'direct': tiers['direct'], 'driver': tiers['driver'],\n   316\t                          'context': tiers['context'], 'service_direct': decided, 'market_reading': market,\n   317\t                          'clauses': {v['view_id']: v['clause'] for v in m.get('views') or [] if v.get('clause')},     # idea-v10: how each driver moves the part\n   318\t                          'why': 'a market reading: the library holds no view on prices' if market else m.get('why', '')})\n   319\t        for view_id in mapped:\n   320\t            if view_id not in seen:\n   321\t                seen.add(view_id)\n   322\t                chosen.append({'view_id': view_id, 'why': m.get('why', ''), 'part': part['looks_for'], 'fit': 'direct' if view_id in tiers['direct'] else 'driver'})\n   323\t    # the claim: the idea must state an amount; the claimed part must map to a view; the service evaluates\n   324\t    claim, evaluation = first.data['claim'], None\n   325\t    if claim is not None:\n   326\t        if not MONEY_IN_IDEA.search(text):\n   327\t            dropped.append({'view_id': None, 'why': 'the claim states an amount the idea does not'})\n   328\t            claim = None\n   329\t        elif not (0 <= claim['part'] < len(parts_out)):\n   330\t            dropped.append({'view_id': None, 'why': 'the claim names a part that does not exist'})\n   331\t        elif parts_out[claim['part']]['market_reading']:\n   332\t            dropped.append({'view_id': None, 'why': 'the claim is about a market price; the library holds no view on prices'})\n   333\t        elif not parts_out[claim['part']]['direct']:\n   334\t            dropped.append({'view_id': None, 'why': 'the claimed part has no direct view; a driver is not the quantity the idea names'})\n   335\t        else:\n   336\t            claim = dict(claim, view_id=parts_out[claim['part']]['direct'][0])\n   337\t            evaluation = service.evaluate(ledger, claim['view_id'], claim['comparator'], float(claim['value_usd']), as_of)\n   338\t    related = related_views(ledger, parts_out[0]['view_ids'] if parts_out else [], as_of, exclude=[c['view_id'] for c in chosen])\n   339\t    summary = second.data['summary']\n   340\t    composite = None\n   341\t    if cfg.idea_summary is not None:\n   342\t        report('summarize')\n   343\t        summary_setting = cfg.idea_summary\n   344\t        with open(config.prompt_path(summary_setting.prompt_version + '.txt'), encoding='utf-8') as handle:\n   345\t            summary_prompt = handle.read().strip()\n   346\t        records = {r['view_id']: r for r in service.summaries(ledger, as_of)}\n   347\t        context = {'idea': text, 'as_of': as_of, 'evaluation': evaluation,\n   348\t                   'parts': [{key: part[key] for key in ('object', 'looks_for', 'period', 'direct', 'driver', 'context', 'why')} for part in parts_out],\n   349\t                   'theses': brief(ledger, [records[c['view_id']] for c in chosen], as_of, detailed=True)}\n   350\t        composite_contract = idea_composite.contract(summary_setting.prompt_version, chosen, ledger)\n   351\t        if composite_contract:\n   352\t            context['theses'] = idea_composite.add_ladders(ledger, context['theses'], endpoints_only=summary_setting.prompt_version in ('idea-summary-v5', 'idea-summary-v6', 'idea-summary-v7', 'idea-summary-v8'))\n   353\t            for part in context['parts']:\n   354\t                del part['why']\n   355\t            if summary_setting.prompt_version in ('idea-summary-v7', 'idea-summary-v8'):\n   356\t                context['candidate_theses'] = context.pop('theses')\n   357\t        schema, prose, bind_composite = composite_contract or (SUMMARY, lambda d: [d['summary']], None)\n   358\t        made, more = call_english(archive, cfg, summary_setting, summary_prompt, json.dumps(context, ensure_ascii=False),\n   359\t                                  schema, 'idea_summary', transport, prose)\n   360\t        slips += more\n   361\t        for answer in made:\n   362\t            spend(answer)\n   363\t        summary = made[-1].data['summary']\n   364\t        if bind_composite:\n   365\t            composite = bind_composite(made[-1].data, chosen, records, as_of)\n   366\t            if composite['version'] == 'idea-composite/4':\n   367\t                mapped = {entry['view_id']: entry for entry in chosen}\n   368\t                chosen = [mapped[entry['thesis_id']] for entry in composite['drivers']]\n   369\t                adopted = {entry['view_id'] for entry in chosen}\n   370\t                for part in parts_out:\n   371\t                    for key in ('view_ids', 'direct', 'driver', 'context'):\n   372\t                        part[key] = [ident for ident in part[key] if ident in adopted]\n   373\t                    if part['service_direct'] not in adopted:\n   374\t                        part['service_direct'] = None\n   375\t                    part['clauses'] = {ident: clause for ident, clause in part['clauses'].items() if ident in adopted}\n   376\t                if claim and claim['view_id'] not in adopted:\n   377\t                    claim, evaluation = None, None\n   378\t                related = []\n   379\t    card['reading'] = {'summary': summary, 'parts': parts_out, 'chosen': chosen, 'claim': claim, 'dropped': dropped, 'trace': trace, 'language_slips': slips}\n   380\t    if composite is not None:\n   381\t        card['reading']['composite'] = composite\n   382\t    card['evaluation'] = evaluation\n   383\t    card['related'] = related\n   384\t    if bundles:        # a page that fetches /thesis-bundles itself asks for the card alone: 20 KB instead of 2.7 MB\n   385\t        item_of = bundle.item_lookup(items)\n   386\t        card['views'] = [bundle.view_bundle(ledger, item_of, view_id, as_of) for view_id in [c['view_id'] for c in chosen] + [r['view_id'] for r in related]]\n   387\t    cost['seconds'] = round(time.time() - started, 1)\n   388\t    card['cost'] = cost\n   389\t    return card\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc 'nl -ba src/hivemind/bundle.py'","aggregated_output":"     1\t\"\"\"One view in the shape the front end reads: the ladder, every judgement round with the model's reason and the\n     2\tevidence it cited, the evidence in force with tiers, speakers and sources, dependencies, replacements and the freeze\n     3\tswitches. The same shaping writes the mock's data file (scripts/mock_data.py) and answers POST /ideas, so the front\n     4\tend's adapter reads both. Read-only on every database. With `as_of`, rows written after that day are left out.\"\"\"\n     5\timport json\n     6\tfrom contextlib import contextmanager\n     7\tfrom datetime import date\n     8\t\n     9\tfrom . import service\n    10\tfrom .views import store\n    11\t\n    12\t\n    13\t@contextmanager\n    14\tdef read_snapshot(*connections):\n    15\t    \"\"\"Pin each read connection for a complete envelope; preserve a caller's transaction.\"\"\"\n    16\t    owned = []\n    17\t    try:\n    18\t        for conn in connections:\n    19\t            if conn is not None and not conn.in_transaction:\n    20\t                conn.execute('begin')\n    21\t                owned.append(conn)\n    22\t        yield\n    23\t    finally:\n    24\t        for conn in reversed(owned):\n    25\t            conn.rollback()\n    26\t\n    27\t\n    28\tdef item_lookup(items_db):\n    29\t    \"\"\"input id → title, publisher and category of a stored item, from the items database (or the id alone when the\n    30\t    database is not given or does not hold it).\"\"\"\n    31\t    cache = {}\n    32\t\n    33\t    def item_of(input_id):\n    34\t        if input_id not in cache:\n    35\t            row = items_db.execute('select title, publisher, publisher_type, category, publication_day, source_uri from items where input_id=?', (input_id,)).fetchone() if items_db is not None else None\n    36\t            cache[input_id] = dict(row) if row else {'title': input_id, 'publisher': '', 'publisher_type': '', 'category': '', 'publication_day': '', 'source_uri': ''}\n    37\t        return cache[input_id]\n    38\t    return item_of\n    39\t\n    40\t\n    41\tdef _visible(views_db, seq, as_of):\n    42\t    return as_of is None or service.visible(views_db, seq, as_of)\n    43\t\n    44\t\n    45\tdef ladder_row(views_db, view_id):\n    46\t    \"\"\"The view's ladder as the new system's writer stored it (`clean_ladders`, written in the view's own call): the parsed\n    47\t    ladder; 'no table' for a store without that table (a legacy ledger); 'no row' when the store has the table and no row for the\n    48\t    view. A row that is not readable JSON with a ladder, or two rows for one view, is refused.\"\"\"\n    49\t    if not views_db.execute(\"select 1 from sqlite_master where type='table' and name='clean_ladders'\").fetchone():\n    50\t        return 'no table'\n    51\t    rows = views_db.execute('select checked_answer from clean_ladders where view_id=?', (view_id,)).fetchall()\n    52\t    if not rows:\n    53\t        return 'no row'\n    54\t    if len(rows) > 1:\n    55\t        raise ValueError(f'{view_id}: {len(rows)} ladder rows for one view')\n    56\t    try:\n    57\t        ladder = json.loads(rows[0][0])['ladder']\n    58\t    except (TypeError, ValueError, KeyError) as error:\n    59\t        raise ValueError(f'{view_id}: its ladder row holds no readable ladder ({error!r})')\n    60\t    if not isinstance(ladder, dict):\n    61\t        raise ValueError(f'{view_id}: its ladder row holds no readable ladder')\n    62\t    return ladder\n    63\t\n    64\t\n    65\tdef not_judged(views_db, view_id, created_seq, as_of=None):\n    66\t    \"\"\"D397: the parts of a topic its one judged question leaves out, with their reasons, from the view's ladder row. None for a\n    67\t    legacy ledger, for a view with no row, and before the view's creation at as_of; [] when the row lists none. A malformed row,\n    68\t    or two rows for one view, is refused. Called directly for a view not visible at the resolved bound, it refuses the view\n    69\t    (OPERATING-CONTRACT.md, row 3), so a question created after that day is never returned.\"\"\"\n    70\t    as_of = service.resolve_bound(views_db, as_of, unfiltered=True)\n    71\t    if as_of is not None and not _visible(views_db, created_seq, as_of):\n    72\t        raise KeyError(f'{view_id} is not available as of {as_of}')\n    73\t    ladder = ladder_row(views_db, view_id)\n    74\t    if ladder in ('no table', 'no row'):\n    75\t        return None\n    76\t    parts = ladder.get('not_judged')\n    77\t    if not isinstance(parts, list) or not all(isinstance(p, dict) and isinstance(p.get('part'), str) and isinstance(p.get('why'), str) for p in parts):\n    78\t        raise ValueError(f'{view_id}: its parts not judged are not a list of {{part, why}} texts')\n    79\t    return [{'part': p['part'], 'why': p['why']} for p in parts]\n    80\t\n    81\t\n    82\tdef answer_shape(views_db, view_id):\n    83\t    \"\"\"(shape, favourable end) of the view's answer choices, as the page needs them to read the stored labels without inventing a\n    84\t    direction (page-contract/DESIGN.md): (None, None) for a legacy ledger; ('unrecorded', None) for a view with no row in a store\n    85\t    that has rows; ('event', None) or ('figure', 'higher' | 'lower' | 'n/a') from the row. Not suppressed before creation: it says\n    86\t    how to read the labels, which are shown as they are.\"\"\"\n    87\t    ladder = ladder_row(views_db, view_id)\n    88\t    if ladder == 'no table':\n    89\t        return None, None\n    90\t    if ladder == 'no row':\n    91\t        return 'unrecorded', None\n    92\t    if ladder.get('event'):\n    93\t        return 'event', None\n    94\t    figure = ladder.get('figure')\n    95\t    if isinstance(figure, dict) and figure.get('favourable_end') in ('higher', 'lower', 'n/a'):\n    96\t        return 'figure', figure['favourable_end']\n    97\t    raise ValueError(f'{view_id}: its ladder row is neither an event nor a figure with a favourable end')\n    98\t\n    99\t\n   100\tdef view_bundle(views_db, item_of, view_id, as_of=None):\n   101\t    \"\"\"One view's complete record as of the bound (resolved; an omitted bound on a store with no completed day reads every\n   102\t    record, as before). A view not visible at the bound is refused (OPERATING-CONTRACT.md, row 3).\"\"\"\n   103\t    as_of = service.resolve_bound(views_db, as_of, unfiltered=True)\n   104\t    v = views_db.execute('select * from views where view_id=?', (view_id,)).fetchone()\n   105\t    if v is None:\n   106\t        raise KeyError(view_id)\n   107\t    if as_of is not None and not service.view_exists(views_db, v, as_of):\n   108\t        raise KeyError(f'{view_id} is not available as of {as_of}')\n   109\t    columns = {r[1] for r in views_db.execute('pragma table_info(rungs)')}\n   110\t    bounds = ', lo, hi' if {'lo', 'hi'} <= columns else ''          # a ledger written before keys has no bounds; the adapter then reads the prose\n   111\t    rungs = [dict(r) for r in views_db.execute(f'select position, label, condition{bounds} from rungs where view_id=? order by position', (view_id,))]\n   112\t    switches = [dict(r) for r in views_db.execute('select open, reason, after_seq from view_switches where view_id=? order by id', (view_id,))\n   113\t                if _visible(views_db, r['after_seq'], as_of)]\n   114\t    for switch in switches:\n   115\t        switch['day'] = service.day_of_seq(views_db, switch['after_seq'])\n   116\t    judgements = []\n   117\t    for j in views_db.execute('select * from judgements where view_id=? order by judgement_id', (view_id,)):\n   118\t        if as_of is not None and j['publication_day'] > as_of:\n   119\t            continue\n   120\t        judgements.append({'id': str(j['judgement_id']), 'day': j['publication_day'], 'seq': j['seq'], 'rung': j['rung'], 'changed': bool(j['changed']),\n   121\t                           'why_changed': j['why_changed'], 'reasons': j['reasons'], 'cited': list(dict.fromkeys(json.loads(j['cited_evidence_json'] or '[]'))),   # each id once (UI contract uniqueItems); the sealed 2026-10-28 ledger holds one judgement citing an id twice\n   122\t                           'cited_views': json.loads(j['cited_views_json'] or '[]'), 'pushes': json.loads(j['pushes_json'] or '[]'),\n   123\t                           'from_item': j['input_id']})\n   124\t    evidence = []\n   125\t    for e in views_db.execute('select e.*, l.seq as linked_seq from evidence_links l join evidence e on e.evidence_id=l.evidence_id where l.view_id=? order by l.id', (view_id,)):\n   126\t        if not _visible(views_db, e['linked_seq'], as_of):\n   127\t            continue\n   128\t        sources = [dict(s) for s in views_db.execute('select input_id, publication_day, seq from evidence_sources where evidence_id=? order by id', (e['evidence_id'],))\n   129\t                   if _visible(views_db, s['seq'], as_of)]\n   130\t        replaced_by = views_db.execute('select new_evidence_id, said_day, seq from replacements where old_evidence_id=? order by id desc limit 1', (e['evidence_id'],)).fetchone()\n   131\t        if replaced_by is not None and not _visible(views_db, replaced_by['seq'], as_of):\n   132\t            replaced_by = None\n   133\t        replaces = views_db.execute('select old_evidence_id, seq from replacements where new_evidence_id=?', (e['evidence_id'],)).fetchone()\n   134\t        if replaces and not _visible(views_db, replaces['seq'], as_of):\n   135\t            replaces = None\n   136\t        first = sources[0] if sources else {'input_id': e['created_from_input'], 'publication_day': '', 'seq': e['created_seq']}\n   137\t        item = item_of(first['input_id'])\n   138\t        evidence.append({'id': e['evidence_id'], 'one_line': e['one_line'], 'quote': e['quote'], 'tier': e['tier'], 'speaker': e['speaker'],\n   139\t                         'original_who': e['original_who'], 'original_day': e['original_day'], 'event_time': e['event_time'],\n   140\t                         'day': first['publication_day'] or item['publication_day'], 'seq': first['seq'], 'linked_seq': e['linked_seq'],\n   141\t                         'arrival_day': service.day_of_seq(views_db, e['linked_seq']),\n   142\t                         'source': {'title': item['title'], 'publisher': item['publisher'], 'publisher_type': item['publisher_type'],\n   143\t                                    'category': item['category'], 'uri': item['source_uri']},\n   144\t                         'sources': [{'input_id': s['input_id'], 'day': s['publication_day'],\n   145\t                                      'arrival_day': service.day_of_seq(views_db, s['seq']),\n   146\t                                      'source': item_of(s['input_id'])} for s in sources],\n   147\t                         'outlets': len(sources), 'replaced_by': {'new_evidence_id': replaced_by['new_evidence_id'], 'said_day': replaced_by['said_day'],\n   148\t                                                               'day': service.day_of_seq(views_db, replaced_by['seq'])} if replaced_by else None,\n   149\t                         'replaces': replaces['old_evidence_id'] if replaces else None})\n   150\t    dependencies = [dict(r) for r in views_db.execute('select dependency_id, depends_on, direction, wait_chain_view_id, wait_year, seq from dependencies where view_id=? order by dependency_id', (view_id,))\n   151\t                    if _visible(views_db, r['seq'], as_of)]\n   152\t    for dependency in dependencies:\n   153\t        dependency['day'] = service.day_of_seq(views_db, dependency['seq'])\n   154\t        dependency['resolutions'] = [dict(target=r['resolved_to'], day=service.day_of_seq(views_db, r['seq']), seq=r['seq'])\n   155\t                                    for r in views_db.execute('select resolved_to, seq from dependency_resolutions where dependency_id=? order by id', (dependency['dependency_id'],))\n   156\t                                    if _visible(views_db, r['seq'], as_of)]\n   157\t    dependants = sorted({r['view_id'] for r in views_db.execute('select view_id, seq from dependencies where depends_on=?', (view_id,)) if _visible(views_db, r['seq'], as_of)},\n   158\t                        key=lambda s: (len(s), s))\n   159\t    created = item_of(v['created_from_input'])\n   160\t    key = store.view_key(views_db, view_id)\n   161\t    identity = {name: key[name] for name in ('measure', 'scope', 'period_start', 'period_end', 'basis', 'unit', 'event_type')} if key else None\n   162\t    successions = [{'thesis_id': r['succeeds'] if r['view_id'] == view_id else r['view_id'],\n   163\t                    'relation': 'previous' if r['view_id'] == view_id else 'next',\n   164\t                    'day': service.day_of_seq(views_db, r['seq'])}\n   165\t                   for r in views_db.execute('select * from successions where view_id=? or succeeds=? order by id', (view_id, view_id))\n   166\t                   if _visible(views_db, r['seq'], as_of)]\n   167\t    return {'view_id': view_id, 'object': v['object_id'], 'kind': v['kind'], 'looks_at': v['looks_at'], 'question': v['question'],\n   168\t            'due_day': v['due_day'], 'year': v['year'], 'identity': identity, 'successions': successions,\n   169\t            'created_seq': v['created_seq'], 'created_day': service.day_of_seq(views_db, v['created_seq']),\n   170\t            'created_from': {'title': created['title'], 'publisher': created['publisher'], 'category': created['category']},\n   171\t            'rungs': rungs, 'open': not any(not s['open'] for s in switches), 'switches': switches,\n   172\t            'judgements': judgements, 'evidence': evidence, 'dependencies': dependencies, 'dependants': dependants,\n   173\t            'not_judged': not_judged(views_db, view_id, v['created_seq'], as_of),\n   174\t            **dict(zip(('answer_shape', 'favourable_end'), answer_shape(views_db, view_id)))}\n   175\t\n   176\t\n   177\tdef days(views_db, as_of=None):\n   178\t    \"\"\"The completed days the front end's time axis runs over, up to as_of.\"\"\"\n   179\t    as_of = service.resolve_bound(views_db, as_of, unfiltered=True)\n   180\t    return [r[0] for r in views_db.execute('select day from days_completed order by day') if as_of is None or r[0] <= as_of]\n   181\t\n   182\t\n   183\tdef _bundles(views_db, items_db, view_ids, as_of=None, coverage='selection'):\n   184\t    \"\"\"Complete, dated UI inputs for caller-selected theses; no search, model call or ledger write. Its bound is already resolved\n   185\t    by its caller (`thesis_bundles`, `library`).\"\"\"\n   186\t    date.fromisoformat(as_of)\n   187\t    if not isinstance(view_ids, list) or not view_ids or any(not isinstance(id, str) or not id for id in view_ids):\n   188\t        raise ValueError('thesis_bundles needs a non-empty list of view ids')\n   189\t    lookup = item_lookup(items_db)\n   190\t    records = []\n   191\t    for view_id in dict.fromkeys(view_ids):\n   192\t        row = views_db.execute('select * from views where view_id=?', (view_id,)).fetchone()\n   193\t        if row is None or not service.view_exists(views_db, row, as_of):\n   194\t            raise KeyError(f'{view_id} is not available as of {as_of}')\n   195\t        records.append(view_bundle(views_db, lookup, view_id, as_of))\n   196\t    return {'as_of': as_of, 'days': days(views_db, as_of), 'views': records,\n   197\t            'coverage': coverage, 'groups': research_groups(views_db, view_ids, as_of)}\n   198\t\n   199\t\n   200\tdef research_groups(conn, view_ids, as_of):\n   201\t    \"\"\"Stored groups, with dated memberships limited to the envelope's loaded theses.\"\"\"\n   202\t    if not conn.execute('pragma table_info(thesis_groups)').fetchone():\n   203\t        return []\n   204\t    loaded = set(view_ids)\n   205\t    result = []\n   206\t    for row in conn.execute('select * from thesis_groups order by created_seq, rowid'):\n   207\t        if not service.visible(conn, row['created_seq'], as_of):\n   208\t            continue\n   209\t        members = [{'thesis_id': m['view_id'], 'day': service.day_of_seq(conn, m['seq']), 'basis': m['basis'] or ''}\n   210\t                   for m in conn.execute('select * from thesis_group_members where group_id=? order by id', (row['group_id'],))\n   211\t                   if m['view_id'] in loaded and service.visible(conn, m['seq'], as_of)]\n   212\t        if members:\n   213\t            result.append({'id': row['group_id'], 'name': row['name'], 'scope': row['scope'],\n   214\t                           'aliases': json.loads(row['aliases'] or '[]') if 'aliases' in row.keys() else [],\n   215\t                           'created_day': service.day_of_seq(conn, row['created_seq']), 'members': members})\n   216\t    return result\n   217\t\n   218\t\n   219\tdef thesis_bundles(views_db, items_db, view_ids, as_of=None):\n   220\t    \"\"\"Selected complete thesis records, pinned to one read transaction.\"\"\"\n   221\t    with read_snapshot(views_db, items_db):\n   222\t        return _bundles(views_db, items_db, view_ids, service.resolve_bound(views_db, as_of))\n   223\t\n   224\t\n   225\tdef library(views_db, items_db, as_of=None):\n   226\t    \"\"\"All theses, including closed ones, and stored groups; no search or model call.\"\"\"\n   227\t    with read_snapshot(views_db, items_db):\n   228\t        as_of = service.resolve_bound(views_db, as_of)\n   229\t        if not as_of:\n   230\t            raise ValueError('The library has no completed day; supply as_of')\n   231\t        date.fromisoformat(as_of)\n   232\t        view_ids = [r['view_id'] for r in views_db.execute('select * from views order by created_seq, rowid')\n   233\t                    if service.view_exists(views_db, r, as_of)]\n   234\t        if not view_ids:\n   235\t            return {'as_of': as_of, 'days': days(views_db, as_of), 'views': [], 'coverage': 'library', 'groups': []}\n   236\t        return _bundles(views_db, items_db, view_ids, as_of, coverage='library')\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_11","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba docs/DECISIONS-log.md | sed -n '10991,11019p;11656,11666p;11807,11849p'; rg -n '## D439|release work|release-prep' docs/CURRENT_STATE.md docs/DECISIONS-log.md | tail -35\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba docs/DECISIONS-log.md | sed -n '10991,11019p;11656,11666p;11807,11849p'; rg -n '## D439|release work|release-prep' docs/CURRENT_STATE.md docs/DECISIONS-log.md | tail -35\"","aggregated_output":" 10991\t## D726 · 2026-11-22 · Alex opens a judge version for related number questions ($0 gate first) and agrees to \"Forecast unavailable\" as the first-release interim\n 10992\t\n 10993\t- **The questions** (after D725):\n 10994\t  - \"要不要开一个新的判官版本来试修法（相关的题合在一次里算，每个数字标明出处，程序检查算术和出处）？\" Options: 开，先做 0 元那一关\n 10995\t    (recommended: the format and checks designed and through the council, then the $0 gate on five stored cases, four gold controls and\n 10996\t    three planted errors; the paid gate asks Alex for its ceiling); 先不开.\n 10997\t  - \"第一版上线前的过渡：数字题只显示问题和来源，档位和预测文字写成'预测暂缺'，等通过检查再放出来。你同意这个做法吗？\" Options: 同意\n 10998\t    (recommended); 暂不定.\n 10999\t- **Alex's answers** (2026-11-22): \"开，先做 0 元那一关 (推荐)\"; \"同意 (推荐)\".\n 11000\t- **Decided (Alex):**\n 11001\t  - A new judge version is opened for the bounded test of D725: related number questions judged together, with labelled figures and\n 11002\t    code checks of identity and arithmetic. It is designed and reviewed at $0, then the $0 gate runs. The paid gate needs Alex's\n 11003\t    ceiling.\n 11004\t  - Until the number answers pass, a first release shows number questions with their sources and \"Forecast unavailable\": the band, the\n 11005\t    forecast text and its history withheld together. It is built with the release work, which is not started.\n 11006\t- poc-v118 stays the product.\n 11007\t\n 11008\t## D727 · 2026-11-22 · judging-v13's $0 gate: the design passed council (round 46e); gate runs 1–6 and council rounds 46f–46j; the gate is not yet passed; one choice goes to Alex\n 11009\t\n 11010\t- **Design:** `docs/research/2026-11-22-number-answers/DESIGN.md`, v1 to v9. Council rounds 46 to 46e reached READY FOR THE $0 GATE on v5.\n 11011\t  - **v3's structural rule:** code derives every relation it checks from the calculation graph and the passage text.\n 11012\t- **The gate** (`gate.py`, `calc_check.py`, `mutants.py`, `render_v13.py`, `judging-v13-draft.txt`, `REQUEST-AUDIT.md`), all harness-only\n 11013\t  and $0.\n 11014\t  - **Run 1 failed** on the gold's q19 (revenue over a per-unit price). The per-unit identity was added.\n 11015\t  - **Runs 2 to 6** pass the registered items, the fixtures growing from 29 to 41 as each council round added variants.\n 11016\t  - **The mutants:** 15 of 15 are caught, and the unmutated control passes.\n 11017\t  - **The rendered request:** one stored family (old-2 at 09-20) is rendered: system text 4,835 characters (v7 4,924), user message\n 11018\t    123,304 characters, 237 evidence items. A conforming answer passes the schema and the checks.\n 11019\t- **What it established:**\n 11656\t## D750 · 2026-11-23 · The D749 writer test is INCONCLUSIVE with no failed line; council 65 (under D439): one bullet-2 sentence on reaffirmed targets, then a second $0 writer test\n 11657\t\n 11658\t- **Alex's direction** (2026-11-23, before sleeping): \"你接下来开始自行收敛，方向吧，我要准备睡了，所以这边的决策交给你，还有 Council， 记得不要 Scope Drift， 我们的目标是把剩下有问题的地方收敛起来，然后准备要往 Production 方向去走了，所以你自己每次复习的时候看 Log， 看我们试过了哪些东西，不要犯一模一样的错误，然后赶紧的往收敛方向去做测量和把它定下来。\"\n 11659\t  - D439 governs: the council decides reversibly, no paid send (its ceiling is spent), nothing committed.\n 11660\t- **The result** (`docs/research/2026-11-22-number-answers/BLIND5-RESULT.md`; run `poc/data/judging-v13s-blind5-2026-11-23/`):\n 11661\t  - **The repair worked where it was aimed.**\n 11662\t    - E's Codex writer, which invented a cut in both earlier runs, now answers a justified unresolved, accepted by both families.\n 11663\t    - Both P-v8 replies are supported forecasts.\n 11664\t    - Both controls were caught: the invented cut settled no, and the impossible floor was upheld by both adjudicators.\n 11665\t    - No fresh defect, no refusal. S's Codex forecast is supported.\n 11666\t  - **Two splits:**\n 11807\t    request/checker mismatch on a displayed period.\n 11808\t  - On E, luna gave a number all three times. Two crossed below $40B through unsized cuts; one ($43B) was accepted.\n 11809\t- **The design point.** Readers found conflicting numbers in 8 of 9 separate pairs and 0 of 9 joint pairs. That supports D725's\n 11810\t  consistency claim, not accuracy or readiness.\n 11811\t- **Council round 71** (`codex-r71.md`) reached consensus with Claude:\n 11812\t  - the STOP is right;\n 11813\t  - close the v13s judge line at STOP;\n 11814\t  - the first release carries D726: number questions show their sources and \"Forecast unavailable\", with the range, forecast text and\n 11815\t    history withheld together.\n 11816\t  - **The one next step, when Alex opens release work:** a $0 check of the reader's screen on a stored number question with a forecast\n 11817\t    and history.\n 11818\t  - **Needs Alex:** any further paid send, any effort, model or provider change, and any new judge version.\n 11819\t  - Open checker defects are recorded in `PAID-V13S-RESULT.md` §5.\n 11820\t- **Under D439** this is reversible: nothing is built into production, and poc-v118 stays the product (D690). It goes to Alex with\n 11821\t  the readings, as `PAID-GATE.md` §5 registers.\n 11822\t\n 11823\t## D756 · 2026-11-23 · Alex closes the v13s line; the first release shows number questions as \"Forecast unavailable\"\n 11824\t\n 11825\t- **The question** (after D755): \"付费重发的结论是“停”：luna 在新格式下格式错误多（36 个首发里 22 个被拒），在说不清的题上还会硬给数；不过“两题合在一起算”确实避免了自相矛盾。数字题这条线下一步怎么走？\"\n 11826\t  - Options:\n 11827\t    - \"结束这条线，预测暂缺上线 (推荐)\": the council's consensus;\n 11828\t    - \"换更强的模型再小测一次\": a stronger model or higher effort, with a small paid probe and a cap Alex names;\n 11829\t    - \"先停，我想谈谈\".\n 11830\t- **Alex's answer** (2026-11-23): \"结束这条线，预测暂缺上线 (推荐)\".\n 11831\t- **Decided (Alex):**\n 11832\t  - The v13s judge line ends at its STOP. Nothing from it enters the product, and poc-v118 stays the product (D690).\n 11833\t  - The first release carries D726: number questions show the question and its sources with \"Forecast unavailable\", the band, the\n 11834\t    forecast text and the history withheld together.\n 11835\t  - The one next step, when release work opens, is a $0 check of the reader's screen on a stored number question that has a\n 11836\t    forecast and history: only the question, its sources and \"Forecast unavailable\" appear.\n 11837\t- **Kept for the record, not built:**\n 11838\t  - the D725 consistency finding (separate answers contradicted each other in 8 of 9 pairs, joint answers in none);\n 11839\t  - the open checker defects in `PAID-V13S-RESULT.md` §5;\n 11840\t  - the v13s request and harness in `docs/research/2026-11-22-number-answers/`.\ndocs/CURRENT_STATE.md:448:**The one next task: when release work opens, a $0 check of the reader's screen for number questions (D756).** On a stored number\ndocs/CURRENT_STATE.md:453:- **No release work is open yet.** No other task is queued on the number-answer line.\ndocs/CURRENT_STATE.md:459:unavailable\". When release work opens, the first step is a $0 check of the reader's screen.\ndocs/DECISIONS-log.md:4871:## D439 · 2026-11-13 · While Alex is not active, the council decides by consensus and the loop iterates to the PRD's production goals\ndocs/DECISIONS-log.md:11005:    forecast text and its history withheld together. It is built with the release work, which is not started.\ndocs/DECISIONS-log.md:11816:  - **The one next step, when Alex opens release work:** a $0 check of the reader's screen on a stored number question with a forecast\ndocs/DECISIONS-log.md:11835:  - The one next step, when release work opens, is a $0 check of the reader's screen on a stored number question that has a\n","exit_code":0,"status":"completed"}}
