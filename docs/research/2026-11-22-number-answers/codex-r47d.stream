{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba paid_gate.py | sed -n '140,394p'\"","aggregated_output":"   140\tclass Gate:\n   141\t    def __init__(self, out, transport, ledger=None):\n   142\t        self.out, self.transport, self.ledger = out, transport, ledger\n   143\t        self.cfg = config.load(str(CONFIG))\n   144\t        self.lock = threading.Lock()\n   145\t        (out / 'archives').mkdir(parents=True, exist_ok=True)\n   146\t\n   147\t    def request(self, it, user):\n   148\t        return model.build_request(self.cfg.rejudging, it['system'], user, it['schema'], 'judgement', self.cfg.provider)\n   149\t\n   150\t    def record(self, line):\n   151\t        with self.lock, open(self.out / 'answers.jsonl', 'a') as handle:\n   152\t            handle.write(json.dumps(line, ensure_ascii=False) + '\\n')\n   153\t\n   154\t    def attempt(self, it, draw, user, n):\n   155\t        name = f'{it[\"unit\"]}-{it[\"arm\"]}-d{draw}-a{n}.sqlite'\n   156\t        archive = model.Archive(str(self.out / 'archives' / name))\n   157\t        line = {'unit': it['unit'], 'arm': it['arm'], 'draw': draw, 'attempt': n,\n   158\t                'request_sha256': model.request_identity(self.request(it, user))[1]}\n   159\t        self.record(dict(line, status='started'))                          # [47.3] recorded before the provider is called\n   160\t        data = None\n   161\t        try:\n   162\t            answer = model.call(archive, self.cfg, self.cfg.rejudging, it['system'], user, it['schema'], 'judgement', 'judge', transport=self.transport)\n   163\t            data = answer.data\n   164\t            line.update(cost_usd=answer.cost_usd, data=data)\n   165\t            calc = strip(data)\n   166\t            result = cc.check(it['family'], it['passages'], calc)\n   167\t            decision = cc.publish_decision(it['family'], calc, result)\n   168\t            line.update(status='answered', errors=result['errors'], recorded=result['recorded'], published=result.get('published'), decision=decision)\n   169\t        except model.SchemaError as error:\n   170\t            row = archive.conn.execute('select response_json from model_calls order by call_id desc limit 1').fetchone()\n   171\t            line.update(status='format invalid', error=str(error)[:500], decision='refused', errors=[('schema', str(error)[:300])],\n   172\t                        raw=row[0][:20000] if row and row[0] else None)\n   173\t        except model.TransportError as error:\n   174\t            line.update(status='transport error', error=str(error)[:500], decision='transport')\n   175\t        except Exception as error:                                       # [47.3] a checker failure is recorded with the raw answer and refused\n   176\t            line.update(status='checker error', error=f'{type(error).__name__}: {error}'[:500], decision='refused',\n   177\t                        errors=[('checker', f'{type(error).__name__}: {error}'[:300])], data=data)\n   178\t        self.record(line)\n   179\t        return line\n   180\t\n   181\t    def unit(self, it, draw):\n   182\t        first = self.attempt(it, draw, it['user'], 1)\n   183\t        if first['decision'] != 'refused':\n   184\t            return first, [first]\n   185\t        reasons = '; '.join(f'{c}: {d}' for c, d in first.get('errors', []))[:4000]\n   186\t        second = self.attempt(it, draw, it['user'] + RETRY_MARK + reasons, 2)\n   187\t        final = dict(second, decision='unresolved') if second['decision'] == 'refused' else second\n   188\t        return final, [first, second]\n   189\t\n   190\t    def run(self, items):\n   191\t        try:\n   192\t            for draw in DRAWS:\n   193\t                for it in items:\n   194\t                    if self.ledger is not None and self.ledger.read().get('stopped'):\n   195\t                        continue\n   196\t                    self.unit(it, draw)\n   197\t        finally:                                          # [47b.2] the results come from the attempt records, written even after an abort\n   198\t            summary = summarise(self.out, items, self.ledger.read() if self.ledger else None)\n   199\t        return summary\n   200\t\n   201\t\n   202\tdef attempt_records(out, damaged=None):\n   203\t    \"\"\"The committed journal entries. A line that does not parse (a write torn by a crash) is skipped and listed in `damaged`, so its\n   204\t    attempt counts as unfinished and the run as incomplete.\"\"\"\n   205\t    path = out / 'answers.jsonl'\n   206\t    records = []\n   207\t    for number, text in enumerate(path.read_text(errors='replace').splitlines() if path.exists() else [], 1):\n   208\t        try:\n   209\t            records.append(json.loads(text))\n   210\t        except json.JSONDecodeError:\n   211\t            if damaged is not None:\n   212\t                damaged.append({'line': number, 'text': text[:200]})\n   213\t    return records\n   214\t\n   215\t\n   216\tdef derive_finals(out, items, damaged=None):\n   217\t    \"\"\"Each planned unit and draw: 'dispatched' (a started line), 'completed' (a finished line), and the decision of its last finished\n   218\t    attempt (a second refusal is unresolved). A unit with no started line is not sent; one started but not finished is interrupted.\"\"\"\n   219\t    records = attempt_records(out, damaged)\n   220\t    finals = {}\n   221\t    for it in items:\n   222\t        for draw in DRAWS:\n   223\t            mine = [r for r in records if r['unit'] == it['unit'] and r['arm'] == it['arm'] and r['draw'] == draw]\n   224\t            started = [r for r in mine if r['status'] == 'started']\n   225\t            done = [r for r in mine if r['status'] != 'started']\n   226\t            key = f'{it[\"unit\"]}|{it[\"arm\"]}|{draw}'\n   227\t            if not started:\n   228\t                finals[key] = {'decision': 'not sent', 'attempts': []}\n   229\t                continue\n   230\t            if len(done) < len(started):\n   231\t                finals[key] = {'decision': 'interrupted', 'attempts': done}\n   232\t                continue\n   233\t            last = done[-1]\n   234\t            decision = last['decision']\n   235\t            if decision == 'refused':                          # a second refusal is unresolved; a first with no retry sent is incomplete\n   236\t                decision = 'unresolved' if len(done) >= 2 else 'retry not sent'\n   237\t            finals[key] = {k: last.get(k) for k in ('status', 'data', 'errors', 'recorded', 'published')}\n   238\t            finals[key].update(decision=decision, attempts=[{k: r.get(k) for k in ('attempt', 'status', 'decision', 'errors', 'data')} for r in done])\n   239\t    return finals\n   240\t\n   241\t\n   242\tdef summarise(out, items, ledger_state):\n   243\t    damaged = []\n   244\t    finals = derive_finals(out, items, damaged)\n   245\t    reconciled = {}\n   246\t    for draw_store, total, dc in PAIRS:                     # the separate arm, reconciled over the pair's family\n   247\t        for draw in DRAWS:\n   248\t            a, b = (finals.get(f'pair-{draw_store}|separate-{m[0]}|{draw}', {}) for m in (total, dc))\n   249\t            if a.get('decision') != 'publish' or b.get('decision') != 'publish':\n   250\t                reconciled[f'pair-{draw_store}|{draw}'] = {'decision': 'not reconciled', 'members': [a.get('decision'), b.get('decision')]}\n   251\t                continue\n   252\t            family = pair_family(draw_store, total, dc)\n   253\t            merged = merge([(total[0], strip(a['data'])), (dc[0], strip(b['data']))], {cc._key(s) for s in family['shared']})\n   254\t            pas = next(i['passages'] for i in items if i['unit'] == f'pair-{draw_store}' and i['arm'] == 'joint')\n   255\t            result = cc.check(family, pas, {k: merged[k] for k in ('figures', 'answers')})\n   256\t            reconciled[f'pair-{draw_store}|{draw}'] = {'decision': cc.publish_decision(family, merged, result), 'errors': result['errors'],\n   257\t                                                     'published': result.get('published'), 'calc': merged}\n   258\t    summary = {'finals': finals, 'reconciled': reconciled, 'ledger': ledger_state, 'damaged': damaged}\n   259\t    (out / 'results.json').write_text(json.dumps(summary, indent=1, ensure_ascii=False))\n   260\t    return summary\n   261\t\n   262\t\n   263\tdef _same_value(a, b):\n   264\t    \"\"\"Two recomputed (interval, bound) values are the same when their bounds match and each end agrees within 1e-9 relative.\"\"\"\n   265\t    if a is None or b is None or a[1] != b[1]:\n   266\t        return False\n   267\t    return all(abs(x - y) <= 1e-9 * max(1.0, abs(x), abs(y)) for x, y in zip(a[0], b[0]))\n   268\t\n   269\t\n   270\tdef merge(parts, shared_keys):\n   271\t    \"\"\"Two separate answers as one calculation: each figure id prefixed by its member; then [47.1, 47c.1] a forecast of a declared\n   272\t    shared quantity in the second call is unified with the first call's forecast of the same quantity and scenario when their\n   273\t    recomputed values are the same (references point to the first, the duplicate kept beside the calculation). Duplicates inside one\n   274\t    call are never unified, and forecasts that differ are both kept, so the family's checks judge them as they judge a joint answer.\"\"\"\n   275\t    figures, answers, recomputed, owner = [], [], {}, {}\n   276\t    for view_id, calc in parts:\n   277\t        rename = {f['id']: f'{view_id}.{f[\"id\"]}' for f in calc['figures']}\n   278\t        figs = {f['id']: f for f in calc['figures']}\n   279\t        refs = lambda f, figs=figs: list(f.get('inputs', [])) + [r for r in f.get('rests_on', []) if r in figs] + \\\n   280\t            ([f['adjusts']['figure']] if f.get('adjusts') else []) + ([f['bridge']] if f.get('bridge') else [])\n   281\t        try:\n   282\t            values = cc._evaluate_bounded(figs, refs, {})\n   283\t        except Exception:\n   284\t            values = {}\n   285\t        for f in calc['figures']:\n   286\t            g = dict(f, id=rename[f['id']])\n   287\t            for key in ('inputs', 'rests_on', 'converts'):\n   288\t                if key in g:\n   289\t                    g[key] = [rename.get(x, x) for x in g[key]]\n   290\t            for key in ('disputed', 'bridge'):\n   291\t                if key in g:\n   292\t                    g[key] = rename.get(g[key], g[key])\n   293\t            if 'adjusts' in g:\n   294\t                g['adjusts'] = dict(g['adjusts'], figure=rename.get(g['adjusts']['figure'], g['adjusts']['figure']))\n   295\t            figures.append(g)\n   296\t            recomputed[g['id']] = values.get(f['id'])\n   297\t            owner[g['id']] = view_id\n   298\t        for a in calc['answers']:\n   299\t            a2 = dict(a)\n   300\t            if 'outcome' in a2:\n   301\t                a2['outcome'] = rename.get(a2['outcome'], a2['outcome'])\n   302\t            if a2.get('reference', {}).get('figure'):\n   303\t                a2['reference'] = {'figure': rename.get(a2['reference']['figure'], a2['reference']['figure'])}\n   304\t            answers.append(a2)\n   305\t    key = lambda f: (f['what']['population'], f['what']['measure'], f['what']['scope'], f['what']['period'], f.get('scenario', 'base'))\n   306\t    first, alias, duplicates = {}, {}, []\n   307\t    for g in figures:\n   308\t        if g.get('basis') != 'forecast' or cc._key(g['what']) not in shared_keys:\n   309\t            continue\n   310\t        k = key(g)\n   311\t        if k in first and owner[first[k]] != owner[g['id']] and _same_value(recomputed.get(first[k]), recomputed.get(g['id'])):\n   312\t            alias[g['id']] = first[k]                       # [47b.1] a fixed numeric equivalence, [47c.1] across the two calls only\n   313\t        else:\n   314\t            first.setdefault(k, g['id'])\n   315\t    if alias:\n   316\t        kept = []\n   317\t        for g in figures:\n   318\t            if g['id'] in alias:\n   319\t                duplicates.append(g)\n   320\t                continue\n   321\t            for k2 in ('inputs', 'rests_on', 'converts'):\n   322\t                if k2 in g:\n   323\t                    g[k2] = [alias.get(x, x) for x in g[k2]]\n   324\t            for k2 in ('disputed', 'bridge'):\n   325\t                if k2 in g:\n   326\t                    g[k2] = alias.get(g[k2], g[k2])\n   327\t            if 'adjusts' in g:\n   328\t                g['adjusts'] = dict(g['adjusts'], figure=alias.get(g['adjusts']['figure'], g['adjusts']['figure']))\n   329\t            kept.append(g)\n   330\t        figures = kept\n   331\t        for a in answers:\n   332\t            if a.get('outcome') in alias:\n   333\t                a['outcome'] = alias[a['outcome']]\n   334\t            if a.get('reference', {}).get('figure') in alias:\n   335\t                a['reference'] = {'figure': alias[a['reference']['figure']]}\n   336\t    return {'figures': figures, 'answers': answers, 'unified': [{'kept': alias[d['id']], 'duplicate': d} for d in duplicates]}\n   337\t\n   338\t\n   339\tdef recover(out):\n   340\t    \"\"\"Read-only: rebuild results.json from the journal of a stopped run; nothing is sent.\"\"\"\n   341\t    items = json.loads((out / 'plan.json').read_text())\n   342\t    ledger = json.loads((out / 'ledger.json').read_text()) if (out / 'ledger.json').exists() else None\n   343\t    summary = summarise(out, items, ledger)\n   344\t    print(json.dumps({'damaged': summary['damaged'], 'finals': {k: v['decision'] for k, v in summary['finals'].items()}}, indent=1))\n   345\t    return summary\n   346\t\n   347\t\n   348\tdef budget_module():\n   349\t    import importlib.util\n   350\t    spec = importlib.util.spec_from_file_location('budget_replay_v13', REPO / 'clean-arch/e2e-comparison-2026-11-13/budget_replay.py')\n   351\t    module = importlib.util.module_from_spec(spec)\n   352\t    spec.loader.exec_module(module)\n   353\t    return module\n   354\t\n   355\t\n   356\tdef send(out, approved, plan_path):\n   357\t    if APPROVED_CEILING is None or approved != APPROVED_CEILING:\n   358\t        raise SystemExit(f'the approved ceiling is {APPROVED_CEILING} (Alex names it); refused')\n   359\t    if out.exists():\n   360\t        raise SystemExit(f'{out} exists: the gate starts from an empty folder')\n   361\t    text = Path(plan_path).read_text()\n   362\t    if hashlib.sha256(text.encode()).hexdigest() != PINNED_PLAN_SHA256:          # [47.2] only the reviewed plan\n   363\t        raise SystemExit('the plan is not the reviewed one (sha256 differs); refused')\n   364\t    AUTH.parent.mkdir(parents=True, exist_ok=True)\n   365\t    try:                                                                     # [47.2] one authorization, one ledger, one launch\n   366\t        with open(AUTH, 'x') as handle:\n   367\t            json.dump({'plan_sha256': PINNED_PLAN_SHA256, 'ceiling': approved, 'out': str(out)}, handle)\n   368\t    except FileExistsError:\n   369\t        raise SystemExit(f'{AUTH} exists: this authorization was already used; refused')\n   370\t    items = json.loads(text)\n   371\t    if len({(i['unit'], i['arm']) for i in items}) != len(items):\n   372\t        raise SystemExit('duplicate (unit, arm) in the plan; refused')\n   373\t    out.mkdir(parents=True)\n   374\t    (out / 'plan.json').write_text(json.dumps(items))\n   375\t    budget = budget_module()\n   376\t    budget.SharedLedger.init(str(out / 'ledger.json'), approved)\n   377\t    ledger = budget.SharedLedger(str(out / 'ledger.json'))\n   378\t    lock_handle = open(out / 'gate.launcher.lock', 'a+')\n   379\t    if not ledger.claim_launcher('v13-gate', lock_handle):\n   380\t        raise SystemExit('another launch is running')\n   381\t    remove_gate = budget.install_stop_gate(ledger)\n   382\t    try:\n   383\t        summary = Gate(out, budget.BudgetTransport(ledger), ledger).run(items)\n   384\t    finally:\n   385\t        remove_gate()\n   386\t        ledger.remove_launcher('v13-gate')\n   387\t    print(json.dumps({k: v.get('decision') for k, v in summary['finals'].items()}, indent=1))\n   388\t\n   389\t\n   390\t# ---------- blind reading ----------\n   391\tQUESTIONS = {'usable': 'the outcome is usable and supported by the shown passages it rests on',\n   392\t             'contradiction': 'with the other card of its packet, it states a hard numerical contradiction',\n   393\t             'internal_reference': \"the system's own forecast is presented as the market's expectation\",\n   394\t             'deciding_gap': 'an unresolved overlap, a change of scope or an unsized adjustment decides its band'}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba paid_gate.py | sed -n '395,675p'\"","aggregated_output":"   395\t\n   396\t\n   397\tdef normalise(calc, prefix=''):\n   398\t    \"\"\"Figure ids renumbered F1.. (after `prefix`) and member prefixes removed, so the arm cannot be read from the ids.\"\"\"\n   399\t    rename = {f['id']: f'{prefix}F{n}' for n, f in enumerate(calc['figures'], 1)}\n   400\t    out = []\n   401\t    for f in calc['figures']:\n   402\t        g = dict(f, id=rename[f['id']])\n   403\t        for key in ('inputs', 'rests_on', 'converts'):\n   404\t            if key in g:\n   405\t                g[key] = [rename.get(x, x) for x in g[key]]\n   406\t        for key in ('disputed', 'bridge'):\n   407\t            if key in g:\n   408\t                g[key] = rename.get(g[key], g[key])\n   409\t        if 'adjusts' in g:\n   410\t            g['adjusts'] = dict(g['adjusts'], figure=rename.get(g['adjusts']['figure'], g['adjusts']['figure']))\n   411\t        out.append(g)\n   412\t    answers = []\n   413\t    for a in calc['answers']:\n   414\t        a2 = dict(a)\n   415\t        if 'outcome' in a2:\n   416\t            a2['outcome'] = rename.get(a2['outcome'], a2['outcome'])\n   417\t        if (a2.get('reference') or {}).get('figure'):\n   418\t            a2['reference'] = {'figure': rename.get(a2['reference']['figure'], a2['reference']['figure'])}\n   419\t        answers.append(a2)\n   420\t    return {'figures': out, 'answers': answers}, rename\n   421\t\n   422\t\n   423\tdef run_digest(out):\n   424\t    h = hashlib.sha256()\n   425\t    for name in ('answers.jsonl', 'results.json', 'plan.json'):\n   426\t        path = out / name\n   427\t        h.update(name.encode() + b'\\0' + (path.read_bytes() if path.exists() else b''))\n   428\t    return h.hexdigest()\n   429\t\n   430\t\n   431\tdef card_view(calc, view_id, recorded, prefix=''):\n   432\t    \"\"\"[47b.3] One card as its own derivation: the figures its outcome and reference rest on, renumbered F1.. (after `prefix`) for this\n   433\t    card alone, and the recorded assumptions about its outcome or its own figures mapped to the same numbers.\"\"\"\n   434\t    figs = {f['id']: f for f in calc['figures']}\n   435\t    refs = lambda f: list(f.get('inputs', [])) + [r for r in f.get('rests_on', []) if r in figs] + \\\n   436\t        ([f['adjusts']['figure']] if f.get('adjusts') else []) + ([f['bridge']] if f.get('bridge') else [])\n   437\t    ans = next(a for a in calc['answers'] if a['view_id'] == view_id)\n   438\t    own = set()\n   439\t    for start in (ans.get('outcome'), (ans.get('reference') or {}).get('figure')):\n   440\t        if start in figs:\n   441\t            own |= cc._upstream_of(start, figs, refs) | {start}\n   442\t    sub = {'figures': [f for f in calc['figures'] if f['id'] in own], 'answers': [ans]}\n   443\t    norm, rename = normalise(sub, prefix)\n   444\t    mapped = []\n   445\t    for r in recorded:                                    # an assumption about this card's outcome, or about one of its own figures\n   446\t        named = [r[k] for k in ('figure', 'bridge') if isinstance(r.get(k), str)]\n   447\t        if (r.get('outcome') == view_id or any(n in rename for n in named)) and all(n in rename for n in named):\n   448\t            mapped.append({k: rename[v] if k in ('figure', 'bridge') else v for k, v in r.items()})\n   449\t    return norm, mapped, sorted({f['evidence'] for f in sub['figures'] if f.get('evidence')} | set(ans.get('cites', []))\n   450\t                                | {x for f in sub['figures'] for x in f.get('rests_on', []) if str(x).startswith('e')})\n   451\t\n   452\t\n   453\tATTEMPT_LABELS = {'format invalid': 'the answer did not match the required format', 'transport error': 'no answer arrived'}\n   454\t\n   455\t\n   456\tdef packet_units(results, items):\n   457\t    \"\"\"Every packet the run gives, as (unit, arm, draw) -> (decision, per-card source): the joint and singleton answers from the finals,\n   458\t    the separate arm's reconciled pairs with each card's own separate answer.\"\"\"\n   459\t    units = {}\n   460\t    for key, entry in results['finals'].items():\n   461\t        unit, arm, draw = key.split('|')\n   462\t        if not arm.startswith('separate-'):\n   463\t            units[(unit, arm, draw)] = (entry.get('decision'), {v: entry for v in items[(unit, arm)]['members']})\n   464\t    for key, entry in results['reconciled'].items():\n   465\t        unit, draw = key.split('|')\n   466\t        per_card = {a.split('-', 1)[1]: results['finals'].get(f'{unit}|{a}|{draw}', {}) for (u, a) in items if u == unit and a.startswith('separate-')}\n   467\t        units[(unit, 'separate', draw)] = (entry.get('decision'), per_card)\n   468\t    return units\n   469\t\n   470\t\n   471\tdef packet_body(items, unit, arm, decision, per_card):\n   472\t    \"\"\"One packet's text, rendered only from the run (so the verdict can render it again and compare), and the ids a ground may name:\n   473\t    each card (K1..), every passage shown, every figure shown. Earlier attempts are shown with their own answers (figures T<n>.F..),\n   474\t    with neutral labels and no check codes, which would tell a cross-member check (joint) from a single-member one.\"\"\"\n   475\t    base = items[(unit, 'joint' if unit.startswith('pair') else 'single')]\n   476\t    grounds, lines = set(), ['Code decision for the packet: ' + ('published' if decision == 'publish' else 'not published')]\n   477\t    for number, v in enumerate(base['members'], 1):\n   478\t        q = base['questions'][v]\n   479\t        token = f'K{number}'\n   480\t        grounds.add(token)\n   481\t        lines.append(f'### Card {token}: {q[\"question\"]}\\n  Ladder: ' + ' / '.join(f'rung {i + 1}: {c}' for i, c in enumerate(q['ladder'])))\n   482\t        source = per_card.get(v, {})\n   483\t        attempts = source.get('attempts') or []\n   484\t        if not attempts:\n   485\t            lines.append('  No attempt was made.')\n   486\t        fam = base['family'] if arm != 'separate' else only(base['family'], v)\n   487\t        named_all, blocks = set(), []\n   488\t        for a in attempts:\n   489\t            final = a is attempts[-1]\n   490\t            label = ('accepted by the checks' if a.get('decision') in ('publish', 'held')\n   491\t                     else ATTEMPT_LABELS.get(a.get('status'), 'refused by the checks'))\n   492\t            blocks.append(f'  Attempt {a[\"attempt\"]}{\" (final)\" if final else \"\"}: {label}')\n   493\t            if not a.get('data'):\n   494\t                continue\n   495\t            calc = strip(a['data'])\n   496\t            try:\n   497\t                checked = cc.check(fam, base['passages'], calc)\n   498\t            except Exception as error:\n   499\t                checked = {'errors': [('checker', str(error))], 'recorded': [], 'published': {}}\n   500\t            try:\n   501\t                norm, recorded, named = card_view(calc, v, checked.get('recorded', []), '' if final else f'T{a[\"attempt\"]}.')\n   502\t            except StopIteration:\n   503\t                blocks.append('    The answer has no card for this question.')\n   504\t                continue\n   505\t            named_all |= set(named)\n   506\t            grounds |= {f['id'] for f in norm['figures']}\n   507\t            blocks.append('    Figures (declared):\\n' + '\\n'.join(f'    - {json.dumps(f, ensure_ascii=False)}' for f in norm['figures']))\n   508\t            if final:\n   509\t                blocks.append('    Recomputed outcome: ' + json.dumps((checked.get('published') or {}).get(v)))\n   510\t                blocks.append('    Recorded assumptions: ' + json.dumps(recorded))\n   511\t            blocks.append(f'    Card {token}: ' + json.dumps(norm['answers'][0], ensure_ascii=False))\n   512\t        grounds |= named_all\n   513\t        if named_all:\n   514\t            lines.append('  Passages, as the request showed them:\\n' + '\\n'.join('  ' + base['shown'].get(e, f'- {e} (not shown)') for e in sorted(named_all)))\n   515\t        lines += blocks\n   516\t    lines.append('For each card answer yes or no, each with a ground that names a card (K...), passage (e...) or figure (F...) of this packet: '\n   517\t                 + '; '.join(f'{k}: {t}' for k, t in QUESTIONS.items()) + '\\n')\n   518\t    return lines, sorted(grounds), base['members']\n   519\t\n   520\t\n   521\tdef render_packets(out, order):\n   522\t    \"\"\"The packets text for a pid order [(pid, (unit, arm, draw))], rendered from the run's results and plan.\"\"\"\n   523\t    results = json.loads((out / 'results.json').read_text())\n   524\t    items = {(i['unit'], i['arm']): i for i in json.loads((out / 'plan.json').read_text())}\n   525\t    units = packet_units(results, items)\n   526\t    lines, rendered = [], {}\n   527\t    for pid, unit_key in order:\n   528\t        decision, per_card = units[tuple(unit_key)]\n   529\t        body, grounds, members = packet_body(items, unit_key[0], unit_key[1], decision, per_card)\n   530\t        lines += [f'## {pid}'] + body\n   531\t        rendered[pid] = {'unit': unit_key[0], 'arm': unit_key[1], 'draw': unit_key[2], 'decision': decision, 'grounds': grounds,\n   532\t                         'cards': {f'K{n}': v for n, v in enumerate(members, 1)}}\n   533\t    return '\\n'.join(lines), rendered, units\n   534\t\n   535\t\n   536\tdef packets(out, key_dir):\n   537\t    if (key_dir / 'packet-key.json').exists():            # [47b.4] the inventory and key are frozen once made\n   538\t        raise SystemExit(f'{key_dir / \"packet-key.json\"} exists: the packets are frozen; refused')\n   539\t    results = json.loads((out / 'results.json').read_text())\n   540\t    items = {(i['unit'], i['arm']): i for i in json.loads((out / 'plan.json').read_text())}\n   541\t    unit_keys = sorted(packet_units(results, items))\n   542\t    random.Random(secrets.randbits(64)).shuffle(unit_keys)\n   543\t    order = [(f'P{n:02d}', list(u)) for n, u in enumerate(unit_keys, 1)]\n   544\t    text, rendered, _ = render_packets(out, order)\n   545\t    key = {'run_digest': run_digest(out), 'packets_sha256': hashlib.sha256(text.encode()).hexdigest(), 'order': order}\n   546\t    key_dir.mkdir(parents=True, exist_ok=True)\n   547\t    with open(out / 'packets.md', 'x') as handle:\n   548\t        handle.write(text)\n   549\t    with open(key_dir / 'packet-key.json', 'x') as handle:\n   550\t        json.dump(key, handle, indent=1)\n   551\t    print(f'{len(order)} packets; key in {key_dir}')\n   552\t\n   553\t\n   554\tdef _grounded(ground, grounds):\n   555\t    \"\"\"[47b.4] A ground is non-empty text that names at least one card, passage or figure of the packet.\"\"\"\n   556\t    return isinstance(ground, str) and ground.strip() != '' and any(re.search(rf'\\b{re.escape(g)}\\b', ground) for g in grounds)\n   557\t\n   558\t\n   559\tdef final_readings(pid, cards, members, grounds=()):\n   560\t    \"\"\"[47.4] Two independent readings per card (A, B), each question answered yes/no with its ground; a third decides each\n   561\t    disagreement. Returns ({card: {question: answer}}, problems).\"\"\"\n   562\t    problems, final = [], {}\n   563\t    if sorted(cards) != sorted(members):\n   564\t        return None, [f'{pid}: cards {sorted(cards)} are not the unit\\'s {sorted(members)}']\n   565\t    for v, r in cards.items():\n   566\t        final[v] = {}\n   567\t        for q in QUESTIONS:\n   568\t            a, b = (r.get(x, {}).get(q, {}) for x in ('A', 'B'))\n   569\t            for name, x in (('A', a), ('B', b)):\n   570\t                if x.get('answer') not in ('yes', 'no') or not _grounded(x.get('ground'), grounds):\n   571\t                    problems.append(f'{pid} {v} {q}: reader {name} gave no yes/no with a ground from this packet')\n   572\t            if a.get('answer') == b.get('answer'):\n   573\t                final[v][q] = a.get('answer')\n   574\t            else:\n   575\t                t = r.get('third', {}).get(q, {})\n   576\t                if t.get('answer') not in ('yes', 'no') or not _grounded(t.get('ground'), grounds):\n   577\t                    problems.append(f'{pid} {v} {q}: the readers disagree and no third reading decides')\n   578\t                final[v][q] = t.get('answer')\n   579\t    return final, problems\n   580\t\n   581\t\n   582\tdef verdict(out, readings_path, key_dir):\n   583\t    \"\"\"D725's registered lines on validated readings, bound to this run.\"\"\"\n   584\t    frozen = json.loads((key_dir / 'packet-key.json').read_text())\n   585\t    submitted = json.loads(Path(readings_path).read_text())\n   586\t    problems = [] if frozen.get('run_digest') == run_digest(out) else ['the packet key does not belong to this run']   # [47b.4]\n   587\t    text, key, units = render_packets(out, frozen['order'])        # [47c.2] every packet rendered again from the run\n   588\t    if sorted(tuple(u) for _, u in frozen['order']) != sorted(units):\n   589\t        problems.append('the key does not map one packet to each unit of the run')\n   590\t    sha = hashlib.sha256(text.encode()).hexdigest()\n   591\t    packets_path = out / 'packets.md'\n   592\t    if sha != frozen.get('packets_sha256') or not packets_path.exists() or hashlib.sha256(packets_path.read_bytes()).hexdigest() != sha:\n   593\t        problems.append('packets.md is not the text the run and the key give')\n   594\t    if submitted.get('packets_sha256') != sha:\n   595\t        problems.append('the readings were not made on the frozen packets')\n   596\t    readings = submitted.get('packets', {})\n   597\t    results = json.loads((out / 'results.json').read_text())\n   598\t    problems += [f'answers.jsonl line {d[\"line\"]} is damaged' for d in results.get('damaged', [])]\n   599\t    unfinished = [k for k, v in results['finals'].items() if v.get('decision') not in ('publish', 'held', 'unresolved')]\n   600\t    problems += [f'{k}: {results[\"finals\"][k][\"decision\"]}' for k in unfinished]                                  # [47b.2] from the records\n   601\t    problems += [f'{pid}: not read' for pid in key if pid not in readings] + [f'{pid}: not a packet' for pid in readings if pid not in key]\n   602\t    usable_pairs = {'joint': {}, 'separate': {}}\n   603\t    defects = []\n   604\t    for pid, k in key.items():\n   605\t        if pid not in readings:\n   606\t            continue\n   607\t        final, probs = final_readings(pid, readings[pid], list(k['cards']), k['grounds'])\n   608\t        problems += probs\n   609\t        if final is None:\n   610\t            continue\n   611\t        if k['decision'] == 'publish' and k['arm'] in ('joint', 'single'):      # D725: defects across the joint and singleton answers\n   612\t            for v, r in final.items():\n   613\t                if 'yes' in (r['contradiction'], r['internal_reference'], r['deciding_gap']):\n   614\t                    defects.append((pid, k['unit'], k['arm'], k['cards'][v]))\n   615\t        if k['unit'].startswith('pair') and k['arm'] in usable_pairs:\n   616\t            usable_pairs[k['arm']].setdefault(k['unit'], []).append(k['decision'] == 'publish' and all(r['usable'] == 'yes' for r in final.values()))\n   617\t    joint_total = sum(sum(v) for v in usable_pairs['joint'].values())\n   618\t    separate_total = sum(sum(v) for v in usable_pairs['separate'].values())\n   619\t    per_snapshot = {u: sum(v) for u, v in usable_pairs['joint'].items()}\n   620\t    complete = (not problems and len(key) == 27 and len(usable_pairs['joint']) == 3 and len(usable_pairs['separate']) == 3\n   621\t                and all(len(v) == 3 for arm in usable_pairs.values() for v in arm.values()))\n   622\t    passes = complete and not defects and joint_total >= 8 and all(n >= 2 for n in per_snapshot.values()) and joint_total - separate_total >= 3\n   623\t    summary = {'complete': complete, 'problems': problems[:20], 'joint usable pairs': joint_total, 'separate usable pairs': separate_total,\n   624\t               'joint per snapshot': per_snapshot, 'published defects': defects,\n   625\t               'verdict': 'PASS' if passes else ('INCOMPLETE' if not complete else 'STOP')}\n   626\t    print(json.dumps(summary, indent=1))\n   627\t    return summary\n   628\t\n   629\t\n   630\tif __name__ == '__main__':\n   631\t    cmd = sys.argv[1] if len(sys.argv) > 1 else ''\n   632\t    if cmd == 'plan' and len(sys.argv) == 3:\n   633\t        plan(sys.argv[2])\n   634\t    elif cmd == 'send' and len(sys.argv) == 5 and not sys.argv[2].startswith('-'):\n   635\t        send(Path(sys.argv[2]), float(sys.argv[3]), sys.argv[4])\n   636\t    elif cmd == 'packets' and len(sys.argv) == 4:\n   637\t        packets(Path(sys.argv[2]), Path(sys.argv[3]))\n   638\t    elif cmd == 'recover' and len(sys.argv) == 3:\n   639\t        recover(Path(sys.argv[2]))\n   640\t    elif cmd == 'verdict' and len(sys.argv) == 5:\n   641\t        verdict(Path(sys.argv[2]), sys.argv[3], Path(sys.argv[4]))\n   642\t    else:\n   643\t        raise SystemExit(__doc__)\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_8","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"python3 -B -c '\nimport contextlib,copy,hashlib,io,json,pathlib\nimport gate as g, paid_gate as pg, paid_rehearsal as rehearsal\nplan=json.loads(pathlib.Path('\\\\''paid-plan.json'\\\\'').read_text())\n# Two equal shared forecasts originating in the second call.\np=[i for i in plan if i['\\\\''unit'\\\\'']=='\\\\''pair-old-2'\\\\'']\nspec=p[0]['\\\\''family'\\\\'']\nq=g.r1('\\\\''c'\\\\'')\ndef split(v):\n    figs={f['\\\\''id'\\\\'']:f for f in q['\\\\''figures'\\\\'']}\n    a=next(a for a in q['\\\\''answers'\\\\''] if a['\\\\''view_id'\\\\'']==v)\n    roots={a['\\\\''outcome'\\\\''],a['\\\\''reference'\\\\'']['\\\\''figure'\\\\'']}\n    def refs(f):\n        return f.get('\\\\''inputs'\\\\'',[])+[x for x in f.get('\\\\''rests_on'\\\\'',[]) if x in figs]+([f['\\\\''bridge'\\\\'']] if f.get('\\\\''bridge'\\\\'') else [])\n    ids=roots|set().union(*(pg.cc._upstream_of(f,figs,refs) for f in roots))\n    return copy.deepcopy({'\\\\''figures'\\\\'':[f for f in q['\\\\''figures'\\\\''] if f['\\\\''id'\\\\''] in ids],'\\\\''answers'\\\\'':[a]})\nleft,right=split('\\\\''v14'\\\\''),split('\\\\''v9'\\\\'')\nbase=next(f for f in right['\\\\''figures'\\\\''] if f['\\\\''id'\\\\'']=='\\\\''q4f'\\\\'')\ndc=next(f for f in right['\\\\''figures'\\\\''] if f['\\\\''id'\\\\'']=='\\\\''dcq4'\\\\'')\nright['\\\\''figures'\\\\'']=[f for f in right['\\\\''figures'\\\\''] if f['\\\\''id'\\\\''] not in ('\\\\''q4f'\\\\'','\\\\''dcq4'\\\\'','\\\\''carry'\\\\'')]\nright['\\\\''figures'\\\\''].append(g.est('\\\\''dcq4'\\\\'',117.586,'\\\\''USD bn'\\\\'',dc['\\\\''what'\\\\''],'\\\\''Independent segment estimate'\\\\'',['\\\\''e976'\\\\'']))\nfor fid in ('\\\\''q4_unused1'\\\\'','\\\\''q4_unused2'\\\\''):\n    right['\\\\''figures'\\\\''].append(g.est(fid,127.12,'\\\\''USD bn'\\\\'',base['\\\\''what'\\\\''],'\\\\''Company Q4 calculation retained as context'\\\\'',['\\\\''q3f'\\\\'']))\nfor i,x in zip(p[1:],(left,right)):\n    print(i['\\\\''arm'\\\\''],pg.cc.check(i['\\\\''family'\\\\''],i['\\\\''passages'\\\\''],x)['\\\\''errors'\\\\''])\nparts=list(zip(('\\\\''v14'\\\\'','\\\\''v9'\\\\''),(left,right)))\nfor keys in (set(),{pg.cc._key(s) for s in spec['\\\\''shared'\\\\'']}):\n    calc=pg.merge(parts,keys)\n    # Point of the first run is to show the original duplicate count after removing just the expected cross-call Q3 copy manually.\n    if not keys:\n        calc['\\\\''figures'\\\\'']=[f for f in calc['\\\\''figures'\\\\''] if f['\\\\''id'\\\\'']\"'!='\"'\\\\''v9.q3f'\\\\'']\n        for f in calc['\\\\''figures'\\\\'']:\n            for k in ('\\\\''inputs'\\\\'','\\\\''rests_on'\\\\''):\n                if k in f: f[k]=['\\\\''v14.q3f'\\\\'' if x=='\\\\''v9.q3f'\\\\'' else x for x in f[k]]\n    checked=pg.cc.check(spec,p[0]['\\\\''passages'\\\\''],{k:calc[k] for k in ('\\\\''answers'\\\\'','\\\\''figures'\\\\'')})\n    print('\\\\''merge with shared alias'\\\\'',bool(keys),'\\\\''errors'\\\\'',checked['\\\\''errors'\\\\''],'\\\\''aliases'\\\\'',[(x['\\\\''kept'\\\\''],x['\\\\''duplicate'\\\\'']['\\\\''id'\\\\'']) for x in calc['\\\\''unified'\\\\'']])\n# Full-size offline verdict for a joint/separate pair with identical packet text.\nclass Mem:\n    fs={}\n    def __init__(self,p): self.p=p\n    def __truediv__(self,k): return Mem(self.p+'\\\\''/'\\\\''+k)\n    def read_text(self,**kw): return self.fs[self.p]\n    def read_bytes(self): return self.read_text().encode()\n    def write_text(self,s): self.fs[self.p]=s\n    def exists(self): return self.p in self.fs\n    def mkdir(self,**kw): pass\ndef quiet(f,*a):\n    with contextlib.redirect_stdout(io.StringIO()): return f(*a)\nout,key_path=Mem('\\\\''run'\\\\''),Mem('\\\\''key'\\\\'')\nfinals,reconciled={},{}\njoints={i['\\\\''unit'\\\\'']:pg.strip(rehearsal.valid_answer(i)) for i in plan if i['\\\\''arm'\\\\'']=='\\\\''joint'\\\\''}\nfor i in plan:\n    for d in pg.DRAWS:\n        arm=i['\\\\''arm'\\\\'']\n        if arm.startswith('\\\\''separate-'\\\\''):\n            v=i['\\\\''members'\\\\''][0]\n            joint=joints[i['\\\\''unit'\\\\'']]\n            x={'\\\\''figures'\\\\'':[f for f in joint['\\\\''figures'\\\\''] if f['\\\\''id'\\\\'']==f'\\\\''o_{v}'\\\\''],'\\\\''answers'\\\\'':[a for a in joint['\\\\''answers'\\\\''] if a['\\\\''view_id'\\\\'']==v]}\n        else:\n            x=joints[i['\\\\''unit'\\\\'']] if arm=='\\\\''joint'\\\\'' else pg.strip(rehearsal.valid_answer(i))\n        result=pg.cc.check(i['\\\\''family'\\\\''],i['\\\\''passages'\\\\''],x)\n        assert not result['\\\\''errors'\\\\''],result['\\\\''errors'\\\\'']\n        finals[f'\\\\''{i[\\\"unit\\\"]}|{arm}|{d}'\\\\'']={'\\\\''decision'\\\\'':'\\\\''publish'\\\\'','\\\\''attempts'\\\\'':[{'\\\\''attempt'\\\\'':1,'\\\\''status'\\\\'':'\\\\''answered'\\\\'','\\\\''decision'\\\\'':'\\\\''publish'\\\\'','\\\\''data'\\\\'':x}]}\n        if arm=='\\\\''joint'\\\\'': reconciled[f'\\\\''{i[\\\"unit\\\"]}|{d}'\\\\'']={'\\\\''decision'\\\\'':'\\\\''publish'\\\\''}\n(out/'\\\\''results.json'\\\\'').write_text(json.dumps({'\\\\''finals'\\\\'':finals,'\\\\''reconciled'\\\\'':reconciled,'\\\\''damaged'\\\\'':[]}))\n(out/'\\\\''answers.jsonl'\\\\'').write_text('\\\\''journal'\\\\'');(out/'\\\\''plan.json'\\\\'').write_text(json.dumps(plan))\nitems={(i['\\\\''unit'\\\\''],i['\\\\''arm'\\\\'']):i for i in plan}\nunits=pg.packet_units({'\\\\''finals'\\\\'':finals,'\\\\''reconciled'\\\\'':reconciled},items)\norder=[(f'\\\\''P{n:02d}'\\\\'',list(u)) for n,u in enumerate(sorted(units),1)]\ntext,key,_=pg.render_packets(out,order)\n(out/'\\\\''packets.md'\\\\'').write_text(text)\nsha=hashlib.sha256(text.encode()).hexdigest()\nfrozen=dict(run_digest=pg.run_digest(out),packets_sha256=sha,order=order)\n(key_path/'\\\\''packet-key.json'\\\\'').write_text(json.dumps(frozen))\nrb={}\nnsep=0\nfor pid,k in key.items():\n    arm=k['\\\\''arm'\\\\'']\n    if arm=='\\\\''separate'\\\\'': nsep+=1\n    a=arm\"'!='\"'\\\\''separate'\\\\'' or nsep<=5\n    entry={name:{'\\\\''answer'\\\\'':'\\\\''yes'\\\\'' if name=='\\\\''usable'\\\\'' and a else '\\\\''no'\\\\'','\\\\''ground'\\\\'':'\\\\''K1 basis'\\\\''} for name in pg.QUESTIONS}\n    rb[pid]={v:{'\\\\''A'\\\\'':entry,'\\\\''B'\\\\'':entry} for v in k['\\\\''cards'\\\\'']}\nMem('\\\\''readings'\\\\'').write_text(json.dumps(dict(packets_sha256=sha,packets=rb)))\npg.Path=Mem\nprint('\\\\''before swapped arms'\\\\'',quiet(pg.verdict,out,'\\\\''readings'\\\\'',key_path))\n# Pick a non-usable separate sample and its same unit and draw joint sample.\nksep=[k for k,v in key.items() if v['\\\\''arm'\\\\'']=='\\\\''separate'\\\\''][-1]\nkjoin=next(k for k,v in key.items() if v['\\\\''arm'\\\\'']=='\\\\''joint'\\\\'' and v['\\\\''unit'\\\\'']==key[ksep]['\\\\''unit'\\\\''] and v['\\\\''draw'\\\\'']==key[ksep]['\\\\''draw'\\\\''])\ni={pid:n for n,(pid, _) in enumerate(order)}\norder[i[ksep]][1][:],order[i[kjoin]][1][:]=order[i[kjoin]][1][:],order[i[ksep]][1][:]\n(key_path/'\\\\''packet-key.json'\\\\'').write_text(json.dumps(frozen))\nprint('\\\\''same packet text after changing arm assignment'\\\\'',pg.render_packets(out,order)[0]==text)\nprint('\\\\''after swapped arms'\\\\'',quiet(pg.verdict,out,'\\\\''readings'\\\\'',key_path))\n'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"python3 -B -c '\nimport contextlib,copy,hashlib,io,json,pathlib\nimport gate as g, paid_gate as pg, paid_rehearsal as rehearsal\nplan=json.loads(pathlib.Path('\\\\''paid-plan.json'\\\\'').read_text())\n# Two equal shared forecasts originating in the second call.\np=[i for i in plan if i['\\\\''unit'\\\\'']=='\\\\''pair-old-2'\\\\'']\nspec=p[0]['\\\\''family'\\\\'']\nq=g.r1('\\\\''c'\\\\'')\ndef split(v):\n    figs={f['\\\\''id'\\\\'']:f for f in q['\\\\''figures'\\\\'']}\n    a=next(a for a in q['\\\\''answers'\\\\''] if a['\\\\''view_id'\\\\'']==v)\n    roots={a['\\\\''outcome'\\\\''],a['\\\\''reference'\\\\'']['\\\\''figure'\\\\'']}\n    def refs(f):\n        return f.get('\\\\''inputs'\\\\'',[])+[x for x in f.get('\\\\''rests_on'\\\\'',[]) if x in figs]+([f['\\\\''bridge'\\\\'']] if f.get('\\\\''bridge'\\\\'') else [])\n    ids=roots|set().union(*(pg.cc._upstream_of(f,figs,refs) for f in roots))\n    return copy.deepcopy({'\\\\''figures'\\\\'':[f for f in q['\\\\''figures'\\\\''] if f['\\\\''id'\\\\''] in ids],'\\\\''answers'\\\\'':[a]})\nleft,right=split('\\\\''v14'\\\\''),split('\\\\''v9'\\\\'')\nbase=next(f for f in right['\\\\''figures'\\\\''] if f['\\\\''id'\\\\'']=='\\\\''q4f'\\\\'')\ndc=next(f for f in right['\\\\''figures'\\\\''] if f['\\\\''id'\\\\'']=='\\\\''dcq4'\\\\'')\nright['\\\\''figures'\\\\'']=[f for f in right['\\\\''figures'\\\\''] if f['\\\\''id'\\\\''] not in ('\\\\''q4f'\\\\'','\\\\''dcq4'\\\\'','\\\\''carry'\\\\'')]\nright['\\\\''figures'\\\\''].append(g.est('\\\\''dcq4'\\\\'',117.586,'\\\\''USD bn'\\\\'',dc['\\\\''what'\\\\''],'\\\\''Independent segment estimate'\\\\'',['\\\\''e976'\\\\'']))\nfor fid in ('\\\\''q4_unused1'\\\\'','\\\\''q4_unused2'\\\\''):\n    right['\\\\''figures'\\\\''].append(g.est(fid,127.12,'\\\\''USD bn'\\\\'',base['\\\\''what'\\\\''],'\\\\''Company Q4 calculation retained as context'\\\\'',['\\\\''q3f'\\\\'']))\nfor i,x in zip(p[1:],(left,right)):\n    print(i['\\\\''arm'\\\\''],pg.cc.check(i['\\\\''family'\\\\''],i['\\\\''passages'\\\\''],x)['\\\\''errors'\\\\''])\nparts=list(zip(('\\\\''v14'\\\\'','\\\\''v9'\\\\''),(left,right)))\nfor keys in (set(),{pg.cc._key(s) for s in spec['\\\\''shared'\\\\'']}):\n    calc=pg.merge(parts,keys)\n    # Point of the first run is to show the original duplicate count after removing just the expected cross-call Q3 copy manually.\n    if not keys:\n        calc['\\\\''figures'\\\\'']=[f for f in calc['\\\\''figures'\\\\''] if f['\\\\''id'\\\\'']\"'!='\"'\\\\''v9.q3f'\\\\'']\n        for f in calc['\\\\''figures'\\\\'']:\n            for k in ('\\\\''inputs'\\\\'','\\\\''rests_on'\\\\''):\n                if k in f: f[k]=['\\\\''v14.q3f'\\\\'' if x=='\\\\''v9.q3f'\\\\'' else x for x in f[k]]\n    checked=pg.cc.check(spec,p[0]['\\\\''passages'\\\\''],{k:calc[k] for k in ('\\\\''answers'\\\\'','\\\\''figures'\\\\'')})\n    print('\\\\''merge with shared alias'\\\\'',bool(keys),'\\\\''errors'\\\\'',checked['\\\\''errors'\\\\''],'\\\\''aliases'\\\\'',[(x['\\\\''kept'\\\\''],x['\\\\''duplicate'\\\\'']['\\\\''id'\\\\'']) for x in calc['\\\\''unified'\\\\'']])\n# Full-size offline verdict for a joint/separate pair with identical packet text.\nclass Mem:\n    fs={}\n    def __init__(self,p): self.p=p\n    def __truediv__(self,k): return Mem(self.p+'\\\\''/'\\\\''+k)\n    def read_text(self,**kw): return self.fs[self.p]\n    def read_bytes(self): return self.read_text().encode()\n    def write_text(self,s): self.fs[self.p]=s\n    def exists(self): return self.p in self.fs\n    def mkdir(self,**kw): pass\ndef quiet(f,*a):\n    with contextlib.redirect_stdout(io.StringIO()): return f(*a)\nout,key_path=Mem('\\\\''run'\\\\''),Mem('\\\\''key'\\\\'')\nfinals,reconciled={},{}\njoints={i['\\\\''unit'\\\\'']:pg.strip(rehearsal.valid_answer(i)) for i in plan if i['\\\\''arm'\\\\'']=='\\\\''joint'\\\\''}\nfor i in plan:\n    for d in pg.DRAWS:\n        arm=i['\\\\''arm'\\\\'']\n        if arm.startswith('\\\\''separate-'\\\\''):\n            v=i['\\\\''members'\\\\''][0]\n            joint=joints[i['\\\\''unit'\\\\'']]\n            x={'\\\\''figures'\\\\'':[f for f in joint['\\\\''figures'\\\\''] if f['\\\\''id'\\\\'']==f'\\\\''o_{v}'\\\\''],'\\\\''answers'\\\\'':[a for a in joint['\\\\''answers'\\\\''] if a['\\\\''view_id'\\\\'']==v]}\n        else:\n            x=joints[i['\\\\''unit'\\\\'']] if arm=='\\\\''joint'\\\\'' else pg.strip(rehearsal.valid_answer(i))\n        result=pg.cc.check(i['\\\\''family'\\\\''],i['\\\\''passages'\\\\''],x)\n        assert not result['\\\\''errors'\\\\''],result['\\\\''errors'\\\\'']\n        finals[f'\\\\''{i[\\\"unit\\\"]}|{arm}|{d}'\\\\'']={'\\\\''decision'\\\\'':'\\\\''publish'\\\\'','\\\\''attempts'\\\\'':[{'\\\\''attempt'\\\\'':1,'\\\\''status'\\\\'':'\\\\''answered'\\\\'','\\\\''decision'\\\\'':'\\\\''publish'\\\\'','\\\\''data'\\\\'':x}]}\n        if arm=='\\\\''joint'\\\\'': reconciled[f'\\\\''{i[\\\"unit\\\"]}|{d}'\\\\'']={'\\\\''decision'\\\\'':'\\\\''publish'\\\\''}\n(out/'\\\\''results.json'\\\\'').write_text(json.dumps({'\\\\''finals'\\\\'':finals,'\\\\''reconciled'\\\\'':reconciled,'\\\\''damaged'\\\\'':[]}))\n(out/'\\\\''answers.jsonl'\\\\'').write_text('\\\\''journal'\\\\'');(out/'\\\\''plan.json'\\\\'').write_text(json.dumps(plan))\nitems={(i['\\\\''unit'\\\\''],i['\\\\''arm'\\\\'']):i for i in plan}\nunits=pg.packet_units({'\\\\''finals'\\\\'':finals,'\\\\''reconciled'\\\\'':reconciled},items)\norder=[(f'\\\\''P{n:02d}'\\\\'',list(u)) for n,u in enumerate(sorted(units),1)]\ntext,key,_=pg.render_packets(out,order)\n(out/'\\\\''packets.md'\\\\'').write_text(text)\nsha=hashlib.sha256(text.encode()).hexdigest()\nfrozen=dict(run_digest=pg.run_digest(out),packets_sha256=sha,order=order)\n(key_path/'\\\\''packet-key.json'\\\\'').write_text(json.dumps(frozen))\nrb={}\nnsep=0\nfor pid,k in key.items():\n    arm=k['\\\\''arm'\\\\'']\n    if arm=='\\\\''separate'\\\\'': nsep+=1\n    a=arm\"'!='\"'\\\\''separate'\\\\'' or nsep<=5\n    entry={name:{'\\\\''answer'\\\\'':'\\\\''yes'\\\\'' if name=='\\\\''usable'\\\\'' and a else '\\\\''no'\\\\'','\\\\''ground'\\\\'':'\\\\''K1 basis'\\\\''} for name in pg.QUESTIONS}\n    rb[pid]={v:{'\\\\''A'\\\\'':entry,'\\\\''B'\\\\'':entry} for v in k['\\\\''cards'\\\\'']}\nMem('\\\\''readings'\\\\'').write_text(json.dumps(dict(packets_sha256=sha,packets=rb)))\npg.Path=Mem\nprint('\\\\''before swapped arms'\\\\'',quiet(pg.verdict,out,'\\\\''readings'\\\\'',key_path))\n# Pick a non-usable separate sample and its same unit and draw joint sample.\nksep=[k for k,v in key.items() if v['\\\\''arm'\\\\'']=='\\\\''separate'\\\\''][-1]\nkjoin=next(k for k,v in key.items() if v['\\\\''arm'\\\\'']=='\\\\''joint'\\\\'' and v['\\\\''unit'\\\\'']==key[ksep]['\\\\''unit'\\\\''] and v['\\\\''draw'\\\\'']==key[ksep]['\\\\''draw'\\\\''])\ni={pid:n for n,(pid, _) in enumerate(order)}\norder[i[ksep]][1][:],order[i[kjoin]][1][:]=order[i[kjoin]][1][:],order[i[ksep]][1][:]\n(key_path/'\\\\''packet-key.json'\\\\'').write_text(json.dumps(frozen))\nprint('\\\\''same packet text after changing arm assignment'\\\\'',pg.render_packets(out,order)[0]==text)\nprint('\\\\''after swapped arms'\\\\'',quiet(pg.verdict,out,'\\\\''readings'\\\\'',key_path))\n'\"","aggregated_output":"separate-v14 []\nseparate-v9 []\nmerge with shared alias False errors [('C4', \"('NVIDIA', 'revenue', 'company', 'FY2027 Q4') base: 3 forecast nodes (v14.q4f, v9.q4_unused1, v9.q4_unused2); exactly one per scenario is required\")] aliases []\nmerge with shared alias True errors [] aliases [('v14.q3f', 'v9.q3f'), ('v14.q4f', 'v9.q4_unused1'), ('v14.q4f', 'v9.q4_unused2')]\nbefore swapped arms {'complete': True, 'problems': [], 'joint usable pairs': 9, 'separate usable pairs': 5, 'joint per snapshot': {'pair-old-1': 3, 'pair-old-2': 3, 'pair-old-3': 3}, 'published defects': [], 'verdict': 'PASS'}\nsame packet text after changing arm assignment True\nafter swapped arms {'complete': True, 'problems': [], 'joint usable pairs': 8, 'separate usable pairs': 6, 'joint per snapshot': {'pair-old-1': 3, 'pair-old-2': 3, 'pair-old-3': 2}, 'published defects': [], 'verdict': 'STOP'}\n","exit_code":0,"status":"completed"}}
