e.py:474:    rq = r1('c')                                      # [46s] Data Center Q4 strictly above a company Q4 of exactly 127.1\ngate.py:478:    item('R1qb', R1_FAMILY, R1_PASSAGES, rq, lambda r: (any(c == 'C3' and 'FY2027 Q4' in d for c, d in r['errors']), 'C3: strictly above an exact whole'), '')\ncalc_check.py:163:def _outcome_set(fig):\ncalc_check.py:189:def _exceeds(part, whole):\ncalc_check.py:190:    \"\"\"A part's value set lies above its whole's at either end (paired ends; an open end strictly beyond an equal closed one).\"\"\"\ncalc_check.py:207:def _crossings(base, alt, bands):\ncalc_check.py:411:        if not _overlaps(_outcome_set(out), band):                 # [46r] open and closed ends kept\ncalc_check.py:412:            errors.append(('C6', f'{ans[\"view_id\"]}: rung {rung} ({band}) contains no part of its outcome {_outcome_set(out)}'))\ncalc_check.py:476:                if p and w and _exceeds(_outcome_set(p), _outcome_set(w)):          # [46s] open and closed ends kept\ncalc_check.py:477:                    errors.append(('C3', f'{period} {sc}: {rel[\"part\"]} {p[\"id\"]} {_outcome_set(p)} exceeds {rel[\"whole\"]} {w[\"id\"]} {_outcome_set(w)}'))\ncalc_check.py:747:            if fig['id'] == outcome_id:                 # [46s] the outcome itself: its own value set against the alternate's\ncalc_check.py:748:                base_set = _outcome_set(figs[outcome_id])\ncalc_check.py:749:                alt_set = _outcome_set(dict(figs[fig['adjusts']['figure']])) if kind == 'adjustment' else (alt[0], True, alt[1], True)\ncalc_check.py:754:            definite, possible = _crossings(base_set, alt_set, members[view_id]['bands'])\n   155\t    if op == 'difference' and len(dirs) == 2:\n   156\t        dirs = [dirs[0], FLIP[dirs[1]]]\n   157\t    found = {d for d in dirs if d}\n   158\t    if not found:\n   159\t        return None\n   160\t    return found.pop() if len(found) == 1 and 'two-sided' not in found else 'two-sided'\n   161\t\n   162\t\n   163\tdef _outcome_set(fig):\n   164\t    \"\"\"The values an outcome allows: (low, low_closed, high, high_closed); a bound keeps its side open or closed.\"\"\"\n   165\t    lo, hi = _interval(fig)\n   166\t    b = fig.get('bound')\n   167\t    inf = float('inf')\n   168\t    if b == '>':\n   169\t        return (lo, False, inf, False)\n   170\t    if b in ('>=', 'approx_above'):\n   171\t        return (lo, True, inf, False)\n   172\t    if b == '<':\n   173\t        return (-inf, False, hi, False)\n   174\t    if b in ('<=', 'approx_below'):\n   175\t        return (-inf, False, hi, True)\n   176\t    return (lo, True, hi, True)\n   177\t\n   178\t\n   179\tdef _overlaps(values, band):\n   180\t    \"\"\"A band [low, high) (None: open-ended) shares at least one value with the outcome's set.\"\"\"\n   181\t    lo, lo_c, hi, hi_c = values\n   182\t    b_lo = band[0] if band[0] is not None else float('-inf')\n   183\t    b_hi = band[1] if band[1] is not None else float('inf')\n   184\t    low, low_closed = (lo, lo_c) if lo > b_lo else ((b_lo, True) if b_lo > lo else (lo, lo_c))\n   185\t    high, high_closed = (hi, hi_c) if hi < b_hi else ((b_hi, False) if b_hi < hi else (hi, False))\n   186\t    return low < high or (low == high and low_closed and high_closed)\n   187\t\n   188\t\n   189\tdef _exceeds(part, whole):\n   190\t    \"\"\"A part's value set lies above its whole's at either end (paired ends; an open end strictly beyond an equal closed one).\"\"\"\n   191\t    (plo, plc, phi, phc), (wlo, wlc, whi, whc) = part, whole\n   192\t    low_over = plo > wlo + 1e-9 or (abs(plo - wlo) <= 1e-9 and not plc and wlc)\n   193\t    high_over = phi > whi + 1e-9 or (abs(phi - whi) <= 1e-9 and phc and not whc)\n   194\t    return low_over or high_over\n   195\t\n   196\t\n   197\tdef _below(values, edge):\n   198\t    lo, lo_c, hi, hi_c = values\n   199\t    return hi < edge or (hi == edge and not hi_c)\n   200\t\n   201\t\n   202\tdef _at_or_above(values, edge):\n   203\t    lo, lo_c, hi, hi_c = values\n   204\t    return lo >= edge\n   205\t\n   206\t\n   207\tdef _crossings(base, alt, bands):\n   208\t    \"\"\"Band edges between two value sets: definite when one set lies wholly below an edge and the other wholly at or above it.\"\"\"\n   209\t    edges = sorted({e for band in bands for e in band if e is not None})\n   210\t    definite = [e for e in edges if (_below(base, e) and _at_or_above(alt, e)) or (_below(alt, e) and _at_or_above(base, e))]\n   211\t    span_lo, span_hi = min(base[0], alt[0]), max(base[2], alt[2])\n   212\t    possible = [e for e in edges if e not in definite and span_lo < e <= span_hi and base != alt]\n   213\t    return definite, possible\n   214\t\n   215\t\n   216\tdef _close(declared, expected, unit):\n   217\t    floor = 0.05 if unit == '%' else 0.1\n   218\t    return abs(declared - expected) <= max(0.005 * abs(expected), floor)\n   219\t\n   220\t\n   221\tQUARTERS = {'Q1': {1}, 'Q2': {2}, 'Q3': {3}, 'Q4': {4}, 'H1': {1, 2}, 'H2': {3, 4}}\n   222\t\n   223\t\n   224\tdef _quarters(period):\n   225\t    \"\"\"'FY2027' -> (FY2027, {1..4}); 'FY2027 Q3' -> (FY2027, {3}); 'FY2027 H1' -> {1, 2}; else None.\"\"\"\n   226\t    parts = period.split()\n   227\t    if len(parts) == 1 and parts[0].startswith('FY'):\n   228\t        return parts[0], {1, 2, 3, 4}\n   229\t    if len(parts) == 2 and parts[0].startswith('FY') and parts[1] in QUARTERS:\n   230\t        return parts[0], QUARTERS[parts[1]]\n   231\t    return None\n   232\t\n   233\t\n   234\tdef _key(what):\n   730\t        alt, kind = None, None\n   731\t        if fig['kind'] == 'computed' and fig.get('relation') == 'overlap_unknown' and fig.get('disputed') in fig.get('inputs', []):\n   732\t            keep = [i for i in fig['inputs'] if i != fig['disputed']]\n   733\t            signs = [s for i, s in zip(fig['inputs'], fig.get('signs') or [1] * len(fig['inputs'])) if i != fig['disputed']]\n   734\t            alt = _compute(fig['operation'], [_interval(figs[i]) + (figs[i]['unit'],) for i in keep], signs, fig['unit'])\n   735\t            kind, bound = 'overlap', None\n   736\t        elif fig['kind'] == 'estimate' and fig.get('adjusts'):\n   737\t            target = figs[fig['adjusts']['figure']]\n   738\t            alt, kind, bound = _interval(target), 'adjustment', target.get('bound')\n   739\t        if kind is None:\n   740\t            continue\n   741\t        for view_id, outcome_id in outcomes.items():\n   742\t            if fig['id'] != outcome_id and fig['id'] not in _upstream_of(outcome_id, figs, refs):\n   743\t                continue\n   744\t            if not downstream_formula(fig['id'], outcome_id):\n   745\t                out.append({'type': kind, 'figure': fig['id'], 'outcome': view_id, 'certainty': 'undetermined'})\n   746\t                continue\n   747\t            if fig['id'] == outcome_id:                 # [46s] the outcome itself: its own value set against the alternate's\n   748\t                base_set = _outcome_set(figs[outcome_id])\n   749\t                alt_set = _outcome_set(dict(figs[fig['adjusts']['figure']])) if kind == 'adjustment' else (alt[0], True, alt[1], True)\n   750\t            else:\n   751\t                b_lo, b_hi = _evaluate(figs, refs, {})[outcome_id]\n   752\t                a_lo, a_hi = _evaluate(figs, refs, {fig['id']: alt})[outcome_id]\n   753\t                base_set, alt_set = (b_lo, True, b_hi, True), (a_lo, True, a_hi, True)\n   754\t            definite, possible = _crossings(base_set, alt_set, members[view_id]['bands'])\n   755\t            finite = lambda v: v if abs(v) != float('inf') else None\n   756\t            out.append({'type': kind, 'figure': fig['id'], 'outcome': view_id, 'value': [finite(base_set[0]), finite(base_set[2])],\n   757\t                        'alternate': [finite(alt_set[0]), finite(alt_set[2])], 'alternate_bound': bound,\n   758\t                        'boundaries_crossed': definite + possible,\n   759\t                        'certainty': 'definite' if definite else ('possible' if possible else 'none')})\n   760\t    return out\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_6","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"python3 -B -c '\nimport pathlib,json,io,contextlib,copy,types\nimport gate as g, calc_check as c, render_v13 as r, mutants\ndef replay(func, log):\n    p=io.StringIO()\n    with contextlib.redirect_stdout(p): status=func()\n    assert status==0 and p.getvalue()==pathlib.Path(log).read_text()\nreplay(g.main,'\\\\''gate-run16.txt'\\\\'')\nassert g.MANIFEST==json.loads(pathlib.Path('\\\\''gate-run16.fixtures.json'\\\\'').read_text())\nreplay(r.main,'\\\\''render-r1.txt'\\\\'')\noriginal=g.cc\npath=pathlib.Path('\\\\''calc_check.py'\\\\'')\nsrc=path.read_text()\nfor name,old,new,target in mutants.MUTANTS:\n    g.cc=original\n    if old:\n        assert src.count(old)==1,name\n        mod=types.ModuleType('\\\\''in_memory_calc_check'\\\\'')\n        exec(compile(src.replace(old,new),str(path),'\\\\''exec'\\\\''),mod.__dict__)\n        g.cc=mod\n    misses={name for name,ok,_,_ in g.run() if not ok}\n    assert (target in misses if target else not misses),(name,misses)\ng.cc=original\nprint('\\\\''66 gate items, 31 mutants and stored render reproduced'\\\\'')\ndef fig(calc,fid):\n    return next(f for f in calc['\\\\''figures'\\\\''] if f['\\\\''id'\\\\'']==fid)\ndef check(name,case,passages,cc=c):\n    fam,x=case['\\\\''family'\\\\''],case['\\\\''calc'\\\\'']\n    schema=r.v13_schema(list(fam['\\\\''members'\\\\'']),list(passages),[])\n    wire=r.strict(x,schema)\n    clean=r.without_nulls(wire)\n    report=cc.check(fam,passages,clean)\n    print(name,r.model.check_schema(wire,schema),report,cc.publish_decision(fam,clean,report))\nfor name,ps in (('\\\\''R4b3'\\\\'',g.R4_PASSAGES),('\\\\''R1qb'\\\\'',g.R1_PASSAGES),('\\\\''R2'\\\\'',g.R2_PASSAGES)):\n    check(name,g.MANIFEST[name],ps)\ncase=copy.deepcopy(g.MANIFEST['\\\\''R4b3'\\\\''])\nx=case['\\\\''calc'\\\\'']\nx['\\\\''figures'\\\\''].append(g.comp('\\\\''same_vera28'\\\\'','\\\\''sum'\\\\'',['\\\\''vera28'