for name in sorted(files) if name.endswith(('\\\\''packets.md'\\\\'','\\\\''attempts.md'\\\\'','\\\\''key.json'\\\\''))])\ncontent = '\\\\''{'\\\\'' + '\\\\''x'\\\\'' * 20100 + '\\\\'' late source e3660'\\\\''\nraw = json.dumps({'\\\\''choices'\\\\'':[{'\\\\''message'\\\\'':{'\\\\''content'\\\\'':content}}]})\nprep(raw[:20000])\nwith contextlib.redirect_stdout(io.StringIO()): pg.packets(out, keys)\ndiagnostics = (out/'\\\\''attempts.md'\\\\'').read_text()\nprint('\\\\''full response bytes'\\\\'',len(raw),'\\\\''late source in request'\\\\'', '\\\\''e3660'\\\\'' in it['\\\\''shown'\\\\''],'\\\\''late source in attempts'\\\\'', '\\\\''e3660'\\\\'' in diagnostics,'\\\\''raw envelope in attempts'\\\\'','\\\\''\\\"choices\\\"'\\\\'' in diagnostics)\n'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
