)\n   669\t\n   670\t\n   671\tdef changed(previous, answer, figs):\n   672\t    \"\"\"D728: whether a member's conclusion changed, derived by code from its earlier rung, outcome and source figures.\"\"\"\n   673\t    if previous is None:\n   674\t        return True, 'first judgement'\n   675\t    refs = lambda f: list(f.get('inputs', [])) + [r for r in f.get('rests_on', []) if r in figs] + \\\n   676\t        ([f['adjusts']['figure']] if f.get('adjusts') else []) + ([f['bridge']] if f.get('bridge') else [])\n   677\t    out = figs[answer['outcome']]\n   678\t    if out['kind'] == 'computed':                     # [46aa] the same recomputed outcome publication uses\n   679\t        (lo_r, hi_r), b_r = _evaluate_bounded(figs, refs, {})[out['id']]\n   680\t        out = {k: v for k, v in out.items() if k not in ('value', 'low', 'high', 'bound')}\n   681\t        out.update({'value': lo_r} if lo_r == hi_r else {'low': lo_r, 'high': hi_r})\n   682\t        if b_r:\n   683\t            out['bound'] = b_r\n   684\t    own = _upstream_of(out['id'], figs, refs) | {out['id']}                  # [46k.3] the member's own outcome and reference only\n   685\t    ref = (answer.get('reference') or {}).get('figure')\n   686\t    if ref in figs:\n   687\t        own |= _upstream_of(ref, figs, refs) | {ref}\n   688\t    sources = sorted(figs[f]['evidence'] + ':' + figs[f]['expression'] for f in own if figs[f]['kind'] == 'source')\n   689\t    reasons = []\n   690\t    if answer['rung'] != previous['rung']:\n   691\t        reasons.append(f'rung {previous[\"rung\"]} to {answer[\"rung\"]}')\n   692\t    # [46l.2, 46ab] the published outcome as published: both ends (None for an open-ended side) and the bound\n   693\t    o_lo, _, o_hi, _ = _outcome_set(out)\n   694\t    finite = lambda v: None if v is None or abs(v) == float('inf') else round(v, 6)\n   695\t    cur = (finite(o_lo), finite(o_hi), out.get('bound'))\n   696\t    prev = previous['outcome']\n   697\t    if isinstance(prev, (int, float)):\n   698\t        prev = (prev, prev, None)\n   699\t    elif len(prev) == 2:\n   700\t        prev = (prev[0], prev[1], None)\n   701\t    prev = (finite(prev[0]), finite(prev[1]), prev[2])\n   702\t    near = lambda a, b: (a is None and b is None) or (a is not None and b is not None and abs(a - b) <= 0.005 * max(abs(b), 1e-9))\n   703\t    if cur[2] != prev[2] or not near(cur[0], prev[0]) or not near(cur[1], prev[1]):\n   704\t        reasons.append(f'outcome {list(prev)} to {list(cur)}')\n   705\t    added, dropped = sorted(set(sources) - set(previous['sources'])), sorted(set(previous['sources']) - set(sources))\n   706\t    if added or dropped:\n   707\t        reasons.append(f'source figures added {added}, dropped {dropped}')\n   708\t    return bool(reasons), '; '.join(reasons) or 'unchanged'\n   709\t\n   710\t\n   711\tdef publish_decision(family, calc, result):\n   712\t    \"\"\"DESIGN.md §4: 'refused' when a check fails (the harness retries once); 'held' when a member is unresolved and a declared\n   713\t    relation joins it to another member; else 'publish' (unresolved members shown as unresolved).\"\"\"\n   714\t    if result['errors']:\n   715\t        return 'refused'\n   716\t    unresolved = {a['view_id'] for a in calc['answers'] if a.get('shape') == 'unresolved'}\n   717\t    for rel in family.get('relations', []):\n   718\t        ends = {rel.get('part'), rel.get('whole'), rel.get('later'), rel.get('earlier')} - {None}\n   719\t        if ends & unresolved and ends - unresolved:\n   720\t            return 'held'\n   721\t    return 'publish'\n   722\t\n   723\t\n   724\tdef family_outcome(attempts):\n   725\t    \"\"\"The round's outcome from up to two attempts' decisions: a refusal is retried once; two refusals make the family unresolved.\"\"\"\n   726\t    if attempts[0] != 'refused':\n   727\t        return attempts[0]\n   728\t    if len(attempts) > 1 and attempts[1] != 'refused':\n   729\t        return attempts[1]\n   730\t    return 'unresolved'\n   731\t\n   396\t    prev = {'rung': 2, 'outcome': 417.5, 'sources': []}\n   397\t    calc_c = r1('c')\n   398\t    figs_c = {f['id']: f for f in calc_c['figures']}\n   399\t    v14_own = ['e238:$81.6 billion', 'e2497:$96.2 billion', 'e2499:$108.0 billion, plus or minus 2%', 'e3943:12%', 'e4762:3.1%',\n   400\t               'e5056:around $411 billion']\n   401\t    prev['sources'] = sorted(v14_own)\n   402\t    ch1 = cc.changed(dict(prev, outcome=418.4), calc_c['answers'][0], figs_c)\n   403\t    ch2 = cc.changed(dict(prev, rung=3, outcome=387.0), calc_c['answers'][0], figs_c)\n   404\t    sib = copy.deepcopy(calc_c)                       # [46k.3] a sibling-only source change leaves v14 unchanged\n   405\t    sib_figs = {f['id']: f for f in sib['figures']}\n   406\t    sib_figs['dch1'].update(expression='$164 billion', value=164.0)\n   407\t    sib_figs['mix']['evidence'] = 'e3219'\n   408\t    ch3 = cc.changed(dict(prev, outcome=418.4), sib['answers'][0], dict(sib_figs, mix=dict(sib_figs['mix'], expression='92.5% (restated)')))\n   409\t    c5 = r2()                                         # [46aa] declared $52.75B, recomputed and published $53.00B, against a published $52.70B\n   410\t    next(f for f in c5['figures'] if f['id'] == 'end')['value'] = 52.75\n   411\t    f5 = {f['id']: f for f in c5['figures']}\n   412\t    r5 = cc.check(R2_FAMILY, R2_PASSAGES, c5)\n   413\t    own5 = sorted(f5[i]['evidence'] + ':' + f5[i]['expression'] for i in ('bal', 'add18', 'ref70'))\n   414\t    ch5 = cc.changed({'rung': 3, 'outcome': 52.70, 'sources': own5}, c5['answers'][0], f5)\n   415\t    rows.append(('CH5', not r5['errors'] and r5['published']['v29'][:2] == [53.0, 53.0] and ch5[0] is True and '53.0' in ch5[1],\n   416\t                 f'published {r5[\"published\"][\"v29\"]}; {ch5[1]}', r5))\n   417\t    c6 = r4()                                         # [46ab] published below $39B before, above $39B now, same rung and sources\n   418\t    v6 = next(f for f in c6['figures'] if f['id'] == 'vera28'); v6.update(value=39.0, bound='>'); v6.pop('low'); v6.pop('high')\n   419\t    c6['figures'].append(comp('vout', 'sum', ['vera28'], 39.0, 'USD bn', W('NVIDIA', 'revenue', 'Vera CPU', 'FY2028'), bound='>'))\n   420\t    c6['answers'][0].update(outcome='vout', rung=3)\n   421\t    f6 = {f['id']: f for f in c6['figures']}\n   422\t    r6 = cc.check(R4_FAMILY, R4_PASSAGES, c6)\n   423\t    own6 = sorted(f6[i]['evidence'] + ':' + f6[i]['expression'] for i in ('c20', 'm2'))\n   424\t    ch6 = cc.changed({'rung': 3, 'outcome': [None, 39.0, '<'], 'sources': own6}, c6['answers'][0], f6)\n   425\t    ch6b = cc.changed({'rung': 3, 'outcome': r6['published']['v41'], 'sources': own6}, c6['answers'][0], f6)\n   426\t    rows.append(('CH6', not r6['errors'] and ch6[0] is True and ch6b[0] is False, f'below to above 39: {ch6[1]}; same published: {ch6b[1]}', r6))\n   427\t    rows.append(('CH1', ch1[0] is False, f'unchanged: {ch1[1]}', {'errors': [], 'recorded': []}))\n   428\t    rows.append(('CH2', ch2[0] is True and 'rung 3 to 2' in ch2[1], f'changed: {ch2[1]}', {'errors': [], 'recorded': []}))\n   429\t    rows.append(('CH3', ch3[0] is False, f'sibling-only change: {ch3[1]}', {'errors': [], 'recorded': []}))\n   430\t    f1g, c1g = g1()                                   # [46l.2] a wider range with the same midpoint\n   431\t    figs_g = {f['id']: f for f in c1g['figures']}\n   432\t    own_g = sorted(figs_g[i]['evidence'] + ':' + figs_g[i]['expression'] for i in ('gq1', 'gq2', 'gc392'))\n   433\t    ch4 = cc.changed({'rung': 2, 'outcome': (390.0, 445.0), 'sources': own_g}, c1g['answers'][0], figs_g)\n   434\t    rows.append(('CH4', ch4[0] is True and 'outcome' in ch4[1], f'wider range, same midpoint: {ch4[1]}', {'errors': [], 'recorded': []}))\n   435\t    g24m = copy.deepcopy(c24)                         # [46k.1] the high path replaced by a standalone estimate\n   436\t    g24m['figures'] = [f for f in g24m['figures'] if f['id'] != 'g28hi'] + [\n   437\t        est('g28hi', 612.79, 'USD bn', W('NVIDIA', 'revenue', CO, 'FY2028'), 'a standalone view', ['i256'], scenario='high')]\n   438\t    item('G24m', f24, G_PASSAGES, g24m, lambda r: (any(c == 'C9' and 'g28hi' in d for c, d in r['errors']), 'C9: the high path skips q01'), '')\n   439\t    g24d = copy.deepcopy(c24)                         # [46l.1] the high calculation deleted\n   440\t    g24d['figures'] = [f for f in g24d['figures'] if f['id'] != 'g28hi']\n   441\t    next(f for f in g24d['figures'] if f['id'] == 'g28')['rests_on'] = ['g28lo', 'i256', 'i173']\n   442\t    item('G24d', f24, G_PASSAGES, g24d, lambda r: (any(c == 'C9' and 'covers' in d for c, d in r['errors']), 'C9: the high path missing'), '')\n   443\t    g24c = copy.deepcopy(c24)                         # [46l.1] the high path computed from FY2028 consensus, q01's high only cited\n   444\t    g24c['figures'] = [f for f in g24c['figures'] if f['id'] != 'g28hi'] + [\n   445\t        est('g28hi', 612.79, 'USD bn', W('NVIDIA', 'revenue', CO, 'FY2028'), 'consensus, adjusted', ['gc554', 'gfyhi'], scenario='high')]\n   446\t    item('G24c', f24, G_PASSAGES, g24c, lambda r: (any(c == 'C9' and 'g28hi' in d for c, d in r['errors']), 'C9: q01 only cited, not computed'), '')\n   447\t    g24c3 = copy.deepcopy(c24)                        # [46m.1] q01's high forecast in an unused third operand\n   448\t    next(f for f in g24c3['figures'] if f['id'] == 'g28hi').update(inputs=['gc554', 'g41', 'gfyhi'], value=781.14)\n   449\t    item('G24c3', f24, G_PASSAGES, g24c3, lambda r: (any(c == 'C7' and 'operands' in d for c, d in r['errors']), 'C7: an operand the arithmetic ignores'), '')\n   450\t    g24s1 = copy.deepcopy(c24)                        # [46n] a sum whose short signs list drops q01's path\n   451\t    g24s1['figures'] = [f for f in g24s1['figures'] if f['id'] != 'g28hi'] + [\n   452\t        comp('g28hi', 'sum', ['gc554', 'gfyhi'], 554.0, 'USD bn', W('NVIDIA', 'revenue', CO, 'FY2028'), scenario='high', signs=[1])]\n   453\t    item('G24s1', f24, G_PASSAGES, g24s1, lambda r: (any(c == 'C7' and 'signs' in d for c, d in r['errors']), 'C7: a short signs list'), '')\n   454\t    g24s0 = copy.deepcopy(c24)                        # [46n] a zero sign\n","exit_code":0,"status":"completed"}}
