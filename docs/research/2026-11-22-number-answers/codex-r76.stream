{"type":"item.completed","item":{"id":"item_25","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba tests/test_release.py | sed -n '178,187p;398,442p'; rg -n 'data file and its manifest|FORMAT|manifest|write_package|PACKAGE_FILES' docs/research/2026-11-22-number-answers/release_mutants.py | head -35\"","aggregated_output":"   178\t\n   179\t\n   180\tdef rewrite_data(package, data):\n   181\t    \"\"\"A copy of the package's data with its manifest hash refreshed, so every other check still passes.\"\"\"\n   182\t    payload = json.dumps(data, ensure_ascii=False, separators=(',', ':')).encode()\n   183\t    (package / release.DATA_FILE).write_bytes(payload)\n   184\t    manifest = json.loads((package / release.MANIFEST_FILE).read_text())\n   185\t    manifest.update(as_of=data['as_of'], data_sha256=hashlib.sha256(payload).hexdigest())\n   186\t    (package / release.MANIFEST_FILE).write_text(json.dumps(manifest))\n   187\t\n   398\tdef test_15_symbolic_links_and_repeated_member_names_are_refused(stores, tmp_path):\n   399\t    \"\"\"§6 test 15: a symbolic link, a repeated member name and a named pipe are refused (the pipe without waiting).\"\"\"\n   400\t    out = tmp_path / 'release'\n   401\t    build_package(stores, out)\n   402\t    linked = tmp_path / 'linked'\n   403\t    shutil.copytree(out, linked)\n   404\t    (tmp_path / 'outside.json').write_bytes((linked / release.DATA_FILE).read_bytes())\n   405\t    (linked / release.DATA_FILE).unlink()\n   406\t    (linked / release.DATA_FILE).symlink_to(tmp_path / 'outside.json')\n   407\t    refused_with(lambda: check(stores, linked), f'{linked}/release-data.json: not a regular file')\n   408\t    repeated = tmp_path / 'repeated'\n   409\t    shutil.copytree(out, repeated)\n   410\t    raw = (repeated / release.DATA_FILE).read_bytes()\n   411\t    genuine = b'\"one_line\":\"Morningstar estimates $361 billion of revenue for the year.\"'\n   412\t    assert raw.count(genuine) == 1\n   413\t    payload = raw.replace(genuine, b'\"one_line\":\"About $390 billion\",' + genuine)\n   414\t    (repeated / release.DATA_FILE).write_bytes(payload)\n   415\t    manifest = json.loads((repeated / release.MANIFEST_FILE).read_text())\n   416\t    manifest['data_sha256'] = hashlib.sha256(payload).hexdigest()\n   417\t    (repeated / release.MANIFEST_FILE).write_text(json.dumps(manifest))\n   418\t    refused_with(lambda: check(stores, repeated), \"a JSON member name repeats: ['one_line']\")\n   419\t    piped = tmp_path / 'piped'\n   420\t    shutil.copytree(out, piped)\n   421\t    (piped / release.DATA_FILE).unlink()\n   422\t    os.mkfifo(piped / release.DATA_FILE)\n   423\t    result = run('check', piped, '--ledger', stores[0], '--items', stores[1], timeout=30)      # a blocking open would hang here\n   424\t    assert result.returncode == 1\n   425\t    stderr_line(result, f'refused: ReleaseRefused: {piped}/release-data.json: not a regular file')\n   426\t\n   427\t\n   428\tdef test_16_the_day_must_be_valid_and_canonical(stores):\n   429\t    \"\"\"§2 day rows, §6 test 16.\"\"\"\n   430\t    refused_with(lambda: export(stores, '2026-08-99'), \"not a day: '2026-08-99'\")\n   431\t    with pytest.raises(release.ReleaseRefused) as caught:      # Python 3.10 refuses the spelling as a day; 3.11+ reads it, and the canonical rule refuses it\n   432\t        export(stores, '20260825')\n   433\t    assert str(caught.value) in (\"not a day: '20260825'\", \"a day must be written YYYY-MM-DD: '20260825'\")\n   434\t    assert [e['id'] for e in by_id(export(stores, '2026-08-25'))['v1']['evidence']] == ['e1', 'e4']\n   435\t    views_db = service.open_ledger(str(stores[0]))\n   436\t    try:\n   437\t        refused_with(lambda: release.resolve(views_db, '2026-08-27'), 'day not completed: 2026-08-27 is after the last completed day 2026-08-26', service.BoundNotCompleted)\n   438\t    finally:\n   439\t        views_db.close()\n   440\t\n   441\t\n   442\tdef test_16_a_day_before_the_first_question_gives_an_empty_package(stores):\n19:    'check_package without the file-set check': (R, \"        if sorted(names) != sorted(PACKAGE_FILES):\\n            raise\", \"        if False:\\n            raise\"),\n20:    'manifest keys unchecked': (R, \"    _keys(manifest, 'manifest', 'the manifest')\\n\", ''),\n","exit_code":0,"status":"completed"}}
