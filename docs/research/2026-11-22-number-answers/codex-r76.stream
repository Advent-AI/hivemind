{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc 'nl -ba scripts/release_build.py'","aggregated_output":"     1\t\"\"\"Build or check the \"Forecast unavailable\" release package (docs/research/2026-11-22-number-answers/RELEASE-BUILD.md).\n     2\t\n     3\t    release_build.py build --ledger <views.sqlite> --items <items.sqlite> [--as-of YYYY-MM-DD] --out <folder>\n     4\t    release_build.py check <folder> --ledger <views.sqlite> --items <items.sqlite>\n     5\t\n     6\tNo model or network call; both stores are read only. The package is checked in a private staging folder against the stores before\n     7\tone atomic move publishes it, and neither the package nor the report ever replaces an existing path. Exit statuses: 0 done; 1\n     8\trefused, with nothing published by this command; 2 the package is published (build) or passes (check) but the report name is taken\n     9\tor the report could not be written.\n    10\t\"\"\"\n    11\timport argparse\n    12\timport json\n    13\timport os\n    14\timport shutil\n    15\timport sys\n    16\timport time\n    17\tfrom pathlib import Path\n    18\t\n    19\tROOT = Path(__file__).resolve().parents[1]\n    20\tsys.path.insert(0, str(ROOT / 'src'))\n    21\tfrom hivemind import release, service  # noqa: E402\n    22\tfrom hivemind.views import store  # noqa: E402\n    23\t\n    24\t\n    25\tdef report_path(out):\n    26\t    return out.with_name(out.name + '.report.json')\n    27\t\n    28\t\n    29\tdef write_report(report, path):\n    30\t    \"\"\"Print the report, then publish it: 0 when it is published (naming any temporary file left behind), 2 when it is not.\"\"\"\n    31\t    print(json.dumps(report, ensure_ascii=False, indent=1))\n    32\t    try:\n    33\t        leftover = release.publish_report(report, path)\n    34\t    except OSError as error:\n    35\t        print(f'report not written ({error}); run check to write it', file=sys.stderr)\n    36\t        return 2\n    37\t    print(f'report: {path}')\n    38\t    if leftover:\n    39\t        print(f'report published; its temporary file {leftover} could not be removed', file=sys.stderr)\n    40\t    return 0\n    41\t\n    42\t\n    43\tdef build(args):\n    44\t    out = Path(args.out).absolute()\n    45\t    report = report_path(out)\n    46\t    for path in (out, report):\n    47\t        if os.path.lexists(path):\n    48\t            print(f'refused: {path} exists', file=sys.stderr)\n    49\t            return 1\n    50\t    started = time.monotonic()\n    51\t    staged = views_db = items_db = None\n    52\t    try:\n    53\t        views_db = service.open_ledger(str(release.store_path(args.ledger)))\n    54\t        items_db = store.open_read_only(str(release.store_path(args.items)))\n    55\t        bound = release.resolve(views_db, args.as_of)\n    56\t        staged = release.stage(out)\n    57\t        data = release.release_export(views_db, items_db, bound)\n    58\t        export_seconds = time.monotonic() - started\n    59\t        release.write_package(data, staged)\n    60\t        checked = time.monotonic()\n    61\t        counts, data, size = release.check_package(staged, views_db, items_db, expected_as_of=bound)\n    62\t        unresolved = release.withheld_unresolved(views_db, data)\n    63\t        check_seconds = time.monotonic() - checked\n    64\t        release.publish(staged, out)\n    65\t        staged = None                       # published: this build no longer owns the staging name\n    66\t    except Exception as error:              # any failure before publication: nothing at --out from this build\n    67\t        print(f'refused: {type(error).__name__}: {error}', file=sys.stderr)\n    68\t        return 1\n    69\t    finally:\n    70\t        if staged is not None:\n    71\t            shutil.rmtree(staged)\n    72\t        for conn in (views_db, items_db):\n    73\t            if conn is not None:\n    74\t                conn.close()\n    75\t    print(f'published {out}: {counts}')\n    76\t    summary = {'ledger': str(args.ledger), 'items': str(args.items), 'as_of': bound, 'counts': counts,\n    77\t               'withheld_unresolved': unresolved, 'data_bytes': size,\n    78\t               'export_seconds': round(export_seconds, 2), 'check_seconds': round(check_seconds, 2)}\n    79\t    return write_report(summary, report)\n    80\t\n    81\t\n    82\tdef check(args):\n    83\t    out = Path(args.package).absolute()\n    84\t    views_db = items_db = None\n    85\t    try:\n    86\t        views_db = service.open_ledger(str(release.store_path(args.ledger)))\n    87\t        items_db = store.open_read_only(str(release.store_path(args.items)))\n    88\t        started = time.monotonic()\n    89\t        counts, data, size = release.check_package(out, views_db, items_db)\n    90\t        check_seconds = time.monotonic() - started\n    91\t        unresolved = release.withheld_unresolved(views_db, data)\n    92\t    except Exception as error:\n    93\t        print(f'refused: {type(error).__name__}: {error}', file=sys.stderr)\n    94\t        return 1\n    95\t    finally:\n    96\t        for conn in (views_db, items_db):\n    97\t            if conn is not None:\n    98\t                conn.close()\n    99\t    print(f'passes {out}: {counts}')\n   100\t    summary = {'ledger': str(args.ledger), 'items': str(args.items), 'as_of': data['as_of'], 'counts': counts,\n   101\t               'withheld_unresolved': unresolved, 'data_bytes': size,\n   102\t               'export_seconds': None, 'check_seconds': round(check_seconds, 2)}\n   103\t    return write_report(summary, report_path(out))\n   104\t\n   105\t\n   106\tdef main(argv=None):\n   107\t    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)\n   108\t    commands = parser.add_subparsers(dest='command', required=True)\n   109\t    make = commands.add_parser('build')\n   110\t    make.add_argument('--ledger', required=True, type=Path)\n   111\t    make.add_argument('--items', required=True, type=Path)\n   112\t    make.add_argument('--as-of')\n   113\t    make.add_argument('--out', required=True, type=Path)\n   114\t    verify = commands.add_parser('check')\n   115\t    verify.add_argument('package', type=Path)\n   116\t    verify.add_argument('--ledger', required=True, type=Path)\n   117\t    verify.add_argument('--items', required=True, type=Path)\n   118\t    args = parser.parse_args(argv)\n   119\t    return build(args) if args.command == 'build' else check(args)\n   120\t\n   121\t\n   122\tif __name__ == '__main__':\n   123\t    sys.exit(main())\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc 'nl -ba docs/research/2026-11-22-number-answers/RELEASE-PAGE.md'","aggregated_output":"     1\t# \"Forecast unavailable\" release, slice 2: the reader's page (design for council round 76)\n     2\t\n     3\t**Status: design for review. No code yet.** Slice 1 is built and accepted (D759: `RELEASE-BUILD.md` revision 11,\n     4\t`RELEASE-CHECK-RESULT.md`). Council 73 (D758) ordered the exporter first and the reader's screen second. This slice completes D756's\n     5\tscreen check: a $0 check of the reader's screen on a stored number question that has a forecast and history, where only the\n     6\tquestion, its sources and \"Forecast unavailable\" appear.\n     7\t\n     8\t## 0. Scope\n     9\t\n    10\t- **Built:**\n    11\t  - a page that is a pure function of the package data;\n    12\t  - the package gains that page (format 2);\n    13\t  - the package check proves the page equals that function of the data;\n    14\t  - a headless-browser check of the `old-1/v8` screen.\n    15\t- **The page reads only the package's data,** embedded in it.\n    16\t  - No network request of any kind: no live POC service, no `/library` fetch, no translated or prepared JSON, no composite trials,\n    17\t    no fonts or images from outside.\n    18\t  - No idea submission control or route (council 74).\n    19\t- **Not in scope:**\n    20\t  - the POC's page, API and MCP, unchanged;\n    21\t  - colleagues' page;\n    22\t  - the idea path;\n    23\t  - any model call;\n    24\t  - commit, publish, deploy (Alex's).\n    25\t\n    26\t**Why a separate page, not the POC's library UI.** The POC's components read the `thesis-ui/2` contract, which needs a ladder,\n    27\tscores and judgements for every thesis; a number question in the package has none. Adapting those shared components would change\n    28\tthe POC, which stays unchanged (design §2, D757). A small page written for the package has nothing to adapt and nothing that can\n    29\treach the network.\n    30\t\n    31\t## 1. What is built\n    32\t\n    33\t**In `src/hivemind/release.py`:**\n    34\t- **`FORMAT = 'hivemind-release/2'`.** The data's allow-list (`release-allow-list/1`) is unchanged.\n    35\t- **`PACKAGE_FILES = {'manifest.json', 'release-data.json', 'index.html'}`.** The manifest's closed set gains `page_sha256`.\n    36\t- **`render_page(data_bytes) -> bytes`:** one fixed template, the module constant `PAGE_TEMPLATE`, with the data inserted once.\n    37\t  - **The data** goes into `<script type=\"application/json\" id=\"release-data\">`, written from the exact `release-data.json` bytes with\n    38\t    `<`, `>`, `&`, U+2028 and U+2029 escaped as `<`, `>`, `&`, ` ` and ` `. JSON reads them back unchanged.\n    39\t  - **A Content-Security-Policy `<meta>`:**\n    40\t    `default-src 'none'; script-src 'sha256-<inline script>'; style-src 'sha256-<inline style>'; img-src 'none'; font-src 'none';\n    41\t    connect-src 'none'; base-uri 'none'; form-action 'none'`. The two hashes are computed from the template's own script and style,\n    42\t    so the browser refuses any other script, style or connection.\n    43\t  - **The script** builds the page only with `document.createElement`, `textContent` and `setAttribute` (for `href`, `rel`,\n    44\t    `class`). It never uses `innerHTML`, `outerHTML`, `insertAdjacentHTML`, `document.write`, `eval`, `Function`, or any network API\n    45\t    (`fetch`, `XMLHttpRequest`, `WebSocket`, `EventSource`, `navigator.sendBeacon`, `import()`, `Worker`).\n    46\t  - **The style** uses system fonts and inline colour tokens copied from `web/design-system/tokens.css`. It has a dark scheme under\n    47\t    `prefers-color-scheme: dark`, and it works at phone width.\n    48\t- **`write_package`** also writes `index.html = render_page(data bytes)` and records its sha256.\n    49\t- **`check_package`** also:\n    50\t  - reads `index.html` once through the same folder handle;\n    51\t  - requires its bytes to equal `render_page(the data bytes it read)` exactly;\n    52\t  - requires the manifest's `page_sha256` to match.\n    53\t\n    54\t  A page that differs by one byte from the function of the data is refused. So a page cannot carry anything the data does not hold,\n    55\t  and no code the template does not hold.\n    56\t\n    57\t**What the page shows,** in package order:\n    58\t- **A header:** \"Hivemind release\", the package's day, and the count of questions by class.\n    59\t- **A text filter** over the questions, applied in the page with no request.\n    60\t- **Each question:**\n    61\t  - its question text and \"Open\" or \"Closed\";\n    62\t  - for a number question, the marker \"Forecast unavailable\";\n    63\t  - for an event or Yes/No question, \"Answer: <label>\", or \"Not yet answered\" when the answer is null;\n    64\t  - \"<n> pieces of evidence\", and a `<details>` element. When opened, it builds the evidence list:\n    65\t    - each piece shows its summary, the quote, and a line with tier, speaker, and original speaker and day;\n    66\t    - each source shows title, publisher and day. It is a link only when its URI starts with `https://` or `http://` (with `rel`\n    67\t      `noopener noreferrer`), and plain text otherwise.\n    68\t\n    69\t  Evidence is built only when opened, so the first screen stays fast on a 6 MB package.\n    70\t\n    71\t## 2. State × event (the page and the check)\n    72\t\n    73\t| State / event | What happens |\n    74\t|---|---|\n    75\t| Package with no questions | \"No questions as of <day>\" |\n    76\t| A question with no evidence | \"No evidence in force\", and no `<details>` |\n    77\t| A source URI that is not http(s), such as `javascript:` | shown as text, never a link |\n    78\t| Text holding `</script>`, `<img onerror=…>`, `&` or U+2028 | the embed escapes it, the page shows it as text, and the JSON parses back identical |\n    79\t| The page is opened from disk, a static host or any path | it reads only its embedded data; nothing else exists to read |\n    80\t| The browser blocks inline script | nothing renders. The page shows a `<noscript>` line saying it needs script. It holds no forecast to leak |\n    81\t| A page edited after the build (a fetch added, a field added) | `check_package` refuses: the bytes differ from `render_page(data)` |\n    82\t| The template changes in a later version | old packages fail `check_package` under the new code by design; a new template is a new format version |\n    83\t| A dark scheme and a phone width | the style handles both; checked in the browser check |\n    84\t\n    85\t## 3. Value × reader\n    86\t\n    87\t- Every value the page shows comes from the embedded data; the page reads no other value.\n    88\t- The page's readers are a person's browser and the browser check.\n    89\t- The data's readers are unchanged from slice 1: `check_package`, `check_origins`, the tests. The page adds one reader of the data,\n    90\t  the page script, and no new writer.\n    91\t\n    92\t## 4. New path × old checks\n    93\t\n    94\t| Slice-1 check | Slice 2 |\n    95\t|---|---|\n    96\t| Closed set of the data, origin check, staged check before the no-replace publication, the no-replace report | unchanged |\n    97\t| The manifest's closed set | gains `page_sha256`; `format` becomes `hivemind-release/2` |\n    98\t| Exactly the package files, each read once, no links, no pipes | the same rule over three files |\n    99\t| The literal-values rule of verification (council 75d) | applied to the page checks as well |\n   100\t\n   101\t## 5. Tests (`tests/test_release.py`) and mutants\n   102\t\n   103\t1. **Determinism.** `render_page` of the fixture data twice gives the same bytes. The page holds the data bytes, escaped as specified.\n   104\t2. **Escaping.** A fixture quote holding `</script><img src=x onerror=alert(1)>` and a U+2028:\n   105\t   - the page has no second `<script>` start in the data block;\n   106\t   - parsing the embedded JSON back gives the data unchanged.\n   107\t3. **No network code.** The template's script contains none of the listed APIs. Its CSP is exactly the policy above, with the hashes\n   108\t   of its own script and style.\n   109\t4. **The package check:**\n   110\t   - a page changed by one byte, with the manifest hash refreshed, is refused with its exact reason;\n   111\t   - a page with `fetch(\"http://127.0.0.1:8788/library\")` added, its CSP hash and manifest hash both updated, is refused, because it\n   112\t     is not `render_page(data)`;\n   113\t   - a missing page and a fourth file are each refused.\n   114\t5. **Literal identifiers:** `hivemind-release/2` and `release-allow-list/1`.\n   115\t\n   116\t**Mutants:**\n   117\t- `render_page` not escaping `<`;\n   118\t- the script using `innerHTML` for the quote;\n   119\t- a source link without the http(s) test;\n   120\t- `check_package` not comparing the page with `render_page`;\n   121\t- the CSP hash computed over a different script.\n   122\t\n   123\t## 6. The $0 screen check (`release_screen.mjs`, run once)\n   124\t\n   125\t- **Setup.** Headless Chrome from `/Applications/Google Chrome.app`, driven through its DevTools protocol with Node's built-in\n   126\t  WebSocket, on a fresh profile in the scratchpad. Each page is opened from `file://`.\n   127\t- **Packages:** `old-1` at its default day, and the two dated leak packages (`old-3` at 2026-08-25, `old-1` at 2026-08-28), built by\n   128\t  the slice-1 command under format 2.\n   129\t\n   130\t**Recorded for each page:**\n   131\t- the page's own network requests (`Network.requestWillBeSent` for the page target). Only the document itself may appear;\n   132\t- console errors, exceptions and CSP violations (`Runtime.exceptionThrown`, `Log.entryAdded`). Zero are allowed.\n   133\t\n   134\t**The screen of `old-1/v8`:**\n   135\t- its article shows exactly the stored question, \"Open\", \"Forecast unavailable\" and \"1284 pieces of evidence\";\n   136\t- opening its details shows `e2295`'s stored summary;\n   137\t- the article's text holds none of `v8`'s five labels, five conditions, or the system's \"About $390 billion\" (`j1580`) outside the\n   138\t  quoted evidence;\n   139\t- a screenshot of the card is saved with the result.\n   140\t\n   141\t**The leak screens:** `old-3/v36` and `old-1/v10` show \"Answer: Yes\" at their own days, and their explanations appear nowhere in the\n   142\tpage text.\n   143\t\n   144\t**The fetch mutant.** The same check on a copy of the `old-1` page with a fetch of `http://127.0.0.1:8788/library` inserted must\n   145\tfail, either as a blocked request or as a CSP violation. That proves the check sees a restored live fetch. Whether Chrome reports a\n   146\tCSP-blocked fetch as a request is confirmed on the first run, and the result is recorded.\n   147\t\n   148\t**Budget,** set before the first control: the `old-1` page renders its question list within 3 s of load in headless Chrome, and its\n   149\tsize is at most the data's bytes plus 64 KB.\n   150\t\n   151\t## 7. Prior decisions\n   152\t\n   153\tD726, D756, D757, D758, D759; council 74 (no idea input); council 75d (literal expected values); D690 (poc-v118 stays the product);\n   154\tD163 (English product text).\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc 'nl -ba docs/prd/10-filing-phase.md'","aggregated_output":"     1\t# Core PRD for the next phase: filing must recognise indirect relations the way an analyst does\n     2\t\n     3\t> Status: in progress (opened 2026-11-04). Alex: \"你把这个写好成下一阶段核心PRD然后不要drift, 把所有需要的context 全部充分记录，每次开始前都需要revisit, 然后开始做\".\n     4\t> This page is the single source for this phase. In a conflict: Alex's words → `docs/DECISIONS.md` → this page → the other design documents. This page's\n     5\t> conclusions, evidence, constraints, measuring method and process are not rewritten to follow test results;\n     6\t> test results go into `docs/research/2026-11-04-filing-end-to-end/log.md`, and changing this page first needs Alex's word.\n     7\t> Amended 2026-11-04 (Alex replied \"go\" to the proposed amendment; D360): §5.2 drops \"also file under the other party's question\" and puts two\n     8\t> sentences in its place, one on choosing and one on splitting; §6's decision rule is rewritten. How it came about:\n     9\t> `docs/research/2026-11-04-filing-end-to-end/prd-amendment-proposal.md` and `log.md` rows 11–16.\n    10\t> 2026-11-05 (D368): translated into English on Alex's word (\"不，用英文吧\"); §4 corrected to name the frozen standard's version 5 and §5 given a status line, on his delegation (\"你要来帮我看到底做不做\").\n    11\t\n    12\t## 0. Checklist before every start (Alex: \"每次开始前都需要revisit\")\n    13\t\n    14\tBefore starting any step, finish these in order; if one cannot be done, do not start:\n    15\t\n    16\t1. Read §§1–8 of this page in full; read the last three rows of `log.md`, and confirm where the previous step stopped and why.\n    17\t2. Check against §3, \"not in scope\": what this step does is not in that table. If it is in the table, stop and take it to Alex.\n    18\t3. Check against §4, \"constraints\": this step changes nothing frozen; a change to the frozen extraction prompt is the one place §5 names, and Alex's\n    19\t   word for it is already given.\n    20\t4. If this step costs money: its predictions and stop conditions are written down and frozen as §7 says (with their sha256 recorded beside them); the\n    21\t   requests are rebuilt byte for byte as §6 says; the control is re-sent the same day.\n    22\t5. What goes to Alex: one conclusion, one recommendation, one test, after §7's rounds of review; no menu of options; in plain words (the opening of\n    23\t   AGENTS, \"Explain and answer as to a sixteen-year-old\").\n    24\t\n    25\t## 1. Goal (end to end)\n    26\t\n    27\tEach question's judgement must receive the facts that can change its answer; facts that no question receives, those that bear on no question, must\n    28\tnot be piled into some one question. What is measured is the final judgement (the frozen judgement ruler, reader B, at the window end 2026-07-14), not\n    29\tany one step's own score.\n    30\t\n    31\t## 2. The core blocker (proven)\n    32\t\n    33\t**The system uses a fact for a question only when the fact \"states exactly this question's own figure\". An analyst also reasons onward from a fact: the other party's figure in a deal, price and volume for a product's revenue, a product's variants for its launch, and so on. The filing step cannot do this; the judging step reasons onward once it has the facts.**\n    34\t\n    35\tThis one blocker has two faces (described earlier as \"two problems\"):\n    36\t\n    37\t- **The parking lot.** Filing does not recognise facts that bear on a question indirectly, so no question takes them; yet to be kept, a fact must\n    38\t  first be filed (D209, D264). So D273 added the fallback sentence, which parks them in NVIDIA's total-revenue question. Of the reports under the\n    39\t  total-revenue question, in the part the gold read, 32–39% are ones the standard does not keep, 31–44% are kept but used by none of the 22 questions,\n    40\t  and only 7–10% are what the gold actually uses to judge total revenue (three draws); 24–44% of the total-revenue question's judgement citations are\n    41\t  news about other companies or the whole market (Intel graphics-card retail prices, a gas-fired power plant in Taiwan).\n    42\t- **Narrow questions starve.** Questions that only indirect facts can answer do not receive them: the custom-chip question received none of Broadcom's\n    43\t  figures in any of the three draws, and judged \"below $40 billion\" in all three; the operating-margin and NVIDIA capital-spending questions received\n    44\t  nothing at all and were never judged.\n    45\t\n    46\t**Evidence:**\n    47\t\n    48\t| Evidence | Content | Source |\n    49\t|---|---|---|\n    50\t| Filing recognises only \"its own figure\" | The model says \"Broadcom's AI chip revenue is not cloud providers' spending on custom chips\" and \"Google Cloud's backlog is not capital spending\"; on a neutral refiling (no question id named, the rule not shown), 23 of 42 facts that matter are still not filed | `probe-filing-account-d1.md`, `refile-no_fallback.json` |\n    51\t| The judgement reasons onward once it has the facts | The custom-chip question's request of 7-14, sent 3 times in each of the three draws: as it was, 9/9 \"below $40 billion\"; with the Broadcom, Trainium and other facts written in that draw's ledger added, 9/9 left the lowest rung (6 times $40–60 billion, 3 times $60–80 billion), reasoning as the two readers did (\"guidance $16 billion, about $64 billion annualised, less networking chips\") | `predictions-one-test.md`, `one-test-result.json`, `log.md` row 8 |\n    52\t| Where the parking lot came from | D273: with the fallback sentence added, the core items on the extraction ruler went 64 → 68; the extraction ruler does not look at which question a fact is filed under (AGENTS §7.1, \"What it does not measure\") | `docs/DECISIONS.md` D273 |\n    53\t| What the parking lot holds | The figures above; an independent reader on 12 random articles: of 25 misfilings as it was, 21 were parked in the revenue question; 8 and 5 with the fallback deleted | `sink_by_standard.py`, the independent reader's report (`log.md` row 8) |\n    54\t\n    55\tAll files above are in `docs/research/2026-11-04-filing-end-to-end/` unless noted otherwise.\n    56\t\n    57\t## 3. Ruled out or secondary (outside this phase's scope, each recorded separately)\n    58\t\n    59\t| Matter | Conclusion | Source |\n    60\t|---|---|---|\n    61\t| The argument card | Not built; its code is deleted (Alex: \"好，删掉卡片代码\") | `docs/research/2026-11-04-argument-record/log.md` rows 4–11 |\n    62\t| The arrows of the question graph | Really wired backwards: a seed question's arrow means \"supports\" (D208), while the judging code reads it as \"whose conclusion to read\" (PRD 06). As a result themes are judged only after the total-revenue question, so the total-revenue question reads the themes' conclusions of the previous day, and in draw 3 a chain of questions went wrong in turn. But it does not explain the misfiling (filing comes before judging), and the gold itself judges data-center revenue as \"total revenue × 92%\". A topic of its own; settled by D368 (item 4: the arrow means \"supports\"), its fix to be built and measured | `core-problem.md`, `review-core-codex.md` |\n    63\t| Code removes the total-revenue question's own figures | True (\"keep only the narrowest question\" takes a seed arrow for \"a narrower sub-question\"), but each draw it costs the total-revenue question only 0–2 of the facts it needs | `log.md` row 8 |\n    64\t| A filing re-check added at the end | Recovers some, and misfiles about as many (independent reader: about one misfiled for each one filed right); not the solution | The independent reader's report |\n    65\t| One general sentence, \"the other party's figure in a deal counts too\" | The custom-chip question gains, but it pulls Morgan Stanley's price for a Rubin rack from the Rubin revenue question to the capital-spending question, and leaves some facts with no home | `answers.json` (the two arms definition and definition_no_fallback), `measure-corrected.txt` |\n    66\t| Tightening D259's \"leeway\" | Alex's own decision; this phase does not overturn it | D259 |\n    67\t| Opening questions (the Ohio guarantee was not opened); the two readers' disagreement on the China-share question | Another class of problem, not in this phase | `docs/research/2026-11-04-filing-end-to-end/diagnosis.md` §0 |\n    68\t| Model drift | With the same requests, today about half as many facts go into the total-revenue question as on 11-03; the cause is not proven. Compare only with a control re-sent the same day, never with the archive | `log.md` row 6 |\n    69\t\n    70\t## 4. Constraints (what must not move, and why)\n    71\t\n    72\t- **The frozen ruler** (AGENTS §7.1, D261, D262): the extraction standard, version 5 (the signed version 3 with D248's seven boundaries and D250's four\n    73\t  evidence boundaries and counting unit), golden-v5, the seed questions and the judgement gold; not a word changes; a disagreement is a gap in the\n    74\t  system (D263).\n    75\t- **The frozen extraction prompt** (D274): v74i (`poc-v108`) does not change by a word; what this phase changes is the one place that holds the filing\n    76\t  rule (the description of the `links` field), made into a new version with a new configuration and compared with v74i. Alex has given his word for this\n    77\t  work (2026-11-04: \"好你去解决问题\", \"开始做\"); making it the default needs his word again.\n    78\t- **Frozen opening and judging** (D354): this phase does not touch them.\n    79\t- **The standard's text** (in translation): §6, \"file under the narrowest open question; when no question takes it, record no home and drop it, and read\n    80\t  each one at evaluation\"; §5.1, \"makes the answer to some question more or less likely\", with four paths, \"demand, supply, competition, pricing\"; §5.3,\n    81\t  \"another company's matter is not kept when one cannot say which question about the covered company it moves through a path such as demand, supply,\n    82\t  competition or pricing\".\n    83\t- **Decisions**: D207 (one home per fact, the narrowest question), D209 (no home means dropped, each one read), D259 (leeway: a figure question takes\n    84\t  \"the demand, supply, competition and pricing that make it more or less likely\"; the total-revenue question taking more is an accepted cost, \"bounded by\n    85\t  the narrowest-question rule and the driver questions\"), D265 (code keeps only the narrowest), D273 (the fallback sentence), D355 (the two failed tests\n    86\t  of the previous filing topic).\n    87\t- **Prompt principles** (AGENTS §6): carry only the standard and add no new rule; a general hedge-fund analyst: every rule and example reads the same\n    88\t  for a bank, a drug maker, a retailer or a chip company, names neither NVIDIA nor its products or figures, and is not taken from a test article; a\n    89\t  classification is written as a closed set with two or three examples per class, replacing the abstract wording; quality is not fixed by lengthening\n    90\t  the prompt: remove as much as is added, or write down the reason.\n    91\t- **Code decides only \"is it the same thing\", never \"does it matter\"** (AGENTS §2).\n    92\t\n    93\t## 5. What to do\n    94\t\n    95\tStatus: the links-rule version that carried items 1–3 (v74l) failed its one test (§8 step 5); D361 keeps the fallback sentence, so item 3 is not carried out. The plan below is kept as written.\n    96\t\n    97\t1. **Replace the abstract sentence \"makes the answer more or less likely through demand, supply, competition or pricing\" with the few classes in which an analyst recognises an indirect relation, written as a closed set, each class with two or three examples from other industries** (AGENTS §6: one\n    98\t   abstract sentence is a coin flip on every send; examples replace it). A first draft of the classes (checked against the standard line by line at\n    99\t   design time; it holds only meanings the standard already has):\n   100\t   - The question's own figure: this question's figures, guidance, estimates and revisions (estimates for another period or another population follow\n   101\t     the existing rule).\n   102\t   - The other side of the same money: a seller's revenue from the buyers the question counts; those buyers' orders and backlog with these sellers.\n   103\t   - Price and volume: a product's price or shipments, for the question on that product's revenue.\n   104\t   - Variants and parts: a product's variants, alternatives, key parts and schedule changes, for the question on that product's launch.\n   105\t   - Demand, supply and competition moves with a number: customers' orders and capital-spending plans, suppliers' capacity and prices, competitors'\n   106\t     sales and share, for the question they affect.\n   107\t2. **State how to file a fact when two specific questions both bear on it** (the problem the `definition_no_fallback` arm exposed: Morgan Stanley's rack\n   108\t   price was filed under the buyers' capital-spending question, and the seller's Rubin revenue question lost it). One home per fact (D207): file it under\n   109\t   the question its figure measures most directly (for example, a hotel's room rate goes under its room-revenue question, not under the\n   110\t   travellers'-spending question; a parts maker's revenue from carmakers goes under the carmakers' parts-spending question, not under a rival parts\n   111\t   maker's share question); when one sentence gives a separate figure for each of two questions, write two items, each filed under its own question\n   112\t   (code stores two items that quote the same sentence as one record linked to both questions); never also file it under a broader question about the\n   113\t   same company (the failure of D355's test 2: the model filed it under an NVIDIA revenue question as well). The original draft's \"when the other\n   114\t   party's question is open … file it there as well\" conflicted with D207 and was deleted on 2026-11-04 with Alex's agreement (D360).\n   115\t3. **Delete the fallback sentence** and return to the standard's §6: when no question takes a fact, it is not filed; code drops it as \"no home\" and\n   116\t   records it (D209), and evaluation reads each one.\n   117\t4. Change only the one place that holds the filing rule; report its length in characters before and after, and write down the reason for any growth\n   118\t   (this time's reason: examples replace one abstract sentence).\n   119\t\n   120\t## 6. How to measure (the ruler does not move; the method does not change again)\n   121\t\n   122\t- **Requests**: rebuild each stored request byte for byte with the production code, changing only the one place that holds the filing rule; the\n   123\t  rebuilt request's archive id must equal the original's, or it is not sent (`resend_filing.py`, AGENTS §5). Never re-send the archive's copy whose\n   124\t  keys were sorted alphabetically.\n   125\t- **Articles**: development set = the 54 articles of `selection.json` (already read many times); held-out set = articles the extraction gold read and\n   126\t  the judgement gold uses that are not among those 54, drawn once before the test, with the list frozen and never changed afterwards. Both sets are\n   127\t  measured and reported apart.\n   128\t- **Control**: the unchanged requests re-sent 3 times the same day. No comparison with the archive (model drift).\n   129\t- **Each answer**: goes through the production code checks and filing first (including \"keep only the narrowest\" and \"no home means dropped\"), and is\n   130\t  counted after.\n   131\t- **What is counted** (`measure_filing.py`, with its matching rule fixed: items are matched on the distinct numbers and the proper nouns other than\n   132\t  NVIDIA in the source text; a source passage the system quotes that overlaps the gold's passage also counts as the same matter; \"optional\" counts as\n   133\t  optional; the citations in the body of the gold's answers are read):\n   134\t  - whether each fact that matters (one the gold uses to judge any question) reached the question that uses it, counted per fact, not per \"fact ×\n   135\t    question\";\n   136\t  - per question: the facts that matter that reached it and the new noise that appeared, counted by the decision rule below;\n   137\t  - the parking lot: how many facts the total-revenue question (v1, together with v22) takes in, and what they are;\n   138\t  - noise: how many of the sentences the standard does not keep are kept; per question, how noise is filed (links on facts the standard does not keep\n   139\t    or no question uses);\n   140\t  - how many core and supporting facts appear; the facts that matter that are dropped; how many questions each fact is filed under on average.\n   141\t  - Matching still has a small error (spot check: the new rule mismatches a few and misses a few); say so when reporting the numbers, and read the\n   142\t    ones that matter one by one.\n   143\t- **Decision rule** (rewritten on 2026-11-04 with Alex's agreement, D360. The original draft required \"every draw above the highest of the control's\n   144\t  three\" and the like, which the control itself fails when measured again, so it cannot tell good from bad. Script `decide.py`; written down and frozen\n   145\t  before each test; each draw's numbers and the totals are all reported):\n   146\t  - **Totals, with luck ruled out first**: each article's 6 answers from the new and the old arm are randomly reassigned between the two arms 4,000\n   147\t    times (with a fixed random seed); the new rule's difference counts as a real change only when fewer than 5% of the reassignments reach it.\n   148\t    - Development set: facts that matter reaching the question that uses them must rise; the count under the total-revenue questions (v1, v22) must\n   149\t      fall; sentences the standard does not keep must not rise; core facts must not fall.\n   150\t    - Held-out set: facts that matter reaching the question that uses them must not fall; sentences the standard does not keep must not rise; core\n   151\t      facts must not fall.\n   152\t  - **Per question, counted by code against the gold** (development and held-out sets together):\n   153\t    - A fact that matters which reaches the question at least two fewer times under the new rule than under the control counts as \"one fewer\" for that\n   154\t      question; in under the control all three times and under the new rule none of the three, it counts as \"lost outright\". A move to another question\n   155\t      that the gold also uses it for and that is no broader than the original (one home per fact, D207) does not count as fewer; a move to a broader\n   156\t      question counts. \"One more\" in the opposite direction offsets it.\n   157\t    - A noise sentence (not kept by the standard, or kept but used by no question) that the new rule files under the question at least twice while the\n   158\t      control never does counts as \"new noise\"; filed all three times, it counts as \"outright new noise\". The opposite direction offsets it.\n   159\t    - Any question with a net 3 fewer, a net 2 lost outright, a net 5 more new noise, or a net 3 more outright new noise fails. These thresholds are the\n   160\t      smallest values that keep \"misjudged when new and old are exactly the same\" within about one in ten; at the test, first compute the\n   161\t      misjudgement rate from the reassignments; if it is above one in ten, raise the threshold most prone to misjudgement by one step, then compare with\n   162\t      what was measured.\n   163\t  - **Smaller changes** (a question 2 fewer, two or three more noise) cannot be told from luck in three measurements: all are listed, given to a reader\n   164\t    who did not write the rule to read against the raw answers, and written into the report; they do not decide pass or fail.\n   165\t  Only when everything passes does it become a candidate; a candidate runs end to end three times on the 14-day window (extraction re-sent, matching and\n   166\t  judging run as usual, scored on the frozen judgement ruler), and that step needs Alex's word.\n   167\t\n   168\t## 7. Process (no drift)\n   169\t\n   170\t- **One recommendation and one test at a time** (AGENTS §7.3, Alex: \"就测试一种，一次\"): write the design first and put it through rounds of review (own\n   171\t  checks, Codex read-only, a reader who did not write it reading the raw records) until a round finds nothing serious; write down and freeze the\n   172\t  predictions and stop conditions; test once; if it does not match, stop and take it to Alex (D355: \"如果有什么不符合hypothesis 的地方你需要终止然后和我说我们重新评估\").\n   173\t- **A review's report is a lead**: each finding counts only once it is checked against the records (AGENTS §1).\n   174\t- **A prompt audit before any prompt change** (`.claude/skills/prompt-audit/SKILL.md`): check the whole request against the standard sentence by\n   175\t  sentence, in both directions.\n   176\t- **Every step goes into `log.md`**: what was done, what came of it, the files; mistakes and overturned results stay in it too.\n   177\t- **Do not repeat what was ruled out** (§3).\n   178\t\n   179\t## 8. Steps and where we are\n   180\t\n   181\t| # | Step | Output | Status |\n   182\t|---|---|---|---|\n   183\t| 1 | Design: the classes of indirect relation (a closed set + examples from other industries), how to file when a fact measures both sides, deleting the fallback; checked against the standard sentence by sentence; length before and after | `docs/research/2026-11-04-filing-end-to-end/design-links.md` | Done (draft 3, v74l / poc-v115) |\n   184\t| 2 | Checks at no cost: a sample answer written by the new rule goes through every code check; the new rule's text goes through the prompt audit | Same as above | Done |\n   185\t| 3 | Review rounds (Codex, independent readers, own), until nothing serious remains | `review-links-*.md` | Done (Codex 7 rounds, independent readers 3 times; round 7 found nothing serious) |\n   186\t| 4 | Draw and freeze the held-out set; write down and freeze this test's predictions and decision rule | `heldout.json`, `predictions-links.md` | Done (sha256 recorded for both) |\n   187\t| 5 | Test once: development set + held-out set, the new rule and the same-day control 3 times each | `answers-links.json`, `log.md` | Done (2026-11-04): failed: facts that matter reaching the right question, development set +7 (p 0.26); every other condition passed |\n   188\t| 6 | If passed: to Alex, to decide whether to run three 14-day end-to-end draws; if failed: stop, to Alex | `design-links.md` §8 | Stopped, to Alex |\n   189\t| 7 | (D361, Alex: \"按照你的提以来，但是你一定是自己反思多轮之后才给出的行动\") Measure the ceiling first: hand the source passages the gold cites straight to the frozen judgement; the custom-chip, operating-margin and capital-spending questions judged 3 times each at the window end, the custom-chip question as it was 3 times as the control; the fallback sentence is not deleted for now | `reflection-v74l.md`, `oracle-design.md` | Done: operating margin grounded 3/3, capital spending 2/3, custom chips 0/3 (the gap is in interpretation); the next step waits for Alex |\n   190\t| 8 | (D362, Alex: \"你继续啊不要scope drift and strongly follow evidence of your discovery and learning\") Two small changes where facts are not delivered, one at a time: ① when a quote is rewritten, code matches it back to the source sentence (changing nothing the model sees; verified by replaying the archive); ② a figure question's description states which figures it is derived from by definition (first sent 3 times each on the article that motivated it) | `delivery-fixes.md` | Stopped: an independent check overturned the first change's code (it would take in wrong figures); the second failed its trial send (1/3). The root: the signed standard's §5.3 does not keep two key facts, treating them as \"a restatement of known facts\" (proposal 6, awaiting approval); to Alex |\n   191\t| 9 | **Historical; superseded by D370.** (D363, Alex: \"乙\") At coverage start, record each question's starting figure once from the company's latest earnings report; the daily path still takes no restatements: design, rounds of self-checks and independent checks, validated first on the archive in the simplest way | `baseline-design.md` | Validated on two questions: the frozen extraction does not read the report's tables (0/3); with each question reading the report once on its own, the operating-margin question read its starting figure 2/3 and the capital-spending question 3/3, and the judgement then judged right (2/3, 3/3), about 2.5 cents. All 22 questions tested once (2026-11-05, Alex: \"你充分验证\"; files chosen by code, a same-day control, about $0.43): v10 and v12 judged right 9/9 each; no question already judged right turned wrong; but 5 of the 53 figures read were other quantities (the Vera CPU question and the Blackwell and Rubin question took a larger or neighbouring revenue line), so it failed condition 3, written beforehand. The model itself pointed to the reading instructions' sentence \"write the lines it is computed from, or the line the report uses for it\"; stopped, to Alex. Alex: \"改\"; only this sentence was changed (\"write only the lines it is computed from, or the same quantity under another name; never a broader line or a line next to it\"), tried on 4 questions first, then tested on all 22 (about $0.36): all three conditions passed: v10 and v12 9/9 each, no question judged right turned wrong, and all 46 figures were the questions' own quantities. Checked after an independent reader's challenge: the new sentence made the reading miss the capital-spending line in 3 of 12 reads, and it had been tested only on the one May report; the fourth version (a line-by-line re-check after writing) removed too much and failed; after a census of every failure trace (Alex: \"我需要你深度看完所有失败trace给我准信\"), the third version with the repaired quote check was chosen (D365): 0 wrong figures on the held-out August report; built into the production system (poc-v116; the $0 checks and the tests all pass). The full acceptance, three 14-day draws (Alex: \"跑验收\"; a same-day control; about $4.79): all passed: operating margin and capital spending judged right 3/3 each (the control never judged them), 53 against 45 in total (of 57); for the China-share question, the only one two fewer, both readers found the starting figures did not lead it astray. Alex: \"都做\": poc-v116 became the default (D366); the code was committed and a PR opened |\n   192\t\n   193\t## 9. Alex's own words on this matter (in time order)\n   194\t\n   195\t- \"你这个单独开一个专题出来解决 … 是promot，是系统结构设计还是到底哪里有问题挂错一堆东西，机制是不是有问题（一定要挂吗？有没有可能是杂音\" (2026-11-03)\n   196\t- \"So if it's a customer problem or other companies that you think is relating NVIDIA and it's the wrong evidence, then what is the standard for it? … from a hedge fund analyst standpoint, are these even relevant? Do you think your ruler is wrong in this aspect?\" (2026-11-04)\n   197\t- \"你确定下你接下来要改进的量化目标，以及你要看到端到端我们的管线是要做什么的，不要乱硬优化，要看到目标\" (2026-11-04)\n   198\t- \"就测试一种，一次 … 能不能自己有个超级自信的定论和证据再给我提建议\" (2026-11-04)\n   199\t- \"这些只是类型题，你需要抽象拔高我们现在的核心问题和卡点。这个很重要这样改下去才是对的\" (2026-11-04)\n   200\t- \"你把这个写好成下一阶段核心PRD然后不要drift, 把所有需要的context 全部充分记录，每次开始前都需要revisit, 然后开始做\" (2026-11-04)\n   201\t- \"go\" (2026-11-04, on the proposed amendments to §5.2 and §6 and on this test)\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc 'nl -ba src/hivemind/release.py'","aggregated_output":"     1\t\"\"\"The \"Forecast unavailable\" release: one allow-listed export of a views ledger, its package and its checks\n     2\t(docs/research/2026-11-22-number-answers/RELEASE-BUILD.md; D726, D756, D758).\n     3\t\n     4\tA number question carries its question, its evidence in force and the marker \"Forecast unavailable\". An event or Yes/No question\n     5\tcarries its question, its evidence and its answer labels. Nothing else is read into the package: no rung condition or bound, no\n     6\tjudgement reason or explanation, no switch reason, no history. Before a package is published, every field is compared with its\n     7\tstored source at the package's day, and nothing published replaces an existing path.\n     8\t\"\"\"\n     9\timport ctypes\n    10\timport ctypes.util\n    11\timport errno\n    12\timport hashlib\n    13\timport json\n    14\timport os\n    15\timport stat\n    16\timport sys\n    17\timport tempfile\n    18\tfrom datetime import date\n    19\tfrom pathlib import Path\n    20\t\n    21\tfrom . import bundle, service, vocabulary\n    22\tfrom .views import identity, store\n    23\t\n    24\tFORMAT = 'hivemind-release/1'\n    25\tALLOW_LIST = 'release-allow-list/1'\n    26\tFORECAST_UNAVAILABLE = 'Forecast unavailable'\n    27\tDATA_FILE = 'release-data.json'\n    28\tMANIFEST_FILE = 'manifest.json'\n    29\tPACKAGE_FILES = frozenset({DATA_FILE, MANIFEST_FILE})\n    30\tCLASSES = ('number', 'event', 'yes_no')\n    31\tALLOWED = {\n    32\t    'envelope': frozenset({'format', 'allow_list', 'as_of', 'questions'}),\n    33\t    'number': frozenset({'id', 'question', 'open', 'class', 'forecast', 'evidence'}),\n    34\t    'answered': frozenset({'id', 'question', 'open', 'class', 'answers', 'answer', 'evidence'}),\n    35\t    'evidence': frozenset({'id', 'one_line', 'quote', 'tier', 'speaker', 'original_who', 'original_day', 'sources'}),\n    36\t    'source': frozenset({'title', 'publisher', 'day', 'uri'}),\n    37\t    'manifest': frozenset({'format', 'allow_list', 'as_of', 'data_sha256'}),\n    38\t}\n    39\tEVIDENCE_TEXT = ('one_line', 'quote', 'tier', 'speaker', 'original_who', 'original_day')\n    40\tSOURCE_TEXT = ('title', 'publisher', 'day', 'uri')\n    41\tRENAME_EXCL = 0x4          # macOS <stdio.h>: renamex_np refuses an existing destination\n    42\tRENAME_NOREPLACE = 0x1     # Linux <linux/fs.h>: renameat2 refuses an existing destination\n    43\tAT_FDCWD = -100\n    44\t\n    45\t\n    46\tclass ReleaseRefused(ValueError):\n    47\t    \"\"\"The release refuses the input, the export or the package; the message names what and where.\"\"\"\n    48\t\n    49\t\n    50\t# ---------- the day\n    51\t\n    52\tdef canonical_day(text):\n    53\t    \"\"\"A day written YYYY-MM-DD, returned unchanged; anything else is refused. The stores compare days as text, so a day Python\n    54\t    also reads (20260825) would select rows from later days.\"\"\"\n    55\t    try:\n    56\t        day = date.fromisoformat(text)\n    57\t    except (TypeError, ValueError):\n    58\t        raise ReleaseRefused(f'not a day: {text!r}') from None\n    59\t    if day.isoformat() != text:\n    60\t        raise ReleaseRefused(f'a day must be written YYYY-MM-DD: {text!r}')\n    61\t    return text\n    62\t\n    63\t\n    64\tdef resolve(views_db, as_of=None):\n    65\t    \"\"\"The bound of a build or a check, one rule for both: a given day must be canonical; `service.resolve_bound` then refuses an\n    66\t    unfinished first day or a day after the last completed day; an omitted day with no default is refused.\"\"\"\n    67\t    if as_of is not None:\n    68\t        canonical_day(as_of)\n    69\t    bound = service.resolve_bound(views_db, as_of)\n    70\t    if not bound:\n    71\t        raise ReleaseRefused('the store has no default day; supply --as-of')\n    72\t    return canonical_day(bound)\n    73\t\n    74\t\n    75\t# ---------- identity\n    76\t\n    77\tdef _has_table(conn, name):\n    78\t    return conn.execute(\"select 1 from sqlite_master where type='table' and name=?\", (name,)).fetchone() is not None\n    79\t\n    80\t\n    81\tdef key_measure(conn, view_id, as_of):\n    82\t    \"\"\"The measure of the view's key as recorded on or before the day, or None: no key table, no key, or a key written after the\n    83\t    day (a later key never reclassifies an earlier package).\"\"\"\n    84\t    if not _has_table(conn, 'view_keys'):\n    85\t        return None\n    86\t    row = conn.execute('select measure, seq from view_keys where view_id=?', (view_id,)).fetchone()\n    87\t    return row['measure'] if row is not None and service.visible(conn, row['seq'], as_of) else None\n    88\t\n    89\t\n    90\tdef ladder(conn, view_id):\n    91\t    \"\"\"(position, label) of every rung, by position: the only rung columns the package reads.\"\"\"\n    92\t    return [(row['position'], row['label']) for row in conn.execute('select position, label from rungs where view_id=? order by position', (view_id,))]\n    93\t\n    94\t\n    95\tdef question_class(conn, view_id, labels, as_of):\n    96\t    \"\"\"'event' for an event measure in the key recorded by the day, 'yes_no' for exactly two labels that are Yes and No in the stored\n    97\t    vocabulary, else 'number' (a view with no key and a ladder whose bands do not resolve included): the forecast of every number\n    98\t    question is withheld.\"\"\"\n    99\t    if key_measure(conn, view_id, as_of) in identity.EVENT_MEASURES:\n   100\t        return 'event'\n   101\t    if len(labels) == 2 and {vocabulary.canonical('label', label) for label in labels} == {'Yes', 'No'}:\n   102\t        return 'yes_no'\n   103\t    return 'number'\n   104\t\n   105\t\n   106\tdef _answer(conn, view_id, as_of, positions):\n   107\t    \"\"\"The stored label of the latest judgement's rung on or before the day, or None when the question is not yet judged.\"\"\"\n   108\t    row = conn.execute('select rung from judgements where view_id=? and publication_day<=? order by judgement_id desc limit 1', (view_id, as_of)).fetchone()\n   109\t    if row is None:\n   110\t        return None\n   111\t    if row['rung'] not in positions:\n   112\t        raise ReleaseRefused(f'{view_id}: its latest judgement names rung {row[\"rung\"]}, which its ladder does not hold')\n   113\t    return positions[row['rung']]\n   114\t\n   115\t\n   116\t# ---------- the export\n   117\t\n   118\tdef _item(items_db, cache, input_id, evidence_id):\n   119\t    if input_id not in cache:\n   120\t        row = items_db.execute('select title, publisher, source_uri from items where input_id=?', (input_id,)).fetchone()\n   121\t        if row is None:\n   122\t            raise ReleaseRefused(f'evidence {evidence_id}: source item {input_id} is not in the items database')\n   123\t        cache[input_id] = row\n   124\t    return cache[input_id]\n   125\t\n   126\t\n   127\tdef _visible_views(conn, as_of):\n   128\t    return [row for row in conn.execute('select view_id, question, created_seq from views order by created_seq, rowid') if service.visible(conn, row['created_seq'], as_of)]\n   129\t\n   130\t\n   131\tdef release_export(views_db, items_db, as_of=None):\n   132\t    \"\"\"The release data as of the bound: every question visible on that day, closed ones included, built field by field from the\n   133\t    allow-list. The result passes `check_export` or nothing is returned.\"\"\"\n   134\t    with bundle.read_snapshot(views_db, items_db):\n   135\t        bound = resolve(views_db, as_of)\n   136\t        items, questions = {}, []\n   137\t        for view in _visible_views(views_db, bound):\n   138\t            view_id = view['view_id']\n   139\t            rungs = ladder(views_db, view_id)\n   140\t            labels = [label for _, label in rungs]\n   141\t            kind = question_class(views_db, view_id, labels, bound)\n   142\t            record = {'id': view_id, 'question': view['question'], 'open': service.is_open_as_of(views_db, view_id, bound), 'class': kind}\n   143\t            if kind == 'number':\n   144\t                record['forecast'] = FORECAST_UNAVAILABLE\n   145\t            else:\n   146\t                record['answers'] = labels\n   147\t                record['answer'] = _answer(views_db, view_id, bound, dict(rungs))\n   148\t            evidence = []\n   149\t            for piece in service.evidence(views_db, view_id, bound):\n   150\t                sources = []\n   151\t                for source in piece['sources']:\n   152\t                    item = _item(items_db, items, source['input_id'], piece['evidence_id'])\n   153\t                    sources.append({'title': item['title'], 'publisher': item['publisher'], 'day': source['publication_day'], 'uri': item['source_uri']})\n   154\t                evidence.append({'id': piece['evidence_id'], **{name: piece[name] for name in EVIDENCE_TEXT}, 'sources': sources})\n   155\t            record['evidence'] = evidence\n   156\t            questions.append(record)\n   157\t        data = {'format': FORMAT, 'allow_list': ALLOW_LIST, 'as_of': bound, 'questions': questions}\n   158\t    check_export(data)\n   159\t    return data\n   160\t\n   161\t\n   162\t# ---------- the closed set\n   163\t\n   164\tdef _keys(value, kind, where):\n   165\t    if not isinstance(value, dict):\n   166\t        raise ReleaseRefused(f'{where}: not an object')\n   167\t    if set(value) != ALLOWED[kind]:\n   168\t        extra, missing = sorted(set(value) - ALLOWED[kind]), sorted(ALLOWED[kind] - set(value))\n   169\t        raise ReleaseRefused(f'{where}: keys off the allow-list {extra}, missing {missing}')\n   170\t\n   171\t\n   172\tdef _texts(value, names, where):\n   173\t    for name in names:\n   174\t        if not isinstance(value[name], str):\n   175\t            raise ReleaseRefused(f'{where}: {name} is not text')\n   176\t\n   177\t\n   178\tdef check_export(data):\n   179\t    \"\"\"Every object at every level holds exactly its record type's keys, with values of the allowed kinds. Returns the counts\n   180\t    judged.\"\"\"\n   181\t    _keys(data, 'envelope', 'the package')\n   182\t    if data['format'] != FORMAT or data['allow_list'] != ALLOW_LIST:\n   183\t        raise ReleaseRefused(f'the package names format {data[\"format\"]!r} and allow-list {data[\"allow_list\"]!r}')\n   184\t    canonical_day(data['as_of'])\n   185\t    if not isinstance(data['questions'], list):\n   186\t        raise ReleaseRefused('the package: questions is not a list')\n   187\t    counts = {'questions': {kind: 0 for kind in CLASSES}, 'evidence': 0, 'sources': 0}\n   188\t    for position, question in enumerate(data['questions']):\n   189\t        where = f'question {position}'\n   190\t        if not isinstance(question, dict) or question.get('class') not in CLASSES:\n   191\t            raise ReleaseRefused(f'{where}: no allowed class')\n   192\t        kind = question['class']\n   193\t        _keys(question, 'number' if kind == 'number' else 'answered', where)\n   194\t        _texts(question, ('id', 'question'), where)\n   195\t        where = f'question {question[\"id\"]}'\n   196\t        if not isinstance(question['open'], bool):\n   197\t            raise ReleaseRefused(f'{where}: open is not true or false')\n   198\t        if kind == 'number':\n   199\t            if question['forecast'] != FORECAST_UNAVAILABLE:\n   200\t                raise ReleaseRefused(f'{where}: a number question carries only the marker')\n   201\t        else:\n   202\t            answers = question['answers']\n   203\t            if not (isinstance(answers, list) and len(answers) == 2 and all(isinstance(a, str) for a in answers)):\n   204\t                raise ReleaseRefused(f'{where}: answers are not two labels')\n   205\t            if question['answer'] is not None and question['answer'] not in answers:\n   206\t                raise ReleaseRefused(f'{where}: the answer is not one of its labels')\n   207\t        if not isinstance(question['evidence'], list):\n   208\t            raise ReleaseRefused(f'{where}: evidence is not a list')\n   209\t        for piece in question['evidence']:\n   210\t            _keys(piece, 'evidence', f'{where} evidence')\n   211\t            _texts(piece, ('id',), f'{where} evidence')\n   212\t            _texts(piece, EVIDENCE_TEXT, f'{where} evidence {piece[\"id\"]}')\n   213\t            if not isinstance(piece['sources'], list):\n   214\t                raise ReleaseRefused(f'{where} evidence {piece[\"id\"]}: sources is not a list')\n   215\t            for source in piece['sources']:\n   216\t                _keys(source, 'source', f'{where} evidence {piece[\"id\"]} source')\n   217\t                _texts(source, SOURCE_TEXT, f'{where} evidence {piece[\"id\"]} source')\n   218\t            counts['sources'] += len(piece['sources'])\n   219\t        counts['evidence'] += len(question['evidence'])\n   220\t        counts['questions'][kind] += 1\n   221\t    return counts\n   222\t\n   223\t\n   224\t# ---------- the origin check\n   225\t\n   226\tdef _open_at(conn, view_id, as_of):\n   227\t    for row in conn.execute('select open, after_seq from view_switches where view_id=? order by id desc', (view_id,)):\n   228\t        if service.visible(conn, row['after_seq'], as_of):\n   229\t            return bool(row['open'])\n   230\t    return True\n   231\t\n   232\t\n   233\tdef _expected_evidence(views_db, items_db, view_id, as_of):\n   234\t    \"\"\"The evidence in force at the day, by its own SQL: visible links in link order, minus those whose latest replacement is\n   235\t    visible; each source row visible at the day, in row order, with its item required.\"\"\"\n   236\t    out = []\n   237\t    for link in views_db.execute('select evidence_id, seq from evidence_links where view_id=? order by id', (view_id,)).fetchall():\n   238\t        if not service.visible(views_db, link['seq'], as_of):\n   239\t            continue\n   240\t        latest = views_db.execute('select seq from replacements where old_evidence_id=? order by id desc limit 1', (link['evidence_id'],)).fetchone()\n   241\t        if latest is not None and service.visible(views_db, latest['seq'], as_of):\n   242\t            continue\n   243\t        row = views_db.execute(f'select evidence_id, {\", \".join(EVIDENCE_TEXT)} from evidence where evidence_id=?', (link['evidence_id'],)).fetchone()\n   244\t        if row is None:\n   245\t            raise ReleaseRefused(f'{view_id}: link to evidence {link[\"evidence_id\"]}, which the store does not hold')\n   246\t        sources = []\n   247\t        for source in views_db.execute('select input_id, publication_day, seq from evidence_sources where evidence_id=? order by id', (link['evidence_id'],)).fetchall():\n   248\t            if not service.visible(views_db, source['seq'], as_of):\n   249\t                continue\n   250\t            item = items_db.execute('select title, publisher, source_uri from items where input_id=?', (source['input_id'],)).fetchone()\n   251\t            if item is None:\n   252\t                raise ReleaseRefused(f'evidence {row[\"evidence_id\"]}: source item {source[\"input_id\"]} is not in the items database')\n   253\t            sources.append({'title': item['title'], 'publisher': item['publisher'], 'day': source['publication_day'], 'uri': item['source_uri']})\n   254\t        out.append({'id': row['evidence_id'], **{name: row[name] for name in EVIDENCE_TEXT}, 'sources': sources})\n   255\t    return out\n   256\t\n   257\t\n   258\tdef _leaves(value):\n   259\t    if isinstance(value, dict):\n   260\t        return sum(_leaves(v) for v in value.values())\n   261\t    if isinstance(value, list):\n   262\t        return sum(_leaves(v) for v in value)\n   263\t    return 1\n   264\t\n   265\t\n   266\tdef _compare(expected, actual, where):\n   267\t    \"\"\"The number of leaf values compared; the first difference is refused, naming where it is.\"\"\"\n   268\t    if isinstance(expected, dict):\n   269\t        if not isinstance(actual, dict) or set(expected) != set(actual):\n   270\t            raise ReleaseRefused(f'{where}: fields differ from the store')\n   271\t        return sum(_compare(expected[key], actual[key], f'{where}.{key}') for key in expected)\n   272\t    if isinstance(expected, list):\n   273\t        if not isinstance(actual, list) or len(expected) != len(actual):\n   274\t            raise ReleaseRefused(f'{where}: {len(actual) if isinstance(actual, list) else \"no\"} entries where the store has {len(expected)}')\n   275\t        return sum(_compare(e, a, f'{where}[{n}]') for n, (e, a) in enumerate(zip(expected, actual)))\n   276\t    if type(expected) is not type(actual) or expected != actual:\n   277\t        raise ReleaseRefused(f'{where}: differs from the store')\n   278\t    return 1\n   279\t\n   280\t\n   281\tdef check_origins(views_db, items_db, data, expected_as_of):\n   282\t    \"\"\"Every package field against its permitted stored source at `expected_as_of`, derived from the store and never from the\n   283\t    package: the day, each question's class, the questions, evidence and sources in order with their counts. Its reads are its own\n   284\t    SQL, apart from the identity rule (`question_class`) and the day of a sequence number (`service.visible`). Returns the number of\n   285\t    fields compared.\"\"\"\n   286\t    with bundle.read_snapshot(views_db, items_db):\n   287\t        as_of = canonical_day(expected_as_of)\n   288\t        if data['as_of'] != as_of:\n   289\t            raise ReleaseRefused(f'the package is dated {data[\"as_of\"]}, the store bound is {as_of}')\n   290\t        views = [row for row in views_db.execute('select view_id, question, created_seq from views order by created_seq, rowid')\n   291\t                 if service.visible(views_db, row['created_seq'], as_of)]\n   292\t        packaged = data['questions']\n   293\t        if [q['id'] for q in packaged] != [row['view_id'] for row in views]:\n   294\t            raise ReleaseRefused(f'the questions differ from the store: {len(packaged)} entries where the store has {len(views)}'\n   295\t                                 if len(packaged) != len(views) else 'the questions or their order differ from the store')\n   296\t        compared = _compare(FORMAT, data['format'], 'package.format') + _compare(ALLOW_LIST, data['allow_list'], 'package.allow_list') + 1\n   297\t        for view, question in zip(views, packaged):\n   298\t            view_id = view['view_id']\n   299\t            positions = {row['position']: row['label'] for row in views_db.execute('select position, label from rungs where view_id=? order by position', (view_id,))}\n   300\t            labels = list(positions.values())\n   301\t            kind = question_class(views_db, view_id, labels, as_of)\n   302\t            record = {'id': view_id, 'question': view['question'], 'open': _open_at(views_db, view_id, as_of), 'class': kind}\n   303\t            if kind == 'number':\n   304\t                record['forecast'] = FORECAST_UNAVAILABLE\n   305\t            else:\n   306\t                latest = views_db.execute('select rung from judgements where view_id=? and publication_day<=? order by judgement_id desc limit 1', (view_id, as_of)).fetchone()\n   307\t                if latest is not None and latest['rung'] not in positions:\n   308\t                    raise ReleaseRefused(f'question {view_id}: its latest judgement names rung {latest[\"rung\"]}, which its ladder does not hold')\n   309\t                record['answers'] = labels\n   310\t                record['answer'] = None if latest is None else positions[latest['rung']]\n   311\t            expected_evidence = _expected_evidence(views_db, items_db, view_id, as_of)\n   312\t            if not isinstance(question.get('evidence'), list) or len(question['evidence']) != len(expected_evidence):\n   313\t                found = len(question['evidence']) if isinstance(question.get('evidence'), list) else 'no'\n   314\t                raise ReleaseRefused(f'question {view_id}.evidence: {found} entries where the store has {len(expected_evidence)}')\n   315\t            record['evidence'] = question['evidence']           # compared piece by piece below, named by the stored evidence id\n   316\t            compared += _compare(record, question, f'question {view_id}') - _leaves(question['evidence'])\n   317\t            for expected, actual in zip(expected_evidence, question['evidence']):\n   318\t                compared += _compare(expected, actual, f'question {view_id}.evidence {expected[\"id\"]}')\n   319\t        return compared\n   320\t\n   321\t\n   322\t# ---------- the package\n   323\t\n   324\tdef _dump(value):\n   325\t    return json.dumps(value, ensure_ascii=False, separators=(',', ':')).encode('utf-8')\n   326\t\n   327\t\n   328\tdef stage(out_dir):\n   329\t    \"\"\"A private staging folder, unique to this invocation, beside the destination.\"\"\"\n   330\t    out_dir = Path(out_dir)\n   331\t    return Path(tempfile.mkdtemp(dir=out_dir.parent, prefix=f'.{out_dir.name}.staging-'))\n   332\t\n   333\t\n   334\tdef write_package(data, staged):\n   335\t    \"\"\"The data file and its manifest, written into the staging folder.\"\"\"\n   336\t    payload = _dump(data)\n   337\t    (Path(staged) / DATA_FILE).write_bytes(payload)\n   338\t    manifest = {'format': data['format'], 'allow_list': data['allow_list'], 'as_of': data['as_of'], 'data_sha256': hashlib.sha256(payload).hexdigest()}\n   339\t    (Path(staged) / MANIFEST_FILE).write_bytes(_dump(manifest))\n   340\t\n   341\t\n   342\tdef _no_replace_rename():\n   343\t    libc = ctypes.CDLL(ctypes.util.find_library('c'), use_errno=True)\n   344\t    if sys.platform == 'darwin' and hasattr(libc, 'renamex_np'):\n   345\t        call = libc.renamex_np\n   346\t        call.argtypes, call.restype = [ctypes.c_char_p, ctypes.c_char_p, ctypes.c_uint], ctypes.c_int\n   347\t        return lambda source, target: call(source, target, RENAME_EXCL)\n   348\t    if sys.platform.startswith('linux') and hasattr(libc, 'renameat2'):\n   349\t        call = libc.renameat2\n   350\t        call.argtypes, call.restype = [ctypes.c_int, ctypes.c_char_p, ctypes.c_int, ctypes.c_char_p, ctypes.c_uint], ctypes.c_int\n   351\t        return lambda source, target: call(AT_FDCWD, source, AT_FDCWD, target, RENAME_NOREPLACE)\n   352\t    return None\n   353\t\n   354\t\n   355\tdef publish(staged, out_dir):\n   356\t    \"\"\"One atomic move of the staged folder to the destination that refuses any existing destination, empty or not.\"\"\"\n   357\t    rename = _no_replace_rename()\n   358\t    if rename is None:\n   359\t        raise ReleaseRefused('this platform offers no atomic rename that refuses an existing destination')\n   360\t    if rename(os.fsencode(str(staged)), os.fsencode(str(out_dir))) != 0:\n   361\t        code = ctypes.get_errno()\n   362\t        if code in (errno.ENOTSUP, errno.EINVAL, errno.ENOSYS):\n   363\t            raise ReleaseRefused(f'the filesystem refuses an atomic no-replace rename ({os.strerror(code)})')\n   364\t        raise OSError(code, os.strerror(code), str(out_dir))\n   365\t\n   366\t\n   367\tdef publish_report(report, path):\n   368\t    \"\"\"The report, written to a private temporary file and linked to its name; the link refuses any existing path, and its success\n   369\t    is the moment the report is published. Returns None, or the temporary file it could not remove after publishing.\"\"\"\n   370\t    path = Path(path)\n   371\t    descriptor, temporary = tempfile.mkstemp(dir=path.parent, prefix=f'.{path.name}.')\n   372\t    try:\n   373\t        with os.fdopen(descriptor, 'wb') as handle:\n   374\t            handle.write(json.dumps(report, ensure_ascii=False, indent=1).encode('utf-8'))\n   375\t        os.link(temporary, path)\n   376\t    except BaseException:\n   377\t        os.unlink(temporary)\n   378\t        raise\n   379\t    try:\n   380\t        os.unlink(temporary)\n   381\t    except OSError:\n   382\t        return temporary\n   383\t    return None\n   384\t\n   385\t\n   386\tdef _unique_members(pairs):\n   387\t    names = [name for name, _ in pairs]\n   388\t    if len(names) != len(set(names)):\n   389\t        raise ReleaseRefused(f'a JSON member name repeats: {sorted({n for n in names if names.count(n) > 1})}')\n   390\t    return dict(pairs)\n   391\t\n   392\t\n   393\tdef read_data(package):\n   394\t    \"\"\"The package's data, read with the repeated-member check. `check_package` returns the data it checked, which is the copy to\n   395\t    trust; this reader is for inspection only.\"\"\"\n   396\t    return _parse((Path(package) / DATA_FILE).read_bytes(), DATA_FILE)\n   397\t\n   398\t\n   399\tURI_CHARACTERS = '%?#'\n   400\t\n   401\t\n   402\tdef store_path(path):\n   403\t    \"\"\"The resolved store path, the one the opener is then given (so the opener's own resolution has nothing left to follow): refused\n   404\t    when it holds a character a SQLite URI decodes (`store.open_read_only` puts the path into a `file:` URI unescaped, so `%2D` would\n   405\t    open a `-`).\"\"\"\n   406\t    real = os.path.realpath(path)\n   407\t    found = sorted({c for c in real if c in URI_CHARACTERS})\n   408\t    if found:\n   409\t        raise ReleaseRefused(f'{path}: a store path may not contain {found}, which the SQLite opener reads as URI syntax')\n   410\t    return real\n   411\t\n   412\t\n   413\tdef _read_regular(folder, name, where):\n   414\t    \"\"\"The bytes of one regular file in an opened folder, read once through a descriptor that refuses a symbolic link and opens a pipe\n   415\t    without waiting, so its type is refused instead.\"\"\"\n   416\t    try:\n   417\t        descriptor = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=folder)   # a pipe or device never blocks the check\n   418\t    except OSError as error:\n   419\t        if error.errno == errno.ELOOP:\n   420\t            raise ReleaseRefused(f'{where}/{name}: not a regular file') from None\n   421\t        raise\n   422\t    try:\n   423\t        if not stat.S_ISREG(os.fstat(descriptor).st_mode):\n   424\t            raise ReleaseRefused(f'{where}/{name}: not a regular file')\n   425\t        chunks = []\n   426\t        while True:\n   427\t            chunk = os.read(descriptor, 1 << 20)\n   428\t            if not chunk:\n   429\t                return b''.join(chunks)\n   430\t            chunks.append(chunk)\n   431\t    finally:\n   432\t        os.close(descriptor)\n   433\t\n   434\t\n   435\tdef _parse(raw, name):\n   436\t    try:\n   437\t        return json.loads(raw.decode('utf-8'), object_pairs_hook=_unique_members)\n   438\t    except (UnicodeDecodeError, json.JSONDecodeError) as error:\n   439\t        raise ReleaseRefused(f'{name}: not JSON ({error})') from None\n   440\t\n   441\t\n   442\tdef check_package(path, views_db=None, items_db=None, expected_as_of=None):\n   443\t    \"\"\"The package as a reader receives it: a real folder holding exactly the two regular files, each read once through one handle on\n   444\t    the folder; JSON with no repeated member name; a closed manifest that agrees with the data and the sha256 of the very bytes\n   445\t    parsed; data that passes `check_export` and, with the stores, `check_origins` at `expected_as_of` (or at the package's own day\n   446\t    passed through `resolve`). Returns (counts, the data checked, its size in bytes).\"\"\"\n   447\t    path = Path(path)\n   448\t    try:\n   449\t        folder = os.open(path, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)\n   450\t    except OSError as error:\n   451\t        if error.errno in (errno.ELOOP, errno.ENOTDIR):\n   452\t            raise ReleaseRefused(f'{path}: not a folder') from None\n   453\t        raise\n   454\t    try:\n   455\t        names = os.listdir(folder)\n   456\t        if sorted(names) != sorted(PACKAGE_FILES):\n   457\t            raise ReleaseRefused(f'{path}: holds {sorted(names)}, not exactly {sorted(PACKAGE_FILES)}')\n   458\t        raw, manifest_raw = _read_regular(folder, DATA_FILE, path), _read_regular(folder, MANIFEST_FILE, path)\n   459\t    finally:\n   460\t        os.close(folder)\n   461\t    manifest, data = _parse(manifest_raw, MANIFEST_FILE), _parse(raw, DATA_FILE)\n   462\t    counts = check_export(data)\n   463\t    _keys(manifest, 'manifest', 'the manifest')\n   464\t    if manifest['data_sha256'] != hashlib.sha256(raw).hexdigest():\n   465\t        raise ReleaseRefused('the manifest sha256 does not match the data file')\n   466\t    for name in ('format', 'allow_list', 'as_of'):\n   467\t        if manifest[name] != data[name]:\n   468\t            raise ReleaseRefused(f'the manifest {name} {manifest[name]!r} differs from the data {data[name]!r}')\n   469\t    if views_db is not None:\n   470\t        bound = expected_as_of if expected_as_of is not None else resolve(views_db, data['as_of'])\n   471\t        counts['fields_compared'] = check_origins(views_db, items_db, data, bound)\n   472\t    return counts, data, len(raw)\n   473\t\n   474\t\n   475\t# ---------- the report\n   476\t\n   477\tdef withheld_unresolved(views_db, data):\n   478\t    \"\"\"For the release report only: the number questions whose ladder does not resolve to bands, with the reason and whether the\n   479\t    view has a key. Withheld like every number question; this list never enters the package.\"\"\"\n   480\t    out = []\n   481\t    for question in data['questions']:\n   482\t        if question['class'] != 'number':\n   483\t            continue\n   484\t        bands, reason = service.ladder_bands(store.rungs_of(views_db, question['id']))\n   485\t        if bands is None:\n   486\t            out.append({'id': question['id'], 'reason': reason, 'has_key': key_measure(views_db, question['id'], data['as_of']) is not None})\n   487\t    return out\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_8","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"rg -n 'D75[689]|75d|Council 74|round 75d' docs/DECISIONS-log.md docs/research/2026-11-22-number-answers docs/CURRENT_STATE.md | tail -85\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"rg -n 'D75[689]|75d|Council 74|round 75d' docs/DECISIONS-log.md docs/research/2026-11-22-number-answers docs/CURRENT_STATE.md | tail -85\"","aggregated_output":"docs/research/2026-11-22-number-answers/codex-r75e.stream:28:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_14\",\"type\":\"command_execution\",\"command\":\"/opt/homebrew/bin/zsh -lc 'nl -ba src/hivemind/release.py'\",\"aggregated_output\":\"     1\\t\\\"\\\"\\\"The \\\"Forecast unavailable\\\" release: one allow-listed export of a views ledger, its package and its checks\\n     2\\t(docs/research/2026-11-22-number-answers/RELEASE-BUILD.md; D726, D756, D758).\\n     3\\t\\n     4\\tA number question carries its question, its evidence in force and the marker \\\"Forecast unavailable\\\". An event or Yes/No question\\n     5\\tcarries its question, its evidence and its answer labels. Nothing else is read into the package: no rung condition or bound, no\\n     6\\tjudgement reason or explanation, no switch reason, no history. Before a package is published, every field is compared with its\\n     7\\tstored source at the package's day, and nothing published replaces an existing path.\\n     8\\t\\\"\\\"\\\"\\n     9\\timport ctypes\\n    10\\timport ctypes.util\\n    11\\timport errno\\n    12\\timport hashlib\\n    13\\timport json\\n    14\\timport os\\n    15\\timport stat\\n    16\\timport sys\\n    17\\timport tempfile\\n    18\\tfrom datetime import date\\n    19\\tfrom pathlib import Path\\n    20\\t\\n    21\\tfrom . import bundle, service, vocabulary\\n    22\\tfrom .views import identity, store\\n    23\\t\\n    24\\tFORMAT = 'hivemind-release/1'\\n    25\\tALLOW_LIST = 'release-allow-list/1'\\n    26\\tFORECAST_UNAVAILABLE = 'Forecast unavailable'\\n    27\\tDATA_FILE = 'release-data.json'\\n    28\\tMANIFEST_FILE = 'manifest.json'\\n    29\\tPACKAGE_FILES = frozenset({DATA_FILE, MANIFEST_FILE})\\n    30\\tCLASSES = ('number', 'event', 'yes_no')\\n    31\\tALLOWED = {\\n    32\\t    'envelope': frozenset({'format', 'allow_list', 'as_of', 'questions'}),\\n    33\\t    'number': frozenset({'id', 'question', 'open', 'class', 'forecast', 'evidence'}),\\n    34\\t    'answered': frozenset({'id', 'question', 'open', 'class', 'answers', 'answer', 'evidence'}),\\n    35\\t    'evidence': frozenset({'id', 'one_line', 'quote', 'tier', 'speaker', 'original_who', 'original_day', 'sources'}),\\n    36\\t    'source': frozenset({'title', 'publisher', 'day', 'uri'}),\\n    37\\t    'manifest': frozenset({'format', 'allow_list', 'as_of', 'data_sha256'}),\\n    38\\t}\\n    39\\tEVIDENCE_TEXT = ('one_line', 'quote', 'tier', 'speaker', 'original_who', 'original_day')\\n    40\\tSOURCE_TEXT = ('title', 'publisher', 'day', 'uri')\\n    41\\tRENAME_EXCL = 0x4          # macOS <stdio.h>: renamex_np refuses an existing destination\\n    42\\tRENAME_NOREPLACE = 0x1     # Linux <linux/fs.h>: renameat2 refuses an existing destination\\n    43\\tAT_FDCWD = -100\\n    44\\t\\n    45\\t\\n    46\\tclass ReleaseRefused(ValueError):\\n    47\\t    \\\"\\\"\\\"The release refuses the input, the export or the package; the message names what and where.\\\"\\\"\\\"\\n    48\\t\\n    49\\t\\n    50\\t# ---------- the day\\n    51\\t\\n    52\\tdef canonical_day(text):\\n    53\\t    \\\"\\\"\\\"A day written YYYY-MM-DD, returned unchanged; anything else is refused. The stores compare days as text, so a day Python\\n    54\\t    also reads (20260825) would select rows from later days.\\\"\\\"\\\"\\n    55\\t    try:\\n    56\\t        day = date.fromisoformat(text)\\n    57\\t    except (TypeError, ValueError):\\n    58\\t        raise ReleaseRefused(f'not a day: {text!r}') from None\\n    59\\t    if day.isoformat() != text:\\n    60\\t        raise ReleaseRefused(f'a day must be written YYYY-MM-DD: {text!r}')\\n    61\\t    return text\\n    62\\t\\n    63\\t\\n    64\\tdef resolve(views_db, as_of=None):\\n    65\\t    \\\"\\\"\\\"The bound of a build or a check, one rule for both: a given day must be canonical; `service.resolve_bound` then refuses an\\n    66\\t    unfinished first day or a day after the last completed day; an omitted day with no default is refused.\\\"\\\"\\\"\\n    67\\t    if as_of is not None:\\n    68\\t        canonical_day(as_of)\\n    69\\t    bound = service.resolve_bound(views_db, as_of)\\n    70\\t    if not bound:\\n    71\\t        raise ReleaseRefused('the store has no default day; supply --as-of')\\n    72\\t    return canonical_day(bound)\\n    73\\t\\n    74\\t\\n    75\\t# ---------- identity\\n    76\\t\\n    77\\tdef _has_table(conn, name):\\n    78\\t    return conn.execute(\\\"select 1 from sqlite_master where type='table' and name=?\\\", (name,)).fetchone() is not None\\n    79\\t\\n    80\\t\\n    81\\tdef key_measure(conn, view_id, as_of):\\n    82\\t    \\\"\\\"\\\"The measure of the view's key as recorded on or before the day, or None: no key table, no key, or a key written after the\\n    83\\t    day (a later key never reclassifies an earlier package).\\\"\\\"\\\"\\n    84\\t    if not _has_table(conn, 'view_keys'):\\n    85\\t        return None\\n    86\\t    row = conn.execute('select measure, seq from view_keys where view_id=?', (view_id,)).fetchone()\\n    87\\t    return row['measure'] if row is not None and service.visible(conn, row['seq'], as_of) else None\\n    88\\t\\n    89\\t\\n    90\\tdef ladder(conn, view_id):\\n    91\\t    \\\"\\\"\\\"(position, label) of every rung, by position: the only rung columns the package reads.\\\"\\\"\\\"\\n    92\\t    return [(row['position'], row['label']) for row in conn.execute('select position, label from rungs where view_id=? order by position', (view_id,))]\\n    93\\t\\n    94\\t\\n    95\\tdef question_class(conn, view_id, labels, as_of):\\n    96\\t    \\\"\\\"\\\"'event' for an event measure in the key recorded by the day, 'yes_no' for exactly two labels that are Yes and No in the stored\\n    97\\t    vocabulary, else 'number' (a view with no key and a ladder whose bands do not resolve included): the forecast of every number\\n    98\\t    question is withheld.\\\"\\\"\\\"\\n    99\\t    if key_measure(conn, view_id, as_of) in identity.EVENT_MEASURES:\\n   100\\t        return 'event'\\n   101\\t    if len(labels) == 2 and {vocabulary.canonical('label', label) for label in labels} == {'Yes', 'No'}:\\n   102\\t        return 'yes_no'\\n   103\\t    return 'number'\\n   104\\t\\n   105\\t\\n   106\\tdef _answer(conn, view_id, as_of, positions):\\n   107\\t    \\\"\\\"\\\"The stored label of the latest judgement's rung on or before the day, or None when the question is not yet judged.\\\"\\\"\\\"\\n   108\\t    row = conn.execute('select rung from judgements where view_id=? and publication_day<=? order by judgement_id desc limit 1', (view_id, as_of)).fetchone()\\n   109\\t    if row is None:\\n   110\\t        return None\\n   111\\t    if row['rung'] not in positions:\\n   112\\t        raise ReleaseRefused(f'{view_id}: its latest judgement names rung {row[\\\"rung\\\"]}, which its ladder does not hold')\\n   113\\t    return positions[row['rung']]\\n   114\\t\\n   115\\t\\n   116\\t# ---------- the export\\n   117\\t\\n   118\\tdef _item(items_db, cache, input_id, evidence_id):\\n   119\\t    if input_id not in cache:\\n   120\\t        row = items_db.execute('select title, publisher, source_uri from items where input_id=?', (input_id,)).fetchone()\\n   121\\t        if row is None:\\n   122\\t            raise ReleaseRefused(f'evidence {evidence_id}: source item {input_id} is not in the items database')\\n   123\\t        cache[input_id] = row\\n   124\\t    return cache[input_id]\\n   125\\t\\n   126\\t\\n   127\\tdef _visible_views(conn, as_of):\\n   128\\t    return [row for row in conn.execute('select view_id, question, created_seq from views order by created_seq, rowid') if service.visible(conn, row['created_seq'], as_of)]\\n   129\\t\\n   130\\t\\n   131\\tdef release_export(views_db, items_db, as_of=None):\\n   132\\t    \\\"\\\"\\\"The release data as of the bound: every question visible on that day, closed ones included, built field by field from the\\n   133\\t    allow-list. The result passes `check_export` or nothing is returned.\\\"\\\"\\\"\\n   134\\t    with bundle.read_snapshot(views_db, items_db):\\n   135\\t        bound = resolve(views_db, as_of)\\n   136\\t        items, questions = {}, []\\n   137\\t        for view in _visible_views(views_db, bound):\\n   138\\t            view_id = view['view_id']\\n   139\\t            rungs = ladder(views_db, view_id)\\n   140\\t            labels = [label for _, label in rungs]\\n   141\\t            kind = question_class(views_db, view_id, labels, bound)\\n   142\\t            record = {'id': view_id, 'question': view['question'], 'open': service.is_open_as_of(views_db, view_id, bound), 'class': kind}\\n   143\\t            if kind == 'number':\\n   144\\t                record['forecast'] = FORECAST_UNAVAILABLE\\n   145\\t            else:\\n   146\\t                record['answers'] = labels\\n   147\\t                record['answer'] = _answer(views_db, view_id, bound, dict(rungs))\\n   148\\t            evidence = []\\n   149\\t            for piece in service.evidence(views_db, view_id, bound):\\n   150\\t                sources = []\\n   151\\t                for source in piece['sources']:\\n   152\\t                    item = _item(items_db, items, source['input_id'], piece['evidence_id'])\\n   153\\t                    sources.append({'title': item['title'], 'publisher': item['publisher'], 'day': source['publication_day'], 'uri': item['source_uri']})\\n   154\\t                evidence.append({'id': piece['evidence_id'], **{name: piece[name] for name in EVIDENCE_TEXT}, 'sources': sources})\\n   155\\t            record['evidence'] = evidence\\n   156\\t            questions.append(record)\\n   157\\t        data = {'format': FORMAT, 'allow_list': ALLOW_LIST, 'as_of': bound, 'questions': questions}\\n   158\\t    check_export(data)\\n   159\\t    return data\\n   160\\t\\n   161\\t\\n   162\\t# ---------- the closed set\\n   163\\t\\n   164\\tdef _keys(value, kind, where):\\n   165\\t    if not isinstance(value, dict):\\n   166\\t        raise ReleaseRefused(f'{where}: not an object')\\n   167\\t    if set(value) != ALLOWED[kind]:\\n   168\\t        extra, missing = sorted(set(value) - ALLOWED[kind]), sorted(ALLOWED[kind] - set(value))\\n   169\\t        raise ReleaseRefused(f'{where}: keys off the allow-list {extra}, missing {missing}')\\n   170\\t\\n   171\\t\\n   172\\tdef _texts(value, names, where):\\n   173\\t    for name in names:\\n   174\\t        if not isinstance(value[name], str):\\n   175\\t            raise ReleaseRefused(f'{where}: {name} is not text')\\n   176\\t\\n   177\\t\\n   178\\tdef check_export(data):\\n   179\\t    \\\"\\\"\\\"Every object at every level holds exactly its record type's keys, with values of the allowed kinds. Returns the counts\\n   180\\t    judged.\\\"\\\"\\\"\\n   181\\t    _keys(data, 'envelope', 'the package')\\n   182\\t    if data['format'] != FORMAT or data['allow_list'] != ALLOW_LIST:\\n   183\\t        raise ReleaseRefused(f'the package names format {data[\\\"format\\\"]!r} and allow-list {data[\\\"allow_list\\\"]!r}')\\n   184\\t    canonical_day(data['as_of'])\\n   185\\t    if not isinstance(data['questions'], list):\\n   186\\t        raise ReleaseRefused('the package: questions is not a list')\\n   187\\t    counts = {'questions': {kind: 0 for kind in CLASSES}, 'evidence': 0, 'sources': 0}\\n   188\\t    for position, question in enumerate(data['questions']):\\n   189\\t        where = f'question {position}'\\n   190\\t        if not isinstance(question, dict) or question.get('class') not in CLASSES:\\n   191\\t            raise ReleaseRefused(f'{where}: no allowed class')\\n   192\\t        kind = question['class']\\n   193\\t        _keys(question, 'number' if kind == 'number' else 'answered', where)\\n   194\\t        _texts(question, ('id', 'question'), where)\\n   195\\t        where = f'question {question[\\\"id\\\"]}'\\n   196\\t        if not isinstance(question['open'], bool):\\n   197\\t            raise ReleaseRefused(f'{where}: open is not true or false')\\n   198\\t        if kind == 'number':\\n   199\\t            if question['forecast'] != FORECAST_UNAVAILABLE:\\n   200\\t                raise ReleaseRefused(f'{where}: a number question carries only the marker')\\n   201\\t        else:\\n   202\\t            answers = question['answers']\\n   203\\t            if not (isinstance(answers, list) and len(answers) == 2 and all(isinstance(a, str) for a in answers)):\\n   204\\t                raise ReleaseRefused(f'{where}: answers are not two labels')\\n   205\\t            if question['answer'] is not None and question['answer'] not in answers:\\n   206\\t                raise ReleaseRefused(f'{where}: the answer is not one of its labels')\\n   207\\t        if not isinstance(question['evidence'], list):\\n   208\\t            raise ReleaseRefused(f'{where}: evidence is not a list')\\n   209\\t        for piece in question['evidence']:\\n   210\\t            _keys(piece, 'evidence', f'{where} evidence')\\n   211\\t            _texts(piece, ('id',), f'{where} evidence')\\n   212\\t            _texts(piece, EVIDENCE_TEXT, f'{where} evidence {piece[\\\"id\\\"]}')\\n   213\\t            if not isinstance(piece['sources'], list):\\n   214\\t                raise ReleaseRefused(f'{where} evidence {piece[\\\"id\\\"]}: sources is not a list')\\n   215\\t            for source in piece['sources']:\\n   216\\t                _keys(source, 'source', f'{where} evidence {piece[\\\"id\\\"]} source')\\n   217\\t                _texts(source, SOURCE_TEXT, f'{where} evidence {piece[\\\"id\\\"]} source')\\n   218\\t            counts['sources'] += len(piece['sources'])\\n   219\\t        counts['evidence'] += len(question['evidence'])\\n   220\\t        counts['questions'][kind] += 1\\n   221\\t    return counts\\n   222\\t\\n   223\\t\\n   224\\t# ---------- the origin check\\n   225\\t\\n   226\\tdef _open_at(conn, view_id, as_of):\\n   227\\t    for row in conn.execute('select open, after_seq from view_switches where view_id=? order by id desc', (view_id,)):\\n   228\\t        if service.visible(conn, row['after_seq'], as_of):\\n   229\\t            return bool(row['open'])\\n   230\\t    return True\\n   231\\t\\n   232\\t\\n   233\\tdef _expected_evidence(views_db, items_db, view_id, as_of):\\n   234\\t    \\\"\\\"\\\"The evidence in force at the day, by its own SQL: visible links in link order, minus those whose latest replacement is\\n   235\\t    visible; each source row visible at the day, in row order, with its item required.\\\"\\\"\\\"\\n   236\\t    out = []\\n   237\\t    for link in views_db.execute('select evidence_id, seq from evidence_links where view_id=? order by id', (view_id,)).fetchall():\\n   238\\t        if not service.visible(views_db, link['seq'], as_of):\\n   239\\t            continue\\n   240\\t        latest = views_db.execute('select seq from replacements where old_evidence_id=? order by id desc limit 1', (link['evidence_id'],)).fetchone()\\n   241\\t        if latest is not None and service.visible(views_db, latest['seq'], as_of):\\n   242\\t            continue\\n   243\\t        row = views_db.execute(f'select evidence_id, {\\\", \\\".join(EVIDENCE_TEXT)} from evidence where evidence_id=?', (link['evidence_id'],)).fetchone()\\n   244\\t        if row is None:\\n   245\\t            raise ReleaseRefused(f'{view_id}: link to evidence {link[\\\"evidence_id\\\"]}, which the store does not hold')\\n   246\\t        sources = []\\n   247\\t        for source in views_db.execute('select input_id, publication_day, seq from evidence_sources where evidence_id=? order by id', (link['evidence_id'],)).fetchall():\\n   248\\t            if not service.visible(views_db, source['seq'], as_of):\\n   249\\t                continue\\n   250\\t            item = items_db.execute('select title, publisher, source_uri from items where input_id=?', (source['input_id'],)).fetchone()\\n   251\\t            if item is None:\\n   252\\t                raise ReleaseRefused(f'evidence {row[\\\"evidence_id\\\"]}: source item {source[\\\"input_id\\\"]} is not in the items database')\\n   253\\t            sources.append({'title': item['title'], 'publisher': item['publisher'], 'day': source['publication_day'], 'uri': item['source_uri']})\\n   254\\t        out.append({'id': row['evidence_id'], **{name: row[name] for name in EVIDENCE_TEXT}, 'sources': sources})\\n   255\\t    return out\\n   256\\t\\n   257\\t\\n   258\\tdef _leaves(value):\\n   259\\t    if isinstance(value, dict):\\n   260\\t        return sum(_leaves(v) for v in value.values())\\n   261\\t    if isinstance(value, list):\\n   262\\t        return sum(_leaves(v) for v in value)\\n   263\\t    return 1\\n   264\\t\\n   265\\t\\n   266\\tdef _compare(expected, actual, where):\\n   267\\t    \\\"\\\"\\\"The number of leaf values compared; the first difference is refused, naming where it is.\\\"\\\"\\\"\\n   268\\t    if isinstance(expected, dict):\\n   269\\t        if not isinstance(actual, dict) or set(expected) != set(actual):\\n   270\\t            raise ReleaseRefused(f'{where}: fields differ from the store')\\n   271\\t        return sum(_compare(expected[key], actual[key], f'{where}.{key}') for key in expected)\\n   272\\t    if isinstance(expected, list):\\n   273\\t        if not isinstance(actual, list) or len(expected) != len(actual):\\n   274\\t            raise ReleaseRefused(f'{where}: {len(actual) if isinstance(actual, list) else \\\"no\\\"} entries where the store has {len(expected)}')\\n   275\\t        return sum(_compare(e, a, f'{where}[{n}]') for n, (e, a) in enumerate(zip(expected, actual)))\\n   276\\t    if type(expected) is not type(actual) or expected != actual:\\n   277\\t        raise ReleaseRefused(f'{where}: differs from the store')\\n   278\\t    return 1\\n   279\\t\\n   280\\t\\n   281\\tdef check_origins(views_db, items_db, data, expected_as_of):\\n   282\\t    \\\"\\\"\\\"Every package field against its permitted stored source at `expected_as_of`, derived from the store and never from the\\n   283\\t    package: the day, each question's class, the questions, evidence and sources in order with their counts. Its reads are its own\\n   284\\t    SQL, apart from the identity rule (`question_class`) and the day of a sequence number (`service.visible`). Returns the number of\\n   285\\t    fields compared.\\\"\\\"\\\"\\n   286\\t    with bundle.read_snapshot(views_db, items_db):\\n   287\\t        as_of = canonical_day(expected_as_of)\\n   288\\t        if data['as_of'] != as_of:\\n   289\\t            raise ReleaseRefused(f'the package is dated {data[\\\"as_of\\\"]}, the store bound is {as_of}')\\n   290\\t        views = [row for row in views_db.execute('select view_id, question, created_seq from views order by created_seq, rowid')\\n   291\\t                 if service.visible(views_db, row['created_seq'], as_of)]\\n   292\\t        packaged = data['questions']\\n   293\\t        if [q['id'] for q in packaged] != [row['view_id'] for row in views]:\\n   294\\t            raise ReleaseRefused(f'the questions differ from the store: {len(packaged)} entries where the store has {len(views)}'\\n   295\\t                                 if len(packaged) != len(views) else 'the questions or their order differ from the store')\\n   296\\t        compared = _compare(FORMAT, data['format'], 'package.format') + _compare(ALLOW_LIST, data['allow_list'], 'package.allow_list') + 1\\n   297\\t        for view, question in zip(views, packaged):\\n   298\\t            view_id = view['view_id']\\n   299\\t            positions = {row['position']: row['label'] for row in views_db.execute('select position, label from rungs where view_id=? order by position', (view_id,))}\\n   300\\t            labels = list(positions.values())\\n   301\\t            kind = question_class(views_db, view_id, labels, as_of)\\n   302\\t            record = {'id': view_id, 'question': view['question'], 'open': _open_at(views_db, view_id, as_of), 'class': kind}\\n   303\\t            if kind == 'number':\\n   304\\t                record['forecast'] = FORECAST_UNAVAILABLE\\n   305\\t            else:\\n   306\\t                latest = views_db.execute('select rung from judgements where view_id=? and publication_day<=? order by judgement_id desc limit 1', (view_id, as_of)).fetchone()\\n   307\\t                if latest is not None and latest['rung'] not in positions:\\n   308\\t                    raise ReleaseRefused(f'question {view_id}: its latest judgement names rung {latest[\\\"rung\\\"]}, which its ladder does not hold')\\n   309\\t                record['answers'] = labels\\n   310\\t                record['answer'] = None if latest is None else positions[latest['rung']]\\n   311\\t            expected_evidence = _expected_evidence(views_db, items_db, view_id, as_of)\\n   312\\t            if not isinstance(question.get('evidence'), list) or len(question['evidence']) != len(expected_evidence):\\n   313\\t                found = len(question['evidence']) if isinstance(question.get('evidence'), list) else 'no'\\n   314\\t                raise ReleaseRefused(f'question {view_id}.evidence: {found} entries where the store has {len(expected_evidence)}')\\n   315\\t            record['evidence'] = question['evidence']           # compared piece by piece below, named by the stored evidence id\\n   316\\t            compared += _compare(record, question, f'question {view_id}') - _leaves(question['evidence'])\\n   317\\t            for expected, actual in zip(expected_evidence, question['evidence']):\\n   318\\t                compared += _compare(expected, actual, f'question {view_id}.evidence {expected[\\\"id\\\"]}')\\n   319\\t        return compared\\n   320\\t\\n   321\\t\\n   322\\t# ---------- the package\\n   323\\t\\n   324\\tdef _dump(value):\\n   325\\t    return json.dumps(value, ensure_ascii=False, separators=(',', ':')).encode('utf-8')\\n   326\\t\\n   327\\t\\n   328\\tdef stage(out_dir):\\n   329\\t    \\\"\\\"\\\"A private staging folder, unique to this invocation, beside the destination.\\\"\\\"\\\"\\n   330\\t    out_dir = Path(out_dir)\\n   331\\t    return Path(tempfile.mkdtemp(dir=out_dir.parent, prefix=f'.{out_dir.name}.staging-'))\\n   332\\t\\n   333\\t\\n   334\\tdef write_package(data, staged):\\n   335\\t    \\\"\\\"\\\"The data file and its manifest, written into the staging folder.\\\"\\\"\\\"\\n   336\\t    payload = _dump(data)\\n   337\\t    (Path(staged) / DATA_FILE).write_bytes(payload)\\n   338\\t    manifest = {'format': data['format'], 'allow_list': data['allow_list'], 'as_of': data['as_of'], 'data_sha256': hashlib.sha256(payload).hexdigest()}\\n   339\\t    (Path(staged) / MANIFEST_FILE).write_bytes(_dump(manifest))\\n   340\\t\\n   341\\t\\n   342\\tdef _no_replace_rename():\\n   343\\t    libc = ctypes.CDLL(ctypes.util.find_library('c'), use_errno=True)\\n   344\\t    if sys.platform == 'darwin' and hasattr(libc, 'renamex_np'):\\n   345\\t        call = libc.renamex_np\\n   346\\t        call.argtypes, call.restype = [ctypes.c_char_p, ctypes.c_char_p, ctypes.c_uint], ctypes.c_int\\n   347\\t        return lambda source, target: call(source, target, RENAME_EXCL)\\n   348\\t    if sys.platform.startswith('linux') and hasattr(libc, 'renameat2'):\\n   349\\t        call = libc.renameat2\\n   350\\t        call.argtypes, call.restype = [ctypes.c_int, ctypes.c_char_p, ctypes.c_int, ctypes.c_char_p, ctypes.c_uint], ctypes.c_int\\n   351\\t        return lambda source, target: call(AT_FDCWD, source, AT_FDCWD, target, RENAME_NOREPLACE)\\n   352\\t    return None\\n   353\\t\\n   354\\t\\n   355\\tdef publish(staged, out_dir):\\n   356\\t    \\\"\\\"\\\"One atomic move of the staged folder to the destination that refuses any existing destination, empty or not.\\\"\\\"\\\"\\n   357\\t    rename = _no_replace_rename()\\n   358\\t    if rename is None:\\n   359\\t        raise ReleaseRefused('this platform offers no atomic rename that refuses an existing destination')\\n   360\\t    if rename(os.fsencode(str(staged)), os.fsencode(str(out_dir))) != 0:\\n   361\\t        code = ctypes.get_errno()\\n   362\\t        if code in (errno.ENOTSUP, errno.EINVAL, errno.ENOSYS):\\n   363\\t            raise ReleaseRefused(f'the filesystem refuses an atomic no-replace rename ({os.strerror(code)})')\\n   364\\t        raise OSError(code, os.strerror(code), str(out_dir))\\n   365\\t\\n   366\\t\\n   367\\tdef publish_report(report, path):\\n   368\\t    \\\"\\\"\\\"The report, written to a private temporary file and linked to its name; the link refuses any existing path, and its success\\n   369\\t    is the moment the report is published. Returns None, or the temporary file it could not remove after publishing.\\\"\\\"\\\"\\n   370\\t    path = Path(path)\\n   371\\t    descriptor, temporary = tempfile.mkstemp(dir=path.parent, prefix=f'.{path.name}.')\\n   372\\t    try:\\n   373\\t        with os.fdopen(descriptor, 'wb') as handle:\\n   374\\t            handle.write(json.dumps(report, ensure_ascii=False, indent=1).encode('utf-8'))\\n   375\\t        os.link(temporary, path)\\n   376\\t    except BaseException:\\n   377\\t        os.unlink(temporary)\\n   378\\t        raise\\n   379\\t    try:\\n   380\\t        os.unlink(temporary)\\n   381\\t    except OSError:\\n   382\\t        return temporary\\n   383\\t    return None\\n   384\\t\\n   385\\t\\n   386\\tdef _unique_members(pairs):\\n   387\\t    names = [name for name, _ in pairs]\\n   388\\t    if len(names) != len(set(names)):\\n   389\\t        raise ReleaseRefused(f'a JSON member name repeats: {sorted({n for n in names if names.count(n) > 1})}')\\n   390\\t    return dict(pairs)\\n   391\\t\\n   392\\t\\n   393\\tdef read_data(package):\\n   394\\t    \\\"\\\"\\\"The package's data, read with the repeated-member check. `check_package` returns the data it checked, which is the copy to\\n   395\\t    trust; this reader is for inspection only.\\\"\\\"\\\"\\n   396\\t    return _parse((Path(package) / DATA_FILE).read_bytes(), DATA_FILE)\\n   397\\t\\n   398\\t\\n   399\\tURI_CHARACTERS = '%?#'\\n   400\\t\\n   401\\t\\n   402\\tdef store_path(path):\\n   403\\t    \\\"\\\"\\\"The resolved store path, the one the opener is then given (so the opener's own resolution has nothing left to follow): refused\\n   404\\t    when it holds a character a SQLite URI decodes (`store.open_read_only` puts the path into a `file:` URI unescaped, so `%2D` would\\n   405\\t    open a `-`).\\\"\\\"\\\"\\n   406\\t    real = os.path.realpath(path)\\n   407\\t    found = sorted({c for c in real if c in URI_CHARACTERS})\\n   408\\t    if found:\\n   409\\t        raise ReleaseRefused(f'{path}: a store path may not contain {found}, which the SQLite opener reads as URI syntax')\\n   410\\t    return real\\n   411\\t\\n   412\\t\\n   413\\tdef _read_regular(folder, name, where):\\n   414\\t    \\\"\\\"\\\"The bytes of one regular file in an opened folder, read once through a descriptor that refuses a symbolic link and opens a pipe\\n   415\\t    without waiting, so its type is refused instead.\\\"\\\"\\\"\\n   416\\t    try:\\n   417\\t        descriptor = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=folder)   # a pipe or device never blocks the check\\n   418\\t    except OSError as error:\\n   419\\t        if error.errno == errno.ELOOP:\\n   420\\t            raise ReleaseRefused(f'{where}/{name}: not a regular file') from None\\n   421\\t        raise\\n   422\\t    try:\\n   423\\t        if not stat.S_ISREG(os.fstat(descriptor).st_mode):\\n   424\\t            raise ReleaseRefused(f'{where}/{name}: not a regular file')\\n   425\\t        chunks = []\\n   426\\t        while True:\\n   427\\t            chunk = os.read(descriptor, 1 << 20)\\n   428\\t            if not chunk:\\n   429\\t                return b''.join(chunks)\\n   430\\t            chunks.append(chunk)\\n   431\\t    finally:\\n   432\\t        os.close(descriptor)\\n   433\\t\\n   434\\t\\n   435\\tdef _parse(raw, name):\\n   436\\t    try:\\n   437\\t        return json.loads(raw.decode('utf-8'), object_pairs_hook=_unique_members)\\n   438\\t    except (UnicodeDecodeError, json.JSONDecodeError) as error:\\n   439\\t        raise ReleaseRefused(f'{name}: not JSON ({error})') from None\\n   440\\t\\n   441\\t\\n   442\\tdef check_package(path, views_db=None, items_db=None, expected_as_of=None):\\n   443\\t    \\\"\\\"\\\"The package as a reader receives it: a real folder holding exactly the two regular files, each read once through one handle on\\n   444\\t    the folder; JSON with no repeated member name; a closed manifest that agrees with the data and the sha256 of the very bytes\\n   445\\t    parsed; data that passes `check_export` and, with the stores, `check_origins` at `expected_as_of` (or at the package's own day\\n   446\\t    passed through `resolve`). Returns (counts, the data checked, its size in bytes).\\\"\\\"\\\"\\n   447\\t    path = Path(path)\\n   448\\t    try:\\n   449\\t        folder = os.open(path, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)\\n   450\\t    except OSError as error:\\n   451\\t        if error.errno in (errno.ELOOP, errno.ENOTDIR):\\n   452\\t            raise ReleaseRefused(f'{path}: not a folder') from None\\n   453\\t        raise\\n   454\\t    try:\\n   455\\t        names = os.listdir(folder)\\n   456\\t        if sorted(names) != sorted(PACKAGE_FILES):\\n   457\\t            raise ReleaseRefused(f'{path}: holds {sorted(names)}, not exactly {sorted(PACKAGE_FILES)}')\\n   458\\t        raw, manifest_raw = _read_regular(folder, DATA_FILE, path), _read_regular(folder, MANIFEST_FILE, path)\\n   459\\t    finally:\\n   460\\t        os.close(folder)\\n   461\\t    manifest, data = _parse(manifest_raw, MANIFEST_FILE), _parse(raw, DATA_FILE)\\n   462\\t    counts = check_export(data)\\n   463\\t    _keys(manifest, 'manifest', 'the manifest')\\n   464\\t    if manifest['data_sha256'] != hashlib.sha256(raw).hexdigest():\\n   465\\t        raise ReleaseRefused('the manifest sha256 does not match the data file')\\n   466\\t    for name in ('format', 'allow_list', 'as_of'):\\n   467\\t        if manifest[name] != data[name]:\\n   468\\t            raise ReleaseRefused(f'the manifest {name} {manifest[name]!r} differs from the data {data[name]!r}')\\n   469\\t    if views_db is not None:\\n   470\\t        bound = expected_as_of if expected_as_of is not None else resolve(views_db, data['as_of'])\\n   471\\t        counts['fields_compared'] = check_origins(views_db, items_db, data, bound)\\n   472\\t    return counts, data, len(raw)\\n   473\\t\\n   474\\t\\n   475\\t# ---------- the report\\n   476\\t\\n   477\\tdef withheld_unresolved(views_db, data):\\n   478\\t    \\\"\\\"\\\"For the release report only: the number questions whose ladder does not resolve to bands, with the reason and whether the\\n   479\\t    view has a key. Withheld like every number question; this list never enters the package.\\\"\\\"\\\"\\n   480\\t    out = []\\n   481\\t    for question in data['questions']:\\n   482\\t        if question['class'] != 'number':\\n   483\\t            continue\\n   484\\t        bands, reason = service.ladder_bands(store.rungs_of(views_db, question['id']))\\n   485\\t        if bands is None:\\n   486\\t            out.append({'id': question['id'], 'reason': reason, 'has_key': key_measure(views_db, question['id'], data['as_of']) is not None})\\n   487\\t    return out\\n\",\"exit_code\":0,\"status\":\"completed\"}}\ndocs/research/2026-11-22-number-answers/codex-r75e.stream:32:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_16\",\"type\":\"command_execution\",\"command\":\"/opt/homebrew/bin/zsh -lc 'nl -ba docs/research/2026-11-22-number-answers/RELEASE-BUILD.md | head -110; cat docs/research/2026-11-22-number-answers/codex-r75{c,d}.md'\",\"aggregated_output\":\"     1\\t# \\\"Forecast unavailable\\\" release: build design for slice 1 (the exporter and the checked package)\\n     2\\t\\n     3\\t**Status: revision 11. Built** (`src/hivemind/release.py`, `scripts/release_build.py`, `tests/test_release.py`; result in\\n     4\\t`RELEASE-CHECK-RESULT.md`). Revision 10 was ready per council 74j; revision 11 records the changes council 75 required of the build.\\n     5\\t\\n     6\\t**Revision 11 (council 75, `codex-r75.md`).** Each change is in the code and has a test and a mutant:\\n     7\\t- **A view key counts only once it is visible at the bound** (its `seq`). A key written later never reclassifies an earlier package\\n     8\\t  (test 22).\\n     9\\t- **Text fields are strings, never null,** as §1 already specified (test 23). The four stores hold no null evidence or item fields.\\n    10\\t- **`check_package` reads each file once,** through one handle on the folder (`O_DIRECTORY | O_NOFOLLOW`, then `O_NOFOLLOW` per file and\\n    11\\t  `fstat`). It hashes and parses the same bytes and returns `(counts, data, bytes)`, so the command reports what was checked.\\n    12\\t- **A store path whose resolved form holds `%`, `?` or `#` is refused** (`release.store_path`), because `store.open_read_only` puts\\n    13\\t  the path into a SQLite `file:` URI unescaped (test 24). The opener itself is shared POC code and is not changed here.\\n    14\\t- **The writer's own refusal** is proved by a scratch-copy pair (test 25).\\n    15\\t- **Both commands print the whole report** before publishing it. Durations use `time.monotonic`. Refusals name the evidence id.\\n    16\\t- **Council 75b** (`codex-r75b.md`):\\n    17\\t  - `store_path` returns the resolved path, which the opener is given, so a link is not resolved twice (test 24);\\n    18\\t  - package files are opened without waiting (`O_NONBLOCK`), so a named pipe is refused by type instead of blocking `check` (test 15);\\n    19\\t  - reordered questions and evidence are tested (test 10).\\n    20\\t- **Councils 75c and 75d, verification only.** The mutant runner judges each catch from the full failure message in pytest's XML\\n    21\\t  report. One structural rule holds for every acceptance assertion: compare against fixed expected values written down before the run,\\n    22\\t  never values taken from the output under test, and match each refusal's exact reason (tests 2, 11, 21; `release_check.py`). Release work was opened by the council under D439 (D758). The behaviour is\\n    23\\tfixed by D726, D756 and `FORECAST-UNAVAILABLE-DESIGN.md` (revision 4). This page holds the AGENTS §2 tables for the first slice.\\n    24\\t\\n    25\\t**Revision 2 answers `codex-r74.md`** (see `claude-r74.md`):\\n    26\\t- the pass condition is an origin check of every field against its stored source, not a string sweep;\\n    27\\t- a missing source item is refused;\\n    28\\t- the package is checked before it is moved into place;\\n    29\\t- the manifest is a closed set;\\n    30\\t- the bound is validated as a date;\\n    31\\t- narrow reads;\\n    32\\t- size and speed budgets;\\n    33\\t- tests that separate every branch;\\n    34\\t- `object`, `kind` and groups dropped;\\n    35\\t- no idea submission.\\n    36\\t\\n    37\\tThe evidence summary stays as extraction stored it (§8, disputed in `claude-r74.md`).\\n    38\\t\\n    39\\t**Revision 3 answers `codex-r74b.md`.**\\n    40\\t- The checker derives everything it compares from the store, never from the package: the date, each question's class, the records and their counts.\\n    41\\t- A missing source item refuses `check` too.\\n    42\\t- The files must be two regular, non-symlink files, with no duplicate JSON member names.\\n    43\\t- The staging folder has one owner.\\n    44\\t- The builder's refusal is tested through the builder.\\n    45\\t- The diagnostics read only the columns a store has.\\n    46\\t\\n    47\\t**Revision 4 answers `codex-r74c.md`.**\\n    48\\t- One date rule for build and `check`.\\n    49\\t- Questions are ordered by `created_seq, rowid`.\\n    50\\t- (Superseded in revision 5.) The build claimed its output folder before staging.\\n    51\\t- Cleanup sits where the staging path is known.\\n    52\\t- A report failure after publication has its own outcome.\\n    53\\t- The builder's refusal is proved through the real command on a scratch copy.\\n    54\\t- Tests 9, 13, 14 and 15 are sharpened.\\n    55\\t\\n    56\\t**Revision 5 answers `codex-r74d.md` with one structural rule** (AGENTS §1: the publication mechanism drew findings in 74b, 74c and\\n    57\\t74d). Staging is private, and the only public step is one atomic move that refuses any existing destination. There is no public\\n    58\\tclaim, so nothing public is created early or cleaned up. Staging is removed in a `finally` covering its whole life, so any error,\\n    59\\tdatabase errors included, leaves nothing at `--out`.\\n    60\\t\\n    61\\t**Revision 6 answers `codex-r74e.md`.**\\n    62\\t- The build's cleanup responsibility ends the moment `publish` succeeds: the staging path is cleared and the `finally` removes nothing\\n    63\\t  after that, so a folder later created at the freed staging name is never touched.\\n    64\\t- The late refusal at `publish`, and the end of cleanup after it, are proved through the real command on scratch copies with a\\n    65\\t  pause.\\n    66\\t\\n    67\\t**Revision 7 answers `codex-r74f.md`.**\\n    68\\t- An explicit day is parsed first and used everywhere in its canonical `YYYY-MM-DD` form. Python reads `20260825` as the same day,\\n    69\\t  but the stores compare days as text.\\n    70\\t- Neither command writes a report over an input database.\\n    71\\t\\n    72\\t**Revision 8 answers `codex-r74g.md` with one rule for every public write** (report writing drew findings in 74f and 74g). Nothing the\\n    73\\tbuild or `check` writes ever replaces an existing path:\\n    74\\t- the package is published by `publish` (`RENAME_EXCL`);\\n    75\\t- the report is published by writing a private temporary file, then `os.link` to the report name, which fails with `EEXIST` when\\n    76\\t  anything exists there.\\n    77\\t\\n    78\\tVerified on this Mac: `os.link` refuses an existing file, a case-variant name of it (`ITEMS.SQLITE` for `items.sqlite`), and a\\n    79\\tsymbolic link, leaving each untouched. An input database always exists, so no report can replace one. The path comparison of\\n    80\\trevision 7 is subsumed and dropped.\\n    81\\t\\n    82\\t**Revision 9 answers `codex-r74h.md`.**\\n    83\\t- A report is published the moment its link succeeds. A later failure to remove the temporary file is reported as published, naming\\n    84\\t  the leftover file.\\n    85\\t- `check`'s exit statuses are explicit, and the end-to-end tests assert them.\\n    86\\t\\n    87\\t**Revision 10 answers `codex-r74i.md`:** `check` follows the build's rule. Any failure to publish the report before the link succeeds\\n    88\\t(the name occupied, or the temporary file not created or written, such as `EACCES`) is exit 2 after the printed pass.\\n    89\\t\\n    90\\t## 0. Scope\\n    91\\t\\n    92\\t- **Slice 1 (this page), $0:**\\n    93\\t  - the exporter `release_export` and its self-check;\\n    94\\t  - the package writer, the package check and the origin check;\\n    95\\t  - the release builder, which calls the exporter directly;\\n    96\\t  - tests and mutants;\\n    97\\t  - the $0 release check on stored stores.\\n    98\\t- **Slice 2, next.** The release page reads only the package: no live service, no `/library` fetch, no translated JSON, no composite\\n    99\\t  trials, no idea submission control or route. It gets a browser check of the `old-1/v8` screen, which completes D756's screen check.\\n   100\\t- **No idea submission in the release** (council 74). The idea path (`idea.py`) reads the ledger at every step and calls a paid model\\n   101\\t  per idea. The design's §5 idea acceptance (an idea card backed only by `v8`, and its composed request) is carried forward as pending\\n   102\\t  for the first idea-enabled slice.\\n   103\\t- **Not in scope:**\\n   104\\t  - the POC, its API, MCP and page (unchanged);\\n   105\\t  - colleagues' page;\\n   106\\t  - frozen pieces, extraction included;\\n   107\\t  - any model call;\\n   108\\t  - commit, publish, deploy.\\n   109\\t\\n   110\\t## 1. What is built\\n**Verdict: slice 1 is not accepted.** I rechecked all four saved packages against their stores and found no off-list field or mismatched value. The production checker also refused both copies containing the substituted `$390 billion` forecast. Three verification gaps remain. [Saved refusals and unchanged control, results.json:44594](/Users/lchingen/hivemind/poc/data/release-check-2026-11-23c/results.json:44594)\\n\\n1. **The mutant runner can still credit a failed test setup as a catch.** It looks for `scratch anchor` only in pytest’s short `FAILED` line. I reproduced an anchor-only failure under test 12’s name. The traceback contained `scratch anchor`, but the short line contained only the test name. The runner counted that line as a catch. This leaves the report’s claim that 28 catches exclude scratch-edit failures unverified. [release_mutants.py:82](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/release_mutants.py:82) · [test_release.py:488](/Users/lchingen/hivemind/tests/test_release.py:488) · [RELEASE-CHECK-RESULT.md:46](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/RELEASE-CHECK-RESULT.md:46)\\n\\n2. **Two tests still pass when the protection they name is removed.** I changed `v6`’s evidence summary to `Bullish` in memory. Test 2 passed because its cross-question label check skips every evidence field. The production checker correctly refused `question v6.evidence e5.one_line`. Test 21 likewise checks only for `passes` and the write error. Removing the line that prints the full report leaves both assertions satisfied. [test_release.py:198](/Users/lchingen/hivemind/tests/test_release.py:198) · [test_release.py:609](/Users/lchingen/hivemind/tests/test_release.py:609) · [release_build.py:31](/Users/lchingen/hivemind/scripts/release_build.py:31)\\n\\n3. **The acceptance script can lose the decisive quote and still pass.** A missing example ID now fails. An ID whose text no longer contains the required example still passes if the package matches the store. In memory, I replaced `e3597`’s analyst `$390 billion` text with `e2295`’s `$361 billion` text on both sides. The script marked `e3597` present and equal, and its final decision returned zero failures. The genuine quote was present in the saved run. [Required control, RELEASE-BUILD.md:456](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/RELEASE-BUILD.md:456) · [release_check.py:163](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/release_check.py:163) · [release_check.py:238](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/release_check.py:238)\\n\\nThe other round-75 and 75b findings are closed for the reviewed snapshots. The fixes cover historical classification, all ten required text fields, resolved store paths, nonblocking pipe refusal, hashing and parsing the same bytes, and ordered comparisons. The revised staging-marker, missing-item, writer-self-check and hash tests distinguish their intended failures. [release.py:87](/Users/lchingen/hivemind/src/hivemind/release.py:87) · [release.py:410](/Users/lchingen/hivemind/src/hivemind/release.py:410) · [release.py:417](/Users/lchingen/hivemind/src/hivemind/release.py:417) · [release.py:458](/Users/lchingen/hivemind/src/hivemind/release.py:458) · [test_release.py:286](/Users/lchingen/hivemind/tests/test_release.py:286) · [test_release.py:328](/Users/lchingen/hivemind/tests/test_release.py:328) · [test_release.py:367](/Users/lchingen/hivemind/tests/test_release.py:367) · [test_release.py:568](/Users/lchingen/hivemind/tests/test_release.py:568) · [test_release.py:639](/Users/lchingen/hivemind/tests/test_release.py:639) · [test_release.py:701](/Users/lchingen/hivemind/tests/test_release.py:701)\\n\\n**The report also quotes the preceding run’s timings.** The new release/library seconds are `8.55/6.69`, `6.76/5.09`, `6.90/5.46`, and `4.48/3.51` in table order. The actual range is **1.26–1.33×**. All four still meet both budgets. The package counts, byte sizes, dated answers, closing result, and 257 label-matching fields holding 32 distinct texts checked out. The subsequent full-suite run passed 425 tests. [Report table:57](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/RELEASE-CHECK-RESULT.md:57) · [old-1:19](/Users/lchingen/hivemind/poc/data/release-check-2026-11-23c/results.json:19) · [old-2:11071](/Users/lchingen/hivemind/poc/data/release-check-2026-11-23c/results.json:11071) · [old-3:17267](/Users/lchingen/hivemind/poc/data/release-check-2026-11-23c/results.json:17267) · [served:30199](/Users/lchingen/hivemind/poc/data/release-check-2026-11-23c/results.json:30199) · [Full-suite output:2](/private/tmp/claude-501/-Users-lchingen-hivemind/f1ea972d-85a1-4f27-8010-cf0b60054109/tasks/buduqedk6.output:2)**Verdict — slice 1 is not accepted.** I rechecked all four saved packages against their stores and found no off-list field or mismatched value. The production checker also refused both copies containing the substituted `$390 billion` forecast for the expected reasons. Three verification gaps remain. [results.json:44597](/Users/lchingen/hivemind/poc/data/release-check-2026-11-23d/results.json:44597)\\n\\n1. **Test 2 still accepts a forecast label in an evidence summary.** I replaced `e6`’s summary with the single word `Bullish` in memory. Test 2 passed. It takes the text it considers genuine from `e6` in the export under test, so changing the summary also changes the expected answer. The production checker correctly refused `question v5.evidence e6.one_line`. The test needs to compare each permitted occurrence with the fixture’s original text at that location. [Fixture, test_release.py:107](/Users/lchingen/hivemind/tests/test_release.py:107) · [Assertion, test_release.py:203](/Users/lchingen/hivemind/tests/test_release.py:203)\\n\\n2. **Test 21 still accepts an incomplete printed report.** I replayed its assertions with a report containing only the date, one comparison count and `export_seconds`. It passed with both store paths, the unresolved list, byte size and check time missing. The command currently prints the full report, and the new mutant proves that removing *all* report output is caught. The test needs to check the complete set of required fields. [Test, test_release.py:610](/Users/lchingen/hivemind/tests/test_release.py:610) · [Report contents, RELEASE-BUILD.md:238](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/RELEASE-BUILD.md:238) · [Command, release_build.py:100](/Users/lchingen/hivemind/scripts/release_build.py:100)\\n\\n3. **The decisive acceptance check can pass after the genuine analyst quote is gone.** In memory, I replaced `e3597`’s quote in both the stored record and its package copies with the system’s own `j1580` forecast. The script marked the quote present, equal to the store and holding its own wording. It returned zero failures because both texts contain `$390 billion`. The refusal checks have a related gap. A stale-hash refusal also satisfied the check that specifically requires the substituted summary to fail comparison with its store. The acceptance case needs wording that distinguishes the analyst quote and the specific reason for each refusal. [Required case, RELEASE-BUILD.md:453](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/RELEASE-BUILD.md:453) · [Wording check, release_check.py:162](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/release_check.py:162) · [Pass decision, release_check.py:240](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/release_check.py:240)\\n\\nThe other findings from rounds 75, 75b and 75c are closed for the reviewed snapshots. Those fixes cover historical classification, all ten required text fields, resolved store paths, nonblocking pipe refusal, hashing and parsing the same bytes, ordered records, and the staging, missing-item and writer self-check tests. The mutant runner now checks the full XML failure text for a failed scratch edit. [release.py:87](/Users/lchingen/hivemind/src/hivemind/release.py:87) · [release.py:458](/Users/lchingen/hivemind/src/hivemind/release.py:458) · [test_release.py:329](/Users/lchingen/hivemind/tests/test_release.py:329) · [test_release.py:642](/Users/lchingen/hivemind/tests/test_release.py:642) · [release_mutants.py:86](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/release_mutants.py:86)\\n\\n**The rewritten report’s measurements hold.** I reproduced all four comparison counts and byte sizes, both forecast refusals, and the 257 label-matching fields containing 32 distinct texts. The saved timings support the reported 1.24–1.26× range. The recorded runs show 36 release tests passed, 30 of 31 mutants caught and 425 full-suite tests passed. The overstatements are that the two test gaps are closed and that every missed acceptance item makes the script fail. [Report claims, RELEASE-CHECK-RESULT.md:49](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/RELEASE-CHECK-RESULT.md:49) · [Acceptance claim, RELEASE-CHECK-RESULT.md:79](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/RELEASE-CHECK-RESULT.md:79) · [Full-suite output:2](/private/tmp/claude-501/-Users-lchingen-hivemind/f1ea972d-85a1-4f27-8010-cf0b60054109/tasks/bwx9cysnh.output:2)\",\"exit_code\":0,\"status\":\"completed\"}}\ndocs/research/2026-11-22-number-answers/codex-r75e.stream:36:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_18\",\"type\":\"command_execution\",\"command\":\"/opt/homebrew/bin/zsh -lc \\\"rg -n 'release|Slice 1|slice 1' docs/CURRENT_STATE.md | head -12; sed -n '240,252p' src/hivemind/views/store.py; rg -n 'pytest' pyproject.toml\\\"\",\"aggregated_output\":\"91:**Measurement correction (2026-11-05):** Alex clarified that a gold-worthy topic already in the supplied library should not open again; an absent worthy topic should open. The earlier simple-A claim of a \\\"missed\\\" new topic was not scored against that rule and is withdrawn as a correctness conclusion. In the actual experiment, a Kyber topic was shown and passing follows Alex's topic-level rule; whether its exact release question captures the shipping milestone remains unverified. The experimental pre-article snapshots differ from the replay's day-start snapshots; 9 of 10 inspected examples differ. The current uncommitted replay default does not build a cold-start library; committed main HEAD still uses the old seed and startup filing path. Historical lexical coverage has a confirmed unrelated-topic match. The frozen gold and past scores remain unchanged. Audit: `../hivemind-no-preseed-evidence-review/docs/research/2026-11-05-parallel-refinement/measurement-context-scrub-2026-11-05.zh.md`.\\n93:**Simple new-question diagnostic (2026-11-05):** At Alex's direction, an isolated prompt returned new questions plus article evidence without asking for product database fields. Four previously seen real dev articles each ran once: three returned one candidate, one returned none, all four quotes matched their source, and the gold-listed GPU backstop amount question was not proposed. Whether that omission is a new-topic miss depends on whether the existing library covers the topic. Two other candidates require source and independent-significance review; the actual experimental snapshot already had a Kyber topic, so its pass follows Alex's topic-level rule; whether its exact release question captures the shipping milestone remains unverified. This is not a production or full-pipeline acceptance. Details: `../hivemind-no-preseed-evidence-review/docs/research/2026-11-05-parallel-refinement/simple-new-question-results.zh.md`.\\n109:Alex decided in D369 to capture core and supporting evidence without a strict boundary and in D370 to remove the 22 preset starting questions and separate earnings-report import. The replay entry now defaults to `poc-v118` (D374), refuses old seeded ledgers and baseline configurations, and continues to read existing non-seeded questions; earnings releases remain normal source items. This change has local contract tests but has not passed end-to-end product acceptance. The frozen historical rulers and results remain unchanged.\\n245:  release, not written ([frame](research/2026-11-14-use-acceptance/NEW-SYSTEM-FRAME.md)).\\n397:  - **Slice 1:** one owner for every upper date bound. A future date is refused, and the served product store's half-processed\\n448:**The one next task: build slice 1 of the \\\"Forecast unavailable\\\" release once its build design passes council 74 (D758).** Under\\n449:D439 and Alex's delegation (D750), council 73 opened release work locally at $0 (D758). Nothing is committed, published or deployed,\\n462:  - the $0 release check on four stores, budgets included.\\n463:- **No idea submission in the release** (council 74). The idea path reads the ledger at every step and calls a paid model; its\\n470:**Earlier next task (done, D758): Alex chooses whether to open release work, and what non-number questions show (D757).** Decided by\\n475:**Earlier next task (done, D757): when release work opens, a $0 check of the reader's screen for number questions (D756).** On a\\n479:- **Alex closed the v13s judge line at its STOP** (D756: end the line, release with \\\"Forecast unavailable\\\"). Nothing from it enters the\\n\\n\\ndef dependencies_of(conn, view_id):\\n    \\\"\\\"\\\"Each dependency with its current target: the resolved view, or the waiting chain and year.\\\"\\\"\\\"\\n    out = []\\n    for dep in conn.execute('select * from dependencies where view_id=? order by dependency_id', (view_id,)):\\n        dep = dict(dep)\\n        resolution = conn.execute('select resolved_to, reason from dependency_resolutions where dependency_id=? order by id desc limit 1', (dep['dependency_id'],)).fetchone()\\n        if resolution:\\n            dep['resolved_to'], dep['resolution'] = resolution['resolved_to'], resolution['reason']\\n        else:\\n            dep['resolved_to'], dep['resolution'] = dep['depends_on'], ('direct' if dep['depends_on'] else 'waiting')\\n        out.append(dep)\\nrg: pyproject.toml: IO error for operation on pyproject.toml: No such file or directory (os error 2)\\n\",\"exit_code\":2,\"status\":\"failed\"}}\ndocs/research/2026-11-22-number-answers/codex-r75e.stream:40:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_20\",\"type\":\"command_execution\",\"command\":\"/opt/homebrew/bin/zsh -lc \\\"nl -ba poc/data/release-check-2026-11-23e/results.json | sed -n '44567,44681p'; nl -ba docs/research/2026-11-22-number-answers/RELEASE-BUILD.md | sed -n '111,153p'; python3 -B --version; rg -n 'def (open_ledger|read_snapshot|open_read_only|open_db)' src/hivemind/{bundle,service,views/store}.py; rg -n 'FORECAST_UNAVAILABLE|Forecast unavailable' tests scripts/release_build.py docs/research/2026-11-22-number-answers/{release_check,release_mutants}.py\\\"\",\"aggregated_output\":\" 44567\\t \\\"decisive\\\": {\\n 44568\\t  \\\"kept\\\": {\\n 44569\\t   \\\"e2295\\\": {\\n 44570\\t    \\\"questions\\\": [\\n 44571\\t     \\\"v8\\\"\\n 44572\\t    ],\\n 44573\\t    \\\"equal_to_store\\\": true,\\n 44574\\t    \\\"present\\\": true,\\n 44575\\t    \\\"holds_its_wording\\\": true\\n 44576\\t   },\\n 44577\\t   \\\"e1865\\\": {\\n 44578\\t    \\\"questions\\\": [\\n 44579\\t     \\\"v4\\\",\\n 44580\\t     \\\"v5\\\",\\n 44581\\t     \\\"v8\\\"\\n 44582\\t    ],\\n 44583\\t    \\\"equal_to_store\\\": true,\\n 44584\\t    \\\"present\\\": true,\\n 44585\\t    \\\"holds_its_wording\\\": true\\n 44586\\t   },\\n 44587\\t   \\\"e3597\\\": {\\n 44588\\t    \\\"questions\\\": [\\n 44589\\t     \\\"v4\\\",\\n 44590\\t     \\\"v5\\\"\\n 44591\\t    ],\\n 44592\\t    \\\"equal_to_store\\\": true,\\n 44593\\t    \\\"present\\\": true,\\n 44594\\t    \\\"holds_its_wording\\\": true\\n 44595\\t   }\\n 44596\\t  },\\n 44597\\t  \\\"implied_outcome_j1580\\\": \\\"About $390 billion: $164 billion reported in the first half, about $100 billion in Q3 using the $108 billion total-reven\\\",\\n 44598\\t  \\\"substituted_into_e2295_refused\\\": \\\"question v8.evidence e2295.one_line: differs from the store\\\",\\n 44599\\t  \\\"added_to_manifest_refused\\\": \\\"the manifest: keys off the allow-list ['note'], missing []\\\",\\n 44600\\t  \\\"unchanged_package_passes\\\": 91055\\n 44601\\t },\\n 44602\\t \\\"old-1/v8\\\": {\\n 44603\\t  \\\"class\\\": \\\"number\\\",\\n 44604\\t  \\\"forecast\\\": \\\"Forecast unavailable\\\",\\n 44605\\t  \\\"evidence\\\": 1284,\\n 44606\\t  \\\"same_ids_as_service_evidence\\\": true\\n 44607\\t },\\n 44608\\t \\\"leaks\\\": {\\n 44609\\t  \\\"old-3/v36@2026-08-25\\\": {\\n 44610\\t   \\\"latest_judgement\\\": 799,\\n 44611\\t   \\\"expected_judgement\\\": 799,\\n 44612\\t   \\\"label_kept\\\": true,\\n 44613\\t   \\\"answer\\\": \\\"Yes\\\",\\n 44614\\t   \\\"why_changed_absent\\\": true,\\n 44615\\t   \\\"reasons_absent\\\": true,\\n 44616\\t   \\\"phrase_fields\\\": {\\n 44617\\t    \\\"around $1 trillion\\\": [],\\n 44618\\t    \\\"rung 4\\\": [],\\n 44619\\t    \\\"at rung\\\": [],\\n 44620\\t    \\\"capex at rung\\\": []\\n 44621\\t   }\\n 44622\\t  },\\n 44623\\t  \\\"old-1/v10@2026-08-28\\\": {\\n 44624\\t   \\\"latest_judgement\\\": 865,\\n 44625\\t   \\\"expected_judgement\\\": 865,\\n 44626\\t   \\\"label_kept\\\": true,\\n 44627\\t   \\\"answer\\\": \\\"Yes\\\",\\n 44628\\t   \\\"why_changed_absent\\\": true,\\n 44629\\t   \\\"reasons_absent\\\": true,\\n 44630\\t   \\\"phrase_fields\\\": {\\n 44631\\t    \\\"around $1 trillion\\\": [],\\n 44632\\t    \\\"rung 4\\\": [],\\n 44633\\t    \\\"at rung\\\": [],\\n 44634\\t    \\\"capex at rung\\\": []\\n 44635\\t   }\\n 44636\\t  }\\n 44637\\t },\\n 44638\\t \\\"control\\\": {\\n 44639\\t  \\\"id\\\": \\\"v3\\\",\\n 44640\\t  \\\"answer\\\": \\\"Yes\\\",\\n 44641\\t  \\\"label_equals_store\\\": true,\\n 44642\\t  \\\"evidence_equals_store\\\": true\\n 44643\\t },\\n 44644\\t \\\"closing\\\": {\\n 44645\\t  \\\"reason\\\": \\\"due 2026-09-20, frozen on 2026-09-20 at rung 2 Bullish\\\",\\n 44646\\t  \\\"bundle_exposes_reason\\\": true,\\n 44647\\t  \\\"package_open\\\": false,\\n 44648\\t  \\\"reason_absent\\\": true,\\n 44649\\t  \\\"rung_label_inside_v8_fields\\\": [\\n 44650\\t   [\\n 44651\\t    \\\"questions[7].evidence[300].sources[0].title\\\",\\n 44652\\t    \\\"e1484\\\",\\n 44653\\t    \\\"Can Nvidia Reclaim $5 Trillion? Jensen Huang’s Bullish AI Call Says Yes\\\"\\n 44654\\t   ],\\n 44655\\t   [\\n 44656\\t    \\\"questions[7].evidence[301].sources[0].title\\\",\\n 44657\\t    \\\"e1485\\\",\\n 44658\\t    \\\"Can Nvidia Reclaim $5 Trillion? Jensen Huang’s Bullish AI Call Says Yes\\\"\\n 44659\\t   ],\\n 44660\\t   [\\n 44661\\t    \\\"questions[7].evidence[393].quote\\\",\\n 44662\\t    \\\"e1865\\\",\\n 44663\\t    \\\"Bullish confirmation would require firm procurement commitments for the SpaceX buildout and continued NVIDIA Data Center\\\"\\n 44664\\t   ],\\n 44665\\t   [\\n 44666\\t    \\\"questions[7].evidence[1167].sources[0].title\\\",\\n 44667\\t    \\\"e4721\\\",\\n 44668\\t    \\\"Oracle Surges on AI Growth as AMD, Nvidia Stay Bullish\\\"\\n 44669\\t   ],\\n 44670\\t   [\\n 44671\\t    \\\"questions[7].evidence[1168].sources[0].title\\\",\\n 44672\\t    \\\"e4722\\\",\\n 44673\\t    \\\"Oracle Surges on AI Growth as AMD, Nvidia Stay Bullish\\\"\\n 44674\\t   ],\\n 44675\\t   [\\n 44676\\t    \\\"questions[7].evidence[1169].sources[0].title\\\",\\n 44677\\t    \\\"e4723\\\",\\n 44678\\t    \\\"Oracle Surges on AI Growth as AMD, Nvidia Stay Bullish\\\"\\n 44679\\t   ]\\n 44680\\t  ]\\n 44681\\t }\\n   111\\t\\n   112\\t`src/hivemind/release.py` is the one owner, beside `service.py`.\\n   113\\t\\n   114\\t- **Constants:**\\n   115\\t  - `FORMAT = 'hivemind-release/1'`;\\n   116\\t  - `ALLOW_LIST = 'release-allow-list/1'`;\\n   117\\t  - `FORECAST_UNAVAILABLE = 'Forecast unavailable'`;\\n   118\\t  - `PACKAGE_FILES = {'manifest.json', 'release-data.json'}`.\\n   119\\t- **`ALLOWED`:** the closed key set per record type.\\n   120\\t\\n   121\\t  | Record | Keys |\\n   122\\t  |---|---|\\n   123\\t  | envelope | `format`, `allow_list`, `as_of`, `questions` |\\n   124\\t  | number question | `id`, `question`, `open`, `class` (= `number`), `forecast` (= the marker), `evidence` |\\n   125\\t  | event or Yes/No question | `id`, `question`, `open`, `class` (`event` or `yes_no`), `answers` (the two stored rung labels, in position order), `answer` (the stored label of the latest judgement's rung on or before the bound, or null), `evidence` |\\n   126\\t  | evidence in force at the bound | `id`, `one_line`, `quote`, `tier`, `speaker`, `original_who`, `original_day`, `sources` |\\n   127\\t  | source recorded on or before the bound | `title`, `publisher`, `day`, `uri` |\\n   128\\t  | manifest | `format`, `allow_list`, `as_of`, `data_sha256` |\\n   129\\t\\n   130\\t- **`question_class(views_db, view_id, labels)`** (design §3):\\n   131\\t  - `event` when the view key's measure is in `identity.EVENT_MEASURES`. The key is read as `select measure from view_keys`, and\\n   132\\t    only when the table exists;\\n   133\\t  - `yes_no` when there are exactly two labels which, through `vocabulary.canonical('label', …)`, are `Yes` and `No` in either order;\\n   134\\t  - `number` otherwise: a view with no key, or one whose bands cannot be resolved.\\n   135\\t- **`release_export(views_db, items_db, as_of=None)`:**\\n   136\\t  - pins both connections (`bundle.read_snapshot`);\\n   137\\t  - takes an explicit day only in canonical form: `date.fromisoformat(day).isoformat()` must equal the text given, otherwise\\n   138\\t    `ReleaseRefused` (so `20260825` is refused, not read as `2026-08-25`). It then resolves the bound with `service.resolve_bound`,\\n   139\\t    refuses a store with no default day, and uses that canonical text in every query;\\n   140\\t  - exports every view that exists at the bound (`service.view_exists`), closed ones included, in `created_seq, rowid` order;\\n   141\\t  - builds each record field by field from the table above, with column-limited SQL:\\n   142\\t    - `select view_id, question, created_seq from views order by created_seq, rowid`;\\n   143\\t    - `select position, label from rungs`;\\n   144\\t    - `select rung from judgements where view_id=? and publication_day<=? order by judgement_id desc limit 1`;\\n   145\\t    - `service.is_open_as_of`, which reads only `open` and `after_seq`;\\n   146\\t  - takes evidence in force from `service.evidence` and its fields from that record;\\n   147\\t  - looks up each source's `title`, `publisher` and `source_uri` in the items database by `input_id`. A visible source whose item is\\n   148\\t    missing raises `ReleaseRefused` (there is no fallback to the id);\\n   149\\t  - calls `check_export` on its own result before returning (AGENTS §3: the writer refuses).\\n   150\\t- **`check_export(data)`:** the closed-set check.\\n   151\\t  - Every dict at every level has exactly its record type's keys.\\n   152\\t  - Value checks:\\n   153\\t    - `format` and `allow_list` equal the constants, and `as_of` is a canonical `YYYY-MM-DD` day (`date.fromisoformat(as_of).isoformat() == as_of`);\\nPython 3.10.10\\nsrc/hivemind/service.py:19:def open_ledger(path):\\nsrc/hivemind/bundle.py:14:def read_snapshot(*connections):\\nsrc/hivemind/views/store.py:57:def open_db(path):\\nsrc/hivemind/views/store.py:223:def open_read_only(path):\\ndocs/research/2026-11-22-number-answers/release_check.py:251:    failures += [] if results['old-1/v8']['same_ids_as_service_evidence'] and results['old-1/v8']['forecast'] == release.FORECAST_UNAVAILABLE else ['old-1/v8']\\ndocs/research/2026-11-22-number-answers/release_mutants.py:13:    'condition emitted on number records': (R, \\\"                record['forecast'] = FORECAST_UNAVAILABLE\\\\n            else:\\\\n                record['answers'] = labels\\\\n                record['answer'] = _answer(\\\",\\ndocs/research/2026-11-22-number-answers/release_mutants.py:14:                                            \\\"                record['forecast'] = FORECAST_UNAVAILABLE\\\\n                record['condition'] = 'FY2027 revenue is at least $350 billion'\\\\n            else:\\\\n                record['answers'] = labels\\\\n                record['answer'] = _answer(\\\"),\\nscripts/release_build.py:1:\\\"\\\"\\\"Build or check the \\\"Forecast unavailable\\\" release package (docs/research/2026-11-22-number-answers/RELEASE-BUILD.md).\\ntests/test_release.py:1:\\\"\\\"\\\"The \\\"Forecast unavailable\\\" release package (docs/research/2026-11-22-number-answers/RELEASE-BUILD.md, revision 10; D726, D758).\\ntests/test_release.py:199:    assert v1['class'] == 'number' and v1['forecast'] == release.FORECAST_UNAVAILABLE\\ntests/test_release.py:319:    v5.update({'class': 'number', 'forecast': release.FORECAST_UNAVAILABLE})\\ntests/test_release.py:637:    assert (early['class'], early.get('forecast')) == ('number', release.FORECAST_UNAVAILABLE)\\ntests/test_release.py:699:WRITER_FAULT = (\\\"                record['forecast'] = FORECAST_UNAVAILABLE\\\\n            else:\\\\n                record['answers'] = labels\\\\n                record['answer'] = _answer(\\\",\\ntests/test_release.py:700:                \\\"                record['forecast'] = FORECAST_UNAVAILABLE\\\\n                record['condition'] = 'FY2027 revenue is at least $350 billion'\\\\n            else:\\\\n\\\"\\n\",\"exit_code\":0,\"status\":\"completed\"}}\ndocs/research/2026-11-22-number-answers/codex-r75e.stream:44:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_22\",\"type\":\"command_execution\",\"command\":\"/opt/homebrew/bin/zsh -lc \\\"ls -lt docs/research/2026-11-22-number-answers | head -45; rg -n -uuu '31 of 32 mutants caught|425 passed' /private/tmp/claude-501/-Users-lchingen-hivemind -g '*.output' | tail -20; ls -t /private/tmp | rg 'release|mutant|suite|pytest' | head -50\\\"\",\"aggregated_output\":\"total 84760\\n-rw-r--r--@  1 lchingen  staff   279261 Nov 23 11:21 codex-r75e.stream\\n-rw-r--r--@  1 lchingen  staff        0 Nov 23 11:21 codex-r75e.md\\n-rw-r--r--@  1 lchingen  staff     1701 Nov 23 11:21 round75e-brief.md\\n-rw-r--r--@  1 lchingen  staff    37327 Nov 23 11:21 RELEASE-BUILD.md\\n-rw-r--r--@  1 lchingen  staff    11423 Nov 23 11:21 RELEASE-CHECK-RESULT.md\\n-rw-r--r--@  1 lchingen  staff    10092 Nov 23 11:17 release_mutants.py\\n-rw-r--r--@  1 lchingen  staff    17272 Nov 23 11:16 release_check.py\\n-rw-r--r--@  1 lchingen  staff     4527 Nov 23 11:16 codex-r75d.md\\n-rw-r--r--@  1 lchingen  staff   319174 Nov 23 11:15 codex-r75d.stream\\n-rw-r--r--@  1 lchingen  staff     1525 Nov 23 11:13 round75d-brief.md\\n-rw-r--r--@  1 lchingen  staff     4809 Nov 23 11:08 codex-r75c.md\\n-rw-r--r--@  1 lchingen  staff   370580 Nov 23 11:08 codex-r75c.stream\\n-rw-r--r--@  1 lchingen  staff     1500 Nov 23 11:05 round75c-brief.md\\n-rw-r--r--@  1 lchingen  staff     6859 Nov 23 10:57 codex-r75b.md\\n-rw-r--r--@  1 lchingen  staff   339083 Nov 23 10:57 codex-r75b.stream\\n-rw-r--r--@  1 lchingen  staff     1500 Nov 23 10:55 round75b-brief.md\\ndrwxr-xr-x@ 16 lchingen  staff      512 Nov 23 10:54 __pycache__\\n-rw-r--r--@  1 lchingen  staff    10059 Nov 23 10:45 codex-r75.md\\n-rw-r--r--@  1 lchingen  staff  1650880 Nov 23 10:45 codex-r75.stream\\n-rw-r--r--@  1 lchingen  staff     2114 Nov 23 10:40 round75-brief.md\\n-rw-r--r--@  1 lchingen  staff     1525 Nov 23 10:30 codex-r74j.md\\n-rw-r--r--@  1 lchingen  staff   151017 Nov 23 10:29 codex-r74j.stream\\n-rw-r--r--@  1 lchingen  staff     1182 Nov 23 10:29 round74j-brief.md\\n-rw-r--r--@  1 lchingen  staff     1951 Nov 23 10:28 codex-r74i.md\\n-rw-r--r--@  1 lchingen  staff   191026 Nov 23 10:28 codex-r74i.stream\\n-rw-r--r--@  1 lchingen  staff     1271 Nov 23 10:27 round74i-brief.md\\n-rw-r--r--@  1 lchingen  staff     2558 Nov 23 10:26 codex-r74h.md\\n-rw-r--r--@  1 lchingen  staff   173399 Nov 23 10:26 codex-r74h.stream\\n-rw-r--r--@  1 lchingen  staff     1267 Nov 23 10:24 round74h-brief.md\\n-rw-r--r--@  1 lchingen  staff     2498 Nov 23 10:23 codex-r74g.md\\n-rw-r--r--@  1 lchingen  staff   195641 Nov 23 10:23 codex-r74g.stream\\n-rw-r--r--@  1 lchingen  staff     1224 Nov 23 10:22 round74g-brief.md\\n-rw-r--r--@  1 lchingen  staff     2961 Nov 23 10:21 codex-r74f.md\\n-rw-r--r--@  1 lchingen  staff   710894 Nov 23 10:21 codex-r74f.stream\\n-rw-r--r--@  1 lchingen  staff     1255 Nov 23 10:20 round74f-brief.md\\n-rw-r--r--@  1 lchingen  staff     2723 Nov 23 10:19 codex-r74e.md\\n-rw-r--r--@  1 lchingen  staff    87619 Nov 23 10:19 codex-r74e.stream\\n-rw-r--r--@  1 lchingen  staff     1495 Nov 23 10:18 round74e-brief.md\\n-rw-r--r--@  1 lchingen  staff     6630 Nov 23 10:17 codex-r74d.md\\n-rw-r--r--@  1 lchingen  staff   135875 Nov 23 10:17 codex-r74d.stream\\n-rw-r--r--@  1 lchingen  staff     1763 Nov 23 10:16 round74d-brief.md\\n-rw-r--r--@  1 lchingen  staff     9785 Nov 23 10:15 codex-r74c.md\\n-rw-r--r--@  1 lchingen  staff   265152 Nov 23 10:15 codex-r74c.stream\\n-rw-r--r--@  1 lchingen  staff     1743 Nov 23 10:13 round74c-brief.md\\n/private/tmp/claude-501/-Users-lchingen-hivemind/f1ea972d-85a1-4f27-8010-cf0b60054109/tasks/bwx9cysnh.output:2:425 passed in 63.67s (0:01:03)\\n/private/tmp/claude-501/-Users-lchingen-hivemind/f1ea972d-85a1-4f27-8010-cf0b60054109/tasks/buduqedk6.output:2:425 passed in 65.76s (0:01:05)\\nls: codex-daemon-501: Operation not permitted\\nls: fts_read: Operation not permitted\\npytest-of-lchingen\\n\",\"exit_code\":0,\"status\":\"completed\"}}\ndocs/research/2026-11-22-number-answers/codex-r75e.stream:68:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_35\",\"type\":\"agent_message\",\"text\":\"**Slice 1 is not accepted.** All four saved packages matched their stores, and I found no new path in the current build that lets a forbidden or mismatched value reach a package. The remaining blockers are in verification. For example, I copied a genuine quote into the wrong question. Test 2 passed. The production checker correctly identified the wrong summary. [test_release.py:207](/Users/lchingen/hivemind/tests/test_release.py:207) · [release.py:317](/Users/lchingen/hivemind/src/hivemind/release.py:317)\\n\\n| Open finding | What I verified |\\n|---|---|\\n| **Test 2 still loses the location of a quote.** | It permits either of two fixed texts anywhere outside `v1`. I copied `v5/e6`’s “Bullish confirmation” quote into `v6/e5`’s summary. The test passed because it compares a set of texts. Round 75d required each occurrence to match its original location. [test_release.py:110](/Users/lchingen/hivemind/tests/test_release.py:110) · [test_release.py:206](/Users/lchingen/hivemind/tests/test_release.py:206) |\\n| **Tests 11 and 21 still accept an incomplete report.** | Test 21’s assertions passed with the evidence, source and field-comparison counts omitted and `data_bytes` set to `1`. The fixture gives **5 evidence records, 6 sources, 101 comparisons and 3,313 bytes**. Both tests check the top-level keys, but neither checks all the required contents of `counts`. [test_release.py:437](/Users/lchingen/hivemind/tests/test_release.py:437) · [test_release.py:614](/Users/lchingen/hivemind/tests/test_release.py:614) · [RELEASE-BUILD.md:241](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/RELEASE-BUILD.md:241) |\\n| **The acceptance script can pass the wrong release.** | In memory, changing the production marker to **“Forecast available”** made the writer, origin checker, Test 2 and final acceptance comparison agree on that wrong wording. They all read the same constant. Separately, I gave the final check an `old-2` result for June 1 with **zero questions**. It reported zero failures. For that store it checks the budgets and never checks the required default date. [RELEASE-BUILD.md:117](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/RELEASE-BUILD.md:117) · [test_release.py:199](/Users/lchingen/hivemind/tests/test_release.py:199) · [release_check.py:244](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/release_check.py:244) · [release_check.py:251](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/release_check.py:251) |\\n| **Exact reasons are enforced for the two saved forecast refusals, but the rule still has gaps.** | Replacing the forecast used in both negative examples with `Ordinary placeholder` produced the same two exact refusals and zero acceptance failures. The script fixes the genuine analyst texts but never checks the identity of the forecast it substitutes. Test 8 also accepts a missing-item error with the evidence ID omitted, the diagnostic defect first reported in round 75. Test 10 accepts any `ValueError` containing `v5` for the class-swap case. [release_check.py:159](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/release_check.py:159) · [release_check.py:248](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/release_check.py:248) · [test_release.py:273](/Users/lchingen/hivemind/tests/test_release.py:273) · [test_release.py:320](/Users/lchingen/hivemind/tests/test_release.py:320) · [test_release.py:341](/Users/lchingen/hivemind/tests/test_release.py:341) |\\n\\n**The other earlier findings are closed for the reviewed snapshots.** That includes historical classification, the ten required text fields, store paths, nonblocking pipe refusal, hashing and parsing the same bytes, ordered comparisons, staging ownership, missing-source handling, and the writer’s self-check. The mutant runner now reads the full failure text for scratch-edit errors. The three genuine examples match their fixed wording, and a stale-hash error can no longer satisfy either forecast-refusal check. [release.py:87](/Users/lchingen/hivemind/src/hivemind/release.py:87) · [release.py:212](/Users/lchingen/hivemind/src/hivemind/release.py:212) · [release.py:406](/Users/lchingen/hivemind/src/hivemind/release.py:406) · [release.py:458](/Users/lchingen/hivemind/src/hivemind/release.py:458) · [release_mutants.py:87](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/release_mutants.py:87) · [results.json:44567](/Users/lchingen/hivemind/poc/data/release-check-2026-11-23e/results.json:44567)\\n\\n**The rewritten report’s measurements hold.** I reproduced all four comparison counts and byte sizes, both exact forecast refusals, and the 257 label-matching fields containing 32 distinct texts. The saved timings support **1.25–1.27×** the library time. The full-suite log records **425 passed**. The unsupported claims are that every acceptance assertion follows the new rule and that every missed acceptance item fails the script. The reported **31 of 32** mutant catches are a separate run, outside `results.json`. [RELEASE-CHECK-RESULT.md:59](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/RELEASE-CHECK-RESULT.md:59) · [RELEASE-CHECK-RESULT.md:93](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/RELEASE-CHECK-RESULT.md:93) · [results.json:44597](/Users/lchingen/hivemind/poc/data/release-check-2026-11-23e/results.json:44597) · [full-suite output:1](/private/tmp/claude-501/-Users-lchingen-hivemind/f1ea972d-85a1-4f27-8010-cf0b60054109/tasks/bimnzicji.output:1)\"}}\ndocs/research/2026-11-22-number-answers/codex-r74f.stream:14:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_6\",\"type\":\"command_execution\",\"command\":\"/opt/homebrew/bin/zsh -lc 'nl -ba docs/research/2026-11-22-number-answers/RELEASE-BUILD.md'\",\"aggregated_output\":\"     1\\t# \\\"Forecast unavailable\\\" release: build design for slice 1 (the exporter and the checked package)\\n     2\\t\\n     3\\t**Status: revision 6, for council round 74f. No code yet.** Release work was opened by the council under D439 (D758). The behaviour is\\n     4\\tfixed by D726, D756 and `FORECAST-UNAVAILABLE-DESIGN.md` (revision 4). This page holds the AGENTS §2 tables for the first slice.\\n     5\\t\\n     6\\t**Revision 2 answers `codex-r74.md`** (see `claude-r74.md`):\\n     7\\t- the pass condition is an origin check of every field against its stored source, not a string sweep;\\n     8\\t- a missing source item is refused;\\n     9\\t- the package is checked before it is moved into place;\\n    10\\t- the manifest is a closed set;\\n    11\\t- the bound is validated as a date;\\n    12\\t- narrow reads;\\n    13\\t- size and speed budgets;\\n    14\\t- tests that separate every branch;\\n    15\\t- `object`, `kind` and groups dropped;\\n    16\\t- no idea submission.\\n    17\\t\\n    18\\tThe evidence summary stays as extraction stored it (§8, disputed in `claude-r74.md`).\\n    19\\t\\n    20\\t**Revision 3 answers `codex-r74b.md`.**\\n    21\\t- The checker derives everything it compares from the store, never from the package: the date, each question's class, the records and their counts.\\n    22\\t- A missing source item refuses `check` too.\\n    23\\t- The files must be two regular, non-symlink files, with no duplicate JSON member names.\\n    24\\t- The staging folder has one owner.\\n    25\\t- The builder's refusal is tested through the builder.\\n    26\\t- The diagnostics read only the columns a store has.\\n    27\\t\\n    28\\t**Revision 4 answers `codex-r74c.md`.**\\n    29\\t- One date rule for build and `check`.\\n    30\\t- Questions are ordered by `created_seq, rowid`.\\n    31\\t- (Superseded in revision 5.) The build claimed its output folder before staging.\\n    32\\t- Cleanup sits where the staging path is known.\\n    33\\t- A report failure after publication has its own outcome.\\n    34\\t- The builder's refusal is proved through the real command on a scratch copy.\\n    35\\t- Tests 9, 13, 14 and 15 are sharpened.\\n    36\\t\\n    37\\t**Revision 5 answers `codex-r74d.md` with one structural rule** (AGENTS §1: the publication mechanism drew findings in 74b, 74c and\\n    38\\t74d). Staging is private, and the only public step is one atomic move that refuses any existing destination. There is no public\\n    39\\tclaim, so nothing public is created early or cleaned up. Staging is removed in a `finally` covering its whole life, so any error,\\n    40\\tdatabase errors included, leaves nothing at `--out`.\\n    41\\t\\n    42\\t**Revision 6 answers `codex-r74e.md`.**\\n    43\\t- The build's cleanup responsibility ends the moment `publish` succeeds: the staging path is cleared and the `finally` removes nothing\\n    44\\t  after that, so a folder later created at the freed staging name is never touched.\\n    45\\t- The late refusal at `publish`, and the end of cleanup after it, are proved through the real command on scratch copies with a\\n    46\\t  pause.\\n    47\\t\\n    48\\t## 0. Scope\\n    49\\t\\n    50\\t- **Slice 1 (this page), $0:**\\n    51\\t  - the exporter `release_export` and its self-check;\\n    52\\t  - the package writer, the package check and the origin check;\\n    53\\t  - the release builder, which calls the exporter directly;\\n    54\\t  - tests and mutants;\\n    55\\t  - the $0 release check on stored stores.\\n    56\\t- **Slice 2, next.** The release page reads only the package: no live service, no `/library` fetch, no translated JSON, no composite\\n    57\\t  trials, no idea submission control or route. It gets a browser check of the `old-1/v8` screen, which completes D756's screen check.\\n    58\\t- **No idea submission in the release** (council 74). The idea path (`idea.py`) reads the ledger at every step and calls a paid model\\n    59\\t  per idea. The design's §5 idea acceptance (an idea card backed only by `v8`, and its composed request) is carried forward as pending\\n    60\\t  for the first idea-enabled slice.\\n    61\\t- **Not in scope:**\\n    62\\t  - the POC, its API, MCP and page (unchanged);\\n    63\\t  - colleagues' page;\\n    64\\t  - frozen pieces, extraction included;\\n    65\\t  - any model call;\\n    66\\t  - commit, publish, deploy.\\n    67\\t\\n    68\\t## 1. What is built\\n    69\\t\\n    70\\t`src/hivemind/release.py` is the one owner, beside `service.py`.\\n    71\\t\\n    72\\t- **Constants:**\\n    73\\t  - `FORMAT = 'hivemind-release/1'`;\\n    74\\t  - `ALLOW_LIST = 'release-allow-list/1'`;\\n    75\\t  - `FORECAST_UNAVAILABLE = 'Forecast unavailable'`;\\n    76\\t  - `PACKAGE_FILES = {'manifest.json', 'release-data.json'}`.\\n    77\\t- **`ALLOWED`:** the closed key set per record type.\\n    78\\t\\n    79\\t  | Record | Keys |\\n    80\\t  |---|---|\\n    81\\t  | envelope | `format`, `allow_list`, `as_of`, `questions` |\\n    82\\t  | number question | `id`, `question`, `open`, `class` (= `number`), `forecast` (= the marker), `evidence` |\\n    83\\t  | event or Yes/No question | `id`, `question`, `open`, `class` (`event` or `yes_no`), `answers` (the two stored rung labels, in position order), `answer` (the stored label of the latest judgement's rung on or before the bound, or null), `evidence` |\\n    84\\t  | evidence in force at the bound | `id`, `one_line`, `quote`, `tier`, `speaker`, `original_who`, `original_day`, `sources` |\\n    85\\t  | source recorded on or before the bound | `title`, `publisher`, `day`, `uri` |\\n    86\\t  | manifest | `format`, `allow_list`, `as_of`, `data_sha256` |\\n    87\\t\\n    88\\t- **`question_class(views_db, view_id, labels)`** (design §3):\\n    89\\t  - `event` when the view key's measure is in `identity.EVENT_MEASURES`. The key is read as `select measure from view_keys`, and\\n    90\\t    only when the table exists;\\n    91\\t  - `yes_no` when there are exactly two labels which, through `vocabulary.canonical('label', …)`, are `Yes` and `No` in either order;\\n    92\\t  - `number` otherwise: a view with no key, or one whose bands cannot be resolved.\\n    93\\t- **`release_export(views_db, items_db, as_of=None)`:**\\n    94\\t  - pins both connections (`bundle.read_snapshot`);\\n    95\\t  - resolves the bound with `service.resolve_bound`, refuses a store with no default day, and validates the bound with\\n    96\\t    `date.fromisoformat`;\\n    97\\t  - exports every view that exists at the bound (`service.view_exists`), closed ones included, in `created_seq, rowid` order;\\n    98\\t  - builds each record field by field from the table above, with column-limited SQL:\\n    99\\t    - `select view_id, question, created_seq from views order by created_seq, rowid`;\\n   100\\t    - `select position, label from rungs`;\\n   101\\t    - `select rung from judgements where view_id=? and publication_day<=? order by judgement_id desc limit 1`;\\n   102\\t    - `service.is_open_as_of`, which reads only `open` and `after_seq`;\\n   103\\t  - takes evidence in force from `service.evidence` and its fields from that record;\\n   104\\t  - looks up each source's `title`, `publisher` and `source_uri` in the items database by `input_id`. A visible source whose item is\\n   105\\t    missing raises `ReleaseRefused` (there is no fallback to the id);\\n   106\\t  - calls `check_export` on its own result before returning (AGENTS §3: the writer refuses).\\n   107\\t- **`check_export(data)`:** the closed-set check.\\n   108\\t  - Every dict at every level has exactly its record type's keys.\\n   109\\t  - Value checks:\\n   110\\t    - `format` and `allow_list` equal the constants, and `as_of` is an ISO date;\\n   111\\t    - `class` is in its set;\\n   112\\t    - a number record's `forecast` is the marker;\\n   113\\t    - `answers` is two strings, and `answer` is one of them or null;\\n   114\\t    - `open` is a bool and every text field is a string.\\n   115\\t  - It returns the counts it judged: questions per class, evidence, sources.\\n   116\\t- **`check_origins(views_db, items_db, data, expected_as_of)`:** the pass condition. It is independent of the exporter's code path.\\n   117\\t  It derives everything it compares from the store, never from the package.\\n   118\\t  - **The bound: one rule for both commands.** `expected_as_of` is given by the caller.\\n   119\\t    - The builder passes the bound it resolved: `service.resolve_bound` on the requested day, or the default when none is given; an\\n   120\\t      omitted day with no default is refused.\\n   121\\t    - `check` passes the package's `as_of` through the same `service.resolve_bound`, which refuses a day after a store's last\\n   122\\t      completed day. A legacy ledger with no completed days accepts any valid date in both commands alike.\\n   123\\t    - The package's `as_of` must equal `expected_as_of`.\\n   124\\t  - **The class** of each question is derived from the stored measure and labels (`question_class`). The permitted keys and values\\n   125\\t    are then chosen from that class, never from the package's `class` field.\\n   126\\t  - **Order and counts.** The questions are compared as an ordered list in `created_seq, rowid` order, as `bundle.library` orders\\n   127\\t    them (`old-2/v2` and `v3` share sequence 8). Each question's evidence is compared in link order (`evidence_links.id`), and its\\n   128\\t    sources in row order (`evidence_sources.id`). A duplicate question, evidence record or source therefore fails.\\n   129\\t\\n   130\\t  It compares every field with its permitted stored source at the bound, by direct SQL:\\n   131\\t  - the question set equals the views visible at the bound, with `question` equal to `views.question`;\\n   132\\t  - `open` equals the latest visible switch's `open`;\\n   133\\t  - for `event` and `yes_no`: `answers` equal the rung labels in position order, and `answer` equals the label of the latest judgement\\n   134\\t    rung on or before the bound, or null;\\n   135\\t  - for `number`: only the marker;\\n   136\\t  - the evidence id set equals the links visible at the bound, minus those whose latest replacement is visible, computed in its own\\n   137\\t    SQL. Each evidence field equals the `evidence` row's column;\\n   138\\t  - each source list starts from every visible `evidence_sources` row, in row order, with `day` taken from\\n   139\\t    `evidence_sources.publication_day`. Each row needs a matching `items` row for `title`, `publisher` and `source_uri`; a row with no\\n   140\\t    item raises `ReleaseRefused` (a left join, so a missing item is never silently dropped).\\n   141\\t\\n   142\\t  Any difference raises `ReleaseRefused`, naming the question, the field and the evidence id. It returns the number of fields\\n   143\\t  compared.\\n   144\\t- **`stage(out_dir)`:** creates a private staging folder with a name unique to this invocation, `tempfile.mkdtemp(dir=out_dir.parent,\\n   145\\t  prefix='.<name>.staging-')`. Creation is exclusive, so only this invocation owns it. It returns the path.\\n   146\\t- **`write_package(data, staged)`:** writes `release-data.json` and `manifest.json` into the staging folder. It creates nothing\\n   147\\t  else.\\n   148\\t- **`publish(staged, out_dir)`:** one atomic move that refuses any existing destination, empty or not:\\n   149\\t  - on macOS, `renamex_np(staged, out_dir, RENAME_EXCL)` through `ctypes`. Verified on this Mac: onto a free path it succeeds; onto\\n   150\\t    an existing empty or non-empty folder it fails with `EEXIST`, and both folders stay as they were;\\n   151\\t  - on Linux, `renameat2(AT_FDCWD, staged, AT_FDCWD, out_dir, RENAME_NOREPLACE)`;\\n   152\\t  - where neither call exists, or the filesystem lacks support (`ENOTSUP`, `EINVAL`), it raises `ReleaseRefused`.\\n   153\\t\\n   154\\t  It never replaces, creates or removes anything at `out_dir` except by that one move.\\n   155\\t- **`check_package(path, views_db=None, items_db=None, expected_as_of=None)`:**\\n   156\\t  - the directory holds exactly `PACKAGE_FILES`, each a regular file and not a symbolic link (`os.lstat`), with no subdirectories;\\n   157\\t  - both files parse as JSON with no duplicate member name at any level (an `object_pairs_hook` that refuses a repeated key);\\n   158\\t  - the manifest has exactly its four keys, and its `format`, `allow_list` and `as_of` equal the data's;\\n   159\\t  - its sha256 equals the data file's;\\n   160\\t  - the data passes `check_export`, and, when the stores are given, `check_origins` with the expected bound;\\n   161\\t  - it returns the counts.\\n   162\\t- **`withheld_unresolved(views_db, data)`** is for the report only. It lists the number questions whose `service.ladder_bands(rungs)`\\n   163\\t  returns `(None, reason)`, with the reason and whether the view has a key. Its output never enters the package.\\n   164\\t\\n   165\\t`scripts/release_build.py`:\\n   166\\t- **`build --ledger --items [--as-of] --out`:**\\n   167\\t  1. refuse an existing `--out` early, as a convenience; `publish` holds the guarantee;\\n   168\\t  2. resolve the bound once (`service.resolve_bound`, `date.fromisoformat`);\\n   169\\t  3. `stage(--out)`. From here a `finally` removes this staging folder while the build still owns it;\\n   170\\t  4. `release_export` at that bound;\\n   171\\t  5. `write_package` into the staging folder;\\n   172\\t  6. `check_package` on the staged folder, with the stores and the resolved bound;\\n   173\\t  7. `publish` to `--out`. The moment it succeeds, the build drops its staging path (`staged = None`); the `finally` then removes\\n   174\\t     nothing;\\n   175\\t  8. write `<out>.report.json` beside the package, through a temporary file and `os.replace`.\\n   176\\t\\n   177\\t  The failure outcomes:\\n   178\\t  - **Before publication** (steps 2–7): any exception, whether `ReleaseRefused`, `OSError`, `sqlite3.Error` or another, prints the\\n   179\\t    reason and exits 1. The `finally` removes this build's staging folder; nothing exists at `--out` from this build. A corrected\\n   180\\t    retry at the same `--out` succeeds.\\n   181\\t  - **After publication** (step 8 fails): the package is final and checked. Exit 2 with \\\"package published and checked; report not\\n   182\\t    written; run `check` to regenerate it\\\".\\n   183\\t\\n   184\\t  It has no input path for prepared or translated JSON, and it takes no clock reading; the folder name is the caller's (D12, D13).\\n   185\\t- **`check <out> --ledger --items`:** re-runs `check_package` on an existing package, with the stores, the package's `as_of`\\n   186\\t  validated against the store (above), and the regular-file and duplicate-key checks. It leaves the package in place and rewrites\\n   187\\t  `<out>.report.json`. This is also the retry after a report write failed. Its report gives `check_seconds` and marks\\n   188\\t  `export_seconds` as not measured.\\n   189\\t- **The report:**\\n   190\\t  - the store path and the bound;\\n   191\\t  - counts per class;\\n   192\\t  - the unresolved list;\\n   193\\t  - the fields compared;\\n   194\\t  - bytes;\\n   195\\t  - `export_seconds` (build only) and `check_seconds`.\\n   196\\t\\n   197\\t## 2. State × event (one export, read-only)\\n   198\\t\\n   199\\t| State / event | What happens | What is written | Day used |\\n   200\\t|---|---|---|---|\\n   201\\t| Store's first day still in progress | `FirstDayNotCompleted`; the build stops | nothing | none |\\n   202\\t| Store with no completed day and no judgement, `--as-of` omitted | refused: \\\"no default day; supply --as-of\\\" | nothing | none |\\n   203\\t| `--as-of` not a valid date (`2026-08-99`) | refused by `date.fromisoformat` | nothing | none |\\n   204\\t| `--as-of` after the last completed day | `BoundNotCompleted`; the build stops | nothing | requested day |\\n   205\\t| `--as-of` valid, before the first visible question | empty `questions`; the report says 0 | package | bound |\\n   206\\t| `--as-of` omitted | last completed day (a legacy ledger: its last judgement day) | package | resolved bound |\\n   207\\t| View created after the bound | not exported | — | bound |\\n   208\\t| View closed on or before the bound | `open: false`, with no reason and no day | — | bound |\\n   209\\t| Closed, then reopened, before the bound | the last visible switch wins | — | bound |\\n   210\\t| Event or Yes/No not yet judged at the bound | `answer: null` | — | bound |\\n   211\\t| Evidence replaced on or before the bound | excluded; the replacement is in force | — | bound |\\n   212\\t| Evidence replaced after the bound | kept | — | bound |\\n   213\\t| Source recorded after the bound | excluded | — | bound |\\n   214\\t| Visible source with no row in the items database | `ReleaseRefused`, naming the evidence and input id | nothing final | bound |\\n   215\\t| Store written by a live run | not supported. The builder is given a snapshot (AGENTS §9), and both connections are pinned | — | — |\\n   216\\t| `--out` exists, empty or not, at the start | refused early; `publish` would also refuse | nothing | — |\\n   217\\t| `check_export`, `check_package` or `check_origins` refuses | this build's staging folder is removed, exit non-zero | nothing final | — |\\n   218\\t| A write, check or move fails, or a database error (`sqlite3.Error`, such as an items database with no `items` table) | exit 1; the `finally` removes this build's staging; a corrected retry at the same `--out` succeeds | nothing | — |\\n   219\\t| A folder, empty or not, appears at `--out` after staging | `publish` refuses with `EEXIST`; that folder is untouched; staging removed; exit 1 | nothing of this build | — |\\n   220\\t| The filesystem has no atomic no-replace move | `publish` refuses; staging removed; exit 1 | nothing | — |\\n   221\\t| Crash while staging | a uniquely named staging folder is left as debris. Nothing is at `--out`, and no later build is blocked | staging only | — |\\n   222\\t| Crash after the rename, before the report | the package is final and checked; `check` rewrites the report | package | — |\\n   223\\t| The report write fails after publication | exit 2: the package is final and checked; `check` regenerates the report | package | — |\\n   224\\t| Two builds aimed at one `--out` | each stages privately; the first `publish` wins; the second's `publish` refuses with `EEXIST`, and its `finally` removes only its own staging | the winner's package | — |\\n   225\\t| Package `as_of` later than the store's last completed day (`check`) | refused by `resolve_bound` | nothing | package `as_of` |\\n   226\\t| A legacy ledger with no completed days, explicit day | the build and `check` both accept any valid date (one rule) | package | requested day |\\n   227\\t| A package file is a symbolic link, or a JSON member name repeats | `check_package` refuses | nothing | — |\\n   228\\t| The package's `class` disagrees with the store's (a Yes/No answer replaced by the marker) | `check_origins` refuses: class is derived from the store | nothing final | bound |\\n   229\\t| Store or configuration changed between builds | each package records its bound and data sha256; the report names the store path | — | — |\\n   230\\t| Legacy ledger: no `view_keys` table, `是`/`否` labels | no key, so no event; the labels canonicalise to Yes/No | — | — |\\n   231\\t\\n   232\\t## 3. Value × reader\\n   233\\t\\n   234\\tReaders of the package:\\n   235\\t- `check_package` and `check_origins`;\\n   236\\t- the release page (slice 2);\\n   237\\t- the tests.\\n   238\\t\\n   239\\tThe report's reader is the person building. No POC code imports `release`.\\n   240\\t\\n   241\\t| Value | Permitted source at the bound | Checked by |\\n   242\\t|---|---|---|\\n   243\\t| `id`, `question` | `views.view_id`, `views.question` | `check_origins` |\\n   244\\t| `open` | the latest visible `view_switches.open` | `check_origins` |\\n   245\\t| `class` | `view_keys.measure`, `rungs.label` | `check_origins` derives it from the store; tests and mutants check the identity rule |\\n   246\\t| `answers`, `answer` | `rungs.label` by position; the latest `judgements.rung` on or before the bound | `check_origins` |\\n   247\\t| `forecast` | the constant marker | `check_export` |\\n   248\\t| evidence fields | the `evidence` row; visible `evidence_links` minus visible replacements | `check_origins` |\\n   249\\t| source fields | every visible `evidence_sources` row (`publication_day` as `day`); its `items` row's `title`, `publisher`, `source_uri`, required | `check_origins` (left join; a missing item refuses) |\\n   250\\t| manifest | the data's `format`, `allow_list`, `as_of`; the data sha256 | `check_package` |\\n   251\\t| report (outside the package) | `ladder_bands` per number question; counts | read by the builder's user |\\n   252\\t\\n   253\\t**Never read by `release_export`:**\\n   254\\t- `rungs.condition`, `lo`, `hi`;\\n   255\\t- `judgements.reasons`, `why_changed`, `implied_outcome`, `reference`, `pushes_json`, `theme_pushes_json`, `cited_*`;\\n   256\\t- `view_switches.reason`;\\n   257\\t- `clean_ladders`;\\n   258\\t- `thesis_groups`;\\n   259\\t- `dependencies`, `successions`.\\n   260\\t\\n   261\\t## 4. New path × old checks\\n   262\\t\\n   263\\t| Check on the old path (`bundle.library`, `view_bundle`, `service`) | New path |\\n   264\\t|---|---|\\n   265\\t| `resolve_bound`: unfinished first day, future bound | same call |\\n   266\\t| `bundle.library`: no default day refused; `date.fromisoformat` | same two checks |\\n   267\\t| A view not visible at the bound is not served | same `view_exists` |\\n   268\\t| Sources visible at the bound; replacements applied | same `service.evidence`, verified independently by `check_origins` |\\n   269\\t| Pinned read transaction | same `bundle.read_snapshot` |\\n   270\\t| `item_lookup` falls back to the id for a missing item | refused instead |\\n   271\\t| A malformed `clean_ladders` row is refused | not read |\\n   272\\t| Corrupt judgement JSON is refused | no JSON column read |\\n   273\\t| The UI contract rejects unknown fields | the release's own `check_export`; the page's reading of it is slice 2 |\\n   274\\t\\n   275\\t## 5. Prior decisions\\n   276\\t\\n   277\\t- D726: number questions show sources and \\\"Forecast unavailable\\\", with band, forecast text and history withheld together.\\n   278\\t- D756: Alex's choice.\\n   279\\t- D757: the design, revision 4.\\n   280\\t- D758: the release is opened; §4 (a); order.\\n   281\\t- D12/D13: no clock.\\n   282\\t- D163: English product text.\\n   283\\t- D690: poc-v118 stays the product.\\n   284\\t- D261: the ruler is untouched.\\n   285\\t- D274: the extraction prompt is frozen.\\n   286\\t\\n   287\\t## 6. Tests (`tests/test_release.py`) and mutants\\n   288\\t\\n   289\\tThe fixtures use a real store on a temporary path (`store.create_view`, `store.insert`), with a real items database. Each test names\\n   290\\tits row above:\\n   291\\t1. **Closed set (§1).**\\n   292\\t   - Every dict in a fixture export has exactly its type's keys.\\n   293\\t   - Positive control: an export with one added key fails `check_export`.\\n   294\\t2. **Number with `lo`/`hi`.** The record carries the marker. No rung label, condition, `reasons`, `why_changed` or `implied_outcome` of\\n   295\\t   that view appears in any decoded package field.\\n   296\\t3. **Branch fixtures for identity and the report:**\\n   297\\t   - a condition-only number that resolves: `number`, and absent from `withheld_unresolved`;\\n   298\\t   - an unresolved number with a key: `number`, and present;\\n   299\\t   - an unresolved number without a key: `number`, and present.\\n   300\\t4. **Yes/No with numeric bounds** (`growth_rate` key, labels Yes/No): `yes_no`, with its answer label. A `why_changed` quoting\\n   301\\t   \\\"$1 trillion\\\" is absent.\\n   302\\t5. **Event with the served ledger's `v49` labels,** \\\"Restriction adopted\\\" / \\\"No restriction adopted\\\": `event`, with its label kept. A\\n   303\\t   `why_changed` quoting another question's band is absent.\\n   304\\t6. **Legacy store** with no `view_keys` table and `是`/`否` labels: `yes_no`.\\n   305\\t7. **Closing switch** whose reason names the band label: `open: false`, and the reason is absent.\\n   306\\t8. **Replacement and source visibility** at two bounds. A visible source with a missing item is refused.\\n   307\\t9. **Package:**\\n   308\\t   - staged, then checked, passes;\\n   309\\t   - a foreign file fails, and so does a subdirectory;\\n   310\\t   - a changed data byte fails;\\n   311\\t   - an extra manifest key with an unchanged data hash fails;\\n   312\\t   - a manifest `as_of` differing from the data's fails;\\n   313\\t   - an existing `--out`, empty or not, is refused, and a leftover staging folder from another build does not block a build.\\n   314\\t10. **Origin check, each from the store:**\\n   315\\t    - in a staged copy, the system's forecast text placed in an evidence `one_line` fails, naming the field;\\n   316\\t    - a Yes/No record turned into a number record, keeping the closed set, fails;\\n   317\\t    - a duplicated question, and a duplicated evidence record, each fails;\\n   318\\t    - a package whose `as_of` is a day later than the store's last completed day fails `check`;\\n   319\\t    - a legacy fixture with no completed days, built at an explicit day later than its last judgement, passes a later `check`.\\n   320\\t11. **Builder end to end,** run as the user calls it (subprocess, `--as-of` omitted). The package is final and passes `check`.\\n   321\\t12. **Builder refusal, through the real command, on a scratch copy** (the AGENTS §4 mutation procedure; no fake in the suite):\\n   322\\t    - the unchanged command succeeds on the fixture store (test 11);\\n   323\\t    - on a scratch copy, the writer fault \\\"one evidence `one_line` taken from the latest judgement's `why_changed`\\\" is introduced.\\n   324\\t      The same command exits 1 with the origin-mismatch reason, no `--out` and no staging folder left;\\n   325\\t    - on a second scratch copy, the same writer fault plus the builder's staged check removed: the bad package reaches `--out`. That\\n   326\\t      shows the staged check is what prevents publication.\\n   327\\t13. **`check` with a missing item.** A finished package. Then a copy of the items database with one referenced item deleted, and a\\n   328\\t    copy of the package with that same source removed and its manifest hash refreshed. `check` refuses, naming the missing item. (An\\n   329\\t    inner-join mutant accepts this pair, so this case catches it.)\\n   330\\t14. **The publication rule.**\\n   331\\t    - Module steps: builds A and B both stage, then A publishes. B's `publish` refuses with `EEXIST`. A's package passes `check`, and\\n   332\\t      B's staging is still there for its owner to remove.\\n   333\\t    - Module steps: after staging, a foreign *empty* folder is put at `--out`. `publish` refuses, and the foreign folder still exists\\n   334\\t      afterwards, empty.\\n   335\\t    - The command, early: an existing empty `--out` gives exit 1, and the folder survives.\\n   336\\t    - The command, late (a scratch copy with a pause before `publish`, released by the test): the test creates an empty folder at\\n   337\\t      `--out` during the pause. The command exits 1, its staging folder is removed, and the same empty folder survives (same device\\n   338\\t      and inode).\\n   339\\t    - The command, after the move (a scratch copy with a pause just after `publish`): the test recreates the freed staging name as a\\n   340\\t      folder holding a marker file. After the command exits 0, the marker is still there.\\n   341\\t17. **A database error through the command.** A valid ledger with an items database that has no `items` table: exit 1, the database\\n   342\\t    error printed, nothing at `--out`, no staging folder left. A retry at the same `--out` with the correct items database succeeds.\\n   343\\t15. **Files:**\\n   344\\t    - a symbolic link in place of `release-data.json` fails;\\n   345\\t    - a data file whose repeated `one_line` member has the genuine value last, with the manifest hash refreshed so every other\\n   346\\t      check passes, fails on the repeated name.\\n   347\\t16. **Bound validation:** `2026-08-99` refused; a valid day before the first question gives an empty package.\\n   348\\t\\n   349\\t**Mutants,** on a scratch copy with `PYTHONDONTWRITEBYTECODE=1`; each must fail a test:\\n   350\\t- `condition` emitted on number records;\\n   351\\t- `one_line` taken from the latest judgement's `why_changed`;\\n   352\\t- the event test removed;\\n   353\\t- the Yes/No test removed;\\n   354\\t- `check_package` without the file-set check;\\n   355\\t- manifest keys unchecked;\\n   356\\t- `check_export` without the closed-key check;\\n   357\\t- `check_origins` skipping evidence fields;\\n   358\\t- `check_origins` taking the class from the package;\\n   359\\t- `check_origins` comparing sets instead of ordered lists;\\n   360\\t- `check_origins` with an inner join to `items`;\\n   361\\t- `check` without validating the package's `as_of` against the store;\\n   362\\t- the builder skipping the staged `check_package` (the scratch-copy pair in test 12);\\n   363\\t- `publish` replaced by `os.rename` (test 14's foreign empty folder is then replaced);\\n   364\\t- the `finally` removed (test 17 then leaves staging);\\n   365\\t- the staging path not dropped after `publish` (test 14's marker is then removed);\\n   366\\t- the symbolic-link check removed;\\n   367\\t- the duplicate-key check removed;\\n   368\\t- the switch reason emitted;\\n   369\\t- the missing-item refusal replaced by the id fallback.\\n   370\\t\\n   371\\t## 7. The $0 release check (stored stores, read-only)\\n   372\\t\\n   373\\tStores: `old-1`, `old-2`, `old-3` (`comparison-2026-11-17/run/old-N/prod/views.sqlite`, items `items-comparison.sqlite`) and the\\n   374\\tserved ledger with its items database.\\n   375\\t\\n   376\\t**Budgets,** set before the first control (AGENTS §2):\\n   377\\t- the package's data bytes at most `bundle.library`'s JSON bytes on the same store and bound;\\n   378\\t- export plus all checks at most three times `bundle.library`'s seconds on the same store, and at most 120 s per store.\\n   379\\t\\n   380\\tThe steps:\\n   381\\t1. **Build each store's package at its default bound.** The build passes `check_package` with `check_origins`. Report the fields\\n   382\\t   compared, the counts per class and the unresolved list.\\n   383\\t2. **The decisive acceptance case** (council 74), on the `old-1` package:\\n   384\\t   - Morningstar's `$361 billion` estimate (`e2295`) is kept, its summary and quote equal to the stored ones;\\n   385\\t   - the genuine \\\"Bullish confirmation\\\" quote (`e1865`) is kept;\\n   386\\t   - the genuine analyst \\\"$390 billion\\\" quote (`e3597`) is kept, as the control;\\n   387\\t   - in a copy of the staged package, the system's `old-1` j1580 `implied_outcome` (\\\"About $390 billion…\\\") substituted into\\n   388\\t     `e2295`'s summary fails `check_origins`;\\n   389\\t   - the same text added to the manifest fails `check_package`.\\n   390\\t3. **`old-1/v8`:** `class` is `number`, with the marker and the same evidence ids as `service.evidence` at the bound.\\n   391\\t4. **The known event leaks at their own dates.** Export `old-3` at 2026-08-25 (`v36` j799 is the latest judgement) and `old-1` at\\n   392\\t   2026-08-28 (`v10` j865). Each keeps its original answer label, and j799's \\\"around $1 trillion\\\" text and j865's band text are absent.\\n   393\\t5. **Control:** one unchanged event question keeps its label and evidence.\\n   394\\t6. **Closing.** On a temporary copy of `old-1`, add a closing switch for `v8` in the store's own format (\\\"due …, frozen on … at\\n   395\\t   rung N <label>\\\"). First confirm that `bundle.view_bundle` exposes the reason with the band label. Then confirm the package shows\\n   396\\t   `open: false` and not the reason.\\n   397\\t7. **Diagnostics** (not the gate). For every question, take each string the package must not hold:\\n   398\\t   - rung labels and conditions;\\n   399\\t   - judgement `reasons` and `why_changed`, and `implied_outcome` and `reference` where the store has those columns (the served\\n   400\\t     ledger has neither; the report says so);\\n   401\\t   - switch reasons.\\n   402\\t\\n   403\\t   Search every decoded string field of the package for each, with no floor. List every hit with its question, field, evidence id\\n   404\\t   and the stored string it matched, and read each by hand. A genuine source quote, such as `e1865`'s \\\"Bullish\\\", is recorded as such.\\n   405\\t8. **Budgets:** bytes and seconds against the budgets above.\\n   406\\t\\n   407\\t## 8. A disclosed property, not built: evidence summaries keep extraction's wording\\n   408\\t\\n   409\\tThe release shows each evidence summary as extraction stored it; the release computes or converts nothing. A summary can make\\n   410\\tcontext explicit or restate a source figure by arithmetic, attributed to its source: `old-1/e3238` gives \\\"more than $40 billion in\\n   411\\tFY2028\\\" for a quote's \\\"more than double that next year\\\".\\n   412\\t- **Measured:** 25.6%, 25.2% and 25.4% of evidence in force in `old-1`, `old-2` and `old-3`, and 35.0% in the served ledger, carry a\\n   413\\t  number not in their quote. In a sample of 24, 23 are context: a year, a date, a quarter, a product name, an amount from the previous\\n   414\\t  sentence. One restates \\\"close to doubling\\\" as \\\"nearly 100%\\\".\\n   415\\t- **Why this is not the forecast D726 withholds.** Extraction never sees the system's forecast. Its request lists each open question\\n   416\\t  only as id, object, due day, question and a \\\"takes\\\" line (`placement.py:19-61`, `extraction.py:398-400`); no rung, label or\\n   417\\t  judged position.\\n   418\\t- **Council 74b** (`codex-r74b.md` §2) verified that extraction sends no rung, label or judged position, and that the census\\n   419\\t  reproduces.\\n   420\\t- **The disagreement that remains is narrow.**\\n   421\\t  - Codex reads revision 4's \\\"amounts as quoted\\\" as requiring source wording for a calculated amount attributed to a source, such\\n   422\\t    as `e3238`'s \\\"more than $40 billion\\\".\\n   423\\t  - Claude reads it as \\\"the release computes or converts nothing\\\".\\n   424\\t  - Both agree: no digit filter, no change to extraction.\\n   425\\t- **The course taken.** By AGENTS' rule for an unsettled disagreement, the cheaper, reversible course is to keep the stored summary.\\n   426\\t  The quote is shown beside it, so the source wording is on the reader's screen. A later version can drop the field from the\\n   427\\t  allow-list or change it.\\n\",\"exit_code\":0,\"status\":\"completed\"}}\ndocs/research/2026-11-22-number-answers/codex-r74f.stream:16:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_8\",\"type\":\"command_execution\",\"command\":\"/opt/homebrew/bin/zsh -lc 'nl -ba docs/research/2026-11-22-number-answers/round74-brief.md; nl -ba docs/research/2026-11-22-number-answers/codex-r74e.md'\",\"aggregated_output\":\"     1\\t# Council round 74: review the slice-1 build design before any code (read-only)\\n     2\\t\\n     3\\tYou are an independent reviewer. Do not edit any file. The repository is /Users/lchingen/hivemind. Cite file:line.\\n     4\\t\\n     5\\t## What to review\\n     6\\t\\n     7\\t`docs/research/2026-11-22-number-answers/RELEASE-BUILD.md`, the build design for the first slice of the \\\"Forecast unavailable\\\"\\n     8\\trelease. The governing documents:\\n     9\\t- `docs/research/2026-11-22-number-answers/FORECAST-UNAVAILABLE-DESIGN.md` (revision 4, ready per `codex-r72d.md`);\\n    10\\t- D726, D756, D757 and D758 at the end of `docs/DECISIONS-log.md`;\\n    11\\t- AGENTS.md §2 (design tables before code), §3 (one owner; the writer refuses), §4 (tests) and §5.\\n    12\\t\\n    13\\tCode that the design reuses:\\n    14\\t- `src/hivemind/service.py`: `resolve_bound`, `view_exists`, `is_open_as_of`, `state_as_of`, `evidence`, `evidence_record`,\\n    15\\t  `ladder_bands`;\\n    16\\t- `src/hivemind/bundle.py`: `read_snapshot`, `item_lookup`, `view_bundle`;\\n    17\\t- `src/hivemind/views/store.py`: `view_key`, `rungs_of`;\\n    18\\t- `src/hivemind/views/identity.py:10`;\\n    19\\t- `src/hivemind/vocabulary.py:24`;\\n    20\\t- `src/hivemind/idea.py`, for the idea question.\\n    21\\t\\n    22\\t## Questions\\n    23\\t\\n    24\\t1. **Leaks.** Does the allow-list in §1 let any number forecast reach the package? Check:\\n    25\\t   - each allowed field's real content in stored stores, read-only (for example `poc/data/comparison-2026-11-17/run/old-1/prod/views.sqlite`):\\n    26\\t     `question`, evidence `one_line` and `quote`, source titles;\\n    27\\t   - whether evidence linked to a number question can itself be a system-written forecast rather than a source statement.\\n    28\\t\\n    29\\t   Name any path with a stored example.\\n    30\\t2. **Tables.** Are the state × event, value × reader and new path × old checks tables complete? Name any blank or wrong cell, for\\n    31\\t   example an event the export can meet that is not listed.\\n    32\\t3. **Tests and mutants.** Does each named test fail without the code it tests? Is a decisive case missing?\\n    33\\t4. **The $0 release check (§7).** Is the leak sweep sound? Consider the 12-character floor and the string classes. Would it miss a\\n    34\\t   forecast restated in different words?\\n    35\\t5. **The four open points in §8:**\\n    36\\t   - no idea submission in the release, with the idea acceptance moved to a later slice;\\n    37\\t   - `object` and `kind` on every record;\\n    38\\t   - groups left out;\\n    39\\t   - the sweep floor.\\n    40\\t\\n    41\\t   Decide each.\\n    42\\t6. **Ready to build?** Give a verdict: ready, or not ready with each serious finding.\\n    43\\t\\n    44\\t**Out of scope:** the judging, opening and extraction pieces (frozen); the closed v13s line; the POC's own behaviour; any other open\\n    45\\tdefect; wording. Report only findings that change what is built or whether it is safe.\\n     1\\t**Not ready to build.** Revision 5 closes both 74d defects at `--out`. Two issues remain. Test 14 checks the command’s exit status on the wrong path, and cleanup can delete a directory that reuses the staging name after publication.\\n     2\\t\\n     3\\t1. **Both 74d defects are closed in the design.** The only operation that creates `--out` is an atomic move that refuses an existing destination, including an empty directory. A database error before that move leaves only private staging to clean up. Test 17 specifies the missing-table error, exit 1, absence of both output and staging, and a successful retry at the same path. [RELEASE-BUILD.md:142](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/RELEASE-BUILD.md:142) · [RELEASE-BUILD.md:171](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/RELEASE-BUILD.md:171) · [RELEASE-BUILD.md:329](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/RELEASE-BUILD.md:329)\\n     4\\t\\n     5\\t2. **Test 14 still misses the command’s late refusal.** Its module test creates the foreign empty directory after staging. Its command test creates the directory before startup, so the early check can return exit 1 without ever reaching `publish` or staging cleanup. Run the real command on a scratch copy with a pause immediately before `publish`, create the empty directory, then resume. Assert exit 1, removal of the build’s staging folder, and survival of the same empty directory by device and inode. [RELEASE-BUILD.md:161](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/RELEASE-BUILD.md:161) · [RELEASE-BUILD.md:212](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/RELEASE-BUILD.md:212) · [RELEASE-BUILD.md:326](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/RELEASE-BUILD.md:326) · [RELEASE-BUILD.md:328](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/RELEASE-BUILD.md:328)\\n     6\\t\\n     7\\t3. **Revision 5 introduces a cleanup race at the old staging name.** Once `publish` succeeds, the rename frees that name. If another process creates a directory there before `finally` runs, the specified “if it still exists” check can remove the new directory. End the build’s cleanup responsibility as soon as the move succeeds. The decisive test recreates the old staging directory with a marker file after the move and verifies that the marker survives command exit. [RELEASE-BUILD.md:138](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/RELEASE-BUILD.md:138) · [RELEASE-BUILD.md:163](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/RELEASE-BUILD.md:163) · [RELEASE-BUILD.md:167](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/RELEASE-BUILD.md:167)\",\"exit_code\":0,\"status\":\"completed\"}}\ndocs/research/2026-11-22-number-answers/codex-r74f.stream:19:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_9\",\"type\":\"command_execution\",\"command\":\"/opt/homebrew/bin/zsh -lc 'nl -ba docs/research/2026-11-22-number-answers/FORECAST-UNAVAILABLE-DESIGN.md'\",\"aggregated_output\":\"     1\\t# \\\"Forecast unavailable\\\" for number questions: the design, ready for when release work opens\\n     2\\t\\n     3\\t**Status: design only. Nothing is built.** Alex decided the behaviour twice:\\n     4\\t- D726, \\\"同意\\\": until the number answers pass, a first release shows number questions with their sources and \\\"Forecast unavailable\\\",\\n     5\\t  with the band, the forecast text and its history withheld together; \\\"it is built with the release work, which is not started\\\";\\n     6\\t- D756, \\\"结束这条线，预测暂缺上线\\\".\\n     7\\t\\n     8\\tOpening release work is Alex's call (council 72). This page makes the build a known, reviewed slice for that moment.\\n     9\\t\\n    10\\t**Revision 4 (council 72c) of revision 3: one structural rule instead of a list of leaks.** Rounds 72 and 72b each found new paths by which a withheld forecast\\n    11\\tcould reach a reader:\\n    12\\t- the idea card;\\n    13\\t- the closing text;\\n    14\\t- an idea summary that re-reads the ladder;\\n    15\\t- a release page that reloads from the live POC service;\\n    16\\t- a translated export;\\n    17\\t- a Yes/No explanation that quotes a number question's band.\\n    18\\t\\n    19\\tA rule that withholds fields reader by reader will keep missing one (AGENTS §1: \\\"when one mechanism draws findings round after round,\\n    20\\tstop answering findings: propose one structural rule\\\"). Revision 3 replaces that rule with an allow-list at one boundary.\\n    21\\t\\n    22\\t## 1. The gap, measured at $0 (2026-11-23)\\n    23\\t\\n    24\\tThe stored poc-v118 store `poc/data/comparison-2026-11-17/run/old-1/prod/views.sqlite`, read-only, gives:\\n    25\\t- **The number question v8 (FY2027 Data Center revenue)** exposes its band, label, condition, reasons, 75 judgements and 69 change rows.\\n    26\\t- **Its idea input** reads \\\"Bullish … $350 billion to under $400 billion\\\".\\n    27\\t- **Yes/No explanations quote number forecasts:**\\n    28\\t  - `old-3` `v36`, judgement 799: \\\"around $1 trillion\\\" for 2027 spending;\\n    29\\t  - `old-1` `v10`, judgement 865: the selected bands of both spending questions.\\n    30\\t\\n    31\\t  The judge is shown related questions' selected bands (`views/judging.py:208`), and its prose can repeat them.\\n    32\\t\\n    33\\t## 2. The structural rule: one release export, allow-listed\\n    34\\t\\n    35\\t- **One exporter writes the release data:** `release_export`, a single function beside `service.py`. It emits only the fields on an\\n    36\\t  explicit allow-list. A field not on the list cannot appear, so a new or overlooked path fails closed.\\n    37\\t- **The release builder calls `release_export` directly** and accepts no external input; a marker or version names a format, not\\n    38\\t  who wrote the text (council 72c). The finished package is checked as well as the page: it holds only the export's output, with no\\n    39\\t  market data, composite trials or translated file beside it.\\n    40\\t- **The release reads only that export.** Its page, its static build and its API, if any, read nothing else:\\n    41\\t  - no live POC service;\\n    42\\t  - no `/library` reload (`poc/ui/src/bootstrap.js` must not fetch in a release build);\\n    43\\t  - no prepared or translated JSON (`scripts/mock_translate.py`'s `data.en.json`);\\n    44\\t  - no `--composite-trials` input.\\n    45\\t\\n    46\\t  The static builder refuses any input not produced by `release_export`, which carries a marker and the allow-list version.\\n    47\\t- **For a number question, the allow-list is:**\\n    48\\t  - the question and its id;\\n    49\\t  - the evidence in force: one-line, quote, speaker, original day, tier and sources, amounts as quoted;\\n    50\\t  - the marker \\\"Forecast unavailable\\\".\\n    51\\t\\n    52\\t  Nothing else is listed:\\n    53\\t  - no ladder;\\n    54\\t  - no band, label or condition;\\n    55\\t  - no reasons or why_changed;\\n    56\\t  - no history, counts or assessment dates;\\n    57\\t  - no closing band (\\\"closed\\\" only);\\n    58\\t  - no theme pushes, no composite, no idea derived from its forecast.\\n    59\\t- **Ideas.** The release's idea composition (`idea.py`, `idea_composite.py`) runs on export data only. A number question enters it\\n    60\\t  as question and evidence with the marker. Its ladder is not read from storage in either the answer-format build or the summary\\n    61\\t  input (`idea_composite.py:255`, `:281`; `poc-v118-idea.json:94`). The test inspects the composed request itself, not only the\\n    62\\t  delivered card.\\n    63\\t- **The POC is unchanged.** Its API, MCP and page keep today's behaviour. Whether colleagues' POC page also changes is a separate\\n    64\\t  later choice for Alex.\\n    65\\t\\n    66\\t## 3. Identity: what a number question is (verified on four stores by council 72b)\\n    67\\t\\n    68\\tA view is a number question unless one of the following excludes it:\\n    69\\t1. **An event.** The view key's measure is in `identity.EVENT_MEASURES` (`event`, `policy_event`). That covers 85 of 85 event\\n    70\\t   questions in the three comparison stores.\\n    71\\t2. **A Yes/No question.** The ladder has exactly two labels which, canonicalised with the existing vocabulary\\n    72\\t   (`vocabulary.canonical`), are Yes and No in either order. The sealed ledger's 30 such questions use `是` and `否`. The Xbox `v37`\\n    73\\t   (`growth_rate`, bounds around zero) is Yes/No.\\n    74\\t\\n    75\\tEvery other view is a number question. Its forecast is withheld whether its bands come from `lo`/`hi`, parse from the conditions\\n    76\\t(the sealed `v3`), or cannot be resolved. An unresolved record is withheld and listed in the release check, with a key or without\\n    77\\t(council 72b: an `old-1/v8` copy without bounds does not parse, and its key still exists).\\n    78\\t\\n    79\\tCounts (council 72b), number / event or Yes/No:\\n    80\\t- `old-1` 19 / 28, `old-2` 17 / 26, `old-3` 18 / 31;\\n    81\\t- the sealed ledger: 43 parse as money, 21 are withheld as unresolved, 30 are Yes/No.\\n    82\\t\\n    83\\tNo wrong show-or-withhold result was found.\\n    84\\t\\n    85\\t**Events are binary too.** All 85 comparison-store events are also two-answer questions, including both known prose leaks, and a\\n    86\\tbinary event such as \\\"Restriction adopted\\\" / \\\"No restriction adopted\\\" exists in the served ledger (council 72c). §4's rule applies to\\n    87\\tevery question that is not a number question, events and Yes/No alike, and each keeps its answer label.\\n    88\\t\\n    89\\t## 4. Questions that are not number questions: an open choice for Alex (not decided here)\\n    90\\t\\n    91\\tD726 covers number questions. A Yes/No question's band is not a number forecast, but its stored explanation can quote one (§1). The\\n    92\\tallow-list must say which Yes/No fields the release shows:\\n    93\\t- **(a)** the question, its evidence and its answer (Yes/No and label), with no explanation text. Safe, and it removes the reasoning\\n    94\\t  readers would see.\\n    95\\t- **(b)** as (a), plus the explanation only for judgements whose request showed the judge no number question's state. Code can\\n    96\\t  decide this from the stored request (`views/judging.py`, which builds the related questions shown).\\n    97\\t- **Measured (council 72c),** matching each judgement to its archived request:\\n    98\\t  - (b) would keep explanations on 31 of 769, 44 of 776 and 43 of 958 judgements in the three comparison runs;\\n    99\\t  - for a reader at the latest answer, it would keep them on 21 of 85 questions;\\n   100\\t  - it would keep 73 of 73 in the sealed ledger.\\n   101\\t- **The limit of (b).** It cannot promise the prose quotes no number forecast. A request also carries the question's own previous\\n   102\\t  reasoning, and can carry another question's, either of which may repeat a forecast seen earlier. Both known leaks are in\\n   103\\t  `why_changed`.\\n   104\\t- **Recommendation: (a) for the first release** (council 72c; Claude agrees, withdrawing its lean for (b)). It is the only option\\n   105\\t  that guarantees no number forecast reaches a reader through prose. (b) remains a measured later step.\\n   106\\t\\n   107\\t## 5. Tests and the $0 release check (each names its row above)\\n   108\\t\\n   109\\t- **Fixtures (real store on a temporary path):**\\n   110\\t  - a number question with `lo`/`hi`;\\n   111\\t  - one with bounds only in its conditions;\\n   112\\t  - an unresolved one with a key;\\n   113\\t  - a Yes/No question with numeric bounds;\\n   114\\t  - an event question;\\n   115\\t  - a Yes/No judgement whose prose quotes a number band;\\n   116\\t  - a real closing switch;\\n   117\\t  - an idea.\\n   118\\t- **What the tests assert.** `release_export`'s output holds only allow-listed keys (a schema check that fails on any extra key). For\\n   119\\t  number questions it holds no band, ladder, reasons, history, date or closing band; Yes/No follows §4's choice. The static build\\n   120\\t  refuses foreign input, and a release page makes no network fetch.\\n   121\\t- **Mutants:**\\n   122\\t  - an extra field;\\n   123\\t  - a fetch left on;\\n   124\\t  - a ladder read in idea composition;\\n   125\\t  - the identity mis-sorting each fixture.\\n   126\\t\\n   127\\t  Each must fail.\\n   128\\t- **End-to-end acceptance (council 72c):**\\n   129\\t  - an idea whose only question is `old-1/v8`: the card keeps its sources and \\\"Forecast unavailable\\\", with no scored driver and no\\n   130\\t    substitute band (the current composite expects an endpoint for every scoring candidate, `idea_composite.py:214`, `:231`);\\n   131\\t  - in the same release package, the two known event answers keep their labels and carry no spending forecast under the chosen\\n   132\\t    prose rule.\\n   133\\t- **The $0 release check.**\\n   134\\t  - On `old-1/v8`, confirm the marker and the same sources in the page and in the export data.\\n   135\\t  - Exercise closure on a temporary copy with a real closing switch, after first confirming that the unrestricted response exposes the\\n   136\\t    final band there.\\n   137\\t  - Check ideas with a recorded or test transport, inspecting the composed request.\\n   138\\t  - Use `old-3/v36` and `old-1/v10` as the Yes/No prose cases.\\n   139\\t  - Use one unchanged event question as the control.\\n   140\\t\\n   141\\t## 6. Not in scope\\n   142\\t\\n   143\\t- The judging, opening and extraction pieces (frozen).\\n   144\\t- The closed v13s line.\\n   145\\t- Other open defects.\\n   146\\t- No prompt or pipeline change.\\n   147\\t- The POC's own behaviour.\\n\",\"exit_code\":0,\"status\":\"completed\"}}\ndocs/research/2026-11-22-number-answers/codex-r74f.stream:20:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_10\",\"type\":\"command_execution\",\"command\":\"/opt/homebrew/bin/zsh -lc \\\"nl -ba docs/research/2026-11-22-number-answers/RELEASE-BUILD.md | sed -n '1,196p'\\\"\",\"aggregated_output\":\"     1\\t# \\\"Forecast unavailable\\\" release: build design for slice 1 (the exporter and the checked package)\\n     2\\t\\n     3\\t**Status: revision 6, for council round 74f. No code yet.** Release work was opened by the council under D439 (D758). The behaviour is\\n     4\\tfixed by D726, D756 and `FORECAST-UNAVAILABLE-DESIGN.md` (revision 4). This page holds the AGENTS §2 tables for the first slice.\\n     5\\t\\n     6\\t**Revision 2 answers `codex-r74.md`** (see `claude-r74.md`):\\n     7\\t- the pass condition is an origin check of every field against its stored source, not a string sweep;\\n     8\\t- a missing source item is refused;\\n     9\\t- the package is checked before it is moved into place;\\n    10\\t- the manifest is a closed set;\\n    11\\t- the bound is validated as a date;\\n    12\\t- narrow reads;\\n    13\\t- size and speed budgets;\\n    14\\t- tests that separate every branch;\\n    15\\t- `object`, `kind` and groups dropped;\\n    16\\t- no idea submission.\\n    17\\t\\n    18\\tThe evidence summary stays as extraction stored it (§8, disputed in `claude-r74.md`).\\n    19\\t\\n    20\\t**Revision 3 answers `codex-r74b.md`.**\\n    21\\t- The checker derives everything it compares from the store, never from the package: the date, each question's class, the records and their counts.\\n    22\\t- A missing source item refuses `check` too.\\n    23\\t- The files must be two regular, non-symlink files, with no duplicate JSON member names.\\n    24\\t- The staging folder has one owner.\\n    25\\t- The builder's refusal is tested through the builder.\\n    26\\t- The diagnostics read only the columns a store has.\\n    27\\t\\n    28\\t**Revision 4 answers `codex-r74c.md`.**\\n    29\\t- One date rule for build and `check`.\\n    30\\t- Questions are ordered by `created_seq, rowid`.\\n    31\\t- (Superseded in revision 5.) The build claimed its output folder before staging.\\n    32\\t- Cleanup sits where the staging path is known.\\n    33\\t- A report failure after publication has its own outcome.\\n    34\\t- The builder's refusal is proved through the real command on a scratch copy.\\n    35\\t- Tests 9, 13, 14 and 15 are sharpened.\\n    36\\t\\n    37\\t**Revision 5 answers `codex-r74d.md` with one structural rule** (AGENTS §1: the publication mechanism drew findings in 74b, 74c and\\n    38\\t74d). Staging is private, and the only public step is one atomic move that refuses any existing destination. There is no public\\n    39\\tclaim, so nothing public is created early or cleaned up. Staging is removed in a `finally` covering its whole life, so any error,\\n    40\\tdatabase errors included, leaves nothing at `--out`.\\n    41\\t\\n    42\\t**Revision 6 answers `codex-r74e.md`.**\\n    43\\t- The build's cleanup responsibility ends the moment `publish` succeeds: the staging path is cleared and the `finally` removes nothing\\n    44\\t  after that, so a folder later created at the freed staging name is never touched.\\n    45\\t- The late refusal at `publish`, and the end of cleanup after it, are proved through the real command on scratch copies with a\\n    46\\t  pause.\\n    47\\t\\n    48\\t## 0. Scope\\n    49\\t\\n    50\\t- **Slice 1 (this page), $0:**\\n    51\\t  - the exporter `release_export` and its self-check;\\n    52\\t  - the package writer, the package check and the origin check;\\n    53\\t  - the release builder, which calls the exporter directly;\\n    54\\t  - tests and mutants;\\n    55\\t  - the $0 release check on stored stores.\\n    56\\t- **Slice 2, next.** The release page reads only the package: no live service, no `/library` fetch, no translated JSON, no composite\\n    57\\t  trials, no idea submission control or route. It gets a browser check of the `old-1/v8` screen, which completes D756's screen check.\\n    58\\t- **No idea submission in the release** (council 74). The idea path (`idea.py`) reads the ledger at every step and calls a paid model\\n    59\\t  per idea. The design's §5 idea acceptance (an idea card backed only by `v8`, and its composed request) is carried forward as pending\\n    60\\t  for the first idea-enabled slice.\\n    61\\t- **Not in scope:**\\n    62\\t  - the POC, its API, MCP and page (unchanged);\\n    63\\t  - colleagues' page;\\n    64\\t  - frozen pieces, extraction included;\\n    65\\t  - any model call;\\n    66\\t  - commit, publish, deploy.\\n    67\\t\\n    68\\t## 1. What is built\\n    69\\t\\n    70\\t`src/hivemind/release.py` is the one owner, beside `service.py`.\\n    71\\t\\n    72\\t- **Constants:**\\n    73\\t  - `FORMAT = 'hivemind-release/1'`;\\n    74\\t  - `ALLOW_LIST = 'release-allow-list/1'`;\\n    75\\t  - `FORECAST_UNAVAILABLE = 'Forecast unavailable'`;\\n    76\\t  - `PACKAGE_FILES = {'manifest.json', 'release-data.json'}`.\\n    77\\t- **`ALLOWED`:** the closed key set per record type.\\n    78\\t\\n    79\\t  | Record | Keys |\\n    80\\t  |---|---|\\n    81\\t  | envelope | `format`, `allow_list`, `as_of`, `questions` |\\n    82\\t  | number question | `id`, `question`, `open`, `class` (= `number`), `forecast` (= the marker), `evidence` |\\n    83\\t  | event or Yes/No question | `id`, `question`, `open`, `class` (`event` or `yes_no`), `answers` (the two stored rung labels, in position order), `answer` (the stored label of the latest judgement's rung on or before the bound, or null), `evidence` |\\n    84\\t  | evidence in force at the bound | `id`, `one_line`, `quote`, `tier`, `speaker`, `original_who`, `original_day`, `sources` |\\n    85\\t  | source recorded on or before the bound | `title`, `publisher`, `day`, `uri` |\\n    86\\t  | manifest | `format`, `allow_list`, `as_of`, `data_sha256` |\\n    87\\t\\n    88\\t- **`question_class(views_db, view_id, labels)`** (design §3):\\n    89\\t  - `event` when the view key's measure is in `identity.EVENT_MEASURES`. The key is read as `select measure from view_keys`, and\\n    90\\t    only when the table exists;\\n    91\\t  - `yes_no` when there are exactly two labels which, through `vocabulary.canonical('label', …)`, are `Yes` and `No` in either order;\\n    92\\t  - `number` otherwise: a view with no key, or one whose bands cannot be resolved.\\n    93\\t- **`release_export(views_db, items_db, as_of=None)`:**\\n    94\\t  - pins both connections (`bundle.read_snapshot`);\\n    95\\t  - resolves the bound with `service.resolve_bound`, refuses a store with no default day, and validates the bound with\\n    96\\t    `date.fromisoformat`;\\n    97\\t  - exports every view that exists at the bound (`service.view_exists`), closed ones included, in `created_seq, rowid` order;\\n    98\\t  - builds each record field by field from the table above, with column-limited SQL:\\n    99\\t    - `select view_id, question, created_seq from views order by created_seq, rowid`;\\n   100\\t    - `select position, label from rungs`;\\n   101\\t    - `select rung from judgements where view_id=? and publication_day<=? order by judgement_id desc limit 1`;\\n   102\\t    - `service.is_open_as_of`, which reads only `open` and `after_seq`;\\n   103\\t  - takes evidence in force from `service.evidence` and its fields from that record;\\n   104\\t  - looks up each source's `title`, `publisher` and `source_uri` in the items database by `input_id`. A visible source whose item is\\n   105\\t    missing raises `ReleaseRefused` (there is no fallback to the id);\\n   106\\t  - calls `check_export` on its own result before returning (AGENTS §3: the writer refuses).\\n   107\\t- **`check_export(data)`:** the closed-set check.\\n   108\\t  - Every dict at every level has exactly its record type's keys.\\n   109\\t  - Value checks:\\n   110\\t    - `format` and `allow_list` equal the constants, and `as_of` is an ISO date;\\n   111\\t    - `class` is in its set;\\n   112\\t    - a number record's `forecast` is the marker;\\n   113\\t    - `answers` is two strings, and `answer` is one of them or null;\\n   114\\t    - `open` is a bool and every text field is a string.\\n   115\\t  - It returns the counts it judged: questions per class, evidence, sources.\\n   116\\t- **`check_origins(views_db, items_db, data, expected_as_of)`:** the pass condition. It is independent of the exporter's code path.\\n   117\\t  It derives everything it compares from the store, never from the package.\\n   118\\t  - **The bound: one rule for both commands.** `expected_as_of` is given by the caller.\\n   119\\t    - The builder passes the bound it resolved: `service.resolve_bound` on the requested day, or the default when none is given; an\\n   120\\t      omitted day with no default is refused.\\n   121\\t    - `check` passes the package's `as_of` through the same `service.resolve_bound`, which refuses a day after a store's last\\n   122\\t      completed day. A legacy ledger with no completed days accepts any valid date in both commands alike.\\n   123\\t    - The package's `as_of` must equal `expected_as_of`.\\n   124\\t  - **The class** of each question is derived from the stored measure and labels (`question_class`). The permitted keys and values\\n   125\\t    are then chosen from that class, never from the package's `class` field.\\n   126\\t  - **Order and counts.** The questions are compared as an ordered list in `created_seq, rowid` order, as `bundle.library` orders\\n   127\\t    them (`old-2/v2` and `v3` share sequence 8). Each question's evidence is compared in link order (`evidence_links.id`), and its\\n   128\\t    sources in row order (`evidence_sources.id`). A duplicate question, evidence record or source therefore fails.\\n   129\\t\\n   130\\t  It compares every field with its permitted stored source at the bound, by direct SQL:\\n   131\\t  - the question set equals the views visible at the bound, with `question` equal to `views.question`;\\n   132\\t  - `open` equals the latest visible switch's `open`;\\n   133\\t  - for `event` and `yes_no`: `answers` equal the rung labels in position order, and `answer` equals the label of the latest judgement\\n   134\\t    rung on or before the bound, or null;\\n   135\\t  - for `number`: only the marker;\\n   136\\t  - the evidence id set equals the links visible at the bound, minus those whose latest replacement is visible, computed in its own\\n   137\\t    SQL. Each evidence field equals the `evidence` row's column;\\n   138\\t  - each source list starts from every visible `evidence_sources` row, in row order, with `day` taken from\\n   139\\t    `evidence_sources.publication_day`. Each row needs a matching `items` row for `title`, `publisher` and `source_uri`; a row with no\\n   140\\t    item raises `ReleaseRefused` (a left join, so a missing item is never silently dropped).\\n   141\\t\\n   142\\t  Any difference raises `ReleaseRefused`, naming the question, the field and the evidence id. It returns the number of fields\\n   143\\t  compared.\\n   144\\t- **`stage(out_dir)`:** creates a private staging folder with a name unique to this invocation, `tempfile.mkdtemp(dir=out_dir.parent,\\n   145\\t  prefix='.<name>.staging-')`. Creation is exclusive, so only this invocation owns it. It returns the path.\\n   146\\t- **`write_package(data, staged)`:** writes `release-data.json` and `manifest.json` into the staging folder. It creates nothing\\n   147\\t  else.\\n   148\\t- **`publish(staged, out_dir)`:** one atomic move that refuses any existing destination, empty or not:\\n   149\\t  - on macOS, `renamex_np(staged, out_dir, RENAME_EXCL)` through `ctypes`. Verified on this Mac: onto a free path it succeeds; onto\\n   150\\t    an existing empty or non-empty folder it fails with `EEXIST`, and both folders stay as they were;\\n   151\\t  - on Linux, `renameat2(AT_FDCWD, staged, AT_FDCWD, out_dir, RENAME_NOREPLACE)`;\\n   152\\t  - where neither call exists, or the filesystem lacks support (`ENOTSUP`, `EINVAL`), it raises `ReleaseRefused`.\\n   153\\t\\n   154\\t  It never replaces, creates or removes anything at `out_dir` except by that one move.\\n   155\\t- **`check_package(path, views_db=None, items_db=None, expected_as_of=None)`:**\\n   156\\t  - the directory holds exactly `PACKAGE_FILES`, each a regular file and not a symbolic link (`os.lstat`), with no subdirectories;\\n   157\\t  - both files parse as JSON with no duplicate member name at any level (an `object_pairs_hook` that refuses a repeated key);\\n   158\\t  - the manifest has exactly its four keys, and its `format`, `allow_list` and `as_of` equal the data's;\\n   159\\t  - its sha256 equals the data file's;\\n   160\\t  - the data passes `check_export`, and, when the stores are given, `check_origins` with the expected bound;\\n   161\\t  - it returns the counts.\\n   162\\t- **`withheld_unresolved(views_db, data)`** is for the report only. It lists the number questions whose `service.ladder_bands(rungs)`\\n   163\\t  returns `(None, reason)`, with the reason and whether the view has a key. Its output never enters the package.\\n   164\\t\\n   165\\t`scripts/release_build.py`:\\n   166\\t- **`build --ledger --items [--as-of] --out`:**\\n   167\\t  1. refuse an existing `--out` early, as a convenience; `publish` holds the guarantee;\\n   168\\t  2. resolve the bound once (`service.resolve_bound`, `date.fromisoformat`);\\n   169\\t  3. `stage(--out)`. From here a `finally` removes this staging folder while the build still owns it;\\n   170\\t  4. `release_export` at that bound;\\n   171\\t  5. `write_package` into the staging folder;\\n   172\\t  6. `check_package` on the staged folder, with the stores and the resolved bound;\\n   173\\t  7. `publish` to `--out`. The moment it succeeds, the build drops its staging path (`staged = None`); the `finally` then removes\\n   174\\t     nothing;\\n   175\\t  8. write `<out>.report.json` beside the package, through a temporary file and `os.replace`.\\n   176\\t\\n   177\\t  The failure outcomes:\\n   178\\t  - **Before publication** (steps 2–7): any exception, whether `ReleaseRefused`, `OSError`, `sqlite3.Error` or another, prints the\\n   179\\t    reason and exits 1. The `finally` removes this build's staging folder; nothing exists at `--out` from this build. A corrected\\n   180\\t    retry at the same `--out` succeeds.\\n   181\\t  - **After publication** (step 8 fails): the package is final and checked. Exit 2 with \\\"package published and checked; report not\\n   182\\t    written; run `check` to regenerate it\\\".\\n   183\\t\\n   184\\t  It has no input path for prepared or translated JSON, and it takes no clock reading; the folder name is the caller's (D12, D13).\\n   185\\t- **`check <out> --ledger --items`:** re-runs `check_package` on an existing package, with the stores, the package's `as_of`\\n   186\\t  validated against the store (above), and the regular-file and duplicate-key checks. It leaves the package in place and rewrites\\n   187\\t  `<out>.report.json`. This is also the retry after a report write failed. Its report gives `check_seconds` and marks\\n   188\\t  `export_seconds` as not measured.\\n   189\\t- **The report:**\\n   190\\t  - the store path and the bound;\\n   191\\t  - counts per class;\\n   192\\t  - the unresolved list;\\n   193\\t  - the fields compared;\\n   194\\t  - bytes;\\n   195\\t  - `export_seconds` (build only) and `check_seconds`.\\n   196\\t\\n\",\"exit_code\":0,\"status\":\"completed\"}}\ndocs/research/2026-11-22-number-answers/codex-r74f.stream:22:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_11\",\"type\":\"command_execution\",\"command\":\"/opt/homebrew/bin/zsh -lc \\\"rg -n '\\\"'^#+ .*D(726|756|757|758)'\\\"\\\\\\\\b|\\\"'^'\\\"\\\\\\\\| D(726|756|757|758)\\\\\\\\b' docs/DECISIONS-log.md; tail -n 5 docs/research/2026-11-04-filing-end-to-end/log.md\\\"\",\"aggregated_output\":\"10991:## D726 · 2026-11-22 · Alex opens a judge version for related number questions ($0 gate first) and agrees to \\\"Forecast unavailable\\\" as the first-release interim\\n11799:## D755 · 2026-11-23 · The paid re-send STOPs (complete); council 71: close v13s at STOP and carry D726's \\\"Forecast unavailable\\\" into the first release\\n11823:## D756 · 2026-11-23 · Alex closes the v13s line; the first release shows number questions as \\\"Forecast unavailable\\\"\\n11842:## D757 · 2026-11-23 · Toward production: the \\\"Forecast unavailable\\\" release design is ready for when Alex opens release work (council 72–72d); two choices go to Alex\\n11867:## D758 · 2026-11-23 · Under D439 the council opens local release work for \\\"Forecast unavailable\\\"; non-number questions show no explanation text (§4 a); the v13s checker defects are closed as won't-fix (council 73)\\n| 37 | 11-05 | Alex：\\\"为什么没过？…你确定是正确的rejection 吗？你又下去看trace吗？\\\"；\\\"我需要你深度看完所有失败trace给我准信下一步你要跑什么才能收敛\\\"。普查全部 7 次读法、606 次文件读（`census_all_reads.py`，$0） | 第三版 0 个错数、156 次读漏 3 次（全是资本开支）；第二版 2 个错数；第四版漏 24 次（5 月）、16 次（8 月）。我自己判错的：6 个对的数被我的引用检查拒（漏星号、跳格），8 月\\\"只认本季\\\"规则错，第 13 轮 3 条\\\"有争议\\\"的数是标准答案自己用的行，第三版全过后又改第四版 | 收敛方案：提示词定为第三版不再改；修引用检查（$0 重放全部 606 次读核对）；在 8 月财报上用第三版读一次（约 8 美分，只有\\\"收错数\\\"能叫停）；然后做进生产 |\\n| 38 | 11-05 | Alex：\\\"好，按这三步做，你不要再搬石头砸自己脚了，你要收敛上生产\\\"。第 1 步：引用检查搬进正式代码 `src/hivemind/baseline.py`，加\\\"行名是报告的、数在同一行就存原文那一整行\\\"的修复（漏脚注记号、跳格）；对照 36 例全对，三个弄坏的版本各抓出 1 个错；重放全部存下的读法，改变的正好是那 6 个被拒的对数。第 2 步：第三版加修好的检查读 8 月留出财报 132 次（0.096 美元），两人分类 | 第 1 步：只改了那 6 条。第 2 步过：44 个数 0 个错（3 条\\\"剩余资本开支承诺 70 亿\\\"两人不一致，对着原文定为\\\"自己的量，别的期间\\\"）；v10 3/3、v12 2/3 | 读法定为第三版加修好的检查，不再改；第 3 步写正式代码 |\\n| 39 | 11-05 | 第 3 步：做进正式系统（设计四张表，Codex 审 3 轮：第 1 轮 4 条严重、第 2 轮 2 条严重，都改；第 3 轮无严重问题） | 建成 `baseline.run` + poc-v116 + baseline-v3 提示词文件；$0 核对：44 份请求和验证时逐字节相同，3 次存下的回答走正式代码写出的记录完全一样，第一天判断正好判这些题，网页从开始跟踪那天可见；新测试 12 条、6 个弄坏版本都抓出、全套 272 条通过；设计页和 PRD 00/03/04/05/06 更新，`docs/check.py` 通过 | 交 Alex：要不要跑 14 天三遍完整验收（约 5 美元） |\\n| 40 | 11-05 | Alex：\\\"跑验收\\\"。14 天三遍完整验收：poc-v116（开始跟踪时读财报）三遍、当天重跑 poc-v108 三遍作对照，冻结尺子打分（事先锁定 `acceptance-design.md`）；电脑中途在电池上睡了约 5 小时，6 遍被暂停，插电后自己接着跑完 | **全过**：v10、v12 各 3/3（对照从没判过）；合计 53 对 45（满分 57，+8）；唯一少两次的 v17（0/3 对 2/3）两人都认定不是起点数：同一份抽取请求，新配置两遍碰巧留下\\\"中国份额归零\\\"那句，对照没留；约 4.79 美元 | 交 Alex：poc-v116 是否成为默认 |\\n| 41 | 11-05 | Alex：\\\"都做\\\"（poc-v116 设成默认；提交代码、开 PR）。默认配置改成 poc-v116，默认的条目数据库换成带财报网页原文的那一份（旧的没有原文，新默认会在它上面拒跑）；测试按用户的用法补上：不给种子题就拒绝，给了就先读财报再跑第一天 | 测试全过，5 个弄坏的版本都抓出；配置的设置和验收三遍记下的校验码一致（只改了配置里的注释）；花钱前的检查脚本在新配置的运行数据上照常跑完，但不复查读财报那一步的引用检查（记为未补的缺口）；D366 | 提交、开 PR；下一类问题等 Alex |\\n\",\"exit_code\":0,\"status\":\"completed\"}}\ndocs/research/2026-11-22-number-answers/codex-r74f.stream:24:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_12\",\"type\":\"command_execution\",\"command\":\"/opt/homebrew/bin/zsh -lc \\\"sed -n '10991,11012p;11823,11905p' docs/DECISIONS-log.md; rg -n '## (2|3|4|5|9)\\\\\\\\.' AGENTS.md\\\"\",\"aggregated_output\":\"## D726 · 2026-11-22 · Alex opens a judge version for related number questions ($0 gate first) and agrees to \\\"Forecast unavailable\\\" as the first-release interim\\n\\n- **The questions** (after D725):\\n  - \\\"要不要开一个新的判官版本来试修法（相关的题合在一次里算，每个数字标明出处，程序检查算术和出处）？\\\" Options: 开，先做 0 元那一关\\n    (recommended: the format and checks designed and through the council, then the $0 gate on five stored cases, four gold controls and\\n    three planted errors; the paid gate asks Alex for its ceiling); 先不开.\\n  - \\\"第一版上线前的过渡：数字题只显示问题和来源，档位和预测文字写成'预测暂缺'，等通过检查再放出来。你同意这个做法吗？\\\" Options: 同意\\n    (recommended); 暂不定.\\n- **Alex's answers** (2026-11-22): \\\"开，先做 0 元那一关 (推荐)\\\"; \\\"同意 (推荐)\\\".\\n- **Decided (Alex):**\\n  - A new judge version is opened for the bounded test of D725: related number questions judged together, with labelled figures and\\n    code checks of identity and arithmetic. It is designed and reviewed at $0, then the $0 gate runs. The paid gate needs Alex's\\n    ceiling.\\n  - Until the number answers pass, a first release shows number questions with their sources and \\\"Forecast unavailable\\\": the band, the\\n    forecast text and its history withheld together. It is built with the release work, which is not started.\\n- poc-v118 stays the product.\\n\\n## D727 · 2026-11-22 · judging-v13's $0 gate: the design passed council (round 46e); gate runs 1–6 and council rounds 46f–46j; the gate is not yet passed; one choice goes to Alex\\n\\n- **Design:** `docs/research/2026-11-22-number-answers/DESIGN.md`, v1 to v9. Council rounds 46 to 46e reached READY FOR THE $0 GATE on v5.\\n  - **v3's structural rule:** code derives every relation it checks from the calculation graph and the passage text.\\n- **The gate** (`gate.py`, `calc_check.py`, `mutants.py`, `render_v13.py`, `judging-v13-draft.txt`, `REQUEST-AUDIT.md`), all harness-only\\n## D756 · 2026-11-23 · Alex closes the v13s line; the first release shows number questions as \\\"Forecast unavailable\\\"\\n\\n- **The question** (after D755): \\\"付费重发的结论是“停”：luna 在新格式下格式错误多（36 个首发里 22 个被拒），在说不清的题上还会硬给数；不过“两题合在一起算”确实避免了自相矛盾。数字题这条线下一步怎么走？\\\"\\n  - Options:\\n    - \\\"结束这条线，预测暂缺上线 (推荐)\\\": the council's consensus;\\n    - \\\"换更强的模型再小测一次\\\": a stronger model or higher effort, with a small paid probe and a cap Alex names;\\n    - \\\"先停，我想谈谈\\\".\\n- **Alex's answer** (2026-11-23): \\\"结束这条线，预测暂缺上线 (推荐)\\\".\\n- **Decided (Alex):**\\n  - The v13s judge line ends at its STOP. Nothing from it enters the product, and poc-v118 stays the product (D690).\\n  - The first release carries D726: number questions show the question and its sources with \\\"Forecast unavailable\\\", the band, the\\n    forecast text and the history withheld together.\\n  - The one next step, when release work opens, is a $0 check of the reader's screen on a stored number question that has a\\n    forecast and history: only the question, its sources and \\\"Forecast unavailable\\\" appear.\\n- **Kept for the record, not built:**\\n  - the D725 consistency finding (separate answers contradicted each other in 8 of 9 pairs, joint answers in none);\\n  - the open checker defects in `PAID-V13S-RESULT.md` §5;\\n  - the v13s request and harness in `docs/research/2026-11-22-number-answers/`.\\n\\n## D757 · 2026-11-23 · Toward production: the \\\"Forecast unavailable\\\" release design is ready for when Alex opens release work (council 72–72d); two choices go to Alex\\n\\n- **Why.** Alex's direction tonight was to converge and head toward production (D750), and he chose to release with \\\"Forecast\\n  unavailable\\\" (D756). D726 says it \\\"is built with the release work, which is not started\\\". Council 72 agreed that opening release\\n  work is Alex's call, so tonight's step is the design, not the build.\\n- **The gap, measured at $0** (`docs/research/2026-11-22-number-answers/FORECAST-UNAVAILABLE-DESIGN.md` §1):\\n  - today every reader of a number question can see its forecast: the service, the idea input, the closing text;\\n  - Yes/No and event explanations can quote number forecasts (`old-3/v36` judgement 799, `old-1/v10` judgement 865).\\n- **The design, after four review rounds** (`codex-r72.md` … `codex-r72d.md`):\\n  - one release exporter with an explicit allow-list, called directly by the release builder; the finished package is checked;\\n  - for a number question, the allow-list holds only the question, its sources and \\\"Forecast unavailable\\\";\\n  - the release reads nothing else: no live POC service, no translated or prepared JSON, no composite trials;\\n  - identity is structural: a question is a number question unless it is an event measure or a canonical Yes/No pair, and unresolved\\n    records are withheld and listed. Verified on four stores with no wrong result;\\n  - tests, mutants and an end-to-end acceptance on `old-1/v8` and the two known event leaks.\\n  - **Why an allow-list.** Rounds 72 and 72b each found new leak paths in a reader-by-reader design, so revision 3 replaced that\\n    approach with one structural rule.\\n- **Open for Alex:**\\n  1. whether to open release work now (then: build to this design, then the $0 release check);\\n  2. what questions that are not number questions show in the release:\\n     - (a) answer and label without explanation text, recommended by the council and Claude;\\n     - (b) explanations only where the judge was shown no number question's state: 21 of 85 questions at the latest answer, and it\\n       cannot guarantee that no number forecast is quoted.\\n- **Not done.** Nothing is built and nothing is committed. The POC is unchanged.\\n\\n## D758 · 2026-11-23 · Under D439 the council opens local release work for \\\"Forecast unavailable\\\"; non-number questions show no explanation text (§4 a); the v13s checker defects are closed as won't-fix (council 73)\\n\\n- **Why the council decides.** Alex is asleep and delegated tonight's decisions (D750: \\\"这边的决策交给你，还有 Council … 准备要往\\n  Production 方向去走了\\\"). He had already chosen the behaviour (D726 \\\"同意\\\"; D756 \\\"结束这条线，预测暂缺上线\\\"). D757 left two\\n  choices for him; under D439 a choice that would go to Alex goes to the council when it is reversible and within the limits.\\n- **Council round 73** (`docs/research/2026-11-22-number-answers/round73-brief.md`, `codex-r73.md`, `claude-r73.md`), consensus:\\n  1. **Release work opens tonight, local and at $0:** the exporter, the release builder, the package check, tests and mutants, the $0\\n     release check. Nothing committed, pushed, published or deployed; the POC and colleagues' page unchanged. Reversible: the package\\n     can be deleted without touching what the POC serves. D726's \\\"not started\\\" described the state on 2026-11-22 and set no gate.\\n  2. **§4 (a):** an event or Yes/No question shows its question, evidence and answer with its original label, and no generated\\n     explanation. It alone guarantees no number forecast reaches a reader through prose (option (b) cannot: a request carries the\\n     question's earlier reasoning, `views/judging.py:211`). The cost is real: readers lose the written rationale for those answers.\\n  3. **The v13s checker defects** (`PAID-V13S-RESULT.md` §5) are closed as won't-fix: `calc_small.py` has callers only in research\\n     code, the line is closed (D756), and the STOP bars tuning on the 36 answers. The findings stay on record.\\n  4. **Order:** the exporter and the checked package first; the reader's screen second (it completes D756's screen check). How the\\n     idea path enters the release is settled in the build design's review (round 74).\\n- **Still Alex's:** commit, push, publish, deploy, colleagues' POC page, any paid send or judge work.\\n91:## 2. Before writing code: design\\n122:## 3. Writing code\\n145:## 4. Tests\\n168:## 5. Verification\\n419:## 9. Workspace and operations\\n\",\"exit_code\":0,\"status\":\"completed\"}}\ndocs/research/2026-11-22-number-answers/codex-r74f.stream:34:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_17\",\"type\":\"command_execution\",\"command\":\"/opt/homebrew/bin/zsh -lc \\\"rg -n 'served-2026-10-28-v34|items-comparison' docs/research/2026-11-22-number-answers | head -40; nl -ba docs/prd/10-filing-phase.md | sed -n '110,205p'\\\"\",\"aggregated_output\":\"docs/research/2026-11-22-number-answers/RELEASE-BUILD.md:373:Stores: `old-1`, `old-2`, `old-3` (`comparison-2026-11-17/run/old-N/prod/views.sqlite`, items `items-comparison.sqlite`) and the\\ndocs/research/2026-11-22-number-answers/codex-r74d.stream:19:{\\\"type\\\":\\\"item.completed\\\",\\\"item\\\":{\\\"id\\\":\\\"item_9\\\",\\\"type\\\":\\\"command_execution\\\",\\\"command\\\":\\\"/opt/homebrew/bin/zsh -lc 'nl -ba docs/research/2026-11-22-number-answers/RELEASE-BUILD.md'\\\",\\\"aggregated_output\\\":\\\"     1\\\\t# \\\\\\\"Forecast unavailable\\\\\\\" release: build design for slice 1 (the exporter and the checked package)\\\\n     2\\\\t\\\\n     3\\\\t**Status: revision 4, for council round 74d. No code yet.** Release work was opened by the council under D439 (D758). The behaviour is\\\\n     4\\\\tfixed by D726, D756 and `FORECAST-UNAVAILABLE-DESIGN.md` (revision 4). This page holds the AGENTS §2 tables for the first slice.\\\\n     5\\\\t\\\\n     6\\\\t**Revision 2 answers `codex-r74.md`** (see `claude-r74.md`):\\\\n     7\\\\t- the pass condition is an origin check of every field against its stored source, not a string sweep;\\\\n     8\\\\t- a missing source item is refused;\\\\n     9\\\\t- the package is checked before it is moved into place;\\\\n    10\\\\t- the manifest is a closed set;\\\\n    11\\\\t- the bound is validated as a date;\\\\n    12\\\\t- narrow reads;\\\\n    13\\\\t- size and speed budgets;\\\\n    14\\\\t- tests that separate every branch;\\\\n    15\\\\t- `object`, `kind` and groups dropped;\\\\n    16\\\\t- no idea submission.\\\\n    17\\\\t\\\\n    18\\\\tThe evidence summary stays as extraction stored it (§8, disputed in `claude-r74.md`).\\\\n    19\\\\t\\\\n    20\\\\t**Revision 3 answers `codex-r74b.md`.**\\\\n    21\\\\t- The checker derives everything it compares from the store, never from the package: the date, each question's class, the records and their counts.\\\\n    22\\\\t- A missing source item refuses `check` too.\\\\n    23\\\\t- The files must be two regular, non-symlink files, with no duplicate JSON member names.\\\\n    24\\\\t- The staging folder has one owner.\\\\n    25\\\\t- The builder's refusal is tested through the builder.\\\\n    26\\\\t- The diagnostics read only the columns a store has.\\\\n    27\\\\t\\\\n    28\\\\t**Revision 4 answers `codex-r74c.md`.**\\\\n    29\\\\t- One date rule for build and `check`.\\\\n    30\\\\t- Questions are ordered by `created_seq, rowid`.\\\\n    31\\\\t- The build claims its output folder exclusively before staging, so the final move can only replace its own empty claim.\\\\n    32\\\\t- Cleanup sits where the staging path is known.\\\\n    33\\\\t- A report failure after publication has its own outcome.\\\\n    34\\\\t- The builder's refusal is proved through the real command on a scratch copy.\\\\n    35\\\\t- Tests 9, 13, 14 and 15 are sharpened.\\\\n    36\\\\t\\\\n    37\\\\t## 0. Scope\\\\n    38\\\\t\\\\n    39\\\\t- **Slice 1 (this page), $0:**\\\\n    40\\\\t  - the exporter `release_export` and its self-check;\\\\n    41\\\\t  - the package writer, the package check and the origin check;\\\\n    42\\\\t  - the release builder, which calls the exporter directly;\\\\n    43\\\\t  - tests and mutants;\\\\n    44\\\\t  - the $0 release check on stored stores.\\\\n    45\\\\t- **Slice 2, next.** The release page reads only the package: no live service, no `/library` fetch, no translated JSON, no composite\\\\n    46\\\\t  trials, no idea submission control or route. It gets a browser check of the `old-1/v8` screen, which completes D756's screen check.\\\\n    47\\\\t- **No idea submission in the release** (council 74). The idea path (`idea.py`) reads the ledger at every step and calls a paid model\\\\n    48\\\\t  per idea. The design's §5 idea acceptance (an idea card backed only by `v8`, and its composed request) is carried forward as pending\\\\n    49\\\\t  for the first idea-enabled slice.\\\\n    50\\\\t- **Not in scope:**\\\\n    51\\\\t  - the POC, its API, MCP and page (unchanged);\\\\n    52\\\\t  - colleagues' page;\\\\n    53\\\\t  - frozen pieces, extraction included;\\\\n    54\\\\t  - any model call;\\\\n    55\\\\t  - commit, publish, deploy.\\\\n    56\\\\t\\\\n    57\\\\t## 1. What is built\\\\n    58\\\\t\\\\n    59\\\\t`src/hivemind/release.py` is the one owner, beside `service.py`.\\\\n    60\\\\t\\\\n    61\\\\t- **Constants:**\\\\n    62\\\\t  - `FORMAT = 'hivemind-release/1'`;\\\\n    63\\\\t  - `ALLOW_LIST = 'release-allow-list/1'`;\\\\n    64\\\\t  - `FORECAST_UNAVAILABLE = 'Forecast unavailable'`;\\\\n    65\\\\t  - `PACKAGE_FILES = {'manifest.json', 'release-data.json'}`.\\\\n    66\\\\t- **`ALLOWED`:** the closed key set per record type.\\\\n    67\\\\t\\\\n    68\\\\t  | Record | Keys |\\\\n    69\\\\t  |---|---|\\\\n    70\\\\t  | envelope | `format`, `allow_list`, `as_of`, `questions` |\\\\n    71\\\\t  | number question | `id`, `question`, `open`, `class` (= `number`), `forecast` (= the marker), `evidence` |\\\\n    72\\\\t  | event or Yes/No question | `id`, `question`, `open`, `class` (`event` or `yes_no`), `answers` (the two stored rung labels, in position order), `answer` (the stored label of the latest judgement's rung on or before the bound, or null), `evidence` |\\\\n    73\\\\t  | evidence in force at the bound | `id`, `one_line`, `quote`, `tier`, `speaker`, `original_who`, `original_day`, `sources` |\\\\n    74\\\\t  | source recorded on or before the bound | `title`, `publisher`, `day`, `uri` |\\\\n    75\\\\t  | manifest | `format`, `allow_list`, `as_of`, `data_sha256` |\\\\n    76\\\\t\\\\n    77\\\\t- **`question_class(views_db, view_id, labels)`** (design §3):\\\\n    78\\\\t  - `event` when the view key's measure is in `identity.EVENT_MEASURES`. The key is read as `select measure from view_keys`, and\\\\n    79\\\\t    only when the table exists;\\\\n    80\\\\t  - `yes_no` when there are exactly two labels which, through `vocabulary.canonical('label', …)`, are `Yes` and `No` in either order;\\\\n    81\\\\t  - `number` otherwise: a view with no key, or one whose bands cannot be resolved.\\\\n    82\\\\t- **`release_export(views_db, items_db, as_of=None)`:**\\\\n    83\\\\t  - pins both connections (`bundle.read_snapshot`);\\\\n    84\\\\t  - resolves the bound with `service.resolve_bound`, refuses a store with no default day, and validates the bound with\\\\n    85\\\\t    `date.fromisoformat`;\\\\n    86\\\\t  - exports every view that exists at the bound (`service.view_exists`), closed ones included, in `created_seq, rowid` order;\\\\n    87\\\\t  - builds each record field by field from the table above, with column-limited SQL:\\\\n    88\\\\t    - `select view_id, question, created_seq from views order by created_seq, rowid`;\\\\n    89\\\\t    - `select position, label from rungs`;\\\\n    90\\\\t    - `select rung from judgements where view_id=? and publication_day<=? order by judgement_id desc limit 1`;\\\\n    91\\\\t    - `service.is_open_as_of`, which reads only `open` and `after_seq`;\\\\n    92\\\\t  - takes evidence in force from `service.evidence` and its fields from that record;\\\\n    93\\\\t  - looks up each source's `title`, `publisher` and `source_uri` in the items database by `input_id`. A visible source whose item is\\\\n    94\\\\t    missing raises `ReleaseRefused` (there is no fallback to the id);\\\\n    95\\\\t  - calls `check_export` on its own result before returning (AGENTS §3: the writer refuses).\\\\n    96\\\\t- **`check_export(data)`:** the closed-set check.\\\\n    97\\\\t  - Every dict at every level has exactly its record type's keys.\\\\n    98\\\\t  - Value checks:\\\\n    99\\\\t    - `format` and `allow_list` equal the constants, and `as_of` is an ISO date;\\\\n   100\\\\t    - `class` is in its set;\\\\n   101\\\\t    - a number record's `forecast` is the marker;\\\\n   102\\\\t    - `answers` is two strings, and `answer` is one of them or null;\\\\n   103\\\\t    - `open` is a bool and every text field is a string.\\\\n   104\\\\t  - It returns the counts it judged: questions per class, evidence, sources.\\\\n   105\\\\t- **`check_origins(views_db, items_db, data, expected_as_of)`:** the pass condition. It is independent of the exporter's code path.\\\\n   106\\\\t  It derives everything it compares from the store, never from the package.\\\\n   107\\\\t  - **The bound: one rule for both commands.** `expected_as_of` is given by the caller.\\\\n   108\\\\t    - The builder passes the bound it resolved: `service.resolve_bound` on the requested day, or the default when none is given; an\\\\n   109\\\\t      omitted day with no default is refused.\\\\n   110\\\\t    - `check` passes the package's `as_of` through the same `service.resolve_bound`, which refuses a day after a store's last\\\\n   111\\\\t      completed day. A legacy ledger with no completed days accepts any valid date in both commands alike.\\\\n   112\\\\t    - The package's `as_of` must equal `expected_as_of`.\\\\n   113\\\\t  - **The class** of each question is derived from the stored measure and labels (`question_class`). The permitted keys and values\\\\n   114\\\\t    are then chosen from that class, never from the package's `class` field.\\\\n   115\\\\t  - **Order and counts.** The questions are compared as an ordered list in `created_seq, rowid` order, as `bundle.library` orders\\\\n   116\\\\t    them (`old-2/v2` and `v3` share sequence 8). Each question's evidence is compared in link order (`evidence_links.id`), and its\\\\n   117\\\\t    sources in row order (`evidence_sources.id`). A duplicate question, evidence record or source therefore fails.\\\\n   118\\\\t\\\\n   119\\\\t  It compares every field with its permitted stored source at the bound, by direct SQL:\\\\n   120\\\\t  - the question set equals the views visible at the bound, with `question` equal to `views.question`;\\\\n   121\\\\t  - `open` equals the latest visible switch's `open`;\\\\n   122\\\\t  - for `event` and `yes_no`: `answers` equal the rung labels in position order, and `answer` equals the label of the latest judgement\\\\n   123\\\\t    rung on or before the bound, or null;\\\\n   124\\\\t  - for `number`: only the marker;\\\\n   125\\\\t  - the evidence id set equals the links visible at the bound, minus those whose latest replacement is visible, computed in its own\\\\n   126\\\\t    SQL. Each evidence field equals the `evidence` row's column;\\\\n   127\\\\t  - each source list starts from every visible `evidence_sources` row, in row order, with `day` taken from\\\\n   128\\\\t    `evidence_sources.publication_day`. Each row needs a matching `items` row for `title`, `publisher` and `source_uri`; a row with no\\\\n   129\\\\t    item raises `ReleaseRefused` (a left join, so a missing item is never silently dropped).\\\\n   130\\\\t\\\\n   131\\\\t  Any difference raises `ReleaseRefused`, naming the question, the field and the evidence id. It returns the number of fields\\\\n   132\\\\t  compared.\\\\n   133\\\\t- **`claim(out_dir)`:** `os.mkdir(out_dir)`, which is atomic and fails when the path exists. The build owns the empty folder from\\\\n   134\\\\t  then on. A folder that exists, empty or not, is refused before any export. `release(claimed)` removes it with `os.rmdir`, which\\\\n   135\\\\t  succeeds only on an empty folder, so a build can never delete content it did not write.\\\\n   136\\\\t- **`write_package(data, out_dir)`:**\\\\n   137\\\\t  - creates a staging folder with a name unique to this invocation, `tempfile.mkdtemp(dir=out_dir.parent,\\\\n   138\\\\t    prefix='.<name>.staging-')`. Creation is exclusive;\\\\n   139\\\\t  - writes `release-data.json` and `manifest.json` there;\\\\n   140\\\\t  - if a write fails, it removes the staging folder itself and re-raises, because the caller does not yet hold the path;\\\\n   141\\\\t  - returns the staged path. It does not move it.\\\\n   142\\\\t- **`publish_staged(staged, out_dir)`:** `os.rename(staged, out_dir)` onto the build's own claimed folder. On macOS and Linux a rename\\\\n   143\\\\t  replaces only an empty destination directory. If anyone put content into the claimed folder, the rename fails (\\\\\\\"Directory not\\\\n   144\\\\t  empty\\\\\\\") and the build refuses. The move therefore never replaces a folder this build did not create (verified on this Mac:\\\\n   145\\\\t  rename onto an empty folder succeeds; onto a non-empty one, errno 66).\\\\n   146\\\\t- **`check_package(path, views_db=None, items_db=None, expected_as_of=None)`:**\\\\n   147\\\\t  - the directory holds exactly `PACKAGE_FILES`, each a regular file and not a symbolic link (`os.lstat`), with no subdirectories;\\\\n   148\\\\t  - both files parse as JSON with no duplicate member name at any level (an `object_pairs_hook` that refuses a repeated key);\\\\n   149\\\\t  - the manifest has exactly its four keys, and its `format`, `allow_list` and `as_of` equal the data's;\\\\n   150\\\\t  - its sha256 equals the data file's;\\\\n   151\\\\t  - the data passes `check_export`, and, when the stores are given, `check_origins` with the expected bound;\\\\n   152\\\\t  - it returns the counts.\\\\n   153\\\\t- **`withheld_unresolved(views_db, data)`** is for the report only. It lists the number questions whose `service.ladder_bands(rungs)`\\\\n   154\\\\t  returns `(None, reason)`, with the reason and whether the view has a key. Its output never enters the package.\\\\n   155\\\\t\\\\n   156\\\\t`scripts/release_build.py`:\\\\n   157\\\\t- **`build --ledger --items [--as-of] --out`:**\\\\n   158\\\\t  1. resolve the bound once (`service.resolve_bound`, `date.fromisoformat`);\\\\n   159\\\\t  2. `claim(--out)`;\\\\n   160\\\\t  3. `release_export` at that bound;\\\\n   161\\\\t  4. `write_package` to its own staging folder;\\\\n   162\\\\t  5. `check_package` on the staged folder, with the stores and the resolved bound;\\\\n   163\\\\t  6. `publish_staged` onto the claim;\\\\n   164\\\\t  7. write `<out>.report.json` beside the package, through a temporary file and `os.replace`.\\\\n   165\\\\t\\\\n   166\\\\t  The failure outcomes:\\\\n   167\\\\t  - **Before publication** (steps 3–6): on `ReleaseRefused` or an `OSError`, remove the staging folder it created and release its\\\\n   168\\\\t    claim, print the reason and exit 1. No final folder exists, and another build's folders are never touched.\\\\n   169\\\\t  - **After publication** (step 7 fails): the package is final and checked. Exit 2 with \\\\\\\"package published and checked; report not\\\\n   170\\\\t    written; run `check` to regenerate it\\\\\\\".\\\\n   171\\\\t\\\\n   172\\\\t  It has no input path for prepared or translated JSON, and it takes no clock reading; the folder name is the caller's (D12, D13).\\\\n   173\\\\t- **`check <out> --ledger --items`:** re-runs `check_package` on an existing package, with the stores, the package's `as_of`\\\\n   174\\\\t  validated against the store (above), and the regular-file and duplicate-key checks. It leaves the package in place and rewrites\\\\n   175\\\\t  `<out>.report.json`. This is also the retry after a report write failed. Its report gives `check_seconds` and marks\\\\n   176\\\\t  `export_seconds` as not measured.\\\\n   177\\\\t- **The report:**\\\\n   178\\\\t  - the store path and the bound;\\\\n   179\\\\t  - counts per class;\\\\n   180\\\\t  - the unresolved list;\\\\n   181\\\\t  - the fields compared;\\\\n   182\\\\t  - bytes;\\\\n   183\\\\t  - `export_seconds` (build only) and `check_seconds`.\\\\n   184\\\\t\\\\n   185\\\\t## 2. State × event (one export, read-only)\\\\n   186\\\\t\\\\n   187\\\\t| State / event | What happens | What is written | Day used |\\\\n   188\\\\t|---|---|---|---|\\\\n   189\\\\t| Store's first day still in progress | `FirstDayNotCompleted`; the build stops | nothing | none |\\\\n   190\\\\t| Store with no completed day and no judgement, `--as-of` omitted | refused: \\\\\\\"no default day; supply --as-of\\\\\\\" | nothing | none |\\\\n   191\\\\t| `--as-of` not a valid date (`2026-08-99`) | refused by `date.fromisoformat` | nothing | none |\\\\n   192\\\\t| `--as-of` after the last completed day | `BoundNotCompleted`; the build stops | nothing | requested day |\\\\n   193\\\\t| `--as-of` valid, before the first visible question | empty `questions`; the report says 0 | package | bound |\\\\n   194\\\\t| `--as-of` omitted | last completed day (a legacy ledger: its last judgement day) | package | resolved bound |\\\\n   195\\\\t| View created after the bound | not exported | — | bound |\\\\n   196\\\\t| View closed on or before the bound | `open: false`, with no reason and no day | — | bound |\\\\n   197\\\\t| Closed, then reopened, before the bound | the last visible switch wins | — | bound |\\\\n   198\\\\t| Event or Yes/No not yet judged at the bound | `answer: null` | — | bound |\\\\n   199\\\\t| Evidence replaced on or before the bound | excluded; the replacement is in force | — | bound |\\\\n   200\\\\t| Evidence replaced after the bound | kept | — | bound |\\\\n   201\\\\t| Source recorded after the bound | excluded | — | bound |\\\\n   202\\\\t| Visible source with no row in the items database | `ReleaseRefused`, naming the evidence and input id | nothing final | bound |\\\\n   203\\\\t| Store written by a live run | not supported. The builder is given a snapshot (AGENTS §9), and both connections are pinned | — | — |\\\\n   204\\\\t| `--out` exists, empty or not | `claim` refuses before any export | nothing | — |\\\\n   205\\\\t| `check_export`, `check_package` or `check_origins` refuses | this build's staging folder is removed, exit non-zero | nothing final | — |\\\\n   206\\\\t| A write fails inside `write_package` | `write_package` removes its staging folder; the builder releases its claim; exit 1 | nothing final | — |\\\\n   207\\\\t| `OSError` while checking or moving | the staging folder is removed and the claim released; exit 1 | nothing final | — |\\\\n   208\\\\t| Someone writes into the claimed folder during the build | the rename fails (\\\\\\\"Directory not empty\\\\\\\"); staging removed; the claim is not removed because it is not empty; exit 1 | nothing of this build | — |\\\\n   209\\\\t| Crash while staging | the empty claim and a uniquely named staging folder are left. The next build to the same `--out` refuses on the claim until the user removes it | claim and staging only | — |\\\\n   210\\\\t| Crash after the rename, before the report | the package is final and checked; `check` rewrites the report | package | — |\\\\n   211\\\\t| The report write fails after publication | exit 2: the package is final and checked; `check` regenerates the report | package | — |\\\\n   212\\\\t| Two builds aimed at one `--out` | only one `claim` succeeds; the other refuses before any export | the winner's package | — |\\\\n   213\\\\t| Package `as_of` later than the store's last completed day (`check`) | refused by `resolve_bound` | nothing | package `as_of` |\\\\n   214\\\\t| A legacy ledger with no completed days, explicit day | the build and `check` both accept any valid date (one rule) | package | requested day |\\\\n   215\\\\t| A package file is a symbolic link, or a JSON member name repeats | `check_package` refuses | nothing | — |\\\\n   216\\\\t| The package's `class` disagrees with the store's (a Yes/No answer replaced by the marker) | `check_origins` refuses: class is derived from the store | nothing final | bound |\\\\n   217\\\\t| Store or configuration changed between builds | each package records its bound and data sha256; the report names the store path | — | — |\\\\n   218\\\\t| Legacy ledger: no `view_keys` table, `是`/`否` labels | no key, so no event; the labels canonicalise to Yes/No | — | — |\\\\n   219\\\\t\\\\n   220\\\\t## 3. Value × reader\\\\n   221\\\\t\\\\n   222\\\\tReaders of the package:\\\\n   223\\\\t- `check_package` and `check_origins`;\\\\n   224\\\\t- the release page (slice 2);\\\\n   225\\\\t- the tests.\\\\n   226\\\\t\\\\n   227\\\\tThe report's reader is the person building. No POC code imports `release`.\\\\n   228\\\\t\\\\n   229\\\\t| Value | Permitted source at the bound | Checked by |\\\\n   230\\\\t|---|---|---|\\\\n   231\\\\t| `id`, `question` | `views.view_id`, `views.question` | `check_origins` |\\\\n   232\\\\t| `open` | the latest visible `view_switches.open` | `check_origins` |\\\\n   233\\\\t| `class` | `view_keys.measure`, `rungs.label` | `check_origins` derives it from the store; tests and mutants check the identity rule |\\\\n   234\\\\t| `answers`, `answer` | `rungs.label` by position; the latest `judgements.rung` on or before the bound | `check_origins` |\\\\n   235\\\\t| `forecast` | the constant marker | `check_export` |\\\\n   236\\\\t| evidence fields | the `evidence` row; visible `evidence_links` minus visible replacements | `check_origins` |\\\\n   237\\\\t| source fields | every visible `evidence_sources` row (`publication_day` as `day`); its `items` row's `title`, `publisher`, `source_uri`, required | `check_origins` (left join; a missing item refuses) |\\\\n   238\\\\t| manifest | the data's `format`, `allow_list`, `as_of`; the data sha256 | `check_package` |\\\\n   239\\\\t| report (outside the package) | `ladder_bands` per number question; counts | read by the builder's user |\\\\n   240\\\\t\\\\n   241\\\\t**Never read by `release_export`:**\\\\n   242\\\\t- `rungs.condition`, `lo`, `hi`;\\\\n   243\\\\t- `judgements.reasons`, `why_changed`, `implied_outcome`, `reference`, `pushes_json`, `theme_pushes_json`, `cited_*`;\\\\n   244\\\\t- `view_switches.reason`;\\\\n   245\\\\t- `clean_ladders`;\\\\n   246\\\\t- `thesis_groups`;\\\\n   247\\\\t- `dependencies`, `successions`.\\\\n   248\\\\t\\\\n   249\\\\t## 4. New path × old checks\\\\n   250\\\\t\\\\n   251\\\\t| Check on the old path (`bundle.library`, `view_bundle`, `service`) | New path |\\\\n   252\\\\t|---|---|\\\\n   253\\\\t| `resolve_bound`: unfinished first day, future bound | same call |\\\\n   254\\\\t| `bundle.library`: no default day refused; `date.fromisoformat` | same two checks |\\\\n   255\\\\t| A view not visible at the bound is not served | same `view_exists` |\\\\n   256\\\\t| Sources visible at the bound; replacements applied | same `service.evidence`, verified independently by `check_origins` |\\\\n   257\\\\t| Pinned read transaction | same `bundle.read_snapshot` |\\\\n   258\\\\t| `item_lookup` falls back to the id for a missing item | refused instead |\\\\n   259\\\\t| A malformed `clean_ladders` row is refused | not read |\\\\n   260\\\\t| Corrupt judgement JSON is refused | no JSON column read |\\\\n   261\\\\t| The UI contract rejects unknown fields | the release's own `check_export`; the page's reading of it is slice 2 |\\\\n   262\\\\t\\\\n   263\\\\t## 5. Prior decisions\\\\n   264\\\\t\\\\n   265\\\\t- D726: number questions show sources and \\\\\\\"Forecast unavailable\\\\\\\", with band, forecast text and history withheld together.\\\\n   266\\\\t- D756: Alex's choice.\\\\n   267\\\\t- D757: the design, revision 4.\\\\n   268\\\\t- D758: the release is opened; §4 (a); order.\\\\n   269\\\\t- D12/D13: no clock.\\\\n   270\\\\t- D163: English product text.\\\\n   271\\\\t- D690: poc-v118 stays the product.\\\\n   272\\\\t- D261: the ruler is untouched.\\\\n   273\\\\t- D274: the extraction prompt is frozen.\\\\n   274\\\\t\\\\n   275\\\\t## 6. Tests (`tests/test_release.py`) and mutants\\\\n   276\\\\t\\\\n   277\\\\tThe fixtures use a real store on a temporary path (`store.create_view`, `store.insert`), with a real items database. Each test names\\\\n   278\\\\tits row above:\\\\n   279\\\\t1. **Closed set (§1).**\\\\n   280\\\\t   - Every dict in a fixture export has exactly its type's keys.\\\\n   281\\\\t   - Positive control: an export with one added key fails `check_export`.\\\\n   282\\\\t2. **Number with `lo`/`hi`.** The record carries the marker. No rung label, condition, `reasons`, `why_changed` or `implied_outcome` of\\\\n   283\\\\t   that view appears in any decoded package field.\\\\n   284\\\\t3. **Branch fixtures for identity and the report:**\\\\n   285\\\\t   - a condition-only number that resolves: `number`, and absent from `withheld_unresolved`;\\\\n   286\\\\t   - an unresolved number with a key: `number`, and present;\\\\n   287\\\\t   - an unresolved number without a key: `number`, and present.\\\\n   288\\\\t4. **Yes/No with numeric bounds** (`growth_rate` key, labels Yes/No): `yes_no`, with its answer label. A `why_changed` quoting\\\\n   289\\\\t   \\\\\\\"$1 trillion\\\\\\\" is absent.\\\\n   290\\\\t5. **Event with the served ledger's `v49` labels,** \\\\\\\"Restriction adopted\\\\\\\" / \\\\\\\"No restriction adopted\\\\\\\": `event`, with its label kept. A\\\\n   291\\\\t   `why_changed` quoting another question's band is absent.\\\\n   292\\\\t6. **Legacy store** with no `view_keys` table and `是`/`否` labels: `yes_no`.\\\\n   293\\\\t7. **Closing switch** whose reason names the band label: `open: false`, and the reason is absent.\\\\n   294\\\\t8. **Replacement and source visibility** at two bounds. A visible source with a missing item is refused.\\\\n   295\\\\t9. **Package:**\\\\n   296\\\\t   - staged, then checked, passes;\\\\n   297\\\\t   - a foreign file fails, and so does a subdirectory;\\\\n   298\\\\t   - a changed data byte fails;\\\\n   299\\\\t   - an extra manifest key with an unchanged data hash fails;\\\\n   300\\\\t   - a manifest `as_of` differing from the data's fails;\\\\n   301\\\\t   - an existing `--out`, empty or not, is refused, and a leftover staging folder from another build does not block a build.\\\\n   302\\\\t10. **Origin check, each from the store:**\\\\n   303\\\\t    - in a staged copy, the system's forecast text placed in an evidence `one_line` fails, naming the field;\\\\n   304\\\\t    - a Yes/No record turned into a number record, keeping the closed set, fails;\\\\n   305\\\\t    - a duplicated question, and a duplicated evidence record, each fails;\\\\n   306\\\\t    - a package whose `as_of` is a day later than the store's last completed day fails `check`;\\\\n   307\\\\t    - a legacy fixture with no completed days, built at an explicit day, passes a later `check`.\\\\n   308\\\\t11. **Builder end to end,** run as the user calls it (subprocess, `--as-of` omitted). The package is final and passes `check`.\\\\n   309\\\\t12. **Builder refusal, through the real command, on a scratch copy** (the AGENTS §4 mutation procedure; no fake in the suite):\\\\n   310\\\\t    - the unchanged command succeeds on the fixture store (test 11);\\\\n   311\\\\t    - on a scratch copy, the writer fault \\\\\\\"one evidence `one_line` taken from the latest judgement's `why_changed`\\\\\\\" is introduced.\\\\n   312\\\\t      The same command exits 1 with the origin-mismatch reason, no `--out` and no staging folder left;\\\\n   313\\\\t    - on a second scratch copy, the same writer fault plus the builder's staged check removed: the bad package reaches `--out`. That\\\\n   314\\\\t      shows the staged check is what prevents publication.\\\\n   315\\\\t13. **`check` with a missing item.** A finished package. Then a copy of the items database with one referenced item deleted, and a\\\\n   316\\\\t    copy of the package with that same source removed and its manifest hash refreshed. `check` refuses, naming the missing item. (An\\\\n   317\\\\t    inner-join mutant accepts this pair, so this case catches it.)\\\\n   318\\\\t14. **Two builds aimed at one `--out`, overlapping.** The test calls the module steps directly.\\\\n   319\\\\t    - Build A claims and stages, and has not published.\\\\n   320\\\\t    - Build B's `claim` refuses while A holds its claim, before B exports anything.\\\\n   321\\\\t    - A publishes. Its package passes `check`, and B removed nothing.\\\\n   322\\\\t    - A third case puts an empty folder at `--out` before any claim: refused.\\\\n   323\\\\t    - A fourth case writes a file into A's claimed folder before A publishes: A's rename fails, A exits 1, the foreign file stays.\\\\n   324\\\\t15. **Files:**\\\\n   325\\\\t    - a symbolic link in place of `release-data.json` fails;\\\\n   326\\\\t    - a data file whose repeated `one_line` member has the genuine value last, with the manifest hash refreshed so every other\\\\n   327\\\\t      check passes, fails on the repeated name.\\\\n   328\\\\t16. **Bound validation:** `2026-08-99` refused; a valid day before the first question gives an empty package.\\\\n   329\\\\t\\\\n   330\\\\t**Mutants,** on a scratch copy with `PYTHONDONTWRITEBYTECODE=1`; each must fail a test:\\\\n   331\\\\t- `condition` emitted on number records;\\\\n   332\\\\t- `one_line` taken from the latest judgement's `why_changed`;\\\\n   333\\\\t- the event test removed;\\\\n   334\\\\t- the Yes/No test removed;\\\\n   335\\\\t- `check_package` without the file-set check;\\\\n   336\\\\t- manifest keys unchecked;\\\\n   337\\\\t- `check_export` without the closed-key check;\\\\n   338\\\\t- `check_origins` skipping evidence fields;\\\\n   339\\\\t- `check_origins` taking the class from the package;\\\\n   340\\\\t- `check_origins` comparing sets instead of ordered lists;\\\\n   341\\\\t- `check_origins` with an inner join to `items`;\\\\n   342\\\\t- `check` without validating the package's `as_of` against the store;\\\\n   343\\\\t- the builder skipping the staged `check_package` (the scratch-copy pair in test 12);\\\\n   344\\\\t- `claim` replaced by an existence check;\\\\n   345\\\\t- the symbolic-link check removed;\\\\n   346\\\\t- the duplicate-key check removed;\\\\n   347\\\\t- the switch reason emitted;\\\\n   348\\\\t- the missing-item refusal replaced by the id fallback.\\\\n   349\\\\t\\\\n   350\\\\t## 7. The $0 release check (stored stores, read-only)\\\\n   351\\\\t\\\\n   352\\\\tStores: `old-1`, `old-2`, `old-3` (`comparison-2026-11-17/run/old-N/prod/views.sqlite`, items `items-comparison.sqlite`) and the\\\\n   353\\\\tserved ledger with its items database.\\\\n   354\\\\t\\\\n   355\\\\t**Budgets,** set before the first control (AGENTS §2):\\\\n   356\\\\t- the package's data bytes at most `bundle.library`'s JSON bytes on the same store and bound;\\\\n   357\\\\t- export plus all checks at most three times `bundle.library`'s seconds on the same store, and at most 120 s per store.\\\\n   358\\\\t\\\\n   359\\\\tThe steps:\\\\n   360\\\\t1. **Build each store's package at its default bound.** The build passes `check_package` with `check_origins`. Report the fields\\\\n   361\\\\t   compared, the counts per class and the unresolved list.\\\\n   362\\\\t2. **The decisive acceptance case** (council 74), on the `old-1` package:\\\\n   363\\\\t   - Morningstar's `$361 billion` estimate (`e2295`) is kept, its summary and quote equal to the stored ones;\\\\n   364\\\\t   - the genuine \\\\\\\"Bullish confirmation\\\\\\\" quote (`e1865`) is kept;\\\\n   365\\\\t   - the genuine analyst \\\\\\\"$390 billion\\\\\\\" quote (`e3597`) is kept, as the control;\\\\n   366\\\\t   - in a copy of the staged package, the system's `old-1` j1580 `implied_outcome` (\\\\\\\"About $390 billion…\\\\\\\") substituted into\\\\n   367\\\\t     `e2295`'s summary fails `check_origins`;\\\\n   368\\\\t   - the same text added to the manifest fails `check_package`.\\\\n   369\\\\t3. **`old-1/v8`:** `class` is `number`, with the marker and the same evidence ids as `service.evidence` at the bound.\\\\n   370\\\\t4. **The known event leaks at their own dates.** Export `old-3` at 2026-08-25 (`v36` j799 is the latest judgement) and `old-1` at\\\\n   371\\\\t   2026-08-28 (`v10` j865). Each keeps its original answer label, and j799's \\\\\\\"around $1 trillion\\\\\\\" text and j865's band text are absent.\\\\n   372\\\\t5. **Control:** one unchanged event question keeps its label and evidence.\\\\n   373\\\\t6. **Closing.** On a temporary copy of `old-1`, add a closing switch for `v8` in the store's own format (\\\\\\\"due …, frozen on … at\\\\n   374\\\\t   rung N <label>\\\\\\\"). First confirm that `bundle.view_bundle` exposes the reason with the band label. Then confirm the package shows\\\\n   375\\\\t   `open: false` and not the reason.\\\\n   376\\\\t7. **Diagnostics** (not the gate). For every question, take each string the package must not hold:\\\\n   377\\\\t   - rung labels and conditions;\\\\n   378\\\\t   - judgement `reasons` and `why_changed`, and `implied_outcome` and `reference` where the store has those columns (the served\\\\n   379\\\\t     ledger has neither; the report says so);\\\\n   380\\\\t   - switch reasons.\\\\n   381\\\\t\\\\n   382\\\\t   Search every decoded string field of the package for each, with no floor. List every hit with its question, field, evidence id\\\\n   383\\\\t   and the stored string it matched, and read each by hand. A genuine source quote, such as `e1865`'s \\\\\\\"Bullish\\\\\\\", is recorded as such.\\\\n   384\\\\t8. **Budgets:** bytes and seconds against the budgets above.\\\\n   385\\\\t\\\\n   386\\\\t## 8. A disclosed property, not built: evidence summaries keep extraction's wording\\\\n   387\\\\t\\\\n   388\\\\tThe release shows each evidence summary as extraction stored it; the release computes or converts nothing. A summary can make\\\\n   389\\\\tcontext explicit or restate a source figure by arithmetic, attributed to its source: `old-1/e3238` gives \\\\\\\"more than $40 billion in\\\\n   390\\\\tFY2028\\\\\\\" for a quote's \\\\\\\"more than double that next year\\\\\\\".\\\\n   391\\\\t- **Measured:** 25.6%, 25.2% and 25.4% of evidence in force in `old-1`, `old-2` and `old-3`, and 35.0% in the served ledger, carry a\\\\n   392\\\\t  number not in their quote. In a sample of 24, 23 are context: a year, a date, a quarter, a product name, an amount from the previous\\\\n   393\\\\t  sentence. One restates \\\\\\\"close to doubling\\\\\\\" as \\\\\\\"nearly 100%\\\\\\\".\\\\n   394\\\\t- **Why this is not the forecast D726 withholds.** Extraction never sees the system's forecast. Its request lists each open question\\\\n   395\\\\t  only as id, object, due day, question and a \\\\\\\"takes\\\\\\\" line (`placement.py:19-61`, `extraction.py:398-400`); no rung, label or\\\\n   396\\\\t  judged position.\\\\n   397\\\\t- **Council 74b** (`codex-r74b.md` §2) verified that extraction sends no rung, label or judged position, and that the census\\\\n   398\\\\t  reproduces.\\\\n   399\\\\t- **The disagreement that remains is narrow.**\\\\n   400\\\\t  - Codex reads revision 4's \\\\\\\"amounts as quoted\\\\\\\" as requiring source wording for a calculated amount attributed to a source, such\\\\n   401\\\\t    as `e3238`'s \\\\\\\"more than $40 billion\\\\\\\".\\\\n   402\\\\t  - Claude reads it as \\\\\\\"the release computes or converts nothing\\\\\\\".\\\\n   403\\\\t  - Both agree: no digit filter, no change to extraction.\\\\n   404\\\\t- **The course taken.** By AGENTS' rule for an unsettled disagreement, the cheaper, reversible course is to keep the stored summary.\\\\n   405\\\\t  The quote is shown beside it, so the source wording is on the reader's screen. A later version can drop the field from the\\\\n   406\\\\t  allow-list or change it.\\\\n\\\",\\\"exit_code\\\":0,\\\"status\\\":\\\"completed\\\"}}\\ndocs/research/2026-11-22-number-answers/codex-r74.stream:11:{\\\"type\\\":\\\"item.completed\\\",\\\"item\\\":{\\\"id\\\":\\\"item_4\\\",\\\"type\\\":\\\"command_execution\\\",\\\"command\\\":\\\"/opt/homebrew/bin/zsh -lc 'nl -ba docs/research/2026-11-22-number-answers/RELEASE-BUILD.md'\\\",\\\"aggregated_output\\\":\\\"     1\\\\t# \\\\\\\"Forecast unavailable\\\\\\\" release: build design for slice 1 (the exporter and the checked package)\\\\n     2\\\\t\\\\n     3\\\\t**Status: design for review (council round 74). No code yet.** Release work was opened by the council under D439 (D758). The\\\\n     4\\\\tbehaviour is fixed by D726, D756 and `FORECAST-UNAVAILABLE-DESIGN.md` (revision 4). This page holds the AGENTS §2 tables for the first\\\\n     5\\\\tslice.\\\\n     6\\\\t\\\\n     7\\\\t## 0. Scope\\\\n     8\\\\t\\\\n     9\\\\t- **Slice 1 (this page), $0.**\\\\n    10\\\\t  - The exporter `release_export`, its self-check, the package writer and the package check.\\\\n    11\\\\t  - The release builder, which calls the exporter directly.\\\\n    12\\\\t  - Tests and mutants.\\\\n    13\\\\t  - The $0 release check on stored stores.\\\\n    14\\\\t- **Slice 2, next.** The release page reads only the package: no live service, no `/library` fetch, no translated JSON, no composite\\\\n    15\\\\t  trials. It gets a browser check of the `old-1/v8` screen. This completes D756's screen check.\\\\n    16\\\\t- **Proposed for round 74: no idea submission in the release.** Today the idea path (`idea.py`) reads the ledger at every step:\\\\n    17\\\\t  - `judged`, `brief`, `related_views`;\\\\n    18\\\\t  - `service.evaluate` against the ladder;\\\\n    19\\\\t  - `idea_composite.add_ladders` and the composite's endpoints.\\\\n    20\\\\t\\\\n    21\\\\t  It also calls a paid model per idea, so it needs a running service. A static release can offer no idea input at all, which fails\\\\n    22\\\\t  closed. An export-only idea path is a later slice with its own design. The design's §5 idea acceptance (an idea card backed only\\\\n    23\\\\t  by `v8`) moves to that slice.\\\\n    24\\\\t- **Not in scope:**\\\\n    25\\\\t  - the POC, its API, MCP and page (unchanged);\\\\n    26\\\\t  - colleagues' page;\\\\n    27\\\\t  - frozen pieces;\\\\n    28\\\\t  - any model call;\\\\n    29\\\\t  - commit, publish, deploy.\\\\n    30\\\\t\\\\n    31\\\\t## 1. What is built\\\\n    32\\\\t\\\\n    33\\\\t`src/hivemind/release.py` (one owner, beside `service.py`):\\\\n    34\\\\t\\\\n    35\\\\t- **Constants:**\\\\n    36\\\\t  - `FORMAT = 'hivemind-release/1'`;\\\\n    37\\\\t  - `ALLOW_LIST = 'release-allow-list/1'`;\\\\n    38\\\\t  - `FORECAST_UNAVAILABLE = 'Forecast unavailable'`.\\\\n    39\\\\t- **`ALLOWED`:** the closed key set per record type.\\\\n    40\\\\t\\\\n    41\\\\t  | Record | Keys |\\\\n    42\\\\t  |---|---|\\\\n    43\\\\t  | envelope | `format`, `allow_list`, `as_of`, `questions` |\\\\n    44\\\\t  | number question | `id`, `object`, `kind`, `question`, `open`, `class` (= `number`), `forecast` (= the marker), `evidence` |\\\\n    45\\\\t  | event or Yes/No question | `id`, `object`, `kind`, `question`, `open`, `class` (`event` or `yes_no`), `answers` (the two stored labels, in rung order), `answer` (the stored label of the latest judgement on or before `as_of`, or null), `evidence` |\\\\n    46\\\\t  | evidence (in force at `as_of`) | `id`, `one_line`, `quote`, `tier`, `speaker`, `original_who`, `original_day`, `sources` |\\\\n    47\\\\t  | source (recorded on or before `as_of`) | `title`, `publisher`, `day`, `uri` |\\\\n    48\\\\t\\\\n    49\\\\t- **`question_class(conn, view_id, rungs)`** (§3 of the design):\\\\n    50\\\\t  - `event` when the view key's measure is in `identity.EVENT_MEASURES`;\\\\n    51\\\\t  - `yes_no` when there are exactly two rung labels which, through `vocabulary.canonical('label', …)`, are `Yes` and `No` in either\\\\n    52\\\\t    order;\\\\n    53\\\\t  - `number` otherwise. That includes a view with no key, and one whose bands cannot be resolved.\\\\n    54\\\\t- **`release_export(views_db, items_db, as_of=None)`:**\\\\n    55\\\\t  - pins both connections (`bundle.read_snapshot`);\\\\n    56\\\\t  - resolves the bound with `service.resolve_bound`, which refuses an unfinished first day or a future bound;\\\\n    57\\\\t  - exports every view that exists at the bound, closed ones included, in `created_seq` order;\\\\n    58\\\\t  - builds each record field by field from the table above, never by copying a row or a bundle;\\\\n    59\\\\t  - takes evidence from `service.evidence(conn, view_id, as_of)` (in force, replacements applied, sources visible at the bound);\\\\n    60\\\\t  - takes source text from `bundle.item_lookup`;\\\\n    61\\\\t  - calls `check_export` on its own result before returning, so the writer refuses an off-list field (AGENTS §3).\\\\n    62\\\\t- **`check_export(data)`:** the closed-set check.\\\\n    63\\\\t  - Every dict at every level has exactly its record type's keys; any other key fails.\\\\n    64\\\\t  - Value checks: `format` and `allow_list` equal the constants; `class` is in its set; a number record's `forecast` is the marker;\\\\n    65\\\\t    `answers` is two strings and `answer` is one of them or null; `open` is a bool; strings are strings.\\\\n    66\\\\t  - It returns the counts it judged: questions per class, evidence, sources.\\\\n    67\\\\t- **`write_package(data, out_dir)`:**\\\\n    68\\\\t  - refuses an existing `out_dir`;\\\\n    69\\\\t  - writes `release-data.json` and `manifest.json` (`format`, `allow_list`, `as_of`, the data file's sha256) into a temporary\\\\n    70\\\\t    sibling, then renames it into place, so a crash leaves no half package.\\\\n    71\\\\t- **`check_package(out_dir)`:**\\\\n    72\\\\t  - the directory holds exactly `{manifest.json, release-data.json}` (slice 2 adds the page), with no subdirectories;\\\\n    73\\\\t  - the manifest's sha256 matches the data file;\\\\n    74\\\\t  - the data passes `check_export`;\\\\n    75\\\\t  - it returns the counts.\\\\n    76\\\\t- **`withheld_unresolved(views_db, data)`:** for the release check report only. It lists the number questions whose ladder does not\\\\n    77\\\\t  resolve (`service.ladder_bands` returns None), with or without a key. They are withheld like every number question (design §3).\\\\n    78\\\\t\\\\n    79\\\\t`scripts/release_build.py --ledger --items [--as-of] --out`:\\\\n    80\\\\t- calls `release.release_export` directly; there is no input path for prepared or translated JSON;\\\\n    81\\\\t- then `write_package`, then `check_package`;\\\\n    82\\\\t- prints the counts and the unresolved list, and writes the same report to `<out>.report.json` beside the package, never inside it;\\\\n    83\\\\t- takes no clock reading. The folder name is the caller's (D12, D13).\\\\n    84\\\\t\\\\n    85\\\\t## 2. State × event (one export, read-only)\\\\n    86\\\\t\\\\n    87\\\\t| State / event | What happens | What is written | Day used |\\\\n    88\\\\t|---|---|---|---|\\\\n    89\\\\t| Store's first day still in progress | `resolve_bound` raises `FirstDayNotCompleted`; the build stops | nothing | none |\\\\n    90\\\\t| `--as-of` after the last completed day | `BoundNotCompleted`; the build stops | nothing | the requested day |\\\\n    91\\\\t| `--as-of` omitted | the last completed day (a legacy ledger: its last judgement day) | package | resolved bound |\\\\n    92\\\\t| View created after the bound | not exported | — | bound |\\\\n    93\\\\t| View closed on or before the bound | `open: false`; no reason and no closing day | — | bound (`is_open_as_of`) |\\\\n    94\\\\t| Closed, then reopened, before the bound | the last visible switch wins | — | bound |\\\\n    95\\\\t| Event or Yes/No not yet judged at the bound | `answer: null` | — | bound |\\\\n    96\\\\t| Evidence replaced on or before the bound | excluded; the replacement is in force | — | bound |\\\\n    97\\\\t| Evidence replaced after the bound | kept | — | bound |\\\\n    98\\\\t| Source recorded after the bound | excluded from `sources` | — | bound |\\\\n    99\\\\t| Store being written by a live run | not supported: the builder is given a snapshot (AGENTS §9); both connections are pinned for the export | — | — |\\\\n   100\\\\t| `out_dir` exists | refused before any write | nothing | — |\\\\n   101\\\\t| Crash midway through writing | the temporary sibling is left; `out_dir` does not exist | temp folder only | — |\\\\n   102\\\\t| Two builds of one store | each needs a new folder; the second never overwrites | — | — |\\\\n   103\\\\t| Configuration or store changed between builds | each package records its `as_of` and the data sha256; the report names the store path | — | — |\\\\n   104\\\\t| Legacy ledger: no `view_keys`, Chinese labels | no key, so no event; `是`/`否` canonicalise to Yes/No | — | — |\\\\n   105\\\\t| Off-list key reaches the record | `check_export` raises inside `release_export`; nothing is written | nothing | — |\\\\n   106\\\\t\\\\n   107\\\\t## 3. Value × reader\\\\n   108\\\\t\\\\n   109\\\\tReaders of the package:\\\\n   110\\\\t- `check_package`;\\\\n   111\\\\t- the release page (slice 2);\\\\n   112\\\\t- the tests.\\\\n   113\\\\t\\\\n   114\\\\tNo POC reader reads it: no service, MCP, `bundle` or `idea` code imports `release`.\\\\n   115\\\\t\\\\n   116\\\\t| Value | Source (table.column) | Note |\\\\n   117\\\\t|---|---|---|\\\\n   118\\\\t| `id`, `object`, `kind`, `question` | `views.view_id`, `object_id`, `kind`, `question` | `question` is allowed by D726 |\\\\n   119\\\\t| `open` | `view_switches.open` via `service.is_open_as_of` | `reason` never read |\\\\n   120\\\\t| `class` | `view_keys.measure`, `rungs.label` | identity only |\\\\n   121\\\\t| `answers`, `answer` | `rungs.label`; the latest `judgements.rung` on or before the bound | non-number only |\\\\n   122\\\\t| evidence fields | `evidence.*`, `evidence_links`, `replacements` via `service.evidence` | sources recorded and visible at the bound |\\\\n   123\\\\t| source fields | `evidence_sources.publication_day`; items `title`, `publisher`, `source_uri` | — |\\\\n   124\\\\t\\\\n   125\\\\t**Never read** by `release_export`:\\\\n   126\\\\t- `rungs.condition`, `lo`, `hi`;\\\\n   127\\\\t- `judgements.reasons`, `why_changed`, `pushes_json`, `theme_pushes_json`, `cited_*`;\\\\n   128\\\\t- `view_switches.reason`;\\\\n   129\\\\t- `clean_ladders`;\\\\n   130\\\\t- `thesis_groups`;\\\\n   131\\\\t- `dependencies`, `successions`;\\\\n   132\\\\t- every count and every date of a judgement.\\\\n   133\\\\t\\\\n   134\\\\tThe one exception is `judgements.rung` for non-number questions. The report-only `withheld_unresolved` reads rungs, but its output\\\\n   135\\\\tnever enters the package.\\\\n   136\\\\t\\\\n   137\\\\t## 4. New path × old checks\\\\n   138\\\\t\\\\n   139\\\\t| Check on the old path (`bundle.view_bundle`, `service`) | New path |\\\\n   140\\\\t|---|---|\\\\n   141\\\\t| `resolve_bound`: unfinished first day, future bound | same call |\\\\n   142\\\\t| A view not visible at the bound is not served | same `view_exists` |\\\\n   143\\\\t| Sources visible at the bound; replacements applied | same `service.evidence` |\\\\n   144\\\\t| Pinned read transaction for a complete envelope | same `bundle.read_snapshot` |\\\\n   145\\\\t| A malformed `clean_ladders` row is refused | not read: no new failure mode |\\\\n   146\\\\t| Corrupt judgement JSON is refused (`LedgerError`) | no JSON column read |\\\\n   147\\\\t| The UI contract rejects unknown fields (`thesis-ui/2`) | the release has its own contract (`check_export`); the page's reading of it is slice 2 |\\\\n   148\\\\t\\\\n   149\\\\t## 5. Prior decisions\\\\n   150\\\\t\\\\n   151\\\\t- D726: number questions show sources and \\\\\\\"Forecast unavailable\\\\\\\"; band, forecast text and history withheld together.\\\\n   152\\\\t- D756: Alex's choice.\\\\n   153\\\\t- D757: the design, revision 4.\\\\n   154\\\\t- D758: the release is opened; §4 (a); order.\\\\n   155\\\\t- D12/D13: no clock.\\\\n   156\\\\t- D163: English product text. Stored labels are emitted as stored; a legacy Chinese ledger is not a release input.\\\\n   157\\\\t- D690: poc-v118 stays the product.\\\\n   158\\\\t- D261: the ruler is untouched.\\\\n   159\\\\t\\\\n   160\\\\t## 6. Tests (`tests/test_release.py`) and mutants\\\\n   161\\\\t\\\\n   162\\\\tThe fixtures use a real store on a temporary path, built with `store.create_view` and `store.insert`. Each test names its row above:\\\\n   163\\\\t1. **Allow-list (§1):**\\\\n   164\\\\t   - every dict in a fixture export has exactly its type's keys;\\\\n   165\\\\t   - positive control: an export with one added key fails `check_export`.\\\\n   166\\\\t2. **Number with `lo`/`hi`.** The record carries the marker. The serialized export contains no rung label, condition, judgement reason\\\\n   167\\\\t   or `why_changed` text of that view. This is the decisive assertion.\\\\n   168\\\\t3. **Number with bounds only in its conditions** (no key): `number`.\\\\n   169\\\\t4. **Unresolved number with a key** (a money measure, no bounds, unreadable conditions): `number`, and listed by\\\\n   170\\\\t   `withheld_unresolved`.\\\\n   171\\\\t5. **Yes/No with numeric bounds** (`growth_rate`, labels Yes/No). Its answer label is shown. Its `why_changed` quoting \\\\\\\"$1 trillion\\\\\\\" is\\\\n   172\\\\t   absent.\\\\n   173\\\\t6. **Event:** the label is kept. A `why_changed` quoting another question's band is absent.\\\\n   174\\\\t7. **Closing switch** whose reason names the band label: `open: false`, and the reason is absent.\\\\n   175\\\\t8. **Replacement and source visibility** at two bounds.\\\\n   176\\\\t9. **Package:**\\\\n   177\\\\t   - write, then check, passes;\\\\n   178\\\\t   - a foreign file fails, and so does a subdirectory;\\\\n   179\\\\t   - a changed data byte fails the sha check;\\\\n   180\\\\t   - an existing `out_dir` is refused.\\\\n   181\\\\t10. **Builder end to end,** run as the user calls it (subprocess, `--as-of` omitted) on the fixture store. The package passes the\\\\n   182\\\\t    check and the report lists the unresolved view.\\\\n   183\\\\t11. **Legacy labels** `是`/`否`: `yes_no`.\\\\n   184\\\\t\\\\n   185\\\\t**Mutants,** run on a scratch copy with `PYTHONDONTWRITEBYTECODE=1`; each must fail a test:\\\\n   186\\\\t- an off-list field emitted (`condition` on a number record);\\\\n   187\\\\t- the event test removed;\\\\n   188\\\\t- the Yes/No test removed;\\\\n   189\\\\t- `check_package` without the file-set check;\\\\n   190\\\\t- `check_export` without the closed-key check;\\\\n   191\\\\t- the switch reason emitted.\\\\n   192\\\\t\\\\n   193\\\\t## 7. The $0 release check (stored stores, read-only)\\\\n   194\\\\t\\\\n   195\\\\tStores: `old-1`, `old-2`, `old-3` (`comparison-2026-11-17/run/old-N/prod/views.sqlite`, items `items-comparison.sqlite`) and the\\\\n   196\\\\tserved ledger.\\\\n   197\\\\t1. **Whole-store leak sweep.** For every view, collect the strings the package must not hold:\\\\n   198\\\\t   - for a number question: rung labels and conditions, judgement `reasons` and `why_changed`, switch reasons;\\\\n   199\\\\t   - for any other question: judgement `reasons` and `why_changed`, switch reasons.\\\\n   200\\\\t\\\\n   201\\\\t   Search the serialized export for each string of at least 12 characters, then report how many strings were judged and every hit,\\\\n   202\\\\t   read by hand.\\\\n   203\\\\t2. **`old-1/v8`.** The record has the marker and the same evidence ids and sources as `service.evidence` at the bound. None of its 5\\\\n   204\\\\t   labels, its 75 judgements' texts or its band is in the package.\\\\n   205\\\\t3. **`old-3/v36` (j799) and `old-1/v10` (j865).** Labels kept; the \\\\\\\"around $1 trillion\\\\\\\" text and j865's band text absent.\\\\n   206\\\\t4. **Control.** One unchanged event question keeps its label and evidence.\\\\n   207\\\\t5. **Closing.** On a temporary copy of `old-1`, add a real closing switch for `v8` in the store's own reason format (\\\\\\\"due …, frozen\\\\n   208\\\\t   on … at rung N <label>\\\\\\\"). First confirm that `bundle.view_bundle` exposes the band there, then confirm the package does not.\\\\n   209\\\\t6. **Size and speed:** export bytes and seconds against `bundle.library` on the same store.\\\\n   210\\\\t\\\\n   211\\\\t## 8. Open for round 74\\\\n   212\\\\t\\\\n   213\\\\t1. **The idea path:** none in the release (§0)? Or must slice 1 include an export-only idea path?\\\\n   214\\\\t2. **`object` and `kind` on every record.** They are not in the design's list (\\\\\\\"the question and its id\\\\\\\"). They are identity, not a\\\\n   215\\\\t   forecast, and the library groups by object. Keep them, or drop them?\\\\n   216\\\\t3. **Research groups** (`thesis_groups`: model-written names and scopes) are left out. Is that right for slice 1?\\\\n   217\\\\t4. **The leak sweep's 12-character floor.** Is it right, and is any string class missing from the sweep?\\\\n\\\",\\\"exit_code\\\":0,\\\"status\\\":\\\"completed\\\"}}\\ndocs/research/2026-11-22-number-answers/codex-r74.stream:25:{\\\"type\\\":\\\"item.started\\\",\\\"item\\\":{\\\"id\\\":\\\"item_13\\\",\\\"type\\\":\\\"command_execution\\\",\\\"command\\\":\\\"/opt/homebrew/bin/zsh -lc \\\\\\\"rg --files -uuu poc/data | rg '(views\\\\\\\\\\\\\\\\.sqlite\\\\\\\"'$|items-comparison'\\\\\\\"\\\\\\\\\\\\\\\\.sqlite\\\\\\\"'$)'\\\\\\\"' | rg 'comparison-2026-11-17|/served|\\\\\\\"'^poc/data/views'\\\\\\\"'; rg -n 'served ledger|served store' docs/CURRENT_STATE.md docs/research/2026-11-22-number-answers | head -n 35\\\\\\\"\\\",\\\"aggregated_output\\\":\\\"\\\",\\\"exit_code\\\":null,\\\"status\\\":\\\"in_progress\\\"}}\\ndocs/research/2026-11-22-number-answers/codex-r74.stream:26:{\\\"type\\\":\\\"item.completed\\\",\\\"item\\\":{\\\"id\\\":\\\"item_13\\\",\\\"type\\\":\\\"command_execution\\\",\\\"command\\\":\\\"/opt/homebrew/bin/zsh -lc \\\\\\\"rg --files -uuu poc/data | rg '(views\\\\\\\\\\\\\\\\.sqlite\\\\\\\"'$|items-comparison'\\\\\\\"\\\\\\\\\\\\\\\\.sqlite\\\\\\\"'$)'\\\\\\\"' | rg 'comparison-2026-11-17|/served|\\\\\\\"'^poc/data/views'\\\\\\\"'; rg -n 'served ledger|served store' docs/CURRENT_STATE.md docs/research/2026-11-22-number-answers | head -n 35\\\\\\\"\\\",\\\"aggregated_output\\\":\\\"poc/data/comparison-2026-11-17/run/new-2/judge/draw-new-2/views.sqlite\\\\npoc/data/comparison-2026-11-17/run/new-3/judge/draw-new-3/views.sqlite\\\\npoc/data/comparison-2026-11-17/run/old-2/prod/views.sqlite\\\\npoc/data/comparison-2026-11-17/run/old-3/prod/views.sqlite\\\\npoc/data/comparison-2026-11-17/run/old-1/prod/views.sqlite\\\\npoc/data/comparison-2026-11-17/slice-2/s-new/judge/draw-s-new/views.sqlite\\\\npoc/data/comparison-2026-11-17/slice-2/s-old/prod/views.sqlite\\\\npoc/data/comparison-2026-11-17/items-comparison.sqlite\\\\npoc/data/comparison-2026-11-17/slice/s-old/prod/views.sqlite\\\\npoc/data/views.sqlite\\\\npoc/data/served-2026-10-28-v34-nvda-3m-through-0828/views.sqlite\\\\ndocs/research/2026-11-22-number-answers/codex-r74.stream:11:{\\\\\\\"type\\\\\\\":\\\\\\\"item.completed\\\\\\\",\\\\\\\"item\\\\\\\":{\\\\\\\"id\\\\\\\":\\\\\\\"item_4\\\\\\\",\\\\\\\"type\\\\\\\":\\\\\\\"command_execution\\\\\\\",\\\\\\\"command\\\\\\\":\\\\\\\"/opt/homebrew/bin/zsh -lc 'nl -ba docs/research/2026-11-22-number-answers/RELEASE-BUILD.md'\\\\\\\",\\\\\\\"aggregated_output\\\\\\\":\\\\\\\"     1\\\\\\\\t# \\\\\\\\\\\\\\\"Forecast unavailable\\\\\\\\\\\\\\\" release: build design for slice 1 (the exporter and the checked package)\\\\\\\\n     2\\\\\\\\t\\\\\\\\n     3\\\\\\\\t**Status: design for review (council round 74). No code yet.** Release work was opened by the council under D439 (D758). The\\\\\\\\n     4\\\\\\\\tbehaviour is fixed by D726, D756 and `FORECAST-UNAVAILABLE-DESIGN.md` (revision 4). This page holds the AGENTS §2 tables for the first\\\\\\\\n     5\\\\\\\\tslice.\\\\\\\\n     6\\\\\\\\t\\\\\\\\n     7\\\\\\\\t## 0. Scope\\\\\\\\n     8\\\\\\\\t\\\\\\\\n     9\\\\\\\\t- **Slice 1 (this page), $0.**\\\\\\\\n    10\\\\\\\\t  - The exporter `release_export`, its self-check, the package writer and the package check.\\\\\\\\n    11\\\\\\\\t  - The release builder, which calls the exporter directly.\\\\\\\\n    12\\\\\\\\t  - Tests and mutants.\\\\\\\\n    13\\\\\\\\t  - The $0 release check on stored stores.\\\\\\\\n    14\\\\\\\\t- **Slice 2, next.** The release page reads only the package: no live service, no `/library` fetch, no translated JSON, no composite\\\\\\\\n    15\\\\\\\\t  trials. It gets a browser check of the `old-1/v8` screen. This completes D756's screen check.\\\\\\\\n    16\\\\\\\\t- **Proposed for round 74: no idea submission in the release.** Today the idea path (`idea.py`) reads the ledger at every step:\\\\\\\\n    17\\\\\\\\t  - `judged`, `brief`, `related_views`;\\\\\\\\n    18\\\\\\\\t  - `service.evaluate` against the ladder;\\\\\\\\n    19\\\\\\\\t  - `idea_composite.add_ladders` and the composite's endpoints.\\\\\\\\n    20\\\\\\\\t\\\\\\\\n    21\\\\\\\\t  It also calls a paid model per idea, so it needs a running service. A static release can offer no idea input at all, which fails\\\\\\\\n    22\\\\\\\\t  closed. An export-only idea path is a later slice with its own design. The design's §5 idea acceptance (an idea card backed only\\\\\\\\n    23\\\\\\\\t  by `v8`) moves to that slice.\\\\\\\\n    24\\\\\\\\t- **Not in scope:**\\\\\\\\n    25\\\\\\\\t  - the POC, its API, MCP and page (unchanged);\\\\\\\\n    26\\\\\\\\t  - colleagues' page;\\\\\\\\n    27\\\\\\\\t  - frozen pieces;\\\\\\\\n    28\\\\\\\\t  - any model call;\\\\\\\\n    29\\\\\\\\t  - commit, publish, deploy.\\\\\\\\n    30\\\\\\\\t\\\\\\\\n    31\\\\\\\\t## 1. What is built\\\\\\\\n    32\\\\\\\\t\\\\\\\\n    33\\\\\\\\t`src/hivemind/release.py` (one owner, beside `service.py`):\\\\\\\\n    34\\\\\\\\t\\\\\\\\n    35\\\\\\\\t- **Constants:**\\\\\\\\n    36\\\\\\\\t  - `FORMAT = 'hivemind-release/1'`;\\\\\\\\n    37\\\\\\\\t  - `ALLOW_LIST = 'release-allow-list/1'`;\\\\\\\\n    38\\\\\\\\t  - `FORECAST_UNAVAILABLE = 'Forecast unavailable'`.\\\\\\\\n    39\\\\\\\\t- **`ALLOWED`:** the closed key set per record type.\\\\\\\\n    40\\\\\\\\t\\\\\\\\n    41\\\\\\\\t  | Record | Keys |\\\\\\\\n    42\\\\\\\\t  |---|---|\\\\\\\\n    43\\\\\\\\t  | envelope | `format`, `allow_list`, `as_of`, `questions` |\\\\\\\\n    44\\\\\\\\t  | number question | `id`, `object`, `kind`, `question`, `open`, `class` (= `number`), `forecast` (= the marker), `evidence` |\\\\\\\\n    45\\\\\\\\t  | event or Yes/No question | `id`, `object`, `kind`, `question`, `open`, `class` (`event` or `yes_no`), `answers` (the two stored labels, in rung order), `answer` (the stored label of the latest judgement on or before `as_of`, or null), `evidence` |\\\\\\\\n    46\\\\\\\\t  | evidence (in force at `as_of`) | `id`, `one_line`, `quote`, `tier`, `speaker`, `original_who`, `original_day`, `sources` |\\\\\\\\n    47\\\\\\\\t  | source (recorded on or before `as_of`) | `title`, `publisher`, `day`, `uri` |\\\\\\\\n    48\\\\\\\\t\\\\\\\\n    49\\\\\\\\t- **`question_class(conn, view_id, rungs)`** (§3 of the design):\\\\\\\\n    50\\\\\\\\t  - `event` when the view key's measure is in `identity.EVENT_MEASURES`;\\\\\\\\n    51\\\\\\\\t  - `yes_no` when there are exactly two rung labels which, through `vocabulary.canonical('label', …)`, are `Yes` and `No` in either\\\\\\\\n    52\\\\\\\\t    order;\\\\\\\\n    53\\\\\\\\t  - `number` otherwise. That includes a view with no key, and one whose bands cannot be resolved.\\\\\\\\n    54\\\\\\\\t- **`release_export(views_db, items_db, as_of=None)`:**\\\\\\\\n    55\\\\\\\\t  - pins both connections (`bundle.read_snapshot`);\\\\\\\\n    56\\\\\\\\t  - resolves the bound with `service.resolve_bound`, which refuses an unfinished first day or a future bound;\\\\\\\\n    57\\\\\\\\t  - exports every view that exists at the bound, closed ones included, in `created_seq` order;\\\\\\\\n    58\\\\\\\\t  - builds each record field by field from the table above, never by copying a row or a bundle;\\\\\\\\n    59\\\\\\\\t  - takes evidence from `service.evidence(conn, view_id, as_of)` (in force, replacements applied, sources visible at the bound);\\\\\\\\n    60\\\\\\\\t  - takes source text from `bundle.item_lookup`;\\\\\\\\n    61\\\\\\\\t  - calls `check_export` on its own result before returning, so the writer refuses an off-list field (AGENTS §3).\\\\\\\\n    62\\\\\\\\t- **`check_export(data)`:** the closed-set check.\\\\\\\\n    63\\\\\\\\t  - Every dict at every level has exactly its record type's keys; any other key fails.\\\\\\\\n    64\\\\\\\\t  - Value checks: `format` and `allow_list` equal the constants; `class` is in its set; a number record's `forecast` is the marker;\\\\\\\\n    65\\\\\\\\t    `answers` is two strings and `answer` is one of them or null; `open` is a bool; strings are strings.\\\\\\\\n    66\\\\\\\\t  - It returns the counts it judged: questions per class, evidence, sources.\\\\\\\\n    67\\\\\\\\t- **`write_package(data, out_dir)`:**\\\\\\\\n    68\\\\\\\\t  - refuses an existing `out_dir`;\\\\\\\\n    69\\\\\\\\t  - writes `release-data.json` and `manifest.json` (`format`, `allow_list`, `as_of`, the data file's sha256) into a temporary\\\\\\\\n    70\\\\\\\\t    sibling, then renames it into place, so a crash leaves no half package.\\\\\\\\n    71\\\\\\\\t- **`check_package(out_dir)`:**\\\\\\\\n    72\\\\\\\\t  - the directory holds exactly `{manifest.json, release-data.json}` (slice 2 adds the page), with no subdirectories;\\\\\\\\n    73\\\\\\\\t  - the manifest's sha256 matches the data file;\\\\\\\\n    74\\\\\\\\t  - the data passes `check_export`;\\\\\\\\n    75\\\\\\\\t  - it returns the counts.\\\\\\\\n    76\\\\\\\\t- **`withheld_unresolved(views_db, data)`:** for the release check report only. It lists the number questions whose ladder does not\\\\\\\\n    77\\\\\\\\t  resolve (`service.ladder_bands` returns None), with or without a key. They are withheld like every number question (design §3).\\\\\\\\n    78\\\\\\\\t\\\\\\\\n    79\\\\\\\\t`scripts/release_build.py --ledger --items [--as-of] --out`:\\\\\\\\n    80\\\\\\\\t- calls `release.release_export` directly; there is no input path for prepared or translated JSON;\\\\\\\\n    81\\\\\\\\t- then `write_package`, then `check_package`;\\\\\\\\n    82\\\\\\\\t- prints the counts and the unresolved list, and writes the same report to `<out>.report.json` beside the package, never inside it;\\\\\\\\n    83\\\\\\\\t- takes no clock reading. The folder name is the caller's (D12, D13).\\\\\\\\n    84\\\\\\\\t\\\\\\\\n    85\\\\\\\\t## 2. State × event (one export, read-only)\\\\\\\\n    86\\\\\\\\t\\\\\\\\n    87\\\\\\\\t| State / event | What happens | What is written | Day used |\\\\\\\\n    88\\\\\\\\t|---|---|---|---|\\\\\\\\n    89\\\\\\\\t| Store's first day still in progress | `resolve_bound` raises `FirstDayNotCompleted`; the build stops | nothing | none |\\\\\\\\n    90\\\\\\\\t| `--as-of` after the last completed day | `BoundNotCompleted`; the build stops | nothing | the requested day |\\\\\\\\n    91\\\\\\\\t| `--as-of` omitted | the last completed day (a legacy ledger: its last judgement day) | package | resolved bound |\\\\\\\\n    92\\\\\\\\t| View created after the bound | not exported | — | bound |\\\\\\\\n    93\\\\\\\\t| View closed on or before the bound | `open: false`; no reason and no closing day | — | bound (`is_open_as_of`) |\\\\\\\\n    94\\\\\\\\t| Closed, then reopened, before the bound | the last visible switch wins | — | bound |\\\\\\\\n    95\\\\\\\\t| Event or Yes/No not yet judged at the bound | `answer: null` | — | bound |\\\\\\\\n    96\\\\\\\\t| Evidence replaced on or before the bound | excluded; the replacement is in force | — | bound |\\\\\\\\n    97\\\\\\\\t| Evidence replaced after the bound | kept | — | bound |\\\\\\\\n    98\\\\\\\\t| Source recorded after the bound | excluded from `sources` | — | bound |\\\\\\\\n    99\\\\\\\\t| Store being written by a live run | not supported: the builder is given a snapshot (AGENTS §9); both connections are pinned for the export | — | — |\\\\\\\\n   100\\\\\\\\t| `out_dir` exists | refused before any write | nothing | — |\\\\\\\\n   101\\\\\\\\t| Crash midway through writing | the temporary sibling is left; `out_dir` does not exist | temp folder only | — |\\\\\\\\n   102\\\\\\\\t| Two builds of one store | each needs a new folder; the second never overwrites | — | — |\\\\\\\\n   103\\\\\\\\t| Configuration or store changed between builds | each package records its `as_of` and the data sha256; the report names the store path | — | — |\\\\\\\\n   104\\\\\\\\t| Legacy ledger: no `view_keys`, Chinese labels | no key, so no event; `是`/`否` canonicalise to Yes/No | — | — |\\\\\\\\n   105\\\\\\\\t| Off-list key reaches the record | `check_export` raises inside `release_export`; nothing is written | nothing | — |\\\\\\\\n   106\\\\\\\\t\\\\\\\\n   107\\\\\\\\t## 3. Value × reader\\\\\\\\n   108\\\\\\\\t\\\\\\\\n   109\\\\\\\\tReaders of the package:\\\\\\\\n   110\\\\\\\\t- `check_package`;\\\\\\\\n   111\\\\\\\\t- the release page (slice 2);\\\\\\\\n   112\\\\\\\\t- the tests.\\\\\\\\n   113\\\\\\\\t\\\\\\\\n   114\\\\\\\\tNo POC reader reads it: no service, MCP, `bundle` or `idea` code imports `release`.\\\\\\\\n   115\\\\\\\\t\\\\\\\\n   116\\\\\\\\t| Value | Source (table.column) | Note |\\\\\\\\n   117\\\\\\\\t|---|---|---|\\\\\\\\n   118\\\\\\\\t| `id`, `object`, `kind`, `question` | `views.view_id`, `object_id`, `kind`, `question` | `question` is allowed by D726 |\\\\\\\\n   119\\\\\\\\t| `open` | `view_switches.open` via `service.is_open_as_of` | `reason` never read |\\\\\\\\n   120\\\\\\\\t| `class` | `view_keys.measure`, `rungs.label` | identity only |\\\\\\\\n   121\\\\\\\\t| `answers`, `answer` | `rungs.label`; the latest `judgements.rung` on or before the bound | non-number only |\\\\\\\\n   122\\\\\\\\t| evidence fields | `evidence.*`, `evidence_links`, `replacements` via `service.evidence` | sources recorded and visible at the bound |\\\\\\\\n   123\\\\\\\\t| source fields | `evidence_sources.publication_day`; items `title`, `publisher`, `source_uri` | — |\\\\\\\\n   124\\\\\\\\t\\\\\\\\n   125\\\\\\\\t**Never read** by `release_export`:\\\\\\\\n   126\\\\\\\\t- `rungs.condition`, `lo`, `hi`;\\\\\\\\n   127\\\\\\\\t- `judgements.reasons`, `why_changed`, `pushes_json`, `theme_pushes_json`, `cited_*`;\\\\\\\\n   128\\\\\\\\t- `view_switches.reason`;\\\\\\\\n   129\\\\\\\\t- `clean_ladders`;\\\\\\\\n   130\\\\\\\\t- `thesis_groups`;\\\\\\\\n   131\\\\\\\\t- `dependencies`, `successions`;\\\\\\\\n   132\\\\\\\\t- every count and every date of a judgement.\\\\\\\\n   133\\\\\\\\t\\\\\\\\n   134\\\\\\\\tThe one exception is `judgements.rung` for non-number questions. The report-only `withheld_unresolved` reads rungs, but its output\\\\\\\\n   135\\\\\\\\tnever enters the package.\\\\\\\\n   136\\\\\\\\t\\\\\\\\n   137\\\\\\\\t## 4. New path × old checks\\\\\\\\n   138\\\\\\\\t\\\\\\\\n   139\\\\\\\\t| Check on the old path (`bundle.view_bundle`, `service`) | New path |\\\\\\\\n   140\\\\\\\\t|---|---|\\\\\\\\n   141\\\\\\\\t| `resolve_bound`: unfinished first day, future bound | same call |\\\\\\\\n   142\\\\\\\\t| A view not visible at the bound is not served | same `view_exists` |\\\\\\\\n   143\\\\\\\\t| Sources visible at the bound; replacements applied | same `service.evidence` |\\\\\\\\n   144\\\\\\\\t| Pinned read transaction for a complete envelope | same `bundle.read_snapshot` |\\\\\\\\n   145\\\\\\\\t| A malformed `clean_ladders` row is refused | not read: no new failure mode |\\\\\\\\n   146\\\\\\\\t| Corrupt judgement JSON is refused (`LedgerError`) | no JSON column read |\\\\\\\\n   147\\\\\\\\t| The UI contract rejects unknown fields (`thesis-ui/2`) | the release has its own contract (`check_export`); the page's reading of it is slice 2 |\\\\\\\\n   148\\\\\\\\t\\\\\\\\n   149\\\\\\\\t## 5. Prior decisions\\\\\\\\n   150\\\\\\\\t\\\\\\\\n   151\\\\\\\\t- D726: number questions show sources and \\\\\\\\\\\\\\\"Forecast unavailable\\\\\\\\\\\\\\\"; band, forecast text and history withheld together.\\\\\\\\n   152\\\\\\\\t- D756: Alex's choice.\\\\\\\\n   153\\\\\\\\t- D757: the design, revision 4.\\\\\\\\n   154\\\\\\\\t- D758: the release is opened; §4 (a); order.\\\\\\\\n   155\\\\\\\\t- D12/D13: no clock.\\\\\\\\n   156\\\\\\\\t- D163: English product text. Stored labels are emitted as stored; a legacy Chinese ledger is not a release input.\\\\\\\\n   157\\\\\\\\t- D690: poc-v118 stays the product.\\\\\\\\n   158\\\\\\\\t- D261: the ruler is untouched.\\\\\\\\n   159\\\\\\\\t\\\\\\\\n   160\\\\\\\\t## 6. Tests (`tests/test_release.py`) and mutants\\\\\\\\n   161\\\\\\\\t\\\\\\\\n   162\\\\\\\\tThe fixtures use a real store on a temporary path, built with `store.create_view` and `store.insert`. Each test names its row above:\\\\\\\\n   163\\\\\\\\t1. **Allow-list (§1):**\\\\\\\\n   164\\\\\\\\t   - every dict in a fixture export has exactly its type's keys;\\\\\\\\n   165\\\\\\\\t   - positive control: an export with one added key fails `check_export`.\\\\\\\\n   166\\\\\\\\t2. **Number with `lo`/`hi`.** The record carries the marker. The serialized export contains no rung label, condition, judgement reason\\\\\\\\n   167\\\\\\\\t   or `why_changed` text of that view. This is the decisive assertion.\\\\\\\\n   168\\\\\\\\t3. **Number with bounds only in its conditions** (no key): `number`.\\\\\\\\n   169\\\\\\\\t4. **Unresolved number with a key** (a money measure, no bounds, unreadable conditions): `number`, and listed by\\\\\\\\n   170\\\\\\\\t   `withheld_unresolved`.\\\\\\\\n   171\\\\\\\\t5. **Yes/No with numeric bounds** (`growth_rate`, labels Yes/No). Its answer label is shown. Its `why_changed` quoting \\\\\\\\\\\\\\\"$1 trillion\\\\\\\\\\\\\\\" is\\\\\\\\n   172\\\\\\\\t   absent.\\\\\\\\n   173\\\\\\\\t6. **Event:** the label is kept. A `why_changed` quoting another question's band is absent.\\\\\\\\n   174\\\\\\\\t7. **Closing switch** whose reason names the band label: `open: false`, and the reason is absent.\\\\\\\\n   175\\\\\\\\t8. **Replacement and source visibility** at two bounds.\\\\\\\\n   176\\\\\\\\t9. **Package:**\\\\\\\\n   177\\\\\\\\t   - write, then check, passes;\\\\\\\\n   178\\\\\\\\t   - a foreign file fails, and so does a subdirectory;\\\\\\\\n   179\\\\\\\\t   - a changed data byte fails the sha check;\\\\\\\\n   180\\\\\\\\t   - an existing `out_dir` is refused.\\\\\\\\n   181\\\\\\\\t10. **Builder end to end,** run as the user calls it (subprocess, `--as-of` omitted) on the fixture store. The package passes the\\\\\\\\n   182\\\\\\\\t    check and the report lists the unresolved view.\\\\\\\\n   183\\\\\\\\t11. **Legacy labels** `是`/`否`: `yes_no`.\\\\\\\\n   184\\\\\\\\t\\\\\\\\n   185\\\\\\\\t**Mutants,** run on a scratch copy with `PYTHONDONTWRITEBYTECODE=1`; each must fail a test:\\\\\\\\n   186\\\\\\\\t- an off-list field emitted (`condition` on a number record);\\\\\\\\n   187\\\\\\\\t- the event test removed;\\\\\\\\n   188\\\\\\\\t- the Yes/No test removed;\\\\\\\\n   189\\\\\\\\t- `check_package` without the file-set check;\\\\\\\\n   190\\\\\\\\t- `check_export` without the closed-key check;\\\\\\\\n   191\\\\\\\\t- the switch reason emitted.\\\\\\\\n   192\\\\\\\\t\\\\\\\\n   193\\\\\\\\t## 7. The $0 release check (stored stores, read-only)\\\\\\\\n   194\\\\\\\\t\\\\\\\\n   195\\\\\\\\tStores: `old-1`, `old-2`, `old-3` (`comparison-2026-11-17/run/old-N/prod/views.sqlite`, items `items-comparison.sqlite`) and the\\\\\\\\n   196\\\\\\\\tserved ledger.\\\\\\\\n   197\\\\\\\\t1. **Whole-store leak sweep.** For every view, collect the strings the package must not hold:\\\\\\\\n   198\\\\\\\\t   - for a number question: rung labels and conditions, judgement `reasons` and `why_changed`, switch reasons;\\\\\\\\n   199\\\\\\\\t   - for any other question: judgement `reasons` and `why_changed`, switch reasons.\\\\\\\\n   200\\\\\\\\t\\\\\\\\n   201\\\\\\\\t   Search the serialized export for each string of at least 12 characters, then report how many strings were judged and every hit,\\\\\\\\n   202\\\\\\\\t   read by hand.\\\\\\\\n   203\\\\\\\\t2. **`old-1/v8`.** The record has the marker and the same evidence ids and sources as `service.evidence` at the bound. None of its 5\\\\\\\\n   204\\\\\\\\t   labels, its 75 judgements' texts or its band is in the package.\\\\\\\\n   205\\\\\\\\t3. **`old-3/v36` (j799) and `old-1/v10` (j865).** Labels kept; the \\\\\\\\\\\\\\\"around $1 trillion\\\\\\\\\\\\\\\" text and j865's band text absent.\\\\\\\\n   206\\\\\\\\t4. **Control.** One unchanged event question keeps its label and evidence.\\\\\\\\n   207\\\\\\\\t5. **Closing.** On a temporary copy of `old-1`, add a real closing switch for `v8` in the store's own reason format (\\\\\\\\\\\\\\\"due …, frozen\\\\\\\\n   208\\\\\\\\t   on … at rung N <label>\\\\\\\\\\\\\\\"). First confirm that `bundle.view_bundle` exposes the band there, then confirm the package does not.\\\\\\\\n   209\\\\\\\\t6. **Size and speed:** export bytes and seconds against `bundle.library` on the same store.\\\\\\\\n   210\\\\\\\\t\\\\\\\\n   211\\\\\\\\t## 8. Open for round 74\\\\\\\\n   212\\\\\\\\t\\\\\\\\n   213\\\\\\\\t1. **The idea path:** none in the release (§0)? Or must slice 1 include an export-only idea path?\\\\\\\\n   214\\\\\\\\t2. **`object` and `kind` on every record.** They are not in the design's list (\\\\\\\\\\\\\\\"the question and its id\\\\\\\\\\\\\\\"). They are identity, not a\\\\\\\\n   215\\\\\\\\t   forecast, and the library groups by object. Keep them, or drop them?\\\\\\\\n   216\\\\\\\\t3. **Research groups** (`thesis_groups`: model-written names and scopes) are left out. Is that right for slice 1?\\\\\\\\n   217\\\\\\\\t4. **The leak sweep's 12-character floor.** Is it right, and is any string class missing from the sweep?\\\\\\\\n\\\\\\\",\\\\\\\"exit_code\\\\\\\":0,\\\\\\\"status\\\\\\\":\\\\\\\"completed\\\\\\\"}}\\\\ndocs/research/2026-11-22-number-answers/codex-r74.stream:12:{\\\\\\\"type\\\\\\\":\\\\\\\"item.completed\\\\\\\",\\\\\\\"item\\\\\\\":{\\\\\\\"id\\\\\\\":\\\\\\\"item_5\\\\\\\",\\\\\\\"type\\\\\\\":\\\\\\\"command_execution\\\\\\\",\\\\\\\"command\\\\\\\":\\\\\\\"/opt/homebrew/bin/zsh -lc 'nl -ba docs/research/2026-11-22-number-answers/FORECAST-UNAVAILABLE-DESIGN.md'\\\\\\\",\\\\\\\"aggregated_output\\\\\\\":\\\\\\\"     1\\\\\\\\t# \\\\\\\\\\\\\\\"Forecast unavailable\\\\\\\\\\\\\\\" for number questions: the design, ready for when release work opens\\\\\\\\n     2\\\\\\\\t\\\\\\\\n     3\\\\\\\\t**Status: design only. Nothing is built.** Alex decided the behaviour twice:\\\\\\\\n     4\\\\\\\\t- D726, \\\\\\\\\\\\\\\"同意\\\\\\\\\\\\\\\": until the number answers pass, a first release shows number questions with their sources and \\\\\\\\\\\\\\\"Forecast unavailable\\\\\\\\\\\\\\\",\\\\\\\\n     5\\\\\\\\t  with the band, the forecast text and its history withheld together; \\\\\\\\\\\\\\\"it is built with the release work, which is not started\\\\\\\\\\\\\\\";\\\\\\\\n     6\\\\\\\\t- D756, \\\\\\\\\\\\\\\"结束这条线，预测暂缺上线\\\\\\\\\\\\\\\".\\\\\\\\n     7\\\\\\\\t\\\\\\\\n     8\\\\\\\\tOpening release work is Alex's call (council 72). This page makes the build a known, reviewed slice for that moment.\\\\\\\\n     9\\\\\\\\t\\\\\\\\n    10\\\\\\\\t**Revision 4 (council 72c) of revision 3: one structural rule instead of a list of leaks.** Rounds 72 and 72b each found new paths by which a withheld forecast\\\\\\\\n    11\\\\\\\\tcould reach a reader:\\\\\\\\n    12\\\\\\\\t- the idea card;\\\\\\\\n    13\\\\\\\\t- the closing text;\\\\\\\\n    14\\\\\\\\t- an idea summary that re-reads the ladder;\\\\\\\\n    15\\\\\\\\t- a release page that reloads from the live POC service;\\\\\\\\n    16\\\\\\\\t- a translated export;\\\\\\\\n    17\\\\\\\\t- a Yes/No explanation that quotes a number question's band.\\\\\\\\n    18\\\\\\\\t\\\\\\\\n    19\\\\\\\\tA rule that withholds fields reader by reader will keep missing one (AGENTS §1: \\\\\\\\\\\\\\\"when one mechanism draws findings round after round,\\\\\\\\n    20\\\\\\\\tstop answering findings: propose one structural rule\\\\\\\\\\\\\\\"). Revision 3 replaces that rule with an allow-list at one boundary.\\\\\\\\n    21\\\\\\\\t\\\\\\\\n    22\\\\\\\\t## 1. The gap, measured at $0 (2026-11-23)\\\\\\\\n    23\\\\\\\\t\\\\\\\\n    24\\\\\\\\tThe stored poc-v118 store `poc/data/comparison-2026-11-17/run/old-1/prod/views.sqlite`, read-only, gives:\\\\\\\\n    25\\\\\\\\t- **The number question v8 (FY2027 Data Center revenue)** exposes its band, label, condition, reasons, 75 judgements and 69 change rows.\\\\\\\\n    26\\\\\\\\t- **Its idea input** reads \\\\\\\\\\\\\\\"Bullish … $350 billion to under $400 billion\\\\\\\\\\\\\\\".\\\\\\\\n    27\\\\\\\\t- **Yes/No explanations quote number forecasts:**\\\\\\\\n    28\\\\\\\\t  - `old-3` `v36`, judgement 799: \\\\\\\\\\\\\\\"around $1 trillion\\\\\\\\\\\\\\\" for 2027 spending;\\\\\\\\n    29\\\\\\\\t  - `old-1` `v10`, judgement 865: the selected bands of both spending questions.\\\\\\\\n    30\\\\\\\\t\\\\\\\\n    31\\\\\\\\t  The judge is shown related questions' selected bands (`views/judging.py:208`), and its prose can repeat them.\\\\\\\\n    32\\\\\\\\t\\\\\\\\n    33\\\\\\\\t## 2. The structural rule: one release export, allow-listed\\\\\\\\n    34\\\\\\\\t\\\\\\\\n    35\\\\\\\\t- **One exporter writes the release data:** `release_export`, a single function beside `service.py`. It emits only the fields on an\\\\\\\\n    36\\\\\\\\t  explicit allow-list. A field not on the list cannot appear, so a new or overlooked path fails closed.\\\\\\\\n    37\\\\\\\\t- **The release builder calls `release_export` directly** and accepts no external input; a marker or version names a format, not\\\\\\\\n    38\\\\\\\\t  who wrote the text (council 72c). The finished package is checked as well as the page: it holds only the export's output, with no\\\\\\\\n    39\\\\\\\\t  market data, composite trials or translated file beside it.\\\\\\\\n    40\\\\\\\\t- **The release reads only that export.** Its page, its static build and its API, if any, read nothing else:\\\\\\\\n    41\\\\\\\\t  - no live POC service;\\\\\\\\n    42\\\\\\\\t  - no `/library` reload (`poc/ui/src/bootstrap.js` must not fetch in a release build);\\\\\\\\n    43\\\\\\\\t  - no prepared or translated JSON (`scripts/mock_translate.py`'s `data.en.json`);\\\\\\\\n    44\\\\\\\\t  - no `--composite-trials` input.\\\\\\\\n    45\\\\\\\\t\\\\\\\\n    46\\\\\\\\t  The static builder refuses any input not produced by `release_export`, which carries a marker and the allow-list version.\\\\\\\\n    47\\\\\\\\t- **For a number question, the allow-list is:**\\\\\\\\n    48\\\\\\\\t  - the question and its id;\\\\\\\\n    49\\\\\\\\t  - the evidence in force: one-line, quote, speaker, original day, tier and sources, amounts as quoted;\\\\\\\\n    50\\\\\\\\t  - the marker \\\\\\\\\\\\\\\"Forecast unavailable\\\\\\\\\\\\\\\".\\\\\\\\n    51\\\\\\\\t\\\\\\\\n    52\\\\\\\\t  Nothing else is listed:\\\\\\\\n    53\\\\\\\\t  - no ladder;\\\\\\\\n    54\\\\\\\\t  - no band, label or condition;\\\\\\\\n    55\\\\\\\\t  - no reasons or why_changed;\\\\\\\\n    56\\\\\\\\t  - no history, counts or assessment dates;\\\\\\\\n    57\\\\\\\\t  - no closing band (\\\\\\\\\\\\\\\"closed\\\\\\\\\\\\\\\" only);\\\\\\\\n    58\\\\\\\\t  - no theme pushes, no composite, no idea derived from its forecast.\\\\\\\\n    59\\\\\\\\t- **Ideas.** The release's idea composition (`idea.py`, `idea_composite.py`) runs on export data only. A number question enters it\\\\\\\\n    60\\\\\\\\t  as question and evidence with the marker. Its ladder is not read from storage in either the answer-format build or the summary\\\\\\\\n    61\\\\\\\\t  input (`idea_composite.py:255`, `:281`; `poc-v118-idea.json:94`). The test inspects the composed request itself, not only the\\\\\\\\n    62\\\\\\\\t  delivered card.\\\\\\\\n    63\\\\\\\\t- **The POC is unchanged.** Its API, MCP and page keep today's behaviour. Whether colleagues' POC page also changes is a separate\\\\\\\\n    64\\\\\\\\t  later choice for Alex.\\\\\\\\n    65\\\\\\\\t\\\\\\\\n    66\\\\\\\\t## 3. Identity: what a number question is (verified on four stores by council 72b)\\\\\\\\n    67\\\\\\\\t\\\\\\\\n    68\\\\\\\\tA view is a number question unless one of the following excludes it:\\\\\\\\n    69\\\\\\\\t1. **An event.** The view key's measure is in `identity.EVENT_MEASURES` (`event`, `policy_event`). That covers 85 of 85 event\\\\\\\\n    70\\\\\\\\t   questions in the three comparison stores.\\\\\\\\n    71\\\\\\\\t2. **A Yes/No question.** The ladder has exactly two labels which, canonicalised with the existing vocabulary\\\\\\\\n    72\\\\\\\\t   (`vocabulary.canonical`), are Yes and No in either order. The sealed ledger's 30 such questions use `是` and `否`. The Xbox `v37`\\\\\\\\n    73\\\\\\\\t   (`growth_rate`, bounds around zero) is Yes/No.\\\\\\\\n    74\\\\\\\\t\\\\\\\\n    75\\\\\\\\tEvery other view is a number question. Its forecast is withheld whether its bands come from `lo`/`hi`, parse from the conditions\\\\\\\\n    76\\\\\\\\t(the sealed `v3`), or cannot be resolved. An unresolved record is withheld and listed in the release check, with a key or without\\\\\\\\n    77\\\\\\\\t(council 72b: an `old-1/v8` copy without bounds does not parse, and its key still exists).\\\\\\\\n    78\\\\\\\\t\\\\\\\\n    79\\\\\\\\tCounts (council 72b), number / event or Yes/No:\\\\\\\\n    80\\\\\\\\t- `old-1` 19 / 28, `old-2` 17 / 26, `old-3` 18 / 31;\\\\\\\\n    81\\\\\\\\t- the sealed ledger: 43 parse as money, 21 are withheld as unresolved, 30 are Yes/No.\\\\\\\\n    82\\\\\\\\t\\\\\\\\n    83\\\\\\\\tNo wrong show-or-withhold result was found.\\\\\\\\n    84\\\\\\\\t\\\\\\\\n    85\\\\\\\\t**Events are binary too.** All 85 comparison-store events are also two-answer questions, including both known prose leaks, and a\\\\\\\\n    86\\\\\\\\tbinary event such as \\\\\\\\\\\\\\\"Restriction adopted\\\\\\\\\\\\\\\" / \\\\\\\\\\\\\\\"No restriction adopted\\\\\\\\\\\\\\\" exists in the served ledger (council 72c). §4's rule applies to\\\\\\\\n    87\\\\\\\\tevery question that is not a number question, events and Yes/No alike, and each keeps its answer label.\\\\\\\\n    88\\\\\\\\t\\\\\\\\n    89\\\\\\\\t## 4. Questions that are not number questions: an open choice for Alex (not decided here)\\\\\\\\n    90\\\\\\\\t\\\\\\\\n    91\\\\\\\\tD726 covers number questions. A Yes/No question's band is not a number forecast, but its stored explanation can quote one (§1). The\\\\\\\\n    92\\\\\\\\tallow-list must say which Yes/No fields the release shows:\\\\\\\\n    93\\\\\\\\t- **(a)** the question, its evidence and its answer (Yes/No and label), with no explanation text. Safe, and it removes the reasoning\\\\\\\\n    94\\\\\\\\t  readers would see.\\\\\\\\n    95\\\\\\\\t- **(b)** as (a), plus the explanation only for judgements whose request showed the judge no number question's state. Code can\\\\\\\\n    96\\\\\\\\t  decide this from the stored request (`views/judging.py`, which builds the related questions shown).\\\\\\\\n    97\\\\\\\\t- **Measured (council 72c),** matching each judgement to its archived request:\\\\\\\\n    98\\\\\\\\t  - (b) would keep explanations on 31 of 769, 44 of 776 and 43 of 958 judgements in the three comparison runs;\\\\\\\\n    99\\\\\\\\t  - for a reader at the latest answer, it would keep them on 21 of 85 questions;\\\\\\\\n   100\\\\\\\\t  - it would keep 73 of 73 in the sealed ledger.\\\\\\\\n   101\\\\\\\\t- **The limit of (b).** It cannot promise the prose quotes no number forecast. A request also carries the question's own previous\\\\\\\\n   102\\\\\\\\t  reasoning, and can carry another question's, either of which may repeat a forecast seen earlier. Both known leaks are in\\\\\\\\n   103\\\\\\\\t  `why_changed`.\\\\\\\\n   104\\\\\\\\t- **Recommendation: (a) for the first release** (council 72c; Claude agrees, withdrawing its lean for (b)). It is the only option\\\\\\\\n   105\\\\\\\\t  that guarantees no number forecast reaches a reader through prose. (b) remains a measured later step.\\\\\\\\n   106\\\\\\\\t\\\\\\\\n   107\\\\\\\\t## 5. Tests and the $0 release check (each names its row above)\\\\\\\\n   108\\\\\\\\t\\\\\\\\n   109\\\\\\\\t- **Fixtures (real store on a temporary path):**\\\\\\\\n   110\\\\\\\\t  - a number question with `lo`/`hi`;\\\\\\\\n   111\\\\\\\\t  - one with bounds only in its conditions;\\\\\\\\n   112\\\\\\\\t  - an unresolved one with a key;\\\\\\\\n   113\\\\\\\\t  - a Yes/No question with numeric bounds;\\\\\\\\n   114\\\\\\\\t  - an event question;\\\\\\\\n   115\\\\\\\\t  - a Yes/No judgement whose prose quotes a number band;\\\\\\\\n   116\\\\\\\\t  - a real closing switch;\\\\\\\\n   117\\\\\\\\t  - an idea.\\\\\\\\n   118\\\\\\\\t- **What the tests assert.** `release_export`'s output holds only allow-listed keys (a schema check that fails on any extra key). For\\\\\\\\n   119\\\\\\\\t  number questions it holds no band, ladder, reasons, history, date or closing band; Yes/No follows §4's choice. The static build\\\\\\\\n   120\\\\\\\\t  refuses foreign input, and a release page makes no network fetch.\\\\\\\\n   121\\\\\\\\t- **Mutants:**\\\\\\\\n   122\\\\\\\\t  - an extra field;\\\\\\\\n   123\\\\\\\\t  - a fetch left on;\\\\\\\\n   124\\\\\\\\t  - a ladder read in idea composition;\\\\\\\\n   125\\\\\\\\t  - the identity mis-sorting each fixture.\\\\\\\\n   126\\\\\\\\t\\\\\\\\n   127\\\\\\\\t  Each must fail.\\\\\\\\n   128\\\\\\\\t- **End-to-end acceptance (council 72c):**\\\\\\\\n   129\\\\\\\\t  - an idea whose only question is `old-1/v8`: the card keeps its sources and \\\\\\\\\\\\\\\"Forecast unavailable\\\\\\\\\\\\\\\", with no scored driver and no\\\\\\\\n   130\\\\\\\\t    substitute band (the current composite expects an endpoint for every scoring candidate, `idea_composite.py:214`, `:231`);\\\\\\\\n   131\\\\\\\\t  - in the same release package, the two known event answers keep their labels and carry no spending forecast under the chosen\\\\\\\\n   132\\\\\\\\t    prose rule.\\\\\\\\n   133\\\\\\\\t- **The $0 release check.**\\\\\\\\n   134\\\\\\\\t  - On `old-1/v8`, confirm the marker and the same sources in the page and in the export data.\\\\\\\\n   135\\\\\\\\t  - Exercise closure on a temporary copy with a real closing switch, after first confirming that the unrestricted response exposes the\\\\\\\\n   136\\\\\\\\t    final band there.\\\\\\\\n   137\\\\\\\\t  - Check ideas with a recorded or test transport, inspecting the composed request.\\\\\\\\n   138\\\\\\\\t  - Use `old-3/v36` and `old-1/v10` as the Yes/No prose cases.\\\\\\\\n   139\\\\\\\\t  - Use one unchanged event question as the control.\\\\\\\\n   140\\\\\\\\t\\\\\\\\n   141\\\\\\\\t## 6. Not in scope\\\\\\\\n   142\\\\\\\\t\\\\\\\\n   143\\\\\\\\t- The judging, opening and extraction pieces (frozen).\\\\\\\\n   144\\\\\\\\t- The closed v13s line.\\\\\\\\n   145\\\\\\\\t- Other open defects.\\\\\\\\n   146\\\\\\\\t- No prompt or pipeline change.\\\\\\\\n   147\\\\\\\\t- The POC's own behaviour.\\\\\\\\n\\\\\\\",\\\\\\\"exit_code\\\\\\\":0,\\\\\\\"status\\\\\\\":\\\\\\\"completed\\\\\\\"}}\\\\ndocs/research/2026-11-22-number-answers/codex-r74.stream:20:{\\\\\\\"type\\\\\\\":\\\\\\\"item.completed\\\\\\\",\\\\\\\"item\\\\\\\":{\\\\\\\"id\\\\\\\":\\\\\\\"item_10\\\\\\\",\\\\\\\"type\\\\\\\":\\\\\\\"command_execution\\\\\\\",\\\\\\\"command\\\\\\\":\\\\\\\"/opt/homebrew/bin/zsh -lc 'nl -ba docs/research/2026-11-22-number-answers/FORECAST-UNAVAILABLE-DESIGN.md | tail -n +58; nl -ba docs/research/2026-11-22-number-answers/codex-r72d.md'\\\\\\\",\\\\\\\"aggregated_output\\\\\\\":\\\\\\\"    58\\\\\\\\t  - no theme pushes, no composite, no idea derived from its forecast.\\\\\\\\n    59\\\\\\\\t- **Ideas.** The release's idea composition (`idea.py`, `idea_composite.py`) runs on export data only. A number question enters it\\\\\\\\n    60\\\\\\\\t  as question and evidence with the marker. Its ladder is not read from storage in either the answer-format build or the summary\\\\\\\\n    61\\\\\\\\t  input (`idea_composite.py:255`, `:281`; `poc-v118-idea.json:94`). The test inspects the composed request itself, not only the\\\\\\\\n    62\\\\\\\\t  delivered card.\\\\\\\\n    63\\\\\\\\t- **The POC is unchanged.** Its API, MCP and page keep today's behaviour. Whether colleagues' POC page also changes is a separate\\\\\\\\n    64\\\\\\\\t  later choice for Alex.\\\\\\\\n    65\\\\\\\\t\\\\\\\\n    66\\\\\\\\t## 3. Identity: what a number question is (verified on four stores by council 72b)\\\\\\\\n    67\\\\\\\\t\\\\\\\\n    68\\\\\\\\tA view is a number question unless one of the following excludes it:\\\\\\\\n    69\\\\\\\\t1. **An event.** The view key's measure is in `identity.EVENT_MEASURES` (`event`, `policy_event`). That covers 85 of 85 event\\\\\\\\n    70\\\\\\\\t   questions in the three comparison stores.\\\\\\\\n    71\\\\\\\\t2. **A Yes/No question.** The ladder has exactly two labels which, canonicalised with the existing vocabulary\\\\\\\\n    72\\\\\\\\t   (`vocabulary.canonical`), are Yes and No in either order. The sealed ledger's 30 such questions use `是` and `否`. The Xbox `v37`\\\\\\\\n    73\\\\\\\\t   (`growth_rate`, bounds around zero) is Yes/No.\\\\\\\\n    74\\\\\\\\t\\\\\\\\n    75\\\\\\\\tEvery other view is a number question. Its forecast is withheld whether its bands come from `lo`/`hi`, parse from the conditions\\\\\\\\n    76\\\\\\\\t(the sealed `v3`), or cannot be resolved. An unresolved record is withheld and listed in the release check, with a key or without\\\\\\\\n    77\\\\\\\\t(council 72b: an `old-1/v8` copy without bounds does not parse, and its key still exists).\\\\\\\\n    78\\\\\\\\t\\\\\\\\n    79\\\\\\\\tCounts (council 72b), number / event or Yes/No:\\\\\\\\n    80\\\\\\\\t- `old-1` 19 / 28, `old-2` 17 / 26, `old-3` 18 / 31;\\\\\\\\n    81\\\\\\\\t- the sealed ledger: 43 parse as money, 21 are withheld as unresolved, 30 are Yes/No.\\\\\\\\n    82\\\\\\\\t\\\\\\\\n    83\\\\\\\\tNo wrong show-or-withhold result was found.\\\\\\\\n    84\\\\\\\\t\\\\\\\\n    85\\\\\\\\t**Events are binary too.** All 85 comparison-store events are also two-answer questions, including both known prose leaks, and a\\\\\\\\n    86\\\\\\\\tbinary event such as \\\\\\\\\\\\\\\"Restriction adopted\\\\\\\\\\\\\\\" / \\\\\\\\\\\\\\\"No restriction adopted\\\\\\\\\\\\\\\" exists in the served ledger (council 72c). §4's rule applies to\\\\\\\\n    87\\\\\\\\tevery question that is not a number question, events and Yes/No alike, and each keeps its answer label.\\\\\\\\n    88\\\\\\\\t\\\\\\\\n    89\\\\\\\\t## 4. Questions that are not number questions: an open choice for Alex (not decided here)\\\\\\\\n    90\\\\\\\\t\\\\\\\\n    91\\\\\\\\tD726 covers number questions. A Yes/No question's band is not a number forecast, but its stored explanation can quote one (§1). The\\\\\\\\n    92\\\\\\\\tallow-list must say which Yes/No fields the release shows:\\\\\\\\n    93\\\\\\\\t- **(a)** the question, its evidence and its answer (Yes/No and label), with no explanation text. Safe, and it removes the reasoning\\\\\\\\n    94\\\\\\\\t  readers would see.\\\\\\\\n    95\\\\\\\\t- **(b)** as (a), plus the explanation only for judgements whose request showed the judge no number question's state. Code can\\\\\\\\n    96\\\\\\\\t  decide this from the stored request (`views/judging.py`, which builds the related questions shown).\\\\\\\\n    97\\\\\\\\t- **Measured (council 72c),** matching each judgement to its archived request:\\\\\\\\n    98\\\\\\\\t  - (b) would keep explanations on 31 of 769, 44 of 776 and 43 of 958 judgements in the three comparison runs;\\\\\\\\n    99\\\\\\\\t  - for a reader at the latest answer, it would keep them on 21 of 85 questions;\\\\\\\\n   100\\\\\\\\t  - it would keep 73 of 73 in the sealed ledger.\\\\\\\\n   101\\\\\\\\t- **The limit of (b).** It cannot promise the prose quotes no number forecast. A request also carries the question's own previous\\\\\\\\n   102\\\\\\\\t  reasoning, and can carry another question's, either of which may repeat a forecast seen earlier. Both known leaks are in\\\\\\\\n   103\\\\\\\\t  `why_changed`.\\\\\\\\n   104\\\\\\\\t- **Recommendation: (a) for the first release** (council 72c; Claude agrees, withdrawing its lean for (b)). It is the only option\\\\\\\\n   105\\\\\\\\t  that guarantees no number forecast reaches a reader through prose. (b) remains a measured later step.\\\\\\\\n   106\\\\\\\\t\\\\\\\\n   107\\\\\\\\t## 5. Tests and the $0 release check (each names its row above)\\\\\\\\n   108\\\\\\\\t\\\\\\\\n   109\\\\\\\\t- **Fixtures (real store on a temporary path):**\\\\\\\\n   110\\\\\\\\t  - a number question with `lo`/`hi`;\\\\\\\\n   111\\\\\\\\t  - one with bounds only in its conditions;\\\\\\\\n   112\\\\\\\\t  - an unresolved one with a key;\\\\\\\\n   113\\\\\\\\t  - a Yes/No question with numeric bounds;\\\\\\\\n   114\\\\\\\\t  - an event question;\\\\\\\\n   115\\\\\\\\t  - a Yes/No judgement whose prose quotes a number band;\\\\\\\\n   116\\\\\\\\t  - a real closing switch;\\\\\\\\n   117\\\\\\\\t  - an idea.\\\\\\\\n   118\\\\\\\\t- **What the tests assert.** `release_export`'s output holds only allow-listed keys (a schema check that fails on any extra key). For\\\\\\\\n   119\\\\\\\\t  number questions it holds no band, ladder, reasons, history, date or closing band; Yes/No follows §4's choice. The static build\\\\\\\\n   120\\\\\\\\t  refuses foreign input, and a release page makes no network fetch.\\\\\\\\n   121\\\\\\\\t- **Mutants:**\\\\\\\\n   122\\\\\\\\t  - an extra field;\\\\\\\\n   123\\\\\\\\t  - a fetch left on;\\\\\\\\n   124\\\\\\\\t  - a ladder read in idea composition;\\\\\\\\n   125\\\\\\\\t  - the identity mis-sorting each fixture.\\\\\\\\n   126\\\\\\\\t\\\\\\\\n   127\\\\\\\\t  Each must fail.\\\\\\\\n   128\\\\\\\\t- **End-to-end acceptance (council 72c):**\\\\\\\\n   129\\\\\\\\t  - an idea whose only question is `old-1/v8`: the card keeps its sources and \\\\\\\\\\\\\\\"Forecast unavailable\\\\\\\\\\\\\\\", with no scored driver and no\\\\\\\\n   130\\\\\\\\t    substitute band (the current composite expects an endpoint for every scoring candidate, `idea_composite.py:214`, `:231`);\\\\\\\\n   131\\\\\\\\t  - in the same release package, the two known event answers keep their labels and carry no spending forecast under the chosen\\\\\\\\n   132\\\\\\\\t    prose rule.\\\\\\\\n   133\\\\\\\\t- **The $0 release check.**\\\\\\\\n   134\\\\\\\\t  - On `old-1/v8`, confirm the marker and the same sources in the page and in the export data.\\\\\\\\n   135\\\\\\\\t  - Exercise closure on a temporary copy with a real closing switch, after first confirming that the unrestricted response exposes the\\\\\\\\n   136\\\\\\\\t    final band there.\\\\\\\\n   137\\\\\\\\t  - Check ideas with a recorded or test transport, inspecting the composed request.\\\\\\\\n   138\\\\\\\\t  - Use `old-3/v36` and `old-1/v10` as the Yes/No prose cases.\\\\\\\\n   139\\\\\\\\t  - Use one unchanged event question as the control.\\\\\\\\n   140\\\\\\\\t\\\\\\\\n   141\\\\\\\\t## 6. Not in scope\\\\\\\\n   142\\\\\\\\t\\\\\\\\n   143\\\\\\\\t- The judging, opening and extraction pieces (frozen).\\\\\\\\n   144\\\\\\\\t- The closed v13s line.\\\\\\\\n   145\\\\\\\\t- Other open defects.\\\\\\\\n   146\\\\\\\\t- No prompt or pipeline change.\\\\\\\\n   147\\\\\\\\t- The POC's own behaviour.\\\\\\\\n     1\\\\\\\\t1. Revision 4 adds the package boundary and acceptance case that 72c requested. The builder must call the exporter directly, and the check covers the finished package. The `old-1/v8` idea card must show its sources and “Forecast unavailable,” with no scored driver or substitute band. The same package must preserve both event labels and omit their spending forecasts. I found no unrelated change. [Revision 3 snapshot:15](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/codex-r72c.stream:15) · [Design:37](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/FORECAST-UNAVAILABLE-DESIGN.md:37) · [Design:129](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/FORECAST-UNAVAILABLE-DESIGN.md:129)\\\\\\\\n     2\\\\\\\\t2. One prose rule now covers events and Yes/No questions, including all 85 overlapping cases. The figures match 72c. Option (b) would preserve explanations for 21 of 85 latest answers and 73 of 73 historical answers in the sealed ledger. The design recommends (a) to Alex. Under (a), I found no remaining route in the design for a stored number forecast to reach a release reader. [72c:5](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/codex-r72c.md:5) · [Design:85](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/FORECAST-UNAVAILABLE-DESIGN.md:85) · [Design:98](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/FORECAST-UNAVAILABLE-DESIGN.md:98)\\\\\\\\n     3\\\\\\\\t3. **One correction from 72c is incomplete.** Line 97 still tells Alex that an explanation kept under (b) “cannot quote a number forecast.” Line 102 correctly says it can. A Yes/No answer can repeat a spending forecast from its previous explanation even when the current request shows no number question directly. Delete the sentence spanning lines 96–97 that makes the guarantee. [Design:96](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/FORECAST-UNAVAILABLE-DESIGN.md:96) · [Design:102](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/FORECAST-UNAVAILABLE-DESIGN.md:102) · [judging.py:211](/Users/lchingen/hivemind/src/hivemind/views/judging.py:211)\\\\\\\\n     4\\\\\\\\t\\\\\\\\n     5\\\\\\\\t**Verdict — not ready as written.** The contradictory guarantee is the only blocker. Once removed, the design is ready to hand to release work when Alex opens it, with §4’s choice still his and **(a) recommended**.\\\\\\\",\\\\\\\"exit_code\\\\\\\":0,\\\\\\\"status\\\\\\\":\\\\\\\"completed\\\\\\\"}}\\\\ndocs/research/2026-11-22-number-answers/RELEASE-BUILD.md:196:served ledger.\\\\ndocs/research/2026-11-22-number-answers/codex-r72c.stream:59:{\\\\\\\"type\\\\\\\":\\\\\\\"item.completed\\\\\\\",\\\\\\\"item\\\\\\\":{\\\\\\\"id\\\\\\\":\\\\\\\"item_30\\\\\\\",\\\\\\\"type\\\\\\\":\\\\\\\"command_execution\\\\\\\",\\\\\\\"command\\\\\\\":\\\\\\\"/opt/homebrew/bin/zsh -lc \\\\\\\\\\\\\\\"nl -ba poc/data/served-2026-10-28-v34-nvda-3m-through-0828/README.md\\\\\\\\nrg -n 'Restriction adopted|No restriction adopted' docs scripts tests poc --glob '\\\\\\\\\\\\\\\"'!*.stream'\\\\\\\\\\\\\\\"' --glob '\\\\\\\\\\\\\\\"'!*.json*'\\\\\\\\\\\\\\\"' --glob '\\\\\\\\\\\\\\\"'!*.html'\\\\\\\\\\\\\\\"' --glob '\\\\\\\\\\\\\\\"'!*.out'\\\\\\\\\\\\\\\"' --glob '\\\\\\\\\\\\\\\"'!*.csv'\\\\\\\\\\\\\\\"' | head -20\\\\\\\\\\\\\\\"\\\\\\\",\\\\\\\"aggregated_output\\\\\\\":\\\\\\\"     1\\\\\\\\t# Served copy of the sealed 2026-10-28 ledger, minus v68\\\\\\\\n     2\\\\\\\\t\\\\\\\\n     3\\\\\\\\t`views.sqlite` = `sealed-2026-10-28-v34-nvda-3m-through-0828/views.sqlite` with thesis v68 removed (Alex, 2026-10-28 17:05:\\\\\\\\n     4\\\\\\\\t\\\\\\\\\\\\\\\"你直接把它移除，这是我们自己的失误\\\\\\\\\\\\\\\"). v68, \\\\\\\\\\\\\\\"What stand-alone CPU revenue will NVIDIA report for calendar 2027?\\\\\\\\\\\\\\\", was opened on the\\\\\\\\n     5\\\\\\\\trun's last day by the succession rule (same quantity, next period, after v24) and the writer linked its one opening statement to\\\\\\\\n     6\\\\\\\\tv7 and v24 instead of to it, so it stood with no evidence and no judgement. Rows removed: views, view_keys, rungs, successions,\\\\\\\\n     7\\\\\\\\tview_switches, views_fts for v68 (no evidence_links or judgements existed). The sealed folder is untouched and remains the record;\\\\\\\\n     8\\\\\\\\tthe front end, the API and the page build read this copy.\\\\\\\\ndocs/DECISIONS-log.md:3509:- Alex, after the browser check showed v49's state as \\\\\\\\\\\\\\\"No No restriction adopted\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\"修，然后 merge main\\\\\\\\\\\\\\\".\\\\\\\\ndocs/DECISIONS-log.md:3510:- Mechanism: the state chip and the chart's spoken text join the score and the rung label. A two-rung ladder's score is Yes/No; when the ladder names its outcomes (06-views allows named outcomes for yes/no theme theses), the label repeats it. Census: 1 of 55 two-rung theses in the served ledger (v49: Restriction adopted / No restriction adopted) and 1 in the 2026-10-27 snapshot (Permission granted / Permission not granted).\\\\\\\\ndocs/DECISIONS-log.md:3512:- Result: the D336 UI test fails on the old composition (\\\\\\\\\\\\\\\"No No restriction adopted\\\\\\\\\\\\\\\"); 58 UI tests, lint, format and the 20 standing UI mutation checks pass. In headless Chrome, with the cache disabled, v49 shows \\\\\\\\\\\\\\\"No restriction adopted\\\\\\\\\\\\\\\" and v14 \\\\\\\\\\\\\\\"Yes\\\\\\\\\\\\\\\".\\\\\\\\npoc/ui/test/composite.test.js:302:  named.rungs[0].label = 'Restriction adopted';\\\\\\\\npoc/ui/test/composite.test.js:303:  named.rungs[1].label = 'No restriction adopted';\\\\\\\\npoc/ui/test/composite.test.js:308:  assert.equal(stateText(thesis, 2), 'No restriction adopted');\\\\\\\\npoc/ui/test/composite.test.js:311:    '<span class=\\\\\\\\\\\\\\\"chip chip--state state--negative\\\\\\\\\\\\\\\"><b>No restriction adopted</b></span>',\\\\\\\\n\\\\\\\",\\\\\\\"exit_code\\\\\\\":0,\\\\\\\"status\\\\\\\":\\\\\\\"completed\\\\\\\"}}\\\\ndocs/research/2026-11-22-number-answers/codex-r72c.stream:80:{\\\\\\\"type\\\\\\\":\\\\\\\"item.completed\\\\\\\",\\\\\\\"item\\\\\\\":{\\\\\\\"id\\\\\\\":\\\\\\\"item_41\\\\\\\",\\\\\\\"type\\\\\\\":\\\\\\\"agent_message\\\\\\\",\\\\\\\"text\\\\\\\":\\\\\\\"1. **The single export closes the old routes if the release builder takes its data only from that exporter.** That covers the idea card, both places where its summary re-reads the ladder, the closing sentence, the live `/library` reload, translated JSON and composite trials. One detail still matters at handoff. A marker and version identify a format. They cannot establish who supplied the text in an allowed field. Have the builder call the exporter directly, and check the finished package as well as the page. The current builder accepts external JSON, embeds market data and trials separately, and writes beside the translated export. A page can make zero fetches while its package still contains the unrestricted file. [Design §2:35](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/FORECAST-UNAVAILABLE-DESIGN.md:35) · [mock_build.py:20](/Users/lchingen/hivemind/scripts/mock_build.py:20) · [mock_build.py:54](/Users/lchingen/hivemind/scripts/mock_build.py:54) · [mock_translate.py:129](/Users/lchingen/hivemind/scripts/mock_translate.py:129) · [idea.py:346](/Users/lchingen/hivemind/src/hivemind/idea.py:346)\\\\\\\\n\\\\\\\\n2. **§3 classified the stored questions correctly.** I independently found 19, 17 and 18 number questions in the three comparison stores. In the sealed ledger, withholding covered 43 money questions and 21 other numeric questions. All 30 Chinese Yes/No pairs were recognized. The Xbox question correctly kept its Yes/No answer despite having bounds around zero. One distinction matters for release prose. **All 85 comparison-store events are also Yes/No questions**, including both known leaks. The §4 prose rule must apply to them even when the event check matches first. The served ledger also has a binary event labeled “Restriction adopted” and “No restriction adopted.” Its existing answer label should remain usable under the same prose rule. [Design §3:65](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/FORECAST-UNAVAILABLE-DESIGN.md:65) · [vocabulary.py:24](/Users/lchingen/hivemind/src/hivemind/vocabulary.py:24) · [test_service.py:90](/Users/lchingen/hivemind/tests/test_service.py:90) · [named event decision:3510](/Users/lchingen/hivemind/docs/DECISIONS-log.md:3510)\\\\\\\\n\\\\\\\\n3. **Recommend (a) for the first release. Option (b) is measurable, but §4 overstates what it proves.** I matched each Yes/No judgement to its archived request by call ID and request hash. Counting requests with no directly shown number-question state, (b) would keep **31/769**, **44/776** and **43/958** explanations across the three comparison runs. For a reader viewing the latest answer, it would keep explanations on **21/85 questions**. It would also keep **73/73** historical explanations in the sealed ledger. That is the benefit Alex would give up under (a). The limit is that a request also includes the question’s previous reasoning and can include another Yes/No question’s reasoning. Either can carry a forecast it saw earlier. Checking the current request for a directly shown number question cannot justify §4’s promise that the explanation “cannot quote a number forecast.” Both known disclosures are specifically in `why_changed`, including “around $1 trillion” in `old-3/v36`. [Design §4:84](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/FORECAST-UNAVAILABLE-DESIGN.md:84) · [archived requests:40](/Users/lchingen/hivemind/src/hivemind/model.py:40) · [judgement-to-request link:308](/Users/lchingen/hivemind/src/hivemind/views/judging.py:308) · [reasoning copied into requests:202](/Users/lchingen/hivemind/src/hivemind/views/judging.py:202) · [stored cases:27](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/FORECAST-UNAVAILABLE-DESIGN.md:27)\\\\\\\\n\\\\\\\\n4. **Before handoff, write one end-to-end acceptance case around what the reader gets.** Use `old-1/v8` as the only question in an idea. Its sources and “Forecast unavailable” must survive onto the card, with no scored driver and no invented replacement band. This matters because the current idea code expects an endpoint for every scoring candidate. In the same release package, verify that the two known event answers retain their labels and omit the spending forecasts under Alex’s chosen prose rule. Keep the design’s separate real closing-switch check. This review was read-only and cost $0. [idea_composite.py:214](/Users/lchingen/hivemind/src/hivemind/idea_composite.py:214) · [idea_composite.py:231](/Users/lchingen/hivemind/src/hivemind/idea_composite.py:231) · [design acceptance:115](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/FORECAST-UNAVAILABLE-DESIGN.md:115) · [Alex’s release decision:11833](/Users/lchingen/hivemind/docs/DECISIONS-log.md:11833)\\\\\\\\n\\\\\\\\n**Verdict — not ready as written.** Keep the single exporter and §3. Make the package boundary enforceable, apply one prose rule across overlapping event and Yes/No questions, and put the measured trade-off to Alex with **(a)** recommended.\\\\\\\"}}\\\\ndocs/research/2026-11-22-number-answers/codex-r72c.md:3:2. **§3 classified the stored questions correctly.** I independently found 19, 17 and 18 number questions in the three comparison stores. In the sealed ledger, withholding covered 43 money questions and 21 other numeric questions. All 30 Chinese Yes/No pairs were recognized. The Xbox question correctly kept its Yes/No answer despite having bounds around zero. One distinction matters for release prose. **All 85 comparison-store events are also Yes/No questions**, including both known leaks. The §4 prose rule must apply to them even when the event check matches first. The served ledger also has a binary event labeled “Restriction adopted” and “No restriction adopted.” Its existing answer label should remain usable under the same prose rule. [Design §3:65](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/FORECAST-UNAVAILABLE-DESIGN.md:65) · [vocabulary.py:24](/Users/lchingen/hivemind/src/hivemind/vocabulary.py:24) · [test_service.py:90](/Users/lchingen/hivemind/tests/test_service.py:90) · [named event decision:3510](/Users/lchingen/hivemind/docs/DECISIONS-log.md:3510)\\\\ndocs/research/2026-11-22-number-answers/FORECAST-UNAVAILABLE-DESIGN.md:86:binary event such as \\\\\\\"Restriction adopted\\\\\\\" / \\\\\\\"No restriction adopted\\\\\\\" exists in the served ledger (council 72c). §4's rule applies to\\\\ndocs/research/2026-11-22-number-answers/codex-r73.stream:15:{\\\\\\\"type\\\\\\\":\\\\\\\"item.completed\\\\\\\",\\\\\\\"item\\\\\\\":{\\\\\\\"id\\\\\\\":\\\\\\\"item_8\\\\\\\",\\\\\\\"type\\\\\\\":\\\\\\\"command_execution\\\\\\\",\\\\\\\"command\\\\\\\":\\\\\\\"/opt/homebrew/bin/zsh -lc 'nl -ba docs/research/2026-11-22-number-answers/FORECAST-UNAVAILABLE-DESIGN.md'\\\\\\\",\\\\\\\"aggregated_output\\\\\\\":\\\\\\\"     1\\\\\\\\t# \\\\\\\\\\\\\\\"Forecast unavailable\\\\\\\\\\\\\\\" for number questions: the design, ready for when release work opens\\\\\\\\n     2\\\\\\\\t\\\\\\\\n     3\\\\\\\\t**Status: design only. Nothing is built.** Alex decided the behaviour twice:\\\\\\\\n     4\\\\\\\\t- D726, \\\\\\\\\\\\\\\"同意\\\\\\\\\\\\\\\": until the number answers pass, a first release shows number questions with their sources and \\\\\\\\\\\\\\\"Forecast unavailable\\\\\\\\\\\\\\\",\\\\\\\\n     5\\\\\\\\t  with the band, the forecast text and its history withheld together; \\\\\\\\\\\\\\\"it is built with the release work, which is not started\\\\\\\\\\\\\\\";\\\\\\\\n     6\\\\\\\\t- D756, \\\\\\\\\\\\\\\"结束这条线，预测暂缺上线\\\\\\\\\\\\\\\".\\\\\\\\n     7\\\\\\\\t\\\\\\\\n     8\\\\\\\\tOpening release work is Alex's call (council 72). This page makes the build a known, reviewed slice for that moment.\\\\\\\\n     9\\\\\\\\t\\\\\\\\n    10\\\\\\\\t**Revision 4 (council 72c) of revision 3: one structural rule instead of a list of leaks.** Rounds 72 and 72b each found new paths by which a withheld forecast\\\\\\\\n    11\\\\\\\\tcould reach a reader:\\\\\\\\n    12\\\\\\\\t- the idea card;\\\\\\\\n    13\\\\\\\\t- the closing text;\\\\\\\\n    14\\\\\\\\t- an idea summary that re-reads the ladder;\\\\\\\\n    15\\\\\\\\t- a release page that reloads from the live POC service;\\\\\\\\n    16\\\\\\\\t- a translated export;\\\\\\\\n    17\\\\\\\\t- a Yes/No explanation that quotes a number question's band.\\\\\\\\n    18\\\\\\\\t\\\\\\\\n    19\\\\\\\\tA rule that withholds fields reader by reader will keep missing one (AGENTS §1: \\\\\\\\\\\\\\\"when one mechanism draws findings round after round,\\\\\\\\n    20\\\\\\\\tstop answering findings: propose one structural rule\\\\\\\\\\\\\\\"). Revision 3 replaces that rule with an allow-list at one boundary.\\\\\\\\n    21\\\\\\\\t\\\\\\\\n    22\\\\\\\\t## 1. The gap, measured at $0 (2026-11-23)\\\\\\\\n    23\\\\\\\\t\\\\\\\\n    24\\\\\\\\tThe stored poc-v118 store `poc/data/comparison-2026-11-17/run/old-1/prod/views.sqlite`, read-only, gives:\\\\\\\\n    25\\\\\\\\t- **The number question v8 (FY2027 Data Center revenue)** exposes its band, label, condition, reasons, 75 judgements and 69 change rows.\\\\\\\\n    26\\\\\\\\t- **Its idea input** reads \\\\\\\\\\\\\\\"Bullish … $350 billion to under $400 billion\\\\\\\\\\\\\\\".\\\\\\\\n    27\\\\\\\\t- **Yes/No explanations quote number forecasts:**\\\\\\\\n    28\\\\\\\\t  - `old-3` `v36`, judgement 799: \\\\\\\\\\\\\\\"around $1 trillion\\\\\\\\\\\\\\\" for 2027 spending;\\\\\\\\n    29\\\\\\\\t  - `old-1` `v10`, judgement 865: the selected bands of both spending questions.\\\\\\\\n    30\\\\\\\\t\\\\\\\\n    31\\\\\\\\t  The judge is shown related questions' selected bands (`views/judging.py:208`), and its prose can repeat them.\\\\\\\\n    32\\\\\\\\t\\\\\\\\n    33\\\\\\\\t## 2. The structural rule: one release export, allow-listed\\\\\\\\n    34\\\\\\\\t\\\\\\\\n    35\\\\\\\\t- **One exporter writes the release data:** `release_export`, a single function beside `service.py`. It emits only the fields on an\\\\\\\\n    36\\\\\\\\t  explicit allow-list. A field not on the list cannot appear, so a new or overlooked path fails closed.\\\\\\\\n    37\\\\\\\\t- **The release builder calls `release_export` directly** and accepts no external input; a marker or version names a format, not\\\\\\\\n    38\\\\\\\\t  who wrote the text (council 72c). The finished package is checked as well as the page: it holds only the export's output, with no\\\\\\\\n    39\\\\\\\\t  market data, composite trials or translated file beside it.\\\\\\\\n    40\\\\\\\\t- **The release reads only that export.** Its page, its static build and its API, if any, read nothing else:\\\\\\\\n    41\\\\\\\\t  - no live POC service;\\\\\\\\n    42\\\\\\\\t  - no `/library` reload (`poc/ui/src/bootstrap.js` must not fetch in a release build);\\\\\\\\n    43\\\\\\\\t  - no prepared or translated JSON (`scripts/mock_translate.py`'s `data.en.json`);\\\\\\\\n    44\\\\\\\\t  - no `--composite-trials` input.\\\\\\\\n    45\\\\\\\\t\\\\\\\\n    46\\\\\\\\t  The static builder refuses any input not produced by `release_export`, which carries a marker and the allow-list version.\\\\\\\\n    47\\\\\\\\t- **For a number question, the allow-list is:**\\\\\\\\n    48\\\\\\\\t  - the question and its id;\\\\\\\\n    49\\\\\\\\t  - the evidence in force: one-line, quote, speaker, original day, tier and sources, amounts as quoted;\\\\\\\\n    50\\\\\\\\t  - the marker \\\\\\\\\\\\\\\"Forecast unavailable\\\\\\\\\\\\\\\".\\\\\\\\n    51\\\\\\\\t\\\\\\\\n    52\\\\\\\\t  Nothing else is listed:\\\\\\\\n    53\\\\\\\\t  - no ladder;\\\\\\\\n    54\\\\\\\\t  - no band, label or condition;\\\\\\\\n    55\\\\\\\\t  - no reasons or why_changed;\\\\\\\\n    56\\\\\\\\t  - no history, counts or assessment dates;\\\\\\\\n    57\\\\\\\\t  - no closing band (\\\\\\\\\\\\\\\"closed\\\\\\\\\\\\\\\" only);\\\\\\\\n    58\\\\\\\\t  - no theme pushes, no composite, no idea derived from its forecast.\\\\\\\\n    59\\\\\\\\t- **Ideas.** The release's idea composition (`idea.py`, `idea_composite.py`) runs on export data only. A number question enters it\\\\\\\\n    60\\\\\\\\t  as question and evidence with the marker. Its ladder is not read from storage in either the answer-format build or the summary\\\\\\\\n    61\\\\\\\\t  input (`idea_composite.py:255`, `:281`; `poc-v118-idea.json:94`). The test inspects the composed request itself, not only the\\\\\\\\n    62\\\\\\\\t  delivered card.\\\\\\\\n    63\\\\\\\\t- **The POC is unchanged.** Its API, MCP and page keep today's behaviour. Whether colleagues' POC page also changes is a separate\\\\\\\\n    64\\\\\\\\t  later choice for Alex.\\\\\\\\n    65\\\\\\\\t\\\\\\\\n    66\\\\\\\\t## 3. Identity: what a number question is (verified on four stores by council 72b)\\\\\\\\n    67\\\\\\\\t\\\\\\\\n    68\\\\\\\\tA view is a number question unless one of the following excludes it:\\\\\\\\n    69\\\\\\\\t1. **An event.** The view key's measure is in `identity.EVENT_MEASURES` (`event`, `policy_event`). That covers 85 of 85 event\\\\\\\\n    70\\\\\\\\t   questions in the three comparison stores.\\\\\\\\n    71\\\\\\\\t2. **A Yes/No question.** The ladder has exactly two labels which, canonicalised with the existing vocabulary\\\\\\\\n    72\\\\\\\\t   (`vocabulary.canonical`), are Yes and No in either order. The sealed ledger's 30 such questions use `是` and `否`. The Xbox `v37`\\\\\\\\n    73\\\\\\\\t   (`growth_rate`, bounds around zero) is Yes/No.\\\\\\\\n    74\\\\\\\\t\\\\\\\\n    75\\\\\\\\tEvery other view is a number question. Its forecast is withheld whether its bands come from `lo`/`hi`, parse from the conditions\\\\\\\\n    76\\\\\\\\t(the sealed `v3`), or cannot be resolved. An unresolved record is withheld and listed in the release check, with a key or without\\\\\\\\n    77\\\\\\\\t(council 72b: an `old-1/v8` copy without bounds does not parse, and its key still exists).\\\\\\\\n    78\\\\\\\\t\\\\\\\\n    79\\\\\\\\tCounts (council 72b), number / event or Yes/No:\\\\\\\\n    80\\\\\\\\t- `old-1` 19 / 28, `old-2` 17 / 26, `old-3` 18 / 31;\\\\\\\\n    81\\\\\\\\t- the sealed ledger: 43 parse as money, 21 are withheld as unresolved, 30 are Yes/No.\\\\\\\\n    82\\\\\\\\t\\\\\\\\n    83\\\\\\\\tNo wrong show-or-withhold result was found.\\\\\\\\n    84\\\\\\\\t\\\\\\\\n    85\\\\\\\\t**Events are binary too.** All 85 comparison-store events are also two-answer questions, including both known prose leaks, and a\\\\\\\\n    86\\\\\\\\tbinary event such as \\\\\\\\\\\\\\\"Restriction adopted\\\\\\\\\\\\\\\" / \\\\\\\\\\\\\\\"No restriction adopted\\\\\\\\\\\\\\\" exists in the served ledger (council 72c). §4's rule applies to\\\\\\\\n    87\\\\\\\\tevery question that is not a number question, events and Yes/No alike, and each keeps its answer label.\\\\\\\\n    88\\\\\\\\t\\\\\\\\n    89\\\\\\\\t## 4. Questions that are not number questions: an open choice for Alex (not decided here)\\\\\\\\n    90\\\\\\\\t\\\\\\\\n    91\\\\\\\\tD726 covers number questions. A Yes/No question's band is not a number forecast, but its stored explanation can quote one (§1). The\\\\\\\\n    92\\\\\\\\tallow-list must say which Yes/No fields the release shows:\\\\\\\\n    93\\\\\\\\t- **(a)** the question, its evidence and its answer (Yes/No and label), with no explanation text. Safe, and it removes the reasoning\\\\\\\\n    94\\\\\\\\t  readers would see.\\\\\\\\n    95\\\\\\\\t- **(b)** as (a), plus the explanation only for judgements whose request showed the judge no number question's state. Code can\\\\\\\\n    96\\\\\\\\t  decide this from the stored request (`views/judging.py`, which builds the related questions shown).\\\\\\\\n    97\\\\\\\\t- **Measured (council 72c),** matching each judgement to its archived request:\\\\\\\\n    98\\\\\\\\t  - (b) would keep explanations on 31 of 769, 44 of 776 and 43 of 958 judgements in the three comparison runs;\\\\\\\\n    99\\\\\\\\t  - for a reader at the latest answer, it would keep them on 21 of 85 questions;\\\\\\\\n   100\\\\\\\\t  - it would keep 73 of 73 in the sealed ledger.\\\\\\\\n   101\\\\\\\\t- **The limit of (b).** It cannot promise the prose quotes no number forecast. A request also carries the question's own previous\\\\\\\\n   102\\\\\\\\t  reasoning, and can carry another question's, either of which may repeat a forecast seen earlier. Both known leaks are in\\\\\\\\n   103\\\\\\\\t  `why_changed`.\\\\\\\\n   104\\\\\\\\t- **Recommendation: (a) for the first release** (council 72c; Claude agrees, withdrawing its lean for (b)). It is the only option\\\\\\\\n   105\\\\\\\\t  that guarantees no number forecast reaches a reader through prose. (b) remains a measured later step.\\\\\\\\n   106\\\\\\\\t\\\\\\\\n   107\\\\\\\\t## 5. Tests and the $0 release check (each names its row above)\\\\\\\\n   108\\\\\\\\t\\\\\\\\n   109\\\\\\\\t- **Fixtures (real store on a temporary path):**\\\\\\\\n   110\\\\\\\\t  - a number question with `lo`/`hi`;\\\\\\\\n   111\\\\\\\\t  - one with bounds only in its conditions;\\\\\\\\n   112\\\\\\\\t  - an unresolved one with a key;\\\\\\\\n   113\\\\\\\\t  - a Yes/No question with numeric bounds;\\\\\\\\n   114\\\\\\\\t  - an event question;\\\\\\\\n   115\\\\\\\\t  - a Yes/No judgement whose prose quotes a number band;\\\\\\\\n   116\\\\\\\\t  - a real closing switch;\\\\\\\\n   117\\\\\\\\t  - an idea.\\\\\\\\n   118\\\\\\\\t- **What the tests assert.** `release_export`'s output holds only allow-listed keys (a schema check that fails on any extra key). For\\\\\\\\n   119\\\\\\\\t  number questions it holds no band, ladder, reasons, history, date or closing band; Yes/No follows §4's choice. The static build\\\\\\\\n   120\\\\\\\\t  refuses foreign input, and a release page makes no network fetch.\\\\\\\\n   121\\\\\\\\t- **Mutants:**\\\\\\\\n   122\\\\\\\\t  - an extra field;\\\\\\\\n   123\\\\\\\\t  - a fetch left on;\\\\\\\\n   124\\\\\\\\t  - a ladder read in idea composition;\\\\\\\\n   125\\\\\\\\t  - the identity mis-sorting each fixture.\\\\\\\\n   126\\\\\\\\t\\\\\\\\n   127\\\\\\\\t  Each must fail.\\\\\\\\n   128\\\\\\\\t- **End-to-end acceptance (council 72c):**\\\\\\\\n   129\\\\\\\\t  - an idea whose only question is `old-1/v8`: the card keeps its sources and \\\\\\\\\\\\\\\"Forecast unavailable\\\\\\\\\\\\\\\", with no scored driver and no\\\\\\\\n   130\\\\\\\\t    substitute band (the current composite expects an endpoint for every scoring candidate, `idea_composite.py:214`, `:231`);\\\\\\\\n   131\\\\\\\\t  - in the same release package, the two known event answers keep their labels and carry no spending forecast under the chosen\\\\\\\\n   132\\\\\\\\t    prose rule.\\\\\\\\n   133\\\\\\\\t- **The $0 release check.**\\\\\\\\n   134\\\\\\\\t  - On `old-1/v8`, confirm the marker and the same sources in the page and in the export data.\\\\\\\\n   135\\\\\\\\t  - Exercise closure on a temporary copy with a real closing switch, after first confirming that the unrestricted response exposes the\\\\\\\\n   136\\\\\\\\t    final band there.\\\\\\\\n   137\\\\\\\\t  - Check ideas with a recorded or test transport, inspecting the composed request.\\\\\\\\n   138\\\\\\\\t  - Use `old-3/v36` and `old-1/v10` as the Yes/No prose cases.\\\\\\\\n   139\\\\\\\\t  - Use one unchanged event question as the control.\\\\\\\\n   140\\\\\\\\t\\\\\\\\n   141\\\\\\\\t## 6. Not in scope\\\\\\\\n   142\\\\\\\\t\\\\\\\\n   143\\\\\\\\t- The judging, opening and extraction pieces (frozen).\\\\\\\\n   144\\\\\\\\t- The closed v13s line.\\\\\\\\n   145\\\\\\\\t- Other open defects.\\\\\\\\n   146\\\\\\\\t- No prompt or pipeline change.\\\\\\\\n   147\\\\\\\\t- The POC's own behaviour.\\\\\\\\n\\\\\\\",\\\\\\\"exit_code\\\\\\\":0,\\\\\\\"status\\\\\\\":\\\\\\\"completed\\\\\\\"}}\\\\ndocs/research/2026-11-22-number-answers/codex-r72d.stream:11:{\\\\\\\"type\\\\\\\":\\\\\\\"item.completed\\\\\\\",\\\\\\\"item\\\\\\\":{\\\\\\\"id\\\\\\\":\\\\\\\"item_4\\\\\\\",\\\\\\\"type\\\\\\\":\\\\\\\"command_execution\\\\\\\",\\\\\\\"command\\\\\\\":\\\\\\\"/opt/homebrew/bin/zsh -lc 'nl -ba docs/research/2026-11-22-number-answers/codex-r72c.md'\\\\\\\",\\\\\\\"aggregated_output\\\\\\\":\\\\\\\"     1\\\\\\\\t1. **The single export closes the old routes if the release builder takes its data only from that exporter.** That covers the idea card, both places where its summary re-reads the ladder, the closing sentence, the live `/library` reload, translated JSON and composite trials. One detail still matters at handoff. A marker and version identify a format. They cannot establish who supplied the text in an allowed field. Have the builder call the exporter directly, and check the finished package as well as the page. The current builder accepts external JSON, embeds market data and trials separately, and writes beside the translated export. A page can make zero fetches while its package still contains the unrestricted file. [Design §2:35](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/FORECAST-UNAVAILABLE-DESIGN.md:35) · [mock_build.py:20](/Users/lchingen/hivemind/scripts/mock_build.py:20) · [mock_build.py:54](/Users/lchingen/hivemind/scripts/mock_build.py:54) · [mock_translate.py:129](/Users/lchingen/hivemind/scripts/mock_translate.py:129) · [idea.py:346](/Users/lchingen/hivemind/src/hivemind/idea.py:346)\\\\\\\\n     2\\\\\\\\t\\\\\\\\n     3\\\\\\\\t2. **§3 classified the stored questions correctly.** I independently found 19, 17 and 18 number questions in the three comparison stores. In the sealed ledger, withholding covered 43 money questions and 21 other numeric questions. All 30 Chinese Yes/No pairs were recognized. The Xbox question correctly kept its Yes/No answer despite having bounds around zero. One distinction matters for release prose. **All 85 comparison-store events are also Yes/No questions**, including both known leaks. The §4 prose rule must apply to them even when the event check matches first. The served ledger also has a binary event labeled “Restriction adopted” and “No restriction adopted.” Its existing answer label should remain usable under the same prose rule. [Design §3:65](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/FORECAST-UNAVAILABLE-DESIGN.md:65) · [vocabulary.py:24](/Users/lchingen/hivemind/src/hivemind/vocabulary.py:24) · [test_service.py:90](/Users/lchingen/hivemind/tests/test_service.py:90) · [named event decision:3510](/Users/lchingen/hivemind/docs/DECISIONS-log.md:3510)\\\\\\\\n     4\\\\\\\\t\\\\\\\\n     5\\\\\\\\t3. **Recommend (a) for the first release. Option (b) is measurable, but §4 overstates what it proves.** I matched each Yes/No judgement to its archived request by call ID and request hash. Counting requests with no directly shown number-question state, (b) would keep **31/769**, **44/776** and **43/958** explanations across the three comparison runs. For a reader viewing the latest answer, it would keep explanations on **21/85 questions**. It would also keep **73/73** historical explanations in the sealed ledger. That is the benefit Alex would give up under (a). The limit is that a request also includes the question’s previous reasoning and can include another Yes/No question’s reasoning. Either can carry a forecast it saw earlier. Checking the current request for a directly shown number question cannot justify §4’s promise that the explanation “cannot quote a number forecast.” Both known disclosures are specifically in `why_changed`, including “around $1 trillion” in `old-3/v36`. [Design §4:84](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/FORECAST-UNAVAILABLE-DESIGN.md:84) · [archived requests:40](/Users/lchingen/hivemind/src/hivemind/model.py:40) · [judgement-to-request link:308](/Users/lchingen/hivemind/src/hivemind/views/judging.py:308) · [reasoning copied into requests:202](/Users/lchingen/hivemind/src/hivemind/views/judging.py:202) · [stored cases:27](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/FORECAST-UNAVAILABLE-DESIGN.md:27)\\\\\\\\n     6\\\\\\\\t\\\\\\\\n     7\\\\\\\\t4. **Before handoff, write one end-to-end acceptance case around what the reader gets.** Use `old-1/v8` as the only question in an idea. Its sources and “Forecast unavailable” must survive onto the card, with no scored driver and no invented replacement band. This matters because the current idea code expects an endpoint for every scoring candidate. In the same release package, verify that the two known event answers retain their labels and omit the spending forecasts under Alex’s chosen prose rule. Keep the design’s separate real closing-switch check. This review was read-only and cost $0. [idea_composite.py:214](/Users/lchingen/hivemind/src/hivemind/idea_composite.py:214) · [idea_composite.py:231](/Users/lchingen/hivemind/src/hivemind/idea_composite.py:231) · [design acceptance:115](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/FORECAST-UNAVAILABLE-DESIGN.md:115) · [Alex’s release decision:11833](/Users/lchingen/hivemind/docs/DECISIONS-log.md:11833)\\\\\\\\n     8\\\\\\\\t\\\\\\\\n     9\\\\\\\\t**Verdict — not ready as written.** Keep the single exporter and §3. Make the package boundary enforceable, apply one prose rule across overlapping event and Yes/No questions, and put the measured trade-off to Alex with **(a)** recommended.\\\\\\\",\\\\\\\"exit_code\\\\\\\":0,\\\\\\\"status\\\\\\\":\\\\\\\"completed\\\\\\\"}}\\\\ndocs/research/2026-11-22-number-answers/codex-r72d.stream:13:{\\\\\\\"type\\\\\\\":\\\\\\\"item.completed\\\\\\\",\\\\\\\"item\\\\\\\":{\\\\\\\"id\\\\\\\":\\\\\\\"item_6\\\\\\\",\\\\\\\"type\\\\\\\":\\\\\\\"command_execution\\\\\\\",\\\\\\\"command\\\\\\\":\\\\\\\"/opt/homebrew/bin/zsh -lc 'nl -ba docs/research/2026-11-22-number-answers/FORECAST-UNAVAILABLE-DESIGN.md'\\\\\\\",\\\\\\\"aggregated_output\\\\\\\":\\\\\\\"     1\\\\\\\\t# \\\\\\\\\\\\\\\"Forecast unavailable\\\\\\\\\\\\\\\" for number questions: the design, ready for when release work opens\\\\\\\\n     2\\\\\\\\t\\\\\\\\n     3\\\\\\\\t**Status: design only. Nothing is built.** Alex decided the behaviour twice:\\\\\\\\n     4\\\\\\\\t- D726, \\\\\\\\\\\\\\\"同意\\\\\\\\\\\\\\\": until the number answers pass, a first release shows number questions with their sources and \\\\\\\\\\\\\\\"Forecast unavailable\\\\\\\\\\\\\\\",\\\\\\\\n     5\\\\\\\\t  with the band, the forecast text and its history withheld together; \\\\\\\\\\\\\\\"it is built with the release work, which is not started\\\\\\\\\\\\\\\";\\\\\\\\n     6\\\\\\\\t- D756, \\\\\\\\\\\\\\\"结束这条线，预测暂缺上线\\\\\\\\\\\\\\\".\\\\\\\\n     7\\\\\\\\t\\\\\\\\n     8\\\\\\\\tOpening release work is Alex's call (council 72). This page makes the build a known, reviewed slice for that moment.\\\\\\\\n     9\\\\\\\\t\\\\\\\\n    10\\\\\\\\t**Revision 4 (council 72c) of revision 3: one structural rule instead of a list of leaks.** Rounds 72 and 72b each found new paths by which a withheld forecast\\\\\\\\n    11\\\\\\\\tcould reach a reader:\\\\\\\\n    12\\\\\\\\t- the idea card;\\\\\\\\n    13\\\\\\\\t- the closing text;\\\\\\\\n    14\\\\\\\\t- an idea summary that re-reads the ladder;\\\\\\\\n    15\\\\\\\\t- a release page that reloads from the live POC service;\\\\\\\\n    16\\\\\\\\t- a translated export;\\\\\\\\n    17\\\\\\\\t- a Yes/No explanation that quotes a number question's band.\\\\\\\\n    18\\\\\\\\t\\\\\\\\n    19\\\\\\\\tA rule that withholds fields reader by reader will keep missing one (AGENTS §1: \\\\\\\\\\\\\\\"when one mechanism draws findings round after round,\\\\\\\\n    20\\\\\\\\tstop answering findings: propose one structural rule\\\\\\\\\\\\\\\"). Revision 3 replaces that rule with an allow-list at one boundary.\\\\\\\\n    21\\\\\\\\t\\\\\\\\n    22\\\\\\\\t## 1. The gap, measured at $0 (2026-11-23)\\\\\\\\n    23\\\\\\\\t\\\\\\\\n    24\\\\\\\\tThe stored poc-v118 store `poc/data/comparison-2026-11-17/run/old-1/prod/views.sqlite`, read-only, gives:\\\\\\\\n    25\\\\\\\\t- **The number question v8 (FY2027 Data Center revenue)** exposes its band, label, condition, reasons, 75 judgements and 69 change rows.\\\\\\\\n    26\\\\\\\\t- **Its idea input** reads \\\\\\\\\\\\\\\"Bullish … $350 billion to under $400 billion\\\\\\\\\\\\\\\".\\\\\\\\n    27\\\\\\\\t- **Yes/No explanations quote number forecasts:**\\\\\\\\n    28\\\\\\\\t  - `old-3` `v36`, judgement 799: \\\\\\\\\\\\\\\"around $1 trillion\\\\\\\\\\\\\\\" for 2027 spending;\\\\\\\\n    29\\\\\\\\t  - `old-1` `v10`, judgement 865: the selected bands of both spending questions.\\\\\\\\n    30\\\\\\\\t\\\\\\\\n    31\\\\\\\\t  The judge is shown related questions' selected bands (`views/judging.py:208`), and its prose can repeat them.\\\\\\\\n    32\\\\\\\\t\\\\\\\\n    33\\\\\\\\t## 2. The structural rule: one release export, allow-listed\\\\\\\\n    34\\\\\\\\t\\\\\\\\n    35\\\\\\\\t- **One exporter writes the release data:** `release_export`, a single function beside `service.py`. It emits only the fields on an\\\\\\\\n    36\\\\\\\\t  explicit allow-list. A field not on the list cannot appear, so a new or overlooked path fails closed.\\\\\\\\n    37\\\\\\\\t- **The release builder calls `release_export` directly** and accepts no external input; a marker or version names a format, not\\\\\\\\n    38\\\\\\\\t  who wrote the text (council 72c). The finished package is checked as well as the page: it holds only the export's output, with no\\\\\\\\n    39\\\\\\\\t  market data, composite trials or translated file beside it.\\\\\\\\n    40\\\\\\\\t- **The release reads only that export.** Its page, its static build and its API, if any, read nothing else:\\\\\\\\n    41\\\\\\\\t  - no live POC service;\\\\\\\\n    42\\\\\\\\t  - no `/library` reload (`poc/ui/src/bootstrap.js` must not fetch in a release build);\\\\\\\\n    43\\\\\\\\t  - no prepared or translated JSON (`scripts/mock_translate.py`'s `data.en.json`);\\\\\\\\n    44\\\\\\\\t  - no `--composite-trials` input.\\\\\\\\n    45\\\\\\\\t\\\\\\\\n    46\\\\\\\\t  The static builder refuses any input not produced by `release_export`, which carries a marker and the allow-list version.\\\\\\\\n    47\\\\\\\\t- **For a number question, the allow-list is:**\\\\\\\\n    48\\\\\\\\t  - the question and its id;\\\\\\\\n    49\\\\\\\\t  - the evidence in force: one-line, quote, speaker, original day, tier and sources, amounts as quoted;\\\\\\\\n    50\\\\\\\\t  - the marker \\\\\\\\\\\\\\\"Forecast unavailable\\\\\\\\\\\\\\\".\\\\\\\\n    51\\\\\\\\t\\\\\\\\n    52\\\\\\\\t  Nothing else is listed:\\\\\\\\n    53\\\\\\\\t  - no ladder;\\\\\\\\n    54\\\\\\\\t  - no band, label or condition;\\\\\\\\n    55\\\\\\\\t  - no reasons or why_changed;\\\\\\\\n    56\\\\\\\\t  - no history, counts or assessment dates;\\\\\\\\n    57\\\\\\\\t  - no closing band (\\\\\\\\\\\\\\\"closed\\\\\\\\\\\\\\\" only);\\\\\\\\n    58\\\\\\\\t  - no theme pushes, no composite, no idea derived from its forecast.\\\\\\\\n    59\\\\\\\\t- **Ideas.** The release's idea composition (`idea.py`, `idea_composite.py`) runs on export data only. A number question enters it\\\\\\\\n    60\\\\\\\\t  as question and evidence with the marker. Its ladder is not read from storage in either the answer-format build or the summary\\\\\\\\n    61\\\\\\\\t  input (`idea_composite.py:255`, `:281`; `poc-v118-idea.json:94`). The test inspects the composed request itself, not only the\\\\\\\\n    62\\\\\\\\t  delivered card.\\\\\\\\n    63\\\\\\\\t- **The POC is unchanged.** Its API, MCP and page keep today's behaviour. Whether colleagues' POC page also changes is a separate\\\\\\\\n    64\\\\\\\\t  later choice for Alex.\\\\\\\\n    65\\\\\\\\t\\\\\\\\n    66\\\\\\\\t## 3. Identity: what a number question is (verified on four stores by council 72b)\\\\\\\\n    67\\\\\\\\t\\\\\\\\n    68\\\\\\\\tA view is a number question unless one of the following excludes it:\\\\\\\\n    69\\\\\\\\t1. **An event.** The view key's measure is in `identity.EVENT_MEASURES` (`event`, `policy_event`). That covers 85 of 85 event\\\\\\\\n    70\\\\\\\\t   questions in the three comparison stores.\\\\\\\\n    71\\\\\\\\t2. **A Yes/No question.** The ladder has exactly two labels which, canonicalised with the existing vocabulary\\\\\\\\n    72\\\\\\\\t   (`vocabulary.canonical`), are Yes and No in either order. The sealed ledger's 30 such questions use `是` and `否`. The Xbox `v37`\\\\\\\\n    73\\\\\\\\t   (`growth_rate`, bounds around zero) is Yes/No.\\\\\\\\n    74\\\\\\\\t\\\\\\\\n    75\\\\\\\\tEvery other view is a number question. Its forecast is withheld whether its bands come from `lo`/`hi`, parse from the conditions\\\\\\\\n    76\\\\\\\\t(the sealed `v3`), or cannot be resolved. An unresolved record is withheld and listed in the release check, with a key or without\\\\\\\\n    77\\\\\\\\t(council 72b: an `old-1/v8` copy without bounds does not parse, and its key still exists).\\\\\\\\n    78\\\\\\\\t\\\\\\\\n    79\\\\\\\\tCounts (council 72b), number / event or Yes/No:\\\\\\\\n    80\\\\\\\\t- `old-1` 19 / 28, `old-2` 17 / 26, `old-3` 18 / 31;\\\\\\\\n    81\\\\\\\\t- the sealed ledger: 43 parse as money, 21 are withheld as unresolved, 30 are Yes/No.\\\\\\\\n    82\\\\\\\\t\\\\\\\\n    83\\\\\\\\tNo wrong show-or-withhold result was found.\\\\\\\\n    84\\\\\\\\t\\\\\\\\n    85\\\\\\\\t**Events are binary too.** All 85 comparison-store events are also two-answer questions, including both known prose leaks, and a\\\\\\\\n    86\\\\\\\\tbinary event such as \\\\\\\\\\\\\\\"Restriction adopted\\\\\\\\\\\\\\\" / \\\\\\\\\\\\\\\"No restriction adopted\\\\\\\\\\\\\\\" exists in the served ledger (council 72c). §4's rule applies to\\\\\\\\n    87\\\\\\\\tevery question that is not a number question, events and Yes/No alike, and each keeps its answer label.\\\\\\\\n    88\\\\\\\\t\\\\\\\\n    89\\\\\\\\t## 4. Questions that are not number questions: an open choice for Alex (not decided here)\\\\\\\\n    90\\\\\\\\t\\\\\\\\n    91\\\\\\\\tD726 covers number questions. A Yes/No question's band is not a number forecast, but its stored explanation can quote one (§1). The\\\\\\\\n    92\\\\\\\\tallow-list must say which Yes/No fields the release shows:\\\\\\\\n    93\\\\\\\\t- **(a)** the question, its evidence and its answer (Yes/No and label), with no explanation text. Safe, and it removes the reasoning\\\\\\\\n    94\\\\\\\\t  readers would see.\\\\\\\\n    95\\\\\\\\t- **(b)** as (a), plus the explanation only for judgements whose request showed the judge no number question's state. Code can\\\\\\\\n    96\\\\\\\\t  decide this from the stored request (`views/judging.py`, which builds the related questions shown). It keeps the reasoning where it\\\\\\\\n    97\\\\\\\\t  cannot quote a number forecast.\\\\\\\\n    98\\\\\\\\t- **Measured (council 72c),** matching each judgement to its archived request:\\\\\\\\n    99\\\\\\\\t  - (b) would keep explanations on 31 of 769, 44 of 776 and 43 of 958 judgements in the three comparison runs;\\\\\\\\n   100\\\\\\\\t  - for a reader at the latest answer, it would keep them on 21 of 85 questions;\\\\\\\\n   101\\\\\\\\t  - it would keep 73 of 73 in the sealed ledger.\\\\\\\\n   102\\\\\\\\t- **The limit of (b).** It cannot promise the prose quotes no number forecast. A request also carries the question's own previous\\\\\\\\n   103\\\\\\\\t  reasoning, and can carry another question's, either of which may repeat a forecast seen earlier. Both known leaks are in\\\\\\\\n   104\\\\\\\\t  `why_changed`.\\\\\\\\n   105\\\\\\\\t- **Recommendation: (a) for the first release** (council 72c; Claude agrees, withdrawing its lean for (b)). It is the only option\\\\\\\\n   106\\\\\\\\t  that guarantees no number forecast reaches a reader through prose. (b) remains a measured later step.\\\\\\\\n   107\\\\\\\\t\\\\\\\\n   108\\\\\\\\t## 5. Tests and the $0 release check (each names its row above)\\\\\\\\n   109\\\\\\\\t\\\\\\\\n   110\\\\\\\\t- **Fixtures (real store on a temporary path):**\\\\\\\\n   111\\\\\\\\t  - a number question with `lo`/`hi`;\\\\\\\\n   112\\\\\\\\t  - one with bounds only in its conditions;\\\\\\\\n   113\\\\\\\\t  - an unresolved one with a key;\\\\\\\\n   114\\\\\\\\t  - a Yes/No question with numeric bounds;\\\\\\\\n   115\\\\\\\\t  - an event question;\\\\\\\\n   116\\\\\\\\t  - a Yes/No judgement whose prose quotes a number band;\\\\\\\\n   117\\\\\\\\t  - a real closing switch;\\\\\\\\n   118\\\\\\\\t  - an idea.\\\\\\\\n   119\\\\\\\\t- **What the tests assert.** `release_export`'s output holds only allow-listed keys (a schema check that fails on any extra key). For\\\\\\\\n   120\\\\\\\\t  number questions it holds no band, ladder, reasons, history, date or closing band; Yes/No follows §4's choice. The static build\\\\\\\\n   121\\\\\\\\t  refuses foreign input, and a release page makes no network fetch.\\\\\\\\n   122\\\\\\\\t- **Mutants:**\\\\\\\\n   123\\\\\\\\t  - an extra field;\\\\\\\\n   124\\\\\\\\t  - a fetch left on;\\\\\\\\n   125\\\\\\\\t  - a ladder read in idea composition;\\\\\\\\n   126\\\\\\\\t  - the identity mis-sorting each fixture.\\\\\\\\n   127\\\\\\\\t\\\\\\\\n   128\\\\\\\\t  Each must fail.\\\\\\\\n   129\\\\\\\\t- **End-to-end acceptance (council 72c):**\\\\\\\\n   130\\\\\\\\t  - an idea whose only question is `old-1/v8`: the card keeps its sources and \\\\\\\\\\\\\\\"Forecast unavailable\\\\\\\\\\\\\\\", with no scored driver and no\\\\\\\\n   131\\\\\\\\t    substitute band (the current composite expects an endpoint for every scoring candidate, `idea_composite.py:214`, `:231`);\\\\\\\\n   132\\\\\\\\t  - in the same release package, the two known event answers keep their labels and carry no spending forecast under the chosen\\\\\\\\n   133\\\\\\\\t    prose rule.\\\\\\\\n   134\\\\\\\\t- **The $0 release check.**\\\\\\\\n   135\\\\\\\\t  - On `old-1/v8`, confirm the marker and the same sources in the page and in the export data.\\\\\\\\n   136\\\\\\\\t  - Exercise closure on a temporary copy with a real closing switch, after first confirming that the unrestricted response exposes the\\\\\\\\n   137\\\\\\\\t    final band there.\\\\\\\\n   138\\\\\\\\t  - Check ideas with a recorded or test transport, inspecting the composed request.\\\\\\\\n   139\\\\\\\\t  - Use `old-3/v36` and `old-1/v10` as the Yes/No prose cases.\\\\\\\\n   140\\\\\\\\t  - Use one unchanged event question as the control.\\\\\\\\n   141\\\\\\\\t\\\\\\\\n   142\\\\\\\\t## 6. Not in scope\\\\\\\\n   143\\\\\\\\t\\\\\\\\n   144\\\\\\\\t- The judging, opening and extraction pieces (frozen).\\\\\\\\n   145\\\\\\\\t- The closed v13s line.\\\\\\\\n   146\\\\\\\\t- Other open defects.\\\\\\\\n   147\\\\\\\\t- No prompt or pipeline change.\\\\\\\\n   148\\\\\\\\t- The POC's own behaviour.\\\\\\\\n\\\\\\\",\\\\\\\"exit_code\\\\\\\":0,\\\\\\\"status\\\\\\\":\\\\\\\"completed\\\\\\\"}}\\\\ndocs/research/2026-11-22-number-answers/codex-r72d.stream:40:{\\\\\\\"type\\\\\\\":\\\\\\\"item.completed\\\\\\\",\\\\\\\"item\\\\\\\":{\\\\\\\"id\\\\\\\":\\\\\\\"item_20\\\\\\\",\\\\\\\"type\\\\\\\":\\\\\\\"command_execution\\\\\\\",\\\\\\\"command\\\\\\\":\\\\\\\"/opt/homebrew/bin/zsh -lc \\\\\\\\\\\\\\\"python3 -c 'import json,pathlib,difflib; p=pathlib.Path(\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"docs/research/2026-11-22-number-answers\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"); s=json.loads((p/\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"codex-r72c.stream\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\").read_text().splitlines()[14])[\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"item\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"][\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"aggregated_output\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"]; a=[l.split(\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\t\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",1)[1] for l in s.splitlines()]; b=(p/\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"FORECAST-UNAVAILABLE-DESIGN.md\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\").read_text().splitlines();print(\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\".join(difflib.unified_diff(a,b,n=0)))'\\\\\\\\\\\\\\\"\\\\\\\",\\\\\\\"aggregated_output\\\\\\\":\\\\\\\"--- \\\\\\\\n\\\\\\\\n+++ \\\\\\\\n\\\\\\\\n@@ -10 +10 @@\\\\\\\\n\\\\\\\\n-**Revision 3: one structural rule instead of a list of leaks.** Rounds 72 and 72b each found new paths by which a withheld forecast\\\\\\\\n+**Revision 4 (council 72c) of revision 3: one structural rule instead of a list of leaks.** Rounds 72 and 72b each found new paths by which a withheld forecast\\\\\\\\n@@ -36,0 +37,3 @@\\\\\\\\n\\\\\\\\n+- **The release builder calls `release_export` directly** and accepts no external input; a marker or version names a format, not\\\\\\\\n+  who wrote the text (council 72c). The finished package is checked as well as the page: it holds only the export's output, with no\\\\\\\\n+  market data, composite trials or translated file beside it.\\\\\\\\n@@ -82 +85,5 @@\\\\\\\\n\\\\\\\\n-## 4. Yes/No questions: an open choice for Alex (not decided here)\\\\\\\\n+**Events are binary too.** All 85 comparison-store events are also two-answer questions, including both known prose leaks, and a\\\\\\\\n+binary event such as \\\\\\\\\\\\\\\"Restriction adopted\\\\\\\\\\\\\\\" / \\\\\\\\\\\\\\\"No restriction adopted\\\\\\\\\\\\\\\" exists in the served ledger (council 72c). §4's rule applies to\\\\\\\\n+every question that is not a number question, events and Yes/No alike, and each keeps its answer label.\\\\\\\\n+\\\\\\\\n+## 4. Questions that are not number questions: an open choice for Alex (not decided here)\\\\\\\\n@@ -91,2 +98,9 @@\\\\\\\\n\\\\\\\\n-- **Claude's lean is (b).** It keeps value and is decided by structure. It needs a $0 census of how many Yes/No judgements it keeps\\\\\\\\n-  on the stored stores before release.\\\\\\\\n+- **Measured (council 72c),** matching each judgement to its archived request:\\\\\\\\n+  - (b) would keep explanations on 31 of 769, 44 of 776 and 43 of 958 judgements in the three comparison runs;\\\\\\\\n+  - for a reader at the latest answer, it would keep them on 21 of 85 questions;\\\\\\\\n+  - it would keep 73 of 73 in the sealed ledger.\\\\\\\\n+- **The limit of (b).** It cannot promise the prose quotes no number forecast. A request also carries the question's own previous\\\\\\\\n+  reasoning, and can carry another question's, either of which may repeat a forecast seen earlier. Both known leaks are in\\\\\\\\n+  `why_changed`.\\\\\\\\n+- **Recommendation: (a) for the first release** (council 72c; Claude agrees, withdrawing its lean for (b)). It is the only option\\\\\\\\n+  that guarantees no number forecast reaches a reader through prose. (b) remains a measured later step.\\\\\\\\n@@ -114,0 +129,5 @@\\\\\\\\n\\\\\\\\n+- **End-to-end acceptance (council 72c):**\\\\\\\\n+  - an idea whose only question is `old-1/v8`: the card keeps its sources and \\\\\\\\\\\\\\\"Forecast unavailable\\\\\\\\\\\\\\\", with no scored driver and no\\\\\\\\n+    substitute band (the current composite expects an endpoint for every scoring candidate, `idea_composite.py:214`, `:231`);\\\\\\\\n+  - in the same release package, the two known event answers keep their labels and carry no spending forecast under the chosen\\\\\\\\n+    prose rule.\\\\\\\\n\\\\\\\",\\\\\\\"exit_code\\\\\\\":0,\\\\\\\"status\\\\\\\":\\\\\\\"completed\\\\\\\"}}\\\\n\\\",\\\"exit_code\\\":0,\\\"status\\\":\\\"completed\\\"}}\\ndocs/research/2026-11-22-number-answers/codex-r74.stream:34:{\\\"type\\\":\\\"item.completed\\\",\\\"item\\\":{\\\"id\\\":\\\"item_17\\\",\\\"type\\\":\\\"command_execution\\\",\\\"command\\\":\\\"/opt/homebrew/bin/zsh -lc \\\\\\\"rg -n '\\\\\\\\\\\\\\\\b(add_evidence|evidence_record)\\\\\\\\\\\\\\\\(' src; rg -n '(served.*views.sqlite|HIVEMIND_LEDGER|--ledger)' README.md | head -n 35; rg -n 'served ledger|served store' docs/research/2026-11-22-number-answers/{codex-r72b.md,codex-r72c.md,round74-brief.md}\\\\\\\"\\\",\\\"aggregated_output\\\":\\\"src/hivemind/baseline.py:207:                store.add_evidence(conn, evidence_id=evidence_id, quote=f['quote'], one_line=one_line_of(f), speaker=item['publisher'],\\\\nsrc/hivemind/service.py:224:def evidence_record(conn, evidence_id, as_of, arrived_seq=None):\\\\nsrc/hivemind/service.py:248:        piece = evidence_record(conn, link['evidence_id'], as_of, link['seq'])\\\\nsrc/hivemind/service.py:358:        cited = [piece for piece in (evidence_record(conn, e, row['publication_day']) for e in _unique(_json(row['cited_evidence_json']))) if piece]\\\\nsrc/hivemind/views/store.py:355:def add_evidence(conn, *, evidence_id, quote, one_line, speaker, original_who, original_day, tier, event_time, seq, input_id):\\\\nsrc/hivemind/views/writing.py:31:    store.add_evidence(conn, evidence_id=evidence_id, quote=e['quote'], one_line=e['one_line'], speaker=e['speaker'],\\\\n93:| Collected thesis ledger | `poc/data/served-2026-10-28-v34-nvda-3m-through-0828/views.sqlite` |\\\\n107:| `scripts/mock_build.py` | `--ledger` and `--items` defaults, then `python3 scripts/mock_build.py` rebuilds `poc/mock/index.html` |\\\\n159:  --views /absolute/path/to/preserved/views.sqlite \\\\\\\\\\\\ndocs/research/2026-11-22-number-answers/codex-r72c.md:3:2. **§3 classified the stored questions correctly.** I independently found 19, 17 and 18 number questions in the three comparison stores. In the sealed ledger, withholding covered 43 money questions and 21 other numeric questions. All 30 Chinese Yes/No pairs were recognized. The Xbox question correctly kept its Yes/No answer despite having bounds around zero. One distinction matters for release prose. **All 85 comparison-store events are also Yes/No questions**, including both known leaks. The §4 prose rule must apply to them even when the event check matches first. The served ledger also has a binary event labeled “Restriction adopted” and “No restriction adopted.” Its existing answer label should remain usable under the same prose rule. [Design §3:65](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/FORECAST-UNAVAILABLE-DESIGN.md:65) · [vocabulary.py:24](/Users/lchingen/hivemind/src/hivemind/vocabulary.py:24) · [test_service.py:90](/Users/lchingen/hivemind/tests/test_service.py:90) · [named event decision:3510](/Users/lchingen/hivemind/docs/DECISIONS-log.md:3510)\\\\n\\\",\\\"exit_code\\\":0,\\\"status\\\":\\\"completed\\\"}}\\ndocs/research/2026-11-22-number-answers/codex-r74.stream:36:{\\\"type\\\":\\\"item.completed\\\",\\\"item\\\":{\\\"id\\\":\\\"item_18\\\",\\\"type\\\":\\\"command_execution\\\",\\\"command\\\":\\\"/opt/homebrew/bin/zsh -lc \\\\\\\"rg --files -uuu poc | rg '/(items|views)\\\\\\\\\\\\\\\\.sqlite\\\\\\\"'$'\\\\\\\"' | rg 'served|poc/data/(items|views)|poc/runs/served' | head -n 25; ls -lh poc/data/{items*,views*}\\\\\\\"\\\",\\\"aggregated_output\\\":\\\"poc/data/served-2026-10-28-v34-nvda-3m-through-0828/views.sqlite\\\\npoc/data/views.sqlite\\\\n-rw-r--r--@ 1 lchingen  staff   169M Oct 26 13:24 poc/data/items-nvda-2026-07-01-10-27.page.sqlite\\\\n-rw-r--r--@ 1 lchingen  staff   236M Oct 27 02:52 poc/data/items-nvda-2026-07-01-10-27.sqlite\\\\n-rw-r--r--@ 1 lchingen  staff    36M Oct 24 00:42 poc/data/items-window-tags2-2026-10-24.sqlite\\\\n-rw-r--r--@ 1 lchingen  staff    36M Oct 23 04:48 poc/data/items-window.sqlite\\\\n-rw-r--r--@ 1 lchingen  staff   1.8M Oct 24 11:20 poc/data/views-2026-10-25-v14.sqlite\\\\n-rw-r--r--@ 1 lchingen  staff   344K Oct 24 11:07 poc/data/views-2026-10-25-v15-T2.sqlite\\\\n-rw-r--r--@ 1 lchingen  staff   188K Oct 24 11:11 poc/data/views-2026-10-25-v15-T2b-aborted-fresh-archive.sqlite\\\\n-rw-r--r--@ 1 lchingen  staff   356K Oct 24 11:19 poc/data/views-2026-10-25-v15-T2b.sqlite\\\\n-rw-r--r--@ 1 lchingen  staff   356K Oct 24 11:32 poc/data/views-2026-10-25-v15-T2c.sqlite\\\\n-rw-r--r--@ 1 lchingen  staff   360K Oct 24 11:40 poc/data/views-2026-10-25-v15-T2d.sqlite\\\\n-rw-r--r--@ 1 lchingen  staff   1.6M Oct 24 12:28 poc/data/views-2026-10-25-v15-T4.sqlite\\\\n-rw-r--r--@ 1 lchingen  staff   1.5M Oct 24 13:03 poc/data/views-2026-10-25-v15-T4b.sqlite\\\\n-rw-r--r--@ 1 lchingen  staff   1.5M Oct 24 13:09 poc/data/views-2026-10-25-v15-T4c.sqlite\\\\n-rw-r--r--@ 1 lchingen  staff   4.2M Oct 23 12:12 poc/data/views.sqlite\\\\n-rw-r--r--@ 1 lchingen  staff   592K Oct 23 09:04 poc/data/views.sqlite.day0.sqlite\\\\n\\\",\\\"exit_code\\\":0,\\\"status\\\":\\\"completed\\\"}}\\ndocs/research/2026-11-22-number-answers/codex-r74.stream:42:{\\\"type\\\":\\\"item.completed\\\",\\\"item\\\":{\\\"id\\\":\\\"item_21\\\",\\\"type\\\":\\\"command_execution\\\",\\\"command\\\":\\\"/opt/homebrew/bin/zsh -lc \\\\\\\"nl -ba README.md | sed -n '87,105p'; nl -ba src/hivemind/views/writing.py | head -n 110; nl -ba src/hivemind/baseline.py | sed -n '163,225p'; nl -ba src/hivemind/idea.py | sed -n '115,146p;215,279p'\\\\\\\"\\\",\\\"aggregated_output\\\":\\\"    87\\\\tUse Python 3.12 or later for the backend and Node.js 22 or later with npm for frontend builds. The HTTP service uses the Python standard library. The optional MCP service needs `mcp==1.26.0`. Frontend development dependencies are locked in `poc/ui/package-lock.json`.\\\\n    88\\\\t\\\\n    89\\\\tThe default backend reads these local files:\\\\n    90\\\\t\\\\n    91\\\\t| Purpose | Path |\\\\n    92\\\\t|---|---|\\\\n    93\\\\t| Collected thesis ledger | `poc/data/served-2026-10-28-v34-nvda-3m-through-0828/views.sqlite` |\\\\n    94\\\\t| Source items | `poc/data/items-nvda-2026-07-01-10-27.sqlite` (cleaned pages, D351, with the whole pages as fetched in column `text_page`; also kept apart in `items-nvda-2026-07-01-10-27.page.sqlite`) |\\\\n    95\\\\t| Replay configuration | `poc/config/poc-v118.json` (D370): v108 extraction, matching and judging settings without seeded starting questions or separate report import |\\\\n    96\\\\t| Idea configuration | `poc/config/poc-v118-idea.json`: two discovery calls and a final adoption/weighting call |\\\\n    97\\\\t| Derived service index and Idea archive | `poc/data/service-english/` by default; overridable per run |\\\\n    98\\\\t\\\\n    99\\\\t`poc/data/` is excluded from Git. A fresh clone includes the standalone demo, not these databases. Use the [data manifest](docs/research/2026-10-25-english/data-manifest.md) to locate preserved runs, or supply your own files with the documented CLI options. Keep provider credentials in the owner-only local file `~/.config/hivemind/credentials.json`, outside the repository.\\\\n   100\\\\t\\\\n   101\\\\t### Switching the served data\\\\n   102\\\\t\\\\n   103\\\\tThe page build, the two services and Compose each carry the same two defaults: the thesis ledger (`views.sqlite`) and the items database the ledger's input ids come from. Swap both together; a ledger whose items are missing shows evidence without titles or sources. Serve a copy of a ledger a run may still write (`snapshot.sh` in a run folder makes one with SQLite's backup API), never the file the run writes. The places that name the defaults, all changed in one edit:\\\\n   104\\\\t\\\\n   105\\\\t| Place | What to change |\\\\n     1\\\\t\\\\\\\"\\\\\\\"\\\\\\\"06-views.md step 6: write one item's round into the views database. Themes before objects; a repeat adds a source;\\\\n     2\\\\ta `replace` decision is recorded as a revision (D202: the new piece revises the old, both stay in force) and is ordered by the day it\\\\n     3\\\\twas said (a later-arriving older statement is logged, not linked); a revised piece still linked elsewhere links the new piece there too; new views come with rungs, dependencies and\\\\n     4\\\\tsuccessions; a waiting dependency is resolved when the chain's year is created; the set of views whose reading\\\\n     5\\\\tchanged is returned for the re-judging round.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n     6\\\\timport dataclasses\\\\n     7\\\\timport json\\\\n     8\\\\timport re\\\\n     9\\\\timport time\\\\n    10\\\\t\\\\n    11\\\\tfrom . import identity, store\\\\n    12\\\\t\\\\n    13\\\\t\\\\n    14\\\\t@dataclasses.dataclass\\\\n    15\\\\tclass Written:\\\\n    16\\\\t    changed_views: set\\\\n    17\\\\t    new_views: dict            # candidate id -> view_id\\\\n    18\\\\t    evidence_ids: dict         # handover evidence id -> evidence_id\\\\n    19\\\\t    notes: list\\\\n    20\\\\t    links: list = dataclasses.field(default_factory=list)      # D694: the reading links committed, with their final labels\\\\n    21\\\\t\\\\n    22\\\\t\\\\n    23\\\\tdef _next_id(conn, table, column, prefix):\\\\n    24\\\\t    row = conn.execute(f'select {column} from {table} order by rowid desc limit 1').fetchone()\\\\n    25\\\\t    last = int(row[0][len(prefix):]) if row and row[0].startswith(prefix) and row[0][len(prefix):].isdigit() else 0\\\\n    26\\\\t    return f'{prefix}{last + 1}'\\\\n    27\\\\t\\\\n    28\\\\t\\\\n    29\\\\tdef _store_piece(conn, e, seq, item):\\\\n    30\\\\t    evidence_id = _next_id(conn, 'evidence', 'evidence_id', 'e')\\\\n    31\\\\t    store.add_evidence(conn, evidence_id=evidence_id, quote=e['quote'], one_line=e['one_line'], speaker=e['speaker'],\\\\n    32\\\\t                       original_who=e['original_who'], original_day=e['original_day'] or '', tier=e['tier'],   # D203: unknown stays unknown\\\\n    33\\\\t                       event_time=e['event_time'], seq=seq, input_id=item['input_id'])\\\\n    34\\\\t    store.add_source(conn, evidence_id, item['input_id'], item['category'], item['publication_day'], e.get('location', ''), seq)\\\\n    35\\\\t    return evidence_id\\\\n    36\\\\t\\\\n    37\\\\t\\\\n    38\\\\tdef _create_view(conn, c, object_id, object_kind, seq, item, universe):\\\\n    39\\\\t    view_id = _next_id(conn, 'views', 'view_id', 'v')\\\\n    40\\\\t    # the year is stored in its one canonical spelling so that a waiting dependency's year joins it (D163 plan, period text)\\\\n    41\\\\t    year = universe.canonical_year(object_id, c['year']) if hasattr(universe, 'canonical_year') else c['year']\\\\n    42\\\\t    store.create_view(conn, view_id=view_id, object_id=object_id, object_kind=object_kind, kind=c['kind'], looks_at=c['looks_at'],\\\\n    43\\\\t                      question=c['question'], due_day=c['due_day'], year=year, rungs=c['rungs'], seq=seq, input_id=item['input_id'],\\\\n    44\\\\t                      created_at=time.strftime('%Y-%m-%dT%H:%M:%S'))\\\\n    45\\\\t    if c.get('measure'):          # keyed candidates (extraction schema v4 and later) carry their key into the ledger\\\\n    46\\\\t        store.add_key(conn, view_id, c, seq)\\\\n    47\\\\t    return view_id\\\\n    48\\\\t\\\\n    49\\\\t\\\\n    50\\\\tdef resolve_waiting(conn, new_view_id, seq, changed):\\\\n    51\\\\t    \\\\\\\"\\\\\\\"\\\\\\\"A new view on a chain satisfies dependencies waiting for its year on that chain.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n    52\\\\t    v = store.view(conn, new_view_id)\\\\n    53\\\\t    chain = {new_view_id}\\\\n    54\\\\t    frontier = [new_view_id]\\\\n    55\\\\t    while frontier:\\\\n    56\\\\t        current = frontier.pop()\\\\n    57\\\\t        for row in conn.execute('select succeeds from successions where view_id=?', (current,)):\\\\n    58\\\\t            if row['succeeds'] not in chain:\\\\n    59\\\\t                chain.add(row['succeeds'])\\\\n    60\\\\t                frontier.append(row['succeeds'])\\\\n    61\\\\t    for dep in conn.execute('select * from dependencies where wait_year=? and wait_chain_view_id is not null', (v['year'],)):\\\\n    62\\\\t        if dep['wait_chain_view_id'] in chain:\\\\n    63\\\\t            already = conn.execute('select 1 from dependency_resolutions where dependency_id=?', (dep['dependency_id'],)).fetchone()\\\\n    64\\\\t            if not already and not store.would_cycle(conn, dep['view_id'], new_view_id):\\\\n    65\\\\t                store.insert(conn, 'dependency_resolutions', dependency_id=dep['dependency_id'], resolved_to=new_view_id, reason='created', seq=seq)\\\\n    66\\\\t                changed.add(dep['view_id'])\\\\n    67\\\\t\\\\n    68\\\\t\\\\n    69\\\\tdef object_id_of(universe, candidate):\\\\n    70\\\\t    return universe.resolve(candidate['object']) or candidate['object']\\\\n    71\\\\t\\\\n    72\\\\t\\\\n    73\\\\tdef oriented_like(c, previous, notes):\\\\n    74\\\\t    \\\\\\\"\\\\\\\"\\\\\\\"06-views: a successor's ladder keeps the predecessor's direction. A numeric ladder written the other way round (rung 1 the\\\\n    75\\\\t    lowest band where the predecessor's rung 1 is the highest) is the same ladder; it is stored reversed, rungs with their\\\\n    76\\\\t    labels and bounds, so positions mean the same along the chain. Undecidable pairs are stored as written.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n    77\\\\t    from .matching import ladder_direction\\\\n    78\\\\t    before, after = (ladder_direction(previous) if previous else None), ladder_direction(c['rungs'])\\\\n    79\\\\t    if before is not None and after is not None and before != after:\\\\n    80\\\\t        notes.append(f'candidate {c[\\\\\\\"id\\\\\\\"]}: successor ladder reversed to the predecessor\\\\\\\\'s direction')\\\\n    81\\\\t        return dict(c, rungs=list(reversed(c['rungs'])))\\\\n    82\\\\t    return c\\\\n    83\\\\t\\\\n    84\\\\t\\\\n    85\\\\tTIER_RANK = {'fact': 3, 'party_statement': 3, 'third_party_view': 2, 'rumour': 1}\\\\n    86\\\\tISO_DAY = re.compile(r'^\\\\\\\\d{4}-\\\\\\\\d{2}-\\\\\\\\d{2}$')\\\\n    87\\\\t\\\\n    88\\\\t\\\\n    89\\\\tdef revision_refused(incoming, old, new_day):\\\\n    90\\\\t    \\\\\\\"\\\\\\\"\\\\\\\"06-views, the Replace row, read since D202 as a revision: a later account of the same matter by a party entitled to give one (a\\\\n    91\\\\t    speaker revises its own guidance or forecast, an official confirms or denies a report, the original source revises). Returns the\\\\n    92\\\\t    reason the revision is refused, or '' when it may be recorded: the incoming piece needs a stated day, a tier at least the stored\\\\n    93\\\\t    piece's (a view never revises a fact or a party's statement), and, when it is a third-party view or a rumour, the same party as the\\\\n    94\\\\t    stored piece. Nothing is retired either way; a refused revision is stored as one more piece.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n    95\\\\t    from .. import vocabulary\\\\n    96\\\\t    if not old:\\\\n    97\\\\t        return ''\\\\n    98\\\\t    if not ISO_DAY.match(new_day or ''):\\\\n    99\\\\t        return 'no stated day'\\\\n   100\\\\t    new_tier, old_tier = vocabulary.canonical('tier', incoming.get('tier')), vocabulary.canonical('tier', old.get('tier'))\\\\n   101\\\\t    if TIER_RANK.get(new_tier, 0) < TIER_RANK.get(old_tier, 0):\\\\n   102\\\\t        return f'{new_tier} cannot revise {old_tier}'\\\\n   103\\\\t    if new_tier in ('third_party_view', 'rumour') \\\\\\\\\\\\n   104\\\\t            and (incoming.get('original_who') or '').strip().casefold() != (old.get('original_who') or '').strip().casefold():\\\\n   105\\\\t        return f'another party\\\\\\\\'s {old_tier.replace(\\\\\\\"_\\\\\\\", \\\\\\\" \\\\\\\")}'       # an official confirms or denies; the original source revises\\\\n   106\\\\t    return ''\\\\n   107\\\\t\\\\n   108\\\\t\\\\n   109\\\\tclass WriteConflict(ValueError):\\\\n   110\\\\t    \\\\\\\"\\\\\\\"\\\\\\\"The checked plan no longer fits the writable ledger; no partial write is retained.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n   163\\\\t    progressed = conn.execute('select 1 from processing_steps where sequence_no > 0 limit 1').fetchone() or \\\\\\\\\\\\n   164\\\\t        conn.execute('select 1 from days_completed limit 1').fetchone()\\\\n   165\\\\t    if progressed:\\\\n   166\\\\t        raise BaselineRefused('coverage start has passed in this ledger: the coverage-start reading runs only on a ledger that has processed nothing yet')\\\\n   167\\\\t    return 'run'\\\\n   168\\\\t\\\\n   169\\\\t\\\\n   170\\\\tdef run(conn, items_db, archive, cfg, *, ticker, coverage_start, transport=None, log=print):\\\\n   171\\\\t    \\\\\\\"\\\\\\\"\\\\\\\"Reads, checks and writes the starting figures; returns the step's record (or None when the configuration has no baseline setting or the step\\\\n   172\\\\t    ran before). All model calls first (archived, so a rerun after a failure reuses them), then every record, link and the step row in one commit.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n   173\\\\t    setting = getattr(cfg, 'baseline', None)\\\\n   174\\\\t    if setting is None:\\\\n   175\\\\t        return None\\\\n   176\\\\t    system, task = prompt(setting.prompt_version)\\\\n   177\\\\t    if guard(conn, ticker, coverage_start) == 'skip':\\\\n   178\\\\t        log(f'--- coverage-start reading of {ticker}: done before, skipped')\\\\n   179\\\\t        return None\\\\n   180\\\\t    items = report_items(items_db, ticker, coverage_start)\\\\n   181\\\\t    seq = store.next_sequence(conn)\\\\n   182\\\\t    at = time.strftime('%Y-%m-%dT%H:%M:%S')\\\\n   183\\\\t    if not items:\\\\n   184\\\\t        record = {'changed': [], 'report': [], 'kept': 0, 'refused': [], 'empty': [], 'note': f'no earnings report of {ticker} before {coverage_start}'}\\\\n   185\\\\t        store.mark_step(conn, step_id(ticker, 'none'), seq, STEP, 'ok', json.dumps(record), coverage_start, at)\\\\n   186\\\\t        conn.commit()\\\\n   187\\\\t        return record\\\\n   188\\\\t    shown = extraction.shown_views(conn, cfg, {'publication_day': items[0]['publication_day'], 'category': 'T1', 'object_identifiers': [{'value': ticker}]}, [ticker])\\\\n   189\\\\t    readings = []\\\\n   190\\\\t    for view in sorted(shown, key=lambda v: int(v['view_id'][1:]) if v['view_id'][1:].isdigit() else 0):\\\\n   191\\\\t        lines = placement.question_lines([view])\\\\n   192\\\\t        for item in items:\\\\n   193\\\\t            answer = model.call(archive, cfg, setting, system, user_message(lines, item, task), SCHEMA, SCHEMA_NAME, STEP, transport=transport)\\\\n   194\\\\t            readings.append((view['view_id'], item, check_figures(answer.data.get('figures', []), item['text_page'])))\\\\n   195\\\\t    records, changed, refused, empty, kept = {}, [], [], [], 0\\\\n   196\\\\t    for view_id, item, figures in readings:\\\\n   197\\\\t        if not figures:\\\\n   198\\\\t            empty.append([view_id, item['input_id']])\\\\n   199\\\\t        for f in figures:\\\\n   200\\\\t            if not f['kept']:\\\\n   201\\\\t                refused.append({'view_id': view_id, 'input_id': item['input_id'], 'quote': f['quote'][:300], 'value': f['value'],\\\\n   202\\\\t                                'reason': 'quote not in the report' if not f['in_report'] else ('no label' if not f['labelled'] else 'value not printed in the quote')})\\\\n   203\\\\t                continue\\\\n   204\\\\t            key = (item['input_id'], comparable(f['quote']))\\\\n   205\\\\t            if key not in records:\\\\n   206\\\\t                evidence_id = _next_id(conn, 'evidence', 'evidence_id', 'e')\\\\n   207\\\\t                store.add_evidence(conn, evidence_id=evidence_id, quote=f['quote'], one_line=one_line_of(f), speaker=item['publisher'],\\\\n   208\\\\t                                   original_who=item['publisher'], original_day=item['publication_day'], tier='fact', event_time='', seq=seq,\\\\n   209\\\\t                                   input_id=item['input_id'])\\\\n   210\\\\t                store.add_source(conn, evidence_id, item['input_id'], 'T1', item['publication_day'], '', seq)\\\\n   211\\\\t                records[key] = evidence_id\\\\n   212\\\\t            if store.link(conn, records[key], view_id, seq) and view_id not in changed:\\\\n   213\\\\t                changed.append(view_id)\\\\n   214\\\\t            kept += 1\\\\n   215\\\\t    record = {'changed': changed, 'report': [item['input_id'] for item in items], 'kept': kept, 'records': len(records), 'refused': refused, 'empty': empty}\\\\n   216\\\\t    store.mark_step(conn, step_id(ticker, items[0]['publication_day']), seq, STEP, 'ok', json.dumps(record, ensure_ascii=False), coverage_start, at)\\\\n   217\\\\t    conn.commit()\\\\n   218\\\\t    log(f'--- coverage-start reading of {ticker}: {len(items)} report items, {len(readings)} readings, {len(records)} records linked to {changed}, '\\\\n   219\\\\t        f'{len(refused)} figures refused')\\\\n   220\\\\t    return record\\\\n   115\\\\t    missing = sorted(o for o in (aliases or {}) if o not in counts)\\\\n   116\\\\t    return (f'Objects with open views as of {as_of} (object, kind, number of views): {covered}.'\\\\n   117\\\\t            + (f' Objects in the universe with no view yet: {\\\\\\\", \\\\\\\".join(missing)}.' if missing else ''))\\\\n   118\\\\t\\\\n   119\\\\t\\\\n   120\\\\tdef judged(ledger, view_id, as_of, detailed=False):\\\\n   121\\\\t    state = service.state_as_of(ledger, view_id, as_of)\\\\n   122\\\\t    if not state:\\\\n   123\\\\t        return None\\\\n   124\\\\t    rung = next((g for g in store.rungs_of(ledger, view_id) if g['position'] == state['position']), {})\\\\n   125\\\\t    result = {'position': state['position'], 'label': rung.get('label', '')}\\\\n   126\\\\t    if detailed:\\\\n   127\\\\t        result.update(condition=rung.get('condition', ''), day=state['judgement_day'], reasons=state['reasons'])\\\\n   128\\\\t    return result\\\\n   129\\\\t\\\\n   130\\\\t\\\\n   131\\\\tdef brief(ledger, results, as_of, detailed=False):\\\\n   132\\\\t    \\\\\\\"\\\\\\\"\\\\\\\"Candidate state at the requested date; analyst context is explicit and versioned by the caller.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n   133\\\\t    as_of = service.resolve_bound(ledger, as_of)\\\\n   134\\\\t    records = []\\\\n   135\\\\t    for result in results:\\\\n   136\\\\t        record = {'view_id': result['view_id'], 'object': result['object'], 'looks_at': result['looks_at'],\\\\n   137\\\\t                  'judged': judged(ledger, result['view_id'], as_of, detailed)}\\\\n   138\\\\t        if detailed:\\\\n   139\\\\t            record['question'] = result['question']\\\\n   140\\\\t        records.append(record)\\\\n   141\\\\t    return records\\\\n   142\\\\t\\\\n   143\\\\t\\\\n   144\\\\tdef related_views(ledger, view_ids, as_of, exclude=()):\\\\n   145\\\\t    \\\\\\\"\\\\\\\"\\\\\\\"The given views' neighbours in the ledger's dependency graph, as of the day: what each depends on (upstream)\\\\n   146\\\\t    and what depends on it (downstream), with the judged position; `exclude` are views already on the card.\\\\n   215\\\\t    return out[:limit]\\\\n   216\\\\t\\\\n   217\\\\t\\\\n   218\\\\tdef read_idea(ledger, index, items, archive, cfg, text, as_of=None, k=10, aliases=None, semantic=True, transport=None, bundles=True, embed=search.openai_embeddings, on_progress=None):\\\\n   219\\\\t    \\\\\\\"\\\\\\\"\\\\\\\"The idea card: idea, what the idea's own search found, the reading (typed parts, the candidates each got, the\\\\n   220\\\\t    views each maps to, the summary, the claim), the related views from the dependency graph, the evaluation, every\\\\n   221\\\\t    view's bundle, the days, the trace of searches, and all call costs. No recorded view → no model call.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n   222\\\\t    text = (text or '').strip()\\\\n   223\\\\t    if not text:\\\\n   224\\\\t        raise ValueError('an idea needs text')\\\\n   225\\\\t    as_of = service.resolve_bound(ledger, as_of)\\\\n   226\\\\t    report = on_progress or (lambda stage: None)\\\\n   227\\\\t    report('search')\\\\n   228\\\\t    found = search.search(ledger, index, text, k, as_of, aliases=aliases, semantic=semantic, embed=embed)\\\\n   229\\\\t    card = {'idea': {'text': text, 'as_of': as_of}, 'search': {'mode': found['mode'], 'candidates': [r['view_id'] for r in found['results'] or []]},\\\\n   230\\\\t            'reading': None, 'evaluation': None, 'related': [], 'views': [], 'days': bundle.days(ledger, as_of),\\\\n   231\\\\t            'no_recorded_view': found['results'] is None, 'cost': dict(NO_COST)}\\\\n   232\\\\t    if found['results'] is None:\\\\n   233\\\\t        return card\\\\n   234\\\\t    setting = cfg.idea\\\\n   235\\\\t    if setting is None:\\\\n   236\\\\t        raise config.ConfigError(f'config {cfg.version} has no idea setting')\\\\n   237\\\\t    decompose_prompt, map_prompt = prompts(setting)\\\\n   238\\\\t    started = time.time()\\\\n   239\\\\t    cost = dict(NO_COST)\\\\n   240\\\\t    cost['cached'] = True\\\\n   241\\\\t\\\\n   242\\\\t    def spend(answer):\\\\n   243\\\\t        cost['usd'] += answer.cost_usd\\\\n   244\\\\t        cost['input_tokens'] += answer.input_tokens\\\\n   245\\\\t        cost['output_tokens'] += answer.output_tokens\\\\n   246\\\\t        cost['turns'] += 1\\\\n   247\\\\t        cost['cached'] = cost['cached'] and answer.cached\\\\n   248\\\\t\\\\n   249\\\\t    # call 1: the parts\\\\n   250\\\\t    report('decompose')\\\\n   251\\\\t    user = f'Idea: {text}\\\\\\\\nDay: {as_of} (the library as judged on this day)\\\\\\\\n\\\\\\\\n{object_list(ledger, as_of, aliases)}'\\\\n   252\\\\t    made, slips = call_english(archive, cfg, setting, decompose_prompt, user, DECOMPOSE, 'idea_decompose', transport,\\\\n   253\\\\t                               lambda d: [f for p in d['parts'] for f in (p['looks_for'], p['period'])])\\\\n   254\\\\t    for answer in made:\\\\n   255\\\\t        spend(answer)\\\\n   256\\\\t    first = made[-1]\\\\n   257\\\\t    parts = [dict(p) for p in first.data['parts'][:MAX_PARTS]]\\\\n   258\\\\t    # the service: one search per part, the candidates each part got\\\\n   259\\\\t    report('retrieve')\\\\n   260\\\\t    detailed = setting.prompt_version == 'idea-v12'\\\\n   261\\\\t    idea_rows = brief(ledger, found['results'][:IDEA_ROWS], as_of, detailed)\\\\n   262\\\\t    trace, candidates, ranks = [], [], []\\\\n   263\\\\t    queries = [((part.get('query') or '').strip() or canonical_query(part, aliases), canonical_query(part, aliases)) for part in parts]\\\\n   264\\\\t    if semantic and found['mode'] == 'semantic':\\\\n   265\\\\t        search.warm_queries(index, [q for pair in queries for q in pair], embed)      # one embeddings round trip for every part instead of two per part\\\\n   266\\\\t    # a part's candidates: the service's canonical query and the model's own, interleaved (tried 2026-10-25 and dropped:\\\\n   267\\\\t    # the object's views ranked by the idea text alone lost the model's finds, gold direct right 17 → 15 of 19)\\\\n   268\\\\t    for i, (part, (query, own)) in enumerate(zip(parts, queries)):\\\\n   269\\\\t        hit = search.search(ledger, index, query, PER_PART, as_of, aliases=aliases, semantic=semantic, embed=embed)\\\\n   270\\\\t        steady = search.search(ledger, index, own, PER_PART, as_of, aliases=aliases, semantic=semantic, embed=embed) if own.lower() != query.lower() else hit\\\\n   271\\\\t        rows = brief(ledger, merged(steady['results'] or [], hit['results'] or [], PER_PART), as_of, detailed)\\\\n   272\\\\t        candidates.append(rows)\\\\n   273\\\\t        ranks.append({r['view_id']: n for n, r in enumerate(hit['results'] or [])})      # the part's own search order, the tie-break among the model's direct views\\\\n   274\\\\t        trace.append({'tool': 'search', 'part': i, 'query': query, 'canonical': own, 'returned': [r['view_id'] for r in rows]})\\\\n   275\\\\t    # call 2: the mapping\\\\n   276\\\\t    report('map')\\\\n   277\\\\t    map_schema, payload = CONTRACTS.get(setting.prompt_version, (MAP, full_payload))\\\\n   278\\\\t    user = payload(text, as_of, parts, candidates, idea_rows)\\\\n   279\\\\t    made, more = call_english(archive, cfg, setting, map_prompt, user, map_schema, 'idea_map', transport,\\\\n\\\",\\\"exit_code\\\":0,\\\"status\\\":\\\"completed\\\"}}\\ndocs/research/2026-11-22-number-answers/codex-r74.stream:44:{\\\"type\\\":\\\"item.completed\\\",\\\"item\\\":{\\\"id\\\":\\\"item_22\\\",\\\"type\\\":\\\"command_execution\\\",\\\"command\\\":\\\"/opt/homebrew/bin/zsh -lc \\\\\\\"rg -n \\\\\\\\\\\\\\\"(implied_outcome|reference).*text|quote.*(body|span|source|full_text)\\\\\\\\\\\\\\\" src/hivemind/{views,baseline.py} | head -n 95; rg -n 'served|LEDGER|ITEMS' scripts/mock_build.py | head -n 40\\\\\\\"\\\",\\\"aggregated_output\\\":\\\"src/hivemind/baseline.py:51:    \\\\\\\"\\\\\\\"\\\\\\\"For a table-row quote the plain check misses: the exact span of the report's row from the quote's label to its figure, when the label is\\\\nsrc/hivemind/baseline.py:88:        if not (len(comparable(quote)) >= MIN_QUOTE and comparable(quote) in body):\\\\nsrc/hivemind/baseline.py:91:                quote, repaired = span, True\\\\nsrc/hivemind/baseline.py:92:        in_report = len(comparable(quote)) >= MIN_QUOTE and comparable(quote) in body\\\\nsrc/hivemind/views/store.py:18:    'judgements': 'judgement_id integer primary key autoincrement, view_id text, seq integer, input_id text, rung integer, reasons text, cited_evidence_json text, cited_views_json text, pushes_json text, changed integer, why_changed text, config_checksum text, call_id integer, request_sha256 text, publication_day text, theme_pushes_json text, reference text, implied_outcome text',\\\\n21:    parser.add_argument('--ledger', type=Path, default=ROOT / 'poc/data/served-2026-10-28-v34-nvda-3m-through-0828/views.sqlite')\\\\n\\\",\\\"exit_code\\\":0,\\\"status\\\":\\\"completed\\\"}}\\ndocs/research/2026-11-22-number-answers/codex-r74.stream:45:{\\\"type\\\":\\\"item.started\\\",\\\"item\\\":{\\\"id\\\":\\\"item_23\\\",\\\"type\\\":\\\"command_execution\\\",\\\"command\\\":\\\"/opt/homebrew/bin/zsh -lc \\\\\\\"python3 -B -c 'from pathlib import Path\\\\nimport sqlite3,collections,re,sys,json\\\\nroot=Path(\\\\\\\\\\\\\\\"poc/data\\\\\\\\\\\\\\\")\\\\nbase=root/\\\\\\\\\\\\\\\"comparison-2026-11-17\\\\\\\\\\\\\\\"\\\\ndef conn(p):\\\\n c=sqlite3.connect(p.resolve().as_uri()+\\\\\\\\\\\\\\\"?mode=ro&immutable=1\\\\\\\\\\\\\\\",uri=True)\\\\n c.row_factory=sqlite3.Row\\\\n return c\\\\ninputs=[(f\\\\\\\\\\\\\\\"old-{i}\\\\\\\\\\\\\\\",base/f\\\\\\\\\\\\\\\"run/old-{i}/prod/views.sqlite\\\\\\\\\\\\\\\",base/\\\\\\\\\\\\\\\"items-comparison.sqlite\\\\\\\\\\\\\\\") for i in (1,2,3)]+[(\\\\\\\\\\\\\\\"served\\\\\\\\\\\\\\\",root/\\\\\\\\\\\\\\\"served-2026-10-28-v34-nvda-3m-through-0828/views.sqlite\\\\\\\\\\\\\\\",root/\\\\\\\\\\\\\\\"items-nvda-2026-07-01-10-27.sqlite\\\\\\\\\\\\\\\")]\\\\nfor name,p,ip in inputs:\\\\n c=conn(p); i=conn(ip)\\\\n print(name,[(t,c.execute(f\\\\\\\\\\\\\\\"select count(*) from {t}\\\\\\\\\\\\\\\").fetchone()[0]) for t in (\\\\\\\\\\\\\\\"views\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"evidence\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"evidence_sources\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"judgements\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"replacements\\\\\\\\\\\\\\\")])\\\\n print(\\\\\\\\\\\\\\\"labels\\\\\\\\\\\\\\\",list(map(tuple,c.execute(\\\\\\\\\\\\\\\"select label,count(*) from rungs group by label order by count(*) desc limit 25\\\\\\\\\\\\\\\"))))\\\\n print(\\\\\\\\\\\\\\\"source cats\\\\\\\\\\\\\\\",list(map(tuple,c.execute(\\\\\\\\\\\\\\\"select category,count(*) from evidence_sources group by category\\\\\\\\\\\\\\\"))))\\\\n print(\\\\\\\\\\\\\\\"kinds\\\\\\\\\\\\\\\",list(map(tuple,c.execute(\\\\\\\\\\\\\\\"select distinct object_id,kind from views limit 12\\\\\\\\\\\\\\\"))))\\\\n if name==\\\\\\\\\\\\\\\"old-1\\\\\\\\\\\\\\\":\\\\n  print(\\\\\\\\\\\\\\\"items schema\\\\\\\\\\\\\\\",[r[1] for r in i.execute(\\\\\\\\\\\\\\\"pragma table_info(items)\\\\\\\\\\\\\\\")])\\\\n  print(\\\\\\\\\\\\\\\"questions\\\\\\\\\\\\\\\",list(map(tuple,c.execute(\\\\\\\\\\\\\\\"select view_id,question from views order by rowid\\\\\\\\\\\\\\\"))))\\\\n  print(\\\\\\\\\\\\\\\"judgements\\\\\\\\\\\\\\\",dict(c.execute(\\\\\\\\\\\\\\\"select * from judgements where view_id='\\\\\\\\\\\\\\\\''v8'\\\\\\\\\\\\\\\\'' order by judgement_id desc limit 1\\\\\\\\\\\\\\\").fetchone()))\\\\n  print(\\\\\\\\\\\\\\\"samples\\\\\\\\\\\\\\\", [dict(r) for r in c.execute(\\\\\\\\\\\\\\\"select * from evidence join evidence_links using(evidence_id) where view_id='\\\\\\\\\\\\\\\\''v8'\\\\\\\\\\\\\\\\'' limit 4\\\\\\\\\\\\\\\")])\\\\n'\\\\\\\"\\\",\\\"aggregated_output\\\":\\\"\\\",\\\"exit_code\\\":null,\\\"status\\\":\\\"in_progress\\\"}}\\ndocs/research/2026-11-22-number-answers/codex-r74.stream:46:{\\\"type\\\":\\\"item.completed\\\",\\\"item\\\":{\\\"id\\\":\\\"item_23\\\",\\\"type\\\":\\\"command_execution\\\",\\\"command\\\":\\\"/opt/homebrew/bin/zsh -lc \\\\\\\"python3 -B -c 'from pathlib import Path\\\\nimport sqlite3,collections,re,sys,json\\\\nroot=Path(\\\\\\\\\\\\\\\"poc/data\\\\\\\\\\\\\\\")\\\\nbase=root/\\\\\\\\\\\\\\\"comparison-2026-11-17\\\\\\\\\\\\\\\"\\\\ndef conn(p):\\\\n c=sqlite3.connect(p.resolve().as_uri()+\\\\\\\\\\\\\\\"?mode=ro&immutable=1\\\\\\\\\\\\\\\",uri=True)\\\\n c.row_factory=sqlite3.Row\\\\n return c\\\\ninputs=[(f\\\\\\\\\\\\\\\"old-{i}\\\\\\\\\\\\\\\",base/f\\\\\\\\\\\\\\\"run/old-{i}/prod/views.sqlite\\\\\\\\\\\\\\\",base/\\\\\\\\\\\\\\\"items-comparison.sqlite\\\\\\\\\\\\\\\") for i in (1,2,3)]+[(\\\\\\\\\\\\\\\"served\\\\\\\\\\\\\\\",root/\\\\\\\\\\\\\\\"served-2026-10-28-v34-nvda-3m-through-0828/views.sqlite\\\\\\\\\\\\\\\",root/\\\\\\\\\\\\\\\"items-nvda-2026-07-01-10-27.sqlite\\\\\\\\\\\\\\\")]\\\\nfor name,p,ip in inputs:\\\\n c=conn(p); i=conn(ip)\\\\n print(name,[(t,c.execute(f\\\\\\\\\\\\\\\"select count(*) from {t}\\\\\\\\\\\\\\\").fetchone()[0]) for t in (\\\\\\\\\\\\\\\"views\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"evidence\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"evidence_sources\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"judgements\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"replacements\\\\\\\\\\\\\\\")])\\\\n print(\\\\\\\\\\\\\\\"labels\\\\\\\\\\\\\\\",list(map(tuple,c.execute(\\\\\\\\\\\\\\\"select label,count(*) from rungs group by label order by count(*) desc limit 25\\\\\\\\\\\\\\\"))))\\\\n print(\\\\\\\\\\\\\\\"source cats\\\\\\\\\\\\\\\",list(map(tuple,c.execute(\\\\\\\\\\\\\\\"select category,count(*) from evidence_sources group by category\\\\\\\\\\\\\\\"))))\\\\n print(\\\\\\\\\\\\\\\"kinds\\\\\\\\\\\\\\\",list(map(tuple,c.execute(\\\\\\\\\\\\\\\"select distinct object_id,kind from views limit 12\\\\\\\\\\\\\\\"))))\\\\n if name==\\\\\\\\\\\\\\\"old-1\\\\\\\\\\\\\\\":\\\\n  print(\\\\\\\\\\\\\\\"items schema\\\\\\\\\\\\\\\",[r[1] for r in i.execute(\\\\\\\\\\\\\\\"pragma table_info(items)\\\\\\\\\\\\\\\")])\\\\n  print(\\\\\\\\\\\\\\\"questions\\\\\\\\\\\\\\\",list(map(tuple,c.execute(\\\\\\\\\\\\\\\"select view_id,question from views order by rowid\\\\\\\\\\\\\\\"))))\\\\n  print(\\\\\\\\\\\\\\\"judgements\\\\\\\\\\\\\\\",dict(c.execute(\\\\\\\\\\\\\\\"select * from judgements where view_id='\\\\\\\\\\\\\\\\''v8'\\\\\\\\\\\\\\\\'' order by judgement_id desc limit 1\\\\\\\\\\\\\\\").fetchone()))\\\\n  print(\\\\\\\\\\\\\\\"samples\\\\\\\\\\\\\\\", [dict(r) for r in c.execute(\\\\\\\\\\\\\\\"select * from evidence join evidence_links using(evidence_id) where view_id='\\\\\\\\\\\\\\\\''v8'\\\\\\\\\\\\\\\\'' limit 4\\\\\\\\\\\\\\\")])\\\\n'\\\\\\\"\\\",\\\"aggregated_output\\\":\\\"old-1 [('views', 47), ('evidence', 5390), ('evidence_sources', 5390), ('judgements', 1609), ('replacements', 0)]\\\\nlabels [('Yes', 28), ('No', 28), ('Strongly bullish', 17), ('Strongly bearish', 17), ('Neutral', 17), ('Bullish', 17), ('Bearish', 17), ('Below $800 billion', 1), ('Below $500 billion', 1), ('$900 billion to below $1.1 trillion', 1), ('$800 billion to below $900 billion', 1), ('$800 billion or more', 1), ('$700 billion to below $800 billion', 1), ('$600 billion to below $700 billion', 1), ('$500 billion to below $600 billion', 1), ('$1.2 trillion or more', 1), ('$1.1 trillion to below $1.2 trillion', 1)]\\\\nsource cats [('T1', 63), ('T2', 23), ('T3', 2), ('T4', 40), ('T6', 181), ('T7', 2816), ('T8', 2265)]\\\\nkinds [('NVDA', 'asset'), ('ai-capex', 'theme'), ('chip-export-controls', 'theme'), ('fed-policy-rate', 'theme')]\\\\nitems schema ['input_id', 'klass', 'category', 'content_sha256', 'copy_of', 'supersedes', 'channel', 'source_uri', 'publisher', 'publisher_type', 'authors', 'published_at', 'publication_day', 'day_source', 'listing_day', 'page_day', 'retrieved_at', 'is_structured', 'has_readable_text', 'document_format', 'channel_category', 'media_type', 'language', 'object_identifiers', 'title', 'text', 'text_article', 'coverage', 'text_chars', 'bootstrap', 'feed', 'source', 'topic', 'tier', 'extra', 'text_page', 'cleaning']\\\\nquestions [('v1', 'How much credit support for AI clouds will NVIDIA have committed at the end of FY2027?'), ('v2', 'What total amount of NVIDIA’s credit-support and capacity-purchase obligations will be outstanding at the FY2027 annual report?'), ('v3', 'Will NVIDIA begin shipping its Rubin platform by December 31, 2026?'), ('v4', \\\\\\\"What will NVIDIA's total revenue be in FY2027?\\\\\\\"), ('v5', \\\\\\\"What will NVIDIA's total revenue be in FY2028?\\\\\\\"), ('v6', 'How much will the four largest AI hyperscalers spend on data center capital expenditures in calendar 2026?'), ('v7', 'How much will the four largest AI hyperscalers spend on data center capital expenditures in calendar 2027?'), ('v8', 'How much Data Center segment revenue will NVIDIA report for FY2027?'), ('v9', 'Will China authorize purchases of Nvidia H200 chips by AI companies by January 31, 2027?'), ('v10', 'Will NVIDIA complete an investment in Firmus Technologies’ preference shares by December 31, 2026?'), ('v11', 'What gross margin will NVIDIA report for FY2027?'), ('v12', 'Will the French competition authority conclude its antitrust investigation into NVIDIA by January 31, 2027?'), ('v13', 'Will NVIDIA begin shipping its Kyber NVL144 next-generation AI rack system by December 31, 2028?'), ('v14', 'How much will NVIDIA’s supply-chain purchase commitments outstanding be at the end of FY2027?'), ('v15', 'How much total CPU revenue will NVIDIA report for FY2027?'), ('v16', 'Will the U.S. Senate pass the Remote Access Security Act by December 31, 2026?'), ('v17', 'Will NVIDIA complete its planned $1 billion investment in NAVER Corp. by December 31, 2026?'), ('v18', 'How much financing will NVIDIA have provided or committed to Amkor under the packaging expansion agreement by the FY2027 annual report?'), ('v19', \\\\\\\"Will NVIDIA agree to provide the reported financing guarantee for OpenAI's southern Ohio data center project by January 31, 2027?\\\\\\\"), ('v20', 'Will NVIDIA agree to finance OpenAI chip purchases for the southern Ohio data center project by January 31, 2027?'), ('v21', 'Will NVIDIA launch its Rosa next-generation CPU by December 31, 2028?'), ('v22', 'Will Taiwan’s Ministry of Economic Affairs adopt performance-threshold export controls for advanced chips by January 31, 2027?'), ('v23', 'Will NVIDIA complete the reported $5 billion investment in Safe Superintelligence by December 31, 2026?'), ('v24', 'Will NVIDIA agree to provide a financing guarantee for OpenAI’s southern Ohio data center project by January 31, 2027?'), ('v25', 'Will NVIDIA agree to finance OpenAI chip purchases for the southern Ohio data center project by January 31, 2027?'), ('v26', 'Will Taiwan adopt a criminal ban on all AI chip exports to China by January 31, 2027?'), ('v27', 'Will the U.S. Department of Commerce conclude its investigation into Chinese firms’ access to advanced U.S. chips by December 31, 2026?'), ('v28', 'How much will NVIDIA’s committed equity-investment obligations to ecosystem partners total at the FY2027 annual report?'), ('v29', 'Will NVIDIA complete final agreements for the announced institutional AI-infrastructure financing platforms by August 15, 2027?'), ('v30', 'Will NVIDIA complete its planned $1.5 billion investment in SB Energy by December 31, 2026?'), ('v31', 'Will NVIDIA complete its planned $1.5 billion investment in SB Energy by August 17, 2027?'), ('v32', 'How much will NVIDIA’s outstanding payment obligation for the Poolside Model Factory license be at the FY2027 annual report?'), ('v33', 'Will NVIDIA complete its reported $1 billion investment in Poolside by August 21, 2027?'), ('v34', 'What gross margin will NVIDIA report for FY2028?'), ('v35', 'Will NVIDIA complete its reported acquisition of Hugging Face by August 26, 2027?'), ('v36', 'How much financing will NVIDIA have provided to MediaTek through the announced convertible-bond investment by its FY2027 annual report?'), ('v37', 'Will NVIDIA complete its $3.5 billion investment in MediaTek by February 28, 2027?'), ('v38', 'How much will NVIDIA’s MediaTek convertible-bond purchase obligation amount to at the FY2027 annual report?'), ('v39', \\\\\\\"Will NVIDIA agree to invest in Thinking Machines Lab's reported funding round by September 4, 2027?\\\\\\\"), ('v40', \\\\\\\"How much will NVIDIA's total revenue grow year over year in FY2028?\\\\\\\"), ('v41', 'Will the Federal Reserve raise its policy rate at its September 15–16, 2026 meeting?'), ('v42', 'How much Networking revenue will NVIDIA report for FY2027?'), ('v43', 'Will the Department of Justice issue a formal enforcement decision on NVIDIA’s Groq deal by September 10, 2027?'), ('v44', 'How much Vera CPU revenue will NVIDIA report for FY2028?'), ('v45', 'Will NVIDIA complete an investment in Anthropic’s potential IPO by September 14, 2027?'), ('v46', 'Will NVIDIA agree to invest $10 billion in Anthropic’s IPO by September 20, 2026?'), ('v47', 'Will NVIDIA complete its acquisition of Hugging Face by June 30, 2027?')]\\\\njudgements {'judgement_id': 1580, 'view_id': 'v8', 'seq': 1884, 'input_id': 'day:2026-09-20', 'rung': 2, 'reasons': 'The reference is Morningstar’s $361 billion FY2027 Data Center estimate, which is in rung 2. The implied outcome is higher, at about $390 billion, but remains below rung 1’s $400 billion boundary: the reported first half is $164 billion, Q3 is about $100 billion using the $108 billion total-revenue midpoint and the recent 92.5% Data Center mix, and I estimate Q4 at about $126 billion, allowing for the stated Q4 reacceleration and Vera Rubin supply build while discounting for supply and infrastructure constraints. Thus the evidence supports a substantial premium to the reference but does not imply crossing $400 billion.', 'cited_evidence_json': '[\\\\\\\"e2295\\\\\\\", \\\\\\\"e5309\\\\\\\", \\\\\\\"e2720\\\\\\\", \\\\\\\"e3399\\\\\\\", \\\\\\\"e3401\\\\\\\", \\\\\\\"e3406\\\\\\\", \\\\\\\"e2650\\\\\\\", \\\\\\\"e2691\\\\\\\", \\\\\\\"e2693\\\\\\\", \\\\\\\"e2721\\\\\\\", \\\\\\\"e449\\\\\\\", \\\\\\\"e4248\\\\\\\", \\\\\\\"e4770\\\\\\\", \\\\\\\"e4771\\\\\\\", \\\\\\\"e4574\\\\\\\", \\\\\\\"e4803\\\\\\\", \\\\\\\"e4519\\\\\\\", \\\\\\\"e1135\\\\\\\", \\\\\\\"e2635\\\\\\\", \\\\\\\"e4059\\\\\\\", \\\\\\\"e4001\\\\\\\", \\\\\\\"e5176\\\\\\\", \\\\\\\"e5179\\\\\\\", \\\\\\\"e5183\\\\\\\", \\\\\\\"e5384\\\\\\\", \\\\\\\"e5385\\\\\\\"]', 'cited_views_json': '[]', 'pushes_json': '[{\\\\\\\"evidence_id\\\\\\\": \\\\\\\"e109\\\\\\\", \\\\\\\"push\\\\\\\": \\\\\\\"toward_first\\\\\\\"}, {\\\\\\\"evidence_id\\\\\\\": \\\\\\\"e436\\\\\\\", \\\\\\\"push\\\\\\\": \\\\\\\"toward_first\\\\\\\"}, {\\\\\\\"evidence_id\\\\\\\": \\\\\\\"e449\\\\\\\", \\\\\\\"push\\\\\\\": \\\\\\\"toward_last\\\\\\\"}, {\\\\\\\"evidence_id\\\\\\\": \\\\\\\"e1135\\\\\\\", \\\\\\\"push\\\\\\\": \\\\\\\"toward_first\\\\\\\"}, {\\\\\\\"evidence_id\\\\\\\": \\\\\\\"e2295\\\\\\\", \\\\\\\"push\\\\\\\": \\\\\\\"none\\\\\\\"}, {\\\\\\\"evidence_id\\\\\\\": \\\\\\\"e2635\\\\\\\", \\\\\\\"push\\\\\\\": \\\\\\\"toward_last\\\\\\\"}, {\\\\\\\"evidence_id\\\\\\\": \\\\\\\"e2650\\\\\\\", \\\\\\\"push\\\\\\\": \\\\\\\"toward_first\\\\\\\"}, {\\\\\\\"evidence_id\\\\\\\": \\\\\\\"e2681\\\\\\\", \\\\\\\"push\\\\\\\": \\\\\\\"toward_first\\\\\\\"}, {\\\\\\\"evidence_id\\\\\\\": \\\\\\\"e2686\\\\\\\", \\\\\\\"push\\\\\\\": \\\\\\\"toward_first\\\\\\\"}, {\\\\\\\"ev