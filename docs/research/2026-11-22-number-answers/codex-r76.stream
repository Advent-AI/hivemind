\\\\\\\\\\\\\\\'',1)[0].split('\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\''] '\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\'',1)[1]\\\\\\\\ndef tag(x,pattern): return bool(re.search(pattern,x or '\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\'''\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\'',re.I))\\\\\\\\ndef record(i):\\\\\\\\n v=db(i);a=db(i,'\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\''archive'\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\'')\\\\\\\\n return (v,a,v.execute(\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"select j.*,k.unit from judgements j join view_keys k using(view_id) where k.unit in ('\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\''USD'\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\'','\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\''percent'\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\'') order by judgement_id\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"))\\\\\\\\nv,a,_=record(2)\\\\\\\\nfor call in (8729,8737):\\\\\\\\n j=v.execute('\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\''select * from judgements where call_id=?'\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\'',(call,)).fetchone(); d,raw=req(a,j); ed=evidence(user(d))\\\\\\\\n print(call)\\\\\\\\n for e in ed.values():\\\\\\\\n  if tag(e,r'\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\''SemiAnalysis'\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\'') and tag(e,r'\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\''\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\b20%|20 percent'\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\''): print(e[:420])\\\\\\\\nq=v.execute(\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"select created_from_input from evidence where evidence_id='\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\''e1926'\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\''\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\").fetchone()[0]\\\\\\\\nfor c in a.execute(\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"select call_id,request_json from model_calls where purpose='\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\''extract'\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\'' and instr(request_json,?)>0 limit 1\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",(q,)):\\\\\\\\n s=user(json.loads(c['\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\''request_json'\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\'']))\\\\\\\\n p=s.find('\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\''What analysts expect the hyperscalers'\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\'')\\\\\\\\n print('\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\''BofA source context:'\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\'', c['\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\''call_id'\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\''],s[p-1250:p+580])\\\\\\\\n'\\\\\\\\\\\\\\\"\\\\\\\",\\\\\\\"aggregated_output\\\\\\\":\\\\\\\"8729\\\\\\\\n8737\\\\\\\\n- e976 [third_party_view; fool.com author Lyle Daly; original source SemiAnalysis ; from gnews:bdd09874d53aef7b27866d44 2026-07-26] SemiAnalysis forecast that NVIDIA Data Center revenue in the second half of FY2027 would exceed analyst estimates by 20%.\\\\\\\\n    Quote: And even though SemiAnalysis reported the delays, it's still bullish on Nvidia, forecasting that the chipmaker's data center revenue will exceed analyst es\\\\\\\\nBofA source context: 3435 used.\\\\\\\\nKeeping that spending off their own books is precisely the point, and the fact that such a structure is needed at all tells investors a great deal about where the constraints in the AI boom now lie.\\\\\\\\nThe financial engineering rests on a single reclassification. Graphics processing units (GPUs) have always been treated as equipment that loses value quickly, superseded whenever a faster generation arrives.\\\\\\\\nNvidia raises over €21.5bn in first bond sale since 2021 as AI growth race continues\\\\\\\\nAnalysis: Will Big Tech's colossal AI spending crush Europe's data sovereignty?\\\\\\\\nNvidia is effectively asking lenders to treat them instead as long-lived infrastructure, closer to a toll road or a power plant, that can be borrowed against for years.\\\\\\\\n\\\\\\\\\\\\\\\"These are revenue-generating assets now,\\\\\\\\\\\\\\\" Huang said, describing them as productive, long-lived and transferable between customers.\\\\\\\\nWhy the money had to come from somewhere else\\\\\\\\nThe timing reflects a squeeze that has been building all year.\\\\\\\\nMicrosoft, Amazon, Alphabet, Meta and other hyperscalers whose cloud platforms host most of the world's AI workloads have together guided roughly $720 billion (€624bn) to $745 billion (€646bn) of capital spending in 2026, an increase of about 77% on last year.\\\\\\\\nWhat analysts expect the hyperscalers to spend in 2027 alone has more than doubled in the space of a year, from a consensus of $480 billion (€416bn) in August 2025 to $1.08 trillion (€943bn) this month, a rise of about 127%, according to Bank of America.\\\\\\\\nThe pattern has repeated at every stage.\\\\\\\\nAnalysts who already considered last year's investment unsustainable then watched the hyperscalers guide higher at the start of 2026, revise those figures upward again through the year, and pencil in larger sums still for next year and 2028.\\\\\\\\nMoody's has warned that spending on this s\\\\\\\\n\\\\\\\",\\\\\\\"exit_code\\\\\\\":0,\\\\\\\"status\\\\\\\":\\\\\\\"completed\\\\\\\"}}\\\\ndocs/research/2026-11-22-number-answers/codex-r45.stream:103:{\\\\\\\"type\\\\\\\":\\\\\\\"item.started\\\\\\\",\\\\\\\"item\\\\\\\":{\\\\\\\"id\\\\\\\":\\\\\\\"item_53\\\\\\\",\\\\\\\"type\\\\\\\":\\\\\\\"command_execution\\\\\\\",\\\\\\\"command\\\\\\\":\\\\\\\"/opt/homebrew/bin/zsh -lc \\\\\\\\\\\\\\\"python3 -B -c 'import sqlite3,json,pathlib,re,collections,decimal\\\\\\\\nD=decimal.Decimal\\\\\\\\ndef db(i,name='\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\''views'\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\''):\\\\\\\\n c=sqlite3.connect((pathlib.Path(f'\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\''poc/data/comparison-2026-11-17/run/old-{i}/prod'\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\'')/(name+'\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\''.sqlite'\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\'')).resolve().as_uri()+'\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\''?mode=ro'\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\'',uri=True)\\\\\\\\n c.row_factory=sqlite3.Row\\\\\\\\n return c\\\\\\\\ndef req(a,j):\\\\\\\\n c=a.execute('\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\''select * from model_calls where call_id=?'\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\'',(j['\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\''call_id'\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\