''case'\\\\'')\nf2=F('\\\\''W'\\\\'',W('\\\\''company'\\\\'','\\\\''FY2027'\\\\'',measure='\\\\''whole rate'\\\\''),'\\\\''estimate'\\\\'','\\\\''forecast'\\\\'','\\\\''%'\\\\'',value=40,basis_text='\\\\''case'\\\\'')\nf=comp('\\\\''CAL'\\\\'',W('\\\\''company'\\\\'','\\\\''FY2027'\\\\'',measure='\\\\''resulting rate'\\\\''),'\\\\''share'\\\\'',['\\\\''W'\\\\'','\\\\''P'\\\\''],10,unit='\\\\''%'\\\\'')\ncheck('\\\\''S2 share 25% of 40%'\\\\'',it,[*base,f1,f2,f],ans)\ndef ranged(v):\n return F('\\\\''Z'\\\\'',W('\\\\''company'\\\\'','\\\\''FY2027'\\\\'',measure='\\\\''test factor'\\\\''),'\\\\''estimate'\\\\'','\\\\''forecast'\\\\'','\\\\''x'\\\\'',low=-2,high=3,basis_text='\\\\''test'\\\\'')\nfor n,lo,hi in [('\\\\''right same factor squared'\\\\'',0,9),('\\\\''wrong same factor squared'\\\\'',4,9)]:\n f=comp('\\\\''CAL'\\\\'',W('\\\\''company'\\\\'','\\\\''FY2027'\\\\'',measure='\\\\''test squared factor'\\\\''),'\\\\''product'\\\\'',['\\\\''Z'\\\\'','\\\\''Z'\\\\''],unit='\\\\''x'\\\\'',low=lo,high=hi)\n check('\\\\''S2 '\\\\''+n,it,[*base,ranged(None),f],ans)\nfor n,val in [('\\\\''huge integer'\\\\'',10**400),('\\\\''infinite amount'\\\\'',float('\\\\''inf'\\\\''))]:\n f=est('\\\\''QX'\\\\'',W('\\\\''company'\\\\'','\\\\''FY2027'\\\\'',measure='\\\\''extra'\\\\''),val)\n check('\\\\''S7 '\\\\''+n,it,[*base,f],ans)\ni=P['\\\\''single-O'\\\\'','\\\\''single'\\\\'']\nv=i['\\\\''members'\\\\''][0]\ncheck('\\\\''S7 unresolved empty reference (non-null)'\\\\'',i,[],[A(v,'\\\\''unresolved'\\\\'',reference_unavailable='\\\\'''\\\\'',why='\\\\''reported balance cannot be rolled forward'\\\\'')])\nf=est('\\\\''X'\\\\'',i['\\\\''family'\\\\'']['\\\\''members'\\\\''][v]['\\\\''what'\\\\''],46.5,outcome_for=[v],inputs=['\\\\''NO_FIGURE'\\\\''],operation='\\\\''sum'\\\\'',evidence_id='\\\\''e4648'\\\\'',quote_number='\\\\''\"'$10 billion'\"'\\\\'',qualifier='\\\\''none'\\\\'')\na=A(v,rung=2,reference_unavailable='\\\\''No direct reference'\\\\'',why='\\\\''Unresolved only field marked here'\\\\'')\ncheck('\\\\''S7 forbidden fields and dangling input'\\\\'',i,[f],[a])\nf.update(inputs=None, operation=None, evidence_id=None, quote_number=None, qualifier=None,value=None,low=42,high=49)\na.update(why=None,reasons='\\\\'''\\\\'')\ncheck('\\\\''S6 empty range reason'\\\\'',i,[f],[a])\n'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
