{"type":"item.completed","item":{"id":"item_59","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc 'nl -ba docs/research/2026-11-22-number-answers/blind_test.py'","aggregated_output":"     1\t\"\"\"The v13s blind conformance test (SMALL-DESIGN.md §5 with its [52] changes; D737, D738). $0 at the provider.\n     2\t\n     3\t  python3 blind_test.py build <out folder>      # the six registered requests, each in its own folder (system.txt, user.txt, schema.json)\n     4\t  python3 blind_test.py check <out folder>      # every writer's first answer through model.check_schema, from_answer and check\n     5\t  python3 blind_test.py packets <out folder>    # one reader packet per answer: the whole request text and the answer, checker hidden\n     6\t\n     7\tWriters put their first answer, unedited, at <out>/<case>/answers/<writer>.json (the writer label never reaches a reader).\n     8\t\"\"\"\n     9\timport hashlib\n    10\timport json\n    11\timport random\n    12\timport re\n    13\timport sqlite3\n    14\timport sys\n    15\tfrom pathlib import Path\n    16\t\n    17\tHERE = Path(__file__).resolve().parent\n    18\tREPO = HERE.parents[2]\n    19\tsys.path.insert(0, str(HERE))\n    20\tsys.path.insert(0, str(REPO / 'src'))\n    21\timport calc_small as cs  # noqa: E402\n    22\timport paid_gate as pg  # noqa: E402\n    23\tfrom hivemind import model  # noqa: E402\n    24\t\n    25\tW = pg.W\n    26\tCASES = {   # registered in SMALL-DESIGN.md §5: archive, calls, member keys\n    27\t    'P': {'draw': 'old-1', 'calls': [('v4', 8810), ('v8', 8816)], 'arm': 'joint'},\n    28\t    'P-v4': {'draw': 'old-1', 'calls': [('v4', 8810), ('v8', 8816)], 'arm': 'separate', 'member': 'v4'},\n    29\t    'P-v8': {'draw': 'old-1', 'calls': [('v4', 8810), ('v8', 8816)], 'arm': 'separate', 'member': 'v8'},\n    30\t    'S': {'draw': 'old-3', 'calls': [('v6', 9043)], 'arm': 'single',\n    31\t          'what': W('four largest AI hyperscalers', 'data-center capex', 'combined', 'CY2026')},\n    32\t    'O': {'draw': 'old-2', 'calls': [('v29', 8507)], 'arm': 'single', 'what': W('NVIDIA', 'equity investment commitments', 'company', 'end of FY2027'),\n    33\t          'note': pg.O_NOTE},\n    34\t    'E': {'draw': 'old-3', 'calls': [('v41', 9071)], 'arm': 'single', 'what': W('NVIDIA', 'revenue', 'Vera CPU', 'FY2028')},\n    35\t}\n    36\tREGISTERED_QUESTIONS = {\n    37\t    ('old-1', 'v4'): \"What will NVIDIA's total revenue be in FY2027?\",\n    38\t    ('old-1', 'v8'): 'How much Data Center segment revenue will NVIDIA report for FY2027?',\n    39\t    ('old-3', 'v6'): 'How much will the four largest AI hyperscalers spend on data-center capital expenditures in calendar 2026?',\n    40\t    ('old-2', 'v29'): \"How much will NVIDIA's equity investment commitments reach at the publication of its FY2027 annual report?\",\n    41\t    ('old-3', 'v41'): 'What will NVIDIA report as Vera CPU revenue for FY2028?',\n    42\t}\n    43\tREGISTERED_EDGES = {('old-1', 'v4'): [431.2, 392.0, 352.8, 313.6], ('old-1', 'v8'): [400.0, 350.0, 300.0, 250.0],\n    44\t                    ('old-3', 'v6'): [500.0, 600.0, 700.0, 800.0], ('old-2', 'v29'): [25.0, 50.0, 75.0, 100.0],\n    45\t                    ('old-3', 'v41'): [50.0, 40.0, 30.0, 20.0]}\n    46\t\n    47\t\n    48\tdef heading(draw, call_id):\n    49\t    a = sqlite3.connect(f'file:{pg.RUN / draw / \"prod/archive.sqlite\"}?mode=ro', uri=True)\n    50\t    user = json.loads(a.execute('select request_json from model_calls where call_id=?', (call_id,)).fetchone()[0])['messages'][1]['content']\n    51\t    m = re.match(r'Thesis (v\\d+) \\([^)]*\\): ([^\\n]*)', user)\n    52\t    return m.group(1), m.group(2)\n    53\t\n    54\t\n    55\tdef edges(bands):\n    56\t    out = []\n    57\t    for lo, hi in bands:\n    58\t        for e in (lo, hi):\n    59\t            if e is not None and e not in out:\n    60\t                out.append(e)\n    61\t    return out\n    62\t\n    63\t\n    64\tdef build_case(name, spec):\n    65\t    draw = spec['draw']\n    66\t    for view_id, call_id in spec['calls']:                     # the registered heading, question and ladder, or refuse\n    67\t        tid, question = heading(draw, call_id)\n    68\t        if tid != view_id or question != REGISTERED_QUESTIONS[(draw, view_id)]:\n    69\t            raise SystemExit(f'{name}: call {call_id} heads {tid} \"{question}\", not the registered {view_id}')\n    70\t        got = edges(pg.bands(draw, view_id))\n    71\t        if sorted(got) != sorted(REGISTERED_EDGES[(draw, view_id)]):\n    72\t            raise SystemExit(f'{name}: {view_id} ladder edges {got}, not the registered {REGISTERED_EDGES[(draw, view_id)]}')\n    73\t    if spec['arm'] in ('joint', 'separate'):\n    74\t        (tv, tc), (dv, dc) = spec['calls']\n    75\t        family = pg.small_family(pg.pair_family(draw, (tv, tc), (dv, dc)), pg.PAIR_SCOPES)\n    76\t        if spec['arm'] == 'joint':\n    77\t            return pg.item(f'blind-{name}', 'joint', draw, spec['calls'], family, [tv, dv], 'v13s')\n    78\t        return pg.item(f'blind-{name}', f'separate-{spec[\"member\"]}', draw, spec['calls'], pg.only(family, spec['member']), [spec['member']], 'v13s')\n    79\t    view_id, call_id = spec['calls'][0]\n    80\t    family = {'members': {view_id: {'what': spec['what'], 'bands': pg.bands(draw, view_id)}}, 'relations': [], 'shared': [], 'compare_periods': []}\n    81\t    family = pg.small_family(family, notes={view_id: spec['note']} if spec.get('note') else None)\n    82\t    return pg.item(f'blind-{name}', 'single', draw, spec['calls'], family, [view_id], 'v13s')\n    83\t\n    84\t\n    85\tdef build(out):\n    86\t    if out.exists():\n    87\t        raise SystemExit(f'{out} exists')\n    88\t    gate_quotes = {p['text'] for it in json.loads((HERE / 'paid-plan.json').read_text()) for p in it['passages'].values()}\n    89\t    report = []\n    90\t    for name, spec in CASES.items():\n    91\t        it = build_case(name, spec)\n    92\t        folder = out / name\n    93\t        (folder / 'answers').mkdir(parents=True)\n    94\t        (folder / 'system.txt').write_text(it['system'])\n    95\t        (folder / 'user.txt').write_text(it['user'])\n    96\t        (folder / 'schema.json').write_text(json.dumps(it['schema'], indent=1, ensure_ascii=False))\n    97\t        (folder / 'item.json').write_text(json.dumps(it, ensure_ascii=False))\n    98\t        fresh = sum(1 for p in it['passages'].values() if p['text'] not in gate_quotes)\n    99\t        report.append(f'{name:5} {it[\"arm\"]:13} members {it[\"members\"]} passages {len(it[\"passages\"])} ({fresh} quotes absent from the gate) '\n   100\t                      f'request {len(it[\"system\"]) + len(it[\"user\"]) + len(json.dumps(it[\"schema\"]))} chars')\n   101\t    (out / 'BUILD.txt').write_text('\\n'.join(report) + '\\n')\n   102\t    print('\\n'.join(report))\n   103\t\n   104\t\n   105\tdef first_json(text):\n   106\t    \"\"\"The writer's first output as returned: the outermost JSON object (fences around it ignored; nothing inside edited).\"\"\"\n   107\t    start, end = text.find('{'), text.rfind('}')\n   108\t    return json.loads(text[start:end + 1]) if 0 <= start < end else None\n   109\t\n   110\t\n   111\tdef check(out):\n   112\t    rows = []\n   113\t    for name in CASES:\n   114\t        it = json.loads((out / name / 'item.json').read_text())\n   115\t        for path in sorted((out / name / 'answers').glob('*.json')):\n   116\t            raw = path.read_text()\n   117\t            try:\n   118\t                data = first_json(raw)\n   119\t            except json.JSONDecodeError as error:\n   120\t                data, parse_error = None, str(error)\n   121\t            row = {'case': name, 'writer': path.stem, 'sha256': hashlib.sha256(raw.encode()).hexdigest()}\n   122\t            if data is None:\n   123\t                row.update(stage='not JSON', errors=[['format', 'no parseable JSON object']])\n   124\t            else:\n   125\t                schema_errors = model.check_schema(data, it['schema'])\n   126\t                if schema_errors:\n   127\t                    row.update(stage='schema', errors=[['schema', e] for e in schema_errors])\n   128\t                else:\n   129\t                    calc = cs.from_answer(data, it['family'])\n   130\t                    result = cs.check(it['family'], it['passages'], calc)\n   131\t                    row.update(stage='checked', errors=[list(e) for e in result['errors']], recorded=result['recorded'],\n   132\t                               published=result['published'], decision=cs.publish_decision(it['family'], calc, result))\n   133\t            rows.append(row)\n   134\t    (out / 'CHECKED.json').write_text(json.dumps(rows, indent=1, ensure_ascii=False))\n   135\t    for r in rows:\n   136\t        print(f'{r[\"case\"]:5} {r[\"writer\"]:10} {r[\"stage\"]:8} {r.get(\"decision\", \"-\"):9} ' + '; '.join(f'{c}: {d}' for c, d in r['errors'])[:300])\n   137\t\n   138\t\n   139\tREADER_BRIEF = \"\"\"# Blind reading (judging-v13s blind test, SMALL-DESIGN.md §5)\n   140\t\n   141\tYou are given one forecasting request (the questions, their ladders, and every passage the writer was shown) and one answer to it,\n   142\twritten in a JSON format. You are not told who wrote the answer or whether any check accepted it. Read only what is given here.\n   143\t\n   144\tFor **every member** the answer forecasts, and for the answer as a whole, return JSON:\n   145\t\n   146\t{\"members\": {\"<view id>\": {\"supported\": \"yes|no\", \"ground\": \"<the passage ids or the stated assumption that put the forecast in its band>\",\n   147\t                           \"why_not\": \"<if no: what is missing or wrong>\"}},\n   148\t \"defects\": [{\"type\": \"<one of: number misread | wrong arithmetic | part above or added into its whole | two forecasts of one quarter |\n   149\t               own estimate passed off as the market's reference | broken structure>\", \"figures\": [\"<figure ids>\"], \"detail\": \"...\"}]}\n   150\t\n   151\tDefinitions:\n   152\t- supported: the forecast follows from the shown passages and the answer's stated assumptions; a reader could check it against them.\n   153\t- number misread: a source figure's number, scale, sign or qualifier differs from what its passage writes.\n   154\t- wrong arithmetic: a computed figure does not equal its operation on its inputs.\n   155\t- part above or added into its whole: a segment is larger than the total it belongs to, or is added again into a total that already\n   156\t  includes it (directly or through an intermediate figure or an estimate).\n   157\t- two forecasts of one quarter: two different figures are used as the value of one quantity and period.\n   158\t- own estimate passed off as the market's reference: a figure marked as the market's reference is, or rests on, the writer's own\n   159\t  estimate or forecast.\n   160\t- broken structure: a link that does not resolve, a figure that depends on itself, a missing or doubled answer, an outcome that is not\n   161\t  the question's quantity, or a rung whose band does not hold the outcome.\n   162\tReturn an empty \"defects\" list when you find none. Return only JSON.\n   163\t\"\"\"\n   164\t\n   165\t\n   166\tdef packets(out):\n   167\t    rows = json.loads((out / 'CHECKED.json').read_text())\n   168\t    rng = random.Random(hashlib.sha256((out / 'CHECKED.json').read_bytes()).hexdigest())\n   169\t    order = list(range(len(rows)))\n   170\t    rng.shuffle(order)\n   171\t    key = {}\n   172\t    folder = out / 'reader-packets'\n   173\t    folder.mkdir(exist_ok=False)\n   174\t    for n, i in enumerate(order, 1):\n   175\t        r = rows[i]\n   176\t        it = json.loads((out / r['case'] / 'item.json').read_text())\n   177\t        raw = (out / r['case'] / 'answers' / f'{r[\"writer\"]}.json').read_text()\n   178\t        pid = f'R{n:02d}'\n   179\t        key[pid] = {'case': r['case'], 'writer': r['writer']}\n   180\t        (folder / f'{pid}.md').write_text(READER_BRIEF + '\\n# The request as the writer saw it\\n\\n' + it['user'] + '\\n\\n# The answer\\n\\n' + raw + '\\n')\n   181\t    (out / 'reader-key.json').write_text(json.dumps(key, indent=1))\n   182\t    print(f'{len(order)} packets in {folder}; key in reader-key.json (keep from readers)')\n   183\t\n   184\t\n   185\tif __name__ == '__main__':\n   186\t    cmd = sys.argv[1] if len(sys.argv) > 1 else ''\n   187\t    if cmd in ('build', 'check', 'packets') and len(sys.argv) == 3:\n   188\t        {'build': build, 'check': check, 'packets': packets}[cmd](Path(sys.argv[2]))\n   189\t    else:\n   190\t        raise SystemExit(__doc__)\n","exit_code":0,"status":"completed"}}
