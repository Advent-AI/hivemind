{"type":"item.completed","item":{"id":"item_53","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba docs/research/2026-11-22-number-answers/paid_gate.py | sed -n '455,468p;595,610p'\"","aggregated_output":"   455\t        summary = Gate(out, budget.BudgetTransport(ledger), ledger).run(items)\n   456\t    finally:\n   457\t        remove_gate()\n   458\t        ledger.remove_launcher('v13-gate')\n   459\t    print(json.dumps({k: v.get('decision') for k, v in summary['finals'].items()}, indent=1))\n   460\t\n   461\t\n   462\t# ---------- blind reading ----------\n   463\tQUESTIONS = {'usable': 'the outcome is usable and supported by the shown passages it rests on',\n   464\t             'contradiction': 'with the other card of its packet, it states a hard numerical contradiction',\n   465\t             'internal_reference': \"the system's own forecast is presented as the market's expectation\",\n   466\t             'deciding_gap': 'an unresolved overlap, a change of scope or an unsized adjustment decides its band'}\n   467\t\n   468\t\n   595\tdef render_packets(out, key):\n   596\t    \"\"\"The scoring packets for a key {salt, run_digest, order}: the key's salted sha256 first (so the text the readers receive commits\n   597\t    to the mapping), then each packet in the key's order, rendered from the run's results and plan.\"\"\"\n   598\t    results = json.loads((out / 'results.json').read_text())\n   599\t    items = {(i['unit'], i['arm']): i for i in json.loads((out / 'plan.json').read_text())}\n   600\t    units = packet_units(results, items)\n   601\t    lines, rendered = [f'Key commitment: {key_commitment(key)}', ''], {}\n   602\t    for pid, unit_key in key['order']:\n   603\t        decision, per_card = units[tuple(unit_key)]\n   604\t        body, grounds, members = packet_body(items, unit_key[0], unit_key[1], decision, per_card)\n   605\t        lines += [f'## {pid}'] + body\n   606\t        rendered[pid] = {'unit': unit_key[0], 'arm': unit_key[1], 'draw': unit_key[2], 'decision': decision, 'grounds': grounds,\n   607\t                         'cards': {f'K{n}': v for n, v in enumerate(members, 1)}}\n   608\t    return '\\n'.join(lines), rendered, units\n   609\t\n   610\t\n","exit_code":0,"status":"completed"}}
