{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba docs/research/2026-11-22-number-answers/render_v13.py | sed -n '165,450p'\"","aggregated_output":"   165\t    for ps in family.get('part_scopes', []):\n   166\t        lines.append(f'Scopes: {ps[\"population\"]} {ps[\"measure\"]} {ps[\"part\"]} is part of {ps[\"population\"]} {ps[\"measure\"]} {ps[\"whole\"]}. A sum '\n   167\t                     'never adds the part into the whole; a difference may take the part from the whole only to give the rest.')\n   168\t    shared = '; '.join(f'{w[\"population\"]}, {w[\"measure\"]}, {w[\"scope\"]}, {w[\"period\"]}' for w in family.get('shared', [])) or 'none'\n   169\t    lines.append(f'Shared quantities, one forecast figure each, through which every figure an outcome uses for that quantity goes: {shared}.')\n   170\t    keys = '; '.join(f'{v} = {m[\"what\"][\"population\"]} | {m[\"what\"][\"measure\"]} | {m[\"what\"][\"scope\"]} | {m[\"what\"][\"period\"]}'\n   171\t                     + (f' ({m[\"key_note\"]})' if m.get('key_note') else '') for v, m in family.get('members', {}).items() if v in shown)\n   172\t    lines.append(f'Outcome keys (population | measure | scope | period), in USD bn, to be used exactly: {keys}.')\n   173\t    return '\\n'.join(lines) + '\\n'\n   174\t\n   175\t\n   176\tdef parts(user):\n   177\t    head, rest = user.split('\\n\\n[Evidence in view', 1)\n   178\t    evidence = '[Evidence in view' + rest.split('\\n\\n[', 1)[0]\n   179\t    tail = '\\n\\n[' + rest.split('\\n\\n[', 1)[1] if '\\n\\n[' in rest else ''\n   180\t    blocks = {b.split(']', 1)[0]: '[' + b for b in tail.split('\\n\\n[')[1:]}\n   181\t    return head, evidence, blocks\n   182\t\n   183\t\n   184\tdef render(archive_path, calls, family, shown=None, fmt='v13'):\n   185\t    \"\"\"The v13 user message for a family from its members' stored requests: the members in `shown` (default: all) get a header; the\n   186\t    evidence in view is the union over every call, each passage once; the themes once; each member's exact figure keys. fmt 'v13s'\n   187\t    gives the small format's header lines (v13's bytes are unchanged).\"\"\"\n   188\t    archive = sqlite3.connect(f'file:{archive_path}?mode=ro', uri=True)\n   189\t    heads, lines, seen, themes, earlier = [], [], set(), '', []\n   190\t    shown = set(shown) if shown is not None else {v for v, _ in calls}\n   191\t    for view_id, call_id in calls:\n   192\t        user = json.loads(archive.execute('select request_json from model_calls where call_id=?', (call_id,)).fetchone()[0])['messages'][1]['content']\n   193\t        head, evidence, blocks = parts(user)\n   194\t        if view_id in shown:\n   195\t            heads.append(head)\n   196\t        for item in evidence.split('\\n- ')[1:]:\n   197\t            eid = item.split(' ', 1)[0]\n   198\t            if eid not in seen:\n   199\t                seen.add(eid)\n   200\t                lines.append('- ' + item)\n   201\t        themes = themes or next((v for k, v in blocks.items() if k.startswith('Themes')), '')\n   202\t        prev = next((v for k, v in blocks.items() if k.startswith('Previous')), '').split('\\n\\nAnswer per the JSON schema')[0]   # [46g.1] v7's output line goes\n   203\t        earlier.append(f'- {view_id}: ' + prev.replace('[Previous conclusion, for comparison only]', 'our earlier forecast, not a source:').strip())\n   204\t    rel = '; '.join(f'{r[\"part\"]} is part of {r[\"whole\"]}' if r['type'] == 'part_of' else f'{r[\"later\"]} rests on {r[\"earlier\"]}\\'s base'\n   205\t                    for r in family['relations'] if {r.get('part'), r.get('whole'), r.get('later'), r.get('earlier')} - {None} <= shown) or 'none'\n   206\t    shared = '; '.join(f'{w[\"population\"]}, {w[\"measure\"]}, {w[\"scope\"]}, {w[\"period\"]}' for w in family['shared']) or 'none'\n   207\t    keys = '; '.join(f'{v} = {m[\"what\"][\"population\"]} | {m[\"what\"][\"measure\"]} | {m[\"what\"][\"scope\"]} | {m[\"what\"][\"period\"]}'\n   208\t                     for v, m in family.get('members', {}).items() if v in shown)\n   209\t    if fmt == 'v13s':\n   210\t        header = v13s_header(family, shown)\n   211\t    else:\n   212\t        header = (f'Relations: {rel}.\\nShared quantities, one forecast each per scenario: {shared}.\\n'\n   213\t                  + (f'Outcome keys (population | measure | scope | period), to be used exactly: {keys}.\\n' if keys else ''))\n   214\t    user = ('[Family] members:\\n' + '\\n\\n'.join(heads) + '\\n\\n' + header + '\\n'\n   215\t            f'[Evidence in view for the family, {len(lines)} items]\\n' + '\\n'.join(lines) + '\\n\\n' + themes\n   216\t            + '\\n\\nAnswer per the JSON schema: one calculation for the family and one answer per member.')   # D728: no earlier forecast\n   217\t    return user, sorted(seen), [t.split(' ', 1)[0] for t in themes.split('\\n- ')[1:]]\n   218\t\n   219\t\n   220\tdef strict(calc, schema):\n   221\t    \"\"\"Fill every optional field with null, as strict structured output returns it.\"\"\"\n   222\t    fprops = schema['properties']['figures']['items']['properties']\n   223\t    aprops = schema['properties']['answers']['items']['properties']\n   224\t    figs = [{k: f.get(k) for k in fprops} for f in calc['figures']]\n   225\t    for f in figs:\n   226\t        f['scenario'] = f['scenario'] or 'base'\n   227\t        if f['what'] is None:\n   228\t            f['what'] = {'population': '', 'measure': '', 'scope': '', 'period': ''}\n   229\t    answers = []\n   230\t    for a in calc['answers']:\n   231\t        a2 = {k: a.get(k) for k in aprops}\n   232\t        if a2['reference'] is not None:\n   233\t            a2['reference'] = {'figure': a['reference'].get('figure'), 'unavailable': a['reference'].get('unavailable')}\n   234\t        a2['why'] = a.get('why')\n   235\t        answers.append(a2)\n   236\t    return {'figures': figs, 'answers': answers}\n   237\t\n   238\t\n   239\tdef without_nulls(calc):\n   240\t    clean = lambda d: {k: v for k, v in d.items() if v is not None}\n   241\t    answers = []\n   242\t    for a in calc['answers']:\n   243\t        a2 = clean(a)\n   244\t        if 'reference' in a2:\n   245\t            a2['reference'] = clean(a2['reference'])\n   246\t        answers.append(a2)\n   247\t    return {'figures': [clean(f) for f in calc['figures']], 'answers': answers}\n   248\t\n   249\t\n   250\tdef main():\n   251\t    archive = REPO / 'poc/data/comparison-2026-11-17/run/old-2/prod/archive.sqlite'\n   252\t    system = (HERE / 'judging-v13-draft.txt').read_text()\n   253\t    user, evidence_ids, theme_ids = render(archive, [('v14', 8729), ('v9', 8737)], gate.R1_FAMILY)\n   254\t    schema = v13_schema(['v14', 'v9'], evidence_ids, theme_ids)\n   255\t    calc = gate.r1('c')\n   256\t    answer = strict(calc, schema)\n   257\t    schema_errors = model.check_schema(answer, schema)\n   258\t    for a in answer['answers']:\n   259\t        a['cites'] = [e for e in a['cites'] if e in evidence_ids]\n   260\t    result = cc.check(gate.R1_FAMILY, gate.R1_PASSAGES, without_nulls(answer))\n   261\t    missing = sorted({f['evidence'] for f in calc['figures'] if f.get('evidence')} - set(evidence_ids))\n   262\t    report = [f'system {len(system)} characters; user {len(user)} characters; schema {len(json.dumps(schema))} characters',\n   263\t              f'evidence items {len(evidence_ids)}; themes {len(theme_ids)}',\n   264\t              f'source passages the answer cites that the rendered request does not show: {missing or \"none\"}',\n   265\t              f'schema errors: {schema_errors or \"none\"}', f'calc_check errors: {result[\"errors\"] or \"none\"}',\n   266\t              f'recorded: {json.dumps(result[\"recorded\"])}']\n   267\t    print('\\n'.join(report))\n   268\t    family_sb = {'members': {}, 'relations': [{'type': 'same_base', 'later': 'v35', 'earlier': 'v14'}],\n   269\t                 'shared': [{'population': 'NVIDIA', 'measure': 'revenue', 'scope': 'company', 'period': 'FY2027'}]}\n   270\t    user_sb, _, _ = render(archive, [('v14', 8729), ('v35', 8732)], family_sb)\n   271\t    line = next(l for l in user_sb.split('\\n') if l.startswith('Relations:'))\n   272\t    report.append(f'same-base family (calls 8729, 8732): {line}')\n   273\t    print(report[-1])\n   274\t    if \"v35 rests on v14's base\" not in line:\n   275\t        return 1\n   276\t    if len(sys.argv) > 1:\n   277\t        prefix = Path(sys.argv[1])\n   278\t        prefix.with_suffix('.request.json').write_text(json.dumps({'system': system, 'user': user, 'schema': schema}, indent=1))\n   279\t        prefix.with_suffix('.answer.json').write_text(json.dumps(answer, indent=1))\n   280\t        prefix.with_suffix('.txt').write_text('\\n'.join(report) + '\\n')\n   281\t    return 0 if not schema_errors and not result['errors'] and not missing else 1\n   282\t\n   283\t\n   284\tif __name__ == '__main__':\n   285\t    raise SystemExit(main())\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba docs/research/2026-11-22-number-answers/SMALL-DESIGN.md | sed -n '1,58p'\"","aggregated_output":"     1\t# judging-v13 small format (v13s): code refuses only the five defects and broken structure (D737)\n     2\t\n     3\tAlex (D737) chose to shrink the format. Code refuses an answer only for these five defects:\n     4\t- a number misread;\n     5\t- wrong arithmetic;\n     6\t- a part above its whole, or added into it;\n     7\t- two forecasts of one quarter;\n     8\t- an own estimate passed off as the market's.\n     9\t\n    10\tIt also refuses broken structure. Each rule is written in one or two sentences beside its field. Every other rule of `DESIGN.md`'s\n    11\tchecks becomes something the readers see, not a refusal.\n    12\t\n    13\t**Review scope (D737):** a counterexample that lets none of the five defects through, and breaks no structure, is a reader's matter,\n    14\tnot a finding. **Out of scope:**\n    15\t- the frozen ruler and `poc-v118`;\n    16\t- D725's pass lines and D731's harness rules;\n    17\t- the old run and its checker `calc_check.py`, which stay as they are, so the old run stays reproducible.\n    18\t\n    19\t## 1. What is dropped, and where it goes\n    20\t\n    21\t| Today's rule (DESIGN.md) | v13s |\n    22\t|---|---|\n    23\t| bounds and their propagation (C2 bound direction, C3/C6 open ends) | a source's qualifier is checked against the quote and shown to readers; computed figures are points or ranges |\n    24\t| scenarios, scenario membership, `range` summaries (C4) | one forecast per shared quantity; an outcome may be a range |\n    25\t| relations `time_aggregation` / `accounting_parts` / `stated_in_addition` / `overlap_unknown`, and `disputed` | periods of one quantity must make up the output's period (S8); an uncertain overlap is written as an estimate with its assumption |\n    26\t| bridges and `converts` (C8) | a conversion between quantities is computed or estimated as the analyst chooses; code records each computed figure whose inputs measure another quantity, and readers judge it |\n    27\t| `roll_forward`, the per-unit identity, `range_from_relative`, `signs` | `sum`, `difference`, `product`, `ratio`, `share`, `growth`, `apply_growth` |\n    28\t| `adjusts` | an estimate rests on the figure it changes |\n    29\t| C9 (same base), C10 (earlier forecasts) | none of the gate's families declares a same base; the request shows no earlier forecast (D728) |\n    30\t| the exact-expression grammar (C1) | the number as written (`quote_number`) plus a qualifier from a closed list |\n    31\t\n    32\t## 2. The rules code enforces (revised after round 52, `codex-r52.md`; the revision is marked [52])\n    33\t\n    34\t**[52] Shared definitions.**\n    35\t- **Uses.** A figure *uses* another when the other is among its `inputs`, at any depth. An estimate's `rests_on` is a judgement, not\n    36\t  a use. Code records it for readers, and an estimate is the value the figures above it use.\n    37\t- **Recomputed values.** The published value of a computed figure is the recomputed one, a point or a range. S3, S4 and S6 compare\n    38\t  recomputed values. S2's tolerance applies only between a declared value and its recomputed value.\n    39\t\n    40\t| # | Defect | Rule [52] (as the request states it) | Where stated |\n    41\t|---|---|---|---|\n    42\t| S1 | a number misread | A source figure names its passage (`evidence_id`) and copies the number exactly as the quote writes it (`quote_number`). The number is in US dollars ($, US$) with its scale (trillion, billion, bn, million), or is a percentage, or is one of the words double, triple or twice. The value equals it, with money in billions. A minus written before it makes the value negative. A qualifier written just before it (or \"or more\" / \"or less\" just after) goes in `qualifier`. A written range (\"$3–4 billion\", \"between $3 billion and $4 billion\") gives low and high. \"$4.5 billion, plus or minus 3%\" is copied whole, and gives its range as low and high or its midpoint as value. Money in another currency cannot be a source. | `kind`, `evidence_id`, `quote_number`, `qualifier`, `unit` |\n    43\t| S2 | wrong arithmetic | A computed figure equals its operation's result within 0.5% (at least 0.1, or 0.05 for %). Units are those `operation` states for each operation; a sum or difference adds one unit. A range input gives a range: both extremes are computed first, and a midpoint may be declared as value. Division by a range that contains zero is refused. | `operation` |\n    44\t| S3 | a part above its whole | For each period the Relations line lists, and for the outcomes, the part's lowest recomputed value used for that period may not exceed the whole's highest. | the family header |\n    45\t| S8 | a part added into its whole; periods misadded | A sum never adds a figure that uses (or is) the part's quantity to one that uses (or is) the whole's: the whole already includes the part. A difference may subtract the part from the whole only to give the rest, another scope. When a sum's or difference's inputs are periods of one quantity, each period is written FY2027, FY2027 Q3, FY2027 H1, FY2027 Q1-Q3 (or CY likewise), and together they make up the output's period exactly (Q1 + Q2 = H1; FY − Q1-Q3 = Q4). An estimate that rests on both the part and the whole is recorded for readers. | `operation`; `what.period`; the family header |\n    46\t| S4 | two forecasts of one quarter | Every number the outcomes use for one quantity and period is the same figure. Compute each quantity and period once, as a point or a range, and use that figure wherever it is needed. (Guidance or consensus beneath that figure is fine; a second figure of the same quantity and period reached on another path is not.) | the family header; `figures` |\n    47\t| S5 | an own estimate passed off as the market's | The figure marked in `reference_for` and every figure beneath it (inputs and rests_on) is a source, or computed with no basis forecast. None is an estimate. At least one is a quoted consensus, guidance or third_party figure, which may be the marked figure itself. A forecast member has exactly one marked reference figure or a `reference_unavailable` reason. | `reference_for`; `reference_unavailable` |\n    48\t| S6 | structure: the answer's number | A forecast member has exactly one figure marked in `outcome_for`. It is a computed or estimate figure with basis forecast (the analyst's own forecast, even when it agrees with consensus). Its `what` is the member's outcome key, its unit is USD bn, and its rung is 1 to the ladder's length. The rung's band (lower edge included, upper excluded) holds the recomputed outcome, or overlaps it for a range. | `outcome_for`; `rung` |\n    49\t| S7 | structure: the calculation | Ids are unique and never equal a passage id. `inputs` name figures; `rests_on` names figures or passages. No figure uses itself. A figure has value, or low and high (low ≤ high), never both. A source has `evidence_id` and `quote_number`; a computed figure has `inputs` and `operation`; an estimate has `basis_text`. Basis forecast is never on a source. There is one answer per member. An unresolved answer has `why`, rung null, `reference_unavailable` null and no marked figure. | the field descriptions |\n    50\t\n    51\t**[52] Operation units (stated in `operation`):**\n    52\t- sum and difference: one unit in, the same out.\n    53\t- product: USD bn × x → USD bn; x × x → x; % × x → %; never USD bn × %.\n    54\t- ratio: same unit → x; USD bn ÷ x → USD bn.\n    55\t- share(whole, percent): whole's unit.\n    56\t- growth(old, new): same unit → %.\n    57\t- apply_growth(base, rate %): base's unit.\n    58\t\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba docs/research/2026-11-22-number-answers/calc_small.py | sed -n '345,700p'\"","aggregated_output":"   345\tdef _sources(passages, figs):\n   346\t    errors = []\n   347\t    for f in figs.values():\n   348\t        if f['kind'] != 'source':\n   349\t            continue\n   350\t        fid, qn, ev = f['id'], f['quote_number'], f['evidence']\n   351\t        if ev not in passages:\n   352\t            errors.append(('S1', f'{fid}: evidence_id {ev} is not a shown passage'))\n   353\t            continue\n   354\t        text = passages[ev]['text']\n   355\t        found_at = [m.start() for m in re.finditer(re.escape(qn), text)]\n   356\t        starts = [i for i in found_at if not (i > 0 and text[i - 1] in '-−–' and qn[:1] not in '-−–')]   # a sign or range end left off\n   357\t        if not starts:\n   358\t            errors.append(('S1', f'{fid}: \"{qn}\" is not written in the quote of {ev}' if not found_at else\n   359\t                           f'{fid}: the quote writes a sign or a range end before \"{qn}\"; copy the number whole'))\n   360\t            continue\n   361\t        parsed = parse_number(qn)\n   362\t        if parsed is None:\n   363\t            errors.append(('S1', f'{fid}: \"{qn}\" is not a US-dollar amount, a percentage or double, triple or twice, as written'))\n   364\t            continue\n   365\t        if f['unit'] != parsed['unit']:\n   366\t            errors.append(('S1', f'{fid}: \"{qn}\" is in {parsed[\"unit\"]}, not {f[\"unit\"]}'))\n   367\t            continue\n   368\t        if 'low' in parsed:\n   369\t            ok = (_same(f.get('low'), parsed['low']) and _same(f.get('high'), parsed['high'])) or \\\n   370\t                 ('mid' in parsed and _same(f.get('value'), parsed['mid']))\n   371\t        else:\n   372\t            ok = _same(f.get('value'), parsed['value'])\n   373\t        if not ok:\n   374\t            want = (f'low {parsed[\"low\"]:g} and high {parsed[\"high\"]:g}' + (f', or value {parsed[\"mid\"]:g}' if 'mid' in parsed else '')\n   375\t                    if 'low' in parsed else f'value {parsed[\"value\"]:g}')\n   376\t            errors.append(('S1', f'{fid}: \"{qn}\" gives {want} {parsed[\"unit\"]}'))\n   377\t            continue\n   378\t        q = f.get('qualifier') or 'none'\n   379\t        written = []\n   380\t        for start in starts:\n   381\t            before, after = text[:start], text[start + len(qn):]\n   382\t            found = next((w for w in QUALIFIERS_BEFORE if re.search(r'(?:^|\\W)' + re.escape(w) + r'\\s*$', before, re.I)), None)\n   383\t            if found is None:\n   384\t                found = next((w for w in QUALIFIERS_AFTER if re.match(r'^\\s*,?\\s*' + re.escape(w) + r'\\b', after, re.I)), None)\n   385\t            written.append(found or 'none')\n   386\t        if q not in written:\n   387\t            errors.append(('S1', f'{fid}: the quote writes \"{written[0] if written else \"none\"}\" with \"{qn}\", but the qualifier is {q}'))\n   388\t    return errors\n   389\t\n   390\t\n   391\tdef _arithmetic(figs, values):\n   392\t    errors = []\n   393\t    for f in figs.values():\n   394\t        if f['kind'] != 'computed':\n   395\t            continue\n   396\t        fid, op, ins = f['id'], f['operation'], f['inputs']\n   397\t        unit = _result_unit(op, [figs[i]['unit'] for i in ins])\n   398\t        if unit is None:\n   399\t            hint = ' (use share for a whole times a percentage)' if op == 'product' else ''\n   400\t            errors.append(('S2', f'{fid}: {op} cannot take inputs in {\", \".join(figs[i][\"unit\"] for i in ins)}{hint}'))\n   401\t            continue\n   402\t        if unit != f['unit']:\n   403\t            errors.append(('S2', f'{fid}: {op} of these inputs gives {unit}, not {f[\"unit\"]}'))\n   404\t            continue\n   405\t        got = {i: values.get(i) for i in ins}\n   406\t        if not all(got.values()):\n   407\t            continue                                       # an input that cannot be evaluated is refused at that input\n   408\t        if op in ('ratio', 'growth'):\n   409\t            denominator = got[ins[1]] if op == 'ratio' else got[ins[0]]\n   410\t            if denominator[0] <= 0 <= denominator[1]:\n   411\t                errors.append(('S2', f'{fid}: divides by a figure whose value can be zero'))\n   412\t                continue\n   413\t        if op == 'share' and not (0 <= got[ins[1]][0] and got[ins[1]][1] <= 100):\n   414\t            errors.append(('S2', f'{fid}: a share takes a percentage from 0 to 100'))\n   415\t            continue\n   416\t        lo, hi = values[fid]\n   417\t        if isinstance(f.get('low'), (int, float)):\n   418\t            ok = _close(f['low'], lo, unit) and _close(f['high'], hi, unit)\n   419\t        else:\n   420\t            ok = _close(f['value'], (lo + hi) / 2, unit)\n   421\t        if not ok:\n   422\t            declared = f'{f[\"low\"]:g}–{f[\"high\"]:g}' if isinstance(f.get('low'), (int, float)) else f'{f[\"value\"]:g}'\n   423\t            got_text = f'{lo:.4g}' if lo == hi else f'{lo:.4g}–{hi:.4g}'\n   424\t            errors.append(('S2', f'{fid}: declared {declared} but {op} of {\", \".join(ins)} gives {got_text}'))\n   425\t    return errors\n   426\t\n   427\t\n   428\tdef _overlaps(interval, band):\n   429\t    lo, hi = interval\n   430\t    b_lo = band[0] if band[0] is not None else -math.inf\n   431\t    b_hi = band[1] if band[1] is not None else math.inf\n   432\t    if lo == hi:\n   433\t        return b_lo <= lo < b_hi\n   434\t    return lo < b_hi and hi >= b_lo\n   435\t\n   436\t\n   437\tdef _answers(family, figs, values, calc):\n   438\t    errors, outcomes = [], {}\n   439\t    members = family['members']\n   440\t    for a in calc['answers']:\n   441\t        v = a.get('view_id')\n   442\t        member = members.get(v)\n   443\t        if member is None or a.get('shape') == 'unresolved':\n   444\t            continue\n   445\t        out = figs.get(a.get('outcome'))\n   446\t        if out is None:\n   447\t            continue                                       # reported by from_answer\n   448\t        if out['kind'] not in ('computed', 'estimate') or out['basis'] != 'forecast':\n   449\t            errors.append(('S6', f'{v}: its outcome {out[\"id\"]} must be your own forecast (a computed or estimate figure with basis forecast)'))\n   450\t        if _key(out['what']) != _key(member['what']):\n   451\t            errors.append(('S6', f'{v}: outcome {out[\"id\"]} measures {\" | \".join(_key(out[\"what\"]))}, not the question\\'s {\" | \".join(_key(member[\"what\"]))}'))\n   452\t        if out['unit'] != member.get('unit', 'USD bn'):\n   453\t            errors.append(('S6', f'{v}: outcome {out[\"id\"]} is in {out[\"unit\"]}, not {member.get(\"unit\", \"USD bn\")}'))\n   454\t        outcomes[v] = out['id']\n   455\t        rung = a.get('rung')\n   456\t        if not isinstance(rung, int) or isinstance(rung, bool) or not 1 <= rung <= len(member['bands']):\n   457\t            errors.append(('S6', f'{v}: rung {rung!r} is not one of 1..{len(member[\"bands\"])}'))\n   458\t            continue\n   459\t        interval = values.get(out['id'])\n   460\t        if interval is not None and not _overlaps(interval, member['bands'][rung - 1]):\n   461\t            shown = f'{interval[0]:g}' if interval[0] == interval[1] else f'{interval[0]:g}–{interval[1]:g}'\n   462\t            errors.append(('S6', f'{v}: rung {rung} {member[\"bands\"][rung - 1]} does not hold its outcome {shown}'))\n   463\t        ref = (a.get('reference') or {}).get('figure')\n   464\t        if ref in figs:\n   465\t            chain = {ref} | _beneath(ref, figs)\n   466\t            if any(figs[g]['kind'] == 'estimate' for g in chain):\n   467\t                errors.append(('S5', f'{v}: its reference {ref} is or rests on an estimate'))\n   468\t            elif any(figs[g]['basis'] == 'forecast' for g in chain):\n   469\t                errors.append(('S5', f'{v}: its reference {ref} is or rests on a forecast'))\n   470\t            elif not any(figs[g]['kind'] == 'source' and figs[g]['basis'] in EXTERNAL for g in chain):\n   471\t                errors.append(('S5', f'{v}: its reference {ref} has no quoted consensus, guidance or outside figure'))\n   472\t    return errors, outcomes\n   473\t\n   474\t\n   475\tdef _shared(family, figs, outcomes):\n   476\t    errors = []\n   477\t    by_key = {}\n   478\t    for f in figs.values():\n   479\t        if f['basis'] == 'forecast':\n   480\t            by_key.setdefault(_key(f['what']), []).append(f['id'])\n   481\t    for k, ids in sorted(by_key.items()):\n   482\t        if len(ids) > 1:\n   483\t            errors.append(('S4', f'{\" | \".join(k)}: {len(ids)} forecasts ({\", \".join(sorted(ids))}); compute it once and use that figure'))\n   484\t    for want in family.get('shared', []):\n   485\t        key = _key(want)\n   486\t        node = by_key.get(key, [])\n   487\t        for v, out in sorted(outcomes.items()):\n   488\t            reached, stack, seen_ids = [], [out], set()\n   489\t            while stack:\n   490\t                fid = stack.pop()\n   491\t                if fid in seen_ids or fid not in figs:\n   492\t                    continue\n   493\t                seen_ids.add(fid)\n   494\t                f = figs[fid]\n   495\t                if fid != out and _key(f['what']) == key:\n   496\t                    reached.append(fid)\n   497\t                    if f['basis'] == 'forecast':\n   498\t                        continue                           # through the forecast figure: what lies beneath it is its basis\n   499\t                stack.extend(f.get('inputs') or [])\n   500\t            if not reached:\n   501\t                continue\n   502\t            if len(node) != 1:\n   503\t                errors.append(('S4', f'{v}: uses {\" | \".join(key)} but the calculation has {len(node)} forecast figures for it'))\n   504\t                continue\n   505\t            bypass = sorted(r for r in reached if r != node[0])      # the walk never descends below the forecast figure\n   506\t            if bypass:\n   507\t                errors.append(('S4', f'{v}: uses {\", \".join(bypass)} for {\" | \".join(key)} beside its forecast figure {node[0]}'))\n   508\t    return errors\n   509\t\n   510\t\n   511\tdef _part_whole(family, figs, values, outcomes):\n   512\t    errors = []\n   513\t    members = family['members']\n   514\t    for rel in family.get('relations', []):\n   515\t        if rel.get('type') != 'part_of' or rel['part'] not in members or rel['whole'] not in members:\n   516\t            continue\n   517\t        p_what, w_what = members[rel['part']]['what'], members[rel['whole']]['what']\n   518\t        pairs = []\n   519\t        if rel['part'] in outcomes and rel['whole'] in outcomes:\n   520\t            pairs.append((outcomes[rel['part']], outcomes[rel['whole']], 'outcome'))\n   521\t        for period in family.get('compare_periods', []):\n   522\t            if period == p_what['period']:\n   523\t                continue\n   524\t            found = []\n   525\t            for what in (p_what, w_what):\n   526\t                key = (what['population'], what['measure'], what['scope'], period)\n   527\t                cands = [f['id'] for f in figs.values() if _key(f['what']) == key]\n   528\t                forecasts = [c for c in cands if figs[c]['basis'] == 'forecast']\n   529\t                found.append(forecasts[0] if len(forecasts) == 1 else (cands[0] if len(cands) == 1 else None))\n   530\t            if all(found):\n   531\t                pairs.append((found[0], found[1], period))\n   532\t        for part, whole, label in pairs:\n   533\t            pv, wv = values.get(part), values.get(whole)\n   534\t            if pv is None or wv is None:\n   535\t                continue\n   536\t            eps = 1e-9 * max(1.0, abs(wv[1]))\n   537\t            if whole in _uses(part, figs):\n   538\t                bad = pv[0] > wv[0] + eps or pv[1] > wv[1] + eps\n   539\t            else:\n   540\t                bad = pv[0] > wv[1] + eps\n   541\t            if bad:\n   542\t                errors.append(('S3', f'{label}: the part {part} ({pv[0]:g}–{pv[1]:g}) exceeds the whole {whole} ({wv[0]:g}–{wv[1]:g})'))\n   543\t    return errors\n   544\t\n   545\t\n   546\tdef _sums(family, figs):\n   547\t    errors = []\n   548\t    scopes = family.get('part_scopes', [])\n   549\t    for f in figs.values():\n   550\t        if f['kind'] != 'computed' or f['operation'] not in ('sum', 'difference'):\n   551\t            continue\n   552\t        fid, ins = f['id'], [figs[i] for i in f['inputs']]\n   553\t        for ps in scopes:\n   554\t            same = [i for i in ins if (i['what']['population'], i['what']['measure']) == (ps['population'], ps['measure'])]\n   555\t            in_scopes = {i['what']['scope'] for i in same}\n   556\t            if {ps['part'], ps['whole']} <= in_scopes:\n   557\t                if f['operation'] == 'sum':\n   558\t                    errors.append(('S8', f'{fid}: adds {ps[\"part\"]} into {ps[\"whole\"]}, which already includes it'))\n   559\t                elif not (ins[0]['what']['scope'] == ps['whole'] and ins[1]['what']['scope'] == ps['part']\n   560\t                          and f['what']['scope'] not in (ps['part'], ps['whole'])):\n   561\t                    errors.append(('S8', f'{fid}: a difference may take {ps[\"part\"]} from {ps[\"whole\"]} only to give the rest, another scope'))\n   562\t        group = ins + [f]\n   563\t        if len({_quantity(g['what']) for g in group}) != 1:\n   564\t            continue\n   565\t        periods = [g['what']['period'] for g in group]\n   566\t        if f['operation'] == 'sum' and len(set(periods)) == 1:\n   567\t            errors.append(('S8', f'{fid}: adds one quantity and period more than once'))\n   568\t            continue\n   569\t        parsed = [_period(p) for p in periods]\n   570\t        if not any(parsed) or len(set(periods)) == 1:\n   571\t            continue\n   572\t        if not all(parsed):\n   573\t            errors.append(('S8', f'{fid}: when periods of one quantity are added or subtracted, write each as FY2027, FY2027 Q3, FY2027 H1 or '\n   574\t                                 f'FY2027 Q1-Q3 (or CY likewise); got {\", \".join(periods)}'))\n   575\t            continue\n   576\t        if not all(parsed):\n   577\t            continue\n   578\t        years = {p[0] for p in parsed}\n   579\t        *parts, out = parsed\n   580\t        if len(years) != 1:\n   581\t            ok = False\n   582\t        elif f['operation'] == 'sum':\n   583\t            total = [q for p in parts for q in p[1]]\n   584\t            ok = len(total) == len(set(total)) and set(total) == out[1]\n   585\t        else:\n   586\t            ok = parts[1][1] <= parts[0][1] and parts[0][1] - parts[1][1] == out[1]\n   587\t        if not ok:\n   588\t            sign = ' + ' if f['operation'] == 'sum' else ' − '\n   589\t            errors.append(('S8', f'{fid}: {sign.join(periods[:-1])} does not make up {periods[-1]}'))\n   590\t    return errors\n   591\t\n   592\t\n   593\tdef _recorded(family, figs, outcomes):\n   594\t    recorded = []\n   595\t    scopes = family.get('part_scopes', [])\n   596\t    for f in figs.values():\n   597\t        fid = f['id']\n   598\t        if f['kind'] == 'estimate':\n   599\t            recorded.append({'type': 'estimate', 'figure': fid, 'assumption': f.get('basis_text')})\n   600\t            rested = {figs[r]['what']['scope'] for r in f.get('rests_on') or [] if r in figs}\n   601\t            if any({ps['part'], ps['whole']} <= rested for ps in scopes):\n   602\t                recorded.append({'type': 'part and whole in one estimate', 'figure': fid})\n   603\t        elif f['kind'] == 'computed':\n   604\t            money = [figs[i] for i in f['inputs'] if figs[i]['unit'] == 'USD bn']\n   605\t            if any(_quantity(i['what']) != _quantity(f['what']) for i in money) and f['operation'] != 'share':\n   606\t                recorded.append({'type': 'conversion between quantities', 'figure': fid})\n   607\t            if f['operation'] in ('apply_growth', 'product') and any(i['what']['period'] != f['what']['period'] for i in money):\n   608\t                recorded.append({'type': 'carried across periods', 'figure': fid})\n   609\t        elif (f.get('qualifier') or 'none') != 'none':\n   610\t            recorded.append({'type': 'qualified source', 'figure': fid, 'qualifier': f['qualifier']})\n   611\t    used = set()\n   612\t    for out in outcomes.values():\n   613\t        used |= {out} | _beneath(out, figs)\n   614\t    by_key = {}\n   615\t    for fid in used:\n   616\t        by_key.setdefault(_key(figs[fid]['what']), []).append(fid)\n   617\t    for k, ids in sorted(by_key.items()):\n   618\t        if len(ids) > 1:\n   619\t            recorded.append({'type': 'one quantity, several figures', 'figure': sorted(ids)[0], 'figures': sorted(ids), 'what': list(k)})\n   620\t    return recorded\n   621\t\n   622\t\n   623\tdef check(family, passages, calc):\n   624\t    figs = {f['id']: f for f in calc['figures'] if isinstance(f.get('id'), str)}\n   625\t    errors = _structure(family, passages, calc, figs)\n   626\t    if errors:\n   627\t        return {'errors': errors, 'recorded': [], 'published': {}}\n   628\t    values = evaluate(figs)\n   629\t    errors = _sources(passages, figs) + _arithmetic(figs, values)\n   630\t    for f in figs.values():\n   631\t        if values.get(f['id']) is None and not any(e[1].startswith(f['id'] + ':') for e in errors):\n   632\t            errors.append(('S2', f'{f[\"id\"]}: the value cannot be evaluated'))\n   633\t    if errors:\n   634\t        return {'errors': errors, 'recorded': [], 'published': {}}\n   635\t    answer_errors, outcomes = _answers(family, figs, values, calc)\n   636\t    errors = answer_errors + _shared(family, figs, outcomes) + _part_whole(family, figs, values, outcomes) + _sums(family, figs)\n   637\t    published = {v: [values[o][0], values[o][1], None] for v, o in outcomes.items()}\n   638\t    return {'errors': errors, 'recorded': _recorded(family, figs, outcomes), 'published': published}\n   639\t\n   640\t\n   641\tdef publish_decision(family, calc, result):\n   642\t    \"\"\"'refused' when a check fails; 'held' when a member is unresolved and a declared relation joins it to another member; else\n   643\t    'publish' (an unresolved member is shown as unresolved).\"\"\"\n   644\t    if result['errors']:\n   645\t        return 'refused'\n   646\t    unresolved = {a['view_id'] for a in calc['answers'] if a.get('shape') == 'unresolved'}\n   647\t    for rel in family.get('relations', []):\n   648\t        ends = {rel.get('part'), rel.get('whole'), rel.get('later'), rel.get('earlier')} - {None}\n   649\t        if ends & unresolved and ends - unresolved:\n   650\t            return 'held'\n   651\t    return 'publish'\n","exit_code":0,"status":"completed"}}
