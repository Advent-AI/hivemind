{"type":"item.completed","item":{"id":"item_20","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc 'nl -ba docs/research/2026-11-22-number-answers/small_mutants.py'","aggregated_output":"     1\t\"\"\"Mutants of calc_small.py (AGENTS §4): each disables one rule on a scratch copy; small_cases.py must fail on every mutant while the\n     2\tunmutated control passes. Usage: python3 small_mutants.py <scratch folder>\"\"\"\n     3\timport os\n     4\timport shutil\n     5\timport subprocess\n     6\timport sys\n     7\tfrom pathlib import Path\n     8\t\n     9\tHERE = Path(__file__).resolve().parent\n    10\tREPO = HERE.parents[2]\n    11\tM = [\n    12\t    ('S1 value', \"            ok = _same(f.get('value'), parsed['value'])\\n\", \"            ok = True\\n\"),\n    13\t    ('S1 qualifier', \"        if q not in written:\\n\", \"        if False:\\n\"),\n    14\t    ('S1 sign', \"        starts = [i for i in found_at if not (i > 0 and text[i - 1] in '-−–' and qn[:1] not in '-−–')]\", \"        starts = found_at\"),\n    15\t    ('S1 passage', \"            errors.append(('S1', f'{fid}: \\\"{qn}\\\" is not written in the quote of {ev}' if not found_at else\", \"            (lambda *args: None)(('S1', f'{fid}: \\\"{qn}\\\" is not written in the quote of {ev}' if not found_at else\"),\n    16\t    ('S2 arithmetic', \"        if not ok:\\n            declared =\", \"        if False:\\n            declared =\"),\n    17\t    ('S2 money times percent', \"        if money + pct > 1 or any(u not in UNITS for u in units):\", \"        if any(u not in UNITS for u in units):\"),\n    18\t    ('S2 zero divisor', \"            if denominator[0] <= 0 <= denominator[1]:\", \"            if False:\"),\n    19\t    ('S2 share range', \"        if op == 'share' and not (0 <= got[ins[1]][0] and got[ins[1]][1] <= 100):\", \"        if False:\"),\n    20\t    ('S2 one value per figure', \"    distinct = list(dict.fromkeys(inputs))\\n    choices = [sorted({intervals[i][0], intervals[i][1]}) for i in distinct]\\n\"\n    21\t     \"    results = []\\n    for combo in itertools.product(*choices):\\n        value = dict(zip(distinct, combo))\\n        results.append(_apply(op, [value[i] for i in inputs]))\\n\",\n    22\t     \"    choices = [sorted({intervals[i][0], intervals[i][1]}) for i in inputs]\\n    results = []\\n    for combo in itertools.product(*choices):\\n\"\n    23\t     \"        results.append(_apply(op, list(combo)))\\n\"),\n    24\t    ('S3 part above whole', \"            if bad:\\n                errors.append(('S3'\", \"            if False:\\n                errors.append(('S3'\"),\n    25\t    ('S4 two forecasts', \"        if len(ids) > 1:\\n            errors.append(('S4'\", \"        if False:\\n            errors.append(('S4'\"),\n    26\t    ('S4 bypass', \"            if bypass:\\n\", \"            if False:\\n\"),\n    27\t    ('S5 estimate under reference', \"            if any(figs[g]['kind'] == 'estimate' for g in chain):\", \"            if False:\"),\n    28\t    ('S5 forecast under reference', \"            elif any(figs[g]['basis'] == 'forecast' for g in chain):\", \"            elif False:\"),\n    29\t    ('S5 outside source', \"            elif not any(figs[g]['kind'] == 'source' and figs[g]['basis'] in EXTERNAL for g in chain):\", \"            elif False:\"),\n    30\t    ('S5 one choice', \"            else:\\n                errors.append(('S5', f'{v}: needs exactly one\", \"            elif False:\\n                errors.append(('S5', f'{v}: needs exactly one\"),\n    31\t    ('S6 rung holds outcome', \"        if interval is not None and not _overlaps(\", \"        if False and not _overlaps(\"),\n    32\t    ('S6 own forecast', \"        if out['kind'] not in ('computed', 'estimate') or out['basis'] != 'forecast':\", \"        if False:\"),\n    33\t    ('S6 one outcome marker', \"                errors.append(('S6', f'{v}: {len(outs)} figures are marked\", \"                (lambda *args: None)(('S6', f'{v}: {len(outs)} figures are marked\"),\n    34\t    ('S6 outcome key', \"        if _key(out['what']) != _key(member['what']):\", \"        if False:\"),\n    35\t    ('S7 cycle', \"    if any(cyclic(fid) for fid in figs):\", \"    if False:\"),\n    36\t    ('S7 value or range', \"            errors.append(('S7', f'{fid}: a figure has value, or low and high\", \"            (lambda *args: None)(('S7', f'{fid}: a figure has value, or low and high\"),\n    37\t    ('S7 source basis', \"            if f['basis'] == 'forecast':\\n                errors.append(('S7', f'{fid}: a source cannot\", \"            if False:\\n                errors.append(('S7', f'{fid}: a source cannot\"),\n    38\t    ('S7 unresolved shape', \"            if outs or refs or reason or a.get('rung') is not None or not a.get('why'):\", \"            if False:\"),\n    39\t    ('S8 part into whole', \"            if {ps['part'], ps['whole']} <= in_scopes:\", \"            if False:\"),\n    40\t    ('S8 periods', \"        if not ok:\\n            sign =\", \"        if False:\\n            sign =\"),\n    41\t    ('S8 period spelling', \"            errors.append(('S8', f'{fid}: when periods of one quantity\", \"            (lambda *args: None)(('S8', f'{fid}: when periods of one quantity\"),\n    42\t    ('recorded conversion', \"            if any(_quantity(i['what']) != _quantity(f['what']) for i in money) and f['operation'] != 'share':\", \"            if False:\"),\n    43\t]\n    44\t\n    45\t\n    46\tdef run(folder):\n    47\t    env = dict(os.environ, PYTHONDONTWRITEBYTECODE='1', PYTHONPATH=str(REPO / 'src'), CALC_SMALL_DIR=str(folder))\n    48\t    r = subprocess.run([sys.executable, '-B', str(HERE / 'small_cases.py')], capture_output=True, text=True, env=env)\n    49\t    out = r.stdout + r.stderr\n    50\t    if 'calc_small' in out and str(folder) not in subprocess.run([sys.executable, '-B', '-c', 'import calc_small, sys; print(calc_small.__file__)'],\n    51\t                                                                  capture_output=True, text=True, env=dict(env, PYTHONPATH=f'{folder}:{REPO / \"src\"}')).stdout:\n    52\t        raise SystemExit('the scratch calc_small.py was not the one imported')\n    53\t    return r.returncode, out\n    54\t\n    55\t\n    56\tdef main(scratch):\n    57\t    scratch = Path(scratch)\n    58\t    if scratch.exists():\n    59\t        raise SystemExit(f'{scratch} exists')\n    60\t    source = (HERE / 'calc_small.py').read_text()\n    61\t    results = []\n    62\t    for name, old, new in [('control', None, None)] + M:\n    63\t        folder = scratch / name.replace(' ', '-')\n    64\t        folder.mkdir(parents=True)\n    65\t        shutil.copy(HERE / 'calc_small.py', folder / 'calc_small.py')\n    66\t        if old is not None:\n    67\t            if source.count(old) != 1:\n    68\t                raise SystemExit(f'mutant {name}: the site occurs {source.count(old)} times')\n    69\t            (folder / 'calc_small.py').write_text(source.replace(old, new))\n    70\t        code, out = run(folder)\n    71\t        (folder / 'output.txt').write_text(out)\n    72\t        crashed = 'Traceback' in out\n    73\t        caught = code != 0 and not crashed                 # a crash is not a catch until its traceback is read (AGENTS §4)\n    74\t        ok = (not caught) if old is None else caught\n    75\t        first = next((l for l in out.splitlines() if l.startswith('FAIL') or 'Traceback' in l), '')\n    76\t        results.append(ok)\n    77\t        print(f'{\"PASS\" if ok else \"FAIL\"}  {name}: ' + ('control passes' if old is None and ok else\n    78\t              ('caught: ' + first[:160] if caught else ('CRASHED (read output.txt)' if crashed else 'NOT CAUGHT'))))\n    79\t    print(f'{sum(results)} of {len(results)} as expected (control + {len(M)} mutants)')\n    80\t    return 0 if all(results) else 1\n    81\t\n    82\t\n    83\tif __name__ == '__main__':\n    84\t    raise SystemExit(main(sys.argv[1]))\n","exit_code":0,"status":"completed"}}
