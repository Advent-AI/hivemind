 constructed year estimate'\\\\'',inputs=None,operation=None,rests_on=['\\\\''H1'\\\\''])\n elif label.startswith('\\\\''all equal'\\\\''):\n  f=comp('\\\\''H1'\\\\'',wp('\\\\''Q2'\\\\''),'\\\\''difference'\\\\'',['\\\\''Q2'\\\\'','\\\\''Q2'\\\\''],0)\n else:\n  f=comp('\\\\''H1'\\\\'',W('\\\\''company'\\\\'',per),'\\\\''sum'\\\\'',['\\\\''Q1'\\\\'','\\\\''Q2'\\\\''],177.82)\n check('\\\\''S8 '\\\\''+label,it,[*x,f],ans)\n# Registered S3: a complete pair of active arguments with one unrelated candidate.\n# Company Q3 113.6, part Q3 120, rest gives a plausible annual part.\nleft=copy.deepcopy(base)\nright=copy.deepcopy(dcfs)\npos('\\\\''D3'\\\\'',right).update(kind='\\\\''estimate'\\\\'',basis='\\\\''guidance'\\\\'',value=120,inputs=None,operation=None,basis_text='\\\\''Use the outside segment estimate'\\\\'')\npos('\\\\''DF'\\\\'',right).update(value=388.035)\nb=check('\\\\''S3 separate active part 120'\\\\'',dc,right,da)\nmergecheck('\\\\''S3 active part >113.6 after merge control'\\\\'',v1,b)\nright.append(est('\\\\''UNA'\\\\'',dp('\\\\''Q3'\\\\''),105,basis='\\\\''third_party'\\\\''))\nb=check('\\\\''S3 separate with unused alternative 105'\\\\'',dc,right,da)\nmergecheck('\\\\''S3 skipped with two possible part figures despite one active'\\\\'',v1,b)\n'\"","aggregated_output":"line 4 converted control schema=[] decode= [] check= [] publication= publish values= {'v4': [403.61999999999995, 403.61999999999995, None]}\nline 4 separate v4 schema=[] decode= [] check= [] publication= publish values= {'v4': [403.61999999999995, 403.61999999999995, None]}\nline 6 separate v8 schema=[] decode= [] check= [] publication= publish values= {'v8': [373.11499999999995, 373.11499999999995, None]}\nseparate control after merge [('v4.Q3', 'v8.Q3'), ('v4.Q4', 'v8.Q4')] check= [] decision= publish values= {'v4': [403.61999999999995, 403.61999999999995, None], 'v8': [373.11499999999995, 373.11499999999995, None]}\nv4 revised growth forecast schema=[] decode= [] check= [] publication= publish values= {'v4': [403.61999999999995, 403.61999999999995, None]}\nv8 revised growth forecast schema=[] decode= [] check= [] publication= publish values= {'v8': [373.11499999999995, 373.11499999999995, None]}\nequal corroborating nonshared growth forecasts after merge [('v4.Q3', 'v8.Q3'), ('v4.Q4', 'v8.Q4')] check= [('S4', 'NVIDIA | year-over-year growth | company | FY2027 Q4: 2 forecasts (v4.REVIEWED, v8.REVIEWED); compute it once and use that figure')] decision= refused values= {'v4': [403.61999999999995, 403.61999999999995, None], 'v8': [373.11499999999995, 373.11499999999995, None]}\nS2 right reconstruction of 411 from complementary periods schema=[] decode= [] check= [('S2', 'FY: declared 411–411 but sum of YTD, Q4 gives 406.7–415.3')] publication= refused values= {}\nS2 wrong spread on reconstruction schema=[] decode= [] check= [] publication= publish values= {'v4': [406.67999999999995, 415.32000000000005, None]}\nS2 accepts midpoint but publishes impossible spread schema=[] decode= [] check= [] publication= publish values= {'v4': [406.67999999999995, 415.32000000000005, None]}\nS8 same quarter remainder schema=[] decode= [] check= [] publication= publish values= {'v4': [403.61999999999995, 403.61999999999995, None]}\nS8 different quarter remainder schema=[] decode= [] check= [] publication= publish values= {'v4': [403.61999999999995, 403.61999999999995, None]}\nS8 canonical correct H1 schema=[] decode= [] check= [] publication= publish values= {'v4': [403.61999999999995, 403.61999999999995, None]}\nS8 plain English correctly summed schema=[] decode= [] check= [('S8', 'H1: when periods of one quantity are added or subtracted, write each as FY2027, FY2027 Q3, FY2027 H1 or FY2027 Q1-Q3 (or CY likewise); got FY2027 Q1, FY2027 Q2, first half of fiscal 2027')] publication= refused values= {'v4': [403.61999999999995, 403.61999999999995, None]}\nS8 all noncanonical, wrong H1 schema=[] decode= [] check= [] publication= publish values= {'v4': [403.62, 403.62, None]