11-20-production-readiness/dependency-design/blind-reader-brief.md\ndocs/research/2026-11-17-product-comparison/stage0/blinding-check-prompt-3.md\ndocs/research/2026-11-17-product-comparison/stage0/blinding-check-codex-4.md\ndocs/research/2026-11-17-product-comparison/stage0/blinding-check-prompt-2.md\ndocs/research/2026-11-17-product-comparison/stage0/blinding-check-prompt-4.md\ndocs/research/2026-11-17-product-comparison/stage0/blinding-check-codex.md\ndocs/research/2026-11-17-product-comparison/stage0/blinding-check-codex-3.md\ndocs/research/2026-10-28-extraction-quality/blind_arm.py\ndocs/research/2026-10-28-extraction-quality/results/blind-arm-answers.json\ndocs/research/2026-11-14-use-acceptance/splitting/prompt-audit/blind-reader-r4.stream\ndocs/research/2026-11-14-use-acceptance/splitting/prompt-audit/blind-reader-prompt-r5.md\ndocs/research/2026-11-14-use-acceptance/splitting/prompt-audit/blind-reader.md\ndocs/research/2026-11-14-use-acceptance/splitting/prompt-audit/blind-reader-prompt-r4.md\ndocs/research/2026-11-14-use-acceptance/splitting/prompt-audit/blind-reader-r2.md\ndocs/research/2026-11-14-use-acceptance/splitting/prompt-audit/blind-reader-prompt.md\ndocs/research/2026-11-14-use-acceptance/splitting/prompt-audit/blind-reader-r2.stream\ndocs/research/2026-11-14-use-acceptance/splitting/prompt-audit/blind-reader-r3.md\ndocs/research/2026-11-14-use-acceptance/splitting/prompt-audit/blind-reader-r4.md\ndocs/research/2026-11-14-use-acceptance/splitting/prompt-audit/blind-reader-r5.stream\ndocs/research/2026-11-14-use-acceptance/splitting/prompt-audit/blind-reader.stream\ndocs/research/2026-11-14-use-acceptance/splitting/prompt-audit/blind-reader-r5.md\ndocs/research/2026-11-14-use-acceptance/splitting/prompt-audit/blind-reader-r3.stream\ndocs/research/2026-11-14-use-acceptance/splitting/prompt-audit/blind-reader-prompt-r3.md\ndocs/research/2026-11-14-use-acceptance/splitting/prompt-audit/blind-reader-prompt-r2.md\n","exit_code":0,"status":"completed"}}
