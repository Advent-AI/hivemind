{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba calc_check.py | sed -n '25,50p;102,141p;225,257p;435,482p;545,580p'\"","aggregated_output":"    25\t    ('money_plain', re.compile(r'\\$\\s?' + NUM + r'(?![\\d,.]*\\s*(?:trillion|billion|million|bn|tn|T|B|M)\\b)')),\n    26\t    ('multiplier', re.compile(r'\\b(more than\\s+)?(double|triple)\\b', re.I)),\n    27\t    ('percent', re.compile(r'\\b(?:(' + QWORDS + r')\\s+)?' + NUM + r'%', re.I)),\n    28\t]\n    29\tOPERATIONS = {'sum', 'difference', 'product', 'ratio', 'growth', 'apply_growth', 'share', 'range_from_relative', 'roll_forward'}\n    30\tARITY = {'difference': (2, 2), 'ratio': (2, 2), 'growth': (2, 2), 'apply_growth': (2, 2), 'share': (2, 2), 'range_from_relative': (2, 2),\n    31\t         'product': (2, 99), 'sum': (1, 99), 'roll_forward': (2, 99)}          # [46m.1] every operand an operation lists is one it uses\n    32\tKINDS = {'source', 'computed', 'estimate', 'prior'}\n    33\tBASES = {'reported', 'guidance', 'consensus', 'third_party', 'forecast', 'prior_forecast'}\n    34\tEXTERNAL = {'consensus', 'guidance', 'third_party'}\n    35\t\n    36\t\n    37\tdef _num(text):\n    38\t    return float(text.replace(',', ''))\n    39\t\n    40\t\n    41\tdef _scale(unit):\n    42\t    return SCALE[unit.lower()] if unit else 1.0\n    43\t\n    44\t\n    45\tdef extract(text):\n    46\t    \"\"\"Every complete numeric expression in a passage, longest forms first, never overlapping: [{'text', 'form', ...}].\"\"\"\n    47\t    taken, found = [], []\n    48\t    for form, pattern in PATTERNS:\n    49\t        for m in pattern.finditer(text):\n    50\t            if any(m.start() < end and start < m.end() for start, end in taken):\n   102\t    return []\n   103\t\n   104\t\n   105\tdef _interval(fig):\n   106\t    if 'low' in fig and 'high' in fig:\n   107\t        return fig['low'], fig['high']\n   108\t    return fig['value'], fig['value']\n   109\t\n   110\t\n   111\tdef _compute(op, inputs, signs, out_unit=None):\n   112\t    \"\"\"inputs: [(lo, hi, unit)]; returns (lo, hi) in out_unit.\"\"\"\n   113\t    los = [i[0] for i in inputs]\n   114\t    his = [i[1] for i in inputs]\n   115\t    if op in ('sum', 'roll_forward'):\n   116\t        s = signs or [1] * len(inputs)\n   117\t        return (sum((a if k > 0 else b) * k for a, b, k in zip(los, his, s)), sum((b if k > 0 else a) * k for a, b, k in zip(los, his, s)))\n   118\t    if op == 'difference':\n   119\t        return los[0] - his[1], his[0] - los[1]\n   120\t    if op == 'product':\n   121\t        lo = hi = 1.0\n   122\t        for a, b in zip(los, his):\n   123\t            lo, hi = lo * a, hi * b\n   124\t        units = [i[2] for i in inputs]\n   125\t        if 'units' in units and 'USD' in units and out_unit == 'USD bn':     # units times a dollar price, in billions\n   126\t            lo, hi = lo / 1e9, hi / 1e9\n   127\t        return lo, hi\n   128\t    if op == 'ratio':\n   129\t        units = [i[2] for i in inputs]\n   130\t        if 'USD' in units and 'USD bn' in units:                # a dollar total over a per-unit price\n   131\t            los = [x * 1e9 if u == 'USD bn' else x for x, u in zip(los, units)]\n   132\t            his = [x * 1e9 if u == 'USD bn' else x for x, u in zip(his, units)]\n   133\t        return los[0] / his[1], his[0] / los[1]\n   134\t    if op == 'share':\n   135\t        return los[0] * los[1] / 100.0, his[0] * his[1] / 100.0\n   136\t    if op == 'growth':\n   137\t        return (los[1] / his[0] - 1) * 100.0, (his[1] / los[0] - 1) * 100.0\n   138\t    if op == 'apply_growth':\n   139\t        return los[0] * (1 + los[1] / 100.0), his[0] * (1 + his[1] / 100.0)\n   140\t    if op == 'range_from_relative':\n   141\t        return los[0] * (1 - los[1] / 100.0), his[0] * (1 + his[1] / 100.0)\n   225\t        state[fid] = 2\n   226\t        return hit\n   227\t    if any(cyclic(fid) for fid in figs):\n   228\t        errors.append(('C7', 'the figure graph has a cycle'))\n   229\t        return {'errors': errors, 'recorded': recorded}\n   230\t\n   231\t    # C1 sources, prior pointers\n   232\t    for fig in figs.values():\n   233\t        if fig['kind'] == 'source':\n   234\t            errors += _source_errors(fig, passages)\n   235\t        if fig['kind'] == 'prior' and not fig.get('pointer'):\n   236\t            errors.append(('C7', f'{fig[\"id\"]}: a prior forecast needs an exact pointer to an earlier answer shown in the request'))\n   237\t\n   238\t    # C2 arithmetic and bound propagation\n   239\t    for fig in figs.values():\n   240\t        if fig['kind'] != 'computed' or fig.get('operation') not in OPERATIONS:\n   241\t            continue\n   242\t        ins = [figs[i] for i in fig['inputs'] if i in figs]\n   243\t        expected = _compute(fig['operation'], [_interval(i) + (i['unit'],) for i in ins], fig.get('signs'), fig['unit'])\n   244\t        lo, hi = _interval(fig)\n   245\t        if fig['operation'] == 'range_from_relative' or ('low' in fig):\n   246\t            ok = _close(lo, expected[0], fig['unit']) and _close(hi, expected[1], fig['unit'])\n   247\t        else:\n   248\t            ok = _close(lo, (expected[0] + expected[1]) / 2, fig['unit'])\n   249\t        if not ok:\n   250\t            errors.append(('C2', f'{fig[\"id\"]}: declared {lo}–{hi} but {fig[\"operation\"]} of {fig[\"inputs\"]} gives {expected[0]:.2f}–{expected[1]:.2f}'))\n   251\t        want = _bound_direction(fig['operation'], ins)\n   252\t        have = DIRECTION.get(fig.get('bound'))\n   253\t        if want is not None and have != want:\n   254\t            errors.append(('C2', f'{fig[\"id\"]}: its inputs make it a {want} bound, but it is declared {fig.get(\"bound\") or \"a point\"}'))\n   255\t        elif want is None and fig.get('bound'):\n   256\t            errors.append(('C2', f'{fig[\"id\"]}: its inputs are points, but it is declared a bound ({fig[\"bound\"]})'))\n   257\t\n   435\t            upstream = _upstream_of(f['id'], figs, refs)\n   436\t            borrowed = sorted(r for r in upstream if r in stop and figs[r].get('scenario', 'base') != sc)\n   437\t            if borrowed:\n   438\t                errors.append(('C4', f'{want}: {f[\"id\"]} ({sc}) depends on {\", \".join(borrowed)} of another scenario'))\n   439\t        for view_id in touched:                      # [46g.3] a bypass reaches the quantity through no forecast node of any scenario\n   440\t            bypass = [f for f in reachable(outcomes[view_id], stop=stop) if f not in stop and _key(figs[f]['what']) == want]\n   441\t            if bypass:\n   442\t                errors.append(('C4', f'{want}: {view_id} reaches {\", \".join(sorted(bypass))} without passing a forecast node ({\", \".join(sorted(stop))})'))\n   443\t    for rel in family.get('relations', []):           # [46j.2] the later member rests on the earlier member's forecast nodes, per scenario\n   444\t        if rel['type'] != 'same_base' or rel['later'] not in outcomes or rel['earlier'] not in outcomes:\n   445\t            continue\n   446\t        base_key = _key(members[rel['earlier']]['what'])\n   447\t        earlier_graph = _upstream_of(outcomes[rel['earlier']], figs, refs) | {outcomes[rel['earlier']]}\n   448\t        earlier_nodes = {f for f in earlier_graph if _key(figs[f]['what']) == base_key and figs[f]['basis'] == 'forecast'}\n   449\t        reached = reachable(outcomes[rel['later']], stop=earlier_nodes)\n   450\t        bypass = [f for f in reached if f not in earlier_nodes and _key(figs[f]['what']) == base_key]\n   451\t        later_key = _key(members[rel['later']]['what'])\n   452\t        by_scenario = {figs[n].get('scenario', 'base'): n for n in earlier_nodes if figs[n].get('scenario', 'base') != 'range'}\n   453\t        later_graph = _upstream_of(outcomes[rel['later']], figs, refs) | {outcomes[rel['later']]}\n   454\t        for f in sorted(later_graph):                 # [46k.1] every later scenario path reaches the earlier forecast of its own scenario\n   455\t            sc = figs[f].get('scenario', 'base')\n   456\t            if sc == 'range' or _key(figs[f]['what']) != later_key or figs[f]['basis'] != 'forecast':\n   457\t                continue\n   458\t            target = by_scenario.get(sc) or (next(iter(by_scenario.values())) if len(by_scenario) == 1 else None)\n   459\t            if target is None or target not in _determining(f, figs):       # [46l.1] through value-determining inputs only\n   460\t                errors.append(('C9', f'{f} ({sc}) of {rel[\"later\"]} is not computed from {rel[\"earlier\"]}\\'s {sc} forecast'))\n   461\t        later_scen = {figs[f].get('scenario', 'base') for f in later_graph if _key(figs[f]['what']) == later_key\n   462\t                      and figs[f]['basis'] == 'forecast' and figs[f].get('scenario', 'base') != 'range'}\n   463\t        if earlier_nodes and not later_scen:              # [46m.2] a citation never stands in for a calculation\n   464\t            errors.append(('C9', f'{rel[\"later\"]} has no calculation from {rel[\"earlier\"]}\\'s forecast, only a range resting on it'))\n   465\t        if len(by_scenario) > 1 and later_scen != set(by_scenario):     # [46l.1] the later member covers the earlier's scenarios\n   466\t            errors.append(('C9', f'{rel[\"later\"]} covers scenarios {sorted(later_scen)} but {rel[\"earlier\"]} covers {sorted(by_scenario)}'))\n   467\t        if not reached & earlier_nodes:\n   468\t            errors.append(('C9', f'{rel[\"later\"]} does not rest on {rel[\"earlier\"]}\\'s forecast ({\", \".join(sorted(earlier_nodes))})'))\n   469\t        if bypass:\n   470\t            errors.append(('C9', f'{rel[\"later\"]} reaches {\", \".join(sorted(bypass))} for {base_key} without {rel[\"earlier\"]}\\'s forecast'))\n   471\t    supplied = family.get('prior_answers', {})\n   472\t    for fig in figs.values():\n   473\t        earlier = fig['kind'] == 'prior' or fig.get('basis') == 'prior_forecast' or 'pointer' in fig   # [46i.2] derived, not labelled\n   474\t        if not earlier:\n   475\t            continue\n   476\t        if fig['kind'] != 'prior' or fig.get('basis') != 'prior_forecast':\n   477\t            errors.append(('C10', f'{fig[\"id\"]}: an earlier forecast must be kind prior with basis prior_forecast'))\n   478\t        ptr, ans_prior = fig.get('pointer', {}), supplied.get(fig.get('pointer', {}).get('view'), {})\n   479\t        if ans_prior.get('day') != ptr.get('day') or not any(_same(fig.get('value'), v) for v in ans_prior.get('values', [])):\n   480\t            errors.append(('C10', f'{fig[\"id\"]}: no earlier answer of {ptr.get(\"view\")} on {ptr.get(\"day\")} shown in the request states {fig.get(\"value\")}'))\n   481\t        owners = [a['view_id'] for a in calc['answers'] if a.get('outcome') == fig['id']]\n   482\t        if owners:                                    # [46h.2] nor the current outcome\n   545\tdef family_outcome(attempts):\n   546\t    \"\"\"The round's outcome from up to two attempts' decisions: a refusal is retried once; two refusals make the family unresolved.\"\"\"\n   547\t    if attempts[0] != 'refused':\n   548\t        return attempts[0]\n   549\t    if len(attempts) > 1 and attempts[1] != 'refused':\n   550\t        return attempts[1]\n   551\t    return 'unresolved'\n   552\t\n   553\t\n   554\tdef _determining(fid, figs):\n   555\t    \"\"\"The figures that determine fid's value: computed inputs only, at any depth (an estimate's rests_on explains, it does not compute).\"\"\"\n   556\t    seen_ids, stack = set(), list(figs[fid].get('inputs', [])) if figs[fid]['kind'] == 'computed' else []\n   557\t    while stack:\n   558\t        f = stack.pop()\n   559\t        if f in seen_ids or f not in figs:\n   560\t            continue\n   561\t        seen_ids.add(f)\n   562\t        if figs[f]['kind'] == 'computed':\n   563\t            stack.extend(figs[f].get('inputs', []))\n   564\t    return seen_ids\n   565\t\n   566\t\n   567\tdef _upstream_of(fid, figs, refs):\n   568\t    \"\"\"The figures that fid's own value is computed from (fid excluded).\"\"\"\n   569\t    seen_ids, stack = set(), list(refs(figs[fid]))\n   570\t    while stack:\n   571\t        f = stack.pop()\n   572\t        if f in seen_ids or f not in figs:\n   573\t            continue\n   574\t        seen_ids.add(f)\n   575\t        stack.extend(refs(figs[f]))\n   576\t    return seen_ids\n   577\t\n   578\t\n   579\tdef _reference_errors(view_id, ref, figs, passages, refs):\n   580\t    if ref is None:\n","exit_code":0,"status":"completed"}}
