{"type":"item.started","item":{"id":"item_8","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"python3 -B -c '\nimport pathlib,json,io,contextlib,copy,types\nimport gate as g, calc_check as c, render_v13 as r, mutants\ndef replay(func, log):\n    p=io.StringIO()\n    with contextlib.redirect_stdout(p): status=func()\n    assert status==0 and p.getvalue()==pathlib.Path(log).read_text()\nreplay(g.main,'\\\\''gate-run10.txt'\\\\'')\nassert g.MANIFEST==json.loads(pathlib.Path('\\\\''gate-run10.fixtures.json'\\\\'').read_text())\nreplay(r.main,'\\\\''render-r1.txt'\\\\'')\noriginal=g.cc\npath=pathlib.Path('\\\\''calc_check.py'\\\\'')\nsrc=path.read_text()\nfor name,old,new,target in mutants.MUTANTS:\n    g.cc=original\n    if old:\n        assert src.count(old)==1,name\n        mod=types.ModuleType('\\\\''in_memory_calc_check'\\\\'')\n        exec(compile(src.replace(old,new),str(path),'\\\\''exec'\\\\''),mod.__dict__)\n        g.cc=mod\n    misses={name for name,ok,_,_ in g.run() if not ok}\n    assert (target in misses if target else not misses),(name,misses)\ng.cc=original\nprint('\\\\''54 gate items, 24 mutants, and the stored render reproduced'\\\\'')\ndef fig(calc,fid):\n    return next(f for f in calc['\\\\''figures'\\\\''] if f['\\\\''id'\\\\'']==fid)\ndef check(name,fam,x):\n    sch=r.v13_schema(list(fam['\\\\''members'\\\\'']),list(g.G_PASSAGES),[])\n    strict=r.strict(x,sch)\n    err=r.model.check_schema(strict,sch)\n    try:\n        finding=c.check(fam,g.G_PASSAGES,r.without_nulls(strict))['\\\\''errors'\\\\'']\n    except IndexError:\n        import traceback\n        finding=traceback.format_exc()\n    print(name,err,finding)\nfor label in ('\\\\''G24c3'\\\\'','\\\\''G4c'\\\\'','\\\\''G24'\\\\'','\\\\''G4'\\\\''):\n    v=g.MANIFEST[label]\n    check(label,v['\\\\''family'\\\\''],v['\\\\''calc'\\\\''])\nv=copy.deepcopy(g.MANIFEST['\\\\''G24'\\\\''])\nx=v['\\\\''calc'\\\\'']\nhi=fig(x,'\\\\''g28hi'\\\\'')\nbase_math=copy.deepcopy(hi)\nbase_math['\\\\''id'\\\\'']='\\\\''base_math'\\\\''\nx['\\\\''figures'\\\\''].append(base_math)\nhi.update(operation='\\\\''sum'\\\\'',inputs=['\\\\''gc554'\\\\'','\\\\''base_math'\\\\''],signs=[1],value=554.0)\ncheck('\\\\''G24 with same-period sum and a missing sign for the earlier-base calculation'\\\\'',v['\\\\''family'\\\\''],x)\nhi['\\\\''signs'\\\\'']=[1,0]\ncheck('\\\\''G24 with same-period sum and zero weight on the earlier-base calculation'\\\\'',v['\\\\''family'\\\\''],x)\nv=copy.deepcopy(g.MANIFEST['\\\\''G24'\\\\''])\nfig(v['\\\\''calc'\\\\''],'\\\\''g28hi'\\\\'')['\\\\''inputs'\\\\'']=['\\\\''gfyhi'\\\\'']\ncheck('\\\\''G24 with a one-operand growth calculation'\\\\'',v['\\\\''family'\\\\''],v['\\\\''calc'\\\\''])\n'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
