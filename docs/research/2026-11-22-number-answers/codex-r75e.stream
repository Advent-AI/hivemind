{"type":"item.completed","item":{"id":"item_21","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"sed -n '1,44p' src/hivemind/{service,bundle}.py; sed -n '52,75p;216,236p' src/hivemind/views/store.py; head -58 src/hivemind/live_lock.py\"","aggregated_output":"\"\"\"Read-only answers over the views ledger, as of a calendar day (docs/poc/service.md).\n\nNothing here reads the clock (D12, D13): every function takes `as_of`, a day, and the default is the ledger's last\ncompleted day. A row is visible as of a day when the sequence number it was written under belongs to an item or a\ndaily round dated on or before that day. Nothing here writes.\n\"\"\"\nimport json\nimport re\nimport sqlite3\nfrom decimal import Decimal\n\nfrom . import vocabulary\nfrom .views import store\n\nTIER_FACT = vocabulary.TIERS[0]          # 'fact'; a legacy ledger's '发生的事' compares equal through vocabulary.canonical\nCOMPARATORS = ('>=', '<', '=')\n\n\ndef open_ledger(path):\n    \"\"\"A read-only connection to a views database.\"\"\"\n    return store.open_read_only(path)\n\n\ndef default_as_of(conn):\n    \"\"\"Today's default day: the last completed day, or a legacy ledger's last judgement day. Read only through `resolve_bound`.\"\"\"\n    return store.last_completed_day(conn) or conn.execute('select max(publication_day) from judgements').fetchone()[0]\n\n\nclass FirstDayNotCompleted(ValueError):\n    \"\"\"The store holds processing steps and no completed day: its first day is still in progress, and nothing is served from it\n    (live-service/OPERATING-CONTRACT.md, row 4; open defect 10).\"\"\"\n\n    def __init__(self):\n        super().__init__(\"the store's first day has not completed\")\n\n\nclass BoundNotCompleted(ValueError):\n    \"\"\"An explicit upper bound later than the store's last completed day: refused, naming that day (OPERATING-CONTRACT.md, row 3).\"\"\"\n\n    def __init__(self, requested, last_completed_day):\n        self.requested, self.last_completed_day = requested, last_completed_day\n        super().__init__(f'day not completed: {requested} is after the last completed day {last_completed_day}')\n\n\n    'create index if not exists switches_view on view_switches(view_id, id)',\n    'create index if not exists deps_view on dependencies(view_id)',\n]\n\n\ndef open_db(path):\n    os.makedirs(os.path.dirname(os.path.abspath(path)), exist_ok=True)\n    conn = sqlite3.connect(path)\n    conn.row_factory = sqlite3.Row\n    for name, columns in TABLES.items():\n        conn.execute(f'create table if not exists {name} ({columns})')\n        conn.execute(f\"create trigger if not exists {name}_no_update before update on {name} begin select raise(abort, 'append-only'); end\")\n        conn.execute(f\"create trigger if not exists {name}_no_delete before delete on {name} begin select raise(abort, 'append-only'); end\")\n    for statement in INDEXES:\n        conn.execute(statement)\n    ensure_writable_columns(conn)\n    conn.execute(\"create virtual table if not exists views_fts using fts5(view_id unindexed, text, tokenize='trigram')\")\n    conn.execute(\"create virtual table if not exists groups_fts using fts5(group_id unindexed, text, tokenize='trigram')\")\n    conn.execute('create index if not exists members_view on thesis_group_members(view_id)')\n    conn.commit()\n    return conn\n\n\ndef insert(conn, table, **fields):\ndef has_judgement(conn, view_id, seq):\n    return conn.execute('select 1 from judgements where view_id=? and seq=?', (view_id, seq)).fetchone() is not None\n\n\nREAD_BUSY_TIMEOUT_SECONDS = 5.0     # a reader's busy timeout: SQLite's busy handler retries SQLITE_BUSY within it (live-service row 1)\n\n\ndef open_read_only(path):\n    \"\"\"The views database for a reader (the agent layer, reports): no schema creation, no writes. Opened by its own path: a symlink\n    resolved, a store with another hard link refused (`live_lock.LockRefused`; live-service/OPERATING-CONTRACT.md, row 7), since\n    SQLite finds a WAL store's side files by the opened path.\"\"\"\n    from hivemind import live_lock\n    real, _ = live_lock.own_path(path)\n    conn = sqlite3.connect(f'file:{real}?mode=ro', uri=True, timeout=READ_BUSY_TIMEOUT_SECONDS)\n    conn.row_factory = sqlite3.Row\n    return conn\n\n\ndef current_state(conn, view_id):\n    \"\"\"The latest judgement: rung, reasons, changed, seq and day, and its reference and implied outcome (D260) where the ledger has them.\"\"\"\n    columns = {r[1] for r in conn.execute('pragma table_info(judgements)')}\n\"\"\"Who writes a store, and how it is copied (docs/research/2026-11-14-use-acceptance/live-service/OPERATING-CONTRACT.md, row 7 and \"Who\nwrites, and copies: slice 4b\").\n\nThe writer and preflight take one operating-system lock (`flock`) named by the store file's device and inode, in one folder; the\noperating system releases it when its process ends, a crash included. A store is opened only by its own path (a symlink is resolved;\na store with another hard link is refused, since SQLite finds a WAL store's side files by the opened path). The holder checks that the\npath still names the locked file on both sides of an open and at each later check point; a path swapped away and back around an open\nis not detected (the contract's operating precondition excludes it).\n\n`snapshot` is AGENTS §9's route to read a store being written: SQLite's backup API, taken out of WAL mode, integrity checked, and\npublished without replacing anything.\n\"\"\"\nimport fcntl\nimport os\nimport sqlite3\nimport tempfile\n\nLOCK_FOLDER = os.path.expanduser('~/.hivemind-locks')\n\n\nclass LockRefused(RuntimeError):\n    \"\"\"The store is being written (its lock is held), its lock folder cannot be used, or its path is not its own.\"\"\"\n\n\nclass PathChanged(RuntimeError):\n    \"\"\"The store's path, or its lock file's path, no longer names the file that was locked.\"\"\"\n\n\ndef lock_folder():\n    \"\"\"The one lock folder, owner-only; refused (never skipped) when it cannot be created or written.\"\"\"\n    try:\n        os.makedirs(LOCK_FOLDER, mode=0o700, exist_ok=True)\n    except OSError as error:\n        raise LockRefused(f'the lock folder {LOCK_FOLDER} cannot be created: {error}') from error\n    if not os.access(LOCK_FOLDER, os.W_OK | os.X_OK):\n        raise LockRefused(f'the lock folder {LOCK_FOLDER} cannot be written')\n    return LOCK_FOLDER\n\n\ndef own_path(store_path):\n    \"\"\"(the store's real path, (device, inode)); a store with another hard link is refused.\"\"\"\n    real = os.path.realpath(store_path)\n    status = os.stat(real)\n    if status.st_nlink > 1:\n        raise LockRefused(f'{real} has {status.st_nlink} hard links: a store is opened only by its own path')\n    return real, (status.st_dev, status.st_ino)\n\n\nclass Held:\n    \"\"\"A held lock: the store's real path and identity, the lock file's path, descriptor and inode.\"\"\"\n\n    def __init__(self, real_path, identity, lock_path, descriptor):\n        self.real_path, self.identity, self.lock_path, self.descriptor = real_path, identity, lock_path, descriptor\n        self.lock_inode = os.fstat(descriptor).st_ino\n\n\ndef acquire(store_path):\n    \"\"\"The store's lock, without waiting: refused when another process holds it.\"\"\"\n","exit_code":0,"status":"completed"}}
