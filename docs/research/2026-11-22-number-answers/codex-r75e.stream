{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc 'nl -ba docs/research/2026-11-22-number-answers/release_check.py'","aggregated_output":"     1\t\"\"\"The $0 release check of RELEASE-BUILD.md §7 on four stored stores, read-only (a closing switch is added only to a copy).\n     2\t\n     3\t    python3 docs/research/2026-11-22-number-answers/release_check.py <new output folder>\n     4\t\n     5\tBuilds each store's package with the real command, then: the decisive acceptance case on old-1; old-1/v8; the two known Yes/No leaks\n     6\tat their own days; an unchanged event control; a closing switch on a copy; the diagnostic search of every forbidden stored string in\n     7\tevery decoded package field; the size and speed budgets against `bundle.library` on the same store. Writes results.json there.\"\"\"\n     8\timport hashlib\n     9\timport json\n    10\timport shutil\n    11\timport sqlite3\n    12\timport subprocess\n    13\timport sys\n    14\timport time\n    15\tfrom pathlib import Path\n    16\t\n    17\tREPO = Path(__file__).resolve().parents[3]\n    18\tsys.path.insert(0, str(REPO / 'src'))\n    19\tfrom hivemind import bundle, release, service  # noqa: E402\n    20\tfrom hivemind.views import store  # noqa: E402\n    21\t\n    22\tCOMMAND = REPO / 'scripts' / 'release_build.py'\n    23\tCOMPARISON_ITEMS = REPO / 'poc/data/comparison-2026-11-17/items-comparison.sqlite'\n    24\tSTORES = {\n    25\t    'old-1': (REPO / 'poc/data/comparison-2026-11-17/run/old-1/prod/views.sqlite', COMPARISON_ITEMS),\n    26\t    'old-2': (REPO / 'poc/data/comparison-2026-11-17/run/old-2/prod/views.sqlite', COMPARISON_ITEMS),\n    27\t    'old-3': (REPO / 'poc/data/comparison-2026-11-17/run/old-3/prod/views.sqlite', COMPARISON_ITEMS),\n    28\t    'served': (REPO / 'poc/data/served-2026-10-28-v34-nvda-3m-through-0828/views.sqlite', REPO / 'poc/data/items-nvda-2026-07-01-10-27.sqlite'),\n    29\t}\n    30\t\n    31\t\n    32\tdef build(ledger, items, out, as_of=None):\n    33\t    args = [sys.executable, str(COMMAND), 'build', '--ledger', str(ledger), '--items', str(items), '--out', str(out)] + (['--as-of', as_of] if as_of else [])\n    34\t    result = subprocess.run(args, capture_output=True, text=True, env={'PATH': '/usr/bin:/bin', 'PYTHONDONTWRITEBYTECODE': '1'})\n    35\t    if result.returncode != 0:\n    36\t        raise SystemExit(f'build {out} exited {result.returncode}: {result.stderr}')\n    37\t    return json.loads(out.with_name(out.name + '.report.json').read_text()), release.read_data(out)\n    38\t\n    39\t\n    40\tdef check(ledger, items, package):\n    41\t    views_db, items_db = service.open_ledger(str(ledger)), store.open_read_only(str(items))\n    42\t    try:\n    43\t        return release.check_package(package, views_db, items_db)[0]\n    44\t    finally:\n    45\t        views_db.close()\n    46\t        items_db.close()\n    47\t\n    48\t\n    49\tdef fields(data, manifest=None):\n    50\t    \"\"\"(question id, field path, evidence id, text) for every decoded string of the package: every string value of the data at\n    51\t    every level (ids, classes and the marker included) and of the manifest.\"\"\"\n    52\t    def walk(value, path, question_id, evidence_id):\n    53\t        if isinstance(value, dict):\n    54\t            question_id = value['id'] if 'class' in value else question_id\n    55\t            evidence_id = value['id'] if 'one_line' in value else evidence_id\n    56\t            for key, item in value.items():\n    57\t                yield from walk(item, f'{path}.{key}' if path else key, question_id, evidence_id)\n    58\t        elif isinstance(value, list):\n    59\t            for n, item in enumerate(value):\n    60\t                yield from walk(item, f'{path}[{n}]', question_id, evidence_id)\n    61\t        elif isinstance(value, str):\n    62\t            yield question_id, path, evidence_id, value\n    63\t    yield from walk(data, '', None, None)\n    64\t    if manifest is not None:\n    65\t        yield from walk(manifest, 'manifest', None, None)\n    66\t\n    67\t\n    68\tdef forbidden(ledger, data):\n    69\t    \"\"\"Every stored string the package must not hold, by question and kind; judgement columns read only where the store has them.\"\"\"\n    70\t    conn = service.open_ledger(str(ledger))\n    71\t    try:\n    72\t        columns = {row[1] for row in conn.execute('pragma table_info(judgements)')}\n    73\t        texts = [c for c in ('reasons', 'why_changed', 'implied_outcome', 'reference') if c in columns]\n    74\t        out = []\n    75\t        for question in data['questions']:\n    76\t            view_id = question['id']\n    77\t            for row in conn.execute('select label, condition from rungs where view_id=?', (view_id,)):\n    78\t                if question['class'] == 'number':                # an event's or Yes/No question's labels are its shown answers\n    79\t                    out.append((view_id, 'rung label', row['label']))\n    80\t                out.append((view_id, 'rung condition', row['condition']))\n    81\t            for row in conn.execute(f'select {\", \".join(texts)} from judgements where view_id=?', (view_id,)):\n    82\t                out += [(view_id, name, row[name]) for name in texts]\n    83\t            out += [(view_id, 'switch reason', row['reason']) for row in conn.execute('select reason from view_switches where view_id=?', (view_id,))]\n    84\t        return [entry for entry in out if entry[2]], [c for c in ('implied_outcome', 'reference') if c not in columns]\n    85\t    finally:\n    86\t        conn.close()\n    87\t\n    88\t\n    89\tdef diagnostics(ledger, data, package):\n    90\t    stored, absent = forbidden(ledger, data)\n    91\t    located = list(fields(data, json.loads((package / release.MANIFEST_FILE).read_text())))\n    92\t    joined = '\\x00'.join(text for *_, text in located)\n    93\t    hits = []\n    94\t    for view_id, kind, text in set(stored):\n    95\t        if text in joined:\n    96\t            for question_id, path, evidence_id, field in located:\n    97\t                if text in field:\n    98\t                    hits.append({'stored_in': view_id, 'kind': kind, 'text': text[:200], 'found_in': question_id, 'field': path, 'evidence': evidence_id})\n    99\t    return {'stored_strings_judged': len(set(stored)), 'package_strings': len(located), 'judgement_columns_absent': absent, 'hits': hits}\n   100\t\n   101\t\n   102\tdef library_baseline(ledger, items):\n   103\t    views_db, items_db = service.open_ledger(str(ledger)), store.open_read_only(str(items))\n   104\t    try:\n   105\t        started = time.monotonic()\n   106\t        payload = bundle.library(views_db, items_db)\n   107\t        return len(json.dumps(payload, ensure_ascii=False).encode()), time.monotonic() - started\n   108\t    finally:\n   109\t        views_db.close()\n   110\t        items_db.close()\n   111\t\n   112\t\n   113\tdef by_id(data):\n   114\t    return {q['id']: q for q in data['questions']}\n   115\t\n   116\t\n   117\tdef refresh(package, data=None, manifest_extra=None):\n   118\t    if data is not None:\n   119\t        payload = json.dumps(data, ensure_ascii=False, separators=(',', ':')).encode()\n   120\t        (package / release.DATA_FILE).write_bytes(payload)\n   121\t    manifest = json.loads((package / release.MANIFEST_FILE).read_text())\n   122\t    manifest['data_sha256'] = hashlib.sha256((package / release.DATA_FILE).read_bytes()).hexdigest()\n   123\t    manifest.update(manifest_extra or {})\n   124\t    (package / release.MANIFEST_FILE).write_text(json.dumps(manifest))\n   125\t\n   126\t\n   127\tdef refused(ledger, items, package):\n   128\t    try:\n   129\t        check(ledger, items, package)\n   130\t    except release.ReleaseRefused as error:\n   131\t        return str(error)\n   132\t    return None\n   133\t\n   134\t\n   135\tdef main(out):\n   136\t    out = Path(out).absolute()\n   137\t    out.mkdir()                                            # a new folder; refuses an existing one\n   138\t    results = {'stores': {}}\n   139\t    packages = {}\n   140\t    for name, (ledger, items) in STORES.items():\n   141\t        (out / name).mkdir()\n   142\t        report, data = build(ledger, items, out / name / 'package')\n   143\t        packages[name] = data\n   144\t        library_bytes, library_seconds = library_baseline(ledger, items)\n   145\t        seconds = report['export_seconds'] + report['check_seconds']\n   146\t        results['stores'][name] = {\n   147\t            'as_of': report['as_of'], 'counts': report['counts'], 'withheld_unresolved': len(report['withheld_unresolved']),\n   148\t            'unresolved': report['withheld_unresolved'], 'data_bytes': report['data_bytes'], 'library_bytes': library_bytes,\n   149\t            'seconds': round(seconds, 2), 'library_seconds': round(library_seconds, 2),\n   150\t            'bytes_within_budget': report['data_bytes'] <= library_bytes,\n   151\t            'seconds_within_budget': seconds <= 3 * library_seconds and seconds <= 120,\n   152\t            'diagnostics': diagnostics(ledger, data, out / name / 'package')}\n   153\t        print(name, json.dumps({k: v for k, v in results['stores'][name].items() if k not in ('unresolved', 'diagnostics')}), 'hits', len(results['stores'][name]['diagnostics']['hits']))\n   154\t\n   155\t    ledger, items = STORES['old-1']\n   156\t    data, package = packages['old-1'], out / 'old-1' / 'package'\n   157\t    conn = service.open_ledger(str(ledger))\n   158\t    stored = {row['evidence_id']: row for row in conn.execute(\"select * from evidence where evidence_id in ('e2295','e1865','e3597')\")}\n   159\t    implied = conn.execute('select implied_outcome from judgements where judgement_id=1580').fetchone()[0]\n   160\t    in_force_v8 = [e['evidence_id'] for e in service.evidence(conn, 'v8', data['as_of'])]\n   161\t    conn.close()\n   162\t    required_text = {   # each example's full stored text, written down before the run (old-1, 2026-11-23); compared exactly\n   163\t        'e2295': ('Morningstar cites NVIDIA Data Center revenue of $3 billion in FY2020 and $194 billion in FY2026, and estimates $361 billion in FY2027, up 86% year over year.',\n   164\t                  'Nvidia’s DC business has achieved exponential growth already, rising from $3 billion in fiscal 2020 to $194 billion in fiscal 2026, and we estimate it will be $361 billion in fiscal 2027, representing 86% annual growth.'),\n   165\t        'e1865': ('The author identifies firm SpaceX procurement commitments and NVIDIA Data Center growth above 60% into FY2028 as bullish confirmation conditions.',\n   166\t                  'Bullish confirmation would require firm procurement commitments for the SpaceX buildout and continued NVIDIA Data Center growth above 60% into fiscal 2028.'),\n   167\t        'e3597': ('The author says analysts estimate NVIDIA revenue of about $390 billion in calendar 2027 and over $550 billion in calendar 2028, with annual sales growth of roughly 24% to 25%.',\n   168\t                  'Analysts see revenue reaching about $390 billion in 2027 and more than $550 billion in 2028, with annual sales growth of roughly 24% to 25%.')}\n   169\t    kept = {}\n   170\t    for evidence_id in ('e2295', 'e1865', 'e3597'):              # the fixed examples: a missing one is a failure, not a smaller list\n   171\t        if evidence_id not in stored:\n   172\t            kept[evidence_id] = {'questions': [], 'equal_to_store': False, 'present': False}\n   173\t            continue\n   174\t        holders = [(q['id'], e) for q in data['questions'] for e in q['evidence'] if e['id'] == evidence_id]\n   175\t        kept[evidence_id] = {'questions': [h[0] for h in holders],\n   176\t                             'equal_to_store': all(e['one_line'] == stored[evidence_id]['one_line'] and e['quote'] == stored[evidence_id]['quote'] for _, e in holders) and bool(holders),\n   177\t                             'present': bool(holders),\n   178\t                             'holds_its_wording': bool(holders) and all((e['one_line'], e['quote']) == required_text[evidence_id] for _, e in holders)}\n   179\t    forged = out / 'old-1' / 'forged-summary'\n   180\t    shutil.copytree(package, forged)\n   181\t    changed = json.loads(json.dumps(data))\n   182\t    next(e for e in by_id(changed)['v8']['evidence'] if e['id'] == 'e2295')['one_line'] = implied\n   183\t    refresh(forged, changed)\n   184\t    prose = out / 'old-1' / 'forged-manifest'\n   185\t    shutil.copytree(package, prose)\n   186\t    refresh(prose, manifest_extra={'note': implied})\n   187\t    v8 = by_id(data)['v8']\n   188\t    results['decisive'] = {'kept': kept, 'implied_outcome_j1580': implied[:120],\n   189\t                           'substituted_into_e2295_refused': refused(ledger, items, forged),\n   190\t                           'added_to_manifest_refused': refused(ledger, items, prose),\n   191\t                           'unchanged_package_passes': check(ledger, items, package)['fields_compared']}\n   192\t    results['old-1/v8'] = {'class': v8['class'], 'forecast': v8['forecast'], 'evidence': len(v8['evidence']),\n   193\t                           'same_ids_as_service_evidence': [e['id'] for e in v8['evidence']] == in_force_v8}\n   194\t\n   195\t    leaks = {}\n   196\t    for name, view_id, day, judgement_id in (('old-3', 'v36', '2026-08-25', 799), ('old-1', 'v10', '2026-08-28', 865)):\n   197\t        ledger, items = STORES[name]\n   198\t        report, dated = build(ledger, items, out / name / f'package-{day}', day)\n   199\t        conn = service.open_ledger(str(ledger))\n   200\t        row = conn.execute('select judgement_id, rung, why_changed, reasons from judgements where view_id=? and publication_day<=? order by judgement_id desc limit 1', (view_id, day)).fetchone()\n   201\t        label = conn.execute('select label from rungs where view_id=? and position=?', (view_id, row['rung'])).fetchone()[0]\n   202\t        conn.close()\n   203\t        record = by_id(dated)[view_id]\n   204\t        texts = [text for *_, text in fields(dated)]\n   205\t        leaks[f'{name}/{view_id}@{day}'] = {\n   206\t            'latest_judgement': row['judgement_id'], 'expected_judgement': judgement_id, 'label_kept': record['answer'] == label, 'answer': record['answer'],\n   207\t            'why_changed_absent': not any(row['why_changed'] in t for t in texts), 'reasons_absent': not any((row['reasons'] or '\\x01') in t for t in texts),\n   208\t            'phrase_fields': {phrase: [(q, p, e, t[:160]) for q, p, e, t in fields(dated) if phrase in t]\n   209\t                              for phrase in ('around $1 trillion', 'rung 4', 'at rung', 'capex at rung')}}\n   210\t    results['leaks'] = leaks\n   211\t\n   212\t    ledger, items = STORES['old-1']\n   213\t    conn = service.open_ledger(str(ledger))\n   214\t    control = next(q for q in data['questions'] if q['class'] == 'event' and q['id'] not in ('v10',) and q['answer'] is not None)\n   215\t    stored_label = conn.execute('select r.label from judgements j join rungs r on r.view_id=j.view_id and r.position=j.rung where j.view_id=? and j.publication_day<=? order by j.judgement_id desc limit 1', (control['id'], data['as_of'])).fetchone()[0]\n   216\t    control_ids = [e['evidence_id'] for e in service.evidence(conn, control['id'], data['as_of'])]\n   217\t    conn.close()\n   218\t    results['control'] = {'id': control['id'], 'answer': control['answer'], 'label_equals_store': control['answer'] == stored_label,\n   219\t                          'evidence_equals_store': [e['id'] for e in control['evidence']] == control_ids}\n   220\t\n   221\t    closing = out / 'old-1' / 'closing'\n   222\t    closing.mkdir()\n   223\t    copy = closing / 'views.sqlite'\n   224\t    shutil.copyfile(ledger, copy)\n   225\t    conn = sqlite3.connect(copy)\n   226\t    rung = conn.execute(\"select rung from judgements where view_id='v8' order by judgement_id desc limit 1\").fetchone()[0]\n   227\t    rung_label = conn.execute(\"select label from rungs where view_id='v8' and position=?\", (rung,)).fetchone()[0]\n   228\t    reason = f'due {data[\"as_of\"]}, frozen on {data[\"as_of\"]} at rung {rung} {rung_label}'\n   229\t    last_seq = conn.execute('select max(sequence_no) from processing_steps').fetchone()[0]\n   230\t    conn.execute(\"insert into view_switches (view_id, open, reason, by_whom, after_seq) values ('v8', 0, ?, 'pull', ?)\", (reason, last_seq))\n   231\t    conn.commit()\n   232\t    conn.close()\n   233\t    views_db, items_db = service.open_ledger(str(copy)), store.open_read_only(str(items))\n   234\t    exposed = bundle.view_bundle(views_db, bundle.item_lookup(items_db), 'v8')\n   235\t    views_db.close()\n   236\t    items_db.close()\n   237\t    report, closed = build(copy, items, closing / 'package')\n   238\t    texts = [text for *_, text in fields(closed)]\n   239\t    results['closing'] = {'reason': reason, 'bundle_exposes_reason': any(s.get('reason') == reason for s in exposed['switches']),\n   240\t                          'package_open': by_id(closed)['v8']['open'], 'reason_absent': not any(reason in t for t in texts),\n   241\t                          'rung_label_inside_v8_fields': [(p, e, t[:120]) for q, p, e, t in fields(closed) if q == 'v8' and rung_label in t]}\n   242\t    (out / 'results.json').write_text(json.dumps(results, ensure_ascii=False, indent=1))\n   243\t    print(json.dumps({k: v for k, v in results.items() if k != 'stores'}, ensure_ascii=False, indent=1))\n   244\t    failures = [f'{name}: {key}' for name, s in results['stores'].items() for key in ('bytes_within_budget', 'seconds_within_budget') if not s[key]]\n   245\t    decisive = results['decisive']\n   246\t    failures += [f'kept {e}' for e in ('e2295', 'e1865', 'e3597')\n   247\t                 if not (decisive['kept'].get(e, {}).get('present') and decisive['kept'][e]['equal_to_store'] and decisive['kept'][e]['holds_its_wording'])]\n   248\t    expected_reasons = {'substituted_into_e2295_refused': 'question v8.evidence e2295.one_line: differs from the store',\n   249\t                        'added_to_manifest_refused': \"the manifest: keys off the allow-list ['note'], missing []\"}   # exact, so another refusal (a stale hash) does not count\n   250\t    failures += [k for k, reason in expected_reasons.items() if decisive[k] != reason]\n   251\t    failures += [] if results['old-1/v8']['same_ids_as_service_evidence'] and results['old-1/v8']['forecast'] == release.FORECAST_UNAVAILABLE else ['old-1/v8']\n   252\t    for name, leak in results['leaks'].items():\n   253\t        failures += [f'{name}: {k}' for k in ('label_kept', 'why_changed_absent', 'reasons_absent') if not leak[k]]\n   254\t        failures += [] if leak['latest_judgement'] == leak['expected_judgement'] else [f'{name}: judgement']\n   255\t        failures += [f'{name}: {phrase} found' for phrase, hits in leak['phrase_fields'].items() if hits]\n   256\t    failures += [] if results['control']['label_equals_store'] and results['control']['evidence_equals_store'] else ['control']\n   257\t    closing = results['closing']\n   258\t    failures += [] if closing['bundle_exposes_reason'] and closing['package_open'] is False and closing['reason_absent'] else ['closing']\n   259\t    if failures:\n   260\t        raise SystemExit(f'release check FAILED: {failures}')\n   261\t    print('release check: every acceptance item and budget met; diagnostic hits to read by hand:',\n   262\t          {name: len(s['diagnostics']['hits']) for name, s in results['stores'].items()})\n   263\t\n   264\t\n   265\tif __name__ == '__main__':\n   266\t    main(sys.argv[1])\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc 'nl -ba docs/research/2026-11-22-number-answers/release_mutants.py; nl -ba scripts/release_build.py'","aggregated_output":"     1\t\"\"\"RELEASE-BUILD.md §6 mutants: each applied to a scratch copy (PYTHONDONTWRITEBYTECODE, no __pycache__) must fail\n     2\ttests/test_release.py; the unmutated control must pass.\"\"\"\n     3\timport shutil\n     4\timport subprocess\n     5\timport sys\n     6\timport tempfile\n     7\tfrom pathlib import Path\n     8\tfrom xml.etree import ElementTree\n     9\t\n    10\tREPO = Path('/Users/lchingen/hivemind')\n    11\tR, B = 'src/hivemind/release.py', 'scripts/release_build.py'\n    12\tMUTANTS = {\n    13\t    'condition emitted on number records': (R, \"                record['forecast'] = FORECAST_UNAVAILABLE\\n            else:\\n                record['answers'] = labels\\n                record['answer'] = _answer(\",\n    14\t                                            \"                record['forecast'] = FORECAST_UNAVAILABLE\\n                record['condition'] = 'FY2027 revenue is at least $350 billion'\\n            else:\\n                record['answers'] = labels\\n                record['answer'] = _answer(\"),\n    15\t    'one_line from the latest why_changed': (R, \"evidence.append({'id': piece['evidence_id'], **{name: piece[name] for name in EVIDENCE_TEXT}, 'sources': sources})\",\n    16\t                                             \"evidence.append({'id': piece['evidence_id'], **{name: piece[name] for name in EVIDENCE_TEXT}, 'sources': sources, 'one_line': (views_db.execute('select why_changed from judgements where view_id=? order by judgement_id desc limit 1', (view_id,)).fetchone() or {'why_changed': piece['one_line']})['why_changed']})\"),\n    17\t    'event test removed': (R, \"    if key_measure(conn, view_id, as_of) in identity.EVENT_MEASURES:\\n        return 'event'\\n\", ''),\n    18\t    'Yes/No test removed': (R, \"    if len(labels) == 2 and {vocabulary.canonical('label', label) for label in labels} == {'Yes', 'No'}:\\n        return 'yes_no'\\n\", ''),\n    19\t    'check_package without the file-set check': (R, \"        if sorted(names) != sorted(PACKAGE_FILES):\\n            raise\", \"        if False:\\n            raise\"),\n    20\t    'manifest keys unchecked': (R, \"    _keys(manifest, 'manifest', 'the manifest')\\n\", ''),\n    21\t    'check_export without the closed-key check': (R, \"    if set(value) != ALLOWED[kind]:\", \"    if not set(value) >= ALLOWED[kind]:\"),\n    22\t    'check_origins skipping evidence fields': (R, \"            expected_evidence = _expected_evidence(views_db, items_db, view_id, as_of)\\n\",\n    23\t                                               \"            expected_evidence = question['evidence']\\n\"),\n    24\t    'check_origins taking the class from the package': (R, \"            kind = question_class(views_db, view_id, labels, as_of)\\n            record = {'id': view_id, 'question': view['question'], 'open': _open_at(\",\n    25\t                                                        \"            kind = question['class']\\n            record = {'id': view_id, 'question': view['question'], 'open': _open_at(\"),\n    26\t    'check_origins accepting duplicates': (R, \"        packaged = data['questions']\\n\", \"        packaged = list({q['id']: q for q in data['questions']}.values())\\n\"),\n    27\t    'check_origins accepting another order': (R, \"        packaged = data['questions']\\n\",\n    28\t                                              \"        packaged = sorted(data['questions'], key=lambda q: [r['view_id'] for r in views].index(q['id']) if q['id'] in [r['view_id'] for r in views] else -1)\\n\"),\n    29\t    'pipe opened blocking': (R, \"os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=folder)\", \"os.O_RDONLY | os.O_NOFOLLOW, dir_fd=folder)\"),\n    30\t    'store path returned unresolved': (R, \"        raise ReleaseRefused(f'{path}: a store path may not contain {found}, which the SQLite opener reads as URI syntax')\\n    return real\",\n    31\t                                       \"        raise ReleaseRefused(f'{path}: a store path may not contain {found}, which the SQLite opener reads as URI syntax')\\n    return path\"),\n    32\t    'check_origins with an inner join': (R, \"            if item is None:\\n                raise ReleaseRefused(f'evidence {row[\\\"evidence_id\\\"]}\", \"            if item is None:\\n                continue\\n                raise ReleaseRefused(f'evidence {row[\\\"evidence_id\\\"]}\"),\n    33\t    'check without validating the day': (R, \"        bound = expected_as_of if expected_as_of is not None else resolve(views_db, data['as_of'])\",\n    34\t                                         \"        bound = expected_as_of if expected_as_of is not None else data['as_of']\"),\n    35\t    'builder skipping the staged check': (B, \"counts, data, size = release.check_package(staged, views_db, items_db, expected_as_of=bound)\", \"counts, size = release.check_export(data), 0\"),\n    36\t    'symbolic-link check removed': (R, \"os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=folder)\", \"os.open(name, os.O_RDONLY | os.O_NONBLOCK, dir_fd=folder)\"),\n    37\t    'duplicate-key check removed': (R, \"    if len(names) != len(set(names)):\", \"    if False:\"),\n    38\t    'switch reason emitted': (R, \"            record = {'id': view_id, 'question': view['question'], 'open': service.is_open_as_of(views_db, view_id, bound), 'class': kind}\",\n    39\t                              \"            record = {'id': view_id, 'question': view['question'], 'open': service.is_open_as_of(views_db, view_id, bound), 'class': kind, 'reason': (views_db.execute('select reason from view_switches where view_id=? order by id desc', (view_id,)).fetchone() or {'reason': ''})['reason']}\"),\n    40\t    'missing-item refusal replaced by the id fallback': (R, \"        if row is None:\\n            raise ReleaseRefused(f'evidence {evidence_id}: source item {input_id} is not in the items database')\",\n    41\t                                                         \"        if row is None:\\n            row = {'title': input_id, 'publisher': '', 'source_uri': ''}\"),\n    42\t    'publish replaced by os.rename': (R, \"    rename = _no_replace_rename()\\n    if rename is None:\", \"    rename = lambda source, target: os.rename(source, target) or 0\\n    if rename is None:\"),\n    43\t    'the finally removed': (B, \"        if staged is not None:\\n            shutil.rmtree(staged)\\n\", ''),\n    44\t    'staging path not dropped after publish': (B, \"        staged = None                       # published\", \"        pass                                # published\"),\n    45\t    'canonical-day check removed': (R, \"    if day.isoformat() != text:\\n        raise ReleaseRefused\", \"    if False:\\n        raise ReleaseRefused\"),\n    46\t    'key read without its day': (R, \"    return row['measure'] if row is not None and service.visible(conn, row['seq'], as_of) else None\",\n    47\t                                 \"    return row['measure'] if row is not None else None\"),\n    48\t    'null accepted as text': (R, \"        if not isinstance(value[name], str):\", \"        if not (isinstance(value[name], str) or value[name] is None):\"),\n    49\t    'store-path refusal removed': (R, \"    if found:\\n        raise ReleaseRefused(f'{path}: a store path\", \"    if False:\\n        raise ReleaseRefused(f'{path}: a store path\"),\n    50\t    'writer self-check removed': (R, \"    check_export(data)\\n    return data\\n\", \"    return data\\n\"),\n    51\t    \"a number label written into another question's evidence\": (R, \"evidence.append({'id': piece['evidence_id'], **{name: piece[name] for name in EVIDENCE_TEXT}, 'sources': sources})\",\n    52\t        \"evidence.append({'id': piece['evidence_id'], **{name: piece[name] for name in EVIDENCE_TEXT}, 'sources': sources, **({'one_line': 'Bullish'} if view_id == 'v6' else {})})\"),\n    53\t    'report missing a field': (B, \"    summary = {'ledger': str(args.ledger), 'items': str(args.items), 'as_of': data['as_of'],\", \"    summary = {'ledger': str(args.ledger), 'as_of': data['as_of'],\"),\n    54\t    'report not printed': (B, \"    print(json.dumps(report, ensure_ascii=False, indent=1))\\n\", \"\"),\n    55\t    'publish_report replaced by os.replace': (R, \"        os.link(temporary, path)\\n\", \"        os.replace(temporary, path)\\n        open(temporary, 'w').close()\\n\"),\n    56\t}\n    57\t\n    58\t\n    59\tdef tree(where):\n    60\t    root = Path(where)\n    61\t    shutil.copytree(REPO / 'src', root / 'src', ignore=shutil.ignore_patterns('__pycache__'))\n    62\t    shutil.copytree(REPO / 'scripts', root / 'scripts', ignore=shutil.ignore_patterns('__pycache__'))\n    63\t    (root / 'tests').mkdir()\n    64\t    for name in ('test_release.py', 'conftest.py'):\n    65\t        shutil.copy(REPO / 'tests' / name, root / 'tests' / name)\n    66\t    return root\n    67\t\n    68\t\n    69\tdef run(root):\n    70\t    return subprocess.run([sys.executable, '-m', 'pytest', 'tests/test_release.py', '-q', '-p', 'no:cacheprovider', f'--junitxml={root}/junit.xml'], cwd=root, capture_output=True, text=True,\n    71\t                          env={'PATH': '/usr/bin:/bin:/usr/local/bin:/opt/homebrew/bin', 'PYTHONPATH': f'{root}/src:{root}/poc', 'PYTHONDONTWRITEBYTECODE': '1', 'HOME': str(Path.home())}, timeout=900)\n    72\t\n    73\t\n    74\twith tempfile.TemporaryDirectory() as base:\n    75\t    control = run(tree(Path(base) / 'control'))\n    76\t    print('control:', 'PASS' if control.returncode == 0 else 'FAIL', control.stdout.strip().splitlines()[-1])\n    77\t    if control.returncode != 0:\n    78\t        raise SystemExit('the unmutated control fails: no mutant is judged')\n    79\t    caught = 0\n    80\t    for n, (name, (relative, old, new)) in enumerate(MUTANTS.items()):\n    81\t        root = tree(Path(base) / f'm{n}')\n    82\t        path = root / relative\n    83\t        text = path.read_text()\n    84\t        assert text.count(old) == 1, (name, text.count(old))\n    85\t        path.write_text(text.replace(old, new))\n    86\t        result = run(root)\n    87\t        cases = ElementTree.parse(root / 'junit.xml').getroot().iter('testcase')\n    88\t        outcomes = [(case.get('name'), case.find('failure'), case.find('error')) for case in cases]\n    89\t        failed = [name for name, failure, _ in outcomes if failure is not None   # a test that failed on its own scratch edit is not a catch\n    90\t                  and 'scratch anchor' not in (failure.get('message') or '') + (failure.text or '')]\n    91\t        errors = [name for name, _, error in outcomes if error is not None]\n    92\t        verdict = 'CAUGHT' if failed and not errors else 'MISSED' if not errors else 'ERROR'   # a setup or collection error is not a catch\n    93\t        caught += verdict == 'CAUGHT'\n    94\t        print(f'{verdict}  {name}: {len(failed)} failing: {\", \".join(failed[:6])}' + (f' | errors: {errors[:2]}' if errors else ''))\n    95\t    print(f'{caught} of {len(MUTANTS)} mutants caught')\n     1\t\"\"\"Build or check the \"Forecast unavailable\" release package (docs/research/2026-11-22-number-answers/RELEASE-BUILD.md).\n     2\t\n     3\t    release_build.py build --ledger <views.sqlite> --items <items.sqlite> [--as-of YYYY-MM-DD] --out <folder>\n     4\t    release_build.py check <folder> --ledger <views.sqlite> --items <items.sqlite>\n     5\t\n     6\tNo model or network call; both stores are read only. The package is checked in a private staging folder against the stores before\n     7\tone atomic move publishes it, and neither the package nor the report ever replaces an existing path. Exit statuses: 0 done; 1\n     8\trefused, with nothing published by this command; 2 the package is published (build) or passes (check) but the report name is taken\n     9\tor the report could not be written.\n    10\t\"\"\"\n    11\timport argparse\n    12\timport json\n    13\timport os\n    14\timport shutil\n    15\timport sys\n    16\timport time\n    17\tfrom pathlib import Path\n    18\t\n    19\tROOT = Path(__file__).resolve().parents[1]\n    20\tsys.path.insert(0, str(ROOT / 'src'))\n    21\tfrom hivemind import release, service  # noqa: E402\n    22\tfrom hivemind.views import store  # noqa: E402\n    23\t\n    24\t\n    25\tdef report_path(out):\n    26\t    return out.with_name(out.name + '.report.json')\n    27\t\n    28\t\n    29\tdef write_report(report, path):\n    30\t    \"\"\"Print the report, then publish it: 0 when it is published (naming any temporary file left behind), 2 when it is not.\"\"\"\n    31\t    print(json.dumps(report, ensure_ascii=False, indent=1))\n    32\t    try:\n    33\t        leftover = release.publish_report(report, path)\n    34\t    except OSError as error:\n    35\t        print(f'report not written ({error}); run check to write it', file=sys.stderr)\n    36\t        return 2\n    37\t    print(f'report: {path}')\n    38\t    if leftover:\n    39\t        print(f'report published; its temporary file {leftover} could not be removed', file=sys.stderr)\n    40\t    return 0\n    41\t\n    42\t\n    43\tdef build(args):\n    44\t    out = Path(args.out).absolute()\n    45\t    report = report_path(out)\n    46\t    for path in (out, report):\n    47\t        if os.path.lexists(path):\n    48\t            print(f'refused: {path} exists', file=sys.stderr)\n    49\t            return 1\n    50\t    started = time.monotonic()\n    51\t    staged = views_db = items_db = None\n    52\t    try:\n    53\t        views_db = service.open_ledger(str(release.store_path(args.ledger)))\n    54\t        items_db = store.open_read_only(str(release.store_path(args.items)))\n    55\t        bound = release.resolve(views_db, args.as_of)\n    56\t        staged = release.stage(out)\n    57\t        data = release.release_export(views_db, items_db, bound)\n    58\t        export_seconds = time.monotonic() - started\n    59\t        release.write_package(data, staged)\n    60\t        checked = time.monotonic()\n    61\t        counts, data, size = release.check_package(staged, views_db, items_db, expected_as_of=bound)\n    62\t        unresolved = release.withheld_unresolved(views_db, data)\n    63\t        check_seconds = time.monotonic() - checked\n    64\t        release.publish(staged, out)\n    65\t        staged = None                       # published: this build no longer owns the staging name\n    66\t    except Exception as error:              # any failure before publication: nothing at --out from this build\n    67\t        print(f'refused: {type(error).__name__}: {error}', file=sys.stderr)\n    68\t        return 1\n    69\t    finally:\n    70\t        if staged is not None:\n    71\t            shutil.rmtree(staged)\n    72\t        for conn in (views_db, items_db):\n    73\t            if conn is not None:\n    74\t                conn.close()\n    75\t    print(f'published {out}: {counts}')\n    76\t    summary = {'ledger': str(args.ledger), 'items': str(args.items), 'as_of': bound, 'counts': counts,\n    77\t               'withheld_unresolved': unresolved, 'data_bytes': size,\n    78\t               'export_seconds': round(export_seconds, 2), 'check_seconds': round(check_seconds, 2)}\n    79\t    return write_report(summary, report)\n    80\t\n    81\t\n    82\tdef check(args):\n    83\t    out = Path(args.package).absolute()\n    84\t    views_db = items_db = None\n    85\t    try:\n    86\t        views_db = service.open_ledger(str(release.store_path(args.ledger)))\n    87\t        items_db = store.open_read_only(str(release.store_path(args.items)))\n    88\t        started = time.monotonic()\n    89\t        counts, data, size = release.check_package(out, views_db, items_db)\n    90\t        check_seconds = time.monotonic() - started\n    91\t        unresolved = release.withheld_unresolved(views_db, data)\n    92\t    except Exception as error:\n    93\t        print(f'refused: {type(error).__name__}: {error}', file=sys.stderr)\n    94\t        return 1\n    95\t    finally:\n    96\t        for conn in (views_db, items_db):\n    97\t            if conn is not None:\n    98\t                conn.close()\n    99\t    print(f'passes {out}: {counts}')\n   100\t    summary = {'ledger': str(args.ledger), 'items': str(args.items), 'as_of': data['as_of'], 'counts': counts,\n   101\t               'withheld_unresolved': unresolved, 'data_bytes': size,\n   102\t               'export_seconds': None, 'check_seconds': round(check_seconds, 2)}\n   103\t    return write_report(summary, report_path(out))\n   104\t\n   105\t\n   106\tdef main(argv=None):\n   107\t    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)\n   108\t    commands = parser.add_subparsers(dest='command', required=True)\n   109\t    make = commands.add_parser('build')\n   110\t    make.add_argument('--ledger', required=True, type=Path)\n   111\t    make.add_argument('--items', required=True, type=Path)\n   112\t    make.add_argument('--as-of')\n   113\t    make.add_argument('--out', required=True, type=Path)\n   114\t    verify = commands.add_parser('check')\n   115\t    verify.add_argument('package', type=Path)\n   116\t    verify.add_argument('--ledger', required=True, type=Path)\n   117\t    verify.add_argument('--items', required=True, type=Path)\n   118\t    args = parser.parse_args(argv)\n   119\t    return build(args) if args.command == 'build' else check(args)\n   120\t\n   121\t\n   122\tif __name__ == '__main__':\n   123\t    sys.exit(main())\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba docs/research/2026-11-22-number-answers/RELEASE-BUILD.md | sed -n '1,35p;105,249p;341,480p'\"","aggregated_output":"     1\t# \"Forecast unavailable\" release: build design for slice 1 (the exporter and the checked package)\n     2\t\n     3\t**Status: revision 11. Built** (`src/hivemind/release.py`, `scripts/release_build.py`, `tests/test_release.py`; result in\n     4\t`RELEASE-CHECK-RESULT.md`). Revision 10 was ready per council 74j; revision 11 records the changes council 75 required of the build.\n     5\t\n     6\t**Revision 11 (council 75, `codex-r75.md`).** Each change is in the code and has a test and a mutant:\n     7\t- **A view key counts only once it is visible at the bound** (its `seq`). A key written later never reclassifies an earlier package\n     8\t  (test 22).\n     9\t- **Text fields are strings, never null,** as §1 already specified (test 23). The four stores hold no null evidence or item fields.\n    10\t- **`check_package` reads each file once,** through one handle on the folder (`O_DIRECTORY | O_NOFOLLOW`, then `O_NOFOLLOW` per file and\n    11\t  `fstat`). It hashes and parses the same bytes and returns `(counts, data, bytes)`, so the command reports what was checked.\n    12\t- **A store path whose resolved form holds `%`, `?` or `#` is refused** (`release.store_path`), because `store.open_read_only` puts\n    13\t  the path into a SQLite `file:` URI unescaped (test 24). The opener itself is shared POC code and is not changed here.\n    14\t- **The writer's own refusal** is proved by a scratch-copy pair (test 25).\n    15\t- **Both commands print the whole report** before publishing it. Durations use `time.monotonic`. Refusals name the evidence id.\n    16\t- **Council 75b** (`codex-r75b.md`):\n    17\t  - `store_path` returns the resolved path, which the opener is given, so a link is not resolved twice (test 24);\n    18\t  - package files are opened without waiting (`O_NONBLOCK`), so a named pipe is refused by type instead of blocking `check` (test 15);\n    19\t  - reordered questions and evidence are tested (test 10).\n    20\t- **Councils 75c and 75d, verification only.** The mutant runner judges each catch from the full failure message in pytest's XML\n    21\t  report. One structural rule holds for every acceptance assertion: compare against fixed expected values written down before the run,\n    22\t  never values taken from the output under test, and match each refusal's exact reason (tests 2, 11, 21; `release_check.py`). Release work was opened by the council under D439 (D758). The behaviour is\n    23\tfixed by D726, D756 and `FORECAST-UNAVAILABLE-DESIGN.md` (revision 4). This page holds the AGENTS §2 tables for the first slice.\n    24\t\n    25\t**Revision 2 answers `codex-r74.md`** (see `claude-r74.md`):\n    26\t- the pass condition is an origin check of every field against its stored source, not a string sweep;\n    27\t- a missing source item is refused;\n    28\t- the package is checked before it is moved into place;\n    29\t- the manifest is a closed set;\n    30\t- the bound is validated as a date;\n    31\t- narrow reads;\n    32\t- size and speed budgets;\n    33\t- tests that separate every branch;\n    34\t- `object`, `kind` and groups dropped;\n    35\t- no idea submission.\n   105\t  - colleagues' page;\n   106\t  - frozen pieces, extraction included;\n   107\t  - any model call;\n   108\t  - commit, publish, deploy.\n   109\t\n   110\t## 1. What is built\n   111\t\n   112\t`src/hivemind/release.py` is the one owner, beside `service.py`.\n   113\t\n   114\t- **Constants:**\n   115\t  - `FORMAT = 'hivemind-release/1'`;\n   116\t  - `ALLOW_LIST = 'release-allow-list/1'`;\n   117\t  - `FORECAST_UNAVAILABLE = 'Forecast unavailable'`;\n   118\t  - `PACKAGE_FILES = {'manifest.json', 'release-data.json'}`.\n   119\t- **`ALLOWED`:** the closed key set per record type.\n   120\t\n   121\t  | Record | Keys |\n   122\t  |---|---|\n   123\t  | envelope | `format`, `allow_list`, `as_of`, `questions` |\n   124\t  | number question | `id`, `question`, `open`, `class` (= `number`), `forecast` (= the marker), `evidence` |\n   125\t  | event or Yes/No question | `id`, `question`, `open`, `class` (`event` or `yes_no`), `answers` (the two stored rung labels, in position order), `answer` (the stored label of the latest judgement's rung on or before the bound, or null), `evidence` |\n   126\t  | evidence in force at the bound | `id`, `one_line`, `quote`, `tier`, `speaker`, `original_who`, `original_day`, `sources` |\n   127\t  | source recorded on or before the bound | `title`, `publisher`, `day`, `uri` |\n   128\t  | manifest | `format`, `allow_list`, `as_of`, `data_sha256` |\n   129\t\n   130\t- **`question_class(views_db, view_id, labels)`** (design §3):\n   131\t  - `event` when the view key's measure is in `identity.EVENT_MEASURES`. The key is read as `select measure from view_keys`, and\n   132\t    only when the table exists;\n   133\t  - `yes_no` when there are exactly two labels which, through `vocabulary.canonical('label', …)`, are `Yes` and `No` in either order;\n   134\t  - `number` otherwise: a view with no key, or one whose bands cannot be resolved.\n   135\t- **`release_export(views_db, items_db, as_of=None)`:**\n   136\t  - pins both connections (`bundle.read_snapshot`);\n   137\t  - takes an explicit day only in canonical form: `date.fromisoformat(day).isoformat()` must equal the text given, otherwise\n   138\t    `ReleaseRefused` (so `20260825` is refused, not read as `2026-08-25`). It then resolves the bound with `service.resolve_bound`,\n   139\t    refuses a store with no default day, and uses that canonical text in every query;\n   140\t  - exports every view that exists at the bound (`service.view_exists`), closed ones included, in `created_seq, rowid` order;\n   141\t  - builds each record field by field from the table above, with column-limited SQL:\n   142\t    - `select view_id, question, created_seq from views order by created_seq, rowid`;\n   143\t    - `select position, label from rungs`;\n   144\t    - `select rung from judgements where view_id=? and publication_day<=? order by judgement_id desc limit 1`;\n   145\t    - `service.is_open_as_of`, which reads only `open` and `after_seq`;\n   146\t  - takes evidence in force from `service.evidence` and its fields from that record;\n   147\t  - looks up each source's `title`, `publisher` and `source_uri` in the items database by `input_id`. A visible source whose item is\n   148\t    missing raises `ReleaseRefused` (there is no fallback to the id);\n   149\t  - calls `check_export` on its own result before returning (AGENTS §3: the writer refuses).\n   150\t- **`check_export(data)`:** the closed-set check.\n   151\t  - Every dict at every level has exactly its record type's keys.\n   152\t  - Value checks:\n   153\t    - `format` and `allow_list` equal the constants, and `as_of` is a canonical `YYYY-MM-DD` day (`date.fromisoformat(as_of).isoformat() == as_of`);\n   154\t    - `class` is in its set;\n   155\t    - a number record's `forecast` is the marker;\n   156\t    - `answers` is two strings, and `answer` is one of them or null;\n   157\t    - `open` is a bool and every text field is a string.\n   158\t  - It returns the counts it judged: questions per class, evidence, sources.\n   159\t- **`check_origins(views_db, items_db, data, expected_as_of)`:** the pass condition. It is independent of the exporter's code path.\n   160\t  It derives everything it compares from the store, never from the package.\n   161\t  - **The bound: one rule for both commands.** `expected_as_of` is given by the caller.\n   162\t    - The builder passes the bound it resolved: `service.resolve_bound` on the requested day, or the default when none is given; an\n   163\t      omitted day with no default is refused.\n   164\t    - `check` passes the package's `as_of` through the same `service.resolve_bound`, which refuses a day after a store's last\n   165\t      completed day. A legacy ledger with no completed days accepts any valid date in both commands alike.\n   166\t    - The package's `as_of` must equal `expected_as_of`.\n   167\t  - **The class** of each question is derived from the stored measure and labels (`question_class`). The permitted keys and values\n   168\t    are then chosen from that class, never from the package's `class` field.\n   169\t  - **Order and counts.** The questions are compared as an ordered list in `created_seq, rowid` order, as `bundle.library` orders\n   170\t    them (`old-2/v2` and `v3` share sequence 8). Each question's evidence is compared in link order (`evidence_links.id`), and its\n   171\t    sources in row order (`evidence_sources.id`). A duplicate question, evidence record or source therefore fails.\n   172\t\n   173\t  It compares every field with its permitted stored source at the bound, by direct SQL:\n   174\t  - the question set equals the views visible at the bound, with `question` equal to `views.question`;\n   175\t  - `open` equals the latest visible switch's `open`;\n   176\t  - for `event` and `yes_no`: `answers` equal the rung labels in position order, and `answer` equals the label of the latest judgement\n   177\t    rung on or before the bound, or null;\n   178\t  - for `number`: only the marker;\n   179\t  - the evidence id set equals the links visible at the bound, minus those whose latest replacement is visible, computed in its own\n   180\t    SQL. Each evidence field equals the `evidence` row's column;\n   181\t  - each source list starts from every visible `evidence_sources` row, in row order, with `day` taken from\n   182\t    `evidence_sources.publication_day`. Each row needs a matching `items` row for `title`, `publisher` and `source_uri`; a row with no\n   183\t    item raises `ReleaseRefused` (a left join, so a missing item is never silently dropped).\n   184\t\n   185\t  Any difference raises `ReleaseRefused`, naming the question, the field and the evidence id. It returns the number of fields\n   186\t  compared.\n   187\t- **`stage(out_dir)`:** creates a private staging folder with a name unique to this invocation, `tempfile.mkdtemp(dir=out_dir.parent,\n   188\t  prefix='.<name>.staging-')`. Creation is exclusive, so only this invocation owns it. It returns the path.\n   189\t- **`write_package(data, staged)`:** writes `release-data.json` and `manifest.json` into the staging folder. It creates nothing\n   190\t  else.\n   191\t- **`publish(staged, out_dir)`:** one atomic move that refuses any existing destination, empty or not:\n   192\t  - on macOS, `renamex_np(staged, out_dir, RENAME_EXCL)` through `ctypes`. Verified on this Mac: onto a free path it succeeds; onto\n   193\t    an existing empty or non-empty folder it fails with `EEXIST`, and both folders stay as they were;\n   194\t  - on Linux, `renameat2(AT_FDCWD, staged, AT_FDCWD, out_dir, RENAME_NOREPLACE)`;\n   195\t  - where neither call exists, or the filesystem lacks support (`ENOTSUP`, `EINVAL`), it raises `ReleaseRefused`.\n   196\t\n   197\t  It never replaces, creates or removes anything at `out_dir` except by that one move.\n   198\t- **`check_package(path, views_db=None, items_db=None, expected_as_of=None)`:**\n   199\t  - the directory holds exactly `PACKAGE_FILES`, each a regular file and not a symbolic link (`os.lstat`), with no subdirectories;\n   200\t  - both files parse as JSON with no duplicate member name at any level (an `object_pairs_hook` that refuses a repeated key);\n   201\t  - the manifest has exactly its four keys, and its `format`, `allow_list` and `as_of` equal the data's;\n   202\t  - its sha256 equals the data file's;\n   203\t  - the data passes `check_export`, and, when the stores are given, `check_origins` with the expected bound;\n   204\t  - it returns the counts.\n   205\t- **`withheld_unresolved(views_db, data)`** is for the report only. It lists the number questions whose `service.ladder_bands(rungs)`\n   206\t  returns `(None, reason)`, with the reason and whether the view has a key. Its output never enters the package.\n   207\t\n   208\t`scripts/release_build.py`:\n   209\t- **`build --ledger --items [--as-of] --out`:**\n   210\t  1. refuse an existing `--out` or `<out>.report.json` early, as a convenience. The no-replace publication of each holds the\n   211\t     guarantee;\n   212\t  2. resolve the bound once: a given `--as-of` must be canonical `YYYY-MM-DD` (as above), then `service.resolve_bound`;\n   213\t  3. `stage(--out)`. From here a `finally` removes this staging folder while the build still owns it;\n   214\t  4. `release_export` at that bound;\n   215\t  5. `write_package` into the staging folder;\n   216\t  6. `check_package` on the staged folder, with the stores and the resolved bound;\n   217\t  7. `publish` to `--out`. The moment it succeeds, the build drops its staging path (`staged = None`); the `finally` then removes\n   218\t     nothing;\n   219\t  8. `publish_report`: write the report to a private temporary file in the same folder (`tempfile.mkstemp`), then `os.link` it to\n   220\t     `<out>.report.json`. The link fails with `EEXIST` if anything exists at that name. **A successful link is the moment the report\n   221\t     is published.** The temporary file is then removed. If that removal fails, the command still reports the report as published,\n   222\t     names the leftover temporary file, and exits 0.\n   223\t\n   224\t  The failure outcomes:\n   225\t  - **Before publication** (steps 2–7): any exception, whether `ReleaseRefused`, `OSError`, `sqlite3.Error` or another, prints the\n   226\t    reason and exits 1. The `finally` removes this build's staging folder; nothing exists at `--out` from this build. A corrected\n   227\t    retry at the same `--out` succeeds.\n   228\t  - **After publication, before the link** (step 8 fails before the link succeeds, including `EEXIST`): the package is final and\n   229\t    checked, and whatever is at the report name is untouched. Exit 2 with \"package published and checked; report not written; run\n   230\t    `check` to write it\".\n   231\t\n   232\t  It has no input path for prepared or translated JSON, and it takes no clock reading; the folder name is the caller's (D12, D13).\n   233\t- **`check <out> --ledger --items`:** re-runs `check_package` on an existing package, with the stores, the package's canonical\n   234\t  `as_of` validated against the store (above), and the regular-file and duplicate-key checks. It leaves the package in place, prints\n   235\t  the report, and writes `<out>.report.json` only through `publish_report`, so it never replaces anything. Its exit statuses:\n   236\t  - 0: the package passes, and the report was published;\n   237\t  - 2: the package passes, and the report is not published: its name is occupied (an earlier report, or anything else, which stays\n   238\t    untouched), or writing the temporary file or the link fails for any other reason, which is printed;\n   239\t  - 1: the package is refused, with the reason. This is also the retry after a report write failed. Its report gives `check_seconds` and marks\n   240\t  `export_seconds` as not measured.\n   241\t- **The report:**\n   242\t  - the store path and the bound;\n   243\t  - counts per class;\n   244\t  - the unresolved list;\n   245\t  - the fields compared;\n   246\t  - bytes;\n   247\t  - `export_seconds` (build only) and `check_seconds`.\n   248\t\n   249\t## 2. State × event (one export, read-only)\n   341\t## 6. Tests (`tests/test_release.py`) and mutants\n   342\t\n   343\tThe fixtures use a real store on a temporary path (`store.create_view`, `store.insert`), with a real items database. Each test names\n   344\tits row above:\n   345\t1. **Closed set (§1).**\n   346\t   - Every dict in a fixture export has exactly its type's keys.\n   347\t   - Positive control: an export with one added key fails `check_export`.\n   348\t2. **Number with `lo`/`hi`.** The record carries the marker. No rung label, condition, `reasons`, `why_changed` or `implied_outcome` of\n   349\t   that view appears in any decoded package field.\n   350\t3. **Branch fixtures for identity and the report:**\n   351\t   - a condition-only number that resolves: `number`, and absent from `withheld_unresolved`;\n   352\t   - an unresolved number with a key: `number`, and present;\n   353\t   - an unresolved number without a key: `number`, and present.\n   354\t4. **Yes/No with numeric bounds** (`growth_rate` key, labels Yes/No): `yes_no`, with its answer label. A `why_changed` quoting\n   355\t   \"$1 trillion\" is absent.\n   356\t5. **Event with the served ledger's `v49` labels,** \"Restriction adopted\" / \"No restriction adopted\": `event`, with its label kept. A\n   357\t   `why_changed` quoting another question's band is absent.\n   358\t6. **Legacy store** with no `view_keys` table and `是`/`否` labels: `yes_no`.\n   359\t7. **Closing switch** whose reason names the band label: `open: false`, and the reason is absent.\n   360\t8. **Replacement and source visibility** at two bounds. A visible source with a missing item is refused.\n   361\t9. **Package:**\n   362\t   - staged, then checked, passes;\n   363\t   - a foreign file fails, and so does a subdirectory;\n   364\t   - a changed data byte fails;\n   365\t   - an extra manifest key with an unchanged data hash fails;\n   366\t   - a manifest `as_of` differing from the data's fails;\n   367\t   - an existing `--out`, empty or not, is refused, and a leftover staging folder from another build does not block a build.\n   368\t10. **Origin check, each from the store:**\n   369\t    - in a staged copy, the system's forecast text placed in an evidence `one_line` fails, naming the field;\n   370\t    - a Yes/No record turned into a number record, keeping the closed set, fails;\n   371\t    - a duplicated question, and a duplicated evidence record, each fails;\n   372\t    - a package whose `as_of` is a day later than the store's last completed day fails `check`;\n   373\t    - a legacy fixture with no completed days, built at an explicit day later than its last judgement, passes a later `check`.\n   374\t11. **Builder end to end,** run as the user calls it (subprocess, `--as-of` omitted):\n   375\t    - the build exits 0, and the package and its report exist;\n   376\t    - `check` with the build's report still in place prints a passing result and exits 2;\n   377\t    - after the test removes that report, `check` exits 0 and publishes a fresh one.\n   378\t12. **Builder refusal, through the real command, on a scratch copy** (the AGENTS §4 mutation procedure; no fake in the suite):\n   379\t    - the unchanged command succeeds on the fixture store (test 11);\n   380\t    - on a scratch copy, the writer fault \"one evidence `one_line` taken from the latest judgement's `why_changed`\" is introduced.\n   381\t      The same command exits 1 with the origin-mismatch reason, no `--out` and no staging folder left;\n   382\t    - on a second scratch copy, the same writer fault plus the builder's staged check removed: the bad package reaches `--out`. That\n   383\t      shows the staged check is what prevents publication.\n   384\t13. **`check` with a missing item.** A finished package. Then a copy of the items database with one referenced item deleted, and a\n   385\t    copy of the package with that same source removed and its manifest hash refreshed. `check` refuses, naming the missing item. (An\n   386\t    inner-join mutant accepts this pair, so this case catches it.)\n   387\t14. **The publication rule.**\n   388\t    - Module steps: builds A and B both stage, then A publishes. B's `publish` refuses with `EEXIST`. A's package passes `check`, and\n   389\t      B's staging is still there for its owner to remove.\n   390\t    - Module steps: after staging, a foreign *empty* folder is put at `--out`. `publish` refuses, and the foreign folder still exists\n   391\t      afterwards, empty.\n   392\t    - The command, early: an existing empty `--out` gives exit 1, and the folder survives.\n   393\t    - The command, late (a scratch copy with a pause before `publish`, released by the test): the test creates an empty folder at\n   394\t      `--out` during the pause. The command exits 1, its staging folder is removed, and the same empty folder survives (same device\n   395\t      and inode).\n   396\t    - The command, after the move (a scratch copy with a pause just after `publish`): the test recreates the freed staging name as a\n   397\t      folder holding a marker file. After the command exits 0, the marker is still there.\n   398\t18. **Report over an input.** `--out` is chosen so that `<out>.report.json` is the items database, three ways: the same path, a\n   399\t    case-variant name on this case-insensitive volume, and a symbolic link to it. `build` refuses, and `check` on an existing package\n   400\t    exits 2. The items file's sha256 is unchanged.\n   401\t19. **Report name taken during the build** (a scratch copy with a pause just before `publish_report`): the test writes a marker file\n   402\t    at the report name. The command exits 2 and the marker is unchanged. `check` then prints a passing result, exits 2, and leaves the\n   403\t    marker unchanged.\n   404\t21. **`check` cannot write its report** (a scratch copy in which creating the report's temporary file raises `PermissionError`): `check`\n   405\t    prints the passing result and the write error, and exits 2.\n   406\t20. **Temporary file left after the link** (a scratch copy in which removing the report's temporary file raises): the build exits 0\n   407\t    and says the report is published, naming the leftover temporary file. The report exists and equals the build's report.\n   408\t17. **A database error through the command.** A valid ledger with an items database that has no `items` table: exit 1, the database\n   409\t    error printed, nothing at `--out`, no staging folder left. A retry at the same `--out` with the correct items database succeeds.\n   410\t15. **Files:**\n   411\t    - a symbolic link in place of `release-data.json` fails;\n   412\t    - a data file whose repeated `one_line` member has the genuine value last, with the manifest hash refreshed so every other\n   413\t      check passes, fails on the repeated name.\n   414\t16. **Bound validation:**\n   415\t    - `2026-08-99` is refused;\n   416\t    - `20260825` is refused, while `2026-08-25` builds. On a fixture with evidence on both sides of that day, the package holds only\n   417\t      the earlier evidence;\n   418\t    - a valid day before the first question gives an empty package.\n   419\t\n   420\t**Mutants,** on a scratch copy with `PYTHONDONTWRITEBYTECODE=1`; each must fail a test:\n   421\t- `condition` emitted on number records;\n   422\t- `one_line` taken from the latest judgement's `why_changed`;\n   423\t- the event test removed;\n   424\t- the Yes/No test removed;\n   425\t- `check_package` without the file-set check;\n   426\t- manifest keys unchecked;\n   427\t- `check_export` without the closed-key check;\n   428\t- `check_origins` skipping evidence fields;\n   429\t- `check_origins` taking the class from the package;\n   430\t- `check_origins` comparing sets instead of ordered lists;\n   431\t- `check_origins` with an inner join to `items`;\n   432\t- `check` without validating the package's `as_of` against the store;\n   433\t- the builder skipping the staged `check_package` (the scratch-copy pair in test 12);\n   434\t- `publish` replaced by `os.rename` (test 14's foreign empty folder is then replaced);\n   435\t- the `finally` removed (test 17 then leaves staging);\n   436\t- the staging path not dropped after `publish` (test 14's marker is then removed);\n   437\t- the canonical-day check removed (test 16's `20260825` then builds with later evidence);\n   438\t- `publish_report` replaced by `os.replace` (tests 18 and 19 then overwrite the items file and the marker);\n   439\t- the symbolic-link check removed;\n   440\t- the duplicate-key check removed;\n   441\t- the switch reason emitted;\n   442\t- the missing-item refusal replaced by the id fallback.\n   443\t\n   444\t## 7. The $0 release check (stored stores, read-only)\n   445\t\n   446\tStores: `old-1`, `old-2`, `old-3` (`comparison-2026-11-17/run/old-N/prod/views.sqlite`, items `items-comparison.sqlite`) and the\n   447\tserved ledger with its items database.\n   448\t\n   449\t**Budgets,** set before the first control (AGENTS §2):\n   450\t- the package's data bytes at most `bundle.library`'s JSON bytes on the same store and bound;\n   451\t- export plus all checks at most three times `bundle.library`'s seconds on the same store, and at most 120 s per store.\n   452\t\n   453\tThe steps:\n   454\t1. **Build each store's package at its default bound.** The build passes `check_package` with `check_origins`. Report the fields\n   455\t   compared, the counts per class and the unresolved list.\n   456\t2. **The decisive acceptance case** (council 74), on the `old-1` package:\n   457\t   - Morningstar's `$361 billion` estimate (`e2295`) is kept, its summary and quote equal to the stored ones;\n   458\t   - the genuine \"Bullish confirmation\" quote (`e1865`) is kept;\n   459\t   - the genuine analyst \"$390 billion\" quote (`e3597`) is kept, as the control;\n   460\t   - in a copy of the staged package, the system's `old-1` j1580 `implied_outcome` (\"About $390 billion…\") substituted into\n   461\t     `e2295`'s summary fails `check_origins`;\n   462\t   - the same text added to the manifest fails `check_package`.\n   463\t3. **`old-1/v8`:** `class` is `number`, with the marker and the same evidence ids as `service.evidence` at the bound.\n   464\t4. **The known event leaks at their own dates.** Export `old-3` at 2026-08-25 (`v36` j799 is the latest judgement) and `old-1` at\n   465\t   2026-08-28 (`v10` j865). Each keeps its original answer label, and j799's \"around $1 trillion\" text and j865's band text are absent.\n   466\t5. **Control:** one unchanged event question keeps its label and evidence.\n   467\t6. **Closing.** On a temporary copy of `old-1`, add a closing switch for `v8` in the store's own format (\"due …, frozen on … at\n   468\t   rung N <label>\"). First confirm that `bundle.view_bundle` exposes the reason with the band label. Then confirm the package shows\n   469\t   `open: false` and not the reason.\n   470\t7. **Diagnostics** (not the gate). For every question, take each string the package must not hold:\n   471\t   - rung labels and conditions;\n   472\t   - judgement `reasons` and `why_changed`, and `implied_outcome` and `reference` where the store has those columns (the served\n   473\t     ledger has neither; the report says so);\n   474\t   - switch reasons.\n   475\t\n   476\t   Search every decoded string field of the package for each, with no floor. List every hit with its question, field, evidence id\n   477\t   and the stored string it matched, and read each by hand. A genuine source quote, such as `e1865`'s \"Bullish\", is recorded as such.\n   478\t8. **Budgets:** bytes and seconds against the budgets above.\n   479\t\n   480\t## 8. A disclosed property, not built: evidence summaries keep extraction's wording\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_12","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba tests/test_release.py | sed -n '1,405p'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba tests/test_release.py | sed -n '1,405p'\"","aggregated_output":"     1\t\"\"\"The \"Forecast unavailable\" release package (docs/research/2026-11-22-number-answers/RELEASE-BUILD.md, revision 10; D726, D758).\n     2\t\n     3\tEach test names the design row it proves (§1 the closed set and the checks, §2 state × event, §6 the numbered tests). The stores are\n     4\treal SQLite files on a temporary path; the only edits of code are the mutation-procedure scratch copies of §6 tests 12, 14, 19, 20\n     5\tand 21, which insert a pause or a fault into a copy of the module and the command.\"\"\"\n     6\timport hashlib\n     7\timport json\n     8\timport os\n     9\timport shutil\n    10\timport sqlite3\n    11\timport subprocess\n    12\timport sys\n    13\timport time\n    14\tfrom pathlib import Path\n    15\t\n    16\timport pytest\n    17\t\n    18\tROOT = Path(__file__).resolve().parents[1]\n    19\tsys.path.insert(0, str(ROOT / 'src'))\n    20\tfrom hivemind import release, service  # noqa: E402\n    21\tfrom hivemind.views import store  # noqa: E402\n    22\t\n    23\tCOMMAND = ROOT / 'scripts' / 'release_build.py'\n    24\tDAYS = ['2026-08-24', '2026-08-25', '2026-08-26']\n    25\tASSET_LABELS = ['Strongly bullish', 'Bullish', 'Neutral', 'Bearish', 'Strongly bearish']\n    26\tV1_CONDITIONS = ['FY2027 revenue is at least $400 billion.', 'FY2027 revenue is at least $350 billion and less than $400 billion.',\n    27\t                 'FY2027 revenue is at least $300 billion and less than $350 billion.', 'FY2027 revenue is at least $250 billion and less than $300 billion.',\n    28\t                 'FY2027 revenue is less than $250 billion.']\n    29\tV1_BOUNDS = [(400e9, None), (350e9, 400e9), (300e9, 350e9), (250e9, 300e9), (None, 250e9)]\n    30\tV1_REASONS = 'The first-half figure and the third-quarter guide support an estimate of about $390 billion for the year.'\n    31\tV1_WHY = 'Moved up to the $350 billion to under $400 billion rung on the raised guide.'\n    32\tV5_WHY = 'Spending of around $1 trillion in 2027 makes acceleration likely.'\n    33\tV6_WHY = 'The revenue question now sits in the $350 billion to under $400 billion rung, which the rule would cut.'\n    34\tCLOSING = 'due 2026-08-25, frozen on 2026-08-25 at rung 2 Bullish'\n    35\tE6_ONE_LINE = 'Bullish confirmation would need firm orders, the author said.'       # the fixture's one genuine source use of a label word\n    36\tE6_QUOTE = 'Bullish confirmation would require firm procurement commitments.'\n    37\tREPORT_KEYS = {'ledger', 'items', 'as_of', 'counts', 'withheld_unresolved', 'data_bytes', 'export_seconds', 'check_seconds'}\n    38\t\n    39\t\n    40\tdef make_items(path, ids=('item-1', 'item-2', 'item-3')):\n    41\t    conn = sqlite3.connect(path)\n    42\t    conn.execute('create table items (input_id text primary key, title text, publisher text, publisher_type text, category text, publication_day text, source_uri text)')\n    43\t    for n, input_id in enumerate(ids, 1):\n    44\t        conn.execute('insert into items values (?,?,?,?,?,?,?)', (input_id, f'Article {n} on data-center spending', f'Publisher {n}', 'news', 'T1',\n    45\t                                                                 DAYS[min(n, 3) - 1], f'https://example.com/article-{n}'))\n    46\t    conn.commit()\n    47\t    conn.close()\n    48\t    return path\n    49\t\n    50\t\n    51\tdef five_rungs(conditions, bounds=None):\n    52\t    return [dict(label=label, condition=condition, **({'lo': lo, 'hi': hi} if bounds else {}))\n    53\t            for label, condition, (lo, hi) in zip(ASSET_LABELS, conditions, bounds or [(None, None)] * 5)]\n    54\t\n    55\t\n    56\tdef key(conn, view_id, measure, event_type='n/a'):\n    57\t    store.insert(conn, 'view_keys', view_id=view_id, measure=measure, scope='NVIDIA', scope_key='nvidia', period_start='2026-02-01',\n    58\t                 period_end='2027-01-31', basis='n/a', unit='USD', event_type=event_type, seq=1, scope_source='model', key_version=1)\n    59\t\n    60\t\n    61\tdef judge(conn, view_id, seq, rung, why, reasons='', implied=None):\n    62\t    store.insert(conn, 'judgements', view_id=view_id, seq=seq, input_id=f'item-{seq}', rung=rung, reasons=reasons, cited_evidence_json='[]',\n    63\t                 cited_views_json='[]', pushes_json='[]', changed=1, why_changed=why, publication_day=DAYS[seq - 1], theme_pushes_json='[]',\n    64\t                 reference=None, implied_outcome=implied)\n    65\t\n    66\t\n    67\tdef evidence(conn, evidence_id, view_id, seq, one_line, quote, sources):\n    68\t    store.insert(conn, 'evidence', evidence_id=evidence_id, quote=quote, one_line=one_line, speaker='Publisher', original_who='NVIDIA',\n    69\t                 original_day=DAYS[seq - 1], tier='party_statement', event_time=None, created_seq=seq, created_from_input=f'item-{seq}')\n    70\t    store.insert(conn, 'evidence_links', evidence_id=evidence_id, view_id=view_id, seq=seq)\n    71\t    for input_id, source_seq in sources:\n    72\t        store.insert(conn, 'evidence_sources', evidence_id=evidence_id, input_id=input_id, category='T1', publication_day=DAYS[source_seq - 1], seq=source_seq)\n    73\t\n    74\t\n    75\tdef make_store(path):\n    76\t    \"\"\"§6 fixture: three completed days; a number question with bounds (v1), one whose conditions resolve without a key (v2), unresolved\n    77\t    ones with a key (v3) and without (v4), a Yes/No question with numeric bounds (v5), an event (v6) and a closed number question (v7).\"\"\"\n    78\t    conn = store.open_db(str(path))\n    79\t    for seq, day in enumerate(DAYS, 1):\n    80\t        store.insert(conn, 'processing_steps', input_id=f'item-{seq}', sequence_no=seq, step='handed_over', result='ok', publication_day=day)\n    81\t        store.insert(conn, 'days_completed', day=day, seq=seq)\n    82\t    common = dict(object_id='NVDA', object_kind='company', kind='asset', due_day='2027-02-25', year='2027', seq=1, input_id='item-1', created_at='2026-08-24T12:00:00Z')\n    83\t    store.create_view(conn, view_id='v1', looks_at='NVIDIA revenue in FY2027', question='How much revenue will NVIDIA report for FY2027?', rungs=five_rungs(V1_CONDITIONS, V1_BOUNDS), **common)\n    84\t    key(conn, 'v1', 'revenue')\n    85\t    store.create_view(conn, view_id='v2', looks_at='NVIDIA FY2027 capital spending', question='How much will NVIDIA spend on capital in FY2027?',\n    86\t                      rungs=[{'label': '看多', 'condition': '不低于4000亿美元'}, {'label': '看空', 'condition': '低于4000亿美元'}], **common)\n    87\t    unreadable = ['Revenue is clearly strong.', 'Revenue is strong.', 'Revenue is flat.', 'Revenue is weak.', 'Revenue is clearly weak.']\n    88\t    store.create_view(conn, view_id='v3', looks_at='NVIDIA gaming revenue', question='How much gaming revenue will NVIDIA report for FY2027?', rungs=five_rungs(unreadable), **common)\n    89\t    key(conn, 'v3', 'segment_revenue')\n    90\t    store.create_view(conn, view_id='v4', looks_at='NVIDIA auto revenue', question='How much automotive revenue will NVIDIA report for FY2027?', rungs=five_rungs(unreadable), **common)\n    91\t    store.create_view(conn, view_id='v5', looks_at='Hyperscaler capex growth', question='Will hyperscaler capital spending growth accelerate in 2027?',\n    92\t                      rungs=[{'label': 'Yes', 'condition': 'Growth above zero', 'lo': 0.0, 'hi': None}, {'label': 'No', 'condition': 'Growth at or below zero', 'lo': None, 'hi': 0.0}], **common)\n    93\t    key(conn, 'v5', 'growth_rate')\n    94\t    store.create_view(conn, view_id='v6', looks_at='US export restriction', question='Will the US adopt the chip export restriction by 2027-01-31?',\n    95\t                      rungs=[{'label': 'Restriction adopted', 'condition': 'The rule is adopted'}, {'label': 'No restriction adopted', 'condition': 'The rule is not adopted'}], **common)\n    96\t    key(conn, 'v6', 'policy_event', 'regulation')\n    97\t    store.create_view(conn, view_id='v7', looks_at='NVIDIA Q2 revenue', question='How much revenue will NVIDIA report for Q2 FY2027?', rungs=five_rungs(V1_CONDITIONS, V1_BOUNDS), **common)\n    98\t    key(conn, 'v7', 'revenue')\n    99\t    judge(conn, 'v1', 1, 2, V1_WHY, V1_REASONS, 'About $390 billion')\n   100\t    judge(conn, 'v5', 1, 1, V5_WHY)\n   101\t    judge(conn, 'v6', 1, 2, V6_WHY)\n   102\t    judge(conn, 'v7', 1, 2, 'Held at the Bullish rung.')\n   103\t    store.insert(conn, 'view_switches', view_id='v7', open=0, reason=CLOSING, by_whom='pull', after_seq=2)\n   104\t    evidence(conn, 'e1', 'v1', 1, 'NVIDIA reported $164 billion of revenue in the first half.', 'The company generated $164 billion in the first six months.', [('item-1', 1), ('item-3', 3)])\n   105\t    evidence(conn, 'e2', 'v1', 3, 'Morningstar estimates $361 billion of revenue for the year.', 'We estimate it will be $361 billion in fiscal 2027.', [('item-3', 3)])\n   106\t    evidence(conn, 'e3', 'v1', 1, 'An early report put spending at $90 billion.', 'Spending was $90 billion, the report said.', [('item-1', 1)])\n   107\t    evidence(conn, 'e4', 'v1', 2, 'A corrected report put spending at $95 billion.', 'Spending was $95 billion, the corrected report said.', [('item-2', 2)])\n   108\t    store.insert(conn, 'replacements', old_evidence_id='e3', new_evidence_id='e4', said_day=DAYS[1], seq=2)\n   109\t    evidence(conn, 'e5', 'v6', 1, 'Officials said the export rule is under review.', 'The rule is under review, officials said.', [('item-1', 1)])\n   110\t    evidence(conn, 'e6', 'v5', 1, E6_ONE_LINE, E6_QUOTE, [('item-2', 1)])\n   111\t    conn.commit()\n   112\t    conn.close()\n   113\t    return path\n   114\t\n   115\t\n   116\t@pytest.fixture\n   117\tdef stores(tmp_path):\n   118\t    return make_store(tmp_path / 'views.sqlite'), make_items(tmp_path / 'items.sqlite')\n   119\t\n   120\t\n   121\tdef export(stores, as_of=None):\n   122\t    views_db, items_db = service.open_ledger(str(stores[0])), store.open_read_only(str(stores[1]))\n   123\t    try:\n   124\t        return release.release_export(views_db, items_db, as_of)\n   125\t    finally:\n   126\t        views_db.close()\n   127\t        items_db.close()\n   128\t\n   129\t\n   130\tdef strings(value):\n   131\t    \"\"\"Every decoded string in the package (keys excluded).\"\"\"\n   132\t    if isinstance(value, dict):\n   133\t        return [s for v in value.values() for s in strings(v)]\n   134\t    if isinstance(value, list):\n   135\t        return [s for v in value for s in strings(v)]\n   136\t    return [value] if isinstance(value, str) else []\n   137\t\n   138\t\n   139\tdef by_id(data):\n   140\t    return {q['id']: q for q in data['questions']}\n   141\t\n   142\t\n   143\tdef run(*args, cwd=None, timeout=120):\n   144\t    return subprocess.run([sys.executable, str(COMMAND), *map(str, args)], capture_output=True, text=True, cwd=cwd,\n   145\t                          env={**os.environ, 'PYTHONDONTWRITEBYTECODE': '1'}, timeout=timeout)\n   146\t\n   147\t\n   148\tdef build_package(stores, out, as_of=None):\n   149\t    views_db, items_db = service.open_ledger(str(stores[0])), store.open_read_only(str(stores[1]))\n   150\t    try:\n   151\t        data = release.release_export(views_db, items_db, as_of)\n   152\t        staged = release.stage(out)\n   153\t        release.write_package(data, staged)\n   154\t        release.check_package(staged, views_db, items_db, expected_as_of=data['as_of'])\n   155\t        release.publish(staged, out)\n   156\t        return data\n   157\t    finally:\n   158\t        views_db.close()\n   159\t        items_db.close()\n   160\t\n   161\t\n   162\tdef rewrite_data(package, data):\n   163\t    \"\"\"A copy of the package's data with its manifest hash refreshed, so every other check still passes.\"\"\"\n   164\t    payload = json.dumps(data, ensure_ascii=False, separators=(',', ':')).encode()\n   165\t    (package / release.DATA_FILE).write_bytes(payload)\n   166\t    manifest = json.loads((package / release.MANIFEST_FILE).read_text())\n   167\t    manifest.update(as_of=data['as_of'], data_sha256=hashlib.sha256(payload).hexdigest())\n   168\t    (package / release.MANIFEST_FILE).write_text(json.dumps(manifest))\n   169\t\n   170\t\n   171\tdef check(stores, package):\n   172\t    \"\"\"The counts of `check_package` with the stores.\"\"\"\n   173\t    views_db, items_db = service.open_ledger(str(stores[0])), store.open_read_only(str(stores[1]))\n   174\t    try:\n   175\t        return release.check_package(package, views_db, items_db)[0]\n   176\t    finally:\n   177\t        views_db.close()\n   178\t        items_db.close()\n   179\t\n   180\t\n   181\t# ---------- §6 tests 1–8: the export\n   182\t\n   183\t\n   184\tdef test_1_every_object_holds_exactly_its_record_types_keys(stores):\n   185\t    \"\"\"§1 ALLOWED, §6 test 1: the export passes the closed-set check; one added key fails it.\"\"\"\n   186\t    data = export(stores)\n   187\t    counts = release.check_export(data)\n   188\t    assert counts['questions'] == {'number': 5, 'event': 1, 'yes_no': 1} and counts['evidence'] == 5\n   189\t    assert set(by_id(data)['v1']) == release.ALLOWED['number'] and set(by_id(data)['v6']) == release.ALLOWED['answered']\n   190\t    by_id(data)['v1']['condition'] = V1_CONDITIONS[1]\n   191\t    with pytest.raises(release.ReleaseRefused, match='off the allow-list'):\n   192\t        release.check_export(data)\n   193\t\n   194\t\n   195\tdef test_2_number_question_carries_only_the_marker_and_its_evidence(stores):\n   196\t    \"\"\"§6 test 2 (D726): no rung label, condition, reason, explanation or implied outcome of v1 reaches any decoded field.\"\"\"\n   197\t    data = export(stores)\n   198\t    v1 = by_id(data)['v1']\n   199\t    assert v1['class'] == 'number' and v1['forecast'] == release.FORECAST_UNAVAILABLE\n   200\t    assert [e['id'] for e in v1['evidence']] == ['e1', 'e2', 'e4']\n   201\t    texts, own = strings(data), strings(v1)\n   202\t    for forbidden in [*V1_CONDITIONS, V1_REASONS, V1_WHY, 'About $390 billion']:\n   203\t        assert not any(forbidden in text for text in texts), forbidden\n   204\t    for label in ASSET_LABELS:                        # the selected label \"Bullish\" included; v1's own fields hold none\n   205\t        assert not any(label in text for text in own), label\n   206\t    for label in ASSET_LABELS:                        # anywhere else, only the fixture's own genuine wording, fixed before the run, holds one\n   207\t        assert {text for text in texts if label in text} <= {E6_ONE_LINE, E6_QUOTE}, label\n   208\t\n   209\t\n   210\tdef test_3_identity_branches_and_the_unresolved_report(stores):\n   211\t    \"\"\"§1 question_class, §6 test 3: a condition-only ladder that resolves and unresolved ladders with and without a key are all\n   212\t    number questions; only the unresolved two are listed.\"\"\"\n   213\t    data = export(stores)\n   214\t    assert {q['id']: q['class'] for q in data['questions']} == {'v1': 'number', 'v2': 'number', 'v3': 'number', 'v4': 'number', 'v5': 'yes_no', 'v6': 'event', 'v7': 'number'}\n   215\t    views_db = service.open_ledger(str(stores[0]))\n   216\t    try:\n   217\t        listed = {entry['id']: entry['has_key'] for entry in release.withheld_unresolved(views_db, data)}\n   218\t    finally:\n   219\t        views_db.close()\n   220\t    assert listed == {'v3': True, 'v4': False}\n   221\t\n   222\t\n   223\tdef test_4_yes_no_with_numeric_bounds_keeps_its_label_not_its_explanation(stores):\n   224\t    \"\"\"§6 test 4 (§4 a): v5 is Yes/No with its answer; its explanation quoting $1 trillion is absent.\"\"\"\n   225\t    data = export(stores)\n   226\t    v5 = by_id(data)['v5']\n   227\t    assert (v5['class'], v5['answers'], v5['answer']) == ('yes_no', ['Yes', 'No'], 'Yes')\n   228\t    assert not any('$1 trillion' in text for text in strings(data))\n   229\t\n   230\t\n   231\tdef test_5_event_keeps_its_labels_not_its_explanation(stores):\n   232\t    \"\"\"§6 test 5: an event with the served ledger's labels keeps them; its explanation quoting v1's rung is absent.\"\"\"\n   233\t    data = export(stores)\n   234\t    v6 = by_id(data)['v6']\n   235\t    assert (v6['class'], v6['answers'], v6['answer']) == ('event', ['Restriction adopted', 'No restriction adopted'], 'No restriction adopted')\n   236\t    assert not any(V6_WHY in text for text in strings(data))\n   237\t\n   238\t\n   239\tdef test_6_legacy_ledger_without_a_key_table_reads_chinese_yes_no(tmp_path):\n   240\t    \"\"\"§6 test 6, §2 legacy row: no view_keys table; 是/否 labels are Yes/No.\"\"\"\n   241\t    path = tmp_path / 'legacy.sqlite'\n   242\t    conn = store.open_db(str(path))\n   243\t    conn.execute('drop table view_keys')\n   244\t    store.insert(conn, 'processing_steps', input_id='item-1', sequence_no=1, step='handed_over', result='ok', publication_day=DAYS[0])\n   245\t    store.insert(conn, 'days_completed', day=DAYS[0], seq=1)\n   246\t    store.create_view(conn, view_id='v1', object_id='NVDA', object_kind='company', kind='asset', looks_at='Shipments', question='会开始量产出货吗？',\n   247\t                      due_day='2026-12-31', year='2026', rungs=[{'label': '是', 'condition': '开始出货'}, {'label': '否', 'condition': '未开始出货'}],\n   248\t                      seq=1, input_id='item-1', created_at='2026-08-24T12:00:00Z')\n   249\t    judge(conn, 'v1', 1, 1, '已确认出货。')\n   250\t    conn.commit()\n   251\t    conn.close()\n   252\t    data = export((path, make_items(tmp_path / 'items.sqlite')))\n   253\t    assert (data['questions'][0]['class'], data['questions'][0]['answer']) == ('yes_no', '是')\n   254\t\n   255\t\n   256\tdef test_7_closed_question_shows_closed_without_its_reason(stores):\n   257\t    \"\"\"§6 test 7, §2 closing row: v7 is closed at 08-25; the closing reason naming its rung is absent.\"\"\"\n   258\t    assert by_id(export(stores, DAYS[0]))['v7']['open'] is True\n   259\t    data = export(stores)\n   260\t    assert by_id(data)['v7']['open'] is False\n   261\t    assert not any(CLOSING in text or 'frozen on' in text for text in strings(data))\n   262\t\n   263\t\n   264\tdef test_8_replacements_and_sources_follow_the_day_and_missing_items_refuse(stores, tmp_path):\n   265\t    \"\"\"§6 test 8, §2 replacement and source rows: e3 is in force until its replacement on 08-25; e1's second source appears on 08-26;\n   266\t    a visible source with no item is refused.\"\"\"\n   267\t    early, late = by_id(export(stores, DAYS[0]))['v1'], by_id(export(stores))['v1']\n   268\t    assert [e['id'] for e in early['evidence']] == ['e1', 'e3']\n   269\t    assert [e['id'] for e in late['evidence']] == ['e1', 'e2', 'e4']\n   270\t    assert [s['day'] for s in early['evidence'][0]['sources']] == [DAYS[0]]\n   271\t    assert [s['day'] for s in late['evidence'][0]['sources']] == [DAYS[0], DAYS[2]]\n   272\t    short = make_items(tmp_path / 'short.sqlite', ids=('item-1', 'item-2'))\n   273\t    with pytest.raises(release.ReleaseRefused, match='item-3 is not in the items database'):\n   274\t        export((stores[0], short))\n   275\t\n   276\t\n   277\t# ---------- §6 tests 9, 10, 13, 15, 16: the package and the origin check\n   278\t\n   279\t\n   280\tdef test_9_package_files_hash_and_manifest(stores, tmp_path):\n   281\t    \"\"\"§1 check_package, §6 test 9.\"\"\"\n   282\t    out = tmp_path / 'release'\n   283\t    data = build_package(stores, out)\n   284\t    assert check(stores, out)['fields_compared'] > 0\n   285\t    variants = {\n   286\t        'foreign file': (lambda p: (p / 'notes.txt').write_text('x'), 'not exactly'),\n   287\t        'subdirectory': (lambda p: (p / 'extra').mkdir(), 'not exactly'),\n   288\t        'changed byte': (lambda p: (p / release.DATA_FILE).write_bytes((p / release.DATA_FILE).read_bytes().replace(b'Morningstar', b'Morningstan')), 'sha256'),\n   289\t        'manifest prose': (lambda p: (p / release.MANIFEST_FILE).write_text(json.dumps({**json.loads((p / release.MANIFEST_FILE).read_text()), 'note': 'About $390 billion'})), 'off the allow-list'),\n   290\t        'manifest day': (lambda p: (p / release.MANIFEST_FILE).write_text(json.dumps({**json.loads((p / release.MANIFEST_FILE).read_text()), 'as_of': DAYS[0]})), 'differs from the data'),\n   291\t    }\n   292\t    for name, (damage, reason) in variants.items():\n   293\t        copy = tmp_path / f'copy-{name.replace(\" \", \"-\")}'\n   294\t        shutil.copytree(out, copy)\n   295\t        damage(copy)\n   296\t        with pytest.raises(release.ReleaseRefused, match=reason):\n   297\t            check(stores, copy)\n   298\t    with pytest.raises(FileExistsError):\n   299\t        staged = release.stage(out)\n   300\t        release.write_package(data, staged)\n   301\t        release.publish(staged, out)\n   302\t    (tmp_path / '.other.staging-x').mkdir()            # another build's debris blocks nothing\n   303\t    assert build_package(stores, tmp_path / 'other')\n   304\t\n   305\t\n   306\tdef test_10_origin_check_derives_everything_from_the_store(stores, tmp_path):\n   307\t    \"\"\"§1 check_origins, §6 test 10: a forecast in a summary, a class swap, duplicates, another order and a future day are each\n   308\t    refused.\"\"\"\n   309\t    out = tmp_path / 'release'\n   310\t    data = build_package(stores, out)\n   311\t    cases = {}\n   312\t    forged = json.loads(json.dumps(data))\n   313\t    by_id(forged)['v1']['evidence'][1]['one_line'] = 'About $390 billion'\n   314\t    cases['forecast in a summary'] = (forged, 'evidence e2.one_line')\n   315\t    swapped = json.loads(json.dumps(data))\n   316\t    v5 = by_id(swapped)['v5']\n   317\t    for name in ('answers', 'answer'):\n   318\t        del v5[name]\n   319\t    v5.update({'class': 'number', 'forecast': release.FORECAST_UNAVAILABLE})\n   320\t    cases['class swap'] = (swapped, 'v5')\n   321\t    doubled = json.loads(json.dumps(data))\n   322\t    doubled['questions'].insert(1, doubled['questions'][0])\n   323\t    cases['duplicate question'] = (doubled, 'entries')\n   324\t    repeated = json.loads(json.dumps(data))\n   325\t    by_id(repeated)['v1']['evidence'].append(by_id(repeated)['v1']['evidence'][0])\n   326\t    cases['duplicate evidence'] = (repeated, 'entries')\n   327\t    future = json.loads(json.dumps(data))\n   328\t    future['as_of'] = '2026-08-27'\n   329\t    cases['future day'] = (future, 'not completed')\n   330\t    reordered = json.loads(json.dumps(data))\n   331\t    reordered['questions'][0], reordered['questions'][1] = reordered['questions'][1], reordered['questions'][0]\n   332\t    cases['reordered questions'] = (reordered, 'order')\n   333\t    swapped = json.loads(json.dumps(data))\n   334\t    pieces = by_id(swapped)['v1']['evidence']\n   335\t    pieces[0], pieces[1] = pieces[1], pieces[0]\n   336\t    cases['reordered evidence'] = (swapped, 'evidence e1')\n   337\t    for name, (changed, reason) in cases.items():\n   338\t        copy = tmp_path / f'copy-{name.replace(\" \", \"-\")}'\n   339\t        shutil.copytree(out, copy)\n   340\t        rewrite_data(copy, changed)\n   341\t        with pytest.raises(ValueError, match=reason):\n   342\t            check(stores, copy)\n   343\t\n   344\t\n   345\tdef test_10_legacy_store_without_completed_days_passes_one_date_rule(tmp_path):\n   346\t    \"\"\"§2 legacy row, §6 test 10: no completed days and no processing steps; an explicit day after the last judgement builds and the\n   347\t    same day passes a later check.\"\"\"\n   348\t    path = tmp_path / 'legacy.sqlite'\n   349\t    conn = store.open_db(str(path))\n   350\t    store.create_view(conn, view_id='v1', object_id='NVDA', object_kind='company', kind='asset', looks_at='Shipments', question='Will shipments begin?',\n   351\t                      due_day='2026-12-31', year='2026', rungs=[{'label': 'Yes', 'condition': 'Begin'}, {'label': 'No', 'condition': 'Do not begin'}],\n   352\t                      seq=1, input_id='item-1', created_at='2026-08-24T12:00:00Z')\n   353\t    judge(conn, 'v1', 1, 1, 'Shipments confirmed.')\n   354\t    conn.commit()\n   355\t    conn.close()\n   356\t    pair = (path, make_items(tmp_path / 'items.sqlite'))\n   357\t    build_package(pair, tmp_path / 'release', '2026-09-30')\n   358\t    assert check(pair, tmp_path / 'release')['questions'] == {'number': 0, 'event': 0, 'yes_no': 0}\n   359\t\n   360\t\n   361\tdef test_13_check_refuses_a_missing_item_even_when_the_package_omits_its_source(stores, tmp_path):\n   362\t    \"\"\"§6 test 13: the items copy lacks item-3; the package copy drops every item-3 source, keeping e2 with none, its hash refreshed.\n   363\t    A checker that silently skips a missing item accepts this pair; the release refuses it, naming the item.\"\"\"\n   364\t    out = tmp_path / 'release'\n   365\t    data = build_package(stores, out)\n   366\t    short = make_items(tmp_path / 'short.sqlite', ids=('item-1', 'item-2'))\n   367\t    copy = tmp_path / 'copy'\n   368\t    shutil.copytree(out, copy)\n   369\t    for piece in by_id(data)['v1']['evidence']:      # e1 loses its item-3 source, e2 keeps its record with no source: what a checker\n   370\t        piece['sources'] = [s for s in piece['sources'] if s['uri'] != 'https://example.com/article-3']   # that drops missing items expects\n   371\t    rewrite_data(copy, data)\n   372\t    with pytest.raises(release.ReleaseRefused, match='evidence e1: source item item-3 is not in the items database'):\n   373\t        check((stores[0], short), copy)\n   374\t\n   375\t\n   376\tdef test_15_symbolic_links_and_repeated_member_names_are_refused(stores, tmp_path):\n   377\t    \"\"\"§6 test 15: a symbolic link, a repeated member name and a named pipe are refused (the pipe without waiting).\"\"\"\n   378\t    out = tmp_path / 'release'\n   379\t    build_package(stores, out)\n   380\t    linked = tmp_path / 'linked'\n   381\t    shutil.copytree(out, linked)\n   382\t    (tmp_path / 'outside.json').write_bytes((linked / release.DATA_FILE).read_bytes())\n   383\t    (linked / release.DATA_FILE).unlink()\n   384\t    (linked / release.DATA_FILE).symlink_to(tmp_path / 'outside.json')\n   385\t    with pytest.raises(release.ReleaseRefused, match='not a regular file'):\n   386\t        check(stores, linked)\n   387\t    repeated = tmp_path / 'repeated'\n   388\t    shutil.copytree(out, repeated)\n   389\t    raw = (repeated / release.DATA_FILE).read_bytes()\n   390\t    genuine = b'\"one_line\":\"Morningstar estimates $361 billion of revenue for the year.\"'\n   391\t    assert raw.count(genuine) == 1\n   392\t    payload = raw.replace(genuine, b'\"one_line\":\"About $390 billion\",' + genuine)\n   393\t    (repeated / release.DATA_FILE).write_bytes(payload)\n   394\t    manifest = json.loads((repeated / release.MANIFEST_FILE).read_text())\n   395\t    manifest['data_sha256'] = hashlib.sha256(payload).hexdigest()\n   396\t    (repeated / release.MANIFEST_FILE).write_text(json.dumps(manifest))\n   397\t    with pytest.raises(release.ReleaseRefused, match='member name repeats'):\n   398\t        check(stores, repeated)\n   399\t    piped = tmp_path / 'piped'\n   400\t    shutil.copytree(out, piped)\n   401\t    (piped / release.DATA_FILE).unlink()\n   402\t    os.mkfifo(piped / release.DATA_FILE)\n   403\t    result = run('check', piped, '--ledger', stores[0], '--items', stores[1], timeout=30)      # a blocking open would hang here\n   404\t    assert result.returncode == 1 and 'not a regular file' in result.stderr\n   405\t\n","exit_code":0,"status":"completed"}}
