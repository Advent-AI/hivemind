{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba tests/test_release.py | sed -n '406,720p'\"","aggregated_output":"   406\t\n   407\tdef test_16_the_day_must_be_valid_and_canonical(stores):\n   408\t    \"\"\"§2 day rows, §6 test 16.\"\"\"\n   409\t    for day in ('2026-08-99', '20260825'):\n   410\t        with pytest.raises(release.ReleaseRefused):\n   411\t            export(stores, day)\n   412\t    assert [e['id'] for e in by_id(export(stores, '2026-08-25'))['v1']['evidence']] == ['e1', 'e4']\n   413\t    views_db = service.open_ledger(str(stores[0]))\n   414\t    try:\n   415\t        with pytest.raises(service.BoundNotCompleted):\n   416\t            release.resolve(views_db, '2026-08-27')\n   417\t    finally:\n   418\t        views_db.close()\n   419\t\n   420\t\n   421\tdef test_16_a_day_before_the_first_question_gives_an_empty_package(stores):\n   422\t    \"\"\"§2 row \"valid day before the first visible question\", §6 test 16: the store's questions open on 08-24.\"\"\"\n   423\t    data = export(stores, '2026-08-23')\n   424\t    assert data['as_of'] == '2026-08-23' and data['questions'] == []\n   425\t\n   426\t\n   427\t# ---------- §6 tests 11, 17, 18: the command\n   428\t\n   429\t\n   430\tdef test_11_command_end_to_end_with_check_statuses(stores, tmp_path):\n   431\t    \"\"\"§1 the builder and check, §6 test 11.\"\"\"\n   432\t    out = tmp_path / 'release'\n   433\t    built = run('build', '--ledger', stores[0], '--items', stores[1], '--out', out)\n   434\t    assert built.returncode == 0, built.stderr\n   435\t    report = out.with_name('release.report.json')\n   436\t    written = json.loads(report.read_text())\n   437\t    assert set(written) == REPORT_KEYS and written['as_of'] == DAYS[2] and written['export_seconds'] >= 0\n   438\t    occupied = run('check', out, '--ledger', stores[0], '--items', stores[1])\n   439\t    assert occupied.returncode == 2 and 'passes' in occupied.stdout\n   440\t    report.unlink()\n   441\t    fresh = run('check', out, '--ledger', stores[0], '--items', stores[1])\n   442\t    assert fresh.returncode == 0 and report.exists() and json.loads(report.read_text())['export_seconds'] is None\n   443\t\n   444\t\n   445\tdef test_17_database_error_leaves_nothing_and_a_retry_succeeds(stores, tmp_path):\n   446\t    \"\"\"§2 database-error row, §6 test 17.\"\"\"\n   447\t    broken = tmp_path / 'broken.sqlite'\n   448\t    sqlite3.connect(broken).execute('create table other (x)').connection.commit()\n   449\t    out = tmp_path / 'release'\n   450\t    failed = run('build', '--ledger', stores[0], '--items', broken, '--out', out)\n   451\t    assert failed.returncode == 1 and 'OperationalError' in failed.stderr\n   452\t    assert not out.exists() and not list(tmp_path.glob('.release.staging-*'))\n   453\t    assert run('build', '--ledger', stores[0], '--items', stores[1], '--out', out).returncode == 0\n   454\t\n   455\t\n   456\tdef test_18_no_report_ever_replaces_an_input(stores, tmp_path):\n   457\t    \"\"\"§1 publish_report, §6 test 18: the report name is the items file itself, a symbolic link to it, and (on a case-insensitive\n   458\t    volume) a case-variant name of it.\"\"\"\n   459\t    items_hash = hashlib.sha256(stores[1].read_bytes()).hexdigest()\n   460\t    same = tmp_path / 'same.report.json'\n   461\t    shutil.copyfile(stores[1], same)\n   462\t    refused = run('build', '--ledger', stores[0], '--items', same, '--out', tmp_path / 'same')\n   463\t    assert refused.returncode == 1 and hashlib.sha256(same.read_bytes()).hexdigest() == items_hash\n   464\t    out = tmp_path / 'pkg'\n   465\t    assert run('build', '--ledger', stores[0], '--items', stores[1], '--out', out).returncode == 0\n   466\t    report = tmp_path / 'pkg.report.json'\n   467\t    report.unlink()\n   468\t    report.symlink_to(stores[1])\n   469\t    linked = run('check', out, '--ledger', stores[0], '--items', stores[1])\n   470\t    assert linked.returncode == 2 and hashlib.sha256(stores[1].read_bytes()).hexdigest() == items_hash\n   471\t    report.unlink()\n   472\t    variant = tmp_path / 'PKG.REPORT.JSON'\n   473\t    shutil.copyfile(stores[1], variant)\n   474\t    if report.exists():                                  # a case-insensitive volume: the variant is the report name\n   475\t        checked = run('check', out, '--ledger', stores[0], '--items', variant)\n   476\t        assert checked.returncode == 2 and hashlib.sha256(variant.read_bytes()).hexdigest() == items_hash\n   477\t\n   478\t\n   479\t# ---------- §6 tests 12, 14, 19, 20, 21: scratch copies of the command (the AGENTS §4 mutation procedure)\n   480\t\n   481\t\n   482\tdef scratch(tmp_path, edits):\n   483\t    \"\"\"A copy of the package and the command with text edits applied; each edit must match once.\"\"\"\n   484\t    root = tmp_path / 'scratch'\n   485\t    shutil.copytree(ROOT / 'src' / 'hivemind', root / 'src' / 'hivemind', ignore=shutil.ignore_patterns('__pycache__'))\n   486\t    (root / 'scripts').mkdir()\n   487\t    shutil.copy(COMMAND, root / 'scripts' / 'release_build.py')\n   488\t    for relative, old, new in edits:\n   489\t        path = root / relative\n   490\t        text = path.read_text()\n   491\t        assert text.count(old) == 1, ('scratch anchor', relative, old)\n   492\t        path.write_text(text.replace(old, new))\n   493\t    return root / 'scripts' / 'release_build.py'\n   494\t\n   495\t\n   496\tdef pause_code(signals, name, indent='        '):\n   497\t    \"\"\"Code that signals it has paused and waits for the test's resume file, ending at `indent` for the line it precedes.\"\"\"\n   498\t    return (f\"__import__('pathlib').Path({str(signals / ('paused-' + name))!r}).touch()\\n\"\n   499\t            f\"{indent}while not __import__('pathlib').Path({str(signals / ('resume-' + name))!r}).exists(): __import__('time').sleep(0.02)\\n{indent}\")\n   500\t\n   501\t\n   502\tdef run_paused(command, args, signals, name, action):\n   503\t    process = subprocess.Popen([sys.executable, str(command), *map(str, args)], stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True,\n   504\t                               env={**os.environ, 'PYTHONDONTWRITEBYTECODE': '1'})\n   505\t    deadline = time.time() + 60\n   506\t    while not (signals / f'paused-{name}').exists():\n   507\t        assert process.poll() is None and time.time() < deadline, process.communicate()\n   508\t        time.sleep(0.02)\n   509\t    action()\n   510\t    (signals / f'resume-{name}').touch()\n   511\t    out, err = process.communicate(timeout=120)\n   512\t    return process.returncode, out, err\n   513\t\n   514\t\n   515\tFAULT = (\"evidence.append({'id': piece['evidence_id'], **{name: piece[name] for name in EVIDENCE_TEXT}, 'sources': sources})\",\n   516\t         \"evidence.append({'id': piece['evidence_id'], **{name: piece[name] for name in EVIDENCE_TEXT}, 'sources': sources, \"\n   517\t         \"'one_line': views_db.execute('select why_changed from judgements where view_id=? order by judgement_id desc limit 1', (view_id,)).fetchone()['why_changed'] if view_id == 'v1' else piece['one_line']})\")\n   518\tSTAGED_CHECK = (\"counts, data, size = release.check_package(staged, views_db, items_db, expected_as_of=bound)\", \"counts, size = release.check_export(data), 0\")\n   519\t\n   520\t\n   521\tdef test_12_the_staged_check_is_what_stops_a_writer_fault(stores, tmp_path):\n   522\t    \"\"\"§6 test 12: with a writer fault the command refuses and leaves nothing; with the fault and no staged check the bad package is\n   523\t    published, so the staged check is what prevents it.\"\"\"\n   524\t    faulty = scratch(tmp_path / 'a', [('src/hivemind/release.py', *FAULT)])\n   525\t    out = tmp_path / 'release'\n   526\t    refused = subprocess.run([sys.executable, str(faulty), 'build', '--ledger', stores[0], '--items', stores[1], '--out', out], capture_output=True, text=True)\n   527\t    assert refused.returncode == 1 and 'evidence e1.one_line' in refused.stderr\n   528\t    assert not out.exists() and not list(tmp_path.glob('.release.staging-*'))\n   529\t    unguarded = scratch(tmp_path / 'b', [('src/hivemind/release.py', *FAULT), ('scripts/release_build.py', *STAGED_CHECK)])\n   530\t    published = subprocess.run([sys.executable, str(unguarded), 'build', '--ledger', stores[0], '--items', stores[1], '--out', out], capture_output=True, text=True)\n   531\t    assert published.returncode == 0, published.stderr\n   532\t    assert V1_WHY in (out / release.DATA_FILE).read_text()\n   533\t\n   534\t\n   535\tdef test_14_publication_never_replaces_or_removes_another_folder(stores, tmp_path):\n   536\t    \"\"\"§1 publish, §2 rows on an occupied --out and two builds, §6 test 14.\"\"\"\n   537\t    data = export(stores)\n   538\t    out = tmp_path / 'release'\n   539\t    first, second = release.stage(out), release.stage(out)\n   540\t    release.write_package(data, first)\n   541\t    release.write_package(data, second)\n   542\t    release.publish(first, out)\n   543\t    with pytest.raises(FileExistsError):\n   544\t        release.publish(second, out)\n   545\t    assert second.exists() and check(stores, out)['fields_compared'] > 0\n   546\t    other = tmp_path / 'other'\n   547\t    staged = release.stage(other)\n   548\t    release.write_package(data, staged)\n   549\t    other.mkdir()\n   550\t    with pytest.raises(FileExistsError):\n   551\t        release.publish(staged, other)\n   552\t    assert other.is_dir() and not any(other.iterdir())\n   553\t    early = tmp_path / 'early'\n   554\t    early.mkdir()\n   555\t    assert run('build', '--ledger', stores[0], '--items', stores[1], '--out', early).returncode == 1 and early.is_dir()\n   556\t\n   557\t    signals = tmp_path / 'signals'\n   558\t    signals.mkdir()\n   559\t    paused = scratch(tmp_path / 'late', [('scripts/release_build.py', 'release.publish(staged, out)', pause_code(signals, 'publish') + 'release.publish(staged, out)')])\n   560\t    late = tmp_path / 'late-out'\n   561\t    holder = {}\n   562\t\n   563\t    def occupy():\n   564\t        late.mkdir()\n   565\t        holder['identity'] = (late.stat().st_dev, late.stat().st_ino)\n   566\t    code, _, err = run_paused(paused, ['build', '--ledger', stores[0], '--items', stores[1], '--out', late], signals, 'publish', occupy)\n   567\t    assert code == 1 and 'File exists' in err\n   568\t    assert (late.stat().st_dev, late.stat().st_ino) == holder['identity'] and not any(late.iterdir())\n   569\t    assert not list(tmp_path.glob('.late-out.staging-*'))\n   570\t\n   571\t    after = scratch(tmp_path / 'after', [('scripts/release_build.py', '        release.publish(staged, out)\\n',\n   572\t                                          f\"        release.publish(staged, out)\\n        {pause_code(signals, 'freed')}staged.mkdir(); (staged / 'marker').write_text('mine')\\n\")])\n   573\t    done = tmp_path / 'after-out'\n   574\t    code, _, err = run_paused(after, ['build', '--ledger', stores[0], '--items', stores[1], '--out', done], signals, 'freed', lambda: None)\n   575\t    assert code == 0, err\n   576\t    markers = list(tmp_path.glob('.after-out.staging-*/marker'))\n   577\t    assert len(markers) == 1 and markers[0].read_text() == 'mine'\n   578\t\n   579\t\n   580\tdef test_19_a_report_name_taken_during_the_build_survives(stores, tmp_path):\n   581\t    \"\"\"§2 report rows, §6 test 19.\"\"\"\n   582\t    signals = tmp_path / 'signals'\n   583\t    signals.mkdir()\n   584\t    paused = scratch(tmp_path, [('scripts/release_build.py', '    return write_report(summary, report)\\n\\n\\ndef check',\n   585\t                                 f\"    {pause_code(signals, 'report', indent='    ')}return write_report(summary, report)\\n\\n\\ndef check\")])\n   586\t    out = tmp_path / 'release'\n   587\t    marker = tmp_path / 'release.report.json'\n   588\t    code, _, err = run_paused(paused, ['build', '--ledger', stores[0], '--items', stores[1], '--out', out], signals, 'report', lambda: marker.write_text('occupied'))\n   589\t    assert code == 2 and 'report not written' in err and marker.read_text() == 'occupied'\n   590\t    checked = run('check', out, '--ledger', stores[0], '--items', stores[1])\n   591\t    assert checked.returncode == 2 and 'passes' in checked.stdout and marker.read_text() == 'occupied'\n   592\t\n   593\t\n   594\tdef test_20_a_temporary_file_left_after_the_link_still_counts_as_published(stores, tmp_path):\n   595\t    \"\"\"§1 publish_report, §6 test 20.\"\"\"\n   596\t    command = scratch(tmp_path, [('src/hivemind/release.py', '    try:\\n        os.unlink(temporary)\\n    except OSError:',\n   597\t                                  \"    try:\\n        raise PermissionError('test: cannot remove')\\n    except OSError:\")])\n   598\t    out = tmp_path / 'release'\n   599\t    result = subprocess.run([sys.executable, str(command), 'build', '--ledger', stores[0], '--items', stores[1], '--out', out], capture_output=True, text=True)\n   600\t    assert result.returncode == 0 and 'report published' in result.stderr\n   601\t    assert json.loads(out.with_name('release.report.json').read_text())['as_of'] == DAYS[2]\n   602\t    assert list(tmp_path.glob('.release.report.json.*'))\n   603\t\n   604\t\n   605\tdef test_21_check_that_cannot_write_its_report_exits_2(stores, tmp_path):\n   606\t    \"\"\"§1 check's statuses, §6 test 21.\"\"\"\n   607\t    out = tmp_path / 'release'\n   608\t    build_package(stores, out)\n   609\t    command = scratch(tmp_path, [('src/hivemind/release.py', \"    descriptor, temporary = tempfile.mkstemp(dir=path.parent, prefix=f'.{path.name}.')\",\n   610\t                                  \"    raise PermissionError('test: cannot create')\")])\n   611\t    result = subprocess.run([sys.executable, str(command), 'check', out, '--ledger', stores[0], '--items', stores[1]], capture_output=True, text=True)\n   612\t    assert result.returncode == 2 and 'passes' in result.stdout and 'cannot create' in result.stderr\n   613\t    printed = json.loads(result.stdout[result.stdout.index('\\n{') + 1:])    # the whole report, printed on its own lines, though not written\n   614\t    assert set(printed) == REPORT_KEYS and printed['ledger'] == str(stores[0]) and printed['items'] == str(stores[1])\n   615\t    assert printed['as_of'] == DAYS[2] and printed['counts']['questions'] == {'number': 5, 'event': 1, 'yes_no': 1}\n   616\t    unreadable = 'conditions not read as amounts: positions [1, 2, 3, 4, 5]'\n   617\t    assert printed['withheld_unresolved'] == [{'id': 'v3', 'reason': unreadable, 'has_key': True}, {'id': 'v4', 'reason': unreadable, 'has_key': False}]\n   618\t    assert printed['data_bytes'] > 0 and printed['export_seconds'] is None and printed['check_seconds'] >= 0\n   619\t\n   620\t\n   621\t# ---------- council 75: key visibility, text fields, store paths, the writer's own refusal\n   622\t\n   623\t\n   624\tdef test_22_a_key_written_after_the_day_does_not_reclassify_it(stores, tmp_path):\n   625\t    \"\"\"§1 question_class (council 75): a question with no key on 08-24 that gains an event key on 08-25 stays a number question in\n   626\t    the 08-24 package.\"\"\"\n   627\t    conn = store.open_db(str(stores[0]))\n   628\t    store.create_view(conn, view_id='v8', looks_at='NVIDIA buyback', question='How large a buyback will NVIDIA announce by 2027?',\n   629\t                      rungs=[{'label': 'Above the estimate', 'condition': 'At least $60 billion'}, {'label': 'Below the estimate', 'condition': 'Less than $60 billion'}],\n   630\t                      object_id='NVDA', object_kind='company', kind='asset', due_day='2027-01-31', year='2027', seq=1, input_id='item-1', created_at='2026-08-24T12:00:00Z')\n   631\t    judge(conn, 'v8', 1, 1, 'The estimate is about $70 billion.')\n   632\t    store.insert(conn, 'view_keys', view_id='v8', measure='event', scope='NVIDIA', scope_key='nvidia', period_start='2026-02-01', period_end='2027-01-31',\n   633\t                 basis='n/a', unit='n/a', event_type='other', seq=2, scope_source='model', key_version=1)\n   634\t    conn.commit()\n   635\t    conn.close()\n   636\t    early, late = by_id(export(stores, DAYS[0]))['v8'], by_id(export(stores, DAYS[1]))['v8']\n   637\t    assert (early['class'], early.get('forecast')) == ('number', release.FORECAST_UNAVAILABLE)\n   638\t    assert (late['class'], late['answer']) == ('event', 'Above the estimate')\n   639\t    out = tmp_path / 'early'\n   640\t    build_package(stores, out, DAYS[0])\n   641\t    assert by_id(release.read_data(out))['v8']['class'] == 'number'\n   642\t\n   643\t\n   644\tEVIDENCE_COLUMNS = {'one_line': 'one_line', 'quote': 'quote', 'tier': 'tier', 'speaker': 'speaker', 'original_who': 'original_who', 'original_day': 'original_day'}\n   645\tSOURCE_COLUMNS = {'title': ('items', 'title'), 'publisher': ('items', 'publisher'), 'uri': ('items', 'source_uri'), 'day': ('sources', 'publication_day')}\n   646\t\n   647\t\n   648\t@pytest.mark.parametrize('field', [*EVIDENCE_COLUMNS, *SOURCE_COLUMNS])\n   649\tdef test_23_every_evidence_and_source_text_field_must_be_text(tmp_path, field):\n   650\t    \"\"\"§1 check_export (council 75): a null in any of the ten text fields the closed set requires is refused, at the writer.\"\"\"\n   651\t    views, items = make_store(tmp_path / 'views.sqlite'), make_items(tmp_path / 'items.sqlite', ids=('item-1', 'item-2', 'item-3', 'item-9'))\n   652\t    conn = store.open_db(str(views))\n   653\t    values = dict(evidence_id='e7', quote='Officials said the rule would be published.', one_line='Officials expect the rule.', speaker='Publisher',\n   654\t                  original_who='Officials', original_day=DAYS[0], tier='party_statement', event_time=None, created_seq=1, created_from_input='item-9')\n   655\t    if field in EVIDENCE_COLUMNS:\n   656\t        values[EVIDENCE_COLUMNS[field]] = None\n   657\t    store.insert(conn, 'evidence', **values)\n   658\t    store.insert(conn, 'evidence_links', evidence_id='e7', view_id='v6', seq=1)\n   659\t    store.insert(conn, 'evidence_sources', evidence_id='e7', input_id='item-9', category='T1',\n   660\t                 publication_day=None if field == 'day' else DAYS[0], seq=1)\n   661\t    conn.commit()\n   662\t    conn.close()\n   663\t    if field in SOURCE_COLUMNS and SOURCE_COLUMNS[field][0] == 'items':\n   664\t        items_conn = sqlite3.connect(items)\n   665\t        items_conn.execute(f\"update items set {SOURCE_COLUMNS[field][1]} = null where input_id = 'item-9'\")\n   666\t        items_conn.commit()\n   667\t        items_conn.close()\n   668\t    with pytest.raises(release.ReleaseRefused, match=f'{field} is not text'):\n   669\t        export((views, items))\n   670\t\n   671\t\n   672\tdef test_24_a_store_path_with_uri_syntax_is_refused(stores, tmp_path):\n   673\t    \"\"\"§1 store_path (councils 75, 75b): a path holding a character the SQLite URI opener decodes is refused before anything is opened;\n   674\t    an accepted path is returned resolved, so the opener does not resolve a link a second time.\"\"\"\n   675\t    odd = tmp_path / 'a%2Db'\n   676\t    odd.mkdir()\n   677\t    shutil.copyfile(stores[0], odd / 'views.sqlite')\n   678\t    with pytest.raises(release.ReleaseRefused, match='URI syntax'):\n   679\t        release.store_path(odd / 'views.sqlite')\n   680\t    result = run('build', '--ledger', odd / 'views.sqlite', '--items', stores[1], '--out', tmp_path / 'release')\n   681\t    assert result.returncode == 1 and 'URI syntax' in result.stderr and not (tmp_path / 'release').exists()\n   682\t    assert release.store_path(stores[0]) == os.path.realpath(stores[0])\n   683\t    link = tmp_path / 'link.sqlite'\n   684\t    link.symlink_to(stores[0])\n   685\t    assert release.store_path(link) == os.path.realpath(stores[0])          # the opener is given the target, with nothing left to follow\n   686\t\n   687\t\n   688\tDRIVER = \"\"\"import sys\n   689\tsys.path.insert(0, sys.argv[1])\n   690\tfrom hivemind import release, service\n   691\tfrom hivemind.views import store\n   692\tviews, items = service.open_ledger(sys.argv[2]), store.open_read_only(sys.argv[3])\n   693\ttry:\n   694\t    data = release.release_export(views, items)\n   695\t    print('returned', sorted(data['questions'][0]))\n   696\texcept release.ReleaseRefused as error:\n   697\t    print('refused', error)\n   698\t\"\"\"\n   699\tWRITER_FAULT = (\"                record['forecast'] = FORECAST_UNAVAILABLE\\n            else:\\n                record['answers'] = labels\\n                record['answer'] = _answer(\",\n   700\t                \"                record['forecast'] = FORECAST_UNAVAILABLE\\n                record['condition'] = 'FY2027 revenue is at least $350 billion'\\n            else:\\n\"\n   701\t                \"                record['answers'] = labels\\n                record['answer'] = _answer(\")\n   702\tSELF_CHECK = (\"    check_export(data)\\n    return data\\n\", \"    return data\\n\")\n   703\t\n   704\t\n   705\tdef test_25_the_writer_refuses_its_own_off_list_field(stores, tmp_path):\n   706\t    \"\"\"§1 release_export (AGENTS §3, council 75), the mutation pair: a writer fault adding `condition` is refused inside\n   707\t    `release_export`; with the writer's own check removed, the off-list field is returned.\"\"\"\n   708\t    driver = tmp_path / 'driver.py'\n   709\t    driver.write_text(DRIVER)\n   710\t    for name, edits, expected in (('fault', [WRITER_FAULT], 'refused'), ('unchecked', [WRITER_FAULT, SELF_CHECK], 'returned')):\n   711\t        command = scratch(tmp_path / name, [('src/hivemind/release.py', *edit) for edit in edits])\n   712\t        result = subprocess.run([sys.executable, str(driver), str(command.parents[1] / 'src'), str(stores[0]), str(stores[1])], capture_output=True, text=True,\n   713\t                                env={**os.environ, 'PYTHONDONTWRITEBYTECODE': '1'})\n   714\t        assert result.stdout.startswith(expected), (name, result.stdout, result.stderr)\n   715\t        assert ('condition' in result.stdout) if name == 'unchecked' else ('off the allow-list' in result.stdout)\n","exit_code":0,"status":"completed"}}
