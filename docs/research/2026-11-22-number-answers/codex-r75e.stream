{"type":"item.started","item":{"id":"item_23","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"python3 -B -c 'import ast, json, sqlite3, sys, runpy\nfrom pathlib import Path\nfrom collections import Counter\nbase=Path(\\\"poc/data/release-check-2026-11-23e\\\")\nscript=Path(\\\"docs/research/2026-11-22-number-answers/release_check.py\\\")\nrc=runpy.run_path(str(script))\nrelease=rc['\\\\''release'\\\\'']\nresults=json.loads((base/'\\\\''results.json'\\\\'').read_text())\nfields=set(); texts=set(); created=set()\nfor name,(ledger,items) in rc['\\\\''STORES'\\\\''].items():\n p=base/name/'\\\\''package'\\\\''; s=results['\\\\''stores'\\\\''][name]; counts=rc['\\\\''check'\\\\''](ledger,items,p); assert counts==s['\\\\''counts'\\\\'']; assert (p/release.DATA_FILE).stat().st_size==s['\\\\''data_bytes'\\\\'']\n data=release.read_data(p); loc={k[1]:k[-1] for k in rc['\\\\''fields'\\\\''](data,json.loads((p/release.MANIFEST_FILE).read_text()))}\n diag=s['\\\\''diagnostics'\\\\'']; assert len(loc)==diag['\\\\''package_strings'\\\\'']\n for h in diag['\\\\''hits'\\\\'']:\n  assert h['\\\\''text'\\\\''] in loc[h['\\\\''field'\\\\'']]\n  if h['\\\\''kind'\\\\'']=='\\\\''rung label'\\\\'':\n   fields.add((name,h['\\\\''field'\\\\''])); texts.add(loc[h['\\\\''field'\\\\'']])\n  elif h['\\\\''text'\\\\'']=='\\\\''created'\\\\'': created.add(loc[h['\\\\''field'\\\\'']])\n  else: print('\\\\''unexpected diagnostic'\\\\'',h)\n print(name, counts, s['\\\\''data_bytes'\\\\''], s['\\\\''seconds'\\\\'']/s['\\\\''library_seconds'\\\\''], len(diag['\\\\''hits'\\\\'']), flush=True)\nprint('\\\\''distinct labels fields/texts, created texts'\\\\'',len(fields),len(texts),len(created))\nledger,items=rc['\\\\''STORES'\\\\'']['\\\\''old-1'\\\\'']\nfor name in ('\\\\''forged-summary'\\\\'','\\\\''forged-manifest'\\\\''):\n print(name,rc['\\\\''refused'\\\\''](ledger,items,base/'\\\\''old-1'\\\\''/name))\n'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.started","item":{"id":"item_24","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"sed -n '1,55p' src/hivemind/bundle.py; cat poc/data/release-check-2026-11-23e/old-1/package.report.json; rg -n '2026-11-23e|31 of 32 mutants' docs/research/2026-11-22-number-answers -g '\"'!*.stream'\"' | head -15\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_24","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"sed -n '1,55p' src/hivemind/bundle.py; cat poc/data/release-check-2026-11-23e/old-1/package.report.json; rg -n '2026-11-23e|31 of 32 mutants' docs/research/2026-11-22-number-answers -g '\"'!*.stream'\"' | head -15\"","aggregated_output":"\"\"\"One view in the shape the front end reads: the ladder, every judgement round with the model's reason and the\nevidence it cited, the evidence in force with tiers, speakers and sources, dependencies, replacements and the freeze\nswitches. The same shaping writes the mock's data file (scripts/mock_data.py) and answers POST /ideas, so the front\nend's adapter reads both. Read-only on every database. With `as_of`, rows written after that day are left out.\"\"\"\nimport json\nfrom contextlib import contextmanager\nfrom datetime import date\n\nfrom . import service\nfrom .views import store\n\n\n@contextmanager\ndef read_snapshot(*connections):\n    \"\"\"Pin each read connection for a complete envelope; preserve a caller's transaction.\"\"\"\n    owned = []\n    try:\n        for conn in connections:\n            if conn is not None and not conn.in_transaction:\n                conn.execute('begin')\n                owned.append(conn)\n        yield\n    finally:\n        for conn in reversed(owned):\n            conn.rollback()\n\n\ndef item_lookup(items_db):\n    \"\"\"input id → title, publisher and category of a stored item, from the items database (or the id alone when the\n    database is not given or does not hold it).\"\"\"\n    cache = {}\n\n    def item_of(input_id):\n        if input_id not in cache:\n            row = items_db.execute('select title, publisher, publisher_type, category, publication_day, source_uri from items where input_id=?', (input_id,)).fetchone() if items_db is not None else None\n            cache[input_id] = dict(row) if row else {'title': input_id, 'publisher': '', 'publisher_type': '', 'category': '', 'publication_day': '', 'source_uri': ''}\n        return cache[input_id]\n    return item_of\n\n\ndef _visible(views_db, seq, as_of):\n    return as_of is None or service.visible(views_db, seq, as_of)\n\n\ndef ladder_row(views_db, view_id):\n    \"\"\"The view's ladder as the new system's writer stored it (`clean_ladders`, written in the view's own call): the parsed\n    ladder; 'no table' for a store without that table (a legacy ledger); 'no row' when the store has the table and no row for the\n    view. A row that is not readable JSON with a ladder, or two rows for one view, is refused.\"\"\"\n    if not views_db.execute(\"select 1 from sqlite_master where type='table' and name='clean_ladders'\").fetchone():\n        return 'no table'\n    rows = views_db.execute('select checked_answer from clean_ladders where view_id=?', (view_id,)).fetchall()\n    if not rows:\n        return 'no row'\n    if len(rows) > 1:\n        raise ValueError(f'{view_id}: {len(rows)} ladder rows for one view')\n{\n \"ledger\": \"/Users/lchingen/hivemind/poc/data/comparison-2026-11-17/run/old-1/prod/views.sqlite\",\n \"items\": \"/Users/lchingen/hivemind/poc/data/comparison-2026-11-17/items-comparison.sqlite\",\n \"as_of\": \"2026-09-20\",\n \"counts\": {\n  \"questions\": {\n   \"number\": 19,\n   \"event\": 28,\n   \"yes_no\": 0\n  },\n  \"evidence\": 8251,\n  \"sources\": 8251,\n  \"fields_compared\": 91055\n },\n \"withheld_unresolved\": [],\n \"data_bytes\": 5788634,\n \"export_seconds\": 4.88,\n \"check_seconds\": 3.37\n}docs/research/2026-11-22-number-answers/RELEASE-CHECK-RESULT.md:12:- Output: `poc/data/release-check-2026-11-23e/`. The runs `release-check-2026-11-23/` to `-23d/` predate later fixes and are kept for\ndocs/research/2026-11-22-number-answers/round75e-brief.md:8:- `RELEASE-CHECK-RESULT.md`, rewritten from the new run `poc/data/release-check-2026-11-23e/results.json`.\n","exit_code":0,"status":"completed"}}
