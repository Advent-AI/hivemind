{"type":"item.started","item":{"id":"item_10","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"python3 -B -c '\nimport copy,gate as g,calc_check as c,render_v13 as r\ndef checked(x,f,p):\n    s=r.v13_schema(list(f['\\\\''members'\\\\'']),list(p),[])\n    wire=r.strict(x,s)\n    assert not r.model.check_schema(wire,s)\n    clean=r.without_nulls(wire)\n    report=c.check(f,p,clean)\n    assert not report['\\\\''errors'\\\\''],report\n    return clean,report\ndef mapfig(x):\n    return {f['\\\\''id'\\\\'']:f for f in x['\\\\''figures'\\\\'']}\ndef snapshot(x,report,i):\n    answer=x['\\\\''answers'\\\\''][i]\n    return dict(shape=answer['\\\\''shape'\\\\''], rung=answer.get('\\\\''rung'\\\\''), outcome=report['\\\\''published'\\\\''].get(answer['\\\\''view_id'\\\\'']),\n                sources=c.member_sources(answer,mapfig(x)))\ndef changed(x,i,prev):\n    return c.changed(prev,x['\\\\''answers'\\\\''][i],mapfig(x))\nlast,out=checked(g.r1('\\\\''c'\\\\''),g.R1_FAMILY,g.R1_PASSAGES)\nprev=snapshot(last,out,0)\nalt=copy.deepcopy(last)\nnext(f for f in alt['\\\\''figures'\\\\''] if f['\\\\''id'\\\\'']=='\\\\''q3f'\\\\'')['\\\\''rests_on'\\\\'']=['\\\\''g3'\\\\'','\\\\''beat'\\\\'']\ncurrent,rep=checked(alt,g.R1_FAMILY,g.R1_PASSAGES)\nnew=snapshot(current,rep,0)\ndiff=changed(current,0,prev)\nassert diff[0] and '\\\\''|relative'\\\\'' in diff[1] and new['\\\\''outcome'\\\\'']==prev['\\\\''outcome'\\\\''],diff\nassert changed(last,0,prev)==(False,'\\\\''unchanged'\\\\'')\nprint('\\\\''component drop with unchanged outcome:'\\\\'',diff)\nold,old_rep=checked(g.r4(),g.R4_FAMILY,g.R4_PASSAGES)\nunavailable=copy.deepcopy(old)\na=unavailable['\\\\''answers'\\\\''][0]\na.pop('\\\\''rung'\\\\'')\na.pop('\\\\''outcome'\\\\'')\na.update(shape='\\\\''unresolved'\\\\'',why='\\\\''No Vera volume stated.'\\\\'')\nunavailable,new_rep=checked(unavailable,g.R4_FAMILY,g.R4_PASSAGES)\na0=snapshot(old,old_rep,0)\na1=snapshot(unavailable,new_rep,0)\nexpected=[(True,'\\\\''now unresolved'\\\\''),(True,'\\\\''now a forecast'\\\\''),(False,'\\\\''still unresolved'\\\\'')]\nactual=[changed(unavailable,0,a0),changed(old,0,a1),changed(unavailable,0,a1)]\nassert actual==expected,actual\nprint('\\\\''availability transitions'\\\\'',actual)\n'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
