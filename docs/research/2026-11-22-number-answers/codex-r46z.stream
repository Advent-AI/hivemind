_signs)\n   382\t        have = DIRECTION.get(fig.get('bound'))\n   383\t        if want == 'mixed':\n   384\t            errors.append(('C2', f'{fig[\"id\"]}: its inputs are bounded on opposite sides, so its value is unbounded; state it as an estimate'))\n   385\t        elif want is not None and have != want:\n   386\t            errors.append(('C2', f'{fig[\"id\"]}: its inputs make it a {want} bound, but it is declared {fig.get(\"bound\") or \"a point\"}'))\n   387\t        elif want is None and fig.get('bound'):\n   388\t            errors.append(('C2', f'{fig[\"id\"]}: its inputs are points, but it is declared a bound ({fig[\"bound\"]})'))\n   389\t\n   390\t    # C8 operand compatibility\n   391\t    for fig in figs.values():\n   392\t        if fig['kind'] != 'computed' or fig.get('operation') not in OPERATIONS:\n   393\t            continue\n   394\t        ins = [figs[i] for i in fig['inputs'] if i in figs]\n   395\t        op, rel, out = fig['operation'], fig.get('relation'), fig['what']\n   396\t        differing = [i['id'] for i in ins if i['unit'] not in ('%', 'x') and\n   397\t                     (i['what']['population'], i['what']['scope'], i['what']['period'], i['what']['measure']) !=\n   398\t                     (out['population'], out['scope'], out['period'], out['measure'])]\n   399\t        if op in ('sum', 'difference'):\n   400\t            money = [i for i in ins if i['unit'] not in ('%', 'x')]\n   401\t            same_qty = all((i['what']['population'], i['what']['measure'], i['what']['scope']) ==\n   402\t                           (out['population'], out['measure'], out['scope']) for i in money)\n   403\t            if rel == 'time_aggregation':\n   443\t            if not bridge or bridge['kind'] != 'estimate' or set(bridge.get('converts', [])) != set(differing):\n   444\t                errors.append(('C8', f'{fig[\"id\"]}: converts {\", \".join(differing)} to {out[\"population\"]} {out[\"scope\"]} {out[\"period\"]} '\n   445\t        