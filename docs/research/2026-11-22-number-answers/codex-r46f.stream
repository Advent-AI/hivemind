sensus base proof'\\\\'',c.check(f,g.G_PASSAGES,calc))\nr4=g.r4()\nnext(x for x in r4['\\\\''figures'\\\\''] if x['\\\\''id'\\\\'']=='\\\\''cpu28'\\\\'')['\\\\''bound'\\\\'']='\\\\''<'\\\\''\nprint('\\\\''reverse bound proof'\\\\'',c.check(g.R4_FAMILY,g.R4_PASSAGES,r4))\n'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
