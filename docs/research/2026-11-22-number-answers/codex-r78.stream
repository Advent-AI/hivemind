{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc 'nl -ba docs/research/2026-11-22-number-answers/release_screen_prepare.py | head -230'","aggregated_output":"     1\t\"\"\"Prepare the $0 screen check of RELEASE-PAGE.md §6: build the format-2 pages with the real command, and freeze screen-expected.json\n     2\tfrom the accepted slice-1 packages before the first screen run.\n     3\t\n     4\t    python3 docs/research/2026-11-22-number-answers/release_screen_prepare.py <new run folder>\n     5\t\n     6\tThe expected file is written from the data of `poc/data/release-check-2026-11-23g/` (the packages council 75g accepted), not from the\n     7\tpages under test, and its sha256 is printed for the result.\"\"\"\n     8\timport hashlib\n     9\timport json\n    10\timport shutil\n    11\timport subprocess\n    12\timport sys\n    13\tfrom pathlib import Path\n    14\t\n    15\tREPO = Path(__file__).resolve().parents[3]\n    16\tsys.path.insert(0, str(REPO / 'src'))\n    17\tsys.path.insert(0, str(REPO / 'tests'))\n    18\tfrom hivemind import release, service  # noqa: E402\n    19\tfrom hivemind.views import store  # noqa: E402\n    20\t\n    21\tACCEPTED = REPO / 'poc/data/release-check-2026-11-23g'\n    22\tCOMPARISON_ITEMS = REPO / 'poc/data/comparison-2026-11-17/items-comparison.sqlite'\n    23\tOLD = {name: REPO / f'poc/data/comparison-2026-11-17/run/{name}/prod/views.sqlite' for name in ('old-1', 'old-3')}\n    24\tDOT = f' {chr(0xb7)} '\n    25\tESCAPE_QUOTE = '</script><img src=x onerror=alert(1)> & a line' + chr(0x2028) + 'break'\n    26\t\n    27\t\n    28\tdef counts_line(questions):\n    29\t    n = {kind: sum(q['class'] == kind for q in questions) for kind in ('number', 'event', 'yes_no')}\n    30\t    return f\"{n['number']} number questions{DOT}{n['event']} event questions{DOT}{n['yes_no']} Yes/No questions\"\n    31\t\n    32\t\n    33\tdef kept(texts):\n    34\t    \"\"\"The page's reading rule: each text trimmed, empty texts dropped.\"\"\"\n    35\t    return [t.strip() for t in texts if t and t.strip()]\n    36\t\n    37\t\n    38\tdef card_top(q):\n    39\t    n = len(q['evidence'])\n    40\t    status = 'Open' if q['open'] else 'Closed'\n    41\t    shown = q['forecast'] if q['class'] == 'number' else ('Not yet answered' if q['answer'] is None else f\"Answer: {q['answer']}\")\n    42\t    count = 'No evidence in force' if n == 0 else f\"{n} {'piece' if n == 1 else 'pieces'} of evidence\"\n    43\t    return kept([q['question'], status, shown, count])\n    44\t\n    45\t\n    46\tdef group(e):\n    47\t    day = f\", {e['original_day']}\" if e['original_day'] else ''           # the page adds the day only when there is one\n    48\t    texts = [e['one_line'], e['quote'], f\"{e['tier']}{DOT}{e['speaker']}{DOT}original: {e['original_who']}{day}\"]\n    49\t    for s in e['sources']:\n    50\t        texts += [s['title'], s['publisher'], s['day'], s['uri']]\n    51\t    return kept(texts)\n    52\t\n    53\t\n    54\tdef frozen_page(data, checked):\n    55\t    header = kept(['Hivemind release', f\"As of {data['as_of']}\", counts_line(data['questions'])])\n    56\t    cards = [{'id': q['id'], 'top': card_top(q), 'groups': []} for q in data['questions']]\n    57\t    collapsed = {'header': header, 'cards': cards, 'other': [], 'clipped': [], 'unreadable': []}\n    58\t    expanded = json.loads(json.dumps(collapsed))\n    59\t    target = next(c for c in expanded['cards'] if c['id'] == checked)\n    60\t    target['groups'] = [group(e) for e in next(q for q in data['questions'] if q['id'] == checked)['evidence']]\n    61\t    return {'count': len(data['questions']), 'collapsed': collapsed, 'expanded': expanded}\n    62\t\n    63\t\n    64\tdef build(ledger, items, out, as_of=None):\n    65\t    args = [sys.executable, str(REPO / 'scripts/release_build.py'), 'build', '--ledger', str(ledger), '--items', str(items), '--out', str(out)]\n    66\t    result = subprocess.run(args + (['--as-of', as_of] if as_of else []), capture_output=True, text=True, env={'PATH': '/usr/bin:/bin', 'PYTHONDONTWRITEBYTECODE': '1'})\n    67\t    if result.returncode:\n    68\t        raise SystemExit(f'build {out}: {result.stderr}')\n    69\t\n    70\t\n    71\tdef main(run):\n    72\t    run = Path(run).absolute()\n    73\t    run.mkdir()\n    74\t    build(OLD['old-1'], COMPARISON_ITEMS, run / 'old-1')\n    75\t    build(OLD['old-3'], COMPARISON_ITEMS, run / 'old-3-0825', '2026-08-25')\n    76\t    build(OLD['old-1'], COMPARISON_ITEMS, run / 'old-1-0828', '2026-08-28')\n    77\t    import test_release as fixture                                  # the test suite's fixture store, plus one hostile quote\n    78\t    scratch = run / '.escape-stores'\n    79\t    scratch.mkdir()\n    80\t    views, items = fixture.make_store(scratch / 'views.sqlite'), fixture.make_items(scratch / 'items.sqlite')\n    81\t    conn = store.open_db(str(views))\n    82\t    fixture.evidence(conn, 'e9', 'v6', 1, 'A hostile quote, shown as text.', ESCAPE_QUOTE, [('item-1', 1)])\n    83\t    conn.commit()\n    84\t    conn.close()\n    85\t    build(views, items, run / 'escape')\n    86\t    data = lambda folder: json.loads((ACCEPTED / folder / 'release-data.json').read_text())\n    87\t    expected = {\n    88\t        'accepted': str(ACCEPTED),\n    89\t        'pages': {'old-1/v8': frozen_page(data('old-1/package'), 'v8'),\n    90\t                  'old-3/v36@2026-08-25': frozen_page(data('old-3/package-2026-08-25'), 'v36'),\n    91\t                  'old-1/v10@2026-08-28': frozen_page(data('old-1/package-2026-08-28'), 'v10')},\n    92\t        'morningstar_quote': next(e['quote'] for q in data('old-1/package')['questions'] for e in q['evidence'] if e['id'] == 'e2295'),\n    93\t        'escape': {'question': 'v6', 'quote': ESCAPE_QUOTE.strip(), 'count': 7},\n    94\t    }\n    95\t    path = run / 'screen-expected.json'\n    96\t    path.write_text(json.dumps(expected, ensure_ascii=False, indent=1))\n    97\t    print('screen-expected.json sha256', hashlib.sha256(path.read_bytes()).hexdigest())\n    98\t\n    99\t\n   100\tif __name__ == '__main__':\n   101\t    main(sys.argv[1])\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"rg -n 'quote|one_line|groups|summary|contrast|clipped|font|390|dark|expected|budget' docs/research/2026-11-22-number-answers/release_screen.mjs\"","aggregated_output":"3: * opened from file://, every visible text of each checked card compared with the frozen list in screen-expected.json.\n5: *   node release_screen.mjs <run folder> <screen-expected.json>\n17:const [runFolder, expectedPath, profileParent] = process.argv.slice(2).map((p) => path.resolve(p));   // file:// needs an absolute path\n18:const expectedBytes = fs.readFileSync(expectedPath);\n19:const expected = JSON.parse(expectedBytes);\n21:const results = { expected_sha256: createHash('sha256').update(expectedBytes).digest('hex'), pages: {}, failures: [] };\n85:  const page = { header: [], cards: [], other: [], clipped: [], unreadable: [] };\n89:  const contrast = (e) => { const f = lum(rgb(getComputedStyle(e).color)), b = lum(background(e)); return (Math.max(f, b) + 0.05) / (Math.min(f, b) + 0.05); };\n99:      page.clipped.push(text.slice(0, 80));\n101:    if (contrast(owner) < 4.5) page.unreadable.push(text.slice(0, 80));\n106:    if (!entry) { entry = { id: card.dataset.id, top: [], groups: [] }; byId.set(card.dataset.id, entry); page.cards.push(entry); }\n110:    while (entry.groups.length <= index) entry.groups.push([]);\n111:    entry.groups[index].push(text);\n113:  for (const entry of page.cards) entry.groups = entry.groups.filter((g) => g.length);\n165:  return { outcome, other: expanded.other, card_top: card ? card.top : null, card_groups: card ? card.groups.length : null };\n169:const PHONE = { width: 390, height: 844, deviceScaleFactor: 2, mobile: true };\n170:const DARK = [{ name: 'prefers-color-scheme', value: 'dark' }];\n174:  const v8 = expected.pages['old-1/v8'];\n197:    phone.dark_background = await s.evaluate(`getComputedStyle(document.body).backgroundColor`);\n199:      const quote = [...document.querySelectorAll('.evidence-quote')].find((q) => q.textContent === ${JSON.stringify(expected.morningstar_quote)});\n200:      if (!quote) return null;\n201:      quote.scrollIntoView();\n202:      const range = document.createRange(); range.selectNodeContents(quote);\n203:      const box = quote.getBoundingClientRect();\n206:    if (phone.scroll_width > 390) fail('old-1 phone', `scroll width ${phone.scroll_width}`);\n207:    if (phone.dark_background !== 'rgb(15, 20, 13)') fail('old-1 dark', `background ${phone.dark_background}`);\n208:    if (!phone.morningstar || phone.morningstar.lines < 2 || phone.morningstar.left < 0 || phone.morningstar.right > 390) fail('old-1 phone', `Morningstar quote ${JSON.stringify(phone.morningstar)}`);\n209:    phone.signals = clean('old-1 phone dark', s, old1);\n211:    results.pages['old-1 phone dark'] = phone;\n214:    const frozen = expected.pages[key];\n224:    const s = await open(port, file, expected.escape.count);\n225:    await s.evaluate(`${TOGGLE}(${JSON.stringify(expected.escape.question)}, true)`);\n227:      quote_visible: await s.evaluate(`(() => { const visible = ${VISIBLE};\n228:        return [...document.querySelectorAll('.evidence-quote')].some((q) => q.textContent === ${JSON.stringify(expected.escape.quote)} && visible(q)); })()`),\n231:    if (!page.quote_visible) fail('escape', 'the quote is not shown, visibly, as text');\n244:    results.failures.splice(before);                  // a negative page's own failures are its expected outcome\n274:  await negative('clipped', (x) => x.replace(\"item.appendChild(el('blockquote','evidence-quote',e.quote));\",\n275:    \"var bq=el('blockquote','evidence-quote',e.quote);bq.style.whiteSpace='nowrap';bq.style.overflow='hidden';bq.style.textOverflow='ellipsis';item.appendChild(bq);\"),\n279:    return { caught: page.clipped.length > 0, clipped: page.clipped.length };\n281:  await negative('clipping-wrapper', (x) => x.replace(\"item.appendChild(el('blockquote','evidence-quote',e.quote));\",\n282:    \"var wrap=el('div','quote-wrap');wrap.style.contain='paint';wrap.style.height='1.5em';wrap.appendChild(el('blockquote','evidence-quote',e.quote));item.appendChild(wrap);\"),\n286:    return { caught: page.clipped.length > 0, clipped: page.clipped.length };\n293:    return { caught: page.unreadable.includes('Forecast unavailable') && around.body === 'rgb(245, 242, 235)', unreadable: page.unreadable.length, ...around };   // a light page around the dark marker\n304:console.log(JSON.stringify({ failures: results.failures, seconds: results.pages['old-1']?.seconds, expected_sha256: results.expected_sha256 }, null, 1));\n","exit_code":0,"status":"completed"}}
