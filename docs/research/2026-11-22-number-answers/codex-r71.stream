swith('\\\\''well over '\\\\'') and not f['\\\\''qualifier'\\\\'']:f.update(qualifier='\\\\''over'\\\\'',quote_number=q.removeprefix('\\\\''well over '\\\\''))\n print(n,'\\\\''->'\\\\'',ck(b,row))\nprint('\\\\''readers'\\\\'')\ncod=read('\\\\''reading/codex.json'\\\\'');cl=read('\\\\''reading/claude.json'\\\\'');third=read('\\\\''reading/third.json'\\\\'');combined=read('\\\\''reading/readings.json'\\\\'')['\\\\''packets'\\\\'']\ns=pathlib.Path('\\\\''packets.md'\\\\'').read_text()\nfor pid,part in zip(re.findall('\\\\''\"'^## (P[0-9]+)'\"'\\\\'',s,re.M),re.split('\\\\''\"'^## P[0-9]+'\"'\\\\'',s,flags=re.M)[1:]):\n cards=[json.loads(x) for x in re.findall('\\\\''\"'^  Card K[12]: (.*)$'\"'\\\\'',part,re.M)]\n arr=[]\n for c in cards:\n  norm=lambda t:re.sub(r'\\\\''F\\\\d+'\\\\'','\\\\''F'\\\\'',t)\n  matches=[(b['\\\\''unit'\\\\''],b['\\\\''arm'\\\\''],b['\\\\''draw'\\\\'']) for b in a if b.get('\\\\''data'\\\\'') for ac in b['\\\\''data'\\\\'']['\\\\''answers'\\\\''] if ac['\\\\''view_id'\\\\'']==c['\\\\''view_id'\\\\''] and norm(ac['\\\\''reasons'\\\\''] or '\\\\'''\\\\'')==norm(c['\\\\''reasons'\\\\''] or '\\\\'''\\\\'')];arr.append(matches)\n vals=[]\n for k in cod[pid]:\n  assert cod[pid][k]==combined[pid][k]['\\\\''A'\\\\''] and cl[pid][k]==combined[pid][k]['\\\\''B'\\\\'']\n  vals.append('\\\\'''\\\\''.join((third.get(pid,{}).get(k,{}).get(q) or cod[pid][k][q])['\\\\''answer'\\\\''][0] for q in ('\\\\''usable'\\\\'','\\\\''contradiction'\\\\'','\\\\''internal_reference'\\\\'','\\\\''deciding_gap'\\\\'')))\n print(pid,arr,vals)\n'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
