 source, AT_FDCWD, target, RENAME_NOREPLACE)\n   573\t    assert second.exists() and check(stores, out)['fields_compared'] > 0\n   574\t    other = tmp_path / 'other'\n   575\t    staged = release.stage(other)\n   576\t    release.write_package(data, staged)\n   577\t    other.mkdir()\n   578\t    with pytest.raises(FileExistsError):\n   579\t        release.publish(staged, other)\n   580\t    assert other.is_dir() and not any(other.iterdir())\n   581\t    early = tmp_path / 'early'\n   582\t    early.mkdir()\n   583\t    assert run('build', '--ledger', stores[0], '--items', stores[1], '--out', early).returncode == 1 and early.is_dir()\n   584\t\n   585\t    signals = tmp_path / 'signals'\n   586\t    signals.mkdir()\n   587\t    paused = scratch(tmp_path / 'late', [('scripts/release_build.py', 'release.publish(staged, out)', pause_code(signals, 'publish') + 'release.publish(staged, out)')])\n   588\t    late = tmp_path / 'late-out'\n   589\t    holder = {}\n   590\t\n   591\t    def occupy():\n   592\t        late.mkdir()\n   593\t        holder['identity'] = (late.stat().st_dev, late.stat().st_ino)\n   594\t    code, _, err = run_paused(paused, ['build', '--ledger', stores[0], '--items', stores[1], '--out', late], signals, 'publish', occupy)\n   595\t    assert code == 1 and f\"refused: FileExistsError: [Errno 17] File exists: '{late}'\" in err.splitlines()\n   596\t    assert (late.stat().st_dev, late.stat().st_ino) == holder['identity'] and not any(late.iterdir())\n   597\t    assert not list(tmp_path.glob('.late-out.staging-*'))\n   598\t\n   599\t    after = scratch(tmp_path / 'after', [('scripts/release_build.py', '        release.publish(staged, out)\\n',\n   600\t                                          f\"        release.publish(staged, out)\\n        {pause_code(signals, 'freed')}staged.mkdir(); (staged / 'marker').write_text('mine')\\n\")])\n   601\t    done = tmp_path / 'after-out'\n   602\t    code, _, err = run_paused(after, ['build', '--ledger', stores[0], '--items', stores[1], '--out', done], signals, 'freed', lambda: None)\n   603\t    assert code == 0, err\n   604\t    markers = list(tmp_path.glob('.after-out.staging-*/marker'))\n   605\t    assert len(markers) == 1 and markers[0].read_text() == 'mine'\n   606\t\n   607\t\n   608\tdef test_19_a_report_name_taken_during_the_build_survives(stores, tmp_path):\n   609\t    \"\"\"§2 report rows, §6 test 19.\"\"\"\n   610\t    signals = tmp_path / 'signals'\n   611\t    signals.mkdir()\n   612\t    paused = scratch(tmp_path, [('scripts/release_build.py', '    return write_report(summary, report)\\n\\n\\ndef check',\n   613\t                                 f\"    {pause_code(signals, 'report', indent='    ')}return write_report(summary, report)\\n\\n\\ndef check\")])\n   614\t    out = tmp_path / 'release'\n   615\t    marker = tmp_path / 'release.report.json'\n   616\t    code, _, err = run_paused(paused, ['build', '--ledger', stores[0], '--items', stores[1], '--out', out], signals, 'report', lambda: marker.write_text('occupied'))\n{\"format\":\"hivemind-release/2\",\"allow_list\":\"release-allow-list/1\",\"as_of\":\"2026-09-20\",\"data_sha256\":\"9060b401f6c65b9876be94895736988d299ab259114a8fad8e431365b7afa72d\",\"page_sha256\":\"48d3aabeb69e19d710a86991e3c4784562911f2a099f595be9d316c5cc559013\"}{\"format\":\"hivemind-release/2\",\"allow_list\":\"release-allow-list/1\",\"as_of\":\"2026-09-20\",\"data_sha256\":\"9060b401f6c65b9876be94895736988d299ab259114a8fad8e431365b7afa72d\",\"page_sha256\":\"c902e42e7154012fe7cf6df94765a74b0ce8131917bf06696922f0b120615cea\"}","exit_code":0,"status":"completed"}}
