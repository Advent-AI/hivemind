ound\": \"rgb(15, 20, 13)\",\n    50\t   \"morningstar\": {\n    51\t    \"lines\": 5,\n    52\t    \"left\": 36,\n    53\t    \"right\": 374\n    54\t   },\n    55\t   \"signals\": {\n    56\t    \"requests\": [\n    57\t     \"file:///Users/lchingen/hivemind/poc/data/release-screen-2026-11-23b/old-1/index.html\"\n    58\t    ],\n    59\t    \"errors\": []\n    60\t   }\n    61\t  },\n    62\t  \"old-3/v36@2026-08-25\": {\n    63\t   \"check\": {\n    64\t    \"outcome\": {\n    65\t     \"collapsed\": true,\n    66\t     \"expanded\": true,\n    67\t     \"reopened\": true\n    68\t    },\n    69\t    \"other\": [],\n    70\t    \"card_top\": [\n    71\t     \"Will NVIDIA begin shipping Rubin Ultra by December 31, 2027?\",\n    72\t     \"Open\",\n    73\t     \"Answer: Yes\",\n    74\t     \"1 piece of evidence\"\n    75\t    ],\n    76\t    \"card_groups\": 1\n    77\t   },\n    78\t   \"signals\": {\n    79\t    \"requests\": [\n    80\t     \"file:///Users/lchingen/hivemind/poc/data/release-screen-2026-11-23b/old-3-0825/index.html\"\n    81\t    ],\n    82\t    \"errors\": []\n    83\t   }\n    84\t  },\n    85\t  \"old-1/v10@2026-08-28\": {\n    86\t   \"check\": {\n    87\t    \"outcome\": {\n    88\t     \"collapsed\": true,\n    89\t     \"expanded\": true,\n    90\t     \"reopened\": true\n    91\t    },\n    92\t    \"other\": [],\n    93\t    \"card_top\": [\n    94\t     \"Will NVIDIA complete an investment in Firmus Technologies’ preference shares by December 31, 2026?\",\n    95\t     \"Open\",\n    96\t     \"Answer: Yes\",\n    97\t     \"1 piece of evidence\"\n    98\t    ],\n    99\t    \"card_groups\": 1\n   100\t   },\n   101\t   \"signals\": {\n   102\t    \"requests\": [\n   103\t     \"file:///Users/lchingen/hivemind/poc/data/release-screen-2026-11-23b/old-1-0828/index.html\"\n   104\t    ],\n   105\t    \"errors\": []\n   106\t   }\n   107\t  },\n   108\t  \"escape\": {\n   109\t   \"quote_visible\": true,\n   110\t   \"images\": 0,\n   111\t   \"signals\": {\n   112\t    \"requests\": [\n   113\t     \"file:///Users/lchingen/hivemind/poc/data/release-screen-2026-11-23b/escape/index.html\"\n   114\t    ],\n   115\t    \"errors\": []\n   116\t   }\n   117\t  },\n   118\t  \"mutant-fetch\": {\n   119\t   \"caught\": true,\n   120\t   \"rendered\": true,\n   121\t   \"named\": true\n   122\t  },\n   123\t  \"mutant-line-inside\": {\n   124\t   \"caught\": true,\n   125\t   \"card_top\": [\n   126\t    \"How much Data Center segment revenue will NVIDIA report for FY2027?\",\n   127\t    \"Open\",\n   128\t    \"Forecast unavailable\",\n   129\t    \"Forecast: $361 billion\",\n   130\t    \"1284 pieces of evidence\"\n   131\t   ]\n   132\t  },\n   133\t  \"mutant-line-beside\": {\n   134\t   \"caught\": true,\n   135\t   \"other\": [\n   136\t    \"Forecast: $361 billion\"\n   137\t   ]\n   138\t  },\n   139\t  \"mutant-transparent\": {\n   140\t   \"caught\": true,\n   141\t   \"seconds\": null,\n   142\t   \"cards\": 47,\n   143\t   \"visible\": 0,\n   144\t   \"fallback\": false,\n   145\t   \"errors\": 0\n   146\t  },\n   147\t  \"mutant-clipped\": {\n   148\t   \"caught\": true,\n   149\t   \"clipped\": 1220\n   150\t  },\n   151\t  \"mutant-clipping-wrapper\": {\n   152\t   \"caught\": true,\n   153\t   \"clipped\": 1284\n   154\t  },\n   155\t  \"mutant-own-background\": {\n   156\t   \"caught\": true,\n   157\t   \"unreadable\": 19,\n   158\t   \"body\": \"rgb(245, 242, 235)\",\n   159\t   \"card\": \"rgba(0, 0, 0, 0)\"\n   160\t  },\n   161\t  \"mutant-unreadable-marker\": {\n   162\t   \"caught\": true,\n   163\t   \"unreadable\": 19\n   164\t  }\n   165\t },\n   166\t \"failures\": []\n   167\t}    46\tdef group(e):\n    47\t    day = f\", {e['original_day']}\" if e['original_day'] else ''           # the page adds the day only when there is one\n    48\t    texts = [e['one_line'], e['quote'], f\"{e['tier']}{DOT}{e['speaker']}{DOT}original: {e['original_who']}{day}\"]\n    49\t    for s in e['sources']:\n    50\t        texts += [s['title'], s['publisher'], s['day'], s['uri']]\n    51\t    return kept(texts)\n    52\t\n    53\t\n    54\tdef frozen_page(data, checked):\n    55\t    header = kept(['Hivemind release', f\"As of {data['as_of']}\", counts_line(data['questions'])])\n    56\t    cards = [{'id': q['id'], 'top': card_top(q), 'groups': []} for q in data['questions']]\n    57\t    collapsed = {'header': header, 'cards': cards, 'other': [], 'clipped': [], 'unreadable': []}\n    58\t    expanded = json.loads(json.dumps(collapsed))\n    59\t    target = next(c for c in expanded['cards'] if c['id'] == checked)\n    60\t    target['groups'] = [group(e) for e in next(q for q in data['questions'] if q['id'] == checked)['evidence']]\n    61\t    return {'count': len(data['questions']), 'collapsed': collapsed, 'expanded': expanded}\n    62\t\n    63\t\n    64\tdef build(ledger, items, out, as_of=None):\n    65\t    args = [sys.executable, str(REPO / 'scripts/release_build.py'), 'build', '--ledger', str(ledger), '--items', str(items), '--out', str(out)]\n    66\t    result = subprocess.run(args + (['--as-of', as_of] if as_of else []), capture_output=True, text=True, env={'PATH': '/usr/bin:/bin', 'PYTHONDONTWRITEBYTECODE': '1'})\n    67\t    if result.returncode:\n    68\t        raise SystemExit(f'build {out}: {result.stderr}')\n    69\t\n    70\t\n    71\tdef main(run):\n    72\t    run = Path(run).absolute()\n    73\t    run.mkdir()\n    74\t    build(OLD['old-1'], COMPARISON_ITEMS, run / 'old-1')\n    75\t    build(OLD['old-3'], COMPARISON_ITEMS, run / 'old-3-0825', '2026-08-25')\n    76\t    build(OLD['old-1'], COMPARISON_ITEMS, run / 'old-1-0828', '2026-08-28')\n    77\t    import test_release as fixture                                  # the test suite's fixture store, plus one hostile quote\n    78\t    scratch = run / '.escape-stores'\n    79\t    scratch.mkdir()\n    80\t    views, items = fixture.make_store(scratch / 'views.sqlite'), fixture.make_items(scratch / 'items.sqlite')\n    81\t    conn = store.open_db(str(views))\n    82\t    fixture.evidence(conn, 'e9', 'v6', 1, 'A hostile quote, shown as text.', ESCAPE_QUOTE, [('item-1', 1)])\n    83\t    conn.commit()\n    84\t    conn.close()\n    85\t    build(views, items, run / 'escape')\n    86\t    data = lambda folder: json.loads((ACCEPTED / folder / 'release-data.json').read_text())\n    87\t    expected = {\n    88\t        'accepted': str(ACCEPTED),\n    89\t        'pages': {'old-1/v8': frozen_page(data('old-1/package'), 'v8'),\n    90\t                  'old-3/v36@2026-08-25': frozen_page(data('old-3/package-2026-08-25'), 'v36'),\n    91\t                  'old-1/v10@2026-08-28': frozen_page(data('old-1/package-2026-08-28'), 'v10')},\n    92\t        'morningstar_quote': next(e['quote'] for q in data('old-1/package')['questions'] for e in q['evidence'] if e['id'] == 'e2295'),\n    93\t        'escape': {'question': 'v6', 'quote': ESCAPE_QUOTE.strip(), 'count': 7},\n    94\t    }\n    95\t    path = run / 'screen-expected.json'\n    96\t    path.write_text(json.dumps(expected, ensure_ascii=False, indent=1))\n    97\t    print('screen-expected.json sha256', hashlib.sha256(path.read_bytes()).hexdigest())\n    98\t\n    99\t\n   100\tif __name__ == '__main__':\n   101\t    main(sys.argv[1])\n   758\t                'insertAdjacentHTML', 'document.write', 'eval(', 'Function(', \"createElement('a')\", 'href', 'src')\n   759\tCLIPPING_PROPERTIES = ('content', 'overflow', 'overflow-x', 'overflow-y', 'clip', 'clip-path', 'contain', 'text-overflow', 'line-clamp',\n   760\t                       '-webkit-line-clamp', 'max-height', 'opacity', 'visibility')\n   761\t\n   762\t\n   763\tdef test_26_the_page_is_a_pure_function_of_the_data_with_literal_escapes():\n   764\t    \"\"\"RELEASE-PAGE.md §5 tests 1 and 2: the same data gives the same page; <, >, &, U+2028 and U+2029 become their six-character\n   765\t    JSON escapes, so the data block cannot close or comment out, and it parses back to the same data.\"\"\"\n   766\t    hostile = '</script><img src=x onerror=alert(1)> & a line' + chr(0x2028) + 'break' + chr(0x2029) + '<!--'\n   767\t    payload = json.dumps({'quote': hostile}, ensure_ascii=False).encode()\n   768\t    page = release.render_page(payload)\n   769\t    assert page == release.render_page(payload)\n   770\t    block = page.decode().split('<script type=\"application/json\" id=\"release-data\">')[1].split('</script>')[0]\n   771\t    backslash = chr(92)\n   772\t    assert block == payload.decode().replace('<', backslash + 'u003c').replace('>', backslash + 'u003e').replace('&', backslash + 'u0026') \\\n   773\t        .replace(chr(0x2028), backslash + 'u2028').replace(chr(0x2029), backslash + 'u2029')\n   774\t    assert '</script' not in block and '<!--' not in block and json.loads(block) == {'quote': hostile}\n   775\t    assert page.decode().count('<script') == 2\n   776\t\n   777\t\n   778\tdef test_27_the_template_has_no_network_code_drawn_text_or_clipping():\n   779\t    \"\"\"RELEASE-PAGE.md §5 test 3: the script uses no network or markup-writing API and makes no link; the stylesheet draws no text and\n   780\t    clips nothing; the CSP is exactly the designed policy with the hashes of the template's own script and style; charset and CSP\n   781\t    come first.\"\"\"\n   782\t    for api in NETWORK_APIS:\n   783\t        assert api not in release.PAGE_SCRIPT, api\n   784\t    for name in CLIPPING_PROPERTIES:\n   785\t        assert not re.search(r'(?<![-\\w])' + re.escape(name) + r'\\s*:', release.PAGE_STYLE), name\n   786\t    assert 'nowrap' not in release.PAGE_STYLE\n   787\t    digest = lambda text: \"'sha256-\" + base64.b64encode(hashlib.sha256(text.encode()).digest()).decode() + \"'\"\n   788\t    csp = (f\"default-src 'none'; script-src {digest(release.PAGE_SCRIPT)}; style-src {digest(release.PAGE_STYLE)}; img-src 'none'; \"\n   789\t           \"font-src 'none'; connect-src 'none'; base-uri 'none'; form-action 'none'\")\n   790\t    template = release.page_template()\n   791\t    assert template.startswith('<!doctype html>\\n<html lang=\"en\">\\n<head>\\n<meta charset=\"utf-8\">\\n'\n   792\t                               f'<meta http-equiv=\"Content-Security-Policy\" content=\"{csp}\">\\n')\n   793\t    assert template.count(release.DATA_PLACEHOLDER) == 1\n   794\t\n   795\t\n   796\tdef test_28_the_package_page_must_be_the_page_of_its_data(stores, tmp_path):\n   797\t    \"\"\"RELEASE-PAGE.md §5 test 4: a page changed by one byte, or with a fetch added and its CSP and hashes updated, is refused because\n   798\t    it is not render_page(data); a correct page with only its manifest hash wrong is refused for that reason; a fourth file is\n   799\t    refused.\"\"\"\n   800\t    out = tmp_path / 'release'\n   801\t    build_package(stores, out)\n   802\t    assert check(stores, out)['fields_compared'] == FIXTURE_COUNTS['fields_compared']\n   803\t\n   804\t    def copy_with(name, page=None, page_hash=None):\n   805\t        target = tmp_path / name\n   806\t        shutil.copytree(out, target)\n   807\t        if page is not None:\n   808\t            (target / release.PAGE_FILE).write_bytes(page)\n   809\t        manifest = json.loads((target / release.MANIFEST_FILE).read_text())\n   810\t        manifest['page_sha256'] = page_hash or hashlib.sha256((target / release.PAGE_FILE).read_bytes()).hexdigest()\n   811\t        (target / release.MANIFEST_FILE).write_text(json.dumps(manifest))\n   812\t        return target\n   813\t\n   814\t    original = (out / release.PAGE_FILE).read_bytes()\n   815\t    one_byte = copy_with('one-byte', original.replace(b'needs JavaScript', b'needs Javascript'))\n   816\t    refused_with(lambda: check(stores, one_byte), 'the page is not the page made from its data')\n   817\t    script = release.PAGE_SCRIPT\n   818\t    added = script.replace(\"(function(){'use strict';\", \"(function(){'use strict';fetch('http://127.0.0.1:59999/library').catch(function(){});\")\n   819\t    digest = lambda text: \"'sha256-\" + base64.b64encode(hashlib.sha256(text.encode()).digest()).decode() + \"'\"\n   820\t    fetching = original.decode().replace(script, added).replace(digest(script), digest(added)).encode()\n   821\t    assert fetching != original\n   822\t    refused_with(lambda: check(stores, copy_with('fetching', fetching)), 'the page is not the page made from its data')\n   823\t    wrong_hash = copy_with('wrong-hash', page_hash='0' * 64)\n   824\t    refused_with(lambda: check(stores, wrong_hash), 'the manifest page_sha256 does not match the page')\n   825\t    fourth = tmp_path / 'fourth'\n   826\t    shutil.copytree(out, fourth)\n   827\t    (fourth / 'extra.html').write_text('<p>x</p>')\n   828\t    refused_with(lambda: check(stores, fourth), f\"{fourth}: holds ['extra.html', 'index.html', 'manifest.json', 'release-data.json'], \"\n   829\t                                                \"not exactly ['index.html', 'manifest.json', 'release-data.json']\")\n   830\t\n   831\t\n   832\tCERTIFIED_TEMPLATE_SHA256 = 'f94bb3cbf5ba1030ee37f0111b78bf2e58f7f767d77aa7e7d2443677e5811ae2'   # certified by poc/data/release-screen-2026-11-23b\n   833\t\n   834\t\n   835\tdef test_29_the_page_template_is_the_one_the_screen_run_certified():\n   836\t    \"\"\"RELEASE-PAGE.md revision 7, test 3: the whole page template, with its data placeholder, is the one the $0 screen run certified\n   837\t    (poc/data/release-screen-2026-11-23b); any change to any part of it fails here until a new screen run certifies it.\"\"\"\n   838\t    assert hashlib.sha256(release.page_template().encode('utf-8')).hexdigest() == CERTIFIED_TEMPLATE_SHA256\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_16","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba src/hivemind/release.py | sed -n '200,256p;372,401p'; nl -ba docs/research/2026-11-22-number-answers/release_check.py | sed -n '19,43p;112,146p;187,213p;240,320p'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba src/hivemind/release.py | sed -n '200,256p;372,401p'; nl -ba docs/research/2026-11-22-number-answers/release_check.py | sed -n '19,43p;112,146p;187,213p;240,320p'\"","aggregated_output":"   200\t        if kind == 'number':\n   201\t            if question['forecast'] != FORECAST_UNAVAILABLE:\n   202\t                raise ReleaseRefused(f'{where}: a number question carries only the marker')\n   203\t        else:\n   204\t            answers = question['answers']\n   205\t            if not (isinstance(answers, list) and len(answers) == 2 and all(isinstance(a, str) for a in answers)):\n   206\t                raise ReleaseRefused(f'{where}: answers are not two labels')\n   207\t            if question['answer'] is not None and question['answer'] not in answers:\n   208\t                raise ReleaseRefused(f'{where}: the answer is not one of its labels')\n   209\t        if not isinstance(question['evidence'], list):\n   210\t            raise ReleaseRefused(f'{where}: evidence is not a list')\n   211\t        for piece in question['evidence']:\n   212\t            _keys(piece, 'evidence', f'{where} evidence')\n   213\t            _texts(piece, ('id',), f'{where} evidence')\n   214\t            _texts(piece, EVIDENCE_TEXT, f'{where} evidence {piece[\"id\"]}')\n   215\t            if not isinstance(piece['sources'], list):\n   216\t                raise ReleaseRefused(f'{where} evidence {piece[\"id\"]}: sources is not a list')\n   217\t            for source in piece['sources']:\n   218\t                _keys(source, 'source', f'{where} evidence {piece[\"id\"]} source')\n   219\t                _texts(source, SOURCE_TEXT, f'{where} evidence {piece[\"id\"]} source')\n   220\t            counts['sources'] += len(piece['sources'])\n   221\t        counts['evidence'] += len(question['evidence'])\n   222\t        counts['questions'][kind] += 1\n   223\t    return counts\n   224\t\n   225\t\n   226\t# ---------- the origin check\n   227\t\n   228\tdef _open_at(conn, view_id, as_of):\n   229\t    for row in conn.execute('select open, after_seq from view_switches where view_id=? order by id desc', (view_id,)):\n   230\t        if service.visible(conn, row['after_seq'], as_of):\n   231\t            return bool(row['open'])\n   232\t    return True\n   233\t\n   234\t\n   235\tdef _expected_evidence(views_db, items_db, view_id, as_of):\n   236\t    \"\"\"The evidence in force at the day, by its own SQL: visible links in link order, minus those whose latest replacement is\n   237\t    visible; each source row visible at the day, in row order, with its item required.\"\"\"\n   238\t    out = []\n   239\t    for link in views_db.execute('select evidence_id, seq from evidence_links where view_id=? order by id', (view_id,)).fetchall():\n   240\t        if not service.visible(views_db, link['seq'], as_of):\n   241\t            continue\n   242\t        latest = views_db.execute('select seq from replacements where old_evidence_id=? order by id desc limit 1', (link['evidence_id'],)).fetchone()\n   243\t        if latest is not None and service.visible(views_db, latest['seq'], as_of):\n   244\t            continue\n   245\t        row = views_db.execute(f'select evidence_id, {\", \".join(EVIDENCE_TEXT)} from evidence where evidence_id=?', (link['evidence_id'],)).fetchone()\n   246\t        if row is None:\n   247\t            raise ReleaseRefused(f'{view_id}: link to evidence {link[\"evidence_id\"]}, which the store does not hold')\n   248\t        sources = []\n   249\t        for source in views_db.execute('select input_id, publication_day, seq from evidence_sources where evidence_id=? order by id', (link['evidence_id'],)).fetchall():\n   250\t            if not service.visible(views_db, source['seq'], as_of):\n   251\t                continue\n   252\t            item = items_db.execute('select title, publisher, source_uri from items where input_id=?', (source['input_id'],)).fetchone()\n   253\t            if item is None:\n   254\t                raise ReleaseRefused(f'evidence {row[\"evidence_id\"]}: source item {source[\"input_id\"]} is not in the items database')\n   255\t            sources.append({'title': item['title'], 'publisher': item['publisher'], 'day': source['publication_day'], 'uri': item['source_uri']})\n   256\t        out.append({'id': row['evidence_id'], **{name: row[name] for name in EVIDENCE_TEXT}, 'sources': sources})\n   372\tdef publish_report(report, path):\n   373\t    \"\"\"The report, written to a private temporary file and linked to its name; the link refuses any existing path, and its success\n   374\t    is the moment the report is published. Returns None, or the temporary file it could not remove after publishing.\"\"\"\n   375\t    path = Path(path)\n   376\t    descriptor, temporary = tempfile.mkstemp(dir=path.parent, prefix=f'.{path.name}.')\n   377\t    try:\n   378\t        with os.fdopen(descriptor, 'wb') as handle:\n   379\t            handle.write(json.dumps(report, ensure_ascii=False, indent=1).encode('utf-8'))\n   380\t        os.link(temporary, path)\n   381\t    except BaseException:\n   382\t        os.unlink(temporary)\n   383\t        raise\n   384\t    try:\n   385\t        os.unlink(temporary)\n   386\t    except OSError:\n   387\t        return temporary\n   388\t    return None\n   389\t\n   390\t\n   391\tdef _unique_members(pairs):\n   392\t    names = [name for name, _ in pairs]\n   393\t    if len(names) != len(set(names)):\n   394\t        raise ReleaseRefused(f'a JSON member name repeats: {sorted({n for n in names if names.count(n) > 1})}')\n   395\t    return dict(pairs)\n   396\t\n   397\t\n   398\tdef read_data(package):\n   399\t    \"\"\"The package's data, read with the repeated-member check. `check_package` returns the data it checked, which is the copy to\n   400\t    trust; this reader is for inspection only.\"\"\"\n   401\t    return _parse((Path(package) / DATA_FILE).read_bytes(), DATA_FILE)\n    19\tfrom hivemind import bundle, release, service  # noqa: E402\n    20\tfrom hivemind.views import store  # noqa: E402\n    21\t\n    22\tCOMMAND = REPO / 'scripts' / 'release_build.py'\n    23\tMARKER = 'Forecast unavailable'                     # D726's words, written here, not read from the module under test\n    24\tFORMAT, ALLOW_LIST = 'hivemind-release/2', 'release-allow-list/1'   # RELEASE-PAGE.md's identifiers, written here, not read from the module\n    25\tDATED = {'old-3/v36@2026-08-25': ('2026-08-25', 3239), 'old-1/v10@2026-08-28': ('2026-08-28', 5673)}   # each dated package's day and evidence\n    26\tEXPECTED = {   # each store's default day, classes and evidence, fixed before this run from the reviewed first run (councils 75–75e reproduced them)\n    27\t    'old-1': ('2026-09-20', {'number': 19, 'event': 28, 'yes_no': 0}, 8251),\n    28\t    'old-2': ('2026-09-20', {'number': 17, 'event': 26, 'yes_no': 0}, 6306),\n    29\t    'old-3': ('2026-09-20', {'number': 18, 'event': 31, 'yes_no': 0}, 6659),\n    30\t    'served': ('2026-08-28', {'number': 13, 'event': 55, 'yes_no': 0}, 6461),\n    31\t}\n    32\tJ1580_PREFIX = 'About $390 billion: $164 billion reported in the first half'   # the system's own forecast used as the forged value\n    33\tCLOSING_REASON = 'due 2026-09-20, frozen on 2026-09-20 at rung 2 Bullish'\n    34\tCOMPARISON_ITEMS = REPO / 'poc/data/comparison-2026-11-17/items-comparison.sqlite'\n    35\tSTORES = {\n    36\t    'old-1': (REPO / 'poc/data/comparison-2026-11-17/run/old-1/prod/views.sqlite', COMPARISON_ITEMS),\n    37\t    'old-2': (REPO / 'poc/data/comparison-2026-11-17/run/old-2/prod/views.sqlite', COMPARISON_ITEMS),\n    38\t    'old-3': (REPO / 'poc/data/comparison-2026-11-17/run/old-3/prod/views.sqlite', COMPARISON_ITEMS),\n    39\t    'served': (REPO / 'poc/data/served-2026-10-28-v34-nvda-3m-through-0828/views.sqlite', REPO / 'poc/data/items-nvda-2026-07-01-10-27.sqlite'),\n    40\t}\n    41\t\n    42\t\n    43\tdef build(ledger, items, out, as_of=None):\n   112\t\n   113\tdef library_baseline(ledger, items):\n   114\t    views_db, items_db = service.open_ledger(str(ledger)), store.open_read_only(str(items))\n   115\t    try:\n   116\t        started = time.monotonic()\n   117\t        payload = bundle.library(views_db, items_db)\n   118\t        return len(json.dumps(payload, ensure_ascii=False).encode()), time.monotonic() - started\n   119\t    finally:\n   120\t        views_db.close()\n   121\t        items_db.close()\n   122\t\n   123\t\n   124\tdef by_id(data):\n   125\t    return {q['id']: q for q in data['questions']}\n   126\t\n   127\t\n   128\tdef refresh(package, data=None, manifest_extra=None):\n   129\t    \"\"\"A forged copy made consistent everywhere but the store: its page made from the forged data again and both hashes refreshed, so\n   130\t    the store comparison is what must refuse it.\"\"\"\n   131\t    if data is not None:\n   132\t        payload = json.dumps(data, ensure_ascii=False, separators=(',', ':')).encode()\n   133\t        (package / release.DATA_FILE).write_bytes(payload)\n   134\t        (package / release.PAGE_FILE).write_bytes(release.render_page(payload))\n   135\t    manifest = json.loads((package / release.MANIFEST_FILE).read_text())\n   136\t    manifest['data_sha256'] = hashlib.sha256((package / release.DATA_FILE).read_bytes()).hexdigest()\n   137\t    manifest['page_sha256'] = hashlib.sha256((package / release.PAGE_FILE).read_bytes()).hexdigest()\n   138\t    manifest.update(manifest_extra or {})\n   139\t    (package / release.MANIFEST_FILE).write_text(json.dumps(manifest))\n   140\t\n   141\t\n   142\tdef refused(ledger, items, package):\n   143\t    try:\n   144\t        check(ledger, items, package)\n   145\t    except release.ReleaseRefused as error:\n   146\t        return str(error)\n   187\t            kept[evidence_id] = {'questions': [], 'equal_to_store': False, 'present': False}\n   188\t            continue\n   189\t        holders = [(q['id'], e) for q in data['questions'] for e in q['evidence'] if e['id'] == evidence_id]\n   190\t        kept[evidence_id] = {'questions': [h[0] for h in holders],\n   191\t                             'equal_to_store': all(e['one_line'] == stored[evidence_id]['one_line'] and e['quote'] == stored[evidence_id]['quote'] for _, e in holders) and bool(holders),\n   192\t                             'present': bool(holders),\n   193\t                             'holds_its_wording': bool(holders) and all((e['one_line'], e['quote']) == required_text[evidence_id] for _, e in holders)}\n   194\t    forged = out / 'old-1' / 'forged-summary'\n   195\t    shutil.copytree(package, forged)\n   196\t    changed = json.loads(json.dumps(data))\n   197\t    next(e for e in by_id(changed)['v8']['evidence'] if e['id'] == 'e2295')['one_line'] = implied\n   198\t    refresh(forged, changed)\n   199\t    prose = out / 'old-1' / 'forged-manifest'\n   200\t    shutil.copytree(package, prose)\n   201\t    refresh(prose, manifest_extra={'note': implied})\n   202\t    v8 = by_id(data)['v8']\n   203\t    results['decisive'] = {'kept': kept, 'implied_outcome_j1580': implied[:120],\n   204\t                           'substituted_into_e2295_refused': refused(ledger, items, forged),\n   205\t                           'added_to_manifest_refused': refused(ledger, items, prose),\n   206\t                           'unchanged_package_passes': check(ledger, items, package)['fields_compared']}\n   207\t    results['decisive']['forged_value_is_j1580'] = implied.startswith(J1580_PREFIX)\n   208\t    results['old-1/v8'] = {'class': v8['class'], 'forecast': v8['forecast'], 'evidence': len(v8['evidence']),\n   209\t                           'same_ids_as_service_evidence': [e['id'] for e in v8['evidence']] == in_force_v8}\n   210\t\n   211\t    leaks = {}\n   212\t    for name, view_id, day, judgement_id in (('old-3', 'v36', '2026-08-25', 799), ('old-1', 'v10', '2026-08-28', 865)):\n   213\t        ledger, items = STORES[name]\n   240\t    closing.mkdir()\n   241\t    copy = closing / 'views.sqlite'\n   242\t    shutil.copyfile(ledger, copy)\n   243\t    conn = sqlite3.connect(copy)\n   244\t    rung = conn.execute(\"select rung from judgements where view_id='v8' order by judgement_id desc limit 1\").fetchone()[0]\n   245\t    rung_label = conn.execute(\"select label from rungs where view_id='v8' and position=?\", (rung,)).fetchone()[0]\n   246\t    reason = f'due {data[\"as_of\"]}, frozen on {data[\"as_of\"]} at rung {rung} {rung_label}'\n   247\t    last_seq = conn.execute('select max(sequence_no) from processing_steps').fetchone()[0]\n   248\t    conn.execute(\"insert into view_switches (view_id, open, reason, by_whom, after_seq) values ('v8', 0, ?, 'pull', ?)\", (reason, last_seq))\n   249\t    conn.commit()\n   250\t    conn.close()\n   251\t    views_db, items_db = service.open_ledger(str(copy)), store.open_read_only(str(items))\n   252\t    exposed = bundle.view_bundle(views_db, bundle.item_lookup(items_db), 'v8')\n   253\t    views_db.close()\n   254\t    items_db.close()\n   255\t    report, closed = build(copy, items, closing / 'package')\n   256\t    texts = [text for *_, text in fields(closed)]\n   257\t    results['closing'] = {'reason': reason, 'bundle_exposes_reason': any(s.get('reason') == reason for s in exposed['switches']),\n   258\t                          'package_open': by_id(closed)['v8']['open'], 'reason_absent': not any(reason in t for t in texts),\n   259\t                          'rung_label_inside_v8_fields': [(p, e, t[:120]) for q, p, e, t in fields(closed) if q == 'v8' and rung_label in t]}\n   260\t    (out / 'results.json').write_text(json.dumps(results, ensure_ascii=False, indent=1))\n   261\t    print(json.dumps({k: v for k, v in results.items() if k != 'stores'}, ensure_ascii=False, indent=1))\n   262\t    failures = [f'{name}: {key}' for name, s in results['stores'].items() for key in ('bytes_within_budget', 'seconds_within_budget') if not s[key]]\n   263\t    for name in STORES:                                          # the delivered identifiers, data and manifest, against the literal ones\n   264\t        delivered = json.loads((out / name / 'package' / release.MANIFEST_FILE).read_text())\n   265\t        failures += [] if (packages[name]['format'], packages[name]['allow_list'], delivered['format'], delivered['allow_list']) == (FORMAT, ALLOW_LIST, FORMAT, ALLOW_LIST) else [f'{name}: format or allow-list']\n   266\t    failures += [f'{name}: day, classes or evidence' for name, (day, classes, evidence) in EXPECTED.items()\n   267\t                 if (results['stores'][name]['as_of'], results['stores'][name]['counts']['questions'], results['stores'][name]['counts']['evidence']) != (day, classes, evidence)]\n   268\t    failures += [] if results['decisive']['forged_value_is_j1580'] else ['the forged value is not the system forecast j1580']\n   269\t    decisive = results['decisive']\n   270\t    failures += [f'kept {e}' for e in ('e2295', 'e1865', 'e3597')\n   271\t                 if not (decisive['kept'].get(e, {}).get('present') and decisive['kept'][e]['equal_to_store'] and decisive['kept'][e]['holds_its_wording'])]\n   272\t    expected_reasons = {'substituted_into_e2295_refused': 'question v8.evidence e2295.one_line: differs from the store',\n   273\t                        'added_to_manifest_refused': \"the manifest: keys off the allow-list ['note'], missing []\"}   # exact, so another refusal (a stale hash) does not count\n   274\t    failures += [k for k, reason in expected_reasons.items() if decisive[k] != reason]\n   275\t    failures += [] if (results['old-1/v8']['same_ids_as_service_evidence'] and results['old-1/v8']['forecast'] == MARKER\n   276\t                       and results['old-1/v8']['class'] == 'number' and results['old-1/v8']['evidence'] == 1284) else ['old-1/v8']\n   277\t    for name, leak in results['leaks'].items():\n   278\t        failures += [f'{name}: {k}' for k in ('label_kept', 'why_changed_absent', 'reasons_absent') if not leak[k]]\n   279\t        failures += [] if leak['answer'] == 'Yes' else [f'{name}: answer']\n   280\t        failures += [] if (leak['package_as_of'], leak['manifest_as_of'], leak['evidence']) == (DATED[name][0], DATED[name][0], DATED[name][1]) else [f'{name}: package day or evidence']\n   281\t        failures += [] if leak['latest_judgement'] == leak['expected_judgement'] else [f'{name}: judgement']\n   282\t        failures += [f'{name}: {phrase} found' for phrase, hits in leak['phrase_fields'].items() if hits]\n   283\t    failures += [] if (results['control']['id'], results['control']['answer']) == ('v3', 'Yes') and results['control']['label_equals_store'] and results['control']['evidence_equals_store'] else ['control']\n   284\t    closing = results['closing']\n   285\t    failures += [] if closing['reason'] == CLOSING_REASON and closing['bundle_exposes_reason'] and closing['package_open'] is False and closing['reason_absent'] else ['closing']\n   286\t    if failures:\n   287\t        raise SystemExit(f'release check FAILED: {failures}')\n   288\t    print('release check: every acceptance item and budget met; diagnostic hits to read by hand:',\n   289\t          {name: len(s['diagnostics']['hits']) for name, s in results['stores'].items()})\n   290\t\n   291\t\n   292\tif __name__ == '__main__':\n   293\t    main(sys.argv[1])\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_17","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba docs/research/2026-11-22-number-answers/codex-r76h.md; nl -ba docs/research/2026-11-22-number-answers/codex-r76g.md | tail -18; nl -ba docs/prd/10-filing-phase.md | tail -29; rg -n 'read.*once|_read_regular|descriptor|read_bytes' tests/test_release.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_17","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba docs/research/2026-11-22-number-answers/codex-r76h.md; nl -ba docs/research/2026-11-22-number-answers/codex-r76g.md | tail -18; nl -ba docs/prd/10-filing-phase.md | tail -29; rg -n 'read.*once|_read_regular|descriptor|read_bytes' tests/test_release.py\"","aggregated_output":"     1\t**Ready to build.** Revision 7 closes both 76g findings in the design. Browser acceptance remains ahead.\n     2\t\n     3\t1. **Contrast lookup — closed.** The check starts at the element holding the text and walks upward only if its background is transparent. The decisive test requires “Forecast unavailable” to fail when its dark text sits on its own dark background inside a light card. [RELEASE-PAGE.md:237](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/RELEASE-PAGE.md:237) · [RELEASE-PAGE.md:274](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/RELEASE-PAGE.md:274)\n     4\t2. **Whole-page template pin — closed.** The renderer inserts escaped data into the complete template’s single placeholder. After browser certification, the test records the SHA-256 of that template with the placeholder intact. Changing only the fallback sentence therefore fails the test. [RELEASE-PAGE.md:8](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/RELEASE-PAGE.md:8) · [RELEASE-PAGE.md:176](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/RELEASE-PAGE.md:176)\n     5\t\n     6\t**Optional.** Further tests for hypothetical CSS changes remain optional because those edits already change the complete template’s hash. [codex-r76g.md:7](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/codex-r76g.md:7)     1\t**Not ready to build as written.** Revision 6 closes the clipping finding. Two gaps remain in what the design can certify before shipping. [RELEASE-PAGE.md:224](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/RELEASE-PAGE.md:224) · [RELEASE-PAGE.md:227](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/RELEASE-PAGE.md:227) · [RELEASE-PAGE.md:167](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/RELEASE-PAGE.md:167)\n     2\t\n     3\t1. **Clipping is closed. Contrast is still open.** The browser check walks the quote’s ancestors, so a one-line wrapper with `contain: paint` fails even when Morningstar’s quote wraps normally inside it. The contrast check starts its background lookup one element too high. If “Forecast unavailable” has dark text on its **own** dark background inside a light card, line 228 compares the dark text with the light card. That can pass while the reader sees a blank marker. Start the lookup at the element holding the text. The decisive test is that same marker on a contrasting parent. This matters on the first certification, before any hashes are pinned. [RELEASE-PAGE.md:224](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/RELEASE-PAGE.md:224) · [RELEASE-PAGE.md:228](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/RELEASE-PAGE.md:228) · [RELEASE-PAGE.md:261](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/RELEASE-PAGE.md:261)\n     4\t\n     5\t2. **The pin leaves the surrounding HTML uncovered.** For an unchanged, certified template and accepted package data, I found no separate forecast leak or outgoing request path. The data is escaped, source addresses are plain text, and the package checker compares the page byte for byte. But that comparison uses the *current* `render_page`, and the two test hashes cover only the style and script. Changing the static fallback sentence, for example, changes what a reader sees when JavaScript is blocked. Both hashes stay identical, and a newly built package still equals the current renderer. Pin the complete template with its data placeholder intact. A change to the fallback alone should then fail the pin. [RELEASE-PAGE.md:72](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/RELEASE-PAGE.md:72) · [RELEASE-PAGE.md:79](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/RELEASE-PAGE.md:79) · [RELEASE-PAGE.md:90](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/RELEASE-PAGE.md:90) · [RELEASE-PAGE.md:101](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/RELEASE-PAGE.md:101) · [RELEASE-PAGE.md:167](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/RELEASE-PAGE.md:167)\n     6\t\n     7\t**Convergence.** These two corrections cover the page first certified and the page later shipped. Further checks for hypothetical CSS changes that would already fail the complete-template pin are optional. This was a read-only design review. The browser acceptance run is still ahead. [RELEASE-PAGE.md:3](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/RELEASE-PAGE.md:3) · [RELEASE-PAGE.md:186](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/RELEASE-PAGE.md:186)   173\t- **A review's report is a lead**: each finding counts only once it is checked against the records (AGENTS §1).\n   174\t- **A prompt audit before any prompt change** (`.claude/skills/prompt-audit/SKILL.md`): check the whole request against the standard sentence by\n   175\t  sentence, in both directions.\n   176\t- **Every step goes into `log.md`**: what was done, what came of it, the files; mistakes and overturned results stay in it too.\n   177\t- **Do not repeat what was ruled out** (§3).\n   178\t\n   179\t## 8. Steps and where we are\n   180\t\n   181\t| # | Step | Output | Status |\n   182\t|---|---|---|---|\n   183\t| 1 | Design: the classes of indirect relation (a closed set + examples from other industries), how to file when a fact measures both sides, deleting the fallback; checked against the standard sentence by sentence; length before and after | `docs/research/2026-11-04-filing-end-to-end/design-links.md` | Done (draft 3, v74l / poc-v115) |\n   184\t| 2 | Checks at no cost: a sample answer written by the new rule goes through every code check; the new rule's text goes through the prompt audit | Same as above | Done |\n   185\t| 3 | Review rounds (Codex, independent readers, own), until nothing serious remains | `review-links-*.md` | Done (Codex 7 rounds, independent readers 3 times; round 7 found nothing serious) |\n   186\t| 4 | Draw and freeze the held-out set; write down and freeze this test's predictions and decision rule | `heldout.json`, `predictions-links.md` | Done (sha256 recorded for both) |\n   187\t| 5 | Test once: development set + held-out set, the new rule and the same-day control 3 times each | `answers-links.json`, `log.md` | Done (2026-11-04): failed: facts that matter reaching the right question, development set +7 (p 0.26); every other condition passed |\n   188\t| 6 | If passed: to Alex, to decide whether to run three 14-day end-to-end draws; if failed: stop, to Alex | `design-links.md` §8 | Stopped, to Alex |\n   189\t| 7 | (D361, Alex: \"按照你的提以来，但是你一定是自己反思多轮之后才给出的行动\") Measure the ceiling first: hand the source passages the gold cites straight to the frozen judgement; the custom-chip, operating-margin and capital-spending questions judged 3 times each at the window end, the custom-chip question as it was 3 times as the control; the fallback sentence is not deleted for now | `reflection-v74l.md`, `oracle-design.md` | Done: operating margin grounded 3/3, capital spending 2/3, custom chips 0/3 (the gap is in interpretation); the next step waits for Alex |\n   190\t| 8 | (D362, Alex: \"你继续啊不要scope drift and strongly follow evidence of your discovery and learning\") Two small changes where facts are not delivered, one at a time: ① when a quote is rewritten, code matches it back to the source sentence (changing nothing the model sees; verified by replaying the archive); ② a figure question's description states which figures it is derived from by definition (first sent 3 times each on the article that motivated it) | `delivery-fixes.md` | Stopped: an independent check overturned the first change's code (it would take in wrong figures); the second failed its trial send (1/3). The root: the signed standard's §5.3 does not keep two key facts, treating them as \"a restatement of known facts\" (proposal 6, awaiting approval); to Alex |\n   191\t| 9 | **Historical; superseded by D370.** (D363, Alex: \"乙\") At coverage start, record each question's starting figure once from the company's latest earnings report; the daily path still takes no restatements: design, rounds of self-checks and independent checks, validated first on the archive in the simplest way | `baseline-design.md` | Validated on two questions: the frozen extraction does not read the report's tables (0/3); with each question reading the report once on its own, the operating-margin question read its starting figure 2/3 and the capital-spending question 3/3, and the judgement then judged right (2/3, 3/3), about 2.5 cents. All 22 questions tested once (2026-11-05, Alex: \"你充分验证\"; files chosen by code, a same-day control, about $0.43): v10 and v12 judged right 9/9 each; no question already judged right turned wrong; but 5 of the 53 figures read were other quantities (the Vera CPU question and the Blackwell and Rubin question took a larger or neighbouring revenue line), so it failed condition 3, written beforehand. The model itself pointed to the reading instructions' sentence \"write the lines it is computed from, or the line the report uses for it\"; stopped, to Alex. Alex: \"改\"; only this sentence was changed (\"write only the lines it is computed from, or the same quantity under another name; never a broader line or a line next to it\"), tried on 4 questions first, then tested on all 22 (about $0.36): all three conditions passed: v10 and v12 9/9 each, no question judged right turned wrong, and all 46 figures were the questions' own quantities. Checked after an independent reader's challenge: the new sentence made the reading miss the capital-spending line in 3 of 12 reads, and it had been tested only on the one May report; the fourth version (a line-by-line re-check after writing) removed too much and failed; after a census of every failure trace (Alex: \"我需要你深度看完所有失败trace给我准信\"), the third version with the repaired quote check was chosen (D365): 0 wrong figures on the held-out August report; built into the production system (poc-v116; the $0 checks and the tests all pass). The full acceptance, three 14-day draws (Alex: \"跑验收\"; a same-day control; about $4.79): all passed: operating margin and capital spending judged right 3/3 each (the control never judged them), 53 against 45 in total (of 57); for the China-share question, the only one two fewer, both readers found the starting figures did not lead it astray. Alex: \"都做\": poc-v116 became the default (D366); the code was committed and a PR opened |\n   192\t\n   193\t## 9. Alex's own words on this matter (in time order)\n   194\t\n   195\t- \"你这个单独开一个专题出来解决 … 是promot，是系统结构设计还是到底哪里有问题挂错一堆东西，机制是不是有问题（一定要挂吗？有没有可能是杂音\" (2026-11-03)\n   196\t- \"So if it's a customer problem or other companies that you think is relating NVIDIA and it's the wrong evidence, then what is the standard for it? … from a hedge fund analyst standpoint, are these even relevant? Do you think your ruler is wrong in this aspect?\" (2026-11-04)\n   197\t- \"你确定下你接下来要改进的量化目标，以及你要看到端到端我们的管线是要做什么的，不要乱硬优化，要看到目标\" (2026-11-04)\n   198\t- \"就测试一种，一次 … 能不能自己有个超级自信的定论和证据再给我提建议\" (2026-11-04)\n   199\t- \"这些只是类型题，你需要抽象拔高我们现在的核心问题和卡点。这个很重要这样改下去才是对的\" (2026-11-04)\n   200\t- \"你把这个写好成下一阶段核心PRD然后不要drift, 把所有需要的context 全部充分记录，每次开始前都需要revisit, 然后开始做\" (2026-11-04)\n   201\t- \"go\" (2026-11-04, on the proposed amendments to §5.2 and §6 and on this test)\n313:        'changed byte': (lambda p: (p / release.DATA_FILE).write_bytes((p / release.DATA_FILE).read_bytes().replace(b'Morningstar', b'Morningstan')),\n407:    (tmp_path / 'outside.json').write_bytes((linked / release.DATA_FILE).read_bytes())\n413:    raw = (repeated / release.DATA_FILE).read_bytes()\n486:    items_hash = hashlib.sha256(stores[1].read_bytes()).hexdigest()\n490:    assert refused.returncode == 1 and hashlib.sha256(same.read_bytes()).hexdigest() == items_hash\n497:    assert linked.returncode == 2 and hashlib.sha256(stores[1].read_bytes()).hexdigest() == items_hash\n503:        assert checked.returncode == 2 and hashlib.sha256(variant.read_bytes()).hexdigest() == items_hash\n640:    command = scratch(tmp_path, [('src/hivemind/release.py', \"    descriptor, temporary = tempfile.mkstemp(dir=path.parent, prefix=f'.{path.name}.')\",\n810:        manifest['page_sha256'] = page_hash or hashlib.sha256((target / release.PAGE_FILE).read_bytes()).hexdigest()\n814:    original = (out / release.PAGE_FILE).read_bytes()\n","exit_code":0,"status":"completed"}}
