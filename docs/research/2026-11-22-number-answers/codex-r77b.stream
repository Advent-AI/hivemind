{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba tests/test_release.py | sed -n '600,900p'; rg -n 'FORMAT|page_sha256|render_page|index.html|/2|page_' tests/test_release.py\"","aggregated_output":"   600\t                                          f\"        release.publish(staged, out)\\n        {pause_code(signals, 'freed')}staged.mkdir(); (staged / 'marker').write_text('mine')\\n\")])\n   601\t    done = tmp_path / 'after-out'\n   602\t    code, _, err = run_paused(after, ['build', '--ledger', stores[0], '--items', stores[1], '--out', done], signals, 'freed', lambda: None)\n   603\t    assert code == 0, err\n   604\t    markers = list(tmp_path.glob('.after-out.staging-*/marker'))\n   605\t    assert len(markers) == 1 and markers[0].read_text() == 'mine'\n   606\t\n   607\t\n   608\tdef test_19_a_report_name_taken_during_the_build_survives(stores, tmp_path):\n   609\t    \"\"\"§2 report rows, §6 test 19.\"\"\"\n   610\t    signals = tmp_path / 'signals'\n   611\t    signals.mkdir()\n   612\t    paused = scratch(tmp_path, [('scripts/release_build.py', '    return write_report(summary, report)\\n\\n\\ndef check',\n   613\t                                 f\"    {pause_code(signals, 'report', indent='    ')}return write_report(summary, report)\\n\\n\\ndef check\")])\n   614\t    out = tmp_path / 'release'\n   615\t    marker = tmp_path / 'release.report.json'\n   616\t    code, _, err = run_paused(paused, ['build', '--ledger', stores[0], '--items', stores[1], '--out', out], signals, 'report', lambda: marker.write_text('occupied'))\n   617\t    assert code == 2 and marker.read_text() == 'occupied'\n   618\t    assert any(line.startswith('report not written ([Errno 17] File exists: ') and line.endswith(f\"-> '{marker}'); run check to write it\") for line in err.splitlines()), err\n   619\t    checked = run('check', out, '--ledger', stores[0], '--items', stores[1])\n   620\t    assert checked.returncode == 2 and checked.stdout.startswith(f'passes {out}: ') and marker.read_text() == 'occupied'\n   621\t\n   622\t\n   623\tdef test_20_a_temporary_file_left_after_the_link_still_counts_as_published(stores, tmp_path):\n   624\t    \"\"\"§1 publish_report, §6 test 20.\"\"\"\n   625\t    command = scratch(tmp_path, [('src/hivemind/release.py', '    try:\\n        os.unlink(temporary)\\n    except OSError:',\n   626\t                                  \"    try:\\n        raise PermissionError('test: cannot remove')\\n    except OSError:\")])\n   627\t    out = tmp_path / 'release'\n   628\t    result = subprocess.run([sys.executable, str(command), 'build', '--ledger', stores[0], '--items', stores[1], '--out', out], capture_output=True, text=True)\n   629\t    leftovers = list(tmp_path.glob('.release.report.json.*'))\n   630\t    assert result.returncode == 0 and len(leftovers) == 1\n   631\t    stderr_line(result, f'report published; its temporary file {leftovers[0]} could not be removed')\n   632\t    assert json.loads(out.with_name('release.report.json').read_text())['as_of'] == DAYS[2]\n   633\t    assert list(tmp_path.glob('.release.report.json.*'))\n   634\t\n   635\t\n   636\tdef test_21_check_that_cannot_write_its_report_exits_2(stores, tmp_path):\n   637\t    \"\"\"§1 check's statuses, §6 test 21.\"\"\"\n   638\t    out = tmp_path / 'release'\n   639\t    build_package(stores, out)\n   640\t    command = scratch(tmp_path, [('src/hivemind/release.py', \"    descriptor, temporary = tempfile.mkstemp(dir=path.parent, prefix=f'.{path.name}.')\",\n   641\t                                  \"    raise PermissionError('test: cannot create')\")])\n   642\t    result = subprocess.run([sys.executable, str(command), 'check', out, '--ledger', stores[0], '--items', stores[1]], capture_output=True, text=True)\n   643\t    assert result.returncode == 2 and result.stdout.startswith(f'passes {out}: ')\n   644\t    stderr_line(result, 'report not written (test: cannot create); run check to write it')\n   645\t    printed = json.loads(result.stdout[result.stdout.index('\\n{') + 1:])    # the whole report, printed on its own lines, though not written\n   646\t    assert set(printed) == REPORT_KEYS and (printed['ledger'], printed['items'], printed['as_of']) == (str(stores[0]), str(stores[1]), DAYS[2])\n   647\t    assert printed['counts'] == FIXTURE_COUNTS and printed['withheld_unresolved'] == FIXTURE_UNRESOLVED and printed['data_bytes'] == FIXTURE_DATA_BYTES\n   648\t    assert printed['export_seconds'] is None and printed['check_seconds'] >= 0\n   649\t\n   650\t\n   651\t# ---------- council 75: key visibility, text fields, store paths, the writer's own refusal\n   652\t\n   653\t\n   654\tdef test_22_a_key_written_after_the_day_does_not_reclassify_it(stores, tmp_path):\n   655\t    \"\"\"§1 question_class (council 75): a question with no key on 08-24 that gains an event key on 08-25 stays a number question in\n   656\t    the 08-24 package.\"\"\"\n   657\t    conn = store.open_db(str(stores[0]))\n   658\t    store.create_view(conn, view_id='v8', looks_at='NVIDIA buyback', question='How large a buyback will NVIDIA announce by 2027?',\n   659\t                      rungs=[{'label': 'Above the estimate', 'condition': 'At least $60 billion'}, {'label': 'Below the estimate', 'condition': 'Less than $60 billion'}],\n   660\t                      object_id='NVDA', object_kind='company', kind='asset', due_day='2027-01-31', year='2027', seq=1, input_id='item-1', created_at='2026-08-24T12:00:00Z')\n   661\t    judge(conn, 'v8', 1, 1, 'The estimate is about $70 billion.')\n   662\t    store.insert(conn, 'view_keys', view_id='v8', measure='event', scope='NVIDIA', scope_key='nvidia', period_start='2026-02-01', period_end='2027-01-31',\n   663\t                 basis='n/a', unit='n/a', event_type='other', seq=2, scope_source='model', key_version=1)\n   664\t    conn.commit()\n   665\t    conn.close()\n   666\t    early, late = by_id(export(stores, DAYS[0]))['v8'], by_id(export(stores, DAYS[1]))['v8']\n   667\t    assert (early['class'], early.get('forecast')) == ('number', MARKER)\n   668\t    assert (late['class'], late['answer']) == ('event', 'Above the estimate')\n   669\t    out = tmp_path / 'early'\n   670\t    build_package(stores, out, DAYS[0])\n   671\t    assert by_id(release.read_data(out))['v8']['class'] == 'number'\n   672\t\n   673\t\n   674\tEVIDENCE_COLUMNS = {'one_line': 'one_line', 'quote': 'quote', 'tier': 'tier', 'speaker': 'speaker', 'original_who': 'original_who', 'original_day': 'original_day'}\n   675\tSOURCE_COLUMNS = {'title': ('items', 'title'), 'publisher': ('items', 'publisher'), 'uri': ('items', 'source_uri'), 'day': ('sources', 'publication_day')}\n   676\t\n   677\t\n   678\t@pytest.mark.parametrize('field', [*EVIDENCE_COLUMNS, *SOURCE_COLUMNS])\n   679\tdef test_23_every_evidence_and_source_text_field_must_be_text(tmp_path, field):\n   680\t    \"\"\"§1 check_export (council 75): a null in any of the ten text fields the closed set requires is refused, at the writer.\"\"\"\n   681\t    views, items = make_store(tmp_path / 'views.sqlite'), make_items(tmp_path / 'items.sqlite', ids=('item-1', 'item-2', 'item-3', 'item-9'))\n   682\t    conn = store.open_db(str(views))\n   683\t    values = dict(evidence_id='e7', quote='Officials said the rule would be published.', one_line='Officials expect the rule.', speaker='Publisher',\n   684\t                  original_who='Officials', original_day=DAYS[0], tier='party_statement', event_time=None, created_seq=1, created_from_input='item-9')\n   685\t    if field in EVIDENCE_COLUMNS:\n   686\t        values[EVIDENCE_COLUMNS[field]] = None\n   687\t    store.insert(conn, 'evidence', **values)\n   688\t    store.insert(conn, 'evidence_links', evidence_id='e7', view_id='v6', seq=1)\n   689\t    store.insert(conn, 'evidence_sources', evidence_id='e7', input_id='item-9', category='T1',\n   690\t                 publication_day=None if field == 'day' else DAYS[0], seq=1)\n   691\t    conn.commit()\n   692\t    conn.close()\n   693\t    if field in SOURCE_COLUMNS and SOURCE_COLUMNS[field][0] == 'items':\n   694\t        items_conn = sqlite3.connect(items)\n   695\t        items_conn.execute(f\"update items set {SOURCE_COLUMNS[field][1]} = null where input_id = 'item-9'\")\n   696\t        items_conn.commit()\n   697\t        items_conn.close()\n   698\t    where = 'question v6 evidence e7' + ('' if field in EVIDENCE_COLUMNS else ' source')\n   699\t    refused_with(lambda: export((views, items)), f'{where}: {field} is not text')\n   700\t\n   701\t\n   702\tdef test_24_a_store_path_with_uri_syntax_is_refused(stores, tmp_path):\n   703\t    \"\"\"§1 store_path (councils 75, 75b): a path holding a character the SQLite URI opener decodes is refused before anything is opened;\n   704\t    an accepted path is returned resolved, so the opener does not resolve a link a second time.\"\"\"\n   705\t    odd = tmp_path / 'a%2Db'\n   706\t    odd.mkdir()\n   707\t    shutil.copyfile(stores[0], odd / 'views.sqlite')\n   708\t    message = f\"{odd / 'views.sqlite'}: a store path may not contain ['%'], which the SQLite opener reads as URI syntax\"\n   709\t    refused_with(lambda: release.store_path(odd / 'views.sqlite'), message)\n   710\t    result = run('build', '--ledger', odd / 'views.sqlite', '--items', stores[1], '--out', tmp_path / 'release')\n   711\t    assert result.returncode == 1 and not (tmp_path / 'release').exists()\n   712\t    stderr_line(result, f'refused: ReleaseRefused: {message}')\n   713\t    assert release.store_path(stores[0]) == os.path.realpath(stores[0])\n   714\t    link = tmp_path / 'link.sqlite'\n   715\t    link.symlink_to(stores[0])\n   716\t    assert release.store_path(link) == os.path.realpath(stores[0])          # the opener is given the target, with nothing left to follow\n   717\t\n   718\t\n   719\tDRIVER = \"\"\"import sys\n   720\tsys.path.insert(0, sys.argv[1])\n   721\tfrom hivemind import release, service\n   722\tfrom hivemind.views import store\n   723\tviews, items = service.open_ledger(sys.argv[2]), store.open_read_only(sys.argv[3])\n   724\ttry:\n   725\t    data = release.release_export(views, items)\n   726\t    print('returned', sorted(data['questions'][0]))\n   727\texcept release.ReleaseRefused as error:\n   728\t    print('refused', error)\n   729\t\"\"\"\n   730\tWRITER_FAULT = (\"                record['forecast'] = FORECAST_UNAVAILABLE\\n            else:\\n                record['answers'] = labels\\n                record['answer'] = _answer(\",\n   731\t                \"                record['forecast'] = FORECAST_UNAVAILABLE\\n                record['condition'] = 'FY2027 revenue is at least $350 billion'\\n            else:\\n\"\n   732\t                \"                record['answers'] = labels\\n                record['answer'] = _answer(\")\n   733\tSELF_CHECK = (\"    check_export(data)\\n    return data\\n\", \"    return data\\n\")\n   734\t\n   735\t\n   736\tdef test_25_the_writer_refuses_its_own_off_list_field(stores, tmp_path):\n   737\t    \"\"\"§1 release_export (AGENTS §3, council 75), the mutation pair: a writer fault adding `condition` is refused inside\n   738\t    `release_export`; with the writer's own check removed, the off-list field is returned.\"\"\"\n   739\t    driver = tmp_path / 'driver.py'\n   740\t    driver.write_text(DRIVER)\n   741\t    for name, edits, expected in (('fault', [WRITER_FAULT], 'refused'), ('unchecked', [WRITER_FAULT, SELF_CHECK], 'returned')):\n   742\t        command = scratch(tmp_path / name, [('src/hivemind/release.py', *edit) for edit in edits])\n   743\t        result = subprocess.run([sys.executable, str(driver), str(command.parents[1] / 'src'), str(stores[0]), str(stores[1])], capture_output=True, text=True,\n   744\t                                env={**os.environ, 'PYTHONDONTWRITEBYTECODE': '1'})\n   745\t        assert result.stdout.startswith(expected), (name, result.stdout, result.stderr)\n   746\t        if name == 'unchecked':\n   747\t            assert result.stdout.strip() == \"returned ['class', 'condition', 'evidence', 'forecast', 'id', 'open', 'question']\", result.stdout\n   748\t        else:\n   749\t            assert result.stdout.strip() == \"refused question 0: keys off the allow-list ['condition'], missing []\", result.stdout\n   750\t\n   751\t\n   752\t# ---------- slice 2: the reader's page (RELEASE-PAGE.md revision 7)\n   753\t\n   754\timport base64  # noqa: E402\n   755\timport re  # noqa: E402\n   756\t\n   757\tNETWORK_APIS = ('fetch', 'XMLHttpRequest', 'WebSocket', 'EventSource', 'sendBeacon', 'import(', 'Worker', 'innerHTML', 'outerHTML',\n   758\t                'insertAdjacentHTML', 'document.write', 'eval(', 'Function(', \"createElement('a')\", 'href', 'src')\n   759\tCLIPPING_PROPERTIES = ('content', 'overflow', 'overflow-x', 'overflow-y', 'clip', 'clip-path', 'contain', 'text-overflow', 'line-clamp',\n   760\t                       '-webkit-line-clamp', 'max-height', 'opacity', 'visibility')\n   761\t\n   762\t\n   763\tdef test_26_the_page_is_a_pure_function_of_the_data_with_literal_escapes():\n   764\t    \"\"\"RELEASE-PAGE.md §5 tests 1 and 2: the same data gives the same page; <, >, &, U+2028 and U+2029 become their six-character\n   765\t    JSON escapes, so the data block cannot close or comment out, and it parses back to the same data.\"\"\"\n   766\t    hostile = '</script><img src=x onerror=alert(1)> & a line' + chr(0x2028) + 'break' + chr(0x2029) + '<!--'\n   767\t    payload = json.dumps({'quote': hostile}, ensure_ascii=False).encode()\n   768\t    page = release.render_page(payload)\n   769\t    assert page == release.render_page(payload)\n   770\t    block = page.decode().split('<script type=\"application/json\" id=\"release-data\">')[1].split('</script>')[0]\n   771\t    backslash = chr(92)\n   772\t    assert block == payload.decode().replace('<', backslash + 'u003c').replace('>', backslash + 'u003e').replace('&', backslash + 'u0026') \\\n   773\t        .replace(chr(0x2028), backslash + 'u2028').replace(chr(0x2029), backslash + 'u2029')\n   774\t    assert '</script' not in block and '<!--' not in block and json.loads(block) == {'quote': hostile}\n   775\t    assert page.decode().count('<script') == 2\n   776\t\n   777\t\n   778\tdef test_27_the_template_has_no_network_code_drawn_text_or_clipping():\n   779\t    \"\"\"RELEASE-PAGE.md §5 test 3: the script uses no network or markup-writing API and makes no link; the stylesheet draws no text and\n   780\t    clips nothing; the CSP is exactly the designed policy with the hashes of the template's own script and style; charset and CSP\n   781\t    come first.\"\"\"\n   782\t    for api in NETWORK_APIS:\n   783\t        assert api not in release.PAGE_SCRIPT, api\n   784\t    for name in CLIPPING_PROPERTIES:\n   785\t        assert not re.search(r'(?<![-\\w])' + re.escape(name) + r'\\s*:', release.PAGE_STYLE), name\n   786\t    assert 'nowrap' not in release.PAGE_STYLE\n   787\t    digest = lambda text: \"'sha256-\" + base64.b64encode(hashlib.sha256(text.encode()).digest()).decode() + \"'\"\n   788\t    csp = (f\"default-src 'none'; script-src {digest(release.PAGE_SCRIPT)}; style-src {digest(release.PAGE_STYLE)}; img-src 'none'; \"\n   789\t           \"font-src 'none'; connect-src 'none'; base-uri 'none'; form-action 'none'\")\n   790\t    template = release.page_template()\n   791\t    assert template.startswith('<!doctype html>\\n<html lang=\"en\">\\n<head>\\n<meta charset=\"utf-8\">\\n'\n   792\t                               f'<meta http-equiv=\"Content-Security-Policy\" content=\"{csp}\">\\n')\n   793\t    assert template.count(release.DATA_PLACEHOLDER) == 1\n   794\t\n   795\t\n   796\tdef test_28_the_package_page_must_be_the_page_of_its_data(stores, tmp_path):\n   797\t    \"\"\"RELEASE-PAGE.md §5 test 4: a page changed by one byte, or with a fetch added and its CSP and hashes updated, is refused because\n   798\t    it is not render_page(data); a correct page with only its manifest hash wrong is refused for that reason; a fourth file is\n   799\t    refused.\"\"\"\n   800\t    out = tmp_path / 'release'\n   801\t    build_package(stores, out)\n   802\t    assert check(stores, out)['fields_compared'] == FIXTURE_COUNTS['fields_compared']\n   803\t\n   804\t    def copy_with(name, page=None, page_hash=None):\n   805\t        target = tmp_path / name\n   806\t        shutil.copytree(out, target)\n   807\t        if page is not None:\n   808\t            (target / release.PAGE_FILE).write_bytes(page)\n   809\t        manifest = json.loads((target / release.MANIFEST_FILE).read_text())\n   810\t        manifest['page_sha256'] = page_hash or hashlib.sha256((target / release.PAGE_FILE).read_bytes()).hexdigest()\n   811\t        (target / release.MANIFEST_FILE).write_text(json.dumps(manifest))\n   812\t        return target\n   813\t\n   814\t    original = (out / release.PAGE_FILE).read_bytes()\n   815\t    one_byte = copy_with('one-byte', original.replace(b'needs JavaScript', b'needs Javascript'))\n   816\t    refused_with(lambda: check(stores, one_byte), 'the page is not the page made from its data')\n   817\t    script = release.PAGE_SCRIPT\n   818\t    added = script.replace(\"(function(){'use strict';\", \"(function(){'use strict';fetch('http://127.0.0.1:59999/library').catch(function(){});\")\n   819\t    digest = lambda text: \"'sha256-\" + base64.b64encode(hashlib.sha256(text.encode()).digest()).decode() + \"'\"\n   820\t    fetching = original.decode().replace(script, added).replace(digest(script), digest(added)).encode()\n   821\t    assert fetching != original\n   822\t    refused_with(lambda: check(stores, copy_with('fetching', fetching)), 'the page is not the page made from its data')\n   823\t    wrong_hash = copy_with('wrong-hash', page_hash='0' * 64)\n   824\t    refused_with(lambda: check(stores, wrong_hash), 'the manifest page_sha256 does not match the page')\n   825\t    fourth = tmp_path / 'fourth'\n   826\t    shutil.copytree(out, fourth)\n   827\t    (fourth / 'extra.html').write_text('<p>x</p>')\n   828\t    refused_with(lambda: check(stores, fourth), f\"{fourth}: holds ['extra.html', 'index.html', 'manifest.json', 'release-data.json'], \"\n   829\t                                                \"not exactly ['index.html', 'manifest.json', 'release-data.json']\")\n   830\t\n   831\t\n   832\tCERTIFIED_TEMPLATE_SHA256 = 'f94bb3cbf5ba1030ee37f0111b78bf2e58f7f767d77aa7e7d2443677e5811ae2'   # certified by poc/data/release-screen-2026-11-23b\n   833\t\n   834\t\n   835\tdef test_29_the_page_template_is_the_one_the_screen_run_certified():\n   836\t    \"\"\"RELEASE-PAGE.md revision 7, test 3: the whole page template, with its data placeholder, is the one the $0 screen run certified\n   837\t    (poc/data/release-screen-2026-11-23b); any change to any part of it fails here until a new screen run certifies it.\"\"\"\n   838\t    assert hashlib.sha256(release.page_template().encode('utf-8')).hexdigest() == CERTIFIED_TEMPLATE_SHA256\n1:\"\"\"The \"Forecast unavailable\" release package (docs/research/2026-11-22-number-answers/RELEASE-BUILD.md, revision 10; D726, D758).\n183:    page = release.render_page(payload)\n187:    manifest.update(as_of=data['as_of'], data_sha256=hashlib.sha256(payload).hexdigest(), page_sha256=hashlib.sha256(page).hexdigest())\n210:    assert (data['format'], data['allow_list']) == ('hivemind-release/2', 'release-allow-list/1')     # RELEASE-PAGE.md's identifiers, literal\n308:    files = \"not exactly ['index.html', 'manifest.json', 'release-data.json']\"\n310:        'foreign file': (lambda p: (p / 'notes.txt').write_text('x'), lambda p: f\"{p}: holds ['index.html', 'manifest.json', 'notes.txt', 'release-data.json'], {files}\"),\n311:        'subdirectory': (lambda p: (p / 'extra').mkdir(), lambda p: f\"{p}: holds ['extra', 'index.html', 'manifest.json', 'release-data.json'], {files}\"),\n312:        'missing page': (lambda p: (p / 'index.html').unlink(), lambda p: f\"{p}: holds ['manifest.json', 'release-data.json'], {files}\"),\n763:def test_26_the_page_is_a_pure_function_of_the_data_with_literal_escapes():\n768:    page = release.render_page(payload)\n769:    assert page == release.render_page(payload)\n790:    template = release.page_template()\n796:def test_28_the_package_page_must_be_the_page_of_its_data(stores, tmp_path):\n798:    it is not render_page(data); a correct page with only its manifest hash wrong is refused for that reason; a fourth file is\n804:    def copy_with(name, page=None, page_hash=None):\n810:        manifest['page_sha256'] = page_hash or hashlib.sha256((target / release.PAGE_FILE).read_bytes()).hexdigest()\n823:    wrong_hash = copy_with('wrong-hash', page_hash='0' * 64)\n824:    refused_with(lambda: check(stores, wrong_hash), 'the manifest page_sha256 does not match the page')\n828:    refused_with(lambda: check(stores, fourth), f\"{fourth}: holds ['extra.html', 'index.html', 'manifest.json', 'release-data.json'], \"\n829:                                                \"not exactly ['index.html', 'manifest.json', 'release-data.json']\")\n835:def test_29_the_page_template_is_the_one_the_screen_run_certified():\n838:    assert hashlib.sha256(release.page_template().encode('utf-8')).hexdigest() == CERTIFIED_TEMPLATE_SHA256\n","exit_code":0,"status":"completed"}}
