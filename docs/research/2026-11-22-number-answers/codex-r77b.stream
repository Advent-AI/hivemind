{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba src/hivemind/release.py | sed -n '1,85p;400,680p'\"","aggregated_output":"     1\t\"\"\"The \"Forecast unavailable\" release: one allow-listed export of a views ledger, its package and its checks\n     2\t(docs/research/2026-11-22-number-answers/RELEASE-BUILD.md; D726, D756, D758).\n     3\t\n     4\tA number question carries its question, its evidence in force and the marker \"Forecast unavailable\". An event or Yes/No question\n     5\tcarries its question, its evidence and its answer labels. Nothing else is read into the package: no rung condition or bound, no\n     6\tjudgement reason or explanation, no switch reason, no history. Before a package is published, every field is compared with its\n     7\tstored source at the package's day, and nothing published replaces an existing path.\n     8\t\"\"\"\n     9\timport base64\n    10\timport ctypes\n    11\timport ctypes.util\n    12\timport errno\n    13\timport hashlib\n    14\timport json\n    15\timport os\n    16\timport stat\n    17\timport sys\n    18\timport tempfile\n    19\tfrom datetime import date\n    20\tfrom pathlib import Path\n    21\t\n    22\tfrom . import bundle, service, vocabulary\n    23\tfrom .views import identity, store\n    24\t\n    25\tFORMAT = 'hivemind-release/2'           # 2: the package holds the reader's page (RELEASE-PAGE.md)\n    26\tALLOW_LIST = 'release-allow-list/1'\n    27\tFORECAST_UNAVAILABLE = 'Forecast unavailable'\n    28\tDATA_FILE = 'release-data.json'\n    29\tMANIFEST_FILE = 'manifest.json'\n    30\tPAGE_FILE = 'index.html'\n    31\tPACKAGE_FILES = frozenset({DATA_FILE, MANIFEST_FILE, PAGE_FILE})\n    32\tCLASSES = ('number', 'event', 'yes_no')\n    33\tALLOWED = {\n    34\t    'envelope': frozenset({'format', 'allow_list', 'as_of', 'questions'}),\n    35\t    'number': frozenset({'id', 'question', 'open', 'class', 'forecast', 'evidence'}),\n    36\t    'answered': frozenset({'id', 'question', 'open', 'class', 'answers', 'answer', 'evidence'}),\n    37\t    'evidence': frozenset({'id', 'one_line', 'quote', 'tier', 'speaker', 'original_who', 'original_day', 'sources'}),\n    38\t    'source': frozenset({'title', 'publisher', 'day', 'uri'}),\n    39\t    'manifest': frozenset({'format', 'allow_list', 'as_of', 'data_sha256', 'page_sha256'}),\n    40\t}\n    41\tEVIDENCE_TEXT = ('one_line', 'quote', 'tier', 'speaker', 'original_who', 'original_day')\n    42\tSOURCE_TEXT = ('title', 'publisher', 'day', 'uri')\n    43\tRENAME_EXCL = 0x4          # macOS <stdio.h>: renamex_np refuses an existing destination\n    44\tRENAME_NOREPLACE = 0x1     # Linux <linux/fs.h>: renameat2 refuses an existing destination\n    45\tAT_FDCWD = -100\n    46\t\n    47\t\n    48\tclass ReleaseRefused(ValueError):\n    49\t    \"\"\"The release refuses the input, the export or the package; the message names what and where.\"\"\"\n    50\t\n    51\t\n    52\t# ---------- the day\n    53\t\n    54\tdef canonical_day(text):\n    55\t    \"\"\"A day written YYYY-MM-DD, returned unchanged; anything else is refused. The stores compare days as text, so a day Python\n    56\t    also reads (20260825) would select rows from later days.\"\"\"\n    57\t    try:\n    58\t        day = date.fromisoformat(text)\n    59\t    except (TypeError, ValueError):\n    60\t        raise ReleaseRefused(f'not a day: {text!r}') from None\n    61\t    if day.isoformat() != text:\n    62\t        raise ReleaseRefused(f'a day must be written YYYY-MM-DD: {text!r}')\n    63\t    return text\n    64\t\n    65\t\n    66\tdef resolve(views_db, as_of=None):\n    67\t    \"\"\"The bound of a build or a check, one rule for both: a given day must be canonical; `service.resolve_bound` then refuses an\n    68\t    unfinished first day or a day after the last completed day; an omitted day with no default is refused.\"\"\"\n    69\t    if as_of is not None:\n    70\t        canonical_day(as_of)\n    71\t    bound = service.resolve_bound(views_db, as_of)\n    72\t    if not bound:\n    73\t        raise ReleaseRefused('the store has no default day; supply --as-of')\n    74\t    return canonical_day(bound)\n    75\t\n    76\t\n    77\t# ---------- identity\n    78\t\n    79\tdef _has_table(conn, name):\n    80\t    return conn.execute(\"select 1 from sqlite_master where type='table' and name=?\", (name,)).fetchone() is not None\n    81\t\n    82\t\n    83\tdef key_measure(conn, view_id, as_of):\n    84\t    \"\"\"The measure of the view's key as recorded on or before the day, or None: no key table, no key, or a key written after the\n    85\t    day (a later key never reclassifies an earlier package).\"\"\"\n   400\t    trust; this reader is for inspection only.\"\"\"\n   401\t    return _parse((Path(package) / DATA_FILE).read_bytes(), DATA_FILE)\n   402\t\n   403\t\n   404\tURI_CHARACTERS = '%?#'\n   405\t\n   406\t\n   407\tdef store_path(path):\n   408\t    \"\"\"The resolved store path, the one the opener is then given (so the opener's own resolution has nothing left to follow): refused\n   409\t    when it holds a character a SQLite URI decodes (`store.open_read_only` puts the path into a `file:` URI unescaped, so `%2D` would\n   410\t    open a `-`).\"\"\"\n   411\t    real = os.path.realpath(path)\n   412\t    found = sorted({c for c in real if c in URI_CHARACTERS})\n   413\t    if found:\n   414\t        raise ReleaseRefused(f'{path}: a store path may not contain {found}, which the SQLite opener reads as URI syntax')\n   415\t    return real\n   416\t\n   417\t\n   418\tdef _read_regular(folder, name, where):\n   419\t    \"\"\"The bytes of one regular file in an opened folder, read once through a descriptor that refuses a symbolic link and opens a pipe\n   420\t    without waiting, so its type is refused instead.\"\"\"\n   421\t    try:\n   422\t        descriptor = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=folder)   # a pipe or device never blocks the check\n   423\t    except OSError as error:\n   424\t        if error.errno == errno.ELOOP:\n   425\t            raise ReleaseRefused(f'{where}/{name}: not a regular file') from None\n   426\t        raise\n   427\t    try:\n   428\t        if not stat.S_ISREG(os.fstat(descriptor).st_mode):\n   429\t            raise ReleaseRefused(f'{where}/{name}: not a regular file')\n   430\t        chunks = []\n   431\t        while True:\n   432\t            chunk = os.read(descriptor, 1 << 20)\n   433\t            if not chunk:\n   434\t                return b''.join(chunks)\n   435\t            chunks.append(chunk)\n   436\t    finally:\n   437\t        os.close(descriptor)\n   438\t\n   439\t\n   440\tdef _parse(raw, name):\n   441\t    try:\n   442\t        return json.loads(raw.decode('utf-8'), object_pairs_hook=_unique_members)\n   443\t    except (UnicodeDecodeError, json.JSONDecodeError) as error:\n   444\t        raise ReleaseRefused(f'{name}: not JSON ({error})') from None\n   445\t\n   446\t\n   447\tdef check_package(path, views_db=None, items_db=None, expected_as_of=None):\n   448\t    \"\"\"The package as a reader receives it: a real folder holding exactly the two regular files, each read once through one handle on\n   449\t    the folder; JSON with no repeated member name; a closed manifest that agrees with the data and the sha256 of the very bytes\n   450\t    parsed; data that passes `check_export` and, with the stores, `check_origins` at `expected_as_of` (or at the package's own day\n   451\t    passed through `resolve`); and a page equal, byte for byte, to `render_page` of the very data bytes checked. Returns (counts, the data\n   452\t    checked, its size in bytes).\"\"\"\n   453\t    path = Path(path)\n   454\t    try:\n   455\t        folder = os.open(path, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)\n   456\t    except OSError as error:\n   457\t        if error.errno in (errno.ELOOP, errno.ENOTDIR):\n   458\t            raise ReleaseRefused(f'{path}: not a folder') from None\n   459\t        raise\n   460\t    try:\n   461\t        names = os.listdir(folder)\n   462\t        if sorted(names) != sorted(PACKAGE_FILES):\n   463\t            raise ReleaseRefused(f'{path}: holds {sorted(names)}, not exactly {sorted(PACKAGE_FILES)}')\n   464\t        raw, manifest_raw, page = (_read_regular(folder, DATA_FILE, path), _read_regular(folder, MANIFEST_FILE, path),\n   465\t                                   _read_regular(folder, PAGE_FILE, path))\n   466\t    finally:\n   467\t        os.close(folder)\n   468\t    manifest, data = _parse(manifest_raw, MANIFEST_FILE), _parse(raw, DATA_FILE)\n   469\t    counts = check_export(data)\n   470\t    _keys(manifest, 'manifest', 'the manifest')\n   471\t    if manifest['data_sha256'] != hashlib.sha256(raw).hexdigest():\n   472\t        raise ReleaseRefused('the manifest sha256 does not match the data file')\n   473\t    if page != render_page(raw):\n   474\t        raise ReleaseRefused('the page is not the page made from its data')\n   475\t    if manifest['page_sha256'] != hashlib.sha256(page).hexdigest():\n   476\t        raise ReleaseRefused('the manifest page_sha256 does not match the page')\n   477\t    for name in ('format', 'allow_list', 'as_of'):\n   478\t        if manifest[name] != data[name]:\n   479\t            raise ReleaseRefused(f'the manifest {name} {manifest[name]!r} differs from the data {data[name]!r}')\n   480\t    if views_db is not None:\n   481\t        bound = expected_as_of if expected_as_of is not None else resolve(views_db, data['as_of'])\n   482\t        counts['fields_compared'] = check_origins(views_db, items_db, data, bound)\n   483\t    return counts, data, len(raw)\n   484\t\n   485\t\n   486\t# ---------- the reader's page (slice 2, RELEASE-PAGE.md)\n   487\t\n   488\tPAGE_STYLE = (\n   489\t    ':root{--paper:#f5f2eb;--wash:#ebe9e2;--rule:#dfddd6;--ink:#0f140d;--ink-2:#393d36;--ink-3:#6a6c65;color-scheme:light dark}'\n   490\t    '@media (prefers-color-scheme: dark){:root{--paper:#0f140d;--wash:#1b2018;--rule:#393d36;--ink:#f5f2eb;--ink-2:#dfddd6;--ink-3:#9f9f98}}'\n   491\t    '*{box-sizing:border-box}'\n   492\t    'body{margin:0;background:var(--paper);color:var(--ink);font:15px/1.5 \"Helvetica Neue\",Helvetica,Arial,sans-serif}'\n   493\t    'main{max-width:860px;margin:0 auto;padding:24px 16px 64px}'\n   494\t    '#fallback{max-width:860px;margin:24px auto;padding:0 16px;color:var(--ink-2)}'\n   495\t    '.release-title{font-size:22px;font-weight:600;margin:0 0 4px}'\n   496\t    '.release-day,.release-counts{margin:0;color:var(--ink-3);font-size:13px}'\n   497\t    '.release-header{border-bottom:1px solid var(--rule);padding-bottom:16px;margin-bottom:8px}'\n   498\t    '.question{border-bottom:1px solid var(--rule);padding:16px 0}'\n   499\t    '.question-text{font-size:16px;font-weight:600;margin:0 0 6px;overflow-wrap:anywhere}'\n   500\t    '.question-status{display:inline-block;margin:0 12px 0 0;font-size:12px;color:var(--ink-3);text-transform:none}'\n   501\t    '.question-forecast,.question-answer{display:inline-block;margin:0;font-size:13px;padding:1px 8px;border:1px solid var(--rule);border-radius:999px;background:var(--wash)}'\n   502\t    '.evidence{margin-top:10px}'\n   503\t    '.evidence-count{cursor:pointer;font-size:13px;color:var(--ink-2)}'\n   504\t    '.evidence-none{margin:10px 0 0;font-size:13px;color:var(--ink-3)}'\n   505\t    '.evidence-list{margin:8px 0 0;padding-left:20px}'\n   506\t    '.evidence-item{margin:0 0 14px}'\n   507\t    '.evidence-summary{margin:0 0 4px;overflow-wrap:anywhere}'\n   508\t    '.evidence-quote{margin:0 0 4px;padding-left:10px;border-left:2px solid var(--rule);color:var(--ink-2);overflow-wrap:anywhere}'\n   509\t    '.evidence-meta{margin:0 0 4px;font-size:12px;color:var(--ink-3);overflow-wrap:anywhere}'\n   510\t    '.source-list{margin:0;padding-left:16px;font-size:12px;color:var(--ink-3)}'\n   511\t    '.source>span{overflow-wrap:anywhere;margin-right:12px}'\n   512\t)\n   513\t\n   514\tPAGE_SCRIPT = (\n   515\t    \"(function(){'use strict';\"\n   516\t    \"var data=JSON.parse(document.getElementById('release-data').textContent);\"\n   517\t    \"var root=document.getElementById('release');\"\n   518\t    \"function el(tag,cls,text){var e=document.createElement(tag);if(cls){e.className=cls;}if(text!==undefined){e.textContent=text;}return e;}\"\n   519\t    \"function piece(e){var item=el('li','evidence-item');\"\n   520\t    \"item.appendChild(el('p','evidence-summary',e.one_line));\"\n   521\t    \"item.appendChild(el('blockquote','evidence-quote',e.quote));\"\n   522\t    \"item.appendChild(el('p','evidence-meta',e.tier+' \\\\u00b7 '+e.speaker+' \\\\u00b7 original: '+e.original_who+(e.original_day?', '+e.original_day:'')));\"\n   523\t    \"var sources=el('ul','source-list');\"\n   524\t    \"e.sources.forEach(function(s){var row=el('li','source');\"\n   525\t    \"row.appendChild(el('span','source-title',s.title));row.appendChild(el('span','source-publisher',s.publisher));\"\n   526\t    \"row.appendChild(el('span','source-day',s.day));row.appendChild(el('span','source-address',s.uri));sources.appendChild(row);});\"\n   527\t    \"item.appendChild(sources);return item;}\"\n   528\t    \"var counts={number:0,event:0,yes_no:0};data.questions.forEach(function(q){counts[q['class']]+=1;});\"\n   529\t    \"var header=el('header','release-header');header.appendChild(el('h1','release-title','Hivemind release'));\"\n   530\t    \"header.appendChild(el('p','release-day','As of '+data.as_of));\"\n   531\t    \"header.appendChild(el('p','release-counts',counts.number+' number questions \\\\u00b7 '+counts.event+' event questions \\\\u00b7 '+counts.yes_no+' Yes/No questions'));\"\n   532\t    \"root.appendChild(header);\"\n   533\t    \"if(!data.questions.length){root.appendChild(el('p','release-empty','No questions as of '+data.as_of));}\"\n   534\t    \"data.questions.forEach(function(q){var card=el('article','question');card.dataset.id=q.id;\"\n   535\t    \"card.appendChild(el('h2','question-text',q.question));card.appendChild(el('p','question-status',q.open?'Open':'Closed'));\"\n   536\t    \"if(q['class']==='number'){card.appendChild(el('p','question-forecast',q.forecast));}\"\n   537\t    \"else{card.appendChild(el('p','question-answer',q.answer===null?'Not yet answered':'Answer: '+q.answer));}\"\n   538\t    \"var n=q.evidence.length;\"\n   539\t    \"if(!n){card.appendChild(el('p','evidence-none','No evidence in force'));}\"\n   540\t    \"else{var details=el('details','evidence');details.appendChild(el('summary','evidence-count',n+(n===1?' piece of evidence':' pieces of evidence')));\"\n   541\t    \"var list=null;details.addEventListener('toggle',function(){if(details.open&&!list){list=el('ol','evidence-list');\"\n   542\t    \"q.evidence.forEach(function(e){list.appendChild(piece(e));});details.appendChild(list);}});card.appendChild(details);}\"\n   543\t    \"root.appendChild(card);});\"\n   544\t    \"var fallback=document.getElementById('fallback');fallback.parentNode.removeChild(fallback);\"\n   545\t    \"})();\"\n   546\t)\n   547\t\n   548\tPAGE_CSP = (\"default-src 'none'; script-src {script}; style-src {style}; img-src 'none'; font-src 'none'; connect-src 'none'; \"\n   549\t            \"base-uri 'none'; form-action 'none'\")\n   550\tEMBED_ESCAPED = ('<', '>', '&', chr(0x2028), chr(0x2029))\n   551\t\n   552\t\n   553\tdef _source_hash(text):\n   554\t    return \"'sha256-\" + base64.b64encode(hashlib.sha256(text.encode('utf-8')).digest()).decode('ascii') + \"'\"\n   555\t\n   556\t\n   557\tdef embed(data_bytes):\n   558\t    \"\"\"The data file's text with `<`, `>`, `&`, U+2028 and U+2029 replaced by their six-character JSON escapes: still the same JSON,\n   559\t    and unable to close or comment out the block it sits in.\"\"\"\n   560\t    text = data_bytes.decode('utf-8')\n   561\t    for character in EMBED_ESCAPED:\n   562\t        text = text.replace(character, chr(92) + f'u{ord(character):04x}')\n   563\t    return text\n   564\t\n   565\t\n   566\tDATA_PLACEHOLDER = '@@RELEASE_DATA@@'\n   567\t\n   568\t\n   569\tdef page_template():\n   570\t    \"\"\"The whole reader's page with its one data placeholder: charset and CSP first; the CSP admits only this template's own script and\n   571\t    style and no connection, image, font, base or form target. Its sha256 is pinned in the tests.\"\"\"\n   572\t    csp = PAGE_CSP.format(script=_source_hash(PAGE_SCRIPT), style=_source_hash(PAGE_STYLE))\n   573\t    return ('<!doctype html>\\n<html lang=\"en\">\\n<head>\\n<meta charset=\"utf-8\">\\n'\n   574\t            f'<meta http-equiv=\"Content-Security-Policy\" content=\"{csp}\">\\n'\n   575\t            '<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\\n<title>Hivemind release</title>\\n'\n   576\t            f'<style>{PAGE_STYLE}</style>\\n</head>\\n<body>\\n'\n   577\t            '<p id=\"fallback\">This release page needs JavaScript to show its questions.</p>\\n<main id=\"release\"></main>\\n'\n   578\t            f'<script type=\"application/json\" id=\"release-data\">{DATA_PLACEHOLDER}</script>\\n'\n   579\t            f'<script>{PAGE_SCRIPT}</script>\\n</body>\\n</html>\\n')\n   580\t\n   581\t\n   582\tdef render_page(data_bytes):\n   583\t    \"\"\"The reader's page: the pinned template split once at its placeholder, with the escaped data inserted.\"\"\"\n   584\t    before, after = page_template().split(DATA_PLACEHOLDER)\n   585\t    return (before + embed(data_bytes) + after).encode('utf-8')\n   586\t\n   587\t\n   588\t# ---------- the report\n   589\t\n   590\tdef withheld_unresolved(views_db, data):\n   591\t    \"\"\"For the release report only: the number questions whose ladder does not resolve to bands, with the reason and whether the\n   592\t    view has a key. Withheld like every number question; this list never enters the package.\"\"\"\n   593\t    out = []\n   594\t    for question in data['questions']:\n   595\t        if question['class'] != 'number':\n   596\t            continue\n   597\t        bands, reason = service.ladder_bands(store.rungs_of(views_db, question['id']))\n   598\t        if bands is None:\n   599\t            out.append({'id': question['id'], 'reason': reason, 'has_key': key_measure(views_db, question['id'], data['as_of']) is not None})\n   600\t    return out\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc 'nl -ba docs/research/2026-11-22-number-answers/release_screen_prepare.py; nl -ba poc/data/release-screen-2026-11-23b/screen-results.json'","aggregated_output":"     1\t\"\"\"Prepare the $0 screen check of RELEASE-PAGE.md §6: build the format-2 pages with the real command, and freeze screen-expected.json\n     2\tfrom the accepted slice-1 packages before the first screen run.\n     3\t\n     4\t    python3 docs/research/2026-11-22-number-answers/release_screen_prepare.py <new run folder>\n     5\t\n     6\tThe expected file is written from the data of `poc/data/release-check-2026-11-23g/` (the packages council 75g accepted), not from the\n     7\tpages under test, and its sha256 is printed for the result.\"\"\"\n     8\timport hashlib\n     9\timport json\n    10\timport shutil\n    11\timport subprocess\n    12\timport sys\n    13\tfrom pathlib import Path\n    14\t\n    15\tREPO = Path(__file__).resolve().parents[3]\n    16\tsys.path.insert(0, str(REPO / 'src'))\n    17\tsys.path.insert(0, str(REPO / 'tests'))\n    18\tfrom hivemind import release, service  # noqa: E402\n    19\tfrom hivemind.views import store  # noqa: E402\n    20\t\n    21\tACCEPTED = REPO / 'poc/data/release-check-2026-11-23g'\n    22\tCOMPARISON_ITEMS = REPO / 'poc/data/comparison-2026-11-17/items-comparison.sqlite'\n    23\tOLD = {name: REPO / f'poc/data/comparison-2026-11-17/run/{name}/prod/views.sqlite' for name in ('old-1', 'old-3')}\n    24\tDOT = f' {chr(0xb7)} '\n    25\tESCAPE_QUOTE = '</script><img src=x onerror=alert(1)> & a line' + chr(0x2028) + 'break'\n    26\t\n    27\t\n    28\tdef counts_line(questions):\n    29\t    n = {kind: sum(q['class'] == kind for q in questions) for kind in ('number', 'event', 'yes_no')}\n    30\t    return f\"{n['number']} number questions{DOT}{n['event']} event questions{DOT}{n['yes_no']} Yes/No questions\"\n    31\t\n    32\t\n    33\tdef kept(texts):\n    34\t    \"\"\"The page's reading rule: each text trimmed, empty texts dropped.\"\"\"\n    35\t    return [t.strip() for t in texts if t and t.strip()]\n    36\t\n    37\t\n    38\tdef card_top(q):\n    39\t    n = len(q['evidence'])\n    40\t    status = 'Open' if q['open'] else 'Closed'\n    41\t    shown = q['forecast'] if q['class'] == 'number' else ('Not yet answered' if q['answer'] is None else f\"Answer: {q['answer']}\")\n    42\t    count = 'No evidence in force' if n == 0 else f\"{n} {'piece' if n == 1 else 'pieces'} of evidence\"\n    43\t    return kept([q['question'], status, shown, count])\n    44\t\n    45\t\n    46\tdef group(e):\n    47\t    day = f\", {e['original_day']}\" if e['original_day'] else ''           # the page adds the day only when there is one\n    48\t    texts = [e['one_line'], e['quote'], f\"{e['tier']}{DOT}{e['speaker']}{DOT}original: {e['original_who']}{day}\"]\n    49\t    for s in e['sources']:\n    50\t        texts += [s['title'], s['publisher'], s['day'], s['uri']]\n    51\t    return kept(texts)\n    52\t\n    53\t\n    54\tdef frozen_page(data, checked):\n    55\t    header = kept(['Hivemind release', f\"As of {data['as_of']}\", counts_line(data['questions'])])\n    56\t    cards = [{'id': q['id'], 'top': card_top(q), 'groups': []} for q in data['questions']]\n    57\t    collapsed = {'header': header, 'cards': cards, 'other': [], 'clipped': [], 'unreadable': []}\n    58\t    expanded = json.loads(json.dumps(collapsed))\n    59\t    target = next(c for c in expanded['cards'] if c['id'] == checked)\n    60\t    target['groups'] = [group(e) for e in next(q for q in data['questions'] if q['id'] == checked)['evidence']]\n    61\t    return {'count': len(data['questions']), 'collapsed': collapsed, 'expanded': expanded}\n    62\t\n    63\t\n    64\tdef build(ledger, items, out, as_of=None):\n    65\t    args = [sys.executable, str(REPO / 'scripts/release_build.py'), 'build', '--ledger', str(ledger), '--items', str(items), '--out', str(out)]\n    66\t    result = subprocess.run(args + (['--as-of', as_of] if as_of else []), capture_output=True, text=True, env={'PATH': '/usr/bin:/bin', 'PYTHONDONTWRITEBYTECODE': '1'})\n    67\t    if result.returncode:\n    68\t        raise SystemExit(f'build {out}: {result.stderr}')\n    69\t\n    70\t\n    71\tdef main(run):\n    72\t    run = Path(run).absolute()\n    73\t    run.mkdir()\n    74\t    build(OLD['old-1'], COMPARISON_ITEMS, run / 'old-1')\n    75\t    build(OLD['old-3'], COMPARISON_ITEMS, run / 'old-3-0825', '2026-08-25')\n    76\t    build(OLD['old-1'], COMPARISON_ITEMS, run / 'old-1-0828', '2026-08-28')\n    77\t    import test_release as fixture                                  # the test suite's fixture store, plus one hostile quote\n    78\t    scratch = run / '.escape-stores'\n    79\t    scratch.mkdir()\n    80\t    views, items = fixture.make_store(scratch / 'views.sqlite'), fixture.make_items(scratch / 'items.sqlite')\n    81\t    conn = store.open_db(str(views))\n    82\t    fixture.evidence(conn, 'e9', 'v6', 1, 'A hostile quote, shown as text.', ESCAPE_QUOTE, [('item-1', 1)])\n    83\t    conn.commit()\n    84\t    conn.close()\n    85\t    build(views, items, run / 'escape')\n    86\t    data = lambda folder: json.loads((ACCEPTED / folder / 'release-data.json').read_text())\n    87\t    expected = {\n    88\t        'accepted': str(ACCEPTED),\n    89\t        'pages': {'old-1/v8': frozen_page(data('old-1/package'), 'v8'),\n    90\t                  'old-3/v36@2026-08-25': frozen_page(data('old-3/package-2026-08-25'), 'v36'),\n    91\t                  'old-1/v10@2026-08-28': frozen_page(data('old-1/package-2026-08-28'), 'v10')},\n    92\t        'morningstar_quote': next(e['quote'] for q in data('old-1/package')['questions'] for e in q['evidence'] if e['id'] == 'e2295'),\n    93\t        'escape': {'question': 'v6', 'quote': ESCAPE_QUOTE.strip(), 'count': 7},\n    94\t    }\n    95\t    path = run / 'screen-expected.json'\n    96\t    path.write_text(json.dumps(expected, ensure_ascii=False, indent=1))\n    97\t    print('screen-expected.json sha256', hashlib.sha256(path.read_bytes()).hexdigest())\n    98\t\n    99\t\n   100\tif __name__ == '__main__':\n   101\t    main(sys.argv[1])\n     1\t{\n     2\t \"expected_sha256\": \"7934eb2a816daa2d39f2cde63a312784921d2bb2cacfeb4bd4d0572535651557\",\n     3\t \"pages\": {\n     4\t  \"old-1\": {\n     5\t   \"seconds\": 0.049088541999999964,\n     6\t   \"check\": {\n     7\t    \"outcome\": {\n     8\t     \"collapsed\": true,\n     9\t     \"expanded\": true,\n    10\t     \"reopened\": true\n    11\t    },\n    12\t    \"other\": [],\n    13\t    \"card_top\": [\n    14\t     \"How much Data Center segment revenue will NVIDIA report for FY2027?\",\n    15\t     \"Open\",\n    16\t     \"Forecast unavailable\",\n    17\t     \"1284 pieces of evidence\"\n    18\t    ],\n    19\t    \"card_groups\": 1284\n    20\t   },\n    21\t   \"links\": 0,\n    22\t   \"light_background\": \"rgb(245, 242, 235)\",\n    23\t   \"signals\": {\n    24\t    \"requests\": [\n    25\t     \"file:///Users/lchingen/hivemind/poc/data/release-screen-2026-11-23b/old-1/index.html\"\n    26\t    ],\n    27\t    \"errors\": []\n    28\t   },\n    29\t   \"size\": 5794595,\n    30\t   \"data_size\": 5788634\n    31\t  },\n    32\t  \"old-1 phone dark\": {\n    33\t   \"check\": {\n    34\t    \"outcome\": {\n    35\t     \"collapsed\": true,\n    36\t     \"expanded\": true,\n    37\t     \"reopened\": true\n    38\t    },\n    39\t    \"other\": [],\n    40\t    \"card_top\": [\n    41\t     \"How much Data Center segment revenue will NVIDIA report for FY2027?\",\n    42\t     \"Open\",\n    43\t     \"Forecast unavailable\",\n    44\t     \"1284 pieces of evidence\"\n    45\t    ],\n    46\t    \"card_groups\": 1284\n    47\t   },\n    48\t   \"scroll_width\": 390,\n    49\t   \"dark_background\": \"rgb(15, 20, 13)\",\n    50\t   \"morningstar\": {\n    51\t    \"lines\": 5,\n    52\t    \"left\": 36,\n    53\t    \"right\": 374\n    54\t   },\n    55\t   \"signals\": {\n    56\t    \"requests\": [\n    57\t     \"file:///Users/lchingen/hivemind/poc/data/release-screen-2026-11-23b/old-1/index.html\"\n    58\t    ],\n    59\t    \"errors\": []\n    60\t   }\n    61\t  },\n    62\t  \"old-3/v36@2026-08-25\": {\n    63\t   \"check\": {\n    64\t    \"outcome\": {\n    65\t     \"collapsed\": true,\n    66\t     \"expanded\": true,\n    67\t     \"reopened\": true\n    68\t    },\n    69\t    \"other\": [],\n    70\t    \"card_top\": [\n    71\t     \"Will NVIDIA begin shipping Rubin Ultra by December 31, 2027?\",\n    72\t     \"Open\",\n    73\t     \"Answer: Yes\",\n    74\t     \"1 piece of evidence\"\n    75\t    ],\n    76\t    \"card_groups\": 1\n    77\t   },\n    78\t   \"signals\": {\n    79\t    \"requests\": [\n    80\t     \"file:///Users/lchingen/hivemind/poc/data/release-screen-2026-11-23b/old-3-0825/index.html\"\n    81\t    ],\n    82\t    \"errors\": []\n    83\t   }\n    84\t  },\n    85\t  \"old-1/v10@2026-08-28\": {\n    86\t   \"check\": {\n    87\t    \"outcome\": {\n    88\t     \"collapsed\": true,\n    89\t     \"expanded\": true,\n    90\t     \"reopened\": true\n    91\t    },\n    92\t    \"other\": [],\n    93\t    \"card_top\": [\n    94\t     \"Will NVIDIA complete an investment in Firmus Technologies’ preference shares by December 31, 2026?\",\n    95\t     \"Open\",\n    96\t     \"Answer: Yes\",\n    97\t     \"1 piece of evidence\"\n    98\t    ],\n    99\t    \"card_groups\": 1\n   100\t   },\n   101\t   \"signals\": {\n   102\t    \"requests\": [\n   103\t     \"file:///Users/lchingen/hivemind/poc/data/release-screen-2026-11-23b/old-1-0828/index.html\"\n   104\t    ],\n   105\t    \"errors\": []\n   106\t   }\n   107\t  },\n   108\t  \"escape\": {\n   109\t   \"quote_visible\": true,\n   110\t   \"images\": 0,\n   111\t   \"signals\": {\n   112\t    \"requests\": [\n   113\t     \"file:///Users/lchingen/hivemind/poc/data/release-screen-2026-11-23b/escape/index.html\"\n   114\t    ],\n   115\t    \"errors\": []\n   116\t   }\n   117\t  },\n   118\t  \"mutant-fetch\": {\n   119\t   \"caught\": true,\n   120\t   \"rendered\": true,\n   121\t   \"named\": true\n   122\t  },\n   123\t  \"mutant-line-inside\": {\n   124\t   \"caught\": true,\n   125\t   \"card_top\": [\n   126\t    \"How much Data Center segment revenue will NVIDIA report for FY2027?\",\n   127\t    \"Open\",\n   128\t    \"Forecast unavailable\",\n   129\t    \"Forecast: $361 billion\",\n   130\t    \"1284 pieces of evidence\"\n   131\t   ]\n   132\t  },\n   133\t  \"mutant-line-beside\": {\n   134\t   \"caught\": true,\n   135\t   \"other\": [\n   136\t    \"Forecast: $361 billion\"\n   137\t   ]\n   138\t  },\n   139\t  \"mutant-transparent\": {\n   140\t   \"caught\": true,\n   141\t   \"seconds\": null,\n   142\t   \"cards\": 47,\n   143\t   \"visible\": 0,\n   144\t   \"fallback\": false,\n   145\t   \"errors\": 0\n   146\t  },\n   147\t  \"mutant-clipped\": {\n   148\t   \"caught\": true,\n   149\t   \"clipped\": 1220\n   150\t  },\n   151\t  \"mutant-clipping-wrapper\": {\n   152\t   \"caught\": true,\n   153\t   \"clipped\": 1284\n   154\t  },\n   155\t  \"mutant-own-background\": {\n   156\t   \"caught\": true,\n   157\t   \"unreadable\": 19,\n   158\t   \"body\": \"rgb(245, 242, 235)\",\n   159\t   \"card\": \"rgba(0, 0, 0, 0)\"\n   160\t  },\n   161\t  \"mutant-unreadable-marker\": {\n   162\t   \"caught\": true,\n   163\t   \"unreadable\": 19\n   164\t  }\n   165\t },\n   166\t \"failures\": []\n   167\t}","exit_code":0,"status":"completed"}}
