n   232\t     \"F9\",\n   233\t     \"F10\"\n   234\t    ],\n   235\t    \"uphold\",\n   236\t    \"reject\"\n   237\t   ]\n   238\t  ],\n   239\t  \"support\": {\n   240\t   \"Q01 P/codex v4\": [\n   241\t    \"yes\",\n   242\t    [\n   243\t     \"yes\",\n   244\t     \"yes\"\n   245\t    ]\n   246\t   ],\n   247\t   \"Q01 P/codex v8\": [\n   248\t    \"yes\",\n   249\t    [\n   250\t     \"yes\",\n   251\t     \"yes\"\n   252\t    ]\n   253\t   ],\n   254\t   \"Q02 E/codex v41\": [\n   255\t    \"yes\",\n   256\t    [\n   257\t     \"yes\",\n   258\t     \"yes\"\n   259\t    ]\n   260\t   ],\n   261\t   \"Q03 O/codex v29\": [\n   262\t    \"yes\",\n   263\t    [\n   264\t     \"yes\",\n   265\t     \"yes\"\n   266\t    ]\n   267\t   ],\n   268\t   \"Q04 P-v4/codex v4\": [\n   269\t    \"yes\",\n   270\t    [\n   271\t     \"yes\",\n   272\t     \"yes\"\n   273\t    ]\n   274\t   ],\n   275\t   \"Q05 P-v8/claude v8\": [\n   276\t    \"yes\",\n   277\t    [\n   278\t     \"yes\",\n   279\t     \"yes\"\n   280\t    ]\n   281\t   ],\n   282\t   \"Q07 S/claude v6\": [\n   283\t    \"split\",\n   284\t    [\n   285\t     \"no\",\n   286\t     \"yes\",\n   287\t     \"no\",\n   288\t     \"yes\"\n   289\t    ]\n   290\t   ],\n   291\t   \"Q08 S/codex v6\": [\n   292\t    \"yes\",\n   293\t    [\n   294\t     \"yes\",\n   295\t     \"yes\"\n   296\t    ]\n   297\t   ],\n   298\t   \"Q09 O/claude v29\": [\n   299\t    \"split\",\n   300\t    [\n   301\t     \"no\",\n   302\t     \"yes\",\n   303\t     \"no\",\n   304\t     \"yes\"\n   305\t    ]\n   306\t   ],\n   307\t   \"Q10 P-v8/codex v8\": [\n   308\t    \"yes\",\n   309\t    [\n   310\t     \"yes\",\n   311\t     \"yes\",\n   312\t     \"yes\",\n   313\t     \"yes\"\n   314\t    ]\n   315\t   ],\n   316\t   \"Q11 P-v4/claude v4\": [\n   317\t    \"yes\",\n   318\t    [\n   319\t     \"yes\",\n   320\t     \"yes\"\n   321\t    ]\n   322\t   ],\n   323\t   \"Q13 P/claude v4\": [\n   324\t    \"yes\",\n   325\t    [\n   326\t     \"yes\",\n   327\t     \"yes\"\n   328\t    ]\n   329\t   ],\n   330\t   \"Q13 P/claude v8\": [\n   331\t    \"yes\",\n   332\t    [\n   333\t     \"yes\",\n   334\t     \"yes\"\n   335\t    ]\n   336\t   ],\n   337\t   \"Q14 E/claude v41\": [\n   338\t    \"yes\",\n   339\t    [\n   340\t     \"yes\",\n   341\t     \"yes\",\n   342\t     \"yes\",\n   343\t     \"yes\"\n   344\t    ]\n   345\t   ]\n   346\t  },\n   347\t  \"controls\": {\n   348\t   \"C-disjoint\": {\n   349\t    \"codex_broken\": true,\n   350\t    \"claude_broken\": true,\n   351\t    \"other_both\": []\n   352\t   },\n   353\t   \"C-overlap\": {\n   354\t    \"codex_broken\": false,\n   355\t    \"claude_broken\": false,\n   356\t    \"other_both\": [\n   357\t     \"two forecasts of one quarter\"\n   358\t    ]\n   359\t   }\n   360\t  }\n   361\t }\n   362\t}     1\t{\n     2\t \"Q01\": {\n     3\t  \"case\": \"P\",\n     4\t  \"writer\": \"codex\"\n     5\t },\n     6\t \"Q02\": {\n     7\t  \"case\": \"E\",\n     8\t  \"writer\": \"codex\"\n     9\t },\n    10\t \"Q03\": {\n    11\t  \"case\": \"O\",\n    12\t  \"writer\": \"codex\"\n    13\t },\n    14\t \"Q04\": {\n    15\t  \"case\": \"P-v4\",\n    16\t  \"writer\": \"codex\"\n    17\t },\n    18\t \"Q05\": {\n    19\t  \"case\": \"P-v8\",\n    20\t  \"writer\": \"claude\"\n    21\t },\n    22\t \"Q06\": {\n    23\t  \"case\": \"E\",\n    24\t  \"writer\": \"C-disjoint\"\n    25\t },\n    26\t \"Q07\": {\n    27\t  \"case\": \"S\",\n    28\t  \"writer\": \"claude\"\n    29\t },\n    30\t \"Q08\": {\n    31\t  \"case\": \"S\",\n    32\t  \"writer\": \"codex\"\n    33\t },\n    34\t \"Q09\": {\n    35\t  \"case\": \"O\",\n    36\t  \"writer\": \"claude\"\n    37\t },\n    38\t \"Q10\": {\n    39\t  \"case\": \"P-v8\",\n    40\t  \"writer\": \"codex\"\n    41\t },\n    42\t \"Q11\": {\n    43\t  \"case\": \"P-v4\",\n    44\t  \"writer\": \"claude\"\n    45\t },\n    46\t \"Q12\": {\n    47\t  \"case\": \"E\",\n    48\t  \"writer\": \"C-overlap\"\n    49\t },\n    50\t \"Q13\": {\n    51\t  \"case\": \"P\",\n    52\t  \"writer\": \"claude\"\n    53\t },\n    54\t \"Q14\": {\n    55\t  \"case\": \"E\",\n    56\t  \"writer\": \"claude\"\n    57\t }\n    58\t}","exit_code":0,"status":"completed"}}
