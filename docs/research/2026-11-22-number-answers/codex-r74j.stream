{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"rg -n '\"'^def (resolve_bound|view_exists|is_open_as_of|state_as_of|evidence|evidence_record|ladder_bands|library|item_lookup|read_snapshot|view_bundle|rungs_of|view_key)'\"\\\\b' src/hivemind/{service,bundle,views/store}.py; rg -n 'EVENT_MEASURES|def canonical' src/hivemind/{views/identity,vocabulary}.py\"","aggregated_output":"src/hivemind/bundle.py:14:def read_snapshot(*connections):\nsrc/hivemind/bundle.py:28:def item_lookup(items_db):\nsrc/hivemind/bundle.py:100:def view_bundle(views_db, item_of, view_id, as_of=None):\nsrc/hivemind/bundle.py:225:def library(views_db, items_db, as_of=None):\nsrc/hivemind/views/store.py:97:def rungs_of(conn, view_id):\nsrc/hivemind/views/store.py:159:def view_key(conn, view_id):\nsrc/hivemind/views/store.py:418:def evidence(conn, evidence_id):\nsrc/hivemind/service.py:57:def resolve_bound(conn, bound, *, unfiltered=False):\nsrc/hivemind/service.py:118:def view_exists(conn, record, as_of):\nsrc/hivemind/service.py:122:def is_open_as_of(conn, view_id, as_of):\nsrc/hivemind/service.py:129:def state_as_of(conn, view_id, as_of):\nsrc/hivemind/service.py:224:def evidence_record(conn, evidence_id, as_of, arrived_seq=None):\nsrc/hivemind/service.py:238:def evidence(conn, view_id, as_of=None, tier=None):\nsrc/hivemind/service.py:499:def ladder_bands(rungs):\nsrc/hivemind/vocabulary.py:28:def canonical(field, value):\nsrc/hivemind/views/identity.py:10:EVENT_MEASURES = ('event', 'policy_event')\nsrc/hivemind/views/identity.py:15:    return value.get('measure') not in (None, 'other', *EVENT_MEASURES) and (value.get('scope_source') == 'shared' or value.get('opens_as') in SHARED_REASONS)\nsrc/hivemind/views/identity.py:29:    if value['measure'] in EVENT_MEASURES and value.get('event_type') in (None, 'other', 'n/a'):\nsrc/hivemind/views/identity.py:55:    if key['measure'] != candidate['measure'] and not (key['measure'] in EVENT_MEASURES and candidate['measure'] in EVENT_MEASURES):\nsrc/hivemind/views/identity.py:69:    if key['measure'] in EVENT_MEASURES:\n","exit_code":0,"status":"completed"}}
