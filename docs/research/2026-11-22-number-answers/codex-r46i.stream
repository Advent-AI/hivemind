{"type":"item.started","item":{"id":"item_6","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"python3 -B -c 'import copy,contextlib,io,json,pathlib,types\nimport gate as g,calc_check as c,render_v13 as r,mutants as m\nstream=io.StringIO()\nwith contextlib.redirect_stdout(stream): status=g.main()\nprint('\\\\''run5 exact:'\\\\'',status,stream.getvalue()==pathlib.Path('\\\\''gate-run5.txt'\\\\'').read_text(),json.loads(json.dumps(g.MANIFEST))==json.loads(pathlib.Path('\\\\''gate-run5.fixtures.json'\\\\'').read_text()))\nsaved=copy.deepcopy(g.MANIFEST)\nsource=pathlib.Path('\\\\''calc_check.py'\\\\'').read_text()\nfor name,old,new,target in m.MUTANTS:\n cc=types.ModuleType('\\\\''cc'\\\\'')\n if old: assert source.count(old)==1\n exec(compile(source if old is None else source.replace(old,new),'\\\\''mutant in memory'\\\\'','\\\\''exec'\\\\''),vars(cc))\n g.cc=cc\n misses=[k for k,ok,*_ in g.run() if not ok]\n assert (not misses) if target is None else target in misses,(target,misses)\nprint('\\\\''all listed mutant outcomes reproduced'\\\\'')\ng.cc=c\nstream=io.StringIO()\nwith contextlib.redirect_stdout(stream): status=r.main()\nprint('\\\\''render exact:'\\\\'',status,stream.getvalue()==pathlib.Path('\\\\''render-r1.txt'\\\\'').read_text())\nreq=json.loads(pathlib.Path('\\\\''render-r1.request.json'\\\\'').read_text())\ndef check_rendered(calc):\n strict=r.strict(calc,req['\\\\''schema'\\\\''])\n return (r.model.check_schema(strict,req['\\\\''schema'\\\\'']),c.check(g.R1_FAMILY,g.R1_PASSAGES,r.without_nulls(strict))['\\\\''errors'\\\\''])\nd=copy.deepcopy(saved['\\\\''R1bx'\\\\'']['\\\\''calc'\\\\''])\nfor i,f in enumerate(d['\\\\''figures'\\\\'']):\n if f['\\\\''id'\\\\'']=='\\\\''dcq3'\\\\'':\n  d['\\\\''figures'\\\\''][i]=g.est('\\\\''dcq3'\\\\'',f['\\\\''value'\\\\''],f['\\\\''unit'\\\\''],f['\\\\''what'\\\\''],'\\\\''base uses the segment intermediate'\\\\'',['\\\\''alt_segment_q3'\\\\''])\nalt=next(f for f in d['\\\\''figures'\\\\''] if f['\\\\''scenario'\\\\'']=='\\\\''alt'\\\\'')\nmix=next(f for f in d['\\\\''figures'\\\\''] if f['\\\\''id'\\\\'']=='\\\\''mix'\\\\'')\nd['\\\\''figures'\\\\''].append(g.comp('\\\\''alt_segment_q3'\\\\'','\\\\''share'\\\\'',[alt['\\\\''id'\\\\''],mix['\\\\''id'\\\\'']],99.9,'\\\\''USD bn'\\\\'',next(f for f in d['\\\\''figures'\\\\''] if f['\\\\''id'\\\\'']=='\\\\''dcq3'\\\\'')['\\\\''what'\\\\''],scenario='\\\\''alt'\\\\''))\nprint('\\\\''R1bx via an alternate intermediate:'\\\\'',check_rendered(d))\nx=copy.deepcopy(saved['\\\\''R1bx'\\\\'']['\\\\''calc'\\\\''])\nnext(f for f in x['\\\\''figures'\\\\''] if f['\\\\''id'\\\\'']=='\\\\''dcq3'\\\\'')['\\\\''scenario'\\\\'']='\\\\''range'\\\\''\nprint('\\\\''R1bx point labelled range:'\\\\'',check_rendered(x))\nx=g.r1('\\\\''c'\\\\'')\nprior=copy.deepcopy(next(f for f in g.r1('\\\\''a'\\\\'')['\\\\''figures'\\\\''] if f['\\\\''id'\\\\'']=='\\\\''prior414'\\\\''))\nprint('\\\\''prior authentic kind'\\\\'',prior['\\\\''kind'\\\\''],prior['\\\\''basis'\\\\''])\nprior['\\\\''kind'\\\\'']='\\\\''estimate'\\\\''; prior['\\\\''basis_text'\\\\'']='\\\\''Earlier forecast for comparison'\\\\''\nx['\\\\''figures'\\\\''].append(prior)\nx['\\\\''answers'\\\\''][1].update(outcome='\\\\''prior414'\\\\'',rung=2)\nprint('\\\\''P3e paired labels estimate/prior_forecast, R1 actual earlier figure:'\\\\'',check_rendered(x))\n'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
