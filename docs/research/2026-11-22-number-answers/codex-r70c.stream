{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba docs/research/2026-11-22-number-answers/paid_gate.py | sed -n '128,189p'; nl -ba docs/research/2026-11-22-number-answers/calc_small.py | sed -n '150,245p'\"","aggregated_output":"   128\t\n   129\tdef item(unit, arm, draw, calls, family, shown, fmt='v13'):\n   130\t    archive = RUN / draw / 'prod/archive.sqlite'\n   131\t    if fmt == 'v13s':\n   132\t        user, evidence_ids, theme_ids = rv.render(archive, calls, family, shown=shown, fmt='v13s')\n   133\t        return {'unit': unit, 'arm': arm, 'draw_store': draw, 'members': sorted(shown), 'format': 'v13s', 'system': SYSTEM_S, 'user': user,\n   134\t                'schema': rv.v13s_schema(sorted(shown), evidence_ids, theme_ids), 'family': family, 'passages': passages(draw, evidence_ids),\n   135\t                'evidence_ids': evidence_ids, 'questions': questions(draw, sorted(shown)), 'shown': shown_lines(user)}\n   136\t    user, evidence_ids, theme_ids = rv.render(archive, calls, family, shown=shown)\n   137\t    return {'unit': unit, 'arm': arm, 'draw_store': draw, 'members': sorted(shown), 'system': SYSTEM, 'user': user,\n   138\t            'schema': rv.v13_schema(sorted(shown), evidence_ids, theme_ids), 'family': family, 'passages': passages(draw, evidence_ids),\n   139\t            'evidence_ids': evidence_ids, 'questions': questions(draw, sorted(shown)), 'shown': shown_lines(user)}\n   140\t\n   141\t\n   142\tdef build_plan(fmt='v13'):\n   143\t    items = []\n   144\t    small = fmt == 'v13s'\n   145\t    for draw, total, dc in PAIRS:\n   146\t        family = pair_family(draw, total, dc)\n   147\t        if small:\n   148\t            family = small_family(family, PAIR_SCOPES)\n   149\t        calls = [total, dc]\n   150\t        items.append(item(f'pair-{draw}', 'joint', draw, calls, family, [total[0], dc[0]], fmt))\n   151\t        for member in (total, dc):                            # the same union of evidence, one member's header and answer\n   152\t            items.append(item(f'pair-{draw}', f'separate-{member[0]}', draw, calls, only(family, member[0]), [member[0]], fmt))\n   153\t    for name, draw, view_id, call_id, what in SINGLETONS:\n   154\t        family = {'members': {view_id: {'what': W(*what), 'bands': bands(draw, view_id)}}, 'relations': [], 'shared': [], 'compare_periods': []}\n   155\t        if small:\n   156\t            family = small_family(family, notes={view_id: O_NOTE} if name == 'O' else None)\n   157\t        items.append(item(f'single-{name}', 'single', draw, [(view_id, call_id)], family, [view_id], fmt))\n   158\t    return items\n   159\t\n   160\t\n   161\tdef plan(out, fmt='v13'):\n   162\t    items = build_plan(fmt)\n   163\t    report = []\n   164\t    for it in items:\n   165\t        missing = sorted(set(it['evidence_ids']) - set(it['passages']))\n   166\t        report.append(f'{it[\"unit\"]:14} {it[\"arm\"]:14} members {it[\"members\"]} user {len(it[\"user\"])} chars, evidence {len(it[\"evidence_ids\"])}, '\n   167\t                      f'schema {len(json.dumps(it[\"schema\"]))} chars, passages missing {missing or \"none\"}')\n   168\t        if missing or 'Outcome keys' not in it['user']:\n   169\t            raise SystemExit(f'{it[\"unit\"]} {it[\"arm\"]}: incomplete request; not planned')\n   170\t    ids = [(i['unit'], i['arm']) for i in items]\n   171\t    if len(set(ids)) != len(ids):\n   172\t        raise SystemExit('duplicate (unit, arm) in the plan; not planned')\n   173\t    text = json.dumps(items, indent=1)\n   174\t    Path(out).write_text(text)\n   175\t    Path(out).with_suffix('.sha256').write_text(hashlib.sha256(text.encode()).hexdigest() + '\\n')\n   176\t    print('\\n'.join(report))\n   177\t    print(f'{len(items)} requests x {len(DRAWS)} draws = {len(items) * len(DRAWS)} first attempts')\n   178\t\n   179\t\n   180\tdef strip(data):\n   181\t    return rv.without_nulls(data)\n   182\t\n   183\t\n   184\tclass Gate:\n   185\t    def __init__(self, out, transport, ledger=None):\n   186\t        self.out, self.transport, self.ledger = out, transport, ledger\n   187\t        self.cfg = config.load(str(CONFIG))\n   188\t        self.lock = threading.Lock()\n   189\t        (out / 'archives').mkdir(parents=True, exist_ok=True)\n   150\t\n   151\t# ---------- decoding the wire shape ----------\n   152\tFIGURE_FIELDS = ('id', 'what', 'kind', 'basis', 'value', 'low', 'high', 'unit', 'quote_number', 'qualifier', 'inputs', 'operation',\n   153\t                 'basis_text', 'rests_on')\n   154\t\n   155\t\n   156\tdef _text(value):\n   157\t    return value if isinstance(value, str) and value.strip() else None\n   158\t\n   159\t\n   160\tdef from_answer(data, family):\n   161\t    \"\"\"The v13s wire answer as the internal shape: `evidence_id` becomes `evidence`; the markers become each answer's `outcome` and\n   162\t    `reference`; marker errors go in `decode_errors` (S5, S6, S7). An empty string counts as absent.\"\"\"\n   163\t    errors, figures, outcome_for, reference_for = [], [], {}, {}\n   164\t    members = family['members']\n   165\t    for f in data.get('figures') or []:\n   166\t        g = {k: f[k] for k in FIGURE_FIELDS if f.get(k) is not None}\n   167\t        if f.get('evidence_id') is not None:\n   168\t            g['evidence'] = f['evidence_id']\n   169\t        for marks, store in (('outcome_for', outcome_for), ('reference_for', reference_for)):\n   170\t            listed = f.get(marks) or []\n   171\t            for v in sorted(set(listed)):\n   172\t                if listed.count(v) > 1:\n   173\t                    errors.append(('S7', f'{f.get(\"id\")}: {marks} lists {v} more than once'))\n   174\t                store.setdefault(v, []).append(f.get('id'))\n   175\t        figures.append(g)\n   176\t    answers = []\n   177\t    for a in data.get('answers') or []:\n   178\t        v = a.get('view_id')\n   179\t        a2 = {k: a[k] for k in ('view_id', 'shape', 'rung', 'reasons', 'cites', 'pushes', 'theme_pushes') if a.get(k) is not None}\n   180\t        if _text(a.get('why')):\n   181\t            a2['why'] = a['why']\n   182\t        if v not in members:\n   183\t            answers.append(a2)\n   184\t            continue\n   185\t        outs, refs, reason = outcome_for.get(v, []), reference_for.get(v, []), _text(a.get('reference_unavailable'))\n   186\t        if a.get('shape') == 'unresolved':\n   187\t            if outs or refs or reason or a.get('rung') is not None or not _text(a.get('why')):\n   188\t                errors.append(('S7', f'{v}: an unresolved answer has why, rung and reference_unavailable null, and no figure marked for it'))\n   189\t        else:\n   190\t            if len(outs) == 1:\n   191\t                a2['outcome'] = outs[0]\n   192\t            else:\n   193\t                errors.append(('S6', f'{v}: {len(outs)} figures are marked as its outcome; exactly one is required'))\n   194\t            if len(refs) == 1 and not reason:\n   195\t                a2['reference'] = {'figure': refs[0]}\n   196\t            elif not refs and reason:\n   197\t                a2['reference'] = {'unavailable': reason}\n   198\t            else:\n   199\t                errors.append(('S5', f'{v}: needs exactly one of a figure marked as its reference or reference_unavailable'))\n   200\t        answers.append(a2)\n   201\t    for v in set(outcome_for) | set(reference_for):\n   202\t        if v not in members:\n   203\t            errors.append(('S7', f'{v} is marked on a figure but is not a member of the family'))\n   204\t    return {'figures': figures, 'answers': answers, 'decode_errors': errors}\n   205\t\n   206\t\n   207\t# ---------- arithmetic ----------\n   208\tdef _result_unit(op, units):\n   209\t    if any(u not in UNITS for u in units):\n   210\t        return None\n   211\t    if op in ('sum', 'difference'):\n   212\t        return units[0] if len(set(units)) == 1 else None\n   213\t    if op == 'product':\n   214\t        money, pct = units.count('USD bn'), units.count('%')\n   215\t        if money + pct > 1:                                  # never USD bn × % (use share), never two amounts or two percentages\n   216\t            return None\n   217\t        return 'USD bn' if money else ('%' if pct else 'x')\n   218\t    if op == 'ratio':\n   219\t        a, b = units\n   220\t        return 'x' if a == b else (a if b == 'x' else None)  # [54] same units give x; a ÷ x keeps a's unit\n   221\t    if op == 'share':\n   222\t        return units[0] if units[1] == '%' else None         # [54] a share of a percentage is a percentage\n   223\t    if op == 'growth':\n   224\t        return '%' if units[0] == units[1] else None\n   225\t    if op == 'apply_growth':\n   226\t        return units[0] if units[1] == '%' else None\n   227\t    return None\n   228\t\n   229\t\n   230\tdef _apply(op, xs):\n   231\t    if op == 'sum':\n   232\t        return sum(xs)\n   233\t    if op == 'difference':\n   234\t        return xs[0] - xs[1]\n   235\t    if op == 'product':\n   236\t        return math.prod(xs)\n   237\t    if op == 'ratio':\n   238\t        return xs[0] / xs[1]\n   239\t    if op == 'share':\n   240\t        return xs[0] * xs[1] / 100.0\n   241\t    if op == 'growth':\n   242\t        return (xs[1] / xs[0] - 1.0) * 100.0\n   243\t    if op == 'apply_growth':\n   244\t        return xs[0] * (1.0 + xs[1] / 100.0)\n   245\t    raise ValueError(op)\n","exit_code":0,"status":"completed"}}
