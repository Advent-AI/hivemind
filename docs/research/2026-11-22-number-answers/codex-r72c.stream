{"type":"item.completed","item":{"id":"item_18","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba poc/ui/src/model/market.js | head -165\nrg -n 'fetch\\\\(|readIdea\\\\(|readBundles\\\\(' poc/ui/src/{bootstrap.js,idea/idea.js}\nnl -ba poc/mock/index.template.html | head -130\"","aggregated_output":"     1\texport const ACTION_SIZE = { width: 440, height: 360 };\n     2\texport const MARKET_RANGES = ['1D', '1W', '1M', '1Y'];\n     3\texport const DEFAULT_ACTION_SETTINGS = { allocation: 5, range: '1Y' };\n     4\tconst DAY = 86400000;\n     5\tconst sessionDate = new Intl.DateTimeFormat('en-CA', { timeZone: 'America/New_York' });\n     6\t\n     7\texport function readActionSettings(value = DEFAULT_ACTION_SETTINGS) {\n     8\t  if (\n     9\t    !value ||\n    10\t    Object.keys(value).sort().join(',') !== 'allocation,range' ||\n    11\t    !Number.isFinite(value.allocation) ||\n    12\t    value.allocation < 0 ||\n    13\t    value.allocation > 100 ||\n    14\t    Math.abs(value.allocation * 10 - Math.round(value.allocation * 10)) > 1e-8 ||\n    15\t    !MARKET_RANGES.includes(value.range)\n    16\t  )\n    17\t    throw new TypeError('Action settings need a 0–100 percentage in tenths and a chart range');\n    18\t  return { ...value };\n    19\t}\n    20\t\n    21\t/** Read completed USD stock-price observations, with their actual source and cutoff. */\n    22\texport function readMarketSnapshot(value) {\n    23\t  if (\n    24\t    !value ||\n    25\t    Object.keys(value).sort().join(',') !==\n    26\t      'asOf,assetClass,currency,daily,hourly,name,source,symbol' ||\n    27\t    !/^[A-Z][A-Z0-9.-]{0,14}$/.test(value.symbol) ||\n    28\t    typeof value.name !== 'string' ||\n    29\t    !value.name.trim() ||\n    30\t    value.currency !== 'USD' ||\n    31\t    value.assetClass !== 'stock' ||\n    32\t    value.source !== 'TrueNorth' ||\n    33\t    typeof value.asOf !== 'string' ||\n    34\t    !/^\\d{4}-\\d{2}-\\d{2}T[\\d:.]+Z$/.test(value.asOf) ||\n    35\t    !Number.isFinite(Date.parse(value.asOf))\n    36\t  )\n    37\t    throw new TypeError('Invalid stock-price snapshot');\n    38\t  const cutoff = Date.parse(value.asOf);\n    39\t  const readPoints = (points) => {\n    40\t    if (!Array.isArray(points)) throw new TypeError('Price history must be an array');\n    41\t    return points.map((point, index) => {\n    42\t      if (\n    43\t        !Array.isArray(point) ||\n    44\t        point.length !== 2 ||\n    45\t        !Number.isSafeInteger(point[0]) ||\n    46\t        point[0] <= 0 ||\n    47\t        point[0] > cutoff ||\n    48\t        !Number.isFinite(point[1]) ||\n    49\t        point[1] <= 0 ||\n    50\t        (index > 0 && point[0] <= points[index - 1][0])\n    51\t      )\n    52\t        throw new TypeError('Prices need increasing completed timestamps and positive values');\n    53\t      return [...point];\n    54\t    });\n    55\t  };\n    56\t  const hourly = readPoints(value.hourly),\n    57\t    daily = readPoints(value.daily);\n    58\t  if (hourly.length < 2 || daily.length < 2)\n    59\t    throw new TypeError('Price history needs at least two hourly and daily observations');\n    60\t  return { ...value, hourly, daily };\n    61\t}\n    62\t\n    63\t/** Anchor ranges to the newest observation, independently of the thesis replay date. */\n    64\texport function marketWindow(snapshot, range) {\n    65\t  if (!MARKET_RANGES.includes(range)) throw new TypeError('Unknown chart range');\n    66\t  const latest = [snapshot.hourly.at(-1), snapshot.daily.at(-1)].sort((a, b) => a[0] - b[0]).at(-1);\n    67\t  const history = range === '1Y' ? [...snapshot.daily] : snapshot.hourly;\n    68\t  if (range === '1Y' && latest[0] > history.at(-1)[0]) history.push(latest);\n    69\t  if (range === '1D') {\n    70\t    const date = sessionDate.format(latest[0]);\n    71\t    return history.filter(([time]) => sessionDate.format(time) === date);\n    72\t  }\n    73\t  const days = { '1W': 7, '1M': 30, '1Y': 365 }[range];\n    74\t  return history.filter(([time]) => time >= latest[0] - days * DAY);\n    75\t}\n    76\t\n    77\t/** Map time and price to a bounded plot; preserve time gaps between sessions. */\n    78\texport function priceGeometry(points, width = 390, height = 142) {\n    79\t  if (!points.length) return null;\n    80\t  const left = 2,\n    81\t    right = width - 47,\n    82\t    top = 12,\n    83\t    bottom = height - 23;\n    84\t  const values = points.map((point) => point[1]);\n    85\t  const low = Math.min(...values),\n    86\t    high = Math.max(...values);\n    87\t  const padding = Math.max((high - low) * 0.12, high * 0.001);\n    88\t  const min = low - padding,\n    89\t    max = high + padding;\n    90\t  const first = points[0][0],\n    91\t    last = points.at(-1)[0];\n    92\t  const mapped = points.map(([time, price]) => ({\n    93\t    time,\n    94\t    price,\n    95\t    x: left + ((time - first) / (last - first || 1)) * (right - left),\n    96\t    y: bottom - ((price - min) / (max - min)) * (bottom - top),\n    97\t  }));\n    98\t  return { mapped, left, right, top, bottom, min, max, width, height };\n    99\t}\npoc/ui/src/bootstrap.js:193:        const card = await readIdea(API, text, {\npoc/ui/src/bootstrap.js:200:        const bundles = await readBundles(API, idsOf(card), card.idea.as_of, { signal });\npoc/ui/src/bootstrap.js:256:        const response = await fetch(`${API}/library`, { signal: libraryRequest.signal });\npoc/ui/src/idea/idea.js:26:export async function readIdea(api, text, { signal, asOf, onProgress = () => {} } = {}) {\npoc/ui/src/idea/idea.js:28:    const response = await fetch(`${api}/ideas`, {\npoc/ui/src/idea/idea.js:222:export async function readBundles(api, ids, asOf, { signal } = {}) {\npoc/ui/src/idea/idea.js:226:    response = await fetch(\n     1\t<!doctype html>\n     2\t<html lang=\"en\">\n     3\t<head>\n     4\t<meta charset=\"utf-8\">\n     5\t<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n     6\t<title>Hivemind | Ideas &amp; Theses</title>\n     7\t<link rel=\"stylesheet\" href=\"../../web/design-system/fonts-embedded.css\">\n     8\t<style>__STYLES__</style>\n     9\t</head>\n    10\t<body class=\"hm-ui demo\">\n    11\t<header class=\"bar\">\n    12\t  <a class=\"wordmark\" href=\"#\"><img class=\"wordmark__logo\" src=\"../../web/hivemind-logo.svg\" alt=\"\" aria-hidden=\"true\"><span>Hivemind</span></a>\n    13\t  <nav class=\"app-nav\" aria-label=\"Workspace\"><button id=\"show-library\" type=\"button\" aria-pressed=\"true\">Thesis Library</button><button id=\"show-idea\" type=\"button\" aria-pressed=\"false\">Explore Ideas</button></nav>\n    14\t</header>\n    15\t<main id=\"library\" aria-label=\"Thesis library\"></main>\n    16\t<main id=\"explorer\" aria-label=\"Thesis canvas\" hidden>\n    17\t  <div class=\"idea-entry\">\n    18\t  <form class=\"idea-form\" id=\"idea-form\">\n    19\t    <div class=\"idea-composer\">\n    20\t      <input class=\"ask__input\" id=\"ask\" type=\"text\" aria-label=\"Your idea\" autocomplete=\"off\" spellcheck=\"false\" placeholder=\"Share an idea, e.g. Can NVIDIA's data center revenue top $300B this year?\">\n    21\t      <button class=\"idea-send\" id=\"idea-send\" type=\"submit\" aria-label=\"Send idea\" disabled><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 19V5m-6 6 6-6 6 6\"/></svg></button>\n    22\t    </div>\n    23\t  </form>\n    24\t  <button class=\"idea-launcher\" id=\"idea-launcher\" type=\"button\" aria-label=\"Enter a new idea\" aria-controls=\"idea-form\" aria-expanded=\"true\" hidden><img src=\"../../web/hivemind-logo.svg\" alt=\"\" aria-hidden=\"true\"></button>\n    25\t  </div>\n    26\t</main>\n    27\t<script id=\"data\" type=\"application/json\">__DATA__</script>\n    28\t<script id=\"composite-trials\" type=\"application/json\">__COMPOSITE_TRIALS__</script>\n    29\t<script id=\"market-data\" type=\"application/json\">__MARKET_DATA__</script>\n    30\t<script>__SCRIPT__</script>\n    31\t</body>\n    32\t</html>\n","exit_code":0,"status":"completed"}}
