\\\\''].splitlines() if re.fullmatch(r'\\\\''    Quote: .*'\\\\'',l)]\n print(k,'\\\\''no expressions'\\\\'',sum(not cc.extract(s['\\\\''text'\\\\'']) for s in p['\\\\''passages'\\\\''].values()),'\\\\''quotes'\\\\'',len(uc),'\\\\''header'\\\\'',len(p['\\\\''passages'\\\\'']))\n'\"","aggregated_output":"answers reproduced 36\nevidence prose by kind Counter({('separate', 'source'): 72, ('joint', 'source'): 56, ('separate', 'estimate'): 14, ('single', 'source'): 11, ('separate', 'computed'): 10, ('joint', 'computed'): 6, ('joint', 'estimate'): 5, ('single', 'estimate'): 1})\npoint-range shapes Counter({('separate', 'source', 'midpoint'): 8, ('joint', 'source', 'midpoint'): 5, ('separate', 'source', 'value'): 5, ('joint', 'source', 'value'): 3, ('single', 'estimate', 'value'): 3, ('joint', 'estimate', 'value'): 1, ('single', 'estimate', None): 1, ('separate', 'estimate', None): 1})\nsubclass affected answers\njoint {'C7: point/range': 8, 'C7: dangling': 7, 'C7: arity': 2, 'C7: signs': 2}\nseparate {'C7: point/range': 13, 'C7: dangling': 12, 'C7: arity': 7, 'C7: signs': 5, 'C1: evidence': 1, 'C7: outcome missing': 1}\nsingle {'C7: dangling': 6, 'C7: point/range': 4, 'C1: value/unit/etc': 1, 'C7: outcome missing': 1, 'C1: expression': 1, 'C7: signs': 2}\nearly exit Counter({'separate': 17, 'joint': 9, 'single': 8})\nall outcomes Counter({'forecast': 45})\nretries reproduced 36\nevidence prose by kind Counter({('separate', 'source'): 59, ('joint', 'source'): 29, ('separate', 'computed'): 18, ('separate', 'estimate'): 11, ('single', 'source'): 7, ('joint', 'computed'): 5, ('single', 'computed'): 2, ('single', 'estimate'): 1, ('joint', 'estimate'): 1})\npoint-range shapes Counter({('separate', 'source', 'midpoint'): 7, ('joint', 'source', 'midpoint'): 5, ('separate', 'source', 'value'): 5, ('joint', 'source', 'value'): 4, ('joint', 'estimate', 'value'): 1, ('single', 'estimate', 'midpoint'): 1})\nsubclass affected answers\njoint {'C7: dangling': 7, 'C7: arity': 2, 'C7: poin