{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba docs/research/2026-11-22-number-answers/calc_check.py | sed -n '1,445p'\"","aggregated_output":"     1\t\"\"\"judging-v13's calculation checks (DESIGN.md v5, harness-only). Code owns identity and arithmetic, never importance.\n     2\t\n     3\tcheck(family, passages, calc) -> {'errors': [(code, detail)], 'recorded': [...]}\n     4\t- family: {'members': {view_id: {'what': {...}, 'bands': [[lo, hi], ...]}}, 'relations': [{'type': 'part_of'|'same_base', ...}],\n     5\t           'shared': [what, ...], 'compare_periods': [period, ...]}\n     6\t- passages: {evidence_id: {'text': str, 'speaker': str}}\n     7\t- calc: {'figures': [...], 'answers': [...]}, the format of DESIGN.md §2.\n     8\tValues are in the figure's unit; money is normalised to 'USD bn'.\n     9\t\"\"\"\n    10\timport re\n    11\t\n    12\tQUAL = {'more than': '>', 'over': '>', 'at least': '>=', 'nearly': 'approx_below', 'almost': 'approx_below',\n    13\t        'approximately': 'approx', 'about': 'approx', 'around': 'approx', 'roughly': 'approx',\n    14\t        'up to': '<=', 'less than': '<', 'below': '<', 'under': '<'}\n    15\tSCALE = {'trillion': 1000.0, 'tn': 1000.0, 't': 1000.0, 'billion': 1.0, 'bn': 1.0, 'b': 1.0, 'million': 0.001, 'm': 0.001}\n    16\tNUM = r'(\\d[\\d,]*(?:\\.\\d+)?)'\n    17\tUNIT = r'(trillion|billion|million|bn|tn|T|B|M)\\b'\n    18\tQWORDS = '|'.join(sorted(QUAL, key=len, reverse=True))\n    19\tPATTERNS = [\n    20\t    ('relative', re.compile(r'\\$\\s?' + NUM + r'\\s*' + UNIT + r',?\\s*(?:plus or minus|±)\\s*' + NUM + r'%')),\n    21\t    ('range', re.compile(r'\\$\\s?' + NUM + r'\\s*(?:' + UNIT + r')?\\s*(?:–|-)\\s*\\$?\\s?' + NUM + r'\\s*' + UNIT)),   # \"to\" is ambiguous (\"from $253 billion to $392 billion\")\n    22\t    ('range', re.compile(r'\\bbetween\\s+\\$\\s?' + NUM + r'\\s*(?:' + UNIT + r')?\\s+and\\s+\\$?\\s?' + NUM + r'\\s*' + UNIT, re.I)),\n    23\t    ('qualified', re.compile(r'\\b(' + QWORDS + r')\\s+\\$\\s?' + NUM + r'\\s*' + UNIT, re.I)),\n    24\t    ('money', re.compile(r'\\$\\s?' + NUM + r'\\s*' + UNIT)),\n    25\t    ('money_plain', re.compile(r'\\$\\s?' + NUM + r'(?![\\d,.]*\\s*(?:trillion|billion|million|bn|tn|T|B|M)\\b)')),\n    26\t    ('multiplier', re.compile(r'\\b(more than\\s+)?(double|triple)\\b', re.I)),\n    27\t    ('percent', re.compile(r'\\b(?:(' + QWORDS + r')\\s+)?' + NUM + r'%', re.I)),\n    28\t]\n    29\tOPERATIONS = {'sum', 'difference', 'product', 'ratio', 'growth', 'apply_growth', 'share', 'range_from_relative', 'roll_forward'}\n    30\tARITY = {'difference': (2, 2), 'ratio': (2, 2), 'growth': (2, 2), 'apply_growth': (2, 2), 'share': (2, 2), 'range_from_relative': (2, 2),\n    31\t         'product': (2, 99), 'sum': (1, 99), 'roll_forward': (2, 99)}          # [46m.1] every operand an operation lists is one it uses\n    32\tKINDS = {'source', 'computed', 'estimate', 'prior'}\n    33\tBASES = {'reported', 'guidance', 'consensus', 'third_party', 'forecast', 'prior_forecast'}\n    34\tEXTERNAL = {'consensus', 'guidance', 'third_party'}\n    35\t\n    36\t\n    37\tdef _num(text):\n    38\t    return float(text.replace(',', ''))\n    39\t\n    40\t\n    41\tdef _scale(unit):\n    42\t    return SCALE[unit.lower()] if unit else 1.0\n    43\t\n    44\t\n    45\tdef extract(text):\n    46\t    \"\"\"Every complete numeric expression in a passage, longest forms first, never overlapping: [{'text', 'form', ...}].\"\"\"\n    47\t    taken, found = [], []\n    48\t    for form, pattern in PATTERNS:\n    49\t        for m in pattern.finditer(text):\n    50\t            if any(m.start() < end and start < m.end() for start, end in taken):\n    51\t                continue\n    52\t            taken.append((m.start(), m.end()))\n    53\t            g = m.groups()\n    54\t            item = {'text': m.group(0), 'form': form, 'start': m.start()}\n    55\t            if form == 'relative':\n    56\t                item.update(midpoint=_num(g[0]) * _scale(g[1]), relative=_num(g[2]), unit='USD bn')\n    57\t            elif form == 'range':\n    58\t                unit = g[3]\n    59\t                item.update(low=_num(g[0]) * _scale(g[1] or unit), high=_num(g[2]) * _scale(unit), unit='USD bn')\n    60\t            elif form == 'qualified':\n    61\t                item.update(bound=QUAL[g[0].lower()], value=_num(g[1]) * _scale(g[2]), unit='USD bn')\n    62\t            elif form == 'money':\n    63\t                item.update(value=_num(g[0]) * _scale(g[1]), unit='USD bn')\n    64\t            elif form == 'money_plain':\n    65\t                item.update(value=_num(g[0]), unit='USD')\n    66\t            elif form == 'multiplier':\n    67\t                item.update(multiplier=2.0 if g[1].lower() == 'double' else 3.0, bound='>' if g[0] else None, unit='x')\n    68\t            elif form == 'percent':\n    69\t                item.update(value=_num(g[1]), bound=QUAL[g[0].lower()] if g[0] else None, unit='%')\n    70\t            found.append(item)\n    71\t    return sorted(found, key=lambda item: item['start'])\n    72\t\n    73\t\n    74\tdef _same(a, b):\n    75\t    return a is not None and b is not None and abs(a - b) <= 1e-9 * max(1.0, abs(b))\n    76\t\n    77\t\n    78\tdef _source_errors(fig, passages):\n    79\t    passage = passages.get(fig.get('evidence'))\n    80\t    if passage is None:\n    81\t        return [('C1', f'{fig[\"id\"]}: evidence {fig.get(\"evidence\")} was not shown')]\n    82\t    matches = [e for e in extract(passage['text']) if e['text'] == fig.get('expression')]\n    83\t    if not matches:\n    84\t        return [('C1', f'{fig[\"id\"]}: \"{fig.get(\"expression\")}\" is not a complete numeric expression of {fig[\"evidence\"]}')]\n    85\t    expr, comp = matches[0], fig.get('component', 'value')\n    86\t    bound, unit = fig.get('bound'), fig.get('unit')\n    87\t    ok = False\n    88\t    if comp == 'value' and expr['form'] in ('money', 'money_plain', 'percent'):\n    89\t        ok = _same(fig.get('value'), expr['value']) and unit == expr['unit'] and bound == expr.get('bound')\n    90\t    elif comp == 'bound' and expr['form'] in ('qualified', 'percent'):\n    91\t        ok = _same(fig.get('value'), expr['value']) and unit == expr['unit'] and bound == expr['bound'] and bound is not None\n    92\t    elif comp == 'midpoint' and expr['form'] == 'relative':\n    93\t        ok = _same(fig.get('value'), expr['midpoint']) and unit == 'USD bn' and bound is None\n    94\t    elif comp == 'relative' and expr['form'] == 'relative':\n    95\t        ok = _same(fig.get('value'), expr['relative']) and unit == '%' and bound is None\n    96\t    elif comp in ('low', 'high') and expr['form'] == 'range':\n    97\t        ok = _same(fig.get('value'), expr[comp]) and unit == 'USD bn' and bound is None\n    98\t    elif comp == 'multiplier' and expr['form'] == 'multiplier':\n    99\t        ok = _same(fig.get('value'), expr['multiplier']) and unit == 'x' and bound == expr['bound']\n   100\t    if not ok:\n   101\t        return [('C1', f'{fig[\"id\"]}: value {fig.get(\"value\")} {unit} bound {bound} does not equal \"{expr[\"text\"]}\" as component {comp}')]\n   102\t    return []\n   103\t\n   104\t\n   105\tdef _interval(fig):\n   106\t    if 'low' in fig and 'high' in fig:\n   107\t        return fig['low'], fig['high']\n   108\t    return fig['value'], fig['value']\n   109\t\n   110\t\n   111\tdef _terms(fig):\n   112\t    \"\"\"[46w] The operands a calculation uses, with a sum's or roll_forward's repeated operands netted (x - x cancels exactly).\"\"\"\n   113\t    ids = list(fig.get('inputs', []))\n   114\t    if fig.get('operation') == 'difference' and len(ids) == 2 and ids[0] == ids[1]:\n   115\t        return [], []                                 # [46x.2] x - x is exactly zero\n   116\t    if fig.get('operation') not in ('sum', 'roll_forward'):\n   117\t        return ids, fig.get('signs')\n   118\t    net = {}\n   119\t    for i, k in zip(ids, fig.get('signs') or [1] * len(ids)):\n   120\t        net[i] = net.get(i, 0) + k\n   121\t    kept = [i for i in dict.fromkeys(ids) if net[i] != 0]\n   122\t    return kept, [net[i] for i in kept]\n   123\t\n   124\t\n   125\tdef _compute(op, inputs, signs, out_unit=None):\n   126\t    \"\"\"inputs: [(lo, hi, unit)]; returns (lo, hi) in out_unit.\"\"\"\n   127\t    los = [i[0] for i in inputs]\n   128\t    his = [i[1] for i in inputs]\n   129\t    if op in ('sum', 'roll_forward'):\n   130\t        s = signs or [1] * len(inputs)\n   131\t        return (sum((a if k > 0 else b) * k for a, b, k in zip(los, his, s)), sum((b if k > 0 else a) * k for a, b, k in zip(los, his, s)))\n   132\t    if op == 'difference':\n   133\t        return los[0] - his[1], his[0] - los[1]\n   134\t    if op == 'product':\n   135\t        lo = hi = 1.0\n   136\t        for a, b in zip(los, his):\n   137\t            lo, hi = lo * a, hi * b\n   138\t        units = [i[2] for i in inputs]\n   139\t        if 'units' in units and 'USD' in units and out_unit == 'USD bn':     # units times a dollar price, in billions\n   140\t            lo, hi = lo / 1e9, hi / 1e9\n   141\t        return lo, hi\n   142\t    if op == 'ratio':\n   143\t        units = [i[2] for i in inputs]\n   144\t        if 'USD' in units and 'USD bn' in units:                # a dollar total over a per-unit price\n   145\t            los = [x * 1e9 if u == 'USD bn' else x for x, u in zip(los, units)]\n   146\t            his = [x * 1e9 if u == 'USD bn' else x for x, u in zip(his, units)]\n   147\t        return los[0] / his[1], his[0] / los[1]\n   148\t    if op == 'share':\n   149\t        return los[0] * los[1] / 100.0, his[0] * his[1] / 100.0\n   150\t    if op == 'growth':\n   151\t        return (los[1] / his[0] - 1) * 100.0, (his[1] / los[0] - 1) * 100.0\n   152\t    if op == 'apply_growth':\n   153\t        return los[0] * (1 + los[1] / 100.0), his[0] * (1 + his[1] / 100.0)\n   154\t    if op == 'range_from_relative':\n   155\t        return los[0] * (1 - los[1] / 100.0), his[0] * (1 + his[1] / 100.0)\n   156\t    raise ValueError(op)\n   157\t\n   158\t\n   159\tDIRECTION = {'>': 'lower', '>=': 'lower', 'approx_above': 'lower', '<': 'upper', '<=': 'upper', 'approx_below': 'upper',\n   160\t             'approx': 'two-sided', 'mixed': 'mixed', None: None}\n   161\tFLIP = {'lower': 'upper', 'upper': 'lower', 'two-sided': 'two-sided', 'mixed': 'mixed', None: None}\n   162\t\n   163\t\n   164\tdef _bound_direction(op, ins, signs=None):\n   165\t    \"\"\"For positive operands: which side the result is bounded on, from its inputs' bounds (None: a point). [46u.2] A term a sum or\n   166\t    roll_forward subtracts flips its side.\"\"\"\n   167\t    dirs = [DIRECTION.get(i.get('bound')) for i in ins]\n   168\t    if op in ('sum', 'roll_forward') and signs:\n   169\t        dirs = [FLIP[d] if k < 0 else d for d, k in zip(dirs, signs)]\n   170\t    if op == 'ratio' and len(dirs) == 2:\n   171\t        dirs = [dirs[0], FLIP[dirs[1]]]\n   172\t    if op == 'difference' and len(dirs) == 2:\n   173\t        dirs = [dirs[0], FLIP[dirs[1]]]\n   174\t    found = {d for d in dirs if d}\n   175\t    if not found:\n   176\t        return None\n   177\t    if 'mixed' in found or {'lower', 'upper'} <= found:     # [46v] opposing bounds leave the result unbounded\n   178\t        return 'mixed'\n   179\t    return found.pop() if len(found) == 1 and 'two-sided' not in found else 'two-sided'\n   180\t\n   181\t\n   182\tdef _outcome_set(fig):\n   183\t    \"\"\"The values an outcome allows: (low, low_closed, high, high_closed); a bound keeps its side open or closed.\"\"\"\n   184\t    lo, hi = _interval(fig)\n   185\t    b = fig.get('bound')\n   186\t    inf = float('inf')\n   187\t    if b == '>':\n   188\t        return (lo, False, inf, False)\n   189\t    if b in ('>=', 'approx_above'):\n   190\t        return (lo, True, inf, False)\n   191\t    if b == '<':\n   192\t        return (-inf, False, hi, False)\n   193\t    if b in ('<=', 'approx_below'):\n   194\t        return (-inf, False, hi, True)\n   195\t    if b == 'mixed':                                    # [46v] any value: only possible crossings\n   196\t        return (-inf, False, inf, False)\n   197\t    return (lo, True, hi, True)\n   198\t\n   199\t\n   200\tdef _overlaps(values, band):\n   201\t    \"\"\"A band [low, high) (None: open-ended) shares at least one value with the outcome's set.\"\"\"\n   202\t    lo, lo_c, hi, hi_c = values\n   203\t    b_lo = band[0] if band[0] is not None else float('-inf')\n   204\t    b_hi = band[1] if band[1] is not None else float('inf')\n   205\t    low, low_closed = (lo, lo_c) if lo > b_lo else ((b_lo, True) if b_lo > lo else (lo, lo_c))\n   206\t    high, high_closed = (hi, hi_c) if hi < b_hi else ((b_hi, False) if b_hi < hi else (hi, False))\n   207\t    return low < high or (low == high and low_closed and high_closed)\n   208\t\n   209\t\n   210\tdef _exceeds(part, whole):\n   211\t    \"\"\"[46t.2] With a bound on either side, the part exceeds its whole only when no pair of allowed values fits (part min above whole\n   212\t    max). Closed ranges and points keep the paired-end rule (each end of the part at most the same end of the whole).\"\"\"\n   213\t    (plo, plc, phi, phc), (wlo, wlc, whi, whc) = part, whole\n   214\t    inf = float('inf')\n   215\t    if inf in (abs(plo), abs(phi), abs(wlo), abs(whi)):\n   216\t        return plo > whi + 1e-9 or (abs(plo - whi) <= 1e-9 and not (plc and whc))\n   217\t    return plo > wlo + 1e-9 or phi > whi + 1e-9\n   218\t\n   219\t\n   220\tdef _below(values, edge):\n   221\t    lo, lo_c, hi, hi_c = values\n   222\t    return hi < edge or (hi == edge and not hi_c)\n   223\t\n   224\t\n   225\tdef _at_or_above(values, edge):\n   226\t    lo, lo_c, hi, hi_c = values\n   227\t    return lo >= edge\n   228\t\n   229\t\n   230\tdef _crossings(base, alt, bands):\n   231\t    \"\"\"Band edges between two value sets, each with its own certainty: definite when one set lies wholly below the edge and the other\n   232\t    wholly at or above it; possible when the sets differ and the edge lies within their span.\"\"\"\n   233\t    edges = sorted({e for band in bands for e in band if e is not None})\n   234\t    definite = [e for e in edges if (_below(base, e) and _at_or_above(alt, e)) or (_below(alt, e) and _at_or_above(base, e))]\n   235\t    span_lo, span_hi = min(base[0], alt[0]), max(base[2], alt[2])\n   236\t    possible = [e for e in edges if e not in definite and span_lo < e <= span_hi and base != alt]\n   237\t    return definite, possible\n   238\t\n   239\t\n   240\tSTRICT = {'>', '<'}\n   241\t\n   242\t\n   243\tdef _evaluate_bounded(figs, refs, overrides):\n   244\t    \"\"\"[46t.1] Recompute (interval, bound) for every figure, carrying open and closed bounds through the arithmetic.\"\"\"\n   245\t    values, order, done = {}, [], set()\n   246\t\n   247\t    def visit(fid):\n   248\t        if fid in done:\n   249\t            return\n   250\t        done.add(fid)\n   251\t        for r in refs(figs[fid]):\n   252\t            if r in figs:\n   253\t                visit(r)\n   254\t        order.append(fid)\n   255\t    for fid in figs:\n   256\t        visit(fid)\n   257\t    for fid in order:\n   258\t        fig = figs[fid]\n   259\t        if fid in overrides:\n   260\t            values[fid] = overrides[fid]\n   261\t        elif fig['kind'] == 'computed' and fig.get('operation') in OPERATIONS:\n   262\t            t_ids, t_signs = _terms(fig)\n   263\t            ins = [values[i] for i in t_ids]\n   264\t            interval = _compute(fig['operation'], [iv + (figs[i]['unit'],) for (iv, _), i in zip(ins, t_ids)], t_signs, fig['unit']) if ins else (0.0, 0.0)\n   265\t            pseudo = [{'bound': b} for _, b in ins]\n   266\t            side = _bound_direction(fig['operation'], pseudo, t_signs)\n   267\t            strict = any(b in STRICT for _, b in ins)\n   268\t            bound = {'lower': '>' if strict else '>=', 'upper': '<' if strict else '<=', 'two-sided': 'approx', 'mixed': 'mixed', None: None}[side]\n   269\t            values[fid] = (interval, bound)\n   270\t        else:\n   271\t            values[fid] = (_interval(fig), fig.get('bound'))\n   272\t    return values\n   273\t\n   274\t\n   275\tdef _set_from(interval, bound):\n   276\t    fig = {'low': interval[0], 'high': interval[1], 'bound': bound} if interval[0] != interval[1] else {'value': interval[0], 'bound': bound}\n   277\t    return _outcome_set(fig)\n   278\t\n   279\t\n   280\tdef _close(declared, expected, unit):\n   281\t    floor = 0.05 if unit == '%' else 0.1\n   282\t    return abs(declared - expected) <= max(0.005 * abs(expected), floor)\n   283\t\n   284\t\n   285\tQUARTERS = {'Q1': {1}, 'Q2': {2}, 'Q3': {3}, 'Q4': {4}, 'H1': {1, 2}, 'H2': {3, 4}}\n   286\t\n   287\t\n   288\tdef _quarters(period):\n   289\t    \"\"\"'FY2027' -> (FY2027, {1..4}); 'FY2027 Q3' -> (FY2027, {3}); 'FY2027 H1' -> {1, 2}; else None.\"\"\"\n   290\t    parts = period.split()\n   291\t    if len(parts) == 1 and parts[0].startswith('FY'):\n   292\t        return parts[0], {1, 2, 3, 4}\n   293\t    if len(parts) == 2 and parts[0].startswith('FY') and parts[1] in QUARTERS:\n   294\t        return parts[0], QUARTERS[parts[1]]\n   295\t    return None\n   296\t\n   297\t\n   298\tdef _key(what):\n   299\t    return (what['population'], what['measure'], what['scope'], what['period'])\n   300\t\n   301\t\n   302\tdef check(family, passages, calc):\n   303\t    errors, recorded = [], []\n   304\t    figs = {}\n   305\t    for fig in calc['figures']:\n   306\t        if fig['id'] in figs:\n   307\t            errors.append(('C7', f'{fig[\"id\"]} is defined twice'))\n   308\t        figs[fig['id']] = fig\n   309\t\n   310\t    def refs(fig):\n   311\t        out = list(fig.get('inputs', []))\n   312\t        out += [r for r in fig.get('rests_on', []) if r in figs or r not in passages]\n   313\t        if fig.get('adjusts'):\n   314\t            out.append(fig['adjusts']['figure'])\n   315\t        if fig.get('bridge'):\n   316\t            out.append(fig['bridge'])\n   317\t        return out\n   318\t\n   319\t    # C7 structure: kinds, operations, dangling, cycles, numbers\n   320\t    for fig in figs.values():\n   321\t        has_value = isinstance(fig.get('value'), (int, float))\n   322\t        has_range = isinstance(fig.get('low'), (int, float)) and isinstance(fig.get('high'), (int, float))\n   323\t        if has_value == has_range or (has_range and fig['low'] > fig['high']):          # [46o.2] exactly one: a value or an ordered range\n   324\t            errors.append(('C7', f'{fig[\"id\"]}: a figure needs either a value or a complete range with low at most high'))\n   325\t        if fig.get('kind') not in KINDS or fig.get('basis') not in BASES:\n   326\t            errors.append(('C7', f'{fig[\"id\"]}: kind {fig.get(\"kind\")} or basis {fig.get(\"basis\")} outside the closed set'))\n   327\t        if fig.get('kind') == 'computed' and fig.get('operation') not in OPERATIONS:\n   328\t            errors.append(('C7', f'{fig[\"id\"]}: operation {fig.get(\"operation\")} outside the closed set'))\n   329\t        elif fig.get('kind') == 'computed':\n   330\t            lo_n, hi_n = ARITY[fig['operation']]\n   331\t            if not lo_n <= len(fig.get('inputs', [])) <= hi_n:\n   332\t                errors.append(('C7', f'{fig[\"id\"]}: {fig[\"operation\"]} takes {lo_n}' + (f' to {hi_n}' if hi_n != lo_n else '')\n   333\t                                     + f' operands, not {len(fig.get(\"inputs\", []))}'))\n   334\t            signs = fig.get('signs')\n   335\t            if signs is not None and (fig['operation'] not in ('sum', 'roll_forward') or len(signs) != len(fig.get('inputs', []))\n   336\t                                      or any(x not in (1, -1) for x in signs)):\n   337\t                errors.append(('C7', f'{fig[\"id\"]}: signs must give one +1 or -1 per operand of a sum or roll_forward'))   # [46n]\n   338\t        for r in refs(fig):\n   339\t            if r not in figs:\n   340\t                errors.append(('C7', f'{fig[\"id\"]} refers to {r}, which is not defined'))\n   341\t    state = {}\n   342\t\n   343\t    def cyclic(fid):\n   344\t        if state.get(fid) == 1:\n   345\t            return True\n   346\t        if state.get(fid) == 2 or fid not in figs:\n   347\t            return False\n   348\t        state[fid] = 1\n   349\t        hit = any(cyclic(r) for r in refs(figs[fid]))\n   350\t        state[fid] = 2\n   351\t        return hit\n   352\t    if any(cyclic(fid) for fid in figs):\n   353\t        errors.append(('C7', 'the figure graph has a cycle'))\n   354\t    if errors:                                         # [46n] a malformed calculation is refused before any arithmetic\n   355\t        return {'errors': errors, 'recorded': recorded}\n   356\t\n   357\t    # C1 sources, prior pointers\n   358\t    for fig in figs.values():\n   359\t        if fig['kind'] == 'source':\n   360\t            errors += _source_errors(fig, passages)\n   361\t        if fig['kind'] == 'prior' and not fig.get('pointer'):\n   362\t            errors.append(('C7', f'{fig[\"id\"]}: a prior forecast needs an exact pointer to an earlier answer shown in the request'))\n   363\t\n   364\t    try:\n   365\t        return _check_after_structure(family, passages, calc, figs, refs, errors, recorded, reachable_factory=None)\n   366\t    except (ZeroDivisionError, OverflowError, ValueError) as error:          # [47.3] an arithmetic failure is a refusal, never a crash\n   367\t        errors.append(('C2', f'the calculation cannot be evaluated: {type(error).__name__}: {error}'))\n   368\t        return {'errors': errors, 'recorded': recorded}\n   369\t\n   370\t\n   371\tdef _check_after_structure(family, passages, calc, figs, refs, errors, recorded, reachable_factory=None):\n   372\t    # C2 arithmetic and bound propagation\n   373\t    for fig in figs.values():\n   374\t        if fig['kind'] != 'computed' or fig.get('operation') not in OPERATIONS:\n   375\t            continue\n   376\t        t_ids, t_signs = _terms(fig)\n   377\t        ins = [figs[i] for i in t_ids if i in figs]\n   378\t        expected = _compute(fig['operation'], [_interval(i) + (i['unit'],) for i in ins], t_signs, fig['unit']) if ins else (0.0, 0.0)   # [46x.2]\n   379\t        lo, hi = _interval(fig)\n   380\t        if not ins and (lo != 0 or hi != 0):              # [46y.2] an algebraic zero is exactly zero\n   381\t            errors.append(('C2', f'{fig[\"id\"]}: its operands cancel exactly, so it is 0, not {lo}–{hi}'))\n   382\t            continue\n   383\t        if fig['operation'] == 'range_from_relative' or ('low' in fig):\n   384\t            ok = _close(lo, expected[0], fig['unit']) and _close(hi, expected[1], fig['unit'])\n   385\t        else:\n   386\t            ok = _close(lo, (expected[0] + expected[1]) / 2, fig['unit'])\n   387\t        if not ok:\n   388\t            errors.append(('C2', f'{fig[\"id\"]}: declared {lo}–{hi} but {fig[\"operation\"]} of {fig[\"inputs\"]} gives {expected[0]:.2f}–{expected[1]:.2f}'))\n   389\t        want = _bound_direction(fig['operation'], ins, t_signs)\n   390\t        have = DIRECTION.get(fig.get('bound'))\n   391\t        if want == 'mixed':\n   392\t            errors.append(('C2', f'{fig[\"id\"]}: its inputs are bounded on opposite sides, so its value is unbounded; state it as an estimate'))\n   393\t        elif want is not None and have != want:\n   394\t            errors.append(('C2', f'{fig[\"id\"]}: its inputs make it a {want} bound, but it is declared {fig.get(\"bound\") or \"a point\"}'))\n   395\t        elif want is None and fig.get('bound'):\n   396\t            errors.append(('C2', f'{fig[\"id\"]}: its inputs are points, but it is declared a bound ({fig[\"bound\"]})'))\n   397\t\n   398\t    # C8 operand compatibility\n   399\t    for fig in figs.values():\n   400\t        if fig['kind'] != 'computed' or fig.get('operation') not in OPERATIONS:\n   401\t            continue\n   402\t        ins = [figs[i] for i in fig['inputs'] if i in figs]\n   403\t        op, rel, out = fig['operation'], fig.get('relation'), fig['what']\n   404\t        differing = [i['id'] for i in ins if i['unit'] not in ('%', 'x') and\n   405\t                     (i['what']['population'], i['what']['scope'], i['what']['period'], i['what']['measure']) !=\n   406\t                     (out['population'], out['scope'], out['period'], out['measure'])]\n   407\t        if op in ('sum', 'difference'):\n   408\t            money = [i for i in ins if i['unit'] not in ('%', 'x')]\n   409\t            same_qty = all((i['what']['population'], i['what']['measure'], i['what']['scope']) ==\n   410\t                           (out['population'], out['measure'], out['scope']) for i in money)\n   411\t            if rel == 'time_aggregation':\n   412\t                qs = [_quarters(i['what']['period']) for i in money]\n   413\t                q_out = _quarters(out['period'])\n   414\t                union = set().union(*[q[1] for q in qs]) if all(qs) else None\n   415\t                disjoint = all(qs) and sum(len(q[1]) for q in qs) == len(union or ())\n   416\t                if not (same_qty and q_out and all(qs) and disjoint and union == q_out[1] and all(q[0] == q_out[0] for q in qs)):\n   417\t                    errors.append(('C8', f'{fig[\"id\"]}: time aggregation needs one quantity over disjoint periods forming {out[\"period\"]}'))\n   418\t            elif rel in ('overlap_unknown', 'stated_in_addition'):\n   419\t                if rel == 'overlap_unknown' and fig.get('disputed') not in fig['inputs']:\n   420\t                    errors.append(('C8', f'{fig[\"id\"]}: overlap_unknown must name a disputed operand among its inputs'))\n   421\t            elif rel == 'accounting_parts':\n   422\t                wholes = {(r['whole_scope'], tuple(r['part_scopes'])) for r in family.get('scope_parts', [])}\n   423\t                if not any(out['scope'] == w and all(i['what']['scope'] in p for i in money) for w, p in wholes):\n   424\t                    errors.append(('C8', f'{fig[\"id\"]}: accounting_parts needs a declared split of {out[\"scope\"]}'))\n   425\t            elif differing:\n   426\t                errors.append(('C8', f'{fig[\"id\"]}: {op} of different quantities or periods ({\", \".join(differing)}) states no relation'))\n   427\t        elif op == 'roll_forward':\n   428\t            opening = ins[0]['what']['period'] if ins else ''\n   429\t            if not (opening.startswith('as of') and all(not i['what']['period'].startswith('as of') for i in ins[1:])\n   430\t                    and out['period'].startswith(('as of', 'end of'))):\n   431\t                errors.append(('C8', f'{fig[\"id\"]}: roll_forward needs an opening balance as of a date, flows after it, and a closing balance'))\n   432\t            if rel == 'overlap_unknown' and fig.get('disputed') not in fig['inputs']:\n   433\t                errors.append(('C8', f'{fig[\"id\"]}: overlap_unknown must name a disputed operand among its inputs'))\n   434\t        elif op == 'share':\n   435\t            pct = [i for i in ins if i['unit'] == '%']\n   436\t            if len(pct) != 1:\n   437\t                errors.append(('C8', f'{fig[\"id\"]}: a share needs one share figure and one whole'))\n   438\t        elif op == 'apply_growth' and any(r['type'] == 'same_base' for r in family.get('relations', [])) and \\\n   439\t                all(i['unit'] == '%' or i['what']['scope'] == out['scope'] for i in ins):\n   440\t            pass\n   441\t        elif op in ('range_from_relative', 'growth'):\n   442\t            pass\n   443\t        elif op in ('ratio', 'product') and _per_unit(op, ins, fig):\n   444\t            pass                                   # a total over a per-unit price gives units; units times the price give the total\n   445\t        elif op == 'product' and any(i['unit'] == 'x' for i in ins) and all(\n","exit_code":0,"status":"completed"}}
