{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba docs/research/2026-11-22-number-answers/calc_check.py | sed -n '446,920p'\"","aggregated_output":"   446\t                i['unit'] == 'x' or (i['what']['population'], i['what']['measure'], i['what']['scope']) ==\n   447\t                (out['population'], out['measure'], out['scope']) for i in ins):\n   448\t            pass                                   # a multiplier the source states between periods is its own bridge\n   449\t        elif differing:\n   450\t            bridge = figs.get(fig.get('bridge'))\n   451\t            if not bridge or bridge['kind'] != 'estimate' or set(bridge.get('converts', [])) != set(differing):\n   452\t                errors.append(('C8', f'{fig[\"id\"]}: converts {\", \".join(differing)} to {out[\"population\"]} {out[\"scope\"]} {out[\"period\"]} '\n   453\t                                     f'{out[\"measure\"]} with no bridge naming those operands'))\n   454\t            else:\n   455\t                recorded.append({'type': 'bridge', 'figure': fig['id'], 'bridge': bridge['id'], 'alternate': 'undetermined'})\n   456\t\n   457\t    # [46z.2] one recomputed result: every computed figure takes its recomputed value and bound for every later check and for publication\n   458\t    recomputed = _evaluate_bounded(figs, refs, {})\n   459\t    for fid, fig in list(figs.items()):\n   460\t        if fig['kind'] == 'computed' and fig.get('operation') in OPERATIONS:\n   461\t            (lo_r, hi_r), b_r = recomputed[fid]\n   462\t            canon = {k: v for k, v in fig.items() if k not in ('value', 'low', 'high', 'bound')}\n   463\t            canon.update({'value': lo_r} if lo_r == hi_r else {'low': lo_r, 'high': hi_r})\n   464\t            if b_r:\n   465\t                canon['bound'] = b_r\n   466\t            figs[fid] = canon\n   467\t\n   468\t    # answers: C7 coverage and ownership, C6 rung, C5 reference\n   469\t    members = family['members']\n   470\t    seen = {}\n   471\t    for ans in calc['answers']:\n   472\t        seen[ans['view_id']] = seen.get(ans['view_id'], 0) + 1\n   473\t    for view_id in members:\n   474\t        if seen.get(view_id, 0) != 1:\n   475\t            errors.append(('C7', f'{view_id} has {seen.get(view_id, 0)} answers; exactly one is required'))\n   476\t    for view_id in seen:\n   477\t        if view_id not in members:\n   478\t            errors.append(('C7', f'{view_id} is not a member of the family'))\n   479\t    outcomes = {}\n   480\t    for ans in calc['answers']:\n   481\t        member = members.get(ans['view_id'])\n   482\t        if member is None:\n   483\t            continue\n   484\t        if ans.get('shape') == 'unresolved':\n   485\t            if 'outcome' in ans or 'rung' in ans or not ans.get('why'):\n   486\t                errors.append(('C7', f'{ans[\"view_id\"]}: an unresolved answer has a reason and neither outcome nor rung'))\n   487\t            continue\n   488\t        out = figs.get(ans.get('outcome'))\n   489\t        if out is None:\n   490\t            errors.append(('C7', f'{ans[\"view_id\"]}: outcome {ans.get(\"outcome\")} is not a figure'))\n   491\t            continue\n   492\t        if _key(out['what']) != _key(member['what']):\n   493\t            errors.append(('C7', f'{ans[\"view_id\"]}: outcome {out[\"id\"]} measures {_key(out[\"what\"])}, not the question\\'s {_key(member[\"what\"])}'))\n   494\t        outcomes[ans['view_id']] = out['id']\n   495\t        rung = ans.get('rung')\n   496\t        if not isinstance(rung, int) or isinstance(rung, bool) or not 1 <= rung <= len(member['bands']):   # [46q] before any lookup\n   497\t            errors.append(('C6', f'{ans[\"view_id\"]}: rung {rung!r} is not one of 1..{len(member[\"bands\"])}'))\n   498\t            continue\n   499\t        band = member['bands'][rung - 1]\n   500\t        shown = _outcome_set(out)                         # [46y.2, 46z.2] the recomputed value for a computed outcome\n   501\t        if not _overlaps(shown, band):                    # [46r] open and closed ends kept\n   502\t            errors.append(('C6', f'{ans[\"view_id\"]}: rung {rung} ({band}) contains no part of its outcome {shown}'))\n   503\t        ref = ans.get('reference') or {}\n   504\t        if ('figure' in ref) == ('unavailable' in ref):          # [46g.2] exactly one choice\n   505\t            errors.append(('C5', f'{ans[\"view_id\"]}: the reference must name exactly one of a figure or unavailable'))\n   506\t        elif 'unavailable' in ref:\n   507\t            if not ref['unavailable']:\n   508\t                errors.append(('C5', f'{ans[\"view_id\"]}: an unavailable reference needs a reason'))\n   509\t        else:\n   510\t            errors += _reference_errors(ans['view_id'], figs.get(ref.get('figure')), figs, passages, refs)\n   511\t\n   512\t    # [46j.1] scenario membership derived from the estimates a figure rests on; related members cover the same scenarios\n   513\t    def scen(fid):\n   514\t        return figs[fid].get('scenario', 'base')\n   515\t\n   516\t    def derived(fid):\n   517\t        return {scen(g) for g in _upstream_of(fid, figs, refs) | {fid} if figs[g]['kind'] == 'estimate' and scen(g) != 'range'}\n   518\t    for f in figs.values():\n   519\t        sc = f.get('scenario', 'base')\n   520\t        if sc == 'range' or f['kind'] not in ('computed', 'estimate'):\n   521\t            continue\n   522\t        other = derived(f['id']) - {sc}\n   523\t        if other:\n   524\t            errors.append(('C4', f'{f[\"id\"]} ({sc}) rests on estimates of another scenario ({\", \".join(sorted(other))})'))\n   525\t    for rel in family.get('relations', []):\n   526\t        if rel['type'] == 'part_of' and rel['part'] in outcomes and rel['whole'] in outcomes:\n   527\t            sp, sw = derived(outcomes[rel['part']]), derived(outcomes[rel['whole']])\n   528\t            if sp != sw:\n   529\t                errors.append(('C4', f'{rel[\"part\"]} covers scenarios {sorted(sp)} but {rel[\"whole\"]} covers {sorted(sw)}; related members cover the same'))\n   530\t\n   531\t    # [46i.1] a range summary is an estimate with low and high, is an answer's outcome, and no figure reads it\n   532\t    outcome_ids = {a.get('outcome') for a in calc['answers']}\n   533\t    for f in figs.values():\n   534\t        if f.get('scenario') != 'range':\n   535\t            continue\n   536\t        readers = [g['id'] for g in figs.values() if f['id'] in refs(g)]\n   537\t        if f['kind'] != 'estimate' or 'low' not in f or 'high' not in f or f['id'] not in outcome_ids or readers:\n   538\t            errors.append(('C4', f'{f[\"id\"]}: a range summary must be an estimate with low and high that is an answer\\'s outcome and feeds no figure'\n   539\t                                 + (f' (read by {\", \".join(readers)})' if readers else '')))\n   540\t\n   541\t    # C3 part within whole, C4 one forecast per shared quantity (every path)\n   542\t    def reachable(start, stop=None):\n   543\t        stops = set(stop) if isinstance(stop, (set, list, tuple)) else {stop}\n   544\t        seen_ids, stack = set(), [start]\n   545\t        while stack:\n   546\t            fid = stack.pop()\n   547\t            if fid in seen_ids or fid not in figs:\n   548\t                continue\n   549\t            seen_ids.add(fid)\n   550\t            if fid not in stops:\n   551\t                stack.extend(refs(figs[fid]))\n   552\t        return seen_ids\n   553\t    scenarios = {f.get('scenario', 'base') for f in figs.values() if f['basis'] == 'forecast'} or {'base'}\n   554\t    for rel in family.get('relations', []):\n   555\t        if rel['type'] != 'part_of' or rel['part'] not in outcomes or rel['whole'] not in outcomes:\n   556\t            continue\n   557\t        part_m, whole_m = members[rel['part']], members[rel['whole']]\n   558\t        for sc in scenarios:\n   559\t            for period in family.get('compare_periods', []):\n   560\t                def node(view_id, member):\n   561\t                    want = (member['what']['population'], member['what']['measure'], member['what']['scope'], period)\n   562\t                    hits = sorted((figs[f] for f in reachable(outcomes[view_id]) if _key(figs[f]['what']) == want\n   563\t                                   and figs[f]['basis'] == 'forecast' and figs[f].get('scenario', 'base') == sc), key=lambda f: f['id'])\n   564\t                    if len(hits) > 1:                 # [46x.1] one forecast per member quantity, period and scenario\n   565\t                        errors.append(('C3', f'{period} {sc}: {view_id} has {len(hits)} forecasts ({\", \".join(f[\"id\"] for f in hits)}); '\n   566\t                                             'the comparison is ambiguous'))\n   567\t                        return None\n   568\t                    return hits[0] if hits else None\n   569\t                p, w = node(rel['part'], part_m), node(rel['whole'], whole_m)\n   570\t                if p and w and _exceeds(_outcome_set(p), _outcome_set(w)):          # [46s] open and closed ends kept\n   571\t                    errors.append(('C3', f'{period} {sc}: {rel[\"part\"]} {p[\"id\"]} {_outcome_set(p)} exceeds {rel[\"whole\"]} {w[\"id\"]} {_outcome_set(w)}'))\n   572\t    for shared in family.get('shared', []):\n   573\t        want = _key(shared)\n   574\t        nodes = [f for f in figs.values() if _key(f['what']) == want and f['basis'] == 'forecast']\n   575\t        touched = [v for v, o in outcomes.items() if any(_key(figs[f]['what']) == want for f in reachable(o))]\n   576\t        if not touched:\n   577\t            continue\n   578\t        per_scenario = {}\n   579\t        for n in nodes:\n   580\t            per_scenario.setdefault(n.get('scenario', 'base'), []).append(n['id'])\n   581\t        if not nodes:\n   582\t            errors.append(('C4', f'{want}: no forecast node, though {\", \".join(touched)} depend on it'))\n   583\t        for sc, ids in sorted(per_scenario.items()):\n   584\t            if len(ids) != 1:\n   585\t                errors.append(('C4', f'{want} {sc}: {len(ids)} forecast nodes ({\", \".join(ids)}); exactly one per scenario is required'))\n   586\t        stop = {n['id'] for n in nodes}\n   587\t        for f in figs.values():                       # [46i.1] scenario membership is derived along the whole path, not declared\n   588\t            sc = f.get('scenario', 'base')\n   589\t            if sc == 'range' or f['kind'] not in ('computed', 'estimate'):\n   590\t                continue\n   591\t            upstream = _upstream_of(f['id'], figs, refs)\n   592\t            borrowed = sorted(r for r in upstream if r in stop and figs[r].get('scenario', 'base') != sc)\n   593\t            if borrowed:\n   594\t                errors.append(('C4', f'{want}: {f[\"id\"]} ({sc}) depends on {\", \".join(borrowed)} of another scenario'))\n   595\t        for view_id in touched:                      # [46g.3] a bypass reaches the quantity through no forecast node of any scenario\n   596\t            bypass = [f for f in reachable(outcomes[view_id], stop=stop) if f not in stop and _key(figs[f]['what']) == want]\n   597\t            if bypass:\n   598\t                errors.append(('C4', f'{want}: {view_id} reaches {\", \".join(sorted(bypass))} without passing a forecast node ({\", \".join(sorted(stop))})'))\n   599\t    for rel in family.get('relations', []):           # [46j.2] the later member rests on the earlier member's forecast nodes, per scenario\n   600\t        if rel['type'] != 'same_base' or rel['later'] not in outcomes or rel['earlier'] not in outcomes:\n   601\t            continue\n   602\t        base_key = _key(members[rel['earlier']]['what'])\n   603\t        earlier_graph = _upstream_of(outcomes[rel['earlier']], figs, refs) | {outcomes[rel['earlier']]}\n   604\t        earlier_nodes = {f for f in earlier_graph if _key(figs[f]['what']) == base_key and figs[f]['basis'] == 'forecast'}\n   605\t        reached = reachable(outcomes[rel['later']], stop=earlier_nodes)\n   606\t        bypass = [f for f in reached if f not in earlier_nodes and _key(figs[f]['what']) == base_key]\n   607\t        later_key = _key(members[rel['later']]['what'])\n   608\t        e_out = outcomes[rel['earlier']]                  # [46z.1] the published forecast, or the scenario paths its range summary rests on\n   609\t        if figs[e_out].get('scenario') == 'range':\n   610\t            by_scenario = {}\n   611\t            for n in sorted(r for r in figs[e_out].get('rests_on', []) if r in figs and _key(figs[r]['what']) == base_key\n   612\t                            and figs[r]['basis'] == 'forecast'):\n   613\t                by_scenario.setdefault(figs[n].get('scenario', 'base'), []).append(n)\n   614\t        else:\n   615\t            by_scenario = {figs[e_out].get('scenario', 'base'): [e_out]}\n   616\t        later_graph = _upstream_of(outcomes[rel['later']], figs, refs) | {outcomes[rel['later']]}\n   617\t        for f in sorted(later_graph):                 # [46k.1] every later scenario path reaches the earlier forecast of its own scenario\n   618\t            sc = figs[f].get('scenario', 'base')\n   619\t            if sc == 'range' or _key(figs[f]['what']) != later_key or figs[f]['basis'] != 'forecast':\n   620\t                continue\n   621\t            cands = by_scenario.get(sc) or (next(iter(by_scenario.values())) if len(by_scenario) == 1 else [])\n   622\t            used = [c for c in cands if c in _determining(f, figs)]\n   623\t            target = used[0] if used else None\n   624\t            if target is None:                            # [46l.1] through value-determining inputs only\n   625\t                errors.append(('C9', f'{f} ({sc}) of {rel[\"later\"]} is not computed from {rel[\"earlier\"]}\\'s {sc} forecast'))\n   626\t            else:                                     # [46o.1, 46p] its value moves when that forecast moves: one realisation per figure\n   627\t                mid_t = sum(_interval(figs[target])) / 2\n   628\t                before = _evaluate_points(figs, refs, {})[f]\n   629\t                after = _evaluate_points(figs, refs, {target: mid_t * 1.1})[f]\n   630\t                if abs(after - before) <= 1e-9 * max(1.0, abs(before)):\n   631\t                    errors.append(('C9', f'{f} ({sc}) of {rel[\"later\"]} does not change when {rel[\"earlier\"]}\\'s forecast {target} changes'))\n   632\t        later_scen = {figs[f].get('scenario', 'base') for f in later_graph if _key(figs[f]['what']) == later_key\n   633\t                      and figs[f]['basis'] == 'forecast' and figs[f].get('scenario', 'base') != 'range'}\n   634\t        if earlier_nodes and not later_scen:              # [46m.2] a citation never stands in for a calculation\n   635\t            errors.append(('C9', f'{rel[\"later\"]} has no calculation from {rel[\"earlier\"]}\\'s forecast, only a range resting on it'))\n   636\t        if len(by_scenario) > 1 and later_scen != set(by_scenario):     # [46l.1] the later member covers the earlier's scenarios\n   637\t            errors.append(('C9', f'{rel[\"later\"]} covers scenarios {sorted(later_scen)} but {rel[\"earlier\"]} covers {sorted(by_scenario)}'))\n   638\t        if not reached & earlier_nodes:\n   639\t            errors.append(('C9', f'{rel[\"later\"]} does not rest on {rel[\"earlier\"]}\\'s forecast ({\", \".join(sorted(earlier_nodes))})'))\n   640\t        if bypass:\n   641\t            errors.append(('C9', f'{rel[\"later\"]} reaches {\", \".join(sorted(bypass))} for {base_key} without {rel[\"earlier\"]}\\'s forecast'))\n   642\t    supplied = family.get('prior_answers', {})\n   643\t    for fig in figs.values():\n   644\t        earlier = fig['kind'] == 'prior' or fig.get('basis') == 'prior_forecast' or 'pointer' in fig   # [46i.2] derived, not labelled\n   645\t        if not earlier:\n   646\t            continue\n   647\t        if fig['kind'] != 'prior' or fig.get('basis') != 'prior_forecast':\n   648\t            errors.append(('C10', f'{fig[\"id\"]}: an earlier forecast must be kind prior with basis prior_forecast'))\n   649\t        ptr, ans_prior = fig.get('pointer', {}), supplied.get(fig.get('pointer', {}).get('view'), {})\n   650\t        if ans_prior.get('day') != ptr.get('day') or not any(_same(fig.get('value'), v) for v in ans_prior.get('values', [])):\n   651\t            errors.append(('C10', f'{fig[\"id\"]}: no earlier answer of {ptr.get(\"view\")} on {ptr.get(\"day\")} shown in the request states {fig.get(\"value\")}'))\n   652\t        owners = [a['view_id'] for a in calc['answers'] if a.get('outcome') == fig['id']]\n   653\t        if owners:                                    # [46h.2] nor the current outcome\n   654\t            errors.append(('C10', f'{fig[\"id\"]}: an earlier forecast cannot be the current outcome of {\", \".join(owners)}'))\n   655\t        users = [f['id'] for f in figs.values() if fig['id'] in refs(f)]\n   656\t        if users:\n   657\t            errors.append(('C10', f'{fig[\"id\"]}: an earlier forecast is for comparison only and cannot feed {\", \".join(users)}'))\n   658\t\n   659\t    recorded += _assumptions(family, figs, outcomes, calc, refs)\n   660\t    finite = lambda v: v if abs(v) != float('inf') else None\n   661\t    published = {v: [finite(_outcome_set(figs[o])[0]), finite(_outcome_set(figs[o])[2]), figs[o].get('bound')] for v, o in outcomes.items()}\n   662\t    return {'errors': errors, 'recorded': recorded, 'published': published}\n   663\t\n   664\t\n   665\tdef _per_unit(op, ins, fig):\n   666\t    \"\"\"The per-unit identity: ratio(total, price per unit) -> units, product(units, price per unit) -> total, for one population and\n   667\t    scope. Labels are the judge's; a reader checks them against the passages.\"\"\"\n   668\t    out = fig['what']\n   669\t    if len(ins) != 2:\n   670\t        return False\n   671\t    same = all((i['what']['population'], i['what']['scope']) == (out['population'], out['scope']) for i in ins)\n   672\t    price = [i for i in ins if i['what']['measure'] == 'price per unit' and i['unit'] in ('USD', 'USD bn')]\n   673\t    if op == 'ratio':\n   674\t        return same and len(price) == 1 and ins[1] is price[0] and out['measure'] == 'units' and ins[0]['unit'] in ('USD', 'USD bn')\n   675\t    units = [i for i in ins if i['what']['measure'] == 'units' and i['unit'] == 'units']\n   676\t    return same and len(price) == 1 and len(units) == 1 and fig['unit'] in ('USD', 'USD bn')\n   677\t\n   678\t\n   679\tdef member_sources(answer, figs):\n   680\t    \"\"\"[46k.3, 46ac.1] The source figures a member's own outcome and reference rest on, each identified by its passage, expression and\n   681\t    the component used.\"\"\"\n   682\t    refs = lambda f: list(f.get('inputs', [])) + [r for r in f.get('rests_on', []) if r in figs] + \\\n   683\t        ([f['adjusts']['figure']] if f.get('adjusts') else []) + ([f['bridge']] if f.get('bridge') else [])\n   684\t    own = set()\n   685\t    for start in (answer.get('outcome'), (answer.get('reference') or {}).get('figure')):\n   686\t        if start in figs:\n   687\t            own |= _upstream_of(start, figs, refs) | {start}\n   688\t    return sorted(f'{figs[f][\"evidence\"]}|{figs[f][\"expression\"]}|{figs[f].get(\"component\", \"value\")}' for f in own if figs[f]['kind'] == 'source')\n   689\t\n   690\t\n   691\tdef changed(previous, answer, figs):\n   692\t    \"\"\"D728: whether a member's conclusion changed, derived by code from its earlier rung, outcome and source figures.\"\"\"\n   693\t    if previous is None:\n   694\t        return True, 'first judgement'\n   695\t    was_unresolved = previous.get('shape') == 'unresolved'\n   696\t    if answer.get('shape') == 'unresolved' or was_unresolved:          # [46ac.2] an unresolved answer is routed before any number\n   697\t        if answer.get('shape') == 'unresolved' and was_unresolved:\n   698\t            return False, 'still unresolved'\n   699\t        return True, 'now unresolved' if answer.get('shape') == 'unresolved' else 'now a forecast'\n   700\t    refs = lambda f: list(f.get('inputs', [])) + [r for r in f.get('rests_on', []) if r in figs] + \\\n   701\t        ([f['adjusts']['figure']] if f.get('adjusts') else []) + ([f['bridge']] if f.get('bridge') else [])\n   702\t    out = figs[answer['outcome']]\n   703\t    if out['kind'] == 'computed':                     # [46aa] the same recomputed outcome publication uses\n   704\t        (lo_r, hi_r), b_r = _evaluate_bounded(figs, refs, {})[out['id']]\n   705\t        out = {k: v for k, v in out.items() if k not in ('value', 'low', 'high', 'bound')}\n   706\t        out.update({'value': lo_r} if lo_r == hi_r else {'low': lo_r, 'high': hi_r})\n   707\t        if b_r:\n   708\t            out['bound'] = b_r\n   709\t    sources = member_sources(answer, figs)\n   710\t    reasons = []\n   711\t    if answer['rung'] != previous['rung']:\n   712\t        reasons.append(f'rung {previous[\"rung\"]} to {answer[\"rung\"]}')\n   713\t    # [46l.2, 46ab] the published outcome as published: both ends (None for an open-ended side) and the bound\n   714\t    o_lo, _, o_hi, _ = _outcome_set(out)\n   715\t    finite = lambda v: None if v is None or abs(v) == float('inf') else round(v, 6)\n   716\t    cur = (finite(o_lo), finite(o_hi), out.get('bound'))\n   717\t    prev = previous['outcome']\n   718\t    if isinstance(prev, (int, float)):\n   719\t        prev = (prev, prev, None)\n   720\t    elif len(prev) == 2:\n   721\t        prev = (prev[0], prev[1], None)\n   722\t    prev = (finite(prev[0]), finite(prev[1]), prev[2])\n   723\t    near = lambda a, b: (a is None and b is None) or (a is not None and b is not None and abs(a - b) <= 0.005 * max(abs(b), 1e-9))\n   724\t    if cur[2] != prev[2] or not near(cur[0], prev[0]) or not near(cur[1], prev[1]):\n   725\t        reasons.append(f'outcome {list(prev)} to {list(cur)}')\n   726\t    added, dropped = sorted(set(sources) - set(previous['sources'])), sorted(set(previous['sources']) - set(sources))\n   727\t    if added or dropped:\n   728\t        reasons.append(f'source figures added {added}, dropped {dropped}')\n   729\t    return bool(reasons), '; '.join(reasons) or 'unchanged'\n   730\t\n   731\t\n   732\tdef publish_decision(family, calc, result):\n   733\t    \"\"\"DESIGN.md §4: 'refused' when a check fails (the harness retries once); 'held' when a member is unresolved and a declared\n   734\t    relation joins it to another member; else 'publish' (unresolved members shown as unresolved).\"\"\"\n   735\t    if result['errors']:\n   736\t        return 'refused'\n   737\t    unresolved = {a['view_id'] for a in calc['answers'] if a.get('shape') == 'unresolved'}\n   738\t    for rel in family.get('relations', []):\n   739\t        ends = {rel.get('part'), rel.get('whole'), rel.get('later'), rel.get('earlier')} - {None}\n   740\t        if ends & unresolved and ends - unresolved:\n   741\t            return 'held'\n   742\t    return 'publish'\n   743\t\n   744\t\n   745\tdef family_outcome(attempts):\n   746\t    \"\"\"The round's outcome from up to two attempts' decisions: a refusal is retried once; two refusals make the family unresolved.\"\"\"\n   747\t    if attempts[0] != 'refused':\n   748\t        return attempts[0]\n   749\t    if len(attempts) > 1 and attempts[1] != 'refused':\n   750\t        return attempts[1]\n   751\t    return 'unresolved'\n   752\t\n   753\t\n   754\tdef _determining(fid, figs):\n   755\t    \"\"\"The figures that determine fid's value: computed inputs only, at any depth (an estimate's rests_on explains, it does not compute).\"\"\"\n   756\t    seen_ids, stack = set(), list(figs[fid].get('inputs', [])) if figs[fid]['kind'] == 'computed' else []\n   757\t    while stack:\n   758\t        f = stack.pop()\n   759\t        if f in seen_ids or f not in figs:\n   760\t            continue\n   761\t        seen_ids.add(f)\n   762\t        if figs[f]['kind'] == 'computed':\n   763\t            stack.extend(figs[f].get('inputs', []))\n   764\t    return seen_ids\n   765\t\n   766\t\n   767\tdef _upstream_of(fid, figs, refs):\n   768\t    \"\"\"The figures that fid's own value is computed from (fid excluded).\"\"\"\n   769\t    seen_ids, stack = set(), list(refs(figs[fid]))\n   770\t    while stack:\n   771\t        f = stack.pop()\n   772\t        if f in seen_ids or f not in figs:\n   773\t            continue\n   774\t        seen_ids.add(f)\n   775\t        stack.extend(refs(figs[f]))\n   776\t    return seen_ids\n   777\t\n   778\t\n   779\tdef _reference_errors(view_id, ref, figs, passages, refs):\n   780\t    if ref is None:\n   781\t        return [('C5', f'{view_id}: the reference names no figure')]\n   782\t    graph = [ref['id']] + sorted(_upstream_of(ref['id'], figs, refs))\n   783\t    nodes = [figs[f] for f in graph]\n   784\t    if any(n['kind'] in ('estimate', 'prior') or n['basis'] in ('forecast', 'prior_forecast') for n in nodes):\n   785\t        return [('C5', f'{view_id}: the reference {ref[\"id\"]} rests on the system\\'s own forecast or an estimate')]\n   786\t    leaves = [n for n in nodes if n['kind'] == 'source']\n   787\t    if not any(n['basis'] in EXTERNAL and passages.get(n['evidence'], {}).get('speaker') != 'system' for n in leaves):\n   788\t        return [('C5', f'{view_id}: the reference {ref[\"id\"]} has no external source among its leaves')]\n   789\t    if any(n['basis'] not in EXTERNAL | {'reported'} for n in leaves):\n   790\t        return [('C5', f'{view_id}: the reference {ref[\"id\"]} has a leaf that is neither external nor reported')]\n   791\t    return []\n   792\t\n   793\t\n   794\tdef _evaluate(figs, refs, overrides):\n   795\t    \"\"\"Recompute computed figures from their inputs, with some figures' values replaced; estimates keep their values.\"\"\"\n   796\t    values, order, done = {}, [], set()\n   797\t\n   798\t    def visit(fid):\n   799\t        if fid in done:\n   800\t            return\n   801\t        done.add(fid)\n   802\t        for r in refs(figs[fid]):\n   803\t            if r in figs:\n   804\t                visit(r)\n   805\t        order.append(fid)\n   806\t    for fid in figs:\n   807\t        visit(fid)\n   808\t    for fid in order:\n   809\t        fig = figs[fid]\n   810\t        if fid in overrides:\n   811\t            values[fid] = overrides[fid]\n   812\t        elif fig['kind'] == 'computed' and fig.get('operation') in OPERATIONS:\n   813\t            t_ids, t_signs = _terms(fig)\n   814\t            ins = [values[i] + (figs[i]['unit'],) for i in t_ids]\n   815\t            values[fid] = _compute(fig['operation'], ins, t_signs, fig['unit']) if ins else (0.0, 0.0)\n   816\t        else:\n   817\t            values[fid] = _interval(fig)\n   818\t    return values\n   819\t\n   820\t\n   821\tdef _evaluate_points(figs, refs, overrides):\n   822\t    \"\"\"Recompute with every figure at one point (its midpoint), the same wherever it appears; overrides set points.\"\"\"\n   823\t    values, order, done = {}, [], set()\n   824\t\n   825\t    def visit(fid):\n   826\t        if fid in done:\n   827\t            return\n   828\t        done.add(fid)\n   829\t        for r in refs(figs[fid]):\n   830\t            if r in figs:\n   831\t                visit(r)\n   832\t        order.append(fid)\n   833\t    for fid in figs:\n   834\t        visit(fid)\n   835\t    for fid in order:\n   836\t        fig = figs[fid]\n   837\t        if fid in overrides:\n   838\t            values[fid] = overrides[fid]\n   839\t        elif fig['kind'] == 'computed' and fig.get('operation') in OPERATIONS:\n   840\t            t_ids, t_signs = _terms(fig)\n   841\t            ins = [(values[i], values[i], figs[i]['unit']) for i in t_ids]\n   842\t            lo, hi = _compute(fig['operation'], ins, t_signs, fig['unit']) if ins else (0.0, 0.0)\n   843\t            values[fid] = (lo + hi) / 2\n   844\t        else:\n   845\t            values[fid] = sum(_interval(fig)) / 2\n   846\t    return values\n   847\t\n   848\t\n   849\tdef _boundaries(bands, a, b):\n   850\t    edges = sorted({e for band in bands for e in band if e is not None})\n   851\t    lo, hi = min(a, b), max(a, b)\n   852\t    return [e for e in edges if lo < e <= hi]\n   853\t\n   854\t\n   855\tdef _assumptions(family, figs, outcomes, calc, refs):\n   856\t    out = []\n   857\t    members = family['members']\n   858\t\n   859\t    def downstream_formula(start, outcome_id):\n   860\t        \"\"\"True when every figure between start and the outcome (the outcome included) is computed.\"\"\"\n   861\t        between = [f for f in [outcome_id] + sorted(_upstream_of(outcome_id, figs, refs)) if start in _upstream_of(f, figs, refs)]\n   862\t        return all(figs[f]['kind'] == 'computed' for f in between)\n   863\t    for fig in figs.values():\n   864\t        alt, kind = None, None\n   865\t        if fig['kind'] == 'computed' and fig.get('relation') == 'overlap_unknown' and fig.get('disputed') in fig.get('inputs', []):\n   866\t            t_ids, t_signs = _terms(dict(fig, inputs=[i for i in fig['inputs'] if i != fig['disputed']],\n   867\t                                         signs=[k for i, k in zip(fig['inputs'], fig.get('signs') or [1] * len(fig['inputs'])) if i != fig['disputed']]))\n   868\t            keep, signs = t_ids, t_signs\n   869\t            alt = _compute(fig['operation'], [_interval(figs[i]) + (figs[i]['unit'],) for i in keep], signs, fig['unit'])\n   870\t            side = _bound_direction(fig['operation'], [figs[i] for i in keep], signs)      # [46u.1] the retained operands' bounds\n   871\t            strict = any(figs[i].get('bound') in STRICT for i in keep)\n   872\t            kind, bound = 'overlap', {'lower': '>' if strict else '>=', 'upper': '<' if strict else '<=', 'two-sided': 'approx', 'mixed': 'mixed', None: None}[side]\n   873\t        elif fig['kind'] == 'estimate' and fig.get('adjusts'):\n   874\t            target = figs[fig['adjusts']['figure']]\n   875\t            alt, kind, bound = _interval(target), 'adjustment', target.get('bound')\n   876\t        if kind is None:\n   877\t            continue\n   878\t        for view_id, outcome_id in outcomes.items():\n   879\t            if fig['id'] != outcome_id and fig['id'] not in _upstream_of(outcome_id, figs, refs):\n   880\t                continue\n   881\t            if not downstream_formula(fig['id'], outcome_id):\n   882\t                out.append({'type': kind, 'figure': fig['id'], 'outcome': view_id, 'certainty': 'undetermined'})\n   883\t                continue\n   884\t            base_vals = _evaluate_bounded(figs, refs, {})                 # [46s, 46t.1] bounds carried through recomputation\n   885\t            alt_override = (alt, bound)\n   886\t            alt_vals = _evaluate_bounded(figs, refs, {fig['id']: alt_override})\n   887\t            base_set, alt_set = _set_from(*base_vals[outcome_id]), _set_from(*alt_vals[outcome_id])\n   888\t            definite, possible = _crossings(base_set, alt_set, members[view_id]['bands'])\n   889\t            finite = lambda v: v if abs(v) != float('inf') else None\n   890\t            out.append({'type': kind, 'figure': fig['id'], 'outcome': view_id, 'value': [finite(base_set[0]), finite(base_set[2])],\n   891\t                        'alternate': [finite(alt_set[0]), finite(alt_set[2])], 'alternate_bound': bound,\n   892\t                        'definite': definite, 'possible': possible})                      # [46t.1] certainty per boundary\n   893\t    return out\n","exit_code":0,"status":"completed"}}
