ridge'\\\\''\n  if '\\\\''states no relation'\\\\'' in s:return c+'\\\\'': relation'\\\\''\n  if '\\\\''share needs'\\\\'' in s:return c+'\\\\'': share'\\\\''\n  return c+'\\\\'': '\\\\''+s\n return c\ndef fields(d):\n for f in d['\\\\''figures'\\\\'']:\n  for k in ('\\\\''evidence'\\\\'','\\\\''bridge'\\\\'','\\\\''disputed'\\\\''):\n   yield k,f.get(k),f\n  for k in ('\\\\''inputs'\\\\'','\\\\''rests_on'\\\\'','\\\\''converts'\\\\''):\n   for v in f.get(k) or []:yield k,v,f\n  yield '\\\\''adjusts.figure'\\\\'',(f.get('\\\\''adjusts'\\\\'') or {}).get('\\\\''figure'\\\\''),f\n for a in d['\\\\''answers'\\\\'']:\n  yield '\\\\''answers[].outcome'\\\\'',a.get('\\\\''outcome'\\\\''),a\n  yield '\\\\''answers[].reference.figure'\\\\'',(a.get('\\\\''reference'\\\\'') or {}).get('\\\\''figure'\\\\''),a\ndef allowed(k,f,p):\n if k=='\\\\''evidence'\\\\'':return p['\\\\''passages'\\\\'']\n if k=='\\\\''rests_on'\\\\'':return set(f)|set(p['\\\\''passages'\\\\''])\n return f\nsys.path.insert(0,str(D))\nimport calc_check as cc\ndef passage(q,k):\n if k in q['\\\\''passages'\\\\'']:\n  print(k,'\\\\''QUOTE'\\\\'',q['\\\\''passages'\\\\''][k]['\\\\''text'\\\\''][:460])\n  lead=next((l for l in q['\\\\''user'\\\\''].splitlines() if l.startswith('\\\\''- '\\\\''+k+'\\\\'' ['\\\\'')),None)\n  if lead: print('\\\\''  HEADER'\\\\'',lead)\ndef show(n,l,ids=(),ps=(),fields_only=False):\n r=dict(J[n])[l]; q=P[r['\\\\''unit'\\\\''],r['\\\\''arm'\\\\'']]; d=r['\\\\''data'\\\\'']\n print('\\\\''\\\\n'\\\\'',n,l,r['\\\\''unit'\\\\''],r['\\\\''arm'\\\\''],r['\\\\''draw'\\\\''],'\\\\''ERRORS'\\\\'',r['\\\\''errors'\\\\''])\n for f in d['\\\\''figures'\\\\'']:\n  if ids and f['\\\\''id'\\\\''] not in ids: continue\n  print({k:v for k,v in f.items() if v is not None})\n for a in d['\\\\''answers'\\\\'']:\n  print('\\\\''ANS'\\\\'',{k:a[k] for k in ('\\\\''view_id'\\\\'','\\\\''outcome'\\\\'','\\\\''reference'\\\\'','\\\\''cites'\\\\'','\\\\''rung'\\\\'')})\n for k in ps:passage(q,k)\n if fields_only:\n  f={f['\\\\''id'\\\\''] for f in d['\\\\''figures'\\\\'']}\n  for k,v,obj in fields(d):\n   if v is not None and v not in allowed(k,f,q): print('\\\\''BAD FIELD'\\\\'',k,repr(v),obj.get('\\\\''id'\\\\'',obj.get('\\\\''view_id'\\\\'')))\n\ndef strip(x):\n if isinstance(x,dict):return {k:strip(v) for k,v in x.items() if v is not None}\n if isinstance(x,list):return [strip(y) for y in x]\n return x\nr=dict(J['\\\\''retries'\\\\''])[22]; q=P[r['\\\\''unit'\\\\''],r['\\\\''arm'\\\\'']]; c=strip(r['\\\\''data'\\\\''])\nc['\\\\''answers'\\\\''][0]['\\\\''outcome'\\\\'']='\\\\''fig_v6_forecast'\\\\''\nc['\\\\''figures'\\\\''][-1].pop('\\\\''bridge'\\\\'')\nbefore=cc.check(q['\\\\''family'\\\\''],q['\\\\''passages'\\\\''],c)['\\\\''errors'\\\\'']\nfor f in c['\\\\''figures'\\\\'']:\n if f['\\\\''unit'\\\\'']=='\\\\''USD trillion'\\\\'':f.update(unit='\\\\''USD bn'\\\\'',value=f['\\\\''value'\\\\'']*1000)\nafter=cc.check(q['\\\\''family'\\\\''],q['\\\\''passages'\\\\''],c)['\\\\''errors'\\\\'']\nprint('\\\\''S before'\\\\'',before,'\\\\''after'\\\\'',after)\nr=dict(J['\\\\''answers'\\\\''])[6]\nfor f in r['\\\\''data'\\\\'']['\\\\''figures'\\\\'']:\n if f['\\\\''id'\\\\''] in ('\\\\''dc_fy27_reference'\\\\'','\\\\''q3_total_revenue_third_party'\\\\''):print({k:v for k,v in f.items() if v is not None})\n'\"","aggregated_output":"S before [('C1', 'fig_consensus_2027: value 1.08 USD trillion bound None does not equal \"$1.08 trillion\" as component value'), ('C1', 'fig_nvidia_top_five_2027: value 1.3 USD trillion bound None does not equal \"$1.3 trillion\" as component value'), ('C6', 'v6: rung 3 ([900.0, 1100.0]) contains no part of its outcome (1.05, True, 1.05, True)')] after []\n{'id': 'q3_total_revenue_third_party', 'what': {'population': 'NVIDIA', 'measure': 'revenue', 'scope': 'company', 'period': 'FY2027 Q3'}, 'basis': 'third_party', 'scenario': 'Manali Pradhan estimate if the recent guidance-beat trend continues', 'kind': 'source', 'value': 113.6, 'bound': 'approx', 'unit': 'USD billions', 'evidence': 'e5056', 'expression': 'roughly $113.6 billion', 'component': 'value'}\n{'id': 'dc_fy27_reference', 'what': {'population': 'NVIDIA', 'measure': 'revenue', 'scope': 'Data Center', 'period': 'FY2027'}, 'basis': 'third_party', 'scenario': 'Morningstar estimate; market reference for this question', 'kind': 'source', 'value': 361, 'unit': 'USD billions', 'evidence': 'e2295', 'expression': '$361 billion', 'component': 'value'}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_35","type":"agent_message","text":"**The paid gate hit STOP. Judging-v13 needs one blind, zero-cost test of its answer format before another paid run.** Every reply wrote a forecast in words where the checker expected a figure ID. The request never said that field needed an ID. I also found checks that rejected correct calculations, including one that turned $411 billion × 92.5% into $38,017.5 billion. The run establishes that this version could publish nothing. It leaves open whether judging related questions together improves the forecasts. [Paid gate, §4](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/PAID-GATE.md:250)\n\n## 1. Census\n\nI matched all 72 finished entries to their requests and reproduced every recorded refusal in memory. Each journal also contained 36 `started` markers. The first attempts cost $0.155358 and the retries cost $0.212361, for **$0.367719 total**. All 36 first attempts and all 36 retries were refused. That gives the joint arm **0 of 9 usable pairs** against the required 8 of 9. [First attempts](/Users/lchingen/hivemind/poc/data/judging-v13-paid-gate-2026-11-22/answers.jsonl) · [Retries](/Users/lchingen/hivemind/poc/data/judging-v13-paid-gate-2026-11-22/retries.jsonl)\n\nEach check cell shows **refusal messages / replies affected**. A reply can have several messages.\n\n| Attempt | Arm | Replies | C7 structure | C1 source | C2 arithmetic or bounds | C8 compatible inputs | Stopped at first structure check |\n|---|---|---:|---:|---:|---:|---:|---:|\n| First | Joint | 9 | 39 / 9 | 0 | 0 | 0 | 9 |\n| First | Separate | 18 | 47 / 18 | 8 / 1 | 0 | 0 | 17 |\n| First | Singletons | 9 | 13 / 9 | 3 / 1 | 0 | 0 | 8 |\n| Retry | Joint | 9 | 40 / 9 | 0 | 0 | 0 | 9 |\n| Retry | Separate | 18 | 41 / 18 | 25 / 4 | 6 / 3 | 14 / 4 | 14 |\n| Retry | Singletons | 9 | 12 / 9 | 7 / 3 | 1 / 1 | 2 / 2 | 6 |\n\n- **C7, first → retry.** Undefined figure references 51 → 45, point/range violations 28 → 24, wrong operand counts 9 → 9, invalid signs 9 → 7, missing outcome links 2 → 7, cycles 0 → 1. All 52 point/range violations supplied both a point and a range. The checker stopped 63 replies before checking source figures. It also skipped the rung and reference checks when it could not find the outcome figure. That explains why only nine missing-outcome messages were logged even though all 72 replies had that problem. [Structure and early return](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/calc_check.py:302) · [Outcome, rung and reference checks](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/calc_check.py:468)\n- **Other classes.** C1 first → retry was 8 → 10 unrecognized evidence references, 2 → 6 expression mismatches, and 1 → 16 value/unit/component/bound mismatches. The retries exposed five C2 arithmetic and two bound refusals, plus ten C8 bridge, three period, two share and one overlap refusal. C3–C6 and C9–C10 had zero recorded messages. Among singletons, equity commitments produced all three first-attempt C1 messages. On retry, equity commitments produced five C1, one C2 and one C8. Vera CPU produced two C1 and one C8. Hyperscaler spending stopped at C7 in all six replies. [First attempts](/Users/lchingen/hivemind/poc/data/judging-v13-paid-gate-2026-11-22/answers.jsonl) · [Retries](/Users/lchingen/hivemind/poc/data/judging-v13-paid-gate-2026-11-22/retries.jsonl)\n\nI counted nonempty values at the named fields against the exact IDs available to that reply. The table counts **occurrences**, so a reply with two forecasts can contribute two outcome entries.\n\n| Field containing prose | First joint / separate / single | First total | Retry joint / separate / single | Retry total |\n|---|---:|---:|---:|---:|\n| `figures[].evidence` | 67 / 96 / 12 | 175 | 35 / 88 / 10 | 133 |\n| `figures[].bridge` | 25 / 18 / 6 | 49 | 23 / 17 / 4 | 44 |\n| `answers[].outcome` | 18 / 18 / 9 | 45 | 18 / 18 / 9 | 45 |\n| `answers[].reference.figure` | 16 / 15 / 8 | 39 | 12 / 13 / 7 | 32 |\n| `figures[].converts[]` | 0 / 0 / 2 | 2 | 0 / 0 / 0 | 0 |\n| `figures[].disputed` | 0 / 0 / 1 | 1 | 0 / 0 / 2 | 2 |\n| `figures[].inputs[]` | 0 / 0 / 0 | 0 | 0 / 1 / 0 | 1 |\n\n**Corrections to Claude’s counts.** The first-attempt counts of 49 bridges, 45 outcomes, 39 references and two `converts` entries match. The 175 evidence fields hold prose, but only **139** are source figures where C1 requires a passage ID. The retry split is **95 source figures out of 133**. The one `adjusts.figure` entry is `e2652`, a real passage ID in a field that needs a figure ID. The same value also appears in `inputs[]` on that figure. Claude missed the `disputed` prose in the equity-commitment first attempt. Two retry `converts[]` entries likewise use passage IDs where operand IDs are expected. Finally, the four units Claude lists are the source parser’s units. The checker also uses `units` for per-unit calculations, and it has no general unit check for estimates. [First-attempt wrong ID](/Users/lchingen/hivemind/poc/data/judging-v13-paid-gate-2026-11-22/answers.jsonl:6) · [First-attempt overlap prose](/Users/lchingen/hivemind/poc/data/judging-v13-paid-gate-2026-11-22/answers.jsonl:68) · [Source units](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/calc_check.py:45) · [Per-unit calculation](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/calc_check.py:665)\n\n## 2. What the refusals mean\n\n**A** and **R** refer to line numbers in the first-attempt and retry journals. I read the figures and their inputs against the passages in the actual request. “Exposed on replay” means an earlier refusal hid the check in the original run. The verdict in each row applies to that refusal. [First attempts](/Users/lchingen/hivemind/poc/data/judging-v13-paid-gate-2026-11-22/answers.jsonl) · [Retries](/Users/lchingen/hivemind/poc/data/judging-v13-paid-gate-2026-11-22/retries.jsonl) · [Requests as sent](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/paid-plan.json)\n\n| Reply | Figure and evidence | Rule and finding |\n|---|---|---|\n| **A2, joint** | Q3 guidance **$108B, range $105.84–110.16B**. `e2652` says “$108.0 billion, plus or minus 2%.” Both the midpoint and endpoints are correct. | **(b) Unstated format.** C7 says “either a value or a complete range.” The schema accepts all three numbers together and gives no instruction to split the midpoint and range. [C7](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/calc_check.py:319) |\n| **A2, joint** | Q4 estimate **$112.3B**, from a reconstructed $68.1B base and `e5162`’s 65% growth. `bridge` explains that conversion in a sentence. | **(b) Unstated format.** C7 says the sentence “is not defined.” The schema calls `bridge` “an estimate stating the conversion” and never says to put the ID of a separate estimate there. [Sent schema](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/paid-plan.json:237) · [C7](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/calc_check.py:310) |\n| **A2, joint** | Outcome **“$398.1 billion”** corresponds to the reply’s own annual figure. Its quarterly inputs are $81.62B, $96.2B, $108B and $112.3B, based on `e111`, `e2649`, `e2652` and the Q4 estimate above. | **(b) Unstated format, exposed on replay.** C7 says the outcome “is not a figure.” The schema gives `outcome` as a nullable string with no description. [Sent schema](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/paid-plan.json:360) · [C7](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/calc_check.py:488) |\n| **A6, separate** | The reference reads **“dc_fy27_reference: Morningstar estimates $361 billion”**. The named source figure exists and `e2295` states $361B for FY2027 Data Center revenue. | **(b) Unstated format, masked in the original.** C5 would say “the reference names no figure” because the lookup uses the entire string. The schema describes the reference as “an external figure” without telling the writer to return only its ID. [Sent schema](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/paid-plan.json:380) · [C5](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/calc_check.py:779) |\n| **A6, separate** | The **$113.6B** Q3 estimate uses the outside forecast in `e5056` and the $108B guidance in `e2652`. It puts `e2652` in both `inputs` and `adjusts.figure`. | **(b) Unstated format.** C7 reports twice that `e2652` “is not defined.” It is defined as evidence. The schema fails to distinguish a source passage ID from a figure ID in those fields. [C7](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/calc_check.py:310) |\n| **A12, separate** | Q4 residual **$125.2B** equals $411B − $81.6B − $96.2B − $108B, from `e4097`, `e238`, `e2497` and `e2499`. The model used `difference` with four inputs and signs. | **(b) Unstated operation rules.** C7 says “difference takes 2 operands, not 4” and limits `signs` to “a sum or roll_forward.” The schema lists the operation names without their operand or sign rules. This verdict covers the arithmetic representation. Treating the full-year consensus residual as a forecast is a separate judgement. [C7](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/calc_check.py:327) |\n| **A44, equity singleton** | **`25 USD billions`**, cited to `e2620`, which reports $25B in commitments as of July 26. | **(b) Unstated unit spelling.** C1 says the value “does not equal ‘$25 billion’ as component value.” It compares the unit string to `USD bn`. The amount agrees and `unit` was a free string. [C1](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/calc_check.py:85) |\n| **A2, joint** | **65% FY2027 Q4 growth**. The reply copied “65% growth in Q4” directly from `e5162`. | **(b) Unstated span boundary, exposed on replay.** C1 says the phrase “is not a complete numeric expression” because it extracts `65%` alone. With the passage ID and `%` set, changing only the expression to `65%` cleared C1. The request did not explain where wording around a number must end. [C1](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/calc_check.py:78) |\n| **A24, Vera CPU singleton** | **$42B**, with a **$40–50B** forecast range. Its input was the threshold of more than $40B, calculated from the $20B base and “more than double” in `e3660` and `e4856`. | **(b) Unstated format.** C7 says “either a value or a complete range.” Reporting a central estimate alongside a range is reasonable under the schema as sent. Whether $42B is a supported forecast still needs a reader. [C7](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/calc_check.py:319) |\n| **A2, joint** | First-half Data Center revenue **$164.25B**, from Q1 $75.25B (`e109`) plus Q2 $89B (`e2650`). | **(c) Check too narrow, exposed on replay.** C8 requires “one quantity over disjoint periods forming FY2027 first half.” The periods do that. `_quarters` recognizes `H1` and cannot read `first half`. [Period parser](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/calc_check.py:285) · [C8](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/calc_check.py:411) |\n| **A4, separate** | FY2027 Q4 **$112.2B** from $68B FY2026 Q4 actual (`e2452`) × 1.65, using the stated 65% year-over-year forecast (`e5162`). | **(c) Check too narrow, exposed on replay.** C8 reports “no bridge naming those operands.” It gives `apply_growth` an exception tied to a declared `same_base` family relation. The source already states this particular year-over-year link. Carrying a Q3 sequential rate into Q4 would be a different case and would still need an assumption. [C8](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/calc_check.py:434) |\n| **A8, joint** | Data Center reference proxy **$380.175B**, from $411B FY2027 company consensus (`e4097`) × the reported 92.5% Q2 mix (`e3216`). | **(c) Wrong arithmetic check, exposed on replay.** C2 says `product` “gives 38017.50.” It multiplies by 92.5 as a plain number, while `share` divides by 100. The arithmetic is correct. Applying a Q2 mix to a full-year reference remains an assumption. [Arithmetic](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/calc_check.py:125) · [C2](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/calc_check.py:371) |\n| **R12, separate** | **`> $300B`** for Data Center revenue. `e2115` says “well over $300 billion.” The reply kept both the words and the lower bound. | **(c) Check too narrow.** C1 says the quoted phrase “is not a complete numeric expression.” Its parser finds `over $300 billion` by starting one word later. It penalizes the reply for preserving the full qualifier. [Parser](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/calc_check.py:12) · [C1](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/calc_check.py:78) |\n| **R66, separate** | Annual Data Center calculation **$375.788B**, from the first six months’ $164B (`e5360`) plus $99.9B and $111.888B for Q3 and Q4. The later quarters use the guidance and mix in `e2715`, `e3453` and `e4190`. | **(c) Check too narrow.** C8 requires “disjoint periods forming FY2027.” On the stored reply, changing only `FY2027 first six months` to `FY2027 H1` removed exactly this refusal. The calculation’s other refusals remained. [C8](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/calc_check.py:411) |\n| **R44, equity singleton** | **$46.5B** = $25B + $18B + $3.5B. The reply puts a sentence about MediaTek’s overlap in `disputed`. `e2620` gives the July balance. `e2889` says $18B is on top of **$47.9B already held**, which does not establish that it is on top of the **$25B already committed**. | **(b) Unstated format for the recorded refusal.** C8 says “overlap_unknown must name a disputed operand.” The schema does not say to provide that operand’s ID. **(a) Separate judgement gap.** Changing the prose to the MediaTek figure ID would leave the addition of $25B and $18B resting on an undeclared assumption. [C8](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/calc_check.py:418) |\n| **R60, separate** | The **15%** Q4 growth estimate rests on the **$124.2B** company and **$114.885B** Data Center forecasts, both computed using that same 15%. `e3222` supports reacceleration qualitatively and gives no rate. | **(a) Model error.** C7 says “the figure graph has a cycle.” The forecast figures cannot serve as independent support for the rate that produces them. Renaming fields leaves the circular reasoning intact. [C7](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/calc_check.py:341) |\n| **R22, hyperscaler singleton** | **$1.05 trillion** in rung 3, based on a judgemental discount to the $1.3T projection and the $1.08T consensus (`e4756`, `e1926`). | **(c) Wrong unit comparison, exposed on replay.** After resolving the outcome link and setting aside the prose bridge on a copy, C6 says the $900–1,100B band “contains no part” of `1.05`. Converting the dollar figures to billions cleared the remaining checks. The reply itself says neither scope adjustment was quantified. A code pass still leaves the reader to decide whether the adjustment is supported. [C6](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/calc_check.py:495) |\n\nOne more source boundary matters for the proposed fix. R44’s **US$3.5B** appears in the evidence summary for `e3558`, but the attached quote only describes the convertible bonds. `e3474`, also shown, has the amount in its quote. The model sees both summaries and quotes. C1 checks only the quote attached to the selected ID. The request needs to say which text can support a source figure. A match on the amount alone cannot settle that. [Request evidence and quote handling](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/paid_gate.py:55) · [C1](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/calc_check.py:78)\n\nI reproduced Claude’s diagnostic **0 publishes** and **9 replies with no C7** on the first attempts. The retries give the same counts. The phrase “past the structural layer” needs a correction. **25 of 36** in each journal passed the *early* structural check after the script’s edits. Later outcome-link failures reduced that to nine without any C7. The script also guesses links from matching amounts, deletes prose bridges and drops valid range endpoints when a midpoint is present. Its default options omit the `prose` pass used to reproduce these counts. These are useful probes for finding hidden checks. They do not establish how many replies a repaired request would get right, or that most of the 72 replies had sound forecasts. [Diagnostic script](/private/tmp/claude-501/-Users-lchingen-hivemind/f1ea972d-85a1-4f27-8010-cf0b60054109/scratchpad/normalise_diag.py:12)\n\n## 3. Why the zero-cost gate missed it\n\n**The author of the passing answer already knew the checker’s rules.** The fixtures hand in the expected IDs, units and period spellings. The paid rehearsal’s clean answer goes further and uses an estimate inside a preselected rung, with no source calculation and an unavailable reference. That proves the harness can carry a conforming answer and that planted defects can trigger checks. It leaves unanswered whether someone reading the exact request could write a conforming answer without that inside knowledge. [Registered controls](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/DESIGN.md:152) · [Clean rehearsal fixture](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/paid_rehearsal.py:42)\n\nThe missed step was a **blind write-and-check using the exact outgoing request**. Give an independent writer only the system text, user text and schema. Have them encode real forecasts and then run their first outputs through the actual harness. For each refusal, ask the writer to point to where the request stated the rule. Read the check back in the other direction for correct answers it cannot represent. An evidence ID enum would have prevented the most common source mistake. The request already uses one for citations. [AGENTS §6](/Users/lchingen/hivemind/AGENTS.md:231) · [AGENTS §7.3](/Users/lchingen/hivemind/AGENTS.md:370) · [Sent schema](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/paid-plan.json:120)\n\n## 4. One recommendation and one test\n\n**Recommendation.** Keep the STOP and ask Alex to open one bounded repair of the judging-v13 request and checker. Put each field’s rule next to the field. Use enums for known IDs, units and choices where the schema can enforce them. Fix the demonstrated arithmetic, period and source-boundary failures while preserving checks for genuine scope changes, unsupported assumptions and circular calculations. Code already extracts numeric expressions for verification. Sending a complete catalog of those expressions to the model could remove some copying, but would also make today’s parser omissions into missing evidence. It would leave the universal outcome-link failure untouched. Closing v13 now would save further work, but the result has not answered D725’s question about shared calculations. One bounded test can determine whether there is a workable way to express those calculations at all. [D725](/Users/lchingen/hivemind/docs/DECISIONS-log.md:10957) · [D690](/Users/lchingen/hivemind/docs/DECISIONS-log.md:10360)\n\n**Test.** Run one blind conformance test at $0 on fresh examples covering a joint pair, its two separate replies, and all three singleton calculation shapes. Before the test, register correct examples and deliberately broken counterparts, including a wrong number, a wrong period or scope, an unresolved overlap and a circular calculation. Run the independent writer’s first replies through the real harness without hand edits. **Stop if any correct form is refused, any planted defect gets through its intended check, or the reader still needs an unwritten rule to encode a correct answer.** Use the 72 stored replies to check individual fixes where the intended figure and source are identifiable. A guessed link or rewritten answer earns no credit. A clean result earns a request to rerun the same 36-call comparison under a fresh decision, with the original pass lines. The current gate’s STOP stands. [Registered reading and stop rules](/Users/lchingen/hivemind/docs/research/2026-11-22-number-answers/PAID-GATE.md:250)"}}
