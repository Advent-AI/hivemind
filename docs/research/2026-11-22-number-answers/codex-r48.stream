ridge'\\\\''\n  if '\\\\''states no relation'\\\\'' in s:return c+'\\\\'': relation'\\\\''\n  if '\\\\''share needs'\\\\'' in s:return c+'\\\\'': share'\\\\''\n  return c+'\\\\'': '\\\\''+s\n return c\ndef fields(d):\n for f in d['\\\\''figures'\\\\'']:\n  for k in ('\\\\''evidence'\\\\'','\\\\''bridge'\\\\'','\\\\''disputed'\\\\''):\n   yield k,f.get(k),f\n  for k in ('\\\\''inputs'\\\\'','\\\\''rests_on'\\\\'','\\\\''converts'\\\\''):\n   for v in f.get(k) or []:yield k,v,f\n  yield '\\\\''adjusts.figure'\\\\'',(f.get('\\\\''adjusts'\\\\'') or {}).get('\\\\''figure'\\\\''),f\n for a in d['\\\\''answers'\\\\'']:\n  yield '\\\\''answers[].outcome'\\\\'',a.get('\\\\''outcome'\\\\''),a\n  yield '\\\\''answers[].reference.figure'\\\\'',(a.get('\\\\''reference'\\\\'') or {}).get('\\\\''figure'\\\\''),a\ndef allowed(k,f,p):\n if k=='\\\\''evidence'\\\\'':return p['\\\\''passages'\\\\'']\n if k=='\\\\''rests_on'\\\\'':return set(f)|set(p['\\\\''passages'\\\\''])\n return f\nsys.path.insert(0,str(D))\nimport calc_check as cc\ndef passage(q,k):\n if k in q['\\\\''passages'\\\\'']:\n  print(k,'\\\\''QUOTE'\\\\'',q['\\\\''passages'\\\\''][k]['\\\\''text'\\\\''][:460])\n  lead=next((l for l in q['\\\\''user'\\\\''].splitlines() if l.startswith('\\\\''- '\\\\''+k+'\\\\'' ['\\\\'')),None)\n  if lead: print('\\\\''  HEADER'\\\\'',lead)\ndef show(n,l,ids=(),ps=(),fields_only=False):\n r=dict(J[n])[l]; q=P[r['\\\\''unit'\\\\''],r['\\\\''arm'\\\\'']]; d=r['\\\\''data'\\\\'']\n print('\\\\''\\\\n'\\\\'',n,l,r['\\\\''unit'\\\\''],r['\\\\''arm'\\\\''],r['\\\\''draw'\\\\''],'\\\\''ERRORS'\\\\'',r['\\\\''errors'\\\\''])\n for f in d['\\\\''figures'\\\\'']:\n  if ids and f['\\\\''id'\\\\''] not in ids: continue\n  print({k:v for k,v in f.items() if v is not None})\n for a in d['\\\\''answers'\\\\'']:\n  print('\\\\''ANS'\\\\'',{k:a[k] for k in ('\\\\''view_id'\\\\'','\\\\''outcome'\\\\'','\\\\''reference'\\\\'','\\\\''cites'\\\\'','\\\\''rung'\\\\'')})\n for k in ps:passage(q,k)\n if fields_only:\n  f={f['\\\\''id'\\\\''] for f in d['\\\\''figures'\\\\'']}\n  for k,v,obj in fields(d):\n   if v is not None and v not in allowed(k,f,q): print('\\\\''BAD FIELD'\\\\'',k,repr(v),obj.get('\\\\''id'\\\\'',obj.get('\\\\''view_id'\\\\'')))\nfor n,l in [('\\\\''answers'\\\\'',2),('\\\\''answers'\\\\'',12),('\\\\''answers'\\\\'',44),('\\\\''answers'\\\\'',22),('\\\\''answers'\\\\'',24),('\\\\''retries'\\\\'',12),('\\\\''retries'\\\\'',20),('\\\\''retries'\\\\'',44),('\\\\''retries'\\\\'',60),('\\\\''retries'\\\\'',66),('\\\\''retries'\\\\'',72)]:\n r=dict(J[n])[l]\n print(n,l,r['\\\\''unit'\\\\''],r['\\\\''arm'\\\\''],r['\\\\''draw'\\\\''],r['\\\\''errors'\\\\''])\n print([f['\\\\''id'\\\\''] for f in r['\\\\''data'\\\\'']['\\\\''figures'\\\\'']])\nprint('\\\\''user endings'\\\\'')\nfor key in [('\\\\''pair-old-1'\\\\'','\\\\''joint'\\\\''),('\\\\''single-S'\\\\'','\\\\''single'\\\\'')]: print(P[key]['\\\\''user'\\\\''][-2300:])'\"","aggregated_output":"answers 2 pair-old-1 joint 1 [['C7', 'f_fy27_q3_guide: a figure needs either a value or a complete range with low at most high'], ['C7', 'f_fy26_q1_est refers to Estimate the prior-year quarter by dividing reported FY2027 Q1 revenue by 1 plus its reported year-over-year growth., which is not defined'], ['C7', 'f_fy26_q2_est refers to Estimate the prior-year quarter by dividing reported FY2027 Q2 revenue by 1 plus its reported year-over-year growth., which is not defined'], ['C7', 'f_fy26_q4_est refers to Estimate FY2026 Q4 as FY2026 full-year revenue less the three reconstructed or reported FY2026 Q1–Q3 amounts., which is not defined'], ['C7', 'f_fy27_q4_est refers to Apply the analyst-stated 65% year-over-year Q4 growth expectation to the estimated FY2026 Q4 base., which is not defined'], ['C7', 'f_fy27_total_est refers to Sum reported FY2027 Q1 and Q2, the Q3 guidance midpoint, and the estimated FY2027 Q4 amount., which is not defined'], ['C7', 'f_fy27_dc_q3_est refers to Multiply the Q3 total-revenue guidance midpoint by the latest reported Data Center share of total revenue., which is not defined'], ['C7', \"f_dc_q4_mix_est refers to Estimate a modest 0.5 percentage-point increase from the latest 92.5% Data Center mix, reflecting its recent upward trend and management's expectation of stronger hyperscale growth in Q4., which is not defined\"], ['C7', 'f_fy27_dc_q4_est refers to Multiply estimated FY2027 Q4 company revenue by the estimated 93% Data Center share., which is not defined']]\n['f_fy26_total', 'f_fy27_q1', 'f_fy27_q1_yoy', 'f_fy27_q2', 'f_fy27_q2_yoy', 'f_fy27_q3_guide', 'f_fy26_q3', 'f_fy26_q1_est', 'f_fy26_q2_est', 'f_fy26_q4_est', 'f_fy27_q4_growth', 'f_fy27_q4_est', 'f_fy27_total_est', 'f_fy27_dc_h1', 'f_fy27_dc_q1', 'f_fy27_dc_q2', 'f_dc_q3_mix', 'f_fy27_dc_q3_est', 'f_dc_q4_mix_est', 'f_fy27_dc_q4_est', 'f_fy27_dc_total_est']\nanswers 12 pair-old-2 separate-v9 1 [['C7', 'total_fy27_q3_guidance: a figure needs either a value or a complete range with low at most high'], ['C7', 'total_fy27_q4_implied: difference takes 2 operands, not 4'], ['C7', 'total_fy27_q4_implied: signs must give one +1 or -1 per operand of a sum or roll_forward'], ['C7', 'dc_fy27_q3_forecast refers to Estimate Q3 Data Center revenue by applying the latest reported 92.5% Data Center share to the $108 billion Q3 total-revenue guidance., which is not defined'], ['C7', 'dc_fy27_q4_forecast refers to Estimate Q4 Data Center revenue by applying the latest reported 92.5% Data Center share to the $125.2 billion Q4 company-revenue residual., which is not defined']]\n['dc_fy27_h1_reported', 'total_fy27_q1_reported', 'total_fy27_q2_reported', 'total_fy27_q3_guidance', 'total_fy27_consensus', 'total_fy27_q4_implied', 'dc_mix_latest', 'dc_fy27_q3_forecast', 'dc_fy27_q4_forecast', 'dc_fy27_forecast']\nanswers 44 single-O single 2 [['C1', 'f1: value 25 USD billions bound None does not equal \"$25 billion\" as component value'], ['C1', 'f2: \"$18 billion committed to equity investments for the rest of its fiscal year\" is not a complete numeric expression of e2889'], ['C1', 'f4: \"$30 billion each from Nvidia and SoftBank\" is not a complete numeric expression of e4486'], ['C7', 'v29: outcome Approximately $30 billion in equity investment commitments at the end of FY2027 (my estimate). is not a figure']]\n['f1', 'f2', 'f3', 'f4']\nanswers 22 single-S single 1 [['C7', 'fig_v6_forecast refers to My estimate translates the top-five all-capex estimate to the four-largest-hyperscaler data-center-capex question. It allows for the fifth company and for the difference between total capital expenditures and data-center capital expenditures; the evidence does not quantify either adjustment precisely., which is not defined']]\n['fig_consensus_2027', 'fig_nvidia_top_five_2027', 'fig_v6_forecast']\nanswers 24 single-E single 1 [['C7', 'f4: a figure needs either a value or a complete range with low at most high']]\n['f1', 'f2', 'f3', 'f4']\nretries 12 pair-old-2 separate-v9 1 [['C1', 'dc_h1_reported: value 164 USD billions bound None does not equal \"$164 billion\" as component value'], ['C1', 'dc_share_q2: value 92.5 percent bound None does not equal \"92.5%\" as component value'], ['C1', 'total_q3_guidance: value 108 USD billions bound None does not equal \"$108.0 billion, plus or minus 2%\" as component midpoint'], ['C1', 'q3_sequential_growth: \"12% sequential growth at the midpoint\" is not a complete numeric expression of e3943'], ['C1', 'morningstar_dc_reference: \"well over $300 billion\" is not a complete numeric expression of e2115'], ['C2', \"dc_q3_forecast: declared 99.9–99.9 but product of ['total_q3_guidance', 'dc_share_q2'] gives 9990.00–9990.00\"], ['C2', \"dc_q4_forecast: declared 111.888–111.888 but product of ['total_q4_forecast', 'dc_share_q2'] gives 11188.80–11188.80\"], ['C8', 'total_q4_forecast: converts total_q3_guidance, q3_sequential_growth to NVIDIA company FY2027 Q4 revenue with no bridge naming those operands'], ['C8', 'dc_q3_forecast: converts total_q3_guidance, dc_share_q2 to NVIDIA Data Center FY2027 Q3 revenue with no bridge naming those operands'], ['C8', 'dc_q4_forecast: converts total_q4_forecast, dc_share_q2 to NVIDIA Data Center FY2027 Q4 revenue with no bridge naming those operands'], ['C8', 'dc_fy27_forecast: time aggregation needs one quantity over disjoint periods forming FY2027'], ['C7', 'v9: outcome About $376 billion of FY2027 Data Center revenue. is not a figure']]\n['dc_h1_reported', 'dc_share_q2', 'total_q3_guidance', 'q3_sequential_growth', 'total_q4_forecast', 'dc_q3_forecast', 'dc_q4_forecast', 'dc_fy27_forecast', 'morningstar_dc_reference']\nretries 20 single-O single 1 [['C1', 'f1: value 25 USD billions bound None does not equal \"$25 billion\" as component value'], ['C1', 'f2: value 18 USD billions bound None does not equal \"$18 billion\" as component value'], ['C7', 'v29: outcome About $38 billion of equity investment commitments at the end of FY2027 is not a figure']]\n['f1', 'f2', 'f3']\nretries 44 single-O single 2 [['C1', 'f1: evidence NVIDIA reported $25 billion of equity investment commitments as of 2026-07-26. was not shown'], ['C1', 'f2: evidence NVIDIA said it has $18 billion committed to equity investments for the rest of its fiscal year. was not shown'], ['C1', 'f3: evidence NVIDIA announced it would buy US$3.5 billion of MediaTek bonds convertible into shares. was not shown'], ['C2', 'f4: its inputs are points, but it is declared a bound (approx)'], ['C8', 'f4: overlap_unknown must name a disputed operand among its inputs'], ['C7', 'v29: outcome $46.5 billion is not a figure']]\n['f1', 'f2', 'f3', 'f4']\nretries 60 pair-old-2 separate-v9 3 [['C7', 'f_q3_total: a figure needs either a value or a complete range with low at most high'], ['C7', 'f_q3_dc refers to Estimate assumes the FY2027 Q2 Data Center share carries into Q3; multiply the Q3 total-revenue guidance midpoint by that share., which is not defined'], ['C7', 'the figure graph has a cycle']]\n['f_h1_dc', 'f_q3_total', 'f_q2_dc_share', 'f_q3_dc', 'f_q4_growth', 'e_q4_total', 'e_q4_dc', 'f_fy27_dc', 'f_morningstar_reference']\nretries 66 pair-old-3 separate-v35 3 [['C1', 'f1: value 164 USD billions bound None does not equal \"$164 billion\" as component value'], ['C1', 'f2: value 108 USD billions bound None does not equal \"$108.0 billion, plus or minus 2%\" as component value'], ['C1', 'f3: value 0.925 fraction bound None does not equal \"92.5%\" as component value'], ['C1', 'f4: \"12% sequential growth\" is not a complete numeric expression of e4190'], ['C1', 'f9: value 361 USD billions bound None does not equal \"$361 billion\" as component value'], ['C2', \"f5: declared 99.9–99.9 but share of ['f2', 'f3'] gives 1.00–1.00\"], ['C2', \"f6: declared 120.96–120.96 but apply_growth of ['f2', 'f4'] gives 108.13–108.13\"], ['C2', \"f7: declared 111.888–111.888 but share of ['f6', 'f3'] gives 1.12–1.12\"], ['C8', 'f5: a share needs one share figure and one whole'], ['C8', 'f6: converts f2, f4 to NVIDIA company FY2027 Q4 revenue with no bridge naming those operands'], ['C8', 'f7: a share needs one share figure and one whole'], ['C8', 'f8: time aggregation needs one quantity over disjoint periods forming FY2027'], ['C7', 'v35: outcome Approximately $376 billion of NVIDIA Data Center revenue in FY2027 is not a figure']]\n['f1', 'f2', 'f3', 'f4', 'f5', 'f6', 'f7', 'f8', 'f9']\nretries 72 single-E single 3 [['C1', 'f_fy27_cpu_revenue: value 20 USD billions bound None does not equal \"$20 billion\" as component value'], ['C1', 'f_fy28_cpu_multiplier: \"more than double that number in fiscal year 2028\" is not a complete numeric expression of e4856'], ['C8', 'f_fy28_guidance_threshold: converts f_fy27_cpu_revenue to NVIDIA Vera CPU FY2028 revenue with no bridge naming those operands'], ['C7', 'v41: outcome Approximately $45 billion of NVIDIA Vera CPU revenue in FY2028 is not a figure']]\n['f_fy27_cpu_revenue', 'f_fy28_cpu_multiplier', 'f_fy28_guidance_threshold', 'f_fy28_vera_cpu_forecast']\nuser endings\n suspected smuggling, raises the prospect of action, but the evidence gives no adopted measure, legislative stage, or timetable. Th\n- v27 (chip-export-controls, due 2026-12-31) Will the U.S. Department of Commerce conclude its investigation into Chinese firms’ access to advanced U.S. chips by December 31, 2026?: now rung 2 No; judged 2026-08-07; reasons: The reference is rung 2 (No): no market consensus or Commerce completion deadline is supplied, and the stated status is a formal investigation, not a scheduled conclusion. The evidence makes non-conclusion by December 31, 2026 more likely: Commerce is still examining access through computing capacit\n- v6 (ai-capex, due 2027-02-28) How much will the four largest AI hyperscalers spend on data center capital expenditures in calendar 2026?: now rung 4 $700 billion to below $800 billion; judged 2026-09-19; reasons: The market reference for the four companies is roughly $720–745 billion, which sits in rung 4. The evidence implies about $760 billion for the four: the direct four-company estimate is $760 billion, and the later Amazon and Alphabet figures are consistent with company spending plans already reflecte\n- v7 (ai-capex, due 2028-02-29) How much will the four largest AI hyperscalers spend on data center capital expenditures in calendar 2027?: now rung 4 $1.1 trillion to below $1.2 trillion; judged 2026-09-19; reasons: The market reference is BofA's $1.08 trillion 2027 estimate for five companies; using the carried Oracle adjustment of roughly $100–$150 billion, the four-company reference is about $930–$980 billion, in rung 3. NVIDIA's $1.3 trillion forecast for the top five, adjusted by the same Oracle amount, im\n- v9 (chip-export-controls, due 2027-01-31) Will China authorize purchases of Nvidia H200 chips by AI companies by January 31, 2027?: now rung 2 Yes; judged 2026-09-20; updated since this thesis was last judged; reasons: The reference is rung 1: no Chinese authorization by the deadline. The evidence favors a narrow, selective authorization by January 31, 2027, rather than no authorization: reports name prospective buyers, and one item says limited H200 imports were recently allowed. This is not a forecast of broad a\n\nAnswer per the JSON schema: one calculation for the family and one answer per member.\nim, one more outlet.\n- e4857 [party_statement; fool.com; original source NVIDIA ; from gnews:4fbadb3b4cb5846297a34b0a 2026-09-16] NVIDIA estimates top-five hyperscaler capex could reach $1.3 trillion in calendar 2027, up from $800 billion in calendar 2026.\n    Quote: Nvidia, for instance, estimates that the capex of the top five hyperscalers could increase to $1.3 trillion in 2027, up from $800 billion this year.\n    Opinion, not verified: the matcher read this as the same claim as e4789; the argument counts one claim, one more outlet.\n- e4867 [party_statement; fool.com (analyst); original source NVIDIA ; from gnews:d5a540df626501269df8ff8c 2026-09-17] NVIDIA guided for a gross margin of 72% to 73% in FY2028.\n    Quote: The company also guided for gross margins of between 72% and 73% in its fiscal 2028.\n    Opinion, not verified: the matcher read this as the same claim as e3738; the argument counts one claim, one more outlet.\n- e4988 [third_party_view; benzinga.com; original source Brad Gerstner ; from gnews:4256ae7ea51b8cf4d4bb371b 2026-09-18] Brad Gerstner said annual AI-infrastructure capital spending could reach $1.5 trillion and would require customers to pay for the capacity.\n    Quote: \"If you're going to build a trillion and a half dollars a year in capex, somebody has to pay for it,\" he said.\n- e4990 [party_statement; fool.com (analyst); original source NVIDIA ; from gnews:ad94c78d09fe41fc3f29bbca 2026-09-18] NVIDIA projects the top five U.S. hyperscalers’ capital expenditure will reach $1.3 trillion in 2027.\n    Quote: Nvidia projects that this figure will jump to $1.3 trillion in 2027.\n    Opinion, not verified: the matcher read this as the same claim as e4756; the argument counts one claim, one more outlet.\n- e5026 [third_party_view; fool.com (analyst); original source fool.com (analyst) 2026-09-19; from gnews:4ee5d8f73b7bcfc2f2111ad1 2026-09-19] The article projects the five largest AI hyperscalers’ data-center capital expenditures at $1.3 trillion in calendar 2027.\n    Quote: Next year, that figure is projected to rise to $1.3 trillion.\n    Opinion, not verified: the matcher read this as the same claim as e4458; the argument counts one claim, one more outlet.\n\n\n\nAnswer per the JSON schema: one calculation for the family and one answer per member.\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_19","type":"agent_message","text":"All 72 replies were refused, and every reply put a written forecast where the checker expected a figure ID. I’m tracing the arithmetic and source refusals separately, because some would still matter after the format is fixed."}}
{"type":"item.started","item":{"id":"item_20","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"python3 -B -c 'import json,pathlib,collections,re,sys,importlib.util\nD=pathlib.Path('\\\\''docs/research/2026-11-22-number-answers'\\\\'')\nR=pathlib.Path('\\\\''poc/data/judging-v13-paid-gate-2026-11-22'\\\\'')\nP={(q['\\\\''unit'\\\\''],q['\\\\''arm'\\\\'']):q for q in json.loads((D/'\\\\''paid-plan.json'\\\\'').read_text())}\nJ={n:[(i,r) for i,l in enumerate((R/(n+'\\\\''.jsonl'\\\\'')).open(),1) if (r:=json.loads(l))['\\\\''status'\\\\'']\"'!='\"'\\\\''started'\\\\''] for n in ['\\\\''answers'\\\\'','\\\\''retries'\\\\'']}\ndef arm(r): return r['\\\\''arm'\\\\''] if r['\\\\''arm'\\\\''] in ('\\\\''joint'\\\\'','\\\\''single'\\\\'') else '\\\\''separate'\\\\''\ndef cat(e):\n c,s=e\n if c=='\\\\''C7'\\\\'':\n  if '\\\\''not defined'\\\\'' in s:return c+'\\\\'': dangling'\\\\''\n  if '\\\\''needs either a value'\\\\'' in s:return c+'\\\\'': point/range'\\\\''\n  if '\\\\''signs must'\\\\'' in s:return c+'\\\\'': signs'\\\\''\n  if '\\\\'' operands, not '\\\\'' in s:return c+'\\\\'': arity'\\\\''\n  if '\\\\''is not a figure'\\\\'' in s:return c+'\\\\'': outcome missing'\\\\''\n  if '\\\\'': outcome '\\\\'' in s and '\\\\'' measures '\\\\'' in s:return c+'\\\\'': outcome key'\\\\''\n  return c+'\\\\'': '\\\\''+s\n if c=='\\\\''C1'\\\\'':\n  if '\\\\''was not shown'\\\\'' in s:return c+'\\\\'': evidence'\\\\''\n  if '\\\\''not a complete'\\\\'' in s:return c+'\\\\'': expression'\\\\''\n  return c+'\\\\'': value/unit/etc'\\\\''\n if c=='\\\\''C2'\\\\'':\n  if '\\\\''cannot be evaluated'\\\\'' in s:return c+'\\\\'': eval'\\\\''\n  if '\\\\''gives'\\\\'' in s:return c+'\\\\'': arithmetic'\\\\''\n  return c+'\\\\'': bound'\\\\''\n if c=='\\\\''C8'\\\\'':\n  if '\\\\''time aggregation'\\\\'' in s:return c+'\\\\'': time'\\\\''\n  if '\\\\''roll_forward'\\\\'' in s:return c+'\\\\'': roll_forward'\\\\''\n  if '\\\\''with no bridge'\\\\'' in s:return c+'\\\\'': bridge'\\\\''\n  if '\\\\''states no relation'\\\\'' in s:return c+'\\\\'': relation'\\\\''\n  if '\\\\''share needs'\\\\'' in s:return c+'\\\\'': share'\\\\''\n  return c+'\\\\'': '\\\\''+s\n return c\ndef fields(d):\n for f in d['\\\\''figures'\\\\'']:\n  for k in ('\\\\''evidence'\\\\'','\\\\''bridge'\\\\'','\\\\''disputed'\\\\''):\n   yield k,f.get(k),f\n  for k in ('\\\\''inputs'\\\\'','\\\\''rests_on'\\\\'','\\\\''converts'\\\\''):\n   for v in f.get(k) or []:yield k,v,f\n  yield '\\\\''adjusts.figure'\\\\'',(f.get('\\\\''adjusts'\\\\'') or {}).get('\\\\''figure'\\\\''),f\n for a in d['\\\\''answers'\\\\'']:\n  yield '\\\\''answers[].outcome'\\\\'',a.get('\\\\''outcome'\\\\''),a\n  yield '\\\\''answers[].reference.figure'\\\\'',(a.get('\\\\''reference'\\\\'') or {}).get('\\\\''figure'\\\\''),a\ndef allowed(k,f,p):\n if k=='\\\\''evidence'\\\\'':return p['\\\\''passages'\\\\'']\n if k=='\\\\''rests_on'\\\\'':return set(f)|set(p['\\\\''passages'\\\\''])\n return f\nsys.path.insert(0,str(D))\nimport calc_check as cc\ndef passage(q,k):\n if k in q['\\\\''passages'\\\\'']:\n  print(k,'\\\\''QUOTE'\\\\'',q['\\\\''passages'\\\\''][k]['\\\\''text'\\\\''][:460])\n  lead=next((l for l in q['\\\\''user'\\\\''].splitlines() if l.startswith('\\\\''- '\\\\''+k+'\\\\'' ['\\\\'')),None)\n  if lead: print('\\\\''  HEADER'\\\\'',lead)\ndef show(n,l,ids=(),ps=(),fields_only=False):\n r=dict(J[n])[l]; q=P[r['\\\\''unit'\\\\''],r['\\\\''arm'\\\\'']]; d=r['\\\\''data'\\\\'']\n print('\\\\''\\\\n'\\\\'',n,l,r['\\\\''unit'\\\\''],r['\\\\''arm'\\\\''],r['\\\\''draw'\\\\''],'\\\\''ERRORS'\\\\'',r['\\\\''errors'\\\\''])\n for f in d['\\\\''figures'\\\\'']:\n  if ids and f['\\\\''id'\\\\''] not in ids: continue\n  print({k:v for k,v in f.items() if v is not None})\n for a in d['\\\\''answers'\\\\'']:\n  print('\\\\''ANS'\\\\'',{k:a[k] for k in ('\\\\''view_id'\\\\'','\\\\''outcome'\\\\'','\\\\''reference'\\\\'','\\\\''cites'\\\\'','\\\\''rung'\\\\'')})\n for k in ps:passage(q,k)\n if fields_only:\n  f={f['\\\\''id'\\\\''] for f in d['\\\\''figures'\\\\'']}\n  for k,v,obj in fields(d):\n   if v is not None and v not in allowed(k,f,q): print('\\\\''BAD FIELD'\\\\'',k,repr(v),obj.get('\\\\''id'\\\\'',obj.get('\\\\''view_id'\\\\'')))\nshow('\\\\''retries'\\\\'',12,(),('\\\\''e3943'\\\\'','\\\\''e2115'\\\\'','\\\\''e2499'\\\\'','\\\\''e2468'\\\\'','\\\\''e2116'\\\\''))\nshow('\\\\''retries'\\\\'',44,(),('\\\\''e2620'\\\\'','\\\\''e2889'\\\\'','\\\\''e3970'\\\\'','\\\\''e4486'\\\\''))\nshow('\\\\''retries'\\\\'',72,(),('\\\\''e4856'\\\\'',))\nshow('\\\\''retries'\\\\'',60,('\\\\''f_q3_total'\\\\'','\\\\''f_q3_dc'\\\\'','\\\\''e_q4_total'\\\\'','\\\\''e_q4_dc'\\\\'','\\\\''f_fy27_dc'\\\\''),())\nshow('\\\\''answers'\\\\'',44,(),('\\\\''e2620'\\\\'','\\\\''e2889'\\\\'','\\\\''e4486'\\\\''))'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
