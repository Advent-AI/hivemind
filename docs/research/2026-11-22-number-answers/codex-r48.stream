e(out, items, ledger_state):\ndocs/research/2026-11-22-number-answers/paid_gate.py:287:def _same_value(a, b):\ndocs/research/2026-11-22-number-answers/paid_gate.py:294:def merge(parts, shared_keys):\ndocs/research/2026-11-22-number-answers/paid_gate.py:365:def recover(out):\ndocs/research/2026-11-22-number-answers/paid_gate.py:374:def budget_module():\ndocs/research/2026-11-22-number-answers/paid_gate.py:376:    spec = importlib.util.spec_from_file_location('budget_replay_v13', REPO / 'clean-arch/e2e-comparison-2026-11-13/budget_replay.py')\ndocs/research/2026-11-22-number-answers/paid_gate.py:382:def send(out, approved, plan_path):\ndocs/research/2026-11-22-number-answers/paid_gate.py:423:def normalise(calc, prefix=''):\ndocs/research/2026-11-22-number-answers/paid_gate.py:449:def run_digest(out):\ndocs/research/2026-11-22-number-answers/paid_gate.py:457:def card_view(calc, view_id, recorded, prefix=''):\ndocs/research/2026-11-22-number-answers/paid_gate.py:484:def packet_units(results, items):\ndocs/research/2026-11-22-number-answers/paid_gate.py:485:    \"\"\"Every packet the run gives, as (unit, arm, draw) -> (decision, per-card source): the joint and singleton answers from the finals,\ndocs/research/2026-11-22-number-answers/paid_gate.py:501:def card_lines(base, fam, v, token, data, final_label, prefix=''):\ndocs/research/2026-11-22-number-answers/paid_gate.py:523:def packet_body(items, unit, arm, decision, per_card):\ndocs/research/2026-11-22-number-answers/paid_gate.py:533:        source = per_card.get(v, {})                         # the scored (first) attempt of this card\ndocs/research/2026-11-22-number-answers/paid_gate.py:534:        label = NO_ANSWER.get(source.get('decision'), FORMAT_INVALID if source.get('status') == 'format invalid' else NO_ANSWER['not sent'])\ndocs/research/2026-11-22-number-answers/paid_gate.py:536:        body, named = card_lines(base, fam, v, token, source.get('data'), label)\ndocs/research/2026-11-22-number-answers/paid_gate.py: