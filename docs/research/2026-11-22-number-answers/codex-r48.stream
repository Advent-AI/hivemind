{"type":"item.started","item":{"id":"item_29","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"python3 -B -c 'import json,pathlib,collections,re,sys,importlib.util\nD=pathlib.Path('\\\\''docs/research/2026-11-22-number-answers'\\\\'')\nR=pathlib.Path('\\\\''poc/data/judging-v13-paid-gate-2026-11-22'\\\\'')\nP={(q['\\\\''unit'\\\\''],q['\\\\''arm'\\\\'']):q for q in json.loads((D/'\\\\''paid-plan.json'\\\\'').read_text())}\nJ={n:[(i,r) for i,l in enumerate((R/(n+'\\\\''.jsonl'\\\\'')).open(),1) if (r:=json.loads(l))['\\\\''status'\\\\'']\"'!='\"'\\\\''started'\\\\''] for n in ['\\\\''answers'\\\\'','\\\\''retries'\\\\'']}\ndef arm(r): return r['\\\\''arm'\\\\''] if r['\\\\''arm'\\\\''] in ('\\\\''joint'\\\\'','\\\\''single'\\\\'') else '\\\\''separate'\\\\''\ndef cat(e):\n c,s=e\n if c=='\\\\''C7'\\\\'':\n  if '\\\\''not defined'\\\\'' in s:return c+'\\\\'': dangling'\\\\''\n  if '\\\\''needs either a value'\\\\'' in s:return c+'\\\\'': point/range'\\\\''\n  if '\\\\''signs must'\\\\'' in s:return c+'\\\\'': signs'\\\\''\n  if '\\\\'' operands, not '\\\\'' in s:return c+'\\\\'': arity'\\\\''\n  if '\\\\''is not a figure'\\\\'' in s:return c+'\\\\'': outcome missing'\\\\''\n  if '\\\\'': outcome '\\\\'' in s and '\\\\'' measures '\\\\'' in s:return c+'\\\\'': outcome key'\\\\''\n  return c+'\\\\'': '\\\\''+s\n if c=='\\\\''C1'\\\\'':\n  if '\\\\''was not shown'\\\\'' in s:return c+'\\\\'': evidence'\\\\''\n  if '\\\\''not a complete'\\\\'' in s:return c+'\\\\'': expression'\\\\''\n  return c+'\\\\'': value/unit/etc'\\\\''\n if c=='\\\\''C2'\\\\'':\n  if '\\\\''cannot be evaluated'\\\\'' in s:return c+'\\\\'': eval'\\\\''\n  if '\\\\''gives'\\\\'' in s:return c+'\\\\'': arithmetic'\\\\''\n  return c+'\\\\'': bound'\\\\''\n if c=='\\\\''C8'\\\\'':\n  if '\\\\''time aggregation'\\\\'' in s:return c+'\\\\'': time'\\\\''\n  if '\\\\''roll_forward'\\\\'' in s:return c+'\\\\'': roll_forward'\\\\''\n  if '\\\\''with no bridge'\\\\'' in s:return c+'\\\\'': bridge'\\\\''\n  if '\\\\''states no relation'\\\\'' in s:return c+'\\\\'': relation'\\\\''\n  if '\\\\''share needs'\\\\'' in s:return c+'\\\\'': share'\\\\''\n  return c+'\\\\'': '\\\\''+s\n return c\ndef fields(d):\n for f in d['\\\\''figures'\\\\'']:\n  for k in ('\\\\''evidence'\\\\'','\\\\''bridge'\\\\'','\\\\''disputed'\\\\''):\n   yield k,f.get(k),f\n  for k in ('\\\\''inputs'\\\\'','\\\\''rests_on'\\\\'','\\\\''converts'\\\\''):\n   for v in f.get(k) or []:yield k,v,f\n  yield '\\\\''adjusts.figure'\\\\'',(f.get('\\\\''adjusts'\\\\'') or {}).get('\\\\''figure'\\\\''),f\n for a in d['\\\\''answers'\\\\'']:\n  yield '\\\\''answers[].outcome'\\\\'',a.get('\\\\''outcome'\\\\''),a\n  yield '\\\\''answers[].reference.figure'\\\\'',(a.get('\\\\''reference'\\\\'') or {}).get('\\\\''figure'\\\\''),a\ndef allowed(k,f,p):\n if k=='\\\\''evidence'\\\\'':return p['\\\\''passages'\\\\'']\n if k=='\\\\''rests_on'\\\\'':return set(f)|set(p['\\\\''passages'\\\\''])\n return f\nsys.path.insert(0,str(D))\nimport calc_check as cc\ndef passage(q,k):\n if k in q['\\\\''passages'\\\\'']:\n  print(k,'\\\\''QUOTE'\\\\'',q['\\\\''passages'\\\\''][k]['\\\\''text'\\\\''][:460])\n  lead=next((l for l in q['\\\\''user'\\\\''].splitlines() if l.startswith('\\\\''- '\\\\''+k+'\\\\'' ['\\\\'')),None)\n  if lead: print('\\\\''  HEADER'\\\\'',lead)\ndef show(n,l,ids=(),ps=(),fields_only=False):\n r=dict(J[n])[l]; q=P[r['\\\\''unit'\\\\''],r['\\\\''arm'\\\\'']]; d=r['\\\\''data'\\\\'']\n print('\\\\''\\\\n'\\\\'',n,l,r['\\\\''unit'\\\\''],r['\\\\''arm'\\\\''],r['\\\\''draw'\\\\''],'\\\\''ERRORS'\\\\'',r['\\\\''errors'\\\\''])\n for f in d['\\\\''figures'\\\\'']:\n  if ids and f['\\\\''id'\\\\''] not in ids: continue\n  print({k:v for k,v in f.items() if v is not None})\n for a in d['\\\\''answers'\\\\'']:\n  print('\\\\''ANS'\\\\'',{k:a[k] for k in ('\\\\''view_id'\\\\'','\\\\''outcome'\\\\'','\\\\''reference'\\\\'','\\\\''cites'\\\\'','\\\\''rung'\\\\'')})\n for k in ps:passage(q,k)\n if fields_only:\n  f={f['\\\\''id'\\\\''] for f in d['\\\\''figures'\\\\'']}\n  for k,v,obj in fields(d):\n   if v is not None and v not in allowed(k,f,q): print('\\\\''BAD FIELD'\\\\'',k,repr(v),obj.get('\\\\''id'\\\\'',obj.get('\\\\''view_id'\\\\'')))\n\ndef strip(x):\n if isinstance(x,dict):return {k:strip(v) for k,v in x.items() if v is not None}\n if isinstance(x,list):return [strip(y) for y in x]\n return x\np=pathlib.Path('\\\\''/private/tmp/claude-501/-Users-lchingen-hivemind/f1ea972d-85a1-4f27-8010-cf0b60054109/scratchpad/normalise_diag.py'\\\\'')\nsteps=['\\\\''units'\\\\'','\\\\''ids'\\\\'','\\\\''range'\\\\'','\\\\''signs'\\\\'','\\\\''prose'\\\\'']\nimport copy\nsrc=p.read_text();exec(src[src.index('\\\\''def unit_fix'\\\\''):src.index('\\\\''def classify'\\\\'')])\ndef early(e):\n c,s=e\n return c=='\\\\''C7'\\\\'' and cat(e) not in ('\\\\''C7: outcome missing'\\\\'','\\\\''C7: outcome key'\\\\'')\nfor n,j in J.items():\n rr=[]\n for l,r in j:\n  plan=P[r['\\\\''unit'\\\\''],r['\\\\''arm'\\\\'']];d=normalise(strip(r['\\\\''data'\\\\'']),plan['\\\\''passages'\\\\''])\n  es=cc.check(plan['\\\\''family'\\\\''],plan['\\\\''passages'\\\\''],d)['\\\\''errors'\\\\'']\n  rr.append((r,es))\n print(n, '\\\\''clears early'\\\\'',sum(not any(map(early,es)) for r,es in rr),'\\\\''clears all C7'\\\\'',sum(not any(c=='\\\\''C7'\\\\'' for c,s in es) for r,es in rr))\n for a in ('\\\\''joint'\\\\'','\\\\''separate'\\\\'','\\\\''single'\\\\''):\n  matches=[x for x in j if arm(x[1])==a]\n  print(a,'\\\\''cost'\\\\'',sum(r['\\\\''cost_usd'\\\\''] for l,r in matches))\n for u in ('\\\\''single-O'\\\\'','\\\\''single-S'\\\\'','\\\\''single-E'\\\\''):\n  matches=[r for l,r in j if r['\\\\''unit'\\\\'']==u]\n  print(u,dict(collections.Counter(cat(e) for r in matches for e in r['\\\\''errors'\\\\''])))\ncase=dict(J['\\\\''retries'\\\\''])[66]; plan=P[case['\\\\''unit'\\\\''],case['\\\\''arm'\\\\'']]; d=strip(case['\\\\''data'\\\\''])\na=cc.check(plan['\\\\''family'\\\\''],plan['\\\\''passages'\\\\''],d)['\\\\''errors'\\\\'']\nfor f in d['\\\\''figures'\\\\'']:\n if f['\\\\''id'\\\\'']=='\\\\''f1'\\\\'':f['\\\\''what'\\\\'']['\\\\''period'\\\\'']='\\\\''FY2027 H1'\\\\''\nb=cc.check(plan['\\\\''family'\\\\''],plan['\\\\''passages'\\\\''],d)['\\\\''errors'\\\\'']\nprint('\\\\''period only removed'\\\\'',set(a)-set(b),'\\\\''added'\\\\'',set(b)-set(a))\ncase=dict(J['\\\\''retries'\\\\''])[12]; plan=P[case['\\\\''unit'\\\\''],case['\\\\''arm'\\\\'']]; d=strip(case['\\\\''data'\\\\''])\na=cc.check(plan['\\\\''family'\\\\''],plan['\\\\''passages'\\\\''],d)['\\\\''errors'\\\\'']\nfor f in d['\\\\''figures'\\\\'']:\n if f['\\\\''id'\\\\'']=='\\\\''dc_share_q2'\\\\'': f['\\\\''unit'\\\\'']='\\\\''%'\\\\''\n if f['\\\\''id'\\\\'']=='\\\\''dc_q3_forecast'\\\\'': f['\\\\''operation'\\\\'']='\\\\''share'\\\\''\nb=cc.check(plan['\\\\''family'\\\\''],plan['\\\\''passages'\\\\''],d)['\\\\''errors'\\\\'']\nprint('\\\\''one percent product -> share removed'\\\\'', set(a)-set(b),'\\\\''added'\\\\'',set(b)-set(a))\nfor where,u,ar,ids in [('\\\\''Equity'\\\\'','\\\\''single-O'\\\\'','\\\\''single'\\\\'',['\\\\''e3558'\\\\'']),('\\\\''Growth'\\\\'','\\\\''pair-old-1'\\\\'','\\\\''joint'\\\\'',['\\\\''e2452'\\\\'','\\\\''e5162'\\\\'']),('\\\\''CPU'\\\\'','\\\\''single-E'\\\\'','\\\\''single'\\\\'',['\\\\''e4856'\\\\'','\\\\''e3660'\\\\''])]:\n q=P[u,ar]\n for k in ids:passage(q,k)\nfor n,l in [('\\\\''answers'\\\\'',2),('\\\\''answers'\\\\'',12),('\\\\''retries'\\\\'',12),('\\\\''retries'\\\\'',66),('\\\\''retries'\\\\'',44),('\\\\''retries'\\\\'',60),('\\\\''retries'\\\\'',72)]:\n r=dict(J[n])[l]\n print(n,l,'\\\\''first reasons'\\\\'' if n=='\\\\''retries'\\\\'' else '\\\\''raw errors'\\\\'',dict(J['\\\\''answers'\\\\''])[l]['\\\\''errors'\\\\''])\n'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
