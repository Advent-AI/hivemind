\\\\\''view_id'\\\\\\\\''],raw,t)\\n assert control==[],(call,control)\\n for k,val in [('\\\\\\\\''implied_outcome'\\\\\\\\'','\\\\\\\\''FY2027 estimated revenue of approximately \\\"'$999 billion.'\\\"'\\\\\\\\''),('\\\\\\\\''reference'\\\\\\\\'','\\\\\\\\''Market forecast is the prior conclusion of \\\"'$414 billion.'\\\"'\\\\\\\\'')]:\\n  assert not check_answer(v,j['\\\\\\\\''view_id'\\\\\\\\''],dict(raw,**{k:val}),t)\\n bad=check_answer(v,j['\\\\\\\\''view_id'\\\\\\\\''],dict(raw,cites=[*raw['\\\\\\\\''cites'\\\\\\\\''],'\\\\\\\\''e999999999'\\\\\\\\'']),t)\\n assert len(bad)==1\\n print(i,call,'\\\\\\\\''stored answer passed; deliberately bad numeric text still passed; unknown citation refused'\\\\\\\\'')\\nfor i,id in [(1,'\\\\\\\\''v28'\\\\\\\\''),(2,'\\\\\\\\''v29'\\\\\\\\''),(3,'\\\\\\\\''v33'\\\\\\\\''),(3,'\\\\\\\\''v41'\\\\\\\\'')]:\\n v,a,_=record(i)\\n print('\\\\\\\\''DRAW'\\\\\\\\'',i,id)\\n n=0\\n for j in v.execute(\\\\\\\"select * from judgements where view_id=? order by judgement_id\\\\\\\",(id,)):\\n  fields=[j[s] for s in ('\\\\\\\\''implied_outcome'\\\\\\\\'','\\\\\\\\''reasons'\\\\\\\\'','\\\\\\\\''reference'\\\\\\\\'')]\\n  if id=='\\\\\\\\''v41'\\\\\\\\'':\\n   print(j['\\\\\\\\''call_id'\\\\\\\\''],j['\\\\\\\\''publication_day'\\\\\\\\''],fields[0]);continue\\n  for t in fields:\\n   for m in re.finditer(r'\\\\\\\\''\\\\\\\\\\\"'$(?:25|18|43)'\\\"\\\\\\\\s*(?:billion|bn)'\\\\\\\\'',t,re.I):\\n    q=t[max(0,m.start()-30):m.end()+165]\\n    if set(D(x) for x in (18,25,43))<=set(figures(q,'\\\\\\\\''USD'\\\\\\\\'')) and tag(q,r'\\\\\\\\''\\\\\\\\b(?:plus|add(?:ed|ing)?|sums?|combin\\\\\\\\w*)\\\\\\\\b'\\\\\\\\''):\\n     print(j['\\\\\\\\''publication_day'\\\\\\\\''][5:],j['\\\\\\\\''call_id'\\\\\\\\''],q[:195])\\n     n+=1;break\\n   else:continue\\n   break\\n print('\\\\\\\\''TIGHT'\\\\\\\\'',n)\\n'\\\"\",\"aggregated_output\":\"\",\"exit_code\":null,\"status\":\"in_progress\"}}\ndocs/research/2026-11-22-number-answers/codex-r45.stream:9