lease.check_package(package, views_db, items_db)[0]\ndocs/research/2026-11-22-number-answers/release_check.py:60:def fields(data, manifest=None):\ndocs/research/2026-11-22-number-answers/release_check.py:61:    \"\"\"(question id, field path, evidence id, text) for every decoded string of the package: every string value of the data at\ndocs/research/2026-11-22-number-answers/release_check.py:62:    every level (ids, classes and the marker included) and of the manifest.\"\"\"\ndocs/research/2026-11-22-number-answers/release_check.py:75:    if manifest is not None:\ndocs/research/2026-11-22-number-answers/release_check.py:76:        yield from walk(manifest, 'manifest', None, None)\ndocs/research/2026-11-22-number-answers/release_check.py:80:    \"\"\"Every stored string the package must not hold, by question and kind; judgement columns read only where the store has them.\"\"\"\ndocs/research/2026-11-22-number-answers/release_check.py:100:def diagnostics(ledger, data, package):\ndocs/research/2026-11-22-number-answers/release_check.py:102:    located = list(fields(data, json.loads((package / release.MANIFEST_FILE).read_text())))\ndocs/research/2026-11-22-number-answers/release_check.py:110:    return {'stored_strings_judged': len(set(stored)), 'package_strings': len(located), 'judgement_columns_absent': absent, 'hits': hits}\ndocs/research/2026-11-22-number-answers/release_check.py:128:def refresh(package, data=None, manifest_extra=None):\ndocs/research/2026-11-22-number-answers/release_check.py:131:        (package / release.DATA_FILE).write_bytes(payload)\ndocs/research/2026-11-22-number-answers/release_check.py:132:    manifest = json.loads((package / release.MANIFEST_FILE).read_text())\ndocs/research/2026-11-22-number-answers/release_check.py:133:    manifest['data_sha256'] = hashlib.sha256((package / release.DATA_FILE).read_bytes()).hexdigest()\ndocs/research/2026-11-22-number-answers/release_check.py:134:    manifest.update(manifest_extra or {})\ndocs/research/2