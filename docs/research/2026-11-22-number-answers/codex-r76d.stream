very decoded string in the package (keys excluded).\"\"\"\ntests/test_release.py:166:def build_package(stores, out, as_of=None):\ntests/test_release.py:171:        release.write_package(data, staged)\ntests/test_release.py:172:        release.check_package(staged, views_db, items_db, expected_as_of=data['as_of'])\ntests/test_release.py:180:def rewrite_data(package, data):\ntests/test_release.py:181:    \"\"\"A copy of the package's data with its manifest hash refreshed, so every other check still passes.\"\"\"\ntests/test_release.py:183:    (package / release.DATA_FILE).write_bytes(payload)\ntests/test_release.py:184:    manifest = json.loads((package / release.MANIFEST_FILE).read_text())\ntests/test_release.py:185:    manifest.update(as_of=data['as_of'], data_sha256=hashlib.sha256(payload).hexdigest())\ntests/test_release.py:186:    (package / release.MANIFEST_FILE).write_text(json.dumps(manifest))\ntests/test_release.py:189:def check(stores, package):\ntests/test_release.py:190:    \"\"\"The counts of `check_package` with the stores.\"\"\"\ntests/test_release.py:193:        return release.check_package(package, views_db, items_db)[0]\ntests/test_release.py:298:# ---------- §6 tests 9, 10, 13, 15, 16: the package and the origin check\ntests/test_release.py:301:def test_9_package_files_hash_and_manifest(stores, tmp_path):\ntests/test_release.py:302:    \"\"\"§1 check_package, §6 test 9.\"\"\"\ntests/test_release.py:304:    data = build_package(stores, out)\ntests/test_release.py:306:    files = \"not exactly ['manifest.json', 'release-data.json']\"\ntests/test_release.py:308:        'foreign file': (lambda p: (p / 'notes.txt').write_text('x'), lambda p: f\"{p}: holds ['manifest.json', 'notes.txt', 'release-data.json'], {files}\"),\ntests/test_release.py:309:        'subdirectory': (lambda p: (p / 'extra').mkdir(), lambda p: f\"{p}: holds ['extra', 'manifest.json', 'release-data.json'], {files}\"),\ntests/test_release.py:311:                         lambda p: 'the manifest sha256 does not match the data file'),\ntests/test_release.py:312:        'manifest prose': (lambda p: (p / release.MANIFEST_FILE).write_text(json.dumps({**json.loads((p / release.MANIFEST_FILE).read_text()), 'note': 'About $390 billion'})),\ntests/test_release.py:313:                           lambda p: \"the manifest: keys off the allow-list ['note'], missing []\"),\ntests/test_release.py:314:        'manifest day': (lambda p: (p / release.MANIFEST_FILE).write_text(json.dumps({**json.loads((p / release.MANIFEST_FILE).read_text()), 'as_of': DAYS[0]})),\ntests/test_release.py:315:                         lambda p: f\"the manifest as_of '{DAYS[0]}' differs from the data '{DAYS[2]}'\"),\ntests/test_release.py:324:        release.write_package(data, staged)\ntests/test_release.py:327:    assert build_package(stores, tmp_path / 'other')\ntests/test_release.py:334:    data = build_package(stores, out)\ntests/test_release.py:380:    build_package(pair, tmp_path / 'release', '2026-09-30')\ntests/test_release.py:384:def test_13_check_refuses_a_missing_item_even_when_the_package_omits_its_source(stores, tmp_path):\ntests/test_release.py:385:    \"\"\"§6 test 13: the items copy lacks item-3; the package copy drops every item-3 source, keeping e2 with none, its hash refreshed.\ntests/test_release.py:388:    data = build_package(stores, out)\ntests/test_release.py:401:    build_package(stores, out)\ntests/test_release.py:415:    manifest = json.loads((repeated / release.MANIFEST_FILE).read_text())\ntests/test_release.py:416:    manifest['data_sha256'] = hashlib.sha256(payload).hexdigest()\ntests/test_release.py:417:    (repeated / release.MANIFEST_FILE).write_text(json.dumps(manifest))\ntests/test_release.py:442:def test_16_a_day_before_the_first_question_gives_an_empty_package(stores):\ntests/test_release.py:459:    assert written['counts'] == FIXTURE_COUNTS and written['withheld_unresolved'] == FIXTURE_UNRESOLVED and written['data_bytes'] == FIXTURE_DATA_BYTES\ntests/t