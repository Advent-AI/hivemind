{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc 'nl -ba docs/research/2026-11-22-number-answers/release_check.py'","aggregated_output":"     1\t\"\"\"The $0 release check of RELEASE-BUILD.md §7 on four stored stores, read-only (a closing switch is added only to a copy).\n     2\t\n     3\t    python3 docs/research/2026-11-22-number-answers/release_check.py <new output folder>\n     4\t\n     5\tBuilds each store's package with the real command, then: the decisive acceptance case on old-1; old-1/v8; the two known Yes/No leaks\n     6\tat their own days; an unchanged event control; a closing switch on a copy; the diagnostic search of every forbidden stored string in\n     7\tevery decoded package field; the size and speed budgets against `bundle.library` on the same store. Writes results.json there.\"\"\"\n     8\timport hashlib\n     9\timport json\n    10\timport shutil\n    11\timport sqlite3\n    12\timport subprocess\n    13\timport sys\n    14\timport time\n    15\tfrom pathlib import Path\n    16\t\n    17\tREPO = Path(__file__).resolve().parents[3]\n    18\tsys.path.insert(0, str(REPO / 'src'))\n    19\tfrom hivemind import bundle, release, service  # noqa: E402\n    20\tfrom hivemind.views import store  # noqa: E402\n    21\t\n    22\tCOMMAND = REPO / 'scripts' / 'release_build.py'\n    23\tMARKER = 'Forecast unavailable'                     # D726's words, written here, not read from the module under test\n    24\tFORMAT, ALLOW_LIST = 'hivemind-release/1', 'release-allow-list/1'   # revision 11's identifiers, written here, not read from the module\n    25\tDATED = {'old-3/v36@2026-08-25': ('2026-08-25', 3239), 'old-1/v10@2026-08-28': ('2026-08-28', 5673)}   # each dated package's day and evidence\n    26\tEXPECTED = {   # each store's default day, classes and evidence, fixed before this run from the reviewed first run (councils 75–75e reproduced them)\n    27\t    'old-1': ('2026-09-20', {'number': 19, 'event': 28, 'yes_no': 0}, 8251),\n    28\t    'old-2': ('2026-09-20', {'number': 17, 'event': 26, 'yes_no': 0}, 6306),\n    29\t    'old-3': ('2026-09-20', {'number': 18, 'event': 31, 'yes_no': 0}, 6659),\n    30\t    'served': ('2026-08-28', {'number': 13, 'event': 55, 'yes_no': 0}, 6461),\n    31\t}\n    32\tJ1580_PREFIX = 'About $390 billion: $164 billion reported in the first half'   # the system's own forecast used as the forged value\n    33\tCLOSING_REASON = 'due 2026-09-20, frozen on 2026-09-20 at rung 2 Bullish'\n    34\tCOMPARISON_ITEMS = REPO / 'poc/data/comparison-2026-11-17/items-comparison.sqlite'\n    35\tSTORES = {\n    36\t    'old-1': (REPO / 'poc/data/comparison-2026-11-17/run/old-1/prod/views.sqlite', COMPARISON_ITEMS),\n    37\t    'old-2': (REPO / 'poc/data/comparison-2026-11-17/run/old-2/prod/views.sqlite', COMPARISON_ITEMS),\n    38\t    'old-3': (REPO / 'poc/data/comparison-2026-11-17/run/old-3/prod/views.sqlite', COMPARISON_ITEMS),\n    39\t    'served': (REPO / 'poc/data/served-2026-10-28-v34-nvda-3m-through-0828/views.sqlite', REPO / 'poc/data/items-nvda-2026-07-01-10-27.sqlite'),\n    40\t}\n    41\t\n    42\t\n    43\tdef build(ledger, items, out, as_of=None):\n    44\t    args = [sys.executable, str(COMMAND), 'build', '--ledger', str(ledger), '--items', str(items), '--out', str(out)] + (['--as-of', as_of] if as_of else [])\n    45\t    result = subprocess.run(args, capture_output=True, text=True, env={'PATH': '/usr/bin:/bin', 'PYTHONDONTWRITEBYTECODE': '1'})\n    46\t    if result.returncode != 0:\n    47\t        raise SystemExit(f'build {out} exited {result.returncode}: {result.stderr}')\n    48\t    return json.loads(out.with_name(out.name + '.report.json').read_text()), release.read_data(out)\n    49\t\n    50\t\n    51\tdef check(ledger, items, package):\n    52\t    views_db, items_db = service.open_ledger(str(ledger)), store.open_read_only(str(items))\n    53\t    try:\n    54\t        return release.check_package(package, views_db, items_db)[0]\n    55\t    finally:\n    56\t        views_db.close()\n    57\t        items_db.close()\n    58\t\n    59\t\n    60\tdef fields(data, manifest=None):\n    61\t    \"\"\"(question id, field path, evidence id, text) for every decoded string of the package: every string value of the data at\n    62\t    every level (ids, classes and the marker included) and of the manifest.\"\"\"\n    63\t    def walk(value, path, question_id, evidence_id):\n    64\t        if isinstance(value, dict):\n    65\t            question_id = value['id'] if 'class' in value else question_id\n    66\t            evidence_id = value['id'] if 'one_line' in value else evidence_id\n    67\t            for key, item in value.items():\n    68\t                yield from walk(item, f'{path}.{key}' if path else key, question_id, evidence_id)\n    69\t        elif isinstance(value, list):\n    70\t            for n, item in enumerate(value):\n    71\t                yield from walk(item, f'{path}[{n}]', question_id, evidence_id)\n    72\t        elif isinstance(value, str):\n    73\t            yield question_id, path, evidence_id, value\n    74\t    yield from walk(data, '', None, None)\n    75\t    if manifest is not None:\n    76\t        yield from walk(manifest, 'manifest', None, None)\n    77\t\n    78\t\n    79\tdef forbidden(ledger, data):\n    80\t    \"\"\"Every stored string the package must not hold, by question and kind; judgement columns read only where the store has them.\"\"\"\n    81\t    conn = service.open_ledger(str(ledger))\n    82\t    try:\n    83\t        columns = {row[1] for row in conn.execute('pragma table_info(judgements)')}\n    84\t        texts = [c for c in ('reasons', 'why_changed', 'implied_outcome', 'reference') if c in columns]\n    85\t        out = []\n    86\t        for question in data['questions']:\n    87\t            view_id = question['id']\n    88\t            for row in conn.execute('select label, condition from rungs where view_id=?', (view_id,)):\n    89\t                if question['class'] == 'number':                # an event's or Yes/No question's labels are its shown answers\n    90\t                    out.append((view_id, 'rung label', row['label']))\n    91\t                out.append((view_id, 'rung condition', row['condition']))\n    92\t            for row in conn.execute(f'select {\", \".join(texts)} from judgements where view_id=?', (view_id,)):\n    93\t                out += [(view_id, name, row[name]) for name in texts]\n    94\t            out += [(view_id, 'switch reason', row['reason']) for row in conn.execute('select reason from view_switches where view_id=?', (view_id,))]\n    95\t        return [entry for entry in out if entry[2]], [c for c in ('implied_outcome', 'reference') if c not in columns]\n    96\t    finally:\n    97\t        conn.close()\n    98\t\n    99\t\n   100\tdef diagnostics(ledger, data, package):\n   101\t    stored, absent = forbidden(ledger, data)\n   102\t    located = list(fields(data, json.loads((package / release.MANIFEST_FILE).read_text())))\n   103\t    joined = '\\x00'.join(text for *_, text in located)\n   104\t    hits = []\n   105\t    for view_id, kind, text in set(stored):\n   106\t        if text in joined:\n   107\t            for question_id, path, evidence_id, field in located:\n   108\t                if text in field:\n   109\t                    hits.append({'stored_in': view_id, 'kind': kind, 'text': text[:200], 'found_in': question_id, 'field': path, 'evidence': evidence_id})\n   110\t    return {'stored_strings_judged': len(set(stored)), 'package_strings': len(located), 'judgement_columns_absent': absent, 'hits': hits}\n   111\t\n   112\t\n   113\tdef library_baseline(ledger, items):\n   114\t    views_db, items_db = service.open_ledger(str(ledger)), store.open_read_only(str(items))\n   115\t    try:\n   116\t        started = time.monotonic()\n   117\t        payload = bundle.library(views_db, items_db)\n   118\t        return len(json.dumps(payload, ensure_ascii=False).encode()), time.monotonic() - started\n   119\t    finally:\n   120\t        views_db.close()\n   121\t        items_db.close()\n   122\t\n   123\t\n   124\tdef by_id(data):\n   125\t    return {q['id']: q for q in data['questions']}\n   126\t\n   127\t\n   128\tdef refresh(package, data=None, manifest_extra=None):\n   129\t    if data is not None:\n   130\t        payload = json.dumps(data, ensure_ascii=False, separators=(',', ':')).encode()\n   131\t        (package / release.DATA_FILE).write_bytes(payload)\n   132\t    manifest = json.loads((package / release.MANIFEST_FILE).read_text())\n   133\t    manifest['data_sha256'] = hashlib.sha256((package / release.DATA_FILE).read_bytes()).hexdigest()\n   134\t    manifest.update(manifest_extra or {})\n   135\t    (package / release.MANIFEST_FILE).write_text(json.dumps(manifest))\n   136\t\n   137\t\n   138\tdef refused(ledger, items, package):\n   139\t    try:\n   140\t        check(ledger, items, package)\n   141\t    except release.ReleaseRefused as error:\n   142\t        return str(error)\n   143\t    return None\n   144\t\n   145\t\n   146\tdef main(out):\n   147\t    out = Path(out).absolute()\n   148\t    out.mkdir()                                            # a new folder; refuses an existing one\n   149\t    results = {'stores': {}}\n   150\t    packages = {}\n   151\t    for name, (ledger, items) in STORES.items():\n   152\t        (out / name).mkdir()\n   153\t        report, data = build(ledger, items, out / name / 'package')\n   154\t        packages[name] = data\n   155\t        library_bytes, library_seconds = library_baseline(ledger, items)\n   156\t        seconds = report['export_seconds'] + report['check_seconds']\n   157\t        results['stores'][name] = {\n   158\t            'as_of': report['as_of'], 'counts': report['counts'], 'withheld_unresolved': len(report['withheld_unresolved']),\n   159\t            'unresolved': report['withheld_unresolved'], 'data_bytes': report['data_bytes'], 'library_bytes': library_bytes,\n   160\t            'seconds': round(seconds, 2), 'library_seconds': round(library_seconds, 2),\n   161\t            'bytes_within_budget': report['data_bytes'] <= library_bytes,\n   162\t            'seconds_within_budget': seconds <= 3 * library_seconds and seconds <= 120,\n   163\t            'diagnostics': diagnostics(ledger, data, out / name / 'package')}\n   164\t        print(name, json.dumps({k: v for k, v in results['stores'][name].items() if k not in ('unresolved', 'diagnostics')}), 'hits', len(results['stores'][name]['diagnostics']['hits']))\n   165\t\n   166\t    ledger, items = STORES['old-1']\n   167\t    data, package = packages['old-1'], out / 'old-1' / 'package'\n   168\t    conn = service.open_ledger(str(ledger))\n   169\t    stored = {row['evidence_id']: row for row in conn.execute(\"select * from evidence where evidence_id in ('e2295','e1865','e3597')\")}\n   170\t    implied = conn.execute('select implied_outcome from judgements where judgement_id=1580').fetchone()[0]\n   171\t    in_force_v8 = [e['evidence_id'] for e in service.evidence(conn, 'v8', data['as_of'])]\n   172\t    conn.close()\n   173\t    required_text = {   # each example's full stored text, written down before the run (old-1, 2026-11-23); compared exactly\n   174\t        'e2295': ('Morningstar cites NVIDIA Data Center revenue of $3 billion in FY2020 and $194 billion in FY2026, and estimates $361 billion in FY2027, up 86% year over year.',\n   175\t                  'Nvidia’s DC business has achieved exponential growth already, rising from $3 billion in fiscal 2020 to $194 billion in fiscal 2026, and we estimate it will be $361 billion in fiscal 2027, representing 86% annual growth.'),\n   176\t        'e1865': ('The author identifies firm SpaceX procurement commitments and NVIDIA Data Center growth above 60% into FY2028 as bullish confirmation conditions.',\n   177\t                  'Bullish confirmation would require firm procurement commitments for the SpaceX buildout and continued NVIDIA Data Center growth above 60% into fiscal 2028.'),\n   178\t        'e3597': ('The author says analysts estimate NVIDIA revenue of about $390 billion in calendar 2027 and over $550 billion in calendar 2028, with annual sales growth of roughly 24% to 25%.',\n   179\t                  'Analysts see revenue reaching about $390 billion in 2027 and more than $550 billion in 2028, with annual sales growth of roughly 24% to 25%.')}\n   180\t    kept = {}\n   181\t    for evidence_id in ('e2295', 'e1865', 'e3597'):              # the fixed examples: a missing one is a failure, not a smaller list\n   182\t        if evidence_id not in stored:\n   183\t            kept[evidence_id] = {'questions': [], 'equal_to_store': False, 'present': False}\n   184\t            continue\n   185\t        holders = [(q['id'], e) for q in data['questions'] for e in q['evidence'] if e['id'] == evidence_id]\n   186\t        kept[evidence_id] = {'questions': [h[0] for h in holders],\n   187\t                             'equal_to_store': all(e['one_line'] == stored[evidence_id]['one_line'] and e['quote'] == stored[evidence_id]['quote'] for _, e in holders) and bool(holders),\n   188\t                             'present': bool(holders),\n   189\t                             'holds_its_wording': bool(holders) and all((e['one_line'], e['quote']) == required_text[evidence_id] for _, e in holders)}\n   190\t    forged = out / 'old-1' / 'forged-summary'\n   191\t    shutil.copytree(package, forged)\n   192\t    changed = json.loads(json.dumps(data))\n   193\t    next(e for e in by_id(changed)['v8']['evidence'] if e['id'] == 'e2295')['one_line'] = implied\n   194\t    refresh(forged, changed)\n   195\t    prose = out / 'old-1' / 'forged-manifest'\n   196\t    shutil.copytree(package, prose)\n   197\t    refresh(prose, manifest_extra={'note': implied})\n   198\t    v8 = by_id(data)['v8']\n   199\t    results['decisive'] = {'kept': kept, 'implied_outcome_j1580': implied[:120],\n   200\t                           'substituted_into_e2295_refused': refused(ledger, items, forged),\n   201\t                           'added_to_manifest_refused': refused(ledger, items, prose),\n   202\t                           'unchanged_package_passes': check(ledger, items, package)['fields_compared']}\n   203\t    results['decisive']['forged_value_is_j1580'] = implied.startswith(J1580_PREFIX)\n   204\t    results['old-1/v8'] = {'class': v8['class'], 'forecast': v8['forecast'], 'evidence': len(v8['evidence']),\n   205\t                           'same_ids_as_service_evidence': [e['id'] for e in v8['evidence']] == in_force_v8}\n   206\t\n   207\t    leaks = {}\n   208\t    for name, view_id, day, judgement_id in (('old-3', 'v36', '2026-08-25', 799), ('old-1', 'v10', '2026-08-28', 865)):\n   209\t        ledger, items = STORES[name]\n   210\t        report, dated = build(ledger, items, out / name / f'package-{day}', day)\n   211\t        conn = service.open_ledger(str(ledger))\n   212\t        row = conn.execute('select judgement_id, rung, why_changed, reasons from judgements where view_id=? and publication_day<=? order by judgement_id desc limit 1', (view_id, day)).fetchone()\n   213\t        label = conn.execute('select label from rungs where view_id=? and position=?', (view_id, row['rung'])).fetchone()[0]\n   214\t        conn.close()\n   215\t        record = by_id(dated)[view_id]\n   216\t        dated_manifest = json.loads((out / name / f'package-{day}' / release.MANIFEST_FILE).read_text())\n   217\t        texts = [text for *_, text in fields(dated)]\n   218\t        leaks[f'{name}/{view_id}@{day}'] = {\n   219\t            'package_as_of': dated['as_of'], 'manifest_as_of': dated_manifest['as_of'], 'evidence': report['counts']['evidence'],\n   220\t            'latest_judgement': row['judgement_id'], 'expected_judgement': judgement_id, 'label_kept': record['answer'] == label, 'answer': record['answer'],\n   221\t            'why_changed_absent': not any(row['why_changed'] in t for t in texts), 'reasons_absent': not any((row['reasons'] or '\\x01') in t for t in texts),\n   222\t            'phrase_fields': {phrase: [(q, p, e, t[:160]) for q, p, e, t in fields(dated) if phrase in t]\n   223\t                              for phrase in ('around $1 trillion', 'rung 4', 'at rung', 'capex at rung')}}\n   224\t    results['leaks'] = leaks\n   225\t\n   226\t    ledger, items = STORES['old-1']\n   227\t    conn = service.open_ledger(str(ledger))\n   228\t    control = next(q for q in data['questions'] if q['class'] == 'event' and q['id'] not in ('v10',) and q['answer'] is not None)\n   229\t    stored_label = conn.execute('select r.label from judgements j join rungs r on r.view_id=j.view_id and r.position=j.rung where j.view_id=? and j.publication_day<=? order by j.judgement_id desc limit 1', (control['id'], data['as_of'])).fetchone()[0]\n   230\t    control_ids = [e['evidence_id'] for e in service.evidence(conn, control['id'], data['as_of'])]\n   231\t    conn.close()\n   232\t    results['control'] = {'id': control['id'], 'answer': control['answer'], 'label_equals_store': control['answer'] == stored_label,\n   233\t                          'evidence_equals_store': [e['id'] for e in control['evidence']] == control_ids}\n   234\t\n   235\t    closing = out / 'old-1' / 'closing'\n   236\t    closing.mkdir()\n   237\t    copy = closing / 'views.sqlite'\n   238\t    shutil.copyfile(ledger, copy)\n   239\t    conn = sqlite3.connect(copy)\n   240\t    rung = conn.execute(\"select rung from judgements where view_id='v8' order by judgement_id desc limit 1\").fetchone()[0]\n   241\t    rung_label = conn.execute(\"select label from rungs where view_id='v8' and position=?\", (rung,)).fetchone()[0]\n   242\t    reason = f'due {data[\"as_of\"]}, frozen on {data[\"as_of\"]} at rung {rung} {rung_label}'\n   243\t    last_seq = conn.execute('select max(sequence_no) from processing_steps').fetchone()[0]\n   244\t    conn.execute(\"insert into view_switches (view_id, open, reason, by_whom, after_seq) values ('v8', 0, ?, 'pull', ?)\", (reason, last_seq))\n   245\t    conn.commit()\n   246\t    conn.close()\n   247\t    views_db, items_db = service.open_ledger(str(copy)), store.open_read_only(str(items))\n   248\t    exposed = bundle.view_bundle(views_db, bundle.item_lookup(items_db), 'v8')\n   249\t    views_db.close()\n   250\t    items_db.close()\n   251\t    report, closed = build(copy, items, closing / 'package')\n   252\t    texts = [text for *_, text in fields(closed)]\n   253\t    results['closing'] = {'reason': reason, 'bundle_exposes_reason': any(s.get('reason') == reason for s in exposed['switches']),\n   254\t                          'package_open': by_id(closed)['v8']['open'], 'reason_absent': not any(reason in t for t in texts),\n   255\t                          'rung_label_inside_v8_fields': [(p, e, t[:120]) for q, p, e, t in fields(closed) if q == 'v8' and rung_label in t]}\n   256\t    (out / 'results.json').write_text(json.dumps(results, ensure_ascii=False, indent=1))\n   257\t    print(json.dumps({k: v for k, v in results.items() if k != 'stores'}, ensure_ascii=False, indent=1))\n   258\t    failures = [f'{name}: {key}' for name, s in results['stores'].items() for key in ('bytes_within_budget', 'seconds_within_budget') if not s[key]]\n   259\t    for name in STORES:                                          # the delivered identifiers, data and manifest, against the literal ones\n   260\t        delivered = json.loads((out / name / 'package' / release.MANIFEST_FILE).read_text())\n   261\t        failures += [] if (packages[name]['format'], packages[name]['allow_list'], delivered['format'], delivered['allow_list']) == (FORMAT, ALLOW_LIST, FORMAT, ALLOW_LIST) else [f'{name}: format or allow-list']\n   262\t    failures += [f'{name}: day, classes or evidence' for name, (day, classes, evidence) in EXPECTED.items()\n   263\t                 if (results['stores'][name]['as_of'], results['stores'][name]['counts']['questions'], results['stores'][name]['counts']['evidence']) != (day, classes, evidence)]\n   264\t    failures += [] if results['decisive']['forged_value_is_j1580'] else ['the forged value is not the system forecast j1580']\n   265\t    decisive = results['decisive']\n   266\t    failures += [f'kept {e}' for e in ('e2295', 'e1865', 'e3597')\n   267\t                 if not (decisive['kept'].get(e, {}).get('present') and decisive['kept'][e]['equal_to_store'] and decisive['kept'][e]['holds_its_wording'])]\n   268\t    expected_reasons = {'substituted_into_e2295_refused': 'question v8.evidence e2295.one_line: differs from the store',\n   269\t                        'added_to_manifest_refused': \"the manifest: keys off the allow-list ['note'], missing []\"}   # exact, so another refusal (a stale hash) does not count\n   270\t    failures += [k for k, reason in expected_reasons.items() if decisive[k] != reason]\n   271\t    failures += [] if (results['old-1/v8']['same_ids_as_service_evidence'] and results['old-1/v8']['forecast'] == MARKER\n   272\t                       and results['old-1/v8']['class'] == 'number' and results['old-1/v8']['evidence'] == 1284) else ['old-1/v8']\n   273\t    for name, leak in results['leaks'].items():\n   274\t        failures += [f'{name}: {k}' for k in ('label_kept', 'why_changed_absent', 'reasons_absent') if not leak[k]]\n   275\t        failures += [] if leak['answer'] == 'Yes' else [f'{name}: answer']\n   276\t        failures += [] if (leak['package_as_of'], leak['manifest_as_of'], leak['evidence']) == (DATED[name][0], DATED[name][0], DATED[name][1]) else [f'{name}: package day or evidence']\n   277\t        failures += [] if leak['latest_judgement'] == leak['expected_judgement'] else [f'{name}: judgement']\n   278\t        failures += [f'{name}: {phrase} found' for phrase, hits in leak['phrase_fields'].items() if hits]\n   279\t    failures += [] if (results['control']['id'], results['control']['answer']) == ('v3', 'Yes') and results['control']['label_equals_store'] and results['control']['evidence_equals_store'] else ['control']\n   280\t    closing = results['closing']\n   281\t    failures += [] if closing['reason'] == CLOSING_REASON and closing['bundle_exposes_reason'] and closing['package_open'] is False and closing['reason_absent'] else ['closing']\n   282\t    if failures:\n   283\t        raise SystemExit(f'release check FAILED: {failures}')\n   284\t    print('release check: every acceptance item and budget met; diagnostic hits to read by hand:',\n   285\t          {name: len(s['diagnostics']['hits']) for name, s in results['stores'].items()})\n   286\t\n   287\t\n   288\tif __name__ == '__main__':\n   289\t    main(sys.argv[1])\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_8","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba docs/research/2026-11-22-number-answers/RELEASE-CHECK-RESULT.md; nl -ba tests/test_release.py | sed -n '150,225p'; nl -ba docs/research/2026-11-22-number-answers/RELEASE-BUILD.md | sed -n '108,123p'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba docs/research/2026-11-22-number-answers/RELEASE-CHECK-RESULT.md; nl -ba tests/test_release.py | sed -n '150,225p'; nl -ba docs/research/2026-11-22-number-answers/RELEASE-BUILD.md | sed -n '108,123p'\"","aggregated_output":"     1\t# \"Forecast unavailable\" release, slice 1: built and checked at $0 (2026-11-23)\n     2\t\n     3\t**Result.** Slice 1 is built to `RELEASE-BUILD.md`:\n     4\t- revision 10 was ready per council 74j, after ten review rounds;\n     5\t- revision 11 records what councils 75 to 75f required of the build.\n     6\t\n     7\tIt passes its tests, its mutants and the $0 release check on four stored stores. Nothing is committed, published or deployed. The POC\n     8\tis unchanged; no POC code imports the release module.\n     9\t\n    10\t- Code: `src/hivemind/release.py`, `scripts/release_build.py`, `tests/test_release.py`.\n    11\t- Check: `release_check.py`; mutants: `release_mutants.py` (both in this folder).\n    12\t- Output: `poc/data/release-check-2026-11-23g/`. The runs `release-check-2026-11-23/` to `-23f/` predate later fixes and are kept for\n    13\t  the record. Their counts and bytes are the same; their seconds differ by run.\n    14\t- The mutant counts below come from separate runs of `release_mutants.py`, not from `results.json`.\n    15\t\n    16\t## 1. Council 75's findings, and what changed\n    17\t\n    18\tCouncil 75 (`codex-r75.md`) reproduced the four packages' counts and both refusals of the substituted forecast. It did not accept the\n    19\tslice. Its findings and the fixes:\n    20\t\n    21\t| Finding | Fix | Proof |\n    22\t|---|---|---|\n    23\t| A key written after the bound could reclassify an earlier package (the key lookup ignored its `seq`) | the key counts only when visible at the bound | test 22; mutant \"key read without its day\" |\n    24\t| Ten text fields accepted null, which revision 10 forbids | strings only | test 23; mutant \"null accepted as text\" |\n    25\t| `check` read the data file three times: it could hash one version and certify another | one read through one folder handle; hash and parse the same bytes; the command reports that data | structural (`check_package`) |\n    26\t| A path holding `%` could make SQLite open a different file from the one named | `release.store_path` refuses `%`, `?`, `#` | test 24; mutant \"store-path refusal removed\" |\n    27\t| Test 14's marker case supplied the very line its mutant removes | the instrumentation no longer touches the line that drops the staging path | test 14; mutant caught |\n    28\t| Test 13 damaged two things | the package copy keeps `e2` with no source, which is what a checker that drops missing items expects | test 13; mutant \"inner join\" caught |\n    29\t| Tests 1, 2 and 9 lacked decisive assertions | test 25 proves the writer's own refusal; test 2 checks all five labels in `v1`'s own fields; test 9 names each refusal's reason | mutants caught |\n    30\t| The mutant runner counted any non-zero exit | it stops on a failing control, and counts a catch only with a failing test and no setup or collection error | run below |\n    31\t| My first result overstated the closing check, the diagnostic search and the dated check, and the script never failed | corrected below; the script now fails on any missed acceptance item or budget | this run |\n    32\t\n    33\t**Council 75b** (`codex-r75b.md`) confirmed the fixes above and found four more gaps, now fixed:\n    34\t\n    35\t| Finding | Fix | Proof |\n    36\t|---|---|---|\n    37\t| The store-path check returned the original path, which the opener resolved again | `store_path` returns the resolved path, and the opener is given that | test 24 (a symbolic link); mutant \"store path returned unresolved\" |\n    38\t| A named pipe in a package would make `check` hang instead of refusing | files are opened without waiting (`O_NONBLOCK`), then refused by type | test 15, through the command with a 30 s bound; mutant \"pipe opened blocking\" |\n    39\t| The check script could pass with a required example missing | the three examples are a fixed list; a missing one fails the script | this run |\n    40\t| No test reordered records, and the runner credited a failure of a test's own scratch edit | test 10 reorders questions and evidence; scratch edits fail with \"scratch anchor\", which the runner does not count | mutant \"check_origins accepting another order\" |\n    41\t\n    42\tIt also asked that test 23 cover all ten text fields (now one case per field) and that test 2 check every question's own fields for\n    43\tthe labels (done).\n    44\t\n    45\t**Council 75c** (`codex-r75c.md`) found no off-list field or mismatched value, and judged every code finding of 75 and 75b closed. It\n    46\tfound three verification gaps, now fixed:\n    47\t\n    48\t| Finding | Fix | Proof |\n    49\t|---|---|---|\n    50\t| The runner read only pytest's short line, which can omit the \"scratch anchor\" message | each failure's full message is read from pytest's XML report | this run |\n    51\t| Test 2 skipped evidence fields; test 21 did not check that the whole report is printed | test 2 allows a `v1` label only in the fixture's known genuine source text; test 21 parses the printed report | mutants \"a number label written into another question's evidence\", \"report not printed\" |\n    52\t| The check script accepted an example id whose text had changed | superseded by council 75d's rule below | this run |\n    53\t\n    54\t**Council 75d** (`codex-r75d.md`) again found no off-list field or mismatched value. Its three findings had one mechanism:\n    55\t- test 2 took its \"genuine\" text from the export under test;\n    56\t- test 21 accepted a partial report;\n    57\t- the acceptance script's \"$390 billion\" also matches the system's own forecast, and a stale-hash refusal satisfied a check meant\n    58\t  for another reason.\n    59\t\n    60\t**One structural rule now holds** (AGENTS §1): every acceptance assertion compares against fixed expected values written down before\n    61\tthe run, never values taken from the output under test, and every refusal check matches its exact reason:\n    62\t- test 2 allows a label only in the fixture's own two constant texts;\n    63\t- tests 11 and 21 require the report's exact key set and fixed values;\n    64\t- the script compares each example's full summary and quote with the stored text written into it (old-1, 2026-11-23), and each\n    65\t  refusal with its exact message;\n    66\t- mutant \"report missing a field\" proves the key-set check.\n    67\t\n    68\t**Council 75e** (`codex-r75e.md`) found no path for a forbidden or mismatched value. It showed the rule was applied only partly, and it\n    69\tis now applied to the release tests' value and refusal assertions and to every check in the script:\n    70\t- the tests compare with literal key sets and the literal marker text, never the module's own constants;\n    71\t- test 2 checks each label occurrence by its location (question, evidence, field);\n    72\t- tests 11 and 21 check the report's full contents: counts `{number 5, event 1, Yes/No 1}`, 5 evidence, 6 sources, 101 fields\n    73\t  compared, 3,313 bytes, and the two unresolved questions with their reason;\n    74\t- every refusal in the tests is matched by its exact message;\n    75\t- the script pins each store's day, classes and evidence count, the marker text, `v8`'s 1,284 pieces of evidence, the identity of the\n    76\t  forged value (the system's `j1580` forecast), both leak answers (\"Yes\"), the control (`v3`, \"Yes\") and the closing reason.\n    77\t\n    78\t**Council 75f** (`codex-r75f.md`) found two certification gaps and judged everything else optional under AGENTS §5. Both are fixed:\n    79\t- **Each dated package's own day is checked.** Before, a September package passed as the August one because both answers were \"Yes\".\n    80\t  Now the package and its manifest must carry the requested day, with the evidence count of that day: 2026-08-25, 3,239 pieces; \n    81\t  2026-08-28, 5,673 pieces.\n    82\t- **The delivered format and allow-list identifiers** (`hivemind-release/1`, `release-allow-list/1`) are compared with literal strings\n    83\t  in the script, for the data and manifest of every store, and in test 1. Before, they were compared only with the module's own\n    84\t  constants.\n    85\t\n    86\t**Left as optional (council 75f, AGENTS §5),** none of which lets a wrong package through:\n    87\t- a test helper takes its expected day from the export;\n    88\t- some occupied-path tests check only the error type or the exit status;\n    89\t- test 2's scan of other questions' evidence covers summaries and quotes; the origin check compares every field.\n    90\t\n    91\t**No regression.**\n    92\t- The release tests: 36 pass. The full suite passes: 425 tests, the frozen-ruler guards included.\n    93\t- Mutants: 31 of 32 are caught by failing tests, each judged from its full failure message (a failure of the test's own scratch edit\n    94\t  does not count), with no setup errors.\n    95\t- **The 32nd, the canonical-day check removed, is equivalent on this repository's Python 3.10.10,** whose `date.fromisoformat` already\n    96\t  refuses `20260825`. Under Python 3.13, on a temporary copy of `old-1` with one later completed day:\n    97\t  - the real code refuses `20260825`;\n    98\t  - the mutant exports `v8` with 1,284 pieces of evidence through 2026-09-20 into a package dated 2026-08-25, where the right package\n    99\t    holds 621.\n   100\t\n   101\t## 2. The $0 release check (design §7)\n   102\t\n   103\t| Store | Bound | Number / event / Yes-No | Evidence | Fields compared | Data bytes (library) | Seconds (library) |\n   104\t|---|---|---|---|---|---|---|\n   105\t| old-1 | 2026-09-20 | 19 / 28 / 0 | 8,251 | 91,055 | 5,788,634 (14,478,536) | 8.05 (6.36) |\n   106\t| old-2 | 2026-09-20 | 17 / 26 / 0 | 6,306 | 69,636 | 4,427,609 (11,893,701) | 6.19 (4.91) |\n   107\t| old-3 | 2026-09-20 | 18 / 31 / 0 | 6,659 | 73,559 | 4,685,247 (12,375,915) | 6.54 (5.25) |\n   108\t| served | 2026-08-28 | 13 / 55 / 0 | 6,461 | 71,524 | 4,612,321 (12,145,774) | 4.29 (3.36) |\n   109\t\n   110\t- **Every package passed its origin check:** every field compared with its stored source at the bound.\n   111\t- **No number question is unresolved** in these stores.\n   112\t- **Budgets met:**\n   113\t  - the bytes are 0.37–0.40 of the existing library's;\n   114\t  - the seconds are 1.25–1.28 times the library's, against a budget of 3 times and 120 s.\n   115\t- **How the evidence is counted.** The count includes each piece once per question that holds it. Every piece has exactly one source\n   116\t  row (`old-1`: 5,390 rows for 5,390 pieces).\n   117\t- **The script exits non-zero when any check it names fails:** each store's day, classes and evidence; the budgets; each example; each\n   118\t  exact refusal; the forged value's identity; `v8`; each leak; the control; the closing. This run ended \"every acceptance item and\n   119\t  budget met\".\n   120\t\n   121\t**The decisive acceptance case** (council 74, `old-1`):\n   122\t- **Kept, each equal to the store and to its full text written into the script before the run:**\n   123\t  - Morningstar's $361 billion (`e2295`, under `v8`);\n   124\t  - the genuine \"Bullish confirmation\" quote (`e1865`, under `v4`, `v5`, `v8`);\n   125\t  - the analysts' \"$390 billion\" (`e3597`, under `v4`, `v5`).\n   126\t- **The system's own forecast** (`j1580` implied outcome, \"About $390 billion: …\"):\n   127\t  - substituted into `e2295`'s summary, it is refused with exactly \"question v8.evidence e2295.one_line: differs from the store\";\n   128\t  - added to the manifest, it is refused with exactly \"the manifest: keys off the allow-list ['note'], missing []\".\n   129\t\n   130\t**The other checks:**\n   131\t- **`old-1/v8`:** class `number`, marked \"Forecast unavailable\". Its 1,284 pieces of evidence are the same ids as `service.evidence` at\n   132\t  the bound.\n   133\t- **The known Yes/No leaks at their own days.**\n   134\t  - `old-3/v36` at 2026-08-25 (judgement 799) and `old-1/v10` at 2026-08-28 (judgement 865) are the latest judgements there, and\n   135\t    each package carries its own day (3,239 and 5,673 pieces of evidence).\n   136\t  - Both keep \"Yes\".\n   137\t  - The full explanation and reason texts are absent.\n   138\t  - So are the judgements' own phrases: \"around $1 trillion\", \"rung 4\", \"at rung\" and \"capex at rung\" occur in no field.\n   139\t- **Control:** event `old-1/v3` keeps \"Yes\" and its evidence, equal to the store.\n   140\t- **Closing,** on a copy of `old-1` with a closing switch for `v8`, \"due 2026-09-20, frozen on 2026-09-20 at rung 2 Bullish\":\n   141\t  - `bundle.view_bundle` exposes it;\n   142\t  - the package shows `open: false`;\n   143\t  - the reason appears nowhere.\n   144\t  - The word \"Bullish\" does occur inside six `v8` fields: five source titles and the genuine `e1865` quote. That is source wording,\n   145\t    which the design keeps.\n   146\t\n   147\t## 3. The diagnostic search, every hit read\n   148\t\n   149\tThe search covered every decoded string of each package, ids, classes, the marker and the manifest included. For each question it\n   150\ttook every stored string the package must not hold:\n   151\t- rung labels of number questions;\n   152\t- the rung conditions of every question;\n   153\t- judgement reasons, explanations, implied outcomes and references, where the store has those columns (the served ledger lacks the\n   154\t  last two);\n   155\t- every switch reason, \"created\" included.\n   156\t\n   157\t| Store | Stored strings judged | Package strings | Hits |\n   158\t|---|---|---|---|\n   159\t| old-1 | 6,670 | 91,012 | 1,378: \"created\" 987, \"Bullish\" 391 |\n   160\t| old-2 | 6,677 | 69,597 | 771: \"created\" 516, \"Bullish\" 255 |\n   161\t| old-3 | 7,045 | 73,514 | 1,613: \"created\" 1,176, labels 437 (\"Bullish\", \"High\", \"Low\", \"Bearish\", \"Middle\") |\n   162\t| served | 2,149 | 71,460 | 1,794: \"created\" 1,632, \"Bullish\" 162 |\n   163\t\n   164\t- **No condition, reason, explanation, implied outcome, reference or closing reason is found anywhere.**\n   165\t- **The label hits are 257 package fields holding 32 distinct texts, all read.** Every one is source wording:\n   166\t  - headlines: \"Jensen Huang's Bullish Call …\", \"Stock Traded Lower\", \"Earnings Call Highlights\", \"Lows Not Seen Since 2019\",\n   167\t    \"Sky-High P/E\", \"That Bearish Bet\";\n   168\t  - the memory term \"High Bandwidth Memory\";\n   169\t  - the analyst quote \"Bullish confirmation would require …\".\n   170\t- **The \"created\" hits fall in 33 distinct texts, all containing the ordinary word.** It is every question's creation reason and\n   171\t  carries no forecast.\n   172\t\n   173\t## 4. Not shown, and still open\n   174\t\n   175\t- **The reader's screen** (slice 2, D756's screen check) is not built. The release page must read only this package, with no live\n   176\t  fetch and no idea submission, and needs a browser check of the `old-1/v8` screen.\n   177\t- **The idea path in the release:** deferred (council 74); its acceptance is pending.\n   178\t- **The recorded disagreement on evidence summaries** (`RELEASE-BUILD.md` §8) stands.\n   179\t- **`store.open_read_only` puts a path into a SQLite URI unescaped.** That is shared POC code; the release refuses such paths\n   180\t  rather than changing it.\n   150\t    if isinstance(value, dict):\n   151\t        return [s for v in value.values() for s in strings(v)]\n   152\t    if isinstance(value, list):\n   153\t        return [s for v in value for s in strings(v)]\n   154\t    return [value] if isinstance(value, str) else []\n   155\t\n   156\t\n   157\tdef by_id(data):\n   158\t    return {q['id']: q for q in data['questions']}\n   159\t\n   160\t\n   161\tdef run(*args, cwd=None, timeout=120):\n   162\t    return subprocess.run([sys.executable, str(COMMAND), *map(str, args)], capture_output=True, text=True, cwd=cwd,\n   163\t                          env={**os.environ, 'PYTHONDONTWRITEBYTECODE': '1'}, timeout=timeout)\n   164\t\n   165\t\n   166\tdef build_package(stores, out, as_of=None):\n   167\t    views_db, items_db = service.open_ledger(str(stores[0])), store.open_read_only(str(stores[1]))\n   168\t    try:\n   169\t        data = release.release_export(views_db, items_db, as_of)\n   170\t        staged = release.stage(out)\n   171\t        release.write_package(data, staged)\n   172\t        release.check_package(staged, views_db, items_db, expected_as_of=data['as_of'])\n   173\t        release.publish(staged, out)\n   174\t        return data\n   175\t    finally:\n   176\t        views_db.close()\n   177\t        items_db.close()\n   178\t\n   179\t\n   180\tdef rewrite_data(package, data):\n   181\t    \"\"\"A copy of the package's data with its manifest hash refreshed, so every other check still passes.\"\"\"\n   182\t    payload = json.dumps(data, ensure_ascii=False, separators=(',', ':')).encode()\n   183\t    (package / release.DATA_FILE).write_bytes(payload)\n   184\t    manifest = json.loads((package / release.MANIFEST_FILE).read_text())\n   185\t    manifest.update(as_of=data['as_of'], data_sha256=hashlib.sha256(payload).hexdigest())\n   186\t    (package / release.MANIFEST_FILE).write_text(json.dumps(manifest))\n   187\t\n   188\t\n   189\tdef check(stores, package):\n   190\t    \"\"\"The counts of `check_package` with the stores.\"\"\"\n   191\t    views_db, items_db = service.open_ledger(str(stores[0])), store.open_read_only(str(stores[1]))\n   192\t    try:\n   193\t        return release.check_package(package, views_db, items_db)[0]\n   194\t    finally:\n   195\t        views_db.close()\n   196\t        items_db.close()\n   197\t\n   198\t\n   199\t# ---------- §6 tests 1–8: the export\n   200\t\n   201\t\n   202\tdef test_1_every_object_holds_exactly_its_record_types_keys(stores):\n   203\t    \"\"\"§1 ALLOWED, §6 test 1: the export passes the closed-set check; one added key fails it.\"\"\"\n   204\t    data = export(stores)\n   205\t    counts = release.check_export(data)\n   206\t    assert counts['questions'] == {'number': 5, 'event': 1, 'yes_no': 1} and counts['evidence'] == 5\n   207\t    assert set(by_id(data)['v1']) == NUMBER_KEYS and set(by_id(data)['v6']) == ANSWERED_KEYS\n   208\t    assert (data['format'], data['allow_list']) == ('hivemind-release/1', 'release-allow-list/1')     # revision 11's identifiers, literal\n   209\t    by_id(data)['v1']['condition'] = V1_CONDITIONS[1]\n   210\t    refused_with(lambda: release.check_export(data), \"question 0: keys off the allow-list ['condition'], missing []\")\n   211\t\n   212\t\n   213\tdef test_2_number_question_carries_only_the_marker_and_its_evidence(stores):\n   214\t    \"\"\"§6 test 2 (D726): no rung label, condition, reason, explanation or implied outcome of v1 reaches any decoded field.\"\"\"\n   215\t    data = export(stores)\n   216\t    v1 = by_id(data)['v1']\n   217\t    assert v1['class'] == 'number' and v1['forecast'] == MARKER\n   218\t    assert [e['id'] for e in v1['evidence']] == ['e1', 'e2', 'e4']\n   219\t    texts, own = strings(data), strings(v1)\n   220\t    for forbidden in [*V1_CONDITIONS, V1_REASONS, V1_WHY, 'About $390 billion']:\n   221\t        assert not any(forbidden in text for text in texts), forbidden\n   222\t    for label in ASSET_LABELS:                        # the selected label \"Bullish\" included; v1's own fields hold none\n   223\t        assert not any(label in text for text in own), label\n   224\t    allowed = {'Bullish': {('v5', 'e6', 'one_line'): E6_ONE_LINE, ('v5', 'e6', 'quote'): E6_QUOTE}}   # the fixture's genuine wording, by location\n   225\t    for label in ASSET_LABELS:\n   108\t  - any model call;\n   109\t  - commit, publish, deploy.\n   110\t\n   111\t## 1. What is built\n   112\t\n   113\t`src/hivemind/release.py` is the one owner, beside `service.py`.\n   114\t\n   115\t- **Constants:**\n   116\t  - `FORMAT = 'hivemind-release/1'`;\n   117\t  - `ALLOW_LIST = 'release-allow-list/1'`;\n   118\t  - `FORECAST_UNAVAILABLE = 'Forecast unavailable'`;\n   119\t  - `PACKAGE_FILES = {'manifest.json', 'release-data.json'}`.\n   120\t- **`ALLOWED`:** the closed key set per record type.\n   121\t\n   122\t  | Record | Keys |\n   123\t  |---|---|\n","exit_code":0,"status":"completed"}}
