r h in di['\\\\''hits'\\\\'']))\n    for h in di['\\\\''hits'\\\\'']:\n        distinct[h['\\\\''kind'\\\\'']].add(fs[h['\\\\''field'\\\\'']])\n        locations[h['\\\\''kind'\\\\'']].add((n,h['\\\\''field'\\\\'']))\nprint('\\\\''unique'\\\\'',[(k,len(v),len(locations[k])) for k,v in distinct.items()])\ndef decision(note):\n    ns=dict(g,out=out,results=r,packages=pack)\n    try:\n        with redirect_stdout(io.StringIO()): exec(d,ns)\n        print(note,'\\\\''PASS'\\\\'')\n    except SystemExit as e: print(note,e)\ndecision('\\\\''saved control'\\\\'')\nfor k,l in r['\\\\''leaks'\\\\''].items():\n    n=k.split('\\\\''/'\\\\'')[0]; day=k.split('\\\\''@'\\\\'')[1]\n    a,m=pkg(out/n/('\\\\''package-'\\\\''+day))\n    original=(a['\\\\''as_of'\\\\''],m['\\\\''as_of'\\\\''],sum(len(q['\\\\''evidence'\\\\'']) for q in a['\\\\''questions'\\\\'']))\n    assert original==(l['\\\\''package_as_of'\\\\''],l['\\\\''manifest_as_of'\\\\''],l['\\\\''evidence'\\\\''])\n    print(k,original)\n    sa,sm=pkg(out/n/'\\\\''package'\\\\'')\n    for fields in [('\\\\''package_as_of'\\\\'',),('\\\\''manifest_as_of'\\\\'',),('\\\\''package_as_of'\\\\'','\\\\''manifest_as_of'\\\\'','\\\\''evidence'\\\\'')]:\n        overlay=dict(package_as_of=sa['\\\\''as_of'\\\\''],manifest_as_of=sm['\\\\''as_of'\\\\''],evidence=sum(len(q['\\\\''evidence'\\\\'']) for q in sa['\\\\''questions'\\\\'']))\n        with patch.dict(l,{f:overlay[f] for f in fields}): decision(k+'\\\\'' '\\\\''+str(fields))\nread=Path.read_text\nfolder=out/'\\\\''old-1'\\\\''/'\\\\''package'\\\\''\nfor key,attr in [('\\\\''format'\\\\'','\\\\''FORMAT'\\\\''),('\\\\''allow_list'\\\\'','\\\\''ALLOW_LIST'\\\\'')]:\n    ver=pack['\\\\''old-1'\\\\''][key][:-1]+'\\\\''2'\\\\''\n    def changed(path,*args,**kwargs):\n        s=read(path,*args,**kwargs)\n        if path==folder/'\\\\''manifest.json'\\\\'':\n            m=json.loads(s);m[key]=ver;return json.dumps(m)\n        return s\n    with patch.object(Path,'\\\\''read_text'\\\\'',changed),patch.dict(pack['\\\\''old-1'\\\\''],{key:ver}),patch.object(g['\\\\''release'\\\\''],attr,ver):\n        decision('\\\\''module, data and manifest all '\\\\''+ver)'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
