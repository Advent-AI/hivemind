{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba calc_check.py | sed -n '184,263p;445,482p;551,582p'; nl -ba gate.py | sed -n '277,301p;421,457p'\"","aggregated_output":"   184\t\n   185\tdef check(family, passages, calc):\n   186\t    errors, recorded = [], []\n   187\t    figs = {}\n   188\t    for fig in calc['figures']:\n   189\t        if fig['id'] in figs:\n   190\t            errors.append(('C7', f'{fig[\"id\"]} is defined twice'))\n   191\t        figs[fig['id']] = fig\n   192\t\n   193\t    def refs(fig):\n   194\t        out = list(fig.get('inputs', []))\n   195\t        out += [r for r in fig.get('rests_on', []) if r in figs or r not in passages]\n   196\t        if fig.get('adjusts'):\n   197\t            out.append(fig['adjusts']['figure'])\n   198\t        if fig.get('bridge'):\n   199\t            out.append(fig['bridge'])\n   200\t        return out\n   201\t\n   202\t    # C7 structure: kinds, operations, dangling, cycles\n   203\t    for fig in figs.values():\n   204\t        if fig.get('kind') not in KINDS or fig.get('basis') not in BASES:\n   205\t            errors.append(('C7', f'{fig[\"id\"]}: kind {fig.get(\"kind\")} or basis {fig.get(\"basis\")} outside the closed set'))\n   206\t        if fig.get('kind') == 'computed' and fig.get('operation') not in OPERATIONS:\n   207\t            errors.append(('C7', f'{fig[\"id\"]}: operation {fig.get(\"operation\")} outside the closed set'))\n   208\t        elif fig.get('kind') == 'computed':\n   209\t            lo_n, hi_n = ARITY[fig['operation']]\n   210\t            if not lo_n <= len(fig.get('inputs', [])) <= hi_n:\n   211\t                errors.append(('C7', f'{fig[\"id\"]}: {fig[\"operation\"]} takes {lo_n}' + (f' to {hi_n}' if hi_n != lo_n else '')\n   212\t                                     + f' operands, not {len(fig.get(\"inputs\", []))}'))\n   213\t            signs = fig.get('signs')\n   214\t            if signs is not None and (fig['operation'] not in ('sum', 'roll_forward') or len(signs) != len(fig.get('inputs', []))\n   215\t                                      or any(x not in (1, -1) for x in signs)):\n   216\t                errors.append(('C7', f'{fig[\"id\"]}: signs must give one +1 or -1 per operand of a sum or roll_forward'))   # [46n]\n   217\t        for r in refs(fig):\n   218\t            if r not in figs:\n   219\t                errors.append(('C7', f'{fig[\"id\"]} refers to {r}, which is not defined'))\n   220\t    state = {}\n   221\t\n   222\t    def cyclic(fid):\n   223\t        if state.get(fid) == 1:\n   224\t            return True\n   225\t        if state.get(fid) == 2 or fid not in figs:\n   226\t            return False\n   227\t        state[fid] = 1\n   228\t        hit = any(cyclic(r) for r in refs(figs[fid]))\n   229\t        state[fid] = 2\n   230\t        return hit\n   231\t    if any(cyclic(fid) for fid in figs):\n   232\t        errors.append(('C7', 'the figure graph has a cycle'))\n   233\t    if errors:                                         # [46n] a malformed calculation is refused before any arithmetic\n   234\t        return {'errors': errors, 'recorded': recorded}\n   235\t\n   236\t    # C1 sources, prior pointers\n   237\t    for fig in figs.values():\n   238\t        if fig['kind'] == 'source':\n   239\t            errors += _source_errors(fig, passages)\n   240\t        if fig['kind'] == 'prior' and not fig.get('pointer'):\n   241\t            errors.append(('C7', f'{fig[\"id\"]}: a prior forecast needs an exact pointer to an earlier answer shown in the request'))\n   242\t\n   243\t    # C2 arithmetic and bound propagation\n   244\t    for fig in figs.values():\n   245\t        if fig['kind'] != 'computed' or fig.get('operation') not in OPERATIONS:\n   246\t            continue\n   247\t        ins = [figs[i] for i in fig['inputs'] if i in figs]\n   248\t        expected = _compute(fig['operation'], [_interval(i) + (i['unit'],) for i in ins], fig.get('signs'), fig['unit'])\n   249\t        lo, hi = _interval(fig)\n   250\t        if fig['operation'] == 'range_from_relative' or ('low' in fig):\n   251\t            ok = _close(lo, expected[0], fig['unit']) and _close(hi, expected[1], fig['unit'])\n   252\t        else:\n   253\t            ok = _close(lo, (expected[0] + expected[1]) / 2, fig['unit'])\n   254\t        if not ok:\n   255\t            errors.append(('C2', f'{fig[\"id\"]}: declared {lo}–{hi} but {fig[\"operation\"]} of {fig[\"inputs\"]} gives {expected[0]:.2f}–{expected[1]:.2f}'))\n   256\t        want = _bound_direction(fig['operation'], ins)\n   257\t        have = DIRECTION.get(fig.get('bound'))\n   258\t        if want is not None and have != want:\n   259\t            errors.append(('C2', f'{fig[\"id\"]}: its inputs make it a {want} bound, but it is declared {fig.get(\"bound\") or \"a point\"}'))\n   260\t        elif want is None and fig.get('bound'):\n   261\t            errors.append(('C2', f'{fig[\"id\"]}: its inputs are points, but it is declared a bound ({fig[\"bound\"]})'))\n   262\t\n   263\t    # C8 operand compatibility\n   445\t            bypass = [f for f in reachable(outcomes[view_id], stop=stop) if f not in stop and _key(figs[f]['what']) == want]\n   446\t            if bypass:\n   447\t                errors.append(('C4', f'{want}: {view_id} reaches {\", \".join(sorted(bypass))} without passing a forecast node ({\", \".join(sorted(stop))})'))\n   448\t    for rel in family.get('relations', []):           # [46j.2] the later member rests on the earlier member's forecast nodes, per scenario\n   449\t        if rel['type'] != 'same_base' or rel['later'] not in outcomes or rel['earlier'] not in outcomes:\n   450\t            continue\n   451\t        base_key = _key(members[rel['earlier']]['what'])\n   452\t        earlier_graph = _upstream_of(outcomes[rel['earlier']], figs, refs) | {outcomes[rel['earlier']]}\n   453\t        earlier_nodes = {f for f in earlier_graph if _key(figs[f]['what']) == base_key and figs[f]['basis'] == 'forecast'}\n   454\t        reached = reachable(outcomes[rel['later']], stop=earlier_nodes)\n   455\t        bypass = [f for f in reached if f not in earlier_nodes and _key(figs[f]['what']) == base_key]\n   456\t        later_key = _key(members[rel['later']]['what'])\n   457\t        by_scenario = {figs[n].get('scenario', 'base'): n for n in earlier_nodes if figs[n].get('scenario', 'base') != 'range'}\n   458\t        later_graph = _upstream_of(outcomes[rel['later']], figs, refs) | {outcomes[rel['later']]}\n   459\t        for f in sorted(later_graph):                 # [46k.1] every later scenario path reaches the earlier forecast of its own scenario\n   460\t            sc = figs[f].get('scenario', 'base')\n   461\t            if sc == 'range' or _key(figs[f]['what']) != later_key or figs[f]['basis'] != 'forecast':\n   462\t                continue\n   463\t            target = by_scenario.get(sc) or (next(iter(by_scenario.values())) if len(by_scenario) == 1 else None)\n   464\t            if target is None or target not in _determining(f, figs):       # [46l.1] through value-determining inputs only\n   465\t                errors.append(('C9', f'{f} ({sc}) of {rel[\"later\"]} is not computed from {rel[\"earlier\"]}\\'s {sc} forecast'))\n   466\t        later_scen = {figs[f].get('scenario', 'base') for f in later_graph if _key(figs[f]['what']) == later_key\n   467\t                      and figs[f]['basis'] == 'forecast' and figs[f].get('scenario', 'base') != 'range'}\n   468\t        if earlier_nodes and not later_scen:              # [46m.2] a citation never stands in for a calculation\n   469\t            errors.append(('C9', f'{rel[\"later\"]} has no calculation from {rel[\"earlier\"]}\\'s forecast, only a range resting on it'))\n   470\t        if len(by_scenario) > 1 and later_scen != set(by_scenario):     # [46l.1] the later member covers the earlier's scenarios\n   471\t            errors.append(('C9', f'{rel[\"later\"]} covers scenarios {sorted(later_scen)} but {rel[\"earlier\"]} covers {sorted(by_scenario)}'))\n   472\t        if not reached & earlier_nodes:\n   473\t            errors.append(('C9', f'{rel[\"later\"]} does not rest on {rel[\"earlier\"]}\\'s forecast ({\", \".join(sorted(earlier_nodes))})'))\n   474\t        if bypass:\n   475\t            errors.append(('C9', f'{rel[\"later\"]} reaches {\", \".join(sorted(bypass))} for {base_key} without {rel[\"earlier\"]}\\'s forecast'))\n   476\t    supplied = family.get('prior_answers', {})\n   477\t    for fig in figs.values():\n   478\t        earlier = fig['kind'] == 'prior' or fig.get('basis') == 'prior_forecast' or 'pointer' in fig   # [46i.2] derived, not labelled\n   479\t        if not earlier:\n   480\t            continue\n   481\t        if fig['kind'] != 'prior' or fig.get('basis') != 'prior_forecast':\n   482\t            errors.append(('C10', f'{fig[\"id\"]}: an earlier forecast must be kind prior with basis prior_forecast'))\n   551\t    \"\"\"The round's outcome from up to two attempts' decisions: a refusal is retried once; two refusals make the family unresolved.\"\"\"\n   552\t    if attempts[0] != 'refused':\n   553\t        return attempts[0]\n   554\t    if len(attempts) > 1 and attempts[1] != 'refused':\n   555\t        return attempts[1]\n   556\t    return 'unresolved'\n   557\t\n   558\t\n   559\tdef _determining(fid, figs):\n   560\t    \"\"\"The figures that determine fid's value: computed inputs only, at any depth (an estimate's rests_on explains, it does not compute).\"\"\"\n   561\t    seen_ids, stack = set(), list(figs[fid].get('inputs', [])) if figs[fid]['kind'] == 'computed' else []\n   562\t    while stack:\n   563\t        f = stack.pop()\n   564\t        if f in seen_ids or f not in figs:\n   565\t            continue\n   566\t        seen_ids.add(f)\n   567\t        if figs[f]['kind'] == 'computed':\n   568\t            stack.extend(figs[f].get('inputs', []))\n   569\t    return seen_ids\n   570\t\n   571\t\n   572\tdef _upstream_of(fid, figs, refs):\n   573\t    \"\"\"The figures that fid's own value is computed from (fid excluded).\"\"\"\n   574\t    seen_ids, stack = set(), list(refs(figs[fid]))\n   575\t    while stack:\n   576\t        f = stack.pop()\n   577\t        if f in seen_ids or f not in figs:\n   578\t            continue\n   579\t        seen_ids.add(f)\n   580\t        stack.extend(refs(figs[f]))\n   581\t    return seen_ids\n   582\t\n   277\t\n   278\t\n   279\tMANIFEST = {}\n   280\t\n   281\t\n   282\tdef run():\n   283\t    rows = []\n   284\t\n   285\t    def item(name, family, passages, calc, ok, why):\n   286\t        MANIFEST[name] = {'family': family, 'calc': calc}\n   287\t        try:\n   288\t            result = cc.check(family, passages, calc)\n   289\t        except Exception as error:                    # a crash is a miss with its reason, never a silent stop of the gate\n   290\t            rows.append((name, False, f'CRASH {type(error).__name__}: {error}', {'errors': [], 'recorded': []}))\n   291\t            return\n   292\t        verdict, note = ok(result)\n   293\t        rows.append((name, verdict, note, result))\n   294\t\n   295\t    item('R1a', R1_FAMILY, R1_PASSAGES, r1('a'),\n   296\t         lambda r: ('C3' in codes(r) and any('FY2027 Q4' in d for c, d in r['errors'] if c == 'C3'), 'C3 on Q4'), '')\n   297\t    item('R1b', R1_FAMILY, R1_PASSAGES, r1('b'),\n   298\t         lambda r: ('C4' in codes(r) and 'C3' not in codes(r) and any('FY2027 Q3' in d and 'g3' in d for c, d in r['errors'] if c == 'C4'),\n   299\t                    'C4 on the Q3 bypass, no C3'), '')\n   300\t    item('R1c', R1_FAMILY, R1_PASSAGES, r1('c'), lambda r: (not r['errors'], 'passes'), '')\n   301\t    item('R2', R2_FAMILY, R2_PASSAGES, r2(),\n   421\t    g24d['figures'] = [f for f in g24d['figures'] if f['id'] != 'g28hi']\n   422\t    next(f for f in g24d['figures'] if f['id'] == 'g28')['rests_on'] = ['g28lo', 'i256', 'i173']\n   423\t    item('G24d', f24, G_PASSAGES, g24d, lambda r: (any(c == 'C9' and 'covers' in d for c, d in r['errors']), 'C9: the high path missing'), '')\n   424\t    g24c = copy.deepcopy(c24)                         # [46l.1] the high path computed from FY2028 consensus, q01's high only cited\n   425\t    g24c['figures'] = [f for f in g24c['figures'] if f['id'] != 'g28hi'] + [\n   426\t        est('g28hi', 612.79, 'USD bn', W('NVIDIA', 'revenue', CO, 'FY2028'), 'consensus, adjusted', ['gc554', 'gfyhi'], scenario='high')]\n   427\t    item('G24c', f24, G_PASSAGES, g24c, lambda r: (any(c == 'C9' and 'g28hi' in d for c, d in r['errors']), 'C9: q01 only cited, not computed'), '')\n   428\t    g24c3 = copy.deepcopy(c24)                        # [46m.1] q01's high forecast in an unused third operand\n   429\t    next(f for f in g24c3['figures'] if f['id'] == 'g28hi').update(inputs=['gc554', 'g41', 'gfyhi'], value=781.14)\n   430\t    item('G24c3', f24, G_PASSAGES, g24c3, lambda r: (any(c == 'C7' and 'operands' in d for c, d in r['errors']), 'C7: an operand the arithmetic ignores'), '')\n   431\t    g24s1 = copy.deepcopy(c24)                        # [46n] a sum whose short signs list drops q01's path\n   432\t    g24s1['figures'] = [f for f in g24s1['figures'] if f['id'] != 'g28hi'] + [\n   433\t        comp('g28hi', 'sum', ['gc554', 'gfyhi'], 554.0, 'USD bn', W('NVIDIA', 'revenue', CO, 'FY2028'), scenario='high', signs=[1])]\n   434\t    item('G24s1', f24, G_PASSAGES, g24s1, lambda r: (any(c == 'C7' and 'signs' in d for c, d in r['errors']), 'C7: a short signs list'), '')\n   435\t    g24s0 = copy.deepcopy(c24)                        # [46n] a zero sign\n   436\t    g24s0['figures'] = [f for f in g24s0['figures'] if f['id'] != 'g28hi'] + [\n   437\t        comp('g28hi', 'sum', ['gc554', 'gfyhi'], 554.0, 'USD bn', W('NVIDIA', 'revenue', CO, 'FY2028'), scenario='high', signs=[1, 0])]\n   438\t    item('G24s0', f24, G_PASSAGES, g24s0, lambda r: (any(c == 'C7' and 'signs' in d for c, d in r['errors']), 'C7: a zero sign'), '')\n   439\t    g24a1 = copy.deepcopy(c24)                        # [46n] one operand for apply_growth: refused, not a crash\n   440\t    next(f for f in g24a1['figures'] if f['id'] == 'g28hi')['inputs'] = ['gfyhi']\n   441\t    item('G24a1', f24, G_PASSAGES, g24a1, lambda r: (any(c == 'C7' and 'operands' in d for c, d in r['errors']), 'C7: one operand, no crash'), '')\n   442\t    f4c, c4c = g4()                                   # [46m.2] the single-scenario calculation removed, q01 only cited\n   443\t    c4c['figures'] = [f for f in c4c['figures'] if f['id'] != 'gfy28c']\n   444\t    next(f for f in c4c['figures'] if f['id'] == 'gfy28')['rests_on'] = ['gfy', 'i256', 'i173']\n   445\t    item('G4c', f4c, G_PASSAGES, c4c, lambda r: (any(c == 'C9' and 'no calculation' in d for c, d in r['errors']), 'C9: a citation for a calculation'), '')\n   446\t    p3e = copy.deepcopy(p3a)\n   447\t    p3e['answers'][0]['outcome'] = 'pri'\n   448\t    p3e['answers'][0]['reference'] = {'figure': 'gc392'}\n   449\t    item('P3e', f1p, G_PASSAGES, p3e, lambda r: (any(c == 'C10' and 'current outcome' in d for c, d in r['errors']), 'C10: a prior as the outcome'), '')\n   450\t    p3d = copy.deepcopy(p3a)\n   451\t    p3d['answers'][0]['reference'] = {'figure': 'pri', 'unavailable': 'no consensus supplied'}\n   452\t    item('P3d', f1p, G_PASSAGES, p3d, lambda r: (any(c == 'C5' and 'exactly one' in d for c, d in r['errors']), 'C5: both a figure and unavailable'), '')\n   453\t    p3c = copy.deepcopy(p3a)\n   454\t    next(f for f in p3c['figures'] if f['id'] == 'pri')['value'] = 431.0\n   455\t    item('P3c', f1p, G_PASSAGES, p3c, lambda r: ('C10' in codes(r), 'C10: a prior figure the earlier answer does not state'), '')\n   456\t    p3b = copy.deepcopy(c1)\n   457\t    p3b['figures'].append(est('wrap', 425.0, 'USD bn', W('NVIDIA', 'revenue', CO, 'FY2027'), 'our earlier forecast, close to the Street', ['gc392']))\n","exit_code":0,"status":"completed"}}
