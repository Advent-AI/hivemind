{"type":"item.started","item":{"id":"item_7","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"python3 -B -c '\nimport pathlib,json,io,contextlib,copy,types\nimport gate as g, calc_check as c, render_v13 as r, mutants\ndef replay(func, log):\n    p=io.StringIO()\n    with contextlib.redirect_stdout(p): status=func()\n    assert status==0 and p.getvalue()==pathlib.Path(log).read_text()\nreplay(g.main,'\\\\''gate-run11.txt'\\\\'')\nassert g.MANIFEST==json.loads(pathlib.Path('\\\\''gate-run11.fixtures.json'\\\\'').read_text())\nreplay(r.main,'\\\\''render-r1.txt'\\\\'')\noriginal=g.cc\npath=pathlib.Path('\\\\''calc_check.py'\\\\'')\nsrc=path.read_text()\nfor name,old,new,target in mutants.MUTANTS:\n    g.cc=original\n    if old:\n        assert src.count(old)==1,name\n        mod=types.ModuleType('\\\\''in_memory_calc_check'\\\\'')\n        exec(compile(src.replace(old,new),str(path),'\\\\''exec'\\\\''),mod.__dict__)\n        g.cc=mod\n    misses={name for name,ok,_,_ in g.run() if not ok}\n    assert (target in misses if target else not misses),(name,misses)\ng.cc=original\nprint('\\\\''57 gate items, 25 mutants and stored render reproduced'\\\\'')\ndef fig(calc,fid):\n    return next(f for f in calc['\\\\''figures'\\\\''] if f['\\\\''id'\\\\'']==fid)\ndef check(name,v):\n    fam,x=v['\\\\''family'\\\\''],v['\\\\''calc'\\\\'']\n    schema=r.v13_schema(list(fam['\\\\''members'\\\\'']),list(g.G_PASSAGES),[])\n    strict=r.strict(x,schema)\n    err=r.model.check_schema(strict,schema)\n    try:\n        finding=c.check(fam,g.G_PASSAGES,r.without_nulls(strict))['\\\\''errors'\\\\'']\n    except Exception as ex:\n        import traceback\n        frame=traceback.extract_tb(ex.__traceback__)[-1]\n        finding=f'\\\\''{type(ex).__name__} {ex} at {pathlib.Path(frame.filename).name}:{frame.lineno}'\\\\''\n    print(name,err,finding)\norig_compute=c._compute\ndef must_not_compute(*args,**kwargs):\n    raise AssertionError('\\\\''arithmetic ran before structural refusal'\\\\'')\nc._compute=must_not_compute\nfor label in ('\\\\''G24s1'\\\\'','\\\\''G24s0'\\\\'','\\\\''G24a1'\\\\''):\n    check(label,g.MANIFEST[label])\nc._compute=orig_compute\nv=copy.deepcopy(g.MANIFEST['\\\\''G24'\\\\''])\nx=v['\\\\''calc'\\\\'']\nhi=fig(x,'\\\\''g28hi'\\\\'')\nbase_math=copy.deepcopy(hi)\nbase_math['\\\\''id'\\\\'']='\\\\''base_math'\\\\''\nx['\\\\''figures'\\\\''].append(base_math)\nhi.update(operation='\\\\''sum'\\\\'',inputs=['\\\\''gc554'\\\\'','\\\\''base_math'\\\\'','\\\\''base_math'\\\\''],signs=[1,1,-1],value=554.0)\ncheck('\\\\''G24 high applies +1 and -1 to the same earlier-base calculation'\\\\'',v)\nv=copy.deepcopy(g.MANIFEST['\\\\''G24'\\\\''])\nfig(v['\\\\''calc'\\\\''],'\\\\''g28hi'\\\\'').pop('\\\\''value'\\\\'')\ncheck('\\\\''G24 high computed node missing number'\\\\'',v)\nv=copy.deepcopy(g.MANIFEST['\\\\''G24'\\\\''])\nfig(v['\\\\''calc'\\\\''],'\\\\''g28hi'\\\\'').update(low=620.0,high=610.0)\ncheck('\\\\''G24 high computed node with reversed endpoints'\\\\'',v)\n'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
