{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"cd docs/research/2026-11-22-number-answers && { nl -ba paid_gate.py | sed -n '1,255p'; }\"","aggregated_output":"     1\t\"\"\"The paid gate of judging-v13 (D725's registered test; D729, D730). Harness-only; nothing here is product code.\n     2\t\n     3\t  python3 paid_gate.py plan <out.json>                        # $0: build every request from the stored runs and check them\n     4\t  python3 paid_gate.py send <new out folder> <ceiling>        # paid: only at the ceiling Alex names (APPROVED_CEILING)\n     5\t  python3 paid_gate.py packets <out folder> <key folder>      # $0: blind reading packets, the arm hidden; the key kept outside the repo\n     6\t  python3 paid_gate.py verdict <out folder> <readings.json> <key folder>   # $0: the registered pass and stop lines\n     7\t\n     8\tThe test (D725, RESULT.md): the 09-20 total and Data Center pair in each of three stored draws, judged jointly (one v13 family call)\n     9\tand separately (each member alone, the same union of evidence, the same v13 format), three samples each; plus three samples each of\n    10\tthe O, S and E singletons. 9 + 18 + 9 = 36 first attempts. A calculation the checks refuse is retried once with its errors; a second\n    11\trefusal makes the unit unresolved. The separate arm's two answers are then reconciled by the same checks over the pair's family.\n    12\t\"\"\"\n    13\timport hashlib\n    14\timport json\n    15\timport random\n    16\timport re\n    17\timport secrets\n    18\timport sqlite3\n    19\timport sys\n    20\timport threading\n    21\tfrom pathlib import Path\n    22\t\n    23\tHERE = Path(__file__).resolve().parent\n    24\tREPO = HERE.parents[2]\n    25\tsys.path.insert(0, str(HERE))\n    26\tsys.path.insert(0, str(REPO / 'src'))\n    27\timport calc_check as cc                                                 # noqa: E402\n    28\timport calc_small as cs                                                 # noqa: E402\n    29\timport render_v13 as rv                                                 # noqa: E402\n    30\tfrom hivemind import config, model                                      # noqa: E402\n    31\t\n    32\tRUN = REPO / 'poc/data/comparison-2026-11-17/run'\n    33\tCONFIG = REPO / 'poc/config/poc-v118.json'                              # its re-judging model setting: gpt-6-luna, medium, 16000 output tokens\n    34\tSYSTEM = (HERE / 'judging-v13-draft.txt').read_text()\n    35\tSYSTEM_S = (HERE / 'judging-v13s.txt').read_text()                      # the small format (D737): one sentence changed\n    36\tCHECKERS = {None: cc, 'v13': cc, 'v13s': cs}\n    37\tAPPROVED_CEILING = 0.5                                                  # Alex, 2026-11-22 (D732): \"0.5 美元 (推荐)\"\n    38\tPINNED_PLAN_SHA256 = (HERE / 'paid-plan.sha256').read_text().strip() if (HERE / 'paid-plan.sha256').exists() else None\n    39\tAUTH = Path.home() / '.hivemind-keys/v13-paid-gate/authorization.json'\n    40\t# D753: Alex's one-time exception, a v13s re-send. Its own reviewed plan pin and its own one-time authorization; the v13 ones stay.\n    41\tPINNED_PLAN_V13S = (HERE / 'paid-plan-v13s.sha256').read_text().strip() if (HERE / 'paid-plan-v13s.sha256').exists() else None\n    42\tAUTH_V13S = Path.home() / '.hivemind-keys/v13s-paid-gate/authorization.json'\n    43\tDRAWS = (1, 2, 3)\n    44\tRETRY_MARK = '\\n\\nThe code refused the previous answer because: '\n    45\tPAIRS = [('old-1', ('v4', 9014), ('v8', 9022)), ('old-2', ('v14', 8729), ('v9', 8737)), ('old-3', ('v3', 9183), ('v35', 9177))]\n    46\tSINGLETONS = [('O', 'old-2', 'v29', 8734, ('NVIDIA', 'equity investment commitments', 'company', 'end of FY2027')),\n    47\t              ('S', 'old-2', 'v6', 8595, ('four largest AI hyperscalers', 'data-center capex', 'combined', 'CY2027')),\n    48\t              ('E', 'old-3', 'v41', 9166, ('NVIDIA', 'revenue', 'Vera CPU', 'FY2028'))]\n    49\t\n    50\t\n    51\tdef W(population, measure, scope, period):\n    52\t    return {'population': population, 'measure': measure, 'scope': scope, 'period': period}\n    53\t\n    54\t\n    55\tdef bands(draw, view_id):\n    56\t    conn = sqlite3.connect(f'file:{RUN / draw / \"prod/views.sqlite\"}?mode=ro', uri=True)\n    57\t    rows = conn.execute('select lo, hi from rungs where view_id=? order by position', (view_id,)).fetchall()\n    58\t    return [[lo / 1e9 if lo is not None else None, hi / 1e9 if hi is not None else None] for lo, hi in rows]\n    59\t\n    60\t\n    61\tdef passages(draw, evidence_ids):\n    62\t    \"\"\"What each request showed of a passage: the quote cut at 400 characters (judging._lines_english).\"\"\"\n    63\t    conn = sqlite3.connect(f'file:{RUN / draw / \"prod/views.sqlite\"}?mode=ro', uri=True)\n    64\t    rows = conn.execute(f'select evidence_id, quote, speaker from evidence where evidence_id in ({\",\".join(\"?\" * len(evidence_ids))})',\n    65\t                        evidence_ids).fetchall()\n    66\t    return {e: {'text': (q or '')[:400], 'speaker': s} for e, q, s in rows}\n    67\t\n    68\t\n    69\tdef pair_family(draw, total, dc):\n    70\t    return {'members': {total[0]: {'what': W('NVIDIA', 'revenue', 'company', 'FY2027'), 'bands': bands(draw, total[0])},\n    71\t                        dc[0]: {'what': W('NVIDIA', 'revenue', 'Data Center', 'FY2027'), 'bands': bands(draw, dc[0])}},\n    72\t            'relations': [{'type': 'part_of', 'part': dc[0], 'whole': total[0]}],\n    73\t            'shared': [W('NVIDIA', 'revenue', 'company', 'FY2027 Q3'), W('NVIDIA', 'revenue', 'company', 'FY2027 Q4')],\n    74\t            'compare_periods': ['FY2027 Q3', 'FY2027 Q4', 'FY2027']}\n    75\t\n    76\t\n    77\tdef only(family, view_id):\n    78\t    out = {'members': {view_id: family['members'][view_id]}, 'relations': [], 'shared': family['shared'], 'compare_periods': []}\n    79\t    if 'part_scopes' in family:                                         # [53] the separate arm keeps S8's part-of scopes (D738)\n    80\t        out['part_scopes'] = family['part_scopes']\n    81\t    return out\n    82\t\n    83\t\n    84\tdef small_family(family, part_scopes=(), notes=None):\n    85\t    \"\"\"[D737] A family for the small format: each member's unit (USD bn: the bands are in billions), the part-of scopes S8 reads, and\n    86\t    any note on a member's key.\"\"\"\n    87\t    out = json.loads(json.dumps(family))\n    88\t    for v, m in out['members'].items():\n    89\t        m['unit'] = 'USD bn'\n    90\t        if notes and v in notes:\n    91\t            m['key_note'] = notes[v]\n    92\t    out['part_scopes'] = list(part_scopes)\n    93\t    return out\n    94\t\n    95\t\n    96\tPAIR_SCOPES = [{'population': 'NVIDIA', 'measure': 'revenue', 'part': 'Data Center', 'whole': 'company'}]\n    97\tO_NOTE = 'the balance at the end of FY2027, as the FY2027 annual report publishes it'\n    98\t\n    99\t\n   100\tdef checker(fmt):\n   101\t    return CHECKERS[fmt]\n   102\t\n   103\t\n   104\tdef decode(data, fmt, family):\n   105\t    \"\"\"The stored wire answer in the shape the checks and packets read, by the plan's format.\"\"\"\n   106\t    return cs.from_answer(data, family) if fmt == 'v13s' else strip(data)\n   107\t\n   108\t\n   109\tdef questions(draw, view_ids):\n   110\t    conn = sqlite3.connect(f'file:{RUN / draw / \"prod/views.sqlite\"}?mode=ro', uri=True)\n   111\t    out = {}\n   112\t    for v in view_ids:\n   113\t        q = conn.execute('select question from views where view_id=?', (v,)).fetchone()[0]\n   114\t        ladder = [c for (c,) in conn.execute('select condition from rungs where view_id=? order by position', (v,))]\n   115\t        out[v] = {'question': q, 'ladder': ladder}\n   116\t    return out\n   117\t\n   118\t\n   119\tdef shown_lines(user):\n   120\t    \"\"\"Each evidence item exactly as the request showed it: its header line (tier, speaker, original source and date) and its quote.\"\"\"\n   121\t    m = re.search(r'\\[Evidence in view for the family, \\d+ items\\]\\n(.*?)(?:\\n\\n\\[|\\n\\nAnswer per)', user, re.S)\n   122\t    out = {}\n   123\t    for chunk in re.split(r'\\n(?=- e\\d+ )', m.group(1) if m else ''):\n   124\t        if chunk.startswith('- e'):\n   125\t            out[chunk[2:].split(' ', 1)[0]] = chunk\n   126\t    return out\n   127\t\n   128\t\n   129\tdef item(unit, arm, draw, calls, family, shown, fmt='v13'):\n   130\t    archive = RUN / draw / 'prod/archive.sqlite'\n   131\t    if fmt == 'v13s':\n   132\t        user, evidence_ids, theme_ids = rv.render(archive, calls, family, shown=shown, fmt='v13s')\n   133\t        return {'unit': unit, 'arm': arm, 'draw_store': draw, 'members': sorted(shown), 'format': 'v13s', 'system': SYSTEM_S, 'user': user,\n   134\t                'schema': rv.v13s_schema(sorted(shown), evidence_ids, theme_ids), 'family': family, 'passages': passages(draw, evidence_ids),\n   135\t                'evidence_ids': evidence_ids, 'questions': questions(draw, sorted(shown)), 'shown': shown_lines(user)}\n   136\t    user, evidence_ids, theme_ids = rv.render(archive, calls, family, shown=shown)\n   137\t    return {'unit': unit, 'arm': arm, 'draw_store': draw, 'members': sorted(shown), 'system': SYSTEM, 'user': user,\n   138\t            'schema': rv.v13_schema(sorted(shown), evidence_ids, theme_ids), 'family': family, 'passages': passages(draw, evidence_ids),\n   139\t            'evidence_ids': evidence_ids, 'questions': questions(draw, sorted(shown)), 'shown': shown_lines(user)}\n   140\t\n   141\t\n   142\tdef build_plan(fmt='v13'):\n   143\t    items = []\n   144\t    small = fmt == 'v13s'\n   145\t    for draw, total, dc in PAIRS:\n   146\t        family = pair_family(draw, total, dc)\n   147\t        if small:\n   148\t            family = small_family(family, PAIR_SCOPES)\n   149\t        calls = [total, dc]\n   150\t        items.append(item(f'pair-{draw}', 'joint', draw, calls, family, [total[0], dc[0]], fmt))\n   151\t        for member in (total, dc):                            # the same union of evidence, one member's header and answer\n   152\t            items.append(item(f'pair-{draw}', f'separate-{member[0]}', draw, calls, only(family, member[0]), [member[0]], fmt))\n   153\t    for name, draw, view_id, call_id, what in SINGLETONS:\n   154\t        family = {'members': {view_id: {'what': W(*what), 'bands': bands(draw, view_id)}}, 'relations': [], 'shared': [], 'compare_periods': []}\n   155\t        if small:\n   156\t            family = small_family(family, notes={view_id: O_NOTE} if name == 'O' else None)\n   157\t        items.append(item(f'single-{name}', 'single', draw, [(view_id, call_id)], family, [view_id], fmt))\n   158\t    return items\n   159\t\n   160\t\n   161\tdef plan(out, fmt='v13'):\n   162\t    items = build_plan(fmt)\n   163\t    report = []\n   164\t    for it in items:\n   165\t        missing = sorted(set(it['evidence_ids']) - set(it['passages']))\n   166\t        report.append(f'{it[\"unit\"]:14} {it[\"arm\"]:14} members {it[\"members\"]} user {len(it[\"user\"])} chars, evidence {len(it[\"evidence_ids\"])}, '\n   167\t                      f'schema {len(json.dumps(it[\"schema\"]))} chars, passages missing {missing or \"none\"}')\n   168\t        if missing or 'Outcome keys' not in it['user']:\n   169\t            raise SystemExit(f'{it[\"unit\"]} {it[\"arm\"]}: incomplete request; not planned')\n   170\t    ids = [(i['unit'], i['arm']) for i in items]\n   171\t    if len(set(ids)) != len(ids):\n   172\t        raise SystemExit('duplicate (unit, arm) in the plan; not planned')\n   173\t    text = json.dumps(items, indent=1)\n   174\t    Path(out).write_text(text)\n   175\t    Path(out).with_suffix('.sha256').write_text(hashlib.sha256(text.encode()).hexdigest() + '\\n')\n   176\t    print('\\n'.join(report))\n   177\t    print(f'{len(items)} requests x {len(DRAWS)} draws = {len(items) * len(DRAWS)} first attempts')\n   178\t\n   179\t\n   180\tdef strip(data):\n   181\t    return rv.without_nulls(data)\n   182\t\n   183\t\n   184\tclass Gate:\n   185\t    def __init__(self, out, transport, ledger=None):\n   186\t        self.out, self.transport, self.ledger = out, transport, ledger\n   187\t        self.cfg = config.load(str(CONFIG))\n   188\t        self.lock = threading.Lock()\n   189\t        (out / 'archives').mkdir(parents=True, exist_ok=True)\n   190\t\n   191\t    def request(self, it, user):\n   192\t        return model.build_request(self.cfg.rejudging, it['system'], user, it['schema'], 'judgement', self.cfg.provider)\n   193\t\n   194\t    def record(self, line):\n   195\t        \"\"\"[47g] Scored first attempts go to answers.jsonl, diagnostic retries to retries.jsonl, so damage to a retry's record can be\n   196\t        seen without touching the scored record.\"\"\"\n   197\t        name = 'answers.jsonl' if line['attempt'] == 1 else 'retries.jsonl'\n   198\t        with self.lock, open(self.out / name, 'a') as handle:\n   199\t            handle.write(json.dumps(line, ensure_ascii=False) + '\\n')\n   200\t\n   201\t    def attempt(self, it, draw, user, n):\n   202\t        name = f'{it[\"unit\"]}-{it[\"arm\"]}-d{draw}-a{n}.sqlite'\n   203\t        archive = model.Archive(str(self.out / 'archives' / name))\n   204\t        line = {'unit': it['unit'], 'arm': it['arm'], 'draw': draw, 'attempt': n,\n   205\t                'request_sha256': model.request_identity(self.request(it, user))[1]}\n   206\t        self.record(dict(line, status='started'))                          # [47.3] recorded before the provider is called\n   207\t        data = None\n   208\t        try:\n   209\t            answer = model.call(archive, self.cfg, self.cfg.rejudging, it['system'], user, it['schema'], 'judgement', 'judge', transport=self.transport)\n   210\t            data = answer.data\n   211\t            line.update(cost_usd=answer.cost_usd, data=data)\n   212\t            fmt = it.get('format')\n   213\t            calc = decode(data, fmt, it['family'])\n   214\t            result = checker(fmt).check(it['family'], it['passages'], calc)\n   215\t            decision = checker(fmt).publish_decision(it['family'], calc, result)\n   216\t            line.update(status='answered', errors=result['errors'], recorded=result['recorded'], published=result.get('published'), decision=decision)\n   217\t        except model.SchemaError as error:\n   218\t            row = archive.conn.execute('select response_json from model_calls order by call_id desc limit 1').fetchone()\n   219\t            line.update(status='format invalid', error=str(error)[:500], decision='refused', errors=[('schema', str(error)[:300])],\n   220\t                        raw=row[0] if row and row[0] else None)           # [47f.2] whole, as the archive stores it\n   221\t        except model.TransportError as error:\n   222\t            line.update(status='transport error', error=str(error)[:500], decision='transport')\n   223\t        except Exception as error:                                       # [47.3] a checker failure is recorded with the raw answer and refused\n   224\t            line.update(status='checker error', error=f'{type(error).__name__}: {error}'[:500], decision='refused',\n   225\t                        errors=[('checker', f'{type(error).__name__}: {error}'[:300])], data=data)\n   226\t        self.record(line)\n   227\t        return line\n   228\t\n   229\t    def stopped(self):\n   230\t        return self.ledger is not None and self.ledger.read().get('stopped')\n   231\t\n   232\t    def run(self, items):\n   233\t        \"\"\"[47f.1] Every first attempt (the scored ones) is sent before any retry (diagnostic only), so a retry's cost or failure can\n   234\t        never stop a scored attempt from being sent.\"\"\"\n   235\t        try:\n   236\t            refused = []\n   237\t            for draw in DRAWS:\n   238\t                for it in items:\n   239\t                    if not self.stopped():\n   240\t                        first = self.attempt(it, draw, it['user'], 1)\n   241\t                        if first['decision'] == 'refused':\n   242\t                            refused.append((it, draw, first))\n   243\t            for it, draw, first in refused:\n   244\t                if not self.stopped():\n   245\t                    reasons = '; '.join(f'{c}: {d}' for c, d in first.get('errors', []))[:4000]\n   246\t                    self.attempt(it, draw, it['user'] + RETRY_MARK + reasons, 2)\n   247\t        finally:                                          # [47b.2] the results come from the attempt records, written even after an abort\n   248\t            summary = summarise(self.out, items, self.ledger.read() if self.ledger else None)\n   249\t        return summary\n   250\t\n   251\t\n   252\tJOURNALS = ('answers.jsonl', 'retries.jsonl')\n   253\t\n   254\t\n   255\tdef attempt_records(out, damaged=None):\n","exit_code":0,"status":"completed"}}
