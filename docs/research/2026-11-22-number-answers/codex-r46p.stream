{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba calc_check.py | sed -n '105,150p;183,267p;446,503p;559,658p'\"","aggregated_output":"   105\tdef _interval(fig):\n   106\t    if 'low' in fig and 'high' in fig:\n   107\t        return fig['low'], fig['high']\n   108\t    return fig['value'], fig['value']\n   109\t\n   110\t\n   111\tdef _compute(op, inputs, signs, out_unit=None):\n   112\t    \"\"\"inputs: [(lo, hi, unit)]; returns (lo, hi) in out_unit.\"\"\"\n   113\t    los = [i[0] for i in inputs]\n   114\t    his = [i[1] for i in inputs]\n   115\t    if op in ('sum', 'roll_forward'):\n   116\t        s = signs or [1] * len(inputs)\n   117\t        return (sum((a if k > 0 else b) * k for a, b, k in zip(los, his, s)), sum((b if k > 0 else a) * k for a, b, k in zip(los, his, s)))\n   118\t    if op == 'difference':\n   119\t        return los[0] - his[1], his[0] - los[1]\n   120\t    if op == 'product':\n   121\t        lo = hi = 1.0\n   122\t        for a, b in zip(los, his):\n   123\t            lo, hi = lo * a, hi * b\n   124\t        units = [i[2] for i in inputs]\n   125\t        if 'units' in units and 'USD' in units and out_unit == 'USD bn':     # units times a dollar price, in billions\n   126\t            lo, hi = lo / 1e9, hi / 1e9\n   127\t        return lo, hi\n   128\t    if op == 'ratio':\n   129\t        units = [i[2] for i in inputs]\n   130\t        if 'USD' in units and 'USD bn' in units:                # a dollar total over a per-unit price\n   131\t            los = [x * 1e9 if u == 'USD bn' else x for x, u in zip(los, units)]\n   132\t            his = [x * 1e9 if u == 'USD bn' else x for x, u in zip(his, units)]\n   133\t        return los[0] / his[1], his[0] / los[1]\n   134\t    if op == 'share':\n   135\t        return los[0] * los[1] / 100.0, his[0] * his[1] / 100.0\n   136\t    if op == 'growth':\n   137\t        return (los[1] / his[0] - 1) * 100.0, (his[1] / los[0] - 1) * 100.0\n   138\t    if op == 'apply_growth':\n   139\t        return los[0] * (1 + los[1] / 100.0), his[0] * (1 + his[1] / 100.0)\n   140\t    if op == 'range_from_relative':\n   141\t        return los[0] * (1 - los[1] / 100.0), his[0] * (1 + his[1] / 100.0)\n   142\t    raise ValueError(op)\n   143\t\n   144\t\n   145\tDIRECTION = {'>': 'lower', '>=': 'lower', 'approx_above': 'lower', '<': 'upper', '<=': 'upper', 'approx_below': 'upper',\n   146\t             'approx': 'two-sided', None: None}\n   147\tFLIP = {'lower': 'upper', 'upper': 'lower', 'two-sided': 'two-sided', None: None}\n   148\t\n   149\t\n   150\tdef _bound_direction(op, ins):\n   183\t\n   184\t\n   185\tdef check(family, passages, calc):\n   186\t    errors, recorded = [], []\n   187\t    figs = {}\n   188\t    for fig in calc['figures']:\n   189\t        if fig['id'] in figs:\n   190\t            errors.append(('C7', f'{fig[\"id\"]} is defined twice'))\n   191\t        figs[fig['id']] = fig\n   192\t\n   193\t    def refs(fig):\n   194\t        out = list(fig.get('inputs', []))\n   195\t        out += [r for r in fig.get('rests_on', []) if r in figs or r not in passages]\n   196\t        if fig.get('adjusts'):\n   197\t            out.append(fig['adjusts']['figure'])\n   198\t        if fig.get('bridge'):\n   199\t            out.append(fig['bridge'])\n   200\t        return out\n   201\t\n   202\t    # C7 structure: kinds, operations, dangling, cycles, numbers\n   203\t    for fig in figs.values():\n   204\t        has_value = isinstance(fig.get('value'), (int, float))\n   205\t        has_range = isinstance(fig.get('low'), (int, float)) and isinstance(fig.get('high'), (int, float))\n   206\t        if has_value == has_range or (has_range and fig['low'] > fig['high']):          # [46o.2] exactly one: a value or an ordered range\n   207\t            errors.append(('C7', f'{fig[\"id\"]}: a figure needs either a value or a complete range with low at most high'))\n   208\t        if fig.get('kind') not in KINDS or fig.get('basis') not in BASES:\n   209\t            errors.append(('C7', f'{fig[\"id\"]}: kind {fig.get(\"kind\")} or basis {fig.get(\"basis\")} outside the closed set'))\n   210\t        if fig.get('kind') == 'computed' and fig.get('operation') not in OPERATIONS:\n   211\t            errors.append(('C7', f'{fig[\"id\"]}: operation {fig.get(\"operation\")} outside the closed set'))\n   212\t        elif fig.get('kind') == 'computed':\n   213\t            lo_n, hi_n = ARITY[fig['operation']]\n   214\t            if not lo_n <= len(fig.get('inputs', [])) <= hi_n:\n   215\t                errors.append(('C7', f'{fig[\"id\"]}: {fig[\"operation\"]} takes {lo_n}' + (f' to {hi_n}' if hi_n != lo_n else '')\n   216\t                                     + f' operands, not {len(fig.get(\"inputs\", []))}'))\n   217\t            signs = fig.get('signs')\n   218\t            if signs is not None and (fig['operation'] not in ('sum', 'roll_forward') or len(signs) != len(fig.get('inputs', []))\n   219\t                                      or any(x not in (1, -1) for x in signs)):\n   220\t                errors.append(('C7', f'{fig[\"id\"]}: signs must give one +1 or -1 per operand of a sum or roll_forward'))   # [46n]\n   221\t        for r in refs(fig):\n   222\t            if r not in figs:\n   223\t                errors.append(('C7', f'{fig[\"id\"]} refers to {r}, which is not defined'))\n   224\t    state = {}\n   225\t\n   226\t    def cyclic(fid):\n   227\t        if state.get(fid) == 1:\n   228\t            return True\n   229\t        if state.get(fid) == 2 or fid not in figs:\n   230\t            return False\n   231\t        state[fid] = 1\n   232\t        hit = any(cyclic(r) for r in refs(figs[fid]))\n   233\t        state[fid] = 2\n   234\t        return hit\n   235\t    if any(cyclic(fid) for fid in figs):\n   236\t        errors.append(('C7', 'the figure graph has a cycle'))\n   237\t    if errors:                                         # [46n] a malformed calculation is refused before any arithmetic\n   238\t        return {'errors': errors, 'recorded': recorded}\n   239\t\n   240\t    # C1 sources, prior pointers\n   241\t    for fig in figs.values():\n   242\t        if fig['kind'] == 'source':\n   243\t            errors += _source_errors(fig, passages)\n   244\t        if fig['kind'] == 'prior' and not fig.get('pointer'):\n   245\t            errors.append(('C7', f'{fig[\"id\"]}: a prior forecast needs an exact pointer to an earlier answer shown in the request'))\n   246\t\n   247\t    # C2 arithmetic and bound propagation\n   248\t    for fig in figs.values():\n   249\t        if fig['kind'] != 'computed' or fig.get('operation') not in OPERATIONS:\n   250\t            continue\n   251\t        ins = [figs[i] for i in fig['inputs'] if i in figs]\n   252\t        expected = _compute(fig['operation'], [_interval(i) + (i['unit'],) for i in ins], fig.get('signs'), fig['unit'])\n   253\t        lo, hi = _interval(fig)\n   254\t        if fig['operation'] == 'range_from_relative' or ('low' in fig):\n   255\t            ok = _close(lo, expected[0], fig['unit']) and _close(hi, expected[1], fig['unit'])\n   256\t        else:\n   257\t            ok = _close(lo, (expected[0] + expected[1]) / 2, fig['unit'])\n   258\t        if not ok:\n   259\t            errors.append(('C2', f'{fig[\"id\"]}: declared {lo}–{hi} but {fig[\"operation\"]} of {fig[\"inputs\"]} gives {expected[0]:.2f}–{expected[1]:.2f}'))\n   260\t        want = _bound_direction(fig['operation'], ins)\n   261\t        have = DIRECTION.get(fig.get('bound'))\n   262\t        if want is not None and have != want:\n   263\t            errors.append(('C2', f'{fig[\"id\"]}: its inputs make it a {want} bound, but it is declared {fig.get(\"bound\") or \"a point\"}'))\n   264\t        elif want is None and fig.get('bound'):\n   265\t            errors.append(('C2', f'{fig[\"id\"]}: its inputs are points, but it is declared a bound ({fig[\"bound\"]})'))\n   266\t\n   267\t    # C8 operand compatibility\n   446\t            if borrowed:\n   447\t                errors.append(('C4', f'{want}: {f[\"id\"]} ({sc}) depends on {\", \".join(borrowed)} of another scenario'))\n   448\t        for view_id in touched:                      # [46g.3] a bypass reaches the quantity through no forecast node of any scenario\n   449\t            bypass = [f for f in reachable(outcomes[view_id], stop=stop) if f not in stop and _key(figs[f]['what']) == want]\n   450\t            if bypass:\n   451\t                errors.append(('C4', f'{want}: {view_id} reaches {\", \".join(sorted(bypass))} without passing a forecast node ({\", \".join(sorted(stop))})'))\n   452\t    for rel in family.get('relations', []):           # [46j.2] the later member rests on the earlier member's forecast nodes, per scenario\n   453\t        if rel['type'] != 'same_base' or rel['later'] not in outcomes or rel['earlier'] not in outcomes:\n   454\t            continue\n   455\t        base_key = _key(members[rel['earlier']]['what'])\n   456\t        earlier_graph = _upstream_of(outcomes[rel['earlier']], figs, refs) | {outcomes[rel['earlier']]}\n   457\t        earlier_nodes = {f for f in earlier_graph if _key(figs[f]['what']) == base_key and figs[f]['basis'] == 'forecast'}\n   458\t        reached = reachable(outcomes[rel['later']], stop=earlier_nodes)\n   459\t        bypass = [f for f in reached if f not in earlier_nodes and _key(figs[f]['what']) == base_key]\n   460\t        later_key = _key(members[rel['later']]['what'])\n   461\t        by_scenario = {figs[n].get('scenario', 'base'): n for n in earlier_nodes if figs[n].get('scenario', 'base') != 'range'}\n   462\t        later_graph = _upstream_of(outcomes[rel['later']], figs, refs) | {outcomes[rel['later']]}\n   463\t        for f in sorted(later_graph):                 # [46k.1] every later scenario path reaches the earlier forecast of its own scenario\n   464\t            sc = figs[f].get('scenario', 'base')\n   465\t            if sc == 'range' or _key(figs[f]['what']) != later_key or figs[f]['basis'] != 'forecast':\n   466\t                continue\n   467\t            target = by_scenario.get(sc) or (next(iter(by_scenario.values())) if len(by_scenario) == 1 else None)\n   468\t            if target is None or target not in _determining(f, figs):       # [46l.1] through value-determining inputs only\n   469\t                errors.append(('C9', f'{f} ({sc}) of {rel[\"later\"]} is not computed from {rel[\"earlier\"]}\\'s {sc} forecast'))\n   470\t            else:                                     # [46o.1] and its value moves when that forecast moves\n   471\t                lo_t, hi_t = _interval(figs[target])\n   472\t                before = _evaluate(figs, refs, {})[f]\n   473\t                after = _evaluate(figs, refs, {target: (lo_t * 1.1, hi_t * 1.1)})[f]\n   474\t                if abs(after[0] - before[0]) <= 1e-9 * max(1.0, abs(before[0])) and abs(after[1] - before[1]) <= 1e-9 * max(1.0, abs(before[1])):\n   475\t                    errors.append(('C9', f'{f} ({sc}) of {rel[\"later\"]} does not change when {rel[\"earlier\"]}\\'s forecast {target} changes'))\n   476\t        later_scen = {figs[f].get('scenario', 'base') for f in later_graph if _key(figs[f]['what']) == later_key\n   477\t                      and figs[f]['basis'] == 'forecast' and figs[f].get('scenario', 'base') != 'range'}\n   478\t        if earlier_nodes and not later_scen:              # [46m.2] a citation never stands in for a calculation\n   479\t            errors.append(('C9', f'{rel[\"later\"]} has no calculation from {rel[\"earlier\"]}\\'s forecast, only a range resting on it'))\n   480\t        if len(by_scenario) > 1 and later_scen != set(by_scenario):     # [46l.1] the later member covers the earlier's scenarios\n   481\t            errors.append(('C9', f'{rel[\"later\"]} covers scenarios {sorted(later_scen)} but {rel[\"earlier\"]} covers {sorted(by_scenario)}'))\n   482\t        if not reached & earlier_nodes:\n   483\t            errors.append(('C9', f'{rel[\"later\"]} does not rest on {rel[\"earlier\"]}\\'s forecast ({\", \".join(sorted(earlier_nodes))})'))\n   484\t        if bypass:\n   485\t            errors.append(('C9', f'{rel[\"later\"]} reaches {\", \".join(sorted(bypass))} for {base_key} without {rel[\"earlier\"]}\\'s forecast'))\n   486\t    supplied = family.get('prior_answers', {})\n   487\t    for fig in figs.values():\n   488\t        earlier = fig['kind'] == 'prior' or fig.get('basis') == 'prior_forecast' or 'pointer' in fig   # [46i.2] derived, not labelled\n   489\t        if not earlier:\n   490\t            continue\n   491\t        if fig['kind'] != 'prior' or fig.get('basis') != 'prior_forecast':\n   492\t            errors.append(('C10', f'{fig[\"id\"]}: an earlier forecast must be kind prior with basis prior_forecast'))\n   493\t        ptr, ans_prior = fig.get('pointer', {}), supplied.get(fig.get('pointer', {}).get('view'), {})\n   494\t        if ans_prior.get('day') != ptr.get('day') or not any(_same(fig.get('value'), v) for v in ans_prior.get('values', [])):\n   495\t            errors.append(('C10', f'{fig[\"id\"]}: no earlier answer of {ptr.get(\"view\")} on {ptr.get(\"day\")} shown in the request states {fig.get(\"value\")}'))\n   496\t        owners = [a['view_id'] for a in calc['answers'] if a.get('outcome') == fig['id']]\n   497\t        if owners:                                    # [46h.2] nor the current outcome\n   498\t            errors.append(('C10', f'{fig[\"id\"]}: an earlier forecast cannot be the current outcome of {\", \".join(owners)}'))\n   499\t        users = [f['id'] for f in figs.values() if fig['id'] in refs(f)]\n   500\t        if users:\n   501\t            errors.append(('C10', f'{fig[\"id\"]}: an earlier forecast is for comparison only and cannot feed {\", \".join(users)}'))\n   502\t\n   503\t    recorded += _assumptions(family, figs, outcomes, calc, refs)\n   559\t\n   560\tdef family_outcome(attempts):\n   561\t    \"\"\"The round's outcome from up to two attempts' decisions: a refusal is retried once; two refusals make the family unresolved.\"\"\"\n   562\t    if attempts[0] != 'refused':\n   563\t        return attempts[0]\n   564\t    if len(attempts) > 1 and attempts[1] != 'refused':\n   565\t        return attempts[1]\n   566\t    return 'unresolved'\n   567\t\n   568\t\n   569\tdef _determining(fid, figs):\n   570\t    \"\"\"The figures that determine fid's value: computed inputs only, at any depth (an estimate's rests_on explains, it does not compute).\"\"\"\n   571\t    seen_ids, stack = set(), list(figs[fid].get('inputs', [])) if figs[fid]['kind'] == 'computed' else []\n   572\t    while stack:\n   573\t        f = stack.pop()\n   574\t        if f in seen_ids or f not in figs:\n   575\t            continue\n   576\t        seen_ids.add(f)\n   577\t        if figs[f]['kind'] == 'computed':\n   578\t            stack.extend(figs[f].get('inputs', []))\n   579\t    return seen_ids\n   580\t\n   581\t\n   582\tdef _upstream_of(fid, figs, refs):\n   583\t    \"\"\"The figures that fid's own value is computed from (fid excluded).\"\"\"\n   584\t    seen_ids, stack = set(), list(refs(figs[fid]))\n   585\t    while stack:\n   586\t        f = stack.pop()\n   587\t        if f in seen_ids or f not in figs:\n   588\t            continue\n   589\t        seen_ids.add(f)\n   590\t        stack.extend(refs(figs[f]))\n   591\t    return seen_ids\n   592\t\n   593\t\n   594\tdef _reference_errors(view_id, ref, figs, passages, refs):\n   595\t    if ref is None:\n   596\t        return [('C5', f'{view_id}: the reference names no figure')]\n   597\t    graph = [ref['id']] + sorted(_upstream_of(ref['id'], figs, refs))\n   598\t    nodes = [figs[f] for f in graph]\n   599\t    if any(n['kind'] in ('estimate', 'prior') or n['basis'] in ('forecast', 'prior_forecast') for n in nodes):\n   600\t        return [('C5', f'{view_id}: the reference {ref[\"id\"]} rests on the system\\'s own forecast or an estimate')]\n   601\t    leaves = [n for n in nodes if n['kind'] == 'source']\n   602\t    if not any(n['basis'] in EXTERNAL and passages.get(n['evidence'], {}).get('speaker') != 'system' for n in leaves):\n   603\t        return [('C5', f'{view_id}: the reference {ref[\"id\"]} has no external source among its leaves')]\n   604\t    if any(n['basis'] not in EXTERNAL | {'reported'} for n in leaves):\n   605\t        return [('C5', f'{view_id}: the reference {ref[\"id\"]} has a leaf that is neither external nor reported')]\n   606\t    return []\n   607\t\n   608\t\n   609\tdef _evaluate(figs, refs, overrides):\n   610\t    \"\"\"Recompute computed figures from their inputs, with some figures' values replaced; estimates keep their values.\"\"\"\n   611\t    values, order, done = {}, [], set()\n   612\t\n   613\t    def visit(fid):\n   614\t        if fid in done:\n   615\t            return\n   616\t        done.add(fid)\n   617\t        for r in refs(figs[fid]):\n   618\t            if r in figs:\n   619\t                visit(r)\n   620\t        order.append(fid)\n   621\t    for fid in figs:\n   622\t        visit(fid)\n   623\t    for fid in order:\n   624\t        fig = figs[fid]\n   625\t        if fid in overrides:\n   626\t            values[fid] = overrides[fid]\n   627\t        elif fig['kind'] == 'computed' and fig.get('operation') in OPERATIONS:\n   628\t            ins = [values[i] + (figs[i]['unit'],) for i in fig['inputs']]\n   629\t            values[fid] = _compute(fig['operation'], ins, fig.get('signs'), fig['unit'])\n   630\t        else:\n   631\t            values[fid] = _interval(fig)\n   632\t    return values\n   633\t\n   634\t\n   635\tdef _boundaries(bands, a, b):\n   636\t    edges = sorted({e for band in bands for e in band if e is not None})\n   637\t    lo, hi = min(a, b), max(a, b)\n   638\t    return [e for e in edges if lo < e <= hi]\n   639\t\n   640\t\n   641\tdef _assumptions(family, figs, outcomes, calc, refs):\n   642\t    out = []\n   643\t    members = family['members']\n   644\t\n   645\t    def downstream_formula(start, outcome_id):\n   646\t        \"\"\"True when every figure between start and the outcome (the outcome included) is computed.\"\"\"\n   647\t        between = [f for f in [outcome_id] + sorted(_upstream_of(outcome_id, figs, refs)) if start in _upstream_of(f, figs, refs)]\n   648\t        return all(figs[f]['kind'] == 'computed' for f in between)\n   649\t    for fig in figs.values():\n   650\t        alt, kind = None, None\n   651\t        if fig['kind'] == 'computed' and fig.get('relation') == 'overlap_unknown' and fig.get('disputed') in fig.get('inputs', []):\n   652\t            keep = [i for i in fig['inputs'] if i != fig['disputed']]\n   653\t            signs = [s for i, s in zip(fig['inputs'], fig.get('signs') or [1] * len(fig['inputs'])) if i != fig['disputed']]\n   654\t            alt = _compute(fig['operation'], [_interval(figs[i]) + (figs[i]['unit'],) for i in keep], signs, fig['unit'])\n   655\t            kind, bound = 'overlap', None\n   656\t        elif fig['kind'] == 'estimate' and fig.get('adjusts'):\n   657\t            target = figs[fig['adjusts']['figure']]\n   658\t            alt, kind, bound = _interval(target), 'adjustment', target.get('bound')\n","exit_code":0,"status":"completed"}}
