{"type":"item.started","item":{"id":"item_7","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"python3 -B -c '\nimport pathlib,json,io,contextlib,copy,types\nimport gate as g, calc_check as c, render_v13 as r, mutants\ndef replay(func, log):\n    p=io.StringIO()\n    with contextlib.redirect_stdout(p): status=func()\n    assert status==0 and p.getvalue()==pathlib.Path(log).read_text()\nreplay(g.main,'\\\\''gate-run12.txt'\\\\'')\nassert g.MANIFEST==json.loads(pathlib.Path('\\\\''gate-run12.fixtures.json'\\\\'').read_text())\nreplay(r.main,'\\\\''render-r1.txt'\\\\'')\noriginal=g.cc\npath=pathlib.Path('\\\\''calc_check.py'\\\\'')\nsrc=path.read_text()\nfor name,old,new,target in mutants.MUTANTS:\n    g.cc=original\n    if old:\n        assert src.count(old)==1,name\n        mod=types.ModuleType('\\\\''in_memory_calc_check'\\\\'')\n        exec(compile(src.replace(old,new),str(path),'\\\\''exec'\\\\''),mod.__dict__)\n        g.cc=mod\n    misses={name for name,ok,_,_ in g.run() if not ok}\n    assert (target in misses if target else not misses),(name,misses)\ng.cc=original\nprint('\\\\''59 gate items, 27 mutants and stored render reproduced'\\\\'')\ndef fig(calc,fid):\n    return next(f for f in calc['\\\\''figures'\\\\''] if f['\\\\''id'\\\\'']==fid)\ndef check(name,v):\n    fam,x=v['\\\\''family'\\\\''],v['\\\\''calc'\\\\'']\n    schema=r.v13_schema(list(fam['\\\\''members'\\\\'']),list(g.G_PASSAGES),[])\n    strict=r.strict(x,schema)\n    print(name, r.model.check_schema(strict,schema), c.check(fam,g.G_PASSAGES,r.without_nulls(strict))['\\\\''errors'\\\\''])\nfor name in ('\\\\''G24x'\\\\'','\\\\''G24nv'\\\\'','\\\\''G24'\\\\'','\\\\''G4'\\\\''):\n    check(name,g.MANIFEST[name])\ncase=copy.deepcopy(g.MANIFEST['\\\\''G4'\\\\''])\nx=case['\\\\''calc'\\\\'']\nderived=fig(x,'\\\\''gfy28c'\\\\'')\nhelper=copy.deepcopy(derived)\nhelper['\\\\''id'\\\\'']='\\\\''x_from_q01'\\\\''\nx['\\\\''figures'\\\\''].append(helper)\nderived.update(operation='\\\\''sum'\\\\'',inputs=['\\\\''gc554'\\\\'','\\\\''x_from_q01'\\\\'','\\\\''x_from_q01'\\\\''],signs=[1,1,-1],low=504.0,high=604.0)\ncheck('\\\\''G4: \"'$554B + x - x with x from q01'\"'\\\\'',case)\nfigs={f['\\\\''id'\\\\'']:f for f in x['\\\\''figures'\\\\'']}\ndef refs(f):\n    return f.get('\\\\''inputs'\\\\'',[])+[i for i in f.get('\\\\''rests_on'\\\\'',[]) if i in figs]\nfor override in ({},{'\\\\''gfy'\\\\'':(440.0,478.5)},{'\\\\''gfy'\\\\'':(400.0,400.0)},{'\\\\''gfy'\\\\'':(440.0,440.0)}):\n    print(override,{i:c._evaluate(figs,refs,override)[i] for i in ('\\\\''x_from_q01'\\\\'','\\\\''gfy28c'\\\\'')})\n'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
