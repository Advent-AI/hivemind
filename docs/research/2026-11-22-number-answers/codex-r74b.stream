{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba src/hivemind/extraction.py | sed -n '345,430p;650,710p'\"","aggregated_output":"   345\t            end = spans[position + length - 1][2]\n   346\t            if end >= len(text) or _SENTENCE_END.match(text[end:end + 4]) or _CLOSING.fullmatch(text[end:end + 2] or '') and text[end:end + 1] in '.!?':\n   347\t                return position, position + length - 1\n   348\t    return None\n   349\t\n   350\t\n   351\tdef item_header(item, category):\n   352\t    \"\"\"The line that opens the item in an English extraction request; preflight reads archived requests by it.\"\"\"\n   353\t    return (f'[Item] id {item[\"input_id\"]}, category {category}, author {item.get(\"publisher\")} ({item.get(\"publisher_type\")}), '\n   354\t            f'published {item.get(\"publication_day\")}, title: {item.get(\"title\") or \"\"}\\n\\n')\n   355\t\n   356\t\n   357\tdef _watched_lines(objects, universe):\n   358\t    \"\"\"keyed-views-plan.md 2.4 / D155: the quantities the analyst watches, as a reference, with the exact scope names.\"\"\"\n   359\t    watched = []\n   360\t    for o in objects:\n   361\t        entries = universe.watch_list(o) if hasattr(universe, 'watch_list') else []\n   362\t        if entries:\n   363\t            sep = '; '\n   364\t            watched.append(f'  - {o}: ' + sep.join(e['measure'] + (f\"[{e['scope']}]\" if e.get('scope') else '') + (f\"({e['event_type']})\" if e.get('event_type') else '') for e in entries))\n   365\t    return watched\n   366\t\n   367\t\n   368\t\n   369\t# 05-extraction block 5b (D149, D166): the standing instruction; code folds a declared group into a stored one by its names\n   370\tGROUPS_INSTRUCTION = ('[Research groups] None yet. For a candidate that tracks an ongoing matter (a product rollout, a deal, a policy process, an investment or demand cycle), '\n   371\t                      'declare the group in new_groups (local ids n1, n2 …) and cite it in group_refs; leave group_refs empty for a company\\'s own financial lines.')\n   372\tCLOSING = ('Return evidence and candidates per the JSON schema. A candidate\\'s evidence_ids are its own evidence ids; an evidence item\\'s links are '\n   373\t           'open question ids from [Open questions], this answer\\'s candidate ids (such as c1), or empty. '\n   374\t           'year names the fiscal or calendar year the figure covers (FY2027, or 2026 for a calendar year).')\n   375\t\n   376\t\n   377\tdef build_prompt(item, text, shown_views, universe, version):\n   378\t    \"\"\"The request's two texts. The system text is the role; the user text is the category and how to read it, the subjects with the\n   379\t    theme list and the fiscal-year note, what to read out, the research reference, the questions open at the start of the item's day\n   380\t    with their takes lines, the research-group instruction, the item, the closing sentence and the end-of-request check.\"\"\"\n   381\t    require_supported(version)\n   382\t    category = item['category']\n   383\t    categories = _categories(version)\n   384\t    blocks = categories.get(category) or categories['T7']\n   385\t    objects = [o['value'] for o in item.get('object_identifiers') or []]\n   386\t    themes = '\\n'.join(f'  - {theme_id}: {name}' for theme_id, name in universe.theme_list())\n   387\t    fiscal = '\\n'.join(note for note in (universe.fiscal_note(o, item['publication_day'], english=True) for o in objects) if note)\n   388\t    parts = [\n   389\t        f'[Category and how to read it] {category}. {blocks[\"what\"]}',\n   390\t        f'[Subjects] The objects this item concerns: {\", \".join(objects) or \"(not labelled upstream)\"}. For a candidate thesis about a company, object is its ticker; '\n   391\t        f'about a theme, choose an id from this list, or state what the matter is when none fits:\\n{themes}'\n   392\t        + (f'\\nFiscal-year note (a numeric thesis takes its year and due date from it):\\n{fiscal}' if fiscal else ''),\n   393\t        f'[What to read out] {blocks[\"read\"]}',\n   394\t    ]\n   395\t    watched = _watched_lines(objects, universe)\n   396\t    if watched:\n   397\t        parts.append('[Research reference] Existing quantities and scopes (measure[scope](event_type)). Reuse a name only when the meaning is the same; '\n   398\t                     'propose important questions outside the list as usual, with their actual scope:\\n' + '\\n'.join(watched))\n   399\t    lines = placement.question_lines(shown_views)\n   400\t    parts.append(f'[Open questions at the start of {item[\"publication_day\"]}]\\n' + ('\\n'.join(lines) if lines else '  None yet.'))\n   401\t    parts.append(GROUPS_INSTRUCTION)\n   402\t    parts.append(item_header(item, category) + text[:MAX_TEXT_CHARS])\n   403\t    parts.append(CLOSING)\n   404\t    parts.append(_read(f'review-{version}.txt').strip())\n   405\t    return _read(f'role-{version}.txt'), '\\n\\n'.join(parts)\n   406\t\n   407\t\n   408\tOBJECT_LABELS = vocabulary.ASSET_LABELS\n   409\t\n   410\t\n   411\tdef check_ladder(rungs, kind):\n   412\t    \"\"\"None when the ladder is well formed, else the problem. An asset ladder written from Strongly bearish up to\n   413\t    Strongly bullish (the model often orders a revenue ladder by rising value) is the same ladder; normalise_ladder\n   414\t    turns it round. Labels are compared in the canonical vocabulary.\"\"\"\n   415\t    if len(rungs) not in (2, 5):\n   416\t        return f'ladder has {len(rungs)} rungs, needs 5 (or 2 for yes/no)'\n   417\t    if any(not r['label'].strip() or not r['condition'].strip() for r in rungs):\n   418\t        return 'a rung has an empty label or condition'\n   419\t    if kind == 'asset' and len(rungs) == 5:\n   420\t        labels = [vocabulary.canonical('label', r['label']) for r in rungs]\n   421\t        if labels != OBJECT_LABELS and labels != OBJECT_LABELS[::-1]:\n   422\t            return f'object view rungs must be {OBJECT_LABELS}, got {labels}'\n   423\t    return None\n   424\t\n   425\t\n   426\tdef normalise_ladder(rungs, kind):\n   427\t    \"\"\"Position 1 is Strongly bullish (06-views): a reversed asset ladder is turned round, label and condition together.\"\"\"\n   428\t    if kind == 'asset' and len(rungs) == 5 and [vocabulary.canonical('label', r['label']) for r in rungs] == OBJECT_LABELS[::-1]:\n   429\t        return list(reversed(rungs))\n   430\t    return rungs\n   650\t                object_id = universe.resolve(c['object']) or c['object']\n   651\t                scope, source = universe.scope_and_source(object_id, c['measure'], c.get('scope', ''), c.get('event_type', 'n/a'))\n   652\t                c = dict(c, object=object_id, scope=scope, scope_source=source, key_version=2)\n   653\t                if c['measure'] not in ('event', 'policy_event'):\n   654\t                    period = universe.fiscal_period(object_id, c.get('year', ''), bare_is_calendar=True)                             # and the period of a yearly number\n   655\t                    if period:\n   656\t                        c = dict(c, period_start=period[0], period_end=period[1])\n   657\t            try:\n   658\t                start = datetime.date.fromisoformat(c['period_start'])\n   659\t                end = datetime.date.fromisoformat(c['period_end'])\n   660\t                if start > end:\n   661\t                    raise ValueError('start after end')\n   662\t            except (KeyError, ValueError):\n   663\t                dropped.append((c['id'], 'invalid period: expected real dates with start <= end'))\n   664\t                continue\n   665\t        candidates.append(c)\n   666\t        candidate_ids.add(c['id'])\n   667\t    evidence = []\n   668\t    kept_ids = set()\n   669\t    by_quote = {}\n   670\t    alias = {}\n   671\t    for e in data.get('evidence', []):\n   672\t        quote = normalise(e['quote'])\n   673\t        if len(quote) < 8 or quote not in body:\n   674\t            subject_names = [universe.companies[o['value']]['name'] for o in item.get('object_identifiers') or []\n   675\t                             if universe is not None and o['value'] in getattr(universe, 'companies', {})]\n   676\t            repaired = repair_quote(e['quote'], text, subject_names)\n   677\t            if repaired is None or normalise(repaired) not in body:\n   678\t                dropped.append((e['id'], 'quote not in item'))\n   679\t                continue\n   680\t            e = dict(e, quote=repaired)\n   681\t            quote = normalise(repaired)\n   682\t        links = [l for l in e['links'] if l in shown_ids or l in candidate_ids]\n   683\t        if quote in by_quote:            # the same sentence read out twice is one piece with both links\n   684\t            first = by_quote[quote]\n   685\t            first['links'].extend(l for l in links if l not in first['links'])\n   686\t            alias[e['id']] = first['id']\n   687\t            dropped.append((e['id'], f'same quote as {first[\"id\"]}; merged'))\n   688\t            continue\n   689\t        e = dict(e, links=links, original_day=statement_day(e.get('original_day')))\n   690\t        by_quote[quote] = e\n   691\t        evidence.append(e)\n   692\t        kept_ids.add(e['id'])\n   693\t    final_candidates = candidates_with_evidence(candidates, kept_ids, item, dropped, alias)\n   694\t    for e in evidence:\n   695\t        e['links'] = [l for l in e['links'] if l in shown_ids or any(c['id'] == l for c in final_candidates)]\n   696\t    return evidence, final_candidates, dropped\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc 'nl -ba src/hivemind/research_context.py'","aggregated_output":"     1\t\"\"\"Complete, historical DB context for steps 2a and 2b (D250, ported for D201): the catalog of open questions in scope at a\n     2\tsequence number, and the complete evidence of chosen questions at that same sequence number.\n     3\t\n     4\tCatalog selection is a semantic job outside this module. No lexical filtering,\n     5\tranking, model call or top-N truncation is performed here.\n     6\t\"\"\"\n     7\timport copy\n     8\tfrom .views import store\n     9\t\n    10\t\n    11\tclass Reader:\n    12\t    \"\"\"One read transaction, one explicit exclusive sequence boundary and scope.\"\"\"\n    13\t\n    14\t    def __init__(self, path, before_seq, object_ids, universe):\n    15\t        if type(before_seq) is not int or before_seq < 1:\n    16\t            raise ValueError('before_seq must be a positive owned sequence number')\n    17\t        if not object_ids or any(not universe.has(x) for x in object_ids):\n    18\t            raise ValueError('explicit, known research objects required')\n    19\t        self.seq = before_seq\n    20\t        self.scope = sorted(set(object_ids) | set(universe.themes))\n    21\t        self.db = store.open_read_only(path)\n    22\t        self.db.execute('begin')\n    23\t        self._catalog = None\n    24\t\n    25\t    def __enter__(self):\n    26\t        return self\n    27\t\n    28\t    def __exit__(self, *_):\n    29\t        self.db.close()\n    30\t\n    31\t    def rows(self, sql, args=()):\n    32\t        return [dict(r) for r in self.db.execute(sql, args)]\n    33\t\n    34\t    def dependencies(self, vid):\n    35\t        result = self.rows('select dependency_id, view_id, depends_on, wait_chain_view_id, wait_year, direction, seq from dependencies '\n    36\t                           'where view_id=? and seq<? order by seq,dependency_id', (vid,self.seq))     # these columns only: the response carries no kind\n    37\t        for dep in result:\n    38\t            res = self.rows('select * from dependency_resolutions where dependency_id=? and seq<? order by seq desc,id desc limit 1', (dep['dependency_id'],self.seq))\n    39\t            dep['resolved_to'] = res[0]['resolved_to'] if res else dep['depends_on']\n    40\t            dep['resolution'] = res[0] if res else None\n    41\t        return result\n    42\t\n    43\t    def question(self, row):\n    44\t        vid = row['view_id']\n    45\t        switches = self.rows('select * from view_switches where view_id=? and after_seq<? order by after_seq desc,id desc limit 1', (vid,self.seq))\n    46\t        if not switches:\n    47\t            raise ValueError('question has no historical open/closed state: ' + vid)\n    48\t        keys = self.rows('select * from view_keys where view_id=? and seq<?', (vid,self.seq))\n    49\t        return dict(row, open=bool(switches[0]['open']),\n    50\t                    rungs=self.rows('select * from rungs where view_id=? order by position', (vid,)),\n    51\t                    key=keys[0] if keys else None, dependencies=self.dependencies(vid))\n    52\t\n    53\t    def catalog(self):\n    54\t        all_rows = self.rows('select * from views where created_seq<? order by created_seq,view_id', (self.seq,))\n    55\t        by_id = {r['view_id']: r for r in all_rows}\n    56\t        selected = {}\n    57\t        for row in all_rows:\n    58\t            if row['object_id'] in self.scope:\n    59\t                q = self.question(row)\n    60\t                if q['open']:\n    61\t                    selected[row['view_id']] = q\n    62\t        for q in list(selected.values()):\n    63\t            for dep in q['dependencies']:\n    64\t                vid = dep['resolved_to']\n    65\t                if vid and vid not in selected:\n    66\t                    if vid not in by_id:\n    67\t                        raise ValueError('historical dependency target missing: ' + vid)\n    68\t                    selected[vid] = self.question(by_id[vid])\n    69\t        payload = {'before_seq': self.seq, 'object_ids': self.scope,\n    70\t                   'questions': list(selected.values()), 'complete': True}\n    71\t        self._catalog = selected\n    72\t        return copy.deepcopy(payload)\n    73\t\n    74\t    def evidence(self, eid):\n    75\t        rows = self.rows('select * from evidence where evidence_id=? and created_seq<?', (eid,self.seq))\n    76\t        if not rows:\n    77\t            raise ValueError('historical evidence missing: ' + eid)\n    78\t        return dict(rows[0], sources=self.rows('select * from evidence_sources where evidence_id=? and seq<? order by seq,id', (eid,self.seq)))\n    79\t\n    80\t    def expand(self, view_ids):\n    81\t        if self._catalog is None:\n    82\t            self.catalog()\n    83\t        if len(set(view_ids)) != len(view_ids) or any(v not in self._catalog for v in view_ids):\n    84\t            raise ValueError('select distinct IDs from this historical catalog')\n    85\t        evidence, questions = {}, []\n    86\t        for vid in view_ids:\n    87\t            ids = self.rows('select distinct e.evidence_id,e.created_seq from evidence e join evidence_links l on l.evidence_id=e.evidence_id where l.view_id=? and l.seq<? and e.created_seq<? and not exists (select 1 from replacements r where r.old_evidence_id=e.evidence_id and r.seq<?) order by e.created_seq,e.evidence_id', (vid,self.seq,self.seq,self.seq))\n    88\t            for row in ids:\n    89\t                eid = row['evidence_id']\n    90\t                if eid not in evidence:\n    91\t                    record = self.evidence(eid)\n    92\t                    previous = self.rows('select * from replacements where new_evidence_id=? and seq<? order by seq,id', (eid,self.seq))\n    93\t                    record['replaced'] = [dict(r, evidence=self.evidence(r['old_evidence_id'])) for r in previous]\n    94\t                    evidence[eid] = record\n    95\t            judgements = self.rows('select * from judgements where view_id=? and seq<? order by seq desc,judgement_id desc limit 1', (vid,self.seq))\n    96\t            questions.append(dict(copy.deepcopy(self._catalog[vid]), evidence_ids=[r['evidence_id'] for r in ids],\n    97\t                                  latest_judgement=judgements[0] if judgements else None))\n    98\t        return {'before_seq': self.seq, 'questions': questions,\n    99\t                'evidence': list(evidence.values()), 'complete': True}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba src/hivemind/bundle.py | sed -n '1,65p;210,290p'\"","aggregated_output":"     1\t\"\"\"One view in the shape the front end reads: the ladder, every judgement round with the model's reason and the\n     2\tevidence it cited, the evidence in force with tiers, speakers and sources, dependencies, replacements and the freeze\n     3\tswitches. The same shaping writes the mock's data file (scripts/mock_data.py) and answers POST /ideas, so the front\n     4\tend's adapter reads both. Read-only on every database. With `as_of`, rows written after that day are left out.\"\"\"\n     5\timport json\n     6\tfrom contextlib import contextmanager\n     7\tfrom datetime import date\n     8\t\n     9\tfrom . import service\n    10\tfrom .views import store\n    11\t\n    12\t\n    13\t@contextmanager\n    14\tdef read_snapshot(*connections):\n    15\t    \"\"\"Pin each read connection for a complete envelope; preserve a caller's transaction.\"\"\"\n    16\t    owned = []\n    17\t    try:\n    18\t        for conn in connections:\n    19\t            if conn is not None and not conn.in_transaction:\n    20\t                conn.execute('begin')\n    21\t                owned.append(conn)\n    22\t        yield\n    23\t    finally:\n    24\t        for conn in reversed(owned):\n    25\t            conn.rollback()\n    26\t\n    27\t\n    28\tdef item_lookup(items_db):\n    29\t    \"\"\"input id → title, publisher and category of a stored item, from the items database (or the id alone when the\n    30\t    database is not given or does not hold it).\"\"\"\n    31\t    cache = {}\n    32\t\n    33\t    def item_of(input_id):\n    34\t        if input_id not in cache:\n    35\t            row = items_db.execute('select title, publisher, publisher_type, category, publication_day, source_uri from items where input_id=?', (input_id,)).fetchone() if items_db is not None else None\n    36\t            cache[input_id] = dict(row) if row else {'title': input_id, 'publisher': '', 'publisher_type': '', 'category': '', 'publication_day': '', 'source_uri': ''}\n    37\t        return cache[input_id]\n    38\t    return item_of\n    39\t\n    40\t\n    41\tdef _visible(views_db, seq, as_of):\n    42\t    return as_of is None or service.visible(views_db, seq, as_of)\n    43\t\n    44\t\n    45\tdef ladder_row(views_db, view_id):\n    46\t    \"\"\"The view's ladder as the new system's writer stored it (`clean_ladders`, written in the view's own call): the parsed\n    47\t    ladder; 'no table' for a store without that table (a legacy ledger); 'no row' when the store has the table and no row for the\n    48\t    view. A row that is not readable JSON with a ladder, or two rows for one view, is refused.\"\"\"\n    49\t    if not views_db.execute(\"select 1 from sqlite_master where type='table' and name='clean_ladders'\").fetchone():\n    50\t        return 'no table'\n    51\t    rows = views_db.execute('select checked_answer from clean_ladders where view_id=?', (view_id,)).fetchall()\n    52\t    if not rows:\n    53\t        return 'no row'\n    54\t    if len(rows) > 1:\n    55\t        raise ValueError(f'{view_id}: {len(rows)} ladder rows for one view')\n    56\t    try:\n    57\t        ladder = json.loads(rows[0][0])['ladder']\n    58\t    except (TypeError, ValueError, KeyError) as error:\n    59\t        raise ValueError(f'{view_id}: its ladder row holds no readable ladder ({error!r})')\n    60\t    if not isinstance(ladder, dict):\n    61\t        raise ValueError(f'{view_id}: its ladder row holds no readable ladder')\n    62\t    return ladder\n    63\t\n    64\t\n    65\tdef not_judged(views_db, view_id, created_seq, as_of=None):\n   210\t                   for m in conn.execute('select * from thesis_group_members where group_id=? order by id', (row['group_id'],))\n   211\t                   if m['view_id'] in loaded and service.visible(conn, m['seq'], as_of)]\n   212\t        if members:\n   213\t            result.append({'id': row['group_id'], 'name': row['name'], 'scope': row['scope'],\n   214\t                           'aliases': json.loads(row['aliases'] or '[]') if 'aliases' in row.keys() else [],\n   215\t                           'created_day': service.day_of_seq(conn, row['created_seq']), 'members': members})\n   216\t    return result\n   217\t\n   218\t\n   219\tdef thesis_bundles(views_db, items_db, view_ids, as_of=None):\n   220\t    \"\"\"Selected complete thesis records, pinned to one read transaction.\"\"\"\n   221\t    with read_snapshot(views_db, items_db):\n   222\t        return _bundles(views_db, items_db, view_ids, service.resolve_bound(views_db, as_of))\n   223\t\n   224\t\n   225\tdef library(views_db, items_db, as_of=None):\n   226\t    \"\"\"All theses, including closed ones, and stored groups; no search or model call.\"\"\"\n   227\t    with read_snapshot(views_db, items_db):\n   228\t        as_of = service.resolve_bound(views_db, as_of)\n   229\t        if not as_of:\n   230\t            raise ValueError('The library has no completed day; supply as_of')\n   231\t        date.fromisoformat(as_of)\n   232\t        view_ids = [r['view_id'] for r in views_db.execute('select * from views order by created_seq, rowid')\n   233\t                    if service.view_exists(views_db, r, as_of)]\n   234\t        if not view_ids:\n   235\t            return {'as_of': as_of, 'days': days(views_db, as_of), 'views': [], 'coverage': 'library', 'groups': []}\n   236\t        return _bundles(views_db, items_db, view_ids, as_of, coverage='library')\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_17","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba src/hivemind/placement.py | sed -n '1,140p'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba src/hivemind/service.py | sed -n '1,325p'\"","aggregated_output":"     1\t\"\"\"Read-only answers over the views ledger, as of a calendar day (docs/poc/service.md).\n     2\t\n     3\tNothing here reads the clock (D12, D13): every function takes `as_of`, a day, and the default is the ledger's last\n     4\tcompleted day. A row is visible as of a day when the sequence number it was written under belongs to an item or a\n     5\tdaily round dated on or before that day. Nothing here writes.\n     6\t\"\"\"\n     7\timport json\n     8\timport re\n     9\timport sqlite3\n    10\tfrom decimal import Decimal\n    11\t\n    12\tfrom . import vocabulary\n    13\tfrom .views import store\n    14\t\n    15\tTIER_FACT = vocabulary.TIERS[0]          # 'fact'; a legacy ledger's '发生的事' compares equal through vocabulary.canonical\n    16\tCOMPARATORS = ('>=', '<', '=')\n    17\t\n    18\t\n    19\tdef open_ledger(path):\n    20\t    \"\"\"A read-only connection to a views database.\"\"\"\n    21\t    return store.open_read_only(path)\n    22\t\n    23\t\n    24\tdef default_as_of(conn):\n    25\t    \"\"\"Today's default day: the last completed day, or a legacy ledger's last judgement day. Read only through `resolve_bound`.\"\"\"\n    26\t    return store.last_completed_day(conn) or conn.execute('select max(publication_day) from judgements').fetchone()[0]\n    27\t\n    28\t\n    29\tclass FirstDayNotCompleted(ValueError):\n    30\t    \"\"\"The store holds processing steps and no completed day: its first day is still in progress, and nothing is served from it\n    31\t    (live-service/OPERATING-CONTRACT.md, row 4; open defect 10).\"\"\"\n    32\t\n    33\t    def __init__(self):\n    34\t        super().__init__(\"the store's first day has not completed\")\n    35\t\n    36\t\n    37\tclass BoundNotCompleted(ValueError):\n    38\t    \"\"\"An explicit upper bound later than the store's last completed day: refused, naming that day (OPERATING-CONTRACT.md, row 3).\"\"\"\n    39\t\n    40\t    def __init__(self, requested, last_completed_day):\n    41\t        self.requested, self.last_completed_day = requested, last_completed_day\n    42\t        super().__init__(f'day not completed: {requested} is after the last completed day {last_completed_day}')\n    43\t\n    44\t\n    45\tclass RangeNotOrdered(ValueError):\n    46\t    \"\"\"A range whose start is after its resolved end: a window reaching into days not yet completed (council round 124).\"\"\"\n    47\t\n    48\t    def __init__(self, start, end):\n    49\t        self.start, self.end = start, end\n    50\t        super().__init__(f'range start after its end: {start} to {end}')\n    51\t\n    52\t\n    53\tdef first_day_unfinished(conn):\n    54\t    return store.last_completed_day(conn) is None and conn.execute('select 1 from processing_steps limit 1').fetchone() is not None\n    55\t\n    56\t\n    57\tdef resolve_bound(conn, bound, *, unfiltered=False):\n    58\t    \"\"\"The one owner of an upper date bound, explicit or omitted (OPERATING-CONTRACT.md, row 3).\n    59\t\n    60\t    A store whose first day is in progress is refused. An omitted bound is today's default day; with `unfiltered` (the bundle\n    61\t    functions, whose omitted bound read every record), it is the last completed day, or None (no filter, as before) on a store with\n    62\t    none. An explicit bound later than the last completed day is refused, whatever the store holds after it; one on or before it\n    63\t    passes. Idempotent: a bound it passed passes again.\"\"\"\n    64\t    if first_day_unfinished(conn):\n    65\t        raise FirstDayNotCompleted()\n    66\t    last = store.last_completed_day(conn)\n    67\t    if not bound:\n    68\t        return last if unfiltered else default_as_of(conn)\n    69\t    if last is not None and bound > last:\n    70\t        raise BoundNotCompleted(bound, last)\n    71\t    return bound\n    72\t\n    73\t\n    74\tdef resolve_range(conn, start, end):\n    75\t    \"\"\"A range's end resolved by `resolve_bound` (an explicit future end is refused there); a start after the end is refused. A start\n    76\t    equal to the end reads as before: an empty window for `changes`, whose start is excluded, and that one day for `history`, whose\n    77\t    start is included; a client polling \"what changed since the day I last saw\" keeps its empty answer until a day completes\n    78\t    (council round 124). An end that resolves to None (an empty store) is compared with nothing, as before.\"\"\"\n    79\t    end = resolve_bound(conn, end)\n    80\t    if start and end is not None and start > end:\n    81\t        raise RangeNotOrdered(start, end)\n    82\t    return end\n    83\t\n    84\t\n    85\t_SEQ_DAYS = {}      # id(connection) → (connection, (max sequence, rows), map); a sqlite3 connection cannot carry attributes\n    86\t\n    87\t\n    88\tdef seq_day_map(conn):\n    89\t    \"\"\"sequence number → the publication day of the item or daily round written under it. Cached per connection and\n    90\t    rebuilt when processing_steps has grown (an open ledger gains steps while the pipeline runs); without the cache\n    91\t    one view with 367 pieces of evidence cost 1,224 full scans (0.46 s, measured 2026-10-24).\"\"\"\n    92\t    stamp = tuple(conn.execute('select max(sequence_no), count(*) from processing_steps').fetchone())\n    93\t    entry = _SEQ_DAYS.get(id(conn))\n    94\t    if entry is not None and entry[0] is conn and entry[1] == stamp:\n    95\t        return entry[2]\n    96\t    cache = {}\n    97\t    for seq, day in conn.execute('select sequence_no, min(publication_day) from processing_steps where sequence_no > 0 group by sequence_no'):\n    98\t        cache[seq] = day\n    99\t    if cache:                 # sequence 0 is the seed questions written before the first item (D253): visible from the ledger's first day\n   100\t        cache[0] = min(cache.values())\n   101\t    if len(_SEQ_DAYS) >= 64:\n   102\t        _SEQ_DAYS.clear()\n   103\t    _SEQ_DAYS[id(conn)] = (conn, stamp, cache)\n   104\t    return cache\n   105\t\n   106\t\n   107\tdef day_of_seq(conn, seq):\n   108\t    return seq_day_map(conn).get(seq)\n   109\t\n   110\t\n   111\tdef visible(conn, seq, as_of):\n   112\t    day = day_of_seq(conn, seq)\n   113\t    return day is not None and day <= as_of\n   114\t\n   115\t\n   116\t# ---------- views\n   117\t\n   118\tdef view_exists(conn, record, as_of):\n   119\t    return visible(conn, record['created_seq'], as_of)\n   120\t\n   121\t\n   122\tdef is_open_as_of(conn, view_id, as_of):\n   123\t    for row in conn.execute('select open, after_seq from view_switches where view_id=? order by id desc', (view_id,)):\n   124\t        if visible(conn, row['after_seq'], as_of):\n   125\t            return bool(row['open'])\n   126\t    return True\n   127\t\n   128\t\n   129\tdef state_as_of(conn, view_id, as_of):\n   130\t    \"\"\"The last judgement on or before the day, with the day the current position was first taken.\"\"\"\n   131\t    rows = [dict(r) for r in conn.execute('select * from judgements where view_id=? and publication_day<=? order by judgement_id', (view_id, as_of))]\n   132\t    if not rows:\n   133\t        return None\n   134\t    last = rows[-1]\n   135\t    since, previous = last['publication_day'], None\n   136\t    for row in reversed(rows[:-1]):\n   137\t        if row['rung'] != last['rung']:\n   138\t            previous = row['rung']\n   139\t            break\n   140\t        since = row['publication_day']\n   141\t    return {'position': last['rung'], 'judgement_day': last['publication_day'], 'since_day': since, 'previous_position': previous,\n   142\t            'rounds': len(rows), 'why_changed': last['why_changed'], 'reasons': last['reasons'], 'theme_pushes': _json(last.get('theme_pushes_json'))}\n   143\t\n   144\t\n   145\tdef summaries(conn, as_of=None, include_closed=False):\n   146\t    \"\"\"Every view as of the day as a light record (id, object, kind, what it looks at, the question, due day, open,\n   147\t    dependency and dependant ids): what a search ranks. The full record with its evidence counts is `view`; listing\n   148\t    92 of those cost 0.29 s per search (1,205 evidence reads), measured 2026-10-24.\"\"\"\n   149\t    as_of = resolve_bound(conn, as_of)\n   150\t    out = []\n   151\t    for record in conn.execute('select * from views order by created_seq'):\n   152\t        record = dict(record)\n   153\t        if not view_exists(conn, record, as_of):\n   154\t            continue\n   155\t        is_open = is_open_as_of(conn, record['view_id'], as_of)\n   156\t        if not include_closed and not is_open:\n   157\t            continue\n   158\t        out.append({'view_id': record['view_id'], 'object': record['object_id'], 'object_kind': record['object_kind'], 'kind': record['kind'],\n   159\t                    'looks_at': record['looks_at'], 'question': record['question'], 'due_day': record['due_day'], 'open': is_open,\n   160\t                    'dependencies': [d['view_id'] for d in dependencies(conn, record['view_id'], as_of)], 'dependants': dependants(conn, record['view_id'], as_of)})\n   161\t    return out\n   162\t\n   163\t\n   164\tdef views(conn, object_id=None, as_of=None, include_closed=False):\n   165\t    as_of = resolve_bound(conn, as_of)\n   166\t    rows = conn.execute('select * from views' + (' where object_id=?' if object_id else '') + ' order by created_seq', (object_id,) if object_id else ()).fetchall()\n   167\t    out = []\n   168\t    for record in rows:\n   169\t        record = dict(record)\n   170\t        if not view_exists(conn, record, as_of):\n   171\t            continue\n   172\t        if not include_closed and not is_open_as_of(conn, record['view_id'], as_of):\n   173\t            continue\n   174\t        out.append(view(conn, record['view_id'], as_of, record=record))\n   175\t    return out\n   176\t\n   177\t\n   178\tdef dependencies(conn, view_id, as_of):\n   179\t    \"\"\"The view's dependencies recorded on or before the day, each pointing at the target resolved on or before it.\"\"\"\n   180\t    out = []\n   181\t    for dep in conn.execute('select * from dependencies where view_id=? order by dependency_id', (view_id,)):\n   182\t        if not visible(conn, dep['seq'], as_of):\n   183\t            continue\n   184\t        target = dep['depends_on']\n   185\t        for res in conn.execute('select resolved_to, seq from dependency_resolutions where dependency_id=? order by id desc', (dep['dependency_id'],)):\n   186\t            if visible(conn, res['seq'], as_of):\n   187\t                target = res['resolved_to']\n   188\t                break\n   189\t        out.append({'view_id': target, 'direction': dep['direction'], 'wait_chain_view_id': dep['wait_chain_view_id'], 'wait_year': dep['wait_year'], 'since_day': day_of_seq(conn, dep['seq'])})\n   190\t    return out\n   191\t\n   192\t\n   193\tdef dependants(conn, view_id, as_of):\n   194\t    \"\"\"The views recorded on or before the day as depending on this one (directly or by a resolution).\"\"\"\n   195\t    direct = [r['view_id'] for r in conn.execute('select view_id, seq from dependencies where depends_on=?', (view_id,)) if visible(conn, r['seq'], as_of)]\n   196\t    resolved = [r['view_id'] for r in conn.execute('select d.view_id, r.seq from dependency_resolutions r join dependencies d on d.dependency_id=r.dependency_id where r.resolved_to=?', (view_id,)) if visible(conn, r['seq'], as_of)]\n   197\t    return sorted(set(direct + resolved))\n   198\t\n   199\t\n   200\tdef view(conn, view_id, as_of=None, record=None):\n   201\t    as_of = resolve_bound(conn, as_of)\n   202\t    record = record or store.view(conn, view_id)\n   203\t    if not record or not view_exists(conn, record, as_of):\n   204\t        return None\n   205\t    rungs = store.rungs_of(conn, view_id)\n   206\t    state = state_as_of(conn, view_id, as_of)\n   207\t    if state:\n   208\t        rung = next((r for r in rungs if r['position'] == state['position']), None)\n   209\t        state['label'] = rung['label'] if rung else None\n   210\t        state['condition'] = rung['condition'] if rung else None\n   211\t    in_force = evidence(conn, view_id, as_of)\n   212\t    return {\n   213\t        'view_id': view_id, 'object': record['object_id'], 'object_kind': record['object_kind'], 'kind': record['kind'],\n   214\t        'looks_at': record['looks_at'], 'question': record['question'], 'due_day': record['due_day'], 'year': record['year'],\n   215\t        'created_day': day_of_seq(conn, record['created_seq']), 'created_from': record['created_from_input'],\n   216\t        'as_of': as_of, 'open': is_open_as_of(conn, view_id, as_of), 'rungs': rungs, 'state': state,\n   217\t        'dependencies': dependencies(conn, view_id, as_of), 'dependants': dependants(conn, view_id, as_of),\n   218\t        'counts': {'rounds': state['rounds'] if state else 0, 'evidence': len(in_force), 'facts': sum(1 for e in in_force if vocabulary.canonical('tier', e['tier']) == TIER_FACT)},\n   219\t    }\n   220\t\n   221\t\n   222\t# ---------- evidence\n   223\t\n   224\tdef evidence_record(conn, evidence_id, as_of, arrived_seq=None):\n   225\t    \"\"\"One piece of evidence with only the sources recorded on or before the day (a later outlet of the same\n   226\t    sentence is not yet known on that day).\"\"\"\n   227\t    piece = store.evidence(conn, evidence_id)\n   228\t    if not piece:\n   229\t        return None\n   230\t    sources = [dict(s) for s in conn.execute('select input_id, category, publication_day, seq from evidence_sources where evidence_id=? order by id', (evidence_id,)) if visible(conn, s['seq'], as_of)]\n   231\t    replaces = conn.execute('select old_evidence_id, seq from replacements where new_evidence_id=?', (evidence_id,)).fetchone()\n   232\t    return {'evidence_id': piece['evidence_id'], 'one_line': piece['one_line'], 'quote': piece['quote'], 'tier': piece['tier'],\n   233\t            'speaker': piece['speaker'], 'original_who': piece['original_who'], 'original_day': piece['original_day'], 'event_time': piece['event_time'],\n   234\t            'day': day_of_seq(conn, arrived_seq if arrived_seq is not None else piece['created_seq']), 'sources': sources, 'outlets': len(sources),\n   235\t            'replaces': replaces['old_evidence_id'] if replaces and visible(conn, replaces['seq'], as_of) else None}\n   236\t\n   237\t\n   238\tdef evidence(conn, view_id, as_of=None, tier=None):\n   239\t    \"\"\"Evidence linked to the view on or before the day and not replaced on or before it, with its sources.\"\"\"\n   240\t    as_of = resolve_bound(conn, as_of)\n   241\t    out = []\n   242\t    for link in conn.execute('select evidence_id, seq from evidence_links where view_id=? order by id', (view_id,)):\n   243\t        if not visible(conn, link['seq'], as_of):\n   244\t            continue\n   245\t        replacement = conn.execute('select new_evidence_id, said_day, seq from replacements where old_evidence_id=? order by id desc limit 1', (link['evidence_id'],)).fetchone()\n   246\t        if replacement and visible(conn, replacement['seq'], as_of):\n   247\t            continue\n   248\t        piece = evidence_record(conn, link['evidence_id'], as_of, link['seq'])\n   249\t        if tier and piece['tier'] != tier:\n   250\t            continue\n   251\t        out.append(piece)\n   252\t    return out\n   253\t\n   254\t\n   255\t# ---------- history\n   256\t\n   257\tdef history(conn, view_id, from_day=None, to_day=None):\n   258\t    to_day = resolve_range(conn, from_day, to_day)\n   259\t    from_day = from_day or '0000-00-00'\n   260\t    judgements = []\n   261\t    previous = None\n   262\t    for row in conn.execute('select * from judgements where view_id=? order by judgement_id', (view_id,)):\n   263\t        entry = {'day': row['publication_day'], 'seq': row['seq'], 'position': row['rung'], 'changed': bool(row['changed']), 'moved_from': previous if previous is not None and previous != row['rung'] else None,\n   264\t                 'why_changed': row['why_changed'], 'reasons': row['reasons'], 'cited': _unique(_json(row['cited_evidence_json'])), 'pushes': _json(row['pushes_json']),\n   265\t                 'theme_pushes': _json(row['theme_pushes_json'] if 'theme_pushes_json' in row.keys() else None), 'round': row['input_id']}\n   266\t        previous = row['rung']\n   267\t        if from_day <= row['publication_day'] <= to_day:\n   268\t            judgements.append(entry)\n   269\t    arrivals = {}\n   270\t    for link in conn.execute('select evidence_id, seq from evidence_links where view_id=?', (view_id,)):\n   271\t        day = day_of_seq(conn, link['seq'])\n   272\t        if day and from_day <= day <= to_day:\n   273\t            piece = store.evidence(conn, link['evidence_id'])\n   274\t            bucket = arrivals.setdefault(day, {'evidence': 0, 'facts': 0})\n   275\t            bucket['evidence'] += 1\n   276\t            bucket['facts'] += int(vocabulary.canonical('tier', piece['tier']) == TIER_FACT)\n   277\t    replacements = [{'day': day_of_seq(conn, r['seq']), 'old': r['old_evidence_id'], 'new': r['new_evidence_id'], 'said_day': r['said_day']}\n   278\t                    for r in conn.execute('select r.* from replacements r join evidence_links l on l.evidence_id=r.new_evidence_id where l.view_id=?', (view_id,))\n   279\t                    if day_of_seq(conn, r['seq']) and from_day <= day_of_seq(conn, r['seq']) <= to_day]\n   280\t    switches = [{'day': day_of_seq(conn, s['after_seq']), 'open': bool(s['open']), 'reason': s['reason']}\n   281\t                for s in conn.execute('select * from view_switches where view_id=? order by id', (view_id,)) if day_of_seq(conn, s['after_seq']) and from_day <= day_of_seq(conn, s['after_seq']) <= to_day]\n   282\t    return {'view_id': view_id, 'from_day': from_day, 'to_day': to_day, 'judgements': judgements,\n   283\t            'changes': [j for j in judgements if j['moved_from'] is not None], 'arrivals': dict(sorted(arrivals.items())),\n   284\t            'replacements': replacements, 'switches': switches}\n   285\t\n   286\t\n   287\tclass LedgerError(ValueError):\n   288\t    \"\"\"A ledger record the service cannot read (corrupt JSON): refused, never read as empty.\"\"\"\n   289\t\n   290\t\n   291\tclass StoreUnreadable(LedgerError):\n   292\t    \"\"\"The store could not be opened, or its read transaction begun and pinned (live-service/OPERATING-CONTRACT.md, row 1): named by\n   293\t    its path, never answered with an empty or stale state.\"\"\"\n   294\t\n   295\t\n   296\tdef open_pinned(path):\n   297\t    \"\"\"A reader's connection with its committed state pinned (row 2: `BEGIN`, then a first read, which in WAL mode fixes the state\n   298\t    every later read of the request sees). A SQLite failure in these three steps closes what was opened and raises `StoreUnreadable`\n   299\t    naming the path; a later SQLite error is not covered here.\"\"\"\n   300\t    conn = None\n   301\t    try:\n   302\t        conn = open_ledger(path)\n   303\t        conn.execute('begin')\n   304\t        conn.execute('select 1 from sqlite_master limit 1').fetchone()\n   305\t        return conn\n   306\t    except sqlite3.Error as error:\n   307\t        if conn is not None:\n   308\t            conn.close()\n   309\t        raise StoreUnreadable(f'{path}: {error}') from error\n   310\t\n   311\t\n   312\tdef _unique(ids):\n   313\t    \"\"\"A judgement's cites as the UI contract reads them: each id once, first occurrence kept. The writer stores the set from\n   314\t    2026-10-28; the sealed ledger sealed-2026-10-28-v34-nvda-3m-through-0828 holds one judgement (v2, id 736) that cites an id twice.\"\"\"\n   315\t    seen, out = set(), []\n   316\t    for value in ids:\n   317\t        if value not in seen:\n   318\t            seen.add(value)\n   319\t            out.append(value)\n   320\t    return out\n   321\t\n   322\t\n   323\tdef _json(text):\n   324\t    if not text:\n   325\t        return []\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_17","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba src/hivemind/placement.py | sed -n '1,140p'\"","aggregated_output":"     1\t\"\"\"What the extraction reads about each open question (D256, D274): one line per question with its 'takes' line, written by code from\n     2\tthe question's key and its research group, and the filing rule the schema states beside the evidence field `links`. A statement the\n     3\textraction links to no open question and to no kept candidate is dropped as 'no home' (D209); a link to one of the answer's own\n     4\tcandidates (c1 …) is matched by CANDIDATE_ID.\"\"\"\n     5\timport re\n     6\t\n     7\tCANDIDATE_ID = re.compile(r'^c\\d+$')\n     8\t\n     9\t\n    10\tdef matter(view):\n    11\t    \"\"\"The research group(s) the thesis belongs to: the matter's other names in the press and what is happening (D149 aliases).\"\"\"\n    12\t    parts = []\n    13\t    for g in view.get('groups') or []:\n    14\t        names = [a for a in (g.get('aliases') or []) if a and a != g.get('name')]\n    15\t        parts.append(f\"the matter '{g['name']}'\" + (f\" (also called {', '.join(names)})\" if names else '') + f\": {g['scope']}\")\n    16\t    return '; '.join(parts)\n    17\t\n    18\t\n    19\tdef takes(view):\n    20\t    \"\"\"What a question collects, from its key and its research group: the one sentence the extraction reads beside the question.\n    21\t    A file holds the question's own figures or steps and the evidence that bears on its answer (D259; the standard's 5.1 test: what\n    22\t    makes the answer more or less likely, through demand, supply, competition or pricing, D250 item 2's four paths); the\n    23\t    links field's rule says how to apply it (FILING_RULE_ROOT_FALLBACK). A numeric line names only its quantity, scope and period: the\n    24\t    four paths and the other-period allowance are stated once, in that rule, not repeated under every numeric question (D274).\"\"\"\n    25\t    key = view.get('key') or {}\n    26\t    measure, scope = key.get('measure') or '', key.get('scope') or view.get('looks_at') or view.get('object_id')\n    27\t    tail = f\"; statements about {matter(view)} belong here under any of those names\" if matter(view) else ''\n    28\t    if measure == 'policy_event':\n    29\t        return (f\"takes: the decisions, drafts, approvals, denials and deadlines of this process, its enforcement and evasion, any statement of \"\n    30\t                f\"whether and how much the permitted or restricted activity is actually happening, and the affected parties' own plans and \"\n    31\t                f\"statements about it: {scope}{tail}\")\n    32\t    if measure == 'event':\n    33\t        if key.get('event_type') in ('launch', 'shipment', 'deployment'):\n    34\t            return (f\"takes: steps, dates, delays, cancellations, design or configuration changes, variants and stopgaps of this event, \"\n    35\t                    f\"confirmations and denials, and named customers' statements about receiving it: {scope}{tail}\")\n    36\t        return (f\"takes: the terms, amounts, counterparties, agreements and approvals of this obligation or deal, its steps, confirmations and \"\n    37\t                f\"denials, and the counterparties' own plans, financing and demand that bear on it: {scope}{tail}\")\n    38\t    measure_name = f\"{measure} \" if measure and measure != 'other' else ''   # 'other' is the key's catch-all, not a word for the reader\n    39\t    # D268 (2026-11-02, the first prompt audit, design-v72.md §12 row D): the period is named as the question's own, not as a bound on what\n    40\t    # the file takes; an estimate for another period or population of the same quantity is filed here when no open question covers it\n    41\t    # (D248 allows calendar-year estimates under fiscal-year questions; D240: a missing period is no reason to drop)\n    42\t    return f\"takes: {measure_name}figures, guidance, estimates and revisions for {scope}, this question's period {key.get('period_start')}..{key.get('period_end')}{tail}\"\n    43\t\n    44\t\n    45\t# Extraction v74i, the frozen production prompt (D274; design-v78-fields.md §13, the second Codex review): the takes lines' shared tail and period\n    46\t# allowance are stated once here, beside the field, with the company-wide revenue question as the home of indirect evidence no specific question takes.\n    47\tFILING_RULE_ROOT_FALLBACK = ('The questions this statement is filed under, decided after you have decided it is evidence: the id of the narrowest open question in '\n    48\t                             '[Open questions] whose answer this statement makes more or less likely, as that question\\'s own figure, step or estimate or through '\n    49\t                             'the demand, supply, competition or pricing behind its answer; compare the specific questions before a company-wide revenue or margin '\n    50\t                             'question and take that one only, never a broader question beside it; a shared company, industry, event or ecosystem is not a '\n    51\t                             'connection, and the statement need not repeat the question\\'s words (a variant, sibling or other name of the subject counts); whoever '\n    52\t                             'says it, and even when it gives no period, basis or exact amount, because the weight is judged later; an estimate for another period '\n    53\t                             'or population of a question\\'s quantity is filed under it when no open question covers that period; when no specific question is '\n    54\t                             'connected, a statement that moves the demand, supply, competition or pricing behind the company\\'s results goes to the company-wide '\n    55\t                             'revenue question of its period; plus the ids of this answer\\'s candidates the statement supports; empty when no question and no '\n    56\t                             'candidate is connected, however important it sounds.')\n    57\t\n    58\t\n    59\tdef question_lines(shown):\n    60\t    \"\"\"One line per open question with its takes line below it: what the extraction reads under [Open questions].\"\"\"\n    61\t    return [f\"  - {v['view_id']} ({v['object_id']}, due {v['due_day']}): {v['question']}\\n      {takes(v)}\" for v in shown]\n","exit_code":0,"status":"completed"}}
