schema, not by prose\n    91\t                    'year': {'type': 'string'}, 'evidence_ids': {'type': 'array', 'items': {'type': 'string'}}}}},\n    92\t        },\n    93\t    }\n    94\t\n    95\t\n    96\t# keyed-views-plan.md 2.1 and D167: the key a candidate carries; a market's size and a project's cost are measures of their own\n    97\tMEASURES = ['total_revenue', 'segment_revenue', 'product_revenue', 'gross_margin', 'operating_margin', 'operating_expense_growth', 'total_expenses', 'operating_loss',\n    98\t            'tax_rate', 'capex', 'shipments_or_capacity', 'run_rate', 'design_wins', 'event', 'spend_total', 'market_size', 'project_cost', 'financing_amount',\n    99\t            'price', 'capacity', 'growth_rate', 'policy_event', 'other']\n   100\tEVENT_TYPES = ['launch', 'shipment', 'licence', 'approval', 'deal_close', 'deployment', 'other', 'n/a']\n   101\tBASES = ['GAAP', 'non_GAAP', 'n/a']\n   102\tUNITS = ['USD', 'percent', 'count', 'GW', 'MW', 'TWD', 'multiple', 'n/a']\n   103\t\n   104\t\n   105\tdef key_fields():\n   106\t    return {'measure': {'type': 'string', 'enum': list(MEASURES)}, 'scope': {'type': 'string'},\n   107\t            'period_start': {'type': 'string', 'pattern': r'^\\d{4}-\\d{2}-\\d{2}$'}, 'period_end': {'type': 'string', 'pattern': r'^\\d{4}-\\d{2}-\\d{2}$'},\n   108\t            'basis': {'type': 'string', 'enum': BASES}, 'unit': {'type': 'string', 'enum': UNITS}, 'event_type': {'type': 'string', 'enum': EVENT_TYPES}}\n   109\t\n   110\t\n   111\tBOUND = {'anyOf': [{'type': 'number'}, {'type': 'null'}]}\n   112\t\n   113\t\n   114\tdef keyed_schema():\n   115\t    \"\"\"The base schema with the key fields on every candidate and numeric bounds on every rung.\"\"\"\n   116\t    schema = base_schema()\n   117\t    candidate = schema['properties']['candidates']['items']\n   118\t    fields = key_fields()\n   119\t    candidate['properties'].update(fields)\n   120\t    candidate['required'] += list(fields)\n   121\t    rung = candidate['properties']['rungs']['items']\n   122\t    rung['properties'].update({'lo': BOUND, 'hi': BOUND})\n   123\t    rung['required'] += ['lo', 'hi']\n   124\t    return schema\n   125\t\n   126\t\n   127\tLOCAL_GROUP = r'n[1-9][0-9]*'\n   128\t# a company's own reported or guided lines: they belong to the company and never found a research group by themselves\n   129\tFINANCIAL_LINES = {'total_revenue', 'segment_revenue', 'gross_margin', 'operating_margin', 'operating_expense_growth', 'total_expenses', 'operating_loss', 'tax_rate', 'capex', 'run_rate'}\n   130\t\n   131\t\n   132\tdef tracks_a_matter(candidate):\n   133\t    \"\"\"A candidate that can start a research group: a theme quantity, an event or policy event, a product or market figure;\n   134\t    not a company's own financial line (which may join a group another thesis started, never found one).\"\"\"\n   135\t    return candidate.get('kind') == 'theme' or candidate.get('measure') not in FINANCIAL_LINES\n   136\t\n   137\t\n   138\t\n   139\tdef grouped_schema():\n   140\t    \"\"\"The keyed schema plus research-group membership (D149, D166, D211): the request shows no stored group, so each candidate cites\n   141\t    only local ids it declares in new_groups with their aliases; code folds a declared group into a stored one by its names.\"\"\"\n   142\t    schema = keyed_schema()\n   143\t    pattern = '^(?:' + LOCAL_GROUP + ')$'\n   144\t    candidate = schema['properties']['candidates']['items']\n   145\t    candidate['properties']['group_refs'] = {'type': 'array', 'items': {'type': 'string', 'pattern': pattern}}\n   146\t    candidate['required'].append('group_refs')\n   147\t    group_fields = {'id': {'type': 'string', 'pattern': '^' + LOCAL_GROUP + '$'}, 'name': {'type': 'string'}, 'scope': {'type': 'string'},\n   148\t                    'aliases': {'type': 'array', 'items': {'type': 'string'}}}\n   149\t    schema['properties']['new_groups'] = {'type': 'array', 'items': {'type': 'object', 'additionalProperties': False, 'required': list(group_fields), 'properties': group_fields}}\n   150\t    schema['required'].append('new_groups')\n   151\t    return schema\n   152\t\n   153\t\n   154\tdef with_field_notes(schema, notes):\n   155\t    \"\"\"The schema with the notes as the descriptions of the evidence fields they name.\"\"\"\n   156\t    fields = schema['properties']['evidence']['items']['properties']\n   157\t    for name, note in notes.items():\n   158\t        fields[name] = dict(fields[name], description=note)\n   159\t    return schema\n   160\t\n   161\t\n   162\tdef schema_for(version, shown_view_ids=()):\n   163\t    \"\"\"The answer's schema: the grouped schema, the admission fields (D184: the reason a candidate opens and the material that settles\n   164\t    it), the attribution fields' definitions and the filing rule beside the links field (D256, D274). The request shows its questions\n   165\t    in the text and names none in the schema, so shown_view_ids does not change it.\"\"\"\n   166\t    require_supported(version)\n   167\t    schema = grouped_schema()\n   168\t    candidate = schema['properties']['candidates']['items']\n   169\t    candidate['properties'].update({'opens_as': {'type': 'string', 'enum': list(ADMISSION_REASONS)}, 'settled_by': {'type': 'string'}})\n   170\t    candidate['required'] += ['opens_as', 'settled_by']\n   171\t    return with_field_notes(schema, dict(FIELD_NOTES, links=placement.FILING_RULE_ROOT_FALLBACK))\n   172\t\n   173\t\n   174\t@dataclasses.dataclass\n   175\tclass Handover:\n   176\t    evidence: list\n   177\t    candidates: list\n   178\t    dropped: list\n   179\t    call_id: int\n   180\t    request_sha256: str\n   181\t    cached: bool\n   182\t    cost_usd: float\n   183\t    new_groups: list = dataclasses.field(default_factory=list)      # the declared groups a kept candidate cites: {id, name, scope}\n   184\t\n   185\t\n223:def open_read_only(path):\n224-    \"\"\"The views database for a reader (the agent layer, reports): no schema creation, no writes. Opened by its own path: a symlink\n225-    resolved, a store with another hard link refused (`live_lock.LockRefused`; live-service/OPERATING-CONTRACT.md, row 7), since\n226-    SQLite finds a WAL store's side files by the opened path.\"\"\"\n227-    from hivemind import live_lock\n228-    real, _ = live_lock.own_path(path)\n229-    conn = sqlite3.connect(f'file:{real}?mode=ro', uri=True, timeout=READ_BUSY_TIMEOUT_SECONDS)\n230-    conn.row_factory = sqlite3.Row\nrg: src/hivemind/items.py: IO error for operation on src/hivemind/items.py: No such file or directory (os error 2)\n","exit_code":2,"status":"failed"}}
