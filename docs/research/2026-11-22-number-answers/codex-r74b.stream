{"type":"item.completed","item":{"id":"item_27","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc 'nl -ba /private/tmp/claude-501/-Users-lchingen-hivemind/f1ea972d-85a1-4f27-8010-cf0b60054109/scratchpad/oneline_census.py'","aggregated_output":"     1\t\"\"\"$0 census: evidence summaries (one_line) that state a number their quote does not contain.\"\"\"\n     2\timport re, sys, random\n     3\tsys.path.insert(0, '/Users/lchingen/hivemind/src')\n     4\tfrom hivemind import service\n     5\tNUMBER = re.compile(r'\\d+(?:[.,]\\d+)*')\n     6\tdef numbers(text):\n     7\t    return {n.replace(',', '').rstrip('.').lstrip('0') or '0' for n in NUMBER.findall(text or '')}\n     8\tSTORES = {\n     9\t    'old-1': 'poc/data/comparison-2026-11-17/run/old-1/prod/views.sqlite',\n    10\t    'old-2': 'poc/data/comparison-2026-11-17/run/old-2/prod/views.sqlite',\n    11\t    'old-3': 'poc/data/comparison-2026-11-17/run/old-3/prod/views.sqlite',\n    12\t    'served': 'poc/data/served-2026-10-28-v34-nvda-3m-through-0828/views.sqlite',\n    13\t}\n    14\trandom.seed(7)\n    15\tfor name, path in STORES.items():\n    16\t    conn = service.open_ledger('/Users/lchingen/hivemind/' + path)\n    17\t    as_of = service.resolve_bound(conn, None)\n    18\t    seen, fail, no_digits, samples = set(), [], 0, []\n    19\t    for row in conn.execute('select view_id from views'):\n    20\t        for e in service.evidence(conn, row['view_id'], as_of):\n    21\t            if e['evidence_id'] in seen:\n    22\t                continue\n    23\t            seen.add(e['evidence_id'])\n    24\t            extra = numbers(e['one_line']) - numbers(e['quote'])\n    25\t            if not numbers(e['one_line']):\n    26\t                no_digits += 1\n    27\t            if extra:\n    28\t                fail.append((e['evidence_id'], sorted(extra), e['one_line'][:160], e['quote'][:160]))\n    29\t    print(f'== {name}: evidence in force {len(seen)}; summaries with a number not in the quote {len(fail)} ({len(fail)/len(seen):.1%}); summaries with no number {no_digits}')\n    30\t    for f in random.sample(fail, min(6, len(fail))):\n    31\t        print('   ', f[0], f[1], '\\n      S:', f[2], '\\n      Q:', f[3])\n","exit_code":0,"status":"completed"}}
