{"type":"item.completed","item":{"id":"item_24","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba src/hivemind/extraction.py | sed -n '432,500p'; rg -n 'research_context|def evidence\\\\(|create table if not exists (evidence|rungs|view_keys|view_switches)' src scripts | head -75\"","aggregated_output":"   432\t\n   433\t# 06-views ladder rule 6: a quarterly or half-year figure is evidence, not a view. The half-year forms name a revenue\n   434\t# or sales figure (H1 收入, first-half revenue); an event scheduled in a half-year (ships in H2 2026) is not a figure.\n   435\tQUARTERLY = re.compile(r'(\\bQ[1-4]\\b|第[一二三四1-4]季|季度|\\bquarter(?!ly report)|fiscal Q[1-4]|\\b(?:[12]H|H[12])\\b(?:\\s+(?:FY)?\\d{4})?\\s*收入|上半年收入|下半年收入'\n   436\t                       r'|\\b(?:[12]H|H[12])\\b(?:\\s+(?:FY)?\\d{4})?\\s+(?:revenue|sales|net sales)|\\b(?:first|second)[- ]half(?:[- ]year)?\\s+(?:revenue|sales|net sales)'\n   437\t                       r'|\\bhalf[- ]year\\s+(?:revenue|sales|net sales))', re.I)\n   438\t\n   439\t\n   440\tdef request_for(cfg, item, text, shown_views, universe):\n   441\t    \"\"\"Build the setting, complete prompt and schema without making a call.\"\"\"\n   442\t    setting = cfg.extraction_setting(item['category'])\n   443\t    version = setting.prompt_version.rpartition('-')[2]\n   444\t    system, user = build_prompt(item, text, shown_views, universe, version)\n   445\t    return setting, system, user, schema_for(version)\n   446\t\n   447\t\n   448\t@dataclasses.dataclass\n   449\tclass Reading:\n   450\t    \"\"\"An item read: the extraction answer through the code checks, before the handover (the parallel day prepares it early and\n   451\t    files it at the item's turn).\"\"\"\n   452\t    evidence: list\n   453\t    candidates: list\n   454\t    dropped: list\n   455\t    new_groups: list\n   456\t    answer: object\n   457\t    version: str\n   458\t\n   459\t\n   460\tdef read_item(archive, cfg, item, text, shown_views, universe, *, transport=None):\n   461\t    \"\"\"The extraction call and the code checks on its answer: a statement may link to a shown question or to a kept candidate.\"\"\"\n   462\t    setting, system, user, schema = request_for(cfg, item, text, shown_views, universe)\n   463\t    answer = model.call(archive, cfg, setting, system, user, schema, 'extraction', 'extract', transport=transport)\n   464\t    evidence, candidates, dropped, new_groups = sift_with_groups(answer.data, item, text, {v['view_id'] for v in shown_views}, universe)\n   465\t    return Reading(evidence, candidates, dropped, new_groups, answer, setting.prompt_version.rpartition('-')[2])\n   466\t\n   467\t\n   468\tdef file_reading(reading, item, shown_views):\n   469\t    \"\"\"The handover: the extraction's own links are the filing (D256). A statement linked to a question and to a question that\n   470\t    question depends on keeps the narrower one (D207); a statement no open question and no kept candidate takes is dropped as 'no\n   471\t    home' (D209), like every other drop: a candidate left with none of its evidence is dropped too, and a statement whose only link was\n   472\t    such a candidate has no home.\"\"\"\n   473\t    candidates, dropped, answer = reading.candidates, list(reading.dropped), reading.answer\n   474\t    parents = {v['view_id']: v.get('parents') or [] for v in shown_views}\n   475\t    evidence = [dict(e, links=narrowest_links(e['links'], parents)) for e in reading.evidence]\n   476\t    while True:\n   477\t        candidates = candidates_with_evidence(candidates, {e['id'] for e in evidence}, item, dropped)\n   478\t        candidate_ids = {c['id'] for c in candidates}\n   479\t        evidence = [dict(e, links=[l for l in e['links'] if not placement.CANDIDATE_ID.match(l) or l in candidate_ids]) for e in evidence]\n   480\t        homeless = [e for e in evidence if not e['links']]\n   481\t        if not homeless:\n   482\t            break\n   483\t        dropped.extend((e['id'], 'no home') for e in homeless)\n   484\t        evidence = [e for e in evidence if e['links']]\n   485\t    return Handover(evidence, candidates, dropped, answer.call_id, answer.request_sha256, answer.cached, answer.cost_usd, reading.new_groups)\n   486\t\n   487\t\n   488\tdef extract(archive, cfg, item, text, shown_views, universe, *, transport=None):\n   489\t    \"\"\"One item through extraction: read, then file under the questions shown.\"\"\"\n   490\t    return file_reading(read_item(archive, cfg, item, text, shown_views, universe, transport=transport), item, shown_views)\n   491\t\n   492\t\n   493\tdef check_bounds(rungs):\n   494\t    \"\"\"None when the rungs' numeric bounds form one unbroken partition (or none carries bounds), else the problem.\"\"\"\n   495\t    bounded = [r for r in rungs if r.get('lo') is not None or r.get('hi') is not None]\n   496\t    if not bounded:\n   497\t        return None\n   498\t    if len(bounded) != len(rungs):\n   499\t        return 'some rungs carry bounds and some do not'\n   500\t    ordered = sorted(rungs, key=lambda r: -1e300 if r.get('lo') is None else float(r['lo']))\nscripts/hivemind_mcp.py:144:def evidence(view_id: str, as_of: str = '', tier: str = '') -> list:\nsrc/hivemind/views/store.py:418:def evidence(conn, evidence_id):\nsrc/hivemind/research_context.py:74:    def evidence(self, eid):\nsrc/hivemind/service.py:238:def evidence(conn, view_id, as_of=None, tier=None):\n","exit_code":0,"status":"completed"}}
