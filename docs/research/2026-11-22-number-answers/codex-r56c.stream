":\"revenue\",\"scope\":\"company\",\"period\":\"FY2027 Q2\"},\"kind\":\"source\",\"basis\":\"guidance\",\"value\":91.0,\"low\":null,\"high\":null,\"unit\":\"USD bn\",\"evidence_id\":\"e3200\",\"quote_number\":\"$91.0 billion\",\"qualifier\":\"none\",\"inputs\":null,\"operation\":null,\"basis_text\":null,\"rests_on\":null,\"outcome_for\":[],\"reference_for\":[]},{\"id\":\"F6\",\"what\":{\"population\":\"NVIDIA\",\"measure\":\"revenue versus guidance midpoint\",\"scope\":\"company\",\"period\":\"FY2027 Q2\"},\"kind\":\"computed\",\"basis\":\"reported\",\"value\":5.71,\"low\":null,\"high\":null,\"unit\":\"%\",\"evidence_id\":null,\"quote_number\":null,\"qualifier\":null,\"inputs\":[\"F5\",\"F2\"],\"operation\":\"growth\",\"basis_text\":null,\"rests_on\":null,\"outcome_for\":[],\"reference_for\":[]},{\"id\":\"F7\",\"what\":{\"population\":\"NVIDIA\",\"measure\":\"revenue\",\"scope\":\"company\",\"period\":\"FY2027 Q3\"},\"kind\":\"source\",\"basis\":\"third_party\",\"value\":113.6,\"low\":null,\"high\":null,\"unit\":\"USD bn\",\"evidence_id\":\"e5056\",\"quote_number\":\"$113.6 billion\",\"qualifier\":\"roughly\",\"inputs\":null,\"operation\":null,\"basis_text\":null,\"rests_on\":null,\"outcome_for\":[],\"reference_for\":[]},{\"id\":\"F8\",\"what\":{\"population\":\"NVIDIA\",\"measure\":\"revenue\",\"scope\":\"company\",\"period\":\"FY2027 Q3\"},\"kind\":\"estimate\",\"basis\":\"forecast\",\"value\":112.5,\"low\":null,\"high\":null,\"unit\":\"USD bn\",\"evidence_id\":null,\"quote_number\":null,\"qualifier\":null,\"inputs\":null,\"operation\":null,\"basis_text\":\"My estimate: the Q3 guidance midpoint of $108.0 billion plus a beat of about 4%. That is smaller than the 5.7% by which Q2 beat its midpoint and below the third-party $113.6 billion (3.1% over the high end of guidance), because supply covers only about 70% of demand and capacity is reported sold out, which limits room for a large upside surprise.\",\"rests_on\":[\"F4\",\"F6\",\"F7\",\"e2452\",\"e5054\",\"e3733\",\"e4911\"],\"outcome_for\":[],\"reference_for\":[]},{\"id\":\"F9\",\"what\":{\"population\":\"NVIDIA\",\"measure\":\"revenue sequential growth\",\"scope\":\"company\",\"period\":\"FY2027 Q3\"},\"kind\":\"computed\",\"basis\":\"guidance\",\"value\":12.27,\"low\":null,\"high\":null,\"unit\":\"%\",\"evidence_id\":null,\"quote_number\":null,\"qualifier\":null,\"inputs\":[\"F2\",\"F4\"],\"operation\":\"growth\",\"basis_text\":null,\"rests_on\":null,\"outcome_for\":[],\"reference_for\":[]},{\"id\":\"F10\",\"what\":{\"population\":\"NVIDIA\",\"measure\":\"revenue\",\"scope\":\"company\",\"period\":\"FY2027 Q4\"},\"kind\":\"computed\",\"basis\":\"forecast\",\"value\":126.3,\"low\":null,\"high\":null,\"unit\":\"USD bn\",\"evidence_id\":null,\"quote_number\":null,\"qualifier\":null,\"inputs\":[\"F8\",\"F9\"],\"operation\":\"apply_growth\",\"basis_text\":null,\"rests_on\":null,\"outcome_for\":[],\"reference_for\":[]},{\"id\":\"F11\",\"what\":{\"population\":\"NVIDIA\",\"measure\":\"revenue\",\"scope\":\"company\",\"period\":\"FY2027\"},\"kind\":\"computed\",\"basis\":\"forecast\",\"value\":416.62,\"low\":null,\"high\":null,\"unit\":\"USD bn\",\"evidence_id\":null,\"quote_number\":null,\"qualifier\":null,\"inputs\":[\"F3\",\"F8\",\"F10\"],\"operation\":\"sum\",\"basis_text\":null,\"rests_on\":null,\"outcome_for\":[\"v4\"],\"reference_for\":[]},{\"id\":\"F12\",\"what\":{\"population\":\"NVIDIA\",\"measure\":\"revenue\",\"scope\":\"company\",\"period\":\"FY2027\"},\"kind\":\"source\",\"basis\":\"consensus\",\"value\":411,\"low\":null,\"high\":null,\"unit\":\"USD bn\",\"evidence_id\":\"e4333\",\"quote_number\":\"$411 billion\",\"qualifier\":\"none\",\"inputs\":null,\"operation\":null,\"basis_text\":null,\"rests_on\":null,\"outcome_for\":[],\"reference_for\":[\"v4\"]},{\"id\":\"F13\",\"what\":{\"population\":\"NVIDIA\",\"measure\":\"revenue\",\"scope\":\"company\",\"period\":\"FY2026\"},\"kind\":\"source\",\"basis\":\"reported\",\"value\":215.9,\"low\":null,\"high\":null,\"unit\":\"USD bn\",\"evidence_id\":\"e4273\",\"quote_number\":\"$215.9 billion\",\"qualifier\":\"none\",\"inputs\":null,\"operation\":null,\"basis_text\":null,\"rests_on\":null,\"outcome_for\":[],\"reference_for\":[]},{\"id\":\"F14\",\"what\":{\"population\":\"NVIDIA\",\"measure\":\"revenue growth\",\"scope\":\"company\",\"period\":\"FY2027\"},\"kind\":\"computed\",\"basis\":\"forecast\",\"value\":92.97,\"low\":null,\"high\":null,\"unit\":\"%\",\"evidence_id\":null,\"quote_number\":null,\"qualifier\":null,\"inputs\":[\"F13\",\"F11\"],\"operation\":\"growth\",\"basis_text\":null,\"rests_on\":null,\"outcome_for\":[],\"reference_for\":[]}],\"answers\":[{\"view_id\":\"v4\",\"shape\":\"forecast\",\"rung\":2,\"reference_unavailable\":null,\"reasons\":\"Reference: the analyst consensus for FY2027 revenue is $411 billion (e4333, repeated in e4594 and e5204). That sits in rung 2 ($392 billion to below $431.2 billion). Build: reported Q1 ($81.62 billion) and Q2 ($96.2 billion) give $177.82 billion for H1. Q3 guidance is $108.0 billion plus or minus 2%, and it assumes no China data-center compute revenue. NVIDIA beat its Q2 midpoint by 5.7% ($96.2 billion against $91.0 billion, e3200). It also beat its Q4 FY2026 guidance ($68 billion against $65 billion, e2452). A third-party record puts recent actuals about 3.1% above the high end of guidance, which would mean roughly $113.6 billion (e5055, e5056). Supply covers only about 70% of demand, capacity is sold out and supply stays constrained through FY2028 (e3733, e4911, e5067), so I take a smaller beat: Q3 at about $112.5 billion (my estimate). For Q4 I carry the guided 12.27% sequential growth forward, which gives about $126.3 billion. That rate is not aggressive. Management says hyperscale growth reaccelerates in Q4 as Vera Rubin supply builds (e3406, e4283). Vera Rubin is already about 20% of Q3 data-center revenue (e2721), with purchase orders from every major hyperscaler (e2693). Supply commitments rose from $119 billion to $279 billion (e2759). On the other side, memory and power limits argue against a much faster step. FY2027 comes out at about $416.6 billion, or about 93% growth on FY2026's $215.9 billion. That growth is consistent with the guided Q3 growth of about 89%, and the total is inside rung 2. Boundaries: rung 1 needs Q3 plus Q4 of at least about $253 billion, which means Q4 sequential growth above roughly 20% even after a strong Q3. That is unlikely under the stated supply limits. Rung 3 needs Q3 plus Q4 below about $214 billion, which means a roughly flat Q4 at the low end of Q3 guidance. That contradicts the guided Q4 reacceleration. The items saying 70% growth for the full fiscal year (e3280, e3890, e4628) I read as the FY2028 outlook. The call transcript (e2691) and e5227 place the roughly 70% at FY2028. Applied to FY2026, 70% would require Q4 revenue far below the guided Q3, which H1 actuals and Q3 guidance rule out. Morningstar's $361 billion data-center estimate (e2295) predates the Q2 report and implies a flat second half, so it moves the forecast little. SemiAnalysis's call that second-half data-center revenue will beat estimates by 20% (e1135) points up, but it gives no base. Competing AMD and custom-chip commitments matter more for later years than for a supply-constrained FY2027. Themes: CY2027 hyperscaler capex is judged above the market reference (v7), and China H200 purchases are judged likely to see limited authorization (v9), which Q3 guidance excludes. Both are small upside within rung 2. I have not sized them separately; the beat and Q4 assumptions absorb them, so China is not judged at zero. CY2026 capex (v6) is in line with its reference.\",\"why\":null,\"cites\":[\"e111\",\"e2649\",\"e4992\",\"e3200\",\"e2452\",\"e2652\",\"e5055\",\"e5056\",\"e3733\",\"e4911\",\"e5067\",\"e3406\",\"e4283\",\"e2721\",\"e2693\",\"e2759\",\"e4273\",\"e4333\",\"e3280\",\"e2691\",\"e5227\",\"e2295\",\"e1135\"],\"pushes\":[{\"evidence_id\":\"e2649\",\"push\":\"toward_first\"},{\"evidence_id\":\"e3200\",\"push\":\"toward_first\"},{\"evidence_id\":\"e2452\",\"push\":\"toward_first\"},{\"evidence_id\":\"e2652\",\"push\":\"toward_first\"},{\"evidence_id\":\"e5055\",\"push\":\"toward_first\"},{\"evidence_id\":\"e5056\",\"push\":\"toward_first\"},{\"evidence_id\":\"e2693\",\"push\":\"toward_first\"},{\"evidence_id\":\"e2721\",\"push\":\"toward_first\"},{\"evidence_id\":\"e3406\",\"push\":\"toward_first\"},{\"evidence_id\":\"e4283\",\"push\":\"toward_first\"},{\"evidence_id\":\"e2759\",\"push\":\"toward_first\"},{\"evidence_id\":\"e1135\",\"push\":\"toward_first\"},{\"evidence_id\":\"e3733\",\"push\":\"toward_last\"},{\"evidence_id\":\"e4911\",\"push\":\"toward_last\"},{\"evidence_id\":\"e5067\",\"push\":\"toward_last\"},{\"evidence_id\":\"e2295\",\"push\":\"toward_last\"},{\"evidence_id\":\"e3280\",\"push\":\"none\"},{\"evidence_id\":\"e2691\",\"push\":\"none\"},{\"evidence_id\":\"e4333\",\"push\":\"none\"},{\"evidence_id\":\"e111\",\"push\":\"none\"},{\"evidence_id\":\"e1040\",\"push\":\"none\"},{\"evidence_id\":\"e2776\",\"push\":\"none\"}],\"theme_pushes\":[{\"view_id\":\"v6\",\"push\":\"none\"},{\"view_id\":\"v7\",\"push\":\"toward_first\"},{\"view_id\":\"v9\",\"push\":\"toward_first\"}]}]}\n","exit_code":0,"status":"completed"}}
