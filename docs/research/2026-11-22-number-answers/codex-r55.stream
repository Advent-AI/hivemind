review.stderr\npoc/data/clean-step1-full-page-diagnostic-2026-11-07/council-round5-handoff.txt\npoc/data/clean-step1-full-page-diagnostic-2026-11-07/council-round2.exit\npoc/data/clean-step1-full-page-diagnostic-2026-11-07/council-round8.jsonl\npoc/data/clean-step1-full-page-diagnostic-2026-11-07/council-round4.stderr\npoc/data/clean-step1-full-page-diagnostic-2026-11-07/council-round5-response.md\npoc/data/clean-step1-full-page-diagnostic-2026-11-07/council-round8.stderr\npoc/data/clean-step1-full-page-diagnostic-2026-11-07/council-round6.stderr\npoc/data/clean-step1-full-page-diagnostic-2026-11-07/council-round2.jsonl\npoc/data/clean-step1-full-page-diagnostic-2026-11-07/council-round7-handoff.txt\npoc/data/clean-step1-full-page-diagnostic-2026-11-07/council-round3.stderr\npoc/data/clean-step1-full-page-diagnostic-2026-11-07/council-round7-response.md\npoc/data/clean-step1-full-page-diagnostic-2026-11-07/council-round2-response.md\npoc/data/clean-step1-full-page-diagnostic-2026-11-07/council-round4.jsonl\npoc/data/clean-step1-full-page-diagnostic-2026-11-07/council-round6.jsonl\npoc/data/clean-step1-full-page-diagnostic-2026-11-07/council-round2-handoff.txt\npoc/data/clean-step1-full-page-diagnostic-2026-11-07/council-round3.exit\npoc/data/clean-step1-full-page-diagnostic-2026-11-07/council-round3-handoff.txt\npoc/data/clean-step1-full-page-diagnostic-2026-11-07/council-round8.exit\npoc/data/clean-step1-full-page-diagnostic-2026-11-07/council-round2.stderr\npoc/data/clean-step1-full-page-diagnostic-2026-11-07/council-review.jsonl\npoc/data/clean-step1-full-page-diagnostic-2026-11-07/council-round4.exit\npoc/data/clean-step1-full-page-diagnostic-2026-11-07/council-round3-response.md\npoc/data/clean-step1-full-page-diagnostic-2026-11-07/council-round5.exit\npoc/data/clean-step1-full-page-diagnostic-2026-11-07/council-round6-response.md\npoc/data/clean-step1-full-page-diagnostic-2026-11-07/council-round6-handoff.txt\npoc/data/clean-step1-full-page-diagnostic-2026-11-