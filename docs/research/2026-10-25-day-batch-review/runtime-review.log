        return {'choices': [{'message': {'content': json.dumps(result)}}]}
    day = DayRunner(Path(args['testdb_path']), tmp_path / 'manifests', extraction_workers=2, jev_workers=2)
    result = replay.run(**args, transport=send, day_runner=day)
