"""One item = one round (06-views.md 进库): source check → store → lists → the matching calls → checks → write.
Re-judging is the day's step (D63, 2026-10-24: once a day, over every view whose reading changed that day), run by
the replay after the day's items and before pull mode; see judge_day. Each step appends its processing row in the
same commit as its writes; a resume continues at the step the processing record names (after an ok step, or the
failed step itself) and never repeats a completed step."""
import dataclasses
import json

from .. import dispatch, extraction, vocabulary
from . import jev_matching, judging, matching, store, writing


@dataclasses.dataclass
class RoundResult:
    input_id: str
    evidence: int = 0
    candidates: int = 0
    new_views: int = 0
    judged: int = 0
    changed: int = 0
    cost: float = 0.0
    cached_calls: int = 0
    failed: str = ''
    dropped: int = 0


def _fail(conn, item, seq, result, step, kind, detail, pool_key):
    dispatch.mark(conn, item, seq, step, 'failed', detail[:300])
    store.pool(conn, kind, pool_key, {'input_id': item['input_id'], 'error': detail[:300]}, seq)
    result.failed = detail[:200]
    conn.commit()
    return result


def _match(conn, archive, cfg, universe, item, seq, result, candidates, evidence, lists, shown, *, extra_views=(), call_offset=0, transport=None, workers=1):
    """One matching call with one retry on a refused check. Returns Checked, or None after marking the failure."""
    note = ''
    checked = None
    engine = jev_matching if cfg.matching.engine == 'jev' else matching      # Jev answers once; a retry would be the same answer
    for attempt in range(1 if engine is jev_matching else 2):
        try:
            options = {'workers': workers} if engine is jev_matching else {}
            answer = engine.decide(archive, cfg, conn, item, candidates, evidence, lists, shown, extra_views=extra_views, retry_note=note, transport=transport, **options)
        except Exception as error:
            _fail(conn, item, seq, result, 'matched', 'matching_failed', 'matching: ' + repr(error), type(error).__name__)
            return None
        result.cost += answer.cost_usd
        result.cached_calls += int(answer.cached)
        checked = matching.check(conn, universe, answer.data, candidates, evidence, lists, shown)
        shown_record = {'candidates': lists.candidate_lists, 'evidence': {f'{k[0]}|{k[1]}': v for k, v in lists.evidence_lists.items()}}
        if getattr(answer, 'request_records', None):
            shown_record['requests'] = answer.request_records
        store.insert(conn, 'match_records', seq=seq, input_id=item['input_id'], call_no=call_offset + attempt + 1,
                     shown_json=json.dumps(shown_record),
                     request_sha256=answer.request_sha256, call_id=answer.call_id, decisions_json=json.dumps(answer.data, ensure_ascii=False),
                     checks_json=json.dumps({'refusals': checked.refusals, 'not_opened': checked.not_opened, 'notes': checked.notes}, ensure_ascii=False), written_json=None)
        if not checked.refusals:
            return checked
        note = '；'.join(checked.refusals)
    _fail(conn, item, seq, result, 'matched', 'matching_refused_twice', 'matching refused twice: ' + note, item['category'])
    return None


def changed_views_of_day(conn, day):
    """The views whose reading changed on a replay day: the union of the 'written' records of that day's items."""
    changed = set()
    for row in conn.execute("select reason from processing_steps where step='written' and result='ok' and publication_day=?", (day,)):
        changed.update(json.loads(row['reason']).get('changed', []))
    return changed


def judge_day(conn, archive, cfg, day, seq, *, transport=None, log=print):
    """D63: one re-judging round per day over every open view whose reading changed that day, dependencies first,
    recorded under the day's own processing record (input 'day:<date>'); a view already judged at this sequence
    number (a resumed day) is not judged twice."""
    marker = {'input_id': f'day:{day}', 'publication_day': day}
    changed = changed_views_of_day(conn, day)
    result = RoundResult(marker['input_id'])
    if not changed:
        return result
    try:
        judged = judging.round_of_judgements(archive, cfg, conn, sorted(changed), seq, marker, transport=transport)
        result.judged = len(judged)
        result.changed = sum(1 for j in judged if j['changed'])
        result.cost += sum(j['cost'] for j in judged)
        result.cached_calls += sum(1 for j in judged if j['cached'])
        dispatch.mark(conn, marker, seq, 'judged', 'ok', f'{len(changed)} views changed, {len(judged)} judged, {result.changed} changed conclusions')
        conn.commit()
    except judging.JudgementRefused as error:
        return _fail(conn, marker, seq, result, 'judged', 'judgement_refused_twice', 'judgement refused twice: ' + str(error), 'day')
    except Exception as error:
        return _fail(conn, marker, seq, result, 'judged', 'judging_failed', 'judging: ' + repr(error), type(error).__name__)
    return result


def run(conn, archive, cfg, universe, item, seq, *, resume_from=None, transport=None, log=print, extractor=None, matching_workers=1):
    result = RoundResult(item['input_id'])
    if resume_from in ('judged', 'handed_over'):       # written already; judging is the day's step
        dispatch.mark(conn, item, seq, 'handed_over', 'ok', 'resumed')
        conn.commit()
        return result
    objects = [o['value'] for o in item.get('object_identifiers') or [] if universe.has(o['value'])]
    shown = store.views_for_prompt(conn, objects)
    # extraction (or its stored handover on resume)
    handover = None
    if resume_from and resume_from != 'extracted':
        row = conn.execute('select handover_json from handovers where input_id=? order by id desc limit 1', (item['input_id'],)).fetchone()
        if row:
            saved = vocabulary.extraction_answer(json.loads(row['handover_json']))          # a handover saved by a Chinese version reads in the canonical vocabulary
            handover = extraction.Handover(saved['evidence'], saved['candidates'], saved['dropped'], 0, '', True, 0.0, saved.get('new_groups') or [])
    if handover is None:
        try:
            shown_groups = store.groups_for_prompt(conn, objects, item.get('title') or '')
            handover = (extractor or extraction.extract)(archive, cfg, item, item['text'], shown, universe, shown_groups=shown_groups, transport=transport)
        except Exception as error:
            return _fail(conn, item, seq, result, 'extracted', 'extraction_failed', 'extraction: ' + repr(error), type(error).__name__)
        result.cost += handover.cost_usd
        result.cached_calls += int(handover.cached)
        store.insert(conn, 'handovers', input_id=item['input_id'], seq=seq,
                     handover_json=json.dumps({'evidence': handover.evidence, 'candidates': handover.candidates, 'dropped': handover.dropped, 'new_groups': handover.new_groups}, ensure_ascii=False))
        dispatch.mark(conn, item, seq, 'extracted', 'ok', f'{len(handover.evidence)} evidence, {len(handover.candidates)} candidates, {len(handover.dropped)} dropped')
        conn.commit()
    result.evidence, result.candidates, result.dropped = len(handover.evidence), len(handover.candidates), len(handover.dropped)
    if not handover.evidence and not handover.candidates:
        dispatch.mark(conn, item, seq, 'handed_over', 'ok', 'nothing to match')
        conn.commit()
        return result
    # first matching call: the candidates and the evidence linked straight to existing views
    lists = matching.build_lists(conn, handover, shown, cfg.search_top_n)
    checked = _match(conn, archive, cfg, universe, item, seq, result, handover.candidates, handover.evidence, lists, shown, transport=transport, workers=matching_workers)
    if checked is None:
        return result
    # second call: evidence linked to candidates that attached to an existing view, compared under that view
    second_pass = {}
    pending = []
    for e in handover.evidence:
        for link in e['links']:
            outcome = checked.outcomes.get(link)
            if outcome and outcome[0] == 'merge':
                pending.append((e, outcome[1]))
    if pending:
        lists2 = matching.Lists({}, {(e['id'], view_id): matching.rank_evidence(conn, view_id, e['one_line'], cfg.search_top_n) for e, view_id in pending})
        evidence2, seen = [], set()
        for e, view_id in pending:
            if e['id'] not in seen:
                evidence2.append(dict(e, links=[v for x, v in pending if x['id'] == e['id']]))
                seen.add(e['id'])
        checked2 = _match(conn, archive, cfg, universe, item, seq, result, [], evidence2, lists2, [], extra_views=sorted({v for _, v in pending}),
                          call_offset=2, transport=transport, workers=matching_workers)
        if checked2 is None:
            return result
        second_pass = checked2.evidence
    dispatch.mark(conn, item, seq, 'matched', 'ok', f'{len(checked.outcomes)} candidates placed')
    # write, and record what changed in the same commit (a resume at 'judged' reads it)
    try:
        written = writing.write(conn, universe, seq, item, handover, checked, second_pass)
    except Exception as error:
        return _fail(conn, item, seq, result, 'written', 'writing_failed', 'writing: ' + repr(error), type(error).__name__)
    result.new_views = len(set(written.new_views.values()))
    dispatch.mark(conn, item, seq, 'written', 'ok', json.dumps({'changed': sorted(written.changed_views), 'new': written.new_views, 'notes': written.notes[:20]}, ensure_ascii=False))
    dispatch.mark(conn, item, seq, 'handed_over', 'ok', '')
    conn.commit()
    return result
"""Replay the test database through the pipeline day by day with no look-ahead.

For every calendar day from from_day to until_day: route each item published that day (dispatch), run its round
(extraction → matching → writing), then the day's one re-judging round over the views whose reading changed (D63),
then pull mode for that day. A guard refuses an item whose
publication day is after the replay day. The views database refuses to run a day at or before the last day it
completed (no backdating). After day0's pull the views database is copied to <views>.day0.sqlite for the agent
layer. Every day prints one line and the archive's cumulative cost."""
import datetime
import shutil
import time

from . import dispatch, pull, testdb
from .views import round as round_module, store


class StaleHandoverError(RuntimeError):
    """A saved parallel extraction cannot establish that it read its predecessors."""


def refuse_unfinished_parallel(conn):
    """D159: preserve old handovers, but never resume a day-start read as a sequential read."""
    pending = conn.execute("""select p.input_id, p.reason from processing_steps p
        where p.step='extracted' and p.result='ok'
        and p.id=(select max(q.id) from processing_steps q
                  where q.input_id=p.input_id and q.step='extracted' and q.result='ok')
        and not exists (select 1 from processing_steps q
                        where q.input_id=p.input_id and q.step='handed_over' and q.result='ok')
        order by p.sequence_no""")
    ids = [row['input_id'] for row in pending if row['reason'].endswith(' (parallel)')]
    if ids:
        raise StaleHandoverError('unfinished day-start extractions; keep this ledger and replay into a new one: ' + ', '.join(ids))


class LookAheadError(RuntimeError):
    pass


class BackdatingError(RuntimeError):
    pass


def calendar_days(from_day, until_day):
    day = datetime.date.fromisoformat(from_day)
    last = datetime.date.fromisoformat(until_day)
    while day <= last:
        yield day.isoformat()
        day += datetime.timedelta(days=1)


def run(*, testdb_path, views_path, archive, cfg, universe, from_day, until_day, day0=None, spend_cap_usd=None,
        transport=None, log=print, only_objects=None, max_items_per_day=None, day_runner=None):
    items_db = testdb.open_db(testdb_path)
    conn = store.open_db(views_path)
    refuse_unfinished_parallel(conn)
    last_done = store.last_completed_day(conn)
    start = from_day
    if last_done and from_day <= last_done:
        next_day = (datetime.date.fromisoformat(last_done) + datetime.timedelta(days=1)).isoformat()
        if next_day > until_day:
            raise BackdatingError(f'views database already completed {last_done}; nothing to run before it')
        log(f'resuming after the last completed day {last_done}')
        start = next_day
    last_written = conn.execute('select max(publication_day) from processing_steps where sequence_no > 0').fetchone()[0]
    if last_written and start < last_written:
        raise BackdatingError(f'views database already holds rounds of {last_written}; a replay cannot start before it (D31)')
    totals = {'items': 0, 'extracted': 0, 'skipped': 0, 'merged': 0, 'not_processed': 0, 'returned': 0, 'failed': 0,
              'evidence': 0, 'new_views': 0, 'judged': 0, 'changed': 0, 'closed': 0}
    calls_before, cost_before, *_ = archive.totals()
    for day in calendar_days(start, until_day):
        day_stats = {k: 0 for k in totals}
        day_cost = 0.0
        processed = 0
        to_run = []
        for item in testdb.feed(items_db, day, day):
            if item['publication_day'] > day:
                raise LookAheadError(f'{item["input_id"]} is dated {item["publication_day"]}, after replay day {day}')
            if only_objects and not any(o['value'] in only_objects for o in item['object_identifiers']):
                continue
            if max_items_per_day and processed >= max_items_per_day:
                break
            day_stats['items'] += 1
            route = dispatch.route(conn, item, universe)
            if route.kind != 'extract':
                day_stats[route.kind] += 1
                if route.kind == 'merged':
                    dispatch.mark(conn, item, 0, 'merged', 'ok', route.reason)
                    conn.commit()
                continue
            processed += 1
            to_run.append((item, route))
        results = (day_runner(conn, archive, cfg, universe, to_run, day=day, transport=transport, log=log) if day_runner else
                   (round_module.run(conn, archive, cfg, universe, item, route.sequence_no, resume_from=route.resume_from, transport=transport, log=log)
                    for item, route in to_run))
        finished = 0
        try:
            for index, result in enumerate(results):
                if index >= len(to_run) or result.input_id != to_run[index][0]['input_id']:
                    raise RuntimeError('day runner returned results out of input order')
                finished += 1
                day_stats['extracted'] += 1
                day_stats['evidence'] += result.evidence
                day_stats['new_views'] += result.new_views
                day_stats['judged'] += result.judged
                day_stats['changed'] += result.changed
                day_cost += result.cost
                if result.failed:
                    day_stats['failed'] += 1
                    log(f'  ! {result.input_id[:60]}: {result.failed}')
                    raise RuntimeError(f'item failed; day {day} remains resumable: {result.failed}')
                if spend_cap_usd is not None and archive.totals()[1] - cost_before > spend_cap_usd:
                    raise RuntimeError(f'spend cap {spend_cap_usd} reached on {day}')
        finally:
            if hasattr(results, 'close'):
                results.close()
        if finished != len(to_run):
            raise RuntimeError('day runner did not complete every routed item')
        seq = store.next_sequence(conn) - 1
        judged = round_module.judge_day(conn, archive, cfg, day, seq, transport=transport, log=log)
        day_stats['judged'] += judged.judged
        day_stats['changed'] += judged.changed
        day_cost += judged.cost
        if judged.failed:
            day_stats['failed'] += 1
            log(f'  ! day judging: {judged.failed}')
            raise RuntimeError(f'judging failed; day {day} remains resumable: {judged.failed}')
        closed = pull.end_of_day(conn, day, seq)
        day_stats['closed'] = len(closed)
        store.complete_day(conn, day, seq, time.strftime('%Y-%m-%dT%H:%M:%S'))
        conn.commit()
        for key in totals:
            totals[key] += day_stats[key]
        calls, cost, _, _ = archive.totals()
        open_count = len(store.open_views(conn))
        log(f'{day} | items {day_stats["items"]:3d} extracted {day_stats["extracted"]:3d} merged {day_stats["merged"]:2d} skipped {day_stats["not_processed"]:2d} '
            f'failed {day_stats["failed"]:2d} | evidence {day_stats["evidence"]:3d} new views {day_stats["new_views"]:2d} judged {day_stats["judged"]:3d} '
            f'changed {day_stats["changed"]:3d} closed {len(closed)} | open views {open_count} | day ${day_cost:.2f} total ${cost - cost_before:.2f} calls {calls - calls_before}')
        if day0 and day == day0:
            conn.commit()
            shutil.copy(views_path, views_path + '.day0.sqlite')
            log(f'day 0 snapshot written: {views_path}.day0.sqlite')
    return totals
"""Dispatch (docs/prd/04-dispatch.md): the only entrance. For each item, three questions in order: is it complete?
was it processed before? what is its classification result? Items that go to extraction get a sequence number in
arrival order; the processing record is a row per step; the review pool a row per occurrence."""
import dataclasses
import time

from .views import store

REQUIRED = ('input_id', 'publisher', 'published_at', 'publication_day', 'category', 'source_uri')


@dataclasses.dataclass
class Route:
    kind: str                     # returned | skipped | not_processed | merged | extract
    sequence_no: int = 0
    resume_from: str = None       # extracted | matched | written | judged, for an unfinished item
    reason: str = ''


STEPS = ('dispatched', 'extracted', 'matched', 'written', 'judged', 'handed_over')


def route(conn, item, universe):
    missing = [field for field in REQUIRED if not item.get(field)]
    if missing:
        store.pool(conn, 'incomplete_item', ','.join(missing), {'input_id': item.get('input_id'), 'missing': missing}, 0)
        return Route('returned', reason=f'missing {missing}')
    input_id = item['input_id']
    if store.is_processed(conn, input_id):
        return Route('skipped', reason='already processed')
    last = store.last_step(conn, input_id)
    if last and last['step'] in STEPS and last['sequence_no']:
        # unfinished work keeps its sequence number: after an ok step it continues at the next step, after a
        # failed step it retries that step (06-views: 失败从失败的那一步重试)
        position = STEPS.index(last['step'])
        resume_from = STEPS[position + 1] if last['result'] == 'ok' else last['step']
        return Route('extract', sequence_no=last['sequence_no'], resume_from=resume_from, reason='resuming')
    if item.get('copy_of'):
        return Route('merged', reason=f'copy of {item["copy_of"]}')
    if item.get('supersedes'):
        store.pool(conn, 'correction_not_supported', item['supersedes'], {'input_id': input_id}, 0)
        return Route('not_processed', reason='correction (supersedes) not supported in the POC')
    category = item['category']
    objects = [o['value'] for o in item.get('object_identifiers') or [] if universe.has(o['value'])]
    if not objects:
        return Route('not_processed', reason='no object on the research list')
    if not any(universe.watches(o, category) for o in objects):
        return Route('not_processed', reason=f'category {category} not watched for {objects}')
    # the sequence number is taken in arrival order and written at once, so two items routed before either is
    # processed (a whole day is routed first, then run) never share a number
    sequence_no = store.next_sequence(conn)
    store.mark_step(conn, input_id, sequence_no, 'dispatched', 'ok', '', item.get('publication_day'), time.strftime('%Y-%m-%dT%H:%M:%S'))
    conn.commit()
    return Route('extract', sequence_no=sequence_no, reason='')


def mark(conn, item, sequence_no, step, result='ok', reason=''):
    store.mark_step(conn, item['input_id'], sequence_no, step, result, reason, item.get('publication_day'), time.strftime('%Y-%m-%dT%H:%M:%S'))
"""The matching step answered by Jev instead of a generative call (log row 34). For each candidate: its relation to every
thesis on its list (one `choice` per thesis) and its membership of every visible research group (one `noul` per group);
for each incoming piece of evidence: its relation to every stored piece on its list under each linked thesis (one
`choice` per stored piece). Code turns the probabilities into an answer in the matching schema, so `matching.check` and
`writing.write` run unchanged: `merge` when a listed open thesis is the same quantity or event, `succession` when a
listed thesis carries the same key for an earlier period and has no successor, else `new`; `repeat` when a stored
piece is the same statement, `replace` when the incoming piece supersedes it, else `new`. Dependencies are not asked.
Thresholds are pre-set (0.5); a membership above the threshold is added to the candidate's group references."""
import dataclasses
import hashlib
import concurrent.futures
import copy

from .. import jev, model, universe as _universe
from . import identity, matching, store

THRESHOLD = 0.5
RELATIONS = {"same_quantity_or_event": "both ask about the same defined quantity or the same event: alternative wordings, or two estimates or figures of that one quantity",
             "same_quantity_other_period": "the same defined quantity or event series for another period, such as the next fiscal or calendar year",
             "part_of": "one asks about a strict component or subset of the other, in either direction; not identical",
             "same_matter_different_quantity": "one ongoing matter, two distinct quantities or events, neither a component of the other",
             "different": "different matters; sharing a company or industry is not enough",
             "cannot_tell": "the supplied material is insufficient or inconsistent"}
MEMBER_CRITERIA = {"true": "the CANDIDATE tracks this matter, one of its stated components, its implementation, or a deployment the supplied material connects to it",
                   "false": "the supplied material shows a different matter, or a question outside the GROUP's stated scope"}
# 06-views.md, the evidence table: repeat = "the same evidence already exists under the thesis: a retelling, the same number in text and
# table, or the same speaker repeating the same statement"; replace = "a later account of the same matter: a speaker revises guidance,
# forecast or event progress; an official confirms/denies a rumour; or the original source revises its statement". The criteria carry
# those words; the first seed run (log row 35) read "same occasion" into them and missed six cross-document repeats.
PIECES = {"same_statement": "the same evidence: a retelling, the same number stated in text and in a table or in another document, or the same speaker repeating the same statement; wording, precision and document may differ",
          "supersedes": "a later version of the same statement or number, changed: the same speaker revises that guidance, forecast or event-progress statement, an official confirms or denies that reported claim, or the original source revises that statement; another statement on the same topic is not this",
          "different": "a different fact, figure or matter, or a figure for another period or quantity, even if on the same topic"}


@dataclasses.dataclass
class Decision:
    data: dict
    call_id: int
    request_sha256: str
    cached: bool
    prompt_chars: int
    input_tokens: int
    output_tokens: int
    cost_usd: float
    calls: int = 0
    request_records: list = dataclasses.field(default_factory=list)


def candidate_state(c, evidence):
    rungs = ' / '.join(f'{r["label"]}: {r["condition"]}' for r in c['rungs'])
    fields = ', '.join(f'{f}={c[f]}' for f in ('measure', 'scope', 'period_start', 'period_end', 'basis', 'unit', 'event_type') if c.get(f) not in (None, '', 'n/a'))
    own = ' | '.join(f'[{e["speaker"]} {e["original_day"]}] {e["quote"][:400]}' for e in evidence if e['id'] in c.get('evidence_ids', []))[:1600]
    return (f'CANDIDATE ({c["kind"]}, object {c["object"]}, focus "{c["looks_at"]}", {c["year"]}, due {c["due_day"]}): {c["question"]}\n'
            f'Key: {fields}\nLadder: {rungs}\nIts evidence: {own}')


def thesis_text(conn, view_id):
    """The thesis as the judge should see it: the card and the quotes that define it (its first two pieces in force)."""
    pieces = store.evidence_in_force(conn, view_id)[:2]
    quotes = ''.join(f'\n    Evidence: [{p["speaker"]} {p["original_day"]}] {p["quote"][:400]}' for p in pieces)
    return matching.describe_view(conn, view_id, english=True) + quotes


def group_text(group):
    members = '; '.join(m['looks_at'] for m in group.get('members', []))
    return f'{group["name"]}. Scope: {group["scope"]} Also called: {", ".join(group.get("aliases") or [])}. Member questions: {members or "(none yet)"}'


def piece_state(e, said_day):
    return f'INCOMING PIECE [{e["tier"]}; {e["speaker"]}; original source {e["original_who"]}, stated {said_day}] {e["one_line"]} | quote: {e["quote"][:600]}'


def relation_question(text):
    return {'type': 'choice', 'criteria': RELATIONS,
            'instructions': 'What relationship holds between the CANDIDATE and the THESIS below? Use only the supplied text. Equal numbers and similar wording do not establish identity. THESIS:\n' + text}


def member_question(text):
    return {'type': 'noul', 'criteria': MEMBER_CRITERIA,
            'instructions': 'Does the CANDIDATE belong to the ongoing matter defined by GROUP below? Use only the supplied text; a shared company, industry or word is not enough. GROUP:\n' + text}


def piece_question(text):
    return {'type': 'choice', 'criteria': PIECES,
            'instructions': 'How does the INCOMING PIECE relate to the STORED PIECE below, already under the same thesis? Use only the supplied text. STORED PIECE:\n' + text}


def can_succeed(conn, view_id, key, c):
    """06-views succession: the candidate asks the same object's quantity (no typed field conflicts: measure, event type, a stated
    basis or unit, a code-owned scope) for a later period that does not overlap, and the thesis has no successor yet."""
    return bool(key) and (store.view(conn, view_id) or {}).get('object_id') == c['object'] \
        and not identity.conflicts(key, c, merging=False) \
        and bool(key.get('period_end') and c.get('period_start') and key['period_end'] < c['period_start']) \
        and not conn.execute('select 1 from successions where succeeds=?', (view_id,)).fetchone()


def succession_target(conn, c, listed):
    """The succession code decides alone: the same scope as well (a model-worded scope that differs goes to the judge)."""
    if not c.get('measure') or not c.get('period_start'):
        return None
    for view_id in listed:
        key = store.view_key(conn, view_id)
        if key and _universe.scope_key(key.get('scope', '')) == _universe.scope_key(c.get('scope', '')) and can_succeed(conn, view_id, key, c):
            return view_id
    return None


def _summary(answer):
    if answer['type'] == 'noul':
        return f'{answer["noul"]:.2f}'
    top = max(answer['probabilities'].items(), key=lambda kv: kv[1])
    return f'{top[0]} {top[1]:.2f}'


def _answers(archive, cfg, jobs, workers, transport):
    """Ask independent questions; equal concurrent requests share one archived result."""
    if not isinstance(workers, int) or isinstance(workers, bool) or workers < 1:
        raise ValueError('Jev workers must be a positive integer')

    def ask(job):
        state, questions = job
        return jev.ask(archive, cfg, cfg.matching, state, questions, 'match', transport=transport)

    if workers == 1:
        return [ask(job) if job[1] else None for job in jobs]
    results, futures, used = [], {}, set()
    with concurrent.futures.ThreadPoolExecutor(max_workers=workers) as pool:
        keys = []
        for state, questions in jobs:
            if not questions:
                keys.append(None)
                continue
            _, key = model.request_identity(jev.request_for(cfg.matching, state, questions))
            keys.append(key)
            if key not in futures:
                futures[key] = pool.submit(ask, (state, copy.deepcopy(questions)))
        for key in keys:
            if key is None:
                results.append(None)
                continue
            answer = futures[key].result()
            # A later logical use is exactly what a serial archive lookup would return.
            results.append(dataclasses.replace(answer, cached=True, cost_usd=0.0) if key in used else answer)
            used.add(key)
    return results


def decide(archive, cfg, conn, item, candidates, evidence, lists, shown_views, *, extra_views=(), retry_note='', transport=None, workers=1):
    data = {'candidates': [], 'evidence': []}
    total = Decision(data, 0, '', True, 0, 0, 0, 0.0)
    shas = []
    jobs, candidate_jobs, evidence_jobs = [], [], []
    # All database reads and request construction stay on the coordinator thread.
    for c in candidates:
        listed = list(dict.fromkeys(list(lists.candidate_lists.get(c['id'], [])) + [v['view_id'] for v in shown_views]))
        questions = {f'rel__{v}': relation_question(thesis_text(conn, v)) for v in listed}
        groups = store.groups_for_prompt(conn, [c['object']], f'{c["looks_at"]} {c["question"]}')
        for g in groups:
            questions[f'member__{g["group_id"]}'] = member_question(group_text(g))
        candidate_jobs.append((c, listed, groups, len(jobs)))
        jobs.append((candidate_state(c, evidence), questions))
    for e in evidence:
        pairs = [(e['id'], v) for v in e['links'] if (e['id'], v) in lists.evidence_lists]
        if not pairs:
            continue
        questions = {f'piece__{v}__{x}': piece_question(matching.describe_evidence(conn, x, english=True)) for _, v in pairs for x in lists.evidence_lists[(e['id'], v)]}
        said_day = e.get('original_day') or item['publication_day']
        evidence_jobs.append((e, pairs, said_day, len(jobs)))
        jobs.append((piece_state(e, said_day), questions))
    replies = _answers(archive, cfg, jobs, workers, transport)

    def answers_for(index):
        answer = replies[index]
        if answer is None:
            return {}
        total.cost_usd += answer.cost_usd
        total.input_tokens += answer.input_tokens
        total.output_tokens += answer.output_tokens
        total.prompt_chars += answer.prompt_chars
        total.cached = total.cached and answer.cached
        total.call_id = answer.call_id
        total.calls += 1
        shas.append(answer.request_sha256)
        total.request_records.append({'call_id': answer.call_id, 'request_sha256': answer.request_sha256})
        return answer.data

    for c, listed, groups, job_index in candidate_jobs:
        answers = answers_for(job_index)
        same = sorted(((answers[f'rel__{v}']['probabilities']['same_quantity_or_event'], v) for v in listed
                       if answers[f'rel__{v}']['choice'] == 'same_quantity_or_event' and answers[f'rel__{v}']['probabilities']['same_quantity_or_event'] >= THRESHOLD),
                      reverse=True)
        joined = [g['group_id'] for g in groups if answers[f'member__{g["group_id"]}']['noul'] >= THRESHOLD]
        for group_id in joined:
            if group_id not in (c.get('group_refs') or []) and group_id not in (c.get('jev_group_refs') or []):
                c.setdefault('jev_group_refs', []).append(group_id)          # the writer records these with basis 'jev'
        reasons = '; '.join(f'{qid[5:]}: {_summary(a)}' for qid, a in answers.items() if qid.startswith('rel__'))
        outcome, target = 'new', ''
        for _, v in same:
            # the key decides what 'the same' may mean: a different quantity is declined here; the same quantity for a later period is a
            # succession (06-views), when the thesis has no successor yet; otherwise a merge into an open thesis
            key = store.view_key(conn, v) if c.get('measure') else None
            if key and identity.conflicts(key, c, merging=False):
                continue
            if key and identity.conflicts(key, c, merging=True):          # the same quantity for another period
                if can_succeed(conn, v, key, c):
                    outcome, target = 'succession', v
                    break
                continue
            if store.is_open(conn, v):
                outcome, target = 'merge', v
                break
        if outcome == 'new':
            # the judge says 'the same quantity for another period'; code decides the direction, the typed fields and the successor
            other = sorted(((answers[f'rel__{v}']['probabilities']['same_quantity_other_period'], v) for v in listed
                            if answers[f'rel__{v}']['choice'] == 'same_quantity_other_period' and answers[f'rel__{v}']['probabilities']['same_quantity_other_period'] >= THRESHOLD),
                           reverse=True)
            for _, v in other:
                key = store.view_key(conn, v) if c.get('measure') else None
                if can_succeed(conn, v, key, c):
                    outcome, target = 'succession', v
                    break
        if outcome == 'new':
            successor_of = succession_target(conn, c, listed)
            if successor_of:
                outcome, target = 'succession', successor_of
        data['candidates'].append({'id': c['id'], 'outcome': outcome, 'target_view_id': target or '', 'dependencies': [],
                                   'reason': f'jev: {reasons or "no list"}; groups joined: {joined or "none"}'})
    for e, pairs, said_day, job_index in evidence_jobs:
        answers = answers_for(job_index)
        for _, v in pairs:
            scored = [(answers[f'piece__{v}__{x}'], x) for x in lists.evidence_lists[(e['id'], v)]]
            repeats = sorted(((a['probabilities']['same_statement'], x) for a, x in scored if a['choice'] == 'same_statement' and a['probabilities']['same_statement'] >= THRESHOLD), reverse=True)
            replaces = sorted(((a['probabilities']['supersedes'], x) for a, x in scored if a['choice'] == 'supersedes' and a['probabilities']['supersedes'] >= THRESHOLD), reverse=True)
            outcome, target = ('repeat', repeats[0][1]) if repeats else ('replace', replaces[0][1]) if replaces else ('new', '')
            data['evidence'].append({'id': e['id'], 'view_id': v, 'outcome': outcome, 'target_evidence_id': target or '', 'said_day': said_day,
                                     'reason': 'jev: ' + '; '.join(f'{x}: {_summary(a)}' for a, x in scored)})
    total.request_sha256 = hashlib.sha256('+'.join(shas).encode('utf-8')).hexdigest() if shas else ''
    return total
