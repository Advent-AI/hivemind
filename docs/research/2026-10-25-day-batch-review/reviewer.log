   119	def openai_transport(provider, request, timeout=600):
   120	    url, _ = ENDPOINTS[provider]
   121	    body = json.dumps(request).encode('utf-8')
   122	    headers = {'Authorization': f'Bearer {_key(provider)}', 'Content-Type': 'application/json'}
   123	    last = None
   124	    for attempt in range(3):
   125	        try:
   126	            with urllib.request.urlopen(urllib.request.Request(url, data=body, headers=headers, method='POST'), timeout=timeout) as response:
   127	                return json.loads(response.read().decode('utf-8'))
   128	        except urllib.error.HTTPError as error:
   129	            text = error.read().decode('utf-8', 'ignore')[:600]
   130	            last = f'HTTP {error.code}: {text}'
   131	            if error.code in (400, 401, 403, 404):
   132	                raise TransportError(last)
   133	        except (urllib.error.URLError, TimeoutError, ConnectionError, OSError, http.client.HTTPException) as error:   # a dropped or truncated response is retried like a network error
   134	            last = repr(error)[:200]
   135	        time.sleep(5 * (attempt + 1))
   136	    raise TransportError(last or 'no answer')
