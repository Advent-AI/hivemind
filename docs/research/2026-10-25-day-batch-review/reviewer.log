    97	        return None
    98	    for view_id in listed:
    99	        key = store.view_key(conn, view_id)
   100	        if key and _universe.scope_key(key.get('scope', '')) == _universe.scope_key(c.get('scope', '')) and can_succeed(conn, view_id, key, c):
   101	            return view_id
   102	    return None
