    25	        groups = {r['group_id']: dates[r['created_from_input']] for r in db.execute('select * from thesis_groups')}
    26	        hands = {r['input_id']: json.loads(r['handover_json']) for r in db.execute('select * from handovers order by id')}
    27	        counts = collections.Counter()
    28	        examples = []
    29	        for call in arc.execute("select call_id,request_json,answer_json from model_calls where config_version=? and purpose='extract' order by call_id", (config,)):
    30	            user = json.loads(call['request_json'])['messages'][1]['content']
    31	            input_id, day = ITEM.search(user).groups()
    32	            item = dict(source.execute('select * from items where input_id=?', (input_id,)).fetchone())
    33	            context = user.split('[Existing theses of these objects]', 1)[1].split('[Item]', 1)[0]
    34	            ids, gids = set(VIEW.findall(context)), set(GROUP.findall(context))
    35	            baseline = extraction.sift_with_groups(json.loads(call['answer_json']), item, item['text'], ids, uni, english=True, shown_group_ids=gids)
    36	            expected = hands[input_id]
    37	            for field, values in [('evidence', baseline[0]), ('candidates', baseline[1])]:
    38	                if {x['id'] for x in values} != {x['id'] for x in expected[field]}:
    39	                    raise ValueError(f'baseline differs for {input_id} {field}')
    40	            day_start = extraction.sift_with_groups(json.loads(call['answer_json']), item, item['text'],
    41	                {v for v in ids if views[v] < day}, uni, english=True, shown_group_ids={g for g in gids if groups[g] < day})
    42	            counts['answers_checked'] += 1
    43	            before = {e['id']: e for e in baseline[0]}
    44	            after = {e['id']: e for e in day_start[0]}
    45	            lost = sorted(before.keys() - after.keys())
    46	            removed_links = [(eid, v) for eid, e in before.items() for v in e['links'] if eid not in after or v not in after[eid]['links']]
    47	            counts['retained_evidence_control'] += len(before)
