   133	def build_lists(conn, handover, shown_views, top_n):
   134	    candidate_lists = {}
   135	    for c in handover.candidates:
   136	        same_key = key_matches(conn, c)
   137	        if same_key:                      # a keyed candidate is compared with the views that share its key, a narrow question
   138	            exact = store.exact_key_views(conn, c)
   139	            candidate_lists[c['id']] = list(dict.fromkeys(exact + same_key))[:top_n]
   140	            continue
   141	        hits = store.search_views(conn, f'{c["object"]} {c["looks_at"]} {c["question"]}', top_n)
   142	        for v in shown_views:
   143	            if v['view_id'] not in hits and v['object_id'] == c['object']:
   144	                hits.append(v['view_id'])
   145	        candidate_lists[c['id']] = hits[:top_n]
   146	    evidence_lists = {}
   147	    candidate_ids = {c['id'] for c in handover.candidates}
   148	    for e in handover.evidence:
   149	        for view_id in e['links']:
   150	            if view_id in candidate_ids:
   151	                continue
   152	            evidence_lists[(e['id'], view_id)] = rank_evidence(conn, view_id, e['one_line'], top_n)
   153	    return Lists(candidate_lists, evidence_lists)
