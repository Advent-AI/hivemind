   294	            if target_view and target_view['object_id'] != c['object']:
   295	                notes.append(f'candidate {c["id"]}: {outcome} into {target} refused: another object ({target_view["object_id"]} ≠ {c["object"]}); opened as a new view')
   296	                outcome, target, target_key = 'new', '', None
   297	                d = dict(d, outcome=outcome, target_view_id='')
   298	            if target_key and identity.conflicts(target_key, c, merging=outcome == 'merge'):
   299	                notes.append(f'candidate {c["id"]}: {outcome} into {target} refused by key ({target_key["measure"]}[{target_key["scope"]}] {target_key["period_start"]}..{target_key["period_end"]} ≠ {c["measure"]}[{c.get("scope", "")}] {c.get("period_start", "")}..{c.get("period_end", "")}); opened as a new view')
