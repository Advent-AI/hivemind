   253	def views_for_prompt(conn, object_ids):
   254	    """05-extraction block 5: the objects' open views plus every view they depend on, open or closed, with who
   255	    depends on whom; question, looks_at and due day only."""
   256	    shown, order = {}, []
   257	    for object_id in object_ids:
   258	        for view_id in views_of_object(conn, object_id):
   259	            if view_id not in shown:
   260	                shown[view_id] = dict(view(conn, view_id), open=True, depends_on=[], dependencies=[])
   261	                order.append(view_id)
   262	    for view_id in list(order):
   263	        for dep in dependencies_of(conn, view_id):
   264	            target = dep['resolved_to']
   265	            # depends_on keeps the text the Chinese prompt versions print; dependencies is the same list structured, for any builder
   266	            shown[view_id]['depends_on'].append(target or f'（等 {dep["wait_chain_view_id"]} 这条链上 {dep["wait_year"]} 年的那条）')
   267	            shown[view_id]['dependencies'].append({'view_id': target} if target else {'view_id': None, 'wait_chain_view_id': dep['wait_chain_view_id'], 'wait_year': dep['wait_year']})
   268	            if target and target not in shown:
   269	                record = view(conn, target)
   270	                if record:
   271	                    shown[target] = dict(record, open=is_open(conn, target), depends_on=[], dependencies=[])
   272	                    order.append(target)
   273	    return [dict(shown[v], rungs=rungs_of(conn, v)) for v in order]
