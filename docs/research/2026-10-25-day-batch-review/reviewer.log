   340	def check_group_refs(c, shown_group_ids, declared):
   341	    """None when a candidate's research-group references are well formed: no repeats, each a shown group id or a declared
   342	    local id; empty is allowed (a company's own financial line belongs to the company, not to a group); else the problem."""
   343	    refs = c.get('group_refs')
   344	    if refs is None:
   345	        return None                     # a version before groups
   346	    if len(refs) != len(set(refs)):
   347	        return 'group_refs repeats a group'
   348	    unknown = [r for r in refs if r not in shown_group_ids and r not in declared]
   349	    if unknown:
   350	        return f'group_refs cites a group neither shown nor declared: {unknown}'
   351	    return None
