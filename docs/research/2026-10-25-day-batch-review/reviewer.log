   139	def check_schema(value, schema, path='$'):
   140	    """A small validator for the subset of JSON Schema the prompts use: object/required/additionalProperties,
   141	    array/items, string/enum/pattern, integer, number, boolean, null in anyOf."""
   142	    kind = schema.get('type')
   143	    if 'anyOf' in schema:
   144	        errors = []
   145	        for option in schema['anyOf']:
   146	            errors = check_schema(value, option, path)
   147	            if not errors:
   148	                return []
   149	        return errors or [f'{path}: matches no option']
   150	    if kind == 'object':
   151	        if not isinstance(value, dict):
   152	            return [f'{path}: expected object']
   153	        errors = []
   154	        for name in schema.get('required', []):
   155	            if name not in value:
   156	                errors.append(f'{path}.{name}: required')
   157	        properties = schema.get('properties', {})
   158	        for name, item in value.items():
   159	            if name in properties:
   160	                errors.extend(check_schema(item, properties[name], f'{path}.{name}'))
   161	            elif schema.get('additionalProperties') is False:
   162	                errors.append(f'{path}.{name}: not allowed')
   163	        return errors
   164	    if kind == 'array':
   165	        if not isinstance(value, list):
   166	            return [f'{path}: expected array']
   167	        errors = []
   168	        for index, item in enumerate(value):
   169	            errors.extend(check_schema(item, schema.get('items', {}), f'{path}[{index}]'))
   170	        return errors
   171	    if kind == 'string':
   172	        if not isinstance(value, str):
   173	            return [f'{path}: expected string']
   174	        if 'enum' in schema and value not in schema['enum']:
   175	            return [f'{path}: {value!r} not in {schema["enum"]}']
   176	        if 'pattern' in schema and not re.search(schema['pattern'], value):
   177	            return [f'{path}: {value!r} does not match {schema["pattern"]}']
   178	        return []
   179	    if kind == 'integer':
   180	        return [] if isinstance(value, int) and not isinstance(value, bool) else [f'{path}: expected integer']
   181	    if kind == 'number':
   182	        return [] if isinstance(value, (int, float)) and not isinstance(value, bool) else [f'{path}: expected number']
   183	    if kind == 'boolean':
   184	        return [] if isinstance(value, bool) else [f'{path}: expected boolean']
   185	    if kind == 'null':
   186	        return [] if value is None else [f'{path}: expected null']
   187	    return []
   188	
   189	
   190	def call(archive, cfg, setting, system, user, schema, schema_name, purpose, *, transport=None):
   191	    provider = cfg.provider
   192	    request = build_request(setting, system, user, schema, schema_name, provider)
   193	    request_json = json.dumps(request, sort_keys=True, ensure_ascii=False)
   194	    sha = hashlib.sha256(request_json.encode('utf-8')).hexdigest()
   195	    hit = archive.lookup(sha)
   196	    prompt_chars = len(system) + len(user)
   197	    if hit:
   198	        call_id, answer_json, _, input_tokens, output_tokens = hit
   199	        return Answer(json.loads(answer_json), call_id, sha, True, prompt_chars, input_tokens or 0, output_tokens or 0, 0.0)
   200	    started = time.time()
   201	    response = (transport or openai_transport)(provider, request)
   202	    seconds = round(time.time() - started, 1)
   203	    try:
   204	        content = response['choices'][0]['message']['content']
   205	        data = json.loads(content)
   206	    except (KeyError, IndexError, TypeError, json.JSONDecodeError) as error:
   207	        archive.record(purpose=purpose, config_version=cfg.version, config_checksum=cfg.checksum, model=setting.model,
   208	                       request_sha256=sha + ':malformed:' + uuid.uuid4().hex[:8], request_json=request_json,
   209	                       response_json=json.dumps(response)[:200000], answer_json=None, prompt_chars=prompt_chars,
   210	                       input_tokens=0, output_tokens=0, cost_usd=0.0, seconds=seconds, created_at=time.strftime('%Y-%m-%dT%H:%M:%S'))
   211	        raise SchemaError(f'malformed answer: {error}')
   212	    errors = check_schema(data, schema)
   213	    usage = response.get('usage') or {}
   214	    input_tokens = int(usage.get('prompt_tokens') or 0)
   215	    output_tokens = int(usage.get('completion_tokens') or 0)
   216	    price_in, price_out = PRICES.get(setting.model, (0.0, 0.0))
   217	    cost = round(input_tokens / 1e6 * price_in + output_tokens / 1e6 * price_out, 6)
   218	    call_id = archive.record(purpose=purpose, config_version=cfg.version, config_checksum=cfg.checksum, model=setting.model,
   219	                             request_sha256=sha if not errors else sha + ':schema:' + uuid.uuid4().hex[:8], request_json=request_json,
   220	                             response_json=json.dumps(response)[:200000], answer_json=json.dumps(data, ensure_ascii=False),
   221	                             prompt_chars=prompt_chars, input_tokens=input_tokens, output_tokens=output_tokens, cost_usd=cost,
   222	                             seconds=seconds, created_at=time.strftime('%Y-%m-%dT%H:%M:%S'))
   223	    if errors:
   224	        raise SchemaError('; '.join(errors[:5]))
   225	    return Answer(data, call_id, sha, False, prompt_chars, input_tokens, output_tokens, cost)
     1	# Review: per-day API concurrency and the 10× target
     2	
     3	**The acceleration is worth testing, but the queued plan is not ready to implement as written.** Its day-start reads change extraction, its proposed within-day pass is incomplete, and 10× is not supported by the recorded workload. Start with a correctness-preserving concurrency POC; treat a new day-level extraction contract as a separate product choice.
     4	
     5	For example, the first NVIDIA earnings call creates the annual revenue thesis. Its CFO commentary later the same day links a quoted revenue figure to that thesis. At the start of the day that thesis does not exist. Parallelizing the existing calls with the same checks can discard the commentary's evidence. Merely sorting the database writes afterwards does not restore it.
     6	
     7	Scope: current replay, extraction requests, Jev matching, writer, daily judging, recovery and evaluation. Baseline `da06fbd`. No product code or prompt is changed by this review. No live extraction or matching call has been made. These are offline proofs and an implementation proposal, not a completed acceleration benchmark.
     8	
     9	## What the stored data establishes
    10	
    11	Read-only inventories cover both v23 arms, 480 extraction handovers per arm, through August 15. Calls copied from v21 archives are excluded. [Audit](../../../poc/reports/2026-10-25-day-batch-review/audit-v2.json), [snapshot reconstruction](../../../poc/reports/2026-10-25-day-batch-review/snapshots.json), [visibility test](../../../poc/reports/2026-10-25-day-batch-review/visibility.json).
    12	
    13	| Check | Jev arm | Generative control | Meaning |
    14	|---|---:|---:|---|
    15	| Complete extraction requests reproduced from historical SQLite snapshots | 480/480 | 480/480 | The read reconstruction has a real control; original source and context match exactly |
    16	| Requests whose text changes under a day-start snapshot | 214/480 | 168/480 | Moving groups alone does not make extraction independent; existing theses and group members also change |
    17	| Stored evidence links to a thesis first created earlier that day | 90 | 82 | These targets do not exist at day start |
    18	| Evidence items lost when the same raw answers pass the real checks with day-start IDs | 73/797 | 62/744 | Counterfactual code failure, not an estimate of what a fresh model would answer |
    19	| Final repeat/replace decisions targeting evidence first created earlier that day | 86/320 | 47/196 | The new day-level resolver must cover evidence, not only candidate duplicates |
    20	| New group declarations | 26 | 30 | Jev membership in existing groups does not supply group creation |
    21	| Candidate records / distinct local candidate IDs | 102 / 9 | 96 / 10 | `c1` is local to an input, not a day-wide identifier |
    22	| Evidence records / distinct local evidence IDs | 797 / 16 | 744 / 13 | Flattening answers into a dictionary keyed by `e1` overwrites evidence |
    23	| Dependency rows | 0 | 8 | The Jev arm cannot test dependency ordering alone |
    24	
    25	The first lost-link control is NVIDIA's February 25 CFO commentary: its full-year revenue statement points to the thesis introduced by the preceding earnings call. All 960 baseline requests reproduce exactly before the day-start counterfactual is applied. Both input ledgers and archives retain their original file hashes.
    26	
    27	### Speed: what the estimate actually includes
    28	
    29	The July 27 v23 Jev run processed 53 extraction calls, 82 Jev calls and seven judgement calls in about 513 seconds. The earlier 11.8-minute example describes the generative control, not the new default. Reusing the Jev run's recorded call durations in three separate waves gives:
    30	
    31	| Maximum concurrent requests per wave | July 27 projected seconds | July 27 ratio | Full measured 31-day workload ratio |
    32	|---:|---:|---:|---:|
    33	| 6 | 123.0 | 4.2× | 2.5× |
    34	| 12 | 79.5 | 6.5× | 3.0× |
    35	| 24 | 63.6 | 8.1× | 3.2× |
    36	| 32 | 59.6 | 8.6× | 3.2× |
    37	
    38	These are optimistic **projections**, not provider measurements. They ignore added within-day comparisons, retries, rate limits, larger prompts and dependency constraints. The full-workload comparison is about 6,132 observed seconds against 1,922 projected seconds at 32 workers. Quiet days and slow individual judgements limit the benefit. The 315-second July 28 call remains in the projection. Cutting off that call cannot be counted as a saving without obtaining and paying for a successful replacement answer.
    39	
    40	Judging already has six concurrent workers per dependency level (`judging.round_of_judgements`). Jev requests within an item remain serial (`jev_matching.decide`); archive locks cover SQLite accesses, not the network wait. Thus there is additional concurrency to expose, but the whole judging stage is not currently serial.
    41	
    42	“Batch” here should mean bounded concurrent calls to the current normal APIs. OpenAI's separate Batch API describes a 24-hour completion window and unordered result files; it is not a seconds-level latency promise. It can be evaluated separately for cost-oriented offline work. [Official OpenAI Batch documentation](https://developers.openai.com/api/docs/guides/batch).
    43	
    44	## Where the original plan breaks
    45	
    46	| Finding | Code or data mechanism | Required design rule |
    47	|---|---|---|
    48	| Day-start extraction loses context | `round.run` reads `views_for_prompt` and `groups_for_prompt` after prior writes; `sift` admits only shown thesis IDs or local candidates | Either validate speculative reads before use, or explicitly change and evaluate the extraction contract. Do not silently change D159. |
    49	| Moving membership does not replace group creation | Extraction emits names/scopes/aliases; Jev only returns membership probabilities for shown stored groups; `groups.plan` creates groups only for accepted founders | Retain extraction's source-backed group declarations in the first POC. A transfer of ownership needs a complete declaration and identity contract, not just removing the group block. |
    50	| A final sort cannot fix stale matching | Earlier writes add targets, change in-force evidence, occupy successor slots and affect group membership | Rebuild/validate every affected comparison input before committing; a stored “new” decision is not valid merely because it was made earlier. |
    51	| Local IDs collide | Each item restarts `c1`, `e1`, `n1` | Any day-wide intermediate reference is `(input_id, local_id)`; final ledger IDs remain assigned by the ordered writer. |
    52	| “Compare everything in the day” hides a new workload | There are 263 earlier-item candidate pairs but 15,228 earlier-item evidence pairs in the Jev run, before filtering | Count queries, bytes, tokens and rate-limit demand. Limit comparisons by resolved thesis, while measuring recall. Do not assume the extra pass takes two seconds. |
    53	| Pairwise equality is not necessarily transitive | Similarity/probability is not an equivalence relation; A≈B and B≈C do not prove A=C; a raw candidate can merge into a different canonical thesis | Resolve against the current canonical target, not unrestricted union-find or “highest probability wins” over all day pairs. |
    54	| Late results can corrupt a newer plan | A response can arrive after a retry, configuration change or restart | Persist input/configuration/request identity; accept a result only for its exact request. Completion order never assigns sequence or ledger IDs. |
    55	| A 60-second timeout alone is not a fix | A timed-out remote call may still have consumed tokens; retries and in-flight calls can exceed a nominal budget | Distinguish transient HTTP failure, schema refusal and unknown timeout outcome; reuse completed archived responses and account for attempts. Do not claim a cancelled call succeeded. |
    56	| Existing gold is not plug-and-play for fresh outputs | Gold candidate IDs and membership view IDs belong to each original arm; the candidate scorer defaults unlisted candidates to “new”; some evidence sections are stored summary counts | Preserve the original labels, map by provenance/meaning, report unmatched outputs, and inspect them. Never award “new” automatically to an unmatched fresh candidate. |
    57	
    58	## Recommended first POC: concurrent preparation, validated ordered commits
    59	
    60	Use the existing extraction/grouping meaning first. Do not introduce a second clustering system or an all-day provisional graph while trying to establish the speed baseline.
    61	
    62	1. **Freeze a day manifest.** Record the source IDs in existing dispatch order, sequence numbers, source hashes, configuration/prompt versions and the completed prior-day boundary. Keep the source day distinct from the wall-clock run date. Only one writer operates on this experimental ledger.
    63	2. **Prepare calls concurrently against an immutable snapshot.** Workers receive fully built requests, never a writable SQLite connection. Keep separate bounded pools for extraction and Jev. Deduplicate identical in-flight request hashes within the batch. The archive remains the owner of raw responses.
    64	3. **Commit in sequence, validating what was read.** At an item's turn, regenerate the exact extraction request and schema against the current committed prefix. Reuse its prepared answer only when the request hash is identical. Otherwise obtain a new answer for the current request and account for it as rework. This includes changes to a query that previously returned no results, group members, group IDs and permitted schema references.
    65	4. **Prepare independent Jev questions concurrently.** Resolve candidate destinations before candidate-linked evidence comparison, as today. Compare the full Jev request against current target text, evidence in force, lists and group definitions. If any changes, redo only that request. Do not let concurrent workers mutate the shared candidate dictionaries (`jev_group_refs`) or totals; collect immutable results and apply them in input order on the coordinator.
    66	5. **Write through the existing atomic writer.** Recheck exact identity, open state, successor eligibility, replacement entitlement and target existence. A write conflict returns to matching; it never forces creation or silently drops a link. Save the matching record, new IDs and item completion with the same transaction. Earlier committed items remain a valid prefix after a crash.
    67	6. **Judge after all item commits.** Use the existing dependency scheduler: independent theses concurrently, upstream levels first, including newly triggered dependants. Mark the day complete only after judgement and pull succeed. Do not move to tomorrow while today's required work is incomplete.
    68	
    69	This preserves the current meaning and provides a clean control for concurrency. It may be slower than the optimistic table because 214 requests have changed day-start context. That is a result to measure, not a reason to use stale answers. Pipeline overlap can improve the staged estimate, but must be measured separately.
    70	
    71	The more aggressive alternative is a new day-level contract: extraction retains all relevant statements and source-backed candidate/group descriptions independently of existing IDs; matching resolves old and same-day targets; ordered resolution governs identity and history. That changes what extraction produces and how omission is defined. D149/D159/D169 require a recorded decision before implementing it. It needs its own fresh semantic experiment; the archived outputs cannot prove it works. Do not fold that redesign into the first concurrency test.
    72	
    73	## Runtime state × event: proposed control
    74	
    75	| State | Event | Transition / persisted result |
    76	|---|---|---|
    77	| Prior day complete, no manifest | Start day | Persist ordered inputs, source/config hashes and starting boundary before submitting work |
    78	| Manifest ready | No eligible inputs | Perform existing day-end duties; complete only on success |
    79	| Request prepared | Eligible slot | Submit exact request; record attempt identity; no ledger mutation |
    80	| In flight | Success | Archive exact response; mark it available for its request only |
    81	| In flight | Rate limit/transient failure | Bounded retry under the same request and remaining attempt budget; completed items are not resubmitted |
    82	| In flight | Timeout/unknown outcome | Record unknown usage and outstanding attempt; do not create an answer or silently duplicate its result |
    83	| Answer ready, earlier item pending | Any completion order | Hold result; ledger order does not change |
    84	| Answer ready, item reaches commit turn | Read/schema hash still matches | Validate and use answer |
    85	| Answer ready, item reaches commit turn | Read or configuration changed | Discard it as a candidate for this commit, retain archive; prepare current request or stop on incompatible run configuration |
    86	| Checked plan | Earlier write changed a target or successor | Recompute affected matching; no blind write |
    87	| Writing | Exception midway | Roll back that item's entire transaction, including completion markers; preserve earlier committed prefix |
    88	| Committed | Redelivery/restart | Reuse completion and final IDs; no duplicate source link, evidence, membership or call for completed work |
    89	| Any unfinished state | Corrected input or changed scope | Existing versions stay fixed. Start a separately identified input/run under the decided correction rules; do not patch the manifest in flight |
    90	| Any unfinished state | Another writer | Not supported by this single-writer POC; stop on boundary conflict rather than merge unseen writes |
    91	| Last item committed | Judgement begins | Dependency levels, each affected thesis once under the existing rule |
    92	| Judging/pull | Failure/crash | Day remains incomplete; resume remaining duties without replaying completed items |
    93	| Day complete | Late result from an old attempt | Archive by its original request; never apply it to the completed day |
    94	| Any state | Stop requested / cap exhausted | Stop submission, drain/account for in-flight work; retain the resumable prefix and do not mark an unfinished day complete |
    95	
    96	## Values and readers
    97	
    98	| Value / writer | All relevant readers | Rule |
    99	|---|---|---|
   100	| Input ID, source hash, source day, sequence / dispatch-manifest coordinator | Extractor, matcher, writer, audit, resume | Identity and chronology; source text stays exact |
   101	| Request hash, schema, configuration / request builder | Worker, archive, retry, commit validator | One exact request; a changed read creates another request |
   102	| Local candidate/evidence/group ID / extraction | Matcher, resolver, writer, scorer | Namespaced by input; never globally joined on `c1` alone |
   103	| Candidate/group description / extraction | Jev, group planner, ordered writer | No membership implies identity; valid founders only; no unseen future group |
   104	| Matching probabilities / Jev worker | Coordinator, existing code checks, matching archive | Immutable response; same criteria and threshold; current canonical target |
   105	| Final IDs, replacements, dependencies, memberships / writer | Following item, historical reads, judging, API, audit | Commit atomically in sequence; retain sources and prior records |
   106	| Judgement / dependency scheduler | Dependants, pull, API/history | Upstream conclusions first; only changed conclusions propagate |
   107	| Gold correspondence / evaluation | Review and reported metrics only | Cannot determine production identity or silently change gold |
   108	| Attempt time, outcome and usage / call wrapper | Scheduler, spend accounting, report | Include retries, incomplete calls and rework in elapsed/cost results |
   109	
   110	## Test sequence and acceptance
   111	
   112	| Step | Work | Gate |
   113	|---|---|---|
   114	| 0 — complete here | Census, historical snapshots, original-request reproduction, stale-ID replay, scheduling estimates, positive controls and mutants | No unidentified cases or historical-write changes; findings below remain explicit |
   115	| 1 — before live calls | Isolated scheduler/coordinator using archived responses, shuffled completion order and injected failures | Same final semantic records and source links for identical validated responses; crash at every transition resumes once; late/duplicate responses never commit twice |
   116	| 2 — first live POC | Same source snapshot and fixed code, ordinary APIs; fresh sequential control and concurrent arm, at least three samples each | Compare control against control first. Record every request, queue interval, attempt, response and write; no provider/model change |
   117	| 3 — semantic reading | Reuse applicable gold plus explicit provenance mapping; review new/unmatched units from sources | No introduced false merge, lost quote/source, invalid reference, missing required membership or temporal leak; report all pre-existing errors and uncertainty, not only net counts |
   118	| 4 — time/size reading | Fixed source workload on both arms; measure first submission through completed day | End-to-end elapsed ratio, tokens/cost, peak in-flight work, retries and rework; cached replay is not a live speed benchmark. Same worker limits and no competing heavy job |
   119	| 5 — only after small pass | Seed, one busy day, then consecutive days containing replacements/successions, then the fixed week and August holdout | Keep the standard fixed; a failed registered acceptance stops the line. Publish every sample and do not drop quiet/slow days |
   120	
   121	Use July 27 for the busy-day latency test, but use February 25/May 20 for same-day financial repeats and group founding; include July 28's slow-call behavior and August's succession examples. A July 27-only pass cannot establish the whole pipeline. The existing Jev ledger has zero dependency rows, so use the recorded generative dependency cases plus deterministic failure tests for that path; do not claim it was exercised by a zero-row check.
   122	
   123	Structural acceptance is exact: source linkage, temporal visibility, valid IDs, one committed item result, rollback, restart and conservation of evidence. Semantic acceptance uses source meaning: equal IDs, wording, group counts or matching the old model's error are not success. Existing labels are Claude-authored and partially sampled, not independent human gold. Unlabelled new candidates are unjudged until reviewed, never automatically correct “new” decisions.
   124	
