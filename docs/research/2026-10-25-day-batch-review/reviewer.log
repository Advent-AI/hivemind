   378	def sift(data, item, text, shown_ids, universe=None, english=False):
   379	    """05-extraction step 3, the code checks on one answer: ladders, the quarter and year rules, due days, quotes in
   380	    the text, links to shown views or kept candidates, one piece per sentence. Returns (evidence, candidates,
   381	    dropped); the preflight runs it over every stored answer. The answer is read in the canonical vocabulary,
   382	    whichever prompt version wrote it; english says which version's year contract applies (a bare year is a calendar
   383	    year under the English versions, the company's fiscal year under the Chinese ones)."""
   384	    data = vocabulary.extraction_answer(data)
   385	    body = normalise(text)
   386	    dropped = []
   387	    candidates = []
   388	    candidate_ids = set()
   389	    for c in data.get('candidates', []):
   390	        problem = check_ladder(c['rungs'], c['kind'])
   391	        if problem:
   392	            dropped.append((c['id'], f'candidate ladder: {problem}'))
   393	            continue
   394	        c = dict(c, rungs=normalise_ladder(c['rungs'], c['kind']))
   395	        if QUARTERLY.search(c['looks_at'] + ' ' + c['question']) and c['kind'] == 'asset':
   396	            dropped.append((c['id'], 'quarterly number: evidence, not a view (06-views ladder rule 6)'))
   397	            continue
   398	        year_match = re.search(r'(\d{4})', c['year'] or '')
   399	        if c.get('measure') not in ('event', 'policy_event') and year_match and int(year_match.group(1)) > int(item['publication_day'][:4]) + 1:
   400	            dropped.append((c['id'], f'year {c["year"]} is beyond next year: not opened (06-views 不开)'))
   401	            continue
   402	        if not re.match(r'\d{4}-\d{2}-\d{2}$', c['due_day']):
   403	            dropped.append((c['id'], f'due_day not a date: {c["due_day"]!r}'))
   404	            continue
   405	        if c['due_day'] <= item['publication_day']:
   406	            dropped.append((c['id'], f'due_day {c["due_day"]} not after the item'))
   407	            continue
   408	        if c.get('measure'):          # keyed candidates keep their actual scope; reference lists do not gate admission (D155)
   409	            problem = check_bounds(c['rungs'])
   410	            if problem:
   411	                dropped.append((c['id'], f'candidate ladder bounds: {problem}'))
   412	                continue
   413	            if universe is not None:
   414	                object_id = universe.resolve(c['object']) or c['object']
   415	                scope, source = universe.scope_and_source(object_id, c['measure'], c.get('scope', ''), c.get('event_type', 'n/a'))
   416	                c = dict(c, object=object_id, scope=scope, scope_source=source, key_version=2)
   417	                if c['measure'] not in ('event', 'policy_event'):
   418	                    period = universe.fiscal_period(object_id, c.get('year', ''), bare_is_calendar=english)                             # and the period of a yearly number
   419	                    if period:
   420	                        c = dict(c, period_start=period[0], period_end=period[1])
   421	            try:
   422	                start = datetime.date.fromisoformat(c['period_start'])
   423	                end = datetime.date.fromisoformat(c['period_end'])
   424	                if start > end:
   425	                    raise ValueError('start after end')
   426	            except (KeyError, ValueError):
   427	                dropped.append((c['id'], 'invalid period: expected real dates with start <= end'))
   428	                continue
   429	        candidates.append(c)
   430	        candidate_ids.add(c['id'])
   431	    evidence = []
   432	    kept_ids = set()
   433	    by_quote = {}
   434	    alias = {}
   435	    for e in data.get('evidence', []):
   436	        quote = normalise(e['quote'])
   437	        if len(quote) < 8 or quote not in body:
   438	            dropped.append((e['id'], 'quote not in item'))
   439	            continue
   440	        links = [l for l in e['links'] if l in shown_ids or l in candidate_ids]
   441	        if not links:
   442	            dropped.append((e['id'], f'links to nothing shown: {e["links"]}'))
   443	            continue
   444	        if quote in by_quote:            # the same sentence read out twice is one piece with both links
   445	            first = by_quote[quote]
   446	            first['links'].extend(l for l in links if l not in first['links'])
   447	            alias[e['id']] = first['id']
   448	            dropped.append((e['id'], f'same quote as {first["id"]}; merged'))
   449	            continue
   450	        e = dict(e, links=links)
   451	        by_quote[quote] = e
   452	        evidence.append(e)
   453	        kept_ids.add(e['id'])
   454	    final_candidates = []
   455	    for c in candidates:
   456	        ids = list(dict.fromkeys(alias.get(i, i) for i in c['evidence_ids'] if alias.get(i, i) in kept_ids))
