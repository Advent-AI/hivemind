    54	def thesis_text(conn, view_id):
    55	    """The thesis as the judge should see it: the card and the quotes that define it (its first two pieces in force)."""
    56	    pieces = store.evidence_in_force(conn, view_id)[:2]
    57	    quotes = ''.join(f'\n    Evidence: [{p["speaker"]} {p["original_day"]}] {p["quote"][:400]}' for p in pieces)
    58	    return matching.describe_view(conn, view_id, english=True) + quotes
    59	
    60	
    61	def group_text(group):
    62	    members = '; '.join(m['looks_at'] for m in group.get('members', []))
    63	    return f'{group["name"]}. Scope: {group["scope"]} Also called: {", ".join(group.get("aliases") or [])}. Member questions: {members or "(none yet)"}'
    64	
    65	
    66	def piece_state(e, said_day):
    67	    return f'INCOMING PIECE [{e["tier"]}; {e["speaker"]}; original source {e["original_who"]}, stated {said_day}] {e["one_line"]} | quote: {e["quote"][:600]}'
