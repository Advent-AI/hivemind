   116	def _same_key(key, c, view_object=None):
   117	    """Only a complete, corrected, code-owned key authorizes automatic identity."""
   118	    target = identity.automatic_key(c)
   119	    return target is not None and bool(key) and identity.automatic_key(key, view_object) == target
