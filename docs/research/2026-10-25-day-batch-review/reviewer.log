   331	    """Evidence linked to the view and not replaced, each with its replaced predecessor when there is one."""
   332	    out = []
   333	    for row in conn.execute('select evidence_id from evidence_links where view_id=? order by id', (view_id,)):
   334	        evidence_id = row['evidence_id']
   335	        if is_replaced(conn, evidence_id):
   336	            continue
   337	        record = evidence(conn, evidence_id)
   338	        previous = predecessor_of(conn, evidence_id)
   339	        record['replaced'] = evidence(conn, previous) if previous else None
   340	        out.append(record)
