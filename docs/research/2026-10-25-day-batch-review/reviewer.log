   222	def groups_block(shown_groups):
   223	    """05-extraction block 5b (D149): the research groups the model may cite, with each member's focus."""
   224	    if not shown_groups:
   225	        return ('[Research groups] None yet. For a candidate that tracks an ongoing matter (a product rollout, a deal, a policy process, an investment or demand cycle), '
   226	                'declare the group in new_groups (local ids n1, n2 …) and cite it in group_refs; leave group_refs empty for a company\'s own financial lines.')
   227	    lines = []
   228	    for g in shown_groups:
