   156	def describe_view(conn, view_id, english=False):
   157	    v = store.view(conn, view_id)
   158	    successor = conn.execute('select view_id from successions where succeeds=?', (view_id,)).fetchone()
   159	    if english:
   160	        rungs = ' / '.join(f'{r["label"]}: {r["condition"]}' for r in store.rungs_of(conn, view_id))
   161	        state = 'open' if store.is_open(conn, view_id) else 'closed'
   162	        tail = f'; successor already exists: {successor["view_id"]}' if successor else ''
   163	        groups = store.groups_of_view(conn, view_id)
   164	        tail += f'; research group: ' + ', '.join(f'{g["group_id"]} "{g["name"]}"' for g in groups) if groups else ''
   165	        return f'{view_id} ({state}, {v["object_id"]}, {v["kind"]}, focus "{v["looks_at"]}", {v["year"] or ""}, due {v["due_day"]}): {v["question"]}\n    Ladder: {rungs}{tail}'
   166	    rungs = ' / '.join(f'{r["label"]}：{r["condition"]}' for r in store.rungs_of(conn, view_id))
   167	    state = '开着' if store.is_open(conn, view_id) else '关了'
   168	    tail = f'；已有下一期 {successor["view_id"]}' if successor else ''
   169	    return f'{view_id}（{state}，{v["object_id"]}，{v["kind"]}，看的是「{v["looks_at"]}」，{v["year"] or ""}，到期 {v["due_day"]}）：{v["question"]}\n    梯子：{rungs}{tail}'
   170	
