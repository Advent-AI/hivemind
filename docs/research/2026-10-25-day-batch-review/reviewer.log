    51	def run(*, testdb_path, views_path, archive, cfg, universe, from_day, until_day, day0=None, spend_cap_usd=None,
    52	        transport=None, log=print, only_objects=None, max_items_per_day=None):
    53	    items_db = testdb.open_db(testdb_path)
    54	    conn = store.open_db(views_path)
    55	    refuse_unfinished_parallel(conn)
    56	    last_done = store.last_completed_day(conn)
    57	    start = from_day
    58	    if last_done and from_day <= last_done:
    59	        next_day = (datetime.date.fromisoformat(last_done) + datetime.timedelta(days=1)).isoformat()
    60	        if next_day > until_day:
    61	            raise BackdatingError(f'views database already completed {last_done}; nothing to run before it')
    62	        log(f'resuming after the last completed day {last_done}')
    63	        start = next_day
    64	    last_written = conn.execute('select max(publication_day) from processing_steps where sequence_no > 0').fetchone()[0]
    65	    if last_written and start < last_written:
    66	        raise BackdatingError(f'views database already holds rounds of {last_written}; a replay cannot start before it (D31)')
    67	    totals = {'items': 0, 'extracted': 0, 'skipped': 0, 'merged': 0, 'not_processed': 0, 'returned': 0, 'failed': 0,
    68	              'evidence': 0, 'new_views': 0, 'judged': 0, 'changed': 0, 'closed': 0}
    69	    calls_before, cost_before, *_ = archive.totals()
    70	    for day in calendar_days(start, until_day):
    71	        day_stats = {k: 0 for k in totals}
    72	        day_cost = 0.0
    73	        processed = 0
    74	        to_run = []
    75	        for item in testdb.feed(items_db, day, day):
    76	            if item['publication_day'] > day:
    77	                raise LookAheadError(f'{item["input_id"]} is dated {item["publication_day"]}, after replay day {day}')
    78	            if only_objects and not any(o['value'] in only_objects for o in item['object_identifiers']):
    79	                continue
    80	            if max_items_per_day and processed >= max_items_per_day:
    81	                break
    82	            day_stats['items'] += 1
    83	            route = dispatch.route(conn, item, universe)
    84	            if route.kind != 'extract':
    85	                day_stats[route.kind] += 1
    86	                if route.kind == 'merged':
    87	                    dispatch.mark(conn, item, 0, 'merged', 'ok', route.reason)
    88	                    conn.commit()
    89	                continue
    90	            processed += 1
    91	            to_run.append((item, route))
    92	        for item, route in to_run:
    93	            result = round_module.run(conn, archive, cfg, universe, item, route.sequence_no, resume_from=route.resume_from, transport=transport, log=log)
    94	            day_stats['extracted'] += 1
    95	            day_stats['evidence'] += result.evidence
    96	            day_stats['new_views'] += result.new_views
    97	            day_stats['judged'] += result.judged
    98	            day_stats['changed'] += result.changed
    99	            day_cost += result.cost
   100	            if result.failed:
   101	                day_stats['failed'] += 1
   102	                log(f'  ! {item["input_id"][:60]}: {result.failed}')
   103	                raise RuntimeError(f'item failed; day {day} remains resumable: {result.failed}')
   104	            if spend_cap_usd is not None and archive.totals()[1] - cost_before > spend_cap_usd:
   105	                raise RuntimeError(f'spend cap {spend_cap_usd} reached on {day}')
   106	        seq = store.next_sequence(conn) - 1
   107	        judged = round_module.judge_day(conn, archive, cfg, day, seq, transport=transport, log=log)
   108	        day_stats['judged'] += judged.judged
   109	        day_stats['changed'] += judged.changed
   110	        day_cost += judged.cost
   111	        if judged.failed:
   112	            day_stats['failed'] += 1
   113	            log(f'  ! day judging: {judged.failed}')
   114	            raise RuntimeError(f'judging failed; day {day} remains resumable: {judged.failed}')
   115	        closed = pull.end_of_day(conn, day, seq)
   116	        day_stats['closed'] = len(closed)
   117	        store.complete_day(conn, day, seq, time.strftime('%Y-%m-%dT%H:%M:%S'))
   118	        conn.commit()
   119	        for key in totals:
   120	            totals[key] += day_stats[key]
   121	        calls, cost, _, _ = archive.totals()
   122	        open_count = len(store.open_views(conn))
   123	        log(f'{day} | items {day_stats["items"]:3d} extracted {day_stats["extracted"]:3d} merged {day_stats["merged"]:2d} skipped {day_stats["not_processed"]:2d} '
   124	            f'failed {day_stats["failed"]:2d} | evidence {day_stats["evidence"]:3d} new views {day_stats["new_views"]:2d} judged {day_stats["judged"]:3d} '
   125	            f'changed {day_stats["changed"]:3d} closed {len(closed)} | open views {open_count} | day ${day_cost:.2f} total ${cost - cost_before:.2f} calls {calls - calls_before}')
   126	        if day0 and day == day0:
   127	            conn.commit()
   128	            shutil.copy(views_path, views_path + '.day0.sqlite')
   129	            log(f'day 0 snapshot written: {views_path}.day0.sqlite')
   130	    return totals
   194	def round_of_judgements(archive, cfg, conn, changed_views, seq, item, *, transport=None):
   195	    """Judge the open views in changed_views, dependencies first; a changed conclusion queues open dependants.
   196	
   197	    Views that do not depend on each other are judged at the same time: each level of the dependency order is sent
   198	    to the model concurrently (the prompts are built and the answers checked and written in this thread, so the
   199	    database connection never crosses threads). A view waits while anything upstream of it is still pending, so a
   200	    dependant always reads this round's conclusion of its dependency. A view with no evidence in force stays
   201	    unjudged (D59), and a view already judged at this sequence number (a resumed round) is not judged twice."""
   202	    import concurrent.futures
   203	
   204	    schema = schema_for(cfg.rejudging.prompt_version)
   205	
   206	    def eligible(view_id):
   207	        return store.is_open(conn, view_id) and not store.has_judgement(conn, view_id, seq) and bool(store.evidence_in_force(conn, view_id))
   208	
   209	    pending = [v for v in topological(conn, changed_views) if eligible(v)]
   210	    done, results = set(), []
   211	    while pending:
   212	        level = [v for v in pending if upstream(conn, v).isdisjoint(set(pending) - {v})] or pending[:1]
   213	        prompts = {v: build_prompt(conn, v, cfg.rejudging.prompt_version) for v in level}
   214	
   215	        def ask(view_id, note=''):
   216	            system, user = prompts[view_id]
   217	            return model.call(archive, cfg, cfg.rejudging, system, user + note, schema, 'judgement', 'judge', transport=transport)
   218	
   219	        with concurrent.futures.ThreadPoolExecutor(max_workers=JUDGE_WORKERS) as pool_:
   220	            answers = dict(zip(level, pool_.map(ask, level)))
   221	        for view_id in level:
   222	            answer = answers[view_id]
   223	            errors = check_answer(conn, view_id, answer.data)
   224	            if errors:
   225	                answer = ask(view_id, retry_note(cfg.rejudging.prompt_version, errors))
   226	                errors = check_answer(conn, view_id, answer.data)
   227	                if errors:
   228	                    raise JudgementRefused(f'{view_id}: ' + '; '.join(errors))
   229	            result = _record(conn, cfg, view_id, seq, item, answer)
   230	            done.add(view_id)
   231	            results.append(result)
   232	            if result['changed']:
   233	                for dependant in store.dependants_of(conn, view_id):
   234	                    if dependant not in done and dependant not in pending and eligible(dependant):
   235	                        pending.append(dependant)
   236	        pending = [v for v in topological(conn, pending) if v not in done and eligible(v)]
   237	    return results

