   324	def check_bounds(rungs):
   325	    """None when the rungs' numeric bounds form one unbroken partition (or none carries bounds), else the problem."""
   326	    bounded = [r for r in rungs if r.get('lo') is not None or r.get('hi') is not None]
   327	    if not bounded:
   328	        return None
   329	    if len(bounded) != len(rungs):
   330	        return 'some rungs carry bounds and some do not'
   331	    ordered = sorted(rungs, key=lambda r: -1e300 if r.get('lo') is None else float(r['lo']))
   332	    for a, b in zip(ordered, ordered[1:]):
   333	        if a.get('hi') is None or b.get('lo') is None or float(a['hi']) != float(b['lo']):
   334	            return 'rung bounds overlap or leave a gap'
   335	    if ordered[-1].get('hi') is not None:
   336	        return 'the top rung must be open above'
   337	    return None
