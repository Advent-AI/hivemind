   432	def groups_for_prompt(conn, object_ids, text, top_n=10):
   433	    """05-extraction block 5b: the research groups the model may place a candidate in: every group with a member among
   434	    the objects' views, then the top N groups whose name, scope or objects match the item's title and objects (other
   435	    companies included). Each with its member theses' focus, so the model reads what the subject is about."""
   436	    found, order = {}, []
   437	    for object_id in object_ids:
   438	        for row in conn.execute("""select distinct g.* from thesis_groups g join thesis_group_members m on m.group_id=g.group_id
   439	                                   join views v on v.view_id=m.view_id where v.object_id=? order by g.created_seq""", (object_id,)):
   440	            if row['group_id'] not in found:
   441	                found[row['group_id']] = _group_record(row); order.append(row['group_id'])
   442	    words = [w for w in re.findall(r'[A-Za-z0-9][A-Za-z0-9.&-]+', f'{" ".join(object_ids)} {text or ""}') if len(w) >= 3]
   443	    if words:
   444	        query = ' OR '.join('"' + w.replace('"', '') + '"' for w in dict.fromkeys(words[:24]))
   445	        try:
   446	            for r in conn.execute('select group_id from groups_fts where groups_fts match ? order by rank limit ?', (query, top_n)):
   447	                if r['group_id'] not in found:
   448	                    found[r['group_id']] = group(conn, r['group_id']); order.append(r['group_id'])
   449	        except sqlite3.OperationalError:
   450	            pass
   110	def grouped_schema(shown_group_ids, aliases=False, measures=MEASURES):
   111	    """The English keyed schema plus research-group membership (D149, the D147 reference shape): each candidate cites one or
   112	    more groups, each either a group id shown in this request or a local id declared in new_groups; the pattern is built
   113	    from the shown ids, so an unseen group cannot be cited."""
   114	    schema = keyed_schema(english=True, measures=measures)
   115	    pattern = '^(?:' + LOCAL_GROUP + ''.join('|' + re.escape(g) for g in shown_group_ids) + ')$'
   116	    candidate = schema['properties']['candidates']['items']
   117	    candidate['properties']['group_refs'] = {'type': 'array', 'items': {'type': 'string', 'pattern': pattern}}
   118	    candidate['required'].append('group_refs')
   119	    group_fields = {'id': {'type': 'string', 'pattern': '^' + LOCAL_GROUP + '$'}, 'name': {'type': 'string'}, 'scope': {'type': 'string'}}
   120	    if aliases:
   121	        group_fields['aliases'] = {'type': 'array', 'items': {'type': 'string'}}
   122	    schema['properties']['new_groups'] = {'type': 'array', 'items': {'type': 'object', 'additionalProperties': False, 'required': list(group_fields), 'properties': group_fields}}
   123	    schema['required'].append('new_groups')
   124	    return schema
   125	
   126	
   127	def schema_for(version, shown_group_ids=()):
   128	    number = version_number(version)
   129	    measures = MEASURES_V10 if number >= MEASURES_V10_FROM else MEASURES
   130	    if number >= GROUPS_FROM:
   131	        return grouped_schema(shown_group_ids, aliases=number >= ALIASES_FROM, measures=measures)
   132	    if number >= ENGLISH_FROM:
   133	        return keyed_schema(english=True)
   134	    return keyed_schema() if number >= 4 else SCHEMA
