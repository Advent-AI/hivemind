   280	        return []
   281	    query = ' OR '.join('"' + w.replace('"', '') + '"' for w in words[:12])
   282	    try:
   283	        rows = conn.execute('select view_id from views_fts where views_fts match ? order by rank limit ?', (query, top_n)).fetchall()
   284	    except sqlite3.OperationalError:
   285	        return []
   286	    return [r['view_id'] for r in rows]
