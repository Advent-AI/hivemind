   237	def would_cycle(conn, view_id, depends_on):
   238	    """True when depends_on already depends, directly or through its dependencies, on view_id."""
   239	    seen, stack = set(), [depends_on]
   240	    while stack:
   241	        current = stack.pop()
   242	        if current == view_id:
   243	            return True
   244	        if current in seen or not current:
   245	            continue
   246	        seen.add(current)
   247	        for dep in dependencies_of(conn, current):
   248	            if dep['resolved_to']:
   249	                stack.append(dep['resolved_to'])
   250	    return False
