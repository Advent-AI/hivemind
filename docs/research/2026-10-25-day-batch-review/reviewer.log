    46	def candidate_state(c, evidence):
    47	    rungs = ' / '.join(f'{r["label"]}: {r["condition"]}' for r in c['rungs'])
    48	    fields = ', '.join(f'{f}={c[f]}' for f in ('measure', 'scope', 'period_start', 'period_end', 'basis', 'unit', 'event_type') if c.get(f) not in (None, '', 'n/a'))
    49	    own = ' | '.join(f'[{e["speaker"]} {e["original_day"]}] {e["quote"][:400]}' for e in evidence if e['id'] in c.get('evidence_ids', []))[:1600]
    50	    return (f'CANDIDATE ({c["kind"]}, object {c["object"]}, focus "{c["looks_at"]}", {c["year"]}, due {c["due_day"]}): {c["question"]}\n'
    51	            f'Key: {fields}\nLadder: {rungs}\nIts evidence: {own}')
