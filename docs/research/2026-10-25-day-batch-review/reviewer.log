   221	        if not targets:
   222	            notes.append(f'evidence {e["id"]} linked to nothing kept; not stored')
   223	            continue
   224	        # one piece is stored once however many views it goes to (06-views: 一条证据连几条观点，也只存一条); a repeat
   225	        # under any destination means the piece already exists and is linked on, a replacement under any
   226	        # destination replaces there and links everywhere, a late older statement is logged and linked nowhere
   227	        repeat_of = next((target for _, (outcome, target, _) in targets if outcome == 'repeat' and target), None)
   228	        replacing = [(target, said_day) for _, (outcome, target, said_day) in targets if outcome == 'replace' and target]
