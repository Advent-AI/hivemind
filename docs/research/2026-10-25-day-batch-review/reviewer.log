   101	def build_request(setting, system, user, schema, schema_name, provider):
   102	    request = {
   103	        'model': setting.model,
   104	        'messages': [{'role': 'system', 'content': system}, {'role': 'user', 'content': user}],
   105	        'response_format': {'type': 'json_schema', 'json_schema': {'name': schema_name, 'strict': True, 'schema': schema}},
   106	    }
   107	    if provider == 'openai':
   108	        # gpt-6-luna is a reasoning model: it refuses any temperature but the default, so the setting's temperature
   109	        # is recorded in Config but not sent; reasoning_effort is what steers it.
   110	        request['max_completion_tokens'] = setting.max_output_tokens
   111	        if setting.reasoning_effort:
   112	            request['reasoning_effort'] = setting.reasoning_effort
   113	    else:
   114	        request['temperature'] = setting.temperature
   115	        request['max_tokens'] = setting.max_output_tokens
   116	    return request
