   356	                    break
   357	                if view_id == cid:
   358	                    refusals.append(f'candidate {cid}: depends on itself')
   359	                    bad = True
   360	                    break
   361	                deps.append({'view_id': view_id, 'wait_chain_view_id': None, 'wait_year': None, 'direction': dep['direction']})
   362	            elif chain and year:
