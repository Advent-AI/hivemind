   216	def dependencies_of(conn, view_id):
   217	    """Each dependency with its current target: the resolved view, or the waiting chain and year."""
   218	    out = []
   219	    for dep in conn.execute('select * from dependencies where view_id=? order by dependency_id', (view_id,)):
   220	        dep = dict(dep)
   221	        resolution = conn.execute('select resolved_to, reason from dependency_resolutions where dependency_id=? order by id desc limit 1', (dep['dependency_id'],)).fetchone()
   222	        if resolution:
   223	            dep['resolved_to'], dep['resolution'] = resolution['resolved_to'], resolution['reason']
   224	        else:
   225	            dep['resolved_to'], dep['resolution'] = dep['depends_on'], ('direct' if dep['depends_on'] else 'waiting')
   226	        out.append(dep)
   227	    return out
