   385	    refusals.extend(coalescing_errors)
   386	    evidence_out = {}
   387	    answered_e = {(d['id'], d['view_id']): d for d in decisions.get('evidence', [])}
   388	    shown_evidence = {e for listed in lists.evidence_lists.values() for e in listed}      # every evidence id this request shows the model
   389	    shown_for_piece = {}                                                                     # handover piece -> ids shown for it under any thesis
   390	    for (piece_id, _), listed in lists.evidence_lists.items():
   391	        shown_for_piece.setdefault(piece_id, set()).update(listed)
   392	    for key, listed in lists.evidence_lists.items():
   393	        d = answered_e.get(key)
   394	        if not d:
   395	            refusals.append(f'evidence {key[0]} under {key[1]} has no decision')
