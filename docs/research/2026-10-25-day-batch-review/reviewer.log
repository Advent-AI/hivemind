    72	    def lookup(self, sha):
    73	        with self.lock:
    74	            return self.conn.execute('select call_id, answer_json, prompt_chars, input_tokens, output_tokens from model_calls where request_sha256=?', (sha,)).fetchone()
    75	
    76	    def record(self, **fields):
    77	        """One row per distinct request; a second identical request recorded at the same moment (two threads, or a
    78	        failed answer repeated within the same second) keeps the first row's id instead of failing."""
    79	        columns = list(fields)
    80	        with self.lock:
    81	            cursor = self.conn.execute(f'insert or ignore into model_calls ({",".join(columns)}) values ({",".join("?" * len(columns))})',
    82	                                       [fields[c] for c in columns])
    83	            self.conn.commit()
    84	            if cursor.rowcount == 0:
    85	                return self.conn.execute('select call_id from model_calls where request_sha256=?', (fields['request_sha256'],)).fetchone()[0]
    86	            return cursor.lastrowid
    87	
    88	    def totals(self):
