   206	def dependency_text(view, english):
   207	    """Who a shown view depends on, for block 5: resolved theses by id, a waiting dependency by its chain and year."""
   208	    entries = view.get('dependencies')
   209	    if entries is None:                                   # a caller that built the view without the structured list
   210	        return list(view.get('depends_on') or [])
   211	    out = []
   212	    for entry in entries:
   213	        if entry.get('view_id'):
   214	            out.append(entry['view_id'])
   215	        elif english:
   216	            out.append(f'(waiting for the {entry["wait_year"]} thesis on chain {entry["wait_chain_view_id"]})')
   217	        else:
   218	            out.append(f'（等 {entry["wait_chain_view_id"]} 这条链上 {entry["wait_year"]} 年的那条）')
   219	    return out
