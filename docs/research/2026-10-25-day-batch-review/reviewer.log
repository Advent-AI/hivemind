    70	def relation_question(text):
    71	    return {'type': 'choice', 'criteria': RELATIONS,
    72	            'instructions': 'What relationship holds between the CANDIDATE and the THESIS below? Use only the supplied text. Equal numbers and similar wording do not establish identity. THESIS:\n' + text}
    73	
    74	
    75	def member_question(text):
    76	    return {'type': 'noul', 'criteria': MEMBER_CRITERIA,
    77	            'instructions': 'Does the CANDIDATE belong to the ongoing matter defined by GROUP below? Use only the supplied text; a shared company, industry or word is not enough. GROUP:\n' + text}
    78	
    79	
    80	def piece_question(text):
    81	    return {'type': 'choice', 'criteria': PIECES,
    82	            'instructions': 'How does the INCOMING PIECE relate to the STORED PIECE below, already under the same thesis? Use only the supplied text. STORED PIECE:\n' + text}
