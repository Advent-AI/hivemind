   112	def decide(archive, cfg, conn, item, candidates, evidence, lists, shown_views, *, extra_views=(), retry_note='', transport=None):
   113	    setting = cfg.matching
   114	    data = {'candidates': [], 'evidence': []}
   115	    total = Decision(data, 0, '', True, 0, 0, 0, 0.0)
   116	    shas = []
   117	
   118	    def ask(state, questions):
   119	        answer = jev.ask(archive, cfg, setting, state, questions, 'match', transport=transport)
   120	        total.cost_usd += answer.cost_usd
   121	        total.input_tokens += answer.input_tokens
   122	        total.output_tokens += answer.output_tokens
   123	        total.prompt_chars += answer.prompt_chars
   124	        total.cached = total.cached and answer.cached
   125	        total.call_id = answer.call_id
   126	        total.calls += 1
   127	        shas.append(answer.request_sha256)
   128	        return answer.data
   129	
   130	    for c in candidates:
   131	        listed = list(dict.fromkeys(list(lists.candidate_lists.get(c['id'], [])) + [v['view_id'] for v in shown_views]))   # the targets matching.check accepts
   132	        questions = {f'rel__{v}': relation_question(thesis_text(conn, v)) for v in listed}
   133	        # D165: a company's own line may join a group another thesis founded, so membership is asked for every candidate; founding stays guarded in groups.plan
   134	        groups = store.groups_for_prompt(conn, [c['object']], f'{c["looks_at"]} {c["question"]}')
   135	        for g in groups:
   136	            questions[f'member__{g["group_id"]}'] = member_question(group_text(g))
   137	        answers = ask(candidate_state(c, evidence), questions) if questions else {}
   138	        same = sorted(((answers[f'rel__{v}']['probabilities']['same_quantity_or_event'], v) for v in listed
   139	                       if answers[f'rel__{v}']['choice'] == 'same_quantity_or_event' and answers[f'rel__{v}']['probabilities']['same_quantity_or_event'] >= THRESHOLD),
   140	                      reverse=True)
   141	        joined = [g['group_id'] for g in groups if answers[f'member__{g["group_id"]}']['noul'] >= THRESHOLD]
   142	        for group_id in joined:
   143	            if group_id not in (c.get('group_refs') or []) and group_id not in (c.get('jev_group_refs') or []):
   144	                c.setdefault('jev_group_refs', []).append(group_id)          # the writer records these with basis 'jev'
   145	        reasons = '; '.join(f'{qid[5:]}: {_summary(a)}' for qid, a in answers.items() if qid.startswith('rel__'))
   146	        outcome, target = 'new', ''
   147	        for _, v in same:
   148	            # the key decides what 'the same' may mean: a different quantity is declined here; the same quantity for a later period is a
   149	            # succession (06-views), when the thesis has no successor yet; otherwise a merge into an open thesis
   150	            key = store.view_key(conn, v) if c.get('measure') else None
   151	            if key and identity.conflicts(key, c, merging=False):
   152	                continue
   153	            if key and identity.conflicts(key, c, merging=True):          # the same quantity for another period
   154	                if can_succeed(conn, v, key, c):
   155	                    outcome, target = 'succession', v
   156	                    break
   157	                continue
   158	            if store.is_open(conn, v):
   159	                outcome, target = 'merge', v
   160	                break
   161	        if outcome == 'new':
   162	            # the judge says 'the same quantity for another period'; code decides the direction, the typed fields and the successor
   163	            other = sorted(((answers[f'rel__{v}']['probabilities']['same_quantity_other_period'], v) for v in listed
   164	                            if answers[f'rel__{v}']['choice'] == 'same_quantity_other_period' and answers[f'rel__{v}']['probabilities']['same_quantity_other_period'] >= THRESHOLD),
   165	                           reverse=True)
   166	            for _, v in other:
   167	                key = store.view_key(conn, v) if c.get('measure') else None
   168	                if can_succeed(conn, v, key, c):
   169	                    outcome, target = 'succession', v
   170	                    break
   171	        if outcome == 'new':
   172	            successor_of = succession_target(conn, c, listed)
   173	            if successor_of:
   174	                outcome, target = 'succession', successor_of
   175	        data['candidates'].append({'id': c['id'], 'outcome': outcome, 'target_view_id': target or '', 'dependencies': [],
   176	                                   'reason': f'jev: {reasons or "no list"}; groups joined: {joined or "none"}'})
   177	    for e in evidence:
   178	        pairs = [(e['id'], v) for v in e['links'] if (e['id'], v) in lists.evidence_lists]
   179	        if not pairs:
   180	            continue
   181	        questions = {f'piece__{v}__{x}': piece_question(matching.describe_evidence(conn, x, english=True)) for _, v in pairs for x in lists.evidence_lists[(e['id'], v)]}
   182	        said_day = e.get('original_day') or item['publication_day']
   183	        answers = ask(piece_state(e, said_day), questions) if questions else {}
   184	        for _, v in pairs:
   185	            scored = [(answers[f'piece__{v}__{x}'], x) for x in lists.evidence_lists[(e['id'], v)]]
   186	            repeats = sorted(((a['probabilities']['same_statement'], x) for a, x in scored if a['choice'] == 'same_statement' and a['probabilities']['same_statement'] >= THRESHOLD), reverse=True)
   187	            replaces = sorted(((a['probabilities']['supersedes'], x) for a, x in scored if a['choice'] == 'supersedes' and a['probabilities']['supersedes'] >= THRESHOLD), reverse=True)
   188	            outcome, target = ('repeat', repeats[0][1]) if repeats else ('replace', replaces[0][1]) if replaces else ('new', '')
   189	            data['evidence'].append({'id': e['id'], 'view_id': v, 'outcome': outcome, 'target_evidence_id': target or '', 'said_day': said_day,
   190	                                     'reason': 'jev: ' + '; '.join(f'{x}: {_summary(a)}' for a, x in scored)})
   191	    total.request_sha256 = hashlib.sha256('+'.join(shas).encode('utf-8')).hexdigest() if shas else ''
   192	    return total

