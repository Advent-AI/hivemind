   369	            continue
   370	        outcomes[cid] = (outcomes[cid][0], outcomes[cid][1], deps)
   371	    # no cycle among the candidates of one answer (06-views: 会的话这条不收，退回给模型改)
   372	    graph = {cid: [d['view_id'] for d in outcomes[cid][2] if d['view_id'] in candidate_by_id] for cid in raw_deps if cid in outcomes}
   373	    for cid in graph:
   374	        stack, seen = list(graph[cid]), set()
   375	        while stack:
   376	            current = stack.pop()
   377	            if current == cid:
   378	                refusals.append(f'candidate {cid}: its dependencies lead back to itself')
