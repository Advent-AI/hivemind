   263	def check(conn, universe, decisions, candidates, evidence, lists, shown_views):
   264	    decisions = vocabulary.matching_answer(decisions)
   265	    candidates = [vocabulary.candidate(c) for c in candidates]
   266	    shown_ids = {v['view_id'] for v in shown_views}
   267	    candidate_by_id = {c['id']: c for c in candidates}
   268	    # D51: a dependency is chosen among the views the model has in front of it: every list shown in this call,
   269	    # the views shown at extraction, and the candidates this answer opens
