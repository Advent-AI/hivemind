   354	def sift_with_groups(data, item, text, shown_ids, universe=None, english=False, shown_group_ids=()):
   355	    """sift, plus the research-group declarations (D149): candidates with bad references are dropped; a declared group is
   356	    kept only when a kept candidate cites it (an unused declaration is ignored, D147). Returns (evidence, candidates, dropped, new_groups)."""
   357	    declared = {}
   358	    for g in data.get('new_groups', []) or []:
   359	        if g['id'] in declared or not g['name'].strip() or not g['scope'].strip():
   360	            declared = None
   361	            break
   362	        declared[g['id']] = {'id': g['id'], 'name': g['name'].strip(), 'scope': g['scope'].strip(), 'aliases': [a.strip() for a in g.get('aliases') or [] if a.strip()]}
   363	    dropped_refs = []
   364	    if declared is None:         # malformed declarations: every candidate citing a local id is dropped, shown ids still work
   365	        declared = {}
   366	    checked = dict(data, candidates=[])
   367	    for c in data.get('candidates', []):
   368	        problem = check_group_refs(c, set(shown_group_ids), declared)
   369	        if problem:
   370	            dropped_refs.append((c['id'], f'candidate group: {problem}'))
   371	            continue
   372	        checked['candidates'].append(c)
   373	    evidence, candidates, dropped = sift(checked, item, text, shown_ids, universe, english=english)
   374	    used = {r for c in candidates for r in c.get('group_refs', [])}
   375	    return evidence, candidates, dropped_refs + dropped, [declared[g] for g in declared if g in used]
