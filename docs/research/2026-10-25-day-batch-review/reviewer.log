    62	class Archive:
    63	    """Shared by the extraction worker threads: one connection, every access under a lock."""
    64	
    65	    def __init__(self, path):
    66	        os.makedirs(os.path.dirname(os.path.abspath(path)), exist_ok=True)
    67	        self.conn = sqlite3.connect(path, check_same_thread=False)
    68	        self.conn.executescript(SCHEMA_SQL)
    69	        import threading
    70	        self.lock = threading.Lock()
