    10	import hashlib
    11	
    12	from .. import jev, universe as _universe
    13	from . import identity, matching, store
    14	
    15	THRESHOLD = 0.5
    16	RELATIONS = {"same_quantity_or_event": "both ask about the same defined quantity or the same event: alternative wordings, or two estimates or figures of that one quantity",
    17	             "same_quantity_other_period": "the same defined quantity or event series for another period, such as the next fiscal or calendar year",
    18	             "part_of": "one asks about a strict component or subset of the other, in either direction; not identical",
    19	             "same_matter_different_quantity": "one ongoing matter, two distinct quantities or events, neither a component of the other",
    20	             "different": "different matters; sharing a company or industry is not enough",
    21	             "cannot_tell": "the supplied material is insufficient or inconsistent"}
    22	MEMBER_CRITERIA = {"true": "the CANDIDATE tracks this matter, one of its stated components, its implementation, or a deployment the supplied material connects to it",
    23	                   "false": "the supplied material shows a different matter, or a question outside the GROUP's stated scope"}
    24	# 06-views.md, the evidence table: repeat = "the same evidence already exists under the thesis: a retelling, the same number in text and
    25	# table, or the same speaker repeating the same statement"; replace = "a later account of the same matter: a speaker revises guidance,
    26	# forecast or event progress; an official confirms/denies a rumour; or the original source revises its statement". The criteria carry
    27	# those words; the first seed run (log row 35) read "same occasion" into them and missed six cross-document repeats.
    28	PIECES = {"same_statement": "the same evidence: a retelling, the same number stated in text and in a table or in another document, or the same speaker repeating the same statement; wording, precision and document may differ",
    29	          "supersedes": "a later version of the same statement or number, changed: the same speaker revises that guidance, forecast or event-progress statement, an official confirms or denies that reported claim, or the original source revises that statement; another statement on the same topic is not this",
    30	          "different": "a different fact, figure or matter, or a figure for another period or quantity, even if on the same topic"}
