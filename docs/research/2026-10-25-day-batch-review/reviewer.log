   105	def _summary(answer):
   106	    if answer['type'] == 'noul':
   107	        return f'{answer["noul"]:.2f}'
   108	    top = max(answer['probabilities'].items(), key=lambda kv: kv[1])
   109	    return f'{top[0]} {top[1]:.2f}'
