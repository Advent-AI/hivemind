   271	    for hits in lists.candidate_lists.values():
   272	        listed_all.update(hits)
   273	    refusals, outcomes, not_opened, notes = [], {}, {}, []
   274	    raw_deps = {}
   275	    succession_targets = {}
   276	    answered = {d['id']: d for d in decisions.get('candidates', [])}
   277	    for c in candidates:
   278	        d = answered.get(c['id'])
   279	        if not d:
   280	            refusals.append(f'candidate {c["id"]} has no decision')
   281	            continue
   282	        outcome, target = d['outcome'], d['target_view_id'].strip()
   283	        listed = set(lists.candidate_lists.get(c['id'], [])) | shown_ids
   284	        if outcome in ('merge', 'succession') and target in candidate_by_id:
   285	            # a candidate cannot merge into another candidate of the same answer: only a stored thesis has a ladder and a due day to
   286	            # inherit. The model usually means "part of": both open, and the key coalesces them when they are the same quantity.
   287	            notes.append(f'candidate {c["id"]}: {outcome} into candidate {target} is not a destination; opened as a new view')
