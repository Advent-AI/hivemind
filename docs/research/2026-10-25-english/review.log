    88	def _key(provider):
    89	    name = ENDPOINTS[provider][1]
    90	    if os.environ.get(name):
    91	        return os.environ[name]
    92	    with open(CREDENTIALS, encoding='utf-8') as handle:
    93	        return json.load(handle)[name]
