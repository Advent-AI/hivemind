     7	def automatic_key(value, object_id=None):
     8	    """Return a complete, code-owned key, or None when identity still needs judgement."""
     9	    if value.get('key_version') != KEY_VERSION or value.get('scope_source') not in ('none', 'watch'):
    10	        return None
    11	    if value.get('measure') in (None, 'other'):
    12	        return None
    13	    if value['measure'] in ('event', 'policy_event') and value.get('event_type') in (None, 'other', 'n/a'):
    14	        return None
    15	    return (object_id or value.get('object'), value['measure'], scope_key(value.get('scope', '')),
    16	            value.get('period_start'), value.get('period_end'), value.get('basis'), value.get('unit'), value.get('event_type'))
