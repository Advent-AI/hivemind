   349	def replace_block(text, name, body):
   350	    start_marker, end_marker = f"<!-- generated: {name} -->", f"<!-- /generated: {name} -->"
   351	    if text.count(start_marker) != 1 or text.count(end_marker) != 1:
   352	        return None
   353	    start = text.index(start_marker) + len(start_marker)
   354	    end = text.index(end_marker)
   355	    return text[:start] + "\n" + body + "\n" + text[end:]
