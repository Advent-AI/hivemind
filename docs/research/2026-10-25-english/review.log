   204	def table(headers, rows):
   205	    lines = ["| " + " | ".join(headers) + " |", "|" + "|".join(["---"] * len(headers)) + "|"]
   206	    return "\n".join(lines + ["| " + " | ".join(cell(value) for value in row) + " |" for row in rows])
