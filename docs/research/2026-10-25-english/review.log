   136	            dependencies_written.add(edge)
   137	            store.insert(conn, 'dependencies', view_id=view_id, depends_on=depends_on, wait_chain_view_id=chain, wait_year=dep['wait_year'],
   138	                         direction=dep['direction'], seq=seq)
   139	        resolve_waiting(conn, view_id, seq, changed)
   140	    # 3. where each piece of evidence goes
   141	    def destinations(e):
   142	        targets = []
   143	        for link in e['links']:
   144	            if link in new_views:
   145	                targets.append((new_views[link], ('新证据', None, '')))
   146	            elif link in checked.outcomes and checked.outcomes[link][0] == '归入已有的':
   147	                targets.append((checked.outcomes[link][1], second_pass.get((e['id'], checked.outcomes[link][1]), ('新证据', None, ''))))
   148	            elif link in checked.outcomes:
   149	                continue   # a candidate that was not opened: evidence only on it is not stored
   150	            elif (e['id'], link) in checked.evidence:
   151	                targets.append((link, checked.evidence[(e['id'], link)]))
   152	            elif (e['id'], link) in second_pass:
   153	                targets.append((link, second_pass[(e['id'], link)]))
   154	        return targets
   155	
   156	    for e in handover.evidence:
   157	        targets = destinations(e)
   158	        if not targets:
   159	            notes.append(f'evidence {e["id"]} linked to nothing kept; not stored')
   160	            continue
   161	        # one piece is stored once however many views it goes to (06-views: 一条证据连几条观点，也只存一条); a repeat
   162	        # under any destination means the piece already exists and is linked on, a replacement under any
   163	        # destination replaces there and links everywhere, a late older statement is logged and linked nowhere
   164	        repeat_of = next((target for _, (outcome, target, _) in targets if outcome == '重复' and target), None)
   165	        replacing = [(target, said_day) for _, (outcome, target, said_day) in targets if outcome == '替代' and target]
   166	        if repeat_of:
   167	            store.add_source(conn, repeat_of, item['input_id'], item['category'], item['publication_day'], e.get('location', ''), seq)
   168	            for view_id, _ in targets:
   169	                if store.link(conn, repeat_of, view_id, seq):
   170	                    changed.add(view_id)       # newly linked existing evidence counts as a change for that view
   171	            evidence_ids[e['id']] = repeat_of
   172	            continue
   173	        if replacing:
   174	            target_id, said_day = replacing[0]
   175	            old = store.evidence(conn, target_id)
   176	            new_day = said_day or e['original_day'] or item['publication_day']
   177	            if old and old['original_day'] and new_day < old['original_day']:
   178	                store.insert(conn, 'late_statements', input_id=item['input_id'], evidence_quote=e['quote'][:500], reason=f'older than {target_id} ({old["original_day"]})', seq=seq)
   179	                notes.append(f'evidence {e["id"]}: late older statement, not linked')
   180	                continue
   181	            stored_id = _store_piece(conn, dict(e, original_day=new_day), seq, item)
   182	            for target_id, _ in replacing:
   183	                if not store.is_replaced(conn, target_id):
   184	                    store.replace(conn, target_id, stored_id, new_day, seq)
   185	                for linked in store.views_linked_to(conn, target_id):
   186	                    if store.link(conn, stored_id, linked, seq) and store.is_open(conn, linked):
   187	                        changed.add(linked)
   188	            for view_id, _ in targets:
   189	                store.link(conn, stored_id, view_id, seq)
   190	                changed.add(view_id)
   191	            evidence_ids[e['id']] = stored_id
   192	            continue
   193	        stored_id = _store_piece(conn, e, seq, item)
   194	        for view_id, _ in targets:
   195	            store.link(conn, stored_id, view_id, seq)
   196	            changed.add(view_id)
   197	        evidence_ids[e['id']] = stored_id
   198	    return Written(changed, new_views, evidence_ids, notes)

