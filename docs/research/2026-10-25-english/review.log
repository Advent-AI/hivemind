   157	
   158	    def eligible(view_id):
   159	        return store.is_open(conn, view_id) and not store.has_judgement(conn, view_id, seq) and bool(store.evidence_in_force(conn, view_id))
   160	
   161	    pending = [v for v in topological(conn, changed_views) if eligible(v)]
