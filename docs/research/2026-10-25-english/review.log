   136	def upstream(conn, view_id):
   137	    """Every view this one depends on, directly or through its dependencies."""
   138	    seen, stack = set(), [view_id]
   139	    while stack:
   140	        for dep in store.dependencies_of(conn, stack.pop()):
   141	            target = dep['resolved_to']
   142	            if target and target not in seen:
   143	                seen.add(target)
   144	                stack.append(target)
