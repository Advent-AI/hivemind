   358	def main():
   359	    problems = []
   360	    data = run_node(EXTRACT)
   361	
   362	    drifted = []
   363	    for (file, name), body in blocks(data).items():
   364	        text = (PRD / file).read_text(encoding="utf-8")
   365	        expected = replace_block(text, name, body)
   366	        if expected is None:
   367	            problems.append(f"{file}: generated block {name!r} is missing or doubled")
   368	        elif expected != text:
   369	            drifted.append(f"{file}#{name}")
   370	    print(f"PRD blocks from page data: {len(blocks(data))} checked, {len(drifted)} differ from the page")
   371	    problems += [f"{block} differs from the design page; fix the PRD" for block in drifted]
   372	
   373	    if len(avoided_words("并到原件；见复核池；按模板")) != 3:
   374	        problems.append("the wording check misses its own control sentence")
   375	    for caught, passed in WORD_CONTROLS:
   376	        if not avoided_words(caught):
   377	            problems.append(f"the wording check misses its control sentence {caught!r}")
   378	        if avoided_words(passed):
   379	            problems.append(f"the wording check flags the corrected sentence {passed!r}: {avoided_words(passed)}")
   380	    print(f"wording controls: {len(WORD_CONTROLS)} pairs checked")
   381	    missing = unlisted_constants()
   382	    print(f"page constants: {sum(len(names) for _, names in PAGE_CONSTANTS.values())} listed, {len(missing)} unlisted")
   383	    problems += [f"page constant not listed in check.py: {item}" for item in missing]
   384	    places = wording_scope()
   385	    misused = [f"{place}: {word} (use {use})" for place, body in places.items() for word, use in avoided_words(body)]
   386	    print(f"wording: {len(places)} places read, {len(misused)} avoided words")
   387	    problems += [f"wording: {item}" for item in misused]
   388	
   389	    bundle = subprocess.run([sys.executable, str(PRD / "build_bundle.py")], capture_output=True, text=True)
