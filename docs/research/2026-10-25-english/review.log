     1	"""One model call, archived and replayable.
     2	
     3	`call()` sends a system and user message with a strict JSON schema to an OpenAI-compatible chat endpoint (OpenAI,
     4	or DeepSeek through the same wire format), checks the answer against the schema, and records the exact request and
     5	raw answer in an archive (SQLite, a POC artefact kept beside the test database, never inside the views database).
     6	A request whose sha256 is already in the archive is answered from it without a network call, so a rerun of a
     7	replay costs nothing and gives the same answers. The provider key is read from the owner-only credentials file and
     8	never appears in the archive, logs or arguments.
     9	"""
    10	import dataclasses
    11	import hashlib
    12	import http.client
    13	import json
    14	import os
    15	import sqlite3
    16	import time
    17	import uuid
    18	import urllib.error
    19	import urllib.request
    20	
    21	CREDENTIALS = os.path.expanduser('~/.config/tn-hivemind/credentials.json')
    22	ENDPOINTS = {'openai': ('https://api.openai.com/v1/chat/completions', 'OPENAI_API_KEY'),
    23	             'deepseek': ('https://api.deepseek.com/chat/completions', 'DEEPSEEK_API_KEY')}
    24	# USD per million tokens, for the cost column only (an estimate; the provider's bill is the measurement)
    25	PRICES = {'gpt-6-luna': (1.25, 10.0), 'deepseek-flash': (0.30, 1.20), 'deepseek-v4-pro': (1.32, 3.96)}   # DeepSeek: peak-hour list prices, cache misses (2026-10-23 pricing page)
    26	
    27	SCHEMA_SQL = """
    28	create table if not exists model_calls (
    29	  call_id integer primary key autoincrement, purpose text, config_version text, config_checksum text, model text,
    30	  request_sha256 text unique, request_json text, response_json text, answer_json text, prompt_chars integer,
    31	  input_tokens integer, output_tokens integer, cost_usd real, seconds real, created_at text
    32	);
    33	create index if not exists model_calls_sha on model_calls(request_sha256);
    34	"""
    35	
    36	
    37	class SchemaError(ValueError):
    38	    pass
    39	
    40	
    41	class TransportError(RuntimeError):
    42	    pass
