   227	def node_text(branch):
   228	    """One box of a design-page tree as one line: answer → label｜question（note）."""
   229	    text = (f"{branch['answer']} → " if branch.get("answer") else "") + branch["label"]
   230	    if branch.get("question"):
   231	        text += f"｜{branch['question']}"
   232	    if branch.get("note"):
   233	        text += f"（{branch['note']}）"
   234	    return text
