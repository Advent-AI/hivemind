    57	class Archive:
    58	    """Shared by the extraction worker threads: one connection, every access under a lock."""
    59	
    60	    def __init__(self, path):
    61	        os.makedirs(os.path.dirname(os.path.abspath(path)), exist_ok=True)
    62	        self.conn = sqlite3.connect(path, check_same_thread=False)
    63	        self.conn.executescript(SCHEMA_SQL)
    64	        import threading
    65	        self.lock = threading.Lock()
    66	
    67	    def lookup(self, sha):
    68	        with self.lock:
    69	            return self.conn.execute('select call_id, answer_json, prompt_chars, input_tokens, output_tokens from model_calls where request_sha256=?', (sha,)).fetchone()
    70	
    71	    def record(self, **fields):
    72	        """One row per distinct request; a second identical request recorded at the same moment (two threads, or a
    73	        failed answer repeated within the same second) keeps the first row's id instead of failing."""
    74	        columns = list(fields)
    75	        with self.lock:
    76	            cursor = self.conn.execute(f'insert or ignore into model_calls ({",".join(columns)}) values ({",".join("?" * len(columns))})',
    77	                                       [fields[c] for c in columns])
    78	            self.conn.commit()
    79	            if cursor.rowcount == 0:
    80	                return self.conn.execute('select call_id from model_calls where request_sha256=?', (fields['request_sha256'],)).fetchone()[0]
    81	            return cursor.lastrowid
    82	
    83	    def totals(self):
    84	        with self.lock:
    85	            return self.conn.execute('select count(*), coalesce(sum(cost_usd),0), coalesce(sum(input_tokens),0), coalesce(sum(output_tokens),0) from model_calls').fetchone()
