   213	def tree_children(branch, depth):
   214	    lines = []
   215	    for child in branch.get("children", []):
   216	        pad = "  " * depth
   217	        if child.get("children"):
   218	            question = f"**问：{child['question']}**" + (f"（{child['note']}）" if child.get("note") else "")
   219	            lines.append(f"{pad}- {child['answer']} → {child['label']}，{question}")
   220	            lines += tree_children(child, depth + 1)
   221	        else:
   222	            note = f"：{child['note']}" if child.get("note") else ""
   223	            lines.append(f"{pad}- {child['answer']} → **{child['label']}**{note}")
   224	    return lines
