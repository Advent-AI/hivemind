   237	def ascii_tree(root):
   238	    """A design-page tree drawn with box characters in a code block, so the PRD shows the same picture."""
   239	    lines = [node_text(root)]
   240	
   241	    def walk(branch, prefix):
   242	        children = branch.get("children", [])
   243	        for index, child in enumerate(children):
   244	            last = index == len(children) - 1
   245	            lines.append(prefix + ("└─ " if last else "├─ ") + node_text(child))
   246	            walk(child, prefix + ("    " if last else "│   "))
   247	
   248	    walk(root, "")
   249	    return "```\n" + "\n".join(lines) + "\n```"
   250	
   251	
   252	def step_flow(start, steps):
   253	    """The steps of a process as a downward chain in a code block."""
   254	    lines = [start] + [f"  ↓ {step['code']} {step['name']}（{step['who']}）：{step['does']}" for step in steps]
   255	    return "```\n" + "\n".join(lines) + "\n```"
