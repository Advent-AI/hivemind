   193	def dependencies_of(conn, view_id):
   194	    """Each dependency with its current target: the resolved view, or the waiting chain and year."""
   195	    out = []
   196	    for dep in conn.execute('select * from dependencies where view_id=? order by dependency_id', (view_id,)):
