import sys,json,sqlite3,hashlib,collections,datetime
from pathlib import Path
root=Path(\"/Users/lchingen/hivemind\")
sys.path.insert(0,str(root/\"src\"))
from hivemind import testdb,dispatch,universe
from hivemind.views import store
manifest=json.loads((root/\"poc/reports/2026-10-25-english-library-01/source-manifest.json\").read_text())
conn=sqlite3.connect((root/\"poc/data/items-window-tags2-2026-10-24.sqlite\").as_uri()+\"?mode=ro\",uri=True)
conn.row_factory=sqlite3.Row
routed=sqlite3.connect(\":memory:\")
routed.row_factory=sqlite3.Row
for name in (\"processing_steps\",\"review_pool_entries\"):
 routed.execute(f\"create table {name} ({store.TABLES[name]})\")
uni=universe.load(str(root/\"poc/universe.json\"))
hashes=[]
for obj in manifest[\"source_databases\"]+manifest[\"historical_ledgers\"]+[manifest[\"universe\"]]:
 got=hashlib.file_digest((root/obj[\"path\"]).open(\"rb\"),\"sha256\").hexdigest()
 hashes.append((obj[\"path\"],got==obj[\"sha256\"]))
print(\"Pinned file hashes:\",hashes)
all_entries=[]
for stage in manifest[\"stages\"]:
 entries=[];routes=collections.Counter();bad=[]
 for item in testdb.feed(conn,stage[\"from\"],stage[\"until\"]):
  route=dispatch.route(routed,item,uni);routes[route.kind]+=1
  entries.append({key:item[key] for key in (\"input_id\",\"publication_day\",\"category\",\"title\",\"content_sha256\",\"source_uri\",\"language\",\"text_chars\")} | {\"route\":route.kind,\"reason\":route.reason,\"sequence_no\":route.sequence_no or None})
  if datetime.date.fromisoformat(item[\"publication_day\"]).isoformat()"'!=item["publication_day"]: bad.append((item["input_id"],"date"))
  if item["feed"]==1 and (item["coverage"]!="full" or not item["text"] or hashlib.sha256(item["text"].encode()).hexdigest()!=item["content_sha256"]): bad.append((item["input_id"],"body"))
 print(stage["name"],"count",len(entries),"routes",dict(routes),"exact ordered manifest match",entries==stage["inputs"],"bad",bad)
 all_entries.extend(entries)
print("population",len(all_entries),"unique IDs",len({e["input_id"] for e in all_entries}))
old=sqlite3.connect((root/"poc/data/items-window.sqlite").as_uri()+"?mode=ro",uri=True);old.row_factory=sqlite3.Row
a={r["input_id"]:dict(r) for r in old.execute("select * from items")}
b={r["input_id"]:dict(r) for r in conn.execute("select * from items")}
diff=collections.Counter(k for ident in a for k in a[ident] if a[ident][k]!=b[ident][k])
print("Same complete source ID population:",a.keys()==b.keys(),"changes",dict(diff))
print("Seed objects:",dict(collections.Counter(tuple(o["value"] for o in item["object_identifiers"]) for item in testdb.feed(conn,"2026-02-25","2026-07-23"))))
