    35	def read_only(path):
    36	    if not path.is_file():
    37	        raise ValueError(f'missing database: {path}')
    38	    conn = sqlite3.connect(path.as_uri() + '?mode=ro', uri=True)
    39	    conn.row_factory = sqlite3.Row
    40	    return contextlib.closing(conn)
    41	
    42	
    43	def digest(path):
    44	    value = hashlib.sha256()
    45	    with path.open('rb') as handle:
    46	        for chunk in iter(lambda: handle.read(1024 * 1024), b''):
    47	            value.update(chunk)
    48	    return value.hexdigest()
    49	
    50	
    51	def source_problems(item):
    52	    problems = []
    53	    try:
    54	        day = item['publication_day']
    55	        if datetime.date.fromisoformat(day).isoformat() != day:
    56	            problems.append('noncanonical publication day')
    57	    except (KeyError, TypeError, ValueError):
    58	        problems.append('invalid publication day')
    59	    if item['feed'] == 1:
    60	        if item['coverage'] != 'full' or not item['text']:
    61	            problems.append('feed item has no full body')
    62	        if hashlib.sha256((item['text'] or '').encode()).hexdigest() != item['content_sha256']:
    63	            problems.append('body does not match stored hash')
    64	    return problems
    65	
    66	
    67	def verify_controls(record):
    68	    """The real filing passes; body/date defects must fail this same check."""
    69	    assert record['input_id'] == KNOWN_INPUT
    70	    assert not source_problems(record), 'known filing failed'
    71	    altered = dict(record, text=record['text'] + '\nchanged body')
    72	    assert 'body does not match stored hash' in source_problems(altered), 'hash control was not caught'
    73	    altered = dict(record, publication_day='not-a-date')
    74	    assert 'invalid publication day' in source_problems(altered), 'date control was not caught'
    75	
    76	
    77	def inventory():
    78	    report = {'decision': 'D163', 'generated_for': '2026-10-25',
    79	              'status': 'input preparation only; no English model run',
    80	              'source_databases': [], 'historical_ledgers': [], 'stages': []}
    81	    before = {rel: digest(ROOT / rel) for rel in (*SOURCES, *LEDGERS)}
    82	    for rel in SOURCES:
    83	        with read_only(ROOT / rel) as conn:
    84	            counts = dict(conn.execute('select count(*) rows, sum(feed=1) feed, '
    85	                                       'min(publication_day) first_day, max(publication_day) last_day from items').fetchone())
    86	            counts['seed_feed'] = conn.execute('select count(*) from items where bootstrap=1 and feed=1').fetchone()[0]
    87	            report['source_databases'].append({'path': rel, 'sha256': before[rel], **counts})
    88	    with read_only(ROOT / SOURCES[0]) as original, read_only(ROOT / SELECTED) as corrected:
    89	        old = {r['input_id']: dict(r) for r in original.execute('select * from items')}
    90	        new = {r['input_id']: dict(r) for r in corrected.execute('select * from items')}
    91	        if old.keys() != new.keys():
    92	            raise ValueError('corrected source population differs from original input IDs')
    93	        immutable = ('text', 'source_uri', 'publication_day', 'content_sha256')
    94	        changes = collections.Counter(key for ident in old for key in old[ident]
    95	                                      if old[ident][key] != new[ident][key])
    96	        report['source_label_changes'] = {'compared': len(old), 'changed_fields': dict(changes),
    97	                                          'source_fields_unchanged': all(not changes[key] for key in immutable)}
    98	        if not report['source_label_changes']['source_fields_unchanged']:
    99	            raise ValueError('corrected labels also changed original source content or identity')
   100	    for rel in LEDGERS:
   101	        with read_only(ROOT / rel) as conn:
   102	            counts = {table: conn.execute(f'select count(*) from {table}').fetchone()[0]
   103	                      for table in ('views', 'evidence', 'judgements')}
   104	            counts['question_with_chinese'] = sum(any('\u4e00' <= c <= '\u9fff' for c in row[0])
   105	                                                  for row in conn.execute('select question from views'))
   106	            report['historical_ledgers'].append({'path': rel, 'sha256': before[rel], **counts})
   107	    uni = universe.load(str(ROOT / 'poc/universe.json'))
   108	    report['universe'] = {'path': 'poc/universe.json', 'sha256': digest(ROOT / 'poc/universe.json'), 'version': uni.version}
   109	    report['source_problems'] = []
   110	    with read_only(ROOT / SELECTED) as conn, tempfile.TemporaryDirectory(prefix='hivemind-input-audit-') as temporary:
   111	        known = dict(conn.execute('select * from items where input_id=?', (KNOWN_INPUT,)).fetchone())
   112	        verify_controls(known)
   113	        report['positive_controls'] = ['known original filing', 'altered body refused', 'invalid date refused']
   114	        with contextlib.closing(store.open_db(str(Path(temporary) / 'dispatch.sqlite'))) as routed:
   115	            for name, first, last in STAGES:
   116	                entries, routes = [], collections.Counter()
   117	                for item in testdb.feed(conn, first, last):
   118	                    problems = source_problems(item)
   119	                    if problems:
   120	                        report['source_problems'].append({'input_id': item['input_id'], 'problems': problems})
   121	                    route = dispatch.route(routed, item, uni)
   122	                    routes[route.kind] += 1
   123	                    entries.append({key: item[key] for key in ('input_id', 'publication_day', 'category', 'title',
   124	                                                              'content_sha256', 'source_uri', 'language', 'text_chars')} |
   125	                                   {'route': route.kind, 'reason': route.reason,
   126	                                    'sequence_no': route.sequence_no or None})
   127	                if not entries or not routes['extract']:
   128	                    raise ValueError(f'empty or unexercised stage: {name}')
   129	                report['stages'].append({'name': name, 'from': first, 'until': last, 'items': len(entries),
   130	                                         'routes': dict(routes), 'inputs': entries})
   131	    changed = [rel for rel, sha in before.items() if digest(ROOT / rel) != sha]
   132	    if changed:
   133	        raise ValueError(f'input databases changed during read-only inventory: {changed}')
   134	    report['all_input_databases_unchanged'] = True
   135	    report['checks'] = {'judged_feed_records': sum(s['items'] for s in report['stages']),
   136	                        'source_failures': len(report['source_problems']),
   137	                        'limit': 'hash/date/full-body consistency and real dispatch only; source meaning not certified'}
   138	    return report
