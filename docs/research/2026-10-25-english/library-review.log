    38	def normalise_reason(text):
    39	    text = re.sub(r"'[^']*'", "'…'", text)
    40	    text = re.sub(r'\[\d+\]', '[]', text)
    41	    text = re.sub(r'\b[ev]\d+\b|\bc\d+\b', '#', text)
    42	    text = re.sub(r'\d{4}-\d{2}-\d{2}', 'DATE', text)
    43	    return text[:90]
