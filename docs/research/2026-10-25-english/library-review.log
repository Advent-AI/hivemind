     1	#!/usr/bin/env python3
     2	"""Run the POC replay.
     3	
     4	  python3 scripts/replay.py --from 2026-02-25 --until 2026-02-25 [--day0 2026-07-24] [--only NVDA] [--cap 50]
     5	  python3 scripts/replay.py --views poc/data/views.sqlite --archive poc/data/archive.sqlite ...
     6	
     7	Defaults: test database poc/corpus/items.sqlite, views poc/data/views.sqlite, archive poc/data/archive.sqlite,
     8	config poc/config/poc-v1.json, universe poc/universe.json. The log goes to stdout and poc/data/replay.log.
     9	"""
    10	import argparse
    11	import os
    12	import sys
    13	
    14	ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
    15	sys.path.insert(0, os.path.join(ROOT, 'src'))
    16	
    17	from hivemind import config, model, replay, universe  # noqa: E402
    18	
    19	
    20	def main():
    21	    parser = argparse.ArgumentParser()
    22	    parser.add_argument('--from', dest='from_day', required=True)
    23	    parser.add_argument('--until', dest='until_day', required=True)
    24	    parser.add_argument('--day0', default=None)
    25	    parser.add_argument('--testdb', default=os.path.join(ROOT, 'poc', 'corpus', 'items.sqlite'))
    26	    parser.add_argument('--views', default=os.path.join(ROOT, 'poc', 'data', 'views.sqlite'))
    27	    parser.add_argument('--archive', default=os.path.join(ROOT, 'poc', 'data', 'archive.sqlite'))
    28	    parser.add_argument('--config', default=os.path.join(ROOT, 'poc', 'config', 'poc-v1.json'))
    29	    parser.add_argument('--universe', default=os.path.join(ROOT, 'poc', 'universe.json'))
    30	    parser.add_argument('--only', default=None, help='comma-separated object ids to restrict the stream to')
    31	    parser.add_argument('--cap', type=float, default=None, help='USD spend cap for this run')
    32	    parser.add_argument('--max-items-per-day', type=int, default=None)
    33	    args = parser.parse_args()
    34	    os.makedirs(os.path.dirname(args.views), exist_ok=True)
    35	    log_path = os.path.join(os.path.dirname(args.views), 'replay.log')
    36	
    37	    def log(*parts):
    38	        line = ' '.join(str(p) for p in parts)
    39	        print(line, flush=True)
    40	        with open(log_path, 'a', encoding='utf-8') as handle:
    41	            handle.write(line + '\n')
    42	
    43	    cfg = config.load(args.config)
    44	    uni = universe.load(args.universe)
    45	    archive = model.Archive(args.archive)
    46	    log(f'--- replay {args.from_day}..{args.until_day} config {cfg.version}/{cfg.checksum} provider {cfg.provider} universe {uni.version}')
    47	    totals = replay.run(testdb_path=args.testdb, views_path=args.views, archive=archive, cfg=cfg, universe=uni,
    48	                        from_day=args.from_day, until_day=args.until_day, day0=args.day0, spend_cap_usd=args.cap, log=log,
    49	                        only_objects=set(args.only.split(',')) if args.only else None, max_items_per_day=args.max_items_per_day)
    50	    log('totals:', totals)
    51	
    52	
    53	if __name__ == '__main__':
    54	    main()
