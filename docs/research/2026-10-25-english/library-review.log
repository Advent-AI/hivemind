    29	HERE = os.path.dirname(__file__)
    30	TABLES = read_json(os.path.join(HERE, 'author-table.json'))
    31	AGGREGATORS = set(TABLES['aggregators'])
    32	AUTHOR_TYPES = TABLES['authors']           # domain -> company | media | analyst | official | individual
    33	TOPICS = {t['id']: t for t in read_json(os.path.join(HERE, 'topics.json'))['topics']}
    34	COMPANIES = {c['ticker']: c for c in read_json(os.path.join(HERE, 'companies.json'))['companies']}
    35	TICKER = [{'kind': 'ticker', 'value': 'NVDA', 'why': 'upstream feed for this object'}]
    36	TRACKING_KEYS = {'ref', 'ref_src', 'guccounter', 'guce_referrer', 'guce_referrer_sig', 'yptr', 'ncid', 'cmpid',
    37	                 'soc_src', 'soc_trk', 'fbclid', 'gclid', 'mc_cid', 'mc_eid'}
    38	
    39	SCHEMA = """
    40	-- text        : the original page or document as text, nothing cut (what the pipeline reads)
    41	-- text_article: a heuristic cut of the article body, for the review's estimates only, never fed
    42	-- coverage    : full (the original, whole) | stub | blocked | truncated | title (only the headline) |
    43	--               provider_summary (a third party's summary, not fed) | none
    44	-- feed        : 1 when the item is an original document the pipeline may read; 0 otherwise
    45	-- day_source  : where publication_day came from: page | listing | filing | call | release
    46	create table items (
    47	  input_id text primary key, klass text, category text, content_sha256 text, copy_of text, supersedes text,
    48	  channel text, source_uri text, publisher text, publisher_type text, authors text, published_at text,
    49	  publication_day text, day_source text, listing_day text, page_day text, retrieved_at text, is_structured integer,
    50	  has_readable_text integer, document_format text, channel_category text, media_type text, language text,
    51	  object_identifiers text, title text, text text, text_article text, coverage text, text_chars integer,
    52	  bootstrap integer, feed integer, source text, topic text, tier text, extra text
    53	);
    54	create index items_day on items(publication_day);
    55	create index items_klass on items(klass, publication_day);
    56	create index items_feed on items(feed, publication_day);
    57	"""
    58	
