    60	# ---------- small helpers ----------
   120	def page_author(domain, title, text):
   121	    """(publisher, publisher type, identified) for a fetched news page: the page's own domain, except on an aggregator,
   122	    where the byline's outlet is the author and the aggregator only the channel; an aggregator page without a named
   123	    outlet keeps the channel default (media) and is marked unidentified (02-classification 作者规则 4)."""
   124	    if domain in AGGREGATORS:
   125	        outlet = byline_outlet(title, text)
   126	        if outlet:
   127	            return outlet, author_type(outlet), True
   128	        return domain, 'media', False
   129	    return domain, author_type(domain), True
   130	
   131	
   132	def normalise_title(title):
   133	    title = (title or '').lower()
   134	    title = re.sub(r'\s*[-|–—:]\s*(the motley fool|yahoo finance|reuters|cnbc|bloomberg|benzinga|aol|msn|seeking alpha|nasdaq)\s*$', '', title)
   135	    title = re.sub(r'[^a-z0-9 ]+', ' ', title)
   136	    return re.sub(r'\s+', ' ', title).strip()
   137	
   138	
   139	def canonical_url(url):
   140	    parts = urllib.parse.urlsplit((url or '').strip())
   141	    query = [(k, v) for k, v in urllib.parse.parse_qsl(parts.query, keep_blank_values=True)
   142	             if not k.lower().startswith('utm_') and k.lower() not in TRACKING_KEYS]
   143	    return urllib.parse.urlunsplit((parts.scheme or 'https', domain_of(url), parts.path.rstrip('/'), urllib.parse.urlencode(query), ''))
   144	
