   151	def full_text_of(path_without_suffix):
   152	    """Only the whole-page text counts; the older .txt (a heuristic cut) is never used as the item."""
   153	    path = path_without_suffix + '.full.txt'
   154	    return read_text(path) if os.path.exists(path) else ''
   155	
