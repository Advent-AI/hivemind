    55	def part_a(archive_conn):
    56	    reasons, examples, judged = collections.Counter(), collections.defaultdict(list), 0
    57	    rows = archive_conn.execute("select purpose, request_sha256, answer_json from model_calls where request_sha256 like '%:schema:%' or request_sha256 like '%:malformed:%'")
    58	    for purpose, sha, answer_json in (tuple(r) for r in rows):
    59	        judged += 1
    60	        if ':malformed:' in sha or not answer_json:
    61	            reasons[f'{purpose}: not JSON'] += 1
    62	            continue
    63	        for error in model.check_schema(json.loads(answer_json), SCHEMAS.get(purpose, {})):
    64	            key = f'{purpose}: {normalise_reason(error)}'
    65	            reasons[key] += 1
    66	            examples[key].append(error[:140])
    67	    tally('A. answers the schema refused (prompt/schema disagreements; empty when the provider enforces the schema server-side)', judged, judged, reasons, examples)
    68	    return judged
