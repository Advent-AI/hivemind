    71	def part_b(archive_conn, items_conn, uni):
    72	    reasons, examples = collections.Counter(), collections.defaultdict(list)
    73	    judged = produced_e = kept_e = produced_c = kept_c = 0
    74	    items_by_id = {}
    75	    for purpose, request_json, answer_json in (tuple(r) for r in archive_conn.execute("select purpose, request_json, answer_json from model_calls where purpose='extract' and request_sha256 not like '%:%'")):
    76	        request = json.loads(request_json)
    77	        user = request['messages'][1]['content']
    78	        found = ITEM_ID.search(user)
    79	        if not found:
    80	            raise ValueError('unidentifiable stored extraction request')
    81	        input_id = found.group(1)
    82	        if input_id not in items_by_id:
    83	            row = items_conn.execute('select * from items where input_id=?', (input_id,)).fetchone()
    84	            items_by_id[input_id] = dict(row) if row else None
    85	        item = items_by_id[input_id]
    86	        if not item:
    87	            raise ValueError(f'missing source item: {input_id}')
    88	        data = json.loads(answer_json)
    89	        shown_ids = set(BLOCK5_VIEW.findall(user))
    90	        evidence, candidates, dropped = extraction.sift(data, item, item['text'] or '', shown_ids, uni)
    91	        judged += 1
    92	        produced_e += len(data.get('evidence', [])); kept_e += len(evidence)
    93	        produced_c += len(data.get('candidates', [])); kept_c += len(candidates)
    94	        for ident, why in dropped:
    95	            key = normalise_reason(why)
    96	            reasons[key] += 1
    97	            examples[key].append(f'{input_id[:48]} {ident}: {why[:80]}')
    98	    print(f'\n   extraction answers {judged}: evidence produced {produced_e} kept {kept_e}; candidates produced {produced_c} kept {kept_c}')
    99	    tally('B. extraction code checks over stored answers', produced_e + produced_c, (produced_e - kept_e) + (produced_c - kept_c), reasons, examples)
   100	    return judged
