    46	def tally(title, judged, refused, reasons, examples):
    47	    share = f'{refused / judged:.0%}' if judged else 'n/a'
    48	    print(f'\n== {title}: judged {judged}, refused/dropped {refused} ({share})')
    49	    for reason, count in reasons.most_common(20):
    50	        print(f'   {count:5d}  {reason}')
    51	        for example in examples.get(reason, [])[:2]:
    52	            print(f'          e.g. {example}')
