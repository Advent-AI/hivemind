    63	def insert(conn, table, **fields):
    64	    columns = list(fields)
    65	    cursor = conn.execute(f'insert into {table} ({",".join(columns)}) values ({",".join("?" * len(columns))})', [fields[c] for c in columns])
    66	    return cursor.lastrowid
