   103	def part_c(archive_conn, views_paths, uni):
   104	    reasons, examples = collections.Counter(), collections.defaultdict(list)
   105	    judged = refused_records = 0
   106	    for path in views_paths:
   107	        # matching.check writes suggested themes to the review pool, so it runs on a scratch copy, never on the real file
   108	        scratch = os.path.join(tempfile.mkdtemp(), 'views.sqlite')
   109	        shutil.copy(path, scratch)
   110	        conn = sqlite3.connect(scratch)
   111	        conn.row_factory = sqlite3.Row
   112	        for rec in conn.execute('select input_id, call_no, shown_json, decisions_json, request_sha256 from match_records order by id'):
   113	            handover_row = conn.execute('select handover_json from handovers where input_id=? order by id desc limit 1', (rec['input_id'],)).fetchone()
   114	            request_row = archive_conn.execute('select request_json from model_calls where request_sha256=?', (rec['request_sha256'],)).fetchone()
   115	            if not handover_row or not request_row or not rec['decisions_json']:
   116	                continue
   117	            handover = json.loads(handover_row['handover_json'])
   118	            shown = json.loads(rec['shown_json'])
   119	            lists = matching.Lists(shown.get('candidates', {}), {tuple(k.split('|', 1)): v for k, v in shown.get('evidence', {}).items()})
   120	            user = json.loads(request_row['request_json'])['messages'][1]['content']
   121	            shown_views = [{'view_id': v} for v in dict.fromkeys(MATCH_SHOWN.findall(user))]
   122	            if rec['call_no'] <= 2:
   123	                candidates, evidence = handover['candidates'], handover['evidence']
   124	            else:                                   # the second call: candidate-linked evidence under its destination
   125	                wanted = {k[0] for k in lists.evidence_lists}
   126	                candidates, evidence = [], [dict(e, links=[k[1] for k in lists.evidence_lists if k[0] == e['id']]) for e in handover['evidence'] if e['id'] in wanted]
   127	            try:
   128	                checked = matching.check(conn, uni, json.loads(rec['decisions_json']), candidates, evidence, lists, shown_views)
   129	            except Exception as error:
   130	                key = 'check raised ' + type(error).__name__
   131	                reasons[key] += 1; examples[key].append(f'{os.path.basename(os.path.dirname(path))} {rec["input_id"][:40]}: {error!r}'[:140])
   132	                judged += 1; refused_records += 1
   133	                continue
   134	            judged += 1
   135	            if checked.refusals:
   136	                refused_records += 1
   137	            for refusal in checked.refusals:
   138	                key = normalise_reason(refusal)
   139	                reasons[key] += 1
   140	                examples[key].append(f'{os.path.basename(os.path.dirname(path))} {rec["input_id"][:40]}: {refusal[:90]}')
   141	    tally('C. matching code checks over stored records (database state is the final one, not the state at the time)', judged, refused_records, reasons, examples)
   142	    return judged
