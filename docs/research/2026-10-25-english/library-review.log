     1	"""Translate the mock's data (poc/mock/data.json, written by the pipeline in Chinese) into English for the
     2	front-end mock, with gpt-6-luna through the same archived model call as the pipeline (a repeated run costs $0).
     3	
     4	Enumerations are mapped, not translated (tiers, view kinds, object ladder labels, judgement pushes). Everything
     5	else that the page shows is translated in batches: view questions and what they look at, ladder conditions,
     6	evidence one-liners and event times, each judgement's reasons and why-changed. Quotes, speakers, titles and dates
     7	stay as stored (quotes are the source's own words, almost all English). The Chinese ladder conditions are kept
     8	as `condition_zh` because the page reads the rung thresholds from them.
     9	
    10	Usage: python3 scripts/mock_translate.py [--dry] [--limit N]   → poc/mock/data.en.json
    11	"""
    12	import argparse
    13	import collections
    14	import glob
    15	import json
    16	import os
    17	import re
    18	import sys
    19	
    20	ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
    21	sys.path.insert(0, os.path.join(ROOT, 'src'))
    22	from hivemind import config, model  # noqa: E402
    23	
    24	TIERS = {'发生的事': 'Fact', '当事人说的': 'Party statement', '第三方看法': 'Third-party view', '传闻': 'Rumour'}
    25	KINDS = {'对象观点': 'Company view', '主题观点': 'Theme view'}
    26	OBJECT_LABELS = {'强烈看多': 'Strongly bullish', '看多': 'Bullish', '中性': 'Neutral', '看空': 'Bearish', '强烈看空': 'Strongly bearish', '是': 'Yes', '否': 'No'}
    27	PUSHES = {'推向第一格': 'pushes toward rung 1', '推向最后一格': 'pushes toward rung 5', '不推': 'no push', '定格': 'settles the rung'}
    28	SCHEMA = {'type': 'object', 'additionalProperties': False, 'required': ['items'],
    29	          'properties': {'items': {'type': 'array', 'items': {'type': 'object', 'additionalProperties': False, 'required': ['k', 'en'],
    30	                                                             'properties': {'k': {'type': 'string'}, 'en': {'type': 'string'}}}}}}
    31	SYSTEM = ('You translate short Chinese texts from an equity-research system into concise, natural financial English. '
    32	          'Keep every number, unit, ticker, company and product name, fiscal label (FY2027, Q1, H2) and date exactly as given. '
    33	          'Write 第 N 格 as "rung N" and 梯子 as "ladder"; 观点 is "view", 证据 is "evidence", 发生的事 is "a fact", 当事人说的 is "a party statement", '
    34	          '第三方看法 is "a third-party view", 传闻 is "a rumour". Translate questions as questions. Return one English text per key, every key, nothing else.')
    35	BATCH_CHARS = 5000
    36	
    37	
    38	def collect(data):
    39	    """Every distinct string the page shows, keyed by a stable id -> the original text."""
    40	    todo = collections.OrderedDict()
    41	
    42	    def add(key, text):
    43	        if text and text.strip():
    44	            todo[key] = text
    45	    for v in data['views']:
    46	        add(f'v:{v["view_id"]}:q', v['question'])
    47	        add(f'v:{v["view_id"]}:l', v['looks_at'])
    48	        for r in v['rungs']:
    49	            add(f'v:{v["view_id"]}:c{r["position"]}', r['condition'])
    50	            if r['label'] not in OBJECT_LABELS:
    51	                add(f'v:{v["view_id"]}:r{r["position"]}', r['label'])
    52	        for n, j in enumerate(v['judgements']):
    53	            add(f'j:{v["view_id"]}:{n}:why', j['why_changed'])
    54	            add(f'j:{v["view_id"]}:{n}:reasons', j['reasons'])
    55	        for e in v['evidence']:
    56	            add(f'e:{e["id"]}:line', e['one_line'])
    57	            add(f'e:{e["id"]}:time', e['event_time'])
    58	    return todo
    59	
    60	
    61	def batches(todo, done):
    62	    batch, size = [], 0
    63	    for key, text in todo.items():
    64	        if key in done:
    65	            continue
    66	        if batch and size + len(text) > BATCH_CHARS:
    67	            yield batch
    68	            batch, size = [], 0
    69	        batch.append((key, text))
    70	        size += len(text)
    71	    if batch:
    72	        yield batch
    73	
    74	
    75	CJK = re.compile(r'[一-鿿]')
    76	MONTHS = ['', 'Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec']
    77	
    78	
    79	def polish(text):
    80	    """Money and dates the model copied in Chinese units ("300亿美元", "2026年8月26日") written the English way; a
    81	    literal "3500 hundred million" becomes "$350 billion"."""
    82	    def yi_to_dollars(match):
    83	        n = float(match.group(1).replace(',', ''))
    84	        return f'${n / 10:g} billion'
    85	    text = re.sub(r'(\d[\d,.]*)\s*万亿美元', lambda m: f'${float(m.group(1).replace(",", "")):g} trillion', text)
    86	    text = re.sub(r'(\d[\d,.]*)\s*亿美元', yi_to_dollars, text)
    87	    text = re.sub(r'\$?(\d[\d,.]*)\s*hundred million(?: U\.S\. dollars| dollars)?', yi_to_dollars, text)
    88	    text = re.sub(r'(\d[\d,.]*)\s*万亿', lambda m: f'{float(m.group(1).replace(",", "")):g} trillion', text)
    89	    text = re.sub(r'(\d[\d,.]*)\s*亿', lambda m: f'{float(m.group(1).replace(",", "")) / 10:g} billion', text)
    90	    text = re.sub(r'(\d[\d,.]*)\s*美元', r'$\1', text)
    91	    text = re.sub(r'(\d{4})\s*年\s*(\d{1,2})\s*月\s*(\d{1,2})\s*日', lambda m: f'{MONTHS[int(m.group(2))]} {int(m.group(3))}, {m.group(1)}', text)
    92	    text = re.sub(r'(\d{4})\s*年\s*(\d{1,2})\s*月', lambda m: f'{MONTHS[int(m.group(2))]} {m.group(1)}', text)
    93	    text = re.sub(r'(\d{1,2})\s*月\s*(\d{1,2})\s*日', lambda m: f'{MONTHS[int(m.group(1))]} {int(m.group(2))}', text)
    94	    text = re.sub(r'(\d{4})\s*年', r'\1', text)
    95	    text = re.sub(r'第\s*([一二三四1-4])\s*季度?', lambda m: 'Q' + str('一二三四'.find(m.group(1)) + 1 if m.group(1) in '一二三四' else m.group(1)), text)
    96	    text = re.sub(r'(\d[\d,.]*)\s*%\s*', r'\1% ', text)
    97	    return re.sub(r'\s{2,}', ' ', text).strip()
