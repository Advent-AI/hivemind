    32	SCHEMAS = {'extract': extraction.SCHEMA, 'match': matching.SCHEMA, 'judge': judging.SCHEMA}
    33	ITEM_ID = re.compile(r'【信息】编号 (\S+?)，类别 ')
    34	BLOCK5_VIEW = re.compile(r'^\s+- (v\d+)（', re.M)
    35	MATCH_SHOWN = re.compile(r'^· (v\d+)（', re.M)
