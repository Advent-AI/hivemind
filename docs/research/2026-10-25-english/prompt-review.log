   148	def round_of_judgements(archive, cfg, conn, changed_views, seq, item, *, transport=None):
   149	    """Judge the open views in changed_views, dependencies first; a changed conclusion queues open dependants.
   150	
   151	    Views that do not depend on each other are judged at the same time: each level of the dependency order is sent
   152	    to the model concurrently (the prompts are built and the answers checked and written in this thread, so the
   153	    database connection never crosses threads). A view waits while anything upstream of it is still pending, so a
   154	    dependant always reads this round's conclusion of its dependency. A view with no evidence in force stays
   155	    还没判 (D59), and a view already judged at this sequence number (a resumed round) is not judged twice."""
   156	    import concurrent.futures
   157	
   158	    def eligible(view_id):
   159	        return store.is_open(conn, view_id) and not store.has_judgement(conn, view_id, seq) and bool(store.evidence_in_force(conn, view_id))
   160	
   161	    pending = [v for v in topological(conn, changed_views) if eligible(v)]
   162	    done, results = set(), []
   163	    while pending:
   164	        level = [v for v in pending if upstream(conn, v).isdisjoint(set(pending) - {v})] or pending[:1]
   165	        prompts = {v: build_prompt(conn, v, cfg.rejudging.prompt_version) for v in level}
   166	
   167	        def ask(view_id, note=''):
   168	            system, user = prompts[view_id]
   169	            return model.call(archive, cfg, cfg.rejudging, system, user + note, SCHEMA, 'judgement', 'judge', transport=transport)
   170	
   171	        with concurrent.futures.ThreadPoolExecutor(max_workers=JUDGE_WORKERS) as pool_:
   172	            answers = dict(zip(level, pool_.map(ask, level)))
   173	        for view_id in level:
   174	            answer = answers[view_id]
   175	            errors = check_answer(conn, view_id, answer.data)
   176	            if errors:
   177	                note = '\n\n上一次的答案被代码退回，原因：' + '；'.join(errors) + '\n请改正后再交（只能引用列出的编号）。'
   178	                answer = ask(view_id, note)
   179	                errors = check_answer(conn, view_id, answer.data)
   180	                if errors:
   181	                    raise JudgementRefused(f'{view_id}: ' + '; '.join(errors))
   182	            result = _record(conn, cfg, view_id, seq, item, answer)
   183	            done.add(view_id)
   184	            results.append(result)
   185	            if result['changed']:
   186	                for dependant in store.dependants_of(conn, view_id):
   187	                    if dependant not in done and dependant not in pending and eligible(dependant):
   188	                        pending.append(dependant)
   189	        pending = [v for v in topological(conn, pending) if v not in done and eligible(v)]
   190	    return results

