   178	def decide(archive, cfg, conn, item, candidates, evidence, lists, shown_views, *, extra_views=(), retry_note='', transport=None):
   179	    with open(config.prompt_path(cfg.matching.prompt_version + '.txt'), encoding='utf-8') as handle:
   180	        system = handle.read()
   181	    user = _user_text(conn, item, candidates, evidence, lists, shown_views, extra_views)
   182	    if retry_note:
   183	        user += '\n\n上一次的答案被代码退回，原因：' + retry_note + '\n请改正后再交。'
   184	    answer = model.call(archive, cfg, cfg.matching, system, user, SCHEMA, 'matching', 'match', transport=transport)
   185	    return answer
