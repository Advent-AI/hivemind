    32	def topological(conn, view_ids):
    33	    """Dependencies first: a view comes after every view it depends on that is also in the set."""
    34	    remaining = list(dict.fromkeys(view_ids))
    35	    ordered, placed = [], set()
    36	    while remaining:
    37	        progressed = False
    38	        for view_id in list(remaining):
    39	            deps = {d['resolved_to'] for d in store.dependencies_of(conn, view_id) if d['resolved_to']}
    40	            if deps.isdisjoint(set(remaining) - {view_id}) or deps <= placed:
    41	                ordered.append(view_id)
    42	                placed.add(view_id)
    43	                remaining.remove(view_id)
    44	                progressed = True
    45	        if not progressed:                 # a cycle slipped through: keep going in the given order
    46	            ordered.extend(remaining)
    47	            break
    48	    return ordered
