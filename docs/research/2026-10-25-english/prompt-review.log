   150	def _user_text(conn, item, candidates, evidence, lists, shown_views, extra_views=()):
   151	    parts = [f'信息：{item["input_id"]}，发布日 {item["publication_day"]}，类别 {item["category"]}。']
   152	    if candidates:
   153	        parts.append('【候选观点】')
   154	        for c in candidates:
   155	            rungs = ' / '.join(f'{r["label"]}：{r["condition"]}' for r in c['rungs'])
   156	            listed = lists.candidate_lists.get(c['id'], [])
   157	            parts.append(f'- {c["id"]}（{c["kind"]}，对象 {c["object"]}，看的是「{c["looks_at"]}」，{c["year"]}，到期 {c["due_day"]}）：{c["question"]}\n    梯子：{rungs}\n    它的证据：' +
   158	                         '；'.join(e['one_line'] for e in evidence if e['id'] in c['evidence_ids'])[:1500])
   159	            if listed:
   160	                parts.append('    搜出来的已有观点：\n' + '\n'.join('    · ' + describe_view(conn, v) for v in listed))
   161	            else:
   162	                parts.append('    搜出来的已有观点：没有。')
   163	    if shown_views:
   164	        parts.append('【抽取时给模型看过的已有观点】\n' + '\n'.join('· ' + describe_view(conn, v['view_id']) for v in shown_views))
   165	    for v in extra_views:
   166	        parts.append('· ' + describe_view(conn, v))
   167	    direct = [(e, vid) for e in evidence for vid in e['links'] if (e['id'], vid) in lists.evidence_lists]
   168	    if direct:
   169	        parts.append('【连在已有观点上的证据，和那条观点下已有的证据比】')
   170	        for e, vid in direct:
   171	            parts.append(f'- {e["id"]} → {vid}［{e["tier"]}；{e["speaker"]}；{e["original_who"]} {e["original_day"]}］{e["one_line"]}｜原句：{e["quote"][:300]}')
   172	            listed = lists.evidence_lists[(e['id'], vid)]
   173	            parts.append('    那条观点下已有的：\n' + ('\n'.join('    · ' + describe_evidence(conn, x) for x in listed) if listed else '    · 还没有证据'))
   174	    parts.append('按 JSON schema 交出每个候选观点的去向和依赖、每条证据的去向。没有的数组交空。target 没有就写空字符串。')
   175	    return '\n'.join(parts)
