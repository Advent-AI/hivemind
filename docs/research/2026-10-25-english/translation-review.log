              <thead><tr><th>ID</th><th>Category</th><th>Form</th><th>Family</th><th>Decision rule</th><th>Definition</th><th>Example</th></tr></thead>
              <tbody>${schemaRows}</tbody>
            </table>
          </section>
        </div>`;

