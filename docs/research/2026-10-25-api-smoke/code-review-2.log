   134	def single_attempt_http():
   135	    """Explicit live opt-in. Credentials are loaded once; tests supply a fake sender."""
   136	    keys = {'openai': model._key('openai'), 'jev': jev._key()}
   137	    urls = {'openai': model.ENDPOINTS['openai'][0], 'jev': jev.ENDPOINT}
   138	    if any(not isinstance(k, str) or not k for k in keys.values()):
   139	        raise BudgetError('configured provider credential missing')
   140	
   141	    def prepare(provider, body):
   142	        headers = {'Authorization': 'Bearer ' + keys[provider], 'Content-Type': 'application/json', 'Accept': 'application/json'}
   143	        data = json.dumps(body, sort_keys=True, ensure_ascii=False).encode('utf-8')
   144	        request = urllib.request.Request(urls[provider], data, headers)
   145	        def send():
   146	            try:
   147	                with urllib.request.urlopen(request, timeout=60) as reply:
   148	                    raw = reply.read()
   149	            except urllib.error.HTTPError as exc:
   150	                raise model.TransportError(f'{provider} HTTP {exc.code}; no automatic retry') from None
   151	            if any(k.encode('utf-8') in raw for k in keys.values()):
   152	                raise model.TransportError('credential in response; response not saved')
   153	            return json.loads(raw)
   154	        return send
   155	    return prepare

