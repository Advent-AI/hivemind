    49	class GuardedTransport:
    50	    """One coordinator's journal; unresolved work survives crashes and closes admission."""
    51	
    52	    def __init__(self, path, prepare, *, cap_microdollars=1500000, max_calls=36):
    53	        path = Path(path)
    54	        if not path.is_absolute() or type(cap_microdollars) is not int or cap_microdollars <= 0 or type(max_calls) is not int or max_calls <= 0:
    55	            raise ValueError('absolute journal path and positive integer limits required')
    56	        self.lock, self.prepare = threading.Lock(), prepare
    57	        self.conn = sqlite3.connect(path, check_same_thread=False)
    58	        self.conn.executescript('''
    59	            create table if not exists settings (id integer primary key check(id=1), cap integer, max_calls integer, halted text);
    60	            create table if not exists attempts (
    61	              id integer primary key, provider text, request_sha256 text, request_json text,
    62	              reserved integer, charged integer, state text, response_json text, error text,
    63	              seconds real, completed_order integer);
    64	        ''')
    65	        row = self.conn.execute('select cap,max_calls,halted from settings').fetchone()
    66	        if row is None:
    67	            self.conn.execute('insert into settings values (1,?,?,NULL)', (cap_microdollars, max_calls))
    68	        elif row[:2] != (cap_microdollars, max_calls):
    69	            raise BudgetError('journal limits changed')
    70	        if self.conn.execute("select 1 from attempts where state!='complete' limit 1").fetchone():
    71	            self.conn.execute("update settings set halted='unresolved prior attempt' where id=1")
    72	        self.conn.commit()
    73	
    74	    def stop(self, reason):
    75	        with self.lock:
    76	            self.conn.execute('update settings set halted=coalesce(halted,?) where id=1', (reason,))
    77	            self.conn.commit()
    78	
    79	    def summary(self):
    80	        with self.lock:
    81	            self.conn.row_factory = sqlite3.Row
    82	            attempts = [dict(r) for r in self.conn.execute('select id,provider,request_sha256,reserved,charged,state,error,seconds,completed_order from attempts order by id')]
    83	            halted = self.conn.execute('select halted from settings').fetchone()[0]
    84	            self.conn.row_factory = None
    85	        return {'attempts': attempts, 'halted': halted,
    86	                'held_microdollars': sum(r['charged'] if r['charged'] is not None else r['reserved'] for r in attempts)}
    87	
    88	    def __call__(self, *args):
    89	        provider, request = args if len(args) == 2 else ('jev', args[0])
    90	        reserved, max_input, max_output = envelope(provider, request)
    91	        text, sha = model.request_identity(request)
    92	        with self.lock:
    93	            cap, max_calls, halted = self.conn.execute('select cap,max_calls,halted from settings').fetchone()
    94	            count, held = self.conn.execute('select count(*),coalesce(sum(coalesce(charged,reserved)),0) from attempts').fetchone()
    95	            if halted or count >= max_calls or held + reserved > cap:
    96	                raise BudgetError('admission closed or study limit reached')
    97	            cur = self.conn.execute("insert into attempts(provider,request_sha256,request_json,reserved,state) values (?,?,?,?,'reserved')", (provider, sha, text, reserved))
    98	            ident = cur.lastrowid
    99	            self.conn.commit()
   100	        start = time.perf_counter()
   101	        encoded = None
   102	        dispatched = False
   103	        try:
   104	            # Preparation is local only. Cancellation and dispatch then share one
   105	            # decision point; work committed here is in flight, even before socket I/O.
   106	            send = self.prepare(provider, request)
   107	            with self.lock:
   108	                if self.conn.execute('select halted from settings').fetchone()[0]:
   109	                    raise BudgetError('cancelled before dispatch')
   110	                self.conn.execute("update attempts set state='dispatched' where id=?", (ident,))
   111	                self.conn.commit()
   112	                dispatched = True
   113	            response = send()
   114	            encoded = json.dumps(response, ensure_ascii=False)
   115	            cost = charge(provider, response, max_input, max_output)
   116	            if cost > reserved:
   117	                raise BudgetError('usage exceeds reserved cost')
   118	        except BaseException as exc:
   119	            # No raw exception text: HTTP/SDK exceptions can contain credentials or headers.
   120	            with self.lock:
   121	                self.conn.execute('update attempts set state=?,charged=?,response_json=?,error=?,seconds=? where id=?',
   122	                                  ('unknown' if dispatched else 'not_sent', None if dispatched else 0,
   123	                                   encoded, type(exc).__name__, time.perf_counter()-start, ident))
   124	                self.conn.execute("update settings set halted=coalesce(halted,'unknown usage') where id=1")
   125	                self.conn.commit()
   126	            raise
   127	        with self.lock:
   128	            order = self.conn.execute('select coalesce(max(completed_order),0)+1 from attempts').fetchone()[0]
   129	            self.conn.execute("update attempts set state='complete',charged=?,response_json=?,seconds=?,completed_order=? where id=?", (cost, encoded, time.perf_counter()-start, order, ident))
   130	            self.conn.commit()
   131	        return response
