    75	def call_job(job, archive, cfg, transport):
    76	    """A refusal closes admission in its own worker, before any ordered wait."""
    77	    try:
    78	        return _call_job(job, archive, cfg, transport)
    79	    except BaseException:
    80	        transport.stop('request validation failed or cancelled')
    81	        raise
    82	
    83	
    84	def _call_job(job, archive, cfg, transport):
    85	    if job['purpose'] == 'extract':
    86	        answer = model.call(archive, cfg, job['setting'], job['system'], job['user'], job['schema'], 'extraction', 'extract', transport=transport)
    87	    else:
    88	        req = job['request']
    89	        answer = jev.ask(archive, cfg, cfg.matching, req['state'], req['questions'], 'match', transport=transport)
    90	    if answer.cached or answer.request_sha256 != job['request_sha256']:
    91	        raise ValueError('smoke response is cached or has a different request identity')
    92	    return {'original_call_id': job['original_call_id'], 'request_sha256': answer.request_sha256,
    93	            'data': answer.data, 'input_tokens': answer.input_tokens, 'output_tokens': answer.output_tokens,
    94	            'standard_list_cost_usd': answer.cost_usd}
