    97	def run(directory, *, live=False):
    98	    directory = Path(directory).resolve()
    99	    protected = json.loads((directory / 'protected-before.json').read_text())
   100	    changed = [p for p, expected in protected.items() if not Path(p).is_file() or fingerprint(p) != expected]
   101	    if changed:
   102	        raise ValueError('protected database changed before smoke: ' + ', '.join(changed))
   103	    cfg, jobs = jobs_for(directory)
   104	    manifest = {'calls': [{k: j[k] for k in ('original_call_id', 'purpose', 'request_sha256')} for j in jobs],
   105	                'max_calls': 36, 'cap_usd': 1.5, 'workers': 2, 'samples': 3, 'mode': 'ordinary API concurrency',
   106	                'inputs': {p.name: fingerprint(p) for p in (directory / 'inputs').glob('*.sqlite')},
   107	                'config_sha256': fingerprint(ROOT / 'poc/config/poc-v23.json')}
   108	    manifest_path = directory / 'manifest.json'
   109	    if manifest_path.exists() and json.loads(manifest_path.read_text()) != manifest:
   110	        raise ValueError('smoke manifest changed')
   111	    if not manifest_path.exists():
   112	        with manifest_path.open('x') as handle:
   113	            json.dump(manifest, handle, indent=2)
   114	    if not live:
   115	        print(json.dumps({'prepared': True, **manifest}, indent=2))
   116	        return
   117	    if (directory / 'budget.sqlite').exists():
   118	        raise ValueError('live smoke already attempted; do not silently restart or retry')
   119	    transport = GuardedTransport(directory / 'budget.sqlite', single_attempt_http())
   120	    results, failure = [], None
   121	    try:
   122	        for sample in range(3):
   123	            # Rotate the schedule; the concurrent arm is not always last.
   124	            order = ('control-a', 'control-b', 'concurrent')
   125	            order = order[sample:] + order[:sample]
   126	            for arm in order:
   127	                folder = directory / f'sample-{sample + 1}-{arm}'
   128	                folder.mkdir()
   129	                archive = model.Archive(folder / 'archive.sqlite')
   130	                try:
   131	                    for purpose in ('extract', 'match'):
   132	                        selected = [j for j in jobs if j['purpose'] == purpose]
   133	                        start = time.perf_counter()
   134	                        if arm == 'concurrent':
   135	                            pool = ThreadPoolExecutor(max_workers=2)
   136	                            futures = []
   137	                            try:
   138	                                futures = [pool.submit(call_job, j, archive, cfg, transport) for j in selected]
   139	                                replies = [f.result() for f in futures]
   140	                            except BaseException:
   141	                                transport.stop('study failed or cancelled')
   142	                                for future in futures:
   143	                                    future.cancel()
   144	                                raise
   145	                            finally:
   146	                                pool.shutdown(wait=True, cancel_futures=True)
   147	                        else:
   148	                            replies = [call_job(j, archive, cfg, transport) for j in selected]
   149	                        result = {'sample': sample + 1, 'arm': arm, 'purpose': purpose,
   150	                                  'seconds': round(time.perf_counter() - start, 3), 'answers': replies}
   151	                        results.append(result)
   152	                        (directory / 'progress.json').write_text(json.dumps(results, indent=2, ensure_ascii=False))
   153	                        print(json.dumps({k: result[k] for k in ('sample', 'arm', 'purpose', 'seconds')}), flush=True)
   154	                finally:
   155	                    archive.conn.close()
   156	    except BaseException as exc:
   157	        transport.stop('study failed or cancelled')
   158	        failure = type(exc).__name__
   159	        raise
   160	    finally:
   161	        changed = [p for p, expected in protected.items() if not Path(p).is_file() or fingerprint(p) != expected]
   162	        report = {'failure': failure, 'protected_files': len(protected), 'changed_protected_files': changed,
   163	                  'results': results, 'accounting': transport.summary()}
   164	        (directory / 'result.json').write_text(json.dumps(report, indent=2, ensure_ascii=False))
   165	        print(json.dumps({'failure': failure, 'changed_protected_files': changed,
   166	                          'attempts': len(report['accounting']['attempts']),
   167	                          'conservative_cost_usd': report['accounting']['held_microdollars'] / 1e6}), flush=True)
   168	        if changed and failure is None:
   169	            raise ValueError('protected database changed during smoke')
   170	
