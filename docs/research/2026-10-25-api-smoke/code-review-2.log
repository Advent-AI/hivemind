   172	if __name__ == '__main__':
   173	    parser = argparse.ArgumentParser(description=__doc__)
   174	    parser.add_argument('--directory', type=Path, required=True)
   175	    parser.add_argument('--live', action='store_true')
   176	    args = parser.parse_args()
   177	    run(args.directory, live=args.live)
