    37	def jobs_for(directory):
    38	    """Rebuild all four full requests with current builders before using credentials."""
    39	    cfg = config.load(ROOT / 'poc/config/poc-v23.json')
    40	    uni = universe.load(ROOT / 'poc/universe.json')
    41	    jobs = []
    42	    with readonly(directory / 'inputs/archive.sqlite') as archive, readonly(directory / 'inputs/items.sqlite') as items, readonly(directory / 'inputs/views.sqlite') as views:
    43	        for conn in (archive, items, views):
    44	            conn.row_factory = sqlite3.Row
    45	        for ident in CALLS:
    46	            row = dict(archive.execute('select * from model_calls where call_id=?', (ident,)).fetchone())
    47	            req = json.loads(row['request_json'])
    48	            job = {'original_call_id': ident, 'purpose': row['purpose'], 'request': req}
    49	            if row['purpose'] == 'extract':
    50	                item_id = re.search(r'^\[Item\] id (.+?), category ', req['messages'][1]['content'], re.M).group(1)
    51	                item = dict(items.execute('select * from items where input_id=?', (item_id,)).fetchone())
    52	                item['object_identifiers'] = json.loads(item['object_identifiers'])
    53	                seq = views.execute('select min(sequence_no) from processing_steps where input_id=? and sequence_no>0', (item_id,)).fetchone()[0]
    54	                db = snapshot(views, seq)
    55	                try:
    56	                    objects = [o['value'] for o in item['object_identifiers'] if uni.has(o['value'])]
    57	                    setting, system, user, schema = extraction.request_for(cfg, item, item['text'], store.views_for_prompt(db, objects), uni, store.groups_for_prompt(db, objects, item['title'] or ''))
    58	                    rebuilt = model.build_request(setting, system, user, schema, 'extraction', cfg.provider)
    59	                finally:
    60	                    db.close()
    61	                job.update(setting=setting, system=system, user=user, schema=schema)
    62	            else:
    63	                rebuilt = jev.request_for(cfg.matching, req['state'], req['questions'])
    64	                problems = jev.validate(json.loads(row['answer_json']), req['questions'])
    65	                if problems:
    66	                    raise ValueError('stored Jev control does not validate')
    67	            _, sha = model.request_identity(rebuilt)
    68	            if sha != row['request_sha256'] or rebuilt != req:
    69	                raise ValueError(f'current full request differs from stored call {ident}')
    70	            job['request_sha256'] = sha
    71	            jobs.append(job)
    72	    return cfg, jobs
