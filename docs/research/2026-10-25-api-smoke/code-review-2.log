    23	def test_reservation_covers_maximum_documented_usage():
    24	    """Value-reader: reviewed prices and maximum context fit the reservation; units are microdollars."""
    25	    reserve, max_input, _ = envelope('openai', REQUEST)
    26	    maximum = {'usage': {'prompt_tokens': max_input, 'completion_tokens': 128000}}
    27	    assert charge('openai', reply(), max_input, 16000) == 633
    28	    assert charge('openai', maximum, max_input, 128000) == 612700 <= reserve
    29	    request = {'model': 'jev-1.14.0', 'state': '', 'questions': {'q': {}}}
    30	    reserve, max_input, _ = envelope('jev', request)
    31	    assert charge('jev', {'usage': {'input_tokens': max_input, 'output_tokens': 99}}, max_input, None) <= reserve
