    66	def test_unknown_usage_survives_restart_and_refuses_send(tmp_path, outcome):
    67	    """Reserved/unknown: neither timeout nor malformed usage releases reserved money."""
    68	    def fail(*args):
    69	        if outcome == 'timeout':
