    85	def test_cancellation_closes_admission_before_draining(tmp_path):
    86	    """Cancellation: sent call drains with usage; unsent call never reaches HTTP."""
    87	    entered, release = threading.Event(), threading.Event()
    88	    calls = []
    89	    def send(*args):
    90	        calls.append(1); entered.set()
    91	        if len(calls) == 1:
    92	            assert release.wait(5)
    93	        return reply()
    94	    guard = GuardedTransport(tmp_path / 'budget.sqlite', lambda *a: lambda: send(*a))
    95	    with ThreadPoolExecutor(max_workers=1) as pool:
    96	        future = pool.submit(guard, 'openai', REQUEST)
