    25	def fingerprint(path):
    26	    h = hashlib.sha256()
    27	    with Path(path).open('rb') as handle:
    28	        for chunk in iter(lambda: handle.read(1024 * 1024), b''):
    29	            h.update(chunk)
    30	    return h.hexdigest()
    31	
