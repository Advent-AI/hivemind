    71	        return {'choices': []}
    72	    path = tmp_path / 'budget.sqlite'
    73	    guard = GuardedTransport(path, lambda *a: lambda: fail(*a))
    74	    with pytest.raises((BudgetError, TimeoutError)):
    75	        guard('openai', REQUEST)
    76	    assert guard.summary()['held_microdollars'] == 700000
    77	    def forbidden(*args):
    78	        raise AssertionError('closed admission reached HTTP')
    79	    resumed = GuardedTransport(path, lambda *a: lambda: forbidden(*a))
    80	    with pytest.raises(BudgetError):
    81	        resumed('openai', REQUEST)
    82	    assert resumed.summary()['held_microdollars'] == 700000
