    34	def test_concurrent_admission_cannot_overspend(tmp_path):
    35	    """Ready/admit: reserve both in-flight costs before a third request can send."""
    36	    entered, release = threading.Event(), threading.Event()
    37	    count = 0
    38	    lock = threading.Lock()
    39	    def send(*args):
    40	        nonlocal count
    41	        with lock:
    42	            count += 1
    43	            position = count
    44	            if count == 2:
    45	                entered.set()
    46	        if position <= 2:
    47	            assert release.wait(5)
    48	        return reply()
    49	    guard = GuardedTransport(tmp_path / 'budget.sqlite', lambda *a: lambda: send(*a))
    50	    with ThreadPoolExecutor(max_workers=2) as pool:
    51	        first = pool.submit(guard, 'openai', REQUEST)
    52	        second = pool.submit(guard, 'openai', REQUEST)
    53	        try:
    54	            assert entered.wait(5)
    55	            with pytest.raises(BudgetError):
    56	                guard('openai', REQUEST)
    57	            assert count == 2
    58	            assert guard.summary()['held_microdollars'] == 1400000
    59	        finally:
    60	            release.set()
    61	        first.result(); second.result()
    62	    assert guard.summary()['held_microdollars'] == 1266
