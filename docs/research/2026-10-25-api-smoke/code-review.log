   122	def single_attempt_http():
   123	    """Explicit live opt-in. Credentials are loaded once; tests supply a fake sender."""
   124	    keys = {'openai': model._key('openai'), 'jev': jev._key()}
   125	    urls = {'openai': model.ENDPOINTS['openai'][0], 'jev': jev.ENDPOINT}
   126	    if any(not isinstance(k, str) or not k for k in keys.values()):
   127	        raise BudgetError('configured provider credential missing')
   128	
   129	    def send(provider, body):
   130	        headers = {'Authorization': 'Bearer ' + keys[provider], 'Content-Type': 'application/json', 'Accept': 'application/json'}
   131	        data = json.dumps(body, sort_keys=True, ensure_ascii=False).encode('utf-8')
   132	        try:
   133	            with urllib.request.urlopen(urllib.request.Request(urls[provider], data, headers), timeout=60) as reply:
   134	                raw = reply.read()
   135	        except urllib.error.HTTPError as exc:
   136	            raise model.TransportError(f'{provider} HTTP {exc.code}; no automatic retry') from None
   137	        if any(k.encode('utf-8') in raw for k in keys.values()):
   138	            raise model.TransportError('credential in response; response not saved')
   139	        return json.loads(raw)
   140	    return send
