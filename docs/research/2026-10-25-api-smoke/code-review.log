    75	def call_job(job, archive, cfg, transport):
    76	    if job['purpose'] == 'extract':
    77	        answer = model.call(archive, cfg, job['setting'], job['system'], job['user'], job['schema'], 'extraction', 'extract', transport=transport)
    78	    else:
    79	        req = job['request']
    80	        answer = jev.ask(archive, cfg, cfg.matching, req['state'], req['questions'], 'match', transport=transport)
    81	    if answer.cached or answer.request_sha256 != job['request_sha256']:
    82	        raise ValueError('smoke response is cached or has a different request identity')
    83	    return {'original_call_id': job['original_call_id'], 'request_sha256': answer.request_sha256,
    84	            'data': answer.data, 'input_tokens': answer.input_tokens, 'output_tokens': answer.output_tokens,
    85	            'standard_list_cost_usd': answer.cost_usd}
