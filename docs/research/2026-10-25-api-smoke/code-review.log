    17	def envelope(provider, request):
    18	    """Reserve documented maximum usage, without guessing tokens from characters."""
    19	    if provider == 'openai' and request.get('model') == 'gpt-6-luna':
    20	        allowed = {'model', 'messages', 'response_format', 'reasoning_effort', 'max_completion_tokens'}
    21	        if set(request) - allowed:
    22	            raise BudgetError('unreviewed OpenAI request fields')
    23	        cap = request.get('max_completion_tokens')
    24	        if type(cap) is not int or not 1 <= cap <= 128000:
    25	            raise BudgetError('unreviewed OpenAI output limit')
    26	        # More than 922K input * $0.50/M plus 128K output * $0.75/M, including 10% regional premium.
    27	        return 700000, 922000, cap
    28	    if provider == 'jev' and request.get('model') == 'jev-1.14.0':
    29	        if set(request) != {'model', 'state', 'questions'} or not request['questions']:
    30	            raise BudgetError('unreviewed Jev request shape')
    31	        tokens = 65536 * (len(request['questions']) + 1)
    32	        return (tokens * 42 + 999) // 1000, tokens, None
    33	    raise BudgetError('unreviewed provider or model')
