    22	def test_reservation_covers_maximum_documented_usage():
    23	    """Value-reader: reviewed prices and maximum context fit the reservation; units are microdollars."""
    24	    reserve, max_input, _ = envelope('openai', REQUEST)
    25	    maximum = {'usage': {'prompt_tokens': max_input, 'completion_tokens': 128000}}
    26	    assert charge('openai', reply(), max_input, 16000) == 633
    27	    assert charge('openai', maximum, max_input, 128000) == 612700 <= reserve
    28	    request = {'model': 'jev-1.14.0', 'state': '', 'questions': {'q': {}}}
    29	    reserve, max_input, _ = envelope('jev', request)
    30	    assert charge('jev', {'usage': {'input_tokens': max_input, 'output_tokens': 99}}, max_input, None) <= reserve
