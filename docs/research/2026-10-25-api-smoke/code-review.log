    82	def test_cancellation_closes_admission_before_draining(tmp_path):
    83	    """Cancellation: sent call drains with usage; unsent call never reaches HTTP."""
    84	    entered, release = threading.Event(), threading.Event()
    85	    calls = []
    86	    def send(*args):
    87	        calls.append(1); entered.set()
    88	        assert release.wait(5)
    89	        return reply()
    90	    guard = GuardedTransport(tmp_path / 'budget.sqlite', send)
    91	    with ThreadPoolExecutor(max_workers=1) as pool:
    92	        future = pool.submit(guard, 'openai', REQUEST)
    93	        try:
    94	            assert entered.wait(5)
    95	            guard.stop('cancelled')
    96	            with pytest.raises(BudgetError):
    97	                guard('openai', REQUEST)
    98	        finally:
    99	            release.set()
   100	        future.result()
   101	    assert calls == [1]
   102	    assert guard.summary()['halted'] == 'cancelled'
   103	    assert guard.summary()['held_microdollars'] == 633
