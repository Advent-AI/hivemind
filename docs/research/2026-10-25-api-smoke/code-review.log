    36	def charge(provider, response, max_input, max_output):
    37	    usage = response.get('usage', {}) if isinstance(response, dict) else {}
    38	    names = ('prompt_tokens', 'completion_tokens') if provider == 'openai' else ('input_tokens', 'output_tokens')
    39	    counts = [usage.get(k) for k in names]
    40	    if any(type(n) is not int or n < 0 for n in counts) or counts[0] > max_input or (max_output is not None and counts[1] > max_output):
    41	        raise BudgetError('missing, invalid or above-envelope usage')
    42	    a, b = counts
    43	    # Integer microdollars, rounded up. OpenAI uses the highest reviewed Standard rate,
    44	    # not an estimate of a discount or the provider's eventual bill.
    45	    cost = (a * 550 + b * 825 + 999) // 1000 if provider == 'openai' else (a * 42 + 999) // 1000
    46	    return cost
