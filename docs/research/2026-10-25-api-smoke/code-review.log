   163	if __name__ == '__main__':
   164	    parser = argparse.ArgumentParser(description=__doc__)
   165	    parser.add_argument('--directory', type=Path, required=True)
   166	    parser.add_argument('--live', action='store_true')
   167	    args = parser.parse_args()
   168	    run(args.directory, live=args.live)
