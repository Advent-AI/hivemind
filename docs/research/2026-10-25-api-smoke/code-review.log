    88	def run(directory, *, live=False):
    89	    directory = Path(directory).resolve()
    90	    protected = json.loads((directory / 'protected-before.json').read_text())
    91	    changed = [p for p, expected in protected.items() if not Path(p).is_file() or fingerprint(p) != expected]
    92	    if changed:
    93	        raise ValueError('protected database changed before smoke: ' + ', '.join(changed))
    94	    cfg, jobs = jobs_for(directory)
    95	    manifest = {'calls': [{k: j[k] for k in ('original_call_id', 'purpose', 'request_sha256')} for j in jobs],
    96	                'max_calls': 36, 'cap_usd': 1.5, 'workers': 2, 'samples': 3, 'mode': 'ordinary API concurrency',
    97	                'inputs': {p.name: fingerprint(p) for p in (directory / 'inputs').glob('*.sqlite')},
    98	                'config_sha256': fingerprint(ROOT / 'poc/config/poc-v23.json')}
    99	    manifest_path = directory / 'manifest.json'
   100	    if manifest_path.exists() and json.loads(manifest_path.read_text()) != manifest:
   101	        raise ValueError('smoke manifest changed')
   102	    if not manifest_path.exists():
   103	        with manifest_path.open('x') as handle:
   104	            json.dump(manifest, handle, indent=2)
   105	    if not live:
   106	        print(json.dumps({'prepared': True, **manifest}, indent=2))
   107	        return
   108	    if (directory / 'budget.sqlite').exists():
   109	        raise ValueError('live smoke already attempted; do not silently restart or retry')
   110	    transport = GuardedTransport(directory / 'budget.sqlite', single_attempt_http())
   111	    results, failure = [], None
   112	    try:
   113	        for sample in range(3):
   114	            # Rotate the schedule; the concurrent arm is not always last.
   115	            order = ('control-a', 'control-b', 'concurrent')
   116	            order = order[sample:] + order[:sample]
   117	            for arm in order:
   118	                folder = directory / f'sample-{sample + 1}-{arm}'
   119	                folder.mkdir()
   120	                archive = model.Archive(folder / 'archive.sqlite')
   121	                try:
   122	                    for purpose in ('extract', 'match'):
   123	                        selected = [j for j in jobs if j['purpose'] == purpose]
   124	                        start = time.perf_counter()
   125	                        if arm == 'concurrent':
   126	                            pool = ThreadPoolExecutor(max_workers=2)
   127	                            futures = []
   128	                            try:
   129	                                futures = [pool.submit(call_job, j, archive, cfg, transport) for j in selected]
   130	                                replies = [f.result() for f in futures]
   131	                            except BaseException:
   132	                                transport.stop('study failed or cancelled')
   133	                                for future in futures:
   134	                                    future.cancel()
   135	                                raise
   136	                            finally:
   137	                                pool.shutdown(wait=True, cancel_futures=True)
   138	                        else:
   139	                            replies = [call_job(j, archive, cfg, transport) for j in selected]
   140	                        result = {'sample': sample + 1, 'arm': arm, 'purpose': purpose,
   141	                                  'seconds': round(time.perf_counter() - start, 3), 'answers': replies}
   142	                        results.append(result)
   143	                        (directory / 'progress.json').write_text(json.dumps(results, indent=2, ensure_ascii=False))
   144	                        print(json.dumps({k: result[k] for k in ('sample', 'arm', 'purpose', 'seconds')}), flush=True)
   145	                finally:
   146	                    archive.conn.close()
   147	    except BaseException as exc:
   148	        transport.stop('study failed or cancelled')
   149	        failure = type(exc).__name__
   150	        raise
   151	    finally:
   152	        changed = [p for p, expected in protected.items() if not Path(p).is_file() or fingerprint(p) != expected]
   153	        report = {'failure': failure, 'protected_files': len(protected), 'changed_protected_files': changed,
   154	                  'results': results, 'accounting': transport.summary()}
   155	        (directory / 'result.json').write_text(json.dumps(report, indent=2, ensure_ascii=False))
   156	        print(json.dumps({'failure': failure, 'changed_protected_files': changed,
   157	                          'attempts': len(report['accounting']['attempts']),
   158	                          'conservative_cost_usd': report['accounting']['held_microdollars'] / 1e6}), flush=True)
   159	        if changed and failure is None:
   160	            raise ValueError('protected database changed during smoke')
