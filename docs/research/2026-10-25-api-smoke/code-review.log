    33	def test_concurrent_admission_cannot_overspend(tmp_path):
    34	    """Ready/admit: reserve both in-flight costs before a third request can send."""
    35	    entered, release = threading.Event(), threading.Event()
    36	    count = 0
    37	    lock = threading.Lock()
    38	    def send(*args):
    39	        nonlocal count
    40	        with lock:
    41	            count += 1
    42	            if count == 2:
    43	                entered.set()
    44	        assert release.wait(5)
    45	        return reply()
    46	    guard = GuardedTransport(tmp_path / 'budget.sqlite', send)
    47	    with ThreadPoolExecutor(max_workers=2) as pool:
    48	        first = pool.submit(guard, 'openai', REQUEST)
    49	        second = pool.submit(guard, 'openai', REQUEST)
    50	        try:
    51	            assert entered.wait(5)
    52	            with pytest.raises(BudgetError):
    53	                guard('openai', REQUEST)
    54	            assert count == 2
    55	            assert guard.summary()['held_microdollars'] == 1400000
    56	        finally:
    57	            release.set()
    58	        first.result(); second.result()
    59	    assert guard.summary()['held_microdollars'] == 1266
