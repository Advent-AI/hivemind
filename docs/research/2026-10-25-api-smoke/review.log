    99	    input_tokens, output_tokens = int(usage.get('input_tokens') or 0), int(usage.get('output_tokens') or 0)
   100	    price_in, _ = model.PRICES.get(setting.model, (0.0, 0.0))
   101	    cost = round(input_tokens / 1e6 * price_in, 6)
   102	    call_id = archive.record(purpose=purpose, config_version=cfg.version, config_checksum=cfg.checksum, model=setting.model,
   103	                             request_sha256=sha if not problems else sha + ':schema:' + uuid.uuid4().hex[:8], request_json=request_json,
   104	                             response_json=json.dumps(response, ensure_ascii=False)[:200000], answer_json=json.dumps(answers, ensure_ascii=False) if answers is not None else None,
   105	                             prompt_chars=prompt_chars, input_tokens=input_tokens, output_tokens=output_tokens, cost_usd=cost,
   106	                             seconds=seconds, created_at=time.strftime('%Y-%m-%dT%H:%M:%S'))
   107	    if problems:
   108	        raise model.SchemaError('; '.join(problems[:5]))
