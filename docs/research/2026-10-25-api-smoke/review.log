   190	def request_identity(request):
   191	    """The exact serialized request and its archive key, shared by callers and validation."""
   192	    encoded = json.dumps(request, sort_keys=True, ensure_ascii=False)
   193	    return encoded, hashlib.sha256(encoded.encode('utf-8')).hexdigest()
   194	
   195	
   196	def call(archive, cfg, setting, system, user, schema, schema_name, purpose, *, transport=None):
   197	    provider = cfg.provider
   198	    request = build_request(setting, system, user, schema, schema_name, provider)
   199	    request_json, sha = request_identity(request)
   200	    hit = archive.lookup(sha)
   201	    prompt_chars = len(system) + len(user)
   202	    if hit:
   203	        call_id, answer_json, _, input_tokens, output_tokens = hit
   204	        return Answer(json.loads(answer_json), call_id, sha, True, prompt_chars, input_tokens or 0, output_tokens or 0, 0.0)
   205	    started = time.time()
   206	    response = (transport or openai_transport)(provider, request)
   207	    seconds = round(time.time() - started, 1)
