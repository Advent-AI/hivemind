     2	questions}`; each question is `noul` (yes/no → a probability), `choice` (labelled options → `choice`, `probabilities`,
     3	`confidence`) or `score`. Every call is archived in `model_calls` like every other model call, keyed by the request's
     4	digest, so a byte-identical request is served from the archive; input is priced from `model.PRICES`, output is free."""
     5	import json
     6	import os
     7	import time
     8	import urllib.error
     9	import urllib.request
    10	import uuid
    11	
    12	from . import model
    13	
    14	ENDPOINT = 'https://api.typesafe.ai/v1/systemone'
    15	KEY_NAME = 'TYPESAFE_API_KEY'
    16	RETRY_STATUSES = {429, 529}
    17	
    18	
    19	def _key():
    20	    if os.environ.get(KEY_NAME):
    21	        return os.environ[KEY_NAME]
    22	    with open(model.CREDENTIALS, encoding='utf-8') as handle:
    23	        return json.load(handle)[KEY_NAME]
    24	
    25	
    26	def transport(request, timeout=60):
    27	    """POST the request; one retry after a pause on a rate-limit or overload status; any other failure is a TransportError.
    28	    The body is the same sorted text the archive digests, so a cache hit is byte-identical to what was sent."""
    29	    body = json.dumps(request, sort_keys=True, ensure_ascii=False).encode('utf-8')
    30	    key = _key()
    31	    for attempt in range(2):
    32	        req = urllib.request.Request(ENDPOINT, body, {'Authorization': 'Bearer ' + key, 'Content-Type': 'application/json', 'Accept': 'application/json'})
    33	        try:
    34	            with urllib.request.urlopen(req, timeout=timeout) as response:
    35	                raw = response.read()
    36	            break
    37	        except urllib.error.HTTPError as error:
    38	            if error.code in RETRY_STATUSES and attempt == 0:
    39	                time.sleep(2)
    40	                continue
    41	            raise model.TransportError(f'Jev HTTP {error.code}') from None
    42	        except (urllib.error.URLError, OSError) as error:
    43	            raise model.TransportError(f'Jev transport failed: {type(error).__name__}') from None
    44	    if key.encode('utf-8') in raw:
    45	        raise model.TransportError('Jev response echoed the credential; not archived')
    46	    return json.loads(raw.decode('utf-8'))
    47	
    48	
    49	# Jev reports each probability rounded to two decimals independently of the choice it made on the unrounded values, so the
    50	# chosen option may print one unit below another (0.47 against 0.48; 1 of 2,353 archived choice answers on 2026-10-25).
    51	ROUNDING = 0.01
    52	
    53	
    54	def validate(answers, questions):
    55	    """The answers of a response against the request's questions; a list of problems."""
    56	    problems = []
    57	    if not isinstance(answers, dict) or set(answers) != set(questions):
    58	        return ['answer set differs from the questions asked']
    59	    for qid, question in questions.items():
    60	        answer = answers[qid]
    61	        if not isinstance(answer, dict) or answer.get('type') != question['type']:
    62	            problems.append(f'{qid}: answer type mismatch')
    63	            continue
    64	        if question['type'] == 'noul':
    65	            if not isinstance(answer.get('noul'), (int, float)) or not 0 <= answer['noul'] <= 1:
    66	                problems.append(f'{qid}: noul out of range')
    67	        elif question['type'] == 'choice':
    68	            probabilities = answer.get('probabilities')
    69	            if answer.get('choice') not in question['criteria'] or not isinstance(probabilities, dict) or set(probabilities) != set(question['criteria']):
    70	                problems.append(f'{qid}: choice or probabilities do not match the criteria')
    71	            elif any(not isinstance(v, (int, float)) or isinstance(v, bool) or not 0 <= v <= 1 for v in probabilities.values()) \
    72	                    or abs(sum(probabilities.values()) - 1) > 0.005 * len(probabilities) + 1e-9:
    73	                problems.append(f'{qid}: probabilities are not a distribution')
    74	            elif probabilities[answer['choice']] < max(probabilities.values()) - ROUNDING - 1e-9:
    75	                problems.append(f'{qid}: choice is not the most probable option')
    76	    return problems
    77	
    78	
    79	def request_for(setting, state, questions):
    80	    """The complete Jev request used both for dispatch and in-flight identity."""
    81	    return {'model': setting.model, 'state': state, 'questions': questions}
    82	
    83	
    84	def ask(archive, cfg, setting, state, questions, purpose, *, transport=None):
    85	    """One Jev request, archived; returns model.Answer whose data is the `answers` map."""
    86	    request = request_for(setting, state, questions)
    87	    request_json, sha = model.request_identity(request)
    88	    prompt_chars = len(request_json)
    89	    hit = archive.lookup(sha)
    90	    if hit:
    91	        call_id, answer_json, _, input_tokens, output_tokens = hit
    92	        return model.Answer(json.loads(answer_json), call_id, sha, True, prompt_chars, input_tokens or 0, output_tokens or 0, 0.0)
    93	    started = time.time()
    94	    response = (transport or globals()['transport'])(request)
    95	    seconds = round(time.time() - started, 2)
    96	    answers = response.get('answers') if isinstance(response, dict) else None
    97	    problems = validate(answers, questions)
