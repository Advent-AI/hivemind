    32	SCHEMA_SQL = """
    33	create table if not exists model_calls (
    34	  call_id integer primary key autoincrement, purpose text, config_version text, config_checksum text, model text,
    35	  request_sha256 text unique, request_json text, response_json text, answer_json text, prompt_chars integer,
    36	  input_tokens integer, output_tokens integer, cost_usd real, seconds real, created_at text
