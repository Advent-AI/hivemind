   166	def build_prompt(conn, view_id, prompt_version):
   167	    require_supported(prompt_version)
   168	    v = store.view(conn, view_id)
   169	    rungs = store.rungs_of(conn, view_id)
   170	    pieces, hidden = evidence_in_view(conn, view_id)
   171	    deps = store.dependencies_of(conn, view_id)
   172	    last = store.current_state(conn, view_id)
   173	    lines = _lines_english(conn, view_id, v, rungs, pieces, deps, last, themes_in_force(conn, view_id), hidden=hidden)
   174	    with open(config.prompt_path(prompt_version + '.txt'), encoding='utf-8') as handle:
   175	        return handle.read(), '\n'.join(lines)
