   105	def export(run_root, out):
   106	    out = Path(out)
   107	    out.mkdir(parents=True, exist_ok=False)
   108	    labels = [f'L{n}' for n in range(1, len(DRAWS) + 1)]
   109	    random.Random(20261117).shuffle(labels)
   110	    key = dict(zip(DRAWS, labels))
