    81	
    82	def matters_text():
    83	    m = json.loads(MATTERS.read_text())['matters']
    84	    return '\n'.join(f"- {x['matter']}: {x['name']} (e.g. {x['question']})" for x in m), [x['matter'] for x in m]
    85	
    86	
    87	def library_text(lib):
    88	    lines = []
    89	    for e in lib:
    90	        lines.append(f"- id {e['question_id']} · opened {e['opened']} · due {e['due']}: {e['question']}")
    91	        lines += [f'    possible answer: {a}' for a in e['possible_answers']]
    92	    return '\n'.join(lines)
    93	
    94	
    95	def store_paths(run_root, draw):
    96	    root = Path(run_root) / draw
    97	    record = json.loads((root / 'run.json').read_text())
    98	    if draw.startswith('new'):
    99	        folder = root / record['components']['judge']['folder'] / f'draw-{draw}'
   100	    else:
   101	        folder = root / record['components']['prod']['folder']
   102	    return folder / 'views.sqlite', folder / 'archive.sqlite'
   103	
   104	
   105	def export(run_root, out):
   106	    out = Path(out)
   107	    out.mkdir(parents=True, exist_ok=False)
   108	    labels = [f'L{n}' for n in range(1, len(DRAWS) + 1)]
   109	    random.Random(20261117).shuffle(labels)
   110	    key = dict(zip(DRAWS, labels))
   111	    KEY_FOLDER.mkdir(parents=True, exist_ok=True)
   112	    (KEY_FOLDER / 'mapping-key.json').write_text(json.dumps(key, indent=1) + '\n')
   113	    for draw, label in key.items():
   114	        views, archive = store_paths(run_root, draw)
   115	        lib = build_cards.library(views, archive, ITEMS)
   116	        (out / f'library-{label}.json').write_text(json.dumps(lib, indent=1, ensure_ascii=False) + '\n')
   117	    print('exported', len(key), 'libraries; key in', KEY_FOLDER / 'mapping-key.json')
   118	
   119	
   120	def read(out):
   121	    out = Path(out)
   122	    text, keys = matters_text()
   123	    jobs = []
   124	    for path in sorted(out.glob('library-L*.json')):
   125	        label = path.stem.split('-', 1)[1]
   126	        lib = json.loads(path.read_text())
   127	        prompt = READ.format(matters=text, label=label, library=library_text(lib))
   128	        for family in FAMILIES:
   129	            dest = out / f'map-{label}-{family}.txt'
   130	            if not dest.exists():
   131	                jobs.append((family, prompt, keys, dest))
   132	
   133	    def one(job):
   134	        family, prompt, keys, dest = job
   135	        for attempt in (1, 2):
   136	            answer, void = census_readers.run(family, prompt)
   137	            if answer and not void:
   138	                named = {r.get('matter') for r in json_lines(answer) if r.get('matter')}
   139	                if set(keys) <= named:
   140	                    dest.write_text(answer)
   141	                    return dest.name, None
   142	                void = f'{len(set(keys) - named)} matters not answered'
   143	        return dest.name, void
   144	    with concurrent.futures.ThreadPoolExecutor(max_workers=6) as pool:
   145	        for name, void in pool.map(one, jobs):
   146	            print(name, 'VOID ' + void if void else 'mapped', flush=True)
   147	
   148	
   149	def marks(out, label, family):
   150	    rows = json_lines((Path(out) / f'map-{label}-{family}.txt').read_text())
   151	    covering = {}
   152	    for r in rows:
   153	        if r.get('matter') and r.get('status') in ('opened', 'narrower'):
   154	            if r['status'] == 'opened' or r.get('main_outcome') is True:
   155	                for q in r.get('ids') or []:
   156	                    covering.setdefault(r['matter'], set()).add(str(q))
   157	    duplicates = {str(r['duplicate']) for r in rows if r.get('duplicate')}
   158	    return covering, duplicates
   159	
   160	
   161	def disagreements(out):
   162	    out = Path(out)
   163	    split = []
   164	    for path in sorted(out.glob('library-L*.json')):
   165	        label = path.stem.split('-', 1)[1]
   166	        a, _ = marks(out, label, 'codex')
   167	        b, _ = marks(out, label, 'claude')
   168	        for matter in sorted(set(a) | set(b)):
   169	            for q in sorted(a.get(matter, set()) ^ b.get(matter, set())):
   170	                split.append((label, matter, q))
   171	    return split
   172	
   173	
   174	def third(out):
   175	    out = Path(out)
   176	    m = {x['matter']: x for x in json.loads(MATTERS.read_text())['matters']}
   177	    libs = {p.stem.split('-', 1)[1]: {e['question_id']: e for e in json.loads(p.read_text())} for p in out.glob('library-L*.json')}
   178	    jobs = []
   179	    for label, matter, q in disagreements(out):
   180	        entry = libs[label].get(q)
   181	        if entry is None:
   182	            continue
   183	        for reader in FAMILIES:
   184	            dest = out / 'third' / f'{label}--{matter}--{q}--{reader}.json'
   185	            if not dest.exists():
   186	                question = f"{entry['question']} (due {entry['due']}); possible answers: " + ' | '.join(entry['possible_answers'])
   187	                jobs.append((reader, THIRD.format(matter=f"{m[matter]['name']} (e.g. {m[matter]['question']})", question=question), dest))
   188	
   189	    def one(job):
   190	        reader, prompt, dest = job
   191	        for attempt in (1, 2):
   192	            answer, void = census_readers.run(reader, prompt)
   193	            rows = json_lines(answer) if answer else []
   194	            if rows and isinstance(rows[-1].get('covers'), bool) and not void:
   195	                dest.parent.mkdir(exist_ok=True)
   196	                dest.write_text(json.dumps(rows[-1], ensure_ascii=False) + '\n')
   197	                return dest.name, None
   198	        return dest.name, void or 'no covers mark'
   199	    print(len(jobs), 'third-reader sessions')
   200	    with concurrent.futures.ThreadPoolExecutor(max_workers=6) as pool:
   201	        for name, void in pool.map(one, jobs):
   202	            print(name, 'VOID ' + void if void else 'marked', flush=True)
   203	
   204	
   205	def result(out):
   206	    out = Path(out)
   207	    key = json.loads((KEY_FOLDER / 'mapping-key.json').read_text())
   208	    label_of = {d: l for d, l in key.items()}
   209	    mapping, distinct = {}, {}
   210	    for draw, label in label_of.items():
   211	        a, dup_a = marks(out, label, 'codex')
   212	        b, dup_b = marks(out, label, 'claude')
   213	        lib = json.loads((out / f'library-{label}.json').read_text())
   214	        mapping[draw] = {}
   215	        for matter in sorted(set(a) | set(b)):
   216	            entries = []
   217	            for q in sorted(a.get(matter, set()) | b.get(matter, set())):
   218	                if q in a.get(matter, set()) and q in b.get(matter, set()):
   219	                    covers = True
   220	                else:
   221	                    thirds = [json.loads(p.read_text()).get('covers') for p in (out / 'third').glob(f'{label}--{matter}--{q}--*.json')]
   222	                    covers = True if thirds == [True, True] else False if thirds == [False, False] else 'split'
   223	                entries.append({'question': q, 'covers': covers})
   224	            if any(e['covers'] is not False for e in entries):
   225	                mapping[draw][matter] = [e for e in entries if e['covers'] is not False]
   226	        distinct[draw] = {'ids': len(lib), 'duplicates_both': len(dup_a & dup_b), 'duplicates_split': len(dup_a ^ dup_b)}
   227	    text = json.dumps({'mapping': mapping, 'distinct': distinct}, indent=1, ensure_ascii=False) + '\n'
   228	    (out / 'mapping.json').write_text(text)
   229	    print('mapping.json written', hashlib.sha256(text.encode()).hexdigest()[:16])
   230	
   231	
   232	if __name__ == '__main__':
   233	    command = sys.argv[1]
   234	    if command == 'export':
   235	        export(sys.argv[2], sys.argv[3])
   236	    else:
   237	        {'read': read, 'third': third, 'result': result}[command](sys.argv[2])
     1	# The comparison card (frozen with verdict-rule.json; plan §1.4, §1.5 F; D667)
     2	
     3	One card per question to be marked. The same form serves both systems; nothing on it names or hints at the system.
     4	
     5	1. **The question:** the system's question text, its due day, and its answer ladder (the rungs or outcomes as the system wrote them),
     6	   normalised to plain text: "Question", "Due", "Possible answers" (one per line).
     7	2. **The latest answer at the cutoff:** the chosen rung or outcome, and the system's own stated reason, as plain text.
     8	3. **The material that answer was given:** each evidence item the answering request contained, as its request shows it (the passage or
     9	   summary, the source's publisher and day). The order is by day, then as the request listed them. System-specific field names are removed.
    10	   No evidence the request did not contain is shown.
    11	4. **The library's other questions:** their question texts in opening order, each with its opening day, so that `duplicate` can be judged.
    12	   Only the later question of a same-bet pair is a duplicate.
    13	5. **The marks asked:** worth (worth / trivia / duplicate); answer (supported / unsupported / insufficient); a reason of at most 40 words.
    14	   A question with no answer by the cutoff is carded with "no answer" and only the worth mark is asked.
    15	
    16	**Blinding (amended before any output, D673):** the builder removes every system-specific field, label and formatting:
    17	- the request header's focus string;
    18	- rung stance labels (only each rung's condition is kept);
    19	- matcher and grouping notes;
    20	- evidence ids, which are renumbered per card.
    21	
    22	What the system wrote as its question and its rung conditions is its output and is shown as written. A closed reader shown 10 cards of each
    23	stored system (clean-e2e-full c1 and the old system's q1) lists every element of the form, not of the wording, that tells the systems
    24	apart. Each one named is removed and the test repeated until none is named. Differences of wording are disclosed with the result.
    25	
    26	**Order and keys:** the cards are shuffled per batch by seed 20261117; the key from card to system and draw is kept outside the repository.

