   222	                    covers = True if thirds == [True, True] else False if thirds == [False, False] else 'split'
   223	                entries.append({'question': q, 'covers': covers})
   224	            if any(e['covers'] is not False for e in entries):
   225	                mapping[draw][matter] = [e for e in entries if e['covers'] is not False]
   226	        distinct[draw] = {'ids': len(lib), 'duplicates_both': len(dup_a & dup_b), 'duplicates_split': len(dup_a ^ dup_b)}
   227	    text = json.dumps({'mapping': mapping, 'distinct': distinct}, indent=1, ensure_ascii=False) + '\n'
   228	    (out / 'mapping.json').write_text(text)
