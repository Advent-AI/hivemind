   122	def run(family, prompt):
   123	    """One closed session; returns (answer text, void reason or None). The Deck 1 rule (council_mark.run)."""
   124	    with tempfile.TemporaryDirectory(prefix='census-reader-') as empty:
   125	        command = CODEX + ['-C', empty, '-'] if family == 'codex' else CLAUDE
   126	        result = subprocess.run(command, input=prompt, text=True, capture_output=True, cwd=empty, timeout=3600)
   127	    events = [json.loads(line) for line in result.stdout.splitlines() if line.strip().startswith('{')]
   128	    if family == 'codex':
   129	        started = False
   130	        for event in events:
   131	            item = event.get('item', {})
   132	            if event.get('type') == 'turn.started':
   133	                started = True
   134	            kind = item.get('type')
   135	            if not kind or kind in ('agent_message', 'reasoning'):
   136	                continue
   137	            if kind == 'error' and not started and 'is deprecated' in item.get('message', ''):
   138	                continue
   139	            return None, f'a {kind} item in the log'
   140	        texts = [e.get('item', {}).get('text', '') for e in events if e.get('item', {}).get('type') == 'agent_message']
   141	        answer = texts[-1] if texts else None
   142	    else:
   143	        for event in events:
   144	            if event.get('type') == 'system' and event.get('subtype') == 'init' and (event.get('tools') or event.get('mcp_servers')):
   145	                return None, 'tools or MCP servers loaded'
   146	            if event.get('type') == 'system' and event.get('subtype') not in ('init', 'thinking_tokens'):
   147	                return None, f"system event {event.get('subtype')}"
   148	            content = (event.get('message') or {}).get('content')
   149	            if isinstance(content, list) and any(c.get('type') == 'tool_use' for c in content):
   150	                return None, 'a tool use'
   151	        results = [e.get('result') for e in events if e.get('type') == 'result']
   152	        answer = results[-1] if results else None
   153	    if result.returncode != 0 or not answer:
   154	        return None, f'exit {result.returncode} or no answer'
   155	    return answer, None
