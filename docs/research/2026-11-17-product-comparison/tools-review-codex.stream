   234	def _record(conn, cfg, view_id, seq, item, answer):
   235	    data = vocabulary.judgement_answer(answer.data)
   236	    judgement_id = store.insert(conn, 'judgements', view_id=view_id, seq=seq, input_id=item['input_id'], rung=data['rung'],
   237	                                reasons=data['reasons'], cited_evidence_json=json.dumps(data['cites']), cited_views_json=json.dumps(data['cites_views']),
   238	                                pushes_json=json.dumps(data['pushes'], ensure_ascii=False), changed=1 if data['changed'] else 0,
   239	                                theme_pushes_json=json.dumps(data.get('theme_pushes', []), ensure_ascii=False),
   240	                                reference=data.get('reference'), implied_outcome=data.get('implied_outcome'),
   241	                                why_changed=data['why_changed'], config_checksum=cfg.checksum, call_id=answer.call_id,
   242	                                request_sha256=answer.request_sha256, publication_day=item['publication_day'])
   243	    conn.commit()
   244	    return {'view_id': view_id, 'judgement_id': judgement_id, 'rung': data['rung'], 'changed': data['changed'], 'cost': answer.cost_usd, 'cached': answer.cached}
