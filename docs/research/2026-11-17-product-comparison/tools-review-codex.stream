     1	"""Library export and cards for the comparison's reading (card-spec.md; plan §1.5 F; D672, D673). Both systems write the same store
     2	(views, rungs, judgements, evidence) and send the same judge request, so one reader of both serves every draw.
     3	
     4	    python3 build_cards.py <views.sqlite> <archive.sqlite> <items db> <output.json>
     5	
     6	Writes, per question the library holds at the end of its run (the cutoff), the card text of card-spec.md: the question, its due day and its
     7	possible answers (each rung's condition, stance labels removed); the latest answer and its reasons; the material the answering request
     8	contained (evidence renumbered per card; matcher notes, ids and the header's focus string removed); the library's other questions in opening
     9	order with their opening days. A question never judged is carded "no answer".
    10	"""
    11	import json
    12	import re
    13	import sqlite3
    14	import sys
    15	from pathlib import Path
    16	
    17	RUNG = re.compile(r'rung (\d+) ([^:]*): ')
    18	ANNOTATION = re.compile(r'\s*\((?:no reference figure when the question opened|the reference when the question opened: ".*?")\)')   # D673 form check
    19	ITEM = re.compile(r'^- e\d+ \[([^;\]]*); ([^;\]]*);.*?from \S+ (\d{4}-\d{2}-\d{2})\] (.*)$')
    20	
    21	
    22	def ro(path):
    23	    conn = sqlite3.connect(f'file:{path}?mode=ro&immutable=1', uri=True)
    24	    conn.row_factory = sqlite3.Row
    25	    return conn
    26	
    27	
    28	def conditions(view_id, conn):
    29	    """{position: condition} with stance labels removed: the store's own conditions, as the system wrote them."""
    30	    return {r['position']: ANNOTATION.sub('', (r['condition'] or r['label'] or '')).strip() for r in
    31	            conn.execute('select position, label, condition from rungs where view_id=? order by position', (view_id,))}
    32	
    33	
    34	def material(request_json):
    35	    """The evidence lines of a judge request, renumbered: [(kind, publisher, day, summary, quote)]. Every other line is dropped."""
    36	    request = json.loads(request_json)
    37	    text = request['messages'][-1]['content']
    38	    items, current = [], None
    39	    for line in text.splitlines():
    40	        m = ITEM.match(line)
    41	        if m:
    42	            current = [m.group(1).strip(), m.group(2).strip(), m.group(3), m.group(4).strip(), '']
    43	            items.append(current)
    44	        elif current is not None and line.startswith('    Quote: '):
    45	            current[4] = line[len('    Quote: '):].strip()
    46	        elif not line.startswith('    '):
    47	            current = None
    48	    return items
    49	
    50	
    51	def library(views_path, archive_path, items_path):
    52	    conn, archive, items = ro(views_path), ro(archive_path), ro(items_path)
    53	    day_of = lambda input_id: (items.execute('select publication_day from items where input_id=?', (input_id,)).fetchone() or [None])[0]
    54	    views = list(conn.execute('select view_id, question, due_day, created_seq, created_from_input from views order by created_seq'))
    55	    out = []
    56	    for v in views:
    57	        latest = conn.execute('select rung, reasons, request_sha256, seq from judgements where view_id=? order by seq desc limit 1',
    58	                              (v['view_id'],)).fetchone()
    59	        rungs = conditions(v['view_id'], conn)
    60	        bounded = conn.execute('select count(*) from rungs where view_id=? and (lo is not null or hi is not null)', (v['view_id'],)).fetchone()[0]
    61	        entry = {'question_id': v['view_id'], 'question': v['question'], 'due': v['due_day'], 'opened': day_of(v['created_from_input']),
    62	                 'type': 'figure' if bounded else 'yes/no',
    63	                 'possible_answers': [rungs[p] for p in sorted(rungs)], 'answer': None, 'reasons': None, 'material': []}
    64	        if latest is not None:
    65	            entry['answer'] = rungs.get(latest['rung'])
    66	            entry['reasons'] = latest['reasons']
    67	            row = archive.execute('select request_json from model_calls where request_sha256=? limit 1', (latest['request_sha256'],)).fetchone()
    68	            if row is None:
    69	                raise SystemExit(f"{v['view_id']}: the latest judgement's request is not in the archive")
    70	            entry['material'] = material(row['request_json'])
    71	        out.append(entry)
    72	    return out
    73	
    74	
    75	def card_text(entry, lib):
    76	    lines = [f"Question: {entry['question']}", f"Due: {entry['due']}", 'Possible answers:']
    77	    lines += [f'- {c}' for c in entry['possible_answers']]
    78	    if entry['answer'] is None:
    79	        lines += ['', 'Latest answer at the cutoff: no answer']
    80	    else:
    81	        lines += ['', f"Latest answer at the cutoff: {entry['answer']}", f"Reason given: {entry['reasons']}", '',
    82	                  f"Material that answer was given ({len(entry['material'])} items, by day):"]
    83	        for k, (kind, publisher, day, summary, quote) in enumerate(sorted(entry['material'], key=lambda m: m[2]), 1):
    84	            lines.append(f'{k}. ({kind}; {publisher}; {day}) {summary}')
    85	            if quote:
    86	                lines.append(f'   Quote: {quote}')
    87	    others = [e for e in lib if e['question_id'] != entry['question_id']]
    88	    lines += ['', 'Other questions in the same library, in opening order:']
    89	    lines += [f"- opened {e['opened']}: {e['question']}" for e in others]
    90	    return '\n'.join(lines)
    91	
    92	
    93	def main(views_path, archive_path, items_path, out_path):
    94	    lib = library(views_path, archive_path, items_path)
    95	    cards = [{'question_id': e['question_id'], 'answered': e['answer'] is not None, 'text': card_text(e, lib)} for e in lib]
    96	    Path(out_path).write_text(json.dumps({'library': lib, 'cards': cards}, indent=1, ensure_ascii=False) + '\n')
    97	    print(f'{len(lib)} questions, {sum(c["answered"] for c in cards)} answered; material items {sum(len(e["material"]) for e in lib)}')
    98	
    99	
   100	if __name__ == '__main__':
   101	    main(*sys.argv[1:5])
