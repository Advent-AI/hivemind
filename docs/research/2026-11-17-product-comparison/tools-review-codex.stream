   235	
   236	if __name__ == '__main__':
   237	    command = sys.argv[1]
   238	    if command == 'deck':
   239	        deck(sys.argv[2], sys.argv[3])
   240	    elif command == 'debate':
   241	        debate(sys.argv[2], int(sys.argv[3]))
   242	    elif command == 'readings':
   243	        readings(sys.argv[2], sys.argv[3])
   244	    else:
   245	        mark(sys.argv[2])
    15	import json
    16	import math
    17	import sys
    18	
    19	RANK = {'answer': ['unsupported', 'insufficient', 'supported'], 'worth': ['trivia', 'duplicate', 'worth'], 'covers': [False, True]}
    20	SYSTEMS = ('new', 'old')
    21	
    22	
    23	def resolve(mark, kind, favoured):
    24	    """A final mark, or a split resolved to one of the marks its readers gave: the most favourable for a favoured system, the least for the
    25	    other (verdict-rule.json, countings). 'no answer' is never split."""
    26	    if not (isinstance(mark, dict) and 'split' in mark):
    27	        return mark
    28	    given = [m for m in mark['split'] if m in RANK[kind]]
    29	    if not given:
    30	        raise ValueError(f'a split of unknown marks: {mark}')
    31	    order = sorted(given, key=RANK[kind].index)
    32	    return order[-1] if favoured else order[0]
    33	
    34	
    35	def is_split(mark):
    36	    return isinstance(mark, dict) and 'split' in mark
    37	
    38	
    39	def system_of(draw):
    40	    return draw.split('-')[0]
    41	
    42	
    43	def served_by(readings, counting):
    44	    """{system: set of matters served in at least 2 of its 3 draws} under one counting ('1': new favoured, '2': old favoured)."""
    45	    favoured = 'new' if counting == '1' else 'old'
    46	    served_draws = {}
    47	    for draw, by_matter in readings['mapping'].items():
    48	        system = system_of(draw)
    49	        fav = system == favoured
    50	        for matter, questions in by_matter.items():
    51	            for q in questions:
    52	                covers = q['covers'] if q['covers'] != 'split' else fav       # covers > does not cover
    53	                if not covers:
    54	                    continue
    55	                card = readings['cards'][draw].get(q['question'])
    56	                if card is None:
    57	                    raise ValueError(f'{draw} {q["question"]}: a covering question has no card')
    58	                if card['answer'] == 'no answer':
    59	                    continue
    60	                if resolve(card['worth'], 'worth', fav) == 'worth' and resolve(card['answer'], 'answer', fav) == 'supported':
    61	                    served_draws.setdefault((system, matter), set()).add(draw)
    62	                    break
    63	    return {s: {m for (sys_, m), draws in served_draws.items() if sys_ == s and len(draws) >= 2} for s in SYSTEMS}
    64	
    65	
    66	def guardrails(readings, counting):
    67	    """Per system: the three shares over its pooled guardrail cards, and whether each subgroup is exercised (10 unsplit decided cards)."""
    68	    favoured = 'new' if counting == '1' else 'old'
    69	    out = {}
    70	    for system in SYSTEMS:
    71	        fav = system == favoured
    72	        counts = {'figure': [0, 0, 0], 'yes/no': [0, 0, 0], 'worth': [0, 0, 0]}     # [bad, decided, decided without a split]
    73	        for draw, cards in readings['cards'].items():
    74	            if system_of(draw) != system:
    75	                continue
    76	            for card in cards.values():
    77	                if not card.get('guardrail'):
    78	                    continue
    79	                if card['type'] in ('figure', 'yes/no') and card['answer'] != 'no answer':
    80	                    answer = resolve(card['answer'], 'answer', fav)
    81	                    if answer in ('supported', 'unsupported'):
    82	                        c = counts[card['type']]
    83	                        c[0] += answer == 'unsupported'
    84	                        c[1] += 1
    85	                        c[2] += not is_split(card['answer'])
    86	                worth = resolve(card['worth'], 'worth', fav)
    87	                c = counts['worth']
    88	                c[0] += worth in ('trivia', 'duplicate')
    89	                c[1] += 1
    90	                c[2] += not is_split(card['worth'])
    91	        out[system] = {k: {'share': (v[0] / v[1]) if v[1] else None, 'decided': v[1], 'unsplit': v[2]} for k, v in counts.items()}
    92	    result = {}
    93	    for k in ('figure', 'yes/no', 'worth'):
    94	        new, old = out['new'][k], out['old'][k]
    95	        exercised = new['unsplit'] >= 10 and old['unsplit'] >= 10
    96	        breach = exercised and (new['share'] - old['share']) > 0.10
    97	        result[k] = {'new': new, 'old': old, 'exercised': exercised, 'breach': breach}
    98	    return result
    99	
   100	
   101	def verdict(readings):
   102	    n = len(readings['matters'])
   103	    controls = readings['controls']
   104	    report = {'N': n}
   105	    invalid = []
   106	    if any(m not in ('unsupported', 'insufficient') for m in controls['plants']):
   107	        invalid.append('a planted wrong answer without an explicit rejection')
   108	    if sum(m == 'supported' for m in controls['supported']) < 3:
   109	        invalid.append('fewer than 3 of 4 supported controls accepted')
   110	    if sum(bool(x) for x in controls['repeats_same']) < 2:
   111	        invalid.append('fewer than 2 of 3 repeats marked the same')
   112	    if len(controls['plants']) != 6 or len(controls['supported']) != 4 or len(controls['repeats_same']) != 3:
   113	        invalid.append('the deck does not hold 6 plants, 4 supported controls and 3 repeats')
   114	    if invalid:
   115	        return dict(report, verdict='invalid', why=invalid)
   116	    small = []
   117	    if n < 20:
   118	        small.append(f'N = {n} < 20')
   119	    for draw, d in readings['distinct'].items():
   120	        both_ways = (d['ids'] - d['duplicates_both'], d['ids'] - d['duplicates_both'] - d['duplicates_split'])
   121	        if min(both_ways) < 30:
   122	            small.append(f'{draw}: {both_ways} distinct bets')
   123	    if small:
   124	        return dict(report, verdict='too small', why=small)
   125	    margin = max(3, math.ceil(0.15 * n))
   126	    per_counting = {}
   127	    for counting in ('1', '2'):
   128	        served = served_by(readings, counting)
   129	        a = len(served['new'] - served['old'])
   130	        b = len(served['old'] - served['new'])
   131	        per_counting[counting] = {'a': a, 'b': b, 'served_new': sorted(served['new']), 'served_old': sorted(served['old']),
   132	                                  'guardrails': guardrails(readings, counting)}
   133	    report['margin'] = margin
   134	    report['countings'] = per_counting
   135	    lead = all(c['a'] - c['b'] >= margin and c['a'] >= 2 * c['b'] for c in per_counting.values())
   136	    all_exercised_pass = all(g['exercised'] and not g['breach'] for c in per_counting.values() for g in c['guardrails'].values())
   137	    if lead and all_exercised_pass:
   138	        return dict(report, verdict='practical lead')
   139	    loss_count = all(c['b'] - c['a'] >= margin and c['b'] >= 2 * c['a'] for c in per_counting.values())
   140	    breaches = {k for k in ('figure', 'yes/no', 'worth') if all(c['guardrails'][k]['breach'] for c in per_counting.values())}
   141	    if loss_count or breaches:
   142	        return dict(report, verdict='practical loss', why=(['served matters'] if loss_count else []) + [f'guardrail {k}' for k in sorted(breaches)])
   143	    return dict(report, verdict='no practical winner')
   144	
   145	
   146	if __name__ == '__main__':
   147	    print(json.dumps(verdict(json.loads(open(sys.argv[1]).read())), indent=1, ensure_ascii=False))

