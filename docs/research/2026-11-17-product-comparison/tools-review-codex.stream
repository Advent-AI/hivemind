    52	def test_duplicates_count_both_and_split(tmp_path, monkeypatch):
    53	    """distinct bets: duplicates both families mark, and those one marks, are counted apart."""
    54	    codex = [{'matter': 'M01', 'status': 'missed', 'ids': []}, {'duplicate': 'v2', 'of': 'v1'}, {'duplicate': 'v3', 'of': 'v1'}]
    55	    claude = [{'matter': 'M01', 'status': 'missed', 'ids': []}, {'duplicate': 'v2', 'of': 'v1'}]
    56	    result = run_mapping(tmp_path, monkeypatch, codex, claude)
    57	    assert result['distinct']['new-1'] == {'ids': 3, 'duplicates_both': 1, 'duplicates_split': 1}

