    20	
    21	def test_a_mark_still_split_after_debate_is_kept_as_a_split(tmp_path):
    22	    """marks: agreed fields take the value; a field still different after the last round is {"split": [codex, claude]}."""
    23	    for family, mark in (('codex', {'worth': 'worth', 'answer': 'supported'}), ('claude', {'worth': 'worth', 'answer': 'insufficient'})):
    24	        (tmp_path / 'round-0').mkdir(exist_ok=True)
