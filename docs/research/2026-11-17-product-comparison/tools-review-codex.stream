   138	def valid(row, answered):
   139	    if not isinstance(row, dict) or row.get('worth') not in WORTH:
   140	        return False
   141	    return (row.get('answer') in ANSWER) if answered else row.get('answer') in (None, 'null')
   142	
   143	
   144	def run_marks(folder, label, prompts):
   145	    folder = Path(folder)
   146	    key = json.loads(KEY.read_text())
   147	    jobs = [(cid, family, prompt) for (cid, family), prompt in prompts.items() if not (folder / label / f'{cid}-{family}.json').exists()]
   148	
   149	    def one(job):
   150	        cid, family, prompt = job
   151	        for attempt in (1, 2):
   152	            answer, void = census_readers.run(family, prompt)
   153	            rows = json_lines(answer) if answer else []
   154	            if rows and valid(rows[-1], key[cid]['answered']) and not void:
   155	                (folder / label).mkdir(exist_ok=True)
   156	                (folder / label / f'{cid}-{family}.json').write_text(json.dumps(rows[-1], ensure_ascii=False) + '\n')
   157	                return cid, family, None
   158	            void = void or 'invalid mark'
   159	        return cid, family, void
   160	    with concurrent.futures.ThreadPoolExecutor(max_workers=6) as pool:
   161	        for cid, family, void in pool.map(one, jobs):
   162	            if void:
   163	                print(cid, family, 'VOID', void, flush=True)
   164	    print(label, 'done', flush=True)
   165	
   166	
   167	def mark(folder):
   168	    folder = Path(folder)
   169	    prompts = {(p.stem, f): BRIEF.format(card=p.read_text()) for p in sorted(folder.glob('C*.txt')) for f in FAMILIES}
   170	    run_marks(folder, 'round-0', prompts)
   171	
   172	
   173	def current(folder, cid, family):
   174	    for label in ('round-2', 'round-1', 'round-0'):
   175	        p = Path(folder) / label / f'{cid}-{family}.json'
   176	        if p.exists():
   177	            return json.loads(p.read_text())
   178	    return None
   179	
   180	
   181	def differs(a, b):
   182	    return a is not None and b is not None and (a['worth'] != b['worth'] or a.get('answer') != b.get('answer'))
   183	
   184	
   185	def debate(folder, round_number):
   186	    folder = Path(folder)
   187	    prompts = {}
   188	    for p in sorted(folder.glob('C*.txt')):
   189	        a, b = current(folder, p.stem, 'codex'), current(folder, p.stem, 'claude')
   190	        if differs(a, b):
   191	            for family, own, other in (('codex', a, b), ('claude', b, a)):
   192	                prompts[(p.stem, family)] = DEBATE.format(own=json.dumps(own, ensure_ascii=False), other=json.dumps(other, ensure_ascii=False),
   193	                                                          card=p.read_text())
   194	    print(len(prompts) // 2, 'cards in debate round', round_number)
   195	    run_marks(folder, f'round-{round_number}', prompts)
   196	
   197	
   198	def final(folder, cid):
   199	    a, b = current(folder, cid, 'codex'), current(folder, cid, 'claude')
   200	    if a is None or b is None:
   201	        raise SystemExit(f'{cid}: a family has no valid mark')
   202	    out = {}
   203	    for field in ('worth', 'answer'):
   204	        out[field] = a.get(field) if a.get(field) == b.get(field) else {'split': [a.get(field), b.get(field)]}
   205	    return out
   206	
