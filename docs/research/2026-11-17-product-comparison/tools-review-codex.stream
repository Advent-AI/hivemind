    77	def libraries(mapping_out):
    78	    key = json.loads((mapping_tool.KEY_FOLDER / 'mapping-key.json').read_text())
    79	    return {draw: json.loads((Path(mapping_out) / f'library-{label}.json').read_text()) for draw, label in key.items()}
    80	
    81	
    82	def plant(card_text, entry):
    83	    """The card with its latest answer moved one rung (the next rung, or the previous at the end)."""
    84	    answers = entry['possible_answers']
    85	    k = answers.index(entry['answer'])
    86	    moved = answers[k + 1] if k + 1 < len(answers) else answers[k - 1]
    87	    return card_text.replace(f"Latest answer at the cutoff: {entry['answer']}", f'Latest answer at the cutoff: {moved}', 1)
    88	
    89	
    90	def deck(mapping_out, folder):
    91	    folder = Path(folder)
    92	    folder.mkdir(parents=True, exist_ok=False)
    93	    libs = libraries(mapping_out)
    94	    mapping = json.loads((Path(mapping_out) / 'mapping.json').read_text())['mapping']
    95	    cards, rng = [], random.Random(SEED)
    96	    for draw in sorted(libs):
    97	        lib = libs[draw]
    98	        by_id = {e['question_id']: e for e in lib}
    99	        covering = {q['question'] for qs in mapping.get(draw, {}).values() for q in qs}
   100	        ids = sorted(by_id)
   101	        guard = set(ids if len(ids) <= 35 else random.Random(SEED).sample(ids, 35))
   102	        for qid in sorted(covering | guard):
   103	            e = by_id[qid]
   104	            cards.append({'draw': draw, 'question': qid, 'role': 'product', 'guardrail': qid in guard, 'covering': qid in covering,
   105	                          'type': e.get('type'), 'answered': e['answer'] is not None, 'text': build_cards.card_text(e, lib)})
   106	    controls = []
   107	    for system in ('new', 'old'):
   108	        pool = [c for c in cards if c['draw'].startswith(system) and c['answered'] and len(libs[c['draw']]) > 0]
   109	        for c in random.Random(SEED + 1).sample(pool, 3):
   110	            entry = {e['question_id']: e for e in libs[c['draw']]}[c['question']]
   111	            controls.append(dict(c, role='plant', text=plant(c['text'], entry)))
   112	    candidates = random.Random(SEED + 2).sample([c for c in cards if c['answered']], min(12, sum(c['answered'] for c in cards)))
   113	    confirmed = []
   114	    for c in candidates:
   115	        if len(confirmed) == 4:
   116	            break
   117	        answer, void = census_readers.run('claude', CONFIRM.format(card=c['text']))
   118	        rows = json_lines(answer) if answer else []
   119	        if rows and rows[-1].get('supported') is True and not void:
   120	            confirmed.append(dict(c, role='supported control'))
   121	    if len(confirmed) < 4:
   122	        raise SystemExit(f'only {len(confirmed)} supported controls confirmed of {len(candidates)} candidates')
   123	    controls += confirmed
   124	    for c in random.Random(SEED + 3).sample(cards, 3):
   125	        controls.append(dict(c, role='repeat'))
   126	    full = cards + controls
   127	    random.Random(SEED + 4).shuffle(full)
   128	    key = {}
   129	    for n, c in enumerate(full, 1):
   130	        cid = f'C{n:03d}'
   131	        key[cid] = {k: c[k] for k in ('draw', 'question', 'role', 'guardrail', 'covering', 'type', 'answered')}
   132	        (folder / f'{cid}.txt').write_text(c['text'])
   133	    KEY.parent.mkdir(parents=True, exist_ok=True)
   134	    KEY.write_text(json.dumps(key, indent=1) + '\n')
   135	    print(f'{len(full)} cards: {len(cards)} product, {len(controls)} controls; key in {KEY}')
   136	
