   208	def readings(mapping_out, folder):
   209	    folder = Path(folder)
   210	    key = json.loads(KEY.read_text())
   211	    matters = [{'matter': m['matter'], 'company_figure': m['company_figure']} for m in json.loads(mapping_tool.MATTERS.read_text())['matters']]
   212	    mapped = json.loads((Path(mapping_out) / 'mapping.json').read_text())
   213	    cards, plants, supported, repeats = {}, [], [], []
   214	    by_question = {}
   215	    for cid, k in sorted(key.items()):
   216	        f = final(folder, cid)
   217	        answer = f['answer'] if k['answered'] else 'no answer'
   218	        if k['role'] == 'product':
   219	            cards.setdefault(k['draw'], {})[k['question']] = {'worth': f['worth'], 'answer': answer, 'type': k['type'], 'guardrail': k['guardrail']}
   220	            by_question[(k['draw'], k['question'])] = (f['worth'], answer)
   221	        elif k['role'] == 'plant':
   222	            plants.append(answer)
   223	        elif k['role'] == 'supported control':
   224	            supported.append(answer)
   225	    for cid, k in sorted(key.items()):
   226	        if k['role'] == 'repeat':
   227	            f = final(folder, cid)
   228	            answer = f['answer'] if k['answered'] else 'no answer'
   229	            repeats.append((f['worth'], answer) == by_question[(k['draw'], k['question'])])
   230	    out = {'matters': matters, 'mapping': mapped['mapping'], 'distinct': mapped['distinct'], 'cards': cards,
   231	           'controls': {'plants': plants, 'supported': supported, 'repeats_same': repeats}}
   232	    (folder / 'readings.json').write_text(json.dumps(out, indent=1, ensure_ascii=False) + '\n')
   233	    print('readings.json written')
