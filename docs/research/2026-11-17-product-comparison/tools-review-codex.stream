    13	def run_mapping(tmp_path, monkeypatch, codex, claude, thirds=None):
    14	    out = tmp_path / 'out'
    15	    out.mkdir()
    16	    keys = tmp_path / 'keys'
    17	    keys.mkdir()
    18	    monkeypatch.setattr(mapping, 'KEY_FOLDER', keys)
    19	    (keys / 'mapping-key.json').write_text(json.dumps({'new-1': 'L1'}))
    20	    lib = [{'question_id': q, 'question': f'question {q}', 'due': '2027-01-31', 'opened': '2026-07-0' + q[-1], 'possible_answers': ['a', 'b']}
    21	           for q in ('v1', 'v2', 'v3')]
    22	    (out / 'library-L1.json').write_text(json.dumps(lib))
    23	    (out / 'map-L1-codex.txt').write_text('\n'.join(json.dumps(r) for r in codex))
    24	    (out / 'map-L1-claude.txt').write_text('\n'.join(json.dumps(r) for r in claude))
    25	    for (matter, q, reader), covers in (thirds or {}).items():
    26	        (out / 'third').mkdir(exist_ok=True)
    27	        (out / 'third' / f'L1--{matter}--{q}--{reader}.json').write_text(json.dumps({'covers': covers}))
    28	    mapping.result(out)
    29	    return json.loads((out / 'mapping.json').read_text())
