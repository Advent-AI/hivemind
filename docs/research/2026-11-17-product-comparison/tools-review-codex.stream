    33	    for label, family, mark in (('round-0', 'codex', {'worth': 'trivia', 'answer': None}), ('round-0', 'claude', {'worth': 'worth', 'answer': None}),
    34	                                ('round-1', 'codex', {'worth': 'worth', 'answer': None})):
