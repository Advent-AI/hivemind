    81	
    82	def matters_text():
    83	    m = json.loads(MATTERS.read_text())['matters']
    84	    return '\n'.join(f"- {x['matter']}: {x['name']} (e.g. {x['question']})" for x in m), [x['matter'] for x in m]
    85	
    86	
    87	def library_text(lib):
    88	    lines = []
    89	    for e in lib:
    90	        lines.append(f"- id {e['question_id']} · opened {e['opened']} · due {e['due']}: {e['question']}")
    91	        lines += [f'    possible answer: {a}' for a in e['possible_answers']]
    92	    return '\n'.join(lines)
