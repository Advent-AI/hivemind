   182	def themes_shown_in(request_text):
   183	    """The theme ids of the block a request carried: the ids the answer may name, whatever the ledger says now."""
   184	    block = request_text.split('\n[Themes in force, ', 1)
   185	    return set(re.findall(r'^- (v\d+) \(', block[1].split('\n\n[', 1)[0], re.M)) if len(block) == 2 else set()
   186	
   187	
   188	def evidence_shown_in(request_text):
   189	    """The evidence ids the request listed: the ids the answer may cite and push."""
   190	    block = request_text.split('\n[Evidence in ', 1)
   191	    return set(re.findall(r'^- (e\d+) \[', block[1].split('\n\n[', 1)[0], re.M)) if len(block) == 2 else set()
