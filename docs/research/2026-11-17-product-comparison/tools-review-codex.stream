     1	"""Tests of the comparison's verdict (verdict-rule.json; D665, D672). Each names the rule it proves. Synthetic readings only.
     2	
     3	Run: python3 -m pytest docs/research/2026-11-17-product-comparison/stage0/test_score_comparison.py
     4	"""
     5	import copy
     6	import sys
     7	from pathlib import Path
     8	
     9	sys.path.insert(0, str(Path(__file__).resolve().parent))
    10	import score_comparison as sc  # noqa: E402
    11	
    12	DRAWS = [f'{s}-{d}' for s in ('new', 'old') for d in (1, 2, 3)]
    13	
    14	
    15	def base(n=20, new_served=0, old_served=0, guard_cards=12):
    16	    """N matters; the first `new_served` served by the new system in all draws, the next `old_served` by the old one; every draw has
    17	    `guard_cards` guardrail cards of each type, all supported and worth (no breach)."""
    18	    matters = [{'matter': f'M{i:02d}', 'company_figure': False} for i in range(1, n + 1)]
    19	    mapping = {d: {} for d in DRAWS}
    20	    cards = {d: {} for d in DRAWS}
    21	    for i, m in enumerate(matters):
    22	        for d in DRAWS:
    23	            system = d.split('-')[0]
    24	            served = (system == 'new' and i < new_served) or (system == 'old' and new_served <= i < new_served + old_served)
    25	            if served:
    26	                q = f'{d}-q{i}'
    27	                mapping[d][m['matter']] = [{'question': q, 'covers': True}]
    28	                cards[d][q] = {'worth': 'worth', 'answer': 'supported', 'type': 'figure', 'guardrail': False}
    29	    for d in DRAWS:
    30	        for t in ('figure', 'yes/no'):
    31	            for j in range(guard_cards):
    32	                cards[d][f'{d}-g-{t}-{j}'] = {'worth': 'worth', 'answer': 'supported', 'type': t, 'guardrail': True}
    33	    return {'matters': matters, 'mapping': mapping, 'cards': cards,
    34	            'distinct': {d: {'ids': 40, 'duplicates_both': 0, 'duplicates_split': 0} for d in DRAWS},
    35	            'controls': {'plants': ['unsupported'] * 6, 'supported': ['supported'] * 4, 'repeats_same': [True] * 3}}
    36	
    37	
    38	def test_a_plant_without_an_explicit_rejection_makes_the_reading_invalid():
    39	    """Rule: invalid when a planted wrong answer is not explicitly rejected (a split or 'cannot tell' is not a rejection)."""
    40	    r = base(new_served=10)
    41	    r['controls']['plants'][0] = {'split': ['supported', 'unsupported']}
    42	    assert sc.verdict(r)['verdict'] == 'invalid'
    43	
    44	
    45	def test_fewer_than_three_supported_controls_or_two_repeats_is_invalid():
    46	    """Rule: invalid with fewer than 3 of 4 supported controls accepted, or fewer than 2 of 3 repeats the same."""
    47	    r = base(new_served=10)
    48	    r['controls']['supported'] = ['supported', 'supported', 'unsupported', 'insufficient']
    49	    assert sc.verdict(r)['verdict'] == 'invalid'
    50	    r = base(new_served=10)
    51	    r['controls']['repeats_same'] = [True, False, False]
    52	    assert sc.verdict(r)['verdict'] == 'invalid'
    53	
    54	
    55	def test_too_small_when_n_under_20_or_a_draw_under_30_distinct_bets_either_way():
    56	    """Rule: too small when N < 20, or a draw has fewer than 30 distinct bets (split duplicates counted both ways)."""
    57	    assert sc.verdict(base(n=19, new_served=10))['verdict'] == 'too small'
    58	    r = base(new_served=10)
    59	    r['distinct']['old-2'] = {'ids': 32, 'duplicates_both': 1, 'duplicates_split': 2}     # 31 one way, 29 the other
    60	    assert sc.verdict(r)['verdict'] == 'too small'
    61	
    62	
    63	def test_a_practical_lead_needs_the_margin_twice_b_and_every_guardrail_exercised_and_passing():
    64	    """Rule: lead when a - b >= max(3, ceil(0.15 N)) and a >= 2b under both countings, with every guardrail exercised and passing."""
    65	    r = base(n=20, new_served=5, old_served=1)               # a 5, b 1: margin max(3, 3) = 3; 5 - 1 = 4 >= 3; 5 >= 2
    66	    assert sc.verdict(r)['verdict'] == 'practical lead'
    67	    r = base(n=20, new_served=4, old_served=2)               # a 4, b 2: 4 - 2 = 2 < 3
    68	    assert sc.verdict(r)['verdict'] == 'no practical winner'
    69	
    70	
    71	def test_an_unexercised_guardrail_blocks_a_lead_but_not_a_loss():
    72	    """Rule: a subgroup with fewer than 10 unsplit decided cards per system cannot breach; it blocks only a lead."""
    73	    assert sc.verdict(base(n=20, new_served=5, old_served=1, guard_cards=3))['verdict'] == 'no practical winner'
    74	    assert sc.verdict(base(n=20, new_served=1, old_served=5, guard_cards=3))['verdict'] == 'practical loss'
    75	
    76	
    77	def test_a_guardrail_breach_under_both_countings_is_a_loss():
    78	    """Rule: loss when the new system's unsupported share is more than 10 points above the old's, under both countings."""
    79	    r = base(n=20, new_served=5, old_served=1)
    80	    for d in ('new-1', 'new-2', 'new-3'):
    81	        for j in range(3):                                     # 3 of 12 figure cards unsupported per draw: 25% against 0%
    82	            r['cards'][d][f'{d}-g-figure-{j}']['answer'] = 'unsupported'
    83	    out = sc.verdict(r)
    84	    assert out['verdict'] == 'practical loss' and 'guardrail figure' in out['why']
    85	
    86	
    87	def test_a_matter_counts_as_served_only_in_two_of_three_draws():
    88	    """Rule: served by a system when served in at least 2 of its 3 draws."""
    89	    r = base(n=20, new_served=5, old_served=1)
    90	    for d in ('new-2', 'new-3'):
    91	        r['mapping'][d].pop('M01')                             # M01 served by the new system in one draw only
    92	    out = sc.verdict(r)
    93	    assert out['countings']['1']['a'] == 4
    94	
    95	
    96	def test_splits_resolve_for_the_favoured_system_in_each_counting():
    97	    """Rule: counting 1 resolves the new system's splits favourably and the old's unfavourably; counting 2 the reverse."""
    98	    r = base(n=20, new_served=5, old_served=1)
    99	    for d in ('new-1', 'new-2', 'new-3'):
   100	        q = r['mapping'][d]['M01'][0]['question']
   101	        r['cards'][d][q]['answer'] = {'split': ['supported', 'unsupported']}
   102	    out = sc.verdict(r)
   103	    assert out['countings']['1']['a'] == 5 and out['countings']['2']['a'] == 4
   104	    assert out['verdict'] == 'practical lead'                 # 4 - 1 = 3 >= 3 and 4 >= 2 under counting 2 as well
   105	
   106	
   107	def test_a_resolved_insufficient_stays_out_of_the_decided_shares():
   108	    """Rule: insufficient (final or resolved) is outside the decided denominators."""
   109	    r = base(n=20, new_served=5, old_served=1)
   110	    r['cards']['new-1']['new-1-g-figure-0']['answer'] = 'insufficient'
   111	    g = sc.guardrails(r, '1')['figure']['new']
   112	    assert g['decided'] == 35 and g['share'] == 0.0
