   119	
   120	def read(out):
   121	    out = Path(out)
   122	    text, keys = matters_text()
   123	    jobs = []
   124	    for path in sorted(out.glob('library-L*.json')):
   125	        label = path.stem.split('-', 1)[1]
   126	        lib = json.loads(path.read_text())
   127	        prompt = READ.format(matters=text, label=label, library=library_text(lib))
   128	        for family in FAMILIES:
   129	            dest = out / f'map-{label}-{family}.txt'
   130	            if not dest.exists():
   131	                jobs.append((family, prompt, keys, dest))
   132	
   133	    def one(job):
   134	        family, prompt, keys, dest = job
   135	        for attempt in (1, 2):
   136	            answer, void = census_readers.run(family, prompt)
   137	            if answer and not void:
   138	                named = {r.get('matter') for r in json_lines(answer) if r.get('matter')}
   139	                if set(keys) <= named:
   140	                    dest.write_text(answer)
   141	                    return dest.name, None
   142	                void = f'{len(set(keys) - named)} matters not answered'
   143	        return dest.name, void
   144	    with concurrent.futures.ThreadPoolExecutor(max_workers=6) as pool:
   145	        for name, void in pool.map(one, jobs):
   146	            print(name, 'VOID ' + void if void else 'mapped', flush=True)
   147	
   148	
   149	def marks(out, label, family):
   150	    rows = json_lines((Path(out) / f'map-{label}-{family}.txt').read_text())
   151	    covering = {}
   152	    for r in rows:
   153	        if r.get('matter') and r.get('status') in ('opened', 'narrower'):
   154	            if r['status'] == 'opened' or r.get('main_outcome') is True:
   155	                for q in r.get('ids') or []:
   156	                    covering.setdefault(r['matter'], set()).add(str(q))
   157	    duplicates = {str(r['duplicate']) for r in rows if r.get('duplicate')}
   158	    return covering, duplicates
   159	
   160	
   161	def disagreements(out):
   162	    out = Path(out)
   163	    split = []
   164	    for path in sorted(out.glob('library-L*.json')):
   165	        label = path.stem.split('-', 1)[1]
   166	        a, _ = marks(out, label, 'codex')
   167	        b, _ = marks(out, label, 'claude')
   168	        for matter in sorted(set(a) | set(b)):
   169	            for q in sorted(a.get(matter, set()) ^ b.get(matter, set())):
   170	                split.append((label, matter, q))
   171	    return split
   172	
   173	
   174	def third(out):
   175	    out = Path(out)
   176	    m = {x['matter']: x for x in json.loads(MATTERS.read_text())['matters']}
   177	    libs = {p.stem.split('-', 1)[1]: {e['question_id']: e for e in json.loads(p.read_text())} for p in out.glob('library-L*.json')}
   178	    jobs = []
   179	    for label, matter, q in disagreements(out):
   180	        entry = libs[label].get(q)
   181	        if entry is None:
   182	            continue
   183	        for reader in FAMILIES:
   184	            dest = out / 'third' / f'{label}--{matter}--{q}--{reader}.json'
   185	            if not dest.exists():
   186	                question = f"{entry['question']} (due {entry['due']}); possible answers: " + ' | '.join(entry['possible_answers'])
   187	                jobs.append((reader, THIRD.format(matter=f"{m[matter]['name']} (e.g. {m[matter]['question']})", question=question), dest))
   188	
   189	    def one(job):
   190	        reader, prompt, dest = job
   191	        for attempt in (1, 2):
   192	            answer, void = census_readers.run(reader, prompt)
   193	            rows = json_lines(answer) if answer else []
   194	            if rows and isinstance(rows[-1].get('covers'), bool) and not void:
   195	                dest.parent.mkdir(exist_ok=True)
   196	                dest.write_text(json.dumps(rows[-1], ensure_ascii=False) + '\n')
   197	                return dest.name, None
   198	        return dest.name, void or 'no covers mark'
   199	    print(len(jobs), 'third-reader sessions')
   200	    with concurrent.futures.ThreadPoolExecutor(max_workers=6) as pool:
   201	        for name, void in pool.map(one, jobs):
   202	            print(name, 'VOID ' + void if void else 'marked', flush=True)
   203	
   204	
   205	def result(out):
   206	    out = Path(out)
   207	    key = json.loads((KEY_FOLDER / 'mapping-key.json').read_text())
   208	    label_of = {d: l for d, l in key.items()}
   209	    mapping, distinct = {}, {}
