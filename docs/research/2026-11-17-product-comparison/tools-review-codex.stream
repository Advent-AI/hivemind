   144	def run_marks(folder, label, prompts):
   145	    folder = Path(folder)
   146	    key = json.loads(KEY.read_text())
   147	    jobs = [(cid, family, prompt) for (cid, family), prompt in prompts.items() if not (folder / label / f'{cid}-{family}.json').exists()]
   148	
