    32	def test_both_opened_covers_and_a_narrower_covers_only_with_its_main_outcome(tmp_path, monkeypatch):
    33	    """covers: both mark opened, or narrower carrying the main outcome; a narrower without it does not cover."""
    34	    codex = [{'matter': 'M01', 'status': 'opened', 'ids': ['v1']}, {'matter': 'M02', 'status': 'narrower', 'ids': ['v2'], 'main_outcome': False}]
    35	    claude = [{'matter': 'M01', 'status': 'narrower', 'ids': ['v1'], 'main_outcome': True}, {'matter': 'M02', 'status': 'narrower', 'ids': ['v2'], 'main_outcome': False}]
    36	    result = run_mapping(tmp_path, monkeypatch, codex, claude)
    37	    assert result['mapping']['new-1'] == {'M01': [{'question': 'v1', 'covers': True}]}
    38	
    39	
    40	def test_a_family_split_is_settled_by_two_third_readers_or_stays_split(tmp_path, monkeypatch):
    41	    """A question one family maps and the other not: both third readers yes covers, both no does not, otherwise split."""
    42	    codex = [{'matter': 'M01', 'status': 'opened', 'ids': ['v1']}, {'matter': 'M02', 'status': 'opened', 'ids': ['v2']},
    43	             {'matter': 'M03', 'status': 'opened', 'ids': ['v3']}]
    44	    claude = [{'matter': 'M01', 'status': 'missed', 'ids': []}, {'matter': 'M02', 'status': 'missed', 'ids': []},
    45	              {'matter': 'M03', 'status': 'missed', 'ids': []}]
    46	    thirds = {('M01', 'v1', 'codex'): True, ('M01', 'v1', 'claude'): True, ('M02', 'v2', 'codex'): False, ('M02', 'v2', 'claude'): False,
    47	              ('M03', 'v3', 'codex'): True, ('M03', 'v3', 'claude'): False}
    48	    result = run_mapping(tmp_path, monkeypatch, codex, claude, thirds)
    49	    assert result['mapping']['new-1'] == {'M01': [{'question': 'v1', 'covers': True}], 'M03': [{'question': 'v3', 'covers': 'split'}]}
    50	
