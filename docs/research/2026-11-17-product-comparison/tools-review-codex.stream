    95	def store_paths(run_root, draw):
    96	    root = Path(run_root) / draw
    97	    record = json.loads((root / 'run.json').read_text())
    98	    if draw.startswith('new'):
    99	        folder = root / record['components']['judge']['folder'] / f'draw-{draw}'
   100	    else:
   101	        folder = root / record['components']['prod']['folder']
