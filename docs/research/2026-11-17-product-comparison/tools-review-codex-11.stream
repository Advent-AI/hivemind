   275	def trivia_count(readings, system, fav):
   276	    """Trivia marks (duplicates apart) among the decided worth marks of the system's guardrail shares' cards."""
   277	    trivia = decided = 0
   278	    for draw, cards in readings['cards'].items():
   279	        if system_of(draw) != system:
   280	            continue
   281	        for card in cards.values():
   282	            covering = card['covering'] if card['covering'] != 'split' else fav
   283	            if not card['guardrail'] or covering:
   284	                continue
   285	            decided += 1
   286	            trivia += resolve(card['worth'], 'worth', fav) == 'trivia'
   287	    return trivia, decided
   288	
   289	
   290	def days_to_opening(readings):
   291	    """Per draw and covered matter: days from the matter's earliest listed article to the first covering question's opening. A question
   292	    opened before the scored window (09-07) is 'opened in the warm-up'; one opened in the window before the matter's first listed article
   293	    is 'opened before the first listed article'."""
   294	    import datetime
   295	    out = {}
   296	    for draw, by_matter in readings['mapping'].items():
   297	        for matter, questions in by_matter.items():
   298	            opened = [readings['cards'][draw][q['question']].get('opened') for q in questions if q['covers'] is True]
   299	            opened = [d for d in opened if d]
   300	            first = readings.get('matter_first_day', {}).get(matter)
   301	            if not opened or not first:
   302	                continue
   303	            days = (datetime.date.fromisoformat(min(opened)) - datetime.date.fromisoformat(first)).days
   304	            out.setdefault(matter, {})[draw] = (days if days >= 0 else 'opened in the warm-up' if min(opened) < '2026-09-07'
   305	                                                else 'opened before the first listed article')
   306	    return out
   307	
   308	
   309	def verdict(readings):
   310	    present = {k: sorted(readings[k]) for k in ('mapping', 'cards', 'distinct')}
   311	    for k, draws in present.items():
   312	        if sorted(DRAWS) != draws:
   313	            raise SystemExit(f'refused: readings[{k!r}] holds {draws}, not the six draws {list(DRAWS)}')
   314	    verify_inputs(readings)
   315	    n = len(readings['matters'])
   316	    controls = readings['controls']
   317	    report = {'N': n}
   318	    # The quantities behind the verdict and the rule's printed-beside items are computed first, so an invalid or too-small reading
   319	    # still prints them (as diagnostics); the verdict order below is unchanged.
   320	    margin = max(3, math.ceil(0.15 * n))
   321	    per_counting = {}
   322	    for counting in ('1', '2'):
   323	        served = served_by(readings, counting)
   324	        a = len(served['new'] - served['old'])
   325	        b = len(served['old'] - served['new'])
   326	        per_counting[counting] = {'a': a, 'b': b, 'served_new': sorted(served['new']), 'served_old': sorted(served['old']),
   327	                                  'guardrails': guardrails(readings, counting)}
   328	    report['margin'] = margin
   329	    report['countings'] = per_counting
   330	    report['beside'] = beside(readings, per_counting)
   331	    report['beside'].update(printed_beside(readings, per_counting))
   332	    invalid = []
   333	    def rejected(m):
   334	        return m in REJECTED or (isinstance(m, dict) and 'split' in m and all(x in REJECTED for x in m['split']))
   335	    if any(not rejected(m) for m in controls['plants']):
   336	        invalid.append('a planted wrong answer without an explicit rejection')
   337	    if sum(m == 'supported' for m in controls['supported']) < 3:
   338	        invalid.append('fewer than 3 of 4 supported controls accepted')
   339	    if sum(bool(x) for x in controls['repeats_same']) < 2:
   340	        invalid.append('fewer than 2 of 3 repeats marked the same')
   341	    if len(controls['plants']) != 6 or len(controls['supported']) != 4 or len(controls['repeats_same']) != 3:
   342	        invalid.append('the deck does not hold 6 plants, 4 supported controls and 3 repeats')
   343	    if invalid:
   344	        return dict(report, verdict='invalid', why=invalid)
   345	    small = []
   346	    if n < 20:
   347	        small.append(f'N = {n} < 20')
   348	    for draw, d in readings['distinct'].items():
   349	        both_ways = (d['ids'] - d['duplicates_both'], d['ids'] - d['duplicates_both'] - d['duplicates_split'])
   350	        if min(both_ways) < 30:
   351	            small.append(f'{draw}: {both_ways} distinct bets')
   352	    if small:
   353	        return dict(report, verdict='too small', why=small)
   354	    lead = all(c['a'] - c['b'] >= margin and c['a'] >= 2 * c['b'] for c in per_counting.values())
   355	    all_exercised_pass = all(g['exercised'] and not g['breach'] for c in per_counting.values() for g in c['guardrails'].values())
   356	    if lead and all_exercised_pass:
   357	        return dict(report, verdict='practical lead')
   358	    loss_count = all(c['b'] - c['a'] >= margin and c['b'] >= 2 * c['a'] for c in per_counting.values())
   359	    breaches = {k for k in ('figure', 'yes/no', 'worth') if all(c['guardrails'][k]['breach'] for c in per_counting.values())}
   360	    if loss_count or breaches:
   361	        return dict(report, verdict='practical loss', why=(['served matters'] if loss_count else []) + [f'guardrail {k}' for k in sorted(breaches)])
   362	    return dict(report, verdict='no practical winner')
