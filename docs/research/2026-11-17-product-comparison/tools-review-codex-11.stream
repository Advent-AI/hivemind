    23	    cards = {d: {} for d in DRAWS}
    24	    for i, m in enumerate(matters):
    25	        for d in DRAWS:
    26	            system = d.split('-')[0]
    27	            served = (system == 'new' and i < new_served) or (system == 'old' and new_served <= i < new_served + old_served)
    28	            if served:
    29	                q = f'{d}-q{i}'
    30	                mapping[d][m['matter']] = [{'question': q, 'covers': True}]
    31	                cards[d][q] = {'worth': 'worth', 'answer': 'supported', 'type': 'figure', 'guardrail': False, 'covering': True}
    32	    for d in DRAWS:
    33	        for t in ('figure', 'yes/no'):
    34	            for j in range(guard_cards):
    35	                cards[d][f'{d}-g-{t}-{j}'] = {'worth': 'worth', 'answer': 'supported', 'type': t, 'guardrail': True, 'covering': False}
    36	    return {'matters': matters, 'mapping': mapping, 'cards': cards,
    37	            'distinct': {d: {'ids': 40, 'duplicates_both': 0, 'duplicates_split': 0} for d in DRAWS},
    38	            'controls': {'plants': ['unsupported'] * 6, 'supported': ['supported'] * 4, 'repeats_same': [True] * 3},
    39	            'inputs': {}}
