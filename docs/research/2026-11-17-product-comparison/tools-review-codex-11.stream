    18	def base(n=20, new_served=0, old_served=0, guard_cards=12):
    19	    """N matters; the first `new_served` served by the new system in all draws, the next `old_served` by the old one; every draw has
    20	    `guard_cards` guardrail cards of each type, all supported and worth (no breach)."""
