   229	def floors_per_draw(readings, system, fav):
   230	    """The proposed absolute floors as their source states them (reflection-10 `codex-1.md`; RUN-PLAN-v2 §1.6), per draw, met when met in
   231	    at least two of the system's three draws: important matters covered (a covering question, after the counting's split resolution) at
   232	    least 80%; trivial or duplicate questions among the random sample's decided worth marks at most 20% (covering cards included: the
   233	    frozen rule keeps them out of the guardrail shares, not the floors); supported latest answers among the random sample's answered cards
   234	    at least 90%, an insufficient or unresolved (split) answer counted and given no credit (the
   235	    verdict's own split resolution is unchanged). Citations and omissions are not measured."""
   236	    n = len(readings['matters'])
