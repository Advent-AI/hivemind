/opt/homebrew/bin/zsh -lc "python3 -B -c '
import hashlib, json
import score_comparison as s
import test_score_comparison as t

class MemoryPath:
    files = {}
    def __init__(self, name):
        self.name = name
    def exists(self):
        return self.name in self.files
    def read_bytes(self):
        return self.files[self.name]
    def read_text(self):
        return self.read_bytes().decode()

def put(key, value):
    MemoryPath.files[key] = json.dumps(value).encode()
    return hashlib.sha256(MemoryPath.files[key]).hexdigest()

def seal(r):
    elig = put(\"eligibility\", {\"eligible\": True})
    key = [dict(draw=d, question=q, role=\"product\", **{f:c[f] for f in (\"guardrail\", \"covering\", \"type\")})
           for d, cards in r[\"cards\"].items() for q,c in cards.items()]
    r[\"inputs\"] = dict(
        matters_sha256=put(\"matters\", {\"matters\":r[\"matters\"]}),
        mapping_path=\"mapping\", mapping_sha256=put(\"mapping\", {\"mapping\":r[\"mapping\"], \"distinct\":r[\"distinct\"], \"eligibility_sha256\":elig}),
        eligibility_path=\"eligibility\", eligibility_sha256=elig,
        deck_key_path=\"deck\", deck_key_sha256=put(\"deck\", dict(enumerate(key))))
    s.verify_inputs(r)
    return r

s.Path = MemoryPath
s.MATTERS = MemoryPath(\"matters\")
for expected in (\"invalid\", \"too small\"):
    r = t.base(n=19 if expected == \"too small\" else 20, new_served=5, old_served=1)
    if expected == \"invalid\":
        r[\"controls\"][\"repeats_same\"] = [False,False,True]
    print(\"Clean:\", s.verdict(seal(r))[\"verdict\"])
    r[\"cards\"][\"new-1\"][\"new-1-q0\"][\"opened\"] = \"bad-date\"
    r[\"matter_first_day\"] = {\"M01\": \"2026-09-08\"}
    try:
        print(s.verdict(seal(r))[\"verdict\"])
    except ValueError as exc:
        print(expected, \"throws after successful input verification:\", str(exc))
