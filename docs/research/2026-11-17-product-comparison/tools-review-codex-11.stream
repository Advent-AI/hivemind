   100	def test_an_unexercised_guardrail_blocks_a_lead_but_not_a_loss():
   101	    """Rule: a subgroup with fewer than 10 unsplit decided cards per system cannot breach; it blocks only a lead."""
   102	    assert verdict(base(n=20, new_served=5, old_served=1, guard_cards=3))['verdict'] == 'no practical winner'
   103	    assert verdict(base(n=20, new_served=1, old_served=5, guard_cards=3))['verdict'] == 'practical loss'
