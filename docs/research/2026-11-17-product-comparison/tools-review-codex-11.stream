    66	
    67	def test_a_plant_without_an_explicit_rejection_makes_the_reading_invalid():
    68	    """Rule: invalid when a planted wrong answer is not explicitly rejected (a split or 'cannot tell' is not a rejection)."""
    69	    r = base(new_served=10)
    70	    r['controls']['plants'][0] = {'split': ['supported', 'unsupported']}
    71	    assert verdict(r)['verdict'] == 'invalid'
    72	
    73	
    74	def test_fewer_than_three_supported_controls_or_two_repeats_is_invalid():
    75	    """Rule: invalid with fewer than 3 of 4 supported controls accepted, or fewer than 2 of 3 repeats the same."""
    76	    r = base(new_served=10)
    77	    r['controls']['supported'] = ['supported', 'supported', 'unsupported', 'insufficient']
    78	    assert verdict(r)['verdict'] == 'invalid'
    79	    r = base(new_served=10)
    80	    r['controls']['repeats_same'] = [True, False, False]
    81	    assert verdict(r)['verdict'] == 'invalid'
    82	
    83	
    84	def test_too_small_when_n_under_20_or_a_draw_under_30_distinct_bets_either_way():
    85	    """Rule: too small when N < 20, or a draw has fewer than 30 distinct bets (split duplicates counted both ways)."""
    86	    assert verdict(base(n=19, new_served=10))['verdict'] == 'too small'
    87	    r = base(new_served=10)
    88	    r['distinct']['old-2'] = {'ids': 32, 'duplicates_both': 1, 'duplicates_split': 2}     # 31 one way, 29 the other
    89	    assert verdict(r)['verdict'] == 'too small'
    90	
    91	
    92	def test_a_practical_lead_needs_the_margin_twice_b_and_every_guardrail_exercised_and_passing():
    93	    """Rule: lead when a - b >= max(3, ceil(0.15 N)) and a >= 2b under both countings, with every guardrail exercised and passing."""
    94	    r = base(n=20, new_served=5, old_served=1)               # a 5, b 1: margin max(3, 3) = 3; 5 - 1 = 4 >= 3; 5 >= 2
    95	    assert verdict(r)['verdict'] == 'practical lead'
    96	    r = base(n=20, new_served=4, old_served=2)               # a 4, b 2: 4 - 2 = 2 < 3
    97	    assert verdict(r)['verdict'] == 'no practical winner'
    98	
