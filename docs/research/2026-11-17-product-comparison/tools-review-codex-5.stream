   170	def main(views_path, archive_path, items_path, out_path):
   171	    lib = library(views_path, archive_path, items_path)
   172	    cards = [{'question_id': e['question_id'], 'answered': e['answer'] is not None, 'text': card_text(e, lib)} for e in lib]
   173	    Path(out_path).write_text(json.dumps({'library': lib, 'cards': cards}, indent=1, ensure_ascii=False) + '\n')
   174	    print(f'{len(lib)} questions, {sum(c["answered"] for c in cards)} answered; material items {sum(len(e["material"]) for e in lib)}')
   175	
   176	
   177	if __name__ == '__main__':
   178	    main(*sys.argv[1:5])

