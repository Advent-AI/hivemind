   165	            raise SystemExit(f'refused: the {kind} file the readings name is missing or differs from its fingerprint')
   166	        return json.loads(path.read_text())
   167	    frozen = [{'matter': m['matter'], 'company_figure': m['company_figure']} for m in json.loads(MATTERS.read_text())['matters']]
