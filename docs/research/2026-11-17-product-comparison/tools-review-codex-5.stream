    70	def last_attempt(ledger_path):
    71	    """The latest attempt the ledger's log records (failed sends and refusals included), how many lines it holds, and why the log cannot
    72	    establish the timing, or None: the log must exist and reconcile with the ledger (one line per settled attempt and per refusal, the
    73	    settled charges summing to the spend, nothing still reserved), since the ledger writes its log line after its own state."""
    74	    path = Path(str(ledger_path).replace('.json', '.attempts.jsonl'))
    75	    if not path.exists():
    76	        return None, 0, f'{path.name} missing'
    77	    lines = [json.loads(line) for line in path.read_text().splitlines() if line.strip()]
    78	    ledger = json.loads(Path(ledger_path).read_text())
    79	    charged = sum(line.get('charged', 0) for line in lines)
    80	    if len(lines) != ledger['attempts'] + ledger['refused'] or abs(charged - ledger['spent']) > 1e-6 or ledger['reserved'] > 1e-9:
    81	        return None, len(lines), (f"{path.name} holds {len(lines)} lines and ${charged:.6f} against the ledger's {ledger['attempts']} attempts, "
    82	                                  f"{ledger['refused']} refusals, ${ledger['spent']:.6f} spent and ${ledger['reserved']:.6f} reserved")
    83	    return (max(local(line['at']) for line in lines) if lines else None), len(lines), None
