   135	def card_text(entry, lib):
   136	    lines = [f"Question: {entry['question']}", f"Opened: {entry['opened']}", f"Due: {entry['due']}", 'Possible answers (numbered as the reasons cite them):']
   137	    lines += [f'{k}. {c}' for k, c in enumerate(entry['possible_answers'], 1)]
   138	    if entry['answer'] is None:
   139	        lines += ['', 'Latest answer at the cutoff: no answer']
   140	    else:
   141	        lines += ['', f"Latest answer at the cutoff: {entry['answer']}", f"Reason given: {entry['reasons']}", '',
   142	                  f"Material that answer was given ({len(entry['material'])} items, by day):"]
   143	        for k, item in enumerate(sorted(entry['material'], key=lambda m: m['day']), 1):
   144	            lines.append(f"{k}. ({item['tier']}; publisher {item['publisher']}; speaker {item['speaker']}; original source {item['original']}; "
   145	                         f"published {item['day']}) {item['summary']}")
   146	            if item['quote']:
   147	                lines.append(f"   Quote: {item['quote']}")
   148	        ctx = entry.get('context') or {}
   149	        if ctx.get('hidden'):
   150	            lines.append(f"Not shown to the answer: {ctx['hidden']} more items in force, read in earlier answers; the previous answer carries them.")
   151	        if ctx.get('depends_on'):
   152	            lines += ['', 'Answers of the questions it depends on, as the answer was given them:']
   153	            for d in ctx['depends_on']:
   154	                lines.append(f"- ({d['flag']}; {d['direction']}) {d['question']}: answered {d['answer'] or 'not yet'}; reason: {d['reasons']}"
   155	                             if d['answer'] else f"- {d['question']} ({d['flag']})")
   156	        if ctx.get('themes'):
   157	            lines += ['', 'Themes in force, as the answer was given them:']
   158	            for t in ctx['themes']:
   159	                lines.append(f"- {t['question']} (due {t['due']}): answered {t['rung']}. {t['answer']} on {t['judged']}"
   160	                             + ('; updated since this question was last answered' if t['updated'] else '') + f"; reason: {t['reasons']}")
   161	                lines.append('  Its possible answers: ' + ' '.join(f'{k}. {c}' for k, c in enumerate(t['possible_answers'], 1)))
   162	        previous = ctx.get('previous')
   163	        lines += ['', f"Previous answer, given for comparison: {previous['rung']}. {previous['answer']}; reason: {previous['reasons']}" if previous
   164	                  else 'Previous answer: none (this was the first answer).']
   165	    lines += ['', "The library's questions in opening order (this card's question marked):"]
   166	    lines += [f"- opened {e['opened']}: {e['question']}" + ('   <- this question' if e['question_id'] == entry['question_id'] else '') for e in lib]
   167	    return '\n'.join(lines)
   168	
