    60	def expected_identity(run_root, draw):
    61	    """The identity launch_comparison.py registers for a counted draw (plan §2; D667)."""
    62	    options = {'until_day': '2026-09-20', 'passes': 3, 'from_day': '2026-07-01', 'manifest': str(DATA / 'manifest-2026-07-01-09-20.json'),
