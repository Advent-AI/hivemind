    97	        if unreconciled:
    98	            problems.append(f'{draw}: the timing cannot be established: {unreconciled}')
    99	        if attempt and (latest is None or attempt > latest):
   100	            latest = attempt
   101	        draws[draw] = {'launch': min(starts).isoformat() if starts else None, 'last call': latest.isoformat() if latest else None,
   102	                       'databases with calls': databases, 'ledger attempts': attempts,
   103	                       'stores': {Path(p).name: {'path': str(p), 'sha256': sha256(p)} for p in paths} if paths else {}}
   104	        if not starts:
