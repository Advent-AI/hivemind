   229	FLOORS = {'covered': Fraction(80, 100), 'trivial or duplicate': Fraction(20, 100), 'supported': Fraction(90, 100)}
   230	
   231	
   232	def floors_per_draw(readings, system, fav):
   233	    """The proposed absolute floors as their source states them (reflection-10 `codex-1.md`; RUN-PLAN-v2 §1.6), per draw, met when met in
   234	    at least two of the system's three draws: important matters covered (a covering question, after the counting's split resolution) at
   235	    least 80%; trivial or duplicate questions among the guardrail-share cards' decided worth marks at most 20%; supported latest answers
   236	    among the answered guardrail-share cards at least 90%, an insufficient answer counted and given no credit. Citations and omissions are
   237	    not measured."""
   238	    n = len(readings['matters'])
   239	    per_draw = {}
   240	    for draw in DRAWS:
   241	        if system_of(draw) != system:
   242	            continue
   243	        covered = sum(1 for questions in readings['mapping'][draw].values()
   244	                      if any(q['covers'] is True or (q['covers'] == 'split' and fav) for q in questions))
   245	        trivial = worth_decided = supported = answered = 0
   246	        for card in readings['cards'][draw].values():
   247	            covering = card['covering'] if card['covering'] != 'split' else fav
   248	            if not card['guardrail'] or covering:
   249	                continue
   250	            worth_decided += 1
   251	            trivial += resolve(card['worth'], 'worth', fav) in ('trivia', 'duplicate')
   252	            if card['answer'] != 'no answer':
   253	                answered += 1
   254	                supported += resolve(card['answer'], 'answer', fav) == 'supported'
   255	        shares = {'covered': (covered, n), 'trivial or duplicate': (trivial, worth_decided), 'supported': (supported, answered)}
   256	        per_draw[draw] = {k: {'count': f'{a}/{b}', 'met': (b > 0 and (Fraction(a, b) <= FLOORS[k] if k == 'trivial or duplicate'
   257	                                                                      else Fraction(a, b) >= FLOORS[k]))} for k, (a, b) in shares.items()}
   258	    out = {'per draw': per_draw}
   259	    for k in FLOORS:
   260	        out[f'{k}: met in at least 2 of 3 draws'] = sum(d[k]['met'] for d in per_draw.values()) >= 2
   261	    out['wrong citations'] = out['answer-changing omissions'] = 'not measured'
   262	    return out
