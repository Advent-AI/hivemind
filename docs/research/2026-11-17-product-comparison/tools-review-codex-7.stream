    83	def guardrails(readings, counting):
    84	    """Per system: the three shares over its pooled guardrail cards, and whether each subgroup is exercised (10 unsplit decided cards)."""
    85	    favoured = 'new' if counting == '1' else 'old'
    86	    out = {}
    87	    for system in SYSTEMS:
    88	        fav = system == favoured
    89	        counts = {'figure': [0, 0, 0], 'yes/no': [0, 0, 0], 'worth': [0, 0, 0]}     # [bad, decided, decided without a split]
    90	        for draw, cards in readings['cards'].items():
    91	            if system_of(draw) != system:
    92	                continue
    93	            for card in cards.values():
    94	                covering = card['covering'] if card['covering'] != 'split' else fav      # covers > does not cover
    95	                if not card['guardrail'] or covering:
    96	                    continue
    97	                if card['type'] in ('figure', 'yes/no') and card['answer'] != 'no answer':
    98	                    answer = resolve(card['answer'], 'answer', fav)
    99	                    if answer in ('supported', 'unsupported'):
   100	                        c = counts[card['type']]
   101	                        c[0] += answer == 'unsupported'
   102	                        c[1] += 1
   103	                        c[2] += not is_split(card['answer'])
   104	                worth = resolve(card['worth'], 'worth', fav)
   105	                c = counts['worth']
   106	                c[0] += worth in ('trivia', 'duplicate')
   107	                c[1] += 1
   108	                c[2] += not is_split(card['worth'])
   109	        out[system] = {k: {'share': Fraction(v[0], v[1]) if v[1] else None, 'bad': v[0], 'decided': v[1], 'unsplit': v[2]} for k, v in counts.items()}
   110	    result = {}
   111	    for k in ('figure', 'yes/no', 'worth'):
   112	        new, old = out['new'][k], out['old'][k]
   113	        exercised = new['unsplit'] >= 10 and old['unsplit'] >= 10
   114	        breach = exercised and (new['share'] - old['share']) > Fraction(1, 10)
   115	        result[k] = {'new': new, 'old': old, 'exercised': exercised, 'breach': breach}
   116	    return result
