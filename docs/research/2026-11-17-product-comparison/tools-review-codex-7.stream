   158	def verify_inputs(readings):
   159	    """Refuses readings that were not made from the frozen matter list, the mapping file, a passing eligibility check and the deck key
   160	    they name: each file is read again and compared with what the readings carry."""
   161	    inputs = readings.get('inputs') or {}
   162	    def read(kind):
   163	        path = Path(inputs.get(f'{kind}_path') or '/nonexistent')
   164	        if not path.exists() or hashlib.sha256(path.read_bytes()).hexdigest() != inputs.get(f'{kind}_sha256'):
   165	            raise SystemExit(f'refused: the {kind} file the readings name is missing or differs from its fingerprint')
   166	        return json.loads(path.read_text())
   167	    frozen = [{'matter': m['matter'], 'company_figure': m['company_figure']} for m in json.loads(MATTERS.read_text())['matters']]
   168	    if readings['matters'] != frozen or inputs.get('matters_sha256') != hashlib.sha256(MATTERS.read_bytes()).hexdigest():
   169	        raise SystemExit('refused: the readings were not made on the frozen matter list')
   170	    mapped, eligibility, key = read('mapping'), read('eligibility'), read('deck_key')
   171	    if mapped['mapping'] != readings['mapping'] or mapped['distinct'] != readings['distinct']:
   172	        raise SystemExit('refused: the readings\' mapping differs from the mapping file')
   173	    if mapped.get('eligibility_sha256') != inputs['eligibility_sha256'] or eligibility.get('eligible') is not True:
   174	        raise SystemExit('refused: the mapping was not made from a passing eligibility check')
   175	    keyed = {}
   176	    for k in key.values():
   177	        if k['role'] == 'product':
   178	            keyed.setdefault(k['draw'], {})[k['question']] = {f: k[f] for f in ('guardrail', 'covering', 'type')}
   179	    held = {draw: {q: {f: card[f] for f in ('guardrail', 'covering', 'type')} for q, card in cards.items()} for draw, cards in readings['cards'].items()}
   180	    if keyed != held:
   181	        raise SystemExit('refused: the readings\' cards, or their guardrail, covering or type marks, are not the deck key\'s product cards')
   182	
