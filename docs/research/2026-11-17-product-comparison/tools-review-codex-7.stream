     1	"""Whether the six draws may give a release verdict (D667; plan §1.4 item 10; D675), and the fingerprints of the stores the reading uses.
     2	
     3	    python3 eligibility.py <run root> <out json>
     4	
     5	A draw is eligible when its record says complete under its own label, with the registered identity `launch_comparison.py` gives it
     6	(kind, ledger, items database, manifest, 07-01 to 09-20, three passes; for the new system the comparison limits, astra-frozen and the judge
     7	to 09-20). The six draws pass together when:
     8	- they were launched within one hour of each other (a draw's launch: its first component's first attempt);
     9	- every attempt the draw's ledger records (`<ledger>.attempts.jsonl`, failed sends included) and every model call stored anywhere in the
    10	  draw falls within 72 hours of the first launch.
    11	The output records, per draw, the launch, the last call, and the sha256 of the views and archive files the reading reads
    12	(`mapping.store_paths`); `mapping.py export` refuses without a passing output and records the same fingerprints, and the scorer refuses
    13	readings that do not carry them.
    14	"""
    15	import datetime
    16	import hashlib
    17	import json
    18	import sqlite3
    19	import sys
    20	from pathlib import Path
    21	
    22	sys.path.insert(0, str(Path(__file__).resolve().parent))
    23	import mapping  # noqa: E402
    24	
    25	DATA = Path('/Users/lchingen/hivemind/poc/data/comparison-2026-11-17')
    26	LAUNCH_WINDOW = datetime.timedelta(hours=1)
    27	SEND_WINDOW = datetime.timedelta(hours=72)
    28	
    29	
    30	def local(stamp):
    31	    """A naive local time from either stored form: '2026-11-17T22:05:13-0800' (launcher) or '2026-11-17T22:06:16' (archives)."""
    32	    try:
    33	        return datetime.datetime.strptime(stamp, '%Y-%m-%dT%H:%M:%S%z').astimezone().replace(tzinfo=None)
    34	    except ValueError:
    35	        return datetime.datetime.strptime(stamp[:19], '%Y-%m-%dT%H:%M:%S')
    36	
    37	
    38	def sha256(path):
    39	    digest = hashlib.sha256()
    40	    with open(path, 'rb') as handle:
    41	        for block in iter(lambda: handle.read(1 << 20), b''):
    42	            digest.update(block)
    43	    return digest.hexdigest()
    44	
    45	
    46	def last_call(draw_folder):
    47	    """The latest model call stored in any database under the draw's folder, and how many databases hold calls."""
    48	    latest, databases = None, 0
    49	    for path in sorted(Path(draw_folder).rglob('*.sqlite')):
    50	        conn = sqlite3.connect(f'file:{path}?mode=ro&immutable=1', uri=True)
    51	        if not conn.execute("select 1 from sqlite_master where type='table' and name='model_calls'").fetchone():
    52	            continue
    53	        databases += 1
    54	        stamp = conn.execute('select max(created_at) from model_calls').fetchone()[0]
    55	        if stamp and (latest is None or local(stamp) > latest):
    56	            latest = local(stamp)
    57	    return latest, databases
    58	
    59	
    60	def expected_identity(run_root, draw):
    61	    """The identity launch_comparison.py registers for a counted draw (plan §2; D667)."""
    62	    options = {'until_day': '2026-09-20', 'passes': 3, 'from_day': '2026-07-01', 'manifest': str(DATA / 'manifest-2026-07-01-09-20.json'),
    63	               'items': str(DATA / 'items-comparison.sqlite')}
    64	    if draw.startswith('new'):
    65	        options.update(limits=str(DATA / 'comparison-limits.json'), ladder_variant='astra-frozen', judge_end_day='2026-09-20')
    66	    return {'kind': 'clean' if draw.startswith('new') else 'prod', 'label': draw, 'ledger': str(Path(run_root) / 'ledgers' / f'{draw}.json'),
    67	            'options': options}
