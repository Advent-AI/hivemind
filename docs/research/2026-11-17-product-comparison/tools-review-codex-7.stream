   293	def days_to_opening(readings):
   294	    """Per draw and covered matter: days from the matter's earliest listed article to the first covering question's opening. A question
   295	    opened before the scored window (09-07) is 'opened in the warm-up'; one opened in the window before the matter's first listed article
   296	    is 'opened before the first listed article'."""
   297	    import datetime
   298	    out = {}
   299	    for draw, by_matter in readings['mapping'].items():
   300	        for matter, questions in by_matter.items():
   301	            opened = [readings['cards'][draw][q['question']].get('opened') for q in questions if q['covers'] is True]
   302	            opened = [d for d in opened if d]
   303	            first = readings.get('matter_first_day', {}).get(matter)
   304	            if not opened or not first:
   305	                continue
   306	            days = (datetime.date.fromisoformat(min(opened)) - datetime.date.fromisoformat(first)).days
   307	            out.setdefault(matter, {})[draw] = (days if days >= 0 else 'opened in the warm-up' if min(opened) < '2026-09-07'
   308	                                                else 'opened before the first listed article')
   309	    return out
