   265	def insufficient_count(readings, system, fav):
   266	    """Latest answers resolved to insufficient among the system's guardrail-share cards (outside the decided denominators)."""
   267	    count = 0
   268	    for draw, cards in readings['cards'].items():
   269	        if system_of(draw) != system:
   270	            continue
   271	        for card in cards.values():
   272	            covering = card['covering'] if card['covering'] != 'split' else fav
   273	            if card['guardrail'] and not covering and card['answer'] != 'no answer' and resolve(card['answer'], 'answer', fav) == 'insufficient':
   274	                count += 1
