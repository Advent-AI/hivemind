   278	def trivia_count(readings, system, fav):
   279	    """Trivia marks (duplicates apart) among the decided worth marks of the system's guardrail shares' cards."""
   280	    trivia = decided = 0
   281	    for draw, cards in readings['cards'].items():
   282	        if system_of(draw) != system:
   283	            continue
   284	        for card in cards.values():
   285	            covering = card['covering'] if card['covering'] != 'split' else fav
   286	            if not card['guardrail'] or covering:
