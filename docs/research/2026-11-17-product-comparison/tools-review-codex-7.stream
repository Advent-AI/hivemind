   189	def sign_test(a, b):
   190	    """Two-sided exact binomial p of a against b at one half, and the Wilson 95% interval of a / (a + b): illustrative only."""
   191	    n = a + b
   192	    if n == 0:
   193	        return {'discordant': 0, 'p': None, 'share': None, 'wilson95': None}
   194	    tail = sum(math.comb(n, k) for k in range(0, min(a, b) + 1)) / 2 ** n
   195	    z, phat = 1.959963984540054, a / n
   196	    centre = (phat + z * z / (2 * n)) / (1 + z * z / n)
   197	    half = z * math.sqrt(phat * (1 - phat) / n + z * z / (4 * n * n)) / (1 + z * z / n)
   198	    return {'discordant': n, 'p': min(1.0, 2 * tail), 'share': round(phat, 3), 'wilson95': [round(centre - half, 3), round(centre + half, 3)]}
   199	
