   205	    out = {'D428 limits (a comparison on the guardrail sample, not Stage B\'s measurement)': {}, 'sign test (illustrative)': {},
   206	           'floors (proposed)': {}}
   207	    for c, v in per_counting.items():
   208	        a, b = v['a'], v['b']
   209	        out['sign test (illustrative)'][c] = sign_test(a, b)
   210	        fav_system = 'new' if c == '1' else 'old'
   211	        limits, floors = {}, {}
   212	        for system in SYSTEMS:
   213	            g = {k: v['guardrails'][k][system] for k in ('figure', 'yes/no', 'worth')}
   214	            fig, yn = g['figure'], g['yes/no']
   215	            latest_bad, latest_decided = fig['bad'] + yn['bad'], fig['decided'] + yn['decided']
   216	            limits[system] = {
   217	                'figure unsupported': f"{fig['bad']}/{fig['decided']} against 12.7%-14.4%" if fig['decided'] else 'none decided',
   218	                'yes/no unsupported': f"{yn['bad']}/{yn['decided']} against 5%" if yn['decided'] else 'none decided',
   219	                'latest answers unsupported': f"{latest_bad}/{latest_decided} against {float(D428_LATEST * latest_decided):.1f} (3 in 30 scaled)"
   220	                                              if latest_decided else 'none decided',
   221	                'latest answers insufficient (beside)': insufficient_count(readings, system, system == fav_system)}
   222	            floors[system] = floors_per_draw(readings, system, system == fav_system)
   223	        out['D428 limits (a comparison on the guardrail sample, not Stage B\'s measurement)'][c] = limits
   224	        out['floors (proposed)'][c] = floors
   225	    out['days from first article to opening'] = days_to_opening(readings)
