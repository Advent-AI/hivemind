   119	def beside(readings, per_counting):
   120	    """What the rule prints beside the verdict (verdict-rule.json `printed_beside`, `guardrails.beside`)."""
   121	    figure = {m['matter'] for m in readings['matters'] if m['company_figure']}
   122	    out = {'company-figure subgroup': {c: {'N': len(figure), 'a': len((set(v['served_new']) - set(v['served_old'])) & figure),
   123	                                            'b': len((set(v['served_old']) - set(v['served_new'])) & figure)} for c, v in per_counting.items()}}
   124	    counts = {}
   125	    for draw, cards in readings['cards'].items():
   126	        system = system_of(draw)
   127	        c = counts.setdefault(system, {'insufficient': 0, 'no answer': 0, 'split worth': 0, 'split answer': 0, 'cards': 0})
   128	        for card in cards.values():
   129	            c['cards'] += 1
   130	            c['insufficient'] += card['answer'] == 'insufficient'
   131	            c['no answer'] += card['answer'] == 'no answer'
   132	            c['split worth'] += is_split(card['worth'])
   133	            c['split answer'] += is_split(card['answer'])
   134	    out['marks'] = counts
   135	    resolutions = {}
   136	    for c in per_counting:
   137	        favoured = 'new' if c == '1' else 'old'
   138	        tally = {}
   139	        for draw, cards in readings['cards'].items():
   140	            fav = system_of(draw) == favoured
   141	            for card in cards.values():
   142	                for kind in ('worth', 'answer'):
   143	                    if is_split(card[kind]):
   144	                        key = f'{system_of(draw)} {kind} split resolved to {resolve(card[kind], kind, fav)}'
   145	                        tally[key] = tally.get(key, 0) + 1
   146	        for draw, by_matter in readings['mapping'].items():
   147	            fav = system_of(draw) == favoured
   148	            for matter, questions in by_matter.items():
   149	                for q in questions:
   150	                    if q['covers'] == 'split':                       # every split matter-question pair, as the counting resolves it
   151	                        key = f"{system_of(draw)} cover split resolved to {'covers' if fav else 'does not cover'}"
   152	                        tally[key] = tally.get(key, 0) + 1
   153	        resolutions[c] = tally
   154	    out['split resolutions'] = resolutions
   155	    return out
