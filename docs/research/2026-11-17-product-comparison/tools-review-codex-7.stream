   312	def verdict(readings):
   313	    present = {k: sorted(readings[k]) for k in ('mapping', 'cards', 'distinct')}
   314	    for k, draws in present.items():
   315	        if sorted(DRAWS) != draws:
   316	            raise SystemExit(f'refused: readings[{k!r}] holds {draws}, not the six draws {list(DRAWS)}')
   317	    verify_inputs(readings)
   318	    n = len(readings['matters'])
   319	    controls = readings['controls']
   320	    report = {'N': n}
   321	    invalid = []
   322	    def rejected(m):
   323	        return m in REJECTED or (isinstance(m, dict) and 'split' in m and all(x in REJECTED for x in m['split']))
   324	    if any(not rejected(m) for m in controls['plants']):
   325	        invalid.append('a planted wrong answer without an explicit rejection')
   326	    if sum(m == 'supported' for m in controls['supported']) < 3:
   327	        invalid.append('fewer than 3 of 4 supported controls accepted')
   328	    if sum(bool(x) for x in controls['repeats_same']) < 2:
   329	        invalid.append('fewer than 2 of 3 repeats marked the same')
   330	    if len(controls['plants']) != 6 or len(controls['supported']) != 4 or len(controls['repeats_same']) != 3:
   331	        invalid.append('the deck does not hold 6 plants, 4 supported controls and 3 repeats')
   332	    if invalid:
   333	        return dict(report, verdict='invalid', why=invalid)
   334	    small = []
   335	    if n < 20:
   336	        small.append(f'N = {n} < 20')
   337	    for draw, d in readings['distinct'].items():
   338	        both_ways = (d['ids'] - d['duplicates_both'], d['ids'] - d['duplicates_both'] - d['duplicates_split'])
   339	        if min(both_ways) < 30:
   340	            small.append(f'{draw}: {both_ways} distinct bets')
   341	    if small:
   342	        return dict(report, verdict='too small', why=small)
   343	    margin = max(3, math.ceil(0.15 * n))
   344	    per_counting = {}
   345	    for counting in ('1', '2'):
   346	        served = served_by(readings, counting)
   347	        a = len(served['new'] - served['old'])
   348	        b = len(served['old'] - served['new'])
   349	        per_counting[counting] = {'a': a, 'b': b, 'served_new': sorted(served['new']), 'served_old': sorted(served['old']),
   350	                                  'guardrails': guardrails(readings, counting)}
   351	    report['margin'] = margin
   352	    report['countings'] = per_counting
   353	    report['beside'] = beside(readings, per_counting)
   354	    report['beside'].update(printed_beside(readings, per_counting))
   355	    lead = all(c['a'] - c['b'] >= margin and c['a'] >= 2 * c['b'] for c in per_counting.values())
   356	    all_exercised_pass = all(g['exercised'] and not g['breach'] for c in per_counting.values() for g in c['guardrails'].values())
   357	    if lead and all_exercised_pass:
   358	        return dict(report, verdict='practical lead')
   359	    loss_count = all(c['b'] - c['a'] >= margin and c['b'] >= 2 * c['a'] for c in per_counting.values())
   360	    breaches = {k for k in ('figure', 'yes/no', 'worth') if all(c['guardrails'][k]['breach'] for c in per_counting.values())}
   361	    if loss_count or breaches:
   362	        return dict(report, verdict='practical loss', why=(['served matters'] if loss_count else []) + [f'guardrail {k}' for k in sorted(breaches)])
   363	    return dict(report, verdict='no practical winner')
