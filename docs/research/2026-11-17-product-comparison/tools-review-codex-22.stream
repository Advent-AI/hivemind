import builtins, contextlib, sys
import rebuild, score_comparison as scorer

def assert_exit(entry, exc, label):
    before=sys.path.copy()
    try:
        entry()
    except exc:
        pass
    else:
        raise AssertionError(\"expected failure did not occur\")
    assert sys.path==before
    print(label, \"restored sys.path\")

def assert_import_failure(entry, fail_on):
    original_import=builtins.__import__
    def fail_import(name, *args, **kwargs):
        if name == fail_on:
            sys.path.append(\"/synthetic/import-in-progress\")
            raise ImportError(\"injected first import failure\")
        return original_import(name, *args, **kwargs)
    builtins.__import__=fail_import
    try:
        assert_exit(entry, ImportError, fail_on + \" import failure\")
    finally:
        builtins.__import__=original_import

scorer_call=lambda:scorer.score(\"/synthetic/run\",\"/synthetic/map\",\"/synthetic/deck\")
rebuild_call=lambda:rebuild.scored(\"/synthetic/run\",\"/synthetic/map\",\"/synthetic/deck\",\"/synthetic/keys\",lambda r:r)
assert_import_failure(scorer_call,\"mapping\")
assert_import_failure(rebuild_call,\"census_readers\")
rebuild.tempfile.TemporaryDirectory=lambda:contextlib.nullcontext(\"/in-memory\")
class MemoryPath:
    def __init__(self,path): self.path=str(path)
    def __truediv__(self,part): return MemoryPath(self.path+\"/\"+part)
    def read_text(self): raise FileNotFoundError(self.path)
rebuild.Path=MemoryPath
assert_exit(scorer_call, FileNotFoundError, \"Cold scoring with a missing confirmation record\")
assert_exit(rebuild_call, FileNotFoundError, \"Direct rebuild with a missing confirmation record\")
