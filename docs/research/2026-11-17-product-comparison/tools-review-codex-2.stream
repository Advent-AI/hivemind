    96	
    97	def deck(mapping_out, folder):
    98	    folder = Path(folder)
    99	    folder.mkdir(parents=True, exist_ok=False)
   100	    libs = libraries(mapping_out)
   101	    mapping = json.loads((Path(mapping_out) / 'mapping.json').read_text())['mapping']
   102	    cards, rng = [], random.Random(SEED)
   103	    for draw in sorted(libs):
   104	        lib = libs[draw]
   105	        by_id = {e['question_id']: e for e in lib}
   106	        covering = {q['question'] for qs in mapping.get(draw, {}).values() for q in qs}
   107	        neutral = {e['source_id']: e['question_id'] for e in lib}
   108	        ids = sorted(neutral)
   109	        guard = {neutral[i] for i in (ids if len(ids) <= 35 else random.Random(SEED).sample(ids, 35))}
   110	        for qid in sorted(covering | guard):
   111	            e = by_id[qid]
   112	            cards.append({'draw': draw, 'question': qid, 'role': 'product', 'guardrail': qid in guard, 'covering': qid in covering,
   113	                          'type': e.get('type'), 'answered': e['answer'] is not None, 'text': build_cards.card_text(e, lib)})
   114	    controls = []
   115	    for system in ('new', 'old'):
   116	        pool = []
   117	        for c in cards:
   118	            if c['draw'].startswith(system) and c['answered']:
   119	                planted = plant(c['text'], {e['question_id']: e for e in libs[c['draw']]}[c['question']])
   120	                if planted is not None:
   121	                    pool.append(dict(c, role='plant', text=planted))
   122	        if len(pool) < 3:
   123	            raise SystemExit(f'{system}: only {len(pool)} answered cards with a different adjacent rung to plant')
   124	        controls += random.Random(SEED + 1).sample(pool, 3)
   125	    candidates = random.Random(SEED + 2).sample([c for c in cards if c['answered']], min(12, sum(c['answered'] for c in cards)))
   126	    confirmed, confirmations = [], []
   127	    for c in candidates:
   128	        if len(confirmed) == 4:
   129	            break
   130	        answer, void = census_readers.run('claude', CONFIRM.format(card=c['text']))
   131	        rows = json_lines(answer) if answer else []
   132	        confirmations.append({'draw': c['draw'], 'question': c['question'], 'answer': rows[-1] if rows else None, 'void': void})
   133	        if rows and rows[-1].get('supported') is True and not void:
   134	            confirmed.append(dict(c, role='supported control'))
   135	    KEY.parent.mkdir(parents=True, exist_ok=True)
   136	    (KEY.parent / 'supported-confirmations.json').write_text(json.dumps(confirmations, indent=1, ensure_ascii=False) + '\n')
   137	    if len(confirmed) < 4:
   138	        raise SystemExit(f'only {len(confirmed)} supported controls confirmed of {len(candidates)} candidates')
   139	    controls += confirmed
   140	    for c in random.Random(SEED + 3).sample(cards, 3):
   141	        controls.append(dict(c, role='repeat'))
   142	    full = cards + controls
   143	    random.Random(SEED).shuffle(full)
   144	    key = {}
   145	    for n, c in enumerate(full, 1):
   146	        cid = f'C{n:03d}'
   147	        key[cid] = {k: c[k] for k in ('draw', 'question', 'role', 'guardrail', 'covering', 'type', 'answered')}
   148	        (folder / f'{cid}.txt').write_text(c['text'])
   149	    KEY.parent.mkdir(parents=True, exist_ok=True)
   150	    KEY.write_text(json.dumps(key, indent=1) + '\n')
   151	    print(f'{len(full)} cards: {len(cards)} product, {len(controls)} controls; key in {KEY}')
