    99	def store_paths(run_root, draw):
   100	    """The draw's store at its cutoff: refused unless the draw is complete (plan §1.4 item 10). The new system's judge folder is the one its
   101	    own record names as the completed attempt (`draw-<draw>` or, after D449's one redo, `draw-<draw>-redo`). None when the draw opened no
   102	    question (the launcher's `skipped` judge)."""
   103	    root = Path(run_root) / draw
   104	    record = json.loads((root / 'run.json').read_text())
   105	    if record.get('state') != 'complete':
   106	        raise SystemExit(f'refused: {draw} is {record.get("state")!r}, not complete; no release verdict without six complete draws')
   107	    if draw.startswith('new'):
   108	        judge = record['components']['judge']
   109	        if judge['state'] == 'skipped':
   110	            return None
   111	        inner = json.loads((root / judge['folder'] / 'run.json').read_text())[draw]
   112	        if inner.get('state') != 'complete':
   113	            raise SystemExit(f'refused: {draw} judge is {inner.get("state")!r}')
   114	        folder = root / judge['folder'] / inner['attempts'][-1]['folder']
   115	    else:
   116	        folder = root / record['components']['prod']['folder']
   117	    return folder / 'views.sqlite', folder / 'archive.sqlite'
   118	
