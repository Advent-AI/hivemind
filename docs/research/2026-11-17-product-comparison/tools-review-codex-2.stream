   136	        if unknown:
   137	            return f"{r['matter']}: ids not in the library {unknown}"
   138	    for r in rows:
   139	        if r.get('duplicate') is not None:
   140	            pair = {str(r['duplicate']), str(r.get('of'))}
   141	            if len(pair) != 2 or not pair <= ids:
   142	                return f"duplicate pair not two library ids: {r}"
   143	    return None
