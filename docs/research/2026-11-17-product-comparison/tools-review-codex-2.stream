   118	    (HERE / 'prompts.sha256').write_text(''.join(f'{h}  prompts/{n}.md\n' for n, h in hashes.items()))
   119	    print(f'{len(rows)} articles in {len(batches)} batches: {[len(b) for b in batches]}; standard §3–§4 {len(standard)} characters')
