    34	    codex = [{'matter': 'M01', 'status': 'opened', 'ids': ['v1']}, {'matter': 'M02', 'status': 'narrower', 'ids': ['v2'], 'main_outcome': False}]
    35	    claude = [{'matter': 'M01', 'status': 'narrower', 'ids': ['v1'], 'main_outcome': True}, {'matter': 'M02', 'status': 'narrower', 'ids': ['v2'], 'main_outcome': False}]
    36	    result = run_mapping(tmp_path, monkeypatch, codex, claude)
    37	    assert result['mapping']['new-1'] == {'M01': [{'question': 'v1', 'covers': True}]}
