   154	def valid(row, answered):
   155	    if not isinstance(row, dict) or row.get('worth') not in WORTH:
   156	        return False
   157	    return (row.get('answer') in ANSWER) if answered else row.get('answer') in (None, 'null')
   158	
   159	
   160	def run_marks(folder, label, prompts):
   161	    """Writes every owed mark of the round; the round is complete (`<label>.done`) only when none is void."""
   162	    folder = Path(folder)
   163	    key = json.loads(KEY.read_text())
   164	    jobs = [(cid, family, prompt) for (cid, family), prompt in prompts.items() if not (folder / label / f'{cid}-{family}.json').exists()]
   165	
   166	    def one(job):
   167	        cid, family, prompt = job
   168	        for attempt in (1, 2):
   169	            answer, void = census_readers.run(family, prompt)
   170	            rows = json_lines(answer) if answer else []
   171	            if rows and valid(rows[-1], key[cid]['answered']) and not void:
   172	                (folder / label).mkdir(exist_ok=True)
   173	                (folder / label / f'{cid}-{family}.json').write_text(json.dumps(rows[-1], ensure_ascii=False) + '\n')
   174	                return cid, family, None
   175	            void = void or 'invalid mark'
   176	        return cid, family, void
   177	    with concurrent.futures.ThreadPoolExecutor(max_workers=6) as pool:
   178	        for cid, family, void in pool.map(one, jobs):
   179	            if void:
   180	                print(cid, family, 'VOID', void, flush=True)
   181	    owed = [(cid, family) for (cid, family) in prompts if not (folder / label / f'{cid}-{family}.json').exists()]
   182	    if owed:
   183	        print(label, 'NOT complete:', len(owed), 'marks owed; run the round again', flush=True)
   184	        return
   185	    (folder / f'{label}.done').write_text(f'{len(prompts)} marks\n')
   186	    print(label, 'complete', flush=True)
   187	
   188	
   189	def mark(folder):
   190	    folder = Path(folder)
   191	    prompts = {(p.stem, f): BRIEF.format(card=p.read_text()) for p in sorted(folder.glob('C*.txt')) for f in FAMILIES}
   192	    run_marks(folder, 'round-0', prompts)
   193	
   194	
   195	def current(folder, cid, family, upto):
   196	    """The family's latest mark on the card from rounds 0..upto (a debate round never reads its own round)."""
   197	    for n in range(upto, -1, -1):
   198	        p = Path(folder) / f'round-{n}' / f'{cid}-{family}.json'
   199	        if p.exists():
   200	            return json.loads(p.read_text())
   201	    return None
   202	
   203	
   204	def differs(a, b):
   205	    return a is not None and b is not None and (a['worth'] != b['worth'] or a.get('answer') != b.get('answer'))
   206	
   207	
   208	def debate(folder, round_number):
   209	    folder = Path(folder)
   210	    if not (folder / f'round-{round_number - 1}.done').exists():
   211	        raise SystemExit(f'refused: round {round_number - 1} is not complete')
   212	    prompts = {}
   213	    for p in sorted(folder.glob('C*.txt')):
   214	        a, b = current(folder, p.stem, 'codex', round_number - 1), current(folder, p.stem, 'claude', round_number - 1)
   215	        if differs(a, b):
   216	            for family, own, other in (('codex', a, b), ('claude', b, a)):
   217	                prompts[(p.stem, family)] = BRIEF.format(card=p.read_text()) + DEBATE.format(
   218	                    own=json.dumps(own, ensure_ascii=False), other=json.dumps(other, ensure_ascii=False))
   219	    print(len(prompts) // 2, 'cards in debate round', round_number)
   220	    run_marks(folder, f'round-{round_number}', prompts)
   221	
   222	
   223	def final(folder, cid):
   224	    a, b = current(folder, cid, 'codex', 2), current(folder, cid, 'claude', 2)
   225	    if a is None or b is None:
   226	        raise SystemExit(f'{cid}: a family has no valid mark')
   227	    out = {}
   228	    for field in ('worth', 'answer'):
   229	        out[field] = a.get(field) if a.get(field) == b.get(field) else {'split': [a.get(field), b.get(field)]}
   230	    return out
   231	
   232	
   233	def readings(mapping_out, folder):
   234	    folder = Path(folder)
   235	    for n in (0, 1, 2):
   236	        if not (folder / f'round-{n}.done').exists():
   237	            raise SystemExit(f'refused: round {n} is not complete')
   238	    key = json.loads(KEY.read_text())
   239	    matters = [{'matter': m['matter'], 'company_figure': m['company_figure']} for m in json.loads(mapping_tool.MATTERS.read_text())['matters']]
   240	    mapped = json.loads((Path(mapping_out) / 'mapping.json').read_text())
   241	    cards, plants, supported, repeats = {}, [], [], []
   242	    by_question = {}
   243	    for cid, k in sorted(key.items()):
   244	        f = final(folder, cid)
   245	        answer = f['answer'] if k['answered'] else 'no answer'
   246	        if k['role'] == 'product':
   247	            cards.setdefault(k['draw'], {})[k['question']] = {'worth': f['worth'], 'answer': answer, 'type': k['type'], 'guardrail': k['guardrail'],
   248	                                                              'covering': k['covering']}
   249	            by_question[(k['draw'], k['question'])] = (f['worth'], answer)
   250	        elif k['role'] == 'plant':
   251	            plants.append(answer)
   252	        elif k['role'] == 'supported control':
   253	            supported.append(answer)
   254	    for cid, k in sorted(key.items()):
   255	        if k['role'] == 'repeat':
   256	            f = final(folder, cid)
   257	            answer = f['answer'] if k['answered'] else 'no answer'
   258	            repeats.append((f['worth'], answer) == by_question[(k['draw'], k['question'])])
   259	    out = {'matters': matters, 'mapping': mapped['mapping'], 'distinct': mapped['distinct'], 'cards': cards,
   260	           'controls': {'plants': plants, 'supported': supported, 'repeats_same': repeats}}
   261	    (folder / 'readings.json').write_text(json.dumps(out, indent=1, ensure_ascii=False) + '\n')
   262	    print('readings.json written')
   263	
   264	
   265	if __name__ == '__main__':
   266	    command = sys.argv[1]
   267	    if command == 'deck':
   268	        deck(sys.argv[2], sys.argv[3])
   269	    elif command == 'debate':
   270	        debate(sys.argv[2], int(sys.argv[3]))
   271	    elif command == 'readings':
   272	        readings(sys.argv[2], sys.argv[3])
   273	    else:
   274	        mark(sys.argv[2])
     1	"""The comparison's verdict (D665; `verdict-rule.json`, frozen before the first send; D672). Code applies the frozen rule to the readers'
     2	marks; it decides nothing the rule leaves open.
     3	
     4	    python3 score_comparison.py <readings.json>
     5	
     6	`readings.json` holds what the reading produces, by system-draw ('new-1'..'new-3', 'old-1'..'old-3'):
     7	  matters:      [{"matter": "M01", "company_figure": bool}, ...]                       (stage0/census/matters.json)
     8	  mapping:      {draw: {matter: [{"question": id, "covers": true|false|"split"}]}}     (blind mapping, third readers applied)
     9	  cards:        {draw: {question id: {"worth": mark, "answer": mark, "type": "figure"|"yes/no"|"other", "guardrail": bool, "covering": bool}}}
    10	                a mark is a final mark, or {"split": [mark given by one family, mark given by the other]}
    11	  distinct:     {draw: {"ids": n, "duplicates_both": n, "duplicates_split": n}}
    12	  controls:     {"plants": [mark, ...], "supported": [mark, ...], "repeats_same": [bool, ...]}
    13	Prints the verdict and every quantity behind it, under both countings.
    14	
    15	Readings of the frozen rule written here (D675): the guardrail shares hold the random sample's cards that cover no matter, as the rule's
    16	words say ("covering cards are not in the shares"); the 10-point bar is compared exactly, as fractions; a plant counts as explicitly rejected
    17	when every mark its readers left is unsupported or insufficient, split between the two or not. No verdict without all six draws.
    18	"""
    19	import json
    20	import math
    21	import sys
    22	from fractions import Fraction
    23	
    24	DRAWS = ('new-1', 'new-2', 'new-3', 'old-1', 'old-2', 'old-3')
    25	REJECTED = ('unsupported', 'insufficient')
    26	
    27	RANK = {'answer': ['unsupported', 'insufficient', 'supported'], 'worth': ['trivia', 'duplicate', 'worth'], 'covers': [False, True]}
    28	SYSTEMS = ('new', 'old')
    29	
    30	
    31	def resolve(mark, kind, favoured):
    32	    """A final mark, or a split resolved to one of the marks its readers gave: the most favourable for a favoured system, the least for the
    33	    other (verdict-rule.json, countings). 'no answer' is never split."""
    34	    if not (isinstance(mark, dict) and 'split' in mark):
    35	        return mark
    36	    given = [m for m in mark['split'] if m in RANK[kind]]
    37	    if not given:
    38	        raise ValueError(f'a split of unknown marks: {mark}')
    39	    order = sorted(given, key=RANK[kind].index)
    40	    return order[-1] if favoured else order[0]
    41	
    42	
    43	def is_split(mark):
    44	    return isinstance(mark, dict) and 'split' in mark
    45	
    46	
    47	def system_of(draw):
    48	    return draw.split('-')[0]
    49	
    50	
    51	def served_by(readings, counting):
    52	    """{system: set of matters served in at least 2 of its 3 draws} under one counting ('1': new favoured, '2': old favoured)."""
    53	    favoured = 'new' if counting == '1' else 'old'
    54	    served_draws = {}
    55	    for draw, by_matter in readings['mapping'].items():
    56	        system = system_of(draw)
    57	        fav = system == favoured
    58	        for matter, questions in by_matter.items():
    59	            for q in questions:
    60	                covers = q['covers'] if q['covers'] != 'split' else fav       # covers > does not cover
    61	                if not covers:
    62	                    continue
    63	                card = readings['cards'][draw].get(q['question'])
    64	                if card is None:
    65	                    raise ValueError(f'{draw} {q["question"]}: a covering question has no card')
    66	                if card['answer'] == 'no answer':
    67	                    continue
    68	                if resolve(card['worth'], 'worth', fav) == 'worth' and resolve(card['answer'], 'answer', fav) == 'supported':
    69	                    served_draws.setdefault((system, matter), set()).add(draw)
    70	                    break
    71	    return {s: {m for (sys_, m), draws in served_draws.items() if sys_ == s and len(draws) >= 2} for s in SYSTEMS}
    72	
    73	
    74	def guardrails(readings, counting):
    75	    """Per system: the three shares over its pooled guardrail cards, and whether each subgroup is exercised (10 unsplit decided cards)."""
    76	    favoured = 'new' if counting == '1' else 'old'
    77	    out = {}
    78	    for system in SYSTEMS:
    79	        fav = system == favoured
    80	        counts = {'figure': [0, 0, 0], 'yes/no': [0, 0, 0], 'worth': [0, 0, 0]}     # [bad, decided, decided without a split]
    81	        for draw, cards in readings['cards'].items():
    82	            if system_of(draw) != system:
    83	                continue
    84	            for card in cards.values():
    85	                if not card['guardrail'] or card['covering']:
    86	                    continue
    87	                if card['type'] in ('figure', 'yes/no') and card['answer'] != 'no answer':
    88	                    answer = resolve(card['answer'], 'answer', fav)
    89	                    if answer in ('supported', 'unsupported'):
    90	                        c = counts[card['type']]
    91	                        c[0] += answer == 'unsupported'
    92	                        c[1] += 1
    93	                        c[2] += not is_split(card['answer'])
    94	                worth = resolve(card['worth'], 'worth', fav)
    95	                c = counts['worth']
    96	                c[0] += worth in ('trivia', 'duplicate')
    97	                c[1] += 1
    98	                c[2] += not is_split(card['worth'])
    99	        out[system] = {k: {'share': Fraction(v[0], v[1]) if v[1] else None, 'bad': v[0], 'decided': v[1], 'unsplit': v[2]} for k, v in counts.items()}
   100	    result = {}
   101	    for k in ('figure', 'yes/no', 'worth'):
   102	        new, old = out['new'][k], out['old'][k]
   103	        exercised = new['unsplit'] >= 10 and old['unsplit'] >= 10
   104	        breach = exercised and (new['share'] - old['share']) > Fraction(1, 10)
   105	        result[k] = {'new': new, 'old': old, 'exercised': exercised, 'breach': breach}
   106	    return result
   107	
   108	
   109	def beside(readings, per_counting):
   110	    """What the rule prints beside the verdict (verdict-rule.json `printed_beside`, `guardrails.beside`)."""
   111	    figure = {m['matter'] for m in readings['matters'] if m['company_figure']}
   112	    out = {'company-figure subgroup': {c: {'N': len(figure), 'a': len((set(v['served_new']) - set(v['served_old'])) & figure),
   113	                                            'b': len((set(v['served_old']) - set(v['served_new'])) & figure)} for c, v in per_counting.items()}}
   114	    counts = {}
   115	    for draw, cards in readings['cards'].items():
   116	        system = system_of(draw)
   117	        c = counts.setdefault(system, {'insufficient': 0, 'no answer': 0, 'split worth': 0, 'split answer': 0, 'cards': 0})
   118	        for card in cards.values():
   119	            c['cards'] += 1
   120	            c['insufficient'] += card['answer'] == 'insufficient'
   121	            c['no answer'] += card['answer'] == 'no answer'
   122	            c['split worth'] += is_split(card['worth'])
   123	            c['split answer'] += is_split(card['answer'])
   124	    out['marks'] = counts
   125	    return out
   126	
   127	
   128	def verdict(readings):
   129	    present = {k: sorted(readings[k]) for k in ('mapping', 'cards', 'distinct')}
   130	    for k, draws in present.items():
   131	        if sorted(DRAWS) != draws:
   132	            raise SystemExit(f'refused: readings[{k!r}] holds {draws}, not the six draws {list(DRAWS)}')
   133	    n = len(readings['matters'])
   134	    controls = readings['controls']
   135	    report = {'N': n}
   136	    invalid = []
   137	    def rejected(m):
   138	        return m in REJECTED or (isinstance(m, dict) and 'split' in m and all(x in REJECTED for x in m['split']))
   139	    if any(not rejected(m) for m in controls['plants']):
   140	        invalid.append('a planted wrong answer without an explicit rejection')
   141	    if sum(m == 'supported' for m in controls['supported']) < 3:
   142	        invalid.append('fewer than 3 of 4 supported controls accepted')
   143	    if sum(bool(x) for x in controls['repeats_same']) < 2:
   144	        invalid.append('fewer than 2 of 3 repeats marked the same')
   145	    if len(controls['plants']) != 6 or len(controls['supported']) != 4 or len(controls['repeats_same']) != 3:
   146	        invalid.append('the deck does not hold 6 plants, 4 supported controls and 3 repeats')
   147	    if invalid:
   148	        return dict(report, verdict='invalid', why=invalid)
   149	    small = []
   150	    if n < 20:
   151	        small.append(f'N = {n} < 20')
   152	    for draw, d in readings['distinct'].items():
   153	        both_ways = (d['ids'] - d['duplicates_both'], d['ids'] - d['duplicates_both'] - d['duplicates_split'])
   154	        if min(both_ways) < 30:
   155	            small.append(f'{draw}: {both_ways} distinct bets')
   156	    if small:
   157	        return dict(report, verdict='too small', why=small)
   158	    margin = max(3, math.ceil(0.15 * n))
   159	    per_counting = {}
   160	    for counting in ('1', '2'):
   161	        served = served_by(readings, counting)
   162	        a = len(served['new'] - served['old'])
   163	        b = len(served['old'] - served['new'])
   164	        per_counting[counting] = {'a': a, 'b': b, 'served_new': sorted(served['new']), 'served_old': sorted(served['old']),
   165	                                  'guardrails': guardrails(readings, counting)}
   166	    report['margin'] = margin
   167	    report['countings'] = per_counting
   168	    report['beside'] = beside(readings, per_counting)
   169	    lead = all(c['a'] - c['b'] >= margin and c['a'] >= 2 * c['b'] for c in per_counting.values())
   170	    all_exercised_pass = all(g['exercised'] and not g['breach'] for c in per_counting.values() for g in c['guardrails'].values())
   171	    if lead and all_exercised_pass:
   172	        return dict(report, verdict='practical lead')
   173	    loss_count = all(c['b'] - c['a'] >= margin and c['b'] >= 2 * c['a'] for c in per_counting.values())
   174	    breaches = {k for k in ('figure', 'yes/no', 'worth') if all(c['guardrails'][k]['breach'] for c in per_counting.values())}
   175	    if loss_count or breaches:
   176	        return dict(report, verdict='practical loss', why=(['served matters'] if loss_count else []) + [f'guardrail {k}' for k in sorted(breaches)])
   177	    return dict(report, verdict='no practical winner')
   178	
   179	
   180	if __name__ == '__main__':
   181	    print(json.dumps(verdict(json.loads(open(sys.argv[1]).read())), indent=1, ensure_ascii=False, default=str))

