   146	def export(run_root, out):
   147	    out = Path(out)
   148	    out.mkdir(parents=True, exist_ok=False)
   149	    labels = [f'L{n}' for n in range(1, len(DRAWS) + 1)]
   150	    random.Random(20261117).shuffle(labels)
   151	    key = dict(zip(DRAWS, labels))
   152	    KEY_FOLDER.mkdir(parents=True, exist_ok=True)
   153	    (KEY_FOLDER / 'mapping-key.json').write_text(json.dumps(key, indent=1) + '\n')
   154	    for draw, label in key.items():
   155	        paths = store_paths(run_root, draw)
   156	        lib = neutral_ids(build_cards.library(*paths, ITEMS)) if paths else []
   157	        (out / f'library-{label}.json').write_text(json.dumps(lib, indent=1, ensure_ascii=False) + '\n')
   158	    print('exported', len(key), 'libraries; key in', KEY_FOLDER / 'mapping-key.json')
   159	
   160	
   161	def read(out):
   162	    out = Path(out)
   163	    text, keys = matters_text()
   164	    jobs = []
   165	    for path in sorted(out.glob('library-L*.json')):
   166	        label = path.stem.split('-', 1)[1]
   167	        lib = json.loads(path.read_text())
   168	        prompt = READ.format(matters=text, label=label, library=library_text(lib))
   169	        ids = {e['question_id'] for e in lib}
   170	        for family in FAMILIES:
   171	            dest = out / f'map-{label}-{family}.txt'
   172	            if not dest.exists():
   173	                jobs.append((family, prompt, ids, dest))
   174	
   175	    def one(job):
   176	        family, prompt, ids, dest = job
   177	        for attempt in (1, 2):
   178	            answer, void = census_readers.run(family, prompt)
   179	            if answer and not void:
   180	                void = answer_problem(json_lines(answer), keys, ids)
   181	                if void is None:
   182	                    dest.write_text(answer)
   183	                    return dest.name, None
   184	        return dest.name, void
   185	    with concurrent.futures.ThreadPoolExecutor(max_workers=6) as pool:
   186	        for name, void in pool.map(one, jobs):
   187	            print(name, 'VOID ' + void if void else 'mapped', flush=True)
   188	
   189	
   190	def marks(out, label, family):
   191	    """{matter: covering ids} and the set of duplicates (the later-opened id of every pair named), from one family's valid answer."""
   192	    path = Path(out) / f'map-{label}-{family}.txt'
   193	    if not path.exists():
   194	        raise SystemExit(f'refused: {path.name} missing (a void mapping is never counted)')
   195	    rows = json_lines(path.read_text())
   196	    order = {e['question_id']: k for k, e in enumerate(json.loads((Path(out) / f'library-{label}.json').read_text()))}
   197	    covering = {}
   198	    for r in rows:
   199	        if r.get('matter') and r.get('status') in ('opened', 'narrower'):
   200	            if r['status'] == 'opened' or r.get('main_outcome') is True:
   201	                for q in r.get('ids') or []:
   202	                    covering.setdefault(r['matter'], set()).add(str(q))
   203	    duplicates = {max(str(r['duplicate']), str(r['of']), key=order.__getitem__) for r in rows if r.get('duplicate') is not None}
   204	    return covering, duplicates
   205	
   206	
   207	def disagreements(out):
   208	    out = Path(out)
   209	    split = []
   210	    for path in sorted(out.glob('library-L*.json')):
   211	        label = path.stem.split('-', 1)[1]
   212	        a, _ = marks(out, label, 'codex')
   213	        b, _ = marks(out, label, 'claude')
   214	        for matter in sorted(set(a) | set(b)):
   215	            for q in sorted(a.get(matter, set()) ^ b.get(matter, set())):
   216	                split.append((label, matter, q))
   217	    return split
   218	
   219	
   220	def third(out):
   221	    out = Path(out)
   222	    m = {x['matter']: x for x in json.loads(MATTERS.read_text())['matters']}
   223	    libs = {p.stem.split('-', 1)[1]: {e['question_id']: e for e in json.loads(p.read_text())} for p in out.glob('library-L*.json')}
   224	    jobs = []
   225	    for label, matter, q in disagreements(out):
   226	        entry = libs[label][q]
   227	        for reader in FAMILIES:
   228	            dest = out / 'third' / f'{label}--{matter}--{q}--{reader}.json'
   229	            if not dest.exists():
   230	                question = f"{entry['question']} (due {entry['due']}); possible answers: " + ' | '.join(entry['possible_answers'])
   231	                jobs.append((reader, THIRD.format(matter=f"{m[matter]['name']} (e.g. {m[matter]['question']})", question=question), dest))
   232	
   233	    def one(job):
   234	        reader, prompt, dest = job
   235	        for attempt in (1, 2):
   236	            answer, void = census_readers.run(reader, prompt)
   237	            rows = json_lines(answer) if answer else []
   238	            if rows and isinstance(rows[-1].get('covers'), bool) and not void:
   239	                dest.parent.mkdir(exist_ok=True)
   240	                dest.write_text(json.dumps(rows[-1], ensure_ascii=False) + '\n')
   241	                return dest.name, None
   242	        return dest.name, void or 'no covers mark'
   243	    print(len(jobs), 'third-reader sessions')
   244	    with concurrent.futures.ThreadPoolExecutor(max_workers=6) as pool:
   245	        for name, void in pool.map(one, jobs):
   246	            print(name, 'VOID ' + void if void else 'marked', flush=True)
   247	
   248	
   249	def result(out):
   250	    out = Path(out)
   251	    key = json.loads((KEY_FOLDER / 'mapping-key.json').read_text())
   252	    label_of = {d: l for d, l in key.items()}
   253	    mapping, distinct = {}, {}
   254	    for draw, label in label_of.items():
   255	        a, dup_a = marks(out, label, 'codex')
   256	        b, dup_b = marks(out, label, 'claude')
   257	        lib = json.loads((out / f'library-{label}.json').read_text())
   258	        mapping[draw] = {}
   259	        for matter in sorted(set(a) | set(b)):
   260	            entries = []
   261	            for q in sorted(a.get(matter, set()) | b.get(matter, set())):
   262	                if q in a.get(matter, set()) and q in b.get(matter, set()):
   263	                    covers = True
   264	                else:
   265	                    paths = [out / 'third' / f'{label}--{matter}--{q}--{reader}.json' for reader in FAMILIES]
   266	                    missing = [p.name for p in paths if not p.exists()]
   267	                    if missing:
   268	                        raise SystemExit(f'refused: third-reader marks missing {missing}')
   269	                    thirds = [json.loads(p.read_text())['covers'] for p in paths]
   270	                    covers = True if thirds == [True, True] else False if thirds == [False, False] else 'split'
   271	                entries.append({'question': q, 'covers': covers})
   272	            if any(e['covers'] is not False for e in entries):
   273	                mapping[draw][matter] = [e for e in entries if e['covers'] is not False]
   274	        distinct[draw] = {'ids': len(lib), 'duplicates_both': len(dup_a & dup_b), 'duplicates_split': len(dup_a ^ dup_b)}
   275	    text = json.dumps({'mapping': mapping, 'distinct': distinct}, indent=1, ensure_ascii=False) + '\n'
   276	    (out / 'mapping.json').write_text(text)
   277	    print('mapping.json written', hashlib.sha256(text.encode()).hexdigest()[:16])
