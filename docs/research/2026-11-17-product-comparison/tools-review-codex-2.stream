    86	def matters_text():
    87	    m = json.loads(MATTERS.read_text())['matters']
    88	    return '\n'.join(f"- {x['matter']}: {x['name']} (e.g. {x['question']})" for x in m), [x['matter'] for x in m]
    89	
    90	
    91	def library_text(lib):
    92	    lines = []
    93	    for e in lib:
    94	        lines.append(f"- id {e['question_id']} · opened {e['opened']} · due {e['due']}: {e['question']}")
    95	        lines += [f'    possible answer: {a}' for a in e['possible_answers']]
    96	    return '\n'.join(lines)
