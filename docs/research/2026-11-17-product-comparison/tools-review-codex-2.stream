   125	def answer_problem(rows, keys, ids):
   126	    """Why a reader's mapping answer is void, or None: every matter exactly once with a known status, every id named in the library, every
   127	    duplicate pair two different ids of the library."""
   128	    matter_rows = [r for r in rows if r.get('matter')]
