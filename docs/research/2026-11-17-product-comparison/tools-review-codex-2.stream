   283	        export(sys.argv[2], sys.argv[3])
   284	    else:
   285	        {'read': read, 'third': third, 'result': result}[command](sys.argv[2])
     1	"""Library export and cards for the comparison's reading (card-spec.md; plan §1.5 F; D672, D673). Both systems write the same store
     2	(views, rungs, judgements, evidence) and send the same judge request, so one reader of both serves every draw.
     3	
     4	    python3 build_cards.py <views.sqlite> <archive.sqlite> <items db> <output.json>
     5	
     6	Writes, per question the library holds at the end of its run (the cutoff), the card text of card-spec.md: the question, its due day and its
     7	possible answers (each rung's condition, stance labels removed); the latest answer and its reasons; the material the answering request
     8	contained (evidence renumbered per card; matcher notes, ids and the header's focus string removed); the library's other questions in opening
     9	order with their opening days. A question never judged is carded "no answer".
    10	"""
    11	import json
    12	import re
    13	import sqlite3
    14	import sys
    15	from pathlib import Path
    16	
    17	RUNG = re.compile(r'rung (\d+) ([^:]*): ')
    18	ANNOTATION = re.compile(r'\s*\((?:no reference figure when the question opened|the reference when the question opened: ".*?")\)')   # D673 form check
    19	ITEM = re.compile(r'^- e\d+ \[([^;\]]*); (.*?); original source (.*?); from \S+ (\S+)\] ', re.S)   # a speaker may hold ';'
    20	NOTE = re.compile(r'\n    (?:It replaces |Opinion, not verified: )')
    21	
    22	
    23	def ro(path):
    24	    conn = sqlite3.connect(f'file:{path}?mode=ro&immutable=1', uri=True)
    25	    conn.row_factory = sqlite3.Row
    26	    return conn
    27	
    28	
    29	def conditions(view_id, conn):
    30	    """{position: condition} with stance labels and the answer step's reference annotations removed (D673)."""
    31	    return {r['position']: ANNOTATION.sub('', (r['condition'] or r['label'] or '')).strip() for r in
    32	            conn.execute('select position, label, condition from rungs where view_id=? order by position', (view_id,))}
    33	
    34	
    35	def material(request_json):
    36	    """The evidence items of a judge request (`judging._lines_english`): [(tier, speaker, original source, day, summary, quote)]. The
    37	    evidence section runs from its header to the next bracketed section; an item runs to the next item, so a summary or quote with line
    38	    breaks is kept whole; the matcher notes after the quote are dropped."""
    39	    text = json.loads(request_json)['messages'][-1]['content']
    40	    start = text.find('[Evidence in view under this thesis')
    41	    if start < 0:
    42	        return []
    43	    section = text[start:]
    44	    end = re.search(r'\n\n?\[(?!Not shown)', section[1:])
    45	    section = section[:end.start() + 1] if end else section
    46	    chunks = re.split(r'\n(?=- e\d+ \[)', section)
    47	    items = []
    48	    for chunk in chunks[1:]:
    49	        m = ITEM.match(chunk)
    50	        if not m:
    51	            raise ValueError(f'an evidence item the card cannot read: {chunk[:120]!r}')
    52	        rest = chunk[m.end():]
    53	        rest = NOTE.split(rest)[0]
    54	        summary, _, quote = rest.partition('\n    Quote: ')
    55	        items.append((m.group(1).strip(), m.group(2).strip(), m.group(3).strip(), m.group(4), summary.strip(), quote.strip()))
    56	    return items
    57	
    58	
    59	def library(views_path, archive_path, items_path):
    60	    conn, archive, items = ro(views_path), ro(archive_path), ro(items_path)
    61	    day_of = lambda input_id: (items.execute('select publication_day from items where input_id=?', (input_id,)).fetchone() or [None])[0]
    62	    views = list(conn.execute('select view_id, question, due_day, created_seq, created_from_input from views order by created_seq'))
    63	    out = []
    64	    for v in views:
    65	        latest = conn.execute('select rung, reasons, request_sha256, seq from judgements where view_id=? order by seq desc limit 1',
    66	                              (v['view_id'],)).fetchone()
    67	        rungs = conditions(v['view_id'], conn)
    68	        bounded = conn.execute('select count(*) from rungs where view_id=? and (lo is not null or hi is not null)', (v['view_id'],)).fetchone()[0]
    69	        entry = {'question_id': v['view_id'], 'question': v['question'], 'due': v['due_day'], 'opened': day_of(v['created_from_input']),
    70	                 'type': 'figure' if bounded else 'yes/no',
    71	                 'possible_answers': [rungs[p] for p in sorted(rungs)], 'answer': None, 'reasons': None, 'material': []}
    72	        if latest is not None:
    73	            entry['answer'] = rungs.get(latest['rung'])
    74	            entry['reasons'] = latest['reasons']
    75	            row = archive.execute('select request_json from model_calls where request_sha256=? limit 1', (latest['request_sha256'],)).fetchone()
    76	            if row is None:
    77	                raise SystemExit(f"{v['view_id']}: the latest judgement's request is not in the archive")
    78	            entry['material'] = material(row['request_json'])
    79	        out.append(entry)
    80	    return out
    81	
    82	
    83	def card_text(entry, lib):
    84	    lines = [f"Question: {entry['question']}", f"Due: {entry['due']}", 'Possible answers:']
    85	    lines += [f'- {c}' for c in entry['possible_answers']]
    86	    if entry['answer'] is None:
    87	        lines += ['', 'Latest answer at the cutoff: no answer']
    88	    else:
    89	        lines += ['', f"Latest answer at the cutoff: {entry['answer']}", f"Reason given: {entry['reasons']}", '',
    90	                  f"Material that answer was given ({len(entry['material'])} items, by day):"]
    91	        for k, (tier, speaker, original, day, summary, quote) in enumerate(sorted(entry['material'], key=lambda m: m[3]), 1):
    92	            lines.append(f'{k}. ({tier}; speaker {speaker}; original source {original}; published {day}) {summary}')
    93	            if quote:
    94	                lines.append(f'   Quote: {quote}')
    95	    others = [e for e in lib if e['question_id'] != entry['question_id']]
    96	    lines += ['', 'Other questions in the same library, in opening order:']
    97	    lines += [f"- opened {e['opened']}: {e['question']}" for e in others]
    98	    return '\n'.join(lines)
    99	
   100	
   101	def main(views_path, archive_path, items_path, out_path):
   102	    lib = library(views_path, archive_path, items_path)
   103	    cards = [{'question_id': e['question_id'], 'answered': e['answer'] is not None, 'text': card_text(e, lib)} for e in lib]
   104	    Path(out_path).write_text(json.dumps({'library': lib, 'cards': cards}, indent=1, ensure_ascii=False) + '\n')
   105	    print(f'{len(lib)} questions, {sum(c["answered"] for c in cards)} answered; material items {sum(len(e["material"]) for e in lib)}')
   106	
   107	
   108	if __name__ == '__main__':
   109	    main(*sys.argv[1:5])

