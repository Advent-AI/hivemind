    69	RUNNER = r'''
    70	import json, sys, types
    71	from pathlib import Path
    72	here, module, changes, test_file, tests = sys.argv[1], sys.argv[2], json.loads(sys.argv[3]), sys.argv[4], json.loads(sys.argv[5])
    73	sys.path[:0] = [here, here + '/census']
    74	path = Path(here) / f'{module}.py'
    75	source = path.read_text()
    76	for old, new in changes:
    77	    assert source.count(old) == 1, old
    78	    source = source.replace(old, new)
    79	mutant = types.ModuleType(module)
    80	mutant.__file__ = str(path)
    81	sys.modules[module] = mutant
    82	exec(compile(source, str(path), 'exec'), mutant.__dict__)
    83	import pytest
    84	args = ['-q', '-p', 'no:cacheprovider', str(Path(here) / test_file)] + (['-k', ' or '.join(tests)] if tests else [])
    85	sys.exit(pytest.main(args))
    86	'''
    87	
    88	
    89	def main():
    90	    lines, wrong = [], 0
    91	    for name, module, changes, test_file, tests in MUTANTS:
    92	        done = subprocess.run([sys.executable, '-c', RUNNER, str(HERE), module, json.dumps(changes), test_file, json.dumps(tests)],
    93	                              capture_output=True, text=True, env={'PYTHONDONTWRITEBYTECODE': '1', 'PATH': '/usr/bin:/bin'})
    94	        expected = 0 if name.startswith('control') else 1
    95	        tail = [l for l in done.stdout.splitlines() if l.startswith('E ') or 'passed' in l or 'failed' in l or 'error' in l.lower()]
    96	        ok = done.returncode == expected
    97	        wrong += not ok
    98	        lines.append(f"== {name}: exit {done.returncode}, {'as predicted' if ok else 'NOT AS PREDICTED'} | " + ' | '.join(tail[:2] + tail[-1:]))
    99	    print('\n'.join(lines))
   100	    print('all as predicted' if not wrong else f'{wrong} NOT AS PREDICTED')
   101	    return wrong
   102	
   103	
   104	if __name__ == '__main__':
   105	    sys.exit(main())
