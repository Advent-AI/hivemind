    79	def libraries(mapping_out):
    80	    key = json.loads((mapping_tool.KEY_FOLDER / 'mapping-key.json').read_text())
    81	    return {draw: json.loads((Path(mapping_out) / f'library-{label}.json').read_text()) for draw, label in key.items()}
    82	
    83	
    84	def plant(card_text, entry):
    85	    """The card with its latest answer moved one rung (the next rung, or the previous at the end), or None when no adjacent rung differs."""
    86	    answers = entry['possible_answers']
    87	    if entry['answer'] not in answers:
    88	        return None
    89	    k = answers.index(entry['answer'])
    90	    moved = answers[k + 1] if k + 1 < len(answers) else (answers[k - 1] if k > 0 else None)
    91	    if moved is None or moved == entry['answer']:
    92	        return None
    93	    planted = card_text.replace(f"Latest answer at the cutoff: {entry['answer']}", f'Latest answer at the cutoff: {moved}', 1)
    94	    return planted if planted != card_text else None
