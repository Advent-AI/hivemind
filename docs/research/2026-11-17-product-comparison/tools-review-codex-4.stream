    95	        return entry[2]
    96	    cache = {}
    97	    for seq, day in conn.execute('select sequence_no, min(publication_day) from processing_steps where sequence_no > 0 group by sequence_no'):
    98	        cache[seq] = day
    99	    if cache:                 # sequence 0 is the seed questions written before the first item (D253): visible from the ledger's first day
   100	        cache[0] = min(cache.values())
   101	    if len(_SEQ_DAYS) >= 64:
   102	        _SEQ_DAYS.clear()
   103	    _SEQ_DAYS[id(conn)] = (conn, stamp, cache)
   104	    return cache
