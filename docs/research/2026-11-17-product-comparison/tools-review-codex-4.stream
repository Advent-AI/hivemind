   201	    if len(controls['plants']) != 6 or len(controls['supported']) != 4 or len(controls['repeats_same']) != 3:
   202	        invalid.append('the deck does not hold 6 plants, 4 supported controls and 3 repeats')
   203	    if invalid:
   204	        return dict(report, verdict='invalid', why=invalid)
