    46	def last_call(draw_folder):
    47	    """The latest model call stored in any database under the draw's folder, and how many databases hold calls."""
    48	    latest, databases = None, 0
    49	    for path in sorted(Path(draw_folder).rglob('*.sqlite')):
    50	        conn = sqlite3.connect(f'file:{path}?mode=ro&immutable=1', uri=True)
    51	        if not conn.execute("select 1 from sqlite_master where type='table' and name='model_calls'").fetchone():
    52	            continue
    53	        databases += 1
    54	        stamp = conn.execute('select max(created_at) from model_calls').fetchone()[0]
    55	        if stamp and (latest is None or local(stamp) > latest):
    56	            latest = local(stamp)
    57	    return latest, databases
