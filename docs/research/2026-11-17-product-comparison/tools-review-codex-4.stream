    40	def code_not_committed():
    41	    """Modified, staged or untracked files under the code paths (stage0: Python only)."""
    42	    out = subprocess.run(['git', 'status', '--porcelain', '--untracked-files=all', '--', *CODE_PATHS], cwd=ROOT, capture_output=True,
    43	                         text=True, check=True).stdout
    44	    dirty = []
