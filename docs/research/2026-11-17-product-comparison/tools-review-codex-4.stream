    26	def test_every_evidence_item_is_read_whole_with_its_speaker_and_without_matcher_notes():
    27	    """card-spec 3 and D673: each item the request contained, its speaker as written (a speaker may hold ';'), a quote over several lines
    28	    kept whole, matcher notes removed, nothing after the evidence section read as evidence."""
    29	    items = build_cards.material(json.dumps({'messages': [{'role': 'user', 'content': REQUEST}]}))
    30	    assert len(items) == 2
    31	    first = items[0]
    32	    assert (first['tier'], first['speaker'], first['original'], first['input_id'], first['day']) == (
    33	        'fact', 'Yahoo Finance (finance.yahoo.com); Jensen Huang quoted', 'NVIDIA', 'gnews:3e5f', '2026-09-10')
    34	    assert first['quote'] == '"We see demand\nwell beyond supply," he said.' and 'matcher' not in first['quote']
    35	    assert items[1]['summary'] == 'Estimate raised to 160bn.' and 'Current conclusions' not in items[1]['quote']
