     1	"""Library export and cards for the comparison's reading (card-spec.md; plan §1.5 F; D672, D673). Both systems write the same store
     2	(views, rungs, judgements, evidence) and send the same judge request, so one reader of both serves every draw.
     3	
     4	    python3 build_cards.py <views.sqlite> <archive.sqlite> <items db> <output.json>
     5	
     6	Writes, per question the library holds at the end of its run (the cutoff), the card text of card-spec.md: the question, its due day and its
     7	possible answers (each rung's condition, stance labels removed); the latest answer and its reasons; the material the answering request
     8	contained (evidence renumbered per card; matcher notes, ids and the header's focus string removed); the library's other questions in opening
     9	order with their opening days. A question never judged is carded "no answer".
    10	"""
    11	import json
    12	import re
    13	import sqlite3
    14	import sys
    15	from pathlib import Path
    16	
    17	RUNG = re.compile(r'rung (\d+) ([^:]*): ')
    18	ANNOTATION = re.compile(r'\s*\((?:no reference figure when the question opened|the reference when the question opened: ".*?")\)')   # D673 form check
    19	ITEM = re.compile(r'^- e\d+ \[([^;\]]*); (.*?); original source (.*?); from (\S+) (\S+)\] ', re.S)   # a speaker may hold ';'
    20	NOTE = re.compile(r'\n    (?:It replaces |Opinion, not verified: )')
    21	
    22	
    23	def ro(path):
    24	    conn = sqlite3.connect(f'file:{path}?mode=ro&immutable=1', uri=True)
    25	    conn.row_factory = sqlite3.Row
    26	    return conn
    27	
    28	
    29	def conditions(view_id, conn):
    30	    """{position: condition} with stance labels and the answer step's reference annotations removed (D673)."""
    31	    return {r['position']: ANNOTATION.sub('', (r['condition'] or r['label'] or '')).strip() for r in
    32	            conn.execute('select position, label, condition from rungs where view_id=? order by position', (view_id,))}
    33	
    34	
    35	def material(request_json):
    36	    """The evidence items of a judge request (`judging._lines_english`): [{tier, speaker, original, input_id, day, summary, quote}]. The
    37	    evidence section runs from its header to the next bracketed section; an item runs to the next item, so a summary or quote with line
    38	    breaks is kept whole; the matcher notes after the quote are dropped."""
    39	    text = json.loads(request_json)['messages'][-1]['content']
    40	    start = text.find('[Evidence in view under this thesis')
    41	    if start < 0:
    42	        return []
    43	    section = text[start:]
    44	    end = re.search(r'\n\n?\[(?!Not shown)', section[1:])
    45	    section = section[:end.start() + 1] if end else section
    46	    chunks = re.split(r'\n(?=- e\d+ \[)', section)
    47	    items = []
    48	    for chunk in chunks[1:]:
    49	        m = ITEM.match(chunk)
    50	        if not m:
    51	            raise ValueError(f'an evidence item the card cannot read: {chunk[:120]!r}')
    52	        rest = chunk[m.end():]
    53	        rest = NOTE.split(rest)[0]
    54	        summary, _, quote = rest.partition('\n    Quote: ')
    55	        items.append({'tier': m.group(1).strip(), 'speaker': m.group(2).strip(), 'original': m.group(3).strip(), 'input_id': m.group(4),
    56	                      'day': m.group(5), 'summary': summary.strip(), 'quote': quote.strip()})
    57	    return items
    58	
    59	
    60	def section(text, header):
    61	    """The body of one bracketed section of a judge request, from its header line to the next blank-line section, or ''."""
    62	    start = text.find(header)
    63	    if start < 0:
    64	        return ''
    65	    body = text[start:].split('\n', 1)[1] if '\n' in text[start:] else ''
    66	    return re.split(r'\n\n(?:\[|Answer per the JSON schema)', body, maxsplit=1)[0]
    67	
    68	
    69	def entries(body):
    70	    """The '- ' entries of a section, each kept whole across line breaks."""
    71	    return [e[2:] for e in re.split(r'\n(?=- )', body) if e.startswith('- ')]
    72	
    73	
    74	def context(request_json, conn):
    75	    """What the answering request gave besides its evidence items (`judging._lines_english`), blinded as the card is: thesis ids removed,
    76	    each rung shown by its condition (D673). {hidden, previous, depends_on, themes}."""
    77	    text = json.loads(request_json)['messages'][-1]['content']
    78	    hidden = re.search(r'\[Not shown: (\d+) more pieces in force', text)
    79	    previous = re.search(r'\[Previous conclusion, for comparison only\] rung (\d+); reasons: (.*?)(?:\n\nAnswer per the JSON schema|$)', text, re.S)
    80	    out = {'hidden': int(hidden.group(1)) if hidden else 0, 'previous': None, 'depends_on': [], 'themes': []}
    81	    for e in entries(section(text, '[Current conclusions of the theses it depends on]')):
    82	        m = re.match(r'(v\d+) \(([^;]*); ([^)]*)\) (.*): now rung (\S+) .*?; reasons: (.*)$', e, re.S)
    83	        if m:
    84	            answer = conditions(m.group(1), conn).get(int(m.group(5))) if m.group(5).isdigit() else 'not judged yet'
    85	            out['depends_on'].append({'flag': m.group(2), 'direction': m.group(3), 'question': m.group(4), 'answer': answer, 'reasons': m.group(6).strip()})
    86	        else:
    87	            out['depends_on'].append({'flag': 'not yet created', 'direction': '', 'question': re.sub(r'^the (\S+) thesis on chain v\d+', r'the \1 question of a chain', e).strip(),
    88	                                      'answer': None, 'reasons': ''})
    89	    for e in entries(section(text, '[Themes in force, ')):
    90	        m = re.match(r'(v\d+) \([^,]*, due (\S+)\) (.*): now rung (\d+) .*?; judged (\S+?)(?:; updated since this thesis was last judged)?; reasons: (.*)$', e, re.S)
    91	        if not m:
    92	            raise ValueError(f'a theme entry the card cannot read: {e[:120]!r}')
    93	        out['themes'].append({'question': m.group(3), 'due': m.group(2), 'answer': conditions(m.group(1), conn).get(int(m.group(4))),
    94	                              'judged': m.group(5), 'reasons': m.group(6).strip()})
    95	    if previous:
    96	        out['previous'] = {'rung': int(previous.group(1)), 'reasons': previous.group(2).strip()}
    97	    return out
    98	
    99	
   100	def library(views_path, archive_path, items_path):
   101	    conn, archive, items = ro(views_path), ro(archive_path), ro(items_path)
   102	    day_of = lambda input_id: (items.execute('select publication_day from items where input_id=?', (input_id,)).fetchone() or [None])[0]
   103	    publisher_of = lambda input_id: (items.execute('select publisher from items where input_id=?', (input_id,)).fetchone() or [None])[0]
   104	    views = list(conn.execute('select view_id, question, due_day, created_seq, created_from_input from views order by created_seq'))
   105	    out = []
   106	    for v in views:
   107	        latest = conn.execute('select rung, reasons, request_sha256, seq from judgements where view_id=? order by seq desc limit 1',
   108	                              (v['view_id'],)).fetchone()
   109	        rungs = conditions(v['view_id'], conn)
   110	        bounded = conn.execute('select count(*) from rungs where view_id=? and (lo is not null or hi is not null)', (v['view_id'],)).fetchone()[0]
   111	        entry = {'question_id': v['view_id'], 'question': v['question'], 'due': v['due_day'], 'opened': day_of(v['created_from_input']),
   112	                 'opened_from': v['created_from_input'], 'type': 'figure' if bounded else 'yes/no',
   113	                 'possible_answers': [rungs[p] for p in sorted(rungs)], 'answer': None, 'answer_index': None, 'reasons': None, 'material': []}
   114	        if latest is not None:
   115	            entry['answer'] = rungs.get(latest['rung'])
   116	            entry['answer_index'] = sorted(rungs).index(latest['rung'])      # the stored rung's place in possible_answers
   117	            entry['reasons'] = latest['reasons']
   118	            row = archive.execute('select request_json from model_calls where request_sha256=? limit 1', (latest['request_sha256'],)).fetchone()
   119	            if row is None:
   120	                raise SystemExit(f"{v['view_id']}: the latest judgement's request is not in the archive")
   121	            entry['material'] = [dict(item, publisher=publisher_of(item['input_id'])) for item in material(row['request_json'])]
   122	            entry['context'] = context(row['request_json'], conn)
   123	            if entry['context']['previous']:
   124	                entry['context']['previous']['answer'] = rungs.get(entry['context']['previous']['rung'])
   125	        out.append(entry)
   126	    return out
   127	
   128	
   129	def card_text(entry, lib):
   130	    lines = [f"Question: {entry['question']}", f"Opened: {entry['opened']}", f"Due: {entry['due']}", 'Possible answers (numbered as the reasons cite them):']
   131	    lines += [f'{k}. {c}' for k, c in enumerate(entry['possible_answers'], 1)]
   132	    if entry['answer'] is None:
   133	        lines += ['', 'Latest answer at the cutoff: no answer']
   134	    else:
   135	        lines += ['', f"Latest answer at the cutoff: {entry['answer']}", f"Reason given: {entry['reasons']}", '',
   136	                  f"Material that answer was given ({len(entry['material'])} items, by day):"]
   137	        for k, item in enumerate(sorted(entry['material'], key=lambda m: m['day']), 1):
   138	            lines.append(f"{k}. ({item['tier']}; publisher {item['publisher']}; speaker {item['speaker']}; original source {item['original']}; "
   139	                         f"published {item['day']}) {item['summary']}")
   140	            if item['quote']:
   141	                lines.append(f"   Quote: {item['quote']}")
   142	        ctx = entry.get('context') or {}
   143	        if ctx.get('hidden'):
   144	            lines.append(f"Not shown to the answer: {ctx['hidden']} more items in force, read in earlier answers; the previous answer carries them.")
   145	        if ctx.get('depends_on'):
   146	            lines += ['', 'Answers of the questions it depends on, as the answer was given them:']
   147	            for d in ctx['depends_on']:
   148	                lines.append(f"- ({d['flag']}; {d['direction']}) {d['question']}: answered {d['answer'] or 'not yet'}; reason: {d['reasons']}"
   149	                             if d['answer'] else f"- {d['question']} ({d['flag']})")
   150	        if ctx.get('themes'):
   151	            lines += ['', 'Themes in force, as the answer was given them:']
   152	            lines += [f"- {t['question']} (due {t['due']}): answered {t['answer']} on {t['judged']}; reason: {t['reasons']}" for t in ctx['themes']]
   153	        previous = ctx.get('previous')
   154	        lines += ['', f"Previous answer, given for comparison: {previous['answer']}; reason: {previous['reasons']}" if previous
   155	                  else 'Previous answer: none (this was the first answer).']
   156	    lines += ['', "The library's questions in opening order (this card's question marked):"]
   157	    lines += [f"- opened {e['opened']}: {e['question']}" + ('   <- this question' if e['question_id'] == entry['question_id'] else '') for e in lib]
   158	    return '\n'.join(lines)
   159	
   160	
   161	def main(views_path, archive_path, items_path, out_path):
   162	    lib = library(views_path, archive_path, items_path)
   163	    cards = [{'question_id': e['question_id'], 'answered': e['answer'] is not None, 'text': card_text(e, lib)} for e in lib]
   164	    Path(out_path).write_text(json.dumps({'library': lib, 'cards': cards}, indent=1, ensure_ascii=False) + '\n')
   165	    print(f'{len(lib)} questions, {sum(c["answered"] for c in cards)} answered; material items {sum(len(e["material"]) for e in lib)}')
   166	
   167	
   168	if __name__ == '__main__':
   169	    main(*sys.argv[1:5])
