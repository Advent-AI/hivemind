    43	                          {'tier': 'fact', 'publisher': 'Bloomberg', 'speaker': 's', 'original': 'o', 'day': '2026-09-08', 'summary': 'earlier', 'quote': ''}]}
    44	    text = build_cards.card_text(entry, [entry])
    45	    assert text.index('earlier') < text.index('later') and 'publisher Bloomberg' in text   # card-spec 3: the source's publisher and day
