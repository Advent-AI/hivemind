    83	def libraries(mapping_out):
    84	    key = json.loads((mapping_tool.KEY_FOLDER / 'mapping-key.json').read_text())
    85	    return {draw: json.loads((Path(mapping_out) / f'library-{label}.json').read_text()) for draw, label in key.items()}
