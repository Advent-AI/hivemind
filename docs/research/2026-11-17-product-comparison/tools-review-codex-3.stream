    27	def local(stamp):
    28	    """A naive local time from either stored form: '2026-11-17T22:05:13-0800' (launcher) or '2026-11-17T22:06:16' (archives)."""
    29	    try:
    30	        return datetime.datetime.strptime(stamp, '%Y-%m-%dT%H:%M:%S%z').astimezone().replace(tzinfo=None)
    31	    except ValueError:
    32	        return datetime.datetime.strptime(stamp[:19], '%Y-%m-%dT%H:%M:%S')
