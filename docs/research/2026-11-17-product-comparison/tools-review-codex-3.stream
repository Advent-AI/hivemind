   110	def confirmed_by_reader(card_text, supported):
   111	    """A separate closed reader's confirmation that the card's latest answer is (or is not) supported; None when the reader gave no mark."""
   112	    answer, void = census_readers.run('claude', CONFIRM.format(card=card_text))
   113	    rows = json_lines(answer) if answer else []
   114	    if void or not rows or not isinstance(rows[-1].get('supported'), bool):
   115	        return None, rows[-1] if rows else None
   116	    return rows[-1]['supported'] is supported, rows[-1]
