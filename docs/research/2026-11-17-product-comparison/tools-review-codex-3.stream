   111	                self._write({'attempt': attempt_id, 'reserve': reserve})
   112	            response, failure = None, None
   113	            try:
   114	                response = self.attempt(provider, request)
   115	            except model.TransportError as error:
   116	                failure = error
   117	            finally:
   118	                with self.lock:
   119	                    self.reserved_usd -= reserve
   120	                    charged = budget.cost(request, response) if response is not None else None
   121	                    self.spent_usd += reserve if charged is None else charged
   122	                    self._write({'attempt': attempt_id, 'charge': reserve if charged is None else charged, 'known': charged is not None})
   123	                    if self.shared is not None:
   124	                        self.shared.settle(shared_reserve, charged)       # the ledger settles a missing or zero charge at its reservation
   125	            if response is not None:
   126	                return response
   127	            retried = getattr(failure, 'http_status', None) not in budget.NOT_RETRIED and str(failure) not in budget.UNDECODABLE
   128	            if not retried or attempt_number + 1 == budget.ATTEMPTS:
   129	                raise failure
   130	            self.sleep(5 * (attempt_number + 1))
