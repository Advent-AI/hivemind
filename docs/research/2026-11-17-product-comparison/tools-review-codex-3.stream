   227	def mark(folder):
   228	    folder = Path(folder)
   229	    prompts = {(p.stem, f): BRIEF.format(card=p.read_text()) for p in sorted(folder.glob('C*.txt')) for f in FAMILIES}
   230	    run_marks(folder, 'round-0', prompts)
   231	
   232	
   233	def current(folder, cid, family, upto):
   234	    """The family's latest mark on the card from rounds 0..upto (a debate round never reads its own round)."""
   235	    for n in range(upto, -1, -1):
   236	        p = Path(folder) / f'round-{n}' / f'{cid}-{family}.json'
   237	        if p.exists():
   238	            return json.loads(p.read_text())
   239	    return None
   240	
   241	
   242	def settled_marks(folder, cid, upto):
   243	    """The fields both families agreed on in some round 0..upto (settled at the first such round), and each family's latest mark."""
   244	    out, a, b = {}, None, None
   245	    for n in range(upto + 1):
   246	        a, b = current(folder, cid, 'codex', n), current(folder, cid, 'claude', n)
   247	        if a is None or b is None:
   248	            raise SystemExit(f'{cid}: a family has no valid mark by round {n}')
   249	        for field in ('worth', 'answer'):
   250	            if field not in out and a.get(field) == b.get(field):
   251	                out[field] = a.get(field)
   252	    return out, a, b
   253	
   254	
   255	def debate(folder, round_number):
   256	    folder = Path(folder)
   257	    if not (folder / f'round-{round_number - 1}.done').exists():
   258	        raise SystemExit(f'refused: round {round_number - 1} is not complete')
   259	    prompts = {}
   260	    for p in sorted(folder.glob('C*.txt')):
   261	        settled, a, b = settled_marks(folder, p.stem, round_number - 1)
   262	        disputed = [field for field in ('worth', 'answer') if field not in settled]
   263	        if disputed:
   264	            for family, own, other in (('codex', a, b), ('claude', b, a)):
   265	                prompts[(p.stem, family)] = BRIEF.format(card=p.read_text()) + DEBATE.format(
   266	                    disputed=', '.join(disputed), own=json.dumps(own, ensure_ascii=False), other=json.dumps(other, ensure_ascii=False))
   267	    print(len(prompts) // 2, 'cards in debate round', round_number)
   268	    run_marks(folder, f'round-{round_number}', prompts)
   269	
   270	
   271	def final(folder, cid):
   272	    """Each field's mark: settled at the first round both families agree on it (a later change to a settled field is ignored); a field
   273	    never agreed is {"split": [codex, claude]} as the last round left it."""
   274	    out, a, b = settled_marks(folder, cid, 2)
   275	    for field in ('worth', 'answer'):
   276	        out.setdefault(field, {'split': [a.get(field), b.get(field)]})
   277	    return out
   278	
