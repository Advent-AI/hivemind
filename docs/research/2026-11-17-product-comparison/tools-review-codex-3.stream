   187	def normalised(row):
   188	    """The mark as written: the string "null" for no answer becomes null, so two readers' empty answers compare equal."""
   189	    return dict(row, answer=None) if isinstance(row, dict) and row.get('answer') == 'null' else row
   190	
   191	
   192	def valid(row, answered):
   193	    if not isinstance(row, dict) or row.get('worth') not in WORTH or len(str(row.get('why', '')).split()) > 40:
   194	        return False
   195	    return (row.get('answer') in ANSWER) if answered else row.get('answer') is None
