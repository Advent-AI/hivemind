    35	def sha256(path):
    36	    digest = hashlib.sha256()
    37	    with open(path, 'rb') as handle:
    38	        for block in iter(lambda: handle.read(1 << 20), b''):
    39	            digest.update(block)
    40	    return digest.hexdigest()
