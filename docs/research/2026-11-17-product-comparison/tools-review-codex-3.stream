    70	        if not starts:
    71	            problems.append(f'{draw}: no launch recorded')
    72	    launches = [datetime.datetime.fromisoformat(d['launch']) for d in draws.values() if d['launch']]
    73	    if launches and max(launches) - min(launches) > LAUNCH_WINDOW:
    74	        problems.append(f'launches span {max(launches) - min(launches)}, more than one hour')
    75	    first = min(launches) if launches else None
    76	    for draw, d in draws.items():
    77	        if first and d['last call'] and datetime.datetime.fromisoformat(d['last call']) > first + SEND_WINDOW:
    78	            problems.append(f"{draw}: a call at {d['last call']}, more than 72 h after the first launch {first.isoformat()}")
    79	    return {'eligible': not problems, 'problems': problems, 'first launch': first.isoformat() if first else None, 'draws': draws}
    80	
    81	
    82	if __name__ == '__main__':
    83	    result = check(sys.argv[1])
    84	    Path(sys.argv[2]).write_text(json.dumps(result, indent=1) + '\n')
    85	    print('ELIGIBLE' if result['eligible'] else 'NOT ELIGIBLE: ' + '; '.join(result['problems']))
     1	"""Tests of the draws' eligibility (D667: six draws launched within one hour, every send within 72 h of the first launch; D675).
     2	
     3	Run: python3 -m pytest docs/research/2026-11-17-product-comparison/stage0/test_eligibility.py
     4	"""
     5	import json
     6	import sqlite3
     7	import sys
     8	from pathlib import Path
     9	
    10	sys.path.insert(0, str(Path(__file__).resolve().parent))
    11	import eligibility  # noqa: E402
    12	
    13	
    14	def make_run(root, launches, last_calls):
    15	    """Six complete draws; each old draw's store holds one model call at its last-call time; new draws opened no question."""
    16	    for draw in ('new-1', 'new-2', 'new-3', 'old-1', 'old-2', 'old-3'):
    17	        folder = root / draw
    18	        folder.mkdir(parents=True)
    19	        component = 'prod' if draw.startswith('old') else 'judge'
    20	        state = 'completed' if draw.startswith('old') else 'skipped'
    21	        (folder / 'run.json').write_text(json.dumps({'identity': {'label': draw}, 'state': 'complete', 'components': {
    22	            component: {'state': state, 'folder': component, 'attempts': [{'folder': component, 'state': 'completed',
    23	                                                                            'started at': launches[draw]}]}}}))
    24	        (folder / component).mkdir()
    25	        conn = sqlite3.connect(folder / component / 'archive.sqlite')
    26	        conn.execute('create table model_calls (call_id integer primary key, created_at text)')
    27	        conn.execute('insert into model_calls (created_at) values (?)', (last_calls[draw],))
    28	        conn.commit()
    29	        conn.close()
    30	        (folder / component / 'views.sqlite').write_bytes(b'')
    31	
    32	
    33	LAUNCH = {d: '2026-11-17T22:36:0%d-0800' % n for n, d in enumerate(('new-1', 'new-2', 'new-3', 'old-1', 'old-2', 'old-3'))}
    34	CALLS = {d: '2026-11-18T18:00:00' for d in LAUNCH}
    35	
    36	
    37	def test_six_complete_draws_inside_both_windows_are_eligible(tmp_path):
    38	    """D667: launched within one hour, every stored call within 72 h of the first launch."""
    39	    make_run(tmp_path, LAUNCH, CALLS)
    40	    result = eligibility.check(tmp_path)
    41	    assert result['eligible'], result['problems']
    42	    assert result['draws']['old-1']['stores']['archive.sqlite']['sha256']
    43	
    44	
    45	def test_a_launch_over_an_hour_apart_or_a_call_after_72_hours_is_not_eligible(tmp_path):
    46	    """D667: either window broken leaves no release verdict."""
    47	    make_run(tmp_path / 'a', dict(LAUNCH, **{'old-3': '2026-11-17T23:40:00-0800'}), CALLS)
    48	    assert not eligibility.check(tmp_path / 'a')['eligible']
    49	    make_run(tmp_path / 'b', LAUNCH, dict(CALLS, **{'new-2': '2026-11-17T22:36:00', 'old-2': '2026-11-20T23:00:00'}))
    50	    result = eligibility.check(tmp_path / 'b')
    51	    assert not result['eligible'] and 'old-2' in result['problems'][0]

