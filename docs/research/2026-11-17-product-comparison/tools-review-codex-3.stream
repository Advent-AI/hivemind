   116	    out.mkdir()
   117	    draws = ['new-1', 'new-2', 'new-3', 'old-1', 'old-2', 'old-3']
   118	    (keys / 'mapping-key.json').write_text(json.dumps({d: f'L{n}' for n, d in enumerate(draws, 1)}))
   119	    for n, d in enumerate(draws, 1):
   120	        lib = [{'question_id': f'Q{k}', 'source_id': f'v{2 * k - 1}', 'question': f'{d} question {k}', 'due': '2027-01-31', 'opened': '2026-07-10',
   121	                'type': 'yes/no', 'possible_answers': ['low', 'high'], 'answer': 'low', 'answer_index': 0, 'reasons': 'r', 'material': []}
   122	               for k in range(1, 5)]
   123	        (out / f'library-L{n}.json').write_text(json.dumps(lib))
   124	    (out / 'mapping.json').write_text(json.dumps({'mapping': {}, 'distinct': {}}))
   125	    def fake_run(family, prompt):
