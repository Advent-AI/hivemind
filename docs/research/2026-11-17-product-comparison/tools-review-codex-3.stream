   109	    question (the launcher's `skipped` judge)."""
   110	    root = Path(run_root) / draw
   111	    record = json.loads((root / 'run.json').read_text())
   112	    if record.get('state') != 'complete':
   113	        raise SystemExit(f'refused: {draw} is {record.get("state")!r}, not complete; no release verdict without six complete draws')
   114	    if draw.startswith('new'):
   115	        judge = record['components']['judge']
   116	        if judge['state'] == 'skipped':
   117	            return None
   118	        inner = json.loads((root / judge['folder'] / 'run.json').read_text())[draw]
   119	        if inner.get('state') != 'complete':
   120	            raise SystemExit(f'refused: {draw} judge is {inner.get("state")!r}')
   121	        folder = root / judge['folder'] / inner['attempts'][-1]['folder']
   122	    else:
   123	        folder = root / record['components']['prod']['folder']
   124	    return folder / 'views.sqlite', folder / 'archive.sqlite'
   125	
   126	
   127	def neutral_ids(lib):
   128	    """Q1..Qn in the library's opening order; the system's id kept as `source_id`."""
   129	    return [dict(e, question_id=f'Q{n}', source_id=e['question_id']) for n, e in enumerate(lib, 1)]
   130	
   131	
   132	def answer_problem(rows, keys, ids):
   133	    """Why a reader's mapping answer is void, or None: every matter exactly once with a known status, every id named in the library, every
   134	    duplicate pair two different ids of the library."""
   135	    matter_rows = [r for r in rows if r.get('matter')]
   136	    named = [r['matter'] for r in matter_rows]
   137	    if sorted(named) != sorted(keys):
   138	        return f'matters answered {len(named)} ({len(set(keys) - set(named))} missing, {len(named) - len(set(named))} repeated)'
   139	    for r in matter_rows:
   140	        if r.get('status') not in ('opened', 'narrower', 'broader', 'missed'):
   141	            return f"{r['matter']}: status {r.get('status')!r}"
   142	        if r['status'] in ('opened', 'narrower') and not r.get('ids'):
   143	            return f"{r['matter']}: {r['status']} names no id"
   144	        if r['status'] == 'narrower' and not isinstance(r.get('main_outcome'), bool):
   145	            return f"{r['matter']}: narrower without a main-outcome judgement"
   146	        unknown = [q for q in (r.get('ids') or []) if str(q) not in ids]
   147	        if unknown:
   148	            return f"{r['matter']}: ids not in the library {unknown}"
   149	    for r in rows:
   150	        if r.get('duplicate') is not None:
   151	            pair = {str(r['duplicate']), str(r.get('of'))}
   152	            if len(pair) != 2 or not pair <= ids:
   153	                return f"duplicate pair not two library ids: {r}"
   154	    return None
   155	
   156	
   157	def export(run_root, out, eligibility_path):
   158	    eligibility = json.loads(Path(eligibility_path).read_text())
   159	    if not eligibility.get('eligible'):
   160	        raise SystemExit(f"refused: the draws are not eligible: {eligibility.get('problems')}")
   161	    out = Path(out)
   162	    out.mkdir(parents=True, exist_ok=False)
   163	    labels = [f'L{n}' for n in range(1, len(DRAWS) + 1)]
   164	    random.Random(20261117).shuffle(labels)
   165	    key = dict(zip(DRAWS, labels))
   166	    KEY_FOLDER.mkdir(parents=True, exist_ok=True)
   167	    if (KEY_FOLDER / 'mapping-key.json').exists():
   168	        raise SystemExit(f"refused: {KEY_FOLDER / 'mapping-key.json'} exists; an export never overwrites a key")
   169	    (KEY_FOLDER / 'mapping-key.json').write_text(json.dumps(key, indent=1) + '\n')
   170	    (out / 'eligibility.json').write_text(Path(eligibility_path).read_text())
   171	    import eligibility as eligibility_tool
   172	    for draw, label in key.items():
   173	        paths = store_paths(run_root, draw)
   174	        for p in paths or ():
   175	            if eligibility_tool.sha256(p) != eligibility['draws'][draw]['stores'][Path(p).name]['sha256']:
   176	                raise SystemExit(f'refused: {p} changed since the eligibility check')
   177	        lib = neutral_ids(build_cards.library(*paths, ITEMS)) if paths else []
   178	        (out / f'library-{label}.json').write_text(json.dumps(lib, indent=1, ensure_ascii=False) + '\n')
   179	    print('exported', len(key), 'libraries; key in', KEY_FOLDER / 'mapping-key.json')
   180	
   181	
   182	def read(out):
   183	    out = Path(out)
   184	    text, keys = matters_text()
   185	    jobs = []
   186	    for path in sorted(out.glob('library-L*.json')):
   187	        label = path.stem.split('-', 1)[1]
   188	        lib = json.loads(path.read_text())
   189	        prompt = READ.format(matters=text, label=label, library=library_text(lib))
   190	        ids = {e['question_id'] for e in lib}
   191	        for family in FAMILIES:
   192	            dest = out / f'map-{label}-{family}.txt'
   193	            if not dest.exists():
   194	                jobs.append((family, prompt, ids, dest))
   195	
   196	    def one(job):
   197	        family, prompt, ids, dest = job
   198	        for attempt in (1, 2):
   199	            answer, void = census_readers.run(family, prompt)
   200	            if answer and not void:
   201	                void = answer_problem(json_lines(answer), keys, ids)
   202	                if void is None:
   203	                    dest.write_text(answer)
   204	                    return dest.name, None
   205	        return dest.name, void
   206	    with concurrent.futures.ThreadPoolExecutor(max_workers=6) as pool:
   207	        for name, void in pool.map(one, jobs):
   208	            print(name, 'VOID ' + void if void else 'mapped', flush=True)
   209	
   210	
   211	def marks(out, label, family):
   212	    """{matter: covering ids} and the set of duplicates (the later-opened id of every pair named), from one family's valid answer."""
   213	    path = Path(out) / f'map-{label}-{family}.txt'
   214	    if not path.exists():
   215	        raise SystemExit(f'refused: {path.name} missing (a void mapping is never counted)')
   216	    rows = json_lines(path.read_text())
   217	    order = {e['question_id']: k for k, e in enumerate(json.loads((Path(out) / f'library-{label}.json').read_text()))}
   218	    covering = {}
   219	    for r in rows:
   220	        if r.get('matter') and r.get('status') in ('opened', 'narrower'):
   221	            if r['status'] == 'opened' or r.get('main_outcome') is True:
   222	                for q in r.get('ids') or []:
   223	                    covering.setdefault(r['matter'], set()).add(str(q))
   224	    duplicates = {max(str(r['duplicate']), str(r['of']), key=order.__getitem__) for r in rows if r.get('duplicate') is not None}
   225	    return covering, duplicates
   226	
   227	
   228	def disagreements(out):
   229	    out = Path(out)
   230	    split = []
   231	    for path in sorted(out.glob('library-L*.json')):
   232	        label = path.stem.split('-', 1)[1]
   233	        a, _ = marks(out, label, 'codex')
   234	        b, _ = marks(out, label, 'claude')
   235	        for matter in sorted(set(a) | set(b)):
   236	            for q in sorted(a.get(matter, set()) ^ b.get(matter, set())):
   237	                split.append((label, matter, q))
   238	    return split
   239	
   240	
   241	def opening_article(input_id):
   242	    """The opening article as week reading A2 showed it: title, publisher, day and text, from the comparison's item database."""
   243	    conn = build_cards.ro(ITEMS)
   244	    row = conn.execute('select title, publisher, publication_day, text from items where input_id=?', (input_id,)).fetchone()
   245	    if row is None:
   246	        return '(not an article: the question was not opened from a stored article)'
   247	    return f"{row['title']} · {row['publisher']} · {row['publication_day']}\n\n{row['text']}"
   248	
   249	
   250	def third(out):
   251	    out = Path(out)
   252	    m = {x['matter']: x for x in json.loads(MATTERS.read_text())['matters']}
   253	    libs = {p.stem.split('-', 1)[1]: {e['question_id']: e for e in json.loads(p.read_text())} for p in out.glob('library-L*.json')}
   254	    jobs = []
   255	    for label, matter, q in disagreements(out):
   256	        entry = libs[label][q]
   257	        for reader in FAMILIES:
   258	            dest = out / 'third' / f'{label}--{matter}--{q}--{reader}.json'
   259	            if not dest.exists():
   260	                question = f"{entry['question']} (due {entry['due']}); possible answers: " + ' | '.join(entry['possible_answers'])
   261	                jobs.append((reader, THIRD.format(matter=f"{m[matter]['name']} (e.g. {m[matter]['question']})", question=question,
   262	                                                  article=opening_article(entry.get('opened_from'))), dest))
   263	
   264	    def one(job):
   265	        reader, prompt, dest = job
   266	        for attempt in (1, 2):
   267	            answer, void = census_readers.run(reader, prompt)
   268	            rows = json_lines(answer) if answer else []
   269	            if rows and isinstance(rows[-1].get('covers'), bool) and not void:
   270	                dest.parent.mkdir(exist_ok=True)
   271	                dest.write_text(json.dumps(rows[-1], ensure_ascii=False) + '\n')
   272	                return dest.name, None
   273	        return dest.name, void or 'no covers mark'
   274	    print(len(jobs), 'third-reader sessions')
   275	    with concurrent.futures.ThreadPoolExecutor(max_workers=6) as pool:
   276	        for name, void in pool.map(one, jobs):
   277	            print(name, 'VOID ' + void if void else 'marked', flush=True)
   278	
   279	
   280	def result(out):
   281	    out = Path(out)
   282	    key = json.loads((KEY_FOLDER / 'mapping-key.json').read_text())
   283	    label_of = {d: l for d, l in key.items()}
   284	    mapping, distinct = {}, {}
   285	    for draw, label in label_of.items():
   286	        a, dup_a = marks(out, label, 'codex')
   287	        b, dup_b = marks(out, label, 'claude')
   288	        lib = json.loads((out / f'library-{label}.json').read_text())
   289	        mapping[draw] = {}
   290	        for matter in sorted(set(a) | set(b)):
   291	            entries = []
   292	            for q in sorted(a.get(matter, set()) | b.get(matter, set())):
   293	                if q in a.get(matter, set()) and q in b.get(matter, set()):
   294	                    covers = True
   295	                else:
   296	                    paths = [out / 'third' / f'{label}--{matter}--{q}--{reader}.json' for reader in FAMILIES]
   297	                    missing = [p.name for p in paths if not p.exists()]
   298	                    if missing:
   299	                        raise SystemExit(f'refused: third-reader marks missing {missing}')
   300	                    thirds = [json.loads(p.read_text())['covers'] for p in paths]
   301	                    covers = True if thirds == [True, True] else False if thirds == [False, False] else 'split'
   302	                entries.append({'question': q, 'covers': covers})
   303	            if any(e['covers'] is not False for e in entries):
   304	                mapping[draw][matter] = [e for e in entries if e['covers'] is not False]
   305	        distinct[draw] = {'ids': len(lib), 'duplicates_both': len(dup_a & dup_b), 'duplicates_split': len(dup_a ^ dup_b)}
   306	    text = json.dumps({'mapping': mapping, 'distinct': distinct,
   307	                       'eligibility_sha256': hashlib.sha256((out / 'eligibility.json').read_bytes()).hexdigest()},
   308	                      indent=1, ensure_ascii=False) + '\n'
   309	    (out / 'mapping.json').write_text(text)
   310	    print('mapping.json written', hashlib.sha256(text.encode()).hexdigest()[:16])
   311	
   312	
   313	if __name__ == '__main__':
