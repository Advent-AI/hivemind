   100	RUNNER = r'''
   101	import json, sys, types
   102	from pathlib import Path
   103	here, module, changes, test_file, tests = sys.argv[1], sys.argv[2], json.loads(sys.argv[3]), sys.argv[4], json.loads(sys.argv[5])
   104	sys.path[:0] = [here, here + '/census']
   105	path = Path(here) / f'{module}.py'
   106	source = path.read_text()
   107	for old, new in changes:
   108	    if source.count(old) != 1:
   109	        print('MUTANT DID NOT APPLY:', old[:80])
   110	        sys.exit(3)
   111	    source = source.replace(old, new)
   112	mutant = types.ModuleType(module)
   113	mutant.__file__ = str(path)
   114	sys.modules[module] = mutant
   115	exec(compile(source, str(path), 'exec'), mutant.__dict__)
   116	import pytest
   117	args = ['-q', '-p', 'no:cacheprovider', str(Path(here) / test_file)] + (['-k', ' or '.join(tests)] if tests else [])
   118	sys.exit(pytest.main(args))
   119	'''
   120	
   121	
   122	def main():
   123	    lines, wrong = [], 0
   124	    for name, module, changes, test_file, tests in MUTANTS:
   125	        done = subprocess.run([sys.executable, '-c', RUNNER, str(HERE), module, json.dumps(changes), test_file, json.dumps(tests)],
   126	                              capture_output=True, text=True, env={'PYTHONDONTWRITEBYTECODE': '1', 'PATH': '/usr/bin:/bin'})
   127	        expected = 0 if name.startswith('control') else 1
   128	        tail = [l for l in done.stdout.splitlines() if l.startswith('E ') or l.startswith('MUTANT DID NOT APPLY') or ' passed' in l or ' failed' in l]
   129	        ok = done.returncode == expected
   130	        wrong += not ok
   131	        lines.append(f"== {name}: exit {done.returncode}, {'as predicted' if ok else 'NOT AS PREDICTED'} | " + ' | '.join(tail[:2] + tail[-1:]))
   132	    print('\n'.join(lines))
   133	    print('all as predicted' if not wrong else f'{wrong} NOT AS PREDICTED')
   134	    return wrong
   135	
   136	
   137	if __name__ == '__main__':
   138	    sys.exit(main())

