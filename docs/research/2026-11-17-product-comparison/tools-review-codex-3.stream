    63	            problems.append(f"{draw}: its record names label {record.get('identity', {}).get('label')!r}")
    64	        starts = [local(a['started at']) for c in record['components'].values() for a in c.get('attempts', []) if a.get('started at')]
    65	        paths = mapping.store_paths(run_root, draw)                    # refuses an incomplete draw
    66	        latest, databases = last_call(run_root / draw)
    67	        draws[draw] = {'launch': min(starts).isoformat() if starts else None, 'last call': latest.isoformat() if latest else None,
    68	                       'databases with calls': databases,
