   151	class Draw:
   152	    def __init__(self, kind, root, label, ledger_path, options, run_component=execute, run_check=check):
   153	        self.kind, self.label, self.options = kind, label, dict(options)
   154	        self.folder = Path(root) / label
   155	        self.ledger_path = Path(ledger_path).resolve()
   156	        self.ledger = budget_replay.SharedLedger(self.ledger_path)
   157	        self.run_component, self.run_check = run_component, run_check
   158	        self.record_path = self.folder / 'run.json'
   159	        self.lock_path = self.folder / 'launch.lock'
   160	        self.child = None
   161	
   162	    # the record
   163	    def identity(self):
   164	        return {'kind': self.kind, 'label': self.label, 'ledger': str(self.ledger_path), 'options': dict(self.options)}
   165	
   166	    def load(self):
   167	        if self.record_path.exists():
   168	            return json.loads(self.record_path.read_text())
   169	        return {'identity': self.identity(), 'state': 'running', 'components': {}}
   170	
   171	    def save(self, record):
   172	        temporary = self.record_path.with_suffix('.tmp')
   173	        temporary.write_text(json.dumps(record, indent=1) + '\n')
   174	        os.replace(temporary, self.record_path)
   175	
   176	    def stop_run(self, record, reason):
   177	        """A stop of the whole run: on the shared ledger first (every other draw stops at its next send), then here."""
   178	        self.ledger.stop(f'{self.label}: {reason}')
   179	        record['state'], record['stopped'] = 'stopped', reason
   180	        self.save(record)
   181	        return record
   182	
   183	    # one launch
   184	    def launch(self, redo=None, redo_reason=None):
   185	        if redo is not None and not (redo_reason or '').strip():
   186	            raise SystemExit('--redo needs --redo-reason: what in the component\'s output shows an eligible failure')
   187	        self.folder.mkdir(parents=True, exist_ok=True)
   188	        with open(self.lock_path, 'w') as lock:
   189	            if not self.ledger.claim_launcher(self.label, lock):    # the probe, this lock and the registration in one ledger-locked step
   190	                raise SystemExit(f'another launch of {self.label} is running')
