     1	"""The comparison's verdict (D665; `verdict-rule.json`, frozen before the first send; D672). Code applies the frozen rule to the readers'
     2	marks; it decides nothing the rule leaves open.
     3	
     4	    python3 score_comparison.py <readings.json>
     5	
     6	`readings.json` holds what the reading produces, by system-draw ('new-1'..'new-3', 'old-1'..'old-3'):
     7	  matters:      [{"matter": "M01", "company_figure": bool}, ...]                       (stage0/census/matters.json)
     8	  mapping:      {draw: {matter: [{"question": id, "covers": true|false|"split"}]}}     (blind mapping, third readers applied)
     9	  cards:        {draw: {question id: {"worth": mark, "answer": mark, "type": "figure"|"yes/no"|"other", "guardrail": bool,
    10	                                         "covering": true|false|"split"}}}
    11	                a mark is a final mark, or {"split": [mark given by one family, mark given by the other]}
    12	  distinct:     {draw: {"ids": n, "duplicates_both": n, "duplicates_split": n}}
    13	  controls:     {"plants": [mark, ...], "supported": [mark, ...], "repeats_same": [bool, ...]}
    14	  inputs:       {"matters_sha256", "mapping_sha256", "eligibility_sha256", "deck_key_sha256"}    (mark_cards.readings)
    15	Prints the verdict and every quantity behind it, under both countings.
    16	
    17	Readings of the frozen rule written here (D675): the guardrail shares hold the random sample's cards that cover no matter, as the rule's
    18	words say ("covering cards are not in the shares"); the 10-point bar is compared exactly, as fractions; a plant counts as explicitly rejected
    19	when every mark its readers left is unsupported or insufficient, split between the two or not. A guardrail card whose cover the third readers
    20	split is resolved per counting like any cover (covers > does not cover: covering, so out of the shares, for the favoured system). A supported
    21	control is accepted only when marked supported by both (a split is not accepted); a repeat is the same only when both of its final marks equal
    22	the original card's, splits included. No verdict without all six draws and the frozen matter list, and only on eligible draws.
    23	"""
    24	import hashlib
    25	import json
    26	import math
    27	import sys
    28	from fractions import Fraction
    29	from pathlib import Path
    30	
    31	DRAWS = ('new-1', 'new-2', 'new-3', 'old-1', 'old-2', 'old-3')
    32	MATTERS = Path(__file__).resolve().parent / 'census' / 'matters.json'
    33	REJECTED = ('unsupported', 'insufficient')
    34	
    35	RANK = {'answer': ['unsupported', 'insufficient', 'supported'], 'worth': ['trivia', 'duplicate', 'worth'], 'covers': [False, True]}
    36	SYSTEMS = ('new', 'old')
    37	
    38	
    39	def resolve(mark, kind, favoured):
    40	    """A final mark, or a split resolved to one of the marks its readers gave: the most favourable for a favoured system, the least for the
    41	    other (verdict-rule.json, countings). 'no answer' is never split."""
    42	    if not (isinstance(mark, dict) and 'split' in mark):
    43	        return mark
    44	    given = [m for m in mark['split'] if m in RANK[kind]]
    45	    if not given:
    46	        raise ValueError(f'a split of unknown marks: {mark}')
    47	    order = sorted(given, key=RANK[kind].index)
    48	    return order[-1] if favoured else order[0]
    49	
    50	
    51	def is_split(mark):
    52	    return isinstance(mark, dict) and 'split' in mark
    53	
    54	
    55	def system_of(draw):
    56	    return draw.split('-')[0]
    57	
    58	
    59	def served_by(readings, counting):
    60	    """{system: set of matters served in at least 2 of its 3 draws} under one counting ('1': new favoured, '2': old favoured)."""
    61	    favoured = 'new' if counting == '1' else 'old'
    62	    served_draws = {}
    63	    for draw, by_matter in readings['mapping'].items():
    64	        system = system_of(draw)
    65	        fav = system == favoured
    66	        for matter, questions in by_matter.items():
    67	            for q in questions:
    68	                covers = q['covers'] if q['covers'] != 'split' else fav       # covers > does not cover
    69	                if not covers:
    70	                    continue
    71	                card = readings['cards'][draw].get(q['question'])
    72	                if card is None:
    73	                    raise ValueError(f'{draw} {q["question"]}: a covering question has no card')
    74	                if card['answer'] == 'no answer':
    75	                    continue
    76	                if resolve(card['worth'], 'worth', fav) == 'worth' and resolve(card['answer'], 'answer', fav) == 'supported':
    77	                    served_draws.setdefault((system, matter), set()).add(draw)
    78	                    break
    79	    return {s: {m for (sys_, m), draws in served_draws.items() if sys_ == s and len(draws) >= 2} for s in SYSTEMS}
    80	
    81	
    82	def guardrails(readings, counting):
    83	    """Per system: the three shares over its pooled guardrail cards, and whether each subgroup is exercised (10 unsplit decided cards)."""
    84	    favoured = 'new' if counting == '1' else 'old'
    85	    out = {}
    86	    for system in SYSTEMS:
    87	        fav = system == favoured
    88	        counts = {'figure': [0, 0, 0], 'yes/no': [0, 0, 0], 'worth': [0, 0, 0]}     # [bad, decided, decided without a split]
    89	        for draw, cards in readings['cards'].items():
    90	            if system_of(draw) != system:
    91	                continue
    92	            for card in cards.values():
    93	                covering = card['covering'] if card['covering'] != 'split' else fav      # covers > does not cover
    94	                if not card['guardrail'] or covering:
    95	                    continue
    96	                if card['type'] in ('figure', 'yes/no') and card['answer'] != 'no answer':
    97	                    answer = resolve(card['answer'], 'answer', fav)
    98	                    if answer in ('supported', 'unsupported'):
    99	                        c = counts[card['type']]
   100	                        c[0] += answer == 'unsupported'
   101	                        c[1] += 1
   102	                        c[2] += not is_split(card['answer'])
   103	                worth = resolve(card['worth'], 'worth', fav)
   104	                c = counts['worth']
   105	                c[0] += worth in ('trivia', 'duplicate')
   106	                c[1] += 1
   107	                c[2] += not is_split(card['worth'])
   108	        out[system] = {k: {'share': Fraction(v[0], v[1]) if v[1] else None, 'bad': v[0], 'decided': v[1], 'unsplit': v[2]} for k, v in counts.items()}
   109	    result = {}
   110	    for k in ('figure', 'yes/no', 'worth'):
   111	        new, old = out['new'][k], out['old'][k]
   112	        exercised = new['unsplit'] >= 10 and old['unsplit'] >= 10
   113	        breach = exercised and (new['share'] - old['share']) > Fraction(1, 10)
   114	        result[k] = {'new': new, 'old': old, 'exercised': exercised, 'breach': breach}
   115	    return result
   116	
   117	
   118	def beside(readings, per_counting):
   119	    """What the rule prints beside the verdict (verdict-rule.json `printed_beside`, `guardrails.beside`)."""
   120	    figure = {m['matter'] for m in readings['matters'] if m['company_figure']}
   121	    out = {'company-figure subgroup': {c: {'N': len(figure), 'a': len((set(v['served_new']) - set(v['served_old'])) & figure),
   122	                                            'b': len((set(v['served_old']) - set(v['served_new'])) & figure)} for c, v in per_counting.items()}}
   123	    counts = {}
   124	    for draw, cards in readings['cards'].items():
   125	        system = system_of(draw)
   126	        c = counts.setdefault(system, {'insufficient': 0, 'no answer': 0, 'split worth': 0, 'split answer': 0, 'cards': 0})
   127	        for card in cards.values():
   128	            c['cards'] += 1
   129	            c['insufficient'] += card['answer'] == 'insufficient'
   130	            c['no answer'] += card['answer'] == 'no answer'
   131	            c['split worth'] += is_split(card['worth'])
   132	            c['split answer'] += is_split(card['answer'])
   133	    out['marks'] = counts
   134	    resolutions = {}
   135	    for c in per_counting:
   136	        favoured = 'new' if c == '1' else 'old'
   137	        tally = {}
   138	        for draw, cards in readings['cards'].items():
   139	            fav = system_of(draw) == favoured
   140	            for card in cards.values():
   141	                for kind in ('worth', 'answer'):
   142	                    if is_split(card[kind]):
   143	                        key = f'{system_of(draw)} {kind} split resolved to {resolve(card[kind], kind, fav)}'
   144	                        tally[key] = tally.get(key, 0) + 1
   145	                if card['covering'] == 'split':
   146	                    key = f"{system_of(draw)} cover split resolved to {'covers' if fav else 'does not cover'}"
   147	                    tally[key] = tally.get(key, 0) + 1
   148	        resolutions[c] = tally
   149	    out['split resolutions'] = resolutions
   150	    return out
   151	
   152	
   153	def verdict(readings):
   154	    inputs = readings.get('inputs') or {}
   155	    if inputs.get('matters_sha256') != hashlib.sha256(MATTERS.read_bytes()).hexdigest():
   156	        raise SystemExit('refused: the readings were not made on the frozen matter list')
   157	    for k in ('mapping_sha256', 'eligibility_sha256', 'deck_key_sha256'):
   158	        if not inputs.get(k):
   159	            raise SystemExit(f'refused: the readings carry no {k}')
   160	    present = {k: sorted(readings[k]) for k in ('mapping', 'cards', 'distinct')}
   161	    for k, draws in present.items():
   162	        if sorted(DRAWS) != draws:
   163	            raise SystemExit(f'refused: readings[{k!r}] holds {draws}, not the six draws {list(DRAWS)}')
   164	    n = len(readings['matters'])
   165	    controls = readings['controls']
   166	    report = {'N': n}
   167	    invalid = []
   168	    def rejected(m):
   169	        return m in REJECTED or (isinstance(m, dict) and 'split' in m and all(x in REJECTED for x in m['split']))
   170	    if any(not rejected(m) for m in controls['plants']):
   171	        invalid.append('a planted wrong answer without an explicit rejection')
   172	    if sum(m == 'supported' for m in controls['supported']) < 3:
   173	        invalid.append('fewer than 3 of 4 supported controls accepted')
   174	    if sum(bool(x) for x in controls['repeats_same']) < 2:
   175	        invalid.append('fewer than 2 of 3 repeats marked the same')
   176	    if len(controls['plants']) != 6 or len(controls['supported']) != 4 or len(controls['repeats_same']) != 3:
   177	        invalid.append('the deck does not hold 6 plants, 4 supported controls and 3 repeats')
   178	    if invalid:
   179	        return dict(report, verdict='invalid', why=invalid)
   180	    small = []
   181	    if n < 20:
   182	        small.append(f'N = {n} < 20')
   183	    for draw, d in readings['distinct'].items():
   184	        both_ways = (d['ids'] - d['duplicates_both'], d['ids'] - d['duplicates_both'] - d['duplicates_split'])
   185	        if min(both_ways) < 30:
   186	            small.append(f'{draw}: {both_ways} distinct bets')
   187	    if small:
   188	        return dict(report, verdict='too small', why=small)
   189	    margin = max(3, math.ceil(0.15 * n))
   190	    per_counting = {}
   191	    for counting in ('1', '2'):
   192	        served = served_by(readings, counting)
   193	        a = len(served['new'] - served['old'])
   194	        b = len(served['old'] - served['new'])
   195	        per_counting[counting] = {'a': a, 'b': b, 'served_new': sorted(served['new']), 'served_old': sorted(served['old']),
   196	                                  'guardrails': guardrails(readings, counting)}
   197	    report['margin'] = margin
   198	    report['countings'] = per_counting
   199	    report['beside'] = beside(readings, per_counting)
   200	    lead = all(c['a'] - c['b'] >= margin and c['a'] >= 2 * c['b'] for c in per_counting.values())
   201	    all_exercised_pass = all(g['exercised'] and not g['breach'] for c in per_counting.values() for g in c['guardrails'].values())
   202	    if lead and all_exercised_pass:
   203	        return dict(report, verdict='practical lead')
   204	    loss_count = all(c['b'] - c['a'] >= margin and c['b'] >= 2 * c['a'] for c in per_counting.values())
   205	    breaches = {k for k in ('figure', 'yes/no', 'worth') if all(c['guardrails'][k]['breach'] for c in per_counting.values())}
   206	    if loss_count or breaches:
   207	        return dict(report, verdict='practical loss', why=(['served matters'] if loss_count else []) + [f'guardrail {k}' for k in sorted(breaches)])
   208	    return dict(report, verdict='no practical winner')
   209	
   210	
   211	if __name__ == '__main__':
   212	    print(json.dumps(verdict(json.loads(open(sys.argv[1]).read())), indent=1, ensure_ascii=False, default=str))

