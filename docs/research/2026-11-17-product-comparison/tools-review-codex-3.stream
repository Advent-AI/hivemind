   280	def readings(mapping_out, folder):
   281	    folder = Path(folder)
   282	    for n in (0, 1, 2):
   283	        if not (folder / f'round-{n}.done').exists():
   284	            raise SystemExit(f'refused: round {n} is not complete')
   285	    key = json.loads(KEY.read_text())
   286	    matters = [{'matter': m['matter'], 'company_figure': m['company_figure']} for m in json.loads(mapping_tool.MATTERS.read_text())['matters']]
   287	    mapped_text = (Path(mapping_out) / 'mapping.json').read_bytes()
   288	    mapped = json.loads(mapped_text)
   289	    cards, plants, supported, repeats = {}, [], [], []
   290	    by_question = {}
   291	    for cid, k in sorted(key.items()):
   292	        f = final(folder, cid)
   293	        answer = f['answer'] if k['answered'] else 'no answer'
   294	        if k['role'] == 'product':
   295	            cards.setdefault(k['draw'], {})[k['question']] = {'worth': f['worth'], 'answer': answer, 'type': k['type'], 'guardrail': k['guardrail'],
   296	                                                              'covering': k['covering']}
   297	            by_question[(k['draw'], k['question'])] = (f['worth'], answer)
   298	        elif k['role'] == 'plant':
   299	            plants.append(answer)
   300	        elif k['role'] == 'supported control':
   301	            supported.append(answer)
   302	    for cid, k in sorted(key.items()):
   303	        if k['role'] == 'repeat':
   304	            f = final(folder, cid)
   305	            answer = f['answer'] if k['answered'] else 'no answer'
   306	            repeats.append((f['worth'], answer) == by_question[(k['draw'], k['question'])])
   307	    out = {'matters': matters, 'mapping': mapped['mapping'], 'distinct': mapped['distinct'], 'cards': cards,
   308	           'controls': {'plants': plants, 'supported': supported, 'repeats_same': repeats},
   309	           'inputs': {'matters_sha256': hashlib.sha256(mapping_tool.MATTERS.read_bytes()).hexdigest(),
   310	                      'mapping_sha256': hashlib.sha256(mapped_text).hexdigest(), 'eligibility_sha256': mapped['eligibility_sha256'],
   311	                      'deck_key_sha256': hashlib.sha256(KEY.read_bytes()).hexdigest()}}
   312	    (folder / 'readings.json').write_text(json.dumps(out, indent=1, ensure_ascii=False) + '\n')
   313	    print('readings.json written')
