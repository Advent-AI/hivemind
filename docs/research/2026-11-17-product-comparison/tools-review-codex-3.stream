    16	def base(n=20, new_served=0, old_served=0, guard_cards=12):
    17	    """N matters; the first `new_served` served by the new system in all draws, the next `old_served` by the old one; every draw has
    18	    `guard_cards` guardrail cards of each type, all supported and worth (no breach)."""
    19	    matters = [{'matter': f'M{i:02d}', 'company_figure': False} for i in range(1, n + 1)]
    20	    mapping = {d: {} for d in DRAWS}
    21	    cards = {d: {} for d in DRAWS}
    22	    for i, m in enumerate(matters):
    23	        for d in DRAWS:
    24	            system = d.split('-')[0]
    25	            served = (system == 'new' and i < new_served) or (system == 'old' and new_served <= i < new_served + old_served)
    26	            if served:
    27	                q = f'{d}-q{i}'
    28	                mapping[d][m['matter']] = [{'question': q, 'covers': True}]
    29	                cards[d][q] = {'worth': 'worth', 'answer': 'supported', 'type': 'figure', 'guardrail': False, 'covering': True}
    30	    for d in DRAWS:
    31	        for t in ('figure', 'yes/no'):
    32	            for j in range(guard_cards):
    33	                cards[d][f'{d}-g-{t}-{j}'] = {'worth': 'worth', 'answer': 'supported', 'type': t, 'guardrail': True, 'covering': False}
    34	    return {'matters': matters, 'mapping': mapping, 'cards': cards,
    35	            'distinct': {d: {'ids': 40, 'duplicates_both': 0, 'duplicates_split': 0} for d in DRAWS},
    36	            'controls': {'plants': ['unsupported'] * 6, 'supported': ['supported'] * 4, 'repeats_same': [True] * 3},
    37	            'inputs': {'matters_sha256': hashlib.sha256(sc.MATTERS.read_bytes()).hexdigest(), 'mapping_sha256': 'm',
    38	                       'eligibility_sha256': 'e', 'deck_key_sha256': 'k'}}
