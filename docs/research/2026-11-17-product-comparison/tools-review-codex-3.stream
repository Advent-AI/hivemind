    96	def plant(card_text, entry):
    97	    """The card with its latest answer moved one rung from the stored rung (the next rung, or the previous at the end), or None when no
    98	    adjacent rung differs."""
    99	    answers = entry['possible_answers']
   100	    k = entry.get('answer_index')
   101	    if k is None or not 0 <= k < len(answers) or answers[k] != entry['answer']:
   102	        return None
   103	    moved = answers[k + 1] if k + 1 < len(answers) else (answers[k - 1] if k > 0 else None)
   104	    if moved is None or moved == entry['answer']:
   105	        return None
   106	    planted = card_text.replace(f"Latest answer at the cutoff: {entry['answer']}", f'Latest answer at the cutoff: {moved}', 1)
   107	    return planted if planted != card_text else None
   108	
