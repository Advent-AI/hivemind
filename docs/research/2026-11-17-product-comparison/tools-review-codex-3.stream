    43	def last_call(draw_folder):
    44	    """The latest model call stored in any database under the draw's folder, and how many databases hold calls."""
    45	    latest, databases = None, 0
    46	    for path in sorted(Path(draw_folder).rglob('*.sqlite')):
    47	        conn = sqlite3.connect(f'file:{path}?mode=ro&immutable=1', uri=True)
    48	        if not conn.execute("select 1 from sqlite_master where type='table' and name='model_calls'").fetchone():
    49	            continue
    50	        databases += 1
    51	        stamp = conn.execute('select max(created_at) from model_calls').fetchone()[0]
    52	        if stamp and (latest is None or local(stamp) > latest):
    53	            latest = local(stamp)
    54	    return latest, databases
