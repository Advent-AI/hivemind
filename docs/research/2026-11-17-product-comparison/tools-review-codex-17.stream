   280	def verify_inputs(readings):
   281	    """Refuses readings that were not made from the frozen matter list, the mapping file, a passing eligibility check and the deck key
   282	    they name: each file is read again and compared with what the readings carry."""
   283	    inputs = readings.get('inputs') or {}
   284	    def read(kind):
   285	        path = Path(inputs.get(f'{kind}_path') or '/nonexistent')
   286	        if not path.exists() or hashlib.sha256(path.read_bytes()).hexdigest() != inputs.get(f'{kind}_sha256'):
   287	            raise SystemExit(f'refused: the {kind} file the readings name is missing or differs from its fingerprint')
   288	        return json.loads(path.read_text())
   289	    frozen = [{'matter': m['matter'], 'company_figure': m['company_figure']} for m in json.loads(MATTERS.read_text())['matters']]
   290	    if readings['matters'] != frozen or inputs.get('matters_sha256') != hashlib.sha256(MATTERS.read_bytes()).hexdigest():
   291	        raise SystemExit('refused: the readings were not made on the frozen matter list')
   292	    mapped, eligibility, key = read('mapping'), read('eligibility'), read('deck_key')
   293	    if mapped['mapping'] != readings['mapping'] or mapped['distinct'] != readings['distinct']:
   294	        raise SystemExit('refused: the readings\' mapping differs from the mapping file')
   295	    if mapped.get('eligibility_sha256') != inputs['eligibility_sha256'] or eligibility.get('eligible') is not True:
   296	        raise SystemExit('refused: the mapping was not made from a passing eligibility check')
   297	    keyed = {}
   298	    for k in key.values():
   299	        if k['role'] == 'product':
   300	            keyed.setdefault(k['draw'], {})[k['question']] = {f: k[f] for f in ('guardrail', 'covering', 'type')}
   301	    held = {draw: {q: {f: card[f] for f in ('guardrail', 'covering', 'type')} for q, card in cards.items()} for draw, cards in readings['cards'].items()}
   302	    if keyed != held:
   303	        raise SystemExit('refused: the readings\' cards, or their guardrail, covering or type marks, are not the deck key\'s product cards')
