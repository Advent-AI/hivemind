   438	def days_to_opening(readings):
   439	    """Per draw and covered matter: days from the matter's earliest listed article to the first covering question's opening. A question
   440	    opened before the scored window (09-07) is 'opened in the warm-up'; one opened in the window before the matter's first listed article
   441	    is 'opened before the first listed article'."""
   442	    import datetime
   443	    out = {}
   444	    for draw, by_matter in readings['mapping'].items():
   445	        for matter, questions in by_matter.items():
   446	            opened = [readings['cards'][draw][q['question']].get('opened') for q in questions if q['covers'] is True]
   447	            opened = [d for d in opened if d]
   448	            first = readings.get('matter_first_day', {}).get(matter)
   449	            if not opened or not first:
   450	                continue
   451	            days = (datetime.date.fromisoformat(min(opened)) - datetime.date.fromisoformat(first)).days
   452	            out.setdefault(matter, {})[draw] = (days if days >= 0 else 'opened in the warm-up' if min(opened) < '2026-09-07'
   453	                                                else 'opened before the first listed article')
   454	    return out
