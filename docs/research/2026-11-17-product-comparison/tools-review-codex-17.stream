   300	def readings(mapping_out, folder):
   301	    folder = Path(folder)
   302	    for n in (0, 1, 2):
   303	        if not (folder / f'round-{n}.done').exists():
   304	            raise SystemExit(f'refused: round {n} is not complete')
   305	    key = json.loads(KEY.read_text())
   306	    matters = [{'matter': m['matter'], 'company_figure': m['company_figure']} for m in json.loads(mapping_tool.MATTERS.read_text())['matters']]
   307	    mapped_text = (Path(mapping_out) / 'mapping.json').read_bytes()
   308	    mapped = json.loads(mapped_text)
   309	    cards, plants, supported, repeats = {}, [], [], []
   310	    by_question = {}
   311	    for cid, k in sorted(key.items()):
   312	        f = final(folder, cid)
   313	        answer = f['answer'] if k['answered'] else 'no answer'
   314	        if k['role'] == 'product':
   315	            cards.setdefault(k['draw'], {})[k['question']] = {'worth': f['worth'], 'answer': answer, 'type': k['type'], 'guardrail': k['guardrail'],
   316	                                                              'covering': k['covering'], 'opened': k.get('opened')}
   317	            by_question[(k['draw'], k['question'])] = (f['worth'], answer)
   318	        elif k['role'] == 'plant':
   319	            plants.append(answer)
   320	        elif k['role'] == 'supported control':
   321	            supported.append(answer)
   322	    for cid, k in sorted(key.items()):
   323	        if k['role'] == 'repeat':
   324	            f = final(folder, cid)
   325	            answer = f['answer'] if k['answered'] else 'no answer'
   326	            repeats.append((f['worth'], answer) == by_question[(k['draw'], k['question'])])
   327	    out = {'matters': matters, 'matter_first_day': matter_first_days(), 'mapping': mapped['mapping'], 'distinct': mapped['distinct'], 'cards': cards,
   328	           'controls': {'plants': plants, 'supported': supported, 'repeats_same': repeats},
