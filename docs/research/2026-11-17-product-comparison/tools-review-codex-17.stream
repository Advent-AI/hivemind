import copy, hashlib, json, pathlib, subprocess, types
import score_comparison as new
import test_score_comparison as tests
old = types.ModuleType(\"previous_score_comparison\")
old.__file__ = new.__file__
p = \"docs/research/2026-11-17-product-comparison/stage0/score_comparison.py\"
exec(compile(subprocess.check_output([\"git\",\"--no-pager\",\"show\",\"81d32da4"'^:"+p],text=True),p,"exec"),old.__dict__)
class MemoryPath:
    files = {}
    def __init__(self, name): self.name = name
    def exists(self): return self.name in self.files or (self.name == "." and pathlib.Path(".").exists())
    def read_bytes(self): return pathlib.Path(".").read_bytes() if self.name == "." else self.files[self.name]
    def read_text(self): return self.read_bytes().decode()
def put(name,data):
    MemoryPath.files[name] = json.dumps(data).encode()
    return hashlib.sha256(MemoryPath.files[name]).hexdigest()
def seal(r):
    es = put("eligibility",{"eligible":True})
    key = {str(i):dict(role="product",draw=d,question=q,**{f:c[f] for f in ("guardrail","covering","type","opened") if f in c})
           for i,(d,q,c) in enumerate((d,q,c) for d,cards in r["cards"].items() for q,c in cards.items())}
    r["inputs"] = dict(matters_sha256=put("matters",{"matters":r["matters"]}),
                       mapping_path="map",mapping_sha256=put("map",dict(mapping=r["mapping"],distinct=r["distinct"],eligibility_sha256=es)),
                       deck_key_path="key",deck_key_sha256=put("key",key),eligibility_path="eligibility",eligibility_sha256=es)
    return r
for m in new,old:
    m.Path,m.MATTERS = MemoryPath,MemoryPath("matters")
tests.seal = seal
tests.test_malformed_readings_are_refused_before_any_verdict()
print("Committed malformed-input test passed in memory")
for n,a,b,invalid in ((32,10,2,False),(32,2,10,False),(32,5,4,False),(19,5,1,False),(32,5,1,True)):
    r = tests.base(n=n,new_served=a,old_served=b)
    r["matter_first_day"] = {m["matter"]:"2026-09-08" for m in r["matters"]}
    for cards in r["cards"].values():
        for c in cards.values():
            c["opened"]="2026-09-09"
    if invalid:
        r["controls"]["plants"][0]="supported"
    seal(r)
    prior, after = old.verdict(copy.deepcopy(r)),new.verdict(copy.deepcopy(r))
    assert json.dumps(prior,default=str)==json.dumps(after,default=str)
    print(after["verdict"],"serialized report matches parent")

r = tests.base(new_served=5,old_served=1)
r["matter_first_day"]={m["matter"]:"2026-09-08" for m in r["matters"]}
for cards in r["cards"].values():
    for c in cards.values():
        c["opened"]="2026-09-09"
seal(r)
normal=new.verdict(r)
for patch in ("drop_first_day","drop_opened","directory"):
    changed=copy.deepcopy(r)
    if patch=="drop_first_day":
        del changed["matter_first_day"]
    elif patch=="drop_opened":
        del changed["cards"]["new-1"]["new-1-q0"]["opened"]
    else:
        changed["inputs"]["mapping_path"]="."
    new.validate_readings(changed)
    try:
        out=new.verdict(changed)
        print(patch,out["verdict"],"M01 shown",out["beside"][new.DAYS_KEY].get("M01"),"instead of",normal["beside"][new.DAYS_KEY]["M01"])
    except IsADirectoryError as error:
        print(patch,type(error).__name__,str(error))
