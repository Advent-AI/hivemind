import hashlib, json
import score_comparison as scorer
from test_score_comparison import base

class MemoryPath:
    files = {}
    def __init__(self, name):
        self.name = name
    def exists(self):
        return self.name in self.files
    def read_bytes(self):
        return self.files[self.name]
    def read_text(self):
        return self.read_bytes().decode()

def put(name, data):
    MemoryPath.files[name] = json.dumps(data).encode()
    return hashlib.sha256(MemoryPath.files[name]).hexdigest()

def score(readings):
    eligibility = put(\"eligibility\", {\"eligible\": True})
    cards = [dict(draw=d, question=q, role=\"product\", **{f:c[f] for f in (\"guardrail\", \"covering\", \"type\")})
             for d, entries in readings[\"cards\"].items() for q,c in entries.items()]
    readings[\"inputs\"] = dict(
        matters_sha256=put(\"matters\", {\"matters\":readings[\"matters\"]}),
        mapping_path=\"mapping\", mapping_sha256=put(\"mapping\", {\"mapping\":readings[\"mapping\"], \"distinct\":readings[\"distinct\"], \"eligibility_sha256\":eligibility}),
        eligibility_path=\"eligibility\", eligibility_sha256=eligibility,
        deck_key_path=\"deck\", deck_key_sha256=put(\"deck\", dict(enumerate(cards))))
    scorer.verify_inputs(readings)
    return scorer.verdict(readings)

scorer.Path = MemoryPath
scorer.MATTERS = MemoryPath(\"matters\")
for n in (19,20):
    readings = base(n=n, new_served=5, old_served=1)
    if n == 20:
        readings[\"controls\"][\"repeats_same\"] = [False, False, True]
    readings[\"cards\"][\"new-1\"][\"new-1-q0\"][\"opened\"] = \"bad-date\"
    readings[\"matter_first_day\"] = {\"M01\": \"2026-09-08\"}
    print(score(readings))
    if n == 20:
        readings[\"distinct\"][\"new-1\"][\"ids\"] = None
        try:
            score(readings)
        except TypeError as error:
            print(\"Malformed size on invalid reading:\", error)
