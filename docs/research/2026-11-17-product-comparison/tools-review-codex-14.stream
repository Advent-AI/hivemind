   325	def days_to_opening(readings):
   326	    """Per draw and covered matter: days from the matter's earliest listed article to the first covering question's opening. A question
   327	    opened before the scored window (09-07) is 'opened in the warm-up'; one opened in the window before the matter's first listed article
   328	    is 'opened before the first listed article'."""
   329	    import datetime
   330	    out = {}
   331	    for draw, by_matter in readings['mapping'].items():
   332	        for matter, questions in by_matter.items():
   333	            opened = [readings['cards'][draw][q['question']].get('opened') for q in questions if q['covers'] is True]
   334	            opened = [d for d in opened if d]
   335	            first = readings.get('matter_first_day', {}).get(matter)
   336	            if not opened or not first:
   337	                continue
   338	            days = (datetime.date.fromisoformat(min(opened)) - datetime.date.fromisoformat(first)).days
   339	            out.setdefault(matter, {})[draw] = (days if days >= 0 else 'opened in the warm-up' if min(opened) < '2026-09-07'
   340	                                                else 'opened before the first listed article')
   341	    return out
