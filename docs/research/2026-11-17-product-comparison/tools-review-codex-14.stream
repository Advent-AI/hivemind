   196	def sign_test(a, b):
   197	    """Two-sided exact binomial p of a against b at one half, and the Wilson 95% interval of a / (a + b): illustrative only."""
   198	    n = a + b
   199	    if n == 0:
   200	        return {'discordant': 0, 'p': None, 'share': None, 'wilson95': None}
   201	    tail = sum(math.comb(n, k) for k in range(0, min(a, b) + 1)) / 2 ** n
   202	    z, phat = 1.959963984540054, a / n
   203	    centre = (phat + z * z / (2 * n)) / (1 + z * z / n)
   204	    half = z * math.sqrt(phat * (1 - phat) / n + z * z / (4 * n * n)) / (1 + z * z / n)
   205	    return {'discordant': n, 'p': min(1.0, 2 * tail), 'share': round(phat, 3), 'wilson95': [round(centre - half, 3), round(centre + half, 3)]}
   206	
   207	
