   222	                'yes/no unsupported': f"{yn['bad']}/{yn['decided']} against 5%" if yn['decided'] else 'none decided',
   223	                'latest answers unsupported': f"{latest_bad}/{latest_decided} against {float(D428_LATEST * latest_decided):.1f} (3 in 30 scaled)"
   224	                                              if latest_decided else 'none decided',
   225	                'latest answers insufficient (beside)': insufficient_count(readings, system, system == fav_system)}
   226	        out[c] = limits
