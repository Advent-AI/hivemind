import copy, hashlib, json, subprocess, types
import score_comparison as new
import test_score_comparison as tests

old = types.ModuleType(\"previous_score_comparison\")
old.__file__ = new.__file__
path = \"docs/research/2026-11-17-product-comparison/stage0/score_comparison.py\"
src = subprocess.check_output([\"git\", \"--no-pager\", \"show\", \"a9696395"'^:" + path], text=True)
exec(compile(src, path, "exec"), old.__dict__)

class MemoryPath:
    files = {}
    def __init__(self, name):
        self.name = name
    def exists(self):
        return self.name in self.files
    def read_bytes(self):
        return self.files[self.name]
    def read_text(self):
        return self.read_bytes().decode()

def put(name, data):
    MemoryPath.files[name] = json.dumps(data).encode()
    return hashlib.sha256(MemoryPath.files[name]).hexdigest()

def seal(r):
    es = put("eligibility", {"eligible": True})
    key = [dict(draw=d, question=q, role="product", **{f:c[f] for f in ("guardrail","covering","type")})
           for d, cards in r["cards"].items() for q,c in cards.items()]
    r["inputs"] = dict(matters_sha256=put("matters", {"matters":r["matters"]}),
                       mapping_path="mapping",
                       mapping_sha256=put("mapping", {"mapping":r["mapping"], "distinct":r["distinct"], "eligibility_sha256":es}),
                       eligibility_path="eligibility", eligibility_sha256=es,
                       deck_key_path="key", deck_key_sha256=put("key", dict(enumerate(key))))
    return r

for mod in (new, old):
    mod.Path, mod.MATTERS = MemoryPath, MemoryPath("matters")
tests.seal = seal
tests.test_a_diagnostic_that_cannot_be_computed_never_stops_an_invalid_or_too_small_verdict()
print("Committed regression test passed in memory")
for a, b in ((10,2),(2,10),(5,4)):
    r = tests.base(n=32,new_served=a,old_served=b)
    r["matters"][0]["company_figure"] = True
    r["matter_first_day"] = {"M01":"2026-09-08"}
    for d, cards in r["cards"].items():
        for q, card in cards.items():
            card["opened"] = "2026-09-09"
            if q.endswith("-g-figure-0"):
                card["answer"] = {"split":["supported","insufficient"]}
    seal(r)
    prior = old.verdict(copy.deepcopy(r))
    after = new.verdict(copy.deepcopy(r))
    assert json.dumps(prior,default=str) == json.dumps(after,default=str)
    print(after["verdict"], "serialized report matches parent")

for invalid in (False,True):
    r = tests.base(n=19,new_served=5,old_served=1)
    if invalid:
        r["controls"]["plants"][0] = "supported"
    r["matter_first_day"] = {"M01":"2026-09-08"}
    r["cards"]["new-1"]["new-1-q0"]["opened"] = "2026-09-09"
    r["cards"]["new-1"]["new-1-g-figure-0"]["worth"] = {"split":["unknown"]}
    after = tests.verdict(r)
    print(after["verdict"], "marks independently computable:", bool(new.mark_counts(r, {})),
          "opening lag:", new.days_to_opening(r), "reported beside:", after.get("beside"),
          "flag:", after["diagnostics not computed"])
    if not invalid:
        r["distinct"]["new-1"]["ids"] = None
        seal(r)
        new.verify_inputs(r)
        try:
            new.verdict(r)
        except TypeError as error:
            print("N under 20, but no verdict:", error)
