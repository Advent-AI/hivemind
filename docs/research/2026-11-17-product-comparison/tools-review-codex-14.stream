   395	        return dict(report, verdict='invalid', why=invalid) if invalid else dict(report, verdict='too small', why=small)
   396	    per_counting = countings()
   397	    shown = beside(readings, per_counting)
   398	    shown.update(printed_beside(readings, per_counting))
   399	    report['margin'] = margin
   400	    report['countings'] = per_counting
   401	    report['beside'] = shown
   402	    lead = all(c['a'] - c['b'] >= margin and c['a'] >= 2 * c['b'] for c in per_counting.values())
   403	    all_exercised_pass = all(g['exercised'] and not g['breach'] for c in per_counting.values() for g in c['guardrails'].values())
   404	    if lead and all_exercised_pass:
   405	        return dict(report, verdict='practical lead')
   406	    loss_count = all(c['b'] - c['a'] >= margin and c['b'] >= 2 * c['a'] for c in per_counting.values())
   407	    breaches = {k for k in ('figure', 'yes/no', 'worth') if all(c['guardrails'][k]['breach'] for c in per_counting.values())}
   408	    if loss_count or breaches:
   409	        return dict(report, verdict='practical loss', why=(['served matters'] if loss_count else []) + [f'guardrail {k}' for k in sorted(breaches)])
   410	    return dict(report, verdict='no practical winner')

