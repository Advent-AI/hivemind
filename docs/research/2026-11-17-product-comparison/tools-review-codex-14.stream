   344	def verdict(readings):
   345	    present = {k: sorted(readings[k]) for k in ('mapping', 'cards', 'distinct')}
   346	    for k, draws in present.items():
   347	        if sorted(DRAWS) != draws:
   348	            raise SystemExit(f'refused: readings[{k!r}] holds {draws}, not the six draws {list(DRAWS)}')
   349	    verify_inputs(readings)
   350	    n = len(readings['matters'])
   351	    controls = readings['controls']
   352	    report = {'N': n}
   353	    invalid = []
   354	    def rejected(m):
   355	        return m in REJECTED or (isinstance(m, dict) and 'split' in m and all(x in REJECTED for x in m['split']))
   356	    if any(not rejected(m) for m in controls['plants']):
   357	        invalid.append('a planted wrong answer without an explicit rejection')
   358	    if sum(m == 'supported' for m in controls['supported']) < 3:
   359	        invalid.append('fewer than 3 of 4 supported controls accepted')
   360	    if sum(bool(x) for x in controls['repeats_same']) < 2:
   361	        invalid.append('fewer than 2 of 3 repeats marked the same')
   362	    if len(controls['plants']) != 6 or len(controls['supported']) != 4 or len(controls['repeats_same']) != 3:
   363	        invalid.append('the deck does not hold 6 plants, 4 supported controls and 3 repeats')
   364	    small = []
   365	    if not invalid:                                            # the size check runs only when the controls hold
   366	        if n < 20:
