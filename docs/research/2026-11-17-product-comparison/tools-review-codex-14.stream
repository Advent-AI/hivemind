   264	def floors_per_draw(readings, system, fav):
   265	    """The proposed absolute floors as their source states them (reflection-10 `codex-1.md`; RUN-PLAN-v2 §1.6), per draw, met when met in
   266	    at least two of the system's three draws: important matters covered (a covering question, after the counting's split resolution) at
   267	    least 80%; trivial or duplicate questions among the random sample's decided worth marks at most 20% (covering cards included: the
   268	    frozen rule keeps them out of the guardrail shares, not the floors); supported latest answers among the random sample's answered cards
   269	    at least 90%, an insufficient or unresolved (split) answer counted and given no credit (the
   270	    verdict's own split resolution is unchanged). Citations and omissions are not measured."""
   271	    n = len(readings['matters'])
   272	    per_draw = {}
   273	    for draw in DRAWS:
   274	        if system_of(draw) != system:
   275	            continue
   276	        covered = sum(1 for questions in readings['mapping'][draw].values()
   277	                      if any(q['covers'] is True or (q['covers'] == 'split' and fav) for q in questions))
   278	        trivial = worth_decided = supported = answered = 0
   279	        for card in readings['cards'][draw].values():
   280	            if not card['guardrail']:                       # every random-sample card, covering or not: the floors speak of the library
   281	                continue
   282	            worth_decided += 1
   283	            trivial += resolve(card['worth'], 'worth', fav) in ('trivia', 'duplicate')
   284	            if card['answer'] != 'no answer':
   285	                answered += 1
   286	                supported += card['answer'] == 'supported'      # an unresolved (split) answer is counted without credit, as the source says
   287	        shares = {'covered': (covered, n), 'trivial or duplicate': (trivial, worth_decided), 'supported': (supported, answered)}
   288	        per_draw[draw] = {k: {'count': f'{a}/{b}', 'met': (b > 0 and (Fraction(a, b) <= FLOORS[k] if k == 'trivial or duplicate'
   289	                                                                      else Fraction(a, b) >= FLOORS[k]))} for k, (a, b) in shares.items()}
   290	    out = {'per draw': per_draw}
