    40	def outcome(views_db, question_id, view_id, day='2026-07-14', gold=None, questions=None):
    41	    if gold is None:
    42	        gold, questions = gold_and_questions()
    43	    entry, question = gold[question_id], questions[question_id]
    44	    if entry.get('no_view'):
    45	        return {'outcome': 'no_view', 'detail': ''}
    46	    if not entry.get('implied_outcome'):
    47	        return {'outcome': 'gold open', 'detail': ''}
    48	    if not view_id:
    49	        return {'outcome': 'not in run', 'detail': ''}
    50	    implied = (entry.get('resolution') or entry)['implied_outcome']
    51	    conn = sqlite3.connect(f'file:{views_db}?mode=ro', uri=True)
    52	    conn.row_factory = sqlite3.Row
    53	    judgement = conn.execute('select rung, publication_day from judgements where view_id=? and publication_day<=? '
    54	                             'order by judgement_id desc limit 1', (view_id, day)).fetchone()
    55	    rungs = [dict(r) for r in conn.execute('select position, label, lo, hi from rungs where view_id=? order by position', (view_id,))]
    56	    if judgement is None:
    57	        return {'outcome': 'no judgement', 'detail': f'{view_id} never judged by {day}'}
    58	    chosen = rungs[judgement['rung'] - 1]
    59	    if question['unit'] == 'yes/no':
    60	        agree = (chosen['label'].lower() == 'yes') == bool(implied['yes_no'])
    61	        return {'outcome': 'agree' if agree else 'disagree', 'detail': f"{view_id} rung {judgement['rung']} {chosen['label']} on {judgement['publication_day']}"}
    62	    lo, hi = chosen['lo'], chosen['hi']
