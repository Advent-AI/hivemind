    86	def check(run_root):
    87	    run_root = Path(run_root).resolve()
    88	    draws, problems = {}, []
    89	    for draw in mapping.DRAWS:
    90	        record = json.loads((run_root / draw / 'run.json').read_text())
    91	        if record.get('identity') != expected_identity(run_root, draw):
    92	            problems.append(f"{draw}: registered identity {record.get('identity')} is not the counted draw's {expected_identity(run_root, draw)}")
    93	        starts = [local(a['started at']) for c in record['components'].values() for a in c.get('attempts', []) if a.get('started at')]
    94	        paths = mapping.store_paths(run_root, draw)                    # refuses an incomplete draw
    95	        latest, databases = last_call(run_root / draw)
    96	        attempt, attempts, unreconciled = last_attempt(run_root / 'ledgers' / f'{draw}.json')
    97	        if unreconciled:
    98	            problems.append(f'{draw}: the timing cannot be established: {unreconciled}')
    99	        if attempt and (latest is None or attempt > latest):
   100	            latest = attempt
   101	        draws[draw] = {'launch': min(starts).isoformat() if starts else None, 'last call': latest.isoformat() if latest else None,
   102	                       'databases with calls': databases, 'ledger attempts': attempts,
   103	                       'stores': {Path(p).name: {'path': str(p), 'sha256': sha256(p)} for p in paths} if paths else {}}
   104	        if not starts:
   105	            problems.append(f'{draw}: no launch recorded')
   106	    launches = [datetime.datetime.fromisoformat(d['launch']) for d in draws.values() if d['launch']]
   107	    if launches and max(launches) - min(launches) > LAUNCH_WINDOW:
   108	        problems.append(f'launches span {max(launches) - min(launches)}, more than one hour')
   109	    first = min(launches) if launches else None
   110	    for draw, d in draws.items():
   111	        if first and d['last call'] and datetime.datetime.fromisoformat(d['last call']) > first + SEND_WINDOW:
   112	            problems.append(f"{draw}: a call at {d['last call']}, more than 72 h after the first launch {first.isoformat()}")
   113	    return {'eligible': not problems, 'problems': problems, 'first launch': first.isoformat() if first else None, 'draws': draws}
