    12	def short(it):
    13	    return {'summary': it['summary'], 'original_party': it['original_party'], 'statement_date': it['statement_date'] or it['statement_date_text'],
    14	            'period': it['evidence_period'], 'publication_date': it['publication_date']}
    15	
    16	
    17	def full(it):
    18	    return {**short(it), 'tier': it['tier'], 'reporting_speaker': it['reporting_speaker'], 'publisher': it['publisher'], 'title': it['title'],
    19	            'passages': it['passages'], 'source_context': [c for c in it['context'] if c], 'theses': [t['question'] for t in it['theses']]}
