    65	    agree = (lo is None or implied['high'] >= lo) and (hi is None or implied['low'] < hi)
    66	    return {'outcome': 'agree' if agree else 'disagree', 'detail': f"{view_id} rung {judgement['rung']} {chosen['label']} {lo}..{hi}"}
