    22	def main():
    23	    mode, folder = sys.argv[1], Path(sys.argv[2])
    24	    items = {it['key']: it for it in json.loads((folder / 'items.json').read_text())}
    25	    order = list(items)
    26	    chooser = random.Random(7)
    27	    if mode == 'triage':
    28	        pairs = json.loads((folder / 'candidate-pairs.json').read_text())
    29	        chooser.shuffle(pairs)
    30	        key = {}
    31	        for start in range(0, len(pairs), 100):
    32	            packet = []
    33	            for p in pairs[start:start + 100]:
    34	                pid = f"T{len(key) + 1}"
    35	                key[pid] = [p['earlier'], p['later']]
    36	                packet.append({'id': pid, 'earlier': short(items[p['earlier']]), 'later': short(items[p['later']])})
    37	            (folder / f'triage-packet-{start // 100 + 1}.json').write_text(json.dumps(packet, ensure_ascii=False, indent=1))
    38	        (folder / 'triage-key.json').write_text(json.dumps(key))
    39	        print('triage packets', (len(pairs) + 99) // 100, 'pairs', len(pairs))
    40	    elif mode == 'scan':
    41	        sample = json.loads((folder / 'exhaustive-sample.json').read_text())
    42	        for part in range(0, len(sample), 5):
    43	            packet = []
    44	            for s in sample[part:part + 5]:
    45	                incoming = items[s['key']]
    46	                earlier = [k for k in order if items[k]['article'] < incoming['article']]
    47	                packet.append({'incoming_key': s['key'], 'incoming': full(incoming),
    48	                               'earlier_items': [{'key': k, 'summary': items[k]['summary'], 'original_party': items[k]['original_party']} for k in earlier]})
    49	            (folder / f'scan-packet-{part // 5 + 1}.json').write_text(json.dumps(packet, ensure_ascii=False, indent=1))
    50	        print('scan packets', (len(sample) + 4) // 5, 'items', len(sample))
    51	    elif mode == 'label':
    52	        triage_key = json.loads((folder / 'triage-key.json').read_text())
    53	        possible = set()
    54	        for path in sorted(folder.glob('triage-answer-*.json')):
    55	            for row in json.loads(path.read_text()):
    56	                if row['verdict'] != 'different':
    57	                    possible.add(tuple(triage_key[row['id']]))
    58	        flagged, unflagged = set(), []
    59	        sample_keys = [s['key'] for s in json.loads((folder / 'exhaustive-sample.json').read_text())]
    60	        for path in sorted(folder.glob('scan-answer-*.json')):
    61	            for row in json.loads(path.read_text()):
    62	                for k in row['possible_earlier']:
    63	                    if k in items and items[k]['article'] < items[row['incoming_key']]['article']:
    64	                        flagged.add((k, row['incoming_key']))
    65	        for incoming in sample_keys:
    66	            for k in order:
    67	                if items[k]['article'] < items[incoming]['article'] and (k, incoming) not in flagged:
    68	                    unflagged.append((k, incoming))
    69	        audit = chooser.sample(unflagged, min(60, len(unflagged)))
    70	        pairs = sorted(possible | flagged | set(audit))
    71	        chooser.shuffle(pairs)
    72	        key = {}
    73	        for start in range(0, len(pairs), 40):
    74	            packet = []
    75	            for earlier, later in pairs[start:start + 40]:
    76	                pid = f"L{len(key) + 1}"
    77	                key[pid] = {'earlier': earlier, 'later': later, 'from_triage': (earlier, later) in possible,
    78	                            'from_scan': (earlier, later) in flagged, 'audit': (earlier, later) in set(audit)}
    79	                packet.append({'id': pid, 'earlier': full(items[earlier]), 'later': full(items[later])})
    80	            (folder / f'label-packet-{start // 40 + 1}.json').write_text(json.dumps(packet, ensure_ascii=False, indent=1))
    81	        (folder / 'label-key.json').write_text(json.dumps(key))
    82	        print('label packets', (len(pairs) + 39) // 40, 'pairs', len(pairs), f'(triage-possible {len(possible)}, scan-flagged {len(flagged)}, unflagged audit {len(audit)})')
    83	
