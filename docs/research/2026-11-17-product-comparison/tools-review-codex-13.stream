   306	def days_to_opening(readings):
   307	    """Per draw and covered matter: days from the matter's earliest listed article to the first covering question's opening. A question
   308	    opened before the scored window (09-07) is 'opened in the warm-up'; one opened in the window before the matter's first listed article
   309	    is 'opened before the first listed article'."""
   310	    import datetime
   311	    out = {}
   312	    for draw, by_matter in readings['mapping'].items():
   313	        for matter, questions in by_matter.items():
   314	            opened = [readings['cards'][draw][q['question']].get('opened') for q in questions if q['covers'] is True]
   315	            opened = [d for d in opened if d]
   316	            first = readings.get('matter_first_day', {}).get(matter)
   317	            if not opened or not first:
   318	                continue
   319	            days = (datetime.date.fromisoformat(min(opened)) - datetime.date.fromisoformat(first)).days
   320	            out.setdefault(matter, {})[draw] = (days if days >= 0 else 'opened in the warm-up' if min(opened) < '2026-09-07'
   321	                                                else 'opened before the first listed article')
   322	    return out
