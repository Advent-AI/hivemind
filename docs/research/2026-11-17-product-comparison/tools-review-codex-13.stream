import hashlib, json
import score_comparison as scorer
import test_score_comparison as tests

files = {}
class MemoryPath:
    def __init__(self, name):
        self.name = name
    def exists(self):
        return self.name in files
    def read_bytes(self):
        return files[self.name]
    def read_text(self):
        return self.read_bytes().decode()

def put(name, data):
    files[name] = json.dumps(data).encode()
    return hashlib.sha256(files[name]).hexdigest()

def seal(r):
    es = put(\"eligibility\", {\"eligible\": True})
    key = [dict(draw=d, question=q, role=\"product\", **{f:c[f] for f in (\"guardrail\",\"covering\",\"type\")})
           for d, cards in r[\"cards\"].items() for q,c in cards.items()]
    r[\"inputs\"] = dict(matters_sha256=put(\"matters\", {\"matters\":r[\"matters\"]}),
                       mapping_path=\"mapping\",
                       mapping_sha256=put(\"mapping\", {\"mapping\":r[\"mapping\"], \"distinct\":r[\"distinct\"], \"eligibility_sha256\":es}),
                       eligibility_path=\"eligibility\", eligibility_sha256=es,
                       deck_key_path=\"key\", deck_key_sha256=put(\"key\", dict(enumerate(key))))
    return r

scorer.Path = MemoryPath
scorer.MATTERS = MemoryPath(\"matters\")
tests.seal = seal
tests.test_a_diagnostic_that_cannot_be_computed_never_stops_an_invalid_or_too_small_verdict()
print(\"Committed regression test passed with in-memory fixtures\")
r = tests.base(n=19, new_served=5, old_served=1)
r[\"matter_first_day\"] = {\"M01\":\"2026-09-08\"}
r[\"cards\"][\"new-1\"][\"new-1-q0\"].update(guardrail=True, answer=\"no answer\", worth={\"split\":[\"unknown\"]}, opened=\"2026-09-09\")
out = tests.verdict(r)
for k in (\"verdict\", \"diagnostics not computed\"):
    print(k, out[k])
print(\"Sign test computable:\", scorer.sign_test(out[\"countings\"][\"1\"][\"a\"],out[\"countings\"][\"1\"][\"b\"]))
print(\"Reported beside:\", out[\"beside\"])
assert \"sign test (illustrative)\" not in out[\"beside\"]
