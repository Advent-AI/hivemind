   332	def route_candidates(record, earlier, words):
   333	    """{earlier record id: routes}: R0e's top 10 by word overlap, scored as `retrieve.py` scores it, and the same original party within
   334	    3 days. `earlier` holds only records of earlier articles, in forward order."""
   335	    target = matching._words(record['summary'])
   336	    routes = {}
   337	    for candidate in sorted(earlier, key=lambda e: -len(target & words[e['id']]))[:TOP]:
   338	        routes.setdefault(candidate['id'], []).append('words')
   339	    day = day_of(record)
   340	    for candidate in earlier:
   341	        other = day_of(candidate)
   342	        if party_of(record) and party_of(candidate) == party_of(record) and day and other and abs((day - other).days) <= PARTY_DAYS:
   343	            routes.setdefault(candidate['id'], []).append('party')
   344	    return routes
