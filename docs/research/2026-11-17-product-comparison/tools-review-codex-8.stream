   429	def line1(run_root, eligibility_record, out, keys=KEY_FOLDER):
   430	    folder, key_file = fresh(Path(out) / 'line-1'), fresh_key(Path(keys) / 'step2-line1-key.json')
   431	    trace = str(component_file(run_root, eligibility_record, 'step1', 'trace.sqlite'))
   432	    articles = run_forward.step1_records(trace)[0]
   433	    entries = build_merge_packets.entries(trace)
   434	    records = [record for article in articles for record in article]
   435	    by_id = {record['id']: record for record in records}
