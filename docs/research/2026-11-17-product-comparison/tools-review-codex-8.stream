    78	def rulings_of_two(ruling_of_one, ruling_of_other, unresolved_as):
    79	    """One send's rulings from two third readers, one of each reader family. Where the two rule a mark alike, that is the
    80	    mark's value. Where they differ the mark is unresolved: it takes `unresolved_as` ('holds' or 'fails'), so that every line can
    81	    be read both ways, and it is listed. A fault named under `W` is upheld when both uphold it and not upheld when neither does;
    82	    where they differ it is upheld only under 'fails'. A point one of the two did not rule on is left out, and the accounting
    83	    then reports it as a missing ruling. Returns (the rulings as `account` takes them, the unresolved points)."""
    84	    resolved, unresolved = {'marks': {}, 'W': {}}, []
    85	    for mark in sorted(set(ruling_of_one.get('marks', {})) & set(ruling_of_other.get('marks', {}))):
    86	        one, other = ruling_of_one['marks'][mark], ruling_of_other['marks'][mark]
    87	        if one == other:
    88	            resolved['marks'][mark] = one
    89	        else:
    90	            resolved['marks'][mark] = unresolved_as
    91	            unresolved.append(mark)
    92	    for reader in sorted(set(ruling_of_one.get('W', {})) & set(ruling_of_other.get('W', {}))):
    93	        one, other = ruling_of_one['W'][reader], ruling_of_other['W'][reader]
    94	        if one == other:
    95	            resolved['W'][reader] = one
    96	        else:
    97	            resolved['W'][reader] = unresolved_as == 'fails'
    98	            unresolved.append(f'W of {reader}')
    99	    return resolved, unresolved
