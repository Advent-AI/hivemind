   193	# ---------- step 3: the as-of state
   194	
   195	def last_sequence(conn, day=DAY):
   196	    """The store's last sequence of the day, as its writer recorded the day's completion."""
   197	    rows = conn.execute('select seq from days_completed where day = ?', (day,)).fetchall()
   198	    if len(rows) != 1:
   199	        raise SystemExit(f'refused: the store records {len(rows)} completions of {day} (its last completed day is '
   200	                         f'{conn.execute("select max(day) from days_completed").fetchone()[0]}); its state on {day} cannot be read')
   201	    return rows[0]['seq']
   202	
   203	
   204	def ladder_unit(conn, view_id):
   205	    """A new-system view's unit: its one `clean_ladders` row (a split child's row carries its year), and the checked answer's figure unit."""
   206	    columns = {row[1] for row in conn.execute('pragma table_info(clean_ladders)')}
   207	    if not columns:
   208	        raise SystemExit('refused: a new-system store without clean_ladders')
   209	    rows = conn.execute('select * from clean_ladders where view_id = ?', (view_id,)).fetchall()
   210	    if len(rows) != 1:
   211	        raise SystemExit(f'refused: view {view_id} has {len(rows)} clean_ladders rows, not one')
   212	    row = dict(rows[0])
   213	    checked = json.loads(row['checked_answer']) if row.get('checked_answer') else {}
   214	    figure = (checked.get('ladder') or {}).get('figure')
   215	    return {'thesis': row['thesis_id'], 'period': row.get('period') or '', 'unit': figure.get('unit') if figure else None}
   216	
   217	
   218	def listed_views(conn, system, day=DAY, last_seq=None):
   219	    """(the last sequence used, where it came from, the views created on or before the day in creation order, closed ones included,
   220	    each with its rungs and its state as of the day). `last_seq` is given only for a stored store that records no completed day."""
   221	    source = 'given' if last_seq is not None else 'days_completed'
   222	    last = last_seq if last_seq is not None else last_sequence(conn, day)
   223	    views = []
   224	    for row in conn.execute('select rowid as created_order, * from views order by created_seq, rowid'):
   225	        record = dict(row)
   226	        if record['created_seq'] > last:
   227	            continue
   228	        state = service.state_as_of(conn, record['view_id'], day)
   229	        rungs = [dict(r) for r in conn.execute('select position, label, condition, lo, hi from rungs where view_id = ? order by position',
   230	                                               (record['view_id'],))]
   231	        view = {key: record[key] for key in ('view_id', 'created_seq', 'created_order', 'created_from_input', 'question', 'looks_at',
   232	                                             'due_day', 'year', 'kind')}
   233	        view['rungs'] = rungs
   234	        view['state'] = None if state is None else {'position': state['position'], 'judgement_day': state['judgement_day'],
   235	                                                    'since_day': state['since_day'], 'rounds': state['rounds']}
   236	        if system == 'new':
   237	            view.update(ladder_unit(conn, record['view_id']))
   238	        views.append(view)
   239	    if conn.execute('select 1 from processing_steps limit 1').fetchone() is not None:
   240	        by_product = {r['view_id'] for r in conn.execute('select * from views') if service.view_exists(conn, dict(r), day)}
   241	        if by_product != {v['view_id'] for v in views}:
   242	            raise SystemExit(f'refused: the listing by sequence differs from service.view_exists on {day}: '
   243	                             f'{sorted(by_product ^ {v["view_id"] for v in views})}')
   244	    return last, source, views
   245	
   246	
   247	def read_store(entry, day=DAY):
   248	    """One draw's store as of the day: {'system', 'views' path, 'last_sequence', 'from', 'listed'}. A draw with no store (a new
   249	    draw whose judge was skipped: no question opened) lists nothing."""
   250	    if entry['views'] is None:
   251	        return {'system': entry['system'], 'views': None, 'last_sequence': None, 'from': 'no store (no question opened)', 'listed': []}
   252	    conn = connect(entry['views'])
   253	    try:
   254	        last, source, views = listed_views(conn, entry['system'], day, entry.get('last_seq'))
   255	    finally:
   256	        conn.close()
   257	    return {'system': entry['system'], 'views': str(entry['views']), 'last_sequence': last, 'from': source, 'listed': views}
