   375	def label(folder, tag, new_pairs, pairs, entries, packet_ids):
   376	    """Two readers per pair, one per family, on question 1; each disagreement to one more session of a family drawn per pair."""
   377	    keys = list(new_pairs)
   378	    random.Random(f'{SEED + 1}:{tag}').shuffle(keys)
   379	    for key in keys:
   380	        packet_ids[key] = f'V{len(packet_ids) + 1}'
   381	    check = lambda ids: rows_check(ids, {'relation': lambda value: value in RELATIONS})
   382	    jobs = []
   383	    for number, chunk in enumerate(packets(keys, LABEL_PACKET), 1):
   384	        packet = [{'id': packet_ids[k], 'earlier': entries[k[0]], 'later': entries[k[1]]} for k in chunk]
   385	        jobs += [{'name': f'label-{tag}-{number}-{family}', 'family': family, 'pairs': chunk, 'prompt': label_prompt(packet),
   386	                  'check': check([packet_ids[k] for k in chunk])} for family in FAMILIES]
   387	    answers = sessions(folder, jobs)
   388	    for job in jobs:
   389	        for key in job['pairs']:
   390	            if answers[job['name']] is not None:
   391	                pairs[key]['marks'][job['family']] = answers[job['name']][packet_ids[key]]['relation']
   392	    disputed = collections.defaultdict(list)
   393	    for key in keys:
   394	        marks = pairs[key]['marks']
   395	        if len(marks) == len(FAMILIES) and len(set(marks.values())) == 1:
   396	            pairs[key]['label'] = marks[FAMILIES[0]]
   397	        elif len(marks) == len(FAMILIES):
   398	            disputed[drawn_family(SEED + 1, *key)].append(key)
   399	    jobs = []
   400	    for family, family_keys in sorted(disputed.items()):
   401	        for number, chunk in enumerate(packets(family_keys, LABEL_PACKET), 1):
   402	            packet = [{'id': packet_ids[k], 'earlier': entries[k[0]], 'later': entries[k[1]],
   403	                       'first_relations': [pairs[k]['marks'][f] for f in FAMILIES]} for k in chunk]
   404	            jobs.append({'name': f'third-{tag}-{number}-{family}', 'family': family, 'pairs': chunk,
   405	                         'prompt': label_prompt(packet, adjudication=True), 'check': check([packet_ids[k] for k in chunk])})
   406	    answers = sessions(folder, jobs)
   407	    for job in jobs:
   408	        for key in job['pairs']:
   409	            if answers[job['name']] is not None:
   410	                relation = answers[job['name']][packet_ids[key]]['relation']
   411	                pairs[key]['third'] = {'family': job['family'], 'relation': relation}
   412	                pairs[key]['label'] = relation
