   324	
   325	def run_sessions(out, jobs):
   326	    """jobs: [(name, family, prompt, problem)], run six at a time."""
   327	    with concurrent.futures.ThreadPoolExecutor(max_workers=6) as pool:
   328	        answers = list(pool.map(lambda job: session(out, *job), jobs))
   329	    for (name, *_), answer in zip(jobs, answers):
   330	        print(f'{name}: {"answered" if answer is not None else "MISSING after two attempts"}', flush=True)
