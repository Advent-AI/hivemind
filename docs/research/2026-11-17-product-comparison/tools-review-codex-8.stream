   383	def report(out):
   384	    """`collect_readings.py report` on every draw with a reading folder, with line 5 recomputed under D452's scaling; written to
   385	    `<out>/d400-reader-lines.json` and printed."""
   386	    out = Path(out)
   387	    manifest = load_manifest(out)
   388	    result = {'eligible': manifest['eligible'], 'draws': {}}
   389	    to_read = {draw: (folder, key_path) for draw, folder, key_path in draws_to_read(out, manifest)}
   390	    for draw, entry in manifest['draws'].items():
   391	        if draw not in to_read:
   392	            result['draws'][draw] = {'status': entry['status'], **{f'line {number}': accounting.NOT_MEASURED for number in (1, 2, 3, 4, 5)}}
   393	            continue
   394	        folder, key_path = to_read[draw]
   395	        stored_path = folder / 'stage-a-report.json'
   396	        stored_path.unlink(missing_ok=True)                     # a failed report must not leave an earlier one to be read
   397	        collected = run_stage_a_tool([COLLECT_READINGS, 'report', folder, key_path], cwd=out)
   398	        (folder / 'report.txt').write_text(collected.stdout + (f'\n[exit {collected.returncode}] {collected.stderr}' if collected.returncode else ''))
   399	        missing = missing_sessions(folder)
   400	        if collected.returncode != 0:
   401	            reason = collected.stderr.strip().splitlines()[-1] if collected.stderr.strip() else f'exit {collected.returncode}'
   402	            result['draws'][draw] = {'status': f'not measured: collect_readings.py report refused: {reason}', 'missing sessions': missing,
   403	                                     **{f'line {number}': accounting.NOT_MEASURED for number in (1, 2, 3, 4, 5)}}
   404	            continue
   405	        stored = json.loads(stored_path.read_text())
   406	        countings = {'one counting (no rulings of two third readers)': stored} if 'lines' in stored else {label: stored[label] for label in TWO_COUNTINGS}
   407	        entry_out = {'status': 'read', 'missing sessions': missing,
   408	                     'reading': {label: counting['reading'] for label, counting in countings.items()},
   409	                     'dispute share': next(iter(countings.values()))['dispute share'],
   410	                     'unresolved points': len(stored.get('unresolved', []))}
   411	        for number in ('1', '2', '3', '4'):
   412	            entry_out[f'line {number}'] = verdict_under_both(
   413	                [line if isinstance(line, str) else line[0] for line in (counting['lines'][number] for counting in countings.values())])
   414	        line_5 = {label: line_5_of(counting['lines']['5']) for label, counting in countings.items()}
   415	        entry_out['line 5'] = verdict_under_both([verdict for verdict, _ in line_5.values()])
   416	        entry_out['line 5 by counting'] = {label: {'verdict': verdict, **details} for label, (verdict, details) in line_5.items()}
   417	        result['draws'][draw] = entry_out
   418	    (out / 'd400-reader-lines.json').write_text(json.dumps(result, indent=1, ensure_ascii=False) + '\n')
   419	    print_report(result)
   420	    return result
   421	
   422	
   423	def print_report(result):
   424	    print('D400 reader lines 1–5, per new draw (printed beside the verdict; they clear or block no release)')
   425	    print('eligibility:', {True: 'the draws are eligible', False: 'the draws are NOT eligible: a diagnostic only'}.get(result['eligible'], 'not stated'))
   426	    names = {'1': 'no ladder fails Q', '2': 'no ladder fails L', '3': 'no ladder fails R', '4': 'no refusal fails N'}
   427	    for draw, entry in result['draws'].items():
   428	        print(f'== {draw}: {entry["status"]}')
   429	        if entry['status'] == 'read':
   430	            print(f"   reading: {entry['reading']}; dispute share {entry['dispute share']}; unresolved points {entry['unresolved points']}")
   431	        if entry.get('missing sessions'):
   432	            print(f"   sessions missing: {entry['missing sessions']}")
   433	        for number, name in names.items():
   434	            print(f'   line {number} ({name}): {entry[f"line {number}"]}')
   435	        print(f"   line 5 (council-set diagnostic line, D452; never Alex's line): {entry['line 5']}")
   436	        for label, details in entry.get('line 5 by counting', {}).items():
   437	            minimums = (f"; minimums ceil(35N/44) = {details['minimum right']} and ceil(28N/44) = {details['minimum right by a ladder']}"
   438	                        if 'minimum right' in details else f"; {details.get('reason', '')}")
   439	            counts = (f"right {details['right']}, right by a ladder {details['right by a ladder']}, of N = {details['of']}"
   440	                      if 'of' in details else 'no counts')
   441	            print(f"      {label}: {counts}{minimums} -> {details['verdict']}")
   442	        theses = next((details['of'] for details in entry.get('line 5 by counting', {}).values() if 'of' in details), 'not counted')
   443	        print(f'      beside: D400\'s wording, at least {D400_RIGHT} right and {D400_RIGHT_BY_A_LADDER} right by a ladder of '
   444	              f'{D400_THESES} theses; this draw has N = {theses}')
   445	    print(D400_LIMIT)
