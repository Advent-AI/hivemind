   124	# ---- inputs -------------------------------------------------------------------------------------------------------------------------
   125	
   126	def component_file(run_root, eligibility_record, component, name):
   127	    """A file of new-1's `component`, in the folder its run record names, refused unless the eligibility check fingerprinted it."""
   128	    record = json.loads((Path(run_root) / DRAW / 'run.json').read_text())
   129	    entry = record['components'].get(component, {})
   130	    if entry.get('state') != 'completed':
   131	        raise SystemExit(f"refused: {DRAW}'s {component} is {entry.get('state')!r}, not completed")
   132	    return eligibility.verified(eligibility_record, run_root, DRAW, f"{entry['folder']}/{name}")
   133	
   134	
   135	def fresh(folder):
   136	    if folder.exists():
   137	        raise SystemExit(f'refused: {folder} exists')
   138	    folder.mkdir(parents=True)
   139	    return folder
   140	
   141	
   142	def fresh_key(path):
   143	    if path.exists():
   144	        raise SystemExit(f'refused: {path} exists; a key is never overwritten')
   145	    return path
   146	
   147	
   148	def write_key(path, key):
   149	    path.parent.mkdir(parents=True, exist_ok=True)
   150	    path.write_text(json.dumps(key, indent=1, ensure_ascii=False) + '\n')
   151	
   152	
   153	def sha256_text(text):
   154	    return hashlib.sha256(text.encode()).hexdigest()
   155	
   156	
   157	def freeze(path, payload):
   158	    """Write `payload` and then its sha256 beside it; returns the digest."""
   159	    text = json.dumps(payload, indent=1, ensure_ascii=False) + '\n'
   160	    path.write_text(text)
   161	    digest = sha256_text(text)
   162	    Path(f'{path}.sha256').write_text(f'{digest}  {path.name}\n')
   163	    return digest
   164	
   165	
   166	def read_frozen(path):
   167	    text = path.read_text()
   168	    if Path(f'{path}.sha256').read_text().split()[0] != sha256_text(text):
   169	        raise SystemExit(f'refused: {path} changed after it was frozen')
   170	    return json.loads(text)
   171	
   172	
   173	def sources():
   174	    return {str(p.relative_to(ROOT)): eligibility.sha256(p) for p in SOURCES}
   175	
   176	
   177	# ---- prompts and sessions -----------------------------------------------------------------------------------------------------------
   178	
   179	def inline(prompt, read_sentence, packet):
   180	    """The prompt with its packet in place of the file it names: a closed session opens no file."""
   181	    if prompt.count(read_sentence) != 1:
   182	        raise SystemExit(f'refused: the prompt does not name its packet exactly once ({read_sentence!r})')
   183	    return prompt.replace(read_sentence, 'Read this packet:\n\n```json\n' + json.dumps(packet, ensure_ascii=False, indent=1) + '\n```\n\n')
   184	
   185	
   186	def label_prompt(packet, adjudication=False):
   187	    """Question 1 of the Step 2 reference labelling (`v2-prompt-1.md`) alone, with the reference's adjudication sentence for a third
   188	    reader."""
   189	    head = V2_TEXT[:V2_TEXT.index('Answer two separate questions')]
   190	    body = (head + 'Answer from the passages and context, not only the summaries.\n\n' + QUESTION_1 + (ADJUDICATION_SENTENCE if adjudication else '')
   191	            + 'Return only a JSON array in packet order: [{"id": "V..", "relation": "...", "why": "<one short sentence>"}].\n')
   192	    return inline(body, V2_READ, packet)
   193	
   194	
   195	def rendering_prompt(rendering, details):
   196	    return RENDERING_HEAD + rendering + RENDERING_TAIL.format(details=json.dumps(details, ensure_ascii=False, indent=1))
   197	
   198	
   199	def answer_rows(answer):
   200	    """The JSON array of objects an answer returns (a code fence allowed); anything else is refused."""
   201	    text = answer.strip()
   202	    fenced = re.fullmatch(r'```(?:json)?\s*(.*?)\s*```', text, re.S)
   203	    text = fenced.group(1) if fenced else text
   204	    try:
   205	        rows = json.loads(text)
   206	    except json.JSONDecodeError:
   207	        start, end = text.find('['), text.rfind(']')
   208	        if start < 0 or end < start:
   209	            raise ValueError('no JSON array in the answer')
   210	        rows = json.loads(text[start:end + 1])
   211	    if not isinstance(rows, list) or not all(isinstance(row, dict) for row in rows):
   212	        raise ValueError('not an array of objects')
   213	    return rows
   214	
   215	
   216	def is_text_list(value):
   217	    return isinstance(value, list) and all(isinstance(item, str) for item in value)
   218	
   219	
   220	def rows_check(ids, fields):
   221	    """A check: exactly the packet's ids, each once, and every field in its closed set."""
   222	    def check(answer):
   223	        rows = answer_rows(answer)
   224	        got = [row.get('id') for row in rows]
   225	        if sorted(map(str, got)) != sorted(ids) or len(set(map(str, got))) != len(got):
   226	            raise ValueError(f'{len(got)} ids that are not the packet\'s {len(ids)}')
   227	        for row in rows:
   228	            for field, accepts in fields.items():
   229	                if not accepts(row.get(field)):
   230	                    raise ValueError(f"{row['id']}: {field} {row.get(field)!r}")
   231	        return {row['id']: row for row in rows}
   232	    return check
   233	
   234	
   235	def sessions(folder, jobs):
   236	    """Run each job's closed session ({name, family, prompt, check}). A void session, or an answer its check refuses, is retried once and
   237	    then reported missing (None). Every prompt, answer and attempt is written to the folder."""
   238	    for sub in ('prompts', 'answers'):
   239	        (folder / sub).mkdir(exist_ok=True)
   240	    lock = threading.Lock()
   241	
   242	    def one(job):
   243	        (folder / 'prompts' / f"{job['name']}.md").write_text(job['prompt'])
   244	        for attempt in (1, 2):
   245	            answer, void = census_readers.run(job['family'], job['prompt'])
   246	            parsed = None
   247	            if not void:
   248	                try:
   249	                    parsed = job['check'](answer)
   250	                except ValueError as error:
   251	                    void = f'answer refused: {error}'
   252	            if answer:
   253	                (folder / 'answers' / f"{job['name']}-{attempt}.txt").write_text(answer)
   254	            with lock, open(folder / 'sessions.jsonl', 'a') as log:
   255	                log.write(json.dumps({'session': job['name'], 'family': job['family'], 'attempt': attempt, 'void': void}) + '\n')
   256	            if not void:
   257	                return job['name'], parsed
   258	        return job['name'], None
   259	
   260	    with concurrent.futures.ThreadPoolExecutor(max_workers=WORKERS) as pool:
   261	        return dict(pool.map(one, jobs))
   262	
   263	
   264	def session_counts(folder):
   265	    path = folder / 'sessions.jsonl'
   266	    lines = [json.loads(line) for line in path.read_text().splitlines()] if path.exists() else []
   267	    answered = {line['session'] for line in lines if not line['void']}
   268	    names = {line['session'] for line in lines}
   269	    return {'sessions': len(names), 'attempts': len(lines), 'missing': sorted(names - answered)}
   270	
   271	
   272	def packets(items, size):
   273	    return [items[start:start + size] for start in range(0, len(items), size)]
   274	
   275	
   276	def drawn_family(seed, *parts):
   277	    """The family of a third session, drawn per pair or group by seed so that no family settles every dispute."""
   278	    return random.Random(':'.join(map(str, (seed, *parts)))).choice(FAMILIES)
   279	
   280	
   281	def wilson(successes, trials, z=1.96):
   282	    if not trials:
   283	        return None
   284	    share = successes / trials
   285	    denominator = 1 + z * z / trials
   286	    centre = (share + z * z / (2 * trials)) / denominator
   287	    half = z * math.sqrt(share * (1 - share) / trials + z * z / (4 * trials * trials)) / denominator
   288	    return [round(centre - half, 4), round(centre + half, 4)]
   289	
   290	
   291	def finish(out, line, folder, result):
   292	    result = {'line': line, 'draw': DRAW, **result, 'sessions': session_counts(folder), 'prompt sources': sources()}
   293	    (folder / 'result.json').write_text(json.dumps(result, indent=1, ensure_ascii=False) + '\n')
   294	    report(out)
   295	    return result
   296	
   297	
   298	# ---- line 1 -------------------------------------------------------------------------------------------------------------------------
   299	
   300	def strata_of(articles):
   301	    """Record ids in three equal strata of the draw's articles by forward position; the first article's records have no earlier record."""
   302	    strata = [[] for _ in range(STRATA)]
   303	    for index, records in enumerate(articles):
   304	        if index:
   305	            strata[index * STRATA // len(articles)] += [record['id'] for record in records]
   306	    return strata
   307	

