   367	def match_problem(rows, ruler_ids):
   368	    def check(r):
   369	        if r.get('run') != rows[0]['run']:
   370	            return f"run {r.get('run')!r}"
   371	        if r.get('match') not in (*ruler_ids, 'none') or r.get('relation') not in RELATIONS:
   372	            return f"match {r.get('match')!r}, relation {r.get('relation')!r}"
   373	        if not isinstance(r.get('reason'), str) or not r['reason'].strip():
   374	            return 'no reason'
   375	        return None
   376	    return lambda answer: rows_problem(answer, 'id', [r['id'] for r in rows], check)
