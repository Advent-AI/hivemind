   285	
   286	
   287	def session(out, name, family, prompt, problem):
   288	    """One closed session, reused when already answered on this very prompt; a void answer is retried once, then recorded missing."""
   289	    path = Path(out) / 'sessions' / f'{name}.json'
   290	    digest = sha256_text(prompt)
   291	    if path.exists():
   292	        saved = json.loads(path.read_text())
   293	        if saved['prompt_sha256'] != digest:
   294	            raise SystemExit(f'refused: session {name} holds an answer to another prompt')
   295	        if saved['answer'] is not None:
   296	            return saved['answer']
   297	    voids, answer = [], None
   298	    for _ in (1, 2):
   299	        answer, void = census_readers.run(family, prompt)
   300	        if answer and not void:
   301	            void = problem(answer)
   302	        if not void:
   303	            break
   304	        voids.append(void)
   305	        answer = None
   306	    path.parent.mkdir(parents=True, exist_ok=True)
   307	    (Path(out) / 'prompts').mkdir(exist_ok=True)
   308	    (Path(out) / 'prompts' / f'{name}.md').write_text(prompt)
   309	    path.write_text(json.dumps({'name': name, 'family': family, 'prompt_sha256': digest, 'answer': answer, 'voids': voids},
   310	                               indent=1, ensure_ascii=False) + '\n')
   311	    return answer
   312	
   313	
   314	def stored_answer(out, name, prompt):
   315	    """A session's answer for the result: None when missing; refused when it answered another prompt."""
   316	    path = Path(out) / 'sessions' / f'{name}.json'
   317	    if not path.exists():
   318	        return None
   319	    saved = json.loads(path.read_text())
   320	    if saved['prompt_sha256'] != sha256_text(prompt):
   321	        raise SystemExit(f'refused: session {name} holds an answer to another prompt')
   322	    return saved['answer']
