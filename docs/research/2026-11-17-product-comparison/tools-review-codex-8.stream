   507	def line2(run_root, eligibility_record, out, keys=KEY_FOLDER):
   508	    folder, key_file = fresh(Path(out) / 'line-2'), fresh_key(Path(keys) / 'step2-line2-key.json')
   509	    decisions = json.loads(component_file(run_root, eligibility_record, 'step2', 'decisions.json').read_text())
   510	    population = [(d['outcome']['repeat_of'][0], d['id']) for d in decisions if d['outcome']['kind'] == 'repeat' and 'refused' not in d]
   511	    if len(population) < LINE2_MERGES:
   512	        return finish(out, 2, folder, {'status': 'not measured', 'reason': f'{len(population)} repeats, fewer than {LINE2_MERGES}',
   513	                                       'repeats': len(population)})
   514	    sample = random.Random(SEED + 2).sample(population, LINE2_MERGES)
   515	    entries = build_merge_packets.entries(str(component_file(run_root, eligibility_record, 'step1', 'trace.sqlite')))
   516	    ids = {f'X{number}': pair for number, pair in enumerate(sample, 1)}
   517	    write_key(key_file, {mid: {'earlier': pair[0], 'later': pair[1]} for mid, pair in ids.items()})
   518	    first_check = lambda chunk: rows_check(chunk, {'merge_acceptable': lambda value: isinstance(value, bool)})
   519	    jobs = []
   520	    for number, chunk in enumerate(packets(list(ids), MERGE_PACKET), 1):
   521	        packet = [{'id': mid, 'earlier': entries[ids[mid][0]], 'later': entries[ids[mid][1]]} for mid in chunk]
   522	        jobs += [{'name': f'merge-{number}-{family}', 'family': family, 'ids': chunk, 'prompt': inline(MERGE_TEXT, MERGE_READ, packet),
   523	                  'check': first_check(chunk)} for family in FAMILIES]
   524	    answers = sessions(folder, jobs)
   525	    marks = collections.defaultdict(dict)
   526	    for job in jobs:
   527	        for mid in job['ids']:
   528	            if answers[job['name']] is not None:
   529	                marks[mid][job['family']] = answers[job['name']][mid]
   530	    rejected = collections.defaultdict(list)
   531	    for mid in ids:
   532	        if len(marks[mid]) == len(FAMILIES) and not all(mark['merge_acceptable'] for mark in marks[mid].values()):
   533	            rejected[drawn_family(SEED + 2, *ids[mid])].append(mid)
   534	    third_check = lambda chunk: rows_check(chunk, {'verdict': lambda value: value in VERDICTS})
   535	    jobs = []
   536	    for family, family_ids in sorted(rejected.items()):
   537	        for number, chunk in enumerate(packets(family_ids, MERGE_PACKET), 1):
   538	            packet = [{'id': mid, 'earlier': entries[ids[mid][0]], 'later': entries[ids[mid][1]]} for mid in chunk]
   539	            jobs.append({'name': f'merge-third-{number}-{family}', 'family': family, 'ids': chunk,
   540	                         'prompt': inline(MERGE_THIRD_TEXT, MERGE_THIRD_READ, packet), 'check': third_check(chunk)})
   541	    answers = sessions(folder, jobs)
   542	    third = {mid: answers[job['name']][mid]['verdict'] for job in jobs if answers[job['name']] is not None for mid in job['ids']}
   543	    verdicts = {}
   544	    for mid in ids:
   545	        if len(marks[mid]) == len(FAMILIES) and all(mark['merge_acceptable'] for mark in marks[mid].values()):
   546	            verdicts[mid] = 'acceptable'
   547	        elif mid in third:
   548	            verdicts[mid] = third[mid]
   549	    (folder / 'verdicts.json').write_text(json.dumps({mid: {'earlier': ids[mid][0], 'later': ids[mid][1], 'marks': marks[mid],
   550	                                                            'verdict': verdicts.get(mid)} for mid in ids}, indent=1) + '\n')
   551	    wrong = sum(1 for verdict in verdicts.values() if verdict == 'wrong')
   552	    result = {'repeats': len(population), 'sample': LINE2_MERGES, 'pass at most': LINE2_WRONG,
   553	              'accepted by both readers': sum(1 for mid in ids if mid in verdicts and mid not in third),
   554	              'sent to the third reader': sum(len(v) for v in rejected.values()), 'verdicts': dict(collections.Counter(verdicts.values())),
   555	              'wrong': wrong}
