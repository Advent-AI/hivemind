   161	def read_rulings(run_folder, item_of, outcomes, readers, family=None):
   162	    """One third reader's rulings as the accounting takes them, with the ids asked for that have no valid ruling."""
   163	    send_of_item = {item: send for send, item in item_of.items()}
   164	    given = {}
   165	    pattern = f'rulings-{family}-*.jsonl' if family else 'rulings-[0-9]*.jsonl'
   166	    for answer_file in sorted((Path(run_folder) / 'third-reader').glob(pattern)):
   167	        for line in answer_file.read_text().splitlines():
   168	            line = line.strip()
   169	            if not line or line.startswith('```'):
   170	                continue
   171	            try:
   172	                ruling = json.loads(line)
   173	                given[ruling['id']] = ruling
   174	            except (ValueError, KeyError, TypeError):
   175	                continue
   176	    rulings, missing = {}, []
   177	    for send, marks, faults in disputes_of(outcomes, readers):
   178	        item_number = item_of[send]
   179	        sides = sides_of(send)
   180	        reader_of_side = {reader: side for side, reader in sides.items()}
   181	        entry = {'marks': {}, 'W': {}, 'why': {}}
   182	        for mark in marks:
   183	            ruling = given.get(f'{item_number}-{mark}', {})
   184	            if ruling.get('ruling') in accounting.VERDICTS:
   185	                entry['marks'][mark] = ruling['ruling']
   186	                entry['why'][mark] = ruling.get('why', '')
   187	            else:
   188	                missing.append(f'{item_number}-{mark}')
   189	        for reader, _ in faults:
   190	            ruling_id = f'{item_number}-W-{reader_of_side[reader]}'
   191	            ruling = given.get(ruling_id, {})
   192	            if ruling.get('upheld') in (True, False):
   193	                entry['W'][reader] = ruling['upheld']
   194	                entry['why'][f'W of {reader}'] = ruling.get('why', '')
   195	            else:
   196	                missing.append(ruling_id)
   197	        rulings[send] = entry
   198	    assert all(send in send_of_item.values() for send in rulings)
   199	    return rulings, missing
   200	
