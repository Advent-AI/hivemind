   448	def main(argv=None):
   449	    parser = argparse.ArgumentParser(description=__doc__.split('\n', 1)[0])
   450	    commands = parser.add_subparsers(dest='command', required=True)
   451	    packets = commands.add_parser('packets')
   452	    packets.add_argument('run_root')
   453	    packets.add_argument('eligibility')
   454	    packets.add_argument('out')
   455	    packets.add_argument('--keys', default=str(DEFAULT_KEYS))
   456	    for name in ('read', 'third', 'report'):
   457	        commands.add_parser(name).add_argument('out')
   458	    arguments = parser.parse_args(argv)
   459	    if arguments.command == 'packets':
   460	        build_packets(arguments.run_root, json.loads(Path(arguments.eligibility).read_text()), arguments.out, arguments.keys)
   461	    elif arguments.command == 'read':
   462	        read_packets(arguments.out)
   463	        for draw, folder, key_path in draws_to_read(Path(arguments.out), load_manifest(arguments.out)):
   464	            rows = run_stage_a_tool([COLLECT_READINGS, 'rows', folder, key_path], cwd=arguments.out)
   465	            print(f'{draw}, collect_readings.py rows:\n{rows.stdout.rstrip()}')
   466	    elif arguments.command == 'third':
   467	        read_disputes(arguments.out)
   468	    else:
   469	        report(arguments.out)
   470	
   471	
   472	if __name__ == '__main__':
   473	    main()

