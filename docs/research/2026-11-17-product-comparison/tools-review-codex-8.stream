    11	LADDER_MARKS = ['Q', 'O', 'R', 'D', 'X', 'L', 'XR']            # apply to every written ladder
    12	RULED_MARKS = ['Q', 'O', 'R', 'D', 'X', 'F', 'Y', 'L', 'XR', 'N']
    13	ALL_MARKS = ['Q', 'O', 'R', 'D', 'X', 'F', 'Y', 'G', 'L', 'XR', 'N']
    14	VERDICTS = ('holds', 'fails')
    15	NOT_MEASURED = 'NOT MEASURED'
    16	
    17	
    18	def kind_of(outcome):
    19	    """What a send's outcome is to a reader: a figure, an event, a refusal, or nothing to read. Runs stored before D409 hold an
    20	    event as yes/no or as five states, and are still read."""
    21	    if outcome['status'] == 'no ladder: refused':
    22	        return 'refused twice'
    23	    if outcome['status'] == 'no ladder':
    24	        return 'refusal'
    25	    ladder = outcome['answer']['ladder']
    26	    company = outcome['view']['kind'] == 'asset'
    27	    if ladder.get('figure') is not None:
    28	        return 'company figure' if company else 'theme figure'
    29	    if ladder.get('event') is not None:
    30	        return 'event'
    31	    if ladder.get('states') is not None:
    32	        return 'company states' if company else 'theme states'
    33	    return 'yes/no'
    34	
    35	
    36	def marks_that_apply(kind):
    37	    """The marks on which a reader must give `holds` or `fails` for an outcome of this kind (G is not among them: it is reported)."""
    38	    if kind == 'refusal':
    39	        return ['N']
    40	    marks = list(LADDER_MARKS)
    41	    if kind in ('company figure', 'company states'):
    42	        marks.append('F')
    43	    if kind in ('company figure', 'theme figure'):
    44	        marks.append('Y')
    45	    return marks
   159	
   160	    report['dispute share'] = 'no reading' if not read else (differing_pairs, applicable_pairs)
   161	    reading_is_complete = not report['invalid rows'] and not report['missing rulings']
   162	    too_disputed = bool(read) and applicable_pairs and differing_pairs * 3 > applicable_pairs
   163	    measured = bool(read) and reading_is_complete and not too_disputed
   164	    report['reading'] = ('no reading: every send was refused twice' if not read else
   165	                         'incomplete: a row or a ruling is missing' if not reading_is_complete else
   166	                         'too disputed: the readers differ on more than a third of the marks' if too_disputed else 'complete')
   167	
   168	    ladders = [outcome for outcome in read if kind_of(outcome) != 'refusal']
   169	    refusals = [outcome for outcome in read if kind_of(outcome) == 'refusal']
   170	
   171	    def failing(mark, population):
   172	        return [(outcome['case'], outcome['pass']) for outcome in population if values.get((outcome['case'], outcome['pass']), {}).get(mark) == 'fails']
   173	
   174	    for number, mark in ((1, 'Q'), (2, 'L'), (3, 'R')):
   175	        if not ladders or not measured:
   176	            report['lines'][number] = NOT_MEASURED
   177	        else:
   178	            failed = failing(mark, ladders)
   179	            report['lines'][number] = ('met' if not failed else 'missed', failed)
   180	    if not refusals:
   181	        report['lines'][4] = 'no refusal occurred'
   182	    elif not measured:
   183	        report['lines'][4] = NOT_MEASURED
   184	    else:
   185	        failed = failing('N', refusals)
   186	        report['lines'][4] = ('met' if not failed else 'missed', failed)
   187	
   188	    cases = sorted({outcome['case'] for outcome in outcomes})
   189	    sends_of = {case: sorted((outcome for outcome in outcomes if outcome['case'] == case), key=lambda outcome: outcome['pass']) for case in cases}
   190	    if read and not measured:
   191	        report['lines'][5] = NOT_MEASURED
   192	    else:
   193	        right_cases = [case for case in cases if sum(right[(o['case'], o['pass'])] for o in sends_of[case]) >= 2]
   194	        ladder_cases = [case for case in cases if sum(sound_ladder[(o['case'], o['pass'])] for o in sends_of[case]) >= 2]
   195	        met = len(right_cases) >= 35 and len(ladder_cases) >= 28
   196	        report['lines'][5] = ('met' if met else 'missed', {'right': len(right_cases), 'right by a ladder': len(ladder_cases), 'of': len(cases)})
