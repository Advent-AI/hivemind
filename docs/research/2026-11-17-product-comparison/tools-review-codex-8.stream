   148	def run(cases, passes, folder, cap_usd, *, research_list, texts, transport=None, workers=8, shared=None):
   149	    """Send every case once in each pass. Returns (outcomes written, the limit). The folder must not exist. `shared` is a run's
   150	    shared ledger (WIRING-DESIGN.md §B2, D448)."""
   151	    folder = Path(folder)
   152	    folder.mkdir(parents=True, exist_ok=False)
   153	    limit = StageALimit(cap_usd, folder / 'spend.jsonl', attempt=transport, shared=shared)
   154	    checksum = hashlib.sha256(json.dumps({'system': texts['system'], 'closing': texts['closing'], 'schema': texts['schema'],
   155	                                          'setting': [SETTING.model, SETTING.reasoning_effort, SETTING.max_output_tokens]},
   156	                                         ensure_ascii=False).encode()).hexdigest()[:16]
   157	    call_config = SimpleNamespace(provider='openai', version='clean-ladder-stage-a', checksum=checksum)
   158	    archives, outcome_files = {}, {}
   159	    for pass_number in passes:
   160	        (folder / f'send-{pass_number}').mkdir()
   161	        archives[pass_number] = model.Archive(str(folder / f'send-{pass_number}' / 'archive.sqlite'))
   162	        outcome_files[pass_number] = folder / f'send-{pass_number}' / 'outcomes.jsonl'
   163	    write_lock = threading.Lock()
   164	    written = []
   165	
   166	    def work(job):
   167	        case, pass_number = job
   168	        labelled = SimpleNamespace(request_number=0)
   169	        labelled.send = lambda provider, request: limit.send_labelled(f"{case['case']}|{pass_number}|{labelled.request_number}", provider, request)
   170	        call_model = model_calls.model_caller(model, archives[pass_number], call_config, SETTING, labelled)
   171	
   172	        def counted_call(system_text, user_text, schema):
   173	            labelled.request_number += 1
   174	            return call_model(system_text, user_text, schema)
   175	
   176	        def check(answer):
   177	            return ladder_step.check_answer(answer, thesis=case['thesis'], article=case['item'], company=COMPANY, research_list=research_list,
   178	                                            repair_quote=extraction.repair_quote, normalise=extraction.normalise,
   179	                                            quote_tokens=extraction._quote_tokens,
   180	                                            beyond_next_year=extraction.beyond_next_year, binding_horizon_days=extraction.BINDING_HORIZON_DAYS)
   181	        try:
   182	            outcome = ladder_step.ladder_for_thesis(payload_for(case, research_list), system_text=texts['system'], closing_text=texts['closing'],
   183	                                                    schema=texts['schema'], call_model=counted_call, check=check)
   184	            view = None
   185	            if outcome['status'] == 'ladder':
   186	                view = ladder_step.write_view(outcome['answer']['ladder'], outcome['passage'], thesis=case['thesis'],
   187	                                              article_day=case['item']['publication_date'], company=COMPANY,
   188	                                              research_list=research_list)
   189	            row = {'case': case['case'], 'pass': pass_number, 'status': outcome['status'], 'reason': outcome['reason'],
   190	                   'requests': outcome['requests'], 'answer': outcome['answer'], 'passage': outcome['passage'], 'view': view}
   135	def record_text(record, label):
   136	    attribution = record['original_party'] or 'unknown party'
   137	    if record['reporting_speaker'] and record['reporting_speaker'] != record['original_party']:
   138	        attribution += f", reported by {record['reporting_speaker']}"
   139	    head = (f"[{label}] {record['publication_date']} · {record['publisher'] or 'unknown publisher'} · {attribution} · tier {record['tier']}"
   140	            f" · stated {record['statement_date'] or 'unknown'} · period {record['evidence_period'] or 'unknown'}")
   141	    quotes = '\n'.join(f'  {label_of}: "{p}"' for label_of, p in labelled_passages(record))
   142	    return f"{head}\n  {record['summary']}\n{quotes}"
   143	
   144	
   145	def group_text(library, group_id, label, labels, member_text=True, notes=()):
   146	    """A group as a reader sees it: the original record, then each later report of the same statement in arrival order, with its own
   147	    text when `member_text` is set and as a source line otherwise. Distinct articles are counted; repeats are not called confirmation."""
   148	    group = library.groups[group_id]
   149	    lines = [record_text(group['original'], label)]
   150	    if group['members']:
   151	        articles = library.articles(group)
   152	        publishers = {r['publisher'] for r in [group['original']] + group['members']}
   153	        lines.append(f'  Later reports of the same statement: {len(group["members"])} records from {len(articles) - 1} further articles '
   154	                     f'({len(publishers)} publishers in all). Articles repeating a statement do not by themselves confirm it independently.')
   155	        for member in group['members']:
   156	            if member_text:
   157	                party = '' if member['original_party'] == group['original']['original_party'] else f" · {member['original_party']}"
   158	                quotes = ' '.join(f'"{p}"' if kind == 'Quote' else f'"{p}" (unverified)' for kind, p in labelled_passages(member))
   159	                lines.append(f"    - {member['publication_date']} · {member['publisher']}{party}: {member['summary']}\n      Quote: {quotes}")
   160	            else:
   161	                lines.append(f"    - {member['publication_date']} · {member['publisher']}")
   162	    for revised in group['revises']:
   710	    status = 'failed' if 'failed' in statuses else 'not measured' if 'not measured' in statuses else 'passed'
   711	    release = ([f'release blocked: Step 2 line {n} failed' for n, r in lines.items() if r['status'] == 'failed']
   712	               + [f'release not cleared: Step 2 line {n} not measured' for n, r in lines.items() if r['status'] == 'not measured']
   713	               or ['hard check clear'])
   714	    summary = {'draw': DRAW, 'status': status, 'release': release, 'lines': lines}
   715	    (Path(out) / 'step2-lines.json').write_text(json.dumps(summary, indent=1, ensure_ascii=False) + '\n')
   716	    return summary
   717	
   718	
   719	def main(argv=None):
   720	    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
   721	    parser.add_argument('command', choices=['line1', 'line2', 'line3', 'report'])
   722	    parser.add_argument('paths', nargs='+')
   723	    parser.add_argument('--keys', default=str(KEY_FOLDER))
   724	    args = parser.parse_args(argv)
   725	    if args.command == 'report':
   726	        summary = report(args.paths[0])
   727	    else:
   728	        run_root, eligibility_path, out = args.paths
   729	        Path(out).mkdir(parents=True, exist_ok=True)
   730	        {'line1': line1, 'line2': line2, 'line3': line3}[args.command](run_root, json.loads(Path(eligibility_path).read_text()), out, args.keys)
   731	        summary = json.loads((Path(out) / 'step2-lines.json').read_text())
   732	    print(json.dumps({'status': summary['status'], 'release': summary['release'],
   733	                      'lines': {n: {k: r.get(k) for k in ('status', 'reason')} for n, r in summary['lines'].items()}}, indent=1))
   734	
   735	
   736	if __name__ == '__main__':
   737	    main()

codex
The ordinary input paths match the writers. I found two ways a check can still move: Step 2 forms its strata after dropping empty articles, and D431’s eligibility prompt asks about units without showing the stored unit.
codex
## Part A

- **D400:** The verified copies, frozen briefs and D452 scaling fit the recorded outputs. Tighten packet validation. Duplicate item rows are silently collapsed, and a number such as `1.0` can pass the wrapper but be discarded by the collector. Reader timeouts also escape the retry loops because the shared launcher raises instead of returning a void. [Wrapper](/Users/lchingen/hivemind/docs/research/2026-11-17-product-comparison/stage0/d400_reader_lines.py:167) · [Collector](/Users/lchingen/hivemind/clean-arch/step4-2026-11-10/stage_a/collect_readings.py:43) · [Launcher](/Users/lchingen/hivemind/docs/research/2026-11-17-product-comparison/stage0/census/census_readers.py:122)
- **Step 2:** The neutral rewording, exact party match and two-family scan preserve v6’s intent. Line 1 forms strata after dropping articles with no records, which can change the first 100 labelled cases. Use manifest positions. Lines 1 and 2 also promise verbatim source passages, but the packet helper presents an unmatched model quotation as its own source context. Flag it as unverified. Line 3 sends isolated groups. Include the same surrounding dossier in both versions. [Sampling](/Users/lchingen/hivemind/docs/research/2026-11-17-product-comparison/stage0/step2_lines.py:300) · [Trace reader](/Users/lchingen/hivemind/clean-arch/step2/run_forward.py:67) · [Packet source](/Users/lchingen/hivemind/clean-arch/step2-validation-2026-11-07/build_merge_packets.py:22) · [Renderings](/Users/lchingen/hivemind/docs/research/2026-11-17-product-comparison/stage0/step2_lines.py:659)
- **D431:** Both writers record the cutoff sequence the tool needs. The eligibility prompt requires the same unit, yet the packet omits the stored judged unit. Supply it and withhold numeric agreement when units differ or cannot be established. No conversion is needed. Two third readers match the eligibility precedent. Using two for **identity matching** changes D442’s tie-break and needs a recorded decision. [Old writer](/Users/lchingen/hivemind/src/hivemind/replay.py:130) · [New writer](/Users/lchingen/hivemind/clean-arch/step4-2026-11-10/stage_b/ladder_adapter.py:425) · [Packet](/Users/lchingen/hivemind/docs/research/2026-11-17-product-comparison/stage0/d431_reading.py:422) · [D442](/Users/lchingen/hivemind/clean-arch/e2e-comparison-2026-11-13/DESIGN.md:43) · [Eligibility precedent](/Users/lchingen/hivemind/clean-arch/e2e-comparison-2026-11-13/full-eligibility/control-reader-brief.md:29)

NOT READY: fix packet validation and timeout handling, preserve Step 2’s sampling and source context, and settle D431’s units and identity tie-break.

## Part B

**Agree with Claude’s reading.** Line 3 asks whether grouping preserves material facts a later report adds, such as a new guidance condition or a changed date. A party or period still counts when it changes the claim. Print omissions of attribution fields separately. The original test graded answers to frozen analyst questions, so keep the answer key from dossier readers to preserve that test. The judge receives each shown copy with its same-claim note, but its request does not expose all four attribution fields as separate values. The recorded dossier test is the basis for this decision. [PRD](/Users/lchingen/hivemind/clean-arch/PRD.md:338) · [Detail definition](/Users/lchingen/hivemind/poc/data/step2-validation-2026-11-07/v2-prompt-1.md:15) · [Recorded test](/Users/lchingen/hivemind/clean-arch/step2-validation-2026-11-07/LOG.md:238) · [Judge request](/Users/lchingen/hivemind/src/hivemind/views/judging.py:128)
