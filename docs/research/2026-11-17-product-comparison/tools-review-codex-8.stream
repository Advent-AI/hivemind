   107	
   108	def ledger_total(ledger_path):
   109	    """What the ledger says was spent: over its attempt ids, the charge where there is one and the reserve where there is none.
   110	    Returns (known charges, reserves counted in full, whether a last line that was not whole was dropped)."""
   111	    reserves, charges, dropped = {}, {}, False
   112	    lines = Path(ledger_path).read_text().split('\n') if Path(ledger_path).exists() else []
   113	    for index, line in enumerate(lines):
   114	        if not line:
   115	            continue
   116	        try:
   117	            entry = json.loads(line)
   118	        except json.JSONDecodeError:
   119	            if index != len(lines) - 1:
   120	                raise
   121	            dropped = True
   122	            continue
   123	        if 'reserve' in entry:
   124	            reserves[entry['attempt']] = entry['reserve']
   125	        else:
   126	            charges[entry['attempt']] = (entry['charge'], entry['known'])
   127	    known = sum(charge for charge, is_known in charges.values() if is_known)
   128	    in_full = sum(charge for charge, is_known in charges.values() if not is_known)
   129	    in_full += sum(reserve for attempt, reserve in reserves.items() if attempt not in charges)
   130	    return known, in_full, dropped
