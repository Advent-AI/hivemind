284:def test_the_report_puts_a_failed_line_ahead_of_one_not_measured(tmp_path):
     1	"""D400's reader lines 1–5 on each new-system draw (DESIGN-1.6.md §1, "Reader lines 1–5"; RUN-PLAN-v12.md §1.6, row "D400 accounting").
     2	
     3	Stage A's reading, run per draw with Stage A's own tools unchanged:
     4	- `clean-arch/step4-2026-11-10/stage_a/build_reader_packets.py`, its second form with one run, writes the packets and the key;
     5	- every packet is read by two closed sessions, one per family (`census/census_readers.run`), with the form
     6	  `clean-arch/step4-2026-11-10/ladder/stage-a-reader-brief.md` and the packet inline, since a closed session opens no file; the words are
     7	  those of `stage-a-reader-handoff-template.md`, with the file paths replaced by the material;
     8	- `collect_readings.py disputes` writes the third readers' packets; each is read by two third readers, one per family, with
     9	  `stage-a-third-reader-brief.md`, the form and the packet inline (the words of `stage-a-third-reader-handoff-template.md`);
    10	- `collect_readings.py report` gives the lines.
    11	
    12	Line 5 is recomputed from the report's counts with D452's scaling (`clean-arch/e2e-comparison-2026-11-13/READING-PLAN.md` §2, "Line 5, a
    13	council-set diagnostic line"): "right ≥ ceil(35·N/44) and right by a ladder ≥ ceil(28·N/44) for the N fresh theses. Alex's D400 wording
    14	(35 and 28 of 44) is printed beside it with the actual N and the result; it is not reported as Alex's line. N = 0 reads NOT MEASURED
    15	(zero thresholds would pass vacuously)." `accounting.py` hard-codes 35 and 28, so its own line-5 verdict is never read. The reader lines are
    16	printed beside the verdict (verdict-rule.json `printed_beside`); they clear or block no release.
    17	
    18	    python3 d400_reader_lines.py packets <run root> <eligibility.json> <out> [--keys <folder>]
    19	    python3 d400_reader_lines.py read <out>
    20	    python3 d400_reader_lines.py third <out>
    21	    python3 d400_reader_lines.py report <out>
    22	
    23	`packets` reads each draw's ladder and cases folders from its `run.json` (`components[...]['folder']`, a redo's folder after a redo). A
    24	ladder component not completed (skipped: the draw opened no question) is not measured. Every file is read only through
    25	`eligibility.verified` and its bytes are checked against the fingerprint; one refusal stops the command before anything is written. Each
    26	draw with a completed ladder gets a reading folder `<out>/<draw>/`, the folder `collect_readings.py` reads: byte copies of `send-1..3/outcomes.jsonl` and
    27	of `cases.json`, then `readers/`, `readers-answers/`, `third-reader/`, `stage-a-report.json` and `report.txt`. Sessions' raw answers and
    28	`launches.jsonl` sit in `<out>/<draw>/attempts/`. The key from item number to case and pass is written to `<keys>/<out name>/<draw>.json`
    29	(default `~/.hivemind-keys/comparison-2026-11-17/`), outside `<out>` and outside the repository; `<out>/reading.json` records where.
    30	
    31	A session is void when `census_readers.run` voids it, or when its answer does not give a valid row (Stage A's own rule,
    32	`accounting.row_problem`) for every item of its packet, or a valid ruling for every point of its ruling packet, or gives one for an item
    33	or point outside it. A void session is retried once; a still-void one writes no answer file and is reported missing, so the draw's
    34	reading is incomplete and its lines are not measured. `read` and `third` skip a session whose answer file exists.
    35	"""
    36	import argparse
    37	import concurrent.futures
    38	import datetime
    39	import hashlib
    40	import json
    41	import subprocess
    42	import sys
    43	import threading
    44	from pathlib import Path
    45	
    46	HERE = Path(__file__).resolve().parent
    47	ROOT = HERE.parents[3]
    48	STAGE_A = ROOT / 'clean-arch' / 'step4-2026-11-10' / 'stage_a'
    49	LADDER = ROOT / 'clean-arch' / 'step4-2026-11-10' / 'ladder'
    50	sys.path[:0] = [str(STAGE_A), str(HERE), str(HERE / 'census'), str(ROOT / 'src')]
    51	import accounting  # noqa: E402
    52	import census_readers  # noqa: E402
    53	import collect_readings  # noqa: E402
    54	import eligibility as eligibility_tool  # noqa: E402
    55	from hivemind import universe  # noqa: E402
    56	
    57	BUILD_READER_PACKETS = STAGE_A / 'build_reader_packets.py'
    58	COLLECT_READINGS = STAGE_A / 'collect_readings.py'
    59	READER_BRIEF = LADDER / 'stage-a-reader-brief.md'
    60	THIRD_READER_BRIEF = LADDER / 'stage-a-third-reader-brief.md'
    61	UNIVERSE = ROOT / 'poc' / 'universe.json'
    62	DEFAULT_KEYS = Path.home() / '.hivemind-keys' / 'comparison-2026-11-17'
    63	NEW_DRAWS = ('new-1', 'new-2', 'new-3')
    64	PASSES = (1, 2, 3)
    65	FAMILIES = census_readers.FAMILIES
    66	SESSIONS_AT_ONCE = 6
    67	D400_THESES, D400_RIGHT, D400_RIGHT_BY_A_LADDER = 44, 35, 28
    68	D400_LIMIT = ('D400\'s limit: Stage A measures the step against the lines and its own three sends; it does not establish that the step '
    69	              'writes better ladders than production, nor any comparison with production.')
    70	TWO_COUNTINGS = ('every unresolved point counted for the answer', 'every unresolved point counted against it')
    71	LOG_LOCK = threading.Lock()
    72	
    73	READER_PROMPT = """Follow the brief below exactly. It is your whole task.
    74	The packet it speaks of is given after the brief ({count} items). The company in every item is NVIDIA (ticker NVDA); each
    75	item carries its fiscal-year note. The listed themes are: {themes}.
    76	
    77	You are read-only: do not edit files, run model calls or start runs. You have no files and no tools: the brief and the packet below are
    78	your whole material.
    79	
    80	You cannot write files: return your answer as your final message, exactly {count} lines, one JSON object per line, in item order, each
    81	with the `item` number the packet gives and the fields the brief lists, and nothing else: no prose before or after, no code fence.
    82	
    83	## The brief
    84	
    85	{brief}
    86	
    87	## The packet
    88	
    89	{packet}"""
    90	
    91	THIRD_READER_PROMPT = """Follow the third reader's brief below exactly; it sends you to the form, which is given in full after it and which you
    92	read first. It is your whole task. The packet is given last ({items} items, {points} points to rule on). The company in every item is NVIDIA
    93	(ticker NVDA); each item carries its fiscal-year note. The listed themes are: {themes}.
    94	
    95	You are read-only: do not edit files, run model calls or start runs. You have no files and no tools: the two briefs and the packet below
    96	are your whole material.
    97	
    98	You cannot write files: return your answer as your final message, exactly {points} lines, one JSON object per line, in the order
    99	the packet gives the points, and nothing else: no prose before or after, no code fence.
   100	
   101	## The third reader's brief
   102	
   103	{third_brief}
   104	
   105	## The form
   106	
   107	{brief}
   108	
   109	## The packet
   110	
   111	{packet}"""
   112	
   113	
   114	def sha256_of_bytes(data):
   115	    return hashlib.sha256(data).hexdigest()
   116	
   117	
   118	def scaled_line_5(right, right_by_a_ladder, theses):
   119	    """Line 5 under D452's scaling: (verdict, details). Met when right >= ceil(35N/44) and right by a ladder >= ceil(28N/44); N = 0 is
   120	    NOT MEASURED, since zero minimums would pass vacuously."""
   121	    details = {'right': right, 'right by a ladder': right_by_a_ladder, 'of': theses}
   122	    if theses == 0:
   123	        return accounting.NOT_MEASURED, {**details, 'reason': 'no thesis (N = 0): zero minimums would pass vacuously (D452)'}
   124	    minimum_right = -(-D400_RIGHT * theses // D400_THESES)
   125	    minimum_right_by_a_ladder = -(-D400_RIGHT_BY_A_LADDER * theses // D400_THESES)
   126	    met = right >= minimum_right and right_by_a_ladder >= minimum_right_by_a_ladder
   127	    return ('met' if met else 'missed'), {**details, 'minimum right': minimum_right, 'minimum right by a ladder': minimum_right_by_a_ladder}
   128	
   129	
   130	def line_5_of(stored_line):
   131	    """The scaled line 5 from the accounting's stored line 5: its counts are read, its own verdict (35/28 hard-coded) is not."""
   132	    if isinstance(stored_line, str):
   133	        return accounting.NOT_MEASURED, {'reason': f'the accounting reads {stored_line!r}'}
   134	    counts = stored_line[1]
   135	    return scaled_line_5(counts['right'], counts['right by a ladder'], counts['of'])
   136	
   137	
   138	def verdict_under_both(verdicts):
   139	    """One line under the two countings, as `collect_readings.py report` prints it: met only when met under both, missed when missed
   140	    under both, else it depends on the unresolved points."""
   141	    distinct = sorted(set(verdicts))
   142	    return distinct[0] if len(distinct) == 1 else 'depends on the unresolved points: ' + ' / '.join(distinct)
   143	
   144	
   145	def theme_list_text():
   146	    research_list = universe.load(str(UNIVERSE))
   147	    return ', '.join(f'{theme_id} ({name})' for theme_id, name in research_list.theme_list())
   148	
   149	
   150	def answer_lines(text):
   151	    """The JSON objects of an answer, read line by line as `collect_readings.py` reads answer files (blank lines and code fences
   152	    skipped; a line that is not a JSON object is not a row)."""
   153	    objects = []
   154	    for line in (text or '').splitlines():
   155	        line = line.strip()
   156	        if not line or line.startswith('```'):
   157	            continue
   158	        try:
   159	            parsed = json.loads(line)
   160	        except ValueError:
   161	            continue
   162	        if isinstance(parsed, dict):
   163	            objects.append(parsed)
   164	    return objects
   165	
   166	
   167	def rows_problem(answer, items, outcome_of_item):
   168	    """Why a reader's answer to a packet is void, or None: every item of the packet needs a valid row (accounting.row_problem), and no
   169	    row may name an item outside the packet (collect_readings would let it replace that item's row from another packet)."""
   170	    rows = {}
   171	    for row in answer_lines(answer):
   172	        try:
   173	            rows[int(row['item'])] = row
   174	        except (KeyError, TypeError, ValueError):
   175	            continue
   176	    outside = sorted(set(rows) - set(items))
   177	    if outside:
   178	        return f'rows for items outside the packet: {outside[:10]}'
   179	    problems = [(item, accounting.row_problem(rows.get(item), outcome_of_item[item])) for item in items]
   180	    problems = [(item, problem) for item, problem in problems if problem]
   181	    if problems:
   182	        return f'{len(problems)} items without a valid row: ' + '; '.join(f'item {item}: {problem}' for item, problem in problems[:5])
   183	    return None
   184	
   185	
   186	def rulings_problem(answer, mark_of_point):
   187	    """Why a third reader's answer to a ruling packet is void, or None: every point needs a ruling of the form (`holds` or `fails` on a
   188	    mark, `upheld` true or false on a fault named under W, as collect_readings.read_rulings takes them), and none may lie outside it."""
   189	    rulings = {row.get('id'): row for row in answer_lines(answer)}
   190	    outside = sorted(str(point) for point in set(rulings) - set(mark_of_point))
   191	    if outside:
   192	        return f'rulings for points outside the packet: {outside[:10]}'
   193	    missing = [point for point, mark in mark_of_point.items()
   194	               if not (rulings.get(point, {}).get('upheld') in (True, False) if mark == 'W'
   195	                       else rulings.get(point, {}).get('ruling') in accounting.VERDICTS)]
   196	    if missing:
   197	        return f'{len(missing)} points without a valid ruling: {missing[:10]}'
   198	    return None
   199	
   200	
   201	def session(draw_folder, name, family, prompt, problem_of):
   202	    """One closed session, retried once when void. Every attempt's raw answer and outcome are logged in `attempts/`. Returns (answer, None)
   203	    or (None, the last void reason)."""
   204	    attempts_folder = draw_folder / 'attempts'
   205	    void = None
   206	    for attempt in (1, 2):
   207	        answer, void = census_readers.run(family, prompt)
   208	        if answer is not None and void is None:
   209	            void = problem_of(answer)
   210	        with LOG_LOCK:
   211	            attempts_folder.mkdir(exist_ok=True)
   212	            if answer is not None:
   213	                (attempts_folder / f'{name}-attempt-{attempt}.txt').write_text(answer)
   214	            with open(attempts_folder / 'launches.jsonl', 'a') as log:
   215	                log.write(json.dumps({'session': name, 'family': family, 'attempt': attempt, 'void': void,
   216	                                      'prompt sha256': sha256_of_bytes(prompt.encode()),
   217	                                      'at': datetime.datetime.now().isoformat(timespec='seconds')}) + '\n')
   218	        if void is None:
   219	            return answer, None
   220	    return None, void
   221	
   222	
   223	def load_manifest(out):
   224	    path = Path(out) / 'reading.json'
   225	    if not path.exists():
   226	        raise SystemExit(f'refused: {path} missing; run `packets` first')
   227	    return json.loads(path.read_text())
   228	
   229	
   230	def draws_to_read(out, manifest):
   231	    """The draws with a reading folder, each copy checked against the fingerprint it was copied under."""
   232	    for draw, entry in manifest['draws'].items():
   233	        if entry['status'] != 'read':
   234	            continue
   235	        folder = Path(out) / draw
   236	        for copy_name, source in entry['inputs'].items():
   237	            if sha256_of_bytes((folder / copy_name).read_bytes()) != source['sha256']:
   238	                raise SystemExit(f'refused: {draw}/{copy_name} changed since it was copied from {source["path"]}')
   239	        yield draw, folder, Path(entry['key'])
   240	
   241	
   242	def number_of(packet_file):
   243	    return int(packet_file.stem.rsplit('-', 1)[1])
   244	
   245	
   246	def run_stage_a_tool(arguments, cwd):
   247	    return subprocess.run([sys.executable, *map(str, arguments)], capture_output=True, text=True, cwd=str(cwd))
   248	
   249	
   250	def verified_bytes(eligibility, run_root, draw, relative):
   251	    """A file's bytes, read only through eligibility.verified and checked again on the bytes read."""
   252	    data = eligibility_tool.verified(eligibility, run_root, draw, relative).read_bytes()
   253	    if sha256_of_bytes(data) != eligibility['draws'][draw]['inputs'][relative]:
   254	        raise SystemExit(f'refused: {draw}/{relative} changed while it was read')
   255	    return data
   256	
   257	
   258	def build_packets(run_root, eligibility, out, keys_folder=DEFAULT_KEYS):
   259	    """Every new draw's reading folder, packets and key; returns the manifest written to `<out>/reading.json`."""
   260	    run_root, out = Path(run_root).resolve(), Path(out).resolve()
   261	    keys_folder = Path(keys_folder).expanduser().resolve()
   262	    if out.exists():
   263	        raise SystemExit(f'refused: {out} exists')
   264	    if keys_folder.is_relative_to(out) or keys_folder.is_relative_to(ROOT):
   265	        raise SystemExit(f'refused: the keys folder {keys_folder} must lie outside {out} and outside the repository')
   266	    plans = {}
   267	    for draw in NEW_DRAWS:                                     # every file is checked before anything is written
   268	        record = json.loads((run_root / draw / 'run.json').read_text())
   269	        ladder = record['components'].get('ladder', {})
   270	        if ladder.get('state') != 'completed':
   271	            plans[draw] = {'status': f"not measured: the ladder component is {ladder.get('state')!r}"}
   272	            continue
   273	        cases_folder = record['components'].get('cases', {}).get('folder')
   274	        sources = {f'send-{number}/outcomes.jsonl': f"{ladder['folder']}/send-{number}/outcomes.jsonl" for number in PASSES}
   275	        sources['cases.json'] = f'{cases_folder}/cases.json'
   276	        copies = {copy_name: verified_bytes(eligibility, run_root, draw, relative) for copy_name, relative in sources.items()}
   277	        key_path = keys_folder / out.name / f'{draw}.json'
   278	        if key_path.exists():
   279	            raise SystemExit(f'refused: {key_path} exists; a key is never overwritten')
   280	        plans[draw] = {'status': 'read', 'copies': copies, 'key': key_path,
   281	                       'inputs': {copy_name: {'path': f'{draw}/{relative}', 'sha256': sha256_of_bytes(copies[copy_name])}
   282	                                  for copy_name, relative in sources.items()}}
   283	    out.mkdir(parents=True)
   284	    manifest = {'run root': str(run_root), 'eligible': eligibility.get('eligible'), 'eligibility problems': eligibility.get('problems'),
   285	                'briefs': {str(path.relative_to(ROOT)): sha256_of_bytes(path.read_bytes()) for path in (READER_BRIEF, THIRD_READER_BRIEF)},
   286	                'draws': {}}
   287	    for draw, plan in plans.items():
   288	        if plan['status'] != 'read':
   289	            manifest['draws'][draw] = {'status': plan['status']}
   290	            print(f'{draw}: {plan["status"]}')
   291	            continue
   292	        folder = out / draw
   293	        for copy_name, data in plan['copies'].items():
   294	            (folder / copy_name).parent.mkdir(parents=True, exist_ok=True)
   295	            (folder / copy_name).write_bytes(data)
   296	        plan['key'].parent.mkdir(parents=True, exist_ok=True)
   297	        built = run_stage_a_tool([BUILD_READER_PACKETS, plan['key'], '--run', f'{folder}={folder / "cases.json"}',
   298	                                  '--readers', folder / 'readers'], cwd=out)
   299	        if built.returncode != 0:
   300	            raise SystemExit(f'{draw}: build_reader_packets.py failed: {built.stderr.strip() or built.stdout.strip()}')
   301	        packets = len(list((folder / 'readers').glob('packet-*.json')))
   302	        manifest['draws'][draw] = {'status': 'read', 'inputs': plan['inputs'], 'key': str(plan['key']), 'packets': packets}
   303	        print(f'{draw}: {built.stdout.strip()}')
   304	    (out / 'reading.json').write_text(json.dumps(manifest, indent=1) + '\n')
   305	    return manifest
   306	
   307	
   308	def read_packets(out):
   309	    """Every packet of every draw with a reading folder read by one closed session of each family; returns [(draw, session, void or None)]."""
   310	    out = Path(out)
   311	    manifest = load_manifest(out)
   312	    brief, themes = READER_BRIEF.read_text(), theme_list_text()
   313	    jobs = []
   314	    for draw, folder, key_path in draws_to_read(out, manifest):
   315	        key = json.loads(key_path.read_text())
   316	        outcomes = {(outcome['case'], outcome['pass']): outcome for outcome in collect_readings.outcomes_of(folder)}
   317	        outcome_of_item = {int(item): outcomes[tuple(send)] for item, send in key.items()}
   318	        (folder / 'readers-answers').mkdir(exist_ok=True)
   319	        for packet_file in sorted((folder / 'readers').glob('packet-*.json'), key=number_of):
   320	            packet_text = packet_file.read_text()
   321	            items = [item['item'] for item in json.loads(packet_text)]
   322	            prompt = READER_PROMPT.format(count=len(items), themes=themes, brief=brief, packet=packet_text)
   323	            for family in FAMILIES:
   324	                answer_file = folder / 'readers-answers' / f'reader-{family}-packet-{number_of(packet_file)}.jsonl'
   325	                if not answer_file.exists():
   326	                    jobs.append((draw, folder, answer_file, family, prompt,
   327	                                 lambda answer, items=items, outcome_of_item=outcome_of_item: rows_problem(answer, items, outcome_of_item)))
   328	    return run_sessions(jobs)
   329	
   330	
   331	def read_disputes(out):
   332	    """Every ruling packet `collect_readings.py disputes` writes, read by one third reader of each family; returns [(draw, session, void
   333	    or None)]. A draw whose rows are missing or not valid gets no ruling packet: `disputes` refuses it, and the refusal is printed."""
   334	    out = Path(out)
   335	    manifest = load_manifest(out)
   336	    brief, third_brief, themes = READER_BRIEF.read_text(), THIRD_READER_BRIEF.read_text(), theme_list_text()
   337	    jobs = []
   338	    for draw, folder, key_path in draws_to_read(out, manifest):
   339	        if not (folder / 'third-reader').exists():
   340	            disputes = run_stage_a_tool([COLLECT_READINGS, 'disputes', folder, key_path], cwd=out)
   341	            print(f"{draw}: {disputes.stdout.strip() if disputes.returncode == 0 else 'disputes refused: ' + disputes.stderr.strip()}")
   342	            if disputes.returncode != 0:
   343	                continue
   344	        for packet_file in sorted((folder / 'third-reader').glob('ruling-packet-*.json'), key=number_of):
   345	            packet_text = packet_file.read_text()
   346	            packet = json.loads(packet_text)
   347	            mark_of_point = {point['id']: point['mark'] for entry in packet for point in entry['to_rule']}
   348	            prompt = THIRD_READER_PROMPT.format(items=len(packet), points=len(mark_of_point), themes=themes, third_brief=third_brief,
   349	                                                brief=brief, packet=packet_text)
   350	            for family in FAMILIES:
   351	                answer_file = folder / 'third-reader' / f'rulings-{family}-{number_of(packet_file)}.jsonl'
   352	                if not answer_file.exists():
   353	                    jobs.append((draw, folder, answer_file, family, prompt,
   354	                                 lambda answer, mark_of_point=mark_of_point: rulings_problem(answer, mark_of_point)))
   355	    return run_sessions(jobs)
   356	
   357	
   358	def run_sessions(jobs):
   359	    def one(job):
   360	        draw, folder, answer_file, family, prompt, problem_of = job
   361	        answer, void = session(folder, answer_file.stem, family, prompt, problem_of)
   362	        if answer is not None:
   363	            answer_file.write_text(answer)
   364	        return draw, answer_file.stem, void
   365	    print(f'{len(jobs)} sessions to run', flush=True)
   366	    results = []
   367	    with concurrent.futures.ThreadPoolExecutor(max_workers=SESSIONS_AT_ONCE) as pool:
   368	        for draw, name, void in pool.map(one, jobs):
   369	            print(f'{draw} {name}: {"VOID after two attempts, reported missing: " + void if void else "answered"}', flush=True)
   370	            results.append((draw, name, void))
   371	    return results
   372	
   373	
   374	def missing_sessions(folder):
   375	    """The answer files `collect_readings.py` expects and does not find: a session reported missing, or not yet run."""
   376	    missing = [f'reader-{family}-packet-{number_of(packet_file)}' for packet_file in sorted((folder / 'readers').glob('packet-*.json'), key=number_of)
   377	               for family in FAMILIES if not (folder / 'readers-answers' / f'reader-{family}-packet-{number_of(packet_file)}.jsonl').exists()]
   378	    missing += [f'rulings-{family}-{number_of(packet_file)}' for packet_file in sorted((folder / 'third-reader').glob('ruling-packet-*.json'), key=number_of)
   379	                for family in FAMILIES if not (folder / 'third-reader' / f'rulings-{family}-{number_of(packet_file)}.jsonl').exists()]
   380	    return missing
   381	
   382	
   383	def report(out):
   384	    """`collect_readings.py report` on every draw with a reading folder, with line 5 recomputed under D452's scaling; written to
   385	    `<out>/d400-reader-lines.json` and printed."""
   386	    out = Path(out)
   387	    manifest = load_manifest(out)
   388	    result = {'eligible': manifest['eligible'], 'draws': {}}
   389	    to_read = {draw: (folder, key_path) for draw, folder, key_path in draws_to_read(out, manifest)}
   390	    for draw, entry in manifest['draws'].items():
   391	        if draw not in to_read:
   392	            result['draws'][draw] = {'status': entry['status'], **{f'line {number}': accounting.NOT_MEASURED for number in (1, 2, 3, 4, 5)}}
   393	            continue
   394	        folder, key_path = to_read[draw]
   395	        stored_path = folder / 'stage-a-report.json'
   396	        stored_path.unlink(missing_ok=True)                     # a failed report must not leave an earlier one to be read
   397	        collected = run_stage_a_tool([COLLECT_READINGS, 'report', folder, key_path], cwd=out)
   398	        (folder / 'report.txt').write_text(collected.stdout + (f'\n[exit {collected.returncode}] {collected.stderr}' if collected.returncode else ''))
   399	        missing = missing_sessions(folder)
   400	        if collected.returncode != 0:
   401	            reason = collected.stderr.strip().splitlines()[-1] if collected.stderr.strip() else f'exit {collected.returncode}'
   402	            result['draws'][draw] = {'status': f'not measured: collect_readings.py report refused: {reason}', 'missing sessions': missing,
   403	                                     **{f'line {number}': accounting.NOT_MEASURED for number in (1, 2, 3, 4, 5)}}
   404	            continue
   405	        stored = json.loads(stored_path.read_text())
   406	        countings = {'one counting (no rulings of two third readers)': stored} if 'lines' in stored else {label: stored[label] for label in TWO_COUNTINGS}
   407	        entry_out = {'status': 'read', 'missing sessions': missing,
   408	                     'reading': {label: counting['reading'] for label, counting in countings.items()},
   409	                     'dispute share': next(iter(countings.values()))['dispute share'],
   410	                     'unresolved points': len(stored.get('unresolved', []))}
   411	        for number in ('1', '2', '3', '4'):
   412	            entry_out[f'line {number}'] = verdict_under_both(
   413	                [line if isinstance(line, str) else line[0] for line in (counting['lines'][number] for counting in countings.values())])
   414	        line_5 = {label: line_5_of(counting['lines']['5']) for label, counting in countings.items()}
   415	        entry_out['line 5'] = verdict_under_both([verdict for verdict, _ in line_5.values()])
   416	        entry_out['line 5 by counting'] = {label: {'verdict': verdict, **details} for label, (verdict, details) in line_5.items()}
   417	        result['draws'][draw] = entry_out
   418	    (out / 'd400-reader-lines.json').write_text(json.dumps(result, indent=1, ensure_ascii=False) + '\n')
   419	    print_report(result)
   420	    return result
   421	
   422	
   423	def print_report(result):
   424	    print('D400 reader lines 1–5, per new draw (printed beside the verdict; they clear or block no release)')
   425	    print('eligibility:', {True: 'the draws are eligible', False: 'the draws are NOT eligible: a diagnostic only'}.get(result['eligible'], 'not stated'))
   426	    names = {'1': 'no ladder fails Q', '2': 'no ladder fails L', '3': 'no ladder fails R', '4': 'no refusal fails N'}
   427	    for draw, entry in result['draws'].items():
   428	        print(f'== {draw}: {entry["status"]}')
   429	        if entry['status'] == 'read':
   430	            print(f"   reading: {entry['reading']}; dispute share {entry['dispute share']}; unresolved points {entry['unresolved points']}")
   431	        if entry.get('missing sessions'):
   432	            print(f"   sessions missing: {entry['missing sessions']}")
   433	        for number, name in names.items():
   434	            print(f'   line {number} ({name}): {entry[f"line {number}"]}')
   435	        print(f"   line 5 (council-set diagnostic line, D452; never Alex's line): {entry['line 5']}")
   436	        for label, details in entry.get('line 5 by counting', {}).items():
   437	            minimums = (f"; minimums ceil(35N/44) = {details['minimum right']} and ceil(28N/44) = {details['minimum right by a ladder']}"
   438	                        if 'minimum right' in details else f"; {details.get('reason', '')}")
   439	            counts = (f"right {details['right']}, right by a ladder {details['right by a ladder']}, of N = {details['of']}"
   440	                      if 'of' in details else 'no counts')
   441	            print(f"      {label}: {counts}{minimums} -> {details['verdict']}")
   442	        theses = next((details['of'] for details in entry.get('line 5 by counting', {}).values() if 'of' in details), 'not counted')
   443	        print(f'      beside: D400\'s wording, at least {D400_RIGHT} right and {D400_RIGHT_BY_A_LADDER} right by a ladder of '
   444	              f'{D400_THESES} theses; this draw has N = {theses}')
   445	    print(D400_LIMIT)
   446	
