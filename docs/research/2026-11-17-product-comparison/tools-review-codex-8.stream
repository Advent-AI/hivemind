   437	    for article_index, article in enumerate(articles):
   438	        article_start[article_index] = index
   439	        index += len(article)
   440	    article_of = {record['id']: article_index for article_index, article in enumerate(articles) for record in article}
   441	    forward = {record['id']: position for position, record in enumerate(records)}
   442	    earlier_of = lambda record_id: records[:article_start[article_of[record_id]]]
   443	    words = {record['id']: matching._words(record['summary'] + ' ' + ' '.join(record['passages'])) for record in records}
   444	    order = draw_order(strata_of(articles), SEED + 1)
   445	    pairs, packet_ids, by_later = {}, {}, collections.defaultdict(list)
   446	    scan_flags, scan_missing = {}, set()
   447	    done, wave, labelled, missing_at = 0, 0, [], None
   448	    while done < len(order):
   449	        size = FIRST_WAVE_ROUNDS * STRATA if not labelled else math.ceil((LINE1_RECORDS - len(labelled)) * done / len(labelled))
   450	        batch, done, wave = order[done:done + max(1, size)], done + max(1, size), wave + 1
   451	        flags, missing = scan(folder, f'w{wave}', [item['record'] for item in batch if item['audited']], earlier_of, entries)
   452	        scan_flags.update(flags)
   453	        scan_missing |= missing
   454	        new_pairs = []
   455	        for item in batch:
   456	            record_id = item['record']
   457	            routes = route_candidates(by_id[record_id], earlier_of(record_id), words)
   458	            for earlier_id in flags.get(record_id, ()):
   459	                routes.setdefault(earlier_id, []).append('scan')
   460	            for earlier_id in sorted(routes, key=forward.get):
   461	                pairs[(earlier_id, record_id)] = {'earlier': earlier_id, 'routes': routes[earlier_id], 'marks': {}, 'third': None, 'label': None}
   462	                by_later[record_id].append(pairs[(earlier_id, record_id)])
   463	                new_pairs.append((earlier_id, record_id))
   464	        label(folder, f'w{wave}', new_pairs, pairs, entries, packet_ids)
   465	        labelled, missing_at = labelled_in_order(order[:done], by_later, scan_missing)
   466	        if missing_at or len(labelled) >= LINE1_RECORDS:
   467	            break
   468	    write_key(key_file, {packet_ids[key]: {'earlier': key[0], 'later': key[1], 'routes': pair['routes']} for key, pair in pairs.items()})
   469	    drawn = order[:done]
   470	    labels = {'draw': DRAW, 'seed': SEED + 1, 'records in draw order': len(order), 'records drawn': len(drawn),
   471	              'records': [{**item, 'scan missing': item['record'] in scan_missing,
   472	                           'pairs': [{k: pair[k] for k in ('earlier', 'marks', 'third', 'label')} for pair in by_later[item['record']]]}
   473	                          for item in drawn]}
   474	    labels_sha = freeze(folder / 'labels.json', labels)
   475	    # Step 2's output is read only now, after the labels are frozen.
   476	    decisions = {d['id']: d for d in json.loads(component_file(run_root, eligibility_record, 'step2', 'decisions.json').read_text())}
   477	    stored = json.loads(component_file(run_root, eligibility_record, 'step2', 'library.json').read_text())
   478	    counterparts = {record_id: {pair['earlier'] for pair in item_pairs if pair['label'] == 'same_statement'}
   479	                    for record_id, item_pairs in ((item['record'], item['pairs']) for item in labels['records'])}
   480	    found = original_counterpart = 0
