   347	def scan(folder, tag, audited, earlier_of, entries):
   348	    """The whole-history scan of the audited records, both families: {record: flagged earlier ids}, and the records whose scan has a
   349	    missing session."""
   350	    jobs = []
   351	    for number, record_id in enumerate(audited, 1):
   352	        for part, chunk in enumerate(packets(earlier_of(record_id), SCAN_CHUNK), 1):
   353	            keys = {e['id'] for e in chunk}
   354	            packet = [{'incoming_key': record_id, 'incoming': entries[record_id],
   355	                       'earlier_items': [{'key': e['id'], 'summary': e['summary'], 'original_party': e['original_party']} for e in chunk]}]
   356	
   357	            def check(answer, record_id=record_id, keys=keys):
   358	                rows = [row for row in answer_rows(answer) if row.get('incoming_key') == record_id]
   359	                if len(rows) != 1 or not is_text_list(rows[0].get('possible_earlier')):
   360	                    raise ValueError(f'no single row for {record_id} with a list of keys')
   361	                return {key for key in rows[0]['possible_earlier'] if key in keys}   # a key outside the chunk is not judged
   362	            for family in FAMILIES:
   363	                jobs.append({'name': f'scan-{tag}-r{number}-c{part}-{family}', 'family': family, 'record': record_id,
   364	                             'prompt': inline(SCAN_TEXT, 'Read PACKET. ', packet), 'check': check})
   365	    answers = sessions(folder, jobs)
   366	    flags, missing = collections.defaultdict(set), set()
   367	    for job in jobs:
   368	        if answers[job['name']] is None:
   369	            missing.add(job['record'])
   370	        else:
   371	            flags[job['record']] |= answers[job['name']]
   372	    return flags, missing
