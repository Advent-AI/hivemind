   309	def draw_order(strata, seed):
   310	    """Records drawn in rounds, one at random from each stratum per round until the strata are exhausted; the first 4 drawn in each
   311	    stratum are the scan audit's."""
   312	    chooser = random.Random(seed)
   313	    shuffled = [chooser.sample(ids, len(ids)) for ids in strata]
   314	    order = []
   315	    for round_index in range(max(map(len, shuffled), default=0)):
   316	        order += [{'record': ids[round_index], 'stratum': stratum, 'audited': round_index < AUDITED_PER_STRATUM}
   317	                  for stratum, ids in enumerate(shuffled) if round_index < len(ids)]
   318	    return order
