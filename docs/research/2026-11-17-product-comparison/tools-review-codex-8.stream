   485	    audited = [item['record'] for item in drawn if item['audited']]
   486	    audit_pairs = [(c, r) for r in audited for c in counterparts.get(r, ())]
   487	    result = {'labels sha256': labels_sha, 'labelled records': len(labelled), 'needed': LINE1_RECORDS, 'pass at': LINE1_FOUND,
   488	              'records drawn': len(drawn), 'records in the strata': len(order), 'pairs labelled': len(pairs),
   489	              'disputes sent to a third reader': sum(1 for pair in pairs.values() if pair['third']),
