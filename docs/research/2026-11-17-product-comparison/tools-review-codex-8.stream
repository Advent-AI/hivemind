   452	
   453	class Reading:
   454	    """Everything the sessions are asked and everything the result counts, rebuilt from the stores, the frozen files and the key."""
   455	
   456	    def __init__(self, stores, out, key_path, diagnostic=False):
   457	        self.out, self.diagnostic = Path(out), diagnostic
   458	        marker = self.out / 'DIAGNOSTIC'
   459	        if self.out.exists() and any(self.out.iterdir()) and marker.exists() != diagnostic:
   460	            raise SystemExit(f'refused: {self.out} holds a {"diagnostic" if marker.exists() else "release"} reading')
   461	        self.frozen = frozen_inputs()
   462	        self.draws = {draw: read_store(entry) for draw, entry in stores.items()}
   463	        labels = draw_labels(self.draws)

