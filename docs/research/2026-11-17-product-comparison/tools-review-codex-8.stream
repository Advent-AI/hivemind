   415	def labelled_in_order(order, by_later, scan_missing):
   416	    """The labelled records in draw order up to the first 100, and the first record with a missing mark before them, if any."""
   417	    labelled = []
   418	    for item in order:
   419	        record_id = item['record']
   420	        if record_id in scan_missing or any(pair['label'] is None for pair in by_later[record_id]):
   421	            return labelled, record_id
   422	        if any(pair['label'] == 'same_statement' for pair in by_later[record_id]):
   423	            labelled.append(record_id)
   424	            if len(labelled) == LINE1_RECORDS:
   425	                break
   426	    return labelled, None
