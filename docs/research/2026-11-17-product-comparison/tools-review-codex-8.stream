   333	def rows_problem(answer, key, expected, check):
   334	    """Why an answer is void: it must hold each expected key exactly once, each row passing `check`."""
   335	    rows = [r for r in json_lines(answer) if isinstance(r, dict)]
   336	    found = [r.get(key) for r in rows]
   337	    if sorted(map(str, found)) != sorted(map(str, expected)):
   338	        return f'{len(rows)} rows for {len(expected)} expected, or a {key} missing or repeated'
   339	    for r in rows:
   340	        problem = check(r)
   341	        if problem:
   342	            return f'{key} {r.get(key)}: {problem}'
   343	    return None
   344	
   345	
   346	# ---------- step 4: matching
   347	
   348	def draw_labels(draws):
   349	    """{draw: neutral run name}: the draws in a seeded order, named r1.. (as the precedent's packets)."""
   350	    order = list(draws)
   351	    random.Random(SEED).shuffle(order)
   352	    return {draw: f'r{n}' for n, draw in enumerate(order, 1)}
   353	
   354	
   355	def opened_rows(run, views):
   356	    """The precedent's row shape (`extract_opened_prod.py`), under neutral ids t01.. in creation order."""
   357	    return [{'run': run, 'id': f't{n:02d}', 'article': v['created_from_input'], 'description': v['question'], 'outcome': v['looks_at'],
   358	             'period': f"year {v['year']}; due {v['due_day']}"} for n, v in enumerate(views, 1)]
   359	
   360	
   361	def match_prompt(frozen, run, rows):
   362	    return MATCH_BRIEF.format(count=len(rows), rule=frozen['rule'], run=run,
   363	                              questions=json.dumps(frozen['entries'], indent=1, ensure_ascii=False),
   364	                              rows=json.dumps(rows, indent=1, ensure_ascii=False))
   365	
   366	
   367	def match_problem(rows, ruler_ids):
   368	    def check(r):
   369	        if r.get('run') != rows[0]['run']:
   370	            return f"run {r.get('run')!r}"
   371	        if r.get('match') not in (*ruler_ids, 'none') or r.get('relation') not in RELATIONS:
   372	            return f"match {r.get('match')!r}, relation {r.get('relation')!r}"
   373	        if not isinstance(r.get('reason'), str) or not r['reason'].strip():
   374	            return 'no reason'
   375	        return None
   376	    return lambda answer: rows_problem(answer, 'id', [r['id'] for r in rows], check)
   377	
   378	
   379	def same_marks(answer):
   380	    """{neutral id: ruler question} of the rows a reader calls SAME: relation "same" and a ruler question named."""
   381	    return {r['id']: r['match'] for r in json_lines(answer) if r.get('relation') == 'same' and r.get('match') not in (None, 'none')}
   382	
   383	
   384	def pair_marks(answers):
   385	    """{(neutral id, question): {family: bool}} for every pair either family calls SAME; None when a family's answer is missing."""
   386	    if any(answers[family] is None for family in census_readers.FAMILIES):
   387	        return None
   388	    marks = {family: same_marks(answers[family]) for family in census_readers.FAMILIES}
   389	    pairs = {}
   390	    for family, same in marks.items():
   391	        for neutral, question in same.items():
   392	            pairs.setdefault((neutral, question), {})
   393	    for (neutral, question), by in pairs.items():
   394	        for family in census_readers.FAMILIES:
   395	            by[family] = marks[family].get(neutral) == question
   396	    return pairs
   397	
   398	
   399	def match_third_prompt(frozen, disputes):
   400	    pairs = [{'dispute': n, 'opened_question': {k: d['row'][k] for k in ('description', 'outcome', 'period')}, 'reference_question': d['question']}
   401	             for n, d in enumerate(disputes, 1)]
   402	    return MATCH_THIRD_BRIEF.format(count=len(pairs), rule=frozen['rule'], rulings=frozen['rulings'],
   403	                                    questions=json.dumps(frozen['entries'], indent=1, ensure_ascii=False),
   404	                                    pairs=json.dumps(pairs, indent=1, ensure_ascii=False))
   405	
   406	
   407	def match_third_problem(count):
   408	    def check(r):
   409	        return None if isinstance(r.get('same'), bool) and isinstance(r.get('reason'), str) and r['reason'].strip() else 'same is true or false, with a reason'
   410	    return lambda answer: rows_problem(answer, 'dispute', list(range(1, count + 1)), check)
   411	
   412	
   413	def ruling(values):
   414	    """Two third readers' rulings: agreed, or unresolved; a missing ruling is not measured."""
   415	    if any(v is None for v in values):
   416	        return 'not measured'
   417	    return values[0] if values[0] == values[1] else 'unresolved'
   418	
   419	
   420	# ---------- step 5: eligibility
   421	
   422	def control_item(number, frozen, question_id, view):
   423	    ruler = frozen['questions'][question_id]
   424	    return {'control': number, 'ruler_question': {key: ruler[key] for key in ('question', 'unit', 'due_day', 'rungs')},
   425	            'judged_question': {key: view[key] for key in ('question', 'looks_at', 'due_day', 'year', 'kind')},
   426	            'judged_rungs': view['rungs']}
   427	
   428	
   429	def eligibility_problem(controls):
   430	    def check(r):
   431	        if set(r) != {'control', 'same_question', 'same_due', 'why'} or r['same_question'] not in YES_NO or r['same_due'] not in YES_NO:
   432	            return 'a row is {control, same_question, same_due, why}, each answer "yes" or "no"'
   433	        return None if isinstance(r['why'], str) and r['why'].strip() else 'no why'
   434	    return lambda answer: rows_problem(answer, 'control', controls, check)
   435	
   436	
   437	def eligibility_third_problem(points):
   438	    def check(r):
   439	        if set(r) != {'control', 'field', 'ruling', 'why'} or r['ruling'] not in YES_NO or r['field'] not in FIELDS:
   440	            return 'a ruling is {control, field, ruling "yes" or "no", why}'
   441	        return None
   442	    def problem(answer):
   443	        rows = [r for r in json_lines(answer) if isinstance(r, dict)]
   444	        named = sorted((str(r.get('control')), str(r.get('field'))) for r in rows)
   445	        if named != sorted((str(c), f) for c, f in points):
   446	            return f'{len(rows)} rulings for {len(points)} points, or a point missing or repeated'
   447	        return next((p for p in map(check, rows) if p), None)
   448	    return problem
   449	
   450	
   451	# ---------- the reading
   452	
   453	class Reading:
   454	    """Everything the sessions are asked and everything the result counts, rebuilt from the stores, the frozen files and the key."""
   455	
   456	    def __init__(self, stores, out, key_path, diagnostic=False):
   457	        self.out, self.diagnostic = Path(out), diagnostic
   458	        marker = self.out / 'DIAGNOSTIC'
   459	        if self.out.exists() and any(self.out.iterdir()) and marker.exists() != diagnostic:
   460	            raise SystemExit(f'refused: {self.out} holds a {"diagnostic" if marker.exists() else "release"} reading')
   461	        self.frozen = frozen_inputs()
   462	        self.draws = {draw: read_store(entry) for draw, entry in stores.items()}
   463	        labels = draw_labels(self.draws)
   464	        key_path = Path(key_path)
   465	        if key_path.exists():
   466	            if json.loads(key_path.read_text()) != labels:
   467	                raise SystemExit(f'refused: {key_path} names other draws than this reading')
   468	        else:
   469	            key_path.parent.mkdir(parents=True, exist_ok=True)
   470	            key_path.write_text(json.dumps(labels, indent=1) + '\n')
   471	        self.labels = labels
   472	        self.out.mkdir(parents=True, exist_ok=True)
   473	        if diagnostic:
   474	            marker.write_text('finished draws of a run that cannot give a release verdict (plan §1.4 item 10)\n')
   475	        self.rows = {draw: opened_rows(labels[draw], d['listed']) for draw, d in self.draws.items()}
   476	        self.view_of = {draw: {row['id']: view for row, view in zip(self.rows[draw], d['listed'])} for draw, d in self.draws.items()}
   477	        self.ruler_ids = [q['id'] for q in self.frozen['entries']]
   478	        self.used = {}                   # session name -> answer or None, for every session the result read
   479	
   480	    def answer(self, phase, family, prompt):
   481	        name = session_name(phase, family, prompt)
   482	        self.used[name] = stored_answer(self.out, name, prompt)
   483	        return self.used[name]
   484	
   485	    # matching
   486	    def match_jobs(self):
   487	        jobs = []
   488	        for draw, rows in sorted(self.rows.items(), key=lambda item: self.labels[item[0]]):
   489	            if rows:
   490	                prompt = match_prompt(self.frozen, self.labels[draw], rows)
   491	                jobs += [(session_name(f'match-{self.labels[draw]}', family, prompt), family, prompt, match_problem(rows, self.ruler_ids))
   492	                         for family in census_readers.FAMILIES]
   493	        return jobs
   494	
   495	    def first_marks(self):
   496	        """{draw: {(neutral id, question): {family: bool}} or None when a family's session is missing}."""
   497	        marks = {}
   498	        for draw, rows in self.rows.items():
   499	            if not rows:
   500	                marks[draw] = {}
   501	                continue
   502	            prompt = match_prompt(self.frozen, self.labels[draw], rows)
   503	            answers = {family: self.answer(f'match-{self.labels[draw]}', family, prompt) for family in census_readers.FAMILIES}
   504	            marks[draw] = pair_marks(answers)
   505	        return marks
   506	
   507	    def match_disputes(self, marks):
   508	        disputes = []
   509	        for draw in sorted(self.rows, key=self.labels.get):
   510	            rows = {row['id']: row for row in self.rows[draw]}
   511	            for (neutral, question), by in sorted((marks.get(draw) or {}).items()):
   512	                if len(set(by.values())) == 2:
   513	                    disputes.append({'draw': draw, 'id': neutral, 'question': question, 'row': rows[neutral]})
   514	        return disputes
   515	
   516	    def match_third_jobs(self, disputes):
   517	        if not disputes:
   518	            return []
   519	        prompt = match_third_prompt(self.frozen, disputes)
   520	        return [(session_name('match-third', family, prompt), family, prompt, match_third_problem(len(disputes)))
   521	                for family in census_readers.FAMILIES]
   522	
   523	    def pair_status(self):
   524	        """{draw: {(neutral id, question): 'same' | 'not same' | 'unresolved' | 'not measured'}}, or a draw's value None when its first
   525	        matching is missing."""
   526	        marks = self.first_marks()
   527	        disputes = self.match_disputes(marks)
   528	        rulings = {}
   529	        if disputes:
   530	            prompt = match_third_prompt(self.frozen, disputes)
   531	            for family in census_readers.FAMILIES:
   532	                answer = self.answer('match-third', family, prompt)
   533	                by_number = {r['dispute']: r['same'] for r in json_lines(answer)} if answer is not None else {}
   534	                for n, dispute in enumerate(disputes, 1):
   535	                    rulings.setdefault((dispute['draw'], dispute['id'], dispute['question']), []).append(by_number.get(n))
   536	        status = {}
   537	        for draw, pairs in marks.items():
   538	            if pairs is None:
   539	                status[draw] = None
   540	                continue
   541	            status[draw] = {}
   542	            for (neutral, question), by in pairs.items():
   543	                if all(by.values()):
   544	                    status[draw][(neutral, question)] = 'same'
   545	                else:
   546	                    decided = ruling(rulings[(draw, neutral, question)])
   547	                    status[draw][(neutral, question)] = {True: 'same', False: 'not same'}.get(decided, decided)
   548	        return status
   549	
   550	    def matched(self):
   551	        """{draw: {question: {'resolution', 'judged', 'listed', 'candidates'}}} by D442 point 4 and step 6 (iv)."""
   552	        out = {}
   553	        for draw, pairs in self.pair_status().items():
   554	            out[draw] = {}
   555	            for question in self.ruler_ids:
   556	                if pairs is None:
   557	                    out[draw][question] = {'resolution': 'not measured', 'detail': 'a matching session is missing', 'judged': None,
   558	                                           'listed': [], 'candidates': []}
   559	                    continue
   560	                candidates = sorted(((self.view_of[draw][neutral], status) for (neutral, q), status in pairs.items() if q == question),
   561	                                    key=lambda item: (item[0]['created_seq'], item[0]['created_order']))
   562	                confirmed = [view for view, status in candidates if status == 'same']
   563	                described = [{'view': view['view_id'], 'status': status} for view, status in candidates]
   564	                if confirmed:
   565	                    entry = {'resolution': 'matched', 'judged': confirmed[0],
   566	                             'listed': [c for c in described if c['view'] != confirmed[0]['view_id'] and c['status'] != 'not same']}
   567	                elif any(status == 'not measured' for _, status in candidates):
   568	                    entry = {'resolution': 'not measured', 'detail': 'a third matching session is missing', 'judged': None, 'listed': []}
   569	                elif any(status == 'unresolved' for _, status in candidates):
   570	                    entry = {'resolution': 'unresolved', 'detail': 'matching: the third readers split', 'judged': None, 'listed': []}
   571	                else:
   572	                    entry = {'resolution': NOT_OPENED, 'judged': None, 'listed': []}
   573	                entry['candidates'] = described
   574	                out[draw][question] = entry
   575	        return out
   576	
   577	    # eligibility
   578	    def controls(self, matched):
   579	        """[(draw, question, view)] of every graded question's judged view, in a seeded order: control n is the n-th."""
   580	        found = [(draw, question, entry['judged']) for draw in sorted(matched, key=self.labels.get) for question, entry in matched[draw].items()
   581	                 if entry['resolution'] == 'matched' and graded(self.frozen, question)]
   582	        random.Random(SEED).shuffle(found)
   583	        return found
   584	
   585	    def packets(self, controls):
   586	        items = [control_item(n, self.frozen, question, view) for n, (_, question, view) in enumerate(controls, 1)]
   587	        return [items[start:start + CONTROLS_A_PACKET] for start in range(0, len(items), CONTROLS_A_PACKET)]
   588	
   589	    def eligibility_jobs(self, controls):
   590	        jobs = []
   591	        for packet in self.packets(controls):
   592	            prompt = ELIGIBILITY_BRIEF.format(count=len(packet), packet=json.dumps(packet, indent=1, ensure_ascii=False))
   593	            jobs += [(session_name('eligibility', family, prompt), family, prompt, eligibility_problem([item['control'] for item in packet]))
   594	                     for family in census_readers.FAMILIES]
   595	        return jobs
   596	
   597	    def first_eligibility(self, controls):
   598	        """{control: {family: row or None}}."""
   599	        rows = {}
   600	        for packet in self.packets(controls):
   601	            prompt = ELIGIBILITY_BRIEF.format(count=len(packet), packet=json.dumps(packet, indent=1, ensure_ascii=False))
   602	            for family in census_readers.FAMILIES:
   603	                answer = self.answer('eligibility', family, prompt)
   604	                by_control = {r['control']: r for r in json_lines(answer)} if answer is not None else {}
   605	                for item in packet:
   606	                    rows.setdefault(item['control'], {})[family] = by_control.get(item['control'])
   607	        return rows
   608	
   609	    def eligibility_points(self, controls, rows):
   610	        return [(control, field) for control in sorted(rows) for field in FIELDS
   611	                if all(rows[control].values()) and rows[control]['codex'][field] != rows[control]['claude'][field]]
   612	
   613	    def eligibility_third_prompt(self, controls, points):
   614	        items = {item['control']: item for packet in self.packets(controls) for item in packet}
   615	        packet = [dict(items[control], points_to_rule=[f for c, f in points if c == control]) for control in sorted({c for c, _ in points})]
   616	        return ELIGIBILITY_THIRD_BRIEF.format(count=len(points), packet=json.dumps(packet, indent=1, ensure_ascii=False))
   617	
   618	    def eligibility_third_jobs(self, controls):
   619	        points = self.eligibility_points(controls, self.first_eligibility(controls))
   620	        if not points:
   621	            return []
   622	        prompt = self.eligibility_third_prompt(controls, points)
   623	        return [(session_name('eligibility-third', family, prompt), family, prompt, eligibility_third_problem(points))
   624	                for family in census_readers.FAMILIES]
   625	
   626	    def decided_eligibility(self, controls):
   627	        """{control: {'same_question', 'same_due'}}, each 'yes', 'no', 'unresolved' or 'not measured'."""
   628	        rows = self.first_eligibility(controls)
   629	        points = self.eligibility_points(controls, rows)
   630	        rulings = {}
   631	        if points:
   632	            prompt = self.eligibility_third_prompt(controls, points)
   633	            for family in census_readers.FAMILIES:
   634	                answer = self.answer('eligibility-third', family, prompt)
   635	                found = {(r['control'], r['field']): r['ruling'] for r in json_lines(answer)} if answer is not None else {}
   636	                for point in points:
   637	                    rulings.setdefault(point, []).append(found.get(point))
   638	        decided = {}
   639	        for control, by in rows.items():
   640	            decided[control] = {}
   641	            for field in FIELDS:
   642	                if not all(by.values()):
   643	                    decided[control][field] = 'not measured'
   644	                elif by['codex'][field] == by['claude'][field]:
   645	                    decided[control][field] = by['codex'][field]
   646	                else:
   647	                    decided[control][field] = ruling(rulings[(control, field)])
   648	        return decided
   649	
   650	    # step 6
   651	    def answer_vs_reader_b(self, draw, question, view):
   652	        """(vii)–(ix) for the judged view, whatever its eligibility: 'no judgement', 'no comparison', 'agree' or 'disagree'."""
   653	        system = self.draws[draw]['system']
   654	        state = view['state']
   655	        record = {'last_judgement': None if state is None else {'rung': state['position'], 'day': state['judgement_day']},
   656	                  'gold_open': False, 'rungs': view['rungs'], 'gold_answer': self.frozen['gold'][question]['implied_outcome'],
   657	                  'ruler': {'unit': self.frozen['questions'][question]['unit']}}
   658	        if state is None:
   659	            stage_b = 'no judgement'
   660	        else:
   661	            agreed = control_theses.agrees(record)
   662	            stage_b = 'no comparison' if agreed is None else ('agree' if agreed else 'disagree')
   663	        if system == 'new':
   664	            return stage_b
   665	        scorer = prod_records.outcome(self.draws[draw]['views'], question, view['view_id'], DAY, self.frozen['gold'], self.frozen['questions'])['outcome']
   666	        if scorer != stage_b:
   667	            raise SystemExit(f'refused: {draw} {view["view_id"]} {question}: prod_records reads {scorer}, the state as of {DAY} reads {stage_b}')
   668	        return scorer
   669	
   670	    def result(self):
   671	        self.used = {}
   672	        matched = self.matched()
   673	        controls = self.controls(matched)
   674	        decided = self.decided_eligibility(controls)
   675	        control_of = {(draw, question): n for n, (draw, question, _) in enumerate(controls, 1)}
   676	        outcomes = {}
   677	        for question in self.ruler_ids:
   678	            outcomes[question] = {}
   679	            for draw in self.draws:
   680	                entry = matched[draw][question]
   681	                record = {'candidates': entry['candidates']}
   682	                if not graded(self.frozen, question):
   683	                    gold = self.frozen['gold'][question]
   684	                    record.update(outcome='not graded', detail='reader B opens no view' if gold.get('no_view') else 'reader B gives no answer')
   685	                elif entry['resolution'] != 'matched':
   686	                    record.update(outcome=entry['resolution'], detail=entry.get('detail', ''))
   687	                else:
   688	                    view = entry['judged']
   689	                    fields = decided[control_of[(draw, question)]]
   690	                    literal = view['due_day'] == self.frozen['questions'][question]['due_day']
   691	                    answer = self.answer_vs_reader_b(draw, question, view)
   692	                    record.update(judged_view=view['view_id'], listed_views=entry['listed'], due_day=view['due_day'], state=view['state'],
   693	                                  eligibility=dict(fields, literal_due_same=literal), answer_vs_reader_b=answer)
   694	                    if self.draws[draw]['system'] == 'new':
   695	                        record.update(thesis=view['thesis'], period=view['period'], unit=view['unit'])
   696	                    values = [fields[f] for f in FIELDS]
   697	                    noes = [f.split('_')[1] for f in FIELDS if fields[f] == 'no']
   698	                    if 'not measured' in values:
   699	                        record.update(outcome='not measured', detail='an eligibility session is missing')
   700	                    elif 'unresolved' in values:
   701	                        record.update(outcome='unresolved', detail='eligibility: the third readers split',
   702	                                      decisive_reading=f"opened, not eligible ({' '.join(noes)})" if noes else 'unresolved')
   703	                    elif noes:
   704	                        record.update(outcome='opened, not eligible', detail=' '.join(noes))
   705	                    else:
   706	                        record.update(outcome=answer, detail='')
   707	                    literal_eligible = fields['same_question'] if fields['same_question'] != 'yes' else ('yes' if literal else 'no')
   708	                    record['literal_reading'] = answer if literal_eligible == 'yes' else f'eligible: {literal_eligible}'
   709	                outcomes[question][draw] = record
   710	        subset = self.frozen['graded_subset']
   711	        agreements = {}
   712	        for draw, store in self.draws.items():
   713	            agreeing = [q for q in subset if outcomes[q][draw]['outcome'] == 'agree']
   714	            literal = [q for q in subset if outcomes[q][draw].get('literal_reading') == 'agree']
   715	            agreements[draw] = {'system': store['system'], 'agree': len(agreeing), 'of': len(subset), 'questions': agreeing,
   716	                                'literal_reading_agree': len(literal), 'literal_reading_questions': literal}
   717	        missing = sorted(name for name, answer in self.used.items() if answer is None)
   718	        return {'reading': f"D431's frozen-reference reading at {DAY} (DESIGN-1.6.md §3; D442 steps 3 to 6); printed beside, not a gate",
   719	                'diagnostic': self.diagnostic, 'day': DAY, 'graded_subset': subset, 'sources': self.frozen['sha256'],
   720	                'draws': {draw: {k: v for k, v in store.items() if k != 'listed'} | {'views_listed': [
   721	                    {k: view.get(k) for k in ('view_id', 'created_seq', 'due_day', 'question', 'thesis', 'period', 'unit') if k in view}
   722	                    | {'state': view['state']} for view in store['listed']]} for draw, store in self.draws.items()},
   723	                'outcomes': outcomes, 'agreements': agreements, 'missing_sessions': missing}
   724	
   725	
   726	def read(reading, run=True):
   727	    """Run every phase's sessions not yet answered (when `run`), then write and print the result."""
   728	    if run:
   729	        run_sessions(reading.out, reading.match_jobs())
   730	        run_sessions(reading.out, reading.match_third_jobs(reading.match_disputes(reading.first_marks())))
   731	        controls = reading.controls(reading.matched())
   732	        run_sessions(reading.out, reading.eligibility_jobs(controls))
   733	        run_sessions(reading.out, reading.eligibility_third_jobs(controls))
   734	    result = reading.result()
   735	    (reading.out / 'd431-0714.json').write_text(json.dumps(result, indent=1, ensure_ascii=False) + '\n')
   736	    print_result(result)
   737	    return result
   738	
   739	
   740	def print_result(result):
   741	    draws = list(result['draws'])
   742	    print(result['reading'] + (' [DIAGNOSTIC]' if result['diagnostic'] else ''))
   743	    for draw in draws:
   744	        d = result['draws'][draw]
   745	        print(f"{draw} ({d['system']}): {len(d['views_listed'])} views listed at {result['day']} (last sequence {d['last_sequence']}, from {d['from']})")
   746	    for question, by_draw in result['outcomes'].items():
   747	        marker = '*' if question in result['graded_subset'] else ' '
   748	        cells = []
   749	        for draw in draws:
   750	            r = by_draw[draw]
   751	            cell = r['outcome'] + (f" ({r['detail']})" if r.get('detail') else '') + (f" {r['judged_view']}" if r.get('judged_view') else '')
   752	            cells.append(f'{draw}: {cell}')
   753	        print(f'{marker}{question}  ' + ' | '.join(cells))
   754	    for draw, a in result['agreements'].items():
   755	        print(f"{draw} ({a['system']}): agree {a['agree']} of {a['of']} graded {a['questions']}; literal reading {a['literal_reading_agree']}")
   756	    if result['missing_sessions']:
   757	        print('missing sessions (their marks are not measured):', ', '.join(result['missing_sessions']))
   758	
   759	
   760	def stores_of_run(run_root, eligibility_path, diagnostic):
   761	    """{draw: {'system', 'views'}} from each draw's run record (`mapping.store_paths`), every store checked against the eligibility
   762	    check's fingerprint. A run that is not eligible is read only as a diagnostic, of the draws that finished."""
   763	    eligibility = json.loads(Path(eligibility_path).read_text())
   764	    if not eligibility.get('eligible') and not diagnostic:
   765	        raise SystemExit(f"refused: the draws are not eligible: {eligibility.get('problems')}")
   766	    stores = {}
   767	    for draw in mapping.DRAWS:
   768	        try:
   769	            paths = mapping.store_paths(run_root, draw)
   770	        except SystemExit as refusal:
   771	            if not diagnostic:
   772	                raise
   773	            print(f'{draw} left out of the diagnostic: {refusal}')
   774	            continue
   775	        if paths is not None:
   776	            recorded = eligibility['draws'].get(draw, {}).get('stores', {}).get('views.sqlite', {}).get('sha256')
   777	            if recorded is None or eligibility_tool.sha256(paths[0]) != recorded:
   778	                raise SystemExit(f'refused: {paths[0]} is not fingerprinted by the eligibility check, or changed since')
   779	        stores[draw] = {'system': 'new' if draw.startswith('new') else 'old', 'views': paths[0] if paths else None}
   780	    return stores
   781	
   782	
   783	if __name__ == '__main__':
   784	    if len(sys.argv) < 5 or sys.argv[1] not in ('run', 'result'):
   785	        raise SystemExit(__doc__)
   786	    diagnostic = '--diagnostic' in sys.argv[5:]
   787	    key = mapping.KEY_FOLDER / ('d431-key-diagnostic.json' if diagnostic else 'd431-key.json')
   788	    reading = Reading(stores_of_run(sys.argv[2], sys.argv[3], diagnostic), sys.argv[4], key, diagnostic)
   789	    read(reading, run=sys.argv[1] == 'run')

