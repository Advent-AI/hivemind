   567	def key_entry(record):
   568	    """A record's own fields as a key reader sees them: the fields the two renderings draw on, its passages as a reader sees them."""
   569	    return {'summary': record['summary'],
   570	            'passages': [text if kind == 'Quote' else f'{text} (unverified)' for kind, text in library.labelled_passages(record)],
   571	            'original_party': record['original_party'], 'reporting_speaker': record['reporting_speaker'], 'tier': record['tier'],
   572	            'statement_date': record['statement_date'], 'period': record['evidence_period'],
   573	            'publication_date': record['publication_date'], 'publisher': record['publisher']}
   574	
   575	
   576	def grouped_text(store, group_id):
   577	    """The frozen dossier entry of one group: its original, then each later report's own text."""
   578	    return library.group_text(store, group_id, 'E1', {group_id: 'E1'}, member_text=True)
   579	
   580	
   581	def apart_text(group):
   582	    """Each record of the group as its own entry."""
   583	    return '\n\n'.join(library.record_text(record, f'E{n}') for n, record in enumerate([group['original']] + group['members'], 1))
   584	
   585	
   586	def normal(detail):
   587	    return ' '.join(detail.split()).casefold()
   588	
   589	
   590	def line3(run_root, eligibility_record, out, keys=KEY_FOLDER):
   591	    folder, key_file = fresh(Path(out) / 'line-3'), fresh_key(Path(keys) / 'step2-line3-key.json')
   592	    stored = json.loads(component_file(run_root, eligibility_record, 'step2', 'library.json').read_text())
   593	    eligible = [g for g in stored['order'] if stored['groups'][g]['members']]
   594	    if len(eligible) < LINE3_GROUPS:
   595	        return finish(out, 3, folder, {'status': 'not measured', 'reason': f'{len(eligible)} groups with a later report, fewer than {LINE3_GROUPS}',
   596	                                       'groups with a later report': len(eligible)})
   597	    sample = random.Random(SEED + 3).sample(eligible, LINE3_GROUPS)
   598	    member_of, groups = {}, []
   599	    for number, group_id in enumerate(sample, 1):
   600	        group = stored['groups'][group_id]
   601	        later = []
   602	        for member in group['members']:
   603	            member_id = f'K{len(member_of) + 1}'
   604	            member_of[member_id] = (group_id, member['id'])
   605	            later.append({'id': member_id, **key_entry(member)})
   606	        groups.append({'group': f'G{number}', 'id': group_id, 'earlier': key_entry(group['original']), 'later': later})
   607	    shown = lambda entry: {k: v for k, v in entry.items() if k != 'id'}
   608	    key_check = lambda ids: rows_check(ids, {'details': is_text_list})
   609	    jobs = []
   610	    for number, chunk in enumerate(packets(groups, KEY_PACKET), 1):
   611	        ids = [member['id'] for entry in chunk for member in entry['later']]
   612	        jobs += [{'name': f'key-{number}-{family}', 'family': family, 'ids': ids,
   613	                  'prompt': inline(KEY_PROMPT, 'Read PACKET. ', [shown(entry) for entry in chunk]), 'check': key_check(ids)} for family in FAMILIES]
   614	    answers = sessions(folder, jobs)
   615	    drafts = collections.defaultdict(dict)
   616	    for job in jobs:
   617	        for member_id in job['ids']:
   618	            if answers[job['name']] is not None:
   619	                drafts[member_id][job['family']] = answers[job['name']][member_id]['details']
   620	    final, unsettled = {}, collections.defaultdict(list)
   621	    for entry in groups:
   622	        ids = [member['id'] for member in entry['later']]
   623	        if any(len(drafts[m]) < len(FAMILIES) for m in ids):
   624	            continue
   625	        if all(len({frozenset(map(normal, drafts[m][f])) for f in FAMILIES}) == 1 for m in ids):
   626	            final.update({m: drafts[m][FAMILIES[0]] for m in ids})
   627	        else:
   628	            unsettled[drawn_family(SEED + 3, entry['id'])].append(entry)
   629	    third_check = lambda ids: rows_check(ids, {'details': is_text_list, 'dropped': is_text_list})
   630	    jobs = []
   631	    for family, family_groups in sorted(unsettled.items()):
   632	        for number, chunk in enumerate(packets(family_groups, KEY_PACKET), 1):
   633	            ids = [member['id'] for entry in chunk for member in entry['later']]
   634	            packet = [{**shown(entry), 'drafts': {m['id']: dict(zip('AB', (drafts[m['id']][f] for f in FAMILIES))) for m in entry['later']}}
   635	                      for entry in chunk]
   636	            jobs.append({'name': f'key-third-{number}-{family}', 'family': family, 'ids': ids,
   637	                         'prompt': inline(KEY_THIRD_PROMPT, 'Read PACKET. ', packet), 'check': third_check(ids)})
   638	    answers = sessions(folder, jobs)
   639	    for job in jobs:
   640	        if answers[job['name']] is not None:
   641	            final.update({m: answers[job['name']][m]['details'] for m in job['ids']})
   642	    unkeyed = [m for m in member_of if m not in final]
   643	    if unkeyed:
   644	        return finish(out, 3, folder, {'status': 'not measured', 'reason': f'{len(unkeyed)} later reports with no settled key (first {unkeyed[0]})'})
   645	    key = {'draw': DRAW, 'seed': SEED + 3, 'groups': [
   646	        {'group': entry['id'], 'details': [{'id': f'D{n}', 'member': member_of[m][1], 'text': text}
   647	                                           for n, (m, text) in enumerate(((m['id'], t) for m in entry['later'] for t in final[m['id']]), 1)]}
   648	        for entry in groups]}
   649	    key_sha = freeze(folder / 'key.json', key)
   650	    # The renderings are built only now, from the frozen key.
   651	    key = read_frozen(folder / 'key.json')
   652	    store = library.Library()
   653	    store.groups, store.order = stored['groups'], stored['order']
   654	    codes = random.Random(f'{SEED + 3}:codes').sample(range(100, 1000), 2 * LINE3_GROUPS)
   655	    code_key, jobs = {}, []
   656	    for index, entry in enumerate(key['groups']):
   657	        if not entry['details']:
   658	            continue
   659	        details = [{'id': d['id'], 'detail': d['text']} for d in entry['details']]
   660	        renderings = {'grouped': grouped_text(store, entry['group']), 'apart': apart_text(stored['groups'][entry['group']])}
   661	        for offset, (rendering, text) in enumerate(renderings.items()):
   662	            code = codes[2 * index + offset]
   663	            code_key[str(code)] = {'group': entry['group'], 'rendering': rendering}
   664	            jobs += [{'name': f'render-{code}-{family}', 'family': family, 'code': str(code), 'prompt': rendering_prompt(text, details),
   665	                      'check': rows_check([d['id'] for d in details], {'stated': lambda value: isinstance(value, bool)})} for family in FAMILIES]
   666	    write_key(key_file, code_key)
   667	    answers = sessions(folder, jobs)
   668	    stated = {}
   669	    for job in jobs:
   670	        if answers[job['name']] is not None:
   671	            stated[(code_key[job['code']]['group'], code_key[job['code']]['rendering'], job['family'])] = \
   672	                sum(1 for row in answers[job['name']].values() if row['stated'])
   673	    missing = [job['name'] for job in jobs if answers[job['name']] is None]
   674	    totals = {family: {'grouped': 0, 'apart': 0} for family in FAMILIES}
   675	    differences = {family: [] for family in FAMILIES}
   676	    for entry in key['groups']:
   677	        for family in FAMILIES:
   678	            grouped, apart = stated.get((entry['group'], 'grouped', family), 0), stated.get((entry['group'], 'apart', family), 0)
   679	            totals[family]['grouped'] += grouped
   680	            totals[family]['apart'] += apart
   681	            differences[family].append(grouped - apart)
   682	    result = {'key sha256': key_sha, 'groups': LINE3_GROUPS, 'key details': sum(len(e['details']) for e in key['groups']),
   683	              'groups with an empty key': sum(1 for e in key['groups'] if not e['details']), 'totals': totals,
   684	              'mean paired difference': {f: sum(d) / len(d) for f, d in differences.items()},
   685	              'bootstrap_95': {f: bootstrap_interval(d, f'{SEED + 3}:{f}') for f, d in differences.items()},
   686	              'groups with a later report': len(eligible)}
   687	    if missing:
   688	        result.update(status='not measured', reason=f'{len(missing)} rendering sessions missing (first {missing[0]})')
   689	    else:
   690	        result.update(status='passed' if all(t['grouped'] >= t['apart'] for t in totals.values()) else 'failed')
   691	    return finish(out, 3, folder, result)
   692	
   693	
   694	def bootstrap_interval(values, seed):
   695	    """95% percentile interval of the mean over groups, resampled with replacement."""
   696	    chooser = random.Random(seed)
   697	    means = sorted(sum(chooser.choice(values) for _ in values) / len(values) for _ in range(BOOTSTRAP))
   698	    return [means[int(0.025 * BOOTSTRAP)], means[int(0.975 * BOOTSTRAP) - 1]]
   699	
   700	
   701	# ---- report -------------------------------------------------------------------------------------------------------------------------
   702	
   703	def report(out):
   704	    """`step2-lines.json`: each line's status, and the release line D675 prints beside the verdict (a failed line ahead of one not measured)."""
   705	    lines = {}
   706	    for line in (1, 2, 3):
   707	        path = Path(out) / f'line-{line}' / 'result.json'
   708	        lines[str(line)] = json.loads(path.read_text()) if path.exists() else {'line': line, 'status': 'not measured', 'reason': 'not run'}
   709	    statuses = [result['status'] for result in lines.values()]
   710	    status = 'failed' if 'failed' in statuses else 'not measured' if 'not measured' in statuses else 'passed'

