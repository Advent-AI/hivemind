   310	            for q in sorted(a.get(matter, set()) | b.get(matter, set())):
   311	                if q in a.get(matter, set()) and q in b.get(matter, set()):
   312	                    covers = True
   313	                else:
   314	                    paths = [out / 'third' / f'{label}--{matter}--{q}--{reader}.json' for reader in FAMILIES]
   315	                    missing = [p.name for p in paths if not p.exists()]
   316	                    if missing:
   317	                        raise SystemExit(f'refused: third-reader marks missing {missing}')
   318	                    thirds = [json.loads(p.read_text())['covers'] for p in paths]
   319	                    covers = True if thirds == [True, True] else False if thirds == [False, False] else 'split'
   320	                entries.append({'question': q, 'covers': covers})
   321	            if any(e['covers'] is not False for e in entries):
   322	                mapping[draw][matter] = [e for e in entries if e['covers'] is not False]
   323	        distinct[draw] = {'ids': len(lib), 'duplicates_both': len(dup_a & dup_b), 'duplicates_split': len(dup_a ^ dup_b)}
   324	    text = json.dumps({'mapping': mapping, 'distinct': distinct,
   325	                       'eligibility_sha256': hashlib.sha256((out / 'eligibility.json').read_bytes()).hexdigest()},
   326	                      indent=1, ensure_ascii=False) + '\n'
   327	    (out / 'mapping.json').write_text(text)
   328	    print('mapping.json written', hashlib.sha256(text.encode()).hexdigest()[:16])
