   126	def deck(mapping_out, folder):
   127	    if KEY.exists():
   128	        raise SystemExit(f'refused: {KEY} exists; a deck never overwrites a key')
   129	    folder = Path(folder)
   130	    folder.mkdir(parents=True, exist_ok=False)
   131	    libs = libraries(mapping_out)
   132	    mapping = json.loads((Path(mapping_out) / 'mapping.json').read_text())['mapping']
   133	    cards, rng = [], random.Random(SEED)
   134	    for draw in sorted(libs):
   135	        lib = libs[draw]
   136	        by_id = {e['question_id']: e for e in lib}
   137	        covering = {}
   138	        for qs in mapping.get(draw, {}).values():
   139	            for q in qs:
   140	                covering[q['question']] = True if (q['covers'] is True or covering.get(q['question']) is True) else 'split'
   141	        guard = guardrail_sample(lib)
   142	        for qid in sorted(set(covering) | guard):
   143	            e = by_id[qid]
   144	            cards.append({'draw': draw, 'question': qid, 'role': 'product', 'guardrail': qid in guard, 'covering': covering.get(qid, False),
   145	                          'opened': e.get('opened'),
   146	                          'type': e.get('type'), 'answered': e['answer'] is not None, 'text': build_cards.card_text(e, lib)})
   147	    controls, confirmations = [], []
   148	    for system in ('new', 'old'):
   149	        pool = []
   150	        for c in cards:
   151	            if c['draw'].startswith(system) and c['answered']:
   152	                planted = plant(c['text'], {e['question_id']: e for e in libs[c['draw']]}[c['question']])
   153	                if planted is not None:
   154	                    pool.append(dict(c, role='plant', text=planted))
   155	        random.Random(SEED + 1).shuffle(pool)
   156	        admitted = []
   157	        for c in pool:
   158	            if len(admitted) == 3:
   159	                break
   160	            ok, mark = confirmed_by_reader(c['text'], supported=False)
   161	            confirmations.append({'role': 'plant', 'draw': c['draw'], 'question': c['question'], 'mark': mark, 'admitted': bool(ok)})
   162	            if ok:
   163	                admitted.append(c)
   164	        if len(admitted) < 3:
   165	            record_confirmations(confirmations)
   166	            raise SystemExit(f'{system}: only {len(admitted)} plants confirmed not supported of {len(pool)} candidates')
   167	        controls += admitted
   168	    candidates = random.Random(SEED + 2).sample([c for c in cards if c['answered']], min(12, sum(c['answered'] for c in cards)))
   169	    confirmed = []
   170	    for c in candidates:
   171	        if len(confirmed) == 4:
   172	            break
   173	        ok, mark = confirmed_by_reader(c['text'], supported=True)
   174	        confirmations.append({'role': 'supported control', 'draw': c['draw'], 'question': c['question'], 'mark': mark, 'admitted': bool(ok)})
   175	        if ok:
   176	            confirmed.append(dict(c, role='supported control'))
   177	
   178	    record_confirmations(confirmations)
   179	    if len(confirmed) < 4:
   180	        raise SystemExit(f'only {len(confirmed)} supported controls confirmed of {len(candidates)} candidates')
   181	    controls += confirmed
   182	    for c in random.Random(SEED + 3).sample(cards, 3):
   183	        controls.append(dict(c, role='repeat'))
   184	    full = cards + controls
   185	    random.Random(SEED).shuffle(full)
   186	    key = {}
   187	    for n, c in enumerate(full, 1):
   188	        cid = f'C{n:03d}'
   189	        key[cid] = {k: c[k] for k in ('draw', 'question', 'role', 'guardrail', 'covering', 'type', 'answered', 'opened')}
   190	        (folder / f'{cid}.txt').write_text(c['text'])
   191	    KEY.parent.mkdir(parents=True, exist_ok=True)
   192	    KEY.write_text(json.dumps(key, indent=1) + '\n')
   193	    print(f'{len(full)} cards: {len(cards)} product, {len(controls)} controls; key in {KEY}')
