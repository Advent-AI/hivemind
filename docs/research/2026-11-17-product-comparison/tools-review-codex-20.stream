import contextlib, fnmatch, fnmatch as patterns, hashlib, io, json, posixpath, subprocess, types
import score_comparison as score
import rebuild, mapping, mark_cards as writer, eligibility, census_readers, build_cards
parent = types.ModuleType(\"previous_score_comparison\")
parent.__file__ = score.__file__
p = \"docs/research/2026-11-17-product-comparison/stage0/score_comparison.py\"
exec(compile(subprocess.check_output([\"git\",\"--no-pager\",\"show\",\"1aafb15e"'^:"+p],text=True),p,"exec"),parent.__dict__)
class Mem:
    files={}
    dirs=set()
    writes=[]
    def __init__(self,path): self.path=posixpath.normpath(str(path))
    def __truediv__(self,child): return Mem(self.path+"/"+child)
    def __str__(self): return self.path
    def __lt__(self,other): return self.path<other.path
    @property
    def name(self): return posixpath.basename(self.path)
    @property
    def parent(self): return Mem(posixpath.dirname(self.path))
    def resolve(self): return self
    def exists(self): return self.path in self.files or self.path in self.dirs
    def is_dir(self): return self.path in self.dirs
    def mkdir(self,parents=False,exist_ok=False):
        if self.is_dir() and not exist_ok: raise FileExistsError(self.path)
        self.dirs.add(self.path); self.writes.append(self.path)
    def read_bytes(self): return self.files[self.path]
    def read_text(self): return self.read_bytes().decode()
    def write_text(self,text):
        self.files[self.path]=text.encode(); self.writes.append(self.path)
    def glob(self,pattern):
        return [Mem(p) for p in self.files if posixpath.dirname(p)==self.path and fnmatch.fnmatch(posixpath.basename(p),pattern)]
def put(p,v): Mem(p).write_text(json.dumps(v))
def get(p): return json.loads(Mem(p).read_text())
def no_calls(*args): raise AssertionError("reader called")
def copy2(src,dst): dst.write_text(src.read_text())
def copytree(src,dst):
    dst.mkdir()
    for p in list(Mem.files):
        if p.startswith(str(src)+"/"): (dst / p[len(str(src))+1:]).write_text(Mem(p).read_text())
@contextlib.contextmanager
def scratch():
    Mem("/scratch").mkdir()
    try: yield "/scratch"
    finally:
        for p in list(Mem.files):
            if p.startswith("/scratch/"): del Mem.files[p]
        Mem.dirs={p for p in Mem.dirs if not (p=="/scratch" or p.startswith("/scratch/"))}
@contextlib.contextmanager
def mem_open(path,mode):
    assert mode=="a"
    buffer=io.StringIO()
    try: yield buffer
    finally:
        f=Mem(path)
        f.write_text((f.read_text() if f.exists() else "")+buffer.getvalue())
for m in (score,parent,mapping,writer,eligibility,rebuild): m.Path=Mem
score.MATTERS=parent.MATTERS=mapping.MATTERS=Mem("/original/matters.json")
writer.open=mem_open
rebuild.tempfile=types.SimpleNamespace(TemporaryDirectory=scratch)
rebuild.shutil=types.SimpleNamespace(copy2=copy2,copytree=copytree)
mapping.KEY_FOLDER=Mem("/original/keys")
writer.KEY=mapping.KEY_FOLDER/"deck-key.json"
census_readers.run=no_calls
def make(n=20,shorts=("new-1",),new=5,old=1,invalid=False):
    Mem.files.clear(); Mem.dirs.clear(); Mem.writes.clear()
    matters=[{"matter":f"M{i:02d}","company_figure":False} for i in range(1,n+1)]
    put(score.MATTERS,{"matters":matters})
    writer.matter_first_days=lambda:{m["matter"]:"2026-09-07" for m in matters}
    lib={}
    for d in mapping.DRAWS:
        count=29 if d in shorts else 30
        lib[d]=[dict(question_id=f"v{i}",question=f"Question {i}",opened="2026-09-09",due="2026-09-20",
                     type="figure" if i<=15 else "yes/no",answer="Yes",answer_index=0,possible_answers=["Yes","No"],
                     reasons="Evidence",material=[]) for i in range(1,count+1)]
    mapping.store_paths=lambda root,d:(Mem(f"/primary/{d}/views.sqlite"),Mem(f"/primary/{d}/archive.sqlite"))
    build_cards.library=lambda views,archive,items:lib[views.parent.name]
    eligibility.sha256=lambda file:hashlib.sha256(str(file).encode()).hexdigest()
    eligible={"eligible":True,"problems":[],"draws":{d:{"stores":{p.name:{"sha256":eligibility.sha256(p)} for p in mapping.store_paths("/primary",d)}} for d in mapping.DRAWS}}
    eligibility.check=lambda root:eligible
    writer.confirmed_by_reader=lambda text,supported:(True,{"supported":supported,"why":"fixture"})
    eligibility.write(eligible,Mem("/original/eligibility.json"))
    with contextlib.redirect_stdout(io.StringIO()):
        mapping.export("/primary","/original/map","/original/eligibility.json")
        key=get(mapping.KEY_FOLDER/"mapping-key.json")
        for d,label in key.items():
            a,b=(1,new) if d.startswith("new") else (new+1,new+old)
            rows=[{"matter":f"M{i:02d}","status":"opened","ids":[f"Q{i}"]} for i in range(a,b+1)]
            for family in ("codex","claude"):
                Mem(f"/original/map/map-{label}-{family}.txt").write_text("'"\\n\".join(map(json.dumps,rows)))
        mapping.result(\"/original/map\")
        writer.deck(\"/original/map\",\"/original/deck\")
        key=get(writer.KEY)
        for cid,k in key.items():
            answer=\"unsupported\" if k[\"role\"]==\"plant\" and not invalid else \"supported\"
            for f in (\"codex\",\"claude\"):
                put(f\"/original/deck/round-0/{cid}-{f}.json\",{\"worth\":\"worth\",\"answer\":answer})
        for n in range(3): Mem(f\"/original/deck/round-{n}.done\").write_text(\"done\")
        writer.readings(\"/original/map\",\"/original/deck\")
    writer.confirmed_by_reader=no_calls
def read_score():
    with contextlib.redirect_stdout(io.StringIO()) as out:
        result=score.score(\"/primary\",\"/original/map\",\"/original/deck\")
    return result,out.getvalue()
make()
attrs=(mapping.KEY_FOLDER,writer.KEY,writer.confirmed_by_reader,census_readers.run)
Mem.writes.clear()
original,noise=read_score()
assert original[\"verdict\"]==\"too small\"
assert all(p.startswith(\"/scratch\") for p in Mem.writes)
assert attrs==(mapping.KEY_FOLDER,writer.KEY,writer.confirmed_by_reader,census_readers.run)
print(\"Normally\",original[\"verdict\"], \"explicit writes confined and patched attributes restored\")
print(\"Unedited scorer stdout before returning:\",repr(noise))
good_diff=rebuild.differences
def bump():
    f=\"/original/map/mapping.json\"
    mapped=get(f)
    mapped[\"distinct\"][\"new-1\"][\"ids\"]=30
    put(f,mapped)
    writer.readings(\"/original/map\",\"/original/deck\")
def after_comparison(*args):
    differ=good_diff(*args)
    assert differ==[]
    bump()
    return differ
rebuild.differences=after_comparison
raced,_=read_score()
print(\"Derived replacement after comparison\",raced[\"verdict\"])
rebuild.differences=good_diff
try: read_score()
except SystemExit as e: print(\"Same edit before comparison:\",e)
make(shorts=(\"new-1\",\"old-3\"))
before,_=read_score()
f=\"/original/map/mapping.json\"
mapped=get(f)
mapped[\"distinct\"]=dict(reversed(list(mapped[\"distinct\"].items())))
put(f,mapped)
with contextlib.redirect_stdout(io.StringIO()): writer.readings(\"/original/map\",\"/original/deck\")
after,_=read_score()
print(\"Stable reordered mapping reasons\",before[\"why\"],\"->\",after[\"why\"])
for n,shorts,a,b,invalid in ((32,(),10,2,False),(32,(),2,10,False),(32,(),5,4,False),(19,(),5,1,False),(32,(),5,1,True)):
    make(n,shorts,a,b,invalid)
    new,_=read_score()
