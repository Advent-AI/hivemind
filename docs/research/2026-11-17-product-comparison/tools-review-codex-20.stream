    38	def sha256(path):
    39	    digest = hashlib.sha256()
    40	    with open(path, 'rb') as handle:
    41	        for block in iter(lambda: handle.read(1 << 20), b''):
    42	            digest.update(block)
    43	    return digest.hexdigest()
    44	
    45	
    46	def last_call(draw_folder):
    47	    """The latest model call stored in any database under the draw's folder, and how many databases hold calls."""
    64	    if draw.startswith('new'):
    65	        options.update(limits=str(DATA / 'comparison-limits.json'), ladder_variant='astra-frozen', judge_end_day='2026-09-20')
    66	    return {'kind': 'clean' if draw.startswith('new') else 'prod', 'label': draw, 'ledger': str(Path(run_root) / 'ledgers' / f'{draw}.json'),
    67	            'options': options}
