    90	def section_inputs(run_root, draw, record):
    91	    """The files the §1.6 tools read from a new draw (DESIGN-1.6.md §0), each in the folder its run record names (a redo's folder after a
    92	    redo), by path relative to the draw."""
    93	    out = []
    94	    if not draw.startswith('new'):
    95	        return out
    96	    for component, names in SECTION_INPUTS.items():
    97	        entry = record['components'].get(component, {})
    98	        if entry.get('state') == 'completed':
    99	            out += [f"{entry['folder']}/{name}" for name in names if (Path(run_root) / draw / entry['folder'] / name).exists()]
   100	    return out
