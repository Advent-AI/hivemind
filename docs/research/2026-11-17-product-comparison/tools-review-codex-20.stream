    30	def local(stamp):
    31	    """A naive local time from either stored form: '2026-11-17T22:05:13-0800' (launcher) or '2026-11-17T22:06:16' (archives)."""
    32	    try:
    33	        return datetime.datetime.strptime(stamp, '%Y-%m-%dT%H:%M:%S%z').astimezone().replace(tzinfo=None)
    34	    except ValueError:
    35	        return datetime.datetime.strptime(stamp[:19], '%Y-%m-%dT%H:%M:%S')
