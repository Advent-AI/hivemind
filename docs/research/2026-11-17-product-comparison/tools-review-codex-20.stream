   300	def build_readings(mapping_out, folder):
   301	    """The readings the scorer takes, built from the mapping output and the marks folder (the one writer of their shape;
   302	    `score_comparison.score` builds them again and scores what is built). Every mapped draw has a card map, empty when it opened no question."""
   303	    folder = Path(folder)
   304	    for n in (0, 1, 2):
   305	        if not (folder / f'round-{n}.done').exists():
   306	            raise SystemExit(f'refused: round {n} is not complete')
   307	    key = json.loads(KEY.read_text())
   308	    matters = [{'matter': m['matter'], 'company_figure': m['company_figure']} for m in json.loads(mapping_tool.MATTERS.read_text())['matters']]
   309	    mapped_text = (Path(mapping_out) / 'mapping.json').read_bytes()
   310	    mapped = json.loads(mapped_text)
   311	    cards = {draw: {} for draw in mapped['mapping']}
   312	    plants, supported, repeats = [], [], []
   313	    by_question = {}
   314	    for cid, k in sorted(key.items()):
   315	        f = final(folder, cid)
   316	        answer = f['answer'] if k['answered'] else 'no answer'
   317	        if k['role'] == 'product':
   318	            cards.setdefault(k['draw'], {})[k['question']] = {'worth': f['worth'], 'answer': answer, 'type': k['type'], 'guardrail': k['guardrail'],
   319	                                                              'covering': k['covering'], 'opened': k.get('opened')}
   320	            by_question[(k['draw'], k['question'])] = (f['worth'], answer)
   321	        elif k['role'] == 'plant':
   322	            plants.append(answer)
   323	        elif k['role'] == 'supported control':
   324	            supported.append(answer)
   325	    for cid, k in sorted(key.items()):
   326	        if k['role'] == 'repeat':
   327	            f = final(folder, cid)
   328	            answer = f['answer'] if k['answered'] else 'no answer'
   329	            repeats.append((f['worth'], answer) == by_question[(k['draw'], k['question'])])
   330	    out = {'matters': matters, 'matter_first_day': matter_first_days(), 'mapping': mapped['mapping'], 'distinct': mapped['distinct'], 'cards': cards,
   331	           'controls': {'plants': plants, 'supported': supported, 'repeats_same': repeats},
   332	           'inputs': {'matters_sha256': hashlib.sha256(mapping_tool.MATTERS.read_bytes()).hexdigest(),
   333	                      'mapping_path': str((Path(mapping_out) / 'mapping.json').resolve()), 'mapping_sha256': hashlib.sha256(mapped_text).hexdigest(),
   334	                      'eligibility_path': str((Path(mapping_out) / 'eligibility.json').resolve()), 'eligibility_sha256': mapped['eligibility_sha256'],
   335	                      'deck_key_path': str(KEY), 'deck_key_sha256': hashlib.sha256(KEY.read_bytes()).hexdigest()}}
   336	    return out
   337	
