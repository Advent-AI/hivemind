   103	def verified(eligibility, run_root, draw, relative):
   104	    """A file a §1.6 tool reads, refused unless the eligibility output fingerprinted it and it is unchanged."""
   105	    digest = eligibility['draws'][draw].get('inputs', {}).get(relative)
   106	    path = Path(run_root) / draw / relative
   107	    if digest is None or sha256(path) != digest:
   108	        raise SystemExit(f'refused: {draw}/{relative} is not fingerprinted by the eligibility check, or changed since')
   109	    return path
   110	
   111	
   112	def check(run_root):
   120	        try:
   121	            paths = mapping.store_paths(run_root, draw)                # refuses an incomplete draw
   122	        except SystemExit as refusal:                                 # recorded; the finished draws are still fingerprinted (diagnostic)
   123	            problems.append(str(refusal))
   124	            paths = None
   125	        latest, databases = last_call(run_root / draw)
   126	        attempt, attempts, unreconciled = last_attempt(run_root / 'ledgers' / f'{draw}.json')
   127	        if unreconciled:
   128	            problems.append(f'{draw}: the timing cannot be established: {unreconciled}')
   129	        if attempt and (latest is None or attempt > latest):
   130	            latest = attempt
   131	        draws[draw] = {'launch': min(starts).isoformat() if starts else None, 'last call': latest.isoformat() if latest else None,
   132	                       'databases with calls': databases, 'ledger attempts': attempts,
   133	                       'stores': {Path(p).name: {'path': str(p), 'sha256': sha256(p)} for p in paths} if paths else {},
   134	                       'inputs': {rel: sha256(run_root / draw / rel) for rel in section_inputs(run_root, draw, record)}}
   135	        if not starts:
   136	            problems.append(f'{draw}: no launch recorded')
   137	    launches = [datetime.datetime.fromisoformat(d['launch']) for d in draws.values() if d['launch']]
   138	    if launches and max(launches) - min(launches) > LAUNCH_WINDOW:
   139	        problems.append(f'launches span {max(launches) - min(launches)}, more than one hour')
   140	    first = min(launches) if launches else None
   141	    for draw, d in draws.items():
   142	        if first and d['last call'] and datetime.datetime.fromisoformat(d['last call']) > first + SEND_WINDOW:
   143	            problems.append(f"{draw}: a call at {d['last call']}, more than 72 h after the first launch {first.isoformat()}")
   144	    return {'eligible': not problems, 'problems': problems, 'first launch': first.isoformat() if first else None, 'draws': draws}
   145	
