   119	def record_confirmations(confirmations):
   120	    """Every control confirmation of this deck attempt, appended beside the key (an earlier attempt's are kept)."""
   121	    KEY.parent.mkdir(parents=True, exist_ok=True)
   122	    with open(KEY.parent / 'control-confirmations.jsonl', 'a') as handle:
   123	        handle.write(json.dumps({'attempt': confirmations}, ensure_ascii=False) + '\n')
