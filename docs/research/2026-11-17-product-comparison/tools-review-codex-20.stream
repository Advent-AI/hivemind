    17	RUNG = re.compile(r'rung (\d+) ([^:]*): ')
    18	# D673 form check: the three suffixes the answer step appends to a rung condition (ladder_step.py, `middle_text_suffix`), a closed set
    19	ANNOTATION = re.compile(r'\s*\((?:no reference figure when the question opened|the (?:amount last reported|reference) when the question opened: ".*")\)$', re.S)
    20	ITEM = re.compile(r'^- e\d+ \[([^;\]]*); (.*?); original source (.*?); from (\S+) (\S+)\] ', re.S)   # a speaker may hold ';'
    21	NOTE = re.compile(r'\n    (?:It replaces |Opinion, not verified: )')
