    88	def guardrail_sample(lib):
    89	    """The neutral ids of the guardrail sample: the system's own ids sorted as strings, random.Random(20261117).sample(ids, 35), or all of
    90	    them when fewer (verdict-rule.json `guardrails.sample`)."""
    91	    neutral = {e['source_id']: e['question_id'] for e in lib}
    92	    ids = sorted(neutral)
    93	    return {neutral[i] for i in (ids if len(ids) <= 35 else random.Random(SEED).sample(ids, 35))}
