   152	if __name__ == '__main__':
   153	    result = check(sys.argv[1])
   154	    write(result, sys.argv[2])
   155	    print('ELIGIBLE' if result['eligible'] else 'NOT ELIGIBLE: ' + '; '.join(result['problems']))
