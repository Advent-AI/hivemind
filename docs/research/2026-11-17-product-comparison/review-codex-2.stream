   199	def differing(cards, rows):
   200	    out = {}
   201	    for number, pair in rows.items():
   202	        if not all(pair.get(f) for f in FAMILIES):
   203	            continue
   204	        a, b = (fields(pair[f], cards[number]) for f in FAMILIES)
   205	        diff = sorted(k for k in a if a[k] != b.get(k))
   206	        if diff:
   207	            out[number] = diff
   208	    return out
