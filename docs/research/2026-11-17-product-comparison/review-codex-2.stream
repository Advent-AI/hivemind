    60	def build():
    61	    page = DECK.read_text()
    62	    cards = {}
    63	    for match in re.finditer(r'<section class="card" id="card-(\d+)" data-card="\d+">(.*?)</section>', page, re.S):
    64	        number, body = match.group(1), match.group(2)
    65	        body = re.sub(r'<div class="marks">.*?</div></div>', '', body, flags=re.S)          # the mark buttons are not content
    66	        body = re.sub(r'<div class="choice">.*?</div>', '', body, flags=re.S)
    67	        linked = sorted(set(re.findall(r'href="#(src-\d+)"', match.group(2))), key=lambda s: int(s.split('-')[1]))
    68	        articles = []
    69	        for anchor in linked:
    70	            found = re.search(rf'<section class="article" id="{anchor}">(.*?)</section>', page, re.S)
    71	            articles.append({'anchor': anchor, 'text': to_text(found.group(1)) if found else '(not found)'})
    72	        facts = len(re.findall(r'name="c\d+-fact(\d+)-bears"', match.group(2))) // 3
    73	        cards[number] = {'card': int(number), 'kind': 'matter' if 'The library holds no question on it' in body else 'question',
    74	                         'facts': facts, 'text': to_text(body), 'articles': articles}
    75	    assert len(cards) == 19, len(cards)
    76	    (HERE / 'cards.json').write_text(json.dumps(cards, indent=1, ensure_ascii=False) + '\n')
    77	    print({n: (c['kind'], c['facts'], len(c['text']), len(c['articles'])) for n, c in cards.items()})
