     1	"""Lean step 2, the tally ($0): joins the two reader families' answers for readings A2 and B to the keys and prints every count the frozen
     2	decision rule (LEAN-LOG §2) reads, per system. It judges nothing itself: coverage, worth and support are the readers' verdicts.
     3	
     4	Reading B's supported controls are fixed by rule before any B answer is joined: the first four candidates, by candidate number, that the
     5	separate reader marked SUPPORTED (`control-confirmation.jsonl`); the script refuses when fewer than four were confirmed.
     6	
     7	  python3 tally_week.py <key folder outside the repository>
     8	"""
     9	import json
    10	import sys
    11	from pathlib import Path
    12	
    13	HERE = Path(__file__).resolve().parent
    14	FAMILIES = ('codex', 'claude')
    15	SYSTEM_NAME = {'c1': 'clean', 'p1': 'production'}
    16	
    17	
    18	def lines(name):
    19	    return [json.loads(line) for line in (HERE / name).read_text().splitlines() if line.strip().startswith('{')]
    20	
    21	
    22	def reading_a(key):
    23	    system_of = {label: system for system, label in key['labels'].items()}
    24	    own_id = {row['system_id']: row['own_id'] for system in SYSTEM_NAME for row in key[system]}
    25	    matters = json.loads((HERE / 'matters-A2.json').read_text())
    26	    by_both = [m['matter'] for m in matters if m['listed_by'].startswith('both')]
    27	    answers = {family: lines(f'{family}-A2.jsonl') for family in FAMILIES}
    28	    cell, verdict = {}, {}
    29	    for family, rows in answers.items():
    30	        for row in rows:
    31	            if row.get('part') == 1:
    32	                cell[(family, row['matter'], system_of[row['system']])] = row
    33	            elif row.get('part') == 2:
    34	                verdict[(family, row['id'])] = row
    35	    expected = len(matters) * 2
    36	    for family in FAMILIES:
    37	        judged = sum(1 for (reader, _, _) in cell if reader == family)
    38	        if judged != expected:
    39	            raise SystemExit(f'{family} judged {judged} of {expected} matter-and-system cells: refused')
    40	
    41	    def covered(row):
    42	        return row['status'] == 'opened' or (row['status'] == 'narrower' and row.get('main_outcome') is True)
    43	
    44	    print('READING A, part 1: each matter against each system (status; ids in the system\'s own numbering)')
    45	    for matter in matters:
    46	        for system in SYSTEM_NAME:
    47	            parts = []
    48	            for family in FAMILIES:
    49	                row = cell[(family, matter['matter'], system)]
    50	                ids = ','.join(own_id.get(i, i) for i in row.get('ids') or [])
    51	                extra = '' if row['status'] in ('opened', 'missed') else f" main_outcome={row.get('main_outcome')}"
    52	                parts.append(f"{family}: {row['status']}{extra} [{ids}]")
    53	            print(f"  {matter['matter']} ({matter['listed_by'][:4]}) {SYSTEM_NAME[system]:10} | " + ' | '.join(parts))
    54	        print(f"      {matter['name']}")
    55	    print('  covered = opened, or narrower with the matter\'s main outcome (the frozen wording):')
    56	    for scope_name, scope in (('matters both families listed', by_both), ('all matters', [m['matter'] for m in matters])):
    57	        for system in SYSTEM_NAME:
    58	            per_family = {family: [m for m in scope if covered(cell[(family, m, system)])] for family in FAMILIES}
    59	            agreed = [m for m in scope if all(covered(cell[(family, m, system)]) for family in FAMILIES)]
    60	            print(f"    {scope_name} ({len(scope)}), {SYSTEM_NAME[system]:10}: " +
    61	                  ', '.join(f'{family} {len(found)}' for family, found in per_family.items()) + f'; both families {len(agreed)} {agreed}')
    62	    agree = sum(cell[('codex', m['matter'], s)]['status'] == cell[('claude', m['matter'], s)]['status'] for m in matters for s in SYSTEM_NAME)
    63	    print(f'  the families give the same status on {agree} of {expected} cells')
    64	
    65	    print('READING A, part 2: every opened question (worth / trivia / duplicate)')
    66	    for system in SYSTEM_NAME:
    67	        questions = key[system]
    68	        for family in FAMILIES:
    69	            counts = {}
    70	            for question in questions:
    71	                row = verdict.get((family, question['system_id']))
    72	                if row is None:
    73	                    raise SystemExit(f"{family} gave no verdict on {question['system_id']}: refused")
    74	                counts[row['verdict']] = counts.get(row['verdict'], 0) + 1
    75	            print(f"  {SYSTEM_NAME[system]:10} ({len(questions)} questions), {family}: {counts}")
    76	        for question in questions:
    77	            verdicts = [verdict[(family, question['system_id'])] for family in FAMILIES]
    78	            if any(v['verdict'] != 'worth' for v in verdicts):
    79	                shown = ' | '.join(f"{family}: {v['verdict']}" + (f" of {own_id.get(v.get('duplicate_of'), v.get('duplicate_of'))}" if v.get('duplicate_of') else '')
    80	                                   + f" ({v.get('why')})" for family, v in zip(FAMILIES, verdicts))
    81	                print(f"    {SYSTEM_NAME[system]} {question['own_id']}: {shown}")
    82	
    83	
    84	def reading_b(key):
    85	    confirmation = lines('control-confirmation.jsonl')
    86	    confirmed = sorted(row['candidate'] for row in confirmation if row['verdict'] == 'SUPPORTED')
    87	    if len(confirmed) < 4:
    88	        raise SystemExit(f'only {len(confirmed)} supported controls were confirmed: refused')
    89	    controls = confirmed[:4]
    90	    answers = {family: {row['item']: row for row in lines(f'{family}-B.jsonl')} for family in FAMILIES}
    91	    for family in FAMILIES:
    92	        if sorted(answers[family]) != [row['item'] for row in key]:
    93	            raise SystemExit(f'{family} judged {len(answers[family])} of {len(key)} items: refused')
    94	    print(f'READING B: {len(key)} items; supported controls (confirmed first by a separate reader: {confirmed}): candidates {controls}')
    95	    planted = [row for row in key if row['planted']]
    96	    real = [row for row in key if not row['planted']]
    97	    for family in FAMILIES:
    98	        caught = [row['item'] for row in planted if answers[family][row['item']]['verdict'] != 'SUPPORTED']
    99	        passed = [row['item'] for row in real if row['candidate'] in controls and answers[family][row['item']]['verdict'] == 'SUPPORTED']
   100	        print(f'  {family}: planted wrong judgements caught {len(caught)} of {len(planted)}; supported controls passed {len(passed)} of {len(controls)}')
   101	    for system in SYSTEM_NAME:
   102	        rows = [row for row in real if row['draw'] == system]
   103	        per_family = {family: {} for family in FAMILIES}
   104	        for family in FAMILIES:
   105	            for row in rows:
   106	                found = answers[family][row['item']]['verdict']
   107	                per_family[family][found] = per_family[family].get(found, 0) + 1
   108	        both = [row for row in rows if all(answers[family][row['item']]['verdict'] == 'SUPPORTED' for family in FAMILIES)]
   109	        print(f"  {SYSTEM_NAME[system]:10}: {len(rows)} last judgements; " + '; '.join(f'{family} {per_family[family]}' for family in FAMILIES) +
   110	              f'; supported by both families {len(both)} of {len(rows)} ({len(both) / len(rows):.0%})')
   111	        for row in rows:
   112	            verdicts = {family: answers[family][row['item']] for family in FAMILIES}
   113	            if any(v['verdict'] != 'SUPPORTED' for v in verdicts.values()):
   114	                print(f"    {SYSTEM_NAME[system]} {row['view']} (item {row['item']}): " +
   115	                      ' | '.join(f"{family}: {v['verdict']} ({v.get('why')})" for family, v in verdicts.items()))
   116	        for family in FAMILIES:
   117	            flagged = [(row['view'], bad.get('id'), bad.get('why')) for row in rows for bad in answers[family][row['item']].get('bad_citations') or []]
   118	            print(f'    cited statements flagged by {family}: {len(flagged)} {flagged}')
   119	
   120	
   121	def main():
   122	    key_folder = Path(sys.argv[1])
   123	    reading_a(json.loads((key_folder / 'week-key-A2.json').read_text()))
   124	    reading_b(json.loads((key_folder / 'week-key-B.json').read_text()))
   125	
   126	
   127	if __name__ == '__main__':
   128	    main()
