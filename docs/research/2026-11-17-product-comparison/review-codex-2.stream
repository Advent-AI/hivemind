   211	def debate_prompt(card, family, rows, diff):
   212	    other = 'claude' if family == 'codex' else 'codex'
   213	    mine, theirs = rows[family], rows[other]
   214	    return (card_prompt(card) + '\n# A second reading\n\nAnother analyst marked this card independently and differs from you on: '
   215	            + ', '.join(diff) + '.\n\nYour marks: ' + json.dumps(fields(mine, card), ensure_ascii=False) + '\nYour reason: ' + mine.get('why', '')
   216	            + '\n\nThe other analyst\'s marks: ' + json.dumps(fields(theirs, card), ensure_ascii=False) + '\nTheir reason: ' + theirs.get('why', '')
   217	            + '\n\nRead the card and its articles again. For every field, keep your mark or change it, judged on the material alone; the other '
   218	              'analyst can be wrong. Return the full JSON object in the shape asked above, with `why` saying for each disputed field why you '
   219	              'kept or changed it.')
   220	
   221	
   222	def debate(round_number):
   223	    cards = json.loads((HERE / 'cards.json').read_text())
   224	    previous = json.loads((HERE / f'round-{round_number - 1}.json').read_text())
   225	    out = HERE / f'round-{round_number}.json'
   226	    if out.exists():
   227	        raise SystemExit(f'round {round_number} exists')
   228	    diff = differing(cards, previous)
   229	    print(f'round {round_number}: {len(diff)} cards differ: {diff}')
   230	    rows = {number: dict(pair) for number, pair in previous.items()}
   231	    jobs = [(family, number) for number in diff for family in FAMILIES]
   232	    with concurrent.futures.ThreadPoolExecutor(max_workers=AT_ONCE) as pool:
   233	        results = pool.map(lambda job: mark_one(job[0], cards[job[1]], debate_prompt(cards[job[1]], job[0], previous[job[1]], diff[job[1]]),
   234	                                                f'round-{round_number}'), jobs)
   235	        for (family, number), row in zip(jobs, results):
   236	            if row:
   237	                rows[number][family] = row
   238	            print(f'card {number} {family}: {"ok" if row else "kept previous (no valid answer)"}', flush=True)
   239	    out.write_text(json.dumps(rows, indent=1, ensure_ascii=False) + '\n')
   240	
   241	
   242	def merge():
   243	    cards = json.loads((HERE / 'cards.json').read_text())
   244	    last = max(int(p.stem.split('-')[1]) for p in HERE.glob('round-*.json'))
   245	    rows = json.loads((HERE / f'round-{last}.json').read_text())
   246	    marks, splits = {}, {}
   247	    for number, card in cards.items():
   248	        pair = rows.get(number, {})
   249	        if not all(pair.get(f) for f in FAMILIES):
   250	            splits[number] = {'unresolved': [f for f in FAMILIES if not pair.get(f)]}
   251	            continue
   252	        a, b = (fields(pair[f], card) for f in FAMILIES)
   253	        for key in a:
   254	            if a[key] == b.get(key):
   255	                marks[f'c{number}-{key}'] = a[key]
   256	            else:
   257	                marks[f'c{number}-{key}'] = 'cannot tell'
   258	                splits.setdefault(number, {})[key] = {'codex': a[key], 'claude': b[key]}
   259	        marks[f'c{number}-why'] = f"codex: {pair['codex'].get('why', '')} | claude: {pair['claude'].get('why', '')}"
   260	    (HERE / 'council-marks.json').write_text(json.dumps({'deck': 'deck-1', 'marks': marks, 'opened': {}, 'times': {}, 'started': None,
   261	                                                          'last': None, 'by': f'council, rounds 0 to {last}'}, indent=1, ensure_ascii=False) + '\n')
   262	    (HERE / 'splits.json').write_text(json.dumps(splits, indent=1, ensure_ascii=False) + '\n')
   263	    print(f'merged from round {last}: {len(splits)} cards with a split or unresolved field: {splits}')
   264	
   265	
   266	if __name__ == '__main__':
   267	    command = sys.argv[1] if len(sys.argv) > 1 else ''
   268	    if command == 'build':
   269	        build()
   270	    elif command == 'mark':
   271	        mark()
   272	    elif command == 'debate':
   273	        debate(int(sys.argv[2]))
   274	    elif command == 'merge':
   275	        merge()
   276	    else:
   277	        sys.exit(__doc__)
