   122	def parse(answer):
   123	    start = answer.find('{')
   124	    depth = 0
   125	    for index in range(start, len(answer)):
   126	        depth += {'{': 1, '}': -1}.get(answer[index], 0)
   127	        if depth == 0:
   128	            return json.loads(answer[start:index + 1])
   129	    raise ValueError('no object')
