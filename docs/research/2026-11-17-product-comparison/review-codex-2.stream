   132	def valid(row, card):
   133	    allowed = ('yes', 'no', 'cannot tell')
   134	    if row.get('card') != card['card'] or row.get('worth') not in allowed:
   135	        return False
   136	    if card['kind'] == 'question' and row.get('supported') not in allowed:
   137	        return False
   138	    facts = row.get('facts') or []
   139	    if len(facts) != card['facts']:
   140	        return False
   141	    return all(f.get('bears') in allowed and f.get('effect') in ('the answer', 'only the confidence', 'neither', 'cannot tell') for f in facts)
   142	
   143	
   144	def fields(row, card):
   145	    out = {'worth': row['worth']}
   146	    if card['kind'] == 'question':
   147	        out['supported'] = row['supported']
   148	    for f in row.get('facts') or []:
   149	        out[f'fact{f["fact"]}-bears'] = f['bears']
   150	        out[f'fact{f["fact"]}-effect'] = f['effect']
   151	    return out
