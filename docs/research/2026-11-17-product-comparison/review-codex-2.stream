   154	def mark_one(family, card, prompt, label):
   155	    for attempt in (1, 2):
   156	        answer, void = run(family, prompt)
   157	        record = {'family': family, 'card': card['card'], 'label': label, 'attempt': attempt, 'void': void, 'answer': answer}
   158	        with open(HERE / 'launches.jsonl', 'a') as log:
   159	            log.write(json.dumps(record, ensure_ascii=False) + '\n')
   160	        if void:
   161	            continue
   162	        try:
   163	            row = parse(answer)
   164	        except (ValueError, json.JSONDecodeError):
   165	            continue
   166	        if valid(row, card):
   167	            return row
   168	    return None
