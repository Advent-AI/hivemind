   351	def insufficient_count(readings, system, fav):
   352	    """Latest answers resolved to insufficient among the system's guardrail-share cards (outside the decided denominators)."""
   353	    count = 0
   354	    for draw, cards in readings['cards'].items():
   355	        if system_of(draw) != system:
   356	            continue
   357	        for card in cards.values():
   358	            covering = card['covering'] if card['covering'] != 'split' else fav
   359	            if card['guardrail'] and not covering and card['answer'] != 'no answer' and resolve(card['answer'], 'answer', fav) == 'insufficient':
   360	                count += 1
   361	    return count
