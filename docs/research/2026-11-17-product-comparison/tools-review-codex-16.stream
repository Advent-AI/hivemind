   364	def trivia_count(readings, system, fav):
   365	    """Trivia marks (duplicates apart) among the decided worth marks of the system's guardrail shares' cards."""
   366	    trivia = decided = 0
   367	    for draw, cards in readings['cards'].items():
   368	        if system_of(draw) != system:
   369	            continue
   370	        for card in cards.values():
   371	            covering = card['covering'] if card['covering'] != 'split' else fav
   372	            if not card['guardrail'] or covering:
   373	                continue
   374	            decided += 1
   375	            trivia += resolve(card['worth'], 'worth', fav) == 'trivia'
   376	    return trivia, decided
