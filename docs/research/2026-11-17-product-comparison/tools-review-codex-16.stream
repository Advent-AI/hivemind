   379	def days_to_opening(readings):
   380	    """Per draw and covered matter: days from the matter's earliest listed article to the first covering question's opening. A question
   381	    opened before the scored window (09-07) is 'opened in the warm-up'; one opened in the window before the matter's first listed article
   382	    is 'opened before the first listed article'."""
   383	    import datetime
   384	    out = {}
   385	    for draw, by_matter in readings['mapping'].items():
   386	        for matter, questions in by_matter.items():
   387	            opened = [readings['cards'][draw][q['question']].get('opened') for q in questions if q['covers'] is True]
   388	            opened = [d for d in opened if d]
   389	            first = readings.get('matter_first_day', {}).get(matter)
   390	            if not opened or not first:
   391	                continue
   392	            days = (datetime.date.fromisoformat(min(opened)) - datetime.date.fromisoformat(first)).days
   393	            out.setdefault(matter, {})[draw] = (days if days >= 0 else 'opened in the warm-up' if min(opened) < '2026-09-07'
   394	                                                else 'opened before the first listed article')
   395	    return out
