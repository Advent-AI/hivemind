   226	        path = Path(inputs.get(f'{kind}_path') or '/nonexistent')
   227	        if not path.exists() or hashlib.sha256(path.read_bytes()).hexdigest() != inputs.get(f'{kind}_sha256'):
   228	            raise SystemExit(f'refused: the {kind} file the readings name is missing or differs from its fingerprint')
   229	        return json.loads(path.read_text())
   230	    frozen = [{'matter': m['matter'], 'company_figure': m['company_figure']} for m in json.loads(MATTERS.read_text())['matters']]
