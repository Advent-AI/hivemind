import copy, hashlib, json
import score_comparison as sc
from test_score_comparison import base
data = {}
class MemoryPath:
    def __init__(self, name): self.name = name
    def exists(self): return self.name in data
    def read_bytes(self): return data[self.name]
    def read_text(self): return self.read_bytes().decode()
sc.Path, sc.MATTERS = MemoryPath, MemoryPath(\"matters\")
def put(name, obj):
    data[name] = json.dumps(obj).encode()
    return hashlib.sha256(data[name]).hexdigest()
def seal(r):
    es = put(\"eligibility\", {\"eligible\":True})
    key = {str(i): dict(role=\"product\", draw=d, question=q, **{f:c[f] for f in (\"guardrail\",\"covering\",\"type\")})
           for i,(d,q,c) in enumerate((d,q,c) for d,cards in r[\"cards\"].items() for q,c in cards.items())}
    r[\"inputs\"] = dict(matters_sha256=put(\"matters\", {\"matters\":r[\"matters\"]}),
                       mapping_path=\"map\",mapping_sha256=put(\"map\",dict(mapping=r[\"mapping\"],distinct=r[\"distinct\"],eligibility_sha256=es)),
                       deck_key_path=\"key\",deck_key_sha256=put(\"key\", key),eligibility_path=\"eligibility\",eligibility_sha256=es)
    return r
r = seal(base(n=32,new_served=10,old_served=2,guard_cards=4))
print(\"Baseline\",sc.verdict(r)[\"verdict\"])
for d in (\"new-1\",\"new-2\",\"new-3\"):
    r[\"cards\"][d][d+\"-g-figure-0\"][\"answer\"] = {\"split\":[\"supported\",\"supported\"]}
print(\"Equal mark pair\",sc.verdict(r)[\"verdict\"])
for bad in (None, [], 0, \"\"):
    q = seal(base(n=32,new_served=10,old_served=2))
    q[\"matter_first_day\"] = bad
    sc.verify_inputs(q); sc.validate_readings(q)
    try:
        sc.verdict(q)
    except AttributeError as e:
        print(\"Bad date-map value accepted by validator, aborts verdict\",repr(bad),e)
