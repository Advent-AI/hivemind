   449	def same_unit(frozen, question_id, view):
   450	    """Numeric agreement may be compared: the ruler's unit is established and equals the view's stored unit ("n/a", "other" or no
   451	    stored unit never equal one)."""
   452	    unit = ruler_unit(frozen, question_id)
   453	    return unit is not None and view['unit'] == unit
