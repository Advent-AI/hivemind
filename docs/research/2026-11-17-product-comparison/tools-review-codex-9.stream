   243	def inline(prompt, read_sentence, packet):
   244	    """The prompt with its packet in place of the file it names: a closed session opens no file."""
   245	    if prompt.count(read_sentence) != 1:
   246	        raise SystemExit(f'refused: the prompt does not name its packet exactly once ({read_sentence!r})')
   247	    return prompt.replace(read_sentence, 'Read this packet:\n\n```json\n' + json.dumps(packet, ensure_ascii=False, indent=1) + '\n```\n\n')
