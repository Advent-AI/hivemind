   217	def ladder_unit(conn, view_id):
   218	    """A new-system view's unit: its one `clean_ladders` row (a split child's row carries its year), and the checked answer's figure unit."""
   219	    columns = {row[1] for row in conn.execute('pragma table_info(clean_ladders)')}
   220	    if not columns:
   221	        raise SystemExit('refused: a new-system store without clean_ladders')
   222	    rows = conn.execute('select * from clean_ladders where view_id = ?', (view_id,)).fetchall()
   223	    if len(rows) != 1:
   224	        raise SystemExit(f'refused: view {view_id} has {len(rows)} clean_ladders rows, not one')
