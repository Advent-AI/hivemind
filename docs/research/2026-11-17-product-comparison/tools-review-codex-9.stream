   226	    checked = json.loads(row['checked_answer']) if row.get('checked_answer') else {}
   227	    figure = (checked.get('ladder') or {}).get('figure')
   228	    return {'thesis': row['thesis_id'], 'period': row.get('period') or '', 'unit': figure.get('unit') if figure else None}
