   250	def label_prompt(packet, adjudication=False):
   251	    """Question 1 of the Step 2 reference labelling (`v2-prompt-1.md`) alone, with the reference's adjudication sentence for a third
   252	    reader."""
   253	    body = (LABEL_HEAD + 'Answer from the passages and context, not only the summaries.\n\n' + QUESTION_1
   254	            + (ADJUDICATION_SENTENCE if adjudication else '')
   255	            + 'Return only a JSON array in packet order: [{"id": "V..", "relation": "...", "why": "<one short sentence>"}].\n')
   256	    return inline(body, V2_READ, packet)
