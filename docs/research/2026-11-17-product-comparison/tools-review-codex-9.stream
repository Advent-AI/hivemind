   771	    totals = {family: {'grouped': 0, 'apart': 0} for family in FAMILIES}
   772	    differences = {family: [] for family in FAMILIES}
   773	    for entry in key['groups']:
   774	        for family in FAMILIES:
   775	            grouped, apart = stated.get((entry['group'], 'grouped', family), 0), stated.get((entry['group'], 'apart', family), 0)
   776	            totals[family]['grouped'] += grouped
   777	            totals[family]['apart'] += apart
   778	            differences[family].append(grouped - apart)
   779	    pooled = {rendering: sum(totals[f][rendering] for f in FAMILIES) for rendering in ('grouped', 'apart')}
   780	    pooled_differences = [sum(values) for values in zip(*differences.values())]
   781	    result = {'key sha256': key_sha, 'groups': LINE3_GROUPS, 'key details': sum(len(e['details']) for e in key['groups']),
   782	              'groups with an empty key': sum(1 for e in key['groups'] if not e['details']), 'pooled totals': pooled,
   783	              'mean paired difference, pooled': sum(pooled_differences) / len(pooled_differences),
   784	              'bootstrap_95, pooled': bootstrap_interval(pooled_differences, f'{SEED + 3}:pooled'),
   785	              'totals by family': totals, 'mean paired difference by family': {f: sum(d) / len(d) for f, d in differences.items()},
   786	              'bootstrap_95 by family': {f: bootstrap_interval(d, f'{SEED + 3}:{f}') for f, d in differences.items()},
   787	              'surrounding dossier': {'groups with no thesis link': sum(1 for n in dossier_sizes if n == 0), 'largest': max(dossier_sizes)},
   788	              'rendering prompt bytes': {'sessions': len(sizes), 'median': sizes[len(sizes) // 2] if sizes else None,
   789	                                         'max': sizes[-1] if sizes else None, f'over {LARGE_PROMPT}': sum(1 for s in sizes if s > LARGE_PROMPT)},
   790	              **beside}
   791	    if missing:
   792	        result.update(status='not measured', reason=f'{len(missing)} rendering sessions missing (first {missing[0]})')
   793	    else:
   794	        result.update(status='passed' if pooled['grouped'] >= pooled['apart'] else 'failed')
   795	    return finish(out, 3, folder, result)
   796	
   797	
   798	def bootstrap_interval(values, seed):
   799	    """95% percentile interval of the mean over groups, resampled with replacement."""
   800	    chooser = random.Random(seed)
   801	    means = sorted(sum(chooser.choice(values) for _ in values) / len(values) for _ in range(BOOTSTRAP))
   802	    return [means[int(0.025 * BOOTSTRAP)], means[int(0.975 * BOOTSTRAP) - 1]]

