   195	def rulings_problem(answer, mark_of_point):
   196	    """Why a third reader's answer to a ruling packet is void, or None. Each line is read as `collect_readings.read_rulings` reads a
   197	    rulings file (collect_readings.py:166-175: blank lines and code fences skipped, a line kept by its `id`); a line it would skip, a point
   198	    ruled twice, a point outside the packet, or a point without a ruling of the form (`holds` or `fails` on a mark, `upheld` true or false
   199	    on a fault named under W, as `read_rulings` takes them) makes the answer void."""
   200	    rulings, unreadable, repeated = {}, [], []
   201	    for line in answer.splitlines():
   202	        line = line.strip()
   203	        if not line or line.startswith('```'):
   204	            continue
   205	        try:
   206	            ruling = json.loads(line)
   207	            point = ruling['id']
   208	            if point in rulings:
   209	                repeated.append(point)
   210	            rulings[point] = ruling
   211	        except (ValueError, KeyError, TypeError):
   212	            unreadable.append(line[:80])
   213	    if unreadable:
   214	        return f'{len(unreadable)} lines the collector would not read as a ruling: {unreadable[:5]}'
   215	    if repeated:
   216	        return f'more than one ruling for points {repeated[:10]}'
   217	    outside = sorted(str(point) for point in set(rulings) - set(mark_of_point))
   218	    if outside:
   219	        return f'rulings for points outside the packet: {outside[:10]}'
   220	    missing = [point for point, mark in mark_of_point.items()
   221	               if not (rulings.get(point, {}).get('upheld') in (True, False) if mark == 'W'
   222	                       else rulings.get(point, {}).get('ruling') in accounting.VERDICTS)]
   223	    if missing:
   224	        return f'{len(missing)} points without a valid ruling: {missing[:10]}'
   225	    return None
