   749	    codes = random.Random(f'{SEED + 3}:codes').sample(range(100, 1000), 2 * LINE3_GROUPS)
   750	    code_key, jobs, dossier_sizes = {}, [], []
   751	    for index, entry in enumerate(key['groups']):
