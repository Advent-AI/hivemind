   156	def article_texts(trace):
   157	    """Each article's source text by its manifest position (as run_forward.step1_records numbers articles), and the manifest's length."""
   158	    texts, position = {}, None
   159	    for part in trace.split('+'):
   160	        conn = sqlite3.connect(f'file:{part}?mode=ro', uri=True)
   161	        try:
   162	            if position is None:
   163	                position = {iid: n for n, iid in enumerate(json.loads(conn.execute('select manifest from run').fetchone()[0])['item_ids'], 1)}
   164	            for iid, request in conn.execute("select input_id, request from trace where status='complete'"):
   165	                texts[position[iid]] = json.JSONDecoder().raw_decode(json.loads(request)['messages'][1]['content'])[0]['source_item']['text']
   166	        finally:
   167	            conn.close()
   168	    return texts, len(position)
