   495	def line1(run_root, eligibility_record, out, keys=KEY_FOLDER):
   496	    folder, key_file = fresh(Path(out) / 'line-1'), fresh_key(Path(keys) / 'step2-line1-key.json')
   497	    trace = str(component_file(run_root, eligibility_record, 'step1', 'trace.sqlite'))
   498	    articles, entries, manifest_length = packet_entries(trace)
   499	    records = [record for article in articles for record in article]
   500	    by_id = {record['id']: record for record in records}
   501	    article_start, index = {}, 0
   502	    for article_index, article in enumerate(articles):
   503	        article_start[article_index] = index
   504	        index += len(article)
   505	    article_of = {record['id']: article_index for article_index, article in enumerate(articles) for record in article}
   506	    forward = {record['id']: position for position, record in enumerate(records)}
   507	    earlier_of = lambda record_id: records[:article_start[article_of[record_id]]]
   508	    words = {record['id']: matching._words(record['summary'] + ' ' + ' '.join(record['passages'])) for record in records}
   509	    order = draw_order(strata_of(articles, manifest_length), SEED + 1)
   510	    pairs, packet_ids, by_later = {}, {}, collections.defaultdict(list)
   511	    scan_flags, scan_missing = {}, set()
   512	    done, wave, labelled, missing_at = 0, 0, [], None
   513	    while done < len(order):
   514	        size = FIRST_WAVE_ROUNDS * STRATA if not labelled else math.ceil((LINE1_RECORDS - len(labelled)) * done / len(labelled))
   515	        batch, done, wave = order[done:done + max(1, size)], done + max(1, size), wave + 1
   516	        flags, missing = scan(folder, f'w{wave}', [item['record'] for item in batch if item['audited']], earlier_of, entries)
   632	def key_entry(record):
   633	    """A record's statement as a key reader sees it: its summary, passages, party, publication date and publisher. The attribution
   634	    fields the frozen dossier drops for a later report (tier, stated day, period, speaker) are left out, so the key holds content."""
   635	    return {'summary': record['summary'], 'passages': shown_passages(record), 'original_party': record['original_party'],
   636	            'publication_date': record['publication_date'], 'publisher': record['publisher']}
