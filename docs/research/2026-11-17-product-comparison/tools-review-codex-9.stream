   147	def component_file(run_root, eligibility_record, component, name):
   148	    """A file of new-1's `component`, in the folder its run record names, refused unless the eligibility check fingerprinted it."""
   149	    record = json.loads((Path(run_root) / DRAW / 'run.json').read_text())
   150	    entry = record['components'].get(component, {})
   151	    if entry.get('state') != 'completed':
   152	        raise SystemExit(f"refused: {DRAW}'s {component} is {entry.get('state')!r}, not completed")
   153	    return eligibility.verified(eligibility_record, run_root, DRAW, f"{entry['folder']}/{name}")
