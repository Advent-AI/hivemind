   441	def ruler_unit(frozen, question_id):
   442	    """The ruler question's unit in the systems' closed list, None when it cannot be established; an unknown text is refused."""
   443	    text = frozen['questions'][question_id]['unit']
   444	    if text not in RULER_UNITS:
