   415	    result = {'eligible': manifest['eligible'], 'draws': {}}
   416	    to_read = {draw: (folder, key_path) for draw, folder, key_path in draws_to_read(out, manifest)}
   417	    for draw, entry in manifest['draws'].items():
   418	        if draw not in to_read:
   419	            result['draws'][draw] = {'status': entry['status'], **{f'line {number}': accounting.NOT_MEASURED for number in (1, 2, 3, 4, 5)}}
   420	            continue
   421	        folder, key_path = to_read[draw]
   422	        stored_path = folder / 'stage-a-report.json'
   423	        stored_path.unlink(missing_ok=True)                     # a failed report must not leave an earlier one to be read
   424	        collected = run_stage_a_tool([COLLECT_READINGS, 'report', folder, key_path], cwd=out)
   425	        (folder / 'report.txt').write_text(collected.stdout + (f'\n[exit {collected.returncode}] {collected.stderr}' if collected.returncode else ''))
   426	        missing = missing_sessions(folder)
   427	        if collected.returncode != 0:
   428	            reason = collected.stderr.strip().splitlines()[-1] if collected.stderr.strip() else f'exit {collected.returncode}'
   429	            result['draws'][draw] = {'status': f'not measured: collect_readings.py report refused: {reason}', 'missing sessions': missing,
   430	                                     **{f'line {number}': accounting.NOT_MEASURED for number in (1, 2, 3, 4, 5)}}
   431	            continue
   432	        stored = json.loads(stored_path.read_text())
   433	        countings = {'one counting (no rulings of two third readers)': stored} if 'lines' in stored else {label: stored[label] for label in TWO_COUNTINGS}
   434	        entry_out = {'status': 'read', 'missing sessions': missing,
   435	                     'reading': {label: counting['reading'] for label, counting in countings.items()},
   436	                     'dispute share': next(iter(countings.values()))['dispute share'],
   437	                     'unresolved points': len(stored.get('unresolved', []))}
   438	        for number in ('1', '2', '3', '4'):
   439	            entry_out[f'line {number}'] = verdict_under_both(
   440	                [line if isinstance(line, str) else line[0] for line in (counting['lines'][number] for counting in countings.values())])
