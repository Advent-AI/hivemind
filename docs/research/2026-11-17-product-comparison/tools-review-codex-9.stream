   231	def listed_views(conn, system, day=DAY, last_seq=None):
   232	    """(the last sequence used, where it came from, the views created on or before the day in creation order, closed ones included,
   233	    each with its rungs and its state as of the day). `last_seq` is given only for a stored store that records no completed day."""
   234	    source = 'given' if last_seq is not None else 'days_completed'
   235	    last = last_seq if last_seq is not None else last_sequence(conn, day)
   236	    views = []
   237	    for row in conn.execute('select rowid as created_order, * from views order by created_seq, rowid'):
   238	        record = dict(row)
   239	        if record['created_seq'] > last:
   240	            continue
   241	        state = service.state_as_of(conn, record['view_id'], day)
   242	        rungs = [dict(r) for r in conn.execute('select position, label, condition, lo, hi from rungs where view_id = ? order by position',
   243	                                               (record['view_id'],))]
   244	        view = {key: record[key] for key in ('view_id', 'created_seq', 'created_order', 'created_from_input', 'question', 'looks_at',
   245	                                             'due_day', 'year', 'kind')}
   246	        view['rungs'] = rungs
   247	        view['state'] = None if state is None else {'position': state['position'], 'judgement_day': state['judgement_day'],
   248	                                                    'since_day': state['since_day'], 'rounds': state['rounds']}
   249	        if system == 'new':
