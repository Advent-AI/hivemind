   236	def test_a_reader_timeout_is_a_void_retried_once_then_reported_missing(tmp_path, monkeypatch):
   237	    """DESIGN-1.6.md, state x event, with the shared launcher's timeout: `census_readers.run` returns a session with no answer within
   238	    3600 s as a void, so it is retried once, then reported missing. Only the command-line process is faked: the Claude one times out,
   239	    the Codex one answers in Codex's event stream."""
   240	    launched = []
   241	
   242	    def command_line(command, input, **options):
   243	        family = 'claude' if command[0] == 'claude' else 'codex'
   244	        launched.append(family)
   245	        if family == 'claude':
   246	            raise subprocess.TimeoutExpired(command, options['timeout'])
   247	        answer, _ = FakeSessions()(family, input)
   248	        events = [{'type': 'turn.started'}, {'type': 'item.completed', 'item': {'type': 'agent_message', 'text': answer}}]
   249	        return subprocess.CompletedProcess(command, 0, stdout='\n'.join(map(json.dumps, events)), stderr='')
   250	    monkeypatch.setattr(d400_reader_lines.census_readers, 'subprocess',
   251	                        types.SimpleNamespace(run=command_line, TimeoutExpired=subprocess.TimeoutExpired))
   252	    out = one_draw_with_packets(tmp_path)
   253	    results = sorted(d400_reader_lines.read_packets(out))
   254	    assert [void for _, _, void in results] == ['no answer within 3600 s', None] and launched.count('claude') == 2
   255	    assert [void for session, void in voids_logged(out) if session == 'reader-claude-packet-1'] == ['no answer within 3600 s'] * 2
