   101	def swap(text, old, new):
   102	    """`text` with `old`, which must occur exactly once, replaced by `new`."""
   103	    if text.count(old) != 1:
   104	        raise SystemExit(f'refused: the prompt source does not hold {old!r} exactly once')
   105	    return text.replace(old, new)
