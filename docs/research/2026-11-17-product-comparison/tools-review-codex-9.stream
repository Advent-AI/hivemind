   169	def rows_problem(answer, family, packet_sends, key, outcomes):
   170	    """Why a reader's answer to a packet is void, or None. The answer is read by the collector's own `collect_readings.rows_of`, so the
   171	    wrapper accepts only what the collector keeps: every line it reads is read as a row (an item written `1.0` is not), each item has
   172	    one row, no row names a send outside the packet (the collector merges a family's files by item), and every send of the packet has a
   173	    valid row (accounting.row_problem). `packet_sends` is {item: (case, pass)}; `outcomes` is {(case, pass): outcome}."""
   174	    counting_key = LookupCountingKey(key)
   175	    with tempfile.TemporaryDirectory(prefix='d400-reader-answer-') as folder:
   176	        (Path(folder) / 'readers-answers').mkdir()
   177	        (Path(folder) / 'readers-answers' / f'reader-{family}-packet-1.jsonl').write_text(answer)
   178	        rows, unreadable = collect_readings.rows_of(folder, counting_key, family)
   179	    if unreadable:
   180	        return f'{len(unreadable)} lines the collector would not read as a row: ' + '; '.join(
   181	            f'line {number}: {text}' for _, number, text in unreadable[:5])
   182	    repeated = sorted(item for item, count in counting_key.found.items() if count > 1)
   183	    if repeated:
   184	        return f'more than one row for items {repeated[:10]}'
   185	    outside = sorted(set(rows) - set(packet_sends.values()))
   186	    if outside:
   187	        return f'rows for sends outside the packet: {outside[:10]}'
   188	    problems = [(item, accounting.row_problem(rows.get(send), outcomes[send])) for item, send in packet_sends.items()]
   189	    problems = [(item, problem) for item, problem in problems if problem]
   190	    if problems:
   191	        return f'{len(problems)} items without a valid row: ' + '; '.join(f'item {item}: {problem}' for item, problem in problems[:5])
   192	    return None
