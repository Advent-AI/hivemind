   364	def strata_of(articles, manifest_length):
   365	    """Record ids in three equal strata of the run's manifest by each article's forward position (articles holding no record count
   366	    towards the strata); the records of the first article that holds any have no earlier record and are left out."""
   367	    strata = [[] for _ in range(STRATA)]
   368	    for index, records in enumerate(articles):
   369	        if index:
   370	            for record in records:
   371	                strata[(record['article'] - 1) * STRATA // manifest_length].append(record['id'])
   372	    return strata
