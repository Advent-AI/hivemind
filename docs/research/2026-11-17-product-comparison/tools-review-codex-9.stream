   214	    stored unit) are all shown "n/a" in every packet; the output keeps the stored value."""
   215	    rungs = CAPEX_RUNGS
   216	    new = make_store(tmp_path / 'new.sqlite', 'new', [('v1', 2, Q_CAPEX26, '2027-03-31', rungs, {'unit': 'other'}),
   217	                                                      ('v2', 4, Q_CHINA, '2027-01-31', ANSWER_CHOICE)], judgements=[('v1', 3, 2), ('v2', 6, 1)])
   218	    old = make_store(tmp_path / 'old.sqlite', 'old', [('v1', 2, Q_CAPEX26, '2027-03-31', rungs, {'unit': 'n/a'}),
   219	                                                      ('v2', 4, Q_CHINA, '2027-01-31', YES_NO)], judgements=[('v1', 3, 2), ('v2', 6, 1)])
   220	    prompts = []
   221	    result = read(tmp_path, monkeypatch, {'new-1': {'system': 'new', 'views': new}, 'old-1': {'system': 'old', 'views': old}},
   222	                  {'match': {Q_CAPEX26: both('q04'), Q_CHINA: both('q08')}}, prompts)
   223	    shown = [item['judged_question']['unit'] for prompt in set(prompts) if prompt.startswith('# Reading the control questions')
   224	             for item in last_packet(prompt)]                               # each family gets the same packet: read it once
   225	    assert sorted(shown) == ['n/a'] * 4                                     # two systems, a figure and an event each
   226	    assert result['outcomes']['q04']['new-1']['unit'] == 'other' and result['outcomes']['q04']['old-1']['unit'] == 'n/a'
