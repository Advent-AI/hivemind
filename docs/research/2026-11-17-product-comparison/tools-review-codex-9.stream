   760	            jobs += [{'name': f'render-{code}-{family}', 'family': family, 'code': str(code), 'prompt': rendering_prompt(text, details),
   761	                      'check': rows_check([d['id'] for d in details], {'stated': lambda value: isinstance(value, bool)})} for family in FAMILIES]
   762	    write_key(key_file, code_key)
