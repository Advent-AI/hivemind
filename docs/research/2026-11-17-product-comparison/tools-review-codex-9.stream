   432	def ruling(values):
   433	    """Two third readers' rulings: agreed, or unresolved; a missing ruling is not measured."""
   434	    if any(v is None for v in values):
   435	        return 'not measured'
   436	    return values[0] if values[0] == values[1] else 'unresolved'
