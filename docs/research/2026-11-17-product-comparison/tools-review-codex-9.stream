   156	class LookupCountingKey(dict):
   157	    """The key from item number to send, counting every item the collector finds in it, so that two rows for one item are seen."""
   158	
   159	    def __init__(self, key):
   160	        super().__init__(key)
   161	        self.found = collections.Counter()
   162	
   163	    def __getitem__(self, item):
   164	        send = super().__getitem__(item)
   165	        self.found[item] += 1
   166	        return send
