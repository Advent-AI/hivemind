    94	def between(text, start, end):
    95	    """The part of `text` from `start` up to `end` (exclusive); each must occur exactly once."""
    96	    if text.count(start) != 1 or text.count(end) != 1 or text.index(end) < text.index(start):
    97	        raise SystemExit(f'refused: the prompt source does not hold {start!r} … {end!r} once, in order')
    98	    return text[text.index(start):text.index(end)]
