   196	def test_a_session_still_void_after_one_retry_is_reported_missing(tmp_path, monkeypatch):
   197	    """DESIGN-1.6.md, state x event: a reader session that voids (a closed-session breach, or an answer without a valid row for every
   198	    item of its packet) is retried once, then reported missing; a line with a missing mark is not measured, and the report says in one
   199	    line that no ask-again round follows (council round 8)."""
   200	    sessions = FakeSessions(voids={'claude': 2}, bad_answers={'codex': ['short']})
   201	    monkeypatch.setattr(d400_reader_lines.census_readers, 'run', sessions)
   202	    out = one_draw_with_packets(tmp_path)
   203	    results = sorted(d400_reader_lines.read_packets(out))
   204	    assert [void for _, _, void in results] == ['a tool use', None]
   205	    assert [family for family, _ in sessions.calls].count('codex') == 2          # the answer short of a row was asked again
   206	    assert not (out / 'new-1' / 'readers-answers' / 'reader-claude-packet-1.jsonl').exists()
   207	    result = d400_reader_lines.report(out)['draws']['new-1']
   208	    assert result['missing sessions'] == ['reader-claude-packet-1'] and result['line 5'] == 'NOT MEASURED'
   209	    assert result['note'] == d400_reader_lines.NO_ASK_AGAIN
