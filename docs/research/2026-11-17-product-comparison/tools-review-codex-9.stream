   122	def run(family, prompt):
   123	    """One closed session; returns (answer text, void reason or None). The Deck 1 rule (council_mark.run)."""
   124	    with tempfile.TemporaryDirectory(prefix='census-reader-') as empty:
   125	        command = CODEX + ['-C', empty, '-'] if family == 'codex' else CLAUDE
   126	        try:
   127	            result = subprocess.run(command, input=prompt, text=True, capture_output=True, cwd=empty, timeout=3600)
   128	        except subprocess.TimeoutExpired:                      # a void, so every caller's retry rule applies (D675)
   129	            return None, 'no answer within 3600 s'
   130	    events = [json.loads(line) for line in result.stdout.splitlines() if line.strip().startswith('{')]
   131	    if family == 'codex':
   132	        started = False
   133	        for event in events:
   134	            item = event.get('item', {})
   135	            if event.get('type') == 'turn.started':
   136	                started = True
   137	            kind = item.get('type')
   138	            if not kind or kind in ('agent_message', 'reasoning'):
   139	                continue
   140	            if kind == 'error' and not started and 'is deprecated' in item.get('message', ''):
   141	                continue
   142	            return None, f'a {kind} item in the log'
   143	        texts = [e.get('item', {}).get('text', '') for e in events if e.get('item', {}).get('type') == 'agent_message']
   144	        answer = texts[-1] if texts else None
   145	    else:
   146	        for event in events:
   147	            if event.get('type') == 'system' and event.get('subtype') == 'init' and (event.get('tools') or event.get('mcp_servers')):
   148	                return None, 'tools or MCP servers loaded'
   149	            if event.get('type') == 'system' and event.get('subtype') not in ('init', 'thinking_tokens'):
   150	                return None, f"system event {event.get('subtype')}"
   151	            content = (event.get('message') or {}).get('content')
   152	            if isinstance(content, list) and any(c.get('type') == 'tool_use' for c in content):
   153	                return None, 'a tool use'
   154	        results = [e.get('result') for e in events if e.get('type') == 'result']
   155	        answer = results[-1] if results else None
   156	    if result.returncode != 0 or not answer:
   157	        return None, f'exit {result.returncode} or no answer'
   158	    return answer, None

