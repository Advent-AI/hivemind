   253	            view['unit'] = key['unit'] if key else None
   254	        views.append(view)
   255	    if conn.execute('select 1 from processing_steps limit 1').fetchone() is not None:
   256	        by_product = {r['view_id'] for r in conn.execute('select * from views') if service.view_exists(conn, dict(r), day)}
   257	        if by_product != {v['view_id'] for v in views}:
   258	            raise SystemExit(f'refused: the listing by sequence differs from service.view_exists on {day}: '
   259	                             f'{sorted(by_product ^ {v["view_id"] for v in views})}')
   260	    return last, source, views
