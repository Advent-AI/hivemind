   212	def test_an_answer_the_collector_would_read_otherwise_is_void(tmp_path, monkeypatch):
   213	    """Council round 8: a packet answer is validated as `collect_readings.rows_of` reads it. A row whose item the collector would drop
   214	    (written 1.0) and two rows for one item each void the answer, which is then asked again, so nothing accepted is later discarded."""
   215	    sessions = FakeSessions(bad_answers={'codex': ['float item'], 'claude': ['repeated row']})
   216	    monkeypatch.setattr(d400_reader_lines.census_readers, 'run', sessions)
   217	    out = one_draw_with_packets(tmp_path)
   218	    assert [void for _, _, void in sorted(d400_reader_lines.read_packets(out))] == [None, None]
   219	    voids = dict((session, void) for session, void in voids_logged(out) if void)
   220	    assert voids['reader-codex-packet-1'].startswith('1 lines the collector would not read as a row: line 7:')
   221	    assert voids['reader-claude-packet-1'].startswith('more than one row for items')
   222	
   223	
   224	def test_a_ruling_answer_is_read_as_the_collector_reads_it():
   225	    """Council round 8: a third reader's answer is read line by line as `collect_readings.read_rulings` reads it; a point ruled twice
   226	    and a line it would skip (an `id` that cannot key a ruling) void the answer instead of being dropped or stopping the tool."""
   227	    points = {'4-Q': 'Q', '4-W-a': 'W'}
   228	    good = [json.dumps({'id': '4-Q', 'ruling': 'fails', 'why': 'No fiscal year is named.'}),
   229	            json.dumps({'id': '4-W-a', 'upheld': False, 'why': 'The rungs do name the year.'})]
   230	    assert d400_reader_lines.rulings_problem('\n'.join(good), points) is None
   231	    assert d400_reader_lines.rulings_problem('\n'.join(good + [good[0]]), points) == "more than one ruling for points ['4-Q']"
   232	    unkeyable = json.dumps({'id': ['4-Q'], 'ruling': 'holds'})
   233	    assert d400_reader_lines.rulings_problem('\n'.join(good + [unkeyable]), points).startswith('1 lines the collector would not read')
   234	
