   639	def attribution_differences(groups):
   640	    """Later reports whose tier, stated day, period or speaker differ from their original's: the fields `group_text` does not print
   641	    for a later report (printed beside line 3, never in its rule)."""
   642	    by_field, reports, holding = collections.Counter(), 0, 0
   643	    for group in groups:
   644	        differing = 0
   645	        for member in group['members']:
   646	            fields = [f for f in ATTRIBUTION_FIELDS if member.get(f) != group['original'].get(f)]
   647	            by_field.update(fields)
   648	            differing += bool(fields)
   649	        reports += differing
   650	        holding += bool(differing)
   651	    return {'later reports that differ': reports, 'later reports': sum(len(g['members']) for g in groups), 'groups holding one': holding,
   652	            'groups': len(groups), 'by field': {f: by_field[f] for f in ATTRIBUTION_FIELDS}}
   653	
   654	
   655	def surrounding_dossier(stored, group_id):
   656	    """The other groups linked to the group's first thesis link, in library order (none when the group has no link)."""
   657	    links = stored['groups'][group_id]['links']
   658	    if not links:
   659	        return []
   660	    thesis = next(iter(links))
   661	    return [g for g in stored['order'] if g != group_id and thesis in stored['groups'][g]['links']]
   662	
   663	
   664	def renderings_of(store, stored, group_id):
   665	    """The group's two renderings, each after the same surrounding dossier: its other groups' originals labelled E1..Ek, then the group
   666	    from E(k+1), grouped (the frozen dossier entry) or apart (each record its own entry)."""
   667	    others = surrounding_dossier(stored, group_id)
   668	    labels = {g: f'E{n}' for n, g in enumerate(others, 1)}
   669	    context = [library.record_text(stored['groups'][g]['original'], labels[g]) for g in others]
   670	    start = len(others) + 1
   671	    group = stored['groups'][group_id]
   672	    grouped = library.group_text(store, group_id, f'E{start}', {**labels, group_id: f'E{start}'}, member_text=True)
   673	    apart = [library.record_text(record, f'E{start + n}') for n, record in enumerate([group['original']] + group['members'])]
   674	    return {'grouped': '\n\n'.join(context + [grouped]), 'apart': '\n\n'.join(context + apart)}, len(others)
   675	
   676	
   677	def normal(detail):
   678	    return ' '.join(detail.split()).casefold()
