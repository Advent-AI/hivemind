    27	        if name == 'git_commit':
    28	            continue
    29	        path = ROOT / name if not name.startswith('/') else Path(name)
    30	        if not path.exists() or hashlib.sha256(path.read_bytes()).hexdigest() != digest:
    31	            changed.append(name)
    32	    return changed
    33	
    34	
    35	def main(root, label, kind, until_day, guard):
    36	    changed = manifest_changed()
    37	    if changed:
    38	        raise SystemExit(f'refused: files differ from the versions manifest: {changed}')
    39	    root = Path(root)
    40	    root.mkdir(parents=True, exist_ok=True)
    41	    ledger = root / 'ledgers' / f'{label}.json'
    42	    ledger.parent.mkdir(exist_ok=True)
    43	    if not ledger.exists():
    44	        subprocess.run([sys.executable, BUDGET_REPLAY, '--init-ledger', ledger, '--ceiling', str(float(guard))], check=True, cwd=ROOT)
    45	    argv = ['caffeinate', '-i', '-s', sys.executable, str(RUN_FRESH), 'clean' if kind == 'new' else 'prod', '--root', str(root), '--label', label,
    46	            '--ledger', str(ledger), '--manifest', str(DATA / 'manifest-2026-07-01-09-20.json'), '--until-day', until_day,
    47	            '--items', str(DATA / 'items-comparison.sqlite')]
    48	    if kind == 'new':
    49	        argv += ['--limits', str(DATA / 'comparison-limits.json'), '--ladder-variant', 'astra-frozen', '--judge-end-day', until_day,
    50	                 '--passes', '3']
    51	    log = open(root / f'{label}.launcher.log', 'a')
    52	    process = subprocess.Popen(argv, cwd=ROOT, stdout=log, stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL, start_new_session=True,
    53	                               env=dict(os.environ, PYTHONDONTWRITEBYTECODE='1'))
    54	    (root / f'{label}.pid').write_text(f'{process.pid}\n')
    55	    print(f'{label} ({kind}) launched: pid {process.pid}, ledger {ledger} (guard ${guard}), until {until_day}')
    56	
    57	
    58	if __name__ == '__main__':
    59	    main(*sys.argv[1:6])
