    62	def load(name, path):
    63	    spec = importlib.util.spec_from_file_location(name, path)
    64	    module = importlib.util.module_from_spec(spec)
    65	    spec.loader.exec_module(module)
    66	    return module
    67	
    68	
    69	budget_replay = load('budget_replay', HERE / 'budget_replay.py')
    70	
    71	
    72	def now():
    73	    """Wall-clock time for the timing report only (nothing is ordered by it)."""
    74	    import time
    75	    return time.strftime('%Y-%m-%dT%H:%M:%S%z')
    76	
    77	
    78	class Interrupted(BaseException):
    79	    """SIGTERM or SIGINT reached the launcher."""
    80	
    81	
    82	def child_environment():
    83	    """The launcher's environment, with the repository's `src` first on the import path (an existing path is kept after it)."""
    84	    path = os.pathsep.join(part for part in (str(ROOT / 'src'), os.environ.get('PYTHONPATH')) if part)
    85	    return dict(os.environ, PYTHONDONTWRITEBYTECODE='1', PYTHONPATH=path)
    86	
    87	
    88	def execute(argv, log_path, on_start=lambda process: None):
    89	    """Run one component as its own process (its output to its log); `on_start` receives the process before the launcher waits.
    90	    Returns the exit status: negative when a signal killed it."""
    91	    env = child_environment()
    92	    with open(log_path, 'a') as log:
    93	        process = subprocess.Popen([str(a) for a in argv], cwd=ROOT, stdout=log, stderr=subprocess.STDOUT, env=env)
    94	        on_start(process)
    95	        return process.wait()
    96	
    97	
    98	def check(argv, log_path):
    99	    with open(log_path, 'a') as log:
   100	        return subprocess.run([str(a) for a in argv], cwd=ROOT, stdout=log, stderr=subprocess.STDOUT, env=child_environment()).returncode
   101	
   102	
   103	def frozen_unseeded_changed(listing=ROOT / 'clean-arch/unseeded-2026-11-10/unseeded-frozen.sha256'):
   104	    """The files of the unseeded freeze whose sha256 differs from the listing (paths relative to the listing's folder)."""
   105	    changed = []
   106	    for line in listing.read_text().splitlines():
   107	        digest, name = line.split(maxsplit=1)
   108	        path = listing.parent / name.strip()
   109	        if not path.exists() or hashlib.sha256(path.read_bytes()).hexdigest() != digest:
   110	            changed.append(name.strip())
   111	    return changed
   112	
   113	
   114	def preconditions(kind, run_check=check, log_path=None):
   115	    """The checks the old launcher made, plus the frozen production configuration; a failure starts nothing."""
   116	    failures = []
   117	    if not CREDENTIALS.exists():                                       # its existence only; never read here
   118	        failures.append('the credentials file is missing')
   119	    changed = frozen_unseeded_changed()
   120	    if changed:
   121	        failures.append(f'a frozen unseeded file changed: {changed}')
   122	    checks = [([sys.executable, '-m', 'pytest', '-q', '-p', 'no:cacheprovider', ROOT / 'tests/test_frozen_clean_step2.py'], 'a frozen Step 2 file changed')]
   123	    if kind == 'clean':
   124	        checks.append(([sys.executable, '-m', 'pytest', '-q', '-p', 'no:cacheprovider', ROOT / 'clean-arch/step1/test_runner.py', '-k', 'adopted_c8'],
   125	                       'the PRD request is not c8'))
   126	    for argv, failure in checks:
   127	        if run_check(argv, log_path) != 0:
   128	            failures.append(failure)
   129	    if kind == 'prod' and hashlib.sha256(PROD_CONFIG.read_bytes()).hexdigest() != PROD_CONFIG_SHA256:
   130	        failures.append('poc-v118.json is not the configuration q1–q3 ran')
   131	    return failures
   132	
   133	
   134	def manifest_until(until_day, manifest_path=None, items=ITEMS):
   135	    """The run's manifest (the full run's 243 items, or the one given) cut to the items published on or before `until_day`, in the same order."""
   136	    manifest = json.loads(Path(manifest_path or STAGE2 / 'stage2-manifest.json').read_text())
   137	    if until_day == manifest['until_day']:
   138	        return manifest
   139	    conn = sqlite3.connect(f'file:{items}?mode=ro', uri=True)
   140	    try:
   141	        day_of = {item_id: conn.execute('select publication_day from items where input_id=?', (item_id,)).fetchone()[0]
   142	                  for item_id in manifest['item_ids']}
   143	    finally:
   144	        conn.close()
   145	    kept = [item_id for item_id in manifest['item_ids'] if day_of[item_id] <= until_day]
   146	    if not kept:
   147	        raise SystemExit(f'no item on or before {until_day}')
   148	    return dict(manifest, until_day=until_day, item_limit=len(kept), item_ids=kept)
   149	
   150	
   235	        for component, entry in record['components'].items():
   236	            if entry['attempts'] and entry['attempts'][-1]['state'] == 'started':
   237	                entry['attempts'][-1].update(state='crashed', reason=reason)
   238	                record['stopped'] = f'{component} crashed: {reason}'
   239	        self.save(record)
   240	
   241	    def _launch(self, redo, redo_reason):
   242	        record = self.load()
   243	        if record.get('identity') != self.identity():
   244	            raise SystemExit(f"{self.label} was first launched as {record.get('identity')}; this launch differs: refused")
   245	        for component, entry in record['components'].items():   # an attempt left started: its launcher died (a crash)
   246	            if entry['attempts'] and entry['attempts'][-1]['state'] == 'started':
   247	                entry['attempts'][-1].update(state='crashed', reason='found started at a later launch: its launcher died')
   248	                return self.stop_run(record, f'{component} crashed in {entry["attempts"][-1]["folder"]} (recorded; no redo)')
   249	        ledger_state = self.ledger.read()
   250	        if ledger_state.get('stopped'):
   251	            record.setdefault('refused launches', []).append(f"the run is stopped: {ledger_state.get('stop_reason')}")
   252	            self.save(record)
   253	            return record
   254	        if record['state'] in ('stopped', 'complete'):
   255	            return record
   256	        if record['state'] == 'awaiting a redo decision' and redo != record.get('awaiting'):
   257	            raise SystemExit(f"{self.label} awaits a redo decision on {record['awaiting']}: relaunch with --redo {record['awaiting']} "
   258	                             '--redo-reason <text> after reading its output')
   259	        failures = preconditions(self.kind, self.run_check, self.folder / 'preconditions.log')
   260	        if failures:
   261	            record.setdefault('refused launches', []).append('; '.join(failures))
   262	            self.save(record)
   263	            raise SystemExit('nothing started: ' + '; '.join(failures))
   264	        record['state'] = 'running'
   265	        record.pop('awaiting', None)
   266	        self.working = True                                # from here on, any exit but a normal return stops the run (close)
   267	        self.local_cap = ledger_state['ceiling']           # the shared ledger binds first: local reservations are smaller
   268	        for component in (CLEAN if self.kind == 'clean' else PROD):
   269	            entry = record['components'].setdefault(component, {'attempts': []})
   270	            if entry.get('state') in ('completed', 'skipped'):
   271	                continue
   272	            stopped = self.ledger.read()
   273	            if stopped.get('stopped'):                     # another draw, or a component of this one, stopped the run
   274	                record['state'], record['stopped'] = 'stopped', f"the shared ledger, before {component}: {stopped.get('stop_reason')}"
   275	                self.save(record)
   276	                return record
   277	            attempts = entry['attempts']
   278	            if attempts:                                   # the last attempt stopped: only an explicit redo goes on (a stopped redo has
   279	                # already stopped the run on the ledger, so a third attempt is refused above)
   280	                if redo != component or component not in REDO_ALLOWED:
   281	                    return self.stop_run(record, f'{component}: no redo allowed after {len(attempts)} attempt(s)')
   282	            folder_name = component if not attempts else f'{component}-redo'
   283	            if (self.folder / folder_name).exists():
   284	                attempts.append({'folder': folder_name, 'state': 'crashed', 'reason': 'its folder exists with no recorded attempt'})
   285	                return self.stop_run(record, f'{component}: {folder_name} exists with no recorded attempt')
   286	            attempts.append({'folder': folder_name, 'state': 'started', 'started at': now(), **({'redo reason': redo_reason} if attempts else {})})
   287	            self.save(record)
   288	            outcome, reason = getattr(self, f'_{component}')(record, self.folder / folder_name)   # any exception: `close` handles it
   289	            attempts[-1]['ended at'] = now()
   290	            if outcome == 'crashed':
   291	                attempts[-1].update(state='crashed', reason=reason)
   292	                return self.stop_run(record, f'{component} crashed: {reason}')
   293	            if outcome not in ('completed', 'skipped') and self.ledger.read().get('stopped'):
   294	                attempts[-1].update(state='stopped', reason=f"the shared ledger: {self.ledger.read().get('stop_reason')}")
   295	                record['state'], record['stopped'] = 'stopped', attempts[-1]['reason']
   296	                self.save(record)
   297	                return record
   298	            if outcome in ('completed', 'skipped'):
   299	                attempts[-1]['state'] = 'completed'
   300	                entry['state'], entry['folder'] = outcome, folder_name
   301	                if reason:
   302	                    entry['note'] = reason
   303	                self.save(record)
   304	                continue
   305	            attempts[-1].update(state='stopped', reason=reason)
   306	            if outcome == 'stopped' and component in REDO_ALLOWED and len(attempts) == 1:
   307	                record['state'], record['awaiting'] = 'awaiting a redo decision', component
   308	                self.save(record)
   309	                return record
   310	            return self.stop_run(record, f'{component}: {reason}')
   311	        record['state'] = 'complete'
   312	        self.save(record)
   313	        return record
   314	
   327	    def items(self):
   328	        """The items database both systems read: the one given (--items), or the default corpus."""
   329	        return Path(self.options.get('items', ITEMS))
   330	
   331	    def _call(self, argv, folder, record=None):
   332	        """Run a component; returns ('crashed', reason) for a signal exit, else (None, exit status)."""
   333	        def started(process):
   334	            self.child = process
   335	            if record is not None and getattr(process, 'pid', None):
   336	                attempt = next(entry['attempts'][-1] for entry in record['components'].values()
   337	                               if entry['attempts'] and entry['attempts'][-1]['state'] == 'started')
   338	                attempt['pid'] = process.pid                # for the operator and the proof; liveness is the launcher's lock
   339	                self.save(record)
   340	        status = self.run_component(argv, folder.parent / f'{folder.name}.log', started)
   341	        self.child = None
   342	        if status < 0:
   343	            return 'crashed', f'killed by signal {-status} (see {folder.name}.log)'
   344	        return None, status
   345	
   346	    # the components: each returns (outcome, reason); outcome 'completed', 'stopped' (a redo may follow), 'stopped-run' or 'crashed'
   347	    def _step1(self, record, folder):
   348	        folder.mkdir()
   349	        (folder / 'manifest.json').write_text(json.dumps(manifest_until(self.options['until_day'], self.options.get('manifest'), self.items()), indent=1))
   350	        shutil.copy(ROOT / 'clean-arch/unseeded-2026-11-10/initial-empty.json', folder / 'initial.json')
   351	        shutil.copy(STAGE2 / 'stage2-settings.json', folder / 'settings.json')
   352	        shutil.copy(self.options.get('limits') or STAGE2 / 'stage2-limits.json', folder / 'limits.json')
   353	        crash, status = self._call([sys.executable, ROOT / 'clean-arch/step1/run_live.py', '--source', self.items(), '--output', folder / 'trace.sqlite',
   354	                                    '--manifest', folder / 'manifest.json', '--initial', folder / 'initial.json', '--settings', folder / 'settings.json',
   355	                                    '--limits', folder / 'limits.json', '--shared-ledger', self.ledger_path], folder, record)
   356	        if crash:
   357	            return crash, status
   358	        return ('completed', None) if status == 0 else ('stopped', f'run_live exit {status}: the trace is not complete (see its log)')
   359	
   360	    def _step2(self, record, folder):
   361	        trace = self.done_folder(record, 'step1') / 'trace.sqlite'
   362	        crash, status = self._call([sys.executable, HERE / 'budget_step2.py', '--shared-ledger', self.ledger_path, trace, folder], folder, record)
   363	        if crash:
   364	            return crash, status
   365	        if status != 0:
   366	            return 'stopped', f'Step 2 exit {status}: refused, pending or unresolved links, or a failed call (see its log)'
   367	        stamp = '\n'.join(f'{hashlib.sha256(path.read_bytes()).hexdigest()}  {path}' for path in (trace, folder / 'library.json'))
   368	        (folder / 'inputs.sha256').write_text(stamp + '\n')
   369	        return 'completed', None
   370	
   371	    def _cases(self, record, folder):
   372	        folder.mkdir()
   373	        step1 = self.done_folder(record, 'step1')
   374	        crash, status = self._call([sys.executable, STEP4 / 'stage_a/build_cases.py', '--fresh', self.label, '--draws', step1, '--parts', 'trace.sqlite',
   375	                                    '--output', folder / 'cases.json'], folder, record)
   376	        if crash:
   377	            return crash, status
   378	        if status != 0:
   379	            return 'stopped-run', f'build_cases exit {status}: the cases do not match the opened theses (see its log)'
   380	        if not json.loads((folder / 'cases.json').read_text()):
   381	            for component in ('ladder', 'judge'):
   382	                record['components'][component] = {'attempts': [], 'state': 'skipped', 'note': 'the draw opened no thesis'}
   383	            return 'completed', 'no thesis opened: the ladder step and the judge have nothing to do'
   384	        return 'completed', None
   385	
   386	    def _ladder(self, record, folder):
   387	        cases = self.done_folder(record, 'cases') / 'cases.json'
   388	        variant = self.options.get('ladder_variant', 'frozen')
   389	        script = ASTRA_WRAPPER if variant == 'astra-frozen' else STEP4 / 'stage_a/stage_a.py'
   390	        crash, status = self._call([sys.executable, script, '--folder', folder, '--cap', self.local_cap,
   391	                                    '--passes', self.options['passes'], '--cases-file', cases, '--shared-ledger', self.ledger_path], folder, record)
   392	        if crash:
   393	            return crash, status
   394	        if status != 0:
   395	            return 'stopped-run', f'stage_a exit {status}: a pass is incomplete (see its log)'
   396	        expected = LADDER_CONFIGURATIONS[variant]
   397	        found = set()
   398	        for pass_number in range(1, self.options['passes'] + 1):       # every pass, not only the one the judge reads
   399	            archive = folder / f'send-{pass_number}' / 'archive.sqlite'
   400	            if not archive.exists():
   401	                return 'stopped-run', f'pass {pass_number} wrote no archive'
   402	            conn = sqlite3.connect(f'file:{archive}?mode=ro', uri=True)
   403	            try:
   404	                found |= set(conn.execute('select distinct config_version, config_checksum from model_calls').fetchall())
   405	            finally:
   406	                conn.close()
   407	        if sorted(f'{version} {checksum}' for version, checksum in found) != [expected]:
   408	            record['configuration mismatch'] = sorted(found)
   409	            return 'stopped-run', f'the ladder ran {sorted(found)}, not the {variant} configuration {expected}'
   410	        return 'completed', None
   411	
   412	    def _judge(self, record, folder):
   413	        ladder = self.done_folder(record, 'ladder')
   414	        inputs = {self.label: {'trace': str(self.done_folder(record, 'step1') / 'trace.sqlite'), 'step2': str(self.done_folder(record, 'step2')),
   415	                               'ladders': str(ladder / 'send-1' / 'outcomes.jsonl'), 'ladder_archive': str(ladder / 'send-1' / 'archive.sqlite'),
   416	                               'cases': str(self.done_folder(record, 'cases') / 'cases.json'), 'output_root': str(folder)}}
   417	        if self.options.get('judge_end_day'):
   418	            inputs[self.label]['end_day'] = self.options['judge_end_day']   # the judge walks and closes to this day (D667)
   419	        inputs_path = self.folder / f'{folder.name}-inputs.json'
   420	        inputs_path.write_text(json.dumps(inputs, indent=1))
   421	        crash, status = self._call([sys.executable, STEP4 / 'stage_b/run_stage_b.py', '--root', folder, '--runs', self.label, '--inputs', inputs_path,
   422	                                    '--cap', self.local_cap, '--shared-ledger', self.ledger_path], folder, record)
   423	        if crash:
   424	            return crash, status
   425	        return ('completed', None) if status == 0 else ('stopped-run', f'run_stage_b exit {status}: the draw is incomplete after its own redo rule')
   426	
   427	    def _prod(self, record, folder):
   428	        folder.mkdir()
   429	        argv = [sys.executable, HERE / 'budget_replay.py', '--ledger', self.ledger_path, '--from', self.options.get('from_day', FROM_DAY), '--until', self.options['until_day'],
   430	                '--views', folder / 'views.sqlite', '--archive', folder / 'archive.sqlite', '--config', PROD_CONFIG, '--workers', 16]
   431	        if 'items' in self.options:
   432	            argv += ['--testdb', self.items()]                               # the same items database the clean draw reads
   433	        crash, status = self._call(argv, folder, record)
   434	        if crash:
   435	            return crash, status
   436	        if status != 0:
   437	            return 'stopped', f'budget_replay exit {status} (see its log)'
   438	        totals = [line for line in (folder / 'replay.log').read_text().splitlines() if line.startswith('totals: ')]
   439	        if len(totals) != 1:
   440	            return 'stopped', 'the replay wrote no totals line'
   441	        counts = ast.literal_eval(totals[0][len('totals: '):])
   442	        record['prod totals'] = counts
   443	        if counts.get('failed') or counts.get('not_processed'):
   444	            return 'stopped', f"{counts.get('failed')} failed and {counts.get('not_processed')} unprocessed items (see the log for transport failures)"
   445	        return 'completed', None
   446	
   447	
   448	def main(argv=None):
   449	    parser = argparse.ArgumentParser()
   450	    parser.add_argument('kind', choices=('clean', 'prod'))
   451	    parser.add_argument('--root', required=True)
   452	    parser.add_argument('--label', required=True)
   453	    parser.add_argument('--ledger', required=True)
   454	    parser.add_argument('--until-day', default=None)
   455	    parser.add_argument('--manifest', default=None)
   456	    parser.add_argument('--passes', type=int, default=3)
   457	    parser.add_argument('--redo', default=None)
   458	    parser.add_argument('--redo-reason', default=None)
   459	    parser.add_argument('--items', default=None, help='the items database both systems read (default: the corpus)')
   460	    parser.add_argument('--limits', default=None, help="Step 1's limits file (default: the frozen stage2-limits.json)")
   461	    parser.add_argument('--ladder-variant', choices=sorted(LADDER_CONFIGURATIONS), default='frozen')
   462	    parser.add_argument('--judge-end-day', default=None, help='the last day the judge walks and closes (default: the last article day)')
   463	    arguments = parser.parse_args(argv)
   464	    if not Path(arguments.ledger).exists():
   465	        raise SystemExit('the shared ledger does not exist: it is created by a recorded decision (budget_replay.py --init-ledger)')
   466	    window = (FROM_DAY, LAST_DAY)
   467	    if arguments.manifest:
   468	        given = json.loads(Path(arguments.manifest).read_text())
   469	        window = (given['from_day'], given['until_day'])
   470	    until_day = arguments.until_day or window[1]
   471	    if not (window[0] <= until_day <= window[1]):
   472	        raise SystemExit(f'--until-day must lie in {window[0]}..{window[1]}')
   473	    options = {'until_day': until_day, 'passes': arguments.passes}
   474	    if arguments.manifest:
   475	        options.update(from_day=window[0], manifest=str(Path(arguments.manifest).resolve()))
   476	    for key, value in (('items', arguments.items), ('limits', arguments.limits)):
   477	        if value:
   478	            options[key] = str(Path(value).resolve())
   479	    if arguments.ladder_variant != 'frozen':
   480	        options['ladder_variant'] = arguments.ladder_variant
   481	    if arguments.judge_end_day:
   482	        options['judge_end_day'] = arguments.judge_end_day
   483	    record = Draw(arguments.kind, arguments.root, arguments.label, arguments.ledger, options).launch(arguments.redo, arguments.redo_reason)
   484	    print(json.dumps({k: v for k, v in record.items() if k != 'components'}, indent=1))
   485	    return 0 if record['state'] == 'complete' else 1
   486	
   487	
   488	if __name__ == '__main__':
