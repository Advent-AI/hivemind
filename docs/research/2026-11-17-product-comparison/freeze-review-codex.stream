     1	"""The comparison's input check (plan §1.2 item 5, code change B; $0): the items each system would read over a date range from the given
     2	items database, through each system's own entry. Production: the replay's own loop (`testdb.feed` per day, `--only NVDA`,
     3	`dispatch.route` on an empty store; only items routed to extraction are read). Clean: the runner's own selection rule
     4	(`runner.selected_items` refuses any item outside it). The two must be the same items, and the clean manifest is written in production's
     5	order, with the text identity of every item as the clean entry reads it. Controls: an excluded article is in neither list; a kept article is
     6	in both. `fresh_week_inputs.py` (2026-11-14) with the dates and the database as arguments; nothing else changed.
     7	
     8	    python3 comparison_inputs.py <items db> <from day> <until day> <manifest output> <excluded id> <kept id>
     9	"""
    10	import datetime
    11	import hashlib
    12	import json
    13	import sqlite3
    14	import sys
    15	import tempfile
    16	from pathlib import Path
    17	
    18	ROOT = Path('/Users/lchingen/hivemind')
    19	sys.path[:0] = [str(ROOT / 'src'), str(ROOT / 'clean-arch/step1')]
    20	from hivemind import dispatch, testdb, universe  # noqa: E402
    21	from hivemind.views import store  # noqa: E402
    22	import runner  # noqa: E402
    23	
    24	
    25	def production_list(items, first, last):
    26	    items_db = testdb.open_db(str(items))
    27	    uni = universe.load(str(ROOT / 'poc/universe.json'))
    28	    out = []
    29	    with tempfile.TemporaryDirectory() as folder:
    30	        conn = store.open_db(str(Path(folder) / 'views.sqlite'))
    31	        day = datetime.date.fromisoformat(first)
    32	        while day.isoformat() <= last:
    33	            for item in testdb.feed(items_db, day.isoformat(), day.isoformat()):
    34	                if not any(o['value'] in ('NVDA',) for o in item['object_identifiers']):
    35	                    continue
    36	                if dispatch.route(conn, item, uni).kind == 'extract':
    37	                    out.append(item['input_id'])
    38	            day += datetime.timedelta(days=1)
    39	    return out
    40	
    41	
    42	def main(items, first, last, manifest_path, excluded_id, kept_id):
    43	    prod = production_list(items, first, last)
    44	    manifest = {'entity': 'NVDA', 'from_day': first, 'until_day': last, 'item_limit': len(prod), 'item_ids': prod}
    45	    clean_items = runner.selected_items(items, manifest)                    # refuses any item outside the clean selection rule
    46	    conn = sqlite3.connect(f'file:{items}?mode=ro', uri=True)
    47	    rule = [r[0] for r in conn.execute(
    48	        'select input_id, object_identifiers, text, feed, copy_of, supersedes from items where publication_day between ? and ? '
    49	        'order by publication_day', (first, last))
    50	        if 'NVDA' in [x.get('value') for x in json.loads(r[1] or '[]') if x.get('kind') == 'ticker']
    51	        and r[2] and r[3] == 1 and not r[4] and not r[5]]
    52	    if sorted(rule) != sorted(prod):
    53	        raise SystemExit(f'the two entries differ: production {len(prod)}, the clean rule {len(rule)}; '
    54	                         f'only production {sorted(set(prod) - set(rule))[:5]}; only clean {sorted(set(rule) - set(prod))[:5]}')
    55	    if [i['input_id'] for i in clean_items] != prod:
    56	        raise SystemExit('the clean entry does not read the items in production order')
    57	    if excluded_id in prod or excluded_id in rule:
    58	        raise SystemExit(f'control failed: the excluded {excluded_id} is still read')
    59	    if kept_id not in prod or kept_id not in rule:
    60	        raise SystemExit(f'control failed: the kept {kept_id} is not read')
    61	    identity = hashlib.sha256('\n'.join(f"{i['input_id']}:{hashlib.sha256((i['text'] or '').encode()).hexdigest()}" for i in clean_items).encode()).hexdigest()
    62	    Path(manifest_path).write_text(json.dumps(manifest, indent=1) + '\n')
    63	    print(f'{len(prod)} items {first}..{last}, the same set and order through both entries; excluded control absent, kept control present; '
    64	          f'text identity {identity}; manifest written')
    65	
    66	
    67	if __name__ == '__main__':
    68	    main(*sys.argv[1:7])
     1	# Build-level notes carried to the stage-0 freeze review
     2	
     3	From the reviews of rounds 2 and 3. Each is checked on the built artifact, not in prose.
     4	
     5	- §1.2: the input proof runs through both real entry points in order, with an excluded control and a kept control.
     6	- §1.5 E: the judge's cutoff for each invocation, proved on a trailing day with no articles.
     7	- §1.5 C: the 12,000-call bound, the shared-ledger reservations, and the stop gate kept on every attempt.
     8	- §1.5 D: the astra check at the transport on every request, retries included (`ladder_step.py:378` appends the refusal note), with a
     9	  refused-then-retried case in the test and the dry run.
    10	- §1.5 F:
    11	  - the card's "neutral form" against "as its request shows it": a blind reader must not be able to tell the systems apart from the form alone;
    12	  - Deck 1's output must reproduce under the generalised `council_mark.py`.
    13	- §1.6: D431 "as they stood at 07-14". Prove both systems' state at 07-14 can be read from the stored outputs, or snapshot it during the run.
    14	- §1.4:
    15	  - the guardrail shares pool the three draws;
    16	  - a library under 35 questions is read whole;
    17	  - the "median of running siblings" when a sibling has stopped.
    18	- §1.7: the request-size check on stored data; the figure is reported, never a stop.
    19	- §6: completed-article and completed-day counts come from SQLite online-backup snapshots, never the live file.
    20	- D666's record describes one $250 ledger. The decision recording the six-ledger replacement is appended to the log, and D666's index row is marked
    21	  as superseded on that point. The log is never edited (AGENTS §11).
    22	- §1.4: the "tell the systems apart from the form alone" test covers the mapping view as well as the cards.
