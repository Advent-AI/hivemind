    40	
    41	def unreadable_transport(calls):
    42	    """Answers every request with text that is not JSON, so the ladder step refuses the first answer and sends again with its note."""
    43	    def transport(provider, request):
    44	        calls.append(request)
    45	        return {'choices': [{'message': {'content': 'not json'}}], 'usage': {'prompt_tokens': 1000, 'completion_tokens': 10}}
    46	    return transport
    47	
    48	
    49	def test_every_request_first_send_and_resend_reaches_the_transport_as_astra_and_checked(astra, tmp_path):
    50	    """§1.5 D: every request, the resend with the refusal note included, is the checked astra request."""
    51	    wrapper, stage_a, luna, setting, research_list, cases = astra
    52	    calls = []
    53	    written, limit, jobs = stage_a.run([cases['u1/clean-3']], [1], tmp_path / 'run', 20.00, research_list=research_list,
    54	                                       texts=stage_a.request_texts(), transport=unreadable_transport(calls))
    55	    assert not limit.stopped and len(written) == jobs == 1
    56	    assert len(calls) == 2 and all(request['model'] == 'gpt-6-astra' for request in calls)
    57	    assert calls[1]['messages'][1]['content'].startswith(calls[0]['messages'][1]['content'])
    58	    assert len(calls[1]['messages'][1]['content']) > len(calls[0]['messages'][1]['content'])       # the refusal note
    59	    for request in calls:                                    # each is the frozen luna request with only the model string changed
    60	        luna_request = dict(request, model='gpt-6-luna')
    61	        assert json.dumps(request) == json.dumps(luna_request).replace('"model": "gpt-6-luna"', '"model": "gpt-6-astra"')
    62	
    63	
    64	def test_a_request_differing_beyond_the_model_is_refused_before_any_send(astra, tmp_path, monkeypatch):
    65	    """§1.5 D: an astra request that is not the frozen request with only its model changed is never sent."""
    66	    wrapper, stage_a, luna, setting, research_list, cases = astra
    67	    original = stage_a.model.build_request
    68	
    69	    def drifting(setting_given, *args):
    70	        request = original(setting_given, *args)
    71	        if setting_given.model == 'gpt-6-astra':
    72	            request['temperature'] = 0
    73	        return request
    74	    monkeypatch.setattr(stage_a.model, 'build_request', drifting)
    75	    calls = []
