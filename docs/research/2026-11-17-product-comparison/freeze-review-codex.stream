   449	def test_the_given_items_limits_and_judge_end_day_reach_every_component(setup, tmp_path):
   450	    """§1.2 A, §1.5 C and E: both systems read the given items database, Step 1 gets the given limits, the judge walks to the given day."""
   451	    ledger, draw, root = setup
   452	    options = comparison_options(tmp_path)
   453	    components = Components(ledger)
