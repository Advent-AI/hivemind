    40	class StageALimit(budget.Budget):
    41	    """The adapter's spending limit (the same reserve, charge and retries) with two additions inside the locked step it takes
    42	    before every send, a transport retry included: the stop flag is read, and the ledger's reserve line is written. A send
    43	    either took its reserve before the flag was set, and then runs, finishes and is charged, or it never begins."""
    44	
    45	    def __init__(self, cap_usd, ledger_path, attempt=None, sleep=time.sleep, shared=None):
    46	        super().__init__(cap_usd, attempt=attempt, sleep=sleep)
    47	        self.ledger_path = Path(ledger_path)
    48	        self.shared = shared            # a run's shared ledger (WIRING-DESIGN.md §B2, D448): reserved and settled inside each attempt
    49	        self.stopped = False
    50	        self.stop_reason = None
    51	
    52	    def stop(self, reason):
    53	        """Set the stop flag, once; no send begins after it. With a shared ledger, the run stops too (every Stage A stop is final)."""
    54	        with self.lock:
    55	            if not self.stopped:
    56	                self.stopped, self.stop_reason = True, reason
    57	        if self.shared is not None:
    58	            self.shared.stop(f'the ladder step: {reason}')
    59	
    60	    def _write_line(self, line):
    61	        """One whole JSON object a line, flushed and synced; called under the lock, so lines never interleave."""
    62	        with self.ledger_path.open('a') as handle:
    63	            handle.write(json.dumps(line) + '\n')
    64	            handle.flush()
    65	            os.fsync(handle.fileno())
    66	
    67	    def send_labelled(self, label, provider, request):
    68	        """Send one request; `label` names the case, the pass and the request (1, or 2 for the resend)."""
    69	        reserve = budget.worst_cost(request)
    70	        for attempt_number in range(budget.ATTEMPTS):
    71	            attempt_id = f'{label}|{attempt_number + 1}'
    72	            with self.lock:
    73	                if self.stopped:
    74	                    raise Stopped(self.stop_reason)
    75	                if self.spent_usd + self.reserved_usd + reserve > self.cap_usd:
    76	                    self.stopped, self.stop_reason = True, 'the spending cap'
    77	                    if self.shared is not None:
    78	                        self.shared.stop('the ladder step: its local spending cap')
    79	                    raise budget.OverBudget(f'spent ${self.spent_usd:.4f}, ${self.reserved_usd:.4f} in flight; '
    80	                                            f'${reserve:.4f} more would pass the ${self.cap_usd:.2f} cap')
    81	                shared_reserve = self.shared.estimate(request) if self.shared is not None else None
    82	                if self.shared is not None and not self.shared.reserve(shared_reserve):
    83	                    self.stopped, self.stop_reason = True, 'the shared ledger'
    84	                    raise budget.OverBudget('the shared ledger refused the reservation')
    85	                self.reserved_usd += reserve
    86	                self._write_line({'attempt': attempt_id, 'reserve': reserve})
    87	            response, failure = None, None
    88	            try:
    89	                response = self.attempt(provider, request)
    90	            except model.TransportError as error:
    91	                failure = error
    92	            finally:
    93	                with self.lock:
    94	                    self.reserved_usd -= reserve
    95	                    charged = budget.cost(request, response) if response is not None else None
    96	                    self.spent_usd += reserve if charged is None else charged
    97	                    self._write_line({'attempt': attempt_id, 'charge': reserve if charged is None else charged, 'known': charged is not None})
    98	                    if self.shared is not None:
    99	                        self.shared.settle(shared_reserve, charged)       # the ledger settles a missing or zero charge at its reservation
   100	            if response is not None:
