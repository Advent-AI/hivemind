    43	
    44	HERE = Path(__file__).resolve().parent
    45	ROOT = HERE.parents[1]
    46	STEP4 = ROOT / 'clean-arch/step4-2026-11-10'
    47	STAGE2 = ROOT / 'clean-arch/e2e-2026-11-09'
    48	ITEMS = ROOT / 'poc/data/items-nvda-2026-07-01-10-27.sqlite'
    49	FROM_DAY, LAST_DAY = '2026-07-01', '2026-07-14'
    50	CLEAN = ('step1', 'step2', 'cases', 'ladder', 'judge')
    51	PROD = ('prod',)
    52	REDO_ALLOWED = {'step1', 'step2', 'prod'}                          # design §D's table: the ladder and the judge have no outer redo
    53	LADDER_CONFIGURATION = 'clean-ladder-stage-a d3b4a5f696c7cc82'       # run 4's, the configuration D426 froze
    54	ASTRA_WRAPPER = ROOT / 'docs/research/2026-11-17-product-comparison/stage0/stage_a_astra.py'   # D667: the frozen request on gpt-6-astra
    55	LADDER_CONFIGURATIONS = {'frozen': LADDER_CONFIGURATION,
    56	                         'astra-frozen': 'clean-ladder-stage-a 14d0e269c8fe0335'}   # stage_a_astra.configuration_checksum
    57	CREDENTIALS = Path.home() / '.config/hivemind/credentials.json'
