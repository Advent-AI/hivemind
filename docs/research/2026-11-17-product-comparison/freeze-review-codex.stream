     1	"""How the ladder step reaches the model: production's `model.call`, through the spending limit it is given, with the answer's own
     2	text kept as it arrives (DESIGN.md §5.3, checks 4 and 8).
     3	
     4	`model.call` parses an answer with `json.loads`, which turns numbers into floats, and raises before it archives anything on an
     5	answer it cannot read. So the transport passed to it is wrapped: the wrapper sends through the limit, which charges the response's
     6	own token counts, and keeps the text of `choices[0].message.content` for the step's exact parse.
     7	"""
     8	
     9	
    10	def model_caller(model, archive, call_config, setting, limit, purpose='clean-ladder'):
    11	    """A `call_model(system_text, user_text, schema)` for `ladder_step.ladder_for_thesis`. `model` is production's model module,
    12	    `limit` an object whose `send(provider, request)` sends one request under the spending cap."""
    13	
    14	    def call_model(system_text, user_text, schema):
    15	        received = {}
    16	
    17	        def transport(provider, request):
    18	            response = limit.send(provider, request)
    19	            received['response'] = True
    20	            try:
    21	                received['text'] = response['choices'][0]['message']['content']
    22	            except (KeyError, IndexError, TypeError):
    23	                received['text'] = None
    24	            usage = response.get('usage') if isinstance(response, dict) else None
    25	            received['usage'] = usage if isinstance(usage, dict) else {}
    26	            return response
    27	
    28	        request = model.build_request(setting, system_text, user_text, schema, 'clean_ladder', call_config.provider)
    29	        result = {'answer_text': None, 'input_tokens': None, 'output_tokens': None, 'cached': False, 'error': None,
    30	                  'request_sha256': model.request_identity(request)[1]}
    31	        try:
    32	            answer = model.call(archive, call_config, setting, system_text, user_text, schema, 'clean_ladder', purpose, transport=transport)
    33	            result['cached'] = answer.cached
    34	        except model.SchemaError as error:
    35	            result['error'] = f'the answer does not fit the schema: {error}'
    36	        except (ValueError, RecursionError) as error:
    37	            if not received.get('response'):
    38	                raise                                    # no response arrived: not an answer's fault
    39	            result['error'] = f'the answer could not be read: {type(error).__name__}'
    40	        result['answer_text'] = received.get('text')
    41	        result['input_tokens'] = received.get('usage', {}).get('prompt_tokens')
    42	        result['output_tokens'] = received.get('usage', {}).get('completion_tokens')
    43	        return result
    44	
    45	    return call_model

