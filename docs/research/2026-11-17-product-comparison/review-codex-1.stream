   108	def ledger_cost(request, response, estimated):
   109	    """A response's cost at the published rates (`model.PRICES`), every input token at the full input rate; its reservation when the
   110	    usage is missing or not whole token counts."""
   111	    usage = response.get('usage') if isinstance(response, dict) else None
   112	    tokens_in = usage.get('prompt_tokens') if isinstance(usage, dict) else None
   113	    tokens_out = usage.get('completion_tokens') if isinstance(usage, dict) else None
   114	    if not all(isinstance(n, int) and not isinstance(n, bool) and n >= 0 for n in (tokens_in, tokens_out)) or request.get('model') not in model.PRICES:
   115	        return estimated
   116	    price_in, price_out = model.PRICES[request['model']]
   117	    return (tokens_in * price_in + tokens_out * price_out) / 1_000_000
