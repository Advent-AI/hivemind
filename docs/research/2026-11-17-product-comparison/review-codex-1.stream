    18	def feed(conn, from_day, until_day):
    19	    """Yield items with from_day <= publication_day <= until_day in processing order."""
    20	    rows = conn.execute(
    21	        "select * from items where publication_day >= ? and publication_day <= ? and (feed = 1 or copy_of is not null) "
    22	        "order by publication_day, case klass when '公司材料' then 0 when '官方材料' then 1 else 2 end, "
    23	        "coalesce(published_at, ''), rowid", (from_day, until_day))
    24	    for row in rows:
    25	        yield item_of(row)
    26	
    27	
    28	def item_of(row):
    29	    """A stored row as the item the pipeline reads: its object identifiers parsed."""
    30	    item = dict(row)
    31	    item['object_identifiers'] = json.loads(item.get('object_identifiers') or '[]')
    32	    return item
    33	
    34	
    35	def count(conn, from_day, until_day):
    36	    return conn.execute("select count(*) from items where publication_day >= ? and publication_day <= ? and feed = 1", (from_day, until_day)).fetchone()[0]
