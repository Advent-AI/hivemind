   100	def frozen_unseeded_changed(listing=ROOT / 'clean-arch/unseeded-2026-11-10/unseeded-frozen.sha256'):
   101	    """The files of the unseeded freeze whose sha256 differs from the listing (paths relative to the listing's folder)."""
   102	    changed = []
   103	    for line in listing.read_text().splitlines():
   104	        digest, name = line.split(maxsplit=1)
   105	        path = listing.parent / name.strip()
   106	        if not path.exists() or hashlib.sha256(path.read_bytes()).hexdigest() != digest:
   107	            changed.append(name.strip())
   108	    return changed
   109	
