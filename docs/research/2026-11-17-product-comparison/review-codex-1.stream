     1	"""Lean step 2, input check ($0): the items each system would read for 2026-09-22..28, through each system's own entry. Production: the
     2	replay's own loop (`testdb.feed` per day, `--only NVDA`, `dispatch.route` on an empty store; only items routed to extraction are read). Clean:
     3	the runner's own selection rule (`runner.selected_items` refuses any item outside it). The two lists must be the same items in the same order,
     4	with the same text identity (sha256 of the stored text), or nothing is written. Writes the clean manifest from the production list.
     5	
     6	  python3 fresh_week_inputs.py <manifest output path>
     7	"""
     8	import datetime
     9	import hashlib
    10	import json
    11	import sqlite3
    12	import sys
    13	import tempfile
    14	from pathlib import Path
    15	
    16	ROOT = Path('/Users/lchingen/hivemind')
    17	sys.path[:0] = [str(ROOT / 'src'), str(ROOT / 'clean-arch/step1')]
    18	from hivemind import config, dispatch, testdb, universe  # noqa: E402
    19	from hivemind.views import store  # noqa: E402
    20	import runner  # noqa: E402
    21	
    22	ITEMS = ROOT / 'poc/data/items-nvda-2026-07-01-10-27.sqlite'
    23	FROM, UNTIL = '2026-09-22', '2026-09-28'
    24	
    25	
    26	def production_list():
    27	    items_db = testdb.open_db(str(ITEMS))
    28	    uni = universe.load(str(ROOT / 'poc/universe.json'))
    29	    out = []
    30	    with tempfile.TemporaryDirectory() as folder:
    31	        conn = store.open_db(str(Path(folder) / 'views.sqlite'))
    32	        day = datetime.date.fromisoformat(FROM)
    33	        while day.isoformat() <= UNTIL:
    34	            for item in testdb.feed(items_db, day.isoformat(), day.isoformat()):
    35	                if not any(o['value'] in ('NVDA',) for o in item['object_identifiers']):
    36	                    continue
    37	                if dispatch.route(conn, item, uni).kind == 'extract':
    38	                    out.append(item['input_id'])
    39	            day += datetime.timedelta(days=1)
    40	    return out
    41	
    42	
    43	def main():
    44	    prod = production_list()
    45	    manifest = {'entity': 'NVDA', 'from_day': FROM, 'until_day': UNTIL, 'item_limit': len(prod), 'item_ids': prod}
    46	    clean_items = runner.selected_items(ITEMS, manifest)                    # refuses any item outside the clean selection rule
    47	    conn = sqlite3.connect(f'file:{ITEMS}?mode=ro', uri=True)
    48	    rule = [r[0] for r in conn.execute(
    49	        "select input_id, object_identifiers, text, feed, copy_of, supersedes from items where publication_day between ? and ? order by publication_day",
    50	        (FROM, UNTIL)) if 'NVDA' in [x.get('value') for x in json.loads(r[1] or '[]') if x.get('kind') == 'ticker']
    51	        and r[2] and r[3] == 1 and not r[4] and not r[5]]
    52	    if sorted(rule) != sorted(prod):
    53	        raise SystemExit(f'the two entries differ: production {len(prod)}, the clean rule {len(rule)}; '
    54	                         f'only production {sorted(set(prod) - set(rule))[:5]}; only clean {sorted(set(rule) - set(prod))[:5]}')
    55	    identity = hashlib.sha256('\n'.join(f"{i['input_id']}:{hashlib.sha256((i['text'] or '').encode()).hexdigest()}" for i in clean_items).encode()).hexdigest()
    56	    Path(sys.argv[1]).write_text(json.dumps(manifest, indent=1) + '\n')
    57	    print(f'{len(prod)} items, the same set and order through both entries; text identity {identity[:16]}; manifest written')
    58	
    59	
    60	if __name__ == '__main__':
    61	    main()
