   111	def preconditions(kind, run_check=check, log_path=None):
   112	    """The checks the old launcher made, plus the frozen production configuration; a failure starts nothing."""
   113	    failures = []
   114	    if not CREDENTIALS.exists():                                       # its existence only; never read here
   115	        failures.append('the credentials file is missing')
   116	    changed = frozen_unseeded_changed()
   117	    if changed:
   118	        failures.append(f'a frozen unseeded file changed: {changed}')
   119	    checks = [([sys.executable, '-m', 'pytest', '-q', '-p', 'no:cacheprovider', ROOT / 'tests/test_frozen_clean_step2.py'], 'a frozen Step 2 file changed')]
   120	    if kind == 'clean':
   121	        checks.append(([sys.executable, '-m', 'pytest', '-q', '-p', 'no:cacheprovider', ROOT / 'clean-arch/step1/test_runner.py', '-k', 'adopted_c8'],
   122	                       'the PRD request is not c8'))
   123	    for argv, failure in checks:
   124	        if run_check(argv, log_path) != 0:
   125	            failures.append(failure)
   126	    if kind == 'prod' and hashlib.sha256(PROD_CONFIG.read_bytes()).hexdigest() != PROD_CONFIG_SHA256:
   127	        failures.append('poc-v118.json is not the configuration q1–q3 ran')
   128	    return failures
   129	
   130	
   131	def manifest_until(until_day, manifest_path=None):
   132	    """The run's manifest (the full run's 243 items, or the one given) cut to the items published on or before `until_day`, in the same order."""
   133	    manifest = json.loads(Path(manifest_path or STAGE2 / 'stage2-manifest.json').read_text())
   134	    if until_day == manifest['until_day']:
   135	        return manifest
   136	    conn = sqlite3.connect(f'file:{ITEMS}?mode=ro', uri=True)
   137	    try:
   138	        day_of = {item_id: conn.execute('select publication_day from items where input_id=?', (item_id,)).fetchone()[0]
   139	                  for item_id in manifest['item_ids']}
   140	    finally:
   141	        conn.close()
   142	    kept = [item_id for item_id in manifest['item_ids'] if day_of[item_id] <= until_day]
   143	    if not kept:
   144	        raise SystemExit(f'no item on or before {until_day}')
   145	    return dict(manifest, until_day=until_day, item_limit=len(kept), item_ids=kept)
   146	
   147	
   148	class Draw:
   149	    def __init__(self, kind, root, label, ledger_path, options, run_component=execute, run_check=check):
   150	        self.kind, self.label, self.options = kind, label, dict(options)
   151	        self.folder = Path(root) / label
   152	        self.ledger_path = Path(ledger_path).resolve()
   153	        self.ledger = budget_replay.SharedLedger(self.ledger_path)
   154	        self.run_component, self.run_check = run_component, run_check
   155	        self.record_path = self.folder / 'run.json'
   156	        self.lock_path = self.folder / 'launch.lock'
   157	        self.child = None
   158	
   159	    # the record
   160	    def identity(self):
   161	        return {'kind': self.kind, 'label': self.label, 'ledger': str(self.ledger_path), 'options': dict(self.options)}
   162	
   163	    def load(self):
   164	        if self.record_path.exists():
   165	            return json.loads(self.record_path.read_text())
   166	        return {'identity': self.identity(), 'state': 'running', 'components': {}}
   167	
   168	    def save(self, record):
   169	        temporary = self.record_path.with_suffix('.tmp')
   170	        temporary.write_text(json.dumps(record, indent=1) + '\n')
   171	        os.replace(temporary, self.record_path)
   172	
   173	    def stop_run(self, record, reason):
   174	        """A stop of the whole run: on the shared ledger first (every other draw stops at its next send), then here."""
   175	        self.ledger.stop(f'{self.label}: {reason}')
   176	        record['state'], record['stopped'] = 'stopped', reason
   177	        self.save(record)
   178	        return record
   179	
   180	    # one launch
   181	    def launch(self, redo=None, redo_reason=None):
   182	        if redo is not None and not (redo_reason or '').strip():
   183	            raise SystemExit('--redo needs --redo-reason: what in the component\'s output shows an eligible failure')
   184	        self.folder.mkdir(parents=True, exist_ok=True)
   185	        with open(self.lock_path, 'w') as lock:
   186	            if not self.ledger.claim_launcher(self.label, lock):    # the probe, this lock and the registration in one ledger-locked step
   187	                raise SystemExit(f'another launch of {self.label} is running')
   188	            handlers = {}
   189	
   190	            def interrupted(signal_number, frame):
   191	                raise Interrupted(signal.Signals(signal_number).name)
   192	            for signal_number in (signal.SIGTERM, signal.SIGINT):
   193	                handlers[signal_number] = signal.signal(signal_number, interrupted)
   194	            self.working = False
   195	            try:
   196	                return self._launch(redo, redo_reason)
   197	            finally:
   198	                self.close(handlers)
   199	
   200	    def close(self, handlers):
   201	        """Fail closed (council mo, D449). An abnormal exit is any exit of a launch that began work (past its refusals) other than a
   202	        normal return, or any exit that leaves an attempt `started` in the record on disk; its first write is the shared stop, before
   203	        the child is ended and the record marked. The registration is removed only after a normal end, a refusal before any work, or
   204	        that stop; any other exit (a stop that cannot be written, an error while reading the record) leaves it, so the gate stops the
   205	        run once this process's lock is released. Further signals are ignored while closing."""
   206	        for signal_number in handlers:
   207	            signal.signal(signal_number, signal.SIG_IGN)
   208	        try:
   209	            in_flight = sys.exc_info()[1]
   210	            started = self.started_attempt()
   211	            if started is not None or (in_flight is not None and self.working):
   212	                reason = (f'the launcher ended abnormally ({type(in_flight).__name__}: {str(in_flight)[:200]})' if in_flight is not None
   213	                          else 'the launcher ended with an attempt still started')
   214	                self.ledger.stop(f'{self.label}: {started or "between components"}: {reason}')   # the first write
   215	                self.end_child()
   216	                self.mark_crashed(reason)
   217	            self.ledger.remove_launcher(self.label)
   218	        finally:
   219	            for signal_number, handler in handlers.items():
   220	                signal.signal(signal_number, handler)
   221	
   222	    def started_attempt(self):
   223	        """The component whose last attempt the record on disk holds as `started`, or None."""
   224	        record = self.load()
   225	        return next((component for component, entry in record['components'].items()
   226	                     if entry['attempts'] and entry['attempts'][-1]['state'] == 'started'), None)
   227	
   228	    def mark_crashed(self, reason):
   229	        """The attempt left `started`, if any, becomes `crashed`; the draw is stopped either way."""
   230	        record = self.load()
   231	        record['state'], record['stopped'] = 'stopped', f'the launcher crashed: {reason}'
   232	        for component, entry in record['components'].items():
   233	            if entry['attempts'] and entry['attempts'][-1]['state'] == 'started':
   234	                entry['attempts'][-1].update(state='crashed', reason=reason)
   235	                record['stopped'] = f'{component} crashed: {reason}'
   236	        self.save(record)
   237	
   238	    def _launch(self, redo, redo_reason):
   239	        record = self.load()
   240	        if record.get('identity') != self.identity():
   241	            raise SystemExit(f"{self.label} was first launched as {record.get('identity')}; this launch differs: refused")
   242	        for component, entry in record['components'].items():   # an attempt left started: its launcher died (a crash)
   243	            if entry['attempts'] and entry['attempts'][-1]['state'] == 'started':
   244	                entry['attempts'][-1].update(state='crashed', reason='found started at a later launch: its launcher died')
   245	                return self.stop_run(record, f'{component} crashed in {entry["attempts"][-1]["folder"]} (recorded; no redo)')
   246	        ledger_state = self.ledger.read()
   247	        if ledger_state.get('stopped'):
   248	            record.setdefault('refused launches', []).append(f"the run is stopped: {ledger_state.get('stop_reason')}")
   249	            self.save(record)
   250	            return record
   251	        if record['state'] in ('stopped', 'complete'):
   252	            return record
   253	        if record['state'] == 'awaiting a redo decision' and redo != record.get('awaiting'):
   254	            raise SystemExit(f"{self.label} awaits a redo decision on {record['awaiting']}: relaunch with --redo {record['awaiting']} "
   255	                             '--redo-reason <text> after reading its output')
   256	        failures = preconditions(self.kind, self.run_check, self.folder / 'preconditions.log')
   257	        if failures:
   258	            record.setdefault('refused launches', []).append('; '.join(failures))
   259	            self.save(record)
   260	            raise SystemExit('nothing started: ' + '; '.join(failures))
   261	        record['state'] = 'running'
   262	        record.pop('awaiting', None)
   263	        self.working = True                                # from here on, any exit but a normal return stops the run (close)
   264	        self.local_cap = ledger_state['ceiling']           # the shared ledger binds first: local reservations are smaller
   265	        for component in (CLEAN if self.kind == 'clean' else PROD):
   266	            entry = record['components'].setdefault(component, {'attempts': []})
   267	            if entry.get('state') in ('completed', 'skipped'):
   268	                continue
   269	            stopped = self.ledger.read()
   270	            if stopped.get('stopped'):                     # another draw, or a component of this one, stopped the run
   271	                record['state'], record['stopped'] = 'stopped', f"the shared ledger, before {component}: {stopped.get('stop_reason')}"
   272	                self.save(record)
   273	                return record
   274	            attempts = entry['attempts']
   275	            if attempts:                                   # the last attempt stopped: only an explicit redo goes on (a stopped redo has
   276	                # already stopped the run on the ledger, so a third attempt is refused above)
   277	                if redo != component or component not in REDO_ALLOWED:
   278	                    return self.stop_run(record, f'{component}: no redo allowed after {len(attempts)} attempt(s)')
   279	            folder_name = component if not attempts else f'{component}-redo'
   280	            if (self.folder / folder_name).exists():
   281	                attempts.append({'folder': folder_name, 'state': 'crashed', 'reason': 'its folder exists with no recorded attempt'})
   282	                return self.stop_run(record, f'{component}: {folder_name} exists with no recorded attempt')
   283	            attempts.append({'folder': folder_name, 'state': 'started', 'started at': now(), **({'redo reason': redo_reason} if attempts else {})})
   284	            self.save(record)
   285	            outcome, reason = getattr(self, f'_{component}')(record, self.folder / folder_name)   # any exception: `close` handles it
   286	            attempts[-1]['ended at'] = now()
   287	            if outcome == 'crashed':
   288	                attempts[-1].update(state='crashed', reason=reason)
   289	                return self.stop_run(record, f'{component} crashed: {reason}')
   290	            if outcome not in ('completed', 'skipped') and self.ledger.read().get('stopped'):
   291	                attempts[-1].update(state='stopped', reason=f"the shared ledger: {self.ledger.read().get('stop_reason')}")
   292	                record['state'], record['stopped'] = 'stopped', attempts[-1]['reason']
   293	                self.save(record)
   294	                return record
   295	            if outcome in ('completed', 'skipped'):
   296	                attempts[-1]['state'] = 'completed'
   297	                entry['state'], entry['folder'] = outcome, folder_name
   298	                if reason:
   299	                    entry['note'] = reason
   300	                self.save(record)
   301	                continue
   302	            attempts[-1].update(state='stopped', reason=reason)
   303	            if outcome == 'stopped' and component in REDO_ALLOWED and len(attempts) == 1:
   304	                record['state'], record['awaiting'] = 'awaiting a redo decision', component
   305	                self.save(record)
   306	                return record
   307	            return self.stop_run(record, f'{component}: {reason}')
   308	        record['state'] = 'complete'
   309	        self.save(record)
   310	        return record
   311	
   312	    def end_child(self):
   313	        if self.child is not None and self.child.poll() is None:
   314	            self.child.terminate()
   315	            try:
   316	                self.child.wait(timeout=10)
   317	            except subprocess.TimeoutExpired:
   318	                self.child.kill()
   319	                self.child.wait()
   320	
   321	    def done_folder(self, record, component):
   322	        return self.folder / record['components'][component]['folder']
   323	
   324	    def _call(self, argv, folder, record=None):
   325	        """Run a component; returns ('crashed', reason) for a signal exit, else (None, exit status)."""
   326	        def started(process):
   327	            self.child = process
   328	            if record is not None and getattr(process, 'pid', None):
   329	                attempt = next(entry['attempts'][-1] for entry in record['components'].values()
   330	                               if entry['attempts'] and entry['attempts'][-1]['state'] == 'started')
   331	                attempt['pid'] = process.pid                # for the operator and the proof; liveness is the launcher's lock
   332	                self.save(record)
   333	        status = self.run_component(argv, folder.parent / f'{folder.name}.log', started)
   334	        self.child = None
   335	        if status < 0:
   336	            return 'crashed', f'killed by signal {-status} (see {folder.name}.log)'
   337	        return None, status
   338	
   339	    # the components: each returns (outcome, reason); outcome 'completed', 'stopped' (a redo may follow), 'stopped-run' or 'crashed'
   340	    def _step1(self, record, folder):
   341	        folder.mkdir()
   342	        (folder / 'manifest.json').write_text(json.dumps(manifest_until(self.options['until_day'], self.options.get('manifest')), indent=1))
   343	        shutil.copy(ROOT / 'clean-arch/unseeded-2026-11-10/initial-empty.json', folder / 'initial.json')
   344	        shutil.copy(STAGE2 / 'stage2-settings.json', folder / 'settings.json')
   345	        shutil.copy(STAGE2 / 'stage2-limits.json', folder / 'limits.json')
   346	        crash, status = self._call([sys.executable, ROOT / 'clean-arch/step1/run_live.py', '--source', ITEMS, '--output', folder / 'trace.sqlite',
   347	                                    '--manifest', folder / 'manifest.json', '--initial', folder / 'initial.json', '--settings', folder / 'settings.json',
   348	                                    '--limits', folder / 'limits.json', '--shared-ledger', self.ledger_path], folder, record)
   349	        if crash:
   350	            return crash, status
   351	        return ('completed', None) if status == 0 else ('stopped', f'run_live exit {status}: the trace is not complete (see its log)')
   352	
   353	    def _step2(self, record, folder):
   354	        trace = self.done_folder(record, 'step1') / 'trace.sqlite'
   355	        crash, status = self._call([sys.executable, HERE / 'budget_step2.py', '--shared-ledger', self.ledger_path, trace, folder], folder, record)
   356	        if crash:
   357	            return crash, status
   358	        if status != 0:
   359	            return 'stopped', f'Step 2 exit {status}: refused, pending or unresolved links, or a failed call (see its log)'
   360	        stamp = '\n'.join(f'{hashlib.sha256(path.read_bytes()).hexdigest()}  {path}' for path in (trace, folder / 'library.json'))
   361	        (folder / 'inputs.sha256').write_text(stamp + '\n')
   362	        return 'completed', None
   363	
   364	    def _cases(self, record, folder):
   365	        folder.mkdir()
   366	        step1 = self.done_folder(record, 'step1')
   367	        crash, status = self._call([sys.executable, STEP4 / 'stage_a/build_cases.py', '--fresh', self.label, '--draws', step1, '--parts', 'trace.sqlite',
   368	                                    '--output', folder / 'cases.json'], folder, record)
   369	        if crash:
   370	            return crash, status
   371	        if status != 0:
   372	            return 'stopped-run', f'build_cases exit {status}: the cases do not match the opened theses (see its log)'
   373	        if not json.loads((folder / 'cases.json').read_text()):
   374	            for component in ('ladder', 'judge'):
   375	                record['components'][component] = {'attempts': [], 'state': 'skipped', 'note': 'the draw opened no thesis'}
   376	            return 'completed', 'no thesis opened: the ladder step and the judge have nothing to do'
   377	        return 'completed', None
   378	
   379	    def _ladder(self, record, folder):
   380	        cases = self.done_folder(record, 'cases') / 'cases.json'
   381	        crash, status = self._call([sys.executable, STEP4 / 'stage_a/stage_a.py', '--folder', folder, '--cap', self.local_cap,
   382	                                    '--passes', self.options['passes'], '--cases-file', cases, '--shared-ledger', self.ledger_path], folder, record)
   383	        if crash:
   384	            return crash, status
   385	        if status != 0:
   386	            return 'stopped-run', f'stage_a exit {status}: a pass is incomplete (see its log)'
   387	        conn = sqlite3.connect(f"file:{folder / 'send-1' / 'archive.sqlite'}?mode=ro", uri=True)
   388	        try:
   389	            found = conn.execute('select distinct config_version, config_checksum from model_calls').fetchall()
   390	        finally:
   391	            conn.close()
   392	        if [f'{version} {checksum}' for version, checksum in found] != [LADDER_CONFIGURATION]:
   393	            record['configuration mismatch'] = found
   394	            return 'stopped-run', f'the ladder ran {found}, not the frozen {LADDER_CONFIGURATION}'
   395	        return 'completed', None
   396	
   397	    def _judge(self, record, folder):
   398	        ladder = self.done_folder(record, 'ladder')
   399	        inputs = {self.label: {'trace': str(self.done_folder(record, 'step1') / 'trace.sqlite'), 'step2': str(self.done_folder(record, 'step2')),
   400	                               'ladders': str(ladder / 'send-1' / 'outcomes.jsonl'), 'ladder_archive': str(ladder / 'send-1' / 'archive.sqlite'),
   401	                               'cases': str(self.done_folder(record, 'cases') / 'cases.json'), 'output_root': str(folder)}}
   402	        inputs_path = self.folder / f'{folder.name}-inputs.json'
   403	        inputs_path.write_text(json.dumps(inputs, indent=1))
   404	        crash, status = self._call([sys.executable, STEP4 / 'stage_b/run_stage_b.py', '--root', folder, '--runs', self.label, '--inputs', inputs_path,
   405	                                    '--cap', self.local_cap, '--shared-ledger', self.ledger_path], folder, record)
   406	        if crash:
   407	            return crash, status
   408	        return ('completed', None) if status == 0 else ('stopped-run', f'run_stage_b exit {status}: the draw is incomplete after its own redo rule')
   409	
   410	    def _prod(self, record, folder):
   411	        folder.mkdir()
   412	        crash, status = self._call([sys.executable, HERE / 'budget_replay.py', '--ledger', self.ledger_path, '--from', self.options.get('from_day', FROM_DAY), '--until', self.options['until_day'],
   413	                                    '--views', folder / 'views.sqlite', '--archive', folder / 'archive.sqlite', '--config', PROD_CONFIG,
   414	                                    '--workers', 16], folder, record)
   415	        if crash:
   416	            return crash, status
   417	        if status != 0:
   418	            return 'stopped', f'budget_replay exit {status} (see its log)'
   419	        totals = [line for line in (folder / 'replay.log').read_text().splitlines() if line.startswith('totals: ')]
   420	        if len(totals) != 1:
   421	            return 'stopped', 'the replay wrote no totals line'
   422	        counts = ast.literal_eval(totals[0][len('totals: '):])
   423	        record['prod totals'] = counts
   424	        if counts.get('failed') or counts.get('not_processed'):
   425	            return 'stopped', f"{counts.get('failed')} failed and {counts.get('not_processed')} unprocessed items (see the log for transport failures)"
   426	        return 'completed', None
   427	
   428	
   429	def main(argv=None):
   430	    parser = argparse.ArgumentParser()
   431	    parser.add_argument('kind', choices=('clean', 'prod'))
   432	    parser.add_argument('--root', required=True)
   433	    parser.add_argument('--label', required=True)
   434	    parser.add_argument('--ledger', required=True)
   435	    parser.add_argument('--until-day', default=None)
   436	    parser.add_argument('--manifest', default=None)
   437	    parser.add_argument('--passes', type=int, default=3)
   438	    parser.add_argument('--redo', default=None)
   439	    parser.add_argument('--redo-reason', default=None)
   440	    arguments = parser.parse_args(argv)
   441	    if not Path(arguments.ledger).exists():
   442	        raise SystemExit('the shared ledger does not exist: it is created by a recorded decision (budget_replay.py --init-ledger)')
   443	    window = (FROM_DAY, LAST_DAY)
   444	    if arguments.manifest:
   445	        given = json.loads(Path(arguments.manifest).read_text())
   446	        window = (given['from_day'], given['until_day'])
   447	    until_day = arguments.until_day or window[1]
   448	    if not (window[0] <= until_day <= window[1]):
   449	        raise SystemExit(f'--until-day must lie in {window[0]}..{window[1]}')
   450	    options = {'until_day': until_day, 'passes': arguments.passes}
   451	    if arguments.manifest:
   452	        options.update(from_day=window[0], manifest=str(Path(arguments.manifest).resolve()))
   453	    record = Draw(arguments.kind, arguments.root, arguments.label, arguments.ledger, options).launch(arguments.redo, arguments.redo_reason)
   454	    print(json.dumps({k: v for k, v in record.items() if k != 'components'}, indent=1))
   455	    return 0 if record['state'] == 'complete' else 1
   456	
   457	
   458	if __name__ == '__main__':
   459	    sys.exit(main())

