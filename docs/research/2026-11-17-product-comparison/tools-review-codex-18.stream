    18	def base(n=20, new_served=0, old_served=0, guard_cards=12):
    19	    """N matters; the first `new_served` served by the new system in all draws, the next `old_served` by the old one; every draw has
    20	    `guard_cards` guardrail cards of each type, all supported and worth (no breach)."""
    21	    matters = [{'matter': f'M{i:02d}', 'company_figure': False} for i in range(1, n + 1)]
    22	    mapping = {d: {} for d in DRAWS}
    23	    cards = {d: {} for d in DRAWS}
    24	    for i, m in enumerate(matters):
    25	        for d in DRAWS:
    26	            system = d.split('-')[0]
    27	            served = (system == 'new' and i < new_served) or (system == 'old' and new_served <= i < new_served + old_served)
    28	            if served:
    29	                q = f'{d}-q{i}'
    30	                mapping[d][m['matter']] = [{'question': q, 'covers': True}]
    31	                cards[d][q] = {'worth': 'worth', 'answer': 'supported', 'type': 'figure', 'guardrail': False, 'covering': True, 'opened': None}
    32	    for d in DRAWS:
    33	        for t in ('figure', 'yes/no'):
    34	            for j in range(guard_cards):
    35	                cards[d][f'{d}-g-{t}-{j}'] = {'worth': 'worth', 'answer': 'supported', 'type': t, 'guardrail': True, 'covering': False,
    36	                                             'opened': None}
    37	    return {'matters': matters, 'matter_first_day': {m['matter']: '2026-09-07' for m in matters}, 'mapping': mapping, 'cards': cards,
    38	            'distinct': {d: {'ids': 40, 'duplicates_both': 0, 'duplicates_split': 0} for d in DRAWS},
    39	            'controls': {'plants': ['unsupported'] * 6, 'supported': ['supported'] * 4, 'repeats_same': [True] * 3},
    40	            'inputs': {}}
    41	
    42	
    43	def seal(r):
    44	    """The files a real reading is made from, written for these readings (temporary folder): the matter list (in place of the frozen one),
    45	    a passing eligibility check, the mapping file and the deck key, with the fingerprints mark_cards.readings records."""
    46	    folder = Path(tempfile.mkdtemp())
    47	    files = {'matters': {'matters': r['matters']}, 'eligibility': {'eligible': True}}
    48	    for name, data in files.items():
    49	        (folder / f'{name}.json').write_text(json.dumps(data))
    50	    sc.MATTERS = folder / 'matters.json'
    51	    eligibility_sha = hashlib.sha256((folder / 'eligibility.json').read_bytes()).hexdigest()
    52	    (folder / 'mapping.json').write_text(json.dumps({'mapping': r['mapping'], 'distinct': r['distinct'], 'eligibility_sha256': eligibility_sha}))
    53	    key = {f'C{n}': {'draw': d, 'question': q, 'role': 'product', **{f: r['cards'][d][q][f] for f in ('guardrail', 'covering', 'type')}}
    54	           for n, (d, q) in enumerate((d, q) for d in r['cards'] for q in r['cards'][d])}
    55	    (folder / 'deck-key.json').write_text(json.dumps(key))
    56	    sha = lambda name: hashlib.sha256((folder / name).read_bytes()).hexdigest()
    57	    r['inputs'] = {'matters_sha256': sha('matters.json'), 'mapping_path': str(folder / 'mapping.json'), 'mapping_sha256': sha('mapping.json'),
    58	                   'eligibility_path': str(folder / 'eligibility.json'), 'eligibility_sha256': eligibility_sha,
    59	                   'deck_key_path': str(folder / 'deck-key.json'), 'deck_key_sha256': sha('deck-key.json')}
    60	    return r
    61	
    62	
    63	def verdict(r):
    64	    """The scorer's entry point on readings sealed as a real reading is."""
    65	    return sc.verdict(seal(r))
