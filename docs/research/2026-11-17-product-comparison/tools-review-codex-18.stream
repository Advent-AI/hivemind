   445	def days_to_opening(readings):
   446	    """Per draw and covered matter: days from the matter's earliest listed article to the first covering question's opening. A question
   447	    opened before the scored window (09-07) is 'opened in the warm-up'; one opened in the window before the matter's first listed article
   448	    is 'opened before the first listed article'."""
   449	    import datetime
   450	    out = {}
   451	    for draw, by_matter in readings['mapping'].items():
   452	        for matter, questions in by_matter.items():
   453	            opened = [readings['cards'][draw][q['question']].get('opened') for q in questions if q['covers'] is True]
   454	            opened = [d for d in opened if d]
   455	            first = readings.get('matter_first_day', {}).get(matter)
   456	            if not opened or not first:
   457	                continue
   458	            days = (datetime.date.fromisoformat(min(opened)) - datetime.date.fromisoformat(first)).days
   459	            out.setdefault(matter, {})[draw] = (days if days >= 0 else 'opened in the warm-up' if min(opened) < '2026-09-07'
   460	                                                else 'opened before the first listed article')
   461	    return out
