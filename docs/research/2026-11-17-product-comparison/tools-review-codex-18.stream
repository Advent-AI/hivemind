import contextlib, copy, hashlib, io, json, pathlib, subprocess, types
import score_comparison as score
import test_score_comparison as tests
import mark_cards as writer
old = types.ModuleType(\"previous_score_comparison\")
old.__file__ = score.__file__
p = \"docs/research/2026-11-17-product-comparison/stage0/score_comparison.py\"
exec(compile(subprocess.check_output([\"git\",\"--no-pager\",\"show\",\"558b0230"'^:"+p],text=True),p,"exec"),old.__dict__)
class Mem:
    data={}
    def __init__(self,path): self.path=str(path)
    def __truediv__(self,child): return Mem(self.path+"/"+child)
    def __str__(self): return self.path
    def resolve(self): return self
    def exists(self): return self.path in self.data or self.path=="."
    @property
    def parent(self): return Mem(".")
    def read_bytes(self): return pathlib.Path(".").read_bytes() if self.path=="." else self.data[self.path]
    def read_text(self): return self.read_bytes().decode()
    def write_text(self,text): self.data[self.path]=text.encode()
def put(p,obj):
    path=Mem(p)
    path.write_text(json.dumps(obj))
    return hashlib.sha256(path.read_bytes()).hexdigest()
for m in old,score:
    m.Path,m.MATTERS=Mem,Mem("matters")
writer.Path=Mem
writer.KEY=Mem("key")
writer.mapping_tool.MATTERS=Mem("matters")
def produce(r):
    put("matters",{"matters":r["matters"]})
    es=put("map/eligibility.json",{"eligible":True})
    put("map/mapping.json",dict(mapping=r["mapping"],distinct=r["distinct"],eligibility_sha256=es))
    writer.matter_first_days=lambda: r["matter_first_day"]
    key={}
    def add(k,worth,answer):
        cid=f"C{len(key)+1:03d}"
        key[cid]=k
        for f in ("codex","claude"):
            put(f"deck/round-0/{cid}-{f}.json",dict(worth=worth,answer=answer,why="fixture"))
    for draw, cards in r["cards"].items():
        for q,c in cards.items():
            add(dict(role="product",draw=draw,question=q,answered=c["answer"]!="no answer",
                     **{f:c[f] for f in ("opened","guardrail","covering","type")}),c["worth"],c["answer"])
    product=next(iter(key.values()))
    for role,marks in (("plant",r["controls"]["plants"]),("supported control",r["controls"]["supported"])):
        for mark in marks:
            add(dict(product,role=role), "worth", mark)
    for same in r["controls"]["repeats_same"]:
        add(dict(product,role="repeat"), "worth" if same else "trivia",
            r["cards"][product["draw"]][product["question"]]["answer"])
    put("key",key)
    for n in range(3): Mem(f"deck/round-{n}.done").write_text("done")
    with contextlib.redirect_stdout(io.StringIO()):
        writer.readings("map","deck")
    return json.loads(Mem("deck/readings.json").read_text())
for n,a,b,invalid in ((32,10,2,False),(32,2,10,False),(32,5,4,False),(19,5,1,False),(32,5,1,True)):
    r=tests.base(n=n,new_served=a,old_served=b)
    if invalid: r["controls"]["plants"][0]="supported"
    q=produce(r)
    prior,after=old.verdict(q),score.verdict(q)
    assert json.dumps(prior,default=str)==json.dumps(after,default=str)
    print(after["verdict"],"writer output and report match parent")

r=tests.base(n=20,new_served=5,old_served=1,guard_cards=4)
r["cards"]["new-1"]["new-1-g-figure-0"]["answer"]="unsupported"
r["cards"]["new-1"]["new-1-g-figure-1"]["answer"]="unsupported"
r["cards"]["new-1"]["new-1-q0"]["opened"]="2026-09-09"
q=produce(r)
baseline=score.verdict(q)
print("Baseline",baseline["verdict"],baseline["beside"][score.DAYS_KEY])
for mode in ("answer","opened","day","directory"):
    v=copy.deepcopy(q)
    if mode=="answer": v["cards"]["new-1"]["new-1-g-figure-0"]["answer"]="no answer"
    elif mode=="opened": v["cards"]["new-1"]["new-1-q0"]["opened"]=None
    elif mode=="day": v["matter_first_day"]["M01"]="2026-09-08"
    else: v["inputs"]["mapping_path"]="."
    score.validate_readings(v)
    try:
        out=score.verdict(v)
        print(mode,out["verdict"],out["beside"][score.DAYS_KEY])
    except SystemExit as e: print(mode,e)

r=tests.base(n=20,new_served=5,old_served=1,guard_cards=4)
r["cards"]["new-3"]={}
r["mapping"]["new-3"]={}
r["distinct"]["new-3"]={"ids":0,"duplicates_both":0,"duplicates_split":0}
q=produce(r)
try: score.verdict(q)
except SystemExit as e: print("Writer output with one empty draw:",e)
