     1	"""Which of the scored window's articles were read (D669): every location the exposure census found is classed, and an article is kept
     2	only when none of its locations is a read.
     3	
     4	Not a read, and only these:
     5	1. **corpus storage:** the rows of any SQLite table named `items` (the corpus schema), anywhere, tar members included;
     6	2. **pool lists:** a file named `manifest.json` or `selection.json`, or a Step 1 trace's `run` table (the manifest a run was given);
     7	3. **code-only corpus census output:** a data file (.json, .jsonl, .txt, .csv, .log) outside any archive, whose own folder holds at least one
     8	   Python script, none of which calls a model, and holds no reader material (a `.stream`, `.html` or `.md` file, a `packet*` or `round*`
     9	   file, a `codex*` or `claude*` file, or a subfolder named packets, verdicts, readers or review*).
    10	
    11	Everything else is a read, including a file in a folder with no script to show what produced it.
    12	
    13	    python3 classify_reads.py <census.json> <output folder>
    14	"""
    15	import collections
    16	import datetime
    17	import hashlib
    18	import json
    19	import os
    20	import re
    21	import sqlite3
    22	import sys
    23	from pathlib import Path
    24	
    25	WINDOW = ('2026-09-07', '2026-09-20')
    26	SOURCE = '/Users/lchingen/hivemind/poc/data/items-nvda-2026-07-01-10-27.sqlite'
    27	MODEL_CALL = re.compile(r'model\.call|openai_transport|LiveTransport|codex exec|claude -p|model_caller|build_request|anthropic|/v1/chat')
    28	DATA_FILE = ('.json', '.jsonl', '.txt', '.csv', '.log')
    29	READER_FILE = re.compile(r'(\.stream$|\.html$|\.md$|^packet|^round|^codex|^claude)')
    30	READER_DIR = re.compile(r'^(packets|verdicts|readers|review.*)$')
    31	_folders = {}
    32	
    33	
    34	def folder_is_code_only(folder):
    35	    """A folder with at least one script, none calling a model, and no reader material."""
    36	    if folder in _folders:
    37	        return _folders[folder]
    38	    result = False
    39	    if os.path.isdir(folder):
    40	        names = os.listdir(folder)
    41	        scripts = [n for n in names if n.endswith('.py') and os.path.isfile(os.path.join(folder, n))]
    42	        reader = any(READER_FILE.search(n) for n in names) or any(READER_DIR.match(n) and os.path.isdir(os.path.join(folder, n)) for n in names)
    43	        calls = False
    44	        for name in scripts:
    45	            try:
    46	                if MODEL_CALL.search(Path(folder, name).read_text(errors='ignore')):
    47	                    calls = True
    48	                    break
    49	            except OSError:
    50	                calls = True
    51	        result = bool(scripts) and not calls and not reader
    52	    _folders[folder] = result
    53	    return result
    54	
    55	
    56	def classify(location):
    57	    """'storage', 'pool', 'code-only' or 'read'."""
    58	    inner = location.split('!')[-1]
    59	    in_archive = '!' in location
    60	    if '::' in inner:
    61	        table = inner.rsplit('::', 1)[1]
    62	        if table == 'items':
    63	            return 'storage'
    64	        if table == 'run':
    65	            return 'pool'
    66	        return 'read'
    67	    name = inner.rsplit('/', 1)[-1]
    68	    if name in ('manifest.json', 'selection.json'):
    69	        return 'pool'
    70	    if not in_archive and name.endswith(DATA_FILE) and folder_is_code_only(os.path.dirname(location)):
    71	        return 'code-only'
    72	    return 'read'
    73	
    74	
    75	def main(census_path, out_dir):
    76	    census = json.loads(Path(census_path).read_text())
    77	    conn = sqlite3.connect(f'file:{SOURCE}?mode=ro', uri=True)
    78	    day = dict(conn.execute('select input_id, publication_day from items where publication_day between ? and ?', WINDOW))
    79	    window_ids = set(census['kept_ids']) | set(census['hits'])
    80	    window_ids = {a for a in window_ids if a in day}
    81	    kept, reads_by_location, not_reads = [], collections.Counter(), collections.Counter()
    82	    for article in sorted(window_ids):
    83	        classes = [(location, classify(location)) for location in census['hits'].get(article, [])]
    84	        if not any(c == 'read' for _, c in classes):
    85	            kept.append(article)
    86	        for location, c in classes:
    87	            folder = location.split('::')[0]
    88	            (reads_by_location if c == 'read' else not_reads)[(c, folder)] += 1
    89	    week = lambda d: str(datetime.date.fromisoformat(d) - datetime.timedelta(days=datetime.date.fromisoformat(d).weekday()))
    90	    by_week = collections.Counter(week(day[a]) for a in kept)
    91	    population = collections.Counter(week(day[a]) for a in window_ids)
    92	    out = Path(out_dir)
    93	    out.mkdir(parents=True, exist_ok=True)
    94	    report = {'rule': __doc__.split('\n\n')[1], 'window': WINDOW, 'census_sha256': hashlib.sha256(Path(census_path).read_bytes()).hexdigest(),
    95	              'population': len(window_ids), 'population_by_week': dict(sorted(population.items())), 'kept': len(kept),
    96	              'kept_by_week': dict(sorted(by_week.items())), 'kept_ids': kept,
    97	              'not_read_locations': [{'class': c, 'location': f, 'articles': n} for (c, f), n in not_reads.most_common()],
    98	              'read_locations': [{'location': f, 'articles': n} for (c, f), n in reads_by_location.most_common()]}
    99	    text = json.dumps(report, indent=1, ensure_ascii=False) + '\n'
   100	    (out / 'reads.json').write_text(text)
   101	    print(json.dumps({k: report[k] for k in ('population', 'population_by_week', 'kept', 'kept_by_week')}, indent=1))
   102	    print('not-read locations by class:', collections.Counter(r['class'] for r in report['not_read_locations']))
   103	
   104	
   105	if __name__ == '__main__':
   106	    main(sys.argv[1], sys.argv[2])

