   118	    def run_one(job):
   119	        idx, draw, entry = job
   120	        item, arm, setting, system, user, schema, identity, wire_hash, shown, positive = entry
   121	        directory = out / f'{idx:02d}-{arm}-draw{draw}'
   122	        directory.mkdir()
   123	        (directory / 'intent.json').write_text(json.dumps({'request_identity': identity, 'wire_sha256': wire_hash, 'input_id': item['input_id'], 'draw': draw, 'arm': arm}) + '\n')
   124	        archive = model.Archive(str(directory / 'archive.sqlite'))
   125	        received = []
   126	        def fake(provider, request):
   127	            if digest(json.dumps(request).encode('utf-8')) != wire_hash:
   128	                raise ValueError('fake wire mismatch')
   129	            fact = {'id': 'e1', 'quote': positive, 'one_line': 'A source-backed statement.', 'speaker': 'Source',
   130	                    'original_who': '', 'original_day': '', 'tier': 'fact', 'event_time': '', 'links': [shown[0]['view_id']]}
   131	            return {'choices': [{'message': {'content': json.dumps({'evidence': [fact], 'candidates': [], 'new_groups': []})}}], 'usage': {'prompt_tokens': 0, 'completion_tokens': 0}}
   132	        def real(provider, request):
   133	            if digest(json.dumps(request).encode('utf-8')) != wire_hash:
   134	                raise ValueError('real wire mismatch')
   135	            response = model.openai_transport(provider, request)
   136	            received.append(response)
   137	            (directory / 'response.json').write_text(json.dumps(response, ensure_ascii=False) + '\n')
   138	            return response
   139	        try:
   140	            answer = model.call(archive, cfg, setting, system, user, schema, 'extraction', 'extract', transport=fake if mode == '--fake' else real)
   141	            if answer.cached or answer.request_sha256 != identity:
   142	                raise ValueError('cache or request mismatch')
   143	            evidence, candidates, dropped, groups = extraction.sift_with_groups(answer.data, item, item['text'], {v['view_id'] for v in shown}, uni)
   144	            handover = extraction.file_reading(extraction.Reading(evidence, candidates, dropped, groups, answer, setting.prompt_version.rpartition('-')[2]), item, shown)
   145	            if mode == '--fake' and len(handover.evidence) != 1:
   146	                raise ValueError('source-backed existing-question link did not survive handover')
   147	            result = {'status': 'ok', 'answer': answer.data, 'sift': {'evidence': evidence, 'candidates': candidates, 'dropped': dropped, 'new_groups': groups},
   148	                      'handover': {'evidence': handover.evidence, 'candidates': handover.candidates, 'dropped': handover.dropped, 'new_groups': handover.new_groups},
   149	                      'input_tokens': answer.input_tokens, 'output_tokens': answer.output_tokens,
   150	                      'known_final_response_cost_usd': answer.cost_usd if received and received[0].get('usage') else None,
   151	                      'earlier_retry_cost': 'unknown; production transport may retry'}
   152	        except Exception as error:
   153	            result = {'status': 'failed_or_unknown', 'error': repr(error)[:500],
   154	                      'raw_usage': received[0].get('usage') if received else None, 'cost': 'unknown; inspect raw usage and retries'}
   155	        (directory / 'result.json').write_text(json.dumps(result, ensure_ascii=False, indent=2) + '\n')
   156	        archive.conn.close()
   157	        return {'directory': directory.name, 'status': result['status']}
   158	    jobs = [(idx, int(sys.argv[3]), entry) for idx, entry in enumerate(requests)]
   159	    with concurrent.futures.ThreadPoolExecutor(max_workers=8) as pool:
   160	        completed = list(pool.map(run_one, jobs))
   161	    (out / 'complete.json').write_text(json.dumps(completed, ensure_ascii=False, indent=2) + '\n')
   162	    print(json.dumps({'mode': mode, 'planned': len(jobs), 'ok': sum(x['status'] == 'ok' for x in completed), 'failed_or_unknown': sum(x['status'] != 'ok' for x in completed)}))
