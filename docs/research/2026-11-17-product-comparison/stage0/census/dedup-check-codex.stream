   282	
   283	DEDUP = """# Group the entries that are one underlying bet (read-only)
   284	
   285	You are a senior hedge-fund analyst covering NVIDIA. Below is a numbered list of matters two readers listed from news of 2026-09-07 to
   286	09-20. Some entries are the same bet written differently. Group them by the signed standard's rule (D248):
   287	- wordings, deadlines, milestones and periods of one bet are one question;
   288	- another year of a figure is another matter;
   289	- two entries stay apart only when their answers can move apart and an analyst would bet on each separately.
   290	
   291	Write one JSON object per line, and nothing else: {{"group": [entry numbers that are one bet], "why": "<= 25 words"}} for every group of two or
   292	more entries. Entries you do not name stand alone.
   293	
   294	## The entries
   295	
   296	{entries}
   297	"""
   298	
   299	
   300	def dedup():
   301	    entries = json.loads((HERE / 'matters-entries.json').read_text())['matters']
   302	    listing = '\n'.join(f"{i}. {m['name']} | e.g. {m.get('example_question') or ''}" for i, m in enumerate(entries, 1))
   303	    prompt = DEDUP.format(entries=listing)
   304	    edges = {}
   305	    for family in FAMILIES:
   306	        out = HERE / 'dedup' / f'{family}.jsonl'
   307	        if not out.exists():
   308	            answer, void = closed(family, prompt, lambda a: None if json_lines(a) or a.strip() else 'empty')
   309	            if void:
   310	                raise SystemExit(f'{family} dedup void twice: {void}')
   311	            out.parent.mkdir(exist_ok=True)
   312	            out.write_text(answer)
   313	        pairs = set()
   314	        for row in json_lines(out.read_text()):
   315	            members = sorted({int(n) for n in row.get('group', []) if str(n).isdigit() and 1 <= int(n) <= len(entries)})
   316	            pairs |= {(a, b) for a in members for b in members if a < b}
   317	        edges[family] = pairs
   318	    agreed, either = edges['codex'] & edges['claude'], edges['codex'] | edges['claude']
   319	
   320	    def components(pairs):
   321	        parent = list(range(len(entries) + 1))
   322	        def root(i):
   323	            while parent[i] != i:
   324	                parent[i] = parent[parent[i]]
   325	                i = parent[i]
   326	            return i
   327	        for a, b in pairs:
   328	            parent[root(a)] = root(b)
   329	        groups = {}
   330	        for i in range(1, len(entries) + 1):
   331	            groups.setdefault(root(i), []).append(i)
   332	        return sorted(groups.values())
   333	    final_groups, agreed_groups = components(either), components(agreed)
   334	    matters = []
   335	    for group in final_groups:
   336	        members = [entries[i - 1] for i in group]
   337	        flags = {m['company_figure'] for m in members}
   338	        matters.append({'entries': group, 'names': [m['name'] for m in members], 'listed_by': sorted({m['listed_by'] for m in members}),
   339	                        'articles': sorted({a for m in members for a in m.get('articles', [])}, key=lambda a: int(a) if str(a).isdigit() else 0),
   340	                        'first_day': min([m['first_day'] for m in members if m.get('first_day')], default=None),
   341	                        'company_figure': flags == {True}, 'company_figure_mixed': len(flags) > 1,
   342	                        'merged_by': 'both' if all((a, b) in agreed for a in group for b in group if a < b) else ('one reader' if len(group) > 1 else '')})
   343	    doc = {'frozen': 'stage 0, before any system output', 'entries_sha256': hashlib.sha256((HERE / 'matters-entries.json').read_bytes()).hexdigest(),
   344	           'rule': 'entries grouped by either family are one matter (no matter counted twice); the count under agreed groups only is reported',
   345	           'N': len(matters), 'N_agreed_groups_only': len(agreed_groups), 'company_figure_subgroup': sum(m['company_figure'] for m in matters),
   346	           'matters': matters}
   347	    text = json.dumps(doc, indent=1, ensure_ascii=False) + '\n'
   348	    (HERE / 'matters-final.json').write_text(text)
   349	    (HERE / 'matters-final.json.sha256').write_text(hashlib.sha256(text.encode()).hexdigest() + '  matters-final.json\n')
   350	    print(f"entries {len(entries)} -> N = {doc['N']} (agreed groups only: {doc['N_agreed_groups_only']}); company-figure {doc['company_figure_subgroup']}")
   351	    if doc['N'] < 20:
   352	        print('TOO SMALL: N < 20. Return to Alex before any paid send (D667, D668).')
   353	
   354	
   355	if __name__ == '__main__':
   356	    {'merge': merge, 'reconcile': reconcile, 'third': third, 'freeze': freeze, 'dedup': dedup}[sys.argv[1]]()
     1	# Council check of the matter list before it is frozen (read-only, $0)
     2	
     3	**Context:** the blind matter census of the release comparison (plan `../../RUN-PLAN-v10.md` §1.3; D668, D670) read the 410 kept articles.
     4	- Two families read them apart in 22 closed sessions. Each family merged its own lists, the two families were reconciled pair by pair, and
     5	  third readers judged the one-family matters.
