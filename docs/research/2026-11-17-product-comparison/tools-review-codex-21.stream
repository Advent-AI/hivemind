class Mem:
    files={}
    dirs=set()
    writes=[]
    def __init__(self,path): self.path=posixpath.normpath(str(path))
    def __truediv__(self,child): return Mem(self.path+"/"+child)
    def __str__(self): return self.path
    def __lt__(self,other): return self.path<other.path
    @property
    def name(self): return posixpath.basename(self.path)
    @property
    def parent(self): return Mem(posixpath.dirname(self.path))
    def resolve(self): return self
    def exists(self): return self.path in self.files or self.path in self.dirs
    def is_dir(self): return self.path in self.dirs
    def mkdir(self,parents=False,exist_ok=False):
        if self.is_dir() and not exist_ok: raise FileExistsError(self.path)
        self.dirs.add(self.path); self.writes.append(self.path)
    def read_bytes(self): return self.files[self.path]
    def read_text(self): return self.read_bytes().decode()
    def write_text(self,text):
        self.files[self.path]=text.encode(); self.writes.append(self.path)
    def glob(self,pattern):
        return [Mem(p) for p in list(self.files)+list(self.dirs) if posixpath.dirname(p)==self.path and fnmatch.fnmatch(posixpath.basename(p),pattern)]
def put(p,v): Mem(p).write_text(json.dumps(v))
def get(p): return json.loads(Mem(p).read_text())
def no_calls(*args): raise AssertionError("reader called")
def copy2(src,dst): dst.write_text(src.read_text())
def copytree(src,dst):
    dst.mkdir()
    for p in list(Mem.files):
        if p.startswith(str(src)+"/"): (dst / p[len(str(src))+1:]).write_text(Mem(p).read_text())
@contextlib.contextmanager
def scratch():
    Mem("/scratch").mkdir()
    try: yield "/scratch"
    finally:
        for p in list(Mem.files):
            if p.startswith("/scratch/"): del Mem.files[p]
        Mem.dirs={p for p in Mem.dirs if not (p=="/scratch" or p.startswith("/scratch/"))}
@contextlib.contextmanager
def mem_open(path,mode):
    assert mode=="a"
    buffer=io.StringIO()
    try: yield buffer
    finally:
        f=Mem(path)
        f.write_text((f.read_text() if f.exists() else "")+buffer.getvalue())
