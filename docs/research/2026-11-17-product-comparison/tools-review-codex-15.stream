   106	def store_paths(run_root, draw):
   107	    """The draw's store at its cutoff: refused unless the draw is complete (plan §1.4 item 10). The new system's judge folder is the one its
   108	    own record names as the completed attempt (`draw-<draw>` or, after D449's one redo, `draw-<draw>-redo`). None when the draw opened no
   109	    question (the launcher's `skipped` judge)."""
   110	    root = Path(run_root) / draw
   111	    record = json.loads((root / 'run.json').read_text())
   112	    if record.get('state') != 'complete':
   113	        raise SystemExit(f'refused: {draw} is {record.get("state")!r}, not complete; no release verdict without six complete draws')
   114	    if draw.startswith('new'):
   115	        judge = record['components']['judge']
   116	        if judge['state'] == 'skipped':
   117	            return None
   118	        inner = json.loads((root / judge['folder'] / 'run.json').read_text())[draw]
   119	        if inner.get('state') != 'complete':
   120	            raise SystemExit(f'refused: {draw} judge is {inner.get("state")!r}')
   121	        folder = root / judge['folder'] / inner['attempts'][-1]['folder']
   122	    else:
   123	        folder = root / record['components']['prod']['folder']
   124	    return folder / 'views.sqlite', folder / 'archive.sqlite'
