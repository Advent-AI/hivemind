    36	def material(request_json):
    37	    """The evidence items of a judge request (`judging._lines_english`): [{tier, speaker, original, input_id, day, summary, quote}]. The
    38	    evidence section runs from its header to the next bracketed section; an item runs to the next item, so a summary or quote with line
    39	    breaks is kept whole; the matcher notes after the quote are dropped."""
    40	    text = json.loads(request_json)['messages'][-1]['content']
    41	    start = text.find('[Evidence in view under this thesis')
    42	    if start < 0:
    43	        return []
    44	    section = text[start:]
    45	    end = re.search(r'\n\n?\[(?!Not shown)', section[1:])
    46	    section = section[:end.start() + 1] if end else section
    47	    chunks = re.split(r'\n(?=- e\d+ \[)', section)
    48	    stated = int(re.match(r'\[Evidence in view under this thesis, (\d+) items\]', section).group(1))
    49	    if len(chunks) - 1 != stated:
    50	        raise ValueError(f'the request states {stated} evidence items and the card read {len(chunks) - 1}')
    51	    items = []
    52	    for chunk in chunks[1:]:
    53	        m = ITEM.match(chunk)
    54	        if not m:
    55	            raise ValueError(f'an evidence item the card cannot read: {chunk[:120]!r}')
    56	        rest = chunk[m.end():]
    57	        rest = NOTE.split(rest)[0]
    58	        summary, _, quote = rest.partition('\n    Quote: ')
    59	        items.append({'tier': m.group(1).strip(), 'speaker': m.group(2).strip(), 'original': m.group(3).strip(), 'input_id': m.group(4),
    60	                      'day': m.group(5), 'summary': summary.strip(), 'quote': quote.strip()})
    61	    return items
    62	
    63	
    64	def section(text, header):
    65	    """The body of one bracketed section of a judge request, from its header line to the next blank-line section, or ''."""
    66	    start = text.find(header)
    67	    if start < 0:
    68	        return ''
    69	    body = text[start:].split('\n', 1)[1] if '\n' in text[start:] else ''
    70	    return re.split(r'\n\n(?:\[|Answer per the JSON schema)', body, maxsplit=1)[0]
    71	
    72	
    73	def entries(body):
    74	    """The '- ' entries of a section, each kept whole across line breaks."""
    75	    return [e[2:] for e in re.split(r'\n(?=- )', body) if e.startswith('- ')]
