   106	def library(views_path, archive_path, items_path):
   107	    conn, archive, items = ro(views_path), ro(archive_path), ro(items_path)
   108	    day_of = lambda input_id: (items.execute('select publication_day from items where input_id=?', (input_id,)).fetchone() or [None])[0]
   109	    publisher_of = lambda input_id: (items.execute('select publisher from items where input_id=?', (input_id,)).fetchone() or [None])[0]
   110	    views = list(conn.execute('select view_id, question, due_day, created_seq, created_from_input from views order by created_seq'))
   111	    out = []
   112	    for v in views:
   113	        latest = conn.execute('select rung, reasons, request_sha256, seq from judgements where view_id=? order by seq desc limit 1',
   114	                              (v['view_id'],)).fetchone()
   115	        rungs = conditions(v['view_id'], conn)
   116	        bounded = conn.execute('select count(*) from rungs where view_id=? and (lo is not null or hi is not null)', (v['view_id'],)).fetchone()[0]
   117	        entry = {'question_id': v['view_id'], 'question': v['question'], 'due': v['due_day'], 'opened': day_of(v['created_from_input']),
   118	                 'opened_from': v['created_from_input'], 'type': 'figure' if bounded else 'yes/no',
   119	                 'possible_answers': [rungs[p] for p in sorted(rungs)], 'answer': None, 'answer_index': None, 'reasons': None, 'material': []}
   120	        if latest is not None:
   121	            entry['answer'] = rungs.get(latest['rung'])
   122	            entry['answer_index'] = sorted(rungs).index(latest['rung'])      # the stored rung's place in possible_answers
   123	            entry['reasons'] = latest['reasons']
   124	            row = archive.execute('select request_json from model_calls where request_sha256=? limit 1', (latest['request_sha256'],)).fetchone()
   125	            if row is None:
   126	                raise SystemExit(f"{v['view_id']}: the latest judgement's request is not in the archive")
   127	            entry['material'] = [dict(item, publisher=publisher_of(item['input_id'])) for item in material(row['request_json'])]
   128	            entry['context'] = context(row['request_json'], conn)
   129	            if entry['context']['previous']:
   130	                entry['context']['previous']['answer'] = rungs.get(entry['context']['previous']['rung'])
   131	        out.append(entry)
   132	    return out
