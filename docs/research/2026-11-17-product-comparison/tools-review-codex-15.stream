   170	def validate_readings(readings):
   171	    """Refuses malformed readings before any verdict or diagnostic (one owner for the readings' shape): every mark a frozen mark or a
   172	    split of two, every cover true, false or "split" and naming a carded question, every count a non-negative integer, every day an ISO
   173	    date. `mark_cards.readings` writes only such values; anything else means the file was not made by the reading."""
   174	    import datetime
   175	    problems = []
   176	    def mark_ok(value, kind):
   177	        if isinstance(value, dict):
   178	            return set(value) == {'split'} and len(value['split']) == 2 and all(v in MARKS[kind] for v in value['split'])
   179	        return value in MARKS[kind] or (kind == 'answer' and value == 'no answer')
   180	    def day_ok(value):
   181	        try:
   182	            datetime.date.fromisoformat(value)
   183	            return True
   184	        except (TypeError, ValueError):
   185	            return False
   186	    for draw, cards in readings['cards'].items():
   187	        for q, card in cards.items():
   188	            if not (mark_ok(card.get('worth'), 'worth') and mark_ok(card.get('answer'), 'answer') and card.get('type') in ('figure', 'yes/no', 'other')
   189	                    and isinstance(card.get('guardrail'), bool) and card.get('covering') in (True, False, 'split')
   190	                    and (card.get('opened') is None or day_ok(card.get('opened')))):
   191	                problems.append(f'{draw} {q}: a card mark, type, flag or day outside the closed set')
   192	    for draw, by_matter in readings['mapping'].items():
   193	        for matter, questions in by_matter.items():
   194	            for entry in questions:
   195	                if entry.get('covers') not in (True, False, 'split') or entry.get('question') not in readings['cards'].get(draw, {}):
   196	                    problems.append(f'{draw} {matter}: a cover outside the closed set or naming no carded question')
   197	    for draw, d in readings['distinct'].items():
   198	        if not all(isinstance(d.get(k), int) and not isinstance(d.get(k), bool) and d.get(k) >= 0 for k in ('ids', 'duplicates_both', 'duplicates_split')):
   199	            problems.append(f'{draw}: a distinct-bet count that is not a non-negative integer')
   200	    for matter, day in (readings.get('matter_first_day') or {}).items():
   201	        if not day_ok(day):
   202	            problems.append(f'{matter}: a first-article day that is not an ISO date')
   203	    controls = readings['controls']
   204	    if not (all(mark_ok(m, 'answer') for m in controls['plants']) and all(mark_ok(m, 'answer') for m in controls['supported'])
   205	            and all(isinstance(x, bool) for x in controls['repeats_same'])):
   206	        problems.append('a control mark outside the closed set')
   207	    if problems:
   208	        raise SystemExit('refused: malformed readings: ' + '; '.join(problems[:10]) + (f' (and {len(problems) - 10} more)' if len(problems) > 10 else ''))
