    78	def context(request_json, conn):
    79	    """What the answering request gave besides its evidence items (`judging._lines_english`), blinded as the card is: thesis ids removed,
    80	    each rung shown by its condition (D673). {hidden, previous, depends_on, themes}."""
    81	    text = json.loads(request_json)['messages'][-1]['content']
    82	    hidden = re.search(r'\[Not shown: (\d+) more pieces in force', text)
    83	    previous = re.search(r'\[Previous conclusion, for comparison only\] rung (\d+); reasons: (.*?)(?:\n\nAnswer per the JSON schema|$)', text, re.S)
    84	    out = {'hidden': int(hidden.group(1)) if hidden else 0, 'previous': None, 'depends_on': [], 'themes': []}
    85	    for e in entries(section(text, '[Current conclusions of the theses it depends on]')):
    86	        m = re.match(r'(v\d+) \(([^;]*); ([^)]*)\) (.*): now rung (\S+) .*?; reasons: (.*)$', e, re.S)
    87	        if m:
    88	            answer = conditions(m.group(1), conn).get(int(m.group(5))) if m.group(5).isdigit() else 'not judged yet'
    89	            out['depends_on'].append({'flag': m.group(2), 'direction': m.group(3), 'question': m.group(4), 'answer': answer, 'reasons': m.group(6).strip()})
    90	        else:
    91	            out['depends_on'].append({'flag': 'not yet created', 'direction': '', 'question': re.sub(r'^the (\S+) thesis on chain v\d+', r'the \1 question of a chain', e).strip(),
    92	                                      'answer': None, 'reasons': ''})
    93	    for e in entries(section(text, '[Themes in force, ')):
    94	        m = re.match(r'(v\d+) \([^,]*, due (\S+)\) (.*): now rung (\d+) .*?; judged (\S+?)(; updated since this thesis was last judged)?; reasons: (.*)$', e, re.S)
    95	        if not m:
    96	            raise ValueError(f'a theme entry the card cannot read: {e[:120]!r}')
    97	        rungs = conditions(m.group(1), conn)
    98	        out['themes'].append({'question': m.group(3), 'due': m.group(2), 'rung': int(m.group(4)), 'answer': rungs.get(int(m.group(4))),
    99	                              'possible_answers': [rungs[p] for p in sorted(rungs)], 'judged': m.group(5), 'updated': bool(m.group(6)),
   100	                              'reasons': m.group(7).strip()})
   101	    if previous:
   102	        out['previous'] = {'rung': int(previous.group(1)), 'reasons': previous.group(2).strip()}
   103	    return out
