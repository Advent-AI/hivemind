import copy, hashlib, json, subprocess, types
import score_comparison as new
import test_score_comparison as tests

old = types.ModuleType(\"previous_score_comparison\")
old.__file__ = new.__file__
path = \"docs/research/2026-11-17-product-comparison/stage0/score_comparison.py\"
exec(compile(subprocess.check_output([\"git\", \"--no-pager\", \"show\", \"60585822"'^:" + path], text=True), path, "exec"), old.__dict__)

class MemoryPath:
    files = {}
    def __init__(self, name):
        self.name = name
    def exists(self):
        return self.name in self.files
    def read_bytes(self):
        return self.files[self.name]
    def read_text(self):
        return self.read_bytes().decode()

def put(name, data):
    MemoryPath.files[name] = json.dumps(data).encode()
    return hashlib.sha256(MemoryPath.files[name]).hexdigest()

def seal(r):
    es = put("eligibility", {"eligible": True})
    key = [dict(draw=d, question=q, role="product", **{f:c[f] for f in ("guardrail","covering","type")})
           for d, cards in r["cards"].items() for q,c in cards.items()]
    r["inputs"] = dict(matters_sha256=put("matters", {"matters":r["matters"]}),
                       mapping_path="mapping",
                       mapping_sha256=put("mapping", {"mapping":r["mapping"], "distinct":r["distinct"], "eligibility_sha256":es}),
                       eligibility_path="eligibility", eligibility_sha256=es,
                       deck_key_path="key", deck_key_sha256=put("key", dict(enumerate(key))))
    return r

for m in (new, old):
    m.Path, m.MATTERS = MemoryPath, MemoryPath("matters")
tests.seal = seal
tests.test_malformed_readings_are_refused_before_any_verdict()
print("Committed malformed-input regression test passed in memory.")
for n,a,b,invalid in ((32,10,2,False),(32,2,10,False),(32,5,4,False),(19,5,1,False),(32,5,1,True)):
    r = tests.base(n=n,new_served=a,old_served=b)
    r["matters"][0]["company_figure"] = True
    r["matter_first_day"] = {"M01":"2026-09-08"}
    for d,cards in r["cards"].items():
        for q,card in cards.items():
            card["opened"] = "2026-09-09"
            if q.endswith("-g-figure-0"):
                card["answer"] = {"split":["supported","insufficient"]}
            if q.endswith("-g-yes/no-1"):
                card["answer"] = "no answer"
    if invalid:
        r["controls"]["plants"][0] = {"split":["supported","unsupported"]}
    seal(r)
    expected, actual = old.verdict(copy.deepcopy(r)), new.verdict(copy.deepcopy(r))
    assert json.dumps(expected,default=str) == json.dumps(actual,default=str)
    print(actual["verdict"], "serialized report matches parent")

r = tests.base(n=32,new_served=10,old_served=2)
r["cards"]["new-1"]["new-1-g-figure-0"]["worth"] = {"split":{"worth":0,"trivia":1}}
print("Split object passed and was scored:", tests.verdict(r)["verdict"])
r = tests.base(n=32,new_served=10,old_served=2)
r["matter_first_day"] = {"M01":"2026-09-08"}
r["cards"]["new-1"]["new-1-q0"]["opened"] = "2026-09-09"
assert new.days_to_opening(r)["M01"]["new-1"] == 1
r["mapping"]["new-1"]["M01"][0]["covers"] = 1
out = tests.verdict(r)
assert "M01" in out["countings"]["1"]["served_new"] and not new.days_to_opening(r)
print("Numeric cover passed and was scored:", out["verdict"], "coverage credit present, opening delay missing")
