   229	def marks(out, label, family):
   230	    """{matter: covering ids} and the set of duplicates (the later-opened id of every pair named), from one family's valid answer."""
   231	    path = Path(out) / f'map-{label}-{family}.txt'
   232	    if not path.exists():
   233	        raise SystemExit(f'refused: {path.name} missing (a void mapping is never counted)')
   234	    rows = json_lines(path.read_text())
   235	    order = {e['question_id']: k for k, e in enumerate(json.loads((Path(out) / f'library-{label}.json').read_text()))}
   236	    covering = {}
   237	    for r in rows:
   238	        if r.get('matter') and r.get('status') in ('opened', 'narrower'):
   239	            if r['status'] == 'opened' or r.get('main_outcome') is True:
   240	                for q in r.get('ids') or []:
   241	                    covering.setdefault(r['matter'], set()).add(str(q))
   242	    duplicates = {max(str(r['duplicate']), str(r['of']), key=order.__getitem__) for r in rows if r.get('duplicate') is not None}
   243	    return covering, duplicates
