+        change(r['cards']['new-1']['new-1-g-figure-0'])
+        try:
+            sc.verdict(r)
+        except SystemExit as e:
+            assert 'deck key' in str(e)
+        else:
+            raise AssertionError('readings that differ from the deck key were scored')
+
+
