import ast, contextlib, copy, io, json, subprocess, sys, types
from pathlib import Path
import score_comparison as score
import test_score_comparison as tests
import mark_cards as writer
import mapping
parent = types.ModuleType(\"previous_score_comparison\")
parent.__file__ = score.__file__
p = \"docs/research/2026-11-17-product-comparison/stage0/score_comparison.py\"
exec(compile(subprocess.check_output([\"git\",\"--no-pager\",\"show\",\"1f756eca"'^:"+p],text=True),p,"exec"),parent.__dict__)
last = ast.parse(Path("score_comparison.py").read_text()).body[-1]
cli_code = compile(ast.Module(body=[last],type_ignores=[]),"score_comparison.py","exec")
class Mem:
    data={}
    def __init__(self,path): self.path=str(path)
    def __truediv__(self,child): return Mem(self.path+"/"+child)
    def __str__(self): return self.path
    def resolve(self): return self
    def exists(self): return self.path in self.data
    def read_bytes(self): return self.data[self.path]
    def read_text(self): return self.read_bytes().decode()
    def write_text(self,text): self.data[self.path]=text.encode()
def put(p,val): Mem(p).write_text(json.dumps(val))
def get(p): return json.loads(Mem(p).read_text())
for m in parent,score:
    m.Path,m.MATTERS=Mem,Mem("matters")
writer.Path=Mem
writer.KEY=Mem("keys/deck-key.json")
mapping.Path,mapping.MATTERS,mapping.KEY_FOLDER=Mem,Mem("matters"),Mem("keys")
def cli():
    ns=dict(score.__dict__,__name__="__main__")
    sys.argv=["score_comparison.py","map","deck"]
    with contextlib.redirect_stdout(io.StringIO()) as f:
        exec(cli_code,ns)
    return f.getvalue()
def record():
    with contextlib.redirect_stdout(io.StringIO()):
        writer.readings("map","deck")
def make(r):
    put("matters",{"matters":r["matters"]})
    put("map/eligibility.json",{"eligible":True})
    put("keys/mapping-key.json",{d:d for d in r["cards"]})
    writer.matter_first_days=lambda:r["matter_first_day"]
    key={}
    def add(k,w,a):
        cid=f"C{len(key)+1:03d}"
        key[cid]=k
        for family in ("codex","claude"):
            put(f"deck/round-0/{cid}-{family}.json",dict(worth=w,answer=a,why="fixture"))
    for draw,cards in r["cards"].items():
        put(f"map/library-{draw}.json",[{"question_id":q} for q in cards])
        rows=[{"matter":m,"status":"opened","ids":[e["question"] for e in entries]} for m,entries in r["mapping"][draw].items()]
        for family in ("claude","codex"):
            Mem(f"map/map-{draw}-{family}.txt").write_text("'"\\n\".join(map(json.dumps,rows)))
        for q,c in cards.items():
            add(dict(role=\"product\",draw=draw,question=q,answered=c[\"answer\"]"'!="no answer",
                     **{f:c[f] for f in ("opened","guardrail","covering","type")}),c["worth"],c["answer"] if c["answer"]!="no answer" else None)
    product=next(iter(key.values()))
    for role,marks in (("plant",r["controls"]["plants"]),("supported control",r["controls"]["supported"])):
        for mark in marks: add(dict(product,role=role),"worth",mark)
    for same in r["controls"]["repeats_same"]:
        add(dict(product,role="repeat"),"worth" if same else "trivia",r["cards"][product["draw"]][product["question"]]["answer"])
    put("keys/deck-key.json",key)
    for n in range(3): Mem(f"deck/round-{n}.done").write_text("done")
    with contextlib.redirect_stdout(io.StringIO()):
        mapping.result("map")
    record()
def fixture(n=20,a=5,b=1,empty=False,short=False):
    r=tests.base(n=n,new_served=a,old_served=b)
