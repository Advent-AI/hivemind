{"type":"item.started","item":{"id":"item_7","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"python3 -B -c 'import sqlite3,pathlib,json; base=pathlib.Path(\\\"poc/data/comparison-2026-11-17/run\\\"); p=pathlib.Path(\\\"poc/data/hybrid-2026-11-20/cases.json\\\"); rs=[r for r in json.loads(p.read_text()) if r[\\\"case\\\"] in (\\\"T-old-1-Q7\\\",\\\"T-old-3-Q7\\\",\\\"T-old-2-Q6\\\")]; \nfor r in rs:\n f=(base/r[\\\"draw\\\"]/\\\"prod/views.sqlite\\\").resolve(); c=sqlite3.connect(f\\\"file:{f}?mode=ro&immutable=1\\\",uri=True); vs=c.execute(\\\"select publication_day,rung,reasons from judgements where view_id=? order by seq\\\",(r[\\\"view_id\\\"],)).fetchall(); n=next((i for i,v in enumerate(reversed(vs)) if v[1]\"'!=vs[-1][1]),len(vs)); print(r[\"case\"],len(vs),n,vs[-n][:2],vs[-1][:2],vs[-1][2][:250])'\"'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
