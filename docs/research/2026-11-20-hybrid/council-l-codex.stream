{"type":"item.started","item":{"id":"item_8","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"python3 -B -c 'import json,pathlib,collections; a=json.loads(pathlib.Path(\\\"poc/data/hybrid-2026-11-20/opening-census.json\\\").read_text()); mds={\\\"M02\\\",\\\"M03\\\",\\\"M24\\\",\\\"M26\\\",\\\"M28\\\",\\\"M27\\\",\\\"M12\\\",\\\"M20\\\",\\\"M32\\\",\\\"M07\\\",\\\"M16\\\",\\\"M05\\\"}; pats={\\\"M02\\\":\\\"capital expend|capex\\\", \\\"M03\\\":\\\"capital expend|capex\\\", \\\"M24\\\":\\\"capital expend|capex\\\", \\\"M26\\\":\\\"Hugging Face|HuggingFace\\\", \\\"M28\\\":\\\"Hugging Face|HuggingFace\\\", \\\"M27\\\":\\\"Hugging Face|HuggingFace\\\", \\\"M12\\\":\\\"guarante|Ohio\\\", \\\"M20\\\":\\\"residual|Goldman|Blackstone\\\", \\\"M32\\\":\\\"neocloud|capacity|cloud services\\\", \\\"M07\\\":\\\"FY2028|FY28\\\", \\\"M16\\\":\\\"DRAM|memory prices\\\", \\\"M05\\\":\\\"semiconductor sales\\\"}; import re\nfor m in a:\n n=m[\\\"matter\\\"];\n if n not in mds: continue\n print(n,m[\\\"question\\\"])\n for d,w in m[\\\"draws\\\"].items():\n  cs=[c for c in w[\\\"candidates\\\"] if re.search(pats[n],c[\\\"question\\\"],re.I)]; g=collections.defaultdict(list)\n  for c in cs: g[(c[\\\"object\\\"],c[\\\"fate\\\"].get(\\\"outcome\\\"),c[\\\"target_question\\\"],c[\\\"fate\\\"].get(\\\"not_opened\\\"),c[\\\"fate\\\"].get(\\\"refused\\\"))].append(c[\\\"question\\\"])\n  print(d,[(len(qs),k,q[0:190]) for k,qs in g.items() for q in qs[:1]][:9]);\n'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
