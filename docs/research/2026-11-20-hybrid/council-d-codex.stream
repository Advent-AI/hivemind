{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"rg -n 'def (refusals|expected_files|goldscore|deck|probe|goldprobe)|read-only|refusal' docs/research/2026-11-20-hybrid/judge_probe.py; nl -ba docs/research/2026-11-20-hybrid/judge_probe.py | sed -n '183,520p'\"","aggregated_output":"10:  python3 judge_probe.py goldscore <arm>         # $0: the gold probe's agreement and refusals, complete coverage required\n17:through read-only connections.\"\"\"\n195:def probe(ledger_path, arm, repeats):\n283:def goldprobe(ledger_path, arm, repeats):\n317:def probe_card(case, answer):\n336:def refusals_before(views_path, view_id, judgement_id, answer, request_text):\n337:    \"\"\"The production check's refusals of an answer (`judging.check_answer` against the request it answered) on the store as it stood\n338:    immediately before the stored judgement: later judgements are shadowed by a temporary table on a read-only connection (council C:\n346:def refusals(case, answer):\n349:    return refusals_before(views, case['view_id'], judgement['judgement_id'], answer, request['messages'][1]['content'])\n352:def expected_files(folder, names, repeats=3):\n359:def goldscore(arm):\n361:    production check's refusals (against the state before the stored judgement), and agreement counting a refused answer as not\n377:            refused = refusals_before(GOLD_RUN / case['draw'] / 'views.sqlite', case['view_id'], judgement_id, record['answer'],\n391:def deck(arms):\n393:    production check's refusals recorded in the key, and plants\n421:            item['refusals'] = refusals(case, record['answer'])\n   183\t        answer = transport('openai', follow)\n   184\t        text = answer['choices'][0]['message']['content']\n   185\t        (folder / f\"{case['case']}.json\").write_text(json.dumps({'case': case, 'question': ACCOUNT_QUESTION, 'account': text,\n   186\t                                                                'usage': answer.get('usage')}, indent=1, ensure_ascii=False))\n   187\t        return case['case']\n   188\t\n   189\t    with concurrent.futures.ThreadPoolExecutor(WORKERS) as pool:\n   190\t        for name in pool.map(one, rows):\n   191\t            print('account', name, flush=True)\n   192\t    print('ledger', json.dumps(ledger.read()))\n   193\t\n   194\t\n   195\tdef probe(ledger_path, arm, repeats):\n   196\t    \"\"\"Cents: each case's rebuilt request with the arm's system text, sent `repeats` times, each answer stored with its usage.\"\"\"\n   197\t    transport, ledger = transport_for(ledger_path)\n   198\t    system, order = arm_spec(arm)\n   199\t    rows = json.loads((OUT / 'cases.json').read_text())\n   200\t    folder = OUT / 'probe' / arm\n   201\t    folder.mkdir(parents=True, exist_ok=False)\n   202\t    jobs = [(case, k) for case in rows for k in range(1, repeats + 1)]\n   203\t\n   204\t    def one(job):\n   205\t        case, k = job\n   206\t        _, request, _, _ = stored(case)\n   207\t        response = transport('openai', rebuild(request, system, order))\n   208\t        content = response['choices'][0]['message']['content']\n   209\t        (folder / f\"{case['case']}-{k}.json\").write_text(json.dumps({'case': case, 'repeat': k, 'arm': arm, 'answer': json.loads(content),\n   210\t                                                                    'usage': response.get('usage')}, indent=1, ensure_ascii=False))\n   211\t        return f\"{case['case']}-{k}\"\n   212\t\n   213\t    with concurrent.futures.ThreadPoolExecutor(WORKERS) as pool:\n   214\t        for name in pool.map(one, jobs):\n   215\t            print('probe', name, flush=True)\n   216\t    print('ledger', json.dumps(ledger.read()))\n   217\t\n   218\t\n   219\tdef gold_entries():\n   220\t    \"\"\"The frozen judgement gold (refused unless its sha256 is the frozen one) and its questions.\"\"\"\n   221\t    import hashlib\n   222\t    raw = (GOLD / 'gold-v1.json').read_bytes()\n   223\t    if hashlib.sha256(raw).hexdigest() != GOLD_SHA256:\n   224\t        raise SystemExit('gold-v1.json is not the frozen gold: refused')\n   225\t    questions = {q['id']: q for q in json.loads((GOLD / 'questions-v1.json').read_text(encoding='utf-8'))['questions']}\n   226\t    return json.loads(raw)['entries'], questions\n   227\t\n   228\t\n   229\tdef gold_agrees(entry, question, rungs, rung):\n   230\t    \"\"\"The frozen scorer's rule (score_judgement.py): a numeric question agrees when the gold's implied range overlaps the chosen rung's\n   231\t    band; a yes/no question when the answers match.\"\"\"\n   232\t    resolved = entry.get('resolution') or entry\n   233\t    implied = resolved['implied_outcome']\n   234\t    chosen = rungs[rung - 1]\n   235\t    if question['unit'] == 'yes/no':\n   236\t        return (chosen['label'].lower() == 'yes') == bool(implied['yes_no'])\n   237\t    lo, hi = chosen['lo'], chosen['hi']\n   238\t    return (lo is None or implied['high'] >= lo) and (hi is None or implied['low'] < hi)\n   239\t\n   240\t\n   241\tdef goldcases():\n   242\t    \"\"\"$0: per r9 draw and gold question with a gold outcome, the view's last judgement at or before 07-14, its stored request rebuilt\n   243\t    byte for byte under the frozen judge (the check), and the stored rung's agreement as the scorer computes it.\"\"\"\n   244\t    from hivemind import model\n   245\t    entries, questions = gold_entries()\n   246\t    frozen = FROZEN_SYSTEM.read_text(encoding='utf-8')\n   247\t    out, bad = [], []\n   248\t    for draw in ('d1', 'd2', 'd3'):\n   249\t        views = readonly(GOLD_RUN / draw / 'views.sqlite')\n   250\t        archive = readonly(GOLD_RUN / draw / 'archive.sqlite')\n   251\t        mapping = {f'q{k:02d}': f'v{k}' for k in range(1, 23)}\n   252\t        for qid, vid in mapping.items():\n   253\t            row = views.execute('select question from views where view_id=?', (vid,)).fetchone()\n   254\t            if not row or row['question'] != questions[qid]['question']:\n   255\t                raise SystemExit(f'{draw} {vid} is not the seed question {qid}: refused')\n   256\t        hit = views.execute(\"select view_id from views where question like '%Ohio%' and question like '%guarantee%' order by created_seq limit 1\").fetchone()\n   257\t        if hit:\n   258\t            mapping['q23'] = hit['view_id']\n   259\t        for entry in entries:\n   260\t            qid = entry['question_id']\n   261\t            if entry.get('no_view') or not entry.get('implied_outcome') or qid not in mapping:\n   262\t                continue\n   263\t            vid = mapping[qid]\n   264\t            j = views.execute('select * from judgements where view_id=? and publication_day<=? order by judgement_id desc limit 1', (vid, GOLD_DAY)).fetchone()\n   265\t            if j is None:\n   266\t                continue\n   267\t            rungs = [dict(r) for r in views.execute('select position, label, lo, hi from rungs where view_id=? order by position', (vid,))]\n   268\t            request = json.loads(archive.execute('select request_json from model_calls where request_sha256=? limit 1', (j['request_sha256'],)).fetchone()[0])\n   269\t            _, sha = model.request_identity(rebuild(request, frozen))\n   270\t            if sha != j['request_sha256']:\n   271\t                bad.append(f'{draw}-{qid}')\n   272\t            out.append({'case': f'G-{draw}-{qid}', 'draw': draw, 'qid': qid, 'view_id': vid, 'request_sha256': j['request_sha256'],\n   273\t                        'stored_rung': j['rung'], 'stored_agrees': gold_agrees(entry, questions[qid], rungs, j['rung']), 'rungs': rungs})\n   274\t    (OUT / 'goldcases.json').write_text(json.dumps(out, indent=1))\n   275\t    for draw in ('d1', 'd2', 'd3'):\n   276\t        rows = [c for c in out if c['draw'] == draw]\n   277\t        print(draw, f\"stored agreement {sum(c['stored_agrees'] for c in rows)}/{len(rows)}\")\n   278\t    print(f'{len(out) - len(bad)} of {len(out)} gold requests rebuilt byte for byte', 'mismatch: ' + ', '.join(bad) if bad else '')\n   279\t    if bad:\n   280\t        raise SystemExit(1)\n   281\t\n   282\t\n   283\tdef goldprobe(ledger_path, arm, repeats):\n   284\t    \"\"\"Cents: each gold case's request under the arm, sent `repeats` times; agreement by the frozen scorer's rule, per draw and repeat.\"\"\"\n   285\t    transport, ledger = transport_for(ledger_path)\n   286\t    system, order = arm_spec(arm)\n   287\t    entries, questions = gold_entries()\n   288\t    by_qid = {e['question_id']: e for e in entries}\n   289\t    rows = json.loads((OUT / 'goldcases.json').read_text())\n   290\t    folder = OUT / 'goldprobe' / arm\n   291\t    folder.mkdir(parents=True, exist_ok=False)\n   292\t    jobs = [(case, k) for case in rows for k in range(1, repeats + 1)]\n   293\t\n   294\t    def one(job):\n   295\t        case, k = job\n   296\t        archive = readonly(GOLD_RUN / case['draw'] / 'archive.sqlite')\n   297\t        request = json.loads(archive.execute('select request_json from model_calls where request_sha256=? limit 1', (case['request_sha256'],)).fetchone()[0])\n   298\t        response = transport('openai', rebuild(request, system, order))\n   299\t        answer = json.loads(response['choices'][0]['message']['content'])\n   300\t        rung = answer['rung']\n   301\t        agrees = 1 <= rung <= len(case['rungs']) and gold_agrees(by_qid[case['qid']], questions[case['qid']], case['rungs'], rung)\n   302\t        (folder / f\"{case['case']}-{k}.json\").write_text(json.dumps({'case': case['case'], 'repeat': k, 'arm': arm, 'answer': answer,\n   303\t                                                                    'agrees': agrees, 'usage': response.get('usage')}, indent=1, ensure_ascii=False))\n   304\t        return case['draw'], k, agrees\n   305\t\n   306\t    tally = {}\n   307\t    with concurrent.futures.ThreadPoolExecutor(WORKERS) as pool:\n   308\t        for draw, k, agrees in pool.map(one, jobs):\n   309\t            tally.setdefault((draw, k), [0, 0])\n   310\t            tally[(draw, k)][0] += agrees\n   311\t            tally[(draw, k)][1] += 1\n   312\t    for (draw, k), (a, n) in sorted(tally.items()):\n   313\t        print(f'{arm} {draw} repeat {k}: agreement {a}/{n}')\n   314\t    print('ledger', json.dumps(ledger.read()))\n   315\t\n   316\t\n   317\tdef probe_card(case, answer):\n   318\t    \"\"\"The comparison card of the case (same question, choices, material and library list) with the probe's answer: its rung's label,\n   319\t    and the reference, implied outcome and reasons, labelled, the same way for every arm.\"\"\"\n   320\t    import re\n   321\t    text = (DIAG / 'deck' / f\"{case['card']}.txt\").read_text()\n   322\t    choices = re.findall(r'^(\\d+)\\. (.*)$', text.split('Possible answers', 1)[1].split('\\n\\n', 1)[0], re.M)\n   323\t    labels = {int(k): v for k, v in choices}\n   324\t    rung = answer['rung']\n   325\t    if rung not in labels:\n   326\t        return None\n   327\t    reason = f\"Reference: {answer['reference']} Implied outcome: {answer['implied_outcome']} Reasons: {answer['reasons']}\"\n   328\t    lines = text.split('\\n')\n   329\t    answer_line = next(i for i, line in enumerate(lines) if line.startswith('Latest answer at the cutoff: '))\n   330\t    assert lines[answer_line + 1].startswith('Reason given: ')\n   331\t    lines[answer_line] = f'Latest answer at the cutoff: {labels[rung]}'\n   332\t    lines[answer_line + 1] = f'Reason given: {reason}'\n   333\t    return '\\n'.join(lines), labels\n   334\t\n   335\t\n   336\tdef refusals_before(views_path, view_id, judgement_id, answer, request_text):\n   337\t    \"\"\"The production check's refusals of an answer (`judging.check_answer` against the request it answered) on the store as it stood\n   338\t    immediately before the stored judgement: later judgements are shadowed by a temporary table on a read-only connection (council C:\n   339\t    the stored final judgement is not the previous one).\"\"\"\n   340\t    from hivemind.views import judging\n   341\t    conn = readonly(views_path)\n   342\t    conn.execute('create temp table judgements as select * from main.judgements where judgement_id < ?', (judgement_id,))\n   343\t    return judging.check_answer(conn, view_id, answer, request_text)\n   344\t\n   345\t\n   346\tdef refusals(case, answer):\n   347\t    views, _ = store_paths(case['draw'])\n   348\t    judgement, request, _, _ = stored(case)\n   349\t    return refusals_before(views, case['view_id'], judgement['judgement_id'], answer, request['messages'][1]['content'])\n   350\t\n   351\t\n   352\tdef expected_files(folder, names, repeats=3):\n   353\t    \"\"\"Refuse unless every expected answer file exists (council C: complete coverage before scoring).\"\"\"\n   354\t    missing = [f'{n}-{k}' for n in names for k in range(1, repeats + 1) if not (folder / f'{n}-{k}.json').exists()]\n   355\t    if missing:\n   356\t        raise SystemExit(f'{folder}: {len(missing)} expected answers missing, e.g. {missing[:5]}: refused')\n   357\t\n   358\t\n   359\tdef goldscore(arm):\n   360\t    \"\"\"$0: the gold probe of an arm, complete coverage required: per draw and repeat, agreement by the frozen scorer's rule, the\n   361\t    production check's refusals (against the state before the stored judgement), and agreement counting a refused answer as not\n   362\t    agreeing.\"\"\"\n   363\t    entries, questions = gold_entries()\n   364\t    by_qid = {e['question_id']: e for e in entries}\n   365\t    rows = json.loads((OUT / 'goldcases.json').read_text())\n   366\t    folder = OUT / 'goldprobe' / arm\n   367\t    expected_files(folder, [c['case'] for c in rows])\n   368\t    tally = {}\n   369\t    for case in rows:\n   370\t        views = readonly(GOLD_RUN / case['draw'] / 'views.sqlite')\n   371\t        judgement_id = views.execute('select judgement_id from judgements where request_sha256=? and view_id=?',\n   372\t                                     (case['request_sha256'], case['view_id'])).fetchone()[0]\n   373\t        archive = readonly(GOLD_RUN / case['draw'] / 'archive.sqlite')\n   374\t        request = json.loads(archive.execute('select request_json from model_calls where request_sha256=? limit 1', (case['request_sha256'],)).fetchone()[0])\n   375\t        for k in (1, 2, 3):\n   376\t            record = json.loads((folder / f\"{case['case']}-{k}.json\").read_text())\n   377\t            refused = refusals_before(GOLD_RUN / case['draw'] / 'views.sqlite', case['view_id'], judgement_id, record['answer'],\n   378\t                                      request['messages'][1]['content'])\n   379\t            t = tally.setdefault((case['draw'], k), {'agree': 0, 'refused': 0, 'agree_not_refused': 0, 'n': 0})\n   380\t            t['n'] += 1\n   381\t            t['agree'] += record['agrees']\n   382\t            t['refused'] += bool(refused)\n   383\t            t['agree_not_refused'] += record['agrees'] and not refused\n   384\t    per_repeat = {k: sum(t['agree'] for (d, kk), t in tally.items() if kk == k) for k in (1, 2, 3)}\n   385\t    strict = {k: sum(t['agree_not_refused'] for (d, kk), t in tally.items() if kk == k) for k in (1, 2, 3)}\n   386\t    refused = sum(t['refused'] for t in tally.values())\n   387\t    print(f'{arm}: agreement per repeat {per_repeat} of {len(rows)}; counting refused as not agreeing {strict}; refused answers {refused} of {3 * len(rows)}')\n   388\t    return per_repeat, strict, refused\n   389\t\n   390\t\n   391\tdef deck(arms):\n   392\t    \"\"\"Blind deck: every probe answer of every arm and repeat (council B: a same-rung answer can be better or worse reasoned), with the\n   393\t    production check's refusals recorded in the key, and plants\n   394\t    (a control's v7 answer moved one rung, entered only when a separate closed reader confirms it is not supported). Shuffled; the key\n   395\t    is kept outside the repository and never overwritten.\"\"\"\n   396\t    sys.path[:0] = [str(STAGE0), str(STAGE0 / 'census')]\n   397\t    import mark_cards\n   398\t    if PROBE_KEY.exists():\n   399\t        raise SystemExit(f'refused: {PROBE_KEY} exists')\n   400\t    folder = OUT / 'deck-probe'\n   401\t    folder.mkdir(parents=True, exist_ok=False)\n   402\t    rows = {c['case']: c for c in json.loads((OUT / 'cases.json').read_text())}\n   403\t    for arm in arms:\n   404\t        expected_files(OUT / 'probe' / arm, list(rows))\n   405\t    stored_rung = {name: stored(case)[0]['rung'] for name, case in rows.items()}\n   406\t    rng = random.Random(SEED)\n   407\t    cards = []\n   408\t    for arm in arms:\n   409\t        for path in sorted((OUT / 'probe' / arm).glob('*.json')):\n   410\t            record = json.loads(path.read_text())\n   411\t            case = rows[record['case']['case']]\n   412\t            built = probe_card(case, record['answer'])\n   413\t            item = {'arm': arm, 'case': case['case'], 'role': case['role'], 'repeat': record['repeat'], 'rung': record['answer']['rung'],\n   414\t                    'stored_rung': stored_rung[case['case']], 'kind': 'probe'}\n   415\t            if built is None:\n   416\t                item['kind'] = 'invalid rung'\n   417\t                cards.append(dict(item, text=None))\n   418\t                continue\n   419\t            item['text'] = built[0]\n   420\t            item['changed'] = item['rung'] != item['stored_rung']\n   421\t            item['refusals'] = refusals(case, record['answer'])\n   422\t            cards.append(item)\n   423\t    confirmations = []\n   424\t    controls = [c for c in rows.values() if c['role'] == 'control']\n   425\t    for case in rng.sample(controls, len(controls)):\n   426\t        if sum(c['kind'] == 'plant' for c in cards) >= PLANTS:\n   427\t            break\n   428\t        record = json.loads((OUT / 'probe' / 'v7' / f\"{case['case']}-1.json\").read_text())\n   429\t        built = probe_card(case, record['answer'])\n   430\t        if built is None:\n   431\t            continue\n   432\t        text, labels = built\n   433\t        rung = record['answer']['rung']\n   434\t        moved = rung + 1 if rung + 1 in labels else rung - 1\n   435\t        if moved not in labels:\n   436\t            continue\n   437\t        planted = text.replace(f'Latest answer at the cutoff: {labels[rung]}', f'Latest answer at the cutoff: {labels[moved]}', 1)\n   438\t        ok, mark = mark_cards.confirmed_by_reader(planted, False)\n   439\t        confirmations.append({'case': case['case'], 'moved_to': moved, 'confirmed': ok, 'mark': mark})\n   440\t        if ok:\n   441\t            cards.append({'arm': 'plant', 'case': case['case'], 'role': 'plant', 'repeat': 1, 'rung': moved, 'stored_rung': rung,\n   442\t                          'kind': 'plant', 'text': planted})\n   443\t    readable = [c for c in cards if c['text'] is not None]\n   444\t    rng.shuffle(readable)\n   445\t    key = {}\n   446\t    for n, card in enumerate(readable, 1):\n   447\t        cid = f'C{n:03d}'\n   448\t        key[cid] = {k: v for k, v in card.items() if k != 'text'}\n   449\t        (folder / f'{cid}.txt').write_text(card['text'])\n   450\t    PROBE_KEY.parent.mkdir(parents=True, exist_ok=True)\n   451\t    PROBE_KEY.write_text(json.dumps({'cards': key, 'invalid': [c for c in cards if c['text'] is None], 'plant_confirmations': confirmations},\n   452\t                                    indent=1) + '\\n')\n   453\t    from collections import Counter\n   454\t    print(len(readable), 'cards;', dict(Counter((c['arm'], c['kind']) for c in readable)), '; invalid rungs:', sum(c['text'] is None for c in cards))\n   455\t\n   456\t\n   457\tdef read():\n   458\t    \"\"\"Both reader families mark every card (mark_cards.mark), then debate rounds 1 and 2; marks.json beside the deck's key fields.\"\"\"\n   459\t    sys.path[:0] = [str(STAGE0), str(STAGE0 / 'census')]\n   460\t    import mark_cards\n   461\t    key = json.loads(PROBE_KEY.read_text())['cards']\n   462\t    mark_cards.KEY = PROBE_KEY\n   463\t    folder = OUT / 'deck-probe'\n   464\t    if not (folder / 'round-0.done').exists():\n   465\t        mark_cards.mark(folder)\n   466\t    for round_number in (1, 2):\n   467\t        if not (folder / f'round-{round_number}.done').exists():\n   468\t            mark_cards.debate(folder, round_number)\n   469\t    finals = {cid: mark_cards.final(folder, cid) for cid in sorted(key)}\n   470\t    (OUT / 'marks-probe.json').write_text(json.dumps({cid: dict(key[cid], marks=finals[cid]) for cid in key}, indent=1, ensure_ascii=False))\n   471\t    print('marked', len(finals))\n   472\t\n   473\t\n   474\tdef patch_judging(arm):\n   475\t    \"\"\"Put an arm into the judge's own code path for this process: the schema's field order and, when it differs from v7, the system\n   476\t    text. Nothing in the package is edited.\"\"\"\n   477\t    from hivemind.views import judging\n   478\t    system, order = arm_spec(arm)\n   479\t    original_schema, original_prompt = judging.schema_for, judging.build_prompt\n   480\t    frozen = FROZEN_SYSTEM.read_text(encoding='utf-8')\n   481\t    if order is not None:\n   482\t        def schema_for(version):\n   483\t            schema = original_schema(version)\n   484\t            schema['properties'] = {field: schema['properties'][field] for field in order}\n   485\t            return schema\n   486\t        judging.schema_for = schema_for\n   487\t    if system != frozen:\n   488\t        judging.build_prompt = lambda conn, view_id, version: (system, original_prompt(conn, view_id, version)[1])\n   489\t\n   490\t\n   491\tdef prodpath(arm, ledger_path=None):\n   492\t    \"\"\"The production-path check (council A): a copy of old-2 cut at the end of PRODPATH_BOUNDARY. On each of PRODPATH_DAYS every link the\n   493\t    old system wrote that day is fed (every question, with the evidence, its sources and its repeat and revision relations), and the\n   494\t    judge's own round judges the questions the old system judged at that day's close, unpatched otherwise: a changed theme queues its\n   495\t    assets as in production. 'replay' answers with the old archived answers at $0 and checks each request's bytes against the archived\n   496\t    one; any other arm sends, with an empty archive of its own (council B: J2a and v7 share an archive key).\"\"\"\n   497\t    mt = load('merge_test', MERGE_TEST)\n   498\t    mt.BOUNDARY_DAY = PRODPATH_BOUNDARY\n   499\t    from hivemind import config, model\n   500\t    from hivemind.views import judging, store\n   501\t    cfg = config.load(CONFIG)\n   502\t    folder = OUT / 'prodpath' / arm\n   503\t    folder.mkdir(parents=True, exist_ok=False)\n   504\t    boundary = mt.judging_copy(PRODPATH_DRAW, folder / 'views.sqlite')\n   505\t    conn = store.open_db(str(folder / 'views.sqlite'))\n   506\t    archive = model.Archive(str(folder / 'archive.sqlite'))\n   507\t    old = mt.old_store(PRODPATH_DRAW)\n   508\t    all_views = [r[0] for r in old.execute('select view_id from views')]\n   509\t    day_seq = dict(old.execute('select day, seq from days_completed').fetchall())\n   510\t    created = {v: old.execute('select created_seq from views where view_id=?', (v,)).fetchone()[0] for v in all_views}\n   511\t    pending = {v for v, c in created.items() if c > boundary}\n   512\t    log = []\n   513\t    feed = mt.control_feed(PRODPATH_DRAW, all_views, conn, log)\n   514\t    if arm == 'replay':\n   515\t        import threading\n   516\t        replay, lock = mt.ReplayOld(PRODPATH_DRAW), threading.Lock()\n   517\t\n   518\t        def transport(provider, request):          # one sqlite connection answers the round's concurrent calls one at a time\n   519\t            with lock:\n   520\t                return replay(provider, request)\n","exit_code":0,"status":"completed"}}
