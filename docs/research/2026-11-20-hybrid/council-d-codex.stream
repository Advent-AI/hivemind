{"type":"item.started","item":{"id":"item_8","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba docs/research/2026-11-19-merge-council/merge_test.py | sed -n '206,254p;300,363p;380,429p'; python3 -B -c 'from pathlib import Path; import json,collections; p=Path(\\\"poc/data/hybrid-2026-11-20/prodpath/replay\\\"); c=json.loads((p/\\\"checks.json\\\").read_text()); r=json.loads((p/\\\"results.json\\\").read_text()); f=json.loads((p/\\\"feed-log.json\\\").read_text()); print(\\\"checks\\\",len(c),sum(x[\\\"same text\\\"] for x in c),sum(x[\\\"same evidence shown\\\"] for x in c), c[0]); print(\\\"by day\\\",collections.Counter(x[\\\"day\\\"] for x in r)); print(\\\"v5\\\",[x for x in r if x[\\\"view\\\"]==\\\"v5\\\"]); print(\\\"feed rows\\\",len(f)); print(\\\"feed keys\\\",list(f[0]) if f else [])'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba docs/research/2026-11-19-merge-council/merge_test.py | sed -n '206,254p;300,363p;380,429p'; python3 -B -c 'from pathlib import Path; import json,collections; p=Path(\\\"poc/data/hybrid-2026-11-20/prodpath/replay\\\"); c=json.loads((p/\\\"checks.json\\\").read_text()); r=json.loads((p/\\\"results.json\\\").read_text()); f=json.loads((p/\\\"feed-log.json\\\").read_text()); print(\\\"checks\\\",len(c),sum(x[\\\"same text\\\"] for x in c),sum(x[\\\"same evidence shown\\\"] for x in c), c[0]); print(\\\"by day\\\",collections.Counter(x[\\\"day\\\"] for x in r)); print(\\\"v5\\\",[x for x in r if x[\\\"view\\\"]==\\\"v5\\\"]); print(\\\"feed rows\\\",len(f)); print(\\\"feed keys\\\",list(f[0]) if f else [])'\"","aggregated_output":"   206\tdef judging_copy(draw, path):\n   207\t    \"\"\"A copy of the old store holding only what existed at the end of BOUNDARY_DAY: every row written after it is removed, so no later\n   208\t    state leaks into a judgement. The store's append-only triggers are lifted in this copy for the cut and put back, as stored, before\n   209\t    anything is written. The target questions created later are put back on the day they were created (`restore_view`).\"\"\"\n   210\t    source = sqlite3.connect(f'file:{RUN / draw / \"prod/views.sqlite\"}?mode=ro', uri=True)\n   211\t    target = sqlite3.connect(path)\n   212\t    source.backup(target)\n   213\t    source.close()\n   214\t    triggers = target.execute(\"select name, sql from sqlite_master where type='trigger'\").fetchall()\n   215\t    for name, _ in triggers:\n   216\t        target.execute(f'drop trigger {name}')\n   217\t    boundary = target.execute('select seq from days_completed where day=?', (BOUNDARY_DAY,)).fetchone()[0]\n   218\t    later_views = [r[0] for r in target.execute('select view_id from views where created_seq>?', (boundary,))]\n   219\t    for table, column in (('judgements', 'seq'), ('evidence_links', 'seq'), ('evidence_sources', 'seq'), ('same_claims', 'seq'),\n   220\t                          ('revisions', 'seq'), ('replacements', 'seq'), ('view_switches', 'after_seq'), ('successions', 'seq'),\n   221\t                          ('days_completed', 'seq'), ('evidence', 'created_seq')):\n   222\t        target.execute(f'delete from {table} where {column}>?', (boundary,))\n   223\t    for table in ('views', 'rungs', 'view_keys'):\n   224\t        target.execute(f\"delete from {table} where view_id in ({','.join('?' * len(later_views))})\", later_views)\n   225\t    for _, sql in triggers:\n   226\t        target.execute(sql)\n   227\t    target.commit()\n   228\t    counts = {t: target.execute(f'select max({c}) from {t}').fetchone()[0] for t, c in (('judgements', 'seq'), ('evidence_links', 'seq'),\n   229\t              ('evidence', 'created_seq'), ('evidence_sources', 'seq'), ('views', 'created_seq'))}\n   230\t    if any(v is not None and v > boundary for v in counts.values()):\n   231\t        raise SystemExit(f'the cutoff copy holds a later row: {counts}')\n   232\t    target.close()\n   233\t    return boundary\n   234\t\n   235\t\n   236\tdef restore_closures(conn, draw, targets, seq):\n   237\t    \"\"\"After a day's judging, the target questions the old system switched off by the end of that day are switched off as it did.\"\"\"\n   238\t    source = old_store(draw)\n   239\t    marks = ','.join('?' * len(targets))\n   240\t    for row in source.execute(f'select * from view_switches where view_id in ({marks}) and open=0 and after_seq<=?', (*targets, seq)):\n   241\t        if not conn.execute('select 1 from view_switches where view_id=? and open=0 and after_seq=?', (row['view_id'], row['after_seq'])).fetchone():\n   242\t            conn.execute('insert into view_switches (view_id, open, reason, by_whom, after_seq) values (?,?,?,?,?)',\n   243\t                         (row['view_id'], 0, row['reason'], row['by_whom'], row['after_seq']))\n   244\t\n   245\t\n   246\tdef restore_view(conn, draw, view_id):\n   247\t    \"\"\"Put a target question back as the old system created it: its row, choices, key and opening switch.\"\"\"\n   248\t    source = old_store(draw)\n   249\t    for table in ('views', 'rungs', 'view_keys'):\n   250\t        for row in source.execute(f'select * from {table} where view_id=?', (view_id,)):\n   251\t            conn.execute(f\"insert into {table} ({','.join(row.keys())}) values ({','.join('?' * len(row))})\", tuple(row))\n   252\t    row = source.execute('select * from view_switches where view_id=? and open=1 order by id limit 1', (view_id,)).fetchone()\n   253\t    conn.execute('insert into view_switches (view_id, open, reason, by_whom, after_seq) values (?,?,?,?,?)',\n   254\t                 (view_id, 1, row['reason'], row['by_whom'], row['after_seq']))\n   300\tdef control_feed(draw, targets, conn, log):\n   301\t    \"\"\"The control arm: the old system's own window links to the target questions, with the evidence they point to and its sources,\n   302\t    copied with the ids and sequence numbers the old system gave them; and every repeat, revision or replacement relation touching\n   303\t    evidence linked to a target question, with its counterpart's evidence and sources, from the day it was written.\"\"\"\n   304\t    old = old_store(draw)\n   305\t    marks = ','.join('?' * len(targets))\n   306\t    relations = (('same_claims', 'old_evidence_id', 'new_evidence_id'), ('revisions', 'old_evidence_id', 'new_evidence_id'),\n   307\t                 ('replacements', 'old_evidence_id', 'new_evidence_id'))\n   308\t    copied = set()\n   309\t\n   310\t    def bring(evidence_id, seq):\n   311\t        copy_rows(conn, old, 'evidence', 'evidence_id=?', (evidence_id,))\n   312\t        copy_rows(conn, old, 'evidence_sources', 'evidence_id=? and seq<=?', (evidence_id, seq))\n   313\t\n   314\t    def feed(day, previous_seq, seq, pending):\n   315\t        changed = set()\n   316\t        for link in old.execute(f'select * from evidence_links where view_id in ({marks}) and seq>? and seq<=? order by seq, id',\n   317\t                                (*targets, previous_seq, seq)).fetchall():\n   318\t            bring(link['evidence_id'], seq)\n   319\t            conn.execute('insert into evidence_links (evidence_id, view_id, seq) values (?,?,?)', (link['evidence_id'], link['view_id'], link['seq']))\n   320\t            changed.add(link['view_id'])\n   321\t            log.append({'day': day, 'evidence': link['evidence_id'], 'view': link['view_id'], 'seq': link['seq']})\n   322\t        for evidence_id in [r[0] for r in conn.execute(f'select distinct evidence_id from evidence_links where view_id in ({marks})', tuple(targets))]:\n   323\t            copy_rows(conn, old, 'evidence_sources', 'evidence_id=? and seq>? and seq<=?', (evidence_id, previous_seq, seq))\n   324\t        linked = {r[0] for r in conn.execute(f'select evidence_id from evidence_links where view_id in ({marks})', tuple(targets))}\n   325\t        for table, a, b in relations:\n   326\t            for row in old.execute(f'select * from {table} where seq<=? order by seq, id', (seq,)).fetchall():\n   327\t                if (table, row['id']) in copied or not ({row[a], row[b]} & linked):\n   328\t                    continue\n   329\t                for evidence_id in (row[a], row[b]):\n   330\t                    bring(evidence_id, seq)\n   331\t                copy_rows(conn, old, table, 'id=?', (row['id'],))\n   332\t                copied.add((table, row['id']))\n   333\t                log.append({'day': day, 'relation': table, 'pair': [row[a], row[b]], 'seq': row['seq']})\n   334\t        return changed\n   335\t    return feed\n   336\t\n   337\t\n   338\tclass ReplayOld:\n   339\t    \"\"\"$0 transport for the replay check: answers each judge request with the old system's archived answer for the same view on the\n   340\t    same day, and records whether the request text equals the archived request (theme questions) or shows the same evidence ids.\"\"\"\n   341\t\n   342\t    def __init__(self, draw):\n   343\t        from hivemind.views import judging\n   344\t        self.judging = judging\n   345\t        self.old = sqlite3.connect(f'file:{RUN / draw / \"prod/views.sqlite\"}?mode=ro', uri=True, check_same_thread=False)\n   346\t        self.old.row_factory = sqlite3.Row\n   347\t        self.archive = sqlite3.connect(f'file:{RUN / draw / \"prod/archive.sqlite\"}?mode=ro', uri=True, check_same_thread=False)\n   348\t        self.seq = None\n   349\t        self.checks = []\n   350\t\n   351\t    def __call__(self, provider, request):\n   352\t        import re\n   353\t        text = request['messages'][-1]['content']\n   354\t        view_id = re.search(r'^Thesis (\\S+) \\(', text, re.M).group(1)\n   355\t        row = self.old.execute('select call_id from judgements where view_id=? and seq=? order by judgement_id limit 1', (view_id, self.seq)).fetchone()\n   356\t        old_request, old_response = self.archive.execute('select request_json, response_json from model_calls where call_id=?', (row['call_id'],)).fetchone()\n   357\t        old_text = json.loads(old_request)['messages'][-1]['content']\n   358\t        self.checks.append({'seq': self.seq, 'view': view_id, 'same text': text == old_text,\n   359\t                            'same evidence shown': sorted(self.judging.evidence_shown_in(text)) == sorted(self.judging.evidence_shown_in(old_text))})\n   360\t        return json.loads(old_response)\n   361\t\n   362\t\n   363\tdef judge(ledger_path, arm, replay_check=False):\n   380\t    only = [d for d in sys.argv[4:]]            # optional: the draws to judge in this process\n   381\t    for draw, targets in TARGETS.items():\n   382\t        if only and draw not in only:\n   383\t            continue\n   384\t        folder = OUT / (f'judge-{arm}' if not replay_check else 'judge-replaycheck') / draw\n   385\t        folder.mkdir(parents=True, exist_ok=False)\n   386\t        if replay_check:\n   387\t            transport = ReplayOld(draw)\n   388\t        boundary = judging_copy(draw, folder / 'views.sqlite')\n   389\t        conn = store.open_db(str(folder / 'views.sqlite'))\n   390\t        archive = model.Archive(str(folder / 'archive.sqlite'))\n   391\t        old = old_store(draw)\n   392\t        day_seq = dict(old.execute('select day, seq from days_completed').fetchall())\n   393\t        created = {v: old.execute('select created_seq from views where view_id=?', (v,)).fetchone()[0] for v in targets}\n   394\t        pending = {v for v, s in created.items() if s > boundary}\n   395\t        log = []\n   396\t        feed = hybrid_feed(draw, targets, conn, store, adapter, log) if arm == 'hybrid' else control_feed(draw, targets, conn, log)\n   397\t        previous_seq = boundary\n   398\t        for day in sorted(d for d in day_seq if BOUNDARY_DAY < d <= LAST_DAY):\n   399\t            seq = day_seq[day]\n   400\t            for view_id in sorted(pending):\n   401\t                if created[view_id] <= seq:\n   402\t                    restore_view(conn, draw, view_id)\n   403\t                    pending.discard(view_id)\n   404\t            changed = feed(day, previous_seq, seq, pending)\n   405\t            previous_seq = seq\n   406\t            conn.commit()\n   407\t            if replay_check:      # the old system's own schedule, so each request can be compared with the archived one\n   408\t                changed = {r[0] for r in old.execute(f\"select view_id from judgements where seq=? and view_id in ({','.join('?' * len(targets))})\",\n   409\t                                                       (seq, *targets))}\n   410\t            else:                 # one schedule for both arms: every open target question with evidence in force, every day to 09-20\n   411\t                changed = {v for v in targets if v not in pending}\n   412\t            if changed:\n   413\t                if replay_check:\n   414\t                    transport.seq = seq\n   415\t                judged = judging.round_of_judgements(archive, cfg, conn, sorted(changed), seq, {'input_id': f'day:{day}', 'publication_day': day},\n   416\t                                                     transport=transport)\n   417\t                conn.commit()\n   418\t                for j in judged:\n   419\t                    log.append({'day': day, 'view': j['view_id'], 'rung': j['rung'], 'changed': j['changed']})\n   420\t                    print(json.dumps({'draw': draw, 'day': day, 'view': j['view_id'], 'rung': j['rung']}), flush=True)\n   421\t            restore_closures(conn, draw, list(targets), seq)\n   422\t            conn.commit()\n   423\t        results[draw] = log\n   424\t        (folder / 'log.json').write_text(json.dumps(log, indent=1, ensure_ascii=False))\n   425\t        if replay_check:\n   426\t            (folder / 'checks.json').write_text(json.dumps(transport.checks, indent=1))\n   427\t            print(draw, json.dumps(transport.checks))\n   428\t    if not replay_check:\n   429\t        print('ledger', json.dumps(json.loads(Path(ledger_path).read_text())))\nchecks 72 72 72 {'seq': 1788, 'view': 'v41', 'same text': True, 'same evidence shown': True}\nby day Counter({'2026-09-17': 36, '2026-09-18': 36})\nv5 [{'day': '2026-09-18', 'view': 'v5', 'rung': 4, 'changed': True}]\nfeed rows 2854\nfeed keys ['day', 'evidence', 'view', 'seq']\n","exit_code":0,"status":"completed"}}
