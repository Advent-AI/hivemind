{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc 'ls -l poc/data/hybrid-2026-11-20/{fullscore,probescore,marks-full,marks-probe}.json; cat poc/data/hybrid-2026-11-20/fullscore.json; cat poc/data/hybrid-2026-11-20/probescore.json; ls -1 poc/data/hybrid-2026-11-20'","aggregated_output":"-rw-r--r--@ 1 lchingen  staff     558 Nov 19 23:16 poc/data/hybrid-2026-11-20/fullscore.json\n-rw-r--r--@ 1 lchingen  staff   51135 Nov 19 23:16 poc/data/hybrid-2026-11-20/marks-full.json\n-rw-r--r--@ 1 lchingen  staff  109643 Nov 19 23:16 poc/data/hybrid-2026-11-20/marks-probe.json\n-rw-r--r--@ 1 lchingen  staff     918 Nov 19 23:16 poc/data/hybrid-2026-11-20/probescore.json\n{\n \"targets held\": {\n  \"v7-fullprev\": 0,\n  \"v7-fullnoprev\": 4\n },\n \"controls held\": {\n  \"v7-fullprev\": 8,\n  \"v7-fullnoprev\": 8\n },\n \"repaired\": [\n  \"T-old-1-Q7\",\n  \"T-old-2-Q16\",\n  \"T-old-3-Q37\",\n  \"T-old-3-Q7\"\n ],\n \"broken\": [],\n \"net\": 4,\n \"controls lost\": [],\n \"refused\": {\n  \"v7-fullprev\": 0,\n  \"v7-fullnoprev\": 0\n },\n \"plants\": {\n  \"C028\": {\n   \"worth\": \"worth\",\n   \"answer\": \"unsupported\"\n  },\n  \"C086\": {\n   \"worth\": \"worth\",\n   \"answer\": \"unsupported\"\n  },\n  \"C120\": {\n   \"worth\": \"worth\",\n   \"answer\": \"unsupported\"\n  }\n },\n \"screen passes\": false\n}{\n \"report\": {\n  \"v7\": {\n   \"targets held (>=2 of 3)\": 1,\n   \"paired improved\": [],\n   \"paired worsened\": [],\n   \"net\": 0,\n   \"controls lost\": [\n    \"C-new-2-Q14\",\n    \"C-new-3-Q33\",\n    \"C-old-2-Q15\"\n   ],\n   \"refused answers\": 0\n  },\n  \"J2a\": {\n   \"targets held (>=2 of 3)\": 2,\n   \"paired improved\": [\n    \"T-new-3-Q26\"\n   ],\n   \"paired worsened\": [],\n   \"net\": 1,\n   \"controls lost\": [\n    \"C-new-2-Q14\",\n    \"C-new-3-Q33\"\n   ],\n   \"refused answers\": 0\n  },\n  \"J2b\": {\n   \"targets held (>=2 of 3)\": 4,\n   \"paired improved\": [\n    \"T-new-2-Q4\",\n    \"T-new-3-Q26\",\n    \"T-old-2-Q16\"\n   ],\n   \"paired worsened\": [],\n   \"net\": 3,\n   \"controls lost\": [\n    \"C-new-3-Q33\"\n   ],\n   \"refused answers\": 0\n  }\n },\n \"plants\": {\n  \"C209\": {\n   \"worth\": \"worth\",\n   \"answer\": \"unsupported\"\n  },\n  \"C301\": {\n   \"worth\": \"worth\",\n   \"answer\": \"unsupported\"\n  },\n  \"C347\": {\n   \"worth\": \"worth\",\n   \"answer\": \"unsupported\"\n  }\n }\n}account\naccount.log\ncases.json\ndeck-full\ndeck-probe\nforkcases.json\nfullcases.json\nfullscore.json\ngoldcases.json\ngoldprobe\ngoldprobe-J2a.log\ngoldprobe-J2b.log\ngoldprobe-v7-noprev.log\ngoldprobe-v7.log\nhidden-flags.json\nledger\nmarks-full.json\nmarks-probe.json\nprobe\nprobe-J2a.log\nprobe-J2b-noprev.log\nprobe-J2b.log\nprobe-v7-fullnoprev.log\nprobe-v7-fullprev.log\nprobe-v7-noprev.log\nprobe-v7.log\nprobescore.json\nprodpath\nread-full-2.log\nread-full.log\nread-probe-2.log\nread-probe.log\nwindow\nwindow-old-2-replay.log\n","exit_code":0,"status":"completed"}}
