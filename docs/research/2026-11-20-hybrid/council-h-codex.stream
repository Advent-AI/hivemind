{"type":"item.started","item":{"id":"item_15","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"python3 -B -c 'import sqlite3,re; db=sqlite3.connect(\\\"file:poc/data/comparison-2026-11-17/items-comparison.sqlite?mode=ro\\\",uri=True); ids=(\\\"edgar:NVDA:0001045810-26-000075:nvda-20260726.htm\\\",\\\"gnews:aec1fae1b903de5c43ba7fdf\\\",\\\"gnews:2544f0dce0571202a4bcbc2e\\\");\nfor id,title,t,a in db.execute(\\\"select input_id,title,text,text_article from items where input_id in (?,?,?)\\\",ids):\n print(id,title);\n body=t or a or \\\"\\\"; matches=list(re.finditer(r\\\"(?:\\\\\"'$|'\"\\\\b)18(?:\\\\.0)?\\\\s*(?:billion|,000)|equity investment commitments of \\\\\"'$25 billion\",body,re.I));\n for m in matches: print(\" \".join(body[max(0,m.start()-175):m.end()+170].split()))'\"'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
