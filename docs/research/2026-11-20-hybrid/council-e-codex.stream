{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"rg -n '\"'^def (probescore|expected_files|deck|read|goldscore|prodpath)|invalid|scheduled|added|locked'\"' docs/research/2026-11-20-hybrid/judge_probe.py; nl -ba docs/research/2026-11-20-hybrid/judge_probe.py | sed -n '385,655p'\"","aggregated_output":"12:  python3 judge_probe.py probescore             # $0: the locked rule (a)(b)(d) per arm against v7's re-send, after read\n80:def readonly(path):\n353:def expected_files(folder, names, repeats=3):\n360:def goldscore(arm):\n392:def deck(arms):\n417:                item['kind'] = 'invalid rung'\n453:    PROBE_KEY.write_text(json.dumps({'cards': key, 'invalid': [c for c in cards if c['text'] is None], 'plant_confirmations': confirmations},\n456:    print(len(readable), 'cards;', dict(Counter((c['arm'], c['kind']) for c in readable)), '; invalid rungs:', sum(c['text'] is None for c in cards))\n459:def read():\n493:def prodpath(arm, ledger_path=None):\n538:        scheduled = sorted(round_module.changed_views_of_day(conn, day))     # production's own starting queue (council D)\n542:        judged = judging.round_of_judgements(archive, cfg, conn, scheduled, seq, {'input_id': f'day:{day}', 'publication_day': day},\n548:            results.append({'day': day, 'view': j['view_id'], 'rung': j['rung'], 'changed': j['changed'], 'queued_by_round': j['view_id'] not in scheduled})\n550:        print(json.dumps({'arm': arm, 'day': day, 'starting queue': len(scheduled), 'judged': len(judged),\n551:                          'added by the round': len(judged_set - set(scheduled)), 'same set as old': judged_set == old_judged,\n564:def probescore(arms=('v7', 'J2a', 'J2b')):\n565:    \"\"\"$0, after `read`: the locked decision rule (DESIGN-J2.md (a), (b), (d)) per arm against v7's re-send. Every arm x case x repeat\n566:    must be accounted for; an invalid-rung answer counts as refused and not supported. Jointly supported = both readers' final answer\n578:    for m in key['invalid']:\n   385\t    per_repeat = {k: sum(t['agree'] for (d, kk), t in tally.items() if kk == k) for k in (1, 2, 3)}\n   386\t    strict = {k: sum(t['agree_not_refused'] for (d, kk), t in tally.items() if kk == k) for k in (1, 2, 3)}\n   387\t    refused = sum(t['refused'] for t in tally.values())\n   388\t    print(f'{arm}: agreement per repeat {per_repeat} of {len(rows)}; counting refused as not agreeing {strict}; refused answers {refused} of {3 * len(rows)}')\n   389\t    return per_repeat, strict, refused\n   390\t\n   391\t\n   392\tdef deck(arms):\n   393\t    \"\"\"Blind deck: every probe answer of every arm and repeat (council B: a same-rung answer can be better or worse reasoned), with the\n   394\t    production check's refusals recorded in the key, and plants\n   395\t    (a control's v7 answer moved one rung, entered only when a separate closed reader confirms it is not supported). Shuffled; the key\n   396\t    is kept outside the repository and never overwritten.\"\"\"\n   397\t    sys.path[:0] = [str(STAGE0), str(STAGE0 / 'census')]\n   398\t    import mark_cards\n   399\t    if PROBE_KEY.exists():\n   400\t        raise SystemExit(f'refused: {PROBE_KEY} exists')\n   401\t    folder = OUT / 'deck-probe'\n   402\t    folder.mkdir(parents=True, exist_ok=False)\n   403\t    rows = {c['case']: c for c in json.loads((OUT / 'cases.json').read_text())}\n   404\t    for arm in arms:\n   405\t        expected_files(OUT / 'probe' / arm, list(rows))\n   406\t    stored_rung = {name: stored(case)[0]['rung'] for name, case in rows.items()}\n   407\t    rng = random.Random(SEED)\n   408\t    cards = []\n   409\t    for arm in arms:\n   410\t        for path in sorted((OUT / 'probe' / arm).glob('*.json')):\n   411\t            record = json.loads(path.read_text())\n   412\t            case = rows[record['case']['case']]\n   413\t            built = probe_card(case, record['answer'])\n   414\t            item = {'arm': arm, 'case': case['case'], 'role': case['role'], 'repeat': record['repeat'], 'rung': record['answer']['rung'],\n   415\t                    'stored_rung': stored_rung[case['case']], 'kind': 'probe'}\n   416\t            if built is None:                      # counted as refused and not supported by probescore (council D)\n   417\t                item['kind'] = 'invalid rung'\n   418\t                item['refusals'] = refusals(case, record['answer'])\n   419\t                cards.append(dict(item, text=None))\n   420\t                continue\n   421\t            item['text'] = built[0]\n   422\t            item['changed'] = item['rung'] != item['stored_rung']\n   423\t            item['refusals'] = refusals(case, record['answer'])\n   424\t            cards.append(item)\n   425\t    confirmations = []\n   426\t    controls = [c for c in rows.values() if c['role'] == 'control']\n   427\t    for case in rng.sample(controls, len(controls)):\n   428\t        if sum(c['kind'] == 'plant' for c in cards) >= PLANTS:\n   429\t            break\n   430\t        record = json.loads((OUT / 'probe' / 'v7' / f\"{case['case']}-1.json\").read_text())\n   431\t        built = probe_card(case, record['answer'])\n   432\t        if built is None:\n   433\t            continue\n   434\t        text, labels = built\n   435\t        rung = record['answer']['rung']\n   436\t        moved = rung + 1 if rung + 1 in labels else rung - 1\n   437\t        if moved not in labels:\n   438\t            continue\n   439\t        planted = text.replace(f'Latest answer at the cutoff: {labels[rung]}', f'Latest answer at the cutoff: {labels[moved]}', 1)\n   440\t        ok, mark = mark_cards.confirmed_by_reader(planted, False)\n   441\t        confirmations.append({'case': case['case'], 'moved_to': moved, 'confirmed': ok, 'mark': mark})\n   442\t        if ok:\n   443\t            cards.append({'arm': 'plant', 'case': case['case'], 'role': 'plant', 'repeat': 1, 'rung': moved, 'stored_rung': rung,\n   444\t                          'kind': 'plant', 'text': planted})\n   445\t    readable = [c for c in cards if c['text'] is not None]\n   446\t    rng.shuffle(readable)\n   447\t    key = {}\n   448\t    for n, card in enumerate(readable, 1):\n   449\t        cid = f'C{n:03d}'\n   450\t        key[cid] = {k: v for k, v in card.items() if k != 'text'}\n   451\t        (folder / f'{cid}.txt').write_text(card['text'])\n   452\t    PROBE_KEY.parent.mkdir(parents=True, exist_ok=True)\n   453\t    PROBE_KEY.write_text(json.dumps({'cards': key, 'invalid': [c for c in cards if c['text'] is None], 'plant_confirmations': confirmations},\n   454\t                                    indent=1) + '\\n')\n   455\t    from collections import Counter\n   456\t    print(len(readable), 'cards;', dict(Counter((c['arm'], c['kind']) for c in readable)), '; invalid rungs:', sum(c['text'] is None for c in cards))\n   457\t\n   458\t\n   459\tdef read():\n   460\t    \"\"\"Both reader families mark every card (mark_cards.mark), then debate rounds 1 and 2; marks.json beside the deck's key fields.\"\"\"\n   461\t    sys.path[:0] = [str(STAGE0), str(STAGE0 / 'census')]\n   462\t    import mark_cards\n   463\t    key = json.loads(PROBE_KEY.read_text())['cards']\n   464\t    mark_cards.KEY = PROBE_KEY\n   465\t    folder = OUT / 'deck-probe'\n   466\t    if not (folder / 'round-0.done').exists():\n   467\t        mark_cards.mark(folder)\n   468\t    for round_number in (1, 2):\n   469\t        if not (folder / f'round-{round_number}.done').exists():\n   470\t            mark_cards.debate(folder, round_number)\n   471\t    finals = {cid: mark_cards.final(folder, cid) for cid in sorted(key)}\n   472\t    (OUT / 'marks-probe.json').write_text(json.dumps({cid: dict(key[cid], marks=finals[cid]) for cid in key}, indent=1, ensure_ascii=False))\n   473\t    print('marked', len(finals))\n   474\t\n   475\t\n   476\tdef patch_judging(arm):\n   477\t    \"\"\"Put an arm into the judge's own code path for this process: the schema's field order and, when it differs from v7, the system\n   478\t    text. Nothing in the package is edited.\"\"\"\n   479\t    from hivemind.views import judging\n   480\t    system, order = arm_spec(arm)\n   481\t    original_schema, original_prompt = judging.schema_for, judging.build_prompt\n   482\t    frozen = FROZEN_SYSTEM.read_text(encoding='utf-8')\n   483\t    if order is not None:\n   484\t        def schema_for(version):\n   485\t            schema = original_schema(version)\n   486\t            schema['properties'] = {field: schema['properties'][field] for field in order}\n   487\t            return schema\n   488\t        judging.schema_for = schema_for\n   489\t    if system != frozen:\n   490\t        judging.build_prompt = lambda conn, view_id, version: (system, original_prompt(conn, view_id, version)[1])\n   491\t\n   492\t\n   493\tdef prodpath(arm, ledger_path=None):\n   494\t    \"\"\"The production-path check (council A): a copy of old-2 cut at the end of PRODPATH_BOUNDARY. On each of PRODPATH_DAYS every link the\n   495\t    old system wrote that day is fed (every question, with the evidence, its sources and its repeat and revision relations), and the\n   496\t    judge's own round judges the questions the old system judged at that day's close, unpatched otherwise: a changed theme queues its\n   497\t    assets as in production. 'replay' answers with the old archived answers at $0 and checks each request's bytes against the archived\n   498\t    one; any other arm sends, with an empty archive of its own (council B: J2a and v7 share an archive key).\"\"\"\n   499\t    mt = load('merge_test', MERGE_TEST)\n   500\t    mt.BOUNDARY_DAY = PRODPATH_BOUNDARY\n   501\t    from hivemind import config, model\n   502\t    from hivemind.views import judging, store\n   503\t    cfg = config.load(CONFIG)\n   504\t    folder = OUT / 'prodpath' / arm\n   505\t    folder.mkdir(parents=True, exist_ok=False)\n   506\t    boundary = mt.judging_copy(PRODPATH_DRAW, folder / 'views.sqlite')\n   507\t    conn = store.open_db(str(folder / 'views.sqlite'))\n   508\t    archive = model.Archive(str(folder / 'archive.sqlite'))\n   509\t    old = mt.old_store(PRODPATH_DRAW)\n   510\t    all_views = [r[0] for r in old.execute('select view_id from views')]\n   511\t    day_seq = dict(old.execute('select day, seq from days_completed').fetchall())\n   512\t    created = {v: old.execute('select created_seq from views where view_id=?', (v,)).fetchone()[0] for v in all_views}\n   513\t    pending = {v for v, c in created.items() if c > boundary}\n   514\t    log = []\n   515\t    feed = mt.control_feed(PRODPATH_DRAW, all_views, conn, log)\n   516\t    if arm == 'replay':\n   517\t        import threading\n   518\t        replay, lock = mt.ReplayOld(PRODPATH_DRAW), threading.Lock()\n   519\t\n   520\t        def transport(provider, request):          # one sqlite connection answers the round's concurrent calls one at a time\n   521\t            with lock:\n   522\t                return replay(provider, request)\n   523\t        transport.checks, transport.replay = replay.checks, replay\n   524\t    else:\n   525\t        patch_judging(arm)\n   526\t        transport, ledger = transport_for(ledger_path)\n   527\t    previous = boundary\n   528\t    results = []\n   529\t    for day in PRODPATH_DAYS:\n   530\t        seq = day_seq[day]\n   531\t        for view_id in sorted(v for v in pending if created[v] <= seq):\n   532\t            mt.restore_view(conn, PRODPATH_DRAW, view_id)\n   533\t            pending.discard(view_id)\n   534\t        feed(day, previous, seq, pending)\n   535\t        previous = seq\n   536\t        conn.commit()\n   537\t        from hivemind.views import round as round_module\n   538\t        scheduled = sorted(round_module.changed_views_of_day(conn, day))     # production's own starting queue (council D)\n   539\t        old_judged = {r[0] for r in old.execute('select view_id from judgements where seq=?', (seq,))}\n   540\t        if arm == 'replay':\n   541\t            transport.replay.seq = seq\n   542\t        judged = judging.round_of_judgements(archive, cfg, conn, scheduled, seq, {'input_id': f'day:{day}', 'publication_day': day},\n   543\t                                             transport=transport)\n   544\t        conn.commit()\n   545\t        mt.restore_closures(conn, PRODPATH_DRAW, all_views, seq)\n   546\t        conn.commit()\n   547\t        for j in judged:\n   548\t            results.append({'day': day, 'view': j['view_id'], 'rung': j['rung'], 'changed': j['changed'], 'queued_by_round': j['view_id'] not in scheduled})\n   549\t        judged_set = {j['view_id'] for j in judged}\n   550\t        print(json.dumps({'arm': arm, 'day': day, 'starting queue': len(scheduled), 'judged': len(judged),\n   551\t                          'added by the round': len(judged_set - set(scheduled)), 'same set as old': judged_set == old_judged,\n   552\t                          'old only': sorted(old_judged - judged_set), 'arm only': sorted(judged_set - old_judged)}), flush=True)\n   553\t    (folder / 'results.json').write_text(json.dumps(results, indent=1))\n   554\t    (folder / 'feed-log.json').write_text(json.dumps(log, indent=1))\n   555\t    if arm == 'replay':\n   556\t        checks = transport.checks\n   557\t        (folder / 'checks.json').write_text(json.dumps(checks, indent=1))\n   558\t        print('replay:', sum(c['same text'] for c in checks), 'of', len(checks), 'requests byte-identical to the archived ones;',\n   559\t              sum(c['same evidence shown'] for c in checks), 'show the same evidence')\n   560\t    else:\n   561\t        print('ledger', json.dumps(ledger.read()))\n   562\t\n   563\t\n   564\tdef probescore(arms=('v7', 'J2a', 'J2b')):\n   565\t    \"\"\"$0, after `read`: the locked decision rule (DESIGN-J2.md (a), (b), (d)) per arm against v7's re-send. Every arm x case x repeat\n   566\t    must be accounted for; an invalid-rung answer counts as refused and not supported. Jointly supported = both readers' final answer\n   567\t    mark is `supported` (a split is not).\"\"\"\n   568\t    key = json.loads(PROBE_KEY.read_text())\n   569\t    marks = json.loads((OUT / 'marks-probe.json').read_text())\n   570\t    rows = json.loads((OUT / 'cases.json').read_text())\n   571\t    supported, refused = {}, {}\n   572\t    for cid, m in marks.items():\n   573\t        if m['kind'] == 'plant':\n   574\t            continue\n   575\t        k = (m['arm'], m['case'], m['repeat'])\n   576\t        supported[k] = (m['marks'] or {}).get('answer') == 'supported'\n   577\t        refused[k] = bool(m.get('refusals'))\n   578\t    for m in key['invalid']:\n   579\t        k = (m['arm'], m['case'], m['repeat'])\n   580\t        supported[k], refused[k] = False, True\n   581\t    missing = [(a, c['case'], r) for a in arms for c in rows for r in (1, 2, 3) if (a, c['case'], r) not in supported]\n   582\t    if missing:\n   583\t        raise SystemExit(f'{len(missing)} answers not accounted for, e.g. {missing[:4]}: refused')\n   584\t    holds = {a: {c['case']: sum(supported[(a, c['case'], r)] for r in (1, 2, 3)) >= 2 for c in rows} for a in arms}\n   585\t    targets = [c['case'] for c in rows if c['role'] == 'target']\n   586\t    controls = [c['case'] for c in rows if c['role'] == 'control']\n   587\t    report = {}\n   588\t    for a in arms:\n   589\t        improved = [t for t in targets if holds[a][t] and not holds['v7'][t]]\n   590\t        worsened = [t for t in targets if holds['v7'][t] and not holds[a][t]]\n   591\t        lost = [c for c in controls if not holds[a][c]]\n   592\t        report[a] = {'targets held (>=2 of 3)': sum(holds[a][t] for t in targets), 'paired improved': improved, 'paired worsened': worsened,\n   593\t                     'net': len(improved) - len(worsened), 'controls lost': lost,\n   594\t                     'refused answers': sum(refused[(a, c['case'], r)] for c in rows for r in (1, 2, 3))}\n   595\t    for a in arms:\n   596\t        r = report[a]\n   597\t        verdict = '' if a == 'v7' else ('PASSES (a)(b)(d)' if r['targets held (>=2 of 3)'] >= 12 and r['net'] >= 8\n   598\t                                         and len(r['controls lost']) <= len(report['v7']['controls lost'])\n   599\t                                         and r['refused answers'] <= report['v7']['refused answers'] else 'does not pass (a)(b)(d)')\n   600\t        print(a, json.dumps(r), verdict)\n   601\t    plants = {cid: m['marks'] for cid, m in marks.items() if m['kind'] == 'plant'}\n   602\t    print('plants (expected not supported):', json.dumps(plants))\n   603\t    (OUT / 'probescore.json').write_text(json.dumps({'report': report, 'plants': plants}, indent=1))\n   604\t\n   605\t\n   606\tif __name__ == '__main__':\n   607\t    command = sys.argv[1]\n   608\t    if command == 'cases':\n   609\t        cases()\n   610\t    elif command == 'check':\n   611\t        check()\n   612\t    elif command == 'account':\n   613\t        account(sys.argv[2])\n   614\t    elif command == 'probe':\n   615\t        probe(sys.argv[2], sys.argv[3], int(sys.argv[4]))\n   616\t    elif command == 'goldcases':\n   617\t        goldcases()\n   618\t    elif command == 'goldprobe':\n   619\t        goldprobe(sys.argv[2], sys.argv[3], int(sys.argv[4]))\n   620\t    elif command == 'goldscore':\n   621\t        goldscore(sys.argv[2])\n   622\t    elif command == 'probescore':\n   623\t        probescore()\n   624\t    elif command == 'deck':\n   625\t        deck(sys.argv[2:])\n   626\t    elif command == 'read':\n   627\t        read()\n   628\t    elif command == 'prodpath':\n   629\t        prodpath(sys.argv[2], sys.argv[3] if len(sys.argv) > 3 else None)\n   630\t    else:\n   631\t        raise SystemExit(__doc__)\n","exit_code":0,"status":"completed"}}
