gets moved off the stored rung (2 of 3)': {'v7': 0, 'H1': 0}, 'controls held': {'v7': 2, 'H1': 2}, 'repaired': [], 'broken': [], 'net': 0, 'controls lost': [], 'refused': {}, 'plants': {'C005': {'worth': 'worth', 'answer': 'unsupported'}, 'C030': {'worth': 'worth', 'answer': 'unsupported'}}, 'screen passes': False, 'inconclusive': False}\nopening-census.json [{'matter': 'M01', 'name': 'Broadcom FY2027 AI semiconductor revenue', 'question': \"What will Broadcom's AI semiconductor revenue be in FY2027?\", 'company_figure': False, 'articles': 9, 'covered_by': {'old-1': [], 'old-2': [], 'old-3': []}, 'draws': {'old-1': {'candidates': [], 'linked': {\"What will NVIDIA's total revenue be in FY2028?\": 8, \"What will NVIDIA's total revenue be in FY2027?\": 7, 'How much Data Center segment revenue will NVIDIA report for FY2027?': 5, \"How much will NVIDIA's total revenue grow year over year in FY2028?\": 3, 'Will NVIDIA begin shipping its Rubin platform by December 31, 2026?': 1, 'What gross margin will NVIDIA report for FY2027?': 1}, 'no_home': 1, 'evidence': 47}, 'old-2': {'candidates': [], 'linked': {'How much Data Center segment revenue will NVIDIA report for FY2027?': 7, \"How much will NVIDIA's total revenue grow in FY2028?\": 5, 'How much total revenue will NVIDIA report for FY2027?': 4, \"How much will NVIDIA's total revenue grow in FY2027?\": 2, 'Will NVIDIA begin shipping Vera Rubin by 2026-12-31?': 1, 'What gross margin will NVIDIA report for FY2027?': 1, 'How much total revenue will NVIDIA report for FY2028?': 1}, 'no_home': 8, 'evidence': 45}, 'old-3': {'candidates': [], 'linked': {'What will NVIDIA report as total revenue for FY2028?': 8, 'What will NVIDIA report as total revenue for FY20\nfreshpool.json [{'case': 'F-old-1-Q1', 'draw': 'old-1', 'label': 'Q1', 'view_id': 'v1', 'judgement_id': 1101, 'seq': 1474, 'day': '2026-09-06', 'request_sha256': 'b4fc48fef080f4a6f194f2b30d9b6a4998338d3424e7c8dada041f18a8682cd9', 'rung': 5, 'previous_rung': 5, 'held': True, 'hidden': 536, 'type': 'figure', 'worth_at_0920': 'worth'}, {'case': 'F-old-1-Q2', 'draw': 'old-1', 'label': 'Q2', 'view_id': 'v2', 'judgement_id': 1106, 'seq': 1474, 'day': '2026-09-06', 'request_sha256': 'dca115f7f6c9c1ea32bb477025ecbc1d29b296374e939168fecd6f3875f7b7ad', 'rung': 5, 'previous_rung': 5, 'held': True, 'hidden': 542, 'type': 'figure', 'worth_at_0920': 'worth'}, {'case': 'F-old-1-Q3', 'draw': 'old-1', 'label': 'Q3', 'view_id': 'v3', 'judgement_id': 1110, 'seq': 1474, 'day': '2026-09-06', 'request_sha256': '55bdbcc990cc64394d59e4662a7924754dbf9c330ef8a22f40e621cf35c9046e', 'rung': 1, 'previous_rung': 1, 'held': True, 'hidden': 288, 'type': 'yes/no', 'worth_at_0920': 'worth'}, {'case': 'F-old-1-Q4', 'draw': 'old-1', 'label': 'Q4', 'view_id': 'v4', 'judgement_id': 1113, 'seq': 1474, 'day': '2026-09-06', 'request_sha256': '894ef2f6d66eaee31c7409acf22633df23091cc4324352a7301ce91daae41a79', 'rung': 2, 'previous_rung': 2, 'held': True, 'hidden': 1625, 'type': 'figure', 'worth_at_0920': 'worth'}, {'case': 'F-old-1-Q5', 'draw': 'old-1', 'label': 'Q5', 'view_id': 'v5', \nmarks-full.json {'C001': {'arm': 'v7-fullnoprev', 'case': 'C-old-1-Q34', 'role': 'control', 'repeat': 1, 'rung': 3, 'stored_rung': 3, 'kind': 'probe', 'refusals': [], 'marks': {'worth': 'worth', 'answer': 'supported'}}, 'C002': {'arm': 'v7-fullnoprev', 'case': 'T-old-3-Q23', 'role': 'target', 'repeat': 2, 'rung': 1, 'stored_rung': 1, 'kind': 'probe', 'refusals': ['e1299 is not among the evidence shown to v23', 'e1337 is not among the evidence shown to v23', 'e1404 is not among the evidence shown to v23', 'e1426 is not among the evidence shown to v23', 'e1724 is not among the evidence shown to v23', 'push on e1299 which was not shown to v23', 'push on e1337 which was not shown to v23', 'push on e1404 which was not shown to v23', 'push on e1426 which was not shown to v23', 'push on e1724 which was not shown to v23'], 'marks': {'worth': 'worth', 'answer': {'split': ['insufficient', 'unsupported']}}}, 'C003': {'arm': 'v7-fullprev', 'case': 'T-new-3-Q4', 'role': 'target', 'repeat': 2, 'rung': 2, 'stored_rung': 2, 'kind': 'probe', 'refusals': [], 'marks': {'worth': 'worth', 'answer': 'unsupported'}}, 'C004': {'arm': 'v7-fullnoprev', 'case': 'T-old-3-Q23', 'role': 'target', 'repeat': 1, 'rung': 1, 'stored_rung': 1, 'kind': 'probe', 'refusals': ['push on e1299 which was not shown to v23', 'push on e1337 which was not shown to v23', 'push on e1404 which\nmarks-fresh-census.json {'C001': {'arm': 'stored', 'case': 'F-old-1-Q32', 'role': 'pool', 'repeat': 0, 'rung': 5, 'stored_rung': 5, 'kind': 'stored', 'marks': {'worth': 'worth', 'answer': 'insufficient'}}, 'C002': {'arm': 'stored', 'case': 'F-old-1-Q19', 'role': 'pool', 'repeat': 0, 'rung': 1, 'stored_rung': 1, 'kind': 'stored', 'marks': {'worth': 'worth', 'answer': 'supported'}}, 'C003': {'arm': 'stored', 'case': 'F-new-2-Q9', 'role': 'pool', 'repeat': 0, 'rung': 1, 'stored_rung': 1, 'kind': 'stored', 'marks': {'worth': 'worth', 'answer': 'supported'}}, 'C004': {'arm': 'stored', 'case': 'F-old-1-Q37', 'role': 'pool', 'repeat': 0, 'rung': 1, 'stored_rung': 1, 'kind': 'stored', 'marks': {'answer': 'supported', 'worth': {'split': ['worth', 'duplicate']}}}, 'C005': {'arm': 'stored', 'case': 'F-old-1-Q35', 'role': 'pool', 'repeat': 0, 'rung': 1, 'stored_rung': 1, 'kind': 'stored', 'marks': {'worth': 'worth', 'answer': 'supported'}}, 'C006': {'arm': 'stored', 'case': 'F-new-3-Q13', 'role': 'pool', 'repeat': 0, 'rung': 1, 'stored_rung': 1, 'kind': 'stored', 'marks': {'worth': 'worth', 'answer': 'supported'}}, 'C007': {'arm': 'stored', 'case': 'F-new-3-Q32', 'role': 'pool', 'repeat': 0, 'rung': 1, 'stored_rung': 1, 'kind': 'stored', 'marks': {'worth': 'worth', 'answer': 'supported'}}, 'C008': {'arm': 'stored', 'case': 'F-old-2-Q31', 'role': 'pool', 'repeat': \nprodpath/replay/checks.json [{'seq': 1788, 'view': 'v10', 'same text': True, 'same evidence shown': True}, {'seq': 1788, 'view': 'v41', 'same text': True, 'same evidence shown': True}, {'seq': 1788, 'view': 'v6', 'same text': True, 'same evidence shown': True}, {'seq': 1788, 'view': 'v14', 'same text': True, 'same evidence shown': True}, {'seq': 1788, 'view': 'v15', 'same text': True, 'same evidence shown': True}, {'seq': 1788, 'view': 'v17', 'same text': True, 'same evidence shown': True}, {'seq': 1788, 'view': 'v21', 'same text': True, 'same evidence shown': True}, {'seq': 1788, 'view': 'v24', 'same text': True, 'same evidence shown': True}, {'seq': 1788, 'view': 'v33', 'same text': True, 'same evidence shown': True}, {'seq': 1788, 'view': 'v35', 'same text': True, 'same evidence shown': True}, {'seq': 1788, 'view': 'v4', 'same text': True, 'same evidence shown': True}, {'seq': 1788, 'view': 'v40', 'same text': True, 'same evidence shown': True}, {'seq': 1788, 'view': 'v9', 'same text': True, 'same evidence shown': True}, {'seq': 1788, 'view': 'v11', 'same text': True, 'same evidence shown': True}, {'seq': 1788, 'view': 'v1', 'same text': True, 'same evidence shown': True}, {'seq': 1788, 'view': 'v12', 'same text': True, 'same evidence shown': True}, {'seq': 1788, 'view': 'v13', 'same text': True, 'same evidence shown': True}, {'seq': 1788, 'view': 'v16'\nprobe/v7-fullnoprev/T-old-1-Q7-1.json {'case': {'case': 'T-old-1-Q7', 'role': 'target', 'draw': 'old-1', 'label': 'Q7', 'view_id': 'v7', 'type': 'figure', 'class': 'S', 'card': 'C122', 'mark': 'unsupported', 'hidden': 82, 'shown': 35}, 'repeat': 1, 'arm': 'v7-fullnoprev', 'answer': {'rung': 3, 'reasons': 'The market reference is about $1.08 trillion for 2027 hyperscaler capex, which sits in rung 3; the cited BofA estimate covers five companies, including Oracle, rather than exactly the four in the question. NVIDIA’s later $1.3 trillion estimate also covers the top five. The four largest must account for at least four-fifths of that total, or $1.04 trillion, while NVIDIA’s earlier direct forecast and Morgan Stanley’s forecast put the four above $1 trillion. Together these support a central estimate around $1.08 trillion, but do not imply that the four cross rung 4’s $1.1 trillion boundary.', 'cites': ['e105', 'e423', 'e2685', 'e2083', 'e5031', 'e75', 'e2425'], 'cites_views': [], 'pushes': [{'evidence_id': 'e105', 'push': 'toward_last'}, {'evidence_id': 'e423', 'push': 'toward_last'}, {'evidence_id': 'e2685', 'push': 'toward_last'}, {'evidence_id': 'e2083', 'push': 'none'}, {'evidence_id': 'e5031', 'push': 'none'}, {'evidence_id': 'e75', 'push': 'toward_first'}, {'evidence_id': 'e2425', 'push': 'toward_first'}], 'changed': True, 'why_changed': 'This is the first judge\ndiag-probe/H1/T-old-1-Q7-1.json {'case': 'T-old-1-Q7', 'repeat': 1, 'arm': 'H1', 'answer': {'rung': 3, 'reasons': \"The market reference is approximately $930–$980 billion for these four: BofA's $1.08 trillion 2027 estimate covers five companies, with the carried Oracle adjustment reducing it by roughly $100–$150 billion. That reference is rung 3. My implied outcome is about $1.07 trillion: I give the higher, specific NVIDIA forecast of $1.3 trillion for five companies meaningful upside weight, but discount it against the lower BofA estimate, UBS's slower-growth view, and evidence that financing and spending remain flexible; applying the same Oracle adjustment leaves the four-company estimate below $1.1 trillion. Strong cloud growth and GPU demand support the upside, but do not establish that the higher forecast will be spent. The implied figure therefore remains in rung 3, rather than crossing into rung 4.\", 'cites': ['e5031', 'e2083', 'e2685', 'e2425', 'e75', 'e1958', 'e1964', 'e2029', 'e4221', 'e1550', 'e5126', 'e3591'], 'cites_views': [], 'pushes': [{'evidence_id': 'e5031', 'push': 'toward_first'}, {'evidence_id': 'e2083', 'push': 'toward_first'}, {'evidence_id': 'e2685', 'push': 'toward_last'}, {'evidence_id': 'e2425', 'push': 'toward_first'}, {'evidence_id': 'e75', 'push': 'toward_first'}, {'evidence_id': 'e1958', 'push': 'toward_first'}, {'evidence_id': \n","exit_code":0,"status":"completed"}}
