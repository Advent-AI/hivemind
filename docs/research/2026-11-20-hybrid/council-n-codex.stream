{"type":"item.completed","item":{"id":"item_42","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba docs/research/2026-11-20-hybrid/fresh_test.py | sed -n '361,403p'; tail -2 poc/data/hybrid-2026-11-20/window-old-2-replay.log; rg -n 'depends_on|dependencies' poc/config/poc-v118.json\"","aggregated_output":"   361\t        agrees = 1 <= rung <= len(case['rungs']) and jp.gold_agrees(by_qid[case['qid']], questions[case['qid']], case['rungs'], rung)\n   362\t        (folder / f\"{case['case']}-{k}.json\").write_text(json.dumps({'case': case['case'], 'repeat': k, 'arm': arm, 'answer': answer,\n   363\t                                                                    'agrees': agrees}, indent=1, ensure_ascii=False))\n   364\t        return case['draw'], k, agrees\n   365\t\n   366\t    tally = Counter()\n   367\t    with concurrent.futures.ThreadPoolExecutor(jp.WORKERS) as pool:\n   368\t        for draw, k, agrees in pool.map(one, [(c, k) for c in rows for k in range(1, repeats + 1)]):\n   369\t            tally[k] += agrees\n   370\t    print(arm, 'gold agreement per repeat', dict(sorted(tally.items())), 'of', len(rows))\n   371\t    print('ledger', json.dumps(ledger.read()))\n   372\t\n   373\t\n   374\tdef test_deck(arms, which='fresh'):\n   375\t    cases_path, probe_dir, deck_dir, key_name, _, cut = SETS[which]\n   376\t    builder = Cards(cut)\n   377\t    rows = json.loads(cases_path.read_text())\n   378\t    for arm in arms:\n   379\t        jp.expected_files(jp.OUT / probe_dir / arm, [c['case'] for c in rows])\n   380\t    answer_file = lambda arm, case, k: json.loads((jp.OUT / probe_dir / arm / f\"{case['case']}-{k}.json\").read_text())['answer']\n   381\t    cards = []\n   382\t    for arm in arms:\n   383\t        for case in rows:\n   384\t            for k in (1, 2, 3):\n   385\t                answer = answer_file(arm, case, k)\n   386\t                if answer['rung'] not in builder.bc.conditions(case['view_id'], builder.bc.ro(jp.store_paths(case['draw'])[0])):\n   387\t                    cards.append({'arm': arm, 'case': case['case'], 'role': case['role'], 'repeat': k, 'rung': answer['rung'],\n   388\t                                  'stored_rung': case['rung'], 'kind': 'invalid rung', 'text': None})\n   389\t                    continue\n   390\t                text, _ = builder.text(case, answer)\n   391\t                cards.append({'arm': arm, 'case': case['case'], 'role': case['role'], 'repeat': k, 'rung': answer['rung'],\n   392\t                              'stored_rung': case['rung'], 'kind': 'probe', 'text': text})\n   393\t    invalid = [c for c in cards if c['text'] is None]\n   394\t    controls = [c for c in rows if c['role'] == 'control']\n   395\t    planted, confirmations = plants(builder, controls, lambda case: answer_file('v7', case, 1), jp.PLANTS, jp.SEED + 1)\n   396\t    key_path = KEYS / key_name\n   397\t    write_deck(jp.OUT / deck_dir, key_path, [c for c in cards if c['text'] is not None] + planted, confirmations, jp.SEED + 1)\n   398\t    if invalid:\n   399\t        key = json.loads(key_path.read_text())\n   400\t        key['invalid'] = [{k: v for k, v in c.items() if k != 'text'} for c in invalid]\n   401\t        key_path.write_text(json.dumps(key, indent=1) + '\\n')\n   402\t        print('invalid rungs', len(invalid))\n   403\t\n{\"day\": \"2026-09-20\", \"starting queue\": 12, \"judged\": 36, \"same set as old\": true, \"old only\": [], \"arm only\": [], \"arm\": \"replay\", \"draw\": \"old-2\"}\nreplay: 1612 of 1616 requests byte-identical to the archived ones; 1616 show the same evidence; 82 of 82 days judge the same set\n","exit_code":1,"status":"failed"}}
