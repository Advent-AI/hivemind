   236	    statuses = {}
   237	    for _, _, status in written:
   238	        statuses[status] = statuses.get(status, 0) + 1
   239	    print(f'{len(written)} of {job_count} sends have an outcome: {statuses}')
   240	    print(f'spent ${known + in_full:.4f} (known ${known:.4f}, reserves counted in full ${in_full:.4f}); cap ${arguments.cap:.2f}'
   241	          + ('; a last ledger line that was not whole was dropped' if dropped else ''))
   242	    if limit.stopped or len(written) != job_count:
   243	        raise SystemExit(f'STOPPED: {limit.stop_reason}. The result reads NOT MEASURED; this folder is not started again.')
