   232	        budget_replay.install_stop_gate(shared)            # every actual send reads the run's stop first (council mo R1)
   233	    written, limit, job_count = run(cases, list(range(1, arguments.passes + 1)), arguments.folder, arguments.cap, research_list=research_list,
   234	                                    texts=request_texts(), shared=shared)
