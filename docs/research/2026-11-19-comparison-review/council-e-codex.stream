   148	def run(cases, passes, folder, cap_usd, *, research_list, texts, transport=None, workers=8, shared=None):
   149	    """Send every case once in each pass. Returns (outcomes written, the limit). The folder must not exist. `shared` is a run's
   150	    shared ledger (WIRING-DESIGN.md §B2, D448)."""
   151	    folder = Path(folder)
   152	    folder.mkdir(parents=True, exist_ok=False)
   153	    limit = StageALimit(cap_usd, folder / 'spend.jsonl', attempt=transport, shared=shared)
   154	    checksum = hashlib.sha256(json.dumps({'system': texts['system'], 'closing': texts['closing'], 'schema': texts['schema'],
   155	                                          'setting': [SETTING.model, SETTING.reasoning_effort, SETTING.max_output_tokens]},
   156	                                         ensure_ascii=False).encode()).hexdigest()[:16]
   157	    call_config = SimpleNamespace(provider='openai', version='clean-ladder-stage-a', checksum=checksum)
   158	    archives, outcome_files = {}, {}
   159	    for pass_number in passes:
   160	        (folder / f'send-{pass_number}').mkdir()
   161	        archives[pass_number] = model.Archive(str(folder / f'send-{pass_number}' / 'archive.sqlite'))
   162	        outcome_files[pass_number] = folder / f'send-{pass_number}' / 'outcomes.jsonl'
   163	    write_lock = threading.Lock()
   164	    written = []
   165	
   166	    def work(job):
   167	        case, pass_number = job
   168	        labelled = SimpleNamespace(request_number=0)
   169	        labelled.send = lambda provider, request: limit.send_labelled(f"{case['case']}|{pass_number}|{labelled.request_number}", provider, request)
   170	        call_model = model_calls.model_caller(model, archives[pass_number], call_config, SETTING, labelled)
   171	
   172	        def counted_call(system_text, user_text, schema):
   173	            labelled.request_number += 1
   174	            return call_model(system_text, user_text, schema)
   175	
   176	        def check(answer):
   177	            return ladder_step.check_answer(answer, thesis=case['thesis'], article=case['item'], company=COMPANY, research_list=research_list,
   178	                                            repair_quote=extraction.repair_quote, normalise=extraction.normalise,
   179	                                            quote_tokens=extraction._quote_tokens,
   180	                                            beyond_next_year=extraction.beyond_next_year, binding_horizon_days=extraction.BINDING_HORIZON_DAYS)
   181	        try:
   182	            outcome = ladder_step.ladder_for_thesis(payload_for(case, research_list), system_text=texts['system'], closing_text=texts['closing'],
   183	                                                    schema=texts['schema'], call_model=counted_call, check=check)
   184	            view = None
   185	            if outcome['status'] == 'ladder':
