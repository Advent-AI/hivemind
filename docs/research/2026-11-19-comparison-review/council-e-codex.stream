   394	        if status != 0:
   395	            return 'stopped-run', f'stage_a exit {status}: a pass is incomplete (see its log)'
   396	        expected = LADDER_CONFIGURATIONS[variant]
   397	        for pass_number in range(1, self.options['passes'] + 1):       # every pass, each on its own: an empty pass fails too
