   133	def request_texts():
   134	    """The request the build uses: the system text, the closing check and the schema (the request as first sent, D407, with an
   135	    event answered in three outcomes, D409)."""
   136	    return {'system': (STEP / 'ladder' / 'candidate-system.txt').read_text(),
   137	            'closing': (STEP / 'ladder' / 'candidate-closing.txt').read_text().strip(),
   138	            'schema': json.loads((STEP / 'ladder' / 'candidate-schema.json').read_text())}
   139	
