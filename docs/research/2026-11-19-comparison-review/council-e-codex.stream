   367	def ladder_for_thesis(payload, *, system_text, closing_text, schema, call_model, check):
   368	    """Ask for one thesis's ladder; send a refused answer back once, with the answer itself and the reasons, so that the model
   369	    corrects what it wrote and does not start again. Returns the outcome record.
   370	
   371	    `call_model(system_text, user_text, schema)` sends one request and returns a dict with `answer_text` (the model's own text, or
   372	    None when the response carried none), `input_tokens`, `output_tokens`, `request_sha256`, `cached` and `error` (None, or the
   373	    reason the answer could not be read or did not fit the schema). `check(answer)` returns (reasons, passage) as `check_answer`
   374	    does, with the thesis and its article bound in. A cached answer raises CachedAnswer.
   375	    """
   376	    requests = []
   377	    note = ''
   378	    for _ in range(2):
   379	        sent = call_model(system_text, user_text(payload, closing_text) + note, schema)
   380	        if sent.get('cached'):
   381	            raise CachedAnswer(f"thesis {payload['thesis']['id']}: the model archive answered from its cache")
   382	        record = {'request_sha256': sent['request_sha256'], 'answer_text': sent['answer_text'], 'input_tokens': sent['input_tokens'],
   383	                  'output_tokens': sent['output_tokens']}
   384	        reasons, answer, passage = [], None, None
   385	        if sent['error']:
   386	            reasons = [sent['error']]
   387	        else:
   388	            try:
   389	                answer = parse_exactly(sent['answer_text'])
   390	            except (ValueError, RecursionError) as error:
   391	                reasons = [f'the answer could not be read: {type(error).__name__}']
   392	            else:
   393	                reasons, passage = check(answer)
   394	        if not reasons:
   395	            if answer['ladder'] is None:
   396	                record['result'] = 'no ladder'
   397	                requests.append(record)
   398	                return {'thesis_id': payload['thesis']['id'], 'status': 'no ladder', 'reason': answer['no_ladder'], 'requests': requests,
   399	                        'answer': None, 'passage': None}
   400	            record['result'] = 'ladder'
   401	            requests.append(record)
   402	            return {'thesis_id': payload['thesis']['id'], 'status': 'ladder', 'reason': None, 'requests': requests, 'answer': answer,
   403	                    'passage': passage}
   404	        record['result'] = 'refused'
   405	        record['reasons'] = reasons
   406	        requests.append(record)
   407	        if answer is None:                               # the answer could not be read or did not fit the schema: nothing to show back
   408	            note = RESEND_NOTE_UNREADABLE.format(reasons=' '.join(reasons))
   409	        else:
   410	            note = RESEND_NOTE.format(answer=sent['answer_text'], reasons='\n'.join(f'- {reason}' for reason in reasons))
   411	    return {'thesis_id': payload['thesis']['id'], 'status': 'no ladder: refused', 'reason': None, 'requests': requests, 'answer': None,
   412	            'passage': None}
