    26	def opened_count(draws, parts):
    27	    """The theses a trace opened, counted from its before and after states alone (independent of build_packet)."""
    28	    import sqlite3
    29	    seen = set()
    30	    for part in parts:
    31	        conn = sqlite3.connect(f'file:{Path(draws) / part}?mode=ro', uri=True)
    32	        try:
    33	            for before, after in conn.execute("select before_state, after_state from trace where status='complete' order by sequence"):
    34	                before_ids = {t['id'] for t in json.loads(before)}
    35	                seen |= {t['id'] for t in json.loads(after) if t['id'] not in before_ids}
    36	        finally:
    37	            conn.close()
    38	    return len(seen)
    39	
    40	
    41	def fresh(label, draws, parts, output):
    42	    expected = opened_count(draws, parts)
    43	    entries = build_packet.theses_of(label, parts, draws=draws, expected=expected)
    44	    cases = [{'case': f"{label}/{entry['id']}",
    45	              'thesis': {'id': entry['id'], **{field: entry['thesis'][field] for field in THESIS_FIELDS}},
    46	              'item': {field: entry['article'][field] for field in ITEM_FIELDS}} for entry in entries]
    47	    names = [case['case'] for case in cases]
    48	    if len(set(names)) != len(names) or any(not case['item'].get('text') or not case['item'].get('publication_date') for case in cases):
    49	        raise SystemExit(f'{label}: case names not unique, or a case without its opening article')
    50	    Path(output).write_text(json.dumps(cases, indent=1, ensure_ascii=False) + '\n')
    51	    print(f'{label}: {len(cases)} cases written to {output} (the trace opened {expected})')
    52	
    53	
    54	def main():
    55	    import argparse
    56	    parser = argparse.ArgumentParser()
    57	    parser.add_argument('--fresh')
    58	    parser.add_argument('--draws')
    59	    parser.add_argument('--parts')
    60	    parser.add_argument('--output')
    61	    arguments = parser.parse_args()
    62	    if arguments.fresh:
    63	        if not (arguments.draws and arguments.parts and arguments.output):
    64	            raise SystemExit('--fresh needs --draws, --parts and --output')
    65	        if Path(arguments.output).exists():
    66	            raise SystemExit(f'{arguments.output} exists: refused')
