    17	def theses_of(run, parts, draws=DRAWS, expected=None):
    18	    """The theses a stored draw opened, each with the fields Step 1 wrote and its opening article. `expected`, when given, is the
    19	    count the caller knows the draw to hold; a different count stops the build."""
    20	    expected = EXPECTED[run] if expected is None else expected
    21	    seen, out = set(), []
    22	    for part in parts:
    23	        conn = sqlite3.connect(f'file:{Path(draws) / part}?mode=ro', uri=True)
    24	        try:
    25	            rows = conn.execute("select before_state, request, result, after_state from trace where status='complete' order by sequence").fetchall()
    26	        finally:
    27	            conn.close()
    28	        for before, request, result, after in rows:
    29	            before_ids = {t['id'] for t in json.loads(before)}
    30	            new = [t for t in json.loads(after) if t['id'] not in before_ids and t['id'] not in seen]
    31	            if not new:
    32	                continue
    33	            answer = json.loads(result)
    34	            item = json.JSONDecoder().raw_decode(json.loads(request)['messages'][1]['content'])[0]['source_item']
    35	            by_description = {t['description']: t for t in answer['new_theses']}
    36	            if len(by_description) != len(answer['new_theses']):
    37	                raise SystemExit(f'{run}: two new theses share a description in one answer')
    38	            for thesis in new:
    39	                seen.add(thesis['id'])
    40	                written = by_description[thesis['description']]          # KeyError: the state and the answer disagree
    41	                linked = [e for e in answer['evidence']
    42	                          if any(l['target_type'] == 'new' and l['target_id'] == written['local_id'] for l in e['links'])]
    43	                out.append({
    44	                    'run': run, 'id': thesis['id'],
    45	                    'thesis': {k: written[k] for k in ('description', 'outcome', 'period', 'opens_as', 'settled_by', 'why_a_separate_bet')},
    46	                    'article': {k: item[k] for k in ('id', 'publisher', 'publication_date', 'title', 'text')},
    47	                    'linked_evidence': [{'summary': e['summary'], 'source_passages': e['source_passages'], 'original_party': e['original_party'],
    48	                                         'tier': e['tier'], 'statement_date': e['statement_date'], 'figures': e['figures']} for e in linked],
    49	                })
    50	    if len(out) != expected:
    51	        raise SystemExit(f'{run}: {len(out)} theses, expected {expected}')
    52	    return out
    53	
