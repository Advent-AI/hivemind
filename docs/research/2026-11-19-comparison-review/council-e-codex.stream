    38	def embedding_estimate(texts, embedding_model=search.EMBEDDING_MODEL):
    39	    body = json.dumps({'model': embedding_model, 'input': texts}).encode('utf-8')
    40	    return EMBEDDING_ATTEMPTS * (2 * len(body) + 4096) * search.EMBEDDING_PRICE_PER_M / 1e6
    41	
    42	
    43	def install(ledger):
    44	    """Replace the two module attributes with budgeted wrappers; returns a function that restores the originals."""
    45	    original_embeddings, original_jev = search.openai_embeddings, jev.transport
    46	
    47	    def budgeted_embeddings(texts, embedding_model=search.EMBEDDING_MODEL, timeout=120):
    48	        estimate = embedding_estimate(texts, embedding_model)
    49	        if not ledger.reserve(estimate):
    50	            raise model.TransportError('the shared budget ceiling would be passed: embeddings not sent')
    51	        try:
    52	            vectors, tokens = original_embeddings(texts, embedding_model=embedding_model, timeout=timeout)
    53	        except BaseException:
    54	            ledger.settle(estimate, estimate, kind='embeddings')
    55	            raise
    56	        whole = isinstance(tokens, int) and not isinstance(tokens, bool) and tokens > 0
    57	        ledger.settle(estimate, EMBEDDING_ATTEMPTS * tokens * search.EMBEDDING_PRICE_PER_M / 1e6 if whole else estimate, kind='embeddings',
    58	                      tokens=tokens if whole else None)
    59	        return vectors, tokens
    60	
    61	    def budgeted_jev(request, timeout=60):
    62	        estimate = budget_replay.jev_estimate(request)
    63	        if not ledger.reserve(estimate):
    64	            raise model.TransportError('the shared budget ceiling would be passed: Jev not sent')
    65	        try:
    66	            response = original_jev(request, timeout=timeout)
    67	        except BaseException:
    68	            ledger.settle(estimate, estimate, kind='jev')
    69	            raise
    70	        usage = response.get('usage') if isinstance(response, dict) else None
    71	        tokens = usage.get('input_tokens') if isinstance(usage, dict) else None
    72	        whole = isinstance(tokens, int) and not isinstance(tokens, bool) and tokens > 0
    73	        ledger.settle(estimate, jev.ATTEMPTS * tokens * model.PRICES[request['model']][0] / 1e6 if whole else estimate, kind='jev',
    74	                      tokens=tokens if whole else None)
    75	        return response
    76	
    77	    search.openai_embeddings, jev.transport = budgeted_embeddings, budgeted_jev
    78	
    79	    def restore():
    80	        search.openai_embeddings, jev.transport = original_embeddings, original_jev
    81	    return restore
    82	
    83	
    84	def main(argv):
    85	    if len(argv) < 2 or argv[0] != '--shared-ledger':
    86	        raise SystemExit(__doc__)
    87	    ledger = budget_replay.SharedLedger(argv[1])
    88	    if ledger.read().get('stopped'):
    89	        raise SystemExit(f"the shared ledger is stopped ({ledger.read().get('stop_reason')}): nothing is sent")
    90	    run_forward = load('clean_step2_run_forward', ROOT / 'clean-arch/step2/run_forward.py')
    91	    restore = install(ledger)
    92	    remove_gate = budget_replay.install_stop_gate(ledger)  # a helper's internal retry reads the run's stop too (council mo R1)
    93	    saved_argv = sys.argv
    94	    sys.argv = ['run_forward.py', *argv[2:]]
    95	    try:
    96	        return run_forward.main()
    97	    finally:
    98	        sys.argv = saved_argv
    99	        remove_gate()
   100	        restore()
   101	
   102	
   103	if __name__ == '__main__':
   104	    sys.exit(main(sys.argv[1:]))
