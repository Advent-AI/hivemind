    55	def main():
    56	    packet = [t for run, parts in RUNS.items() for t in theses_of(run, parts)]
    57	    (HERE / 'packet.json').write_text(json.dumps(packet, indent=1, ensure_ascii=False))
    58	    lines = ['# Step 4 census packet: the 34 theses the three unseeded draws opened, each with its opening article', '']
    59	    for n, t in enumerate(packet, 1):
