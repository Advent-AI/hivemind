   141	def payload_for(case, research_list):
   142	    """The payload of one case, with the keys in the order the design gives."""
   143	    themes = [{'id': theme_id, 'name': theme['name']} for theme_id, theme in research_list.themes.items()]
   144	    return {'company': COMPANY, 'fiscal_year_note': research_list.fiscal_note(COMPANY, case['item']['publication_date'], english=True),
   145	            'themes': themes, 'thesis': case['thesis'], 'item': case['item']}
   146	
