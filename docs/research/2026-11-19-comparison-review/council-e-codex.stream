    18	def main():
    19	    parser = argparse.ArgumentParser(description=__doc__)
    20	    for name in ('source', 'output', 'manifest', 'initial', 'settings', 'limits'):
    21	        parser.add_argument('--' + name, required=True)
    22	    parser.add_argument('--system', help='a candidate system prompt file, with --closing; the PRD prompt otherwise')
    23	    parser.add_argument('--closing', help='the candidate closing check, appended to the end of the user message')
    24	    parser.add_argument('--schema', help='a candidate response schema file in place of the PRD schema')
    25	    parser.add_argument('--shared-ledger', help="a run's shared ledger (WIRING-DESIGN.md §B2, D448): each attempt reserves on it; the limits' max_usd is not applied")
    26	    args = parser.parse_args()
    27	    if bool(args.system) != bool(args.closing):
    28	        parser.error('--system and --closing go together')
    29	    texts = (Path(args.system).read_text(encoding='utf-8'), Path(args.closing).read_text(encoding='utf-8')) if args.system else None
    30	    limits = read(args.limits)
    31	    settings = read(args.settings)
    32	    settings['live_limits'] = limits
    33	    ledger = None
    34	    if args.shared_ledger:
    35	        import importlib.util
    36	        spec = importlib.util.spec_from_file_location('budget_replay', ROOT / 'clean-arch/e2e-comparison-2026-11-13/budget_replay.py')
    37	        budget_replay = importlib.util.module_from_spec(spec)
    38	        spec.loader.exec_module(budget_replay)
    39	        ledger = budget_replay.SharedLedger(args.shared_ledger)
    40	        budget_replay.install_stop_gate(ledger)            # every actual send reads the run's stop first (council mo R1)
    41	    result = run(args.source, args.output, read(args.manifest), read(args.initial), settings, LiveTransport(limits, ledger=ledger),
    42	                 ROOT / 'clean-arch/PRD.md', texts, read(args.schema) if args.schema else None)
    43	    print(json.dumps({'trace': args.output, **result}))
    44	    return 0 if result['status'] == 'complete' else 1
