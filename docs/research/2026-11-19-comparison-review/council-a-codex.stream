{"type":"item.started","item":{"id":"item_15","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"head -50 poc/data/comparison-2026-11-17/reading-diagnostic/mapping-out/library-L1.json; head -75 poc/data/comparison-2026-11-17/reading-diagnostic/mapping-out/mapping.json; head -38 poc/data/comparison-2026-11-17/reading-diagnostic/deck/readings.json; ls -a poc/data/comparison-2026-11-17/reading-diagnostic/deck | rg -v '\"'^C[0-9]+'\"'; rg -n 'key|draw' docs/research/2026-11-17-product-comparison/diagnostic-chain.sh\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"head -50 poc/data/comparison-2026-11-17/reading-diagnostic/mapping-out/library-L1.json; head -75 poc/data/comparison-2026-11-17/reading-diagnostic/mapping-out/mapping.json; head -38 poc/data/comparison-2026-11-17/reading-diagnostic/deck/readings.json; ls -a poc/data/comparison-2026-11-17/reading-diagnostic/deck | rg -v '\"'^C[0-9]+'\"'; rg -n 'key|draw' docs/research/2026-11-17-product-comparison/diagnostic-chain.sh\"","aggregated_output":"[\n {\n  \"question_id\": \"Q1\",\n  \"question\": \"How much credit support will NVIDIA have committed under its AI-cloud model by the publication of its FY2027 annual report?\",\n  \"due\": \"2027-02-28\",\n  \"opened\": \"2026-07-01\",\n  \"opened_from\": \"nvblog:nvidia-unlocks-ai-compute-at-scale-capital-partners-to-power-ai-infrastructure-buildout\",\n  \"type\": \"figure\",\n  \"possible_answers\": [\n   \"Committed credit support is below $1 billion.\",\n   \"Committed credit support is at least $1 billion and below $5 billion.\",\n   \"Committed credit support is at least $5 billion and below $10 billion.\",\n   \"Committed credit support is at least $10 billion and below $20 billion.\",\n   \"Committed credit support is at least $20 billion.\"\n  ],\n  \"answer\": \"Committed credit support is at least $20 billion.\",\n  \"answer_index\": 4,\n  \"reasons\": \"The reference is NVIDIA’s disclosed $108.5 billion of AI-cloud guarantees and related agreements ($105 billion for SB Energy/PORTS-Pike plus $3.5 billion for other AI-cloud partners), which is rung 5. The implied amount is higher: NVIDIA said it would provide selective credit enhancement for nearly 2 GW for another frontier lab; scaling the $105 billion backstop for the reported 10 GW PORTS-Pike campus gives an indicative additional $21 billion, or roughly $129.5 billion total if additive. The estimate is uncertain and could overlap the $3.5 billion disclosure, but either way the outcome remains well above the $20 billion rung-5 boundary. The financing-platform pool and the $125 billion option are not themselves NVIDIA commitments; the reported pause concerns a separate partnership program and does not cancel the disclosed guarantees.\",\n  \"material\": [\n   {\n    \"tier\": \"rumour\",\n    \"speaker\": \"CommonWealth Magazine\",\n    \"original\": \"CommonWealth Magazine\",\n    \"input_id\": \"gnews:f71af3237fa3bee52a72c067\",\n    \"day\": \"2026-07-28\",\n    \"summary\": \"Nvidia is reportedly discussing a backstop of up to $250 billion for OpenAI's planned lease of a 10 GW data-center campus in Pike County, Ohio; the guarantee would cover lease and construction debt, not Nvidia chips.\",\n    \"quote\": \"Nvidia is reportedly in discussions with OpenAI about a backstop of up to $250Bn to help fund its plans to lease a massive new artificial intelligence data centre. The backstop would allow OpenAI to raise debt for a 10 GW data centre campus in Pike County, Ohio, on the strength of Nvidia's credit. The guarantee would cover the lease and construction debt, not the Nvidia chips inside, which the two\",\n    \"publisher\": \"english.cw.com.tw\"\n   },\n   {\n    \"tier\": \"fact\",\n    \"speaker\": \"NVIDIA Corporation\",\n    \"original\": \"NVIDIA Corporation and Apollo, BlackRock, Blackstone, Brookfield, Goldman Sachs and KKR 2026-08-10\",\n    \"input_id\": \"nvidianews:nvidia-partners-with-apollo-blackrock-blackstone-brookfield-goldman-sachs-and-kkr-to-establish-ai-compute-infrastructure\",\n    \"day\": \"2026-08-10\",\n    \"summary\": \"NVIDIA announced strategic partnerships with six financial institutions to establish compute financing platforms intended to mobilize over $500 billion of third-party capital for AI infrastructure over time.\",\n    \"quote\": \"NVIDIA today announced strategic partnerships to establish independent compute financing platforms with Apollo, BlackRock, Blackstone, Brookfield, Goldman Sachs and KKR to mobilize over $500 billion of third-party capital for the buildout of AI infrastructure over time.\",\n    \"publisher\": \"NVIDIA Corporation\"\n   },\n   {\n    \"tier\": \"party_statement\",\n    \"speaker\": \"Channel NewsAsia, reporting Jensen Huang's post on X\",\n    \"original\": \"Jensen Huang 2026-08-10\",\n    \"input_id\": \"gnews:3569b4e1f0f58e0c0fd2fe2c\",\n    \"day\": \"2026-08-10\",\n    \"summary\": \"NVIDIA CEO Jensen Huang said NVIDIA has the option to backstop up to $125 billion, or 25% of the potential deals, under the financing platforms.\",\n    \"quote\": \"Nvidia CEO Jensen Huang said on X that the company has the option to backstop up to $125 billion, or 25 per cent of the potential deals.\",\n    \"publisher\": \"channelnewsasia.com\"\n   },\n   {\n{\n \"mapping\": {\n  \"new-2\": {\n   \"M13\": [\n    {\n     \"question\": \"Q6\",\n     \"covers\": true\n    }\n   ],\n   \"M15\": [\n    {\n     \"question\": \"Q3\",\n     \"covers\": true\n    }\n   ],\n   \"M31\": [\n    {\n     \"question\": \"Q1\",\n     \"covers\": \"split\"\n    }\n   ]\n  },\n  \"new-3\": {\n   \"M13\": [\n    {\n     \"question\": \"Q6\",\n     \"covers\": true\n    }\n   ],\n   \"M15\": [\n    {\n     \"question\": \"Q3\",\n     \"covers\": true\n    }\n   ],\n   \"M19\": [\n    {\n     \"question\": \"Q32\",\n     \"covers\": true\n    }\n   ],\n   \"M31\": [\n    {\n     \"question\": \"Q1\",\n     \"covers\": \"split\"\n    }\n   ],\n   \"M32\": [\n    {\n     \"question\": \"Q30\",\n     \"covers\": true\n    }\n   ]\n  },\n  \"old-1\": {\n   \"M04\": [\n    {\n     \"question\": \"Q6\",\n     \"covers\": \"split\"\n    }\n   ],\n   \"M06\": [\n    {\n     \"question\": \"Q8\",\n     \"covers\": true\n    }\n   ],\n   \"M08\": [\n    {\n     \"question\": \"Q28\",\n     \"covers\": true\n    }\n   ],\n   \"M09\": [\n    {\n{\n \"matters\": [\n  {\n   \"matter\": \"M01\",\n   \"company_figure\": false\n  },\n  {\n   \"matter\": \"M02\",\n   \"company_figure\": false\n  },\n  {\n   \"matter\": \"M03\",\n   \"company_figure\": false\n  },\n  {\n   \"matter\": \"M04\",\n   \"company_figure\": false\n  },\n  {\n   \"matter\": \"M05\",\n   \"company_figure\": false\n  },\n  {\n   \"matter\": \"M06\",\n   \"company_figure\": true\n  },\n  {\n   \"matter\": \"M07\",\n   \"company_figure\": true\n  },\n  {\n   \"matter\": \"M08\",\n   \"company_figure\": false\n  },\n  {\n   \"matter\": \"M09\",\n   \"company_figure\": true\n  },\n.\n..\nreadings.json\nround-0\nround-0.done\nround-1\nround-1.done\nround-2\nround-2.done\n2:# Diagnostic reading of the five finished draws (plan section 1.4 item 10: new-1 stopped after its one redo, so no release verdict;\n4:# --diagnostic mode, and a diagnostic count in place of the release scorer (which refuses anything but six eligible draws).\n15:step \"1. eligibility (records the finished draws)\"\n18:step \"2. mapping (diagnostic export of the finished draws)\"\n38:out = {'note': 'DIAGNOSTIC, not a release verdict: five finished draws (new-1 stopped after its one redo); a matter is served by a '\n39:               'system when it is served in at least 2 of that system\\'s finished draws (both of new-2 and new-3; 2 of 3 old)',\n40:       'draws': sorted(r['cards']), 'N': len(r['matters']),\n52:out['distinct bets per draw'] = {d: v['ids'] - v['duplicates_both'] for d, v in r['distinct'].items()}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_16","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"rg -n 'D382|D384|not.*open|conditions|material|big matters' clean-arch/PRD.md | head -65; nl -ba docs/research/2026-11-17-product-comparison/DESIGN-1.6.md | sed -n '1,44p;123,154p'; rg -n '\"'^def |whether|bulk|read'\"' docs/research/2026-11-17-product-comparison/stage0/classify_reads.py | tail -50; rg -n '\"'^def |sha256|rg '\"' docs/research/2026-11-17-product-comparison/stage0/exposure_census.py | tail -40; ls docs/research/2026-11-17-product-comparison/stage0/census\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"rg -n 'D382|D384|not.*open|conditions|material|big matters' clean-arch/PRD.md | head -65; nl -ba docs/research/2026-11-17-product-comparison/DESIGN-1.6.md | sed -n '1,44p;123,154p'; rg -n '\"'^def |whether|bulk|read'\"' docs/research/2026-11-17-product-comparison/stage0/classify_reads.py | tail -50; rg -n '\"'^def |sha256|rg '\"' docs/research/2026-11-17-product-comparison/stage0/exposure_census.py | tail -40; ls docs/research/2026-11-17-product-comparison/stage0/census\"","aggregated_output":"69:- **Too much material in one request fails.** In a three-month run the data-center revenue question held 1,768 linked pieces. Its\n107:| What opens a question | Extraction proposes candidates with answer choices; a matcher and a collision judge decide. | Step 1 decides in the same reading, and only for a big matter; a company's own figures are conditions, not questions (D382, D384). | 1 of 10 opened wrongly on 50 fresh articles (D386). Opening is also where it loses most against the ruler (section 8). |\n135:- **The main quantity: big matters served.**\n136:  - Both reader families list the scored weeks' big matters from the articles, blind to any output, and freeze the list.\n199:    G[(Run traces and state)] -. review material .-> V\n210:| Hummingbird stream | Incoming material from its event pipeline. | An item with its source information. | Stand-in: the local source database (section 14). The live Hummingbird contract is not established. |\n212:| Step 1 | The item and the open theses. | Evidence for open theses; a new thesis, with its evidence, for a big matter; material statements no thesis takes, kept without links. | Adopted: request c8 on DeepSeek Flash at high effort (D387; section 12). |\n226:| Incoming item | The article or other material Hummingbird supplies, with its source, speaker and publication information when known. |\n254:   product's next node, a policy stage, or a checkable shared quantity (D384; Alex: \"按金标：只开大事\"). Another company's single\n258:3. **A material statement no thesis takes yet.** It is kept in the company's record without links and linked when a thesis that\n263:- **A financial figure is a condition, not a thesis** (D382; Alex: \"我觉得财务类型不应该是thesis，而更多的是条件。观点应该是独特的view，而不是喊出来的数字，除非有理由 - 这个理由恰恰才是观点\").\n328:| Repeat | The new material presents the same statement again. | Another article reports the same company forecast. |\n345:**Frozen (D427, Alex, 2026-11-11: \"好jev 收尾冻结\").** Step 2 and Step 3's grouping library stay as accepted and measured (Step 2 log §§12–18); `tests/test_frozen_clean_step2.py` fails the suite when one of their files moves. They go to production only with the whole clean path, after Step 4 meets its lines, through an end-to-end comparison against production on the frozen ruler (three draws each), with these three lines checked on that run. A change is a new version that only Alex opens; while he is not active, the council may open it (D439), never the frozen ruler. Five open defects are carried with the freeze (Step 2 log §17).\n374:   reads nothing later than the opening article. It writes the judged question, its answer choices and its due day, and lists every\n420:- **Use on unseen news** (gate 4, D484): readers first list the big matters in a week of news, then check what each system covered,\n432:| Use on unseen news (gate 4) | Proposed, not Alex's. | One fresh week, one draw: big matters covered 2 of 5 against 4 of 5; last answers supported 6 of 7 against 10 of 15; \"not clear\" (D489). | [Week result](../docs/research/2026-11-14-use-acceptance/week/WEEK-RESULT.md) |\n437:  disagreed with reader B in either system; every loss came at opening: the question was not opened, or not in a shape the ruler\n441:  delivered question asks a materially different or unresolvable thing. No single cause is proven.\n517:  code checks each value against a verified passage (D382).\n519:  quantity, or a policy stage (D384).\n520:- **A material statement that no thesis takes is kept without links**, and is linked later when a covering thesis opens (D383). What\n546:statements in the item are material, then link each one to every thesis it informs: an open thesis that covers it, a new thesis you\n548:covers. Every new thesis comes with evidence from this item. A material statement that no open thesis covers and that is not\n563:- A material statement is one of four kinds. (1) The company's own figure, guidance or decision: \"same-store sales rose 4.2% in the\n581:  kinds describe what material statements usually look like; they do not decide what is kept. Take a statement when an analyst\n593:- NO THESIS YET: if no open or newly proposed thesis covers a statement you judge material, and the matter is not big enough by\n597:  path when they bear on that path; a different period is not on its own a reason to leave them unlinked. When no open or new\n602:  firm's cash burn changes its credit risk. The share price, a target price and other companies' figures are never conditions.\n610:  thesis's year. If another open thesis covers the evidence more directly, consider that thesis as well; do not assume different\n629:company's revenue, profit, cash or credit risk, or competitive position in a way you can name; public material will settle it on a\n645:  added in 2026\"; \"next year's average contract price of a raw material\"). Another population or wording of the same aggregate is\n656:  checked, only when the item supports one. A question no date can settle is rewritten or not opened.\n657:- Do not open a thesis about: an executive appointment or organisational change; the company's own borrowing or leases as an\n660:  product already on sale; another estimate, source or wording of what an open thesis tracks; an annual quantity after next year (an\n663:- Before proposing a new thesis, name its reason (opens_as), the public material that will settle it (settled_by), and the closest\n665:  If the two cannot move apart, link the evidence to every open thesis it informs instead.\n670:- If an open thesis tracks sales growth, a revised sales forecast is evidence for it; do not open a second thesis to repeat it.\n677:  words does not make another claim in the same passage new or material. A statement told in several sentences of the item, with its\n678:  terms, figures and conditions, is one item.\n680:  sentence gives it. Preserve conditions, uncertainty and attribution. Return every passage the summary rests on, each copied\n724:- background the analyst already knew, such as the company's history (\"the company was founded in 1998\"); an arrangement the item only describes as in place, even when no date is given: customers or partners that use, host, run or have built on the company's products, and the benefits they describe from that use (\"two airlines fly the planemaker's jets\"; \"three insurers run claims on the company's software and report faster payouts\"); a partnership, contract, plant or investment the item itself dates to an earlier month or year with no new step (\"earlier this year the company partnered with the glassmaker on three plants\"; \"in May it signed a $3 billion cloud contract\"); it does not cover a step the item reports as news, taken, decided, planned or under way (an order, a selection, an integration, an expansion, a deployment), even when it gives no date (\"the retailer's largest supplier is opening its own stores, people familiar said this week\"; \"the two largest cement makers are adding kilns to meet demand\"), nor a customer's, supplier's or partner's newly disclosed revenue, capacity, orders or contracted amount; a deal the item mentions as already existing is an arrangement in place even with its amount (\"a rival airline already leases 40 of the same jets\");\n736:For each new thesis, check its opens_as, settled_by, closest_open_thesis and why_a_separate_bet: drop the thesis if it fits none of the four reasons in section 3, if no public material will settle it on a date, if an open thesis exists and its answer cannot move apart from it, or if it falls under a 'do not open' item in section 3; then link its evidence to every open thesis it informs, or leave it without links.\n737:An item whose only home would be a new thesis that is not a big matter is returned with empty links and kept without links; an item an open thesis covers is linked there, not left without links. Then read back each statement you return with empty links that states the company's own figures: return it only if a figure can change what an analyst expects of the company's revenue, profitability, funding or credit risk, or competitive position; for example, a cash-rich company's balance or cash flow that the item ties to nothing usually cannot; return only what passes.\n832:      \"description\": \"The public material that will settle the answer on a date (a filing, an official decision, a shipment confirmation, a statistics release).\",\n879:      \"description\": \"Standalone faithful summary naming the actor and preserving relevant figures, periods and conditions.\"\n973:         \"description\": \"Scope and qualifications as stated (GAAP or non-GAAP, segment or company, conditions); null when none.\"\n982:      \"description\": \"The existing or proposed theses this evidence informs; empty when it is material but no thesis takes it yet: it is kept in the company's record and linked when a covering thesis opens.\",\n1050:For an OpenAI Chat Completions request, the existing [request builder](../src/hivemind/model.py) wraps its schema with `type: json_schema`, a name and `strict: true`. OpenAI's [Structured Outputs guide](https://developers.openai.com/api/docs/guides/structured-outputs) requires object fields to be required, allows nullable types for unknown values, and uses `additionalProperties: false` for objects. The guide lists `minItems` for arrays; the exploratory run sent this multi-passage schema to Luna and received structured responses. This does not establish production compatibility. A schema-conforming response can still be factually wrong, incomplete or semantically mislinked; refusal and incomplete responses also need separate handling. [OpenAI Structured Outputs](https://developers.openai.com/api/docs/guides/structured-outputs).\n1052:The official [GPT-6 Luna model page](https://developers.openai.com/api/docs/models/gpt-6-luna) lists both Chat Completions and structured outputs as supported. The exploratory run shows that the model accepted this schema for those requests, not that its answers were correct or production-ready. OpenAI's [prompt engineering guide](https://developers.openai.com/api/docs/guides/prompt-engineering) describes using headings, lists and examples to make instructions and context clear. In this draft, the system prompt carries analyst decisions; the per-item message carries the changing data; and the separate schema owns response fields and their descriptions.\n1054:Application checks are needed for cross-record and source rules the schema alone cannot enforce: each existing target must resolve to the supplied open list; each new target must resolve to one new thesis in the same answer; each new thesis must be referenced by evidence; local IDs must be unique within their list; each evidence item must have a link; and every evidence item must contain at least one nonempty source passage, and every passage must come from this item. Code retrieves an existing thesis description from the supplied list rather than asking Luna to echo it. These are the intended source and identity relationships, not proof that the source supports every summary claim or that an analyst agrees with the thesis. In the isolated exploratory runner, unmatched passages and unresolved links are retained and explicitly marked as provisional rather than blocking the stream; an unlinked new thesis is not added to the state. Production integration remains open.\n1056:Alex approved returning the evidence tier, original statement date and described period in Step 1. The draft also identifies the original party and reporting speaker separately. Mapping these fields to the existing writer and readers remains to be verified, including how source-specific attribution and tier are retained when a repeat adds another source. The signed historical standard uses more specific opening categories and check-date rules; Alex has clarified that the clean design may open a meaningful topic without a known decision date when later observable developments can help assess it. Other differences remain subject to audit. This draft must not be described as fully compatible with that standard or the production schema without a separate review.\n1145:The assembled clean request and partial forward-run answers now exist in the local trace. This review is not the measured failure-class audit required for an existing measured prompt. The exact thesis-opening boundary, storage mapping for evidence tier and source provenance, handling of ambiguous thesis identity, and compatibility with the existing ledger are still open. The partial run and source contamination do not establish that the draft works end to end.\n1197:The documented local serving default is the existing [thesis ledger](../poc/data/served-2026-10-28-v34-nvda-3m-through-0828/views.sqlite), together with its [source item database](../poc/data/items-nvda-2026-07-01-10-27.sqlite). The ledger stores both theses and evidence; the diagram's two libraries do not require two physical databases. The source item database holds the original material used to resolve evidence sources. These data files are local and are not included in a fresh Git checkout. [Local data and service defaults](../README.md#local-requirements-and-data).\n1209:| **34,084 stored source records** | The full local collection of source records in the stand-in Hummingbird database. | The pool from which a replay selects source material for processing. The current replay does not send every record to extraction. |\n1212:The 148 golden articles are not the total amount of source material available. Conversely, the 34,084 figure does not mean all records are eligible for processing or have golden answers. The 30 test articles were used in previous experiments and are not a fresh unseen test for the rebuild.\n1216:The existing replay uses the local [cleaned source item database](../poc/data/items-nvda-2026-07-01-10-27.sqlite) as a stand-in for the incoming Hummingbird stream. Its records come from collected documents, including news, filings and official material; they are not invented articles. The [corpus pipeline](../poc/corpus/README.md) assembled and cleaned them for experiments. Each record can contain a title, publisher, publication date, source URL, company identifiers and cleaned text; `text_page` retains the fetched page text. This source database is separate from the thesis and evidence ledger.\n1233:These files are the frozen ruler's extraction gold. For the new system they are a lead: Step 1's dev draws are scored on them, while acceptance uses fresh articles read by independent readers against the source (D386). The source item database and the golden references serve different purposes: source items are input material, while golden references are expected answers for selected items.\n1239:| Hummingbird stream | Stand-in: the [source item database](../poc/data/items-nvda-2026-07-01-10-27.sqlite) and the prepared-page source (`step1/materialize_source.py`, `step1/preserve_page_source.py`). | [Item dispatch](../src/hivemind/dispatch.py), [replay entry](../scripts/replay.py). |\n1263:- **Periodic reassessment:** revisit the map asynchronously using available evidence and, where appropriate, a broader review of potential relationships. A weekly run is an example, not a fixed schedule. What is reviewed, how often and how changes are accepted are open.\n1266:An entity relationship identifies a possible path of relevance; it does not by itself prove that an event affected another entity, or establish the direction or size of an impact. The system needs to retain the reason and supporting source for a link, including whether a connection is reported in a source or inferred. The representation of uncertainty and time remains open.\n     1\t# The §1.6 tools: what D665 prints beside the verdict (design v7, before any output is read; D672)\n     2\t\n     3\tGoverning text:\n     4\t- `RUN-PLAN-v12.md` §1.6;\n     5\t- `stage0/verdict-rule.json`: `hard_checks` and `printed_beside`.\n     6\t\n     7\tThe ruler and the frozen instruments do not move (D674). Every reader is a closed session (`census/census_readers.run`), one per\n     8\tfamily, with memories off (D661).\n     9\t\n    10\tv2 answered round 4's Part B and v3 round 5's. v4 and v5 answer round 6: Codex in `tools-review-codex-6.md`, and a Claude reader. Every\n    11\tround's Part B points are summarised in D675.\n    12\t\n    13\t## 0. Inputs, release status and the report\n    14\t\n    15\t- **Stores.**\n    16\t  - Every tool reads a draw's components from its `run.json`: `components[c]['folder']`, so `step1-redo` or `step2-redo` after a D449\n    17\t    redo, and the judge's completed attempt (`mapping.store_paths`).\n    18\t  - `eligibility.py` fingerprints every file a tool reads: the judge or old store, `step1/trace.sqlite`, `step2/decisions.json` and\n    19\t    `library.json`, `cases/cases.json`, and each pass's ladder `outcomes.jsonl`.\n    20\t  - Each tool refuses a file whose sha256 differs.\n    21\t- **Release status sits beside the verdict and does not replace it.**\n    22\t  - `score_comparison` gives the verdict (invalid / too small / lead / loss / no winner).\n    23\t  - The report prints \"hard checks clear\" when every hard check passed. It prints \"release blocked: <check> failed\" for a check that\n    24\t    failed, and \"release not cleared: <check> not measured\" for a check that could not be measured (D665: \"a release blocker reported\n    25\t    with the verdict\").\n    26\t  - Release itself still needs a practical lead and Alex's word. Nothing is deployed.\n    27\t- **A hard check that is not measured cannot clear release.**\n    28\t  - The frozen rule says this of Step 2's lines. This design reads it the same way for D400's code parts, whose own accounting marks a\n    29\t    line \"not measured\" below 3 company-figure theses or 20 laddered theses.\n    30\t  - This is a reading to settle in the council and record before any output; it is the cautious, reversible course.\n    31\t- **Printed beside, each from its tool:**\n    32\t\n    33\t| Item | Tool | Source |\n    34\t|---|---|---|\n    35\t| D428's limits beside the guardrails | `score_comparison.beside` | Labelled as a comparison on the guardrail sample, not Stage B's measurement. Each system's figure share against 12.7% to 14.4%; its yes/no share against 5%; its decided latest answers (figure and yes/no) unsupported against 3 in 30, scaled; with denominators, and the insufficient latest answers beside |\n    36\t| Sign test and interval (illustrative) | `score_comparison.beside` | Per counting, over the discordant matters (served by exactly one system): two-sided binomial p on a against b, and the Wilson 95% interval for the new system's share among them, labelled illustrative |\n    37\t| Company-figure subgroup a, b, N | `score_comparison.beside` | Built |\n    38\t| Days from first source to opening | `score_comparison.beside` | For each matter and draw with a confirmed covering question (split covers not counted): the earliest publication day among the matter's `articles` (the census numbering), to the earliest opening day of a covering question. A question opened before 09-07 is printed \"opened in the warm-up\"; one opened in the window before that day, \"opened before the first listed article\" |\n    39\t| Floors | `score_comparison.beside` | §4 |\n    40\t| D400 reader lines, D400 code parts | §1 | |\n    41\t| Step 2's three lines | §2 | |\n    42\t| D431's 07-14 reading | §3 | |\n    43\t| 37 bulk-viewer articles excluded; 2 split matter pairs kept apart | report text | D669 and D671 records |\n    44\t\n   123\t## 3. D431's frozen-reference reading at 07-14 (printed beside; both systems)\n   124\t\n   125\tD442's procedure (`clean-arch/e2e-comparison-2026-11-13/DESIGN.md`, \"Procedure\", steps 3 to 6) is run as it was run then, on both\n   126\tsystems' draws as they stood at 07-14. It compares the answers the systems actually gave; MATCHING-v2 §4's adapter, which would re-ask\n   127\tthe ruler's question, is not built (D442's precedent).\n   128\t- **The as-of state:** every view created on or before 2026-07-14 is listed first: by `created_seq` up to the last sequence of 07-14,\n   129\t  closed views included. Then `service.state_as_of` at 2026-07-14 is read for each one. New-system units are joined by\n   130\t  `clean_ladders.view_id`, split children included.\n   131\t- **Step 4, matching:** MATCHING-v2's SAME rule, two blind families, and two third readers, one per family, on each disagreement, as the\n   132\t  full run did (`READING-COMMITMENT.md`). A split stays unresolved. D442's rule for a ruler question's candidates applies.\n   133\t- **Step 5, eligibility:** question, period and quantity the ruler's, and due day the ruler's (D430). Decided by two blind readers, with\n   134\t  two third readers, one per family, on a disagreement; a split stays unresolved. The literal reading (the same due day) is printed beside.\n   135\t- **Step 6, outcomes:** the first that applies, (i) to (ix).\n   136\t  - Several SAME views: the first created is judged and the others listed.\n   137\t  - A figure rung with no bound: \"no comparison\". A unit that differs from the ruler question's, or that cannot be established:\n   138\t    \"no comparison (unit)\". No conversion is made.\n   139\t  - Agreement by the frozen scorer's rule (`prod_records.outcome` for the old system; for the new system the same rule, as Stage B counted\n   140\t    it: \"Ruled out\" and \"Still open\" answer no, `stage_b/control_theses.py`).\n   141\t- **Printed:** per ruler question and draw, its outcome; and per draw and system, the agreements on the seven graded questions.\n   142\t\n   143\t## 4. The floors (printed beside; proposed, not gates)\n   144\t\n   145\tAs their source states them (`docs/research/2026-11-14-use-acceptance/reflection-10/codex-1.md`; `RUN-PLAN-v2.md` §1.6). Each floor is\n   146\tcomputed per draw and under both countings, and holds when it is met in at least 2 of the system's 3 draws:\n   147\t- **Covered:** at least 80% of important matters have a covering question.\n   148\t- **Trivial or duplicate:** at most 20% of the questions, counted as decided worth marks on every random-sample card, covering cards\n   149\t  included. The frozen rule keeps covering cards out of the guardrail shares only.\n   150\t- **Supported:** at least 90% of latest answers, counted on every answered random-sample card. An insufficient or unresolved answer is\n   151\t  counted and gets no credit.\n   152\t\n   153\tWrong citations and answer-changing omissions: **not measured**.\n   154\t\n1:\"\"\"Which of the scored window's articles were read (D669): every location the exposure census found is classed, and an article is kept\n2:only when none of its locations is a read.\n4:Not a read, and only these:\n8:   Python script, none of which calls a model, and holds no reader material (a `.stream`, `.html` or `.md` file, a `packet*` or `round*`\n9:   file, a `codex*` or `claude*` file, or a subfolder named packets, verdicts, readers or review*).\n11:Everything else is a read, including a file in a folder with no script to show what produced it.\n13:Also a read: an article whose own text a reader was shown without its id, so the census cannot see it (READER_SHOWN, each with the session\n16:    python3 classify_reads.py <census.json> <output folder>\n33:READER_DIR = re.compile(r'^(packets|verdicts|readers|review.*)$')\n35:READER_SHOWN = {      # D670: shown to the source-loss council's reader as text without an id (poc/data/clean-step1-source-loss-council-2026-11-07)\n43:def folder_is_code_only(folder):\n44:    \"\"\"A folder with at least one script, none calling a model, and no reader material.\"\"\"\n51:        reader = any(READER_FILE.search(n) for n in names) or any(READER_DIR.match(n) and os.path.isdir(os.path.join(folder, n)) for n in names)\n55:                if MODEL_CALL.search(Path(folder, name).read_text(errors='ignore')):\n60:        result = bool(scripts) and not calls and not reader\n65:def classify(location):\n66:    \"\"\"'storage', 'pool', 'code-only' or 'read'.\"\"\"\n75:        return 'read'\n81:    return 'read'\n84:def main(census_path, out_dir):\n85:    census = json.loads(Path(census_path).read_text())\n90:    kept, reads_by_location, not_reads = [], collections.Counter(), collections.Counter()\n94:            classes.append((f'reader shown without id: {READER_SHOWN[article]}', 'read'))\n95:        if not any(c == 'read' for _, c in classes):\n99:            (reads_by_location if c == 'read' else not_reads)[(c, folder)] += 1\n105:    report = {'rule': __doc__.split('\\n\\n')[1], 'window': WINDOW, 'census_sha256': hashlib.sha256(Path(census_path).read_bytes()).hexdigest(),\n108:              'not_read_locations': [{'class': c, 'location': f, 'articles': n} for (c, f), n in not_reads.most_common()],\n109:              'read_locations': [{'location': f, 'articles': n} for (c, f), n in reads_by_location.most_common()]}\n111:    (out / 'reads.json').write_text(text)\n113:    print('not-read locations by class:', collections.Counter(r['class'] for r in report['not_read_locations']))\n2:text sha256. Every file under the roots is read (`.git` and this comparison's own folder excepted):\n7:A table holding `input_id` and `content_sha256` is exempt only when its (input_id, content_sha256) pair set equals a build listed in the\n41:BUILD_HASHES = {b['pair_set_sha256'] for b in BUILDS['builds']}\n45:def population():\n46:    \"\"\"The scored window's articles by the clean selection rule: {input_id: content_sha256} and {id: day}.\"\"\"\n50:            'select input_id, publication_day, object_identifiers, text, feed, copy_of, supersedes, content_sha256 from items '\n58:def roots():\n64:def files_under(base):\n75:    \"\"\"Finds the window's ids and text sha256 values in bytes. An id is found wherever it starts with its prefix, whatever follows it, as\n110:def scan_bytes(stream, matcher):\n122:def pair_set_hash(conn, table):\n123:    pairs = sorted(f'{i}\\t{s}' for i, s in conn.execute(f'select input_id, content_sha256 from \"{table}\"'))\n124:    return hashlib.sha256('\\n'.join(pairs).encode()).hexdigest()\n127:def scan_sqlite(path, matcher, label):\n137:                if {'input_id', 'content_sha256'} <= set(columns):\n162:def scan_tar(path, matcher, scratch, label):\n202:def scan_file(args):\n226:def controls(ids, shas, scratch):\n251:    conn.execute('create table items (input_id text, content_sha256 text)')\n253:    conn.executemany('insert into items values (?, ?)', source.execute('select input_id, content_sha256 from items'))\n265:def main(out_dir, scratch):\n296:        'window': WINDOW, 'source': str(SOURCE), 'corpus_builds_sha256': hashlib.sha256((HERE / 'corpus-builds.json').read_bytes()).hexdigest(),\n305:    (out_dir / 'census.json.sha256').write_text(hashlib.sha256(text.encode()).hexdigest() + '  census.json\\n')\n__pycache__\nadjudicated\nanswers\nbatches\ncensus_merge.py\ncensus_readers.py\ndedup\ndedup-check-brief.md\ndedup-check-codex.md\ndedup-check-codex.stream\nlaunches.jsonl\nmatters-dedup-either-superseded.json\nmatters-dedup-either-superseded.json.sha256\nmatters-entries.json\nmatters-entries.json.sha256\nmatters-final-list.md\nmatters.json\nmatters.json.sha256\nmemory-probe.txt\nmerge.log\nmerged\nnumbering.json\nprompts\nprompts.sha256\nread.log\nreconciled\nthird\n","exit_code":0,"status":"completed"}}
