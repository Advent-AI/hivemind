cards.py:189:        key[cid] = {k: c[k] for k in ('draw', 'question', 'role', 'guardrail', 'covering', 'type', 'answered', 'opened')}\ndocs/research/2026-11-17-product-comparison/stage0/mark_cards.py:192:    KEY.write_text(json.dumps(key, indent=1) + '\\n')\ndocs/research/2026-11-17-product-comparison/stage0/mark_cards.py:193:    print(f'{len(full)} cards: {len(cards)} product, {len(controls)} controls; key in {KEY}')\ndocs/research/2026-11-17-product-comparison/stage0/mark_cards.py:210:    key = json.loads(KEY.read_text())\ndocs/research/2026-11-17-product-comparison/stage0/mark_cards.py:218:            if rows and valid(rows[-1], key[cid]['answered']) and not void:\ndocs/research/2026-11-17-product-comparison/stage0/mark_cards.py:307:    key = json.loads(KEY.read_text())\ndocs/research/2026-11-17-product-comparison/stage0/mark_cards.py:314:    for cid, k in sorted(key.items()):\ndocs/research/2026-11-17-product-comparison/stage0/mark_cards.py:325:    for cid, k in sorted(key.items()):\ndocs/research/2026-11-17-product-comparison/stage0/mark_cards.py:335:                      'deck_key_path': str(KEY), 'deck_key_sha256': hashlib.sha256(KEY.read_bytes()).hexdigest()}}\ndocs/research/2026-11-17-product-comparison/stage0/mapping.py:4:    python3 mapping.py export <run root> <out folder> <eligibility.json>   # each draw's library under a random label; key kept outside\ndocs/research/2026-11-17-product-comparison/stage0/mapping.py:37:KEY_FOLDER = Path.home() / '.hivemind-keys' / 'comparison-2026-11-17'\ndocs/research/2026-11-17-product-comparison/stage0/mapping.py:132:def answer_problem(rows, keys, ids):\ndocs/research/2026-11-17-product-comparison/stage0/mapping.py:137:    if sorted(named) != sorted(keys):\ndocs/research/2026-11-17-product-comparison/stage0/mapping.py:138:        return f'matters answered {len(named)} ({len(set(keys) - set(named))} missing, {len(named) - len(set(named))} repeated)'\ndocs/research/2026-11-17-product-comparison/stage0/mapping.py:157:def key_path(out):\ndocs/research/2026-11-17-product-comparison/stage0/mapping.py:158:    \"\"\"The mapping key of an export: a diagnostic export (finished draws of a run that cannot give a release verdict) keeps its own key.\"\"\"\ndocs/research/2026-11-17-product-comparison/stage0/mapping.py:159:    return KEY_FOLDER / ('mapping-key-diagnostic.json' if (Path(out) / 'DIAGNOSTIC').exists() else 'mapping-key.json')\ndocs/research/2026-11-17-product-comparison/stage0/mapping.py:162:def export(run_root, out, eligibility_path, diagnostic=False):\ndocs/research/2026-11-17-product-comparison/stage0/mapping.py:164:    are exported instead, marked DIAGNOSTIC, under their own key, and the scorer refuses them (their eligibility check does not pass;\ndocs/research/2026-11-17-product-comparison/stage0/mapping.py:174:    key = dict(zip(DRAWS, labels))\ndocs/research/2026-11-17-product-comparison/stage0/mapping.py:175:    key_file = KEY_FOLDER / ('mapping-key-diagnostic.json' if diagnostic else 'mapping-key.json')\ndocs/research/2026-11-17-product-comparison/stage0/mapping.py:176:    if key_file.exists():\ndocs/research/2026-11-17-product-comparison/stage0/mapping.py:177:        raise SystemExit(f'refused: {key_file} exists; an export never overwrites a key')\ndocs/research/2026-11-17-product-comparison/stage0/mapping.py:180:    for draw in key:\ndocs/research/2026-11-17-product-comparison/stage0/mapping.py:188:    key = {draw: label for draw, label in key.items() if draw in libraries}\ndocs/research/2026-11-17-product-comparison/stage0/mapping.py:193:    key_file.write_text(json.dumps(key, indent=1) + '\\n')\ndocs/research/2026-11-17-product-comparison/stage0/mapping.py:195:    for draw, label in key.items():\ndocs/research/2026-11-17-product-comparison/stage0/mapping.py:197:    print('exported', len(key), 'libraries; key in', key_file)\ndocs/research/2026-11-17-product-comparison/stage0/mapping.py:202:    text, keys = matters_text()\ndocs/research/2026-11-17-product-comparison/stage0/mapping.py:219:                void = answer_problem(json_lines(answer), keys, ids)\ndocs/research/2026-11-17-product-comparison/stage0/mapping.py:242:    duplicates = {max(str(r['duplicate']), str(r['of']), key=order.__getitem__) for r in rows if r.get('duplicate') is not None}\ndocs/research/2026-11-17-product-comparison/stage0/mapping.py:300:    key = json.loads(key_path(out).read_text())\ndocs/research/2026-11-17-product-comparison/stage0/mapping.py:301:    label_of = {d: l for d, l in key.items()}\n4107:## D382 · 2026-11-08 · Financial figures are conditions, not theses; a thesis is a view with a reason\n4119:## D384 · 2026-11-08 · Clean Step 1 opens only the big matters, by the signed standard as the frozen gold applies it\n4928:## D449 · 2026-11-13 · The wiring's code review: four structural rules, two changes to the run states (council consensus under D439)\n5546:## D489 · 2026-11-14 · The fresh week's result: not clear by the rule, no system chosen; the company's main numbers as questions goes to Alex (council consensus)\n5567:- **To Alex (his D382 and D384; nothing is sent before he answers):** (1) test questions on the company's main numbers on the new system\n5573:- **Asked** (after D489, his reply to this exact question): \"这一周的对比显示：现行系统会为营收、毛利率开问题；新系统按你之前定的规则（D382：财务数字是条件，不是\n5805:- **Decided:** a $0 reading on the fresh week of D489 (2026-09-22..28): the same code-only table built from the new system's stored\n5835:## D505 · 2026-11-15 · Alex: the kept financial figures should reach the judgements of related questions; first a $0 check\n5850:- **Check** (D505; `docs/research/2026-11-14-use-acceptance/delivery/DELIVERY-CHECK-RESULT.md`), $0: on the new system's stored fresh-week\n5956:- **Agreed on the record:** neither system has earned the choice; D489 stays \"not clear\"; the path promoted each newly exposed\n6012:- **What the page says:** the fresh week does not pick a winner (D489 stays \"not clear\"); the week's counts with their units and\n6209:- **For the package to Alex:** D375 is stated as his decision awaiting its build, not asked again; D505 stays his decision for the\n6630:- **Qualifications kept:** D505's rule was given for the new system; whether it applies to the old one stays open and is not\n7191:- **Decided, next:** a $0 sizing of D505's gap on the fortnight: the company's own financial statements (revenue, margin, outlook,\n7629:- **The run:** complete, 383 of 383 articles, 384 calls, $3.4485 on the shared ledger, with no refusal, stop or cut attempt (the\n8129:## D609 · 2026-11-16 · Under D439 (reflection council, fresh Codex thread 01a1e644): the next production step is a $0 source-to-request trace of the company's own figures on the carried fortnight (D505's delivery), with time, duplicate, population and relevance controls\n9589:## D671 · 2026-11-17 · Under D667 and D668 (council): the blind matter list is frozen at N = 32\n9614:- **Frozen:** `matters.json` (sha 5e68fb7c29820dc4…): **N = 32**, 7 of them company figures (D505's list). Each matter\n9618:## D672 · 2026-11-17 · Alex's \"开始跑\" with the stage-0 freeze review: the slice goes ahead; the scorer and cards are built during the run against a rule frozen to the last choice\n9645:## D673 · 2026-11-17 · Under D672: the card's blinding rule covers the form, not the system's own wording (before any output)\n9674:## D675 · 2026-11-18 · Under D672: the reading tools' review found them not ready; fixed, and the frozen rule's open readings written down (before any output)\n9676:- **Found** by the council review D672 requires (Codex thread `tools-review-codex.md`; a fresh Claude reader), both \"not ready\", before any\n   126\t### 1.5 What decides that it replaces the running pipeline (D665, superseding D548's gate order)\n   127\t\n   128\tAlex asked the council to determine whether the six lines still make sense and what decides readiness (D664: \"does it make sense now run your\n   129\tcouncil to determine\"). The council's consensus is D665.\n   130\t\n   131\t**The release decision is one product comparison against the running pipeline.**\n   132\t- **The systems.** poc-v118 is replayed against the new system as configured and hashed (astra-frozen; v5.5 excluded). Both start from empty\n   133\t  over 2026-07-01 to 07-19, three draws each, and are scored on the unread weeks from 07-20 up to 09-20, as far as the full exposure census\n   134\t  supports.\n   135\t- **The main quantity: big matters served.**\n   136\t  - Both reader families list the scored weeks' big matters from the articles, blind to any output, and freeze the list.\n   137\t  - A system serves a matter when, in at least two of three draws, it holds a question both families mark worth tracking and whose latest\n   138\t    answer both mark supported. The cards are read by the council (D663), with Alex spot-checking splits.\n   139\t  - With a = matters served only by the new system, b = only by the old, and N = all listed matters, written before the first send and computed\n   140\t    under both split countings:\n   141\t    - **Practical lead:** a − b ≥ max(3, 15% of N) and a ≥ 2b. Every guardrail subgroup must meet its frozen minimum and pass under both\n   142\t      countings.\n   143\t    - **Practical loss:** the mirror of the lead, or a guardrail breach confirmed under both countings.\n   144\t    - **No practical winner:** everything else, including a verdict a split could change, or a guardrail that was not exercised.\n   145\t    - **Too small:** fewer than 20 distinct matters, or fewer than 30 distinct questions per system per draw.\n   146\t    - **Invalid:** a planted wrong answer accepted, fewer than 3 of 4 supported controls accepted, or fewer than 2 of 3 repeats marked the same.\n   147\t- **The guardrails:** the unsupported share for figures, the unsupported share for yes/no questions, and the not-worth-tracking share, none\n   148\t  more than 10 points above the old system's. D428's original limits are printed beside them.\n   149\t- **Printed beside the verdict, not deciding:** a sign test and an interval (illustrative unless the frozen grouping supports them); the\n   150\t  frozen-reference reading of 07-01 to 07-14 (D431, superseded on this point only); and the proposed absolute floors.\n   151\t- **Kept from the earlier gates:**\n   152\t  - **The six lines of D400** are measured and reported on every ladder run. They no longer block release.\n   153\t  - **The parts code decides stay hard checks:** figure ranges meet end to end; the favourable end is the same across sends; the due day is\n   154\t    consistent in at least nine of ten.\n   155\t  - **Step 2's three checks stay,** as D427 and D431 set them.\n   156\t  - **Stage B's control line waits** with D658.\n   157\t- **Back to Alex,** before any release engineering resumes:\n   158\t  - a practical lead, with the split cards for his spot check;\n   159\t  - a practical loss, at once (D544);\n   160\t  - no practical winner, too small, or invalid, with the counts;\n   161\t  - no verdict by 2026-12-01.\n   162\t\n   163\t| Earlier gate | Now |\n   164\t|---|---|\n   165\t| 1. The ladder step (Stage A), Alex's six lines (D400) | Reported on every run. Its code-decidable parts are hard checks. Not passed in nine readings |\n   166\t| 2. The judge on the system's own questions (Stage B, D428) | Its unsupported shares become the comparison's guardrails. Its control line waits (D658). Not passed: 4 of 8 controls |\n   167\t| 3. End to end against the running pipeline (D427, D431) | **The comparison above.** The frozen-reference reading is printed beside it |\n   168\t| 4. Use on unseen news (D484) | Folded into the comparison, which runs on unseen weeks. Its proposed lines are printed beside it |\n   169\t| 5. Integration and release | Waits for a practical lead and Alex's word. Partly built (D570–D573; the D593 test-store contract); held by D662 |\n   625\t\n   626\t3. WHEN TO PROPOSE A NEW THESIS\n   627\t\n   628\tA thesis is a question a senior analyst would hold a card for: its answer could change a position because it could change the\n   629\tcompany's revenue, profit, cash or credit risk, or competitive position in a way you can name; public material will settle it on a\n   630\tdate; and no open thesis already asks it. A thesis asks one quantity for one period, or one event. It opens for one of four reasons, a closed set; a matter that fits none of them is\n   631\tevidence, kept and linked to the theses it informs or left unlinked, never a thesis:\n   632\t- product_node: when the generation of the main product that carries the company's value reaches the step that brings revenue,\n   633\t  usually first shipments; announcements and samples are its evidence, and only milestones an analyst bets on separately (a drug's\n   634\t  trial result and its approval) are separate theses (\"will the carmaker's new platform start deliveries in 2026?\";\n   635\t  \"will the drugmaker's next-generation inhaler, the product line that carries its value, reach pharmacies by mid-2027?\").\n   636\t- binding_obligation: an obligation the company takes on in its own name, large enough to change its revenue, profit, cash or credit\n   637\t  risk: guaranteeing, backing or giving credit support for another party's debt, lease, revenue or capacity, lending to it,\n   638\t  committing to buy capacity or services, or a sized stake or acquisition not yet completed. One already undertaken is tracked by its\n   639\t  amount at the next annual report; one not yet signed by whether it is signed by a check date within 18 months of the item (\"how much will the\n   640\t  utility have guaranteed for its project companies' loans at its next annual report?\"; \"will the retailer sign a guarantee for its\n   641\t  franchisees' leases, large enough to change its credit risk, by the check date?\"). Its own borrowing or leases and a completed\n   642\t  or unsized investment are not obligations.\n   643\t- shared_quantity: a quantity or price outside any one company that several companies depend on, for this or next calendar year:\n   644\t  several companies' combined output or spending, a contract price, an interest rate (\"the largest container lines' combined capacity\n   645\t  added in 2026\"; \"next year's average contract price of a raw material\"). Another population or wording of the same aggregate is\n   646\t  evidence for it.\n   647\t- policy_stage: the step a policy or regulatory process reaches, naming who decides (\"will the regulator approve the drug for a second\n   648\t  indication?\"; \"will the government require licences for the product's exports by a date?\").\n   649\t\n   650\t- Open only matters an analyst would bet on separately; small matters open no thesis and their statements are kept as evidence. A\n   651\t  customer's deployment plan is evidence for the company's demand and product theses, unless it changes the company's own cash or\n   652\t  credit risk, which is judged as an obligation.\n   653\t- Give the date the item supports. When it gives none, use the date the reason fixes and say how it was set: an obligation already\n   654\t  undertaken, its next annual report; an unsigned obligation, a check date within 18 months of the item; a pending regulatory\n   655\t  decision, the current fiscal year-end. A shared quantity takes its release date and a product event the date its outcome can be\n   656\t  checked, only when the item supports one. A question no date can settle is rewritten or not opened.\n   657\t- Do not open a thesis about: an executive appointment or organisational change; the company's own borrowing or leases as an\n   658\t  obligation; a buyback authorisation or dividend declaration; a financial measure's level, growth, margin or guidance for any period,\n   659\t  on its own; an undated moat or strategy; a feature, content or software update, price point, regional service or variant of a\n   660\t  product already on sale; another estimate, source or wording of what an open thesis tracks; an annual quantity after next year (an\n   661\t  obligation excepted); shareholder votes, bylaws or routine litigation procedure. Their statements are evidence for the theses they\n   662\t  inform, or left unlinked.\n   663\t- Before proposing a new thesis, name its reason (opens_as), the public material that will settle it (settled_by), and the closest\n   664\t  open thesis with why an analyst would bet on the two separately because their answers can move apart; with no open thesis, say so.\n   665\t  If the two cannot move apart, link the evidence to every open thesis it informs instead.\n   666\t\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_19","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba docs/research/2026-11-17-product-comparison/stage0/mapping.py | sed -n '29,132p;162,196p;248,330p'; nl -ba docs/DECISIONS-log.md | sed -n '9544,9644p'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_19","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba docs/research/2026-11-17-product-comparison/stage0/mapping.py | sed -n '29,132p;162,196p;248,330p'; nl -ba docs/DECISIONS-log.md | sed -n '9544,9644p'\"","aggregated_output":"    29\tsys.path[:0] = [str(HERE), str(HERE / 'census')]\n    30\timport build_cards  # noqa: E402\n    31\timport census_readers  # noqa: E402\n    32\tfrom census_merge import json_lines  # noqa: E402\n    33\t\n    34\tFAMILIES = census_readers.FAMILIES\n    35\tMATTERS = HERE / 'census' / 'matters.json'\n    36\tITEMS = Path('/Users/lchingen/hivemind/poc/data/comparison-2026-11-17/items-comparison.sqlite')\n    37\tKEY_FOLDER = Path.home() / '.hivemind-keys' / 'comparison-2026-11-17'\n    38\tDRAWS = ['new-1', 'new-2', 'new-3', 'old-1', 'old-2', 'old-3']\n    39\t\n    40\tREAD = \"\"\"# Blind reader: which of these big matters does this library hold a question on? (read-only)\n    41\t\n    42\tYou are a senior hedge-fund analyst covering NVIDIA. Below are the big matters readers listed from the news of 2026-09-07 to 09-20, each with\n    43\tan example question, and the library of one research system as it stood on 2026-09-20: every question it held, open or closed, with its id,\n    44\tdue day and possible answers. Systems write their questions in different styles; ignore style.\n    45\t\n    46\tFor each matter choose one:\n    47\t- **opened**: a question the same outcome would settle, in any reasonable wording, period or date (name its id);\n    48\t- **narrower**: a question on part of the matter (name its id, and say whether it carries the matter's main outcome);\n    49\t- **broader**: the matter is folded into a wider question;\n    50\t- **missed**: no question on it.\n    51\t\n    52\tDo not count a reasonable alternative shape as missed: a different deadline for the same outcome, or one year of a two-year matter, is\n    53\t\"opened\" or \"narrower\" with a note. Several questions may cover one matter: name them all.\n    54\t\n    55\tThen list the library's duplicates: two questions of the library are the same bet when the same outcome settles both and their answers\n    56\tcannot move apart (another year of a figure is another bet). Of such a pair, the later-opened question is the duplicate.\n    57\t\n    58\tWrite one JSON object per line, and nothing else:\n    59\t- per matter: {{\"matter\": \"M01\", \"status\": \"opened|narrower|broader|missed\", \"ids\": [\"...\"], \"main_outcome\": true|false|null, \"note\": \"<= 30 words\"}}\n    60\t- per duplicate: {{\"duplicate\": \"<later id>\", \"of\": \"<earlier id>\"}}\n    61\t\n    62\t## The matters\n    63\t\n    64\t{matters}\n    65\t\n    66\t## Library {label}\n    67\t\n    68\t{library}\n    69\t\"\"\"\n    70\t\n    71\tTHIRD = \"\"\"# Third reader: does this question cover this matter? (read-only)\n    72\t\n    73\tYou are a senior hedge-fund analyst covering NVIDIA. Two readers disagreed on whether the question below covers the matter below. A question\n    74\tcovers a matter when the same outcome would settle both (any reasonable wording, period or date), or when it is on part of the matter and\n    75\tcarries the matter's main outcome. Answer from the two texts.\n    76\t\n    77\tWrite one JSON object and nothing else: {{\"covers\": true|false, \"why\": \"<= 40 words\"}}\n    78\t\n    79\t## The matter\n    80\t\n    81\t{matter}\n    82\t\n    83\t## The question\n    84\t\n    85\t{question}\n    86\t\n    87\t## The article the question was opened from (for a date or period the question uses)\n    88\t\n    89\t{article}\n    90\t\"\"\"\n    91\t\n    92\t\n    93\tdef matters_text():\n    94\t    m = json.loads(MATTERS.read_text())['matters']\n    95\t    return '\\n'.join(f\"- {x['matter']}: {x['name']} (e.g. {x['question']})\" for x in m), [x['matter'] for x in m]\n    96\t\n    97\t\n    98\tdef library_text(lib):\n    99\t    lines = []\n   100\t    for e in lib:\n   101\t        lines.append(f\"- id {e['question_id']} · opened {e['opened']} · due {e['due']}: {e['question']}\")\n   102\t        lines += [f'    possible answer: {a}' for a in e['possible_answers']]\n   103\t    return '\\n'.join(lines)\n   104\t\n   105\t\n   106\tdef store_paths(run_root, draw):\n   107\t    \"\"\"The draw's store at its cutoff: refused unless the draw is complete (plan §1.4 item 10). The new system's judge folder is the one its\n   108\t    own record names as the completed attempt (`draw-<draw>` or, after D449's one redo, `draw-<draw>-redo`). None when the draw opened no\n   109\t    question (the launcher's `skipped` judge).\"\"\"\n   110\t    root = Path(run_root) / draw\n   111\t    record = json.loads((root / 'run.json').read_text())\n   112\t    if record.get('state') != 'complete':\n   113\t        raise SystemExit(f'refused: {draw} is {record.get(\"state\")!r}, not complete; no release verdict without six complete draws')\n   114\t    if draw.startswith('new'):\n   115\t        judge = record['components']['judge']\n   116\t        if judge['state'] == 'skipped':\n   117\t            return None\n   118\t        inner = json.loads((root / judge['folder'] / 'run.json').read_text())[draw]\n   119\t        if inner.get('state') != 'complete':\n   120\t            raise SystemExit(f'refused: {draw} judge is {inner.get(\"state\")!r}')\n   121\t        folder = root / judge['folder'] / inner['attempts'][-1]['folder']\n   122\t    else:\n   123\t        folder = root / record['components']['prod']['folder']\n   124\t    return folder / 'views.sqlite', folder / 'archive.sqlite'\n   125\t\n   126\t\n   127\tdef neutral_ids(lib):\n   128\t    \"\"\"Q1..Qn in the library's opening order; the system's id kept as `source_id`.\"\"\"\n   129\t    return [dict(e, question_id=f'Q{n}', source_id=e['question_id']) for n, e in enumerate(lib, 1)]\n   130\t\n   131\t\n   132\tdef answer_problem(rows, keys, ids):\n   162\tdef export(run_root, out, eligibility_path, diagnostic=False):\n   163\t    \"\"\"Export each draw's library. Refused unless the six draws are eligible; with `diagnostic`, the finished draws of an ineligible run\n   164\t    are exported instead, marked DIAGNOSTIC, under their own key, and the scorer refuses them (their eligibility check does not pass;\n   165\t    plan §1.4 item 10).\"\"\"\n   166\t    eligibility = json.loads(Path(eligibility_path).read_text())\n   167\t    if not eligibility.get('eligible') and not diagnostic:\n   168\t        raise SystemExit(f\"refused: the draws are not eligible: {eligibility.get('problems')}\")\n   169\t    out = Path(out)\n   170\t    if out.exists():\n   171\t        raise SystemExit(f'refused: {out} exists')\n   172\t    labels = [f'L{n}' for n in range(1, len(DRAWS) + 1)]\n   173\t    random.Random(20261117).shuffle(labels)\n   174\t    key = dict(zip(DRAWS, labels))\n   175\t    key_file = KEY_FOLDER / ('mapping-key-diagnostic.json' if diagnostic else 'mapping-key.json')\n   176\t    if key_file.exists():\n   177\t        raise SystemExit(f'refused: {key_file} exists; an export never overwrites a key')\n   178\t    import eligibility as eligibility_tool\n   179\t    libraries = {}\n   180\t    for draw in key:\n   181\t        if diagnostic and not eligibility['draws'].get(draw, {}).get('stores'):\n   182\t            continue                                            # a draw that did not finish: nothing to export\n   183\t        paths = store_paths(run_root, draw)\n   184\t        for p in paths or ():\n   185\t            if eligibility_tool.sha256(p) != eligibility['draws'][draw]['stores'][Path(p).name]['sha256']:\n   186\t                raise SystemExit(f'refused: {p} changed since the eligibility check')\n   187\t        libraries[draw] = neutral_ids(build_cards.library(*paths, ITEMS)) if paths else []\n   188\t    key = {draw: label for draw, label in key.items() if draw in libraries}\n   189\t    out.mkdir(parents=True)                                     # written only once every store passed its check\n   190\t    if diagnostic:\n   191\t        (out / 'DIAGNOSTIC').write_text('finished draws of a run that cannot give a release verdict (plan §1.4 item 10)\\n')\n   192\t    KEY_FOLDER.mkdir(parents=True, exist_ok=True)\n   193\t    key_file.write_text(json.dumps(key, indent=1) + '\\n')\n   194\t    (out / 'eligibility.json').write_text(Path(eligibility_path).read_text())\n   195\t    for draw, label in key.items():\n   196\t        (out / f'library-{label}.json').write_text(json.dumps(libraries[draw], indent=1, ensure_ascii=False) + '\\n')\n   248\t    split = []\n   249\t    for path in sorted(out.glob('library-L*.json')):\n   250\t        label = path.stem.split('-', 1)[1]\n   251\t        a, _ = marks(out, label, 'codex')\n   252\t        b, _ = marks(out, label, 'claude')\n   253\t        for matter in sorted(set(a) | set(b)):\n   254\t            for q in sorted(a.get(matter, set()) ^ b.get(matter, set())):\n   255\t                split.append((label, matter, q))\n   256\t    return split\n   257\t\n   258\t\n   259\tdef opening_article(input_id):\n   260\t    \"\"\"The opening article as week reading A2 showed it: title, publisher, day and text, from the comparison's item database.\"\"\"\n   261\t    conn = build_cards.ro(ITEMS)\n   262\t    row = conn.execute('select title, publisher, publication_day, text from items where input_id=?', (input_id,)).fetchone()\n   263\t    if row is None:\n   264\t        return '(not an article: the question was not opened from a stored article)'\n   265\t    return f\"{row['title']} · {row['publisher']} · {row['publication_day']}\\n\\n{row['text']}\"\n   266\t\n   267\t\n   268\tdef third(out):\n   269\t    out = Path(out)\n   270\t    m = {x['matter']: x for x in json.loads(MATTERS.read_text())['matters']}\n   271\t    libs = {p.stem.split('-', 1)[1]: {e['question_id']: e for e in json.loads(p.read_text())} for p in out.glob('library-L*.json')}\n   272\t    jobs = []\n   273\t    for label, matter, q in disagreements(out):\n   274\t        entry = libs[label][q]\n   275\t        for reader in FAMILIES:\n   276\t            dest = out / 'third' / f'{label}--{matter}--{q}--{reader}.json'\n   277\t            if not dest.exists():\n   278\t                question = f\"{entry['question']} (due {entry['due']}); possible answers: \" + ' | '.join(entry['possible_answers'])\n   279\t                jobs.append((reader, THIRD.format(matter=f\"{m[matter]['name']} (e.g. {m[matter]['question']})\", question=question,\n   280\t                                                  article=opening_article(entry.get('opened_from'))), dest))\n   281\t\n   282\t    def one(job):\n   283\t        reader, prompt, dest = job\n   284\t        for attempt in (1, 2):\n   285\t            answer, void = census_readers.run(reader, prompt)\n   286\t            rows = json_lines(answer) if answer else []\n   287\t            if rows and isinstance(rows[-1].get('covers'), bool) and not void:\n   288\t                dest.parent.mkdir(exist_ok=True)\n   289\t                dest.write_text(json.dumps(rows[-1], ensure_ascii=False) + '\\n')\n   290\t                return dest.name, None\n   291\t        return dest.name, void or 'no covers mark'\n   292\t    print(len(jobs), 'third-reader sessions')\n   293\t    with concurrent.futures.ThreadPoolExecutor(max_workers=6) as pool:\n   294\t        for name, void in pool.map(one, jobs):\n   295\t            print(name, 'VOID ' + void if void else 'marked', flush=True)\n   296\t\n   297\t\n   298\tdef result(out):\n   299\t    out = Path(out)\n   300\t    key = json.loads(key_path(out).read_text())\n   301\t    label_of = {d: l for d, l in key.items()}\n   302\t    mapping, distinct = {}, {}\n   303\t    for draw, label in label_of.items():\n   304\t        a, dup_a = marks(out, label, 'codex')\n   305\t        b, dup_b = marks(out, label, 'claude')\n   306\t        lib = json.loads((out / f'library-{label}.json').read_text())\n   307\t        mapping[draw] = {}\n   308\t        for matter in sorted(set(a) | set(b)):\n   309\t            entries = []\n   310\t            for q in sorted(a.get(matter, set()) | b.get(matter, set())):\n   311\t                if q in a.get(matter, set()) and q in b.get(matter, set()):\n   312\t                    covers = True\n   313\t                else:\n   314\t                    paths = [out / 'third' / f'{label}--{matter}--{q}--{reader}.json' for reader in FAMILIES]\n   315\t                    missing = [p.name for p in paths if not p.exists()]\n   316\t                    if missing:\n   317\t                        raise SystemExit(f'refused: third-reader marks missing {missing}')\n   318\t                    thirds = [json.loads(p.read_text())['covers'] for p in paths]\n   319\t                    covers = True if thirds == [True, True] else False if thirds == [False, False] else 'split'\n   320\t                entries.append({'question': q, 'covers': covers})\n   321\t            if any(e['covers'] is not False for e in entries):\n   322\t                mapping[draw][matter] = [e for e in entries if e['covers'] is not False]\n   323\t        distinct[draw] = {'ids': len(lib), 'duplicates_both': len(dup_a & dup_b), 'duplicates_split': len(dup_a ^ dup_b)}\n   324\t    text = json.dumps({'mapping': mapping, 'distinct': distinct,\n   325\t                       'eligibility_sha256': hashlib.sha256((out / 'eligibility.json').read_bytes()).hexdigest()},\n   326\t                      indent=1, ensure_ascii=False) + '\\n'\n   327\t    (out / 'mapping.json').write_text(text)\n   328\t    print('mapping.json written', hashlib.sha256(text.encode()).hexdigest()[:16])\n   329\t\n   330\t\n  9544\t\n  9545\t## D669 · 2026-11-17 · Alex: score on 09-07 to 09-20, excluding only articles a system processed or a reader read\n  9546\t\n  9547\t- **Found** (`docs/research/2026-11-17-product-comparison/stage0/census-out-full/census.json`; RUN-LOG): under D667's rule every one of the\n  9548\t  720 articles of 08-31 to 09-20 is a read.\n  9549\t  - Most of the touches are corpus storage (superseded corpus states in the backups, run-local corpus copies) and code-only corpus censuses.\n  9550\t  - The week of 08-31 was processed end to end by the old system's seven-day runs of 2026-11-05.\n  9551\t  - The weeks of 09-07 and 09-14 were processed only in part (the new system's 11-09 acceptance run, Step 2 councils, source reviews).\n  9552\t- **Asked**, at the plan's return trigger: \"这次对比怎么走？\" The options:\n  9553\t  - fetch the fresh news after 10-28 (recommended);\n  9554\t  - exclude only what was really read, and compare 09-07 to 09-20;\n  9555\t  - exclude nothing and disclose;\n  9556\t  - stop.\n  9557\t- **Alex:** \"只排除真被读过的，比9/7–9/20\". The option's text as shown: \"把\"碰过\"改成只算系统真处理过或读者真读过的文章，存副本和程序批量检查不算。8/31 那周仍排除，只剩两周，议题可能不到 20 个，结论容易是\"样本太小\"。缺点：这条规则是看到排查结果之后才定的。\"\n  9558\t- **Decided:**\n  9559\t  - The scored window is **2026-09-07 to 09-20**. The warm-up is 07-01 to 09-06, unfiltered. The cutoff stays 09-20.\n  9560\t  - **Not a read,** and only these:\n  9561\t    - corpus storage (the rows of any `items` table, and corpus backups);\n  9562\t    - pool lists (`manifest.json`, `selection.json`, a Step 1 trace's `run` table);\n  9563\t    - the outputs of code-only corpus censuses (a file whose folder has a producing script that calls no model and holds no reader\n  9564\t      material).\n  9565\t  - **Everything else is a read,** including any file in a folder with no script to show it is code-only.\n  9566\t  - The rule's exact form is frozen in `stage0/classify_reads.py` after a council check. It was written after the hit kinds were seen and\n  9567\t    before any system output, as Alex's option says.\n  9568\t- **Unchanged:** the census reads every kept article (D668). N < 20 is still \"too small\" and returns to Alex before any paid send.\n  9569\t\n  9570\t## D670 · 2026-11-17 · Under D669 (council check): 410 of the 502 articles of 09-07 to 09-20 are kept and frozen\n  9571\t\n  9572\t- **Check** of D669's rule (`stage0/classify_reads.py`):\n  9573\t  - a fresh read of every not-read location by the Codex council thread (`stage0/reads-check-codex.md`) and by a closed Claude checker;\n  9574\t  - each finding was confirmed against the files before it was used.\n  9575\t- **Agreed by both, applied:**\n  9576\t  - **Four kept articles were reads.** Their own text was shown without an id to the source-loss council's reader, in that folder's\n  9577\t    `round1.jsonl` and `round3.jsonl`. Each is confirmed by finding its text in the session. They are named in `READER_SHOWN` with the\n  9578\t    session.\n  9579\t  - Nine more showed only page boilerplate (a promotion, an advertisement, a breadcrumb), not the article, and are not reads.\n  9580\t  - Two misclassed kinds change no count: the d369 three-row probe selection and the sample contexts.\n  9581\t- **Split, the cheaper and safer course taken (D439):**\n  9582\t  - 37 articles whose only reads are the source-lineage and context-restoration bulk outputs and their two viewers stay excluded.\n  9583\t  - Codex would keep them, since the human review covered 30 packets and none of these 37. The Claude checker would not change the rule,\n  9584\t    since a viewer page was built for a person (`clean-arch/STEP1-SOURCE-CONTEXT-OBSERVATIONS.md`).\n  9585\t  - With them, kept would be 447. Disclosed with the result.\n  9586\t- **Frozen:** `stage0/kept-articles.json` (sha 6999d037…): **410 articles**, 172 in the week of 09-07 and 238 in the week of 09-14.\n  9587\t- **Next:** the blind matter census reads every kept article (D668). N < 20 returns to Alex before any paid send.\n  9588\t\n  9589\t## D671 · 2026-11-17 · Under D667 and D668 (council): the blind matter list is frozen at N = 32\n  9590\t\n  9591\t- **The census** (`docs/research/2026-11-17-product-comparison/stage0/census/`):\n  9592\t  - the 410 kept articles were read in 11 batches by both families, in 22 closed sessions, 0 void;\n  9593\t  - the Codex memory probe answered \"no\";\n  9594\t  - each family merged its own lists, a reconciler of each family paired the two lists, and third readers of both families judged the\n  9595\t    one-family matters (94 sessions). That gave 38 entries (`matters-entries.json`).\n  9596\t- **Same-bet entries were left apart** by the pair-by-pair reconciliation, for example three Anthropic IPO entries that differ only in their\n  9597\t  deadline. Two steps were added before any system output exists:\n  9598\t  - **dedup:** both families group the 38 entries by D248;\n  9599\t  - **blind adjudication:** a pair only one family grouped, or a pair the council's check named, is read against its articles by one closed\n  9600\t    reader of each family.\n  9601\t  - A merge needs a grouping both families made, or both adjudicators. Merging on either family's grouping alone was rejected: it joined five\n  9602\t    Hugging Face entries that neither family grouped together (`dedup-check-codex.md`).\n  9603\t- **Merged:**\n  9604\t  - the FY2028 gross margin (2 entries);\n  9605\t  - the Anthropic IPO investment (3);\n  9606\t  - residual-value support (2);\n  9607\t  - the Hugging Face closing and the regulatory action;\n  9608\t  - the five-company 2027 capital expenditure with its data-centre wording (adjudicated).\n  9609\t- **Split, kept apart and disclosed** (one adjudicator each way):\n  9610\t  - the five-company 2026 capital expenditure against its data-centre wording;\n  9611\t  - the OpenAI Ohio guarantee against the total guarantees.\n  9612\t\n  9613\t  A bet counted twice can only weigh a matter one system serves and the other does not.\n  9614\t- **Frozen:** `matters.json` (sha 5e68fb7c29820dc4…): **N = 32**, 7 of them company figures (D505's list). Each matter\n  9615\t  has one canonical question.\n  9616\t- **The plan** (v11) names `matters.json` as the only scoring list. Its hash goes in the versions manifest.\n  9617\t\n  9618\t## D672 · 2026-11-17 · Alex's \"开始跑\" with the stage-0 freeze review: the slice goes ahead; the scorer and cards are built during the run against a rule frozen to the last choice\n  9619\t\n  9620\t- **Alex** (after N = 32 was reported): \"好，你clean up提交，然后开始跑\". Committed as `099f4a8`.\n  9621\t- **The freeze review** (`docs/research/2026-11-17-product-comparison/freeze-review-codex.md`; a closed Claude reviewer), both NOT READY.\n  9622\t  - **Fixed** (all agreed):\n  9623\t    - each ladder pass is checked on its own, so an empty pass no longer passes by the others (test and mutant);\n  9624\t    - the verdict rule names the direction of the 10-point bar, the minimum per system, closed questions counting, the two third readers,\n  9625\t      the sampler (sorted ids, `random.Random(20261117).sample(ids, 35)`) and the controls (a rung moved, 3 per system; supported controls\n  9626\t      confirmed first);\n  9627\t    - the card the readers see is frozen (`stage0/card-spec.md`), with a blinding test on stored draws;\n  9628\t    - the launcher refuses uncommitted code in `src`, `scripts`, `clean-arch`, `poc/config` and the stage-0 scripts, refuses a ledger whose\n  9629\t      ceiling is not the guard, and takes redos;\n  9630\t    - the new judge's size was measured: at most 100 KB, 21.9K input tokens over the carried fortnight.\n  9631\t  - **Split, on building the scorer, the card builder and the §1.6 tools during the run instead of before the slice:**\n  9632\t    - Codex refuses. D665 and D667 make the reviewed instruments a gate before the first send.\n  9633\t    - The Claude reviewer accepts under D665 (it freezes the rule, not the code that applies it), provided the rule leaves the code nothing to\n  9634\t      choose and the departure from D667 is recorded.\n  9635\t  - **Taken,** on Alex's word and the Claude reviewer's conditions: the rule and the card are frozen to the last choice. The scorer, the\n  9636\t    builder (with its blinding test) and the §1.6 tools are built and council-reviewed before any output is read. No output is read during\n  9637\t    the run except progress counts.\n  9638\t- **The slice** (07-01..07-07, one draw of each system, its own ledgers at $10 and $3) stands in for the fake-answer dry run, with two added\n  9639\t  checks:\n  9640\t  - each draw processed exactly the manifest's items for those days, in order;\n  9641\t  - a day's state can be read back from the stored outputs (for D431's 07-14 reading).\n  9642\t\n  9643\t  It has no other job. Any failure goes back to the council before the full run.\n  9644\t\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_20","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"python3 -c 'import json,pathlib\nd=pathlib.Path(\\\"poc/data/comparison-2026-11-17/reading-diagnostic\\\")\nfor p in sorted((d/\\\"mapping-out\\\").glob(\\\"library-L*\\\")):\n a=json.loads(p.read_text())\n print(p.name,len(a))\n for q in a:\n  if p.stem.endswith((\\\"1\\\",\\\"2\\\",\\\"3\\\",\\\"5\\\",\\\"6\\\")):\n   print(q[\\\"question_id\\\"],q[\\\"type\\\"],q[\\\"question\\\"])\no=json.loads((d/\\\"deck/readings.json\\\").read_text())\nprint([(k,type(v).__name__,len(v)) for k,v in o.items()])\nprint(o[\\\"cards\\\"][list(o[\\\"cards\\\"])[0]][:2])\n'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_20","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"python3 -c 'import json,pathlib\nd=pathlib.Path(\\\"poc/data/comparison-2026-11-17/reading-diagnostic\\\")\nfor p in sorted((d/\\\"mapping-out\\\").glob(\\\"library-L*\\\")):\n a=json.loads(p.read_text())\n print(p.name,len(a))\n for q in a:\n  if p.stem.endswith((\\\"1\\\",\\\"2\\\",\\\"3\\\",\\\"5\\\",\\\"6\\\")):\n   print(q[\\\"question_id\\\"],q[\\\"type\\\"],q[\\\"question\\\"])\no=json.loads((d/\\\"deck/readings.json\\\").read_text())\nprint([(k,type(v).__name__,len(v)) for k,v in o.items()])\nprint(o[\\\"cards\\\"][list(o[\\\"cards\\\"])[0]][:2])\n'\"","aggregated_output":"library-L1.json 43\nQ1 figure How much credit support will NVIDIA have committed under its AI-cloud model by the publication of its FY2027 annual report?\nQ2 figure At NVIDIA's FY2027 annual report, how much will its commitments for customer and cloud-provider credit support, guarantees, and capacity backstops reach?\nQ3 yes/no Will NVIDIA sign a financial guarantee for OpenAI's Ohio data-center lease by 2027-07-01?\nQ4 yes/no Will NVIDIA begin shipping Vera Rubin by 2026-12-31?\nQ5 figure How much will the four largest AI hyperscalers spend on data-center capital expenditures in calendar 2026?\nQ6 figure How much will the four largest AI hyperscalers spend on data-center capital expenditures in calendar 2027?\nQ7 yes/no Will NVIDIA launch its Kyber rack-scale architecture by 2027-12-31?\nQ8 figure How much revenue will NVIDIA generate from stand-alone CPU sales in FY2027?\nQ9 figure How much Data Center segment revenue will NVIDIA report for FY2027?\nQ10 yes/no Will China's authorities authorize Chinese AI companies to purchase Nvidia H200 chips by 2027-01-31?\nQ11 yes/no Will NVIDIA complete its proposed investment of about US$500 million in Firmus preference shares by 2026-12-31?\nQ12 yes/no Will NVIDIA launch its GeForce RTX 60-series GPUs by 2027-12-31?\nQ13 yes/no Will th