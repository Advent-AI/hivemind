, sqlite3\\nroot=pathlib.Path(\\\\\\\"poc/data\\\\\\\")\\nfor group, labels in [(\\\\\\\"comparison-2026-11-17/run\\\\\\\", (\\\\\\\"old-1\\\\\\\",\\\\\\\"old-2\\\\\\\",\\\\\\\"old-3\\\\\\\")), (\\\\\\\"clean-e2e-full-2026-11-13\\\\\\\", (\\\\\\\"p1\\\\\\\",\\\\\\\"p2\\\\\\\",\\\\\\\"p3\\\\\\\"))]:\\n  for label in labels:\\n    base=root/group/label\\n    run=json.loads((base/\\\\\\\"run.json\\\\\\\").read_text())\\n    if run[\\\\\\\"state\\\\\\\"] \\\"'!= \\\"complete\\\":\\n      print(label, run[\\\"state\\\"])\\n      continue\\n    attempt=run[\\\"components\\\"][\\\"prod\\\"][\\\"attempts\\\"][-1]\\n    if attempt[\\\"state\\\"] != \\\"completed\\\": continue\\n    path=base/\\\"prod/archive.sqlite\\\"\\n    if any(path.with_name(path.name + suffix).exists() for suffix in (\\\"-wal\\\",\\\"-shm\\\",\\\"-journal\\\")):\\n      print(label,\\\"skipped, sidecar\\\")\\n      continue\\n    duration=datetime.datetime.fromisoformat(attempt[\\\"ended at\\\"])-datetime.datetime.fromisoformat(attempt[\\\"started at\\\"])\\n    print(label,\\\"runtime\\\",duration)\\n    with sqlite3.connect(path.resolve().as_uri()+\\\"?mode=ro&immutable=1\\\",uri=True) as c:\\n      rows=c.execute(\\\"\\\"\\\"\\n        select purpose, model, request_sha256, input_tokens, output_tokens,\\n               case when json_valid(response_json) then coalesce(json_extract(response_json,'\\\"'\\\\\\\\''\\\"'$.usage.prompt_tokens_details.cached_tokens'\\\"'\\\\\\\\''),0) else 0 end,\\n               case when json_valid(response_json) then coalesce(json_extract(response_json,'\\\\\\\\''\\\"'$.usage.input_tokens'\\\"'\\\\\\\\''),0) else 0 end\\n        from model_calls\\n      \\\\\\\"\\\\\\\"\\\\\\\")\\n      total=0\\n      outcomes=collections.Counter()\\n      purpose_counts=collections.Counter()\\n      peak=0\\n      for purpose,name,sha,i,o,cached,jev_tokens in rows:\\n        purpose_counts[purpose]+=1\\n        i,o=i or 0,o or 0\\n        if name==\\\\\\\"jev-1.14.0\\\\\\\":\\n          total+=(jev_tokens or i)*.042/1e6\\n        elif name==\\\\\\\"gpt-6-luna\\\\\\\":\\n          total+=((i-min(cached,i))*.10+min(cached,i)*.01+o*.50)/1e6\\n        else:\\n          raise ValueError(name)\\n        if \\\\\\\"judg\\\\\\\" in purpose: peak=max(peak,i)\\n        if \\\\\\\":\\\\\\\" in sha: outcomes[(purpose,sha.split(\\\\\\\":\\\\\\\")[1])]+=1\\n      print(\\\\\\\"token USD\\\\\\\", round(total,6), \\\\\\\"counts\\\\\\\", dict(purpose_counts), \\\\\\\"refusals\\\\\\\", dict(outcomes), \\\\\\\"judge peak\\\\\\\", peak)\\n'\\\"\",\"aggregated_output\":\"\",\"exit_code\":null,\"status\":\"in_progress\"}}\ndocs/research/2026-11-20-production-readiness/council-p-codex.stream:65:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_33\",\"type\":\"command_execution\",\"command\":\"/opt/homebrew/bin/zsh -lc \\\"python3 -B -c '\\nimport collections, datetime, json, pathlib, sqlite3\\nroot=pathlib.Path(\\\\\\\"poc/data\\\\\\\")\\nfor group, labels in [(\\\\\\\"comparison-2026-11-17/run\\\\\\\", (\\\\\\\"old-1\\\\\\\",\\\\\\\"old-2\\\\\\\",\\\\\\\"old-3\\\\\\\")), (\\\\\\\"clean-e2e-full-2026-11-13\\\\\\\", (\\\\\\\"p1\\\\\\\",\\\\\\\"p2\\\\\\\",\\\\\\\"p3\\\\\\\"))]:\\n  for label in labels:\\n    base=root/group/label\\n    run=json.loads((base/\\\\\\\"run.json\\\\\\\").read_text())\\n    if run[\\\\\\\"state\\\\\\\"] \\\"'!= \\\"complete\\\":\\n      print(label, run[\\\"state\\\"])\\n      continue\\n    attempt=run[\\\"components\\\"][\\\"prod\\\"][\\\"attempts\\\"][-1]\\n    if attempt[\\\"state\\\"] != \\\"completed\\\": continue\\n    path=base/\\\"prod/archive.sqlite\\\"\\n    if any(path.with_name(path.name + suffix).exists() for suffix in (\\\"-wal\\\",\\\"-shm\\\",\\\"-journal\\\")):\\n      print(label,\\\"skipped, sidecar\\\")\\n      continue\\n    duration=datetime.datetime.fromisoformat(attempt[\\\"ended at\\\"])-datetime.datetime.fromisoformat(attempt[\\\"started at\\\"])\\n    print(label,\\\"runtime\\\",duration)\\n    with sqlite3.connect(path.resolve().as_uri()+\\\"?mode=ro&immutable=1\\\",uri=True) as c:\\n      rows=c.execute(\\\"\\\"\\\"\\n        select purpose, model, request_sha256, input_tokens, output_tokens,\\n               case when json_valid(response_json) then coalesce(json_extract(response_json,'\\\"'\\\\\\\\''\\\"'$.usage.prompt_tokens_details.cached_tokens'\\\"'\\\\\\\\''),0) else 0 end,\\n               case when json_valid(response_json) then coalesce(json_extract(response_json,'\\\\\\\\''\\\"'$.usage.input_tokens'\\\"'\\\\\\\\''),0) else 0 end\\n        from model_calls\\n      \\\\\\\"\\\\\\\"\\\\\\\")\\n      total=0\\n      outcomes=collections.Counter()\\n      purpose_counts=collections.Counter()\\n      peak=0\\n      for purpose,name,sha,i,o,cached,jev_tokens in rows:\\n        purpose_counts[purpose]+=1\\n        i,o=i or 0,o or 0\\n        if name==\\\\\\\"jev-1.14.0\\\\\\\":\\n          total+=(jev_tokens or i)*.042/1e6\\n        elif name==\\\\\\\"gpt-6-luna\\\\\\\":\\n          total+=((i-min(cached,i))*.10+min(cached,i)*.01+o*.50)/1e6\\n        else:\\n          raise ValueError(name)\\n        if \\\\\\\"judg\\\\\\\" in purpose: peak=max(peak,i)\\n        if \\\\\\\":\\\\\\\" in sha: outcomes[(purpose,sha.split(\\\\\\\":\\\\\\\")[1])]+=1\\n      print(\\\\\\\"token USD\\\\\\\", round(total,6), \\\\\\\"counts\\\\\\\", dict(purpose_counts), \\\\\\\"refusals\\\\\\\", dict(outcomes), \\\\\\\"judge peak\\\\\\\", peak)\\n'\\\"\",\"aggregated_output\":\"Traceback (most recent call last):\\n  File \\\"<string>\\\", line 17, in <module>\\nValueError: Invalid isoformat string: '2026-11-18T01:20:48-0800'\\n\",\"exit_code\":1,\"status\":\"failed\"}}\ndocs/research/2026-11-20-production-readiness/council-p-codex.stream:66:{\"type\":\"item.started\",\"item\":{\"id\":\"item_34\",\"type\":\"command_execution\",\"command\":\"/opt/homebrew/bin/zsh -lc \\\"python3 -B -c '\\nimport collections, datetime, json, pathlib, sqlite3\\nroot=pathlib.Path(\\\\\\\"poc/data\\\\\\\")\\nfor grou