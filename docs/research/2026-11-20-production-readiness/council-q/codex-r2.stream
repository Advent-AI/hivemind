failed'] += 1\\nsrc/hivemind/replay.py:110:                    log(f'  ! {result.input_id[:60]}: {result.failed}')\\nsrc/hivemind/replay.py:111:                    raise RuntimeError(f'item failed; day {day} remains resumable: {result.failed}')\\nsrc/hivemind/replay.py:123:        if judged.failed:\\nsrc/hivemind/replay.py:124:            day_stats['failed'] += 1\\nsrc/hivemind/replay.py:125:            log(f'  ! day judging: {judged.failed}')\\nsrc/hivemind/replay.py:126:            raise RuntimeError(f'judging failed; day {day} remains resumable: {judged.failed}')\\nsrc/hivemind/replay.py:135:        day_cost = cost - day_cost_before  # Includes discarded speculative calls and repaired refusals.\\nsrc/hivemind/replay.py:137:        log(f'{day} | items {day_stats[\\\"items\\\"]:3d} extracted {day_stats[\\\"extracted\\\"]:3d} merged {day_stats[\\\"merged\\\"]:2d} skipped {day_stats[\\\"not_processed\\\"]:2d} '\\nsrc/hivemind/replay.py:138:            f'failed {day_stats[\\\"failed\\\"]:2d} | evidence {day_stats[\\\"evidence\\\"]:3d} new views {day_stats[\\\"new_views\\\"]:2d} judged {day_stats[\\\"judged\\\"]:3d} '\\nsrc/hivemind/replay.py:143:            log(f'day 0 snapshot written: {views_path}.day0.sqlite')\\nsrc/hivemind/extraction.py:8:is refused before any call, and a new version is a new decision with its own code. Every answer is read in the canonical vocabulary.\\\"\\\"\\\"\\nsrc/hivemind/extraction.py:215:# is refused; a comparison sign (>, ~, ≥) is not a token, so a quote that drops one is repaired to the source text that carries it.\\nsrc/hivemind/extraction.py:241:    \\\"\\\"\\\"The source passage a refused quote stands for (D236, D266), or None. Accepted: the quote's words equal one passage's words\\nsrc/hivemind/extraction.py:278:# D266 (2026-11-02, Alex: the quote refusals of core statements are an important class, fix it quickly): the stored quote is still the exact\\nsrc/hivemind/extraction.py:283:# A changed month, party, product or number, a paraphrase, and two names swapped are refused as before (D236's tests hold).\\nsrc/hivemind/extraction.py:611:    the text, links to shown questions or kept candidates, one piece per sentence. A statement whose links all fail keeps an empty\\nsrc/hivemind/views/round.py:5:failed step itself) and never repeats a completed step.\\\"\\\"\\\"\\nsrc/hivemind/views/round.py:23:    failed: str = ''\\nsrc/hivemind/views/round.py:27:def _fail(conn, item, seq, result, step, kind, detail, pool_key):\\nsrc/hivemind/views/round.py:28:    dispatch.mark(conn, item, seq, step, 'failed', detail[:300])\\nsrc/hivemind/views/round.py:30:    result.failed = detail[:200]\\nsrc/hivemind/views/round.py:36:    \\\"\\\"\\\"One matching call with one retry on a refused check. Returns Checked, or None after marking the failure.\\\"\\\"\\\"\\nsrc/hivemind/views/round.py:45:            _fail(conn, item, seq, result, 'matched', 'matching_failed', 'matching: ' + repr(error), type(error).__name__)\\nsrc/hivemind/views/round.py:56:                     checks_json=json.dumps({'refusals': checked.refusals, 'not_opened': checked.not_opened, 'notes': checked.notes}, ensure_ascii=False), written_json=None)\\nsrc/hivemind/views/round.py:57:        if not checked.refusals:\\nsrc/hivemind/views/round.py:59:        note = '；'.join(checked.refusals)\\nsrc/hivemind/views/round.py:60:    _fail(conn, item, seq, result, 'matched', 'matching_refused_twice', 'matching refused twice: ' + note, item['category'])\\nsrc/hivemind/views/round.py:91:        return _fail(conn, marker, seq, result, 'judged', 'judgement_refused_twice', 'judgement refused twice: ' + str(error), 'day')\\nsrc/hivemind/views/round.py:93:        return _fail(conn, marker, seq, result, 'judged', 'judging_failed', 'judging: ' + repr(error), type(error).__name__)\\nsrc/hivemind/views/round.py:116:            return _fail(conn, item, seq, result, 'extracted', 'extraction_failed', 'extraction: ' + repr(error), type(error).__name__)\\nsrc/hivemind/views/round.py:158:        return _fail(conn, item, seq, result, 'written', 'writing_failed', 'writing: ' + repr(error), type(error).__name__)\\n\",\"exit_code\":0,\"status\":\"completed\"}}\ndocs/research/2026-11-20-production-readiness/council-p-codex.stream:61:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_31\",\"type\":\"command_execution\",\"command\":\"/opt/homebrew/bin/zsh -lc \\\"nl -ba src/hivemind/model.py | sed -n '39,119p;254,311p'; rg -n 'trace|_attempt|checks_json|refus' scripts/preflight.py src/hivemind/views/judging.py src/hivemind/model.py | head -67; ls poc/data/clean-e2e-full-2026-11-13/{p1,p2,p3}/prod; nl -ba docs/research/2026-11-17-product-comparison/RUN-PLAN-v12.md | sed -n '143,173p'; nl -ba scripts/hivemind_api.py | sed -n '26,43p;155,204p'; nl -ba scripts/hivemind_mcp.py | sed -n '27,54p;80,103p'\\\"\",\"aggregated_output\":\"    39\\tSCHEMA_SQL = \\\"\\\"\\\"\\n    40\\tcreate table if not exists model_calls (\\n    41\\t  call_id integer primary key autoincrement, purpose text, config_version text, config_checksum text, model text,\\n    42\\t  request_sha256 text unique, request_json text, response_json text, answer_json text, prompt_chars integer,\\n    43\\t  input_tokens integer, output_tokens integer, cost_usd real, seconds real, created_at text\\n    44\\t);\\n    45\\tcreate index if not exists model_calls_sha on model_calls(request_sha256);\\n    46\\t\\\"\\\"\\\"\\n    47\\t\\n    48\\t\\n    49\\tclass SchemaError(ValueError):\\n    50\\t    pass\\n    51\\t\\n    52\\t\\n    53\\tclass TransportError(RuntimeError):\\n    54\\t    pass\\n    55\\t\\n    56\\t\\n    57\\t@dataclasses.dataclass\\n    58\\tclass Answer:\\n    59\\t    data: dict\\n    60\\t    call_id: int\\n    61\\t    request_sha256: str\\n    62\\t    cached: bool\\n    63\\t    prompt_chars: int\\n    64\\t    input_tokens: int\\n    65\\t    output_tokens: int\\n    66\\t    cost_usd: float\\n    67\\t\\n    68\\t\\n    69\\tclass Archive:\\n    70\\t    \\\"\\\"\\\"Shared by the extraction worker threads: one connection, every access under a lock.\\\"\\\"\\\"\\n    71\\t\\n    72\\t    def __init__(self, path):\\n    73\\t        os.makedirs(os.path.dirname(os.path.abspath(path)), exist_ok=True)\\n    74\\t        self.conn = sqlite3.connect(path, check_same_thread=False)\\n    75\\t        self.conn.executescript(SCHEMA_SQL)\\n    76\\t        import threading\\n    77\\t        self.lock = threading.Lock()\\n    78\\t\\n    79\\t    def lookup(self, sha):\\n    80\\t        with self.lock:\\n    81\\t            return self.conn.execute('select call_id, answer_json, prompt_chars, input_tokens, output_tokens from model_calls where request_sha256=?', (sha,)).fetchone()\\n    82\\t\\n    83\\t    def record(self, **fields):\\n    84\\t        \\\"\\\"\\\"One row per distinct request; a second identical request recorded at the same moment (two threads, or a\\n    85\\t        failed answer repeated within the same second) keeps the first row's id instead of failing.\\\"\\\"\\\"\\n    86\\t        columns = list(fields)\\n    87\\t        with self.lock:\\n    88\\t            cursor = self.conn.execute(f'insert or ignore into model_calls ({\\\",\\\".join(columns)}) values ({\\\",\\\".join(\\\"?\\\" * len(columns))})',\\n    89\\t                                       [fields[c] for c in columns])\\n    90\\t            self.conn.commit()\\n    91\\t            if cursor.rowcount == 0:\\n    92\\t                return self.conn.execute('select call_id from model_calls where request_sha256=?', (fields['request_sha256'],)).fetchone()[0]\\n    93\\t            return cursor.lastrowid\\n    94\\t\\n    95\\t    def retire(self, call_id):\\n    96\\t        \\\"\\\"\\\"A code check refused this answer: the row stays for the record, but no later identical request is answered with it\\n    97\\t        (the same shape as a schema-refused or malformed row, whose hash carries a suffix).\\\"\\\"\\\"\\n    98\\t        with self.lock:\\n    99\\t            self.conn.execute(\\\"update model_calls set request_sha256 = request_sha256 || ':refused:' || ? where call_id=? and request_sha256 not like '%:refused:%'\\\",\\n   100\\t                              (uuid.uuid4().hex[:8], call_id))\\n   101\\t            self.conn.commit()\\n   102\\t\\n   103\\t    def totals(self):\\n   104\\t        with self.lock:\\n   105\\t            return self.conn.execute('select count(*), coalesce(sum(cost_usd),0), coalesce(sum(input_tokens),0), coalesce(sum(output_tokens),0) from model_calls').fetchone()\\n   106\\t\\n   107\\t\\n   108\\tdef _key(provider):\\n   109\\t    name = ENDPOINTS[provider][1]\\n   110\\t    if os.environ.get(name):\\n   111\\t        return os.environ[name]\\n   112\\t    with open(CREDENTIALS, encoding='utf-8') as handle:\\n   113\\t        return json.load(handle)[name]\\n   114\\t\\n   115\\t\\n   116\\tdef build_request(setting, system, user, schema, schema_name, provider):\\n   117\\t    request = {\\n   118\\t        'model': setting.model,\\n   119\\t        'messages': [{'role': 'system', 'content': system}, {'role': 'user', 'content': user}],\\n   254\\t    request_json, sha = request_identity(request)\\n   255\\t    hit = archive.lookup(sha)\\n   256\\t    prompt_chars = len(system) + len(user)\\n   257\\t    if hit:\\n   258\\t        call_id, answer_json, _, input_tokens, output_tokens = hit\\n   259\\t        return Answer(json.loads(answer_json), call_id, sha, True, prompt_chars, input_tokens or 0, output_tokens or 0, 0.0)\\n   260\\t    started = time.time()\\n   261\\t    response = (transport or openai_transport)(provider, request)\\n   262\\t    seconds = round(time.time() - started, 1)\\n   263\\t    try:\\n   264\\t        content = response['choices'][0]['message']['content']\\n   265\\t        data = json.loads(content)\\n   266\\t    except (KeyError, IndexError, TypeError, json.JSONDecodeError) as error:\\n   267\\t        archive.record(purpose=purpose, config_version=cfg.version, config_checksum=cfg.checksum, model=setting.model,\\n   268\\t                       request_sha256=sha + ':malformed:' + uuid.uuid4().hex[:8], request_json=request_json,\\n   269\\t                       response_json=json.dumps(response)[:200000], answer_json=None, prompt_chars=prompt_chars,\\n   270\\t                       input_tokens=0, output_tokens=0, cost_usd=0.0, seconds=seconds, created_at=time.strftime('%Y-%m-%dT%H:%M:%S'))\\n   271\\t        raise SchemaError(f'malformed answer: {error}')\\n   272\\t    errors = check_schema(data, schema)\\n   273\\t    usage = response.get('usage') or {}\\n   274\\t    input_tokens = int(usage.get('prompt_tokens') or 0)\\n   275\\t    output_tokens = int(usage.get('completion_tokens') or 0)\\n   276\\t    cached_tokens = min(input_tokens, int((usage.get('prompt_tokens_details') or {}).get('cached_tokens') or 0))\\n   277\\t    price_in, price_out = PRICES.get(setting.model, (0.0, 0.0))\\n   278\\t    cost = round((input_tokens - cached_tokens) / 1e6 * price_in + cached_tokens / 1e6 * price_in * CACHED_INPUT_SHARE + output_tokens / 1e6 * price_out, 6)\\n   279\\t    call_id = archive.record(purpose=purpose, config_version=cfg.version, config_checksum=cfg.checksum, model=setting.model,\\n   280\\t                             request_sha256=sha if not errors else sha + ':schema:' + uuid.uuid4().hex[:8], request_json=request_json,\\n   281\\t                             response_json=json.dumps(response)[:200000], answer_json=json.dumps(data, ensure_ascii=False),\\n   282\\t                             prompt_chars=prompt_chars, input_tokens=input_tokens, output_tokens=output_tokens, cost_usd=cost,\\n   283\\t                             seconds=seconds, created_at=time.strftime('%Y-%m-%dT%H:%M:%S'))\\n   284\\t    if errors:\\n   285\\t        raise SchemaError('; '.join(errors[:5]))\\n   286\\t    return Answer(data, call_id, sha, False, prompt_chars, input_tokens, output_tokens, cost)\\nsrc/hivemind/model.py:96:        \\\"\\\"\\\"A code check refused this answer: the row stays for the record, but no later identical request is answered with it\\nsrc/hivemind/model.py:97:        (the same shape as a schema-refused or malformed row, whose hash carries a suffix).\\\"\\\"\\\"\\nsrc/hivemind/model.py:99:            self.conn.execute(\\\"update model_calls set request_sha256 = request_sha256 || ':refused:' || ? where call_id=? and request_sha256 not like '%:refused:%'\\\",\\nsrc/hivemind/model.py:131:def openai_transport(provider, request, timeout=180, max_attempts=3):   # the default preserves the production retry behavior\\nsrc/hivemind/model.py:137:    if isinstance(max_attempts, bool) or not isinstance(max_attempts, int) or max_attempts < 1:\\nsrc/hivemind/model.py:138:        raise ValueError('max_attempts must be a positive integer')\\nsrc/hivemind/model.py:139:    for attempt in range(max_attempts):\\nsrc/hivemind/model.py:146:                    if max_attempts != 1:\\nsrc/hivemind/model.py:156:                    if max_attempts != 1:\\nsrc/hivemind/model.py:164:            body_text = body_bytes.decode('utf-8', 'replace' if max_attempts == 1 else 'ignore')\\nsrc/hivemind/model.py:176:        if max_attempts == 3 or attempt + 1 < max_attempts:\\nsrc/hivemind/views/judging.py:7:refused before any call. Every answer is stored in the canonical vocabulary.\\nsrc/hivemind/views/judging.py:19:rung, and an empty one is refused.\\\"\\\"\\\"\\nsrc/hivemind/views/judging.py:323:                archive.retire(answer.call_id)                 # a refused answer never answers the same request again (a resume re-samples)\\nscripts/preflight.py:6:the cases judged, the cases refused and the reasons with examples:\\nscripts/preflight.py:8:  A. answers the schema refused (prompt and schema disagree: a value the prompt's wording suggested but the enum lacks)\\nscripts/preflight.py:50:def tally(title, judged, refused, reasons, examples):\\nscripts/preflight.py:51:    share = f'{refused / judged:.0%}' if judged else 'n/a'\\nscripts/preflight.py:52:    print(f'\\\\n== {title}: judged {judged}, refused/dropped {refused} ({share})')\\nscripts/preflight.py:61:    rows = archive_conn.execute(\\\"select purpose, request_sha256, answer_json from model_calls where request_sha256 like '%:schema:%' or request_sha256 like '%:malformed:%' or request_sha256 like '%:refused:%'\\\")\\nscripts/preflight.py:71:    tally('A. answers the schema refused (prompt/schema disagreements; empty when the provider enforces the schema server-side)', judged, judged, reasons, examples)\\nscripts/preflight.py:113:        if any(marker in sha for marker in (':schema:', ':malformed:', ':refused:')):\\nscripts/preflight.py:157:    print(f'\\\\n   extraction archive rows {len(rows)}: replayed {judged}, earlier refused {other}, retired {sum(unverifiable.values())}, '\\nscripts/preflight.py:185:    written is refused with the snapshot route named; the path checked on both sides of the open and after the copy; the copy made by\\nscripts/preflight.py:222:    judged = refused_records = 0\\nscripts/preflight.py:253:                judged += 1; refused_records += 1; ledger_judged += 1\\nscripts/preflight.py:257:            if checked.refusals:\\nscripts/preflight.py:258:                refused_records += 1\\nscripts/preflight.py:259:            for refusal in checked.refusals:\\nscripts/preflight.py:260:                key = normalise_reason(refusal)\\nscripts/preflight.py:262:                examples[key].append(f'{os.path.basename(os.path.dirname(path))} {rec[\\\"input_id\\\"][:40]}: {refusal[:90]}')\\nscripts/preflight.py:264:    tally('C. matching code checks over stored records (database state is the final one, not the state at the time)', judged, refused_records, reasons, examples)\\npoc/data/clean-e2e-full-2026-11-13/p1/prod:\\narchive.sqlite\\nmanifests\\nreplay.log\\nviews.sqlite\\n\\npoc/data/clean-e2e-full-2026-11-13/p2/prod:\\narchive.sqlite\\nmanifests\\nreplay.log\\nviews.sqlite\\n\\npoc/data/clean-e2e-full-2026-11-13/p3/prod:\\narchive.sqlite\\nmanifests\\nreplay.log\\nviews.sqlite\\n   143\\t4. **The cards and their marks:**\\n   144\\t   - **Worth tracking:** worth, trivia or duplicate. Each card lists its library's other questions in opening order, with their opening days.\\n   145\\t     `duplicate` is marked only on the later question of a same-bet pair.\\n   146\\t   - **Answer:** supported, unsupported, insufficient, or no answer (a question not judged by the cutoff).\\n   147\\t   - **Cannot tell:** a split after the debate rounds, resolved in each counting by item 7.\\n   148\\t5. **Served in a draw:** at least one covering question is marked `worth` and supported, in each counting after item 7's resolution. A matter **served by a system** is served in\\n   149\\t   at least 2 of its 3 draws.\\n   150\\t6. **The quantities:** a = served only by the new system; b = served only by the old; N = all listed matters.\\n   151\\t7. **The two countings.** A split (\\\"cannot tell\\\" after the debate rounds) resolves to one of the marks its readers actually gave.\\n   152\\t   - **Counting 1:** the new system's cards take the most favourable mark given; the old system's cards take the least favourable.\\n   153\\t   - **Counting 2:** the reverse.\\n   154\\t   - **The order:** for the mapping, covers > does not cover; for the answer, supported > insufficient > unsupported; for worth, worth >\\n   155\\t     duplicate or trivia.\\n   156\\t   - **How a resolved mark counts:** it counts as that mark. A resolved supported or unsupported mark enters the decided denominators. A\\n   157\\t     resolved insufficient mark stays out of them, as any insufficient mark does.\\n   158\\t   - A guardrail subgroup is **exercised** only with at least 10 cards decided **without** a split. A subgroup that is not exercised cannot\\n   159\\t     breach. It blocks only a practical lead; a loss established otherwise still stands.\\n   160\\t8. **The guardrails** (D428's measure, which D665 turns into these guardrails):\\n   161\\t   - **The sample:** the random guardrail sample only, 35 questions per system-draw by seed 20261117, or all of them when a library holds\\n   162\\t     fewer. Covering cards are not in these shares. The three draws are pooled per system.\\n   163\\t   - **The shares:**\\n   164\\t     - the share of **decided** figure-question answers (supported or unsupported) that are unsupported;\\n   165\\t     - the same for yes/no questions;\\n   166\\t     - the share of decided worth marks that are trivia or duplicate.\\n   167\\t   - **Reported beside, not in the shares:** insufficient and no answer, with the number of splits and how each counting resolved them.\\n   168\\t   - **The bar:** the new system's share may not be more than 10 points above the old system's.\\n   169\\t   - **Exercised:** each subgroup needs at least 10 cards per system decided without a split (item 7), or it is \\\"not exercised\\\".\\n   170\\t9. **The controls,** outside every product count:\\n   171\\t   - 6 planted wrong answers (a rung moved, 3 per system). Each needs an explicit unsupported or insufficient mark, or the reading is invalid.\\n   172\\t   - 4 supported controls, confirmed first by a separate reader.\\n   173\\t   - 3 hidden repeats.\\n    26\\timport http.server\\n    27\\timport json\\n    28\\timport os\\n    29\\timport sys\\n    30\\timport urllib.parse\\n    31\\t\\n    32\\tROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))\\n    33\\tsys.path.insert(0, os.path.join(ROOT, 'src'))\\n    34\\tfrom hivemind import bundle, config, idea, live_lock, model, search, service  # noqa: E402\\n    35\\tfrom hivemind.views import store  # noqa: E402\\n    36\\t\\n    37\\tPATHS = {}\\n    38\\tALIASES = {}\\n    39\\tCFG = None\\n    40\\tSEMANTIC = True\\n    41\\tREQUEST_ERRORS = (KeyError, service.LedgerError, live_lock.LockRefused, model.TransportError, model.SchemaError, config.ConfigError, ValueError, TypeError)\\n    42\\t\\n    43\\t\\n   155\\t    def do_GET(self):\\n   156\\t        url = urllib.parse.urlsplit(self.path)\\n   157\\t        q = {k: v[0] for k, v in urllib.parse.parse_qs(url.query).items()}\\n   158\\t        parts = [p for p in url.path.split('/') if p]\\n   159\\t        self._answer(lambda db: route(db, parts, q), read_only=parts in (['library'], ['thesis-bundles']))\\n   160\\t\\n   161\\t    def do_POST(self):\\n   162\\t        parts = [p for p in urllib.parse.urlsplit(self.path).path.split('/') if p]\\n   163\\t        length = int(self.headers.get('Content-Length') or 0)\\n   164\\t        raw = self.rfile.read(length) if length else b''\\n   165\\t\\n   166\\t        def request_body():\\n   167\\t            if parts != ['ideas']:\\n   168\\t                raise KeyError('/'.join(parts))\\n   169\\t            try:\\n   170\\t                body = json.loads(raw or b'{}')\\n   171\\t            except json.JSONDecodeError as error:\\n   172\\t                raise ValueError(f'the body is not JSON: {error}')\\n   173\\t            if not isinstance(body, dict) or not str(body.get('text') or '').strip():\\n   174\\t                raise ValueError('POST /ideas needs a JSON body with text')\\n   175\\t            return body\\n   176\\t\\n   177\\t        def prepare(db):\\n   178\\t            \\\"\\\"\\\"The store's date refusals, before any header (OPERATING-CONTRACT.md, row 3): a first-day store, and a date after the last\\n   179\\t            completed day. A malformed body or a missing configuration is answered in the stream, as before (D281).\\\"\\\"\\\"\\n   180\\t            try:\\n   181\\t                as_of = request_body().get('as_of') or None\\n   182\\t            except (KeyError, ValueError):\\n   183\\t                as_of = None                          # the body's own error is raised by `work`, in the stream\\n   184\\t            service.resolve_bound(db.ledger, as_of)\\n   185\\t\\n   186\\t        def work(db, on_progress=None):\\n   187\\t            body = request_body()\\n   188\\t            if CFG is None:\\n   189\\t                raise config.ConfigError('the server was started without --config, so it cannot read ideas')\\n   190\\t            return idea.read_idea(db.ledger, db.index, db.items, db.archive, CFG, body['text'], body.get('as_of') or None,\\n   191\\t                                  int(body.get('k') or 10), aliases=ALIASES, semantic=SEMANTIC, bundles=body.get('bundles', True) is not False,\\n   192\\t                                  on_progress=on_progress)\\n   193\\t        accepted = [part.split(';', 1)[0].strip() for part in self.headers.get('Accept', '').split(',')]\\n   194\\t        if parts == ['ideas'] and 'application/x-ndjson' in accepted:\\n   195\\t            self._stream_answer(work, prepare)\\n   196\\t        else:\\n   197\\t            self._answer(work)\\n   198\\t\\n   199\\tdef flag(value):\\n   200\\t    return str(value).lower() in ('1', 'true', 'yes')\\n   201\\t\\n   202\\t\\n   203\\tdef route(db, parts, q):\\n   204\\t    ledger, as_of = db.ledger, q.get('as_of') or None\\n    27\\tparser.add_argument('--transport', choices=['stdio', 'streamable-http'], default='stdio', help='stdio for a local agent; streamable-http to serve /mcp over HTTP (Docker)')\\n    28\\tparser.add_argument('--host', default='127.0.0.1')\\n    29\\tparser.add_argument('--port', type=int, default=8789)\\n    30\\tARGS = parser.parse_args()\\n    31\\tALIASES = search_module.object_aliases(ARGS.universe)\\n    32\\t\\n    33\\tfrom hivemind import idea as idea_module  # noqa: E402\\n    34\\t\\n    35\\t\\n    36\\t@contextlib.contextmanager\\n    37\\tdef connections():\\n    38\\t    \\\"\\\"\\\"One tool call's databases (live-service/OPERATING-CONTRACT.md, row 2): the ledger, items and index opened per call, never shared\\n    39\\t    between calls (a search writes the index's query cache); the ledger's committed state pinned by BEGIN and a first read; every\\n    40\\t    connection closed on every path, a failure while opening included.\\\"\\\"\\\"\\n    41\\t    opened = []\\n    42\\t    try:\\n    43\\t        ledger = service.open_pinned(ARGS.views)\\n    44\\t        opened.append(ledger)\\n    45\\t        index = search_module.open_index(ARGS.index)\\n    46\\t        opened.append(index)\\n    47\\t        items = store.open_read_only(ARGS.items) if os.path.exists(ARGS.items) else None\\n    48\\t        if items is not None:\\n    49\\t            opened.append(items)\\n    50\\t        yield ledger, items, index\\n    51\\t    finally:\\n    52\\t        if opened and opened[0].in_transaction:\\n    53\\t            opened[0].rollback()\\n    54\\t        for conn in reversed(opened):\\n    80\\t    'with a search engine on top. To read an idea against it: first break the idea into its parts, the one to four '\\n    81\\t    'questions whose answers decide it (each about one concrete quantity, date or event); search with the idea and with '\\n    82\\t    'each part (k=20); map each part to every view whose question answers it or whose outcome would move it, leaving out '\\n    83\\t    'views that only share a company or a word; then read each mapped view (state as of a day, history, evidence) and '\\n    84\\t    'say what the judged positions tell about each part and which parts no view covers. Say judged, never true. Every '\\n    85\\t    'tool takes as_of, a calendar day; the default is the ledger\\\\'s last completed day. Nothing here changes the ledger. '\\n    86\\t    'search matches each view\\\\'s own text (question, what it looks at, ladder conditions; Chinese, English queries work): '\\n    87\\t    'ask for one object and one quantity or event per query; views(object) lists everything under one object. '\\n    88\\t    + OBJECTS))\\n    89\\t\\n    90\\t\\n    91\\t@mcp.tool()\\n    92\\tdef thesis_library(as_of: str = '') -> dict:\\n    93\\t    \\\"\\\"\\\"All collected theses and their stored research groups, including ungrouped and closed theses.\\n    94\\t    Membership is not a dependency or a parent-child relationship. No model call or ledger write.\\\"\\\"\\\"\\n    95\\t    with connections() as (ledger, items, _index):\\n    96\\t        return bundle.library(ledger, items, as_of or None)\\n    97\\t\\n    98\\t\\n    99\\t@mcp.tool()\\n   100\\tdef thesis_bundles(view_ids: list[str], as_of: str = '') -> dict:\\n   101\\t    \\\"\\\"\\\"Complete UI inputs for selected thesis ids: dated states, assessments, sources, evidence and relationships.\\n   102\\t    Pass this envelope to the frontend's fromBundles adapter. Read-only; does not call a model.\\\"\\\"\\\"\\n   103\\t    with connections() as (ledger, items, _index):\\n\",\"exit_code\":0,\"status\":\"completed\"}}\ndocs/research/2026-11-20-production-readiness/council-p-codex.stream:63:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_32\",\"type\":\"command_execution\",\"command\":\"/opt/homebrew/bin/zsh -lc \\\"nl -ba poc/data/comparison-2026-11-17/reading-diagnostic/diagnostic-count.json | head -95; rg -n 'NVIDIA|nvda|not measured|never' docs/prd/README.md docs/research/2026-11-14-use-acceptance/DECISION-PAGE-2026-11-16.md | head -30; rg -n 'v74i|golden-v5' docs/research/2026-11-01-e2e-loop -g '*.md' | rg '70|187|118|q[123]' | cut -c1-400 | head -26; rg -n 'time|seconds|cost|latency|fresh' poc/reports/2026-10-2*-analyst* docs/research/2026-11-14-use-acceptance/idea-planner/RESULT.md -g '*.md' | cut -c1-320 | head -40\\\"\",\"aggregated_output\":\"     1\\t{\\n     2\\t \\\"note\\\": \\\"DIAGNOSTIC, not a release verdict: five finished draws (new-1 stopped after its one redo); a matter is served by a system when it is served in at least 2 of that system's finished draws (both of new-2 and new-3; 2 of 3 old)\\\",\\n     3\\t \\\"draws\\\": [\\n     4\\t  \\\"new-2\\\",\\n     5\\t  \\\"new-3\\\",\\n     6\\t  \\\"old-1\\\",\\n     7\\t  \\\