gpt-6-luna\\\\\\\":\\n          total+=((i-min(cached,i))*.10+min(cached,i)*.01+o*.50)/1e6\\n        else:\\n          raise ValueError(name)\\n        if \\\\\\\"judg\\\\\\\" in purpose: peak=max(peak,i)\\n        if \\\\\\\":\\\\\\\" in sha: outcomes[(purpose,sha.split(\\\\\\\":\\\\\\\")[1])]+=1\\n      print(\\\\\\\"token USD\\\\\\\", round(total,6), \\\\\\\"counts\\\\\\\", dict(purpose_counts), \\\\\\\"refusals\\\\\\\", dict(outcomes), \\\\\\\"judge peak\\\\\\\", peak)\\n'\\\"\",\"aggregated_output\":\"\",\"exit_code\":null,\"status\":\"in_progress\"}}\ndocs/research/2026-11-20-production-readiness/council-p-codex.stream:67:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_34\",\"type\":\"command_execution\",\"command\":\"/opt/homebrew/bin/zsh -lc \\\"python3 -B -c '\\nimport collections, datetime, json, pathlib, sqlite3\\nroot=pathlib.Path(\\\\\\\"poc/data\\\\\\\")\\nfor group, labels in [(\\\\\\\"comparison-2026-11-17/run\\\\\\\", (\\\\\\\"old-1\\\\\\\",\\\\\\\"old-2\\\\\\\",\\\\\\\"old-3\\\\\\\")), (\\\\\\\"clean-e2e-full-2026-11-13\\\\\\\", (\\\\\\\"p1\\\\\\\",\\\\\\\"p2\\\\\\\",\\\\\\\"p3\\\\\\\"))]:\\n  for label in labels:\\n    base=root/group/label\\n    run=json.loads((base/\\\\\\\"run.json\\\\\\\").read_text())\\n    if run[\\\\\\\"state\\\\\\\"] \\\"'!= \\\"complete\\\":\\n      print(label, run[\\\"state\\\"])\\n      continue\\n    attempt=run[\\\"components\\\"][\\\"prod\\\"][\\\"attempts\\\"][-1]\\n    if attempt[\\\"state\\\"] != \\\"completed\\\": continue\\n    path=base/\\\"prod/archive.sqlite\\\"\\n    if any(path.with_name(path.name + suffix).exists() for suffix in (\\\"-wal\\\",\\\"-shm\\\",\\\"-journal\\\")):\\n      print(label,\\\"skipped, sidecar\\\")\\n      continue\\n    date=lambda field: datetime.datetime.strptime(attempt[field],\\\"%Y-%m-%dT%H:%M:%S%z\\\")\\n    print(label,\\\"runtime\\\",date(\\\"ended at\\\")-date(\\\"started at\\\"))\\n    with sqlite3.connect(path.resolve().as_uri()+\\\"?mode=ro&immutable=1\\\",uri=True) as c:\\n      rows=c.execute(\\\"\\\"\\\"\\n        select purpose, model, request_sha256, input_tokens, output_tokens,\\n               case when json_valid(response_json) then coalesce(json_extract(response_json,'\\\"'\\\\\\\\''\\\"'$.usage.prompt_tokens_details.cached_tokens'\\\"'\\\\\\\\''),0) else 0 end,\\n               case when json_valid(response_json) then coalesce(json_extract(response_json,'\\\\\\\\''\\\"'$.usage.input_tokens'\\\"'\\\\\\\\''),0) else 0 end\\n        from model_calls\\n      \\\\\\\"\\\\\\\"\\\\\\\")\\n      total=0\\n      outcomes=collections.Counter()\\n      purpose_counts=collections.Counter()\\n      peak=0\\n      for purpose,name,sha,i,o,cached,jev_tokens in rows:\\n        purpose_counts[purpose]+=1\\n        i,o=i or 0,o or 0\\n        if name==\\\\\\\"jev-1.14.0\\\\\\\":\\n          total+=(jev_tokens or i)*.042/1e6\\n        elif name==\\\\\\\"gpt-6-luna\\\\\\\":\\n          total+=((i-min(cached,i))*.10+min(cached,i)*.01+o*.50)/1e6\\n        else:\\n          raise ValueError(name)\\n        if \\\\\\\"judg\\\\\\\" in purpose: peak=max(peak,i)\\n        if \\\\\\\":\\\\\\\" in sha: outcomes[(purpose,sha.split(\\\\\\\":\\\\\\\")[1])]+=1\\n      print(\\\\\\\"token USD\\\\\\\", round(total,6), \\\\\\\"counts\\\\\\\", dict(purpose_counts), \\\\\\\"refusals\\\\\\\", dict(outcomes), \\\\\\\"judge peak\\\\\\\", peak)\\n'\\\"\",\"aggregated_output\":\"old-1 runtime 2:44:33\\ntoken USD 7.401877 counts {'extract': 1884, 'match': 5536, 'judge': 1610} refusals {('judge', 'refused'): 1} judge peak 61209\\nold-2 runtime 2:44:24\\ntoken USD 6.718742 counts {'extract': 1884, 'match': 5233, 'judge': 1620} refusals {('judge', 'refused'): 4} judge peak 44286\\nold-3 runtime 2:44:42\\ntoken USD 6.845528 counts {'extract': 1884, 'match': 5590, 'judge': 1709} refusals {('judge', 'refused'): 2} judge peak 59215\\np1 runtime 0:15:27\\ntoken USD 0.441559 counts {'extract': 243, 'match': 467, 'judge': 92} refusals {} judge peak 25565\\np2 runtime 0:15:13\\ntoken USD 0.405517 counts {'extract': 243, 'match': 451, 'judge': 80} refusals {} judge peak 20250\\np3 runtime 0:15:07\\ntoken USD 0.49022 counts {'extract': 243, 'match': 480, 'judge': 104} refusals {} judge peak 22575\\n\",\"exit_code\":0,\"status\":\"completed\"}}\ndocs/research/2026-11-20-production-readiness/council-p-codex.stream:71:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_36\",\"type\":\"command_execution\",\"command\":\"/opt/homebrew/bin/zsh -lc \\\"rg --files docs/research/2026-11-01-e2e-loop | rg 'proof-v108|frozen-v108' | head -40; rg -n 'v74i|poc-v108' docs/research/2026-11-01-e2e-loop/design-v78-fields.md | tail -21 | cut -c1-420; nl -ba src/hivemind/jev.py | sed -n '80,118p'; nl -ba docs/CURRENT_STATE.md | sed -n '407,439p'; nl -ba docs/DECISIONS-log.md | sed -n '3499,3515p'; nl -ba docs/research/2026-11-14-use-acceptance/DECISION-PAGE-2026-11-16.md | sed -n '248,285p'; rg -n 'health|Alert|Monitor|def .*status' scripts/hivemind_api.py scripts/hivemind_mcp.py docs/research/2026-11-17-product-comparison/stage0/launch_comparison.py\\\"\",\"aggregated_output\":\"docs/research/2026-11-01-e2e-loop/predictions-r9-frozen-v108.sha256\\ndocs/research/2026-11-01-e2e-loop/e2e-funnel-r9-frozen-v108.txt\\ndocs/research/2026-11-01-e2e-loop/predictions-r9-frozen-v108.md\\ndocs/research/2026-11-01-e2e-loop/proof-v108-a-mixed11.txt\\ndocs/research/2026-11-01-e2e-loop/proof-v108-collapse-r1.txt\\ndocs/research/2026-11-01-e2e-loop/proof-v108-c-noise10.txt\\ndocs/research/2026-11-01-e2e-loop/proof-v108-collapse-r2.txt\\ndocs/research/2026-11-01-e2e-loop/proof-v108-b-supporting29.txt\\ndocs/research/2026-11-01-e2e-loop/question-recall-r9-frozen-v108.txt\\ndocs/research/2026-11-01-e2e-loop/judgement-gold/score-r9-frozen-v108-d3.txt\\ndocs/research/2026-11-01-e2e-loop/judgement-gold/score-r9-frozen-v108-d2.txt\\ndocs/research/2026-11-01-e2e-loop/judgement-gold/score-r9-frozen-v108-d1.txt\\n350:**v74i / poc-v108（22:06；Alex：\\\"收窄那三句，直接测\\\"）：** v74h 的复核三句收窄（删\\\"具体后果\\\"；\\\"有名字的价格、租金、交货期或订单在变\\\"，泛泛的\\\"需求仍强、产品仍受欢迎\\\"不算；只限\\\"新披露的\\\"数字，文中当作早已存在的交易带金额也是现成安排）。预测（发送前）：杂音 ≤ 89（不高于现默认 v74d），核心 ≥ 65，辅助 ≥ 90。没应验说明什么：杂音没降 → 多出来的不只是这三句，再逐条对；核心掉 → 收窄碰到了北京 / 四芯片 / 微软积压那几类，读原始答案。\\n352:**v74i 结果（`proof-v108-*`，`sends/poc-v108-*.json`；三组 50 篇，每篇 3 次，一轮）：**\\n354:| | v94 存档 | v74d 现默认 | v74h 兜底 | **v74i 三句收窄** | 预测 |\\n362:v74i 对现默认三项都好：核心 +11（四芯片取消 0 → 3、北京拒绝 0 → 2、年度 AI 资本开支 0 → 2 这三件一直漏的都回来）、辅助 +30、杂音 −8。仍是一轮 3 次；核心和辅助的差距远大于抽样波动，杂音 −8 在波动之内（说\\\"不比现默认多\\\"）。\\n364:**Alex（22:15）：\\\"那致癌案（债务兜底那篇）的核心事实不就退步了\\\"**：兜底那篇（2.6 万字，T8）三次发送写出的条数差很多（v74i [17, 6, 16]，v74h [13, 4, 7]，v74g [9, 3, 8]），写得少的那几次只记中段的兜底计划、跳过开头的市场判断（核心）和后面的预测；核心\\\"市场估计仍明显偏低\\\"的有无跟着条数摆。$0 普查（六个版本的存档答案）：最少一次不到最多一次一半的比例，5 千字以下 17%、5 千–1 万 26%、1–2 万 39%、2 万以上 50%。假设：低推理强度下长文章的通读不完整。**poc-v109**：v74i 不改一字，推理强度 low → medium，输出上限都到 16,000。预测：2 万字以上那篇的最少/最多比 ≥ 0.7，核心\\\"市场估计偏低\\\"≥ 2/3；三组要收 ≥ v74i 的 187，杂音不高于 v74i 的 81 + 10。没应验说明什么：仍\\n366:**v74j / poc-v113（22:38；Codex 第三轮首推）：** v74i 加代码切段（约 2,500 字一段，[S1]…，原文每行不变）和复核最后一句逐段再走一遍，把通过检验但还没写的补上，推理仍 low。预测：兜底那篇最少/最多 ≥ 0.6、核心市场估计偏低≥ 8/9；三组要收 ≥ 195，杂音 ≤ 95。\\n368:**poc-v114（v74k：v74i 的文字 + v74f 的严格挂题，中推理）：** 假设：推理\\\"中\\\"让通读完整（兜底那篇核心 9/9），严格挂题挡住总收入题收容的杂音。预测：要收 ≥ 200，杂音 ≤ 90。\\n372:1. **兜底那篇的机制**：同一版本三次发送写出的条数差很多（v74i [17, 6, 16]），写得少的几次整段跳过开头的市场判断和后面的预测。各发 9 次：低推理\\\"市场估计仍明显偏低\\\"7/9、年度资本开支 3/9、开始为租约兜底 7/9、Sharon 48.8 亿 7/9；中推理 9/9、6/9、9/9、9/9。第一轮的 1/3 一部分是抽样，一部分是低推理通读不全。\\n374:3. **推理档位**（v74i 文字不变；三组 50 篇各 3 次）：\\n378:| low（poc-v108） | 70 | 112 | 81 |\\n    80\\t\\n    81\\t\\n    82\\tdef request_for(setting, state, questions):\\n    83\\t    \\\"\\\"\\\"The complete Jev request used both for dispatch and in-flight identity.\\\"\\\"\\\"\\n    84\\t    return {'model': setting.model, 'state': state, 'questions': questions}\\n    85\\t\\n    86\\t\\n    87\\tdef ask(archive, cfg, setting, state, questions, purpose, *, transport=None):\\n    88\\t    \\\"\\\"\\\"One Jev request, archived; returns model.Answer whose data is the `answers` map.\\\"\\\"\\\"\\n    89\\t    request = request_for(setting, state, questions)\\n    90\\t    request_json, sha = model.request_identity(request)\\n    91\\t    prompt_chars = len(request_json)\\n    92\\t    hit = archive.lookup(sha)\\n    93\\t    if hit:\\n    94\\t        call_id, answer_json, _, input_tokens, output_tokens = hit\\n    95\\t        return model.Answer(json.loads(answer_json), call_id, sha, True, prompt_chars, input_tokens or 0, output_tokens or 0, 0.0)\\n    96\\t    started = time.time()\\n    97\\t    response = (transport or globals()['transport'])(request)\\n    98\\t    seconds = round(time.time() - started, 2)\\n    99\\t    answers = response.get('answers') if isinstance(response, dict) else None\\n   100\\t    problems = validate(answers, questions)\\n   101\\t    usage = response.get('usage') or {} if isinstance(response, dict) else {}\\n   102\\t    input_tokens, output_tokens = int(usage.get('input_tokens') or 0), int(usage.get('output_tokens') or 0)\\n   103\\t    price_in, _ = model.PRICES.get(setting.model, (0.0, 0.0))\\n   104\\t    cost = round(input_tokens / 1e6 * price_in, 6)\\n   105\\t    call_id = archive.record(purpose=purpose, config_version=cfg.version, config_checksum=cfg.checksum, model=setting.model,\\n   106\\t                             request_sha256=sha if not problems else sha + ':schema:' + uuid.uuid4().hex[:8], request_json=request_json,\\n   107\\t                             response_json=json.dumps(response, ensure_ascii=False)[:200000], answer_json=json.dumps(answers, ensure_ascii=False) if answers is not None else None,\\n   108\\t                             prompt_chars=prompt_chars, input_tokens=input_tokens, output_tokens=output_tokens, cost_usd=cost,\\n   109\\t                             seconds=seconds, created_at=time.strftime('%Y-%m-%dT%H:%M:%S'))\\n   110\\t    if problems:\\n   111\\t        raise model.SchemaError('; '.join(problems[:5]))\\n   112\\t    return model.Answer(answers, call_id, sha, False, prompt_chars, input_tokens, output_tokens, cost)\\n   407\\t**The live-store contract's proofs are all built at $0 on test stores (D594 to D603):**\\n   408\\t\\n   409\\t- the resolver;\\n   410\\t- pinned reads, through one opener that names the store on failure;\\n   411\\t- visible-only search;\\n   412\\t- the writer's WAL store, stops, lock and end;\\n   413\\t- preflight's locked copy and the snapshot route;\\n   414\\t- serving while the built writer runs (proof 10);\\n   415\\t- the page's day reaching the Idea call (2f);\\n   416\\t- the crash, disk and busy proofs.\\n   417\\t\\n   418\\tThe suite passes (346), and so do the new system's folders (192). Nothing is deployed or restarted. P1 (the AGENTS §9 exception for\\n   419\\tthe product's own readers) stays only proposed, and the running service picks up the new behaviour only on a restart, which is\\n   420\\tAlex's.\\n   421\\t\\n   422\\t**This session's investigations, all at $0, closed with evidence (D604 to D612):**\\n   423\\t\\n   424\\t- line 5's fresh misses (D605);\\n   425\\t- the postponement repair, with D606's provisional reading reversed (D607);\\n   426\\t- the shared fiscal-year note (D608);\\n   427\\t- delivery of the company's own figures on the carried fortnight (D609, D610: 5 bearing statements undelivered on 3 questions, none\\n   428\\t  predicted to move an answer by a blind second reader);\\n   429\\t- a same-news comparison from established libraries (D611: underpowered, and no unread week left).\\n   430\\t\\n   431\\tThe council's reversible decisions on Alex's page are recorded in D606 and D607.\\n   432\\t\\n   433\\t**The merge test (D678–D680, 2026-11-19): closed; the registered test did not pass.** The old system opens questions, clean Step 1 reads\\n   434\\tand files under them, and the frozen judge answers. It ran on 70 articles × old-2 and old-3, with a hybrid arm and a control arm, for\\n   435\\t$2.13 ([result](research/2026-11-19-merge-council/RESULT.md)).\\n   436\\t- **Held:**\\n   437\\t  - delivery: the decisive statements reached the judge on 4/4 primary questions in both draws;\\n   438\\t  - talks stayed talks;\\n   439\\t  - both blind readers supported all 4 hybrid answers;\\n  3499\\t## D335 · 2026-10-30 · Each adopted thesis offers only its own two endpoints; two-rung cards show their own Yes/No\\n  3500\\t\\n  3501\\t- Alex's Idea returned `502: SchemaError: $.composite.v10.kind: 'driver' not in ['excluded']`; he asked for the root fix and then said \\\"改\\\". [Design and evidence](research/2026-10-30-idea-endpoint-choice/design.md).\\n  3502\\t- Mechanism: D290's array answer offered positions 1–5 to every thesis, while the binder re-checked each entry against that thesis's two endpoints (D282's per-thesis enum, kept in v5/v6). The model wrote a thesis's current-state position (its own account: \\\"I used v10's `judged.position` value of `2`\\\"). Census: 2 of 12 stored v7 answers refused, both this cause; all 35 in-range entries agree with their own reasons.\\n  3503\\t- `poc-v33-idea` / `idea-summary-v8` (prompt text identical to v7) sends one item shape per candidate, pinned to its ID and its two endpoint positions; the binder checks the answer against that same schema and then only uniqueness, non-empty text, the 100% total and the unclear-claim rule. v3–v7 keep their binders. `model.check_schema` now reports the closest `anyOf` option's errors.\\n  3504\\t- Second defect on the same path: the frontend scored two-rung theses Yes/No by position; 11 of 55 served two-rung theses list No first, so v14's \\\"Yes\\\" rendered as \\\"No\\\" in the white pill used for negative states. A Yes/No ladder now shows each rung's own label, Yes on the upper lane; the composite value is unchanged.\\n  3505\\t- Result: the ten valid stored v7 answers bind to identical plans; four Python mutants and one UI mutant fail their tests; the Idea (33) and UI (57) suites pass on the committed tree. The two refused requests re-sent under v8, three draws each: 6/6 valid, 29/29 entries on an endpoint agreeing with their reasons ($0.00578; two model-account probes $0.00105). Alex's Idea through the restarted service: 200, six adopted theses, 75% confidence.\\n  3506\\t\\n  3507\\t## D336 · 2026-10-30 · A yes/no ladder with named outcomes shows its outcome once\\n  3508\\t\\n  3509\\t- Alex, after the browser check showed v49's state as \\\"No No restriction adopted\\\": \\\"修，然后 merge main\\\".\\n  3510\\t- Mechanism: the state chip and the chart's spoken text join the score and the rung label. A two-rung ladder's score is Yes/No; when the ladder names its outcomes (06-views allows named outcomes for yes/no theme theses), the label repeats it. Census: 1 of 55 two-rung theses in the served ledger (v49: Restriction adopted / No restriction adopted) and 1 in the 2026-10-27 snapshot (Permission granted / Permission not granted).\\n  3511\\t- `stateWords` in `poc/ui/src/model/thesis.js` owns what a state shows: a two-rung ladder shows its own outcome once; five-rung ladders keep score and label. `badgeHtml` and `stateText` read it. Tone, lanes, the score table and the composite still use the Yes/No score.\\n  3512\\t- Result: the D336 UI test fails on the old composition (\\\"No No restriction adopted\\\"); 58 UI tests, lint, format and the 20 standing UI mutation checks pass. In headless Chrome, with the cache disabled, v49 shows \\\"No restriction adopted\\\" and v14 \\\"Yes\\\".\\n  3513\\t\\n  3514\\t## Decisions recorded in the `main` checkout on 2026-10-27 and never committed (numbered at the 2026-11-03 cleanup)\\n  3515\\t\\n   248\\t### 6. Running the new system live\\n   249\\t\\n   250\\t**Where it stands now (D594 to D603):** the design was resumed under D439, agreed, built and tested on test copies at no cost. Nothing\\n   251\\tis running live and nothing has been restarted.\\n   252\\t\\n   253\\t**What the tests show:**\\n   254\\t\\n   255\\t- While the new system writes a day, the website and the agent tools only ever show whole finished days.\\n   256\\t- On a brand-new database's first day, they say \\\"not ready yet\\\" instead of showing a half-done day (open defect 10 is fixed).\\n   257\\t- Only one writer can work on a database at a time.\\n   258\\t- A copy for checking is taken safely, and a crash or a full disk loses nothing that was already finished.\\n   259\\t\\n   260\\t**Example:** the test re-ran six months of one draw while asking the website for the library about 170 times. Every answer was a\\n   261\\twhole finished day, never part of one.\\n   262\\t\\n   263\\t**Three choices are yours:**\\n   264\\t\\n   265\\t1. **How live data is read.** Today's working rule never opens a running database directly, only a copy (AGENTS §9). The product's\\n   266\\t   own readers would need an exception (P1). This is proposed, not decided.\\n   267\\t2. **Restarting the running service.** It picks up the new behaviour only on a restart. Example: a date after the last finished day\\n   268\\t   would then be refused instead of answered from a half-done day.\\n   269\\t3. **When to adopt.** Adopting the new system at all still comes after the quality gates.\\n   270\\t\\n   271\\t**One small gap remains your choice:** if the page cannot reach the service, it quietly keeps the copy built into the page, as\\n   272\\tspecified. A \\\"collected snapshot\\\" note is a possible change.\\n   273\\t\\n   274\\t## What the council decided in the meantime, reversibly (D606, D607; each reversed on your word)\\n   275\\t\\n   276\\t- **The next product test** starts from a library built from real earlier material. Tests from empty stay as separate diagnostics.\\n   277\\t- **Your six lines** stay the gate, with their accounting unchanged.\\n   278\\t- **A company's formal decision that a dated event will not happen by its date** rules the event out. Example: \\\"NVIDIA will not ship\\n   279\\t  Vera Rubin in 2026\\\" answers \\\"will it ship by 2026-12-31?\\\" as ruled out. An authority's proceeding that goes on is still waiting.\\n   280\\t  This is the readers' majority view and my earlier lean; your ruling replaces it.\\n   281\\t- **The two product directions (D520, D571)** stay as the running product has them.\\n   282\\t- **Reading a live database directly (P1)** is not taken. The copy rule stays.\\n   283\\t\\n   284\\t## What is in force meanwhile\\n   285\\t\\nscripts/hivemind_api.py:96:    def _send(self, status, payload):\\n\",\"exit_code\":0,\"status\":\"completed\"}}\ndocs/research/2026-11-20-production-readiness/council-p-codex.stream:76:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_39\",\"type\":\"agent_message\",\"text\":\"**v118 is ready for historical replay. A daily production test still needs a news feed and a way to publish each finished day.** The clearest sign is that all three 82-day replays finished, while the page and agent tools still default to the August 28 library built by v34. [RUN-LOG.md:32](/Users/lchingen/hivemind/docs/research/2026-11-17-product-comparison/RUN-LOG.md:32) · [CURRENT_STATE.md:128](/Users/lchingen/hivemind/docs/CURRENT_STATE.md:128)\\n\\n### From article to analyst\\n\\n- **Supply and start.** The corpus tools gather news, filings and company releases from sources including Google News, SEC EDGAR and NVIDIA, then label and clean them into an items database. An operator starts `scripts/replay.py` with explicit dates. The daily loop and dispatch checks are built. A live feed and automatic daily start are missing, and human-review handling is deferred. [corpus-plan.md:9](/Users/lchingen/hivemind/docs/poc/corpus-plan.md:9) · [corpus README.md:6](/Users/lchingen/hivemind/poc/corpus/README.md:6) · [replay.py:51](/Users/lchingen/hivemind/scripts/replay.py:51) · [00-system.md:149](/Users/lchingen/hivemind/docs/prd/00-system.md:149)\\n- **Read, match, write, judge.** `extraction.py` uses the day’s starting library to propose questions and file quoted evidence, with Luna v74i at low reasoning. `views/jev_matching.py` uses Jev 1.14.0 to match questions and evidence, with Luna collision-v2 at low reasoning for close cases. `views/writing.py` writes SQLite records. At day end, `views/judging.py` uses Luna judging-v7 at medium reasoning to reassess changed questions. `pull.py` closes due questions at their current answer without another call. All are built. Earnings releases enter through the ordinary article path. [pipeline-plan.md:7](/Users/lchingen/hivemind/docs/poc/pipeline-plan.md:7) · [poc-v118.json:6](/Users/lchingen/hivemind/poc/config/poc-v118.json:6) · [jev.py:82](/Users/lchingen/hivemind/src/hivemind/jev.py:82)\\n- **Serve and explore.** The built page, HTTP API and MCP expose dated questions, evidence and answer history. Search can use `text-embedding-3-small` or lexical mode. HTTP `POST /ideas` calls `idea.py` for two Luna discovery calls with reasoning off, then one low-reasoning call to select and weight theses. The page keeps its embedded snapshot if the API is unavailable. [service.md:17](/Users/lchingen/hivemind/docs/poc/service.md:17) · [hivemind_api.py:186](/Users/lchingen/hivemind/scripts/hivemind_api.py:186) · [hivemind_mcp.py:92](/Users/lchingen/hivemind/scripts/hivemind_mcp.py:92) · [search.py:24](/Users/lchingen/hivemind/src/hivemind/search.py:24) · [poc-v118-idea.json:86](/Users/lchingen/hivemind/poc/config/poc-v118-idea.json:86) · [bootstrap.js:254](/Users/lchingen/hivemind/poc/ui/src/bootstrap.js:254)\\n\\n### Measured performance\\n\\n- **Frozen reference.** The inherited v74i prompt recorded 187 helpful and 81 unhelpful appearances across 50 articles sent three times. For unseeded v118, the July 1–14 diagnostic found one settled agreement out of seven graded questions in each of three draws, or two each if disputed matches count. Every eligible answer agreed. The full frozen judgement score requires preset questions. [Extraction results:352](/Users/lchingen/hivemind/docs/research/2026-11-01-e2e-loop/design-v78-fields.md:352) · [July census:21](/Users/lchingen/hivemind/clean-arch/e2e-comparison-2026-11-13/CENSUS-FULL-RESULT.md:21) · [score_judgement.py:38](/Users/lchingen/hivemind/docs/research/2026-11-01-e2e-loop/judgement-gold/score_judgement.py:38)\\n- **Release comparison.** v118 gave a supported answer to 10 of 32 matters in at least two of three draws, under both readings of disputed cases. The matters came from August 31–September 20. The comparison remained diagnostic after the sixth draw was stopped. [RUN-PLAN-v12.md:102](/Users/lchingen/hivemind/docs/research/2026-11-17-product-comparison/RUN-PLAN-v12.md:102) · [RUN-LOG.md:124](/Users/lchingen/hivemind/docs/research/2026-11-17-product-comparison/RUN-LOG.md:124)\\n- **Operations.** Each July 1–September 20 NVIDIA draw extracted 1,884 articles in about 2h45m. They opened 47, 43 and 49 questions. Archived tokens price to **$7.40, $6.72 and $6.85**, about **$0.08–$0.09 per replay day**. Judgement checks refused 1, 4 and 2 answers respectively. All recovered, with zero terminal failures. Live delivery latency, a second company and v118 beyond 82 days remain unverified in the records reviewed. [Run logs: draw 1](/Users/lchingen/hivemind/poc/data/comparison-2026-11-17/run/old-1/prod/replay.log:83) · [draw 2](/Users/lchingen/hivemind/poc/data/comparison-2026-11-17/run/old-2/prod/replay.log:83) · [draw 3](/Users/lchingen/hivemind/poc/data/comparison-2026-11-17/run/old-3/prod/replay.log:83) · [Token rates](/Users/lchingen/hivemind/src/hivemind/model.py:32)\\n\\n### Production-test blockers, ranked\\n\\n1. **Missing — daily supply and start.** Engineering must connect the feed and schedule. Alex chooses the sources, tester access and acceptable freshness. [00-system.md:18](/Users/lchingen/hivemind/docs/prd/00-system.md:18) · [replay.py:51](/Users/lchingen/hivemind/scripts/replay.py:51)\\n2. **Partial — publish finished days.** Snapshot tooling and readers exist. Engineering must wire the finished v118 ledger and its matching articles into all surfaces. Alex authorizes the pilot service. [snapshot_store.py:1](/Users/lchingen/hivemind/scripts/snapshot_store.py:1) · [README.md:103](/Users/lchingen/hivemind/README.md:103)\\n3. **Partial — spend and monitoring.** Research has pre-call guards and monitoring. The default cap can overshoot. Engineering must wire spend, stale-data and failed-day alerts into the pilot. Alex sets the ceiling. [README.md:170](/Users/lchingen/hivemind/README.md:170) · [RUN-PLAN-v12.md:309](/Users/lchingen/hivemind/docs/research/2026-11-17-product-comparison/RUN-PLAN-v12.md:309)\\n\\n**NOT READY — shortest path:** Wire those three pieces, then run one private seven-day NVIDIA pilot from a library built by v118. Verify that the page, API, MCP and an Idea show the same completed day, and that a failed run leaves the last good copy available and raises an alert. Historical usage implies about $0.60 for seven replay days. I propose a $5 model ceiling with room for growth and Idea calls. Feed and hosting costs are unpriced. [D690](/Users/lchingen/hivemind/docs/DECISIONS-log.md:10360)\"}}\ndocs/research/2026-11-20-production-readiness/council-p2-codex.stream:9:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_4\",\"type\":\"command_execution\",\"command\":\"/opt/homebrew/bin/zsh -lc \\\"nl -ba docs/research/2026-11-20-production-readiness/council-p-claude.md | head -130; rg -n 'D560|D606|D358|D424' docs/DECISIONS-log.md | rg '\\\"'^.*##'\\\"'; nl -ba README.md | sed -n '101,140p'; nl -ba poc/ui/src/bootstrap.js | sed -n '254,266p'\\\"\",\"aggregated_output\":\"     1\\t# Council P: Claude's position, written before reading Codex's\\n     2\\t\\n     3\\t## The system (poc-v118), end to end\\n     4\\t1. **Sources.** A batch harvest toolchain (`poc/corpus/README.md`; `poc/corpus/scripts/harvest_*.py`: Google News, GDELT, EDGAR,\\n     5\\t   official notices, company blogs) → `assemble.py` → `freeze_window.sh` → `clean_pages.py` (D351). It is run by hand per window;\\n     6\\t   there is no scheduler. The last harvested window is NVDA 07-01..10-27 (`items-nvda-2026-07-01-10-27.sqlite`).\\n     7\\t2. **Dispatch** (`dispatch.py`): each item validated, numbered and routed, in order.\\n     8\\t3. **Extraction** (`extraction.py`, `gpt-6-luna`, v74i, low effort; one call per article): reads the questions open at day start,\\n     9\\t   files quoted evidence under them, proposes new questions.\\n    10\\t4. **Matching and writing** (`views/jev_matching.py`, Jev 1.14 with the collision judge; `views/writing.py`): open, merge or skip a\\n    11\\t   candidate; repeat, replacement or new for evidence; append-only SQLite.\\n    12\\t5. **Judging** (`views/judging.py`, judging-v7): once a day, the questions whose evidence changed get a rung on their ladder, with\\n    13\\t   citations.\\n    14\\t6. **Pull mode** (`pull.py`): a question closes at its rung on its due day.\\n    15\\t7. **Driver** (`scripts/replay.py`): days in order over a frozen items database; it resumes after a store's last completed day\\n    16\\t   (`src/hivemind/replay.py:62`), so a store can be extended.\\n    17\\t8. **Serving:** HTTP API, MCP server, the page (Thesis Library, Explore Ideas) and the Idea call (`poc-v118-idea`, three calls). They\\n    18\\t   serve the sealed `served-2026-10-28-v34-nvda-3m-through-0828` ledger, built by the older `poc-v34` (README, \\\"Local requirements\\\";\\n    19\\t   DECISIONS §13). **No analyst has seen poc-v118's own output on the page.**\\n    20\\t\\n    21\\t## Performance (measured)\\n    22\\t- **Release comparison** (07-01..09-20, 82 days, about 1,884 articles, 3 draws; `2026-11-17-product-comparison/RUN-LOG.md:32-41`):\\n    23\\t  old serves 10 of 32 key matters (\\\"served\\\" = a covering question rated worth tracking and supported, plan v12 item 5); the new\\n    24\\t  system 2–3. Each old draw cost $8.60–$9.83 (about $0.11 a day) and took under three hours of wall clock for 82 days; no stop.\\n    25\\t- **Answer quality:** among worth-tracking questions in the 5 stored draws, 24 answers were rejected by both blind readers\\n    26\\t  (`2026-11-20-hybrid/census/CENSUS.md`): overlapping amounts added, a figure of another scope taken as the answer, unsupported\\n    27\\t  adjustments, talks taken as likely completion. About 16 of 24 step off a reference rung the judge itself named.\\n    28\\t- **Frozen ruler** (14 days, judgement at 07-14): poc-v116 53/57 against poc-v108 45/57, three draws (`CURRENT_STATE.md:134`).\\n    29\\t  poc-v118 itself cannot be scored by the seeded scorer (README, \\\"Run the pipeline\\\").\\n    30\\t- **Never measured:** a second company; live latency; a window past 09-20 for poc-v118; a human analyst's read of its output (the\\n    31\\t  pilot deck has waited on Alex since D560); evidence growth over months (open defect 7, D358 stopped the v34 run on bloat).\\n    32\\t\\n    33\\t## Readiness for a production test\\n    34\\t| Requirement | State | Evidence |\\n    35\\t|---|---|---|\\n    36\\t| New articles each day | Partly: tools exist, run by hand per window, no schedule; corpus ends 10-27 | `poc/corpus/README.md` |\\n    37\\t| The pipeline run each day on a continuing store | Partly: replay resumes a store; a daily wrapper and an items database that grows are not built | `src/hivemind/replay.py:62` |\\n    38\\t| Its store served to the page, API and MCP | Partly: one-edit swap documented; serving-while-writing proofs were built for the new system's writer (D594–D603), and a restart is Alex's | README \\\"Switching the served data\\\"; `OPERATING-CONTRACT.md` |\\n    39\\t| Cost cap and monitoring | Partly: `--cap` per run, not hard; cost is small (about $0.11/day for one company) | README \\\"Run the pipeline\\\" |\\n    40\\t| Quality accepted | No: not accepted end to end; 10 of 32 matters; no human read | `CURRENT_STATE.md:133` |\\n    41\\t| Hosting | Host only: Docker has no outbound model calls under the VPN | AGENTS §9 |\\n    42\\t\\n    43\\t**Verdict: NOT READY for a live production test today; READY for a shadow forward test now.** The pipeline is complete and stable\\n    44\\tover 82 days, cheap, and has never stopped; what is missing is (a) a daily feed and wrapper, engineering of a few days, and (b) any\\n    45\\thuman read of what it gives an analyst.\\n    46\\t\\n    47\\t**Recommendation and one test.** Run poc-v118 forward from one old draw's 09-20 store over the unseen 09-21..10-27 articles (already\\n    48\\tharvested; about $3 for one draw at old's rate, Alex's money since D439 has $0), serve that store locally on the page, and have Alex\\n    49\\tread it for half an hour: is this something an analyst would use? It tests the two things never tested (fresh articles after the\\n    50\\tdesign's window, and the product page showing poc-v118's output) and decides whether the daily-feed engineering is worth building.\\n3783:## D358 · 2026-10-28 (carried 2026-11-04) · The three-month run stops at 2026-08-28 and is sealed; evidence bloat is the next problem to solve\\n4698:## D424 · 2026-11-10 · The writer keeps giving a \\\"later version\\\" the older record's questions; the fix is closed without a change\\n7047:## D560 · 2026-11-15 · Reflection council (Alex's request): the goal, the measuring method and the way through; a pilot of Alex's own product-level review is prepared at $0; the role of the six lines is put to him (council consensus)\\n8060:## D606 · 2026-11-16 · Under D439 (council round 148): the items on Alex's page that D439 permits are decided reversibly; next, a $0 audit of the postponed-event class\\n8091:## D607 · 2026-11-16 · Under D439 (council round 149): D606's postponement reading is reversed provisionally; the postponement repair route closes; next, a $0 audit of the shared fiscal-year note\\n9293:## D662 · 2026-11-17 · Reflection council 9 (Alex's request): the work drifted from D560's agreed way out; hold the listed work and put Deck 1 to Alex first (council consensus)\\n   101\\t### Switching the served data\\n   102\\t\\n   103\\tThe page build, the two services and Compose each carry the same two defaults: the thesis ledger (`views.sqlite`) and the items database the ledger's input ids come from. Swap both together; a ledger whose items are missing shows evidence without titles or sources. Serve a copy of a ledger a run may still write (`snapshot.sh` in a run folder makes one with SQLite's backup API), never the file the run writes. The places that name the defaults, all changed in one edit:\\n   104\\t\\n   105\\t| Place | What to change |\\n   106\\t|---|---|\\n   107\\t| `scripts/mock_build.py` | `--ledger` and `--items` defaults, then `python3 scripts/mock_build.py` rebuilds `poc/mock/index.html` |\\n   108\\t| `scripts/hivemind_api.py` | `--views` and `--items` defaults |\\n   109\\t| `scripts/hivemind_mcp.py` | `--views` and `--items` defaults |\\n   110\\t| `docker-compose.yml` | the `/data/ledger` and `/data/items/items-window.sqlite` volumes of both services |\\n   111\\t| This README and `poc/ui/README.md` | the default paths named in the table above and in the build description |\\n   112\\t| `tests/test_ui_bundles.py` | `SERVED_VIEWS` and `SERVED_GROUPS`, the served library's thesis and group counts |\\n   113\\t\\n   114\\tThen restart the API in a new dated service folder (below) so the search index is built for the new ledger. The current default, `served-2026-10-28-v34-nvda-3m-through-0828`, is the three-month NVDA run (`poc-v34`, extraction v18) stopped and sealed at 2026-08-28 on evidence bloat (D358); its folder README names the one empty thesis removed.\\n   115\\t\\n   116\\t## Run the service for testing\\n   117\\t\\n   118\\tRun test services on the host. Start with read-only browsing and lexical search, which need no model or embedding calls. In the same shell where `repo` names the checkout, create a fresh dated run directory for the log, PID and derived files:\\n   119\\t\\n   120\\t```sh\\n   121\\tservice_run=$(mktemp -d \\\"$repo/poc/data/service-$(date +%F)-XXXXXX\\\")\\n   122\\tnohup python3 \\\"$repo/scripts/hivemind_api.py\\\" --port 8788 \\\\\\n   123\\t  --lexical --config '' \\\\\\n   124\\t  --index \\\"$service_run/search-index.sqlite\\\" \\\\\\n   125\\t  --archive \\\"$service_run/idea-archive.sqlite\\\" \\\\\\n   126\\t  > \\\"$service_run/api.log\\\" 2>&1 &\\n   127\\tprintf '%s\\\\n' \\\"$!\\\" > \\\"$service_run/api.pid\\\"\\n   128\\tcurl -fsS http://127.0.0.1:8788/days\\n   129\\t```\\n   130\\t\\n   131\\t`/days` returns the first and last completed ledger day. See the log if startup is not ready. To enable Idea submission and semantic search, stop this instance and start the same command without `--lexical --config ''`. That selects the default Idea configuration above and can call the embedding and language models. Exact archived requests can replay without another model call; changed requests can incur cost.\\n   132\\t\\n   133\\tThe app calls `http://127.0.0.1:8788`; its host may override this with `<body data-api=\\\"…\\\">`. `/library` returns the dated snapshot. `--views` and `--items` select other source databases; `--index`, `--archive` and `--config` select derived storage and configuration. Stop only the API instance you started:\\n   134\\t\\n   135\\t```sh\\n   136\\tkill \\\"$(cat \\\"$service_run/api.pid\\\")\\\"\\n   137\\t```\\n   138\\t\\n   139\\tFor an agent, `scripts/hivemind_mcp.py` defaults to stdio. Use `--transport streamable-http --host 127.0.0.1 --port 8789` to serve `/mcp`, and `--lexical` for model-free reads. The [service contract](docs/poc/service.md) lists the tools and historical-read rules.\\n   140\\t\\n   254\\t    async function loadLibrary() {\\n   255\\t      try {\\n   256\\t        const response = await fetch(`${API}/library`, { signal: libraryRequest.signal });\\n   257\\t        if (!response.ok) throw new Error(`Service returned ${response.status}`);\\n   258\\t        const next = fromBundles(await response.json());\\n   259\\t        if (next.coverage !== 'library')\\n   260\\t          throw new Error('The service did not return a complete library');\\n   261\\t        if (libraryRequest.signal.aborted) return;\\n   262\\t        library.setDataset(next, { day: next.as_of }); // the supplied snapshot defines the displayed date (thesis-ui.md)\\n   263\\t        data = next;\\n   264\\t      } catch {\\n   265\\t        // Keep the displayed snapshot when the optional live read is unavailable.\\n   266\\t      }\\n\",\"exit_code\":0,\"status\":\"completed\"}}\ndocs/research/2026-11-20-production-readiness/council-p2-codex.stream:11:{\"type\":\"item.started\",\"item\":{\"id\":\"item_6\",\"type\":\"command_execution\",\"command\":\"/opt/homebrew/bin/zsh -lc \\\"nl -ba docs/DECISIONS-log.md | sed -n '7047,7075p;9293,9322p'; nl -ba docs/research/2026-11-17-product-comparison/RUN-PLAN-v12.md | sed -n '79,105p'; rg -n '\\\"'^def library|''^def .*bundle|class'\\\"' src/hivemind/bundle.py | tail -22; nl -ba poc/data/comparison-2026-11-17/run/old-2/prod/replay.log | tail -4; rg -n '09-21|09-27|10-27' docs/research/2026-11-20-production-readiness docs/DECISIONS-log.md | tail -18 | cut -c1-300\\\"\",\"aggregated_output\":\"\",\"exit_code\":null,\"status\":\"in_progress\"}}\ndocs/research/2026-11-20-production-readiness/council-p2-codex.stream:12:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_6\",\"type\":\"command_execution\",\"command\":\"/opt/homebrew/bin/zsh -lc \\\"nl -ba docs/DECISIONS-log.md | sed -n '7047,7075p;9293,9322p'; nl -ba docs/research/2026-11-17-product-comparison/RUN-PLAN-v12.md | sed -n '79,105p'; rg -n '\\\"'^def library|''^def .*bundle|class'\\\"' src/hivemind/bundle.py | tail -22; nl -ba poc/data/comparison-2026-11-17/run/old-2/prod/replay.log | tail -4; rg -n '09-21|09-27|10-27' docs/research/2026-11-20-production-readiness docs/DECISIONS-log.md | tail -18 | cut -c1-300\\\"\",\"aggregated_output\":\"  7047\\t## D560 · 2026-11-15 · Reflection council (Alex's request): the goal, the measuring method and the way through; a pilot of Alex's own product-level review is prepared at $0; the role of the six lines is put to him (council consensus)\\n  7048\\t\\n  7049\\t- **Alex** (2026-11-15): \\\"我觉得你的council 需要认真的end to end read 我现在的system design, 以及过去所有的尝试，到底你要达到的目标是什么？是不是量测方法问题，\\n  7050\\t  我们已经stuck 很久了需要重新审视突破\\\".\\n  7051\\t- **Council** (`docs/research/2026-11-14-use-acceptance/reflection-4/`): my own reflection written first (`own-reflection.md`); five\\n  7052\\t  cold reads with no position given: the goal and the design (`codex-design.md`), every past attempt (`codex-history.md`,\\n  7053\\t  incomplete by its own account; `claude-history.md`, every index row from D229 to D559 and the round logs), the measuring\\n  7054\\t  method (`codex-measurement.md`, `claude-measurement.md`); two challenge rounds (`council-codex-2.md`: no; `council-codex-3.md`:\\n  7055\\t  \\\"CONSENSUS: yes\\\").\\n  7056\\t- **The agreed answers.**\\n  7057\\t  1. *The goal:* a continuing research library in which an analyst finds the important questions, the facts for and against,\\n  7058\\t     and a present answer whose reasons are visible (PRD 00, Purpose; `clean-arch/PRD.md` §1; PRD 10 §1). The record carries\\n  7059\\t     four goals at once (PRD 10 §1; \\\"beats the old system\\\", D427; the six lines for answer choices, D400; use on unseen\\n  7060\\t     news, D484, its lines proposed) and no single number for \\\"ready\\\".\\n  7061\\t  2. *The measuring method:* a major part of the impasse, beside demonstrated product defects; the present sticks cannot\\n  7062\\t     apportion the two. The first gate has substantial reader disagreement, nothing on record clears it, and no measured\\n  7063\\t     link to the final answer; the July end-to-end reference could not rank the systems at that size and under that\\n  7064\\t     matching rule; the conditions measured were not the product's.\\n  7065\\t  3. *Why stuck, and the way through:* too many local pass-or-fail decisions with no reliable link to what the analyst sees,\\n  7066\\t     while important facts and answerable questions still go missing. First a small, source-backed review of actual answers\\n  7067\\t     by Alex himself, as a pilot; then the real starting-library condition (D559's comparison); product work chosen from\\n  7068\\t     what those two show.\\n  7069\\t- **Verified first-hand for this record.**\\n  7070\\t  - The first gate's instrument: one reader family holds every firm mark on 47 of 111 answer-choice lists, the other on 84;\\n  7071\\t    of the 36 lists the old system wrote for other questions, two readers held every firm mark on 19 and on 25,\\n  7072\\t    unadjudicated (`clean-arch/step4-2026-11-10/stage_a/result/RESULT.md`); \\\"sound ladders given a failed mark: 3 of 7 | 0 of 7\\\"\\n  7073\\t    (`DESIGN.md`). A warning that nothing on record clears the whole gate, not a proof that nothing can. Seven readings, no\\n  7074\\t    pass.\\n  7075\\t  - D400's six lines were Claude's proposal (\\\"通过线我提议 …\\\"), accepted by Alex as the recommended option, with no chance\\n  9293\\t## D662 · 2026-11-17 · Reflection council 9 (Alex's request): the work drifted from D560's agreed way out; hold the listed work and put Deck 1 to Alex first (council consensus)\\n  9294\\t\\n  9295\\t- **Alex** (2026-11-17), sharing a critique (`docs/research/2026-11-14-use-acceptance/reflection-9/alex-critique-2026-11-17.md`, with Claude's check of\\n  9296\\t  its numbers): \\\"你看一下这个，我觉得你完全drift 了。你到底要怎么回归正轨来解决问题，深度的review traces然后跑council loop skill 直到你有确切的解决方案\\\".\\n  9297\\t- **Council** (`reflection-9/`):\\n  9298\\t  - Claude's own reflection, written first (`own-reflection.md`);\\n  9299\\t  - two cold readings made apart: a fresh Codex session with its memories off (`cold-codex-1.md`, thread 01a1ebfe-4f67-7c72-af87-7830055e0f09) and\\n  9300\\t    a Claude-family reviewer (`cold-claude-1.md`);\\n  9301\\t  - two challenge rounds (`codex-challenge-1.md`: disagree, with corrections; `codex-challenge-2.md`: \\\"CONSENSUS\\\").\\n  9302\\t- **Agreed reading:**\\n  9303\\t  - **No finish line.** The product goal has no finish line in numbers that Alex owns. Gate 3's \\\"beats\\\" has no number, gate 4's lines are\\n  9304\\t    proposed, gate 5 is unwritten, and D544's \\\"bound agreed later\\\" was never agreed.\\n  9305\\t  - **The work circled.** The next task kept being chosen from the nearest failed check, while D560 had found that the first gate has no measured\\n  9306\\t    link to the final answer. D623 had recorded that its zero-fault lines were a poor target on the luna-era readings.\\n  9307\\t  - **Engineering for later gates** ran while gate 1 failed (the live store D593–D603, the planner and integration), against \\\"nothing later in\\n  9308\\t    the plan … starts before it passes\\\" and D509's scope.\\n  9309\\t  - **The way out D560 agreed was dropped.** That way out was Alex's own half hour on Deck 1, then the comparison design, then the six lines'\\n  9310\\t    role. The deck was built on 11-15 and \\\"goes to him unchanged\\\" through D581, then vanished from the reports. Reflection 8 did not read D560.\\n  9311\\t    That is the fifth miss of the search-earlier-traces rule.\\n  9312\\t- **Corrected in this round:**\\n  9313\\t  - D656's share-control rule was written before the send, so its FAIL stands, beside the finding that the edit recovered 9 of 9 targets while\\n  9314\\t    the listing omission is in both arms.\\n  9315\\t  - D623's rates are luna-era, not astra's chance.\\n  9316\\t  - Four model switches were Alex's requests, and D544 stated its reasons.\\n  9317\\t  - The page fix for completed replays addressed a real defect.\\n  9318\\t- **Decided (consensus; D439's limits):**\\n  9319\\t  1. **Held while Alex's marks are pending,** with records kept:\\n  9320\\t     - answer-choice changes and D656's listing census;\\n  9321\\t     - model trials;\\n  9322\\t     - further live-store, planner and integration work.\\n    79\\t   - the archived runs in `docs/research/2026-10-25-english/data-manifest.md`.\\n    80\\t\\n    81\\t   Search goes inside binary files (`rg -a`, and SQL over every SQLite table for the ids). Its controls:\\n    82\\t   - a known hit: one of D613's 10 Step 1 reads in the week of 09-07;\\n    83\\t   - a known miss: one id written only into a scratch control file outside the searched roots.\\n    84\\t4. **Any read excludes the article, with one exception by actual use,** classified per folder and frozen before any hit is read:\\n    85\\t   - **The exception:** an old-system replay run folder and its byte copies, **only when** its decision record or run note shows it ran the\\n    86\\t     then-production configuration as the product (its library sealed or served as the product's), and no decision cites one of its articles as a\\n    87\\t     case behind a change.\\n    88\\t   - **Development replays are reads:** arms, probes, configuration trials and week tests.\\n    89\\t   - **Why:** a replay of the product as it ran tunes neither system. D665's own council used the sealed run as the old system's output.\\n    90\\t   - **Still a read:** any research artifact built from such a run (for example, the 2026-10-28 quality review).\\n    91\\t   - **Recorded:** the per-folder classification (`replay-folders.json`, with each folder's record) and the council decision on it, both before\\n    92\\t     the hits are read.\\n    93\\t5. **One input.**\\n    94\\t   - A filtered copy of the items database without the excluded articles is made once and hashed.\\n    95\\t   - **Code change A:** `run_fresh.py --items` hands it to both children (clean `--source`; production `--testdb`).\\n    96\\t   - **Code change B:** `fresh_week_inputs.py` takes the dates and the items path as arguments.\\n    97\\t   - **Proof through the real entry points:** both launchers run dry with fake answers over the whole span on the copy. Each records the\\n    98\\t     ordered ids it actually processes and their text sha. The two must be equal in order. Controls:\\n    99\\t     - an excluded article appears in neither;\\n   100\\t     - a kept article appears in both.\\n   101\\t\\n   102\\t### 1.3 Blind matter census (articles only; frozen before any send)\\n   103\\t\\n   104\\t1. **Sample (D668).** Every kept article in the scored window 2026-08-31 to 09-20, read in batches of about 40 per session. Each family merges across every batch and week before reconciling. The warm-up is 07-01 to 08-30, unfiltered: the exclusion filter applies to the scored window only. Read with week reading A1's\\n   105\\t   brief (`../2026-11-14-use-acceptance/week/brief-A1.md`), unchanged except for the file names.\\n100:def view_bundle(views_db, item_of, view_id, as_of=None):\\n183:def _bundles(views_db, items_db, view_ids, as_of=None, coverage='selection'):\\n219:def thesis_bundles(views_db, items_db, view_ids, as_of=None):\\n225:def library(views_db, items_db, as_of=None):\\n    82\\t2026-09-19 | items  34 extracted  29 merged  5 skipped  0 failed  0 | evidence  58 new views  1 judged  37 changed  18 closed 0 | open views 42 | day $0.12 total $6.60 calls 8630\\n    83\\t2026-09-20 | items  34 extracted  28 merged  6 skipped  0 failed  0 | evidence  39 new views  1 judged  36 changed  20 closed 1 | open views 42 | day $0.12 total $6.72 calls 8737\\n    84\\ttotals: {'items': 2077, 'extracted': 1884, 'skipped': 0, 'merged': 193, 'not_processed': 0, 'returned': 0, 'failed': 0, 'evidence': 5120, 'new_views': 43, 'judged': 1616, 'changed': 882, 'closed': 1}\\n    85\\tledger: {'ceiling': 25.0, 'spent': 8.59927935400001, 'reserved': 5.100087019371813e-16, 'overrun': False, 'refused': 0, 'attempts': 8737, 'stopped': False, 'stop_reason': None, 'launchers': {'old-2': '/Users/lchingen/hivemind/poc/data/comparison-2026-11-17/run/old-2/launch.lock'}}\\ndocs/research/2026-11-20-production-readiness/council-p-claude.md:47:**Recommendation and one test.** Run poc-v118 forward from one old draw's 09-20 store over the unseen 09-21..10-27 articles (already\\ndocs/research/2026-11-20-production-readiness/council-p-round2-brief.md:25:   copy) with its alerts. Its first week runs forward from that 09-20 store over the already harvested 09-21..09-27, as a dress\\ndocs/research/2026-11-20-production-readiness/council-p-round2-brief.md:31:- (b) Is the rehearsal week on harvested articles a sound first pilot, given that the corpus stops at 10-27 and the feed is unbuilt?\\ndocs/research/2026-11-20-production-readiness/council-p2-codex.stream:9:{\\\"type\\\":\\\"item.completed\\\",\\\"item\\\":{\\\"id\\\":\\\"item_4\\\",\\\"type\\\":\\\"command_execution\\\",\\\"command\\\":\\\"/opt/homebrew/bin/zsh -lc \\\\\\\"nl -ba docs/research/2026-11-20-production-readiness/council-p-claude.md | head -130; rg -n 'D560|D606|D358|D424' d\\ndocs/research/2026-11-20-production-readiness/council-p2-codex.stream:10:{\\\"type\\\":\\\"item.completed\\\",\\\"item\\\":{\\\"id\\\":\\\"item_5\\\",\\\"type\\\":\\\"command_execution\\\",\\\"command\\\":\\\"/opt/homebrew/bin/zsh -lc \\\\\\\"nl -ba clean-arch/e2e-comparison-2026-11-13/budget_replay.py | sed -n '177,219p;240,310p'; nl -ba scripts/hivemind\\ndocs/research/2026-11-20-production-readiness/council-p-codex.stream:12:{\\\"type\\\":\\\"item.completed\\\",\\\"item\\\":{\\\"id\\\":\\\"item_6\\\",\\\"type\\\":\\\"command_execution\\\",\\\"command\\\":\\\"/opt/homebrew/bin/zsh -lc \\\\\\\"rg -n '\\\\\\\"'^(#|.*D(563|66[5-9]|67[0-9]|68[0-9]|690))|refusal|production'\\\\\\\"' docs/CURRENT_STATE.md; nl -ba README.md;\\ndocs/research/2026-11-20-production-readiness/council-p-codex.stream:18:{\\\"type\\\":\\\"item.completed\\\",\\\"item\\\":{\\\"id\\\":\\\"item_9\\\",\\\"type\\\":\\\"command_execution\\\",\\\"command\\\":\\\"/opt/homebrew/bin/zsh -lc \\\\\\\"nl -ba docs/r