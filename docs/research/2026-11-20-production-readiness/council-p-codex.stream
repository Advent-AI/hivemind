{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba poc/config/poc-v118.json; nl -ba poc/config/poc-v118-idea.json; rg -n 'def |DEFAULT_|daily|cap|stopp|failed|refus|resume' scripts/replay.py src/hivemind/{replay,dispatch,pull,parallel_day}.py | rg 'def |DEFAULT_|reserve|resume|cap|completed' \"","aggregated_output":"     1\t{\n     2\t  \"version\": \"poc-v118\",\n     3\t  \"_note\": \"Field-free configuration derived from poc-v117.json; all active model and prompt settings remain unchanged.\",\n     4\t  \"provider\": \"openai\",\n     5\t  \"search_top_n\": 10,\n     6\t  \"extraction\": {\n     7\t    \"T1\": {\n     8\t      \"model\": \"gpt-6-luna\",\n     9\t      \"prompt_version\": \"T1-v74i\",\n    10\t      \"reasoning_effort\": \"low\",\n    11\t      \"max_output_tokens\": 16000\n    12\t    },\n    13\t    \"T2\": {\n    14\t      \"model\": \"gpt-6-luna\",\n    15\t      \"prompt_version\": \"T2-v74i\",\n    16\t      \"reasoning_effort\": \"low\",\n    17\t      \"max_output_tokens\": 16000\n    18\t    },\n    19\t    \"T3\": {\n    20\t      \"model\": \"gpt-6-luna\",\n    21\t      \"prompt_version\": \"T3-v74i\",\n    22\t      \"reasoning_effort\": \"low\",\n    23\t      \"max_output_tokens\": 12000\n    24\t    },\n    25\t    \"T4\": {\n    26\t      \"model\": \"gpt-6-luna\",\n    27\t      \"prompt_version\": \"T4-v74i\",\n    28\t      \"reasoning_effort\": \"low\",\n    29\t      \"max_output_tokens\": 16000\n    30\t    },\n    31\t    \"T5\": {\n    32\t      \"model\": \"gpt-6-luna\",\n    33\t      \"prompt_version\": \"T5-v74i\",\n    34\t      \"reasoning_effort\": \"low\",\n    35\t      \"max_output_tokens\": 12000\n    36\t    },\n    37\t    \"T6\": {\n    38\t      \"model\": \"gpt-6-luna\",\n    39\t      \"prompt_version\": \"T6-v74i\",\n    40\t      \"reasoning_effort\": \"low\",\n    41\t      \"max_output_tokens\": 12000\n    42\t    },\n    43\t    \"T7\": {\n    44\t      \"model\": \"gpt-6-luna\",\n    45\t      \"prompt_version\": \"T7-v74i\",\n    46\t      \"reasoning_effort\": \"low\",\n    47\t      \"max_output_tokens\": 8000\n    48\t    },\n    49\t    \"T8\": {\n    50\t      \"model\": \"gpt-6-luna\",\n    51\t      \"prompt_version\": \"T8-v74i\",\n    52\t      \"reasoning_effort\": \"low\",\n    53\t      \"max_output_tokens\": 8000\n    54\t    },\n    55\t    \"T10\": {\n    56\t      \"model\": \"gpt-6-luna\",\n    57\t      \"prompt_version\": \"T10-v74i\",\n    58\t      \"reasoning_effort\": \"low\",\n    59\t      \"max_output_tokens\": 12000\n    60\t    },\n    61\t    \"T11\": {\n    62\t      \"model\": \"gpt-6-luna\",\n    63\t      \"prompt_version\": \"T11-v74i\",\n    64\t      \"reasoning_effort\": \"low\",\n    65\t      \"max_output_tokens\": 12000\n    66\t    }\n    67\t  },\n    68\t  \"matching\": {\n    69\t    \"model\": \"jev-1.14.0\",\n    70\t    \"prompt_version\": \"matching-v3\",\n    71\t    \"reasoning_effort\": \"medium\",\n    72\t    \"max_output_tokens\": 12000,\n    73\t    \"engine\": \"jev\"\n    74\t  },\n    75\t  \"rejudging\": {\n    76\t    \"model\": \"gpt-6-luna\",\n    77\t    \"prompt_version\": \"judging-v7\",\n    78\t    \"reasoning_effort\": \"medium\",\n    79\t    \"max_output_tokens\": 16000\n    80\t  },\n    81\t  \"final_verdict\": {\n    82\t    \"model\": \"gpt-6-luna\",\n    83\t    \"prompt_version\": \"verdict-v0\",\n    84\t    \"reasoning_effort\": \"medium\",\n    85\t    \"max_output_tokens\": 8000\n    86\t  },\n    87\t  \"idea\": {\n    88\t    \"model\": \"gpt-6-luna\",\n    89\t    \"prompt_version\": \"idea-v11\",\n    90\t    \"reasoning_effort\": \"none\",\n    91\t    \"max_output_tokens\": 4000\n    92\t  },\n    93\t  \"collision\": {\n    94\t    \"model\": \"gpt-6-luna\",\n    95\t    \"prompt_version\": \"collision-v2\",\n    96\t    \"reasoning_effort\": \"low\",\n    97\t    \"max_output_tokens\": 4000\n    98\t  }\n    99\t}\n     1\t{\n     2\t  \"version\": \"poc-v118-idea\",\n     3\t  \"_note\": \"Field-free configuration derived from poc-v33-idea.json; all active model and prompt settings remain unchanged.\",\n     4\t  \"provider\": \"openai\",\n     5\t  \"search_top_n\": 10,\n     6\t  \"extraction\": {\n     7\t    \"T1\": {\n     8\t      \"model\": \"gpt-6-luna\",\n     9\t      \"prompt_version\": \"T1-v2\",\n    10\t      \"reasoning_effort\": \"low\",\n    11\t      \"max_output_tokens\": 16000\n    12\t    },\n    13\t    \"T2\": {\n    14\t      \"model\": \"gpt-6-luna\",\n    15\t      \"prompt_version\": \"T2-v2\",\n    16\t      \"reasoning_effort\": \"low\",\n    17\t      \"max_output_tokens\": 16000\n    18\t    },\n    19\t    \"T3\": {\n    20\t      \"model\": \"gpt-6-luna\",\n    21\t      \"prompt_version\": \"T3-v2\",\n    22\t      \"reasoning_effort\": \"low\",\n    23\t      \"max_output_tokens\": 12000\n    24\t    },\n    25\t    \"T4\": {\n    26\t      \"model\": \"gpt-6-luna\",\n    27\t      \"prompt_version\": \"T4-v2\",\n    28\t      \"reasoning_effort\": \"low\",\n    29\t      \"max_output_tokens\": 16000\n    30\t    },\n    31\t    \"T5\": {\n    32\t      \"model\": \"gpt-6-luna\",\n    33\t      \"prompt_version\": \"T5-v2\",\n    34\t      \"reasoning_effort\": \"low\",\n    35\t      \"max_output_tokens\": 12000\n    36\t    },\n    37\t    \"T6\": {\n    38\t      \"model\": \"gpt-6-luna\",\n    39\t      \"prompt_version\": \"T6-v2\",\n    40\t      \"reasoning_effort\": \"low\",\n    41\t      \"max_output_tokens\": 12000\n    42\t    },\n    43\t    \"T7\": {\n    44\t      \"model\": \"gpt-6-luna\",\n    45\t      \"prompt_version\": \"T7-v2\",\n    46\t      \"reasoning_effort\": \"low\",\n    47\t      \"max_output_tokens\": 8000\n    48\t    },\n    49\t    \"T8\": {\n    50\t      \"model\": \"gpt-6-luna\",\n    51\t      \"prompt_version\": \"T8-v2\",\n    52\t      \"reasoning_effort\": \"low\",\n    53\t      \"max_ou