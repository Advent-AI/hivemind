: check the text, refuse a run that differs\n44:    mapping = {**seeds, **mapping}\n1:\"\"\"Score each ledger's evidence decisions (repeat / replace / new, and the target) against the evidence gold, which names\n5:Usage: python3 scripts/score_evidence_gold.py --gold poc/eval/gold/evidence-decisions-seed-2026-10-25.json \\\n13:def ro(path):\n19:def decisions(conn):\n36:def main():\n38:    ap.add_argument('--gold', required=True)\n39:    ap.add_argument('--ledger', action='append', required=True, help='label=path, repeatable')\n41:    gold = json.loads((ROOT / args.gold).read_text())['decisions']\n42:    judged = {k: v for k, v in gold.items() if not v.get('uncertain')}\n43:    print(f\"gold: {len(gold)} decisions, {len(judged)} judged, {len(gold) - len(judged)} uncertain; by class \"\n44:          f\"{dict(collections.Counter(v['gold'] for v in judged.values()))}\")\n56:            per_class[g['gold']][1] += 1\n57:            if outcome != g['gold'] and outcome not in g.get('options', []):      # options: other states the gold also accepts\n59:                errors.append(f\"- {key}: gold {g['gold']} → {label} {outcome} ({text[:70]})\")\n65:                per_class[g['gold']][0] += 1\n74:if __name__ == '__main__':\n75:    main()\n","exit_code":0,"status":"completed"}}
