{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba docs/research/2026-11-20-production-readiness/dependency-design/july_test.py | sed -n '35,245p'\"","aggregated_output":"    35\tCEILING = 0.15\n    36\tINTENDED = ('v9', 'v14')                       # Data Center FY2027 reads total revenue FY2027\n    37\t\n    38\t\n    39\tclass Stop(RuntimeError):\n    40\t    \"\"\"The harness stopped a sequence (an unapproved request, an out-of-pair link); the sequence is final.\"\"\"\n    41\t\n    42\t\n    43\tdef judged_view(request):\n    44\t    \"\"\"The thesis a judge request is about (its user text begins \"Thesis <id> (\"), or None for any other request.\"\"\"\n    45\t    if 'messages' not in request:\n    46\t        return None\n    47\t    text = request['messages'][-1]['content']\n    48\t    return text.split(' ', 2)[1] if text.startswith('Thesis v') else None\n    49\t\n    50\t\n    51\tdef is_link_request(request):\n    52\t    questions = request.get('questions') or {}\n    53\t    return bool(questions) and all(qid.startswith(('reads__', 'sign__')) for qid in questions)\n    54\t\n    55\t\n    56\tclass Latch:\n    57\t    \"\"\"One per sequence: the first refusal closes it, and every later request of the sequence, in any thread, is refused before the\n    58\t    inner transport (an attempt already inside it finishes and settles).\"\"\"\n    59\t\n    60\t    def __init__(self):\n    61\t        import threading\n    62\t        self.lock, self.reason = threading.Lock(), ''\n    63\t\n    64\t    def check(self):\n    65\t        with self.lock:\n    66\t            if self.reason:\n    67\t                raise Stop(f'the sequence is stopped ({self.reason}): not sent')\n    68\t\n    69\t    def close(self, reason):\n    70\t        with self.lock:\n    71\t            self.reason = self.reason or reason\n    72\t        raise Stop(reason)\n    73\t\n    74\t\n    75\tclass JudgingScope:\n    76\t    \"\"\"The day's judging: only a v9 or v14 judge request may reach the inner transport.\"\"\"\n    77\t\n    78\t    def __init__(self, inner, latch):\n    79\t        self.inner, self.latch, self.sent = inner, latch, []\n    80\t\n    81\t    def __call__(self, *args):\n    82\t        self.latch.check()\n    83\t        request = args[-1]\n    84\t        view_id = judged_view(request) if len(args) == 2 else None\n    85\t        if view_id not in TARGETS:\n    86\t            self.latch.close(f'unapproved request in judging (thesis {view_id}): not sent')\n    87\t        self.sent.append(view_id)\n    88\t        return self.inner(*args)\n    89\t\n    90\t\n    91\tclass ItemScope:\n    92\t    \"\"\"One item's transport: only link questions, only at seq 148, only in the linked arm.\"\"\"\n    93\t\n    94\t    def __init__(self, inner, seq, linked, sent, latch, link_seq=LINK_SEQ):\n    95\t        self.inner, self.seq, self.linked, self.sent, self.latch, self.link_seq = inner, seq, linked, sent, latch, link_seq\n    96\t\n    97\t    def __call__(self, *args):\n    98\t        self.latch.check()\n    99\t        request = args[-1]\n   100\t        if not (len(args) == 1 and is_link_request(request) and self.linked and self.seq == self.link_seq):\n   101\t            self.latch.close(f'unapproved request at seq {self.seq} ({\"link questions\" if len(args) == 1 and is_link_request(request) else \"not a link question\"}): not sent')\n   102\t        self.sent.append(('jev', self.seq, sorted(request['questions'])))\n   103\t        return self.inner(*args)\n   104\t\n   105\t\n   106\tclass SerialRunner:\n   107\t    \"\"\"replay.run's day runner: each routed item through round.run with a transport bound to its own sequence; after seq 148 commits,\n   108\t    the committed links are inspected before anything else runs.\"\"\"\n   109\t\n   110\t    def __init__(self, inner, linked, latch, link_seq=LINK_SEQ):\n   111\t        self.inner, self.linked, self.latch, self.link_seq, self.sent, self.links = inner, linked, latch, link_seq, [], []\n   112\t\n   113\t    def __call__(self, conn, archive, cfg, uni, items, *, day, transport=None, log=print):\n   114\t        for item, route in items:\n   115\t            result = rounds.run(conn, archive, cfg, uni, item, route.sequence_no, resume_from=route.resume_from,\n   116\t                                transport=ItemScope(self.inner, route.sequence_no, self.linked, self.sent, self.latch, self.link_seq), log=log)\n   117\t            if not result.failed and route.sequence_no == LINK_SEQ:\n   118\t                self.links = [tuple(r) for r in conn.execute(\"select view_id, depends_on, direction, seq from dependencies where kind=?\", (links.KIND,))]\n   119\t                outside = [r for r in self.links if r[0] not in TARGETS]\n   120\t                if outside:\n   121\t                    self.latch.close(f'out-of-pair link committed at seq {LINK_SEQ}: {outside}: the sequence is not comparable')\n   122\t            yield result\n   123\t\n   124\t\n   125\tdef retire_targets(archive_path, also=()):\n   126\t    archive = model.Archive(str(archive_path))\n   127\t    rows = archive.conn.execute(\"select call_id, request_json from model_calls where purpose='judge'\").fetchall()\n   128\t    retired = 0\n   129\t    for call_id, request_json in rows:\n   130\t        if judged_view(json.loads(request_json)) in TARGETS + tuple(also):\n   131\t            archive.retire(call_id)\n   132\t            retired += 1\n   133\t    top = archive.conn.execute('select coalesce(max(call_id), 0) from model_calls').fetchone()[0]\n   134\t    return archive, retired, top\n   135\t\n   136\t\n   137\tdef prepare(folder, prefix_ledger, also_retire=()):\n   138\t    if folder.exists():\n   139\t        raise SystemExit(f'{folder} exists: a sequence starts from an empty folder and is never resumed')\n   140\t    folder.mkdir(parents=True)\n   141\t    views, archive_path = folder / 'views.sqlite', folder / 'archive.sqlite'\n   142\t    shutil.copyfile(prefix_ledger, views)\n   143\t    conn = sqlite3.connect(views)\n   144\t    last, last_day = conn.execute('select seq, day from days_completed order by seq desc limit 1').fetchone()\n   145\t    unfinished = conn.execute('select count(*) from processing_steps where sequence_no > ?', (last,)).fetchone()[0]\n   146\t    if last != PREFIX_SEQ or last_day != '2026-07-09' or unfinished:\n   147\t        raise SystemExit(f'the prefix ledger is not the finished end of 07-09 (last completed {last_day} seq {last}, {unfinished} later steps)')\n   148\t    sys.path.insert(0, str(Path(__file__).parent))\n   149\t    import rebuild_control\n   150\t    if not rebuild_control.compare(views, PREFIX_SEQ):           # the copy equals old-2's finished store up to seq 147, as proved\n   151\t        raise SystemExit('the prefix ledger differs from old-2 up to seq 147: refused')\n   152\t    conn.execute('create table harness_only (name text, day text)')\n   153\t    conn.execute(\"insert into harness_only values ('july_test.py', '2026-11-21')\")\n   154\t    conn.commit()\n   155\t    conn.close()\n   156\t    shutil.copyfile(OLD2 / 'archive.sqlite', archive_path)\n   157\t    archive, retired, top = retire_targets(archive_path, also_retire)\n   158\t    return views, archive, retired, top\n   159\t\n   160\t\n   161\tdef run_sequence(scratch, name, prefix_ledger, cfg_path, linked, inner, log, *, link_seq=LINK_SEQ, also_retire=()):\n   162\t    folder = scratch / name\n   163\t    summary = {'name': name, 'config': None, 'linked': linked, 'started': True, 'stopped': '', 'comparable': False}\n   164\t    views = archive_path = None\n   165\t    try:\n   166\t        views, archive, retired, top = prepare(folder, prefix_ledger, also_retire)\n   167\t        archive_path = folder / 'archive.sqlite'\n   168\t        cfg, uni = config.load(str(cfg_path)), universe.load(str(UNIVERSE))\n   169\t        latch = Latch()\n   170\t        judging_scope, runner = JudgingScope(inner, latch), SerialRunner(inner, linked, latch, link_seq)\n   171\t        summary.update(config=cfg.version, retired_target_rows=retired, archive_top=top)\n   172\t        held = live_lock.acquire(str(views))\n   173\t        try:\n   174\t            replay.run(testdb_path=str(ITEMS), views_path=str(views), archive=archive, cfg=cfg, universe=uni, from_day=WINDOW[0],\n   175\t                       until_day=WINDOW[1], transport=judging_scope, day_runner=runner, only_objects={'NVDA'}, log=log)\n   176\t        except Exception as error:\n   177\t            summary['stopped'] = f'{type(error).__name__}: {error}'[:400]\n   178\t        finally:\n   179\t            live_lock.release(held)\n   180\t        conn = sqlite3.connect(f'file:{views}?mode=ro', uri=True)\n   181\t        judgements = [dict(zip(('view_id', 'day', 'call_id', 'rung', 'changed', 'reference', 'implied_outcome', 'reasons'), r)) for r in conn.execute(\n   182\t            'select view_id, publication_day, call_id, rung, changed, reference, implied_outcome, reasons from judgements where seq > ? and view_id in (?, ?) order by judgement_id',\n   183\t            (PREFIX_SEQ, *TARGETS))]\n   184\t        calls = [j['call_id'] for j in judgements]\n   185\t        fresh = bool(judgements) and all(c > top for c in calls) and len(set(calls)) == len(calls)\n   186\t        intended = (not linked) or any(r[:2] == INTENDED for r in runner.links)\n   187\t        summary.update(links=runner.links, judge_requests_sent=judging_scope.sent, link_requests_sent=runner.sent, judgements=judgements,\n   188\t                       all_target_judgements_fresh=fresh, intended_link=intended, latch=latch.reason,\n   189\t                       handovers_after_link_seq=conn.execute(\"select count(*) from processing_steps where sequence_no > ? and step='handed_over'\", (LINK_SEQ,)).fetchone()[0],\n   190\t                       selection=[tuple(r) for r in conn.execute('select attempt_id, status, record_json from link_selections order by id')])\n   191\t        summary['comparable'] = not summary['stopped'] and fresh\n   192\t    except BaseException as error:\n   193\t        summary['stopped'] = summary['stopped'] or f'{type(error).__name__}: {error}'[:400]\n   194\t        raise\n   195\t    finally:\n   196\t        folder.mkdir(parents=True, exist_ok=True)\n   197\t        (folder / 'summary.json').write_text(json.dumps(summary, indent=1, ensure_ascii=False))\n   198\t    return summary, views, archive_path\n   199\t\n   200\t\n   201\t# ---------- fakes for the $0 runs ----------\n   202\t\n   203\tdef marker(kind, label, view_id, n):\n   204\t    return f'{kind}|{label}|{view_id}|{n}'\n   205\t\n   206\t\n   207\tdef fake_judge(label, changed_on):\n   208\t    \"\"\"A judge answering every v9/v14 request with markers unique to the sequence, the question and the attempt; `changed_on` maps\n   209\t    (view, n) to the changed flag of that view's n-th judgement in the sequence; a first judgement always says changed.\"\"\"\n   210\t    calls = {}\n   211\t\n   212\t    def answer(provider, request):\n   213\t        text = request['messages'][-1]['content']\n   214\t        view_id = judged_view(request)\n   215\t        calls[view_id] = n = calls.get(view_id, 0) + 1\n   216\t        changed = True if '[Previous conclusion] none' in text else changed_on.get((view_id, n), True)\n   217\t        data = {'rung': 3, 'reference': marker('P', label, view_id, n), 'implied_outcome': marker('F', label, view_id, n),\n   218\t                'reasons': marker('M', label, view_id, n), 'cites': [], 'cites_views': [], 'pushes': [], 'changed': changed,\n   219\t                'why_changed': '', 'theme_pushes': []}\n   220\t        return {'choices': [{'message': {'content': json.dumps(data)}}], 'usage': {'prompt_tokens': 100, 'completion_tokens': 10}}\n   221\t    return answer\n   222\t\n   223\t\n   224\tdef fake_jev(readers):\n   225\t    \"\"\"Link questions: `readers` are the theses answered \"the THESIS reads the CANDIDATE\" (sign together); every other pair neither.\"\"\"\n   226\t    def answer(request):\n   227\t        answers = {}\n   228\t        for qid, question in request['questions'].items():\n   229\t            view_id = qid.split('__', 1)[1]\n   230\t            chosen = (links.THESIS_READS if view_id in readers else links.NEITHER) if qid.startswith('reads__') else links.TOGETHER\n   231\t            others = [k for k in question['criteria'] if k != chosen]\n   232\t            probabilities = {k: round(0.2 / len(others), 4) for k in others}\n   233\t            probabilities[chosen] = round(1 - sum(probabilities.values()), 4)\n   234\t            answers[qid] = {'type': 'choice', 'choice': chosen, 'confidence': probabilities[chosen], 'probabilities': probabilities}\n   235\t        return {'model': request['model'], 'answers': answers, 'usage': {'input_tokens': 100, 'output_tokens': 10}}\n   236\t    return answer\n   237\t\n   238\t\n   239\tdef dispatcher(judge, jev_answer, counter):\n   240\t    def transport(*args):\n   241\t        counter.append(len(args))\n   242\t        return jev_answer(args[0]) if len(args) == 1 else judge(*args)\n   243\t    return transport\n   244\t\n   245\t\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba docs/research/2026-11-20-production-readiness/dependency-design/july_test.py | sed -n '245,468p'\"","aggregated_output":"   245\t\n   246\tdef calls_of(archive_path, top):\n   247\t    \"\"\"The target judge calls a sequence made, in order: {view: [(user text, answer data)]}.\"\"\"\n   248\t    archive = sqlite3.connect(f'file:{archive_path}?mode=ro', uri=True)\n   249\t    out = {}\n   250\t    for request_json, answer_json in archive.execute(\"select request_json, answer_json from model_calls where purpose='judge' and call_id > ? order by call_id\", (top,)):\n   251\t        request = json.loads(request_json)\n   252\t        out.setdefault(judged_view(request), []).append((request['messages'][-1]['content'], json.loads(answer_json)))\n   253\t    return out\n   254\t\n   255\t\n   256\tdef previous_reasons(text):\n   257\t    if '[Previous conclusion] none' in text:\n   258\t        return None\n   259\t    return text.split('[Previous conclusion, for comparison only] rung ', 1)[1].split('; reasons: ', 1)[1].split('\\n', 1)[0]\n   260\t\n   261\t\n   262\tdef chain_checks(summary, archive_path, prefix_ledger, label):\n   263\t    \"\"\"Each target request carries exactly the previous accepted answer of its own question in this sequence (the first: the prefix's);\n   264\t    in the linked arm each v9 request shows exactly that day's accepted v14 comparison point and forecast.\"\"\"\n   265\t    calls = calls_of(archive_path, summary['archive_top'])\n   266\t    prefix = sqlite3.connect(f'file:{prefix_ledger}?mode=ro', uri=True)\n   267\t    stored_v9 = prefix.execute(\"select reasons from judgements where view_id='v9' order by judgement_id desc limit 1\").fetchone()[0]\n   268\t    checks = {}\n   269\t    for view_id in TARGETS:\n   270\t        rows = calls.get(view_id, [])\n   271\t        expected = [None if view_id == 'v14' else stored_v9[:800]] + [answer['reasons'] for _, answer in rows[:-1]]\n   272\t        checks[f'{view_id}: each request carries exactly its previous accepted answer'] = bool(rows) and \\\n   273\t            [previous_reasons(text) for text, _ in rows] == expected\n   274\t    if summary['linked']:\n   275\t        v9_days = [j['day'] for j in summary['judgements'] if j['view_id'] == 'v9']\n   276\t        v14 = {j['day']: (j['reference'], j['implied_outcome']) for j in summary['judgements'] if j['view_id'] == 'v14'}\n   277\t        checks['v9: each request shows that day\\'s accepted v14 comparison point and forecast'] = bool(v9_days) and all(\n   278\t            f'Comparison point stated by that judgement: {v14[day][0]}' in text and f'(our own judgement, not evidence): {v14[day][1]}' in text\n   279\t            for (text, _), day in zip(calls.get('v9', []), v9_days))\n   280\t    return checks\n   281\t\n   282\t\n   283\tdef dry(scratch, prefix_ledger):\n   284\t    scratch.mkdir(parents=True, exist_ok=True)\n   285\t    checks, log = {}, (lambda *a: None)\n   286\t    plans = {'control-A': (V118, False, {}), 'control-B': (V118, False, {}),\n   287\t             'linked-A': (V119, True, {('v14', 2): True}), 'linked-B': (V119, True, {('v14', 2): False})}\n   288\t    for name, (cfg_path, linked, changed_on) in plans.items():\n   289\t        summary, _, archive_path = run_sequence(scratch, name, prefix_ledger, cfg_path, linked,\n   290\t                                                dispatcher(fake_judge(name, changed_on), fake_jev({'v9'}), []), log)\n   291\t        days = {(j['view_id'], j['day']) for j in summary['judgements']}\n   292\t        checks[name] = {'not stopped': summary['stopped'] == '', 'comparable (fresh, not stopped)': summary['comparable'],\n   293\t                        'v14 judged each day': {d for v, d in days if v == 'v14'} == {'2026-07-10', '2026-07-11', '2026-07-12'},\n   294\t                        'v9 days': sorted(d for v, d in days if v == 'v9'), **chain_checks(summary, archive_path, prefix_ledger, name)}\n   295\t        if linked:\n   296\t            checks[name]['link written'] = summary['links'] == [('v9', 'v14', 'first_is_bullish', LINK_SEQ)] and summary['intended_link']\n   297\t            expected = ['2026-07-10', '2026-07-11', '2026-07-12'] if changed_on.get(('v14', 2)) else ['2026-07-10', '2026-07-12']\n   298\t            checks[name]['v9 queued by a changed v14 only'] = checks[name]['v9 days'] == expected\n   299\t        else:\n   300\t            checks[name]['no link'] = summary['links'] == [] and summary['link_requests_sent'] == []\n   301\t            checks[name]['v9 only on the stored days'] = checks[name]['v9 days'] == ['2026-07-10', '2026-07-12']\n   302\t    # the stop paths, each driven through replay with a recording transport\n   303\t    forwarded = []\n   304\t    unapproved, _, _ = run_sequence(scratch, 'stop-unapproved-judge', prefix_ledger, V118, False,\n   305\t                                    dispatcher(fake_judge('stop-unapproved-judge', {}), fake_jev(set()), forwarded), log, also_retire=('v8',))\n   306\t    checks['stop: an unapproved judge request'] = {\n   307\t        'stopped on v8': 'unapproved request in judging (thesis v8)' in unapproved['stopped'] or 'thesis v8' in unapproved.get('latch', ''),\n   308\t        'v8 never forwarded': 'v8' not in unapproved['judge_requests_sent'],\n   309\t        'nothing judged after 07-10': not any(j['day'] > WINDOW[0] for j in unapproved['judgements'])}\n   310\t    forwarded = []\n   311\t    wrong_seq, _, _ = run_sequence(scratch, 'stop-link-other-seq', prefix_ledger, V119, True,\n   312\t                                   dispatcher(fake_judge('stop-link-other-seq', {}), fake_jev({'v9'}), forwarded), log, link_seq=LINK_SEQ + 1)\n   313\t    checks['stop: a link request at another sequence'] = {\n   314\t        'stopped at seq 148': 'unapproved request at seq 148 (link questions)' in wrong_seq['stopped'] + wrong_seq.get('latch', ''),\n   315\t        'no request forwarded': forwarded == [] and wrong_seq['judge_requests_sent'] == [] and wrong_seq['link_requests_sent'] == []}\n   316\t    out_of_pair, _, _ = run_sequence(scratch, 'stop-out-of-pair', prefix_ledger, V119, True,\n   317\t                                     dispatcher(fake_judge('stop-out-of-pair', {}), fake_jev({'v9', 'v1', 'v2', 'v5', 'v6', 'v10', 'v11', 'v12'}), []), log)\n   318\t    checks['stop: an out-of-pair link'] = {\n   319\t        'stopped at inspection': out_of_pair['stopped'].startswith('Stop: out-of-pair link'),\n   320\t        'no judge attempt': out_of_pair['judge_requests_sent'] == [],\n   321\t        'no item handed over after seq 148': out_of_pair['handovers_after_link_seq'] == 0}\n   322\t    (scratch / 'dry-checks.json').write_text(json.dumps(checks, indent=1))\n   323\t    print(json.dumps(checks, indent=1))\n   324\t    flat = [v for c in checks.values() for v in c.values() if isinstance(v, bool)]\n   325\t    return all(flat)\n   326\t\n   327\t\n   328\t# ---------- the other $0 checks ----------\n   329\t\n   330\tdef prefix(scratch):\n   331\t    \"\"\"poc-v119 from an empty ledger over 07-01..07-09: link questions answered \"neither\", every other request from old-2's archive.\"\"\"\n   332\t    folder = scratch / 'prefix-v119'\n   333\t    if folder.exists():\n   334\t        raise SystemExit(f'{folder} exists')\n   335\t    folder.mkdir(parents=True)\n   336\t    shutil.copyfile(OLD2 / 'archive.sqlite', folder / 'archive.sqlite')\n   337\t    asked = []\n   338\t\n   339\t    def transport(*args):\n   340\t        if len(args) == 1 and is_link_request(args[0]):\n   341\t            asked.append(sorted(args[0]['questions']))\n   342\t            return fake_jev(set())(args[0])\n   343\t        raise Stop('a request other than a link question missed the archive')\n   344\t    replay.run(testdb_path=str(ITEMS), views_path=str(folder / 'views.sqlite'), archive=model.Archive(str(folder / 'archive.sqlite')),\n   345\t               cfg=config.load(str(V119)), universe=universe.load(str(UNIVERSE)), from_day='2026-07-01', until_day='2026-07-09',\n   346\t               transport=transport, log=lambda *a: None, only_objects={'NVDA'})\n   347\t    sys.path.insert(0, str(Path(__file__).parent))\n   348\t    import rebuild_control\n   349\t    equal = rebuild_control.compare(folder / 'views.sqlite', PREFIX_SEQ)\n   350\t    conn = sqlite3.connect(f'file:{folder / \"views.sqlite\"}?mode=ro', uri=True)\n   351\t    selections = [(a, s, json.loads(r)) for a, s, r in conn.execute('select attempt_id, status, record_json from link_selections order by id')]\n   352\t    pairs = [(a, p['candidate'], p['thesis']) for a, s, r in selections if s == 'proposed' for p in r['pairs'] if p.get('eligible') and 'thesis' in p]\n   353\t    print('link questions asked before 07-10 (answered neither):', len(asked), 'eligible pairs:', pairs)\n   354\t    return equal\n   355\t\n   356\t\n   357\tdef archive_proof(scratch):\n   358\t    folder = scratch / 'archive-proof'\n   359\t    folder.mkdir(parents=True, exist_ok=False)\n   360\t    shutil.copyfile(OLD2 / 'archive.sqlite', folder / 'archive.sqlite')\n   361\t    stored = sqlite3.connect(f'file:{OLD2 / \"archive.sqlite\"}?mode=ro', uri=True)\n   362\t    rows = {}\n   363\t    for call_id, request_json in stored.execute(\"select call_id, request_json from model_calls where purpose='judge' order by call_id\"):\n   364\t        view_id = judged_view(json.loads(request_json))\n   365\t        rows.setdefault(view_id, (call_id, json.loads(request_json)))\n   366\t    archive, retired, _ = retire_targets(folder / 'archive.sqlite')\n   367\t    sent = []\n   368\t\n   369\t    def recording(provider, request):\n   370\t        sent.append(judged_view(request))\n   371\t        data = {'rung': 0, 'reference': '', 'implied_outcome': '', 'reasons': '', 'cites': [], 'cites_views': [], 'pushes': [], 'changed': True,\n   372\t                'why_changed': '', 'theme_pushes': []}\n   373\t        return {'choices': [{'message': {'content': json.dumps(data)}}], 'usage': {'prompt_tokens': 1, 'completion_tokens': 1}}\n   374\t    cfg = config.load(str(V118))\n   375\t    results = {}\n   376\t    for view_id in ('v9', 'v14', 'v8'):\n   377\t        call_id, request = rows[view_id]\n   378\t        system, user = request['messages'][0]['content'], request['messages'][1]['content']\n   379\t        schema = request['response_format']['json_schema']['schema']\n   380\t        answer = model.call(archive, cfg, cfg.rejudging, system, user, schema, 'judgement', 'judge', transport=recording)\n   381\t        results[view_id] = {'sent to the transport': sent[-1:] == [view_id], 'call id kept': answer.cached and answer.call_id == call_id,\n   382\t                            'answer call id': answer.call_id}\n   383\t    archive.retire(results['v9']['answer call id'])           # as round_of_judgements retires an answer its check refuses\n   384\t    call_id, request = rows['v9']\n   385\t    before = len(sent)\n   386\t    model.call(archive, cfg, cfg.rejudging, request['messages'][0]['content'], request['messages'][1]['content'],\n   387\t               request['response_format']['json_schema']['schema'], 'judgement', 'judge', transport=recording)\n   388\t    proof = {'retired target rows': retired,\n   389\t             'an exact old v9 request goes to the transport': results['v9']['sent to the transport'],\n   390\t             'an exact old v14 request goes to the transport': results['v14']['sent to the transport'],\n   391\t             'an exact old v8 request is answered from the archive with its call id': results['v8']['call id kept'] and sent.count('v8') == 0,\n   392\t             'a retired (refused) answer is not returned again': len(sent) == before + 1}\n   393\t    print(json.dumps(proof, indent=1))\n   394\t    return all(v for k, v in proof.items() if isinstance(v, bool))\n   395\t\n   396\t\n   397\tdef budget_module():\n   398\t    import importlib.util\n   399\t    spec = importlib.util.spec_from_file_location('budget_replay', REPO / 'clean-arch/e2e-comparison-2026-11-13/budget_replay.py')\n   400\t    module = importlib.util.module_from_spec(spec)\n   401\t    spec.loader.exec_module(module)\n   402\t    return module\n   403\t\n   404\t\n   405\tdef bounds():\n   406\t    \"\"\"Every reservation the budget transport makes is an upper bound of what it then settles, checked on all of old-2's stored calls:\n   407\t    a Luna call settles its reported usage at published rates (`llm_cost`), never above `llm_estimate`; a Jev call settles\n   408\t    ATTEMPTS x reported input tokens, never above `jev_estimate`. With every settlement at or below its reservation, and a reservation\n   409\t    refused when spent + reserved + it would pass the ceiling, the ledger's spent never passes $0.15.\"\"\"\n   410\t    budget = budget_module()\n   411\t    archive = sqlite3.connect(f'file:{OLD2 / \"archive.sqlite\"}?mode=ro', uri=True)\n   412\t    worst = {'judge': 0.0, 'collision judge': 0.0, 'match (Jev)': 0.0}\n   413\t    counts = {'judge': 0, 'collision judge': 0, 'match (Jev)': 0}\n   414\t    for purpose, model_name, request_json, response_json, tokens_in in archive.execute(\n   415\t            \"select purpose, model, request_json, response_json, input_tokens from model_calls where purpose in ('judge', 'match')\"):\n   416\t        request = json.loads(request_json)\n   417\t        if model_name.startswith('jev'):\n   418\t            if not tokens_in:\n   419\t                continue\n   420\t            settled = budget.jev.ATTEMPTS * tokens_in * model.PRICES[model_name][0] / 1e6\n   421\t            ratio, key = settled / budget.jev_estimate(request), 'match (Jev)'\n   422\t        else:\n   423\t            settled = budget.llm_cost(json.loads(response_json), request)\n   424\t            if settled is None:\n   425\t                continue\n   426\t            ratio, key = settled / budget.llm_estimate(request), ('judge' if purpose == 'judge' else 'collision judge')\n   427\t        counts[key] += 1\n   428\t        worst[key] = max(worst[key], ratio)\n   429\t    result = {'calls checked': counts, 'largest settled / reserved': {k: round(v, 4) for k, v in worst.items()},\n   430\t              'every settlement within its reservation': all(v <= 1 for v in worst.values()) and all(counts.values())}\n   431\t    print(json.dumps(result, indent=1))\n   432\t    return result['every settlement within its reservation']\n   433\t\n   434\t\n   435\tdef price():\n   436\t    stored = sqlite3.connect(f'file:{OLD2 / \"archive.sqlite\"}?mode=ro', uri=True)\n   437\t    views = sqlite3.connect(f'file:{OLD2 / \"views.sqlite\"}?mode=ro', uri=True)\n   438\t    shas = [r[0] for r in views.execute(\"select request_sha256 from judgements where view_id in ('v9','v14') and publication_day between ? and ?\", WINDOW)]\n   439\t    price_in, price_out = model.PRICES['gpt-6-luna']\n   440\t    total, rows = 0.0, []\n   441\t    for sha in shas:\n   442\t        tokens_in, tokens_out = stored.execute('select input_tokens, output_tokens from model_calls where request_sha256=?', (sha,)).fetchone()\n   443\t        cost = tokens_in / 1e6 * price_in + tokens_out / 1e6 * price_out\n   444\t        rows.append((tokens_in, tokens_out, round(cost, 5)))\n   445\t        total += cost\n   446\t    v9 = [r for r, sha in zip(rows, shas) if views.execute(\"select view_id from judgements where request_sha256=?\", (sha,)).fetchone()[0] == 'v9']\n   447\t    extra_v9 = max(r[2] for r in v9) * 1.1               # a v9 call on 07-11 when v14 changes, with the dependency block (about 700 characters)\n   448\t    jev_in = model.PRICES['jev-1.14.0'][0]\n   449\t    jev_calls = 2 * 3 * 20000 * jev_in / 1e6             # two link jobs, Jev's three attempts, a generous 20,000 input tokens each\n   450\t    linked = total + extra_v9 + jev_calls\n   451\t    print(json.dumps({'stored v9/v14 judge calls in the window': rows, 'control sequence (uncached)': round(total, 4),\n   452\t                      'linked sequence, upper estimate (an extra v9 call, two link jobs)': round(linked, 4),\n   453\t                      'six sequences': round(3 * total + 3 * linked, 4), 'ceiling': CEILING}, indent=1))\n   454\t\n   455\t\n   456\tORDER = [('control-1', V118, False), ('linked-1', V119, True), ('control-2', V118, False), ('linked-2', V119, True),\n   457\t         ('control-3', V118, False), ('linked-3', V119, True)]       # alternated, so a ceiling stop falls on both arms alike\n   458\t\n   459\t\n   460\tdef send(prefix_ledger, out):\n   461\t    \"\"\"The paid comparison (run only after the council passed the $0 proof, D694 (c)): six sequences through the shared reservation ledger\n   462\t    of the comparison runs, one ceiling of $0.15; the ledger is read after each sequence, and a refused reservation or a stop makes the\n   463\t    comparison inconclusive and ends it.\"\"\"\n   464\t    import importlib.util\n   465\t    spec = importlib.util.spec_from_file_location('budget_replay', REPO / 'clean-arch/e2e-comparison-2026-11-13/budget_replay.py')\n   466\t    budget = importlib.util.module_from_spec(spec)\n   467\t    spec.loader.exec_module(budget)\n   468\t    out.mkdir(parents=True, exist_ok=False)\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba docs/research/2026-11-20-production-readiness/dependency-design/july_test.py | sed -n '468,740p'\"","aggregated_output":"   468\t    out.mkdir(parents=True, exist_ok=False)\n   469\t    ledger_path = out / 'ledger.json'\n   470\t    budget.SharedLedger.init(str(ledger_path), CEILING)\n   471\t    ledger = budget.SharedLedger(str(ledger_path))\n   472\t    remove_gate = budget.install_stop_gate(ledger)\n   473\t    transport = budget.BudgetTransport(ledger)\n   474\t    results, outcome = [], 'complete'\n   475\t    with open(out / 'send.log', 'a', encoding='utf-8') as log_file:\n   476\t        def log(*parts):\n   477\t            log_file.write(' '.join(str(p) for p in parts) + '\\n')\n   478\t            log_file.flush()\n   479\t        try:\n   480\t            for index, (name, cfg_path, linked) in enumerate(ORDER):\n   481\t                log(f'--- start {name}')\n   482\t                try:\n   483\t                    summary, _, _ = run_sequence(out, name, prefix_ledger, cfg_path, linked, transport, log)\n   484\t                except BaseException as error:\n   485\t                    summary = {'name': name, 'started': True, 'stopped': f'{type(error).__name__}: {error}'[:400], 'comparable': False}\n   486\t                    outcome = f'stopped: {name} raised before its summary'\n   487\t                    results.append(summary)\n   488\t                    results.extend({'name': n, 'started': False} for n, _, _ in ORDER[index + 1:])\n   489\t                    raise\n   490\t                state = ledger.read()\n   491\t                summary['ledger_after'] = state\n   492\t                results.append(summary)\n   493\t                log(f'--- finish {name}: stopped={summary[\"stopped\"]!r} comparable={summary[\"comparable\"]} spent ${state[\"spent\"]:.4f} '\n   494\t                    f'reserved ${state[\"reserved\"]:.4f} refused {state[\"refused\"]}')\n   495\t                if state.get('stopped') or state.get('refused') or state.get('overrun'):\n   496\t                    outcome = 'inconclusive: the shared ledger stopped, refused or overran'\n   497\t                elif not summary['comparable']:\n   498\t                    outcome = f'stopped: {name} is not comparable ({summary[\"stopped\"] or \"a target judgement was not fresh\"})'\n   499\t                if outcome != 'complete':\n   500\t                    results.extend({'name': n, 'started': False} for n, _, _ in ORDER[index + 1:])\n   501\t                    break\n   502\t        finally:\n   503\t            remove_gate()\n   504\t            (out / 'send-summary.json').write_text(json.dumps({'outcome': outcome, 'ledger': ledger.read(), 'sequences': results}, indent=1, ensure_ascii=False))\n   505\t    print(outcome, ledger.read())\n   506\t\n   507\t\n   508\tif __name__ == '__main__':\n   509\t    mode, scratch = sys.argv[1], Path(sys.argv[2])\n   510\t    scratch.mkdir(parents=True, exist_ok=True)\n   511\t    if mode == 'prefix':\n   512\t        sys.exit(0 if prefix(scratch) else 1)\n   513\t    if mode == 'archive':\n   514\t        sys.exit(0 if archive_proof(scratch) else 1)\n   515\t    if mode == 'dry':\n   516\t        sys.exit(0 if dry(scratch, Path(sys.argv[3])) else 1)\n   517\t    if mode == 'price':\n   518\t        price()\n   519\t        sys.exit(0)\n   520\t    if mode == 'bounds':\n   521\t        sys.exit(0 if bounds() else 1)\n   522\t    if mode == 'send':\n   523\t        send(Path(sys.argv[3]), Path(sys.argv[4]))\n","exit_code":0,"status":"completed"}}
