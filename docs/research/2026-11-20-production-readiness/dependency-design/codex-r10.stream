{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba src/hivemind/views/links.py | sed -n '175,218p'; rg -n -A 41 'def test_.*(failure|later_insertion)' tests/test_links.py\"","aggregated_output":"   175\t\n   176\t# ---------- selection ----------\n   177\t\n   178\tdef _ask(archive, cfg, jobs, transport, record, stage):\n   179\t    \"\"\"One Jev request per job, asked in order; each job is written into the record before it is sent (its request sha, whether the\n   180\t    archive held it) and completed as it is answered (its call id). A failure names the failing job's sha and leaves the later jobs\n   181\t    marked not asked.\"\"\"\n   182\t    entries = []\n   183\t    for state, questions in jobs:\n   184\t        _, sha = model.request_identity(jev.request_for(cfg.matching, state, questions))\n   185\t        entries.append({'stage': stage, 'request_sha256': sha, 'questions': sorted(questions), 'archived_before': bool(archive.lookup(sha)),\n   186\t                        'status': 'not asked'})\n   187\t    record['calls'].extend(entries)\n   188\t    replies = []\n   189\t    for entry, (state, questions) in zip(entries, jobs):\n   190\t        try:\n   191\t            reply = jev.ask(archive, cfg, cfg.matching, state, questions, 'match', transport=transport)\n   192\t        except Exception as error:\n   193\t            entry['status'] = 'failed'\n   194\t            record['error'] = f'{type(error).__name__}: {error}'[:300]\n   195\t            record['failed_request_sha256'] = entry['request_sha256']\n   196\t            raise Refused(f'link question failed: {record[\"error\"]}', record) from error\n   197\t        entry['status'], entry['call_id'] = 'answered', reply.call_id\n   198\t        replies.append(reply.data)\n   199\t    return replies\n   200\t\n   201\t\n   202\tdef _passes(answer, accepted):\n   203\t    choice = answer['choice']\n   204\t    return choice if choice in accepted and answer['probabilities'][choice] >= THRESHOLD else None\n   205\t\n   206\t\n   207\tdef choose(archive, cfg, conn, handover, checked, lists, shown_views, *, transport=None):\n   208\t    \"\"\"The links this article proposes: [{'reader', 'read', 'candidate', 'direction', 'sign'}], reader and read being a candidate id\n   209\t    (canonical) or a stored view id; and the record of how they were chosen. Raises Refused for an unbound waiting row, a Jev\n   210\t    failure or a circle that remains after one correction (PRD 06).\"\"\"\n   211\t    record = {'pairs': [], 'calls': [], 'corrections': [], 'proposed': []}\n   212\t    if unbound_waits(conn):\n   213\t        record['error'] = 'the store holds an unbound waiting dependency row'\n   214\t        raise Refused(record['error'], record)\n   215\t    aliases, problems = identity.batch_plan(handover.candidates, checked.outcomes)\n   216\t    if problems:                                   # the writer refuses the same plan (WriteConflict); nothing to ask\n   217\t        record['skipped'] = problems\n   218\t        return [], record\n278:def test_a_circle_closed_by_a_later_insertion_rolls_back_the_whole_write(tmp_path):\n279-    conn = ledger(tmp_path, [('v1', KEY, RUNGS, 'Data Center revenue FY2027?')])\n280-    total = candidate('c1', rungs=TOTAL_RUNGS, question='Total revenue FY2027?', **TOTAL)\n281-    proposed = [{'reader': 'v1', 'read': 'c1', 'candidate': 'c1', 'thesis': 'v1', 'direction': links.THESIS_READS, 'sign': links.TOGETHER},\n282-                {'reader': 'c1', 'read': 'v1', 'candidate': 'c1', 'thesis': 'v1', 'direction': links.CANDIDATE_READS, 'sign': links.TOGETHER}]\n283-    with pytest.raises(writing.WriteConflict, match='circle'):\n284-        write_with(conn, proposed, total)\n285-    conn.rollback()\n286-    assert conn.execute('select count(*) from dependencies').fetchone()[0] == 0\n287-    assert conn.execute(\"select count(*) from views where view_id != 'v1'\").fetchone()[0] == 0\n288-\n289-\n290-# ---------- §4, test 5: filing ----------\n291-\n292-def test_a_reads_link_is_not_a_narrower_home_and_a_seed_row_still_is(tmp_path):\n293-    conn = two_totals(tmp_path)\n294-    stored_link(conn, 'v2', 'v1')\n295-    assert store.direct_parents(conn, 'v2') == []\n296-    assert extraction.narrowest_links(['v1', 'v2'], {'v2': store.direct_parents(conn, 'v2')}) == ['v1', 'v2']\n297-    store.insert(conn, 'dependencies', view_id='v1', depends_on='v2', wait_chain_view_id='', wait_year='', direction='last_end', seq=0)\n298-    conn.commit()\n299-    assert store.direct_parents(conn, 'v1') == ['v2']\n300-    assert extraction.narrowest_links(['v1', 'v2'], {'v1': store.direct_parents(conn, 'v1')}) == ['v1']\n301-\n302-\n303-# ---------- §3, test 6: what the judge is shown ----------\n304-\n305-def judged(conn, view_id, seq, reference, implied, reasons='Reasons line one.', rung=3, changed=1):\n306-    store.insert(conn, 'judgements', view_id=view_id, seq=seq, input_id='day', rung=rung, reasons=reasons, cited_evidence_json='[]', cited_views_json='[]',\n307-                 pushes_json='[]', changed=changed, why_changed='', config_checksum='x', call_id=0, request_sha256='', publication_day='2026-05-19',\n308-                 theme_pushes_json='[]', reference=reference, implied_outcome=implied)\n309-    conn.commit()\n310-\n311-\n312-def test_judging_v8_shows_the_comparison_point_and_forecast_and_v7_is_unchanged(tmp_path):\n313-    conn = ledger(tmp_path, [('v1', TOTAL, TOTAL_RUNGS, 'Total revenue FY2027?'), ('v2', KEY, RUNGS, 'Data Center revenue FY2027?')])\n314-    stored_link(conn, 'v2', 'v1')\n315-    judged(conn, 'v1', 1, 'Consensus is $393B.\\n- e1 [fact] not an item', 'About $387B:\\nQ4 $112B.', reasons='Reasons.\\n[Evidence in view]')\n316-    user8 = judging.build_prompt(conn, 'v2', 'judging-v8')[1]\n317-    block = user8.split('[Current conclusions of the theses it depends on]\\n', 1)[1].split('\\n\\n', 1)[0]\n318-    assert block.splitlines() == [\n319-        '- v1 (open; first_is_bullish) Total revenue FY2027?: now rung 3 Neutral, judged 2026-05-19',\n--\n412:def test_a_jev_failure_after_an_answered_job_records_each_job_and_the_failing_one(tmp_path):\n413-    \"\"\"§1 step 6 (council R round 9): the first job answered, the second fails, the third not asked.\"\"\"\n414-    conn = ledger(tmp_path, [('v1', TOTAL, TOTAL_RUNGS, 'Total revenue FY2027?')])\n415-    parts = [candidate('c1', question='Data Center revenue FY2027?'), candidate('c2', question='Gaming revenue FY2027?', scope='Gaming'),\n416-             candidate('c3', question='Networking revenue FY2027?', scope='Networking')]\n417-    answered = scripted({'reads__v1': (links.NEITHER, 0.9)})\n418-    count = []\n419-\n420-    def transport(request):\n421-        count.append(1)\n422-        if len(count) == 2:\n423-            raise model.TransportError('Jev transport failed: URLError')\n424-        return answered(request)\n425-    with pytest.raises(links.Refused) as refused:\n426-        links.choose(model.Archive(str(tmp_path / 'a.sqlite')), CFG, conn, handover_of(*parts), checked_new('c1', 'c2', 'c3'),\n427-                     matching.Lists({'c1': ['v1'], 'c2': ['v1'], 'c3': ['v1']}, {}), [], transport=transport)\n428-    calls = refused.value.record['calls']\n429-    assert [c['status'] for c in calls] == ['answered', 'failed', 'not asked'] and isinstance(calls[0]['call_id'], int)\n430-    assert refused.value.record['failed_request_sha256'] == calls[1]['request_sha256']\n431-\n432-\n433:def test_a_jev_failure_records_failed_alone_with_the_failing_request(tmp_path):\n434-    conn = ledger(tmp_path, [('v1', KEY, RUNGS, 'Data Center revenue FY2027?')])\n435-    total = candidate('c1', rungs=TOTAL_RUNGS, question='Total revenue FY2027?', looks_at='total revenue', **TOTAL)\n436-    inner = scripted({'rel__v1': ('different', 0.9)})\n437-\n438-    def transport(request):\n439-        if any(qid.startswith('reads__') for qid in request['questions']):\n440-            raise model.TransportError('Jev transport failed: URLError')\n441-        return inner(request)\n442-    item = dict(ITEM, text='Total revenue guidance.')\n443-    result = rounds.run(conn, model.Archive(str(tmp_path / 'archive.sqlite')), CFG, UNIVERSE, item, 2, transport=transport,\n444-                        extractor=lambda *args, **kwargs: handover_of(total))\n445-    assert result.failed.startswith('linking: link question failed')\n446-    rows = conn.execute('select status, record_json from link_selections').fetchall()\n447-    assert [r[0] for r in rows] == ['failed']\n448-    call = json.loads(rows[0][1])['calls'][0]\n449-    assert call['stage'] == 'reads' and len(call['request_sha256']) == 64 and 'error' in json.loads(rows[0][1])\n450-\n451-\n452-def test_a_write_conflict_after_the_proposal_records_proposed_then_failed(tmp_path, monkeypatch):\n453-    conn = ledger(tmp_path, [('v1', KEY, RUNGS, 'Data Center revenue FY2027?')])\n454-    monkeypatch.setattr(links, 'label_for', lambda *args: None)           # the stored rungs give no label: the write refuses\n455-    result, _ = run_article(tmp_path, CFG, {'reads__v1': (links.THESIS_READS, 0.8), 'sign__v1': (links.TOGETHER, 0.8)}, conn)\n456-    assert result.failed.startswith('writing:')\n457-    assert [r[0] for r in conn.execute('select status from link_selections order by id')] == ['proposed', 'failed']\n458-    assert conn.execute('select count(*) from dependencies').fetchone()[0] == 0\n","exit_code":0,"status":"completed"}}
