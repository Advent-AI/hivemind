value, dict):\n   205\t            return [f'{path}: expected object']\n   206\t        errors = []\n   207\t        for name in schema.get('required', []):\n   208\t            if name not in value:\n   209\t                errors.append(f'{path}.{name}: required')\n   210\t        properties = schema.get('properties', {})\n   211\t        for name, item in value.items():\n   212\t            if name in properties:\n   213\t                errors.extend(check_schema(item, properties[name], f'{path}.{name}', root))\n   214\t            elif schema.get('additionalProperties') is False:\n   215\t                errors.append(f'{path}.{name}: not allowed')\n   216\t        return errors\n   217\t    if kind == 'array':\n   218\t        if not isinstance(value, list):\n   219\t            return [f'{path}: expected array']\n   220\t        errors = []\n   221\t        if len(value) < schema.get('minItems', 0):\n   222\t            errors.append(f'{path}: fewer than {schema[\"minItems\"]} items')\n   223\t        for index, item in enumerate(value):\n   224\t            errors.extend(check_schema(item, schema.get('items', {}), f'{path}[{index}]', root))\n   225\t        return errors\n   226\t    if kind == 'string':\n   227\t        if not isinstance(value, str):\n   228\t            return [f'{path}: expected string']\n   229\t        if 'enum' in schema and value not in schema['enum']:\n   230\t            return [f'{path}: {value!r} not in {schema[\"enum\"]}']\n   231\t        if 'pattern' in schema and not re.search(schema['pattern'], value):\n   232\t            return [f'{path}: {value!r} does not match {schema[\"pattern\"]}']\n   233\t        return []\n   234\t    if kind == 'integer':\n   235\t        return [] if isinstance(value, int) and not isinstance(value, bool) else [f'{path}: expected integer']\n   236\t    if kind == 'number':\n   237\t        return [] if isinstance(value, (int, float)) and not isinstance(value, bool) else [f'{path}: expected number']\n   238\t    if kind == 'boolean':\n   239\t        return [] if isinstance(value, bool) else [f'{path}: expected boolean']\n   240\t    if kind == 'null':\n   241\t        return [] if value is None else [f'{path}: expected null']\n   242\t    return []\n   243\t\n   244\t\n   245\tdef request_identity(request):\n   246\t    \"\"\"The exact serialized request and its archive key, shared by callers and validation.\"\"\"\n   247\t    encoded = json.dumps(request, sort_keys=True, ensure_ascii=False)\n   248\t    return encoded, hashlib.sha256(encoded.encode('utf-8')).hexdigest()\n   249\t\n   250\t\n   251\tdef call(archive, cfg, setting, system, user, schema, schema_name, purpose, *, transport=None):\n   252\t    provider = cfg.provider\n   253\t    request = build_request(setting, system, user, schema, schema_name, provider)\n   254\t    request_json, sha = request_identity(request)\n   255\t    hit = archive.lookup(sha)\n   256\t    prompt_chars = len(system) + len(user)\n   257\t    if hit:\n   258\t        call_id, answer_json, _, input_tokens, output_tokens = hit\n   259\t        return Answer(json.loads(answer_json), call_id, sha, True, prompt_chars, input_tokens or 0, output_tokens or 0, 0.0)\n   260\t    started = time.time()\n   261\t    response = (transport or openai_transport)(provider, request)\n   262\t    seconds = round(time.time() - started, 1)\n   263\t    try:\n   264\t        content = response['choices'][0]['message']['content']\n   265\t        data = json.loads(content)\n   266\t    except (KeyError, IndexError, TypeError, json.JSONDecodeError) as error:\n   267\t        archive.record(purpose=purpose, config_version=cfg.version, config_checksum=cfg.checksum, model=setting.model,\n   268\t                       request_sha256=sha + ':malformed:' + uuid.uuid4().hex[:8], request_json=request_json,\n   269\t                       response_json=json.dumps(response)[:200000], answer_json=None, prompt_chars=prompt_chars,\n   270\t                       input_tokens=0, output_tokens=0, cost_usd=0.0, seconds=seconds, created_at=time.strftime('%Y-%m-%dT%H:%M:%S'))\n   271\t        raise SchemaError(f'malformed answer: {error}')\n   272\t    errors = check_schema(data, schema)\n   273\t    usage = response.get('usage') or {}\n   274\t    input_tokens = int(usage.get('prompt_tokens') or 0)\n   275\t    output_tokens = int(usage.get('completion_tokens') or 0)\n   276\t    cached_tokens = min(input_tokens, int((usage.get('prompt_tokens_details') or {}).get('cached_tokens') or 0))\n   277\t    price_in, price_out = PRICES.get(setting.model, (0.0, 0.0))\n   278\t    cost = round((input_tokens - cached_tokens) / 1e6 * price_in + cached_tokens / 1e6 * price_in * CACHED_INPUT_SHARE + output_tokens / 1e6 * price_out, 6)\n   279\t    call_id = archive.record(purpose=purpose, config_version=cfg.version, config_checksum=cfg.checksum, model=setting.model,\n   280\t                             request_sha256=sha if not errors else sha + ':schema:' + uuid.uuid4().hex[:8], request_json=request_json,\n   281\t                             response_json=json.dumps(response)[:200000], answer_json=json.dumps(data, ensure_ascii=False),\n   282\t                             prompt_chars=prompt_chars, input_tokens=input_tokens, output_tokens=output_tokens, cost_usd=cost,\n   283\t                             seconds=seconds, created_at=time.strftime('%Y-%m-%dT%H:%M:%S'))\n   284\t    if errors:\n   285\t        raise SchemaError('; '.join(errors[:5]))\n   286\t    return Answer(data, call_id, sha, False, prompt_chars, input_tokens, output_tokens, cost)\n    23\t    failed: str = ''\n    24\t    dropped: int = 0\n    25\t\n    26\t\n    27\tdef _fail(conn, item, seq, result, step, kind, detail, pool_key):\n    28\t    dispatch.mark(conn, item, seq, step, 'failed', detail[:300])\n    29\t    store.pool(conn, kind, pool_key, {'input_id': item['input_id'], 'error': detail[:300]}, seq)\n    30\t    result.failed = detail[:200]\n    31\t    conn.commit()\n    32\t    return result\n    33\t\n    34\t\n    35\tdef _match(conn, archive, cfg, universe, item, seq, result, candidates, evidence, lists, shown, *, extra_views=(), call_offset=0, transport=None, workers=1):\n    36\t    \"\"\"One matching call with one retry on a refused check. Returns Checked, or None after marking the failure.\"\"\"\n    37\t    note = ''\n    38\t    checked = None\n    39\t    engine = jev_matching if cfg.matching.engine == 'jev' else matching      # Jev answers once; a retry would be the same answer\n    40\t    for attempt in range(1 if engine is jev_matching else 2):\n    41\t        try:\n    42\t            options = {'workers': workers, 'llm_transport': transport} if engine is jev_matching else {}     # the collision judge sends with the caller's transport too\n    43\t            answer = engine.decide(archive, cfg, conn, item, candidates, evidence, lists, shown, extra_views=extra_views, retry_note=note, transport=transport, **options)\n    44\t        except Exception as error:\n    45\t            _fail(conn, item, seq, result, 'matched', 'matching_failed', 'matching: ' + repr(error), type(error).__name__)\n    46\t            return None\n    47\t        result.cost += answer.cost_usd\n    48\t        result.cached_calls += int(answer.cached)\n    49\t        checked = matching.check(conn, universe, answer.data, candidates, evidence, lists, shown)\n    50\t        shown_record = {'candidates': lists.candidate_lists, 'evidence': {f'{k[0]}|{k[1]}': v for k, v in lists.evidence_lists.items()}}\n    51\t        if getattr(answer, 'request_records', None):\n    52\t            shown_record['requests'] = answer.request_records\n    53\t        store.insert(conn, 'match_records', seq=seq, input_id=item['input_id'], call_no=call_offset + attempt + 1,\n    54\t                     shown_json=json.dumps(shown_record),\n    55\t                     request_sha256=answer.request_sha256, call_id=answer.call_id, decisions_json=json.dumps(answer.data, ensure_ascii=False),\n    56\t                     checks_json=json.dumps({'refusals': checked.refusals, 'not_opened': checked.not_opened, 'notes': checked.notes}, ensure_ascii=False), written_json=None)\n    57\t        if not checked.refusals:\n    58\t            return checked\n    59\t        note = '；'.join(checked.refusals)\n    60\t    _fail(conn, item, seq, result, 'matched', 'matching_refused_twice', 'matching refused twice: ' + note, item['category'])\n    61\t    return None\n    62\t\n    63\t\n    64\tdef changed_views_of_day(conn, day):\n    65\t    \"\"\"The views whose reading changed on a replay day: the union of the 'written' records of that day's items and of the coverage-start reading's\n    66\t    record dated that day (D364: the questions it linked starting figures to are judged in the first day's round).\"\"\"\n    67\t    changed = set()\n    68\t    for row in conn.execute(\"select reason from processing_steps where step in ('written', 'baseline') and result='ok' and publication_day=?\", (day,)):\n    69\t        changed.update(json.loads(row['reason']).get('changed', []))\n    70\t    return changed\n    71\t\n    72\t\n    73\tdef judge_day(conn, archive, cfg, day, seq, *, transport=None, log=print):\n    74\t    \"\"\"D63: one re-judging round per day over every open view whose reading changed that day, dependencies first,\n    75\t    recorded under the day's own processing record (input 'day:<date>'); a view already judged at this sequence\n    76\t    number (a resumed day) is not judged twice.\"\"\"\n    77\t    marker = {'input_id': f'day:{day}', 'publication_day': day}\n    78\t    changed = changed_views_of_day(conn, day)\n    79\t    result = RoundResult(marker['input_id'])\n    80\t    if not changed:\n    81\t        return result\n    82\t    try:\n    83\t        judged = judging.round_of_judgements(archive, cfg, conn, sorted(changed), seq, marker, transport=transport)\n    84\t        result.judged = len(judged)\n    85\t        result.changed = sum(1 for j in judged if j['changed'])\n    86\t        result.cost += sum(j['cost'] for j in judged)\n    87\t        result.cached_calls += sum(1 for j in judged if j['cached'])\n    88\t        dispatch.mark(conn, marker, seq, 'judged', 'ok', f'{len(changed)} views changed, {len(judged)} judged, {result.changed} changed conclusions')\n    89\t        conn.commit()\n    90\t    except judging.JudgementRefused as error:\n    91\t        return _fail(conn, marker, seq, result, 'judged', 'judgement_refused_twice', 'judgement refused twice: ' + str(error), 'day')\n    92\t    except Exception as error:\n    93\t        return _fail(conn, marker, seq, result, 'judged', 'judging_failed', 'judging: ' + repr(error), type(error).__name__)\n    94\t    return result\n    95\t\n   122\t        conn.commit()\n   123\t    result.evidence, result.candidates, result.dropped = len(handover.evidence), len(handover.candidates), len(handover.dropped)\n   124\t    if not handover.evidence and not handover.candidates:\n   125\t        dispatch.mark(conn, item, seq, 'handed_over', 'ok', 'nothing to match')\n   126\t        conn.commit()\n   127\t        return result\n   128\t    # first matching call: the candidates and the evidence linked straight to existing views\n   129\t    lists = matching.build_lists(conn, handover, shown, cfg.search_top_n)\n   130\t    checked = _match(conn, archive, cfg, universe, item, seq, result, handover.candidates, handover.evidence, lists, shown, transport=transport, workers=matching_workers)\n   131\t    if checked is None:\n   132\t        return result\n   133\t    # second call: evidence linked to candidates that attached to an existing view, compared under that view\n   134\t    second_pass = {}\n   135\t    pending = []\n   136\t    for e in handover.evidence:\n   137\t        for link in e['links']:\n   138\t            outcome = checked.outcomes.get(link)\n   139\t            if outcome and outcome[0] == 'merge':\n   140\t                pending.append((e, outcome[1]))\n   141\t    if pending:\n   142\t        lists2 = matching.Lists({}, {(e['id'], view_id): matching.rank_evidence(conn, view_id, e['one_line'], cfg.search_top_n) for e, view_id in pending})\n   143\t        evidence2, seen = [], set()\n   144\t        for e, view_id in pending:\n   145\t            if e['id'] not in seen:\n   146\t                evidence2.append(dict(e, links=[v for x, v in pending if x['id'] == e['id']]))\n   147\t                seen.add(e['id'])\n   148\t        checked2 = _match(conn, archive, cfg, universe, item, seq, result, [], evidence2, lists2, [], extra_views=sorted({v for _, v in pending}),\n   149\t                          call_offset=2, transport=transport, workers=matching_workers)\n   150\t        if checked2 is None:\n   151\t            return result\n   152\t        second_pass = checked2.evidence\n   153\t    dispatch.mark(conn, item, seq, 'matched', 'ok', f'{len(checked.outcomes)} candidates placed')\n   154\t    # write, and record what changed in the same commit (a resume at 'judged' reads it)\n   155\t    try:\n   156\t        written = writing.write(conn, universe, seq, item, handover, checked, second_pass)\n   157\t    except Exception as error:\n   158\t        return _fail(conn, item, seq, result, 'written', 'writing_failed', 'writing: ' + repr(error), type(error).__name__)\n   159\t    result.new_views = len(set(written.new_views.values()))\n   160\t    dispatch.mark(conn, item, seq, 'written', 'ok', json.dumps({'changed': sorted(written.changed_views), 'new': written.new_views, 'notes': written.notes[:20]}, ensure_ascii=False))\n   161\t    dispatch.mark(conn, item, seq, 'handed_over', 'ok', '')\n   162\t    conn.commit()\n   163\t    return result\n    19\t\n    20\tdef _prompt_files(extraction, matching, rejudging, idea=None, idea_summary=None, collision=None, placement=None):\n    21\t    \"\"\"03-config: a version that names a prompt that does not exist is refused whole. An extraction setting's\n    22\t    prompt_version is '<category>-<v>': block 2 and 4 come from categories-<v>.json (the category's entry) and the\n    23\t    role from role-<v>.txt; matching, re-judging and the idea reading name their file without the extension.\"\"\"\n    24\t    for category, setting in extraction.items():\n    25\t        prefix, _, version = setting.prompt_version.rpartition('-')\n    26\t        if prefix != category or not version:\n    27\t            raise ConfigError(f'extraction.{category}: prompt_version {setting.prompt_version!r} must be {category}-<version>')\n    28\t        categories_file = prompt_path(f'categories-{version}.json')\n    29\t        if not os.path.exists(categories_file) or not os.path.exists(prompt_path(f'role-{version}.txt')):\n    30\t            raise ConfigError(f'extraction.{category}: prompts for version {version!r} do not exist')\n    31\t        with open(categories_file, encoding='utf-8') as handle:\n    32\t            if category not in json.load(handle):\n    33\t                raise ConfigError(f'extraction.{category}: categories-{version}.json has no entry for {category}')\n    34\t    for setting in (matching, rejudging, idea, idea_summary, collision, placement):\n    35\t        if setting is not None and not os.path.exists(prompt_path(setting.prompt_version + '.txt')):\n    36\t            raise ConfigError(f'{setting.name}: prompt {setting.prompt_version}.txt does not exist')\n    37\t\n    38\t\n    39\t@dataclasses.dataclass(frozen=True)\n    40\tclass Setting:\n    41\t    name: str\n    42\t    model: str\n    43\t    prompt_version: str\n    44\t    reasoning_effort: str\n    45\t    max_output_tokens: int\n    46\t    engine: str = 'llm'       # matching only: 'llm' (the generative call) or 'jev' (TypeSafe Jev, views/jev_matching.py)\n    47\t\n    48\t\n    49\tENGINES = ('llm', 'jev')\n    50\t\n    51\t\n    52\t@dataclasses.dataclass(frozen=True)\n    53\tclass Config:\n    54\t    version: str\n    55\t    checksum: str\n    56\t    provider: str\n    57\t    search_top_n: int\n    58\t    extraction: dict          # category -> Setting\n    59\t    matching: Setting\n    60\t    rejudging: Setting\n    61\t    final_verdict: Setting\n    62\t    idea: Setting = None      # the service's reading of a user's idea (docs/poc/idea-card.md); absent in pipeline-only configs\n    63\t    idea_summary: Setting = None  # optional analyst TLDR after the mapping is fixed\n    64\t    collision: Setting = None # D190: the analyst question asked of the generative model when a candidate lists a thesis of its own object and measure; absent: Jev alone\n    65\t    placement: Setting = None # 2026-10-28: the call that files an item's statements under existing theses (extraction v20); absent before v20\n    66\t    baseline: Setting = None  # D364: the coverage-start reading of the company's latest report (hivemind.baseline); absent: no such step\n    67\t\n    68\t    def extraction_setting(self, category):\n    69\t        setting = self.extraction.get(category)\n    70\t        if setting is None:\n    71\t            raise ConfigError(f'no extraction setting for category {category} in config {self.version}')\n    72\t        return setting\n    73\t\n    74\t\n    75\tREQUIRED = ('model', 'prompt_version', 'reasoning_effort', 'max_output_tokens')\n    76\t\n    77\t\n    78\tdef _setting(name, raw):\n    79\t    if not isinstance(raw, dict):\n    80\t        raise ConfigError(f'setting {name} is missing')\n    81\t    missing = [key for key in REQUIRED if key not in raw]\n    82\t    if missing:\n    83\t        raise ConfigError(f'setting {name} lacks {missing}')\n    84\t    engine = str(raw.get('engine', 'llm'))\n    85\t    if engine not in ENGINES:\n    86\t        raise ConfigError(f'setting {name}: engine {engine!r} is not one of {ENGINES}')\n    87\t    return Setting(name=name, model=str(raw['model']), prompt_version=str(raw['prompt_version']),\n    88\t                   reasoning_effort=str(raw['reasoning_effort']),\n    89\t                   max_output_tokens=int(raw['max_output_tokens']), engine=engine)\n    90\t\n    91\t\n    92\tdef load(path):\n    93\t    with open(path, encoding='utf-8') as handle:\n    94\t        text = handle.read()\n    95\t    raw = json.loads(text)\n    96\t    for key in ('version', 'provider', 'search_top_n', 'extraction', 'matching', 'rejudging', 'final_verdict'):\n    97\t        if key not in raw:\n    98\t            raise ConfigError(f'config lacks {key}')\n    99\t    canonical = json.dumps({k: v for k, v in raw.items() if not k.startswith('_')}, sort_keys=True, ensure_ascii=False)\n   100\t    checksum = hashlib.sha256(canonical.encode('utf-8')).hexdigest()[:16]\n   101\t    extraction = {category: _setting(f'extraction.{category}', setting) for category, setting in raw['extraction'].items()}\n   102\t    matching, rejudging = _setting('matching', raw['matching']), _setting('rejudging', raw['rejudging'])\n   103\t    idea = _setting('idea', raw['idea']) if 'idea' in raw else None\n   104\t    idea_summary = _setting('idea_summary', raw['idea_summary']) if 'idea_summary' in raw else None\n   105\t    if idea_summary is not None and idea is None:\n   106\t        raise ConfigError('idea_summary requires an idea setting')\n   107\t    collision = _setting('collision', raw['collision']) if 'collision' in raw else None\n   108\t    placement = _setting('placement', raw['placement']) if 'placement' in raw else None\n   109\t    baseline = _setting('baseline', raw['baseline']) if 'baseline' in raw else None\n   110\t    _prompt_files(extraction, matching, rejudging, idea, idea_summary, collision, placement)       # final_verdict is kept in the file but no POC step calls it\n   111\t    if baseline is not None and not os.path.exists(prompt_path(baseline.prompt_version + '.json')):\n   112\t        raise ConfigError(f'baseline: prompt {baseline.prompt_version}.json does not exist')\n   113\t    return Config(version=str(raw['version']), checksum=checksum, provider=str(raw['provider']),\n   114\t                  search_top_n=int(raw['search_top_n']), extraction=extraction,\n   115\t                  matching=matching, rejudging=rejudging, final_verdict=_setting('final_verdict', raw['final_verdict']), idea=idea, idea_summary=idea_summary, collision=collision, placement=placement,\n   116\t                  baseline=baseline)\n","exit_code":0,"status":"completed"}}
