{"type":"item.started","item":{"id":"item_11","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba src/hivemind/views/matching.py | sed -n '255,392p'\nnl -ba src/hivemind/views/writing.py | sed -n '49,66p;112,156p;175,205p'\nnl -ba src/hivemind/views/store.py | sed -n '13,98p;126,150p;214,277p'\nnl -ba scripts/show_views.py | sed -n '8,45p'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba src/hivemind/views/jev_matching.py | sed -n '42,70p;115,230p;262,370p'\nnl -ba src/hivemind/views/identity.py | sed -n '74,115p'\nnl -ba src/hivemind/jev.py | sed -n '52,132p'\"","aggregated_output":"    42\t@dataclasses.dataclass\n    43\tclass Decision:\n    44\t    data: dict\n    45\t    call_id: int\n    46\t    request_sha256: str\n    47\t    cached: bool\n    48\t    prompt_chars: int\n    49\t    input_tokens: int\n    50\t    output_tokens: int\n    51\t    cost_usd: float\n    52\t    calls: int = 0\n    53\t    request_records: list = dataclasses.field(default_factory=list)\n    54\t\n    55\t\n    56\tdef candidate_state(c, evidence):\n    57\t    rungs = ' / '.join(f'{r[\"label\"]}: {r[\"condition\"]}' for r in c['rungs'])\n    58\t    fields = ', '.join(f'{f}={c[f]}' for f in ('measure', 'scope', 'period_start', 'period_end', 'basis', 'unit', 'event_type') if c.get(f) not in (None, '', 'n/a'))\n    59\t    own = ' | '.join(f'[{e[\"speaker\"]} {e[\"original_day\"]}] {e[\"quote\"][:400]}' for e in evidence if e['id'] in c.get('evidence_ids', []))[:1600]\n    60\t    return (f'CANDIDATE ({c[\"kind\"]}, object {c[\"object\"]}, focus \"{c[\"looks_at\"]}\", {c[\"year\"]}, due {c[\"due_day\"]}): {c[\"question\"]}\\n'\n    61\t            f'Key: {fields}\\nLadder: {rungs}\\nIts evidence: {own}')\n    62\t\n    63\t\n    64\tdef thesis_text(conn, view_id):\n    65\t    \"\"\"The thesis as the judge should see it: the card and the quotes that define it (its first two pieces in force).\"\"\"\n    66\t    pieces = store.evidence_in_force(conn, view_id)[:2]\n    67\t    quotes = ''.join(f'\\n    Evidence: [{p[\"speaker\"]} {p[\"original_day\"]}] {p[\"quote\"][:400]}' for p in pieces)\n    68\t    return matching.describe_view(conn, view_id, english=True) + quotes\n    69\t\n    70\t\n   115\t        return None\n   116\t    exact = store.exact_key_views(conn, c)\n   117\t    if exact:\n   118\t        return 'merge', exact[0]\n   119\t    earlier = []\n   120\t    for row in conn.execute('select k.view_id, k.period_end from view_keys k join views v using(view_id) where v.object_id=? and k.measure=? order by k.period_end desc',\n   121\t                            (c['object'], c['measure'])):\n   122\t        key = store.view_key(conn, row['view_id'])\n   123\t        if key and identity.is_shared(key) and can_succeed(conn, row['view_id'], key, c):\n   124\t            earlier.append(row['view_id'])\n   125\t    return ('succession', earlier[0]) if earlier else None\n   126\t\n   127\t\n   128\tdef succession_target(conn, c, listed):\n   129\t    \"\"\"The succession code decides alone: the same scope as well (a model-worded scope that differs goes to the judge).\"\"\"\n   130\t    if not c.get('measure') or not c.get('period_start'):\n   131\t        return None\n   132\t    for view_id in listed:\n   133\t        key = store.view_key(conn, view_id)\n   134\t        if key and _universe.scope_key(key.get('scope', '')) == _universe.scope_key(c.get('scope', '')) and can_succeed(conn, view_id, key, c):\n   135\t            return view_id\n   136\t    return None\n   137\t\n   138\t\n   139\tdef _summary(answer):\n   140\t    if answer['type'] == 'noul':\n   141\t        return f'{answer[\"noul\"]:.2f}'\n   142\t    top = max(answer['probabilities'].items(), key=lambda kv: kv[1])\n   143\t    return f'{top[0]} {top[1]:.2f}'\n   144\t\n   145\t\n   146\tdef _answers(archive, cfg, jobs, workers, transport):\n   147\t    \"\"\"Ask independent questions; equal concurrent requests share one archived result.\"\"\"\n   148\t    if not isinstance(workers, int) or isinstance(workers, bool) or workers < 1:\n   149\t        raise ValueError('Jev workers must be a positive integer')\n   150\t\n   151\t    def ask(job):\n   152\t        state, questions = job\n   153\t        return jev.ask(archive, cfg, cfg.matching, state, questions, 'match', transport=transport)\n   154\t\n   155\t    if workers == 1:\n   156\t        return [ask(job) if job[1] else None for job in jobs]\n   157\t    keys, unique, replies = [], {}, {}\n   158\t    for state, questions in jobs:\n   159\t        if not questions:\n   160\t            keys.append(None)\n   161\t            continue\n   162\t        _, key = model.request_identity(jev.request_for(cfg.matching, state, questions))\n   163\t        keys.append(key)\n   164\t        if key not in unique:\n   165\t            unique[key] = (state, copy.deepcopy(questions))\n   166\t    waiting, active = iter(unique.items()), {}\n   167\t    pool = concurrent.futures.ThreadPoolExecutor(max_workers=workers)\n   168\t    try:\n   169\t        def fill():\n   170\t            while len(active) < workers:\n   171\t                next_job = next(waiting, None)\n   172\t                if next_job is None:\n   173\t                    break\n   174\t                key, job = next_job\n   175\t                active[pool.submit(ask, job)] = key\n   176\t        fill()\n   177\t        while active:\n   178\t            concurrent.futures.wait(active, return_when=concurrent.futures.FIRST_COMPLETED)\n   179\t            completed = [future for future in active if future.done()]\n   180\t            # Check the whole completed set before submitting any replacement work.\n   181\t            for future in completed:\n   182\t                future.result()\n   183\t            for future in completed:\n   184\t                replies[active.pop(future)] = future.result()\n   185\t            fill()\n   186\t    finally:\n   187\t        for future in active:\n   188\t            future.cancel()\n   189\t        pool.shutdown(wait=True, cancel_futures=True)\n   190\t    results, used = [], set()\n   191\t    for key in keys:\n   192\t        if key is None:\n   193\t            results.append(None)\n   194\t            continue\n   195\t        answer = replies[key]\n   196\t        # A later logical use is exactly what a serial archive lookup would return.\n   197\t        results.append(dataclasses.replace(answer, cached=True, cost_usd=0.0) if key in used else answer)\n   198\t        used.add(key)\n   199\t    return results\n   200\t\n   201\t\n   202\tdef collision_peers(conn, c, listed):\n   203\t    \"\"\"The listed theses of the candidate's own object and measure: where one question may be held twice under other words.\"\"\"\n   204\t    peers = []\n   205\t    for v in listed:\n   206\t        key = store.view_key(conn, v) if c.get('measure') else None\n   207\t        if key and key.get('measure') == c.get('measure') and (store.view(conn, v) or {}).get('object_id') == c['object']:\n   208\t            peers.append(v)\n   209\t    return peers\n   210\t\n   211\t\n   212\tdef ask_collision_judge(archive, cfg, conn, state, peers, llm_transport):\n   213\t    \"\"\"One generative call: the candidate's state and the peers' thesis texts; returns {thesis_id: relation}.\"\"\"\n   214\t    with open(config.prompt_path(cfg.collision.prompt_version + '.txt'), encoding='utf-8') as handle:\n   215\t        system = handle.read()\n   216\t    user = state + '\\n\\nTHESES:\\n' + '\\n'.join(f'--- {v}\\n{thesis_text(conn, v)}' for v in peers) + '\\n\\nFor each thesis id, state the relation.'\n   217\t    answer = model.call(archive, cfg, cfg.collision, system, user, COLLISION_SCHEMA, 'collision', 'match', transport=llm_transport)\n   218\t    return answer, {r['thesis_id']: r['relation'] for r in answer.data['relations'] if r['thesis_id'] in peers}\n   219\t\n   220\t\n   221\tdef decide(archive, cfg, conn, item, candidates, evidence, lists, shown_views, *, extra_views=(), retry_note='', transport=None, llm_transport=None, workers=1):\n   222\t    data = {'candidates': [], 'evidence': []}\n   223\t    total = Decision(data, 0, '', True, 0, 0, 0, 0.0)\n   224\t    shas = []\n   225\t    jobs, candidate_jobs, evidence_jobs = [], [], []\n   226\t    # All database reads and request construction stay on the coordinator thread.\n   227\t    for c in candidates:\n   228\t        listed = list(dict.fromkeys(list(lists.candidate_lists.get(c['id'], [])) + [v['view_id'] for v in shown_views]))\n   229\t        fixed = shared_quantity_target(conn, c)                       # D197: code decides a shared quantity's destination; Jev is not asked its relations\n   230\t        questions = {} if fixed else {f'rel__{v}': relation_question(thesis_text(conn, v)) for v in listed}\n   262\t    for c, listed, groups, job_index, fixed in candidate_jobs:\n   263\t        answers = answers_for(job_index) if job_index is not None else {}\n   264\t        joined = [g['group_id'] for g in groups if answers[f'member__{g[\"group_id\"]}']['noul'] >= THRESHOLD]\n   265\t        for group_id in joined:\n   266\t            if group_id not in (c.get('group_refs') or []) and group_id not in (c.get('jev_group_refs') or []):\n   267\t                c.setdefault('jev_group_refs', []).append(group_id)          # the writer records these with basis 'jev'\n   268\t        if fixed:                                                # D197: one aggregate per theme, measure and period; the wording is not identity\n   269\t            data['candidates'].append({'id': c['id'], 'outcome': fixed[0], 'target_view_id': fixed[1], 'dependencies': [],\n   270\t                                       'reason': f'shared quantity: {fixed[0]} by key (D197); groups joined: {joined or \"none\"}'})\n   271\t            continue\n   272\t        same = sorted(((answers[f'rel__{v}']['probabilities']['same_quantity_or_event'], v) for v in listed\n   273\t                       if answers[f'rel__{v}']['choice'] == 'same_quantity_or_event' and answers[f'rel__{v}']['probabilities']['same_quantity_or_event'] >= THRESHOLD),\n   274\t                      reverse=True)\n   275\t        reasons = '; '.join(f'{qid[5:]}: {_summary(a)}' for qid, a in answers.items() if qid.startswith('rel__'))\n   276\t        outcome, target = 'new', ''\n   277\t        for _, v in same:\n   278\t            # the key decides what 'the same' may mean: a different quantity is declined here; the same quantity for a later period is a\n   279\t            # succession (06-views), when the thesis has no successor yet; otherwise a merge into an open thesis\n   280\t            key = store.view_key(conn, v) if c.get('measure') else None\n   281\t            if key and identity.conflicts(key, c, merging=False):\n   282\t                continue\n   283\t            if key and identity.conflicts(key, c, merging=True):          # the same quantity for another period\n   284\t                if can_succeed(conn, v, key, c):\n   285\t                    outcome, target = 'succession', v\n   286\t                    break\n   287\t                continue\n   288\t            if store.is_open(conn, v):\n   289\t                outcome, target = 'merge', v\n   290\t                break\n   291\t        if outcome == 'new':\n   292\t            # the judge says 'the same quantity for another period'; code decides the direction, the typed fields and the successor\n   293\t            other = sorted(((answers[f'rel__{v}']['probabilities']['same_quantity_other_period'], v) for v in listed\n   294\t                            if answers[f'rel__{v}']['choice'] == 'same_quantity_other_period' and answers[f'rel__{v}']['probabilities']['same_quantity_other_period'] >= THRESHOLD),\n   295\t                           reverse=True)\n   296\t            for _, v in other:\n   297\t                key = store.view_key(conn, v) if c.get('measure') else None\n   298\t                if event_home(conn, v, key, c):\n   299\t                    outcome, target = 'merge', v\n   300\t                    break\n   301\t                if can_succeed(conn, v, key, c):\n   302\t                    outcome, target = 'succession', v\n   303\t                    break\n   304\t        if outcome == 'new':\n   305\t            # D258 (R2-e, D248 items 1 and 6): a candidate that asks about a component, instance or subset of an open question is filed\n   306\t            # under it; the part is evidence of the card, not a card of its own. The typed fields still decide (a signing question never\n   307\t            # merges into an amount), and the collision judge below may keep a component apart under its rule.\n   308\t            parts = sorted(((answers[f'rel__{v}']['probabilities']['part_of'], v) for v in listed\n   309\t                            if answers[f'rel__{v}']['choice'] == 'part_of' and answers[f'rel__{v}']['probabilities']['part_of'] >= THRESHOLD),\n   310\t                           reverse=True)\n   311\t            for _, v in parts:\n   312\t                key = store.view_key(conn, v) if c.get('measure') else None\n   313\t                if key and identity.conflicts(key, c, merging=False):\n   314\t                    continue\n   315\t                if store.is_open(conn, v):\n   316\t                    outcome, target = 'merge', v\n   317\t                    break\n   318\t        if outcome == 'new':\n   319\t            successor_of = succession_target(conn, c, listed)\n   320\t            if successor_of:\n   321\t                outcome, target = ('merge' if event_home(conn, successor_of, store.view_key(conn, successor_of), c) else 'succession'), successor_of\n   322\t        peers = collision_peers(conn, c, listed) if getattr(cfg, 'collision', None) else []\n   323\t        judged = ''\n   324\t        if peers:\n   325\t            answer, verdicts = ask_collision_judge(archive, cfg, conn, candidate_state(c, evidence), peers, llm_transport)\n   326\t            total.cost_usd += answer.cost_usd\n   327\t            total.input_tokens += answer.input_tokens\n   328\t            total.output_tokens += answer.output_tokens\n   329\t            total.calls += 1\n   330\t            total.cached = total.cached and answer.cached\n   331\t            shas.append(answer.request_sha256)\n   332\t            total.request_records.append({'call_id': answer.call_id, 'request_sha256': answer.request_sha256})\n   333\t            judged = '; collision judge: ' + ', '.join(f'{v}: {verdicts.get(v, \"(no answer)\")}' for v in peers)\n   334\t            if target in peers and verdicts.get(target) not in ('same_question', 'same_question_other_period'):\n   335\t                outcome, target = 'new', ''                      # Jev's merge or succession on a peer the judge keeps apart\n   336\t            if outcome == 'new':\n   337\t                for v in peers:\n   338\t                    key = store.view_key(conn, v)\n   339\t                    if verdicts.get(v) == 'same_question' and not identity.conflicts(key, c, merging=False):\n   340\t                        if identity.conflicts(key, c, merging=True):\n   341\t                            if can_succeed(conn, v, key, c):\n   342\t                                outcome, target = 'succession', v\n   343\t                                break\n   344\t                            continue\n   345\t                        if store.is_open(conn, v):\n   346\t                            outcome, target = 'merge', v\n   347\t                            break\n   348\t                    if verdicts.get(v) == 'same_question_other_period' and can_succeed(conn, v, key, c):\n   349\t                        outcome, target = 'succession', v\n   350\t                        break\n   351\t        data['candidates'].append({'id': c['id'], 'outcome': outcome, 'target_view_id': target or '', 'dependencies': [],\n   352\t                                   'reason': f'jev: {reasons or \"no list\"}; groups joined: {joined or \"none\"}{judged}'})\n   353\t    for e, pairs, said_day, job_index in evidence_jobs:\n   354\t        answers = answers_for(job_index)\n   355\t        for _, v in pairs:\n   356\t            scored = [(answers[f'piece__{v}__{x}'], x) for x in lists.evidence_lists[(e['id'], v)]]\n   357\t            repeats = sorted(((a['probabilities']['same_statement'], x) for a, x in scored if a['choice'] == 'same_statement' and a['probabilities']['same_statement'] >= THRESHOLD), reverse=True)\n   358\t            replaces = sorted(((a['probabilities']['supersedes'], x) for a, x in scored if a['choice'] == 'supersedes' and a['probabilities']['supersedes'] >= THRESHOLD), reverse=True)\n   359\t            outcome, target = ('repeat', repeats[0][1]) if repeats else ('replace', replaces[0][1]) if replaces else ('new', '')\n   360\t            data['evidence'].append({'id': e['id'], 'view_id': v, 'outcome': outcome, 'target_evidence_id': target or '', 'said_day': said_day,\n   361\t                                     'reason': 'jev: ' + '; '.join(f'{x}: {_summary(a)}' for a, x in scored)})\n   362\t    total.request_sha256 = hashlib.sha256('+'.join(shas).encode('utf-8')).hexdigest() if shas else ''\n   363\t    return total\n    74\tdef batch_plan(candidates, outcomes):\n    75\t    \"\"\"Resolve same-answer duplicates and validate dependencies on the resulting identities before retry ends.\"\"\"\n    76\t    aliases, first_by_key, errors = {}, {}, []\n    77\t    for candidate in candidates:\n    78\t        cid = candidate['id']\n    79\t        outcome = outcomes.get(cid, ('skip', None, []))\n    80\t        if outcome[0] not in ('new', 'succession'):\n    81\t            continue\n    82\t        key = automatic_key(candidate)\n    83\t        first = first_by_key.setdefault(key, cid) if key is not None else cid\n    84\t        aliases[cid] = first\n    85\t        if outcome[:2] != outcomes[first][:2]:\n    86\t            errors.append(f'candidate {cid}: same-key succession conflicts with {first}')\n    87\t    graph, directions = {}, {}\n    88\t    for cid, first in aliases.items():\n    89\t        for dep in outcomes[cid][2]:\n    90\t            target = aliases.get(dep['view_id'], dep['view_id'])\n    91\t            chain = aliases.get(dep['wait_chain_view_id'], dep['wait_chain_view_id'])\n    92\t            edge = (first, target, chain, dep['wait_year'])\n    93\t            if edge in directions and directions[edge] != dep['direction']:\n    94\t                errors.append(f'candidate {cid}: same-key dependency direction conflicts')\n    95\t            directions[edge] = dep['direction']\n    96\t            if target:\n    97\t                graph.setdefault(first, set()).add(target)\n    98\t    for cid in graph:\n    99\t        stack, seen = list(graph[cid]), set()\n   100\t        while stack:\n   101\t            target = stack.pop()\n   102\t            if target == cid:\n   103\t                errors.append(f'candidate {cid}: coalesced dependencies lead back to itself')\n   104\t                break\n   105\t            if target not in seen:\n   106\t                seen.add(target)\n   107\t                stack.extend(graph.get(target, ()))\n   108\t    return aliases, errors\n    52\t# Jev reports each probability rounded to two decimals independently of the choice it made on the unrounded values, so the\n    53\t# chosen option may print one unit below another (0.47 against 0.48; 1 of 2,353 archived choice answers on 2026-10-25).\n    54\tROUNDING = 0.01\n    55\t\n    56\t\n    57\tdef validate(answers, questions):\n    58\t    \"\"\"The answers of a response against the request's questions; a list of problems.\"\"\"\n    59\t    problems = []\n    60\t    if not isinstance(answers, dict) or set(answers) != set(questions):\n    61\t        return ['answer set differs from the questions asked']\n    62\t    for qid, question in questions.items():\n    63\t        answer = answers[qid]\n    64\t        if not isinstance(answer, dict) or answer.get('type') != question['type']:\n    65\t            problems.append(f'{qid}: answer type mismatch')\n    66\t            continue\n    67\t        if question['type'] == 'noul':\n    68\t            if not isinstance(answer.get('noul'), (int, float)) or not 0 <= answer['noul'] <= 1:\n    69\t                problems.append(f'{qid}: noul out of range')\n    70\t        elif question['type'] == 'choice':\n    71\t            probabilities = answer.get('probabilities')\n    72\t            if answer.get('choice') not in question['criteria'] or not isinstance(probabilities, dict) or set(probabilities) != set(question['criteria']):\n    73\t                problems.append(f'{qid}: choice or probabilities do not match the criteria')\n    74\t            elif any(not isinstance(v, (int, float)) or isinstance(v, bool) or not 0 <= v <= 1 for v in probabilities.values()) \\\n    75\t                    or abs(sum(probabilities.values()) - 1) > 0.005 * len(probabilities) + 1e-9:\n    76\t                problems.append(f'{qid}: probabilities are not a distribution')\n    77\t            elif probabilities[answer['choice']] < max(probabilities.values()) - ROUNDING - 1e-9:\n    78\t                problems.append(f'{qid}: choice is not the most probable option')\n    79\t    return problems\n    80\t\n    81\t\n    82\tdef request_for(setting, state, questions):\n    83\t    \"\"\"The complete Jev request used both for dispatch and in-flight identity.\"\"\"\n    84\t    return {'model': setting.model, 'state': state, 'questions': questions}\n    85\t\n    86\t\n    87\tdef ask(archive, cfg, setting, state, questions, purpose, *, transport=None):\n    88\t    \"\"\"One Jev request, archived; returns model.Answer whose data is the `answers` map.\"\"\"\n    89\t    request = request_for(setting, state, questions)\n    90\t    request_json, sha = model.request_identity(request)\n    91\t    prompt_chars = len(request_json)\n    92\t    hit = archive.lookup(sha)\n    93\t    if hit:\n    94\t        call_id, answer_json, _, input_tokens, output_tokens = hit\n    95\t        return model.Answer(json.loads(answer_json), call_id, sha, True, prompt_chars, input_tokens or 0, output_tokens or 0, 0.0)\n    96\t    started = time.time()\n    97\t    response = (transport or globals()['transport'])(request)\n    98\t    seconds = round(time.time() - started, 2)\n    99\t    answers = response.get('answers') if isinstance(response, dict) else None\n   100\t    problems = validate(answers, questions)\n   101\t    usage = response.get('usage') or {} if isinstance(response, dict) else {}\n   102\t    input_tokens, output_tokens = int(usage.get('input_tokens') or 0), int(usage.get('output_tokens') or 0)\n   103\t    price_in, _ = model.PRICES.get(setting.model, (0.0, 0.0))\n   104\t    cost = round(input_tokens / 1e6 * price_in, 6)\n   105\t    call_id = archive.record(purpose=purpose, config_version=cfg.version, config_checksum=cfg.checksum, model=setting.model,\n   106\t                             request_sha256=sha if not problems else sha + ':schema:' + uuid.uuid4().hex[:8], request_json=request_json,\n   107\t                             response_json=json.dumps(response, ensure_ascii=False)[:200000], answer_json=json.dumps(answers, ensure_ascii=False) if answers is not None else None,\n   108\t                             prompt_chars=prompt_chars, input_tokens=input_tokens, output_tokens=output_tokens, cost_usd=cost,\n   109\t                             seconds=seconds, created_at=time.strftime('%Y-%m-%dT%H:%M:%S'))\n   110\t    if problems:\n   111\t        raise model.SchemaError('; '.join(problems[:5]))\n   112\t    return model.Answer(answers, call_id, sha, False, prompt_chars, input_tokens, output_tokens, cost)\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba src/hivemind/views/matching.py | sed -n '255,392p'\nnl -ba src/hivemind/views/writing.py | sed -n '49,66p;112,156p;175,205p'\nnl -ba src/hivemind/views/store.py | sed -n '13,98p;126,150p;214,277p'\nnl -ba scripts/show_views.py | sed -n '8,45p'\"","aggregated_output":"   255\t    answer = model.call(archive, cfg, cfg.matching, system, user, schema_for(cfg.matching.prompt_version), 'matching', 'match', transport=transport)\n   256\t    return answer\n   257\t\n   258\t\n   259\t@dataclasses.dataclass\n   260\tclass Checked:\n   261\t    outcomes: dict         # candidate id -> (outcome, target or None, dependencies list)\n   262\t    evidence: dict         # (evidence id, view_id) -> (outcome, target_evidence_id or None, said_day)\n   263\t    refusals: list\n   264\t    not_opened: dict       # candidate id -> reason\n   265\t    notes: list = dataclasses.field(default_factory=list)\n   266\t\n   267\t\n   268\tdef check(conn, universe, decisions, candidates, evidence, lists, shown_views):\n   269\t    decisions = vocabulary.matching_answer(decisions)\n   270\t    candidates = [vocabulary.candidate(c) for c in candidates]\n   271\t    shown_ids = {v['view_id'] for v in shown_views}\n   272\t    candidate_by_id = {c['id']: c for c in candidates}\n   273\t    # D51: a dependency is chosen among the views the model has in front of it: every list shown in this call,\n   274\t    # the views shown at extraction, and the candidates this answer opens\n   275\t    listed_all = set(shown_ids)\n   276\t    for hits in lists.candidate_lists.values():\n   277\t        listed_all.update(hits)\n   278\t    refusals, outcomes, not_opened, notes = [], {}, {}, []\n   279\t    raw_deps = {}\n   280\t    succession_targets = {}\n   281\t    answered = {d['id']: d for d in decisions.get('candidates', [])}\n   282\t    for c in candidates:\n   283\t        d = answered.get(c['id'])\n   284\t        if not d:\n   285\t            refusals.append(f'candidate {c[\"id\"]} has no decision')\n   286\t            continue\n   287\t        outcome, target = d['outcome'], d['target_view_id'].strip()\n   288\t        listed = set(lists.candidate_lists.get(c['id'], [])) | shown_ids\n   289\t        if outcome in ('merge', 'succession') and target in candidate_by_id:\n   290\t            # a candidate cannot merge into another candidate of the same answer: only a stored thesis has a ladder and a due day to\n   291\t            # inherit. The model usually means \"part of\": both open, and the key coalesces them when they are the same quantity.\n   292\t            notes.append(f'candidate {c[\"id\"]}: {outcome} into candidate {target} is not a destination; opened as a new view')\n   293\t            outcome, target = 'new', ''\n   294\t            d = dict(d, outcome=outcome, target_view_id='')\n   295\t        if outcome in ('merge', 'succession') and c.get('measure'):\n   296\t            # keyed-views-plan.md 2.5 rule 1: a different quantity, or another period, is never the same view, whatever the model says\n   297\t            target_key = store.view_key(conn, target) if target else None\n   298\t            target_view = store.view(conn, target) if target else None\n   299\t            if target_view and target_view['object_id'] != c['object']:\n   300\t                notes.append(f'candidate {c[\"id\"]}: {outcome} into {target} refused: another object ({target_view[\"object_id\"]} ≠ {c[\"object\"]}); opened as a new view')\n   301\t                outcome, target, target_key = 'new', '', None\n   302\t                d = dict(d, outcome=outcome, target_view_id='')\n   303\t            if target_key and identity.conflicts(target_key, c, merging=outcome == 'merge'):\n   304\t                notes.append(f'candidate {c[\"id\"]}: {outcome} into {target} refused by key ({target_key[\"measure\"]}[{target_key[\"scope\"]}] {target_key[\"period_start\"]}..{target_key[\"period_end\"]} ≠ {c[\"measure\"]}[{c.get(\"scope\", \"\")}] {c.get(\"period_start\", \"\")}..{c.get(\"period_end\", \"\")}); opened as a new view')\n   305\t                outcome, target = 'new', ''\n   306\t                d = dict(d, outcome=outcome, target_view_id='')\n   307\t        if outcome == 'new' and identity.automatic_key(c) is not None:\n   308\t            # rule 2 for a key code owns entirely: one open view with the same key and period is the same quantity; the model is not asked twice\n   309\t            twins = [v for v in lists.candidate_lists.get(c['id'], []) if _same_key(store.view_key(conn, v), c, (store.view(conn, v) or {}).get('object_id')) and store.is_open(conn, v)]\n   310\t            if len(twins) == 1:\n   311\t                notes.append(f'candidate {c[\"id\"]}: opened as new by the model, merged into {twins[0]} by its key ({c[\"measure\"]}[{c.get(\"scope\", \"\")}] {c.get(\"period_start\", \"\")}..{c.get(\"period_end\", \"\")})')\n   312\t                outcome, target = 'merge', twins[0]\n   313\t                d = dict(d, outcome=outcome, target_view_id=target)\n   314\t        if outcome in ('merge', 'succession'):\n   315\t            if target not in listed:\n   316\t                refusals.append(f'candidate {c[\"id\"]}: target {target!r} not in its list')\n   317\t                continue\n   318\t            if outcome == 'merge' and not store.is_open(conn, target):\n   319\t                refusals.append(f'candidate {c[\"id\"]}: cannot attach to closed view {target}')\n   320\t                continue\n   321\t            if outcome == 'succession':\n   322\t                if conn.execute('select 1 from successions where succeeds=?', (target,)).fetchone():\n   323\t                    refusals.append(f'candidate {c[\"id\"]}: {target} already has a successor')\n   324\t                    continue\n   325\t                first = succession_targets.get(target)\n   326\t                if first is not None and (identity.automatic_key(c) is None or identity.automatic_key(c) != identity.automatic_key(first)):\n   327\t                    refusals.append(f'candidate {c[\"id\"]}: {target} can have one successor; {first[\"id\"]} already succeeds it in this answer')\n   328\t                    continue\n   329\t                succession_targets.setdefault(target, c)             # a second wording with the same code-owned key is the same successor (coalesced by batch_plan)\n   330\t                # 06-views: a successor keeps the predecessor's direction; the writer stores a numeric ladder in that direction (the first\n   331\t                # real succession, 2027 hyperscaler capex after 2026, came low-to-high where its predecessor ran high-to-low), so no refusal here\n   332\t        if outcome in ('new', 'succession'):\n   333\t            object_id = universe.resolve(c['object'])\n   334\t            if not object_id:\n   335\t                not_opened[c['id']] = f'object {c[\"object\"]!r} not on the research list'\n   336\t                if c['kind'] == 'theme':\n   337\t                    store.pool(conn, 'suggested_theme', c['object'], {'question': c['question'], 'input_id': None}, 0)\n   338\t                outcomes[c['id']] = ('skip', None, [])\n   339\t                continue\n   340\t            outcomes[c['id']] = (outcome, target or None, [])\n   341\t            raw_deps[c['id']] = d.get('dependencies', [])\n   342\t        elif outcome == 'merge':\n   343\t            outcomes[c['id']] = (outcome, target, [])\n   344\t        else:\n   345\t            outcomes[c['id']] = ('skip', None, [])\n   346\t            not_opened[c['id']] = d.get('reason', '')\n   347\t    # dependencies, once every candidate's outcome is known\n   348\t    opened = {cid for cid, (outcome, _, _) in outcomes.items() if outcome in ('new', 'succession')}\n   349\t    for cid, dependencies in raw_deps.items():\n   350\t        deps = []\n   351\t        bad = False\n   352\t        for dep in dependencies:\n   353\t            view_id, chain, year = dep['view_id'].strip(), dep['wait_chain_view_id'].strip(), dep['wait_year'].strip()\n   354\t            if view_id:\n   355\t                if view_id in candidate_by_id and view_id not in opened:\n   356\t                    refusals.append(f'candidate {cid}: dependency {view_id} is a candidate that is not opened')\n   357\t                    bad = True\n   358\t                    break\n   359\t                if view_id not in listed_all and view_id not in candidate_by_id:\n   360\t                    refusals.append(f'candidate {cid}: dependency {view_id} was not shown')\n   361\t                    bad = True\n   362\t                    break\n   363\t                if view_id == cid:\n   364\t                    refusals.append(f'candidate {cid}: depends on itself')\n   365\t                    bad = True\n   366\t                    break\n   367\t                deps.append({'view_id': view_id, 'wait_chain_view_id': None, 'wait_year': None, 'direction': dep['direction']})\n   368\t            elif chain and year:\n   369\t                if chain not in listed_all and chain not in candidate_by_id:\n   370\t                    refusals.append(f'candidate {cid}: waited chain {chain} was not shown')\n   371\t                    bad = True\n   372\t                    break\n   373\t                deps.append({'view_id': None, 'wait_chain_view_id': chain, 'wait_year': year, 'direction': dep['direction']})\n   374\t        if bad:\n   375\t            continue\n   376\t        outcomes[cid] = (outcomes[cid][0], outcomes[cid][1], deps)\n   377\t    # no cycle among the candidates of one answer (06-views: 会的话这条不收，退回给模型改)\n   378\t    graph = {cid: [d['view_id'] for d in outcomes[cid][2] if d['view_id'] in candidate_by_id] for cid in raw_deps if cid in outcomes}\n   379\t    for cid in graph:\n   380\t        stack, seen = list(graph[cid]), set()\n   381\t        while stack:\n   382\t            current = stack.pop()\n   383\t            if current == cid:\n   384\t                refusals.append(f'candidate {cid}: its dependencies lead back to itself')\n   385\t                break\n   386\t            if current in seen:\n   387\t                continue\n   388\t            seen.add(current)\n   389\t            stack.extend(graph.get(current, []))\n   390\t    _, coalescing_errors = identity.batch_plan(candidates, outcomes)\n   391\t    refusals.extend(coalescing_errors)\n   392\t    evidence_out = {}\n    49\tdef resolve_waiting(conn, new_view_id, seq, changed):\n    50\t    \"\"\"A new view on a chain satisfies dependencies waiting for its year on that chain.\"\"\"\n    51\t    v = store.view(conn, new_view_id)\n    52\t    chain = {new_view_id}\n    53\t    frontier = [new_view_id]\n    54\t    while frontier:\n    55\t        current = frontier.pop()\n    56\t        for row in conn.execute('select succeeds from successions where view_id=?', (current,)):\n    57\t            if row['succeeds'] not in chain:\n    58\t                chain.add(row['succeeds'])\n    59\t                frontier.append(row['succeeds'])\n    60\t    for dep in conn.execute('select * from dependencies where wait_year=? and wait_chain_view_id is not null', (v['year'],)):\n    61\t        if dep['wait_chain_view_id'] in chain:\n    62\t            already = conn.execute('select 1 from dependency_resolutions where dependency_id=?', (dep['dependency_id'],)).fetchone()\n    63\t            if not already and not store.would_cycle(conn, dep['view_id'], new_view_id):\n    64\t                store.insert(conn, 'dependency_resolutions', dependency_id=dep['dependency_id'], resolved_to=new_view_id, reason='created', seq=seq)\n    65\t                changed.add(dep['view_id'])\n    66\t\n   112\tdef write(conn, universe, seq, item, handover, checked, second_pass):\n   113\t    \"\"\"Write atomically within the caller's transaction; the caller commits the completion marker with it.\"\"\"\n   114\t    if not conn.in_transaction:\n   115\t        conn.execute('begin immediate')\n   116\t    conn.execute('savepoint view_write')\n   117\t    try:\n   118\t        store.ensure_writable_columns(conn)\n   119\t        result = _write(conn, universe, seq, item, handover, checked, second_pass)\n   120\t    except Exception:\n   121\t        conn.execute('rollback to view_write')\n   122\t        conn.execute('release view_write')\n   123\t        raise\n   124\t    conn.execute('release view_write')\n   125\t    return result\n   126\t\n   127\t\n   128\tdef _write(conn, universe, seq, item, handover, checked, second_pass):\n   129\t    \"\"\"second_pass: {(handover evidence id, view_id): (outcome, target_evidence_id, said_day)} for candidate-linked\n   130\t    evidence compared after the candidates' destinations were known (new views' evidence is simply new).\"\"\"\n   131\t    changed, notes, new_views, evidence_ids = set(), [], {}, {}\n   132\t    candidate_ids = {c['id'] for c in handover.candidates}\n   133\t    aliases, problems = identity.batch_plan(handover.candidates, checked.outcomes)\n   134\t    if problems:\n   135\t        raise WriteConflict('; '.join(problems))\n   136\t    created = {}\n   137\t    # 1. new views, themes first\n   138\t    order = sorted(handover.candidates, key=lambda c: 0 if c['kind'] == 'theme' else 1)\n   139\t    for c in order:\n   140\t        outcome, target, deps = checked.outcomes.get(c['id'], ('skip', None, []))\n   141\t        if outcome not in ('new', 'succession'):\n   142\t            continue\n   143\t        canonical = aliases[c['id']]\n   144\t        if canonical in created:\n   145\t            new_views[c['id']] = created[canonical]\n   146\t            continue\n   147\t        if store.exact_key_views(conn, c):\n   148\t            raise WriteConflict(f'candidate {c[\"id\"]}: existing exact identity requires matching')\n   149\t        object_id = universe.resolve(c['object'])\n   150\t        if outcome == 'succession' and target:\n   151\t            c = oriented_like(c, store.rungs_of(conn, target), notes)\n   152\t        view_id = _create_view(conn, c, object_id, universe.kind(object_id), seq, item, universe)\n   153\t        new_views[c['id']] = view_id\n   154\t        created[canonical] = view_id\n   155\t        if outcome == 'succession' and target:\n   156\t            store.insert(conn, 'successions', view_id=view_id, succeeds=target, seq=seq)\n   175\t    # 2. dependencies of the new views (candidate ids resolve to the views just created)\n   176\t    dependencies_written = set()\n   177\t    for c in order:\n   178\t        outcome, target, deps = checked.outcomes.get(c['id'], ('skip', None, []))\n   179\t        if c['id'] not in new_views:\n   180\t            continue\n   181\t        view_id = new_views[c['id']]\n   182\t        for dep in deps:\n   183\t            depends_on = dep['view_id']\n   184\t            if depends_on in new_views:\n   185\t                depends_on = new_views[depends_on]\n   186\t            elif depends_on in candidate_ids:\n   187\t                notes.append(f'dependency {view_id} -> candidate {depends_on} dropped: that candidate was not opened')\n   188\t                continue\n   189\t            if depends_on and store.would_cycle(conn, view_id, depends_on):\n   190\t                notes.append(f'dependency {view_id} -> {depends_on} dropped: cycle')\n   191\t                continue\n   192\t            chain = dep['wait_chain_view_id']\n   193\t            if chain in new_views:\n   194\t                chain = new_views[chain]\n   195\t            wait_year = dep['wait_year']\n   196\t            if wait_year and chain and hasattr(universe, 'canonical_year'):          # the chain's object decides the spelling (FY2027 or 2026)\n   197\t                chain_view = store.view(conn, chain)\n   198\t                wait_year = universe.canonical_year(chain_view['object_id'] if chain_view else object_id_of(universe, c), wait_year)\n   199\t            edge = (view_id, depends_on, chain, wait_year, dep['direction'])\n   200\t            if edge in dependencies_written:\n   201\t                continue\n   202\t            dependencies_written.add(edge)\n   203\t            store.insert(conn, 'dependencies', view_id=view_id, depends_on=depends_on, wait_chain_view_id=chain, wait_year=wait_year,\n   204\t                         direction=dep['direction'], seq=seq)\n   205\t        resolve_waiting(conn, view_id, seq, changed)\n    13\tTABLES = {\n    14\t    'views': 'view_id text primary key, object_id text, object_kind text, kind text, looks_at text, question text, due_day text, year text, created_seq integer, created_from_input text, created_at text',\n    15\t    'rungs': 'view_id text, position integer, label text, condition text, lo real, hi real',\n    16\t    'view_keys': 'view_id text primary key, measure text, scope text, scope_key text, period_start text, period_end text, basis text, unit text, event_type text, seq integer, scope_source text, key_version integer',\n    17\t    'view_switches': 'id integer primary key autoincrement, view_id text, open integer, reason text, by_whom text, after_seq integer',\n    18\t    'judgements': 'judgement_id integer primary key autoincrement, view_id text, seq integer, input_id text, rung integer, reasons text, cited_evidence_json text, cited_views_json text, pushes_json text, changed integer, why_changed text, config_checksum text, call_id integer, request_sha256 text, publication_day text, theme_pushes_json text, reference text, implied_outcome text',\n    19\t    'evidence': 'evidence_id text primary key, quote text, one_line text, speaker text, original_who text, original_day text, tier text, event_time text, created_seq integer, created_from_input text',\n    20\t    'evidence_sources': 'id integer primary key autoincrement, evidence_id text, input_id text, category text, publication_day text, location text, seq integer',\n    21\t    'evidence_links': 'id integer primary key autoincrement, evidence_id text, view_id text, seq integer',\n    22\t    'replacements': 'id integer primary key autoincrement, old_evidence_id text, new_evidence_id text, said_day text, seq integer',   # history: written before D202, read as before\n    23\t    'revisions': 'id integer primary key autoincrement, old_evidence_id text, new_evidence_id text, said_day text, seq integer',      # D202: the new piece revises the old; both stay in force\n    24\t    'same_claims': 'id integer primary key autoincrement, old_evidence_id text, new_evidence_id text, seq integer',                    # D204: the matcher read the new piece as the same claim as the old; both stored, both in force\n    25\t    'dependencies': 'dependency_id integer primary key autoincrement, view_id text, depends_on text, wait_chain_view_id text, wait_year text, direction text, seq integer',\n    26\t    'dependency_resolutions': 'id integer primary key autoincrement, dependency_id integer, resolved_to text, reason text, seq integer',\n    27\t    'successions': 'id integer primary key autoincrement, view_id text, succeeds text, seq integer',\n    28\t    'handovers': 'id integer primary key autoincrement, input_id text, seq integer, handover_json text',\n    29\t    'match_records': 'id integer primary key autoincrement, seq integer, input_id text, call_no integer, shown_json text, request_sha256 text, call_id integer, decisions_json text, checks_json text, written_json text',\n    30\t    'processing_steps': 'id integer primary key autoincrement, input_id text, sequence_no integer, step text, result text, reason text, publication_day text, at text',\n    31\t    'review_pool_entries': 'id integer primary key autoincrement, kind text, key text, example_json text, seq integer',\n    32\t    'late_statements': 'id integer primary key autoincrement, input_id text, evidence_quote text, reason text, seq integer',\n    33\t    'days_completed': 'id integer primary key autoincrement, day text, seq integer, at text',\n    34\t    # D149 research groups: an ongoing business subject several distinct theses belong to; membership is decided by extraction and written with the thesis\n    35\t    'thesis_groups': 'group_id text primary key, name text, scope text, aliases text, created_seq integer, created_from_input text',\n    36\t    'thesis_group_members': 'id integer primary key autoincrement, group_id text, view_id text, seq integer, input_id text, basis text',\n    37\t    # D166 (2026-11-01): the names a later declaration gives a stored group, appended once each; a group's aliases are its creation's plus these\n    38\t    'thesis_group_aliases': 'id integer primary key autoincrement, group_id text, alias text, seq integer, input_id text',\n    39\t}\n    40\t\n    41\tINDEXES = [\n    42\t    'create index if not exists views_object on views(object_id)',\n    43\t    'create index if not exists judgements_view on judgements(view_id, judgement_id)',\n    44\t    # 06-views step 7: a view is judged once per round (one item = one sequence number)\n    45\t    'create unique index if not exists judgements_once_per_round on judgements(view_id, seq)',\n    46\t    'create index if not exists links_view on evidence_links(view_id)',\n    47\t    'create index if not exists links_evidence on evidence_links(evidence_id)',\n    48\t    'create index if not exists sources_evidence on evidence_sources(evidence_id)',\n    49\t    'create index if not exists steps_input on processing_steps(input_id, id)',\n    50\t    'create index if not exists switches_view on view_switches(view_id, id)',\n    51\t    'create index if not exists deps_view on dependencies(view_id)',\n    52\t]\n    53\t\n    54\t\n    55\tdef open_db(path):\n    56\t    os.makedirs(os.path.dirname(os.path.abspath(path)), exist_ok=True)\n    57\t    conn = sqlite3.connect(path)\n    58\t    conn.row_factory = sqlite3.Row\n    59\t    for name, columns in TABLES.items():\n    60\t        conn.execute(f'create table if not exists {name} ({columns})')\n    61\t        conn.execute(f\"create trigger if not exists {name}_no_update before update on {name} begin select raise(abort, 'append-only'); end\")\n    62\t        conn.execute(f\"create trigger if not exists {name}_no_delete before delete on {name} begin select raise(abort, 'append-only'); end\")\n    63\t    for statement in INDEXES:\n    64\t        conn.execute(statement)\n    65\t    ensure_writable_columns(conn)\n    66\t    conn.execute(\"create virtual table if not exists views_fts using fts5(view_id unindexed, text, tokenize='trigram')\")\n    67\t    conn.execute(\"create virtual table if not exists groups_fts using fts5(group_id unindexed, text, tokenize='trigram')\")\n    68\t    conn.execute('create index if not exists members_view on thesis_group_members(view_id)')\n    69\t    conn.commit()\n    70\t    return conn\n    71\t\n    72\t\n    73\tdef insert(conn, table, **fields):\n    74\t    columns = list(fields)\n    75\t    cursor = conn.execute(f'insert into {table} ({\",\".join(columns)}) values ({\",\".join(\"?\" * len(columns))})', [fields[c] for c in columns])\n    76\t    return cursor.lastrowid\n    77\t\n    78\t\n    79\t# ---------- views ----------\n    80\t\n    81\tdef create_view(conn, *, view_id, object_id, object_kind, kind, looks_at, question, due_day, year, rungs, seq, input_id, created_at):\n    82\t    insert(conn, 'views', view_id=view_id, object_id=object_id, object_kind=object_kind, kind=kind, looks_at=looks_at,\n    83\t           question=question, due_day=due_day, year=year, created_seq=seq, created_from_input=input_id, created_at=created_at)\n    84\t    for position, rung in enumerate(rungs, start=1):\n    85\t        insert(conn, 'rungs', view_id=view_id, position=position, label=rung['label'], condition=rung['condition'], lo=rung.get('lo'), hi=rung.get('hi'))\n    86\t    insert(conn, 'view_switches', view_id=view_id, open=1, reason='created', by_whom='matching', after_seq=seq)\n    87\t    conn.execute('insert into views_fts (view_id, text) values (?, ?)', (view_id, f'{object_id} {looks_at} {question}'))\n    88\t\n    89\t\n    90\tdef view(conn, view_id):\n    91\t    row = conn.execute('select * from views where view_id=?', (view_id,)).fetchone()\n    92\t    return dict(row) if row else None\n    93\t\n    94\t\n    95\tdef rungs_of(conn, view_id):\n    96\t    \"\"\"The rungs with their bounds when the ledger has them (keyed views); a ledger written before keys has no lo/hi columns.\"\"\"\n    97\t    rows = [dict(r) for r in conn.execute('select * from rungs where view_id=? order by position', (view_id,))]\n    98\t    has_bounds = any(r.get('lo') is not None or r.get('hi') is not None for r in rows) or view_key(conn, view_id) is not None\n   126\t        conn.execute(f'create table if not exists {name} ({TABLES[name]})')\n   127\t        conn.execute(f\"create trigger if not exists {name}_no_update before update on {name} begin select raise(abort, 'append-only'); end\")\n   128\t        conn.execute(f\"create trigger if not exists {name}_no_delete before delete on {name} begin select raise(abort, 'append-only'); end\")\n   129\t    conn.execute(\"create virtual table if not exists groups_fts using fts5(group_id unindexed, text, tokenize='trigram')\")\n   130\t    conn.execute('create index if not exists members_view on thesis_group_members(view_id)')\n   131\t    columns = {r[1] for r in conn.execute('pragma table_info(thesis_groups)')}\n   132\t    if 'aliases' not in columns:\n   133\t        conn.execute('alter table thesis_groups add column aliases text')\n   134\t    columns = {r[1] for r in conn.execute('pragma table_info(thesis_group_members)')}\n   135\t    if 'basis' not in columns:\n   136\t        conn.execute('alter table thesis_group_members add column basis text')\n   137\t\n   138\t\n   139\tdef ensure_writable_columns(conn):\n   140\t    \"\"\"Upgrade columns at a write boundary, including a legacy database restored into an open connection.\"\"\"\n   141\t    ensure_key_columns(conn)\n   142\t    ensure_group_tables(conn)\n   143\t    columns = {r[1] for r in conn.execute('pragma table_info(rungs)')}\n   144\t    for field in ('lo', 'hi'):\n   145\t        if field not in columns:\n   146\t            conn.execute(f'alter table rungs add column {field} real')\n   147\t    judgement_columns = {r[1] for r in conn.execute('pragma table_info(judgements)')}\n   148\t    if 'theme_pushes_json' not in judgement_columns:\n   149\t        conn.execute('alter table judgements add column theme_pushes_json text')     # D195: judgements written before the theme block read as []\n   150\t    for field in ('reference', 'implied_outcome'):\n   214\t\n   215\t\n   216\tREAD_BUSY_TIMEOUT_SECONDS = 5.0     # a reader's busy timeout: SQLite's busy handler retries SQLITE_BUSY within it (live-service row 1)\n   217\t\n   218\t\n   219\tdef open_read_only(path):\n   220\t    \"\"\"The views database for a reader (the agent layer, reports): no schema creation, no writes. Opened by its own path: a symlink\n   221\t    resolved, a store with another hard link refused (`live_lock.LockRefused`; live-service/OPERATING-CONTRACT.md, row 7), since\n   222\t    SQLite finds a WAL store's side files by the opened path.\"\"\"\n   223\t    from hivemind import live_lock\n   224\t    real, _ = live_lock.own_path(path)\n   225\t    conn = sqlite3.connect(f'file:{real}?mode=ro', uri=True, timeout=READ_BUSY_TIMEOUT_SECONDS)\n   226\t    conn.row_factory = sqlite3.Row\n   227\t    return conn\n   228\t\n   229\t\n   230\tdef current_state(conn, view_id):\n   231\t    row = conn.execute('select judgement_id, rung, reasons, changed, seq, publication_day from judgements where view_id=? order by judgement_id desc limit 1', (view_id,)).fetchone()\n   232\t    return dict(row) if row else None\n   233\t\n   234\t\n   235\tdef dependencies_of(conn, view_id):\n   236\t    \"\"\"Each dependency with its current target: the resolved view, or the waiting chain and year.\"\"\"\n   237\t    out = []\n   238\t    for dep in conn.execute('select * from dependencies where view_id=? order by dependency_id', (view_id,)):\n   239\t        dep = dict(dep)\n   240\t        resolution = conn.execute('select resolved_to, reason from dependency_resolutions where dependency_id=? order by id desc limit 1', (dep['dependency_id'],)).fetchone()\n   241\t        if resolution:\n   242\t            dep['resolved_to'], dep['resolution'] = resolution['resolved_to'], resolution['reason']\n   243\t        else:\n   244\t            dep['resolved_to'], dep['resolution'] = dep['depends_on'], ('direct' if dep['depends_on'] else 'waiting')\n   245\t        out.append(dep)\n   246\t    return out\n   247\t\n   248\t\n   249\tdef direct_parents(conn, view_id, seq=None):\n   250\t    \"\"\"The views this view depends on directly (a driver's root, D208; the seeds' depends_on), written at or before `seq` when given.\n   251\t    The filing reads it to keep a statement under the narrower of two linked questions (D207's narrowest rule, extraction.file_reading).\"\"\"\n   252\t    rows = conn.execute(\"select depends_on from dependencies where view_id=? and depends_on != '' and (? is null or seq <= ?) order by dependency_id\", (view_id, seq, seq))\n   253\t    return list(dict.fromkeys(r[0] for r in rows))\n   254\t\n   255\t\n   256\tdef dependants_of(conn, view_id):\n   257\t    direct = [r['view_id'] for r in conn.execute('select view_id from dependencies where depends_on=?', (view_id,))]\n   258\t    resolved = [r['view_id'] for r in conn.execute(\n   259\t        'select d.view_id from dependency_resolutions r join dependencies d on d.dependency_id=r.dependency_id where r.resolved_to=?', (view_id,))]\n   260\t    return sorted(set(direct + resolved))\n   261\t\n   262\t\n   263\tdef would_cycle(conn, view_id, depends_on):\n   264\t    \"\"\"True when depends_on already depends, directly or through its dependencies, on view_id.\"\"\"\n   265\t    seen, stack = set(), [depends_on]\n   266\t    while stack:\n   267\t        current = stack.pop()\n   268\t        if current == view_id:\n   269\t            return True\n   270\t        if current in seen or not current:\n   271\t            continue\n   272\t        seen.add(current)\n   273\t        for dep in dependencies_of(conn, current):\n   274\t            if dep['resolved_to']:\n   275\t                stack.append(dep['resolved_to'])\n   276\t    return False\n   277\t\n     8\timport json\n     9\timport os\n    10\timport sqlite3\n    11\timport sys\n    12\t\n    13\tROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))\n    14\tsys.path.insert(0, os.path.join(ROOT, 'src'))\n    15\tfrom hivemind.views import store  # noqa: E402\n    16\t\n    17\t\n    18\tdef main():\n    19\t    parser = argparse.ArgumentParser()\n    20\t    parser.add_argument('--views', default=os.path.join(ROOT, 'poc', 'data', 'views.sqlite'))\n    21\t    parser.add_argument('--archive', default=os.path.join(ROOT, 'poc', 'data', 'archive.sqlite'))\n    22\t    parser.add_argument('--object', default=None)\n    23\t    parser.add_argument('--evidence', action='store_true', help='print every piece of evidence in force')\n    24\t    args = parser.parse_args()\n    25\t    conn = store.open_db(args.views)\n    26\t    views = [dict(r) for r in conn.execute('select * from views order by created_seq')]\n    27\t    if args.object:\n    28\t        views = [v for v in views if v['object_id'] == args.object]\n    29\t    print(f'{len(views)} views')\n    30\t    for v in views:\n    31\t        state = store.current_state(conn, v['view_id'])\n    32\t        rungs = store.rungs_of(conn, v['view_id'])\n    33\t        label = rungs[state['rung'] - 1]['label'] if state else '还没判'\n    34\t        print(f'\\n== {v[\"view_id\"]} [{\"开着\" if store.is_open(conn, v[\"view_id\"]) else \"关了\"}] {v[\"object_id\"]} · {v[\"kind\"]} · 看的是「{v[\"looks_at\"]}」 · {v[\"year\"] or \"\"} · 到期 {v[\"due_day\"]} · 来自 {v[\"created_from_input\"][:50]}')\n    35\t        print(f'   问：{v[\"question\"]}')\n    36\t        print('   梯子：' + ' | '.join(f'{r[\"position\"]} {r[\"label\"]}：{r[\"condition\"]}' for r in rungs))\n    37\t        print(f'   状态：第 {state[\"rung\"] if state else \"-\"} 格 {label}' + (f'；理由：{state[\"reasons\"][:400]}' if state else ''))\n    38\t        deps = store.dependencies_of(conn, v['view_id'])\n    39\t        if deps:\n    40\t            print('   依赖：' + '；'.join(f'{d[\"resolved_to\"] or (\"等 \" + str(d[\"wait_chain_view_id\"]) + \" 的 \" + str(d[\"wait_year\"]))}（{d[\"direction\"]}）' for d in deps))\n    41\t        history = conn.execute('select publication_day, rung, changed, substr(why_changed,1,80) from judgements where view_id=? order by judgement_id', (v['view_id'],)).fetchall()\n    42\t        if len(history) > 1:\n    43\t            print('   历史：' + ' → '.join(f'{h[0]} 第{h[1]}格{\"*\" if h[2] else \"\"}' for h in history))\n    44\t        pieces = store.evidence_in_force(conn, v['view_id'])\n    45\t        print(f'   证据 {len(pieces)} 条' + ('：' if args.evidence else ''))\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_12","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba src/hivemind/views/judging.py | sed -n '54,94p;102,175p;194,242p;250,340p'\nnl -ba src/hivemind/extraction.py | sed -n '40,68p;244,323p;408,433p;468,476p'\nrg -n 'live_lock|engine' scripts/replay.py src/hivemind/parallel_day.py src/hivemind/stream.py\nnl -ba src/hivemind/model.py | sed -n '88,131p;180,201p'\nnl -ba tests/test_supported_versions.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba src/hivemind/views/judging.py | sed -n '54,94p;102,175p;194,242p;250,340p'\nnl -ba src/hivemind/extraction.py | sed -n '40,68p;244,323p;408,433p;468,476p'\nrg -n 'live_lock|engine' scripts/replay.py src/hivemind/parallel_day.py src/hivemind/stream.py\nnl -ba src/hivemind/model.py | sed -n '88,131p;180,201p'\nnl -ba tests/test_supported_versions.py\"","aggregated_output":"    54\tdef schema_for(prompt_version):\n    55\t    require_supported(prompt_version)\n    56\t    pushes = PUSHES\n    57\t    schema = {\n    58\t        'type': 'object', 'additionalProperties': False,\n    59\t        'required': ['rung', 'reasons', 'cites', 'cites_views', 'pushes', 'changed', 'why_changed'],\n    60\t        'properties': {\n    61\t            'rung': {'type': 'integer'}, 'reasons': {'type': 'string'},\n    62\t            'cites': {'type': 'array', 'items': {'type': 'string'}}, 'cites_views': {'type': 'array', 'items': {'type': 'string'}},\n    63\t            'pushes': {'type': 'array', 'items': {'type': 'object', 'additionalProperties': False, 'required': ['evidence_id', 'push'],\n    64\t                                                  'properties': {'evidence_id': {'type': 'string'}, 'push': {'type': 'string', 'enum': pushes}}}},\n    65\t            'changed': {'type': 'boolean'}, 'why_changed': {'type': 'string'},\n    66\t        },\n    67\t    }\n    68\t    schema['required'].append('theme_pushes')\n    69\t    schema['properties']['theme_pushes'] = {'type': 'array', 'items': {'type': 'object', 'additionalProperties': False, 'required': ['view_id', 'push'],\n    70\t                                                                       'properties': {'view_id': {'type': 'string'}, 'push': {'type': 'string', 'enum': pushes}}}}\n    71\t    schema['required'][1:1] = STANCE_FIELDS           # after rung: the reference and the implied outcome are written before the reasons\n    72\t    schema['properties'].update({field: {'type': 'string'} for field in STANCE_FIELDS})\n    73\t    return schema\n    74\t\n    75\t\n    76\tdef themes_in_force(conn, view_id):\n    77\t    \"\"\"The theme block of an asset thesis: every open theme thesis with a current state, with its rung label and whether a\n    78\t    changed conclusion was recorded after this thesis's last judgement. Empty for a theme thesis.\"\"\"\n    79\t    if store.view(conn, view_id)['object_kind'] == 'theme':\n    80\t        return []\n    81\t    last = store.current_state(conn, view_id)\n    82\t    out = []\n    83\t    for row in conn.execute(\"select view_id from views where object_kind='theme' order by view_id\"):\n    84\t        theme_id = row['view_id']\n    85\t        state = store.current_state(conn, theme_id)\n    86\t        if not state or not store.is_open(conn, theme_id):\n    87\t            continue\n    88\t        updated = bool(last) and bool(conn.execute('select 1 from judgements where view_id=? and changed=1 and judgement_id>? limit 1',\n    89\t                                                   (theme_id, last['judgement_id'])).fetchone())\n    90\t        rung = store.rungs_of(conn, theme_id)[state['rung'] - 1]\n    91\t        out.append({'view_id': theme_id, 'view': store.view(conn, theme_id), 'state': state, 'rung_label': rung['label'], 'updated': updated})\n    92\t    return out\n    93\t\n    94\t\n   102\tdef topological(conn, view_ids):\n   103\t    \"\"\"Dependencies first: a view comes after every view it depends on that is also in the set.\"\"\"\n   104\t    remaining = list(dict.fromkeys(view_ids))\n   105\t    ordered, placed = [], set()\n   106\t    while remaining:\n   107\t        progressed = False\n   108\t        for view_id in list(remaining):\n   109\t            deps = {d['resolved_to'] for d in store.dependencies_of(conn, view_id) if d['resolved_to']}\n   110\t            if deps.isdisjoint(set(remaining) - {view_id}) or deps <= placed:\n   111\t                ordered.append(view_id)\n   112\t                placed.add(view_id)\n   113\t                remaining.remove(view_id)\n   114\t                progressed = True\n   115\t        if not progressed:                 # a cycle slipped through: keep going in the given order\n   116\t            ordered.extend(remaining)\n   117\t            break\n   118\t    return ordered\n   119\t\n   120\t\n   121\tdef _lines_english(conn, view_id, v, rungs, pieces, deps, last, themes=(), hidden=0):\n   122\t    \"\"\"hidden: how many pieces in force are not shown.\"\"\"\n   123\t    lines = [f'Thesis {view_id} ({v[\"object_id\"]}, {v[\"kind\"]}, focus \"{v[\"looks_at\"]}\", {v[\"year\"] or \"\"}, due {v[\"due_day\"]}): {v[\"question\"]}',\n   124\t             'Ladder: ' + ' / '.join(f'rung {r[\"position\"]} {r[\"label\"]}: {r[\"condition\"]}' for r in rungs), '',\n   125\t             f'[Evidence in view under this thesis, {len(pieces)} items]']\n   126\t    if hidden:\n   127\t        lines.append(f'[Not shown: {hidden} more pieces in force, read in earlier judgements; the previous conclusion carries them]')\n   128\t    for p in pieces:\n   129\t        src = p['sources'][0] if p['sources'] else {}\n   130\t        lines.append(f'- {p[\"evidence_id\"]} [{p[\"tier\"]}; {p[\"speaker\"]}; original source {p[\"original_who\"]} {p[\"original_day\"]}; from {src.get(\"input_id\")} {src.get(\"publication_day\")}] {p[\"one_line\"]}\\n    Quote: {p[\"quote\"][:400]}')\n   131\t        if p.get('replaced'):\n   132\t            lines.append(f'    It replaces {p[\"replaced\"][\"evidence_id\"]} ({p[\"replaced\"][\"original_day\"]}): {p[\"replaced\"][\"one_line\"]}')\n   133\t        if p.get('same_as'):\n   134\t            lines.append(f'    Opinion, not verified: the matcher read this as the same claim as {\", \".join(p[\"same_as\"])}; the argument counts one claim, one more outlet.')\n   135\t        if p.get('revises'):\n   136\t            lines.append(f'    Opinion, not verified: the matcher read it as a later version of {p[\"revises\"][\"evidence_id\"]} ({p[\"revises\"][\"original_day\"]}); both are in force: {p[\"revises\"][\"one_line\"]}')\n   137\t    if deps:\n   138\t        lines.append('\\n[Current conclusions of the theses it depends on]')\n   139\t        for d in deps:\n   140\t            target = d['resolved_to']\n   141\t            if not target:\n   142\t                lines.append(f'- the {d[\"wait_year\"]} thesis on chain {d[\"wait_chain_view_id\"]}: not yet created ({d[\"direction\"]})')\n   143\t                continue\n   144\t            tv = store.view(conn, target)\n   145\t            state = store.current_state(conn, target)\n   146\t            flag = 'historical only' if d['resolution'] == 'history_only' else ('closed' if not store.is_open(conn, target) else 'open')\n   147\t            rung_label = store.rungs_of(conn, target)[state['rung'] - 1]['label'] if state else 'not judged yet'\n   148\t            lines.append(f'- {target} ({flag}; {d[\"direction\"]}) {tv[\"question\"]}: now rung {state[\"rung\"] if state else \"-\"} {rung_label}; reasons: {(state or {}).get(\"reasons\", \"\")[:600]}')\n   149\t    if themes:\n   150\t        lines.append(f'\\n[Themes in force, {len(themes)}]')\n   151\t        for theme in themes:\n   152\t            tv, state = theme['view'], theme['state']\n   153\t            mark = f'; {UPDATED_MARK}' if theme['updated'] else ''\n   154\t            lines.append(f'- {theme[\"view_id\"]} ({tv[\"object_id\"]}, due {tv[\"due_day\"]}) {tv[\"question\"]}: now rung {state[\"rung\"]} {theme[\"rung_label\"]}; '\n   155\t                         f'judged {state[\"publication_day\"]}{mark}; reasons: {(state[\"reasons\"] or \"\")[:THEME_REASONS_CHARS]}')\n   156\t    if last:\n   157\t        lines.append(f'\\n[Previous conclusion, for comparison only] rung {last[\"rung\"]}; reasons: {last[\"reasons\"][:800]}')\n   158\t    else:\n   159\t        lines.append('\\n[Previous conclusion] none: this is the first judgement, so changed must be true.')\n   160\t    lines.append('\\nAnswer per the JSON schema. cites may name only the evidence ids listed above; '\n   161\t                 + ('cites_views only the dependency thesis ids listed above' if deps else 'cites_views must be empty: this thesis depends on no other thesis')\n   162\t                 + ('; theme_pushes only the theme ids listed above; a theme id goes only in theme_pushes, never in cites or cites_views' if themes else '') + '.')\n   163\t    return lines\n   164\t\n   165\t\n   166\tdef build_prompt(conn, view_id, prompt_version):\n   167\t    require_supported(prompt_version)\n   168\t    v = store.view(conn, view_id)\n   169\t    rungs = store.rungs_of(conn, view_id)\n   170\t    pieces, hidden = evidence_in_view(conn, view_id)\n   171\t    deps = store.dependencies_of(conn, view_id)\n   172\t    last = store.current_state(conn, view_id)\n   173\t    lines = _lines_english(conn, view_id, v, rungs, pieces, deps, last, themes_in_force(conn, view_id), hidden=hidden)\n   174\t    with open(config.prompt_path(prompt_version + '.txt'), encoding='utf-8') as handle:\n   175\t        return handle.read(), '\\n'.join(lines)\n   194\tdef check_answer(conn, view_id, data, request_text=None):\n   195\t    \"\"\"request_text: the user message that was sent, so theme and evidence ids are checked against what it carried (a theme may have\n   196\t    closed or opened since); without it, against what the ledger would show now.\"\"\"\n   197\t    errors = []\n   198\t    shown = themes_shown_in(request_text) if request_text is not None else {theme['view_id'] for theme in themes_in_force(conn, view_id)}\n   199\t    named = []\n   200\t    for entry in data.get('theme_pushes', []):\n   201\t        if entry['view_id'] in named:\n   202\t            errors.append(f'{entry[\"view_id\"]} is named twice in theme_pushes')\n   203\t        elif entry['view_id'] not in shown:\n   204\t            errors.append(f'{entry[\"view_id\"]} is not a theme in force shown to {view_id}')\n   205\t        named.append(entry['view_id'])\n   206\t    # the closed set is what the request showed (D198), read from the text that was sent, else computed from the ledger\n   207\t    allowed = evidence_shown_in(request_text) if request_text is not None else {p['evidence_id'] for p in evidence_in_view(conn, view_id)[0]}\n   208\t    not_allowed = lambda e: f'{e} is not among the evidence shown to {view_id}'\n   209\t    bad_push = lambda e: f'push on {e} which was not shown to {view_id}'\n   210\t    deps = {d['resolved_to'] for d in store.dependencies_of(conn, view_id) if d['resolved_to']}\n   211\t    rungs = store.rungs_of(conn, view_id)\n   212\t    if not 1 <= data['rung'] <= len(rungs):\n   213\t        errors.append(f'rung {data[\"rung\"]} outside 1..{len(rungs)}')\n   214\t    for cited in data['cites']:\n   215\t        if cited not in allowed:\n   216\t            errors.append(not_allowed(cited))\n   217\t    for cited in data['cites_views']:\n   218\t        if cited not in deps:\n   219\t            errors.append(f'{cited} is not a dependency of {view_id}')\n   220\t    for push in data['pushes']:\n   221\t        if push['evidence_id'] not in allowed:\n   222\t            errors.append(bad_push(push['evidence_id']))\n   223\t    for field in STANCE_FIELDS:\n   224\t        if not str(data.get(field) or '').strip():\n   225\t            errors.append(f'{field} is empty: state what the market expects and the figure or date the evidence implies')\n   226\t    last = store.current_state(conn, view_id)\n   227\t    if last is None and not data['changed']:\n   228\t        errors.append('first judgement must say changed')\n   229\t    if last is not None and last['rung'] != data['rung'] and not data['changed']:\n   230\t        errors.append(f'rung moved from {last[\"rung\"]} to {data[\"rung\"]} but changed is false')\n   231\t    return errors\n   232\t\n   233\t\n   234\tdef _record(conn, cfg, view_id, seq, item, answer):\n   235\t    data = vocabulary.judgement_answer(answer.data)\n   236\t    judgement_id = store.insert(conn, 'judgements', view_id=view_id, seq=seq, input_id=item['input_id'], rung=data['rung'],\n   237\t                                reasons=data['reasons'], cited_evidence_json=json.dumps(data['cites']), cited_views_json=json.dumps(data['cites_views']),\n   238\t                                pushes_json=json.dumps(data['pushes'], ensure_ascii=False), changed=1 if data['changed'] else 0,\n   239\t                                theme_pushes_json=json.dumps(data.get('theme_pushes', []), ensure_ascii=False),\n   240\t                                reference=data.get('reference'), implied_outcome=data.get('implied_outcome'),\n   241\t                                why_changed=data['why_changed'], config_checksum=cfg.checksum, call_id=answer.call_id,\n   242\t                                request_sha256=answer.request_sha256, publication_day=item['publication_day'])\n   250\tdef upstream(conn, view_id):\n   251\t    \"\"\"Every view this one depends on, directly or through its dependencies.\"\"\"\n   252\t    seen, stack = set(), [view_id]\n   253\t    while stack:\n   254\t        for dep in store.dependencies_of(conn, stack.pop()):\n   255\t            target = dep['resolved_to']\n   256\t            if target and target not in seen:\n   257\t                seen.add(target)\n   258\t                stack.append(target)\n   259\t    return seen\n   260\t\n   261\t\n   262\tdef open_asset_views(conn):\n   263\t    return [v for v in store.open_views(conn) if store.view(conn, v)['object_kind'] != 'theme']\n   264\t\n   265\t\n   266\tdef queued_by_change(conn, view_id):\n   267\t    \"\"\"What a changed conclusion of this view queues: its dependants and, for a theme thesis, every open asset thesis. The one rule,\n   268\t    read for a live judgement and for the judgements a resumed round finds committed.\"\"\"\n   269\t    queued = store.dependants_of(conn, view_id)\n   270\t    if store.view(conn, view_id)['object_kind'] == 'theme':\n   271\t        queued = queued + open_asset_views(conn)\n   272\t    return queued\n   273\t\n   274\t\n   275\tdef queued_by_ledger(conn, seq):\n   276\t    \"\"\"What the judgements already committed at this sequence number queued; a fresh round finds nothing here, a resumed round\n   277\t    finds what the interrupted one had queued in memory.\"\"\"\n   278\t    queued = []\n   279\t    for row in conn.execute('select view_id from judgements where seq=? and changed=1 order by judgement_id', (seq,)):\n   280\t        queued.extend(queued_by_change(conn, row['view_id']))\n   281\t    return queued\n   282\t\n   283\t\n   284\tdef round_of_judgements(archive, cfg, conn, changed_views, seq, item, *, transport=None):\n   285\t    \"\"\"Judge the open views in changed_views, dependencies first; a changed conclusion queues open dependants.\n   286\t\n   287\t    Views that do not depend on each other are judged at the same time: each level of the dependency order is sent\n   288\t    to the model concurrently (the prompts are built and the answers checked and written in this thread, so the\n   289\t    database connection never crosses threads). A view waits while anything upstream of it is still pending, so a\n   290\t    dependant always reads this round's conclusion of its dependency. A view with no evidence in force stays\n   291\t    unjudged (D59), and a view already judged at this sequence number (a resumed round) is not judged twice.\n   292\t\n   293\t    Among the views ready to be judged, theme theses go first, so an asset thesis reads this round's theme conclusions; a theme judgement that says changed queues every open asset thesis with\n   294\t    evidence in force. The starting queue adds what the ledger says earlier commits at this sequence number queued.\"\"\"\n   295\t    import concurrent.futures\n   296\t\n   297\t    version = cfg.rejudging.prompt_version\n   298\t    schema = schema_for(version)\n   299\t\n   300\t    def eligible(view_id):\n   301\t        return store.is_open(conn, view_id) and not store.has_judgement(conn, view_id, seq) and bool(store.evidence_in_force(conn, view_id))\n   302\t\n   303\t    def is_theme(view_id):\n   304\t        return store.view(conn, view_id)['object_kind'] == 'theme'\n   305\t\n   306\t    pending = [v for v in topological(conn, list(changed_views) + queued_by_ledger(conn, seq)) if eligible(v)]\n   307\t    done, results = set(), []\n   308\t    while pending:\n   309\t        ready = [v for v in pending if upstream(conn, v).isdisjoint(set(pending) - {v})] or pending[:1]\n   310\t        level = [v for v in ready if is_theme(v)] or ready\n   311\t        prompts = {v: build_prompt(conn, v, version) for v in level}\n   312\t\n   313\t        def ask(view_id, note=''):\n   314\t            system, user = prompts[view_id]\n   315\t            return model.call(archive, cfg, cfg.rejudging, system, user + note, schema, 'judgement', 'judge', transport=transport)\n   316\t\n   317\t        with concurrent.futures.ThreadPoolExecutor(max_workers=JUDGE_WORKERS) as pool_:\n   318\t            answers = dict(zip(level, pool_.map(ask, level)))\n   319\t        for view_id in level:\n   320\t            answer = answers[view_id]\n   321\t            errors = check_answer(conn, view_id, answer.data, prompts[view_id][1])\n   322\t            if errors:\n   323\t                archive.retire(answer.call_id)                 # a refused answer never answers the same request again (a resume re-samples)\n   324\t                answer = ask(view_id, retry_note(errors))\n   325\t                errors = check_answer(conn, view_id, answer.data, prompts[view_id][1])\n   326\t                if errors:\n   327\t                    archive.retire(answer.call_id)\n   328\t                    raise JudgementRefused(f'{view_id}: ' + '; '.join(errors))\n   329\t            result = _record(conn, cfg, view_id, seq, item, answer)\n   330\t            done.add(view_id)\n   331\t            results.append(result)\n   332\t            if result['changed']:\n   333\t                for dependant in queued_by_change(conn, view_id):\n   334\t                    if dependant not in done and dependant not in pending and eligible(dependant):\n   335\t                        pending.append(dependant)\n   336\t        pending = [v for v in topological(conn, pending) if v not in done and eligible(v)]\n   337\t    return results\n    40\t\n    41\t\n    42\tdef shown_views(conn, cfg, item, objects):\n    43\t    \"\"\"The questions an item's extraction request shows (05-extraction block 5): the objects' questions open at the start of the\n    44\t    item's day, the same list for every item of that day (D251), with the key, groups and aliases each had then (they feed its takes\n    45\t    line) and its direct parents (they feed the narrowest rule). The one place the stream and the parallel runner take the list from.\"\"\"\n    46\t    require_supported(cfg.extraction_setting(item['category']).prompt_version.rpartition('-')[2])\n    47\t    from .views import store\n    48\t    return [dict(v, key=store.view_key(conn, v['view_id']) or {},\n    49\t                 groups=[{'name': g['name'], 'scope': g['scope'], 'aliases': g.get('aliases') or []}\n    50\t                         for g in store.groups_of_view_at(conn, v['view_id'], v['snapshot_seq'])],\n    51\t                 parents=store.direct_parents(conn, v['view_id'], v['snapshot_seq']))\n    52\t            for v in store.views_open_at_day_start(conn, objects, item['publication_day'])]\n    53\t\n    54\t\n    55\tdef narrowest_links(links, parents):\n    56\t    \"\"\"D207's one rule the filing enforces in code (2026-11-02, D265): a statement linked to a question and to a question that question\n    57\t    depends on (a driver and its root, transitively) keeps the narrower one only. `parents` maps a view id to the ids it depends on.\"\"\"\n    58\t    def ancestors(view_id, seen):\n    59\t        for parent in parents.get(view_id, ()):\n    60\t            if parent not in seen:\n    61\t                seen.add(parent)\n    62\t                ancestors(parent, seen)\n    63\t        return seen\n    64\t    broader = set()\n    65\t    for link in links:\n    66\t        broader |= ancestors(link, set())\n    67\t    return [l for l in links if l not in broader]\n    68\t\n   244\t    word for the company or one of `subject_names` (the subject company's own name), never a number or any other word; or copy one\n   245\t    passage exactly and run on past its sentence end.\"\"\"\n   246\t    if len(normalise(quote)) < 8:\n   247\t        return None\n   248\t    spans = _quote_tokens(text)\n   249\t    source_tokens = [token for token, _, _ in spans]\n   250\t    quote_tokens = [token for token, _, _ in _quote_tokens(quote)]\n   251\t    if not quote_tokens:\n   252\t        return None\n   253\t    found = _runs(quote_tokens, source_tokens)\n   254\t    if found:\n   255\t        return _source_passage(text, spans[found[0]][1], spans[found[0] + len(quote_tokens) - 1][2])\n   256\t    best = None                                              # (left-out length, first token, last token) of the shortest gap\n   257\t    for split in range(1, len(quote_tokens)):\n   258\t        head, tail = quote_tokens[:split], quote_tokens[split:]\n   259\t        for tail_start in _runs(tail, source_tokens):\n   260\t            for gap_start in range(tail_start - 1, split - 1, -1):          # tokens gap_start..tail_start-1 are the left-out run\n   261\t                if tail_start - gap_start >= len(quote_tokens) or _SENTENCE_END.search(text[spans[gap_start - 1][2]:spans[tail_start][1]]):\n   262\t                    break\n   263\t                if source_tokens[gap_start - split:gap_start] == head:\n   264\t                    if best is None or tail_start - gap_start < best[0]:\n   265\t                        best = (tail_start - gap_start, gap_start - split, tail_start + len(tail) - 1)\n   266\t                    break\n   267\t    if best is not None:\n   268\t        return _source_passage(text, spans[best[1]][1], spans[best[2]][2])\n   269\t    near = _near_run(quote_tokens, source_tokens, subject_names)   # D266: a function word or the company's own name changed, added or dropped\n   270\t    if near is not None:\n   271\t        return _source_passage(text, spans[near[0]][1], spans[near[1]][2])\n   272\t    prefix = _exact_prefix(quote_tokens, source_tokens, spans, text)   # D266: a quote that runs on past the passage it copied keeps that passage\n   273\t    if prefix is not None:\n   274\t        return _source_passage(text, spans[prefix[0]][1], spans[prefix[1]][2])\n   275\t    return None\n   276\t\n   277\t\n   278\t# D266 (2026-11-02, Alex: the quote refusals of core statements are an important class, fix it quickly): the stored quote is still the exact\n   279\t# source passage; what widens is which model quotes are matched to one. A quote of at least NEAR_MIN_TOKENS words whose words differ from one\n   280\t# source window's by at most NEAR_EDITS(n) word edits, every edited word a function word, a pronoun, a generic word for the company or the\n   281\t# subject company's own name (\"the company's\" written as the name; \"While\" as \"As\"), is that window; a quote that copies one passage\n   282\t# exactly and then runs on into other text keeps the copied passage when it is at least NEAR_MIN_TOKENS words and ends at a sentence end.\n   283\t# A changed month, party, product or number, a paraphrase, and two names swapped are refused as before (D236's tests hold).\n   284\tNEAR_MIN_TOKENS = 8\n   285\tHARMLESS_TOKENS = frozenset('''the a an this that these those it its it's he she they their his her hers we our ours my your you\n   286\t    as while although though meanwhile however but and or so because since then also too for of to in on at by with from into over under\n   287\t    about example instance first all additionally moreover further furthermore still yet now here there is are was were be been being\n   288\t    has have had do does did will would could should might can that's which who whom whose what when where said says say\n   289\t    company company's firm firm's chipmaker chipmaker's giant giant's maker maker's group group's'''.split())     # not \"may\": a month\n   290\t\n   291\t\n   292\tdef NEAR_EDITS(length):\n   293\t    return 2 if length <= 30 else 3\n   294\t\n   295\t\n   296\tdef _harmless(subject_names):\n   297\t    names = set()\n   298\t    for name in subject_names:\n   299\t        for token, _, _ in _quote_tokens(name):\n   300\t            names.add(token)\n   301\t            names.add(token + \"'s\")\n   302\t    return HARMLESS_TOKENS | names\n   303\t\n   304\t\n   305\tdef _edited_tokens(quote_tokens, window):\n   306\t    \"\"\"(number of word edits, the words involved on both sides) between the quote and one source window, by the aligned difference.\"\"\"\n   307\t    edits, involved = 0, []\n   308\t    for tag, i1, i2, j1, j2 in difflib.SequenceMatcher(None, quote_tokens, window, autojunk=False).get_opcodes():\n   309\t        if tag == 'equal':\n   310\t            continue\n   311\t        edits += max(i2 - i1, j2 - j1)\n   312\t        involved += quote_tokens[i1:i2] + window[j1:j2]\n   313\t    return edits, involved\n   314\t\n   315\t\n   316\tdef _near_run(quote_tokens, source_tokens, subject_names=()):\n   317\t    \"\"\"(first, last) source token indexes of a window the quote matches within NEAR_EDITS word edits that all fall on harmless words,\n   318\t    anchored on the quote's first or last three words appearing exactly; None otherwise.\"\"\"\n   319\t    n = len(quote_tokens)\n   320\t    if n < NEAR_MIN_TOKENS:\n   321\t        return None\n   322\t    limit = NEAR_EDITS(n)\n   323\t    harmless = _harmless(subject_names)\n   408\tOBJECT_LABELS = vocabulary.ASSET_LABELS\n   409\t\n   410\t\n   411\tdef check_ladder(rungs, kind):\n   412\t    \"\"\"None when the ladder is well formed, else the problem. An asset ladder written from Strongly bearish up to\n   413\t    Strongly bullish (the model often orders a revenue ladder by rising value) is the same ladder; normalise_ladder\n   414\t    turns it round. Labels are compared in the canonical vocabulary.\"\"\"\n   415\t    if len(rungs) not in (2, 5):\n   416\t        return f'ladder has {len(rungs)} rungs, needs 5 (or 2 for yes/no)'\n   417\t    if any(not r['label'].strip() or not r['condition'].strip() for r in rungs):\n   418\t        return 'a rung has an empty label or condition'\n   419\t    if kind == 'asset' and len(rungs) == 5:\n   420\t        labels = [vocabulary.canonical('label', r['label']) for r in rungs]\n   421\t        if labels != OBJECT_LABELS and labels != OBJECT_LABELS[::-1]:\n   422\t            return f'object view rungs must be {OBJECT_LABELS}, got {labels}'\n   423\t    return None\n   424\t\n   425\t\n   426\tdef normalise_ladder(rungs, kind):\n   427\t    \"\"\"Position 1 is Strongly bullish (06-views): a reversed asset ladder is turned round, label and condition together.\"\"\"\n   428\t    if kind == 'asset' and len(rungs) == 5 and [vocabulary.canonical('label', r['label']) for r in rungs] == OBJECT_LABELS[::-1]:\n   429\t        return list(reversed(rungs))\n   430\t    return rungs\n   431\t\n   432\t\n   433\t# 06-views ladder rule 6: a quarterly or half-year figure is evidence, not a view. The half-year forms name a revenue\n   468\tdef file_reading(reading, item, shown_views):\n   469\t    \"\"\"The handover: the extraction's own links are the filing (D256). A statement linked to a question and to a question that\n   470\t    question depends on keeps the narrower one (D207); a statement no open question and no kept candidate takes is dropped as 'no\n   471\t    home' (D209), like every other drop: a candidate left with none of its evidence is dropped too, and a statement whose only link was\n   472\t    such a candidate has no home.\"\"\"\n   473\t    candidates, dropped, answer = reading.candidates, list(reading.dropped), reading.answer\n   474\t    parents = {v['view_id']: v.get('parents') or [] for v in shown_views}\n   475\t    evidence = [dict(e, links=narrowest_links(e['links'], parents)) for e in reading.evidence]\n   476\t    while True:\nrg: src/hivemind/stream.py: No such file or directory (os error 2)\nscripts/replay.py:13:Jev matching questions at a time (8; one at a time for another matching engine); the ledger equals the serial one for\nscripts/replay.py:66:                        help='Jev matching questions sent at a time when --workers > 1; default 8 for Jev, 1 for another engine')\nscripts/replay.py:85:        jev_workers = args.jev_workers if args.jev_workers is not None else (8 if cfg.matching.engine == 'jev' else 1)\nsrc/hivemind/parallel_day.py:93:        if cfg.matching.engine != 'jev' and self.jev_workers != 1:\n    88\t            cursor = self.conn.execute(f'insert or ignore into model_calls ({\",\".join(columns)}) values ({\",\".join(\"?\" * len(columns))})',\n    89\t                                       [fields[c] for c in columns])\n    90\t            self.conn.commit()\n    91\t            if cursor.rowcount == 0:\n    92\t                return self.conn.execute('select call_id from model_calls where request_sha256=?', (fields['request_sha256'],)).fetchone()[0]\n    93\t            return cursor.lastrowid\n    94\t\n    95\t    def retire(self, call_id):\n    96\t        \"\"\"A code check refused this answer: the row stays for the record, but no later identical request is answered with it\n    97\t        (the same shape as a schema-refused or malformed row, whose hash carries a suffix).\"\"\"\n    98\t        with self.lock:\n    99\t            self.conn.execute(\"update model_calls set request_sha256 = request_sha256 || ':refused:' || ? where call_id=? and request_sha256 not like '%:refused:%'\",\n   100\t                              (uuid.uuid4().hex[:8], call_id))\n   101\t            self.conn.commit()\n   102\t\n   103\t    def totals(self):\n   104\t        with self.lock:\n   105\t            return self.conn.execute('select count(*), coalesce(sum(cost_usd),0), coalesce(sum(input_tokens),0), coalesce(sum(output_tokens),0) from model_calls').fetchone()\n   106\t\n   107\t\n   108\tdef _key(provider):\n   109\t    name = ENDPOINTS[provider][1]\n   110\t    if os.environ.get(name):\n   111\t        return os.environ[name]\n   112\t    with open(CREDENTIALS, encoding='utf-8') as handle:\n   113\t        return json.load(handle)[name]\n   114\t\n   115\t\n   116\tdef build_request(setting, system, user, schema, schema_name, provider):\n   117\t    request = {\n   118\t        'model': setting.model,\n   119\t        'messages': [{'role': 'system', 'content': system}, {'role': 'user', 'content': user}],\n   120\t        'response_format': {'type': 'json_schema', 'json_schema': {'name': schema_name, 'strict': True, 'schema': schema}},\n   121\t    }\n   122\t    if provider == 'openai':\n   123\t        request['max_completion_tokens'] = setting.max_output_tokens\n   124\t        if setting.reasoning_effort:\n   125\t            request['reasoning_effort'] = setting.reasoning_effort\n   126\t    else:\n   127\t        request['max_tokens'] = setting.max_output_tokens\n   128\t    return request\n   129\t\n   130\t\n   131\tdef openai_transport(provider, request, timeout=180, max_attempts=3):   # the default preserves the production retry behavior\n   180\t        failure.http_status, failure.response_body, failure.response_body_base64 = last_http\n   181\t    raise failure\n   182\t\n   183\t\n   184\tdef check_schema(value, schema, path='$', root=None):\n   185\t    \"\"\"A small validator for the subset of JSON Schema the prompts use: object/required/additionalProperties,\n   186\t    array/items/minItems, string/enum/pattern, integer, number, boolean, null in anyOf, and $ref into the root's $defs.\"\"\"\n   187\t    root = root if root is not None else schema\n   188\t    if '$ref' in schema:\n   189\t        name = schema['$ref'].rsplit('/', 1)[1]\n   190\t        schema = root['$defs'][name]\n   191\t    kind = schema.get('type')\n   192\t    if 'anyOf' in schema:\n   193\t        # a value matching no option reports the closest options' errors (fewest), not merely the last option's\n   194\t        failures = []\n   195\t        for option in schema['anyOf']:\n   196\t            errors = check_schema(value, option, path, root)\n   197\t            if not errors:\n   198\t                return []\n   199\t            failures.append(errors)\n   200\t        fewest = min((len(errors) for errors in failures), default=0)\n   201\t        closest = list(dict.fromkeys(error for errors in failures if len(errors) == fewest for error in errors))\n     1\t\"\"\"D359: the code builds only the frozen production prompts, extraction v74i (D274) and judging-v7 (D354); a configuration that names\n     2\tany other version is refused before a request is built or sent.\"\"\"\n     3\timport dataclasses\n     4\timport os\n     5\timport sys\n     6\t\n     7\timport pytest\n     8\t\n     9\tROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))\n    10\tsys.path.insert(0, os.path.join(ROOT, 'src'))\n    11\tfrom hivemind import config, extraction, model  # noqa: E402\n    12\tfrom hivemind.views import judging  # noqa: E402\n    13\tfrom test_placement import ITEM, TEXT, UNI  # noqa: E402\n    14\tfrom test_theme_block import DAY, ledger  # noqa: E402\n    15\t\n    16\tV108 = config.load(os.path.join(ROOT, 'poc', 'config', 'poc-v108.json'))\n    17\t\n    18\t\n    19\tdef never_sent(*parameters):\n    20\t    raise AssertionError('a request of a version the code does not build was sent')\n    21\t\n    22\t\n    23\tdef test_an_extraction_version_other_than_v74i_is_refused_before_any_call(tmp_path):\n    24\t    other = dataclasses.replace(V108, extraction=dict(V108.extraction, T7=dataclasses.replace(V108.extraction['T7'], prompt_version='T7-v53')))\n    25\t    with pytest.raises(ValueError, match=\"extraction 'v53' is not built\"):\n    26\t        extraction.extract(model.Archive(str(tmp_path / 'archive.sqlite')), other, ITEM, TEXT, [], UNI, transport=never_sent)\n    27\t\n    28\t\n    29\tdef test_a_judging_version_other_than_v7_is_refused_before_any_call(tmp_path):\n    30\t    other = dataclasses.replace(V108, rejudging=dataclasses.replace(V108.rejudging, prompt_version='judging-v6'))\n    31\t    with pytest.raises(ValueError, match=\"judging 'judging-v6' is not built\"):\n    32\t        judging.round_of_judgements(model.Archive(str(tmp_path / 'archive.sqlite')), other, ledger(tmp_path), ['v1'], 2, DAY, transport=never_sent)\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_13","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"python3 -c '\nfrom pathlib import Path\nimport sqlite3,json\np=Path(\\\"poc/data/comparison-2026-11-17/run/old-2/prod\\\")\ndef db(f):\n return sqlite3.connect(f.resolve().as_uri()+\\\"?mode=ro&immutable=1\\\",uri=True)\nwith db(p/\\\"views.sqlite\\\") as c, db(p/\\\"archive.sqlite\\\") as a:\n print(\\\"finish prefix/windows\\\",c.execute(\\\"select step,publication_day,count(*) from processing_steps where publication_day between '\\\\''2026-07-09'\\\\'' and '\\\\''2026-07-12'\\\\'' and step in ('\\\\''written'\\\\'','\\\\''judged'\\\\'') group by 1,2\\\").fetchall())\n print(\\\"opens in test\\\",c.execute(\\\"select view_id,kind,object_kind,created_seq,created_from_input from views where created_seq between 148 and 186 order by created_seq\\\").fetchall())\n for row in c.execute(\\\"select shown_json,decisions_json from match_records where seq=148\\\"):\n  shown=json.loads(row[0])\n  for link in shown.get(\\\"requests\\\",[]):\n   state=a.execute(\\\"select request_json from model_calls where call_id=?\\\",(link[\\\"call_id\\\"],)).fetchone()\n   req=json.loads(state[0])\n   print(\\\"state\\\",req[\\\"state\\\"])\n   for k in (\\\"rel__v9\\\",\\\"rel__v8\\\"):\n    print(k,req[\\\"questions\\\"][k])\n print(\\\"v9 historical first links\\\",c.execute(\\\"select e.evidence_id,e.quote from evidence_links l join evidence e using(evidence_id) where l.view_id='\\\\''v9'\\\\'' and l.seq <148 order by l.seq,e.rowid limit 4\\\").fetchall())\n print(\\\"scope asset cases\\\",c.execute(\\\"select v.kind,v.object_kind,count(*) from views v group by 1,2\\\").fetchall())\n print(\\\"views approx number first window\\\",c.execute(\\\"select v.view_id,v.object_kind,v.created_seq,k.measure from views v join view_keys k using(view_id) where v.created_seq<=148 order by v.created_seq\\\").fetchall())\n'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"python3 -c '\nfrom pathlib import Path\nimport sqlite3,json\np=Path(\\\"poc/data/comparison-2026-11-17/run/old-2/prod\\\")\ndef db(f):\n return sqlite3.connect(f.resolve().as_uri()+\\\"?mode=ro&immutable=1\\\",uri=True)\nwith db(p/\\\"views.sqlite\\\") as c, db(p/\\\"archive.sqlite\\\") as a:\n print(\\\"finish prefix/windows\\\",c.execute(\\\"select step,publication_day,count(*) from processing_steps where publication_day between '\\\\''2026-07-09'\\\\'' and '\\\\''2026-07-12'\\\\'' and step in ('\\\\''written'\\\\'','\\\\''judged'\\\\'') group by 1,2\\\").fetchall())\n print(\\\"opens in test\\\",c.execute(\\\"select view_id,kind,object_kind,created_seq,created_from_input from views where created_seq between 148 and 186 order by created_seq\\\").fetchall())\n for row in c.execute(\\\"select shown_json,decisions_json from match_records where seq=148\\\"):\n  shown=json.loads(row[0])\n  for link in shown.get(\\\"requests\\\",[]):\n   state=a.execute(\\\"select request_json from model_calls where call_id=?\\\",(link[\\\"call_id\\\"],)).fetchone()\n   req=json.loads(state[0])\n   print(\\\"state\\\",req[\\\"state\\\"])\n   for k in (\\\"rel__v9\\\",\\\"rel__v8\\\"):\n    print(k,req[\\\"questions\\\"][k])\n print(\\\"v9 historical first links\\\",c.execute(\\\"select e.evidence_id,e.quote from evidence_links l join evidence e using(evidence_id) where l.view_id='\\\\''v9'\\\\'' and l.seq <148 order by l.seq,e.rowid limit 4\\\").fetchall())\n print(\\\"scope asset cases\\\",c.execute(\\\"select v.kind,v.object_kind,count(*) from views v group by 1,2\\\").fetchall())\n print(\\\"views approx number first window\\\",c.execute(\\\"select v.view_id,v.object_kind,v.created_seq,k.measure from views v join view_keys k using(view_id) where v.created_seq<=148 order by v.created_seq\\\").fetchall())\n'\"","aggregated_output":"finish prefix/windows [('judged', '2026-07-09', 1), ('judged', '2026-07-10', 1), ('judged', '2026-07-11', 1), ('judged', '2026-07-12', 1), ('written', '2026-07-09', 7), ('written', '2026-07-10', 10), ('written', '2026-07-11', 2), ('written', '2026-07-12', 11)]\nopens in test [('v14', 'asset', 'company', 148, 'gnews:49f225cd79fb22132f3b9ee4')]\nstate CANDIDATE (asset, object NVDA, focus \"NVIDIA FY2027 total revenue\", FY2027, due 2027-02-28): How much total revenue will NVIDIA report for FY2027?\nKey: measure=total_revenue, period_start=2026-02-01, period_end=2027-01-31, unit=USD\nLadder: Strongly bullish: Total revenue is at least $450 billion. / Bullish: Total revenue is at least $400 billion but less than $450 billion. / Neutral: Total revenue is at least $350 billion but less than $400 billion. / Bearish: Total revenue is at least $300 billion but less than $350 billion. / Strongly bearish: Total revenue is less than $300 billion.\nIts evidence: [Jeran Wittenstein, citing data compiled by Bloomberg ] The chipmaker is projected to deliver $228 billion in profits on sales of $393 billion in fiscal 2027, which ends Jan. 31. That would represent an expansion of 90% and 82%, respectively, according to data compiled by Bloomberg.\nrel__v9 {'criteria': {'cannot_tell': 'the supplied material is insufficient or inconsistent', 'different': 'different matters; sharing a company or industry is not enough', 'part_of': 'one asks about a strict component or subset of the other, in either direction; not identical', 'same_matter_different_quantity': 'one ongoing matter, two distinct quantities or events, neither a component of the other', 'same_quantity_or_event': 'both ask about the same defined quantity or the same event: alternative wordings, or two estimates or figures of that one quantity', 'same_quantity_other_period': 'the same defined quantity or event series for another period, such as the next fiscal or calendar year'}, 'instructions': 'What relationship holds between the CANDIDATE and the THESIS below? Use only the supplied text. Equal numbers and similar wording do not establish identity. THESIS:\\nv9 (open, NVDA, asset, focus \"NVIDIA FY2027 Data Center segment revenue\", FY2027, due 2027-02-28): How much Data Center segment revenue will NVIDIA report for FY2027?\\n    Ladder: Strongly bullish: FY2027 Data Center segment revenue is at least $450 billion. / Bullish: FY2027 Data Center segment revenue is at least $400 billion and below $450 billion. / Neutral: FY2027 Data Center segment revenue is at least $350 billion and below $400 billion. / Bearish: FY2027 Data Center segment revenue is at least $300 billion and below $350 billion. / Strongly bearish: FY2027 Data Center segment revenue is below $300 billion.\\n    Evidence: [tradingview.com ] During the first quarter of fiscal 2027, the Data Center segment generated $75.25 billion in revenues, accounting for 92% of total sales. Revenues from the segment surged 92% year over year and grew 21% sequentially, driven by the rapid ramp-up of Blackwell 300 systems and robust networking demand.\\n    Evidence: [NVIDIA 2026-07-07] NVIDIA is collaborating with Nokia to deliver AI-RAN platforms integrated with Nokia anyRAN software for AI-native 5G-Advanced networks ready for 6G evolution.', 'type': 'choice'}\nrel__v8 {'criteria': {'cannot_tell': 'the supplied material is insufficient or inconsistent', 'different': 'different matters; sharing a company or industry is not enough', 'part_of': 'one asks about a strict component or subset of the other, in either direction; not identical', 'same_matter_different_quantity': 'one ongoing matter, two distinct quantities or events, neither a component of the other', 'same_quantity_or_event': 'both ask about the same defined quantity or the same event: alternative wordings, or two estimates or figures of that one quantity', 'same_quantity_other_period': 'the same defined quantity or event series for another period, such as the next fiscal or calendar year'}, 'instructions': 'What relationship holds between the CANDIDATE and the THESIS below? Use only the supplied text. Equal numbers and similar wording do not establish identity. THESIS:\\nv8 (open, NVDA, asset, focus \"NVIDIA stand-alone CPU sales\", FY2027, due 2027-02-28): How much revenue will NVIDIA generate from stand-alone CPU sales in FY2027?\\n    Ladder: Strongly bullish: Stand-alone CPU sales exceed $25 billion in FY2027. / Bullish: Stand-alone CPU sales are at least $20 billion and no more than $25 billion in FY2027. / Neutral: Stand-alone CPU sales are at least $15 billion and less than $20 billion in FY2027. / Bearish: Stand-alone CPU sales are at least $10 billion and less than $15 billion in FY2027. / Strongly bearish: Stand-alone CPU sales are less than $10 billion in FY2027.\\n    Evidence: [fool.com (analyst) ] Intel has led here for years and holds more than 59% of total CPU market share\\n    Evidence: [fool.com (analyst) 2026-07-05] AMD has gained ground, progressing from a low of about 17% back in 2016 to 38% today.', 'type': 'choice'}\nv9 historical first links [('e74', 'During the first quarter of fiscal 2027, the Data Center segment generated $75.25 billion in revenues, accounting for 92% of total sales. Revenues from the segment surged 92% year over year and grew 21% sequentially, driven by the rapid ramp-up of Blackwell 300 systems and robust networking demand.'), ('e104', 'NVIDIA is collaborating with Nokia to deliver AI-RAN platforms integrated with Nokia anyRAN software for AI-native 5G-Advanced networks ready for 6G evolution.'), ('e105', 'SoftBank and NVIDIA recently reported stable outdoor 16-layer massive MU-MIMO operation on a GPU-based AI-RAN platform. The trial delivered roughly 3x the spectral efficiency of a conventional 4-layer baseline.'), ('e106', \"Earlier this week, Palantir announced that it is combining its new intelligence engine and Nvidia's Nemotron open AI models to deliver mission-focused AI for government agencies and major infrastructure operators in the U.S.\")]\nscope asset cases [('asset', 'company', 34), ('theme', 'theme', 9)]\nviews approx number first window [('v1', 'company', 1, 'financing_amount'), ('v2', 'company', 8, 'financing_amount'), ('v3', 'company', 8, 'event'), ('v4', 'company', 22, 'event'), ('v5', 'theme', 42, 'spend_total'), ('v6', 'theme', 42, 'spend_total'), ('v7', 'company', 45, 'event'), ('v8', 'company', 49, 'other'), ('v9', 'company', 62, 'segment_revenue'), ('v10', 'theme', 100, 'policy_event'), ('v11', 'company', 101, 'event'), ('v12', 'company', 122, 'event'), ('v13', 'company', 145, 'policy_event'), ('v14', 'company', 148, 'total_revenue')]\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_14","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"rg -n 'cap|reservation|one_attempt|Archive|response' scripts/budget_replay.py docs/research/2026-11-20-production-readiness/dependency-probe/probe.py\nrg -n 'supports|kind|dependency' docs/research/2026-11-14-use-acceptance/dependency-selection/SEPARATION-DESIGN.md | head -30\nnl -ba src/hivemind/research_context.py | sed -n '31,51p'\nnl -ba src/hivemind/views/store.py | sed -n '139,160p'\nnl -ba src/hivemind/vocabulary.py | sed -n '50,65p'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"rg -n 'cap|reservation|one_attempt|Archive|response' scripts/budget_replay.py docs/research/2026-11-20-production-readiness/dependency-probe/probe.py\nrg -n 'supports|kind|dependency' docs/research/2026-11-14-use-acceptance/dependency-selection/SEPARATION-DESIGN.md | head -30\nnl -ba src/hivemind/research_context.py | sed -n '31,51p'\nnl -ba src/hivemind/views/store.py | sed -n '139,160p'\nnl -ba src/hivemind/vocabulary.py | sed -n '50,65p'\"","aggregated_output":"rg: scripts/budget_replay.py: No such file or directory (os error 2)\ndocs/research/2026-11-20-production-readiness/dependency-probe/probe.py:13:token per character of the serialized request plus the full output allowance) is reserved against the cap, and stays charged when\ndocs/research/2026-11-20-production-readiness/dependency-probe/probe.py:14:the call fails with its usage unknown. A cap stop before both arms have three samples is reported as inconclusive.\ndocs/research/2026-11-20-production-readiness/dependency-probe/probe.py:31:def one_attempt(provider, request):\ndocs/research/2026-11-20-production-readiness/dependency-probe/probe.py:100:            archive = model.Archive(str(archive_path))\ndocs/research/2026-11-20-production-readiness/dependency-probe/probe.py:104:                # serialized request plus the full output allowance; when usage is unknown (an exception) the reservation stays charged\ndocs/research/2026-11-20-production-readiness/dependency-probe/probe.py:108:                    raise SystemExit(f'cap: spent ${spent:.4f} + worst ${worst:.4f} > ${CAP_USD}; stopped before {draw} {arm} {sample}: inconclusive')\ndocs/research/2026-11-20-production-readiness/dependency-probe/probe.py:111:                                        transport=one_attempt)\ndocs/research/2026-11-20-production-readiness/dependency-probe/probe.py:117:                charged = answer.cost_usd if (answer.input_tokens or answer.output_tokens) else worst   # a reply without usage keeps its reservation (round 6)\n1:# Design for the council's review: the two uses of a dependency edge, read apart (D538, under D439), 2026-11-15, $0\n8:explicit (2.2); rows written before a kind was stored have one versioned reading (2.3); the one-home requirement is stated as\n21:and two kinds of writer mean different things by it:\n25:| a seed file (`seeding.seed_views`; D208: \"each driver declaring the root it feeds\") | the driver **supports** the root | wrong way: the driver reads the root (D368 item 4; traced 2026-11-03, `../../2026-11-04-filing-end-to-end/core-problem.md`) | right: the driver is the narrower home |\n30:Each edge carries its kind, set by its writer and by nothing else: `supports` or `reads`. Each reader reads one derived relation.\n32:- **Reading relation** (judging): for a `reads` edge (B, A), B reads A's conclusion. For a `supports` edge (D, R), R reads D's.\n33:- **Narrower relation** (filing): for a `supports` edge (D, R), D is the narrower home than R. A `reads` edge states none.\n43:root-and-driver pairs, transitively) keeps the narrower one only\". The rule keeps this for `supports` edges and **does not apply\n45:and does not say that a dependency chosen by the matching call has no filing meaning. The council may take the interpretation\n57:An edge is proposed with its kind; the writer looks at the reading pair it would add (who would read whom).\n62:| B reads A (from `reads` (B, A)) | B reads A again, **another direction label** | **a conflict, refused and recorded, never dropped as a duplicate** (PRD 06: \"A dependency has one direction\"; within one answer the existing check already refuses \"same-key dependency direction conflicts\") |\n64:| R reads D (from `supports` (D, R)) | D reads R (`reads` (D, R)) | refused as a circle |\n65:| R reads D (from `supports` (D, R)) | R reads D again (`reads` (R, D), any label) | **not resolvable here: returned to the council.** The seed edge's label is `last_end`, written as a constant by the seeding module; no decision, design page, seed file or prompt defines it, so \"the same direction\" and \"a conflicting one\" cannot be told apart without inventing its meaning. The proof writes nothing and reports \"label undefined\" |\n66:| a longer path from the read question back to the reader, through edges of either kind | any edge that closes it | refused as a circle (PRD 06: \"Before adding an edge ... code checks for cycles\") |\n69:of a pair already given by the other kind would be the builder's.\n71:### 2.3 Rows written before a kind was stored\n73:A writer stores the kind when it writes the edge, and a reader never infers it from equal values. For rows already in stored\n77:seeding module's marks (sequence 0, direction `last_end`, on a question created from a seed file) and are read as `supports`;\n81:them and says nothing of a ledger kept elsewhere. A build refuses a row with neither set of marks and no stored kind (it raises\n86:A hierarchy between two questions is represented by a `supports` edge and by nothing else; only the seeding module writes one.\n98:| Case | The reading step linked | No stated hierarchy (today for article-opened questions; a `reads` edge) | A stated hierarchy (a `supports` edge; D265 read literally on a `reads` edge) | Expected, and by which words |\n116:| whether two questions are a driver and its root | identity | the writer of a `supports` edge (the seed file's author today) |\n120:So the contract this design can state for filing is narrow: **a `reads` edge moves no statement; a `supports` edge keeps D265's\n124:### 2.6 The unseeded path: what can happen to a dependency chosen at creation, and who already handles it (round 32)\n134:| a circle among the candidates of one answer; conflicting directions between same-key candidates | yes | PRD 06: \"Refuse a cycle and ask the model to correct it; persistent cycles follow normal failure handling\"; \"A dependency has one direction\" | `matching.check` and `identity.batch_plan` refuse; the refusal is in the match record | unchanged | the suite under the seam (`test_coalesced_dependency_is_refused_before_matching_retry_ends`) |\n135:| a circle against edges already stored | **yes, in one way** (corrected after round 33): nothing reads a question that is being created, except an existing question that was waiting for it. If the new question names that waiting question as its dependency, binding the waiting edge would close a circle; `resolve_waiting` checks and leaves the edge unbound, without a record | PRD 06, as above | `writing.write` drops the edge with a note in the article's record. **This differs from PRD 06 (refuse and ask for a correction)**; the difference predates this design and can only matter for a later addition | the cycle check walks the reading relation | proofs 1 and 2 (the check itself) |\n136:| a second edge for the same pair at a later article (a duplicate, or another direction) | **no**: only the later addition (D191 point 2, unbuilt) can produce it | \"A dependency has one direction\"; **what happens to a later conflicting proposal is not written in any decision** | no code path | 2.2 states the outcomes; the conflict's handling is recorded for the council, not decided here | the seam's outcomes (section 9, X) |\n139:| a crash after the article's commit; a round that dies midway | yes | D63 | the edge is in the commit or absent; a resumed round rebuilds its queue through the dependants | the queue reads the reading relation | the suite under the seam with one fixture's row restated as a chosen dependency: the resume test passes |\n140:| a row written before a kind was stored, read by the pages, the search records and the idea route | n/a | PRD 06 | `service.dependencies` and `service.dependants` read the stored row | for a `reads` row the service shows exactly what the candidate reads | all 399 questions with an edge in the 28 ledgers that hold such rows |\n144:dependency: 286) and `test_a_statement_filed_under_a_driver_and_its_root_keeps_the_driver_only`, which holds D265 in its literal\n    31\t    def rows(self, sql, args=()):\n    32\t        return [dict(r) for r in self.db.execute(sql, args)]\n    33\t\n    34\t    def dependencies(self, vid):\n    35\t        result = self.rows('select * from dependencies where view_id=? and seq<? order by seq,dependency_id', (vid,self.seq))\n    36\t        for dep in result:\n    37\t            res = self.rows('select * from dependency_resolutions where dependency_id=? and seq<? order by seq desc,id desc limit 1', (dep['dependency_id'],self.seq))\n    38\t            dep['resolved_to'] = res[0]['resolved_to'] if res else dep['depends_on']\n    39\t            dep['resolution'] = res[0] if res else None\n    40\t        return result\n    41\t\n    42\t    def question(self, row):\n    43\t        vid = row['view_id']\n    44\t        switches = self.rows('select * from view_switches where view_id=? and after_seq<? order by after_seq desc,id desc limit 1', (vid,self.seq))\n    45\t        if not switches:\n    46\t            raise ValueError('question has no historical open/closed state: ' + vid)\n    47\t        keys = self.rows('select * from view_keys where view_id=? and seq<?', (vid,self.seq))\n    48\t        return dict(row, open=bool(switches[0]['open']),\n    49\t                    rungs=self.rows('select * from rungs where view_id=? order by position', (vid,)),\n    50\t                    key=keys[0] if keys else None, dependencies=self.dependencies(vid))\n    51\t\n   139\tdef ensure_writable_columns(conn):\n   140\t    \"\"\"Upgrade columns at a write boundary, including a legacy database restored into an open connection.\"\"\"\n   141\t    ensure_key_columns(conn)\n   142\t    ensure_group_tables(conn)\n   143\t    columns = {r[1] for r in conn.execute('pragma table_info(rungs)')}\n   144\t    for field in ('lo', 'hi'):\n   145\t        if field not in columns:\n   146\t            conn.execute(f'alter table rungs add column {field} real')\n   147\t    judgement_columns = {r[1] for r in conn.execute('pragma table_info(judgements)')}\n   148\t    if 'theme_pushes_json' not in judgement_columns:\n   149\t        conn.execute('alter table judgements add column theme_pushes_json text')     # D195: judgements written before the theme block read as []\n   150\t    for field in ('reference', 'implied_outcome'):\n   151\t        if field not in judgement_columns:\n   152\t            conn.execute(f'alter table judgements add column {field} text')        # D260: judgements written before the stance fields read as null\n   153\t\n   154\t\n   155\tdef view_key(conn, view_id):\n   156\t    if not conn.execute('pragma table_info(view_keys)').fetchone():\n   157\t        return None\n   158\t    row = conn.execute('select * from view_keys where view_id=?', (view_id,)).fetchone()\n   159\t    if not row:\n   160\t        return None\n    50\t\n    51\t\n    52\tdef candidate(c):\n    53\t    \"\"\"A handover candidate (fresh or saved) with canonical kind and labels.\"\"\"\n    54\t    return dict(c, kind=canonical('kind', c.get('kind')), rungs=[dict(r, label=canonical('label', r.get('label'))) for r in c.get('rungs', [])])\n    55\t\n    56\t\n    57\tdef matching_answer(data):\n    58\t    \"\"\"A matching answer with canonical candidate outcomes, evidence outcomes and dependency directions.\"\"\"\n    59\t    out = dict(data)\n    60\t    out['candidates'] = [dict(d, outcome=canonical('candidate_outcome', d.get('outcome')),\n    61\t                              dependencies=[dict(dep, direction=canonical('direction', dep.get('direction'))) for dep in d.get('dependencies', [])])\n    62\t                         for d in data.get('candidates', [])]\n    63\t    out['evidence'] = [dict(d, outcome=canonical('evidence_outcome', d.get('outcome'))) for d in data.get('evidence', [])]\n    64\t    return out\n    65\t\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_15","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"rg -n 'check_ladder|normalise_ladder|\\\\[.lo.\\\\]|getting|view_key' src/hivemind/extraction.py\nrg -n 'research_context|Reader\\\\(' scripts src tests --glob '*.py'\nrg -n 'live_lock\\\\.acquire|dispatch\\\\.route|next_sequence' scripts/replay.py src/hivemind/replay.py src/hivemind/dispatch.py\nnl -ba src/hivemind/views/matching.py | sed -n '258,278p;303,391p'\nnl -ba AGENTS.md | sed -n '101,147p;218,235p'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"rg -n 'check_ladder|normalise_ladder|\\\\[.lo.\\\\]|getting|view_key' src/hivemind/extraction.py\nrg -n 'research_context|Reader\\\\(' scripts src tests --glob '*.py'\nrg -n 'live_lock\\\\.acquire|dispatch\\\\.route|next_sequence' scripts/replay.py src/hivemind/replay.py src/hivemind/dispatch.py\nnl -ba src/hivemind/views/matching.py | sed -n '258,278p;303,391p'\nnl -ba AGENTS.md | sed -n '101,147p;218,235p'\"","aggregated_output":"48:    return [dict(v, key=store.view_key(conn, v['view_id']) or {},\n411:def check_ladder(rungs, kind):\n413:    Strongly bullish (the model often orders a revenue ladder by rising value) is the same ladder; normalise_ladder\n426:def normalise_ladder(rungs, kind):\n500:    ordered = sorted(rungs, key=lambda r: -1e300 if r.get('lo') is None else float(r['lo']))\n502:        if a.get('hi') is None or b.get('lo') is None or float(a['hi']) != float(b['lo']):\n620:        problem = check_ladder(c['rungs'], c['kind'])\n624:        c = dict(c, rungs=normalise_ladder(c['rungs'], c['kind']))\nscripts/report.py:90:        for row in csv.DictReader(open(path, encoding='utf-8')):\nscripts/idea_eval.py:38:        for row in csv.DictReader(handle):\nscripts/agent_day0.py:42:        rows = list(csv.DictReader(open(args.beliefs, encoding='utf-8')))\nscripts/search_eval.py:61:        for row in csv.DictReader(handle):\ntests/test_research_context.py:10:from hivemind import research_context as context, universe  # noqa: E402\ntests/test_research_context.py:43:    with context.Reader(path,20,['NVDA'],uni) as reader:\ntests/test_research_context.py:77:    with context.Reader(path,20,['NVDA'],uni) as reader:\ntests/test_research_context.py:116:    with context.Reader(path,20,['NVDA'],uni) as reader:\ntests/test_research_context.py:130:    with context.Reader(path,20,['NVDA'],uni) as reader:\ntests/test_research_context.py:133:    with context.Reader(path,1,['NVDA'],uni) as reader:\nsrc/hivemind/dispatch.py:51:    sequence_no = store.next_sequence(conn)\nsrc/hivemind/replay.py:83:            route = dispatch.route(conn, item, universe)\nsrc/hivemind/replay.py:119:        seq = store.next_sequence(conn) - 1\nsrc/hivemind/replay.py:130:        store.complete_day(conn, day, store.next_sequence(conn) - 1, time.strftime('%Y-%m-%dT%H:%M:%S'))\n   258\t\n   259\t@dataclasses.dataclass\n   260\tclass Checked:\n   261\t    outcomes: dict         # candidate id -> (outcome, target or None, dependencies list)\n   262\t    evidence: dict         # (evidence id, view_id) -> (outcome, target_evidence_id or None, said_day)\n   263\t    refusals: list\n   264\t    not_opened: dict       # candidate id -> reason\n   265\t    notes: list = dataclasses.field(default_factory=list)\n   266\t\n   267\t\n   268\tdef check(conn, universe, decisions, candidates, evidence, lists, shown_views):\n   269\t    decisions = vocabulary.matching_answer(decisions)\n   270\t    candidates = [vocabulary.candidate(c) for c in candidates]\n   271\t    shown_ids = {v['view_id'] for v in shown_views}\n   272\t    candidate_by_id = {c['id']: c for c in candidates}\n   273\t    # D51: a dependency is chosen among the views the model has in front of it: every list shown in this call,\n   274\t    # the views shown at extraction, and the candidates this answer opens\n   275\t    listed_all = set(shown_ids)\n   276\t    for hits in lists.candidate_lists.values():\n   277\t        listed_all.update(hits)\n   278\t    refusals, outcomes, not_opened, notes = [], {}, {}, []\n   303\t            if target_key and identity.conflicts(target_key, c, merging=outcome == 'merge'):\n   304\t                notes.append(f'candidate {c[\"id\"]}: {outcome} into {target} refused by key ({target_key[\"measure\"]}[{target_key[\"scope\"]}] {target_key[\"period_start\"]}..{target_key[\"period_end\"]} ≠ {c[\"measure\"]}[{c.get(\"scope\", \"\")}] {c.get(\"period_start\", \"\")}..{c.get(\"period_end\", \"\")}); opened as a new view')\n   305\t                outcome, target = 'new', ''\n   306\t                d = dict(d, outcome=outcome, target_view_id='')\n   307\t        if outcome == 'new' and identity.automatic_key(c) is not None:\n   308\t            # rule 2 for a key code owns entirely: one open view with the same key and period is the same quantity; the model is not asked twice\n   309\t            twins = [v for v in lists.candidate_lists.get(c['id'], []) if _same_key(store.view_key(conn, v), c, (store.view(conn, v) or {}).get('object_id')) and store.is_open(conn, v)]\n   310\t            if len(twins) == 1:\n   311\t                notes.append(f'candidate {c[\"id\"]}: opened as new by the model, merged into {twins[0]} by its key ({c[\"measure\"]}[{c.get(\"scope\", \"\")}] {c.get(\"period_start\", \"\")}..{c.get(\"period_end\", \"\")})')\n   312\t                outcome, target = 'merge', twins[0]\n   313\t                d = dict(d, outcome=outcome, target_view_id=target)\n   314\t        if outcome in ('merge', 'succession'):\n   315\t            if target not in listed:\n   316\t                refusals.append(f'candidate {c[\"id\"]}: target {target!r} not in its list')\n   317\t                continue\n   318\t            if outcome == 'merge' and not store.is_open(conn, target):\n   319\t                refusals.append(f'candidate {c[\"id\"]}: cannot attach to closed view {target}')\n   320\t                continue\n   321\t            if outcome == 'succession':\n   322\t                if conn.execute('select 1 from successions where succeeds=?', (target,)).fetchone():\n   323\t                    refusals.append(f'candidate {c[\"id\"]}: {target} already has a successor')\n   324\t                    continue\n   325\t                first = succession_targets.get(target)\n   326\t                if first is not None and (identity.automatic_key(c) is None or identity.automatic_key(c) != identity.automatic_key(first)):\n   327\t                    refusals.append(f'candidate {c[\"id\"]}: {target} can have one successor; {first[\"id\"]} already succeeds it in this answer')\n   328\t                    continue\n   329\t                succession_targets.setdefault(target, c)             # a second wording with the same code-owned key is the same successor (coalesced by batch_plan)\n   330\t                # 06-views: a successor keeps the predecessor's direction; the writer stores a numeric ladder in that direction (the first\n   331\t                # real succession, 2027 hyperscaler capex after 2026, came low-to-high where its predecessor ran high-to-low), so no refusal here\n   332\t        if outcome in ('new', 'succession'):\n   333\t            object_id = universe.resolve(c['object'])\n   334\t            if not object_id:\n   335\t                not_opened[c['id']] = f'object {c[\"object\"]!r} not on the research list'\n   336\t                if c['kind'] == 'theme':\n   337\t                    store.pool(conn, 'suggested_theme', c['object'], {'question': c['question'], 'input_id': None}, 0)\n   338\t                outcomes[c['id']] = ('skip', None, [])\n   339\t                continue\n   340\t            outcomes[c['id']] = (outcome, target or None, [])\n   341\t            raw_deps[c['id']] = d.get('dependencies', [])\n   342\t        elif outcome == 'merge':\n   343\t            outcomes[c['id']] = (outcome, target, [])\n   344\t        else:\n   345\t            outcomes[c['id']] = ('skip', None, [])\n   346\t            not_opened[c['id']] = d.get('reason', '')\n   347\t    # dependencies, once every candidate's outcome is known\n   348\t    opened = {cid for cid, (outcome, _, _) in outcomes.items() if outcome in ('new', 'succession')}\n   349\t    for cid, dependencies in raw_deps.items():\n   350\t        deps = []\n   351\t        bad = False\n   352\t        for dep in dependencies:\n   353\t            view_id, chain, year = dep['view_id'].strip(), dep['wait_chain_view_id'].strip(), dep['wait_year'].strip()\n   354\t            if view_id:\n   355\t                if view_id in candidate_by_id and view_id not in opened:\n   356\t                    refusals.append(f'candidate {cid}: dependency {view_id} is a candidate that is not opened')\n   357\t                    bad = True\n   358\t                    break\n   359\t                if view_id not in listed_all and view_id not in candidate_by_id:\n   360\t                    refusals.append(f'candidate {cid}: dependency {view_id} was not shown')\n   361\t                    bad = True\n   362\t                    break\n   363\t                if view_id == cid:\n   364\t                    refusals.append(f'candidate {cid}: depends on itself')\n   365\t                    bad = True\n   366\t                    break\n   367\t                deps.append({'view_id': view_id, 'wait_chain_view_id': None, 'wait_year': None, 'direction': dep['direction']})\n   368\t            elif chain and year:\n   369\t                if chain not in listed_all and chain not in candidate_by_id:\n   370\t                    refusals.append(f'candidate {cid}: waited chain {chain} was not shown')\n   371\t                    bad = True\n   372\t                    break\n   373\t                deps.append({'view_id': None, 'wait_chain_view_id': chain, 'wait_year': year, 'direction': dep['direction']})\n   374\t        if bad:\n   375\t            continue\n   376\t        outcomes[cid] = (outcomes[cid][0], outcomes[cid][1], deps)\n   377\t    # no cycle among the candidates of one answer (06-views: 会的话这条不收，退回给模型改)\n   378\t    graph = {cid: [d['view_id'] for d in outcomes[cid][2] if d['view_id'] in candidate_by_id] for cid in raw_deps if cid in outcomes}\n   379\t    for cid in graph:\n   380\t        stack, seen = list(graph[cid]), set()\n   381\t        while stack:\n   382\t            current = stack.pop()\n   383\t            if current == cid:\n   384\t                refusals.append(f'candidate {cid}: its dependencies lead back to itself')\n   385\t                break\n   386\t            if current in seen:\n   387\t                continue\n   388\t            seen.add(current)\n   389\t            stack.extend(graph.get(current, []))\n   390\t    _, coalescing_errors = identity.batch_plan(candidates, outcomes)\n   391\t    refusals.extend(coalescing_errors)\n   101\t2. **Value × reader.** Every value a change writes, against every reader of it (found by searching the field) and every input source the\n   102\t   value can come from. A rule over a kind of data lists every writer of that kind. A change to how often something fires is counted\n   103\t   against every reader of its output.\n   104\t3. **New path × old checks.** For a new input, derived value, mode or changed data shape: every check the old path passes, and whether\n   105\t   the new one meets it. A changed shape re-derives every check written for the old one.\n   106\t4. **Prior decisions.** The decisions searched for the mechanism by name; any decision that rejected or bounded it is quoted in the\n   107\t   design and in the question to Alex.\n   108\t\n   109\t- A contract over text or shapes states the closed set of what passes (a full match); anything else fails or is not judged. Enumerate\n   110\t  the accepted set against every context and reader it meets before the first edit.\n   111\t- **Code owns identity, never importance.** Before building a closed list, enum or gate, write which decision it takes from the model\n   112\t  and whether that decision is identity (\"are these the same thing?\") or judgement (\"does this matter?\"); build only the identity part.\n   113\t  A list of what matters is at most a hint shown to the model (Alex, 2026-10-25: \"你这个做法难道不是非常的限死吗？永远都是一堆财务指标，真正的观点呢？\").\n   114\t- **No case-fitted fix.** A hand list, a special path or a rule fitted to the case in view fixes that case and breaks the next. First ask\n   115\t  whether the judge had the material and the definition it needed, and whether a typed field is missing; run the proposal against the\n   116\t  existing tests and the gold for a counter-example before building (D167: \"我不要 hardcode 解法 it's premature optimization, not general root fix\").\n   117\t- A blind review measures the tables. A serious finding they do not hold shows a missing dimension: add it and walk every row again,\n   118\t  never answer the finding alone. Code starts when the review finds nothing serious. A design whose core contract is still open is a\n   119\t  question, not something to build.\n   120\t- A foundation's acceptance carries a size and speed budget from its first control, not only correctness.\n   121\t\n   122\t## 3. Writing code\n   123\t\n   124\t- **One owner.** A rule lives where the data is written, and refuses: a warning that lets the run continue is a silent failure. Fix the\n   125\t  writer and delete its duplicate implementations in the same change; when a fix lands in one consumer, search every consumer of the\n   126\t  same key or rule.\n   127\t- **Code over prose.** A contract that code or a schema can enforce (an enum over allowed keys, a shape) is enforced there, and stays out\n   128\t  of prompts and documents.\n   129\t- **One word per concept.** The glossary in `docs/prd/00-system.md` (section Glossary; D36, D163) names each concept once, and\n   130\t  `docs/check.py` fails on a word it rules out. A new concept gets its row and its ruled-out words in the same change; a new ruled-out\n   131\t  word must catch the sentence it was written against and pass the corrected one.\n   132\t- **Identity.** An identifier names one thing for the life of its scope; a changed thing gets a new id. Equal values alone never\n   133\t  establish identity (D248 boundary 7, the same statement carried by several outlets, is a chosen exception, switched on only after its\n   134\t  merge risk on the gold and the accuracy of the original speaker and day fields are measured).\n   135\t- **Explicit inputs.** Library code takes runtime paths and configuration as arguments. A branch a run takes comes from its\n   136\t  configuration, never from whether an environment variable happens to be set; a configured step whose credential is missing refuses\n   137\t  the run. A component that sends a model call uses the transport its caller passes.\n   138\t- **Never order by the wall clock.** It steps both ways; order comes from a sequence the program owns: dispatch's sequence number. The\n   139\t  stream never reads the calendar; only pull mode acts on time, with its \"now\" passed in (D12, D13, D31).\n   140\t- **Strictness is code too.** A check added to prevent defects can itself fail; accept it on real data, not samples.\n   141\t- **Style.** Descriptive names. Docstrings and comments state behaviour, not history. The standard library unless a measured need\n   142\t  justifies a dependency.\n   143\t- **Frontend presentation.** Follow the sentence-case and metadata-separator rules in `docs/poc/thesis-ui.md#presentation-rules`.\n   144\t\n   145\t## 4. Tests\n   146\t\n   147\t- Every test names the requirement or table row it proves; a test that traces to none is deleted, and a retired behaviour's tests leave\n   218\t  Alex, 2026-10-29 (D237): \"It needs to be general purpose as a hedge fund brain. I keep on telling you this, and you keep on cherry\n   219\t  picking the results just to meet the metrics or the benchmarks\".\n   220\t- **Never grow a prompt to fix quality.** Read the whole request (system, schema, payload) as the model reads it, and list every\n   221\t  contradiction, rule written for another case, instruction that forces the defect, reference the model cannot read, payload field the\n   222\t  answer does not need, and call doing several jobs. Cut, merge or split. Add an instruction only when the audit shows one is missing,\n   223\t  and remove at least as much elsewhere. Report characters and prompt tokens before and after; growth needs a written reason.\n   224\t- **Trace a miss to the raw answer first.** Class it as not written, refused (by which check) or split. Check that the request shows what\n   225\t  the answer needs and the schema can express it before changing any wording.\n   226\t- **An example is an instruction.** It must agree with the standard, the schema and the code that reads the answer, or it goes.\n   227\t- **A classification the model must make is written as a closed set with examples:** two or three examples per class, the procedure\n   228\t  (walk the whole page, first paragraph to last) and the stopping point (\"a page with eight such statements yields eight evidence\n   229\t  items\"). An abstract clause (\"a material statement\") is a coin flip per send. The examples are not growth to avoid; the abstract clause\n   230\t  they replace is cut.\n   231\t- **Check before the send, at no cost.** Write one answer that follows the prompt and run every code check on it: a request never asks\n   232\t  for what a check refuses, and a retry that repairs a refusal is a symptom, not handling. Read every contract line against each gold\n   233\t  case it must accept and reject. Rebuild a stored request from the stored request, never from a ledger that moves, and check every\n   234\t  identity before a paid send.\n   235\t- **Build where code decides.** A decision code can make is moved out of the model, not sampled (identity only, §2).\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_16","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba src/hivemind/extraction.py | sed -n '486,523p;600,660p'\nnl -ba src/hivemind/jev.py | sed -n '85,130p'\nrg --files | rg '/budget_replay\\\\.py\"'$'\"'\nnl -ba src/hivemind/replay.py | sed -n '51,69p;104,131p'\nnl -ba src/hivemind/views/writing.py | sed -n '46,69p;108,156p'\nnl -ba tests/test_frozen_questions_and_judgement.py | sed -n '1,43p'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba src/hivemind/extraction.py | sed -n '486,523p;600,660p'\nnl -ba src/hivemind/jev.py | sed -n '85,130p'\nrg --files | rg '/budget_replay\\\\.py\"'$'\"'\nnl -ba src/hivemind/replay.py | sed -n '51,69p;104,131p'\nnl -ba src/hivemind/views/writing.py | sed -n '46,69p;108,156p'\nnl -ba tests/test_frozen_questions_and_judgement.py | sed -n '1,43p'\"","aggregated_output":"   486\t\n   487\t\n   488\tdef extract(archive, cfg, item, text, shown_views, universe, *, transport=None):\n   489\t    \"\"\"One item through extraction: read, then file under the questions shown.\"\"\"\n   490\t    return file_reading(read_item(archive, cfg, item, text, shown_views, universe, transport=transport), item, shown_views)\n   491\t\n   492\t\n   493\tdef check_bounds(rungs):\n   494\t    \"\"\"None when the rungs' numeric bounds form one unbroken partition (or none carries bounds), else the problem.\"\"\"\n   495\t    bounded = [r for r in rungs if r.get('lo') is not None or r.get('hi') is not None]\n   496\t    if not bounded:\n   497\t        return None\n   498\t    if len(bounded) != len(rungs):\n   499\t        return 'some rungs carry bounds and some do not'\n   500\t    ordered = sorted(rungs, key=lambda r: -1e300 if r.get('lo') is None else float(r['lo']))\n   501\t    for a, b in zip(ordered, ordered[1:]):\n   502\t        if a.get('hi') is None or b.get('lo') is None or float(a['hi']) != float(b['lo']):\n   503\t            return 'rung bounds overlap or leave a gap'\n   504\t    if ordered[-1].get('hi') is not None:\n   505\t        return 'the top rung must be open above'\n   506\t    return None\n   507\t\n   508\t\n   509\tdef check_group_refs(c, declared):\n   510\t    \"\"\"None when a candidate's research-group references are well formed: no repeats, each a declared local id; empty is allowed\n   511\t    (a company's own financial line belongs to the company, not to a group); else the problem.\"\"\"\n   512\t    refs = c.get('group_refs')\n   513\t    if refs is None:\n   514\t        return None\n   515\t    if len(refs) != len(set(refs)):\n   516\t        return 'group_refs repeats a group'\n   517\t    unknown = [r for r in refs if r not in declared]\n   518\t    if unknown:\n   519\t        return f'group_refs cites a group not declared in this answer: {unknown}'\n   520\t    return None\n   521\t\n   522\t\n   523\tdef check_admission(c, publication_day):\n   600\t    for c in candidates:\n   601\t        ids = list(dict.fromkeys(alias.get(i, i) for i in c['evidence_ids'] if alias.get(i, i) in kept_ids))\n   602\t        if not ids and item.get('publisher_type') != SELF_PUBLISHER_TYPE:\n   603\t            dropped.append((c['id'], 'candidate without surviving evidence'))\n   604\t            continue\n   605\t        kept.append(dict(c, evidence_ids=ids))\n   606\t    return kept\n   607\t\n   608\t\n   609\tdef sift(data, item, text, shown_ids, universe=None):\n   610\t    \"\"\"05-extraction step 3, the code checks on one answer: ladders, the quarter and year rules, due days, quotes in\n   611\t    the text, links to shown questions or kept candidates, one piece per sentence. A statement whose links all fail keeps an empty\n   612\t    list; the handover drops it as 'no home'. Returns (evidence, candidates, dropped); the preflight runs it over every stored answer.\n   613\t    The answer is read in the canonical vocabulary; a bare year is a calendar year.\"\"\"\n   614\t    data = vocabulary.extraction_answer(data)\n   615\t    body = normalise(text)\n   616\t    dropped = []\n   617\t    candidates = []\n   618\t    candidate_ids = set()\n   619\t    for c in data.get('candidates', []):\n   620\t        problem = check_ladder(c['rungs'], c['kind'])\n   621\t        if problem:\n   622\t            dropped.append((c['id'], f'candidate ladder: {problem}'))\n   623\t            continue\n   624\t        c = dict(c, rungs=normalise_ladder(c['rungs'], c['kind']))\n   625\t        if QUARTERLY.search(c['looks_at'] + ' ' + c['question']) and c['kind'] == 'asset' \\\n   626\t                and c.get('measure') not in ('event', 'policy_event'):          # a dated event that names its quarter is not a quarterly figure\n   627\t            dropped.append((c['id'], 'quarterly number: evidence, not a view (06-views ladder rule 6)'))\n   628\t            continue\n   629\t        if c.get('measure') not in ('event', 'policy_event') and c.get('opens_as') != 'binding_obligation' \\\n   630\t                and beyond_next_year(c['year'], item['publication_day'], c.get('object'), universe):\n   631\t            dropped.append((c['id'], f'year {c[\"year\"]} is beyond next year: not opened (06-views 不开)'))\n   632\t            continue\n   633\t        if not re.match(r'\\d{4}-\\d{2}-\\d{2}$', c['due_day']):\n   634\t            dropped.append((c['id'], f'due_day not a date: {c[\"due_day\"]!r}'))\n   635\t            continue\n   636\t        if c['due_day'] <= item['publication_day']:\n   637\t            dropped.append((c['id'], f'due_day {c[\"due_day\"]} not after the item'))\n   638\t            continue\n   639\t        if 'opens_as' in c:           # D184: the schema guarantees the fields, code checks their shape\n   640\t            problem = check_admission(c, item['publication_day'])\n   641\t            if problem:\n   642\t                dropped.append((c['id'], f'candidate admission: {problem}'))\n   643\t                continue\n   644\t        if c.get('measure'):          # keyed candidates keep their actual scope; reference lists do not gate admission (D155)\n   645\t            problem = check_bounds(c['rungs'])\n   646\t            if problem:\n   647\t                dropped.append((c['id'], f'candidate ladder bounds: {problem}'))\n   648\t                continue\n   649\t            if universe is not None:\n   650\t                object_id = universe.resolve(c['object']) or c['object']\n   651\t                scope, source = universe.scope_and_source(object_id, c['measure'], c.get('scope', ''), c.get('event_type', 'n/a'))\n   652\t                c = dict(c, object=object_id, scope=scope, scope_source=source, key_version=2)\n   653\t                if c['measure'] not in ('event', 'policy_event'):\n   654\t                    period = universe.fiscal_period(object_id, c.get('year', ''), bare_is_calendar=True)                             # and the period of a yearly number\n   655\t                    if period:\n   656\t                        c = dict(c, period_start=period[0], period_end=period[1])\n   657\t            try:\n   658\t                start = datetime.date.fromisoformat(c['period_start'])\n   659\t                end = datetime.date.fromisoformat(c['period_end'])\n   660\t                if start > end:\n    85\t\n    86\t\n    87\tdef ask(archive, cfg, setting, state, questions, purpose, *, transport=None):\n    88\t    \"\"\"One Jev request, archived; returns model.Answer whose data is the `answers` map.\"\"\"\n    89\t    request = request_for(setting, state, questions)\n    90\t    request_json, sha = model.request_identity(request)\n    91\t    prompt_chars = len(request_json)\n    92\t    hit = archive.lookup(sha)\n    93\t    if hit:\n    94\t        call_id, answer_json, _, input_tokens, output_tokens = hit\n    95\t        return model.Answer(json.loads(answer_json), call_id, sha, True, prompt_chars, input_tokens or 0, output_tokens or 0, 0.0)\n    96\t    started = time.time()\n    97\t    response = (transport or globals()['transport'])(request)\n    98\t    seconds = round(time.time() - started, 2)\n    99\t    answers = response.get('answers') if isinstance(response, dict) else None\n   100\t    problems = validate(answers, questions)\n   101\t    usage = response.get('usage') or {} if isinstance(response, dict) else {}\n   102\t    input_tokens, output_tokens = int(usage.get('input_tokens') or 0), int(usage.get('output_tokens') or 0)\n   103\t    price_in, _ = model.PRICES.get(setting.model, (0.0, 0.0))\n   104\t    cost = round(input_tokens / 1e6 * price_in, 6)\n   105\t    call_id = archive.record(purpose=purpose, config_version=cfg.version, config_checksum=cfg.checksum, model=setting.model,\n   106\t                             request_sha256=sha if not problems else sha + ':schema:' + uuid.uuid4().hex[:8], request_json=request_json,\n   107\t                             response_json=json.dumps(response, ensure_ascii=False)[:200000], answer_json=json.dumps(answers, ensure_ascii=False) if answers is not None else None,\n   108\t                             prompt_chars=prompt_chars, input_tokens=input_tokens, output_tokens=output_tokens, cost_usd=cost,\n   109\t                             seconds=seconds, created_at=time.strftime('%Y-%m-%dT%H:%M:%S'))\n   110\t    if problems:\n   111\t        raise model.SchemaError('; '.join(problems[:5]))\n   112\t    return model.Answer(answers, call_id, sha, False, prompt_chars, input_tokens, output_tokens, cost)\nclean-arch/e2e-comparison-2026-11-13/budget_replay.py\n    51\tdef run(*, testdb_path, views_path, archive, cfg, universe, from_day, until_day, day0=None, spend_cap_usd=None,\n    52\t        transport=None, log=print, only_objects=None, max_items_per_day=None, day_runner=None):\n    53\t    items_db = testdb.open_db(testdb_path)\n    54\t    conn = store.open_db(views_path)\n    55\t    refuse_unfinished_parallel(conn)\n    56\t    last_done = store.last_completed_day(conn)\n    57\t    start = from_day\n    58\t    if last_done and from_day <= last_done:\n    59\t        next_day = (datetime.date.fromisoformat(last_done) + datetime.timedelta(days=1)).isoformat()\n    60\t        if next_day > until_day:\n    61\t            raise BackdatingError(f'views database already completed {last_done}; nothing to run before it')\n    62\t        log(f'resuming after the last completed day {last_done}')\n    63\t        start = next_day\n    64\t    last_written = conn.execute('select max(publication_day) from processing_steps where sequence_no > 0').fetchone()[0]\n    65\t    if last_written and start < last_written:\n    66\t        raise BackdatingError(f'views database already holds rounds of {last_written}; a replay cannot start before it (D31)')\n    67\t    totals = {'items': 0, 'extracted': 0, 'skipped': 0, 'merged': 0, 'not_processed': 0, 'returned': 0, 'failed': 0,\n    68\t              'evidence': 0, 'new_views': 0, 'judged': 0, 'changed': 0, 'closed': 0}\n    69\t    calls_before, cost_before, *_ = archive.totals()\n   104\t                day_stats['evidence'] += result.evidence\n   105\t                day_stats['new_views'] += result.new_views\n   106\t                day_stats['judged'] += result.judged\n   107\t                day_stats['changed'] += result.changed\n   108\t                if result.failed:\n   109\t                    day_stats['failed'] += 1\n   110\t                    log(f'  ! {result.input_id[:60]}: {result.failed}')\n   111\t                    raise RuntimeError(f'item failed; day {day} remains resumable: {result.failed}')\n   112\t                if spend_cap_usd is not None and archive.totals()[1] - cost_before > spend_cap_usd:\n   113\t                    raise RuntimeError(f'spend cap {spend_cap_usd} reached on {day}')\n   114\t        finally:\n   115\t            if hasattr(results, 'close'):\n   116\t                results.close()\n   117\t        if finished != len(to_run):\n   118\t            raise RuntimeError('day runner did not complete every routed item')\n   119\t        seq = store.next_sequence(conn) - 1\n   120\t        judged = round_module.judge_day(conn, archive, cfg, day, seq, transport=transport, log=log)\n   121\t        day_stats['judged'] += judged.judged\n   122\t        day_stats['changed'] += judged.changed\n   123\t        if judged.failed:\n   124\t            day_stats['failed'] += 1\n   125\t            log(f'  ! day judging: {judged.failed}')\n   126\t            raise RuntimeError(f'judging failed; day {day} remains resumable: {judged.failed}')\n   127\t        closed = pull.end_of_day(conn, day, seq)\n   128\t        day_stats['closed'] = len(closed)\n   129\t        # The day ends at the last sequence it wrote, a closing's own sequence on a day without items included, so the next day starts after it.\n   130\t        store.complete_day(conn, day, store.next_sequence(conn) - 1, time.strftime('%Y-%m-%dT%H:%M:%S'))\n   131\t        conn.commit()\n    46\t    return view_id\n    47\t\n    48\t\n    49\tdef resolve_waiting(conn, new_view_id, seq, changed):\n    50\t    \"\"\"A new view on a chain satisfies dependencies waiting for its year on that chain.\"\"\"\n    51\t    v = store.view(conn, new_view_id)\n    52\t    chain = {new_view_id}\n    53\t    frontier = [new_view_id]\n    54\t    while frontier:\n    55\t        current = frontier.pop()\n    56\t        for row in conn.execute('select succeeds from successions where view_id=?', (current,)):\n    57\t            if row['succeeds'] not in chain:\n    58\t                chain.add(row['succeeds'])\n    59\t                frontier.append(row['succeeds'])\n    60\t    for dep in conn.execute('select * from dependencies where wait_year=? and wait_chain_view_id is not null', (v['year'],)):\n    61\t        if dep['wait_chain_view_id'] in chain:\n    62\t            already = conn.execute('select 1 from dependency_resolutions where dependency_id=?', (dep['dependency_id'],)).fetchone()\n    63\t            if not already and not store.would_cycle(conn, dep['view_id'], new_view_id):\n    64\t                store.insert(conn, 'dependency_resolutions', dependency_id=dep['dependency_id'], resolved_to=new_view_id, reason='created', seq=seq)\n    65\t                changed.add(dep['view_id'])\n    66\t\n    67\t\n    68\tdef object_id_of(universe, candidate):\n    69\t    return universe.resolve(candidate['object']) or candidate['object']\n   108\tclass WriteConflict(ValueError):\n   109\t    \"\"\"The checked plan no longer fits the writable ledger; no partial write is retained.\"\"\"\n   110\t\n   111\t\n   112\tdef write(conn, universe, seq, item, handover, checked, second_pass):\n   113\t    \"\"\"Write atomically within the caller's transaction; the caller commits the completion marker with it.\"\"\"\n   114\t    if not conn.in_transaction:\n   115\t        conn.execute('begin immediate')\n   116\t    conn.execute('savepoint view_write')\n   117\t    try:\n   118\t        store.ensure_writable_columns(conn)\n   119\t        result = _write(conn, universe, seq, item, handover, checked, second_pass)\n   120\t    except Exception:\n   121\t        conn.execute('rollback to view_write')\n   122\t        conn.execute('release view_write')\n   123\t        raise\n   124\t    conn.execute('release view_write')\n   125\t    return result\n   126\t\n   127\t\n   128\tdef _write(conn, universe, seq, item, handover, checked, second_pass):\n   129\t    \"\"\"second_pass: {(handover evidence id, view_id): (outcome, target_evidence_id, said_day)} for candidate-linked\n   130\t    evidence compared after the candidates' destinations were known (new views' evidence is simply new).\"\"\"\n   131\t    changed, notes, new_views, evidence_ids = set(), [], {}, {}\n   132\t    candidate_ids = {c['id'] for c in handover.candidates}\n   133\t    aliases, problems = identity.batch_plan(handover.candidates, checked.outcomes)\n   134\t    if problems:\n   135\t        raise WriteConflict('; '.join(problems))\n   136\t    created = {}\n   137\t    # 1. new views, themes first\n   138\t    order = sorted(handover.candidates, key=lambda c: 0 if c['kind'] == 'theme' else 1)\n   139\t    for c in order:\n   140\t        outcome, target, deps = checked.outcomes.get(c['id'], ('skip', None, []))\n   141\t        if outcome not in ('new', 'succession'):\n   142\t            continue\n   143\t        canonical = aliases[c['id']]\n   144\t        if canonical in created:\n   145\t            new_views[c['id']] = created[canonical]\n   146\t            continue\n   147\t        if store.exact_key_views(conn, c):\n   148\t            raise WriteConflict(f'candidate {c[\"id\"]}: existing exact identity requires matching')\n   149\t        object_id = universe.resolve(c['object'])\n   150\t        if outcome == 'succession' and target:\n   151\t            c = oriented_like(c, store.rungs_of(conn, target), notes)\n   152\t        view_id = _create_view(conn, c, object_id, universe.kind(object_id), seq, item, universe)\n   153\t        new_views[c['id']] = view_id\n   154\t        created[canonical] = view_id\n   155\t        if outcome == 'succession' and target:\n   156\t            store.insert(conn, 'successions', view_id=view_id, succeeds=target, seq=seq)\n     1\t\"\"\"Steps 3 and 4 are frozen (D354, Alex 2026-11-03: \"那你跑了吧，我们赶紧确认step 3,4 可以freeze\"): opening and matching questions, and\n     2\tjudging them, as `poc/config/poc-v108.json` runs them (its sha256 is pinned in test_frozen_extraction_prompt.py). Every piece that shapes\n     3\tthose requests is pinned here: the collision judge's and the judge's prompt files, the matching prompt the configuration names, the\n     4\tjudge's answer schema, and the three questions the Jev matcher is asked. A change is a new version opened only by Alex's decision.\"\"\"\n     5\timport hashlib\n     6\timport json\n     7\timport os\n     8\timport sys\n     9\t\n    10\tROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))\n    11\tsys.path.insert(0, os.path.join(ROOT, 'src'))\n    12\tfrom hivemind.views import jev_matching, judging  # noqa: E402\n    13\t\n    14\tFROZEN_FILES = {\n    15\t    'src/hivemind/prompts/collision-v2.txt': 'a5f0f58d53c4f4215b14e534935b1f95a79b35ba097d68c0ab598af7b88a3bd0',\n    16\t    'src/hivemind/prompts/judging-v7.txt': 'd499c4b89ad038ade9bd41e037d766d5e54defecef273541f46dc01509db5a2c',\n    17\t    'src/hivemind/prompts/matching-v3.txt': '04e23ee314e71cb094273b23e75f816c467176969b8c17dfec5a6e5d17a45a49',\n    18\t}\n    19\tJUDGING_SCHEMA_SHA = '4d1469ae9c14256c24e2c39e1b6cc772cb25e160c937f32091fc4f35bf539ca9'\n    20\tMATCHER_QUESTIONS_SHA = '86cb70600ce456be3cd5197ef173c38023513157fa3c92e341036651f95a5218'\n    21\t\n    22\t\n    23\tdef sha_of(value):\n    24\t    return hashlib.sha256(json.dumps(value, ensure_ascii=False, sort_keys=True).encode('utf-8')).hexdigest()\n    25\t\n    26\t\n    27\tdef test_the_frozen_question_and_judgement_prompt_files_are_unchanged():\n    28\t    for path, expected in FROZEN_FILES.items():\n    29\t        with open(os.path.join(ROOT, path), 'rb') as handle:\n    30\t            assert hashlib.sha256(handle.read()).hexdigest() == expected, f'{path} changed; steps 3 and 4 are frozen (D354)'\n    31\t\n    32\t\n    33\tdef test_the_code_written_parts_of_the_question_and_judgement_requests_are_unchanged():\n    34\t    assert sha_of(judging.schema_for('judging-v7')) == JUDGING_SCHEMA_SHA\n    35\t    questions = [jev_matching.relation_question('X'), jev_matching.member_question('X'), jev_matching.piece_question('X')]\n    36\t    assert sha_of(questions) == MATCHER_QUESTIONS_SHA\n","exit_code":0,"status":"completed"}}
