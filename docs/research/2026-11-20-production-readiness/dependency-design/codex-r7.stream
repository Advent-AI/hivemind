st=current_key)\n   153\t            return extraction.file_reading(reading, item, shown)\n   154\t\n   155\t        try:\n   156\t            fill()\n   157\t            for item, route in items:\n   158\t                self._event(item['input_id'], 'turn')\n   159\t                result = rounds.run(conn, archive, frozen_cfg, frozen_universe, item, route.sequence_no, resume_from=route.resume_from,\n   160\t                                    transport=transport, log=log, extractor=accepted_extraction, matching_workers=self.jev_workers)\n   161\t                self._event(item['input_id'], 'failed' if result.failed else 'accepted')\n   162\t                yield result\n   163\t                if result.failed:\n   164\t                    return\n   165\t                pending.pop(item['input_id'], None)\n   166\t                refresh()\n   167\t                fill()\n   168\t        finally:\n   169\t            # Running calls may still archive a response; none can become a handover here.\n   170\t            for _, _, future, _ in pending.values():\n   171\t                future.cancel()\n   172\t            pool.shutdown(wait=True, cancel_futures=True)\n   308\t    while pending:\n   309\t        ready = [v for v in pending if upstream(conn, v).isdisjoint(set(pending) - {v})] or pending[:1]\n   310\t        level = [v for v in ready if is_theme(v)] or ready\n   311\t        prompts = {v: build_prompt(conn, v, version) for v in level}\n   312\t\n   313\t        def ask(view_id, note=''):\n   314\t            system, user = prompts[view_id]\n   315\t            return model.call(archive, cfg, cfg.rejudging, system, user + note, schema, 'judgement', 'judge', transport=transport)\n   316\t\n   317\t        with concurrent.futures.ThreadPoolExecutor(max_workers=JUDGE_WORKERS) as pool_:\n   318\t            answers = dict(zip(level, pool_.map(ask, level)))\n   319\t        for view_id in level:\n   320\t            answer = answers[view_id]\n   321\t            errors = check_answer(conn, view_id, answer.data, prompts[view_id][1])\n   322\t            if errors:\n   323\t                archive.retire(answer.call_id)                 # a refused answer never answers the same request again (a resume re-samples)\n   324\t                answer = ask(view_id, retry_note(errors))\n   325\t                errors = check_answer(conn, view_id, answer.data, prompts[view_id][1])\n   326\t                if errors:\n   327\t                    archive.retire(answer.call_id)\n   328\t                    raise JudgementRefused(f'{view_id}: ' + '; '.join(errors))\n   329\t            result = _record(conn, cfg, view_id, seq, item, answer)\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_9","type":"agent_message","text":"**Two blockers remain.** Version 4 closes the write-record gap, but the harness lock does not stop an ordinary v118 writer, and the proposed serial replay gives the harness neither the item sequence at the transport boundary nor a place to inspect the link immediately after commit.\n\n## Blockers\n\n1. **Protect the harness store from ordinary writers.** Rejecting `jev-links` in the two CLIs stops those CLIs from launching v119. It does not stop either CLI from opening the same SQLite file under v118, which §0 expressly allows. `live_lock.acquire` is advisory, and ordinary replay does not take that lock. Mark each scratch ledger as harness-only before the run, and have ordinary replay refuse writable access to it under either configuration. Preserve read-only inspection. Test the refusal with the v118 CLI pointed at an unfinished harness ledger, before routing or writing an item. [Design §0](/Users/lchingen/hivemind/docs/research/2026-11-20-production-readiness/dependency-design/DESIGN.md:9) · [CLI entry point](/Users/lchingen/hivemind/scripts/replay.py:77) · [Replay opens the store](/Users/lchingen/hivemind/src/hivemind/replay.py:51) · [Store lock](/Users/lchingen/hivemind/src/hivemind/live_lock.py:57)\n\n2. **Use the existing `day_runner` seam for the July transport and inspection.** The test plan currently says `day_runner=None`. In that mode, replay calls `round.run` internally and then proceeds to the next item. `jev.ask` gives the transport only the request, which has no sequence number. Use a **serial** day runner that delegates each item to `round.run` with a transport bound to that item’s owned sequence. Only that scoped transport may authorize the seq-148 selector calls. After `round.run` returns successfully for seq 148, inspect the committed links before processing the next item or starting the day’s judging. Exercise an otherwise valid selector request at the wrong sequence and an out-of-pair reader that would never be judged. Both must stop before a further reservation. [Test plan](/Users/lchingen/hivemind/docs/research/2026-11-20-production-readiness/dependency-design/TEST-PLAN.md:29) · [Replay’s item runner](/Users/lchingen/hivemind/src/hivemind/replay.py:94) · [Jev transport input](/Users/lchingen/hivemind/src/hivemind/jev.py:82) · [Article commit](/Users/lchingen/hivemind/src/hivemind/views/round.py:153)\n\n## Resolved and nonblocking\n\n- **Selection record.** `proposed` before the savepoint, `committed` with the article, and `failed` after rollback fit the current transaction boundaries. For a Jev failure before a proposal exists, write a `failed` row with the partial answers and failing request hash. Adjust the test that currently expects `proposed` first in that case. [Design §1, step 6](/Users/lchingen/hivemind/docs/research/2026-11-20-production-readiness/dependency-design/DESIGN.md:48) · [Write rollback](/Users/lchingen/hivemind/src/hivemind/views/writing.py:112) · [Failure commit](/Users/lchingen/hivemind/src/hivemind/views/round.py:27)\n- **Crash accounting.** The final-sequence rule works. Clarify that a death before settlement leaves the reservation counted against the cap. A death after settlement but before archiving leaves the settled charge counted. Neither case permits a free retry. [Budget reservation and settlement](/Users/lchingen/hivemind/clean-arch/e2e-comparison-2026-11-13/budget_replay.py:131) · [Settlement before response return](/Users/lchingen/hivemind/clean-arch/e2e-comparison-2026-11-13/budget_replay.py:272)\n- **Prior design findings.** The effective-target graph check, bound-wait test, unbound-wait refusal and qualified sign examples address the remaining round-6 notes. Align the old “resumable” table rows with the new harness rule that a stopped sequence is final. [Design graph contract](/Users/lchingen/hivemind/docs/research/2026-11-20-production-readiness/dependency-design/DESIGN.md:107) · [State table](/Users/lchingen/hivemind/docs/research/2026-11-20-production-readiness/dependency-design/DESIGN.md:149)\n\nRequire the harness-ledger write guard and specify the serial item runner for sequence-bound authorization and post-commit inspection. **NOT READY TO BUILD.**"}}
