{"type":"item.completed","item":{"id":"item_18","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba src/hivemind/replay.py | sed -n '48,160p'\"","aggregated_output":"    48\t        day += datetime.timedelta(days=1)\n    49\t\n    50\t\n    51\tdef run(*, testdb_path, views_path, archive, cfg, universe, from_day, until_day, day0=None, spend_cap_usd=None,\n    52\t        transport=None, log=print, only_objects=None, max_items_per_day=None, day_runner=None):\n    53\t    items_db = testdb.open_db(testdb_path)\n    54\t    conn = store.open_db(views_path)\n    55\t    refuse_unfinished_parallel(conn)\n    56\t    last_done = store.last_completed_day(conn)\n    57\t    start = from_day\n    58\t    if last_done and from_day <= last_done:\n    59\t        next_day = (datetime.date.fromisoformat(last_done) + datetime.timedelta(days=1)).isoformat()\n    60\t        if next_day > until_day:\n    61\t            raise BackdatingError(f'views database already completed {last_done}; nothing to run before it')\n    62\t        log(f'resuming after the last completed day {last_done}')\n    63\t        start = next_day\n    64\t    last_written = conn.execute('select max(publication_day) from processing_steps where sequence_no > 0').fetchone()[0]\n    65\t    if last_written and start < last_written:\n    66\t        raise BackdatingError(f'views database already holds rounds of {last_written}; a replay cannot start before it (D31)')\n    67\t    totals = {'items': 0, 'extracted': 0, 'skipped': 0, 'merged': 0, 'not_processed': 0, 'returned': 0, 'failed': 0,\n    68\t              'evidence': 0, 'new_views': 0, 'judged': 0, 'changed': 0, 'closed': 0}\n    69\t    calls_before, cost_before, *_ = archive.totals()\n    70\t    for day in calendar_days(start, until_day):\n    71\t        day_stats = {k: 0 for k in totals}\n    72\t        day_cost_before = archive.totals()[1]\n    73\t        processed = 0\n    74\t        to_run = []\n    75\t        for item in testdb.feed(items_db, day, day):\n    76\t            if item['publication_day'] > day:\n    77\t                raise LookAheadError(f'{item[\"input_id\"]} is dated {item[\"publication_day\"]}, after replay day {day}')\n    78\t            if only_objects and not any(o['value'] in only_objects for o in item['object_identifiers']):\n    79\t                continue\n    80\t            if max_items_per_day and processed >= max_items_per_day:\n    81\t                break\n    82\t            day_stats['items'] += 1\n    83\t            route = dispatch.route(conn, item, universe)\n    84\t            if route.kind != 'extract':\n    85\t                day_stats[route.kind] += 1\n    86\t                if route.kind == 'skipped':\n    87\t                    processed += 1      # written by an earlier run of this day: a restart keeps the day's item limit\n    88\t                if route.kind == 'merged':\n    89\t                    dispatch.mark(conn, item, 0, 'merged', 'ok', route.reason)\n    90\t                    conn.commit()\n    91\t                continue\n    92\t            processed += 1\n    93\t            to_run.append((item, route))\n    94\t        results = (day_runner(conn, archive, cfg, universe, to_run, day=day, transport=transport, log=log) if day_runner else\n    95\t                   (round_module.run(conn, archive, cfg, universe, item, route.sequence_no, resume_from=route.resume_from, transport=transport, log=log)\n    96\t                    for item, route in to_run))\n    97\t        finished = 0\n    98\t        try:\n    99\t            for index, result in enumerate(results):\n   100\t                if index >= len(to_run) or result.input_id != to_run[index][0]['input_id']:\n   101\t                    raise RuntimeError('day runner returned results out of input order')\n   102\t                finished += 1\n   103\t                day_stats['extracted'] += 1\n   104\t                day_stats['evidence'] += result.evidence\n   105\t                day_stats['new_views'] += result.new_views\n   106\t                day_stats['judged'] += result.judged\n   107\t                day_stats['changed'] += result.changed\n   108\t                if result.failed:\n   109\t                    day_stats['failed'] += 1\n   110\t                    log(f'  ! {result.input_id[:60]}: {result.failed}')\n   111\t                    raise RuntimeError(f'item failed; day {day} remains resumable: {result.failed}')\n   112\t                if spend_cap_usd is not None and archive.totals()[1] - cost_before > spend_cap_usd:\n   113\t                    raise RuntimeError(f'spend cap {spend_cap_usd} reached on {day}')\n   114\t        finally:\n   115\t            if hasattr(results, 'close'):\n   116\t                results.close()\n   117\t        if finished != len(to_run):\n   118\t            raise RuntimeError('day runner did not complete every routed item')\n   119\t        seq = store.next_sequence(conn) - 1\n   120\t        judged = round_module.judge_day(conn, archive, cfg, day, seq, transport=transport, log=log)\n   121\t        day_stats['judged'] += judged.judged\n   122\t        day_stats['changed'] += judged.changed\n   123\t        if judged.failed:\n   124\t            day_stats['failed'] += 1\n   125\t            log(f'  ! day judging: {judged.failed}')\n   126\t            raise RuntimeError(f'judging failed; day {day} remains resumable: {judged.failed}')\n   127\t        closed = pull.end_of_day(conn, day, seq)\n   128\t        day_stats['closed'] = len(closed)\n   129\t        # The day ends at the last sequence it wrote, a closing's own sequence on a day without items included, so the next day starts after it.\n   130\t        store.complete_day(conn, day, store.next_sequence(conn) - 1, time.strftime('%Y-%m-%dT%H:%M:%S'))\n   131\t        conn.commit()\n   132\t        for key in totals:\n   133\t            totals[key] += day_stats[key]\n   134\t        calls, cost, _, _ = archive.totals()\n   135\t        day_cost = cost - day_cost_before  # Includes discarded speculative calls and repaired refusals.\n   136\t        open_count = len(store.open_views(conn))\n   137\t        log(f'{day} | items {day_stats[\"items\"]:3d} extracted {day_stats[\"extracted\"]:3d} merged {day_stats[\"merged\"]:2d} skipped {day_stats[\"not_processed\"]:2d} '\n   138\t            f'failed {day_stats[\"failed\"]:2d} | evidence {day_stats[\"evidence\"]:3d} new views {day_stats[\"new_views\"]:2d} judged {day_stats[\"judged\"]:3d} '\n   139\t            f'changed {day_stats[\"changed\"]:3d} closed {len(closed)} | open views {open_count} | day ${day_cost:.2f} total ${cost - cost_before:.2f} calls {calls - calls_before}')\n   140\t        if day0 and day == day0:\n   141\t            conn.commit()\n   142\t            shutil.copy(views_path, views_path + '.day0.sqlite')\n   143\t            log(f'day 0 snapshot written: {views_path}.day0.sqlite')\n   144\t    return totals\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_19","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba src/hivemind/views/round.py | sed -n '95,320p'\"","aggregated_output":"    95\t\n    96\t\n    97\tdef run(conn, archive, cfg, universe, item, seq, *, resume_from=None, transport=None, log=print, extractor=None, matching_workers=1):\n    98\t    result = RoundResult(item['input_id'])\n    99\t    if resume_from in ('judged', 'handed_over'):       # written already; judging is the day's step\n   100\t        dispatch.mark(conn, item, seq, 'handed_over', 'ok', 'resumed')\n   101\t        conn.commit()\n   102\t        return result\n   103\t    objects = [o['value'] for o in item.get('object_identifiers') or [] if universe.has(o['value'])]\n   104\t    shown = extraction.shown_views(conn, cfg, item, objects)\n   105\t    # extraction (or its stored handover on resume)\n   106\t    handover = None\n   107\t    if resume_from and resume_from != 'extracted':\n   108\t        row = conn.execute('select handover_json from handovers where input_id=? order by id desc limit 1', (item['input_id'],)).fetchone()\n   109\t        if row:\n   110\t            saved = vocabulary.extraction_answer(json.loads(row['handover_json']))          # a handover saved by a Chinese version reads in the canonical vocabulary\n   111\t            handover = extraction.Handover(saved['evidence'], saved['candidates'], saved['dropped'], 0, '', True, 0.0, saved.get('new_groups') or [])\n   112\t    if handover is None:\n   113\t        try:\n   114\t            handover = (extractor or extraction.extract)(archive, cfg, item, item['text'], shown, universe, transport=transport)\n   115\t        except Exception as error:\n   116\t            return _fail(conn, item, seq, result, 'extracted', 'extraction_failed', 'extraction: ' + repr(error), type(error).__name__)\n   117\t        result.cost += handover.cost_usd\n   118\t        result.cached_calls += int(handover.cached)\n   119\t        store.insert(conn, 'handovers', input_id=item['input_id'], seq=seq,\n   120\t                     handover_json=json.dumps({'evidence': handover.evidence, 'candidates': handover.candidates, 'dropped': handover.dropped, 'new_groups': handover.new_groups}, ensure_ascii=False))\n   121\t        dispatch.mark(conn, item, seq, 'extracted', 'ok', f'{len(handover.evidence)} evidence, {len(handover.candidates)} candidates, {len(handover.dropped)} dropped')\n   122\t        conn.commit()\n   123\t    result.evidence, result.candidates, result.dropped = len(handover.evidence), len(handover.candidates), len(handover.dropped)\n   124\t    if not handover.evidence and not handover.candidates:\n   125\t        dispatch.mark(conn, item, seq, 'handed_over', 'ok', 'nothing to match')\n   126\t        conn.commit()\n   127\t        return result\n   128\t    # first matching call: the candidates and the evidence linked straight to existing views\n   129\t    lists = matching.build_lists(conn, handover, shown, cfg.search_top_n)\n   130\t    checked = _match(conn, archive, cfg, universe, item, seq, result, handover.candidates, handover.evidence, lists, shown, transport=transport, workers=matching_workers)\n   131\t    if checked is None:\n   132\t        return result\n   133\t    # second call: evidence linked to candidates that attached to an existing view, compared under that view\n   134\t    second_pass = {}\n   135\t    pending = []\n   136\t    for e in handover.evidence:\n   137\t        for link in e['links']:\n   138\t            outcome = checked.outcomes.get(link)\n   139\t            if outcome and outcome[0] == 'merge':\n   140\t                pending.append((e, outcome[1]))\n   141\t    if pending:\n   142\t        lists2 = matching.Lists({}, {(e['id'], view_id): matching.rank_evidence(conn, view_id, e['one_line'], cfg.search_top_n) for e, view_id in pending})\n   143\t        evidence2, seen = [], set()\n   144\t        for e, view_id in pending:\n   145\t            if e['id'] not in seen:\n   146\t                evidence2.append(dict(e, links=[v for x, v in pending if x['id'] == e['id']]))\n   147\t                seen.add(e['id'])\n   148\t        checked2 = _match(conn, archive, cfg, universe, item, seq, result, [], evidence2, lists2, [], extra_views=sorted({v for _, v in pending}),\n   149\t                          call_offset=2, transport=transport, workers=matching_workers)\n   150\t        if checked2 is None:\n   151\t            return result\n   152\t        second_pass = checked2.evidence\n   153\t    # D694, D695: under the engine jev-links, the reading links between a newly opened number question and the number questions it was\n   154\t    # shown, chosen once matching has settled what opens (views/links.py); recorded per attempt whatever happens next\n   155\t    proposed, attempt = None, None\n   156\t    if cfg.matching.engine == links.ENGINE:\n   157\t        attempt = links.attempt_id(conn, item)\n   158\t        try:\n   159\t            proposed, chosen = links.choose(archive, cfg, conn, handover, checked, lists, shown, transport=transport)\n   160\t        except links.Refused as error:\n   161\t            links.record(conn, attempt, seq, item, cfg, 'failed', error.record)\n   162\t            return _fail(conn, item, seq, result, 'matched', 'linking_refused', 'linking: ' + str(error), 'linking')\n   163\t        links.record(conn, attempt, seq, item, cfg, 'proposed', chosen)\n   164\t    dispatch.mark(conn, item, seq, 'matched', 'ok', f'{len(checked.outcomes)} candidates placed')\n   165\t    # write, and record what changed in the same commit (a resume at 'judged' reads it)\n   166\t    try:\n   167\t        written = writing.write(conn, universe, seq, item, handover, checked, second_pass, proposed_links=proposed)\n   168\t    except Exception as error:\n   169\t        if attempt:\n   170\t            links.record(conn, attempt, seq, item, cfg, 'failed', {'error': repr(error)[:300]})\n   171\t        return _fail(conn, item, seq, result, 'written', 'writing_failed', 'writing: ' + repr(error), type(error).__name__)\n   172\t    if attempt:\n   173\t        links.record(conn, attempt, seq, item, cfg, 'committed', {'links': written.links})\n   174\t    result.new_views = len(set(written.new_views.values()))\n   175\t    dispatch.mark(conn, item, seq, 'written', 'ok', json.dumps({'changed': sorted(written.changed_views), 'new': written.new_views, 'notes': written.notes[:20]}, ensure_ascii=False))\n   176\t    dispatch.mark(conn, item, seq, 'handed_over', 'ok', '')\n   177\t    conn.commit()\n   178\t    return result\n","exit_code":0,"status":"completed"}}
