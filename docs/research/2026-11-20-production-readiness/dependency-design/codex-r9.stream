sts/test_links.py:140:def test_no_link_without_a_direction_and_a_sign_at_the_threshold(tmp_path, script):\ntests/test_links.py:149:def test_pairs_outside_number_questions_are_not_asked(tmp_path, change):\ntests/test_links.py:162:def test_two_candidates_of_one_question_are_asked_once(tmp_path):\ntests/test_links.py:183:def test_a_circle_through_a_stored_link_is_corrected_once(tmp_path):\ntests/test_links.py:207:def test_a_circle_through_two_openings_is_found_and_a_persistent_one_fails(tmp_path):\ntests/test_links.py:232:def test_a_store_with_an_unbound_wait_is_refused_and_a_bound_wait_counts_through_its_target(tmp_path):\ntests/test_links.py:257:def test_an_existing_question_gains_a_reads_link_and_is_judged_that_day(tmp_path):\ntests/test_links.py:267:def test_a_closed_endpoint_refuses_the_whole_write(tmp_path):\ntests/test_links.py:280:def test_a_reads_link_is_not_a_narrower_home_and_a_seed_row_still_is(tmp_path):\ntests/test_links.py:283:    assert store.direct_parents(conn, 'v2') == []\ntests/test_links.py:284:    assert extraction.narrowest_links(['v1', 'v2'], {'v2': store.direct_parents(conn, 'v2')}) == ['v1', 'v2']\ntests/test_links.py:287:    assert store.direct_parents(conn, 'v1') == ['v2']\ntests/test_links.py:288:    assert extraction.narrowest_links(['v1', 'v2'], {'v1': store.direct_parents(conn, 'v1')}) == ['v1']\ntests/test_links.py:300:def test_judging_v8_shows_the_comparison_point_and_forecast_and_v7_is_unchanged(tmp_path):\ntests/test_links.py:330:def test_a_changed_read_conclusion_queues_its_reader_and_an_unchanged_one_does_not(tmp_path, changed, queued):\ntests/test_links.py:349:def test_the_links_engine_loads_but_ordinary_launchers_refuse_it():\ntests/test_links.py:356:def test_an_ordinary_replay_refuses_a_harness_only_ledger_before_routing(tmp_path):\ntests/test_links.py:358:    conn.execute('create table harness_only (name text, day text)')\ntests/test_links.py:380:def test_the_article_writes_the_link_and_records_proposed_then_committed(tmp_path):\ntests/test_links.py:392:def test_under_the_jev_engine_no_link_question_is_asked(tmp_path):\ntests/test_links.py:400:def test_a_jev_failure_records_failed_alone_with_the_failing_request(tmp_path):\ntests/test_links.py:419:def test_a_write_conflict_after_the_proposal_records_proposed_then_failed(tmp_path, monkeypatch):\n","exit_code":0,"status":"completed"}}
