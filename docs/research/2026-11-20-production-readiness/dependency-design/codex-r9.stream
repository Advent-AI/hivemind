{"type":"item.completed","item":{"id":"item_27","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba src/hivemind/views/judging.py | sed -n '270,385p'; nl -ba src/hivemind/views/jev_matching.py | sed -n '132,161p'\"","aggregated_output":"   270\t\n   271\tdef upstream(conn, view_id):\n   272\t    \"\"\"Every view this one depends on, directly or through its dependencies.\"\"\"\n   273\t    seen, stack = set(), [view_id]\n   274\t    while stack:\n   275\t        for dep in store.dependencies_of(conn, stack.pop()):\n   276\t            target = dep['resolved_to']\n   277\t            if target and target not in seen:\n   278\t                seen.add(target)\n   279\t                stack.append(target)\n   280\t    return seen\n   281\t\n   282\t\n   283\tdef open_asset_views(conn):\n   284\t    return [v for v in store.open_views(conn) if store.view(conn, v)['object_kind'] != 'theme']\n   285\t\n   286\t\n   287\tdef queued_by_change(conn, view_id):\n   288\t    \"\"\"What a changed conclusion of this view queues: its dependants and, for a theme thesis, every open asset thesis. The one rule,\n   289\t    read for a live judgement and for the judgements a resumed round finds committed.\"\"\"\n   290\t    queued = store.dependants_of(conn, view_id)\n   291\t    if store.view(conn, view_id)['object_kind'] == 'theme':\n   292\t        queued = queued + open_asset_views(conn)\n   293\t    return queued\n   294\t\n   295\t\n   296\tdef queued_by_ledger(conn, seq):\n   297\t    \"\"\"What the judgements already committed at this sequence number queued; a fresh round finds nothing here, a resumed round\n   298\t    finds what the interrupted one had queued in memory.\"\"\"\n   299\t    queued = []\n   300\t    for row in conn.execute('select view_id from judgements where seq=? and changed=1 order by judgement_id', (seq,)):\n   301\t        queued.extend(queued_by_change(conn, row['view_id']))\n   302\t    return queued\n   303\t\n   304\t\n   305\tdef round_of_judgements(archive, cfg, conn, changed_views, seq, item, *, transport=None):\n   306\t    \"\"\"Judge the open views in changed_views, dependencies first; a changed conclusion queues open dependants.\n   307\t\n   308\t    Views that do not depend on each other are judged at the same time: each level of the dependency order is sent\n   309\t    to the model concurrently (the prompts are built and the answers checked and written in this thread, so the\n   310\t    database connection never crosses threads). A view waits while anything upstream of it is still pending, so a\n   311\t    dependant always reads this round's conclusion of its dependency. A view with no evidence in force stays\n   312\t    unjudged (D59), and a view already judged at this sequence number (a resumed round) is not judged twice.\n   313\t\n   314\t    Among the views ready to be judged, theme theses go first, so an asset thesis reads this round's theme conclusions; a theme judgement that says changed queues every open asset thesis with\n   315\t    evidence in force. The starting queue adds what the ledger says earlier commits at this sequence number queued.\"\"\"\n   316\t    import concurrent.futures\n   317\t\n   318\t    version = cfg.rejudging.prompt_version\n   319\t    schema = schema_for(version)\n   320\t\n   321\t    def eligible(view_id):\n   322\t        return store.is_open(conn, view_id) and not store.has_judgement(conn, view_id, seq) and bool(store.evidence_in_force(conn, view_id))\n   323\t\n   324\t    def is_theme(view_id):\n   325\t        return store.view(conn, view_id)['object_kind'] == 'theme'\n   326\t\n   327\t    pending = [v for v in topological(conn, list(changed_views) + queued_by_ledger(conn, seq)) if eligible(v)]\n   328\t    done, results = set(), []\n   329\t    while pending:\n   330\t        ready = [v for v in pending if upstream(conn, v).isdisjoint(set(pending) - {v})] or pending[:1]\n   331\t        level = [v for v in ready if is_theme(v)] or ready\n   332\t        prompts = {v: build_prompt(conn, v, version) for v in level}\n   333\t\n   334\t        def ask(view_id, note=''):\n   335\t            system, user = prompts[view_id]\n   336\t            return model.call(archive, cfg, cfg.rejudging, system, user + note, schema, 'judgement', 'judge', transport=transport)\n   337\t\n   338\t        with concurrent.futures.ThreadPoolExecutor(max_workers=JUDGE_WORKERS) as pool_:\n   339\t            answers = dict(zip(level, pool_.map(ask, level)))\n   340\t        for view_id in level:\n   341\t            answer = answers[view_id]\n   342\t            errors = check_answer(conn, view_id, answer.data, prompts[view_id][1])\n   343\t            if errors:\n   344\t                archive.retire(answer.call_id)                 # a refused answer never answers the same request again (a resume re-samples)\n   345\t                answer = ask(view_id, retry_note(errors))\n   346\t                errors = check_answer(conn, view_id, answer.data, prompts[view_id][1])\n   347\t                if errors:\n   348\t                    archive.retire(answer.call_id)\n   349\t                    raise JudgementRefused(f'{view_id}: ' + '; '.join(errors))\n   350\t            result = _record(conn, cfg, view_id, seq, item, answer)\n   351\t            done.add(view_id)\n   352\t            results.append(result)\n   353\t            if result['changed']:\n   354\t                for dependant in queued_by_change(conn, view_id):\n   355\t                    if dependant not in done and dependant not in pending and eligible(dependant):\n   356\t                        pending.append(dependant)\n   357\t        pending = [v for v in topological(conn, pending) if v not in done and eligible(v)]\n   358\t    return results\n   132\t    for view_id in listed:\n   133\t        key = store.view_key(conn, view_id)\n   134\t        if key and _universe.scope_key(key.get('scope', '')) == _universe.scope_key(c.get('scope', '')) and can_succeed(conn, view_id, key, c):\n   135\t            return view_id\n   136\t    return None\n   137\t\n   138\t\n   139\tdef _summary(answer):\n   140\t    if answer['type'] == 'noul':\n   141\t        return f'{answer[\"noul\"]:.2f}'\n   142\t    top = max(answer['probabilities'].items(), key=lambda kv: kv[1])\n   143\t    return f'{top[0]} {top[1]:.2f}'\n   144\t\n   145\t\n   146\tdef _answers(archive, cfg, jobs, workers, transport):\n   147\t    \"\"\"Ask independent questions; equal concurrent requests share one archived result.\"\"\"\n   148\t    if not isinstance(workers, int) or isinstance(workers, bool) or workers < 1:\n   149\t        raise ValueError('Jev workers must be a positive integer')\n   150\t\n   151\t    def ask(job):\n   152\t        state, questions = job\n   153\t        return jev.ask(archive, cfg, cfg.matching, state, questions, 'match', transport=transport)\n   154\t\n   155\t    if workers == 1:\n   156\t        return [ask(job) if job[1] else None for job in jobs]\n   157\t    keys, unique, replies = [], {}, {}\n   158\t    for state, questions in jobs:\n   159\t        if not questions:\n   160\t            keys.append(None)\n   161\t            continue\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_26","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba src/hivemind/views/store.py | sed -n '170,295p'; nl -ba src/hivemind/research_context.py | head -130\"","aggregated_output":"   170\t\n   171\tdef open_views_with_key(conn, object_id, measure, scope_key, period_start, period_end, basis='n/a', unit='n/a', event_type=None):\n   172\t    \"\"\"Open views of the object with the same measure, scope and unit whose period overlaps: the ones a candidate must\n   173\t    be confirmed against before it may open (keyed-views-plan.md 2.5). A basis or unit of n/a on either side matches\n   174\t    any; GAAP and non-GAAP are two quantities, and so are a level in USD and a growth rate in percent.\"\"\"\n   175\t    rows = [dict(r) for r in conn.execute('''select k.* from view_keys k join views v on v.view_id=k.view_id\n   176\t                                            where v.object_id=? and k.measure=? order by v.rowid''', (object_id, measure))]\n   177\t    return [r['view_id'] for r in rows if is_open(conn, r['view_id'])\n   178\t            and (event_type is None or r['event_type'] == event_type)\n   179\t            and (basis == 'n/a' or r['basis'] == 'n/a' or r['basis'] == basis)\n   180\t            and (unit == 'n/a' or r['unit'] == 'n/a' or r['unit'] == unit)\n   181\t            and (r.get('key_version') != 2 or ((scope_key is None or r['scope_key'] == scope_key)\n   182\t                 and r['period_start'] <= (period_end or '9999') and r['period_end'] >= (period_start or '0000')))]\n   183\t\n   184\t\n   185\tdef exact_key_views(conn, candidate):\n   186\t    \"\"\"All open exact identities, independent of a search limit; legacy keys are never automatic identities.\"\"\"\n   187\t    from .identity import automatic_key\n   188\t    target = automatic_key(candidate)\n   189\t    if target is None:\n   190\t        return []\n   191\t    rows = conn.execute('''select k.*, v.object_id from view_keys k join views v on v.view_id=k.view_id\n   192\t                           where v.object_id=? and k.measure=?''', (candidate['object'], candidate['measure']))\n   193\t    return [r['view_id'] for r in rows if automatic_key(dict(r), r['object_id']) == target and is_open(conn, r['view_id'])]\n   194\t\n   195\t\n   196\tdef is_open(conn, view_id):\n   197\t    row = conn.execute('select open from view_switches where view_id=? order by id desc limit 1', (view_id,)).fetchone()\n   198\t    return bool(row and row['open'])\n   199\t\n   200\t\n   201\tdef close_view(conn, view_id, reason, by_whom, seq):\n   202\t    insert(conn, 'view_switches', view_id=view_id, open=0, reason=reason, by_whom=by_whom, after_seq=seq)\n   203\t\n   204\t\n   205\tdef open_views(conn):\n   206\t    rows = conn.execute('select view_id from views').fetchall()\n   207\t    return [r['view_id'] for r in rows if is_open(conn, r['view_id'])]\n   208\t\n   209\t\n   210\tdef views_of_object(conn, object_id, only_open=True):\n   211\t    rows = conn.execute('select view_id from views where object_id=? order by created_seq', (object_id,)).fetchall()\n   212\t    ids = [r['view_id'] for r in rows]\n   213\t    return [v for v in ids if is_open(conn, v)] if only_open else ids\n   214\t\n   215\t\n   216\tdef has_judgement(conn, view_id, seq):\n   217\t    return conn.execute('select 1 from judgements where view_id=? and seq=?', (view_id, seq)).fetchone() is not None\n   218\t\n   219\t\n   220\tREAD_BUSY_TIMEOUT_SECONDS = 5.0     # a reader's busy timeout: SQLite's busy handler retries SQLITE_BUSY within it (live-service row 1)\n   221\t\n   222\t\n   223\tdef open_read_only(path):\n   224\t    \"\"\"The views database for a reader (the agent layer, reports): no schema creation, no writes. Opened by its own path: a symlink\n   225\t    resolved, a store with another hard link refused (`live_lock.LockRefused`; live-service/OPERATING-CONTRACT.md, row 7), since\n   226\t    SQLite finds a WAL store's side files by the opened path.\"\"\"\n   227\t    from hivemind import live_lock\n   228\t    real, _ = live_lock.own_path(path)\n   229\t    conn = sqlite3.connect(f'file:{real}?mode=ro', uri=True, timeout=READ_BUSY_TIMEOUT_SECONDS)\n   230\t    conn.row_factory = sqlite3.Row\n   231\t    return conn\n   232\t\n   233\t\n   234\tdef current_state(conn, view_id):\n   235\t    \"\"\"The latest judgement: rung, reasons, changed, seq and day, and its reference and implied outcome (D260) where the ledger has them.\"\"\"\n   236\t    columns = {r[1] for r in conn.execute('pragma table_info(judgements)')}\n   237\t    stance = ''.join(f', {field}' for field in ('reference', 'implied_outcome') if field in columns)\n   238\t    row = conn.execute(f'select judgement_id, rung, reasons, changed, seq, publication_day{stance} from judgements where view_id=? order by judgement_id desc limit 1', (view_id,)).fetchone()\n   239\t    return dict(row) if row else None\n   240\t\n   241\t\n   242\tdef dependencies_of(conn, view_id):\n   243\t    \"\"\"Each dependency with its current target: the resolved view, or the waiting chain and year.\"\"\"\n   244\t    out = []\n   245\t    for dep in conn.execute('select * from dependencies where view_id=? order by dependency_id', (view_id,)):\n   246\t        dep = dict(dep)\n   247\t        resolution = conn.execute('select resolved_to, reason from dependency_resolutions where dependency_id=? order by id desc limit 1', (dep['dependency_id'],)).fetchone()\n   248\t        if resolution:\n   249\t            dep['resolved_to'], dep['resolution'] = resolution['resolved_to'], resolution['reason']\n   250\t        else:\n   251\t            dep['resolved_to'], dep['resolution'] = dep['depends_on'], ('direct' if dep['depends_on'] else 'waiting')\n   252\t        out.append(dep)\n   253\t    return out\n   254\t\n   255\t\n   256\tdef direct_parents(conn, view_id, seq=None):\n   257\t    \"\"\"The views this view depends on directly (a driver's root, D208; the seeds' depends_on), written at or before `seq` when given.\n   258\t    The filing reads it to keep a statement under the narrower of two linked questions (D207's narrowest rule, extraction.file_reading).\"\"\"\n   259\t    reads = \" and coalesce(kind, '') != 'reads'\" if 'kind' in {r[1] for r in conn.execute('pragma table_info(dependencies)')} else ''\n   260\t    rows = conn.execute(f\"select depends_on from dependencies where view_id=? and depends_on != '' and (? is null or seq <= ?){reads} order by dependency_id\", (view_id, seq, seq))\n   261\t    return list(dict.fromkeys(r[0] for r in rows))\n   262\t\n   263\t\n   264\tdef dependants_of(conn, view_id):\n   265\t    direct = [r['view_id'] for r in conn.execute('select view_id from dependencies where depends_on=?', (view_id,))]\n   266\t    resolved = [r['view_id'] for r in conn.execute(\n   267\t        'select d.view_id from dependency_resolutions r join dependencies d on d.dependency_id=r.dependency_id where r.resolved_to=?', (view_id,))]\n   268\t    return sorted(set(direct + resolved))\n   269\t\n   270\t\n   271\tdef would_cycle(conn, view_id, depends_on):\n   272\t    \"\"\"True when depends_on already depends, directly or through its dependencies, on view_id.\"\"\"\n   273\t    seen, stack = set(), [depends_on]\n   274\t    while stack:\n   275\t        current = stack.pop()\n   276\t        if current == view_id:\n   277\t            return True\n   278\t        if current in seen or not current:\n   279\t            continue\n   280\t        seen.add(current)\n   281\t        for dep in dependencies_of(conn, current):\n   282\t            if dep['resolved_to']:\n   283\t                stack.append(dep['resolved_to'])\n   284\t    return False\n   285\t\n   286\t\n   287\tdef day_start_seq(conn, day):\n   288\t    \"\"\"D251: the sequence number the start of `day` stands at: the seq of the last completed day before it, or 0 before the first\n   289\t    completed day, where the seed questions live (D253: seeds are created at seq 0, before any item).\"\"\"\n   290\t    row = conn.execute('select max(seq) from days_completed where day < ?', (day,)).fetchone()\n   291\t    return row[0] if row is not None and row[0] is not None else 0\n   292\t\n   293\t\n   294\tdef views_open_at_day_start(conn, object_ids, day):\n   295\t    \"\"\"D251: the questions open at the start of `day`, as every item of that day sees them: views created at or before the day's start\n     1\t\"\"\"Complete, historical DB context for steps 2a and 2b (D250, ported for D201): the catalog of open questions in scope at a\n     2\tsequence number, and the complete evidence of chosen questions at that same sequence number.\n     3\t\n     4\tCatalog selection is a semantic job outside this module. No lexical filtering,\n     5\tranking, model call or top-N truncation is performed here.\n     6\t\"\"\"\n     7\timport copy\n     8\tfrom .views import store\n     9\t\n    10\t\n    11\tclass Reader:\n    12\t    \"\"\"One read transaction, one explicit exclusive sequence boundary and scope.\"\"\"\n    13\t\n    14\t    def __init__(self, path, before_seq, object_ids, universe):\n    15\t        if type(before_seq) is not int or before_seq < 1:\n    16\t            raise ValueError('before_seq must be a positive owned sequence number')\n    17\t        if not object_ids or any(not universe.has(x) for x in object_ids):\n    18\t            raise ValueError('explicit, known research objects required')\n    19\t        self.seq = before_seq\n    20\t        self.scope = sorted(set(object_ids) | set(universe.themes))\n    21\t        self.db = store.open_read_only(path)\n    22\t        self.db.execute('begin')\n    23\t        self._catalog = None\n    24\t\n    25\t    def __enter__(self):\n    26\t        return self\n    27\t\n    28\t    def __exit__(self, *_):\n    29\t        self.db.close()\n    30\t\n    31\t    def rows(self, sql, args=()):\n    32\t        return [dict(r) for r in self.db.execute(sql, args)]\n    33\t\n    34\t    def dependencies(self, vid):\n    35\t        result = self.rows('select dependency_id, view_id, depends_on, wait_chain_view_id, wait_year, direction, seq from dependencies '\n    36\t                           'where view_id=? and seq<? order by seq,dependency_id', (vid,self.seq))     # the response shape kept as before D694's kind column\n    37\t        for dep in result:\n    38\t            res = self.rows('select * from dependency_resolutions where dependency_id=? and seq<? order by seq desc,id desc limit 1', (dep['dependency_id'],self.seq))\n    39\t            dep['resolved_to'] = res[0]['resolved_to'] if res else dep['depends_on']\n    40\t            dep['resolution'] = res[0] if res else None\n    41\t        return result\n    42\t\n    43\t    def question(self, row):\n    44\t        vid = row['view_id']\n    45\t        switches = self.rows('select * from view_switches where view_id=? and after_seq<? order by after_seq desc,id desc limit 1', (vid,self.seq))\n    46\t        if not switches:\n    47\t            raise ValueError('question has no historical open/closed state: ' + vid)\n    48\t        keys = self.rows('select * from view_keys where view_id=? and seq<?', (vid,self.seq))\n    49\t        return dict(row, open=bool(switches[0]['open']),\n    50\t                    rungs=self.rows('select * from rungs where view_id=? order by position', (vid,)),\n    51\t                    key=keys[0] if keys else None, dependencies=self.dependencies(vid))\n    52\t\n    53\t    def catalog(self):\n    54\t        all_rows = self.rows('select * from views where created_seq<? order by created_seq,view_id', (self.seq,))\n    55\t        by_id = {r['view_id']: r for r in all_rows}\n    56\t        selected = {}\n    57\t        for row in all_rows:\n    58\t            if row['object_id'] in self.scope:\n    59\t                q = self.question(row)\n    60\t                if q['open']:\n    61\t                    selected[row['view_id']] = q\n    62\t        for q in list(selected.values()):\n    63\t            for dep in q['dependencies']:\n    64\t                vid = dep['resolved_to']\n    65\t                if vid and vid not in selected:\n    66\t                    if vid not in by_id:\n    67\t                        raise ValueError('historical dependency target missing: ' + vid)\n    68\t                    selected[vid] = self.question(by_id[vid])\n    69\t        payload = {'before_seq': self.seq, 'object_ids': self.scope,\n    70\t                   'questions': list(selected.values()), 'complete': True}\n    71\t        self._catalog = selected\n    72\t        return copy.deepcopy(payload)\n    73\t\n    74\t    def evidence(self, eid):\n    75\t        rows = self.rows('select * from evidence where evidence_id=? and created_seq<?', (eid,self.seq))\n    76\t        if not rows:\n    77\t            raise ValueError('historical evidence missing: ' + eid)\n    78\t        return dict(rows[0], sources=self.rows('select * from evidence_sources where evidence_id=? and seq<? order by seq,id', (eid,self.seq)))\n    79\t\n    80\t    def expand(self, view_ids):\n    81\t        if self._catalog is None:\n    82\t            self.catalog()\n    83\t        if len(set(view_ids)) != len(view_ids) or any(v not in self._catalog for v in view_ids):\n    84\t            raise ValueError('select distinct IDs from this historical catalog')\n    85\t        evidence, questions = {}, []\n    86\t        for vid in view_ids:\n    87\t            ids = self.rows('select distinct e.evidence_id,e.created_seq from evidence e join evidence_links l on l.evidence_id=e.evidence_id where l.view_id=? and l.seq<? and e.created_seq<? and not exists (select 1 from replacements r where r.old_evidence_id=e.evidence_id and r.seq<?) order by e.created_seq,e.evidence_id', (vid,self.seq,self.seq,self.seq))\n    88\t            for row in ids:\n    89\t                eid = row['evidence_id']\n    90\t                if eid not in evidence:\n    91\t                    record = self.evidence(eid)\n    92\t                    previous = self.rows('select * from replacements where new_evidence_id=? and seq<? order by seq,id', (eid,self.seq))\n    93\t                    record['replaced'] = [dict(r, evidence=self.evidence(r['old_evidence_id'])) for r in previous]\n    94\t                    evidence[eid] = record\n    95\t            judgements = self.rows('select * from judgements where view_id=? and seq<? order by seq desc,judgement_id desc limit 1', (vid,self.seq))\n    96\t            questions.append(dict(copy.deepcopy(self._catalog[vid]), evidence_ids=[r['evidence_id'] for r in ids],\n    97\t                                  latest_judgement=judgements[0] if judgements else None))\n    98\t        return {'before_seq': self.seq, 'questions': questions,\n    99\t                'evidence': list(evidence.values()), 'complete': True}\n","exit_code":0,"status":"completed"}}
