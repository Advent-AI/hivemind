{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc 'nl -ba docs/research/2026-11-20-production-readiness/dependency-design/july_test.py | head -83'","aggregated_output":"     1\t\"\"\"The July test of the reading-links version (D694 (c), D695; DESIGN.md, TEST-PLAN.md). The only entry point that runs poc-v119.\n     2\t\n     3\t  python3 july_test.py prefix  <scratch>                 # $0: poc-v119 over 07-01..07-09 with every link question answered \"neither\"\n     4\t  python3 july_test.py archive <scratch>                 # $0: the per-sequence archive hides the v9/v14 judge rows, keeps the rest\n     5\t  python3 july_test.py dry     <scratch> <prefix ledger> # $0: the whole harness on 07-10..07-12 with fake answers for every bought call\n     6\t  python3 july_test.py price   <scratch>                 # $0: the stored v9/v14 judge calls of the window priced at published rates\n     7\t  python3 july_test.py send    <scratch> <prefix ledger> <out>   # paid, after the council has passed the $0 proof: six sequences\n     8\t\n     9\tEach sequence: its own copy of the prefix ledger (old-2 rebuilt to the end of 07-09, `rebuild_control.py`), marked harness-only, held\n    10\tunder the store lock; its own copy of old-2's archive with every v9 and v14 judge row retired, so both questions are judged fresh;\n    11\t`replay.run` with a serial item runner as its day runner. Requests that miss the archive pass an allow-list before any transport: the\n    12\tday's judging may send only v9/v14 judge requests; an item may send only link questions, and only at seq 148 in the linked arm. After\n    13\tseq 148 commits, a link whose reader is not v9 or v14 stops the sequence. A stopped sequence is final.\n    14\t\"\"\"\n    15\timport json\n    16\timport shutil\n    17\timport sqlite3\n    18\timport sys\n    19\tfrom pathlib import Path\n    20\t\n    21\tREPO = Path(__file__).resolve().parents[4]\n    22\tsys.path.insert(0, str(REPO / 'src'))\n    23\tfrom hivemind import config, live_lock, model, replay, universe       # noqa: E402\n    24\tfrom hivemind.views import links, store                                # noqa: E402\n    25\tfrom hivemind.views import round as rounds                             # noqa: E402\n    26\t\n    27\tOLD2 = REPO / 'poc/data/comparison-2026-11-17/run/old-2/prod'\n    28\tITEMS = REPO / 'poc/data/comparison-2026-11-17/items-comparison.sqlite'\n    29\tV118 = REPO / 'poc/config/poc-v118.json'\n    30\tV119 = REPO / 'poc/config/poc-v119.json'\n    31\tUNIVERSE = REPO / 'poc/universe.json'\n    32\tLINK_SEQ, PREFIX_SEQ = 148, 147\n    33\tTARGETS = ('v9', 'v14')\n    34\tWINDOW = ('2026-07-10', '2026-07-12')\n    35\tCEILING = 0.15\n    36\tINTENDED = ('v9', 'v14')                       # Data Center FY2027 reads total revenue FY2027\n    37\t\n    38\t\n    39\tclass Stop(RuntimeError):\n    40\t    \"\"\"The harness stopped a sequence (an unapproved request, an out-of-pair link); the sequence is final.\"\"\"\n    41\t\n    42\t\n    43\tdef judged_view(request):\n    44\t    \"\"\"The thesis a judge request is about (its user text begins \"Thesis <id> (\"), or None for any other request.\"\"\"\n    45\t    if 'messages' not in request:\n    46\t        return None\n    47\t    text = request['messages'][-1]['content']\n    48\t    return text.split(' ', 2)[1] if text.startswith('Thesis v') else None\n    49\t\n    50\t\n    51\tdef is_link_request(request):\n    52\t    questions = request.get('questions') or {}\n    53\t    return bool(questions) and all(qid.startswith(('reads__', 'sign__')) for qid in questions)\n    54\t\n    55\t\n    56\tclass JudgingScope:\n    57\t    \"\"\"The day's judging: only a v9 or v14 judge request may reach the inner transport.\"\"\"\n    58\t\n    59\t    def __init__(self, inner):\n    60\t        self.inner, self.sent = inner, []\n    61\t\n    62\t    def __call__(self, *args):\n    63\t        request = args[-1]\n    64\t        view_id = judged_view(request) if len(args) == 2 else None\n    65\t        if view_id not in TARGETS:\n    66\t            raise Stop(f'unapproved request in judging (thesis {view_id}): not sent')\n    67\t        self.sent.append(view_id)\n    68\t        return self.inner(*args)\n    69\t\n    70\t\n    71\tclass ItemScope:\n    72\t    \"\"\"One item's transport: only link questions, only at seq 148, only in the linked arm.\"\"\"\n    73\t\n    74\t    def __init__(self, inner, seq, linked, sent):\n    75\t        self.inner, self.seq, self.linked, self.sent = inner, seq, linked, sent\n    76\t\n    77\t    def __call__(self, *args):\n    78\t        request = args[-1]\n    79\t        if not (len(args) == 1 and is_link_request(request) and self.linked and self.seq == LINK_SEQ):\n    80\t            raise Stop(f'unapproved request at seq {self.seq} ({\"link questions\" if len(args) == 1 and is_link_request(request) else \"not a link question\"}): not sent')\n    81\t        self.sent.append(('jev', self.seq, sorted(request['questions'])))\n    82\t        return self.inner(*args)\n    83\t\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"rg -n 'price|ceiling|maximum|reserve|fresh|dry|record|unexpected|stop|filing|archive' docs/research/2026-11-20-production-readiness/dependency-design/TEST-PLAN.md\"","aggregated_output":"1:# The July test: harness, archive, budget and reading rule (D694 (c); for council review before code)\n5:send (`only_objects={'NVDA'}`, the comparison launcher's default): 160 items, 55 judgements, all from the archive; equal to old-2's\n11:   other request from the archive: the ledger equals the rebuilt prefix. This proves only that v119 with no link reproduces the\n15:2. **The archive, proved:** each sequence's archive is a writable copy of old-2's archive (call ids kept) in which every stored judge\n17:   (its request sha gains a suffix), so no exact lookup can return it. At $0 with a recording fake transport: an exact old v9 request\n18:   goes to the transport; an exact old request of another question is answered from the archive; an answer the check refuses is\n21:   two linked dry sequences whose 07-10 answers for v9 and v14 differ (labelled \"DRY-A\", \"DRY-B\"). Every request that runs after the\n23:   judgement on 07-11). The linked dry sequences must write \"v9 reads v14\" at seq 148 (fixed Jev answers) and show the judging-v8 block\n25:   request must be answered from the archive. Both stop paths are exercised with the recording fake: an unapproved request (a third\n27:   before any reservation; a committed out-of-pair link whose reader would never be judged stops the sequence at inspection, before a\n29:4. **The rebuilt requests priced** at published rates (`model.PRICES`) to set the reservation; the reading rule frozen.\n37:**Archive per sequence:** its own writable copy of old-2's archive with the v9 and v14 judge rows retired (step 2 above), so both\n38:questions are judged fresh every day (council R round 3) and every other request replays by exact identity. The harness holds\n39:`live_lock.acquire` on each sequence's store for the run, refuses a store whose last day is unfinished, and never resumes a stopped\n42:**The allow-list, in front of the budget transport:** every request that misses the archive reaches a wrapper before the budget\n46:stops the sequence. The wrapper counts, per target judgement, the provider attempts; the harness asserts\n47:that every v9 and v14 judgement of 07-10..07-12 was answered by a provider attempt of its own sequence (fresh), never by the archive.\n49:**The out-of-pair stop at inspection:** when `round.run` returns successfully for seq 148, the serial item runner reads the store's\n51:or v14 stops the sequence there (not comparable), whether or not that reader would ever be judged.\n54:`SharedLedger`, `BudgetTransport`, with `install_stop_gate`), one ceiling of **$0.15** for all six sequences, used as it behaves: a\n55:Luna call reserves its worst case per attempt and settles at its reported usage; a Jev call reserves its whole internal retry bundle\n56:and settles at up to the attempts times the reported usage, or at the reservation when usage is unavailable. After a sequence stops,\n61:on any day it is queued by a changed v14. **Any other archive miss** (extraction, matching, another question's judgement) stops that\n64:sequence is scored as it ran, with the extra link named in the report; a link whose reader is any other question stops the sequence\n70:  quarters recorded where both give comparable figures; a missing annual figure leaves reconciliation untested.\n77:  forecast in its calculation or as a stated bound; delivery and use of the Bloomberg-compiled $393B (e195) recorded separately; a\n82:  either arm, or a ceiling stop. **Fail:** a new material error, an added refusal, fewer than two correct link selections, or any other\n84:- **Readers:** Claude's marks written first, then a fresh blind Codex reader on the six sequences under shuffled labels, the key outside\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba src/hivemind/views/links.py | sed -n '155,305p'\"","aggregated_output":"   155\t\n   156\tdef circles(conn, proposed):\n   157\t    \"\"\"The proposed links (reader, read) that lie on a circle of the stored relation plus every proposed link, each with one path.\"\"\"\n   158\t    graph = {k: set(v) for k, v in stored_edges(conn).items()}\n   159\t    for link in proposed:\n   160\t        graph.setdefault(link['reader'], set()).add(link['read'])\n   161\t    found = []\n   162\t    for link in proposed:\n   163\t        stack, seen = [(link['read'], [link['reader'], link['read']])], set()\n   164\t        while stack:\n   165\t            node, path = stack.pop()\n   166\t            if node == link['reader']:\n   167\t                found.append((link, path))\n   168\t                break\n   169\t            if node in seen:\n   170\t                continue\n   171\t            seen.add(node)\n   172\t            stack.extend((nxt, path + [nxt]) for nxt in sorted(graph.get(node, ())))\n   173\t    return found\n   174\t\n   175\t\n   176\t# ---------- selection ----------\n   177\t\n   178\tdef _ask(archive, cfg, jobs, transport, record, stage):\n   179\t    \"\"\"One Jev request per job; every request's sha is written into the record before it is sent, and what the archive already held.\"\"\"\n   180\t    entries = []\n   181\t    for state, questions in jobs:\n   182\t        _, sha = model.request_identity(jev.request_for(cfg.matching, state, questions))\n   183\t        entries.append({'stage': stage, 'request_sha256': sha, 'questions': sorted(questions), 'archived_before': bool(archive.lookup(sha))})\n   184\t    record['calls'].extend(entries)\n   185\t    try:\n   186\t        replies = jev_matching._answers(archive, cfg, jobs, 1, transport)\n   187\t    except Exception as error:\n   188\t        record['error'] = f'{type(error).__name__}: {error}'[:300]\n   189\t        raise Refused(f'link question failed: {record[\"error\"]}', record) from error\n   190\t    for entry, reply in zip(entries, replies):\n   191\t        entry['call_id'] = reply.call_id\n   192\t    return [reply.data for reply in replies]\n   193\t\n   194\t\n   195\tdef _passes(answer, accepted):\n   196\t    choice = answer['choice']\n   197\t    return choice if choice in accepted and answer['probabilities'][choice] >= THRESHOLD else None\n   198\t\n   199\t\n   200\tdef choose(archive, cfg, conn, handover, checked, lists, shown_views, *, transport=None):\n   201\t    \"\"\"The links this article proposes: [{'reader', 'read', 'candidate', 'direction', 'sign'}], reader and read being a candidate id\n   202\t    (canonical) or a stored view id; and the record of how they were chosen. Raises Refused for an unbound waiting row, a Jev\n   203\t    failure or a circle that remains after one correction (PRD 06).\"\"\"\n   204\t    record = {'pairs': [], 'calls': [], 'corrections': [], 'proposed': []}\n   205\t    if unbound_waits(conn):\n   206\t        record['error'] = 'the store holds an unbound waiting dependency row'\n   207\t        raise Refused(record['error'], record)\n   208\t    aliases, problems = identity.batch_plan(handover.candidates, checked.outcomes)\n   209\t    if problems:                                   # the writer refuses the same plan (WriteConflict); nothing to ask\n   210\t        record['skipped'] = problems\n   211\t        return [], record\n   212\t    evidence = handover.evidence\n   213\t    stage1, asked = [], []\n   214\t    for c in handover.candidates:\n   215\t        outcome, target, _ = checked.outcomes.get(c['id'], ('skip', None, []))\n   216\t        if outcome not in ('new', 'succession') or aliases.get(c['id']) != c['id']:\n   217\t            continue\n   218\t        rungs = candidate_rungs(conn, c, outcome, target)\n   219\t        if not is_number_question(c['kind'], rungs, c.get('measure')):\n   220\t            record['pairs'].append({'candidate': c['id'], 'eligible': False, 'why': 'not a number question'})\n   221\t            continue\n   222\t        listed = list(dict.fromkeys(list(lists.candidate_lists.get(c['id'], [])) + [v['view_id'] for v in shown_views]))\n   223\t        theses = []\n   224\t        for view_id in listed:\n   225\t            ok = store.is_open(conn, view_id) and stored_is_number_question(conn, view_id)\n   226\t            record['pairs'].append({'candidate': c['id'], 'thesis': view_id, 'eligible': ok})\n   227\t            if ok:\n   228\t                theses.append(view_id)\n   229\t        if theses:\n   230\t            state = jev_matching.candidate_state(c, evidence)\n   231\t            stage1.append((state, {f'reads__{v}': reads_question(jev_matching.thesis_text(conn, v)) for v in theses}))\n   232\t            asked.append((c, state, theses))\n   233\t    if not stage1:\n   234\t        return [], record\n   235\t    answers = _ask(archive, cfg, stage1, transport, record, 'reads')\n   236\t    directions = {}\n   237\t    for (c, state, theses), reply in zip(asked, answers):\n   238\t        for view_id in theses:\n   239\t            answer = reply[f'reads__{view_id}']\n   240\t            direction = _passes(answer, (CANDIDATE_READS, THESIS_READS))\n   241\t            record['pairs'].append({'candidate': c['id'], 'thesis': view_id, 'reads': answer['choice'], 'probabilities': answer['probabilities']})\n   242\t            if direction:\n   243\t                directions[(c['id'], view_id)] = direction\n   244\t    links = _signed(archive, cfg, conn, asked, directions, transport, record)\n   245\t    on_circle = circles(conn, links)\n   246\t    if on_circle:\n   247\t        links = _corrected(archive, cfg, conn, asked, directions, links, on_circle, transport, record)\n   248\t        remaining = circles(conn, links)\n   249\t        if remaining:\n   250\t            record['error'] = 'persistent cycle: ' + '; '.join(' -> '.join(path) for _, path in remaining)\n   251\t            raise Refused(record['error'], record)\n   252\t    record['proposed'] = links\n   253\t    return links, record\n   254\t\n   255\t\n   256\tdef _signed(archive, cfg, conn, asked, directions, transport, record, stage='sign'):\n   257\t    jobs, owners = [], []\n   258\t    for c, state, theses in asked:\n   259\t        questions = {f'sign__{v}': sign_question(jev_matching.thesis_text(conn, v), directions[(c['id'], v)]) for v in theses if (c['id'], v) in directions}\n   260\t        if questions:\n   261\t            jobs.append((state, questions))\n   262\t            owners.append(c)\n   263\t    links = []\n   264\t    if not jobs:\n   265\t        return links\n   266\t    for c, reply in zip(owners, _ask(archive, cfg, jobs, transport, record, stage)):\n   267\t        for qid, answer in sorted(reply.items()):\n   268\t            view_id = qid[len('sign__'):]\n   269\t            sign = _passes(answer, (TOGETHER, OPPOSITE))\n   270\t            record['pairs'].append({'candidate': c['id'], 'thesis': view_id, 'sign': answer['choice'], 'probabilities': answer['probabilities']})\n   271\t            if sign:\n   272\t                direction = directions[(c['id'], view_id)]\n   273\t                reader, read = (c['id'], view_id) if direction == CANDIDATE_READS else (view_id, c['id'])\n   274\t                links.append({'reader': reader, 'read': read, 'candidate': c['id'], 'thesis': view_id, 'direction': direction, 'sign': sign})\n   275\t    return links\n   276\t\n   277\t\n   278\tdef _corrected(archive, cfg, conn, asked, directions, links, on_circle, transport, record):\n   279\t    \"\"\"PRD 06: refuse a circle and ask the model to correct it, once: the pair's READS question again, the offending direction removed\n   280\t    and the circle named; the answer replaces the original.\"\"\"\n   281\t    offending = {(link['candidate'], link['thesis']): path for link, path in on_circle}\n   282\t    jobs, owners = [], []\n   283\t    for c, state, theses in asked:\n   284\t        questions = {}\n   285\t        for view_id in theses:\n   286\t            path = offending.get((c['id'], view_id))\n   287\t            if path is None:\n   288\t                continue\n   289\t            excluded = directions[(c['id'], view_id)]\n   290\t            named = [('the CANDIDATE' if node == c['id'] else 'the THESIS' if node == view_id else node) for node in path]\n   291\t            note = f'Reading this way would make {named[0]} read itself through {\" -> \".join(named)}; a question cannot read its own conclusion.'\n   292\t            questions[f'reads__{view_id}'] = reads_question(jev_matching.thesis_text(conn, view_id), excluded=excluded, note=note)\n   293\t            record['corrections'].append({'candidate': c['id'], 'thesis': view_id, 'rejected': excluded, 'path': path})\n   294\t        if questions:\n   295\t            jobs.append((state, questions))\n   296\t            owners.append(c)\n   297\t    kept = [link for link in links if (link['candidate'], link['thesis']) not in offending]\n   298\t    corrected = {}\n   299\t    for c, reply in zip(owners, _ask(archive, cfg, jobs, transport, record, 'correction')):\n   300\t        for qid, answer in reply.items():\n   301\t            view_id = qid[len('reads__'):]\n   302\t            directions.pop((c['id'], view_id), None)\n   303\t            direction = _passes(answer, (CANDIDATE_READS, THESIS_READS))\n   304\t            record['corrections'].append({'candidate': c['id'], 'thesis': view_id, 'answer': answer['choice'], 'probabilities': answer['probabilities']})\n   305\t            if direction:\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_17","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba clean-arch/e2e-comparison-2026-11-13/budget_replay.py | sed -n '290,375p'; rg -n 'except|round_of_judgements|day_runner|result.failed|commit|finished' src/hivemind/replay.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_17","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba clean-arch/e2e-comparison-2026-11-13/budget_replay.py | sed -n '290,375p'; rg -n 'except|round_of_judgements|day_runner|result.failed|commit|finished' src/hivemind/replay.py\"","aggregated_output":"   290\t            return response\n   291\t        raise model.TransportError('no answer after three attempts')\n   292\t\n   293\t    def _jev(self, request):\n   294\t        estimate = jev_estimate(request)\n   295\t        if not self.ledger.reserve(estimate):\n   296\t            raise model.TransportError('the shared budget ceiling would be passed: not sent')\n   297\t        try:\n   298\t            response = jev.transport(request)\n   299\t        except Exception:\n   300\t            self.ledger.settle(estimate, estimate, kind='jev')\n   301\t            raise\n   302\t        usage = response.get('usage') if isinstance(response, dict) else None\n   303\t        tokens = usage.get('input_tokens') if isinstance(usage, dict) else None\n   304\t        if isinstance(tokens, int) and not isinstance(tokens, bool) and tokens > 0:\n   305\t            # an unanswered attempt inside jev.transport was the same request, so each of the three is billed at most this input;\n   306\t            # the whole charge is settled, so a charge above the reservation sets the overrun flag\n   307\t            actual = jev.ATTEMPTS * tokens * model.PRICES[request['model']][0] / 1e6\n   308\t        else:\n   309\t            actual = estimate                       # usage missing, invalid, or zero for a nonempty request: the whole reservation\n   310\t        self.ledger.settle(estimate, actual, kind='jev', tokens=tokens if isinstance(tokens, int) else None)\n   311\t        return response\n   312\t\n   313\t\n   314\tdef main():\n   315\t    parser = argparse.ArgumentParser()\n   316\t    parser.add_argument('--init-ledger')\n   317\t    parser.add_argument('--ceiling', type=float)\n   318\t    parser.add_argument('--ledger')\n   319\t    parser.add_argument('--from', dest='from_day')\n   320\t    parser.add_argument('--until', dest='until_day')\n   321\t    parser.add_argument('--testdb', default=str(ROOT / 'poc/data/items-nvda-2026-07-01-10-27.sqlite'))\n   322\t    parser.add_argument('--views')\n   323\t    parser.add_argument('--archive')\n   324\t    parser.add_argument('--config', default=str(ROOT / 'poc/config/poc-v118.json'))\n   325\t    parser.add_argument('--universe', default=str(ROOT / 'poc/universe.json'))\n   326\t    parser.add_argument('--only', default='NVDA')\n   327\t    parser.add_argument('--cap', type=float, default=None)\n   328\t    parser.add_argument('--workers', type=int, default=16)\n   329\t    parser.add_argument('--jev-workers', type=int, default=None)\n   330\t    args = parser.parse_args()\n   331\t    if args.init_ledger:\n   332\t        if Path(args.init_ledger).exists():\n   333\t            raise SystemExit('ledger exists: refused (a new ledger needs a new path)')\n   334\t        SharedLedger.init(args.init_ledger, args.ceiling)\n   335\t        print('ledger written:', args.init_ledger, 'ceiling', args.ceiling)\n   336\t        return\n   337\t    for name in ('ledger', 'from_day', 'until_day', 'views', 'archive'):\n   338\t        if not getattr(args, name):\n   339\t            raise SystemExit(f'--{name.replace(\"_day\", \"\")} is required')\n   340\t    os.makedirs(os.path.dirname(args.views), exist_ok=True)\n   341\t    log_path = os.path.join(os.path.dirname(args.views), 'replay.log')\n   342\t\n   343\t    def log(*parts):\n   344\t        line = ' '.join(str(p) for p in parts)\n   345\t        print(line, flush=True)\n   346\t        with open(log_path, 'a', encoding='utf-8') as handle:\n   347\t            handle.write(line + '\\n')\n   348\t\n   349\t    cfg = config.load(args.config)\n   350\t    if cfg.baseline is not None:\n   351\t        raise SystemExit(f'config {cfg.version} uses the retired seeded-question baseline: refused')\n   352\t    import importlib.util\n   353\t    spec = importlib.util.spec_from_file_location('scripts_replay', ROOT / 'scripts/replay.py')\n   354\t    scripts_replay = importlib.util.module_from_spec(spec)\n   355\t    spec.loader.exec_module(scripts_replay)\n   356\t    scripts_replay.refuse_links_engine(cfg)                   # the same refusals scripts/replay.py makes\n   357\t    scripts_replay.refuse_seeded_ledger(args.views)\n   358\t    scripts_replay.refuse_harness_ledger(args.views)\n   359\t    uni = universe.load(args.universe)\n   360\t    archive = model.Archive(args.archive)\n   361\t    ledger = SharedLedger(args.ledger)\n   362\t    install_stop_gate(ledger)                              # Jev's internal retries read the run's stop too (council mo R1)\n   363\t    transport = BudgetTransport(ledger)\n   364\t    jev_workers = args.jev_workers if args.jev_workers is not None else (8 if cfg.matching.engine == 'jev' else 1)\n   365\t    day_runner = parallel_day.ParallelDay(os.path.abspath(args.testdb), os.path.join(os.path.dirname(os.path.abspath(args.views)), 'manifests'),\n   366\t                                          extraction_workers=args.workers, jev_workers=jev_workers) if args.workers > 1 else None\n   367\t    log(f'--- budgeted replay {args.from_day}..{args.until_day} config {cfg.version}/{cfg.checksum} provider {cfg.provider} universe {uni.version} '\n   368\t        f'workers {args.workers}; ledger {args.ledger} {ledger.read()}')\n   369\t    totals = replay.run(testdb_path=args.testdb, views_path=args.views, archive=archive, cfg=cfg, universe=uni,\n   370\t                        from_day=args.from_day, until_day=args.until_day, spend_cap_usd=args.cap, log=log,\n   371\t                        only_objects=set(args.only.split(',')) if args.only else None, transport=transport, day_runner=day_runner)\n   372\t    log('totals:', totals)\n   373\t    log('ledger:', ledger.read())\n   374\t\n   375\t\n21:def refuse_unfinished_parallel(conn):\n32:        raise StaleHandoverError('unfinished day-start extractions; keep this ledger and replay into a new one: ' + ', '.join(ids))\n52:        transport=None, log=print, only_objects=None, max_items_per_day=None, day_runner=None):\n55:    refuse_unfinished_parallel(conn)\n90:                    conn.commit()\n94:        results = (day_runner(conn, archive, cfg, universe, to_run, day=day, transport=transport, log=log) if day_runner else\n97:        finished = 0\n102:                finished += 1\n108:                if result.failed:\n110:                    log(f'  ! {result.input_id[:60]}: {result.failed}')\n111:                    raise RuntimeError(f'item failed; day {day} remains resumable: {result.failed}')\n117:        if finished != len(to_run):\n131:        conn.commit()\n141:            conn.commit()\n","exit_code":0,"status":"completed"}}
