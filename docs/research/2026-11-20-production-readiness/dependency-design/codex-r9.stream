{"type":"item.completed","item":{"id":"item_24","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba src/hivemind/views/writing.py | sed -n '104,235p'; nl -ba src/hivemind/views/judging.py | sed -n '104,185p'\"","aggregated_output":"   104\t            and (incoming.get('original_who') or '').strip().casefold() != (old.get('original_who') or '').strip().casefold():\n   105\t        return f'another party\\'s {old_tier.replace(\"_\", \" \")}'       # an official confirms or denies; the original source revises\n   106\t    return ''\n   107\t\n   108\t\n   109\tclass WriteConflict(ValueError):\n   110\t    \"\"\"The checked plan no longer fits the writable ledger; no partial write is retained.\"\"\"\n   111\t\n   112\t\n   113\tdef write(conn, universe, seq, item, handover, checked, second_pass, *, proposed_links=None):\n   114\t    \"\"\"Write atomically within the caller's transaction; the caller commits the completion marker with it. proposed_links: the reading\n   115\t    links the link step chose (views/links.py, D694), written after the new views exist; None writes none.\"\"\"\n   116\t    if not conn.in_transaction:\n   117\t        conn.execute('begin immediate')\n   118\t    conn.execute('savepoint view_write')\n   119\t    try:\n   120\t        store.ensure_writable_columns(conn)\n   121\t        result = _write(conn, universe, seq, item, handover, checked, second_pass)\n   122\t        if proposed_links:\n   123\t            result.links = _write_links(conn, seq, proposed_links, result)\n   124\t    except Exception:\n   125\t        conn.execute('rollback to view_write')\n   126\t        conn.execute('release view_write')\n   127\t        raise\n   128\t    conn.execute('release view_write')\n   129\t    return result\n   130\t\n   131\t\n   132\tdef _write_links(conn, seq, proposed_links, written):\n   133\t    \"\"\"D694, D695 (design §4): each proposed link resolved to stored ids, re-checked against the ledger as it stands inside this write\n   134\t    (both ends open, no circle, no other label on the same pair), labelled from the stored rungs, written with kind 'reads'. An existing\n   135\t    question that gains a link is judged in the day's round. Any mismatch refuses the whole write.\"\"\"\n   136\t    from . import links as _links\n   137\t    committed = []\n   138\t    for link in proposed_links:\n   139\t        reader, read = (written.new_views.get(link[end], link[end]) for end in ('reader', 'read'))\n   140\t        for end in (reader, read):\n   141\t            if not store.view(conn, end):\n   142\t                raise WriteConflict(f'link {link[\"reader\"]} -> {link[\"read\"]}: {end} was not opened')\n   143\t            if not store.is_open(conn, end):\n   144\t                raise WriteConflict(f'link {reader} -> {read}: {end} is closed')\n   145\t        label = _links.label_for(store.rungs_of(conn, reader), store.rungs_of(conn, read), link['sign'])\n   146\t        if label is None:\n   147\t            raise WriteConflict(f'link {reader} -> {read}: no label can be computed from the stored rungs')\n   148\t        existing = {r['direction'] for r in conn.execute('select direction from dependencies where view_id=? and depends_on=?', (reader, read))}\n   149\t        if existing and existing != {label}:\n   150\t            raise WriteConflict(f'link {reader} -> {read}: the pair already carries another label {sorted(existing)}')\n   151\t        if existing:\n   152\t            continue\n   153\t        if store.would_cycle(conn, reader, read):\n   154\t            raise WriteConflict(f'link {reader} -> {read}: would close a circle')\n   155\t        store.insert(conn, 'dependencies', view_id=reader, depends_on=read, wait_chain_view_id='', wait_year='', direction=label, seq=seq, kind=_links.KIND)\n   156\t        if reader not in written.new_views.values():\n   157\t            written.changed_views.add(reader)\n   158\t        committed.append({'reader': reader, 'read': read, 'label': label, 'sign': link['sign'], 'direction': link['direction']})\n   159\t    return committed\n   160\t\n   161\t\n   162\tdef _write(conn, universe, seq, item, handover, checked, second_pass):\n   163\t    \"\"\"second_pass: {(handover evidence id, view_id): (outcome, target_evidence_id, said_day)} for candidate-linked\n   164\t    evidence compared after the candidates' destinations were known (new views' evidence is simply new).\"\"\"\n   165\t    changed, notes, new_views, evidence_ids = set(), [], {}, {}\n   166\t    candidate_ids = {c['id'] for c in handover.candidates}\n   167\t    aliases, problems = identity.batch_plan(handover.candidates, checked.outcomes)\n   168\t    if problems:\n   169\t        raise WriteConflict('; '.join(problems))\n   170\t    created = {}\n   171\t    # 1. new views, themes first\n   172\t    order = sorted(handover.candidates, key=lambda c: 0 if c['kind'] == 'theme' else 1)\n   173\t    for c in order:\n   174\t        outcome, target, deps = checked.outcomes.get(c['id'], ('skip', None, []))\n   175\t        if outcome not in ('new', 'succession'):\n   176\t            continue\n   177\t        canonical = aliases[c['id']]\n   178\t        if canonical in created:\n   179\t            new_views[c['id']] = created[canonical]\n   180\t            continue\n   181\t        if store.exact_key_views(conn, c):\n   182\t            raise WriteConflict(f'candidate {c[\"id\"]}: existing exact identity requires matching')\n   183\t        object_id = universe.resolve(c['object'])\n   184\t        if outcome == 'succession' and target:\n   185\t            c = oriented_like(c, store.rungs_of(conn, target), notes)\n   186\t        view_id = _create_view(conn, c, object_id, universe.kind(object_id), seq, item, universe)\n   187\t        new_views[c['id']] = view_id\n   188\t        created[canonical] = view_id\n   189\t        if outcome == 'succession' and target:\n   190\t            store.insert(conn, 'successions', view_id=view_id, succeeds=target, seq=seq)\n   191\t        changed.add(view_id)\n   192\t    # 1b. research groups (D149, D165, D166): the groups module plans creations and memberships from the handover's\n   193\t    #     declarations, the stored groups' names and each new thesis's own text; a merged candidate adds nothing\n   194\t    from .. import extraction as _extraction\n   195\t    from . import groups as _groups\n   196\t    creations, memberships, group_notes, extensions = _groups.plan(getattr(handover, 'new_groups', None) or [], _groups.stored_groups(conn), order, new_views,\n   197\t                                                                    _extraction.tracks_a_matter, universe)\n   198\t    notes.extend(group_notes)\n   199\t    group_ids = {}\n   200\t    for creation in creations:\n   201\t        group_ids[creation['local_id']] = _next_id(conn, 'thesis_groups', 'group_id', 'g')\n   202\t        objects = sorted({store.view(conn, view_id)['object_id'] for view_id, key, _ in memberships if key == creation['local_id']})\n   203\t        store.add_group(conn, group_id=group_ids[creation['local_id']], name=creation['name'], scope=creation['scope'], seq=seq, input_id=item['input_id'],\n   204\t                        object_ids=objects, aliases=creation['aliases'])\n   205\t    for view_id, key, basis in memberships:\n   206\t        store.add_member(conn, group_ids.get(key, key), view_id, seq, item['input_id'], basis)\n   207\t    for group_id, names in extensions:            # D166: a declaration that is a stored group under other names gives it those names\n   208\t        store.add_group_aliases(conn, group_id, names, seq, item['input_id'])\n   209\t    # 2. dependencies of the new views (candidate ids resolve to the views just created)\n   210\t    dependencies_written = set()\n   211\t    for c in order:\n   212\t        outcome, target, deps = checked.outcomes.get(c['id'], ('skip', None, []))\n   213\t        if c['id'] not in new_views:\n   214\t            continue\n   215\t        view_id = new_views[c['id']]\n   216\t        for dep in deps:\n   217\t            depends_on = dep['view_id']\n   218\t            if depends_on in new_views:\n   219\t                depends_on = new_views[depends_on]\n   220\t            elif depends_on in candidate_ids:\n   221\t                notes.append(f'dependency {view_id} -> candidate {depends_on} dropped: that candidate was not opened')\n   222\t                continue\n   223\t            if depends_on and store.would_cycle(conn, view_id, depends_on):\n   224\t                notes.append(f'dependency {view_id} -> {depends_on} dropped: cycle')\n   225\t                continue\n   226\t            chain = dep['wait_chain_view_id']\n   227\t            if chain in new_views:\n   228\t                chain = new_views[chain]\n   229\t            wait_year = dep['wait_year']\n   230\t            if wait_year and chain and hasattr(universe, 'canonical_year'):          # the chain's object decides the spelling (FY2027 or 2026)\n   231\t                chain_view = store.view(conn, chain)\n   232\t                wait_year = universe.canonical_year(chain_view['object_id'] if chain_view else object_id_of(universe, c), wait_year)\n   233\t            edge = (view_id, depends_on, chain, wait_year, dep['direction'])\n   234\t            if edge in dependencies_written:\n   235\t                continue\n   104\t    \"\"\"Dependencies first: a view comes after every view it depends on that is also in the set.\"\"\"\n   105\t    remaining = list(dict.fromkeys(view_ids))\n   106\t    ordered, placed = [], set()\n   107\t    while remaining:\n   108\t        progressed = False\n   109\t        for view_id in list(remaining):\n   110\t            deps = {d['resolved_to'] for d in store.dependencies_of(conn, view_id) if d['resolved_to']}\n   111\t            if deps.isdisjoint(set(remaining) - {view_id}) or deps <= placed:\n   112\t                ordered.append(view_id)\n   113\t                placed.add(view_id)\n   114\t                remaining.remove(view_id)\n   115\t                progressed = True\n   116\t        if not progressed:                 # a cycle slipped through: keep going in the given order\n   117\t            ordered.extend(remaining)\n   118\t            break\n   119\t    return ordered\n   120\t\n   121\t\n   122\tdef _indented(text, indent='        '):\n   123\t    \"\"\"A stored value inside a block: every continuation line indented, so no physical line can read as a header or a listed id.\"\"\"\n   124\t    return str(text).replace('\\r\\n', '\\n').replace('\\n', '\\n' + indent)\n   125\t\n   126\t\n   127\tdef _dependency_lines_full(conn, target, d, state, rung_label, tv, flag):\n   128\t    \"\"\"judging-v8 (D694, design §3): the read judgement's comparison point and the system's forecast in full, labelled as ours, beside\n   129\t    the reasons excerpt; the read question not judged yet shows only that.\"\"\"\n   130\t    if not state:\n   131\t        return [f'- {target} ({flag}; {d[\"direction\"]}) {tv[\"question\"]}: now not judged yet']\n   132\t    return [f'- {target} ({flag}; {d[\"direction\"]}) {tv[\"question\"]}: now rung {state[\"rung\"]} {rung_label}, judged {state[\"publication_day\"]}',\n   133\t            f'    Comparison point stated by that judgement: {_indented(state.get(\"reference\") or \"not stated\")}',\n   134\t            f'    The system\\'s forecast for it (our own judgement, not evidence): {_indented(state.get(\"implied_outcome\") or \"not stated\")}',\n   135\t            f'    Reasons (excerpt): {_indented((state.get(\"reasons\") or \"\")[:600])}']\n   136\t\n   137\t\n   138\tdef _lines_english(conn, view_id, v, rungs, pieces, deps, last, themes=(), hidden=0, full_dependencies=False):\n   139\t    \"\"\"hidden: how many pieces in force are not shown. full_dependencies: the judging-v8 dependency block.\"\"\"\n   140\t    lines = [f'Thesis {view_id} ({v[\"object_id\"]}, {v[\"kind\"]}, focus \"{v[\"looks_at\"]}\", {v[\"year\"] or \"\"}, due {v[\"due_day\"]}): {v[\"question\"]}',\n   141\t             'Ladder: ' + ' / '.join(f'rung {r[\"position\"]} {r[\"label\"]}: {r[\"condition\"]}' for r in rungs), '',\n   142\t             f'[Evidence in view under this thesis, {len(pieces)} items]']\n   143\t    if hidden:\n   144\t        lines.append(f'[Not shown: {hidden} more pieces in force, read in earlier judgements; the previous conclusion carries them]')\n   145\t    for p in pieces:\n   146\t        src = p['sources'][0] if p['sources'] else {}\n   147\t        lines.append(f'- {p[\"evidence_id\"]} [{p[\"tier\"]}; {p[\"speaker\"]}; original source {p[\"original_who\"]} {p[\"original_day\"]}; from {src.get(\"input_id\")} {src.get(\"publication_day\")}] {p[\"one_line\"]}\\n    Quote: {p[\"quote\"][:400]}')\n   148\t        if p.get('replaced'):\n   149\t            lines.append(f'    It replaces {p[\"replaced\"][\"evidence_id\"]} ({p[\"replaced\"][\"original_day\"]}): {p[\"replaced\"][\"one_line\"]}')\n   150\t        if p.get('same_as'):\n   151\t            lines.append(f'    Opinion, not verified: the matcher read this as the same claim as {\", \".join(p[\"same_as\"])}; the argument counts one claim, one more outlet.')\n   152\t        if p.get('revises'):\n   153\t            lines.append(f'    Opinion, not verified: the matcher read it as a later version of {p[\"revises\"][\"evidence_id\"]} ({p[\"revises\"][\"original_day\"]}); both are in force: {p[\"revises\"][\"one_line\"]}')\n   154\t    if deps:\n   155\t        lines.append('\\n[Current conclusions of the theses it depends on]')\n   156\t        for d in deps:\n   157\t            target = d['resolved_to']\n   158\t            if not target:\n   159\t                lines.append(f'- the {d[\"wait_year\"]} thesis on chain {d[\"wait_chain_view_id\"]}: not yet created ({d[\"direction\"]})')\n   160\t                continue\n   161\t            tv = store.view(conn, target)\n   162\t            state = store.current_state(conn, target)\n   163\t            flag = 'historical only' if d['resolution'] == 'history_only' else ('closed' if not store.is_open(conn, target) else 'open')\n   164\t            rung_label = store.rungs_of(conn, target)[state['rung'] - 1]['label'] if state else 'not judged yet'\n   165\t            if full_dependencies:\n   166\t                lines.extend(_dependency_lines_full(conn, target, d, state, rung_label, tv, flag))\n   167\t                continue\n   168\t            lines.append(f'- {target} ({flag}; {d[\"direction\"]}) {tv[\"question\"]}: now rung {state[\"rung\"] if state else \"-\"} {rung_label}; reasons: {(state or {}).get(\"reasons\", \"\")[:600]}')\n   169\t    if themes:\n   170\t        lines.append(f'\\n[Themes in force, {len(themes)}]')\n   171\t        for theme in themes:\n   172\t            tv, state = theme['view'], theme['state']\n   173\t            mark = f'; {UPDATED_MARK}' if theme['updated'] else ''\n   174\t            lines.append(f'- {theme[\"view_id\"]} ({tv[\"object_id\"]}, due {tv[\"due_day\"]}) {tv[\"question\"]}: now rung {state[\"rung\"]} {theme[\"rung_label\"]}; '\n   175\t                         f'judged {state[\"publication_day\"]}{mark}; reasons: {(state[\"reasons\"] or \"\")[:THEME_REASONS_CHARS]}')\n   176\t    if last:\n   177\t        lines.append(f'\\n[Previous conclusion, for comparison only] rung {last[\"rung\"]}; reasons: {last[\"reasons\"][:800]}')\n   178\t    else:\n   179\t        lines.append('\\n[Previous conclusion] none: this is the first judgement, so changed must be true.')\n   180\t    lines.append('\\nAnswer per the JSON schema. cites may name only the evidence ids listed above; '\n   181\t                 + ('cites_views only the dependency thesis ids listed above' if deps else 'cites_views must be empty: this thesis depends on no other thesis')\n   182\t                 + ('; theme_pushes only the theme ids listed above; a theme id goes only in theme_pushes, never in cites or cites_views' if themes else '') + '.')\n   183\t    return lines\n   184\t\n   185\t\n","exit_code":0,"status":"completed"}}
