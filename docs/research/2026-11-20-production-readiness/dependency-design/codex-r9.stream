{"type":"item.completed","item":{"id":"item_28","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba tests/test_links.py | sed -n '345,455p'; rg -n 'harness|seq|effective|close' src/hivemind/live_lock.py src/hivemind/views/pull.py src/hivemind/dispatch.py\"","aggregated_output":"   345\t    spec.loader.exec_module(module)\n   346\t    return module\n   347\t\n   348\t\n   349\tdef test_the_links_engine_loads_but_ordinary_launchers_refuse_it():\n   350\t    assert V119.matching.engine == links.ENGINE and V119.rejudging.prompt_version == 'judging-v8'\n   351\t    with pytest.raises(SystemExit):\n   352\t        scripts_replay().refuse_links_engine(V119)\n   353\t    scripts_replay().refuse_links_engine(V118)\n   354\t\n   355\t\n   356\tdef test_an_ordinary_replay_refuses_a_harness_only_ledger_before_routing(tmp_path):\n   357\t    conn = ledger(tmp_path, [('v1', KEY, RUNGS, 'Data Center revenue FY2027?')])\n   358\t    conn.execute('create table harness_only (name text, day text)')\n   359\t    conn.commit()\n   360\t    conn.close()\n   361\t    before = os.path.getmtime(tmp_path / 'views.sqlite')\n   362\t    run = subprocess.run([sys.executable, os.path.join(ROOT, 'scripts', 'replay.py'), '--from', '2026-05-20', '--until', '2026-05-20',\n   363\t                          '--views', str(tmp_path / 'views.sqlite'), '--archive', str(tmp_path / 'archive.sqlite'), '--workers', '1'],\n   364\t                         capture_output=True, text=True, cwd=str(tmp_path))\n   365\t    assert run.returncode != 0 and 'harness-only' in run.stderr\n   366\t    assert os.path.getmtime(tmp_path / 'views.sqlite') == before and not (tmp_path / 'archive.sqlite').exists()\n   367\t\n   368\t\n   369\t# ---------- §1, tests 2 and 8: the link step inside the article, and its record ----------\n   370\t\n   371\tdef run_article(tmp_path, cfg, script, conn):\n   372\t    total = candidate('c1', rungs=TOTAL_RUNGS, question='Total revenue FY2027?', looks_at='total revenue', **TOTAL)\n   373\t    transport = recording(dict({'rel__v1': ('different', 0.9)}, **script))\n   374\t    item = dict(ITEM, text='Total revenue guidance.', publication_day='2026-05-20')\n   375\t    result = rounds.run(conn, model.Archive(str(tmp_path / 'archive.sqlite')), cfg, UNIVERSE, item, 2, transport=transport,\n   376\t                        extractor=lambda *args, **kwargs: handover_of(total))\n   377\t    return result, transport\n   378\t\n   379\t\n   380\tdef test_the_article_writes_the_link_and_records_proposed_then_committed(tmp_path):\n   381\t    conn = ledger(tmp_path, [('v1', KEY, RUNGS, 'Data Center revenue FY2027?')])\n   382\t    result, transport = run_article(tmp_path, CFG, {'reads__v1': (links.THESIS_READS, 0.8), 'sign__v1': (links.TOGETHER, 0.8)}, conn)\n   383\t    assert result.failed == ''\n   384\t    assert [tuple(r) for r in conn.execute('select view_id, kind from dependencies')] == [('v1', 'reads')]\n   385\t    rows = conn.execute('select attempt_id, status, config_checksum, record_json from link_selections order by id').fetchall()\n   386\t    assert [(r[0], r[1]) for r in rows] == [(ITEM['input_id'] + '#1', 'proposed'), (ITEM['input_id'] + '#1', 'committed')]\n   387\t    assert rows[0][2] == CFG.checksum and json.loads(rows[1][3])['links'][0]['label'] == 'first_is_bullish'\n   388\t    written = json.loads(conn.execute(\"select reason from processing_steps where step='written'\").fetchone()[0])\n   389\t    assert 'v1' in written['changed']\n   390\t\n   391\t\n   392\tdef test_under_the_jev_engine_no_link_question_is_asked(tmp_path):\n   393\t    conn = ledger(tmp_path, [('v1', KEY, RUNGS, 'Data Center revenue FY2027?')])\n   394\t    result, transport = run_article(tmp_path, CFG_JEV, {'reads__v1': (links.THESIS_READS, 0.8), 'sign__v1': (links.TOGETHER, 0.8)}, conn)\n   395\t    assert result.failed == '' and link_questions(transport.sent) == []\n   396\t    assert conn.execute('select count(*) from dependencies').fetchone()[0] == 0\n   397\t    assert conn.execute('select count(*) from link_selections').fetchone()[0] == 0\n   398\t\n   399\t\n   400\tdef test_a_jev_failure_records_failed_alone_with_the_failing_request(tmp_path):\n   401\t    conn = ledger(tmp_path, [('v1', KEY, RUNGS, 'Data Center revenue FY2027?')])\n   402\t    total = candidate('c1', rungs=TOTAL_RUNGS, question='Total revenue FY2027?', looks_at='total revenue', **TOTAL)\n   403\t    inner = scripted({'rel__v1': ('different', 0.9)})\n   404\t\n   405\t    def transport(request):\n   406\t        if any(qid.startswith('reads__') for qid in request['questions']):\n   407\t            raise model.TransportError('Jev transport failed: URLError')\n   408\t        return inner(request)\n   409\t    item = dict(ITEM, text='Total revenue guidance.')\n   410\t    result = rounds.run(conn, model.Archive(str(tmp_path / 'archive.sqlite')), CFG, UNIVERSE, item, 2, transport=transport,\n   411\t                        extractor=lambda *args, **kwargs: handover_of(total))\n   412\t    assert result.failed.startswith('linking: link question failed')\n   413\t    rows = conn.execute('select status, record_json from link_selections').fetchall()\n   414\t    assert [r[0] for r in rows] == ['failed']\n   415\t    call = json.loads(rows[0][1])['calls'][0]\n   416\t    assert call['stage'] == 'reads' and len(call['request_sha256']) == 64 and 'error' in json.loads(rows[0][1])\n   417\t\n   418\t\n   419\tdef test_a_write_conflict_after_the_proposal_records_proposed_then_failed(tmp_path, monkeypatch):\n   420\t    conn = ledger(tmp_path, [('v1', KEY, RUNGS, 'Data Center revenue FY2027?')])\n   421\t    monkeypatch.setattr(links, 'label_for', lambda *args: None)           # the stored rungs give no label: the write refuses\n   422\t    result, _ = run_article(tmp_path, CFG, {'reads__v1': (links.THESIS_READS, 0.8), 'sign__v1': (links.TOGETHER, 0.8)}, conn)\n   423\t    assert result.failed.startswith('writing:')\n   424\t    assert [r[0] for r in conn.execute('select status from link_selections order by id')] == ['proposed', 'failed']\n   425\t    assert conn.execute('select count(*) from dependencies').fetchone()[0] == 0\nrg: src/hivemind/views/pull.py: No such file or directory (os error 2)\nsrc/hivemind/live_lock.py:65:        os.close(descriptor)\nsrc/hivemind/live_lock.py:99:        os.close(held.descriptor)\nsrc/hivemind/live_lock.py:118:    os.close(descriptor)\nsrc/hivemind/live_lock.py:132:                    connection.close()\nsrc/hivemind/dispatch.py:2:was it processed before? what is its classification result? Items that go to extraction get a sequence number in\nsrc/hivemind/dispatch.py:15:    sequence_no: int = 0\nsrc/hivemind/dispatch.py:32:    if last and last['step'] in STEPS and last['sequence_no']:\nsrc/hivemind/dispatch.py:33:        # unfinished work keeps its sequence number: after an ok step it continues at the next step, after a\nsrc/hivemind/dispatch.py:37:        return Route('extract', sequence_no=last['sequence_no'], resume_from=resume_from, reason='resuming')\nsrc/hivemind/dispatch.py:49:    # the sequence number is taken in arrival order and written at once, so two items routed before either is\nsrc/hivemind/dispatch.py:51:    sequence_no = store.next_sequence(conn)\nsrc/hivemind/dispatch.py:52:    store.mark_step(conn, input_id, sequence_no, 'dispatched', 'ok', '', item.get('publication_day'), time.strftime('%Y-%m-%dT%H:%M:%S'))\nsrc/hivemind/dispatch.py:54:    return Route('extract', sequence_no=sequence_no, reason='')\nsrc/hivemind/dispatch.py:57:def mark(conn, item, sequence_no, step, result='ok', reason=''):\nsrc/hivemind/dispatch.py:58:    store.mark_step(conn, item['input_id'], sequence_no, step, result, reason, item.get('publication_day'), time.strftime('%Y-%m-%dT%H:%M:%S'))\n","exit_code":2,"status":"failed"}}
