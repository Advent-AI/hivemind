{"type":"item.completed","item":{"id":"item_35","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba src/hivemind/extraction.py | sed -n '33,80p;448,510p'; nl -ba src/hivemind/config.py | sed -n '95,175p'\"","aggregated_output":"    33\t}\n    34\t\n    35\t\n    36\tdef require_supported(version):\n    37\t    \"\"\"Refuses a prompt version this code does not build, before any request is made.\"\"\"\n    38\t    if version not in SUPPORTED_VERSIONS:\n    39\t        raise ValueError(f'extraction {version!r} is not built; this code builds only {\", \".join(SUPPORTED_VERSIONS)} (D274)')\n    40\t\n    41\t\n    42\tdef shown_views(conn, cfg, item, objects):\n    43\t    \"\"\"The questions an item's extraction request shows (05-extraction block 5): the objects' questions open at the start of the\n    44\t    item's day, the same list for every item of that day (D251), with the key, groups and aliases each had then (they feed its takes\n    45\t    line) and its direct parents (they feed the narrowest rule). The one place the stream and the parallel runner take the list from.\"\"\"\n    46\t    require_supported(cfg.extraction_setting(item['category']).prompt_version.rpartition('-')[2])\n    47\t    from .views import store\n    48\t    return [dict(v, key=store.view_key(conn, v['view_id']) or {},\n    49\t                 groups=[{'name': g['name'], 'scope': g['scope'], 'aliases': g.get('aliases') or []}\n    50\t                         for g in store.groups_of_view_at(conn, v['view_id'], v['snapshot_seq'])],\n    51\t                 parents=store.direct_parents(conn, v['view_id'], v['snapshot_seq']))\n    52\t            for v in store.views_open_at_day_start(conn, objects, item['publication_day'])]\n    53\t\n    54\t\n    55\tdef narrowest_links(links, parents):\n    56\t    \"\"\"D207's one rule the filing enforces in code (2026-11-02, D265): a statement linked to a question and to a question that question\n    57\t    depends on (a driver and its root, transitively) keeps the narrower one only. `parents` maps a view id to the ids it depends on.\"\"\"\n    58\t    def ancestors(view_id, seen):\n    59\t        for parent in parents.get(view_id, ()):\n    60\t            if parent not in seen:\n    61\t                seen.add(parent)\n    62\t                ancestors(parent, seen)\n    63\t        return seen\n    64\t    broader = set()\n    65\t    for link in links:\n    66\t        broader |= ancestors(link, set())\n    67\t    return [l for l in links if l not in broader]\n    68\t\n    69\t\n    70\t\n    71\tdef base_schema():\n    72\t    return {\n    73\t        'type': 'object', 'additionalProperties': False, 'required': ['evidence', 'candidates'],\n    74\t        'properties': {\n    75\t            'evidence': {'type': 'array', 'items': {\n    76\t                'type': 'object', 'additionalProperties': False,\n    77\t                'required': ['id', 'quote', 'one_line', 'speaker', 'original_who', 'original_day', 'tier', 'event_time', 'links'],\n    78\t                'properties': {\n    79\t                    'id': {'type': 'string'}, 'quote': {'type': 'string'}, 'one_line': {'type': 'string'}, 'speaker': {'type': 'string'},\n    80\t                    'original_who': {'type': 'string'}, 'original_day': {'type': 'string'}, 'tier': {'type': 'string', 'enum': TIERS},\n   448\t@dataclasses.dataclass\n   449\tclass Reading:\n   450\t    \"\"\"An item read: the extraction answer through the code checks, before the handover (the parallel day prepares it early and\n   451\t    files it at the item's turn).\"\"\"\n   452\t    evidence: list\n   453\t    candidates: list\n   454\t    dropped: list\n   455\t    new_groups: list\n   456\t    answer: object\n   457\t    version: str\n   458\t\n   459\t\n   460\tdef read_item(archive, cfg, item, text, shown_views, universe, *, transport=None):\n   461\t    \"\"\"The extraction call and the code checks on its answer: a statement may link to a shown question or to a kept candidate.\"\"\"\n   462\t    setting, system, user, schema = request_for(cfg, item, text, shown_views, universe)\n   463\t    answer = model.call(archive, cfg, setting, system, user, schema, 'extraction', 'extract', transport=transport)\n   464\t    evidence, candidates, dropped, new_groups = sift_with_groups(answer.data, item, text, {v['view_id'] for v in shown_views}, universe)\n   465\t    return Reading(evidence, candidates, dropped, new_groups, answer, setting.prompt_version.rpartition('-')[2])\n   466\t\n   467\t\n   468\tdef file_reading(reading, item, shown_views):\n   469\t    \"\"\"The handover: the extraction's own links are the filing (D256). A statement linked to a question and to a question that\n   470\t    question depends on keeps the narrower one (D207); a statement no open question and no kept candidate takes is dropped as 'no\n   471\t    home' (D209), like every other drop: a candidate left with none of its evidence is dropped too, and a statement whose only link was\n   472\t    such a candidate has no home.\"\"\"\n   473\t    candidates, dropped, answer = reading.candidates, list(reading.dropped), reading.answer\n   474\t    parents = {v['view_id']: v.get('parents') or [] for v in shown_views}\n   475\t    evidence = [dict(e, links=narrowest_links(e['links'], parents)) for e in reading.evidence]\n   476\t    while True:\n   477\t        candidates = candidates_with_evidence(candidates, {e['id'] for e in evidence}, item, dropped)\n   478\t        candidate_ids = {c['id'] for c in candidates}\n   479\t        evidence = [dict(e, links=[l for l in e['links'] if not placement.CANDIDATE_ID.match(l) or l in candidate_ids]) for e in evidence]\n   480\t        homeless = [e for e in evidence if not e['links']]\n   481\t        if not homeless:\n   482\t            break\n   483\t        dropped.extend((e['id'], 'no home') for e in homeless)\n   484\t        evidence = [e for e in evidence if e['links']]\n   485\t    return Handover(evidence, candidates, dropped, answer.call_id, answer.request_sha256, answer.cached, answer.cost_usd, reading.new_groups)\n   486\t\n   487\t\n   488\tdef extract(archive, cfg, item, text, shown_views, universe, *, transport=None):\n   489\t    \"\"\"One item through extraction: read, then file under the questions shown.\"\"\"\n   490\t    return file_reading(read_item(archive, cfg, item, text, shown_views, universe, transport=transport), item, shown_views)\n   491\t\n   492\t\n   493\tdef check_bounds(rungs):\n   494\t    \"\"\"None when the rungs' numeric bounds form one unbroken partition (or none carries bounds), else the problem.\"\"\"\n   495\t    bounded = [r for r in rungs if r.get('lo') is not None or r.get('hi') is not None]\n   496\t    if not bounded:\n   497\t        return None\n   498\t    if len(bounded) != len(rungs):\n   499\t        return 'some rungs carry bounds and some do not'\n   500\t    ordered = sorted(rungs, key=lambda r: -1e300 if r.get('lo') is None else float(r['lo']))\n   501\t    for a, b in zip(ordered, ordered[1:]):\n   502\t        if a.get('hi') is None or b.get('lo') is None or float(a['hi']) != float(b['lo']):\n   503\t            return 'rung bounds overlap or leave a gap'\n   504\t    if ordered[-1].get('hi') is not None:\n   505\t        return 'the top rung must be open above'\n   506\t    return None\n   507\t\n   508\t\n   509\tdef check_group_refs(c, declared):\n   510\t    \"\"\"None when a candidate's research-group references are well formed: no repeats, each a declared local id; empty is allowed\n    95\t    raw = json.loads(text)\n    96\t    for key in ('version', 'provider', 'search_top_n', 'extraction', 'matching', 'rejudging', 'final_verdict'):\n    97\t        if key not in raw:\n    98\t            raise ConfigError(f'config lacks {key}')\n    99\t    canonical = json.dumps({k: v for k, v in raw.items() if not k.startswith('_')}, sort_keys=True, ensure_ascii=False)\n   100\t    checksum = hashlib.sha256(canonical.encode('utf-8')).hexdigest()[:16]\n   101\t    extraction = {category: _setting(f'extraction.{category}', setting) for category, setting in raw['extraction'].items()}\n   102\t    matching, rejudging = _setting('matching', raw['matching']), _setting('rejudging', raw['rejudging'])\n   103\t    idea = _setting('idea', raw['idea']) if 'idea' in raw else None\n   104\t    idea_summary = _setting('idea_summary', raw['idea_summary']) if 'idea_summary' in raw else None\n   105\t    if idea_summary is not None and idea is None:\n   106\t        raise ConfigError('idea_summary requires an idea setting')\n   107\t    collision = _setting('collision', raw['collision']) if 'collision' in raw else None\n   108\t    placement = _setting('placement', raw['placement']) if 'placement' in raw else None\n   109\t    baseline = _setting('baseline', raw['baseline']) if 'baseline' in raw else None\n   110\t    _prompt_files(extraction, matching, rejudging, idea, idea_summary, collision, placement)       # final_verdict is kept in the file but no POC step calls it\n   111\t    if baseline is not None and not os.path.exists(prompt_path(baseline.prompt_version + '.json')):\n   112\t        raise ConfigError(f'baseline: prompt {baseline.prompt_version}.json does not exist')\n   113\t    return Config(version=str(raw['version']), checksum=checksum, provider=str(raw['provider']),\n   114\t                  search_top_n=int(raw['search_top_n']), extraction=extraction,\n   115\t                  matching=matching, rejudging=rejudging, final_verdict=_setting('final_verdict', raw['final_verdict']), idea=idea, idea_summary=idea_summary, collision=collision, placement=placement,\n   116\t                  baseline=baseline)\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_36","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba src/hivemind/model.py | sed -n '50,130p;250,292p'; nl -ba src/hivemind/jev.py | sed -n '16,53p;78,112p'\"","aggregated_output":"    50\t    pass\n    51\t\n    52\t\n    53\tclass TransportError(RuntimeError):\n    54\t    pass\n    55\t\n    56\t\n    57\t@dataclasses.dataclass\n    58\tclass Answer:\n    59\t    data: dict\n    60\t    call_id: int\n    61\t    request_sha256: str\n    62\t    cached: bool\n    63\t    prompt_chars: int\n    64\t    input_tokens: int\n    65\t    output_tokens: int\n    66\t    cost_usd: float\n    67\t\n    68\t\n    69\tclass Archive:\n    70\t    \"\"\"Shared by the extraction worker threads: one connection, every access under a lock.\"\"\"\n    71\t\n    72\t    def __init__(self, path):\n    73\t        os.makedirs(os.path.dirname(os.path.abspath(path)), exist_ok=True)\n    74\t        self.conn = sqlite3.connect(path, check_same_thread=False)\n    75\t        self.conn.executescript(SCHEMA_SQL)\n    76\t        import threading\n    77\t        self.lock = threading.Lock()\n    78\t\n    79\t    def lookup(self, sha):\n    80\t        with self.lock:\n    81\t            return self.conn.execute('select call_id, answer_json, prompt_chars, input_tokens, output_tokens from model_calls where request_sha256=?', (sha,)).fetchone()\n    82\t\n    83\t    def record(self, **fields):\n    84\t        \"\"\"One row per distinct request; a second identical request recorded at the same moment (two threads, or a\n    85\t        failed answer repeated within the same second) keeps the first row's id instead of failing.\"\"\"\n    86\t        columns = list(fields)\n    87\t        with self.lock:\n    88\t            cursor = self.conn.execute(f'insert or ignore into model_calls ({\",\".join(columns)}) values ({\",\".join(\"?\" * len(columns))})',\n    89\t                                       [fields[c] for c in columns])\n    90\t            self.conn.commit()\n    91\t            if cursor.rowcount == 0:\n    92\t                return self.conn.execute('select call_id from model_calls where request_sha256=?', (fields['request_sha256'],)).fetchone()[0]\n    93\t            return cursor.lastrowid\n    94\t\n    95\t    def retire(self, call_id):\n    96\t        \"\"\"A code check refused this answer: the row stays for the record, but no later identical request is answered with it\n    97\t        (the same shape as a schema-refused or malformed row, whose hash carries a suffix).\"\"\"\n    98\t        with self.lock:\n    99\t            self.conn.execute(\"update model_calls set request_sha256 = request_sha256 || ':refused:' || ? where call_id=? and request_sha256 not like '%:refused:%'\",\n   100\t                              (uuid.uuid4().hex[:8], call_id))\n   101\t            self.conn.commit()\n   102\t\n   103\t    def totals(self):\n   104\t        with self.lock:\n   105\t            return self.conn.execute('select count(*), coalesce(sum(cost_usd),0), coalesce(sum(input_tokens),0), coalesce(sum(output_tokens),0) from model_calls').fetchone()\n   106\t\n   107\t\n   108\tdef _key(provider):\n   109\t    name = ENDPOINTS[provider][1]\n   110\t    if os.environ.get(name):\n   111\t        return os.environ[name]\n   112\t    with open(CREDENTIALS, encoding='utf-8') as handle:\n   113\t        return json.load(handle)[name]\n   114\t\n   115\t\n   116\tdef build_request(setting, system, user, schema, schema_name, provider):\n   117\t    request = {\n   118\t        'model': setting.model,\n   119\t        'messages': [{'role': 'system', 'content': system}, {'role': 'user', 'content': user}],\n   120\t        'response_format': {'type': 'json_schema', 'json_schema': {'name': schema_name, 'strict': True, 'schema': schema}},\n   121\t    }\n   122\t    if provider == 'openai':\n   123\t        request['max_completion_tokens'] = setting.max_output_tokens\n   124\t        if setting.reasoning_effort:\n   125\t            request['reasoning_effort'] = setting.reasoning_effort\n   126\t    else:\n   127\t        request['max_tokens'] = setting.max_output_tokens\n   128\t    return request\n   129\t\n   130\t\n   250\t\n   251\tdef call(archive, cfg, setting, system, user, schema, schema_name, purpose, *, transport=None):\n   252\t    provider = cfg.provider\n   253\t    request = build_request(setting, system, user, schema, schema_name, provider)\n   254\t    request_json, sha = request_identity(request)\n   255\t    hit = archive.lookup(sha)\n   256\t    prompt_chars = len(system) + len(user)\n   257\t    if hit:\n   258\t        call_id, answer_json, _, input_tokens, output_tokens = hit\n   259\t        return Answer(json.loads(answer_json), call_id, sha, True, prompt_chars, input_tokens or 0, output_tokens or 0, 0.0)\n   260\t    started = time.time()\n   261\t    response = (transport or openai_transport)(provider, request)\n   262\t    seconds = round(time.time() - started, 1)\n   263\t    try:\n   264\t        content = response['choices'][0]['message']['content']\n   265\t        data = json.loads(content)\n   266\t    except (KeyError, IndexError, TypeError, json.JSONDecodeError) as error:\n   267\t        archive.record(purpose=purpose, config_version=cfg.version, config_checksum=cfg.checksum, model=setting.model,\n   268\t                       request_sha256=sha + ':malformed:' + uuid.uuid4().hex[:8], request_json=request_json,\n   269\t                       response_json=json.dumps(response)[:200000], answer_json=None, prompt_chars=prompt_chars,\n   270\t                       input_tokens=0, output_tokens=0, cost_usd=0.0, seconds=seconds, created_at=time.strftime('%Y-%m-%dT%H:%M:%S'))\n   271\t        raise SchemaError(f'malformed answer: {error}')\n   272\t    errors = check_schema(data, schema)\n   273\t    usage = response.get('usage') or {}\n   274\t    input_tokens = int(usage.get('prompt_tokens') or 0)\n   275\t    output_tokens = int(usage.get('completion_tokens') or 0)\n   276\t    cached_tokens = min(input_tokens, int((usage.get('prompt_tokens_details') or {}).get('cached_tokens') or 0))\n   277\t    price_in, price_out = PRICES.get(setting.model, (0.0, 0.0))\n   278\t    cost = round((input_tokens - cached_tokens) / 1e6 * price_in + cached_tokens / 1e6 * price_in * CACHED_INPUT_SHARE + output_tokens / 1e6 * price_out, 6)\n   279\t    call_id = archive.record(purpose=purpose, config_version=cfg.version, config_checksum=cfg.checksum, model=setting.model,\n   280\t                             request_sha256=sha if not errors else sha + ':schema:' + uuid.uuid4().hex[:8], request_json=request_json,\n   281\t                             response_json=json.dumps(response)[:200000], answer_json=json.dumps(data, ensure_ascii=False),\n   282\t                             prompt_chars=prompt_chars, input_tokens=input_tokens, output_tokens=output_tokens, cost_usd=cost,\n   283\t                             seconds=seconds, created_at=time.strftime('%Y-%m-%dT%H:%M:%S'))\n   284\t    if errors:\n   285\t        raise SchemaError('; '.join(errors[:5]))\n   286\t    return Answer(data, call_id, sha, False, prompt_chars, input_tokens, output_tokens, cost)\n    16\tKEY_NAME = 'TYPESAFE_API_KEY'\n    17\tRETRY_STATUSES = {429, 529}\n    18\tATTEMPTS = 3\n    19\t\n    20\t\n    21\tdef _key():\n    22\t    if os.environ.get(KEY_NAME):\n    23\t        return os.environ[KEY_NAME]\n    24\t    with open(model.CREDENTIALS, encoding='utf-8') as handle:\n    25\t        return json.load(handle)[KEY_NAME]\n    26\t\n    27\t\n    28\tdef transport(request, timeout=60):\n    29\t    \"\"\"POST the request; up to three attempts, pausing before each retry, on a rate-limit or overload status or a\n    30\t    connection that fails without a reply; any other failure is a TransportError. The body is the same sorted text the\n    31\t    archive digests, so a cache hit is byte-identical to what was sent.\"\"\"\n    32\t    body = json.dumps(request, sort_keys=True, ensure_ascii=False).encode('utf-8')\n    33\t    key = _key()\n    34\t    for attempt in range(ATTEMPTS):\n    35\t        req = urllib.request.Request(ENDPOINT, body, {'Authorization': 'Bearer ' + key, 'Content-Type': 'application/json', 'Accept': 'application/json'})\n    36\t        try:\n    37\t            with urllib.request.urlopen(req, timeout=timeout) as response:\n    38\t                raw = response.read()\n    39\t            break\n    40\t        except urllib.error.HTTPError as error:\n    41\t            if error.code not in RETRY_STATUSES or attempt == ATTEMPTS - 1:\n    42\t                raise model.TransportError(f'Jev HTTP {error.code}') from None\n    43\t        except (urllib.error.URLError, OSError, http.client.HTTPException) as error:   # a dropped or truncated reply\n    44\t            if attempt == ATTEMPTS - 1:\n    45\t                raise model.TransportError(f'Jev transport failed: {type(error).__name__}') from None\n    46\t        time.sleep(2 * (attempt + 1))\n    47\t    if key.encode('utf-8') in raw:\n    48\t        raise model.TransportError('Jev response echoed the credential; not archived')\n    49\t    return json.loads(raw.decode('utf-8'))\n    50\t\n    51\t\n    52\t# Jev reports each probability rounded to two decimals independently of the choice it made on the unrounded values, so the\n    53\t# chosen option may print one unit below another (0.47 against 0.48; 1 of 2,353 archived choice answers on 2026-10-25).\n    78\t                problems.append(f'{qid}: choice is not the most probable option')\n    79\t    return problems\n    80\t\n    81\t\n    82\tdef request_for(setting, state, questions):\n    83\t    \"\"\"The complete Jev request used both for dispatch and in-flight identity.\"\"\"\n    84\t    return {'model': setting.model, 'state': state, 'questions': questions}\n    85\t\n    86\t\n    87\tdef ask(archive, cfg, setting, state, questions, purpose, *, transport=None):\n    88\t    \"\"\"One Jev request, archived; returns model.Answer whose data is the `answers` map.\"\"\"\n    89\t    request = request_for(setting, state, questions)\n    90\t    request_json, sha = model.request_identity(request)\n    91\t    prompt_chars = len(request_json)\n    92\t    hit = archive.lookup(sha)\n    93\t    if hit:\n    94\t        call_id, answer_json, _, input_tokens, output_tokens = hit\n    95\t        return model.Answer(json.loads(answer_json), call_id, sha, True, prompt_chars, input_tokens or 0, output_tokens or 0, 0.0)\n    96\t    started = time.time()\n    97\t    response = (transport or globals()['transport'])(request)\n    98\t    seconds = round(time.time() - started, 2)\n    99\t    answers = response.get('answers') if isinstance(response, dict) else None\n   100\t    problems = validate(answers, questions)\n   101\t    usage = response.get('usage') or {} if isinstance(response, dict) else {}\n   102\t    input_tokens, output_tokens = int(usage.get('input_tokens') or 0), int(usage.get('output_tokens') or 0)\n   103\t    price_in, _ = model.PRICES.get(setting.model, (0.0, 0.0))\n   104\t    cost = round(input_tokens / 1e6 * price_in, 6)\n   105\t    call_id = archive.record(purpose=purpose, config_version=cfg.version, config_checksum=cfg.checksum, model=setting.model,\n   106\t                             request_sha256=sha if not problems else sha + ':schema:' + uuid.uuid4().hex[:8], request_json=request_json,\n   107\t                             response_json=json.dumps(response, ensure_ascii=False)[:200000], answer_json=json.dumps(answers, ensure_ascii=False) if answers is not None else None,\n   108\t                             prompt_chars=prompt_chars, input_tokens=input_tokens, output_tokens=output_tokens, cost_usd=cost,\n   109\t                             seconds=seconds, created_at=time.strftime('%Y-%m-%dT%H:%M:%S'))\n   110\t    if problems:\n   111\t        raise model.SchemaError('; '.join(problems[:5]))\n   112\t    return model.Answer(answers, call_id, sha, False, prompt_chars, input_tokens, output_tokens, cost)\n","exit_code":0,"status":"completed"}}
