ullish\\\",seq=148,kind=kind)\n    results[kind or \\\"literal parent\\\"]=replay()\n    db.execute(\\\"rollback to scenario\\\")\n    db.execute(\\\"release scenario\\\")\nprint(results)'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
