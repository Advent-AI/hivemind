{"type":"item.completed","item":{"id":"item_53","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba scripts/preflight.py | sed -n '303,390p'; rg -n 'sqlite3.connect|os\\\\.makedirs|live_lock' scripts/preflight.py\"","aggregated_output":"   303\t    judged = 0\n   304\t    for path in views_paths:\n   305\t        conn = sqlite3.connect(f'file:{path}?mode=ro', uri=True)\n   306\t        conn.row_factory = sqlite3.Row\n   307\t        tables = {r[0] for r in conn.execute(\"select name from sqlite_master where type='table'\")}\n   308\t        if 'view_keys' not in tables:\n   309\t            print(f'\\n== E. keyed views in {os.path.basename(path)}: unkeyed ledger (written before keys)')\n   310\t            continue\n   311\t        open_ids = {r[0] for r in conn.execute('select view_id from view_switches where id in (select max(id) from view_switches group by view_id) and open=1')}\n   312\t        keys = collections.defaultdict(list)\n   313\t        for r in conn.execute('select k.*, v.object_id from view_keys k join views v on v.view_id=k.view_id'):\n   314\t            if r['view_id'] in open_ids:\n   315\t                keys[(r['object_id'], r['measure'], r['scope_key'], r['period_start'], r['period_end'], r['basis'], r['unit'], r['event_type'])].append(r['view_id'])\n   316\t        keyed = sum(len(v) for v in keys.values())\n   317\t        collisions = {k: v for k, v in keys.items() if len(v) > 1}\n   318\t        pool = conn.execute(\"select count(*) from review_pool_entries where kind='candidate_outside_watch'\").fetchone()[0]\n   319\t        judged += keyed\n   320\t        print(f'\\n== E. keyed views in {os.path.basename(path)}: open views {len(open_ids)}, keyed {keyed}, duplicate keys {len(collisions)} groups, review pool {pool} candidates outside the watch list')\n   321\t        for k, v in list(collisions.items())[:10]:\n   322\t            print(f'      {k[:3]} {k[3]}..{k[4]} → {v}')\n   323\t    return judged\n   324\t\n   325\t\n   326\tdef main():\n   327\t    parser = argparse.ArgumentParser()\n   328\t    frozen_draw = os.path.join(ROOT, 'poc', 'data', 'e2e-r9-frozen-v108-2026-11-03', 'd1')\n   329\t    parser.add_argument('--archive', default=os.path.join(frozen_draw, 'archive.sqlite'))\n   330\t    parser.add_argument('--items', default=os.path.join(ROOT, 'poc', 'data', 'items-nvda-2026-07-01-10-27.sqlite'))\n   331\t    parser.add_argument('--views', nargs='*', default=None)\n   332\t    parser.add_argument('--universe', default=os.path.join(ROOT, 'poc', 'universe.json'))\n   333\t    args = parser.parse_args()\n   334\t    views_paths = args.views or [os.path.join(frozen_draw, 'views.sqlite')]\n   335\t    archive_conn = sqlite3.connect(f'file:{args.archive}?mode=ro', uri=True)\n   336\t    archive_conn.row_factory = sqlite3.Row\n   337\t    items_conn = testdb.open_db(args.items)\n   338\t    uni = universe.load(args.universe)\n   339\t    print('preflight over', args.archive, 'and', len(views_paths), 'views databases:', ', '.join(os.path.basename(os.path.dirname(p)) for p in views_paths))\n   340\t    part_a(archive_conn)\n   341\t    copies = store_copies(views_paths)\n   342\t    counts = [part_b(archive_conn, items_conn, uni), part_c(archive_conn, copies, uni), part_d()]\n   343\t    part_e(copies)          # informational for unkeyed ledgers; judged counts are reported per ledger\n   344\t    if min(counts) == 0:\n   345\t        print('\\nUNEXERCISED: a check judged no case')\n   346\t        sys.exit(1)\n   347\t    print('\\npreflight done')\n   348\t\n   349\t\n   350\tif __name__ == '__main__':\n   351\t    main()\n32:from hivemind import config, extraction, live_lock, model, testdb, universe, vocabulary  # noqa: E402\n187:    held = live_lock.acquire(path)\n189:        source = sqlite3.connect(f'file:{held.real_path}?mode=ro', uri=True)\n191:            live_lock.verify(held)\n192:            target = sqlite3.connect(scratch)\n195:                live_lock.leave_wal_mode(target)\n200:        live_lock.verify(held)\n207:        live_lock.release(held)\n229:        conn = sqlite3.connect(scratch)\n305:        conn = sqlite3.connect(f'file:{path}?mode=ro', uri=True)\n335:    archive_conn = sqlite3.connect(f'file:{args.archive}?mode=ro', uri=True)\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_54","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"PYTHONDONTWRITEBYTECODE=1 PYTHONPATH=src python3 -c 'import importlib.util\nimport json\nimport sqlite3\nfrom pathlib import Path\nfrom hivemind import config, model\np=Path(\\\"docs/research/2026-11-20-production-readiness/dependency-design/july_test.py\\\")\nspec=importlib.util.spec_from_file_location(\\\"july_review\\\",p)\nh=importlib.util.module_from_spec(spec)\nspec.loader.exec_module(h)\ncfg=config.load(str(h.V118))\nuri=(h.OLD2/\\\"archive.sqlite\\\").as_uri()\nsource=sqlite3.connect(f\\\"{uri}?mode=ro&immutable=1\\\",uri=True)\nsource.row_factory=sqlite3.Row\narchive=model.Archive(\\\":memory:\\\")\nsample={}\ntarget_ids=[]\nfor row in source.execute(\\\"select * from model_calls where purpose=\\\\x27judge\\\\x27 order by call_id\\\"):\n    request=json.loads(row[\\\"request_json\\\"])\n    view=h.judged_view(request)\n    if view in h.TARGETS:\n        target_ids.append(row[\\\"call_id\\\"])\n    if view not in (\\\"v9\\\",\\\"v14\\\",\\\"v8\\\") or view in sample:\n        if view not in h.TARGETS:\n            continue\n    sample.setdefault(view,(request,row[\\\"call_id\\\"],row[\\\"request_sha256\\\"]))\n    archive.record(**dict(row))\ndef lookup(target, transport):\n    request,cid,digest=sample[target]\n    response=model.call(archive,cfg,cfg.rejudging,request[\\\"messages\\\"][0][\\\"content\\\"],request[\\\"messages\\\"][1][\\\"content\\\"],request[\\\"response_format\\\"][\\\"json_schema\\\"][\\\"schema\\\"],\\\"judgement\\\",\\\"judge\\\",transport=transport)\n    return response.cached,response.call_id==cid,response.request_sha256==digest,response.call_id\ndef refuse(*a):\n    raise AssertionError(\\\"unexpected transport\\\")\nbefore={t:lookup(t,refuse)[:3] for t in (\\\"v9\\\",\\\"v14\\\",\\\"v8\\\")}\nfor cid in target_ids:\n    archive.retire(cid)\ntransport=h.fake_judge(\\\"ARCHIVE-PROOF\\\",{})\nafter={t:lookup(t,transport) for t in (\\\"v9\\\",\\\"v14\\\",\\\"v8\\\")}\narchive.retire(after[\\\"v9\\\"][3])\nagain=lookup(\\\"v9\\\",transport)\nprint(\\\"target rows:\\\",len(target_ids),\\\"before (cached, original call id, exact digest):\\\",before)\nprint(\\\"after (cached, original call id, exact digest, call id):\\\",after,\\\"v9 after second retirement:\\\",again)'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
