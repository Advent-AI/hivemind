{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba src/hivemind/views/links.py\nrg -n 'link|harness_only' src/hivemind/views/{round,writing,judging,store}.py scripts/replay.py clean-arch/e2e-comparison-2026-11-13/budget_replay.py src/hivemind/research_context.py\nrg -n '\"'^def test|''^class Test'\"' tests/test_links.py\"","aggregated_output":"     1\t\"\"\"Links between number questions, chosen in the matching step (D51, D368 item 2, D694, D695; the design and its four tables:\n     2\tdocs/research/2026-11-20-production-readiness/dependency-design/DESIGN.md).\n     3\t\n     4\tUnder the matching engine `jev-links` only, after matching has settled which candidates open: for each newly opened number question\n     5\tC and each open number question T on C's list, Jev is asked whether one should be judged with the other's conclusion in view (READS)\n     6\tand, for a pair that should, which way the read question moves the reading one (SIGN). Code decides only identity: which pairs are\n     7\tnumber questions, the canonical candidate, circles, and the label the judge is shown (from the sign and the typed rung bounds). A\n     8\tlink is written with kind `reads`: judging reads it as a dependency; filing does not treat it as a narrower home (D694 (a)).\n     9\t\"\"\"\n    10\timport json\n    11\t\n    12\tfrom .. import jev, model, vocabulary\n    13\tfrom . import identity, jev_matching, store\n    14\t\n    15\tENGINE = 'jev-links'\n    16\tKIND = 'reads'\n    17\tTHRESHOLD = jev_matching.THRESHOLD\n    18\tLABELS = vocabulary.ASSET_LABELS                 # five-rung asset ladders run Strongly bullish .. Strongly bearish, or the reverse\n    19\tCANDIDATE_READS, THESIS_READS, NEITHER = 'candidate_reads_thesis', 'thesis_reads_candidate', 'neither'\n    20\tTOGETHER, OPPOSITE, NO_SIGN = 'together', 'opposite', 'no_clear_sign'\n    21\t\n    22\tREADS = {\n    23\t    CANDIDATE_READS: \"the CANDIDATE should be judged with the THESIS's current conclusion in view, because the THESIS's answer bounds \"\n    24\t                     \"or drives the CANDIDATE's: a part read against its whole (one product line's sales against the company's total \"\n    25\t                     \"sales; one region's loan book against the bank's total loans), or a quantity read against another it depends on \"\n    26\t                     \"(a component supplier's revenue against its largest customer's capital spending; an airline's fuel bill against \"\n    27\t                     \"its fuel volume)\",\n    28\t    THESIS_READS: \"the THESIS should be judged with the CANDIDATE's current conclusion in view, for the same reasons with the roles swapped\",\n    29\t    NEITHER: \"neither answer bounds or drives the other: unrelated quantities (a retailer's gross margin and its store openings in \"\n    30\t             \"another country), or the same quantity for the same period and scope; sharing a company, industry or topic is not enough\",\n    31\t}\n    32\tSIGN = {\n    33\t    TOGETHER: \"a higher answer to the question read makes a higher answer to the question reading it more likely (a company's total \"\n    34\t              \"sales and one product line's sales, when that line's share of the total holds steady; a customer's capital spending \"\n    35\t              \"and its component supplier's revenue)\",\n    36\t    OPPOSITE: \"a higher answer to the question read makes a lower answer to the question reading it more likely (an airline's fuel \"\n    37\t              \"bill and its operating margin; a retailer's markdowns and its gross margin)\",\n    38\t    NO_SIGN: \"the question read only caps the other without moving its most likely answer (a regulator's cap on a bank's fees set far \"\n    39\t             \"above what it charges), or the supplied text does not show which way it moves it\",\n    40\t}\n    41\tREADS_INSTRUCTIONS = (\"Should one of these two questions be judged with the other's current conclusion in view? Use only the supplied \"\n    42\t                      \"text. THESIS:\\n\")\n    43\tSIGN_INSTRUCTIONS = {\n    44\t    CANDIDATE_READS: \"If the THESIS's answer turned out higher, which way would that move the CANDIDATE's most likely answer? Use only the supplied text. THESIS:\\n\",\n    45\t    THESIS_READS: \"If the CANDIDATE's answer turned out higher, which way would that move the THESIS's most likely answer? Use only the supplied text. THESIS:\\n\",\n    46\t}\n    47\t\n    48\t\n    49\tclass Refused(RuntimeError):\n    50\t    \"\"\"The link step cannot finish for this article (a persistent circle, an unbound waiting row, a Jev failure); `record` says why.\"\"\"\n    51\t\n    52\t    def __init__(self, message, record):\n    53\t        super().__init__(message)\n    54\t        self.record = record\n    55\t\n    56\t\n    57\tdef reads_question(text, excluded=None, note=''):\n    58\t    criteria = {k: v for k, v in READS.items() if k != excluded}\n    59\t    return {'type': 'choice', 'criteria': criteria, 'instructions': READS_INSTRUCTIONS.replace('THESIS:\\n', (note + ' ' if note else '') + 'THESIS:\\n') + text}\n    60\t\n    61\t\n    62\tdef sign_question(text, direction):\n    63\t    return {'type': 'choice', 'criteria': dict(SIGN), 'instructions': SIGN_INSTRUCTIONS[direction] + text}\n    64\t\n    65\t\n    66\t# ---------- identity: which ladders are number ladders, and the label ----------\n    67\t\n    68\tdef typed_direction(rungs):\n    69\t    \"\"\"-1 when the values fall from the first rung to the last, +1 when they rise, None otherwise. Each rung is [lo, hi) of its typed\n    70\t    bounds; only the first and last rung may leave one outer end open; an interval with lo >= hi is invalid; adjacent rungs may\n    71\t    touch. Prose is never read.\"\"\"\n    72\t    if len(rungs) < 2:\n    73\t        return None\n    74\t    intervals = []\n    75\t    for index, rung in enumerate(rungs):\n    76\t        lo, hi = rung.get('lo'), rung.get('hi')\n    77\t        outer = index in (0, len(rungs) - 1)\n    78\t        if (lo is None and hi is None) or ((lo is None or hi is None) and not outer):\n    79\t            return None\n    80\t        if lo is not None and hi is not None and float(lo) >= float(hi):\n    81\t            return None\n    82\t        intervals.append((None if lo is None else float(lo), None if hi is None else float(hi)))\n    83\t\n    84\t    def at_or_below(lower, upper):\n    85\t        return lower[1] is not None and upper[0] is not None and lower[1] <= upper[0]\n    86\t\n    87\t    pairs = list(zip(intervals, intervals[1:]))\n    88\t    if all(at_or_below(after, before) for before, after in pairs):\n    89\t        return -1\n    90\t    if all(at_or_below(before, after) for before, after in pairs):\n    91\t        return 1\n    92\t    return None\n    93\t\n    94\t\n    95\tdef favourable_end(rungs):\n    96\t    \"\"\"'first' or 'last': the end whose stored label is Strongly bullish, on a five-rung ladder carrying the canonical labels in order\n    97\t    or reversed; None otherwise.\"\"\"\n    98\t    labels = [vocabulary.canonical('label', r['label']) for r in rungs]\n    99\t    if labels == LABELS:\n   100\t        return 'first'\n   101\t    if labels == LABELS[::-1]:\n   102\t        return 'last'\n   103\t    return None\n   104\t\n   105\t\n   106\tdef label_for(reader_rungs, read_rungs, sign):\n   107\t    \"\"\"The existing direction label (`first_is_bullish` / `last_is_bullish`): which end of the read question's ladder is favourable for\n   108\t    the reading asset question, given the sign; None when undecidable.\"\"\"\n   109\t    reader_direction, read_direction, favourable = typed_direction(reader_rungs), typed_direction(read_rungs), favourable_end(reader_rungs)\n   110\t    if None in (reader_direction, read_direction, favourable) or sign not in (TOGETHER, OPPOSITE):\n   111\t        return None\n   112\t    reader_high = 'first' if reader_direction == -1 else 'last'\n   113\t    favourable_is_high = favourable == reader_high\n   114\t    want_read_high = favourable_is_high if sign == TOGETHER else not favourable_is_high\n   115\t    read_high = 'first' if read_direction == -1 else 'last'\n   116\t    end = read_high if want_read_high else ('last' if read_high == 'first' else 'first')\n   117\t    return 'first_is_bullish' if end == 'first' else 'last_is_bullish'\n   118\t\n   119\t\n   120\tdef is_number_question(kind, rungs, measure):\n   121\t    \"\"\"D695: an asset question with a five-rung number ladder (canonical labels, typed direction) and a measure that is not an event.\"\"\"\n   122\t    return (kind == 'asset' and len(rungs) == 5 and bool(measure) and measure not in identity.EVENT_MEASURES\n   123\t            and typed_direction(rungs) is not None and favourable_end(rungs) is not None)\n   124\t\n   125\t\n   126\tdef stored_is_number_question(conn, view_id):\n   127\t    v, key = store.view(conn, view_id), store.view_key(conn, view_id)\n   128\t    return bool(v) and is_number_question(v['kind'], store.rungs_of(conn, view_id), (key or {}).get('measure'))\n   129\t\n   130\t\n   131\tdef candidate_rungs(conn, c, outcome, target):\n   132\t    \"\"\"The candidate's rungs as the writer will store them (a successor is oriented like its predecessor).\"\"\"\n   133\t    if outcome == 'succession' and target:\n   134\t        from .writing import oriented_like\n   135\t        return oriented_like(c, store.rungs_of(conn, target), [])['rungs']\n   136\t    return c['rungs']\n   137\t\n   138\t\n   139\t# ---------- the reading graph ----------\n   140\t\n   141\tdef stored_edges(conn):\n   142\t    \"\"\"Every stored dependency at its effective target (a bound wait counts through the question it is bound to).\"\"\"\n   143\t    edges = {}\n   144\t    for (view_id,) in conn.execute('select distinct view_id from dependencies'):\n   145\t        for dep in store.dependencies_of(conn, view_id):\n   146\t            if dep['resolved_to']:\n   147\t                edges.setdefault(view_id, set()).add(dep['resolved_to'])\n   148\t    return edges\n   149\t\n   150\t\n   151\tdef unbound_waits(conn):\n   152\t    return conn.execute(\"select count(*) from dependencies where coalesce(depends_on, '')='' and coalesce(wait_year, '')!='' \"\n   153\t                        \"and dependency_id not in (select dependency_id from dependency_resolutions)\").fetchone()[0]\n   154\t\n   155\t\n   156\tdef circles(conn, proposed):\n   157\t    \"\"\"The proposed links (reader, read) that lie on a circle of the stored relation plus every proposed link, each with one path.\"\"\"\n   158\t    graph = {k: set(v) for k, v in stored_edges(conn).items()}\n   159\t    for link in proposed:\n   160\t        graph.setdefault(link['reader'], set()).add(link['read'])\n   161\t    found = []\n   162\t    for link in proposed:\n   163\t        stack, seen = [(link['read'], [link['reader'], link['read']])], set()\n   164\t        while stack:\n   165\t            node, path = stack.pop()\n   166\t            if node == link['reader']:\n   167\t                found.append((link, path))\n   168\t                break\n   169\t            if node in seen:\n   170\t                continue\n   171\t            seen.add(node)\n   172\t            stack.extend((nxt, path + [nxt]) for nxt in sorted(graph.get(node, ())))\n   173\t    return found\n   174\t\n   175\t\n   176\t# ---------- selection ----------\n   177\t\n   178\tdef _ask(archive, cfg, jobs, transport, record, stage):\n   179\t    \"\"\"One Jev request per job; every request's sha is written into the record before it is sent, and what the archive already held.\"\"\"\n   180\t    entries = []\n   181\t    for state, questions in jobs:\n   182\t        _, sha = model.request_identity(jev.request_for(cfg.matching, state, questions))\n   183\t        entries.append({'stage': stage, 'request_sha256': sha, 'questions': sorted(questions), 'archived_before': bool(archive.lookup(sha))})\n   184\t    record['calls'].extend(entries)\n   185\t    try:\n   186\t        replies = jev_matching._answers(archive, cfg, jobs, 1, transport)\n   187\t    except Exception as error:\n   188\t        record['error'] = f'{type(error).__name__}: {error}'[:300]\n   189\t        raise Refused(f'link question failed: {record[\"error\"]}', record) from error\n   190\t    for entry, reply in zip(entries, replies):\n   191\t        entry['call_id'] = reply.call_id\n   192\t    return [reply.data for reply in replies]\n   193\t\n   194\t\n   195\tdef _passes(answer, accepted):\n   196\t    choice = answer['choice']\n   197\t    return choice if choice in accepted and answer['probabilities'][choice] >= THRESHOLD else None\n   198\t\n   199\t\n   200\tdef choose(archive, cfg, conn, handover, checked, lists, shown_views, *, transport=None):\n   201\t    \"\"\"The links this article proposes: [{'reader', 'read', 'candidate', 'direction', 'sign'}], reader and read being a candidate id\n   202\t    (canonical) or a stored view id; and the record of how they were chosen. Raises Refused for an unbound waiting row, a Jev\n   203\t    failure or a circle that remains after one correction (PRD 06).\"\"\"\n   204\t    record = {'pairs': [], 'calls': [], 'corrections': [], 'proposed': []}\n   205\t    if unbound_waits(conn):\n   206\t        record['error'] = 'the store holds an unbound waiting dependency row'\n   207\t        raise Refused(record['error'], record)\n   208\t    aliases, problems = identity.batch_plan(handover.candidates, checked.outcomes)\n   209\t    if problems:                                   # the writer refuses the same plan (WriteConflict); nothing to ask\n   210\t        record['skipped'] = problems\n   211\t        return [], record\n   212\t    evidence = handover.evidence\n   213\t    stage1, asked = [], []\n   214\t    for c in handover.candidates:\n   215\t        outcome, target, _ = checked.outcomes.get(c['id'], ('skip', None, []))\n   216\t        if outcome not in ('new', 'succession') or aliases.get(c['id']) != c['id']:\n   217\t            continue\n   218\t        rungs = candidate_rungs(conn, c, outcome, target)\n   219\t        if not is_number_question(c['kind'], rungs, c.get('measure')):\n   220\t            record['pairs'].append({'candidate': c['id'], 'eligible': False, 'why': 'not a number question'})\n   221\t            continue\n   222\t        listed = list(dict.fromkeys(list(lists.candidate_lists.get(c['id'], [])) + [v['view_id'] for v in shown_views]))\n   223\t        theses = []\n   224\t        for view_id in listed:\n   225\t            ok = store.is_open(conn, view_id) and stored_is_number_question(conn, view_id)\n   226\t            record['pairs'].append({'candidate': c['id'], 'thesis': view_id, 'eligible': ok})\n   227\t            if ok:\n   228\t                theses.append(view_id)\n   229\t        if theses:\n   230\t            state = jev_matching.candidate_state(c, evidence)\n   231\t            stage1.append((state, {f'reads__{v}': reads_question(jev_matching.thesis_text(conn, v)) for v in theses}))\n   232\t            asked.append((c, state, theses))\n   233\t    if not stage1:\n   234\t        return [], record\n   235\t    answers = _ask(archive, cfg, stage1, transport, record, 'reads')\n   236\t    directions = {}\n   237\t    for (c, state, theses), reply in zip(asked, answers):\n   238\t        for view_id in theses:\n   239\t            answer = reply[f'reads__{view_id}']\n   240\t            direction = _passes(answer, (CANDIDATE_READS, THESIS_READS))\n   241\t            record['pairs'].append({'candidate': c['id'], 'thesis': view_id, 'reads': answer['choice'], 'probabilities': answer['probabilities']})\n   242\t            if direction:\n   243\t                directions[(c['id'], view_id)] = direction\n   244\t    links = _signed(archive, cfg, conn, asked, directions, transport, record)\n   245\t    on_circle = circles(conn, links)\n   246\t    if on_circle:\n   247\t        links = _corrected(archive, cfg, conn, asked, directions, links, on_circle, transport, record)\n   248\t        remaining = circles(conn, links)\n   249\t        if remaining:\n   250\t            record['error'] = 'persistent cycle: ' + '; '.join(' -> '.join(path) for _, path in remaining)\n   251\t            raise Refused(record['error'], record)\n   252\t    record['proposed'] = links\n   253\t    return links, record\n   254\t\n   255\t\n   256\tdef _signed(archive, cfg, conn, asked, directions, transport, record, stage='sign'):\n   257\t    jobs, owners = [], []\n   258\t    for c, state, theses in asked:\n   259\t        questions = {f'sign__{v}': sign_question(jev_matching.thesis_text(conn, v), directions[(c['id'], v)]) for v in theses if (c['id'], v) in directions}\n   260\t        if questions:\n   261\t            jobs.append((state, questions))\n   262\t            owners.append(c)\n   263\t    links = []\n   264\t    if not jobs:\n   265\t        return links\n   266\t    for c, reply in zip(owners, _ask(archive, cfg, jobs, transport, record, stage)):\n   267\t        for qid, answer in sorted(reply.items()):\n   268\t            view_id = qid[len('sign__'):]\n   269\t            sign = _passes(answer, (TOGETHER, OPPOSITE))\n   270\t            record['pairs'].append({'candidate': c['id'], 'thesis': view_id, 'sign': answer['choice'], 'probabilities': answer['probabilities']})\n   271\t            if sign:\n   272\t                direction = directions[(c['id'], view_id)]\n   273\t                reader, read = (c['id'], view_id) if direction == CANDIDATE_READS else (view_id, c['id'])\n   274\t                links.append({'reader': reader, 'read': read, 'candidate': c['id'], 'thesis': view_id, 'direction': direction, 'sign': sign})\n   275\t    return links\n   276\t\n   277\t\n   278\tdef _corrected(archive, cfg, conn, asked, directions, links, on_circle, transport, record):\n   279\t    \"\"\"PRD 06: refuse a circle and ask the model to correct it, once: the pair's READS question again, the offending direction removed\n   280\t    and the circle named; the answer replaces the original.\"\"\"\n   281\t    offending = {(link['candidate'], link['thesis']): path for link, path in on_circle}\n   282\t    jobs, owners = [], []\n   283\t    for c, state, theses in asked:\n   284\t        questions = {}\n   285\t        for view_id in theses:\n   286\t            path = offending.get((c['id'], view_id))\n   287\t            if path is None:\n   288\t                continue\n   289\t            excluded = directions[(c['id'], view_id)]\n   290\t            named = [('the CANDIDATE' if node == c['id'] else 'the THESIS' if node == view_id else node) for node in path]\n   291\t            note = f'Reading this way would make {named[0]} read itself through {\" -> \".join(named)}; a question cannot read its own conclusion.'\n   292\t            questions[f'reads__{view_id}'] = reads_question(jev_matching.thesis_text(conn, view_id), excluded=excluded, note=note)\n   293\t            record['corrections'].append({'candidate': c['id'], 'thesis': view_id, 'rejected': excluded, 'path': path})\n   294\t        if questions:\n   295\t            jobs.append((state, questions))\n   296\t            owners.append(c)\n   297\t    kept = [link for link in links if (link['candidate'], link['thesis']) not in offending]\n   298\t    corrected = {}\n   299\t    for c, reply in zip(owners, _ask(archive, cfg, jobs, transport, record, 'correction')):\n   300\t        for qid, answer in reply.items():\n   301\t            view_id = qid[len('reads__'):]\n   302\t            directions.pop((c['id'], view_id), None)\n   303\t            direction = _passes(answer, (CANDIDATE_READS, THESIS_READS))\n   304\t            record['corrections'].append({'candidate': c['id'], 'thesis': view_id, 'answer': answer['choice'], 'probabilities': answer['probabilities']})\n   305\t            if direction:\n   306\t                corrected[(c['id'], view_id)] = direction\n   307\t    if corrected:\n   308\t        directions.update(corrected)\n   309\t        regrouped = [(c, state, [v for v in theses if (c['id'], v) in corrected]) for c, state, theses in asked]\n   310\t        kept += _signed(archive, cfg, conn, [g for g in regrouped if g[2]], corrected, transport, record, stage='correction sign')\n   311\t    return kept\n   312\t\n   313\t\n   314\t# ---------- the record ----------\n   315\t\n   316\tdef attempt_id(conn, item):\n   317\t    count = conn.execute('select count(distinct attempt_id) from link_selections where input_id=?', (item['input_id'],)).fetchone()[0]\n   318\t    return f'{item[\"input_id\"]}#{count + 1}'\n   319\t\n   320\t\n   321\tdef record(conn, attempt, seq, item, cfg, status, content):\n   322\t    store.insert(conn, 'link_selections', attempt_id=attempt, seq=seq, input_id=item['input_id'], config_checksum=cfg.checksum,\n   323\t                 status=status, record_json=json.dumps(content, ensure_ascii=False, sort_keys=True))\nscripts/replay.py:9:normal replay reads), config poc/config/poc-v118.json: the frozen v108 extraction, matching and judging settings without pre-seeded questions or their coverage-start reading; the one-decider architecture, D264: the request shows the day's open questions with their takes lines and the extraction files each statement by its links, no placement call, a statement linked to nothing dropped as no home; Jev matching with the\nscripts/replay.py:52:    \"\"\"A ledger marked harness-only (a `harness_only` table, D694's July test) is written by its harness alone; read-only inspection stays\nscripts/replay.py:59:            marked = conn.execute(\"select count(*) from sqlite_master where type='table' and name='harness_only'\").fetchone()[0]\nscripts/replay.py:66:def refuse_links_engine(cfg):\nscripts/replay.py:68:    if cfg.matching.engine == 'jev-links':\nscripts/replay.py:69:        raise SystemExit(f'config {cfg.version}: matching engine jev-links is not a product entry point in this version (D694)')\nscripts/replay.py:101:    refuse_links_engine(cfg)\nsrc/hivemind/views/store.py:1:\"\"\"The views database (docs/prd/06-views.md): append-only tables for views, rungs, judgements, evidence, links,\nsrc/hivemind/views/store.py:21:    'evidence_links': 'id integer primary key autoincrement, evidence_id text, view_id text, seq integer',\nsrc/hivemind/views/store.py:25:    'dependencies': 'dependency_id integer primary key autoincrement, view_id text, depends_on text, wait_chain_view_id text, wait_year text, direction text, seq integer, kind text default \\'\\'',   # kind: '' (a seed's or the generative matcher's row, read as before) or 'reads' (a chosen reading link, D694)\nsrc/hivemind/views/store.py:34:    # D694: how the links of an article were chosen (views/links.py), append-only per attempt: proposed, then committed or failed\nsrc/hivemind/views/store.py:35:    'link_selections': 'id integer primary key autoincrement, attempt_id text, seq integer, input_id text, config_checksum text, status text, record_json text',\nsrc/hivemind/views/store.py:48:    'create index if not exists links_view on evidence_links(view_id)',\nsrc/hivemind/views/store.py:49:    'create index if not exists links_evidence on evidence_links(evidence_id)',\nsrc/hivemind/views/store.py:224:    \"\"\"The views database for a reader (the agent layer, reports): no schema creation, no writes. Opened by its own path: a symlink\nsrc/hivemind/views/store.py:225:    resolved, a store with another hard link refused (`live_lock.LockRefused`; live-service/OPERATING-CONTRACT.md, row 7), since\nsrc/hivemind/views/store.py:258:    The filing reads it to keep a statement under the narrower of two linked questions (D207's narrowest rule, extraction.file_reading).\"\"\"\nsrc/hivemind/views/store.py:313:    (A, extraction v19): a company item's statement about a theme matter links to the theme thesis instead of being dropped.\"\"\"\nsrc/hivemind/views/store.py:364:def link(conn, evidence_id, view_id, seq):\nsrc/hivemind/views/store.py:365:    exists = conn.execute('select 1 from evidence_links where evidence_id=? and view_id=?', (evidence_id, view_id)).fetchone()\nsrc/hivemind/views/store.py:367:        insert(conn, 'evidence_links', evidence_id=evidence_id, view_id=view_id, seq=seq)\nsrc/hivemind/views/store.py:428:    \"\"\"Evidence linked to the view and not replaced (history), each with its replaced predecessor when there is one and, since D202,\nsrc/hivemind/views/store.py:431:    for row in conn.execute('select evidence_id from evidence_links where view_id=? order by id', (view_id,)):\nsrc/hivemind/views/store.py:445:def views_linked_to(conn, evidence_id):\nsrc/hivemind/views/store.py:446:    return [r['view_id'] for r in conn.execute('select view_id from evidence_links where evidence_id=? order by id', (evidence_id,))]\nsrc/hivemind/views/store.py:450:    return [r['evidence_id'] for r in conn.execute('select evidence_id from evidence_links where view_id=?', (view_id,))]\nsrc/hivemind/views/store.py:482:    row = conn.execute('select s.publication_day, s.input_id from evidence_links l join evidence_sources s on s.evidence_id=l.evidence_id where l.view_id=? order by s.id desc limit 1', (view_id,)).fetchone()\nclean-arch/e2e-comparison-2026-11-13/budget_replay.py:356:    scripts_replay.refuse_links_engine(cfg)                   # the same refusals scripts/replay.py makes\nsrc/hivemind/views/round.py:10:from . import jev_matching, judging, links, matching, store, writing\nsrc/hivemind/views/round.py:39:    engine = jev_matching if cfg.matching.engine in ('jev', links.ENGINE) else matching      # Jev answers once; a retry would be the same answer\nsrc/hivemind/views/round.py:66:    record dated that day (D364: the questions it linked starting figures to are judged in the first day's round).\"\"\"\nsrc/hivemind/views/round.py:128:    # first matching call: the candidates and the evidence linked straight to existing views\nsrc/hivemind/views/round.py:133:    # second call: evidence linked to candidates that attached to an existing view, compared under that view\nsrc/hivemind/views/round.py:137:        for link in e['links']:\nsrc/hivemind/views/round.py:138:            outcome = checked.outcomes.get(link)\nsrc/hivemind/views/round.py:146:                evidence2.append(dict(e, links=[v for x, v in pending if x['id'] == e['id']]))\nsrc/hivemind/views/round.py:153:    # D694, D695: under the engine jev-links, the reading links between a newly opened number question and the number questions it was\nsrc/hivemind/views/round.py:154:    # shown, chosen once matching has settled what opens (views/links.py); recorded per attempt whatever happens next\nsrc/hivemind/views/round.py:156:    if cfg.matching.engine == links.ENGINE:\nsrc/hivemind/views/round.py:157:        attempt = links.attempt_id(conn, item)\nsrc/hivemind/views/round.py:159:            proposed, chosen = links.choose(archive, cfg, conn, handover, checked, lists, shown, transport=transport)\nsrc/hivemind/views/round.py:160:        except links.Refused as error:\nsrc/hivemind/views/round.py:161:            links.record(conn, attempt, seq, item, cfg, 'failed', error.record)\nsrc/hivemind/views/round.py:162:            return _fail(conn, item, seq, result, 'matched', 'linking_refused', 'linking: ' + str(error), 'linking')\nsrc/hivemind/views/round.py:163:        links.record(conn, attempt, seq, item, cfg, 'proposed', chosen)\nsrc/hivemind/views/round.py:167:        written = writing.write(conn, universe, seq, item, handover, checked, second_pass, proposed_links=proposed)\nsrc/hivemind/views/round.py:170:            links.record(conn, attempt, seq, item, cfg, 'failed', {'error': repr(error)[:300]})\nsrc/hivemind/views/round.py:173:        links.record(conn, attempt, seq, item, cfg, 'committed', {'links': written.links})\nsrc/hivemind/views/writing.py:3:was said (a later-arriving older statement is logged, not linked); a revised piece still linked elsewhere links the new piece there too; new views come with rungs, dependencies and\nsrc/hivemind/views/writing.py:20:    links: list = dataclasses.field(default_factory=list)      # D694: the reading links committed, with their final labels\nsrc/hivemind/views/writing.py:113:def write(conn, universe, seq, item, handover, checked, second_pass, *, proposed_links=None):\nsrc/hivemind/views/writing.py:114:    \"\"\"Write atomically within the caller's transaction; the caller commits the completion marker with it. proposed_links: the reading\nsrc/hivemind/views/writing.py:115:    links the link step chose (views/links.py, D694), written after the new views exist; None writes none.\"\"\"\nsrc/hivemind/views/writing.py:122:        if proposed_links:\nsrc/hivemind/views/writing.py:123:            result.links = _write_links(conn, seq, proposed_links, result)\nsrc/hivemind/views/writing.py:132:def _write_links(conn, seq, proposed_links, written):\nsrc/hivemind/views/writing.py:133:    \"\"\"D694, D695 (design §4): each proposed link resolved to stored ids, re-checked against the ledger as it stands inside this write\nsrc/hivemind/views/writing.py:135:    question that gains a link is judged in the day's round. Any mismatch refuses the whole write.\"\"\"\nsrc/hivemind/views/writing.py:136:    from . import links as _links\nsrc/hivemind/views/writing.py:138:    for link in proposed_links:\nsrc/hivemind/views/writing.py:139:        reader, read = (written.new_views.get(link[end], link[end]) for end in ('reader', 'read'))\nsrc/hivemind/views/writing.py:142:                raise WriteConflict(f'link {link[\"reader\"]} -> {link[\"read\"]}: {end} was not opened')\nsrc/hivemind/views/writing.py:144:                raise WriteConflict(f'link {reader} -> {read}: {end} is closed')\nsrc/hivemind/views/writing.py:145:        label = _links.label_for(store.rungs_of(conn, reader), store.rungs_of(conn, read), link['sign'])\nsrc/hivemind/views/writing.py:147:            raise WriteConflict(f'link {reader} -> {read}: no label can be computed from the stored rungs')\nsrc/hivemind/views/writing.py:150:            raise WriteConflict(f'link {reader} -> {read}: the pair already carries another label {sorted(existing)}')\nsrc/hivemind/views/writing.py:154:            raise WriteConflict(f'link {reader} -> {read}: would close a circle')\nsrc/hivemind/views/writing.py:155:        store.insert(conn, 'dependencies', view_id=reader, depends_on=read, wait_chain_view_id='', wait_year='', direction=label, seq=seq, kind=_links.KIND)\nsrc/hivemind/views/writing.py:158:        committed.append({'reader': reader, 'read': read, 'label': label, 'sign': link['sign'], 'direction': link['direction']})\nsrc/hivemind/views/writing.py:163:    \"\"\"second_pass: {(handover evidence id, view_id): (outcome, target_evidence_id, said_day)} for candidate-linked\nsrc/hivemind/views/writing.py:243:        for link in e['links']:\nsrc/hivemind/views/writing.py:244:            if link in new_views:\nsrc/hivemind/views/writing.py:245:                targets.append((new_views[link], ('new', None, '')))\nsrc/hivemind/views/writing.py:246:            elif link in checked.outcomes and checked.outcomes[link][0] == 'merge':\nsrc/hivemind/views/writing.py:247:                targets.append((checked.outcomes[link][1], second_pass.get((e['id'], checked.outcomes[link][1]), ('new', None, ''))))\nsrc/hivemind/views/writing.py:248:            elif link in checked.outcomes:\nsrc/hivemind/views/writing.py:250:            elif (e['id'], link) in checked.evidence:\nsrc/hivemind/views/writing.py:251:                targets.append((link, checked.evidence[(e['id'], link)]))\nsrc/hivemind/views/writing.py:252:            elif (e['id'], link) in second_pass:\nsrc/hivemind/views/writing.py:253:                targets.append((link, second_pass[(e['id'], link)]))\nsrc/hivemind/views/writing.py:259:            notes.append(f'evidence {e[\"id\"]} linked to nothing kept; not stored')\nsrc/hivemind/views/writing.py:263:        # destination records a revision there and links everywhere, a late older statement is logged and stored as new (D202)\nsrc/hivemind/views/writing.py:267:            # D204: the piece is stored as its own record with its own links; the matcher's \"same claim\" is a relation, not a merge\nsrc/hivemind/views/writing.py:271:                store.link(conn, stored_id, view_id, seq)\nsrc/hivemind/views/writing.py:280:                # D202: an older statement arriving late is one more piece in force (before, it was logged and linked nowhere)\nsrc/hivemind/views/writing.py:293:                for linked in store.views_linked_to(conn, target_id):\nsrc/hivemind/views/writing.py:294:                    if store.link(conn, stored_id, linked, seq) and store.is_open(conn, linked):\nsrc/hivemind/views/writing.py:295:                        changed.add(linked)\nsrc/hivemind/views/writing.py:297:                store.link(conn, stored_id, view_id, seq)\nsrc/hivemind/views/writing.py:303:            store.link(conn, stored_id, view_id, seq)\nsrc/hivemind/research_context.py:87:            ids = self.rows('select distinct e.evidence_id,e.created_seq from evidence e join evidence_links l on l.evidence_id=e.evidence_id where l.view_id=? and l.seq<? and e.created_seq<? and not exists (select 1 from replacements r where r.old_evidence_id=e.evidence_id and r.seq<?) order by e.created_seq,e.evidence_id', (vid,self.seq,self.seq,self.seq))\nsrc/hivemind/views/judging.py:43:    \"\"\"(the pieces a judgement of this thesis reads, how many pieces in force are not shown): the arrivals (linked after the\nsrc/hivemind/views/judging.py:50:    linked_at = {r['evidence_id']: r['seq'] for r in conn.execute('select evidence_id, seq from evidence_links where view_id=?', (view_id,))}\nsrc/hivemind/views/judging.py:51:    shown = [p for p in in_force if linked_at.get(p['evidence_id'], -1) > arrivals_after or p['evidence_id'] in basis]\n85:def test_typed_direction_reads_bounds_in_rung_order_and_never_prose():\n98:def test_the_label_follows_the_sign_and_both_ladders():\n111:def test_an_existing_segment_reads_a_newly_opened_total(tmp_path):\n122:def test_one_sign_job_holds_both_reading_directions(tmp_path):\n140:def test_no_link_without_a_direction_and_a_sign_at_the_threshold(tmp_path, script):\n149:def test_pairs_outside_number_questions_are_not_asked(tmp_path, change):\n162:def test_two_candidates_of_one_question_are_asked_once(tmp_path):\n183:def test_a_circle_through_a_stored_link_is_corrected_once(tmp_path):\n207:def test_a_circle_through_two_openings_is_found_and_a_persistent_one_fails(tmp_path):\n232:def test_a_store_with_an_unbound_wait_is_refused_and_a_bound_wait_counts_through_its_target(tmp_path):\n257:def test_an_existing_question_gains_a_reads_link_and_is_judged_that_day(tmp_path):\n267:def test_a_closed_endpoint_refuses_the_whole_write(tmp_path):\n280:def test_a_reads_link_is_not_a_narrower_home_and_a_seed_row_still_is(tmp_path):\n300:def test_judging_v8_shows_the_comparison_point_and_forecast_and_v7_is_unchanged(tmp_path):\n330:def test_a_changed_read_conclusion_queues_its_reader_and_an_unchanged_one_does_not(tmp_path, changed, queued):\n349:def test_the_links_engine_loads_but_ordinary_launchers_refuse_it():\n356:def test_an_ordinary_replay_refuses_a_harness_only_ledger_before_routing(tmp_path):\n380:def test_the_article_writes_the_link_and_records_proposed_then_committed(tmp_path):\n392:def test_under_the_jev_engine_no_link_question_is_asked(tmp_path):\n400:def test_a_jev_failure_records_failed_alone_with_the_failing_request(tmp_path):\n419:def test_a_write_conflict_after_the_proposal_records_proposed_then_failed(tmp_path, monkeypatch):\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba docs/research/2026-11-20-production-readiness/dependency-design/PROOF.md\nrg --files docs/research/2026-11-20-production-readiness/dependency-design | rg 'log|rule|july'\nnl -ba docs/research/2026-11-20-production-readiness/dependency-design/july_test.py\"","aggregated_output":"     1\t# The $0 proof of the linking version (D694, D695), for the council before the July send\n     2\t\n     3\tBuilt (working tree, not committed): `src/hivemind/views/links.py` (new); `views/round.py` (the link step between matching and the\n     4\t`matched` marker, `link_selections` records); `views/writing.py` (`proposed_links`, `_write_links`); `views/store.py` (`dependencies.kind`,\n     5\t`link_selections`, `direct_parents` skips `reads`, `current_state` returns the stance fields); `views/judging.py` (`judging-v8`, the full\n     6\tdependency block); `config.py` (`jev-links`); `parallel_day.py`; `research_context.py` (explicit columns); `scripts/replay.py` and\n     7\t`clean-arch/e2e-comparison-2026-11-13/budget_replay.py` (refuse `jev-links` and a harness-only ledger); `prompts/judging-v8.txt` (byte\n     8\tcopy of v7); `poc/config/poc-v119.json`.\n     9\t\n    10\t| Check | Result | Record |\n    11\t|---|---|---|\n    12\t| the whole suite | 376 passed (346 before; `tests/test_links.py` 29; one new pin test) | `python3 -m pytest -q` |\n    13\t| mutants | 7 of 7 caught, each control passing; the harness-ledger mutant's failure read: the refusal message is missing | `mutants.py`, `mutants.log` |\n    14\t| frozen pins | v7 pins unchanged; v8 file sha = v7's; v8 schema = v7's; the link questions pinned | `tests/test_frozen_questions_and_judgement.py` |\n    15\t| the July starting state | old-2 rebuilt to the end of 07-09 under poc-v118, every request from the archive; equal on views, keys, rungs, evidence, links, judgements (with cites, changed, reference, implied outcome, request sha), switches, successions, dependencies | `rebuild_control.py`, `rebuild-control.log` |\n    16\t| poc-v119 with no link reproduces the prefix | equal on the same tables; 3 link requests asked before 07-10 (answered neither), eligible pairs listed | `july_test.py prefix`, `prefix-v119.log` |\n    17\t| the archive | 145 v9/v14 judge rows retired; exact old v9 and v14 requests go to the transport; an exact old v8 request is answered from the archive with its call id; a retired answer is not returned again | `july_test.py archive` |\n    18\t| the dry run (fake answers for every bought call) | 29 of 29 checks: controls judge v9 only on 07-10 and 07-12 and write no link; linked sequences write \"v9 reads v14\" (`first_is_bullish`, seq 148) and show the v8 block; a changed v14 on 07-11 queues v9, an unchanged one does not; every later request carries its own sequence's previous answer; every v9/v14 judgement is a fresh call; an unapproved judge request and a link request at another sequence are refused before the inner transport; an out-of-pair link stops the sequence at inspection | `july_test.py dry`, `dry-run.log` |\n    19\t| price | the stored v9/v14 judge calls of 07-10..07-12: $0.0098 a sequence uncached, $0.0586 for six; ceiling $0.15 | `july_test.py price` |\n    20\t| filing exposure | 105 reading answers after seq 148 link a statement to both v9 and v14 (total revenue's own Q1 figure and Q2 guidance among them); with `kind='reads'` none moves | `filing-exposure.md`, test 5 |\n    21\t| the reading rule | frozen: `reading-rule.md` (sha256 below) | |\n    22\t\n    23\tWritten, not run: `july_test.py send <scratch> <prefix ledger> <out>`: six sequences alternated (control-1, linked-1, ... under\n    24\tpoc-v118 and poc-v119) through `run_sequence` with `BudgetTransport` over a new `SharedLedger` (ceiling $0.15) and `install_stop_gate`;\n    25\tthe shared ledger read after each sequence (stopped, refused or overrun: inconclusive, and the send ends). It runs only after the\n    26\tcouncil passes this proof. Not done: the PRD 06 text for the\n    27\tnew matcher outcome (it changes with the decision that makes a version the product).\n    28\treading-rule.md sha256: cc876b60b8eef25b7675f6d078147d2e569ec97d1b1bfa969f9ec8060d596680\ndocs/research/2026-11-20-production-readiness/dependency-design/mutants.log\ndocs/research/2026-11-20-production-readiness/dependency-design/rebuild-control.log\ndocs/research/2026-11-20-production-readiness/dependency-design/july_test.py\ndocs/research/2026-11-20-production-readiness/dependency-design/reading-rule.md\ndocs/research/2026-11-20-production-readiness/dependency-design/prefix-v119.log\ndocs/research/2026-11-20-production-readiness/dependency-design/dry-run.log\n     1\t\"\"\"The July test of the reading-links version (D694 (c), D695; DESIGN.md, TEST-PLAN.md). The only entry point that runs poc-v119.\n     2\t\n     3\t  python3 july_test.py prefix  <scratch>                 # $0: poc-v119 over 07-01..07-09 with every link question answered \"neither\"\n     4\t  python3 july_test.py archive <scratch>                 # $0: the per-sequence archive hides the v9/v14 judge rows, keeps the rest\n     5\t  python3 july_test.py dry     <scratch> <prefix ledger> # $0: the whole harness on 07-10..07-12 with fake answers for every bought call\n     6\t  python3 july_test.py price   <scratch>                 # $0: the stored v9/v14 judge calls of the window priced at published rates\n     7\t  python3 july_test.py send    <scratch> <prefix ledger> <out>   # paid, after the council has passed the $0 proof: six sequences\n     8\t\n     9\tEach sequence: its own copy of the prefix ledger (old-2 rebuilt to the end of 07-09, `rebuild_control.py`), marked harness-only, held\n    10\tunder the store lock; its own copy of old-2's archive with every v9 and v14 judge row retired, so both questions are judged fresh;\n    11\t`replay.run` with a serial item runner as its day runner. Requests that miss the archive pass an allow-list before any transport: the\n    12\tday's judging may send only v9/v14 judge requests; an item may send only link questions, and only at seq 148 in the linked arm. After\n    13\tseq 148 commits, a link whose reader is not v9 or v14 stops the sequence. A stopped sequence is final.\n    14\t\"\"\"\n    15\timport json\n    16\timport shutil\n    17\timport sqlite3\n    18\timport sys\n    19\tfrom pathlib import Path\n    20\t\n    21\tREPO = Path(__file__).resolve().parents[4]\n    22\tsys.path.insert(0, str(REPO / 'src'))\n    23\tfrom hivemind import config, live_lock, model, replay, universe       # noqa: E402\n    24\tfrom hivemind.views import links, store                                # noqa: E402\n    25\tfrom hivemind.views import round as rounds                             # noqa: E402\n    26\t\n    27\tOLD2 = REPO / 'poc/data/comparison-2026-11-17/run/old-2/prod'\n    28\tITEMS = REPO / 'poc/data/comparison-2026-11-17/items-comparison.sqlite'\n    29\tV118 = REPO / 'poc/config/poc-v118.json'\n    30\tV119 = REPO / 'poc/config/poc-v119.json'\n    31\tUNIVERSE = REPO / 'poc/universe.json'\n    32\tLINK_SEQ, PREFIX_SEQ = 148, 147\n    33\tTARGETS = ('v9', 'v14')\n    34\tWINDOW = ('2026-07-10', '2026-07-12')\n    35\tCEILING = 0.15\n    36\tINTENDED = ('v9', 'v14')                       # Data Center FY2027 reads total revenue FY2027\n    37\t\n    38\t\n    39\tclass Stop(RuntimeError):\n    40\t    \"\"\"The harness stopped a sequence (an unapproved request, an out-of-pair link); the sequence is final.\"\"\"\n    41\t\n    42\t\n    43\tdef judged_view(request):\n    44\t    \"\"\"The thesis a judge request is about (its user text begins \"Thesis <id> (\"), or None for any other request.\"\"\"\n    45\t    if 'messages' not in request:\n    46\t        return None\n    47\t    text = request['messages'][-1]['content']\n    48\t    return text.split(' ', 2)[1] if text.startswith('Thesis v') else None\n    49\t\n    50\t\n    51\tdef is_link_request(request):\n    52\t    questions = request.get('questions') or {}\n    53\t    return bool(questions) and all(qid.startswith(('reads__', 'sign__')) for qid in questions)\n    54\t\n    55\t\n    56\tclass JudgingScope:\n    57\t    \"\"\"The day's judging: only a v9 or v14 judge request may reach the inner transport.\"\"\"\n    58\t\n    59\t    def __init__(self, inner):\n    60\t        self.inner, self.sent = inner, []\n    61\t\n    62\t    def __call__(self, *args):\n    63\t        request = args[-1]\n    64\t        view_id = judged_view(request) if len(args) == 2 else None\n    65\t        if view_id not in TARGETS:\n    66\t            raise Stop(f'unapproved request in judging (thesis {view_id}): not sent')\n    67\t        self.sent.append(view_id)\n    68\t        return self.inner(*args)\n    69\t\n    70\t\n    71\tclass ItemScope:\n    72\t    \"\"\"One item's transport: only link questions, only at seq 148, only in the linked arm.\"\"\"\n    73\t\n    74\t    def __init__(self, inner, seq, linked, sent):\n    75\t        self.inner, self.seq, self.linked, self.sent = inner, seq, linked, sent\n    76\t\n    77\t    def __call__(self, *args):\n    78\t        request = args[-1]\n    79\t        if not (len(args) == 1 and is_link_request(request) and self.linked and self.seq == LINK_SEQ):\n    80\t            raise Stop(f'unapproved request at seq {self.seq} ({\"link questions\" if len(args) == 1 and is_link_request(request) else \"not a link question\"}): not sent')\n    81\t        self.sent.append(('jev', self.seq, sorted(request['questions'])))\n    82\t        return self.inner(*args)\n    83\t\n    84\t\n    85\tclass SerialRunner:\n    86\t    \"\"\"replay.run's day runner: each routed item through round.run with a transport bound to its own sequence; after seq 148 commits,\n    87\t    the committed links are inspected before anything else runs.\"\"\"\n    88\t\n    89\t    def __init__(self, inner, linked):\n    90\t        self.inner, self.linked, self.sent, self.links = inner, linked, [], []\n    91\t\n    92\t    def __call__(self, conn, archive, cfg, uni, items, *, day, transport=None, log=print):\n    93\t        for item, route in items:\n    94\t            result = rounds.run(conn, archive, cfg, uni, item, route.sequence_no, resume_from=route.resume_from,\n    95\t                                transport=ItemScope(self.inner, route.sequence_no, self.linked, self.sent), log=log)\n    96\t            if not result.failed and route.sequence_no == LINK_SEQ:\n    97\t                self.links = [tuple(r) for r in conn.execute(\"select view_id, depends_on, direction, seq from dependencies where kind=?\", (links.KIND,))]\n    98\t                outside = [r for r in self.links if r[0] not in TARGETS]\n    99\t                if outside:\n   100\t                    raise Stop(f'out-of-pair link committed at seq {LINK_SEQ}: {outside}: the sequence is not comparable')\n   101\t            yield result\n   102\t\n   103\t\n   104\tdef retire_targets(archive_path):\n   105\t    archive = model.Archive(str(archive_path))\n   106\t    rows = archive.conn.execute(\"select call_id, request_json from model_calls where purpose='judge'\").fetchall()\n   107\t    retired = 0\n   108\t    for call_id, request_json in rows:\n   109\t        if judged_view(json.loads(request_json)) in TARGETS:\n   110\t            archive.retire(call_id)\n   111\t            retired += 1\n   112\t    top = archive.conn.execute('select coalesce(max(call_id), 0) from model_calls').fetchone()[0]\n   113\t    return archive, retired, top\n   114\t\n   115\t\n   116\tdef prepare(folder, prefix_ledger):\n   117\t    if folder.exists():\n   118\t        raise SystemExit(f'{folder} exists: a sequence starts from an empty folder and is never resumed')\n   119\t    folder.mkdir(parents=True)\n   120\t    views, archive_path = folder / 'views.sqlite', folder / 'archive.sqlite'\n   121\t    shutil.copyfile(prefix_ledger, views)\n   122\t    conn = sqlite3.connect(views)\n   123\t    last = conn.execute('select max(seq) from days_completed').fetchone()[0]\n   124\t    unfinished = conn.execute('select count(*) from processing_steps where sequence_no > ?', (last,)).fetchone()[0]\n   125\t    if last != PREFIX_SEQ or unfinished:\n   126\t        raise SystemExit(f'the prefix ledger is not the finished end of 07-09 (last completed seq {last}, {unfinished} later steps)')\n   127\t    conn.execute('create table harness_only (name text, day text)')\n   128\t    conn.execute(\"insert into harness_only values ('july_test.py', '2026-11-21')\")\n   129\t    conn.commit()\n   130\t    conn.close()\n   131\t    shutil.copyfile(OLD2 / 'archive.sqlite', archive_path)\n   132\t    archive, retired, top = retire_targets(archive_path)\n   133\t    return views, archive, retired, top\n   134\t\n   135\t\n   136\tdef run_sequence(scratch, name, prefix_ledger, cfg_path, linked, inner, log):\n   137\t    folder = scratch / name\n   138\t    views, archive, retired, top = prepare(folder, prefix_ledger)\n   139\t    cfg, uni = config.load(str(cfg_path)), universe.load(str(UNIVERSE))\n   140\t    judging_scope, runner = JudgingScope(inner), SerialRunner(inner, linked)\n   141\t    held = live_lock.acquire(str(views))\n   142\t    stopped = ''\n   143\t    try:\n   144\t        replay.run(testdb_path=str(ITEMS), views_path=str(views), archive=archive, cfg=cfg, universe=uni, from_day=WINDOW[0],\n   145\t                   until_day=WINDOW[1], transport=judging_scope, day_runner=runner, only_objects={'NVDA'}, log=log)\n   146\t    except Exception as error:\n   147\t        stopped = f'{type(error).__name__}: {error}'[:400]\n   148\t    finally:\n   149\t        live_lock.release(held)\n   150\t    conn = sqlite3.connect(f'file:{views}?mode=ro', uri=True)\n   151\t    judgements = [dict(zip(('view_id', 'day', 'call_id', 'rung', 'changed', 'reference', 'implied_outcome', 'reasons'), r)) for r in conn.execute(\n   152\t        'select view_id, publication_day, call_id, rung, changed, reference, implied_outcome, reasons from judgements where seq > ? and view_id in (?, ?) order by judgement_id',\n   153\t        (PREFIX_SEQ, *TARGETS))]\n   154\t    fresh = [j for j in judgements if j['call_id'] > top]\n   155\t    calls = [j['call_id'] for j in judgements]\n   156\t    summary = {'name': name, 'config': cfg.version, 'linked': linked, 'stopped': stopped, 'retired_target_rows': retired,\n   157\t               'links': runner.links, 'judge_requests_sent': judging_scope.sent, 'link_requests_sent': runner.sent,\n   158\t               'judgements': judgements, 'all_target_judgements_fresh': len(fresh) == len(judgements) and len(set(calls)) == len(calls),\n   159\t               'selection': [tuple(r) for r in conn.execute('select attempt_id, status, record_json from link_selections order by id')]}\n   160\t    (folder / 'summary.json').write_text(json.dumps(summary, indent=1, ensure_ascii=False))\n   161\t    return summary, views, folder / 'archive.sqlite'\n   162\t\n   163\t\n   164\t# ---------- fakes for the $0 runs ----------\n   165\t\n   166\tdef fake_judge(label, changed_on):\n   167\t    \"\"\"A judge answering every v9/v14 request with labelled reasons; `changed_on` maps (view, n) to the changed flag of that view's n-th\n   168\t    judgement in the sequence (1 = 07-10's); a first judgement always says changed.\"\"\"\n   169\t    calls = {}\n   170\t\n   171\t    def answer(provider, request):\n   172\t        text = request['messages'][-1]['content']\n   173\t        view_id = judged_view(request)\n   174\t        calls[view_id] = calls.get(view_id, 0) + 1\n   175\t        changed = True if '[Previous conclusion] none' in text else changed_on.get((view_id, calls[view_id]), True)\n   176\t        data = {'rung': 3, 'reference': f'{label} reference for {view_id}', 'implied_outcome': f'{label} forecast for {view_id}',\n   177\t                'reasons': f'{label} reasons for {view_id} #{calls[view_id]}', 'cites': [], 'cites_views': [], 'pushes': [], 'changed': changed,\n   178\t                'why_changed': '', 'theme_pushes': []}\n   179\t        return {'choices': [{'message': {'content': json.dumps(data)}}], 'usage': {'prompt_tokens': 100, 'completion_tokens': 10}}\n   180\t    return answer\n   181\t\n   182\t\n   183\tdef fake_jev(readers):\n   184\t    \"\"\"Link questions: `readers` are the theses answered \"the THESIS reads the CANDIDATE\" (sign together); every other pair neither.\"\"\"\n   185\t    def answer(request):\n   186\t        answers = {}\n   187\t        for qid, question in request['questions'].items():\n   188\t            view_id = qid.split('__', 1)[1]\n   189\t            chosen = (links.THESIS_READS if view_id in readers else links.NEITHER) if qid.startswith('reads__') else links.TOGETHER\n   190\t            others = [k for k in question['criteria'] if k != chosen]\n   191\t            probabilities = {k: round(0.2 / len(others), 4) for k in others}\n   192\t            probabilities[chosen] = round(1 - sum(probabilities.values()), 4)\n   193\t            answers[qid] = {'type': 'choice', 'choice': chosen, 'confidence': probabilities[chosen], 'probabilities': probabilities}\n   194\t        return {'model': request['model'], 'answers': answers, 'usage': {'input_tokens': 100, 'output_tokens': 10}}\n   195\t    return answer\n   196\t\n   197\t\n   198\tdef dispatcher(judge, jev_answer, counter):\n   199\t    def transport(*args):\n   200\t        counter.append(len(args))\n   201\t        return jev_answer(args[0]) if len(args) == 1 else judge(*args)\n   202\t    return transport\n   203\t\n   204\t\n   205\tdef requests_of(archive_path, top, view_id):\n   206\t    archive = sqlite3.connect(f'file:{archive_path}?mode=ro', uri=True)\n   207\t    rows = archive.execute(\"select request_json from model_calls where purpose='judge' and call_id > ? order by call_id\", (top,)).fetchall()\n   208\t    return [json.loads(r[0])['messages'][-1]['content'] for r in rows if json.loads(r[0])['messages'][-1]['content'].startswith(f'Thesis {view_id} (')]\n   209\t\n   210\t\n   211\tdef dry(scratch, prefix_ledger):\n   212\t    scratch.mkdir(parents=True, exist_ok=True)\n   213\t    checks, log = {}, (lambda *a: None)\n   214\t    plans = {'control-A': (V118, False, 'DRY-A', {}), 'control-B': (V118, False, 'DRY-B', {}),\n   215\t             'linked-A': (V119, True, 'DRY-A', {('v14', 2): True}), 'linked-B': (V119, True, 'DRY-B', {('v14', 2): False})}\n   216\t    for name, (cfg_path, linked, label, changed_on) in plans.items():\n   217\t        counter = []\n   218\t        summary, _, archive_path = run_sequence(scratch, name, prefix_ledger, cfg_path, linked,\n   219\t                                                dispatcher(fake_judge(label, changed_on), fake_jev({'v9'}), counter), log)\n   220\t        days = {(j['view_id'], j['day']) for j in summary['judgements']}\n   221\t        top = retire_targets_top(archive_path)\n   222\t        v9_requests = requests_of(archive_path, top, 'v9')\n   223\t        v14_requests = requests_of(archive_path, top, 'v14')\n   224\t        # each view's first request in the window carries the prefix's conclusion (v9: old-2's 07-09 answer; v14: none); every later one\n   225\t        # must carry this sequence's own previous answer\n   226\t        own = all(f'{label} reasons for' in r.split('[Previous conclusion', 1)[1] for r in v9_requests[1:] + v14_requests[1:]) \\\n   227\t            and bool(v9_requests) and f'{label} reasons for' not in v9_requests[0].split('[Previous conclusion', 1)[1] \\\n   228\t            and '[Previous conclusion] none' in v14_requests[0]\n   229\t        checks[name] = {\n   230\t            'not stopped': summary['stopped'] == '',\n   231\t            'all target judgements fresh': summary['all_target_judgements_fresh'],\n   232\t            'each later request carries its own previous answer': own,\n   233\t            'v14 judged each day': {d for v, d in days if v == 'v14'} == {'2026-07-10', '2026-07-11', '2026-07-12'},\n   234\t            'v9 days': sorted(d for v, d in days if v == 'v9'),\n   235\t        }\n   236\t        if linked:\n   237\t            checks[name]['link written'] = summary['links'] == [('v9', 'v14', 'first_is_bullish', LINK_SEQ)]\n   238\t            checks[name]['v8 block in v9 requests'] = bool(v9_requests) and all('Comparison point stated by that judgement' in r for r in v9_requests)\n   239\t            expected = ['2026-07-10', '2026-07-11', '2026-07-12'] if changed_on.get(('v14', 2)) else ['2026-07-10', '2026-07-12']\n   240\t            checks[name]['v9 queued by a changed v14 only'] = checks[name]['v9 days'] == expected\n   241\t        else:\n   242\t            checks[name]['no link'] = summary['links'] == [] and summary['link_requests_sent'] == []\n   243\t            checks[name]['v9 only on the stored days'] = checks[name]['v9 days'] == ['2026-07-10', '2026-07-12']\n   244\t    # the stop paths: an unapproved judge request, a link request at another sequence, an out-of-pair link\n   245\t    counter = []\n   246\t    inner = dispatcher(fake_judge('DRY-S', {}), fake_jev({'v9'}), counter)\n   247\t    try:\n   248\t        JudgingScope(inner)('openai', {'messages': [{'role': 'user', 'content': 'Thesis v8 (NVDA'}]})\n   249\t        checks['stop: unapproved judge request'] = False\n   250\t    except Stop:\n   251\t        checks['stop: unapproved judge request'] = counter == []\n   252\t    try:\n   253\t        ItemScope(inner, 150, True, [])({'model': 'jev', 'state': '', 'questions': {'reads__v9': {}}})\n   254\t        checks['stop: link request at another seq'] = False\n   255\t    except Stop:\n   256\t        checks['stop: link request at another seq'] = counter == []\n   257\t    out_of_pair, _, _ = run_sequence(scratch, 'linked-out-of-pair', prefix_ledger, V119, True,\n   258\t                                     dispatcher(fake_judge('DRY-O', {}), fake_jev({'v9', 'v1', 'v2', 'v5', 'v6', 'v10', 'v11', 'v12'}), []), log)\n   259\t    checks['stop: out-of-pair link'] = out_of_pair['stopped'].startswith('Stop: out-of-pair link') and not any(\n   260\t        j['day'] > WINDOW[0] for j in out_of_pair['judgements'])\n   261\t    (scratch / 'dry-checks.json').write_text(json.dumps(checks, indent=1))\n   262\t    print(json.dumps(checks, indent=1))\n   263\t    flat = [v for c in checks.values() for k, v in (c.items() if isinstance(c, dict) else [('', c)]) if isinstance(v, bool)]\n   264\t    return all(flat)\n   265\t\n   266\t\n   267\tdef retire_targets_top(archive_path):\n   268\t    \"\"\"The highest call id a sequence's archive held before the sequence ran (written by `prepare`).\"\"\"\n   269\t    archive = sqlite3.connect(f'file:{OLD2 / \"archive.sqlite\"}?mode=ro', uri=True)\n   270\t    return archive.execute('select coalesce(max(call_id), 0) from model_calls').fetchone()[0]\n   271\t\n   272\t\n   273\t# ---------- the other $0 checks ----------\n   274\t\n   275\tdef prefix(scratch):\n   276\t    \"\"\"poc-v119 from an empty ledger over 07-01..07-09: link questions answered \"neither\", every other request from old-2's archive.\"\"\"\n   277\t    folder = scratch / 'prefix-v119'\n   278\t    if folder.exists():\n   279\t        raise SystemExit(f'{folder} exists')\n   280\t    folder.mkdir(parents=True)\n   281\t    shutil.copyfile(OLD2 / 'archive.sqlite', folder / 'archive.sqlite')\n   282\t    asked = []\n   283\t\n   284\t    def transport(*args):\n   285\t        if len(args) == 1 and is_link_request(args[0]):\n   286\t            asked.append(sorted(args[0]['questions']))\n   287\t            return fake_jev(set())(args[0])\n   288\t        raise Stop('a request other than a link question missed the archive')\n   289\t    replay.run(testdb_path=str(ITEMS), views_path=str(folder / 'views.sqlite'), archive=model.Archive(str(folder / 'archive.sqlite')),\n   290\t               cfg=config.load(str(V119)), universe=universe.load(str(UNIVERSE)), from_day='2026-07-01', until_day='2026-07-09',\n   291\t               transport=transport, log=lambda *a: None, only_objects={'NVDA'})\n   292\t    sys.path.insert(0, str(Path(__file__).parent))\n   293\t    import rebuild_control\n   294\t    equal = rebuild_control.compare(folder / 'views.sqlite', PREFIX_SEQ)\n   295\t    conn = sqlite3.connect(f'file:{folder / \"views.sqlite\"}?mode=ro', uri=True)\n   296\t    selections = [(a, s, json.loads(r)) for a, s, r in conn.execute('select attempt_id, status, record_json from link_selections order by id')]\n   297\t    pairs = [(a, p['candidate'], p['thesis']) for a, s, r in selections if s == 'proposed' for p in r['pairs'] if p.get('eligible') and 'thesis' in p]\n   298\t    print('link questions asked before 07-10 (answered neither):', len(asked), 'eligible pairs:', pairs)\n   299\t    return equal\n   300\t\n   301\t\n   302\tdef archive_proof(scratch):\n   303\t    folder = scratch / 'archive-proof'\n   304\t    folder.mkdir(parents=True, exist_ok=False)\n   305\t    shutil.copyfile(OLD2 / 'archive.sqlite', folder / 'archive.sqlite')\n   306\t    stored = sqlite3.connect(f'file:{OLD2 / \"archive.sqlite\"}?mode=ro', uri=True)\n   307\t    rows = {}\n   308\t    for call_id, request_json in stored.execute(\"select call_id, request_json from model_calls where purpose='judge' order by call_id\"):\n   309\t        view_id = judged_view(json.loads(request_json))\n   310\t        rows.setdefault(view_id, (call_id, json.loads(request_json)))\n   311\t    archive, retired, _ = retire_targets(folder / 'archive.sqlite')\n   312\t    sent = []\n   313\t\n   314\t    def recording(provider, request):\n   315\t        sent.append(judged_view(request))\n   316\t        data = {'rung': 0, 'reference': '', 'implied_outcome': '', 'reasons': '', 'cites': [], 'cites_views': [], 'pushes': [], 'changed': True,\n   317\t                'why_changed': '', 'theme_pushes': []}\n   318\t        return {'choices': [{'message': {'content': json.dumps(data)}}], 'usage': {'prompt_tokens': 1, 'completion_tokens': 1}}\n   319\t    cfg = config.load(str(V118))\n   320\t    results = {}\n   321\t    for view_id in ('v9', 'v14', 'v8'):\n   322\t        call_id, request = rows[view_id]\n   323\t        system, user = request['messages'][0]['content'], request['messages'][1]['content']\n   324\t        schema = request['response_format']['json_schema']['schema']\n   325\t        answer = model.call(archive, cfg, cfg.rejudging, system, user, schema, 'judgement', 'judge', transport=recording)\n   326\t        results[view_id] = {'sent to the transport': sent[-1:] == [view_id], 'call id kept': answer.cached and answer.call_id == call_id,\n   327\t                            'answer call id': answer.call_id}\n   328\t    archive.retire(results['v9']['answer call id'])           # as round_of_judgements retires an answer its check refuses\n   329\t    call_id, request = rows['v9']\n   330\t    before = len(sent)\n   331\t    model.call(archive, cfg, cfg.rejudging, request['messages'][0]['content'], request['messages'][1]['content'],\n   332\t               request['response_format']['json_schema']['schema'], 'judgement', 'judge', transport=recording)\n   333\t    proof = {'retired target rows': retired,\n   334\t             'an exact old v9 request goes to the transport': results['v9']['sent to the transport'],\n   335\t             'an exact old v14 request goes to the transport': results['v14']['sent to the transport'],\n   336\t             'an exact old v8 request is answered from the archive with its call id': results['v8']['call id kept'] and sent.count('v8') == 0,\n   337\t             'a retired (refused) answer is not returned again': len(sent) == before + 1}\n   338\t    print(json.dumps(proof, indent=1))\n   339\t    return all(v for k, v in proof.items() if isinstance(v, bool))\n   340\t\n   341\t\n   342\tdef price():\n   343\t    stored = sqlite3.connect(f'file:{OLD2 / \"archive.sqlite\"}?mode=ro', uri=True)\n   344\t    views = sqlite3.connect(f'file:{OLD2 / \"views.sqlite\"}?mode=ro', uri=True)\n   345\t    shas = [r[0] for r in views.execute(\"select request_sha256 from judgements where view_id in ('v9','v14') and publication_day between ? and ?\", WINDOW)]\n   346\t    price_in, price_out = model.PRICES['gpt-6-luna']\n   347\t    total, rows = 0.0, []\n   348\t    for sha in shas:\n   349\t        tokens_in, tokens_out = stored.execute('select input_tokens, output_tokens from model_calls where request_sha256=?', (sha,)).fetchone()\n   350\t        cost = tokens_in / 1e6 * price_in + tokens_out / 1e6 * price_out\n   351\t        rows.append((tokens_in, tokens_out, round(cost, 5)))\n   352\t        total += cost\n   353\t    print(json.dumps({'stored v9/v14 judge calls in the window': rows, 'one sequence (uncached)': round(total, 4),\n   354\t                      'six sequences': round(6 * total, 4), 'ceiling': CEILING}, indent=1))\n   355\t\n   356\t\n   357\tORDER = [('control-1', V118, False), ('linked-1', V119, True), ('control-2', V118, False), ('linked-2', V119, True),\n   358\t         ('control-3', V118, False), ('linked-3', V119, True)]       # alternated, so a ceiling stop falls on both arms alike\n   359\t\n   360\t\n   361\tdef send(prefix_ledger, out):\n   362\t    \"\"\"The paid comparison (run only after the council passed the $0 proof, D694 (c)): six sequences through the shared reservation ledger\n   363\t    of the comparison runs, one ceiling of $0.15; the ledger is read after each sequence, and a refused reservation or a stop makes the\n   364\t    comparison inconclusive and ends it.\"\"\"\n   365\t    import importlib.util\n   366\t    spec = importlib.util.spec_from_file_location('budget_replay', REPO / 'clean-arch/e2e-comparison-2026-11-13/budget_replay.py')\n   367\t    budget = importlib.util.module_from_spec(spec)\n   368\t    spec.loader.exec_module(budget)\n   369\t    out.mkdir(parents=True, exist_ok=False)\n   370\t    ledger_path = out / 'ledger.json'\n   371\t    budget.SharedLedger.init(str(ledger_path), CEILING)\n   372\t    ledger = budget.SharedLedger(str(ledger_path))\n   373\t    remove_gate = budget.install_stop_gate(ledger)\n   374\t    transport = budget.BudgetTransport(ledger)\n   375\t    results, outcome = [], 'complete'\n   376\t    with open(out / 'send.log', 'a', encoding='utf-8') as log_file:\n   377\t        def log(*parts):\n   378\t            log_file.write(' '.join(str(p) for p in parts) + '\\n')\n   379\t            log_file.flush()\n   380\t        try:\n   381\t            for name, cfg_path, linked in ORDER:\n   382\t                summary, _, _ = run_sequence(out, name, prefix_ledger, cfg_path, linked, transport, log)\n   383\t                state = ledger.read()\n   384\t                summary['ledger_after'] = state\n   385\t                results.append(summary)\n   386\t                log(f'{name}: stopped={summary[\"stopped\"]!r} spent ${state[\"spent\"]:.4f} reserved ${state[\"reserved\"]:.4f} refused {state[\"refused\"]}')\n   387\t                if state.get('stopped') or state.get('refused') or state.get('overrun'):\n   388\t                    outcome = 'inconclusive: the shared ledger stopped, refused or overran'\n   389\t                    break\n   390\t        finally:\n   391\t            remove_gate()\n   392\t    (out / 'send-summary.json').write_text(json.dumps({'outcome': outcome, 'ledger': ledger.read(), 'sequences': results}, indent=1, ensure_ascii=False))\n   393\t    print(outcome, ledger.read())\n   394\t\n   395\t\n   396\tif __name__ == '__main__':\n   397\t    mode, scratch = sys.argv[1], Path(sys.argv[2])\n   398\t    scratch.mkdir(parents=True, exist_ok=True)\n   399\t    if mode == 'prefix':\n   400\t        sys.exit(0 if prefix(scratch) else 1)\n   401\t    if mode == 'archive':\n   402\t        sys.exit(0 if archive_proof(scratch) else 1)\n   403\t    if mode == 'dry':\n   404\t        sys.exit(0 if dry(scratch, Path(sys.argv[3])) else 1)\n   405\t    if mode == 'price':\n   406\t        price()\n   407\t        sys.exit(0)\n   408\t    if mode == 'send':\n   409\t        send(Path(sys.argv[3]), Path(sys.argv[4]))\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_6","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba clean-arch/e2e-comparison-2026-11-13/budget_replay.py | sed -n '64,168p;225,311p'\nnl -ba docs/research/2026-11-20-production-readiness/dependency-design/reading-rule.md\nnl -ba docs/research/2026-11-20-production-readiness/dependency-design/dry-run.log\ncat docs/research/2026-11-20-production-readiness/dependency-design/prefix-v119.log\ncat docs/research/2026-11-20-production-readiness/dependency-design/mutants.log\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba clean-arch/e2e-comparison-2026-11-13/budget_replay.py | sed -n '64,168p;225,311p'\nnl -ba docs/research/2026-11-20-production-readiness/dependency-design/reading-rule.md\nnl -ba docs/research/2026-11-20-production-readiness/dependency-design/dry-run.log\ncat docs/research/2026-11-20-production-readiness/dependency-design/prefix-v119.log\ncat docs/research/2026-11-20-production-readiness/dependency-design/mutants.log\"","aggregated_output":"    64\t            return True\n    65\t    except OSError:\n    66\t        return True\n    67\t\n    68\t\n    69\tdef install_stop_gate(ledger):\n    70\t    \"\"\"Process-wide: every `urllib.request.urlopen` call, a helper's internal retry included, first reads the shared ledger. When it is\n    71\t    stopped, or when a registered launcher's lock is free (that launcher died without removing its entry: the gate then stops the\n    72\t    ledger), the call is refused as HTTP 403 (no component retries a 403) and nothing is sent. An attempt whose read came before a stop\n    73\t    was written may finish; one that reads after it is refused. Returns a function that removes the gate.\"\"\"\n    74\t    original = urllib.request.urlopen\n    75\t\n    76\t    def gated(request, *arguments, **keywords):\n    77\t        state = ledger.stop_if_a_launcher_is_gone()\n    78\t        if state.get('stopped'):\n    79\t            raise urllib.error.HTTPError(getattr(request, 'full_url', str(request)), 403,\n    80\t                                         f\"the shared ledger is stopped ({state.get('stop_reason')}): not sent\", {},\n    81\t                                         io.BytesIO(b'{\"error\": {\"type\": \"shared_ledger_stopped\"}}'))\n    82\t        return original(request, *arguments, **keywords)\n    83\t    urllib.request.urlopen = gated\n    84\t\n    85\t    def remove():\n    86\t        if urllib.request.urlopen is gated:\n    87\t            urllib.request.urlopen = original\n    88\t    return remove\n    89\t\n    90\t\n    91\tclass SharedLedger:\n    92\t    \"\"\"One JSON ledger for every run under a ceiling, guarded by an exclusive file lock (processes and threads). The first refused\n    93\t    reservation, or an explicit `stop`, persists `stopped` with its reason under the lock: every later reservation, in any thread or\n    94\t    process, is refused (WIRING-DESIGN.md §B2, D448).\"\"\"\n    95\t\n    96\t    def __init__(self, path):\n    97\t        self.path = Path(path)\n    98\t        self.lock_path = self.path.with_suffix('.lock')\n    99\t        self.attempts_path = self.path.with_suffix('.attempts.jsonl')   # one line per settled or refused attempt: the measurement record\n   100\t\n   101\t    def _note(self, entry):\n   102\t        \"\"\"Append one attempt line (the process, the call kind, the amounts, the tokens when reported, the moment) for per-component\n   103\t        spend and timing. Written only after the ledger's state is saved, and best-effort: a failed append never blocks a stop, a charge\n   104\t        or an overrun. A crash between the two writes leaves the lines short of the ledger, never ahead of it; the tally reports the gap\n   105\t        as unaccounted. One short append, so concurrent lines do not interleave.\"\"\"\n   106\t        line = json.dumps(dict(entry, pid=os.getpid(), at=time.strftime('%Y-%m-%dT%H:%M:%S%z'))) + '\\n'\n   107\t        try:\n   108\t            with open(self.attempts_path, 'a') as handle:\n   109\t                handle.write(line)\n   110\t        except OSError:\n   111\t            pass\n   112\t\n   113\t    @contextlib.contextmanager\n   114\t    def _locked(self):\n   115\t        with open(self.lock_path, 'a+') as lock:\n   116\t            fcntl.flock(lock, fcntl.LOCK_EX)\n   117\t            try:\n   118\t                state = json.loads(self.path.read_text())\n   119\t                yield state\n   120\t                temporary = self.path.with_suffix('.tmp')\n   121\t                temporary.write_text(json.dumps(state, indent=1))\n   122\t                os.replace(temporary, self.path)          # a reader never sees a half-written ledger\n   123\t            finally:\n   124\t                fcntl.flock(lock, fcntl.LOCK_UN)\n   125\t\n   126\t    @staticmethod\n   127\t    def init(path, ceiling):\n   128\t        Path(path).write_text(json.dumps({'ceiling': ceiling, 'spent': 0.0, 'reserved': 0.0, 'overrun': False, 'refused': 0, 'attempts': 0,\n   129\t                                          'stopped': False, 'stop_reason': None}, indent=1))\n   130\t\n   131\t    def reserve(self, amount):\n   132\t        with self._locked() as state:\n   133\t            granted = not (state.get('stopped') or state['overrun'] or state['spent'] + state['reserved'] + amount > state['ceiling'])\n   134\t            if granted:\n   135\t                state['reserved'] += amount\n   136\t                state['attempts'] += 1\n   137\t            else:\n   138\t                state['refused'] += 1\n   139\t                if not state.get('stopped'):\n   140\t                    state['stopped'] = True\n   141\t                    state['stop_reason'] = 'overrun' if state['overrun'] else f'a reservation of ${amount:.6f} would pass the ${state[\"ceiling\"]:.2f} ceiling'\n   142\t        if not granted:\n   143\t            self._note({'refused': amount})                  # after the stop is saved\n   144\t            return False\n   145\t        _LIVE.depth = getattr(_LIVE, 'depth', 0) + 1\n   146\t        return True\n   147\t\n   148\t    @staticmethod\n   149\t    def estimate(request):\n   150\t        \"\"\"The shared reservation of one language-model attempt (WIRING-DESIGN.md §B): `llm_estimate`.\"\"\"\n   151\t        return llm_estimate(request)\n   152\t\n   153\t    def settle(self, reserved, actual, kind='llm', tokens=None):\n   154\t        \"\"\"Settle one attempt. A missing, non-finite, zero or negative charge settles at the whole reservation: an answered paid\n   155\t        request never costs nothing, and a failed attempt is charged its reservation. `kind` (llm, jev, embeddings) and the reported\n   156\t        `tokens` go to the attempt line only.\"\"\"\n   157\t        _LIVE.depth = max(0, getattr(_LIVE, 'depth', 0) - 1)\n   158\t        if not isinstance(actual, (int, float)) or isinstance(actual, bool) or not math.isfinite(actual) or actual <= 0:\n   159\t            actual = reserved\n   160\t        with self._locked() as state:\n   161\t            state['reserved'] = max(0.0, state['reserved'] - reserved)\n   162\t            state['spent'] += actual\n   163\t            if actual > reserved + 1e-12:\n   164\t                state['overrun'] = True\n   165\t                if not state.get('stopped'):\n   166\t                    state['stopped'], state['stop_reason'] = True, 'overrun'\n   167\t        self._note({'kind': kind, 'reserved': reserved, 'charged': actual, **({'tokens': tokens} if tokens is not None else {})})\n   168\t\n   225\t\n   226\t\n   227\tdef llm_estimate(request):\n   228\t    price_in, price_out = model.PRICES[request['model']]\n   229\t    cap = request.get('max_completion_tokens', request.get('max_tokens'))\n   230\t    if isinstance(cap, bool) or not isinstance(cap, int) or cap <= 0:\n   231\t        raise model.TransportError('request without a positive output cap: refused by the budget')\n   232\t    tokens_in = 2 * len(json.dumps(request).encode('utf-8')) + 4096\n   233\t    return (tokens_in * price_in + cap * price_out) / 1e6\n   234\t\n   235\t\n   236\tdef whole(count):\n   237\t    return isinstance(count, int) and not isinstance(count, bool) and count >= 0\n   238\t\n   239\t\n   240\tdef llm_cost(response, request):\n   241\t    \"\"\"The answer's cost by `model.call`'s formula; None (settled at the reservation) unless the counts are whole, nonnegative numbers\n   242\t    with some input.\"\"\"\n   243\t    usage = response.get('usage') if isinstance(response, dict) else None\n   244\t    if not isinstance(usage, dict):\n   245\t        return None\n   246\t    tokens_in, tokens_out = usage.get('prompt_tokens'), usage.get('completion_tokens')\n   247\t    details = usage.get('prompt_tokens_details') or {}\n   248\t    cached = (details.get('cached_tokens') or 0) if isinstance(details, dict) else None\n   249\t    if not (whole(tokens_in) and whole(tokens_out) and whole(cached)) or tokens_in == 0:\n   250\t        return None\n   251\t    price_in, price_out = model.PRICES[request['model']]\n   252\t    cached = min(tokens_in, cached)\n   253\t    return (tokens_in - cached) / 1e6 * price_in + cached / 1e6 * price_in * model.CACHED_INPUT_SHARE + tokens_out / 1e6 * price_out\n   254\t\n   255\t\n   256\tdef jev_estimate(request):\n   257\t    price_in, _ = model.PRICES[request['model']]\n   258\t    tokens_in = 2 * len(json.dumps(request, sort_keys=True, ensure_ascii=False).encode('utf-8')) + 4096\n   259\t    return jev.ATTEMPTS * tokens_in * price_in / 1e6\n   260\t\n   261\t\n   262\tclass BudgetTransport:\n   263\t    \"\"\"Called as production calls a transport: (provider, request) for a language model, (request,) for Jev.\"\"\"\n   264\t\n   265\t    def __init__(self, ledger, sleep=time.sleep):\n   266\t        self.ledger, self.sleep = ledger, sleep\n   267\t\n   268\t    def __call__(self, *args):\n   269\t        if len(args) == 1:\n   270\t            return self._jev(args[0])\n   271\t        provider, request = args\n   272\t        for attempt in range(3):\n   273\t            estimate = llm_estimate(request)\n   274\t            if not self.ledger.reserve(estimate):\n   275\t                raise model.TransportError('the shared budget ceiling would be passed: not sent')\n   276\t            try:\n   277\t                response = model.openai_transport(provider, request, max_attempts=1)\n   278\t            except model.TransportError as error:\n   279\t                self.ledger.settle(estimate, estimate)\n   280\t                status = getattr(error, 'http_status', None)\n   281\t                if status in CLIENT_ERRORS or attempt == 2 or (status is not None and status != 429 and status < 500):\n   282\t                    raise\n   283\t                self.sleep(5 * (attempt + 1))\n   284\t                continue\n   285\t            except Exception:\n   286\t                self.ledger.settle(estimate, estimate)\n   287\t                raise\n   288\t            cost = llm_cost(response, request)\n   289\t            self.ledger.settle(estimate, estimate if cost is None else cost)\n   290\t            return response\n   291\t        raise model.TransportError('no answer after three attempts')\n   292\t\n   293\t    def _jev(self, request):\n   294\t        estimate = jev_estimate(request)\n   295\t        if not self.ledger.reserve(estimate):\n   296\t            raise model.TransportError('the shared budget ceiling would be passed: not sent')\n   297\t        try:\n   298\t            response = jev.transport(request)\n   299\t        except Exception:\n   300\t            self.ledger.settle(estimate, estimate, kind='jev')\n   301\t            raise\n   302\t        usage = response.get('usage') if isinstance(response, dict) else None\n   303\t        tokens = usage.get('input_tokens') if isinstance(usage, dict) else None\n   304\t        if isinstance(tokens, int) and not isinstance(tokens, bool) and tokens > 0:\n   305\t            # an unanswered attempt inside jev.transport was the same request, so each of the three is billed at most this input;\n   306\t            # the whole charge is settled, so a charge above the reservation sets the overrun flag\n   307\t            actual = jev.ATTEMPTS * tokens * model.PRICES[request['model']][0] / 1e6\n   308\t        else:\n   309\t            actual = estimate                       # usage missing, invalid, or zero for a nonempty request: the whole reservation\n   310\t        self.ledger.settle(estimate, actual, kind='jev', tokens=tokens if isinstance(tokens, int) else None)\n   311\t        return response\n     1\t# The July test: reading rule, frozen 2026-11-21 before any send (D694 (c))\n     2\t\n     3\tCopied from `TEST-PLAN.md` without change; scored line by line as written.\n     4\t\n     5\t## Reading rule (frozen before the send; council R round 2, `codex-r2.md` §7(b), with round 3)\n     6\t- **A. Comparable answers:** both 07-12 answers give a FY2027 forecast in USD for their own quantity (a range by its stated ends);\n     7\t  quarters recorded where both give comparable figures; a missing annual figure leaves reconciliation untested.\n     8\t- **B. Arithmetic and sources:** reported figures keep their amount and scope; the arithmetic follows from the stated inputs within\n     9\t  rounding; each assumption that materially sizes the result is disclosed and supported by the material available that day; a linked\n    10\t  forecast is treated as a forecast with assumptions.\n    11\t- **C. Room for the rest:** the high end of the Data Center forecast is at least $6B below the low end of the company forecast (the Q1\n    12\t  floor: $81.6B total minus $75.25B Data Center); each comparable quarter keeps the segment within the total.\n    13\t- **D. The link did the work (linked arm):** matching chose \"v9 reads v14\", the writer committed it at seq 148, and v9 used v14's\n    14\t  forecast in its calculation or as a stated bound; delivery and use of the Bloomberg-compiled $393B (e195) recorded separately; a\n    15\t  mention or citation alone earns no credit.\n    16\t- **Pass:** at least two of three linked sequences meet A–D; at most one control meets A–C; no first-attempt refusal added and no new\n    17\t  material grounding error on either question across 07-10..07-12 (relabelling a system forecast as a market estimate, or treating\n    18\t  $393B as a Data Center consensus, is one). **Inconclusive:** two or more controls reconcile, fewer than two comparable sequences in\n    19\t  either arm, or a ceiling stop. **Fail:** a new material error, an added refusal, fewer than two correct link selections, or any other\n    20\t  miss. Failures take precedence.\n    21\t- **Readers:** Claude's marks written first, then a fresh blind Codex reader on the six sequences under shuffled labels, the key outside\n    22\t  the repository; every sequence reported.\n     1\t{\n     2\t \"control-A\": {\n     3\t  \"not stopped\": true,\n     4\t  \"all target judgements fresh\": true,\n     5\t  \"each later request carries its own previous answer\": true,\n     6\t  \"v14 judged each day\": true,\n     7\t  \"v9 days\": [\n     8\t   \"2026-07-10\",\n     9\t   \"2026-07-12\"\n    10\t  ],\n    11\t  \"no link\": true,\n    12\t  \"v9 only on the stored days\": true\n    13\t },\n    14\t \"control-B\": {\n    15\t  \"not stopped\": true,\n    16\t  \"all target judgements fresh\": true,\n    17\t  \"each later request carries its own previous answer\": true,\n    18\t  \"v14 judged each day\": true,\n    19\t  \"v9 days\": [\n    20\t   \"2026-07-10\",\n    21\t   \"2026-07-12\"\n    22\t  ],\n    23\t  \"no link\": true,\n    24\t  \"v9 only on the stored days\": true\n    25\t },\n    26\t \"linked-A\": {\n    27\t  \"not stopped\": true,\n    28\t  \"all target judgements fresh\": true,\n    29\t  \"each later request carries its own previous answer\": true,\n    30\t  \"v14 judged each day\": true,\n    31\t  \"v9 days\": [\n    32\t   \"2026-07-10\",\n    33\t   \"2026-07-11\",\n    34\t   \"2026-07-12\"\n    35\t  ],\n    36\t  \"link written\": true,\n    37\t  \"v8 block in v9 requests\": true,\n    38\t  \"v9 queued by a changed v14 only\": true\n    39\t },\n    40\t \"linked-B\": {\n    41\t  \"not stopped\": true,\n    42\t  \"all target judgements fresh\": true,\n    43\t  \"each later request carries its own previous answer\": true,\n    44\t  \"v14 judged each day\": true,\n    45\t  \"v9 days\": [\n    46\t   \"2026-07-10\",\n    47\t   \"2026-07-12\"\n    48\t  ],\n    49\t  \"link written\": true,\n    50\t  \"v8 block in v9 requests\": true,\n    51\t  \"v9 queued by a changed v14 only\": true\n    52\t },\n    53\t \"stop: unapproved judge request\": true,\n    54\t \"stop: link request at another seq\": true,\n    55\t \"stop: out-of-pair link\": true\n    56\t}\nviews: rebuilt 13 stored 13 equal\nview_keys: rebuilt 13 stored 13 equal\nevidence: rebuilt 194 stored 194 equal\nevidence_links: rebuilt 232 stored 232 equal\njudgements: rebuilt 55 stored 55 equal\nrungs: rebuilt 44 stored 44 equal\nview_switches: rebuilt 13 stored 13 equal\nsuccessions: rebuilt 0 stored 0 equal\ndependencies: rebuilt 0 stored 0 equal\nlink questions asked before 07-10 (answered neither): 3 eligible pairs: [('gnews:4d1677af37befd53ca3e7b45#1', 'c1', 'v1'), ('gnews:2f953a56cd06571ab0afc348#1', 'c1', 'v1'), ('gnews:2f953a56cd06571ab0afc348#1', 'c1', 'v2'), ('gnews:25d0b1d2a9dfe0bb99432e1a#1', 'c1', 'v8'), ('gnews:25d0b1d2a9dfe0bb99432e1a#1', 'c1', 'v1'), ('gnews:25d0b1d2a9dfe0bb99432e1a#1', 'c1', 'v2')]\ncontrol  [filing narrows a reads link]: exit 0 1 passed, 28 deselected in 0.11s\nmutant   [filing narrows a reads link]: exit 1 CAUGHT 1 failed, 28 deselected in 0.15s\ncontrol  [links asked under the jev engine]: exit 0 1 passed, 28 deselected in 0.12s\nmutant   [links asked under the jev engine]: exit 1 CAUGHT 1 failed, 28 deselected in 0.15s\ncontrol  [an existing reader is not queued]: exit 0 2 passed, 27 deselected in 0.14s\nmutant   [an existing reader is not queued]: exit 1 CAUGHT 2 failed, 27 deselected in 0.18s\ncontrol  [an ordinary replay writes a harness ledger]: exit 0 1 passed, 28 deselected in 0.17s\nmutant   [an ordinary replay writes a harness ledger]: exit 1 CAUGHT 1 failed, 28 deselected in 0.22s\ncontrol  [the sign is ignored in the label]: exit 0 1 passed, 28 deselected in 0.08s\nmutant   [the sign is ignored in the label]: exit 1 CAUGHT 1 failed, 28 deselected in 0.12s\ncontrol  [the circle check reads stored links only]: exit 0 2 passed, 27 deselected in 0.14s\nmutant   [the circle check reads stored links only]: exit 1 CAUGHT 2 failed, 27 deselected in 0.35s\ncontrol  [a correction keeps the offending direction]: exit 0 1 passed, 28 deselected in 0.12s\nmutant   [a correction keeps the offending direction]: exit 1 CAUGHT 1 failed, 28 deselected in 0.15s\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_7","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba tests/test_links.py | sed -n '150,460p'\nnl -ba src/hivemind/views/writing.py | sed -n '106,184p'\nnl -ba src/hivemind/views/judging.py | sed -n '113,225p'\nnl -ba src/hivemind/views/store.py | sed -n '132,163p;229,270p'\nnl -ba scripts/replay.py | sed -n '48,112p'\nnl -ba src/hivemind/research_context.py | sed -n '26,50p'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba tests/test_links.py | sed -n '150,460p'\nnl -ba src/hivemind/views/writing.py | sed -n '106,184p'\nnl -ba src/hivemind/views/judging.py | sed -n '113,225p'\nnl -ba src/hivemind/views/store.py | sed -n '132,163p;229,270p'\nnl -ba scripts/replay.py | sed -n '48,112p'\nnl -ba src/hivemind/research_context.py | sed -n '26,50p'\"","aggregated_output":"   150\t    yes_no = [{'label': 'Yes', 'condition': 'yes', 'lo': None, 'hi': None}, {'label': 'No', 'condition': 'no', 'lo': None, 'hi': None}]\n   151\t    thesis_key = dict(KEY, measure='event', event_type='deployment') if change == 'thesis_event' else KEY\n   152\t    conn = ledger(tmp_path, [('v1', thesis_key, RUNGS, 'Data Center revenue FY2027?')])\n   153\t    over = {'theme': {'kind': 'theme'}, 'two_rungs': {'rungs': yes_no}, 'event': {'measure': 'event', 'event_type': 'deployment'}}.get(change, {})\n   154\t    total = candidate('c1', question='Total revenue FY2027?', **dict(TOTAL, **{'rungs': TOTAL_RUNGS, **over}))\n   155\t    checked = checked_new('c1', outcome='merge', target='v1') if change == 'merged' else checked_new('c1')\n   156\t    transport = recording({})\n   157\t    proposed, _ = links.choose(model.Archive(str(tmp_path / 'a.sqlite')), CFG, conn, handover_of(total), checked,\n   158\t                               matching.Lists({'c1': ['v1']}, {}), [], transport=transport)\n   159\t    assert proposed == [] and link_questions(transport.sent) == []\n   160\t\n   161\t\n   162\tdef test_two_candidates_of_one_question_are_asked_once(tmp_path):\n   163\t    conn = ledger(tmp_path, [('v1', KEY, RUNGS, 'Data Center revenue FY2027?')])\n   164\t    first = candidate('c1', rungs=TOTAL_RUNGS, question='Total revenue FY2027?', **TOTAL)\n   165\t    second = candidate('c2', rungs=TOTAL_RUNGS, question='Total company revenue in FY2027?', **TOTAL)\n   166\t    transport = recording({'reads__v1': (links.THESIS_READS, 0.8), 'sign__v1': (links.TOGETHER, 0.8)})\n   167\t    links.choose(model.Archive(str(tmp_path / 'a.sqlite')), CFG, conn, handover_of(first, second), checked_new('c1', 'c2'),\n   168\t                 matching.Lists({'c1': ['v1'], 'c2': ['v1']}, {}), [], transport=transport)\n   169\t    assert link_questions(transport.sent) == ['reads__v1', 'sign__v1']\n   170\t\n   171\t\n   172\t# ---------- §4, test 3: the graph and the correction ----------\n   173\t\n   174\tdef stored_link(conn, reader, read):\n   175\t    store.insert(conn, 'dependencies', view_id=reader, depends_on=read, wait_chain_view_id='', wait_year='', direction='first_is_bullish', seq=1, kind=links.KIND)\n   176\t    conn.commit()\n   177\t\n   178\t\n   179\tdef two_totals(tmp_path):\n   180\t    return ledger(tmp_path, [('v1', TOTAL, TOTAL_RUNGS, 'Total revenue FY2027?'), ('v2', dict(TOTAL, period_start='2027-02-01', period_end='2028-01-31'), TOTAL_RUNGS, 'Total revenue FY2028?')])\n   181\t\n   182\t\n   183\tdef test_a_circle_through_a_stored_link_is_corrected_once(tmp_path):\n   184\t    conn = two_totals(tmp_path)\n   185\t    stored_link(conn, 'v2', 'v1')                                     # v2 reads v1\n   186\t    dc = candidate('c1', question='Data Center revenue FY2027?')\n   187\t    # c1 reads v2 and v1 reads c1 close c1 -> v2 -> v1 -> c1; each correction answers neither\n   188\t    first = recording({'reads__v1': (links.THESIS_READS, 0.8), 'reads__v2': (links.CANDIDATE_READS, 0.8),\n   189\t                       'sign__v1': (links.TOGETHER, 0.8), 'sign__v2': (links.TOGETHER, 0.8)})\n   190\t    correction = scripted({'reads__v1': (links.NEITHER, 0.9), 'reads__v2': (links.NEITHER, 0.9)})\n   191\t\n   192\t    def transport(request):\n   193\t        if any('read itself' in q['instructions'] for q in request['questions'].values()):\n   194\t            first.sent.append(request)\n   195\t            return correction(request)\n   196\t        return first(request)\n   197\t    transport.sent = first.sent\n   198\t    proposed, record = links.choose(model.Archive(str(tmp_path / 'a.sqlite')), CFG, conn, handover_of(dc), checked_new('c1'),\n   199\t                                    matching.Lists({'c1': ['v1', 'v2']}, {}), [], transport=transport)\n   200\t    corrections = [r for r in record['corrections'] if 'rejected' in r]\n   201\t    assert {r['thesis'] for r in corrections} == {'v1', 'v2'} and all(r['path'][0] == r['path'][-1] for r in corrections)\n   202\t    assert proposed == [] and links.circles(conn, proposed) == []\n   203\t    correction_requests = [q for request in transport.sent for q in request['questions'].values() if 'read itself' in q['instructions']]\n   204\t    assert correction_requests and all(len(q['criteria']) == 2 for q in correction_requests)        # the offending direction removed\n   205\t\n   206\t\n   207\tdef test_a_circle_through_two_openings_is_found_and_a_persistent_one_fails(tmp_path):\n   208\t    conn = ledger(tmp_path, [('v1', TOTAL, TOTAL_RUNGS, 'Total revenue FY2027?'), ('v2', dict(KEY, scope='Networking'), RUNGS, 'Networking revenue FY2027?')])\n   209\t    a = candidate('c1', question='Data Center revenue FY2027?')\n   210\t    b = candidate('c2', question='Gaming revenue FY2027?', **dict(KEY, scope='Gaming'))\n   211\t    # c1 -> v1 -> c2 -> v2 -> c1, no stored path; every correction flips the pair, which closes the reverse circle\n   212\t    script = {('Data Center', 'reads__v1'): (links.CANDIDATE_READS, 0.8), ('Data Center', 'reads__v2'): (links.THESIS_READS, 0.8),\n   213\t              ('Gaming', 'reads__v1'): (links.THESIS_READS, 0.8), ('Gaming', 'reads__v2'): (links.CANDIDATE_READS, 0.8),\n   214\t              'sign__v1': (links.TOGETHER, 0.8), 'sign__v2': (links.TOGETHER, 0.8)}\n   215\t    flipped = dict(script)\n   216\t\n   217\t    def transport(request):\n   218\t        if any('read itself' in q['instructions'] for q in request['questions'].values()):\n   219\t            answers = {}\n   220\t            for qid, q in request['questions'].items():\n   221\t                remaining = [k for k in q['criteria'] if k != links.NEITHER][0]\n   222\t                answers[qid] = {'type': 'choice', 'choice': remaining, 'confidence': 0.8,\n   223\t                                'probabilities': {k: (0.8 if k == remaining else 0.2) for k in q['criteria']}}\n   224\t            return {'model': request['model'], 'answers': answers, 'usage': {'input_tokens': 10, 'output_tokens': 5}}\n   225\t        return scripted(flipped)(request)\n   226\t    with pytest.raises(links.Refused) as refused:\n   227\t        links.choose(model.Archive(str(tmp_path / 'a.sqlite')), CFG, conn, handover_of(a, b), checked_new('c1', 'c2'),\n   228\t                     matching.Lists({'c1': ['v1', 'v2'], 'c2': ['v1', 'v2']}, {}), [], transport=transport)\n   229\t    assert refused.value.record['error'].startswith('persistent cycle')\n   230\t\n   231\t\n   232\tdef test_a_store_with_an_unbound_wait_is_refused_and_a_bound_wait_counts_through_its_target(tmp_path):\n   233\t    conn = two_totals(tmp_path)\n   234\t    store.insert(conn, 'dependencies', view_id='v1', depends_on='', wait_chain_view_id='v2', wait_year='FY2029', direction='same', seq=1)\n   235\t    conn.commit()\n   236\t    dc = candidate('c1', question='Data Center revenue FY2027?')\n   237\t    with pytest.raises(links.Refused):\n   238\t        links.choose(model.Archive(str(tmp_path / 'a.sqlite')), CFG, conn, handover_of(dc), checked_new('c1'),\n   239\t                     matching.Lists({'c1': ['v1']}, {}), [], transport=recording({}))\n   240\t    dependency_id = conn.execute('select dependency_id from dependencies').fetchone()[0]\n   241\t    store.insert(conn, 'dependency_resolutions', dependency_id=dependency_id, resolved_to='v2', reason='waited year created', seq=1)\n   242\t    conn.commit()\n   243\t    assert links.unbound_waits(conn) == 0\n   244\t    assert links.circles(conn, [{'reader': 'v2', 'read': 'c1'}, {'reader': 'c1', 'read': 'v1'}]) != []   # v1 -> v2 through the bound wait\n   245\t\n   246\t\n   247\t# ---------- §4, test 4: the writer ----------\n   248\t\n   249\tdef write_with(conn, proposed, *handover_candidates, seq=2):\n   250\t    conn.execute('begin immediate')\n   251\t    written = writing.write(conn, UNIVERSE, seq, ITEM, handover_of(*handover_candidates), checked_new(*[c['id'] for c in handover_candidates]), {},\n   252\t                            proposed_links=proposed)\n   253\t    conn.commit()\n   254\t    return written\n   255\t\n   256\t\n   257\tdef test_an_existing_question_gains_a_reads_link_and_is_judged_that_day(tmp_path):\n   258\t    conn = ledger(tmp_path, [('v1', KEY, RUNGS, 'Data Center revenue FY2027?')])\n   259\t    total = candidate('c1', rungs=TOTAL_RUNGS, question='Total revenue FY2027?', **TOTAL)\n   260\t    written = write_with(conn, [{'reader': 'v1', 'read': 'c1', 'candidate': 'c1', 'thesis': 'v1', 'direction': links.THESIS_READS, 'sign': links.TOGETHER}], total)\n   261\t    new = written.new_views['c1']\n   262\t    row = conn.execute('select view_id, depends_on, direction, kind, seq from dependencies').fetchone()\n   263\t    assert tuple(row) == ('v1', new, 'first_is_bullish', 'reads', 2)\n   264\t    assert 'v1' in written.changed_views and written.links[0]['label'] == 'first_is_bullish'\n   265\t\n   266\t\n   267\tdef test_a_closed_endpoint_refuses_the_whole_write(tmp_path):\n   268\t    conn = ledger(tmp_path, [('v1', KEY, RUNGS, 'Data Center revenue FY2027?')])\n   269\t    store.insert(conn, 'view_switches', view_id='v1', open=0, reason='closed', by_whom='test', after_seq=1)\n   270\t    conn.commit()\n   271\t    total = candidate('c1', rungs=TOTAL_RUNGS, question='Total revenue FY2027?', **TOTAL)\n   272\t    with pytest.raises(writing.WriteConflict):\n   273\t        write_with(conn, [{'reader': 'v1', 'read': 'c1', 'candidate': 'c1', 'thesis': 'v1', 'direction': links.THESIS_READS, 'sign': links.TOGETHER}], total)\n   274\t    conn.rollback()\n   275\t    assert conn.execute(\"select count(*) from views where view_id != 'v1'\").fetchone()[0] == 0\n   276\t\n   277\t\n   278\t# ---------- §4, test 5: filing ----------\n   279\t\n   280\tdef test_a_reads_link_is_not_a_narrower_home_and_a_seed_row_still_is(tmp_path):\n   281\t    conn = two_totals(tmp_path)\n   282\t    stored_link(conn, 'v2', 'v1')\n   283\t    assert store.direct_parents(conn, 'v2') == []\n   284\t    assert extraction.narrowest_links(['v1', 'v2'], {'v2': store.direct_parents(conn, 'v2')}) == ['v1', 'v2']\n   285\t    store.insert(conn, 'dependencies', view_id='v1', depends_on='v2', wait_chain_view_id='', wait_year='', direction='last_end', seq=0)\n   286\t    conn.commit()\n   287\t    assert store.direct_parents(conn, 'v1') == ['v2']\n   288\t    assert extraction.narrowest_links(['v1', 'v2'], {'v1': store.direct_parents(conn, 'v1')}) == ['v1']\n   289\t\n   290\t\n   291\t# ---------- §3, test 6: what the judge is shown ----------\n   292\t\n   293\tdef judged(conn, view_id, seq, reference, implied, reasons='Reasons line one.', rung=3, changed=1):\n   294\t    store.insert(conn, 'judgements', view_id=view_id, seq=seq, input_id='day', rung=rung, reasons=reasons, cited_evidence_json='[]', cited_views_json='[]',\n   295\t                 pushes_json='[]', changed=changed, why_changed='', config_checksum='x', call_id=0, request_sha256='', publication_day='2026-05-19',\n   296\t                 theme_pushes_json='[]', reference=reference, implied_outcome=implied)\n   297\t    conn.commit()\n   298\t\n   299\t\n   300\tdef test_judging_v8_shows_the_comparison_point_and_forecast_and_v7_is_unchanged(tmp_path):\n   301\t    conn = ledger(tmp_path, [('v1', TOTAL, TOTAL_RUNGS, 'Total revenue FY2027?'), ('v2', KEY, RUNGS, 'Data Center revenue FY2027?')])\n   302\t    stored_link(conn, 'v2', 'v1')\n   303\t    judged(conn, 'v1', 1, 'Consensus is $393B.\\n- e1 [fact] not an item', 'About $387B:\\nQ4 $112B.', reasons='Reasons.\\n[Evidence in view]')\n   304\t    user8 = judging.build_prompt(conn, 'v2', 'judging-v8')[1]\n   305\t    block = user8.split('[Current conclusions of the theses it depends on]\\n', 1)[1].split('\\n\\n', 1)[0]\n   306\t    assert block.splitlines() == [\n   307\t        '- v1 (open; first_is_bullish) Total revenue FY2027?: now rung 3 Neutral, judged 2026-05-19',\n   308\t        '    Comparison point stated by that judgement: Consensus is $393B.',\n   309\t        '        - e1 [fact] not an item',\n   310\t        \"    The system's forecast for it (our own judgement, not evidence): About $387B:\",\n   311\t        '        Q4 $112B.',\n   312\t        '    Reasons (excerpt): Reasons.',\n   313\t        '        [Evidence in view]']\n   314\t    assert judging.evidence_shown_in(user8) == {'e2'}\n   315\t    user7 = judging.build_prompt(conn, 'v2', 'judging-v7')[1]\n   316\t    assert '- v1 (open; first_is_bullish) Total revenue FY2027?: now rung 3 Neutral; reasons: Reasons.\\n[Evidence in view]' in user7\n   317\t    assert judging.build_prompt(conn, 'v1', 'judging-v7') == judging.build_prompt(conn, 'v1', 'judging-v8')     # no link: byte-equal\n   318\t\n   319\t\n   320\tdef judge_transport(changed_by_view):\n   321\t    def transport(provider, request, *args, **kwargs):\n   322\t        view_id = request['messages'][-1]['content'].split(' ', 2)[1]\n   323\t        data = {'rung': 3, 'reference': 'r', 'implied_outcome': 'i', 'reasons': 'ok', 'cites': [], 'cites_views': [], 'pushes': [],\n   324\t                'changed': changed_by_view.get(view_id, False), 'why_changed': '', 'theme_pushes': []}\n   325\t        return {'choices': [{'message': {'content': json.dumps(data)}}], 'usage': {'prompt_tokens': 10, 'completion_tokens': 5}}\n   326\t    return transport\n   327\t\n   328\t\n   329\t@pytest.mark.parametrize('changed, queued', [(True, True), (False, False)])\n   330\tdef test_a_changed_read_conclusion_queues_its_reader_and_an_unchanged_one_does_not(tmp_path, changed, queued):\n   331\t    conn = ledger(tmp_path, [('v1', TOTAL, TOTAL_RUNGS, 'Total revenue FY2027?'), ('v2', KEY, RUNGS, 'Data Center revenue FY2027?')])\n   332\t    stored_link(conn, 'v2', 'v1')\n   333\t    judged(conn, 'v1', 1, 'old point', 'old forecast')\n   334\t    judged(conn, 'v2', 1, 'r', 'i')\n   335\t    results = judging.round_of_judgements(model.Archive(str(tmp_path / 'a.sqlite')), V119, conn, ['v1'], 5, {'input_id': 'day:2026-05-20', 'publication_day': '2026-05-20'},\n   336\t                                          transport=judge_transport({'v1': changed}))\n   337\t    assert [r['view_id'] for r in results] == (['v1', 'v2'] if queued else ['v1'])\n   338\t\n   339\t\n   340\t# ---------- §0, test 7: entry points ----------\n   341\t\n   342\tdef scripts_replay():\n   343\t    spec = importlib.util.spec_from_file_location('scripts_replay_under_test', os.path.join(ROOT, 'scripts', 'replay.py'))\n   344\t    module = importlib.util.module_from_spec(spec)\n   345\t    spec.loader.exec_module(module)\n   346\t    return module\n   347\t\n   348\t\n   349\tdef test_the_links_engine_loads_but_ordinary_launchers_refuse_it():\n   350\t    assert V119.matching.engine == links.ENGINE and V119.rejudging.prompt_version == 'judging-v8'\n   351\t    with pytest.raises(SystemExit):\n   352\t        scripts_replay().refuse_links_engine(V119)\n   353\t    scripts_replay().refuse_links_engine(V118)\n   354\t\n   355\t\n   356\tdef test_an_ordinary_replay_refuses_a_harness_only_ledger_before_routing(tmp_path):\n   357\t    conn = ledger(tmp_path, [('v1', KEY, RUNGS, 'Data Center revenue FY2027?')])\n   358\t    conn.execute('create table harness_only (name text, day text)')\n   359\t    conn.commit()\n   360\t    conn.close()\n   361\t    before = os.path.getmtime(tmp_path / 'views.sqlite')\n   362\t    run = subprocess.run([sys.executable, os.path.join(ROOT, 'scripts', 'replay.py'), '--from', '2026-05-20', '--until', '2026-05-20',\n   363\t                          '--views', str(tmp_path / 'views.sqlite'), '--archive', str(tmp_path / 'archive.sqlite'), '--workers', '1'],\n   364\t                         capture_output=True, text=True, cwd=str(tmp_path))\n   365\t    assert run.returncode != 0 and 'harness-only' in run.stderr\n   366\t    assert os.path.getmtime(tmp_path / 'views.sqlite') == before and not (tmp_path / 'archive.sqlite').exists()\n   367\t\n   368\t\n   369\t# ---------- §1, tests 2 and 8: the link step inside the article, and its record ----------\n   370\t\n   371\tdef run_article(tmp_path, cfg, script, conn):\n   372\t    total = candidate('c1', rungs=TOTAL_RUNGS, question='Total revenue FY2027?', looks_at='total revenue', **TOTAL)\n   373\t    transport = recording(dict({'rel__v1': ('different', 0.9)}, **script))\n   374\t    item = dict(ITEM, text='Total revenue guidance.', publication_day='2026-05-20')\n   375\t    result = rounds.run(conn, model.Archive(str(tmp_path / 'archive.sqlite')), cfg, UNIVERSE, item, 2, transport=transport,\n   376\t                        extractor=lambda *args, **kwargs: handover_of(total))\n   377\t    return result, transport\n   378\t\n   379\t\n   380\tdef test_the_article_writes_the_link_and_records_proposed_then_committed(tmp_path):\n   381\t    conn = ledger(tmp_path, [('v1', KEY, RUNGS, 'Data Center revenue FY2027?')])\n   382\t    result, transport = run_article(tmp_path, CFG, {'reads__v1': (links.THESIS_READS, 0.8), 'sign__v1': (links.TOGETHER, 0.8)}, conn)\n   383\t    assert result.failed == ''\n   384\t    assert [tuple(r) for r in conn.execute('select view_id, kind from dependencies')] == [('v1', 'reads')]\n   385\t    rows = conn.execute('select attempt_id, status, config_checksum, record_json from link_selections order by id').fetchall()\n   386\t    assert [(r[0], r[1]) for r in rows] == [(ITEM['input_id'] + '#1', 'proposed'), (ITEM['input_id'] + '#1', 'committed')]\n   387\t    assert rows[0][2] == CFG.checksum and json.loads(rows[1][3])['links'][0]['label'] == 'first_is_bullish'\n   388\t    written = json.loads(conn.execute(\"select reason from processing_steps where step='written'\").fetchone()[0])\n   389\t    assert 'v1' in written['changed']\n   390\t\n   391\t\n   392\tdef test_under_the_jev_engine_no_link_question_is_asked(tmp_path):\n   393\t    conn = ledger(tmp_path, [('v1', KEY, RUNGS, 'Data Center revenue FY2027?')])\n   394\t    result, transport = run_article(tmp_path, CFG_JEV, {'reads__v1': (links.THESIS_READS, 0.8), 'sign__v1': (links.TOGETHER, 0.8)}, conn)\n   395\t    assert result.failed == '' and link_questions(transport.sent) == []\n   396\t    assert conn.execute('select count(*) from dependencies').fetchone()[0] == 0\n   397\t    assert conn.execute('select count(*) from link_selections').fetchone()[0] == 0\n   398\t\n   399\t\n   400\tdef test_a_jev_failure_records_failed_alone_with_the_failing_request(tmp_path):\n   401\t    conn = ledger(tmp_path, [('v1', KEY, RUNGS, 'Data Center revenue FY2027?')])\n   402\t    total = candidate('c1', rungs=TOTAL_RUNGS, question='Total revenue FY2027?', looks_at='total revenue', **TOTAL)\n   403\t    inner = scripted({'rel__v1': ('different', 0.9)})\n   404\t\n   405\t    def transport(request):\n   406\t        if any(qid.startswith('reads__') for qid in request['questions']):\n   407\t            raise model.TransportError('Jev transport failed: URLError')\n   408\t        return inner(request)\n   409\t    item = dict(ITEM, text='Total revenue guidance.')\n   410\t    result = rounds.run(conn, model.Archive(str(tmp_path / 'archive.sqlite')), CFG, UNIVERSE, item, 2, transport=transport,\n   411\t                        extractor=lambda *args, **kwargs: handover_of(total))\n   412\t    assert result.failed.startswith('linking: link question failed')\n   413\t    rows = conn.execute('select status, record_json from link_selections').fetchall()\n   414\t    assert [r[0] for r in rows] == ['failed']\n   415\t    call = json.loads(rows[0][1])['calls'][0]\n   416\t    assert call['stage'] == 'reads' and len(call['request_sha256']) == 64 and 'error' in json.loads(rows[0][1])\n   417\t\n   418\t\n   419\tdef test_a_write_conflict_after_the_proposal_records_proposed_then_failed(tmp_path, monkeypatch):\n   420\t    conn = ledger(tmp_path, [('v1', KEY, RUNGS, 'Data Center revenue FY2027?')])\n   421\t    monkeypatch.setattr(links, 'label_for', lambda *args: None)           # the stored rungs give no label: the write refuses\n   422\t    result, _ = run_article(tmp_path, CFG, {'reads__v1': (links.THESIS_READS, 0.8), 'sign__v1': (links.TOGETHER, 0.8)}, conn)\n   423\t    assert result.failed.startswith('writing:')\n   424\t    assert [r[0] for r in conn.execute('select status from link_selections order by id')] == ['proposed', 'failed']\n   425\t    assert conn.execute('select count(*) from dependencies').fetchone()[0] == 0\n   106\t    return ''\n   107\t\n   108\t\n   109\tclass WriteConflict(ValueError):\n   110\t    \"\"\"The checked plan no longer fits the writable ledger; no partial write is retained.\"\"\"\n   111\t\n   112\t\n   113\tdef write(conn, universe, seq, item, handover, checked, second_pass, *, proposed_links=None):\n   114\t    \"\"\"Write atomically within the caller's transaction; the caller commits the completion marker with it. proposed_links: the reading\n   115\t    links the link step chose (views/links.py, D694), written after the new views exist; None writes none.\"\"\"\n   116\t    if not conn.in_transaction:\n   117\t        conn.execute('begin immediate')\n   118\t    conn.execute('savepoint view_write')\n   119\t    try:\n   120\t        store.ensure_writable_columns(conn)\n   121\t        result = _write(conn, universe, seq, item, handover, checked, second_pass)\n   122\t        if proposed_links:\n   123\t            result.links = _write_links(conn, seq, proposed_links, result)\n   124\t    except Exception:\n   125\t        conn.execute('rollback to view_write')\n   126\t        conn.execute('release view_write')\n   127\t        raise\n   128\t    conn.execute('release view_write')\n   129\t    return result\n   130\t\n   131\t\n   132\tdef _write_links(conn, seq, proposed_links, written):\n   133\t    \"\"\"D694, D695 (design §4): each proposed link resolved to stored ids, re-checked against the ledger as it stands inside this write\n   134\t    (both ends open, no circle, no other label on the same pair), labelled from the stored rungs, written with kind 'reads'. An existing\n   135\t    question that gains a link is judged in the day's round. Any mismatch refuses the whole write.\"\"\"\n   136\t    from . import links as _links\n   137\t    committed = []\n   138\t    for link in proposed_links:\n   139\t        reader, read = (written.new_views.get(link[end], link[end]) for end in ('reader', 'read'))\n   140\t        for end in (reader, read):\n   141\t            if not store.view(conn, end):\n   142\t                raise WriteConflict(f'link {link[\"reader\"]} -> {link[\"read\"]}: {end} was not opened')\n   143\t            if not store.is_open(conn, end):\n   144\t                raise WriteConflict(f'link {reader} -> {read}: {end} is closed')\n   145\t        label = _links.label_for(store.rungs_of(conn, reader), store.rungs_of(conn, read), link['sign'])\n   146\t        if label is None:\n   147\t            raise WriteConflict(f'link {reader} -> {read}: no label can be computed from the stored rungs')\n   148\t        existing = {r['direction'] for r in conn.execute('select direction from dependencies where view_id=? and depends_on=?', (reader, read))}\n   149\t        if existing and existing != {label}:\n   150\t            raise WriteConflict(f'link {reader} -> {read}: the pair already carries another label {sorted(existing)}')\n   151\t        if existing:\n   152\t            continue\n   153\t        if store.would_cycle(conn, reader, read):\n   154\t            raise WriteConflict(f'link {reader} -> {read}: would close a circle')\n   155\t        store.insert(conn, 'dependencies', view_id=reader, depends_on=read, wait_chain_view_id='', wait_year='', direction=label, seq=seq, kind=_links.KIND)\n   156\t        if reader not in written.new_views.values():\n   157\t            written.changed_views.add(reader)\n   158\t        committed.append({'reader': reader, 'read': read, 'label': label, 'sign': link['sign'], 'direction': link['direction']})\n   159\t    return committed\n   160\t\n   161\t\n   162\tdef _write(conn, universe, seq, item, handover, checked, second_pass):\n   163\t    \"\"\"second_pass: {(handover evidence id, view_id): (outcome, target_evidence_id, said_day)} for candidate-linked\n   164\t    evidence compared after the candidates' destinations were known (new views' evidence is simply new).\"\"\"\n   165\t    changed, notes, new_views, evidence_ids = set(), [], {}, {}\n   166\t    candidate_ids = {c['id'] for c in handover.candidates}\n   167\t    aliases, problems = identity.batch_plan(handover.candidates, checked.outcomes)\n   168\t    if problems:\n   169\t        raise WriteConflict('; '.join(problems))\n   170\t    created = {}\n   171\t    # 1. new views, themes first\n   172\t    order = sorted(handover.candidates, key=lambda c: 0 if c['kind'] == 'theme' else 1)\n   173\t    for c in order:\n   174\t        outcome, target, deps = checked.outcomes.get(c['id'], ('skip', None, []))\n   175\t        if outcome not in ('new', 'succession'):\n   176\t            continue\n   177\t        canonical = aliases[c['id']]\n   178\t        if canonical in created:\n   179\t            new_views[c['id']] = created[canonical]\n   180\t            continue\n   181\t        if store.exact_key_views(conn, c):\n   182\t            raise WriteConflict(f'candidate {c[\"id\"]}: existing exact identity requires matching')\n   183\t        object_id = universe.resolve(c['object'])\n   184\t        if outcome == 'succession' and target:\n   113\t                placed.add(view_id)\n   114\t                remaining.remove(view_id)\n   115\t                progressed = True\n   116\t        if not progressed:                 # a cycle slipped through: keep going in the given order\n   117\t            ordered.extend(remaining)\n   118\t            break\n   119\t    return ordered\n   120\t\n   121\t\n   122\tdef _indented(text, indent='        '):\n   123\t    \"\"\"A stored value inside a block: every continuation line indented, so no physical line can read as a header or a listed id.\"\"\"\n   124\t    return str(text).replace('\\r\\n', '\\n').replace('\\n', '\\n' + indent)\n   125\t\n   126\t\n   127\tdef _dependency_lines_full(conn, target, d, state, rung_label, tv, flag):\n   128\t    \"\"\"judging-v8 (D694, design §3): the read judgement's comparison point and the system's forecast in full, labelled as ours, beside\n   129\t    the reasons excerpt; the read question not judged yet shows only that.\"\"\"\n   130\t    if not state:\n   131\t        return [f'- {target} ({flag}; {d[\"direction\"]}) {tv[\"question\"]}: now not judged yet']\n   132\t    return [f'- {target} ({flag}; {d[\"direction\"]}) {tv[\"question\"]}: now rung {state[\"rung\"]} {rung_label}, judged {state[\"publication_day\"]}',\n   133\t            f'    Comparison point stated by that judgement: {_indented(state.get(\"reference\") or \"not stated\")}',\n   134\t            f'    The system\\'s forecast for it (our own judgement, not evidence): {_indented(state.get(\"implied_outcome\") or \"not stated\")}',\n   135\t            f'    Reasons (excerpt): {_indented((state.get(\"reasons\") or \"\")[:600])}']\n   136\t\n   137\t\n   138\tdef _lines_english(conn, view_id, v, rungs, pieces, deps, last, themes=(), hidden=0, full_dependencies=False):\n   139\t    \"\"\"hidden: how many pieces in force are not shown. full_dependencies: the judging-v8 dependency block.\"\"\"\n   140\t    lines = [f'Thesis {view_id} ({v[\"object_id\"]}, {v[\"kind\"]}, focus \"{v[\"looks_at\"]}\", {v[\"year\"] or \"\"}, due {v[\"due_day\"]}): {v[\"question\"]}',\n   141\t             'Ladder: ' + ' / '.join(f'rung {r[\"position\"]} {r[\"label\"]}: {r[\"condition\"]}' for r in rungs), '',\n   142\t             f'[Evidence in view under this thesis, {len(pieces)} items]']\n   143\t    if hidden:\n   144\t        lines.append(f'[Not shown: {hidden} more pieces in force, read in earlier judgements; the previous conclusion carries them]')\n   145\t    for p in pieces:\n   146\t        src = p['sources'][0] if p['sources'] else {}\n   147\t        lines.append(f'- {p[\"evidence_id\"]} [{p[\"tier\"]}; {p[\"speaker\"]}; original source {p[\"original_who\"]} {p[\"original_day\"]}; from {src.get(\"input_id\")} {src.get(\"publication_day\")}] {p[\"one_line\"]}\\n    Quote: {p[\"quote\"][:400]}')\n   148\t        if p.get('replaced'):\n   149\t            lines.append(f'    It replaces {p[\"replaced\"][\"evidence_id\"]} ({p[\"replaced\"][\"original_day\"]}): {p[\"replaced\"][\"one_line\"]}')\n   150\t        if p.get('same_as'):\n   151\t            lines.append(f'    Opinion, not verified: the matcher read this as the same claim as {\", \".join(p[\"same_as\"])}; the argument counts one claim, one more outlet.')\n   152\t        if p.get('revises'):\n   153\t            lines.append(f'    Opinion, not verified: the matcher read it as a later version of {p[\"revises\"][\"evidence_id\"]} ({p[\"revises\"][\"original_day\"]}); both are in force: {p[\"revises\"][\"one_line\"]}')\n   154\t    if deps:\n   155\t        lines.append('\\n[Current conclusions of the theses it depends on]')\n   156\t        for d in deps:\n   157\t            target = d['resolved_to']\n   158\t            if not target:\n   159\t                lines.append(f'- the {d[\"wait_year\"]} thesis on chain {d[\"wait_chain_view_id\"]}: not yet created ({d[\"direction\"]})')\n   160\t                continue\n   161\t            tv = store.view(conn, target)\n   162\t            state = store.current_state(conn, target)\n   163\t            flag = 'historical only' if d['resolution'] == 'history_only' else ('closed' if not store.is_open(conn, target) else 'open')\n   164\t            rung_label = store.rungs_of(conn, target)[state['rung'] - 1]['label'] if state else 'not judged yet'\n   165\t            if full_dependencies:\n   166\t                lines.extend(_dependency_lines_full(conn, target, d, state, rung_label, tv, flag))\n   167\t                continue\n   168\t            lines.append(f'- {target} ({flag}; {d[\"direction\"]}) {tv[\"question\"]}: now rung {state[\"rung\"] if state else \"-\"} {rung_label}; reasons: {(state or {}).get(\"reasons\", \"\")[:600]}')\n   169\t    if themes:\n   170\t        lines.append(f'\\n[Themes in force, {len(themes)}]')\n   171\t        for theme in themes:\n   172\t            tv, state = theme['view'], theme['state']\n   173\t            mark = f'; {UPDATED_MARK}' if theme['updated'] else ''\n   174\t            lines.append(f'- {theme[\"view_id\"]} ({tv[\"object_id\"]}, due {tv[\"due_day\"]}) {tv[\"question\"]}: now rung {state[\"rung\"]} {theme[\"rung_label\"]}; '\n   175\t                         f'judged {state[\"publication_day\"]}{mark}; reasons: {(state[\"reasons\"] or \"\")[:THEME_REASONS_CHARS]}')\n   176\t    if last:\n   177\t        lines.append(f'\\n[Previous conclusion, for comparison only] rung {last[\"rung\"]}; reasons: {last[\"reasons\"][:800]}')\n   178\t    else:\n   179\t        lines.append('\\n[Previous conclusion] none: this is the first judgement, so changed must be true.')\n   180\t    lines.append('\\nAnswer per the JSON schema. cites may name only the evidence ids listed above; '\n   181\t                 + ('cites_views only the dependency thesis ids listed above' if deps else 'cites_views must be empty: this thesis depends on no other thesis')\n   182\t                 + ('; theme_pushes only the theme ids listed above; a theme id goes only in theme_pushes, never in cites or cites_views' if themes else '') + '.')\n   183\t    return lines\n   184\t\n   185\t\n   186\tdef build_prompt(conn, view_id, prompt_version):\n   187\t    require_supported(prompt_version)\n   188\t    v = store.view(conn, view_id)\n   189\t    rungs = store.rungs_of(conn, view_id)\n   190\t    pieces, hidden = evidence_in_view(conn, view_id)\n   191\t    deps = store.dependencies_of(conn, view_id)\n   192\t    last = store.current_state(conn, view_id)\n   193\t    lines = _lines_english(conn, view_id, v, rungs, pieces, deps, last, themes_in_force(conn, view_id), hidden=hidden,\n   194\t                           full_dependencies=prompt_version in FULL_DEPENDENCY_BLOCK)\n   195\t    with open(config.prompt_path(prompt_version + '.txt'), encoding='utf-8') as handle:\n   196\t        return handle.read(), '\\n'.join(lines)\n   197\t\n   198\t\n   199\tdef retry_note(errors):\n   200\t    return '\\n\\nThe code returned the previous answer because: ' + '; '.join(errors) + '\\nCorrect it and answer again, citing only the listed ids.'\n   201\t\n   202\t\n   203\tdef themes_shown_in(request_text):\n   204\t    \"\"\"The theme ids of the block a request carried: the ids the answer may name, whatever the ledger says now.\"\"\"\n   205\t    block = request_text.split('\\n[Themes in force, ', 1)\n   206\t    return set(re.findall(r'^- (v\\d+) \\(', block[1].split('\\n\\n[', 1)[0], re.M)) if len(block) == 2 else set()\n   207\t\n   208\t\n   209\tdef evidence_shown_in(request_text):\n   210\t    \"\"\"The evidence ids the request listed: the ids the answer may cite and push.\"\"\"\n   211\t    block = request_text.split('\\n[Evidence in ', 1)\n   212\t    return set(re.findall(r'^- (e\\d+) \\[', block[1].split('\\n\\n[', 1)[0], re.M)) if len(block) == 2 else set()\n   213\t\n   214\t\n   215\tdef check_answer(conn, view_id, data, request_text=None):\n   216\t    \"\"\"request_text: the user message that was sent, so theme and evidence ids are checked against what it carried (a theme may have\n   217\t    closed or opened since); without it, against what the ledger would show now.\"\"\"\n   218\t    errors = []\n   219\t    shown = themes_shown_in(request_text) if request_text is not None else {theme['view_id'] for theme in themes_in_force(conn, view_id)}\n   220\t    named = []\n   221\t    for entry in data.get('theme_pushes', []):\n   222\t        if entry['view_id'] in named:\n   223\t            errors.append(f'{entry[\"view_id\"]} is named twice in theme_pushes')\n   224\t        elif entry['view_id'] not in shown:\n   225\t            errors.append(f'{entry[\"view_id\"]} is not a theme in force shown to {view_id}')\n   132\t    conn.execute('create index if not exists members_view on thesis_group_members(view_id)')\n   133\t    columns = {r[1] for r in conn.execute('pragma table_info(thesis_groups)')}\n   134\t    if 'aliases' not in columns:\n   135\t        conn.execute('alter table thesis_groups add column aliases text')\n   136\t    columns = {r[1] for r in conn.execute('pragma table_info(thesis_group_members)')}\n   137\t    if 'basis' not in columns:\n   138\t        conn.execute('alter table thesis_group_members add column basis text')\n   139\t\n   140\t\n   141\tdef ensure_writable_columns(conn):\n   142\t    \"\"\"Upgrade columns at a write boundary, including a legacy database restored into an open connection.\"\"\"\n   143\t    ensure_key_columns(conn)\n   144\t    ensure_group_tables(conn)\n   145\t    columns = {r[1] for r in conn.execute('pragma table_info(rungs)')}\n   146\t    for field in ('lo', 'hi'):\n   147\t        if field not in columns:\n   148\t            conn.execute(f'alter table rungs add column {field} real')\n   149\t    judgement_columns = {r[1] for r in conn.execute('pragma table_info(judgements)')}\n   150\t    if 'theme_pushes_json' not in judgement_columns:\n   151\t        conn.execute('alter table judgements add column theme_pushes_json text')     # D195: judgements written before the theme block read as []\n   152\t    for field in ('reference', 'implied_outcome'):\n   153\t        if field not in judgement_columns:\n   154\t            conn.execute(f'alter table judgements add column {field} text')        # D260: judgements written before the stance fields read as null\n   155\t    if 'kind' not in {r[1] for r in conn.execute('pragma table_info(dependencies)')}:\n   156\t        conn.execute(\"alter table dependencies add column kind text default ''\")   # D694: every row written before reads ''\n   157\t\n   158\t\n   159\tdef view_key(conn, view_id):\n   160\t    if not conn.execute('pragma table_info(view_keys)').fetchone():\n   161\t        return None\n   162\t    row = conn.execute('select * from view_keys where view_id=?', (view_id,)).fetchone()\n   163\t    if not row:\n   229\t    conn = sqlite3.connect(f'file:{real}?mode=ro', uri=True, timeout=READ_BUSY_TIMEOUT_SECONDS)\n   230\t    conn.row_factory = sqlite3.Row\n   231\t    return conn\n   232\t\n   233\t\n   234\tdef current_state(conn, view_id):\n   235\t    \"\"\"The latest judgement: rung, reasons, changed, seq and day, and its reference and implied outcome (D260) where the ledger has them.\"\"\"\n   236\t    columns = {r[1] for r in conn.execute('pragma table_info(judgements)')}\n   237\t    stance = ''.join(f', {field}' for field in ('reference', 'implied_outcome') if field in columns)\n   238\t    row = conn.execute(f'select judgement_id, rung, reasons, changed, seq, publication_day{stance} from judgements where view_id=? order by judgement_id desc limit 1', (view_id,)).fetchone()\n   239\t    return dict(row) if row else None\n   240\t\n   241\t\n   242\tdef dependencies_of(conn, view_id):\n   243\t    \"\"\"Each dependency with its current target: the resolved view, or the waiting chain and year.\"\"\"\n   244\t    out = []\n   245\t    for dep in conn.execute('select * from dependencies where view_id=? order by dependency_id', (view_id,)):\n   246\t        dep = dict(dep)\n   247\t        resolution = conn.execute('select resolved_to, reason from dependency_resolutions where dependency_id=? order by id desc limit 1', (dep['dependency_id'],)).fetchone()\n   248\t        if resolution:\n   249\t            dep['resolved_to'], dep['resolution'] = resolution['resolved_to'], resolution['reason']\n   250\t        else:\n   251\t            dep['resolved_to'], dep['resolution'] = dep['depends_on'], ('direct' if dep['depends_on'] else 'waiting')\n   252\t        out.append(dep)\n   253\t    return out\n   254\t\n   255\t\n   256\tdef direct_parents(conn, view_id, seq=None):\n   257\t    \"\"\"The views this view depends on directly (a driver's root, D208; the seeds' depends_on), written at or before `seq` when given.\n   258\t    The filing reads it to keep a statement under the narrower of two linked questions (D207's narrowest rule, extraction.file_reading).\"\"\"\n   259\t    reads = \" and coalesce(kind, '') != 'reads'\" if 'kind' in {r[1] for r in conn.execute('pragma table_info(dependencies)')} else ''\n   260\t    rows = conn.execute(f\"select depends_on from dependencies where view_id=? and depends_on != '' and (? is null or seq <= ?){reads} order by dependency_id\", (view_id, seq, seq))\n   261\t    return list(dict.fromkeys(r[0] for r in rows))\n   262\t\n   263\t\n   264\tdef dependants_of(conn, view_id):\n   265\t    direct = [r['view_id'] for r in conn.execute('select view_id from dependencies where depends_on=?', (view_id,))]\n   266\t    resolved = [r['view_id'] for r in conn.execute(\n   267\t        'select d.view_id from dependency_resolutions r join dependencies d on d.dependency_id=r.dependency_id where r.resolved_to=?', (view_id,))]\n   268\t    return sorted(set(direct + resolved))\n   269\t\n   270\t\n    48\t        raise SystemExit(f'cannot inspect existing ledger: {error}') from error\n    49\t\n    50\t\n    51\tdef refuse_harness_ledger(path):\n    52\t    \"\"\"A ledger marked harness-only (a `harness_only` table, D694's July test) is written by its harness alone; read-only inspection stays\n    53\t    open. Refused under any configuration, before any item is routed.\"\"\"\n    54\t    ledger = Path(path)\n    55\t    if not ledger.exists():\n    56\t        return\n    57\t    try:\n    58\t        with sqlite3.connect(ledger.resolve().as_uri() + '?mode=ro', uri=True) as conn:\n    59\t            marked = conn.execute(\"select count(*) from sqlite_master where type='table' and name='harness_only'\").fetchone()[0]\n    60\t    except sqlite3.Error as error:\n    61\t        raise SystemExit(f'cannot inspect existing ledger: {error}') from error\n    62\t    if marked:\n    63\t        raise SystemExit('this ledger is marked harness-only; an ordinary replay does not write it')\n    64\t\n    65\t\n    66\tdef refuse_links_engine(cfg):\n    67\t    \"\"\"D694: poc-v119's matching engine runs only in its July test harness in this version, not from an ordinary launcher.\"\"\"\n    68\t    if cfg.matching.engine == 'jev-links':\n    69\t        raise SystemExit(f'config {cfg.version}: matching engine jev-links is not a product entry point in this version (D694)')\n    70\t\n    71\t\n    72\tdef main():\n    73\t    parser = argparse.ArgumentParser()\n    74\t    parser.add_argument('--from', dest='from_day', required=True)\n    75\t    parser.add_argument('--until', dest='until_day', required=True)\n    76\t    parser.add_argument('--day0', default=None)\n    77\t    parser.add_argument('--testdb', default=os.path.join(ROOT, 'poc', 'data', 'items-nvda-2026-07-01-10-27.sqlite'))\n    78\t    parser.add_argument('--views', required=True, help='the ledger this run writes (a new run: a new dated folder)')\n    79\t    parser.add_argument('--archive', required=True, help='the model-call archive of this run')\n    80\t    parser.add_argument('--config', default=os.path.join(ROOT, 'poc', 'config', 'poc-v118.json'))\n    81\t    parser.add_argument('--universe', default=os.path.join(ROOT, 'poc', 'universe.json'))\n    82\t    parser.add_argument('--only', default=None, help='comma-separated object ids to restrict the stream to')\n    83\t    parser.add_argument('--cap', type=float, default=None, help='USD spend cap for this run')\n    84\t    parser.add_argument('--max-items-per-day', type=int, default=None)\n    85\t    parser.add_argument('--workers', type=int, default=16, help='extraction requests prepared at a time (D183); 1 is the serial path')\n    86\t    parser.add_argument('--jev-workers', type=int, default=None,\n    87\t                        help='Jev matching questions sent at a time when --workers > 1; default 8 for Jev, 1 for another engine')\n    88\t    args = parser.parse_args()\n    89\t    os.makedirs(os.path.dirname(args.views), exist_ok=True)\n    90\t    log_path = os.path.join(os.path.dirname(args.views), 'replay.log')\n    91\t\n    92\t    def log(*parts):\n    93\t        line = ' '.join(str(p) for p in parts)\n    94\t        print(line, flush=True)\n    95\t        with open(log_path, 'a', encoding='utf-8') as handle:\n    96\t            handle.write(line + '\\n')\n    97\t\n    98\t    cfg = config.load(args.config)\n    99\t    if cfg.baseline is not None:\n   100\t        raise SystemExit(f'config {cfg.version} uses retired seeded-question baseline; select a configuration without it')\n   101\t    refuse_links_engine(cfg)\n   102\t    refuse_seeded_ledger(args.views)\n   103\t    refuse_harness_ledger(args.views)\n   104\t    uni = universe.load(args.universe)\n   105\t    archive = model.Archive(args.archive)\n   106\t    day_runner = None\n   107\t    if args.workers > 1:\n   108\t        jev_workers = args.jev_workers if args.jev_workers is not None else (8 if cfg.matching.engine == 'jev' else 1)\n   109\t        day_runner = parallel_day.ParallelDay(os.path.abspath(args.testdb), os.path.join(os.path.dirname(os.path.abspath(args.views)), 'manifests'),\n   110\t                                              extraction_workers=args.workers, jev_workers=jev_workers)\n   111\t    log(f'--- replay {args.from_day}..{args.until_day} config {cfg.version}/{cfg.checksum} provider {cfg.provider} universe {uni.version}'\n   112\t        f' workers {args.workers}')\n    26\t        return self\n    27\t\n    28\t    def __exit__(self, *_):\n    29\t        self.db.close()\n    30\t\n    31\t    def rows(self, sql, args=()):\n    32\t        return [dict(r) for r in self.db.execute(sql, args)]\n    33\t\n    34\t    def dependencies(self, vid):\n    35\t        result = self.rows('select dependency_id, view_id, depends_on, wait_chain_view_id, wait_year, direction, seq from dependencies '\n    36\t                           'where view_id=? and seq<? order by seq,dependency_id', (vid,self.seq))     # the response shape kept as before D694's kind column\n    37\t        for dep in result:\n    38\t            res = self.rows('select * from dependency_resolutions where dependency_id=? and seq<? order by seq desc,id desc limit 1', (dep['dependency_id'],self.seq))\n    39\t            dep['resolved_to'] = res[0]['resolved_to'] if res else dep['depends_on']\n    40\t            dep['resolution'] = res[0] if res else None\n    41\t        return result\n    42\t\n    43\t    def question(self, row):\n    44\t        vid = row['view_id']\n    45\t        switches = self.rows('select * from view_switches where view_id=? and after_seq<? order by after_seq desc,id desc limit 1', (vid,self.seq))\n    46\t        if not switches:\n    47\t            raise ValueError('question has no historical open/closed state: ' + vid)\n    48\t        keys = self.rows('select * from view_keys where view_id=? and seq<?', (vid,self.seq))\n    49\t        return dict(row, open=bool(switches[0]['open']),\n    50\t                    rungs=self.rows('select * from rungs where view_id=? order by position', (vid,)),\n","exit_code":0,"status":"completed"}}
