{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba docs/research/2026-11-20-production-readiness/dependency-design/july_test.py | sed -n '292,430p'\"","aggregated_output":"   292\t    sys.path.insert(0, str(Path(__file__).parent))\n   293\t    import rebuild_control\n   294\t    equal = rebuild_control.compare(folder / 'views.sqlite', PREFIX_SEQ)\n   295\t    conn = sqlite3.connect(f'file:{folder / \"views.sqlite\"}?mode=ro', uri=True)\n   296\t    selections = [(a, s, json.loads(r)) for a, s, r in conn.execute('select attempt_id, status, record_json from link_selections order by id')]\n   297\t    pairs = [(a, p['candidate'], p['thesis']) for a, s, r in selections if s == 'proposed' for p in r['pairs'] if p.get('eligible') and 'thesis' in p]\n   298\t    print('link questions asked before 07-10 (answered neither):', len(asked), 'eligible pairs:', pairs)\n   299\t    return equal\n   300\t\n   301\t\n   302\tdef archive_proof(scratch):\n   303\t    folder = scratch / 'archive-proof'\n   304\t    folder.mkdir(parents=True, exist_ok=False)\n   305\t    shutil.copyfile(OLD2 / 'archive.sqlite', folder / 'archive.sqlite')\n   306\t    stored = sqlite3.connect(f'file:{OLD2 / \"archive.sqlite\"}?mode=ro', uri=True)\n   307\t    rows = {}\n   308\t    for call_id, request_json in stored.execute(\"select call_id, request_json from model_calls where purpose='judge' order by call_id\"):\n   309\t        view_id = judged_view(json.loads(request_json))\n   310\t        rows.setdefault(view_id, (call_id, json.loads(request_json)))\n   311\t    archive, retired, _ = retire_targets(folder / 'archive.sqlite')\n   312\t    sent = []\n   313\t\n   314\t    def recording(provider, request):\n   315\t        sent.append(judged_view(request))\n   316\t        data = {'rung': 0, 'reference': '', 'implied_outcome': '', 'reasons': '', 'cites': [], 'cites_views': [], 'pushes': [], 'changed': True,\n   317\t                'why_changed': '', 'theme_pushes': []}\n   318\t        return {'choices': [{'message': {'content': json.dumps(data)}}], 'usage': {'prompt_tokens': 1, 'completion_tokens': 1}}\n   319\t    cfg = config.load(str(V118))\n   320\t    results = {}\n   321\t    for view_id in ('v9', 'v14', 'v8'):\n   322\t        call_id, request = rows[view_id]\n   323\t        system, user = request['messages'][0]['content'], request['messages'][1]['content']\n   324\t        schema = request['response_format']['json_schema']['schema']\n   325\t        answer = model.call(archive, cfg, cfg.rejudging, system, user, schema, 'judgement', 'judge', transport=recording)\n   326\t        results[view_id] = {'sent to the transport': sent[-1:] == [view_id], 'call id kept': answer.cached and answer.call_id == call_id,\n   327\t                            'answer call id': answer.call_id}\n   328\t    archive.retire(results['v9']['answer call id'])           # as round_of_judgements retires an answer its check refuses\n   329\t    call_id, request = rows['v9']\n   330\t    before = len(sent)\n   331\t    model.call(archive, cfg, cfg.rejudging, request['messages'][0]['content'], request['messages'][1]['content'],\n   332\t               request['response_format']['json_schema']['schema'], 'judgement', 'judge', transport=recording)\n   333\t    proof = {'retired target rows': retired,\n   334\t             'an exact old v9 request goes to the transport': results['v9']['sent to the transport'],\n   335\t             'an exact old v14 request goes to the transport': results['v14']['sent to the transport'],\n   336\t             'an exact old v8 request is answered from the archive with its call id': results['v8']['call id kept'] and sent.count('v8') == 0,\n   337\t             'a retired (refused) answer is not returned again': len(sent) == before + 1}\n   338\t    print(json.dumps(proof, indent=1))\n   339\t    return all(v for k, v in proof.items() if isinstance(v, bool))\n   340\t\n   341\t\n   342\tdef price():\n   343\t    stored = sqlite3.connect(f'file:{OLD2 / \"archive.sqlite\"}?mode=ro', uri=True)\n   344\t    views = sqlite3.connect(f'file:{OLD2 / \"views.sqlite\"}?mode=ro', uri=True)\n   345\t    shas = [r[0] for r in views.execute(\"select request_sha256 from judgements where view_id in ('v9','v14') and publication_day between ? and ?\", WINDOW)]\n   346\t    price_in, price_out = model.PRICES['gpt-6-luna']\n   347\t    total, rows = 0.0, []\n   348\t    for sha in shas:\n   349\t        tokens_in, tokens_out = stored.execute('select input_tokens, output_tokens from model_calls where request_sha256=?', (sha,)).fetchone()\n   350\t        cost = tokens_in / 1e6 * price_in + tokens_out / 1e6 * price_out\n   351\t        rows.append((tokens_in, tokens_out, round(cost, 5)))\n   352\t        total += cost\n   353\t    print(json.dumps({'stored v9/v14 judge calls in the window': rows, 'one sequence (uncached)': round(total, 4),\n   354\t                      'six sequences': round(6 * total, 4), 'ceiling': CEILING}, indent=1))\n   355\t\n   356\t\n   357\tORDER = [('control-1', V118, False), ('linked-1', V119, True), ('control-2', V118, False), ('linked-2', V119, True),\n   358\t         ('control-3', V118, False), ('linked-3', V119, True)]       # alternated, so a ceiling stop falls on both arms alike\n   359\t\n   360\t\n   361\tdef send(prefix_ledger, out):\n   362\t    \"\"\"The paid comparison (run only after the council passed the $0 proof, D694 (c)): six sequences through the shared reservation ledger\n   363\t    of the comparison runs, one ceiling of $0.15; the ledger is read after each sequence, and a refused reservation or a stop makes the\n   364\t    comparison inconclusive and ends it.\"\"\"\n   365\t    import importlib.util\n   366\t    spec = importlib.util.spec_from_file_location('budget_replay', REPO / 'clean-arch/e2e-comparison-2026-11-13/budget_replay.py')\n   367\t    budget = importlib.util.module_from_spec(spec)\n   368\t    spec.loader.exec_module(budget)\n   369\t    out.mkdir(parents=True, exist_ok=False)\n   370\t    ledger_path = out / 'ledger.json'\n   371\t    budget.SharedLedger.init(str(ledger_path), CEILING)\n   372\t    ledger = budget.SharedLedger(str(ledger_path))\n   373\t    remove_gate = budget.install_stop_gate(ledger)\n   374\t    transport = budget.BudgetTransport(ledger)\n   375\t    results, outcome = [], 'complete'\n   376\t    with open(out / 'send.log', 'a', encoding='utf-8') as log_file:\n   377\t        def log(*parts):\n   378\t            log_file.write(' '.join(str(p) for p in parts) + '\\n')\n   379\t            log_file.flush()\n   380\t        try:\n   381\t            for name, cfg_path, linked in ORDER:\n   382\t                summary, _, _ = run_sequence(out, name, prefix_ledger, cfg_path, linked, transport, log)\n   383\t                state = ledger.read()\n   384\t                summary['ledger_after'] = state\n   385\t                results.append(summary)\n   386\t                log(f'{name}: stopped={summary[\"stopped\"]!r} spent ${state[\"spent\"]:.4f} reserved ${state[\"reserved\"]:.4f} refused {state[\"refused\"]}')\n   387\t                if state.get('stopped') or state.get('refused') or state.get('overrun'):\n   388\t                    outcome = 'inconclusive: the shared ledger stopped, refused or overran'\n   389\t                    break\n   390\t        finally:\n   391\t            remove_gate()\n   392\t    (out / 'send-summary.json').write_text(json.dumps({'outcome': outcome, 'ledger': ledger.read(), 'sequences': results}, indent=1, ensure_ascii=False))\n   393\t    print(outcome, ledger.read())\n   394\t\n   395\t\n   396\tif __name__ == '__main__':\n   397\t    mode, scratch = sys.argv[1], Path(sys.argv[2])\n   398\t    scratch.mkdir(parents=True, exist_ok=True)\n   399\t    if mode == 'prefix':\n   400\t        sys.exit(0 if prefix(scratch) else 1)\n   401\t    if mode == 'archive':\n   402\t        sys.exit(0 if archive_proof(scratch) else 1)\n   403\t    if mode == 'dry':\n   404\t        sys.exit(0 if dry(scratch, Path(sys.argv[3])) else 1)\n   405\t    if mode == 'price':\n   406\t        price()\n   407\t        sys.exit(0)\n   408\t    if mode == 'send':\n   409\t        send(Path(sys.argv[3]), Path(sys.argv[4]))\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba clean-arch/e2e-comparison-2026-11-13/budget_replay.py | sed -n '40,290p'\"","aggregated_output":"    40\t\n    41\tCLIENT_ERRORS = {400, 401, 403, 404}\n    42\t# How many reservations the calling thread holds and has not settled (the interception proofs read it). One object per process, kept in\n    43\t# sys.modules, because each component loads this file under its own module object.\n    44\t_MARK = sys.modules.setdefault('hivemind_shared_ledger_live_mark', types.ModuleType('hivemind_shared_ledger_live_mark'))\n    45\tif not hasattr(_MARK, 'local'):\n    46\t    _MARK.local = threading.local()\n    47\t_LIVE = _MARK.local\n    48\t\n    49\t\n    50\tdef holds_live_reservation():\n    51\t    \"\"\"Whether the calling thread holds a reservation it has not yet settled (WIRING-DESIGN.md §B2, the interception trap).\"\"\"\n    52\t    return getattr(_LIVE, 'depth', 0) > 0\n    53\t\n    54\t\n    55\tdef lock_is_free(lock_path):\n    56\t    \"\"\"Whether no process holds the lock file: a shared, non-blocking flock succeeds only when no exclusive holder is alive.\"\"\"\n    57\t    try:\n    58\t        with open(lock_path, 'a') as handle:\n    59\t            try:\n    60\t                fcntl.flock(handle, fcntl.LOCK_SH | fcntl.LOCK_NB)\n    61\t            except BlockingIOError:\n    62\t                return False\n    63\t            fcntl.flock(handle, fcntl.LOCK_UN)\n    64\t            return True\n    65\t    except OSError:\n    66\t        return True\n    67\t\n    68\t\n    69\tdef install_stop_gate(ledger):\n    70\t    \"\"\"Process-wide: every `urllib.request.urlopen` call, a helper's internal retry included, first reads the shared ledger. When it is\n    71\t    stopped, or when a registered launcher's lock is free (that launcher died without removing its entry: the gate then stops the\n    72\t    ledger), the call is refused as HTTP 403 (no component retries a 403) and nothing is sent. An attempt whose read came before a stop\n    73\t    was written may finish; one that reads after it is refused. Returns a function that removes the gate.\"\"\"\n    74\t    original = urllib.request.urlopen\n    75\t\n    76\t    def gated(request, *arguments, **keywords):\n    77\t        state = ledger.stop_if_a_launcher_is_gone()\n    78\t        if state.get('stopped'):\n    79\t            raise urllib.error.HTTPError(getattr(request, 'full_url', str(request)), 403,\n    80\t                                         f\"the shared ledger is stopped ({state.get('stop_reason')}): not sent\", {},\n    81\t                                         io.BytesIO(b'{\"error\": {\"type\": \"shared_ledger_stopped\"}}'))\n    82\t        return original(request, *arguments, **keywords)\n    83\t    urllib.request.urlopen = gated\n    84\t\n    85\t    def remove():\n    86\t        if urllib.request.urlopen is gated:\n    87\t            urllib.request.urlopen = original\n    88\t    return remove\n    89\t\n    90\t\n    91\tclass SharedLedger:\n    92\t    \"\"\"One JSON ledger for every run under a ceiling, guarded by an exclusive file lock (processes and threads). The first refused\n    93\t    reservation, or an explicit `stop`, persists `stopped` with its reason under the lock: every later reservation, in any thread or\n    94\t    process, is refused (WIRING-DESIGN.md §B2, D448).\"\"\"\n    95\t\n    96\t    def __init__(self, path):\n    97\t        self.path = Path(path)\n    98\t        self.lock_path = self.path.with_suffix('.lock')\n    99\t        self.attempts_path = self.path.with_suffix('.attempts.jsonl')   # one line per settled or refused attempt: the measurement record\n   100\t\n   101\t    def _note(self, entry):\n   102\t        \"\"\"Append one attempt line (the process, the call kind, the amounts, the tokens when reported, the moment) for per-component\n   103\t        spend and timing. Written only after the ledger's state is saved, and best-effort: a failed append never blocks a stop, a charge\n   104\t        or an overrun. A crash between the two writes leaves the lines short of the ledger, never ahead of it; the tally reports the gap\n   105\t        as unaccounted. One short append, so concurrent lines do not interleave.\"\"\"\n   106\t        line = json.dumps(dict(entry, pid=os.getpid(), at=time.strftime('%Y-%m-%dT%H:%M:%S%z'))) + '\\n'\n   107\t        try:\n   108\t            with open(self.attempts_path, 'a') as handle:\n   109\t                handle.write(line)\n   110\t        except OSError:\n   111\t            pass\n   112\t\n   113\t    @contextlib.contextmanager\n   114\t    def _locked(self):\n   115\t        with open(self.lock_path, 'a+') as lock:\n   116\t            fcntl.flock(lock, fcntl.LOCK_EX)\n   117\t            try:\n   118\t                state = json.loads(self.path.read_text())\n   119\t                yield state\n   120\t                temporary = self.path.with_suffix('.tmp')\n   121\t                temporary.write_text(json.dumps(state, indent=1))\n   122\t                os.replace(temporary, self.path)          # a reader never sees a half-written ledger\n   123\t            finally:\n   124\t                fcntl.flock(lock, fcntl.LOCK_UN)\n   125\t\n   126\t    @staticmethod\n   127\t    def init(path, ceiling):\n   128\t        Path(path).write_text(json.dumps({'ceiling': ceiling, 'spent': 0.0, 'reserved': 0.0, 'overrun': False, 'refused': 0, 'attempts': 0,\n   129\t                                          'stopped': False, 'stop_reason': None}, indent=1))\n   130\t\n   131\t    def reserve(self, amount):\n   132\t        with self._locked() as state:\n   133\t            granted = not (state.get('stopped') or state['overrun'] or state['spent'] + state['reserved'] + amount > state['ceiling'])\n   134\t            if granted:\n   135\t                state['reserved'] += amount\n   136\t                state['attempts'] += 1\n   137\t            else:\n   138\t                state['refused'] += 1\n   139\t                if not state.get('stopped'):\n   140\t                    state['stopped'] = True\n   141\t                    state['stop_reason'] = 'overrun' if state['overrun'] else f'a reservation of ${amount:.6f} would pass the ${state[\"ceiling\"]:.2f} ceiling'\n   142\t        if not granted:\n   143\t            self._note({'refused': amount})                  # after the stop is saved\n   144\t            return False\n   145\t        _LIVE.depth = getattr(_LIVE, 'depth', 0) + 1\n   146\t        return True\n   147\t\n   148\t    @staticmethod\n   149\t    def estimate(request):\n   150\t        \"\"\"The shared reservation of one language-model attempt (WIRING-DESIGN.md §B): `llm_estimate`.\"\"\"\n   151\t        return llm_estimate(request)\n   152\t\n   153\t    def settle(self, reserved, actual, kind='llm', tokens=None):\n   154\t        \"\"\"Settle one attempt. A missing, non-finite, zero or negative charge settles at the whole reservation: an answered paid\n   155\t        request never costs nothing, and a failed attempt is charged its reservation. `kind` (llm, jev, embeddings) and the reported\n   156\t        `tokens` go to the attempt line only.\"\"\"\n   157\t        _LIVE.depth = max(0, getattr(_LIVE, 'depth', 0) - 1)\n   158\t        if not isinstance(actual, (int, float)) or isinstance(actual, bool) or not math.isfinite(actual) or actual <= 0:\n   159\t            actual = reserved\n   160\t        with self._locked() as state:\n   161\t            state['reserved'] = max(0.0, state['reserved'] - reserved)\n   162\t            state['spent'] += actual\n   163\t            if actual > reserved + 1e-12:\n   164\t                state['overrun'] = True\n   165\t                if not state.get('stopped'):\n   166\t                    state['stopped'], state['stop_reason'] = True, 'overrun'\n   167\t        self._note({'kind': kind, 'reserved': reserved, 'charged': actual, **({'tokens': tokens} if tokens is not None else {})})\n   168\t\n   169\t    def stop_if_a_launcher_is_gone(self):\n   170\t        \"\"\"Under the ledger's lock: a registered launcher whose lock no process holds died without removing its entry; the ledger is\n   171\t        stopped. A relaunch calls this before it takes its own lock, so its new lock never makes a stale entry look alive; the stop gate\n   172\t        calls it before every send. Returns the state after the check.\"\"\"\n   173\t        with self._locked() as state:\n   174\t            if not state.get('stopped'):\n   175\t                for label, lock_path in sorted((state.get('launchers') or {}).items()):\n   176\t                    if lock_is_free(lock_path):\n   177\t                        state['stopped'], state['stop_reason'] = True, f'the launcher of {label} is gone'\n   178\t                        break\n   179\t            return dict(state)\n   180\t\n   181\t    def claim_launcher(self, label, lock_handle):\n   182\t        \"\"\"One step under the ledger's lock (council mo, D449): stop the ledger if any registered launcher's lock is free; try the\n   183\t        launcher's own lock without blocking (False: another launch of this label is running); if this label is still registered once\n   184\t        its lock is held, the previous launcher died without removing its entry, so the ledger stops; then register. The stop gate's\n   185\t        probe takes the same lock, so no send can see a stale entry as alive while a new launcher takes its lock.\"\"\"\n   186\t        with self._locked() as state:\n   187\t            launchers = state.setdefault('launchers', {})\n   188\t            if not state.get('stopped'):\n   189\t                for other, lock_path in sorted(launchers.items()):\n   190\t                    if lock_is_free(lock_path):\n   191\t                        state['stopped'], state['stop_reason'] = True, f'the launcher of {other} is gone'\n   192\t                        break\n   193\t            try:\n   194\t                fcntl.flock(lock_handle, fcntl.LOCK_EX | fcntl.LOCK_NB)\n   195\t            except BlockingIOError:\n   196\t                return False\n   197\t            if label in launchers and not state.get('stopped'):\n   198\t                state['stopped'], state['stop_reason'] = True, f'the launcher of {label} is gone'\n   199\t            launchers[label] = os.path.abspath(lock_handle.name)\n   200\t            return True\n   201\t\n   202\t    def register_launcher(self, label, lock_path):\n   203\t        \"\"\"Register a launcher's lock path (tests and proofs; a launcher uses `claim_launcher`).\"\"\"\n   204\t        with self._locked() as state:\n   205\t            state.setdefault('launchers', {})[label] = str(lock_path)\n   206\t\n   207\t    def remove_launcher(self, label):\n   208\t        \"\"\"Called by a launcher on a normal end, before it releases its lock.\"\"\"\n   209\t        with self._locked() as state:\n   210\t            (state.get('launchers') or {}).pop(label, None)\n   211\t\n   212\t    def stop(self, reason):\n   213\t        \"\"\"A stop any component records: every later reservation is refused.\"\"\"\n   214\t        with self._locked() as state:\n   215\t            if not state.get('stopped'):\n   216\t                state['stopped'], state['stop_reason'] = True, reason\n   217\t\n   218\t    def read(self):\n   219\t        with open(self.lock_path, 'a+') as lock:\n   220\t            fcntl.flock(lock, fcntl.LOCK_EX)\n   221\t            try:\n   222\t                return json.loads(self.path.read_text())\n   223\t            finally:\n   224\t                fcntl.flock(lock, fcntl.LOCK_UN)\n   225\t\n   226\t\n   227\tdef llm_estimate(request):\n   228\t    price_in, price_out = model.PRICES[request['model']]\n   229\t    cap = request.get('max_completion_tokens', request.get('max_tokens'))\n   230\t    if isinstance(cap, bool) or not isinstance(cap, int) or cap <= 0:\n   231\t        raise model.TransportError('request without a positive output cap: refused by the budget')\n   232\t    tokens_in = 2 * len(json.dumps(request).encode('utf-8')) + 4096\n   233\t    return (tokens_in * price_in + cap * price_out) / 1e6\n   234\t\n   235\t\n   236\tdef whole(count):\n   237\t    return isinstance(count, int) and not isinstance(count, bool) and count >= 0\n   238\t\n   239\t\n   240\tdef llm_cost(response, request):\n   241\t    \"\"\"The answer's cost by `model.call`'s formula; None (settled at the reservation) unless the counts are whole, nonnegative numbers\n   242\t    with some input.\"\"\"\n   243\t    usage = response.get('usage') if isinstance(response, dict) else None\n   244\t    if not isinstance(usage, dict):\n   245\t        return None\n   246\t    tokens_in, tokens_out = usage.get('prompt_tokens'), usage.get('completion_tokens')\n   247\t    details = usage.get('prompt_tokens_details') or {}\n   248\t    cached = (details.get('cached_tokens') or 0) if isinstance(details, dict) else None\n   249\t    if not (whole(tokens_in) and whole(tokens_out) and whole(cached)) or tokens_in == 0:\n   250\t        return None\n   251\t    price_in, price_out = model.PRICES[request['model']]\n   252\t    cached = min(tokens_in, cached)\n   253\t    return (tokens_in - cached) / 1e6 * price_in + cached / 1e6 * price_in * model.CACHED_INPUT_SHARE + tokens_out / 1e6 * price_out\n   254\t\n   255\t\n   256\tdef jev_estimate(request):\n   257\t    price_in, _ = model.PRICES[request['model']]\n   258\t    tokens_in = 2 * len(json.dumps(request, sort_keys=True, ensure_ascii=False).encode('utf-8')) + 4096\n   259\t    return jev.ATTEMPTS * tokens_in * price_in / 1e6\n   260\t\n   261\t\n   262\tclass BudgetTransport:\n   263\t    \"\"\"Called as production calls a transport: (provider, request) for a language model, (request,) for Jev.\"\"\"\n   264\t\n   265\t    def __init__(self, ledger, sleep=time.sleep):\n   266\t        self.ledger, self.sleep = ledger, sleep\n   267\t\n   268\t    def __call__(self, *args):\n   269\t        if len(args) == 1:\n   270\t            return self._jev(args[0])\n   271\t        provider, request = args\n   272\t        for attempt in range(3):\n   273\t            estimate = llm_estimate(request)\n   274\t            if not self.ledger.reserve(estimate):\n   275\t                raise model.TransportError('the shared budget ceiling would be passed: not sent')\n   276\t            try:\n   277\t                response = model.openai_transport(provider, request, max_attempts=1)\n   278\t            except model.TransportError as error:\n   279\t                self.ledger.settle(estimate, estimate)\n   280\t                status = getattr(error, 'http_status', None)\n   281\t                if status in CLIENT_ERRORS or attempt == 2 or (status is not None and status != 429 and status < 500):\n   282\t                    raise\n   283\t                self.sleep(5 * (attempt + 1))\n   284\t                continue\n   285\t            except Exception:\n   286\t                self.ledger.settle(estimate, estimate)\n   287\t                raise\n   288\t            cost = llm_cost(response, request)\n   289\t            self.ledger.settle(estimate, estimate if cost is None else cost)\n   290\t            return response\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba docs/research/2026-11-20-production-readiness/dependency-design/july_test.py | sed -n '75,281p'\"","aggregated_output":"    75\t        self.inner, self.seq, self.linked, self.sent = inner, seq, linked, sent\n    76\t\n    77\t    def __call__(self, *args):\n    78\t        request = args[-1]\n    79\t        if not (len(args) == 1 and is_link_request(request) and self.linked and self.seq == LINK_SEQ):\n    80\t            raise Stop(f'unapproved request at seq {self.seq} ({\"link questions\" if len(args) == 1 and is_link_request(request) else \"not a link question\"}): not sent')\n    81\t        self.sent.append(('jev', self.seq, sorted(request['questions'])))\n    82\t        return self.inner(*args)\n    83\t\n    84\t\n    85\tclass SerialRunner:\n    86\t    \"\"\"replay.run's day runner: each routed item through round.run with a transport bound to its own sequence; after seq 148 commits,\n    87\t    the committed links are inspected before anything else runs.\"\"\"\n    88\t\n    89\t    def __init__(self, inner, linked):\n    90\t        self.inner, self.linked, self.sent, self.links = inner, linked, [], []\n    91\t\n    92\t    def __call__(self, conn, archive, cfg, uni, items, *, day, transport=None, log=print):\n    93\t        for item, route in items:\n    94\t            result = rounds.run(conn, archive, cfg, uni, item, route.sequence_no, resume_from=route.resume_from,\n    95\t                                transport=ItemScope(self.inner, route.sequence_no, self.linked, self.sent), log=log)\n    96\t            if not result.failed and route.sequence_no == LINK_SEQ:\n    97\t                self.links = [tuple(r) for r in conn.execute(\"select view_id, depends_on, direction, seq from dependencies where kind=?\", (links.KIND,))]\n    98\t                outside = [r for r in self.links if r[0] not in TARGETS]\n    99\t                if outside:\n   100\t                    raise Stop(f'out-of-pair link committed at seq {LINK_SEQ}: {outside}: the sequence is not comparable')\n   101\t            yield result\n   102\t\n   103\t\n   104\tdef retire_targets(archive_path):\n   105\t    archive = model.Archive(str(archive_path))\n   106\t    rows = archive.conn.execute(\"select call_id, request_json from model_calls where purpose='judge'\").fetchall()\n   107\t    retired = 0\n   108\t    for call_id, request_json in rows:\n   109\t        if judged_view(json.loads(request_json)) in TARGETS:\n   110\t            archive.retire(call_id)\n   111\t            retired += 1\n   112\t    top = archive.conn.execute('select coalesce(max(call_id), 0) from model_calls').fetchone()[0]\n   113\t    return archive, retired, top\n   114\t\n   115\t\n   116\tdef prepare(folder, prefix_ledger):\n   117\t    if folder.exists():\n   118\t        raise SystemExit(f'{folder} exists: a sequence starts from an empty folder and is never resumed')\n   119\t    folder.mkdir(parents=True)\n   120\t    views, archive_path = folder / 'views.sqlite', folder / 'archive.sqlite'\n   121\t    shutil.copyfile(prefix_ledger, views)\n   122\t    conn = sqlite3.connect(views)\n   123\t    last = conn.execute('select max(seq) from days_completed').fetchone()[0]\n   124\t    unfinished = conn.execute('select count(*) from processing_steps where sequence_no > ?', (last,)).fetchone()[0]\n   125\t    if last != PREFIX_SEQ or unfinished:\n   126\t        raise SystemExit(f'the prefix ledger is not the finished end of 07-09 (last completed seq {last}, {unfinished} later steps)')\n   127\t    conn.execute('create table harness_only (name text, day text)')\n   128\t    conn.execute(\"insert into harness_only values ('july_test.py', '2026-11-21')\")\n   129\t    conn.commit()\n   130\t    conn.close()\n   131\t    shutil.copyfile(OLD2 / 'archive.sqlite', archive_path)\n   132\t    archive, retired, top = retire_targets(archive_path)\n   133\t    return views, archive, retired, top\n   134\t\n   135\t\n   136\tdef run_sequence(scratch, name, prefix_ledger, cfg_path, linked, inner, log):\n   137\t    folder = scratch / name\n   138\t    views, archive, retired, top = prepare(folder, prefix_ledger)\n   139\t    cfg, uni = config.load(str(cfg_path)), universe.load(str(UNIVERSE))\n   140\t    judging_scope, runner = JudgingScope(inner), SerialRunner(inner, linked)\n   141\t    held = live_lock.acquire(str(views))\n   142\t    stopped = ''\n   143\t    try:\n   144\t        replay.run(testdb_path=str(ITEMS), views_path=str(views), archive=archive, cfg=cfg, universe=uni, from_day=WINDOW[0],\n   145\t                   until_day=WINDOW[1], transport=judging_scope, day_runner=runner, only_objects={'NVDA'}, log=log)\n   146\t    except Exception as error:\n   147\t        stopped = f'{type(error).__name__}: {error}'[:400]\n   148\t    finally:\n   149\t        live_lock.release(held)\n   150\t    conn = sqlite3.connect(f'file:{views}?mode=ro', uri=True)\n   151\t    judgements = [dict(zip(('view_id', 'day', 'call_id', 'rung', 'changed', 'reference', 'implied_outcome', 'reasons'), r)) for r in conn.execute(\n   152\t        'select view_id, publication_day, call_id, rung, changed, reference, implied_outcome, reasons from judgements where seq > ? and view_id in (?, ?) order by judgement_id',\n   153\t        (PREFIX_SEQ, *TARGETS))]\n   154\t    fresh = [j for j in judgements if j['call_id'] > top]\n   155\t    calls = [j['call_id'] for j in judgements]\n   156\t    summary = {'name': name, 'config': cfg.version, 'linked': linked, 'stopped': stopped, 'retired_target_rows': retired,\n   157\t               'links': runner.links, 'judge_requests_sent': judging_scope.sent, 'link_requests_sent': runner.sent,\n   158\t               'judgements': judgements, 'all_target_judgements_fresh': len(fresh) == len(judgements) and len(set(calls)) == len(calls),\n   159\t               'selection': [tuple(r) for r in conn.execute('select attempt_id, status, record_json from link_selections order by id')]}\n   160\t    (folder / 'summary.json').write_text(json.dumps(summary, indent=1, ensure_ascii=False))\n   161\t    return summary, views, folder / 'archive.sqlite'\n   162\t\n   163\t\n   164\t# ---------- fakes for the $0 runs ----------\n   165\t\n   166\tdef fake_judge(label, changed_on):\n   167\t    \"\"\"A judge answering every v9/v14 request with labelled reasons; `changed_on` maps (view, n) to the changed flag of that view's n-th\n   168\t    judgement in the sequence (1 = 07-10's); a first judgement always says changed.\"\"\"\n   169\t    calls = {}\n   170\t\n   171\t    def answer(provider, request):\n   172\t        text = request['messages'][-1]['content']\n   173\t        view_id = judged_view(request)\n   174\t        calls[view_id] = calls.get(view_id, 0) + 1\n   175\t        changed = True if '[Previous conclusion] none' in text else changed_on.get((view_id, calls[view_id]), True)\n   176\t        data = {'rung': 3, 'reference': f'{label} reference for {view_id}', 'implied_outcome': f'{label} forecast for {view_id}',\n   177\t                'reasons': f'{label} reasons for {view_id} #{calls[view_id]}', 'cites': [], 'cites_views': [], 'pushes': [], 'changed': changed,\n   178\t                'why_changed': '', 'theme_pushes': []}\n   179\t        return {'choices': [{'message': {'content': json.dumps(data)}}], 'usage': {'prompt_tokens': 100, 'completion_tokens': 10}}\n   180\t    return answer\n   181\t\n   182\t\n   183\tdef fake_jev(readers):\n   184\t    \"\"\"Link questions: `readers` are the theses answered \"the THESIS reads the CANDIDATE\" (sign together); every other pair neither.\"\"\"\n   185\t    def answer(request):\n   186\t        answers = {}\n   187\t        for qid, question in request['questions'].items():\n   188\t            view_id = qid.split('__', 1)[1]\n   189\t            chosen = (links.THESIS_READS if view_id in readers else links.NEITHER) if qid.startswith('reads__') else links.TOGETHER\n   190\t            others = [k for k in question['criteria'] if k != chosen]\n   191\t            probabilities = {k: round(0.2 / len(others), 4) for k in others}\n   192\t            probabilities[chosen] = round(1 - sum(probabilities.values()), 4)\n   193\t            answers[qid] = {'type': 'choice', 'choice': chosen, 'confidence': probabilities[chosen], 'probabilities': probabilities}\n   194\t        return {'model': request['model'], 'answers': answers, 'usage': {'input_tokens': 100, 'output_tokens': 10}}\n   195\t    return answer\n   196\t\n   197\t\n   198\tdef dispatcher(judge, jev_answer, counter):\n   199\t    def transport(*args):\n   200\t        counter.append(len(args))\n   201\t        return jev_answer(args[0]) if len(args) == 1 else judge(*args)\n   202\t    return transport\n   203\t\n   204\t\n   205\tdef requests_of(archive_path, top, view_id):\n   206\t    archive = sqlite3.connect(f'file:{archive_path}?mode=ro', uri=True)\n   207\t    rows = archive.execute(\"select request_json from model_calls where purpose='judge' and call_id > ? order by call_id\", (top,)).fetchall()\n   208\t    return [json.loads(r[0])['messages'][-1]['content'] for r in rows if json.loads(r[0])['messages'][-1]['content'].startswith(f'Thesis {view_id} (')]\n   209\t\n   210\t\n   211\tdef dry(scratch, prefix_ledger):\n   212\t    scratch.mkdir(parents=True, exist_ok=True)\n   213\t    checks, log = {}, (lambda *a: None)\n   214\t    plans = {'control-A': (V118, False, 'DRY-A', {}), 'control-B': (V118, False, 'DRY-B', {}),\n   215\t             'linked-A': (V119, True, 'DRY-A', {('v14', 2): True}), 'linked-B': (V119, True, 'DRY-B', {('v14', 2): False})}\n   216\t    for name, (cfg_path, linked, label, changed_on) in plans.items():\n   217\t        counter = []\n   218\t        summary, _, archive_path = run_sequence(scratch, name, prefix_ledger, cfg_path, linked,\n   219\t                                                dispatcher(fake_judge(label, changed_on), fake_jev({'v9'}), counter), log)\n   220\t        days = {(j['view_id'], j['day']) for j in summary['judgements']}\n   221\t        top = retire_targets_top(archive_path)\n   222\t        v9_requests = requests_of(archive_path, top, 'v9')\n   223\t        v14_requests = requests_of(archive_path, top, 'v14')\n   224\t        # each view's first request in the window carries the prefix's conclusion (v9: old-2's 07-09 answer; v14: none); every later one\n   225\t        # must carry this sequence's own previous answer\n   226\t        own = all(f'{label} reasons for' in r.split('[Previous conclusion', 1)[1] for r in v9_requests[1:] + v14_requests[1:]) \\\n   227\t            and bool(v9_requests) and f'{label} reasons for' not in v9_requests[0].split('[Previous conclusion', 1)[1] \\\n   228\t            and '[Previous conclusion] none' in v14_requests[0]\n   229\t        checks[name] = {\n   230\t            'not stopped': summary['stopped'] == '',\n   231\t            'all target judgements fresh': summary['all_target_judgements_fresh'],\n   232\t            'each later request carries its own previous answer': own,\n   233\t            'v14 judged each day': {d for v, d in days if v == 'v14'} == {'2026-07-10', '2026-07-11', '2026-07-12'},\n   234\t            'v9 days': sorted(d for v, d in days if v == 'v9'),\n   235\t        }\n   236\t        if linked:\n   237\t            checks[name]['link written'] = summary['links'] == [('v9', 'v14', 'first_is_bullish', LINK_SEQ)]\n   238\t            checks[name]['v8 block in v9 requests'] = bool(v9_requests) and all('Comparison point stated by that judgement' in r for r in v9_requests)\n   239\t            expected = ['2026-07-10', '2026-07-11', '2026-07-12'] if changed_on.get(('v14', 2)) else ['2026-07-10', '2026-07-12']\n   240\t            checks[name]['v9 queued by a changed v14 only'] = checks[name]['v9 days'] == expected\n   241\t        else:\n   242\t            checks[name]['no link'] = summary['links'] == [] and summary['link_requests_sent'] == []\n   243\t            checks[name]['v9 only on the stored days'] = checks[name]['v9 days'] == ['2026-07-10', '2026-07-12']\n   244\t    # the stop paths: an unapproved judge request, a link request at another sequence, an out-of-pair link\n   245\t    counter = []\n   246\t    inner = dispatcher(fake_judge('DRY-S', {}), fake_jev({'v9'}), counter)\n   247\t    try:\n   248\t        JudgingScope(inner)('openai', {'messages': [{'role': 'user', 'content': 'Thesis v8 (NVDA'}]})\n   249\t        checks['stop: unapproved judge request'] = False\n   250\t    except Stop:\n   251\t        checks['stop: unapproved judge request'] = counter == []\n   252\t    try:\n   253\t        ItemScope(inner, 150, True, [])({'model': 'jev', 'state': '', 'questions': {'reads__v9': {}}})\n   254\t        checks['stop: link request at another seq'] = False\n   255\t    except Stop:\n   256\t        checks['stop: link request at another seq'] = counter == []\n   257\t    out_of_pair, _, _ = run_sequence(scratch, 'linked-out-of-pair', prefix_ledger, V119, True,\n   258\t                                     dispatcher(fake_judge('DRY-O', {}), fake_jev({'v9', 'v1', 'v2', 'v5', 'v6', 'v10', 'v11', 'v12'}), []), log)\n   259\t    checks['stop: out-of-pair link'] = out_of_pair['stopped'].startswith('Stop: out-of-pair link') and not any(\n   260\t        j['day'] > WINDOW[0] for j in out_of_pair['judgements'])\n   261\t    (scratch / 'dry-checks.json').write_text(json.dumps(checks, indent=1))\n   262\t    print(json.dumps(checks, indent=1))\n   263\t    flat = [v for c in checks.values() for k, v in (c.items() if isinstance(c, dict) else [('', c)]) if isinstance(v, bool)]\n   264\t    return all(flat)\n   265\t\n   266\t\n   267\tdef retire_targets_top(archive_path):\n   268\t    \"\"\"The highest call id a sequence's archive held before the sequence ran (written by `prepare`).\"\"\"\n   269\t    archive = sqlite3.connect(f'file:{OLD2 / \"archive.sqlite\"}?mode=ro', uri=True)\n   270\t    return archive.execute('select coalesce(max(call_id), 0) from model_calls').fetchone()[0]\n   271\t\n   272\t\n   273\t# ---------- the other $0 checks ----------\n   274\t\n   275\tdef prefix(scratch):\n   276\t    \"\"\"poc-v119 from an empty ledger over 07-01..07-09: link questions answered \"neither\", every other request from old-2's archive.\"\"\"\n   277\t    folder = scratch / 'prefix-v119'\n   278\t    if folder.exists():\n   279\t        raise SystemExit(f'{folder} exists')\n   280\t    folder.mkdir(parents=True)\n   281\t    shutil.copyfile(OLD2 / 'archive.sqlite', folder / 'archive.sqlite')\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc 'nl -ba docs/research/2026-11-20-production-readiness/dependency-design/PROOF.md; nl -ba docs/research/2026-11-20-production-readiness/dependency-design/filing-exposure.md | head -100'","aggregated_output":"     1\t# The $0 proof of the linking version (D694, D695), for the council before the July send\n     2\t\n     3\tBuilt (working tree, not committed): `src/hivemind/views/links.py` (new); `views/round.py` (the link step between matching and the\n     4\t`matched` marker, `link_selections` records); `views/writing.py` (`proposed_links`, `_write_links`); `views/store.py` (`dependencies.kind`,\n     5\t`link_selections`, `direct_parents` skips `reads`, `current_state` returns the stance fields); `views/judging.py` (`judging-v8`, the full\n     6\tdependency block); `config.py` (`jev-links`); `parallel_day.py`; `research_context.py` (explicit columns); `scripts/replay.py` and\n     7\t`clean-arch/e2e-comparison-2026-11-13/budget_replay.py` (refuse `jev-links` and a harness-only ledger); `prompts/judging-v8.txt` (byte\n     8\tcopy of v7); `poc/config/poc-v119.json`.\n     9\t\n    10\t| Check | Result | Record |\n    11\t|---|---|---|\n    12\t| the whole suite | 376 passed (346 before; `tests/test_links.py` 29; one new pin test) | `python3 -m pytest -q` |\n    13\t| mutants | 7 of 7 caught, each control passing; the harness-ledger mutant's failure read: the refusal message is missing | `mutants.py`, `mutants.log` |\n    14\t| frozen pins | v7 pins unchanged; v8 file sha = v7's; v8 schema = v7's; the link questions pinned | `tests/test_frozen_questions_and_judgement.py` |\n    15\t| the July starting state | old-2 rebuilt to the end of 07-09 under poc-v118, every request from the archive; equal on views, keys, rungs, evidence, links, judgements (with cites, changed, reference, implied outcome, request sha), switches, successions, dependencies | `rebuild_control.py`, `rebuild-control.log` |\n    16\t| poc-v119 with no link reproduces the prefix | equal on the same tables; 3 link requests asked before 07-10 (answered neither), eligible pairs listed | `july_test.py prefix`, `prefix-v119.log` |\n    17\t| the archive | 145 v9/v14 judge rows retired; exact old v9 and v14 requests go to the transport; an exact old v8 request is answered from the archive with its call id; a retired answer is not returned again | `july_test.py archive` |\n    18\t| the dry run (fake answers for every bought call) | 29 of 29 checks: controls judge v9 only on 07-10 and 07-12 and write no link; linked sequences write \"v9 reads v14\" (`first_is_bullish`, seq 148) and show the v8 block; a changed v14 on 07-11 queues v9, an unchanged one does not; every later request carries its own sequence's previous answer; every v9/v14 judgement is a fresh call; an unapproved judge request and a link request at another sequence are refused before the inner transport; an out-of-pair link stops the sequence at inspection | `july_test.py dry`, `dry-run.log` |\n    19\t| price | the stored v9/v14 judge calls of 07-10..07-12: $0.0098 a sequence uncached, $0.0586 for six; ceiling $0.15 | `july_test.py price` |\n    20\t| filing exposure | 105 reading answers after seq 148 link a statement to both v9 and v14 (total revenue's own Q1 figure and Q2 guidance among them); with `kind='reads'` none moves | `filing-exposure.md`, test 5 |\n    21\t| the reading rule | frozen: `reading-rule.md` (sha256 below) | |\n    22\t\n    23\tWritten, not run: `july_test.py send <scratch> <prefix ledger> <out>`: six sequences alternated (control-1, linked-1, ... under\n    24\tpoc-v118 and poc-v119) through `run_sequence` with `BudgetTransport` over a new `SharedLedger` (ceiling $0.15) and `install_stop_gate`;\n    25\tthe shared ledger read after each sequence (stopped, refused or overrun: inconclusive, and the send ends). It runs only after the\n    26\tcouncil passes this proof. Not done: the PRD 06 text for the\n    27\tnew matcher outcome (it changes with the decision that makes a version the product).\n    28\treading-rule.md sha256: cc876b60b8eef25b7675f6d078147d2e569ec97d1b1bfa969f9ec8060d596680\n     1\t# Filing exposure under literal D265 (old-2, $0; 2026-11-21)\n     2\t\n     3\tCounted on old-2's stored reading answers (`handovers`, seq >= 148, the item that opened total revenue v14): **105** statements were\n     4\tlinked by the reading step to both v9 (Data Center FY2027) and v14 (total revenue FY2027). With a link \"v9 reads v14\" read as a\n     5\thierarchy (D265 literally, `extraction.narrowest_links`), each would keep v9 only. Among them, seq 185: \"NVIDIA reported record FY2027\n     6\tfirst-quarter revenue of $81.6 billion, up 85% year over year\" and \"NVIDIA management guided FY2027 Q2 revenue to approximately $91\n     7\tbillion\": total revenue's own figure and guidance (D207: \"company-wide figure questions take only their own figures, guidance and\n     8\tmanagement statements\"). A first-order count: a replay under the literal rule would diverge from the archive at the first moved link,\n     9\tso the exact loss is not replayable at $0. Under D694 (a) (`kind = 'reads'` skipped by `store.direct_parents`) none moves.\n","exit_code":0,"status":"completed"}}
