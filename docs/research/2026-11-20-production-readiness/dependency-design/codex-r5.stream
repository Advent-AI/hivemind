views['c1']\ntests/test_keyed_views.py:208:    m = writing.write(conn, UNIVERSE, 1, meta_item, extraction.Handover(EVIDENCE[:1], [meta], [], 0, '', False, 0.0), matching.Checked({'c1': ('new', None, [])}, {}, [], {}), {}).new_views['c1']\ntests/test_admission.py:94:    def recording(*parameters):\ntests/test_concurrency.py:263:        records = [json.loads(r[0]) for r in db.execute('select shown_json from match_records')]\n   220\tdef part_c(archive_conn, views_paths, uni):\n   221\t    reasons, examples = collections.Counter(), collections.defaultdict(list)\n   222\t    judged = refused_records = 0\n   223\t    per_ledger = []\n   224\t    for path in views_paths:\n   225\t        ledger_judged, skipped = 0, collections.Counter()\n   226\t        # matching.check writes suggested themes to the review pool, so it runs on a scratch copy, never on the real file\n   227\t        scratch = os.path.join(tempfile.mkdtemp(), 'views.sqlite')\n   228\t        shutil.copy(path, scratch)                  # `path` is already preflight's own locked copy (`store_copies`), never a live store\n   229\t        conn = sqlite3.connect(scratch)\n   230\t        conn.row_factory = sqlite3.Row\n   231\t        for rec in conn.execute('select input_id, call_no, shown_json, decisions_json, request_sha256 from match_records order by id'):\n   232\t            handover_row = conn.execute('select handover_json from handovers where input_id=? order by id desc limit 1', (rec['input_id'],)).fetchone()\n   233\t            if not handover_row or not rec['decisions_json']:\n   234\t                skipped['no handover or no decision'] += 1\n   235\t                continue\n   236\t            shown_views = shown_for_record(archive_conn, rec, json.loads(rec['decisions_json']))\n   237\t            if shown_views is None:\n   238\t                skipped['request not in this archive'] += 1\n   239\t                continue\n   240\t            handover = json.loads(handover_row['handover_json'])\n   241\t            shown = json.loads(rec['shown_json'])\n   242\t            lists = matching.Lists(shown.get('candidates', {}), {tuple(k.split('|', 1)): v for k, v in shown.get('evidence', {}).items()})\n   243\t            if rec['call_no'] <= 2:\n   244\t                candidates, evidence = handover['candidates'], handover['evidence']\n   245\t            else:                                   # the second call: candidate-linked evidence under its destination\n   246\t                wanted = {k[0] for k in lists.evidence_lists}\n   247\t                candidates, evidence = [], [dict(e, links=[k[1] for k in lists.evidence_lists if k[0] == e['id']]) for e in handover['evidence'] if e['id'] in wanted]\n   248\t            try:\n   249\t                checked = matching.check(conn, uni, json.loads(rec['decisions_json']), candidates, evidence, lists, shown_views)\n   250\t            except Exception as error:\n   251\t                key = 'check raised ' + type(error).__name__\n   252\t                reasons[key] += 1; examples[key].append(f'{os.path.basename(os.path.dirname(path))} {rec[\"input_id\"][:40]}: {error!r}'[:140])\n   253\t                judged += 1; refused_records += 1; ledger_judged += 1\n   254\t                continue\n   255\t            judged += 1\n   256\t            ledger_judged += 1\n   257\t            if checked.refusals:\n   258\t                refused_records += 1\n   259\t            for refusal in checked.refusals:\n   260\t                key = normalise_reason(refusal)\n   261\t                reasons[key] += 1\n   262\t                examples[key].append(f'{os.path.basename(os.path.dirname(path))} {rec[\"input_id\"][:40]}: {refusal[:90]}')\n   263\t        per_ledger.append((os.path.basename(os.path.dirname(path)) or path, ledger_judged, skipped))\n   264\t    tally('C. matching code checks over stored records (database state is the final one, not the state at the time)', judged, refused_records, reasons, examples)\n   265\t    unjudged = []\n   266\t    for name, ledger_judged, skipped in per_ledger:\n   267\t        print(f'       ledger {name}: judged {ledger_judged}, skipped {sum(skipped.values())} {dict(skipped) if skipped else \"\"}')\n   268\t        if skipped and not ledger_judged:\n","exit_code":0,"status":"completed"}}
