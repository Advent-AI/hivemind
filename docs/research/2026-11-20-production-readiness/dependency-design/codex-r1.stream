{"type":"item.completed","item":{"id":"item_21","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"rg -n 'matching\\\\.check|jev_matching\\\\.decide|WriteConflict|def (prepare|apply|run)|match_records|changed_views' src/hivemind/views/round.py src/hivemind/parallel_day.py src/hivemind/replay.py\nnl -ba src/hivemind/research_context.py | sed -n '1,160p'\nnl -ba src/hivemind/views/store.py | sed -n '206,282p'\nnl -ba src/hivemind/service.py | sed -n '102,145p;178,199p'\nnl -ba src/hivemind/views/judging.py | sed -n '306,356p'\nnl -ba src/hivemind/model.py | sed -n '25,43p;265,281p'\nnl -ba src/hivemind/pull.py\"","aggregated_output":"src/hivemind/replay.py:51:def run(*, testdb_path, views_path, archive, cfg, universe, from_day, until_day, day0=None, spend_cap_usd=None,\nsrc/hivemind/views/round.py:49:        checked = matching.check(conn, universe, answer.data, candidates, evidence, lists, shown)\nsrc/hivemind/views/round.py:53:        store.insert(conn, 'match_records', seq=seq, input_id=item['input_id'], call_no=call_offset + attempt + 1,\nsrc/hivemind/views/round.py:64:def changed_views_of_day(conn, day):\nsrc/hivemind/views/round.py:78:    changed = changed_views_of_day(conn, day)\nsrc/hivemind/views/round.py:97:def run(conn, archive, cfg, universe, item, seq, *, resume_from=None, transport=None, log=print, extractor=None, matching_workers=1):\nsrc/hivemind/views/round.py:160:    dispatch.mark(conn, item, seq, 'written', 'ok', json.dumps({'changed': sorted(written.changed_views), 'new': written.new_views, 'notes': written.notes[:20]}, ensure_ascii=False))\nsrc/hivemind/parallel_day.py:38:def runtime_key():\n     1\t\"\"\"Complete, historical DB context for steps 2a and 2b (D250, ported for D201): the catalog of open questions in scope at a\n     2\tsequence number, and the complete evidence of chosen questions at that same sequence number.\n     3\t\n     4\tCatalog selection is a semantic job outside this module. No lexical filtering,\n     5\tranking, model call or top-N truncation is performed here.\n     6\t\"\"\"\n     7\timport copy\n     8\tfrom .views import store\n     9\t\n    10\t\n    11\tclass Reader:\n    12\t    \"\"\"One read transaction, one explicit exclusive sequence boundary and scope.\"\"\"\n    13\t\n    14\t    def __init__(self, path, before_seq, object_ids, universe):\n    15\t        if type(before_seq) is not int or before_seq < 1:\n    16\t            raise ValueError('before_seq must be a positive owned sequence number')\n    17\t        if not object_ids or any(not universe.has(x) for x in object_ids):\n    18\t            raise ValueError('explicit, known research objects required')\n    19\t        self.seq = before_seq\n    20\t        self.scope = sorted(set(object_ids) | set(universe.themes))\n    21\t        self.db = store.open_read_only(path)\n    22\t        self.db.execute('begin')\n    23\t        self._catalog = None\n    24\t\n    25\t    def __enter__(self):\n    26\t        return self\n    27\t\n    28\t    def __exit__(self, *_):\n    29\t        self.db.close()\n    30\t\n    31\t    def rows(self, sql, args=()):\n    32\t        return [dict(r) for r in self.db.execute(sql, args)]\n    33\t\n    34\t    def dependencies(self, vid):\n    35\t        result = self.rows('select * from dependencies where view_id=? and seq<? order by seq,dependency_id', (vid,self.seq))\n    36\t        for dep in result:\n    37\t            res = self.rows('select * from dependency_resolutions where dependency_id=? and seq<? order by seq desc,id desc limit 1', (dep['dependency_id'],self.seq))\n    38\t            dep['resolved_to'] = res[0]['resolved_to'] if res else dep['depends_on']\n    39\t            dep['resolution'] = res[0] if res else None\n    40\t        return result\n    41\t\n    42\t    def question(self, row):\n    43\t        vid = row['view_id']\n    44\t        switches = self.rows('select * from view_switches where view_id=? and after_seq<? order by after_seq desc,id desc limit 1', (vid,self.seq))\n    45\t        if not switches:\n    46\t            raise ValueError('question has no historical open/closed state: ' + vid)\n    47\t        keys = self.rows('select * from view_keys where view_id=? and seq<?', (vid,self.seq))\n    48\t        return dict(row, open=bool(switches[0]['open']),\n    49\t                    rungs=self.rows('select * from rungs where view_id=? order by position', (vid,)),\n    50\t                    key=keys[0] if keys else None, dependencies=self.dependencies(vid))\n    51\t\n    52\t    def catalog(self):\n    53\t        all_rows = self.rows('select * from views where created_seq<? order by created_seq,view_id', (self.seq,))\n    54\t        by_id = {r['view_id']: r for r in all_rows}\n    55\t        selected = {}\n    56\t        for row in all_rows:\n    57\t            if row['object_id'] in self.scope:\n    58\t                q = self.question(row)\n    59\t                if q['open']:\n    60\t                    selected[row['view_id']] = q\n    61\t        for q in list(selected.values()):\n    62\t            for dep in q['dependencies']:\n    63\t                vid = dep['resolved_to']\n    64\t                if vid and vid not in selected:\n    65\t                    if vid not in by_id:\n    66\t                        raise ValueError('historical dependency target missing: ' + vid)\n    67\t                    selected[vid] = self.question(by_id[vid])\n    68\t        payload = {'before_seq': self.seq, 'object_ids': self.scope,\n    69\t                   'questions': list(selected.values()), 'complete': True}\n    70\t        self._catalog = selected\n    71\t        return copy.deepcopy(payload)\n    72\t\n    73\t    def evidence(self, eid):\n    74\t        rows = self.rows('select * from evidence where evidence_id=? and created_seq<?', (eid,self.seq))\n    75\t        if not rows:\n    76\t            raise ValueError('historical evidence missing: ' + eid)\n    77\t        return dict(rows[0], sources=self.rows('select * from evidence_sources where evidence_id=? and seq<? order by seq,id', (eid,self.seq)))\n    78\t\n    79\t    def expand(self, view_ids):\n    80\t        if self._catalog is None:\n    81\t            self.catalog()\n    82\t        if len(set(view_ids)) != len(view_ids) or any(v not in self._catalog for v in view_ids):\n    83\t            raise ValueError('select distinct IDs from this historical catalog')\n    84\t        evidence, questions = {}, []\n    85\t        for vid in view_ids:\n    86\t            ids = self.rows('select distinct e.evidence_id,e.created_seq from evidence e join evidence_links l on l.evidence_id=e.evidence_id where l.view_id=? and l.seq<? and e.created_seq<? and not exists (select 1 from replacements r where r.old_evidence_id=e.evidence_id and r.seq<?) order by e.created_seq,e.evidence_id', (vid,self.seq,self.seq,self.seq))\n    87\t            for row in ids:\n    88\t                eid = row['evidence_id']\n    89\t                if eid not in evidence:\n    90\t                    record = self.evidence(eid)\n    91\t                    previous = self.rows('select * from replacements where new_evidence_id=? and seq<? order by seq,id', (eid,self.seq))\n    92\t                    record['replaced'] = [dict(r, evidence=self.evidence(r['old_evidence_id'])) for r in previous]\n    93\t                    evidence[eid] = record\n    94\t            judgements = self.rows('select * from judgements where view_id=? and seq<? order by seq desc,judgement_id desc limit 1', (vid,self.seq))\n    95\t            questions.append(dict(copy.deepcopy(self._catalog[vid]), evidence_ids=[r['evidence_id'] for r in ids],\n    96\t                                  latest_judgement=judgements[0] if judgements else None))\n    97\t        return {'before_seq': self.seq, 'questions': questions,\n    98\t                'evidence': list(evidence.values()), 'complete': True}\n   206\tdef views_of_object(conn, object_id, only_open=True):\n   207\t    rows = conn.execute('select view_id from views where object_id=? order by created_seq', (object_id,)).fetchall()\n   208\t    ids = [r['view_id'] for r in rows]\n   209\t    return [v for v in ids if is_open(conn, v)] if only_open else ids\n   210\t\n   211\t\n   212\tdef has_judgement(conn, view_id, seq):\n   213\t    return conn.execute('select 1 from judgements where view_id=? and seq=?', (view_id, seq)).fetchone() is not None\n   214\t\n   215\t\n   216\tREAD_BUSY_TIMEOUT_SECONDS = 5.0     # a reader's busy timeout: SQLite's busy handler retries SQLITE_BUSY within it (live-service row 1)\n   217\t\n   218\t\n   219\tdef open_read_only(path):\n   220\t    \"\"\"The views database for a reader (the agent layer, reports): no schema creation, no writes. Opened by its own path: a symlink\n   221\t    resolved, a store with another hard link refused (`live_lock.LockRefused`; live-service/OPERATING-CONTRACT.md, row 7), since\n   222\t    SQLite finds a WAL store's side files by the opened path.\"\"\"\n   223\t    from hivemind import live_lock\n   224\t    real, _ = live_lock.own_path(path)\n   225\t    conn = sqlite3.connect(f'file:{real}?mode=ro', uri=True, timeout=READ_BUSY_TIMEOUT_SECONDS)\n   226\t    conn.row_factory = sqlite3.Row\n   227\t    return conn\n   228\t\n   229\t\n   230\tdef current_state(conn, view_id):\n   231\t    row = conn.execute('select judgement_id, rung, reasons, changed, seq, publication_day from judgements where view_id=? order by judgement_id desc limit 1', (view_id,)).fetchone()\n   232\t    return dict(row) if row else None\n   233\t\n   234\t\n   235\tdef dependencies_of(conn, view_id):\n   236\t    \"\"\"Each dependency with its current target: the resolved view, or the waiting chain and year.\"\"\"\n   237\t    out = []\n   238\t    for dep in conn.execute('select * from dependencies where view_id=? order by dependency_id', (view_id,)):\n   239\t        dep = dict(dep)\n   240\t        resolution = conn.execute('select resolved_to, reason from dependency_resolutions where dependency_id=? order by id desc limit 1', (dep['dependency_id'],)).fetchone()\n   241\t        if resolution:\n   242\t            dep['resolved_to'], dep['resolution'] = resolution['resolved_to'], resolution['reason']\n   243\t        else:\n   244\t            dep['resolved_to'], dep['resolution'] = dep['depends_on'], ('direct' if dep['depends_on'] else 'waiting')\n   245\t        out.append(dep)\n   246\t    return out\n   247\t\n   248\t\n   249\tdef direct_parents(conn, view_id, seq=None):\n   250\t    \"\"\"The views this view depends on directly (a driver's root, D208; the seeds' depends_on), written at or before `seq` when given.\n   251\t    The filing reads it to keep a statement under the narrower of two linked questions (D207's narrowest rule, extraction.file_reading).\"\"\"\n   252\t    rows = conn.execute(\"select depends_on from dependencies where view_id=? and depends_on != '' and (? is null or seq <= ?) order by dependency_id\", (view_id, seq, seq))\n   253\t    return list(dict.fromkeys(r[0] for r in rows))\n   254\t\n   255\t\n   256\tdef dependants_of(conn, view_id):\n   257\t    direct = [r['view_id'] for r in conn.execute('select view_id from dependencies where depends_on=?', (view_id,))]\n   258\t    resolved = [r['view_id'] for r in conn.execute(\n   259\t        'select d.view_id from dependency_resolutions r join dependencies d on d.dependency_id=r.dependency_id where r.resolved_to=?', (view_id,))]\n   260\t    return sorted(set(direct + resolved))\n   261\t\n   262\t\n   263\tdef would_cycle(conn, view_id, depends_on):\n   264\t    \"\"\"True when depends_on already depends, directly or through its dependencies, on view_id.\"\"\"\n   265\t    seen, stack = set(), [depends_on]\n   266\t    while stack:\n   267\t        current = stack.pop()\n   268\t        if current == view_id:\n   269\t            return True\n   270\t        if current in seen or not current:\n   271\t            continue\n   272\t        seen.add(current)\n   273\t        for dep in dependencies_of(conn, current):\n   274\t            if dep['resolved_to']:\n   275\t                stack.append(dep['resolved_to'])\n   276\t    return False\n   277\t\n   278\t\n   279\tdef day_start_seq(conn, day):\n   280\t    \"\"\"D251: the sequence number the start of `day` stands at: the seq of the last completed day before it, or 0 before the first\n   281\t    completed day, where the seed questions live (D253: seeds are created at seq 0, before any item).\"\"\"\n   282\t    row = conn.execute('select max(seq) from days_completed where day < ?', (day,)).fetchone()\n   102\t        _SEQ_DAYS.clear()\n   103\t    _SEQ_DAYS[id(conn)] = (conn, stamp, cache)\n   104\t    return cache\n   105\t\n   106\t\n   107\tdef day_of_seq(conn, seq):\n   108\t    return seq_day_map(conn).get(seq)\n   109\t\n   110\t\n   111\tdef visible(conn, seq, as_of):\n   112\t    day = day_of_seq(conn, seq)\n   113\t    return day is not None and day <= as_of\n   114\t\n   115\t\n   116\t# ---------- views\n   117\t\n   118\tdef view_exists(conn, record, as_of):\n   119\t    return visible(conn, record['created_seq'], as_of)\n   120\t\n   121\t\n   122\tdef is_open_as_of(conn, view_id, as_of):\n   123\t    for row in conn.execute('select open, after_seq from view_switches where view_id=? order by id desc', (view_id,)):\n   124\t        if visible(conn, row['after_seq'], as_of):\n   125\t            return bool(row['open'])\n   126\t    return True\n   127\t\n   128\t\n   129\tdef state_as_of(conn, view_id, as_of):\n   130\t    \"\"\"The last judgement on or before the day, with the day the current position was first taken.\"\"\"\n   131\t    rows = [dict(r) for r in conn.execute('select * from judgements where view_id=? and publication_day<=? order by judgement_id', (view_id, as_of))]\n   132\t    if not rows:\n   133\t        return None\n   134\t    last = rows[-1]\n   135\t    since, previous = last['publication_day'], None\n   136\t    for row in reversed(rows[:-1]):\n   137\t        if row['rung'] != last['rung']:\n   138\t            previous = row['rung']\n   139\t            break\n   140\t        since = row['publication_day']\n   141\t    return {'position': last['rung'], 'judgement_day': last['publication_day'], 'since_day': since, 'previous_position': previous,\n   142\t            'rounds': len(rows), 'why_changed': last['why_changed'], 'reasons': last['reasons'], 'theme_pushes': _json(last.get('theme_pushes_json'))}\n   143\t\n   144\t\n   145\tdef summaries(conn, as_of=None, include_closed=False):\n   178\tdef dependencies(conn, view_id, as_of):\n   179\t    \"\"\"The view's dependencies recorded on or before the day, each pointing at the target resolved on or before it.\"\"\"\n   180\t    out = []\n   181\t    for dep in conn.execute('select * from dependencies where view_id=? order by dependency_id', (view_id,)):\n   182\t        if not visible(conn, dep['seq'], as_of):\n   183\t            continue\n   184\t        target = dep['depends_on']\n   185\t        for res in conn.execute('select resolved_to, seq from dependency_resolutions where dependency_id=? order by id desc', (dep['dependency_id'],)):\n   186\t            if visible(conn, res['seq'], as_of):\n   187\t                target = res['resolved_to']\n   188\t                break\n   189\t        out.append({'view_id': target, 'direction': dep['direction'], 'wait_chain_view_id': dep['wait_chain_view_id'], 'wait_year': dep['wait_year'], 'since_day': day_of_seq(conn, dep['seq'])})\n   190\t    return out\n   191\t\n   192\t\n   193\tdef dependants(conn, view_id, as_of):\n   194\t    \"\"\"The views recorded on or before the day as depending on this one (directly or by a resolution).\"\"\"\n   195\t    direct = [r['view_id'] for r in conn.execute('select view_id, seq from dependencies where depends_on=?', (view_id,)) if visible(conn, r['seq'], as_of)]\n   196\t    resolved = [r['view_id'] for r in conn.execute('select d.view_id, r.seq from dependency_resolutions r join dependencies d on d.dependency_id=r.dependency_id where r.resolved_to=?', (view_id,)) if visible(conn, r['seq'], as_of)]\n   197\t    return sorted(set(direct + resolved))\n   198\t\n   199\t\n   306\t    pending = [v for v in topological(conn, list(changed_views) + queued_by_ledger(conn, seq)) if eligible(v)]\n   307\t    done, results = set(), []\n   308\t    while pending:\n   309\t        ready = [v for v in pending if upstream(conn, v).isdisjoint(set(pending) - {v})] or pending[:1]\n   310\t        level = [v for v in ready if is_theme(v)] or ready\n   311\t        prompts = {v: build_prompt(conn, v, version) for v in level}\n   312\t\n   313\t        def ask(view_id, note=''):\n   314\t            system, user = prompts[view_id]\n   315\t            return model.call(archive, cfg, cfg.rejudging, system, user + note, schema, 'judgement', 'judge', transport=transport)\n   316\t\n   317\t        with concurrent.futures.ThreadPoolExecutor(max_workers=JUDGE_WORKERS) as pool_:\n   318\t            answers = dict(zip(level, pool_.map(ask, level)))\n   319\t        for view_id in level:\n   320\t            answer = answers[view_id]\n   321\t            errors = check_answer(conn, view_id, answer.data, prompts[view_id][1])\n   322\t            if errors:\n   323\t                archive.retire(answer.call_id)                 # a refused answer never answers the same request again (a resume re-samples)\n   324\t                answer = ask(view_id, retry_note(errors))\n   325\t                errors = check_answer(conn, view_id, answer.data, prompts[view_id][1])\n   326\t                if errors:\n   327\t                    archive.retire(answer.call_id)\n   328\t                    raise JudgementRefused(f'{view_id}: ' + '; '.join(errors))\n   329\t            result = _record(conn, cfg, view_id, seq, item, answer)\n   330\t            done.add(view_id)\n   331\t            results.append(result)\n   332\t            if result['changed']:\n   333\t                for dependant in queued_by_change(conn, view_id):\n   334\t                    if dependant not in done and dependant not in pending and eligible(dependant):\n   335\t                        pending.append(dependant)\n   336\t        pending = [v for v in topological(conn, pending) if v not in done and eligible(v)]\n   337\t    return results\n    25\t             'deepseek': ('https://api.deepseek.com/chat/completions', 'DEEPSEEK_API_KEY')}\n    26\t# USD per million tokens, for the cost column only (an estimate; the provider's bill is the measurement)\n    27\t# gpt-6.1-sol: the published standard rates on 2026-11-16 (developers.openai.com/api/docs/models: \"$2 / $10\" per million input and output\n    28\t# tokens; D628's model comparison only). gpt-6-astra: the published standard rates on 2026-11-16 (developers.openai.com/api/docs/models/\n    29\t# gpt-6-astra: \"$10 input … $50 output\" per million tokens; D632's comparison only).\n    30\t# claude-opus-5-5: Anthropic's first-party list price, $4 input and $20 output per million tokens (the claude-api skill's model table,\n    31\t# cached 2026-11-03); Alex's Opus trial only (2026-11-16, \"你试试看opus\"). Cache reads ($0.20) are priced at CACHED_INPUT_SHARE, an over-estimate.\n    32\t# gpt-6-luna: the published standard rates on 2026-10-25 (developers.openai.com/api/docs/models/gpt-6-luna: $0.10/M input, $0.50/M output,\n    33\t# cached input $0.01/M). Until this date the table carried (1.25, 10.0), so every cost_usd recorded before it is 12.5x (input) to 20x (output)\n    34\t# the published rate; the token columns are the measurement, the bill is the provider's.\n    35\tPRICES = {'gpt-6-luna': (0.10, 0.50), 'gpt-6.1-sol': (2.00, 10.00), 'gpt-6-astra': (10.00, 50.00), 'claude-opus-5-5': (4.00, 20.00), 'deepseek-flash': (0.30, 1.20), 'deepseek-v4-pro': (1.32, 3.96),\n    36\t          'jev-1.14.0': (0.042, 0.0)}   # Jev: docs.typesafe.ai/models, 2026-10-25; output free   # DeepSeek: peak-hour list prices, cache misses (2026-10-23 pricing page)\n    37\tCACHED_INPUT_SHARE = 0.10          # cached input tokens are priced at 10% of the input rate (gpt-6-luna page, read again 2026-10-27)\n    38\t\n    39\tSCHEMA_SQL = \"\"\"\n    40\tcreate table if not exists model_calls (\n    41\t  call_id integer primary key autoincrement, purpose text, config_version text, config_checksum text, model text,\n    42\t  request_sha256 text unique, request_json text, response_json text, answer_json text, prompt_chars integer,\n    43\t  input_tokens integer, output_tokens integer, cost_usd real, seconds real, created_at text\n   265\t        data = json.loads(content)\n   266\t    except (KeyError, IndexError, TypeError, json.JSONDecodeError) as error:\n   267\t        archive.record(purpose=purpose, config_version=cfg.version, config_checksum=cfg.checksum, model=setting.model,\n   268\t                       request_sha256=sha + ':malformed:' + uuid.uuid4().hex[:8], request_json=request_json,\n   269\t                       response_json=json.dumps(response)[:200000], answer_json=None, prompt_chars=prompt_chars,\n   270\t                       input_tokens=0, output_tokens=0, cost_usd=0.0, seconds=seconds, created_at=time.strftime('%Y-%m-%dT%H:%M:%S'))\n   271\t        raise SchemaError(f'malformed answer: {error}')\n   272\t    errors = check_schema(data, schema)\n   273\t    usage = response.get('usage') or {}\n   274\t    input_tokens = int(usage.get('prompt_tokens') or 0)\n   275\t    output_tokens = int(usage.get('completion_tokens') or 0)\n   276\t    cached_tokens = min(input_tokens, int((usage.get('prompt_tokens_details') or {}).get('cached_tokens') or 0))\n   277\t    price_in, price_out = PRICES.get(setting.model, (0.0, 0.0))\n   278\t    cost = round((input_tokens - cached_tokens) / 1e6 * price_in + cached_tokens / 1e6 * price_in * CACHED_INPUT_SHARE + output_tokens / 1e6 * price_out, 6)\n   279\t    call_id = archive.record(purpose=purpose, config_version=cfg.version, config_checksum=cfg.checksum, model=setting.model,\n   280\t                             request_sha256=sha if not errors else sha + ':schema:' + uuid.uuid4().hex[:8], request_json=request_json,\n   281\t                             response_json=json.dumps(response)[:200000], answer_json=json.dumps(data, ensure_ascii=False),\n     1\t\"\"\"Pull mode (D54, D356): at the end of a day (the day passed in, never read from a clock), every open view whose due day has come\n     2\tis frozen where its state stands and closed. The closing record names the rung it froze at; a view that was never judged closes\n     3\twith \"no data to verify\" (AGENTS §8: missing data is neither a pass nor a fail). Nothing waits for the day's items, there is no\n     4\tseparate final review, and no other question is re-judged here.\"\"\"\n     5\tfrom . import dispatch\n     6\tfrom .views import store\n     7\t\n     8\tNO_DATA = 'no data to verify'\n     9\t\n    10\t\n    11\tdef closing_reason(conn, view_id, due_day, day):\n    12\t    last = conn.execute('select rung from judgements where view_id=? order by seq desc, judgement_id desc limit 1', (view_id,)).fetchone()\n    13\t    if last is None:\n    14\t        return f'due {due_day}, closed on {day} with no judgement: {NO_DATA}'\n    15\t    label = conn.execute('select label from rungs where view_id=? and position=?', (view_id, last['rung'])).fetchone()\n    16\t    return f'due {due_day}, frozen on {day} at rung {last[\"rung\"]} {label[\"label\"] if label else \"\"}'.rstrip()\n    17\t\n    18\t\n    19\tdef closing_sequence(conn, day, seq):\n    20\t    \"\"\"The sequence number the day's closings are written under, so that they are dated on that day: the day's last number when\n    21\t    the day wrote it, else a new one recorded as the day's own step (a day with no items would otherwise date them on the day before).\"\"\"\n    22\t    row = conn.execute('select min(publication_day) from processing_steps where sequence_no=?', (seq,)).fetchone()\n    23\t    if seq > 0 and row[0] == day:\n    24\t        return seq\n    25\t    own = max(store.next_sequence(conn), seq + 1)\n    26\t    dispatch.mark(conn, {'input_id': f'day:{day}', 'publication_day': day}, own, 'closed', 'ok', 'due questions closed at the end of the day')\n    27\t    return own\n    28\t\n    29\t\n    30\tdef end_of_day(conn, day, seq):\n    31\t    due = [row for row in conn.execute('select view_id, due_day from views where due_day <= ? order by created_seq', (day,)).fetchall()\n    32\t           if store.is_open(conn, row['view_id'])]\n    33\t    if due:\n    34\t        seq = closing_sequence(conn, day, seq)\n    35\t    for row in due:\n    36\t        store.close_view(conn, row['view_id'], closing_reason(conn, row['view_id'], row['due_day'], day), 'pull', seq)\n    37\t    conn.commit()\n    38\t    return [row['view_id'] for row in due]\n","exit_code":0,"status":"completed"}}
