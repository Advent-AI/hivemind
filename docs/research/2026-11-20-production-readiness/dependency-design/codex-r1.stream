1014:      \"dependencies\": {\npoc/ui/package-lock.json:1027:      \"dependencies\": {\npoc/ui/package-lock.json:1098:      \"dependencies\": {\npoc/ui/package-lock.json:1108:      \"dependencies\": {\npoc/ui/package-lock.json:1125:      \"dependencies\": {\npoc/ui/package-lock.json:1144:      \"dependencies\": {\npoc/ui/package-lock.json:1170:      \"dependencies\": {\npoc/ui/package-lock.json:1220:      \"dependencies\": {\npoc/ui/package-lock.json:1254:      \"dependencies\": {\npoc/ui/package-lock.json:1264:      \"dependencies\": {\npoc/ui/package-lock.json:1278:      \"dependencies\": {\npoc/ui/package-lock.json:1294:      \"dependencies\": {\npoc/ui/package-lock.json:1324:      \"dependencies\": {\npoc/ui/package-lock.json:1342:      \"dependencies\": {\npoc/ui/package-lock.json:1358:      \"dependencies\": {\npoc/ui/package-lock.json:1430:      \"dependencies\": {\npoc/ui/package-lock.json:1460:      \"dependencies\": {\npoc/ui/package-lock.json:1483:      \"dependencies\": {\npoc/ui/package-lock.json:1496:      \"dependencies\": {\npoc/ui/package-lock.json:1506:      \"dependencies\": {\npoc/ui/test/library.test.js:6:import { groupsFor, isSuperseded, dependenciesAt, snapshotThesis } from '../src/model/thesis.js';\npoc/ui/test/library.test.js:41:test('D275: group membership is dated and never presented as a dependency', () => {\npoc/ui/test/library.test.js:75:test('D275: waiting dependencies resolve only from the recorded date', () => {\npoc/ui/test/library.test.js:77:  thesis.dependencies = [\npoc/ui/test/library.test.js:87:  assert.equal(dependenciesAt(thesis, '2026-07-25')[0].depends_on, null);\npoc/ui/test/library.test.js:88:  assert.equal(dependenciesAt(thesis, '2026-07-26')[0].depends_on, 'v3');\npoc/ui/test/contract.test.js:62:    for (const d of v.dependencies) assert.match(d.day, /^\\d{4}-\\d{2}-\\d{2}$/);\npoc/ui/test/model.test.js:54:      t.dependencies.map((d) => ({\npoc/ui/test/model.test.js:63:    !snapshotThesis(relation.t, addDays(relation.d.day, -1)).dependencies.includes(relation.d),\npoc/ui/test/model.test.js:70:test('D130: related theses respect the same dated dependency graph in both directions', () => {\npoc/ui/test/model.test.js:75:        thesis.dependencies.some((d) => d.depends_on === other.id) ||\npoc/ui/test/model.test.js:76:          other.dependencies.some((d) => d.depends_on === thesis.id),\npoc/ui/test/english.test.js:78:    dependencies: [],\npoc/ui/test/fixtures/idea-card-v3.json:27030:          \"quote\": \"NVIDIA is the superior growth compounder and arguably the more exciting stock, but concentration in one end-market, hyperscaler dependency, insider selling, and a dividend yield that rounds to zero disqualify it as a retirement anchor.\",\npoc/ui/test/fixtures/idea-card-v3.json:32838:          \"quote\": \"Moreover, skeptics emphasize that major cloud service providers maintain long-term incentives to design and deploy in-house custom application-specific integrated circuits, which threatens long-term platform dependency.\",\npoc/ui/test/fixtures/idea-card-v3.json:33172:      \"dependencies\": [\npoc/ui/test/fixtures/idea-card-v3.json:35287:      \"dependencies\": [\npoc/ui/test/fixtures/idea-card-v3.json:68794:          \"quote\": \"Moreover, skeptics emphasize that major cloud service providers maintain long-term incentives to design and deploy in-house custom application-specific integrated circuits, which threatens long-term platform dependency.\",\npoc/ui/test/fixtures/idea-card-v3.json:69272:      \"dependencies\": [\npoc/ui/test/fixtures/idea-card-v3.json:71700:      \"dependencies\": [],\npoc/ui/test/fixtures/idea-card-v3.json:78402:          \"quote\": \"The concern is that these financial dependencies mean that if one deal falls apart, it could lead to a domino effect that engulfs not only the AI industry, but the entire global economy , given how much money is at stake.\",\npoc/ui/test/fixtures/idea-card-v3.json:79024:      \"dependencies\": [],\npoc/ui/test/fixtures/idea-card-v3.json:79124:      \"dependencies\": [],\npoc/ui/test/fixtures/idea-card-v3.json:79526:      \"dependencies\": [\npoc/ui/test/fixtures/idea-card-v3.json:79659:      \"dependencies\": [\npoc/ui/test/fixtures/idea-card-v3.json:79896:      \"dependencies\": [\npoc/ui/test/fixtures/idea-card-v3.json:80608:      \"dependencies\": [\npoc/ui/test/fixtures/idea-card-v3.json:81148:      \"dependencies\": [\npoc/ui/test/fixtures/idea-card-v3.json:82195:      \"dependencies\": [\npoc/ui/test/fixtures/idea-card-v3.json:82408:      \"dependencies\": [\n     1\t\"\"\"TypeSafe Jev (https://docs.typesafe.ai): typed answers over one state, no generated text. A request is `{model, state,\n     2\tquestions}`; each question is `noul` (yes/no → a probability), `choice` (labelled options → `choice`, `probabilities`,\n     3\t`confidence`) or `score`. Every call is archived in `model_calls` like every other model call, keyed by the request's\n     4\tdigest, so a byte-identical request is served from the archive; input is priced from `model.PRICES`, output is free.\"\"\"\n     5\timport http.client\n     6\timport json\n     7\timport os\n     8\timport time\n     9\timport urllib.error\n    10\timport urllib.request\n    11\timport uuid\n    12\t\n    13\tfrom . import model\n    14\t\n    15\tENDPOINT = 'https://api.typesafe.ai/v1/systemone'\n    16\tKEY_NAME = 'TYPESAFE_API_KEY'\n    17\tRETRY_STATUSES = {429, 529}\n    18\tATTEMPTS = 3\n    19\t\n    20\t\n    21\tdef _key():\n    22\t    if os.environ.get(KEY_NAME):\n    23\t        return os.environ[KEY_NAME]\n    24\t    with open(model.CREDENTIALS, encoding='utf-8') as handle:\n    25\t        return json.load(handle)[KEY_NAME]\n    26\t\n    27\t\n    28\tdef transport(request, timeout=60):\n    29\t    \"\"\"POST the request; up to three attempts, pausing before each retry, on a rate-limit or overload status or a\n    30\t    connection that fails without a reply; any other failure is a TransportError. The body is the same sorted text the\n    31\t    archive digests, so a cache hit is byte-identical to what was sent.\"\"\"\n    32\t    body = json.dumps(request, sort_keys=True, ensure_ascii=False).encode('utf-8')\n    33\t    key = _key()\n    34\t    for attempt in range(ATTEMPTS):\n    35\t        req = urllib.request.Request(ENDPOINT, body, {'Authorization': 'Bearer ' + key, 'Content-Type': 'application/json', 'Accept': 'application/json'})\n    36\t        try:\n    37\t            with urllib.request.urlopen(req, timeout=timeout) as response:\n    38\t                raw = response.read()\n    39\t            break\n    40\t        except urllib.error.HTTPError as error:\n    41\t            if error.code not in RETRY_STATUSES or attempt == ATTEMPTS - 1:\n    42\t                raise model.TransportError(f'Jev HTTP {error.code}') from None\n    43\t        except (urllib.error.URLError, OSError, http.client.HTTPException) as error:   # a dropped or truncated reply\n    44\t            if attempt == ATTEMPTS - 1:\n    45\t                raise model.TransportError(f'Jev transport failed: {type(error).__name__}') from None\n    46\t        time.sleep(2 * (attempt + 1))\n    47\t    if key.encode('utf-8') in raw:\n    48\t        raise model.TransportError('Jev response echoed the credential; not archived')\n    49\t    return json.loads(raw.decode('utf-8'))\n    50\t\n    51\t\n    52\t# Jev reports each probability rounded to two decimals independently of the choice it made on the unrounded values, so the\n    53\t# chosen option may print one unit below another (0.47 against 0.48; 1 of 2,353 archived choice answers on 2026-10-25).\n    54\tROUNDING = 0.01\n    55\t\n    56\t\n    57\tdef validate(answers, questions):\n    58\t    \"\"\"The answers of a response against the request's questions; a list of problems.\"\"\"\n    59\t    problems = []\n    60\t    if not isinstance(answers, dict) or set(answers) != set(questions):\n    61\t        return ['answer set differs from the questions asked']\n    62\t    for qid, question in questions.items():\n    63\t        answer = answers[qid]\n    64\t        if not isinstance(answer, dict) or answer.get('type') != question['type']:\n    65\t            problems.append(f'{qid}: answer type mismatch')\n    66\t            continue\n    67\t        if question['type'] == 'noul':\n    68\t            if not isinstance(answer.get('noul'), (int, float)) or not 0 <= answer['noul'] <= 1:\n    69\t                problems.append(f'{qid}: noul out of range')\n    70\t        elif question['type'] == 'choice':\n    71\t            probabilities = answer.get('probabilities')\n    72\t            if answer.get('choice') not in question['criteria'] or not isinstance(probabilities, dict) or set(probabilities) != set(question['criteria']):\n    73\t                problems.append(f'{qid}: choice or probabilities do not match the criteria')\n    74\t            elif any(not isinstance(v, (int, float)) or isinstance(v, bool) or not 0 <= v <= 1 for v in probabilities.values()) \\\n    75\t                    or abs(sum(probabilities.values()) - 1) > 0.005 * len(probabilities) + 1e-9:\n    76\t                problems.append(f'{qid}: probabilities are not a distribution')\n    77\t            elif probabilities[answer['choice']] < max(probabilities.values()) - ROUNDING - 1e-9:\n    78\t                problems.append(f'{qid}: choice is not the most probable option')\n    79\t    return problems\n    80\t\n    81\t\n    82\tdef request_for(setting, state, questions):\n    83\t    \"\"\"The complete Jev request used both for dispatch and in-flight identity.\"\"\"\n    84\t    return {'model': setting.model, 'state': state, 'questions': questions}\n    85\t\n    86\t\n    87\tdef ask(archive, cfg, setting, state, questions, purpose, *, transport=None):\n    88\t    \"\"\"One Jev request, archived; returns model.Answer whose data is the `answers` map.\"\"\"\n    89\t    request = request_for(setting, state, questions)\n    90\t    request_json, sha = model.request_identity(request)\n    91\t    prompt_chars = len(request_json)\n    92\t    hit = archive.lookup(sha)\n    93\t    if hit:\n    94\t        call_id, answer_json, _, input_tokens, output_tokens = hit\n    95\t        return model.Answer(json.loads(answer_json), call_id, sha, True, prompt_chars, input_tokens or 0, output_tokens or 0, 0.0)\n    96\t    started = time.time()\n    97\t    response = (transport or globals()['transport'])(request)\n    98\t    seconds = round(time.time() - started, 2)\n    99\t    answers = response.get('answers') if isinstance(response, dict) else None\n   100\t    problems = validate(answers, questions)\npoc/data/comparison-2026-11-17/run/old-2/prod/archive.sqlite\npoc/data/comparison-2026-11-17/run/old-2/prod/replay.log\npoc/data/comparison-2026-11-17/run/old-2/prod/views.sqlite\npoc/data/comparison-2026-11-17/run/old-2/launch.lock\npoc/data/comparison-2026-11-17/run/old-2/prod.log\npoc/data/comparison-2026-11-17/run/old-2/run.json\npoc/data/comparison-2026-11-17/run/old-2/preconditions.log\n     1\t\"\"\"Alex's A (2026-11-20): does a Data Center question answer consistently with the total-revenue question once it reads that\n     2\tquestion's conclusion through a dependency? Probe on the three finished poc-v118 draws (release comparison old-1..3).\n     3\t\n     4\t  python3 probe.py check <scratch>          # $0: rebuild each Data Center question's last stored request through production code,\n     5\t                                            #     prove it byte-equal to the stored one, build the changed request, print both sizes\n     6\t  python3 probe.py send <scratch> <out>     # paid: old-2 only (council round 3): control (as stored) and changed, three samples each\n     7\t\n     8\tThe finished stores are opened read-only. Each draw's scratch copy is rolled back to the moment before the Data Center question's\n     9\tlast judgement (that row and every later judgement removed); the control request must then reproduce the stored request's sha256.\n    10\tThe changed copy adds one dependency row (Data Center reads total revenue, `first_is_bullish`); production code renders it.\n    11\tEvery sample goes to its own new archive (an existing path refuses the send), so no answer is a cached replay. A refused answer is\n    12\tretried once with production's note, and both attempts are kept. Each call makes one transport attempt; before it, the worst case (one\n    13\ttoken per character of the serialized request plus the full output allowance) is reserved against the cap, and stays charged when\n    14\tthe call fails with its usage unknown. A cap stop before both arms have three samples is reported as inconclusive.\n    15\t\"\"\"\n    16\timport json, sqlite3, sys\n    17\tfrom pathlib import Path\n    18\t\n    19\tREPO = Path(__file__).resolve().parents[4]\n    20\tsys.path.insert(0, str(REPO / 'src'))\n    21\tfrom hivemind import config, model                     # noqa: E402\n    22\tfrom hivemind.views import judging                     # noqa: E402\n    23\t\n    24\tRUNS = REPO / 'poc/data/comparison-2026-11-17/run'\n    25\tPAIRS = {'old-1': ('v8', 'v4'), 'old-2': ('v9', 'v14'), 'old-3': ('v35', 'v3')}   # (Data Center FY2027, total revenue FY2027)\n    26\tSEND_DRAWS = ('old-2',)                                # council round 3: the only draw whose shown total carries both FY and Q4\n    27\tSAMPLES = 3\n    28\tCAP_USD = 0.15                                         # 6 sends (about $0.006 each) and their retries; each call reserves about $0.017\n    29\t\n    30\t\n    31\tdef one_attempt(provider, request):\n    32\t    \"\"\"Production's transport with a single attempt, so every possible charge is reserved before it is made.\"\"\"\n    33\t    return model.openai_transport(provider, request, max_attempts=1)\n    34\t\n    35\t\n    36\tdef prepared(scratch, draw, with_dependency):\n    37\t    data_center, total = PAIRS[draw]\n    38\t    source = sqlite3.connect(f'file:{RUNS / draw}/prod/views.sqlite?mode=ro', uri=True)\n    39\t    path = scratch / f'{draw}-{\"changed\" if with_dependency else \"control\"}.sqlite'\n    40\t    path.unlink(missing_ok=True)\n    41\t    copy = sqlite3.connect(path)\n    42\t    source.backup(copy)\n    43\t    source.close()\n    44\t    copy.row_factory = sqlite3.Row\n    45\t    last = copy.execute('select judgement_id, seq, request_sha256, publication_day from judgements where view_id=? order by judgement_id desc limit 1',\n    46\t                        (data_center,)).fetchone()\n    47\t    copy.execute('drop trigger judgements_no_delete')\n    48\t    copy.execute('delete from judgements where judgement_id=? or seq>?', (last['judgement_id'], last['seq']))\n    49\t    if with_dependency:\n    50\t        copy.execute(\"insert into dependencies(view_id, depends_on, wait_chain_view_id, wait_year, direction, seq) values (?, ?, '', '', 'first_is_bullish', ?)\",\n    51\t                     (data_center, total, last['seq']))\n    52\t    copy.commit()\n    53\t    return copy, dict(last)\n    54\t\n    55\t\n    56\tdef requests(scratch):\n    57\t    cfg = config.load(str(REPO / 'poc/config/poc-v118.json'))\n    58\t    version = cfg.rejudging.prompt_version\n    59\t    schema = judging.schema_for(version)\n    60\t    out = {}\n    61\t    for draw, (data_center, total) in PAIRS.items():\n    62\t        for arm in ('control', 'changed'):\n    63\t            conn, last = prepared(scratch, draw, arm == 'changed')\n    64\t            system, user = judging.build_prompt(conn, data_center, version)\n    65\t            request = model.build_request(cfg.rejudging, system, user, schema, 'judgement', cfg.provider)\n    66\t            _, sha = model.request_identity(request)\n    67\t            out[(draw, arm)] = {'conn': conn, 'system': system, 'user': user, 'sha': sha, 'stored_sha': last['request_sha256'],\n    68\t                                'day': last['publication_day'], 'seq': last['seq']}\n    69\t    return cfg, schema, out\n    70\t\n    71\t\n    72\tdef check(scratch):\n    73\t    _, _, built = requests(scratch)\n    74\t    ok = True\n    75\t    for (draw, arm), r in built.items():\n    76\t        same = r['sha'] == r['stored_sha']\n    77\t        if arm == 'control' and not same:\n    78\t            ok = False\n    79\t        added = len(r['user']) - len(built[(draw, 'control')]['user'])\n    80\t        print(f'{draw} {arm}: day {r[\"day\"]} seq {r[\"seq\"]} chars {len(r[\"user\"])} (+{added}) sha {\"== stored\" if same else \"differs\"}')\n    81\t    print('control requests byte-equal to the stored ones:', ok)\n    82\t    return ok\n    83\t\n    84\t\n    85\tdef send(scratch, out_dir):\n    86\t    cfg, schema, built = requests(scratch)\n    87\t    if not all(r['sha'] == r['stored_sha'] for (draw, arm), r in built.items() if arm == 'control'):\n    88\t        raise SystemExit('a control request differs from the stored one: nothing sent')\n    89\t    out_dir.mkdir(parents=True, exist_ok=True)\n    90\t    spent, rows = 0.0, []\n    91\t    price_in, price_out = model.PRICES[cfg.rejudging.model]\n    92\t    for sample in range(1, SAMPLES + 1):\n    93\t        for (draw, arm), r in built.items():\n    94\t            if draw not in SEND_DRAWS:\n    95\t                continue\n    96\t            data_center = PAIRS[draw][0]\n    97\t            archive_path = scratch / f'archive-{draw}-{arm}-{sample}.sqlite'\n    98\t            if archive_path.exists():\n    99\t                raise SystemExit(f'{archive_path} exists: a sample needs a new archive')\n   100\t            archive = model.Archive(str(archive_path))\n   101\t            attempts, note = [], ''\n   102\t            for attempt in (1, 2):\n   103\t                # hard bound (council round 5): one transport attempt per call, reserved at one token per character of the full\n   104\t                # serialized request plus the full output allowance; when usage is unknown (an exception) the reservation stays charged\n   105\t                request = model.build_request(cfg.rejudging, r['system'], r['user'] + note, schema, 'judgement', cfg.provider)\n   106\t                worst = len(json.dumps(request)) / 1e6 * price_in + cfg.rejudging.max_output_tokens / 1e6 * price_out\n   107\t                if spent + worst > CAP_USD:\n   108\t                    raise SystemExit(f'cap: spent ${spent:.4f} + worst ${worst:.4f} > ${CAP_USD}; stopped before {draw} {arm} {sample}: inconclusive')\n   109\t                try:\n   110\t                    answer = model.call(archive, cfg, cfg.rejudging, r['system'], r['user'] + note, schema, 'judgement', 'judge',\n   111\t                                        transport=one_attempt)\n   112\t                except Exception as error:                     # transport failure or malformed answer: usage unknown\n   113\t                    spent += worst\n   114\t                    attempts.append({'attempt': attempt, 'errors': [f'{type(error).__name__}: {error}'[:300]], 'cost': worst, 'answer': None})\n   115\t                    note = ''\n   116\t                    continue\n   117\t                charged = answer.cost_usd if (answer.input_tokens or answer.output_tokens) else worst   # a reply without usage keeps its reservation (round 6)\n   118\t                spent += charged\n   119\t                errors = judging.check_answer(r['conn'], data_center, answer.data, r['user'])\n   120\t                attempts.append({'attempt': attempt, 'errors': errors, 'cost': answer.cost_usd, 'answer': answer.data,\n   121\t                                 'input_tokens': answer.input_tokens, 'output_tokens': answer.output_tokens})\n   122\t                if not errors:\n   123\t                    break\n   124\t                note = judging.retry_note(errors)\n   125\t            row = {'draw': draw, 'arm': arm, 'sample': sample, 'view_id': data_center, 'attempts': attempts}\n   126\t            rows.append(row)\n   127\t            with open(out_dir / 'answers.jsonl', 'a', encoding='utf-8') as handle:\n   128\t                handle.write(json.dumps(row, ensure_ascii=False) + '\\n')\n   129\t            final = attempts[-1]['answer'] or {}\n   130\t            print(f'{draw} {arm} {sample}: rung {final.get(\"rung\")} refused {bool(attempts[-1][\"errors\"])} spent ${spent:.4f}', flush=True)\n   131\t    print(f'total spent ${spent:.4f}')\n   132\t\n   133\t\n   134\tif __name__ == '__main__':\n   135\t    mode, scratch = sys.argv[1], Path(sys.argv[2])\n   136\t    scratch.mkdir(parents=True, exist_ok=True)\n   137\t    if mode == 'check':\n   138\t        sys.exit(0 if check(scratch) else 1)\n   139\t    send(scratch, Path(sys.argv[3]))\n","exit_code":0,"status":"completed"}}
