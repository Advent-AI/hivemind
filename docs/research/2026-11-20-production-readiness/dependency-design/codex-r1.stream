': None}\nsrc/hivemind/search.py:262:    corpus = service.summaries(ledger, as_of, include_closed=True)                              # every view visible at the bound\nsrc/hivemind/search.py:284:                        'due_day': record['due_day'], 'open': record['open'], 'dependencies': record['dependencies'], 'dependants': record['dependants'],\nsrc/hivemind/search.py:290:        return {'query': query, 'as_of': as_of, 'mode': mode, 'missing_vectors': missing, 'results': None}     # no recorded view on anything the idea names\nsrc/hivemind/search.py:291:    return {'query': query, 'as_of': as_of, 'mode': mode, 'missing_vectors': missing, 'results': results[:k]}\nsrc/hivemind/bundle.py:2:evidence it cited, the evidence in force with tiers, speakers and sources, dependencies, replacements and the freeze\nsrc/hivemind/bundle.py:4:end's adapter reads both. Read-only on every database. With `as_of`, rows written after that day are left out.\"\"\"\nsrc/hivemind/bundle.py:41:def _visible(views_db, seq, as_of):\nsrc/hivemind/bundle.py:42:    return as_of is None or service.visible(views_db, seq, as_of)\nsrc/hivemind/bundle.py:65:def not_judged(views_db, view_id, created_seq, as_of=None):\nsrc/hivemind/bundle.py:67:    legacy ledger, for a view with no row, and before the view's creation at as_of; [] when the row lists none. A malformed row,\nsrc/hivemind/bundle.py:70:    as_of = service.resolve_bound(views_db, as_of, unfiltered=True)\nsrc/hivemind/bundle.py:71:    if as_of is not None and not _visible(views_db, created_seq, as_of):\nsrc/hivemind/bundle.py:72:        raise KeyError(f'{view_id} is not available as of {as_of}')\nsrc/hivemind/bundle.py:100:def view_bundle(views_db, item_of, view_id, as_of=None):\nsrc/hivemind/bundle.py:103:    as_of = service.resolve_bound(views_db, as_of, unfiltered=True)\nsrc/hivemind/bundle.py:107:    if as_of is not None and not service.view_exists(views_db, v, as_of):\nsrc/hivemind/bundle.py:108:        raise KeyError(f'{view_id} is not available as of {as_of}')\nsrc/hivemind/bundle.py:113:                if _visible(views_db, r['after_seq'], as_of)]\nsrc/hivemind/bundle.py:118:        if as_of is not None and j['publication_day'] > as_of:\nsrc/hivemind/bundle.py:126:        if not _visible(views_db, e['linked_seq'], as_of):\nsrc/hivemind/bundle.py:129:                   if _visible(views_db, s['seq'], as_of)]\nsrc/hivemind/bundle.py:131:        if replaced_by is not None and not _visible(views_db, replaced_by['seq'], as_of):\nsrc/hivemind/bundle.py:134:        if replaces and not _visible(views_db, replaces['seq'], as_of):\nsrc/hivemind/bundle.py:150:    dependencies = [dict(r) for r in views_db.execute('select dependency_id, depends_on, direction, wait_chain_view_id, wait_year, seq from dependencies where view_id=? order by dependency_id', (view_id,))\nsrc/hivemind/bundle.py:151:                    if _visible(views_db, r['seq'], as_of)]\nsrc/hivemind/bundle.py:152:    for dependency in dependencies:\nsrc/hivemind/bundle.py:153:        dependency['day'] = service.day_of_seq(views_db, dependency['seq'])\nsrc/hivemind/bundle.py:154:        dependency['resolutions'] = [dict(target=r['resolved_to'], day=service.day_of_seq(views_db, r['seq']), seq=r['seq'])\nsrc/hivemind/bundle.py:155:                                    for r in views_db.execute('select resolved_to, seq from dependency_resolutions where dependency_id=? order by id', (dependency['dependency_id'],))\nsrc/hivemind/bundle.py:156:                                    if _visible(views_db, r['seq'], as_of)]\nsrc/hivemind/bundle.py:157:    dependants = sorted({r['view_id'] for r in views_db.execute('select view_id, seq from dependencies where depends_on=?', (view_id,)) if _visible(views_db, r['seq'], as_of)},\nsrc/hivemind/bundle.py:166:                   if _visible(views_db, r['seq'], as_of)]\nsrc/hivemind/bundle.py:172:            'judgements': judgements, 'evidence': evidence, 'dependencies': dependencies, 'dependants': dependants,\nsrc/hi