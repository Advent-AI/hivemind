{"type":"item.started","item":{"id":"item_4","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba docs/research/2026-11-20-production-readiness/dependency-probe/probe.py | sed -n '20,160p'; ls docs/research/2026-11-20-production-readiness/dependency-probe\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/opt/homebrew/bin/zsh -lc \"nl -ba docs/research/2026-11-20-production-readiness/dependency-probe/probe.py | sed -n '20,160p'; ls docs/research/2026-11-20-production-readiness/dependency-probe\"","aggregated_output":"    20\tfrom hivemind import config, model                     # noqa: E402\n    21\tfrom hivemind.views import judging                     # noqa: E402\n    22\t\n    23\tRUNS = REPO / 'poc/data/comparison-2026-11-17/run'\n    24\tPAIRS = {'old-1': ('v8', 'v4'), 'old-2': ('v9', 'v14'), 'old-3': ('v35', 'v3')}   # (Data Center FY2027, total revenue FY2027)\n    25\tSEND_DRAWS = ('old-2',)                                # council round 3: the only draw whose shown total carries both FY and Q4\n    26\tSAMPLES = 3\n    27\tCAP_USD = 0.15                                         # 6 sends and up to 6 retries at a worst case of about $0.011 each\n    28\t\n    29\t\n    30\tdef prepared(scratch, draw, with_dependency):\n    31\t    data_center, total = PAIRS[draw]\n    32\t    source = sqlite3.connect(f'file:{RUNS / draw}/prod/views.sqlite?mode=ro', uri=True)\n    33\t    path = scratch / f'{draw}-{\"changed\" if with_dependency else \"control\"}.sqlite'\n    34\t    path.unlink(missing_ok=True)\n    35\t    copy = sqlite3.connect(path)\n    36\t    source.backup(copy)\n    37\t    source.close()\n    38\t    copy.row_factory = sqlite3.Row\n    39\t    last = copy.execute('select judgement_id, seq, request_sha256, publication_day from judgements where view_id=? order by judgement_id desc limit 1',\n    40\t                        (data_center,)).fetchone()\n    41\t    copy.execute('drop trigger judgements_no_delete')\n    42\t    copy.execute('delete from judgements where judgement_id=? or seq>?', (last['judgement_id'], last['seq']))\n    43\t    if with_dependency:\n    44\t        copy.execute(\"insert into dependencies(view_id, depends_on, wait_chain_view_id, wait_year, direction, seq) values (?, ?, '', '', 'first_is_bullish', ?)\",\n    45\t                     (data_center, total, last['seq']))\n    46\t    copy.commit()\n    47\t    return copy, dict(last)\n    48\t\n    49\t\n    50\tdef requests(scratch):\n    51\t    cfg = config.load(str(REPO / 'poc/config/poc-v118.json'))\n    52\t    version = cfg.rejudging.prompt_version\n    53\t    schema = judging.schema_for(version)\n    54\t    out = {}\n    55\t    for draw, (data_center, total) in PAIRS.items():\n    56\t        for arm in ('control', 'changed'):\n    57\t            conn, last = prepared(scratch, draw, arm == 'changed')\n    58\t            system, user = judging.build_prompt(conn, data_center, version)\n    59\t            request = model.build_request(cfg.rejudging, system, user, schema, 'judgement', cfg.provider)\n    60\t            _, sha = model.request_identity(request)\n    61\t            out[(draw, arm)] = {'conn': conn, 'system': system, 'user': user, 'sha': sha, 'stored_sha': last['request_sha256'],\n    62\t                                'day': last['publication_day'], 'seq': last['seq']}\n    63\t    return cfg, schema, out\n    64\t\n    65\t\n    66\tdef check(scratch):\n    67\t    _, _, built = requests(scratch)\n    68\t    ok = True\n    69\t    for (draw, arm), r in built.items():\n    70\t        same = r['sha'] == r['stored_sha']\n    71\t        if arm == 'control' and not same:\n    72\t            ok = False\n    73\t        added = len(r['user']) - len(built[(draw, 'control')]['user'])\n    74\t        print(f'{draw} {arm}: day {r[\"day\"]} seq {r[\"seq\"]} chars {len(r[\"user\"])} (+{added}) sha {\"== stored\" if same else \"differs\"}')\n    75\t    print('control requests byte-equal to the stored ones:', ok)\n    76\t    return ok\n    77\t\n    78\t\n    79\tdef send(scratch, out_dir):\n    80\t    cfg, schema, built = requests(scratch)\n    81\t    if not all(r['sha'] == r['stored_sha'] for (draw, arm), r in built.items() if arm == 'control'):\n    82\t        raise SystemExit('a control request differs from the stored one: nothing sent')\n    83\t    out_dir.mkdir(parents=True, exist_ok=True)\n    84\t    spent, rows = 0.0, []\n    85\t    price_in, price_out = model.PRICES[cfg.rejudging.model]\n    86\t    for sample in range(1, SAMPLES + 1):\n    87\t        for (draw, arm), r in built.items():\n    88\t            if draw not in SEND_DRAWS:\n    89\t                continue\n    90\t            data_center = PAIRS[draw][0]\n    91\t            archive_path = scratch / f'archive-{draw}-{arm}-{sample}.sqlite'\n    92\t            if archive_path.exists():\n    93\t                raise SystemExit(f'{archive_path} exists: a sample needs a new archive')\n    94\t            archive = model.Archive(str(archive_path))\n    95\t            attempts, note = [], ''\n    96\t            for attempt in (1, 2):\n    97\t                worst = (len(r['system']) + len(r['user']) + len(note)) / 3 / 1e6 * price_in + cfg.rejudging.max_output_tokens / 1e6 * price_out\n    98\t                if spent + worst > CAP_USD:\n    99\t                    raise SystemExit(f'cap: spent ${spent:.4f} + worst ${worst:.4f} > ${CAP_USD}; stopped before {draw} {arm} {sample}')\n   100\t                answer = model.call(archive, cfg, cfg.rejudging, r['system'], r['user'] + note, schema, 'judgement', 'judge')\n   101\t                spent += answer.cost_usd\n   102\t                errors = judging.check_answer(r['conn'], data_center, answer.data, r['user'])\n   103\t                attempts.append({'attempt': attempt, 'errors': errors, 'cost': answer.cost_usd, 'answer': answer.data,\n   104\t                                 'input_tokens': answer.input_tokens, 'output_tokens': answer.output_tokens})\n   105\t                if not errors:\n   106\t                    break\n   107\t                note = judging.retry_note(errors)\n   108\t            row = {'draw': draw, 'arm': arm, 'sample': sample, 'view_id': data_center, 'attempts': attempts}\n   109\t            rows.append(row)\n   110\t            with open(out_dir / 'answers.jsonl', 'a', encoding='utf-8') as handle:\n   111\t                handle.write(json.dumps(row, ensure_ascii=False) + '\\n')\n   112\t            print(f'{draw} {arm} {sample}: rung {attempts[-1][\"answer\"].get(\"rung\")} refused {bool(attempts[-1][\"errors\"])} spent ${spent:.4f}', flush=True)\n   113\t    print(f'total spent ${spent:.4f}')\n   114\t\n   115\t\n   116\tif __name__ == '__main__':\n   117\t    mode, scratch = sys.argv[1], Path(sys.argv[2])\n   118\t    scratch.mkdir(parents=True, exist_ok=True)\n   119\t    if mode == 'check':\n   120\t        sys.exit(0 if check(scratch) else 1)\n   121\t    send(scratch, Path(sys.argv[3]))\ncheck.txt\ncodex-r3.md\ncodex-r3.stream\ncodex-r4.md\ncodex-r4.stream\ndesign.md\nprobe.py\nreading-rule.md\nrender-check.json\nrender_check.py\n","exit_code":0,"status":"completed"}}
