     1	"""The answer-choice step on gpt-6-astra for the release comparison (D667 item 1, plan §1.5 D). `stage_a.py` is run as it is, with
     2	two additions and nothing else:
     3	- `stage_a.SETTING` is the frozen setting with the model set to gpt-6-astra (the pattern of reflection-6's gate1_candidate.py);
     4	- every request, the first send and the resend with its refusal note alike, is rebuilt from the same system text, user text and
     5	  schema through `model.build_request` twice, once on the frozen luna setting and once on astra. The two must be byte-equal except
     6	  for the model string, and the request reaching the transport must be the astra one. Any difference raises before the reservation,
     7	  so nothing is sent; stage_a's worker then stops its run, and with a shared ledger the draw.
     8	
     9	Reservations, retries and the stop gate stay stage_a's own (StageALimit, the shared ledger).
    10	
    11	    python3 stage_a_astra.py <stage_a.py's arguments>
    12	"""
    13	import dataclasses
    14	import importlib.util
    15	import json
    16	import sys
    17	import threading
    18	from pathlib import Path
    19	
    20	ROOT = Path('/Users/lchingen/hivemind')
    21	STAGE_A = ROOT / 'clean-arch/step4-2026-11-10/stage_a/stage_a.py'
    22	ASTRA_MODEL = 'gpt-6-astra'
    23	
    24	
    25	class NotTheFrozenRequest(RuntimeError):
    26	    """A request differs from the frozen luna request by more than its model string."""
    27	
    28	
    29	def load_stage_a():
    30	    spec = importlib.util.spec_from_file_location('stage_a', STAGE_A)
    31	    module = importlib.util.module_from_spec(spec)
    32	    sys.modules['stage_a'] = module
    33	    spec.loader.exec_module(module)
    34	    return module
    35	
    36	
    37	def install(stage_a):
    38	    """Switch `stage_a` to astra with the per-request check. Returns (luna setting, astra setting)."""
    39	    luna = stage_a.SETTING
    40	    if luna.model != 'gpt-6-luna':
    41	        raise SystemExit(f'stage_a.SETTING is {luna.model}, not the frozen gpt-6-luna: refused')
    42	    astra = dataclasses.replace(luna, model=ASTRA_MODEL)
    43	    model = stage_a.model
    44	    expected = threading.local()
    45	    original_caller = stage_a.model_calls.model_caller
    46	    original_send = stage_a.StageALimit.send_labelled
    47	
    48	    def model_caller(model_module, archive, call_config, setting, limit, purpose='clean-ladder'):
    49	        if setting.model != ASTRA_MODEL:
    50	            raise NotTheFrozenRequest(f'the caller was given {setting.model}, not {ASTRA_MODEL}')
    51	        call_model = original_caller(model_module, archive, call_config, setting, limit, purpose)
    52	
    53	        def checked(system_text, user_text, schema):
    54	            frozen = json.dumps(model.build_request(luna, system_text, user_text, schema, 'clean_ladder', call_config.provider))
    55	            built = json.dumps(model.build_request(astra, system_text, user_text, schema, 'clean_ladder', call_config.provider))
    56	            if frozen.count('"model": "gpt-6-luna"') != 1 or built != frozen.replace('"model": "gpt-6-luna"', f'"model": "{ASTRA_MODEL}"'):
    57	                raise NotTheFrozenRequest('the astra request differs from the frozen request beyond the model string')
    58	            expected.request = built
    59	            return call_model(system_text, user_text, schema)
    60	        return checked
    61	
    62	    def send_labelled(self, label, provider, request):
    63	        if json.dumps(request) != getattr(expected, 'request', None):
    64	            raise NotTheFrozenRequest(f'{label}: the request at the transport is not the checked astra request')
    65	        return original_send(self, label, provider, request)
    66	
    67	    stage_a.SETTING = astra
    68	    stage_a.model_calls.model_caller = model_caller
    69	    stage_a.StageALimit.send_labelled = send_labelled
    70	    return luna, astra
    71	
    72	
    73	def configuration_checksum(stage_a):
    74	    """The `config_checksum` stage_a writes to every archive row under astra (its own formula, stage_a.run)."""
    75	    import hashlib
    76	    texts = stage_a.request_texts()
    77	    setting = stage_a.SETTING
    78	    return hashlib.sha256(json.dumps({'system': texts['system'], 'closing': texts['closing'], 'schema': texts['schema'],
    79	                                      'setting': [setting.model, setting.reasoning_effort, setting.max_output_tokens]},
    80	                                     ensure_ascii=False).encode()).hexdigest()[:16]
    81	
    82	
    83	if __name__ == '__main__':
    84	    module = load_stage_a()
    85	    install(module)
    86	    sys.argv[0] = str(STAGE_A)
    87	    module.main()
