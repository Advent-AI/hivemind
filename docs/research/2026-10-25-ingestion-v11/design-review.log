   138	def study_day(runner, transport):
   139	    def run(*args, **kwargs):
   140	        iterator = runner(*args, **kwargs)
   141	        try:
   142	            for result in iterator:
   143	                if result.failed:
   144	                    transport.stop('authoritative item failed')
   145	                yield result
   146	        except BaseException:
   147	            transport.stop('day cancelled or failed')
   148	            raise
   149	        finally:
   150	            iterator.close()
   151	    return run
