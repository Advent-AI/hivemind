   108	class StudyTransport:
   109	    """Shared across extraction, matching and judging; validate before freeing a slot."""
   110	
   111	    def __init__(self, guard, workers=2):
   112	        self.guard = guard
   113	        self.slots = threading.BoundedSemaphore(workers)
   114	        self.stopped = threading.Event()
   115	
   116	    def stop(self, reason):
   117	        self.guard.stop(reason)
   118	        self.stopped.set()
   119	
   120	    def __call__(self, *args):
   121	        with self.slots:
   122	            try:
   123	                response = self.guard(*args)
   124	                request = args[-1]
   125	                if len(args) == 2:
   126	                    value = json.loads(response['choices'][0]['message']['content'])
   127	                    errors = model.check_schema(value, request['response_format']['json_schema']['schema'])
   128	                else:
   129	                    errors = jev.validate(response.get('answers'), request['questions'])
   130	                if errors:
   131	                    raise model.SchemaError('; '.join(errors[:5]))
   132	                return response
   133	            except BaseException:
   134	                self.stop('terminal worker failure or cancellation')
   135	                raise
