    42	    model: str
    43	    prompt_version: str
    44	    temperature: float
    45	    reasoning_effort: str
    46	    max_output_tokens: int
    47	    engine: str = 'llm'       # matching only: 'llm' (the generative call) or 'jev' (TypeSafe Jev, views/jev_matching.py)
    48	
    49	
    50	ENGINES = ('llm', 'jev')
    51	
    52	
    53	@dataclasses.dataclass(frozen=True)
    54	class Config:
    55	    version: str
    56	    checksum: str
    57	    provider: str
    58	    search_top_n: int
    59	    extraction: dict          # category -> Setting
    60	    matching: Setting
    61	    rejudging: Setting
    62	    final_verdict: Setting
    63	    idea: Setting = None      # the service's reading of a user's idea (docs/poc/idea-card.md); absent in pipeline-only configs
    64	
    65	    def extraction_setting(self, category):
    66	        setting = self.extraction.get(category)
    67	        if setting is None:
    68	            raise ConfigError(f'no extraction setting for category {category} in config {self.version}')
    69	        return setting
    70	
