    72	REQUIRED = ('model', 'prompt_version', 'temperature', 'reasoning_effort', 'max_output_tokens')
    73	
    74	
    75	def _setting(name, raw):
    76	    if not isinstance(raw, dict):
    77	        raise ConfigError(f'setting {name} is missing')
    78	    missing = [key for key in REQUIRED if key not in raw]
    79	    if missing:
    80	        raise ConfigError(f'setting {name} lacks {missing}')
    81	    engine = str(raw.get('engine', 'llm'))
    82	    if engine not in ENGINES:
    83	        raise ConfigError(f'setting {name}: engine {engine!r} is not one of {ENGINES}')
    84	    return Setting(name=name, model=str(raw['model']), prompt_version=str(raw['prompt_version']),
    85	                   temperature=float(raw['temperature']), reasoning_effort=str(raw['reasoning_effort']),
    86	                   max_output_tokens=int(raw['max_output_tokens']), engine=engine)
