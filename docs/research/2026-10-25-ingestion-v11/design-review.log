    20	def _prompt_files(extraction, matching, rejudging, idea=None):
    21	    """03-config: a version that names a prompt that does not exist is refused whole. An extraction setting's
    22	    prompt_version is '<category>-<v>': block 2 and 4 come from categories-<v>.json (the category's entry) and the
    23	    role from role-<v>.txt; matching, re-judging and the idea reading name their file without the extension."""
    24	    for category, setting in extraction.items():
    25	        prefix, _, version = setting.prompt_version.rpartition('-')
    26	        if prefix != category or not version:
    27	            raise ConfigError(f'extraction.{category}: prompt_version {setting.prompt_version!r} must be {category}-<version>')
    28	        categories_file = prompt_path(f'categories-{version}.json')
    29	        if not os.path.exists(categories_file) or not os.path.exists(prompt_path(f'role-{version}.txt')):
    30	            raise ConfigError(f'extraction.{category}: prompts for version {version!r} do not exist')
    31	        with open(categories_file, encoding='utf-8') as handle:
    32	            if category not in json.load(handle):
    33	                raise ConfigError(f'extraction.{category}: categories-{version}.json has no entry for {category}')
    34	    for setting in (matching, rejudging, idea):
    35	        if setting is not None and not os.path.exists(prompt_path(setting.prompt_version + '.txt')):
    36	            raise ConfigError(f'{setting.name}: prompt {setting.prompt_version}.txt does not exist')
