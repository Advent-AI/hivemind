   225	def run_trial(directory, trial, *, live=False, transport=None):
   226	    directory = Path(directory).resolve()
   227	    if trial not in ORDER or contract(directory) != json.loads((directory / 'study.json').read_text()):
   228	        raise ValueError('unknown trial or changed study contract')
   229	    previous = ORDER[:ORDER.index(trial)]
   230	    for name in previous:
   231	        saved = json.loads((directory / name / 'result.json').read_text())
   232	        if saved['failure'] or saved['audit']['errors']:
   233	            raise ValueError('prior trial failed')
   234	    if protected_changes(directory):
   235	        raise ValueError('protected database changed')
   236	    folder = directory / trial
   237	    if folder.exists():
   238	        raise ValueError('trial already started; preserve it')
   239	    cfg, uni = configuration()
   240	    if transport is None:
   241	        if not live:
   242	            raise ValueError('explicit offline transport or --live required')
   243	        transport = StudyTransport(GuardedTransport(directory / 'budget.sqlite', single_attempt_http(), max_calls=144))
   244	    folder.mkdir()
