    13	class BudgetError(RuntimeError):
    14	    pass
    15	
    16	
    17	def envelope(provider, request):
    18	    """Reserve documented maximum usage, without guessing tokens from characters."""
    19	    if provider == 'openai' and request.get('model') == 'gpt-6-luna':
    20	        allowed = {'model', 'messages', 'response_format', 'reasoning_effort', 'max_completion_tokens'}
    21	        if set(request) - allowed:
    22	            raise BudgetError('unreviewed OpenAI request fields')
    23	        cap = request.get('max_completion_tokens')
    24	        if type(cap) is not int or not 1 <= cap <= 128000:
    25	            raise BudgetError('unreviewed OpenAI output limit')
    26	        # Full documented input bound and the requested output bound, including
    27	        # highest reviewed Standard rates and the 10% regional premium.
    28	        reserved = (922000 * 550 + cap * 825 + 999) // 1000
    29	        return reserved, 922000, cap
    30	    if provider == 'jev' and request.get('model') == 'jev-1.14.0':
    31	        if set(request) != {'model', 'state', 'questions'} or not request['questions']:
    32	            raise BudgetError('unreviewed Jev request shape')
    33	        tokens = 65536 * (len(request['questions']) + 1)
    34	        return (tokens * 42 + 999) // 1000, tokens, None
    35	    raise BudgetError('unreviewed provider or model')
    36	
    37	
    38	def charge(provider, response, max_input, max_output):
    39	    usage = response.get('usage', {}) if isinstance(response, dict) else {}
    40	    names = ('prompt_tokens', 'completion_tokens') if provider == 'openai' else ('input_tokens', 'output_tokens')
    41	    counts = [usage.get(k) for k in names]
    42	    if any(type(n) is not int or n < 0 for n in counts) or counts[0] > max_input or (max_output is not None and counts[1] > max_output):
    43	        raise BudgetError('missing, invalid or above-envelope usage')
    44	    a, b = counts
    45	    # Integer microdollars, rounded up. OpenAI uses the highest reviewed Standard rate,
    46	    # not an estimate of a discount or the provider's eventual bill.
    47	    cost = (a * 550 + b * 825 + 999) // 1000 if provider == 'openai' else (a * 42 + 999) // 1000
    48	    return cost
    49	
    50	
    51	class GuardedTransport:
    52	    """One coordinator's journal; unresolved work survives crashes and closes admission."""
    53	
    54	    def __init__(self, path, prepare, *, cap_microdollars=1500000, max_calls=36):
    55	        path = Path(path)
    56	        if not path.is_absolute() or type(cap_microdollars) is not int or cap_microdollars <= 0 or type(max_calls) is not int or max_calls <= 0:
    57	            raise ValueError('absolute journal path and positive integer limits required')
    58	        self.lock, self.prepare = threading.Lock(), prepare
    59	        self.conn = sqlite3.connect(path, check_same_thread=False)
    60	        self.conn.executescript('''
    61	            create table if not exists settings (id integer primary key check(id=1), cap integer, max_calls integer, halted text);
    62	            create table if not exists attempts (
    63	              id integer primary key, provider text, request_sha256 text, request_json text,
    64	              reserved integer, charged integer, state text, response_json text, error text,
    65	              seconds real, completed_order integer);
    66	        ''')
    67	        row = self.conn.execute('select cap,max_calls,halted from settings').fetchone()
    68	        if row is None:
    69	            self.conn.execute('insert into settings values (1,?,?,NULL)', (cap_microdollars, max_calls))
    70	        elif row[:2] != (cap_microdollars, max_calls):
    71	            raise BudgetError('journal limits changed')
    72	        if self.conn.execute("select 1 from attempts where state!='complete' limit 1").fetchone():
    73	            self.conn.execute("update settings set halted='unresolved prior attempt' where id=1")
    74	        self.conn.commit()
    75	
    76	    def stop(self, reason):
    77	        with self.lock:
    78	            self.conn.execute('update settings set halted=coalesce(halted,?) where id=1', (reason,))
    79	            self.conn.commit()
    80	
    81	    def summary(self):
    82	        with self.lock:
    83	            self.conn.row_factory = sqlite3.Row
    84	            attempts = [dict(r) for r in self.conn.execute('select id,provider,request_sha256,reserved,charged,state,error,seconds,completed_order from attempts order by id')]
    85	            halted = self.conn.execute('select halted from settings').fetchone()[0]
    86	            self.conn.row_factory = None
    87	        return {'attempts': attempts, 'halted': halted,
    88	                'held_microdollars': sum(r['charged'] if r['charged'] is not None else r['reserved'] for r in attempts)}
    89	
    90	    def __call__(self, *args):
    91	        provider, request = args if len(args) == 2 else ('jev', args[0])
    92	        reserved, max_input, max_output = envelope(provider, request)
    93	        text, sha = model.request_identity(request)
    94	        with self.lock:
    95	            cap, max_calls, halted = self.conn.execute('select cap,max_calls,halted from settings').fetchone()
    96	            count, held = self.conn.execute('select count(*),coalesce(sum(coalesce(charged,reserved)),0) from attempts').fetchone()
    97	            if halted or count >= max_calls or held + reserved > cap:
    98	                raise BudgetError('admission closed or study limit reached')
    99	            cur = self.conn.execute("insert into attempts(provider,request_sha256,request_json,reserved,state) values (?,?,?,?,'reserved')", (provider, sha, text, reserved))
   100	            ident = cur.lastrowid
   101	            self.conn.commit()
   102	        start = time.perf_counter()
   103	        encoded = None
   104	        dispatched = False
   105	        try:
   106	            # Preparation is local only. Cancellation and dispatch then share one
   107	            # decision point; work committed here is in flight, even before socket I/O.
   108	            send = self.prepare(provider, request)
   109	            with self.lock:
   110	                if self.conn.execute('select halted from settings').fetchone()[0]:
   111	                    raise BudgetError('cancelled before dispatch')
   112	                self.conn.execute("update attempts set state='dispatched' where id=?", (ident,))
   113	                self.conn.commit()
   114	                dispatched = True
   115	            response = send()
   116	            encoded = json.dumps(response, ensure_ascii=False)
   117	            cost = charge(provider, response, max_input, max_output)
   118	            if cost > reserved:
   119	                raise BudgetError('usage exceeds reserved cost')
   120	        except BaseException as exc:
