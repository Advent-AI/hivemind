    89	def load(path):
    90	    with open(path, encoding='utf-8') as handle:
    91	        text = handle.read()
    92	    raw = json.loads(text)
    93	    for key in ('version', 'provider', 'search_top_n', 'extraction', 'matching', 'rejudging', 'final_verdict'):
    94	        if key not in raw:
    95	            raise ConfigError(f'config lacks {key}')
    96	    canonical = json.dumps({k: v for k, v in raw.items() if not k.startswith('_')}, sort_keys=True, ensure_ascii=False)
    97	    checksum = hashlib.sha256(canonical.encode('utf-8')).hexdigest()[:16]
    98	    extraction = {category: _setting(f'extraction.{category}', setting) for category, setting in raw['extraction'].items()}
    99	    matching, rejudging = _setting('matching', raw['matching']), _setting('rejudging', raw['rejudging'])
   100	    idea = _setting('idea', raw['idea']) if 'idea' in raw else None
   101	    _prompt_files(extraction, matching, rejudging, idea)       # final_verdict is kept in the file but no POC step calls it
   102	    return Config(version=str(raw['version']), checksum=checksum, provider=str(raw['provider']),
   103	                  search_top_n=int(raw['search_top_n']), extraction=extraction,
   104	                  matching=matching, rejudging=rejudging, final_verdict=_setting('final_verdict', raw['final_verdict']), idea=idea)
