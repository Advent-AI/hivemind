    77	        remaining = [entry for entry in saved['inputs'] if not store.is_processed(conn, entry['input_id'])]
    78	        if remaining != entries:
    79	            raise ValueError('concurrency manifest input order or content changed')
    80	        return metadata
    81	
    82	    def __call__(self, conn, archive, cfg, universe, items, *, day, transport=None, log=print):
    83	        if transport is None:
    84	            raise ValueError('offline concurrency POC requires an explicit transport; live cost reservation is not implemented')
    85	        if cfg.matching.engine != 'jev' and self.jev_workers != 1:
    86	            raise ValueError('parallel matching is only implemented for Jev')
    87	        metadata = self._manifest(conn, cfg, universe, items, day)
    88	        frozen_cfg, frozen_universe = copy.deepcopy(cfg), copy.deepcopy(universe)
    89	        pending, prepared_futures, next_index = {}, [], 0
    90	        pool = concurrent.futures.ThreadPoolExecutor(max_workers=self.extraction_workers)
    91	
    92	        def fill():
    93	            nonlocal next_index
    94	            while next_index < len(items) and len(pending) < self.extraction_workers:
    95	                item, route = items[next_index]
    96	                next_index += 1
    97	                if route.resume_from and route.resume_from != 'extracted':
    98	                    continue  # The authoritative saved handover is owned by normal recovery.
    99	                objects = [o['value'] for o in item.get('object_identifiers') or [] if frozen_universe.has(o['value'])]
   100	                shown = copy.deepcopy(store.views_for_prompt(conn, objects))
   101	                groups = copy.deepcopy(store.groups_for_prompt(conn, objects, item.get('title') or ''))
   102	                owned_item = copy.deepcopy(item)
   103	                key = extraction_key(frozen_cfg, owned_item, owned_item['text'], shown, frozen_universe, groups)
   104	                future = pool.submit(extraction.extract, archive, frozen_cfg, owned_item, owned_item['text'], shown,
   105	                                     frozen_universe, shown_groups=groups, transport=transport)
   106	                pending[item['input_id']] = (key, item_key(owned_item), future)
   107	                prepared_futures.append((item['input_id'], future))
   108	                self.events.append({'input_id': item['input_id'], 'event': 'prepared', 'request': key})
   109	
   110	        def accepted_extraction(current_archive, current_cfg, item, text, shown, current_universe, *, shown_groups=(), transport=None):
   111	            prior_key, source_key, future = pending[item['input_id']]
   112	            def validate_inputs():
   113	                if (environment_key(current_cfg, current_universe) != metadata['environment']
   114	                        or environment_key(cfg, universe) != metadata['environment'] or runtime_key() != metadata['runtime']):
   115	                    raise ValueError('configuration, universe or runtime changed during the day')
   116	                if item_key(item) != source_key or text != item['text']:
   117	                    raise ValueError('source changed after preparation')
   118	            validate_inputs()
   119	            current_key = extraction_key(current_cfg, item, text, shown, current_universe, shown_groups)
   120	            if current_key == prior_key:
   121	                answer = future.result()
   122	                validate_inputs()
   123	                if answer.request_sha256 != current_key:
   124	                    raise ValueError('prepared extraction does not match its validated request')
   125	                self.events.append({'input_id': item['input_id'], 'event': 'reused', 'request': current_key})
   126	                return answer
   127	            future.cancel()
   128	            self.events.append({'input_id': item['input_id'], 'event': 'stale', 'before': prior_key, 'request': current_key})
   129	            answer = extraction.extract(current_archive, current_cfg, item, text, shown, current_universe,
   130	                                        shown_groups=shown_groups, transport=transport)
   131	            validate_inputs()
   132	            return answer
   133	
   134	        try:
   135	            fill()
   136	            for item, route in items:
   137	                result = rounds.run(conn, archive, frozen_cfg, frozen_universe, item, route.sequence_no, resume_from=route.resume_from,
   138	                                    transport=transport, log=log, extractor=accepted_extraction, matching_workers=self.jev_workers)
   139	                self.events.append({'input_id': item['input_id'], 'event': 'failed' if result.failed else 'accepted'})
   140	                yield result
   141	                if result.failed:
   142	                    return
   143	                pending.pop(item['input_id'], None)
   144	                fill()
   145	        finally:
   146	            # Running calls may still archive a response; none can become a handover here.
   147	            for _, _, future in pending.values():
   148	                future.cancel()
   149	            pool.shutdown(wait=True, cancel_futures=True)
   150	            for input_id, future in prepared_futures:
   151	                if not future.cancelled() and future.exception() is not None:
   152	                    self.events.append({'input_id': input_id, 'event': 'speculative_error', 'error': type(future.exception()).__name__})
     1	"""Replay the test database through the pipeline day by day with no look-ahead.
     2	
     3	For every calendar day from from_day to until_day: route each item published that day (dispatch), run its round
     4	(extraction → matching → writing), then the day's one re-judging round over the views whose reading changed (D63),
     5	then pull mode for that day. A guard refuses an item whose
     6	publication day is after the replay day. The views database refuses to run a day at or before the last day it
     7	completed (no backdating). After day0's pull the views database is copied to <views>.day0.sqlite for the agent
     8	layer. Every day prints one line and the archive's cumulative cost."""
     9	import datetime
    10	import shutil
    11	import time
    12	
    13	from . import dispatch, pull, testdb
    14	from .views import round as round_module, store
    15	
    16	
    17	class StaleHandoverError(RuntimeError):
    18	    """A saved parallel extraction cannot establish that it read its predecessors."""
    19	
    20	
    21	def refuse_unfinished_parallel(conn):
    22	    """D159: preserve old handovers, but never resume a day-start read as a sequential read."""
    23	    pending = conn.execute("""select p.input_id, p.reason from processing_steps p
    24	        where p.step='extracted' and p.result='ok'
    25	        and p.id=(select max(q.id) from processing_steps q
    26	                  where q.input_id=p.input_id and q.step='extracted' and q.result='ok')
    27	        and not exists (select 1 from processing_steps q
    28	                        where q.input_id=p.input_id and q.step='handed_over' and q.result='ok')
    29	        order by p.sequence_no""")
    30	    ids = [row['input_id'] for row in pending if row['reason'].endswith(' (parallel)')]
    31	    if ids:
    32	        raise StaleHandoverError('unfinished day-start extractions; keep this ledger and replay into a new one: ' + ', '.join(ids))
    33	
    34	
    35	class LookAheadError(RuntimeError):
    36	    pass
    37	
    38	
    39	class BackdatingError(RuntimeError):
    40	    pass
    41	
    42	
    43	def calendar_days(from_day, until_day):
    44	    day = datetime.date.fromisoformat(from_day)
    45	    last = datetime.date.fromisoformat(until_day)
    46	    while day <= last:
    47	        yield day.isoformat()
    48	        day += datetime.timedelta(days=1)
    49	
    50	
    51	def run(*, testdb_path, views_path, archive, cfg, universe, from_day, until_day, day0=None, spend_cap_usd=None,
    52	        transport=None, log=print, only_objects=None, max_items_per_day=None, day_runner=None):
    53	    items_db = testdb.open_db(testdb_path)
    54	    conn = store.open_db(views_path)
    55	    refuse_unfinished_parallel(conn)
    56	    last_done = store.last_completed_day(conn)
    57	    start = from_day
    58	    if last_done and from_day <= last_done:
    59	        next_day = (datetime.date.fromisoformat(last_done) + datetime.timedelta(days=1)).isoformat()
    60	        if next_day > until_day:
    61	            raise BackdatingError(f'views database already completed {last_done}; nothing to run before it')
    62	        log(f'resuming after the last completed day {last_done}')
    63	        start = next_day
    64	    last_written = conn.execute('select max(publication_day) from processing_steps where sequence_no > 0').fetchone()[0]
    65	    if last_written and start < last_written:
    66	        raise BackdatingError(f'views database already holds rounds of {last_written}; a replay cannot start before it (D31)')
    67	    totals = {'items': 0, 'extracted': 0, 'skipped': 0, 'merged': 0, 'not_processed': 0, 'returned': 0, 'failed': 0,
    68	              'evidence': 0, 'new_views': 0, 'judged': 0, 'changed': 0, 'closed': 0}
    69	    calls_before, cost_before, *_ = archive.totals()
    70	    for day in calendar_days(start, until_day):
    71	        day_stats = {k: 0 for k in totals}
    72	        day_cost_before = archive.totals()[1]
    73	        processed = 0
    74	        to_run = []
    75	        for item in testdb.feed(items_db, day, day):
    76	            if item['publication_day'] > day:
    77	                raise LookAheadError(f'{item["input_id"]} is dated {item["publication_day"]}, after replay day {day}')
    78	            if only_objects and not any(o['value'] in only_objects for o in item['object_identifiers']):
    79	                continue
    80	            if max_items_per_day and processed >= max_items_per_day:
    81	                break
    82	            day_stats['items'] += 1
    83	            route = dispatch.route(conn, item, universe)
    84	            if route.kind != 'extract':
    85	                day_stats[route.kind] += 1
    86	                if route.kind == 'merged':
    87	                    dispatch.mark(conn, item, 0, 'merged', 'ok', route.reason)
    88	                    conn.commit()
    89	                continue
    90	            processed += 1
    91	            to_run.append((item, route))
    92	        results = (day_runner(conn, archive, cfg, universe, to_run, day=day, transport=transport, log=log) if day_runner else
    93	                   (round_module.run(conn, archive, cfg, universe, item, route.sequence_no, resume_from=route.resume_from, transport=transport, log=log)
    94	                    for item, route in to_run))
    95	        finished = 0
    96	        try:
    97	            for index, result in enumerate(results):
    98	                if index >= len(to_run) or result.input_id != to_run[index][0]['input_id']:
    99	                    raise RuntimeError('day runner returned results out of input order')
   100	                finished += 1
   101	                day_stats['extracted'] += 1
   102	                day_stats['evidence'] += result.evidence
   103	                day_stats['new_views'] += result.new_views
   104	                day_stats['judged'] += result.judged
   105	                day_stats['changed'] += result.changed
   106	                if result.failed:
   107	                    day_stats['failed'] += 1
   108	                    log(f'  ! {result.input_id[:60]}: {result.failed}')
   109	                    raise RuntimeError(f'item failed; day {day} remains resumable: {result.failed}')
   110	                if spend_cap_usd is not None and archive.totals()[1] - cost_before > spend_cap_usd:
   111	                    raise RuntimeError(f'spend cap {spend_cap_usd} reached on {day}')
   112	        finally:
   113	            if hasattr(results, 'close'):
   114	                results.close()
   115	        if finished != len(to_run):
   116	            raise RuntimeError('day runner did not complete every routed item')
   117	        seq = store.next_sequence(conn) - 1
   118	        judged = round_module.judge_day(conn, archive, cfg, day, seq, transport=transport, log=log)
   119	        day_stats['judged'] += judged.judged
   120	        day_stats['changed'] += judged.changed
   121	        if judged.failed:
   122	            day_stats['failed'] += 1
   123	            log(f'  ! day judging: {judged.failed}')
   124	            raise RuntimeError(f'judging failed; day {day} remains resumable: {judged.failed}')
   125	        closed = pull.end_of_day(conn, day, seq)
   126	        day_stats['closed'] = len(closed)
   127	        store.complete_day(conn, day, seq, time.strftime('%Y-%m-%dT%H:%M:%S'))
   128	        conn.commit()
   129	        for key in totals:
   130	            totals[key] += day_stats[key]
   131	        calls, cost, _, _ = archive.totals()
   132	        day_cost = cost - day_cost_before  # Includes discarded speculative calls and repaired refusals.
   133	        open_count = len(store.open_views(conn))
   134	        log(f'{day} | items {day_stats["items"]:3d} extracted {day_stats["extracted"]:3d} merged {day_stats["merged"]:2d} skipped {day_stats["not_processed"]:2d} '
   135	            f'failed {day_stats["failed"]:2d} | evidence {day_stats["evidence"]:3d} new views {day_stats["new_views"]:2d} judged {day_stats["judged"]:3d} '
   136	            f'changed {day_stats["changed"]:3d} closed {len(closed)} | open views {open_count} | day ${day_cost:.2f} total ${cost - cost_before:.2f} calls {calls - calls_before}')
   137	        if day0 and day == day0:
   138	            conn.commit()
   139	            shutil.copy(views_path, views_path + '.day0.sqlite')
   140	            log(f'day 0 snapshot written: {views_path}.day0.sqlite')
   141	    return totals
