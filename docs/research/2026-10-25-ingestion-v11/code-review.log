    49	def test_shared_transport_bounds_requests_across_stages(tmp_path):
    50	    """Shared limit: three callers across providers cannot dispatch more than two together."""
    51	    entered, release = threading.Event(), threading.Event()
    52	    lock = threading.Lock()
    53	    active = maximum = count = 0
    54	    def prepare(provider, request):
    55	        def send():
    56	            nonlocal active, maximum, count
    57	            with lock:
    58	                active += 1; count += 1; maximum = max(maximum, active)
    59	                if count == 2:
    60	                    entered.set()
    61	            try:
    62	                assert release.wait(5)
    63	                if provider == 'jev':
    64	                    return {'answers': {'q': {'type': 'noul', 'noul': 0.5}}, 'usage': {'input_tokens': 1000, 'output_tokens': 10}}
    65	                return response()
    66	            finally:
    67	                with lock:
    68	                    active -= 1
    69	        return send
    70	    transport = StudyTransport(GuardedTransport(tmp_path / 'budget.sqlite', prepare))
    71	    with ThreadPoolExecutor(max_workers=3) as pool:
    72	        futures = [pool.submit(transport, 'openai', openai_request('extract')),
    73	                   pool.submit(transport, 'openai', openai_request('judge')),
    74	                   pool.submit(transport, {'model': 'jev-1.14.0', 'state': '', 'questions': {'q': {'type': 'noul'}}})]
    75	        try:
    76	            assert entered.wait(5)
    77	            assert active == 2
    78	        finally:
    79	            release.set()
    80	        for future in futures:
    81	            future.result()
    82	    assert maximum == 2 and count == 3
