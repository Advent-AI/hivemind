   129	        with self.lock:
   130	            order = self.conn.execute('select coalesce(max(completed_order),0)+1 from attempts').fetchone()[0]
   131	            self.conn.execute("update attempts set state='complete',charged=?,response_json=?,seconds=?,completed_order=? where id=?", (cost, encoded, time.perf_counter()-start, order, ident))
