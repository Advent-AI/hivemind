    89	def search_threads(conn, thread, top_n):
    90	    words = sorted(set(re.findall(r'[a-z0-9]{3,}', (thread['name'] + ' ' + thread['scope']).lower())))
    91	    if not words:
    92	        return []
    93	    query = ' OR '.join('"' + word + '"' for word in words)
    94	    return [dict(r) for r in conn.execute('''select thread_id,name,scope from thread_search
    95	        where thread_search match ? order by bm25(thread_search),rowid limit ?''', (query, top_n))]
