   196	            continue
   197	        c = dict(c, rungs=normalise_ladder(c['rungs'], c['kind']))
   198	        if QUARTERLY.search(c['looks_at'] + ' ' + c['question']) and c['kind'] == '对象观点':
   199	            dropped.append((c['id'], 'quarterly number: evidence, not a view (06-views ladder rule 6)'))
   200	            continue
   201	        year_match = re.search(r'(\d{4})', c['year'] or '')
   202	        if c.get('measure') not in ('event', 'policy_event') and year_match and int(year_match.group(1)) > int(item['publication_day'][:4]) + 1:
   203	            dropped.append((c['id'], f'year {c["year"]} is beyond next year: not opened (06-views 不开)'))
   204	            continue
   205	        if not re.match(r'\d{4}-\d{2}-\d{2}$', c['due_day']):
   206	            dropped.append((c['id'], f'due_day not a date: {c["due_day"]!r}'))
   207	            continue
   208	        if c['due_day'] <= item['publication_day']:
   209	            dropped.append((c['id'], f'due_day {c["due_day"]} not after the item'))
   210	            continue
   211	        if c.get('measure'):          # keyed candidates keep their actual scope; reference lists do not gate admission (D155)
   212	            problem = check_bounds(c['rungs'])
   213	            if problem:
   214	                dropped.append((c['id'], f'candidate ladder bounds: {problem}'))
   215	                continue
   216	            if universe is not None:
   217	                object_id = universe.resolve(c['object']) or c['object']
   218	                scope, source = universe.scope_and_source(object_id, c['measure'], c.get('scope', ''), c.get('event_type', 'n/a'))
   219	                c = dict(c, object=object_id, scope=scope, scope_source=source, key_version=2)
   220	                if c['measure'] not in ('event', 'policy_event'):
   221	                    period = universe.fiscal_period(object_id, c.get('year', ''))                                                        # and the period of a yearly number
   222	                    if period:
   223	                        c = dict(c, period_start=period[0], period_end=period[1])
   224	            try:
   225	                start = datetime.date.fromisoformat(c['period_start'])
   226	                end = datetime.date.fromisoformat(c['period_end'])
   227	                if start > end:
   228	                    raise ValueError('start after end')
   229	            except (KeyError, ValueError):
   230	                dropped.append((c['id'], 'invalid period: expected real dates with start <= end'))
   231	                continue
   232	        candidates.append(c)
   233	        candidate_ids.add(c['id'])
   234	    evidence = []
   235	    kept_ids = set()
   236	    by_quote = {}
   237	    alias = {}
   238	    for e in data.get('evidence', []):
   239	        quote = normalise(e['quote'])
   240	        if len(quote) < 8 or quote not in body:
   241	            dropped.append((e['id'], 'quote not in item'))
   242	            continue
   243	        links = [l for l in e['links'] if l in shown_ids or l in candidate_ids]
   244	        if not links:
   245	            dropped.append((e['id'], f'links to nothing shown: {e["links"]}'))
   246	            continue
   247	        if quote in by_quote:            # the same sentence read out twice is one piece with both links
   248	            first = by_quote[quote]
   249	            first['links'].extend(l for l in links if l not in first['links'])
   250	            alias[e['id']] = first['id']
   251	            dropped.append((e['id'], f'same quote as {first["id"]}; merged'))
   252	            continue
   253	        e = dict(e, links=links)
   254	        by_quote[quote] = e
   255	        evidence.append(e)
   256	        kept_ids.add(e['id'])
   257	    final_candidates = []
   258	    for c in candidates:
   259	        ids = list(dict.fromkeys(alias.get(i, i) for i in c['evidence_ids'] if alias.get(i, i) in kept_ids))
   260	        if not ids and item.get('publisher_type') != SELF_PUBLISHER_TYPE:
   261	            dropped.append((c['id'], 'candidate without surviving evidence'))
   262	            continue
   263	        final_candidates.append(dict(c, evidence_ids=ids))
   264	    for e in evidence:
   265	        e['links'] = [l for l in e['links'] if l in shown_ids or any(c['id'] == l for c in final_candidates)]
   266	    evidence = [e for e in evidence if e['links']]
   267	    return evidence, final_candidates, dropped
docs/prd/05-extraction.md:3:> 状态：第一版已冻结 · 2026-10-18（没定的：每一类提示词的具体写法） · D149 补入抽取时归组要求，尚未接入默认管线 · 更新：2026-10-25 · 依据：docs/DECISIONS.md D11、D13、D25–D28、D32、D33、D35–D37、D41、D42、D45–D47、D51–D54、D58–D60、D149、D155
docs/prd/05-extraction.md:8:抽取只做一件事：每条信息整份交给模型，用资深对冲基金分析师的视角、按这一类的提示词读完，交出两样东西：证据，连到这些对象已有的观点上（或这次的候选观点上）；候选观点，已有观点管不到、又要紧的事（你自己的备忘录另有说明，见提示词那一节）。每个候选观点同时带结构化研究归属，必要时声明新的研究主线。每条带出处，一起交给观点库。完整归组规矩见 [观点库](06-views.md#研究主线抽取时归组)。
docs/prd/05-extraction.md:12:- 系统做的事是在观点库里建观点、更新观点、关掉观点，抽取就是把每条信息读成证据和带研究归属的候选观点。怎么和库里已有的比、写进库，是观点库的事，不在这里。
docs/prd/05-extraction.md:28:  ↓ 2 读（模型）：整份读完，交出两样：证据，连到第 5 块里的观点上，或连到这次的候选观点上；候选观点，第 5 块里没有一条观点管、又要紧的事，带上提出它的证据；你自己的备忘录照提示词说明处理。每个候选观点同时确定研究归属，按观点库的归组规矩交出引用；每条带出处
docs/prd/05-extraction.md:29:  ↓ 3 核对出处与归属引用（代码）：引用的原文（那一句，或表里那个单元格）在不在这条信息里、数字在不在引用的地方；证据连的必须是第 5 块里的观点或这次的候选观点；出处对不上的不要，记下原因；归属引用按观点库的完整交接规矩检查
docs/prd/05-extraction.md:36:一遍读完，交出证据和候选观点；候选观点的研究归属与必要的新主线定义随同交出。证据几乎每条信息都有，连到已有观点上，也可以连到这次的候选观点上；候选观点很少，只给已有观点管不到的要紧事（你自己的备忘录照提示词说明处理）。到了观点库，候选观点先和搜出来的几条已有观点比；它带的证据等它的去向定了，再和那条观点下已有的证据比，见 06-views.md。
docs/prd/05-extraction.md:41:| 是什么 | 信息里的一句话或一个数：谁说了什么、发生了什么 | 一个要盯的问题，当场写全：讲的是谁、问题、梯子、到期日和研究归属 |
docs/prd/05-extraction.md:50:├─ 第 5 块里没有，但要紧 → 候选观点：这句话是它的证据（先在抽取时交研究归属；是已有的哪一条，还是新观点，由观点库比对时定；一条观点只管到它的到期日，到期以后才发生的事也算这里）
docs/prd/05-extraction.md:62:| 角色 | 你是一位资深对冲基金分析师。读这条信息，是为了检验和形成观点：把支持或削弱已有观点的话和数挑出来，作为证据连到那条观点上；已有观点管不到、又要紧的事，写成候选观点，当场写全：问题、梯子、到期日和研究归属，带上提出它的证据。你自己的备忘录里的判断，都交成候选观点，可以不带证据，不当作证据。写观点的规矩：一个观点只看一件东西；梯子五格（只有是或否的问题两格），每格是一个能核对的结果，格和格不重叠、不留空，没有含糊的“部分”；到期日定在争论见分晓的那天，数字的观点就是这个数公布的那天；数字写明哪一年：今年、明年按这条信息的发布日算，公司的数按它的财年。 | 所有类别一样；写观点的规矩原样取自观点库 |
docs/prd/05-extraction.md:64:| 讲的是谁 | 这条信息的相关对象；另附研究对象名单里的全部主题，候选观点讲的是主题时，名单里有的从里面挑，没有的写清是什么事。 | 这条信息的标签；主题取自研究对象名单 |
docs/prd/05-extraction.md:66:| 已有观点与研究主线 | 这条信息相关对象开着的观点，加上它们依赖的观点，写明谁依赖谁；只给问题、看的是什么和到期日，不给状态和证据；同一块另附可用的研究主线，内容按观点库的归组规矩提供。 | 观点库 |
docs/prd/05-extraction.md:76:├─ 1 角色 → 资深对冲基金分析师（读这条信息，是为了检验和形成观点：证据连到已有观点上；已有观点管不到的要紧事，写成候选观点，当场写全问题、梯子、到期日和研究归属）
docs/prd/05-extraction.md:79:├─ 4 要读出什么 → 发生了什么事、什么时候、涉及谁；说法从哪来，原始来源是谁（官方确认的算发生的事；“知情人士称”算传闻）
docs/prd/05-extraction.md:80:└─ 5 已有观点与研究主线 → 这篇报道相关对象开着的观点，加上它们依赖的观点（由代码填，写明谁依赖谁，只给问题、看的是什么和到期日；比如“NVDA FY27 全年中国区收入，比 FY26 会怎样？”，和它依赖的“这一档芯片对华出口许可”；另附可用的研究主线）
docs/prd/05-extraction.md:84:- 研究对象会看的 15 类（T1–T15）各一份；T16 研究对象默认不看，用到时再写。
docs/prd/05-extraction.md:101:| T6 公司其他发布 | 发生了什么事（高管变动、并购、新产品、回购）；公布的经营数字（比如交付量） | 发生的事 |
docs/prd/05-extraction.md:102:| T7 新闻 | 发生了什么事、什么时候、涉及谁；说法从哪来，原始来源是谁 | 官方确认的算发生的事；“知情人士称”算传闻 |
docs/prd/05-extraction.md:105:| T10 官方行动与记录 | 决定或行动本身、什么时候生效、影响谁；后面的程序（上诉、截止日），可以用作到期日 | 发生的事 |
docs/prd/05-extraction.md:106:| T11 宏观政策与统计 | 公布的数字和政策决定，和上一次比差多少；官方措辞的变化 | 数和决定是发生的事；措辞是当事人说的 |
docs/prd/05-extraction.md:111:| T16 参照数据 | 研究对象默认不看 | — |
docs/prd/05-extraction.md:113:每份文件都整份交给模型，里面的表格一起读；表格数据一次发布算一条，也整批交给模型。申报里的 XBRL 数字不另外推，文件本身已经有这些数。到期时要不要另外去查准确的数，等以后设计 Pull 模式时定。
docs/prd/05-extraction.md:122:│   ├─ 候选观点（主题观点） → 2025-04 那条规定管的这一档芯片（H20、MI308 等）对华出口许可，到 2026-04-15 处在哪一格？（事件观点。五格：全面禁止；要许可，一个都不发；要许可，发了，但有附条件的；要许可，发了，都不附条件；不再要许可。到期日：2026-04-15。证据原文：“…requires a license for export to China … of the Company’s H20 integrated circuits…”，意思是 NVDA 披露 H20 出口中国要许可证，算发生的事。到了观点库，开成 #1）
docs/prd/05-extraction.md:123:│   └─ 候选观点（对象观点 NVDA） → NVDA FY26 全年中国区收入，比 FY25 会怎样？（数字观点。五格：涨 50% 及以上；涨 10% 及以上不到 50%；涨跌都不到 10%；降 10% 及以上不到 80%；降 80% 及以上。到期日：FY26 年报的财报日。证据原文：“…up to approximately $5.5 billion of charges…”，意思是公司预计最多约 55 亿美元的费用，算当事人说的。到了观点库，开成 #2，依赖 #1）
docs/prd/05-extraction.md:139:└─ 哪一句 → 原文那一句，或表里那个单元格（代码核对它真的在这条信息里，数字真的印在引用的地方）
docs/prd/05-extraction.md:143:- 抽取核对三件事：引用的原文（那一句，或表里那个单元格）在这条信息里；数字在引用的地方；证据连的是第 5 块里的观点，或者这次的候选观点。有一件不对，就不交出去。观点库核对：出处在处理记录里查不到的，不写进库。都记下原因。
docs/prd/05-extraction.md:154:- 每条证据带原文、一句话说清、谁说的、原始来源、哪一层、事情发生的时间；每个候选观点当场写全：讲的是谁（主题从第 3 块附的主题里挑，名单里没有的写清是什么事；公司、加密货币、商品写代码或名字）、对象观点还是主题观点、看的是什么、问题、梯子、到期日、研究归属，和至少一条证据（你自己的备忘录读出的，可以没有）。
docs/prd/05-extraction.md:155:- 每条观点和证据都有出处。引用的原文（那一句，或表里那个单元格）不在这条信息里、数字不在引用的地方的，不交给观点库，记下原因。
docs/prd/05-extraction.md:156:- 抽取不改观点库：证据、候选观点及其研究归属一起交出，不另加聚类调用。归组的引用与语义验收见 [观点库](06-views.md#研究主线抽取时归组)；名字相似或次数相同不等于归对。
docs/prd/05-extraction.md:168:- D149：研究归属是抽取的必交内容；目标要求与当前未接入的实现状态分开写。
docs/prd/05-extraction.md:179:- D37：第一版冻结（2026-10-18）；要改先记一条新决定。
docs/prd/05-extraction.md:190:## 抽取时同时确定研究归属
docs/prd/05-extraction.md:193:- D149 已定要求：读全文时就决定候选观点属于哪个持续业务过程，称为研究主线。例如 Rubin 出货和 SK 工厂上线各有自己的问题，同时属于 Rubin 推出这条主线。归组随抽取完成，不留给前端或事后全库聚类。
docs/prd/05-extraction.md:194:- 证据和候选观点仍分开交；每个候选观点同时带结构化归属，需要新主线时附上名称和范围。只在解释里提到相关、没有可保存的引用，不算交完。抽取只读不落库，完整交接和保存规矩由观点库的“研究主线：抽取时归组”一节规定。
docs/prd/06-views.md:3:> 状态：第一版已冻结 · 2026-10-20（只写 Alex 说过或定过的；要改，先记一条新决定；还没定的和 2 条 Pull 模式的事单列在后面） · D149 补入抽取时归组要求，尚未接入默认管线 · 更新：2026-10-25 · 依据：docs/DECISIONS.md D11、D14、D16、D26、D30、D31、D33、D38–D42、D44–D49、D51–D60、D149、D155
docs/prd/06-views.md:9:系统的核心。一条观点是一个问题、一把梯子和一个到期日，写下不改；证据把它的状态往两头推，到期那天状态定格。抽取交来两样东西，都是先搜、再由模型比：候选观点和搜出来的几条已有观点比，判是归入已有的、接续、开新的，还是不开；证据和它那条观点下搜出来的证据比，判是重复、替代还是新证据。连着的证据只多了出处，本身不触发重判。研究归属由抽取决定，在最终观点编号确定后随写入保存，见 [研究主线](#研究主线抽取时归组)。
docs/prd/06-views.md:19:- 比对像人查东西：先搜出几条可能的，再判是不是同一条（Alex：“If I have a view, I go search it up. If something matches, then it's just the same view. If nothing matches, then essentially it's a new view, or it matches weekly, then it should be a new view”）。判的是模型，代码不替它判（Alex：“I just want LLM to do the matching”）。是同一条就归入，梯子和到期日用已有的（Alex：“已经存在的观点就 merge，日期遵照之前已经存在的期限”）。
docs/prd/06-views.md:24:- 被依赖的观点有重大改动，依赖它的才重判（Alex：“如果美联储有重大的改动，那这条 global thesis 出来影响每一家不同，确实需要重判”）。“重大”由模型判：每次判完写明结论变不变，换了一格，或者撑着状态的关键事实、关键数字变了，算变了。合起来只有一条规矩：一条观点读的东西变了就重判，读的东西是它自己的证据和它依赖的观点的结论。官员把老话再讲一遍，两百条依赖美联储的观点都不动；AMZN 资本开支指引从涨 12% 改成 25%，哪怕还在同一格，依赖它的 NVDA 那条也会重判。
docs/prd/06-views.md:38:├─ 研究主线 → 按持续业务过程组织观点（抽取时归组；完整规矩见“研究主线：抽取时归组”）
docs/prd/06-views.md:59:├─ 对象观点（数字） → NVDA FY27 全年中国区收入，比 FY26｜五格：对 NVDA 的业务是好是坏（到期 = FY27 年报的财报日）
docs/prd/06-views.md:65:└─ 主题观点（事件） → 2025-04 那条规定管的这一档芯片（H20、MI308 等）对华出口许可，到 2026-04-15 处在哪一格｜五格：从一头排到另一头的结果，不说好坏（以那天已经生效的规定为准）
docs/prd/06-views.md:75:3. 一把梯子只放一种东西，一个观点只看一件东西：既要数字又要事件的，拆成两条，用依赖连起来；两部分可能往相反方向走的（H20 这一档和 Blackwell 这一档），也是两条观点。
docs/prd/06-views.md:77:5. 数字的观点写明哪一年。不是公司的数，按自然年：这条信息发布那年是今年，下一年是明年，各到 12 月 31 日。公司的数按它的财年：发布日所在的财年是今年，下一个财年是明年。都按信息的发布日算，不看电脑时钟。同一个数，今年、明年最多各开一条，超出的不开；到期日就是这个数公布的那天。
docs/prd/06-views.md:90:- 每次判断还交一栏“结论变不变”：模型拿这次的判断和这条观点在这一轮之前的结论（状态和理由）比（这一轮里重试也一样），写“变了”或“没变”，加一句为什么；这一轮之前的结论只拿来比，不在它的基础上加减。换了一格，或者撑着这个状态的关键事实、关键数字变了，算变了：AMZN 资本开支指引从涨 12% 改成 25%，还在同一格，也是变了；同样的话再说一遍，是没变。写了“变了”，依赖它的观点读的东西就变了，这一轮接着重判。代码只核对一件事：换了一格的、第一次判的，必须写“变了”；写成“没变”的不收，照上一条查表不对的规矩处理。
docs/prd/06-views.md:99:| 发生的事 | 官方行动、公布的数、已经完成的交易 | 能定哪一格成立，也能推状态 |
docs/prd/06-views.md:115:├─ 数字的观点 → 读那一年的那条（例：JPM 2027 全年净利息收入 → 美联储 2027 年末利率）
docs/prd/06-views.md:119:└─ 事件的观点 → 顺着接续往下走（例：NVDA FY27 全年中国区收入 → 这一档芯片对华出口许可）
docs/prd/06-views.md:150:| 什么算现在 | 链上开着的（数字可以今年、明年各开一条） | 没被替代的那些（证据的替代也连成一条链） |
docs/prd/06-views.md:156:一条信息走一轮，按顺序号一条一条来。候选观点连同研究归属和必要的新主线定义一起进入；归属按本节归组规矩保留。模型只做第 4、7 步，其余是代码。
docs/prd/06-views.md:164:  ↓ 4 比对（模型）：模型不读原文，在同一次调用里判三件事；给它看的每条已有观点，都有属于哪个对象、问题、看的是什么、梯子、到期日和开着还是关了。一是每个候选观点：是清单里的哪一条（或者它的一部分）、接续哪一条（接续的，梯子按上一期的方向排，门槛照候选观点写的），还是新观点（对不上，或者只是有点像，就开新的）；太大太杂的、超出今年和明年的数字观点、和一条关了的观点是同一样东西的同一期的，都不开；都写理由。二是要开的新观点依赖哪几条观点、各往哪个方向推，从模型面前已有的观点里挑：搜出来的、抽取时第 5 块列的、同一条信息里新建的。三是只连在已有观点上的每条证据，和那条观点下搜出来的证据比，是重复、替代还是新证据。连在候选观点上的证据，等候选观点有了去向再比：到它连着的每条已有观点下（包括候选观点归入的那条）一起搜，另叫一次模型一起比；只连在新观点上的，就是新证据
docs/prd/06-views.md:165:  ↓ 5 核对（代码）：候选观点和证据的去向，编号必须在清单里，或者是那条观点下的证据；候选观点要归入的那条已有观点，必须还开着；新观点讲的对象必须在研究对象名单里（照分类查对象标识的办法查），不在的照“不开”处理；新观点依赖的，必须是这一次给模型看过的观点（或者写明了要等它那条链上的哪一年），连上以后不绕成圈，不对的退回给模型改
docs/prd/06-views.md:176:| 归入已有的 | 候选观点看的就是那条观点看的东西，或者是它的一部分（“H20 在中国的收入”是“中国区收入”的一部分）；只能归入开着的，关掉的只能接续 | 证据再和那条观点下的证据比，研究归属按本节归组规矩保留；梯子和到期日用已有的 |
docs/prd/06-views.md:177:| 接续 | 同一样东西的下一期：数字的下一年；事件的那条已经关了，要接着看 | 建新观点，记接续 |
docs/prd/06-views.md:179:| 不开 | 太大太杂，一条里捆了几件可能往相反方向走的事：“美国对华芯片管制会怎样”；或者数字的观点超出了今年、明年；或者和一条关了的观点是同一样东西的同一期（关掉的只能接续）；或者讲的对象不在研究对象名单里（名单里没有的主题，交人工复核池当建议新增的主题；名单外的公司只在处理记录里留一笔） | 不建；它的证据如果也连在具体的那条上，照常算数；只连在它身上的不存 |
docs/prd/06-views.md:181:- D155 的当前 POC 把确定的重复交给代码判断；范围或旧记录仍需判断的由模型比对。清单只作研究参考，同组不等于同一观点；具体合同和实测范围见 docs/poc/grouping-improvement-plan.md。
docs/prd/06-views.md:192:| 替代 | 和已有的一条是同一件事的前后两个说法：同一个人后来改了说法或数（指引、预测、某件事办到了哪一步）；官方证实或否认了一条传闻；原始来源自己出了修正版，改了原句 | 按说的时间排（这句话是哪天说的），后说的算数，先说的标“被替代”，留在历史里，重判；晚到的旧说法（同一件事已经有更新的）不加进来，只在处理记录里写一笔，不重判 |
docs/prd/06-views.md:208:│   ├─ #1 主题观点 → 这一档芯片对华出口许可（事件）（证据：H20 出口中国要许可证（发生的事））
docs/prd/06-views.md:209:│   └─ #2 对象观点（NVDA） → FY26 全年中国区收入（数字）（证据：预计最多约 55 亿美元的费用（当事人说的）；依赖 #1，放松那头看多）
docs/prd/06-views.md:255:| 交来的 | 抽取交来的候选观点、研究归属、新主线定义和证据，原样留存；给比对模型看的内容另记 |
docs/prd/06-views.md:268:├─ 开着 → 读的东西变了就重判，条件见“什么时候重判”那一条（比对开观点时，同一样东西同时只开一条；数字的同一个数，今年、明年各一条）
docs/prd/06-views.md:273:- 人也可以手动关掉或重新打开一条观点，比如资产退市；每次都新加一条记录，写明是谁、从哪个顺序号的信息之后算数。同一样东西同时只开一条，是比对时的规矩，人手动打开的不受它管。研究对象名单也由人手动改。
docs/prd/06-views.md:283:| 看的是什么 | 数字：哪个数、哪一年；事件：哪件事 | FY27 全年中国区收入 |
docs/prd/06-views.md:286:| 到期日 | 争论见分晓的那天；数字就是它公布的那天 | FY27 年报的财报日 |
docs/prd/06-views.md:289:| 研究归属 | 属于哪些研究主线；按本节归组规矩保存成员关系 | 这一档芯片的对华许可与中国业务 |
docs/prd/06-views.md:306:| 事情发生的时间 | 事情什么时候发生或生效；数字写它属于哪一期 |
docs/prd/06-views.md:307:| 被替代 | 指向替代它的那一条：同一个人后来改了说法或数、官方证实或否认了这条传闻；或者原始来源自己出了修正版，把这句改了、删了（删了的，没有替它的新证据）；被替代的不再算数，留在历史里 |
docs/prd/06-views.md:330:| 抽取 | 拿：证据（连在已有观点或候选观点上）、候选观点及其研究归属、必要的新主线定义，都带出处。给：提示词第 5 块的已有观点，也就是相关对象开着的观点，加上它们依赖的观点，写明谁依赖谁；观点只给问题、看的是什么和到期日，不给状态和证据；同一块另附可用的研究主线，按本节归组规矩提供 |
docs/prd/06-views.md:339:- 抽取交来的研究归属能保存到最终观点，沿真实证据连线可查来源；具体归组验收见 [研究主线](#研究主线抽取时归组)。默认管线尚未接入，不能把隔离实验通过的代码检查记成此项已通过。
docs/prd/06-views.md:342:- 数字的观点写明哪一年；同一个对象的同一个数，只开今年、明年的，每一年最多一条（上一年的那条到期以前照常开着）；事件的同一件事，开着的只有一条。这几条是比对开观点时守住的，人手动重新打开的不算在内。
docs/prd/06-views.md:348:- 新观点的依赖在比对那一次一起挑，只能是这一次给模型看过的观点（或者写明了要等它那条链上的哪一年）；依赖数字的观点就读那一年的那条，依赖事件的观点就顺着接续走；依赖不绕成圈。
docs/prd/06-views.md:368:1. Pull 模式的事，设计 Pull 模式时再谈：除了到期定格，另外两种情况，答不出（不再披露这个数、事情本身没了；依赖它的观点标“缺这个输入”）和等公布（数字的观点期末已过、这个数还没公布）。
docs/prd/06-views.md:374:- D149：本模块拥有研究主线的交接与保存规矩，比对不重判抽取已决定的归属。
docs/prd/06-views.md:385:- D41：为观点库的新设计，改了已冻结的抽取、Config、研究对象名单和人工复核池；最终判定和 Pull 模式要重做；用词扩到观点库。
docs/prd/06-views.md:391:- D48：观点库（含比对标注）第一版冻结（2026-10-20）；要改先记一条新决定。
docs/prd/06-views.md:399:- D58：冻结前的深审：理顺几处规矩的写法（依赖的方向、等着的箭头、一条观点只管到它的到期日、只开一条是比对时的规矩、重判的条件、手动开关的记录），没有加新规矩；除 Pull 模式和最终判定，全部冻结。
docs/prd/06-views.md:403:## 研究主线：抽取时归组
docs/prd/06-views.md:406:- D149 已定要求：把观点按所谈的持续业务过程组织成研究主线。例如 Vera Rubin 从产品准备到客户落地；出货时间、SK 工厂上线、OpenAI 部署仍各有问题、梯子和到期日。主线可从一条观点开始，一个观点可属于多条主线。它没有状态或梯子，不自动产生依赖，也不等于给 agent 的上层投资论点。
docs/prd/06-views.md:407:- 归属按业务过程判断，可以跨公司、跨行业，不按同一家公司判断。明确使用 Rubin 的客户部署可以跨公司归在 Rubin 下；NVIDIA 的 PC 芯片不能仅因同公司归入 Rubin，OpenAI 部署不能因同属 Rubin 就归入 SK 专属主线。研究主线也不代替研究对象名单里的主题。
docs/prd/06-views.md:412:- 验收看原文支持的成员关系和证据能否保留，不要求名称、编号、组数每次完全一样。分别报告没抽出、检查拒绝、漏归和错归，不能混成一个一致性数字。Rubin 出货与客户部署的核心联系要保留，无关产品和其他客户专属主线的错归也要检查；多公司、大库尚未验证。

