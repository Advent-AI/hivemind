   181	class BoundedTransport:
   182	    """One request, durable budget reservation, exact request and raw response, no retries."""
   183	    def __init__(self, out, label, deadline, send=None):
   184	        self.out, self.label, self.deadline, self.send = out, label, deadline, send
   185	
   186	    def __call__(self, provider, request):
   187	        budget_path = self.out / 'budget.json'
   188	        budget = read(budget_path)
   189	        encoded = json.dumps(request, ensure_ascii=False).encode()
   190	        price_in, price_out = model.PRICES[request['model']]
   191	        reserve = (len(encoded) * price_in + request['max_completion_tokens'] * price_out) / 1e6
   192	        if time.monotonic() >= self.deadline or len(budget['attempts']) >= MAX_REQUESTS or budget['reserved_or_spent'] + reserve > MAX_USD:
   193	            raise RuntimeError('Registered time/call/cost limit reached; no request sent')
   194	        record = {'status': 'started', 'label': self.label, 'request': request, 'reserved_usd': reserve}
   195	        budget['attempts'].append({'label': self.label, 'status': 'started', 'reserved_usd': reserve})
   196	        budget['reserved_or_spent'] += reserve
   197	        write(budget_path, budget)
   198	        path = self.out / self.label / f'call-{len(budget["attempts"]):02d}.json'
   199	        write(path, record)
   200	        started = time.monotonic()
   201	        print(f'START {self.label} call={len(budget["attempts"])} reserve=${reserve:.4f}', flush=True)
   202	        try:
   203	            if self.send is not None:
   204	                response = self.send(provider, request)
   205	            else:
   206	                url, _ = model.ENDPOINTS[provider]
   207	                headers = {'Authorization': f'Bearer {model._key(provider)}', 'Content-Type': 'application/json'}
   208	                req = urllib.request.Request(url, data=encoded, headers=headers, method='POST')
   209	                with urllib.request.urlopen(req, timeout=min(180, max(1, self.deadline - time.monotonic()))) as handle:
   210	                    response = json.loads(handle.read().decode())
   211	            record.update(status='complete', response=response, seconds=time.monotonic() - started)
   212	            usage = response.get('usage', {})
   213	            cost = (usage.get('prompt_tokens', 0) * price_in + usage.get('completion_tokens', 0) * price_out) / 1e6
   214	            if 'prompt_tokens' not in usage or 'completion_tokens' not in usage:
   215	                cost = reserve
   216	            budget['reserved_or_spent'] += cost - reserve
   217	            budget['attempts'][-1].update(status='complete', estimated_usd=cost)
   218	            record['estimated_usd'] = cost
   219	            write(path, record)
   220	            write(budget_path, budget)
   221	            print(f'DONE {self.label} usd=${cost:.4f} seconds={record["seconds"]:.1f}', flush=True)
   222	            return response
   223	        except Exception as error:
   224	            # Error type only: avoid logging headers or credential-bearing exception objects.
   225	            record.update(status='failed', error_type=type(error).__name__, seconds=time.monotonic() - started)
   226	            budget['attempts'][-1]['status'] = 'failed'
   227	            write(path, record)
   228	            write(budget_path, budget)
   229	            raise RuntimeError(f'Network attempt failed ({type(error).__name__}); no resend') from None
   230	
