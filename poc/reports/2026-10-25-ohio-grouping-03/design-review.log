   232	def prepare(out, *, role_path=None):
   233	    if (out / 'manifest.json').exists() or any((out / label).exists() for label in LABELS):
   234	        raise ValueError('Use a new experiment directory')
   235	    if not (out / 'preflight.txt').is_file():
   236	        raise ValueError('Run and inspect preflight first')
   237	    with sqlite3.connect(f'file:{ITEMS_DB}?mode=ro', uri=True) as conn:
   238	        conn.row_factory = sqlite3.Row
   239	        items = [dict(conn.execute('select * from items where input_id=?', (ident,)).fetchone()) for ident in ITEM_IDS]
   240	    for item in items:
   241	        item['object_identifiers'] = json.loads(item['object_identifiers'])
   242	    seeds = [dict(g, seq=0, input_id='reference:' + g['input_id']) for g in read(PREFIX)['threads']]
   243	    write(out / 'items.json', items)
   244	    write(out / 'reference-groups.json', seeds)
   245	    write(out / 'config.json', read(ROOT / 'poc/config/poc-v16.json'))
   246	    write(out / 'universe.json', read(ROOT / 'poc/universe.json'))
   247	    paths = list((ROOT / 'src/hivemind').rglob('*.py')) + list((ROOT / 'src/hivemind/prompts').glob('*'))
   248	    paths += [Path(__file__), ROOT / 'poc/hierarchy_study/ingestion_threads.py', ROOT / 'poc/hierarchy_study/study.py',
   249	              ROOT / 'docs/research/2026-10-25-ohio-grouping-poc.md', PREFIX]
   250	    paths += [out / name for name in ('items.json', 'reference-groups.json', 'config.json', 'universe.json', 'preflight.txt')]
   251	    if role_path is not None:
   252	        role_path = Path(role_path).resolve()
   253	        if not role_path.read_text().strip():
   254	            raise ValueError('Experiment role must not be empty')
   255	        paths += [role_path, ROOT / 'docs/research/2026-10-25-ohio-root-cause.md']
   256	    write(out / 'manifest.json', {'version': 'ohio-sequence-v1', 'labels': LABELS, 'max_requests': MAX_REQUESTS,
   257	          'role_path': str(role_path) if role_path else None,
   258	          'max_usd': MAX_USD, 'max_seconds': MAX_SECONDS, 'dependencies': {str(p.resolve()): digest(p) for p in paths if p.is_file()}})
   259	    write(out / 'budget.json', {'attempts': [], 'reserved_or_spent': 0})
   260	
   261	
   262	def verify(out):
   263	    for path, sha in read(out / 'manifest.json')['dependencies'].items():
   264	        if digest(path) != sha:
   265	            raise ValueError(f'Frozen input/code changed: {path}')
   266	
