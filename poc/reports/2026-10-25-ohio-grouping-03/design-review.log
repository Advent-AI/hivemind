    42	def answers(values, requests):
    43	    stream = iter(values)
    44	    def transport(provider, request):
    45	        requests.append(copy.deepcopy(request))
    46	        return {'choices': [{'message': {'content': json.dumps(next(stream), ensure_ascii=False)}}],
    47	                'usage': {'prompt_tokens': 200, 'completion_tokens': 100}}
    48	    return transport
