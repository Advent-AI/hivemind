    46	def open_db(path):
    47	    conn = store.open_db(str(path))
    48	    conn.execute('pragma foreign_keys=on')
    49	    conn.executescript('''
    50	        create table if not exists threads (
    51	            thread_id text primary key, name text not null, scope text not null,
    52	            seq integer not null, input_id text not null);
    53	        create table if not exists thread_members (
    54	            thread_id text not null references threads(thread_id),
    55	            view_id text not null references views(view_id), seq integer not null, input_id text not null,
    56	            primary key(thread_id, view_id));
    57	        create virtual table if not exists thread_search using fts5(thread_id UNINDEXED, name, scope);
    58	        create table if not exists ingestion_events (
