   118	            exact = store.exact_key_views(conn, c)
   119	            candidate_lists[c['id']] = list(dict.fromkeys(exact + same_key))[:top_n]
   120	            continue
   121	        hits = store.search_views(conn, f'{c["object"]} {c["looks_at"]} {c["question"]}', top_n)
   122	        for v in shown_views:
   123	            if v['view_id'] not in hits and v['object_id'] == c['object']:
   124	                hits.append(v['view_id'])
   125	        candidate_lists[c['id']] = hits[:top_n]
   126	    evidence_lists = {}
   127	    candidate_ids = {c['id'] for c in handover.candidates}
   128	    for e in handover.evidence:
   129	        for view_id in e['links']:
   130	            if view_id in candidate_ids:
   131	                continue
   132	            evidence_lists[(e['id'], view_id)] = rank_evidence(conn, view_id, e['one_line'], top_n)
