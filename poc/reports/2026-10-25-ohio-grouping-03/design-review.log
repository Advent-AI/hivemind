   232	def prepare(out, *, role_path=None):
   233	    if (out / 'manifest.json').exists() or any((out / label).exists() for label in LABELS):
   234	        raise ValueError('Use a new experiment directory')
   235	    if not (out / 'preflight.txt').is_file():
   236	        raise ValueError('Run and inspect preflight first')
   237	    with sqlite3.connect(f'file:{ITEMS_DB}?mode=ro', uri=True) as conn:
   238	        conn.row_factory = sqlite3.Row
   239	        items = [dict(conn.execute('select * from items where input_id=?', (ident,)).fetchone()) for ident in ITEM_IDS]
   240	    for item in items:
   241	        item['object_identifiers'] = json.loads(item['object_identifiers'])
   242	    seeds = [dict(g, seq=0, input_id='reference:' + g['input_id']) for g in read(PREFIX)['threads']]
   243	    write(out / 'items.json', items)
   244	    write(out / 'reference-groups.json', seeds)
   245	    write(out / 'config.json', read(ROOT / 'poc/config/poc-v16.json'))
   246	    write(out / 'universe.json', read(ROOT / 'poc/universe.json'))
   247	    paths = list((ROOT / 'src/hivemind').rglob('*.py')) + list((ROOT / 'src/hivemind/prompts').glob('*'))
   248	    paths += [Path(__file__), ROOT / 'poc/hierarchy_study/ingestion_threads.py', ROOT / 'poc/hierarchy_study/study.py',
   249	              ROOT / 'docs/research/2026-10-25-ohio-grouping-poc.md', PREFIX]
   250	    paths += [out / name for name in ('items.json', 'reference-groups.json', 'config.json', 'universe.json', 'preflight.txt')]
   251	    if role_path is not None:
   252	        role_path = Path(role_path).resolve()
   253	        if not role_path.read_text().strip():
   254	            raise ValueError('Experiment role must not be empty')
   255	        paths += [role_path, ROOT / 'docs/research/2026-10-25-ohio-root-cause.md']
   256	    write(out / 'manifest.json', {'version': 'ohio-sequence-v1', 'labels': LABELS, 'max_requests': MAX_REQUESTS,
   257	          'role_path': str(role_path) if role_path else None,
   258	          'max_usd': MAX_USD, 'max_seconds': MAX_SECONDS, 'dependencies': {str(p.resolve()): digest(p) for p in paths if p.is_file()}})
   259	    write(out / 'budget.json', {'attempts': [], 'reserved_or_spent': 0})
   260	
   261	
   262	def verify(out):
   263	    for path, sha in read(out / 'manifest.json')['dependencies'].items():
   264	        if digest(path) != sha:
   265	            raise ValueError(f'Frozen input/code changed: {path}')
   266	
   267	
   268	def run(out):
   269	    with (out / 'run.lock').open('a') as lock:
   270	        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
   271	        verify(out)
   272	        if read(out / 'budget.json')['attempts'] or any((out / label).exists() for label in LABELS):
   273	            raise ValueError('Measurement already started; no automatic resume')
   274	        items = read(out / 'items.json')
   275	        role_path = read(out / 'manifest.json').get('role_path')
   276	        role_text = Path(role_path).read_text() if role_path else None
   277	        uni, cfg = universe.load(out / 'universe.json'), config.load(out / 'config.json')
   278	        deadline = time.monotonic() + MAX_SECONDS
   279	        statuses = {label: 'not_started' for label in LABELS}
   280	        write(out / 'status.json', statuses)
   281	        for label in LABELS:
   282	            verify(out)
   283	            folder = out / label
   284	            folder.mkdir()
   285	            conn = groups.open_db(folder / 'views.sqlite')
   286	            archive = model.Archive(str(folder / 'calls.sqlite'))
   287	            # A role experiment compares two grouped streams; D157's default keeps its original arms.
   288	            grouped = role_text is not None or label.startswith('grouped')
   289	            sample_role = role_text if label.startswith('grouped') else None
   290	            if grouped:
   291	                for g in read(out / 'reference-groups.json'):
   292	                    conn.execute('insert into threads values (?,?,?,?,?)', tuple(g[k] for k in ('thread_id', 'name', 'scope', 'seq', 'input_id')))
   293	                conn.commit()
   294	            transport = BoundedTransport(out, label, deadline)
   295	            try:
   296	                first = None
   297	                for index, item in enumerate(items, 1):
   298	                    directory = folder / f'item{index}'
   299	                    directory.mkdir()
   300	                    result = process(conn, archive, cfg, uni, item, grouped, directory, transport, role_text=sample_role)
   301	                    if result['route'] != 'written':
   302	                        raise Refused(f'Expected extract route, got {result["route"]}')
   303	                    if index == 1:
   304	                        first = result
   305	                historical = [groups.thread_detail(conn, g['thread_id'], first['seq']) for g in first['snapshot']['threads']]
   306	                if historical != first['snapshot']['details']:
   307	                    raise AssertionError('First article history changed')
   308	                if any(dispatch.route(conn, item, uni).kind != 'skipped' for item in items):
   309	                    raise AssertionError('Completed input not skipped on resend')
   310	                write(folder / 'checks.json', {'history_unchanged': True, 'resend_skipped': True, 'semantic_status': 'pending'})
   311	                statuses[label] = 'complete'
   312	            except (Refused, model.SchemaError) as error:
   313	                statuses[label] = 'refused'
   314	                write(folder / 'failed.json', {'kind': type(error).__name__, 'reason': str(error)[:1000]})
   315	            except Exception as error:
   316	                statuses[label] = 'failed'
   317	                write(folder / 'failed.json', {'kind': type(error).__name__, 'reason': str(error)[:1000]})
   318	                write(out / 'status.json', statuses)
   319	                raise
   320	            finally:
   321	                conn.rollback()
   322	                conn.close()
   323	                archive.conn.close()
   324	            verify(out)
   325	            write(out / 'status.json', statuses)
   326	        print(json.dumps(statuses), flush=True)
   327	
   328	
   329	def main():
   330	    parser = argparse.ArgumentParser(description=__doc__)
   331	    parser.add_argument('command', choices=('prepare', 'run'))
   332	    parser.add_argument('--out', type=Path, default=DEFAULT_OUT)
   333	    parser.add_argument('--role-path', type=Path, help='Prepare two grouped arms; only the grouped arm uses this role')
   334	    args = parser.parse_args()
   335	    out = args.out.resolve()
   336	    if args.command == 'prepare':
   337	        prepare(out, role_path=args.role_path)
   338	    else:
   339	        if args.role_path is not None:
   340	            parser.error('run reads the frozen role_path from the prepared manifest')
   341	        run(out)
   342	
   343	
   344	if __name__ == '__main__':
   345	    main()

