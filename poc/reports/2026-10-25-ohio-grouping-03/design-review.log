    69	    ids = [t['id'] for t in raw['threads']]
    70	    if any(re.fullmatch(LOCAL_ID['pattern'], ident) is None for ident in ids):
    71	        raise ValueError('Local thread IDs must use t followed by a positive integer')
    72	    if len(ids) != len(set(ids)) or any(not t['name'].strip() or not t['scope'].strip() for t in raw['threads']):
    73	        raise ValueError('Threads need unique IDs, names and scope')
    74	    used = set()
    75	    for candidate in raw['candidates']:
    76	        refs = candidate['thread_ids']
    77	        if not refs or len(refs) != len(set(refs)) or set(refs) - set(ids):
    78	            raise ValueError('Each candidate needs nonempty, unique local thread references')
    79	        used.update(refs)
