   294	def run(out):
   295	    with (out / 'run.lock').open('a') as lock:
   296	        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
   297	        verify(out)
   298	        if read(out / 'budget.json')['attempts'] or any((out / label).exists() for label in LABELS):
   299	            raise ValueError('Measurement already started; no automatic resume')
