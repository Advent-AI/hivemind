   134	def check_schema(value, schema, path='$'):
   135	    """A small validator for the subset of JSON Schema the prompts use: object/required/additionalProperties,
   136	    array/items, string/enum, integer, number, boolean, null in anyOf."""
   137	    kind = schema.get('type')
   138	    if 'anyOf' in schema:
   139	        errors = []
   140	        for option in schema['anyOf']:
   141	            errors = check_schema(value, option, path)
   142	            if not errors:
   143	                return []
   144	        return errors or [f'{path}: matches no option']
   145	    if kind == 'object':
   146	        if not isinstance(value, dict):
   147	            return [f'{path}: expected object']
   148	        errors = []
   149	        for name in schema.get('required', []):
   150	            if name not in value:
   151	                errors.append(f'{path}.{name}: required')
   152	        properties = schema.get('properties', {})
   153	        for name, item in value.items():
   154	            if name in properties:
   155	                errors.extend(check_schema(item, properties[name], f'{path}.{name}'))
   156	            elif schema.get('additionalProperties') is False:
   157	                errors.append(f'{path}.{name}: not allowed')
   158	        return errors
   159	    if kind == 'array':
   160	        if not isinstance(value, list):
   161	            return [f'{path}: expected array']
   162	        errors = []
   163	        for index, item in enumerate(value):
   164	            errors.extend(check_schema(item, schema.get('items', {}), f'{path}[{index}]'))
   165	        return errors
   166	    if kind == 'string':
   167	        if not isinstance(value, str):
   168	            return [f'{path}: expected string']
   169	        if 'enum' in schema and value not in schema['enum']:
   170	            return [f'{path}: {value!r} not in {schema["enum"]}']
   171	        return []
   172	    if kind == 'integer':
   173	        return [] if isinstance(value, int) and not isinstance(value, bool) else [f'{path}: expected integer']
   174	    if kind == 'number':
   175	        return [] if isinstance(value, (int, float)) and not isinstance(value, bool) else [f'{path}: expected number']
   176	    if kind == 'boolean':
   177	        return [] if isinstance(value, bool) else [f'{path}: expected boolean']
   178	    if kind == 'null':
   179	        return [] if value is None else [f'{path}: expected null']
   180	    return []
