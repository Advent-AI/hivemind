   113	def process(conn, archive, cfg, uni, item, grouped, directory, transport, *, role_text=None):
   114	    """One dispatch, extract, match and atomic write; no hidden repair call."""
   115	    route = dispatch.route(conn, item, uni)
   116	    if route.kind != 'extract':
   117	        return {'route': route.kind, 'input_id': item['input_id']}
   118	    if route.resume_from:
   119	        raise Refused('This measurement does not resume unfinished sequences')
   120	    seq = route.sequence_no
   121	    system, user, shown, offered = context(conn, item, uni, grouped, role_text=role_text)
   122	    write(directory / 'context.json', {'shown': shown, 'offered': offered, 'before': snapshot(conn, seq - 1)})
   123	    answer = model.call(archive, cfg, cfg.extraction_setting(item['category']), system, user,
   124	                        schema(offered) if grouped else extraction.keyed_schema(), 'extraction', 'extract', transport=transport)
   125	    if answer.cached:
   126	        raise Refused('Fresh sample unexpectedly used a cached answer')
   127	    write(directory / 'extraction.json', answer.data)
   128	    if grouped:
   129	        validate_references(answer.data, offered)
   130	    evidence, candidates, dropped = extraction.sift(answer.data, item, item['text'], {v['view_id'] for v in shown}, uni)
   131	    handover = extraction.Handover(evidence, candidates, dropped, answer.call_id, answer.request_sha256, False, answer.cost_usd)
   132	    write(directory / 'handover.json', dataclasses.asdict(handover))
   133	
   134	    def match(name, handover, lists, shown, extra_views=()):
   135	        result = matching.decide(archive, cfg, conn, item, handover.candidates, handover.evidence, lists, shown,
   136	                                 extra_views=extra_views, transport=transport)
   137	        if result.cached:
   138	            raise Refused('Fresh matching sample unexpectedly used cache')
   139	        checked = matching.check(conn, uni, result.data, handover.candidates, handover.evidence, lists, shown)
   140	        write(directory / f'{name}.json', {'answer': result.data, 'outcomes': checked.outcomes,
   141	              'evidence': [[*key, *value] for key, value in checked.evidence.items()],
   142	              'refusals': checked.refusals, 'not_opened': checked.not_opened, 'notes': checked.notes})
   143	        if checked.refusals:
   144	            conn.rollback()
   145	            raise Refused('; '.join(checked.refusals))
   146	        return checked
   147	
   148	    checked = matching.Checked({}, {}, [], {})
   149	    second = {}
   150	    if evidence or candidates:
   151	        checked = match('matching', handover, matching.build_lists(conn, handover, shown, cfg.search_top_n), shown)
   152	        pending = [(e, checked.outcomes[link][1]) for e in evidence for link in e['links']
   153	                   if link in checked.outcomes and checked.outcomes[link][0] == matching.OUTCOMES[0]]
   154	        if pending:
   155	            mapped = {e['id']: dict(e, links=list(dict.fromkeys(v for x, v in pending if x['id'] == e['id']))) for e, _ in pending}
   156	            second_handover = dataclasses.replace(handover, candidates=[], evidence=list(mapped.values()))
   157	            lists = matching.Lists({}, {(e['id'], vid): matching.rank_evidence(conn, vid, e['one_line'], cfg.search_top_n) for e, vid in pending})
   158	            second = match('matching-evidence', second_handover, lists, [], sorted({vid for _, vid in pending})).evidence
   159	    # The group write is in the SAME outer transaction as the current product writer.
   160	    try:
   161	        with conn:
   162	            written = writing.write(conn, uni, seq, item, handover, checked, second)
   163	            bindings, affected = [], []
   164	            if grouped:
   165	                used = {ref for c in candidates for ref in c['thread_ids']}
   166	                definitions = [g for g in answer.data['threads'] if g['id'] in used]
   167	                bindings, affected = groups.write_threads(conn, definitions, {ref: ref for ref in used}, handover, checked, written, seq, item)
   168	            store.insert(conn, 'handovers', input_id=item['input_id'], seq=seq, handover_json=json.dumps(dataclasses.asdict(handover), ensure_ascii=False))
   169	            dispatch.mark(conn, item, seq, 'written', 'ok', json.dumps({'new': written.new_views, 'changed': sorted(written.changed_views)}))
   170	            dispatch.mark(conn, item, seq, 'handed_over', 'ok', '')
   171	    except Exception:
   172	        conn.rollback()
   173	        raise
   174	    result = {'route': 'written', 'input_id': item['input_id'], 'seq': seq, 'new_views': written.new_views,
   175	              'evidence_ids': written.evidence_ids, 'bindings': bindings, 'affected_threads': affected,
   176	              'notes': written.notes, 'snapshot': snapshot(conn, seq)}
   177	    write(directory / 'result.json', result)
   178	    return result
