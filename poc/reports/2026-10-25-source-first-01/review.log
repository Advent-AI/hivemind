   113	def process(conn, archive, cfg, uni, item, grouped, directory, transport, *, role_text=None):
   114	    """One dispatch, extract, match and atomic write; no hidden repair call."""
   115	    route = dispatch.route(conn, item, uni)
   116	    if route.kind != 'extract':
   117	        return {'route': route.kind, 'input_id': item['input_id']}
   118	    if route.resume_from:
   119	        raise Refused('This measurement does not resume unfinished sequences')
