   121	    system, user, shown, offered = context(conn, item, uni, grouped, role_text=role_text)
   122	    write(directory / 'context.json', {'shown': shown, 'offered': offered, 'before': snapshot(conn, seq - 1)})
   123	    answer = model.call(archive, cfg, cfg.extraction_setting(item['category']), system, user,
   124	                        schema(offered) if grouped else extraction.keyed_schema(), 'extraction', 'extract', transport=transport)
   125	    if answer.cached:
   126	        raise Refused('Fresh sample unexpectedly used a cached answer')
