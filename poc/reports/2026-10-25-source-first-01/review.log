   183	def call(archive, cfg, setting, system, user, schema, schema_name, purpose, *, transport=None):
   184	    provider = cfg.provider
   185	    request = build_request(setting, system, user, schema, schema_name, provider)
   186	    request_json = json.dumps(request, sort_keys=True, ensure_ascii=False)
   187	    sha = hashlib.sha256(request_json.encode('utf-8')).hexdigest()
   188	    hit = archive.lookup(sha)
   189	    prompt_chars = len(system) + len(user)
   190	    if hit:
   191	        call_id, answer_json, _, input_tokens, output_tokens = hit
   192	        return Answer(json.loads(answer_json), call_id, sha, True, prompt_chars, input_tokens or 0, output_tokens or 0, 0.0)
   193	    started = time.time()
   194	    response = (transport or openai_transport)(provider, request)
   195	    seconds = round(time.time() - started, 1)
   196	    try:
   197	        content = response['choices'][0]['message']['content']
   198	        data = json.loads(content)
   199	    except (KeyError, IndexError, TypeError, json.JSONDecodeError) as error:
   200	        archive.record(purpose=purpose, config_version=cfg.version, config_checksum=cfg.checksum, model=setting.model,
   201	                       request_sha256=sha + ':malformed:' + uuid.uuid4().hex[:8], request_json=request_json,
   202	                       response_json=json.dumps(response)[:200000], answer_json=None, prompt_chars=prompt_chars,
   203	                       input_tokens=0, output_tokens=0, cost_usd=0.0, seconds=seconds, created_at=time.strftime('%Y-%m-%dT%H:%M:%S'))
   204	        raise SchemaError(f'malformed answer: {error}')
   205	    errors = check_schema(data, schema)
   206	    usage = response.get('usage') or {}
   207	    input_tokens = int(usage.get('prompt_tokens') or 0)
   208	    output_tokens = int(usage.get('completion_tokens') or 0)
   209	    price_in, price_out = PRICES.get(setting.model, (0.0, 0.0))
   210	    cost = round(input_tokens / 1e6 * price_in + output_tokens / 1e6 * price_out, 6)
   211	    call_id = archive.record(purpose=purpose, config_version=cfg.version, config_checksum=cfg.checksum, model=setting.model,
   212	                             request_sha256=sha if not errors else sha + ':schema:' + uuid.uuid4().hex[:8], request_json=request_json,
   213	                             response_json=json.dumps(response)[:200000], answer_json=json.dumps(data, ensure_ascii=False),
   214	                             prompt_chars=prompt_chars, input_tokens=input_tokens, output_tokens=output_tokens, cost_usd=cost,
   215	                             seconds=seconds, created_at=time.strftime('%Y-%m-%dT%H:%M:%S'))
   216	    if errors:
   217	        raise SchemaError('; '.join(errors[:5]))
   218	    return Answer(data, call_id, sha, False, prompt_chars, input_tokens, output_tokens, cost)
