   357	def main():
   358	    parser = argparse.ArgumentParser(description=__doc__)
   359	    parser.add_argument('command', choices=('prepare', 'run'))
   360	    parser.add_argument('--out', type=Path, default=DEFAULT_OUT)
   361	    parser.add_argument('--role-path', type=Path, help='Prepare two grouped arms; only the grouped arm uses this role')
   362	    parser.add_argument('--control-role-path', type=Path, help='Explicit control role for a two-role comparison')
   363	    parser.add_argument('--item-id', action='append', help='Prepare with these stored inputs, in stream order')
   364	    parser.add_argument('--max-requests', type=int, default=MAX_REQUESTS, help='Registered attempt limit; dollar cap is unchanged')
   365	    parser.add_argument('--design-path', type=Path, help='Freeze the registered design with the experiment')
   366	    args = parser.parse_args()
   367	    out = args.out.resolve()
   368	    if args.command == 'prepare':
   369	        prepare(out, role_path=args.role_path, control_role_path=args.control_role_path,
   370	                item_ids=args.item_id, max_requests=args.max_requests, design_path=args.design_path)
   371	    else:
   372	        if (args.role_path is not None or args.control_role_path is not None or args.item_id is not None
   373	                or args.design_path is not None or args.max_requests != MAX_REQUESTS):
   374	            parser.error('run reads the frozen settings from the prepared manifest')
   375	        run(out)
   376	
