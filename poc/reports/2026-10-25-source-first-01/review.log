    66	def validate_references(raw, offered):
    67	    errors = model.check_schema(raw, schema(offered))
    68	    if errors:
    69	        raise Refused('; '.join(errors))
    70	    ids = [g['id'] for g in raw['threads']]
    71	    candidate_ids = [c['id'] for c in raw['candidates']]
    72	    if len(candidate_ids) != len(set(candidate_ids)):
    73	        raise Refused('ambiguous candidate IDs')
    74	    if len(ids) != len(set(ids)) or any(re.fullmatch(r't[1-9][0-9]*', ident) is None for ident in ids):
    75	        raise Refused('new groups need unique local t IDs')
    76	    if any(not g['name'].strip() or not g['scope'].strip() for g in raw['threads']):
    77	        raise Refused('group name and scope must be nonempty')
    78	    allowed = set(ids) | {g['thread_id'] for g in offered}
    79	    for c in raw['candidates']:
    80	        refs = c['thread_ids']
    81	        if not refs or len(refs) != len(set(refs)) or set(refs) - allowed:
    82	            raise Refused(f'{c["id"]}: invalid group references')
