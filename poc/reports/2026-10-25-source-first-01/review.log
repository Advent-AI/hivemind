   294	def run(out):
   295	    with (out / 'run.lock').open('a') as lock:
   296	        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
   297	        verify(out)
   298	        if read(out / 'budget.json')['attempts'] or any((out / label).exists() for label in LABELS):
   299	            raise ValueError('Measurement already started; no automatic resume')
   300	        items = read(out / 'items.json')
   301	        role_path = read(out / 'manifest.json').get('role_path')
   302	        role_text = Path(role_path).read_text() if role_path else None
   303	        control_role_path = read(out / 'manifest.json').get('control_role_path')
   304	        control_role_text = Path(control_role_path).read_text() if control_role_path else None
   305	        uni, cfg = universe.load(out / 'universe.json'), config.load(out / 'config.json')
   306	        deadline = time.monotonic() + MAX_SECONDS
   307	        statuses = {label: 'not_started' for label in LABELS}
   308	        write(out / 'status.json', statuses)
   309	        for label in LABELS:
   310	            verify(out)
   311	            folder = out / label
   312	            folder.mkdir()
   313	            conn = groups.open_db(folder / 'views.sqlite')
   314	            archive = model.Archive(str(folder / 'calls.sqlite'))
   315	            # A role experiment compares two grouped streams; D157's default keeps its original arms.
   316	            grouped = role_text is not None or label.startswith('grouped')
   317	            sample_role = role_text if label.startswith('grouped') else control_role_text
   318	            if grouped:
   319	                for g in read(out / 'reference-groups.json'):
   320	                    conn.execute('insert into threads values (?,?,?,?,?)', tuple(g[k] for k in ('thread_id', 'name', 'scope', 'seq', 'input_id')))
   321	                conn.commit()
   322	            transport = BoundedTransport(out, label, deadline)
   323	            try:
   324	                first = None
   325	                for index, item in enumerate(items, 1):
   326	                    directory = folder / f'item{index}'
   327	                    directory.mkdir()
   328	                    result = process(conn, archive, cfg, uni, item, grouped, directory, transport, role_text=sample_role)
   329	                    if result['route'] != 'written':
   330	                        raise Refused(f'Expected extract route, got {result["route"]}')
   331	                    if index == 1:
   332	                        first = result
   333	                historical = [groups.thread_detail(conn, g['thread_id'], first['seq']) for g in first['snapshot']['threads']]
   334	                if historical != first['snapshot']['details']:
   335	                    raise AssertionError('First article history changed')
   336	                if any(dispatch.route(conn, item, uni).kind != 'skipped' for item in items):
   337	                    raise AssertionError('Completed input not skipped on resend')
   338	                write(folder / 'checks.json', {'history_unchanged': True, 'resend_skipped': True, 'semantic_status': 'pending'})
   339	                statuses[label] = 'complete'
   340	            except (Refused, model.SchemaError) as error:
   341	                statuses[label] = 'refused'
   342	                write(folder / 'failed.json', {'kind': type(error).__name__, 'reason': str(error)[:1000]})
   343	            except Exception as error:
   344	                statuses[label] = 'failed'
   345	                write(folder / 'failed.json', {'kind': type(error).__name__, 'reason': str(error)[:1000]})
   346	                write(out / 'status.json', statuses)
   347	                raise
   348	            finally:
   349	                conn.rollback()
   350	                conn.close()
   351	                archive.conn.close()
   352	            verify(out)
   353	            write(out / 'status.json', statuses)
   354	        print(json.dumps(statuses), flush=True)
