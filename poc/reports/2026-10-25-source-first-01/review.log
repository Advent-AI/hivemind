   234	def prepare(out, *, role_path=None, control_role_path=None, item_ids=None, max_requests=MAX_REQUESTS, design_path=None):
   235	    if (out / 'manifest.json').exists() or any((out / label).exists() for label in LABELS):
   236	        raise ValueError('Use a new experiment directory')
   237	    if not (out / 'preflight.txt').is_file():
   238	        raise ValueError('Run and inspect preflight first')
   239	    if control_role_path is not None and role_path is None:
   240	        raise ValueError('An explicit control role requires an experiment role')
   241	    item_ids = ITEM_IDS if item_ids is None else tuple(item_ids)
   242	    if not item_ids or len(item_ids) != len(set(item_ids)) or max_requests < 1:
   243	        raise ValueError('Provide unique input IDs and a positive registered request limit')
   244	    with sqlite3.connect(f'file:{ITEMS_DB}?mode=ro', uri=True) as conn:
   245	        conn.row_factory = sqlite3.Row
   246	        items = []
   247	        for ident in item_ids:
   248	            row = conn.execute('select * from items where input_id=?', (ident,)).fetchone()
   249	            if row is None or not row['text']:
   250	                raise ValueError(f'Missing source item/text: {ident}')
   251	            items.append(dict(row))
   252	    if [i['publication_day'] for i in items] != sorted(i['publication_day'] for i in items):
   253	        raise ValueError('Inputs must be in publication order')
   254	    for item in items:
   255	        item['object_identifiers'] = json.loads(item['object_identifiers'])
   256	    seeds = [dict(g, seq=0, input_id='reference:' + g['input_id']) for g in read(PREFIX)['threads']]
   257	    write(out / 'items.json', items)
   258	    write(out / 'reference-groups.json', seeds)
   259	    write(out / 'config.json', read(ROOT / 'poc/config/poc-v16.json'))
   260	    write(out / 'universe.json', read(ROOT / 'poc/universe.json'))
   261	    paths = list((ROOT / 'src/hivemind').rglob('*.py')) + list((ROOT / 'src/hivemind/prompts').glob('*'))
   262	    paths += [Path(__file__), ROOT / 'poc/hierarchy_study/ingestion_threads.py', ROOT / 'poc/hierarchy_study/study.py',
   263	              ROOT / 'docs/research/2026-10-25-ohio-grouping-poc.md', PREFIX]
   264	    paths += [out / name for name in ('items.json', 'reference-groups.json', 'config.json', 'universe.json', 'preflight.txt')]
   265	    if role_path is not None:
   266	        role_path = Path(role_path).resolve()
   267	        if not role_path.read_text().strip():
   268	            raise ValueError('Experiment role must not be empty')
   269	        paths += [role_path, ROOT / 'docs/research/2026-10-25-ohio-root-cause.md']
   270	    if control_role_path is not None:
   271	        control_role_path = Path(control_role_path).resolve()
   272	        if not control_role_path.read_text().strip():
   273	            raise ValueError('Control role must not be empty')
   274	        paths.append(control_role_path)
   275	    if design_path is not None:
   276	        design_path = Path(design_path).resolve()
   277	        if not design_path.is_file():
   278	            raise ValueError('Registered design must exist')
   279	        paths.append(design_path)
   280	    write(out / 'manifest.json', {'version': 'ohio-sequence-v1', 'labels': LABELS, 'max_requests': max_requests,
   281	          'item_ids': item_ids, 'design_path': str(design_path) if design_path else None,
   282	          'role_path': str(role_path) if role_path else None,
   283	          'control_role_path': str(control_role_path) if control_role_path else None,
   284	          'max_usd': MAX_USD, 'max_seconds': MAX_SECONDS, 'dependencies': {str(p.resolve()): digest(p) for p in paths if p.is_file()}})
   285	    write(out / 'budget.json', {'attempts': [], 'reserved_or_spent': 0})
   286	
