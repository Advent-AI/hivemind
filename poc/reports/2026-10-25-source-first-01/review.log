    52	def keyed_schema():
    53	    """SCHEMA with the key fields on every candidate and numeric bounds on every rung."""
    54	    schema = json.loads(json.dumps(SCHEMA))
    55	    candidate = schema['properties']['candidates']['items']
    56	    candidate['properties'].update(KEY_FIELDS)
    57	    candidate['required'] += list(KEY_FIELDS)
    58	    rung = candidate['properties']['rungs']['items']
    59	    rung['properties'].update({'lo': BOUND, 'hi': BOUND})
    60	    rung['required'] += ['lo', 'hi']
    61	    return schema
