   187	def would_cycle(conn, view_id, depends_on):
   188	    """True when depends_on already depends, directly or through its dependencies, on view_id."""
   189	    seen, stack = set(), [depends_on]
   190	    while stack:
   191	        current = stack.pop()
   192	        if current == view_id:
   193	            return True
   194	        if current in seen or not current:
   195	            continue
   196	        seen.add(current)
   197	        for dep in dependencies_of(conn, current):
   198	            if dep['resolved_to']:
   199	                stack.append(dep['resolved_to'])
   200	    return False
