   138	    candidate_ids = {c['id'] for c in handover.candidates}
   139	    for e in handover.evidence:
   140	        for view_id in e['links']:
   141	            if view_id in candidate_ids:
   142	                continue
   143	            evidence_lists[(e['id'], view_id)] = rank_evidence(conn, view_id, e['one_line'], top_n)
