   118	def open_views_with_key(conn, object_id, measure, scope_key, period_start, period_end, basis='n/a', unit='n/a'):
   119	    """Open views of the object with the same measure, scope and unit whose period overlaps: the ones a candidate must
   120	    be confirmed against before it may open (keyed-views-plan.md 2.5). A basis or unit of n/a on either side matches
   121	    any; GAAP and non-GAAP are two quantities, and so are a level in USD and a growth rate in percent."""
   122	    scope_clause = 'and k.scope_key=?' if scope_key is not None else ''
   123	    params = (object_id, measure) + ((scope_key,) if scope_key is not None else ()) + (period_end or '9999', period_start or '0000')
   124	    rows = conn.execute(f'''select k.view_id, k.basis, k.unit from view_keys k join views v on v.view_id=k.view_id
   125	                            where v.object_id=? and k.measure=? {scope_clause} and k.period_start<=? and k.period_end>=? order by v.rowid''', params).fetchall()
   126	    return [r['view_id'] for r in rows if is_open(conn, r['view_id']) and (basis == 'n/a' or r['basis'] == 'n/a' or r['basis'] == basis)
   127	            and (unit == 'n/a' or r['unit'] == 'n/a' or r['unit'] == unit)]
