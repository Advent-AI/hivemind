   167	def check_bounds(rungs):
   168	    """None when the rungs' numeric bounds form one unbroken partition (or none carries bounds), else the problem."""
   169	    bounded = [r for r in rungs if r.get('lo') is not None or r.get('hi') is not None]
   170	    if not bounded:
   171	        return None
   172	    if len(bounded) != len(rungs):
   173	        return 'some rungs carry bounds and some do not'
   174	    ordered = sorted(rungs, key=lambda r: -1e300 if r.get('lo') is None else float(r['lo']))
   175	    for a, b in zip(ordered, ordered[1:]):
   176	        if a.get('hi') is None or b.get('lo') is None or float(a['hi']) != float(b['lo']):
   177	            return 'rung bounds overlap or leave a gap'
   178	    if ordered[-1].get('hi') is not None:
   179	        return 'the top rung must be open above'
   180	    return None
   181	
