   224	def search_views(conn, text, top_n):
   225	    """Trigram full-text search over question + looks_at + object; the top N by rank."""
   226	    words = [w for w in text.replace('？', ' ').replace('，', ' ').split() if len(w) >= 2]
   227	    if not words:
   228	        return []
   229	    query = ' OR '.join('"' + w.replace('"', '') + '"' for w in words[:12])
   230	    try:
   231	        rows = conn.execute('select view_id from views_fts where views_fts match ? order by rank limit ?', (query, top_n)).fetchall()
   232	    except sqlite3.OperationalError:
   233	        return []
   234	    return [r['view_id'] for r in rows]
