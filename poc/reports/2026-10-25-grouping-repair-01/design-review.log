    94	def build_prompt(item, text, shown_views, universe, version='v1'):
    95	    """The five blocks of 05-extraction: role; this category and how to read it; who it is about plus the list's
    96	    themes; what to read out; the objects' existing views with who depends on whom (no state, no evidence)."""
    97	    category = item['category']
    98	    categories = _categories(version)
    99	    blocks = categories.get(category) or categories['T7']
   100	    objects = [o['value'] for o in item.get('object_identifiers') or []]
   101	    themes = '\n'.join(f'  - {theme_id}：{name}' for theme_id, name in universe.theme_list())
   102	    fiscal = '\n'.join(note for note in (universe.fiscal_note(o, item['publication_day']) for o in objects) if note)
   103	    system = _read(f'role-{version}.txt')
   104	    parts = [
   105	        f'【这一类是什么、怎么读】{category}。{blocks["what"]}',
   106	        f'【讲的是谁】这条信息的相关对象：{"、".join(objects) or "（上游没有标）"}。候选观点讲的是公司时，object 写股票代码；讲的是主题时，从下面名单里挑一个写编号，名单里没有的写清是什么事：\n{themes}'
   107	        + (f'\n财年说明（数字观点的年份和到期日按这个算）：\n{fiscal}' if fiscal else ''),
   108	        f'【这一类要读出什么】{blocks["read"]}',
   109	    ]
   110	    if version and int(version.lstrip('v') or 0) >= 4:      # keyed-views-plan.md 2.4: the quantities the analyst watches, with the exact scope names to copy
   111	        watched = []
   112	        for o in objects:
   113	            entries = universe.watch_list(o) if hasattr(universe, 'watch_list') else []
   114	            if entries:
   115	                watched.append(f'  - {o}：' + '；'.join(e['measure'] + (f"[{e['scope']}]" if e.get('scope') else '') + (f"({e['event_type']})" if e.get('event_type') else '') for e in entries))
   116	        if watched:
   117	            parts.append('【要盯的量】这些对象分析师盯的量（measure[scope](event_type)）。候选观点的 measure 和 scope 照这里的写法填；清单外的量照样写出来，代码会放进复核池而不开：\n' + '\n'.join(watched))
   118	    if shown_views:
   119	        lines = []
   120	        for v in shown_views:       # 05-extraction block 5: question, looks_at, due day and who depends on whom; no state, no evidence
   121	            deps = f'；依赖：{"、".join(v["depends_on"])}' if v.get('depends_on') else ''
   122	            lines.append(f'  - {v["view_id"]}（{v["object_id"]}，看的是「{v["looks_at"]}」，到期 {v["due_day"]}）：{v["question"]}{deps}')
   123	        parts.append('【这些对象已有的观点】证据连到这些观点上，用它们的编号；它们管不到的才写候选观点：\n' + '\n'.join(lines))
   124	    else:
   125	        parts.append('【这些对象已有的观点】还没有。该开的都写成候选观点。')
   126	    parts.append(f'【信息】编号 {item["input_id"]}，类别 {category}，作者 {item.get("publisher")}（{item.get("publisher_type")}），发布日 {item.get("publication_day")}，标题：{item.get("title") or ""}\n\n' + text[:MAX_TEXT_CHARS])
   127	    parts.append('按 JSON schema 交出 evidence 和 candidates。候选观点的 evidence_ids 填它自己的证据编号；证据的 links 填已有观点编号或这次候选观点的编号（如 c1）。没有可抽的就都交空数组。')
   128	    return system, '\n\n'.join(parts)
