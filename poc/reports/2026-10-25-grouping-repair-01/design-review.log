   180	def dependants_of(conn, view_id):
   181	    direct = [r['view_id'] for r in conn.execute('select view_id from dependencies where depends_on=?', (view_id,))]
   182	    resolved = [r['view_id'] for r in conn.execute(
   183	        'select d.view_id from dependency_resolutions r join dependencies d on d.dependency_id=r.dependency_id where r.resolved_to=?', (view_id,))]
   184	    return sorted(set(direct + resolved))
