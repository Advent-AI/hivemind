   166	def dependencies_of(conn, view_id):
   167	    """Each dependency with its current target: the resolved view, or the waiting chain and year."""
   168	    out = []
   169	    for dep in conn.execute('select * from dependencies where view_id=? order by dependency_id', (view_id,)):
   170	        dep = dict(dep)
   171	        resolution = conn.execute('select resolved_to, reason from dependency_resolutions where dependency_id=? order by id desc limit 1', (dep['dependency_id'],)).fetchone()
   172	        if resolution:
   173	            dep['resolved_to'], dep['resolution'] = resolution['resolved_to'], resolution['reason']
   174	        else:
   175	            dep['resolved_to'], dep['resolution'] = dep['depends_on'], ('direct' if dep['depends_on'] else 'waiting')
   176	        out.append(dep)
   177	    return out
