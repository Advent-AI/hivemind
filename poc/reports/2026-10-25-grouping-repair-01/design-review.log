    78	def _words(text):
    79	    """Tokens for the within-view ranking: latin words and numbers, and character bigrams for Chinese runs (a
    80	    Chinese one-line has no spaces, so whole clauses would otherwise be single tokens that never overlap)."""
    81	    text = (text or '').lower()
    82	    words = set(re.findall(r'[a-z0-9]+(?:[.,][0-9]+)?%?', text))
    83	    for run in CJK_RUN.findall(text):
    84	        words.update(run[i:i + 2] for i in range(len(run) - 1))
    85	    return words
