   114	def key_matches(conn, c):
   115	    """keyed-views-plan.md 2.5: the open views a keyed candidate must be confirmed against (same object, measure and scope,
   116	    overlapping period); empty for a candidate without a key."""
   117	    if not c.get('measure'):
