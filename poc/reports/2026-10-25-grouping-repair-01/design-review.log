    96	    written = 0
    97	    for cid, reason in handover.dropped:
    98	        if reason.startswith('watch:'):
    99	            store.pool(conn, 'candidate_outside_watch', reason, {'input_id': item['input_id'], 'candidate': cid}, seq)
   100	            written += 1
   101	    return written
