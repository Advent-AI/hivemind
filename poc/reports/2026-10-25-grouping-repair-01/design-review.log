    33	INDEXES = [
    34	    'create index if not exists views_object on views(object_id)',
    35	    'create index if not exists judgements_view on judgements(view_id, judgement_id)',
    36	    # 06-views step 7: a view is judged once per round (one item = one sequence number)
    37	    'create unique index if not exists judgements_once_per_round on judgements(view_id, seq)',
    38	    'create index if not exists links_view on evidence_links(view_id)',
    39	    'create index if not exists links_evidence on evidence_links(evidence_id)',
    40	    'create index if not exists sources_evidence on evidence_sources(evidence_id)',
    41	    'create index if not exists steps_input on processing_steps(input_id, id)',
    42	    'create index if not exists switches_view on view_switches(view_id, id)',
    43	    'create index if not exists deps_view on dependencies(view_id)',
    44	]
    45	
    46	
    47	def open_db(path):
    48	    os.makedirs(os.path.dirname(os.path.abspath(path)), exist_ok=True)
    49	    conn = sqlite3.connect(path)
    50	    conn.row_factory = sqlite3.Row
    51	    for name, columns in TABLES.items():
    52	        conn.execute(f'create table if not exists {name} ({columns})')
    53	        conn.execute(f"create trigger if not exists {name}_no_update before update on {name} begin select raise(abort, 'append-only'); end")
    54	        conn.execute(f"create trigger if not exists {name}_no_delete before delete on {name} begin select raise(abort, 'append-only'); end")
    55	    for statement in INDEXES:
    56	        conn.execute(statement)
    57	    conn.execute("create virtual table if not exists views_fts using fts5(view_id unindexed, text, tokenize='trigram')")
    58	    conn.commit()
    59	    return conn
    60	
    61	
    62	def insert(conn, table, **fields):
    63	    columns = list(fields)
    64	    cursor = conn.execute(f'insert into {table} ({",".join(columns)}) values ({",".join("?" * len(columns))})', [fields[c] for c in columns])
    65	    return cursor.lastrowid
    66	
    67	
    68	# ---------- views ----------
    69	
    70	def create_view(conn, *, view_id, object_id, object_kind, kind, looks_at, question, due_day, year, rungs, seq, input_id, created_at):
    71	    insert(conn, 'views', view_id=view_id, object_id=object_id, object_kind=object_kind, kind=kind, looks_at=looks_at,
    72	           question=question, due_day=due_day, year=year, created_seq=seq, created_from_input=input_id, created_at=created_at)
    73	    for position, rung in enumerate(rungs, start=1):
    74	        insert(conn, 'rungs', view_id=view_id, position=position, label=rung['label'], condition=rung['condition'], lo=rung.get('lo'), hi=rung.get('hi'))
    75	    insert(conn, 'view_switches', view_id=view_id, open=1, reason='created', by_whom='matching', after_seq=seq)
    76	    conn.execute('insert into views_fts (view_id, text) values (?, ?)', (view_id, f'{object_id} {looks_at} {question}'))
    77	
    78	
    79	def view(conn, view_id):
    80	    row = conn.execute('select * from views where view_id=?', (view_id,)).fetchone()
    81	    return dict(row) if row else None
    82	
    83	
    84	def rungs_of(conn, view_id):
    85	    """The rungs with their bounds when the ledger has them (keyed views); a ledger written before keys has no lo/hi columns."""
    86	    rows = [dict(r) for r in conn.execute('select * from rungs where view_id=? order by position', (view_id,))]
    87	    return [{'position': r['position'], 'label': r['label'], 'condition': r['condition'], 'lo': r.get('lo'), 'hi': r.get('hi')} for r in rows]
    88	
    89	
    90	def add_key(conn, view_id, key, seq):
    91	    """The view's key (keyed-views-plan.md 2.1), written once with the view."""
    92	    from .. import universe as _universe
    93	    ensure_key_columns(conn)
    94	    insert(conn, 'view_keys', view_id=view_id, measure=key['measure'], scope=key.get('scope', ''), scope_key=_universe.scope_key(key.get('scope', '')),
    95	           period_start=key.get('period_start', ''), period_end=key.get('period_end', ''), basis=key.get('basis', 'n/a'), unit=key.get('unit', 'n/a'),
    96	           event_type=key.get('event_type', 'n/a'), seq=seq, scope_source=key.get('scope_source', 'model'))
    97	
    98	
    99	def ensure_key_columns(conn):
   100	    """A keyed ledger written before `scope_source` gains the column (append-only forbids updates, not new columns); its
   101	    earlier keys read as model-owned scopes unless the scope is empty."""
   102	    columns = [r[1] for r in conn.execute('pragma table_info(view_keys)')]
   103	    if columns and 'scope_source' not in columns:
   104	        conn.execute('alter table view_keys add column scope_source text')
   105	
   106	
   107	def view_key(conn, view_id):
   108	    ensure_key_columns(conn)
   109	    row = conn.execute('select * from view_keys where view_id=?', (view_id,)).fetchone()
   110	    if not row:
   111	        return None
   112	    key = dict(row)
   113	    if not key.get('scope_source'):
   114	        key['scope_source'] = 'none' if not key['scope'] else 'model'
   115	    return key
   116	
   117	
   118	def open_views_with_key(conn, object_id, measure, scope_key, period_start, period_end, basis='n/a', unit='n/a'):
   119	    """Open views of the object with the same measure, scope and unit whose period overlaps: the ones a candidate must
   120	    be confirmed against before it may open (keyed-views-plan.md 2.5). A basis or unit of n/a on either side matches
   121	    any; GAAP and non-GAAP are two quantities, and so are a level in USD and a growth rate in percent."""
   122	    scope_clause = 'and k.scope_key=?' if scope_key is not None else ''
   123	    params = (object_id, measure) + ((scope_key,) if scope_key is not None else ()) + (period_end or '9999', period_start or '0000')
   124	    rows = conn.execute(f'''select k.view_id, k.basis, k.unit from view_keys k join views v on v.view_id=k.view_id
   125	                            where v.object_id=? and k.measure=? {scope_clause} and k.period_start<=? and k.period_end>=? order by v.rowid''', params).fetchall()
   126	    return [r['view_id'] for r in rows if is_open(conn, r['view_id']) and (basis == 'n/a' or r['basis'] == 'n/a' or r['basis'] == basis)
   127	            and (unit == 'n/a' or r['unit'] == 'n/a' or r['unit'] == unit)]
   128	
   129	
   130	def is_open(conn, view_id):
   131	    row = conn.execute('select open from view_switches where view_id=? order by id desc limit 1', (view_id,)).fetchone()
   132	    return bool(row and row['open'])
