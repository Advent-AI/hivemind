   203	def views_for_prompt(conn, object_ids):
   204	    """05-extraction block 5: the objects' open views plus every view they depend on, open or closed, with who
   205	    depends on whom; question, looks_at and due day only."""
   206	    shown, order = {}, []
   207	    for object_id in object_ids:
   208	        for view_id in views_of_object(conn, object_id):
   209	            if view_id not in shown:
   210	                shown[view_id] = dict(view(conn, view_id), open=True, depends_on=[])
   211	                order.append(view_id)
   212	    for view_id in list(order):
   213	        for dep in dependencies_of(conn, view_id):
   214	            target = dep['resolved_to']
   215	            shown[view_id]['depends_on'].append(target or f'（等 {dep["wait_chain_view_id"]} 这条链上 {dep["wait_year"]} 年的那条）')
   216	            if target and target not in shown:
   217	                record = view(conn, target)
   218	                if record:
   219	                    shown[target] = dict(record, open=is_open(conn, target), depends_on=[])
   220	                    order.append(target)
   221	    return [dict(shown[v], rungs=rungs_of(conn, v)) for v in order]
