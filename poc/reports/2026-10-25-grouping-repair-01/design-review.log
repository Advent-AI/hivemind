   121	    scope_key = _universe.scope_key(c.get('scope', '')) if c.get('scope_source') in ('none', 'watch') else None
   122	    return store.open_views_with_key(conn, c['object'], c['measure'], scope_key, c.get('period_start', ''), c.get('period_end', ''), c.get('basis', 'n/a'), c.get('unit', 'n/a'))
