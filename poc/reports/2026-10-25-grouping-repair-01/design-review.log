   183	def sift(data, item, text, shown_ids, universe=None):
   184	    """05-extraction step 3, the code checks on one answer: ladders, the quarter and year rules, due days, quotes in
   185	    the text, links to shown views or kept candidates, one piece per sentence. Returns (evidence, candidates,
   186	    dropped); the preflight runs it over every stored answer."""
   187	    body = normalise(text)
   188	    dropped = []
   189	    candidates = []
   190	    candidate_ids = set()
   191	    for c in data.get('candidates', []):
   192	        problem = check_ladder(c['rungs'], c['kind'])
   193	        if problem:
   194	            dropped.append((c['id'], f'candidate ladder: {problem}'))
   195	            continue
   196	        c = dict(c, rungs=normalise_ladder(c['rungs'], c['kind']))
   197	        if QUARTERLY.search(c['looks_at'] + ' ' + c['question']) and c['kind'] == '对象观点':
   198	            dropped.append((c['id'], 'quarterly number: evidence, not a view (06-views ladder rule 6)'))
   199	            continue
   200	        year_match = re.search(r'(\d{4})', c['year'] or '')
   201	        if year_match and int(year_match.group(1)) > int(item['publication_day'][:4]) + 1:
   202	            dropped.append((c['id'], f'year {c["year"]} is beyond next year: not opened (06-views 不开)'))
   203	            continue
   204	        if not re.match(r'\d{4}-\d{2}-\d{2}$', c['due_day']):
   205	            dropped.append((c['id'], f'due_day not a date: {c["due_day"]!r}'))
   206	            continue
   207	        if c['due_day'] <= item['publication_day']:
   208	            dropped.append((c['id'], f'due_day {c["due_day"]} not after the item'))
   209	            continue
   210	        if c.get('measure'):          # keyed candidates: bounds must partition, and the key must be on the object's watch list (2.4)
   211	            problem = check_bounds(c['rungs'])
   212	            if problem:
   213	                dropped.append((c['id'], f'candidate ladder bounds: {problem}'))
   214	                continue
   215	            if universe is not None:
   216	                object_id = universe.resolve(c['object']) or c['object']
   217	                if not universe.watch_allows(object_id, c['measure'], c.get('scope', ''), c.get('event_type', 'n/a')):
   218	                    dropped.append((c['id'], f'watch: {c["measure"]}[{c.get("scope", "")}] is not on {c["object"]}\'s list; review pool'))
   219	                    continue
   220	                scope, source = universe.scope_and_source(object_id, c['measure'], c.get('scope', ''), c.get('event_type', 'n/a'))
   221	                c = dict(c, scope=scope, scope_source=source)                                                                            # code owns the scope's spelling
   222	                if c['measure'] not in ('event', 'policy_event'):
   223	                    period = universe.fiscal_period(object_id, c.get('year', ''))                                                        # and the period of a yearly number
   224	                    if period:
   225	                        c = dict(c, period_start=period[0], period_end=period[1])
   226	        candidates.append(c)
   227	        candidate_ids.add(c['id'])
   228	    evidence = []
   229	    kept_ids = set()
   230	    by_quote = {}
   231	    alias = {}
   232	    for e in data.get('evidence', []):
   233	        quote = normalise(e['quote'])
   234	        if len(quote) < 8 or quote not in body:
   235	            dropped.append((e['id'], 'quote not in item'))
   236	            continue
   237	        links = [l for l in e['links'] if l in shown_ids or l in candidate_ids]
   238	        if not links:
   239	            dropped.append((e['id'], f'links to nothing shown: {e["links"]}'))
   240	            continue
   241	        if quote in by_quote:            # the same sentence read out twice is one piece with both links
   242	            first = by_quote[quote]
   243	            first['links'].extend(l for l in links if l not in first['links'])
   244	            alias[e['id']] = first['id']
   245	            dropped.append((e['id'], f'same quote as {first["id"]}; merged'))
   246	            continue
   247	        e = dict(e, links=links)
   248	        by_quote[quote] = e
   249	        evidence.append(e)
   250	        kept_ids.add(e['id'])
   251	    final_candidates = []
   252	    for c in candidates:
   253	        ids = list(dict.fromkeys(alias.get(i, i) for i in c['evidence_ids'] if alias.get(i, i) in kept_ids))
   254	        if not ids and item.get('publisher_type') != SELF_PUBLISHER_TYPE:
   255	            dropped.append((c['id'], 'candidate without surviving evidence'))
   256	            continue
   257	        final_candidates.append(dict(c, evidence_ids=ids))
   258	    for e in evidence:
   259	        e['links'] = [l for l in e['links'] if l in shown_ids or any(c['id'] == l for c in final_candidates)]
   260	    evidence = [e for e in evidence if e['links']]
   261	    return evidence, final_candidates, dropped

