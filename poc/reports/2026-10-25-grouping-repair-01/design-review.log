   139	def load(path):
   140	    with open(path, encoding='utf-8') as handle:
   141	        return Universe(json.load(handle))
     1	"""The views database (docs/prd/06-views.md): append-only tables for views, rungs, judgements, evidence, links,
     2	replacements, dependencies, successions, match records, processing steps and the review pool; a trigram
     3	full-text index over the views for the matching lists; the queries the other modules read.
     4	
     5	Every table refuses UPDATE and DELETE (triggers). Progress and counts are rows, never updates. There is no item
     6	text here: evidence holds the quoted sentence and the one-line restatement only.
     7	"""
     8	import json
     9	import os
    10	import sqlite3
    11	
    12	TABLES = {
    13	    'views': 'view_id text primary key, object_id text, object_kind text, kind text, looks_at text, question text, due_day text, year text, created_seq integer, created_from_input text, created_at text',
    14	    'rungs': 'view_id text, position integer, label text, condition text, lo real, hi real',
    15	    'view_keys': 'view_id text primary key, measure text, scope text, scope_key text, period_start text, period_end text, basis text, unit text, event_type text, seq integer, scope_source text',
    16	    'view_switches': 'id integer primary key autoincrement, view_id text, open integer, reason text, by_whom text, after_seq integer',
    17	    'judgements': 'judgement_id integer primary key autoincrement, view_id text, seq integer, input_id text, rung integer, reasons text, cited_evidence_json text, cited_views_json text, pushes_json text, changed integer, why_changed text, config_checksum text, call_id integer, request_sha256 text, publication_day text',
    18	    'evidence': 'evidence_id text primary key, quote text, one_line text, speaker text, original_who text, original_day text, tier text, event_time text, created_seq integer, created_from_input text',
    19	    'evidence_sources': 'id integer primary key autoincrement, evidence_id text, input_id text, category text, publication_day text, location text, seq integer',
    20	    'evidence_links': 'id integer primary key autoincrement, evidence_id text, view_id text, seq integer',
    21	    'replacements': 'id integer primary key autoincrement, old_evidence_id text, new_evidence_id text, said_day text, seq integer',
    22	    'dependencies': 'dependency_id integer primary key autoincrement, view_id text, depends_on text, wait_chain_view_id text, wait_year text, direction text, seq integer',
    23	    'dependency_resolutions': 'id integer primary key autoincrement, dependency_id integer, resolved_to text, reason text, seq integer',
    24	    'successions': 'id integer primary key autoincrement, view_id text, succeeds text, seq integer',
    25	    'handovers': 'id integer primary key autoincrement, input_id text, seq integer, handover_json text',
    26	    'match_records': 'id integer primary key autoincrement, seq integer, input_id text, call_no integer, shown_json text, request_sha256 text, call_id integer, decisions_json text, checks_json text, written_json text',
    27	    'processing_steps': 'id integer primary key autoincrement, input_id text, sequence_no integer, step text, result text, reason text, publication_day text, at text',
    28	    'review_pool_entries': 'id integer primary key autoincrement, kind text, key text, example_json text, seq integer',
    29	    'late_statements': 'id integer primary key autoincrement, input_id text, evidence_quote text, reason text, seq integer',
    30	    'days_completed': 'id integer primary key autoincrement, day text, seq integer, at text',
    31	}
    32	
    33	INDEXES = [
    34	    'create index if not exists views_object on views(object_id)',
    35	    'create index if not exists judgements_view on judgements(view_id, judgement_id)',
    36	    # 06-views step 7: a view is judged once per round (one item = one sequence number)
    37	    'create unique index if not exists judgements_once_per_round on judgements(view_id, seq)',
    38	    'create index if not exists links_view on evidence_links(view_id)',
    39	    'create index if not exists links_evidence on evidence_links(evidence_id)',
    40	    'create index if not exists sources_evidence on evidence_sources(evidence_id)',
    41	    'create index if not exists steps_input on processing_steps(input_id, id)',
    42	    'create index if not exists switches_view on view_switches(view_id, id)',
    43	    'create index if not exists deps_view on dependencies(view_id)',
    44	]
