   104	def run(conn, archive, cfg, universe, item, seq, *, resume_from=None, transport=None, log=print):
   105	    result = RoundResult(item['input_id'])
   106	    if resume_from in ('judged', 'handed_over'):       # written already; judging is the day's step
   107	        dispatch.mark(conn, item, seq, 'handed_over', 'ok', 'resumed')
   108	        conn.commit()
   109	        return result
   110	    objects = [o['value'] for o in item.get('object_identifiers') or [] if universe.has(o['value'])]
   111	    shown = store.views_for_prompt(conn, objects)
   112	    # extraction (or its stored handover on resume)
   113	    handover = None
   114	    if resume_from and resume_from != 'extracted':
   115	        row = conn.execute('select handover_json from handovers where input_id=? order by id desc limit 1', (item['input_id'],)).fetchone()
   116	        if row:
   117	            saved = json.loads(row['handover_json'])
   118	            handover = extraction.Handover(saved['evidence'], saved['candidates'], saved['dropped'], 0, '', True, 0.0)
   119	    if handover is None:
   120	        try:
   121	            handover = extraction.extract(archive, cfg, item, item['text'], shown, universe, transport=transport)
   122	        except Exception as error:
   123	            return _fail(conn, item, seq, result, 'extracted', 'extraction_failed', 'extraction: ' + repr(error), type(error).__name__)
   124	        result.cost += handover.cost_usd
   125	        result.cached_calls += int(handover.cached)
   126	        store.insert(conn, 'handovers', input_id=item['input_id'], seq=seq,
   127	                     handover_json=json.dumps({'evidence': handover.evidence, 'candidates': handover.candidates, 'dropped': handover.dropped}, ensure_ascii=False))
   128	        dispatch.mark(conn, item, seq, 'extracted', 'ok', f'{len(handover.evidence)} evidence, {len(handover.candidates)} candidates, {len(handover.dropped)} dropped')
   129	        conn.commit()
   130	    pool_outside_watch(conn, item, handover, seq)
   131	    conn.commit()
   132	    result.evidence, result.candidates, result.dropped = len(handover.evidence), len(handover.candidates), len(handover.dropped)
   133	    if not handover.evidence and not handover.candidates:
   134	        dispatch.mark(conn, item, seq, 'handed_over', 'ok', 'nothing to match')
   135	        conn.commit()
   136	        return result
   137	    # first matching call: the candidates and the evidence linked straight to existing views
   138	    lists = matching.build_lists(conn, handover, shown, cfg.search_top_n)
   139	    checked = _match(conn, archive, cfg, universe, item, seq, result, handover.candidates, handover.evidence, lists, shown, transport=transport)
   140	    if checked is None:
   141	        return result
   142	    # second call: evidence linked to candidates that attached to an existing view, compared under that view
   143	    second_pass = {}
   144	    pending = []
   145	    for e in handover.evidence:
   146	        for link in e['links']:
   147	            outcome = checked.outcomes.get(link)
   148	            if outcome and outcome[0] == '归入已有的':
   149	                pending.append((e, outcome[1]))
   150	    if pending:
   151	        lists2 = matching.Lists({}, {(e['id'], view_id): matching.rank_evidence(conn, view_id, e['one_line'], cfg.search_top_n) for e, view_id in pending})
