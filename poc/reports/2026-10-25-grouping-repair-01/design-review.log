   158	def extract(archive, cfg, item, text, shown_views, universe, *, transport=None):
   159	    setting = cfg.extraction_setting(item['category'])
   160	    version = setting.prompt_version.rpartition('-')[2]
   161	    system, user = build_prompt(item, text, shown_views, universe, version)
   162	    answer = model.call(archive, cfg, setting, system, user, schema_for(version), 'extraction', 'extract', transport=transport)
   163	    evidence, candidates, dropped = sift(answer.data, item, text, {v['view_id'] for v in shown_views}, universe)
   164	    return Handover(evidence, candidates, dropped, answer.call_id, answer.request_sha256, answer.cached, answer.cost_usd)
