    19	EXTRACTION_WORKERS = 8
    20	
    21	
    22	def pre_extract(conn, archive, cfg, universe, items_and_routes, transport, log):
    23	    """Run the day's extractions concurrently (model calls that read only the item and the views open at the start
    24	    of the day) and store each handover; the rounds then run in sequence order and resume from 'matched'. A candidate
    25	    that an earlier item of the same day just opened is caught by matching (归入), so the end state is the one
    26	    sequential processing gives (D31: a parallel read that changed is judged again by the matcher)."""
    27	    # the views database connection stays in this thread: the shown views are read here, once per object set
    28	    snapshot = {}
    29	    shown_for = {}
    30	    for item, route in items_and_routes:
    31	        objects = [o['value'] for o in item.get('object_identifiers') or [] if universe.has(o['value'])]
    32	        key = tuple(sorted(objects))
    33	        if key not in snapshot:
    34	            snapshot[key] = store.views_for_prompt(conn, objects)
    35	        shown_for[item['input_id']] = snapshot[key]
    36	
    37	    def work(item, route):
    38	        return item, route, extraction.extract(archive, cfg, item, item['text'], shown_for[item['input_id']], universe, transport=transport)
    39	
    40	    results = {}
    41	    with concurrent.futures.ThreadPoolExecutor(max_workers=EXTRACTION_WORKERS) as pool_:
    42	        futures = [pool_.submit(work, item, route) for item, route in items_and_routes]
    43	        for future in concurrent.futures.as_completed(futures):
    44	            try:
    45	                item, route, handover = future.result()
    46	                results[item['input_id']] = handover
    47	            except Exception as error:
    48	                log('  ! pre-extraction failed:', repr(error)[:200])
    49	    for item, route in items_and_routes:
    50	        handover = results.get(item['input_id'])
    51	        if handover is None:
    52	            continue
    53	        store.insert(conn, 'handovers', input_id=item['input_id'], seq=route.sequence_no,
    54	                     handover_json=json.dumps({'evidence': handover.evidence, 'candidates': handover.candidates, 'dropped': handover.dropped}, ensure_ascii=False))
    55	        dispatch.mark(conn, item, route.sequence_no, 'extracted', 'ok', f'{len(handover.evidence)} evidence, {len(handover.candidates)} candidates, {len(handover.dropped)} dropped (parallel)')
    56	    conn.commit()
    57	    return results
    58	
    59	
    60	class LookAheadError(RuntimeError):
    61	    pass
    62	
    63	
    64	class BackdatingError(RuntimeError):
    65	    pass
    66	
    67	
    68	def calendar_days(from_day, until_day):
    69	    day = datetime.date.fromisoformat(from_day)
    70	    last = datetime.date.fromisoformat(until_day)
    71	    while day <= last:
    72	        yield day.isoformat()
    73	        day += datetime.timedelta(days=1)
