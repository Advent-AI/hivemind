    71	    def record(self, **fields):
    72	        """One row per distinct request; a second identical request recorded at the same moment (two threads, or a
    73	        failed answer repeated within the same second) keeps the first row's id instead of failing."""
    74	        columns = list(fields)
    75	        with self.lock:
    76	            cursor = self.conn.execute(f'insert or ignore into model_calls ({",".join(columns)}) values ({",".join("?" * len(columns))})',
    77	                                       [fields[c] for c in columns])
    78	            self.conn.commit()
    79	            if cursor.rowcount == 0:
