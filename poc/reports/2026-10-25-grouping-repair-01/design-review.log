    67	def judge_day(conn, archive, cfg, day, seq, *, transport=None, log=print):
    68	    """D63: one re-judging round per day over every open view whose reading changed that day, dependencies first,
    69	    recorded under the day's own processing record (input 'day:<date>'); a view already judged at this sequence
    70	    number (a resumed day) is not judged twice."""
    71	    marker = {'input_id': f'day:{day}', 'publication_day': day}
    72	    changed = changed_views_of_day(conn, day)
    73	    result = RoundResult(marker['input_id'])
    74	    if not changed:
    75	        return result
    76	    try:
    77	        judged = judging.round_of_judgements(archive, cfg, conn, sorted(changed), seq, marker, transport=transport)
    78	        result.judged = len(judged)
    79	        result.changed = sum(1 for j in judged if j['changed'])
    80	        result.cost += sum(j['cost'] for j in judged)
    81	        result.cached_calls += sum(1 for j in judged if j['cached'])
    82	        dispatch.mark(conn, marker, seq, 'judged', 'ok', f'{len(changed)} views changed, {len(judged)} judged, {result.changed} changed conclusions')
    83	        conn.commit()
    84	    except judging.JudgementRefused as error:
    85	        return _fail(conn, marker, seq, result, 'judged', 'judgement_refused_twice', 'judgement refused twice: ' + str(error), 'day')
    86	    except Exception as error:
    87	        return _fail(conn, marker, seq, result, 'judged', 'judging_failed', 'judging: ' + repr(error), type(error).__name__)
    88	    return result
