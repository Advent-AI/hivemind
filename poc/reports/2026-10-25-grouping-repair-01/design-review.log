    47	def open_db(path):
    48	    os.makedirs(os.path.dirname(os.path.abspath(path)), exist_ok=True)
    49	    conn = sqlite3.connect(path)
    50	    conn.row_factory = sqlite3.Row
    51	    for name, columns in TABLES.items():
    52	        conn.execute(f'create table if not exists {name} ({columns})')
    53	        conn.execute(f"create trigger if not exists {name}_no_update before update on {name} begin select raise(abort, 'append-only'); end")
    54	        conn.execute(f"create trigger if not exists {name}_no_delete before delete on {name} begin select raise(abort, 'append-only'); end")
    55	    for statement in INDEXES:
    56	        conn.execute(statement)
    57	    conn.execute("create virtual table if not exists views_fts using fts5(view_id unindexed, text, tokenize='trigram')")
    58	    conn.commit()
    59	    return conn
