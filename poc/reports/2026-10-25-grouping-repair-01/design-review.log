   131	OBJECT_LABELS = ['强烈看多', '看多', '中性', '看空', '强烈看空']
   132	
   133	
   134	def check_ladder(rungs, kind):
   135	    """None when the ladder is well formed, else the problem. An object ladder written from 强烈看空 up to 强烈看多
   136	    (the model often orders a revenue ladder by rising value) is the same ladder; normalise_ladder turns it round."""
   137	    if len(rungs) not in (2, 5):
   138	        return f'ladder has {len(rungs)} rungs, needs 5 (or 2 for yes/no)'
   139	    if any(not r['label'].strip() or not r['condition'].strip() for r in rungs):
   140	        return 'a rung has an empty label or condition'
   141	    if kind == '对象观点' and len(rungs) == 5:
   142	        labels = [r['label'].strip() for r in rungs]
   143	        if labels != OBJECT_LABELS and labels != OBJECT_LABELS[::-1]:
   144	            return f'object view rungs must be {OBJECT_LABELS}, got {labels}'
   145	    return None
   146	
   147	
   148	def normalise_ladder(rungs, kind):
   149	    """Position 1 is 强烈看多 (06-views): a reversed object ladder is turned round, label and condition together."""
   150	    if kind == '对象观点' and len(rungs) == 5 and [r['label'].strip() for r in rungs] == OBJECT_LABELS[::-1]:
   151	        return list(reversed(rungs))
   152	    return rungs
