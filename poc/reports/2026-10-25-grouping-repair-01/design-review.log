    58	        if dep['wait_chain_view_id'] in chain:
    59	            already = conn.execute('select 1 from dependency_resolutions where dependency_id=?', (dep['dependency_id'],)).fetchone()
    60	            if not already and not store.would_cycle(conn, dep['view_id'], new_view_id):
    61	                store.insert(conn, 'dependency_resolutions', dependency_id=dep['dependency_id'], resolved_to=new_view_id, reason='created', seq=seq)
