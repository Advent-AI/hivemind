   128	        same_key = key_matches(conn, c)
   129	        if same_key:                      # a keyed candidate is compared with the views that share its key, a narrow question
   130	            candidate_lists[c['id']] = same_key[:top_n]
   131	            continue
   132	        hits = store.search_views(conn, f'{c["object"]} {c["looks_at"]} {c["question"]}', top_n)
   133	        for v in shown_views:
   134	            if v['view_id'] not in hits and v['object_id'] == c['object']:
   135	                hits.append(v['view_id'])
