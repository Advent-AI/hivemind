    84	        start = f'{y - 1}-{month + 1:02d}-01'
    85	        import calendar
    86	        return start, f'{y}-{month:02d}-{calendar.monthrange(y, month)[1]:02d}'
    87	
    88	    def watch_allows(self, object_id, measure, scope='', event_type='n/a'):
    89	        """Whether a candidate view with this key opens: its measure is on the object's list, and when the entry names a
    90	        scope or an event type they match after normalisation. `other` never opens. No list → nothing opens for that object."""
    91	        if measure == 'other':
    92	            return False
    93	        for entry in self.watch_list(object_id):
    94	            if entry.get('measure') != measure:
    95	                continue
    96	            if entry.get('scope') and not scope_hits(entry, scope):
    97	                continue
    98	            if entry.get('event_type') and entry['event_type'] != event_type:
    99	                continue
   100	            return True
   101	        return False
   102	
   103	    def fiscal_note(self, object_id, publication_day):
   104	        """One line telling the model how this company's fiscal years map onto the calendar, so a number's year and
   105	        due day are written right (NVDA's FY2027 ends in January 2027, not 2028)."""
   106	        company = self.companies.get(object_id)
   107	        if not company:
   108	            return ''
   109	        month = int(company.get('fiscal_year_end_month') or 12)
   110	        year, pub_month = int(publication_day[:4]), int(publication_day[5:7])
   111	        if month == 12:
   112	            return f'{object_id} 的财年和自然年一样，12 月结束：今年是 FY{year}，明年是 FY{year + 1}；全年数在次年 1 到 3 月的年报里公布。'
   113	        # the fiscal year is named by the calendar year in which it ends
   114	        current = year if pub_month <= month else year + 1
   115	        start_month = month % 12 + 1
   116	        return (f'{object_id} 的财年在 {month} 月结束，财年按结束的那一年命名：FY{current} 从 {current - 1 if start_month > month else current}-{start_month:02d} 到 {current}-{month:02d}，'
   117	                f'发布日 {publication_day} 落在 FY{current}，所以今年是 FY{current}，明年是 FY{current + 1}；FY{current} 的全年数在 {current}-{month + 1 if month < 12 else 1:02d} 前后的年报里公布，到期日按那天写。')
   118	
   119	
   120	def scope_hits(entry, scope):
   121	    """A watch entry's scope matches the model's scope when the names are equal after normalisation or one of the entry's
   122	    aliases occurs inside the model's scope (keyed-views-plan.md 2.3/2.6: the model writes, code binds by alias; T2b
   123	    refused 'top 5 cloud providers and hyperscalers CapEx' against 'five hyperscalers' on spelling alone)."""
   124	    mine = scope_key(scope)
   125	    if not mine:
   126	        return False
   127	    if scope_key(entry['scope']) == mine:
   128	        return True
   129	    return any(scope_key(alias) and scope_key(alias) in mine for alias in entry.get('aliases', []))
   130	
   131	
   132	def scope_key(scope):
   133	    """A scope name as compared: case, spacing, dashes and the words revenue/segment do not distinguish two scopes."""
   134	    s = re.sub(r'[\u2013\u2014]', '-', (scope or '')).replace('＋', '+').replace('&amp;', '&')
   135	    s = re.sub(r'\b(revenue|segment|business|division)\b', '', s, flags=re.I)
   136	    return re.sub(r'\s+', ' ', s).strip().casefold()
   137	
