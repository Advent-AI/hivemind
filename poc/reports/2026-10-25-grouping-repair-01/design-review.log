    99	def ensure_key_columns(conn):
   100	    """A keyed ledger written before `scope_source` gains the column (append-only forbids updates, not new columns); its
   101	    earlier keys read as model-owned scopes unless the scope is empty."""
   102	    columns = [r[1] for r in conn.execute('pragma table_info(view_keys)')]
   103	    if columns and 'scope_source' not in columns:
   104	        conn.execute('alter table view_keys add column scope_source text')
