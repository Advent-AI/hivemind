    30	def test_names_become_ids_and_declarations():
    31	    projected, counts = names.project(stored_answer(), OFFERED)
    32	    refs = {c['id']: c['thread_ids'] for c in projected['candidates']}
    33	    assert refs == {'v1': ['g1'], 'c1': ['t1'], 'c2': ['g1', 't2']}
    34	    assert [(t['id'], t['name']) for t in projected['threads']] == [('t1', 'Windows PC SoC rollout'), ('t2', 'OpenAI–NVIDIA AI infrastructure deployment')]
    35	    assert counts == {'existing_refs': 2, 'new_subjects': 2, 'redeclared_existing': 0}
    36	    assert 'subjects' not in json.dumps(projected)
