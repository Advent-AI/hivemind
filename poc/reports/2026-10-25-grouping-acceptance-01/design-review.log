    23	    schema = base.matching_schema(False)
    24	    schema['required'].append('subject_groups')
    25	    groups = {'type': 'array', 'items': study.obj({
    26	        'local_ids': {'type': 'array', 'items': {'type': 'string', 'enum': local_ids} if local_ids else study.STRING,
    27	                      'minItems': 1},
    28	        'destination': {'type': 'string', 'enum': ['new', *destinations]},
    29	        'reason': study.STRING})}
    30	    if not local_ids:
    31	        groups['maxItems'] = 0
    32	    schema['properties']['subject_groups'] = groups
    33	    return schema
