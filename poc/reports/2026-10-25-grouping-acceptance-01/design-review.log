    35	def extraction_schema(offered):
    36	    """The D147 candidate contract with `subjects` in place of `thread_ids`, and no separate definitions list."""
    37	    schema = retained.extraction_schema(offered)
    38	    candidate = schema['properties']['candidates']['items']
