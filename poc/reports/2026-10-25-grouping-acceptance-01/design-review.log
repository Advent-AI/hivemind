    55	    flattened = [ident for group in groups for ident in group['local_ids']]
    56	    if sorted(flattened) != sorted(ids):
    57	        raise ValueError('Subject groups must cover every local ID exactly once')
    58	    resolved = {}
    59	    for group in groups:
