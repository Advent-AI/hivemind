    25	    by_id['c2']['subjects'] = [{'existing': 'Vera Rubin platform rollout', 'new_name': '', 'new_scope': ''},
    26	                               {'existing': 'none', 'new_name': 'OpenAI–NVIDIA AI infrastructure deployment', 'new_scope': 'The planned deployment of NVIDIA systems for OpenAI.'}]
    27	    return raw
