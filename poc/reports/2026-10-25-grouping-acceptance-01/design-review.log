    36	def identity_payload(payload, subjects, candidates):
    37	    """Separate subject identity from already assigned thesis membership in the matching request."""
    38	    payload = dict(payload)
    39	    payload['candidates'] = [{key: value for key, value in candidate.items() if key != 'thread_ids'}
