    48	def resolve_groups(answer, subjects, candidates):
    49	    """Every local description occurs once; destinations are new or actually offered stored subjects."""
    50	    errors = study.model.check_schema(answer, matching_schema(subjects, candidates))
    51	    if errors:
    52	        raise ValueError('Subject identity shape: ' + '; '.join(errors))
    53	    ids = [subject['id'] for subject in subjects]
