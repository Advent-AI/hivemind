    16	def stored_answer():
    17	    """A real D147 answer (three candidates: v1 Rubin shipments, c1 PC SoC, c2 OpenAI deployment) rewritten in the new shape."""
    18	    raw = copy.deepcopy(json.loads(SOURCE.read_text())['answer'])
    19	    raw.pop('threads')
