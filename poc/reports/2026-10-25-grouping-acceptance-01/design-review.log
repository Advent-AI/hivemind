    41	    stored = {value['thread_id']: value for hits in candidates.values() for value in hits}
    42	    payload['subject_identity'] = {'local_descriptions': subjects,
    43	        'stored_subjects': list(stored.values()),
    44	        'eligible_stored_ids': {key: [value['thread_id'] for value in hits] for key, hits in candidates.items()}}
    45	    return payload
