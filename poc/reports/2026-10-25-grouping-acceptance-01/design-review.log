    50	def project(raw, offered):
    51	    """Names → IDs: a shown name to its stored ID, each distinct new name to a local t ID with a declaration; a new name
    52	    that equals a shown one resolves to the stored subject and is counted. Returns the D147-shaped answer and the counts."""
    53	    errors = study.model.check_schema(raw, extraction_schema(offered))
    54	    if errors:
    55	        raise ValueError('Subject names shape: ' + '; '.join(errors))
    56	    by_name = {normalize(row['name']): row['thread_id'] for row in offered}
    57	    if len(by_name) != len(offered):
    58	        raise ValueError('Shown subject names collide after normalisation')
    59	    projected = copy.deepcopy(raw)
    60	    new_ids, declarations, counts = {}, [], {'existing_refs': 0, 'new_subjects': 0, 'redeclared_existing': 0}
    61	    for candidate in projected['candidates']:
    62	        refs = []
    63	        for subject in candidate.pop('subjects'):
    64	            if subject['existing'] != 'none':
    65	                if subject['new_name'].strip() or subject['new_scope'].strip():
    66	                    raise ValueError('An existing subject carries no new name or scope')
    67	                refs.append(by_name[normalize(subject['existing'])])
    68	                counts['existing_refs'] += 1
    69	                continue
    70	            name, scope = subject['new_name'].strip(), subject['new_scope'].strip()
    71	            if not name or not scope:
    72	                raise ValueError('A new subject needs a name and a scope')
    73	            key = normalize(name)
