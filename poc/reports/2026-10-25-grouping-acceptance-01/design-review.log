{"item": {"input_id": "gnews:9b084fc0f1583da0df01c45c", "publication_day": "2026-08-12", "category": "T7"}, "candidates": [], "candidate_lists": {}, "shown_views": [{"view_id": "v1", "object_id": "NVDA", "kind": "company", "looks_at": "Vera Rubin platform rollout", "question": "Will NVIDIA commence Vera Rubin production shipments by December 31, 2026?", "due_day": "2026-12-31", "year": "2026", "rungs": [{"position": 1, "label": "yes", "condition": "NVIDIA commences Vera Rubin production shipments by 2026-12-31."}, {"position": 2, "label": "no", "condition": "NVIDIA has not commenced Vera Rubin production shipments by 2026-12-31."}]}, {"view_id": "v2", "object_id": "NVDA", "kind": "company", "looks_at": "SK Telecom AI factory rollout", "question": "Will the first SK Telecom AI factory described in the SK Group–NVIDIA partnership come online by December 31, 2027?", "due_day": "2027-12-31", "year": "2027", "rungs": [{"position": 1, "label": "yes", "condition": "The first AI factory comes online on or before 2027-12-31."}, {"position": 2, "label": "no", "condition": "The first AI factory has not come online by 2027-12-31."}]}], "evidence": [{"id": "e1", "quote": "Nvidia has formally launched the Vera Rubin platform", "one_line": "NVIDIA formally launched the Vera Rubin platform.", "speaker": "Network World", "original_who": "Network World staff", "original_day": "2026-06-22", "tier": "fact", "event_time": "2026-06-22", "links": ["v1"]}, {"id": "e3", "quote": "Nvidia CEO Jensen Huang shared previously unreleased specifications for its Rubin graphics processing unit (GPU), due in 2026", "one_line": "The article reports that NVIDIA's Rubin GPU was due in 2026.", "speaker": "Network World", "original_who": "Network World staff", "original_day": "2025-03-18", "tier": "fact", "event_time": "2026", "links": ["v1"]}], "evidence_pairs": [{"evidence_id": "e1", "view_id": "v1", "existing_evidence": [{"evidence_id": "e2", "quote": "This cloud will use the NVIDIA ® DSX™ platform and deploy NVIDIA Vera Rubin accelerated computing powered by SK hynix HBM4, with the first AI factory planned to come online in 2027.", "one_line": "The announcement says the first AI factory is planned to come online in 2027 and will deploy Vera Rubin.", "speaker": "NVIDIA newsroom press release", "original_who": "SK Group and NVIDIA", "original_day": "2026-07-24", "tier": "party_statement", "event_time": "2027", "created_seq": 2, "created_from_input": "nvidianews:sk-group-and-nvidia-expand-strategic-partnership-across-ai-factories-and-next-generation-memory", "sources": [{"input_id": "nvidianews:sk-group-and-nvidia-expand-strategic-partnership-across-ai-factories-and-next-generation-memory", "category": "T6", "publication_day": "2026-07-24", "location": ""}]}, {"evidence_id": "e1", "quote": "We shipped our first Vera Rubin samples to customers earlier this week, and we remain on track to commence production shipments in the second half of the year.", "one_line": "NVIDIA says Vera Rubin production shipments are on track to begin in H2 2026.", "speaker": "Colette Kress, NVIDIA CFO", "original_who": "Colette Kress", "original_day": "2026-02-25", "tier": "party_statement", "event_time": "Production shipments expected in H2 2026", "created_seq": 1, "created_from_input": "truenorth:transcript:NVDA:2026-02-25", "sources": [{"input_id": "truenorth:transcript:NVDA:2026-02-25", "category": "T4", "publication_day": "2026-02-25", "location": ""}]}]}, {"evidence_id": "e3", "view_id": "v1", "existing_evidence": [{"evidence_id": "e1", "quote": "We shipped our first Vera Rubin samples to customers earlier this week, and we remain on track to commence production shipments in the second half of the year.", "one_line": "NVIDIA says Vera Rubin production shipments are on track to begin in H2 2026.", "speaker": "Colette Kress, NVIDIA CFO", "original_who": "Colette Kress", "original_day": "2026-02-25", "tier": "party_statement", "event_time": "Production shipments expected in H2 2026", "created_seq": 1, "created_from_input": "truenorth:transcript:NVDA:2026-02-25", "sources": [{"input_id": "truenorth:transcript:NVDA:2026-02-25", "category": "T4", "publication_day": "2026-02-25", "location": ""}]}, {"evidence_id": "e2", "quote": "This cloud will use the NVIDIA ® DSX™ platform and deploy NVIDIA Vera Rubin accelerated computing powered by SK hynix HBM4, with the first AI factory planned to come online in 2027.", "one_line": "The announcement says the first AI factory is planned to come online in 2027 and will deploy Vera Rubin.", "speaker": "NVIDIA newsroom press release", "original_who": "SK Group and NVIDIA", "original_day": "2026-07-24", "tier": "party_statement", "event_time": "2027", "created_seq": 2, "created_from_input": "nvidianews:sk-group-and-nvidia-expand-strategic-partnership-across-ai-factories-and-next-generation-memory", "sources": [{"input_id": "nvidianews:sk-group-and-nvidia-expand-strategic-partnership-across-ai-factories-and-next-generation-memory", "category": "T6", "publication_day": "2026-07-24", "location": ""}]}]}]}
