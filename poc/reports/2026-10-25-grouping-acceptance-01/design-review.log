   135	    budget = json.loads((out / 'budget.json').read_text())
   136	    study.write_json(path, {'version': 'retained-membership-v1', 'dependencies': fingerprints(),
   137	        'reused_sources': sources, 'shared_attempts_before': len(budget['attempts']),
