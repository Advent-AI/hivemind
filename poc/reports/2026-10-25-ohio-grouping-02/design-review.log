   184	def sift(data, item, text, shown_ids, universe=None):
   185	    """05-extraction step 3, the code checks on one answer: ladders, the quarter and year rules, due days, quotes in
   186	    the text, links to shown views or kept candidates, one piece per sentence. Returns (evidence, candidates,
   187	    dropped); the preflight runs it over every stored answer."""
