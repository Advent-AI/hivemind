    54	def schema(offered):
    55	    result = extraction.keyed_schema()
    56	    result['required'].append('threads')
    57	    result['properties']['threads'] = {'type': 'array', 'items': copy.deepcopy(groups.THREAD_SCHEMA)}
    58	    candidate = result['properties']['candidates']['items']
    59	    candidate['required'].append('thread_ids')
    60	    reference_pattern = r'^(?:t[1-9][0-9]*' + ''.join('|' + re.escape(g['thread_id']) for g in offered) + ')$'
    61	    candidate['properties']['thread_ids'] = {'type': 'array', 'minItems': 1,
    62	                                             'items': {'type': 'string', 'pattern': reference_pattern}}
    63	    return result
