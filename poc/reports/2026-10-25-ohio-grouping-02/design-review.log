   105	def snapshot(conn, seq):
   106	    result = {table: [dict(r) for r in conn.execute(f'select * from {table} order by rowid')] for table in TABLES}
   107	    result['details'] = [groups.thread_detail(conn, r['thread_id'], seq) for r in result['threads']]
   108	    return result
