   230	def prepare(out):
   231	    if (out / 'manifest.json').exists() or any((out / label).exists() for label in LABELS):
   232	        raise ValueError('Use a new experiment directory')
   233	    if not (out / 'preflight.txt').is_file():
   234	        raise ValueError('Run and inspect preflight first')
   235	    with sqlite3.connect(f'file:{ITEMS_DB}?mode=ro', uri=True) as conn:
   236	        conn.row_factory = sqlite3.Row
   237	        items = [dict(conn.execute('select * from items where input_id=?', (ident,)).fetchone()) for ident in ITEM_IDS]
   238	    for item in items:
   239	        item['object_identifiers'] = json.loads(item['object_identifiers'])
   240	    seeds = [dict(g, seq=0, input_id='reference:' + g['input_id']) for g in read(PREFIX)['threads']]
   241	    write(out / 'items.json', items)
   242	    write(out / 'reference-groups.json', seeds)
   243	    write(out / 'config.json', read(ROOT / 'poc/config/poc-v16.json'))
   244	    write(out / 'universe.json', read(ROOT / 'poc/universe.json'))
   245	    paths = list((ROOT / 'src/hivemind').rglob('*.py')) + list((ROOT / 'src/hivemind/prompts').glob('*'))
   246	    paths += [Path(__file__), ROOT / 'poc/hierarchy_study/ingestion_threads.py', ROOT / 'poc/hierarchy_study/study.py',
   247	              ROOT / 'docs/research/2026-10-25-ohio-grouping-poc.md', PREFIX]
   248	    paths += [out / name for name in ('items.json', 'reference-groups.json', 'config.json', 'universe.json', 'preflight.txt')]
   249	    write(out / 'manifest.json', {'version': 'ohio-sequence-v1', 'labels': LABELS, 'max_requests': MAX_REQUESTS,
   250	          'max_usd': MAX_USD, 'max_seconds': MAX_SECONDS, 'dependencies': {str(p.resolve()): digest(p) for p in paths if p.is_file()}})
   251	    write(out / 'budget.json', {'attempts': [], 'reserved_or_spent': 0})
   252	
   253	
   254	def verify(out):
   255	    for path, sha in read(out / 'manifest.json')['dependencies'].items():
   256	        if digest(path) != sha:
   257	            raise ValueError(f'Frozen input/code changed: {path}')
   258	
   259	
   260	def run(out):
   261	    with (out / 'run.lock').open('a') as lock:
   262	        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
   263	        verify(out)
   264	        if read(out / 'budget.json')['attempts'] or any((out / label).exists() for label in LABELS):
   265	            raise ValueError('Measurement already started; no automatic resume')
   266	        items = read(out / 'items.json')
   267	        uni, cfg = universe.load(out / 'universe.json'), config.load(out / 'config.json')
   268	        deadline = time.monotonic() + MAX_SECONDS
   269	        statuses = {label: 'not_started' for label in LABELS}
   270	        write(out / 'status.json', statuses)
   271	        for label in LABELS:
   272	            verify(out)
   273	            folder = out / label
   274	            folder.mkdir()
   275	            conn = groups.open_db(folder / 'views.sqlite')
   276	            archive = model.Archive(str(folder / 'calls.sqlite'))
   277	            grouped = label.startswith('grouped')
   278	            if grouped:
   279	                for g in read(out / 'reference-groups.json'):
   280	                    conn.execute('insert into threads values (?,?,?,?,?)', tuple(g[k] for k in ('thread_id', 'name', 'scope', 'seq', 'input_id')))
   281	                conn.commit()
   282	            transport = BoundedTransport(out, label, deadline)
   283	            try:
   284	                first = None
   285	                for index, item in enumerate(items, 1):
   286	                    directory = folder / f'item{index}'
   287	                    directory.mkdir()
   288	                    result = process(conn, archive, cfg, uni, item, grouped, directory, transport)
   289	                    if result['route'] != 'written':
   290	                        raise Refused(f'Expected extract route, got {result["route"]}')
   291	                    if index == 1:
   292	                        first = result
   293	                historical = [groups.thread_detail(conn, g['thread_id'], first['seq']) for g in first['snapshot']['threads']]
   294	                if historical != first['snapshot']['details']:
   295	                    raise AssertionError('First article history changed')
   296	                if any(dispatch.route(conn, item, uni).kind != 'skipped' for item in items):
   297	                    raise AssertionError('Completed input not skipped on resend')
   298	                write(folder / 'checks.json', {'history_unchanged': True, 'resend_skipped': True, 'semantic_status': 'pending'})
   299	                statuses[label] = 'complete'
   300	            except (Refused, model.SchemaError) as error:
   301	                statuses[label] = 'refused'
   302	                write(folder / 'failed.json', {'kind': type(error).__name__, 'reason': str(error)[:1000]})
   303	            except Exception as error:
   304	                statuses[label] = 'failed'
   305	                write(folder / 'failed.json', {'kind': type(error).__name__, 'reason': str(error)[:1000]})
   306	                write(out / 'status.json', statuses)
   307	                raise
   308	            finally:
   309	                conn.rollback()
   310	                conn.close()
   311	                archive.conn.close()
   312	            verify(out)
   313	            write(out / 'status.json', statuses)
   314	        print(json.dumps(statuses), flush=True)
   315	
