   317	def main():
   318	    parser = argparse.ArgumentParser(description=__doc__)
   319	    parser.add_argument('command', choices=('prepare', 'run'))
   320	    parser.add_argument('--out', type=Path, default=DEFAULT_OUT)
   321	    args = parser.parse_args()
   322	    out = args.out.resolve()
   323	    (prepare if args.command == 'prepare' else run)(out)
   324	
   325	
   326	if __name__ == '__main__':
   327	    main()

