   179	class BoundedTransport:
   180	    """One request, durable budget reservation, exact request and raw response, no retries."""
   181	    def __init__(self, out, label, deadline, send=None):
   182	        self.out, self.label, self.deadline, self.send = out, label, deadline, send
   183	
   184	    def __call__(self, provider, request):
   185	        budget_path = self.out / 'budget.json'
   186	        budget = read(budget_path)
   187	        encoded = json.dumps(request, ensure_ascii=False).encode()
   188	        price_in, price_out = model.PRICES[request['model']]
   189	        reserve = (len(encoded) * price_in + request['max_completion_tokens'] * price_out) / 1e6
   190	        if time.monotonic() >= self.deadline or len(budget['attempts']) >= MAX_REQUESTS or budget['reserved_or_spent'] + reserve > MAX_USD:
   191	            raise RuntimeError('Registered time/call/cost limit reached; no request sent')
   192	        record = {'status': 'started', 'label': self.label, 'request': request, 'reserved_usd': reserve}
   193	        budget['attempts'].append({'label': self.label, 'status': 'started', 'reserved_usd': reserve})
   194	        budget['reserved_or_spent'] += reserve
   195	        write(budget_path, budget)
   196	        path = self.out / self.label / f'call-{len(budget["attempts"]):02d}.json'
   197	        write(path, record)
   198	        started = time.monotonic()
   199	        print(f'START {self.label} call={len(budget["attempts"])} reserve=${reserve:.4f}', flush=True)
   200	        try:
   201	            if self.send is not None:
   202	                response = self.send(provider, request)
   203	            else:
   204	                url, _ = model.ENDPOINTS[provider]
   205	                headers = {'Authorization': f'Bearer {model._key(provider)}', 'Content-Type': 'application/json'}
   206	                req = urllib.request.Request(url, data=encoded, headers=headers, method='POST')
   207	                with urllib.request.urlopen(req, timeout=min(180, max(1, self.deadline - time.monotonic()))) as handle:
   208	                    response = json.loads(handle.read().decode())
   209	            record.update(status='complete', response=response, seconds=time.monotonic() - started)
   210	            usage = response.get('usage', {})
   211	            cost = (usage.get('prompt_tokens', 0) * price_in + usage.get('completion_tokens', 0) * price_out) / 1e6
   212	            if 'prompt_tokens' not in usage or 'completion_tokens' not in usage:
   213	                cost = reserve
   214	            budget['reserved_or_spent'] += cost - reserve
   215	            budget['attempts'][-1].update(status='complete', estimated_usd=cost)
   216	            record['estimated_usd'] = cost
   217	            write(path, record)
   218	            write(budget_path, budget)
   219	            print(f'DONE {self.label} usd=${cost:.4f} seconds={record["seconds"]:.1f}', flush=True)
   220	            return response
   221	        except Exception as error:
   222	            # Error type only: avoid logging headers or credential-bearing exception objects.
   223	            record.update(status='failed', error_type=type(error).__name__, seconds=time.monotonic() - started)
   224	            budget['attempts'][-1]['status'] = 'failed'
   225	            write(path, record)
   226	            write(budget_path, budget)
   227	            raise RuntimeError(f'Network attempt failed ({type(error).__name__}); no resend') from None
