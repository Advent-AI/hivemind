   156	QUARTERLY = re.compile(r'(\bQ[1-4]\b|第[一二三四1-4]季|季度|\bquarter(?!ly report)|fiscal Q[1-4]|\bH[12]\b 收入|上半年收入|下半年收入)', re.I)
