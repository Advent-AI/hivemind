    85	def context(conn, item, uni, grouped):
    86	    shown = store.views_for_prompt(conn, [o['value'] for o in item['object_identifiers'] if uni.has(o['value'])])
    87	    offered = []
    88	    if grouped:
    89	        for row in conn.execute('select * from threads order by rowid'):
    90	            group = dict(row)
    91	            group['members'] = [r[0] for r in conn.execute(
    92	                'select view_id from thread_members where thread_id=? order by rowid', (row['thread_id'],))]
    93	            offered.append(group)
    94	        member_ids = {v for g in offered for v in g['members']}
    95	        shown_ids = {v['view_id'] for v in shown}
    96	        for vid in sorted(member_ids - shown_ids):
    97	            shown.append(dict(store.view(conn, vid), depends_on=[]))
    98	    system, user = extraction.build_prompt(item, item['text'], shown, uni, 'v5')
    99	    if grouped:
   100	        system += '\n\n' + GROUP_PROMPT
   101	        user += '\n\n【可用研究主线】\n' + json.dumps(offered, ensure_ascii=False)
   102	    return system, user, shown, offered
