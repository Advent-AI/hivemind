   168	def check_bounds(rungs):
   169	    """None when the rungs' numeric bounds form one unbroken partition (or none carries bounds), else the problem."""
   170	    bounded = [r for r in rungs if r.get('lo') is not None or r.get('hi') is not None]
   171	    if not bounded:
   172	        return None
   173	    if len(bounded) != len(rungs):
   174	        return 'some rungs carry bounds and some do not'
   175	    ordered = sorted(rungs, key=lambda r: -1e300 if r.get('lo') is None else float(r['lo']))
   176	    for a, b in zip(ordered, ordered[1:]):
   177	        if a.get('hi') is None or b.get('lo') is None or float(a['hi']) != float(b['lo']):
   178	            return 'rung bounds overlap or leave a gap'
   179	    if ordered[-1].get('hi') is not None:
   180	        return 'the top rung must be open above'
   181	    return None
