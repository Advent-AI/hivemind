   111	def process(conn, archive, cfg, uni, item, grouped, directory, transport):
   112	    """One dispatch, extract, match and atomic write; no hidden repair call."""
   113	    route = dispatch.route(conn, item, uni)
   114	    if route.kind != 'extract':
   115	        return {'route': route.kind, 'input_id': item['input_id']}
   116	    if route.resume_from:
   117	        raise Refused('This measurement does not resume unfinished sequences')
   118	    seq = route.sequence_no
   119	    system, user, shown, offered = context(conn, item, uni, grouped)
   120	    write(directory / 'context.json', {'shown': shown, 'offered': offered, 'before': snapshot(conn, seq - 1)})
   121	    answer = model.call(archive, cfg, cfg.extraction_setting(item['category']), system, user,
   122	                        schema(offered) if grouped else extraction.keyed_schema(), 'extraction', 'extract', transport=transport)
   123	    if answer.cached:
   124	        raise Refused('Fresh sample unexpectedly used a cached answer')
   125	    write(directory / 'extraction.json', answer.data)
   126	    if grouped:
   127	        validate_references(answer.data, offered)
   128	    evidence, candidates, dropped = extraction.sift(answer.data, item, item['text'], {v['view_id'] for v in shown}, uni)
   129	    handover = extraction.Handover(evidence, candidates, dropped, answer.call_id, answer.request_sha256, False, answer.cost_usd)
   130	    write(directory / 'handover.json', dataclasses.asdict(handover))
   131	
   132	    def match(name, handover, lists, shown, extra_views=()):
   133	        result = matching.decide(archive, cfg, conn, item, handover.candidates, handover.evidence, lists, shown,
   134	                                 extra_views=extra_views, transport=transport)
   135	        if result.cached:
   136	            raise Refused('Fresh matching sample unexpectedly used cache')
   137	        checked = matching.check(conn, uni, result.data, handover.candidates, handover.evidence, lists, shown)
   138	        write(directory / f'{name}.json', {'answer': result.data, 'outcomes': checked.outcomes,
   139	              'evidence': [[*key, *value] for key, value in checked.evidence.items()],
   140	              'refusals': checked.refusals, 'not_opened': checked.not_opened, 'notes': checked.notes})
   141	        if checked.refusals:
   142	            conn.rollback()
   143	            raise Refused('; '.join(checked.refusals))
   144	        return checked
   145	
   146	    checked = matching.Checked({}, {}, [], {})
   147	    second = {}
   148	    if evidence or candidates:
   149	        checked = match('matching', handover, matching.build_lists(conn, handover, shown, cfg.search_top_n), shown)
   150	        pending = [(e, checked.outcomes[link][1]) for e in evidence for link in e['links']
   151	                   if link in checked.outcomes and checked.outcomes[link][0] == matching.OUTCOMES[0]]
   152	        if pending:
   153	            mapped = {e['id']: dict(e, links=list(dict.fromkeys(v for x, v in pending if x['id'] == e['id']))) for e, _ in pending}
   154	            second_handover = dataclasses.replace(handover, candidates=[], evidence=list(mapped.values()))
   155	            lists = matching.Lists({}, {(e['id'], vid): matching.rank_evidence(conn, vid, e['one_line'], cfg.search_top_n) for e, vid in pending})
   156	            second = match('matching-evidence', second_handover, lists, [], sorted({vid for _, vid in pending})).evidence
   157	    # The group write is in the SAME outer transaction as the current product writer.
   158	    try:
   159	        with conn:
   160	            written = writing.write(conn, uni, seq, item, handover, checked, second)
   161	            bindings, affected = [], []
   162	            if grouped:
   163	                used = {ref for c in candidates for ref in c['thread_ids']}
   164	                definitions = [g for g in answer.data['threads'] if g['id'] in used]
   165	                bindings, affected = groups.write_threads(conn, definitions, {ref: ref for ref in used}, handover, checked, written, seq, item)
   166	            store.insert(conn, 'handovers', input_id=item['input_id'], seq=seq, handover_json=json.dumps(dataclasses.asdict(handover), ensure_ascii=False))
   167	            dispatch.mark(conn, item, seq, 'written', 'ok', json.dumps({'new': written.new_views, 'changed': sorted(written.changed_views)}))
   168	            dispatch.mark(conn, item, seq, 'handed_over', 'ok', '')
   169	    except Exception:
   170	        conn.rollback()
   171	        raise
   172	    result = {'route': 'written', 'input_id': item['input_id'], 'seq': seq, 'new_views': written.new_views,
   173	              'evidence_ids': written.evidence_ids, 'bindings': bindings, 'affected_threads': affected,
   174	              'notes': written.notes, 'snapshot': snapshot(conn, seq)}
   175	    write(directory / 'result.json', result)
   176	    return result
