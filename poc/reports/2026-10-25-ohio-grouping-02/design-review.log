   159	def extract(archive, cfg, item, text, shown_views, universe, *, transport=None):
   160	    setting = cfg.extraction_setting(item['category'])
   161	    version = setting.prompt_version.rpartition('-')[2]
   162	    system, user = build_prompt(item, text, shown_views, universe, version)
   163	    answer = model.call(archive, cfg, setting, system, user, schema_for(version), 'extraction', 'extract', transport=transport)
   164	    evidence, candidates, dropped = sift(answer.data, item, text, {v['view_id'] for v in shown_views}, universe)
   165	    return Handover(evidence, candidates, dropped, answer.call_id, answer.request_sha256, answer.cached, answer.cost_usd)
