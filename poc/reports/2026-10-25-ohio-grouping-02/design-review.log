   206	            dropped.append((c['id'], f'due_day not a date: {c["due_day"]!r}'))
   207	            continue
   208	        if c['due_day'] <= item['publication_day']:
   209	            dropped.append((c['id'], f'due_day {c["due_day"]} not after the item'))
   210	            continue
   211	        if c.get('measure'):          # keyed candidates keep their actual scope; reference lists do not gate admission (D155)
   212	            problem = check_bounds(c['rungs'])
   213	            if problem:
   214	                dropped.append((c['id'], f'candidate ladder bounds: {problem}'))
   215	                continue
   216	            if universe is not None:
   217	                object_id = universe.resolve(c['object']) or c['object']
   218	                scope, source = universe.scope_and_source(object_id, c['measure'], c.get('scope', ''), c.get('event_type', 'n/a'))
   219	                c = dict(c, object=object_id, scope=scope, scope_source=source, key_version=2)
   220	                if c['measure'] not in ('event', 'policy_event'):
   221	                    period = universe.fiscal_period(object_id, c.get('year', ''))                                                        # and the period of a yearly number
   222	                    if period:
   223	                        c = dict(c, period_start=period[0], period_end=period[1])
   224	            try:
   225	                start = datetime.date.fromisoformat(c['period_start'])
   226	                end = datetime.date.fromisoformat(c['period_end'])
   227	                if start > end:
