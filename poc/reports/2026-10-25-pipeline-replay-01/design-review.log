    85	def rungs_of(conn, view_id):
    86	    """The rungs with their bounds when the ledger has them (keyed views); a ledger written before keys has no lo/hi columns."""
    87	    rows = [dict(r) for r in conn.execute('select * from rungs where view_id=? order by position', (view_id,))]
    88	    has_bounds = any(r.get('lo') is not None or r.get('hi') is not None for r in rows) or view_key(conn, view_id) is not None
    89	    return [dict(position=r['position'], label=r['label'], condition=r['condition'],
    90	                 **({'lo': r.get('lo'), 'hi': r.get('hi')} if has_bounds else {})) for r in rows]
