   146	def exact_key_views(conn, candidate):
   147	    """All open exact identities, independent of a search limit; legacy keys are never automatic identities."""
   148	    from .identity import automatic_key
   149	    target = automatic_key(candidate)
   150	    if target is None:
   151	        return []
   152	    rows = conn.execute('''select k.*, v.object_id from view_keys k join views v on v.view_id=k.view_id
   153	                           where v.object_id=? and k.measure=?''', (candidate['object'], candidate['measure']))
   154	    return [r['view_id'] for r in rows if automatic_key(dict(r), r['object_id']) == target and is_open(conn, r['view_id'])]
