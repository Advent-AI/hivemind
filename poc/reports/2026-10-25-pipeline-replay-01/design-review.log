    37	NUMBER_WITH_UNIT = re.compile(r'(-?\d+(?:[.,]\d+)?)\s*(万亿|亿|百万|%)?')
    38	YEAR_LIKE = re.compile(r'(?:FY|财年)\s*\d{4}|\d{4}\s*(?:年|财年)|\d{4}-\d{2}-\d{2}')
    39	
    40	
    41	def first_value(condition):
    42	    """The first quantity in a rung condition, years removed, 万亿 brought to the same scale as 亿."""
    43	    for found in NUMBER_WITH_UNIT.finditer(YEAR_LIKE.sub(' ', condition or '')):
    44	        value = float(found.group(1).replace(',', ''))
    45	        return value * 1e4 if found.group(2) == '万亿' else value
    46	    return None
    47	
    48	
    49	def ladder_direction(rungs):
    50	    """+1 when the quantities in the rung conditions rise from the first rung to the last, -1 when they fall, None
    51	    when the conditions carry no comparable numbers (states of an event, or labels only)."""
    52	    numbers = [first_value(rung['condition']) for rung in rungs]
    53	    known = [n for n in numbers if n is not None]
    54	    if len(known) < 2 or known[0] == known[-1]:
    55	        return None
    56	    return 1 if known[0] < known[-1] else -1
    57	
    58	
    59	def same_orientation(previous, candidate):
    60	    """06-views: a successor's ladder keeps the predecessor's direction. Object views carry the fixed labels, so equal
    61	    labels settle it; a theme view's labels are results that change with the period, so the direction of the numbers
    62	    in the conditions is compared instead, and an undecidable pair is left to the model."""
    63	    if [r['label'].strip() for r in previous] == [r['label'].strip() for r in candidate]:
    64	        return True
    65	    before, after = ladder_direction(previous), ladder_direction(candidate)
    66	    return before is None or after is None or before == after
