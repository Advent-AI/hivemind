    46	                    decisions[d['id']] = d
    47	                    counts['candidate_decisions'] += 1
    48	                    counts['new_with_candidates'] += int(d['outcome'] == '新观点' and bool(listed['candidates'].get(d['id'])))
    49	                for d in answer['evidence']:
    50	                    counts['unrequested_evidence_decisions'] += int(d['id'] + '|' + d['view_id'] not in listed['evidence'])
    51	            for e in handover['evidence']:
    52	                direct = [v for v in e['links'] if v not in cids]
    53	                merged = [v for v in e['links'] if decisions.get(v, {}).get('outcome') == '归入已有的']
    54	                if direct and merged:
    55	                    mixed.append([h['seq'], e['id'], direct, merged])
    56	        ledgers.append({'ledger': path.name, 'counts': dict(counts), 'stale_exposure': stale,
    57	                        'unfinished_parallel': pending, 'split_evidence_comparisons': mixed})
    58	        conn.close()
    59	    conn = open_read(ROOT / 'poc/data/views-2026-10-25-v15-T4c.sqlite')
    60	    archive = open_read(ROOT / 'poc/data/keyed-2026-10-25/archive-T2.sqlite')
    61	    cases = []
    62	    # Same project does not mean same quantity. Source-audited development cases, not human gold.
    63	    expectations = {116: {'c1': 'v17', 'c3': 'new', 'c4': 'v18'},
    64	                    126: {'c1': 'v17', 'c2': 'v18'}, 147: {'c1': 'v17'}, 165: {'c1': 'v17'}}
    65	    for seq, expected in expectations.items():
    66	        rec = dict(conn.execute('select * from match_records where seq=? and call_no=1', (seq,)).fetchone())
    67	        h = dict(conn.execute('select * from handovers where seq=?', (seq,)).fetchone())
    68	        call = dict(archive.execute('select * from model_calls where request_sha256=?', (rec['request_sha256'],)).fetchone())
    69	        handover = json.loads(h['handover_json'])
    70	        shown = json.loads(rec['shown_json'])
    71	        answer = json.loads(rec['decisions_json'])
    72	        for cid, target in expected.items():
    73	            if target != 'new':
    74	                assert target in shown['candidates'][cid], (seq, cid, target)
    75	        cases.append({'seq': seq, 'input_id': h['input_id'], 'expected': expected,
    76	                      'listed': shown, 'answer': answer, 'handover': handover,
    77	                      'request': json.loads(call['request_json']), 'call_id': call['call_id'],
    78	                      'historical_cost_usd': call['cost_usd']})
    79	    control = next(x for x in ledgers if x['ledger'].endswith('T4c.sqlite'))
    80	    assert control['counts']['parallel_extractions'] == 255
    81	    assert len(control['stale_exposure']) == 195
    82	    assert sum(x['counts'].get('match_calls', 0) for x in ledgers) == 518
    83	    return {'ledgers': ledgers, 'identity_cases': cases,
    84	            'limits': 'Independent storage runs share input answers; exposures are not semantic errors. Case expectations are assistant source review.'}
    85	
    86	
    87	if __name__ == '__main__':
    88	    result = audit()
    89	    (OUT / 'census.json').write_text(json.dumps(result, ensure_ascii=False, indent=2))
    90	    print(json.dumps({'ledgers': [{**x['counts'], 'name': x['ledger'], 'stale_exposure': len(x['stale_exposure']),
    91	                                  'unfinished_parallel': len(x['unfinished_parallel']), 'mixed': len(x['split_evidence_comparisons'])} for x in result['ledgers']],
    92	                      'identity_cases': [{'seq': x['seq'], 'expected': x['expected'], 'listed': x['listed']['candidates']} for x in result['identity_cases']]}, ensure_ascii=False, indent=2))
