    13	@dataclasses.dataclass
    14	class RoundResult:
    15	    input_id: str
    16	    evidence: int = 0
    17	    candidates: int = 0
    18	    new_views: int = 0
    19	    judged: int = 0
    20	    changed: int = 0
    21	    cost: float = 0.0
    22	    cached_calls: int = 0
    23	    failed: str = ''
    24	    dropped: int = 0
