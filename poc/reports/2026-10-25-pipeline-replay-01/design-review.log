   214	def would_cycle(conn, view_id, depends_on):
   215	    """True when depends_on already depends, directly or through its dependencies, on view_id."""
   216	    seen, stack = set(), [depends_on]
   217	    while stack:
   218	        current = stack.pop()
   219	        if current == view_id:
   220	            return True
   221	        if current in seen or not current:
   222	            continue
   223	        seen.add(current)
   224	        for dep in dependencies_of(conn, current):
   225	            if dep['resolved_to']:
   226	                stack.append(dep['resolved_to'])
   227	    return False
