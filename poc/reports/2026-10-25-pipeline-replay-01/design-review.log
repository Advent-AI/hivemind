    27	def _fail(conn, item, seq, result, step, kind, detail, pool_key):
    28	    dispatch.mark(conn, item, seq, step, 'failed', detail[:300])
    29	    store.pool(conn, kind, pool_key, {'input_id': item['input_id'], 'error': detail[:300]}, seq)
    30	    result.failed = detail[:200]
    31	    conn.commit()
    32	    return result
