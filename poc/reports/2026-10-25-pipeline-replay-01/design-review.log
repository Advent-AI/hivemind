   251	def search_views(conn, text, top_n):
   252	    """Trigram full-text search over question + looks_at + object; the top N by rank."""
   253	    words = [w for w in text.replace('？', ' ').replace('，', ' ').split() if len(w) >= 2]
   254	    if not words:
   255	        return []
   256	    query = ' OR '.join('"' + w.replace('"', '') + '"' for w in words[:12])
   257	    try:
   258	        rows = conn.execute('select view_id from views_fts where views_fts match ? order by rank limit ?', (query, top_n)).fetchall()
   259	    except sqlite3.OperationalError:
   260	        return []
   261	    return [r['view_id'] for r in rows]
