    41	def first_value(condition):
    42	    """The first quantity in a rung condition, years removed, 万亿 brought to the same scale as 亿."""
    43	    for found in NUMBER_WITH_UNIT.finditer(YEAR_LIKE.sub(' ', condition or '')):
    44	        value = float(found.group(1).replace(',', ''))
    45	        return value * 1e4 if found.group(2) == '万亿' else value
    46	    return None
