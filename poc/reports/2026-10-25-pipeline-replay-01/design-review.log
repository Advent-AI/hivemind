   193	def dependencies_of(conn, view_id):
   194	    """Each dependency with its current target: the resolved view, or the waiting chain and year."""
   195	    out = []
   196	    for dep in conn.execute('select * from dependencies where view_id=? order by dependency_id', (view_id,)):
   197	        dep = dict(dep)
   198	        resolution = conn.execute('select resolved_to, reason from dependency_resolutions where dependency_id=? order by id desc limit 1', (dep['dependency_id'],)).fetchone()
   199	        if resolution:
   200	            dep['resolved_to'], dep['resolution'] = resolution['resolved_to'], resolution['reason']
   201	        else:
   202	            dep['resolved_to'], dep['resolution'] = dep['depends_on'], ('direct' if dep['depends_on'] else 'waiting')
   203	        out.append(dep)
   204	    return out
