   101	def ensure_key_columns(conn):
   102	    """A keyed ledger written before `scope_source` gains the column (append-only forbids updates, not new columns); its
   103	    earlier keys read as model-owned scopes unless the scope is empty."""
   104	    columns = [r[1] for r in conn.execute('pragma table_info(view_keys)')]
   105	    if columns and 'scope_source' not in columns:
   106	        conn.execute('alter table view_keys add column scope_source text')
   107	    if columns and 'key_version' not in columns:
   108	        conn.execute('alter table view_keys add column key_version integer')
   109	
   110	
   111	def ensure_writable_columns(conn):
   112	    """Upgrade columns at a write boundary, including a legacy database restored into an open connection."""
   113	    ensure_key_columns(conn)
   114	    columns = {r[1] for r in conn.execute('pragma table_info(rungs)')}
   115	    for field in ('lo', 'hi'):
   116	        if field not in columns:
   117	            conn.execute(f'alter table rungs add column {field} real')
   118	
