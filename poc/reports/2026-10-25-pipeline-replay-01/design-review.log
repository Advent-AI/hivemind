   132	def open_views_with_key(conn, object_id, measure, scope_key, period_start, period_end, basis='n/a', unit='n/a', event_type=None):
   133	    """Open views of the object with the same measure, scope and unit whose period overlaps: the ones a candidate must
   134	    be confirmed against before it may open (keyed-views-plan.md 2.5). A basis or unit of n/a on either side matches
   135	    any; GAAP and non-GAAP are two quantities, and so are a level in USD and a growth rate in percent."""
   136	    rows = [dict(r) for r in conn.execute('''select k.* from view_keys k join views v on v.view_id=k.view_id
   137	                                            where v.object_id=? and k.measure=? order by v.rowid''', (object_id, measure))]
   138	    return [r['view_id'] for r in rows if is_open(conn, r['view_id'])
   139	            and (event_type is None or r['event_type'] == event_type)
   140	            and (basis == 'n/a' or r['basis'] == 'n/a' or r['basis'] == basis)
   141	            and (unit == 'n/a' or r['unit'] == 'n/a' or r['unit'] == unit)
   142	            and (r.get('key_version') != 2 or ((scope_key is None or r['scope_key'] == scope_key)
   143	                 and r['period_start'] <= (period_end or '9999') and r['period_end'] >= (period_start or '0000')))]
