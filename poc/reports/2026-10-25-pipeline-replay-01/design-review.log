    93	def add_key(conn, view_id, key, seq):
    94	    """The view's key (keyed-views-plan.md 2.1), written once with the view."""
    95	    from .. import universe as _universe
    96	    insert(conn, 'view_keys', view_id=view_id, measure=key['measure'], scope=key.get('scope', ''), scope_key=_universe.scope_key(key.get('scope', '')),
    97	           period_start=key.get('period_start', ''), period_end=key.get('period_end', ''), basis=key.get('basis', 'n/a'), unit=key.get('unit', 'n/a'),
    98	           event_type=key.get('event_type', 'n/a'), seq=seq, scope_source=key.get('scope_source', 'model'), key_version=key.get('key_version'))
