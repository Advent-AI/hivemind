   120	def view_key(conn, view_id):
   121	    if not conn.execute('pragma table_info(view_keys)').fetchone():
   122	        return None
   123	    row = conn.execute('select * from view_keys where view_id=?', (view_id,)).fetchone()
   124	    if not row:
   125	        return None
   126	    key = dict(row)
   127	    if not key.get('scope_source'):
   128	        key['scope_source'] = 'none' if not key['scope'] else 'model'
   129	    return key
