    59	def same_orientation(previous, candidate):
    60	    """06-views: a successor's ladder keeps the predecessor's direction. Object views carry the fixed labels, so equal
    61	    labels settle it; a theme view's labels are results that change with the period, so the direction of the numbers
    62	    in the conditions is compared instead, and an undecidable pair is left to the model."""
    63	    if [r['label'].strip() for r in previous] == [r['label'].strip() for r in candidate]:
    64	        return True
    65	    before, after = ladder_direction(previous), ladder_direction(candidate)
    66	    return before is None or after is None or before == after
