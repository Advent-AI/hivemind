   230	def views_for_prompt(conn, object_ids):
   231	    """05-extraction block 5: the objects' open views plus every view they depend on, open or closed, with who
   232	    depends on whom; question, looks_at and due day only."""
   233	    shown, order = {}, []
   234	    for object_id in object_ids:
   235	        for view_id in views_of_object(conn, object_id):
   236	            if view_id not in shown:
   237	                shown[view_id] = dict(view(conn, view_id), open=True, depends_on=[])
   238	                order.append(view_id)
   239	    for view_id in list(order):
   240	        for dep in dependencies_of(conn, view_id):
   241	            target = dep['resolved_to']
   242	            shown[view_id]['depends_on'].append(target or f'（等 {dep["wait_chain_view_id"]} 这条链上 {dep["wait_year"]} 年的那条）')
   243	            if target and target not in shown:
   244	                record = view(conn, target)
   245	                if record:
   246	                    shown[target] = dict(record, open=is_open(conn, target), depends_on=[])
   247	                    order.append(target)
   248	    return [dict(shown[v], rungs=rungs_of(conn, v)) for v in order]
