   114	def openai_transport(provider, request, timeout=600):
   115	    url, _ = ENDPOINTS[provider]
   116	    body = json.dumps(request).encode('utf-8')
   117	    headers = {'Authorization': f'Bearer {_key(provider)}', 'Content-Type': 'application/json'}
   118	    last = None
   119	    for attempt in range(3):
   120	        try:
   121	            with urllib.request.urlopen(urllib.request.Request(url, data=body, headers=headers, method='POST'), timeout=timeout) as response:
   122	                return json.loads(response.read().decode('utf-8'))
   123	        except urllib.error.HTTPError as error:
   124	            text = error.read().decode('utf-8', 'ignore')[:600]
   125	            last = f'HTTP {error.code}: {text}'
   126	            if error.code in (400, 401, 403, 404):
   127	                raise TransportError(last)
   128	        except (urllib.error.URLError, TimeoutError, ConnectionError, OSError, http.client.HTTPException) as error:   # a dropped or truncated response is retried like a network error
   129	            last = repr(error)[:200]
   130	        time.sleep(5 * (attempt + 1))
   131	    raise TransportError(last or 'no answer')
