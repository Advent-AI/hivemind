    77	def test_d144_full_ingestion_reuses_subject_and_routes_later_risk(tmp_path):
    78	    """State table: first subject, separate milestone, evidence-only update, dated read and resend."""
    79	    conn, calls, uni, items, first = run_first(tmp_path / "views.sqlite")
    80	    second = threads.process(conn, calls, uni, items[1], 2)
    81	    third = threads.process(conn, calls, uni, items[2], 3)
    82	    assert [r["thread_id"] for r in third["threads"]] == ["g1"]
    83	    assert {r["view_id"] for r in third["memberships"]} == {"v1", "v2"}
    84	    assert second["new_views"] == {"c1":"v2"} and third["affected_threads"] == ["g1"]
    85	    assert [len(m["evidence"]) for m in threads.thread_detail(conn, "g1", 2)["members"]] == [1, 1]
    86	    assert [len(m["evidence"]) for m in threads.thread_detail(conn, "g1", 3)["members"]] == [2, 1]
    87	    before = len(calls.names)
    88	    assert threads.process(conn, calls, uni, items[2], 3)["route"] == "skipped"
    89	    assert len(calls.names) == before == 6
    90	    assert conn.execute("pragma foreign_key_check").fetchall() == []
    91	    conn.close()
