    69	def write(conn, universe, seq, item, handover, checked, second_pass):
    70	    """Write atomically within the caller's transaction; the caller commits the completion marker with it."""
    71	    if not conn.in_transaction:
    72	        conn.execute('begin immediate')
    73	    conn.execute('savepoint view_write')
    74	    try:
    75	        store.ensure_writable_columns(conn)
    76	        result = _write(conn, universe, seq, item, handover, checked, second_pass)
    77	    except Exception:
    78	        conn.execute('rollback to view_write')
    79	        conn.execute('release view_write')
    80	        raise
    81	    conn.execute('release view_write')
    82	    return result
