   147	def view_record(conn, ident):
   148	    row = store.view(conn, ident)
   149	    return {k: row[k] for k in ['view_id', 'object_id', 'kind', 'looks_at', 'question', 'due_day', 'year']} | {'rungs': store.rungs_of(conn, ident)}
