   102	def key_matches(conn, c):
   103	    """keyed-views-plan.md 2.5: the open views a keyed candidate must be confirmed against (same object, measure and scope,
   104	    overlapping period); empty for a candidate without a key."""
   105	    if not c.get('measure'):
   106	        return []
   107	    from .. import universe as _universe
   108	    # a model-written scope is wording, not identity: such a candidate is compared with every open view of its measure and period
   109	    scope_key = _universe.scope_key(c.get('scope', '')) if c.get('scope_source') in ('none', 'watch') else None
   110	    return store.open_views_with_key(conn, c['object'], c['measure'], scope_key, c.get('period_start', ''), c.get('period_end', ''), c.get('basis', 'n/a'), c.get('unit', 'n/a'), c.get('event_type', 'n/a'))
