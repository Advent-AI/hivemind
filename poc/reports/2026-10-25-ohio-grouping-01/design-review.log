   152	def match_payload(conn, item, handover, lists, shown, groups, hints):
   153	    ids = {v['view_id'] for v in shown}
   154	    ids.update(v for hits in lists.candidate_lists.values() for v in hits)
   155	    ids.update(vid for _, vid in lists.evidence_lists)
   156	    return {'item': {k: item[k] for k in ['input_id', 'publication_day', 'category']},
   157	            'candidates': handover.candidates, 'candidate_lists': lists.candidate_lists,
   158	            'shown_views': [view_record(conn, ident) for ident in sorted(ids)],
   159	            'evidence': handover.evidence,
   160	            'evidence_pairs': [{'evidence_id': eid, 'view_id': vid,
   161	                                'existing_evidence': [store.evidence(conn, x) for x in values]}
   162	                               for (eid, vid), values in lists.evidence_lists.items()],
   163	            **({'groups': groups, 'relationship_hints': hints} if groups is not None else {})}
