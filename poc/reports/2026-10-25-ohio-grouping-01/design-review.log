   173	def thread_detail(conn, thread_id, seq):
   174	    """Read dated evidence only through the ledger's actual member-to-evidence links."""
   175	    row = conn.execute('select * from threads where thread_id=? and seq<=?', (thread_id, seq)).fetchone()
   176	    if row is None:
   177	        return None
   178	    members = []
   179	    for member in conn.execute('''select v.view_id,v.question,m.seq,m.input_id from thread_members m
   180	            join views v on v.view_id=m.view_id where m.thread_id=? and m.seq<=? order by m.seq,m.rowid''', (thread_id, seq)):
   181	        evidence = [dict(e) for e in conn.execute('''select distinct e.evidence_id,e.quote,e.original_day
   182	            from evidence_links l join evidence e on e.evidence_id=l.evidence_id
   183	            where l.view_id=? and l.seq<=? and e.created_seq<=?
   184	            and not exists(select 1 from replacements r where r.old_evidence_id=e.evidence_id and r.seq<=?)
   185	            order by e.created_seq,e.rowid''', (member['view_id'], seq, seq, seq))]
   186	        members.append(dict(member) | {'evidence': evidence})
   187	    return dict(row) | {'members': members}
