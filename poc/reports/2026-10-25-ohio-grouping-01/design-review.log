   138	def visible_groups(conn, ids):
   139	    if not ids:
   140	        return []
   141	    marks = ','.join('?' for _ in ids)
   142	    groups = conn.execute(f'''select distinct g.* from research_groups g join group_members m
   143	                            on m.group_id=g.group_id where m.view_id in ({marks}) order by g.seq,g.group_id''', sorted(ids)).fetchall()
   144	    return [dict(dict(g), members=[r[0] for r in conn.execute('select view_id from group_members where group_id=? order by view_id', (g['group_id'],))]) for g in groups]
