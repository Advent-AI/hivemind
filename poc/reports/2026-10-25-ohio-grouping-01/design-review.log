    96	def _same_key(key, c, view_object=None):
    97	    """Only a complete, corrected, code-owned key authorizes automatic identity."""
    98	    target = identity.automatic_key(c)
    99	    return target is not None and bool(key) and identity.automatic_key(key, view_object) == target
