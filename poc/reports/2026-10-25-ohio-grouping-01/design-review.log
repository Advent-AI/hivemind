    96	def build_request(setting, system, user, schema, schema_name, provider):
    97	    request = {
    98	        'model': setting.model,
    99	        'messages': [{'role': 'system', 'content': system}, {'role': 'user', 'content': user}],
   100	        'response_format': {'type': 'json_schema', 'json_schema': {'name': schema_name, 'strict': True, 'schema': schema}},
   101	    }
   102	    if provider == 'openai':
   103	        # gpt-6-luna is a reasoning model: it refuses any temperature but the default, so the setting's temperature
   104	        # is recorded in Config but not sent; reasoning_effort is what steers it.
   105	        request['max_completion_tokens'] = setting.max_output_tokens
   106	        if setting.reasoning_effort:
   107	            request['reasoning_effort'] = setting.reasoning_effort
   108	    else:
   109	        request['temperature'] = setting.temperature
   110	        request['max_tokens'] = setting.max_output_tokens
   111	    return request
   112	
   113	
   114	def openai_transport(provider, request, timeout=600):
   115	    url, _ = ENDPOINTS[provider]
   116	    body = json.dumps(request).encode('utf-8')
   117	    headers = {'Authorization': f'Bearer {_key(provider)}', 'Content-Type': 'application/json'}
   118	    last = None
   119	    for attempt in range(3):
   120	        try:
   121	            with urllib.request.urlopen(urllib.request.Request(url, data=body, headers=headers, method='POST'), timeout=timeout) as response:
   122	                return json.loads(response.read().decode('utf-8'))
   123	        except urllib.error.HTTPError as error:
   124	            text = error.read().decode('utf-8', 'ignore')[:600]
   125	            last = f'HTTP {error.code}: {text}'
   126	            if error.code in (400, 401, 403, 404):
   127	                raise TransportError(last)
   128	        except (urllib.error.URLError, TimeoutError, ConnectionError, OSError, http.client.HTTPException) as error:   # a dropped or truncated response is retried like a network error
   129	            last = repr(error)[:200]
   130	        time.sleep(5 * (attempt + 1))
   131	    raise TransportError(last or 'no answer')
   132	
   133	
   134	def check_schema(value, schema, path='$'):
   135	    """A small validator for the subset of JSON Schema the prompts use: object/required/additionalProperties,
   136	    array/items, string/enum, integer, number, boolean, null in anyOf."""
   137	    kind = schema.get('type')
   138	    if 'anyOf' in schema:
   139	        errors = []
   140	        for option in schema['anyOf']:
   141	            errors = check_schema(value, option, path)
   142	            if not errors:
   143	                return []
   144	        return errors or [f'{path}: matches no option']
   145	    if kind == 'object':
   146	        if not isinstance(value, dict):
   147	            return [f'{path}: expected object']
   148	        errors = []
   149	        for name in schema.get('required', []):
   150	            if name not in value:
   151	                errors.append(f'{path}.{name}: required')
   152	        properties = schema.get('properties', {})
   153	        for name, item in value.items():
   154	            if name in properties:
   155	                errors.extend(check_schema(item, properties[name], f'{path}.{name}'))
   156	            elif schema.get('additionalProperties') is False:
   157	                errors.append(f'{path}.{name}: not allowed')
   158	        return errors
   159	    if kind == 'array':
   160	        if not isinstance(value, list):
   161	            return [f'{path}: expected array']
   162	        errors = []
   163	        for index, item in enumerate(value):
   164	            errors.extend(check_schema(item, schema.get('items', {}), f'{path}[{index}]'))
   165	        return errors
   166	    if kind == 'string':
   167	        if not isinstance(value, str):
   168	            return [f'{path}: expected string']
   169	        if 'enum' in schema and value not in schema['enum']:
   170	            return [f'{path}: {value!r} not in {schema["enum"]}']
   171	        return []
   172	    if kind == 'integer':
   173	        return [] if isinstance(value, int) and not isinstance(value, bool) else [f'{path}: expected integer']
   174	    if kind == 'number':
   175	        return [] if isinstance(value, (int, float)) and not isinstance(value, bool) else [f'{path}: expected number']
   176	    if kind == 'boolean':
   177	        return [] if isinstance(value, bool) else [f'{path}: expected boolean']
   178	    if kind == 'null':
   179	        return [] if value is None else [f'{path}: expected null']
   180	    return []
   181	
   182	
   183	def call(archive, cfg, setting, system, user, schema, schema_name, purpose, *, transport=None):
   184	    provider = cfg.provider
   185	    request = build_request(setting, system, user, schema, schema_name, provider)
   186	    request_json = json.dumps(request, sort_keys=True, ensure_ascii=False)
   187	    sha = hashlib.sha256(request_json.encode('utf-8')).hexdigest()
   188	    hit = archive.lookup(sha)
   189	    prompt_chars = len(system) + len(user)
   190	    if hit:
   191	        call_id, answer_json, _, input_tokens, output_tokens = hit
   192	        return Answer(json.loads(answer_json), call_id, sha, True, prompt_chars, input_tokens or 0, output_tokens or 0, 0.0)
   193	    started = time.time()
   194	    response = (transport or openai_transport)(provider, request)
   195	    seconds = round(time.time() - started, 1)
   196	    try:
   197	        content = response['choices'][0]['message']['content']
   198	        data = json.loads(content)
   199	    except (KeyError, IndexError, TypeError, json.JSONDecodeError) as error:
   200	        archive.record(purpose=purpose, config_version=cfg.version, config_checksum=cfg.checksum, model=setting.model,
   201	                       request_sha256=sha + ':malformed:' + uuid.uuid4().hex[:8], request_json=request_json,
   202	                       response_json=json.dumps(response)[:200000], answer_json=None, prompt_chars=prompt_chars,
   203	                       input_tokens=0, output_tokens=0, cost_usd=0.0, seconds=seconds, created_at=time.strftime('%Y-%m-%dT%H:%M:%S'))
   204	        raise SchemaError(f'malformed answer: {error}')
   205	    errors = check_schema(data, schema)
   206	    usage = response.get('usage') or {}
   207	    input_tokens = int(usage.get('prompt_tokens') or 0)
   208	    output_tokens = int(usage.get('completion_tokens') or 0)
   209	    price_in, price_out = PRICES.get(setting.model, (0.0, 0.0))
   210	    cost = round(input_tokens / 1e6 * price_in + output_tokens / 1e6 * price_out, 6)
   211	    call_id = archive.record(purpose=purpose, config_version=cfg.version, config_checksum=cfg.checksum, model=setting.model,
   212	                             request_sha256=sha if not errors else sha + ':schema:' + uuid.uuid4().hex[:8], request_json=request_json,
   213	                             response_json=json.dumps(response)[:200000], answer_json=json.dumps(data, ensure_ascii=False),
   214	                             prompt_chars=prompt_chars, input_tokens=input_tokens, output_tokens=output_tokens, cost_usd=cost,
   215	                             seconds=seconds, created_at=time.strftime('%Y-%m-%dT%H:%M:%S'))
   216	    if errors:
   217	        raise SchemaError('; '.join(errors[:5]))
   218	    return Answer(data, call_id, sha, False, prompt_chars, input_tokens, output_tokens, cost)
