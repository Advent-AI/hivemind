   190	def process(conn, calls, uni, item, index):
   191	    route = dispatch.route(conn, item, uni)
   192	    if route.kind != 'extract':
   193	        return {'input_id': item['input_id'], 'route': route.kind}
   194	    seq = route.sequence_no
   195	    shown = store.views_for_prompt(conn, [o['value'] for o in item['object_identifiers'] if uni.has(o['value'])])
   196	    payload = {'article': {k: item[k] for k in ['input_id', 'title', 'publication_day', 'category', 'text']},
   197	               'objects': [dict(id=k, kind=uni.kind(k)) for k in list(uni.companies) + list(uni.themes)],
   198	               'fiscal_context': [uni.fiscal_note(o['value'], item['publication_day']) for o in item['object_identifiers']],
   199	               'existing_theses': [{k: v[k] for k in ['view_id', 'object_id', 'question', 'looks_at', 'due_day']} |
   200	                                    {'threads': thread_context(conn, v['view_id'])} for v in shown]}
   201	    raw = calls.stage(f'item{index}-extract', base.EXTRACT_PROMPT + EXTRACT_THREADS, payload,
   202	                      extraction_schema(), calls.cfg.extraction_setting(item['category']))
   203	    validate_extraction(raw)
   204	    handover = base.sift(raw, item, shown)
   205	    used = {tid for c in handover.candidates for tid in c['thread_ids']}
   206	    threads = [t for t in raw['threads'] if t['id'] in used]
   207	    candidates = {t['id']: search_threads(conn, t, calls.cfg.search_top_n) for t in threads}
   208	    lists = matching.build_lists(conn, handover, shown, calls.cfg.search_top_n)
   209	    payload = base.match_payload(conn, item, handover, lists, shown, None, [])
   210	    payload.update(threads=threads, thread_candidates=candidates)
   211	    answer = calls.stage(f'item{index}-match', base.MATCH_PROMPT + MATCH_THREADS, payload,
   212	                         matching_schema(), calls.cfg.matching)
   213	    roots = resolve_threads(answer, threads, candidates)
   214	    checked = base.check_matching(conn, uni, answer, handover, lists, shown)
   215	    if checked.refusals:
   216	        raise ValueError('Original matching checks: ' + '; '.join(checked.refusals))
   217	    pending = [(e, checked.outcomes[link][1]) for e in handover.evidence for link in e['links']
   218	               if link in checked.outcomes and checked.outcomes[link][0] == matching.OUTCOMES[0]]
   219	    second = {}
   220	    if pending:
   221	        unique = {e['id']: e for e, _ in pending}
   222	        second_handover = dataclasses.replace(handover, candidates=[], evidence=list(unique.values()))
   223	        lists2 = matching.Lists({}, {(e['id'], vid): matching.rank_evidence(conn, vid, e['one_line'], calls.cfg.search_top_n) for e, vid in pending})
   224	        payload = base.match_payload(conn, item, second_handover, lists2, [], None, [])
   225	        raw2 = calls.stage(f'item{index}-match-evidence', base.MATCH_PROMPT, payload,
   226	                           base.matching_schema(False), calls.cfg.matching)
   227	        check2 = base.check_matching(conn, uni, raw2, second_handover, lists2, [])
   228	        if check2.refusals:
   229	            raise ValueError('Second matching checks: ' + '; '.join(check2.refusals))
   230	        second = check2.evidence
   231	    handover.candidates.sort(key=lambda c: c['kind'] != 'theme')
   232	    written = writing.write(conn, uni, seq, item, handover, checked, second)
   233	    bindings, affected = write_threads(conn, threads, roots, handover, checked, written, seq, item)
   234	    result = {'input_id': item['input_id'], 'seq': seq, 'route': 'written', 'new_views': written.new_views,
   235	              'changed_views': sorted(written.changed_views), 'affected_threads': affected,
   236	              'bindings': bindings, 'dropped': handover.dropped, 'thread_roots': roots,
   237	              'thread_candidates': candidates,
   238	              'threads': [dict(r) for r in conn.execute('select * from threads')],
   239	              'memberships': [dict(r) for r in conn.execute('select * from thread_members')],
   240	              'views': [base.view_record(conn, r[0]) for r in conn.execute('select view_id from views')],
   241	              'details': [thread_detail(conn, r[0], seq) for r in conn.execute('select thread_id from threads')]}
   242	    conn.execute('insert into ingestion_events values (?,?,?)', (seq, item['input_id'], json.dumps(result)))
   243	    dispatch.mark(conn, item, seq, 'written', 'ok', json.dumps({'changed': result['changed_views'], 'threads': affected}))
   244	    dispatch.mark(conn, item, seq, 'handed_over', 'ok', '')
   245	    conn.commit()
   246	    return result
