    59	def changed_views_of_day(conn, day):
    60	    """The views whose reading changed on a replay day: the union of the 'written' records of that day's items."""
    61	    changed = set()
    62	    for row in conn.execute("select reason from processing_steps where step='written' and result='ok' and publication_day=?", (day,)):
    63	        changed.update(json.loads(row['reason']).get('changed', []))
    64	    return changed
