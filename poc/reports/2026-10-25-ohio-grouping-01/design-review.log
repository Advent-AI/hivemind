   213	def resolve_hints(hints, checked, written, visible_ids):
   214	    """Diagnostic projection of existing extraction relationships after thesis identities are resolved."""
   215	    relations = []
   216	    for hint in hints:
   217	        candidate = hint['candidate_id']
   218	        if candidate in written.new_views:
   219	            source = written.new_views[candidate]
   220	        elif candidate in checked.outcomes and checked.outcomes[candidate][0] == matching.OUTCOMES[0]:
   221	            source = checked.outcomes[candidate][1]
   222	        else:
   223	            continue
   224	        for target in hint['related_view_ids']:
   225	            if target not in visible_ids:
   226	                raise ValueError('Relationship target was not visible at extraction')
   227	            if source != target:
   228	                relations.append({'source': source, 'target': target, 'question': hint['broader_question'], 'reason': hint['reason']})
   229	    return relations
