    95	def build_prompt(item, text, shown_views, universe, version='v1'):
    96	    """The five blocks of 05-extraction: role; this category and how to read it; who it is about plus the list's
    97	    themes; what to read out; the objects' existing views with who depends on whom (no state, no evidence)."""
    98	    category = item['category']
    99	    categories = _categories(version)
   100	    blocks = categories.get(category) or categories['T7']
   101	    objects = [o['value'] for o in item.get('object_identifiers') or []]
   102	    themes = '\n'.join(f'  - {theme_id}：{name}' for theme_id, name in universe.theme_list())
   103	    fiscal = '\n'.join(note for note in (universe.fiscal_note(o, item['publication_day']) for o in objects) if note)
   104	    system = _read(f'role-{version}.txt')
   105	    parts = [
   106	        f'【这一类是什么、怎么读】{category}。{blocks["what"]}',
   107	        f'【讲的是谁】这条信息的相关对象：{"、".join(objects) or "（上游没有标）"}。候选观点讲的是公司时，object 写股票代码；讲的是主题时，从下面名单里挑一个写编号，名单里没有的写清是什么事：\n{themes}'
   108	        + (f'\n财年说明（数字观点的年份和到期日按这个算）：\n{fiscal}' if fiscal else ''),
   109	        f'【这一类要读出什么】{blocks["read"]}',
   110	    ]
   111	    if version and int(version.lstrip('v') or 0) >= 4:      # keyed-views-plan.md 2.4: the quantities the analyst watches, with the exact scope names to copy
   112	        watched = []
   113	        for o in objects:
   114	            entries = universe.watch_list(o) if hasattr(universe, 'watch_list') else []
   115	            if entries:
   116	                watched.append(f'  - {o}：' + '；'.join(e['measure'] + (f"[{e['scope']}]" if e.get('scope') else '') + (f"({e['event_type']})" if e.get('event_type') else '') for e in entries))
   117	        if watched:
   118	            parts.append('【研究参考】已有的量和范围（measure[scope](event_type)）。含义相同可用现有名称；清单外的重要问题照常提出，保留实际范围：\n' + '\n'.join(watched))
   119	    if shown_views:
   120	        lines = []
   121	        for v in shown_views:       # 05-extraction block 5: question, looks_at, due day and who depends on whom; no state, no evidence
   122	            deps = f'；依赖：{"、".join(v["depends_on"])}' if v.get('depends_on') else ''
   123	            lines.append(f'  - {v["view_id"]}（{v["object_id"]}，看的是「{v["looks_at"]}」，到期 {v["due_day"]}）：{v["question"]}{deps}')
   124	        parts.append('【这些对象已有的观点】证据连到这些观点上，用它们的编号；它们管不到的才写候选观点：\n' + '\n'.join(lines))
