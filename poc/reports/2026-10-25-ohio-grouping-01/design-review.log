   238	        self.setting = setting
   239	        path = self.out / f'sample-{self.sample}' / f'{name}.json'
   240	        if path.exists():
   241	            expected = study.model.build_request(setting, prompt, json.dumps(payload, ensure_ascii=False), schema, 'hierarchy_result', self.cfg.provider)
   242	            if json.loads(path.read_text())['request'] != expected:
   243	                raise ValueError('Request changed; do not reuse this run')
   244	        return self.call(name, prompt, payload, schema)
