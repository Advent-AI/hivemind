    21	def _next_id(conn, table, column, prefix):
    22	    row = conn.execute(f'select {column} from {table} order by rowid desc limit 1').fetchone()
    23	    last = int(row[0][len(prefix):]) if row and row[0].startswith(prefix) and row[0][len(prefix):].isdigit() else 0
    24	    return f'{prefix}{last + 1}'
