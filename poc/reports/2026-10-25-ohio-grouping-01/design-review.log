    65	def translate_controls(data, reverse=False):
    66	    """Adapt legacy protocol enums in memory; never translate article text or generated prose."""
    67	    value = copy.deepcopy(data)
    68	    maps = [(KINDS, extraction.SCHEMA['properties']['candidates']['items']['properties']['kind']['enum']),
    69	            (TIERS, extraction.TIERS), (LABELS, extraction.OBJECT_LABELS)]
    70	    tables = [dict(zip(b, a)) if reverse else dict(zip(a, b)) for a, b in maps]
    71	    for candidate in value.get('candidates', []):
    72	        candidate['kind'] = tables[0].get(candidate['kind'], candidate['kind'])
    73	        for rung in candidate['rungs']:
    74	            rung['label'] = tables[2].get(rung['label'], rung['label'])
    75	    for evidence in value.get('evidence', []):
    76	        evidence['tier'] = tables[1].get(evidence['tier'], evidence['tier'])
    77	    return value
