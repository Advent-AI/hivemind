    47	class Answers:
    48	    """Hand-authored external model responses prove plumbing, not model quality."""
    49	    def __init__(self, raw):
    50	        self.raw = raw
    51	        self.cfg = study.config.load(str(study.ROOT / "poc/config/poc-v7.json"))
    52	        self.names = []
    53	
    54	    def stage(self, name, prompt, payload, schema, setting):
    55	        self.names.append(name)
    56	        index = int(name[4]) - 1
    57	        if name.endswith("extract"):
    58	            return copy.deepcopy(self.raw[index])
    59	        if index == 1:
    60	            assert payload["thread_candidates"]["t1"][0]["thread_id"] == "g1"
    61	        if index == 2:
    62	            return {"candidates":[], "thread_matches":[], "evidence":[{"id":"e1", "view_id":"v1",
    63	                "outcome":"new", "target_evidence_id":"", "said_day":"", "reason":"New supply risk."}]}
    64	        return {"candidates":[{"id":"c1", "outcome":"new", "target_view_id":"", "reason":"Distinct dated outcome.", "dependencies":[]}],
    65	                "evidence":[], "thread_matches":[{"id":"t1", "target_thread_id":"g1" if index else "", "reason":"Same product rollout."}]}
