   102	def key_matches(conn, c):
   103	    """keyed-views-plan.md 2.5: the open views a keyed candidate must be confirmed against (same object, measure and scope,
   104	    overlapping period); empty for a candidate without a key."""
   105	    if not c.get('measure'):
   106	        return []
   107	    from .. import universe as _universe
   108	    # a model-written scope is wording, not identity: such a candidate is compared with every open view of its measure and period
   109	    scope_key = _universe.scope_key(c.get('scope', '')) if c.get('scope_source') in ('none', 'watch') else None
   110	    return store.open_views_with_key(conn, c['object'], c['measure'], scope_key, c.get('period_start', ''), c.get('period_end', ''), c.get('basis', 'n/a'), c.get('unit', 'n/a'), c.get('event_type', 'n/a'))
   111	
   112	
   113	def build_lists(conn, handover, shown_views, top_n):
   114	    candidate_lists = {}
   115	    for c in handover.candidates:
   116	        same_key = key_matches(conn, c)
   117	        if same_key:                      # a keyed candidate is compared with the views that share its key, a narrow question
   118	            exact = store.exact_key_views(conn, c)
   119	            candidate_lists[c['id']] = list(dict.fromkeys(exact + same_key))[:top_n]
   120	            continue
   121	        hits = store.search_views(conn, f'{c["object"]} {c["looks_at"]} {c["question"]}', top_n)
   122	        for v in shown_views:
   123	            if v['view_id'] not in hits and v['object_id'] == c['object']:
   124	                hits.append(v['view_id'])
   125	        candidate_lists[c['id']] = hits[:top_n]
   126	    evidence_lists = {}
   127	    candidate_ids = {c['id'] for c in handover.candidates}
   128	    for e in handover.evidence:
   129	        for view_id in e['links']:
   130	            if view_id in candidate_ids:
   131	                continue
   132	            evidence_lists[(e['id'], view_id)] = rank_evidence(conn, view_id, e['one_line'], top_n)
   133	    return Lists(candidate_lists, evidence_lists)
