   196	
   197	def check(conn, universe, decisions, candidates, evidence, lists, shown_views):
   198	    shown_ids = {v['view_id'] for v in shown_views}
   199	    candidate_by_id = {c['id']: c for c in candidates}
   200	    # D51: a dependency is chosen among the views the model has in front of it: every list shown in this call,
   201	    # the views shown at extraction, and the candidates this answer opens
   202	    listed_all = set(shown_ids)
   203	    for hits in lists.candidate_lists.values():
   204	        listed_all.update(hits)
   205	    refusals, outcomes, not_opened, notes = [], {}, {}, []
   206	    raw_deps = {}
   207	    succession_targets = {}
   208	    answered = {d['id']: d for d in decisions.get('candidates', [])}
   209	    for c in candidates:
   210	        d = answered.get(c['id'])
   211	        if not d:
   212	            refusals.append(f'candidate {c["id"]} has no decision')
   213	            continue
   214	        outcome, target = d['outcome'], d['target_view_id'].strip()
   215	        listed = set(lists.candidate_lists.get(c['id'], [])) | shown_ids
   216	        if outcome in ('归入已有的', '接续') and c.get('measure'):
   217	            # keyed-views-plan.md 2.5 rule 1: a different quantity, or another period, is never the same view, whatever the model says
   218	            target_key = store.view_key(conn, target) if target else None
   219	            target_view = store.view(conn, target) if target else None
   220	            if target_view and target_view['object_id'] != c['object']:
   221	                notes.append(f'candidate {c["id"]}: {outcome} into {target} refused: another object ({target_view["object_id"]} ≠ {c["object"]}); opened as a new view')
   222	                outcome, target, target_key = '新观点', '', None
   223	                d = dict(d, outcome=outcome, target_view_id='')
   224	            if target_key and identity.conflicts(target_key, c, merging=outcome == '归入已有的'):
   225	                notes.append(f'candidate {c["id"]}: {outcome} into {target} refused by key ({target_key["measure"]}[{target_key["scope"]}] {target_key["period_start"]}..{target_key["period_end"]} ≠ {c["measure"]}[{c.get("scope", "")}] {c.get("period_start", "")}..{c.get("period_end", "")}); opened as a new view')
   226	                outcome, target = '新观点', ''
   227	                d = dict(d, outcome=outcome, target_view_id='')
   228	        if outcome == '新观点' and identity.automatic_key(c) is not None:
   229	            # rule 2 for a key code owns entirely: one open view with the same key and period is the same quantity; the model is not asked twice
   230	            twins = [v for v in lists.candidate_lists.get(c['id'], []) if _same_key(store.view_key(conn, v), c, (store.view(conn, v) or {}).get('object_id')) and store.is_open(conn, v)]
   231	            if len(twins) == 1:
   232	                notes.append(f'candidate {c["id"]}: opened as new by the model, merged into {twins[0]} by its key ({c["measure"]}[{c.get("scope", "")}] {c.get("period_start", "")}..{c.get("period_end", "")})')
   233	                outcome, target = '归入已有的', twins[0]
   234	                d = dict(d, outcome=outcome, target_view_id=target)
   235	        if outcome in ('归入已有的', '接续'):
   236	            if target not in listed:
   237	                refusals.append(f'candidate {c["id"]}: target {target!r} not in its list')
   238	                continue
   239	            if outcome == '归入已有的' and not store.is_open(conn, target):
   240	                refusals.append(f'candidate {c["id"]}: cannot attach to closed view {target}')
   241	                continue
   242	            if outcome == '接续':
   243	                if conn.execute('select 1 from successions where succeeds=?', (target,)).fetchone():
   244	                    refusals.append(f'candidate {c["id"]}: {target} already has a successor')
   245	                    continue
   246	                if target in succession_targets:
   247	                    refusals.append(f'candidate {c["id"]}: {target} can have one successor; {succession_targets[target]} already succeeds it in this answer')
   248	                    continue
   249	                succession_targets[target] = c['id']
   250	                previous = store.rungs_of(conn, target)
   251	                if previous and not same_orientation(previous, c['rungs']):
   252	                    refusals.append(f'candidate {c["id"]}: successor ladder orientation differs from {target}')
   253	                    continue
   254	        if outcome in ('新观点', '接续'):
   255	            object_id = universe.resolve(c['object'])
   256	            if not object_id:
   257	                not_opened[c['id']] = f'object {c["object"]!r} not on the research list'
   258	                if c['kind'] == '主题观点':
   259	                    store.pool(conn, 'suggested_theme', c['object'], {'question': c['question'], 'input_id': None}, 0)
   260	                outcomes[c['id']] = ('不开', None, [])
   261	                continue
   262	            outcomes[c['id']] = (outcome, target or None, [])
   263	            raw_deps[c['id']] = d.get('dependencies', [])
   264	        elif outcome == '归入已有的':
   265	            outcomes[c['id']] = (outcome, target, [])
   266	        else:
   267	            outcomes[c['id']] = ('不开', None, [])
   268	            not_opened[c['id']] = d.get('reason', '')
   269	    # dependencies, once every candidate's outcome is known
   270	    opened = {cid for cid, (outcome, _, _) in outcomes.items() if outcome in ('新观点', '接续')}
   271	    for cid, dependencies in raw_deps.items():
   272	        deps = []
   273	        bad = False
   274	        for dep in dependencies:
   275	            view_id, chain, year = dep['view_id'].strip(), dep['wait_chain_view_id'].strip(), dep['wait_year'].strip()
   276	            if view_id:
   277	                if view_id in candidate_by_id and view_id not in opened:
   278	                    refusals.append(f'candidate {cid}: dependency {view_id} is a candidate that is not opened')
   279	                    bad = True
   280	                    break
   281	                if view_id not in listed_all and view_id not in candidate_by_id:
   282	                    refusals.append(f'candidate {cid}: dependency {view_id} was not shown')
   283	                    bad = True
   284	                    break
   285	                if view_id == cid:
   286	                    refusals.append(f'candidate {cid}: depends on itself')
   287	                    bad = True
   288	                    break
   289	                deps.append({'view_id': view_id, 'wait_chain_view_id': None, 'wait_year': None, 'direction': dep['direction']})
   290	            elif chain and year:
   291	                if chain not in listed_all and chain not in candidate_by_id:
   292	                    refusals.append(f'candidate {cid}: waited chain {chain} was not shown')
   293	                    bad = True
   294	                    break
   295	                deps.append({'view_id': None, 'wait_chain_view_id': chain, 'wait_year': year, 'direction': dep['direction']})
   296	        if bad:
   297	            continue
   298	        outcomes[cid] = (outcomes[cid][0], outcomes[cid][1], deps)
   299	    # no cycle among the candidates of one answer (06-views: 会的话这条不收，退回给模型改)
   300	    graph = {cid: [d['view_id'] for d in outcomes[cid][2] if d['view_id'] in candidate_by_id] for cid in raw_deps if cid in outcomes}
   301	    for cid in graph:
   302	        stack, seen = list(graph[cid]), set()
   303	        while stack:
   304	            current = stack.pop()
   305	            if current == cid:
   306	                refusals.append(f'candidate {cid}: its dependencies lead back to itself')
   307	                break
   308	            if current in seen:
   309	                continue
   310	            seen.add(current)
   311	            stack.extend(graph.get(current, []))
   312	    _, coalescing_errors = identity.batch_plan(candidates, outcomes)
   313	    refusals.extend(coalescing_errors)
   314	    evidence_out = {}
   315	    answered_e = {(d['id'], d['view_id']): d for d in decisions.get('evidence', [])}
   316	    for key, listed in lists.evidence_lists.items():
   317	        d = answered_e.get(key)
   318	        if not d:
   319	            refusals.append(f'evidence {key[0]} under {key[1]} has no decision')
   320	            continue
   321	        outcome, target = d['outcome'], d['target_evidence_id'].strip()
   322	        if outcome in ('重复', '替代'):
   323	            if target not in listed:
   324	                refusals.append(f'evidence {key[0]}: target {target!r} not among {key[1]}\'s evidence shown')
   325	                continue
   326	            evidence_out[key] = (outcome, target, d['said_day'].strip())
   327	        else:
   328	            evidence_out[key] = ('新证据', None, d['said_day'].strip())
   329	    return Checked(outcomes, evidence_out, refusals, not_opened, notes)

