    30	                       original_who=e['original_who'], original_day=e['original_day'] or item['publication_day'], tier=e['tier'],
    31	                       event_time=e['event_time'], seq=seq, input_id=item['input_id'])
    32	    store.add_source(conn, evidence_id, item['input_id'], item['category'], item['publication_day'], e.get('location', ''), seq)
