    35	def _match(conn, archive, cfg, universe, item, seq, result, candidates, evidence, lists, shown, *, extra_views=(), call_offset=0, transport=None):
    36	    """One matching call with one retry on a refused check. Returns Checked, or None after marking the failure."""
    37	    note = ''
    38	    checked = None
    39	    for attempt in range(2):
    40	        try:
    41	            answer = matching.decide(archive, cfg, conn, item, candidates, evidence, lists, shown, extra_views=extra_views, retry_note=note, transport=transport)
    42	        except Exception as error:
    43	            _fail(conn, item, seq, result, 'matched', 'matching_failed', 'matching: ' + repr(error), type(error).__name__)
    44	            return None
    45	        result.cost += answer.cost_usd
    46	        result.cached_calls += int(answer.cached)
    47	        checked = matching.check(conn, universe, answer.data, candidates, evidence, lists, shown)
    48	        store.insert(conn, 'match_records', seq=seq, input_id=item['input_id'], call_no=call_offset + attempt + 1,
    49	                     shown_json=json.dumps({'candidates': lists.candidate_lists, 'evidence': {f'{k[0]}|{k[1]}': v for k, v in lists.evidence_lists.items()}}),
    50	                     request_sha256=answer.request_sha256, call_id=answer.call_id, decisions_json=json.dumps(answer.data, ensure_ascii=False),
    51	                     checks_json=json.dumps({'refusals': checked.refusals, 'not_opened': checked.not_opened, 'notes': checked.notes}, ensure_ascii=False), written_json=None)
    52	        if not checked.refusals:
    53	            return checked
    54	        note = '；'.join(checked.refusals)
    55	    _fail(conn, item, seq, result, 'matched', 'matching_refused_twice', 'matching refused twice: ' + note, item['category'])
    56	    return None
