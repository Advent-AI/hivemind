    98	def resolve_threads(answer, threads, candidates):
    99	    """Resolve all local aliases before writing; only searched global IDs are eligible."""
   100	    errors = study.model.check_schema(answer, matching_schema())
   101	    if errors:
   102	        raise ValueError('Matching shape: ' + '; '.join(errors))
   103	    values = answer['thread_matches']
   104	    ids = {t['id'] for t in threads}
   105	    if len(values) != len(ids) or {v['id'] for v in values} != ids:
   106	        raise ValueError('Every retained thread needs exactly one identity decision')
   107	    targets = {}
   108	    for value in values:
   109	        source, target = value['id'], value['target_thread_id']
   110	        if not value['reason'].strip():
   111	            raise ValueError('Thread identity decision needs a reason')
   112	        if target and target not in ids and target not in {c['thread_id'] for c in candidates[source]}:
   113	            raise ValueError('Thread target was not offered')
   114	        targets[source] = target
   115	    resolved = {}
   116	
   117	    def visit(ident, visiting):
   118	        if ident in resolved:
   119	            return resolved[ident]
   120	        if ident in visiting:
   121	            raise ValueError('Thread identity references form a cycle')
   122	        target = targets[ident]
   123	        root = ident if not target else visit(target, visiting | {ident}) if target in ids else target
   124	        resolved[ident] = root
   125	        return root
   126	
   127	    for ident in targets:
   128	        visit(ident, set())
   129	    return resolved
