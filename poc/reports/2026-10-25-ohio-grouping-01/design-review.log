   188	@dataclasses.dataclass
   189	class Checked:
   190	    outcomes: dict         # candidate id -> (outcome, target or None, dependencies list)
   191	    evidence: dict         # (evidence id, view_id) -> (outcome, target_evidence_id or None, said_day)
   192	    refusals: list
   193	    not_opened: dict       # candidate id -> reason
   194	    notes: list = dataclasses.field(default_factory=list)
