     1	"""Dispatch (docs/prd/04-dispatch.md): the only entrance. For each item, three questions in order: is it complete?
     2	was it processed before? what is its classification result? Items that go to extraction get a sequence number in
     3	arrival order; the processing record is a row per step; the review pool a row per occurrence."""
     4	import dataclasses
     5	import time
     6	
     7	from .views import store
     8	
     9	REQUIRED = ('input_id', 'publisher', 'published_at', 'publication_day', 'category', 'source_uri')
    10	
    11	
    12	@dataclasses.dataclass
    13	class Route:
    14	    kind: str                     # returned | skipped | not_processed | merged | extract
    15	    sequence_no: int = 0
    16	    resume_from: str = None       # extracted | matched | written | judged, for an unfinished item
    17	    reason: str = ''
    18	
    19	
    20	STEPS = ('dispatched', 'extracted', 'matched', 'written', 'judged', 'handed_over')
    21	
    22	
    23	def route(conn, item, universe):
    24	    missing = [field for field in REQUIRED if not item.get(field)]
    25	    if missing:
    26	        store.pool(conn, 'incomplete_item', ','.join(missing), {'input_id': item.get('input_id'), 'missing': missing}, 0)
    27	        return Route('returned', reason=f'missing {missing}')
    28	    input_id = item['input_id']
    29	    if store.is_processed(conn, input_id):
    30	        return Route('skipped', reason='already processed')
    31	    last = store.last_step(conn, input_id)
    32	    if last and last['step'] in STEPS and last['sequence_no']:
    33	        # unfinished work keeps its sequence number: after an ok step it continues at the next step, after a
    34	        # failed step it retries that step (06-views: 失败从失败的那一步重试)
    35	        position = STEPS.index(last['step'])
    36	        resume_from = STEPS[position + 1] if last['result'] == 'ok' else last['step']
    37	        return Route('extract', sequence_no=last['sequence_no'], resume_from=resume_from, reason='resuming')
    38	    if item.get('copy_of'):
    39	        return Route('merged', reason=f'copy of {item["copy_of"]}')
    40	    if item.get('supersedes'):
    41	        store.pool(conn, 'correction_not_supported', item['supersedes'], {'input_id': input_id}, 0)
    42	        return Route('not_processed', reason='correction (supersedes) not supported in the POC')
    43	    category = item['category']
    44	    objects = [o['value'] for o in item.get('object_identifiers') or [] if universe.has(o['value'])]
    45	    if not objects:
    46	        return Route('not_processed', reason='no object on the research list')
    47	    if not any(universe.watches(o, category) for o in objects):
    48	        return Route('not_processed', reason=f'category {category} not watched for {objects}')
    49	    # the sequence number is taken in arrival order and written at once, so two items routed before either is
    50	    # processed (a whole day is routed first, then run) never share a number
    51	    sequence_no = store.next_sequence(conn)
    52	    store.mark_step(conn, input_id, sequence_no, 'dispatched', 'ok', '', item.get('publication_day'), time.strftime('%Y-%m-%dT%H:%M:%S'))
    53	    conn.commit()
    54	    return Route('extract', sequence_no=sequence_no, reason='')
    55	
    56	
    57	def mark(conn, item, sequence_no, step, result='ok', reason=''):
