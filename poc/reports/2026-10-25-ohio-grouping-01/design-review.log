   132	def write_threads(conn, threads, roots, handover, checked, written, seq, item):
   133	    """Preserve candidate attachments after original thesis identities resolve; no commit here."""
   134	    definitions = {t['id']: t for t in threads}
   135	    bindings = []
   136	    for candidate in handover.candidates:
   137	        cid = candidate['id']
   138	        if cid in written.new_views:
   139	            vid = written.new_views[cid]
   140	        elif cid in checked.outcomes and checked.outcomes[cid][0] == matching.OUTCOMES[0]:
   141	            vid = checked.outcomes[cid][1]
   142	        else:
   143	            continue
   144	        for tid in candidate['thread_ids']:
   145	            bindings.append((cid, vid, roots[tid]))
   146	    canonical, affected, records = {}, set(), []
   147	    for _, _, root in bindings:
   148	        if root in canonical:
   149	            continue
   150	        if root in definitions:
   151	            thread = definitions[root]
   152	            gid = writing._next_id(conn, 'threads', 'thread_id', 'g')
   153	            conn.execute('insert into threads values (?,?,?,?,?)',
   154	                         (gid, thread['name'], thread['scope'], seq, item['input_id']))
   155	            conn.execute('insert into thread_search values (?,?,?)', (gid, thread['name'], thread['scope']))
   156	            canonical[root] = gid
   157	        else:
   158	            canonical[root] = root
   159	    for cid, vid, root in bindings:
   160	        gid = canonical[root]
   161	        inserted = conn.execute('insert or ignore into thread_members values (?,?,?,?)',
   162	                                (gid, vid, seq, item['input_id']))
   163	        if inserted.rowcount:
   164	            affected.add(gid)
   165	        records.append({'candidate_id': cid, 'view_id': vid, 'thread_id': gid, 'new_membership': bool(inserted.rowcount)})
   166	    if written.changed_views:
   167	        marks = ','.join('?' for _ in written.changed_views)
   168	        affected.update(r[0] for r in conn.execute(
   169	            f'select distinct thread_id from thread_members where view_id in ({marks})', sorted(written.changed_views)))
   170	    return records, sorted(affected)
