    46	def resolve_waiting(conn, new_view_id, seq, changed):
    47	    """A new view on a chain satisfies dependencies waiting for its year on that chain."""
    48	    v = store.view(conn, new_view_id)
    49	    chain = {new_view_id}
    50	    frontier = [new_view_id]
    51	    while frontier:
    52	        current = frontier.pop()
    53	        for row in conn.execute('select succeeds from successions where view_id=?', (current,)):
    54	            if row['succeeds'] not in chain:
    55	                chain.add(row['succeeds'])
    56	                frontier.append(row['succeeds'])
    57	    for dep in conn.execute('select * from dependencies where wait_year=? and wait_chain_view_id is not null', (v['year'],)):
    58	        if dep['wait_chain_view_id'] in chain:
    59	            already = conn.execute('select 1 from dependency_resolutions where dependency_id=?', (dep['dependency_id'],)).fetchone()
    60	            if not already and not store.would_cycle(conn, dep['view_id'], new_view_id):
    61	                store.insert(conn, 'dependency_resolutions', dependency_id=dep['dependency_id'], resolved_to=new_view_id, reason='created', seq=seq)
    62	                changed.add(dep['view_id'])
