   138	                         direction=dep['direction'], seq=seq)
   139	        resolve_waiting(conn, view_id, seq, changed)
   140	    # 3. where each piece of evidence goes
   141	    def destinations(e):
   142	        targets = []
   143	        for link in e['links']:
   144	            if link in new_views:
   145	                targets.append((new_views[link], ('新证据', None, '')))
   146	            elif link in checked.outcomes and checked.outcomes[link][0] == '归入已有的':
   147	                targets.append((checked.outcomes[link][1], second_pass.get((e['id'], checked.outcomes[link][1]), ('新证据', None, ''))))
   148	            elif link in checked.outcomes:
