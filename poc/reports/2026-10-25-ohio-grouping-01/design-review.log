    88	def rank_evidence(conn, view_id, one_line, top_n):
    89	    """The view's evidence in force ranked by word overlap with the new piece's one-line (the within-view search)."""
    90	    pieces = store.evidence_in_force(conn, view_id)
    91	    target = _words(one_line)
    92	    scored = sorted(pieces, key=lambda p: -len(target & _words(p['one_line'] + ' ' + p['quote'])))
    93	    return [p['evidence_id'] for p in scored[:top_n]]
