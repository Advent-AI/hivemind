   122	def open_experiment_db(path):
   123	    conn = store.open_db(str(path))
   124	    conn.execute('pragma foreign_keys=on')
   125	    conn.executescript('''
   126	        create table if not exists research_groups (
   127	            group_id text primary key, title text, question text, scope text, seq integer, input_id text);
   128	        create table if not exists group_members (
   129	            group_id text references research_groups(group_id), view_id text references views(view_id),
   130	            reason text, seq integer, input_id text, primary key(group_id,view_id));
   131	        create table if not exists ingestion_events (
   132	            seq integer primary key, input_id text unique, result_json text);
   133	    ''')
   134	    conn.commit()
   135	    return conn
