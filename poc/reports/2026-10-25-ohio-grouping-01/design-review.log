   136	def describe_view(conn, view_id):
   137	    v = store.view(conn, view_id)
   138	    rungs = ' / '.join(f'{r["label"]}：{r["condition"]}' for r in store.rungs_of(conn, view_id))
   139	    state = '开着' if store.is_open(conn, view_id) else '关了'
   140	    successor = conn.execute('select view_id from successions where succeeds=?', (view_id,)).fetchone()
   141	    tail = f'；已有下一期 {successor["view_id"]}' if successor else ''
   142	    return f'{view_id}（{state}，{v["object_id"]}，{v["kind"]}，看的是「{v["looks_at"]}」，{v["year"] or ""}，到期 {v["due_day"]}）：{v["question"]}\n    梯子：{rungs}{tail}'
   143	
   144	
   145	def describe_evidence(conn, evidence_id):
   146	    e = store.evidence(conn, evidence_id)
   147	    return f'{evidence_id}［{e["tier"]}；{e["speaker"]}；原始来源 {e["original_who"]} {e["original_day"]}］{e["one_line"]}｜原句：{e["quote"][:300]}'
