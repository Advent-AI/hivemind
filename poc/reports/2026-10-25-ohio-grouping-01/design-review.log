   166	def check_groups(answer, checked, visible_ids, groups):
   167	    existing = {g['group_id'] for g in groups}
   168	    new = [g['id'] for g in answer['new_groups']]
   169	    if len(set(new)) != len(new) or any(not ident.startswith('new_') or ident in existing for ident in new):
   170	        raise ValueError('New group IDs must be unique temporary IDs')
   171	    kept = {cid for cid, (outcome, _, _) in checked.outcomes.items() if outcome != matching.OUTCOMES[3]}
   172	    seen = set()
   173	    for membership in answer['memberships']:
   174	        pair = (membership['thesis_id'], membership['group_id'])
   175	        if pair in seen or pair[0] not in visible_ids | kept or pair[1] not in existing | set(new) or not membership['reason'].strip():
   176	            raise ValueError('Invalid group membership reference')
   177	        seen.add(pair)
   178	    if any(g not in {m['group_id'] for m in answer['memberships']} for g in new):
   179	        raise ValueError('New group has no retained member')
   180	    if any(not all(g[k].strip() for k in ['title', 'question', 'scope']) for g in answer['new_groups']):
   181	        raise ValueError('Group needs a title, question and scope')
   182	
   183	
   184	def write_groups(conn, answer, checked, written, seq, item):
   185	    resolved = {}
   186	    for group in answer['new_groups']:
   187	        ident = writing._next_id(conn, 'research_groups', 'group_id', 'g')
   188	        conn.execute('insert into research_groups values (?,?,?,?,?,?)',
   189	                     (ident, group['title'], group['question'], group['scope'], seq, item['input_id']))
   190	        resolved[group['id']] = ident
   191	    affected = set()
   192	    for member in answer['memberships']:
   193	        ident = member['thesis_id']
   194	        if ident in written.new_views:
   195	            ident = written.new_views[ident]
   196	        elif ident in checked.outcomes:
   197	            outcome, target, _ = checked.outcomes[ident]
   198	            if outcome != matching.OUTCOMES[0]:
   199	                raise ValueError('Unresolved candidate membership')
   200	            ident = target
   201	        group_id = resolved.get(member['group_id'], member['group_id'])
   202	        inserted = conn.execute('insert or ignore into group_members values (?,?,?,?,?)',
   203	                                (group_id, ident, member['reason'], seq, item['input_id']))
   204	        if inserted.rowcount:
   205	            affected.add(group_id)
   206	    changed = sorted(written.changed_views)
   207	    if changed:
   208	        marks = ','.join('?' for _ in changed)
   209	        affected.update(r[0] for r in conn.execute(f'select distinct group_id from group_members where view_id in ({marks})', changed))
   210	    return sorted(affected)
