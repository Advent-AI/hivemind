   107	def test_d144_same_batch_aliases_and_closed_search_targets():
   108	    """Identity table: same-batch descriptions share a root; loops and unseen targets refuse."""
   109	    local = [thread("t1"), thread("t2")]
   110	    answer = {"candidates":[], "evidence":[], "thread_matches":[
   111	        {"id":"t1", "target_thread_id":"t2", "reason":"Same development."},
   112	        {"id":"t2", "target_thread_id":"g8", "reason":"Existing development."}]}
   113	    offered = {"t1":[], "t2":[{"thread_id":"g8"}]}
   114	    assert threads.resolve_threads(answer, local, offered) == {"t1":"g8", "t2":"g8"}
   115	    answer["thread_matches"][1]["target_thread_id"] = ""
   116	    assert threads.resolve_threads(answer, local, offered) == {"t1":"t2", "t2":"t2"}
   117	    answer["thread_matches"][1]["target_thread_id"] = "t1"
   118	    with pytest.raises(ValueError, match="cycle"): threads.resolve_threads(answer, local, offered)
   119	    answer["thread_matches"][1]["target_thread_id"] = "g9"
   120	    with pytest.raises(ValueError, match="not offered"): threads.resolve_threads(answer, local, offered)
