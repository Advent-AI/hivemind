   197	def check(conn, universe, decisions, candidates, evidence, lists, shown_views):
   198	    shown_ids = {v['view_id'] for v in shown_views}
   199	    candidate_by_id = {c['id']: c for c in candidates}
   200	    # D51: a dependency is chosen among the views the model has in front of it: every list shown in this call,
   201	    # the views shown at extraction, and the candidates this answer opens
   202	    listed_all = set(shown_ids)
   203	    for hits in lists.candidate_lists.values():
   204	        listed_all.update(hits)
   205	    refusals, outcomes, not_opened, notes = [], {}, {}, []
   206	    raw_deps = {}
   207	    succession_targets = {}
   208	    answered = {d['id']: d for d in decisions.get('candidates', [])}
   209	    for c in candidates:
   210	        d = answered.get(c['id'])
   211	        if not d:
   212	            refusals.append(f'candidate {c["id"]} has no decision')
   213	            continue
   214	        outcome, target = d['outcome'], d['target_view_id'].strip()
   215	        listed = set(lists.candidate_lists.get(c['id'], [])) | shown_ids
   216	        if outcome in ('归入已有的', '接续') and c.get('measure'):
   217	            # keyed-views-plan.md 2.5 rule 1: a different quantity, or another period, is never the same view, whatever the model says
   218	            target_key = store.view_key(conn, target) if target else None
   219	            target_view = store.view(conn, target) if target else None
   220	            if target_view and target_view['object_id'] != c['object']:
   221	                notes.append(f'candidate {c["id"]}: {outcome} into {target} refused: another object ({target_view["object_id"]} ≠ {c["object"]}); opened as a new view')
