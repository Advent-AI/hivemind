   181	class BoundedTransport:
   182	    """One request, durable budget reservation, exact request and raw response, no retries."""
   183	    def __init__(self, out, label, deadline, send=None):
   184	        self.out, self.label, self.deadline, self.send = out, label, deadline, send
   185	        manifest = out / 'manifest.json'
   186	        self.max_requests = read(manifest)['max_requests'] if manifest.exists() else MAX_REQUESTS
   187	
   188	    def __call__(self, provider, request):
   189	        budget_path = self.out / 'budget.json'
   190	        budget = read(budget_path)
   191	        encoded = json.dumps(request, ensure_ascii=False).encode()
   192	        price_in, price_out = model.PRICES[request['model']]
   193	        reserve = (len(encoded) * price_in + request['max_completion_tokens'] * price_out) / 1e6
   194	        if time.monotonic() >= self.deadline or len(budget['attempts']) >= self.max_requests or budget['reserved_or_spent'] + reserve > MAX_USD:
   195	            raise RuntimeError('Registered time/call/cost limit reached; no request sent')
   196	        record = {'status': 'started', 'label': self.label, 'request': request, 'reserved_usd': reserve}
   197	        budget['attempts'].append({'label': self.label, 'status': 'started', 'reserved_usd': reserve})
   198	        budget['reserved_or_spent'] += reserve
   199	        write(budget_path, budget)
   200	        path = self.out / self.label / f'call-{len(budget["attempts"]):02d}.json'
   201	        write(path, record)
   202	        started = time.monotonic()
   203	        print(f'START {self.label} call={len(budget["attempts"])} reserve=${reserve:.4f}', flush=True)
   204	        try:
   205	            if self.send is not None:
   206	                response = self.send(provider, request)
   207	            else:
   208	                url, _ = model.ENDPOINTS[provider]
   209	                headers = {'Authorization': f'Bearer {model._key(provider)}', 'Content-Type': 'application/json'}
   210	                req = urllib.request.Request(url, data=encoded, headers=headers, method='POST')
   211	                with urllib.request.urlopen(req, timeout=min(180, max(1, self.deadline - time.monotonic()))) as handle:
   212	                    response = json.loads(handle.read().decode())
   213	            record.update(status='complete', response=response, seconds=time.monotonic() - started)
   214	            usage = response.get('usage', {})
   215	            cost = (usage.get('prompt_tokens', 0) * price_in + usage.get('completion_tokens', 0) * price_out) / 1e6
   216	            if 'prompt_tokens' not in usage or 'completion_tokens' not in usage:
   217	                cost = reserve
   218	            budget['reserved_or_spent'] += cost - reserve
   219	            budget['attempts'][-1].update(status='complete', estimated_usd=cost)
   220	            record['estimated_usd'] = cost
   221	            write(path, record)
   222	            write(budget_path, budget)
   223	            print(f'DONE {self.label} usd=${cost:.4f} seconds={record["seconds"]:.1f}', flush=True)
   224	            return response
   225	        except Exception as error:
   226	            # Error type only: avoid logging headers or credential-bearing exception objects.
   227	            record.update(status='failed', error_type=type(error).__name__, seconds=time.monotonic() - started)
   228	            budget['attempts'][-1]['status'] = 'failed'
   229	            write(path, record)
