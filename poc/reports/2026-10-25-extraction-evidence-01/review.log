   234	def prepare(out, *, role_path=None, item_ids=None, max_requests=MAX_REQUESTS, design_path=None):
   235	    if (out / 'manifest.json').exists() or any((out / label).exists() for label in LABELS):
   236	        raise ValueError('Use a new experiment directory')
   237	    if not (out / 'preflight.txt').is_file():
   238	        raise ValueError('Run and inspect preflight first')
   239	    item_ids = ITEM_IDS if item_ids is None else tuple(item_ids)
   240	    if not item_ids or len(item_ids) != len(set(item_ids)) or max_requests < 1:
   241	        raise ValueError('Provide unique input IDs and a positive registered request limit')
   242	    with sqlite3.connect(f'file:{ITEMS_DB}?mode=ro', uri=True) as conn:
   243	        conn.row_factory = sqlite3.Row
   244	        items = []
   245	        for ident in item_ids:
   246	            row = conn.execute('select * from items where input_id=?', (ident,)).fetchone()
   247	            if row is None or not row['text']:
   248	                raise ValueError(f'Missing source item/text: {ident}')
   249	            items.append(dict(row))
   250	    if [i['publication_day'] for i in items] != sorted(i['publication_day'] for i in items):
   251	        raise ValueError('Inputs must be in publication order')
   252	    for item in items:
   253	        item['object_identifiers'] = json.loads(item['object_identifiers'])
   254	    seeds = [dict(g, seq=0, input_id='reference:' + g['input_id']) for g in read(PREFIX)['threads']]
   255	    write(out / 'items.json', items)
   256	    write(out / 'reference-groups.json', seeds)
   257	    write(out / 'config.json', read(ROOT / 'poc/config/poc-v16.json'))
   258	    write(out / 'universe.json', read(ROOT / 'poc/universe.json'))
   259	    paths = list((ROOT / 'src/hivemind').rglob('*.py')) + list((ROOT / 'src/hivemind/prompts').glob('*'))
   260	    paths += [Path(__file__), ROOT / 'poc/hierarchy_study/ingestion_threads.py', ROOT / 'poc/hierarchy_study/study.py',
   261	              ROOT / 'docs/research/2026-10-25-ohio-grouping-poc.md', PREFIX]
   262	    paths += [out / name for name in ('items.json', 'reference-groups.json', 'config.json', 'universe.json', 'preflight.txt')]
   263	    if role_path is not None:
   264	        role_path = Path(role_path).resolve()
   265	        if not role_path.read_text().strip():
   266	            raise ValueError('Experiment role must not be empty')
   267	        paths += [role_path, ROOT / 'docs/research/2026-10-25-ohio-root-cause.md']
   268	    if design_path is not None:
   269	        design_path = Path(design_path).resolve()
   270	        if not design_path.is_file():
   271	            raise ValueError('Registered design must exist')
   272	        paths.append(design_path)
   273	    write(out / 'manifest.json', {'version': 'ohio-sequence-v1', 'labels': LABELS, 'max_requests': max_requests,
   274	          'item_ids': item_ids, 'design_path': str(design_path) if design_path else None,
   275	          'role_path': str(role_path) if role_path else None,
   276	          'max_usd': MAX_USD, 'max_seconds': MAX_SECONDS, 'dependencies': {str(p.resolve()): digest(p) for p in paths if p.is_file()}})
   277	    write(out / 'budget.json', {'attempts': [], 'reserved_or_spent': 0})
   278	
