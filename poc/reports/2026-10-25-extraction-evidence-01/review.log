   286	def run(out):
   287	    with (out / 'run.lock').open('a') as lock:
   288	        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
   289	        verify(out)
   290	        if read(out / 'budget.json')['attempts'] or any((out / label).exists() for label in LABELS):
   291	            raise ValueError('Measurement already started; no automatic resume')
   292	        items = read(out / 'items.json')
   293	        role_path = read(out / 'manifest.json').get('role_path')
   294	        role_text = Path(role_path).read_text() if role_path else None
   295	        uni, cfg = universe.load(out / 'universe.json'), config.load(out / 'config.json')
   296	        deadline = time.monotonic() + MAX_SECONDS
   297	        statuses = {label: 'not_started' for label in LABELS}
   298	        write(out / 'status.json', statuses)
   299	        for label in LABELS:
   300	            verify(out)
   301	            folder = out / label
   302	            folder.mkdir()
   303	            conn = groups.open_db(folder / 'views.sqlite')
   304	            archive = model.Archive(str(folder / 'calls.sqlite'))
   305	            # A role experiment compares two grouped streams; D157's default keeps its original arms.
   306	            grouped = role_text is not None or label.startswith('grouped')
   307	            sample_role = role_text if label.startswith('grouped') else None
   308	            if grouped:
   309	                for g in read(out / 'reference-groups.json'):
   310	                    conn.execute('insert into threads values (?,?,?,?,?)', tuple(g[k] for k in ('thread_id', 'name', 'scope', 'seq', 'input_id')))
   311	                conn.commit()
   312	            transport = BoundedTransport(out, label, deadline)
   313	            try:
   314	                first = None
   315	                for index, item in enumerate(items, 1):
   316	                    directory = folder / f'item{index}'
   317	                    directory.mkdir()
   318	                    result = process(conn, archive, cfg, uni, item, grouped, directory, transport, role_text=sample_role)
   319	                    if result['route'] != 'written':
   320	                        raise Refused(f'Expected extract route, got {result["route"]}')
   321	                    if index == 1:
   322	                        first = result
   323	                historical = [groups.thread_detail(conn, g['thread_id'], first['seq']) for g in first['snapshot']['threads']]
   324	                if historical != first['snapshot']['details']:
   325	                    raise AssertionError('First article history changed')
   326	                if any(dispatch.route(conn, item, uni).kind != 'skipped' for item in items):
   327	                    raise AssertionError('Completed input not skipped on resend')
   328	                write(folder / 'checks.json', {'history_unchanged': True, 'resend_skipped': True, 'semantic_status': 'pending'})
   329	                statuses[label] = 'complete'
   330	            except (Refused, model.SchemaError) as error:
   331	                statuses[label] = 'refused'
   332	                write(folder / 'failed.json', {'kind': type(error).__name__, 'reason': str(error)[:1000]})
   333	            except Exception as error:
   334	                statuses[label] = 'failed'
   335	                write(folder / 'failed.json', {'kind': type(error).__name__, 'reason': str(error)[:1000]})
   336	                write(out / 'status.json', statuses)
   337	                raise
   338	            finally:
   339	                conn.rollback()
   340	                conn.close()
   341	                archive.conn.close()
   342	            verify(out)
   343	            write(out / 'status.json', statuses)
   344	        print(json.dumps(statuses), flush=True)
   345	
   346	
   347	def main():
   348	    parser = argparse.ArgumentParser(description=__doc__)
   349	    parser.add_argument('command', choices=('prepare', 'run'))
   350	    parser.add_argument('--out', type=Path, default=DEFAULT_OUT)
   351	    parser.add_argument('--role-path', type=Path, help='Prepare two grouped arms; only the grouped arm uses this role')
   352	    parser.add_argument('--item-id', action='append', help='Prepare with these stored inputs, in stream order')
   353	    parser.add_argument('--max-requests', type=int, default=MAX_REQUESTS, help='Registered attempt limit; dollar cap is unchanged')
   354	    parser.add_argument('--design-path', type=Path, help='Freeze the registered design with the experiment')
   355	    args = parser.parse_args()
   356	    out = args.out.resolve()
   357	    if args.command == 'prepare':
   358	        prepare(out, role_path=args.role_path, item_ids=args.item_id, max_requests=args.max_requests, design_path=args.design_path)
   359	    else:
   360	        if args.role_path is not None or args.item_id is not None or args.design_path is not None or args.max_requests != MAX_REQUESTS:
   361	            parser.error('run reads the frozen settings from the prepared manifest')
   362	        run(out)
   363	
   364	
   365	if __name__ == '__main__':
   366	    main()

