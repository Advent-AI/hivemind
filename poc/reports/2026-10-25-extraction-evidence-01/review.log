"""D157: a bounded, isolated two-article stream using the current Chinese pipeline.

The registered scope and checks live in docs/research/2026-10-25-ohio-grouping-poc.md.
No default pipeline configuration or historical ledger is modified.
"""
import argparse
import copy
import dataclasses
import fcntl
import hashlib
import json
import re
import sqlite3
import time
import urllib.request
from pathlib import Path

import ingestion_threads as groups
import study
from hivemind import config, dispatch, extraction, model, universe
from hivemind.views import matching, store, writing

ROOT = Path(__file__).resolve().parents[2]
DEFAULT_OUT = ROOT / 'poc/reports/2026-10-25-ohio-grouping-01'
ITEMS_DB = ROOT / 'poc/data/items-window-tags2-2026-10-24.sqlite'
PREFIX = ROOT / 'poc/reports/2026-10-25-direct-subjects-01/sample-2-retained/item2-result.json'
ITEM_IDS = ('gnews:b25b5b3109fbe06f1a394164', 'gnews:bb0d23846735c94b7c1722d2')
LABELS = tuple(f'{arm}-{sample}' for sample in range(1, 4) for arm in ('control', 'grouped'))
MAX_REQUESTS, MAX_USD, MAX_SECONDS = 30, 1.5, 1800
GROUP_PROMPT = '''同时把候选观点归入所谈的持续业务过程，例如产品推出、投资项目或政策过程；公司相同不够。
可以复用下面展示的研究主线编号，也可以在 threads 声明有名称和范围的新主线；在候选的 thread_ids 引用。
同一过程的不同问题可以共用主线，一个问题也可以属于多条。归组不合并问题，也不表示因果或依赖。
只更新已有观点的证据时不用再造候选或主线。'''
TABLES = ('views', 'view_keys', 'rungs', 'evidence', 'evidence_sources', 'evidence_links', 'replacements',
          'threads', 'thread_members')


class Refused(ValueError):
    """A completed model answer did not meet the registered contract; do not resample."""


def write(path, value):
    study.write_json(Path(path), value)


def read(path):
    return json.loads(Path(path).read_text())


def digest(path):
    return hashlib.sha256(Path(path).read_bytes()).hexdigest()


def schema(offered):
    result = extraction.keyed_schema()
    result['required'].append('threads')
    result['properties']['threads'] = {'type': 'array', 'items': copy.deepcopy(groups.THREAD_SCHEMA)}
    candidate = result['properties']['candidates']['items']
    candidate['required'].append('thread_ids')
    reference_pattern = r'^(?:t[1-9][0-9]*' + ''.join('|' + re.escape(g['thread_id']) for g in offered) + ')$'
    candidate['properties']['thread_ids'] = {'type': 'array', 'minItems': 1,
                                             'items': {'type': 'string', 'pattern': reference_pattern}}
    return result


def validate_references(raw, offered):
    errors = model.check_schema(raw, schema(offered))
    if errors:
        raise Refused('; '.join(errors))
    ids = [g['id'] for g in raw['threads']]
    candidate_ids = [c['id'] for c in raw['candidates']]
    if len(candidate_ids) != len(set(candidate_ids)):
        raise Refused('ambiguous candidate IDs')
    if len(ids) != len(set(ids)) or any(re.fullmatch(r't[1-9][0-9]*', ident) is None for ident in ids):
        raise Refused('new groups need unique local t IDs')
    if any(not g['name'].strip() or not g['scope'].strip() for g in raw['threads']):
        raise Refused('group name and scope must be nonempty')
    allowed = set(ids) | {g['thread_id'] for g in offered}
    for c in raw['candidates']:
        refs = c['thread_ids']
        if not refs or len(refs) != len(set(refs)) or set(refs) - allowed:
            raise Refused(f'{c["id"]}: invalid group references')



The work is an architecture POC: the design page, one PRD per module and the decisions. No product code and no data
files until Alex starts the build. `docs/check.py` checks (and rebuilds the PRD bundle the page reads from disk); the
only other scripts generate page assets (`build_bundle.py`, `copy_old_design.py`, `embed_fonts.py`) or simulate
classification (`simulate_classification.py`, not changed at this stage).

- The design page is `docs/system-design.html` with its data in `docs/system-design/new-*.js`; each module's PRD is in
  `docs/prd/` (index `README.md`). The page data is the one source: a PRD block marked `generated` comes from it and
  is never edited by hand.
- After any change, refresh by reasoning: re-read every module in the order and with the four questions of
  `docs/prd/README.md` (D22), so that page, PRD and decisions say the same thing, and list each inconsistency fixed.
  `python3 docs/check.py` runs last and checks only mechanically; its pass is never the refresh.
- Design every data path from what a view (thesis) needs, never from what the data offers: no number warehouse (D24,
  D28).
- Write for a reader who did not follow the discussion: plain Chinese, one concrete example, processes as step cards
  and decisions as trees; every detail page links to its PRD.
- A rule is written in full in one place, its owner; summaries, other modules and the glossary name it or point to
  it without restating its conditions, so a change lands once. A finding that one sentence missed a change is a
  class: count every place that states the same thing before the first edit (§1).
- Codex reviews read-only: `codex exec -s read-only -C <repo> --skip-git-repo-check --ephemeral -o <out> - < <prompt>`.
  The prompt names the scope, the governing documents and what is out of scope; its report is a lead (§1).
- Before a freeze, review in rounds. Each round runs read-only reviews by angle: an end-to-end simulation of
  realistic items, state-by-event tables, wording against the glossary, whether an engineer could build each step
  from the text, every rule against the decisions, an attack on Claude's own findings, a new reader answering
  questions, every change read in context, and line-by-line reads by module. Each finding is checked against the
  text before a change; rounds go on until one finds nothing; then the freeze is recorded and the design sealed.

## Before finishing a slice

1. The touched suites, the structural checks and then the full suite pass (in the design phase: the reasoning refresh,
   then `python3 docs/check.py`). A red suite is fixed before a handoff, whoever's code it is.
2. `docs/CURRENT_STATE.md` holds the status, the open defects and the one next task; a status update retires the
   paragraphs it replaces. A changed choice is recorded in `docs/DECISIONS.md`.

