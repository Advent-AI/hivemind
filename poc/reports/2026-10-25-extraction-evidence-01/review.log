   132	OBJECT_LABELS = ['强烈看多', '看多', '中性', '看空', '强烈看空']
   133	
   134	
   135	def check_ladder(rungs, kind):
   136	    """None when the ladder is well formed, else the problem. An object ladder written from 强烈看空 up to 强烈看多
   137	    (the model often orders a revenue ladder by rising value) is the same ladder; normalise_ladder turns it round."""
   138	    if len(rungs) not in (2, 5):
   139	        return f'ladder has {len(rungs)} rungs, needs 5 (or 2 for yes/no)'
   140	    if any(not r['label'].strip() or not r['condition'].strip() for r in rungs):
   141	        return 'a rung has an empty label or condition'
   142	    if kind == '对象观点' and len(rungs) == 5:
   143	        labels = [r['label'].strip() for r in rungs]
   144	        if labels != OBJECT_LABELS and labels != OBJECT_LABELS[::-1]:
   145	            return f'object view rungs must be {OBJECT_LABELS}, got {labels}'
   146	    return None
   147	
   148	
   149	def normalise_ladder(rungs, kind):
   150	    """Position 1 is 强烈看多 (06-views): a reversed object ladder is turned round, label and condition together."""
   151	    if kind == '对象观点' and len(rungs) == 5 and [r['label'].strip() for r in rungs] == OBJECT_LABELS[::-1]:
   152	        return list(reversed(rungs))
   153	    return rungs
