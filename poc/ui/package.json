{
  "name": "@hivemind/thesis-ui",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "test": "node build-validator.mjs && node --test test/*.test.js",
    "lint": "eslint .",
    "test:mutations": "node test/mutations.mjs",
    "verify:page": "node verify-page.mjs",
    "format:check": "prettier --check src *.mjs eslint.config.js test package.json"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "prettier": "3.9.10"
  },
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./src/index.js",
    "./schema": "./src/model/thesis.schema.json",
    "./styles": "./src/styles/index.css"
  }
}
